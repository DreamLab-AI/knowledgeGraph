{
  "@context": {
    "@version": 1.1,
    "@base": "https://visionclaw.dreamlab-ai.systems/ns/v2#",

    "vcw":                        "https://visionclaw.dreamlab-ai.systems/ns/v2#",
    "infrastructure":             "http://narrativegoldmine.com/ontology#",
    "artificial-intelligence":    "http://narrativegoldmine.com/ai#",
    "blockchain":                 "http://narrativegoldmine.com/blockchain#",
    "spatial-computing":          "http://narrativegoldmine.com/spatial-computing#",
    "robotics":                   "http://narrativegoldmine.com/robotics#",
    "distributed-collaboration":  "http://narrativegoldmine.com/distributed-collaboration#",

    "owl":     "http://www.w3.org/2002/07/owl#",
    "rdf":     "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
    "rdfs":    "http://www.w3.org/2000/01/rdf-schema#",
    "xsd":     "http://www.w3.org/2001/XMLSchema#",
    "skos":    "http://www.w3.org/2004/02/skos/core#",
    "dcterms": "http://purl.org/dc/terms/",
    "schema":  "http://schema.org/",
    "prov":    "http://www.w3.org/ns/prov#",
    "as":      "https://www.w3.org/ns/activitystreams#",
    "vc":      "https://www.w3.org/ns/credentials/v2",
    "did":     "https://www.w3.org/ns/did/v1",
    "odrl":    "http://www.w3.org/ns/odrl/2/",
    "dcat":    "http://www.w3.org/ns/dcat#",
    "ldp":     "http://www.w3.org/ns/ldp#",
    "foaf":    "http://xmlns.com/foaf/0.1/",
    "vann":    "http://purl.org/vocab/vann/",
    "sh":      "http://www.w3.org/ns/shacl#",

    "type":             { "@id": "rdf:type",                "@type": "@id" },
    "label":            { "@id": "rdfs:label" },
    "comment":          { "@id": "rdfs:comment" },
    "seeAlso":          { "@id": "rdfs:seeAlso",            "@type": "@id" },

    "uri":              { "@id": "vcw:canonicalUri",         "@type": "@id" },
    "iri":              { "@id": "vcw:ontologyIri",          "@type": "@id" },
    "domain":           { "@id": "vcw:sourceDomain" },
    "preferred-term":   { "@id": "skos:prefLabel" },
    "alt-terms":        { "@id": "skos:altLabel",            "@container": "@set" },
    "definition":       { "@id": "skos:definition" },
    "notation":         { "@id": "skos:notation" },
    "status":           { "@id": "vcw:ontologyStatus" },
    "maturity":         { "@id": "vcw:maturityLevel" },
    "quality-score":    { "@id": "vcw:qualityScore",         "@type": "xsd:decimal" },
    "authority-score":  { "@id": "vcw:authorityScore",       "@type": "xsd:decimal" },
    "content-hash":     { "@id": "vcw:contentHash" },
    "version":          { "@id": "dcterms:hasVersion" },
    "created":          { "@id": "dcterms:created",          "@type": "xsd:dateTime" },
    "modified":         { "@id": "dcterms:modified",         "@type": "xsd:dateTime" },
    "creator":          { "@id": "dcterms:creator",          "@type": "@id" },
    "author-did":       { "@id": "vcw:authorDid",            "@type": "@id" },
    "signature":        { "@id": "vcw:schnorrSignature" },
    "contributors":     { "@id": "vcw:contributor",          "@type": "@id", "@container": "@set" },

    "is-subclass-of":   { "@id": "rdfs:subClassOf",          "@type": "@id" },
    "is-a":             { "@id": "rdf:type",                 "@type": "@id" },
    "has-part":         { "@id": "vcw:hasPart",              "@type": "@id", "@container": "@set" },
    "is-part-of":       { "@id": "vcw:isPartOf",             "@type": "@id" },
    "requires":         { "@id": "vcw:requires",             "@type": "@id", "@container": "@set" },
    "enables":          { "@id": "vcw:enables",              "@type": "@id", "@container": "@set" },
    "implements":       { "@id": "vcw:implements",            "@type": "@id", "@container": "@set" },
    "bridges-to":       { "@id": "vcw:bridgesTo",            "@type": "@id", "@container": "@set" },
    "depends-on":       { "@id": "vcw:dependsOn",            "@type": "@id", "@container": "@set" },
    "belongs-to-domain":{ "@id": "vcw:belongsToDomain",      "@type": "@id" },
    "implemented-in-layer": { "@id": "vcw:implementedInLayer", "@type": "@id", "@container": "@set" },
    "related-to":       { "@id": "skos:related",             "@type": "@id", "@container": "@set" },
    "broader":          { "@id": "skos:broader",             "@type": "@id" },
    "narrower":         { "@id": "skos:narrower",            "@type": "@id", "@container": "@set" },

    "owl-class":        { "@id": "vcw:owlClass" },
    "owl-role":         { "@id": "vcw:owlRole" },
    "owl-inferred":     { "@id": "vcw:owlInferredClass" },
    "owl-equivalent":   { "@id": "owl:equivalentClass",      "@type": "@id" },
    "owl-disjoint":     { "@id": "owl:disjointWith",         "@type": "@id", "@container": "@set" },
    "owl-restriction":  { "@id": "owl:onProperty",           "@type": "@id" },

    "legacy-term-id":   { "@id": "vcw:legacyTermId" },
    "legacy-domain":    { "@id": "vcw:legacyDomain" },
    "migration-date":   { "@id": "vcw:migrationDate",        "@type": "xsd:dateTime" },

    "ConceptPage":      { "@id": "vcw:ConceptPage" },
    "DomainRoot":       { "@id": "vcw:DomainRoot" },
    "LayerDefinition":  { "@id": "vcw:LayerDefinition" },
    "InfrastructureConcept": { "@id": "vcw:InfrastructureConcept" }
  }
}
