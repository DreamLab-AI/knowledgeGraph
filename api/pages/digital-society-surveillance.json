{
  "id": "urn:visionflow:page:efe97e56c47155cd43fe76af0d080c403128aa2f1d65d81f14d188a95b55529b",
  "title": "Digital Society Surveillance",
  "slug": "digital-society-surveillance",
  "public": true,
  "classIri": "urn:visionflow:owl:class:digital-society-surveillance",
  "domain": "ethics-society",
  "definition": "Digital Society Surveillance is the systematic observation, collection, processing, and analysis of personal data, communications, movements, and behavioural signals generated by individuals participating in digital infrastructure \u2014 encompassing state mass-surveillance programmes, commercial surveillance capitalism, biometric tracking, automated licence-plate recognition (ALPR) networks, smart-city sensor grids, workplace monitoring (bossware), school surveillance technology, and algorithmic social-scoring systems \u2014 constituting an interconnected ontological domain at the intersection of political power, capital accumulation, privacy rights, and civil-liberties jurisprudence that has fundamentally restructured the relationship between citizens, corporations, and governments in the twenty-first century.",
