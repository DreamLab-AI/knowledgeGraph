    vc:slug "bitcoin-protocol" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:elliptic-curve-cryptography,
        ngm:merkle-tree,
        ngm:sha-256 .

ngm:block-storage a owl:Class ;
    rdfs:label "Block Storage"@en ;
    rdfs:comment "Block Storage is an infrastructure storage paradigm that presents raw fixed-size blocks of data to a host operating system or hypervisor, which then manages formatting, file system placement, and I/O scheduling directly. Unlike object storage or file storage, block storage exposes a low-level disk abstraction enabling high-performance, low-latency random read/write operations suitable for databases, virtual machine boot disks, and transactional workloads. Cloud providers implement block storage as network-attached volumes (e.g., AWS EBS, GCP Persistent Disk) that can be dynamically provisioned and attached to compute instances."@en ;
    rdfs:subClassOf ngm:storage-systems ;
    vc:contrastsWith ngm:distributed-storage,
        ngm:object-storage ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:cloud-storage,
        ngm:data-storage-layer ;
    vc:slug "block-storage" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:database-system,
        ngm:persistent-storage ;
    vc:uses ngm:file-system .

ngm:blockchain-gaming a owl:Class ;
    rdfs:label "Blockchain Gaming"@en ;
    rdfs:comment "A gaming paradigm in which in-game assets, economies, and ownership records are managed on distributed ledgers, enabling players to hold verifiable ownership of digital items as NFTs, participate in play-to-earn economies, and trade assets across compatible platforms without relying on centralised game servers for provenance or scarcity guarantees."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:crypto-wallet ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gas-fee ],
        ngm:decentralised-application ;
    vc:bridgesTo ngm:decentralised-finance,
        ngm:digital-twin,
        ngm:metaverse ;
    vc:contrastsWith ngm:centralised-game-server,
        ngm:traditional-gaming ;
    vc:dependsOn ngm:blockchain-protocol,
        ngm:layer-2-scaling,
        ngm:nft-marketplace ;
    vc:enables ngm:cross-game-asset-portability,
        ngm:digital-ownership,
        ngm:virtual-currency,
        ngm:virtual-economy ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:game-asset-marketplace,
        ngm:in-game-economy,
        ngm:play-to-earn ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:governance-token,
        ngm:interoperability,
        ngm:tokenization ;
    vc:requires ngm:crypto-wallet,
        ngm:gas-fee ;
    vc:slug "blockchain-gaming" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:blockchain,
        ngm:decentralised-autonomous-organisation,
        ngm:game-token,
        ngm:nft,
        ngm:smart-contract .

ngm:bulletproofs a owl:Class ;
    rdfs:label "Bulletproofs"@en ;
    rdfs:comment "Bulletproofs are a class of short, non-interactive zero-knowledge proof system that enables efficient range proofs and arbitrary arithmetic circuit satisfiability without a trusted setup. Based on the discrete logarithm assumption over elliptic curves, they produce logarithmically-sized proofs that can be aggregated and batched, making them particularly well-suited to confidential transaction systems in public blockchains where proof size and verification cost are critical constraints."@en ;
    rdfs:subClassOf ngm:zero-knowledge-proof ;
    vc:enables ngm:confidential-transactions,
        ngm:cryptographic-proof ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:privacy-preserving-blockchain ;
    vc:slug "bulletproofs" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:commitment-scheme,
        ngm:elliptic-curve-cryptography,
        ngm:schnorr-signature .

ngm:business-process-management a owl:Class ;
    rdfs:label "Business Process Management"@en ;
    rdfs:comment "Business Process Management (BPM) is a discipline that uses methods, techniques, and software tools to discover, model, analyse, measure, improve, and automate business processes — end-to-end workflows that produce value for internal stakeholders or external customers. It combines organisational management practice with process automation technology to make organisational operations more efficient, agile, and aligned with strategic goals."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:event-driven-architecture ],
        ngm:enterprise-architecture ;
    vc:bridgesTo ngm:artificial-intelligence,
        ngm:low-code-platform ;
    vc:contrastsWith ngm:business-process-reengineering,
        ngm:total-quality-management ;
    vc:enables ngm:continuous-improvement,
        ngm:digital-transformation,
        ngm:operational-efficiency,
        ngm:process-automation,
        ngm:workflow-automation ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:business-rules-engine,
        ngm:case-management,
        ngm:process-mining,
        ngm:process-modelling ;
    vc:isPartOf ngm:enterprise-architecture,
        ngm:organisational-management ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:enterprise-resource-planning,
        ngm:supply-chain-management ;
    vc:requires ngm:event-driven-architecture,
        ngm:process-notation ;
    vc:slug "business-process-management" ;
    vc:sourceDomain "governance" ;
    vc:standardizedBy ngm:bpmn,
        ngm:workflow-management-coalition ;
    vc:supports ngm:audit-trail,
