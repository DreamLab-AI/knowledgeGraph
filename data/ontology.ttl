        ngm:open-source-development ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:stigmergy,
        ngm:wisdom-of-crowds ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:agent-based-models,
        ngm:ensemble-learning,
        ngm:governance,
        ngm:multi-agent-systems,
        ngm:superforecasting ;
    vc:requires ngm:distributed-information-processing,
        ngm:diversity-of-perspective,
        ngm:incentive-design ;
    vc:slug "collective-intelligence" ;
    vc:sourceDomain "distributed-collaboration" ;
    vc:uses ngm:aggregation-mechanism,
        ngm:knowledge-management,
        ngm:multi-agent-system,
