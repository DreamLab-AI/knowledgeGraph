ngm:quantisation a owl:Class ;
    rdfs:label "Quantisation"@en ;
    rdfs:comment "Quantisation is a model compression technique that reduces the numerical precision of a neural network's weights and, optionally, activations from the floating-point formats used during training (typically FP32 or BF16) to lower bit-widths such as INT8, INT4, or binary representations. This reduction decreases memory consumption and accelerates matrix operations on hardware with native low-precision arithmetic units, enabling deployment of large models on memory-constrained devices with minimal accuracy degradation. Techniques include post-training quantisation (PTQ) and quantisation-aware training (QAT), which differ in when the precision reduction is applied relative to the training process."@en ;
    rdfs:subClassOf ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:enables ngm:edge-ai-accelerator,
        ngm:inference ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:knowledge-distillation,
        ngm:model-compression-for-edge,
        ngm:neural-network-quantisation ;
    vc:slug "quantisation" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:hardware-acceleration .

ngm:rb-0087-safety-standard a owl:Class ;
    rdfs:label "rb 0087 safety standard"@en ;
    rdfs:comment "A safety standard in robotics is a normative document, published by a recognised standards body, that specifies requirements and guidelines to achieve acceptable levels of safety for robot systems, their components, and their operating environments. Key robotics safety standards include ISO 10218-1/2 for industrial robots, ISO/TS 15066 for collaborative operation, and ISO 13482 for personal care robots. Such standards define hazard categories, risk assessment methodology, required safety functions, performance levels, and verification procedures that manufacturers and system integrators must satisfy before deployment."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:rb-0088-iso-13482-compliance ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:rb-0101-performance-level ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:rb-0089-risk-assessment ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:rb-0100-safety-integrity-level ],
        ngm:robo-safety-and-standards,
        ngm:robot-standard ;
    skos:broader ngm:robo-safety-and-standards ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:rb-0088-iso-13482-compliance,
        ngm:rb-0100-safety-integrity-level,
        ngm:rb-0101-performance-level ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:iec-61508,
        ngm:iso-10218,
        ngm:iso-ts-15066 ;
    vc:requires ngm:rb-0089-risk-assessment ;
    vc:slug "rb-0087-safety-standard" ;
    vc:sourceDomain "robotics" ;
    vc:supports ngm:functional-safety,
        ngm:robot-safety .

ngm:robot-sensor a owl:Class ;
    rdfs:label "Robot Sensor"@en ;
    rdfs:comment "A Robot Sensor is a transducer or measurement device integrated into a robotic system to acquire data about the robot's internal state (proprioception: joint angles, torques, currents) or external environment (exteroception: proximity, force, vision, lidar). Sensor data drives closed-loop control, obstacle avoidance, and higher-level perception pipelines."@en ;
    rdfs:subClassOf ngm:robo-perception ;
    skos:broader ngm:robo-perception ;
    vc:enables ngm:sensor-fusion,
