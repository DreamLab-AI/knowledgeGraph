        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gaussian-distribution ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:covariance-matrix ],
        ngm:kalman-filter ;
    vc:bridgesTo ngm:augmented-reality-tracking,
        ngm:autonomous-navigation ;
    vc:contrastsWith ngm:particle-filter,
