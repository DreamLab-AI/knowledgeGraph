ngm:learning-analytics a owl:Class ;
    rdfs:label "Learning Analytics"@en ;
    rdfs:comment "The measurement, collection, analysis, and reporting of data about learners in immersive VR and metaverse educational environments, enabling understanding of learning processes, performance prediction, and adaptive content delivery."@en ;
