ngm:event-log a owl:Class ;
    rdfs:label "Event Log"@en ;
    rdfs:comment "An Event Log is an append-only record of discrete events emitted by a system, used to capture state changes for auditing, indexing and downstream processing. On blockchains, smart contracts emit events that are written to transaction receipts and stored in the log structure of each block, where they can be efficiently queried by off-chain services. Event logs provide an immutable, ordered history that decentralised applications use to reconstruct state and trigger reactions."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:smart-contract ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:event-emission ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:immutability ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:state-change ],
        ngm:append-only-log ;
    vc:dependsOn ngm:solidity ;
    vc:enables ngm:audit-log,
        ngm:observability ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:event-emission,
        ngm:state-change ;
    vc:implements ngm:audit-log ;
    vc:isPartOf ngm:append-only-log ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:blockchain-data,
        ngm:immutability,
        ngm:state-change ;
    vc:requires ngm:immutability,
        ngm:smart-contract ;
    vc:slug "event-log" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:blockchain-data,
        ngm:decentralised-application ;
    vc:uses ngm:ethereum-smart-contract-platform-virtual-machine,
        ngm:event-emission .

ngm:feature-detection a owl:Class ;
    rdfs:label "Feature Detection"@en ;
    rdfs:comment "Feature detection is the programmatic technique of querying a runtime environment to determine whether a specific capability, API, or behaviour is available before invoking it, rather than inferring support from user-agent strings or version numbers. In computer vision, it also denotes the algorithmic identification of salient points, edges, or regions within images that carry discriminative information for downstream tasks."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:sensor-data ],
        ngm:runtime-inspection ;
    vc:bridgesTo ngm:robotics,
