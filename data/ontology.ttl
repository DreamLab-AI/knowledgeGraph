ngm:multi-factor-authentication a owl:Class ;
    rdfs:label "Multi-Factor Authentication"@en ;
    rdfs:comment "Multi-factor authentication (MFA) is a security mechanism that requires a claimant to present two or more independent verification factors from distinct categories — typically something known (a password or PIN), something possessed (a hardware token or mobile device), and something inherent (a biometric characteristic) — before access is granted. By requiring multiple independent proofs, MFA ensures that compromise of a single credential is insufficient for an attacker to gain access. It is widely mandated by regulatory frameworks and security standards as a baseline control for protecting sensitive systems and data."@en ;
    rdfs:subClassOf ngm:authentication-mechanism ;
    vc:enables ngm:access-control,
        ngm:digital-identity-management ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:authentication,
        ngm:authentication-standards,
        ngm:cybersecurity-standard ;
    vc:slug "multi-factor-authentication" ;
    vc:sourceDomain "security" ;
    vc:supports ngm:data-security ;
    vc:uses ngm:biometric-binding-mechanism,
        ngm:cryptographic-keys .

ngm:open-xr a owl:Class ;
    rdfs:label "OpenXR"@en ;
    rdfs:comment "OpenXR is the Khronos Group's open, royalty-free API standard for cross-platform access to extended reality (XR) hardware — encompassing virtual reality (VR) headsets, augmented reality (AR) glasses, and mixed reality (MR) devices — that defines a unified application-to-runtime interface, elimina..."@en ;
