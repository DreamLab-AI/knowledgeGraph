    a owl:Restriction ;
    owl:onProperty infrastructure:requires ;
    owl:someValuesFrom distributed-collaboration:ImmersiveTechnology
] .

distributed-collaboration:TelecollaborationAndTelepresenceDomain rdfs:subClassOf [
