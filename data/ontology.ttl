ngm:double-spend-prevention a owl:Class ;
    rdfs:label "Double-Spend Prevention"@en ;
    rdfs:comment "Double-spend prevention refers to the set of cryptographic, consensus-based, and protocol-level mechanisms that ensure a given unit of digital value cannot be spent more than once within a payment or transaction system. This problem is fundamental to digital money because, unlike physical currency, digital data can be trivially copied; preventing double-spending without a trusted central authority was the key unsolved challenge that Satoshi Nakamoto's Bitcoin whitepaper addressed through the combination of a public transaction ledger and proof-of-work consensus."@en ;
    rdfs:subClassOf ngm:blockchain-security ;
    vc:contrastsWith ngm:double-spending ;
    vc:enables ngm:distributed-consensus,
        ngm:finality ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:byzantine-fault-tolerance,
        ngm:nakamoto-consensus ;
    vc:slug "double-spend-prevention" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:consensus-mechanism,
        ngm:cryptographic-hash,
        ngm:proof-of-stake,
        ngm:proof-of-work .

ngm:dynamic-model a owl:Class ;
    rdfs:label "Dynamic Model"@en ;
    rdfs:comment "A Dynamic Model is a mathematical or computational representation of a system that explicitly captures how the system's state evolves over time in response to inputs, internal dynamics, and disturbances. Distinguished from static models by their time-varying state equations—typically differential equations for continuous systems or recurrence relations for discrete systems—dynamic models are fundamental to control engineering, physics simulation, robotics, and economic forecasting. They may be physics-derived from first principles, identified from data using system identification techniques, or learned end-to-end from observations using neural networks."@en ;
    rdfs:subClassOf ngm:simulation ;
    vc:enables ngm:cyber-physical-systems,
        ngm:model-based-control,
        ngm:simulation-engine ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:digital-twin,
        ngm:physics-simulation,
        ngm:probabilistic-model,
        ngm:world-model ;
    vc:slug "dynamic-model" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:bayesian-inference,
        ngm:state-machine .

ngm:eclipse-attack a owl:Class ;
    rdfs:label "Eclipse Attack"@en ;
    rdfs:comment "An Eclipse Attack is a peer-to-peer network attack in which an adversary monopolises all of a target node's inbound and outbound connections, isolating it from the honest network. The eclipsed node is fed a fabricated view of the blockchain, enabling the attacker to double-spend against that node, delay its transaction confirmations, or waste its mining resources on a private fork. Countermeasures include connection diversity, random peer selection, and detecting network-level routing anomalies."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:sybil-attack ],
        ngm:bc-protocol-and-consensus,
        ngm:blockchain-entity,
        ngm:network-component ;
    skos:broader ngm:bc-protocol-and-consensus ;
    vc:contrastsWith ngm:byzantine-fault-tolerance,
        ngm:network-synchronization ;
    vc:enables ngm:double-spending ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:51-attack,
        ngm:blockchain-protocol,
        ngm:network-topology,
        ngm:peer-to-peer-network,
        ngm:selfish-mining ;
    vc:requires ngm:sybil-attack ;
    vc:slug "eclipse-attack" ;
    vc:sourceDomain "blockchain" .

ngm:economic-growth a owl:Class ;
    rdfs:label "Economic Growth"@en ;
    rdfs:comment "Economic Growth is the increase over time in the value of goods and services produced by an economy, typically measured as the rise in real gross domestic product. It is driven by accumulation of capital, growth in the labour force, and improvements in productivity from technology and innovation. Sustained growth is a primary objective of economic policy and a frequently cited benefit of technology adoption."@en ;
    rdfs:subClassOf ngm:economics ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:adoption-of-convergent-technologies,
