ngm:cbor a owl:Class ;
    rdfs:comment "Concise Binary Object Representation (CBOR) is a binary data serialisation format specified in RFC 7049 (superseded by RFC 8949) designed to enable extremely compact encoding of structured data with a data model that is a superset of JSON. CBOR encodes values using a type-length-value scheme, eliminating the overhead of textual delimiters and key quotation, which makes it particularly well-suited for constrained environments such as IoT devices, embedded systems, and low-bandwidth protocols where minimising message size and parsing complexity is critical."@en ;
    rdfs:label "CBOR"@en ;
    rdfs:subClassOf ngm:data-serialization ;
    rdfs:subClassOf _:r3727 ;
