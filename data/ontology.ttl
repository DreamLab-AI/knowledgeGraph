    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:governance-token,
        ngm:identity-management,
        ngm:reputation-system ;
    vc:slug "digital-citizenship" ;
    vc:sourceDomain "spatial-computing" .

ngm:digital-commons a owl:Class ;
    rdfs:label "Digital Commons"@en ;
    rdfs:comment "The digital commons are shared, non-rivalrous information resources that a community collectively produces, governs, and stewards under open licences and self-defined rules, rather than through private enclosure or state provision. Examples include open-source software, open data, free knowledge repositories, and open scientific outputs, often coordinated via peer production and commons-based governance. As a governance concept it bridges classical commons theory with digital public goods, examining how communities sustain shared resources, prevent enclosure, and align incentives in distributed and blockchain-supported settings."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:open-source ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:governance ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:open-data ],
        ngm:public-goods ;
    vc:bridgesTo ngm:digital-public-goods,
        ngm:public-goods ;
    vc:contrastsWith ngm:public-goods ;
    vc:dependsOn ngm:collective-action ;
    vc:enables ngm:digital-public-goods,
        ngm:open-science ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:open-data,
        ngm:open-source ;
    vc:isPartOf ngm:governance ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:creative-commons,
        ngm:open-data,
        ngm:open-science ;
    vc:requires ngm:governance ;
    vc:slug "digital-commons" ;
    vc:sourceDomain "governance" ;
    vc:supports ngm:collective-action ;
    vc:uses ngm:creative-commons,
        ngm:free-software .

ngm:digital-evidence-chain-of-custody a owl:Class ;
