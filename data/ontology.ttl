        ngm:electricity-consumption,
        ngm:hash-rate ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:slug "blockchain-energy-consumption" ;
    vc:sourceDomain "blockchain" .

ngm:carbon-credit-token a owl:Class ;
