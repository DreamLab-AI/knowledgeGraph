    vc:sourceDomain "finance" ;
    vc:supports ngm:financial-services,
        ngm:financial-system ;
    vc:uses ngm:data-analytics,
        ngm:financial-instruments .

ngm:position-sensor a owl:Class ;
    rdfs:label "Position Sensor"@en ;
    rdfs:comment "A position sensor is a transducer that measures the displacement, angle, or spatial location of an object or joint relative to a reference frame, converting mechanical position into an electrical signal suitable for control system feedback. Position sensors are fundamental to closed-loop robotic and mechatronic systems, enabling precise joint control, end-effector placement, and localisation. They span a wide range of physical measurement principles including optical encoding, magnetic hall-effect sensing, capacitive displacement, and inductive resolver techniques."@en ;
    rdfs:subClassOf ngm:sensor ;
    vc:enables ngm:localization,
        ngm:robot-manipulation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:encoder,
        ngm:imu,
        ngm:linear-encoder,
        ngm:proprioceptive-sensor,
        ngm:rotary-encoder ;
    vc:slug "position-sensor" ;
    vc:sourceDomain "robotics" ;
    vc:supports ngm:robot-kinematics,
        ngm:robotic-control .

ngm:post-hoc-explanation a owl:Class ;
    rdfs:label "Post Hoc Explanation"@en ;
    rdfs:comment "Interpretability techniques applied after a machine learning model has been trained, providing explanations for model behaviour and predictions without modifying the model's architecture or requiring retraining."@en ;
    rdfs:subClassOf ngm:ai-technique,
        ngm:explainability ;
    skos:broader ngm:ai-technique ;
    vc:contrastsWith ngm:intrinsic-interpretability ;
    vc:enables ngm:explainable-ai,
        ngm:human-oversight ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:slug "post-hoc-explanation" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:ai-governance,
        ngm:model-interpretability ;
    vc:uses ngm:fairness-metrics .

ngm:precision-agriculture a owl:Class ;
    rdfs:label "Precision Agriculture"@en ;
    rdfs:comment "Precision agriculture is a farming-management approach that uses sensing, geolocation, and data analytics to observe and respond to variability within fields at fine spatial resolution. It applies inputs such as water, fertiliser, and pesticide only where and when needed, improving yield and reducing waste. It integrates IoT sensors, satellite and drone imagery, and increasingly autonomous ground robots."@en ;
    rdfs:subClassOf ngm:ai-application ;
    skos:broader ngm:ai-application ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:ground-robot,
        ngm:io-t-sensor-network ;
    vc:slug "precision-agriculture" ;
    vc:sourceDomain "robotics" .

ngm:precision-manufacturing a owl:Class ;
    rdfs:label "Precision Manufacturing"@en ;
    rdfs:comment "Precision manufacturing is a set of industrial processes and quality systems that produce mechanical components and assemblies within extremely tight dimensional tolerances — typically sub-micrometre to nanometre scale — using advanced machining, metrology, and process control techniques. It encompasses CNC machining, ultra-precision grinding, electrical discharge machining (EDM), and micro-fabrication, combined with in-process measurement and statistical process control to ensure conformance to specification. Precision manufacturing is fundamental to the production of optical systems, semiconductor equipment, aerospace components, medical implants, and scientific instruments where dimensional accuracy directly determines system performance."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:cnc-machining ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:process-control ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:statistical-process-control ],
        ngm:manufacturing-automation ;
    vc:bridgesTo ngm:artificial-intelligence,
        ngm:robotics ;
    vc:enables ngm:digital-twin,
        ngm:industrial-robot,
        ngm:semiconductor-fabrication ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:cnc-machining,
        ngm:statistical-process-control ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:digital-fabrication,
        ngm:display-metrology,
        ngm:industrial-automation,
        ngm:quality-assurance ;
    vc:requires ngm:metrology,
        ngm:process-control,
        ngm:vibration-isolation ;
    vc:slug "precision-manufacturing" ;
    vc:sourceDomain "infrastructure" ;
    vc:standardizedBy ngm:iso-standards ;
    vc:supports ngm:additive-manufacturing ;
    vc:uses ngm:computer-vision,
        ngm:industrial-inspection,
        ngm:smart-manufacturing .

ngm:priority-fee a owl:Class ;
    rdfs:label "Priority Fee"@en ;
    rdfs:comment "A Priority Fee (also called a miner tip or validator tip) is an optional, user-specified additional payment on top of the base fee in EIP-1559-compatible blockchains, paid directly to the block producer to incentivise preferential inclusion and ordering of a transaction within the next block. By offering a higher tip, users signal urgency and compete for limited block space during periods of network congestion, enabling a market-based transaction prioritisation mechanism. Priority fees are burned alongside the base fee under EIP-1559's fee model only partially — the base fee is burned while the priority fee flows to the validator, aligning incentives for prompt transaction confirmation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:consensus-mechanism ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:blockchain-transaction ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:gas ],
        ngm:bc-defi-and-economics,
        ngm:blockchain-entity,
        ngm:economic-mechanism ;
    skos:broader ngm:bc-defi-and-economics ;
    vc:contrastsWith ngm:burning-mechanism ;
    vc:dependsOn ngm:base-fee,
        ngm:eip-1559 ;
    vc:enables ngm:gas-optimization,
        ngm:mev ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:gas ;
    vc:isPartOf ngm:fee-market,
        ngm:tokenomics ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:gas-fee-market,
        ngm:gas-price,
        ngm:transaction-fee,
        ngm:validator-node ;
    vc:requires ngm:blockchain-transaction,
        ngm:consensus-mechanism ;
    vc:slug "priority-fee" ;
    vc:sourceDomain "blockchain" .

ngm:privacy-policy a owl:Class ;
    rdfs:label "Privacy Policy"@en ;
    rdfs:comment "A privacy policy is a formal legal disclosure instrument through which an organisation communicates to data subjects the categories of personal data collected, the purposes and legal bases for processing, retention periods, third-party sharing arrangements, and individual rights available under applicable regulations. Such documents are mandated by data protection frameworks including the EU General Data Protection Regulation (GDPR), the UK Data Protection Act 2018, and the California Consumer Privacy Act (CCPA), each requiring clear, accessible language and prominent placement at the point of data collection to constitute valid notice. Privacy policies function both as a transparency mechanism for individuals and as a compliance artefact evidencing an organisation's accountability obligations. As AI systems introduce novel data flows—inference logging, training on user data, automated decision-making—privacy policies must be continuously updated to reflect these processing activities accurately."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-protection-officer ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-protection-regulation ],
        ngm:data-governance ;
    vc:bridgesTo ngm:ai-transparency-framework,
        ngm:automated-decision-making ;
    vc:contrastsWith ngm:cookie-policy,
        ngm:terms-of-service ;
    vc:dependsOn ngm:data-protection-impact-assessment,
        ngm:gdpr-compliance ;
    vc:enables ngm:data-minimisation,
        ngm:informed-consent,
        ngm:purpose-limitation ;
    vc:hasMaturity ngmi:maturity-draft ;
