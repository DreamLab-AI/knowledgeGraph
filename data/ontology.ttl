ngm:continuous-training a owl:Class ;
    rdfs:label "Continuous Training"@en ;
    rdfs:comment "Continuous training is an MLOps practice in which machine-learning models are automatically retrained on fresh data on a recurring or event-driven basis to maintain predictive accuracy over time. It extends continuous integration and delivery to the model lifecycle, triggering retraining when new data arrives or when monitoring detects data or model drift. The retrained model is validated and promoted through automated pipelines before deployment."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:model-evaluation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-versioning ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:model-training-pipeline ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:model-registry ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:model-registry ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:feature-store ],
        ngm:mlops ;
    vc:contrastsWith ngm:batch-training,
        ngm:offline-learning ;
    vc:dependsOn ngm:data-drift,
        ngm:feature-store,
        ngm:model-monitoring ;
    vc:enables ngm:model-deployment,
        ngm:model-serving,
        ngm:production-ml ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:drift-detection,
        ngm:model-evaluation,
        ngm:model-registry,
        ngm:model-training-pipeline ;
