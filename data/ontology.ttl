            owl:someValuesFrom ngm:distributed-ledger-technology ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptographic-hash-function ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:cold-chain-monitoring ],
        ngm:blockchain-application ;
    vc:bridgesTo ngm:regulatory-compliance,
        ngm:supply-chain-management ;
    vc:contrastsWith ngm:centralised-database,
        ngm:traditional-edi ;
    vc:dependsOn ngm:peer-to-peer-network,
        ngm:permissioned-blockchain ;
    vc:enables ngm:anti-counterfeiting,
        ngm:provenance-verification,
        ngm:supply-chain-transparency,
        ngm:traceability ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:cold-chain-monitoring,
        ngm:supplier-compliance-verification ;
    vc:qualityScore "0.7"^^xsd:float ;
