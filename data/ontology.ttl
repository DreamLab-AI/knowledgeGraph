# ==============================================================================
# ONTOLOGY DECLARATION
# ==============================================================================

<http://narrativegoldmine.com/ontology> a owl:Ontology ;
    rdfs:label "Multi-Domain Knowledge Ontology"@en ;
    rdfs:comment "Comprehensive ontology covering AI, Blockchain, Robotics, Metaverse, Telecollaboration, and Disruptive Technologies."@en ;
    owl:versionInfo "1.0.0" ;
    dcterms:created "2026-03-04"^^xsd:date ;
    dcterms:creator "Logseq Ontology Tools" .

