    vc:sourceDomain "standards" .

ngm:ieee-802-3 a owl:Class ;
    rdfs:label "IEEE 802.3"@en ;
    rdfs:comment "An IEEE standard defining Ethernet, including the physical layer and media access control for wired local area networks. It covers a range of speeds and media types."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ieee ],
        ngm:technical-standard ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:ieee ;
