    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:rdf,
        ngm:sparql ;
    vc:slug "rdf-store" ;
    vc:sourceDomain "general" .

ngm:real-time-ai a owl:Class ;
    rdfs:label "Real-Time AI"@en ;
    rdfs:comment "Real-Time AI refers to the application of artificial intelligence inference within strict latency bounds — typically sub-second to sub-millisecond — required for time-sensitive tasks such as autonomous driving, robotics control, live speech processing, financial trading, and augmented reality. It integrates specialised hardware (NPUs, GPUs, FPGAs), optimised model representations (quantisation, pruning, TensorRT/ONNX), and edge deployment architectures to ensure deterministic response times. The distinction from batch AI lies in the hard or soft real-time constraints that govern system correctness."@en ;
    rdfs:subClassOf ngm:real-time-computation ;
    vc:enables ngm:autonomous-vehicle,
        ngm:real-time-inference-at-edge,
        ngm:real-time-monitoring ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:latency,
        ngm:real-time-processing ;
    vc:slug "real-time-ai" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:edge-computing,
        ngm:hardware-acceleration,
        ngm:inference-engine,
        ngm:npu .

ngm:real-time-character-animation a owl:Class ;
    rdfs:label "Real Time Character Animation"@en ;
    rdfs:comment "The process of generating and rendering character movements instantaneously during gameplay or interactive experiences, utilizing rigging systems, motion capture data, and procedural animation to create lifelike digital characters that respond dynamically to user input and environmental conditions."@en ;
    rdfs:subClassOf ngm:3-d-animation,
        ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:enables ngm:interactive-experiences ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:slug "real-time-character-animation" ;
    vc:sourceDomain "spatial-computing" .

ngm:real-time-computing a owl:Class ;
    rdfs:label "Real-Time Computing"@en ;
    rdfs:comment "Computing in which correctness depends not only on the logical result but also on meeting timing deadlines. Systems are classified as hard, firm, or soft real-time according to the consequences of missing a deadline."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:real-time-operating-system ],
        ngm:owl-thing ;
    vc:enables ngm:embedded-systems ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:real-time-operating-system ;
    vc:slug "real-time-computing" ;
    vc:sourceDomain "computing" .

ngm:real-time-control-loop a owl:Class ;
    rdfs:label "Real-Time Control Loop"@en ;
    rdfs:comment "A real-time control loop is a cyclic sense-compute-actuate process that runs at a fixed, deterministic frequency to regulate a physical or cyber-physical system within strict timing deadlines. Missing a deadline can cause instability or unsafe behaviour, so loops require real-time scheduling and bounded computation. They are the operational core of robotics, motion control, and industrial automation."@en ;
    rdfs:subClassOf ngm:control-system ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:admittance-control,
        ngm:cyber-physical-systems-domain ;
    vc:slug "real-time-control-loop" ;
    vc:sourceDomain "robotics" .

ngm:real-time-rendering-engine a owl:Class ;
    rdfs:label "Real-Time Rendering Engine"@en ;
    rdfs:comment "A real-time rendering engine generates images from 3D scene descriptions fast enough to sustain interactive frame rates, typically 30 to 120+ frames per second. It coordinates GPU rasterisation or ray tracing, shading, lighting, and post-processing within a fixed per-frame time budget. It is the visual core of game engines, virtual production, and immersive metaverse experiences."@en ;
    rdfs:subClassOf ngm:sc-display-and-rendering ;
    skos:broader ngm:sc-display-and-rendering ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:metaverse-content-pipeline,
        ngm:virtual-production-volume ;
    vc:slug "real-time-rendering-engine" ;
    vc:sourceDomain "metaverse" .

ngm:real-time-streaming a owl:Class ;
    rdfs:label "Real-Time Streaming"@en ;
    rdfs:comment "Real-time streaming is the continuous delivery of data, audio, or video as an ongoing flow consumed incrementally with minimal latency rather than downloaded in full beforehand. It uses low-latency transport protocols and buffering strategies to balance smoothness against delay. It underpins live media, event streams, and interactive low-latency experiences."@en ;
    rdfs:subClassOf ngm:network-protocol ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:agent-event-stream,
        ngm:virtual-performance-space ;
    vc:slug "real-time-streaming" ;
    vc:sourceDomain "infrastructure" .

ngm:real-time-synchronisation a owl:Class ;
    rdfs:label "Real-Time Synchronisation"@en ;
    rdfs:comment "Real-time synchronisation is the continuous propagation of state changes across distributed participants so that all observers converge on a consistent, up-to-date view with minimal delay. It combines low-latency transport, conflict resolution, and clock or causal ordering to keep replicas aligned. It is essential for collaborative tools, multiplayer environments, and digital-twin mirroring."@en ;
    rdfs:subClassOf ngm:distributed-systems ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:digital-twin,
        ngm:distributed-collaboration-domain ;
    vc:slug "real-time-synchronisation" ;
    vc:sourceDomain "infrastructure" .

ngm:reality-capture a owl:Class ;
    rdfs:label "Reality Capture"@en ;
    rdfs:comment "Reality capture is the process of digitising the physical world into accurate, measurable 3D representations using sensors such as LiDAR scanners, photogrammetric camera arrays, and depth cameras, producing point clouds, textured meshes, or digital twin models. It encompasses the full workflow from on-site data acquisition to processing, georeferencing, and delivery of survey-grade or visualisation-grade 3D assets. Reality capture is foundational to construction, heritage preservation, urban digital twins, and spatial computing content pipelines."@en ;
    rdfs:subClassOf ngm:etsi-domain-reality-capture ;
    vc:enables ngm:environmental-mapping,
        ngm:point-cloud-processing ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:3-d-scanning,
        ngm:geospatial-technology ;
    vc:slug "reality-capture" ;
    vc:sourceDomain "spatial" ;
    vc:uses ngm:laser-scanner,
        ngm:lidar-scanning,
        ngm:multi-view-stereo,
        ngm:photogrammetry .

ngm:reasoning-trace a owl:Class ;
    rdfs:label "Reasoning Trace"@en ;
    rdfs:comment "A reasoning trace is the recorded sequence of intermediate thoughts, tool calls, and decisions a model produces while solving a task, distinct from its final output. It serves as both a working scratchpad that improves accuracy and an audit artefact for inspecting how an agent reached a conclusion. Traces underpin debugging, evaluation, and self-correction in agentic systems."@en ;
    rdfs:subClassOf ngm:ai-agent-system ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:agents,
        ngm:computer-use-and-browser-agents ;
    vc:slug "reasoning-trace" ;
    vc:sourceDomain "ai" .

ngm:recall a owl:Class ;
    rdfs:label "Recall"@en ;
    rdfs:comment "A classification performance metric representing the proportion of actual positive instances that an artificial intelligence model correctly identifies, calculated as the ratio of true positives to all actual positives (true positives plus false negatives), measuring the model's completeness in d..."@en ;
    rdfs:subClassOf ngm:evaluation-metric,
        ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:relatedTo ngm:spatial-computing ;
    vc:slug "recall" ;
    vc:sourceDomain "spatial-computing" .

ngm:record-keeping a owl:Class ;
    rdfs:label "Record Keeping"@en ;
    rdfs:comment "Record keeping is the systematic retention of transaction, customer, and decision records so that activities can be reconstructed and verified by auditors or regulators. In financial compliance it mandates preserving identity documentation, transaction details, and risk assessments for prescribed periods. Robust record keeping is a precondition for meeting anti-money-laundering and travel-rule obligations."@en ;
    rdfs:subClassOf ngm:regulatory-compliance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:aml-kyc-compliance,
        ngm:travel-rule ;
    vc:slug "record-keeping" ;
    vc:sourceDomain "governance" .

ngm:reference-model a owl:Class ;
    rdfs:label "Reference Model"@en ;
    rdfs:comment "A reference model is an abstract, authoritative description of the desired behaviour or structure of a system, used as the standard against which an actual implementation is measured or controlled. In control theory it specifies the ideal closed-loop response that a model-reference adaptive controller drives the plant to follow. In evaluation it serves as the baseline whose outputs define the expected target."@en ;
    rdfs:subClassOf ngm:control-system ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:control-algorithm,
        ngm:evaluation-benchmarks-and-leaderboards ;
    vc:slug "reference-model" ;
    vc:sourceDomain "robotics" .

ngm:reference-signal a owl:Class ;
    rdfs:label "Reference Signal"@en ;
    rdfs:comment "A reference signal is the commanded target value, or setpoint trajectory, that a control system attempts to make its output follow over time. The controller computes the error between the reference and the measured output and acts to drive that error to zero. The shape and feasibility of the reference signal directly determine achievable tracking performance."@en ;
    rdfs:subClassOf ngm:control-theory ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:control-theory,
        ngm:feedback-loop ;
    vc:slug "reference-signal" ;
    vc:sourceDomain "robotics" .

ngm:reflection-loop a owl:Class ;
    rdfs:label "Reflection Loop"@en ;
    rdfs:comment "A reflection loop is an agentic control pattern in which a model critiques its own intermediate output, identifies errors or gaps, and revises before continuing or finalising. By iterating between generation and self-evaluation, the agent improves quality on tasks where a single pass is unreliable. It is a building block of self-correcting LLM agents and tool-using workflows."@en ;
    rdfs:subClassOf ngm:ai-agent-system ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:agents,
        ngm:computer-use-and-browser-agents ;
    vc:slug "reflection-loop" ;
    vc:sourceDomain "ai" .

ngm:regulation-domain a owl:Class ;
    rdfs:label "Regulation Domain"@en ;
    rdfs:comment "The Regulation Domain covers the creation, interpretation and enforcement of rules that govern conduct across sectors. Its scope includes statutory frameworks, standards, supervisory regimes and enforcement mechanisms. It is a top-level subject classification that supplies obligations to many other domains. The boundary excludes the demonstration of adherence to those rules, which belongs to the Compliance Domain."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:standards ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:logic ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:legal-tech-domain ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:knowledge-representation-domain ],
        ngm:owl-thing ;
    vc:enables ngm:obligation-definition,
        ngm:regulatory-frameworks,
        ngm:supervision ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:enforcement,
        ngm:rule-making,
        ngm:standards,
        ngm:statutory-framework,
        ngm:supervisory-regime ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:knowledge-representation-domain,
        ngm:legal-tech-domain,
        ngm:logic ;
    vc:slug "regulation-domain" ;
    vc:sourceDomain "regulation" .

ngm:regulatory-authorisation a owl:Class ;
    rdfs:label "Regulatory Authorisation"@en ;
    rdfs:comment "Regulatory authorisation is the formal permission granted by a competent authority allowing an entity to conduct a regulated activity such as issuing tokens, operating a payment system, or holding client assets. It is obtained through an application demonstrating compliance with capital, governance, and conduct requirements. Without authorisation, issuance and operation of regulated financial instruments are unlawful in most jurisdictions."@en ;
    rdfs:subClassOf ngm:bc-governance-and-regulation ;
    skos:broader ngm:bc-governance-and-regulation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:cbdc-frameworks,
        ngm:enterprise-token-standards ;
    vc:slug "regulatory-authorisation" ;
    vc:sourceDomain "blockchain" .

ngm:regulatory-licence a owl:Class ;
    rdfs:label "Regulatory Licence"@en ;
    rdfs:comment "A regulatory licence is a specific, often named permission issued by a financial supervisor that authorises an entity to carry out a defined regulated activity such as issuing e-money or operating as a payment institution. It binds the holder to ongoing conditions including capital adequacy, reporting, and conduct rules. For stablecoin issuers, the appropriate licence determines whether the token may legally be offered to the public."@en ;
    rdfs:subClassOf ngm:financial-regulation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:stable-coins,
        ngm:stablecoin-regulation ;
    vc:slug "regulatory-licence" ;
    vc:sourceDomain "blockchain" .

ngm:regulatory-reporting-module a owl:Class ;
    rdfs:label "Regulatory Reporting Module"@en ;
    rdfs:comment "A regulatory reporting module is a self-contained software component that collects, formats, and dispatches the disclosures an entity owes to its regulators. It encapsulates jurisdiction-specific schemas, validation rules, and submission channels so they can be reused across systems. As a discrete subsystem it plugs into compliance-monitoring and tax-compliance pipelines to produce audit-ready outputs."@en ;
    rdfs:subClassOf ngm:regulatory-compliance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:compliance-monitoring,
        ngm:digital-tax-compliance-node ;
    vc:slug "regulatory-reporting-module" ;
    vc:sourceDomain "blockchain" .

ngm:relationship-edge a owl:Class ;
    rdfs:label "Relationship Edge"@en ;
    rdfs:comment "A relationship edge is a directed or undirected connection in a graph that represents a typed association between two entity nodes, often carrying a label and properties. In knowledge and identity graphs, edges encode facts such as ownership, membership, or similarity that give the graph its semantic structure. Edge type and weight determine how the graph can be queried, traversed, and reasoned over."@en ;
    rdfs:subClassOf ngm:distributed-data-structure ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:identity-graph,
        ngm:knowledge-graph ;
    vc:slug "relationship-edge" ;
    vc:sourceDomain "data" .

ngm:remediation-plan a owl:Class ;
    rdfs:label "Remediation Plan"@en ;
    rdfs:comment "A remediation plan is a structured set of corrective actions, owners, and deadlines drawn up to address identified non-conformities, risks, or harms discovered through audit or monitoring. It links each finding to a specific fix and tracks progress to closure. In compliance and ethical-sourcing contexts it is the mechanism that turns a violation into demonstrable improvement."@en ;
    rdfs:subClassOf ngm:regulatory-compliance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:compliance-control,
        ngm:ethical-sourcing ;
    vc:slug "remediation-plan" ;
    vc:sourceDomain "governance" .

ngm:renderer a owl:Class ;
    rdfs:label "Renderer"@en ;
    rdfs:comment "A renderer is the software or hardware component that converts a scene description, such as geometry, materials, lights, or a markup specification, into a final image or visual output. Renderers range from real-time rasterisers and ray tracers to text-and-diagram engines that draw from declarative source. The choice of renderer determines visual fidelity, performance, and the formats a system can produce."@en ;
    rdfs:subClassOf ngm:sc-display-and-rendering ;
    skos:broader ngm:sc-display-and-rendering ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:diagrams-as-code,
        ngm:universal-scene-description ;
    vc:slug "renderer" ;
    vc:sourceDomain "metaverse" .

ngm:rendering-technology a owl:Class ;
    rdfs:label "Rendering Technology"@en ;
    rdfs:comment "Rendering Technology comprises the algorithms, pipelines, and hardware interfaces that convert geometric scene descriptions into pixel images. It encompasses rasterisation, ray tracing, and hybrid approaches, executed on GPUs through APIs such as Vulkan, Metal, and WebGPU, and is foundational to real-time interactive graphics, spatial computing experiences, and digital twin visualisation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:rendering-engine ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:shader ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:rendering-pipeline ],
        ngm:sc-display-and-rendering ;
    skos:broader ngm:sc-display-and-rendering ;
    vc:enables ngm:augmented-reality,
        ngm:real-time-rendering ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:rendering-engine,
        ngm:rendering-pipeline,
        ngm:shader ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:slug "rendering-technology" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:gpu-compute,
        ngm:scene-graph .

ngm:replication-system a owl:Class ;
    rdfs:label "Replication System"@en ;
    rdfs:comment "A replication system maintains synchronised copies of data or state across multiple nodes in a distributed environment, ensuring consistency, availability, and fault tolerance. It coordinates state propagation through protocols such as leader-based or leaderless replication, supporting both synchronous and asynchronous update strategies in blockchain, database, and metaverse infrastructure contexts."@en ;
    rdfs:subClassOf ngm:infra-data-management ;
    skos:broader ngm:infra-data-management ;
    vc:dependsOn ngm:consensus-mechanism,
        ngm:distributed-system ;
    vc:enables ngm:fault-tolerance,
        ngm:high-availability ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:implements ngm:data-replication ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:database-system ;
    vc:slug "replication-system" ;
    vc:sourceDomain "infrastructure" .

ngm:reporting-mechanisms a owl:Class ;
    rdfs:label "Reporting Mechanisms"@en ;
    rdfs:comment "Reporting mechanisms are the user-facing tools and processes through which people flag illegal content, abuse, or policy violations to a platform or authority. They are a mandated component of content-moderation regimes, requiring accessible channels, acknowledgement, and traceable handling of notices. Well-designed mechanisms balance ease of reporting against abuse of the reporting system itself."@en ;
    rdfs:subClassOf ngm:metaverse-governance-and-safeguarding ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:community-standards,
        ngm:digital-services-act ;
    vc:slug "reporting-mechanisms" ;
    vc:sourceDomain "governance" .

ngm:ring-signature a owl:Class ;
    rdfs:label "Ring Signature"@en ;
    rdfs:comment "A ring signature is a digital signature produced by one member of a group such that verifiers learn the signature came from the group but cannot identify which member signed. It provides signer anonymity within an ad hoc set."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptography ],
        ngm:cryptography ;
    vc:enables ngm:pseudonymity ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:cryptography ;
    vc:slug "ring-signature" ;
    vc:sourceDomain "cryptography" .

ngm:risk-scoring-engine a owl:Class ;
    rdfs:label "Risk Scoring Engine"@en ;
    rdfs:comment "A risk scoring engine is a software component that computes a numerical risk score for an entity, transaction, or session by combining multiple weighted signals through rules or models. In compliance and identity systems it quantifies how likely an action is fraudulent or non-compliant, feeding thresholds that trigger review, blocking, or escalation. The score provides a consistent, tunable basis for automated decisions."@en ;
    rdfs:subClassOf ngm:infra-security-and-identity ;
    skos:broader ngm:infra-security-and-identity ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:compliance-monitoring,
        ngm:identity-verification ;
    vc:slug "risk-scoring-engine" ;
    vc:sourceDomain "security" .

ngm:ro-berta a owl:Class ;
    rdfs:label "RoBERTa"@en ;
    rdfs:comment "RoBERTa (Robustly Optimised BERT Pretraining Approach) is a transformer-based language model that refines BERT by removing the next-sentence-prediction objective, adopting dynamic masking, training on substantially larger corpora (160 GB vs 16 GB), and using larger batch sizes. These training-procedure improvements yield consistent performance gains on NLP benchmarks without altering the underlying transformer encoder architecture."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:language-modeling ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:transformer-architecture ],
        ngm:ai-model-architecture ;
    skos:broader ngm:ai-model-architecture ;
    vc:contrastsWith ngm:albert ;
    vc:enables ngm:named-entity-recognition,
        ngm:sentiment-analysis ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:requires ngm:language-modeling,
        ngm:transformer-architecture ;
    vc:slug "ro-berta" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:fine-tuning,
        ngm:transfer-learning .

ngm:role-based-access-control a owl:Class ;
    rdfs:label "Role-Based Access Control"@en ;
    rdfs:comment "Role-Based Access Control (RBAC) is an access control paradigm in which permissions to perform operations on system resources are assigned to roles rather than to individual users, and users acquire those permissions by being assigned to one or more roles that reflect their organisational function. It enforces the principle of least privilege and separation of duties by decoupling user identity from resource authorisation through an intermediate role abstraction."@en ;
    rdfs:subClassOf ngm:access-control ;
    vc:enables ngm:access-control-decisions,
        ngm:authorisation ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:governance-framework,
        ngm:policy-enforcement,
        ngm:zero-trust-architecture ;
    vc:slug "role-based-access-control" ;
    vc:sourceDomain "security" ;
    vc:uses ngm:authentication,
        ngm:identity-and-access-management .

ngm:room-state-tracking a owl:Class ;
    rdfs:label "Room State Tracking"@en ;
    rdfs:comment "Room state tracking is the mechanism in real-time collaboration and conferencing systems that maintains an authoritative, synchronised record of a virtual room's membership, media status, and shared state. It tracks who is present, their roles, mute and stream states, and assignments such as breakout-room placement. Reliable state tracking ensures all participants and the server share a consistent view of the session."@en ;
    rdfs:subClassOf ngm:dc-telepresence ;
    skos:broader ngm:dc-telepresence ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:breakout-room ;
    vc:slug "room-state-tracking" ;
    vc:sourceDomain "metaverse" .

ngm:rrt-algorithm a owl:Class ;
    rdfs:label "RRT Algorithm"@en ;
    rdfs:comment "A sampling-based path planning algorithm that incrementally builds a tree of collision-free configurations by randomly sampling the configuration space and connecting samples to the nearest existing tree node. It efficiently explores high-dimensional spaces and is probabilistically complete."@en ;
    rdfs:subClassOf ngm:path-planning,
        ngm:robo-navigation-and-planning ;
    skos:broader ngm:robo-navigation-and-planning ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires ngm:collision-checker,
        ngm:configuration-space ;
    vc:slug "rrt-algorithm" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:collision-detection,
        ngm:nearest-neighbor-search .

ngm:rtcp-feedback a owl:Class ;
    rdfs:label "RTCP Feedback"@en ;
    rdfs:comment "RTCP feedback is the control-channel mechanism of the RTP Control Protocol by which receivers report reception quality, such as packet loss, jitter, and round-trip time, back to senders during real-time media streaming. Senders use these reports, along with extensions like NACK, PLI, and REMB, to adapt encoding bitrate and recover from loss. It is the feedback loop that enables congestion-aware, resilient audiovisual transport."@en ;
    rdfs:subClassOf ngm:communication-protocol ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:bandwidth-adaptation ;
    vc:slug "rtcp-feedback" ;
    vc:sourceDomain "infrastructure" .

ngm:runtime-layer a owl:Class ;
    rdfs:label "Runtime Layer"@en ;
    rdfs:comment "The Runtime Layer is the stratum that provides the execution environment in which higher-level code and models actually run. It sits above the Compute Layer that allocates resources and below the application and inference strata it hosts. It contains process and memory management, schedulers, sandboxes, and the libraries that support running programmes."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:compute-layer ],
        ngm:owl-thing ;
    vc:enables ngm:application-layer,
        ngm:inference-layer ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:compute-layer ;
    vc:slug "runtime-layer" ;
    vc:sourceDomain "runtime" .

ngm:safety-critical-systems a owl:Class ;
    rdfs:label "Safety-Critical Systems"@en ;
    rdfs:comment "Safety-critical systems are hardware and software systems whose failure or malfunction could result in death, serious injury, significant property damage, or severe environmental harm. They are subject to rigorous engineering processes, formal standards, and independent certification to demonstrate that residual risk is reduced to an acceptable level."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:hazard-analysis ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:formal-verification ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:functional-safety ],
        ngm:systems-engineering ;
    vc:hasMaturity ngmi:maturity-draft ;
