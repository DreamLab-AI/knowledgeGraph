    vc:dependsOn ngm:probability-distribution ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:model-monitoring ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:anomaly-detection ;
    vc:relatedTo ngm:covariate-shift ;
    vc:relatedTo ngm:distribution-shift ;
    vc:requires ngm:retraining ;
    vc:slug "data-drift" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:density-estimation ;
    vc:uses ngm:statistics .
