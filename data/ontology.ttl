ngm:open-source-ai a owl:Class ;
    rdfs:label "Open-Source AI"@en ;
    rdfs:comment "Open-Source AI denotes artificial intelligence systems—including model weights, training code, datasets, evaluation benchmarks, and inference tooling—released under licences that permit public inspection, reproduction, modification, and redistribution. The degree of openness varies widely: fully open releases expose weights, training data, and procedures; open-weights releases share weights and inference code while withholding training data; and open-API systems expose neither. This transparency gradient determines reproducibility, auditability, and dual-use risk, and is formalised by frameworks such as the OSI Open Source AI Definition. Open-source AI accelerates community safety research, enables fine-tuning on proprietary data, and reduces vendor lock-in, while simultaneously raising governance questions about capability proliferation and misuse."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:inference-engine ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:training-dataset ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:model-weights ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:compute-infrastructure ],
        ngm:open-source-software ;
    vc:bridgesTo ngm:distributed-collaboration,
        ngm:regulatory-compliance ;
    vc:contrastsWith ngm:closed-source-model,
        ngm:proprietary-ai ;
    vc:dependsOn ngm:large-language-model,
        ngm:neural-network-architecture ;
    vc:enables ngm:edge-ai,
        ngm:federated-learning,
        ngm:fine-tuning,
        ngm:model-quantisation,
        ngm:red-teaming ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:evaluation-benchmark,
        ngm:inference-engine,
        ngm:model-weights,
        ngm:training-dataset ;
    vc:isPartOf ngm:open-source-software ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:community-fine-tuning,
        ngm:dual-use-risk,
        ngm:model-hub ;
    vc:requires ngm:compute-infrastructure,
        ngm:open-source-licence ;
    vc:slug "open-source-ai" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:standardizedBy ngm:eu-ai-act,
        ngm:osi-open-source-ai-definition ;
    vc:supports ngm:ai-governance,
        ngm:ai-safety,
        ngm:scientific-reproducibility .

ngm:rlhf a owl:Class ;
    rdfs:label "RLHF"@en ;
    rdfs:comment "Reinforcement Learning from Human Feedback (RLHF) is a training methodology that aligns large language models and other AI systems with human preferences by first collecting human comparison judgements between model outputs, training a reward model on those judgements, and then optimising the language model policy against the reward model using reinforcement learning — typically Proximal Policy Optimisation with a KL-divergence penalty to prevent reward hacking. RLHF enables models to be steered towards outputs that human annotators prefer for helpfulness, harmlessness, and honesty, going beyond what is achievable with supervised fine-tuning on static demonstration data alone. The technique was popularised by OpenAI's InstructGPT work and underlies the alignment pipeline of models such as ChatGPT, Claude, and Gemini. Variants including Direct Preference Optimisation, Constitutional AI, and RLAIF (Reinforcement Learning from AI Feedback) extend or simplify the original three-stage pipeline."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:reward-model ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:reinforcement-learning ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:human-feedback ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:supervised-fine-tuning ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:proximal-policy-optimisation ],
        ngm:ai-alignment ;
    vc:bridgesTo ngm:crowdsourcing,
        ngm:data-annotation,
        ngm:human-computer-interaction ;
    vc:contrastsWith ngm:direct-preference-optimisation,
        ngm:rlaif,
        ngm:supervised-fine-tuning ;
    vc:enables ngm:ai-alignment,
        ngm:ai-safety,
        ngm:harmlessness,
        ngm:instruction-following ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:model-alignment-pipeline ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:constitutional-ai-training-methodology,
        ngm:instruct-gpt,
        ngm:policy-gradient,
        ngm:reward-hacking ;
    vc:requires ngm:human-feedback,
        ngm:proximal-policy-optimisation,
        ngm:reinforcement-learning,
        ngm:reward-model,
        ngm:supervised-fine-tuning ;
    vc:slug "rlhf" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:human-annotation,
        ngm:kl-divergence,
        ngm:large-language-model,
        ngm:preference-data .

ngm:rollup a owl:Class ;
    rdfs:label "Rollup"@en ;
    rdfs:comment "A Rollup is a blockchain scaling technique that executes transactions off a base layer such as Ethereum while posting compressed transaction data and state commitments back to it for settlement and data availability. By batching many transactions and proving or asserting their validity on the main chain, rollups increase throughput and reduce fees while inheriting much of the base layer's security. Two main types exist: optimistic rollups, which assume validity and rely on fraud proofs during a challenge window, and zero-knowledge rollups, which post validity proofs verifying each batch. Rollups are central to Ethereum's layer-2 scaling strategy."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ethereum-smart-contract-platform ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:fraud-proof ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:zero-knowledge-proof ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:smart-contract ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-availability ],
        ngm:layer-2-scaling ;
    vc:bridgesTo ngm:cross-chain-bridge,
        ngm:decentralised-finance ;
    vc:contrastsWith ngm:plasma,
        ngm:sidechain,
        ngm:state-channel ;
    vc:dependsOn ngm:cryptographic-proof,
        ngm:ethereum-virtual-machine ;
    vc:enables ngm:arbitrum,
        ngm:decentralised-application,
        ngm:optimism,
        ngm:polygon,
        ngm:zk-sync ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:fraud-proof,
        ngm:sequencer,
        ngm:zero-knowledge-proof ;
    vc:implements ngm:off-chain-computation,
        ngm:transaction-batching ;
    vc:isPartOf ngm:ethereum-scaling-roadmap,
        ngm:layer-2-scaling ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:danksharding,
        ngm:proto-danksharding ;
    vc:requires ngm:data-availability,
        ngm:ethereum-smart-contract-platform,
        ngm:smart-contract ;
    vc:slug "rollup" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:calldata,
        ngm:merkle-tree .

ngm:surgical-robotics a owl:Class ;
    rdfs:label "Surgical Robotics"@en ;
    rdfs:comment "Surgical robotics is the application of robotic systems, real-time computer vision, and AI-driven control to assist surgeons or perform procedures with enhanced precision, dexterity, tremor cancellation, and minimally invasive access. Systems range from teleoperated master-slave platforms—where a surgeon's hand movements are scaled, filtered, and transmitted to slave arms—to semi-autonomous robots capable of tissue manipulation and suturing under human supervision. Key technical challenges include sub-millimetre motion tracking, intraoperative tissue deformation modelling, real-time haptic feedback, safe human-robot interaction, and regulatory compliance under medical device frameworks such as ISO 13485, IEC 62304, and EU MDR. The field sits at the intersection of mechatronics, control theory, computer vision, AI inference, and clinical medicine."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:haptic-feedback ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:real-time-control ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:motion-planning ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:medical-imaging ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:sensor-fusion ],
        ngm:robo-robot-type ;
    skos:broader ngm:robo-robot-type ;
    vc:bridgesTo ngm:5g-networks,
        ngm:augmented-reality,
        ngm:digital-twin ;
    vc:contrastsWith ngm:laparoscopic-surgery,
        ngm:open-surgery ;
    vc:enables ngm:autonomous-suturing,
        ngm:medical-ai,
        ngm:remote-surgery,
        ngm:teleoperation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:endoscope,
        ngm:haptic-feedback,
        ngm:master-slave-control,
        ngm:robotic-arm ;
    vc:isPartOf ngm:medical-robotics,
        ngm:minimally-invasive-surgery ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:neurosurgical-robotics,
        ngm:orthopaedic-robotics,
        ngm:patient-safety,
        ngm:surgical-robot ;
    vc:requires ngm:medical-imaging,
        ngm:motion-planning,
        ngm:real-time-control,
        ngm:sensor-fusion ;
    vc:slug "surgical-robotics" ;
