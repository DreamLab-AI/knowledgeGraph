    dcterms:modified "2026-04-26T13:00:00Z"^^xsd:dateTime ;
    vcw:owlRole "Concept" .

# Robustness (OECD)
spatial-computing:RobustnessOECD rdf:type owl:Class ;
    rdfs:label "Robustness (OECD)"@en ;
    rdfs:comment "AI systems should function reliably and securely throughout their lifecycle, demonstrating resilience against errors, faults, inconsistencies and attempts to alter system use or performance, with continuous assessment and management of potential risks."@en ;
    skos:prefLabel "Robustness (OECD)"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:spatial-computing:robustness-oecd" ;
    owl:sameAs <urn:visionclaw:concept:spatial-computing:robustness-oecd> ;
    vcw:contentHash "sha256-12-9542925eb0ae" ;
    vcw:qualityScore "0.5"^^xsd:decimal ;
    vcw:legacyTermId "AI-0163" ;
