        <urn:visionflow:linked:sec-form-s-1-registration>,
        <urn:visionflow:linked:stock-exchange-listing>,
        <urn:visionflow:linked:surveillance-sharing-agreement> ;
    vc:slug "bitcoin-etf" ;
    vc:sourceDomain "blockchain" .

