    vc:slug "renewable-energy-integration" ;
    vc:sourceDomain "blockchain" .
ngm:renewable-energy-investment a owl:Class ;
    rdfs:comment "Renewable energy investment is the allocation of capital toward generation assets and infrastructure that produce energy from renewable sources such as solar, wind and hydro, spanning project finance, equity investment and green bonds. It is a core mechanism within green finance for directing capital toward decarbonisation, and it has been linked to blockchain-based schemes that monetise otherwise stranded renewable energy. Investment volumes and returns in this sector are sensitive to policy incentives, grid infrastructure and financing cost."@en ;
    rdfs:label "Renewable Energy Investment"@en ;
    rdfs:subClassOf ngm:green-finance ;
