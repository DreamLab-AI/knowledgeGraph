        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:ai-frontier-capability-survey ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:blockchain ],
        ngm:infra-software-engineering ;
    skos:broader ngm:infra-software-engineering ;
    vc:enables ngm:adoption-of-convergent-technologies,
        ngm:convergence ;
    vc:hasMaturity ngmi:maturity-emerging ;
