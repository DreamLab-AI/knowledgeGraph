    vc:sourceDomain "artificial-intelligence" .

ngm:mechanism-design a owl:Class ;
    rdfs:label "Mechanism Design"@en ;
    rdfs:comment "Mechanism design, sometimes called reverse game theory, is a field of economics and game theory concerned with constructing the rules, incentive structures, and institutional frameworks of strategic interactions so that self-interested participants collectively produce socially desirable outcomes. Starting from a target social choice function rather than from a given game, the designer works backwards to identify what game structure (the mechanism) would implement that function as an equilibrium for rational agents. Mechanism design underpins auction theory, voting systems, market design, and cryptoeconomic protocol engineering, and has been central to Nobel-Prize-recognised work by Hurwicz, Maskin, and Myerson. Its principles govern token incentive structures, automated market makers, governance protocols, and public-goods funding schemes across decentralised systems."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:game-theory ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:incentive-compatibility ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:information-asymmetry ],
        ngm:game-theory ;
    vc:bridgesTo ngm:cryptoeconomics,
        ngm:multi-agent-systems,
        ngm:reinforcement-learning ;
    vc:contrastsWith ngm:algorithmic-game-theory,
        ngm:behavioral-economics ;
    vc:enables ngm:auction-theory,
        ngm:incentive-alignment,
        ngm:on-chain-governance,
        ngm:tokenomics ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:incentive-compatibility,
        ngm:revelation-principle,
        ngm:social-choice-function,
        ngm:strategy-proofness ;
    vc:implements ngm:dominant-strategy-equilibrium,
        ngm:vickrey-clarke-groves-mechanism ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:market-design,
        ngm:public-goods,
        ngm:token-economics,
        ngm:voting-mechanism ;
    vc:requires ngm:game-theory,
        ngm:information-asymmetry,
        ngm:rational-agent ;
    vc:slug "mechanism-design" ;
    vc:sourceDomain "governance" ;
    vc:uses ngm:bayesian-game,
        ngm:contract-theory,
        ngm:nash-equilibrium .

ngm:payment-system a owl:Class ;
    rdfs:label "Payment System"@en ;
    rdfs:comment "A Payment System is an organised set of instruments, procedures, rules, and interbank funds-transfer networks that enables the exchange of monetary value between buyers and sellers, encompassing both traditional fiat rails (card networks, bank transfers, ACH) and digital-native mechanisms such as blockchain token transfers, smart-contract escrow, and central bank digital currencies. Payment systems define how obligations are cleared and settled — gross or net, in real time or deferred — while satisfying requirements for security, finality, liquidity efficiency, AML/KYC compliance, and cross-border interoperability. Modern payment infrastructure increasingly operates across layers: a base settlement layer (central bank reserves or a public blockchain), a clearing and messaging layer (SWIFT, ISO 20022, or a decentralised protocol), and an application layer (wallets, point-of-sale terminals, or embedded payment APIs) that exposes value exchange to end users and automated agents."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:identity-verification ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:digital-wallet ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:payment-gateway ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptographic-security ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:network-protocol ],
        ngm:financial-infrastructure ;
    vc:bridgesTo ngm:ai-driven-finance,
        ngm:autonomous-agent ;
    vc:contrastsWith ngm:barter-system,
        ngm:central-bank-digital-currency ;
    vc:enables ngm:decentralised-finance,
        ngm:e-commerce,
        ngm:microtransaction ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:clearing-and-settlement,
        ngm:digital-wallet,
        ngm:payment-gateway ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:financial-regulation,
        ngm:fraud-detection,
        ngm:tokenomics ;
    vc:requires ngm:cryptographic-security,
        ngm:identity-verification,
        ngm:network-protocol ;
    vc:slug "payment-system" ;
    vc:sourceDomain "finance" ;
    vc:standardizedBy ngm:iso-20022,
        ngm:pci-dss,
        ngm:swift-network ;
    vc:uses ngm:blockchain-transaction,
        ngm:lightning-network,
        ngm:smart-contract .

ngm:avatar-system a owl:Class ;
    rdfs:label "Avatar System"@en ;
    rdfs:comment "Avatar System is the integrated technical architecture for creating, customizing, animating, and rendering digital representations of users in virtual environments, encompassing character models, animation systems, facial expression rigs, physics simulations, and real-time rendering pipelines."@en ;
