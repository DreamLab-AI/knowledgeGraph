ngm:instruction-tuning a owl:Class ;
    rdfs:label "Instruction Tuning"@en ;
    rdfs:comment "A fine-tuning technique that trains language models to follow natural language instructions by learning from diverse instruction-response pairs. Instruction tuning enables models to generalise to new tasks described through instructions without task-specific training data, bridging raw language modelling and practical assistive behaviour."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:large-language-model ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:supervised-learning ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:fine-tuning ],
        ngm:fine-tuning ;
    vc:bridgesTo ngm:ai-safety,
        ngm:human-computer-interaction ;
    vc:contrastsWith ngm:few-shot-prompting,
        ngm:pretraining ;
    vc:dependsOn ngm:natural-language-processing,
        ngm:pre-trained-language-model ;
    vc:enables ngm:ai-alignment,
        ngm:conversational-ai,
        ngm:generative-ai,
        ngm:zero-shot-learning ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.68"^^xsd:float ;
    vc:relatedTo ngm:direct-preference-optimisation,
        ngm:multi-task-learning,
        ngm:prompt-engineering,
        ngm:rlhf,
        ngm:transfer-learning ;
    vc:requires ngm:fine-tuning,
