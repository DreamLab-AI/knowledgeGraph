    vc:supports ngm:satellite-communication ;
    vc:supports ngm:telecommunications ;
    vc:uses ngm:belief-propagation .
ngm:forward-guidance a owl:Class ;
    rdfs:comment "Forward guidance is a monetary policy communication tool through which a central bank signals its likely future path of interest rates or other policy actions, in order to shape market expectations and financial conditions ahead of actual policy changes. It works by influencing longer-term interest rates and asset prices today, since those prices reflect expectations of future short-term rates. Forward guidance is a core instrument of monetary policy transmission, particularly when policy rates are near their effective lower bound."@en ;
    rdfs:label "Forward Guidance"@en ;
    rdfs:subClassOf ngm:monetary-policy ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:monetary-policy ;
    vc:qualityScore "0.65"^^xsd:float ;
    vc:slug "forward-guidance" ;
    vc:sourceDomain "finance" .
ngm:forward-kinematics a owl:Class ;
    rdfs:comment "The process of determining the position and orientation of a robot's end-effector in Cartesian space given the joint parameters (angles or displacements). It maps from joint space to task space using geometric and trigonometric relationships, producing a unique closed-form solution via sequential homogeneous transformation matrices."@en ;
    rdfs:label "Forward Kinematics"@en ;
    rdfs:subClassOf ngm:kinematics ;
