ngm:ipld a owl:Class ;
    rdfs:comment "IPLD (InterPlanetary Linked Data) is a data model and set of specifications for building content-addressed, hash-linked data structures that interoperate across distributed systems. It defines how to represent linked data as directed acyclic graphs whose edges are content identifiers (CIDs), allowing any hash-linked structure — Git commits, blockchain blocks, IPFS files — to be traversed through a common addressing scheme. IPLD provides the data layer beneath IPFS and Filecoin, decoupling the logical structure of data from the protocol used to store or transport it."@en ;
    rdfs:label "IPLD"@en ;
    rdfs:subClassOf ngm:content-addressing ;
    vc:enables ngm:data-availability ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:ipfs ;
    vc:relatedTo ngm:linked-data ;
    vc:slug "ipld" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:merkle-dag ;
    vc:uses ngm:merkle-tree .
ngm:ipo a skos:Concept ;
    rdfs:label "Ipo"@en .
ngm:ipsec a owl:Class ;
    rdfs:comment "IPsec (Internet Protocol Security) is a suite of protocols that secures IP communications by authenticating and encrypting each packet at the network layer. It provides confidentiality, integrity and origin authentication through the Authentication Header and Encapsulating Security Payload protocols, with keys negotiated via the Internet Key Exchange. IPsec is the foundational technology for site-to-site and remote-access virtual private networks operating transparently beneath application protocols."@en ;
    rdfs:label "Ipsec"@en ;
    rdfs:subClassOf ngm:network-security ;
    rdfs:subClassOf _:r12911 ;
    rdfs:subClassOf _:r12912 ;
    rdfs:subClassOf _:r12913 ;
    rdfs:subClassOf _:r12914 ;
