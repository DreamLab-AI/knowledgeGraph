    dcterms:modified "2026-04-26T13:00:00Z"^^xsd:dateTime ;
    vcw:owlRole "Concept" .

# Self Sovereign Identity
blockchain:SelfSovereignIdentity rdf:type owl:Class ;
    rdfs:label "Self Sovereign Identity"@en ;
    rdfs:comment "Self-sovereign identity (SSI) is an identity management paradigm where individuals hold and control cryptographically verifiable credentials in their own DigitalWallet rather than depending on centralised identity providers, enabling selective disclosure of personal attributes without revealing unnecessary information. Built on DecentralizedIdentifier and VerifiableCredential anchored to BlockchainTechnology or other VerifiableDataRegistry, SSI empowers users with complete privacy and portability whilst meeting regulatory requirements like GDPR and eIDAS2. Implementation via platforms like HyperledgerIndy, the SovrinNetwork, and EU ESSIF initiatives demonstrates practical deployment at governmental and enterprise scales."@en ;
    skos:prefLabel "Self Sovereign Identity"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:blockchain:self-sovereign-identity" ;
    owl:sameAs <urn:visionclaw:concept:blockchain:self-sovereign-identity> ;
    vcw:contentHash "sha256-12-3064504b5c29" ;
    vcw:qualityScore "0.4"^^xsd:decimal ;
    vcw:legacyTermId "BC-0456" ;
    vcw:ontologyStatus "stub-needs-content" ;
    vcw:maturityLevel "draft" ;
    vcw:authorityScore "0.0"^^xsd:decimal ;
    dcterms:identifier "BC-0456" ;
    dcterms:subject "blockchain" ;
    owl:versionInfo "2.0.0" ;
    dcterms:created "2026-04-26T00:00:00Z"^^xsd:dateTime ;
    dcterms:modified "2026-04-26T13:00:00Z"^^xsd:dateTime ;
    vcw:owlRole "Concept" .

# Decentralized Identifiers
blockchain:DecentralizedIdentifiers rdf:type owl:Class ;
    rdfs:label "Decentralized Identifiers"@en ;
    rdfs:comment "A W3C-standardised identifier format enabling globally unique, cryptographically verifiable identities controlled independently by subjects without reliance on centralised authorities or registration intermediaries. Decentralised identifiers underpin Self-Sovereign Identity, Verifiable Credentials, and Digital Identity Wallets by separating identifier syntax from resolution mechanisms across diverse substrates."@en ;
    skos:prefLabel "Decentralized Identifiers"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:blockchain:decentralized-identifiers" ;
    owl:sameAs <urn:visionclaw:concept:blockchain:decentralized-identifiers> ;
    vcw:contentHash "sha256-12-4ffcd763a8e4" ;
    vcw:qualityScore "0.4"^^xsd:decimal ;
    vcw:legacyTermId "BC-0457" ;
    vcw:ontologyStatus "stub-needs-content" ;
    vcw:maturityLevel "draft" ;
    vcw:authorityScore "0.0"^^xsd:decimal ;
    dcterms:identifier "BC-0457" ;
    dcterms:subject "blockchain" ;
    owl:versionInfo "2.0.0" ;
    dcterms:created "2026-04-26T00:00:00Z"^^xsd:dateTime ;
    dcterms:modified "2026-04-26T13:00:00Z"^^xsd:dateTime ;
    vcw:owlRole "Concept" .

blockchain:DecentralizedIdentifiers vcw:bridgesTo blockchain:AIAgentSystem .

blockchain:DecentralizedIdentifiers vcw:bridgesTo blockchain:VirtualEconomy .

# Verifiable Credentials
blockchain:VerifiableCredentials rdf:type owl:Class ;
    rdfs:label "Verifiable Credentials"@en ;
    rdfs:comment "Cryptographically secure, tamper-evident digital credentials enabling privacy-preserving claim verification through W3C standards, Zero-Knowledge Proofs, and Selective Disclosure, allowing holders to prove specific attributes without revealing complete credentials—deployed across 51 countries for COVID-19 vaccination status, professional licences, and educational degrees."@en ;
    skos:prefLabel "Verifiable Credentials"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:blockchain:verifiable-credentials" ;
    owl:sameAs <urn:visionclaw:concept:blockchain:verifiable-credentials> ;
    vcw:contentHash "sha256-12-78660106f6bd" ;
    vcw:qualityScore "0.4"^^xsd:decimal ;
    vcw:legacyTermId "BC-0458" ;
