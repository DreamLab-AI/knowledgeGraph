ngm:fourier-analysis a owl:Class ;
    rdfs:comment "Fourier analysis is the branch of mathematics that decomposes functions or signals into sums of sinusoidal components, representing them in terms of frequency rather than time or space. Its central tool, the Fourier transform, maps a signal to its spectrum, revealing periodicities and enabling operations such as filtering and convolution to be performed efficiently in the frequency domain. It is foundational to signal processing, communications, and many numerical and learning methods."@en ;
    rdfs:label "Fourier Analysis"@en ;
    rdfs:subClassOf ngm:signal-processing ;
    rdfs:subClassOf _:r10723 ;
    rdfs:subClassOf _:r10724 ;
