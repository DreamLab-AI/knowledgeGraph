# URI Canonicaliser
infrastructure:URICanonicaliser rdf:type owl:Class ;
    rdfs:label "URI Canonicaliser"@en ;
    rdfs:comment "The canonical URI minting and resolution engine implementing the VisionClaw Agentic Container urn:visionclaw: grammar (ADR-013, R1–R3 rules) for stable, content-addressed, and scope-bearing identifiers, enabling deterministic roundtrip serialisation and cryptographic verification of agent-emitted artefacts."@en ;
