            owl:someValuesFrom ngm:audio-signal-processing ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:training-data ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:acoustic-model ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gpu-computing ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:feature-extraction ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:connectionist-temporal-classification ],
        ngm:speech-processing ;
    vc:bridgesTo ngm:distributed-collaboration,
        ngm:spatial-audio ;
    vc:contrastsWith ngm:keyword-spotting,
        ngm:text-to-speech ;
    vc:enables ngm:large-language-models,
        ngm:machine-translation,
        ngm:natural-language-processing,
        ngm:real-time-captioning,
        ngm:spoken-language-understanding,
        ngm:voice-interaction ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:acoustic-model,
        ngm:beam-search,
        ngm:connectionist-temporal-classification,
        ngm:feature-extraction,
        ngm:language-model,
        ngm:rnn-transducer ;
    vc:qualityScore "0.89"^^xsd:float ;
    vc:relatedTo ngm:knowledge-distillation,
