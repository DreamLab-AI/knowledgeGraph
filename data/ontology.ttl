    vc:supports ngm:liquidity ;
    vc:uses ngm:centralised-exchange ;
    vc:uses ngm:custodial-wallet ;
    vc:uses ngm:kyc .
ngm:centralised-governance a owl:Class ;
    rdfs:comment "Centralised governance is a model in which decision-making authority over a system, protocol, or organisation is concentrated in a single entity or a small controlling group. In contrast to distributed models, changes, upgrades, and policy are determined by this authority rather than by broad stakeholder consensus, which can deliver faster, more decisive action at the cost of reduced censorship resistance and a single point of control. It is the conventional baseline against which decentralised governance defines itself."@en ;
    rdfs:label "Centralised Governance"@en ;
    rdfs:subClassOf ngm:governance-framework ;
    rdfs:subClassOf _:r4129 ;
    vc:contrastsWith ngm:dao ;
    vc:contrastsWith ngm:decentralisation ;
    vc:contrastsWith ngm:decentralised-governance ;
    vc:enables ngm:audit ;
