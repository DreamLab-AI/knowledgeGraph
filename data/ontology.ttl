ngm:conversion-pipeline a owl:Class ;
    rdfs:label "Conversion Pipeline"@en ;
    rdfs:comment "An automated workflow process that transforms digital data or assets from one format, schema, or representation to another, enabling interoperability and compatibility across heterogeneous systems and platforms."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:asset-metadata ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:format-parser ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-schema ],
        ngm:data-processing,
        ngm:sc-standards-and-interop ;
    skos:broader ngm:sc-standards-and-interop ;
    vc:enables ngm:asset-optimization,
        ngm:cross-platform-interoperability,
        ngm:data-harmonization,
        ngm:format-migration ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:error-handler,
        ngm:format-parser,
        ngm:output-generator,
        ngm:transformation-engine,
        ngm:validation-module ;
    vc:isPartOf ngm:asset-pipeline,
        ngm:data-processing ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:asset-metadata,
        ngm:conversion-rules,
        ngm:data-schema,
        ngm:format-specification ;
    vc:slug "conversion-pipeline" ;
    vc:sourceDomain "spatial-computing" .

