vf:distributed-computing a owl:Class ;
    rdfs:label "Distributed Computing"@en ;
    rdfs:comment "Distributed Computing is a computational paradigm in which networked autonomous nodes (processes, machines, datacentres or geographic regions) coordinate through message passing over partially synchronous networks to solve problems no single node can solve alone or to scale capacity beyond a single machine's limits, formalised through foundational theory (Lamport's happens-before relation and logical clocks 1978 establishing partial order over distributed events, Fidge 1988 and Mattern 1989 vector clocks capturing concurrent causality with O(n)-component timestamps, Lamport Shostak Pease Byzantine generals 1982 proving 3f+1 nodes required to tolerate f arbitrary faults, FLP impossibility Fischer Lynch Paterson 1985 proving deterministic consensus impossible in pure asynchrony with a single crash, CAP Brewer 2000 conjecture and Gilbert-Lynch 2002 proof establishing the consistency-availability-partition trilemma, Abadi 2012 PACELC extending CAP with else-latency-consistency tradeoffs during normal operation, the two-generals problem demonstrating impossibility of reliable agreement over lossy channels), implemented through consensus protocols (Paxos Lamport 1998 and Multi-Paxos and "@en ;
    rdfs:subClassOf <urn:visionflow:linked:concurrent-computing>,
        <urn:visionflow:linked:coordination-systems>,
        <urn:visionflow:linked:networked-systems>,
        <urn:visionflow:linked:parallel-computing> ;
    vc:authorityScore "0.87"^^xsd:float ;
    vc:enables <urn:visionflow:linked:distributed-ai-training>,
        <urn:visionflow:linked:elastic-capacity>,
        <urn:visionflow:linked:geographic-distribution>,
        <urn:visionflow:linked:high-availability>,
        <urn:visionflow:linked:horizontal-scalability>,
        vf:fault-tolerance ;
    vc:hasPart <urn:visionflow:linked:coordination-service>,
        <urn:visionflow:linked:distributed-lock>,
        <urn:visionflow:linked:leader-election>,
        <urn:visionflow:linked:logical-clock>,
        <urn:visionflow:linked:message-queue>,
        <urn:visionflow:linked:replication-mechanism>,
        vf:consensus-protocol,
        vf:gossip-protocol ;
    vc:implements <urn:visionflow:linked:actor-model>,
        <urn:visionflow:linked:bulk-synchronous-parallel>,
        <urn:visionflow:linked:map-reduce>,
        <urn:visionflow:linked:paxos>,
        <urn:visionflow:linked:pbft>,
        <urn:visionflow:linked:raft>,
        <urn:visionflow:linked:saga-pattern>,
        <urn:visionflow:linked:two-phase-commit>,
        vf:crdt ;
    vc:maturity "production-ready" ;
    vc:qualityScore "0.52"^^xsd:float ;
    vc:requires <urn:visionflow:linked:identity-and-naming>,
        <urn:visionflow:linked:message-passing>,
        <urn:visionflow:linked:network-communication>,
        <urn:visionflow:linked:partial-failure-tolerance>,
        <urn:visionflow:linked:serialisation-format>,
        <urn:visionflow:linked:time-synchronisation> ;
    vc:slug "distributed-computing" ;
    vc:sourceDomain "infrastructure" .

vf:motion-planning a owl:Class ;
    rdfs:label "Motion Planning"@en ;
    rdfs:comment "Motion Planning extends path planning by incorporating robot dynamics, control constraints, and time-parametrisation to generate dynamically feasible trajectories that account for velocity, acceleration, jerk, and actuator limitations. Motion planning produces executable control sequences that guide robots and autonomous vehicles from initial to goal states whilst satisfying kinodynamic constraints and optimising performance metrics."@en ;
    rdfs:subClassOf vf:robotics ;
    vc:authorityScore "0.0"^^xsd:float ;
    vc:maturity "draft" ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:slug "motion-planning" ;
    vc:sourceDomain "robotics" .

vf:regulatory-framework a owl:Class ;
    rdfs:label "Regulatory Framework"@en ;
    rdfs:comment "A regulatory framework for blockchain and cryptoassets comprises the laws, regulations, guidelines, and supervisory structures established by governmental authorities to govern the issuance, trading, and custody of digital assets. These frameworks address consumer protection, market integrity, anti-money laundering (AML) compliance, and financial stability whilst balancing innovation enablement with risk mitigation."@en ;
    rdfs:subClassOf vf:legal-framework ;
    vc:authorityScore "0.0"^^xsd:float ;
    vc:enables <urn:visionflow:linked:market-integrity> ;
    vc:maturity "reviewed" ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:slug "regulatory-framework" ;
    vc:sourceDomain "infrastructure" .

vf:token-standard a owl:Class ;
    rdfs:label "Token Standard"@en ;
    rdfs:comment "Technical specification defining rules, interfaces, and functions that smart contract tokens must implement to ensure interoperability within a blockchain ecosystem. Standards like ERC-20 (fungible tokens) and ERC-721 (NFTs) establish common APIs for token transfers, balance queries, approvals, and metadata, enabling seamless integration across wallets, exchanges, and dApps."@en ;
    rdfs:subClassOf vf:blockchain ;
    vc:authorityScore "0.0"^^xsd:float ;
    vc:enables vf:smart-contract ;
    vc:implements <urn:visionflow:linked:fungibility> ;
    vc:maturity "reviewed" ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:slug "token-standard" ;
    vc:sourceDomain "blockchain" .

vf:access-control-system a owl:Class ;
    rdfs:label "Access Control System"@en ;
    rdfs:comment "An [[Access Control System]] is the assemblage of policies, decision engines, enforcement points, identity providers, attribute sources, audit pipelines, and cryptographic primitives that determines whether a subject (human user, service account, autonomous agent, device) is permitted to perform a requested operation (read, write, execute, delegate, administer) against a protected resource (file, record, API endpoint, kernel object, physical door, network flow), evaluated through a formal authorisation model spanning Discretionary Access Control (DAC, owner-driven ACLs as in POSIX/NTFS), Mandatory Access Control (MAC, lattice-based confidentiality enforced by [[Bell-LaPadula Model]] no-read-up/no-write-down, integrity by [[Biba Model]] no-read-down/no-write-up, conflict-of-interest by [[Brewer-Nash Model]] Chinese Wall, transaction integrity by [[Clark-Wilson Model]] well-formed transactions and separation of duty), Role-Based Access Control (RBAC, ANSI INCITS 359-2012 four-level RBAC0-RBAC3 with role hierarchies, constraints, sessions, deployed in 78%+ enterprise IAM stacks via Active Directory security groups, Okta groups, AWS IAM roles), Attribute-Based Access Control (ABAC, NIS"@en ;
    rdfs:subClassOf <urn:visionflow:linked:authorisation-mechanism>,
        <urn:visionflow:linked:governance-control>,
        <urn:visionflow:linked:information-security-system>,
        <urn:visionflow:linked:security-control> ;
    vc:authorityScore "0.87"^^xsd:float ;
    vc:enables <urn:visionflow:linked:auditability>,
        <urn:visionflow:linked:least-privilege>,
        <urn:visionflow:linked:separation-of-duties>,
        vf:accountability,
        vf:distributed-system,
        vf:quality-assurance,
        vf:regulatory-compliance,
        vf:risk-assessment ;
    vc:hasPart <urn:visionflow:linked:attribute-evaluation>,
        <urn:visionflow:linked:audit-log>,
        <urn:visionflow:linked:identity-store>,
        <urn:visionflow:linked:policy-administration-point>,
        <urn:visionflow:linked:policy-decision-point>,
        <urn:visionflow:linked:policy-enforcement-point>,
        <urn:visionflow:linked:policy-information-point>,
        <urn:visionflow:linked:session-manager>,
        <urn:visionflow:linked:token-service>,
        vf:policy-engine ;
    vc:implements <urn:visionflow:linked:abac>,
        <urn:visionflow:linked:capability-based-security>,
        <urn:visionflow:linked:dac>,
        <urn:visionflow:linked:mac>,
        <urn:visionflow:linked:pbac>,
        <urn:visionflow:linked:rbac>,
        <urn:visionflow:linked:re-bac> ;
    vc:maturity "production-ready" ;
    vc:qualityScore "0.52"^^xsd:float ;
    vc:requires <urn:visionflow:linked:authentication>,
        <urn:visionflow:linked:cryptographic-primitives>,
        <urn:visionflow:linked:trusted-time-source>,
        vf:api-gateway,
        vf:identity-provider,
        vf:metadata-management ;
    vc:slug "access-control-system" ;
    vc:sourceDomain "security" .

vf:aml-kyc-compliance a owl:Class ;
    rdfs:label "AML KYC Compliance"@en ;
    rdfs:comment "**AML KYC Compliance** is the composite regulatory and operational discipline by which obligated entities — banks, payment institutions, e-money issuers, brokers, insurers, accountants, lawyers, art dealers, casinos, real-estate agents, virtual-asset service providers (VASPs / crypto-asset service providers CASPs) and an expanding perimeter of \"gatekeepers\" — implement statutory **Anti-Money Laundering** (AML), **Countering the Financing of Terrorism** (CFT), **Counter-Proliferation Financing** (CPF) and **Know Your Customer** (KYC) controls to identify their customers and ultimate beneficial owners, assess and risk-rate the relationship, monitor transactional behaviour continuously, screen against sanctions and politically-exposed-person (PEP) lists, file suspicious activity / transaction reports (SARs / STRs) with national Financial Intelligence Units (FIUs), and preserve auditable records for a minimum of five years; the regime descends institutionally from the **Bank Secrecy Act 1970** (US Public Law 91-508 establishing Currency Transaction Reports CTRs above $10,000 and the predecessor to FinCEN), the **Financial Action Task Force** (FATF, established at the 1989 G7 Arche Summ"@en ;
    rdfs:subClassOf <urn:visionflow:linked:anti-financial-crime-regime>,
        <urn:visionflow:linked:customer-onboarding-discipline>,
        <urn:visionflow:linked:financial-crime-compliance>,
        <urn:visionflow:linked:risk-management-framework>,
        vf:regulatory-compliance ;
    vc:authorityScore "0.87"^^xsd:float ;
    vc:enables <urn:visionflow:linked:banking-correspondent-relationships>,
        <urn:visionflow:linked:cross-border-payment-compliance>,
        <urn:visionflow:linked:financial-system-integrity>,
        <urn:visionflow:linked:proceeds-of-crime-recovery>,
        <urn:visionflow:linked:sanctions-enforcement>,
        <urn:visionflow:linked:tax-evasion-detection>,
        <urn:visionflow:linked:terrorist-financing-disruption>,
        <urn:visionflow:linked:vasp-market-access> ;
    vc:hasPart <urn:visionflow:linked:adverse-media-screening>,
        <urn:visionflow:linked:beneficial-ownership-disclosure>,
        <urn:visionflow:linked:customer-due-diligence>,
        <urn:visionflow:linked:customer-identification-programme>,
        <urn:visionflow:linked:enhanced-due-diligence>,
        <urn:visionflow:linked:pep-screening>,
        <urn:visionflow:linked:record-keeping>,
        <urn:visionflow:linked:sanctions-screening>,
        <urn:visionflow:linked:simplified-due-diligence>,
        <urn:visionflow:linked:source-of-funds-verification>,
        <urn:visionflow:linked:source-of-wealth-verification>,
        <urn:visionflow:linked:suspicious-activity-report>,
        <urn:visionflow:linked:transaction-monitoring>,
        <urn:visionflow:linked:travel-rule-compliance> ;
    vc:implements <urn:visionflow:linked:bank-secrecy-act>,
        <urn:visionflow:linked:eu-amlr-single-rulebook>,
        <urn:visionflow:linked:fatf-40-recommendations>,
        <urn:visionflow:linked:fatf-travel-rule>,
        <urn:visionflow:linked:proceeds-of-crime-act-2002>,
        <urn:visionflow:linked:risk-based-approach-methodology>,
        <urn:visionflow:linked:sanctions-and-anti-money-laundering-act-2018>,
        <urn:visionflow:linked:uk-mlr-2017> ;
    vc:maturity "production-ready" ;
    vc:qualityScore "0.52"^^xsd:float ;
    vc:requires <urn:visionflow:linked:board-level-oversight>,
        <urn:visionflow:linked:compliance-officer>,
        <urn:visionflow:linked:customer-identification-documentation>,
        <urn:visionflow:linked:fiu-reporting-channel>,
        <urn:visionflow:linked:independent-audit-function>,
        <urn:visionflow:linked:risk-based-approach>,
        <urn:visionflow:linked:sanctions-list-feed>,
        <urn:visionflow:linked:staff-training-programme> ;
    vc:slug "aml-kyc-compliance" ;
    vc:sourceDomain "blockchain" .

vf:attention a owl:Class ;
    rdfs:label "Attention"@en ;
    rdfs:comment "**Attention** is a differentiable content-based addressing mechanism for neural networks that computes a weighted combination of value vectors according to learned compatibility scores between a query vector and a set of key vectors, formalised in its most influential form as Scaled Dot-Product Attention (Vaswani et al. 2017) by the closed-form operator Attention(Q, K, V) = softmax(QK^T / √d_k) V where Q ∈ ℝ^{n×d_k} is a matrix of n query vectors, K ∈ ℝ^{m×d_k} is a matrix of m key vectors, V ∈ ℝ^{m×d_v} is the matching matrix of value vectors, d_k is the key dimensionality and the √d_k denominator prevents the softmax from saturating into one-hot regimes at high d_k where unscaled dot products acquire variance d_k and drive gradient collapse, originating in the additive (Bahdanau-style) formulation of Bahdanau, Cho & Bengio (ICLR 2015) \"Neural Machine Translation by Jointly Learning to Align and Translate\" which broke the fixed-vector bottleneck of Sutskever-Vinyals-Le (NeurIPS 2014) encoder-decoder seq2seq by allowing each decoder step to softly align over all encoder hidden states via score(s, h) = v^T tanh(W_s s + W_h h), refined into the simpler multiplicative (Luong) variant "@en ;
    rdfs:subClassOf <urn:visionflow:linked:differentiable-memory>,
        <urn:visionflow:linked:neural-network-mechanism>,
        <urn:visionflow:linked:representation-learning>,
        <urn:visionflow:linked:sequence-model> ;
    vc:authorityScore "0.87"^^xsd:float ;
    vc:enables <urn:visionflow:linked:cross-modal-conditioning>,
        <urn:visionflow:linked:in-context-learning>,
        <urn:visionflow:linked:large-language-model>,
        <urn:visionflow:linked:long-context-window>,
        <urn:visionflow:linked:neural-machine-translation>,
        <urn:visionflow:linked:vision-transformer>,
        vf:transformer ;
    vc:hasPart <urn:visionflow:linked:attention-score>,
        <urn:visionflow:linked:key>,
        <urn:visionflow:linked:query>,
        <urn:visionflow:linked:softmax>,
        vf:attention-head,
        vf:attention-weight,
        vf:positional-encoding,
        vf:value ;
    vc:implements <urn:visionflow:linked:content-based-addressing>,
        <urn:visionflow:linked:differentiable-lookup>,
        <urn:visionflow:linked:permutation-equivariance>,
        <urn:visionflow:linked:soft-alignment>,
        <urn:visionflow:linked:weighted-aggregation> ;
    vc:maturity "production-ready" ;
    vc:qualityScore "0.52"^^xsd:float ;
    vc:requires <urn:visionflow:linked:differentiable-architecture>,
        <urn:visionflow:linked:embedding>,
        <urn:visionflow:linked:gpu-compute>,
        <urn:visionflow:linked:linear-projection>,
        <urn:visionflow:linked:matrix-multiplication>,
        vf:backpropagation ;
    vc:slug "attention" ;
    vc:sourceDomain "artificial-intelligence" .

