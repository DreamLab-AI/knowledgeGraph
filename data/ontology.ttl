ngm:uniswap a owl:Class ;
    rdfs:label "Uniswap"@en ;
    rdfs:comment "Uniswap is a decentralised exchange (DEX) protocol deployed on Ethereum that enables permissionless, non-custodial token swaps through an Automated Market Maker (AMM) mechanism. Rather than maintaining an order book, it uses liquidity pools governed by the constant-product invariant (x × y = k), where liquidity providers deposit token pairs and earn fees proportional to their pool share. Successive protocol versions have introduced concentrated liquidity (v3) and multi-hop routing, making Uniswap a foundational primitive of decentralised finance."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:liquidity-pool ],
        ngm:bc-defi-and-economics ;
    skos:broader ngm:bc-defi-and-economics ;
    vc:dependsOn ngm:token-economics ;
    vc:enables ngm:decentralised-finance,
        ngm:yield-farming ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:liquidity-pool ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:slug "uniswap" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:automated-market-maker,
        ngm:smart-contract .

ngm:unsupervised-learning a owl:Class ;
    rdfs:label "Unsupervised Learning"@en ;
    rdfs:comment "Unsupervised Learning discovers hidden patterns, structures, and representations in unlabeled data without explicit supervision. Key techniques include clustering, dimensionality reduction, density estimation, anomaly detection, and generative modelling, enabling exploratory data analysis and latent feature extraction."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
