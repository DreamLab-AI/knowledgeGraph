        ngm:transaction-finality,
        ngm:validator-node ;
    vc:slug "proof-of-history" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:blockchain-transaction .

ngm:proof-of-stake-sustainability a owl:Class ;
    rdfs:label "Proof Of Stake Sustainability"@en ;
    rdfs:comment "Proof of Stake Sustainability refers to the environmental, economic, and governance characteristics of Proof of Stake consensus mechanisms that make them a viable long-term alternative to energy-intensive Proof of Work systems."@en ;
