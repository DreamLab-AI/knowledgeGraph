ngm:legged-locomotion a owl:Class ;
    rdfs:label "Legged Locomotion"@en ;
    rdfs:comment "Legged locomotion is the study and engineering of motion through articulated limb contacts with the environment, enabling traversal of unstructured, discontinuous, and vertically challenging terrain inaccessible to wheeled or tracked platforms. It requires coordinated management of contact scheduling, ground reaction forces, centre-of-mass dynamics, gait sequencing, and reactive balance control across walking, running, climbing, jumping, and stair-negotiation tasks. Modern legged locomotion controllers integrate whole-body control (WBC), model predictive control (MPC), and reinforcement learning — frequently trained in simulation with domain randomisation and transferred to hardware — to achieve robust performance on irregular natural and urban terrain. The field draws on classical rigid-body mechanics, optimisation theory, machine learning, and biomechanics to produce systems that rival biological locomotion efficiency and versatility."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:robot-dynamics ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:state-estimation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:motion-control ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:rigid-body-dynamics ],
        ngm:robo-navigation-and-planning ;
    skos:broader ngm:robo-navigation-and-planning ;
    vc:bridgesTo ngm:digital-twin,
        ngm:robot-simulation ;
    vc:contrastsWith ngm:aerial-robotics,
        ngm:wheeled-locomotion ;
    vc:enables ngm:autonomous-navigation,
        ngm:motion-planning,
        ngm:search-and-rescue-robotics,
        ngm:terrain-traversal ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:balance-control,
        ngm:foothold-selection,
        ngm:gait-planning,
        ngm:swing-leg-control ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:biomechanics,
        ngm:bipedal-robot,
        ngm:quadruped-robot,
        ngm:reinforcement-learning,
        ngm:sim-to-real-transfer,
        ngm:zero-moment-point ;
    vc:requires ngm:contact-mechanics,
        ngm:motion-control,
        ngm:rigid-body-dynamics,
        ngm:robot-dynamics,
        ngm:state-estimation ;
    vc:slug "legged-locomotion" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:inertial-measurement-unit,
        ngm:lidar,
        ngm:model-predictive-control,
        ngm:quadratic-programming,
        ngm:whole-body-control .

ngm:markov-chain-monte-carlo a owl:Class ;
    rdfs:label "Markov Chain Monte Carlo"@en ;
    rdfs:comment "Markov Chain Monte Carlo (MCMC) is a family of computational algorithms that generate samples from an arbitrary target probability distribution by constructing a Markov chain whose stationary distribution equals the target, enabling tractable approximate Bayesian inference and numerical integration over high-dimensional parameter spaces that are intractable by exact analytical methods. Foundational algorithms include Metropolis-Hastings, Gibbs sampling, Hamiltonian Monte Carlo (HMC), and the No-U-Turn Sampler (NUTS). MCMC is the standard tool for posterior inference in probabilistic programming and Bayesian statistical modelling across science, engineering, and machine learning."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:probability-theory ],
        ngm:monte-carlo-methods ;
    vc:bridgesTo ngm:computational-biology,
        ngm:statistical-physics ;
    vc:contrastsWith ngm:normalising-flows,
        ngm:sequential-monte-carlo,
        ngm:variational-inference ;
    vc:enables ngm:bayesian-inference,
        ngm:posterior-inference,
        ngm:probabilistic-programming,
        ngm:uncertainty-quantification ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:implements ngm:gibbs-sampling,
        ngm:metropolis-hastings,
        ngm:no-u-turn-sampler ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:bayesian-neural-network,
        ngm:convergence-diagnostics,
        ngm:gaussian-process,
        ngm:probabilistic-model ;
    vc:requires ngm:detailed-balance,
        ngm:ergodicity,
        ngm:probability-theory ;
    vc:slug "markov-chain-monte-carlo" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:gradient-descent,
        ngm:hamiltonian-dynamics,
        ngm:markov-chain,
        ngm:sampling .

ngm:metadata-standards a owl:Class ;
