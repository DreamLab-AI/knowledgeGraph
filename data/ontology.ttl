        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:sensor-data ],
        ngm:immersive-experience-pipeline,
        ngm:sc-interaction ;
    skos:broader ngm:sc-interaction ;
