blockchain:SovereignMesh rdf:type owl:Class ;
    rdfs:label "Sovereign Mesh"@en ;
    rdfs:comment "A peer-to-peer agent network where each node is identified by a DID Nostr Identity DIDs and communicates via Nostr Relay, enabling decentralised agent discovery, gossip, and work distribution without a centralised broker or coordinator, whilst respecting each agent's sovereignty over its own keys and credentials."@en ;
