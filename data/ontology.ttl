ngm:elements-project a owl:Class ;
    rdfs:comment "The Elements Project is an open-source blockchain platform, derived from Bitcoin Core, that serves as a testbed and reference implementation for advanced features such as confidential transactions, asset issuance, and federated sidechains. Maintained primarily by Blockstream, it provides the codebase underpinning the Liquid Network and allows developers to experiment with extensions that may later be proposed for Bitcoin itself. It packages cryptographic enhancements like confidential assets and amounts into a deployable, Bitcoin-compatible client."@en ;
    rdfs:label "Elements Project"@en ;
    rdfs:subClassOf ngm:open-source-software ;
