    vc:slug "model-compression" ;
    vc:sourceDomain "machine-learning" ;
    vc:supports ngm:inference,
        ngm:model-deployment ;
    vc:uses ngm:low-rank-adaptation,
        ngm:tensor .

ngm:model-registry a owl:Class ;
    rdfs:label "Model Registry"@en ;
    rdfs:comment "A model registry is a system for cataloguing trained machine learning models with their versions, metadata and lifecycle stage. It provides a central record that links a model to its training data, metrics and deployment status, supporting governance, reproducibility and controlled promotion across staging environments."@en ;
