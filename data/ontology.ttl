ngm:quantum-network-node a owl:Class ;
    rdfs:label "Quantum Network Node"@en ;
    rdfs:comment "Physical device utilizing quantum mechanics principles to enable quantum key distribution (QKD) or entanglement transmission for ultra-secure communication channels."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
