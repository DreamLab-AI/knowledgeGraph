        ngm:real-time-data-streaming,
        ngm:server-push,
        ngm:token-streaming ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:event-driven-architecture,
        ngm:publish-subscribe-pattern ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:api-gateway,
        ngm:chunked-transfer-encoding,
        ngm:reverse-proxy,
        ngm:streaming-protocol ;
    vc:requires ngm:http,
        ngm:persistent-connection ;
    vc:slug "server-sent-events" ;
    vc:sourceDomain "infrastructure" ;
    vc:standardizedBy ngm:w3c,
        ngm:whatwg ;
    vc:supports ngm:llm-inference-api,
        ngm:model-context-protocol,
        ngm:real-time-dashboard ;
    vc:uses ngm:eventsource-api,
        ngm:http2,
        ngm:text-event-stream .

