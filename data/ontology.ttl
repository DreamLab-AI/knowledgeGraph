    vc:slug "incentive-structures" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:economics .
ngm:inception-score a skos:Concept ;
    rdfs:label "Inception Score"@en .
ngm:inception-v3 a owl:Class ;
    rdfs:comment "Inception v3 is a convolutional neural network architecture from Google that refined the earlier Inception design with factorised convolutions, auxiliary classifiers, and label smoothing to improve accuracy and reduce computational cost on image classification tasks. It replaces large convolutional filters with sequences of smaller asymmetric convolutions, cutting parameter count while preserving representational capacity. Pretrained on ImageNet, its penultimate-layer activations are the standard feature extractor used to compute the Fréchet Inception Distance and Inception Score for evaluating generative image models. It remains a common baseline and building block in computer vision pipelines despite the emergence of newer architectures."@en ;
    rdfs:label "Inception v3"@en ;
    rdfs:subClassOf ngm:convolutional-neural-network ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:slug "inception-v3" ;
    vc:sourceDomain "artificial-intelligence" .
