    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:large-language-models,
        ngm:retrieval-augmented-generation .

ngm:resilience-metric a owl:Class ;
    rdfs:label "Resilience Metric"@en ;
    rdfs:comment "Resilience metrics are quantitative and qualitative measurements that assess the robustness, fault tolerance, and recovery capabilities of digital and physical infrastructure. Core indicators include availability percentage, Recovery Time Objective (RTO), Recovery Point Objective (RPO), Mean Time Between Failures (MTBF), and Mean Time to Repair (MTTR). Effective resilience measurement combines real-time monitoring, predictive analytics, and automated remediation to maintain service quality under adverse conditions and verify SLA compliance."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cloud-infrastructure ],
        ngm:distributed-systems,
        ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:enables ngm:computing-infrastructure ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.4"^^xsd:float ;
    vc:relatedTo ngm:fault-tolerance,
        ngm:reliability ;
    vc:requires ngm:cloud-infrastructure ;
    vc:slug "resilience-metric" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:anomaly-detection,
        ngm:compliance-monitoring .

ngm:response-time-prediction a owl:Class ;
    rdfs:label "Response Time Prediction"@en ;
    rdfs:comment "Response Time Prediction applies statistical and machine learning models to forecast the end-to-end latency of requests in networked systems, enabling proactive quality-of-service management and resource scheduling. Inputs typically include historical latency distributions, network conditions, server load, and request characteristics; outputs drive adaptive scheduling, pre-emptive caching, and SLA alerting. Accurate prediction is critical for latency-sensitive applications such as real-time XR streaming, interactive robotics teleoperation, and cloud-gaming platforms."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:latency ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:network-latency ],
        ngm:infra-computing-and-cloud ;
    skos:broader ngm:infra-computing-and-cloud ;
    vc:enables ngm:edge-computing,
        ngm:latency-aware-edge-ai ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:latency,
        ngm:network-latency ;
    vc:slug "response-time-prediction" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:anomaly-detection,
        ngm:machine-learning .

ngm:revision-list a owl:Class ;
    rdfs:label "Revision List"@en ;
    rdfs:comment "A Revision List is a curated, task-tracked syllabus of technologies, frameworks, and concepts that a practitioner aims to learn or revisit, typically structured as a prioritised backlog with completion states. In a data science and AI context, such a list spans programming languages, ML frameworks, cloud platforms, DevOps tooling, and conceptual foundations such as deep learning, NLP, and reinforcement learning. It functions as a personal knowledge-gap audit and learning roadmap."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:machine-learning ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:deep-learning ],
        ngm:infra-software-engineering ;
    skos:broader ngm:infra-software-engineering ;
    vc:enables ngm:knowledge-management ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:deep-learning,
        ngm:machine-learning ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:relatedTo ngm:machine-learning-pipeline,
        ngm:python-and-py-torch ;
    vc:slug "revision-list" ;
    vc:sourceDomain "infrastructure" .

ngm:risk-treatment a owl:Class ;
    rdfs:label "Risk Treatment"@en ;
    rdfs:comment "The process of selecting and implementing measures to modify AI risk, including risk avoidance, risk reduction (mitigation), risk sharing (transfer), and risk retention, based on risk assessment outcomes and organisational risk appetite. Grounded in ISO/IEC 23894:2023 and the NIST AI RMF MANAGE function, risk treatment produces a treatment plan, residual risk documentation, and an ongoing monitoring regime. Options are evaluated for feasibility, cost, effectiveness, and stakeholder acceptability before selection."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ai-risk ],
        ngm:ai-governance-and-ethics ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:enables ngm:ai-governance,
        ngm:compliance-framework ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:ai-risk-management ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:relatedTo ngm:ai-governance-framework,
        ngm:responsible-ai-principles ;
    vc:requires ngm:ai-risk ;
    vc:slug "risk-treatment" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:robin-hanson a owl:Class ;
    rdfs:label "Robin Hanson"@en ;
    rdfs:comment "Robin Hanson is an economist, futurist, and author (George Mason University) known for contrarian analysis of AI progress timelines, the economics of prediction markets, and his book Age of Em which models a future dominated by brain emulations. He maintains a measured scepticism about near-term AGI, arguing that inertia, demographic decline, and adoption barriers make transformative AI further off than mainstream discourse suggests. His blog Overcoming Bias applies economic and evolutionary reasoning to cognition, signalling, and technology adoption."@en ;
    rdfs:subClassOf ngm:infra-software-engineering ;
    skos:broader ngm:infra-software-engineering ;
    vc:contrastsWith ngm:history-and-path-to-agi ;
    vc:enables ngm:trustworthy-ai ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:relatedTo ngm:artificial-general-intelligence,
        ngm:economics ;
    vc:slug "robin-hanson" ;
    vc:sourceDomain "infrastructure" .

ngm:roc-curve a owl:Class ;
    rdfs:label "ROC Curve"@en ;
    rdfs:comment "A graphical performance etool for binary classification models that plots the True Positive Rate (Recall/Sensitivity) against the False Positive Rate across all possible classification thresholds, visualising the trade-off between correctly identifying positive instances and incorrectly classifyi..."@en ;
    rdfs:subClassOf ngm:ai-technique,
        ngm:model-performance ;
    skos:broader ngm:ai-technique ;
    vc:enables ngm:model-comparison,
        ngm:threshold-selection ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:slug "roc-curve" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:role-reorg a owl:Class ;
    rdfs:label "Role reorg"@en ;
    rdfs:comment "Role reorg denotes an organisational restructuring process in which employment or contractual arrangements are renegotiated, typically comparing permanent employment contracts with temporary or agency-based assignments across dimensions such as salary, holiday entitlement, pension eligibility, notice periods, and additional benefits. Such analysis underpins workforce planning decisions in academic and research institutions, balancing income stability against contractual flexibility and total compensation."@en ;
    rdfs:subClassOf ngm:infra-software-engineering ;
    skos:broader ngm:infra-software-engineering ;
    vc:contrastsWith ngm:civil-service-job ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:relatedTo ngm:augmented-connected-workforce,
        ngm:economics ;
    vc:slug "role-reorg" ;
    vc:sourceDomain "infrastructure" .

ngm:ru-v-agents a owl:Class ;
    rdfs:label "RuV Agents"@en ;
    rdfs:comment "RuV Agents refers to the ruv-swarm agent framework developed within the ruv-FANN project, providing a multi-agent orchestration layer for coordinating LLM-backed autonomous agents across tasks such as coding, research, and data processing. The framework integrates with inference APIs and supports rate-limit bypass strategies through unified LLM platform routing. It represents a practical implementation of multi-agent coordination patterns for software engineering and knowledge-work automation."@en ;
    rdfs:subClassOf ngm:infra-computing-and-cloud ;
    skos:broader ngm:infra-computing-and-cloud ;
    vc:enables ngm:ai-agents,
        ngm:autonomous-ai-agents ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:relatedTo ngm:agent-frameworks,
        ngm:vector-database ;
    vc:slug "ru-v-agents" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:large-language-models,
        ngm:multi-agent-systems .

ngm:runes-and-glyphs a owl:Class ;
    rdfs:label "Runes and Glyphs"@en ;
    rdfs:comment "Runes and Glyphs refers to two complementary Bitcoin token protocols: Runes, which encodes fungible token balances directly in Bitcoin transaction outputs using OP_RETURN data, and Glyphs, a related protocol developed by Melvin Carvalho that encodes token metadata as on-chain inscriptions compatible with the Ordinals framework. Together they extend Bitcoin's base layer with native fungible asset issuance without requiring a separate blockchain, enabling DAOs, project tokens, and programmable digital objects on Bitcoin testnet and mainnet."@en ;
    rdfs:subClassOf ngm:infra-software-engineering ;
    skos:broader ngm:infra-software-engineering ;
    vc:enables ngm:asset-tokenization,
        ngm:digital-asset ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:blockchain ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:relatedTo ngm:decentralised-autonomous-organisation ;
    vc:slug "runes-and-glyphs" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:digital-objects,
        ngm:nft .

ngm:safety-vulnerability a owl:Class ;
    rdfs:label "Safety Vulnerability"@en ;
    rdfs:comment "A Safety Vulnerability is an identified weakness or flaw in an AI system's design, training data, architecture, or deployment context that could be exploited to cause harmful, unintended, or unsafe behaviours—including adversarial attacks, data poisoning, prompt injection, or misalignment failures. Safety vulnerabilities are distinct from conventional software security vulnerabilities in that they may arise from statistical properties of learned models rather than explicit coding errors, making them harder to enumerate exhaustively and more sensitive to distribution shift. Systematic identification requires red-teaming, adversarial testing, and formal verification where feasible."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:red-teaming ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:prompt-injection ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:adversarial-testing ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:data-poisoning ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:jailbreaking ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:adversarial-attack ],
        ngm:ai-governance-and-ethics ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:enables ngm:model-robustness ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:adversarial-attack,
        ngm:data-poisoning,
        ngm:jailbreaking,
        ngm:prompt-injection ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:adversarial-attacks,
        ngm:ai-risk,
        ngm:ai-safety,
        ngm:vulnerability ;
    vc:requires ngm:adversarial-testing,
        ngm:red-teaming ;
    vc:slug "safety-vulnerability" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:ai-alignment,
        ngm:ai-risk-management .

ngm:search-discovery a owl:Class ;
    rdfs:label "Search Discovery"@en ;
    rdfs:comment "Systems and interfaces that enable users to find relevant content, assets, experiences, and other users within metaverse platforms through keyword search, semantic queries, recommendations, and spatial exploration mechanisms."@en ;
    rdfs:subClassOf ngm:information-retrieval,
        ngm:sc-standards-and-interop ;
    skos:broader ngm:sc-standards-and-interop ;
    vc:enables ngm:user-navigation ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:slug "search-discovery" ;
    vc:sourceDomain "spatial-computing" .

ngm:security-audit-guide a owl:Class ;
    rdfs:label "security audit guide"@en ;
    rdfs:comment "A structured procedural document establishing methodologies, checklists, and frameworks for systematically evaluating the security posture of blockchain systems, smart contracts, and cryptographic infrastructure. Security audit guides codify best practices across phases of automated analysis, manual code review, and formal verification, enabling auditors to identify vulnerabilities such as reentrancy, integer overflow, and access control weaknesses before deployment."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:smart-contract ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:formal-verification ],
        ngm:sc-governance-and-safety ;
    skos:broader ngm:sc-governance-and-safety ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:requires ngm:formal-verification,
        ngm:smart-contract ;
    vc:slug "security-audit-guide" ;
    vc:sourceDomain "spatial-computing" ;
    vc:standardizedBy ngm:iso-iec-27001 ;
    vc:supports ngm:blockchain,
        ngm:risk-assessment ;
    vc:uses ngm:audit-trail,
        ngm:cryptography,
        ngm:vulnerability .

ngm:security-technology a owl:Class ;
    rdfs:label "Security Technology"@en ;
    rdfs:comment "Security Technology refers to the hardware, software, and protocol mechanisms deployed to protect systems, data, and communications from unauthorised access, tampering, or disruption. In the blockchain and distributed systems context this encompasses cryptographic primitives, authentication schemes, digital signatures, zero-knowledge proofs, and secure enclaves that collectively enforce integrity, confidentiality, and non-repudiation across decentralised networks."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:digital-signature ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:cryptographic-primitive ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:authentication ],
        ngm:bc-cryptographic-primitive ;
    skos:broader ngm:bc-cryptographic-primitive ;
    vc:enables ngm:cryptographic-security,
        ngm:cybersecurity ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:authentication,
        ngm:cryptographic-primitive,
        ngm:digital-signature ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:slug "security-technology" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:blockchain .

ngm:semantic-metadata-registry a owl:Class ;
    rdfs:label "Semantic Metadata Registry"@en ;
    rdfs:comment "A centralized catalog managing structured metadata schemas, controlled vocabularies, and semantic relationships to enable consistent asset description, cross-platform interoperability, and intelligent discovery."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:controlled-vocabularies ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:vocabulary-services ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:metadata-schema ],
        ngm:infra-data-management,
        ngm:metadata-registry ;
