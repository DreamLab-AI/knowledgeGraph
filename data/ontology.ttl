        ngm:code-generation,
        ngm:software-development ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.9"^^xsd:float ;
    vc:requires ngm:large-language-models,
        ngm:retrieval-augmented-generation,
        ngm:transformer-architecture ;
    vc:slug "cursor" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:claude-sonnet,
        ngm:gpt-4o,
        ngm:model-context-protocol,
        ngm:natural-language-processing .

