    vc:uses ngm:neural-radiance-field ;
    vc:uses ngm:neural-rendering .
ngm:tele-053-volumetric-video-conferencing a owl:Class ;
    rdfs:comment "Volumetric video conferencing is real-time meeting communication in which participants are captured as three-dimensional representations and rendered so others can view them from arbitrary angles."@en ;
