ngm:3-d-gaussian-splatting a owl:Class ;
    rdfs:label "3D Gaussian Splatting"@en ;
    rdfs:comment "\"A neural rendering technique that represents 3D scenes as collections of s of 3D Gaussian primitives with learnable positions, colours, opacities, and covariances, enabling photorealistic real-time rendering at 100+ frames per second through GPU-accelerated rasterisation, revolutionising telepre..."@en ;
