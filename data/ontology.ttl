ngm:rendering-pipeline a owl:Class ;
    rdfs:label "Rendering Pipeline"@en ;
    rdfs:comment "The Rendering Pipeline is the ordered computational sequence by which a GPU transforms three-dimensional scene representations — vertex buffers, index buffers, textures, uniform data, and acceleration structures — into a two-dimensional raster image suitable for display or further processing."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:graphics-api ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:vertex-shader ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:render-target ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:compute-shader ],
        ngm:gpu-compute,
        ngm:rasterisation,
        ngm:sc-display-and-rendering ;
    skos:broader ngm:sc-display-and-rendering ;
    vc:enables ngm:augmented-reality,
        ngm:global-illumination,
        ngm:neural-rendering,
        ngm:photorealistic-rendering,
        ngm:physically-based-rendering,
        ngm:post-processing,
        ngm:ray-tracing,
        ngm:real-time-rendering,
        ngm:spatial-computing,
        ngm:virtual-reality ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:acceleration-structure,
        ngm:compute-shader,
        ngm:depth-buffer,
        ngm:fragment-shader,
        ngm:g-buffer,
        ngm:geometry-shader,
        ngm:mesh-shader,
        ngm:rasteriser,
        ngm:ray-tracing-stage,
        ngm:render-target,
        ngm:tessellation-stage,
        ngm:vertex-shader,
        ngm:visibility-buffer ;
    vc:implements ngm:clustered-shading,
        ngm:deferred-rendering,
        ngm:forward-rendering,
        ngm:gpu-driven-rendering,
        ngm:hybrid-ray-tracing,
        ngm:mesh-shader-pipeline,
        ngm:visibility-buffer-rendering ;
    vc:qualityScore "0.52"^^xsd:float ;
    vc:relatedTo ngm:3-d-rendering-engine,
        ngm:compute-shader,
        ngm:neural-rendering,
        ngm:photorealistic-rendering,
        ngm:physically-based-rendering,
        ngm:pixel-shader,
