vf:a-star-algorithm a owl:Class ;
    rdfs:label "A-Star Algorithm"@en ;
    rdfs:comment "A best-first informed search algorithm developed by Peter Hart, Nils Nilsson, and Bertram Raphael in 1968 that finds the optimal path between nodes in a weighted graph by combining actual accumulated cost from the start node (g-score representing precise path cost traversed thus far) with admissible heuristic estimated cost to the goal (h-score providing optimistic lower bound on remaining distance), using evaluation function f(n) = g(n) + h(n) to prioritize exploration through a priority queue ordering nodes by total estimated path cost, guaranteeing optimality and completeness when employing admissible heuristics (never overestimating true cost) whilst remaining optimally efficient by expanding the minimum number of nodes necessary among all optimal algorithms using the same heuristic knowledge, extensively deployed across autonomous vehicle route planning processing 15 billion+ navigation queries daily (Google Maps, Waze, HERE Technologies), video game pathfinding engines (Unity NavMesh serving 1.5 million+ developers, Unreal Engine 5 navigation graphs), robotics motion planning (warehouse automation systems coordinating 500,000+ robots globally including Amazon Robotics 520,000"@en ;
    rdfs:subClassOf vf:search-algorithms ;
    vc:authorityScore "0.94"^^xsd:float ;
    vc:enables <urn:visionflow:linked:goal-directed-search>,
        <urn:visionflow:linked:optimal-path-discovery>,
        <urn:visionflow:linked:pathfinding>,
        <urn:visionflow:linked:route-planning>,
        vf:motion-planning,
        vf:navigation ;
    vc:hasPart <urn:visionflow:linked:closed-set>,
        <urn:visionflow:linked:cost-function>,
        <urn:visionflow:linked:evaluation-function>,
        <urn:visionflow:linked:heuristic-function>,
        <urn:visionflow:linked:open-set>,
        <urn:visionflow:linked:path-reconstruction>,
        <urn:visionflow:linked:priority-queue> ;
    vc:implements <urn:visionflow:linked:best-first-search>,
        <urn:visionflow:linked:heuristic-evaluation>,
        <urn:visionflow:linked:informed-search-strategy>,
        <urn:visionflow:linked:optimal-pathfinding> ;
    vc:maturity "production-ready" ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires <urn:visionflow:linked:admissible-heuristic>,
        <urn:visionflow:linked:distance-metric>,
        <urn:visionflow:linked:graph-representation>,
        <urn:visionflow:linked:node-expansion>,
        <urn:visionflow:linked:priority-queue-data-structure> ;
    vc:slug "a-star-algorithm" ;
    vc:sourceDomain "artificial-intelligence" .

