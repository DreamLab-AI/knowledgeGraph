    skos:broader ngm:ai-governance-and-ethics ;
    vc:hasMaturity ngmi:maturity-stub ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:slug "formal-verification" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:human-oversight a owl:Class ;
    rdfs:label "Human Oversight"@en ;
    rdfs:comment "The continuous or periodic involvement of competent human actors in the governance, development, deployment, and operation of artificial intelligence systems, exercising meaningful control, judgment, and intervention capabilities to ensure AI system decisions and actions remain aligned with human..."@en ;
    rdfs:subClassOf ngm:metaverse-governance-and-safeguarding,
        ngm:sc-governance-and-safety ;
    skos:broader ngm:sc-governance-and-safety ;
    vc:enables ngm:accountability,
