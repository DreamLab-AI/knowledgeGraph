ngm:ethical-sourcing a owl:Class ;
    rdfs:label "Ethical Sourcing"@en ;
    rdfs:comment "ical Sourcing is the corporate and institutional procurement discipline that selects, qualifies and monitors suppliers across multi-tier global supply chains against verifiable human rights, labour, environmental and anti-corruption standards — operationalised through codified frameworks ([[ISO 2..."@en ;
    rdfs:subClassOf ngm:corporate-social-responsibility,
        ngm:human-rights-due-diligence ;
    vc:enables ngm:child-labour-prevention,
        ngm:conflict-free-minerals,
        ngm:consumer-trust,
        ngm:deforestation-free-commodities,
        ngm:living-wage,
        ngm:modern-slavery-eradication,
        ngm:premium-pricing,
        ngm:worker-rights ;
    vc:hasPart ngm:chain-of-custody,
        ngm:grievance-mechanism,
        ngm:remediation-plan,
        ngm:risk-assessment,
        ngm:supplier-audit,
        ngm:supplier-code-of-conduct,
        ngm:third-party-certification,
        ngm:transparency-statement ;
    vc:implements ngm:ilo-core-labour-standards,
        ngm:iso-20400,
        ngm:oecd-due-diligence-guidance,
        ngm:sa8000,
        ngm:un-global-compact,
        ngm:un-guiding-principles-on-business-and-human-rights ;
    vc:maturity "established" ;
    vc:qualityScore "0.52"^^xsd:float ;
    vc:relatedTo ngm:apple-supplier-responsibility,
        ngm:bangladesh-accord,
        ngm:conflict-minerals,
        ngm:csddd,
        ngm:eu-forced-labour-regulation,
        ngm:fair-trade,
        ngm:modern-slavery-act-2015,
        ngm:rana-plaza,
        ngm:tony-s-chocolonely,
        ngm:uyghur-forced-labour ;
    vc:requires ngm:risk-assessment,
        ngm:stakeholder-engagement,
        ngm:supplier-identification,
        ngm:supply-chain-transparency,
        ngm:third-party-audit,
        ngm:worker-voice-mechanism ;
    vc:slug "ethical-sourcing" ;
    vc:sourceDomain "blockchain" ;
    vc:standardizedBy ngm:gri-standards,
        ngm:ilo-core-labour-standards,
        ngm:iso-20400,
        ngm:oecd-due-diligence-guidance,
        ngm:oecd-guidelines-for-multinational-enterprises,
        ngm:sa8000,
        ngm:un-global-compact,
        ngm:un-guiding-principles-on-business-and-human-rights ;
    vc:supports ngm:biodiversity-conservation,
        ngm:indigenous-rights,
        ngm:just-transition,
        ngm:living-wage-campaign,
        ngm:net-zero-transition,
        ngm:sustainable-development-goals ;
    vc:uses ngm:ai-risk-scoring,
        ngm:blockchain-provenance,
        ngm:io-t-sensor-network,
        ngm:nlp-esg-analysis,
        ngm:qr-code-authentication,
        ngm:satellite-monitoring,
        ngm:self-sovereign-identity,
        ngm:zero-knowledge-proofs .

