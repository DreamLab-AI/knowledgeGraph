        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:feature-pyramid-network ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:non-maximum-suppression ],
        ngm:object-detection ;
    vc:contrastsWith ngm:heatmap-regression,
        ngm:regression-testing,
        ngm:semantic-segmentation ;
    vc:dependsOn ngm:backpropagation,
