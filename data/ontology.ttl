ngm:ai-agents a owl:Class ;
    rdfs:label "AI Agents"@en ;
    rdfs:comment "AI Agents are software entities that combine large language models with tool-use capabilities and memory to autonomously perceive environmental state, plan sequences of actions, and execute those actions in pursuit of user-specified goals. Unlike single-shot inference, agents operate in iterative loops, calling external APIs, browsing the web, running code, or invoking other agents as sub-tasks. They sit at the intersection of language modeling, planning, and classical software agents in cognitive architectures."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:large-language-models ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:tool-use ],
        ngm:ai-application ;
    skos:broader ngm:ai-application ;
    vc:dependsOn ngm:planning-and-scheduling,
        ngm:reasoning ;
    vc:enables ngm:multi-agent-systems ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:requires ngm:large-language-models,
        ngm:tool-use ;
    vc:slug "ai-agents" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:ai-deployment a owl:Class ;
    rdfs:label "AI Deployment"@en ;
    rdfs:comment "The phase of the AI lifecycle in which a developed and validated artificial intelligence system is integrated into operational environments, made available to end users, and transitioned from development to production use, encompassing activities such as system integration, infrastructure provisi..."@en ;
    rdfs:subClassOf ngm:ai-infrastructure,
        ngm:ai-lifecycle ;
    vc:enables ngm:ai-system-use-by-ai-users-and-ai-operators ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires ngm:deployment-infrastructure,
        ngm:operational-procedures ;
    vc:slug "ai-deployment" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:ai-lifecycle a owl:Class ;
    rdfs:label "AI Lifecycle"@en ;
    rdfs:comment "The series of distinct phases through which an artificial intelligence system progresses from initial conception to eventual decommissioning, encompassing planning, design, development, verification, deployment, operation, monitoring, maintenance, and retirement, with each phase involving specifi..."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:human-oversight ],
        ngm:ai-infrastructure ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires ngm:human-oversight,
        ngm:stakeholder-engagement-throughout ;
    vc:slug "ai-lifecycle" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:ai-security a owl:Class ;
    rdfs:label "AI Security"@en ;
    rdfs:comment "AI Security is the field of protecting artificial intelligence systems and their components from security threats and vulnerabilities, including adversarial attacks, data poisoning, model theft, and unauthorized access to ensure systems perform as intended."@en ;
    rdfs:subClassOf ngm:ai-governance-and-ethics,
        ngm:cybersecurity ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:enables ngm:secure-ai-deployment ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:slug "ai-security" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:asset-pipeline a owl:Class ;
    rdfs:label "Asset Pipeline"@en ;
    rdfs:comment "An asset pipeline is an automated, staged workflow that ingests raw digital content—such as meshes, textures, audio, and animations—and transforms it through processing, optimisation, and packaging steps into runtime-ready formats. It enforces consistency, enables version control, and reduces manual labour in content production. Asset pipelines are foundational to game development, visual effects, and metaverse platform engineering. They increasingly incorporate AI-assisted compression and level-of-detail generation to scale content delivery."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:render-pipeline ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:asset-management ],
        ngm:3-d-content-pipeline ;
    vc:enables ngm:digital-twin-creation,
        ngm:game-engine ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:asset-management,
        ngm:render-pipeline ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:asset-format-standards,
        ngm:vfx-tools ;
    vc:slug "asset-pipeline" ;
    vc:sourceDomain "metaverse" ;
    vc:uses ngm:3-d-asset,
        ngm:3-d-file-format,
        ngm:data-compression,
        ngm:shader .

ngm:asymmetric-encryption a owl:Class ;
    rdfs:label "Asymmetric Encryption"@en ;
    rdfs:comment "A cryptographic system using mathematically related public-private key pairs where the public key encrypts data that only the corresponding private key can decrypt."@en ;
    rdfs:subClassOf ngm:bc-cryptographic-primitive ;
    skos:broader ngm:bc-cryptographic-primitive ;
    vc:enables ngm:digital-signature ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:implements ngm:elliptic-curve-cryptography ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:slug "asymmetric-encryption" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:hash-function .

ngm:audio-spatialization a owl:Class ;
    rdfs:label "Audio Spatialization"@en ;
    rdfs:comment "Audio Spatialization is the technique of positioning sounds in three-dimensional space using Head-Related Transfer Functions (HRTFs), binaural processing, and ambisonics to create realistic 3D audio experiences that respond to listener position and head movement in virtual reality and immersive a..."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:binaural-rendering ],
        ngm:sc-display-and-rendering ;
    skos:broader ngm:sc-display-and-rendering ;
    vc:enables ngm:3-d-sound-perception,
        ngm:immersive-audio,
        ngm:sound-localization ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:binaural-rendering,
        ngm:head-tracking,
        ngm:hrtf-filters ;
    vc:slug "audio-spatialization" ;
    vc:sourceDomain "spatial-computing" .

ngm:audit-logging a owl:Class ;
    rdfs:label "Audit Logging"@en ;
    rdfs:comment "Audit logging is the systematic, tamper-evident recording of security-relevant events, user actions, and system operations to an immutable or append-only store, enabling retrospective forensic analysis, regulatory compliance, and incident response. Each log entry captures who performed an action, what was performed, when, from where, and the outcome, providing an authoritative chain of evidence. Audit logs are distinct from general application logs by their integrity guarantees and structured, queryable format."@en ;
    rdfs:subClassOf ngm:audit-log ;
    vc:enables ngm:algorithmic-auditing,
        ngm:compliance-verification ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:cybersecurity,
        ngm:information-security ;
    vc:slug "audit-logging" ;
    vc:sourceDomain "security" ;
    vc:supports ngm:audit-trail,
        ngm:compliance-framework,
        ngm:compliance-monitoring .

ngm:automatic-differentiation a owl:Class ;
    rdfs:label "Automatic Differentiation"@en ;
    rdfs:comment "Automatic differentiation (AD) is a family of computational techniques for evaluating the derivative of a function specified by a computer program, by systematically applying the chain rule to elementary arithmetic operations rather than through symbolic algebra or finite-difference approximation. It operates in two principal modes: forward mode, which propagates tangent values alongside primal values, and reverse mode (backpropagation), which accumulates gradients in a backward pass over a recorded computation graph. AD produces machine-precision derivatives at a cost linear in the number of program operations, making it the computational backbone of modern deep learning frameworks."@en ;
    rdfs:subClassOf ngm:optimization-algorithm ;
    vc:enables ngm:backpropagation,
        ngm:deep-learning,
        ngm:gradient-descent ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:optimisation,
        ngm:stochastic-gradient-descent ;
    vc:slug "automatic-differentiation" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:machine-learning-framework,
        ngm:neural-network .

ngm:autonomous-driving a owl:Class ;
    rdfs:label "Autonomous Driving"@en ;
    rdfs:comment "Autonomous driving is the technical capability enabling a vehicle to perceive its environment, predict the behaviour of other agents, plan a safe trajectory, and execute actuator commands — all without direct human intervention. The system architecture typically decomposes into perception (camera, Lidar, radar fusion), localisation (HD map matching, SLAM), prediction (motion modelling of surrounding agents), planning (route, behaviour, and motion planning), and control (longitudinal and lateral actuation). SAE International's J3016 taxonomy defines six automation levels from Level 0 (no automation) to Level 5 (full automation), providing the dominant industry reference framework."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:computer-vision ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:sensor-fusion ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:lidar ],
        ngm:ai-application ;
    skos:broader ngm:ai-application ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:autonomous-vehicle ;
    vc:requires ngm:computer-vision,
        ngm:lidar,
        ngm:sensor-fusion ;
    vc:slug "autonomous-driving" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:object-detection,
        ngm:path-planning .

ngm:avatar-customization a owl:Class ;
    rdfs:label "Avatar Customization"@en ;
    rdfs:comment "Avatar Customization is the practice of modifying and personalizing digital avatar attributes including physical features, clothing, accessories, animations, and expressions to create unique virtual representations that reflect user identity and preferences in metaverse environments."@en ;
    rdfs:subClassOf ngm:sc-content-and-assets,
        ngm:sc-interaction ;
    skos:broader ngm:sc-content-and-assets,
        ngm:sc-interaction ;
    vc:enables ngm:identity-representation,
        ngm:self-expression,
        ngm:social-distinction ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:asset-libraries,
        ngm:customization-tools,
        ngm:real-time-preview ;
    vc:slug "avatar-customization" ;
    vc:sourceDomain "spatial-computing" .

ngm:behavioral-analytics a owl:Class ;
    rdfs:label "Behavioral Analytics"@en ;
    rdfs:comment "The application of statistical and machine learning methods to large-scale records of user or system actions — including clickstreams, transaction logs, application events, and network telemetry — in order to model normal behaviour, detect anomalies, predict future actions, and personalise experiences. Behavioural analytics underpins cybersecurity (UEBA — user and entity behaviour analytics), e-commerce recommendation, digital health monitoring, and fraud detection."@en ;
    rdfs:subClassOf ngm:ai-technique,
        ngm:machine-learning ;
    skos:broader ngm:ai-technique ;
    vc:dependsOn ngm:deep-learning,
        ngm:machine-learning ;
    vc:enables ngm:cybersecurity,
        ngm:data-analytics ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:artificial-intelligence,
        ngm:federated-learning,
        ngm:neural-network ;
    vc:slug "behavioral-analytics" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:anomaly-detection,
        ngm:pattern-recognition,
        ngm:predictive-analytics .

ngm:behaviour-tree a owl:Class ;
    rdfs:label "Behaviour Tree"@en ;
    rdfs:comment "A Behaviour Tree (BT) is a hierarchical, directed acyclic graph structure used to model the decision-making logic of autonomous agents, non-player characters (NPCs), and robots. Internal nodes represent control-flow composites — Sequence, Selector, Parallel, and Decorator — while leaf nodes represent atomic Actions or Conditions; execution propagates through the tree and each node returns Success, Failure, or Running to its parent. Behaviour Trees superseded Finite State Machines (FSMs) in many game and robotics contexts because they offer superior modularity, reusability, and comprehensibility: sub-trees encapsulate coherent behaviours that can be composed without explicit inter-state transition wiring. First popularised in the game-development community circa 2005 and later formalised in robotics frameworks such as BehaviorTree.CPP, BTs are now a standard control architecture in both real-time interactive media and autonomous robotic systems."@en ;
    rdfs:subClassOf ngm:automated-planning ;
    vc:contrastsWith ngm:state-machine-replication ;
    vc:enables ngm:autonomous-agent,
        ngm:npc-interaction ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:ai-game-agent,
        ngm:intelligent-npc,
        ngm:state-machine ;
    vc:slug "behaviour-tree" ;
    vc:sourceDomain "ai" ;
    vc:supports ngm:game-development,
        ngm:game-engine ;
    vc:uses ngm:ai-agents,
        ngm:pathfinding-algorithm .

ngm:bip-340-schnorr-keypair a owl:Class ;
    rdfs:label "BIP-340 Schnorr Keypair"@en ;
    rdfs:comment "A BIP-340 Schnorr Keypair is the 32-byte public key and associated private key pairing defined by Bitcoin Improvement Proposal 340, which introduced Schnorr signature support to Bitcoin via the Taproot upgrade activated in November 2021. Unlike the earlier ECDSA scheme used in Bitcoin, BIP-340 uses x-only public keys — just the x-coordinate of the secp256k1 curve point — reducing on-chain byte footprint and simplifying key aggregation. The scheme is provably secure under the discrete logarithm assumption and supports native key and signature aggregation via protocols such as MuSig2, enabling multi-party signing that is indistinguishable from single-party signing on-chain. BIP-340 keypairs are the cryptographic foundation for Taproot outputs, Tapscript, and the Nostr identity protocol."@en ;
    rdfs:subClassOf ngm:cryptographic-keys ;
    vc:enables ngm:multi-sig-governance,
        ngm:taproot-assets ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:bitcoin-improvement-proposals ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:bip-340,
        ngm:bip-341,
        ngm:schnorr-signature,
        ngm:secp256k1 ;
    vc:slug "bip-340-schnorr-keypair" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:elliptic-curve-cryptography .

ngm:bitcoin-core a owl:Class ;
    rdfs:label "Bitcoin Core"@en ;
    rdfs:comment "Bitcoin Core is the reference implementation of the Bitcoin protocol, providing the canonical software stack that full nodes run to validate transactions, enforce consensus rules, and maintain a complete copy of the blockchain. First released by Satoshi Nakamoto in 2009 and since maintained by an open-source community, it defines the authoritative behaviour of the Bitcoin network through its codebase. Bitcoin Core includes a wallet, a peer-to-peer networking layer, a scripting engine, and the mining interface used to produce new blocks. Consensus-critical changes are introduced through Bitcoin Improvement Proposals, ensuring backward compatibility and broad community review before deployment."@en ;
    rdfs:subClassOf ngm:blockchain ;
    skos:broader ngm:blockchain ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:consensus-mechanism,
        ngm:nakamoto-consensus,
        ngm:proof-of-work ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:bitcoin-improvement-proposals,
        ngm:bitcoin-mining,
        ngm:bitcoin-network,
        ngm:blockchain-protocol,
        ngm:distributed-ledger ;
    vc:slug "bitcoin-core" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:bc-protocol-and-consensus,
        ngm:cryptographic-hash-function,
        ngm:peer-to-peer-network .

ngm:blockchain-energy-consumption a owl:Class ;
    rdfs:label "Blockchain Energy Consumption"@en ;
    rdfs:comment "The electrical power and computational resources consumed by blockchain networks during transaction validation, block creation, and network security operations, varying significantly across consensus mechanisms from energy-intensive Proof-of-Work (Bitcoin: ~140 TWh/year, global electricity) to en..."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:electricity-consumption ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
