ngm:technology-infrastructure-domain-inspection a owl:Class ;
    rdfs:comment "Infrastructure inspection is the robotic application of surveying and assessing physical assets such as power lines, pipelines, bridges, wind turbines, and buildings to detect defects, corrosion, and structural risk. Robots equipped with cameras, thermal and LiDAR sensors capture data in environments that are hazardous, remote, or costly for human crews. It improves safety and inspection frequency while generating quantitative condition records for predictive maintenance."@en ;
    rdfs:label "Infrastructure Inspection"@en ;
    rdfs:subClassOf ngm:ai-application ;
