ngm:belief-propagation a owl:Class ;
    rdfs:label "Belief Propagation"@en ;
    rdfs:comment "Belief propagation is a message-passing algorithm for performing inference on graphical models by iteratively exchanging local messages between nodes representing variables and the factors that relate them. On tree-structured graphs it computes exact marginal distributions; on graphs with cycles, loopy belief propagation provides an approximate inference scheme that often works well in practice. It is the basis of efficient decoding for modern error-correcting codes and of probabilistic reasoning over structured domains."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:graphical-model ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:message-passing ],
        ngm:graphical-model ;
    vc:contrastsWith ngm:markov-chain-monte-carlo ;
    vc:enables ngm:inference,
        ngm:probabilistic-inference,
        ngm:reasoning ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:graphical-model,
        ngm:message-passing ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:error-correcting-code,
        ngm:probabilistic-reasoning,
        ngm:variational-inference ;
    vc:slug "belief-propagation" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:probabilistic-model,
        ngm:statistical-inference ;
    vc:uses ngm:markov-chain,
        ngm:message-passing,
        ngm:probability-theory .

ngm:binance a owl:Class ;
    rdfs:label "Binance"@en ;
    rdfs:comment "Binance is a centralised cryptocurrency exchange founded in 2017 by Changpeng Zhao (CZ) and Yi He, which rapidly grew to become one of the highest-volume digital-asset trading venues globally. It provides spot trading, perpetual and futures derivatives, margin lending, staking, savings products, and a token launchpad across hundreds of supported assets. Binance created the BNB token as a native utility and fee-discount instrument, and subsequently developed BNB Chain, an EVM-compatible Layer-1 blockchain that hosts a substantial decentralised-finance and Web3 application ecosystem. The exchange has faced extensive regulatory scrutiny across multiple jurisdictions, including a landmark 2023 settlement with the United States Department of Justice and FinCEN, resulting in substantial financial penalties and a change in executive leadership."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
