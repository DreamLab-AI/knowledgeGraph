    vc:qualityScore "0.35"^^xsd:float ;
    vc:slug "tele-001-telepresence" ;
    vc:sourceDomain "distributed-collaboration" ;
    vc:uses ngm:audio-system,
        ngm:avatar .

ngm:term-definitions a owl:Class ;
    rdfs:label "Term Definitions"@en ;
    rdfs:comment "Term definitions are the authoritative, machine-readable descriptions that bind a label or identifier to its precise meaning within a controlled vocabulary, glossary, or ontology. Each definition fixes the intension of a term so that data producers and consumers interpret it consistently. They are the atomic content of glossaries and semantic registries and are essential for interoperability across systems."@en ;
    rdfs:subClassOf ngm:data-management ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:glossary-index,
        ngm:semantic-metadata-registry ;
    vc:slug "term-definitions" ;
    vc:sourceDomain "data" .

ngm:terraform a owl:Class ;
    rdfs:label "Terraform"@en ;
    rdfs:comment "Terraform is an open-source infrastructure-as-code tool that lets engineers define cloud and on-premises resources in declarative configuration files and provision them through a consistent execution workflow. It maintains a state file that records the real-world mapping of declared resources, computes a plan describing the changes needed to reach the desired state, and applies those changes idempotently. Terraform supports many providers through a plugin model, enabling multi-cloud and hybrid provisioning from a single configuration language."@en ;
    rdfs:subClassOf ngm:infrastructure-as-code ;
    vc:bridgesTo ngm:cloud-computing ;
    vc:contrastsWith ngm:configuration-management ;
    vc:enables ngm:automation,
        ngm:reproducibility ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:implements ngm:configuration-management,
        ngm:infrastructure-as-code ;
    vc:isPartOf ngm:devops ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:configuration-management,
        ngm:data-center ;
    vc:slug "terraform" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:cloud-computing,
        ngm:cloud-infrastructure,
        ngm:kubernetes ;
    vc:uses ngm:version-control .

ngm:tessera a owl:Class ;
    rdfs:label "Tessera"@en ;
    rdfs:comment "Tessera is a private-transaction manager used with the Quorum enterprise Ethereum client to store and exchange encrypted payloads between authorised parties off the main chain. It enables confidential smart-contract state by keeping private data outside public blocks while anchoring only encrypted hashes on-chain. Tessera is a key component for enterprises that need permissioned, privacy-preserving distributed-ledger deployments."@en ;
    rdfs:subClassOf ngm:bc-network-component ;
    skos:broader ngm:bc-network-component ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:enterprise-smart-contracts,
        ngm:quorum-blockchain ;
    vc:slug "tessera" ;
    vc:sourceDomain "blockchain" .

ngm:tezos a owl:Class ;
    rdfs:label "Tezos"@en ;
    rdfs:comment "Tezos is a self-amending, proof-of-stake Layer 1 blockchain platform launched in 2018 that enables on-chain governance through a formal, stakeholder-driven amendment process, allowing protocol upgrades to be proposed, debated, and applied without hard forks. It uses a Liquid Proof of Stake consensus mechanism in which token holders (XTZ holders) may either bake blocks themselves or delegate their stake to bakers, earning proportional rewards. The platform supports Turing-complete smart contracts written in Michelson and higher-level languages such as Ligo and SmartPy, targeting decentralised finance, NFT issuance, and digital asset custody. Its on-chain governance model is considered a pioneering example of decentralised protocol evolution and formal verification-friendly contract design."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:liquid-proof-of-stake ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:proof-of-stake ],
        ngm:layer-1 ;
    vc:bridgesTo ngm:formal-methods,
        ngm:institutional-finance ;
    vc:contrastsWith ngm:cardano,
        ngm:ethereum,
        ngm:polkadot,
        ngm:solana ;
