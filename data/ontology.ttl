ngm:rb-0021-robot-kinematics a owl:Class ;
    rdfs:label "rb 0021 robot kinematics"@en ;
    rdfs:comment "Robot kinematics is the study of the geometry and motion of robot mechanisms — particularly manipulator arms — without regard to the forces or torques that cause motion. It encompasses forward kinematics (computing end-effector pose from joint configurations), inverse kinematics (computing joint configurations for a desired end-effector pose), Jacobian analysis relating joint velocities to Cartesian velocities, and singularity analysis. Kinematic models are foundational inputs to motion planning, trajectory generation, and control law design."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:forward-kinematics ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:inverse-kinematics ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:rb-0030-jacobian-matrix ],
        ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:enables ngm:rb-0049-motion-planning,
        ngm:rb-0064-computed-torque-control ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:forward-kinematics,
        ngm:inverse-kinematics,
        ngm:rb-0030-jacobian-matrix ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:rb-0022-robot-dynamics,
        ngm:rb-0023-degrees-of-freedom,
        ngm:rb-0031-singularity ;
    vc:slug "rb-0021-robot-kinematics" ;
    vc:sourceDomain "robotics" .

ngm:real-time-analytics a owl:Class ;
    rdfs:label "Real-Time Analytics"@en ;
    rdfs:comment "Real-time analytics is the processing and analysis of data immediately as it is generated, producing insights and triggering actions with sub-second to low-second latency. It relies on stream-processing engines, in-memory computation, and windowed aggregation rather than batch ETL. It enables responsive dashboards, anomaly detection, and adaptive systems that act on fresh data."@en ;
    rdfs:subClassOf ngm:data-management ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:adaptive-virtual-experience,
        ngm:edge-computing-node ;
    vc:slug "real-time-analytics" ;
    vc:sourceDomain "data" .

ngm:render-pipeline a owl:Class ;
    rdfs:label "Render Pipeline"@en ;
    rdfs:comment "A Render Pipeline is the ordered sequence of programmable and fixed-function GPU stages that transforms 3D scene geometry, material data, and lighting information into a final rasterised or ray-traced 2D image frame, typically encompassing vertex processing, tessellation, geometry shading, rasterisation, fragment shading, depth-stencil testing, blending, and screen-space post-processing. Modern graphics APIs — including Vulkan, DirectX 12, Metal, and WebGPU — expose explicit, low-overhead control over pipeline state objects and synchronisation barriers, enabling advanced techniques such as deferred rendering, clustered shading, variable-rate shading, and hardware-accelerated ray tracing. The render pipeline is the core computational artefact of any real-time interactive graphics system and is equally foundational to offline path-traced production rendering, though the stage granularity and scheduling strategies differ considerably between the two contexts. In spatial computing and metaverse platforms, render pipeline design determines latency, fidelity, and energy consumption on resource-constrained XR devices."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gpu ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:shader ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:graphics-api ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:compute-shader ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:pixel-shader ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:depth-buffer ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:post-processing ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:scene-graph ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:vertex-shader ],
        ngm:sc-display-and-rendering ;
    skos:broader ngm:sc-display-and-rendering ;
    vc:bridgesTo ngm:machine-learning-accelerator,
        ngm:neural-rendering ;
    vc:contrastsWith ngm:offline-rendering,
        ngm:path-tracing ;
    vc:dependsOn ngm:memory-bandwidth ;
    vc:enables ngm:augmented-reality,
        ngm:immersive-experience,
        ngm:ray-tracing,
        ngm:real-time-rendering,
        ngm:virtual-reality ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:compute-shader,
        ngm:depth-buffer,
        ngm:pixel-shader,
        ngm:post-processing,
        ngm:shader,
        ngm:vertex-shader ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:level-of-detail,
        ngm:occlusion-culling,
        ngm:physics-engine,
        ngm:signal-processing ;
    vc:requires ngm:gpu,
        ngm:graphics-api,
        ngm:scene-graph ;
    vc:slug "render-pipeline" ;
    vc:sourceDomain "spatial-computing" ;
    vc:standardizedBy ngm:khronos-group,
        ngm:w3-c ;
    vc:uses ngm:3-d-rendering-engine,
        ngm:physically-based-rendering,
        ngm:vulkan,
        ngm:webgpu .

ngm:robot a owl:Class ;
    rdfs:label "Robot"@en ;
    rdfs:comment "A robot is an actuated mechanism, programmable in two or more axes with a degree of autonomy, that moves within its environment to perform intended tasks without direct human intervention at the moment of task execution. Robots integrate mechanical structure, actuation, sensing, and control software to perceive their environment, reason about goals, and execute physical or digital actions. The concept spans a wide spectrum from fixed industrial manipulators to mobile autonomous agents, collaborative cobots, and software robots (robotic process automation). Standardised by ISO 8373:2021, the definition distinguishes robots from simple automated machines by requiring reprogrammability and environmental interaction."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:end-effector ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:robot-controller ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:robot-operating-system ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:kinematics ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:real-time-control ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:motion-planning ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:sensor ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:actuator ],
        ngm:robo-robot-type ;
    skos:broader ngm:robo-robot-type ;
