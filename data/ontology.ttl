ngm:generative-model a owl:Class ;
    rdfs:label "Generative Model"@en ;
    rdfs:comment "A class of machine learning models that learn the underlying probability distribution of training data and can sample novel instances from that distribution. Architectures include generative adversarial networks, variational autoencoders, diffusion models, normalising flows, and autoregressive transformers, covering domains such as text, image, audio, and code generation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:training-data ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:neural-network ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:autoencoder ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:normalising-flow ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:diffusion-model ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:latent-diffusion ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:generative-adversarial-network ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:deep-generative-model ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:large-language-models ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:variational-autoencoder ],
        ngm:machine-learning-discipline ;
    vc:bridgesTo ngm:content-creation,
        ngm:synthetic-data ;
    vc:contrastsWith ngm:discriminative-model,
        ngm:supervised-learning ;
    vc:dependsOn ngm:deep-learning,
        ngm:latent-space,
        ngm:unsupervised-learning ;
    vc:enables ngm:audio-synthesis,
        ngm:code-generation,
        ngm:data-augmentation,
        ngm:image-generation,
        ngm:text-generation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:autoencoder,
        ngm:deep-generative-model,
        ngm:diffusion-model,
