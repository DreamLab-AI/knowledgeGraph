ngm:policy-layer a owl:Class ;
    rdfs:label "Policy Layer"@en ;
    rdfs:comment "The Policy Layer is the cross-cutting stratum that encodes machine-readable rules, constraints, and authorisations governing system behaviour. It sits above operational concerns and below the human-facing Governance Layer, translating governance intent into enforceable statements that other layers consult before acting. It contains policy definitions, decision points, and enforcement hooks rather than the data or compute those policies regulate."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:identity-layer ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:control-layer ],
        ngm:owl-thing ;
    vc:enables ngm:compliance-layer,
        ngm:governance-layer ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:control-layer,
        ngm:identity-layer ;
    vc:slug "policy-layer" ;
    vc:sourceDomain "policy" .

ngm:policy-optimisation a owl:Class ;
    rdfs:label "Policy Optimisation"@en ;
    rdfs:comment "Policy optimisation is the process of searching over a parameterised space of decision-making policies to maximise a scalar objective, typically a cumulative reward signal in a reinforcement learning context. It encompasses both gradient-based methods such as proximal policy optimisation and gradient-free approaches such as evolutionary strategies, applied across discrete and continuous action spaces."@en ;
    rdfs:subClassOf ngm:optimisation ;
    vc:enables ngm:deep-reinforcement-learning,
        ngm:reinforcement-learning-for-robotics ;
    vc:hasMaturity ngmi:maturity-established ;
