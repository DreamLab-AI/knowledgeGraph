        ngm:fashion-design,
        ngm:film-pre-production,
        ngm:game-asset-generation,
        ngm:medical-illustration,
        ngm:social-media-content ;
    vc:uses ngm:adobe-creative-cloud,
        ngm:chat-gpt-integration,
        ngm:discord-api,
        ngm:gemini-api,
        ngm:photoshop-integration,
        ngm:rest-api,
        ngm:web-interface .

ngm:provenance-ontology-prov-o a owl:Class ;
    rdfs:label "Provenance Ontology (PROV-O)"@en ;
    rdfs:comment "W3C standard ontology for representing and interchanging provenance information, capturing the origin, attribution, derivation, and lifecycle of digital entities through formal Entity-Activity-Agent relationships."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:sparql-endpoint ],
        ngm:sc-standards-and-interop ;
    skos:broader ngm:sc-standards-and-interop ;
    vc:enables ngm:audit-trail,
        ngm:blockchain-provenance,
        ngm:data-lineage-tracking,
        ngm:scientific-reproducibility,
        ngm:trust-verification ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:activity-model,
        ngm:agent-model,
        ngm:attribution-model,
        ngm:derivation-chains,
        ngm:entity-model,
        ngm:generation-events,
        ngm:influence-patterns,
        ngm:qualified-relations,
        ngm:usage-events ;
    vc:isPartOf ngm:semantic-web-standards ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:ontology-reasoner,
        ngm:rdf-store,
        ngm:sparql-endpoint ;
    vc:slug "provenance-ontology-prov-o" ;
    vc:sourceDomain "spatial-computing" .

ngm:proximity-search a owl:Class ;
    rdfs:label "Proximity Search"@en ;
    rdfs:comment "Geospatial query algorithms that locate nearby points of interest within a specified radius using coordinate-based indexing mods such as geohashing and quadtree structures for efficient location-based service applications."@en ;
    rdfs:subClassOf ngm:geospatial-technology,
        ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:enables ngm:nearby-discovery ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:slug "proximity-search" ;
    vc:sourceDomain "spatial-computing" .

ngm:pruned-node a owl:Class ;
    rdfs:label "Pruned Node"@en ;
    rdfs:comment "A Pruned Node is a blockchain full node that validates the complete chain history during initial block download but subsequently discards spent transaction outputs and old block data beyond a configurable retention window, reducing on-disk storage requirements by orders of magnitude while retaining full validation capability for new blocks. Pruning enables operators with limited storage (e.g. 5–10 GB rather than 500+ GB for Bitcoin's full history) to participate in consensus verification without trusting third parties, unlike SPV light nodes that skip validation entirely. The pruned node can no longer serve historical block data to peers, constraining its contribution to network archival."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptographic-hash-function ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:blockchain ],
        ngm:bc-network-component,
        ngm:blockchain-entity,
        ngm:network-component ;
    skos:broader ngm:bc-network-component ;
    vc:contrastsWith ngm:archival-node ;
    vc:dependsOn ngm:data-storage ;
    vc:enables ngm:blockchain-scalability,
        ngm:consensus-mechanism ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:blockchain-network ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:archival-node,
        ngm:full-node,
        ngm:light-node,
        ngm:utxo-model ;
    vc:requires ngm:blockchain,
        ngm:cryptographic-hash-function ;
    vc:slug "pruned-node" ;
    vc:sourceDomain "blockchain" .

ngm:quadcopter a owl:Class ;
    rdfs:label "Quadcopter"@en ;
    rdfs:comment "A vertical take-off and landing (VTOL) aerial robot with four fixed-pitch rotors arranged symmetrically around a central frame, achieving attitude control and thrust modulation by differentially varying rotor speeds. Quadcopters are mechanically simple (no swashplate), highly manoeuvrable, and statically stable in hover, making them the dominant platform for consumer UAVs, autonomous aerial robotics research, and inspection applications."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:pid-controller ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:imu ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:inertial-measurement-unit ],
        ngm:multirotor-uav,
        ngm:robo-robot-type ;
    skos:broader ngm:robo-robot-type ;
    vc:enables ngm:autonomous-navigation,
        ngm:swarm-robotics ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:imu,
        ngm:inertial-measurement-unit,
        ngm:pid-controller ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:aerial-robot,
        ngm:computer-vision,
        ngm:lidar,
        ngm:slam ;
    vc:slug "quadcopter" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:embedded-systems,
        ngm:sensor-fusion .

ngm:quadruped-robot a owl:Class ;
    rdfs:label "Quadruped Robot"@en ;
    rdfs:comment "A robotic platform that locomotes on four legs using gaits inspired by mammals such as dogs and cats. Quadruped robots employ reinforcement learning, model-predictive control, and whole-body dynamics to achieve robust locomotion over rough terrain, enabling deployment in inspection, search-and-rescue, and logistics applications."@en ;
    rdfs:subClassOf ngm:legged-robot,
        ngm:robo-robot-type ;
    skos:broader ngm:robo-robot-type ;
    vc:enables ngm:autonomous-navigation,
        ngm:whole-body-control ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:autonomous-robot,
        ngm:humanoid-robot,
        ngm:mobile-robot,
        ngm:robotic-system ;
    vc:slug "quadruped-robot" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:reinforcement-learning,
        ngm:robot-control,
        ngm:robot-kinematics,
        ngm:sensor-fusion .

ngm:quality-standard a owl:Class ;
    rdfs:label "Quality Standard"@en ;
    rdfs:comment "A Quality Standard is a formally published specification that defines measurable requirements for quality management, process control, testing methodology, and conformance verification in robot manufacturing and deployment contexts. Quality standards provide the normative benchmarks against which robotic systems are assessed for reliability, safety, and fitness for purpose across their operational lifecycle."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:testing-process ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:compliance-control ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:compliance-verification ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:compliance-standards ],
        ngm:robo-safety-and-standards,
        ngm:robot-standard ;
    skos:broader ngm:robo-safety-and-standards ;
    vc:enables ngm:compliance-framework,
        ngm:compliance-monitoring ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:compliance-control,
        ngm:compliance-standards ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:compliance-audit-trail,
        ngm:compliance-dashboard,
        ngm:robotics-systems ;
    vc:requires ngm:compliance-verification,
        ngm:testing-process ;
    vc:slug "quality-standard" ;
    vc:sourceDomain "robotics" ;
    vc:standardizedBy ngm:robotics ;
    vc:uses ngm:iso-standards,
        ngm:testing-infrastructure .

ngm:query-vector a owl:Class ;
    rdfs:label "Query Vector"@en ;
    rdfs:comment "A Query Vector is a dense numerical representation of a search query produced by an embedding model, enabling similarity-based retrieval in a high-dimensional vector space. It is matched against stored document or passage embeddings using distance metrics such as cosine similarity or inner product, forming the core retrieval mechanism in semantic search and retrieval-augmented generation systems. Query vectors encode the semantic intent of a query independent of exact keyword overlap, allowing conceptually related results to be surfaced even when surface-level vocabulary differs."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:embedding-model ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:vector-database ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:embedding-model ],
        ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:enables ngm:nearest-neighbor-search,
        ngm:retrieval-augmented-generation,
        ngm:semantic-search ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:embedding-model ;
    vc:isPartOf ngm:retrieval-augmented-generation ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:natural-language-processing,
        ngm:query-key-value,
        ngm:query-processor,
        ngm:retrieval-augmented-generation-rag ;
    vc:requires ngm:embedding-model,
        ngm:vector-database ;
    vc:slug "query-vector" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:information-retrieval .

ngm:rapid-ai-deployment a owl:Class ;
    rdfs:label "Rapid AI Deployment"@en ;
    rdfs:comment "Rapid AI Deployment refers to accelerated processes for taking AI models from development into production, prioritising speed-to-market through streamlined MLOps pipelines, automated testing, and pre-built infrastructure. It encompasses practices such as continuous delivery of model updates, containerised inference serving, and automated monitoring to minimise the time between model training and live operation while managing associated risks."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cloud-infrastructure ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:machine-learning-pipeline ],
        ngm:ai-infrastructure ;
    vc:contrastsWith ngm:federated-learning ;
    vc:dependsOn ngm:inference-hardware,
        ngm:machine-learning-model ;
    vc:enables ngm:ai-deployment,
        ngm:inference ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:ai-lifecycle,
        ngm:ai-risk-management,
        ngm:responsible-ai ;
    vc:requires ngm:cloud-infrastructure,
        ngm:machine-learning-pipeline ;
    vc:slug "rapid-ai-deployment" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:api-gateway,
        ngm:machine-learning-infrastructure .

ngm:rb-0008-autonomous-robot a owl:Class ;
    rdfs:label "rb 0008 autonomous robot"@en ;
    rdfs:comment "An autonomous robot is a robotic system capable of performing tasks in unstructured environments without continuous human intervention, relying on onboard sensing, perception, decision-making, and actuation. Autonomy spans a spectrum from simple programmed responses to full cognitive agency; key enabling technologies include SLAM, path planning, machine learning-based perception, and safety-certified control architectures."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:rb-0089-risk-assessment ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:perception-system ],
        ngm:robo-robot-type ;
    skos:broader ngm:robo-robot-type ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:autonomous-navigation,
        ngm:autonomous-system,
        ngm:rb-0007-collaborative-robot,
        ngm:rb-0012-wheeled-mobile-robot ;
    vc:requires ngm:perception-system,
        ngm:rb-0089-risk-assessment ;
    vc:slug "rb-0008-autonomous-robot" ;
    vc:sourceDomain "robotics" ;
    vc:supports ngm:rb-0096-safeguarding ;
    vc:uses ngm:machine-learning,
        ngm:rb-0049-motion-planning,
        ngm:slam .

ngm:rb-0017-rescue-robot a owl:Class ;
    rdfs:label "rb 0017 rescue robot"@en ;
    rdfs:comment "A rescue robot is a mobile robotic system specifically designed or adapted for deployment in disaster, emergency, or hazardous environments where direct human access is dangerous or impossible. Rescue robots perform tasks such as victim search-and-detection, structural reconnaissance, rubble traversal, gas sensing, and teleoperated manipulation of debris. They typically integrate rugged locomotion systems (tracked, legged, or serpentine), multiple sensor modalities (thermal, depth camera, LIDAR, gas detectors), and semi-autonomous navigation with human-on-the-loop teleoperation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:autonomous-navigation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:obstacle-avoidance ],
        ngm:mobile-robot,
        ngm:robo-robot-type ;
    skos:broader ngm:robo-robot-type ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:mobile-robot-platform,
        ngm:rb-0008-autonomous-robot,
        ngm:rb-0018-inspection-robot ;
    vc:requires ngm:autonomous-navigation,
        ngm:obstacle-avoidance ;
    vc:slug "rb-0017-rescue-robot" ;
    vc:sourceDomain "robotics" ;
    vc:supports ngm:rescue-robot,
        ngm:swarm-robotics ;
    vc:uses ngm:rb-0069-lidar,
        ngm:rb-0077-depth-camera,
        ngm:slam .

ngm:rb-0018-inspection-robot a owl:Class ;
    rdfs:label "rb 0018 inspection robot"@en ;
    rdfs:comment "An inspection robot is a mobile robotic system designed to autonomously or semi-autonomously navigate environments that are hazardous, inaccessible, or inefficient for human workers, in order to assess the structural, mechanical, or operational condition of infrastructure, equipment, or facilities. Equipped with sensor arrays (cameras, LiDAR, ultrasonic, thermal IR), inspection robots collect data for predictive maintenance, safety auditing, and non-destructive testing across industries such as oil and gas pipelines, power-grid infrastructure, bridges, and confined industrial spaces."@en ;
    rdfs:subClassOf ngm:mobile-robot,
        ngm:robo-robot-type ;
    skos:broader ngm:robo-robot-type ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:autonomous-robot,
        ngm:rb-0012-wheeled-mobile-robot,
        ngm:rb-0017-rescue-robot ;
    vc:slug "rb-0018-inspection-robot" ;
    vc:sourceDomain "robotics" ;
    vc:supports ngm:rb-0089-risk-assessment ;
    vc:uses ngm:rb-0066-robot-sensor,
        ngm:rb-0068-vision-system,
        ngm:rb-0069-lidar,
        ngm:rb-0078-infrared-sensor .

ngm:rb-0065-visual-servoing a owl:Class ;
    rdfs:label "rb 0065 visual servoing"@en ;
    rdfs:comment "Visual servoing is a robot control technique that uses real-time visual feedback from a camera to regulate the motion of a robot toward a goal configuration. Image-based visual servoing (IBVS) minimises an image-feature error directly, while position-based visual servoing (PBVS) reconstructs 3-D pose from vision before computing Cartesian control signals. The approach is widely used in manipulation, assembly, and tracking tasks where precise end-effector placement relative to a visually perceived target is required."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:rb-0047-feedback-control ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:rb-0030-jacobian-matrix ],
        ngm:feedback-control,
        ngm:robo-perception ;
    skos:broader ngm:robo-perception ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:object-detection,
        ngm:pose-estimation,
        ngm:rb-0064-computed-torque-control ;
    vc:requires ngm:rb-0030-jacobian-matrix,
        ngm:rb-0047-feedback-control ;
    vc:slug "rb-0065-visual-servoing" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:computer-vision,
        ngm:feature-extraction,
        ngm:rb-0068-vision-system .

ngm:rb-0070-tactile-sensing a owl:Class ;
    rdfs:label "rb 0070 tactile sensing"@en ;
    rdfs:comment "Tactile sensing is the robotic capability to detect and measure contact forces, pressures, textures, and slip at points of physical interaction between the robot and its environment or human operators. Realised through arrays of pressure sensors, capacitive skins, or piezoelectric films distributed across end-effectors and link surfaces, tactile sensing enables compliant grasping, contact-triggered safety stops, and rich feedback for teleoperation. It is a key enabling technology for human-robot collaboration under ISO/TS 15066."@en ;
    rdfs:subClassOf ngm:robo-perception,
        ngm:tactile-sensor ;
    skos:broader ngm:robo-perception ;
    vc:enables ngm:collaborative-operation,
        ngm:haptic-feedback,
        ngm:rb-0092-protective-stop ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:force-control,
        ngm:sensor-fusion ;
    vc:slug "rb-0070-tactile-sensing" ;
    vc:sourceDomain "robotics" ;
    vc:standardizedBy ngm:iso-ts-15066 ;
    vc:uses ngm:force-torque-sensor,
        ngm:pressure-sensor .

ngm:rb-0080-radar a owl:Class ;
    rdfs:label "rb 0080 radar"@en ;
    rdfs:comment "Radar (Radio Detection and Ranging) is an active sensing technology that emits radio-frequency electromagnetic pulses and detects reflected returns to measure the range, velocity, and bearing of objects in the environment. In robotics, radar sensors provide reliable obstacle detection and velocity estimation across diverse weather and lighting conditions where cameras and LiDAR may degrade, making them particularly valuable for autonomous ground vehicles, drones, and safety-critical proximity monitoring in industrial settings."@en ;
    rdfs:subClassOf ngm:robo-perception,
        ngm:sensor ;
    skos:broader ngm:robo-perception ;
    vc:contrastsWith ngm:rb-0077-depth-camera ;
    vc:enables ngm:object-detection,
        ngm:proximity-detection,
        ngm:rb-0052-collision-avoidance ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:rb-0066-robot-sensor,
        ngm:rb-0069-lidar,
        ngm:rb-0075-range-finder,
        ngm:sensor-fusion ;
    vc:slug "rb-0080-radar" ;
    vc:sourceDomain "robotics" .

ngm:reactive-control a owl:Class ;
    rdfs:label "Reactive Control"@en ;
    rdfs:comment "Reactive Control is a paradigm of robot control architecture in which sensor inputs are mapped directly to actuator outputs through fast, pre-compiled stimulus-response rules, without constructing an explicit world model. Associated with Brooks's subsumption architecture and behaviour-based robotics, it enables low-latency responses to environmental perturbations and is typically combined with deliberative or hybrid planners in practical autonomous systems."@en ;
    rdfs:subClassOf ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:contrastsWith ngm:closed-loop-control ;
    vc:enables ngm:autonomous-robot,
        ngm:obstacle-avoidance ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:force-control,
        ngm:manipulation,
        ngm:motion-control ;
    vc:slug "reactive-control" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:feedback-control,
        ngm:sensor-fusion .

ngm:record-keeping-system a owl:Class ;
    rdfs:label "Record Keeping System"@en ;
    rdfs:comment "A Record Keeping System, in the blockchain domain, is an immutable, append-only ledger in which transactions or state changes are cryptographically hashed, linked via Merkle trees, and validated by a consensus mechanism to provide a tamper-evident audit trail. It replaces or augments traditional centralised databases in applications requiring transparent provenance, non-repudiation, and multi-party data integrity—including asset registries, supply-chain tracking, and compliance logging."@en ;
    rdfs:subClassOf ngm:bc-network-component ;
    skos:broader ngm:bc-network-component ;
    vc:enables ngm:audit-trail,
        ngm:data-integrity,
        ngm:data-provenance ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:data-governance,
        ngm:smart-contract ;
    vc:slug "record-keeping-system" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:consensus-mechanism,
        ngm:cryptographic-hash,
        ngm:distributed-ledger,
        ngm:merkle-tree .

ngm:redress-procedure a owl:Class ;
    rdfs:label "Redress Procedure"@en ;
    rdfs:comment "A Redress Procedure is a formalised mechanism enabling individuals or groups adversely affected by AI system decisions to challenge those decisions, seek explanations, request human review, and obtain remedies including correction, compensation, or policy changes. Redress procedures embody accountability by ensuring that consequential algorithmic decisions—in employment, credit, housing, criminal justice, and public services—remain contestable rather than treated as unappealable automated verdicts. Effective procedures must be accessible (understandable without legal expertise), timely (preventing irreversible harm), thorough (genuine rather than perfunctory human review), and proportionate, with escalation pathways from internal review through independent ombudsman services to judicial challenge."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:explainability ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:human-oversight ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:transparency ],
        ngm:ai-governance-and-ethics,
        ngm:ai-governance-principle ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:enables ngm:accountability,
        ngm:trustworthy-ai ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:ai-ethics,
        ngm:ai-impact-assessment,
        ngm:algorithmic-transparency-reports,
        ngm:audit-trail,
        ngm:diversity-non-discrimination-and-fairness,
        ngm:risk-assessment ;
    vc:requires ngm:explainability,
        ngm:human-oversight,
        ngm:transparency ;
    vc:slug "redress-procedure" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:human-rights,
        ngm:regulatory-compliance .

ngm:reference-standard a owl:Class ;
    rdfs:label "Reference Standard"@en ;
    rdfs:comment "Reference Standard is a technology infrastructure concept and a type of infrastructure."@en ;
    rdfs:subClassOf ngm:infra-legal-and-regulatory ;
    skos:broader ngm:infra-legal-and-regulatory ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:implements ngm:infrastructure ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:slug "reference-standard" ;
    vc:sourceDomain "infrastructure" .

ngm:remote-rendering a owl:Class ;
    rdfs:label "Remote Rendering"@en ;
    rdfs:comment "Remote Rendering offloads GPU-intensive 3D scene computation to a server or cloud node, streaming compressed video frames to a thin client such as an XR headset or mobile device. This approach decouples visual fidelity from device hardware constraints, enabling photorealistic graphics on low-power endpoints while centralising GPU resources. Latency and bandwidth are critical quality-of-service parameters; edge computing deployments minimise round-trip delay to support interactive frame rates."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:latency ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gpu-compute ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:edge-computing ],
        ngm:infra-computing-and-cloud ;
    skos:broader ngm:infra-computing-and-cloud ;
    vc:enables ngm:photorealistic-rendering ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:edge-computing,
        ngm:gpu-compute,
        ngm:latency ;
    vc:slug "remote-rendering" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:cloud-infrastructure,
        ngm:content-delivery-network .

ngm:residual-network a owl:Class ;
    rdfs:label "Residual Network"@en ;
    rdfs:comment "A deep neural network architecture introduced by He et al. (2016) that employs skip connections to allow gradients to propagate directly through layers, expressed as H(x) = F(x) + x. This residual formulation resolves the vanishing gradient problem in very deep networks, enabling training of architectures with hundreds of layers and achieving state-of-the-art performance on image recognition benchmarks."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:neural-network-layer ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:backpropagation ],
        ngm:ai-technique,
        ngm:deep-learning ;
    skos:broader ngm:ai-technique ;
    vc:enables ngm:computer-vision,
        ngm:image-classification,
        ngm:transfer-learning ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:requires ngm:backpropagation,
        ngm:neural-network-layer ;
    vc:slug "residual-network" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:convolutional-neural-network,
        ngm:gpu-compute .

ngm:responsible-ai-unconference a owl:Class ;
    rdfs:label "Responsible AI Unconference"@en ;
    rdfs:comment "A Responsible AI Unconference is a participant-driven gathering that applies open-space technology to surface and negotiate ethical, social, and governance concerns around artificial intelligence. Unlike traditional conferences, the agenda is set on the day by attendees, enabling communities—artists, technologists, marginalised groups, and policymakers—to co-author discussions on topics such as bias, child-centric AI, feminist design, and the boundaries of acceptable automation. The format foregrounds perspectives historically excluded from mainstream AI discourse."@en ;
    rdfs:subClassOf ngm:ai-governance-and-ethics ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:contrastsWith ngm:algorithmic-bias ;
    vc:enables ngm:ai-governance,
        ngm:diversity-non-discrimination-and-fairness ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:relatedTo ngm:ai-ethics,
        ngm:responsible-ai ;
    vc:slug "responsible-ai-unconference" ;
    vc:sourceDomain "artificial-intelligence" .

