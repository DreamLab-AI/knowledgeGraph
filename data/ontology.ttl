ngm:bradley-terry-model a owl:Class ;
    rdfs:comment "The Bradley-Terry model is a probabilistic model for paired comparisons that estimates a latent strength or quality score for each item and predicts the probability that one item beats another via the logistic of their score difference. Fitted by maximum-likelihood from observed comparison outcomes, it produces a global ranking from local pairwise data. In machine learning it underpins preference modelling and reward learning from human comparisons."@en ;
    rdfs:label "Bradley Terry Model"@en ;
    rdfs:subClassOf ngm:machine-learning-discipline ;
