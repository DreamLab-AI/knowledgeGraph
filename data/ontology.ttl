    vc:authorityScore "0.0"^^xsd:float ;
    vc:maturity "reviewed" ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:slug "trust-and-governance-domain" ;
    vc:sourceDomain "artificial-intelligence" .

vf:trust-and-safety a owl:Class ;
    rdfs:label "Trust and Safety"@en ;
    rdfs:comment "Trust and Safety (T&S) is the professional discipline, operational infrastructure, and regulatory framework that governs the detection, review, enforcement, and remediation of harmful content and abusive behaviour across digital platforms, encompassing the full spectrum from child sexual abuse material (CSAM) detection and terrorist content removal through election integrity protection, hate speech moderation, fraud prevention, and platform integrity operations, implemented through a layered architecture combining automated classifiers (PhotoDNA perceptual hashing for known CSAM matching generating robust 1152-bit signatures that survive image transformations via DCT-based processing, Hive Moderation VLM detecting 40+ policy violation classes through Moderation 11B fine-tuned on Llama 3.2 11B Vision, Sightengine covering 110+ moderation classes with 99.2% F1 on specific categories, large platform proprietary transformer-based classifiers, and LLM-based moderation emerging as the next-generation paradigm surpassing traditional NLP on nuanced policy violations per Springer 2025 review), human review pipelines (outsourced moderation operations in Philippines, Kenya, Colombia, and Indi"@en ;
    rdfs:subClassOf <urn:visionflow:linked:online-safety>,
        vf:ai-ethics,
        vf:content-moderation,
        vf:data-protection,
        vf:digital-society-harms,
        vf:platform-governance ;
    vc:authorityScore "0.87"^^xsd:float ;
    vc:enables vf:access-control-system,
        vf:agentic-internet,
        vf:compliance-monitoring,
        vf:digital-identity-wallet,
        vf:reputation-system ;
    vc:hasPart <urn:visionflow:linked:classifier-model>,
        <urn:visionflow:linked:csam-detection>,
        <urn:visionflow:linked:hash-matching>,
        <urn:visionflow:linked:human-review-pipeline>,
        <urn:visionflow:linked:incident-response>,
        <urn:visionflow:linked:platform-integrity>,
        vf:content-moderation,
        vf:policy-enforcement ;
    vc:implements vf:digital-society-surveillance,
        vf:eu-ai-act,
        vf:identity-verification,
        vf:non-repudiation,
        vf:risk-assessment ;
    vc:maturity "production-ready" ;
    vc:qualityScore "0.52"^^xsd:float ;
    vc:requires vf:ai-risks,
        vf:bias-in-large-language-models,
        vf:cryptography-security-and-privacy,
        vf:data-protection,
        vf:privacy-preserving-blockchain ;
    vc:slug "trust-and-safety" ;
    vc:sourceDomain "ethics-society" .

