        ngm:regulatory-technology ;
    vc:contrastsWith ngm:centralised-finance,
        ngm:traditional-banking ;
    vc:dependsOn ngm:ethereum,
        ngm:interoperability-protocol,
        ngm:layer-2-scaling ;
    vc:enables ngm:cross-border-payments,
        ngm:financial-inclusion,
        ngm:flash-loan,
        ngm:real-world-asset-tokenization ;
    vc:hasMaturity ngmi:maturity-established ;
