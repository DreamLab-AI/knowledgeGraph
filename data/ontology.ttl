ngm:telepresence a owl:Class ;
    rdfs:label "Telepresence"@en ;
    rdfs:comment "Telepresence encompasses technologies and interaction paradigms that create a compelling perception of physical presence in a remote or virtual location, enabling natural communication and manipulation at a distance. Systems range from high-definition video conferencing with matched room geometries and spatial audio through robotic telepresence platforms to fully immersive XR environments that deliver volumetric representations and haptic feedback, reducing the cognitive and social costs of geographic separation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:spatial-audio ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:virtual-reality ],
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:enables ngm:immersive-experience ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:relatedTo ngm:augmented-reality ;
    vc:requires ngm:spatial-audio,
        ngm:virtual-reality ;
    vc:slug "telepresence" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:haptic-feedback,
        ngm:teleoperation .

ngm:ai-impact-assessment a owl:Class ;
    rdfs:label "AI Impact Assessment"@en ;
    rdfs:comment "A systematic process for identifying, analysing, evaluating, and documenting the potential positive and negative effects of an artificial intelligence system on individuals, groups, organisations, society, and the environment across multiple dimensions including fundamental rights, ical principle..."@en ;
