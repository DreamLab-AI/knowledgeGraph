ngm:industrial-automation a owl:Class ;
    rdfs:label "IndustrialAutomation"@en ;
    rdfs:comment "Industrial automation is the application of control systems—including programmable logic controllers (PLCs), distributed control systems (DCS), and robotic manipulators—along with information technologies to operate industrial processes and machinery with minimal or no human intervention. It spans discrete manufacturing (assembly lines, packaging, welding) and process industries (chemical plants, oil refineries, power generation), increasing throughput, consistency, and safety by removing humans from hazardous environments. Industrial automation integrates mechanical, electrical, and software engineering disciplines and is increasingly augmented by machine vision, collaborative robots, and AI-driven process optimisation."@en ;
    rdfs:subClassOf ngm:robo-robot-type ;
    skos:broader ngm:robo-robot-type ;
    vc:enables ngm:industrial-io-t,
        ngm:predictive-maintenance ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:digital-twin,
        ngm:real-time-processing ;
    vc:slug "industrial-automation" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:actuator,
        ngm:control-system .

ngm:mechanism-design a owl:Class ;
    rdfs:label "Mechanism Design"@en ;
    rdfs:comment "Mechanism design, sometimes called reverse game theory, is a branch of economics and game theory concerned with constructing the rules and incentive structures of strategic interactions so that self-interested participants produce collectively desirable outcomes. Rather than analysing a given game, mechanism design starts from a desired social choice function and works backwards to identify what game structure (mechanisms) would implement it as an equilibrium strategy for rational agents. In blockchain and decentralised finance contexts, mechanism design governs tokenomics, automated market maker formulas, auction protocols, validator incentive structures, and governance voting systems."@en ;
    rdfs:subClassOf ngm:bc-defi-and-economics ;
    skos:broader ngm:bc-defi-and-economics ;
    vc:enables ngm:incentive-alignment,
        ngm:tokenomics ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:on-chain-governance,
        ngm:token-economics,
        ngm:voting-mechanism ;
    vc:slug "mechanism-design" ;
    vc:sourceDomain "blockchain" .

ngm:mining-pool a owl:Class ;
    rdfs:label "Mining Pool"@en ;
    rdfs:comment "A cooperative arrangement in which multiple miners aggregate their computational resources to increase the probability of successfully mining a block, sharing the resulting block reward proportionally to contributed hash rate. Mining pools reduce variance in miner income but introduce centralisation risks."@en ;
    rdfs:subClassOf ngm:bc-protocol-and-consensus,
        ngm:blockchain-entity,
        ngm:consensus-protocol ;
    skos:broader ngm:bc-protocol-and-consensus ;
    vc:enables ngm:distributed-ledger-technology ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:blockchain-network,
        ngm:proof-of-work ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:block-reward,
        ngm:consensus-algorithm,
        ngm:mempool,
        ngm:transaction-fee ;
    vc:slug "mining-pool" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:consensus-mechanism,
        ngm:hash-function .

ngm:nostr-protocol a owl:Class ;
    rdfs:label "Nostr Protocol"@en ;
    rdfs:comment "Nostr (Notes and Other Stuff Transmitted by Relays) is a minimalist open protocol for censorship-resistant, decentralised messaging and identity, in which clients sign events with Schnorr Signatures|Schnorr signatures over the secp256k1 elliptic curve and broadcast them to any number of s..."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:json-serialisation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:secp256k1-elliptic-curve ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:nostr-relay ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:schnorr-signature ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:web-id-profile ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:web-socket-protocol ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:schnorr-signature ],
        ngm:bc-protocol-and-consensus,
        ngm:blockchain ;
    skos:broader ngm:bc-protocol-and-consensus,
        ngm:blockchain ;
    vc:enables ngm:agent-to-agent-communication,
        ngm:censorship-resistant-messaging,
        ngm:data-vending-machine,
        ngm:lightning-zap-payments ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:nip-architecture,
        ngm:nostr-client,
        ngm:nostr-event,
        ngm:nostr-relay,
        ngm:schnorr-signature,
        ngm:web-id-profile ;
    vc:implements ngm:cryptographic-identity-system,
        ngm:nip-01-core-protocol,
        ngm:nip-05-identity-verification,
        ngm:nip-47-wallet-connect,
        ngm:nip-90-data-vending-machines ;
    vc:isPartOf ngm:bitcoin-ecosystem,
        ngm:decentralised-social-web ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:requires ngm:json-serialisation,
        ngm:schnorr-signature,
        ngm:secp256k1-elliptic-curve,
        ngm:web-socket-protocol ;
    vc:slug "nostr-protocol" ;
    vc:sourceDomain "blockchain" .

ngm:parameter-efficient-fine-tuning a owl:Class ;
    rdfs:label "Parameter-Efficient Fine-Tuning"@en ;
    rdfs:comment "Training techniques that update only a small subset of model parameters during fine-tuning, reducing computational and memory requirements whilst maintaining comparable performance to full fine-tuning. PEFT methods enable adaptation of large models with limited resources by freezing most pre-trained weights and adding or modifying a minimal set of trainable parameters."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:prefix-tuning ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:qlo-ra ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:lo-ra-fine-tuning ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:adapter-modules ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:prompt-tuning ],
        ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:adapter-modules,
        ngm:lo-ra-fine-tuning,
        ngm:prefix-tuning,
        ngm:prompt-tuning,
        ngm:qlo-ra ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:full-fine-tuning,
        ngm:knowledge-distillation,
        ngm:large-language-models,
        ngm:transfer-learning ;
    vc:slug "parameter-efficient-fine-tuning" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:model-training,
        ngm:training-data .

ngm:real-time-processing a owl:Class ;
    rdfs:label "Real-time Processing"@en ;
    rdfs:comment "Real-time Processing is a computational model where data is processed immediately upon arrival or generation, with minimal latency between input and output."@en ;
    rdfs:subClassOf ngm:ai-infrastructure,
        ngm:data-processing ;
    vc:enables ngm:anomaly-detection,
