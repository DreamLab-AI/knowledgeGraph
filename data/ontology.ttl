    vc:relatedTo ngm:digital-economy,
        ngm:north-england-innovation-corridor,
        ngm:uk-tech-ecosystem ;
    vc:slug "leeds-digital-hub" ;
    vc:sourceDomain "infrastructure" .

ngm:legal-evidence a owl:Class ;
    rdfs:label "Legal Evidence"@en ;
    rdfs:comment "Legal evidence is information presented to a court or tribunal to establish facts in dispute, which must satisfy admissibility criteria such as authenticity, relevance, and chain of custody. In digital contexts it includes logs, signed records, timestamps, and cryptographic proofs that demonstrate integrity and origin. Sound evidence handling is essential for proving non-repudiation and supporting enforcement."@en ;
    rdfs:subClassOf ngm:infra-legal-and-regulatory ;
    skos:broader ngm:infra-legal-and-regulatory ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:evidence-collection,
        ngm:non-repudiation ;
    vc:slug "legal-evidence" ;
    vc:sourceDomain "security" .

ngm:legal-research a owl:Class ;
    rdfs:label "Legal Research"@en ;
    rdfs:comment "Legal research is the systematic process of finding, analysing and applying statutes, case law, regulations and secondary sources to answer a legal question, increasingly assisted by retrieval and language models."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:optical-character-recognition ],
        ngm:artificial-intelligence ;
    skos:broader ngm:artificial-intelligence ;
    vc:enables ngm:regulatory-compliance ;
    vc:hasMaturity ngmi:maturity-established ;
