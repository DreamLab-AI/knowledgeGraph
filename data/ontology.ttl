ngm:soft-body-dynamics a owl:Class ;
    rdfs:label "Soft Body Dynamics"@en ;
    rdfs:comment "Soft Body Dynamics is the branch of physics simulation concerned with deformable objects — including cloth, flesh, elastic materials, vegetation, and fluids — that change shape in response to forces, collisions, and internal stresses. Unlike rigid body simulation, soft body methods must track per-vertex or per-element deformation states, typically using mass-spring networks, finite element methods (FEM), or position-based dynamics (PBD). It is essential for visual fidelity in real-time virtual environments, character animation, and embodied AI simulations."@en ;
    rdfs:subClassOf ngm:metaverse,
        ngm:sc-display-and-rendering ;
    skos:broader ngm:sc-display-and-rendering ;
    vc:enables ngm:3-d-animation,
