        ngm:safety-integrity-level ;
    vc:requires ngm:hazard-analysis,
        ngm:risk-assessment ;
    vc:slug "iec-61511" ;
    vc:sourceDomain "standards" ;
    vc:standardizedBy ngm:iec-61508 ;
    vc:supports ngm:control-system,
        ngm:process-control ;
    vc:uses ngm:scada .

ngm:ieee-vr a owl:Class ;
    rdfs:label "Ieee Vr"@en ;
    rdfs:comment "IEEE VR is the IEEE Conference on Virtual Reality and 3D User Interfaces, the leading international academic venue for research in virtual, augmented and mixed reality. Sponsored by the IEEE, it publishes peer-reviewed work on immersive display, tracking, interaction techniques, perception and applications, and shapes the technical agenda of the field. It functions as both a standardising community and a dissemination channel for spatial-computing research."@en ;
