    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:cross-attention,
        ngm:flash-attention,
        ngm:grouped-query-attention,
        ngm:positional-encoding,
        ngm:self-attention ;
    vc:slug "multi-head-attention" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:neural-network-quantisation a owl:Class ;
    rdfs:label "Neural Network Quantisation"@en ;
    rdfs:comment "A model compression technique that reduces the numerical precision of neural network weights and activations from floating-point (FP32, FP16) to lower-bit integer representations (INT8, INT4, binary), decreasing memory footprint and improving inference speed on hardware with integer arithmetic units. Approaches include post-training quantisation and quantisation-aware training."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:quantisation ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:mixed-precision-training ],
        ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:enables ngm:inference-hardware ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:mixed-precision-training,
        ngm:quantisation ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:knowledge-distillation,
        ngm:knowledge-distillation-for-edge,
        ngm:model-compression-for-edge,
        ngm:model-pruning-for-edge-deployment ;
    vc:slug "neural-network-quantisation" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:machine-learning-model,
        ngm:pretrained-model .

ngm:nft-minting a owl:Class ;
    rdfs:label "NFT Minting"@en ;
    rdfs:comment "NFT Minting is the on-chain or deferred off-chain process by which a unique, indivisible, and cryptographically authenticated digital token—a non-fungible token—is created and permanently recorded on a distributed ledger, establishing irrevocable provenance, ownership, and transferability for a l..."@en ;
