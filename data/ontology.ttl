# AI Risk Management
artificial-intelligence:AiRiskManagement rdf:type owl:Class ;
    rdfs:subClassOf artificial-intelligence:RiskManagement ;
    rdfs:label "AI Risk Management"@en ;
    rdfs:comment "AI Risk Management is the systematic process of identifying, assessing, mitigating, and monitoring risks associated with artificial intelligence systems throughout their lifecycle, integrating AI-specific considerations into broader enterprise risk management frameworks. It encompasses governance structures, assessment methodologies, control mechanisms, and continuous oversight to ensure AI systems operate safely, ethically, and in compliance with regulations."@en ;
    skos:prefLabel "AI Risk Management"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:artificial-intelligence:ai-risk-management" ;
    owl:sameAs <urn:visionclaw:concept:artificial-intelligence:ai-risk-management> ;
    vcw:contentHash "sha256-12-cc495806cc83" ;
    vcw:qualityScore "0.5"^^xsd:decimal ;
    vcw:legacyTermId "AI-7019" ;
    vcw:ontologyStatus "active" ;
    vcw:maturityLevel "mature" ;
    vcw:authorityScore "0.0"^^xsd:decimal ;
    dcterms:identifier "AI-7019" ;
    dcterms:subject "artificial-intelligence" ;
    owl:versionInfo "2.0.0" ;
    dcterms:created "2026-04-26T00:00:00Z"^^xsd:dateTime ;
    dcterms:modified "2026-04-26T13:00:00Z"^^xsd:dateTime ;
    vcw:owlRole "Process" .

artificial-intelligence:AiRiskManagement rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty infrastructure:enables ;
    owl:someValuesFrom artificial-intelligence:TrustworthyAI
] .

artificial-intelligence:AiRiskManagement vcw:bridgesTo artificial-intelligence:SmartContract .

# AI Hardware
artificial-intelligence:AiHardware rdf:type owl:Class ;
    rdfs:subClassOf artificial-intelligence:ComputerHardware ;
    rdfs:label "AI Hardware"@en ;
    rdfs:comment "AI Hardware encompasses specialized computing hardware designed to accelerate artificial intelligence and machine learning workloads, including GPUs, TPUs, NPUs, and other AI accelerators optimized for training neural networks and running inference at scale. These processors feature architectures specifically designed for the matrix operations, parallel processing, and low-precision arithmetic fundamental to modern AI algorithms."@en ;
    skos:prefLabel "AI Hardware"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:artificial-intelligence:ai-hardware" ;
    owl:sameAs <urn:visionclaw:concept:artificial-intelligence:ai-hardware> ;
    vcw:contentHash "sha256-12-3a1209d7c469" ;
    vcw:qualityScore "0.5"^^xsd:decimal ;
    vcw:legacyTermId "AI-7020" ;
    vcw:ontologyStatus "active" ;
    vcw:maturityLevel "mature" ;
    vcw:authorityScore "0.0"^^xsd:decimal ;
