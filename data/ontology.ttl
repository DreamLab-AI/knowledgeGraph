        ngm:gas-price,
        ngm:proof-of-work,
        ngm:tokenomics ;
    vc:requires ngm:block-size,
        ngm:mempool ;
    vc:slug "fee-market" ;
    vc:sourceDomain "blockchain" .

ngm:forward-error-correction a owl:Class ;
    rdfs:label "Forward Error Correction"@en ;
    rdfs:comment "Forward error correction (FEC) is a channel-coding technique in which redundant information is added to a transmitted data stream so that the receiver can detect and correct errors introduced by the channel without requesting retransmission. FEC codes trade bandwidth or storage overhead for improved reliability over noisy or lossy channels, eliminating the round-trip latency penalty of automatic repeat request (ARQ) schemes."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:ldpc-codes ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-redundancy ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:reed-solomon-codes ],
        ngm:channel-coding ;
    vc:bridgesTo ngm:neural-network-decoding,
        ngm:quantum-error-correction ;
    vc:contrastsWith ngm:automatic-repeat-request ;
    vc:dependsOn ngm:algebraic-coding-theory,
        ngm:shannon-information-theory ;
    vc:enables ngm:packet-loss-recovery,
        ngm:real-time-media-streaming,
        ngm:reliable-data-transmission ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:hamming-codes,
        ngm:ldpc-codes,
        ngm:parity-check-matrix,
        ngm:polar-codes,
        ngm:reed-solomon-codes,
        ngm:turbo-codes ;
    vc:implements ngm:error-control-coding ;
    vc:qualityScore "0.85"^^xsd:float ;
    vc:relatedTo ngm:5g-nr,
        ngm:erasure-coding ;
    vc:requires ngm:channel-capacity,
        ngm:data-redundancy ;
    vc:slug "forward-error-correction" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:flash-storage,
        ngm:optical-networking,
        ngm:satellite-communications,
        ngm:telecommunications ;
    vc:uses ngm:belief-propagation,
        ngm:soft-decision-decoding .

ngm:gaussian-process a owl:Class ;
    rdfs:label "Gaussian Process"@en ;
    rdfs:comment "A Gaussian Process (GP) is a non-parametric Bayesian model that defines a probability distribution over functions, fully characterised by a mean function and a covariance (kernel) function, such that any finite collection of function evaluations follows a joint Gaussian distribution. Conditioning the GP prior on observed data yields a closed-form posterior distribution over functions that simultaneously provides point predictions and principled uncertainty estimates. GPs are widely used for regression, classification, surrogate modelling, and as acquisition-function models in Bayesian optimisation, with exact inference scaling cubically in the number of observations and sparse inducing-point approximations enabling scalable variants."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gaussian-distribution ],
        ngm:bayesian-inference ;
    vc:bridgesTo ngm:scientific-computing,
        ngm:spatial-interpolation ;
    vc:contrastsWith ngm:neural-network,
        ngm:random-forest,
        ngm:support-vector-machine ;
    vc:dependsOn ngm:covariance-matrix,
        ngm:hyperparameter-optimisation ;
    vc:enables ngm:active-learning,
        ngm:bayesian-optimisation,
        ngm:gaussian-process-regression,
        ngm:uncertainty-quantification ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:kernel-function,
        ngm:mean-function,
        ngm:posterior-predictive-distribution ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:deep-kernel-learning,
        ngm:hamiltonian-monte-carlo,
        ngm:kriging,
        ngm:sparse-gaussian-process,
        ngm:variational-inference ;
    vc:requires ngm:gaussian-distribution,
        ngm:positive-definite-matrix ;
    vc:slug "gaussian-process" ;
    vc:sourceDomain "machine-learning" ;
    vc:uses ngm:cholesky-decomposition,
        ngm:kernel-methods,
        ngm:marginal-likelihood .

ngm:genesis-block a owl:Class ;
    rdfs:label "Genesis Block"@en ;
    rdfs:comment "The genesis block is the first block in a blockchain, hardcoded into the client software and serving as the immutable anchor from which the entire chain of subsequent blocks descends. It establishes the initial chain state, encodes the founding parameters of the network, and contains no reference to a previous block hash. Because it cannot be altered without invalidating all subsequent blocks, the genesis block is the ultimate root of trust for the distributed ledger."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:block-header ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:coinbase-transaction ],
        [ a owl:Restriction ;
