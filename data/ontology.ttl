ngm:finality a owl:Class ;
    rdfs:label "Finality"@en ;
    rdfs:comment "The property of a blockchain transaction or block whereby it becomes irreversible and cannot be reverted by any future state of the network. Probabilistic finality—as in proof-of-work chains—increases with confirmation depth, while deterministic finality—as in BFT-based protocols—is achieved at the point of commitment, with strong consequences for payment settlement, cross-chain interoperability, and user trust."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:probabilistic-finality ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:consensus-protocol ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:transaction-finality ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptographic-signature ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:transaction-confirmation ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:deterministic-finality ],
        ngm:bc-protocol-and-consensus ;
    skos:broader ngm:bc-protocol-and-consensus ;
    vc:bridgesTo ngm:legal-finality,
        ngm:settlement-finality ;
    vc:contrastsWith ngm:chain-reorganization,
        ngm:double-spend-attack,
        ngm:fork ;
    vc:dependsOn ngm:byzantine-fault-tolerance,
        ngm:network-synchrony ;
    vc:enables ngm:atomic-swap,
        ngm:cross-chain-interoperability,
        ngm:payment-settlement,
        ngm:smart-contract-execution ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:deterministic-finality,
        ngm:economic-finality,
        ngm:probabilistic-finality,
        ngm:transaction-finality ;
    vc:isPartOf ngm:blockchain-security-model,
        ngm:consensus-mechanism ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:blockchain-transaction,
        ngm:byzantine-agreement,
        ngm:nakamoto-consensus,
        ngm:proof-of-stake,
        ngm:tendermint ;
    vc:requires ngm:consensus-protocol,
        ngm:cryptographic-signature,
        ngm:transaction-confirmation,
        ngm:validator-quorum ;
    vc:slug "finality" ;
    vc:sourceDomain "blockchain" .

ngm:financial-inclusion a owl:Class ;
    rdfs:label "Financial Inclusion"@en ;
    rdfs:comment "Financial inclusion is the policy objective and market condition in which individuals and businesses — particularly those in underserved, low-income, or geographically remote populations — have affordable, reliable access to a full range of financial services encompassing payments, credit, savings, insurance, and investment. It is pursued through regulatory reform, technology-led delivery (mobile money, digital wallets, open banking APIs), and identity infrastructure, aiming to integrate marginalised groups into the formal economy. Key enablers include tiered Know Your Customer frameworks, agent banking networks, interoperable payment rails, and programmable money mechanisms such as Central Bank Digital Currencies and regulated stablecoins. Progress is measured through account ownership rates, transaction volume among previously unbanked populations, and composite indices such as the World Bank Global Findex."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:interoperability ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:digital-identity ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:kyc-aml ],
        ngm:financial-services ;
    vc:bridgesTo ngm:blockchain,
        ngm:self-sovereign-identity ;
    vc:contrastsWith ngm:financial-exclusion,
        ngm:predatory-lending ;
    vc:dependsOn ngm:payment-infrastructure,
        ngm:regulatory-framework ;
    vc:enables ngm:digital-payments,
        ngm:economic-development,
        ngm:microfinance,
        ngm:mobile-money ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:central-bank-digital-currency,
        ngm:decentralised-finance,
        ngm:fintech,
        ngm:remittance ;
    vc:requires ngm:digital-identity,
        ngm:interoperability,
        ngm:kyc-aml,
        ngm:mobile-internet ;
    vc:slug "financial-inclusion" ;
    vc:sourceDomain "finance" ;
    vc:standardizedBy ngm:financial-action-task-force,
        ngm:g20-global-partnership-for-financial-inclusion ;
    vc:supports ngm:gender-equality,
        ngm:poverty-reduction,
        ngm:sustainable-development-goals ;
    vc:uses ngm:agent-banking,
        ngm:biometric-authentication,
        ngm:open-banking,
        ngm:stablecoin .

ngm:inference-engine a owl:Class ;
    rdfs:label "Inference Engine"@en ;
    rdfs:comment "An Inference Engine is a specialised software runtime optimised for executing trained machine learning models in production environments, transforming input data into predictions, classifications, embeddings, or generated content with primary objectives of minimising latency, maximising throughput, and efficiently utilising hardware accelerators such as GPUs, TPUs, and NPUs. Inference engines apply techniques including operator fusion, kernel auto-tuning, mixed-precision quantisation, and memory layout optimisation to close the performance gap between a training-time model representation and optimal hardware utilisation. They typically accept models in portable interchange formats such as ONNX or TensorRT engine plans, decoupling model architecture from the serving runtime, and are deployed within MLOps pipelines to serve AI applications at production scale. Modern inference engines address both traditional deep learning models (CNNs, transformers for classification and detection) and large language model serving, where techniques such as continuous batching, paged KV-cache management, and speculative decoding are critical to economic viability."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:quantisation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:hardware-acceleration ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:machine-learning-discipline-model ],
        ngm:inference ;
    vc:contrastsWith ngm:eager-execution,
        ngm:training-framework ;
    vc:dependsOn ngm:gpu-computing,
        ngm:inference-hardware,
        ngm:tensor-processing-unit ;
    vc:enables ngm:ai-deployment,
        ngm:large-language-model-serving,
        ngm:real-time-inference-at-edge ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:dynamic-batching,
        ngm:kernel-auto-tuning,
        ngm:operator-fusion,
        ngm:quantisation ;
    vc:isPartOf ngm:ai-deployment,
        ngm:mlops ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:kv-cache,
        ngm:latency,
        ngm:model-compression,
        ngm:neural-processing-unit,
        ngm:throughput ;
    vc:requires ngm:hardware-acceleration,
        ngm:machine-learning-discipline-model ;
    vc:slug "inference-engine" ;
    vc:sourceDomain "ai" ;
    vc:supports ngm:edge-computing,
        ngm:mlops ;
    vc:uses ngm:compute-unified-device-architecture,
        ngm:onnx,
        ngm:speculative-decoding .

