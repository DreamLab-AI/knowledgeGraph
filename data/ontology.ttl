ngm:libp2p a owl:Class ;
    rdfs:label "libp2p"@en ;
    rdfs:comment "libp2p is a modular network stack and peer-to-peer networking framework originally extracted from the IPFS project that enables developers to build decentralised applications with configurable transport, security, and protocol multiplexing layers. It abstracts over TCP, QUIC, WebSocket, and WebRTC transports, applies encryption via Noise Protocol or TLS 1.3, multiplexes streams with Yamux or mplex, and provides peer discovery, routing, and publish-subscribe messaging as composable modules. libp2p powers the peer layer of Ethereum 2.0, Filecoin, Polkadot, and hundreds of other decentralised systems, providing a battle-tested foundation for production-grade peer-to-peer networking."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:transport-layer ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:noise-protocol ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:public-key-infrastructure ],
        ngm:peer-to-peer-network ;
    vc:bridgesTo ngm:decentralized-identity ;
    vc:contrastsWith ngm:bittorrent-protocol ;
    vc:dependsOn ngm:distributed-hash-table,
        ngm:kademlia-dht,
        ngm:quic ;
    vc:enables ngm:blockchain-network,
        ngm:decentralized-application,
        ngm:decentralized-storage ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:noise-protocol ;
    vc:implements ngm:peer-discovery,
        ngm:publish-subscribe-pattern,
        ngm:stream-multiplexing ;
    vc:isPartOf ngm:ipfs ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:content-addressed-storage,
        ngm:gossip-protocol ;
    vc:requires ngm:public-key-infrastructure,
        ngm:transport-layer ;
    vc:slug "libp2p" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:ethereum,
        ngm:filecoin,
        ngm:polkadot ;
    vc:uses ngm:congestion-control,
        ngm:cryptographic-protocol,
        ngm:web-rtc .

ngm:liquidity-provider a owl:Class ;
    rdfs:label "Liquidity Provider"@en ;
    rdfs:comment "A liquidity provider is an entity — individual, institution, or automated protocol participant — that deposits assets into a trading venue or liquidity pool to enable others to execute trades, receiving fee income or other incentives in return. In decentralised finance, liquidity providers supply token pairs to automated market makers, receiving LP tokens representing their proportional pool share."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:wallet ],
        ngm:decentralized-finance-de-fi ;
    vc:bridgesTo ngm:real-world-asset,
        ngm:traditional-finance ;
    vc:contrastsWith ngm:order-book ;
    vc:dependsOn ngm:blockchain,
        ngm:price-oracle ;
    vc:enables ngm:market-depth,
        ngm:price-discovery,
        ngm:trade-execution ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:liquidity-position ;
