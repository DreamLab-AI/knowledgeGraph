ngm:non-repudiation a owl:Class ;
    rdfs:label "Non-Repudiation"@en ;
    rdfs:comment "Non-Repudiation is a foundational Information Security property and legal-technical assurance mechanism that renders it cryptographically and evidentially impossible for a party that originated, received, or approved a message, transaction, or data object to subsequently deny that partici..."@en ;
