    vc:requires ngm:test-data-management ;
    vc:slug "testing-process" ;
    vc:sourceDomain "spatial-computing" .

ngm:texture-atlas a owl:Class ;
    rdfs:label "Texture Atlas"@en ;
    rdfs:comment "A texture atlas is a single large image that packs many smaller textures or sprites into one bitmap, accompanied by coordinate metadata mapping each sub-image to a region of the atlas. By consolidating textures, it lets a renderer draw many objects that share one bound texture, reducing state changes and draw calls and improving GPU efficiency in real-time graphics. UV coordinates of meshes are remapped to address sub-regions within the atlas. It is widely used in game engines, 2D sprite rendering, and font glyph caching to optimise throughput on the graphics pipeline."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gpu ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:uv-mapping ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:uv-mapping ],
        ngm:real-time-rendering ;
    vc:enables ngm:batching,
        ngm:level-of-detail ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:uv-mapping ;
    vc:isPartOf ngm:game-engine ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:rendering,
        ngm:shader,
        ngm:spatial-computing ;
    vc:requires ngm:gpu,
        ngm:uv-mapping ;
    vc:slug "texture-atlas" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:computer-graphics,
        ngm:real-time-rendering ;
    vc:uses ngm:batching,
        ngm:shader .

ngm:third-party-auditor a owl:Class ;
    rdfs:label "Third Party Auditor"@en ;
    rdfs:comment "An independent security firm or organization that conducts comprehensive reviews of smart contracts, blockchain protocols, and digital systems to identify vulnerabilities, ensure code quality, and verify compliance before deployment."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:smart-contract ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:vulnerability ],
        ngm:sc-governance-and-safety,
        ngm:security-services ;
    skos:broader ngm:sc-governance-and-safety ;
    vc:enables ngm:audit-trail,
        ngm:compliance-verification ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires ngm:smart-contract,
        ngm:vulnerability ;
    vc:slug "third-party-auditor" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:blockchain,
        ngm:risk-assessment .

ngm:tool-definition a owl:Class ;
    rdfs:label "Tool Definition"@en ;
    rdfs:comment "A Tool Definition is a structured specification that describes a capability that an AI language model or agent can invoke at runtime, including the tool's name, a natural language description of its purpose, and a formal schema defining its input parameters and expected output format. Tool definitions are the primary mechanism through which AI systems access external functionality, enabling them to call APIs, query databases, execute code, retrieve documents, or perform actions in the world beyond text generation. The format of tool definitions is standardised by providers such as Anthropic, OpenAI, and Google, typically using JSON Schema to describe parameters, and the quality of a tool definition's description and schema directly determines how reliably an AI model selects and invokes it."@en ;
    rdfs:subClassOf ngm:tool-schema ;
    vc:enables ngm:agentic-workflow,
        ngm:autonomous-agent ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:function-calling,
        ngm:json-data-interchange-format-schema,
        ngm:tool-use ;
    vc:slug "tool-definition" ;
    vc:sourceDomain "ai" ;
    vc:supports ngm:multi-agent-systems ;
    vc:uses ngm:function-calling,
        ngm:schema-definition .

ngm:tor a owl:Class ;
    rdfs:label "Tor"@en ;
    rdfs:comment "A free overlay network and software that provides anonymous communication by routing traffic through a series of volunteer-operated relays using layered encryption, enabling censorship resistance, traffic-analysis resistance, and onion service hosting."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:public-key-cryptography ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:encryption ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:relay-network ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:onion-routing ],
        ngm:onion-routing ;
    vc:bridgesTo ngm:distributed-systems,
        ngm:infrastructure ;
    vc:contrastsWith ngm:i2p,
        ngm:vpn ;
    vc:enables ngm:anonymity,
        ngm:censorship-resistance,
        ngm:onion-services,
        ngm:privacy,
        ngm:traffic-analysis-resistance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:onion-routing ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:dark-web,
        ngm:network-security,
        ngm:surveillance ;
    vc:requires ngm:encryption,
        ngm:onion-routing,
        ngm:public-key-cryptography,
        ngm:relay-network ;
    vc:slug "tor" ;
    vc:sourceDomain "security" ;
    vc:uses ngm:transport-layer-security .

ngm:torque-sensor a owl:Class ;
    rdfs:label "Torque Sensor"@en ;
    rdfs:comment "A torque sensor is a transducer that measures the rotational force, or torque, applied about an axis, commonly at a robot joint or drive shaft. By reporting the load a joint experiences, it enables force control, compliance, collision detection, and safe physical interaction between robots and humans. Torque sensors typically use strain gauges bonded to a deformable element whose deflection is proportional to the applied moment."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:actuator ],
        ngm:robot-sensor ;
    vc:bridgesTo ngm:proprioceptive-sensing ;
    vc:dependsOn ngm:robot-joint ;
    vc:enables ngm:feedback-control,
        ngm:force-control,
        ngm:safety-system ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:strain-gauge_note ;
    vc:isPartOf ngm:robot-joint,
        ngm:robot-sensor ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:force-feedback,
        ngm:haptic-feedback,
        ngm:kinematics ;
    vc:requires ngm:actuator ;
    vc:slug "torque-sensor" ;
    vc:sourceDomain "robotics" ;
    vc:supports ngm:human-robot-interaction,
        ngm:manipulation ;
    vc:uses ngm:sensor .

ngm:training-data-distribution a owl:Class ;
    rdfs:label "Training Data Distribution"@en ;
    rdfs:comment "Training data distribution refers to the statistical properties and compositional characteristics of the dataset used to train a machine learning model, including the relative frequencies of classes, the coverage of input feature space, the presence of rare or tail events, and the demographic or domain balance of examples. The training data distribution determines what patterns a model can learn, what it will generalise from, and where it will fail: a model trained on a distribution that differs from the deployment distribution will exhibit degraded performance due to covariate shift or prior probability shift. Deliberate control of training data distribution — through curation, resampling, augmentation, and synthetic data generation — is a primary lever for improving model robustness, fairness, and safety."@en ;
    rdfs:subClassOf ngm:training-data ;
    vc:enables ngm:machine-learning-discipline,
        ngm:training-dataset ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:algorithmic-bias,
        ngm:bias,
        ngm:domain-adaptation,
        ngm:fairness ;
    vc:slug "training-data-distribution" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:data-augmentation-strategies,
        ngm:data-collection,
        ngm:synthetic-data .

ngm:transaction-privacy a owl:Class ;
    rdfs:label "Transaction Privacy"@en ;
    rdfs:comment "Transaction privacy is the property of a payment or ledger system that conceals sensitive details of a transaction, such as sender, receiver and amount, from third parties while preserving verifiability of correctness. On public blockchains it is achieved through cryptographic techniques that prove a transaction is valid without revealing its contents. It addresses the inherent transparency of open ledgers, trading off auditability and regulatory visibility against confidentiality."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:stealth-address ],
        ngm:privacy-preserving-computation ;
    vc:bridgesTo ngm:monero ;
    vc:contrastsWith ngm:beneficial-ownership ;
    vc:dependsOn ngm:zero-knowledge-proof ;
    vc:enables ngm:confidential-transactions,
        ngm:shielded-transaction ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:stealth-address ;
    vc:implements ngm:privacy-preserving-computation ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:confidential-transactions,
        ngm:zcash ;
    vc:slug "transaction-privacy" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:privacy-coin ;
    vc:uses ngm:zero-knowledge-proof,
        ngm:zk-snark .

ngm:translation a owl:Class ;
    rdfs:label "Translation"@en ;
    rdfs:comment "Machine Translation (MT) is the automated conversion of natural language text or speech from a source language into semantically and pragmatically equivalent target language output, evolving from rule-based symbolic approaches (RBMT, 1950s-1990s) through statistical phrase-based models (SMT, Mose..."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:encoder ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:tokeniser ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:parallel-corpus ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:parallel-corpus ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:language-model ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
