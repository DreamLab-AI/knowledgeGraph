ngm:disparate-impact a owl:Class ;
    rdfs:label "Disparate Impact"@en ;
    rdfs:comment "Disparate Impact is a legal doctrine and AI fairness concept denoting the condition where a facially neutral policy, practice, or algorithmic decision system produces outcomes that disproportionately disadvantage a legally protected group relative to a comparator group, regardless of discriminatory intent. Measured via the four-fifths rule or statistical significance tests, it is legally actionable in employment (US EEOC guidelines), lending, housing, and insurance, and is the analytical basis for algorithmic bias audits under the EU AI Act and GDPR. Remediation requires either demonstrating business necessity or adopting less discriminatory alternatives."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:bias-detection-methods ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:fairness-metrics ],
        ngm:ai-fairness,
        ngm:ai-governance-and-ethics ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:contrastsWith ngm:fairness-accuracy-tradeoffs,
        ngm:group-vs-individual-fairness ;
    vc:enables ngm:algorithmic-accountability,
        ngm:fairness-auditing-tools ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:algorithmic-bias,
        ngm:bias-mitigation-techniques,
        ngm:diversity-non-discrimination-and-fairness,
        ngm:harmful-bias,
        ngm:intersectional-fairness,
        ngm:regulatory-compliance ;
    vc:requires ngm:bias-detection-methods,
        ngm:fairness-metrics ;
    vc:slug "disparate-impact" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:display-metrology a owl:Class ;
    rdfs:label "Display Metrology"@en ;
    rdfs:comment "Standardized measurement equipment and instruments for assessing visual performance parameters of XR displays, including colorimeters, photometers, and specialised testing hardware."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:resolution-test-chart ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:calibration-standards ],
        ngm:sc-display-and-rendering,
        ngm:xr-testing-infrastructure ;
    skos:broader ngm:sc-display-and-rendering ;
    vc:enables ngm:compliance-testing,
        ngm:display-calibration,
        ngm:performance-validation,
        ngm:visual-quality-assessment ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:colorimeter,
        ngm:contrast-ratio-meter,
        ngm:luminance-meter,
        ngm:photometer,
        ngm:resolution-test-chart ;
    vc:isPartOf ngm:xr-testing-infrastructure ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:calibration-standards,
        ngm:environmental-control,
        ngm:measurement-protocols ;
    vc:slug "display-metrology" ;
    vc:sourceDomain "spatial-computing" .

ngm:do-ra a owl:Class ;
    rdfs:label "DoRA"@en ;
    rdfs:comment "DoRA (Weight-Decomposed Low-Rank Adaptation) is a parameter-efficient fine-tuning method that decomposes pretrained weights into separate magnitude and direction components, applying low-rank updates only to the directional component while learning the magnitude independently. By separating these two degrees of freedom, DoRA more closely mirrors the learning dynamics of full fine-tuning than standard LoRA, improving accuracy on many tasks at comparable parameter cost and without added inference latency once merged. It is used to adapt large language and vision models efficiently."@en ;
    rdfs:subClassOf ngm:parameter-efficient-fine-tuning ;
    vc:enables ngm:fine-tuning ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:deep-learning,
        ngm:transformer ;
    vc:slug "do-ra" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:low-rank-adaptation .

ngm:dynamical-systems a owl:Class ;
    rdfs:label "Dynamical Systems"@en ;
    rdfs:comment "Dynamical systems is the mathematical study of how the state of a system evolves over time according to fixed rules. It applies to physics, biology, engineering, and control."@en ;
    rdfs:subClassOf ngm:owl-thing ;
    vc:enables ngm:control-theory ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:slug "dynamical-systems" ;
    vc:sourceDomain "general" .

ngm:e-contract-arbitration a owl:Class ;
    rdfs:label "E-Contract Arbitration"@en ;
    rdfs:comment "Online dispute resolution process specifically designed for resolving conflicts arising from smart contract execution, code interpretation, or automated transaction failures."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:arbitration-decision-engine ],
