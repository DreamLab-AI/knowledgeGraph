ngm:notion a owl:Class ;
    rdfs:label "Notion"@en ;
    rdfs:comment "Notion is a cloud-based productivity and knowledge-management platform that unifies note-taking, relational databases, wikis, project management boards, and document editing into a single composable workspace. Its block-based editor treats every content element — text, tables, embeds, code, and media — as a manipulable unit that can be nested, linked, and filtered, enabling teams to construct custom workflows without traditional software development. Notion serves as an all-in-one tool replacing multiple specialised SaaS products for many knowledge workers and organisations. Since 2023 Notion has integrated generative AI capabilities directly into its editing and querying workflows."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:kanban-board ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cloud-infrastructure ],
        ngm:knowledge-management-system ;
    vc:bridgesTo ngm:artificial-intelligence,
        ngm:enterprise-software ;
    vc:contrastsWith ngm:confluence,
        ngm:microsoft-loop,
        ngm:obsidian ;
    vc:enables ngm:asynchronous-collaboration,
        ngm:internal-documentation,
        ngm:no-code-workflow,
        ngm:project-management,
        ngm:shared-knowledge-base ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:kanban-board,
        ngm:relational-database,
        ngm:wiki ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:collaboration-platform,
        ngm:knowledge-base,
        ngm:knowledge-management,
        ngm:personal-knowledge-management ;
    vc:requires ngm:cloud-infrastructure,
        ngm:internet-connectivity ;
    vc:slug "notion" ;
    vc:sourceDomain "distributed-collaboration" ;
    vc:supports ngm:distributed-team,
        ngm:remote-work ;
    vc:uses ngm:api-integration,
        ngm:block-based-editor,
        ngm:database-system,
        ngm:generative-ai,
        ngm:rest-api .

ngm:nuclear-energy a owl:Class ;
    rdfs:label "Nuclear Energy"@en ;
    rdfs:comment "Nuclear energy is electrical power generated by harnessing the heat released from nuclear fission of heavy isotopes, typically uranium-235, in a controlled reactor. It provides high-density, low-carbon, dispatchable baseload generation independent of weather conditions. Its role in decarbonisation is balanced against concerns over capital cost, long construction times, radioactive-waste management, and safety."@en ;
    rdfs:subClassOf ngm:sustainability ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:energy-and-power ;
