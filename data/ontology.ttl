ngm:gs-1-standards a owl:Class ;
    rdfs:label "GS1 Standards"@en ;
    rdfs:comment "GS1 Standards constitute a globally adopted, open framework of identification keys, data carriers (barcodes and RFID tags), and messaging formats that uniquely and unambiguously identify physical and digital entities — products, logistics units, locations, assets, and services — across entire supply chain ecosystems. Governed by GS1, a neutral non-profit organisation with national member organisations in over 115 countries, the standards define how identifiers are structured (e.g. GTIN, GLN, SSCC), how they are encoded for machine reading (EAN/UPC, GS1-128, QR, DataMatrix, EPC/RFID), and how master and transactional data are shared between trading partners via EDI and web services. GS1 Standards form the interoperability backbone of global retail, healthcare, logistics, foodservice, and increasingly digital product passport and IoT applications."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:open-standards ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-governance ],
        ngm:standards ;
    vc:bridgesTo ngm:linked-data,
        ngm:semantic-web,
        ngm:verifiable-credentials ;
    vc:contrastsWith ngm:proprietary-identification ;
    vc:enables ngm:digital-product-passport,
        ngm:inventory-management,
        ngm:product-traceability,
        ngm:supply-chain ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:ean-barcode,
        ngm:electronic-product-code,
        ngm:global-location-number,
        ngm:global-trade-item-number,
        ngm:gs1-digital-link,
        ngm:serial-shipping-container-code ;
    vc:implements ngm:electronic-data-interchange,
        ngm:epcis ;
    vc:qualityScore "0.76"^^xsd:float ;
    vc:relatedTo ngm:data-synchronisation,
        ngm:iso-standards,
        ngm:product-master-data ;
    vc:requires ngm:data-governance,
        ngm:open-standards ;
    vc:slug "gs-1-standards" ;
    vc:sourceDomain "standards" ;
    vc:standardizedBy ngm:gs1-organisation ;
    vc:supports ngm:internet-of-things,
        ngm:interoperability,
        ngm:regulatory-compliance ;
    vc:uses ngm:barcode,
        ngm:qr-code,
        ngm:rfid .

ngm:gs1-epcis a owl:Class ;
    rdfs:label "GS1 EPCIS"@en ;
    rdfs:comment "GS1 EPCIS (Electronic Product Code Information Services) is a global standard that defines a common data model and interface for capturing and sharing supply-chain visibility events, answering what, when, where, why, and how for product movements. It standardises event-based traceability across trading partners using GS1 identifiers. EPCIS is widely deployed in pharmaceuticals, food safety, and logistics to enable end-to-end provenance."@en ;
    rdfs:subClassOf ngm:technical-standard ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:cold-chain-monitoring ;
    vc:slug "gs1-epcis" ;
    vc:sourceDomain "supply-chain" .

ngm:harm-taxonomy a owl:Class ;
    rdfs:label "Harm Taxonomy"@en ;
    rdfs:comment "A harm taxonomy is a structured classification of the potential negative impacts arising from a technology, used to organise risk assessment and mitigation. In AI it categorises harms such as misinformation, discrimination, privacy violation, manipulation, and physical or economic damage. A clear taxonomy enables systematic red-teaming, policy mapping, and accountability for deployed systems."@en ;
    rdfs:subClassOf ngm:ai-governance-and-ethics ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:ai-risks,
        ngm:digital-society-harms ;
    vc:slug "harm-taxonomy" ;
    vc:sourceDomain "governance" .

ngm:harmonic-drive a owl:Class ;
    rdfs:label "Harmonic Drive"@en ;
    rdfs:comment "A harmonic drive is a strain-wave gearing mechanism that achieves very high reduction ratios in a compact, lightweight package with near-zero backlash. It uses a flexible spline deformed by an elliptical wave generator to mesh with a rigid outer gear, transmitting motion with high precision. Harmonic drives are widely used in robot joints, where accuracy and torque density are critical."@en ;
    rdfs:subClassOf ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:mechanical-component ;
    vc:slug "harmonic-drive" ;
    vc:sourceDomain "robotics" .

ngm:hashcash a owl:Class ;
    rdfs:label "Hashcash"@en ;
    rdfs:comment "Hashcash is a proof-of-work system invented by Adam Back in 1997 that requires a sender to compute a partial SHA-1 (later SHA-256) hash collision by finding a nonce such that the resulting digest has a specified number of leading zero bits. The asymmetry between expensive computation and cheap verification makes it suitable as an anti-abuse token: the sender bears a measurable cost while the recipient verifies in microseconds. Originally designed to combat email spam and denial-of-service attacks, the mechanism was directly adopted by Bitcoin as the basis of its mining consensus algorithm, making Hashcash one of the foundational primitives of the blockchain era."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:sha-256 ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:nonce ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptographic-hash-function ],
        ngm:proof-of-work ;
    vc:bridgesTo ngm:blockchain,
        ngm:distributed-consensus ;
    vc:contrastsWith ngm:captcha,
        ngm:proof-of-space,
        ngm:proof-of-stake ;
    vc:enables ngm:bitcoin-mining,
        ngm:denial-of-service-protection,
        ngm:rate-limiting,
        ngm:spam-prevention ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:computational-puzzle,
        ngm:proof-of-work ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:bitcoin-protocol,
        ngm:consensus-mechanism,
        ngm:difficulty-adjustment,
        ngm:merkle-tree,
        ngm:mining ;
    vc:requires ngm:cryptographic-hash-function,
        ngm:nonce,
        ngm:sha-256 ;
    vc:slug "hashcash" ;
    vc:sourceDomain "security" ;
    vc:supports ngm:email-security,
        ngm:sybil-resistance ;
    vc:uses ngm:hash-function,
        ngm:preimage-resistance .

