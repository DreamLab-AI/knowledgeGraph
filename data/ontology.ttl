    vc:isPartOf ngm:metaverse ;
    vc:qualityScore "0.68"^^xsd:float ;
    vc:relatedTo ngm:collaboration,
        ngm:digital-twin ;
    vc:requires ngm:real-time-networking,
        ngm:user-authentication,
        ngm:virtual-reality-vr ;
    vc:slug "social-vr" ;
