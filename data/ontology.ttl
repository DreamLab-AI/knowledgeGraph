ngm:motion-control a owl:Class ;
    rdfs:label "Motion Control"@en ;
    rdfs:comment "MotionControl is the discipline governing the coordinated generation and execution of actuator commands that transform high-level kinematic or task-space specifications into precise, smooth, and dynamically consistent robot motion through the integrated chain of trajectory generation, servo-loop ..."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
