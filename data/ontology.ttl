            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ontology ],
        ngm:ai-application ;
    skos:broader ngm:ai-application ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:relatedTo ngm:knowledge-representation,
