        ngm:reference-space .

ngm:weight-decay a owl:Class ;
    rdfs:label "Weight Decay"@en ;
    rdfs:comment "A regularisation technique that adds a penalty proportional to the L2 norm of model weights to the loss function, discouraging large weight magnitudes and thereby limiting model complexity. Weight decay prevents overfitting, promotes simpler generalisable solutions, and in optimisers such as AdamW is implemented directly in the weight update step rather than via loss augmentation."@en ;
    rdfs:subClassOf ngm:ai-technique,
        ngm:machine-learning-discipline-technique ;
    skos:broader ngm:ai-technique ;
    vc:contrastsWith ngm:dropout ;
    vc:enables ngm:regularisation ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:training ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:slug "weight-decay" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:gradient-descent,
        ngm:optimiser .

ngm:wheeled-mobile-robot a owl:Class ;
    rdfs:label "Wheeled Mobile Robot"@en ;
    rdfs:comment "A mobile robot that uses wheels as its primary locomotion mechanism, enabling efficient navigation on flat or structured surfaces. Wheeled mobile robots span applications from industrial logistics and warehouse automation to outdoor infrastructure maintenance, typically combining SLAM-based navigation, sensor fusion, and modular payloads."@en ;
    rdfs:subClassOf ngm:robo-robot-type ;
    skos:broader ngm:robo-robot-type ;
    vc:enables ngm:autonomous-navigation,
        ngm:digital-twin ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:mobile-robot,
        ngm:robotics ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:slug "wheeled-mobile-robot" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:robot-operating-system,
        ngm:sensor-fusion,
        ngm:slam .

ngm:wheeled-robot a owl:Class ;
    rdfs:label "Wheeled Robot"@en ;
    rdfs:comment "A Wheeled Robot is a mobile robot platform that uses wheels as its primary locomotion mechanism. Wheeled robots offer high energy efficiency and speed on flat terrain, making them dominant in warehouse automation, last-mile delivery, and research platforms. Differential drive, omnidirectional, and car-like Ackermann steering configurations each present distinct kinematic constraints that influence navigation algorithm design."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:navigation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:odometry ],
        ngm:robo-robot-type ;
    skos:broader ngm:robo-robot-type ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:mobile-robot ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:navigation,
        ngm:odometry ;
    vc:slug "wheeled-robot" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:robot-operating-system,
        ngm:slam .

ngm:wiener-process a owl:Class ;
    rdfs:label "Wiener Process"@en ;
    rdfs:comment "The Wiener process, also called standard Brownian motion, is a continuous-time stochastic process characterised by independent, stationary, normally distributed increments starting at zero, with continuous but nowhere-differentiable sample paths. It is the canonical mathematical model of random continuous motion and the foundational driver of stochastic calculus and diffusion equations. The Wiener process underpins models in finance, physics, and the noise schedules of diffusion generative models."@en ;
    rdfs:subClassOf ngm:optimisation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:generative-model,
        ngm:stochastic-process ;
    vc:slug "wiener-process" ;
    vc:sourceDomain "data" .

ngm:working-memory a skos:Concept ;
    rdfs:label "Working Memory"@en .

ngm:wormhole a owl:Class ;
    rdfs:label "Wormhole"@en ;
    rdfs:comment "Wormhole is a decentralised, generic cross-chain messaging and asset-transfer protocol that connects heterogeneous blockchain networks by relying on a permissioned guardian network whose supermajority attestations produce signed Verified Action Approval (VAA) messages. On-chain core contracts on each supported network verify VAAs to lock, mint, or burn assets and to route arbitrary data payloads, making Wormhole a general-purpose interoperability layer rather than a simple token bridge. Originally launched in 2020 as a Solana–Ethereum wrapped-asset bridge by Certus One, it has expanded to support over 30 layer-1 and layer-2 ecosystems under stewardship of the independent Wormhole Foundation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:validator-node ],
        ngm:cross-chain-bridge ;
    vc:bridgesTo ngm:intent-based-bridging,
        ngm:zero-knowledge-proof ;
    vc:contrastsWith ngm:axelar,
        ngm:ibc-protocol,
        ngm:layerzero,
        ngm:light-client-bridge ;
    vc:enables ngm:cross-chain-asset-transfer,
        ngm:cross-chain-messaging,
        ngm:nft-bridging,
        ngm:token-bridging ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:multichain-ecosystem ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:blockchain-interoperability,
        ngm:cross-chain-interoperability,
        ngm:decentralised-finance,
        ngm:governance-token,
        ngm:oracle-network ;
    vc:requires ngm:event-log,
        ngm:quorum-consensus,
        ngm:validator-node ;
    vc:slug "wormhole" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:guardian-network,
        ngm:lock-and-mint-mechanism,
        ngm:multisignature-scheme,
        ngm:smart-contract .

ngm:x509-certificate a skos:Concept ;
    rdfs:label "X509 Certificate"@en .

