        ngm:service-oriented-architecture .

ngm:capability-evaluation a owl:Class ;
    rdfs:label "Capability Evaluation"@en ;
    rdfs:comment "Capability evaluation is the systematic measurement of what an AI model can do, especially the elicitation and assessment of potentially dangerous capabilities such as autonomous replication, cyber-offence, or assistance with weapons. It combines benchmarks, structured tasks, and adversarial elicitation (including red-teaming) to establish upper bounds on model behaviour under best-effort prompting and tooling. Results feed safety cases and trigger the thresholds defined in responsible scaling and preparedness frameworks."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:model-evaluation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:red-teaming ],
        ngm:ai-evaluation ;
    vc:bridgesTo ngm:responsible-scaling-policy,
        ngm:safety-evaluation ;
    vc:contrastsWith ngm:safety-evaluation ;
    vc:enables ngm:ai-safety,
        ngm:responsible-scaling-policy ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:ai-evaluation,
        ngm:ai-safety ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:ai-agent,
        ngm:alignment,
        ngm:large-language-model ;
    vc:requires ngm:model-evaluation,
        ngm:red-teaming ;
    vc:slug "capability-evaluation" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:alignment,
        ngm:interpretability ;
    vc:uses ngm:model-evaluation,
        ngm:red-teaming,
        ngm:safety-evaluation .

ngm:cdn a owl:Class ;
    rdfs:label "CDN"@en ;
    rdfs:comment "A Content Delivery Network (CDN) is a geographically distributed network of proxy servers and data centres that caches and serves web content from locations physically close to end users, reducing latency, relieving origin server load, and improving resilience against traffic spikes and denial-of-service attacks. CDNs operate through anycast routing, edge caching policies, and real-time traffic steering algorithms to deliver optimal user experience across diverse network conditions."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:load-balancing ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:web-application-firewall ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:origin-server ],
        ngm:content-delivery-network ;
    vc:bridgesTo ngm:distributed-systems,
        ngm:machine-learning ;
    vc:contrastsWith ngm:peer-to-peer-network ;
    vc:dependsOn ngm:cloud-infrastructure ;
    vc:enables ngm:bandwidth-optimization,
        ngm:ddos-mitigation,
        ngm:latency,
        ngm:serverless-architecture ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:point-of-presence,
        ngm:web-application-firewall ;
    vc:isPartOf ngm:internet-infrastructure ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:cloud-infrastructure,
        ngm:content-delivery-network-cdn,
        ngm:http-caching,
        ngm:internet-infrastructure ;
    vc:requires ngm:load-balancing,
        ngm:origin-server ;
    vc:slug "cdn" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:adaptive-bitrate-streaming,
        ngm:api-gateway,
        ngm:video-streaming ;
    vc:uses ngm:anycast-routing,
        ngm:dns,
        ngm:edge-computing,
        ngm:network-protocol,
        ngm:network-security,
        ngm:tls .

ngm:chaos-engineering a owl:Class ;
    rdfs:label "Chaos Engineering"@en ;
    rdfs:comment "Chaos engineering is the discipline of experimenting on a software system by deliberately injecting controlled faults — such as instance termination, network latency, or resource exhaustion — in order to build confidence in the system's ability to withstand turbulent, real-world conditions. Practitioners form a hypothesis about steady-state behaviour, introduce a failure in production or production-like environments, and observe whether the system maintains its service level. Originating with Netflix's Chaos Monkey, the practice surfaces hidden dependencies and weaknesses before they cause outages, complementing observability and resilient design."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:incident-response ],
        ngm:site-reliability-engineering ;
    vc:bridgesTo ngm:disaster-recovery,
        ngm:game-day ;
    vc:contrastsWith ngm:traditional-qa-testing ;
    vc:dependsOn ngm:monitoring,
        ngm:observability ;
    vc:enables ngm:fault-tolerance,
        ngm:high-availability ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:blast-radius-control,
        ngm:fault-injection,
        ngm:steady-state-hypothesis ;
    vc:isPartOf ngm:resilience-engineering ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:reliability,
        ngm:service-level-objective ;
    vc:requires ngm:incident-response ;
    vc:slug "chaos-engineering" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:distributed-systems,
        ngm:resilient-architecture ;
    vc:uses ngm:chaos-monkey,
        ngm:fault-injection .

ngm:chatbot a owl:Class ;
    rdfs:label "Chatbot"@en ;
    rdfs:comment "A software application designed to simulate conversation with human users, processing natural-language input through rule-based, retrieval-based, or generative mechanisms to produce contextually appropriate responses. Modern chatbots are predominantly built on large language models, enabling open-domain dialogue, multi-turn context tracking, and task execution across text and voice interfaces. They serve as the primary user-facing layer of conversational AI systems, integrating intent recognition, dialogue management, and response generation into a coherent interaction loop. Deployment contexts range from narrow-domain customer support and virtual assistants to general-purpose AI agents capable of reasoning, tool use, and multi-step problem solving."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:dialogue-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:intent-recognition ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:context-window ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:natural-language-processing ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:intent-recognition ],
        ngm:conversational-ai ;
    vc:bridgesTo ngm:api-gateway,
        ngm:robotic-process-automation ;
    vc:contrastsWith ngm:ai-agent,
        ngm:rule-based-systems ;
    vc:dependsOn ngm:knowledge-base,
        ngm:language-model ;
    vc:enables ngm:customer-service-automation,
        ngm:question-answering,
        ngm:virtual-assistant ;
    vc:hasMaturity ngmi:maturity-established ;
