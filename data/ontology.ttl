ngm:eip-2981 a owl:Class ;
    rdfs:label "EIP-2981"@en ;
    rdfs:comment "An Ethereum standard defining a royalty interface that allows non-fungible and multi-token contracts to signal a royalty amount and recipient for a sale. It standardises retrieval of royalty information."@en ;
