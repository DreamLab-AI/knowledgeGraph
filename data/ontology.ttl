    skos:broader ngm:sc-interaction ;
    vc:enables ngm:animation-retargeting,
        ngm:biomechanical-analysis,
        ngm:performance-capture,
        ngm:virtual-production ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:calibration-target,
        ngm:data-processing-unit,
        ngm:imu-sensors,
        ngm:motion-markers,
        ngm:optical-cameras,
        ngm:tracking-volume ;
    vc:isPartOf ngm:reality-capture-system ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:camera-calibration,
        ngm:high-speed-networking,
        ngm:motion-solver-software,
        ngm:synchronized-timing ;
    vc:slug "motion-capture-rig" ;
    vc:sourceDomain "spatial-computing" .

ngm:multi-task-learning a owl:Class ;
    rdfs:label "Multi Task Learning"@en ;
    rdfs:comment "Multi Task Learning is a machine learning paradigm where a single model is trained simultaneously on multiple related tasks, sharing intermediate representations to improve generalisation, sample efficiency, and regularisation relative to independently trained single-task models."@en ;
    rdfs:subClassOf ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:contrastsWith ngm:overfitting ;
    vc:enables ngm:multimodal-ai-architecture-ai ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:supervised-learning,
        ngm:transfer-learning ;
    vc:slug "multi-task-learning" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:neural-network-architecture .

ngm:multihash a owl:Class ;
    rdfs:label "Multihash"@en ;
    rdfs:comment "Multihash is a self-describing hash format developed by Protocol Labs in which the hash digest is prefixed with a varint-encoded function code and digest length, enabling consumers to identify the hash algorithm without out-of-band knowledge. It is a foundational component of the IPFS content-addressing stack and the Multiformat suite, providing algorithm agility so that systems can upgrade from SHA-256 to SHA3 or BLAKE3 without breaking existing identifiers. Any hash function can be registered in the Multihash table and the format is codec-neutral."@en ;
    rdfs:subClassOf ngm:cryptographic-hash ;
    vc:enables ngm:content-addressed-storage,
        ngm:ipfs ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:content-addressing,
        ngm:cryptographic-hash-function,
        ngm:merkle-tree ;
    vc:slug "multihash" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:cryptographic-verification ;
    vc:uses ngm:binary-encoding .

ngm:multimodal-ai-architecture a owl:Class ;
    rdfs:label "Multimodal AI Architecture"@en ;
    rdfs:comment "Multimodal AI refers to artificial intelligence systems that process, fuse, and generate content across multiple data modalities—including text, images, audio, video, and 3D—within a unified model architecture. Multimodal systems learn cross-modal alignments through joint embedding spaces, enabling capabilities such as image captioning, visual question answering, text-to-image synthesis, and real-time audio-visual understanding that single-modality models cannot achieve."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:computer-vision ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:large-language-models ],
        ngm:ai-model-architecture,
        ngm:ai-research-area ;
    skos:broader ngm:ai-model-architecture,
        ngm:ai-research-area ;
    vc:enables ngm:image-generation,
        ngm:text-to-speech ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:relatedTo ngm:diffusion-models,
        ngm:multimodal-ai-architecture-ai,
        ngm:speech-recognition ;
    vc:requires ngm:computer-vision,
        ngm:large-language-models ;
    vc:slug "multimodal-ai-architecture" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:natural-interaction a owl:Class ;
    rdfs:label "Natural Interaction"@en ;
    rdfs:comment "Natural Interaction describes human-computer interaction modalities that leverage innate human capabilities—speech, gesture, gaze, touch, and whole-body movement—rather than requiring users to learn abstract symbolic interfaces such as keyboards or command-line syntax. The goal is to reduce cognitive translation costs and make technology accessible to a broader range of users by aligning the interaction channel with the way humans naturally communicate and manipulate objects in the physical world. Natural interaction is foundational to spatial computing, mixed reality, and embodied AI systems where traditional 2D pointing devices are ergonomically or practically unsuitable."@en ;
    rdfs:subClassOf ngm:human-computer-interaction ;
    vc:enables ngm:embodied-ai,
        ngm:spatial-computing,
        ngm:voice-interaction ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:eye-tracking,
        ngm:gesture-recognition,
        ngm:haptic-feedback,
        ngm:speech-recognition ;
    vc:slug "natural-interaction" ;
    vc:sourceDomain "metaverse" ;
    vc:uses ngm:conversational-ai,
        ngm:hand-tracking,
        ngm:multimodal-ai-architecture-ai .

ngm:neural-machine-translation a owl:Class ;
    rdfs:label "Neural Machine Translation"@en ;
    rdfs:comment "Neural Machine Translation (NMT) is an approach to automated language translation in which end-to-end neural networks — typically based on encoder-decoder architectures with attention mechanisms — learn to map source-language sequences directly to target-language sequences from parallel corpora. Unlike earlier statistical phrase-based methods, NMT systems capture long-range dependencies and global sentence context, producing more fluent and contextually accurate translations. The Transformer architecture has become the dominant NMT paradigm since its introduction in 2017."@en ;
    rdfs:subClassOf ngm:language-translation ;
    vc:enables ngm:real-time-language-translation,
        ngm:real-time-translation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:deep-learning,
        ngm:language-model,
        ngm:natural-language-processing ;
    vc:slug "neural-machine-translation" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:attention-mechanism,
        ngm:encoder-decoder-architecture,
        ngm:transformer-architecture .

