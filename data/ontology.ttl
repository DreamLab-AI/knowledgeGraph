ngm:iso-iec-jtc-1-sc-27 a owl:Class ;
    rdfs:comment "ISO/IEC JTC 1/SC 27 is the joint ISO and IEC subcommittee responsible for developing international standards on information security, cybersecurity and privacy protection. Its remit includes the ISO/IEC 27000 family of information security management standards, cryptographic techniques, security evaluation criteria and identity management. It is the principal global body coordinating consensus standards in the security and privacy domain."@en ;
    rdfs:label "ISO/IEC JTC 1/SC 27"@en ;
    rdfs:subClassOf ngm:standards-body ;
    vc:hasMaturity ngmi:maturity-established ;
