ngm:satoshi-nakamoto a owl:Class ;
    rdfs:label "Satoshi Nakamoto"@en ;
    rdfs:comment "Satoshi Nakamoto is the pseudonym used by the unidentified person or group who designed Bitcoin, authored its 2008 white paper and released the first reference implementation in 2009. Nakamoto introduced a practical solution to double-spending in a peer-to-peer electronic cash system through proof-of-work and a public, append-only ledger. The true identity behind the name remains unknown, and Nakamoto withdrew from public involvement in the project around 2010 to 2011."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:peer-to-peer-network ],
        ngm:bc-protocol-and-consensus ;
    skos:broader ngm:bc-protocol-and-consensus ;
    vc:bridgesTo ngm:bc-cryptographic-primitive,
        ngm:distributed-systems,
        ngm:game-theory ;
    vc:contrastsWith ngm:central-bank,
        ngm:trusted-third-party ;
    vc:enables ngm:bitcoin,
        ngm:blockchain,
        ngm:consensus,
        ngm:proof-of-work ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:distributed-ledger,
        ngm:nakamoto-consensus ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:cryptocurrency,
        ngm:cypherpunk-movement,
        ngm:double-spending,
        ngm:genesis-block,
        ngm:pseudonymity ;
    vc:requires ngm:peer-to-peer-network,
        ngm:timestamp-server ;
    vc:slug "satoshi-nakamoto" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:cryptographic-hash-function,
        ngm:digital-signature,
        ngm:elliptic-curve-cryptography,
        ngm:merkle-tree,
        ngm:unspent-transaction-output .

ngm:scalability-pattern a owl:Class ;
    rdfs:label "Scalability Pattern"@en ;
    rdfs:comment "A Scalability Pattern is a reusable architectural strategy that enables a system to handle increasing load by adding resources or restructuring components without degrading performance or reliability. Patterns include horizontal scaling (adding parallel instances), vertical scaling (increasing instance capacity), sharding, caching, and event-driven decomposition, each suited to different bottleneck profiles."@en ;
    rdfs:subClassOf ngm:infra-software-engineering ;
    skos:broader ngm:infra-software-engineering ;
    vc:enables ngm:distributed-systems,
        ngm:performance-optimization ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:slug "scalability-pattern" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:performance-benchmarks,
        ngm:technology-infrastructure-domain-architecture ;
    vc:uses ngm:microservices-architecture,
        ngm:orchestration .

ngm:scalability-solutions a owl:Class ;
    rdfs:label "Scalability Solutions"@en ;
    rdfs:comment "Scalability solutions are a family of techniques, architectures, and protocols designed to increase the throughput, reduce latency, and lower transaction costs of distributed systems—especially blockchain networks—without sacrificing security or decentralisation. They span both on-chain approaches (sharding, improved consensus algorithms, data availability sampling) and off-chain or layer-2 approaches (payment channels, rollups, sidechains) that defer computation or data storage away from the base layer. The discipline also extends beyond blockchains into general distributed-systems engineering, encompassing horizontal scaling, caching strategies, and peer-to-peer load distribution. Together these mechanisms address the fundamental tension between throughput, security, and decentralisation commonly formalised as the Blockchain Trilemma."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:layer-2-scaling ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:data-availability-sampling ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:peer-to-peer-network ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:state-channel ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:sidechain ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:sharding ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:consensus-mechanism ],
        ngm:distributed-systems ;
    vc:bridgesTo ngm:cloud-infrastructure,
        ngm:distributed-computing ;
    vc:contrastsWith ngm:blockchain-trilemma,
        ngm:monolithic-blockchain ;
    vc:dependsOn ngm:blockchain,
        ngm:cryptographic-proofs,
        ngm:zero-knowledge-proof ;
    vc:enables ngm:blockchain-interoperability,
        ngm:decentralised-finance,
        ngm:micropayments,
        ngm:smart-contracts ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:data-availability-sampling,
        ngm:layer-2-scaling,
        ngm:sharding,
        ngm:sidechain,
        ngm:state-channel ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:ethereum,
        ngm:modular-blockchain,
        ngm:optimistic-rollup,
        ngm:proof-of-stake ;
    vc:requires ngm:consensus-mechanism,
        ngm:peer-to-peer-network ;
    vc:slug "scalability-solutions" ;
    vc:sourceDomain "blockchain" .

