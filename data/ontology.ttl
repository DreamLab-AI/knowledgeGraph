            owl:someValuesFrom ngm:digital-identity ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:consent-management ],
        ngm:financial-services ;
    vc:bridgesTo ngm:decentralised-finance ;
    vc:dependsOn ngm:financial-regulation ;
    vc:enables ngm:data-sharing,
