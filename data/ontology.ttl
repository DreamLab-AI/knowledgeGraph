ngm:digital-signature a owl:Class ;
    rdfs:label "Digital Signature"@en ;
    rdfs:comment "A Digital Signature is a cryptographic primitive consisting of three probabilistic polynomial-time algorithms (KeyGen, Sign, Verify) operating over an asymmetric keypair (sk, pk) such that, for any message m drawn from the message space M, Sign(sk, m) produces a signature σ that Verify(pk, m,..."@en ;
