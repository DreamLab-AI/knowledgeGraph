ngm:surveillance a owl:Class ;
    rdfs:label "Surveillance"@en ;
    rdfs:comment "Surveillance is the systematic monitoring, observation and collection of information about people, behaviour or activities, typically by state authorities, corporations or other organisations. It encompasses physical observation, electronic interception, video monitoring and the aggregation of digital data trails. Surveillance practices raise significant questions about proportionality, oversight and the balance between security objectives and individual privacy and civil liberties."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:transparency ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:governance ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:accountability ],
        ngm:governance ;
    vc:contrastsWith ngm:data-privacy,
        ngm:privacy,
        ngm:privacy-enhancing-technology ;
    vc:enables ngm:data-collection,
        ngm:monitoring,
        ngm:observability ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:civil-liberties,
        ngm:data-governance,
        ngm:ethics ;
    vc:requires ngm:accountability,
        ngm:governance,
        ngm:transparency ;
    vc:slug "surveillance" ;
    vc:sourceDomain "governance" ;
    vc:supports ngm:security ;
    vc:uses ngm:facial-recognition .

ngm:swift a owl:Class ;
    rdfs:label "SWIFT"@en ;
    rdfs:comment "SWIFT, the Society for Worldwide Interbank Financial Telecommunication, is a cooperative that operates a secure messaging network used by banks and other financial institutions to exchange payment and securities instructions. It does not move money itself but standardises the messages that instruct transfers between institutions, which then settle through correspondent banking relationships or payment systems. Founded in 1973 and based in Belgium, it connects thousands of institutions across most countries."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:swift-messaging ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:secure-messaging ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:correspondent-banking ],
        ngm:financial-infrastructure ;
    vc:contrastsWith ngm:central-bank-digital-currency,
        ngm:ripple-net ;
    vc:dependsOn ngm:bc-defi-and-economics,
        ngm:network-infrastructure ;
    vc:enables ngm:cross-border-payments,
        ngm:interbank-settlement,
        ngm:securities-settlement,
        ngm:trade-finance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:business-identifier-code,
        ngm:swift-messaging ;
    vc:implements ngm:iso-20022,
        ngm:message-format ;
    vc:isPartOf ngm:payment-infrastructure ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:nostro-vostro-accounts,
        ngm:real-time-gross-settlement ;
