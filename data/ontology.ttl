ngm:omnidirectional-robot a owl:Class ;
    rdfs:label "Omnidirectional Robot"@en ;
    rdfs:comment "A wheeled mobile robot that achieves holonomic motion—the ability to translate in any direction and rotate independently—by employing mecanum wheels or omniwheels whose passive rollers allow lateral force components. This enables precise, agile manoeuvring in constrained environments such as warehouses and hospital corridors without requiring turning arcs."@en ;
    rdfs:subClassOf ngm:robo-robot-type,
        ngm:wheeled-robot ;
    skos:broader ngm:robo-robot-type ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:robo-robot-type ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:differential-drive-robot,
        ngm:mecanum-wheel-robot,
        ngm:mobile-robot,
        ngm:mobile-robot-platform,
        ngm:wheeled-mobile-robot ;
    vc:slug "omnidirectional-robot" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:robo-actuation-and-control,
        ngm:robo-navigation-and-planning .

