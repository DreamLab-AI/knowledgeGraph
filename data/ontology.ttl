ngm:mi-ca a owl:Class ;
    rdfs:label "MiCA"@en ;
    rdfs:comment "MiCA (Markets in Crypto-Assets Regulation, EU 2023/1114) is the European Union's comprehensive legal framework governing crypto-assets not already covered by existing financial services legislation such as MiFID II. It classifies crypto-assets into three categories — utility tokens, asset-referenced tokens (ARTs), and e-money tokens (EMTs) — imposing tiered obligations on issuers including mandatory white-paper disclosures, capital adequacy requirements, and reserve safeguards for stablecoins. Crypto-asset service providers (CASPs) — encompassing exchanges, custodians, portfolio managers, and advisers — must obtain authorisation from a national competent authority with passporting rights across the EU single market. MiCA entered into force in June 2023 with stablecoin provisions applying from June 2024 and the full CASP regime from December 2024, making it one of the world's first end-to-end crypto regulatory regimes."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:national-competent-authority ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:capital-adequacy ],
        ngm:infra-legal-and-regulatory ;
    skos:broader ngm:infra-legal-and-regulatory ;
    vc:bridgesTo ngm:blockchain,
        ngm:central-bank-digital-currency,
        ngm:distributed-ledger-technology ;
    vc:contrastsWith ngm:crypto-regulation,
        ngm:mifid-ii ;
    vc:dependsOn ngm:european-banking-authority,
        ngm:european-securities-and-markets-authority ;
    vc:enables ngm:consumer-protection,
        ngm:eu-passporting,
        ngm:market-integrity ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:anti-money-laundering,
        ngm:crypto-regulation ;
    vc:isPartOf ngm:eu-digital-finance-strategy,
        ngm:eu-single-market ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:do-ra,
        ngm:fatf-travel-rule,
        ngm:gdpr,
        ngm:transfer-of-funds-regulation ;
    vc:requires ngm:capital-adequacy,
        ngm:crypto-asset-white-paper,
        ngm:national-competent-authority ;
    vc:slug "mi-ca" ;
    vc:sourceDomain "governance" ;
    vc:standardizedBy ngm:eba,
        ngm:esma,
        ngm:european-union ;
    vc:supports ngm:decentralised-finance,
        ngm:stablecoin ;
    vc:uses ngm:asset-referenced-token,
        ngm:e-money-token .

ngm:micro-ros a owl:Class ;
    rdfs:label "micro-ROS"@en ;
    rdfs:comment "micro-ROS is a framework that brings the ROS 2 programming model and communication to resource-constrained microcontrollers, allowing embedded devices to participate as first-class nodes in a ROS graph."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
