ngm:nvlink a owl:Class ;
    rdfs:label "NVLink"@en ;
    rdfs:comment "NVLink is NVIDIA's high-bandwidth, low-latency point-to-point interconnect that links GPUs directly to one another, and in some platforms to the CPU, providing far greater throughput than the PCIe bus it supplements. By creating a coherent, high-speed fabric between accelerators, NVLink enables fast peer-to-peer memory transfers and unified memory pooling across multiple GPUs. It is foundational to multi-GPU training and inference of large neural networks, where the interconnect bandwidth between devices often determines the achievable scaling efficiency of model and tensor parallelism."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gpu-computing ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:bandwidth ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cuda ],
        ngm:gpu-computing ;
    vc:bridgesTo ngm:distributed-training ;
    vc:dependsOn ngm:gpu ;
    vc:enables ngm:distributed-training,
        ngm:model-parallelism,
        ngm:tensor-parallelism ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:bandwidth ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:cuda,
        ngm:high-performance-computing,
        ngm:latency ;
    vc:requires ngm:cuda,
        ngm:gpu-computing ;
    vc:slug "nvlink" ;
    vc:sourceDomain "ai" ;
    vc:supports ngm:high-performance-computing ;
    vc:uses ngm:bandwidth .

ngm:open-source-licence a owl:Class ;
    rdfs:label "Open Source Licence"@en ;
    rdfs:comment "An open source licence is a legal instrument that grants users the rights to use, study, modify, and redistribute software source code, subject to conditions defined by the licence. Such licences fall broadly into permissive families, which impose few obligations, and copyleft families, which require derivative works to remain under compatible terms. Recognition typically follows the Open Source Initiative's definition, and licences are identified by standard SPDX identifiers to support automated compliance."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:copyright ],
        ngm:software-licence ;
    vc:bridgesTo ngm:intellectual-property-rights ;
    vc:enables ngm:free-software,
        ngm:open-source ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:copyleft,
        ngm:permissive-licence ;
    vc:isPartOf ngm:open-source-software ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:apache-licence,
        ngm:gnu-general-public-license,
        ngm:mit-licence ;
    vc:requires ngm:copyright ;
    vc:slug "open-source-licence" ;
    vc:sourceDomain "distributed-collaboration" ;
    vc:standardizedBy ngm:open-source-initiative,
        ngm:spdx ;
    vc:supports ngm:licence-compliance .

ngm:openapi a owl:Class ;
    rdfs:label "OpenAPI"@en ;
    rdfs:comment "OpenAPI is a language-agnostic, machine-readable specification for describing HTTP-based RESTful APIs. An OpenAPI document defines available endpoints, operations, parameters, request and response schemas, and authentication mechanisms in a single structured file written in YAML or JSON. It enables automated generation of documentation, client SDKs, server stubs, and validation logic, decoupling an API's contract from its implementation."@en ;
    rdfs:subClassOf ngm:api ;
    vc:enables ngm:interoperability,
        ngm:software-development ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:api-specification ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:api-gateway,
        ngm:api-versioning,
        ngm:graphql,
        ngm:rest,
        ngm:rest-api ;
    vc:slug "openapi" ;
    vc:sourceDomain "infrastructure" ;
    vc:standardizedBy ngm:interoperability,
        ngm:standards ;
    vc:supports ngm:api-design,
        ngm:documentation,
        ngm:software-development ;
    vc:uses ngm:api,
        ngm:data-format,
        ngm:yaml .

ngm:overlay-network a owl:Class ;
    rdfs:label "Overlay Network"@en ;
    rdfs:comment "An overlay network is a logical network built on top of an existing physical or underlay network, where nodes are connected by virtual links that may each traverse many underlying hops. By abstracting away the physical topology, overlays implement custom routing, addressing and services such as peer-to-peer file sharing, content delivery and encrypted tunnelling. They trade some efficiency for flexibility, resilience and the ability to deploy new network behaviour without changing the underlay."@en ;
    rdfs:subClassOf ngm:infrastructure ;
    skos:broader ngm:infrastructure ;
    vc:contrastsWith ngm:network-protocol ;
    vc:dependsOn ngm:application-layer ;
    vc:enables ngm:encryption ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:virtual-network ;
    vc:isPartOf ngm:distributed-systems ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:distributed-systems,
        ngm:infrastructure ;
    vc:slug "overlay-network" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:content-delivery-network,
        ngm:peer-to-peer-network ;
    vc:uses ngm:distributed-hash-table,
        ngm:network-protocol .

ngm:passwordless-authentication a owl:Class ;
    rdfs:label "Passwordless Authentication"@en ;
    rdfs:comment "Passwordless Authentication encompasses identity verification mechanisms that prove user identity without requiring the user to memorise or enter a shared-secret password. Instead, authentication relies on possession of a hardware token or platform authenticator, biometric characteristics, cryptographic key pairs, or one-time codes delivered through a trusted out-of-band channel. The FIDO2 standard — comprising the W3C WebAuthn specification and the FIDO Alliance CTAP protocol — provides the primary open standard for passkey-based passwordless authentication, binding credentials to device hardware and enabling phishing-resistant login flows. By eliminating the shared secret as an authentication factor, passwordless schemes structurally defeat credential-stuffing, password-spray, and phishing attack classes."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:identity-proofing ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:secure-enclave ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:trusted-platform-module ],
        ngm:authentication-mechanism ;
    vc:bridgesTo ngm:decentralised-identity,
        ngm:verifiable-credentials ;
    vc:contrastsWith ngm:knowledge-based-authentication,
        ngm:password-authentication ;
    vc:enables ngm:digital-identity-management,
        ngm:phishing-resistant-authentication,
        ngm:zero-trust-architecture ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:digital-identity-wallet,
        ngm:multi-factor-authentication,
        ngm:oauth-2-0,
        ngm:open-id-connect,
        ngm:single-sign-on ;
    vc:requires ngm:identity-proofing,
        ngm:secure-enclave,
        ngm:trusted-platform-module ;
    vc:slug "passwordless-authentication" ;
    vc:sourceDomain "security" ;
    vc:standardizedBy ngm:fido-alliance,
        ngm:fido2,
        ngm:web-authn ;
    vc:supports ngm:access-control,
        ngm:identity-federation ;
    vc:uses ngm:biometric-authentication,
        ngm:challenge-response-protocol,
        ngm:digital-signature,
        ngm:hardware-security-key,
        ngm:public-key-cryptography .

ngm:pedersen-commitment a owl:Class ;
    rdfs:label "Pedersen Commitment"@en ;
    rdfs:comment "A Pedersen commitment is a cryptographic commitment scheme in which a committer binds to a secret value v by computing C = g^v * h^r, where g and h are independent group generators and r is a random blinding factor. The scheme is computationally binding under the discrete logarithm assumption and unconditionally (information-theoretically) hiding, meaning an adversary with unlimited computation cannot determine the committed value from C alone. Crucially, Pedersen commitments are additively homomorphic: the product of two commitments C(v1, r1) * C(v2, r2) equals C(v1+v2, r1+r2), enabling arithmetic on committed values without revealing them. This property makes Pedersen commitments foundational to confidential transactions, range proofs, and zero-knowledge proof systems."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:elliptic-curve-cryptography ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:discrete-logarithm-problem ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:random-oracle-model ],
        ngm:cryptographic-commitment ;
    vc:bridgesTo ngm:monero,
        ngm:privacy-preserving-blockchain ;
    vc:enables ngm:bulletproofs,
        ngm:confidential-transactions,
        ngm:range-proof,
        ngm:secure-multi-party-computation,
        ngm:zero-knowledge-proof ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:commitment-scheme,
        ngm:homomorphic-encryption ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:schnorr-signature,
        ngm:zero-knowledge-proof ;
    vc:requires ngm:discrete-logarithm-problem,
        ngm:elliptic-curve-cryptography,
        ngm:random-oracle-model ;
    vc:slug "pedersen-commitment" ;
    vc:sourceDomain "security" ;
    vc:supports ngm:digital-signature,
        ngm:privacy-preserving-protocol,
        ngm:verifiable-secret-sharing ;
    vc:uses ngm:blinding-factor,
        ngm:elliptic-curve-group .

ngm:performance-monitoring a owl:Class ;
    rdfs:label "Performance Monitoring"@en ;
    rdfs:comment "Performance Monitoring is the continuous collection, analysis, and visualisation of metrics describing how a system, application, or model behaves under real workloads. It tracks indicators such as latency, throughput, error rates, resource utilisation, and, for machine-learning systems, predictive quality and drift, surfacing degradation through dashboards and alerts. Performance monitoring is a core observability discipline that enables teams to detect regressions, diagnose bottlenecks, and uphold service-level objectives."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:monitoring ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:telemetry ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:telemetry ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:anomaly-detection ],
        ngm:observability ;
    vc:dependsOn ngm:monitoring ;
    vc:enables ngm:feedback-loop,
        ngm:site-reliability-engineering ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:anomaly-detection,
        ngm:telemetry ;
    vc:isPartOf ngm:observability ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:machine-learning,
        ngm:observability ;
    vc:requires ngm:monitoring,
        ngm:telemetry ;
    vc:slug "performance-monitoring" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:ai-monitoring,
        ngm:mlops ;
    vc:uses ngm:anomaly-detection .

ngm:principal-component-analysis a owl:Class ;
    rdfs:label "Principal Component Analysis"@en ;
    rdfs:comment "Principal Component Analysis (PCA) is an unsupervised linear technique that transforms correlated variables into a smaller set of uncorrelated components ordered by the variance they capture. The components are the eigenvectors of the data's covariance matrix, and projecting onto the leading components yields a lower-dimensional representation that preserves as much variance as possible. PCA is widely used for dimensionality reduction, noise reduction, visualisation, and feature decorrelation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-quality ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:linear-algebra ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-preprocessing ],
        ngm:dimensionality-reduction ;
    vc:contrastsWith ngm:feature-engineering ;
    vc:enables ngm:data-visualisation,
        ngm:dimensionality-reduction ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:linear-algebra ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:data-preprocessing,
        ngm:unsupervised-learning ;
    vc:requires ngm:data-preprocessing,
        ngm:data-quality ;
    vc:slug "principal-component-analysis" ;
    vc:sourceDomain "machine-learning" ;
    vc:supports ngm:data-processing,
        ngm:machine-learning-model ;
    vc:uses ngm:linear-algebra .

ngm:privacy-preserving-technology a owl:Class ;
    rdfs:label "Privacy Preserving Technology"@en ;
    rdfs:comment "Privacy Preserving Technology (PPT) is the family of cryptographic and computational methods that enable analysis, sharing, and machine learning on sensitive data without exposing raw individual records. Core paradigms include differential privacy (injecting calibrated noise into query outputs), federated learning (training models across distributed silos without centralising data), homomorphic encryption (computing directly on ciphertext), secure multi-party computation (joint computation among mutually distrusting parties), and zero-knowledge proofs (demonstrating a statement's truth without revealing the witness). Together these techniques form the technical foundation for privacy-by-design engineering under regulatory regimes such as GDPR, CCPA, and the EU AI Act, and are increasingly integral to trusted AI pipelines, healthcare analytics, and decentralised identity systems."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:zero-knowledge-proof ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptography ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:trusted-execution-environment ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:secure-multi-party-computation ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:federated-learning ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:homomorphic-encryption ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:differential-privacy ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:public-key-infrastructure ],
        ngm:infra-security-and-identity ;
    skos:broader ngm:infra-security-and-identity ;
    vc:bridgesTo ngm:blockchain,
        ngm:federated-learning,
        ngm:machine-learning-security,
        ngm:marketplace ;
    vc:contrastsWith ngm:anonymisation,
        ngm:pseudonymisation ;
    vc:dependsOn ngm:elliptic-curve-cryptography,
        ngm:noise-mechanisms ;
    vc:enables ngm:confidential-computing,
        ngm:consent-management,
        ngm:decentralised-identity,
        ngm:privacy-by-design ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:differential-privacy,
        ngm:federated-learning,
        ngm:homomorphic-encryption,
        ngm:secure-multi-party-computation,
        ngm:trusted-execution-environment,
        ngm:zero-knowledge-proof ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:data-protection,
        ngm:eu-ai-act-regulatory-instrument,
        ngm:gdpr ;
    vc:requires ngm:cryptography,
        ngm:public-key-infrastructure ;
    vc:slug "privacy-preserving-technology" ;
    vc:sourceDomain "security" ;
    vc:supports ngm:data-governance,
        ngm:data-minimisation,
        ngm:regulatory-compliance .

ngm:privileged-access-management a owl:Class ;
    rdfs:label "Privileged Access Management"@en ;
    rdfs:comment "Privileged Access Management (PAM) is a cybersecurity discipline and category of technology solutions that controls, monitors, and audits the access rights of users, accounts, and systems with elevated permissions in IT environments. PAM encompasses vaulting of privileged credentials, just-in-time access provisioning, session recording, and anomaly detection for privileged sessions. It addresses the risk that compromised administrator accounts represent the most damaging attack vector in enterprise breaches. PAM solutions enforce the principle of least privilege and provide forensic audit trails required by compliance frameworks such as ISO/IEC 27001 and SOX."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:role-based-access-control ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:multi-factor-authentication ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:session-recording ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:digital-certificate ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:credential-store ],
        ngm:identity-and-access-management ;
    vc:bridgesTo ngm:identity-and-access-management ;
    vc:contrastsWith ngm:discretionary-access-control ;
    vc:dependsOn ngm:access-control,
        ngm:identity-management,
        ngm:public-key-infrastructure ;
    vc:enables ngm:compliance-audit-trail ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:credential-store,
        ngm:just-in-time-access,
        ngm:session-recording ;
    vc:isPartOf ngm:identity-and-access-management,
        ngm:information-security ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:endpoint-detection-and-response,
        ngm:network-access-control ;
    vc:requires ngm:digital-certificate,
        ngm:multi-factor-authentication,
        ngm:role-based-access-control ;
    vc:slug "privileged-access-management" ;
    vc:sourceDomain "security" ;
    vc:supports ngm:iso-iec-27001,
        ngm:sox-compliance,
        ngm:zero-trust-architecture ;
    vc:uses ngm:behavioural-analytics,
        ngm:security-information-and-event-management,
        ngm:session-management .

ngm:process-control a owl:Class ;
    rdfs:label "Process Control"@en ;
    rdfs:comment "Process control is the discipline of regulating continuous industrial processes, such as chemical reactions, temperature, flow, and pressure, to maintain outputs at desired setpoints despite disturbances. It relies on sensors, controllers, and actuators arranged in feedback loops, using techniques from PID control to model predictive control. It is fundamental to manufacturing, energy, and process-industry automation."@en ;
    rdfs:subClassOf ngm:control-system ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:feedback-loop,
        ngm:model-based-control ;
    vc:slug "process-control" ;
    vc:sourceDomain "robotics" .

ngm:protein-structure-prediction a owl:Class ;
    rdfs:label "Protein Structure Prediction"@en ;
    rdfs:comment "Protein structure prediction is the computational determination of a protein's three-dimensional folded structure from its amino-acid sequence. Deep-learning systems such as AlphaFold, built on attention-based architectures, achieved near-experimental accuracy and transformed structural biology. It is a landmark AI application with deep impact on drug discovery, molecular biology, and rational enzyme design."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:training-data ],
        ngm:ai-application ;
    skos:broader ngm:ai-application ;
    vc:bridgesTo ngm:artificial-intelligence,
        ngm:machine-learning ;
    vc:dependsOn ngm:high-performance-computing,
        ngm:neural-network-architecture ;
    vc:enables ngm:drug-discovery ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:attention,
        ngm:bioinformatics,
        ngm:molecular-dynamics,
        ngm:transformers ;
    vc:requires ngm:training-data ;
    vc:slug "protein-structure-prediction" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:attention,
        ngm:deep-learning,
        ngm:graph-neural-networks,
        ngm:transformers .

ngm:provenance-verification a owl:Class ;
    rdfs:label "Provenance Verification"@en ;
    rdfs:comment "Computational process for validating the origin, authenticity, and chain of custody of digital assets through metadata analysis and distributed ledger records."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:digital-signatures ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:chain-of-custody ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:metadata-standards ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:timestamp-authority ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:blockchain ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:content-authenticity ],
        ngm:sc-governance-and-safety ;
    skos:broader ngm:sc-governance-and-safety ;
    vc:enables ngm:trust-establishment ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:chain-of-custody,
        ngm:content-authenticity ;
    vc:isPartOf ngm:asset-management,
        ngm:trust-infrastructure ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:blockchain,
        ngm:digital-signatures,
        ngm:metadata-standards,
        ngm:timestamp-authority ;
    vc:slug "provenance-verification" ;
    vc:sourceDomain "spatial-computing" .

ngm:rb-0023-degrees-of-freedom a owl:Class ;
    rdfs:label "rb 0023 degrees of freedom"@en ;
    rdfs:comment "Degrees of Freedom (DOF) in robotics denotes the number of independent parameters required to fully specify the configuration of a robot mechanism. Each revolute or prismatic joint contributes one DOF; a 6-DOF manipulator can achieve arbitrary position and orientation in three-dimensional space. The number of DOF constrains the robot's reachable workspace, its dexterity, and the complexity of its kinematic and dynamic models."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:rb-0026-robot-joint ],
        ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:rb-0026-robot-joint ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:rb-0021-robot-kinematics,
        ngm:rb-0024-workspace,
        ngm:rb-0031-singularity,
        ngm:rb-0037-dexterity ;
    vc:slug "rb-0023-degrees-of-freedom" ;
    vc:sourceDomain "robotics" ;
    vc:supports ngm:rb-0028-forward-kinematics,
        ngm:rb-0029-inverse-kinematics,
        ngm:rb-0036-resolution .

ngm:rb-0030-jacobian-matrix a owl:Class ;
    rdfs:label "rb 0030 jacobian matrix"@en ;
    rdfs:comment "The Jacobian matrix is a mathematical mapping that relates joint-space velocities to Cartesian end-effector velocities for a robotic manipulator. It is central to differential kinematics, velocity control, force-torque transformation, and singularity analysis; its pseudo-inverse enables computation of joint velocities from desired Cartesian motions in inverse kinematics."@en ;
    rdfs:subClassOf ngm:kinematics,
        ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:enables ngm:rb-0053-force-control,
        ngm:rb-0060-optimal-control ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:rb-0028-forward-kinematics,
        ngm:rb-0029-inverse-kinematics,
        ngm:rb-0031-singularity,
        ngm:rb-0032-manipulability ;
    vc:slug "rb-0030-jacobian-matrix" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:rb-0021-robot-kinematics,
        ngm:rb-0023-degrees-of-freedom .

ngm:rb-0067-force-torque-sensor a owl:Class ;
    rdfs:label "rb 0067 force torque sensor"@en ;
    rdfs:comment "A force-torque sensor (FT sensor) is a transducer mounted at a robot's wrist or tool centre point that simultaneously measures all six components of mechanical load: three orthogonal forces (Fx, Fy, Fz) and three orthogonal torques (Tx, Ty, Tz). These measurements enable the robot controller to monitor contact forces in real time, supporting force-controlled assembly, surface-following tasks, human-robot contact detection, and safety-critical power-and-force limiting under ISO/TS 15066. FT sensors are the primary feedback device for impedance and admittance control strategies."@en ;
    rdfs:subClassOf ngm:robo-perception ;
    skos:broader ngm:robo-perception ;
    vc:bridgesTo ngm:force-torque-sensor ;
    vc:enables ngm:rb-0053-force-control,
        ngm:rb-0056-impedance-control,
        ngm:rb-0057-admittance-control ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:haptic-feedback,
        ngm:rb-0070-tactile-sensing,
        ngm:rb-0094-power-and-force-limiting ;
    vc:slug "rb-0067-force-torque-sensor" ;
    vc:sourceDomain "robotics" ;
    vc:supports ngm:cobot-safety-levels,
        ngm:rb-0066-robot-sensor .

ngm:rb-0072-encoder a owl:Class ;
    rdfs:label "rb 0072 encoder"@en ;
    rdfs:comment "An encoder in robotics is a proprioceptive transducer that converts the angular or linear position of a joint or actuator shaft into a digital electrical signal, providing the position and velocity feedback essential for closed-loop control. Encoders are categorised as incremental (providing relative position pulses) or absolute (outputting a unique code for each position), with absolute rotary encoders being preferred in safety-critical collaborative robot applications due to their power-loss resilience. High-resolution encoders directly determine robot accuracy, repeatability, and the fidelity of safety functions such as speed limitation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:rotary-encoder ],
        ngm:proprioceptive-sensor,
        ngm:robo-perception ;
    skos:broader ngm:robo-perception ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:rotary-encoder ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:rb-0026-robot-joint,
        ngm:rb-0034-repeatability,
        ngm:rb-0035-accuracy ;
    vc:slug "rb-0072-encoder" ;
    vc:sourceDomain "robotics" ;
    vc:supports ngm:rb-0047-feedback-control,
        ngm:rb-0054-position-control,
        ngm:rb-0093-speed-limitation ;
    vc:uses ngm:rb-0066-robot-sensor .

ngm:real-time-data-processing a owl:Class ;
    rdfs:label "Real-Time Data Processing"@en ;
    rdfs:comment "Real-time data processing is the continuous ingestion, transformation, and analysis of data immediately as it is produced, delivering results within strict latency bounds rather than in scheduled batches. It underpins applications that must react to events as they happen, such as fraud detection, monitoring, and live analytics, and depends on low-latency pipelines, stream-processing engines, and event-driven architectures. Its defining constraint is bounded end-to-end latency between data arrival and actionable output."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-pipeline ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:message-queue ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:throughput ],
        ngm:stream-processing ;
    vc:contrastsWith ngm:batch-processing ;
    vc:dependsOn ngm:event-driven-architecture,
        ngm:low-latency,
        ngm:stream-processing ;
    vc:enables ngm:fraud-detection,
        ngm:monitoring,
        ngm:observability ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:batch-processing,
        ngm:data-processing,
        ngm:edge-computing ;
    vc:requires ngm:data-pipeline,
        ngm:message-queue,
        ngm:throughput ;
    vc:slug "real-time-data-processing" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:data-management,
        ngm:infrastructure ;
    vc:uses ngm:apache-kafka,
        ngm:stream-processing .

ngm:regulatory-approval a owl:Class ;
    rdfs:label "Regulatory Approval"@en ;
    rdfs:comment "Regulatory approval is the formal authorisation by a regulator that permits an entity, product or activity to proceed under defined conditions."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:regulatory-requirements ],
        ngm:regulation ;
    vc:enables ngm:compliance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:regulatory-requirements ;
    vc:slug "regulatory-approval" ;
    vc:sourceDomain "governance" .

ngm:remote-attestation a owl:Class ;
    rdfs:label "Remote Attestation"@en ;
    rdfs:comment "Remote attestation is a security mechanism by which one system proves the integrity and identity of its software and hardware state to a remote verifier. The attesting platform produces cryptographically signed evidence, rooted in a hardware root of trust, that captures measurements of its boot sequence and running code. A verifier checks this evidence against expected values and a trusted signing key before granting access or releasing secrets, allowing trust decisions to be made about a machine that is not physically controlled."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:trusted-platform-module ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:digital-signature ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:cryptographic-key ],
        ngm:confidential-computing ;
    vc:dependsOn ngm:hardware-security-module ;
    vc:enables ngm:authentication,
        ngm:confidential-computing ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:cryptographic-key,
        ngm:digital-signature ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:intel-sgx,
        ngm:key-management,
        ngm:secure-enclave ;
    vc:requires ngm:root-of-trust,
        ngm:trusted-platform-module ;
    vc:slug "remote-attestation" ;
    vc:sourceDomain "security" ;
    vc:supports ngm:secure-boot,
        ngm:trusted-execution-environment ;
    vc:uses ngm:public-key-cryptography .

ngm:robot-actuator a owl:Class ;
    rdfs:label "Robot Actuator"@en ;
    rdfs:comment "A robot actuator is an electromechanical, pneumatic, hydraulic, or shape-memory device that converts stored or supplied energy into controlled mechanical motion, forming the effector substrate through which a robotic system exerts forces and displacements on its environment. Actuators are the physical implementation layer between a robot's control system and its mechanical structure, determining the speed, force, precision, and compliance characteristics achievable by the overall system. Modern robot actuators range from high-torque servo motors and linear voice-coil drives to soft pneumatic bellows and piezoelectric micro-actuators, each presenting distinct trade-offs in power density, bandwidth, back-drivability, and safety. The selection and design of actuators is a primary determinant of robot morphology, task capability, and energy efficiency across manipulation, locomotion, and human-collaborative applications."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:position-sensor ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:robot-controller ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:electric-motor ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:power-electronics ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:pneumatic-actuator ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:hydraulic-cylinder ],
        ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:bridgesTo ngm:embedded-systems,
        ngm:hardware-component,
        ngm:machine-learning ;
    vc:contrastsWith ngm:passive-mechanism,
        ngm:robot-sensor ;
    vc:dependsOn ngm:feedback-control,
        ngm:motor-driver ;
    vc:enables ngm:compliant-motion,
        ngm:force-torque-control,
        ngm:motion-planning,
        ngm:robot-locomotion ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:electric-motor,
        ngm:hydraulic-cylinder,
        ngm:pneumatic-actuator ;
    vc:implements ngm:series-elastic-actuation ;
    vc:isPartOf ngm:manipulator,
        ngm:robot-joint ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:collaborative-systems-modality-robot,
        ngm:exoskeleton,
        ngm:soft-robotics ;
    vc:requires ngm:position-sensor,
        ngm:power-electronics,
        ngm:robot-controller ;
    vc:slug "robot-actuator" ;
    vc:sourceDomain "robotics" ;
    vc:standardizedBy ngm:iec-61800-adjustable-speed-electrical-power-drive-systems,
        ngm:iso-9283 ;
    vc:supports ngm:end-effector,
        ngm:human-robot-interaction ;
    vc:uses ngm:encoder,
        ngm:pid-control .

ngm:robot-manipulation a owl:Class ;
    rdfs:label "Robot Manipulation"@en ;
    rdfs:comment "Robot manipulation is the sub-field of robotics concerned with the planning and execution of purposeful physical interactions between robotic systems and objects in the world, encompassing grasping, assembly, in-hand manipulation, and tool use. It integrates kinematics, dynamics, perception, and motion planning to move objects from one configuration to another while adapting to uncertainty in object shape, pose, surface properties, and environmental dynamics. Robust manipulation requires coordinating end-effectors, force-torque sensing, and real-time control loops to achieve reliable contact-rich behaviour. The field bridges classical planning and modern machine learning, increasingly leveraging deep visuomotor policies and foundation models trained on large-scale demonstration data."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:robot-perception ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:contact-mechanics ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:grasp-planning ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:robot-kinematics ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:motion-planning ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:end-effector ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:in-hand-manipulation ],
        ngm:manipulation ;
    vc:bridgesTo ngm:imitation-learning,
        ngm:reinforcement-learning ;
    vc:contrastsWith ngm:robot-locomotion ;
    vc:dependsOn ngm:depth-sensing,
        ngm:robotic-arm ;
    vc:enables ngm:human-robot-interaction,
        ngm:robot-learning,
        ngm:surgical-robotics,
        ngm:warehouse-automation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:end-effector,
        ngm:grasp-planning,
        ngm:in-hand-manipulation,
        ngm:motion-planning ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:industrial-manipulation,
        ngm:object-manipulation,
        ngm:sim-to-real-transfer,
        ngm:teleoperation ;
    vc:requires ngm:contact-mechanics,
        ngm:robot-kinematics,
        ngm:robot-perception ;
    vc:slug "robot-manipulation" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:force-control,
        ngm:impedance-control,
        ngm:inverse-kinematics,
        ngm:point-cloud-processing,
        ngm:sensor-fusion .

ngm:science-based-targets a owl:Class ;
    rdfs:label "Science Based Targets"@en ;
    rdfs:comment "Science Based Targets (SBTs) are greenhouse gas emission reduction targets set by companies in alignment with the level of decarbonisation required by climate science to limit global warming to 1.5°C above pre-industrial levels, as defined by the Science Based Targets initiative (SBTi). Targets are validated by the SBTi against approved methods including absolute contraction, sectoral decarbonisation approach, and economy-wide linear regression, and must cover Scope 1 and Scope 2 emissions with a growing requirement to include Scope 3."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ghg-protocol-corporate-standard ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:scope-3-emissions ],
        ngm:sustainability-framework ;
    vc:enables ngm:decarbonisation,
        ngm:net-zero-targets ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:paris-agreement ;
    vc:requires ngm:ghg-protocol-corporate-standard,
        ngm:scope-3-emissions ;
    vc:slug "science-based-targets" ;
    vc:sourceDomain "governance" ;
    vc:standardizedBy ngm:sbti .

ngm:self-organisation a owl:Class ;
    rdfs:label "Self-Organisation"@en ;
    rdfs:comment "Self-organisation is the spontaneous emergence of order, structure, or pattern in a complex system without external direction, arising purely from local interactions among components. It operates through positive and negative feedback mechanisms that amplify or dampen perturbations, leading to globally coherent behaviour from decentralised, local rules."@en ;
    rdfs:subClassOf ngm:complex-systems ;
    vc:bridgesTo ngm:agent-based-modelling ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:chaos-theory,
        ngm:emergence,
        ngm:swarm-intelligence ;
    vc:slug "self-organisation" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:feedback-loop .

ngm:sensitivity-analysis a owl:Class ;
    rdfs:label "Sensitivity Analysis"@en ;
    rdfs:comment "Sensitivity analysis is the study of how variation in the output of a model or calculation can be attributed to variation in its inputs and parameters. It quantifies which factors drive results, identifies fragile assumptions, and supports robustness checks across deterministic and probabilistic models. It is widely used in risk assessment, optimisation, and the calibration of analytics pipelines."@en ;
    rdfs:subClassOf ngm:optimisation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:calculation-parameters,
        ngm:privacy-preserving-analytics ;
    vc:slug "sensitivity-analysis" ;
    vc:sourceDomain "data" .

ngm:serialisation-format a owl:Class ;
    rdfs:label "Serialisation Format"@en ;
    rdfs:comment "A serialisation format is a specification for encoding in-memory data structures into a byte or text stream that can be persisted or transmitted and later reconstructed. Formats differ in schema rigidity, compactness, speed, and cross-language support, spanning text formats like JSON and YAML and binary formats like Protocol Buffers, Avro, and Parquet. It is fundamental to checkpointing, messaging, and distributed computation."@en ;
    rdfs:subClassOf ngm:data-management ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:checkpoints,
        ngm:distributed-computing ;
    vc:slug "serialisation-format" ;
    vc:sourceDomain "infrastructure" .

ngm:settlement-layer a owl:Class ;
    rdfs:label "Settlement Layer"@en ;
    rdfs:comment "The Settlement Layer is the stratum that achieves final, irreversible transfer of value or state between parties. In layered ledger systems it sits beneath faster execution and netting strata and above the Consensus Layer that secures finality. It contains the records, accounts, and finality conditions under which obligations are discharged."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:consensus-layer ],
        ngm:bc-protocol-and-consensus ;
    skos:broader ngm:bc-protocol-and-consensus ;
    vc:enables ngm:lightning-network-layer,
        ngm:smart-contract-layer ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:consensus-layer ;
    vc:slug "settlement-layer" ;
    vc:sourceDomain "blockchain" .

ngm:siem a owl:Class ;
    rdfs:label "SIEM"@en ;
    rdfs:comment "SIEM (Security Information and Event Management) is a platform that aggregates, normalises, and correlates log and event data from across an organisation's IT estate to detect threats and support compliance. It combines real-time alerting, anomaly detection, and historical search with dashboards and audit reporting. It is a foundational tool of security operations centres and regulatory compliance programmes."@en ;
    rdfs:subClassOf ngm:cybersecurity ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:compliance-control,
        ngm:cyber-security-and-cryptography ;
    vc:slug "siem" ;
    vc:sourceDomain "security" .

ngm:spectrum-allocation a owl:Class ;
    rdfs:label "Spectrum Allocation"@en ;
    rdfs:comment "Spectrum allocation is the regulatory and technical process by which electromagnetic frequency bands are assigned to specific services, operators, or technologies to enable wireless communication without harmful interference. Governments and international bodies define how the radio spectrum is divided, licensed, and managed across uses ranging from mobile broadband and satellite communication to broadcasting and scientific research. Efficient allocation balances competing commercial, public safety, and scientific demands while adapting to evolving technologies such as 5G and millimetre-wave systems."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:regulatory-framework ],
        ngm:infrastructure ;
    skos:broader ngm:infrastructure ;
    vc:contrastsWith ngm:unlicensed-spectrum ;
    vc:dependsOn ngm:governance,
        ngm:standards ;
    vc:enables ngm:mobile-broadband,
        ngm:satellite-communication,
        ngm:wireless-network ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:frequency-band,
        ngm:spectrum-licensing ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:cognitive-radio,
        ngm:network-infrastructure ;
    vc:requires ngm:interference-management,
        ngm:regulatory-framework ;
    vc:slug "spectrum-allocation" ;
    vc:sourceDomain "infrastructure" ;
    vc:standardizedBy ngm:itu ;
    vc:supports ngm:broadcasting,
        ngm:telecommunications ;
    vc:uses ngm:auction-mechanism,
        ngm:dynamic-spectrum-access .

ngm:stochastic-differential-equation a owl:Class ;
    rdfs:label "Stochastic Differential Equation"@en ;
    rdfs:comment "A stochastic differential equation (SDE) is a differential equation in which one or more terms incorporate a stochastic process, typically Brownian motion or white noise, making the solution itself a stochastic process. SDEs generalise ordinary differential equations by including a diffusion term driven by a Wiener process, and their solutions are interpreted via Ito or Stratonovich calculus. SDEs are foundational in financial mathematics, physics, biology, and machine learning — particularly in score-based generative modelling and diffusion models."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:wiener-process ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:measure-theory ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:probability-theory ],
        ngm:differential-equations ;
    vc:bridgesTo ngm:black-scholes-model,
        ngm:neural-ordinary-differential-equation ;
    vc:contrastsWith ngm:differential-equations,
        ngm:ordinary-differential-equation ;
    vc:dependsOn ngm:brownian-motion,
        ngm:fokker-planck-equation ;
    vc:enables ngm:diffusion-models,
        ngm:langevin-dynamics,
        ngm:markov-chain-monte-carlo,
        ngm:score-based-generative-model,
        ngm:stochastic-gradient-descent ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:diffusion-coefficient,
        ngm:drift-coefficient ;
    vc:implements ngm:euler-maruyama-method,
        ngm:milstein-method ;
    vc:isPartOf ngm:stochastic-processes ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:dynamical-systems,
        ngm:markov-processes,
        ngm:optimal-control ;
    vc:requires ngm:ito-calculus,
        ngm:measure-theory,
        ngm:probability-theory,
        ngm:wiener-process ;
    vc:slug "stochastic-differential-equation" ;
    vc:sourceDomain "machine-learning" ;
    vc:uses ngm:numerical-methods,
        ngm:stratonovich-calculus .

ngm:structured-light a owl:Class ;
    rdfs:label "Structured Light"@en ;
    rdfs:comment "Structured light is a 3D surface measurement technique that projects one or more known patterns — typically binary stripe sequences, sinusoidal fringes, or dot grids — onto a scene using a projector or laser, then captures the deformed pattern with one or more calibrated cameras. Because the geometry of the projection and capture system is precisely known, the per-pixel deformation of the projected pattern encodes depth, allowing a complete 3D point cloud or depth map of the object surface to be recovered through triangulation. Structured light systems achieve sub-millimetre to micrometre-scale depth accuracy and are widely deployed in industrial metrology, 3D scanning, face recognition, robotic guidance, and augmented reality depth sensing."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:camera-calibration ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:image-sensor ],
        ngm:depth-sensing ;
    vc:bridgesTo ngm:augmented-reality,
        ngm:machine-learning,
        ngm:robotics ;
    vc:contrastsWith ngm:lidar,
        ngm:photogrammetry,
        ngm:stereo-camera ;
    vc:enables ngm:3-d-reconstruction,
        ngm:face-recognition,
        ngm:industrial-inspection,
        ngm:point-cloud-processing,
        ngm:reverse-engineering,
        ngm:robotic-grasping ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:camera-calibration,
        ngm:depth-sensor,
        ngm:lidar,
        ngm:stereo-camera,
        ngm:time-of-flight-sensor ;
    vc:requires ngm:camera-calibration,
        ngm:image-sensor,
        ngm:infrared-projector ;
    vc:slug "structured-light" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:computer-vision,
        ngm:depth-estimation,
        ngm:triangulation .

ngm:suspicious-activity-report a owl:Class ;
    rdfs:label "Suspicious Activity Report"@en ;
    rdfs:comment "A Suspicious Activity Report (SAR) is a formal regulatory filing through which a financial institution notifies a national financial intelligence unit of transactions or behaviours that may indicate money laundering, terrorist financing, fraud, or other financial crime. SARs are mandated under anti-money-laundering frameworks and must be submitted within prescribed deadlines whenever staff or monitoring systems form a reasonable suspicion. The report documents the parties, accounts, transaction patterns, and the analyst's narrative rationale, while strict confidentiality (tipping-off prohibitions) prevents disclosure to the subject."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:customer-due-diligence ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:transaction-monitoring ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:audit-trail ],
        ngm:regulatory-compliance ;
    vc:dependsOn ngm:know-your-customer ;
    vc:enables ngm:fraud-detection,
        ngm:sanctions-screening ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:anti-money-laundering,
        ngm:regulatory-compliance ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:compliance,
        ngm:financial-regulation,
        ngm:financial-services ;
    vc:requires ngm:audit-trail,
        ngm:customer-due-diligence,
        ngm:transaction-monitoring ;
    vc:slug "suspicious-activity-report" ;
    vc:sourceDomain "finance" ;
    vc:standardizedBy ngm:fatf ;
    vc:supports ngm:basel-iii ;
    vc:uses ngm:risk-based-approach .

ngm:system-prompt a owl:Class ;
    rdfs:label "System Prompt"@en ;
    rdfs:comment "A system prompt is a structured instruction block injected into the context window of a large language model at the start of an inference session, establishing operational context, persona, tool descriptions, safety constraints, and behavioural guidelines before any user turn is processed. Unlike user messages, system prompts are authored by operators rather than end users and govern the model's allowed behaviours, response style, and tool-use policy throughout the session. In agentic and multi-agent architectures, system prompts serve as the primary mechanism for role specialisation, capability scoping, safety guardrail enforcement, and task decomposition. The security boundary between the system prompt and user-controlled input is a central concern in prompt injection defence."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:context-window ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:inference ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:large-language-models ],
        ngm:prompt-engineering ;
    vc:bridgesTo ngm:access-control,
        ngm:software-architecture ;
    vc:contrastsWith ngm:fine-tuning,
        ngm:retrieval-augmented-generation ;
    vc:dependsOn ngm:attention-mechanism,
        ngm:tokenization ;
    vc:enables ngm:agentic-ai,
        ngm:function-calling,
        ngm:reasoning,
        ngm:tool-use ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:ai-safety,
        ngm:chain-of-thought,
        ngm:constitutional-ai-training-methodology,
        ngm:model-context-protocol,
        ngm:prompt-injection,
        ngm:self-consistency ;
    vc:requires ngm:context-window,
        ngm:inference,
        ngm:large-language-models ;
    vc:slug "system-prompt" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:few-shot-learning,
        ngm:instruction-tuning,
        ngm:natural-language-processing .

ngm:technical-committee a owl:Class ;
    rdfs:label "Technical Committee"@en ;
    rdfs:comment "A Technical Committee is a chartered working body within a standards organisation responsible for developing, reviewing and maintaining standards in a defined subject area. It convenes domain experts and stakeholders to draft specifications, resolve comments and reach consensus through structured procedures before publication. Technical committees are the engine of formal standardisation, balancing competing interests to produce interoperable, vendor-neutral specifications."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:compliance-testing ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:standards-organization ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:interoperability ],
        ngm:standards-organization ;
    vc:bridgesTo ngm:vendor-neutrality ;
    vc:enables ngm:interoperability,
        ngm:open-standards,
        ngm:technical-standard ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:compliance-testing ;
    vc:implements ngm:open-standards ;
    vc:isPartOf ngm:standards-body,
        ngm:standards-organization ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:ietf,
        ngm:iso,
        ngm:standards-organization ;
    vc:requires ngm:interoperability,
        ngm:standards-organization ;
    vc:slug "technical-committee" ;
    vc:sourceDomain "standards" ;
    vc:supports ngm:standards-body,
        ngm:vendor-neutrality ;
    vc:uses ngm:compliance-testing,
        ngm:technical-standard .

ngm:technology-adoption a owl:Class ;
    rdfs:label "Technology Adoption"@en ;
    rdfs:comment "The process by which individuals, organizations, and societies integrate new technologies into their workflows, practices, and systems, encompassing awareness, etrial, implementation, and sustained use across AI, blockchain, metaverse, and robotics domains."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:change-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:technology-infrastructure ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:stakeholder ],
