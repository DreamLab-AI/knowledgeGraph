# ==============================================================================
# VISIONCLAW DATA PROPERTY DECLARATIONS
# ==============================================================================

vcw:canonicalUri a owl:DatatypeProperty ;
    rdfs:label "canonicalUri"@en ;
    rdfs:comment "VisionClaw canonical URI"@en ;
    rdfs:range xsd:anyURI .

vcw:contentHash a owl:DatatypeProperty ;
    rdfs:label "contentHash"@en ;
    rdfs:comment "SHA-256 content integrity hash"@en ;
    rdfs:range xsd:string .

vcw:qualityScore a owl:DatatypeProperty ;
    rdfs:label "qualityScore"@en ;
    rdfs:comment "Quality score (0.00-1.00)"@en ;
    rdfs:range xsd:decimal .

vcw:authorityScore a owl:DatatypeProperty ;
    rdfs:label "authorityScore"@en ;
    rdfs:comment "Authority score (0.00-1.00)"@en ;
    rdfs:range xsd:decimal .

vcw:legacyTermId a owl:DatatypeProperty ;
    rdfs:label "legacyTermId"@en ;
    rdfs:comment "Legacy v4 term identifier for traceability"@en ;
    rdfs:range xsd:string .

vcw:ontologyStatus a owl:DatatypeProperty ;
    rdfs:label "ontologyStatus"@en ;
    rdfs:comment "Ontology entry status"@en ;
    rdfs:range xsd:string .

vcw:maturityLevel a owl:DatatypeProperty ;
    rdfs:label "maturityLevel"@en ;
    rdfs:comment "Maturity level of the concept"@en ;
    rdfs:range xsd:string .

vcw:owlRole a owl:DatatypeProperty ;
    rdfs:label "owlRole"@en ;
    rdfs:comment "OWL semantic role classification"@en ;
    rdfs:range xsd:string .

vcw:owlClass a owl:DatatypeProperty ;
    rdfs:label "owlClass"@en ;
    rdfs:comment "OWL class identifier"@en ;
    rdfs:range xsd:string .

vcw:sourceDomain a owl:DatatypeProperty ;
    rdfs:label "sourceDomain"@en ;
    rdfs:comment "Source domain code"@en ;
    rdfs:range xsd:string .

vcw:ontologyIri a owl:DatatypeProperty ;
    rdfs:label "ontologyIri"@en ;
    rdfs:comment "Full ontology IRI"@en ;
    rdfs:range xsd:anyURI .

# ==============================================================================
# OBJECT PROPERTY DECLARATIONS
# ==============================================================================

infrastructure:hasPart a owl:ObjectProperty, owl:TransitiveProperty ;
    rdfs:label "has part"@en ;
    owl:inverseOf infrastructure:isPartOf .

infrastructure:isPartOf a owl:ObjectProperty, owl:TransitiveProperty ;
    rdfs:label "is part of"@en ;
    owl:inverseOf infrastructure:hasPart .

