ngm:driver-software a owl:Class ;
    rdfs:label "Driver Software"@en ;
    rdfs:comment "System-level software components that enable communication between operating systems and extended reality (XR) hardware devices, translating high-level application commands into hardware-specific instructions for VR headsets, AR glasses, haptic controllers, and spatial computing peripherals."@en ;
    rdfs:subClassOf ngm:sc-platform-and-environment,
        ngm:system-software ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:enables ngm:extended-reality-xr ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:slug "driver-software" ;
    vc:sourceDomain "spatial-computing" .

ngm:dspy a owl:Class ;
    rdfs:label "DSPy"@en ;
    rdfs:comment "DSPy is an open-source framework for programming language models in which developers declare the structure of a task using typed signatures and composable modules, and an optimiser automatically generates and tunes the prompts and few-shot examples needed to maximise a defined metric. By treating prompts as learnable parameters rather than hand-written strings, DSPy shifts language-model application development from manual prompt engineering toward systematic, metric-driven compilation of pipelines. It targets reliable, portable multi-stage LLM programs such as retrieval-augmented and agentic systems."@en ;
    rdfs:subClassOf ngm:llm-application-framework ;
    vc:enables ngm:llm-orchestration ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:chain-of-thought-prompting,
        ngm:llm-agents ;
    vc:slug "dspy" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:prompt-engineering .

ngm:dynamic-character-animation a owl:Class ;
    rdfs:label "Dynamic Character Animation"@en ;
    rdfs:comment "Real-time procedural animation techniques that enable 3D avatars and characters to move, express, and respond dynamically to user input and environmental stimuli in metaverse environments, utilising motion capture, rigging systems, and AI-driven motion synthesis."@en ;
    rdfs:subClassOf ngm:3-d-animation,
        ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:enables ngm:immersive-experiences ;
    vc:hasMaturity ngmi:maturity-draft ;
