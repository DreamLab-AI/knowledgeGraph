    vc:slug "gauge-voting" ;
    vc:sourceDomain "blockchain" .

ngm:gaussian-distribution a owl:Class ;
    rdfs:label "Gaussian Distribution"@en ;
    rdfs:comment "A continuous probability distribution, also called the normal distribution, characterised by a symmetric bell-shaped density defined by its mean and variance. It arises naturally via the central limit theorem and is foundational to statistics, machine learning, and signal processing."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:statistics ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:probability-theory ],
        ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:bridgesTo ngm:anomaly-detection,
        ngm:sensor-fusion,
        ngm:signal-processing ;
    vc:contrastsWith ngm:laplace-distribution,
        ngm:poisson-distribution,
        ngm:student-t-distribution ;
    vc:dependsOn ngm:central-limit-theorem,
        ngm:linear-algebra ;
    vc:enables ngm:bayesian-inference,
        ngm:gaussian-process,
        ngm:kalman-filter,
        ngm:maximum-likelihood-estimation ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:mean,
        ngm:standard-deviation,
        ngm:variance ;
    vc:implements ngm:probability-distribution ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:gaussian-mixture-model,
        ngm:principal-component-analysis,
        ngm:variational-autoencoder ;
    vc:requires ngm:calculus,
        ngm:probability-theory,
        ngm:statistics ;
    vc:slug "gaussian-distribution" ;
    vc:sourceDomain "machine-learning" ;
    vc:uses ngm:expectation-maximisation,
        ngm:markov-chain-monte-carlo .

ngm:gemini-multimodal-language-model a owl:Class ;
    rdfs:label "Gemini Multimodal Language Model"@en ;
    rdfs:comment "Gemini is Google DeepMind's family of natively multimodal large language models, announced in December 2023 as the successor to PaLM 2, designed from the ground up to reason across text, images, audio, video, and code within a single unified architecture. The Gemini family spans Ultra, Pro, Flash, and Nano capability tiers, enabling deployment from data-centre scale to on-device inference. It directly competes with OpenAI's GPT-4 family and Anthropic Claude as one of the three dominant frontier model lineages."@en ;
    rdfs:subClassOf ngm:multimodal-ai-architecture-ai ;
    vc:contrastsWith ngm:constitutional-ai-training-methodology-language-model-family,
        ngm:instruction-following-conversational-ai-system ;
    vc:dependsOn ngm:cloud-platform,
        ngm:high-performance-computing ;
    vc:enables ngm:agentic-workflow,
        ngm:generative-ai,
        ngm:multimodal-ai-architecture-ai ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:constitutional-ai-training-methodology-language-model-family,
        ngm:instruction-following-conversational-ai-system,
        ngm:large-language-models ;
    vc:slug "gemini-multimodal-language-model" ;
    vc:sourceDomain "ai" ;
    vc:standardizedBy ngm:evaluation-metric ;
    vc:uses ngm:fine-tuning,
        ngm:multimodal-ai-architecture-understanding,
        ngm:transformer .

