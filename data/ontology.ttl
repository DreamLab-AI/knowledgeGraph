ngm:beir-benchmark a owl:Class ;
    rdfs:comment "BEIR (Benchmarking IR) is a heterogeneous benchmark suite for evaluating the zero-shot generalisation of information retrieval models across eighteen diverse datasets spanning domains including biomedical, legal, financial, and Wikipedia text. It measures how well retrieval systems transfer across topic domains and retrieval task types without domain-specific fine-tuning, providing a standardised framework for comparing dense, sparse, and hybrid retrieval approaches."@en ;
    rdfs:label "BEIR Benchmark"@en ;
    rdfs:subClassOf ngm:benchmark-evaluation ;
    rdfs:subClassOf ngm:evaluation-benchmarks-and-leaderboards ;
    rdfs:subClassOf ngm:information-retrieval ;
    rdfs:subClassOf ngm:natural-language-processing ;
