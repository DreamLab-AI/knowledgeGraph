ngm:research-university a skos:Concept ;
    rdfs:label "Research University"@en .

ngm:resource-allocation a owl:Class ;
    rdfs:label "Resource Allocation"@en ;
    rdfs:comment "Resource allocation is the economic and computational mechanism by which scarce resources, such as compute, capital, bandwidth, or stake, are distributed among competing uses or participants. In market and protocol contexts it determines who receives what and on what terms, often via pricing, auctions, or scheduling policies. Efficient allocation underpins value transfer and incentive alignment across economic and distributed systems."@en ;
    rdfs:subClassOf ngm:economic-mechanism ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:economics,
