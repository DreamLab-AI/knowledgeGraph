ngm:user-interface-standard a owl:Class ;
    rdfs:label "User Interface Standard"@en ;
    rdfs:comment "Specifications and guidelines that define consistent patterns, components, and interactions for user interfaces in metaverse and XR environments, ensuring usability, accessibility, and cross-platform consistency."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
