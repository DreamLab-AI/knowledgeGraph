    vc:slug "it-calculus" ;
    vc:sourceDomain "ai" .

ngm:itil a owl:Class ;
    rdfs:label "Itil"@en ;
    rdfs:comment "ITIL (Information Technology Infrastructure Library) is a widely adopted framework of best practices for IT service management, describing how to plan, deliver, operate and continually improve technology services aligned to business value. It organises practices around a service value system spanning strategy, design, transition, operation and improvement, including disciplines such as incident, problem and change management. ITIL provides a common vocabulary and process structure for IT operations and governance."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:incident-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:change-management ],
        ngm:governance-framework ;
