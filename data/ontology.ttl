    a owl:Restriction ;
    owl:onProperty infrastructure:enables ;
    owl:someValuesFrom distributed-collaboration:TELE002telecollaboration
] .

# Metaverse-Telepresence Bridge
distributed-collaboration:MetaverseTelepresenceBridge rdf:type owl:Class ;
    rdfs:subClassOf distributed-collaboration:ConvergenceConcept ;
    rdfs:label "Metaverse-Telepresence Bridge"@en ;
    rdfs:comment "\"The conceptual and technical integration between metaverse virtual environments and telepresence technologies, where participants experience remote presence in persistent 3D virtual worlds through immersive XR platforms, combining metaverse spatial computing infrastructure with telepresence social presence mechanisms to enable embodied collaboration in shared digital spaces.\""@en ;
    skos:prefLabel "Metaverse-Telepresence Bridge"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:distributed-collaboration:metaverse-telepresence-bridge" ;
    owl:sameAs <urn:visionclaw:concept:distributed-collaboration:metaverse-telepresence-bridge> ;
    vcw:contentHash "sha256-12-8480d4a8342a" ;
    vcw:qualityScore "0.6"^^xsd:decimal ;
    vcw:legacyTermId "TC-0191" ;
    vcw:ontologyStatus "active" ;
    vcw:maturityLevel "draft" ;
    vcw:authorityScore "0.0"^^xsd:decimal ;
    dcterms:identifier "TC-0191" ;
    dcterms:subject "distributed-collaboration" ;
    owl:versionInfo "2.0.0" ;
    dcterms:created "2026-04-26T00:00:00Z"^^xsd:dateTime ;
    dcterms:modified "2026-04-26T00:00:00Z"^^xsd:dateTime ;
    vcw:owlRole "Concept" .

distributed-collaboration:MetaverseTelepresenceBridge rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty infrastructure:requires ;
    owl:someValuesFrom distributed-collaboration:TELE020virtualrealitytelepresence
] .

distributed-collaboration:MetaverseTelepresenceBridge rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty infrastructure:enables ;
    owl:someValuesFrom distributed-collaboration:EmbodiedMetaverseCollaboration
] .

# Robotics-Telepresence Bridge
distributed-collaboration:RoboticsTelepresenceBridge rdf:type owl:Class ;
    rdfs:subClassOf distributed-collaboration:ConvergenceConcept ;
    rdfs:label "Robotics-Telepresence Bridge"@en ;
    rdfs:comment "\"The conceptual and technical integration between robotics systems and telepresence technologies, where remote operators experience physical presence in distant real-world locations through robot-mediated perception and action, combining robotic manipulation capabilities with telepresence social presence and immersive interfaces to enable embodied remote interaction with physical environments.\""@en ;
    skos:prefLabel "Robotics-Telepresence Bridge"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:distributed-collaboration:robotics-telepresence-bridge" ;
    owl:sameAs <urn:visionclaw:concept:distributed-collaboration:robotics-telepresence-bridge> ;
    vcw:contentHash "sha256-12-537f63449934" ;
    vcw:qualityScore "0.6"^^xsd:decimal ;
    vcw:legacyTermId "TC-0193" ;
    vcw:ontologyStatus "active" ;
    vcw:maturityLevel "mature" ;
    vcw:authorityScore "0.0"^^xsd:decimal ;
    dcterms:identifier "TC-0193" ;
    dcterms:subject "distributed-collaboration" ;
    owl:versionInfo "2.0.0" ;
    dcterms:created "2026-04-26T00:00:00Z"^^xsd:dateTime ;
    dcterms:modified "2026-04-26T00:00:00Z"^^xsd:dateTime ;
    vcw:owlRole "Concept" .

distributed-collaboration:RoboticsTelepresenceBridge rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty infrastructure:requires ;
    owl:someValuesFrom distributed-collaboration:TELE203hapticfeedbacktelepresence
] .

distributed-collaboration:RoboticsTelepresenceBridge rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty infrastructure:enables ;
    owl:someValuesFrom distributed-collaboration:HazardousEnvironmentAccess
] .

# Robotic Telepresence
distributed-collaboration:RoboticTelepresence rdf:type owl:Class ;
    rdfs:subClassOf distributed-collaboration:TELE001telepresence ;
    rdfs:label "Robotic Telepresence"@en ;
    rdfs:comment "\"The projection of human presence into remote physical locations through mobile robotic platforms equipped with cameras, displays, microphones, and speakers, enabling remote operators to navigate environments, interact with people, and manipulate objects as if physically present, bridging virtual and physical collaboration modalities.\""@en ;
    skos:prefLabel "Robotic Telepresence"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:distributed-collaboration:robotic-telepresence" ;
    owl:sameAs <urn:visionclaw:concept:distributed-collaboration:robotic-telepresence> ;
    vcw:contentHash "sha256-12-a48fcc3fd5e4" ;
    vcw:qualityScore "0.5"^^xsd:decimal ;
    vcw:legacyTermId "TC-0200" ;
    vcw:ontologyStatus "active" ;
    vcw:maturityLevel "mature" ;
    vcw:authorityScore "0.0"^^xsd:decimal ;
    dcterms:identifier "TC-0200" ;
    dcterms:subject "distributed-collaboration" ;
    owl:versionInfo "2.0.0" ;
    dcterms:created "2026-04-26T00:00:00Z"^^xsd:dateTime ;
    dcterms:modified "2026-04-26T13:00:00Z"^^xsd:dateTime ;
    vcw:owlRole "Object" .

distributed-collaboration:RoboticTelepresence rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty infrastructure:requires ;
    owl:someValuesFrom distributed-collaboration:AutonomousNavigation
] .

distributed-collaboration:RoboticTelepresence rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty infrastructure:enables ;
    owl:someValuesFrom distributed-collaboration:RemoteOfficeAttendance
] .

# Teleoperation Systems
distributed-collaboration:TeleoperationSystems rdf:type owl:Class ;
    rdfs:subClassOf distributed-collaboration:RoboticTelepresence ;
    rdfs:label "Teleoperation Systems"@en ;
    rdfs:comment "\"Robotic control systems enabling human operators to command and manipulate remote robots through intuitive interfaces, transmitting operator intentions to robot actuators whilst providing sensory feedback (visual, auditory, haptic) from the robot to the operator, creating bidirectional human-machine coupling for remote physical interaction.\""@en ;
    skos:prefLabel "Teleoperation Systems"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:distributed-collaboration:teleoperation-systems" ;
    owl:sameAs <urn:visionclaw:concept:distributed-collaboration:teleoperation-systems> ;
    vcw:contentHash "sha256-12-21f72543cf2d" ;
    vcw:qualityScore "0.35"^^xsd:decimal ;
    vcw:legacyTermId "TC-0201" ;
    vcw:ontologyStatus "active" ;
    vcw:maturityLevel "mature" ;
    vcw:authorityScore "0.0"^^xsd:decimal ;
    dcterms:identifier "TC-0201" ;
    dcterms:subject "distributed-collaboration" ;
    owl:versionInfo "2.0.0" ;
    dcterms:created "2026-04-26T00:00:00Z"^^xsd:dateTime ;
    dcterms:modified "2026-04-26T13:00:00Z"^^xsd:dateTime ;
    vcw:owlRole "Object" .

# Haptic Feedback Telepresence
distributed-collaboration:HapticFeedbackTelepresence rdf:type owl:Class ;
    rdfs:subClassOf distributed-collaboration:HapticTechnology ;
    rdfs:label "Haptic Feedback Telepresence"@en ;
    rdfs:comment "\"The integration of haptic (tactile and kinesthetic) feedback devices into telepresence systems, enabling remote operators to feel forces, textures, and vibrations from distant environments through force-feedback gloves, exoskeletons, or handheld controllers, creating bidirectional touch sensation for immersive remote interaction with physical or virtual objects.\""@en ;
    skos:prefLabel "Haptic Feedback Telepresence"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:distributed-collaboration:haptic-feedback-telepresence" ;
    owl:sameAs <urn:visionclaw:concept:distributed-collaboration:haptic-feedback-telepresence> ;
    vcw:contentHash "sha256-12-fc72e736c55d" ;
    vcw:qualityScore "0.5"^^xsd:decimal ;
    vcw:legacyTermId "TC-0203" ;
    vcw:ontologyStatus "active" ;
    vcw:maturityLevel "developing" ;
    vcw:authorityScore "0.0"^^xsd:decimal ;
    dcterms:identifier "TC-0203" ;
    dcterms:subject "distributed-collaboration" ;
    owl:versionInfo "2.0.0" ;
    dcterms:created "2026-04-26T00:00:00Z"^^xsd:dateTime ;
    dcterms:modified "2026-04-26T13:00:00Z"^^xsd:dateTime ;
    vcw:owlRole "Object" .

# Blockchain Collaboration
distributed-collaboration:BlockchainCollaboration rdf:type owl:Class ;
    rdfs:subClassOf distributed-collaboration:TELE002telecollaboration ;
    rdfs:label "Blockchain Collaboration"@en ;
    rdfs:comment "\"The use of blockchain distributed ledger technology, smart contracts, and cryptocurrency systems to coordinate, govern, and compensate geographically distributed teams, enabling trustless collaboration through cryptographic verification, automated enforcement of agreements, and transparent record-keeping without centralised intermediaries.\""@en ;
    skos:prefLabel "Blockchain Collaboration"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:distributed-collaboration:blockchain-collaboration" ;
    owl:sameAs <urn:visionclaw:concept:distributed-collaboration:blockchain-collaboration> ;
    vcw:contentHash "sha256-12-9ab688f467ad" ;
    vcw:qualityScore "0.5"^^xsd:decimal ;
    vcw:legacyTermId "TC-0250" ;
    vcw:ontologyStatus "active" ;
    vcw:maturityLevel "developing" ;
    vcw:authorityScore "0.0"^^xsd:decimal ;
    dcterms:identifier "TC-0250" ;
    dcterms:subject "distributed-collaboration" ;
    owl:versionInfo "2.0.0" ;
    dcterms:created "2026-04-26T00:00:00Z"^^xsd:dateTime ;
    dcterms:modified "2026-04-26T13:00:00Z"^^xsd:dateTime ;
    vcw:owlRole "Process" .

distributed-collaboration:BlockchainCollaboration rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty infrastructure:requires ;
    owl:someValuesFrom distributed-collaboration:ConsensusProtocol
] .

distributed-collaboration:BlockchainCollaboration rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty infrastructure:enables ;
    owl:someValuesFrom distributed-collaboration:TransparentDecisionMaking
] .

# Smart Contract Coordination
distributed-collaboration:SmartContractCoordination rdf:type owl:Class ;
    rdfs:subClassOf distributed-collaboration:SmartContract ;
    rdfs:label "Smart Contract Coordination"@en ;
    rdfs:comment "\"The use of blockchain smart contracts—self-executing programs stored on distributed ledgers—to automate coordination, task allocation, payment distribution, and milestone verification in distributed teams, enabling trustless collaboration through cryptographically enforced agreements that execute deterministically without centralised intermediaries.\""@en ;
    skos:prefLabel "Smart Contract Coordination"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:distributed-collaboration:smart-contract-coordination" ;
    owl:sameAs <urn:visionclaw:concept:distributed-collaboration:smart-contract-coordination> ;
    vcw:contentHash "sha256-12-e3b8a87847c2" ;
    vcw:qualityScore "0.5"^^xsd:decimal ;
