    a owl:Restriction ;
    owl:onProperty ngm:relatedTo ;
    owl:someValuesFrom mv:HapticFeedback
] .

mv:VirtualPhysicalCollision rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:relatedTo ;
    owl:someValuesFrom mv:SafetySystems
] .

# Virtual Presence
mv:VirtualPresence a owl:Class ;
    rdfs:subClassOf mv:Telepresence ;
    rdfs:label "Virtual Presence"@en ;
    rdfs:comment "The psychological experience of being there within a virtual place or situation, encompassing spatial presence (sense of location), social presence (connection with others), and self-presence (embodiment in virtual form), achieved through telepresence technologies and immersive environments."@en ;
    skos:prefLabel "Virtual Presence"@en ;
    dcterms:identifier "MV-10137" ;
    dcterms:subject "mv" .

mv:VirtualPresence rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:relatedTo ;
    owl:someValuesFrom mv:VirtualReality
] .

mv:VirtualPresence rdfs:subClassOf [
