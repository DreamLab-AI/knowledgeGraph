ngm:message-authentication-code a owl:Class ;
    rdfs:label "Message Authentication Code"@en ;
    rdfs:comment "A Message Authentication Code (MAC) is a fixed-size cryptographic tag generated from an arbitrary-length message and a shared secret key using a keyed hash or block-cipher-based algorithm, providing simultaneous data integrity verification and authentication of the sender to any party holding the same secret key. Unlike digital signatures, MACs are symmetric and do not provide non-repudiation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:key-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:symmetric-key ],
        ngm:cryptography ;
    vc:bridgesTo ngm:distributed-systems-security,
        ngm:iot-security ;
    vc:contrastsWith ngm:digital-signature,
        ngm:non-repudiation ;
    vc:enables ngm:authenticated-encryption,
        ngm:data-integrity,
        ngm:message-authentication ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:implements ngm:hmac ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:authentication,
        ngm:cryptographic-protocol,
        ngm:post-quantum-cryptography ;
    vc:requires ngm:key-management,
        ngm:symmetric-key ;
    vc:slug "message-authentication-code" ;
    vc:sourceDomain "security" ;
    vc:standardizedBy ngm:ietf,
        ngm:nist ;
    vc:supports ngm:ipsec,
        ngm:tls ;
    vc:uses ngm:block-cipher,
