    vc:contrastsWith ngm:multi-signature-wallet ;
    vc:enables ngm:multi-sig-governance ;
    vc:enables ngm:self-custody ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:distributed-key-generation ;
    vc:implements ngm:multi-party-computation ;
    vc:implements ngm:threshold-signature-scheme ;
    vc:qualityScore "0.62"^^xsd:float ;
