ngm:feature-extraction a owl:Class ;
    rdfs:label "Feature Extraction"@en ;
    rdfs:comment "Feature Extraction is the process of transforming raw data into a reduced set of meaningful representations that capture task-relevant information for machine learning models. Deep learning architectures perform hierarchical feature extraction automatically through successive layers, whilst classical techniques such as PCA or wavelet transforms require manual engineering. Feature extraction reduces dimensionality, improves computational efficiency, and determines the quality of downstream model predictions."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:training-data ],
        ngm:representation-learning ;
    vc:bridgesTo ngm:computer-vision,
        ngm:speech-recognition ;
    vc:contrastsWith ngm:feature-engineering,
        ngm:raw-data-processing ;
    vc:dependsOn ngm:deep-learning,
        ngm:signal-processing ;
    vc:enables ngm:anomaly-detection,
        ngm:dimensionality-reduction,
        ngm:natural-language-processing,
        ngm:object-recognition ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:bag-of-words,
        ngm:principal-component-analysis,
        ngm:wavelet-transform ;
    vc:isPartOf ngm:data-preprocessing,
        ngm:machine-learning-pipeline ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:embedding-model,
        ngm:feature-selection,
        ngm:transfer-learning ;
    vc:requires ngm:data-normalisation,
        ngm:training-data ;
    vc:slug "feature-extraction" ;
    vc:sourceDomain "machine-learning" ;
    vc:uses ngm:autoencoder,
        ngm:convolutional-neural-network,
        ngm:recurrent-neural-network,
        ngm:transformer-architecture .

ngm:kinematics a owl:Class ;
    rdfs:label "Kinematics"@en ;
    rdfs:comment "Kinematics is the branch of mechanics that studies the geometry and mathematics of motion — positions, velocities, accelerations, and trajectories of bodies — without consideration of the forces or torques that cause that motion. In robotics and spatial computing, it encompasses forward kinematics (mapping joint-space parameters to Cartesian end-effector pose via homogeneous transformation matrices and Denavit-Hartenberg conventions) and inverse kinematics (solving the reverse mapping from desired pose to joint configurations). Kinematic analysis underpins motion planning, trajectory generation, workspace characterisation, collision avoidance, and animation systems across robotics, biomechanics, computer graphics, and autonomous vehicles."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:differential-kinematics ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:forward-kinematics ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:inverse-kinematics ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:coordinate-frame ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:denavit-hartenberg-parameters ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:jacobian-matrix ],
        ngm:robo-navigation-and-planning ;
    skos:broader ngm:robo-navigation-and-planning ;
    vc:bridgesTo ngm:augmented-reality,
        ngm:computer-animation,
        ngm:digital-twin ;
    vc:contrastsWith ngm:dynamics,
        ngm:statics ;
    vc:dependsOn ngm:linear-algebra,
        ngm:rigid-body-mechanics ;
    vc:enables ngm:collision-avoidance,
        ngm:motion-planning,
        ngm:robot-dynamics,
        ngm:trajectory-generation,
        ngm:workspace-analysis ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:differential-kinematics,
        ngm:forward-kinematics,
        ngm:inverse-kinematics,
        ngm:jacobian-matrix ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:autonomous-vehicles,
        ngm:biomechanics,
        ngm:mechanics ;
    vc:requires ngm:coordinate-frame,
        ngm:denavit-hartenberg-parameters,
        ngm:homogeneous-transformation ;
    vc:slug "kinematics" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:end-effector,
        ngm:kinematic-chain,
        ngm:manipulator,
        ngm:robot-joint .

ngm:supervised-learning a owl:Class ;
    rdfs:label "Supervised Learning"@en ;
    rdfs:comment "Supervised Learning is the machine learning paradigm where models learn from labeled training data to predict outputs for new, unseen inputs. The learning algorithm finds patterns mapping input features to target labels, guided by a loss function measuring prediction errors. Key tasks include classification (discrete labels) and regression (continuous values), spanning linear models, decision trees, support vector machines, neural networks, and ensemble methods."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:loss-function ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:training-data ],
