ngm:network-hash-rate a owl:Class ;
    rdfs:label "Network Hash Rate"@en ;
    rdfs:comment "The aggregate computational power (measured in hashes per second) expended by all miners participating in a proof-of-work blockchain at a given time. A higher network hash rate increases attack cost for a 51% attack and triggers upward difficulty adjustments to maintain target block times; conversely, drops in hash rate trigger downward adjustments."@en ;
    rdfs:subClassOf ngm:bc-protocol-and-consensus,
        ngm:blockchain-entity,
        ngm:consensus-protocol ;
    skos:broader ngm:bc-protocol-and-consensus ;
