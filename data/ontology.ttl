    vc:slug "architectural-layer" ;
    vc:sourceDomain "infrastructure" .

ngm:artificial-superintelligence-theory a owl:Class ;
    rdfs:label "Artificial Superintelligence Theory"@en ;
    rdfs:comment "A hypothetical form of artificial intelligence that surpasses human cognitive performance across all domains, capable of recursive self-improvement leading to an intelligence explosion. Distinguished from artificial general intelligence by the degree of capability surplus; considered an existential risk scenario requiring robust safety and alignment research before any attempt at development."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:artificial-general-intelligence ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:machine-learning-discipline ],
        ngm:infra-computing-and-cloud ;
    skos:broader ngm:infra-computing-and-cloud ;
    vc:contrastsWith ngm:artificial-intelligence ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:ai-risks,
        ngm:ai-safety,
        ngm:singularity ;
    vc:requires ngm:artificial-general-intelligence,
        ngm:machine-learning-discipline ;
    vc:slug "artificial-superintelligence-theory" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:aiethics .

ngm:asset-creation a owl:Class ;
    rdfs:label "Asset Creation"@en ;
    rdfs:comment "Asset Creation is the structured practice of producing digital or physical resources — including geometry, textures, audio, code, and data — intended for use within interactive experiences, virtual environments, or production pipelines. It encompasses the full authoring lifecycle from concept through final deliverable, applying artistic, technical, and automated methods to yield artefacts that meet quality, format, and performance requirements."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:3-d-modeling ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:3-d-animation ],
        ngm:content-creation ;
    vc:enables ngm:asset-pipeline,
        ngm:digital-content-creation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:3-d-animation,
        ngm:3-d-modeling ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:slug "asset-creation" ;
    vc:sourceDomain "metaverse" ;
    vc:uses ngm:game-engine,
        ngm:procedural-content-generation .

ngm:asset-database a owl:Class ;
    rdfs:label "Asset Database"@en ;
    rdfs:comment "An Asset Database is a structured, queryable repository that stores descriptive records, binary references, version histories, and relational metadata for digital assets within a production or distribution system. It provides the persistent backbone enabling discovery, retrieval, provenance tracking, and lifecycle management of assets across teams and pipelines."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:metadata ],
        ngm:database-system ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:metadata ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:knowledge-graph ;
    vc:slug "asset-database" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:asset-management-system,
        ngm:digital-asset-management ;
    vc:uses ngm:metadata-schema,
        ngm:search-engine .

ngm:asset-metadata a owl:Class ;
    rdfs:label "Asset Metadata"@en ;
    rdfs:comment "Asset Metadata is the structured descriptive, administrative, and technical information attached to a digital asset that contextualises it within a system without being the primary content of that asset. It encompasses identifiers, provenance records, format specifications, rights information, semantic tags, and dependency relationships, enabling discovery, validation, licensing, and lifecycle management."@en ;
    rdfs:subClassOf ngm:metadata ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:knowledge-graph,
        ngm:ontology ;
    vc:slug "asset-metadata" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:asset-management-system,
        ngm:digital-asset-management ;
    vc:uses ngm:metadata-schema,
        ngm:metadata-standard .

ngm:asset-service a owl:Class ;
    rdfs:label "Asset Service"@en ;
    rdfs:comment "An Asset Service is a runtime or backend system that exposes digital assets and their associated metadata to consuming applications through well-defined APIs, handling storage, retrieval, transcoding, access control, and lifecycle operations as managed infrastructure. It abstracts the complexity of distributed storage and processing from client applications, enabling consistent, scalable access to asset libraries."@en ;
    rdfs:subClassOf ngm:service-layer ;
    vc:enables ngm:microservices-architecture ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:platform-service ;
    vc:slug "asset-service" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:asset-management-system,
        ngm:content-pipeline ;
    vc:uses ngm:api-management,
        ngm:digital-asset-management .

ngm:at-protocol a owl:Class ;
    rdfs:label "At Protocol"@en ;
    rdfs:comment "The AT Protocol (Authenticated Transfer Protocol) is an open, federated networking protocol for decentralised social applications, originally developed for Bluesky, that combines portable accounts, signed data repositories, and account migration with a separation between data hosting and algorithmic curation. It uses decentralised identifiers and content-addressed records so users own their identity and data independently of any single provider. The protocol aims to deliver large-scale interoperable social networking with user choice over feeds and moderation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:content-addressing ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:content-addressing ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:did ],
        ngm:open-standards ;
    vc:bridgesTo ngm:infrastructure ;
    vc:contrastsWith ngm:activity-pub ;
    vc:dependsOn ngm:did ;
    vc:enables ngm:decentralised-identity,
        ngm:federation ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:content-addressing ;
    vc:implements ngm:protocol ;
    vc:isPartOf ngm:open-standards ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:activity-pub,
        ngm:cross-platform-identity ;
    vc:requires ngm:content-addressing,
        ngm:did ;
    vc:slug "at-protocol" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:federation ;
    vc:uses ngm:content-addressing,
        ngm:did .

ngm:atomic-broadcast a owl:Class ;
    rdfs:label "Atomic Broadcast"@en ;
    rdfs:comment "Atomic broadcast (also called total-order broadcast) is a distributed communication primitive guaranteeing that all correct processes deliver the same set of messages in the same total order. It strengthens reliable broadcast with an ordering property, ensuring agreement on both the content and sequence of delivered messages. Atomic broadcast is equivalent in power to consensus and underpins state-machine replication."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:message-passing ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:fault-tolerance ],
        ngm:distributed-systems ;
    vc:bridgesTo ngm:practical-byzantine-fault-tolerance ;
    vc:contrastsWith ngm:byzantine-generals-problem ;
    vc:dependsOn ngm:distributed-system ;
    vc:enables ngm:consensus,
        ngm:replication,
        ngm:state-machine-replication ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:blockchain-consensus,
        ngm:clock-synchronization,
        ngm:consensus ;
    vc:requires ngm:fault-tolerance,
        ngm:message-passing ;
    vc:slug "atomic-broadcast" ;
    vc:sourceDomain "distributed-systems" ;
    vc:supports ngm:byzantine-fault-tolerance,
        ngm:crash-fault-tolerance ;
    vc:uses ngm:paxos,
        ngm:raft .

ngm:attention-aware-interaction a owl:Class ;
    rdfs:label "Attention Aware Interaction"@en ;
    rdfs:comment "Attention Aware Interaction refers to human-computer interaction techniques that leverage eye tracking, gaze detection, and attention modeling to understand user focus and adapt interfaces accordingly, enabling foveated rendering, gaze-based selection, and contextual content presentation in VR, A..."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:eye-tracking ],
        ngm:ai-application,
        ngm:human-computer-interaction ;
    skos:broader ngm:ai-application ;
    vc:enables ngm:adaptive-interfaces,
        ngm:foveated-rendering ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:eye-tracking ;
    vc:slug "attention-aware-interaction" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:augmented-reality-collaboration a owl:Class ;
    rdfs:label "Augmented Reality Collaboration"@en ;
    rdfs:comment "\"Collaborative work where geographically distributed team members share a common augmented reality environment, viewing and manipulating virtual 3D objects overlaid on their respective physical spaces whilst communicating via spatial audio and holographic avatars, enabling hybrid physical-virtual..."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:web-rtc ],
        ngm:dc-telepresence,
        ngm:telecollaboration ;
    skos:broader ngm:dc-telepresence ;
    vc:enables ngm:collaborative-systems-modality-design ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires ngm:web-rtc ;
    vc:slug "augmented-reality-collaboration" ;
    vc:sourceDomain "distributed-collaboration" .

ngm:augmented-reality-tracking a owl:Class ;
    rdfs:label "Augmented Reality Tracking"@en ;
    rdfs:comment "Augmented reality tracking is the continuous estimation of a device's position and orientation relative to the physical environment so that virtual content can be registered and rendered as if anchored in the real world. It fuses camera imagery, inertial measurements and depth or feature data to maintain a stable six-degree-of-freedom pose at interactive rates. Robust tracking is the foundation of believable spatial overlay, addressing drift, occlusion and relocalisation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:pose-estimation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:slam ],
        ngm:pose-estimation ;
    vc:bridgesTo ngm:augmented-reality,
        ngm:spatial-mapping ;
    vc:dependsOn ngm:visual-slam ;
    vc:enables ngm:localization,
        ngm:marker-based-tracking ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:marker-based-tracking ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:localization,
        ngm:tracking ;
    vc:requires ngm:pose-estimation,
        ngm:slam ;
    vc:slug "augmented-reality-tracking" ;
    vc:sourceDomain "robotics" ;
    vc:supports ngm:augmented-reality,
        ngm:spatial-computing ;
    vc:uses ngm:computer-vision,
        ngm:extended-kalman-filter,
        ngm:kalman-filter,
        ngm:sensor-fusion .

ngm:automated-design a owl:Class ;
    rdfs:label "Automated Design"@en ;
    rdfs:comment "Automated Design is the application of computational algorithms, machine learning, and optimisation techniques — spanning combinatorial search, gradient-based topology optimisation, evolutionary algorithms, reinforcement learning, and deep generative modelling — to generate, evaluate, and iteratively refine design artefacts with minimal or no step-by-step human direction. The field encompasses electronic design automation (EDA) for integrated circuits and printed circuit boards, neural architecture search (NAS) for machine-learning model topologies, topology optimisation for structural engineering, generative architectural layout synthesis, and LLM-assisted hardware description language generation. The unifying abstraction is the design space traversal guided by evaluation functions encoding physical, functional, economic, or aesthetic criteria: the algorithm explores candidate designs, evaluates each against the specified criteria, and updates its search strategy to navigate toward regions of the space satisfying design objectives. Commercial impact has been transformative across semiconductor, aerospace, automotive, and construction sectors, where design cycles have been compressed from months to days whilst exploring solution spaces too large for human enumeration."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:neural-architecture-search ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:hyperparameter-optimisation ],
        ngm:generative-design,
        ngm:optimisation ;
    vc:dependsOn ngm:multi-objective-optimisation,
        ngm:physics-simulation ;
    vc:enables ngm:automl,
        ngm:digital-twin,
        ngm:generative-design-tool,
        ngm:smart-manufacturing ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:electronic-design-automation,
        ngm:hyperparameter-optimisation,
        ngm:neural-architecture-search,
        ngm:topology-optimisation ;
    vc:implements ngm:parametric-design-methodology ;
    vc:qualityScore "0.88"^^xsd:float ;
    vc:relatedTo ngm:additive-manufacturing,
        ngm:cad-software,
        ngm:constraint-based-design,
        ngm:formal-verification,
        ngm:intellectual-property ;
    vc:slug "automated-design" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:algorithm,
        ngm:deep-generative-model,
        ngm:evolutionary-algorithm,
        ngm:graph-neural-network,
        ngm:machine-learning-discipline,
        ngm:reinforcement-learning,
        ngm:simulation,
        ngm:surrogate-model .

ngm:automated-theorem-proving a owl:Class ;
    rdfs:label "Automated Theorem Proving"@en ;
    rdfs:comment "Automated theorem proving is the subfield of automated reasoning concerned with constructing formal proofs of mathematical or logical statements by machine. Given a set of axioms and a conjecture expressed in a formal logic, an automated theorem prover searches for a derivation that establishes the conjecture as a consequence of the axioms. Techniques span resolution, tableaux, term rewriting and decision procedures, and underpin formal verification, mathematics and AI reasoning."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:automated-reasoning ],
        ngm:automated-reasoning ;
    vc:bridgesTo ngm:formal-verification,
        ngm:symbolic-ai ;
    vc:dependsOn ngm:automated-reasoning ;
    vc:enables ngm:formal-verification,
        ngm:theorem-proving ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:theorem-proving ;
    vc:isPartOf ngm:automated-reasoning ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:constraint-satisfaction,
        ngm:symbolic-ai,
        ngm:theorem-proving ;
    vc:requires ngm:automated-reasoning ;
    vc:slug "automated-theorem-proving" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:formal-verification ;
    vc:uses ngm:constraint-satisfaction .

ngm:automatic1111 a owl:Class ;
    rdfs:label "Automatic1111"@en ;
    rdfs:comment "An open-source, browser-based graphical user interface for Stable Diffusion and compatible diffusion models, providing extensive control over image-generation parameters, model loading, and an extensible plugin architecture. Automatic1111 (AUTOMATIC1111/stable-diffusion-webui on GitHub) became the dominant community-facing inference frontend for locally hosted image-generation models from 2022 onwards."@en ;
    rdfs:subClassOf ngm:image-generation ;
    vc:enables ngm:high-resolution-upscaling,
        ngm:image-editing,
        ngm:image-to-image,
        ngm:inpainting,
        ngm:outpainting,
        ngm:text-to-image ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.9"^^xsd:float ;
    vc:relatedTo ngm:civitai,
        ngm:comfy-ui,
        ngm:controlnet,
        ngm:generative-ai,
        ngm:open-source-software,
        ngm:prompt-engineering,
        ngm:sdxl,
        ngm:stable-diffusion ;
    vc:slug "automatic1111" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:classifier-free-guidance,
        ngm:clip,
        ngm:diffusion-model,
        ngm:gpu-acceleration,
        ngm:latent-diffusion,
        ngm:lora,
        ngm:textual-inversion,
        ngm:variational-autoencoder .

ngm:automation-bias a owl:Class ;
    rdfs:label "Automation Bias"@en ;
    rdfs:comment "Automation bias is the human tendency to over-rely on automated systems, accepting their outputs uncritically and discounting contradictory information, including one's own judgement. It manifests as errors of commission, following an automated recommendation that is wrong, and errors of omission, failing to act because the system did not prompt. Driven by the perceived authority of computers and the cognitive ease of deferring, it grows with workload, trust, and system opacity. Automation bias is a central human-factors concern in the governance of decision-support systems and human-in-the-loop oversight, where it can erode the very safeguards that human supervision is meant to provide."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:explainability ],
        ngm:bias ;
    vc:contrastsWith ngm:human-in-the-loop,
        ngm:human-oversight,
        ngm:situational-awareness ;
    vc:dependsOn ngm:automation,
        ngm:trust ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:human-factors ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:accountability,
        ngm:automation,
        ngm:explainability,
        ngm:human-factors,
        ngm:trust ;
    vc:requires ngm:explainability ;
    vc:slug "automation-bias" ;
    vc:sourceDomain "governance" ;
    vc:supports ngm:accountability .

ngm:automl a skos:Concept ;
    rdfs:label "Automl"@en .

ngm:autonomous-agents a skos:Concept ;
    rdfs:label "Autonomous Agents"@en .

ngm:autonomous-decision-making a owl:Class ;
    rdfs:label "Autonomous Decision Making"@en ;
    rdfs:comment "Autonomous decision making is the capacity of an artificial agent to select and commit to actions in pursuit of goals without requiring human authorisation for each choice. It combines perception of the environment, internal reasoning or learned policies, evaluation of expected outcomes, and action selection under uncertainty. Drawing on decision theory, planning, and reinforcement learning, it lets agents operate in dynamic settings where human supervision is impractical or too slow. Autonomous decision making is foundational to autonomous vehicles, robotic systems, and multi-agent coordination, and raises governance questions about accountability and human oversight."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:perception-system ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:situational-awareness ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:planning ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:goal ],
        ngm:decision-making ;
    vc:dependsOn ngm:decision-theory,
        ngm:reasoning ;
    vc:enables ngm:autonomous-agent,
        ngm:autonomous-vehicle ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:goal,
        ngm:planning ;
    vc:implements ngm:control-system ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:autonomous-agent,
        ngm:decision-theory,
        ngm:reasoning ;
    vc:requires ngm:perception-system,
        ngm:situational-awareness ;
    vc:slug "autonomous-decision-making" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:multi-agent-system,
        ngm:robotics ;
    vc:uses ngm:planning,
        ngm:reinforcement-learning .

ngm:autonomous-manipulation a owl:Class ;
    rdfs:label "Autonomous Manipulation"@en ;
    rdfs:comment "Autonomous manipulation is the capability of a robot to perceive, plan and physically interact with objects to achieve a task goal without step-by-step human teleoperation. It integrates perception, grasp and motion planning, force control and feedback to handle uncertainty in object pose, shape and contact dynamics. The aim is robust, closed-loop interaction in unstructured environments rather than the repetition of pre-programmed trajectories."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:robot-perception ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:motion-planning ],
        ngm:robotic-manipulation ;
    vc:dependsOn ngm:feedback-control,
        ngm:robot-perception ;
    vc:enables ngm:humanoid-robotics,
        ngm:pick-and-place ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:implements ngm:motion-planning ;
    vc:isPartOf ngm:robotic-manipulation ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:dexterous-manipulation,
        ngm:robotic-manipulation ;
    vc:requires ngm:motion-planning,
        ngm:robot-perception ;
    vc:slug "autonomous-manipulation" ;
    vc:sourceDomain "robotics" ;
    vc:supports ngm:pick-and-place ;
    vc:uses ngm:dexterous-manipulation,
        ngm:robot-control .

ngm:autonomous-vehicle-testing a owl:Class ;
    rdfs:label "Autonomous Vehicle Testing"@en ;
    rdfs:comment "Autonomous vehicle testing is the discipline of validating the safety, reliability, and performance of self-driving systems through simulation, closed-course trials, and supervised public-road operation. It exercises the perception, planning, and control stack against a vast space of driving scenarios, including rare and hazardous edge cases that are impractical to encounter physically. Simulation-based testing has become central because it enables scalable, repeatable, and safe exploration of these scenarios before real-world deployment."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:perception-system ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:computational-model ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:simulation ],
        ngm:autonomous-vehicle ;
    vc:bridgesTo ngm:machine-learning ;
    vc:enables ngm:self-driving-car ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:simulation ;
    vc:implements ngm:computational-model ;
    vc:isPartOf ngm:autonomous-vehicle ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:digital-twin,
        ngm:robotics,
        ngm:spatial-computing ;
    vc:requires ngm:computational-model,
        ngm:perception-system ;
    vc:slug "autonomous-vehicle-testing" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:autonomous-driving,
        ngm:self-driving-car ;
    vc:uses ngm:digital-twin,
        ngm:physics-engine,
        ngm:simulation .

ngm:autonomy-level a owl:Class ;
    rdfs:label "Autonomy Level"@en ;
    rdfs:comment "A graded classification (typically 0–5) quantifying the degree to which an agent perceives, decides, and acts without human intervention, ranging from fully manual operation through partial and conditional autonomy to full self-governance, with domain-specific scales for AI, robotics, blockchain DAOs, and multi-agent systems."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:safety ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:agent ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:human-in-the-loop ],
        ngm:bc-network-component ;
    skos:broader ngm:bc-network-component ;
    vc:enables ngm:ai-agent-system,
        ngm:bdi-model ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:agent ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:relatedTo ngm:goal,
        ngm:objective ;
    vc:requires ngm:human-in-the-loop,
        ngm:safety ;
    vc:slug "autonomy-level" ;
    vc:sourceDomain "blockchain" ;
    vc:standardizedBy ngm:eu-ai-act-regulatory-instrument .

ngm:avatar-behavior a owl:Class ;
    rdfs:label "Avatar Behavior"@en ;
    rdfs:comment "The set of behavioural patterns, animation responses, and interactive capabilities that govern how avatars and NPCs act in virtual environments, driven by AI/ML inference, procedural animation, inverse kinematics, facial expression synthesis, and real-time response to user inputs and social context."@en ;
