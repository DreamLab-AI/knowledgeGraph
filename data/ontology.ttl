        ngm:high-performance-computing,
        ngm:internet-of-things ;
    vc:uses ngm:ethernet,
        ngm:tcp-ip,
        ngm:wi-fi .

ngm:local-planner a skos:Concept ;
    rdfs:label "Local Planner"@en .

ngm:lock-and-mint-bridge a owl:Class ;
    rdfs:label "Lock-and-Mint Bridge"@en ;
    rdfs:comment "A lock-and-mint bridge is a cross-chain interoperability mechanism that transfers asset value between blockchains by locking the original asset in a custodial smart contract on the source chain and minting an equivalent synthetic (wrapped) representation on the destination chain, with the peg maintained by a network of validators or relayers who attest to the lock event."@en ;
    rdfs:subClassOf ngm:cross-chain-bridge ;
    vc:enables ngm:cross-chain-asset-transfer,
        ngm:cross-chain-interoperability ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:blockchain-security ;
    vc:slug "lock-and-mint-bridge" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:bridge-contract,
        ngm:smart-contract,
        ngm:wrapped-token .

ngm:lock-and-mint-mechanism a owl:Class ;
    rdfs:label "Lock and Mint Mechanism"@en ;
    rdfs:comment "Cross-chain asset transfer protocol where tokens are locked in a smart contract on the source chain and equivalent wrapped tokens are minted on the destination chain, maintaining a 1:1 backing ratio."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:blockchain-oracle ],
