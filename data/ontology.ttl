ngm:health-metaverse-application a owl:Class ;
    rdfs:label "Health Metaverse Application"@en ;
    rdfs:comment "A specialized virtual platform integrating healthcare delivery, medical training, therapeutic interventions, and patient engagement through immersive environments that comply with health data regulations and clinical standards."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:medical-simulation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:haptic-feedback-system ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:end-to-end-encryption ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:identity-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:virtual-clinic ],
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:enables ngm:medical-education,
        ngm:mental-health-therapy,
        ngm:rehabilitation-program,
        ngm:surgical-training,
        ngm:telemedicine ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:diagnostic-interface,
        ngm:health-record-system,
        ngm:medical-simulation,
        ngm:patient-portal,
        ngm:therapy-environment,
        ngm:virtual-clinic ;
    vc:isPartOf ngm:metaverse-application-platform ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:biometric-sensor-integration,
        ngm:end-to-end-encryption,
        ngm:haptic-feedback-system,
        ngm:identity-management ;
    vc:slug "health-metaverse-application" ;
    vc:sourceDomain "spatial-computing" .

