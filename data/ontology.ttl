# XR Accessibility Guideline
mv:XRAccessibilityGuideline a owl:Class ;
    rdfs:label "XR Accessibility Guideline"@en ;
    rdfs:comment "Design recommendations and best practices ensuring XR applications and immersive experiences are usable by people with diverse abilities and disabilities."@en ;
    skos:prefLabel "XR Accessibility Guideline"@en ;
    dcterms:identifier "MV-4006" ;
    dcterms:subject "mv" ;
    dcterms:type "mature" ;
    rdf:type owl:ObjectClass .

mv:XRAccessibilityGuideline rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:hasPart ;
    owl:someValuesFrom mv:DesignRecommendation
] .

