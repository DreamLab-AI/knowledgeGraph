    rdfs:label "Training and fine tuning"@en ;
    rdfs:comment "Fine-tuning is the post-pre-training adaptation of a large neural network — typically a transformer-based [[Foundation Models]] or [[Large Language Models]] — to narrower task distributions or behavioural objectives by continuing gradient-based optimisation on comparatively small, curated dataset..."@en ;
    rdfs:subClassOf ngm:model-training,
        ngm:transfer-learning ;
    vc:enables ngm:agents,
        ngm:code-generation,
        ngm:evaluation-benchmarks-and-leaderboards,
        ngm:large-language-models,
        ngm:medical-ai,
        ngm:multi-task-learning,
        ngm:safety-and-alignment ;
    vc:hasPart ngm:constitutional-ai,
        ngm:direct-preference-optimisation,
        ngm:instruction-tuning,
        ngm:knowledge-distillation,
        ngm:lo-ra-do-ra-etc,
        ngm:parameter-efficient-fine-tuning,
        ngm:reinforcement-learning-from-human-feedback,
        ngm:reward-model,
        ngm:safety-fine-tuning,
        ngm:supervised-fine-tuning ;
    vc:implements ngm:backpropagation,
        ngm:causal-language-modelling,
        ngm:low-rank-adaptation,
        ngm:preference-learning,
        ngm:prefix-tuning,
        ngm:prompt-tuning,
        ngm:proximal-policy-optimisation ;
    vc:maturity "established" ;
    vc:qualityScore "0.52"^^xsd:float ;
    vc:relatedTo ngm:ai-alignment,
        ngm:bias-in-large-language-models,
        ngm:constitutional-ai,
        ngm:emergence,
        ngm:evaluation-benchmarks-and-leaderboards,
        ngm:knowledge-distillation,
        ngm:safety-and-alignment ;
    vc:requires ngm:compute-infrastructure,
        ngm:gradient-descent,
        ngm:loss-function,
        ngm:pre-trained-model,
        ngm:tokenization,
        ngm:training-data ;
    vc:slug "training-and-fine-tuning" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:standardizedBy ngm:aisi-frontier-ai-safety-framework,
        ngm:eu-ai-act,
