# Haptic Feedback
spatial-computing:HapticFeedback rdf:type owl:Class ;
    rdfs:label "Haptic Feedback"@en ;
    rdfs:comment "Tactile sensory technology providing physical sensations to enhance virtual experiences through actuators integrated into controllers, gloves, and body suits. Haptic feedback simulates touch, pressure, texture, and force feedback by translating digital signals into mechanical vibrations and force responses, enabling users to feel virtual objects and interactions with realistic tactile cues. The technology bridges VirtualReality and AugmentedReality systems with SensoryImmersion through TactileActuator calibrated via SensorFusion."@en ;
    skos:prefLabel "Haptic Feedback"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:spatial-computing:haptic-feedback" ;
    owl:sameAs <urn:visionclaw:concept:spatial-computing:haptic-feedback> ;
    vcw:contentHash "sha256-12-1b30bb682082" ;
    vcw:qualityScore "0.4"^^xsd:decimal ;
    vcw:legacyTermId "MV-3055" ;
    vcw:ontologyStatus "draft" ;
    vcw:maturityLevel "draft" ;
    vcw:authorityScore "0.0"^^xsd:decimal ;
    dcterms:identifier "MV-3055" ;
    dcterms:subject "spatial-computing" ;
    owl:versionInfo "2.0.0" ;
    dcterms:created "2026-04-26T00:00:00Z"^^xsd:dateTime ;
    dcterms:modified "2026-04-26T13:00:00Z"^^xsd:dateTime ;
    vcw:owlRole "Concept" .

spatial-computing:HapticFeedback rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty infrastructure:enhances ;
    owl:someValuesFrom spatial-computing:VirtualReality
] .

spatial-computing:HapticFeedback rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty infrastructure:uses ;
    owl:someValuesFrom spatial-computing:TactileActuator
] .

