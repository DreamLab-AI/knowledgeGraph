        ngm:audit-logging,
        ngm:compliance ;
    vc:uses ngm:cache-layer,
        ngm:encryption,
        ngm:json-data-interchange-format-web-token .

ngm:set-theory a owl:Class ;
    rdfs:label "Set Theory"@en ;
    rdfs:comment "The branch of mathematical logic that studies collections of objects called sets, providing a foundational language for most of modern mathematics including logic, topology, algebra, and knowledge representation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
