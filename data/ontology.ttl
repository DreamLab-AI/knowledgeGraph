            owl:someValuesFrom ngm:image-sensor ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:neural-network ],
        ngm:computational-imaging,
        ngm:image-processing ;
