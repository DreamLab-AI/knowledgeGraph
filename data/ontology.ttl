    vc:enables ngm:finality ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:cryptographic-proof ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:consensus ;
    vc:relatedTo ngm:remote-attestation ;
    vc:relatedTo ngm:validator ;
    vc:requires ngm:cryptography ;
    vc:requires ngm:validator ;
    vc:slug "attestation" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:proof-of-stake ;
    vc:supports ngm:tee ;
    vc:uses ngm:cryptographic-proof ;
    vc:uses ngm:cryptography .
