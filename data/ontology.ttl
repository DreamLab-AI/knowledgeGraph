    vc:hasPart ngm:amm-algorithm,
        ngm:lp-token,
        ngm:smart-contract,
        ngm:token-reserve ;
    vc:isPartOf ngm:de-fi-protocol,
        ngm:decentralized-exchange,
        ngm:decentralized-exchange-dex ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:liquidity-provider,
        ngm:price-oracle,
        ngm:smart-contract-platform ;
    vc:slug "liquidity-pool" ;
    vc:sourceDomain "blockchain" .

ngm:sensor a owl:Class ;
    rdfs:label "Sensor"@en ;
    rdfs:comment "A sensor is a transducer or measurement device that detects, converts, and quantifies a physical, chemical, or environmental stimulus — such as light, pressure, temperature, motion, or electromagnetic fields — into an electrical signal suitable for processing, storage, or actuation. Sensors form the perceptual interface between computational systems and the physical world, enabling autonomous robots, IoT devices, spacecraft, and industrial machinery to react to real-world conditions. They are characterised by key metrology attributes including sensitivity, resolution, dynamic range, linearity, bandwidth, and noise floor. Modern sensor fusion architectures combine heterogeneous sensor streams — e.g. [[LiDAR]], [[Camera]], and [[IMU]] — using probabilistic filters to produce robust, high-fidelity world models."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:camera ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:signal-processing ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:ultrasonic-sensor ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:encoder ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:lidar ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:force-torque-sensor ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:imu ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:analog-to-digital-converter ],
        ngm:hardware-component ;
    vc:bridgesTo ngm:edge-computing,
        ngm:machine-learning,
        ngm:spatial-computing ;
    vc:contrastsWith ngm:actuator ;
    vc:dependsOn ngm:embedded-systems,
        ngm:power-management ;
    vc:enables ngm:autonomous-navigation,
        ngm:condition-monitoring,
        ngm:perception,
        ngm:sensor-fusion,
        ngm:simultaneous-localisation-and-mapping ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:camera,
        ngm:encoder,
        ngm:force-torque-sensor,
        ngm:imu,
        ngm:lidar,
        ngm:ultrasonic-sensor ;
    vc:isPartOf ngm:iot-device,
        ngm:robotics-systems ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:data-acquisition,
        ngm:telemetry ;
    vc:requires ngm:analog-to-digital-converter,
        ngm:signal-processing ;
    vc:slug "sensor" ;
    vc:sourceDomain "robotics" ;
    vc:standardizedBy ngm:ieee-1451,
        ngm:ros ;
    vc:supports ngm:autonomous-vehicle,
        ngm:digital-twin ;
    vc:uses ngm:kalman-filter,
        ngm:real-time-operating-system .

ngm:ai-alignment a owl:Class ;
    rdfs:label "AI Alignment"@en ;
    rdfs:comment "The process of making AI systems' behaviour and goals consistent with human values, preferences, and intentions. AI alignment encompasses technical methods and research aimed at ensuring AI systems act in accordance with human interests, even as they become more capable."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:reward-modelling ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:value-alignment ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:reinforcement-learning-from-human-feedback ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:human-oversight ],
        ngm:ai-safety ;
    vc:bridgesTo ngm:ai-governance,
        ngm:ethics ;
    vc:contrastsWith ngm:instrumental-convergence,
        ngm:misaligned-ai ;
    vc:enables ngm:safe-ai-deployment,
        ngm:trustworthy-ai ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:constitutional-ai,
        ngm:scalable-oversight,
        ngm:value-alignment ;
