# 51% Attack
bc:FiftyOnePercentAttack a owl:Class ;
    rdfs:label "51% Attack"@en ;
    skos:prefLabel "51% Attack"@en ;
    dcterms:identifier "BC-9981" ;
    dcterms:subject "bc" .

# CryptographicHash
bc:CryptographicHash a owl:Class ;
    rdfs:label "CryptographicHash"@en ;
    rdfs:comment "A deterministic function transforming data into a fixed-size digest with collision resistance."@en ;
    skos:prefLabel "CryptographicHash"@en ;
    dcterms:identifier "BC-9982" ;
    dcterms:subject "bc" ;
    dcterms:type "draft" ;
    rdf:type owl:ConceptClass .

# DAO
bc:DAO a owl:Class ;
    rdfs:label "DAO"@en ;
    rdfs:comment "A blockchain-based organization governed by smart contracts and token-based voting."@en ;
    skos:prefLabel "DAO"@en ;
    dcterms:identifier "BC-9983" ;
    dcterms:subject "bc" ;
    dcterms:type "draft" ;
    rdf:type owl:ConceptClass .

# DeFiProtocol
bc:DeFiProtocol a owl:Class ;
    rdfs:label "DeFiProtocol"@en ;
    rdfs:comment "A blockchain-based financial application providing decentralized financial services via smart contracts."@en ;
    skos:prefLabel "DeFiProtocol"@en ;
    dcterms:identifier "BC-9984" ;
    dcterms:subject "bc" ;
    dcterms:type "draft" ;
    rdf:type owl:ConceptClass .

# ERC20
bc:ERC20 a owl:Class ;
    rdfs:label "ERC20"@en ;
    rdfs:comment "The Ethereum fungible token standard defining a common interface for token transfers and balances."@en ;
    skos:prefLabel "ERC20"@en ;
    dcterms:identifier "BC-9985" ;
    dcterms:subject "bc" ;
    dcterms:type "draft" ;
    rdf:type owl:ConceptClass .

# ERC721
bc:ERC721 a owl:Class ;
    rdfs:label "ERC721"@en ;
    rdfs:comment "The Ethereum non-fungible token standard for unique digital assets."@en ;
    skos:prefLabel "ERC721"@en ;
    dcterms:identifier "BC-9986" ;
    dcterms:subject "bc" ;
    dcterms:type "draft" ;
    rdf:type owl:ConceptClass .

# ConsensusAlgorithm
bc:ConsensusAlgorithm a owl:Class ;
    rdfs:label "ConsensusAlgorithm"@en ;
    rdfs:comment "An algorithm enabling distributed nodes in a blockchain to agree on ledger state."@en ;
    skos:prefLabel "ConsensusAlgorithm"@en ;
    dcterms:identifier "BC-9987" ;
    dcterms:subject "bc" ;
    dcterms:type "draft" ;
    rdf:type owl:ConceptClass .

# Value Transfer
dt:ValueTransfer a owl:Class ;
    rdfs:label "Value Transfer"@en ;
    rdfs:comment "The mechanism and process by which economic value, rights, or utility are exchanged between parties across physical, digital, and virtual domains, encompassing monetary systems, token-based systems, resource allocation, and rights transfer protocols."@en ;
    skos:prefLabel "Value Transfer"@en ;
    dcterms:identifier "DT-0001" ;
    dcterms:subject "tc" ;
    dcterms:type "mature" ;
    dcterms:conformsTo "1.0"^^xsd:decimal ;
    rdf:type owl:ProcessClass .

