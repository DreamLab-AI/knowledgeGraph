        ngm:network-connectivity,
        ngm:parallel-corpus,
        ngm:transformer-architecture ;
    vc:slug "real-time-translation" ;
    vc:sourceDomain "distributed-collaboration" ;
    vc:standardizedBy ngm:azure,
        ngm:google-ai-technology-corporation-cloud,
