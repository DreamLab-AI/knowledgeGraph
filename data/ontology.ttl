        ngm:transformer-architecture .

ngm:hugging-face-hub a owl:Class ;
    rdfs:label "HuggingFace Hub"@en ;
    rdfs:comment "Hugging Face Hub is a centralised, version-controlled platform for hosting, discovering, and sharing machine learning models, datasets, and interactive Spaces under a collaborative open-source ecosystem. It provides Git-LFS-backed repositories for large artefact storage, model cards for documentation and responsible AI metadata, and a Python SDK (huggingface_hub) for programmatic access. The Hub functions as the de-facto registry for open-weight foundation models, transformer checkpoints, and diffusion model pipelines, serving millions of downloads daily across research and production workflows."@en ;
    rdfs:subClassOf ngm:ai-infrastructure ;
    vc:enables ngm:fine-tuning,
        ngm:inference,
        ngm:open-source-ai ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:generative-ai,
        ngm:hugging-face-diffusers ;
    vc:slug "hugging-face-hub" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:model-training .

ngm:hypervisor a owl:Class ;
    rdfs:label "Hypervisor"@en ;
    rdfs:comment "A hypervisor, or virtual machine monitor, is system software that creates and runs virtual machines by abstracting and partitioning a host's physical CPU, memory, and I/O resources. Type 1 (bare-metal) hypervisors run directly on hardware, while Type 2 (hosted) hypervisors run atop a conventional operating system. By isolating multiple guest operating systems on shared hardware, the hypervisor is the foundational technology of server virtualisation and cloud computing."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:memory-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:hardware-abstraction ],
        ngm:virtualisation ;
    vc:contrastsWith ngm:containerisation ;
    vc:dependsOn ngm:operating-system ;
    vc:enables ngm:cloud-computing,
        ngm:virtual-machine ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:isPartOf ngm:system-software ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:operating-system,
        ngm:snapshot,
        ngm:trusted-execution-environment ;
    vc:requires ngm:hardware-abstraction,
        ngm:memory-management ;
    vc:slug "hypervisor" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:cloud-infrastructure,
        ngm:multi-tenancy ;
    vc:uses ngm:hardware-abstraction .

ngm:iccv a owl:Class ;
    rdfs:label "ICCV"@en ;
    rdfs:comment "ICCV (International Conference on Computer Vision) is a biennial top-tier academic conference sponsored by IEEE that focuses on the full spectrum of computer vision research, from low-level image processing to high-level scene understanding and embodied intelligence. Held in odd-numbered years and alternating with CVPR in global prestige, ICCV features highly selective peer review and is associated with the Marr Prize for outstanding contributions to the field."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:3-d-reconstruction ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:object-detection ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:image-classification ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:semantic-segmentation ],
        ngm:computer-vision ;
    vc:contrastsWith ngm:cvpr ;
    vc:enables ngm:benchmark-standard,
        ngm:evaluation-metric ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:3-d-reconstruction,
