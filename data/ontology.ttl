ngm:erc1155-token a owl:Class ;
    rdfs:label "ERC1155 Token"@en ;
    rdfs:comment "ERC1155 is an Ethereum multi-token standard that enables a single smart contract to manage an arbitrary number of fungible, non-fungible, and semi-fungible token classes simultaneously. By batching multiple token operations into a single transaction, ERC1155 dramatically reduces gas consumption compared to deploying separate ERC-20 or ERC-721 contracts for each asset class, making it the dominant standard for blockchain gaming, NFT collections with tiered rarity, and on-chain item inventories."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gas-optimization ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:smart-contract ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:token-standard ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:erc1155-standard ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:smart-contract ],
        ngm:bc-token-and-asset,
        ngm:semi-fungible-token ;
    skos:broader ngm:bc-token-and-asset ;
    vc:contrastsWith ngm:erc-20,
        ngm:erc721 ;
    vc:enables ngm:blockchain-gaming,
        ngm:digital-asset-market,
        ngm:nft-marketplace ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:erc1155-standard,
        ngm:smart-contract ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:fungible-token,
        ngm:nft,
        ngm:smart-contracts,
        ngm:web3 ;
    vc:requires ngm:gas-optimization,
        ngm:smart-contract,
        ngm:token-standard ;
    vc:slug "erc1155-token" ;
    vc:sourceDomain "blockchain" .

ngm:erc1400-token a owl:Class ;
    rdfs:label "ERC1400 Token"@en ;
    rdfs:comment "An ERC1400 Token is an Ethereum-based security token standard that extends the ERC20 interface with partitioned token tranches, forced transfer capabilities, controller-initiated operations, and on-chain document management, enabling issuers to represent regulated financial securities on a public or permissioned blockchain. The standard enforces transfer restrictions through a canTransfer validation hook that integrates with off-chain compliance logic — such as AML/KYC whitelists and jurisdictional eligibility rules — returning standardised EIP-1066 status codes rather than simple booleans. ERC1400 is positioned as an umbrella framework composing interoperability sub-standards (ERC1410 for partitions, ERC1594 for transfers, ERC1643 for documents, ERC1644 for controller operations), making it suitable for tokenising equities, bonds, real estate, and fund units subject to securities law."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:erc1400-standard ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:regulatory-compliance ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:aml-kyc-compliance ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:blockchain-compliance ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:smart-contract ],
        ngm:bc-token-and-asset,
        ngm:security-token ;
    skos:broader ngm:bc-token-and-asset ;
    vc:enables ngm:asset-tokenization,
        ngm:digital-asset-trading,
        ngm:security-token-offering ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:erc1400-standard,
        ngm:smart-contract ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:digital-asset,
        ngm:erc3643-token,
        ngm:financial-regulation,
        ngm:securities-regulation,
        ngm:token-standard ;
    vc:requires ngm:aml-kyc-compliance,
        ngm:blockchain-compliance,
        ngm:regulatory-compliance ;
    vc:slug "erc1400-token" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:compliance-framework,
        ngm:erc20-token .

ngm:erc20 a owl:Class ;
    rdfs:label "ERC20"@en ;
    rdfs:comment "ERC20 is the Ethereum fungible token standard (Ethereum Improvement Proposal 20) defining a mandatory common interface for token transfers, approvals, and balance queries. It specifies six required functions and two events enabling interoperable smart contract interaction, forming the technical foundation of decentralised finance, governance tokens, and digital asset ecosystems on EVM-compatible chains."@en ;
    rdfs:subClassOf ngm:bc-token-and-asset ;
    skos:broader ngm:bc-token-and-asset ;
    vc:contrastsWith ngm:erc721 ;
    vc:enables ngm:decentralised-finance,
        ngm:fungible-token ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:implements ngm:smart-contract,
        ngm:token-standard ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:slug "erc20" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:blockchain,
        ngm:ethereum .

ngm:erc3643-standard a owl:Class ;
    rdfs:label "ERC3643 Standard"@en ;
    rdfs:comment "Permissioned token standard with on-chain identity verification for regulatory compliance."@en ;
    rdfs:subClassOf ngm:bc-token-and-asset ;
    skos:broader ngm:bc-token-and-asset ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:aml-kyc-compliance ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:slug "erc3643-standard" ;
    vc:sourceDomain "blockchain" .

ngm:erc3643-token a owl:Class ;
    rdfs:label "ERC3643 Token"@en ;
    rdfs:comment "The ERC-3643 (T-REX) standard is an Ethereum permissioned token framework designed for compliant security token issuance, embedding on-chain identity verification and transfer-restriction logic that enforces investor eligibility, jurisdiction rules, and AML/KYC requirements at the smart contract level. Transfer authorisation is governed by an on-chain identity registry and a modular compliance module, enabling automated regulatory enforcement."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:aml-kyc-compliance ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:identity-verification ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:smart-contract ],
        ngm:bc-token-and-asset,
        ngm:security-token ;
    skos:broader ngm:bc-token-and-asset ;
    vc:enables ngm:blockchain-compliance,
        ngm:compliance-verification,
        ngm:security-token-offering ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:compliance-framework,
        ngm:erc1400-token,
        ngm:erc20-token,
        ngm:identity-management,
        ngm:tokenomics-governance ;
    vc:requires ngm:aml-kyc-compliance,
        ngm:identity-verification,
        ngm:smart-contract ;
    vc:slug "erc3643-token" ;
    vc:sourceDomain "blockchain" ;
    vc:standardizedBy ngm:erc3643-standard .

ngm:ethical-review-process a owl:Class ;
    rdfs:label "Ethical Review Process"@en ;
    rdfs:comment "An Ethical Review Process is a structured methodology for evaluating AI systems against ethical frameworks, organisational values, and societal norms, involving expert deliberation, stakeholder consultation, and documented decision-making to ensure responsible AI development and deployment. It applies consequentialist, deontological, and virtue-ethics frameworks to assess fairness, privacy, autonomy, safety, and accountability dimensions, producing approval, conditional approval, deferral, or rejection outcomes with documented rationale."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ai-ethics-board ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:accountability ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:human-oversight ],
        ngm:ai-governance-and-ethics ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:enables ngm:ai-safety,
        ngm:responsible-ai ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.0"^^xsd:float ;
