            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:privacy-protection ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:real-time-processing ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:machine-learning-model ],
        ngm:sc-interaction ;
    skos:broader ngm:sc-interaction ;
    vc:enables ngm:adaptive-user-interface,
        ngm:emotion-aware-interaction,
        ngm:mental-health-monitoring,
        ngm:sentiment-analysis ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:affective-state-predictor,
        ngm:facial-expression-analyzer,
        ngm:physiological-sensor-processor,
        ngm:sentiment-classification-model,
        ngm:voice-emotion-detector ;
    vc:isPartOf ngm:affective-computing-system,
        ngm:user-experience-analytics-platform ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:machine-learning-model,
        ngm:privacy-protection,
        ngm:real-time-processing,
        ngm:sensor-data-stream ;
    vc:slug "emotional-analytics-engine" ;
    vc:sourceDomain "spatial-computing" .

ngm:emotional-intelligence a owl:Class ;
    rdfs:label "Emotional Intelligence"@en ;
    rdfs:comment "Emotional Intelligence in AI refers to the capacity of artificial systems to recognise, interpret, and respond appropriately to human emotional states, expressed through text, voice, facial expression, or physiological signals. It extends classical AI with affective computing capabilities, enabling machines to calibrate their outputs based on a user's emotional context. Applications span conversational agents, digital humans, therapeutic tools, and immersive experience design where user engagement depends on emotionally-resonant interaction."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:emotion-aware-interaction ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:sentiment-analysis ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:emotional-analytics-engine ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:machine-learning ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:natural-language-processing ],
        ngm:ai-research-area ;
    skos:broader ngm:ai-research-area ;
    vc:bridgesTo ngm:behavioral-modeling,
        ngm:digital-human-technology ;
    vc:enables ngm:emotional-immersion,
        ngm:empathetic-ai,
        ngm:hyper-personalisation,
        ngm:personalized-virtual-experiences ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:emotion-aware-interaction,
        ngm:emotional-analytics-engine,
        ngm:sentiment-analysis ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:attention-aware-interaction,
        ngm:cognitive-science,
        ngm:conversational-ai,
        ngm:digital-humans,
        ngm:human-computer-interaction,
        ngm:social-presence ;
    vc:requires ngm:machine-learning,
        ngm:natural-language-processing ;
    vc:slug "emotional-intelligence" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:cognitive-architecture,
        ngm:deep-learning .

ngm:ens-dao a owl:Class ;
    rdfs:label "ENS DAO"@en ;
    rdfs:comment "ENS DAO is the decentralised autonomous organisation that governs the Ethereum Name Service (ENS), the primary naming infrastructure for the Ethereum ecosystem, using the ENS governance token ($ENS) to enable token-weighted voting on protocol upgrades, treasury allocation, and price oracle parameter changes through a Governor Bravo-compatible on-chain governance contract. Established in November 2021 via a retroactive airdrop of 25 million ENS tokens to historical registrants and contributors, the DAO holds a treasury of tens of millions of dollars in ETH and ENS, oversees the root multi-sig controlling the ENS root keys, and appoints stewards for working groups covering Meta-Governance, Ecosystem, Public Goods, and Community operations. ENS DAO represents one of the largest and most active protocol DAOs by voter participation and treasury size."@en ;
    rdfs:subClassOf ngm:dao ;
    vc:enables ngm:blockchain-governance,
        ngm:dao-governance,
        ngm:decentralised-decision-making ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:decentralized-identity,
        ngm:digital-identity,
        ngm:ens,
        ngm:on-chain-governance ;
    vc:slug "ens-dao" ;
    vc:sourceDomain "governance" ;
    vc:uses ngm:compound-governor-bravo,
        ngm:governance-token,
        ngm:snapshot-voting,
        ngm:timelock-controller .

ngm:environmental-verification a owl:Class ;
    rdfs:label "Environmental Verification"@en ;
    rdfs:comment "The process of validating that a physical or virtual environment meets defined safety, compliance, or operational standards before allowing XR interactions to proceed. Encompasses spatial boundary checks, hazard detection, and cross-referencing environment state against authoritative registries to ensure user safety and regulatory compliance."@en ;
    rdfs:subClassOf ngm:sc-governance-and-safety ;
    skos:broader ngm:sc-governance-and-safety ;
    vc:dependsOn ngm:environmental-registry,
        ngm:verification-standard ;
