        ngm:zero-knowledge-proof .

ngm:w3c-did-core a skos:Concept ;
    rdfs:label "W3C DID Core"@en .

ngm:web-id a owl:Class ;
    rdfs:label "WebID"@en ;
    rdfs:comment "WebID is a decentralised identity mechanism in which a person or agent is identified by an HTTP(S) URI that dereferences to a machine-readable profile document describing them in RDF. Combined with authentication methods such as WebID-TLS or WebID-OIDC, it lets users prove control of their identifier without a central identity provider. WebID is a foundational building block of the Solid project and the broader linked-data web, enabling user-controlled identity, profiles, and access control across decentralised applications."@en ;
    rdfs:subClassOf ngm:decentralized-identity ;
    vc:enables ngm:federated-identity ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:self-sovereign-identity,
        ngm:semantic-web-linked-data-standard ;
    vc:slug "web-id" ;
    vc:sourceDomain "security" ;
    vc:uses ngm:linked-data,
        ngm:rdf .

ngm:web-socket-protocol a owl:Class ;
    rdfs:label "WebSocket Protocol"@en ;
    rdfs:comment "The WebSocket Protocol is a standardised full-duplex communication protocol defined in RFC 6455 (2011) that provides a persistent, low-latency bidirectional channel between a client and a server over a single TCP connection. It was designed to overcome the limitations of HTTP polling and long-polling by upgrading an initial HTTP handshake to a persistent framed message channel, enabling servers to push data to clients without client-initiated requests. WebSocket frames carry minimal overhead — a 2-byte header for small messages — making the protocol suitable for high-frequency data streams such as financial tickers, collaborative editing, gaming, and real-time AI agent communications. It is supported natively in all major browsers and server-side runtimes, and forms the transport layer for many higher-level protocols including STOMP, MQTT-over-WebSocket, and the OpenAI Realtime API."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:transport-layer-security ],
        ngm:network-protocol ;
    vc:bridgesTo ngm:large-language-model,
        ngm:multi-agent-system ;
    vc:contrastsWith ngm:g-rpc,
        ngm:http-long-polling,
        ngm:server-sent-events,
        ngm:webrtc ;
    vc:enables ngm:agent-event-stream,
        ngm:live-data-streaming,
        ngm:realtime-collaboration,
        ngm:server-push ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:full-duplex-communication,
        ngm:rfc-6455 ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:http-2,
        ngm:mqtt,
        ngm:realtime-communication,
        ngm:web-socket ;
    vc:requires ngm:hypertext-transfer-protocol,
        ngm:transmission-control-protocol,
        ngm:transport-layer-security ;
    vc:slug "web-socket-protocol" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:asynchronous-communication,
        ngm:event-driven-architecture,
        ngm:publish-subscribe-pattern ;
    vc:uses ngm:networking-infrastructure,
        ngm:tcp-connection .

ngm:zero-shot-learning a skos:Concept ;
    rdfs:label "Zero Shot Learning"@en .

ngm:zigbee a owl:Class ;
    rdfs:label "Zigbee"@en ;
    rdfs:comment "Zigbee is a low-power, low-data-rate wireless mesh networking protocol stack built atop the IEEE 802.15.4 physical and MAC layer standard, designed for battery-operated IoT sensors, actuators, and control devices in home automation, industrial monitoring, and building management. Maintained by the Connectivity Standards Alliance (formerly the Zigbee Alliance), it defines application-layer profiles, mesh routing, and AES-128 security on top of IEEE 802.15.4, supporting coordinator, router, and sleepy end-device roles within self-healing mesh topologies. Operating predominantly at 2.4 GHz (globally) as well as 868 MHz and 915 MHz regional bands, Zigbee targets data rates up to 250 kbps and enables coin-cell battery lifetimes of years, making it a foundational IoT wireless technology that coexists and increasingly converges with Thread and the Matter smart-home standard."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ieee-802-15-4 ],
        ngm:ieee-802-15-4 ;
    vc:bridgesTo ngm:cloud-iot-platform,
        ngm:ip-networking ;
    vc:contrastsWith ngm:bluetooth-low-energy,
        ngm:thread-protocol,
        ngm:wi-fi-halow,
        ngm:z-wave ;
    vc:dependsOn ngm:ism-band,
        ngm:mesh-networking ;
    vc:enables ngm:building-automation,
        ngm:home-automation,
        ngm:smart-metering,
        ngm:wireless-sensor-network ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:zigbee-coordinator,
        ngm:zigbee-end-device,
        ngm:zigbee-router ;
    vc:implements ngm:aodv-routing,
        ngm:mesh-routing ;
    vc:isPartOf ngm:iot-protocol-stack ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:industrial-iot,
        ngm:lpwan,
        ngm:matter-protocol,
        ngm:smart-home ;
    vc:requires ngm:aes-128,
        ngm:ieee-802-15-4 ;
    vc:slug "zigbee" ;
