ngm:python a owl:Class ;
    rdfs:label "Python"@en ;
    rdfs:comment "Python is a high-level, dynamically typed, interpreted programming language designed by Guido van Rossum with an explicit emphasis on code readability, expressive syntax, and developer productivity. Its reference implementation, CPython, executes code via a bytecode interpreter protected by the Global Interpreter Lock (GIL), whilst third-party runtimes such as PyPy provide JIT compilation for CPU-bound workloads. Python's extensive standard library and the PyPI ecosystem—encompassing NumPy, Pandas, PyTorch, TensorFlow, Scikit-learn, and the Hugging Face stack—have established it as the dominant language for machine learning research, data science, scientific computing, and AI infrastructure automation. Its clean syntax, interactive tooling via Jupyter notebooks, and first-class cloud-platform support have made it the lingua franca of artificial intelligence development globally."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:virtual-environment ],
        ngm:programming-language ;
    vc:bridgesTo ngm:knowledge-graph,
        ngm:robotics,
        ngm:smart-contract ;
    vc:contrastsWith ngm:julia-language,
        ngm:r-language ;
    vc:enables ngm:computer-vision,
        ngm:data-science,
        ngm:deep-learning,
        ngm:machine-learning,
        ngm:natural-language-processing,
        ngm:scientific-computing ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:cpython,
        ngm:python-package-index,
        ngm:python-standard-library ;
    vc:qualityScore "0.76"^^xsd:float ;
    vc:relatedTo ngm:ai-infrastructure,
        ngm:machine-learning-framework,
        ngm:machine-learning-pipeline,
        ngm:python-pytorch-deep-learning-stack ;
    vc:requires ngm:package-manager,
        ngm:virtual-environment ;
    vc:slug "python" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:infrastructure-as-code,
        ngm:rest-api,
        ngm:web-framework ;
    vc:uses ngm:jupyter-notebook,
        ngm:numpy,
        ngm:pandas,
        ngm:pytorch,
        ngm:scikit-learn,
        ngm:tensorflow .

