    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:agent-based-model,
        ngm:feedback-loop,
        ngm:phase-transition ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:chaos-theory,
        ngm:cybernetics ;
    vc:requires ngm:dynamical-systems-theory,
        ngm:network-theory,
        ngm:nonlinear-dynamics ;
    vc:slug "complex-systems" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:adaptive-systems,
        ngm:swarm-intelligence .

ngm:compute-governance a owl:Class ;
    rdfs:label "Compute Governance"@en ;
    rdfs:comment "Compute governance is the set of policies, controls, and oversight mechanisms applied to the large-scale computing hardware used to train and deploy advanced AI systems. Because frontier AI capability is tightly coupled to access to specialised accelerators, governing compute offers a measurable, supply-chain-anchored lever for AI policy. Mechanisms include export controls, usage reporting thresholds, and on-chip verification of training runs."@en ;
    rdfs:subClassOf ngm:ai-governance ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:ai-risks,
        ngm:competition-in-ai ;
    vc:slug "compute-governance" ;
    vc:sourceDomain "ai" .

ngm:consensus-layer a owl:Class ;
    rdfs:label "Consensus Layer"@en ;
    rdfs:comment "The Consensus Layer is the stratum responsible for agreement on a single canonical ordering of events across distributed participants. In the canonical stack it sits directly above the Protocol Layer and below the Data Layer, converting peer-to-peer message exchange into a shared, append-only history. It contains the agreement algorithms, fork-choice rules, and finality conditions that all participants follow."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:protocol-layer ],
        ngm:bc-protocol-and-consensus ;
    skos:broader ngm:bc-protocol-and-consensus ;
    vc:enables ngm:data-layer ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:protocol-layer ;
    vc:slug "consensus-layer" ;
    vc:sourceDomain "blockchain" .

ngm:constraint a owl:Class ;
    rdfs:label "Constraint"@en ;
    rdfs:comment "A Constraint is a condition, restriction, or rule that limits the set of permissible states, actions, or solutions within a computational, logical, or physical system. Constraints formalise requirements such as resource bounds, logical invariants, safety properties, and optimality criteria, and are manipulated by constraint-satisfaction and optimisation algorithms to find feasible or optimal solutions. They appear across AI planning, machine learning regularisation, smart-contract execution, and formal verification."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:objective ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:model ],
        ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:bridgesTo ngm:blockchain,
        ngm:digital-twin,
        ngm:smart-contract ;
    vc:enables ngm:formal-verification,
        ngm:reasoning,
        ngm:safety ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:parameter,
        ngm:property,
        ngm:system ;
    vc:requires ngm:model,
        ngm:objective ;
    vc:slug "constraint" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:fairness,
        ngm:machine-learning-discipline,
        ngm:ontology ;
    vc:uses ngm:algorithm,
        ngm:inference,
        ngm:search-algorithm .

ngm:content-delivery-network-cdn a owl:Class ;
    rdfs:label "Content Delivery Network (CDN)"@en ;
    rdfs:comment "A geographically distributed network of proxy servers and data centers designed to provide high availability, high performance, and low latency content delivery by caching content closer to end-users."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:load-balancer ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:routing-protocol ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:network-infrastructure ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:storage-systems ],
        ngm:infra-network-and-comms,
        ngm:network-infrastructure ;
    skos:broader ngm:infra-network-and-comms ;
    vc:enables ngm:ddo-s-protection,
        ngm:geographic-redundancy,
        ngm:low-latency-content-delivery,
        ngm:scalable-distribution ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:cache-system,
        ngm:edge-server,
