ngm:root-mean-square-error a owl:Class ;
    rdfs:label "Root Mean Square Error"@en ;
    rdfs:comment "A regression performance metric representing the square root of the average squared differences between predicted and actual values, calculated by taking the mean of squared prediction errors and then applying the square root, providing a measure of prediction accuracy in the same units as the ta..."@en ;
    rdfs:subClassOf ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:contrastsWith ngm:mean-absolute-error ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:overfitting,
        ngm:training ;
    vc:slug "root-mean-square-error" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:model-evaluation-results,
        ngm:model-performance ;
    vc:uses ngm:gradient-descent,
        ngm:loss-function .

