            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:training-data ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:unsupervised-learning ],
        ngm:artificial-intelligence-core ;
    vc:bridgesTo ngm:data-governance,
        ngm:responsible-ai ;
    vc:contrastsWith ngm:rule-based-ai,
        ngm:symbolic-ai ;
    vc:dependsOn ngm:data-pipeline,
