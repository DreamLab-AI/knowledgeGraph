        ngm:edge-computing,
        ngm:latency,
        ngm:latency-management-protocol ;
    vc:requires ngm:quality-of-service,
        ngm:telecommunications-infrastructure ;
    vc:slug "guaranteed-bandwidth" ;
    vc:sourceDomain "spatial-computing" .

ngm:hamiltonian-monte-carlo a owl:Class ;
    rdfs:label "Hamiltonian Monte Carlo"@en ;
    rdfs:comment "Hamiltonian Monte Carlo (HMC) is a Markov chain Monte Carlo sampling algorithm that uses Hamiltonian dynamics to generate distant, low-autocorrelation proposals in high-dimensional parameter spaces. By treating the negative log-posterior as a potential energy and augmenting with auxiliary momentum variables, HMC can traverse the posterior landscape far more efficiently than random-walk Metropolis methods."@en ;
    rdfs:subClassOf ngm:bayesian-inference ;
    vc:enables ngm:bayesian-optimisation ;
    vc:hasMaturity ngmi:maturity-established ;
