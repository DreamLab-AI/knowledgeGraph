    vc:slug "computer-vision-video-analysis" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:computer-vision,
        ngm:convolutional-neural-network,
        ngm:transformer .

ngm:concurrency-control a owl:Class ;
    rdfs:label "Concurrency Control"@en ;
    rdfs:comment "Concurrency control is the set of techniques that coordinate simultaneous operations on shared data so that correctness is preserved despite interleaving. It ensures that concurrent transactions or processes produce results equivalent to some valid serial execution, preventing anomalies such as lost updates and inconsistent reads. It is foundational to databases, distributed systems, and collaborative applications."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:transaction ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-consistency ],
        ngm:distributed-systems ;
    vc:bridgesTo ngm:database-system ;
    vc:contrastsWith ngm:conflict-resolution ;
    vc:dependsOn ngm:concurrency ;
    vc:enables ngm:data-consistency ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:implements ngm:data-consistency ;
    vc:isPartOf ngm:distributed-systems ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:conflict-resolution,
        ngm:state-synchronization ;
    vc:requires ngm:data-consistency,
        ngm:transaction ;
    vc:slug "concurrency-control" ;
    vc:sourceDomain "distributed-systems" ;
