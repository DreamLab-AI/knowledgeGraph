        ngm:self-attention ;
    vc:slug "scaled-dot-product-attention" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:positional-encoding,
        ngm:query-key-value .

ngm:sd-jwt a owl:Class ;
    rdfs:label "SD-JWT"@en ;
    rdfs:comment "SD-JWT (Selective Disclosure JSON Web Token) is an IETF-specified extension to the JSON Web Token standard that allows an Issuer to create a signed token containing hashed claim values, from which the Holder can selectively reveal only the specific claims needed for a given presentation — without exposing other claims or enabling correlation across presentations. The mechanism uses SHA-256 salted disclosure objects appended to the base JWT; verifiers can validate revealed disclosures against the issuer signature whilst remaining blind to undisclosed claims. SD-JWT forms the primary credential format for the European Union's eIDAS 2.0 digital identity wallet system."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:public-key-infrastructure ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:digital-signature ],
        ngm:selective-disclosure ;
    vc:bridgesTo ngm:digital-identity-governance,
        ngm:self-sovereign-identity ;
    vc:contrastsWith ngm:bbs-signatures,
        ngm:iso-mdoc,
        ngm:zero-knowledge-proof ;
    vc:enables ngm:credential-verification,
        ngm:holder-binding,
        ngm:minimal-disclosure,
        ngm:privacy-preserving-identity ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:implements ngm:ietf-rfc,
        ngm:oauth-working-group-specification ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:credential-format-standard,
        ngm:decentralised-identifier,
        ngm:w-3-c-verifiable-credentials-2-0 ;
    vc:requires ngm:digital-signature,
        ngm:public-key-infrastructure ;
    vc:slug "sd-jwt" ;
    vc:sourceDomain "security" ;
    vc:supports ngm:eidas-2-digital-identity-wallet,
        ngm:open-id4-vci,
        ngm:open-id4-vp ;
    vc:uses ngm:base64url-encoding,
        ngm:cryptographic-proof,
        ngm:json-data-interchange-format-web-token,
        ngm:sha-256,
        ngm:verifiable-credentials .

ngm:segregated-witness a owl:Class ;
    rdfs:label "Segregated Witness"@en ;
    rdfs:comment "Segregated Witness (SegWit) is a protocol upgrade, activated on Bitcoin as a backwards-compatible soft fork, that moves the witness data — the digital signatures authorising spends — out of the main transaction body into a separate structure. By segregating signatures, it fixes transaction malleability, since the transaction identifier no longer depends on mutable signature data, and effectively increases block capacity through a block-weight accounting scheme. SegWit also created the foundation for second-layer protocols such as the Lightning Network and enabled later script upgrades."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:bitcoin ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:digital-signature ],
        ngm:blockchain-scalability ;
    vc:bridgesTo ngm:lightning-network ;
    vc:contrastsWith ngm:block-size ;
    vc:dependsOn ngm:consensus-mechanism ;
    vc:enables ngm:blockchain-scalability,
        ngm:lightning-network ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:scalability ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:bitcoin,
        ngm:immutability,
        ngm:transaction ;
    vc:requires ngm:bitcoin,
        ngm:digital-signature ;
    vc:slug "segregated-witness" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:lightning-network ;
    vc:uses ngm:merkle-tree .

ngm:sensitivity a owl:Class ;
    rdfs:label "Sensitivity"@en ;
    rdfs:comment "Sensitivity quantifies the degree to which the output of a model, classifier, or system changes in response to variation in its inputs, parameters, or underlying assumptions. In binary classification, sensitivity (also called recall or true positive rate) measures the proportion of actual positive instances correctly identified by a model. In sensitivity analysis, the concept is generalised to any computational or physical system to identify which input factors most strongly drive output variance, thereby guiding uncertainty quantification and model validation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:parameter ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:classification ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ground-truth-labels ],
        ngm:model-evaluation ;
    vc:bridgesTo ngm:decision-support,
        ngm:risk-assessment ;
    vc:contrastsWith ngm:precision,
        ngm:specificity ;
    vc:dependsOn ngm:confusion-matrix ;
    vc:enables ngm:feature-importance,
        ngm:model-validation,
        ngm:robustness,
        ngm:uncertainty-quantification ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:bias-variance-tradeoff,
        ngm:f1-score,
        ngm:hyperparameter,
        ngm:reproducibility,
        ngm:roc-curve ;
    vc:requires ngm:classification,
        ngm:ground-truth-labels,
        ngm:parameter ;
    vc:slug "sensitivity" ;
    vc:sourceDomain "machine-learning" ;
    vc:supports ngm:explainability,
        ngm:fairness ;
    vc:uses ngm:monte-carlo-simulation,
        ngm:sensitivity-analysis .

ngm:serialisation a owl:Class ;
    rdfs:label "Serialisation"@en ;
    rdfs:comment "Serialisation is the process of converting in-memory data structures or object graphs into a linear byte sequence or text representation that can be stored, transmitted, and later reconstructed. The inverse operation, deserialisation, rebuilds the original structure from the encoded form. Serialisation underpins persistence, inter-process and network communication, and the interoperability of systems that exchange structured data."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-format ],
        ngm:data-format-standard ;
    vc:bridgesTo ngm:message-passing ;
    vc:contrastsWith ngm:deserialisation ;
    vc:enables ngm:message-passing,
        ngm:remote-procedure-call ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:deserialisation ;
    vc:implements ngm:data-format ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:network-communication,
        ngm:xml ;
    vc:requires ngm:data-format ;
    vc:slug "serialisation" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:api,
        ngm:interoperability ;
    vc:uses ngm:json,
        ngm:protocol-buffer .

ngm:series-elastic-actuator a owl:Class ;
    rdfs:label "Series Elastic Actuator"@en ;
    rdfs:comment "A Series Elastic Actuator (SEA) is a robotic joint mechanism that interposes a compliant spring element in series between the gearbox output and the load, deliberately introducing controlled elasticity into the drivetrain. By measuring the spring deflection with a position sensor, the SEA provides accurate, low-noise torque measurement without a dedicated force-torque sensor, while simultaneously providing passive mechanical compliance that absorbs impact energy and reduces stiffness at the point of contact. This architecture enables safe, backdrivable interactions between robots and humans or unstructured environments."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:rotary-encoder ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:torque-control ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:position-sensor ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:motor-driver ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:planetary-gearbox ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:feedback-control ],
        ngm:robot-actuator ;
    vc:bridgesTo ngm:biomechanics,
        ngm:safe-human-robot-interaction ;
    vc:contrastsWith ngm:actuator,
        ngm:hydraulic-actuator,
        ngm:quasi-direct-drive ;
    vc:enables ngm:human-robot-interaction,
        ngm:legged-locomotion,
        ngm:soft-robotics ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:compliant-spring-element,
        ngm:planetary-gearbox,
        ngm:rotary-encoder,
        ngm:torque-control ;
    vc:implements ngm:force-torque-sensor,
        ngm:series-elastic-actuation ;
    vc:isPartOf ngm:collaborative-systems-modality-robot,
        ngm:exoskeleton,
        ngm:humanoid-robot ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:actuator,
        ngm:series-elastic-actuation,
        ngm:variable-stiffness-actuator ;
    vc:requires ngm:feedback-control,
        ngm:motor-driver,
        ngm:position-sensor ;
    vc:slug "series-elastic-actuator" ;
    vc:sourceDomain "robotics" ;
    vc:supports ngm:backdrivability,
        ngm:force-control,
        ngm:impedance-control,
        ngm:variable-impedance-control ;
    vc:uses ngm:hookes-law,
        ngm:pid-controller,
        ngm:position-sensor,
        ngm:torque-control .

ngm:servo-control a owl:Class ;
    rdfs:label "Servo Control"@en ;
    rdfs:comment "Servo Control is a closed-loop control methodology that uses feedback signals — typically from encoders or resolvers — to precisely regulate the position, velocity, or torque of an actuator. A servo controller computes the error between a desired setpoint and the measured output, then drives a servo motor or hydraulic actuator to minimise that error, making servo control foundational to high-precision robotic joint control, CNC machining, and collaborative robot safety systems."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:actuator ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:closed-loop-control ],
        ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:enables ngm:motion-control ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:safety-plc ;
    vc:requires ngm:actuator,
        ngm:closed-loop-control ;
    vc:slug "servo-control" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:feedback-control,
        ngm:pid-controller,
        ngm:servo-motor .

ngm:settlement-finality a owl:Class ;
    rdfs:label "Settlement Finality"@en ;
    rdfs:comment "Settlement finality is the point at which a transfer of value or assets becomes irrevocable and unconditional, such that it can no longer be reversed, unwound, or repudiated even in the event of a participant's insolvency. In traditional finance it is defined by legal frameworks governing payment and securities systems, while in blockchain systems it emerges from consensus guarantees that may be deterministic or probabilistic. Finality is essential to systemic stability because it eliminates settlement risk once the defined threshold is reached."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:transaction-finality ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:consensus-mechanism ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:economic-finality ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:immutability ],
        ngm:settlement ;
    vc:bridgesTo ngm:central-securities-depository ;
    vc:contrastsWith ngm:probabilistic-finality ;
    vc:dependsOn ngm:consensus-mechanism ;
    vc:enables ngm:atomic-settlement,
        ngm:delivery-versus-payment ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:economic-finality,
        ngm:transaction-finality ;
    vc:isPartOf ngm:settlement ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:clearing-and-settlement,
        ngm:double-spending,
        ngm:netting ;
    vc:requires ngm:consensus-mechanism,
        ngm:immutability ;
    vc:slug "settlement-finality" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:financial-market-infrastructure ;
    vc:uses ngm:proof-of-stake .

ngm:shared-workspace a owl:Class ;
    rdfs:label "Shared Workspace"@en ;
    rdfs:comment "A shared workspace is a common digital environment in which multiple people can view, edit and organise shared artefacts together, whether simultaneously or over time. It provides a persistent space holding documents, boards, tasks or models alongside cues about who is present and what they are doing. Shared workspaces are a core construct of collaborative and groupware systems, turning individual tools into venues for coordinated teamwork."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:awareness ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:presence ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:synchronisation ],
        ngm:collaboration ;
    vc:dependsOn ngm:synchronisation ;
    vc:enables ngm:remote-collaboration,
        ngm:remote-work ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:awareness,
        ngm:presence ;
    vc:isPartOf ngm:distributed-collaboration ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:collaboration,
        ngm:human-computer-interaction ;
    vc:requires ngm:synchronisation ;
    vc:slug "shared-workspace" ;
    vc:sourceDomain "distributed-collaboration" ;
    vc:supports ngm:version-control ;
    vc:uses ngm:crdt,
        ngm:operational-transformation .

ngm:single-use-seals a owl:Class ;
    rdfs:label "Single Use Seals"@en ;
    rdfs:comment "A single-use seal is a cryptographic primitive, proposed by Peter Todd in 2016, that is a uniquely identifiable object which can be closed over ('sealed to') a message exactly once, producing a publicly verifiable proof that the seal was closed over that specific message and no other. The canonical implementation uses a Bitcoin UTXO as the seal: because the consensus rules permit each UTXO to be spent only once, the transaction that spends it can commit to exactly one message, giving a tamper-evident, non-equivocable 'open once' guarantee. Single-use seals, combined with proof of publication, form the foundation of client-side validation and underpin Bitcoin smart-contract systems such as RGB and primitives such as Block Trails."@en ;
    rdfs:subClassOf ngm:cryptographic-commitment ;
    vc:bridgesTo ngm:schnorr-signature,
        ngm:taproot ;
    vc:dependsOn ngm:double-spending,
        ngm:proof-of-publication ;
    vc:enables ngm:block-trails,
        ngm:client-side-validation,
        ngm:rgb-protocol ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:lightning-network,
        ngm:provenance-tracking,
        ngm:rgb-and-client-side-validation,
        ngm:taproot-assets ;
    vc:slug "single-use-seals" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:bitcoin-proof-of-work-protocol-network,
        ngm:cryptographic-commitment,
        ngm:utxo-model .

ngm:slashing-condition a owl:Class ;
    rdfs:label "Slashing Condition"@en ;
    rdfs:comment "A slashing condition is a rule in a proof-of-stake protocol that defines provable validator misbehaviour, such as double-signing or equivocation, and triggers the forfeiture of part of the offender's staked collateral. It makes attacks economically costly by penalising actions that threaten consensus safety, aligning validator incentives with honest participation. It is a core economic-security primitive of staking-based consensus."@en ;
    rdfs:subClassOf ngm:consensus-mechanism ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:consensus-mechanism,
        ngm:sustainable-consensus ;
    vc:slug "slashing-condition" ;
    vc:sourceDomain "blockchain" .

ngm:social-media-platform-infrastructure a owl:Class ;
    rdfs:label "Social Media Platform Infrastructure"@en ;
    rdfs:comment "Digital platforms and applications that enable users to create, share, and interact with user-generated content within networked communities. Social media platforms combine content distribution infrastructure, algorithmic recommendation, identity and profile management, and real-time communication at scale. They are significant vectors for AI application (content moderation, recommendation, advertising optimisation) and raise governance challenges around bias, privacy, and misinformation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:content-delivery-network ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:platform-governance ],
        ngm:infra-network-and-comms ;
    skos:broader ngm:infra-network-and-comms ;
    vc:enables ngm:distributed-collaboration ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:bias,
        ngm:privacy,
        ngm:social-platform ;
    vc:requires ngm:content-delivery-network,
        ngm:platform-governance ;
    vc:slug "social-media-platform-infrastructure" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:content-moderation,
        ngm:machine-learning-discipline .

ngm:social-network-graph a owl:Class ;
    rdfs:label "Social Network Graph"@en ;
    rdfs:comment "A graph-theoretic data structure in which nodes represent social actors (individuals, organisations, or automated agents) and edges encode directed or undirected social relations such as friendship, following, trust, or co-authorship. Social network graphs are analysed using network-science metrics including degree centrality, clustering coefficient, betweenness, and PageRank to reveal community structure, information diffusion pathways, and influential actors. They underpin decentralised identity federation protocols (ActivityPub, Nostr), recommendation engines, and adversarial analysis tasks such as Sybil detection. The formalism extends naturally to heterogeneous property graphs and hypergraphs when multi-typed relations or group memberships must be represented."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:graph-algorithms ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:digital-identity ],
        ngm:knowledge-graph ;
    vc:bridgesTo ngm:decentralised-identity,
        ngm:graph-neural-network,
        ngm:virtual-community-platform ;
    vc:contrastsWith ngm:knowledge-graph ;
    vc:dependsOn ngm:graph-theory,
        ngm:network-topology ;
    vc:enables ngm:community-detection,
        ngm:identity-federation,
        ngm:recommendation-system ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:graph-database ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:federation-surface,
        ngm:small-world-network,
        ngm:web-of-trust ;
    vc:requires ngm:digital-identity,
