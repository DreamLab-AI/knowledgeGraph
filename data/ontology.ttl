ngm:asynchronous-programming a owl:Class ;
    rdfs:label "Asynchronous Programming"@en ;
    rdfs:comment "Asynchronous programming is a concurrency model in which operations that would otherwise block — such as input/output, network calls or timers — are initiated without halting the executing thread, allowing other work to proceed until results become available. It uses constructs such as callbacks, promises, futures and async/await to express continuations cleanly. The approach improves responsiveness and throughput for input/output-bound workloads without the overhead of one thread per task."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:software-engineering ],
        ngm:concurrency ;
    vc:contrastsWith ngm:parallel-processing ;
    vc:enables ngm:scalability ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:software-engineering ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:concurrency,
