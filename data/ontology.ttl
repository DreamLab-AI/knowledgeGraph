ngm:ieee-p-2048-3 a owl:Class ;
    rdfs:label "IEEE P2048-3"@en ;
    rdfs:comment "IEEE P2048-3 is a standard in the IEEE 2048 series for immersive reality (XR) environments, specifically addressing person identification within virtual, augmented, and mixed reality systems. It defines terminology, reference architectures, and interoperability requirements for identifying, representing, and authenticating users and their avatars across XR platforms. The standard underpins identity continuity, access control, and social trust in multi-user immersive environments, forming a foundational component of the broader IEEE 2048 XR standardisation ecosystem."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:authentication ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:digital-identity ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:avatar ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
