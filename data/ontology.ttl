ngm:blockchain-technology a owl:Class ;
    rdfs:label "Blockchain Technology"@en ;
    rdfs:comment "Blockchain Technology is a class of distributed ledger systems in which validated transactions are grouped into blocks that are cryptographically linked in an append-only sequence, maintained by a peer-to-peer network through a consensus mechanism. Each block header includes the cryptographic hash of its predecessor, a timestamp, and a Merkle root of its transaction set, ensuring that altering any historical record requires re-computing all subsequent proofs, which is computationally or economically prohibitive. The design eliminates the need for a trusted central authority by replacing it with algorithmic agreement, enabling trustless settlement, programmable value transfer via smart contracts, and tamper-evident audit trails across diverse application domains."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:immutability ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:byzantine-fault-tolerance ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:block-header ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:genesis-block ],
        ngm:distributed-ledger-technology ;
    vc:bridgesTo ngm:digital-identity,
        ngm:federated-learning,
        ngm:supply-chain-management ;
    vc:contrastsWith ngm:centralised-database,
        ngm:traditional-financial-system ;
    vc:enables ngm:blockchain-provenance,
        ngm:decentralised-autonomous-organisation,
        ngm:decentralised-finance,
        ngm:non-fungible-token,
        ngm:smart-contract,
        ngm:tokenisation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:block-header,
        ngm:genesis-block,
        ngm:transaction-mempool ;
    vc:qualityScore "0.76"^^xsd:float ;
    vc:relatedTo ngm:cross-chain-interoperability,
        ngm:cryptocurrency,
        ngm:layer-2-scaling,
        ngm:sidechain,
        ngm:zero-knowledge-proof ;
    vc:requires ngm:byzantine-fault-tolerance,
        ngm:immutability,
        ngm:network-node ;
    vc:slug "blockchain-technology" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:consensus-mechanism,
        ngm:cryptographic-hash,
        ngm:digital-signature,
        ngm:merkle-tree,
        ngm:peer-to-peer-network,
        ngm:public-key-cryptography .

ngm:bm25 a owl:Class ;
    rdfs:label "BM25"@en ;
    rdfs:comment "BM25 (Best Match 25) is a probabilistic bag-of-words ranking function used in information retrieval to score documents against a query based on term frequency saturation, document length normalisation, and inverse document frequency weighting. Derived from the BM family of retrieval functions developed at the Robertson-Spärck Jones framework in the 1970s-1990s, BM25 extends TF-IDF by applying a saturation parameter (k1) that prevents very high term frequencies from dominating relevance scores and a length normalisation parameter (b) that adjusts for document verbosity. It remains the dominant sparse lexical retrieval baseline in modern information retrieval systems."@en ;
    rdfs:subClassOf ngm:search-algorithm ;
    vc:bridgesTo ngm:large-language-model,
        ngm:vector-database ;
    vc:contrastsWith ngm:dense-retrieval,
        ngm:neural-ranking-model ;
    vc:enables ngm:document-ranking,
        ngm:enterprise-search,
        ngm:hybrid-retrieval,
        ngm:retrieval-augmented-generation-rag ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:probabilistic-ranking-principle ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:information-retrieval,
        ngm:inverted-index,
        ngm:probabilistic-relevance-model,
        ngm:search-index,
        ngm:semantic-search,
        ngm:tf-idf ;
    vc:requires ngm:corpus-statistics,
        ngm:tokenisation ;
    vc:slug "bm25" ;
    vc:sourceDomain "machine-learning" ;
    vc:supports ngm:keyword-search,
        ngm:reciprocal-rank-fusion ;
    vc:uses ngm:embeddings,
        ngm:inverse-document-frequency,
        ngm:natural-language-processing,
        ngm:term-frequency .

ngm:c2-pa a owl:Class ;
    rdfs:label "C2PA"@en ;
    rdfs:comment "C2PA (Coalition for Content Provenance and Authenticity) is a cross-industry open technical standards body and specification that cryptographically binds signed provenance metadata — covering capture origin, editing history, and AI generation disclosure — to digital media assets including images, video, audio, and documents. Founded by Adobe, Arm, BBC, Intel, Microsoft, and Truepic under the Joint Development Foundation, the C2PA specification defines the manifest container format (JUMBF/ISO 19566-5), assertion vocabularies, COSE-based signing mechanism, X.509 PKI trust model, and the resulting Content Credentials artefact. C2PA consolidates two prior initiatives — Adobe's Content Authenticity Initiative (CAI) and the BBC-led Project Origin — into a single interoperable standard for end-to-end media provenance across capture, editing, distribution, and verification stages."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:digital-signature ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:c2-pa-content-credentials ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:certificate-authority ],
        ngm:sc-standards-and-interop ;
    skos:broader ngm:sc-standards-and-interop ;
    vc:bridgesTo ngm:ai-governance-and-ethics,
        ngm:prov-o,
        ngm:watermarking ;
    vc:contrastsWith ngm:deepfakes,
        ngm:synthetic-media ;
    vc:enables ngm:ai-disclosure,
        ngm:media-authentication,
        ngm:provenance-verification ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:c2-pa-assertion,
        ngm:c2-pa-content-credentials,
        ngm:c2-pa-manifest,
        ngm:c2-pa-trust-list ;
    vc:implements ngm:content-authenticity-initiative,
        ngm:project-origin ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:digital-media-standards,
        ngm:joint-development-foundation,
        ngm:open-media-alliance,
        ngm:w3c-verifiable-credentials ;
    vc:requires ngm:certificate-authority,
        ngm:digital-signature,
        ngm:public-key-infrastructure ;
    vc:slug "c2-pa" ;
    vc:sourceDomain "standards" ;
    vc:supports ngm:disinformation-countermeasures,
        ngm:media-integrity,
        ngm:supply-chain-transparency ;
    vc:uses ngm:cose,
        ngm:jumbf,
        ngm:provenance-tracking,
        ngm:x-509-certificate .

