    skos:broader ngm:sc-standards-and-interop ;
    vc:enables ngm:interoperability,
        ngm:quality-assurance ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:relatedTo ngm:interoperability-standard,
        ngm:standards-conformance-testing ;
    vc:requires ngm:technical-standards ;
    vc:slug "standards-conformance" ;
    vc:sourceDomain "spatial-computing" ;
    vc:standardizedBy ngm:standards-body .

ngm:state-synchronisation a owl:Class ;
    rdfs:label "State Synchronisation"@en ;
    rdfs:comment "State synchronisation is the process of ensuring that multiple distributed nodes or replicas of a system maintain consistent views of shared mutable state despite network partitions, concurrent updates, and node failures. It encompasses techniques including leader-based replication, consensus protocols, conflict-free replicated data types (CRDTs), and operational transformation to reconcile divergent states. State synchronisation defines the trade-off between consistency, availability, and partition tolerance as described by the CAP theorem, choosing different points on that spectrum depending on application requirements. It is fundamental to distributed databases, real-time collaboration tools, multiplayer games, and blockchain networks."@en ;
    rdfs:subClassOf ngm:distributed-system-protocol ;
    vc:enables ngm:realtime-collaboration,
        ngm:replication-system ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:conflict-resolution,
        ngm:distributed-consensus,
        ngm:real-time-synchronization,
        ngm:state-synchronization ;
    vc:slug "state-synchronisation" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:consensus-protocol,
        ngm:crdt,
        ngm:data-replication,
        ngm:state-machine-replication .

ngm:stepper-motor a owl:Class ;
    rdfs:label "Stepper Motor"@en ;
    rdfs:comment "A stepper motor is an electromechanical actuator that divides a full rotation into a fixed number of discrete angular steps, enabling precise open-loop position control without requiring feedback sensors. By energising coils in sequence, the rotor advances one step per pulse, making stepper motors essential for applications demanding repeatable positioning such as CNC machining, 3D printing, and robotic joints."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:motion-control ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:open-loop-control ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:rotary-encoder ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:encoder ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:embedded-systems ],
        ngm:electric-motor,
        ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:contrastsWith ngm:dc-servo-motor,
        ngm:servo-motor ;
    vc:enables ngm:robotics-control,
        ngm:robotics-process ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:encoder,
        ngm:rotary-encoder ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:robot-actuator,
        ngm:robotics ;
    vc:requires ngm:embedded-systems,
        ngm:motion-control,
        ngm:open-loop-control ;
    vc:slug "stepper-motor" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:actuator,
        ngm:electric-actuator .

ngm:stochastic-differential-equation a owl:Class ;
    rdfs:label "Stochastic Differential Equation"@en ;
    rdfs:comment "A stochastic differential equation (SDE) is a differential equation in which one or more terms incorporate a stochastic process, typically Brownian motion or white noise, making the solution itself a stochastic process. SDEs generalise ordinary differential equations by including a diffusion term driven by a Wiener process, and their solutions are interpreted via Ito or Stratonovich calculus. SDEs are foundational in financial mathematics, physics, biology, and machine learning — particularly in score-based generative modelling and diffusion models."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:measure-theory ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:probability-theory ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:wiener-process ],
        ngm:differential-equations ;
    vc:bridgesTo ngm:black-scholes-model,
        ngm:neural-ordinary-differential-equation ;
    vc:contrastsWith ngm:ordinary-differential-equation,
        ngm:partial-differential-equation ;
    vc:dependsOn ngm:brownian-motion,
        ngm:fokker-planck-equation ;
    vc:enables ngm:diffusion-models,
        ngm:langevin-dynamics,
        ngm:markov-chain-monte-carlo,
        ngm:score-based-generative-models,
        ngm:stochastic-gradient-descent ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:diffusion-coefficient,
        ngm:drift-coefficient ;
    vc:implements ngm:euler-maruyama-method,
        ngm:milstein-method ;
    vc:isPartOf ngm:stochastic-processes ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:dynamical-systems,
        ngm:markov-processes,
        ngm:optimal-control ;
    vc:requires ngm:ito-calculus,
        ngm:measure-theory,
        ngm:probability-theory,
        ngm:wiener-process ;
    vc:slug "stochastic-differential-equation" ;
    vc:sourceDomain "machine-learning" ;
    vc:uses ngm:numerical-methods,
        ngm:stratonovich-calculus .

ngm:structured-output a owl:Class ;
    rdfs:label "Structured Output"@en ;
    rdfs:comment "Structured output is a technique for constraining a language model to emit responses that conform to a predefined schema such as JSON, a regular grammar, or a typed object. It is enforced through prompt instructions, constrained decoding, or function-calling interfaces so that downstream systems can parse results reliably. Structured output bridges free-form generation and deterministic software by guaranteeing machine-readable, validatable responses."@en ;
    rdfs:subClassOf ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:large-language-models,
        ngm:prompt-engineering ;
    vc:slug "structured-output" ;
    vc:sourceDomain "ai" .

ngm:subword-tokenisation a owl:Class ;
    rdfs:label "Subword Tokenisation"@en ;
    rdfs:comment "A tokenisation strategy that segments text into sub-word units (via algorithms such as Byte-Pair Encoding, WordPiece, or SentencePiece), balancing vocabulary size against the ability to represent rare, morphologically complex, and out-of-vocabulary words. Subword tokenisation is the de facto standard preprocessing step for large language models."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:language-modeling ],
        ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:enables ngm:large-language-models,
        ngm:natural-language-processing ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:neural-network-text-tokenisation ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:relatedTo ngm:natural-language-understanding ;
    vc:requires ngm:language-modeling ;
    vc:slug "subword-tokenisation" ;
    vc:sourceDomain "spatial-computing" .

ngm:supervisory-authority a skos:Concept ;
    rdfs:label "Supervisory Authority"@en .

ngm:symbolic-reasoning a owl:Class ;
    rdfs:label "Symbolic Reasoning"@en ;
    rdfs:comment "A family of AI techniques that represent knowledge as explicit symbols, rules, and logical relations and derive new conclusions through formal inference mechanisms such as resolution, forward/backward chaining, or constraint propagation. Symbolic reasoning underpins expert systems, knowledge graphs, and logic programming, and contrasts with sub-symbolic connectionist approaches while being combined with them in neuro-symbolic architectures."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:logic-programming ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:knowledge-representation ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:expert-systems ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:fuzzy-logic ],
        ngm:ai-technique,
        ngm:reasoning ;
    skos:broader ngm:ai-technique ;
    vc:contrastsWith ngm:machine-learning-discipline ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:expert-systems,
        ngm:fuzzy-logic,
        ngm:knowledge-representation,
        ngm:logic-programming ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:automated-planning,
        ngm:chain-of-thought-reasoning,
        ngm:knowledge-graph,
        ngm:mathematical-reasoning ;
    vc:slug "symbolic-reasoning" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:inference .

ngm:synchronization-protocol a owl:Class ;
    rdfs:label "Synchronization Protocol"@en ;
    rdfs:comment "A synchronization protocol is a set of rules by which distributed parties bring their state, clocks, or data into agreement despite operating independently and communicating over unreliable channels. It encompasses clock-synchronisation protocols (NTP, PTP) that align time across machines, and data-synchronisation protocols that reconcile divergent replicas using version vectors, operational transforms, or conflict-free replicated data types. Synchronization protocols are foundational to distributed databases, collaborative editing, mobile offline-first applications, and any system where multiple nodes must converge on a consistent view."@en ;
    rdfs:subClassOf ngm:network-protocol ;
    vc:enables ngm:fault-tolerance,
        ngm:replication ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:distributed-systems ;
    vc:slug "synchronization-protocol" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:clock-synchronization .

ngm:target-tracking a owl:Class ;
    rdfs:label "Target Tracking"@en ;
    rdfs:comment "Target tracking is a computational and signal-processing discipline concerned with estimating the state — typically position, velocity, and orientation — of one or more moving objects over time from sequences of noisy sensor observations. It encompasses algorithms such as Kalman filters, particle filters, and multi-hypothesis trackers, applied across radar, sonar, computer vision, and LiDAR modalities. Applications span aerospace surveillance, autonomous vehicle perception, robotic manipulation, sports analytics, and augmented reality. Modern deep-learning-based trackers jointly perform detection and tracking, achieving robust performance in complex, cluttered environments."@en ;
    rdfs:subClassOf ngm:object-detection-and-tracking ;
    vc:enables ngm:anomaly-detection,
        ngm:human-pose-slam-capture-system ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:computer-vision,
        ngm:motion-tracking,
        ngm:object-detection,
        ngm:sensor-fusion ;
    vc:slug "target-tracking" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:spatial-tracking-system,
        ngm:trajectory-tracking .

ngm:technology-infrastructure-domain-layer a owl:Class ;
    rdfs:label "Infrastructure Layer"@en ;
    rdfs:comment "Foundational base layer providing computing, storage, and network capabilities that enable metaverse applications and services to operate at scale."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:5-g-network ],
