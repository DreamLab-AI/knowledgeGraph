    vc:requires ngm:formal-language,
        ngm:proof-theory ;
    vc:slug "logic" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:artificial-intelligence,
        ngm:constraint-satisfaction,
        ngm:programming-language-semantics ;
    vc:uses ngm:model-theory,
        ngm:set-theory .

ngm:nist-cybersecurity-framework a owl:Class ;
    rdfs:label "NIST Cybersecurity Framework"@en ;
    rdfs:comment "The NIST Cybersecurity Framework (CSF) is a voluntary, outcomes-based risk management framework published by the US National Institute of Standards and Technology that provides organisations with a common taxonomy and structured approach for managing cybersecurity risk across sectors. It organises security activities around six core functions—Govern, Identify, Protect, Detect, Respond, and Recover—each decomposed into categories and subcategories cross-referenced to industry standards including ISO/IEC 27001, NIST SP 800-53, and COBIT. Version 2.0, released in February 2024, formalised the Govern function and broadened applicability beyond critical infrastructure to all organisation types and sizes globally. The framework is widely adopted as a baseline for cybersecurity programme assessment, board-level communication, supply-chain risk management, and regulatory compliance alignment."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:risk-assessment ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:asset-inventory ],
        ngm:security-framework ;
    vc:bridgesTo ngm:ai-governance,
        ngm:nist-ai-rmf ;
    vc:contrastsWith ngm:cis-controls,
        ngm:iso-iec-27001,
        ngm:soc-2 ;
    vc:dependsOn ngm:nist-sp-800-53,
        ngm:vulnerability-management ;
    vc:enables ngm:incident-response,
        ngm:supply-chain-risk-management,
        ngm:threat-detection ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:implements ngm:cybersecurity-risk-management ;
    vc:isPartOf ngm:nist ;
    vc:qualityScore "0.76"^^xsd:float ;
    vc:relatedTo ngm:compliance-framework,
        ngm:critical-infrastructure-protection,
        ngm:nist,
        ngm:zero-trust-architecture ;
    vc:requires ngm:asset-inventory,
        ngm:risk-assessment ;
    vc:slug "nist-cybersecurity-framework" ;
    vc:sourceDomain "security" ;
    vc:standardizedBy ngm:nist ;
    vc:supports ngm:compliance-monitoring,
        ngm:regulatory-compliance ;
    vc:uses ngm:risk-register .

ngm:onnx a owl:Class ;
    rdfs:label "ONNX"@en ;
    rdfs:comment "ONNX (Open Neural Network Exchange) is an open, vendor-neutral interchange format and operator specification for representing machine learning models as directed acyclic computation graphs serialised via Protocol Buffers, enabling trained models to be exported from one deep learning framework (e.g. PyTorch, TensorFlow, MXNet) and executed on any compatible runtime or hardware accelerator without retraining. The ONNX ecosystem encompasses the format specification, versioned opset definitions, a model zoo of pretrained models, and the ONNX Runtime (ORT) inference engine with pluggable hardware execution providers. Originally co-created by Meta and Microsoft in 2017 and later adopted under Linux Foundation AI and Data governance, ONNX addresses framework fragmentation by providing a common intermediate representation (IR) that bridges the training-deployment gap in production ML systems. The specification supports standard neural network operations, control flow constructs, sparse tensors, dynamic shapes, and extended data types needed for large language model and on-device AI inference workloads."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:onnx-operator-set ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:onnx-runtime ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:computation-graph ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:protocol-buffer ],
        ngm:interoperability-standard ;
    vc:bridgesTo ngm:mlops,
        ngm:neural-processing-unit ;
    vc:enables ngm:edge-inference,
        ngm:hardware-acceleration,
        ngm:model-deployment,
        ngm:model-optimization ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:onnx-operator-set,
        ngm:onnx-runtime ;
    vc:implements ngm:open-standard ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:inference-engine,
        ngm:knowledge-distillation,
        ngm:model-serialisation ;
    vc:requires ngm:computation-graph,
        ngm:protocol-buffer ;
    vc:slug "onnx" ;
    vc:sourceDomain "ai" ;
    vc:supports ngm:large-language-model,
        ngm:neural-network,
        ngm:transformer-architecture ;
    vc:uses ngm:deep-learning-framework,
        ngm:graph-optimisation,
        ngm:quantisation .

ngm:open-standards a owl:Class ;
    rdfs:label "Open Standards"@en ;
    rdfs:comment "Open standards are publicly available, transparently developed technical specifications whose adoption is not contingent on royalties or proprietary licences, enabling any party to implement them independently. They are produced through open, consensus-driven processes—typically stewarded by recognised standards bodies such as W3C, IEEE, ISO, or IETF—and their normative texts are accessible to the public. By decoupling specification from implementation, open standards promote interoperability, vendor diversity, and long-term ecosystem resilience. They are foundational to the internet, the web, spatial computing, AI model exchange, and distributed collaboration infrastructures."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:standards-conformance-testing ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:reference-implementation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:open-governance ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:consensus-process ],
        ngm:standards ;
    vc:bridgesTo ngm:decentralised-identity,
        ngm:federated-learning,
        ngm:onnx-standard ;
    vc:contrastsWith ngm:closed-specification ;
    vc:dependsOn ngm:intellectual-property-rights,
        ngm:open-source ;
    vc:enables ngm:gl-tf,
        ngm:interoperability,
        ngm:khronos-open-xr,
        ngm:vendor-neutrality ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:reference-implementation,
        ngm:specification,
        ngm:standards-conformance-testing ;
    vc:implements ngm:frand-licensing,
        ngm:royalty-free-licensing ;
    vc:isPartOf ngm:standards ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:api-design,
        ngm:open-data,
        ngm:protocol ;
    vc:requires ngm:consensus-process,
        ngm:open-governance ;
    vc:slug "open-standards" ;
    vc:sourceDomain "standards" ;
    vc:standardizedBy ngm:ieee,
        ngm:ietf,
        ngm:iso,
        ngm:khronos-group,
        ngm:w3-c ;
    vc:supports ngm:digital-sovereignty,
        ngm:technology-transfer ;
    vc:uses ngm:request-for-comments,
        ngm:technical-committee .

ngm:power-management a owl:Class ;
    rdfs:label "Power Management"@en ;
    rdfs:comment "Power management is the discipline of regulating, distributing, monitoring, and optimising electrical energy flow within computing, robotic, and embedded systems to maximise operational endurance, thermal safety, and efficiency. It spans hardware circuits (DC–DC converters, power distribution units, battery management systems), firmware-level control algorithms (voltage-frequency scaling, clock-gating, duty-cycle regulation), and system-level policies (workload scheduling, energy-aware task allocation) that together balance instantaneous demand against available supply. In robotic and mobile contexts it additionally encompasses energy harvesting, regenerative braking, and state-of-charge estimation to enable untethered autonomous operation. Effective power management is a prerequisite for deploying autonomous systems in resource-constrained field environments and for meeting safety standards governing collaborative human–robot interaction."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:embedded-systems ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:real-time-operating-system ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:power-distribution-unit ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:thermal-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:battery-management-system ],
        ngm:embedded-systems ;
    vc:bridgesTo ngm:digital-twin,
        ngm:neural-network-inference ;
    vc:contrastsWith ngm:high-performance-computing ;
    vc:dependsOn ngm:energy-storage,
        ngm:hardware-accelerator ;
    vc:enables ngm:autonomous-robot,
        ngm:edge-computing,
        ngm:mobile-robot,
        ngm:wearable-computing ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:battery-management-system,
        ngm:dc-dc-converter,
        ngm:power-distribution-unit ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:functional-safety,
        ngm:real-time-processing,
        ngm:system-on-chip ;
    vc:requires ngm:embedded-systems,
        ngm:real-time-operating-system,
        ngm:thermal-management ;
    vc:slug "power-management" ;
    vc:sourceDomain "robotics" ;
    vc:standardizedBy ngm:iso-ts-15066 ;
    vc:supports ngm:autonomous-system,
        ngm:internet-of-things,
        ngm:robot-hardware ;
    vc:uses ngm:power-supply,
        ngm:pulse-width-modulation,
        ngm:sensor-fusion .

ngm:pre-training a owl:Class ;
    rdfs:label "Pre Training"@en ;
    rdfs:comment "The initial training phase where a model learns general representations from large amounts of unlabelled or weakly labelled data before being adapted to specific tasks. Pre-training establishes foundational knowledge that can be transferred across multiple downstream applications, forming the basis for modern large-scale foundation models."@en ;
