ngm:collaborative-editing a owl:Class ;
    rdfs:label "Collaborative Editing"@en ;
    rdfs:comment "Collaborative editing is the capability for multiple people to view and modify a shared document simultaneously, with their changes merged consistently and surfaced to all participants in near real time. It relies on concurrency-control techniques such as operational transformation or conflict-free replicated data types to reconcile concurrent edits without conflicts. Combined with presence and cursor awareness, it makes co-authoring across distributed users feel immediate and coherent."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:conflict-resolution ],
        ngm:real-time-collaboration ;
    vc:enables ngm:collaboration,
        ngm:real-time-collaboration ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:conflict-free-replicated-data-type ;
    vc:isPartOf ngm:distributed-collaboration ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:crdt,
        ngm:operational-transformation,
        ngm:presence-awareness ;
    vc:requires ngm:conflict-resolution,
        ngm:presence-awareness ;
    vc:slug "collaborative-editing" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:distributed-collaboration ;
    vc:uses ngm:crdt,
        ngm:operational-transformation,
        ngm:websocket .

ngm:commons-governance a owl:Class ;
    rdfs:label "Commons Governance"@en ;
    rdfs:comment "Commons governance is the set of institutions, rules and collective practices through which a community manages a shared resource so that it remains productive and is not depleted by individual self-interest. Drawing on Elinor Ostrom's design principles, it relies on clearly defined boundaries, participatory rule-making, monitoring and graduated sanctions rather than pure markets or central control. In blockchain contexts it is expressed through DAOs and public-goods funding that coordinate stewardship of shared digital infrastructure."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:collective-action ],
        ngm:governance ;
    vc:bridgesTo ngm:collective-action,
        ngm:dao ;
    vc:dependsOn ngm:governance-token ;
    vc:enables ngm:collective-action ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:governance ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:dao,
        ngm:quadratic-funding,
        ngm:retroactive-public-goods-funding ;
    vc:requires ngm:collective-action ;
    vc:slug "commons-governance" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:retroactive-public-goods-funding,
        ngm:sustainability ;
    vc:uses ngm:dao,
        ngm:governance-token .

