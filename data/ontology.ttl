ngm:red-teaming a owl:Class ;
    rdfs:label "Red Teaming"@en ;
    rdfs:comment "The practice of deliberately attempting to elicit harmful, biased, or undesired outputs from AI systems to identify vulnerabilities and weaknesses. Red teaming involves structured adversarial testing where human evaluators or automated systems probe for failure modes across security, ethics, and alignment dimensions, informing safety improvements and deployment decisions."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:prompt-injection ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:threat-modelling ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:vulnerability-assessment ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:large-language-models ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:adversarial-testing ],
        ngm:adversarial-testing ;
    vc:bridgesTo ngm:ai-ethics,
        ngm:machine-learning-security ;
    vc:contrastsWith ngm:blue-team,
        ngm:penetration-testing ;
    vc:dependsOn ngm:attack-simulation,
        ngm:human-evaluation ;
    vc:enables ngm:ai-safety,
        ngm:model-hardening,
        ngm:responsible-ai-deployment,
        ngm:safety-fine-tuning ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:jailbreak-attack,
        ngm:prompt-injection,
        ngm:threat-modelling,
        ngm:vulnerability-assessment ;
    vc:isPartOf ngm:ai-safety-evaluation ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:bias-detection,
        ngm:model-evaluation,
        ngm:reinforcement-learning-from-human-feedback ;
    vc:requires ngm:adversarial-testing,
        ngm:large-language-models,
        ngm:safety-policy ;
    vc:slug "red-teaming" ;
    vc:sourceDomain "security" ;
    vc:supports ngm:ai-alignment,
        ngm:ai-governance,
        ngm:trustworthy-ai ;
    vc:uses ngm:mitre-attck,
        ngm:nist-cybersecurity-framework .

ngm:trusted-execution-environment a owl:Class ;
    rdfs:label "Trusted Execution Environment"@en ;
    rdfs:comment "A Trusted Execution Environment (TEE) is a hardware-enforced, isolated processing domain within a processor that guarantees confidentiality and integrity of code and data even when the host operating system, hypervisor, or privileged firmware is compromised or untrusted. TEEs are instantiated via technologies such as Intel SGX, AMD SEV-SNP, and Arm TrustZone, each providing hardware-rooted attestation mechanisms that allow a relying party to cryptographically verify the identity, configuration, and integrity of an enclave before exchanging sensitive material. By encrypting enclave memory pages in DRAM and enforcing access control at the silicon level, TEEs form the hardware foundation for confidential computing — enabling private AI inference, secure key management, privacy-preserving multi-party collaboration, and verifiable off-chain computation in blockchain systems."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptographic-key-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:secure-enclave ],
        ngm:infra-security-and-identity ;
    skos:broader ngm:infra-security-and-identity ;
    vc:bridgesTo ngm:blockchain-oracle,
        ngm:federated-learning ;
    vc:contrastsWith ngm:hypervisor-isolation,
        ngm:software-sandboxing ;
    vc:enables ngm:confidential-computing,
        ngm:privacy-enhancing-computation-pec,
        ngm:private-inference,
        ngm:secure-multi-party-computation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:memory-encryption,
        ngm:remote-attestation,
        ngm:secure-enclave ;
    vc:implements ngm:confidential-virtual-machine,
        ngm:zero-trust-architecture ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:secure-element,
        ngm:trusted-platform-module ;
    vc:requires ngm:cryptographic-key-management,
        ngm:hardware-root-of-trust,
        ngm:secure-boot ;
    vc:slug "trusted-execution-environment" ;
    vc:sourceDomain "security" ;
    vc:standardizedBy ngm:confidential-computing-consortium,
        ngm:global-platform-specification ;
    vc:supports ngm:biometric-authentication,
        ngm:digital-rights-management ;
    vc:uses ngm:hardware-security-module,
        ngm:public-key-infrastructure,
        ngm:symmetric-encryption .

ngm:digital-infrastructure a owl:Class ;
    rdfs:label "Digital Infrastructure"@en ;
    rdfs:comment "The foundational computing, networking, and storage systems that underpin large-scale digital services and telecollaboration platforms, including hyperscale data centres with GPU clusters, content delivery networks, software-defined networking, and edge computing nodes. Digital infrastructure is increasingly defined by cloud-native patterns—containerisation, orchestration, and infrastructure-as-code—enabling programmatic resource allocation and resilient, globally distributed deployments."@en ;
