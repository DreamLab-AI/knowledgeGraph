ngm:security-information-and-event-management a owl:Class ;
    rdfs:comment "Security Information and Event Management (SIEM) is a security discipline and platform category that aggregates, normalises and correlates log and event data from across an estate to detect, investigate and respond to threats. It combines real-time monitoring and alerting with longer-term storage for forensics and compliance reporting. SIEM is the analytical core of most security operations, turning raw telemetry into actionable detections."@en ;
    rdfs:label "Security Information and Event Management"@en ;
    rdfs:subClassOf ngm:network-security ;
    rdfs:subClassOf _:r18971 ;
    rdfs:subClassOf _:r18972 ;
