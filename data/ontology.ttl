ngm:json-data-interchange-format-ld-1-1 a owl:Class ;
    rdfs:label "JSON-LD 1.1"@en ;
    rdfs:comment "JSON-LD 1.1 is a W3C Recommendation (published July 2020) that extends JSON-LD 1.0 with scoped contexts, type-scoped and property-scoped contexts, propagation control, and the @protected keyword, enabling richer and safer mapping of JSON document terms to IRIs within RDF-based knowledge systems. It standardises compaction, expansion, flattening, and framing algorithms that allow any conformant document to be normalised to a canonical RDF graph without custom mapping code. JSON-LD 1.1 serves as the primary serialisation format for Verifiable Credentials, ActivityPub, the Solid ecosystem, and numerous Linked Data Platform implementations. The specification is maintained by the W3C JSON-LD Working Group and is defined across three companion documents covering syntax, processing algorithms, and the framing API."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:rdf ],
        ngm:linked-data ;
    vc:bridgesTo ngm:decentralised-identifiers,
        ngm:knowledge-graph-embedding,
        ngm:verifiable-credentials ;
    vc:contrastsWith ngm:json-schema,
        ngm:n-triples,
        ngm:rdf-xml,
        ngm:turtle-rdf-serialisation ;
    vc:enables ngm:decentralised-identifiers,
        ngm:knowledge-graph,
        ngm:linked-data-platform,
        ngm:semantic-interoperability,
        ngm:verifiable-credentials ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:owl2,
        ngm:semantic-web-linked-data-standard ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:activitypub,
        ngm:schema-org,
        ngm:solid-protocol,
        ngm:sparql ;
    vc:requires ngm:iri,
        ngm:json,
        ngm:rdf ;
    vc:slug "json-ld-1-1" ;
    vc:sourceDomain "data" ;
    vc:standardizedBy ngm:world-wide-web-consortium ;
    vc:uses ngm:context-document,
        ngm:json-data-interchange-format-ld,
        ngm:rdf-dataset .

ngm:json-data-interchange-format-rpc a owl:Class ;
    rdfs:label "JSON-RPC"@en ;
    rdfs:comment "JSON-RPC is a lightweight, stateless, transport-agnostic remote procedure call (RPC) protocol that encodes method invocations and their responses as JSON objects. The JSON-RPC 2.0 specification, finalised in 2013, defines a minimal request envelope comprising a jsonrpc version field, a method name, an optional params argument (array or object), and a correlation id; the response carries either a result or a structured error object. The protocol operates over any byte-stream transport — HTTP, WebSocket, TCP, Unix domain sockets, or stdin/stdout — making it uniquely portable across networked and embedded contexts. It underpins foundational cross-domain infrastructure including the Ethereum node API, the Language Server Protocol, and the Model Context Protocol used for AI tool-calling."@en ;
    rdfs:subClassOf ngm:infra-software-engineering ;
    skos:broader ngm:infra-software-engineering ;
    vc:bridgesTo ngm:ai-infrastructure,
        ngm:blockchain-infrastructure ;
    vc:contrastsWith ngm:graphql,
        ngm:grpc,
        ngm:rest-api,
        ngm:soap ;
    vc:enables ngm:distributed-computing,
        ngm:function-calling,
        ngm:tool-use ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:batch-request,
        ngm:notification-message,
        ngm:request-object,
        ngm:response-object ;
    vc:implements ngm:client-server-architecture,
        ngm:request-response-pattern ;
    vc:isPartOf ngm:api-standard,
        ngm:remote-procedure-call ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:inter-process-communication,
        ngm:message-passing,
        ngm:microservices,
        ngm:smart-contract ;
    vc:requires ngm:json,
