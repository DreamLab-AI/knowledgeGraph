        ngm:federated-learning ;
    vc:contrastsWith ngm:centralised-computing,
        ngm:monolithic-architecture ;
    vc:enables ngm:blockchain,
        ngm:high-availability,
        ngm:horizontal-scalability,
        ngm:orchestration ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:consensus-mechanism,
        ngm:fault-tolerance,
        ngm:message-passing,
        ngm:replication ;
