ngm:neural-network-training a owl:Class ;
    rdfs:label "Neural Network Training"@en ;
    rdfs:comment "Neural network training is the process of iteratively adjusting a model's weights to minimise a loss function over a dataset, typically using gradient descent with backpropagation. Each step computes the gradient of the loss with respect to parameters and updates them via an optimiser, repeating across many batches and epochs. Training quality depends on data, objective design, regularisation, and substantial parallel compute."@en ;
    rdfs:subClassOf ngm:machine-learning-discipline-technique ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:generative-ai,
        ngm:training-hardware ;
    vc:slug "neural-network-training" ;
    vc:sourceDomain "ai" .

ngm:neural-processing-unit a owl:Class ;
    rdfs:label "Neural Processing Unit"@en ;
    rdfs:comment "A Neural Processing Unit (NPU) is a specialised integrated circuit designed to accelerate neural network inference workloads by providing high-throughput, energy-efficient execution of the matrix multiplication and convolution operations that dominate deep learning computation. NPUs are integrated into mobile SoCs, personal computers, and edge devices to enable on-device AI inference without reliance on cloud compute, targeting performance-per-watt objectives unachievable by general-purpose CPUs or GPUs for these workloads."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:systolic-array ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:neural-network ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:neural-network-quantisation ],
        ngm:ai-hardware ;
