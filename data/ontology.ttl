        ngm:replication .

ngm:embedding a owl:Class ;
    rdfs:label "Embedding"@en ;
    rdfs:comment "An embedding is a learned mapping from discrete or high-dimensional objects—such as words, sentences, images, graphs, or code—into a continuous, low-dimensional vector space, such that semantically or functionally similar inputs are mapped to geometrically proximate vectors. Embeddings are fundamental to modern machine learning, enabling downstream tasks including similarity search, classification, clustering, and retrieval through compact, transferable representations. The quality of an embedding space is typically measured by how well geometric proximity in the vector space reflects semantic or functional similarity in the original domain."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:loss-function ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:training-data ],
        ngm:representation-learning ;
    vc:bridgesTo ngm:knowledge-graph,
        ngm:spatial-index ;
    vc:contrastsWith ngm:one-hot-encoding,
        ngm:sparse-representation ;
    vc:enables ngm:clustering,
        ngm:cross-modal-retrieval,
        ngm:recommendation-system,
        ngm:retrieval-augmented-generation,
        ngm:semantic-search,
        ngm:text-classification,
        ngm:vector-database ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:approximate-nearest-neighbour,
        ngm:bert,
        ngm:feature-extraction,
        ngm:knowledge-graph-embedding,
        ngm:latent-space,
        ngm:word2vec ;
    vc:requires ngm:loss-function,
        ngm:training-data ;
    vc:slug "embedding" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:contrastive-learning,
        ngm:dimensionality-reduction,
        ngm:encoder,
        ngm:neural-network,
        ngm:transformer .

ngm:emission-factors a owl:Class ;
    rdfs:label "Emission Factors"@en ;
    rdfs:comment "Emission Factors are coefficients that quantify the average amount of a pollutant—typically greenhouse gases expressed in CO2-equivalent—released per unit of an activity, such as per kilowatt-hour of electricity consumed or per kilometre driven by a particular vehicle class. They are derived from empirical measurement campaigns and modelling studies, and published by bodies such as the IPCC, the IEA, and national environmental agencies. Emission factors are the fundamental input to carbon accounting frameworks such as the GHG Protocol, enabling organisations to calculate their Scope 1, 2, and 3 inventories from activity data. Regular revision of these factors reflects technological change and regional grid decarbonisation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:activity-data ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:life-cycle-assessment ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:scope-1-emissions ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:scope-3-emissions ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:scope-2-emissions ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ghg-protocol ],
        ngm:carbon-accounting ;
    vc:bridgesTo ngm:energy-grid-data,
        ngm:supply-chain-transparency ;
    vc:contrastsWith ngm:direct-measurement,
        ngm:spend-based-accounting ;
    vc:dependsOn ngm:ipcc-guidelines,
