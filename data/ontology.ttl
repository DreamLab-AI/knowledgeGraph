ngm:creative-ai-domain a owl:Class ;
    rdfs:label "Creative AI Domain"@en ;
    rdfs:comment "The Creative AI Domain covers the application of artificial intelligence to artistic and design tasks across image, music, writing and interactive media. Its scope includes computational creativity, style transfer, generative art and human-machine co-creation. It is an applied sub-area of the Artificial Intelligence Domain that builds on generative methods. The boundary excludes the underlying model training, which belongs to the Generative Modelling Domain."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:computer-graphics-domain ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:generative-modelling-domain ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:style-transfer ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:computational-creativity ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:generative-ai-domain ],
        ngm:artificial-intelligence-domain ;
    vc:enables ngm:assisted-design,
        ngm:content-creation,
        ngm:interactive-media ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:co-creative-tools,
        ngm:computational-creativity,
        ngm:generative-art,
        ngm:music-generation,
        ngm:style-transfer ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:computer-graphics-domain,
        ngm:generative-ai-domain,
        ngm:generative-modelling-domain ;
    vc:slug "creative-ai-domain" ;
    vc:sourceDomain "creative-ai" .

