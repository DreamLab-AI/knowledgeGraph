# Power Supply
infrastructure:PowerSupply rdf:type owl:Class ;
    rdfs:label "Power Supply"@en ;
    rdfs:comment "A power supply unit (PSU) is an internal hardware component that converts alternating current (AC) from mains electricity into regulated low-voltage direct current (DC) required by computing equipment's internal components including motherboard, CPU, GPU, and storage devices. In data center contexts, power supply systems include redundant PSUs, uninterruptible power supplies (UPS), and power distribution units (PDUs)."@en ;
    skos:prefLabel "Power Supply"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:infrastructure:power-supply" ;
    owl:sameAs <urn:visionclaw:concept:infrastructure:power-supply> ;
