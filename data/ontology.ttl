        ngm:osi-model,
        ngm:packet-switching ;
    vc:requires ngm:network-protocol,
        ngm:operating-system ;
    vc:slug "network-interface" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:network-protocol ;
    vc:uses ngm:ethernet,
        ngm:tcp .

ngm:neural-machine-translation a owl:Class ;
    rdfs:label "Neural Machine Translation"@en ;
    rdfs:comment "Neural Machine Translation (NMT) is an approach to automated language translation in which end-to-end neural networks — typically based on encoder-decoder architectures with attention mechanisms — learn to map source-language sequences directly to target-language sequences from parallel corpora. Unlike earlier statistical phrase-based methods, NMT systems capture long-range dependencies and global sentence context, producing more fluent and contextually accurate translations. The Transformer architecture has become the dominant NMT paradigm since its introduction in 2017."@en ;
    rdfs:subClassOf ngm:language-translation ;
    vc:enables ngm:real-time-language-translation,
        ngm:real-time-translation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:deep-learning,
        ngm:language-model,
        ngm:natural-language-processing ;
    vc:slug "neural-machine-translation" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:attention-mechanism,
        ngm:encoder-decoder-architecture,
        ngm:transformer-architecture .

ngm:neural-network-component a owl:Class ;
    rdfs:label "Neural Network Component"@en ;
    rdfs:comment "A discrete structural or functional building block within a neural network model, including layers, activation functions, normalisation mechanisms, attention heads, and connection schemes. These components are composed to form complete neural network architectures and directly determine model capacity, training dynamics, and inference behaviour."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:decoder ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:residual-connection ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:batch-normalisation ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:attention-head ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:positional-encoding ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:encoder ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:attention-mechanism ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:dropout ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:activation-function ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:neural-network-layer ],
        ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:activation-function,
