        ngm:post-processing,
        ngm:rasterization,
        ngm:ray-tracing ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:ambient-occlusion,
        ngm:deferred-rendering,
        ngm:screen-space-reflections,
        ngm:temporal-antialiasing ;
    vc:requires ngm:graphics-processing-unit,
