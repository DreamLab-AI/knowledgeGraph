ngm:evaluation-metric a owl:Class ;
    rdfs:label "Evaluation Metric"@en ;
    rdfs:comment "An evaluation metric is a quantitative or qualitative measure used to assess the performance, quality, or behaviour of a machine learning model, algorithm, or system against a defined objective. Metrics are computed over held-out test data or through human judgement protocols and provide the empirical basis for model comparison, selection, and deployment decisions. The choice of metric directly shapes what properties a model optimises for during training and what trade-offs are made between competing objectives such as accuracy, fairness, and calibration. Metric selection is therefore a first-class design decision whose consequences cascade from training dynamics through to safety, governance, and societal impact."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:fairness-metrics ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:precision ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:loss-function ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:accuracy ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:recall ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:f1-score ],
        ngm:performance-metrics ;
    vc:bridgesTo ngm:ai-regulation,
        ngm:data-governance ;
    vc:contrastsWith ngm:loss-function,
        ngm:objective-function ;
    vc:enables ngm:hyperparameter-tuning,
        ngm:model-comparison,
        ngm:model-selection ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:accuracy,
        ngm:auc-roc,
        ngm:f1-score,
        ngm:fairness-metrics,
        ngm:loss-function,
        ngm:precision,
        ngm:recall ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:benchmark-standard,
        ngm:calibration,
        ngm:goodharts-law,
        ngm:model-card,
        ngm:model-evaluation-results,
        ngm:model-performance ;
    vc:requires ngm:evaluation-protocol,
        ngm:ground-truth-label,
        ngm:test-dataset ;
    vc:slug "evaluation-metric" ;
    vc:sourceDomain "ai" ;
    vc:supports ngm:ai-governance,
        ngm:ai-safety,
        ngm:machine-learning-discipline,
        ngm:model-training,
        ngm:responsible-ai .

ngm:inference a owl:Class ;
    rdfs:label "Inference"@en ;
    rdfs:comment "Inference is the process of applying a trained AI model to new, unseen data to produce predictions, classifications, or generated outputs. It is distinct from training in that model parameters are fixed; the computational objective is throughput, latency, and memory efficiency. Inference is the primary execution path in production deployments and is governed by ISO/IEC 22989:2022 clause 3.3.4."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:post-processing ],
        ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:bridgesTo ngm:edge-computing,
        ngm:spatial-ai ;
    vc:contrastsWith ngm:fine-tuning,
        ngm:training ;
    vc:dependsOn ngm:compute-resource,
        ngm:model-training,
        ngm:neural-network,
        ngm:trained-model ;
    vc:enables ngm:ai-deployment,
        ngm:edge-ai,
        ngm:prediction,
        ngm:real-time-ai ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:forward-pass,
        ngm:post-processing,
        ngm:token-generation ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:latency,
        ngm:model-compression,
        ngm:onnx,
        ngm:throughput ;
    vc:slug "inference" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:standardizedBy ngm:iso-iec-22989 ;
    vc:supports ngm:mlops,
        ngm:model-serving ;
    vc:uses ngm:batching,
        ngm:hardware-acceleration,
        ngm:inference-hardware,
        ngm:quantization,
        ngm:runtime-engine .

ngm:linear-algebra a owl:Class ;
    rdfs:label "Linear Algebra"@en ;
    rdfs:comment "Linear Algebra is the branch of mathematics concerned with vector spaces, linear transformations and systems of linear equations. Its central objects include vectors, matrices, determinants, eigenvalues and eigenvectors, and operations such as matrix multiplication and inversion. The field provides the language for representing and solving problems in geometry, physics, computer graphics and data analysis. It is foundational to machine learning, where data, model parameters and transformations are expressed and manipulated as tensors."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:set-theory ],
        ngm:ai-research-area ;
    skos:broader ngm:ai-research-area ;
    vc:bridgesTo ngm:computer-graphics,
