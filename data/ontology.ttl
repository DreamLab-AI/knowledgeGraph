ngm:records-management a owl:Class ;
    rdfs:label "Records Management"@en ;
    rdfs:comment "Records management is the systematic control of an organisation's records throughout their lifecycle — from creation and capture through classification, storage and use, to retention, archiving and eventual disposal. It applies policies and standards, notably ISO 15489, to ensure that records remain authentic, reliable and accessible for as long as they are required for business, legal and regulatory purposes. Effective records management supports accountability, compliance and efficient information governance."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:retention-policy ],
        ngm:information-governance ;
    vc:contrastsWith ngm:data-governance ;
    vc:dependsOn ngm:metadata ;
