ngm:language-translation a owl:Class ;
    rdfs:label "Language Translation"@en ;
    rdfs:comment "Language translation is the automated or human-assisted conversion of text or speech from a source language into a target language whilst preserving semantic meaning, tone, and cultural context. Modern neural machine translation systems, built on transformer architectures and large language models, enable real-time multilingual communication across distributed collaboration platforms and metaverse environments."@en ;
