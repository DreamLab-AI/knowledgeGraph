        ngm:regulatory-compliance ;
    vc:uses ngm:european-blockchain-services-infrastructure,
        ngm:horizon-europe .

ngm:fido2 a owl:Class ;
    rdfs:label "FIDO2"@en ;
    rdfs:comment "FIDO2 is an open authentication standard developed by the FIDO Alliance and W3C that enables passwordless, phishing-resistant authentication using public-key cryptography. It consists of two components: the W3C Web Authentication API (WebAuthn), which defines the browser and platform interface for creating and using public key credentials, and the Client to Authenticator Protocol (CTAP2), which defines the communication between a platform and an external authenticator such as a hardware security key or passkey-capable device. FIDO2 credentials are bound to a specific relying party origin, making them immune to phishing, and private keys never leave the authenticator device, eliminating the credential theft risk associated with password databases."@en ;
    rdfs:subClassOf ngm:authentication-standards ;
    vc:bridgesTo ngm:decentralised-identity,
        ngm:digital-identity-wallet ;
    vc:contrastsWith ngm:otp-authentication,
        ngm:password-authentication ;
    vc:enables ngm:identity-verification,
        ngm:multi-factor-authentication,
        ngm:passkey,
        ngm:passwordless-authentication,
        ngm:phishing-resistant-authentication ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:ctap2,
        ngm:webauthn ;
    vc:implements ngm:origin-bound-credential ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:authentication,
        ngm:identity-management,
        ngm:trusted-platform-module,
        ngm:zero-trust-architecture ;
    vc:requires ngm:authenticator-device,
        ngm:relying-party,
        ngm:user-verification ;
    vc:slug "fido2" ;
    vc:sourceDomain "security" ;
    vc:standardizedBy ngm:fido-alliance,
        ngm:w3c ;
    vc:uses ngm:challenge-response-protocol,
        ngm:digital-signature,
        ngm:hardware-security-module,
        ngm:public-key-cryptography,
        ngm:web-standard .

ngm:financial-action-task-force a skos:Concept ;
    rdfs:label "Financial Action Task Force"@en .

ngm:fractional-ownership a owl:Class ;
    rdfs:label "Fractional Ownership"@en ;
    rdfs:comment "Fractional ownership is a model in which a high-value asset is divided into discrete shares that multiple parties hold simultaneously, each acquiring proportional economic rights and, in some structures, governance rights over the underlying asset. Historically applied to aircraft, real estate, and fine art through legal syndication, it has been radically simplified by blockchain-based tokenisation, which encodes shares as on-chain tokens transferable without traditional intermediaries. Fractional ownership democratises access to asset classes previously restricted to institutional or wealthy investors. It raises important questions of regulatory classification, valuation, and liquidity management."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:smart-contract ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:kyc-aml-compliance ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:securities-regulation ],
        ngm:asset-tokenization ;
    vc:bridgesTo ngm:metaverse-land-ownership,
        ngm:real-world-asset-tokenization ;
    vc:contrastsWith ngm:sole-ownership,
        ngm:timeshare ;
    vc:dependsOn ngm:asset-valuation,
        ngm:blockchain,
        ngm:token-standard ;
    vc:enables ngm:decentralized-finance-de-fi,
        ngm:digital-asset-trading,
        ngm:investment-management,
        ngm:liquidity-provision ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:governance-rights,
        ngm:ownership-share ;
    vc:isPartOf ngm:alternative-investment,
        ngm:asset-tokenization ;
