ngm:inverted-index a owl:Class ;
    rdfs:label "Inverted Index"@en ;
    rdfs:comment "An inverted index is a data structure that maps each term to the list of documents (and often positions) in which it appears, enabling fast full-text retrieval over large corpora. It inverts the natural document-to-terms relationship so that a query term immediately yields its posting list, which can then be intersected or scored. It is the foundational index behind search engines and lexical information retrieval."@en ;
    rdfs:subClassOf ngm:information-retrieval ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:information-retrieval,
        ngm:semantic-search ;
    vc:slug "inverted-index" ;
    vc:sourceDomain "data" .

ngm:ip-adapter a owl:Class ;
    rdfs:label "IP-Adapter"@en ;
    rdfs:comment "IP-Adapter (Image Prompt Adapter) is a lightweight adapter module for pre-trained text-to-image diffusion models that enables image-conditioned generation by injecting reference image features via a decoupled cross-attention mechanism. Introduced by Tencent AI Lab in 2023, it allows users to supply a reference image alongside a text prompt to control style, subject identity, or composition without fine-tuning the base diffusion model. The adapter architecture inserts parallel cross-attention layers that process image embeddings from a pre-trained image encoder such as CLIP, keeping base model weights frozen."@en ;
    rdfs:subClassOf ngm:adapter-modules ;
    vc:contrastsWith ngm:fine-tuning ;
    vc:dependsOn ngm:attention-mechanism,
        ngm:cross-attention,
        ngm:diffusion-model,
        ngm:stable-diffusion-image-model ;
    vc:enables ngm:computer-vision,
        ngm:generative-ai ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:control-net,
        ngm:fine-tuning,
        ngm:image-to-image-translation,
        ngm:inpainting,
        ngm:style-transfer ;
    vc:slug "ip-adapter" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:hugging-face-diffusers,
        ngm:image-generation,
        ngm:prompt-engineering .

ngm:iso-tc-307 a owl:Class ;
    rdfs:label "ISO TC 307"@en ;
    rdfs:comment "ISO/TC 307 is the ISO Technical Committee established in 2016 with Australia as secretariat, mandated to develop international standards for blockchain and distributed ledger technologies (DLT). Its normative outputs span terminology (ISO 22739), reference architecture, security and privacy frameworks, smart contract interaction models, digital identity standards, and governance structures for decentralised systems. The committee coordinates with ISO/TC 68 (Financial Services), ISO/IEC JTC 1/SC 27 (Cryptographic Security), W3C, ITU-T SG17, and IEEE to ensure interoperability standards and shared vocabulary underpin regulatory, procurement, and legislative language across jurisdictions. It operates through specialised working groups covering foundations, security, smart contracts, data governance, DLT governance, and interoperability."@en ;
    rdfs:subClassOf ngm:standards-body ;
    vc:bridgesTo ngm:data-governance,
        ngm:regulatory-compliance,
        ngm:supply-chain-traceability ;
    vc:enables ngm:blockchain-interoperability,
        ngm:cross-chain-communication,
        ngm:digital-identity-standards,
        ngm:distributed-ledger-technology ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:blockchain-governance-framework,
        ngm:blockchain-terminology,
        ngm:dlt-security-framework,
