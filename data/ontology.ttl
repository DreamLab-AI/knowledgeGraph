    rdfs:comment "The first decentralised peer-to-peer electronic cash system and cryptocurrency, implementing proof-of-work consensus, a fixed 21 million coin supply cap, and the UTXO transaction model, serving as the foundational reference implementation for blockchain technology."@en ;
    skos:prefLabel "Bitcoin"@en ;
    dcterms:identifier "BC-4000" ;
    dcterms:subject "bc" ;
    dcterms:type "mature" ;
    dcterms:conformsTo "1.0"^^xsd:decimal ;
    rdf:type owl:ObjectClass .

