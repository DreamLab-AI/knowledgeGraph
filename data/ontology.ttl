    vc:sourceDomain "standards" .

ngm:ieee-standards-association a owl:Class ;
    rdfs:label "IEEE Standards Association"@en ;
    rdfs:comment "The IEEE Standards Association (IEEE SA) is the standards development arm of the Institute of Electrical and Electronics Engineers, operating a consensus-based process through which industry, government, and academic stakeholders collaboratively develop and maintain technical standards covering electrical, electronic, computing, and communications technologies, with over 1,400 active standards and more than 900 standards under active development at any time."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:ieee-robotics-and-automation-society ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:ieee-control-systems-society ],
        ngm:standards-body ;
    vc:enables ngm:interoperability-standard,
        ngm:technical-standards ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:ieee-control-systems-society,
        ngm:ieee-robotics-and-automation-society ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:ieee,
        ngm:technical-standard ;
    vc:slug "ieee-standards-association" ;
    vc:sourceDomain "governance" ;
    vc:standardizedBy ngm:standards-organization .

ngm:ifrs-s1 a owl:Class ;
    rdfs:label "IFRS S1"@en ;
    rdfs:comment "IFRS S1 is the inaugural sustainability-disclosure standard issued by the International Sustainability Standards Board, setting general requirements for disclosing sustainability-related financial information. It requires entities to report material risks and opportunities across governance, strategy, risk management, and metrics that could affect their prospects. IFRS S1 establishes the common baseline on which topic-specific standards such as IFRS S2 build."@en ;
    rdfs:subClassOf ngm:technical-standard ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:ifrs-s2 ;
    vc:slug "ifrs-s1" ;
    vc:sourceDomain "governance" ;
    vc:supports ngm:esg-reporting .

ngm:ifrs-s2 a owl:Class ;
    rdfs:label "IFRS S2"@en ;
    rdfs:comment "IFRS S2 is the climate-related disclosure standard issued by the International Sustainability Standards Board, specifying how entities report climate-related risks and opportunities. Building on the TCFD recommendations, it requires disclosure of physical and transition risks, greenhouse-gas emissions across Scopes 1 to 3, and climate-resilience analysis. IFRS S2 operates alongside the general IFRS S1 baseline."@en ;
    rdfs:subClassOf ngm:technical-standard ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:ifrs-s1 ;
    vc:slug "ifrs-s2" ;
    vc:sourceDomain "governance" ;
    vc:supports ngm:esg-reporting .

ngm:image-synthesis a owl:Class ;
    rdfs:label "Image Synthesis"@en ;
    rdfs:comment "The generation of images from models or descriptions rather than direct capture, including rendering from scene data and machine learning models that produce images from learned distributions."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:generative-model ],
        ngm:image-generation ;
    vc:enables ngm:computer-graphics ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:generative-model ;
    vc:slug "image-synthesis" ;
    vc:sourceDomain "general" .

ngm:image-to-image a owl:Class ;
    rdfs:label "Image-to-Image"@en ;
    rdfs:comment "Image-to-image is a class of generative tasks where a model transforms an input image into an output image, conditioned on the input and often a text prompt. Examples include style transfer, editing and translation between domains."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:diffusion-model ],
        ngm:image-generation ;
    vc:enables ngm:inpainting ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:diffusion-model ;
    vc:slug "image-to-image" ;
    vc:sourceDomain "generative-ai" .

ngm:immersive-audio-system a owl:Class ;
    rdfs:label "Immersive Audio System"@en ;
    rdfs:comment "Audio technologies enabling three-dimensional soundscapes in virtual environments through spatial audio processing, binaural rendering, and head-related transfer functions (HRTF), creating realistic acoustic experiences that respond to user position and movement within VR, AR, and metaverse appli..."@en ;
    rdfs:subClassOf ngm:audio-technology,
        ngm:sc-display-and-rendering ;
    skos:broader ngm:sc-display-and-rendering ;
    vc:enables ngm:spatial-presence ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:slug "immersive-audio-system" ;
    vc:sourceDomain "spatial-computing" .

ngm:immersive-experience-pipeline a owl:Class ;
    rdfs:label "Immersive Experience Pipeline"@en ;
    rdfs:comment "The end-to-end workflow for creating, processing, and delivering XR content, encompassing concept design, 3D asset creation, game engine integration, optimisation, platform deployment, and cloud streaming to produce immersive virtual experiences for metaverse applications."@en ;
    rdfs:subClassOf ngm:content-production-workflow,
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:enables ngm:xr-content-delivery ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:slug "immersive-experience-pipeline" ;
    vc:sourceDomain "spatial-computing" .

ngm:immersive-gaming a owl:Class ;
    rdfs:label "Immersive Gaming"@en ;
    rdfs:comment "Video gaming experiences enhanced through VR, AR, and metaverse technologies that place players within interactive 3D environments, enabling physical interaction, spatial awareness, and presence-based gameplay through advanced headsets, motion tracking, and haptic feedback systems."@en ;
    rdfs:subClassOf ngm:digital-gaming,
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:enables ngm:vr-gaming-experience ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:slug "immersive-gaming" ;
    vc:sourceDomain "spatial-computing" .

ngm:importer a owl:Class ;
    rdfs:label "Importer"@en ;
    rdfs:comment "A natural or legal person located or established in the Union that places on the market an AI system that bears the name or trademark of a natural or legal person established in a third country."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ai-regulation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:legal-compliance ],
        ngm:sc-standards-and-interop ;
    skos:broader ngm:sc-standards-and-interop ;
    vc:dependsOn ngm:legal-framework ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:ai-governance,
        ngm:supply-chain ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:accountability,
        ngm:risk-management ;
    vc:requires ngm:ai-regulation,
        ngm:legal-compliance ;
    vc:slug "importer" ;
    vc:sourceDomain "spatial-computing" .

ngm:imu-sensors a owl:Class ;
    rdfs:label "IMU Sensors"@en ;
    rdfs:comment "An inertial measurement unit (IMU) is a sensor package that measures a body's specific force and angular rate, typically combining a three-axis accelerometer and a three-axis gyroscope, often with a magnetometer. By integrating these measurements it estimates orientation, velocity, and relative motion without external references. IMUs are central to motion tracking, navigation, and stabilisation in robotics, XR, and aerospace."@en ;
    rdfs:subClassOf ngm:sensor ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:motion-capture-rig ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:lens-and-camera-calibration ;
    vc:slug "imu-sensors" ;
    vc:sourceDomain "robotics" .

ngm:incentive-structures a owl:Class ;
    rdfs:label "Incentive Structures"@en ;
    rdfs:comment "Incentive structures are the systems of rewards and penalties that shape the behaviour of agents within an economic or protocol system, aligning individual self-interest with desired collective outcomes. In decentralised systems they encode rewards such as block subsidies, fees, and staking yields, alongside slashing or penalties, to make honest participation the rational choice. Well-designed incentive structures are central to mechanism design and the security of token economies."@en ;
    rdfs:subClassOf ngm:economic-mechanism ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:game-theory ;
    vc:slug "incentive-structures" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:economics .

ngm:inclusive-xr-design a owl:Class ;
    rdfs:label "Inclusive Xr Design"@en ;
    rdfs:comment "Design modologies for creating accessible VR, AR, and metaverse experiences that accommodate diverse user abilities, including those with visual, auditory, motor, and cognitive disabilities, ensuring equitable access through alternative input mods, adaptive interfaces, and assistive technology in..."@en ;
    rdfs:subClassOf ngm:accessible-design,
        ngm:sc-governance-and-safety ;
    skos:broader ngm:sc-governance-and-safety ;
    vc:enables ngm:universal-xr-access ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:slug "inclusive-xr-design" ;
    vc:sourceDomain "spatial-computing" .

ngm:inclusive-xr-experience a owl:Class ;
    rdfs:label "Inclusive Xr Experience"@en ;
    rdfs:comment "Extended reality applications and environments designed to provide equitable, accessible experiences for users of all abilities, incorporating assistive technologies, alternative interaction modalities, and adaptive features that ensure meaningful participation in VR, AR, and metaverse spaces."@en ;
    rdfs:subClassOf ngm:accessible-experience,
        ngm:sc-governance-and-safety ;
    skos:broader ngm:sc-governance-and-safety ;
    vc:enables ngm:equitable-metaverse-access ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:slug "inclusive-xr-experience" ;
    vc:sourceDomain "spatial-computing" .

ngm:industry-4-0 a owl:Class ;
    rdfs:label "Industry 4.0"@en ;
    rdfs:comment "Industry 4.0 denotes the fourth industrial revolution, characterised by the integration of cyber-physical systems, industrial Internet of Things, cloud computing, advanced robotics, and artificial intelligence into manufacturing and supply chain operations to create smart, autonomous, and highly flexible production environments. Originating from a German government initiative, it represents a strategic framework for digitalising industrial production through real-time data exchange, machine intelligence, and networked automation."@en ;
    rdfs:subClassOf ngm:industrial-automation ;
    vc:enables ngm:smart-city ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:industrial-metaverse,
        ngm:opc-ua ;
    vc:slug "industry-4-0" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:cyber-physical-systems,
        ngm:digital-twin,
        ngm:industrial-io-t .

ngm:inertia a owl:Class ;
    rdfs:label "Inertia"@en ;
    rdfs:comment "The physical property of a body that resists changes in its state of motion, whether translational or rotational. In robotics and actuation systems, inertia determines how much force or torque is required to accelerate or decelerate a component, and must be modelled accurately for stable, precise control."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:robotics-control ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:actuator ],
