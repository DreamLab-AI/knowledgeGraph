ngm:external-ai-harness a owl:Class ;
    rdfs:comment "An external AI harness is an out-of-process orchestration framework that manages AI model inference via network APIs, message queues, or service meshes, providing process-boundary isolation, horizontal scalability, multi-model routing, fault tolerance, and multi-tenant governance at the cost of additional serialisation latency and inter-process communication overhead, making it the preferred architecture for enterprise-scale agentic deployments requiring auditability, model versioning, and independent component scaling."@en ;
    rdfs:label "External AI Harness"@en ;
    rdfs:subClassOf ngm:agent-harness ;
