ngm:group-chat-channel a owl:Class ;
    rdfs:label "Group Chat Channel"@en ;
    rdfs:comment "A group chat channel is a persistent, named messaging space where multiple participants can send and receive messages collectively. Channels are typically organised by topic, project, or team, providing a shared context for ongoing conversation and record-keeping. They support both synchronous and asynchronous communication patterns within distributed organisations."@en ;
    rdfs:subClassOf ngm:dc-communication ;
    skos:broader ngm:dc-communication ;
    vc:hasMaturity ngmi:maturity-established ;
