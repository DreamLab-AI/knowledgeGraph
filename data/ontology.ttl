ngm:metaverse-platform a owl:Class ;
    rdfs:label "Metaverse Platform"@en ;
    rdfs:comment "Virtual world environments such as Roblox, Fortnite, Decentraland, and VRChat that provide persistent, shared, real-time spaces for social interaction, gaming, commerce, and creative expression with varying degrees of decentralisation and user-generated content."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
