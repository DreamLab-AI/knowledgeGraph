    vc:sourceDomain "ai" ;
    vc:uses ngm:distributed-training,
        ngm:foundation-model,
        ngm:lora-fine-tuning,
        ngm:python-programming-language,
        ngm:quantisation .

ngm:apache-atlas a owl:Class ;
    rdfs:label "Apache Atlas"@en ;
    rdfs:comment "Apache Atlas is an open-source metadata management and data governance framework, originally built for the Hadoop ecosystem, that catalogs data assets, captures end-to-end lineage, and enforces classification and access policies. It exposes a typed metadata model and search so organizations can discover datasets, trace how data flows between systems, and apply governance tags. Atlas integrates with engines such as Hive, Kafka, and HBase to collect lineage automatically."@en ;
    rdfs:subClassOf ngm:infra-data-management ;
    skos:broader ngm:infra-data-management ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:metadata-management ;
    vc:slug "apache-atlas" ;
    vc:sourceDomain "data" .

ngm:apache-parquet a owl:Class ;
    rdfs:label "Apache Parquet"@en ;
    rdfs:comment "Apache Parquet is an open-source columnar storage file format designed for efficient analytical processing of large datasets. By storing values of the same column contiguously, it enables aggressive compression and encoding, predicate pushdown, and reading only the columns a query needs, dramatically reducing I/O for analytical workloads. It carries a self-describing schema and rich metadata, and is widely used as the on-disk format for data lakes and big-data engines."@en ;
    rdfs:subClassOf ngm:blockchain ;
    skos:broader ngm:blockchain ;
    vc:bridgesTo ngm:data-warehouse ;
    vc:contrastsWith ngm:file-format ;
