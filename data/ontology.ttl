ngm:bandwidth-adaptation a owl:Class ;
    rdfs:label "Bandwidth Adaptation"@en ;
    rdfs:comment "Bandwidth adaptation is the real-time, algorithmic process by which a media transmission system continuously measures available network capacity and dynamically adjusts encoding parameters — bitrate, resolution, frame rate, codec profile, and layer selection — to maintain the highest achievable [..."@en ;
    rdfs:subClassOf ngm:adaptive-bitrate-streaming,
        ngm:congestion-control ;
    vc:enables ngm:cloud-gaming,
        ngm:emerging-market-accessibility,
        ngm:global-participation-across-networks,
        ngm:graceful-degradation,
        ngm:mobile-collaboration,
        ngm:resilient-video-streaming,
        ngm:spatial-computing-streaming ;
    vc:hasPart ngm:abr-algorithm,
        ngm:bandwidth-estimator,
        ngm:bitrate-ladder,
        ngm:buffer-manager,
        ngm:codec-parameter-controller,
        ngm:network-capacity-probing,
        ngm:rate-distortion-optimisation,
        ngm:rtcp-feedback,
        ngm:segment-scheduler ;
    vc:implements ngm:bbr-congestion-control,
        ngm:bola-algorithm,
        ngm:dash-adaptive-streaming,
        ngm:hls-adaptive-bitrate,
        ngm:mpc-algorithm,
        ngm:pensieve-rl-policy,
        ngm:scalable-video-coding,
        ngm:web-rtc-simulcast ;
