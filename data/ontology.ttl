ngm:lightning-service-provider a owl:Class ;
    rdfs:label "Lightning Service Provider"@en ;
    rdfs:comment "A Lightning Service Provider is a business that supplies channel liquidity and connectivity services to Lightning Network users. It helps wallets open channels and receive payments."@en ;
