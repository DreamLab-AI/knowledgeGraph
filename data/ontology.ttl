ngm:group-vs-individual-fairness a owl:Class ;
    rdfs:label "Group vs Individual Fairness"@en ;
    rdfs:comment "Group vs Individual Fairness denotes two competing paradigms for defining and enforcing algorithmic fairness: group fairness requires statistical parity of outcomes or error rates across protected demographic cohorts, while individual fairness requires that similar individuals receive similar predictions regardless of group membership. The two paradigms are formally incompatible in general — satisfying demographic parity does not guarantee individual fairness and vice versa — representing a fundamental tension in fair machine learning that practitioners must resolve through context-specific policy choices. This distinction shapes the selection of fairness metrics, audit methodologies, and bias mitigation interventions in AI system design."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:bias-detection-methods ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:fairness-constraints ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:fairness-metrics ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:fairness-auditing-tools ],
        ngm:ai-ethics,
        ngm:ai-governance-and-ethics ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:contrastsWith ngm:fairness-accuracy-tradeoffs ;
    vc:enables ngm:algorithmic-accountability,
        ngm:bias-mitigation-techniques ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:fairness-constraints,
        ngm:fairness-metrics ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:algorithmic-bias,
        ngm:disparate-impact,
        ngm:equity,
        ngm:fairness,
        ngm:fairness-oecd ;
    vc:requires ngm:bias-detection-methods,
        ngm:fairness-auditing-tools ;
    vc:slug "group-vs-individual-fairness" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:explainability,
        ngm:machine-learning-model .

ngm:hardware-platform-agnostic a owl:Class ;
    rdfs:label "Hardware Platform Agnostic"@en ;
    rdfs:comment "A design principle and architectural quality ensuring that software, systems, or protocols can operate independently of specific hardware architectures or platform implementations. Hardware-agnostic systems achieve portability through abstraction layers—such as virtual machines, containers, or cross-platform runtimes—that decouple application logic from underlying physical or operating-system constraints."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:interoperability-standard ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:open-standard ],
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:contrastsWith ngm:xr-hardware ;
    vc:enables ngm:interoperability,
        ngm:xr-framework ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:requires ngm:interoperability-standard,
        ngm:open-standard ;
    vc:slug "hardware-platform-agnostic" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:extended-reality,
        ngm:metaverse-architecture .

ngm:hash-collision a owl:Class ;
    rdfs:label "Hash Collision"@en ;
    rdfs:comment "A hash collision occurs when two distinct inputs produce the same output from a cryptographic hash function, violating the collision-resistance property that is essential to blockchain data integrity. In blockchain systems, collision resistance ensures that no adversary can craft two different transactions or blocks yielding the same hash digest, making Merkle tree roots and block headers tamper-evident. While collisions are computationally infeasible for production-grade functions such as SHA-256, their theoretical possibility drives ongoing cryptographic research and post-quantum security planning."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptography ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptographic-primitive ],
        ngm:bc-cryptographic-primitive,
        ngm:blockchain-entity,
        ngm:cryptographic-primitive ;
    skos:broader ngm:bc-cryptographic-primitive ;
    vc:contrastsWith ngm:collision-resistance,
        ngm:cryptographic-commitment ;
    vc:enables ngm:adversarial-attack,
        ngm:attack-vector ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:cryptographic-domain,
        ngm:cryptography-security-and-privacy ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:blockchain-transaction,
        ngm:cryptographic-hash,
        ngm:cryptographic-hash-function,
        ngm:cryptographic-security ;
    vc:requires ngm:cryptographic-primitive,
        ngm:cryptography ;
    vc:slug "hash-collision" ;
    vc:sourceDomain "blockchain" .

