    vc:hasPart ngm:bounding-volume-hierarchy,
        ngm:octree-spatial-index,
        ngm:quadtree ;
    vc:isPartOf ngm:spatial-database,
        ngm:virtual-world-infrastructure ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:coordinate-system,
        ngm:distance-metric ;
    vc:slug "spatial-index" ;
    vc:sourceDomain "spatial-computing" .

ngm:state-management a owl:Class ;
    rdfs:label "State Management"@en ;
    rdfs:comment "State Management is the set of patterns, architectures, and tools used to represent, update, synchronise, and persist the mutable state of an application or distributed system in a predictable and auditable way. In single-page web applications, state management libraries such as Redux implement unidirectional data flow and immutable state trees. In distributed systems, state management encompasses consensus protocols, state machine replication, and event sourcing patterns that ensure all nodes maintain consistent views of shared state despite failures and network partitions. Blockchain ledgers represent a specialised form of state management with Byzantine fault-tolerant distributed consensus."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:event-sourcing ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-persistence ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:concurrency-control ],
        ngm:software-architecture ;
    vc:bridgesTo ngm:blockchain,
        ngm:smart-contract ;
    vc:contrastsWith ngm:stateless-architecture ;
    vc:enables ngm:data-consistency,
        ngm:distributed-system,
        ngm:fault-tolerance,
        ngm:scalability ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:command-query-responsibility-segregation,
        ngm:event-sourcing ;
    vc:implements ngm:eventual-consistency ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:audit-trail,
        ngm:cap-theorem,
        ngm:distributed-systems,
        ngm:message-queue,
        ngm:raft ;
    vc:requires ngm:concurrency-control,
        ngm:data-persistence ;
    vc:slug "state-management" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:consensus-protocol,
        ngm:event-driven-architecture,
        ngm:state-machine,
        ngm:state-machine-replication .

ngm:state-synchronization a owl:Class ;
    rdfs:label "State Synchronization"@en ;
    rdfs:comment "The process of maintaining consistent, coherent representations of virtual world state across distributed clients, servers, and edge nodes through continuous replication, conflict resolution, and consistency protocols."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:timestamp ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:clock-synchronization ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:replication ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:network-transport ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:conflict-resolution ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:synchronization-protocol ],
        ngm:distributed-system-architecture,
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:enables ngm:distributed-collaboration,
        ngm:shared-virtual-world,
        ngm:user-experience ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:conflict-resolution,
        ngm:delta-compression,
        ngm:replication,
        ngm:timestamp ;
    vc:isPartOf ngm:digital-twin-interop-protocol,
        ngm:distributed-architecture,
        ngm:distributed-system-architecture ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:clock-synchronization,
        ngm:network-transport,
        ngm:state-representation,
        ngm:synchronization-protocol ;
    vc:slug "state-synchronization" ;
    vc:sourceDomain "spatial-computing" .

ngm:storage-systems a owl:Class ;
    rdfs:label "Storage Systems"@en ;
    rdfs:comment "Storage Systems are the hardware and software architectures responsible for persisting, organising, retrieving, and protecting digital data across the full hierarchy from on-chip registers and DRAM through local SSDs and HDDs to distributed cloud object stores and decentralised peer-to-peer networks. The discipline encompasses storage media technology, file systems, block and object storage interfaces, data durability through redundancy (RAID, erasure coding), consistency and replication protocols for distributed deployments, and the performance-cost-durability tradeoffs that govern system design. Storage Systems are foundational infrastructure for every computing application, with particular complexity arising in distributed and decentralised configurations where network partitions, node failures, and latency variability must be handled."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:cloud-storage ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:persistent-storage ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-consistency ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:content-addressed-storage ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:networking ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:file-system ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:object-storage ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:distributed-storage ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:block-storage ],
        ngm:storage-infrastructure ;
    vc:bridgesTo ngm:blockchain,
        ngm:decentralised-storage,
        ngm:vector-database ;
    vc:enables ngm:backup-and-recovery,
        ngm:data-integrity,
        ngm:data-persistence,
        ngm:data-replication,
        ngm:fault-tolerance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:block-storage,
        ngm:cloud-storage,
        ngm:content-addressed-storage,
        ngm:distributed-storage,
        ngm:file-system,
        ngm:object-storage,
        ngm:persistent-storage ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:cap-theorem,
        ngm:data-storage-layer,
        ngm:erasure-coding,
        ngm:raid,
        ngm:storage-hardware ;
    vc:requires ngm:data-consistency,
        ngm:networking ;
    vc:slug "storage-systems" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:database-management-system,
        ngm:machine-learning .

ngm:style-transfer a owl:Class ;
    rdfs:label "Style Transfer"@en ;
    rdfs:comment "Style Transfer is the technique of applying the artistic style of one image (style image) to the content of another image (content image), creating a new image that combines content from one source with the aesthetic style of another. Neural style transfer employs convolutional neural networks to separate and recombine content and style representations via Gram matrix optimisation, enabling artistic rendering, photo enhancement, and creative visual effects."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:feature-extraction ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:neural-network-training ],
        ngm:image-to-image-translation ;
    vc:bridgesTo ngm:augmented-reality,
        ngm:digital-twin,
        ngm:metaverse ;
    vc:contrastsWith ngm:image-segmentation,
        ngm:texture-synthesis ;
    vc:enables ngm:3-d-content-generation,
        ngm:image-generation ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:computer-vision,
        ngm:generative-ai ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:control-net,
        ngm:diffusion-model,
        ngm:generative-adversarial-network,
        ngm:lo-ra-fine-tuning,
        ngm:variational-autoencoder ;
    vc:requires ngm:feature-extraction,
        ngm:neural-network-training ;
    vc:slug "style-transfer" ;
    vc:sourceDomain "machine-learning" ;
    vc:uses ngm:convolutional-neural-network,
        ngm:deep-learning .

ngm:super-resolution a owl:Class ;
    rdfs:label "Super Resolution"@en ;
    rdfs:comment "Super-Resolution is the process of enhancing the resolution and quality of low-resolution images by predicting and synthesising high-frequency details using deep learning models."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:convolutional-neural-network ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:deep-learning ],
        ngm:sc-display-and-rendering ;
    skos:broader ngm:sc-display-and-rendering ;
    vc:bridgesTo ngm:image-generation ;
    vc:contrastsWith ngm:rasterization ;
    vc:enables ngm:computer-vision,
        ngm:real-time-rendering ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires ngm:convolutional-neural-network,
        ngm:deep-learning ;
    vc:slug "super-resolution" ;
    vc:sourceDomain "spatial-computing" .

ngm:time-series-forecasting a owl:Class ;
    rdfs:label "Time Series Forecasting"@en ;
    rdfs:comment "Time orecasting (TSF) is the domain of statistical and machine learning mods that predict future values of ordered sequential observations indexed by time, encompassing classical statistical approaches (ARIMA — AutoRegressive Integrated Moving Average — modelling the s a linear combination of its..."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:forecast-horizon ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cross-validation ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:evaluation-metric ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:compute-infrastructure ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:probabilistic-forecasting ],
