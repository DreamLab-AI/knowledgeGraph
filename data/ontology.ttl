ngm:adaptive-learning-rate a owl:Class ;
    rdfs:comment "A family of optimisation techniques in which the step size of gradient descent is adjusted automatically during training — typically per parameter, from running statistics of past gradients — so that parameters with large or frequent gradients take smaller steps and rarely-updated parameters take larger ones, as implemented by AdaGrad, RMSProp, and Adam, reducing sensitivity to the manually chosen global learning rate."@en ;
    rdfs:label "Adaptive Learning Rate"@en ;
    rdfs:subClassOf ngm:learning-rate ;
    vc:enables ngm:deep-learning ;
    vc:hasMaturity ngmi:maturity-draft ;
