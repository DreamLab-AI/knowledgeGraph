ngm:real-time-collaborative-editing a owl:Class ;
    rdfs:label "Real-Time Collaborative Editing"@en ;
    rdfs:comment "Real-time collaborative editing is the capability for multiple users to concurrently modify a shared document or data structure and see each other's changes near-instantaneously with automatic conflict resolution. It depends on synchronisation algorithms such as operational transformation or conflict-free replicated data types to maintain a consistent merged state across replicas. It underpins shared documents, whiteboards, and collaborative virtual workspaces."@en ;
    rdfs:subClassOf ngm:distributed-systems ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:crdt ;
    vc:slug "real-time-collaborative-editing" ;
    vc:sourceDomain "infrastructure" .

ngm:real-time-control-loop a owl:Class ;
    rdfs:label "Real-Time Control Loop"@en ;
    rdfs:comment "A real-time control loop is a cyclic sense-compute-actuate process that runs at a fixed, deterministic frequency to regulate a physical or cyber-physical system within strict timing deadlines. Missing a deadline can cause instability or unsafe behaviour, so loops require real-time scheduling and bounded computation. They are the operational core of robotics, motion control, and industrial automation."@en ;
    rdfs:subClassOf ngm:control-system ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:admittance-control,
        ngm:cyber-physical-systems ;
    vc:slug "real-time-control-loop" ;
    vc:sourceDomain "robotics" .

ngm:real-time-data-access a skos:Concept ;
    rdfs:label "Real Time Data Access"@en .

ngm:real-time-data-pipeline a skos:Concept ;
    rdfs:label "Real Time Data Pipeline"@en .

ngm:real-time-digital-twin-synchronization a owl:Class ;
    rdfs:label "Real Time Digital Twin Synchronization"@en ;
    rdfs:comment "The continuous bidirectional data exchange between physical industrial assets and their virtual replicas in the industrial metaverse, enabling real-time monitoring, predictive maintenance, and scenario testing through IoT sensor integration and cloud-based rendering."@en ;
    rdfs:subClassOf ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:bridgesTo ngm:digital-twin-technology ;
    vc:enables ngm:virtual-real-interaction ;
