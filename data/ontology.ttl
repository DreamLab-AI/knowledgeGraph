            owl:someValuesFrom ngm:smart-contract ],
        ngm:bc-defi-and-economics ;
    skos:broader ngm:bc-defi-and-economics ;
    vc:bridgesTo ngm:game-theory,
        ngm:mechanism-design ;
    vc:contrastsWith ngm:order-book-exchange,
        ngm:proof-of-work,
        ngm:traditional-market-making ;
    vc:dependsOn ngm:blockchain,
        ngm:decentralized-finance,
        ngm:ethereum ;
    vc:enables ngm:decentralized-autonomous-organization,
        ngm:decentralized-exchange,
        ngm:protocol-bootstrapping,
        ngm:yield-farming ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:concentrated-liquidity,
        ngm:impermanent-loss,
        ngm:staking,
        ngm:token-emission-schedule ;
    vc:requires ngm:automated-market-maker,
        ngm:liquidity-pool,
        ngm:smart-contract,
        ngm:token-economics ;
    vc:slug "liquidity-mining" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:bonding-curve,
        ngm:governance-token,
        ngm:lp-token,
        ngm:vote-escrow .

ngm:merkle-root a owl:Class ;
    rdfs:label "Merkle Root"@en ;
    rdfs:comment "A Merkle Root is the single cryptographic hash at the apex of a Merkle tree, computed by recursively hashing pairs of child hashes until a single digest remains, such that the root encodes the integrity of every transaction or data element in the tree. In blockchain systems, each block header contains the Merkle root of all transactions in that block, enabling lightweight clients to verify transaction inclusion via a logarithmic-length Merkle proof without downloading the full block. This compact commitment property makes the Merkle root fundamental to blockchain scalability, security, and efficient synchronisation protocols."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:hash-function ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:cryptographic-hash ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:merkle-tree ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptographic-hash-function ],
        ngm:bc-cryptographic-primitive,
        ngm:blockchain-entity,
        ngm:cryptographic-primitive ;
    skos:broader ngm:bc-cryptographic-primitive ;
    vc:enables ngm:blockchain-scalability,
        ngm:blockchain-transaction ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:cryptographic-hash,
        ngm:merkle-tree ;
    vc:isPartOf ngm:block,
        ngm:block-header ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:blockchain-entity,
        ngm:digital-signature,
        ngm:nonce,
        ngm:proof-of-work ;
    vc:requires ngm:cryptographic-hash-function,
        ngm:hash-function ;
    vc:slug "merkle-root" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:blockchain-infrastructure .

