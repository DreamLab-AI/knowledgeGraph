        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:policy-enforcement ],
        ngm:infra-security-and-identity,
        ngm:security-layer ;
    skos:broader ngm:infra-security-and-identity ;
    vc:enables ngm:compliance-with-ccpa,
        ngm:compliance-with-gdpr,
