ngm:autonomous-navigation a owl:Class ;
    rdfs:comment "Autonomous Navigation encompasses the complete system capability for a robot or autonomous agent to move from one location to another without human guidance, integrating perception, localisation, mapping, path planning, obstacle avoidance, and control. Autonomous navigation systems employ SLAM, sensor fusion, and AI-based decision-making to operate safely in unknown or dynamic environments."@en ;
    rdfs:label "Autonomous Navigation"@en ;
