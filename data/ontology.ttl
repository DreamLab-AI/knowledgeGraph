ngm:robustness-oecd a owl:Class ;
    rdfs:label "Robustness (OECD)"@en ;
    rdfs:comment "The OECD Robustness principle (Principle 1.4, revised 2024) mandates that AI systems function reliably and securely throughout their lifecycle, demonstrating resilience against errors, faults, distributional inconsistencies, and adversarial attempts to alter system use or performance. It requires continuous risk assessment covering statistical robustness, fault tolerance, and adversarial resistance, and connects to the EU AI Act Article 15 technical requirements. Providers are responsible for design and testing; deployers are responsible for ongoing monitoring."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:adversarial-testing ],
        ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:enables ngm:ai-governance,
        ngm:responsible-ai-principles ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:trustworthy-ai-framework ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:relatedTo ngm:adversarial-robustness,
        ngm:safety-oecd ;
    vc:requires ngm:adversarial-testing ;
    vc:slug "robustness-oecd" ;
    vc:sourceDomain "spatial-computing" .

