# Event
infrastructure:Event rdf:type owl:Class ;
    rdfs:subClassOf infrastructure:TemporalEntity ;
    rdfs:label "Event"@en ;
    rdfs:comment "A significant occurrence at a specific point in time that represents a change in system state, triggers a process, or carries information between components. Events are fundamental building blocks of temporal and reactive systems, enabling loose coupling and asynchronous communication through immutable, self-contained records of happenings."@en ;
    skos:prefLabel "Event"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:infrastructure:event" ;
