ngm:etsi-domain-creative-media a owl:Class ;
    rdfs:label "ETSI Domain: Creative Media"@en ;
    rdfs:comment "Domain marker for ETSI metaverse categorisation covering creative content production, 3D modelling, rendering, and multimedia authoring for virtual environments."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:creative-tools ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:rendering-pipeline ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:asset-management ],
        ngm:etsi-metaverse-domain-taxonomy,
        ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:enables ngm:avatar-customization,
        ngm:scene-design,
        ngm:virtual-world-building ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:3-d-content-creation,
        ngm:asset-management,
        ngm:multimedia-authoring,
        ngm:rendering-pipeline ;
    vc:isPartOf ngm:etsi-metaverse-domain-taxonomy ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:content-pipeline,
        ngm:creative-tools ;
    vc:slug "etsi-domain-creative-media" ;
    vc:sourceDomain "spatial-computing" .

