ngm:cryptographic-security a owl:Class ;
    rdfs:label "Cryptographic Security"@en ;
    rdfs:comment "Cryptographic Security is the discipline of applying mathematical cryptographic primitives and protocols — including symmetric encryption, asymmetric public-key cryptography, cryptographic hash functions, digital signatures, message authentication codes, and zero-knowledge proofs — to enforce confidentiality, integrity, authenticity, and non-repudiation of information and communications. It provides the formal security guarantees upon which trustless distributed systems, secure channels, identity frameworks, and privacy-preserving computation are constructed. The field spans both theoretical hardness assumptions (discrete logarithm, integer factorisation, lattice problems) and practical protocol engineering, encompassing key management, certificate infrastructure, and post-quantum cryptographic migration. In applied contexts it underpins everything from TLS transport security and blockchain transaction authorisation to hardware security modules and secure multi-party computation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:encryption ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:digital-signature ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:hash-function ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:key-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:hardware-security-module ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:random-number-generation ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:message-authentication-code ],
        ngm:infra-security-and-identity ;
    skos:broader ngm:infra-security-and-identity ;
    vc:bridgesTo ngm:blockchain,
        ngm:decentralised-identity,
        ngm:federated-learning ;
    vc:contrastsWith ngm:post-quantum-cryptography ;
    vc:enables ngm:digital-identity,
        ngm:privacy-preserving-computation,
        ngm:secure-multi-party-computation,
        ngm:zero-knowledge-proof ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:digital-signature,
        ngm:encryption,
        ngm:hash-function,
        ngm:key-management,
        ngm:message-authentication-code,
        ngm:public-key-cryptography ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:access-control,
