        ngm:embodied-cognition,
        ngm:human-computer-interaction,
        ngm:presence ;
    vc:requires ngm:real-time-rendering,
        ngm:spatial-tracking,
        ngm:xr-hardware ;
    vc:slug "extended-reality" ;
    vc:sourceDomain "spatial-computing" ;
    vc:standardizedBy ngm:open-xr,
        ngm:w-3-c-web-xr-device-api ;
    vc:uses ngm:eye-tracking,
