ngm:transport-layer-security a owl:Class ;
    rdfs:label "Transport Layer Security"@en ;
    rdfs:comment "A cryptographic protocol standardised by the IETF that provides mutual authentication, confidentiality and data integrity for communications over a computer network, succeeding the deprecated Secure Sockets Layer and currently at version 1.3 (RFC 8446)."@en ;
