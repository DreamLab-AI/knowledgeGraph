        ngm:ai-technique,
        ngm:computational-intelligence,
        ngm:optimisation ;
    skos:broader ngm:ai-technique ;
    vc:enables ngm:autonomous-agent,
        ngm:few-shot-learning,
        ngm:model-training,
        ngm:policy-optimisation,
