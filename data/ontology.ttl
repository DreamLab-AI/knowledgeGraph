    vc:enables ngm:audit-trail,
        ngm:chain-of-custody,
        ngm:digital-product-passport,
        ngm:non-fungible-token,
        ngm:supply-chain-traceability ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:implements ngm:data-integrity,
        ngm:provenance-tracking ;
    vc:qualityScore "0.75"^^xsd:float ;
