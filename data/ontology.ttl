ngm:complexity-science a owl:Class ;
    rdfs:label "Complexity Science"@en ;
    rdfs:comment "Complexity science is the interdisciplinary study of complex adaptive systems composed of many interacting components whose collective behaviour cannot be reduced to that of the individual parts. It investigates emergence, self-organisation, networks, nonlinear dynamics, and adaptation across physical, biological, social, and economic systems. It matters because it provides a unifying lens and a set of computational and analytical tools for understanding phenomena such as markets, ecosystems, and epidemics that defy reductionist explanation."@en ;
    rdfs:subClassOf ngm:owl-thing ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:economics,
        ngm:emergence ;
    vc:slug "complexity-science" ;
    vc:sourceDomain "data" .

ngm:compliance-evidence a owl:Class ;
    rdfs:label "Compliance Evidence"@en ;
    rdfs:comment "Compliance evidence is the documented, verifiable record that an organisation or process meets a regulatory, contractual, or standards-based requirement. It includes artefacts such as audit logs, sensor readings, certificates, attestations, and chain-of-custody records, ideally tamper-evident and timestamped. It matters because it converts asserted compliance into auditable proof, supporting attestations to regulators and customers and enabling automated verification in areas such as cold-chain integrity and supply-chain assurance."@en ;
    rdfs:subClassOf ngm:regulatory-compliance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:cold-chain-monitoring,
        ngm:evidence-collection ;
    vc:slug "compliance-evidence" ;
    vc:sourceDomain "governance" .

ngm:computational-geometry a owl:Class ;
    rdfs:label "Computational Geometry"@en ;
    rdfs:comment "Computational geometry is the study of algorithms for solving geometric problems, such as finding convex hulls, intersections, and nearest points. It supports graphics, robotics, and geographic systems."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
