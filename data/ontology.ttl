ngm:quantum-cryptography a owl:Class ;
    rdfs:label "Quantum Cryptography"@en ;
    rdfs:comment "Quantum cryptography uses principles of quantum mechanics, such as the no-cloning theorem and measurement disturbance, to perform cryptographic tasks whose security rests on physical law rather than computational hardness. Its best-known application, quantum key distribution, lets two parties establish a shared secret with detectable eavesdropping. It is distinct from post-quantum cryptography, which is classical algorithms resistant to quantum attack."@en ;
    rdfs:subClassOf ngm:cryptography ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
