    vc:slug "account-model" ;
    vc:sourceDomain "blockchain" .

vf:adapter-modules a owl:Class ;
    rdfs:label "Adapter Modules"@en ;
    rdfs:comment "Small neural network modules inserted between transformer layers that are trained whilst keeping the original model frozen. Adapter modules provide a parameter-efficient way to adapt pre-trained models to new tasks by learning task-specific transformations without modifying the base model."@en ;
    rdfs:subClassOf vf:learning-module ;
    vc:authorityScore "0.0"^^xsd:float ;
    vc:maturity "draft" ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:slug "adapter-modules" ;
    vc:sourceDomain "spatial-computing" .

vf:adapter-slot a owl:Class ;
    rdfs:label "Adapter Slot"@en ;
    rdfs:comment "A pluggable interface architecture (ADR-005) providing five standardised slots through which a [[VisionClaw Agentic Container|VisionClaw agent]] interacts with its environment: [[Solid Pod Storage|Pod (persistent storage)]], [[Agent Memory|Memory (episodic and semantic)]], [[Agent Event Stream|Events (telemetry)]], [[Agent Bead|Beads (work units)]], and [[Orchestration Interface|Orchestrator (control)]], each replaceable at runtime without modifying agent code."@en ;
    rdfs:subClassOf vf:infrastructure ;
    vc:authorityScore "0.91"^^xsd:float ;
    vc:enables <urn:visionflow:linked:deployment-flexibility>,
        <urn:visionflow:linked:pluggable-memory>,
        <urn:visionflow:linked:pluggable-storage>,
        <urn:visionflow:linked:pluggable-telemetry>,
        <urn:visionflow:linked:pluggable-work-distribution> ;
    vc:hasPart <urn:visionflow:linked:bead-adapter>,
        <urn:visionflow:linked:event-adapter>,
        <urn:visionflow:linked:memory-adapter>,
        <urn:visionflow:linked:orchestrator-adapter>,
        <urn:visionflow:linked:pod-adapter> ;
    vc:implements <urn:visionflow:linked:adapter-pattern>,
        <urn:visionflow:linked:dependency-injection>,
        <urn:visionflow:linked:strategy-pattern> ;
    vc:maturity "established" ;
    vc:qualityScore "0.89"^^xsd:float ;
    vc:requires <urn:visionflow:linked:interface-specification>,
        <urn:visionflow:linked:manifest-declaration>,
        <urn:visionflow:linked:runtime-initialization> ;
    vc:slug "adapter-slot" ;
    vc:sourceDomain "infrastructure" .

vf:adaptive-virtual-experience a owl:Class ;
    rdfs:label "Adaptive Virtual Experience"@en ;
    rdfs:comment "Adaptive Virtual Experience refers to AI-driven immersive environments that dynamically adjust content, difficulty, pacing, and presentation in real-time based on user behavior, preferences, physiological responses, and interaction patterns to deliver personalized and engaging virtual reality experiences."@en ;
    rdfs:subClassOf <urn:visionflow:linked:virtual-reality-experience> ;
    vc:authorityScore "0.0"^^xsd:float ;
    vc:enables <urn:visionflow:linked:dynamic-gaming>,
