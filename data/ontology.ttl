ngm:tele-107-ai-meeting-assistants a owl:Class ;
    rdfs:label "TELE-107-ai-meeting-assistants"@en ;
    rdfs:comment "AI meeting assistants are software agents that join or process meetings to provide transcription, summarisation, action-item extraction and live support using speech recognition and language models."@en ;
