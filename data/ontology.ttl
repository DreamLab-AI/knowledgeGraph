    vc:uses ngm:sha-256 ;
    vc:uses ngm:verifiable-credentials .
ngm:sd-jwt-vc a owl:Class ;
    rdfs:comment "A verifiable credential format that uses Selective Disclosure JSON Web Tokens, allowing a holder to reveal only chosen claims to a verifier. It combines the JWT structure with salted hashes that support selective disclosure."@en ;
    rdfs:label "SD-JWT VC"@en ;
    rdfs:subClassOf ngm:json-data-interchange-format-web-token ;
