        ngm:infra-security-and-identity ;
    skos:broader ngm:infra-security-and-identity ;
    vc:enables ngm:cross-platform-identity,
        ngm:digital-identity-management,
        ngm:privacy-protection,
        ngm:secure-authentication ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:authentication-standards,
        ngm:identity-policies,
        ngm:privacy-controls,
        ngm:trust-mechanisms ;
    vc:isPartOf ngm:governance-framework,
        ngm:trust-architecture ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:cryptographic-system,
        ngm:policy-frameworks,
        ngm:standardization-bodies ;
    vc:slug "digital-identity-framework" ;
    vc:sourceDomain "infrastructure" .

ngm:digital-services-act a owl:Class ;
    rdfs:label "Digital Services Act"@en ;
    rdfs:comment "A comprehensive EU regulation establishing legal framework for digital services accountability, content moderation requirements, platform transparency obligations, and user protection measures across online intermediaries, marketplaces, and social platforms, with implications for metaverse and vi..."@en ;
    rdfs:subClassOf ngm:ai-governance-and-ethics,
        ngm:digital-regulation ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:enables ngm:content-transparency,
        ngm:platform-accountability,
        ngm:user-protection ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires ngm:compliance-systems,
        ngm:moderation-infrastructure,
        ngm:reporting-mechanisms ;
    vc:slug "digital-services-act" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:digital-twin-interop-protocol a owl:Class ;
    rdfs:label "Digital Twin Interop Protocol"@en ;
    rdfs:comment "Digital Twin Interop Protocol is a spatial computing concept."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-serialization ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:state-synchronization ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
