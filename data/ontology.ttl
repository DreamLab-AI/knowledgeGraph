ngm:torque a owl:Class ;
    rdfs:label "Torque"@en ;
    rdfs:comment "Torque is the rotational analogue of force, defined as the cross product of the moment arm and the applied force vector (τ = r × F), measured in newton-metres. In robotics it governs joint actuation, grip force, and dynamic loading across mechanical transmissions, and is the primary physical quantity managed by torque-controlled servos and force-torque sensors during manipulation tasks."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:force-torque-sensor ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:actuator ],
        ngm:robo-actuation-and-control,
        ngm:robot-dynamics ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:enables ngm:force-control,
        ngm:haptic-feedback,
        ngm:motion-control ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:robot-joint,
        ngm:robot-kinematics ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:requires ngm:actuator,
        ngm:force-torque-sensor ;
    vc:slug "torque" ;
    vc:sourceDomain "robotics" .

ngm:turtle a owl:Class ;
    rdfs:label "Turtle"@en ;
    rdfs:comment "Turtle (Terse RDF Triple Language) is a W3C-standardised serialisation syntax for expressing RDF graphs in a compact, human-readable plain-text form. It extends Notation3 (N3) by providing a concise prefix-based shorthand for IRIs, support for blank nodes, and literal datatypes, enabling structured linked-data documents to be authored and exchanged without the verbosity of RDF/XML."@en ;
    rdfs:subClassOf ngm:data-serialization ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:json-data-interchange-format-ld,
        ngm:n-triples,
        ngm:rdf,
        ngm:sparql ;
    vc:slug "turtle" ;
    vc:sourceDomain "ai" ;
    vc:supports ngm:knowledge-graph,
        ngm:linked-data ;
    vc:uses ngm:owl .

ngm:u-net a owl:Class ;
    rdfs:label "U-Net"@en ;
    rdfs:comment "A convolutional neural network architecture with a symmetric encoder-decoder structure and skip connections, originally designed for biomedical image segmentation and widely adopted for dense prediction tasks including diffusion model denoising."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:decoder ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:encoder ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:convolution ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:batch-normalisation ],
        ngm:convolutional-neural-network ;
    vc:bridgesTo ngm:generative-adversarial-network,
        ngm:robotics-perception ;
    vc:contrastsWith ngm:feature-pyramid-network,
        ngm:fully-convolutional-network,
        ngm:vision-transformer ;
    vc:enables ngm:dense-prediction,
        ngm:image-segmentation,
        ngm:instance-segmentation,
        ngm:semantic-segmentation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:bottleneck-layer,
        ngm:decoder,
        ngm:encoder,
        ngm:skip-connection ;
    vc:implements ngm:encoder-decoder-architecture,
        ngm:feature-pyramid ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:transfer-learning ;
    vc:requires ngm:batch-normalisation,
        ngm:convolution,
        ngm:max-pooling,
        ngm:upsampling ;
    vc:slug "u-net" ;
    vc:sourceDomain "machine-learning" ;
    vc:supports ngm:data-augmentation,
        ngm:diffusion-model,
        ngm:medical-image-analysis ;
    vc:uses ngm:cross-entropy-loss,
        ngm:dropout-regularisation,
        ngm:rectified-linear-unit .

ngm:value-function a owl:Class ;
    rdfs:label "Value Function"@en ;
    rdfs:comment "A value function in reinforcement learning estimates the expected cumulative future reward obtainable from a given state (state-value) or state-action pair (action-value) under a particular policy. It captures the long-term desirability of situations rather than immediate reward, and satisfies the recursive Bellman equation that relates the value of a state to the values of its successors. Value functions are central to dynamic programming, temporal-difference learning, and actor-critic methods, providing the signal that guides an agent toward reward-maximising behaviour."@en ;
    rdfs:subClassOf ngm:reinforcement-learning ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:machine-learning-discipline ;
    vc:slug "value-function" ;
    vc:sourceDomain "ai" ;
    vc:supports ngm:optimal-control ;
    vc:uses ngm:markov-decision-process .

ngm:vector-embedding a owl:Class ;
    rdfs:label "Vector Embedding"@en ;
    rdfs:comment "A vector embedding is a dense, fixed-length numerical representation of a discrete object — a word, sentence, image, or user — in a continuous high-dimensional space, learned such that semantically similar objects map to nearby points. Embeddings convert unstructured data into a form amenable to mathematical operations like distance and dot product, enabling similarity search, clustering, recommendation, and retrieval. They are produced by neural encoders and are the representational substrate beneath modern search, retrieval-augmented generation, and multimodal AI."@en ;
    rdfs:subClassOf ngm:embedding ;
    vc:enables ngm:semantic-search,
        ngm:vector-database ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:natural-language-processing ;
    vc:slug "vector-embedding" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:embedding-model .

ngm:verifiable-computation a owl:Class ;
    rdfs:label "Verifiable Computation"@en ;
    rdfs:comment "Techniques that let a party outsource a computation and receive a proof that the result is correct, allowing efficient verification without redoing the work. Proof systems such as SNARKs and STARKs make verification exponentially cheaper than re-execution, enabling trust-minimised delegation at scale."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptographic-proof ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:stark ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:zero-knowledge-proof ],
        ngm:cryptographic-proof ;
    vc:bridgesTo ngm:blockchain,
        ngm:cloud-computing,
        ngm:machine-learning-inference ;
    vc:contrastsWith ngm:multi-party-computation,
        ngm:trusted-execution-environments ;
    vc:enables ngm:layer-2-scaling,
        ngm:privacy-preserving-computation,
        ngm:scalability,
        ngm:trustless-outsourcing ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:proof-of-computation,
        ngm:snark,
        ngm:stark ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:interactive-proof-system,
        ngm:probabilistically-checkable-proof,
        ngm:succinct-argument ;
    vc:requires ngm:arithmetic-circuit,
        ngm:cryptographic-proof,
        ngm:polynomial-commitment-scheme,
        ngm:zero-knowledge-proof ;
    vc:slug "verifiable-computation" ;
    vc:sourceDomain "security" ;
    vc:supports ngm:confidential-computing,
        ngm:decentralised-finance,
        ngm:smart-contract ;
    vc:uses ngm:elliptic-curve-cryptography,
        ngm:hash-function,
        ngm:interactive-proof-system .

ngm:virtual-production-workflow a owl:Class ;
    rdfs:label "Virtual Production Workflow"@en ;
    rdfs:comment "The end-to-end process for creating film and television content using virtual production techniques, integrating pre-visualisation, virtual art department asset creation, real-time game engine rendering, LED volume shooting, and post-production refinement in a non-linear pipeline where VFX work begins in pre-production rather than post-production. This approach captures composited digital environments in-camera, enabling creative decisions about lighting and framing to be made on set."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:game-engine ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:3-d-rendering-engine ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:3-d-asset ],
