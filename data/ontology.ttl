ngm:ai-upscaling-and-super-resolution a owl:Class ;
    rdfs:label "AI Upscaling and Super-Resolution"@en ;
    rdfs:comment "AI Upscaling and Super-Resolution is a family of deep learning techniques that synthesise plausible high-frequency detail when enlarging images or video frames beyond their native resolution. Methods range from convolutional neural network regressors (SRCNN, ESRGAN) and generative adversarial approaches to diffusion-based reconstruction, enabling applications from consumer photography enhancement to real-time game upscaling (DLSS, FSR) and medical imaging."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:super-resolution ],
        ngm:ai-application,
        ngm:generative-ai ;
    skos:broader ngm:ai-application ;
    vc:enables ngm:image-processing-software,
        ngm:real-time-rendering ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:super-resolution ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:computer-vision,
        ngm:latent-diffusion,
        ngm:neural-rendering,
        ngm:sc-display-and-rendering ;
    vc:slug "ai-upscaling-and-super-resolution" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:convolutional-neural-network,
        ngm:deep-learning,
        ngm:diffusion-model,
        ngm:generative-adversarial-network .

ngm:air-gap a owl:Class ;
    rdfs:label "Air Gap"@en ;
    rdfs:comment "An air gap is a security measure that physically isolates a computer or storage device from unsecured networks, including the public internet and any networked device. In the context of cryptocurrency custody, an air-gapped device holds private keys and signs transactions while never establishing a live network connection, transferring data only through media such as QR codes or removable storage. This isolation dramatically reduces the remote attack surface available to adversaries."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:hardware-security-module ],
        ngm:cold-storage ;
    vc:bridgesTo ngm:secure-enclave ;
    vc:contrastsWith ngm:hardware-wallet,
        ngm:network-security ;
