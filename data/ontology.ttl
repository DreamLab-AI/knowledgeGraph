ngm:animation a owl:Class ;
    rdfs:label "Animation"@en ;
    rdfs:comment "Animation is the technique of creating the illusion of movement by rapidly displaying a sequence of static images or by computationally interpolating between keyframe states of a scene or character over time. In digital contexts, animation encompasses skeletal rigging, keyframe interpolation, physics simulation, and procedural generation to produce lifelike motion in real-time or pre-rendered environments. Modern animation pipelines integrate motion capture data, inverse kinematics, and blend trees to deliver nuanced character performances. Animation is foundational to game engines, virtual reality, film, and interactive simulations."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:procedural-animation ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:motion-capture ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:rendering-pipeline ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:inverse-kinematics ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:skeletal-animation ],
        ngm:animation-technique ;
    vc:bridgesTo ngm:generative-ai,
        ngm:neural-motion-synthesis ;
    vc:contrastsWith ngm:static-mesh ;
    vc:dependsOn ngm:game-engine,
        ngm:physics-simulation ;
    vc:enables ngm:character-controller,
        ngm:cinematic-rendering,
        ngm:user-presence ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:blend-tree,
        ngm:inverse-kinematics,
        ngm:keyframe,
        ngm:motion-capture,
        ngm:procedural-animation,
        ngm:skeletal-animation ;
    vc:isPartOf ngm:computer-graphics,
        ngm:interactive-media ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:real-time-rendering,
        ngm:simulation ;
    vc:requires ngm:rendering-pipeline,
        ngm:rigging ;
    vc:slug "animation" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:augmented-reality,
        ngm:digital-twin,
        ngm:virtual-reality ;
    vc:uses ngm:animation-controller,
        ngm:bezier-spline,
        ngm:rendering-engine .

ngm:annotated-training-data a owl:Class ;
    rdfs:label "Annotated Training Data"@en ;
    rdfs:comment "Annotated Training Data is a dataset whose examples have been augmented with ground-truth labels, bounding boxes, segmentation masks, or other targets that supervised models learn to predict. The annotations are produced by humans, programmatic rules, or model-assisted labeling and define the task the model is trained to solve. Its quality, coverage, and label consistency are primary determinants of supervised-model performance."@en ;
    rdfs:subClassOf ngm:machine-learning-discipline ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:cross-validation,
        ngm:segmentation-and-identification ;
    vc:slug "annotated-training-data" ;
    vc:sourceDomain "data" .

