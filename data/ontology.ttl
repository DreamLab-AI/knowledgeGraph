ngm:single-turn-inference a owl:Class ;
    rdfs:comment "The stateless request-response mode of using a language model: a prompt goes in, one completion comes out, and the interaction ends — with no intermediate tool execution, environmental feedback, self-correction, or persistent state; it is the cheapest and most predictable inference pattern, suited to classification, extraction, translation, and summarisation, and serves as the baseline against which iterative agentic workflows are defined and evaluated."@en ;
    rdfs:label "Single-Turn Inference"@en ;
    rdfs:subClassOf ngm:inference ;
