    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:supply-chain ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:deployer,
        ngm:importer,
        ngm:market-surveillance-authority,
        ngm:provider ;
    vc:requires ngm:conformity-assessment,
        ngm:regulatory-compliance ;
    vc:slug "distributor" ;
    vc:sourceDomain "spatial-computing" .

