ngm:quality-control a owl:Class ;
    rdfs:label "Quality Control"@en ;
    rdfs:comment "Quality control is the operational process of inspecting, testing, and verifying products or outputs against defined specifications to detect and remove defects before delivery. In manufacturing it spans dimensional inspection, surface-defect detection, and statistical process control, increasingly automated through machine vision. It reduces scrap, ensures conformance, and provides feedback for process improvement."@en ;
    rdfs:subClassOf ngm:computer-vision ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:computer-vision,
        ngm:robo-actuation-and-control ;
    vc:slug "quality-control" ;
    vc:sourceDomain "ai" .

ngm:rate-limiting a owl:Class ;
    rdfs:label "Rate Limiting"@en ;
    rdfs:comment "Rate limiting is a traffic-management technique that controls the number of requests a client may make to a service within a defined time window, rejecting or queuing excess requests. It protects backend resources from overload, enforces fair usage and quota policies, and mitigates abuse such as brute-force and denial-of-service attacks. Commonly implemented at API gateways using token-bucket or sliding-window algorithms, it is a core mechanism for the resilience and stability of networked systems."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:caching ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:api-gateway ],
        ngm:infrastructure ;
    skos:broader ngm:infrastructure ;
    vc:bridgesTo ngm:service-mesh ;
    vc:contrastsWith ngm:load-balancing ;
    vc:dependsOn ngm:api-management ;
    vc:enables ngm:fault-tolerance,
        ngm:resilience,
        ngm:scalability ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:caching ;
    vc:implements ngm:api-gateway,
        ngm:api-management ;
    vc:isPartOf ngm:infrastructure ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:authentication,
        ngm:load-balancing,
        ngm:microservices ;
    vc:requires ngm:api-gateway ;
    vc:slug "rate-limiting" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:security ;
    vc:uses ngm:api,
        ngm:caching .

ngm:reference-architecture a owl:Class ;
    rdfs:label "Reference Architecture"@en ;
    rdfs:comment "A standardized architectural template that provides proven structural frameworks and design patterns for building scalable, resilient enterprise applications, establishing shared vocabulary and best practices across development teams."@en ;
