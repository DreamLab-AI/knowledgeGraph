ngm:fast-spatial-queries a owl:Class ;
    rdfs:label "Fast Spatial Queries"@en ;
    rdfs:comment "Optimised algorithms and data structures enabling rapid retrieval and processing of three-dimensional location-based data in metaverse environments, supporting real-time collision detection, proximity searches, visibility calculations, and spatial indexing for interactive virtual world experiences."@en ;
    rdfs:subClassOf ngm:sc-display-and-rendering ;
    skos:broader ngm:sc-display-and-rendering ;
    vc:enables ngm:real-time-metaverse-interactions ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:slug "fast-spatial-queries" ;
    vc:sourceDomain "spatial-computing" .

ngm:fatf-40-recommendations a owl:Class ;
    rdfs:label "FATF 40 Recommendations"@en ;
    rdfs:comment "The FATF 40 Recommendations are the international standards on combating money laundering, terrorist financing, and proliferation financing issued by the Financial Action Task Force. They define a comprehensive framework covering customer due diligence, beneficial-ownership transparency, suspicious-transaction reporting, supervision, and international cooperation. National regimes implement them to achieve compliance assessed through FATF mutual evaluations."@en ;
    rdfs:subClassOf ngm:financial-regulation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:aml-kyc-compliance,
        ngm:regulatory-compliance ;
    vc:slug "fatf-40-recommendations" ;
    vc:sourceDomain "blockchain" .

ngm:fatf-guidance-on-virtual-assets a owl:Class ;
    rdfs:label "FATF Guidance on Virtual Assets"@en ;
    rdfs:comment "The FATF Guidance on Virtual Assets is the Financial Action Task Force's risk-based interpretation of how its anti-money-laundering standards apply to virtual assets and virtual-asset service providers (VASPs). It defines key terms, requires VASP licensing or registration and supervision, and introduces the 'travel rule' obliging the transfer of originator and beneficiary information with transactions. The guidance shapes how exchanges, custodians, and DeFi arrangements are regulated worldwide."@en ;
    rdfs:subClassOf ngm:financial-regulation ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:cbdcs,
        ngm:decentralized-finance-de-fi ;
    vc:slug "fatf-guidance-on-virtual-assets" ;
    vc:sourceDomain "blockchain" .

ngm:fault-tolerance-system a owl:Class ;
    rdfs:label "Fault Tolerance System"@en ;
    rdfs:comment "A Fault Tolerance System is an engineering design framework enabling a distributed system to continue correct operation despite component failures, network disruptions, or malicious behaviour by a subset of participants. These systems employ redundancy, error detection, and automatic recovery to mask failures from end users, with Byzantine fault tolerance being the gold standard for adversarial environments such as public blockchains, which require at least 3f+1 total nodes to tolerate f Byzantine failures."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:distributed-system ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:consensus-mechanism ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:distributed-systems ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:byzantine-fault-tolerance ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:data-replication ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:replication-system ],
        ngm:bc-network-component,
        ngm:blockchain-entity ;
    skos:broader ngm:bc-network-component ;
    vc:contrastsWith ngm:distributed-ledger-technology ;
    vc:enables ngm:blockchain,
        ngm:high-availability,
        ngm:operational-resilience ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:byzantine-fault-tolerance,
        ngm:data-replication,
        ngm:replication-system ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:byzantine-fault-tolerant-system,
        ngm:distributed-architecture,
        ngm:fault-tolerance ;
    vc:requires ngm:consensus-mechanism,
        ngm:distributed-system,
        ngm:distributed-systems ;
    vc:slug "fault-tolerance-system" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:federated-byzantine-fault-tolerance,
        ngm:practical-byzantine-fault-tolerance .

ngm:fca-consumer-duty a owl:Class ;
    rdfs:label "FCA Consumer Duty"@en ;
    rdfs:comment "The FCA Consumer Duty is a regulatory standard set by the UK Financial Conduct Authority requiring financial firms to deliver good outcomes for retail customers. It mandates that firms act in good faith, avoid foreseeable harm, support customers in pursuing their financial objectives, and demonstrate fair value, clear communications, and adequate support. The Duty raises the bar above prior 'treating customers fairly' expectations and applies across products, pricing, and service channels."@en ;
    rdfs:subClassOf ngm:financial-regulation ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:call-centres,
        ngm:securities-regulation ;
    vc:slug "fca-consumer-duty" ;
    vc:sourceDomain "governance" .

ngm:federated-byzantine-fault-tolerance a owl:Class ;
    rdfs:label "Federated Byzantine Fault Tolerance"@en ;
    rdfs:comment "Federated Byzantine Fault Tolerance (FBFT) is a consensus mechanism in which each node independently selects a trusted subset of peers—its quorum slice—forming overlapping quorums that propagate agreement without requiring global participation or expensive proof-of-work computation. Unlike classic BFT protocols that demand a fixed, known validator set, FBFT allows open membership: any node may join by declaring its quorum slices, and safety is guaranteed as long as quorum intersections contain at least one correct node. FBFT underpins the Stellar Consensus Protocol (SCP), enabling low-latency, high-throughput cross-border payment settlement with safety and liveness properties derived from quorum-intersection analysis."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:distributed-ledger ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gossip-protocol ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:node ],
        ngm:bc-protocol-and-consensus,
        ngm:byzantine-fault-tolerance ;
    skos:broader ngm:bc-protocol-and-consensus ;
    vc:contrastsWith ngm:proof-of-stake,
        ngm:proof-of-work ;
    vc:enables ngm:finality,
        ngm:interoperability,
        ngm:transaction ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:block,
        ngm:blockchain,
        ngm:distributed-system,
        ngm:security ;
    vc:requires ngm:distributed-ledger,
        ngm:gossip-protocol,
        ngm:node ;
    vc:slug "federated-byzantine-fault-tolerance" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:consensus-mechanism,
        ngm:network-protocol .

ngm:federated-identity-system a owl:Class ;
    rdfs:label "Federated Identity System"@en ;
    rdfs:comment "A federated identity system enables a user's digital identity and authentication to be recognised across multiple independent organisations or domains without each maintaining separate credentials. It relies on trust relationships between identity providers and relying parties, exchanging assertions via protocols such as SAML, OpenID Connect, and OAuth. Federation underpins single sign-on, cross-organisation access, and trust-framework governance."@en ;
    rdfs:subClassOf ngm:identity-management ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:federated-credential-exchange,
        ngm:trust-framework-policy ;
    vc:slug "federated-identity-system" ;
    vc:sourceDomain "security" .

ngm:federated-system a owl:Class ;
    rdfs:label "Federated System"@en ;
    rdfs:comment "A federated system is a distributed architecture composed of autonomous, independently operated nodes or servers that cooperate under shared protocols while retaining local control over their own data and policies. Unlike fully centralised systems, federation distributes authority across multiple operators, and unlike fully decentralised peer-to-peer networks, it relies on a finite set of identifiable, semi-trusted servers. This model underpins federated social networks, messaging, and consortium-style trust arrangements."@en ;
    rdfs:subClassOf ngm:distributed-systems ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:consortium-blockchain,
        ngm:fedimint ;
    vc:slug "federated-system" ;
    vc:sourceDomain "infrastructure" .

ngm:fiat-currency a owl:Class ;
    rdfs:label "Fiat Currency"@en ;
    rdfs:comment "Money issued by a state and declared legal tender, whose value derives from government authority and public confidence rather than from a physical commodity."@en ;
    rdfs:subClassOf ngm:money ;
    vc:enables ngm:stablecoin ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:slug "fiat-currency" ;
    vc:sourceDomain "blockchain" .

ngm:fid-benchmark-protocol a owl:Class ;
    rdfs:label "FID Benchmark Protocol"@en ;
    rdfs:comment "The FID benchmark protocol is the standardised methodology for evaluating generative image models using the Fréchet Inception Distance, which compares the distribution of generated images with that of real images in the feature space of a pretrained Inception network. The protocol fixes the feature extractor, the number of samples, and preprocessing so that scores are comparable across models; lower FID indicates greater similarity to real data. It is the de facto standard for benchmarking GANs and diffusion models."@en ;
    rdfs:subClassOf ngm:evaluation-metric ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:diffusion-models,
        ngm:generative-adversarial-networks ;
    vc:slug "fid-benchmark-protocol" ;
    vc:sourceDomain "ai" .

ngm:fido-alliance a owl:Class ;
    rdfs:label "FIDO Alliance"@en ;
    rdfs:comment "An industry association that develops open authentication standards intended to reduce reliance on passwords through public key cryptography."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:asymmetric-cryptography ],
        ngm:standards-body ;
    vc:enables ngm:multi-factor-authentication,
        ngm:passwordless-authentication ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:asymmetric-cryptography ;
    vc:slug "fido-alliance" ;
    vc:sourceDomain "cryptographic" .

ngm:financial-conduct-authority a owl:Class ;
    rdfs:label "Financial Conduct Authority"@en ;
    rdfs:comment "The conduct regulator for financial services firms and markets in the United Kingdom, responsible for protecting consumers, maintaining market integrity and promoting competition."@en ;
    rdfs:subClassOf ngm:financial-regulation ;
    vc:enables ngm:securities-regulation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:slug "financial-conduct-authority" ;
    vc:sourceDomain "governance" .

ngm:financial-trading a owl:Class ;
    rdfs:label "Financial Trading"@en ;
    rdfs:comment "The exchange of financial instruments—including equities, derivatives, cryptocurrencies, and digital assets—within regulated or decentralised markets. In the metaverse and spatial computing context, financial trading encompasses algorithmic and AI-driven trading of virtual assets, NFTs, and tokenised real-world assets through smart-contract-enabled marketplaces and decentralised exchanges."@en ;
    rdfs:subClassOf ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:dependsOn ngm:transaction-standard ;
    vc:enables ngm:marketplace ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:cryptocurrency,
        ngm:digital-asset,
        ngm:virtual-economy ;
    vc:slug "financial-trading" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:decentralized-exchange-dex,
        ngm:smart-contract .

ngm:fips-186-5 a owl:Class ;
    rdfs:label "FIPS 186-5"@en ;
    rdfs:comment "Revision 5 of the NIST Digital Signature Standard, specifying approved digital signature algorithms including ECDSA and EdDSA. It defines requirements for generating and verifying digital signatures."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:nist ],
        ngm:technical-standard ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:nist ;
    vc:slug "fips-186-5" ;
    vc:sourceDomain "standards" .

ngm:fixed-supply-monetary-policy a owl:Class ;
    rdfs:label "Fixed Supply Monetary Policy"@en ;
    rdfs:comment "A fixed supply monetary policy is a rule embedded in a cryptocurrency protocol that caps the total quantity of units that will ever exist, removing discretionary issuance. By making the maximum supply algorithmically predetermined and credibly enforced by consensus, it produces verifiable scarcity and predictable issuance schedules. Bitcoin's 21-million-coin cap is the canonical example, underpinning narratives of digital scarcity and store of value."@en ;
    rdfs:subClassOf ngm:economic-mechanism ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:bitcoin-as-money,
        ngm:store-of-value ;
    vc:slug "fixed-supply-monetary-policy" ;
    vc:sourceDomain "blockchain" .

ngm:fluid-power-device a owl:Class ;
    rdfs:label "Fluid Power Device"@en ;
    rdfs:comment "A fluid power device is a component that transmits or controls power through a pressurised fluid, either an incompressible liquid (hydraulic) or a compressible gas (pneumatic). Such devices convert fluid pressure and flow into mechanical motion and force, or regulate that flow, and include actuators, valves, pumps, and compressors. They are valued in robotics and industrial automation for high force-to-weight ratios and robust operation."@en ;
    rdfs:subClassOf ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:pneumatic-actuator,
        ngm:proportional-valve ;
    vc:slug "fluid-power-device" ;
    vc:sourceDomain "robotics" .

ngm:fmea a owl:Class ;
    rdfs:label "FMEA"@en ;
    rdfs:comment "Failure Mode and Effects Analysis (FMEA) is a structured, proactive engineering methodology for identifying potential failure modes in a product, process, or system, assessing their causes and effects, and prioritising them for mitigation. Each failure mode is rated by severity, occurrence, and detectability, often combined into a Risk Priority Number that ranks risks for corrective action. FMEA is widely used in reliability engineering, safety-critical design, and quality management."@en ;
    rdfs:subClassOf ngm:robo-safety-and-standards ;
    skos:broader ngm:robo-safety-and-standards ;
    vc:hasMaturity ngmi:maturity-established ;
