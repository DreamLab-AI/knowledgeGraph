    vc:slug "etsi-domain-human-interface-governance" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:etsi-domain-infrastructure-governance a owl:Class ;
    rdfs:label "ETSI_Domain_Infrastructure___Governance"@en ;
    rdfs:comment "ETSI governance framework and mechanisms overseeing infrastructure domains through trust domain separation, policy enforcement, and security management implementing local policy control across distributed network components."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:artificial-intelligence ],
        ngm:ai-governance-and-ethics ;
