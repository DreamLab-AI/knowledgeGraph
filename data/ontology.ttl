        ngm:issue-tracking .

ngm:public-key a owl:Class ;
    rdfs:label "Public Key"@en ;
    rdfs:comment "The publicly shareable component of an asymmetric key pair, derived from the private key via elliptic curve or RSA mathematics, used to derive wallet addresses, verify digital signatures, and enable encrypted communication without transmitting secret material."@en ;
