ngm:property-system a owl:Class ;
    rdfs:label "Property System"@en ;
    rdfs:comment "A Property System is a software architecture pattern for attaching typed key-value attributes to entities within a metaverse or game engine context, enabling data binding, runtime configuration, and dynamic object behaviour without hard-coded class inheritance. It underpins avatar customisation, world-object state management, and reactive UI data flows in spatial computing platforms."@en ;
    rdfs:subClassOf ngm:infra-software-engineering ;
    skos:broader ngm:infra-software-engineering ;
    vc:enables ngm:avatar-customization,
        ngm:avatar-system ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:spatial-computing ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:relatedTo ngm:asset-management,
        ngm:digital-asset ;
    vc:slug "property-system" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:game-engine .

ngm:proportional-control a owl:Class ;
    rdfs:label "Proportional Control"@en ;
    rdfs:comment "Proportional Control is a feedback control strategy in which the corrective output applied to an actuator is directly proportional to the current error—the difference between the desired setpoint and the measured process variable. It is the foundational component of PID controllers, providing immediate, scaled response to deviations but typically leaving a steady-state offset that requires integral or derivative terms to eliminate."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:control-algorithm ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:feedback-control ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:actuator ],
        ngm:feedback-control,
        ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:contrastsWith ngm:adaptive-control,
        ngm:derivative-control ;
    vc:enables ngm:motion-control,
        ngm:position-control,
        ngm:velocity-control ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:control-algorithm ;
    vc:isPartOf ngm:closed-loop-control,
        ngm:pid-controller ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:control-system,
        ngm:control-theory ;
    vc:requires ngm:actuator,
        ngm:feedback-control ;
    vc:slug "proportional-control" ;
    vc:sourceDomain "robotics" .

