ngm:heuristic-function a owl:Class ;
    rdfs:label "Heuristic Function"@en ;
    rdfs:comment "A heuristic function is an estimating function used in search and optimisation that approximates the cost or distance from a given state to a goal state. It guides informed search algorithms by prioritising the exploration of states that appear most promising, trading guaranteed optimality for improved efficiency. A heuristic is admissible when it never overestimates the true cost, and consistent when it satisfies the triangle inequality, properties that determine the optimality guarantees of algorithms that use it."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:artificial-intelligence ],
        ngm:search-algorithm ;
    vc:contrastsWith ngm:constraint-satisfaction ;
    vc:dependsOn ngm:optimisation,
        ngm:state-space ;
    vc:enables ngm:decision-making,
        ngm:pathfinding ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:informed-search,
        ngm:search-algorithm ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:graph-theory ;
    vc:requires ngm:artificial-intelligence ;
    vc:slug "heuristic-function" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:planning,
        ngm:task-planning ;
    vc:uses ngm:algorithm,
        ngm:cost-function .

ngm:heuristic-search a owl:Class ;
    rdfs:label "Heuristic Search"@en ;
    rdfs:comment "Heuristic search is a family of search algorithms that use a problem-specific evaluation function to estimate the cost or promise of candidate states, focusing exploration on the most promising regions of a search space. By trading exhaustive coverage for informed guidance, heuristic methods such as A* and best-first search solve large combinatorial problems that are intractable for uninformed search. The quality of the heuristic determines both efficiency and, in admissible cases, optimality."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:a-star-algorithm ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:informed-search ],
        ngm:search-algorithm ;
    vc:bridgesTo ngm:classical-planning,
        ngm:motion-planning ;
    vc:contrastsWith ngm:dijkstra-algorithm,
        ngm:graph-search ;
    vc:enables ngm:optimisation,
        ngm:pathfinding ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:a-star-algorithm,
        ngm:informed-search ;
    vc:isPartOf ngm:search-algorithm ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:artificial-intelligence,
        ngm:constraint-satisfaction,
        ngm:reinforcement-learning ;
    vc:slug "heuristic-search" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:game-playing,
        ngm:robotics ;
    vc:uses ngm:state-space-search .

ngm:hipaa a owl:Class ;
    rdfs:label "HIPAA"@en ;
    rdfs:comment "The Health Insurance Portability and Accountability Act, a United States federal law enacted in 1996 that establishes national standards for protecting the privacy and security of certain health information (protected health information) held by covered entities and their business associates."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:information-security ],
