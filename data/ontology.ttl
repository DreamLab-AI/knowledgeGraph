ngm:endorsement-policy a owl:Class ;
    rdfs:comment "An Endorsement Policy is a rule, used in permissioned blockchains such as Hyperledger Fabric, that specifies which organisations' peers must execute and cryptographically sign a transaction proposal before it is considered valid. It encodes the trust and approval requirements for a smart contract, for example requiring signatures from a majority or a named set of consortium members. Endorsement policies are central to multi-party governance of enterprise distributed ledgers."@en ;
    rdfs:label "Endorsement Policy"@en ;
    rdfs:subClassOf ngm:bc-protocol-and-consensus ;
    skos:broader ngm:bc-protocol-and-consensus ;
