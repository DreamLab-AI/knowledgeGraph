ngm:knowledge-graph-construction a owl:Class ;
    rdfs:label "Knowledge Graph Construction"@en ;
    rdfs:comment "Knowledge Graph Construction is the process of automatically or semi-automatically building structured graph representations of world knowledge by extracting entities, relations, and attributes from heterogeneous sources such as text corpora, databases, and web data. The discipline combines techniques from natural language processing, information retrieval, and ontology engineering to produce machine-readable graphs that support reasoning, question answering, and semantic search."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:information-retrieval ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:ontology ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:named-entity-recognition ],
        ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:enables ngm:knowledge-graph,
        ngm:knowledge-representation,
        ngm:linked-data ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:information-retrieval,
        ngm:named-entity-recognition,
        ngm:ontology ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:slug "knowledge-graph-construction" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:embedding-model,
        ngm:graph-database,
        ngm:large-language-models,
        ngm:natural-language-processing,
        ngm:sparql .

ngm:model-compression-for-edge a owl:Class ;
    rdfs:label "Model Compression for Edge"@en ;
    rdfs:comment "Model Compression for Edge is the systematic application of techniques reducing neural network computational requirements, memory footprint, and inference latency to enable deployment on resource-constrained edge devices while maintaining acceptable accuracy levels through quantization, pruning, knowledge distillation, and architectural optimization."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:model-pruning-for-edge-deployment ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:tiny-ml ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:knowledge-distillation-for-edge ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:knowledge-distillation ],
        ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:enables ngm:edge-ai-system,
        ngm:embedded-ai-frameworks,
        ngm:federated-edge-learning ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:knowledge-distillation,
        ngm:knowledge-distillation-for-edge,
        ngm:model-pruning-for-edge-deployment,
        ngm:tiny-ml ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:edge-ai-accelerator,
        ngm:embedded-systems,
        ngm:inference-hardware ;
    vc:slug "model-compression-for-edge" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:edge-computing,
        ngm:hardware-acceleration .

ngm:model-predictive-control a owl:Class ;
    rdfs:label "Model Predictive Control"@en ;
    rdfs:comment "Model Predictive Control (MPC) is an advanced control methodology in which a mathematical model of the controlled process is used to predict future system states over a receding finite time horizon, and a constrained optimisation problem is solved at each control step to determine the optimal sequence of control inputs. Only the first input of the computed sequence is applied, and the optimisation is repeated at the next step with an updated state estimate, producing a closed-loop feedback effect. MPC handles multi-input multi-output systems, hard constraints on states and inputs, and competing control objectives in a unified framework, making it widely used in chemical process control, autonomous vehicles, and robotic manipulation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:state-estimation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:control-system ],
        ngm:optimal-control,
        ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:dependsOn ngm:feedback-control ;
    vc:enables ngm:robot-control,
        ngm:trajectory-control ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:requires ngm:control-system,
        ngm:state-estimation ;
    vc:slug "model-predictive-control" ;
    vc:sourceDomain "robotics" .

ngm:network-component a owl:Class ;
    rdfs:label "Network Component"@en ;
    rdfs:comment "Network Component represents the fundamental infrastructure elements that constitute blockchain networks, including different node types, network protocols, and communication layers."@en ;
