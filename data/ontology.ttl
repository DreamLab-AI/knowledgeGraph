            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:web-xr-api ],
        ngm:sc-display-and-rendering,
        ngm:xr-hardware ;
    skos:broader ngm:sc-display-and-rendering ;
    vc:enables ngm:augmented-reality,
        ngm:spatial-computing,
        ngm:virtual-reality ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:metaverse,
        ngm:wearable-computing-platform ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires ngm:sensor-fusion,
        ngm:web-xr-api ;
    vc:slug "xr-headset" ;
    vc:sourceDomain "spatial-computing" .

ngm:zero-knowledge a owl:Class ;
    rdfs:label "Zero Knowledge"@en ;
    rdfs:comment "Cryptographic proof systems enabling a prover to convince a verifier that a statement is true without disclosing any information beyond the validity of the statement itself. zk-SNARKs and zk-STARKs are the dominant proof systems, with applications spanning blockchain scalability through ZK-rollups, privacy-preserving identity verification, confidential DeFi transactions, and verifiable AI model outputs. Foundational to privacy-preserving computation and Layer 2 scaling architectures."@en ;
    rdfs:subClassOf ngm:privacy-enhancing-computation-pec,
        ngm:sc-governance-and-safety ;
    skos:broader ngm:sc-governance-and-safety ;
    vc:enables ngm:blockchain-scalability,
        ngm:digital-identity,
        ngm:privacy-preserving-blockchain ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.4"^^xsd:float ;
    vc:slug "zero-knowledge" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:decentralised-finance,
        ngm:zero-knowledge-machine-learning ;
    vc:uses ngm:cryptographic-protocol,
        ngm:cryptography .

ngmi:open-ai-whisper a owl:NamedIndividual,
        ngm:automatic-speech-recognition ;
    rdfs:label "Open AI Whisper"@en ;
    rdfs:comment "OpenAI Whisper is an open-source automatic speech recognition (ASR) system released by OpenAI in September 2022, trained on approximately 680,000 hours of multilingual and multitask supervised audio data sourced from the internet. It employs a Transformer encoder-decoder architecture that jointly learns transcription, translation, and language identification from weakly supervised training data, achieving near-human accuracy across a broad range of accents, recording conditions, and languages. Whisper is released as open weights in multiple sizes (tiny, base, small, medium, large, and subsequent variants), enabling local deployment without API dependency. Its robustness to background noise, accented speech, and domain-specific vocabulary—combined with zero-shot multilingual performance—has made it the de facto baseline for ASR research and a widely deployed component in transcription pipelines, voice interfaces, and accessibility applications."@en ;
    vc:enables ngm:meeting-transcription,
        ngm:real-time-transcription ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:natural-language-processing,
        ngm:open-ai,
        ngm:speech-recognition,
        ngm:transformer-architecture ;
    vc:slug "open-ai-whisper" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:audio-processing-system,
        ngm:speech-and-voice .

ngm:3-d-rendering a owl:Class ;
    rdfs:label "3D Rendering"@en ;
    rdfs:comment "3D rendering is the computational process of generating a two-dimensional image or animation from a three-dimensional scene description by simulating the interaction of light with surfaces, materials, and geometry. It encompasses techniques ranging from real-time rasterization used in interactive applications to physically-based ray tracing used for photorealistic offline production. The pipeline converts geometric primitives, shader programs, texture maps, and lighting data into final pixel colours via a GPU compute pipeline or software renderer."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:pixel-shader ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:compute-shader ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:rasterization ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:ray-tracing ],
        ngm:computer-graphics ;
    vc:enables ngm:foveated-rendering,
        ngm:photorealistic-rendering,
        ngm:physically-based-rendering ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:compute-shader,
        ngm:pixel-shader,
        ngm:rasterization,
        ngm:ray-tracing ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:3-d-rendering-engine,
        ngm:differentiable-rendering ;
    vc:slug "3-d-rendering" ;
    vc:sourceDomain "graphics" ;
    vc:uses ngm:3-d-model,
        ngm:gpu-compute .

