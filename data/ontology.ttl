        ngm:iso-iec-jtc1-sc42 ;
    vc:supports ngm:ai-regulation,
        ngm:eu-ai-act-regulatory-instrument,
        ngm:interoperability ;
    vc:uses ngm:knowledge-representation,
        ngm:ontology,
        ngm:semantic-web-linked-data-standard .

ngm:euclidean-distance a owl:Class ;
    rdfs:label "Euclidean Distance"@en ;
    rdfs:comment "Euclidean distance is the straight-line distance between two points in Euclidean space, computed as the square root of the sum of squared differences across all coordinate dimensions. It is the most widely used distance metric in geometry, statistics, and machine learning, serving as the default measure of dissimilarity in clustering algorithms, nearest-neighbour search, and dimensionality reduction methods. As a special case of the Minkowski distance (p=2), it satisfies the metric axioms of non-negativity, symmetry, and the triangle inequality."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:tensor-computation ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:statistical-analysis ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:numerical-methods ],
        ngm:distance-metric ;
    vc:bridgesTo ngm:artificial-intelligence ;
    vc:contrastsWith ngm:cosine-similarity,
        ngm:mahalanobis-distance,
        ngm:manhattan-distance ;
    vc:dependsOn ngm:feature-normalisation,
        ngm:linear-algebra,
        ngm:tensor ;
    vc:enables ngm:anomaly-detection,
        ngm:clustering,
        ngm:machine-learning,
        ngm:nearest-neighbor-search ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:l2-norm,
        ngm:statistical-analysis ;
    vc:implements ngm:minkowski-distance,
        ngm:numerical-methods ;
    vc:qualityScore "0.88"^^xsd:float ;
    vc:relatedTo ngm:faiss,
        ngm:k-means,
        ngm:python-programming-language,
        ngm:ultra-wideband ;
    vc:requires ngm:numerical-methods,
        ngm:tensor-computation ;
    vc:slug "euclidean-distance" ;
    vc:sourceDomain "machine-learning" ;
    vc:supports ngm:data-management,
        ngm:dimensionality-reduction,
        ngm:vector-database ;
    vc:uses ngm:linear-algebra,
        ngm:statistical-analysis .

ngm:evm-compatible-blockchain a owl:Class ;
    rdfs:label "EVM-Compatible Blockchain"@en ;
    rdfs:comment "An EVM-compatible blockchain is a network whose execution environment implements the Ethereum Virtual Machine semantics, allowing it to run unmodified Ethereum smart contract bytecode and reuse Ethereum tooling. Compatibility lets developers deploy Solidity contracts, wallets and infrastructure across many chains with minimal changes, fostering an interoperable multi-chain ecosystem. Such chains include layer-2 rollups, sidechains and alternative layer-1 networks."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:smart-contract ],
        ngm:blockchain ;
    skos:broader ngm:blockchain ;
