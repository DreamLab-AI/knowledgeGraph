ngm:hyperledger-aries a owl:Class ;
    rdfs:label "Hyperledger Aries"@en ;
    rdfs:comment "Hyperledger Aries is an open-source toolkit providing the infrastructure for peer-to-peer interactions, secure messaging, and the exchange of verifiable credentials between decentralised identity agents. It implements DIDComm messaging and credential protocols, sitting above the ledger layer so that agents can issue, hold, and verify credentials independently of any specific blockchain. Aries is commonly paired with Hyperledger Indy as its verifiable-data registry."@en ;
    rdfs:subClassOf ngm:digital-identity ;
    vc:dependsOn ngm:hyperledger-indy ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:hyperledger-indy ;
    vc:slug "hyperledger-aries" ;
    vc:sourceDomain "infrastructure" .

ngm:hyperparameter-optimisation a owl:Class ;
    rdfs:label "Hyperparameter Optimisation"@en ;
    rdfs:comment "Hyperparameter optimisation is the automated search process for the configuration values — such as learning rate, regularisation strength, architecture depth, and batch size — that govern a machine learning model's training dynamics but are not learned directly from data, with the aim of maximising held-out validation performance. It encompasses grid search, random search, Bayesian optimisation, and gradient-based meta-learning, operating over an outer loop that wraps the inner model training procedure."@en ;
    rdfs:subClassOf ngm:hyperparameter ;
    vc:dependsOn ngm:machine-learning-discipline-framework ;
    vc:enables ngm:machine-learning-discipline-model,
        ngm:model-training ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:hyperparameter-tuning,
        ngm:learning-rate-schedule ;
    vc:slug "hyperparameter-optimisation" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:gradient-descent,
        ngm:machine-learning-discipline-pipeline,
        ngm:neural-architecture-search .

ngm:identity-proofing a owl:Class ;
    rdfs:label "Identity Proofing"@en ;
    rdfs:comment "Identity proofing is the process of collecting and validating evidence to establish that a claimed identity corresponds to a real, unique person before issuing credentials or granting access. It typically combines document verification, biometric checks, and authoritative-source confirmation, graded by assurance levels such as those defined in NIST SP 800-63A. Identity proofing precedes authentication and is foundational to trustworthy onboarding."@en ;
    rdfs:subClassOf ngm:identity-management ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:identity-verification ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:trust-framework ;
    vc:slug "identity-proofing" ;
    vc:sourceDomain "security" .

ngm:iec-62061 a owl:Class ;
    rdfs:label "IEC 62061"@en ;
    rdfs:comment "IEC 62061 is an international standard published by the International Electrotechnical Commission that specifies requirements for the design, integration, and validation of safety-related electrical, electronic, and programmable electronic control systems (SRECS) for machinery. It defines a risk-based framework for achieving Safety Integrity Levels (SIL 1–3) in machinery safety applications, covering the entire safety lifecycle from hazard identification through to decommissioning. The standard is sector-specific machinery application of the generic IEC 61508 functional safety framework, harmonised under the EU Machinery Directive and its successor the EU Machinery Regulation. It provides quantitative methods for calculating Probability of Dangerous Failure per Hour (PFH) and Diagnostic Coverage (DC) for hardware and software subsystems."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:safety-integrity-level ],
        ngm:technical-standard ;
    vc:bridgesTo ngm:collaborative-robot,
        ngm:industrial-automation ;
    vc:contrastsWith ngm:iec-61511,
        ngm:iso-13849 ;
    vc:dependsOn ngm:diagnostic-coverage,
        ngm:failure-mode-and-effects-analysis ;
    vc:enables ngm:ce-marking,
        ngm:machinery-directive,
        ngm:safety-validation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:iec-61508,
        ngm:risk-reduction ;
    vc:isPartOf ngm:functional-safety,
        ngm:machinery-safety ;
    vc:qualityScore "0.73"^^xsd:float ;
    vc:relatedTo ngm:hardware-fault-tolerance,
        ngm:iec-62443,
        ngm:iso-12100,
        ngm:safety-instrumented-system ;
    vc:requires ngm:hazard-and-risk-assessment,
        ngm:safety-integrity-level,
        ngm:safety-lifecycle ;
    vc:slug "iec-62061" ;
    vc:sourceDomain "standards" ;
    vc:uses ngm:probability-of-failure-on-demand,
        ngm:programmable-electronic-system,
        ngm:safety-related-control-system .

ngm:ifrs-s2 a owl:Class ;
    rdfs:label "IFRS S2"@en ;
    rdfs:comment "IFRS S2 is the climate-related disclosure standard issued by the International Sustainability Standards Board, specifying how entities report climate-related risks and opportunities. Building on the TCFD recommendations, it requires disclosure of physical and transition risks, greenhouse-gas emissions across Scopes 1 to 3, and climate-resilience analysis. IFRS S2 operates alongside the general IFRS S1 baseline."@en ;
    rdfs:subClassOf ngm:technical-standard ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:ifrs-s1 ;
