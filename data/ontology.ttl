# Telepresence
distributed-collaboration:Telepresence rdf:type owl:Class ;
    rdfs:subClassOf distributed-collaboration:RemoteCommunication ;
    rdfs:label "Telepresence"@en ;
    rdfs:comment "\"The technology-mediated experience of 'being there' in a remote location, creating the psychological sensation of physical presence despite geographical separation through immersive technologies, real-time communication, and sensory feedback systems that replicate spatial, visual, auditory, and tactile cues of co-location.\""@en ;
    skos:prefLabel "Telepresence"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:distributed-collaboration:telepresence-tc-0188" ;
    owl:sameAs <urn:visionclaw:concept:distributed-collaboration:telepresence-tc-0188> ;
    vcw:contentHash "sha256-12-a4558f8819ad" ;
    vcw:qualityScore "0.5"^^xsd:decimal ;
    vcw:legacyTermId "TC-0188" ;
    vcw:ontologyStatus "active" ;
    vcw:maturityLevel "mature" ;
    vcw:authorityScore "0.0"^^xsd:decimal ;
    dcterms:identifier "TC-0188" ;
    dcterms:subject "distributed-collaboration" ;
    owl:versionInfo "2.0.0" ;
    dcterms:created "2026-04-26T00:00:00Z"^^xsd:dateTime ;
    dcterms:modified "2026-04-26T13:00:00Z"^^xsd:dateTime ;
    vcw:owlRole "Concept" .

distributed-collaboration:Telepresence rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty infrastructure:requires ;
    owl:someValuesFrom distributed-collaboration:ImmersiveTechnology
] .

distributed-collaboration:Telepresence rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty infrastructure:enables ;
    owl:someValuesFrom distributed-collaboration:RemoteCollaboration
] .

# Telecollaboration
distributed-collaboration:Telecollaboration rdf:type owl:Class ;
    rdfs:subClassOf distributed-collaboration:DistributedWork ;
    rdfs:label "Telecollaboration"@en ;
    rdfs:comment "\"The process of individuals or groups working together towards shared goals across geographical distances through technology-mediated communication and coordination tools, integrating synchronous and asynchronous interaction modalities to achieve collaborative outcomes comparable to or exceeding co-located teamwork.\""@en ;
    skos:prefLabel "Telecollaboration"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:distributed-collaboration:telecollaboration" ;
    owl:sameAs <urn:visionclaw:concept:distributed-collaboration:telecollaboration> ;
