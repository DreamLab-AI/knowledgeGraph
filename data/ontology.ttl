ngm:deep-research a owl:Class ;
    rdfs:label "Deep Research"@en ;
    rdfs:comment "Deep research is an agentic AI capability in which a language model autonomously plans and executes multi-step investigations, browsing the web, reading sources, and synthesising a cited report on a topic. The agent decomposes a query into sub-questions, iteratively gathers evidence across many pages, and reconciles findings rather than answering from parametric memory alone. It trades latency for depth, breadth of sources, and verifiable citations."@en ;
    rdfs:subClassOf ngm:ai-application ;
    skos:broader ngm:ai-application ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:agents,
        ngm:computer-use-and-browser-agents ;
    vc:slug "deep-research" ;
    vc:sourceDomain "ai" .

