            owl:someValuesFrom ngm:inference-compute ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:reasoning-trace ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:operating-system ],
        [ a owl:Restriction ;
