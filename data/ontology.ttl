    a owl:Restriction ;
    owl:onProperty infrastructure:enables ;
    owl:someValuesFrom blockchain:BusinessProcessAutomation
] .

# Blockchain Sustainability
blockchain:BlockchainSustainability rdf:type owl:Class ;
    rdfs:subClassOf blockchain:Blockchain ;
    rdfs:label "Blockchain Sustainability"@en ;
    rdfs:comment "The practice of designing, operating, and evolving blockchain networks to minimize environmental impact through energy-efficient consensus mechanisms, renewable energy integration, and carbon offset strategies. Proof-of-Stake networks like Ethereum post-Merge achieve 99.9% energy reduction versus Proof-of-Work, while protocols like Algorand have achieved carbon-negative status."@en ;
    skos:prefLabel "Blockchain Sustainability"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:blockchain:blockchain-sustainability" ;
    owl:sameAs <urn:visionclaw:concept:blockchain:blockchain-sustainability> ;
    vcw:contentHash "sha256-12-dd24f221a695" ;
    vcw:qualityScore "0.5"^^xsd:decimal ;
    vcw:legacyTermId "BC-7008" ;
    vcw:ontologyStatus "active" ;
    vcw:maturityLevel "reviewed" ;
    vcw:authorityScore "0.0"^^xsd:decimal ;
    dcterms:identifier "BC-7008" ;
    dcterms:subject "blockchain" ;
    owl:versionInfo "2.0.0" ;
    dcterms:created "2026-04-26T00:00:00Z"^^xsd:dateTime ;
    dcterms:modified "2026-04-26T13:00:00Z"^^xsd:dateTime ;
    vcw:owlRole "Concept" .

blockchain:BlockchainSustainability rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty infrastructure:enables ;
    owl:someValuesFrom blockchain:CarbonCredit
] .

