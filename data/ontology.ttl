ngm:un-global-compact a owl:Class ;
    rdfs:label "UN Global Compact"@en ;
    rdfs:comment "The UN Global Compact is a voluntary United Nations initiative encouraging businesses worldwide to adopt sustainable and socially responsible policies aligned with ten principles covering human rights, labour, environment, and anti-corruption. Signatory companies commit to embedding these principles in their operations and to reporting annual progress, making it the world's largest corporate sustainability initiative."@en ;
    rdfs:subClassOf ngm:governance-framework ;
