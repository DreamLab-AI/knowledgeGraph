    vc:requires ngm:5-g-network,
        ngm:network-slicing ;
    vc:slug "tele-153-5-g-telepresence" ;
    vc:sourceDomain "metaverse" .

ngm:tele-154-edge-computing-telepresence a owl:Class ;
    rdfs:label "TELE-154-edge-computing-telepresence"@en ;
    rdfs:comment "Edge computing for telepresence places processing such as encoding, rendering and reconstruction close to users at the network edge to reduce latency and bandwidth for immersive remote communication."@en ;
