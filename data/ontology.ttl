    vc:qualityScore "0.52"^^xsd:float ;
    vc:relatedTo ngm:animate-diff,
        ngm:comfy-ui,
        ngm:comfy-ui-workflows,
        ngm:control-net,
        ngm:flux-1,
        ngm:generative-image-models,
        ngm:ip-adapter,
        ngm:midjourney,
