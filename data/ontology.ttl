ngm:usdc a owl:Class ;
    rdfs:label "USDC"@en ;
    rdfs:comment "A fiat-backed stablecoin pegged to the United States dollar, issued against reserves of cash and short-term government securities and redeemable on a one-for-one basis."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:smart-contract ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:custody-infrastructure ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:usd ],
        ngm:stablecoin ;
    vc:bridgesTo ngm:programmable-money,
        ngm:traditional-finance ;
    vc:contrastsWith ngm:central-bank-digital-currency,
        ngm:dai,
        ngm:usdt ;
    vc:dependsOn ngm:payment-system,
        ngm:regulatory-compliance ;
    vc:enables ngm:cross-border-payment,
        ngm:defi-collateral,
        ngm:on-chain-settlement ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:erc-20-token,
        ngm:redemption-mechanism ;
    vc:implements ngm:cross-chain-bridge-protocol,
        ngm:erc-20-standard ;
    vc:isPartOf ngm:defi-infrastructure,
        ngm:stablecoin-ecosystem ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:circle-financial,
        ngm:money-market-fund ;
    vc:requires ngm:custody-infrastructure,
        ngm:reserve-attestation,
        ngm:smart-contract,
        ngm:usd ;
    vc:slug "usdc" ;
    vc:sourceDomain "blockchain" ;
    vc:standardizedBy ngm:centre-consortium ;
    vc:uses ngm:ethereum,
        ngm:proof-of-reserves,
        ngm:solana .

