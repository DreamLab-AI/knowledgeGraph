        ngm:gradient-descent,
        ngm:linear-programming ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:game-theory,
        ngm:information-theory,
        ngm:numerical-methods ;
    vc:requires ngm:constraint,
        ngm:loss-function,
        ngm:objective-function ;
    vc:slug "optimisation" ;
    vc:sourceDomain "machine-learning" ;
    vc:supports ngm:neural-network-training,
        ngm:portfolio-optimisation,
        ngm:reinforcement-learning,
        ngm:supply-chain-management ;
    vc:uses ngm:calculus,
