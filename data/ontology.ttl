    vc:slug "user-representation" ;
    vc:sourceDomain "metaverse" .

ngm:validator-selection a owl:Class ;
    rdfs:label "Validator Selection"@en ;
    rdfs:comment "Validator selection is the consensus mechanism by which a proof-of-stake blockchain chooses which staked participants are eligible to propose and attest to blocks in a given slot or epoch. It typically uses stake-weighted, often pseudo-randomised sampling to assign block production while preserving security and decentralisation. The design directly affects fairness, finality, energy efficiency and resistance to manipulation."@en ;
    rdfs:subClassOf ngm:proof-of-stake ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:proof-of-stake-sustainability,
        ngm:testnet ;
    vc:slug "validator-selection" ;
    vc:sourceDomain "blockchain" .

ngm:vector-clocks a owl:Class ;
    rdfs:label "Vector Clocks"@en ;
    rdfs:comment "A mechanism for ordering events in a distributed system by assigning each process a vector of counters. Comparing vectors determines whether one event causally precedes another or whether they are concurrent."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:distributed-computing ],
        ngm:clock-synchronization ;
    vc:enables ngm:eventual-consistency ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:distributed-computing ;
    vc:slug "vector-clocks" ;
    vc:sourceDomain "distributed-systems" .

ngm:vector-databases a owl:Class ;
    rdfs:label "Vector Databases"@en ;
    rdfs:comment "Database systems specialised for storing high-dimensional vector embeddings and performing similarity search over them, typically using approximate nearest neighbour indexing."@en ;
