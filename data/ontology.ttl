    dcterms:modified "2026-04-26T13:00:00Z"^^xsd:dateTime ;
    vcw:owlRole "Process" .

# Digital Twin Collaboration
distributed-collaboration:DigitalTwinCollaboration rdf:type owl:Class ;
    rdfs:subClassOf distributed-collaboration:TELE002telecollaboration ;
    rdfs:label "Digital Twin Collaboration"@en ;
    rdfs:comment "\"The use of shared virtual replicas of physical assets, processes, or environments as collaborative workspaces where geographically distributed teams simultaneously inspect, analyse, simulate, and modify digital representations synchronised with real-world counterparts through sensor data streams, enabling remote collaboration on physical systems.\""@en ;
    skos:prefLabel "Digital Twin Collaboration"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:distributed-collaboration:digital-twin-collaboration" ;
    owl:sameAs <urn:visionclaw:concept:distributed-collaboration:digital-twin-collaboration> ;
    vcw:contentHash "sha256-12-15d38949b8e5" ;
    vcw:qualityScore "0.5"^^xsd:decimal ;
    vcw:legacyTermId "TC-0300" ;
    vcw:ontologyStatus "active" ;
    vcw:maturityLevel "developing" ;
    vcw:authorityScore "0.0"^^xsd:decimal ;
    dcterms:identifier "TC-0300" ;
    dcterms:subject "distributed-collaboration" ;
    owl:versionInfo "2.0.0" ;
    dcterms:created "2026-04-26T00:00:00Z"^^xsd:dateTime ;
    dcterms:modified "2026-04-26T13:00:00Z"^^xsd:dateTime ;
    vcw:owlRole "Object" .

distributed-collaboration:DigitalTwinCollaboration rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty infrastructure:requires ;
    owl:someValuesFrom distributed-collaboration:CloudComputing
] .

distributed-collaboration:DigitalTwinCollaboration rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty infrastructure:enables ;
    owl:someValuesFrom distributed-collaboration:CollaborativeSimulation
] .

# Virtual Office Spaces
distributed-collaboration:VirtualOfficeSpaces rdf:type owl:Class ;
    rdfs:subClassOf distributed-collaboration:VirtualEnvironment ;
    rdfs:label "Virtual Office Spaces"@en ;
    rdfs:comment "\"Persistent virtual reality or metaverse environments designed as professional workspaces where distributed teams gather as avatars to collaborate, attend meetings, use shared whiteboards, and navigate 3D office layouts, replicating physical office spatial dynamics whilst enabling global remote participation through immersive telepresence platforms.\""@en ;
    skos:prefLabel "Virtual Office Spaces"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:distributed-collaboration:virtual-office-spaces" ;
    owl:sameAs <urn:visionclaw:concept:distributed-collaboration:virtual-office-spaces> ;
    vcw:contentHash "sha256-12-1bb4495e6ff8" ;
    vcw:qualityScore "0.5"^^xsd:decimal ;
    vcw:legacyTermId "TC-0301" ;
    vcw:ontologyStatus "active" ;
    vcw:maturityLevel "developing" ;
    vcw:authorityScore "0.0"^^xsd:decimal ;
    dcterms:identifier "TC-0301" ;
    dcterms:subject "distributed-collaboration" ;
    owl:versionInfo "2.0.0" ;
    dcterms:created "2026-04-26T00:00:00Z"^^xsd:dateTime ;
    dcterms:modified "2026-04-26T13:00:00Z"^^xsd:dateTime ;
    vcw:owlRole "Object" .

# Shared Whiteboards
distributed-collaboration:SharedWhiteboards rdf:type owl:Class ;
    rdfs:subClassOf distributed-collaboration:TELE002telecollaboration ;
    rdfs:label "Shared Whiteboards"@en ;
    rdfs:comment "\"Digital canvases in telepresence platforms enabling distributed team members to simultaneously draw, write, annotate, and manipulate visual content (text, images, diagrams, sticky notes) in real-time, replicating physical whiteboard collaboration dynamics through multi-user synchronisation and persistent storage of collaborative artefacts.\""@en ;
    skos:prefLabel "Shared Whiteboards"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:distributed-collaboration:shared-whiteboards" ;
    owl:sameAs <urn:visionclaw:concept:distributed-collaboration:shared-whiteboards> ;
    vcw:contentHash "sha256-12-0bda0ca5d97a" ;
    vcw:qualityScore "0.35"^^xsd:decimal ;
    vcw:legacyTermId "TC-0302" ;
