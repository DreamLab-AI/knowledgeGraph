ngm:user-representation a owl:Class ;
    rdfs:label "User Representation"@en ;
    rdfs:comment "User representation is the visual and behavioural embodiment of a person within a virtual environment, encompassing avatars, presence indicators and the mapping of real movement onto a digital persona. It conveys identity, expression and social presence, allowing others to perceive and interact with the user in shared spaces. It is a defining element of avatar systems and virtual worlds."@en ;
    rdfs:subClassOf ngm:virtual-environment ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
