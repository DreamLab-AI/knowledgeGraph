# Trust Framework
infrastructure:TrustFramework rdf:type owl:Class ;
    rdfs:subClassOf infrastructure:Framework ;
    rdfs:label "Trust Framework"@en ;
    rdfs:comment "Conceptual and operational model defining trust relationships, trust assumptions, and mechanisms for establishing confidence in narrative system participants. Encompasses identity models, credential systems, and evaluation criteria for assessing trustworthiness."@en ;
    skos:prefLabel "Trust Framework"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:infrastructure:trust-framework" ;
    owl:sameAs <urn:visionclaw:concept:infrastructure:trust-framework> ;
    vcw:contentHash "sha256-12-000000000000" ;
    vcw:qualityScore "0.35"^^xsd:decimal ;
    vcw:legacyTermId "NGM-trust-framework" ;
    vcw:ontologyStatus "stub" ;
    vcw:maturityLevel "draft" ;
    vcw:authorityScore "0.0"^^xsd:decimal ;
    dcterms:identifier "NGM-trust-framework" ;
    dcterms:subject "infrastructure" ;
    owl:versionInfo "2.0.0" ;
    dcterms:created "2026-04-26T00:00:00Z"^^xsd:dateTime ;
    dcterms:modified "2026-04-26T14:00:00Z"^^xsd:dateTime ;
    vcw:owlRole "Object" .

infrastructure:TrustFramework rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty infrastructure:hasPart ;
    owl:someValuesFrom infrastructure:IdentityModel
] .

infrastructure:TrustFramework rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty infrastructure:hasPart ;
    owl:someValuesFrom infrastructure:CredentialSystem
] .

infrastructure:TrustFramework rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty infrastructure:hasPart ;
    owl:someValuesFrom infrastructure:TrustEvaluation
] .

infrastructure:TrustFramework rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty infrastructure:hasPart ;
    owl:someValuesFrom infrastructure:TrustAssumptions
] .

infrastructure:TrustFramework rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty infrastructure:hasPart ;
    owl:someValuesFrom infrastructure:RevocationMechanism
] .

infrastructure:TrustFramework rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty infrastructure:dependsOn ;
    owl:someValuesFrom infrastructure:TrustInfrastructure
] .

infrastructure:TrustFramework rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty infrastructure:enables ;
    owl:someValuesFrom infrastructure:TrustAssessment
] .

infrastructure:TrustFramework rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty infrastructure:enables ;
    owl:someValuesFrom infrastructure:CredentialVerification
] .

infrastructure:TrustFramework rdfs:subClassOf [
