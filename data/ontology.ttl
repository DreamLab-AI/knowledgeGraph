ngm:technology-programme-delivery-planning a owl:Class ;
    rdfs:label "Technology Programme Delivery Planning"@en ;
    rdfs:comment "Delivery Planning is the structured process of decomposing a technology programme into milestones, tasks, resource assignments, and timelines to ensure coherent execution. In the context of spatial computing and AI platform development, delivery planning coordinates parallel workstreams—GenAI model development, platform infrastructure, digital asset creation, human tracking integration, and USD file format implementation—typically represented as Gantt charts or sprint boards."@en ;
    rdfs:subClassOf ngm:infra-software-engineering ;
    skos:broader ngm:infra-software-engineering ;
    vc:dependsOn ngm:collaboration ;
    vc:enables ngm:development-platform ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:slug "technology-programme-delivery-planning" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:digital-infrastructure,
        ngm:digital-twin ;
    vc:uses ngm:ai-agent-system,
        ngm:digital-platform .

ngm:technology-sector-landscape-analysis a owl:Class ;
    rdfs:label "Technology Sector Landscape Analysis"@en ;
    rdfs:comment "A Landscape, in the context of this knowledge graph, is a structured market-analysis overview of the current state of an AI or technology sector, mapping key players, technology stacks, investment flows, and emerging patterns. Landscape analyses such as those from a16z or Cowboy Ventures provide practitioners with orientation in rapidly shifting fields and inform infrastructure strategy."@en ;
    rdfs:subClassOf ngm:infra-computing-and-cloud ;
    skos:broader ngm:infra-computing-and-cloud ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:infra-computing-and-cloud ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:relatedTo ngm:generative-ai,
        ngm:large-language-models ;
    vc:slug "technology-sector-landscape-analysis" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:machine-learning-discipline .

