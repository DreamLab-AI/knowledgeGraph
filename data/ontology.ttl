        ngm:rigid-body-dynamics,
        ngm:soft-body-dynamics ;
    vc:isPartOf ngm:game-engine,
        ngm:simulation-environment ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:haptic-feedback,
