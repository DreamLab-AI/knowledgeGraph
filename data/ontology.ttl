# Deep Learning
artificial-intelligence:DeepLearning rdf:type owl:Class ;
    rdfs:subClassOf artificial-intelligence:MachineLearning ;
    rdfs:subClassOf artificial-intelligence:ArtificialIntelligence ;
    rdfs:label "Deep Learning"@en ;
    rdfs:comment "Deep Learning is a subset of Machine Learning based on Artificial Neural Networks with multiple layers (depth) that learn hierarchical representations of data through Backpropagation and Gradient Descent. Deep learning models automatically discover intricate structures in high-dimensional data, enabling breakthrough performance in Computer Vision, Natural Language Processing, Speech Recognition, and Reinforcement Learning. The \"deep\" refers to the number of layers through which data is transformed, allowing the network to learn increasingly abstract and complex features."@en ;
    skos:prefLabel "Deep Learning"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:artificial-intelligence:deep-learning" ;
    owl:sameAs <urn:visionclaw:concept:artificial-intelligence:deep-learning> ;
