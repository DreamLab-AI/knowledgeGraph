    vc:qualityScore "0.9"^^xsd:float ;
    vc:requires ngm:did-resolution,
        ngm:json-ld-1-1,
        ngm:schnorr-signature,
        ngm:sha-256-hashing,
        ngm:w3-c-vc-2-0-standard ;
    vc:slug "verifiable-credential-surface" ;
    vc:sourceDomain "blockchain" .

ngm:vfx-tools a owl:Class ;
    rdfs:label "VFX Tools"@en ;
    rdfs:comment "VFX Tools are software applications and pipelines used to create, composite, and render visual effects for film, television, real-time engines, and immersive media. They encompass particle simulation, fluid and cloth dynamics, compositing, colour grading, and procedural generation capabilities, and increasingly interface with real-time rendering engines for deployment in spatial computing contexts."@en ;
    rdfs:subClassOf ngm:sc-display-and-rendering,
        ngm:visual-effects ;
    skos:broader ngm:sc-display-and-rendering ;
    vc:enables ngm:rendering-technique ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:relatedTo ngm:animation-software,
        ngm:rendering-engine ;
    vc:slug "vfx-tools" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:particle-system,
        ngm:rendering-pipeline .

ngm:virtual-destination a owl:Class ;
    rdfs:label "Virtual Destination"@en ;
    rdfs:comment "A digital location or space within a virtual environment that serves as a point of interest or travel objective, encompassing photogrammetry-reconstructed heritage sites, procedurally generated fantasy worlds, brand experience spaces, and interactive event venues accessible through metaverse platforms. Virtual destinations underpin virtual tourism, educational field trips, and social gathering use-cases, and are created using real-time rendering engines together with photogrammetry and 3D modelling pipelines."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:real-time-rendering ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:virtual-world-platform ],
        ngm:sc-platform-and-environment,
        ngm:virtual-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:enables ngm:virtual-field-trip,
        ngm:virtual-tourism ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:virtual-tour ;
    vc:requires ngm:real-time-rendering,
        ngm:virtual-world-platform ;
    vc:slug "virtual-destination" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:immersive-experience,
        ngm:photogrammetry .

ngm:virtual-environment-creation a owl:Class ;
    rdfs:label "Virtual Environment Creation"@en ;
    rdfs:comment "The process of designing, building, and deploying immersive 3D virtual worlds using game engines, modelling software, and AI-powered tools, encompassing static and dynamic assets, physics simulation, and interactive experiences for metaverse platforms."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:3-d-modeling ],
        [ a owl:Restriction ;
