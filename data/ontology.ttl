ngm:algorithmic-bias-and-variance a owl:Class ;
    rdfs:label "Algorithmic Bias and Variance"@en ;
    rdfs:comment "Algorithmic Bias and Variance denotes the canonical decomposition of supervised-learning generalisation error into three orthogonal components — squared bias, variance, and irreducible noise — formalised by Geman, Bienenstock & Doursat (1992) as Err(x) = E[(y − f̂(x))²] = (E[f̂(x)] − f(x))² + E[(..."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:bias ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:training-data-distribution ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:loss-function ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:mean-squared-error ],
        ngm:ai-technique,
        ngm:model-evaluation,
        ngm:neural-network ;
    skos:broader ngm:ai-technique ;
    vc:enables ngm:hyperparameter-tuning,
        ngm:model-selection ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:bias,
        ngm:hypothesis-class,
        ngm:mean-squared-error ;
    vc:implements ngm:cross-validation,
        ngm:sampling ;
    vc:qualityScore "0.52"^^xsd:float ;
    vc:relatedTo ngm:benign-overfitting,
        ngm:grokking,
        ngm:inductive-bias,
        ngm:overfitting,
        ngm:scaling-laws,
        ngm:underfitting ;
    vc:requires ngm:loss-function,
        ngm:training-data-distribution ;
    vc:slug "algorithmic-bias-and-variance" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:standardizedBy ngm:py-torch,
        ngm:scikit-learn ;
    vc:supports ngm:bagging,
        ngm:boosting,
        ngm:dropout,
        ngm:early-stopping,
        ngm:ensemble-methods,
        ngm:regularisation,
        ngm:stacking ;
    vc:uses ngm:concentration-inequalities .

ngm:algorithmic-trading a owl:Class ;
    rdfs:label "Algorithmic Trading"@en ;
    rdfs:comment "Algorithmic trading is the use of computer programs to execute trading decisions automatically according to predefined rules covering timing, price, quantity and order routing, often without human intervention. It spans execution algorithms that minimise market impact, systematic strategies that generate signals, and high-frequency trading that exploits microsecond advantages. In crypto markets it operates across centralised and decentralised venues and interacts closely with on-chain mechanisms such as maximal extractable value."@en ;
    rdfs:subClassOf ngm:financial-trading ;
    vc:bridgesTo ngm:crypto-trading,
        ngm:decentralised-finance,
        ngm:digital-asset-trading ;
    vc:dependsOn ngm:latency ;
    vc:enables ngm:high-frequency-trading,
        ngm:market-making ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:financial-trading ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:financial-trading,
        ngm:mev ;
    vc:slug "algorithmic-trading" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:decentralised-exchange,
        ngm:liquidity ;
    vc:uses ngm:market-microstructure,
        ngm:risk-management .

ngm:animation-controller a owl:Class ;
    rdfs:label "Animation Controller"@en ;
    rdfs:comment "An animation controller is a software component that manages the selection, blending, and sequencing of animation clips for a character or object in real-time interactive environments. It typically implements a state machine model in which transitions between animation states are governed by parametric conditions such as velocity, input events, or AI signals. Animation controllers sit between high-level game logic and the low-level skeletal animation runtime, abstracting away the complexity of blend trees, IK passes, and additive layers."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:character-rigging ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:blend-tree ],
        ngm:controller ;
    vc:bridgesTo ngm:machine-learning,
        ngm:reinforcement-learning ;
    vc:dependsOn ngm:physics-engine ;
    vc:enables ngm:animation-retargeting,
        ngm:motion-matching,
        ngm:procedural-animation,
        ngm:real-time-rendering ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:blend-tree ;
    vc:isPartOf ngm:game-engine ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:animation,
        ngm:character-animation,
        ngm:character-rigging,
        ngm:locomotion,
        ngm:procedural-animation,
        ngm:ragdoll-physics ;
    vc:requires ngm:animation-clip,
        ngm:character-rigging ;
    vc:slug "animation-controller" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:animation-clip,
        ngm:blend-tree,
        ngm:inverse-kinematics,
        ngm:skeletal-animation,
        ngm:state-machine .

ngm:ar-frame a owl:Class ;
    rdfs:label "AR Frame"@en ;
    rdfs:comment "An AR Frame is a head-worn optical see-through augmented reality platform integrating a transparent or semi-transparent microdisplay (typically a microOLED, LCoS, or holographic waveguide projecting 480p-1080p imagery onto a combiner lens of 20°-50° diagonal field-of-view), onboard processing (AR..."@en ;
