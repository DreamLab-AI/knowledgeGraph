ngm:bayesian-inference a owl:Class ;
    rdfs:label "Bayesian Inference"@en ;
    rdfs:comment "Bayesian Inference is a principled statistical framework that updates the probability of a hypothesis as new evidence is observed, using Bayes' theorem to combine a prior distribution over parameters with a likelihood function derived from data to yield a posterior distribution. Unlike frequentist methods, it treats probability as a degree of belief and propagates uncertainty through every step of reasoning, enabling calibrated predictions and natural model comparison via marginal likelihoods. In machine learning, it underpins probabilistic graphical models, Gaussian processes, Bayesian neural networks, variational inference, and Markov Chain Monte Carlo methods. Its capacity to incorporate domain knowledge through priors and to quantify epistemic uncertainty makes it foundational for safety-critical AI, active learning, and sequential decision-making."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:likelihood-function ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:posterior-distribution ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:markov-chain-monte-carlo ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:probability-theory ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:prior-distribution ],
        ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:bridgesTo ngm:causal-inference,
        ngm:decision-theory ;
    vc:contrastsWith ngm:frequentist-statistics,
        ngm:maximum-likelihood-estimation ;
    vc:dependsOn ngm:conditional-probability ;
    vc:enables ngm:active-learning,
        ngm:anomaly-detection,
        ngm:model-selection,
        ngm:sequential-decision-making,
        ngm:uncertainty-quantification ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:likelihood-function,
        ngm:markov-chain-monte-carlo,
        ngm:posterior-distribution,
        ngm:prior-distribution ;
    vc:implements ngm:bayes-theorem ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:deep-learning,
        ngm:gaussian-process,
        ngm:information-theory,
        ngm:probabilistic-graphical-model ;
    vc:requires ngm:probability-theory,
        ngm:statistical-model ;
    vc:slug "bayesian-inference" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:machine-learning,
        ngm:natural-language-processing,
        ngm:reinforcement-learning ;
    vc:uses ngm:expectation-maximisation,
        ngm:knowledge-representation,
        ngm:variational-inference .

ngm:fairness a owl:Class ;
    rdfs:label "Fairness"@en ;
    rdfs:comment "The property of an AI system whereby it produces equitable outcomes and avoids creating or reinforcing unjustifiable disparities across different demographic groups or individuals, measured through various mathematical definitions and ethical principles including demographic parity, equalized odds, equal opportunity, calibration, and individual fairness."@en ;
    rdfs:subClassOf ngm:ai-governance-and-ethics ;
