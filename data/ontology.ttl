        ngm:digital-asset ;
    vc:requires ngm:financial-regulation,
        ngm:identity-verification,
        ngm:regulatory-compliance ;
    vc:slug "security-token-offering" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:security-token,
        ngm:smart-contract .

ngm:sensor-technology a owl:Class ;
    rdfs:label "Sensor Technology"@en ;
    rdfs:comment "Sensor Technology encompasses the diverse hardware devices and fusion algorithms that capture physical-world data for use in robotics, spatial computing, and XR systems. This includes inertial measurement units, LiDAR scanners, depth cameras, eye-tracking, haptic sensors, and biometric devices, combined with fusion techniques such as visual-inertial odometry and Kalman filtering to produce accurate, robust state estimates for autonomous systems and immersive experiences."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:imu ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:camera ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:eye-tracking ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:lidar ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:haptic-feedback ],
        ngm:robo-perception ;
    skos:broader ngm:robo-perception ;
    vc:enables ngm:perception-system,
        ngm:sensor-fusion,
        ngm:slam ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:camera,
        ngm:eye-tracking,
        ngm:haptic-feedback,
        ngm:imu,
        ngm:lidar ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:slug "sensor-technology" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:depth-sensing .

ngm:servo-control a owl:Class ;
    rdfs:label "Servo Control"@en ;
    rdfs:comment "Servo Control is a closed-loop control methodology that uses feedback signals — typically from encoders or resolvers — to precisely regulate the position, velocity, or torque of an actuator. A servo controller computes the error between a desired setpoint and the measured output, then drives a servo motor or hydraulic actuator to minimise that error, making servo control foundational to high-precision robotic joint control, CNC machining, and collaborative robot safety systems."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:closed-loop-control ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:actuator ],
        ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:enables ngm:motion-control ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:safety-plc ;
    vc:requires ngm:actuator,
        ngm:closed-loop-control ;
    vc:slug "servo-control" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:feedback-control,
        ngm:pid-controller,
        ngm:servo-motor .

ngm:session-manager a owl:Class ;
    rdfs:label "Session Manager"@en ;
    rdfs:comment "A Session Manager is a software component responsible for creating, maintaining, tracking, and terminating user or application sessions within a computing system, ensuring that stateful context is preserved across multiple interactions or network requests. It issues session tokens or identifiers, enforces timeout and expiry policies, replicates session state for high-availability scenarios, and integrates with authentication services to verify that sessions remain bound to authenticated principals. Session managers are critical security components: misconfigurations can lead to session fixation, hijacking, or replay attacks. In distributed architectures they must handle session affinity, cross-node replication, and graceful failover without exposing stale state."@en ;
    rdfs:subClassOf ngm:middleware ;
    vc:enables ngm:api-gateway,
        ngm:user-experience ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:cloud-computing,
        ngm:data-persistence,
        ngm:distributed-system,
        ngm:middleware-layer,
        ngm:state-machine ;
    vc:slug "session-manager" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:authentication,
        ngm:authentication-service,
        ngm:state-management,
        ngm:web-socket-protocol .

ngm:set-theory a owl:Class ;
    rdfs:label "Set Theory"@en ;
    rdfs:comment "The branch of mathematical logic that studies collections of objects called sets, providing a foundational language for most of modern mathematics."@en ;
    rdfs:subClassOf ngm:owl-thing ;
    vc:enables ngm:description-logic,
        ngm:graph-theory,
        ngm:probability-theory ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:slug "set-theory" ;
    vc:sourceDomain "mathematics" .

ngm:settlement-layer a owl:Class ;
    rdfs:label "Settlement Layer"@en ;
    rdfs:comment "The Settlement Layer is the stratum that achieves final, irreversible transfer of value or state between parties. In layered ledger systems it sits beneath faster execution and netting strata and above the Consensus Layer that secures finality. It contains the records, accounts, and finality conditions under which obligations are discharged."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:consensus-layer ],
        ngm:owl-thing ;
    vc:enables ngm:lightning-network-layer,
        ngm:smart-contract-layer ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:consensus-layer ;
    vc:slug "settlement-layer" ;
    vc:sourceDomain "settlement" .

ngm:shader-language a owl:Class ;
    rdfs:label "Shader Language"@en ;
    rdfs:comment "A Shader Language is a domain-specific programming language designed for expressing GPU-executable algorithms that control the stages of a rendering pipeline. Major shader languages include GLSL for OpenGL/WebGL, HLSL for DirectX, Metal Shading Language for Apple platforms, and WGSL for WebGPU. They support specialised data types such as vectors and matrices, and are compiled to intermediate representations like SPIR-V for hardware-agnostic deployment."@en ;
    rdfs:subClassOf ngm:sc-display-and-rendering ;
    skos:broader ngm:sc-display-and-rendering ;
    vc:enables ngm:physically-based-rendering,
        ngm:rendering-pipeline ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:relatedTo ngm:gpu-compute,
        ngm:real-time-rendering ;
    vc:slug "shader-language" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:compute-shader,
        ngm:vertex-shader .

ngm:simulation-environment a owl:Class ;
    rdfs:label "Simulation Environment"@en ;
    rdfs:comment "A simulation environment is a software-defined system that models physical or virtual worlds with sufficient fidelity to support training, testing, or validation of agents, algorithms, or hardware without exposure to real-world risk or cost. It integrates a physics engine, sensor models, actuator dynamics, and observation/action interfaces, and is used across robotics, autonomous vehicle development, reinforcement learning research, and military mission planning. Fidelity-reality gaps — differences between simulated and real-world dynamics — are the primary challenge in transferring learned behaviours from simulation to deployment."@en ;
    rdfs:subClassOf ngm:simulation ;
    vc:enables ngm:embodied-ai-simulation,
        ngm:synthetic-data-generation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:digital-twin,
        ngm:physics-simulation,
        ngm:virtual-environment ;
    vc:slug "simulation-environment" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:simulation-engine ;
    vc:uses ngm:game-engine,
        ngm:physics-engine .

ngm:store-of-value a owl:Class ;
    rdfs:label "Store of Value"@en ;
    rdfs:comment "A store of value is any asset that retains purchasing power over time, enabling the owner to defer consumption and retrieve real wealth in the future with minimal loss to inflation, confiscation, or degradation. Classical monetary theory identifies store-of-value function alongside medium-of-exchange and unit-of-account as the three primary functions of money, though assets can serve one function without the others."@en ;
    rdfs:subClassOf ngm:bitcoin-as-money ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.85"^^xsd:float ;
    vc:relatedTo ngm:gold-standard,
        ngm:hard-money,
        ngm:inflation-hedge ;
    vc:slug "store-of-value" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:austrian-hard-money-theory,
        ngm:fixed-supply-monetary-policy .

ngm:synthetic-data-generation a owl:Class ;
    rdfs:label "Synthetic Data Generation"@en ;
    rdfs:comment "Synthetic Data Generation is the process of algorithmically producing artificial datasets that statistically mirror real-world distributions without exposing sensitive personal information. Techniques include generative adversarial networks, diffusion models, physics simulation, and rule-based sampling, enabling model training where real data is scarce, private, or costly to label."@en ;
    rdfs:subClassOf ngm:ai-application ;
    skos:broader ngm:ai-application ;
    vc:enables ngm:embodied-ai-simulation,
        ngm:federated-learning,
        ngm:privacy-preserving-data-sharing ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:data-augmentation-strategies,
        ngm:deep-generative-model,
        ngm:differential-privacy ;
    vc:slug "synthetic-data-generation" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:data-pipeline,
        ngm:diffusion-model,
        ngm:generative-adversarial-network,
        ngm:generative-model,
        ngm:simulation .

ngm:systems-engineering a owl:Class ;
    rdfs:label "Systems Engineering"@en ;
    rdfs:comment "Systems Engineering is an interdisciplinary methodology for designing, integrating, and managing complex systems over their lifecycle. It applies structured processes — requirements analysis, architecture definition, verification, and validation — to ensure that subsystem interactions meet overall system objectives within cost, schedule, and quality constraints."@en ;
    rdfs:subClassOf ngm:infra-software-engineering ;
    skos:broader ngm:infra-software-engineering ;
    vc:enables ngm:technical-architecture-framework,
        ngm:technology-infrastructure ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:slug "systems-engineering" ;
    vc:sourceDomain "infrastructure" ;
    vc:standardizedBy ngm:open-standard ;
    vc:supports ngm:regulatory-compliance,
        ngm:robo-safety-and-standards ;
    vc:uses ngm:distributed-systems,
        ngm:software-engineering .

ngm:tactile-sensor a owl:Class ;
    rdfs:label "Tactile Sensor"@en ;
    rdfs:comment "A sensor embedded in a robot's end-effector or body surface that measures contact forces, pressure distributions, vibrations, and slip, enabling dexterous manipulation and safe physical interaction. Tactile sensing complements proprioception and vision to provide robots with fingertip-level awareness analogous to the human sense of touch."@en ;
    rdfs:subClassOf ngm:exteroceptive-sensor,
        ngm:robo-perception ;
    skos:broader ngm:robo-perception ;
    vc:enables ngm:robo-actuation-and-control ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:robo-perception ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:haptic-feedback,
        ngm:haptics,
        ngm:pressure-sensor,
        ngm:proprioceptive-sensor,
        ngm:proximity-sensor ;
    vc:slug "tactile-sensor" ;
    vc:sourceDomain "robotics" .

ngm:telecollaboration-domain a owl:Class ;
    rdfs:label "Telecollaboration Domain"@en ;
    rdfs:comment "The Telecollaboration Domain is the top-level knowledge domain encompassing technology-mediated collaboration, distributed teamwork, remote presence systems, and virtual cooperation platforms. It integrates synchronous and asynchronous collaboration modalities, telepresence technologies, and cross-domain bridges to AI, blockchain, metaverse, and robotics to enable effective human cooperation across geographical and temporal boundaries."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:dao-governance-for-telecollaboration ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:augmented-reality-collaboration ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:blockchain-collaboration ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:asynchronous-collaboration ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:collaboration-technology ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:distributed-collaboration ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:collaboration-platform ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:distributed-system ],
        ngm:dc-protocol-and-infra,
        ngm:technology-domain ;
    skos:broader ngm:dc-protocol-and-infra ;
    vc:enables ngm:digital-twin-collaboration,
        ngm:smart-contract-coordination ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:asynchronous-collaboration,
        ngm:augmented-reality-collaboration,
        ngm:blockchain-collaboration,
        ngm:collaboration-platform,
        ngm:dao-governance-for-telecollaboration,
        ngm:distributed-collaboration ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:dao-governance,
        ngm:distributed-computing ;
    vc:requires ngm:collaboration-technology,
        ngm:distributed-system ;
    vc:slug "telecollaboration-domain" ;
    vc:sourceDomain "distributed-collaboration" .

ngm:telecommunications a owl:Class ;
    rdfs:label "Telecommunications"@en ;
    rdfs:comment "Telecommunications is the sector and technical discipline concerned with the transmission of information — voice, data, and video — across distances through electronic, optical, or electromagnetic means, encompassing the physical infrastructure, protocols, standards, and regulatory frameworks that underpin global connectivity. It includes mobile and fixed-line networks, satellite systems, fibre optic backbones, and the software-defined and virtualised network functions that increasingly replace dedicated hardware."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:5-g-network ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:network-slicing ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:network-function-virtualization ],
        ngm:network-infrastructure ;
    vc:enables ngm:edge-computing,
        ngm:internet-of-things ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:5-g-network,
        ngm:network-function-virtualization,
        ngm:network-slicing ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:network-protocol,
        ngm:telecommunications-infrastructure ;
    vc:slug "telecommunications" ;
    vc:sourceDomain "infrastructure" .

ngm:telecommunications-infrastructure a owl:Class ;
    rdfs:label "Telecommunications Infrastructure"@en ;
    rdfs:comment "Telecommunications Infrastructure comprises the physical and logical systems — including fibre-optic networks, cellular base stations, satellite links, exchange points, and backbone routers — that carry digital communications at scale. It underpins latency-sensitive applications such as real-time rendering, telecollaboration, and edge AI by providing the transport layer on which higher-level protocols operate."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:bandwidth-adaptation ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:network-protocol ],
        ngm:infra-network-and-comms ;
    skos:broader ngm:infra-network-and-comms ;
    vc:enables ngm:remote-communication,
        ngm:telecollaboration,
        ngm:video-conferencing ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:bandwidth-adaptation,
        ngm:network-protocol ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:slug "telecommunications-infrastructure" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:content-delivery-network,
        ngm:latency-management-protocol .

ngm:testing-process a owl:Class ;
    rdfs:label "Testing Process"@en ;
    rdfs:comment "Systematic execution of verification and validation operations to detect faults, verify functionality, and ensure quality standards in metaverse systems and applications."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:security-testing ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:integration-testing ],
        ngm:quality-assurance,
        ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:enables ngm:compliance-verification,
        ngm:performance-optimization,
        ngm:quality-validation,
        ngm:risk-mitigation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:integration-testing,
        ngm:performance-testing,
        ngm:security-testing,
        ngm:unit-testing,
        ngm:user-acceptance-testing ;
    vc:isPartOf ngm:development-workflow,
