ngm:oecd a owl:Class ;
    rdfs:label "OECD"@en ;
    rdfs:comment "The OECD (Organisation for Economic Co-operation and Development) is an intergovernmental organisation founded in 1961, headquartered in Paris, comprising 38 member states committed to market economies and democratic governance. It produces comparative economic analysis, harmonised statistics, and binding and non-binding policy instruments spanning taxation, trade, education, digital policy, and emerging technology governance. Its AI Principles (2019) were the first intergovernmental standard for trustworthy artificial intelligence, and its Crypto-Asset Reporting Framework (CARF) extends automatic exchange of financial information to digital assets. OECD outputs exert normative influence through peer review, mutual recognition agreements, and adoption by broader multilateral bodies including the G20."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-sharing ],
        ngm:governance ;
    vc:bridgesTo ngm:ai-governance,
        ngm:blockchain-regulation,
        ngm:mi-ca ;
    vc:contrastsWith ngm:international-monetary-fund,
        ngm:world-trade-organization ;
    vc:enables ngm:corporate-tax-compliance-framework,
        ngm:trustworthy-ai ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:eu-ai-act-regulatory-instrument,
        ngm:fatf,
        ngm:financial-stability-board ;
    vc:requires ngm:data-sharing,
        ngm:multilateral-cooperation ;
    vc:slug "oecd" ;
    vc:sourceDomain "governance" ;
    vc:standardizedBy ngm:g20 ;
    vc:supports ngm:digital-economy,
        ngm:infra-legal-and-regulatory,
        ngm:open-government ;
    vc:uses ngm:peer-review,
        ngm:statistics .

ngm:off-chain-scaling a owl:Class ;
    rdfs:label "Off-Chain Scaling"@en ;
    rdfs:comment "Off-chain scaling is a class of blockchain scalability techniques that move transaction execution and state off the main chain while retaining its security as a settlement and dispute-resolution layer. By processing many interactions outside the base layer and committing only summaries or final balances on-chain, it greatly increases throughput and lowers fees. Examples include payment and state channels and various layer-2 constructions."@en ;
    rdfs:subClassOf ngm:bc-protocol-and-consensus ;
    skos:broader ngm:bc-protocol-and-consensus ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:payment-channel,
        ngm:state-channel ;
    vc:slug "off-chain-scaling" ;
    vc:sourceDomain "blockchain" .

ngm:offline-rendering a owl:Class ;
    rdfs:label "Offline Rendering"@en ;
    rdfs:comment "Offline rendering is the production of images or animation sequences where computation time per frame is not constrained to interactive rates, allowing each frame to take seconds, minutes, or hours to achieve maximum visual fidelity. It is the counterpart to real-time rendering and is typical of film, visual effects, and high-end visualisation, where physically based light transport such as path tracing is feasible. Offline rendering is commonly executed across render farms to parallelise the heavy computation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:parallel-computing ],
        ngm:computer-graphics ;
    vc:contrastsWith ngm:real-time-rendering ;
    vc:dependsOn ngm:gpu ;
    vc:enables ngm:film-production,
        ngm:visual-effects ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:computer-graphics ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:anti-aliasing,
        ngm:rendering-pipeline,
        ngm:texture-mapping ;
    vc:requires ngm:parallel-computing ;
    vc:slug "offline-rendering" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:visual-effects ;
    vc:uses ngm:global-illumination,
        ngm:path-tracing,
        ngm:ray-tracing .

ngm:omnichain-application a owl:Class ;
    rdfs:label "Omnichain Application"@en ;
    rdfs:comment "An omnichain application is a decentralised application designed to operate across multiple blockchain networks simultaneously, maintaining unified state, liquidity, and user identity without requiring users to bridge assets manually between chains. Unlike multi-chain applications that deploy isolated instances on separate chains, omnichain applications treat all supported networks as a single logical execution environment connected by cross-chain messaging protocols. LayerZero is the most widely adopted infrastructure enabling omnichain application patterns."@en ;
    rdfs:subClassOf ngm:decentralized-application ;
    vc:enables ngm:cross-chain-asset-transfer,
        ngm:de-fi ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:cross-chain-bridge ;
    vc:slug "omnichain-application" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:blockchain-interoperability,
        ngm:cross-chain-interoperability,
        ngm:cross-chain-messaging .

ngm:on-chain-mrv a owl:Class ;
    rdfs:label "On-Chain MRV"@en ;
    rdfs:comment "On-Chain MRV (Measurement, Reporting, and Verification) is the practice of recording carbon and environmental impact data directly on a blockchain to create tamper-evident, auditable proof of climate actions. It combines sensor data, satellite imagery, and oracle feeds with on-chain attestations so that carbon credits and sustainability claims can be independently verified. By anchoring MRV data to an immutable ledger, it reduces double-counting and greenwashing in voluntary and compliance carbon markets."@en ;
    rdfs:subClassOf ngm:sustainability ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:green-blockchain-initiatives ;
    vc:slug "on-chain-mrv" ;
    vc:sourceDomain "blockchain" .

ngm:on-chain-settlement a owl:Class ;
    rdfs:label "On Chain Settlement"@en ;
    rdfs:comment "On chain settlement is the process by which the transfer of value or assets between parties is recorded directly on a distributed ledger and becomes economically irreversible according to the ledger's consensus rules. Unlike off-chain or netting arrangements that defer ledger updates, on chain settlement writes each transaction's final state into the canonical chain, removing the need for a trusted central clearing intermediary. Settlement is considered complete once the relevant transaction attains the chain's finality guarantee, after which reversal requires violating consensus. It underpins payment, securities, and decentralised finance flows on public and permissioned blockchains."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gas-fee ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:blockchain ],
        ngm:settlement-finality ;
    vc:contrastsWith ngm:rollup ;
    vc:dependsOn ngm:consensus-mechanism,
        ngm:settlement-finality ;
    vc:enables ngm:decentralized-finance,
        ngm:tokenization ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:digital-asset,
        ngm:payment-rail,
        ngm:transaction-throughput ;
    vc:requires ngm:blockchain,
        ngm:gas-fee ;
    vc:slug "on-chain-settlement" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:distributed-ledger,
        ngm:smart-contract,
        ngm:stablecoin .

ngm:onnx-operator-set a owl:Class ;
    rdfs:label "ONNX Operator Set"@en ;
    rdfs:comment "An ONNX operator set is a versioned collection of the computational operators defined by the Open Neural Network Exchange format, fixing the operators and their semantics that a model may use."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:onnx ],
        ngm:onnx ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:onnx ;
    vc:slug "onnx-operator-set" ;
    vc:sourceDomain "machine-learning" .

ngm:onnx-standard a owl:Class ;
    rdfs:label "ONNX Standard"@en ;
    rdfs:comment "The ONNX standard defines an open format for representing machine learning models as a computation graph of typed operators, enabling models to move between training and inference frameworks."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:onnx ],
        ngm:machine-learning-discipline ;
    vc:enables ngm:deep-learning ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:onnx ;
    vc:slug "onnx-standard" ;
    vc:sourceDomain "metaverse" .

ngm:ontology-definition a owl:Class ;
    rdfs:label "Ontology Definition"@en ;
    rdfs:comment "A formal, explicit specification of metaverse concepts, relationships, and axioms using knowledge representation frameworks (OWL, RDF, JSON-LD), defining entities through orthogonal dimensions (physicality, role) to enable semantic interoperability and automated classification across platforms. Ontologies provide foundational standards for governance, identity, and asset management, supporting machine-readable reasoning, validation, and discovery across federated and distributed systems."@en ;
    rdfs:subClassOf ngm:infra-software-engineering ;
    skos:broader ngm:infra-software-engineering ;
    vc:enables ngm:data-governance,
        ngm:interoperability,
        ngm:knowledge-graph ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:slug "ontology-definition" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:identity-management,
        ngm:metaverse-ontology ;
    vc:uses ngm:knowledge-representation,
        ngm:semantic-web-linked-data-standard .

ngm:open-container-initiative a owl:Class ;
    rdfs:label "Open Container Initiative"@en ;
    rdfs:comment "The Open Container Initiative (OCI) is an open governance structure under the Linux Foundation that produces vendor-neutral specifications for container formats and runtimes. Its core deliverables are the image specification, the runtime specification, and the distribution specification, which together standardise how container images are built, distributed, and executed. By defining these contracts, the OCI guarantees interoperability and portability across the container ecosystem."@en ;
    rdfs:subClassOf ngm:standards ;
    vc:bridgesTo ngm:cncf ;
    vc:dependsOn ngm:kubernetes ;
    vc:enables ngm:interoperability,
        ngm:portability ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:standards ;
    vc:isPartOf ngm:cloud-native ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:infrastructure,
        ngm:microservices ;
    vc:slug "open-container-initiative" ;
    vc:sourceDomain "infrastructure" ;
    vc:standardizedBy ngm:linux-foundation ;
    vc:supports ngm:container,
        ngm:container-runtime ;
    vc:uses ngm:open-source .

ngm:open-governance a owl:Class ;
    rdfs:label "Open Governance"@en ;
    rdfs:comment "Open governance is a model of decision-making for projects, standards and organisations in which processes are transparent, participation is open and authority is distributed among stakeholders. It emphasises published rules, accountable roles and consensus-driven decisions rather than closed or unilateral control. It is common in open-source communities, standards bodies and multi-stakeholder institutions."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:transparency ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:accountability ],
        ngm:open-source-governance ;
    vc:bridgesTo ngm:standards-body ;
    vc:dependsOn ngm:governance-framework ;
    vc:enables ngm:transparent-decision-making ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:collective-governance,
        ngm:decision-making ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:multi-stakeholder-governance,
        ngm:open-source-governance ;
    vc:requires ngm:accountability,
        ngm:transparency ;
    vc:slug "open-governance" ;
    vc:sourceDomain "standards" ;
    vc:supports ngm:community-governance,
        ngm:open-standards ;
    vc:uses ngm:consensus,
        ngm:stakeholder-engagement .

ngm:open-id4-vc a owl:Class ;
    rdfs:label "OpenID4VC"@en ;
    rdfs:comment "OpenID for Verifiable Credentials (OpenID4VC) is a family of OpenID Foundation specifications that extend OAuth 2.0 and OpenID Connect to issue and present verifiable credentials. It comprises OpenID4VCI for credential issuance and OpenID4VP for presentation, enabling interoperable digital wallets to obtain and selectively disclose cryptographically signed claims. The protocols bridge mainstream identity infrastructure with decentralized identity models such as DIDs."@en ;
    rdfs:subClassOf ngm:digital-identity ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:decentralized-identifiers,
        ngm:verifiable-credentials ;
    vc:slug "open-id4-vc" ;
    vc:sourceDomain "security" .

ngm:open-metaverse-interoperability a owl:Class ;
    rdfs:label "Open Metaverse Interoperability"@en ;
    rdfs:comment "Open metaverse interoperability is the principle and set of open standards enabling users, avatars, digital assets, and identities to move freely across independently operated virtual worlds and platforms without proprietary lock-in. It depends on shared formats for 3D content, portable avatar and identity descriptions, and common protocols for asset provenance and transport. Driven by bodies such as the Metaverse Standards Forum and the Khronos Group, it aims to make the metaverse a federated network of interoperable spaces rather than a collection of isolated walled gardens."@en ;
    rdfs:subClassOf ngm:interoperability ;
    vc:bridgesTo ngm:spatial-computing ;
    vc:dependsOn ngm:gl-tf,
        ngm:identity-portability,
        ngm:usd ;
    vc:enables ngm:cross-platform,
        ngm:data-portability,
        ngm:portability ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:implements ngm:interoperability-standard,
        ngm:open-standards ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:digital-twin,
        ngm:semantic-interoperability ;
    vc:slug "open-metaverse-interoperability" ;
    vc:sourceDomain "metaverse" ;
    vc:standardizedBy ngm:khronos-group,
        ngm:metaverse-standards-forum ;
    vc:supports ngm:virtual-world ;
    vc:uses ngm:avatar,
        ngm:digital-asset,
        ngm:web-xr .

ngm:open-metaverse-interoperability-group a owl:Class ;
    rdfs:label "Open Metaverse Interoperability Group"@en ;
    rdfs:comment "The Open Metaverse Interoperability Group (OMI) is a community-driven body that develops open protocols and schemas for moving identity, avatars, and virtual objects between independent virtual worlds. It produces specifications for portable avatars, glTF extensions, and cross-platform identity so that metaverse experiences are not locked into single proprietary platforms. Its work aims to make virtual environments composable and interoperable rather than walled gardens."@en ;
    rdfs:subClassOf ngm:sc-standards-and-interop ;
    skos:broader ngm:sc-standards-and-interop ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:vircadia ;
    vc:slug "open-metaverse-interoperability-group" ;
    vc:sourceDomain "metaverse" .

ngm:open-source-sustainability a owl:Class ;
    rdfs:label "Open Source Sustainability"@en ;
    rdfs:comment "Open source sustainability concerns the long-term viability of freely available software projects, addressing how maintainers are funded, how contributor effort is sustained, and how critical dependencies are kept secure and maintained. It examines the mismatch between the widespread reliance on open source infrastructure and the scarce, often volunteer, resources behind it. Funding mechanisms such as grants, quadratic funding, and retroactive public-goods funding attempt to close this gap."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:governance ],
        ngm:open-source-software ;
    vc:bridgesTo ngm:retroactive-public-goods-funding ;
    vc:dependsOn ngm:quadratic-funding,
        ngm:retroactive-public-goods-funding ;
    vc:enables ngm:open-source,
        ngm:open-source-software ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:open-source-software ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:community-governance,
        ngm:governance,
        ngm:open-source ;
    vc:requires ngm:governance ;
    vc:slug "open-source-sustainability" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:community-governance,
        ngm:open-source-software ;
    vc:uses ngm:quadratic-funding,
        ngm:retroactive-public-goods-funding .

ngm:open-zeppelin-governor-contracts a owl:Class ;
    rdfs:label "OpenZeppelin Governor Contracts"@en ;
    rdfs:comment "OpenZeppelin Governor Contracts are a modular on-chain governance framework that lets DAOs run proposal, voting, and execution workflows tied to governance tokens. The Governor base contract integrates with token-based voting power (including delegation and timelock execution) and is configurable for quorum, voting periods, and vote-counting strategies. It is a widely adopted standard for implementing token-weighted decentralized governance."@en ;
    rdfs:subClassOf ngm:smart-contract ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:delegate-democracy,
        ngm:governance-token ;
    vc:slug "open-zeppelin-governor-contracts" ;
    vc:sourceDomain "blockchain" .

ngm:optical-sensors a owl:Class ;
    rdfs:label "Optical Sensors"@en ;
    rdfs:comment "Optical Sensors are devices that detect and convert light, across visible, infrared, or other wavelengths, into electrical signals for measurement or imaging. They include cameras, photodiodes, depth sensors, and structured-light or time-of-flight units used to capture scene geometry and motion. In capture and recognition systems they provide the primary visual input from which 3D structure, pose, and identity are inferred."@en ;
    rdfs:subClassOf ngm:sensor ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:digital-performance-capture,
        ngm:human-capture-and-recognition ;
    vc:slug "optical-sensors" ;
    vc:sourceDomain "robotics" .

ngm:optimistic-governance a owl:Class ;
    rdfs:label "Optimistic Governance"@en ;
    rdfs:comment "Optimistic Governance is a DAO decision-making pattern in which proposals are assumed approved and can execute unless challenged within a defined dispute window. It reduces voting fatigue and gas costs by requiring active participation only to veto or contest actions rather than to ratify every routine decision. Disputes are resolved by escalation to a vote or an arbitration mechanism, trading some upfront scrutiny for operational efficiency."@en ;
    rdfs:subClassOf ngm:bc-governance-and-regulation ;
    skos:broader ngm:bc-governance-and-regulation ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:decentralized-governance,
        ngm:governance-token ;
    vc:slug "optimistic-governance" ;
    vc:sourceDomain "blockchain" .

ngm:organisational-resilience a owl:Class ;
    rdfs:label "Organisational Resilience"@en ;
    rdfs:comment "Organisational resilience is the capacity of an organisation to anticipate, prepare for, respond to and adapt to incremental change and sudden disruptions in order to survive and prosper. It integrates risk management, business continuity, crisis response and adaptive capacity into a coherent governance posture. Unlike narrow continuity planning, it emphasises learning, flexibility and the ability to emerge stronger from adversity."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:disaster-recovery ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:incident-response ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:operational-resilience ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:risk-management ],
        ngm:resilience ;
    vc:dependsOn ngm:governance-framework ;
    vc:enables ngm:business-continuity ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:disaster-recovery,
        ngm:operational-resilience ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:change-management,
        ngm:compliance,
        ngm:governance-framework,
        ngm:risk-management ;
    vc:requires ngm:incident-response,
        ngm:risk-management ;
    vc:slug "organisational-resilience" ;
    vc:sourceDomain "governance" ;
    vc:supports ngm:business-continuity,
        ngm:disaster-recovery,
        ngm:operational-resilience ;
    vc:uses ngm:incident-response .

ngm:owasp-llm-top-10-2025 a owl:Class ;
    rdfs:label "OWASP LLM Top 10 2025"@en ;
    rdfs:comment "The OWASP LLM Top 10 2025 is the updated edition of OWASP's ranked list of the most critical security risks for applications built on large language models. It catalogs threats such as prompt injection, sensitive information disclosure, supply-chain vulnerabilities, excessive agency, and improper output handling, with guidance on mitigation. The list is a widely referenced baseline for securing LLM and agentic AI systems."@en ;
    rdfs:subClassOf ngm:ai-safety ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:agents,
        ngm:computer-use-and-browser-agents ;
    vc:slug "owasp-llm-top-10-2025" ;
    vc:sourceDomain "security" .

ngm:ownership-token a owl:Class ;
    rdfs:label "Ownership Token"@en ;
    rdfs:comment "An Ownership Token is a blockchain token that represents and confers title to an underlying asset, whether digital or real-world. Typically implemented as a non-fungible or semi-fungible token, holding it in a wallet constitutes provable control of the represented item, and transferring it transfers ownership. Ownership tokens enable trading, collateralization, and programmable rights over digital goods and tokenized property."@en ;
    rdfs:subClassOf ngm:digital-asset ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:digital-goods,
        ngm:digital-real-estate ;
    vc:slug "ownership-token" ;
    vc:sourceDomain "blockchain" .

ngm:packet-loss-recovery a owl:Class ;
    rdfs:label "Packet Loss Recovery"@en ;
    rdfs:comment "Techniques used to recover from or mitigate the loss of data packets during transmission over a network. They include retransmission, forward error correction, and concealment of missing data."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:forward-error-correction ],
        ngm:network-protocol ;
    vc:enables ngm:video-streaming ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:forward-error-correction ;
    vc:slug "packet-loss-recovery" ;
    vc:sourceDomain "infrastructure" .

ngm:parametric-design-methodology a owl:Class ;
    rdfs:label "Parametric Design Methodology"@en ;
    rdfs:comment "A design methodology in which objects, environments, or behaviours are specified through adjustable parameters rather than fixed geometry, enabling variant generation and real-time adaptation. In metaverse and spatial computing contexts, parametric approaches underpin voice-and-text-driven CAD primitive creation, procedural content generation, and digital twin model customisation within shared virtual workspaces."@en ;
    rdfs:subClassOf ngm:infra-computing-and-cloud ;
    skos:broader ngm:infra-computing-and-cloud ;
    vc:enables ngm:digital-twin,
        ngm:procedural-generation ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:rendering-engine,
        ngm:spatial-computing ;
    vc:slug "parametric-design-methodology" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:parametric-design-methodology-modeling,
        ngm:procedural-content-generation .

ngm:paris-agreement-article-6 a owl:Class ;
    rdfs:label "Paris Agreement Article 6"@en ;
    rdfs:comment "Paris Agreement Article 6 is the provision of the 2015 Paris Agreement that establishes mechanisms for countries to cooperate in meeting emissions-reduction targets, including international transfer of mitigation outcomes and a centralized crediting market. It defines accounting rules to prevent double-counting when carbon reductions are traded between parties. Article 6 provides the international legal basis for cross-border carbon markets and corresponding adjustments."@en ;
    rdfs:subClassOf ngm:regulatory-compliance ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:carbon-credit-tracking ;
    vc:slug "paris-agreement-article-6" ;
    vc:sourceDomain "governance" .

ngm:participant-consent a owl:Class ;
    rdfs:label "Participant Consent"@en ;
    rdfs:comment "Participant Consent is the explicit, informed agreement obtained from individuals before their voice, image, or data are recorded or processed. In meeting and communication contexts it is both an ethical norm and a legal requirement under many wiretapping and data-protection regimes, often necessitating clear notice and an opportunity to decline. Capturing and recording consent state is a prerequisite for lawful recording and downstream processing."@en ;
    rdfs:subClassOf ngm:regulatory-compliance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:meeting-recording ;
    vc:slug "participant-consent" ;
    vc:sourceDomain "governance" .

ngm:participant-coordination a owl:Class ;
    rdfs:label "Participant Coordination"@en ;
    rdfs:comment "The synchronization and management of multiple users interacting within shared virtual environments, requiring real-time pose tracking, coordinate system alignment, and collaborative state management to enable seamless multi-user experiences."@en ;
    rdfs:subClassOf ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:bridgesTo ngm:multi-user-systems ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:slug "participant-coordination" ;
    vc:sourceDomain "spatial-computing" .

ngm:participation-framework a owl:Class ;
    rdfs:label "Participation Framework"@en ;
    rdfs:comment "A structured approach to designing stakeholder engagement processes that establish goals, principles, mods, and mechanisms for involving citizens, communities, or users in decision-making, governance, and collaborative activities."@en ;
    rdfs:subClassOf ngm:sc-governance-and-safety ;
    skos:broader ngm:sc-governance-and-safety ;
    vc:bridgesTo ngm:governance-framework ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:slug "participation-framework" ;
    vc:sourceDomain "spatial-computing" .

ngm:participatory-policy-making a owl:Class ;
    rdfs:label "Participatory Policy Making"@en ;
    rdfs:comment "A governance approach that involves citizens and stakeholders directly in the formulation, design, and eof public policies through mechanisms such as citizen advisory boards, deliberative assemblies, and digital participation platforms."@en ;
    rdfs:subClassOf ngm:sc-governance-and-safety ;
    skos:broader ngm:sc-governance-and-safety ;
    vc:bridgesTo ngm:democratic-governance ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:slug "participatory-policy-making" ;
    vc:sourceDomain "spatial-computing" .

ngm:password-hashing a owl:Class ;
    rdfs:label "Password Hashing"@en ;
    rdfs:comment "Password hashing is the practice of transforming user passwords into fixed-length irreversible digests before storage, so that a breach of the credential store does not directly reveal the underlying secrets. Secure schemes deliberately use slow, memory-hard functions combined with a unique per-user salt to defeat precomputation and brute-force attacks. Established algorithms such as Argon2, scrypt, bcrypt and PBKDF2 expose tunable cost parameters that can be raised as hardware improves. Password hashing is a specialised application of key derivation functions oriented towards verifying human-chosen secrets."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:random-number-generation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:entropy ],
        ngm:key-derivation-function ;
    vc:bridgesTo ngm:authentication ;
    vc:contrastsWith ngm:symmetric-encryption ;
    vc:dependsOn ngm:cryptographic-hash-function ;
    vc:enables ngm:authentication ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:key-derivation-function ;
    vc:isPartOf ngm:security ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:key-derivation-function,
        ngm:symmetric-encryption ;
    vc:requires ngm:entropy,
        ngm:random-number-generation ;
    vc:slug "password-hashing" ;
    vc:sourceDomain "security" ;
    vc:supports ngm:authentication,
        ngm:authentication-protocol ;
    vc:uses ngm:cryptographic-hash-function,
        ngm:pseudorandom-function .

ngm:patch-embedding a owl:Class ;
    rdfs:label "Patch Embedding"@en ;
    rdfs:comment "Patch embedding is the mechanism by which a Vision Transformer (ViT) converts a 2D image into a sequence of fixed-size vector representations suitable for processing by a self-attention mechanism. The image is divided into non-overlapping rectangular patches; each patch is flattened and projected to a latent dimension via a learnable linear transformation, yielding a sequence of token embeddings analogous to word embeddings in language models. Positional embeddings are added to encode spatial location, and a classification token is prepended to aggregate global information."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:embedding-layer ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:transformer ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:self-attention ],
        ngm:machine-learning ;
    vc:contrastsWith ngm:convolutional-feature-extraction ;
    vc:enables ngm:image-classification,
        ngm:object-detection,
        ngm:visual-question-answering ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:classification-token,
        ngm:embedding-layer,
        ngm:image-patch ;
    vc:isPartOf ngm:vision-transformer ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:convolutional-neural-network,
        ngm:image-tokenisation,
        ngm:token-generation ;
    vc:requires ngm:self-attention,
        ngm:transformer ;
    vc:slug "patch-embedding" ;
    vc:sourceDomain "machine-learning" ;
    vc:supports ngm:multimodal-learning,
        ngm:transfer-learning ;
    vc:uses ngm:linear-projection,
        ngm:positional-encoding,
        ngm:vision-transformer .

ngm:pathology-ai a owl:Class ;
    rdfs:label "Pathology AI"@en ;
    rdfs:comment "Artificial intelligence systems for automated analysis of histopathology slides, cytology specimens, and other pathological images. Pathology AI performs tasks including cancer detection and grading, biomarker quantification, and morphological analysis using whole-slide imaging pipelines and deep learning architectures tailored for gigapixel images at multi-scale resolution."@en ;
    rdfs:subClassOf ngm:ai-application,
        ngm:medical-imaging-ai ;
    skos:broader ngm:ai-application ;
    vc:dependsOn ngm:image-segmentation ;
    vc:enables ngm:medical-ai ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:healthcare-analytics,
        ngm:radiology-ai ;
    vc:slug "pathology-ai" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:computer-vision,
        ngm:deep-learning .

ngm:payment-token a owl:Class ;
    rdfs:label "Payment Token"@en ;
    rdfs:comment "A Payment Token is a cryptocurrency token whose primary purpose is to serve as a medium of exchange and store of value for peer-to-peer and merchant payments, distinguished from utility tokens (access rights) and security tokens (equity/asset claims). Examples include Bitcoin, Litecoin, and CBDC-backed digital currencies."@en ;
    rdfs:subClassOf ngm:bc-token-and-asset,
        ngm:cryptocurrency-token ;
    skos:broader ngm:bc-token-and-asset ;
    vc:contrastsWith ngm:governance-token,
        ngm:stablecoin,
        ngm:utility-token ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:decentralized-finance-de-fi ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:cbdcs,
        ngm:cryptocurrency,
        ngm:digital-currency,
        ngm:lightning-network,
        ngm:tokenomics,
        ngm:transaction-fee ;
    vc:slug "payment-token" ;
    vc:sourceDomain "blockchain" .

ngm:peer-learning a owl:Class ;
    rdfs:label "Peer Learning"@en ;
    rdfs:comment "Peer learning refers to settings where multiple agents improve by exchanging information or imitating each other rather than relying on a central teacher. In multi-agent systems it covers cooperative protocols for sharing experience."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:collaborative-systems-modality-learning ],
        ngm:collaborative-systems-modality-learning ;
    vc:enables ngm:knowledge-sharing,
        ngm:multi-agent-coordination ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:collaborative-systems-modality-learning ;
    vc:slug "peer-learning" ;
    vc:sourceDomain "machine-learning" .

ngm:peer-to-peer-payment a owl:Class ;
    rdfs:label "Peer To Peer Payment"@en ;
    rdfs:comment "Peer-to-peer payment is the direct transfer of monetary value between two parties without a traditional intermediary settling each side of the transaction. In cryptocurrency systems it is realised by signing a transaction that reassigns ownership of digital tokens on a shared ledger, validated by network consensus rather than a bank. The model reduces reliance on centralised clearing and enables programmable, near-instant value exchange."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:settlement ],
        ngm:blockchain ;
    skos:broader ngm:blockchain ;
    vc:bridgesTo ngm:cbdcs,
        ngm:stablecoin ;
    vc:contrastsWith ngm:custody ;
    vc:dependsOn ngm:cryptocurrency ;
    vc:enables ngm:digital-payments,
        ngm:remittances ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:settlement ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:digital-payments,
        ngm:settlement ;
    vc:requires ngm:settlement ;
    vc:slug "peer-to-peer-payment" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:de-fi,
        ngm:mobile-payment ;
    vc:uses ngm:cryptocurrency,
        ngm:smart-contract .

ngm:peerto-peer-protocol a owl:Class ;
    rdfs:label "Peerto Peer Protocol"@en ;
    rdfs:comment "Peerto Peer Protocol is a blockchain concept."@en ;
    rdfs:subClassOf ngm:bc-protocol-and-consensus ;
    skos:broader ngm:bc-protocol-and-consensus ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:implements ngm:blockchain ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:slug "peerto-peer-protocol" ;
    vc:sourceDomain "blockchain" .

ngm:peg a skos:Concept ;
    rdfs:label "Peg"@en .

ngm:permissioned-network a owl:Class ;
    rdfs:label "Permissioned Network"@en ;
    rdfs:comment "A Permissioned Network is a distributed ledger architecture in which participation—whether as a validator, transaction submitter, or read-only observer—is restricted to entities that have been explicitly authorised by a governing body or membership protocol. Unlike public blockchains, nodes must satisfy identity verification, legal agreement, or technical credentialing requirements before joining, enabling stronger privacy guarantees, higher throughput, and deterministic finality than open networks while sacrificing censorship resistance. Permissioned networks are the dominant choice for enterprise and consortium deployments such as trade finance, healthcare data exchange, and central-bank digital currency infrastructure."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:validator-node ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:identity-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:access-control ],
        ngm:bc-network-component,
        ngm:blockchain-entity,
        ngm:network-component ;
    skos:broader ngm:bc-network-component ;
    vc:contrastsWith ngm:public-blockchain ;
    vc:enables ngm:blockchain-compliance,
        ngm:blockchain-governance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:validator-node ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:blockchain-interoperability,
        ngm:distributed-ledger-technology,
        ngm:private-blockchain ;
    vc:requires ngm:access-control,
        ngm:identity-management ;
    vc:slug "permissioned-network" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:consensus-mechanism,
        ngm:smart-contract .

ngm:persistent-identifier a owl:Class ;
    rdfs:label "Persistent Identifier"@en ;
    rdfs:comment "A persistent identifier (PID) is a long-lasting, globally unique reference to a digital object that remains stable even as the object's location or custodian changes. PIDs such as DOIs, Handles, and ARKs are resolved through a managed indirection service that maps the identifier to current metadata and access endpoints. They are foundational to citation, provenance, and interoperability in scholarly and digital-object infrastructure."@en ;
    rdfs:subClassOf ngm:infra-data-management ;
    skos:broader ngm:infra-data-management ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:digital-objects ;
    vc:slug "persistent-identifier" ;
    vc:sourceDomain "data" .

ngm:persona a owl:Class ;
    rdfs:label "Persona"@en ;
    rdfs:comment "A persona is a defined personality, role, and behavioural profile assigned to a conversational AI to shape its tone, knowledge framing, and interaction style. It encodes traits such as voice, expertise, boundaries, and goals, often via system prompts, so that responses stay consistent and aligned with a product's intent. Personas make chatbots feel coherent and purposeful rather than generic."@en ;
    rdfs:subClassOf ngm:ai-application ;
    skos:broader ngm:ai-application ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:chatbots ;
    vc:slug "persona" ;
    vc:sourceDomain "ai" .

ngm:personal-assistance a owl:Class ;
    rdfs:label "Personal Assistance"@en ;
    rdfs:comment "Personal assistance is an AI application class in which an agent helps an individual accomplish everyday tasks such as scheduling, information lookup, communication, and device or browser control. It combines natural-language understanding with tool use and memory to act on the user's behalf within their personal context. Modern personal assistants increasingly automate multi-step workflows rather than only answering questions."@en ;
    rdfs:subClassOf ngm:ai-application ;
    skos:broader ngm:ai-application ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:agents,
        ngm:computer-use-and-browser-agents ;
    vc:slug "personal-assistance" ;
    vc:sourceDomain "ai" .

ngm:personalized-experiences a owl:Class ;
    rdfs:label "Personalized Experiences"@en ;
    rdfs:comment "Personalized experiences are interactions, content, or services dynamically tailored to an individual's preferences, history, and context. They are produced by models that infer user intent and situation from behavioural signals and contextual data, then adapt recommendations, interfaces, or responses accordingly. Personalization aims to increase relevance and engagement while balancing privacy and the risk of filter bubbles."@en ;
    rdfs:subClassOf ngm:ai-application ;
    skos:broader ngm:ai-application ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:ai-machine-learning,
        ngm:context-awareness ;
    vc:slug "personalized-experiences" ;
    vc:sourceDomain "ai" .

ngm:phase-transition a owl:Class ;
    rdfs:label "Phase Transition"@en ;
    rdfs:comment "A phase transition is a qualitative, often abrupt, change in the macroscopic behaviour of a system as a control parameter crosses a critical threshold. Originating in statistical physics to describe transformations such as freezing or magnetisation, the concept is now applied to complex and learning systems where a small change in scale, data, or connectivity produces a discontinuous jump in capability. It is closely associated with emergence and critical phenomena."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:scaling-laws ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:complex-systems ],
        ngm:complex-systems ;
    vc:contrastsWith ngm:self-organisation ;
    vc:dependsOn ngm:thermodynamics ;
    vc:enables ngm:emergence,
        ngm:emergent-capabilities ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:scaling-laws ;
    vc:isPartOf ngm:complex-systems ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:deep-learning,
        ngm:emergence,
        ngm:emergent-capabilities,
        ngm:large-language-model,
        ngm:scaling-laws,
        ngm:self-organisation ;
    vc:requires ngm:complex-systems ;
    vc:slug "phase-transition" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:emergent-capabilities,
        ngm:resilience ;
    vc:uses ngm:chaos-theory .

ngm:phishing-resistant-authentication a owl:Class ;
    rdfs:label "Phishing Resistant Authentication"@en ;
    rdfs:comment "Phishing-resistant authentication is a class of authentication methods designed so that credentials cannot be captured and replayed by an attacker who tricks a user into interacting with a fraudulent site or relay. It achieves this primarily through public-key cryptography combined with origin binding, so that a credential is cryptographically tied to the legitimate service's domain and will not authenticate to an impostor. FIDO2/WebAuthn passkeys and hardware security keys are the canonical implementations, replacing shared secrets such as passwords and one-time codes that remain vulnerable to interception."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:key-generation ],
        ngm:authentication ;
    vc:contrastsWith ngm:passwordless-authentication ;
    vc:dependsOn ngm:elliptic-curve-cryptography ;
    vc:enables ngm:passwordless-authentication ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:implements ngm:multi-factor-authentication,
        ngm:public-key-cryptography ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:nonce ;
    vc:requires ngm:key-generation ;
    vc:slug "phishing-resistant-authentication" ;
    vc:sourceDomain "security" ;
    vc:standardizedBy ngm:fido-alliance ;
    vc:supports ngm:authentication ;
    vc:uses ngm:authentication,
        ngm:digital-signature,
        ngm:fido2 .

ngm:phoenix-wallet a owl:Class ;
    rdfs:label "Phoenix Wallet"@en ;
    rdfs:comment "Phoenix is a non-custodial Bitcoin Lightning wallet developed by ACINQ, the team behind the Eclair implementation, that automates channel management so that users experience Lightning payments without manually opening or balancing channels. It keeps users in self-custody of their keys while abstracting liquidity provisioning, on-the-fly channel creation, and fee handling, making the Lightning Network accessible to non-technical mobile users."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:bitcoin ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:wallet ],
        ngm:non-custodial-wallet ;
    vc:contrastsWith ngm:cryptocurrency-exchange ;
    vc:dependsOn ngm:eclair ;
    vc:enables ngm:self-custody ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:wallet ;
    vc:implements ngm:non-custodial-wallet ;
    vc:isPartOf ngm:lightning-network ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:acinq,
        ngm:eclair ;
    vc:requires ngm:bitcoin ;
    vc:slug "phoenix-wallet" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:lightning-network,
        ngm:self-custody ;
    vc:uses ngm:lightning-network .

ngm:photorealism a owl:Class ;
    rdfs:label "Photorealism"@en ;
    rdfs:comment "Photorealism is the goal and quality of producing synthetic imagery that is visually indistinguishable from a photograph of a real scene. In computer graphics it is pursued through physically based rendering, accurate light transport such as global illumination and ray tracing, high-fidelity material models, and careful post-processing including tone mapping and colour grading. Achieving photorealism requires faithful simulation of how light interacts with surfaces, volumes, and the camera, and it underpins applications from visual effects and architectural visualisation to immersive virtual environments and synthetic training data."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:physically-based-rendering ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:global-illumination ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ray-tracing ],
        ngm:rendering ;
    vc:dependsOn ngm:gpu-rendering ;
    vc:enables ngm:virtual-production,
        ngm:visual-effects ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:computer-graphics ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:colour-grading,
        ngm:post-processing,
        ngm:tone-mapping ;
    vc:requires ngm:global-illumination,
        ngm:physically-based-rendering,
        ngm:ray-tracing ;
    vc:slug "photorealism" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:film-production ;
    vc:uses ngm:hdr,
        ngm:shader,
        ngm:texture-mapping .

ngm:photorealistic-telepresence a owl:Class ;
    rdfs:label "Photorealistic Telepresence"@en ;
    rdfs:comment "Photorealistic telepresence is remote real-time communication in which participants appear as lifelike, volumetrically accurate representations rather than video tiles or stylised avatars. It reconstructs a person's appearance and motion using techniques such as neural avatars and 3D Gaussian splatting, rendering them convincingly in a shared spatial scene. The goal is a sense of co-presence that closely matches being physically together."@en ;
    rdfs:subClassOf ngm:dc-telepresence ;
    skos:broader ngm:dc-telepresence ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:3-d-gaussian-splatting,
        ngm:ai-avatars ;
    vc:slug "photorealistic-telepresence" ;
    vc:sourceDomain "metaverse" .

ngm:pkce a owl:Class ;
    rdfs:label "Pkce"@en ;
    rdfs:comment "PKCE, Proof Key for Code Exchange, is an extension to the OAuth 2.0 authorisation code flow that protects public clients, such as mobile and single-page applications, against interception of the authorisation code. The client generates a secret code verifier and sends its hashed code challenge when requesting authorisation, then proves possession of the verifier when redeeming the code, so a stolen code cannot be exchanged for tokens. It is now recommended for all OAuth clients, not only public ones."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:encryption ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:token ],
        ngm:oauth-2-0 ;
    vc:bridgesTo ngm:identity-provider ;
    vc:contrastsWith ngm:bearer-token ;
    vc:dependsOn ngm:oauth ;
    vc:enables ngm:authentication ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:token ;
    vc:implements ngm:authorization ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:access-token,
        ngm:authorization,
        ngm:oauth,
        ngm:refresh-token ;
    vc:requires ngm:encryption ;
    vc:slug "pkce" ;
    vc:sourceDomain "infrastructure" ;
    vc:standardizedBy ngm:standards ;
    vc:supports ngm:single-sign-on ;
    vc:uses ngm:authorization,
        ngm:oauth-2-0 .

ngm:plan-and-execute a owl:Class ;
    rdfs:label "Plan and Execute"@en ;
    rdfs:comment "Plan and execute is an agentic reasoning strategy in which an LLM-based agent first generates a multi-step plan for a task and then carries out each step, optionally re-planning when steps fail or new information appears. Separating planning from execution improves coherence on long-horizon tasks compared with purely reactive, single-step prompting. It is a common control pattern for autonomous and computer-use agents."@en ;
    rdfs:subClassOf ngm:ai-agent-system ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:agents,
        ngm:computer-use-and-browser-agents ;
    vc:slug "plan-and-execute" ;
    vc:sourceDomain "ai" .

ngm:player-agency a owl:Class ;
    rdfs:label "Player Agency"@en ;
    rdfs:comment "Player agency is the degree to which a participant's choices meaningfully shape the state, narrative, and outcomes of an interactive virtual experience. High agency means decisions have consequential, non-trivial effects rather than cosmetic ones, giving players authorship over their path through the world. It is a core design value of open-world and non-linear interactive systems."@en ;
    rdfs:subClassOf ngm:sc-interaction ;
    skos:broader ngm:sc-interaction ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:non-linear-narrative,
        ngm:open-world ;
    vc:slug "player-agency" ;
    vc:sourceDomain "metaverse" .

ngm:player-two a owl:Class ;
    rdfs:label "Player Two"@en ;
    rdfs:comment "Player Two is a decentralised AI-character and collaborative storytelling platform combining Nostr-relay messaging, BIP85 key derivation, and generative AI workflows. It enables trustless group interactions with AI-driven waifu characters, token-gated access, and a robot project with on-device edge compute for the ED3N distributed network."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:player-two-platform-implementation ],
        ngm:collaboration-platform,
        ngm:infra-software-engineering ;
    skos:broader ngm:infra-software-engineering ;
    vc:dependsOn ngm:cryptography,
        ngm:decentralised-identity ;
    vc:enables ngm:identity-management,
        ngm:player-tracking ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:player-two-platform-implementation ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:slug "player-two" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:ai-video,
        ngm:generative-ai .

ngm:pneumatic-cylinder a owl:Class ;
    rdfs:label "Pneumatic Cylinder"@en ;
    rdfs:comment "A pneumatic cylinder is a mechanical actuator that converts compressed air pressure into linear mechanical force and motion, producing strokes from a few millimetres to over a metre. Pneumatic cylinders are widely used in industrial robotics, material handling, and assembly systems because of their high force-to-weight ratio, fast response, and inherent compliance compared to hydraulic counterparts."@en ;
    rdfs:subClassOf ngm:pneumatic-actuator,
        ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:enables ngm:end-effector,
        ngm:manipulator ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:robo-actuation-and-control ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:electric-linear-actuator,
        ngm:hydraulic-cylinder,
        ngm:pneumatic-motor,
        ngm:pressure-sensor,
        ngm:robot-joint ;
    vc:slug "pneumatic-cylinder" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:actuator,
        ngm:mechanical-component .

ngm:policy-simulation a skos:Concept ;
    rdfs:label "Policy Simulation"@en .

ngm:polkadot-parachains a owl:Class ;
    rdfs:label "Polkadot Parachains"@en ;
    rdfs:comment "Application-specific sovereign blockchains that lease a slot on the Polkadot Relay Chain, inheriting its shared security model and cross-chain messaging infrastructure. Parachains can have custom runtime logic, consensus rules, and token economics whilst relying on the relay chain's validator set for finalisation, enabling heterogeneous specialised chains to interoperate without sacrificing security or decentralisation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:validator-node ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:consensus-mechanism ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:web-assembly ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:nominated-proof-of-stake ],
        ngm:bc-network-component ;
    skos:broader ngm:bc-network-component ;
    vc:enables ngm:blockchain-interoperability,
        ngm:blockchain-scalability,
        ngm:cross-chain-messaging ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:blockchain,
        ngm:blockchain-network ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:blockchain-governance,
        ngm:blockchain-protocol,
        ngm:cross-chain-bridge,
        ngm:proof-of-stake,
        ngm:smart-contract ;
    vc:requires ngm:consensus-mechanism,
        ngm:nominated-proof-of-stake,
        ngm:validator-node,
        ngm:web-assembly ;
    vc:slug "polkadot-parachains" ;
    vc:sourceDomain "blockchain" .

ngm:population-health-management a owl:Class ;
    rdfs:label "Population Health Management"@en ;
    rdfs:comment "Population health management is a data-driven approach to improving the health outcomes of a defined group of people by aggregating clinical and social data, stratifying members by risk, and coordinating targeted interventions across the care continuum. It shifts focus from treating individual encounters toward proactively managing the health of whole populations, often under value-based payment models. It relies on electronic health records, analytics and care-coordination workflows to identify needs and direct resources where they yield the greatest benefit."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:electronic-health-record ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:electronic-health-record ],
        ngm:healthcare-technology ;
    vc:bridgesTo ngm:risk-management ;
    vc:contrastsWith ngm:electronic-health-record ;
    vc:dependsOn ngm:data ;
    vc:enables ngm:predictive-analytics ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:electronic-health-record ;
    vc:implements ngm:risk-management ;
    vc:isPartOf ngm:healthcare-technology ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:electronic-health-record,
        ngm:predictive-analytics ;
    vc:requires ngm:electronic-health-record ;
    vc:slug "population-health-management" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:standardizedBy ngm:healthcare-technology ;
    vc:supports ngm:healthcare-technology ;
    vc:uses ngm:predictive-analytics .

ngm:pose-graph a owl:Class ;
    rdfs:label "Pose Graph"@en ;
    rdfs:comment "A pose graph is a graph representation used in robotics where nodes are robot poses (positions and orientations) and edges encode relative spatial constraints derived from odometry or sensor measurements. Pose-graph optimisation finds the configuration of poses that best satisfies all constraints, correcting accumulated drift. It is the backbone of modern graph-based SLAM systems."@en ;
    rdfs:subClassOf ngm:robo-navigation-and-planning ;
    skos:broader ngm:robo-navigation-and-planning ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:topological-map ;
    vc:slug "pose-graph" ;
    vc:sourceDomain "robotics" .

ngm:post-incident-review a owl:Class ;
    rdfs:label "Post Incident Review"@en ;
    rdfs:comment "A post-incident review is a structured retrospective conducted after an operational incident to establish what happened, why, and how recurrence can be prevented. Conducted in a blameless manner, it reconstructs the timeline, identifies contributing factors through root-cause analysis, and produces tracked corrective actions and durable lessons. It is a core practice of incident management and site reliability engineering that turns failures into systemic improvement."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:monitoring-system ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:root-cause-analysis ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:root-cause-analysis ],
        ngm:incident-management ;
    vc:bridgesTo ngm:incident-response ;
    vc:enables ngm:change-management,
        ngm:reliability,
        ngm:risk-management ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:root-cause-analysis ;
    vc:isPartOf ngm:incident-management ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:incident-response,
        ngm:reliability-engineering,
        ngm:site-reliability-engineering ;
    vc:requires ngm:monitoring-system,
        ngm:root-cause-analysis ;
    vc:slug "post-incident-review" ;
    vc:sourceDomain "governance" ;
    vc:supports ngm:compliance,
        ngm:governance-framework ;
    vc:uses ngm:monitoring,
        ngm:observability .

ngm:pre-trained-language-model a owl:Class ;
    rdfs:label "Pre Trained Language Model"@en ;
    rdfs:comment "A pre-trained language model is a neural language model that has first been trained on a large, general corpus using self-supervised objectives such as masked or next-token prediction, then reused as a foundation for many downstream tasks. By learning broadly transferable linguistic and world knowledge during pre-training, it can be adapted with comparatively little task-specific data through fine-tuning, prompting, or instruction tuning. This pre-train-then-adapt paradigm, exemplified by BERT and the GPT family, is the foundation of modern natural language processing."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:deep-learning ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:self-supervised-learning ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:transformer ],
        ngm:language-model ;
    vc:dependsOn ngm:transfer-learning ;
    vc:enables ngm:natural-language-processing,
        ngm:transfer-learning ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:transformer ;
    vc:implements ngm:bert,
        ngm:gpt,
        ngm:ro-berta ;
    vc:isPartOf ngm:language-model ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:foundation-model,
        ngm:pretrained-model ;
    vc:requires ngm:deep-learning,
        ngm:self-supervised-learning ;
    vc:slug "pre-trained-language-model" ;
    vc:sourceDomain "machine-learning" ;
    vc:uses ngm:neural-network,
        ngm:self-supervised-learning,
        ngm:transformer .

ngm:privacy-and-data-governance a owl:Class ;
    rdfs:label "Privacy and Data Governance"@en ;
    rdfs:comment "Privacy and Data Governance is a trustworthiness dimension ensuring AI systems protect personal information, respect data rights, maintain data quality, and implement appropriate access controls throughout data collection, processing, storage, and sharing activities."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:artificial-intelligence ],
        ngm:ai-governance-and-ethics ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:artificial-intelligence ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:slug "privacy-and-data-governance" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:privacy-coin a owl:Class ;
    rdfs:label "Privacy Coin"@en ;
    rdfs:comment "A Privacy Coin is a cryptocurrency engineered to conceal the sender, receiver, and amount of transactions, breaking the on-chain linkability that characterises transparent ledgers. Such coins employ techniques like ring signatures, zero-knowledge proofs, confidential transactions, and stealth addresses to deliver fungibility and transaction privacy. Examples in the public domain include Monero and Zcash, which represent contrasting cryptographic approaches to the same confidentiality goal."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptocurrency ],
        ngm:cryptocurrency ;
    vc:bridgesTo ngm:zero-knowledge-proof ;
    vc:contrastsWith ngm:regulatory-compliance ;
    vc:enables ngm:transaction-privacy ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:transaction-privacy ;
    vc:isPartOf ngm:blockchain ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:monero,
        ngm:privacy,
        ngm:zcash ;
    vc:requires ngm:cryptocurrency ;
    vc:slug "privacy-coin" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:decentralised-finance ;
    vc:uses ngm:digital-signature,
        ngm:zero-knowledge-proof .

ngm:privacy-filter a owl:Class ;
    rdfs:label "Privacy Filter"@en ;
    rdfs:comment "A sidecar service (ADR-008) that sanitises agent outputs before emission to Nostr Relay|Nostr relays or Federation Surface|federation surfaces, redacting personally identifiable information (PII), secrets, and regulated data, whilst maintaining data utility for downstream consumers and le..."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:audit-trail ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:pattern-matching ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:policy-enforcement ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:classification-rules ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:machine-learning-discipline ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:privacy-policy ],
        ngm:infra-security-and-identity,
        ngm:security-layer ;
    skos:broader ngm:infra-security-and-identity ;
    vc:enables ngm:data-minimisation,
