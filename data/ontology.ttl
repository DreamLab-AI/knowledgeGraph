ngm:priority-queue a owl:Class ;
    rdfs:comment "A priority queue is an abstract data type in which each element has an associated priority and elements are served in order of priority rather than insertion order. It supports insertion of elements and extraction of the highest- (or lowest-) priority element, and is most commonly implemented with a binary heap. Priority queues underpin many graph and scheduling algorithms where the next item to process is the most urgent one."@en ;
    rdfs:label "Priority Queue"@en ;
    rdfs:subClassOf ngm:data-structure ;
    rdfs:subClassOf _:r16807 ;
