        ngm:identity-service,
        ngm:physics-service ;
    vc:isPartOf ngm:data-layer ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:api-management,
        ngm:data-models,
        ngm:service-orchestration ;
    vc:slug "service-layer" ;
    vc:sourceDomain "spatial-computing" .

ngm:simulation-software a owl:Class ;
    rdfs:label "Simulation Software"@en ;
    rdfs:comment "Application software that constructs, parameterises, and executes computational models of physical, biological, social, or engineered systems, enabling controlled experimentation and behaviour observation across time steps without manipulating real-world systems. Simulation software encompasses physics engines, agent-based modelling frameworks, discrete-event simulators, and real-time digital twin environments, serving domains ranging from aerospace engineering and molecular biology to urban planning and immersive training. Unlike general-purpose scientific computing, simulation software provides domain-specific abstraction layers, visualisation pipelines, and scenario management tools that allow non-specialists to configure and run experiments at scale. The field intersects spatial computing, machine learning, and high-performance computing as simulations grow to planetary scale and real-time fidelity."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:simulation-engine ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:high-performance-computing ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:physics-engine ],
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:bridgesTo ngm:edge-computing,
        ngm:machine-learning-pipeline ;
    vc:contrastsWith ngm:emulation-software,
        ngm:physical-prototyping ;
    vc:dependsOn ngm:gpu-compute,
        ngm:rendering-engine ;
    vc:enables ngm:digital-twin,
        ngm:reinforcement-learning,
        ngm:synthetic-data-generation,
        ngm:virtual-prototyping ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:data-logger,
        ngm:physics-engine,
        ngm:scenario-manager,
        ngm:simulation-engine,
        ngm:visualisation-pipeline ;
    vc:isPartOf ngm:digital-engineering-toolchain ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:application-software,
        ngm:model-based-systems-engineering,
        ngm:spatial-computing ;
    vc:requires ngm:computational-model,
        ngm:high-performance-computing,
        ngm:numerical-solver ;
    vc:slug "simulation-software" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:autonomous-vehicle-testing,
        ngm:climate-modelling,
        ngm:xr-training ;
    vc:uses ngm:agent-based-modelling,
        ngm:discrete-event-simulation,
        ngm:finite-element-analysis,
        ngm:monte-carlo-method .

ngm:social-media-platform-infrastructure a owl:Class ;
    rdfs:label "Social Media Platform Infrastructure"@en ;
    rdfs:comment "Digital platforms and applications that enable users to create, share, and interact with user-generated content within networked communities. Social media platforms combine content distribution infrastructure, algorithmic recommendation, identity and profile management, and real-time communication at scale. They are significant vectors for AI application (content moderation, recommendation, advertising optimisation) and raise governance challenges around bias, privacy, and misinformation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:platform-governance ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:content-delivery-network ],
        ngm:infra-network-and-comms ;
    skos:broader ngm:infra-network-and-comms ;
    vc:enables ngm:distributed-collaboration ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:bias,
        ngm:privacy,
        ngm:social-platform ;
    vc:requires ngm:content-delivery-network,
        ngm:platform-governance ;
    vc:slug "social-media-platform-infrastructure" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:content-moderation,
        ngm:machine-learning-discipline .

ngm:social-network-graph a owl:Class ;
    rdfs:label "Social Network Graph"@en ;
    rdfs:comment "A graph-theoretic data structure in which nodes represent social actors (individuals, organisations, or automated agents) and edges encode directed or undirected social relations such as friendship, following, trust, or co-authorship. Social network graphs are analysed using network-science metrics including degree centrality, clustering coefficient, betweenness, and PageRank to reveal community structure, information diffusion pathways, and influential actors. They underpin decentralised identity federation protocols (ActivityPub, Nostr), recommendation engines, and adversarial analysis tasks such as Sybil detection. The formalism extends naturally to heterogeneous property graphs and hypergraphs when multi-typed relations or group memberships must be represented."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:digital-identity ],
        ngm:knowledge-graph ;
    vc:bridgesTo ngm:decentralised-identity,
        ngm:graph-neural-network,
        ngm:virtual-community-platform ;
    vc:contrastsWith ngm:citation-network,
        ngm:knowledge-graph ;
    vc:dependsOn ngm:graph-theory,
        ngm:network-topology ;
    vc:enables ngm:community-detection,
        ngm:identity-federation,
        ngm:influence-analysis,
        ngm:recommendation-system ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:community-structure,
        ngm:graph-edge,
        ngm:graph-node ;
    vc:isPartOf ngm:graph-database ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:federation-surface,
        ngm:small-world-network,
        ngm:web-of-trust ;
    vc:requires ngm:digital-identity,
        ngm:graph-traversal-algorithm ;
    vc:slug "social-network-graph" ;
    vc:sourceDomain "data" ;
    vc:supports ngm:social-media-analytics,
        ngm:sybil-resistance ;
    vc:uses ngm:activitypub,
        ngm:nostr-protocol,
        ngm:pagerank .

ngm:spatial-database a owl:Class ;
    rdfs:label "Spatial Database"@en ;
    rdfs:comment "A database system optimized for storing, indexing, and querying georeferenced data and geometric objects, supporting spatial data types (points, lines, polygons) and spatial operations (intersection, containment, proximity) per OGC Simple Features specification for GIS and metaverse applications."@en ;
    rdfs:subClassOf ngm:database-system,
        ngm:infra-data-management ;
    skos:broader ngm:infra-data-management ;
    vc:enables ngm:geospatial-data-management ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:slug "spatial-database" ;
    vc:sourceDomain "infrastructure" .

ngm:spatial-mesh a owl:Class ;
    rdfs:label "Spatial Mesh"@en ;
    rdfs:comment "A three-dimensional geometric representation of real-world environments created through spatial mapping, where surfaces are reconstructed as interconnected polygonal meshes to enable accurate placement and occlusion of virtual objects in augmented reality applications."@en ;
    rdfs:subClassOf ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:enables ngm:ar-occlusion ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:slug "spatial-mesh" ;
    vc:sourceDomain "spatial-computing" .

ngm:spatial-presence a owl:Class ;
    rdfs:label "Spatial Presence"@en ;
    rdfs:comment "The psychological state of feeling physically located within a virtual environment, experiencing the sense of \"being there\" despite technological mediation, influenced by place illusion (perceived location), plausibility illusion (believable events), and temporal presence (immediacy of experience)."@en ;
    rdfs:subClassOf ngm:sc-platform-and-environment,
        ngm:vr-psychology ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:enables ngm:immersive-experience ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:slug "spatial-presence" ;
    vc:sourceDomain "spatial-computing" .

ngm:standards-conformance a owl:Class ;
    rdfs:label "Standards Conformance"@en ;
    rdfs:comment "The state or process of meeting the requirements specified in a technical standard, specification, or guideline, ensuring that a product, process, or system aligns with internal or industry-specific standards for interoperability, quality, and compatibility."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:technical-standards ],
