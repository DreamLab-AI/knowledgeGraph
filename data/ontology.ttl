ngm:audit-log a owl:Class ;
    rdfs:label "Audit Log"@en ;
    rdfs:comment "An audit log is an immutable, chronologically ordered record of discrete system events that captures who performed an action, what action was performed, on which resource, at what time, and from what source context, providing an authoritative evidence trail for security investigation, regulatory compliance, and forensic analysis. Each entry is structured with a timestamp, actor identity, event type, affected object identifier, outcome status, and contextual metadata. Audit logs are foundational to accountability in information systems, distinguished from operational logs by their emphasis on human-actionable accountability and legal evidentiary weight rather than system diagnostics. In high-assurance environments, entries are cryptographically chained so that deletion or modification of any record invalidates all subsequent hashes, making tampering detectable."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:identity-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:time-synchronisation ],
        ngm:audit-trail ;
    vc:bridgesTo ngm:blockchain,
        ngm:certificate-transparency ;
    vc:enables ngm:anomaly-detection,
        ngm:regulatory-reporting,
