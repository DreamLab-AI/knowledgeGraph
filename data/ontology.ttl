# Byzantine Fault Tolerance
blockchain:ByzantineFaultTolerance rdf:type owl:Class ;
    rdfs:subClassOf blockchain:ConsensusMechanism ;
    rdfs:subClassOf blockchain:DistributedAgreement ;
    rdfs:label "Byzantine Fault Tolerance"@en ;
    rdfs:comment "The feature of a distributed network to reach consensus on the same value even when some nodes fail to respond or respond with incorrect information. Enables networks to function correctly despite malicious or faulty nodes comprising less than one-third of the network."@en ;
    skos:prefLabel "Byzantine Fault Tolerance"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:blockchain:byzantine-fault-tolerance" ;
    owl:sameAs <urn:visionclaw:concept:blockchain:byzantine-fault-tolerance> ;
    vcw:contentHash "sha256-12-8efb6f3a4a80" ;
    vcw:qualityScore "0.5"^^xsd:decimal ;
    vcw:legacyTermId "BC-0544" ;
    vcw:ontologyStatus "complete" ;
    vcw:maturityLevel "established" ;
    vcw:authorityScore "0.95"^^xsd:decimal ;
    dcterms:identifier "BC-0544" ;
    dcterms:subject "blockchain" ;
    owl:versionInfo "2.1.0" ;
    dcterms:created "2025-11-13T00:00:00Z"^^xsd:dateTime ;
    dcterms:modified "2026-04-26T00:00:00Z"^^xsd:dateTime ;
    vcw:owlRole "Concept" .

blockchain:ByzantineFaultTolerance rdfs:subClassOf [
