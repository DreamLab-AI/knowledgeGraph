        ngm:tls,
        ngm:url .

ngm:interoperability-protocol a owl:Class ;
    rdfs:label "Interoperability Protocol"@en ;
    rdfs:comment "An interoperability protocol is a formally specified set of rules, message formats, sequencing constraints, and coordination mechanisms that enable independently implemented systems, networks, or platforms to exchange information and invoke services without requiring shared internal architecture or governance. Such protocols define both syntactic structure and semantic contracts so that heterogeneous participants can interact predictably and verifiably. Interoperability protocols range from low-level wire formats to high-level semantic agreements, and form the foundational connective tissue of distributed computing ecosystems including blockchain networks, spatial computing platforms, AI service meshes, and cross-organisational data exchanges. Their design and governance determine whether digital infrastructure remains open and composable or becomes fragmented and extractive."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:schema-definition ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:open-standard ],
        ngm:network-protocol ;
    vc:bridgesTo ngm:agent-communication-language,
        ngm:openxr ;
    vc:contrastsWith ngm:proprietary-api,
        ngm:vendor-lock-in ;
    vc:enables ngm:blockchain-interoperability,
        ngm:cross-platform-interoperability,
        ngm:federated-identity,
        ngm:interoperability,
        ngm:multi-agent-system ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:data-exchange-format,
        ngm:interoperability-standard ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:communication-protocol,
        ngm:decentralised-identifier,
        ngm:interoperability-framework,
        ngm:semantic-web,
        ngm:verifiable-credential ;
    vc:requires ngm:open-standard,
        ngm:protocol-specification,
        ngm:schema-definition ;
    vc:slug "interoperability-protocol" ;
    vc:sourceDomain "infrastructure" ;
    vc:standardizedBy ngm:ieee,
        ngm:ietf,
        ngm:khronos-group,
        ngm:w3c ;
    vc:supports ngm:cross-chain-messaging,
        ngm:decentralised-autonomous-organisation,
        ngm:digital-asset-ecosystem,
        ngm:spatial-computing ;
    vc:uses ngm:api-standard,
        ngm:cryptographic-proof,
        ngm:message-format .

ngm:knowledge-graph-construction a owl:Class ;
    rdfs:label "Knowledge Graph Construction"@en ;
    rdfs:comment "Knowledge Graph Construction is the process of automatically or semi-automatically building structured graph representations of world knowledge by extracting entities, relations, and attributes from heterogeneous sources such as text corpora, databases, and web data. The discipline combines techniques from natural language processing, information retrieval, and ontology engineering to produce machine-readable graphs that support reasoning, question answering, and semantic search."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:ontology ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:named-entity-recognition ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-integration ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:information-retrieval ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:entity-resolution ],
        ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
