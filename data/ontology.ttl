        ngm:contact-dynamics,
        ngm:inverse-kinematics,
        ngm:motion-planning,
        ngm:power-management,
        ngm:real-time-control ;
    vc:slug "humanoid-robot" ;
    vc:sourceDomain "robotics" ;
    vc:standardizedBy ngm:iec-61508,
        ngm:iso-10218-1,
        ngm:iso-22166,
