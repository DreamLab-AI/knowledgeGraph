    vcw:qualityScore "0.5"^^xsd:decimal ;
    vcw:legacyTermId "AI-0209" ;
    vcw:ontologyStatus "draft" ;
    vcw:maturityLevel "draft" ;
    vcw:authorityScore "0.0"^^xsd:decimal ;
    dcterms:identifier "AI-0209" ;
    dcterms:subject "artificial-intelligence" ;
    owl:versionInfo "2.0.0" ;
    dcterms:created "2026-04-26T00:00:00Z"^^xsd:dateTime ;
    dcterms:modified "2026-04-26T13:00:00Z"^^xsd:dateTime ;
    vcw:owlRole "Concept" .

artificial-intelligence:CausalAttention vcw:bridgesTo artificial-intelligence:ComputerVision .

# Attention Mask
artificial-intelligence:AttentionMask rdf:type owl:Class ;
    rdfs:label "Attention Mask"@en ;
    rdfs:comment "A mechanism that controls which positions in a sequence can attend to which other positions, typically implemented by adding large negative values before softmax to effectively zero out unwanted attention weights."@en ;
    skos:prefLabel "Attention Mask"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:artificial-intelligence:attention-mask" ;
    owl:sameAs <urn:visionclaw:concept:artificial-intelligence:attention-mask> ;
