ngm:nist-nistir a owl:Class ;
    rdfs:label "NIST NISTIR"@en ;
    rdfs:comment "NIST Interagency or Internal Reports (NISTIRs) are a formal publication series issued by the National Institute of Standards and Technology covering technical research, guidelines, measurements, and collaborative investigations that do not rise to the level of a Federal Information Processing Standard (FIPS) or a Special Publication (SP). NISTIRs document foundational work — including laboratory studies, software evaluations, and preliminary standards research — produced by NIST staff or by NIST in collaboration with other U.S. government agencies. Because they are freely accessible and citable, NISTIRs frequently underpin subsequent Special Publications, ISO standards, and regulatory frameworks in cybersecurity, metrology, AI evaluation, and more."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:nist ],
        ngm:technical-standard ;
    vc:bridgesTo ngm:ai-trustworthiness,
        ngm:iot-security,
        ngm:quantum-computation-paradigm ;
    vc:contrastsWith ngm:federal-information-processing-standards,
        ngm:iso-iec,
        ngm:nist ;
    vc:dependsOn ngm:peer-review,
        ngm:technical-research ;
    vc:enables ngm:ai-risk-management,
        ngm:cybersecurity-policy,
        ngm:federal-information-security ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:nist-nistir-8011,
        ngm:nist-nistir-8259,
        ngm:nist-nistir-8286 ;
    vc:implements ngm:nist-research-program ;
    vc:isPartOf ngm:nist,
        ngm:nist-publication-series ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:government-publication,
        ngm:nist-cybersecurity-framework,
        ngm:technical-report ;
    vc:requires ngm:nist ;
    vc:slug "nist-nistir" ;
    vc:sourceDomain "standards" ;
    vc:standardizedBy ngm:nist ;
    vc:supports ngm:federal-information-processing-standards,
        ngm:nist,
        ngm:risk-management-framework ;
    vc:uses ngm:measurement-science,
        ngm:software-testing .

