        ngm:robot-control,
        ngm:servo-control ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:current-sensing,
        ngm:gate-driver,
        ngm:h-bridge ;
    vc:isPartOf ngm:motor-control-system,
        ngm:robotic-system ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:servo-motor,
        ngm:thermal-management ;
    vc:requires ngm:microcontroller,
        ngm:power-supply,
        ngm:pulse-width-modulation ;
    vc:slug "motor-driver" ;
    vc:sourceDomain "robotics" ;
    vc:supports ngm:brushless-dc-motor,
