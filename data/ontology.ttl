        ngm:large-language-models ;
    vc:slug "gemini-multimodal-language-model" ;
    vc:sourceDomain "ai" ;
    vc:standardizedBy ngm:evaluation-metric ;
    vc:uses ngm:fine-tuning,
        ngm:multimodal-ai-architecture-understanding,
        ngm:transformer .

ngm:graph-algorithms a owl:Class ;
    rdfs:label "Graph Algorithms"@en ;
    rdfs:comment "A family of computational methods that operate on graph structures—nodes and edges—to solve problems such as shortest-path finding, community detection, ranking, and traversal. Graph algorithms are foundational to knowledge graph querying, social network analysis, and AI reasoning over relational data."@en ;
    rdfs:subClassOf ngm:ai-technique ;
