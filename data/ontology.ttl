    rdfs:label "Digital Art Creation"@en .

ngm:digital-cinema a owl:Class ;
    rdfs:label "Digital Cinema"@en ;
    rdfs:comment "Digital cinema is the production, distribution, and theatrical projection of motion pictures using digital files rather than photochemical film. It is governed by the DCI specification, which defines the Digital Cinema Package (DCP) format, JPEG 2000 image compression, encryption, and colour standards for cinema-grade exhibition. It enables consistent high-resolution playback, secure content delivery, and the broader shift to file-based proprietary video pipelines."@en ;
    rdfs:subClassOf ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:proprietary-video ;
    vc:slug "digital-cinema" ;
    vc:sourceDomain "metaverse" .

ngm:digital-content-provenance-marking a owl:Class ;
    rdfs:label "Digital Content Provenance Marking"@en ;
    rdfs:comment "Techniques for embedding imperceptible or visible signals into digital content—such as text, images, audio, or AI-generated outputs—to assert provenance, ownership, or authenticity. AI watermarking approaches include statistical token-distribution biasing (for large language models) and frequency-domain embedding (for images), enabling detection of machine-generated content and supporting intellectual property protection and content provenance verification."@en ;
    rdfs:subClassOf ngm:infra-security-and-identity ;
    skos:broader ngm:infra-security-and-identity ;
    vc:enables ngm:accountability,
        ngm:data-provenance ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:slug "digital-content-provenance-marking" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:ai-governance,
        ngm:transparency-oecd ;
    vc:uses ngm:cryptography,
        ngm:generative-ai .

