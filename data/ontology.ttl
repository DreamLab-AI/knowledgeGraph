ngm:two-way-peg a owl:Class ;
    rdfs:comment "A two-way peg (2WP) is a blockchain mechanism that enables assets to be transferred bidirectionally between a parent chain and a sidechain, with the asset supply conserved across both chains. When an asset is locked on the parent chain, an equivalent representation is minted on the sidechain; when returned to the parent chain, the sidechain representation is burned and the original asset is unlocked. Two-way pegs are the foundational primitive for sidechain interoperability, enabling specialised execution environments whilst tethering their native asset to a more secure base layer."@en ;
    rdfs:label "Two Way Peg"@en ;
    rdfs:subClassOf ngm:blockchain ;
    rdfs:subClassOf ngm:sidechain ;
    rdfs:subClassOf _:r21445 ;
    rdfs:subClassOf _:r21446 ;
    rdfs:subClassOf _:r21447 ;
