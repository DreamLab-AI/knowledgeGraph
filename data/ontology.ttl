    rdfs:label "Renewable Energy Mining"@en .
ngm:renewable-energy-tracking a owl:Class ;
    rdfs:comment "Renewable energy tracking is the verifiable measurement and accounting of clean-energy generation and consumption, often recorded on a ledger to prevent double counting of attributes. It underpins renewable energy certificates by binding each megawatt-hour to a unique, auditable claim. Reliable tracking is essential for credible decarbonisation reporting and voluntary climate commitments."@en ;
    rdfs:label "Renewable Energy Tracking"@en ;
    rdfs:subClassOf ngm:sustainability ;
