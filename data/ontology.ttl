    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:accountability,
        ngm:transparency ;
    vc:slug "corporate-governance" ;
    vc:sourceDomain "governance" .

ngm:counter-terrorist-financing a owl:Class ;
    rdfs:label "Counter-Terrorist Financing"@en ;
    rdfs:comment "Counter-Terrorist Financing (CTF or CFT) is a set of legal, regulatory, and operational measures designed to detect, prevent, and disrupt the funding of terrorist activities. It complements anti-money-laundering regimes and is enforced through obligations such as customer due diligence, transaction monitoring, and reporting of suspicious activity. In digital assets, CTF underpins requirements like the FATF Travel Rule that mandate originator and beneficiary information for transfers."@en ;
    rdfs:subClassOf ngm:financial-regulation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:travel-rule ;
    vc:slug "counter-terrorist-financing" ;
    vc:sourceDomain "blockchain" .

ngm:courses-and-training a owl:Class ;
    rdfs:label "Courses and Training"@en ;
    rdfs:comment "Structured educational programmes and skill-development resources covering artificial intelligence, machine learning, blockchain, spatial computing, and related technologies. These include MOOCs, short courses, university programmes, professional certifications, and self-directed learning materials that build practitioner capacity across technical and non-technical audiences."@en ;
    rdfs:subClassOf ngm:infra-software-engineering ;
    skos:broader ngm:infra-software-engineering ;
    vc:enables ngm:ai-development,
        ngm:software-development-process ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:blockchain ;
    vc:slug "courses-and-training" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:education-technology,
        ngm:machine-learning ;
    vc:uses ngm:learning-management-system,
        ngm:learning-resources .

ngm:cqrs a owl:Class ;
    rdfs:label "CQRS"@en ;
    rdfs:comment "Command Query Responsibility Segregation (CQRS) is a software architecture pattern that separates the model used to update state (commands) from the model used to read state (queries). By using distinct write and read paths, systems can independently optimise, scale, and secure each side, often pairing the write model with event sourcing. It is commonly applied in high-throughput, complex-domain systems where read and write workloads diverge."@en ;
    rdfs:subClassOf ngm:software-architecture ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:crdt,
        ngm:data-layer ;
    vc:slug "cqrs" ;
    vc:sourceDomain "infrastructure" .

ngm:creative-commons a owl:Class ;
    rdfs:label "Creative Commons"@en ;
    rdfs:comment "Creative Commons is a family of standardised public copyright licences that let creators grant defined reuse, attribution, and sharing permissions to the public. The licences (e.g. CC BY, CC BY-SA, CC0) provide machine-readable and human-readable terms that promote legal reuse of content. They are widely used to license training data, open educational resources, and open media corpora."@en ;
    rdfs:subClassOf ngm:infra-legal-and-regulatory ;
    skos:broader ngm:infra-legal-and-regulatory ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:training-data ;
    vc:slug "creative-commons" ;
    vc:sourceDomain "infrastructure" .

ngm:creative-expression a owl:Class ;
    rdfs:label "Creative Expression"@en ;
    rdfs:comment "Creative expression is the human activity of producing original artistic, narrative, or aesthetic artefacts to communicate ideas, emotions, or identity. In virtual and open-world environments it manifests as user-generated content, world-building, avatar customisation, and emergent play. It is a primary driver of engagement and value in persistent metaverse spaces."@en ;
    rdfs:subClassOf ngm:sc-interaction ;
    skos:broader ngm:sc-interaction ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:open-world,
        ngm:virtual-world ;
    vc:slug "creative-expression" ;
    vc:sourceDomain "metaverse" .

ngm:creative-industries a owl:Class ;
    rdfs:label "Creative Industries"@en ;
    rdfs:comment "The creative industries are the economic sectors that generate value primarily from individual creativity, skill, and intellectual property, spanning design, fashion, film, music, gaming, advertising, and publishing. They combine cultural production with commercial distribution and are increasingly reshaped by generative AI tooling. As an economic domain they are a significant employer and exporter of cultural goods."@en ;
    rdfs:subClassOf ngm:economics ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:ai-companies,
        ngm:fashion ;
    vc:slug "creative-industries" ;
    vc:sourceDomain "ai" .

ngm:creator-compensation a owl:Class ;
    rdfs:label "Creator Compensation"@en ;
    rdfs:comment "Creator compensation refers to the economic mechanisms by which content creators are paid for their work, including royalties, revenue sharing, tipping, and tokenised ownership rights. In blockchain contexts it is often automated through smart contracts that distribute proceeds on primary sale and secondary resale. It is central to sustainable creator economies and to debates over fair value capture on digital platforms."@en ;
    rdfs:subClassOf ngm:economic-mechanism ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:creator-royalty-token,
        ngm:royalty-mechanism ;
    vc:slug "creator-compensation" ;
    vc:sourceDomain "blockchain" .

ngm:credential-portability a owl:Class ;
    rdfs:label "Credential Portability"@en ;
    rdfs:comment "Credential portability is the property that lets a holder carry verifiable credentials across providers, platforms, and jurisdictions without re-issuance or vendor lock-in. It relies on open standards such as W3C Verifiable Credentials and decentralised identifiers so that issuers, holders, and verifiers interoperate. It is a foundational capability for user-controlled digital identity and trust frameworks."@en ;
    rdfs:subClassOf ngm:digital-identity ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:digital-identity-wallet,
        ngm:trust-framework ;
    vc:slug "credential-portability" ;
    vc:sourceDomain "security" .

ngm:crew-ai a owl:Class ;
    rdfs:label "CrewAI"@en ;
    rdfs:comment "CrewAI is an open-source Python framework for orchestrating teams of autonomous LLM-powered agents that collaborate on tasks through defined roles, goals, and processes. It models a crew of specialised agents that delegate, share context, and execute sequential or hierarchical workflows. It is widely used to build multi-agent automation and tool-using assistants."@en ;
    rdfs:subClassOf ngm:ai-agent-system ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:cli-multi-agent-systems ;
    vc:slug "crew-ai" ;
    vc:sourceDomain "ai" .

ngm:cross-border-data-transfer a owl:Class ;
    rdfs:label "Cross-Border Data Transfer"@en ;
    rdfs:comment "Cross-border data transfer is the movement of personal or regulated data across national jurisdictions, governed by data-protection laws that restrict where and how such data may be processed. Compliance mechanisms include adequacy decisions, standard contractual clauses, binding corporate rules, and localisation requirements. It is a central concern of privacy regimes such as GDPR and various Asia-Pacific frameworks."@en ;
    rdfs:subClassOf ngm:regulatory-compliance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:asia-pacific-regulation ;
    vc:slug "cross-border-data-transfer" ;
    vc:sourceDomain "governance" .

ngm:cross-border-data-transfer-rule a owl:Class ;
    rdfs:label "Cross-Border Data Transfer Rule"@en ;
    rdfs:comment "Regulatory framework governing international movement of personal and sensitive data across jurisdictions, ensuring privacy protection through adequacy assessments and safeguarding mechanisms."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:transfer-impact-assessment ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:privacy-impact-assessment ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:binding-corporate-rules ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:standard-contractual-clauses ],
        ngm:infra-legal-and-regulatory,
        ngm:privacy-framework ;
    skos:broader ngm:infra-legal-and-regulatory ;
    vc:enables ngm:compliance-verification,
        ngm:global-metaverse-operations,
        ngm:international-data-flows,
        ngm:user-privacy-protection ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:adequacy-decision-framework,
        ngm:binding-corporate-rules,
        ngm:standard-contractual-clauses,
        ngm:transfer-impact-assessment ;
    vc:isPartOf ngm:data-privacy-governance-framework ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:data-protection-authority-notification,
        ngm:legal-basis-determination,
        ngm:privacy-impact-assessment ;
    vc:slug "cross-border-data-transfer-rule" ;
    vc:sourceDomain "infrastructure" .

ngm:cross-border-enforcement a owl:Class ;
    rdfs:label "Cross-Border Enforcement"@en ;
    rdfs:comment "Cross-border enforcement is the process by which legal judgments, regulatory actions, or compliance obligations are recognised and executed across national jurisdictions. It depends on treaties, mutual legal assistance, and cooperation between regulators to act on actors and assets located abroad. It is a persistent challenge for digital and crypto markets that operate without regard to territorial borders."@en ;
    rdfs:subClassOf ngm:regulatory-compliance ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:cross-border-compliance,
        ngm:digital-jurisdiction ;
    vc:slug "cross-border-enforcement" ;
    vc:sourceDomain "governance" .

ngm:cross-border-payment-transparency a owl:Class ;
    rdfs:label "Cross-Border Payment Transparency"@en ;
    rdfs:comment "Cross-border payment transparency is the requirement and practice of making the originator, beneficiary, fees, and routing of international payments visible to counterparties and regulators. It supports anti-money-laundering controls and consumer protection by exposing hidden costs and identifying parties to a transfer. In crypto it is advanced through measures such as the FATF Travel Rule and on-chain settlement traceability."@en ;
    rdfs:subClassOf ngm:financial-regulation ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:cross-border-settlement,
        ngm:travel-rule ;
    vc:slug "cross-border-payment-transparency" ;
    vc:sourceDomain "blockchain" .

ngm:cross-border-remittances a owl:Class ;
    rdfs:label "Cross-Border Remittances"@en ;
    rdfs:comment "Cross-border remittances are transfers of money by individuals—typically migrant workers—to recipients in another country, often family members. Traditionally routed through banks and money-transfer operators with high fees and slow settlement, they are increasingly served by stablecoins and crypto rails that lower cost and latency. They represent a major global financial flow and a key driver of crypto payment adoption."@en ;
    rdfs:subClassOf ngm:financial-services ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:stable-coins ;
    vc:slug "cross-border-remittances" ;
    vc:sourceDomain "blockchain" .

ngm:cross-border-transfer a owl:Class ;
    rdfs:label "Cross-Border Transfer"@en ;
    rdfs:comment "A cross-border transfer is the movement of value or funds between parties located in different countries, settled across distinct currency and regulatory regimes. It encompasses bank wires, card networks, money-transfer operators, and increasingly digital-payment and cryptocurrency rails. Speed, cost, foreign-exchange handling, and compliance with multiple jurisdictions are its defining constraints."@en ;
    rdfs:subClassOf ngm:financial-services ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:cryptocurrency,
        ngm:digital-payments ;
    vc:slug "cross-border-transfer" ;
    vc:sourceDomain "blockchain" .

ngm:cross-chain-communication a owl:Class ;
    rdfs:label "Cross-Chain Communication"@en ;
    rdfs:comment "Cross-chain communication is the exchange of messages, data, and asset-transfer instructions between distinct blockchain networks that do not natively share state. It is implemented through protocols, relays, and light-client verification that let one chain trust and act on events from another. It is the foundation of blockchain interoperability and multi-chain applications."@en ;
    rdfs:subClassOf ngm:cross-chain-bridge ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:blockchain-interoperability,
        ngm:cosmos-ibc ;
    vc:slug "cross-chain-communication" ;
    vc:sourceDomain "blockchain" .

ngm:cross-chain-dex a owl:Class ;
    rdfs:label "Cross-Chain DEX"@en ;
    rdfs:comment "A cross-chain DEX is a decentralised exchange that lets users swap assets native to different blockchains without a centralised custodian. It relies on bridges, atomic swaps, or liquidity-network protocols to coordinate settlement across chains while preserving non-custodial trading. It extends decentralised finance beyond single-chain liquidity silos."@en ;
    rdfs:subClassOf ngm:de-fi ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:blockchain-interoperability,
        ngm:cross-chain-bridge ;
    vc:slug "cross-chain-dex" ;
    vc:sourceDomain "blockchain" .

ngm:cross-chain-nft a owl:Class ;
    rdfs:label "Cross-Chain NFT"@en ;
    rdfs:comment "A cross-chain NFT is a non-fungible token that can move or be represented across multiple blockchains while preserving its identity, ownership, and metadata. It uses bridges, burn-and-mint mechanisms, or messaging protocols to transfer the canonical token between networks. It enables NFTs to access liquidity, marketplaces, and applications on chains other than where they were minted."@en ;
    rdfs:subClassOf ngm:bc-token-and-asset ;
    skos:broader ngm:bc-token-and-asset ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:blockchain-interoperability,
        ngm:cross-chain-bridge ;
    vc:slug "cross-chain-nft" ;
    vc:sourceDomain "blockchain" .

ngm:cross-modal-conditioning a owl:Class ;
    rdfs:label "Cross-Modal Conditioning"@en ;
    rdfs:comment "Cross-modal conditioning is a technique in which a generative or predictive model is guided by information from a different modality than its output, such as conditioning image generation on text or audio on video. It typically uses cross-attention to inject signals from one modality into the representation of another. It is fundamental to text-to-image, text-to-audio, and other multimodal generative systems."@en ;
    rdfs:subClassOf ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:attention,
        ngm:multimodal-learning ;
    vc:slug "cross-modal-conditioning" ;
    vc:sourceDomain "ai" .

ngm:cross-platform-asset-exchange a owl:Class ;
    rdfs:label "Cross-Platform Asset Exchange"@en ;
    rdfs:comment "Cross-platform asset exchange is the capability to move 3D models, textures, and other digital assets between different metaverse platforms, engines, and tools while preserving fidelity and usability. It depends on shared 3D file formats and import/export pipelines that map assets onto each platform's runtime. It is a prerequisite for interoperable virtual worlds and portable user content."@en ;
    rdfs:subClassOf ngm:sc-standards-and-interop ;
    skos:broader ngm:sc-standards-and-interop ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:3-d-file-format,
        ngm:standard-format-support ;
    vc:slug "cross-platform-asset-exchange" ;
    vc:sourceDomain "metaverse" .

ngm:cross-platform-content a owl:Class ;
    rdfs:label "Cross-Platform Content"@en ;
    rdfs:comment "Cross-platform content is digital media and 3D assets authored once and made usable across multiple platforms, engines, or devices through standardised formats and conversion pipelines. It depends on format parsers and content pipelines that normalise assets to each target's runtime requirements. It enables creators to reach diverse metaverse environments without bespoke re-authoring."@en ;
    rdfs:subClassOf ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:format-parser,
        ngm:metaverse-content-pipeline ;
    vc:slug "cross-platform-content" ;
    vc:sourceDomain "metaverse" .

ngm:cross-system-querying a owl:Class ;
    rdfs:label "Cross-System Querying"@en ;
    rdfs:comment "Cross-system querying is the ability to issue a single query that retrieves and joins data residing in multiple independent systems or data stores. It is achieved through federation surfaces, linked-data encoding, and query mediators that translate and route requests to heterogeneous sources. It enables unified access to distributed data without centralising or duplicating it."@en ;
    rdfs:subClassOf ngm:data-management ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:federation-surface,
        ngm:linked-data-encoder ;
    vc:slug "cross-system-querying" ;
    vc:sourceDomain "data" .

ngm:crypto-trading a owl:Class ;
    rdfs:label "Crypto Trading"@en ;
    rdfs:comment "Crypto trading is the buying and selling of cryptocurrencies and digital assets for profit, conducted on centralised exchanges, decentralised exchanges, and over-the-counter desks. It spans spot, margin, derivatives, and algorithmic strategies, with prices driven by liquidity, sentiment, and on-chain activity. It is a primary use case and liquidity source for the broader crypto-asset market."@en ;
    rdfs:subClassOf ngm:financial-services ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:kraken,
        ngm:tether ;
    vc:slug "crypto-trading" ;
    vc:sourceDomain "blockchain" .

ngm:cryptocurrency-remuneration a owl:Class ;
    rdfs:label "Cryptocurrency Remuneration"@en ;
    rdfs:comment "Cryptocurrency remuneration is the practice of paying remote workers, freelancers, or distributed team members in digital assets — including Bitcoin, Ethereum, or fiat-pegged stablecoins — rather than traditional currency. It enables borderless, near-instant settlement at low transaction cost, bypassing correspondent banking infrastructure and extending financial access to unbanked populations. Compliance with local payroll tax, AML/KYC, and employment law obligations remains essential."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:aml-kyc-compliance ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:regulatory-compliance ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:tax-treatment-crypto ],
        ngm:cryptocurrency,
        ngm:dc-protocol-and-infra ;
    skos:broader ngm:dc-protocol-and-infra ;
    vc:enables ngm:cross-border-payments,
        ngm:distributed-work,
        ngm:financial-inclusion,
        ngm:micropayments ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:blockchain-collaboration,
        ngm:decentralized-autonomous-organization,
        ngm:smart-contract-coordination,
        ngm:telecollaboration ;
    vc:requires ngm:aml-kyc-compliance,
        ngm:regulatory-compliance,
        ngm:tax-treatment-crypto ;
    vc:slug "cryptocurrency-remuneration" ;
    vc:sourceDomain "distributed-collaboration" ;
    vc:uses ngm:blockchain,
        ngm:lightning-network,
        ngm:smart-contract,
        ngm:stablecoin .

ngm:cryptocurrency-storage a owl:Class ;
    rdfs:label "Cryptocurrency Storage"@en ;
    rdfs:comment "Cryptocurrency Storage encompasses the cryptographic key management systems and secure storage solutions for maintaining control over digital assets on blockchain networks. Architectures range from hot wallets with internet connectivity through cold storage hardware devices to multi-signature and threshold-signature schemes. Hierarchical Deterministic (HD) wallets following BIP32/BIP39 standards generate key trees from a single seed phrase, while institutional custody solutions leverage multi-party computation (MPC) and smart-contract-based social recovery for asset governance."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptographic-key-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:blockchain ],
        ngm:bc-network-component,
        ngm:digital-wallet ;
    skos:broader ngm:bc-network-component ;
    vc:dependsOn ngm:public-key-infrastructure ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:requires ngm:blockchain,
        ngm:cryptographic-key-management ;
    vc:slug "cryptocurrency-storage" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:digital-asset-management ;
    vc:uses ngm:cryptographic-signature,
        ngm:ecdsa .

ngm:cryptographic-protocols a owl:Class ;
    rdfs:label "Cryptographic Protocols"@en ;
    rdfs:comment "Cryptographic protocols are sequences of operations using cryptographic primitives to achieve security goals such as confidentiality, integrity and authentication."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:encryption ],
        ngm:cryptography ;
    vc:enables ngm:kerberos ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:encryption ;
    vc:slug "cryptographic-protocols" ;
    vc:sourceDomain "distributed-systems" .

ngm:csrd-compliance a owl:Class ;
    rdfs:label "CSRD Compliance"@en ;
    rdfs:comment "CSRD compliance is the practice of meeting the reporting obligations of the European Union's Corporate Sustainability Reporting Directive, which mandates standardised disclosure of environmental, social and governance impacts. It requires in-scope companies to report under the European Sustainability Reporting Standards (ESRS), including double-materiality assessments and audited climate and carbon metrics. Compliance underpins demonstrable carbon accounting for sectors such as energy-intensive computing and blockchain."@en ;
    rdfs:subClassOf ngm:regulatory-compliance ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:carbon-footprint-measurement,
        ngm:carbon-neutral-blockchain ;
    vc:slug "csrd-compliance" ;
    vc:sourceDomain "governance" .

ngm:cultural-preservation a owl:Class ;
    rdfs:label "Cultural Preservation"@en ;
    rdfs:comment "Cultural preservation is the systematic safeguarding, documentation and transmission of tangible and intangible cultural heritage so that it survives for future generations. In digital contexts it involves capturing artefacts as durable metadata-rich records, archiving collective memory, and ensuring long-term accessibility against media decay and format obsolescence. It matters as a governance concern for who controls heritage data and how it remains discoverable."@en ;
    rdfs:subClassOf ngm:governance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:artifact-metadata,
        ngm:collective-memory-archive ;
    vc:slug "cultural-preservation" ;
    vc:sourceDomain "governance" .

ngm:curve-wars a owl:Class ;
    rdfs:label "Curve Wars"@en ;
    rdfs:comment "The competition among protocols to accumulate vote-escrowed governance power in the Curve exchange in order to direct token emissions toward their own liquidity pools."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:vote-escrow-model ],
        ngm:liquidity-provision ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:vote-escrow-model ;
    vc:slug "curve-wars" ;
    vc:sourceDomain "blockchain" .

ngm:custody-layer a owl:Class ;
    rdfs:label "Custody Layer"@en ;
    rdfs:comment "The Custody Layer is the stratum that governs the safekeeping and authorised control of assets and the keys that command them. It sits above the Cryptographic and Identity strata it depends on and below the settlement and application activity that moves assets. It contains key storage, signing policies, and the authorisation rules for asset control."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:identity-layer ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptographic-layer ],
        ngm:owl-thing ;
    vc:enables ngm:application-layer,
        ngm:settlement-layer ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:cryptographic-layer,
        ngm:identity-layer ;
    vc:slug "custody-layer" ;
    vc:sourceDomain "custody" .

ngm:customer-retention a owl:Class ;
    rdfs:label "Customer Retention"@en ;
    rdfs:comment "Customer retention is the set of strategies and mechanisms a business uses to keep existing customers engaged and transacting over time, reducing churn. It commonly relies on loyalty and rewards schemes, personalised omnichannel experiences, and data-driven engagement to maximise customer lifetime value. As an economic mechanism it is typically cheaper than acquisition and central to sustainable revenue."@en ;
    rdfs:subClassOf ngm:economic-mechanism ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:customer-rewards,
        ngm:omnichannel ;
    vc:slug "customer-retention" ;
    vc:sourceDomain "governance" .

ngm:customer-rewards a owl:Class ;
    rdfs:label "Customer Rewards"@en ;
    rdfs:comment "Loyalty program systems that use blockchain technology and tokenization to create tradeable, interoperable digital rewards, enabling customers to earn, exchange, and redeem tokens across multiple platforms and businesses while providing brands with transparent, fraud-resistant, and cost-effective..."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:digital-wallet ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:blockchain-infrastructure ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:smart-contracts ],
        ngm:loyalty-programs,
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:enables ngm:cross-platform-rewards,
        ngm:customer-retention,
        ngm:token-trading ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires ngm:blockchain-infrastructure,
        ngm:digital-wallet,
        ngm:smart-contracts ;
    vc:slug "customer-rewards" ;
    vc:sourceDomain "spatial-computing" .

ngm:cyber-security-and-military a owl:Class ;
    rdfs:label "Cyber Security and Military"@en ;
    rdfs:comment "Cyber Security and Military denotes the doctrinal, organisational, technical and operational fusion of cyberspace as a recognised warfighting domain alongside land, sea, air and space — codified by NATO at the 2016 Warsaw Summit declaration that cyberspace is \"a domain of operations in which NATO..."@en ;
    rdfs:subClassOf ngm:governance,
        ngm:infra-security-and-identity ;
    skos:broader ngm:infra-security-and-identity ;
    vc:enables ngm:adversary-intelligence-collection,
        ngm:battle-damage-assessment,
        ngm:critical-infrastructure-disruption,
        ngm:cyber-deterrence,
        ngm:hybrid-warfare,
        ngm:joint-all-domain-operations,
        ngm:strategic-coercion ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:computer-network-exploitation,
        ngm:cyber-intelligence,
        ngm:cyber-mission-force,
        ngm:defensive-cyber-operations,
        ngm:electromagnetic-spectrum-operations,
        ngm:information-operations,
        ngm:national-cyber-force,
        ngm:offensive-cyber-operations ;
    vc:implements ngm:computer-network-operations-doctrine,
        ngm:defend-forward,
        ngm:f3-ead-targeting,
        ngm:joint-targeting-cycle,
        ngm:law-of-armed-conflict,
        ngm:persistent-engagement,
        ngm:tallinn-manual-rules ;
    vc:qualityScore "0.52"^^xsd:float ;
    vc:relatedTo ngm:counter-intelligence,
        ngm:drone-warfare,
        ngm:electronic-warfare,
        ngm:information-warfare,
        ngm:space-operations,
        ngm:strategic-communication ;
    vc:requires ngm:attribution-capability,
        ngm:classified-compute-infrastructure,
        ngm:cyber-doctrine,
        ngm:signals-intelligence,
        ngm:sovereign-authority,
        ngm:trained-cyber-operators,
        ngm:vulnerability-research ;
    vc:slug "cyber-security-and-military" ;
    vc:sourceDomain "infrastructure" ;
    vc:standardizedBy ngm:iso-27001,
        ngm:mitre-att-and-ck,
        ngm:nato-ccdcoe,
        ngm:nist-cybersecurity-framework,
        ngm:stix-taxii,
        ngm:tallinn-manual,
        ngm:un-gge ;
    vc:supports ngm:allied-coalition-operations,
        ngm:counter-proliferation,
        ngm:counter-terrorism,
        ngm:five-eyes-intelligence,
        ngm:national-defence,
        ngm:nato-article-5,
        ngm:sanctions-enforcement ;
    vc:uses ngm:command-and-control-infrastructure,
        ngm:implants,
        ngm:initial-access-brokers,
        ngm:living-off-the-land-techniques,
        ngm:malware,
        ngm:supply-chain-compromise,
        ngm:wiper-malware,
        ngm:zero-day-exploits .

ngm:dall-e-3 a owl:Class ;
    rdfs:label "DALL-E 3"@en ;
    rdfs:comment "DALL-E 3 is a text-to-image generation model developed by OpenAI that produces images from natural language descriptions. It improves prompt adherence over earlier versions by reformulating user prompts with a language model."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:diffusion-model ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:language-model ],
        ngm:text-to-image-generation ;
    vc:enables ngm:image-generation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:diffusion-model,
        ngm:language-model ;
    vc:slug "dall-e-3" ;
    vc:sourceDomain "generative-ai" .

ngm:data-augmentation a owl:Class ;
    rdfs:label "Data Augmentation"@en ;
    rdfs:comment "Data augmentation is a machine learning technique that expands a training dataset by applying label-preserving transformations or synthesising new examples from existing data. Typical methods include geometric and photometric image transforms, noise injection, and generative model sampling such as GAN-produced samples. It improves model generalisation and robustness, mitigating overfitting when labelled data is scarce."@en ;
    rdfs:subClassOf ngm:machine-learning-technique ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:generative-adversarial-networks,
        ngm:synthetic-data-generator ;
    vc:slug "data-augmentation" ;
    vc:sourceDomain "ai" .

ngm:data-breach a owl:Class ;
    rdfs:label "Data Breach"@en ;
    rdfs:comment "A Data Breach is a security incident in which sensitive, protected, or confidential data is accessed, disclosed, copied, transmitted, or destroyed by an unauthorised actor, whether through external attack, insider threat, or accidental exposure. In AI contexts, data breaches can compromise training datasets, model weights, inference outputs, or user interaction logs, triggering GDPR notification obligations (within 72 hours to supervisory authorities), regulatory penalties, and reputational damage. AI systems increase both the attack surface (by aggregating and processing large personal-data collections) and the potential for novel breach vectors such as model-inversion attacks and membership-inference attacks that reconstruct or identify individuals from model outputs without direct database access."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:security ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:vulnerability ],
        ngm:ai-governance-and-ethics,
        ngm:risk ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:enables ngm:privacy ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:access-control,
        ngm:audit-trail,
        ngm:cybersecurity,
        ngm:data-protection,
        ngm:privacy-preserving-data-mining,
        ngm:regulatory-compliance ;
    vc:requires ngm:security,
        ngm:vulnerability ;
    vc:slug "data-breach" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:risk-assessment,
        ngm:risk-management ;
    vc:uses ngm:membership-inference,
        ngm:model-inversion .

ngm:data-consistency a owl:Class ;
    rdfs:label "Data Consistency"@en ;
    rdfs:comment "Data consistency is the guarantee that data remains valid, coherent and in agreement across copies, transactions and nodes of a system. In distributed systems it spans a spectrum from strong consistency, where all readers observe the latest write, to eventual consistency, where replicas converge over time. It is a core correctness property traded off against availability and latency, and it underpins fault-tolerant data layers."@en ;
    rdfs:subClassOf ngm:distributed-systems ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:data-layer,
        ngm:fault-tolerance ;
    vc:slug "data-consistency" ;
    vc:sourceDomain "infrastructure" .

ngm:data-fabric a owl:Class ;
    rdfs:label "Data Fabric"@en ;
    rdfs:comment "A data fabric is an architectural approach that provides a unified, metadata-driven layer for accessing, integrating and governing data across heterogeneous and distributed sources. It uses active metadata, knowledge graphs and automation to connect data without forcing physical consolidation. By abstracting underlying systems it delivers consistent discovery, access and governance, reducing the friction of fragmented data estates."@en ;
    rdfs:subClassOf ngm:infra-data-management ;
    skos:broader ngm:infra-data-management ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:metadata-management ;
    vc:slug "data-fabric" ;
    vc:sourceDomain "data" .

ngm:data-federation a owl:Class ;
    rdfs:label "Data Federation"@en ;
    rdfs:comment "Data federation is a data integration technique that presents multiple distributed and heterogeneous data sources as a single virtual database queryable in place, without physically moving or copying the data. A federation engine decomposes queries, pushes work to source systems and combines results on the fly. It enables real-time unified access and is a core mechanism behind data virtualization and integration interfaces."@en ;
    rdfs:subClassOf ngm:infra-data-management ;
    skos:broader ngm:infra-data-management ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:data-integration-interface,
        ngm:data-virtualization ;
    vc:slug "data-federation" ;
    vc:sourceDomain "data" .

ngm:data-lineage-tracking a owl:Class ;
    rdfs:label "Data Lineage Tracking"@en ;
    rdfs:comment "Data lineage tracking is the automated capture and maintenance of provenance metadata as data is created, transformed and moved across pipelines and platforms. It instruments transformations and queries to build a continuously updated lineage graph rather than a static map. Often expressed using provenance vocabularies such as PROV-O, it underpins reproducibility, trust and governance in data fabric architectures."@en ;
    rdfs:subClassOf ngm:infra-data-management ;
    skos:broader ngm:infra-data-management ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:data-fabric-architecture,
        ngm:provenance-ontology-prov-o ;
    vc:slug "data-lineage-tracking" ;
    vc:sourceDomain "data" .

ngm:data-management-system a owl:Class ;
    rdfs:label "Data Management System"@en ;
    rdfs:comment "A data management system is software that stores, organises, secures and provides controlled access to data throughout its lifecycle. It encompasses capabilities for ingestion, modelling, querying, integrity enforcement and governance, with database management systems and graph databases as common specialisations. It is the foundational platform on which metadata standards and downstream applications depend."@en ;
    rdfs:subClassOf ngm:infra-data-management ;
    skos:broader ngm:infra-data-management ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:graph-database,
        ngm:metadata-standard ;
    vc:slug "data-management-system" ;
    vc:sourceDomain "data" .

ngm:data-portability a owl:Class ;
    rdfs:label "Data Portability"@en ;
    rdfs:comment "Data portability is the ability for users to obtain, move and reuse their personal or application data across services in a structured, machine-readable format without lock-in. It is both a legal right under regimes such as GDPR and a technical property enabled by open formats and interoperable storage. In decentralised-web designs it lets individuals carry data between providers, shifting control from platforms to users."@en ;
    rdfs:subClassOf ngm:infra-data-management ;
    skos:broader ngm:infra-data-management ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:decentralised-web,
        ngm:solid ;
    vc:slug "data-portability" ;
    vc:sourceDomain "data" .

ngm:data-preprocessing a owl:Class ;
    rdfs:label "Data Preprocessing"@en ;
    rdfs:comment "Data preprocessing is the stage of a machine learning workflow that transforms raw data into a clean, consistent form suitable for modelling. It encompasses cleaning, normalisation, encoding, imputation and feature engineering to remove noise and align scales and types. The quality of preprocessing strongly determines downstream model accuracy and is a prerequisite for reliable training."@en ;
    rdfs:subClassOf ngm:machine-learning-technique ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:data-cleaning,
        ngm:feature-engineering ;
    vc:slug "data-preprocessing" ;
    vc:sourceDomain "ai" .

ngm:data-redundancy a owl:Class ;
    rdfs:label "Data Redundancy"@en ;
    rdfs:comment "Data redundancy is the deliberate storage of duplicate or recoverable copies of data so that information survives hardware failure, corruption or loss. Implemented through replication, mirroring, RAID and erasure or forward-error-correction codes, it trades extra capacity for durability and availability. It is a foundational reliability technique in storage systems and distributed infrastructure."@en ;
    rdfs:subClassOf ngm:infra-computing-and-cloud ;
    skos:broader ngm:infra-computing-and-cloud ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:data-storage,
        ngm:forward-error-correction ;
    vc:slug "data-redundancy" ;
    vc:sourceDomain "infrastructure" .

ngm:data-registry a owl:Class ;
    rdfs:label "Data Registry"@en ;
    rdfs:comment "A Data Registry is a centralised or federated catalogue that maintains authoritative records of data assets, their schemas, provenance, ownership, and access policies. In digital and metaverse infrastructure, registries track digital assets, avatar identities, spatial anchors, and ontological terms, enabling discovery, governance, and interoperability across distributed systems. Blockchain-anchored registries provide tamper-evident provenance and decentralised control."@en ;
    rdfs:subClassOf ngm:infra-data-management ;
    skos:broader ngm:infra-data-management ;
    vc:enables ngm:data-governance,
        ngm:data-interoperability ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:slug "data-registry" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:data-access-interface,
        ngm:digital-asset-management ;
    vc:uses ngm:blockchain,
        ngm:digital-identity .

ngm:database-systems a owl:Class ;
    rdfs:label "Database Systems"@en ;
    rdfs:comment "Database systems are software platforms that store, organise and retrieve structured data while enforcing consistency, concurrency and durability."@en ;
    rdfs:subClassOf ngm:distributed-systems ;
    vc:enables ngm:graph-databases ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:slug "database-systems" ;
    vc:sourceDomain "distributed-systems" .

ngm:de-fi-services a owl:Class ;
    rdfs:label "De Fi Services"@en ;
    rdfs:comment "Decentralised Finance (DeFi) Services are financial products and protocols—including lending, borrowing, automated market-making, and derivatives—implemented as smart contracts on programmable blockchains without centralised intermediaries. DeFi Services enable permissionless, non-custodial access to financial primitives and are a key component of virtual economies within metaverse and spatial computing platforms."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:blockchain ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:smart-contract ],
        ngm:digital-asset-ecosystem,
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:de-fi,
        ngm:financial-transactions ;
    vc:requires ngm:blockchain,
        ngm:smart-contract ;
    vc:slug "de-fi-services" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:cryptocurrency,
        ngm:digital-asset .

ngm:decarbonisation a owl:Class ;
    rdfs:label "Decarbonisation"@en ;
    rdfs:comment "Decarbonisation is the systematic reduction of carbon dioxide and other greenhouse-gas emissions from an activity, organisation or economy, ultimately toward net zero. It combines energy efficiency, electrification, renewable energy procurement and removal of residual emissions, often guided by science-based targets. For energy-intensive systems such as blockchains it is the pathway to credible carbon-neutral operation."@en ;
    rdfs:subClassOf ngm:sustainability ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:carbon-neutral-blockchain,
        ngm:science-based-targets ;
    vc:slug "decarbonisation" ;
    vc:sourceDomain "governance" .

ngm:decentralized-finance a owl:Class ;
    rdfs:label "Decentralized Finance"@en ;
    rdfs:comment "Decentralized finance (DeFi) is an ecosystem of financial services built on public blockchains using smart contracts to provide lending, trading, derivatives and asset management without traditional intermediaries. Protocols are composable and permissionless, letting users transact directly from self-custodied wallets. DeFi introduces novel mechanisms such as automated market makers and liquidity pools, along with risks like impermanent loss and smart-contract exploits."@en ;
    rdfs:subClassOf ngm:bc-defi-and-economics ;
    skos:broader ngm:bc-defi-and-economics ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:decentralized-governance,
        ngm:impermanent-loss ;
    vc:slug "decentralized-finance" ;
    vc:sourceDomain "blockchain" .

ngm:decentralized-trading a owl:Class ;
    rdfs:label "Decentralized Trading"@en ;
    rdfs:comment "Decentralized trading is the exchange of crypto-assets directly between parties through smart contracts on a blockchain, without a centralized intermediary holding custody of funds or matching orders. Trades settle peer-to-contract against liquidity pools or order books governed by deterministic on-chain logic, giving traders self-custody and permissionless access. It is the activity layer enabled by decentralized exchanges and automated market makers."@en ;
    rdfs:subClassOf ngm:bc-defi-and-economics ;
    skos:broader ngm:bc-defi-and-economics ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:automated-market-making,
        ngm:decentralized-exchange-dex ;
    vc:slug "decentralized-trading" ;
    vc:sourceDomain "blockchain" .

ngm:deduplication a owl:Class ;
    rdfs:label "Deduplication"@en ;
    rdfs:comment "Deduplication is a data-management technique that eliminates redundant copies of identical data by storing a single instance and referencing it wherever the same content recurs. Implementations typically hash data chunks and compare digests, so identical blocks resolve to the same stored object. It reduces storage footprint, backup windows, and network transfer in content-addressed and backup systems."@en ;
    rdfs:subClassOf ngm:data-management ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:content-addressing,
        ngm:hash-function ;
    vc:slug "deduplication" ;
    vc:sourceDomain "data" .

ngm:deep-learning-domain a owl:Class ;
    rdfs:label "Deep Learning Domain"@en ;
    rdfs:comment "The Deep Learning Domain covers learning with multi-layer neural networks that build hierarchical representations from data. Its scope includes network architectures, training and optimisation at scale, and representation learning. It is a sub-area of the Machine Learning Domain that supplies the dominant methods for perception and language. The boundary excludes shallow models such as linear classifiers and decision trees, which remain in the broader Machine Learning Domain."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:machine-learning-domain ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:representation-learning ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:linear-algebra ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:backpropagation ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:recurrent-neural-network ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:transformer ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:convolutional-neural-network ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:compute-layer ],
        ngm:machine-learning-domain ;
    vc:enables ngm:computer-vision-domain,
        ngm:generative-modelling-domain,
        ngm:natural-language-processing-domain ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:backpropagation,
        ngm:convolutional-neural-network,
        ngm:recurrent-neural-network,
        ngm:representation-learning,
        ngm:transformer ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:compute-layer,
        ngm:linear-algebra,
        ngm:machine-learning-domain ;
    vc:slug "deep-learning-domain" ;
    vc:sourceDomain "deep-learning" .

ngm:deep-research a owl:Class ;
    rdfs:label "Deep Research"@en ;
    rdfs:comment "Deep research is an agentic AI capability in which a language model autonomously plans and executes multi-step investigations, browsing the web, reading sources, and synthesising a cited report on a topic. The agent decomposes a query into sub-questions, iteratively gathers evidence across many pages, and reconciles findings rather than answering from parametric memory alone. It trades latency for depth, breadth of sources, and verifiable citations."@en ;
    rdfs:subClassOf ngm:ai-application ;
    skos:broader ngm:ai-application ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:agents,
        ngm:computer-use-and-browser-agents ;
    vc:slug "deep-research" ;
    vc:sourceDomain "ai" .

ngm:definitions-and-frameworks-for-metaverse a owl:Class ;
    rdfs:label "Definitions and frameworks for Metaverse"@en ;
    rdfs:comment "This page surveys competing definitions and analytical frameworks used to characterise the metaverse, drawing from industry reports, academic literature, and standards bodies. It compares platform-centric, social-first, and open-interoperability framings; examines primitives such as persistence, embodiment, real-time 3D graphics, and economic actors; and contextualises failed early attempts (Decentraland, Sandbox) against more enduring platforms (Roblox). The analysis informs design principles for trust, value transfer, and AI-mediated governance in spatial social systems."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:telecollaboration ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:metaverse ],
        ngm:metaverse-ontology,
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:enables ngm:definitions-and-frameworks-for-metaverse,
        ngm:digital-commerce ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:metaverse,
        ngm:telecollaboration ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:ai-governance,
        ngm:digital-twin ;
    vc:slug "definitions-and-frameworks-for-metaverse" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:augmented-reality,
        ngm:blockchain .

ngm:demand-planning a owl:Class ;
    rdfs:label "Demand Planning"@en ;
    rdfs:comment "Demand planning is the supply-chain process of estimating future customer demand and aligning inventory, production, and procurement to meet it efficiently. It consolidates statistical forecasts, market intelligence, and business constraints into an actionable plan that minimises stockouts and excess holding. Modern demand planning increasingly relies on time-series forecasting and machine-learning models fed by historical sales and external signals."@en ;
    rdfs:subClassOf ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:demand-forecasting,
        ngm:time-series-forecasting ;
    vc:slug "demand-planning" ;
    vc:sourceDomain "supply-chain" .

ngm:demand-side-response a owl:Class ;
    rdfs:label "Demand-Side Response"@en ;
    rdfs:comment "Demand-side response is the adjustment of electricity consumption by end users in reaction to grid signals, time-of-use tariffs, or scarcity events, rather than altering generation. Smart-home and building automation systems shift or curtail loads such as heating, EV charging, and appliances to flatten peaks and exploit cheap or low-carbon periods. It improves grid reliability and lets consumers reduce energy cost and carbon footprint."@en ;
    rdfs:subClassOf ngm:sustainability ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:home-assistant ;
    vc:slug "demand-side-response" ;
    vc:sourceDomain "infrastructure" .

ngm:dense-retrieval a owl:Class ;
    rdfs:label "Dense Retrieval"@en ;
    rdfs:comment "Dense retrieval is an information-retrieval method that encodes queries and documents into dense vector embeddings and ranks results by vector similarity rather than lexical term overlap. A learned bi-encoder maps text into a shared semantic space so that conceptually related items are close even without shared keywords. It underpins semantic search and retrieval-augmented generation, often paired with approximate nearest-neighbour indexes for scale."@en ;
    rdfs:subClassOf ngm:information-retrieval ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:embedding-search,
        ngm:semantic-search ;
    vc:slug "dense-retrieval" ;
    vc:sourceDomain "ai" .

ngm:derivative-control a owl:Class ;
    rdfs:label "Derivative Control"@en ;
    rdfs:comment "Derivative control responds to the rate of change of system error, providing damping that opposes oscillations and improves transient response."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:error-signal ],
        ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:enables ngm:faster-convergence,
        ngm:oscillation-damping,
        ngm:reduced-overshoot,
        ngm:stability-improvement ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:damping-action,
        ngm:derivative-gain,
        ngm:error-rate-measurement ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires ngm:error-signal,
        ngm:gain-tuning,
        ngm:low-pass-filtering,
        ngm:time-derivative ;
    vc:slug "derivative-control" ;
    vc:sourceDomain "robotics" .

ngm:dex a owl:Class ;
    rdfs:label "DEX"@en ;
    rdfs:comment "The common abbreviation for a decentralised exchange, a smart-contract trading venue where users swap assets without surrendering custody to a central operator."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:liquidity-pool ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:smart-contract ],
        ngm:decentralised-exchange ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:liquidity-pool,
        ngm:smart-contract ;
    vc:slug "dex" ;
    vc:sourceDomain "blockchain" .

ngm:dialogue-systems a owl:Class ;
    rdfs:label "Dialogue Systems"@en ;
    rdfs:comment "Dialogue systems are software systems that converse with users in natural language across one or more turns. They include task-oriented assistants and open-domain conversational agents."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:natural-language-processing ],
        ngm:conversational-ai ;
    vc:enables ngm:chatbot,
        ngm:customer-support-automation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:natural-language-processing ;
    vc:slug "dialogue-systems" ;
    vc:sourceDomain "nlp" .

ngm:didcomm-v2 a owl:Class ;
    rdfs:label "DIDComm v2"@en ;
    rdfs:comment "DIDComm v2 is a transport-agnostic, end-to-end encrypted messaging protocol that lets two or more parties communicate securely using their Decentralized Identifiers. Messages are signed and encrypted with keys discovered from DID documents, providing confidentiality, authenticity, and mutual authentication independent of any central server or transport. It is the secure communication layer underpinning self-sovereign identity interactions such as verifiable credential exchange."@en ;
    rdfs:subClassOf ngm:cryptographic-protocol ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:decentralized-identifiers,
        ngm:self-sovereign-identity ;
    vc:slug "didcomm-v2" ;
    vc:sourceDomain "security" .

ngm:difficulty-target a owl:Class ;
    rdfs:label "Difficulty Target"@en ;
    rdfs:comment "A 256-bit threshold value in proof-of-work blockchains that a block's hash must be numerically less than or equal to for the block to be considered valid. The difficulty target is periodically recalculated by the Difficulty Adjustment algorithm to maintain a consistent average inter-block time regardless of changes in aggregate hash power. It is the primary mechanism by which mining difficulty is quantified and enforced across all network participants."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptographic-hash-function ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:proof-of-work ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:difficulty-adjustment ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:nonce ],
        ngm:bc-protocol-and-consensus,
        ngm:blockchain-entity,
        ngm:consensus-protocol ;
    skos:broader ngm:bc-protocol-and-consensus ;
    vc:dependsOn ngm:consensus-rule,
        ngm:network-hash-rate ;
    vc:enables ngm:blockchain-network,
        ngm:consensus-mechanism ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:difficulty-adjustment ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:bitcoin-mining,
        ngm:block-reward,
        ngm:blockchain-energy-consumption,
        ngm:halving,
        ngm:hash-function,
        ngm:merkle-root,
        ngm:mining-pool ;
    vc:requires ngm:cryptographic-hash-function,
        ngm:nonce,
        ngm:proof-of-work ;
    vc:slug "difficulty-target" ;
    vc:sourceDomain "blockchain" .

ngm:diffusion-of-innovations-theory a owl:Class ;
    rdfs:label "Diffusion of Innovations Theory"@en ;
    rdfs:comment "Diffusion of Innovations Theory, formulated by Everett Rogers, explains how, why, and at what rate new ideas and technologies spread through a social system over time. It segments adopters into innovators, early adopters, early majority, late majority, and laggards, and identifies perceived attributes such as relative advantage, compatibility, and trialability that govern uptake. It provides the analytical lens for understanding and forecasting technology adoption curves."@en ;
    rdfs:subClassOf ngm:economics ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:adoption-of-convergent-technologies,
        ngm:ai-adoption ;
    vc:slug "diffusion-of-innovations-theory" ;
    vc:sourceDomain "governance" .

ngm:digital-asset-custody a owl:Class ;
    rdfs:label "Digital Asset Custody"@en ;
    rdfs:comment "Digital asset custody is the safekeeping and administration of cryptographic private keys that control crypto-assets on behalf of their owners. Custodians use controls such as hardware security modules, multi-party computation, and cold storage to protect keys against theft, loss, and unauthorised use while meeting regulatory and audit requirements. It is the trust and security backbone enabling institutional participation in digital-asset markets."@en ;
    rdfs:subClassOf ngm:digital-asset ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:institutional-custody,
        ngm:securities-regulation ;
    vc:slug "digital-asset-custody" ;
    vc:sourceDomain "blockchain" .

ngm:digital-cinema a owl:Class ;
    rdfs:label "Digital Cinema"@en ;
    rdfs:comment "Digital cinema is the production, distribution, and theatrical projection of motion pictures using digital files rather than photochemical film. It is governed by the DCI specification, which defines the Digital Cinema Package (DCP) format, JPEG 2000 image compression, encryption, and colour standards for cinema-grade exhibition. It enables consistent high-resolution playback, secure content delivery, and the broader shift to file-based proprietary video pipelines."@en ;
    rdfs:subClassOf ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:proprietary-video ;
    vc:slug "digital-cinema" ;
    vc:sourceDomain "metaverse" .

ngm:digital-democracy a owl:Class ;
    rdfs:label "Digital Democracy"@en ;
    rdfs:comment "Digital democracy is the use of digital technologies to broaden and deepen citizen participation in political decision-making, including online deliberation, e-petitions, participatory budgeting, and novel voting mechanisms. It seeks to make governance more transparent, inclusive, and responsive by lowering the barriers to engagement. It encompasses both incremental e-government tools and experimental collective-choice systems such as quadratic voting."@en ;
    rdfs:subClassOf ngm:governance ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:civic-participation,
        ngm:quadratic-voting ;
    vc:slug "digital-democracy" ;
    vc:sourceDomain "governance" .

ngm:digital-entertainment a owl:Class ;
    rdfs:label "Digital Entertainment"@en ;
    rdfs:comment "Digital Entertainment encompasses interactive and passive media experiences delivered through digital platforms, including video games, streaming services, virtual concerts, and immersive XR content. Within the metaverse context, digital entertainment drives user engagement and economic activity, often integrating blockchain-based ownership of digital assets and in-world economies."@en ;
    rdfs:subClassOf ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:enables ngm:metaverse-application ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:relatedTo ngm:game-development,
        ngm:nft,
        ngm:virtual-reality ;
    vc:slug "digital-entertainment" ;
    vc:sourceDomain "spatial-computing" ;
