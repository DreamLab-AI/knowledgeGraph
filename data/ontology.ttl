        ngm:stakeholder-consultation ;
    vc:slug "policy-framework" ;
    vc:sourceDomain "governance" ;
    vc:standardizedBy ngm:iso-iec-jtc1-sc42,
        ngm:iso-standards,
        ngm:nist .

ngm:precision a owl:Class ;
    rdfs:label "Precision"@en ;
    rdfs:comment "A classification performance metric representing the proportion of positive predictions made by an artificial intelligence model that are actually correct, calculated as the ratio of true positives to all positive predictions (true positives plus false positives), measuring the model's ability to avoid false alarms and providing critical insight into prediction reliability, particularly important in applications where the cost or consequence of false positive errors is significant."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:false-positive ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:true-positive ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:classification ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:confusion-matrix ],
        ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:bridgesTo ngm:evaluation-metric,
        ngm:f1-score,
        ngm:information-retrieval ;
    vc:contrastsWith ngm:accuracy,
        ngm:recall,
        ngm:specificity ;
    vc:dependsOn ngm:classification-threshold ;
    vc:enables ngm:threshold-optimisation ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:false-positive,
        ngm:true-positive ;
    vc:isPartOf ngm:model-evaluation,
        ngm:model-performance ;
