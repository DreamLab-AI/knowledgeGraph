# Omnidirectional Robot
rb:OmnidirectionalRobot a owl:Class ;
    rdfs:subClassOf rb:WheeledRobot ;
    rdfs:label "Omnidirectional Robot"@en ;
    rdfs:comment "Omnidirectional robot uses mecanum wheels or omniwheels for holonomic motion."@en ;
    skos:prefLabel "Omnidirectional Robot"@en ;
    dcterms:identifier "RB-0116" ;
    dcterms:subject "rb" ;
    dcterms:type "established" ;
    dcterms:conformsTo "0.95"^^xsd:decimal .

# Mecanum Wheel Robot
rb:MecanumRobot a owl:Class ;
    rdfs:subClassOf rb:OmnidirectionalRobot ;
    rdfs:label "Mecanum Wheel Robot"@en ;
    rdfs:comment "Mecanum robot uses four mecanum wheels with angled rollers enabling true omnidirectional movement."@en ;
    skos:prefLabel "Mecanum Wheel Robot"@en ;
    dcterms:identifier "RB-0117" ;
    dcterms:subject "rb" ;
    dcterms:type "established" ;
    dcterms:conformsTo "0.95"^^xsd:decimal .

