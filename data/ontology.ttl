ngm:encryption a owl:Class ;
    rdfs:label "Encryption"@en ;
    rdfs:comment "Encryption is the cryptographic process of transforming plaintext data into ciphertext using a defined algorithm and secret key, rendering the data unintelligible to any party that does not possess the corresponding decryption key, thereby ensuring confidentiality. Symmetric schemes such as AES-GCM use a single shared secret for both encryption and decryption, providing authenticated encryption with associated data (AEAD) in a single pass; asymmetric schemes such as RSA-OAEP and ECDH use mathematically linked key pairs where the public key encrypts and the private key decrypts. Hybrid constructions combine both paradigms — using asymmetric key exchange to establish a shared session key and then symmetric ciphers for bulk data — as exemplified by TLS 1.3. Encryption is foundational to data-at-rest protection, data-in-transit security, end-to-end encrypted messaging, confidential computing, and post-quantum cryptography."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:random-number-generation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptography ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:public-key-infrastructure ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:key-management ],
        ngm:cryptography ;
    vc:bridgesTo ngm:blockchain,
        ngm:federated-learning ;
    vc:contrastsWith ngm:obfuscation,
        ngm:steganography ;
    vc:enables ngm:confidential-computing,
        ngm:data-protection,
        ngm:end-to-end-encryption,
        ngm:privacy,
        ngm:secure-communication ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:implements ngm:aes,
        ngm:elliptic-curve-cryptography,
        ngm:post-quantum-cryptography,
        ngm:rsa ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:access-control,
        ngm:homomorphic-encryption,
        ngm:zero-knowledge ;
    vc:requires ngm:cryptography,
        ngm:key-management,
        ngm:public-key-infrastructure,
        ngm:random-number-generation ;
    vc:slug "encryption" ;
    vc:sourceDomain "security" ;
    vc:standardizedBy ngm:iso-iec-18033,
        ngm:nist ;
    vc:supports ngm:secure-multi-party-computation,
        ngm:transport-layer-security ;
    vc:uses ngm:digital-signature,
        ngm:hash-function,
        ngm:key-exchange .

ngm:identity-management a owl:Class ;
    rdfs:label "Identity Management"@en ;
    rdfs:comment "Identity management refers to the systems, protocols, and policies enabling individuals and organisations to create, control, and verify digital identities. In decentralised contexts this encompasses DID architectures, verifiable credentials, and self-sovereign identity models that eliminate reliance on centralised authorities through cryptographic proofs and distributed ledger infrastructure."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:public-key-infrastructure ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:decentralised-identifier ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:digital-wallet ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptographic-key-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:verifiable-credential-vc ],
        ngm:infra-security-and-identity ;
    skos:broader ngm:infra-security-and-identity ;
    vc:bridgesTo ngm:artificial-intelligence-ethics,
        ngm:governance ;
    vc:contrastsWith ngm:centralised-identity,
        ngm:federated-identity ;
    vc:dependsOn ngm:blockchain,
        ngm:distributed-ledger-technology ;
