ngm:surface-normal a owl:Class ;
    rdfs:label "Surface Normal"@en ;
    rdfs:comment "A surface normal is a vector perpendicular to a surface at a given point, indicating the orientation of that surface in space. Normals are fundamental to lighting and shading calculations, because the angle between a normal and a light direction governs how much illumination a surface receives. In computer graphics and 3D reconstruction, surface normals drive realistic shading, normal mapping, and the recovery of fine geometric detail."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:depth-estimation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:scene-geometry ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:point-cloud ],
        ngm:scene-geometry ;
    vc:bridgesTo ngm:normal-mapping ;
    vc:dependsOn ngm:scene-geometry ;
    vc:enables ngm:ambient-occlusion,
        ngm:physically-based-rendering,
        ngm:rendering ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:normal-mapping,
        ngm:point-cloud ;
    vc:isPartOf ngm:scene-geometry ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:ambient-occlusion,
        ngm:depth-estimation,
        ngm:point-cloud ;
    vc:requires ngm:depth-estimation,
        ngm:scene-geometry ;
    vc:slug "surface-normal" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:physically-based-rendering,
        ngm:rendering ;
    vc:uses ngm:normal-mapping,
        ngm:photogrammetry .

ngm:synthetic-biology a owl:Class ;
    rdfs:label "Synthetic Biology"@en ;
    rdfs:comment "Synthetic biology is a field that applies engineering principles to design and construct biological systems and organisms. It combines biology, genetics, and engineering."@en ;
    rdfs:subClassOf ngm:ai-research-area ;
