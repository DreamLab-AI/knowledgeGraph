        ngm:point-cloud,
        ngm:sensor-fusion,
        ngm:visual-odometry ;
    vc:slug "stereo-camera" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:camera-parameters .

ngm:stranded-energy-monetisation a owl:Class ;
    rdfs:label "Stranded Energy Monetisation"@en ;
    rdfs:comment "Stranded energy monetisation is the practice of converting otherwise wasted or non-transmittable electricity—including curtailed renewable generation, flared natural gas, and grid-overflow surplus—into economic value through flexible, interruptible load processes such as Bitcoin mining or electrolyser hydrogen production. By co-locating computation or industrial loads at the energy source, it captures value that cannot reach load centres due to grid constraints."@en ;
    rdfs:subClassOf ngm:stranded-energy ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:blockchain-sustainability,
        ngm:demand-response-mining,
        ngm:methane-mitigation-mining ;
    vc:slug "stranded-energy-monetisation" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:bitcoin-mining,
        ngm:demand-response,
        ngm:methane-abatement .

ngm:technology-adoption a owl:Class ;
    rdfs:label "Technology Adoption"@en ;
    rdfs:comment "The process by which individuals, organizations, and societies integrate new technologies into their workflows, practices, and systems, encompassing awareness, etrial, implementation, and sustained use across AI, blockchain, metaverse, and robotics domains."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:change-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:awareness ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:training ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:infrastructure ],
        ngm:dc-protocol-and-infra ;
    skos:broader ngm:dc-protocol-and-infra ;
    vc:enables ngm:competitive-advantage,
        ngm:digital-transformation,
        ngm:innovation-diffusion ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:awareness,
        ngm:evaluation,
        ngm:implementation,
        ngm:sustained-use,
        ngm:trial ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires ngm:change-management,
        ngm:infrastructure,
        ngm:stakeholder-buy-in,
        ngm:training ;
    vc:slug "technology-adoption" ;
    vc:sourceDomain "distributed-collaboration" .

ngm:tendermint a owl:Class ;
    rdfs:label "Tendermint"@en ;
    rdfs:comment "Tendermint is a Byzantine fault-tolerant (BFT) consensus engine that implements a partially synchronous, round-based, leader-elected protocol providing deterministic finality on each block. It separates the consensus layer from the application layer via the Application BlockChain Interface (ABCI), allowing any deterministic state machine to be driven by its consensus guarantees. Tendermint is the consensus core of the Cosmos SDK and has influenced several subsequent BFT designs, offering safety guarantees as long as fewer than one-third of validator voting power is Byzantine."@en ;
    rdfs:subClassOf ngm:bc-protocol-and-consensus ;
    skos:broader ngm:bc-protocol-and-consensus ;
    vc:contrastsWith ngm:proof-of-work ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:implements ngm:byzantine-fault-tolerance,
        ngm:deterministic-finality ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:cosmos-ibc,
        ngm:practical-byzantine-fault-tolerance ;
    vc:slug "tendermint" ;
    vc:sourceDomain "blockchain" .

ngm:text-to-image-generation a owl:Class ;
    rdfs:label "Text-to-Image Generation"@en ;
    rdfs:comment "Text-to-image generation is a class of generative AI techniques that synthesise photorealistic or stylised images from natural-language textual descriptions, typically using diffusion models, autoregressive transformers, or hybrid architectures trained on large paired datasets of images and captions. The process involves encoding the text prompt into a latent representation that conditions image synthesis, iteratively denoising random noise into structured visual output guided by the conditioning signal. Systems such as DALL-E 3, Stable Diffusion, Midjourney, and Imagen exemplify the paradigm. Text-to-image generation has transformed creative workflows while raising contested questions about copyright, consent, and synthetic media authenticity."@en ;
    rdfs:subClassOf ngm:image-generation ;
    vc:contrastsWith ngm:proprietary-image-generation ;
    vc:enables ngm:multimodal-ai,
        ngm:prompt-engineering ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:diffusion-model,
        ngm:generative-ai,
        ngm:text-to-image ;
    vc:slug "text-to-image-generation" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:diffusion-models,
        ngm:latent-diffusion,
        ngm:transformer-architecture .

ngm:texture-mapping a owl:Class ;
    rdfs:label "Texture Mapping"@en ;
    rdfs:comment "Texture Mapping is the technique of projecting a 2D image (texture) onto a 3D surface to add surface detail, colour, and material appearance without increasing geometric complexity. Common forms include UV mapping, normal mapping, and physically-based rendering (PBR) texture sets."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:computer-graphics ],
        ngm:sc-display-and-rendering ;
    skos:broader ngm:sc-display-and-rendering ;
    vc:enables ngm:differentiable-rendering,
        ngm:real-time-rendering ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:3-d-rendering-engine ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:computer-graphics ;
    vc:slug "texture-mapping" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:compute-shader,
        ngm:pixel-shader,
        ngm:procedural-texture .

ngm:timelock a owl:Class ;
    rdfs:label "Timelock"@en ;
    rdfs:comment "A timelock is a cryptographic or smart-contract mechanism that prevents a transaction, function call, or asset transfer from executing until a specified block height or Unix timestamp has been reached. Timelocks enforce temporal constraints on blockchain operations, separating the proposal of an action from its execution to allow inspection, challenge, or cancellation during a mandatory delay window."@en ;
    rdfs:subClassOf ngm:smart-contract ;
    vc:enables ngm:decentralized-governance,
        ngm:on-chain-governance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.85"^^xsd:float ;
    vc:relatedTo ngm:escrow-system,
        ngm:htlc,
        ngm:vesting-schedule ;
    vc:slug "timelock" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:access-control-module .

ngm:trajectory-generation a owl:Class ;
    rdfs:label "Trajectory Generation"@en ;
    rdfs:comment "The process of computing a time-parameterized path that specifies the position, velocity, and acceleration of a robot's joints or end-effector as functions of time, enabling smooth motion from start to goal configurations while respecting kinematic and dynamic constraints."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:start-configuration ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:goal-configuration ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:path-planning ],
        ngm:motion-planning,
        ngm:robo-navigation-and-planning ;
    skos:broader ngm:robo-navigation-and-planning ;
    vc:enables ngm:robot-motion,
        ngm:task-execution ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires ngm:goal-configuration,
        ngm:path-planning,
        ngm:start-configuration ;
    vc:slug "trajectory-generation" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:forward-kinematics,
        ngm:inverse-kinematics .

ngm:trust a owl:Class ;
    rdfs:label "Trust"@en ;
    rdfs:comment "Trust is a cognitive and relational disposition in which an agent accepts vulnerability to the actions of another party, based on a positive expectation that the trusted party will act competently, honestly, and benevolently towards the trusting party's interests. In sociotechnical and AI contexts, trust extends beyond interpersonal relationships to encompass institutional trust in organisations, systems trust in technological artefacts, and algorithmic trust in AI decision-making processes. Trust is simultaneously a psychological state, a social institution, and a design property of systems, and its calibration — whether systems are trusted appropriately, too much, or too little — has profound implications for human welfare, democratic function, and the effective deployment of AI."@en ;
    rdfs:subClassOf ngm:trust-framework ;
    vc:enables ngm:trust-establishment,
        ngm:trust-infrastructure,
        ngm:trust-score-metric ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:ai-trustworthiness,
        ngm:trust-and-safety,
        ngm:trust-architecture ;
    vc:slug "trust" ;
    vc:sourceDomain "governance" ;
    vc:supports ngm:ai-trust-risk-and-security-management,
        ngm:trust-in-automation,
        ngm:trust-over-ip-foundation .

