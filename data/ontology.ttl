# Token Economics Domain
blockchain:TokenEconomicsDomain rdf:type owl:Class ;
    rdfs:label "Token Economics Domain"@en ;
    rdfs:comment "The TokenEconomicsDomain represents a specialized sub-domain within blockchain technology that encompasses economic mechanisms, incentive structures, token systems, and monetary models that govern blockchain ecosystems. This domain includes cryptocurrency design and properties, token standards and specifications (ERC-20, ERC-721, ERC-1155), tokenomics models (supply schedules, inflation, burning mechanisms, vesting), incentive alignment mechanisms (staking rewards, transaction fees, block rewards, penalty mechanisms), economic security models (cost of attack, validator economics, fee markets), decentralized finance (DeFi) economic primitives (automated market makers, lending protocols, yield farming), non-fungible token (NFT) economics, governance token mechanisms, utility token design, and economic game theory as applied to blockchain systems. Token economics bridges computer science, cryptography, and economic theory, applying mechanism design, game theory, and monetary economics to create self-sustaining decentralized systems. The domain addresses critical challenges including aligning participant incentives with network security and health, designing sustainable token supply models, creating efficient markets for scarce blockchain resources (transaction inclusion, data storage, computation), preventing economic attacks, and ensuring long-term network viability as block rewards decline or change."@en ;
    skos:prefLabel "Token Economics Domain"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:blockchain:token-economics-domain" ;
    owl:sameAs <urn:visionclaw:concept:blockchain:token-economics-domain> ;
    vcw:contentHash "sha256-12-1341a22ea9a0" ;
    vcw:qualityScore "0.5"^^xsd:decimal ;
    vcw:legacyTermId "BC-token-economics-domain" ;
    vcw:ontologyStatus "stub" ;
    vcw:maturityLevel "draft" ;
    vcw:authorityScore "0.0"^^xsd:decimal ;
    dcterms:identifier "BC-token-economics-domain" ;
    dcterms:subject "blockchain" ;
    owl:versionInfo "2.0.0" ;
    dcterms:created "2025-11-08T00:00:00Z"^^xsd:dateTime ;
    dcterms:modified "2026-04-26T13:00:00Z"^^xsd:dateTime ;
    vcw:owlRole "Concept" .

# Verifiable Credential Surface
blockchain:VerifiableCredentialSurface rdf:type owl:Class ;
    rdfs:label "Verifiable Credential Surface"@en ;
    rdfs:comment "A standardised JSON-LD 1.1 surface (S3) for issuing and storing W3C Verifiable Credentials 2.0 credentials signed by agents' DID Nostr Identity DIDs using Schnorr Signature over JCS Canonicalisation payloads, enabling verifiable attestations of agent capabilities, work completions, and claims that are independently auditable without central authorities."@en ;
    skos:prefLabel "Verifiable Credential Surface"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:blockchain:verifiable-credential-surface" ;
    owl:sameAs <urn:visionclaw:concept:blockchain:verifiable-credential-surface> ;
