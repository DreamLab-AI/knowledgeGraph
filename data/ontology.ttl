        <urn:visionflow:linked:synchronised-clock>,
        <urn:visionflow:linked:validator-registry>,
        vf:blockchain-network,
        vf:cryptographic-hash,
        vf:digital-signature,
        vf:peer-to-peer-network ;
    vc:slug "consensus-mechanism" ;
    vc:sourceDomain "blockchain" .

