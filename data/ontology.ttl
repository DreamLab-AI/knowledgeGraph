ngm:homomorphic-encryption a owl:Class ;
    rdfs:label "Homomorphic Encryption"@en ;
    rdfs:comment "Homomorphic Encryption (HE) is a cryptographic paradigm that permits arbitrary arithmetic and logical operations to be performed directly on ciphertext, yielding an encrypted result that, upon decryption, matches the outcome of the same operations applied to the original plaintext. Fully Homomorphic Encryption (FHE), first constructed by Craig Gentry in 2009 using ideal-lattice hard problems, supports an unbounded depth of operations and enables third parties — such as cloud compute providers — to process sensitive data without ever gaining access to it in plaintext form. Practical FHE schemes include BGV and BFV for exact integer arithmetic, CKKS for approximate real-number arithmetic (widely used in machine-learning inference), and TFHE for fast gate-by-gate bootstrapping over Boolean circuits."@en ;
    rdfs:subClassOf ngm:cryptography ;
    vc:bridgesTo ngm:confidential-computing,
        ngm:federated-learning,
        ngm:zero-knowledge-proof ;
    vc:contrastsWith ngm:differential-privacy,
        ngm:garbled-circuits,
        ngm:secure-enclaves ;
    vc:dependsOn ngm:noise-management,
        ngm:post-quantum-cryptography ;
    vc:enables ngm:encrypted-machine-learning,
        ngm:federated-learning,
        ngm:private-information-retrieval,
        ngm:secure-multi-party-computation ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:bgv-scheme,
        ngm:bootstrapping,
        ngm:ckks-scheme,
        ngm:tfhe-scheme ;
    vc:isPartOf ngm:privacy-preserving-technology ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:functional-encryption,
        ngm:oblivious-ram,
        ngm:zero-knowledge-proof ;
    vc:requires ngm:lattice-based-cryptography,
        ngm:learning-with-errors ;
    vc:slug "homomorphic-encryption" ;
    vc:sourceDomain "security" ;
    vc:standardizedBy ngm:homomorphicencryption-org,
        ngm:iso-iec-jtc1-sc27 ;
    vc:supports ngm:cloud-computing,
        ngm:genomic-data-analysis,
        ngm:healthcare-data-privacy ;
    vc:uses ngm:number-theoretic-transform,
        ngm:ring-learning-with-errors .

