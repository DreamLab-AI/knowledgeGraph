    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:data-pipeline,
        ngm:edi,
        ngm:messaging ;
    vc:slug "data-exchange" ;
    vc:sourceDomain "infrastructure" ;
    vc:standardizedBy ngm:standards ;
    vc:supports ngm:healthcare-interoperability,
        ngm:open-banking,
        ngm:supply-chain ;
    vc:uses ngm:api,
