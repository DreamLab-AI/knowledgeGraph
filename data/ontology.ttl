        ngm:rendering-cluster ;
    vc:isPartOf ngm:film-production-studio,
        ngm:virtual-production-pipeline ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:camera-tracking,
        ngm:color-management-system,
        ngm:network-infrastructure,
        ngm:real-time-rendering-engine ;
    vc:slug "virtual-production-volume" ;
    vc:sourceDomain "spatial-computing" .

ngm:virtual-reality-platform a owl:Class ;
    rdfs:label "Virtual Reality Platform"@en ;
    rdfs:comment "An integrated hardware and software ecosystem that provides the compute, display, tracking, and runtime services required to deliver immersive virtual reality experiences. A VR platform encompasses the headset, motion controllers, inside-out or external tracking system, operating system, SDK, content store, and developer toolchain. Platforms differ in their openness to third-party applications, support for room-scale interaction, and adherence to interoperability standards such as OpenXR."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:sensor-fusion ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:game-engine ],
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:enables ngm:room-scale,
        ngm:virtual-reality,
        ngm:xr-meeting-space ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:augmented-reality,
        ngm:mixed-reality ;
    vc:requires ngm:game-engine,
        ngm:sensor-fusion ;
    vc:slug "virtual-reality-platform" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:haptics,
        ngm:spatial-audio .

ngm:voice-cloning a owl:Class ;
    rdfs:label "Voice Cloning"@en ;
    rdfs:comment "Voice cloning is a speech synthesis technique that uses a short reference audio recording of a target speaker to condition or fine-tune a neural text-to-speech (TTS) model such that it reproduces that speaker's vocal characteristics — including timbre, prosody, accent, and speaking rhythm — when given arbitrary text. Modern voice cloning systems rely on speaker encoder networks that extract a fixed-dimensional speaker embedding from the reference audio, which is then provided as conditioning input to a sequence-to-sequence acoustic model and vocoder. Zero-shot voice cloning extends this capability to entirely unseen speakers without any fine-tuning, using large pre-trained generative models."@en ;
    rdfs:subClassOf ngm:ai-application ;
    skos:broader ngm:ai-application ;
    vc:enables ngm:generative-ai ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:deepfakes,
        ngm:speech-recognition ;
    vc:slug "voice-cloning" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:neural-network,
        ngm:text-to-speech .

ngm:voting-systems a owl:Class ;
    rdfs:label "Voting Systems"@en ;
    rdfs:comment "Blockchain-based electoral systems employing cryptographic verification, end-to-end verifiability, and distributed ledger technology to enable secure voting whilst facing critical security challenges identified by MIT research showing vulnerabilities allowing vote alteration, academic consensus o..."@en ;
