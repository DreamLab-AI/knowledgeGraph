    vc:slug "ai-impact-assessment" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:calibration a owl:Class ;
    rdfs:label "Calibration"@en ;
    rdfs:comment "Calibration in robotics and sensing is the systematic process of determining, verifying, and correcting the quantitative relationship between a sensor's or actuator's raw output and the physical quantity it represents, encompassing intrinsic parameters (gain, offset, nonlinearity), extrinsic parameters (pose relative to a reference frame), and inter-sensor spatial relationships. Calibration is prerequisite for metrically accurate perception, closed-loop control, and multi-modal Sensor Fusion in robotic systems. It applies to diverse transducers including cameras, Lidar scanners, IMUs, force-torque sensors, joint encoders, and end-effector tools."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:robot-sensor ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:imu ],
        ngm:robo-perception ;
    skos:broader ngm:robo-perception ;
    vc:enables ngm:camera-calibration,
        ngm:sensor-fusion ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:requires ngm:imu,
        ngm:robot-sensor ;
    vc:slug "calibration" ;
    vc:sourceDomain "robotics" ;
    vc:supports ngm:robot-control,
        ngm:slam .

ngm:conversational-ai a owl:Class ;
    rdfs:label "Conversational AI"@en ;
    rdfs:comment "Conversational AI encompasses systems that engage in natural-language dialogue with humans, including chatbots, voice assistants, and large-language-model-powered interfaces. It applies natural language processing, language modeling, dialogue management, and speech recognition to understand intent and generate contextually appropriate responses."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
