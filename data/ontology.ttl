vf:bitcoin-as-money a owl:Class ;
    rdfs:label "Bitcoin As Money"@en ;
    rdfs:comment "**Bitcoin As Money** is the analytical framework within monetary economics and philosophy that interrogates whether [[Bitcoin]] — the fixed-supply, decentralised, proof-of-work-secured digital commodity created by [[Satoshi Nakamoto]] in 2008 — satisfies the classical three functions of money: **medium of exchange** (MOE), **store of value** (SOV), and **unit of account** (UOA). The concept draws simultaneously on [[Austrian Economics]] (Mises, Hayek, Rothbard on hard-money theory and the regression theorem), mainstream [[Monetary Theory]] (Keynes, Friedman on money supply and velocity), and empirical institutional observation, producing a rich and contested body of analysis that has grown substantially as Bitcoin's market capitalisation crossed $1 trillion in 2021, $2 trillion in 2024, and its price exceeded $100,000 per coin during 2024-2025."@en ;
    rdfs:subClassOf <urn:visionflow:linked:austrian-economics>,
        <urn:visionflow:linked:cryptocurrency-economics>,
        <urn:visionflow:linked:digital-asset-economics>,
        <urn:visionflow:linked:monetary-theory>,
        <urn:visionflow:linked:sound-money> ;
    vc:authorityScore "0.87"^^xsd:float ;
    vc:enables <urn:visionflow:linked:ai-agent-payments>,
        <urn:visionflow:linked:borderless-payments>,
        <urn:visionflow:linked:censorship-resistant-payments>,
        <urn:visionflow:linked:circular-bitcoin-economy>,
        <urn:visionflow:linked:financial-inclusion>,
        <urn:visionflow:linked:machine-commerce>,
        <urn:visionflow:linked:sovereign-reserve-asset>,
        vf:micropayments ;
    vc:hasPart <urn:visionflow:linked:bitcoin-standard>,
        <urn:visionflow:linked:greshams-law-application>,
        <urn:visionflow:linked:layered-bitcoin-architecture>,
        <urn:visionflow:linked:medium-of-exchange>,
        <urn:visionflow:linked:store-of-value>,
        <urn:visionflow:linked:unit-of-account>,
        <urn:visionflow:linked:velocity-of-money-analysis>,
        vf:circular-economy,
        vf:lightning-network ;
    vc:implements <urn:visionflow:linked:austrian-hard-money-theory>,
        <urn:visionflow:linked:commodity-money-model>,
        <urn:visionflow:linked:fixed-supply-monetary-policy>,
        <urn:visionflow:linked:programmable-money-paradigm>,
        <urn:visionflow:linked:sound-money-principles> ;
    vc:maturity "production-ready" ;
    vc:qualityScore "0.52"^^xsd:float ;
    vc:requires <urn:visionflow:linked:bitcoin-network>,
        <urn:visionflow:linked:merchant-adoption>,
        <urn:visionflow:linked:monetary-consensus>,
        <urn:visionflow:linked:price-stability-analysis>,
        vf:bitcoin,
        vf:lightning-network ;
    vc:slug "bitcoin-as-money" ;
    vc:sourceDomain "blockchain" .

vf:bitcoin-centralisation-risks a owl:Class ;
    rdfs:label "Bitcoin Centralisation Risks"@en ;
    rdfs:comment "**Bitcoin Centralisation Risks** refers to the ensemble of systemic vulnerabilities arising from the progressive concentration of economic power, computational control, physical infrastructure, custody arrangements, development authority, and payment routing within Bitcoin's nominally decentralised ecosystem. [[Bitcoin]] was designed — through Nakamoto's 2008 whitepaper — to operate without any trusted third party, using a distributed [[Proof of Work]] consensus to prevent any single actor from rewriting the ledger or censoring transactions. Yet, across every major subsystem of the Bitcoin stack, observable concentration trends challenge this foundational guarantee. Centralisation risks in [[Bitcoin]] operate across at least seven distinct attack surfaces, each capable of independently undermining a different aspect of Bitcoin's core security model:"@en ;
    rdfs:subClassOf <urn:visionflow:linked:blockchain-governance-risk>,
        <urn:visionflow:linked:concentration-risk>,
        <urn:visionflow:linked:decentralisation>,
        <urn:visionflow:linked:network-security>,
        vf:systemic-risk ;
    vc:authorityScore "0.87"^^xsd:float ;
    vc:enables <urn:visionflow:linked:protocol-capture>,
        <urn:visionflow:linked:regulatory-capture>,
        <urn:visionflow:linked:supply-chain-attack>,
        <urn:visionflow:linked:transaction-censorship>,
        vf:51-attack,
        vf:eclipse-attack,
        vf:sybil-attack ;
    vc:hasPart <urn:visionflow:linked:asic-manufacturer-duopoly>,
        <urn:visionflow:linked:custodial-concentration>,
        <urn:visionflow:linked:developer-centralisation>,
        <urn:visionflow:linked:geographic-hashrate-concentration>,
        <urn:visionflow:linked:institutional-holder-concentration>,
        <urn:visionflow:linked:lightning-network-hub-centralisation>,
        <urn:visionflow:linked:mining-pool-concentration> ;
    vc:implements <urn:visionflow:linked:gini-coefficient-analysis>,
        <urn:visionflow:linked:hashrate-distribution-analysis>,
        <urn:visionflow:linked:herfindahl-hirschman-index>,
        <urn:visionflow:linked:nakamoto-coefficient>,
        <urn:visionflow:linked:network-topology-analysis> ;
    vc:maturity "production-ready" ;
    vc:qualityScore "0.52"^^xsd:float ;
    vc:requires <urn:visionflow:linked:asic>,
        <urn:visionflow:linked:bitcoin-core>,
        <urn:visionflow:linked:bitcoin-network>,
        vf:full-node,
        vf:lightning-network,
        vf:mining-pool,
        vf:proof-of-work ;
    vc:slug "bitcoin-centralisation-risks" ;
    vc:sourceDomain "blockchain" .

vf:bitcoin-value-proposition a owl:Class ;
    rdfs:label "Bitcoin Value Proposition"@en ;
    rdfs:comment "**Bitcoin Value Proposition** is the aggregate set of economic, monetary, and philosophical arguments that justify holding, using, or building on [[Bitcoin]] as a distinct and superior form of money, property, or network infrastructure. The proposition is not monolithic: analysts, practitioners, and national governments emphasise different facets depending on their temporal horizon, risk tolerance, regulatory context, and theory of money. As of 2026 at least nine distinct but overlapping value frames are actively debated: [[Store of Value]] and [[Digital Gold]]; [[Sound Money]] and [[Austrian Economics]]; [[Censorship Resistance]] and [[Financial Sovereignty]]; [[Inflation Hedge]] against [[Monetary Debasement]]; [[Hyperbitcoinization]] and global monetary transition; [[Network Effects]] and the [[Lindy Effect]]; [[Institutional Adoption]] and ETF legitimisation; [[Financial Inclusion]] and remittances; and [[AI Economy]] machine-to-machine payments."@en ;
    rdfs:subClassOf <urn:visionflow:linked:economic-philosophy>,
        <urn:visionflow:linked:monetary-theory>,
        <urn:visionflow:linked:sound-money>,
        <urn:visionflow:linked:store-of-value>,
        vf:bitcoin,
        vf:digital-asset ;
    vc:authorityScore "0.87"^^xsd:float ;
    vc:enables <urn:visionflow:linked:ai-economy-payments>,
        <urn:visionflow:linked:censorship-resistant-payments>,
        <urn:visionflow:linked:corporate-treasury-strategy>,
        <urn:visionflow:linked:financial-inclusion>,
        <urn:visionflow:linked:financial-sovereignty>,
        <urn:visionflow:linked:inflation-hedging>,
        <urn:visionflow:linked:machine-to-machine-payments>,
        <urn:visionflow:linked:remittances>,
        <urn:visionflow:linked:rural-electrification-subsidy>,
        <urn:visionflow:linked:self-custody>,
        <urn:visionflow:linked:sovereign-bitcoin-reserve>,
        <urn:visionflow:linked:store-of-value> ;
    vc:hasPart <urn:visionflow:linked:21-million-supply-cap>,
        <urn:visionflow:linked:block-reward-halving>,
        <urn:visionflow:linked:digital-scarcity>,
        <urn:visionflow:linked:financial-sovereignty>,
        <urn:visionflow:linked:hyperbitcoinization>,
        <urn:visionflow:linked:inflation-hedge>,
        <urn:visionflow:linked:lindy-effect>,
        <urn:visionflow:linked:network-effects>,
        <urn:visionflow:linked:proof-of-work-security>,
        <urn:visionflow:linked:self-custody>,
        vf:censorship-resistance,
        vf:lightning-network ;
    vc:implements <urn:visionflow:linked:austrian-economics>,
        <urn:visionflow:linked:gresham-s-law>,
        <urn:visionflow:linked:hayek-denationalisation>,
        <urn:visionflow:linked:mises-regression-theorem>,
        <urn:visionflow:linked:saifedean-ammous-bitcoin-standard>,
        <urn:visionflow:linked:sound-money-principles>,
        vf:nakamoto-consensus ;
    vc:maturity "production-ready" ;
    vc:qualityScore "0.52"^^xsd:float ;
    vc:requires <urn:visionflow:linked:bitcoin-miners>,
        <urn:visionflow:linked:bitcoin-network>,
        <urn:visionflow:linked:decentralisation>,
        <urn:visionflow:linked:full-node-infrastructure>,
        <urn:visionflow:linked:open-source-protocol>,
        vf:cryptographic-security,
        vf:proof-of-work ;
    vc:slug "bitcoin-value-proposition" ;
    vc:sourceDomain "blockchain" .

