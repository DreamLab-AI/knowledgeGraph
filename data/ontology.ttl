    vc:hasPart ngm:discount-factor,
        ngm:reward-signal ;
    vc:implements ngm:bellman-equation ;
    vc:isPartOf ngm:markov-decision-process,
        ngm:reinforcement-learning ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:alignment,
        ngm:reinforcement-learning-from-human-feedback,
        ngm:reward-hacking ;
    vc:requires ngm:action-space,
