            owl:someValuesFrom ngm:schnorr-signature ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:schnorr-signature ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:web-socket-protocol ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
