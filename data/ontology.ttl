    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:shader ;
    vc:slug "gpu" ;
    vc:sourceDomain "general" .

ngm:immersive-communication a owl:Class ;
    rdfs:label "Immersive Communication"@en ;
    rdfs:comment "Communication systems and experiences that leverage extended reality (XR) technologies — including VR meetings, AR collaboration tools, spatial audio conferencing, and mixed reality platforms — to create spatially-aware interaction environments that transcend conventional 2D video interfaces and convey presence, embodiment, and spatial context."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:spatial-audio ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:avatar ],
        ngm:dc-telepresence,
        ngm:telecollaboration ;
    skos:broader ngm:dc-telepresence ;
    vc:bridgesTo ngm:remote-collaboration,
        ngm:virtual-collaboration ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:avatar,
        ngm:spatial-audio ;
    vc:slug "immersive-communication" ;
    vc:sourceDomain "distributed-collaboration" ;
    vc:uses ngm:metaverse .

ngm:kubernetes a owl:Class ;
    rdfs:label "Kubernetes"@en ;
    rdfs:comment "Kubernetes (K8s) is an open-source container orchestration platform originally developed by Google and donated to the Cloud Native Computing Foundation (CNCF) in 2014. It automates the deployment, scaling, scheduling, and lifecycle management of containerised workloads across clusters of physical or virtual machines. Kubernetes abstracts infrastructure resources into declarative objects—Pods, Deployments, Services, and Namespaces—that describe desired state, with a control plane continuously reconciling actual state to match the specification."@en ;
    rdfs:subClassOf ngm:orchestration ;
    vc:dependsOn ngm:distributed-systems,
        ngm:software-infrastructure ;
    vc:enables ngm:cloud-infrastructure,
        ngm:distributed-computing,
        ngm:machine-learning-infrastructure,
        ngm:platform-engineering,
        ngm:resource-management ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:cloud-native-applications,
        ngm:distributed-system,
        ngm:infrastructure,
        ngm:microservices-architecture,
        ngm:software-platform ;
    vc:slug "kubernetes" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:cloud-computing,
        ngm:distributed-training ;
    vc:uses ngm:api-gateway,
        ngm:event-driven-architecture .

ngm:layer-2-scaling a owl:Class ;
    rdfs:label "Layer 2 Scaling"@en ;
    rdfs:comment "Layer 2 scaling refers to a category of protocols and systems built atop an existing blockchain (the Layer 1) that increase transaction throughput and reduce fees by processing the majority of transaction computation and data storage off the main chain while inheriting the security guarantees of the underlying Layer 1 through cryptographic proofs, fraud-proof mechanisms, or periodic state commitments. The Layer 2 anchors itself to the Layer 1 by periodically publishing compressed state roots or validity proofs, allowing the Layer 1 to serve as the ultimate settlement and security layer while the Layer 2 handles high-volume transaction processing."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:sidechain ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:state-channel ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:zero-knowledge-proof ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:lightning-network ],
        ngm:blockchain-scalability ;
