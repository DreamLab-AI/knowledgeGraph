ngm:oracle-network a owl:Class ;
    rdfs:label "Oracle Network"@en ;
    rdfs:comment "An oracle network is a decentralised infrastructure layer composed of independent node operators that collectively fetch, validate, aggregate, and deliver off-chain data — such as asset prices, weather readings, sports outcomes, or IoT sensor readings — to smart contracts executing on a blockchain. Because deterministic blockchain ledgers cannot natively make external HTTP requests or access off-chain databases, oracle networks serve as the cryptoeconomically-secured bridge between on-chain logic and real-world state. Node operators are aligned to honest reporting through staking, slashing, and reputation mechanisms, while aggregation techniques such as median computation and time-weighted average pricing reduce susceptibility to individual node manipulation. Oracle networks underpin critical decentralised finance primitives including lending protocols, synthetic assets, prediction markets, insurance products, cross-chain bridges, and real-world asset settlement."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-aggregation ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:slashing ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:staking ],
        ngm:bc-network-component ;
    skos:broader ngm:bc-network-component ;
    vc:bridgesTo ngm:ai-agent,
        ngm:data-marketplace,
        ngm:io-t-sensor-network ;
    vc:contrastsWith ngm:centralised-oracle,
        ngm:trusted-execution-environment ;
    vc:dependsOn ngm:blockchain-consensus,
        ngm:smart-contract ;
    vc:enables ngm:cross-chain-interoperability,
        ngm:price-oracle,
        ngm:proof-of-reserve,
        ngm:verifiable-random-function ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:off-chain-reporting,
        ngm:slashing ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:blockchain-oracle,
        ngm:decentralised-autonomous-organisation,
        ngm:decentralised-infrastructure,
        ngm:zero-knowledge-proof ;
    vc:requires ngm:cryptoeconomic-incentive,
        ngm:data-aggregation,
        ngm:node-operator,
        ngm:staking ;
    vc:slug "oracle-network" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:decentralised-finance,
        ngm:prediction-markets,
        ngm:real-world-asset-tokenisation,
        ngm:smart-contract-execution .

ngm:pid-controller a owl:Class ;
    rdfs:label "Pid Controller"@en ;
    rdfs:comment "A PID Controller (Proportional-Integral-Derivative Controller) is a closed-loop feedback control algorithm that continuously calculates an error value as the difference between a desired setpoint and a measured process variable, then applies corrections based on proportional, integral, and derivative terms. PID controllers are foundational in robotics, autonomous systems, and industrial automation for precisely regulating position, velocity, and force."@en ;
    rdfs:subClassOf ngm:sc-interaction ;
    skos:broader ngm:sc-interaction ;
    vc:bridgesTo ngm:rb-0047-feedback-control ;
    vc:enables ngm:motion-planning,
        ngm:robot-control ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:control-system,
        ngm:feedback-control ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:relatedTo ngm:actuator,
        ngm:autonomous-system ;
    vc:slug "pid-controller" ;
    vc:sourceDomain "spatial-computing" .

ngm:real-time-control a owl:Class ;
    rdfs:label "Real-Time Control"@en ;
    rdfs:comment "Real-Time Control is the design and implementation of control systems that must respond to sensor inputs and actuator commands within bounded, deterministic time deadlines, where missing a deadline constitutes system failure. Hard real-time systems—common in aircraft fly-by-wire, automotive ABS, and surgical robotics—require guaranteed worst-case execution times measured in microseconds to milliseconds. Soft real-time systems tolerate occasional deadline misses with degraded performance rather than catastrophic failure. Real-time control relies on real-time operating systems (RTOS), dedicated hardware co-processors, and carefully bounded software to ensure predictable timing under all operating conditions."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:control-loop ],
        ngm:control-system ;
    vc:bridgesTo ngm:digital-twin,
        ngm:edge-computing ;
    vc:contrastsWith ngm:batch-processing ;
    vc:enables ngm:autonomous-system,
        ngm:closed-loop-control,
        ngm:industrial-automation,
        ngm:motion-control,
        ngm:robot-control ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:control-loop,
        ngm:deadline-scheduling ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:determinism,
        ngm:embedded-systems,
        ngm:feedback-control,
        ngm:real-time-operating-system,
        ngm:worst-case-execution-time ;
    vc:requires ngm:deterministic-networking,
        ngm:priority-scheduling,
        ngm:task-scheduling ;
    vc:slug "real-time-control" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:actuator,
        ngm:latency,
        ngm:pid-controller,
        ngm:sensor-fusion,
        ngm:state-estimation .

ngm:sidechain a owl:Class ;
    rdfs:label "Sidechain"@en ;
    rdfs:comment "Independent blockchain connected to a parent blockchain via a two-way peg mechanism that operates with its own consensus and validation rules while enabling asset transfers between chains, providing scalability and experimental capabilities without impacting the main chain."@en ;
