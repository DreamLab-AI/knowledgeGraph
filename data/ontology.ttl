ngm:virtual-workspace a owl:Class ;
    rdfs:label "Virtual Workspace"@en ;
    rdfs:comment "A Virtual Workspace is a spatially organised digital environment — typically experienced through XR headsets or desktop 3D interfaces — that replicates or enhances the collaborative and cognitive functions of a physical office. It supports remote collaboration, persistent shared artefacts, spatial audio, and embodied presence, addressing the limitations of flat video-conferencing for complex knowledge work."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:avatar ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:spatial-audio ],
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:enables ngm:knowledge-management,
        ngm:remote-collaboration,
        ngm:telepresence ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:relatedTo ngm:social-vr,
        ngm:virtual-world ;
    vc:requires ngm:avatar,
        ngm:spatial-audio ;
    vc:slug "virtual-workspace" ;
    vc:sourceDomain "spatial-computing" .

ngm:vote-escrow a owl:Class ;
    rdfs:label "Vote Escrow"@en ;
    rdfs:comment "Vote escrow (ve) is a tokenomics mechanism in which holders lock governance tokens for a chosen duration in exchange for non-transferable, time-decaying voting power and often boosted protocol rewards. Popularised by Curve's veCRV model, it aligns voter incentives with long-term protocol health by rewarding commitment over short-term speculation. Locked positions decay linearly to zero at unlock, requiring periodic re-locking to maintain influence."@en ;
    rdfs:subClassOf ngm:bc-defi-and-economics ;
    skos:broader ngm:bc-defi-and-economics ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:on-chain-voting,
        ngm:tokenomics-governance ;
    vc:slug "vote-escrow" ;
    vc:sourceDomain "blockchain" .

ngm:vulnerability-assessment a owl:Class ;
    rdfs:label "Vulnerability Assessment"@en ;
    rdfs:comment "Vulnerability assessment is the structured evaluation of an organisation's systems against known weaknesses, producing a prioritised inventory of exposures and recommended mitigations. It is typically scope-bounded and recurring, using automated scanners and authenticated checks to map findings to severity and asset criticality. Mandated by many cybersecurity standards, it provides the baseline evidence for compliance and continuous risk reduction."@en ;
    rdfs:subClassOf ngm:cybersecurity ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:cybersecurity-standard,
        ngm:threat-modelling ;
    vc:slug "vulnerability-assessment" ;
    vc:sourceDomain "security" .

ngm:vulnerability-scanning a skos:Concept ;
    rdfs:label "Vulnerability Scanning"@en .

ngm:waste-management a owl:Class ;
    rdfs:label "Waste Management"@en ;
    rdfs:comment "The collection, transport, processing, and disposal of waste materials, increasingly augmented by blockchain-based distributed ledgers and smart contracts that create immutable records of waste generation, segregation, and recovery throughout the circular economy lifecycle. Blockchain-enabled systems enable verifiable recycling rates, incentivise responsible disposal, and prevent illegal dumping."@en ;
    rdfs:subClassOf ngm:bc-network-component ;
    skos:broader ngm:bc-network-component ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.4"^^xsd:float ;
    vc:relatedTo ngm:blockchain-sustainability,
        ngm:environmental-accounting ;
    vc:slug "waste-management" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:circular-economy,
        ngm:environmental-sustainability ;
    vc:uses ngm:blockchain,
        ngm:smart-contract .

ngm:wcag a skos:Concept ;
