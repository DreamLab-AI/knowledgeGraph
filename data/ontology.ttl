    vc:sourceDomain "metaverse" .

ngm:ontology-technical-details a owl:Class ;
    rdfs:label "ONTOLOGY_TECHNICAL_DETAILS"@en ;
    rdfs:comment "A meta-documentation node cataloguing the technical structure, bidirectional link patterns, missing parent audits, and inheritance statistics of the NarrativeGoldmine ontology graph. It serves as a diagnostic reference for ontology engineers, documenting cross-domain isolation rules, broken reference inventories, and recommended file structures for parent concept pages."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
