        ngm:robot-joint ;
    vc:requires ngm:electric-actuator,
        ngm:motion-control,
        ngm:torque ;
    vc:slug "rack-and-pinion-actuator" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:dc-servo-motor,
        ngm:forward-kinematics .

ngm:ray-marching a owl:Class ;
    rdfs:label "Ray Marching"@en ;
    rdfs:comment "Ray Marching is a rendering technique in which a ray is incrementally stepped through a scene, evaluating a signed distance field (SDF) at each step to determine proximity to geometry. The step size adapts to the SDF value (sphere tracing), enabling efficient rendering of implicit surfaces, volumetric effects, soft shadows, and ambient occlusion that are impractical with triangle-based rasterisation. It is widely implemented in GPU shader programs and is foundational to procedural 3D scene generation in real-time and offline contexts."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:shader ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gpu-compute ],
        ngm:rendering-technique,
        ngm:sc-display-and-rendering ;
    skos:broader ngm:sc-display-and-rendering ;
    vc:contrastsWith ngm:rasterization,
        ngm:ray-tracing ;
    vc:enables ngm:global-illumination,
        ngm:procedural-generation,
        ngm:real-time-rendering ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:requires ngm:gpu-compute,
        ngm:shader ;
    vc:slug "ray-marching" ;
    vc:sourceDomain "spatial-computing" .

ngm:rb-0012-wheeled-mobile-robot a owl:Class ;
    rdfs:label "rb 0012 wheeled mobile robot"@en ;
    rdfs:comment "A wheeled mobile robot (WMR) is a ground-based autonomous or semi-autonomous robot that uses wheels for locomotion. WMRs range from differential-drive platforms to omnidirectional holonomic designs; they rely on odometry for dead-reckoning, SLAM for map building, and path-planning algorithms for autonomous navigation in structured or semi-structured environments."@en ;
    rdfs:subClassOf ngm:mobile-robot,
        ngm:robo-robot-type ;
    skos:broader ngm:robo-robot-type ;
    vc:dependsOn ngm:autonomous-navigation,
        ngm:path-planning ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:differential-drive-robot,
        ngm:mobile-robot-platform,
        ngm:wheeled-mobile-robot ;
    vc:slug "rb-0012-wheeled-mobile-robot" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:odometry,
        ngm:rb-0075-range-finder,
        ngm:slam .

ngm:rb-0027-robot-link a owl:Class ;
    rdfs:label "rb 0027 robot link"@en ;
    rdfs:comment "A robot link is a rigid (or semi-rigid) structural body that forms one segment of a robot's kinematic chain, connecting adjacent joints and transmitting forces and torques between them. Links define the geometry of the robot's workspace by their length, mass, and inertial properties, and together with joints they constitute the Denavit-Hartenberg representation used in forward and inverse kinematics. Link stiffness, material choice, and mass distribution directly affect dynamic performance, vibration characteristics, and safety in human-robot interaction."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:robot-joint ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:robot-link ],
        ngm:robo-actuation-and-control,
        ngm:robot ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:robot-joint,
        ngm:robot-link ;
    vc:isPartOf ngm:robot,
        ngm:robot-kinematics ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:inertia,
        ngm:kinematics,
        ngm:rb-0039-stiffness,
        ngm:rigid-body ;
    vc:slug "rb-0027-robot-link" ;
    vc:sourceDomain "robotics" .

ngm:rb-0033-payload a owl:Class ;
    rdfs:label "rb 0033 payload"@en ;
    rdfs:comment "Payload in robotics refers to the maximum mass that a robot can carry or manipulate while maintaining its specified performance characteristics, including accuracy, repeatability, and speed. Payload capacity is a fundamental design parameter for robot arms, mobile robots, and drones, directly constraining the tools, parts, or cargo the robot can handle. It is typically quoted at the wrist or end-effector mounting face and may vary with configuration and speed; dynamic payload accounts for inertial forces during acceleration."@en ;
    rdfs:subClassOf ngm:robo-actuation-and-control,
        ngm:robot ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:dependsOn ngm:rb-0022-robot-dynamics,
        ngm:rb-0039-stiffness ;
    vc:enables ngm:end-effector ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:robot ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:rb-0034-repeatability,
        ngm:rb-0035-accuracy,
        ngm:rb-0041-inertia,
        ngm:rb-0043-torque ;
    vc:slug "rb-0033-payload" ;
    vc:sourceDomain "robotics" .

ngm:rb-0040-backlash a owl:Class ;
    rdfs:label "rb 0040 backlash"@en ;
    rdfs:comment "Backlash in robotics is the lost motion in a mechanical transmission — the angular or linear displacement of the output element when the input reverses direction without producing corresponding output movement, caused by clearance gaps between mating gear teeth or other drive components. Backlash degrades positional accuracy and repeatability, introduces nonlinearity into the control loop, and can cause oscillation or chattering in feedback control systems. Minimising backlash is critical for precision robot joints, and it is typically reduced through the use of preloaded gear pairs, harmonic drives, or cycloidal transmissions."@en ;
    rdfs:subClassOf ngm:backlash,
        ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:contrastsWith ngm:rb-0034-repeatability,
        ngm:rb-0035-accuracy ;
    vc:dependsOn ngm:actuator ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:rb-0026-robot-joint,
        ngm:rb-0038-compliance,
        ngm:rb-0039-stiffness,
        ngm:rb-0043-torque,
        ngm:rb-0047-feedback-control ;
    vc:slug "rb-0040-backlash" ;
    vc:sourceDomain "robotics" .

ngm:rb-0073-imu a owl:Class ;
    rdfs:label "rb 0073 imu"@en ;
    rdfs:comment "An Inertial Measurement Unit (IMU) is an electronic device that measures and reports a body's specific force, angular rate, and sometimes magnetic field using a combination of accelerometers, gyroscopes, and optional magnetometers. In robotics, IMUs provide high-frequency proprioceptive feedback for state estimation, pose tracking, and stabilisation control, and are commonly fused with odometry or SLAM algorithms to reduce drift."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:gyroscope ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:accelerometer ],
        ngm:inertial-measurement-unit,
        ngm:robo-perception ;
    skos:broader ngm:robo-perception ;
    vc:enables ngm:localization,
        ngm:odometry,
        ngm:state-estimation ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:accelerometer,
        ngm:gyroscope ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:rb-0066-robot-sensor,
        ngm:rb-0072-encoder,
        ngm:sensor-fusion,
        ngm:slam ;
    vc:slug "rb-0073-imu" ;
    vc:sourceDomain "robotics" ;
    vc:supports ngm:autonomous-navigation .

ngm:rb-0078-infrared-sensor a owl:Class ;
    rdfs:label "rb 0078 infrared sensor"@en ;
    rdfs:comment "An infrared (IR) sensor is an exteroceptive sensor that detects and measures infrared radiation emitted or reflected by objects in the environment, enabling proximity detection, thermal profiling, and obstacle identification in robotic systems. IR sensors operate across near-infrared (NIR), short-wave, mid-wave, and long-wave bands; common robotics applications include proximity switches, line-following, and thermal imaging for human detection. They complement other ranging sensors such as LiDAR and ultrasonic devices, and are frequently fused in multi-modal perception pipelines."@en ;
    rdfs:subClassOf ngm:robo-perception,
        ngm:sensor ;
    skos:broader ngm:robo-perception ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:infrared-sensor,
        ngm:proximity-sensor,
        ngm:rb-0066-robot-sensor,
        ngm:rb-0069-lidar,
        ngm:rb-0075-range-finder ;
    vc:slug "rb-0078-infrared-sensor" ;
    vc:sourceDomain "robotics" ;
    vc:supports ngm:rb-0052-collision-avoidance,
        ngm:rb-0095-safety-zone ;
    vc:uses ngm:exteroceptive-sensor,
        ngm:sensor-fusion .

ngm:rb-0101-performance-level a owl:Class ;
    rdfs:label "rb 0101 performance level"@en ;
    rdfs:comment "Performance Level (PL) is a discrete safety metric defined in ISO 13849-1 that quantifies the ability of a safety-related control system to perform a safety function under foreseeable conditions. Levels range from PLa (lowest) to PLe (highest), each corresponding to a target probability of dangerous failure per hour. PL is determined through risk assessment and verified against the required PL (PLr) derived from the hazard and risk analysis of the application."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:rb-0090-emergency-stop ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:rb-0087-safety-standard ],
        ngm:robo-safety-and-standards ;
    skos:broader ngm:robo-safety-and-standards ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:functional-safety,
        ngm:rb-0089-risk-assessment,
        ngm:rb-0100-safety-integrity-level ;
    vc:requires ngm:rb-0087-safety-standard,
        ngm:rb-0090-emergency-stop ;
    vc:slug "rb-0101-performance-level" ;
    vc:sourceDomain "robotics" ;
    vc:standardizedBy ngm:iec-61508,
        ngm:iso-10218 ;
    vc:supports ngm:rb-0096-safeguarding .

ngm:rb-0104-hand-guiding a owl:Class ;
    rdfs:label "rb 0104 hand guiding"@en ;
    rdfs:comment "Hand guiding is a collaborative robot operation mode in which an operator physically moves the robot arm by direct physical contact, typically through a dedicated hand-guiding device, while the robot's safety systems monitor force, speed, and separation. It is one of four collaborative operation modes defined in ISO/TS 15066 and ISO 10218, enabling intuitive programming-by-demonstration and safe human-robot co-manipulation tasks."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:rb-0067-force-torque-sensor ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:rb-0056-impedance-control ],
        ngm:human-robot-interaction,
        ngm:robo-human-robot-interaction ;
    skos:broader ngm:robo-human-robot-interaction ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:rb-0103-collaborative-operation ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:end-effector,
        ngm:rb-0007-collaborative-robot,
        ngm:rb-0094-power-and-force-limiting,
        ngm:rb-0105-speed-and-separation-monitoring ;
    vc:requires ngm:rb-0056-impedance-control,
        ngm:rb-0067-force-torque-sensor ;
    vc:slug "rb-0104-hand-guiding" ;
    vc:sourceDomain "robotics" ;
    vc:standardizedBy ngm:iso-ts-15066 .

ngm:real-estate-tokenization a owl:Class ;
    rdfs:label "Real Estate Tokenization"@en ;
    rdfs:comment "Blockchain-based systems employing security tokens (ERC-3643, ERC-1400, ERC-20 standards) to represent fractional ownership interests in real estate properties, enabling automated dividend distribution through smart contracts, reducing investment minimums from tens of thousands to £50, and creati..."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:decentralised-identity ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:smart-contract ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:blockchain ],
        ngm:bc-token-and-asset ;
    skos:broader ngm:bc-token-and-asset ;
    vc:dependsOn ngm:blockchain-compliance ;
    vc:enables ngm:decentralised-finance,
        ngm:digital-asset-trading ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
