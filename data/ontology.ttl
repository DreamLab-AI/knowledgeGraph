ngm:service-registry a owl:Class ;
    rdfs:comment "A Service Registry is a database of available service instances and their network locations that underpins dynamic service discovery in distributed and microservice architectures. Instances register on startup and deregister on shutdown, while clients or load balancers query the registry to resolve a logical service name to a healthy endpoint. Health checks expire stale entries, keeping the registry an accurate view of live topology in elastic, frequently changing deployments."@en ;
    rdfs:label "Service Registry"@en ;
    rdfs:subClassOf ngm:service-discovery ;
    rdfs:subClassOf _:r19249 ;
