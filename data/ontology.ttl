    vcw:maturityLevel "mature" ;
    vcw:authorityScore "0.0"^^xsd:decimal ;
    dcterms:identifier "TC-0302" ;
    dcterms:subject "distributed-collaboration" ;
    owl:versionInfo "2.0.0" ;
    dcterms:created "2026-04-26T00:00:00Z"^^xsd:dateTime ;
    dcterms:modified "2026-04-26T13:00:00Z"^^xsd:dateTime ;
    vcw:owlRole "Object" .

# Telecollaboration and Telepresence Domain
distributed-collaboration:TelecollaborationAndTelepresenceDomain rdf:type owl:Class ;
    rdfs:subClassOf distributed-collaboration:Telecollaboration ;
    rdfs:label "Telecollaboration and Telepresence Domain"@en ;
    rdfs:comment "Telecollaboration and Telepresence Domain is a concept within the tc domain."@en ;
    skos:prefLabel "Telecollaboration and Telepresence Domain"@en ;
