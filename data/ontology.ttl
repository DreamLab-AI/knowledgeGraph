    vc:requires ngm:labelled-data,
        ngm:natural-language-understanding ;
    vc:slug "semantic-parsing" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:intent-recognition ;
    vc:uses ngm:sequence-to-sequence,
        ngm:transformer-model .

ngm:sequential-monte-carlo a owl:Class ;
    rdfs:label "Sequential Monte Carlo"@en ;
    rdfs:comment "Sequential Monte Carlo is a family of methods that approximate evolving probability distributions using a set of weighted samples updated recursively as new observations arrive."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:importance-sampling ],
        [ a owl:Restriction ;
