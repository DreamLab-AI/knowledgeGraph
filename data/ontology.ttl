ngm:stereo-vision a owl:Class ;
    rdfs:label "Stereo Vision"@en ;
    rdfs:comment "Stereo vision is a computational technique that recovers metric depth information from a scene by analysing the horizontal displacement (disparity) between corresponding points in two or more rectified images captured from laterally separated viewpoints, mimicking the binocular parallax used by human and animal visual systems. The resulting dense disparity maps are converted into 3D point clouds or depth maps for downstream perception tasks."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:lens-distortion-correction ],
        ngm:computer-vision ;
    vc:bridgesTo ngm:advanced-driver-assistance-systems,
        ngm:spatial-computing ;
    vc:contrastsWith ngm:lidar,
        ngm:monocular-depth-estimation,
        ngm:structured-light ;
    vc:dependsOn ngm:camera-calibration,
        ngm:epipolar-geometry ;
    vc:enables ngm:3-d-scene-reconstruction,
        ngm:depth-estimation,
        ngm:obstacle-detection,
        ngm:point-cloud-generation,
        ngm:visual-odometry ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:cost-volume,
        ngm:semi-global-matching,
        ngm:stereo-matching ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:multi-view-stereo,
        ngm:optical-flow,
        ngm:slam ;
    vc:requires ngm:image-synchronisation,
        ngm:lens-distortion-correction ;
    vc:slug "stereo-vision" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:augmented-reality,
        ngm:autonomous-driving,
        ngm:robotic-grasping ;
    vc:uses ngm:camera-calibration,
        ngm:convolutional-neural-network,
        ngm:disparity-map,
        ngm:epipolar-geometry,
        ngm:feature-matching .

ngm:throughput a owl:Class ;
    rdfs:label "Throughput"@en ;
    rdfs:comment "Throughput is the rate at which a system completes useful work over a unit of time, such as requests served per second, tokens generated per second or bytes transferred per second. It measures sustained productive capacity rather than the time to complete a single operation. In machine learning serving it captures how many inferences or training samples a system can process under load. Maximising throughput typically involves batching, parallelism and resource utilisation, often trading off against per-request latency."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:parallel-processing ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:batch-size ],
        ngm:performance-metrics ;
    vc:contrastsWith ngm:latency,
        ngm:response-time ;
    vc:dependsOn ngm:hardware-acceleration,
        ngm:resource-utilization ;
    vc:enables ngm:high-availability,
        ngm:scalability ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:batch-size,
        ngm:request-rate ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:bandwidth,
        ngm:benchmarking ;
    vc:requires ngm:parallel-processing ;
    vc:slug "throughput" ;
    vc:sourceDomain "machine-learning" ;
    vc:supports ngm:model-serving,
        ngm:performance-optimization ;
    vc:uses ngm:batching,
        ngm:load-balancing .

ngm:trust-anchor a owl:Class ;
    rdfs:label "Trust Anchor"@en ;
    rdfs:comment "A trust anchor is an authoritative entity or cryptographic artifact that serves as the root of a chain of trust, providing the foundational level of trust from which all subsequent trust assertions in a system are derived. In public key infrastructure (PKI), the trust anchor is typically a root certificate authority (CA) whose self-signed certificate is pre-installed in operating systems and browsers as inherently trusted, enabling the validation of all subordinate certificate chains. In decentralised identity systems, trust anchors may be governance-designated issuers, DID-based root entities, or on-chain registries whose cryptographic material is considered authoritative for a particular trust domain. Trust anchors define the scope and boundaries of a trust framework and are the entities that must be trusted by all relying parties in the system."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:key-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:hardware-security-module ],
        ngm:trust-framework ;
    vc:bridgesTo ngm:decentralized-identifier,
        ngm:governance,
        ngm:verifiable-credential-vc ;
    vc:contrastsWith ngm:web-of-trust ;
    vc:enables ngm:decentralized-identity,
        ngm:identity-federation,
        ngm:secure-communication,
        ngm:trust,
        ngm:x-509-certificate ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:certificate-authority,
        ngm:certificate-transparency,
        ngm:cryptographic-verification,
        ngm:digital-certificate,
        ngm:public-key-infrastructure,
        ngm:root-certificate,
        ngm:trust-framework-policy ;
    vc:requires ngm:hardware-security-module,
        ngm:key-management ;
    vc:slug "trust-anchor" ;
    vc:sourceDomain "security" ;
    vc:supports ngm:credential-verification,
        ngm:zero-trust-architecture ;
    vc:uses ngm:cryptographic-keys,
        ngm:digital-signature,
        ngm:public-key-cryptography,
        ngm:x-509-certificate .

ngm:ai-policy a owl:Class ;
    rdfs:label "AI Policy"@en ;
    rdfs:comment "AI Policy is the ensemble of government strategies, regulatory instruments, voluntary guidelines, and international agreements through which states and intergovernmental bodies shape the development, deployment, and societal impact of artificial intelligence systems. Policy instruments span public research funding, national AI strategies, procurement standards for government AI use, export controls on frontier hardware and models, and binding requirements for transparency, accountability, and fundamental-rights compliance in high-stakes applications. Effective AI policy must balance national competitiveness, safety assurance, equitable access, and interoperability with allied jurisdictions, making it an inherently multi-stakeholder and multi-domain governance challenge."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:risk-assessment ],
