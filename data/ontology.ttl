blockchain:DecentralizedAutonomousOrganization vcw:bridgesTo blockchain:VirtualEconomy .

# On Chain Voting
blockchain:OnChainVoting rdf:type owl:Class ;
    rdfs:label "On Chain Voting"@en ;
    rdfs:comment "Cryptographically verifiable, blockchain-recorded governance mechanism enabling DAO participants to cast votes that execute automatically through Smart Contract, creating immutable audit trails and trustless decision-making—deployed across Uniswap, Compound, Aave, MakerDAO governing $25+ billion in treasury assets whilst facing challenges around voter participation (5-15%), plutocratic concentration, and gas cost barriers."@en ;
    skos:prefLabel "On Chain Voting"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:blockchain:on-chain-voting" ;
    owl:sameAs <urn:visionclaw:concept:blockchain:on-chain-voting> ;
    vcw:contentHash "sha256-12-ba14c6102bcb" ;
    vcw:qualityScore "0.4"^^xsd:decimal ;
    vcw:legacyTermId "BC-0462" ;
