ngm:cryptographic-hash-function a owl:Class ;
    rdfs:label "Cryptographic Hash Function"@en ;
    rdfs:comment "A Cryptographic Hash Function is a deterministic algorithm that maps arbitrary-length input data to a fixed-length output digest of fixed size, such that it is computationally infeasible to reverse the mapping, find two inputs producing the same digest (collision resistance), or derive the input from the digest alone (preimage resistance). Hash functions such as SHA-256 and Keccak-256 underpin blockchain data integrity, Merkle tree construction, and digital signature schemes. They are a foundational primitive for proof-of-work consensus, address derivation, and commitment schemes across distributed ledger systems."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:collision-resistance ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:preimage-resistance ],
        ngm:bc-cryptographic-primitive ;
    skos:broader ngm:bc-cryptographic-primitive ;
    vc:enables ngm:digital-signature,
        ngm:merkle-tree ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:keccak-256,
        ngm:sha-256 ;
    vc:requires ngm:collision-resistance,
        ngm:preimage-resistance ;
    vc:slug "cryptographic-hash-function" ;
    vc:sourceDomain "blockchain" .

ngm:proof-of-work a owl:Class ;
    rdfs:label "Proof Of Work"@en ;
    rdfs:comment "A consensus mechanism requiring network participants to expend significant computational effort solving a cryptographic puzzle before appending a new block to the blockchain. The difficulty of the puzzle self-adjusts to maintain a target block interval, making chain rewriting computationally prohibitive and providing Sybil resistance through physical resource expenditure."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:mining-pool ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:block-reward ],
        ngm:bc-protocol-and-consensus,
        ngm:blockchain-entity,
        ngm:consensus-protocol ;
    skos:broader ngm:bc-protocol-and-consensus ;
    vc:enables ngm:distributed-ledger-technology,
        ngm:transaction-finality ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:block-reward,
        ngm:mining-pool ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:blockchain-network,
        ngm:consensus-algorithm,
        ngm:consensus-mechanism,
        ngm:mempool,
        ngm:proof-of-stake ;
    vc:slug "proof-of-work" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:cryptographic-hash-function,
        ngm:hash-function .

