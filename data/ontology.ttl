    vc:enables ngm:exoskeleton,
        ngm:rehabilitation-robotics ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:actuator,
        ngm:inverse-kinematics,
        ngm:torque-control ;
    vc:requires ngm:dynamics,
        ngm:kinematics ;
    vc:slug "biomechanics" ;
    vc:sourceDomain "robotics" ;
    vc:supports ngm:locomotion ;
    vc:uses ngm:force-control,
        ngm:series-elastic-actuator .

ngm:biometric-data a owl:Class ;
    rdfs:label "Biometric Data"@en ;
    rdfs:comment "Biometric data is a category of personal data comprising unique physiological or behavioural characteristics of an individual — such as fingerprints, facial geometry, iris patterns, voice prints, gait, and keystroke dynamics — that can be used to identify or authenticate that person. Under data protection frameworks such as GDPR, biometric data processed for identification purposes is classified as a special category of personal data subject to heightened protection. Its irrevocable nature (an individual cannot change their biometrics) makes breaches particularly consequential."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:access-control ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-schema ],
        ngm:personal-data ;
    vc:bridgesTo ngm:security ;
    vc:contrastsWith ngm:session-key ;
    vc:dependsOn ngm:data-management,
        ngm:machine-learning ;
    vc:enables ngm:digital-identity,
        ngm:policy-information-point ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:personal-data ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:governance,
        ngm:privacy ;
    vc:requires ngm:access-control,
        ngm:data-schema ;
    vc:slug "biometric-data" ;
    vc:sourceDomain "governance" ;
    vc:supports ngm:policy-administration-point,
        ngm:session-management ;
    vc:uses ngm:encryption,
        ngm:statistical-analysis .

ngm:bitcoin-transaction a owl:Class ;
    rdfs:label "Bitcoin Transaction"@en ;
    rdfs:comment "A Bitcoin transaction is a signed data structure that transfers value on the Bitcoin network by consuming unspent transaction outputs (UTXOs) and creating new ones. Each transaction references prior outputs, provides cryptographic signatures satisfying their spending conditions, and specifies new outputs locked to recipient scripts. Validated transactions are broadcast to the mempool and ultimately confirmed when included in a mined block."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:digital-signature ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:transaction-fee ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:utxo ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:bitcoin-script ],
        ngm:blockchain-transaction ;
    vc:dependsOn ngm:mining,
        ngm:proof-of-work ;
    vc:enables ngm:lightning-network,
        ngm:rgb-protocol,
        ngm:runes-protocol ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:transaction-fee,
        ngm:utxo ;
    vc:isPartOf ngm:bitcoin ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:blockchain-transaction ;
    vc:requires ngm:bitcoin-script,
        ngm:digital-signature ;
    vc:slug "bitcoin-transaction" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:mempool,
        ngm:wallet .

ngm:blend-shape a owl:Class ;
    rdfs:label "Blend Shape"@en ;
    rdfs:comment "A blend shape, also called a morph target, is a stored deformation of a 3D mesh that is blended with a base shape by a weighted interpolation of vertex positions. By combining multiple blend shapes at varying weights, animators produce smooth transitions between expressions and poses without altering the mesh topology. Blend shapes are central to facial animation, where subtle muscle movements are captured as named targets driven by animation rigs or performance capture."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:point-cloud ],
        ngm:facial-animation ;
    vc:contrastsWith ngm:skeletal-animation ;
    vc:enables ngm:character-animation,
        ngm:facial-animation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:point-cloud ;
    vc:isPartOf ngm:animation ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:avatar,
        ngm:character-animation,
        ngm:facial-animation ;
    vc:slug "blend-shape" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:avatar,
        ngm:real-time-rendering ;
    vc:uses ngm:animation-rig,
        ngm:skeletal-animation .

ngm:block-height a owl:Class ;
    rdfs:label "Block Height"@en ;
    rdfs:comment "Block Height is a monotonically increasing integer representing the position of a specific block in a blockchain, defined as the count of confirmed blocks preceding it in the canonical chain (the genesis block has height 0). Block height serves as the primary temporal reference for blockchain state: smart contracts use it for time-locked operations, miners use it to calculate block rewards and halving events, and consensus rules use it to enforce protocol upgrade activation thresholds. In the presence of forks, two competing chains may share block height values; the canonical chain is determined by the fork choice rule applied at the point of divergence."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:consensus-mechanism ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:block ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:genesis-block ],
        ngm:bc-protocol-and-consensus,
        ngm:blockchain-entity,
        ngm:distributed-data-structure ;
    skos:broader ngm:bc-protocol-and-consensus ;
    vc:dependsOn ngm:proof-of-work ;
    vc:enables ngm:blockchain-governance,
        ngm:fork-choice-rule,
        ngm:smart-contract ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:block,
        ngm:genesis-block ;
    vc:isPartOf ngm:blockchain,
        ngm:blockchain-protocol ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:block-reward,
        ngm:block-time,
        ngm:chain-reorganization,
        ngm:mining-reward ;
    vc:requires ngm:consensus-mechanism ;
    vc:slug "block-height" ;
    vc:sourceDomain "blockchain" .

ngm:block-trails a owl:Class ;
    rdfs:label "Block Trails"@en ;
    rdfs:comment "Block Trails is a minimal Bitcoin-native state-anchoring primitive that records an evolving sequence of states as a cryptographic chain of key tweaks mirroring a Bitcoin spend chain. Each state transition derives a tweak t_i = SHA256(state_i) mod n which is scalar-added to the previous key (d_i = d_(i-1) + t_i), producing a fresh pay-to-Taproot (P2TR) key-path output; spending that output to create the next commitment makes every UTXO a single-use seal. The state bytes themselves live off-chain on IPFS, Git, or Nostr relays, while Bitcoin's UTXO model supplies ordering and double-spend protection so that exactly one valid history can exist. Because trails use full secp256k1 keys, existing Nostr identities can own and advance a trail without key conversion. Application semantics are defined by Profiles such as MRC20 (a fungible-token ledger) and Git-mark (anchoring Git commits)."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:single-use-seals ],
        ngm:client-side-validation ;
    vc:bridgesTo ngm:content-addressed-storage,
        ngm:git,
        ngm:nostr ;
    vc:contrastsWith ngm:rgb-protocol,
        ngm:taproot-assets ;
    vc:dependsOn ngm:bitcoin-proof-of-work-protocol-network,
        ngm:proof-of-publication,
        ngm:utxo-model ;
    vc:enables ngm:asset-tokenisation,
        ngm:fungible-token,
        ngm:provenance-tracking ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:single-use-seals ;
    vc:implements ngm:client-side-validation,
        ngm:single-use-seals ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:decentralised-application,
        ngm:layer-2-scaling,
        ngm:rgb-and-client-side-validation ;
    vc:slug "block-trails" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:cryptographic-commitment,
        ngm:schnorr-signature,
        ngm:secp256k1,
        ngm:sha-256,
        ngm:taproot .

ngm:breadth-first-search a owl:Class ;
    rdfs:label "Breadth-First Search"@en ;
    rdfs:comment "Breadth-first search (BFS) is a graph and tree traversal algorithm that explores all neighbours of a node before moving to nodes at the next depth level, expanding the search frontier in order of increasing distance from the source. It is implemented with a first-in-first-out queue and, on unweighted graphs, finds the shortest path in terms of edge count from the start vertex to every reachable vertex. BFS runs in time linear in the number of vertices and edges and is foundational to pathfinding, connectivity analysis and level-order processing."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-structure ],
        ngm:graph-algorithms ;
    vc:contrastsWith ngm:depth-first-search ;
    vc:enables ngm:pathfinding ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:implements ngm:graph-search,
        ngm:search-algorithm ;
    vc:isPartOf ngm:graph-algorithms ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:ai-search,
        ngm:computer-science,
        ngm:dijkstra-algorithm,
        ngm:node,
        ngm:search-algorithms ;
    vc:requires ngm:data-structure ;
    vc:slug "breadth-first-search" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:algorithm,
        ngm:graph-theory .

ngm:bridge-contract a owl:Class ;
    rdfs:label "Bridge Contract"@en ;
    rdfs:comment "A Bridge Contract is a smart contract deployed on one or more blockchain networks that facilitates the transfer of tokens, messages, or state between two separate chains by locking or burning assets on the source chain and minting or releasing equivalent assets on the destination chain. Bridge contracts are the on-chain components of cross-chain bridge protocols, enforcing custody, verifying cryptographic proofs of source-chain events, and coordinating with off-chain relayers or decentralised oracle networks."@en ;
    rdfs:subClassOf ngm:smart-contract ;
    vc:enables ngm:cross-chain-asset-transfer,
        ngm:cross-chain-bridge,
        ngm:wrapped-token ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:cross-chain-interoperability,
        ngm:layer-2-scaling,
        ngm:sidechain ;
    vc:slug "bridge-contract" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:cryptographic-hash,
        ngm:relayer .

ngm:burning-mechanism a owl:Class ;
    rdfs:label "Burning Mechanism"@en ;
    rdfs:comment "A Burning Mechanism is an economic design pattern in tokenised blockchain systems whereby tokens are permanently removed from circulating supply by sending them to an unspendable address (a null or black-hole address) or by protocol-enforced destruction, permanently contracting the total token supply. Token burning is deployed as a deflationary monetary policy tool to counteract inflationary issuance, to create token scarcity as a value-accrual mechanism, to implement fee markets (as in Ethereum's EIP-1559 base fee burn), and to regulate supply in algorithmic stablecoins and tokenomics models. The economic effect depends critically on the rate and predictability of burning relative to issuance."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:blockchain-transaction ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:smart-contract ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:base-fee ],
        ngm:bc-defi-and-economics,
        ngm:blockchain-entity,
        ngm:economic-mechanism ;
    skos:broader ngm:bc-defi-and-economics ;
    vc:contrastsWith ngm:block-reward,
        ngm:inflationary-token ;
    vc:dependsOn ngm:eip-1559,
        ngm:token-economics ;
    vc:enables ngm:deflationary-token,
        ngm:inflation-control,
        ngm:tokenomics ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:base-fee ;
    vc:isPartOf ngm:tokenomics-governance ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:blockchain-economics,
        ngm:fee-market,
        ngm:market-capitalization,
        ngm:virtual-economy ;
    vc:requires ngm:blockchain-transaction,
        ngm:smart-contract ;
    vc:slug "burning-mechanism" ;
    vc:sourceDomain "blockchain" .

ngm:carbon-aware-computing a owl:Class ;
    rdfs:label "Carbon-Aware Computing"@en ;
    rdfs:comment "Carbon-aware computing is the practice of scheduling and placing computational workloads to minimise their associated greenhouse-gas emissions by responding to the time-varying and location-varying carbon intensity of electricity. Rather than only reducing energy use, it shifts flexible work to periods and regions where the grid is cleaner. The approach combines real-time grid carbon-intensity signals with workload orchestration to lower the carbon footprint of data centres and cloud services."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:energy-efficiency ],
        ngm:green-computing ;
    vc:bridgesTo ngm:renewable-energy ;
    vc:contrastsWith ngm:energy-efficiency ;
    vc:dependsOn ngm:demand-response,
        ngm:renewable-energy ;
    vc:enables ngm:carbon-footprint,
        ngm:net-zero ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:green-computing ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:carbon-accounting,
        ngm:cloud-computing,
        ngm:lifecycle-assessment ;
    vc:requires ngm:energy-efficiency ;
    vc:slug "carbon-aware-computing" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:carbon-footprint,
        ngm:environmental-sustainability ;
    vc:uses ngm:cloud-computing,
        ngm:demand-response .

ngm:carbon-neutrality-planning a owl:Class ;
    rdfs:label "Carbon Neutrality Planning"@en ;
    rdfs:comment "The strategic process of developing a comprehensive roadmap to achieve net-zero greenhouse gas emissions, encompassing emission measurement, science-based reduction targets, interim milestones, decarbonization actions, and residual emission neutralization through permanent carbon removal."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
