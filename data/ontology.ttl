ngm:cloud-rendering a owl:Class ;
    rdfs:label "Cloud Rendering"@en ;
    rdfs:comment "Cloud rendering is the practice of generating images or interactive 3D frames on remote, GPU-equipped servers and streaming the results to a client device, rather than rendering locally. It decouples visual fidelity from the client's hardware, enabling thin clients to display high-quality graphics by offloading computation to data centers. It powers cloud gaming, remote visualisation, and immersive metaverse experiences, but depends on low-latency networking and efficient video streaming to remain responsive."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:edge-computing ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
