        <urn:visionflow:linked:text-corpus> ;
    vc:implements <urn:visionflow:linked:language-identification>,
        <urn:visionflow:linked:locality-sensitive-hashing>,
        <urn:visionflow:linked:min-hash>,
        <urn:visionflow:linked:near-duplicate-removal>,
        <urn:visionflow:linked:quality-filtering>,
        <urn:visionflow:linked:sem-de-dup> ;
    vc:maturity "production-ready" ;
    vc:qualityScore "0.52"^^xsd:float ;
    vc:requires <urn:visionflow:linked:annotation-standards>,
        <urn:visionflow:linked:data-deduplication>,
        <urn:visionflow:linked:data-quality-assurance>,
