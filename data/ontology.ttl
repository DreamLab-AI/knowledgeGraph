        ngm:scara-robot ;
    vc:uses ngm:ether-cat,
        ngm:iec-61131-3 .

ngm:order-book a owl:Class ;
    rdfs:label "Order Book"@en ;
    rdfs:comment "An order book is a real-time, continuously updated electronic ledger that aggregates all outstanding limit buy orders (bids) and limit sell orders (asks) for a tradeable asset, organised by price level and, within each level, by time of arrival. A matching engine processes incoming market and limit orders against the resting book using price-time priority, generating trades whenever a bid price meets or exceeds an ask price. The visible depth of resting orders at each price level constitutes the liquidity profile of the market, and the gap between the best bid and best ask defines the bid-ask spread. Order books underpin both centralised exchanges and, increasingly, on-chain decentralised venues constrained by ledger throughput and gas costs."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:bid-ask-spread ],
        ngm:exchange-mechanism ;
    vc:bridgesTo ngm:decentralised-exchange ;
    vc:contrastsWith ngm:automated-market-maker ;
    vc:dependsOn ngm:clearing-and-settlement ;
    vc:enables ngm:liquidity-provision,
        ngm:market-making,
        ngm:price-discovery,
        ngm:trade-execution ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:bid-ask-spread,
        ngm:matching-engine ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:algorithmic-trading,
        ngm:high-frequency-trading,
        ngm:market-microstructure ;
    vc:requires ngm:limit-order ;
    vc:slug "order-book" ;
    vc:sourceDomain "finance" .

ngm:perception a owl:Class ;
    rdfs:label "Perception"@en ;
    rdfs:comment "Perception is the computational process by which an intelligent system acquires, processes, and interprets sensory signals — such as visual, auditory, tactile, or LiDAR data — to construct an internal, structured representation of the external world. It forms the foundational input stage of the sense–plan–act loop that underpins autonomous agents and robotics, translating high-dimensional raw sensor streams into semantically meaningful features, objects, or scene graphs. Modern AI perception leverages deep neural architectures — including convolutional networks, vision transformers, and multimodal encoders — to achieve robust generalisation across varied environments. It is distinct from raw data acquisition (sensing) and from higher-order cognitive reasoning, occupying the middle layer that makes physical-world understanding tractable for downstream decision systems."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:object-detection ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:speech-recognition ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:semantic-segmentation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:feature-extraction ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:sensor-fusion ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:depth-estimation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:sensor ],
        ngm:cognitive-architecture ;
    vc:bridgesTo ngm:digital-twin,
        ngm:extended-reality ;
    vc:contrastsWith ngm:planning,
        ngm:reasoning ;
    vc:dependsOn ngm:signal-processing,
        ngm:training-data ;
    vc:enables ngm:autonomous-navigation,
        ngm:human-robot-interaction,
        ngm:robotics,
        ngm:scene-understanding ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:depth-estimation,
        ngm:object-detection,
        ngm:semantic-segmentation,
        ngm:speech-recognition ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:computer-vision,
        ngm:multimodal-ai-architecture-learning,
        ngm:simultaneous-localisation-and-mapping ;
    vc:requires ngm:feature-extraction,
        ngm:sensor,
        ngm:sensor-fusion ;
    vc:slug "perception" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:convolutional-neural-network,
        ngm:deep-learning,
        ngm:point-cloud,
        ngm:transformer .

ngm:rendering-engine a owl:Class ;
    rdfs:label "Rendering Engine"@en ;
    rdfs:comment "A rendering engine is a software system that generates 2D images or animations from 3D scene descriptions through rasterisation, ray tracing, or hybrid pipelines. Modern real-time engines such as Unreal Engine 5 and Unity combine global illumination, virtualised geometry, neural shaders, and AI-driven upscaling to produce cinematic-quality visuals at interactive frame rates. They serve as the foundational compute layer for games, virtual reality, film production, and spatial-computing applications."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:shader ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:rendering-pipeline ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:scene-graph ],
        ngm:computer-graphics,
        ngm:sc-display-and-rendering ;
    skos:broader ngm:sc-display-and-rendering ;
    vc:enables ngm:film-production,
        ngm:immersive-experience,
        ngm:virtual-reality-vr ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:rendering-pipeline,
        ngm:scene-graph,
        ngm:shader ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:game-engine,
        ngm:gaussian-splatting,
        ngm:real-time-rendering,
        ngm:rendering-technique ;
    vc:slug "rendering-engine" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:global-illumination,
        ngm:gpu-compute,
        ngm:graphics-api,
        ngm:ray-tracing .

ngm:robot-control a owl:Class ;
    rdfs:label "Robot Control"@en ;
    rdfs:comment "Robot Control encompasses the systems, algorithms, and methodologies that enable robots to execute tasks autonomously or semi-autonomously through sensing, decision-making, and actuation. It integrates perception, planning, and actuation into closed-loop systems operating in dynamic environments."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:pid-control ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:motion-planning ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
