    vc:slug "autonomous-task-execution" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:automated-planning,
        ngm:large-language-models .

ngm:batch-processing a owl:Class ;
    rdfs:label "Batch Processing"@en ;
    rdfs:comment "A computational paradigm in which jobs are accumulated and executed as a group rather than individually in real-time. Batch processing optimises throughput by amortising fixed overhead across many records, enabling efficient ETL pipelines, model training over large datasets, report generation, and vulnerability scanning. Scheduling may be time-based, event-triggered, or dependency-driven."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:batch-size ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:batch-normalisation ],
        ngm:ai-infrastructure,
        ngm:infra-data-management ;
    skos:broader ngm:infra-data-management ;
    vc:contrastsWith ngm:inference ;
    vc:enables ngm:machine-learning-pipeline ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:batch-normalisation,
        ngm:batch-size ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:slug "batch-processing" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:ai-infrastructure .

ngm:batch-size a owl:Class ;
    rdfs:label "Batch Size"@en ;
    rdfs:comment "Batch Size is the number of training examples processed together in a single forward and backward pass before model parameters are updated. It is a critical hyperparameter governing the trade-off between training speed, memory usage, gradient noise, and convergence stability—small batches introduce regularising noise via stochastic gradient estimates, whilst large batches enable faster hardware utilisation but may generalise less well."@en ;
    rdfs:subClassOf ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:contrastsWith ngm:overfitting ;
    vc:dependsOn ngm:deep-learning ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:gradient-descent ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:epoch,
        ngm:hyperparameter ;
    vc:slug "batch-size" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:battery-management-system a owl:Class ;
    rdfs:label "Battery Management System"@en ;
    rdfs:comment "A Battery Management System (BMS) is an embedded electronic system that monitors, protects, and optimises the operation of a rechargeable battery pack by continuously measuring cell voltages, currents, and temperatures, then enforcing safety limits and balancing cell state-of-charge to extend pack lifetime. It provides the digital intelligence layer between raw electrochemical energy storage and the broader power electronics or vehicle system, communicating pack status via standardised interfaces such as CAN bus. Accurate state-of-charge and state-of-health estimation algorithms are the defining computational challenge of modern BMS design."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:current-sensor ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:monitoring-system ],
        ngm:embedded-systems ;
    vc:enables ngm:power-supply ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:current-sensor,
        ngm:monitoring-system ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:energy-and-power,
        ngm:energy-management,
        ngm:hardware-component ;
    vc:slug "battery-management-system" ;
    vc:sourceDomain "hardware" ;
    vc:uses ngm:control-system,
        ngm:power-management .

ngm:bayes-filter a owl:Class ;
    rdfs:label "Bayes Filter"@en ;
    rdfs:comment "BayesFilter denotes the canonical recursive probabilistic framework for sequential state estimation in partially-observable stochastic dynamical systems, computing at each timestep the posterior belief bel(x_t) = p(x_t | z_{1:t}, u_{1:t}) over the latent system state x_t conditioned on the full h..."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:prior-distribution ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:posterior-distribution ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:observation-model ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:sensor-measurements ],
        [ a owl:Restriction ;
