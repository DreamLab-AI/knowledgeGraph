vf:unesco-recommendation-on-the-ethics-of-ai a owl:Class ;
    rdfs:label "UNESCO Recommendation on the Ethics of AI"@en ;
    rdfs:comment "The UNESCO Recommendation on the Ethics of Artificial Intelligence is the first global normative framework establishing ethical principles and policy actions for responsible AI development and deployment, adopted by UNESCO's 193 Member States in November 2021. This comprehensive instrument provides shared values, principles, and actionable policy recommendations to ensure AI technologies respect human rights, protect human dignity, promote diversity and inclusion, and contribute to peaceful and just societies living in harmony with the environment. The Recommendation establishes four core values (human rights and dignity, living in peaceful just and interconnected societies, ensuring diversity and inclusiveness, environment and ecosystem flourishing) and ten foundational principles including proportionality, safety and security, fairness and non-discrimination, sustainability, right to privacy and data protection, human oversight and determination, transparency and explainability, responsibility and accountability, awareness and literacy, and multi-stakeholder and adaptive governance. Unlike legally binding treaties, UNESCO Recommendations establish normative standards that guide n"@en ;
    rdfs:subClassOf vf:artificial-intelligence ;
    vc:authorityScore "0.98"^^xsd:float ;
    vc:maturity "mature" ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:slug "unesco-recommendation-on-the-ethics-of-ai" ;
    vc:sourceDomain "artificial-intelligence" .

vf:unreal-engine a owl:Class ;
    rdfs:label "Unreal Engine"@en ;
    rdfs:comment "Unreal Engine is Epic Games' professional real-time 3D creation platform — simultaneously a [[Game Engine]], a virtual production environment, a simulation framework, and a scalable cloud-streaming service — whose fifth major generation (UE5, released April 2022) introduced Nanite virtualized micropolygon geometry (enabling film-quality assets with billions of polygons rendered in real time through a hierarchical cluster-based DAG with software rasterisation that outperforms hardware rasterisation for sub-pixel triangles), Lumen fully dynamic global illumination and reflections (ray-marched scene distance-fields and surface-cache radiosity achieving hardware ray-tracing quality on non-RTX hardware, with HWRT path available on NVIDIA RTX / AMD RDNA 2+), Chaos physics and destruction (XPBD unified solver for rigid body, cloth, soft body, fluid, vehicle, and hair simulation), World Partition streaming open-world system (automated cell-based streaming replacing manual level-streaming volumes, supporting 1 km² to continental-scale environments with One File Per Actor OFPA for multi-user collaboration), and MetaHuman Creator (browser-based 4D-scan-grounded parametric digital-human author"@en ;
    rdfs:subClassOf vf:creative-tools ;
    vc:authorityScore "0.87"^^xsd:float ;
    vc:enables vf:ai-game-agent,
        vf:cloud-rendering-service,
        vf:digital-twin,
        vf:digital-twin-creation,
        vf:film-production,
        vf:immersive-experience,
        vf:immersive-gaming,
        vf:procedural-terrain,
        vf:virtual-production-pipeline,
        vf:virtual-production-volume,
        vf:virtual-production-vp,
        vf:virtual-stage ;
    vc:hasPart vf:compute-shader,
        vf:dynamic-character-animation,
        vf:motion-capture-technology,
        vf:physics-simulation,
        vf:pixel-shader,
        vf:procedural-generation,
        vf:real-time-character-animation,
        vf:real-time-rendering ;
    vc:implements vf:3-danimation,
        vf:3-dcontent-pipeline,
        vf:fluid-simulation,
        vf:level-of-detail,
        vf:motion-capture,
        vf:occlusion-culling,
        vf:procedural-generation,
        vf:real-time-rendering ;
    vc:maturity "production-ready" ;
    vc:qualityScore "0.52"^^xsd:float ;
    vc:requires <urn:visionflow:linked:3-d-asset>,
        <urn:visionflow:linked:gpu>,
        vf:3-d-file-format,
        vf:3-d-model,
        vf:scene-graph,
        vf:scene-graph-format ;
    vc:slug "unreal-engine" ;
    vc:sourceDomain "creative-tools" .

