ngm:vision-transformers a owl:Class ;
    rdfs:comment "Transformer-based neural network architectures applied to images by splitting an image into fixed-size patches and treating those patches as a sequence of tokens for self-attention, enabling global context modelling across the full image without relying on local convolutional receptive fields."@en ;
    rdfs:label "Vision Transformers"@en ;
