ngm:semantic-scene-understanding a owl:Class ;
    rdfs:label "Semantic Scene Understanding"@en ;
    rdfs:comment "Semantic scene understanding is the computer-vision task of parsing a visual environment into labelled, structured representations of objects, surfaces, and their spatial and functional relationships. It goes beyond object detection by assigning meaning to regions, inferring affordances, and building a coherent model of the scene that downstream systems can reason over. It is foundational to spatial computing, where digital content must be anchored to real-world geometry and semantics."@en ;
    rdfs:subClassOf ngm:computer-vision ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:ar-scene-graph,
        ngm:mixed-reality ;
    vc:slug "semantic-scene-understanding" ;
    vc:sourceDomain "ai" .

ngm:semantic-web-linked-data-standard-infrastructure a owl:Class ;
    rdfs:label "Semantic Web Infrastructure"@en ;
    rdfs:comment "Semantic web infrastructure is the stack of standards, vocabularies, and services that enable machine-readable, linked data on the web, including RDF, OWL, SPARQL endpoints, triple stores, and ontology registries. It provides the technical substrate for representing entities and relationships as interoperable graphs that agents can query and reason over. It is the backbone for knowledge graphs and linked-data ecosystems."@en ;
    rdfs:subClassOf ngm:infra-data-management ;
    skos:broader ngm:infra-data-management ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:knowledge-graph,
        ngm:metaverse-ontology-schema ;
    vc:slug "semantic-web-infrastructure" ;
    vc:sourceDomain "data" .

