    vc:sourceDomain "spatial-computing" .

ngm:direct-preference-optimization a owl:Class ;
    rdfs:label "Direct Preference Optimization"@en ;
    rdfs:comment "Direct Preference Optimization (DPO) is a preference-based language model alignment algorithm introduced by Rafael Rafailov, Archit Sharma, Eric Mitchell, Stefano Ermon, Christopher D."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cross-entropy-loss ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:stochastic-gradient-descent ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gpu-compute ],
        ngm:ai-technique,
        ngm:generative-model,
        ngm:language-model-alignment ;
    skos:broader ngm:ai-technique ;
    vc:enables ngm:harmlessness-tuning,
        ngm:helpfulness-tuning,
        ngm:instruction-following,
        ngm:language-model-alignment,
        ngm:multi-turn-dialogue-alignment,
        ngm:safety-alignment,
        ngm:style-transfer-alignment ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:beta-temperature,
        ngm:bradley-terry-model,
        ngm:implicit-reward-function,
        ngm:kl-divergence-regulariser,
        ngm:log-ratio-term,
        ngm:preference-dataset,
        ngm:reference-policy ;
    vc:implements ngm:bradley-terry-luce-choice-model,
