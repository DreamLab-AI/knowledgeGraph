ngm:object-manipulation a owl:Class ;
    rdfs:label "Object Manipulation"@en ;
    rdfs:comment "The robotic capability to grasp, reorient, move, and release physical objects using end-effectors, encompassing grasp planning, force-torque control, dexterous in-hand manipulation, and task-level sequencing. Object manipulation integrates computer vision for object detection and pose estimation with tactile sensing and compliant actuation to handle diverse and unstructured items."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:end-effector ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:manipulation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:pose-estimation ],
        ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:enables ngm:collaborative-systems-modality-robot,
        ngm:industrial-robot ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:manipulation ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:requires ngm:end-effector,
        ngm:pose-estimation ;
    vc:slug "object-manipulation" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:computer-vision,
        ngm:force-control .

