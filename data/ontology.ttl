        ngm:natural-language-processing ;
    vc:slug "computation-and-intelligence-domain" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:computational-component a owl:Class ;
    rdfs:label "Computational Component"@en ;
    rdfs:comment "A Computational Component is a modular, well-defined unit of an AI or software system that encapsulates specific processing logic — such as a neural network layer, a feature extraction module, or an inference engine — and interacts with other components through defined interfaces. Computational components abstract implementation details from consumers, enabling composition into larger pipelines and substitution of equivalent implementations without modifying the surrounding system. They are the primary unit of reuse, testing, and deployment in AI infrastructure, ranging from low-level hardware accelerator kernels to high-level model serving endpoints."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:module ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:neural-network-layer ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:algorithm ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:interface ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:computational-resources ],
        ngm:ai-infrastructure,
        ngm:component ;
    vc:enables ngm:inference,
        ngm:model-training ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:algorithm,
        ngm:module,
        ngm:neural-network-layer ;
    vc:isPartOf ngm:ai-system-component,
        ngm:machine-learning-pipeline ;
    vc:qualityScore "0.0"^^xsd:float ;
