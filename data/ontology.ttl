    vc:slug "npc-interaction" ;
    vc:sourceDomain "spatial-computing" .

ngm:nvidia-jetson a owl:Class ;
    rdfs:label "NVIDIA Jetson"@en ;
    rdfs:comment "NVIDIA Jetson is a family of system-on-module (SoM) and developer kit edge computing platforms that combine NVIDIA GPU cores with ARM-based CPU clusters, purpose-built for deploying deep learning inference, computer vision, and robotics workloads at the edge with constrained power budgets. Modules in the Jetson family — including Nano, TX2, Xavier, and Orin — span from entry-level embedded devices to high-performance autonomous machine platforms, all running NVIDIA's JetPack SDK which provides CUDA, cuDNN, TensorRT, and ROS integration."@en ;
    rdfs:subClassOf ngm:edge-ai-accelerator ;
    vc:enables ngm:computer-vision,
        ngm:inference-engine ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:edge-computing,
        ngm:embedded-systems,
        ngm:gpu-computing ;
    vc:slug "nvidia-jetson" ;
    vc:sourceDomain "hardware" ;
    vc:supports ngm:edge-computing-node,
        ngm:inference-hardware ;
    vc:uses ngm:gpu-compute .

ngm:oasis a owl:Class ;
    rdfs:label "OASIS"@en ;
    rdfs:comment "OASIS (Organisation for the Advancement of Structured Information Standards) is an international, not-for-profit standards development body that produces open standards for information technology, with particular strengths in web services, security, content formats, electronic business, and emergency management. Founded in 1993, OASIS operates through technical committees that develop specifications via an open, consensus-based process, producing both OASIS Standards and publicly available specifications that are frequently adopted as ISO/IEC standards. Prominent OASIS standards include MQTT for IoT messaging, SAML for federated identity, XACML for access control, OData for REST-based data access, and the OpenDocument Format. OASIS also co-publishes standards with other bodies including the W3C and ISO."@en ;
    rdfs:subClassOf ngm:standards-body ;
    vc:enables ngm:interoperability-standard,
        ngm:open-standard ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:cybersecurity-standard,
        ngm:iso-iec,
        ngm:iso-standards,
        ngm:w3-c ;
    vc:slug "oasis" ;
    vc:sourceDomain "governance" ;
    vc:supports ngm:virtual-environment-specification ;
    vc:uses ngm:mqtt,
        ngm:rest-api .

ngm:occlusion-culling a owl:Class ;
    rdfs:label "Occlusion Culling"@en ;
    rdfs:comment "A real-time rendering optimisation technique that identifies and discards geometry hidden from the viewer's perspective before the GPU processes it. By eliminating draw calls for fully occluded objects, occlusion culling reduces GPU load and enables higher frame rates in complex virtual environments such as virtual worlds and XR applications."@en ;
    rdfs:subClassOf ngm:sc-display-and-rendering ;
    skos:broader ngm:sc-display-and-rendering ;
    vc:enables ngm:gpu-compute,
        ngm:virtual-environment ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:real-time-rendering,
        ngm:render-pipeline ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:collision-detection,
        ngm:level-of-detail ;
    vc:slug "occlusion-culling" ;
    vc:sourceDomain "spatial-computing" .

ngm:oecd-ai-principles a owl:Class ;
    rdfs:label "OECD AI Principles"@en ;
    rdfs:comment "The OECD AI Principles are a set of five intergovernmental policy guidelines adopted by the Organisation for Economic Co-operation and Development in May 2019 and subsequently endorsed by G20 leaders. The principles address inclusive growth and sustainable development, human-centred values and fairness, transparency and explainability, robustness security and safety, and accountability. They represent the first intergovernmental standard on AI and have influenced national AI strategies and regulatory frameworks worldwide. The principles are operationalised through the OECD AI Policy Observatory, which tracks AI policies across member and partner countries."@en ;
    rdfs:subClassOf ngm:responsible-ai-principles ;
    vc:enables ngm:ai-governance-framework,
        ngm:ai-regulation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:ai-ethics,
        ngm:ai-governance,
        ngm:responsible-ai,
        ngm:transparency ;
    vc:slug "oecd-ai-principles" ;
    vc:sourceDomain "governance" ;
    vc:supports ngm:accountability,
        ngm:fairness,
        ngm:human-rights .

ngm:ontology-definition a owl:Class ;
    rdfs:label "Ontology Definition"@en ;
    rdfs:comment "A formal, explicit specification of metaverse concepts, relationships, and axioms using knowledge representation frameworks (OWL, RDF, JSON-LD), defining entities through orthogonal dimensions (physicality, role) to enable semantic interoperability and automated classification across platforms. Ontologies provide foundational standards for governance, identity, and asset management, supporting machine-readable reasoning, validation, and discovery across federated and distributed systems."@en ;
    rdfs:subClassOf ngm:infra-software-engineering ;
    skos:broader ngm:infra-software-engineering ;
    vc:enables ngm:data-governance,
        ngm:interoperability,
        ngm:knowledge-graph ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:slug "ontology-definition" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:identity-management,
        ngm:metaverse-ontology ;
    vc:uses ngm:knowledge-representation,
        ngm:semantic-web .

ngm:open-api-specification a owl:Class ;
    rdfs:label "OpenAPI Specification"@en ;
    rdfs:comment "The OpenAPI Specification (OAS) is a language-agnostic, machine-readable standard for describing RESTful HTTP APIs using a structured JSON or YAML document that defines endpoints, request/response schemas, authentication methods, and parameter types. Governed by the OpenAPI Initiative (a Linux Foundation project), it enables automated generation of client SDKs, server stubs, interactive documentation, and contract-based testing from a single source of truth. Originally derived from the Swagger specification, OAS version 3.x is now the dominant industry standard for API description. It promotes interoperability by allowing API consumers to understand a service's capabilities without access to its source code."@en ;
    rdfs:subClassOf ngm:api-standard ;
    vc:enables ngm:api-integration,
        ngm:documentation-generation,
        ngm:microservices ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:api-gateway,
        ngm:api-management ;
    vc:slug "open-api-specification" ;
    vc:sourceDomain "web" ;
    vc:uses ngm:data-schema,
        ngm:json,
        ngm:rest-api .

ngm:open-id4-vp a owl:Class ;
    rdfs:label "OpenID4VP"@en ;
    rdfs:comment "OpenID for Verifiable Presentations (OpenID4VP) is an extension of the OpenID Connect and OAuth 2.0 framework that enables relying parties to request and receive W3C Verifiable Presentations from a holder's digital identity wallet using standard authorisation request-response flows. The specification defines a Presentation Exchange-compatible request syntax, transport bindings for cross-device and same-device wallets, and response encoding options for signed JWT VPs and JSON-LD credential formats. OpenID4VP allows verifiers to specify which credential types and claims are required, enabling selective disclosure and privacy-preserving identity verification without centralised identity providers holding user data."@en ;
    rdfs:subClassOf ngm:open-id-connect ;
    vc:enables ngm:decentralized-identity,
        ngm:privacy-preserving-authentication ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:open-id4-vci,
        ngm:selective-disclosure,
        ngm:w3-c-verifiable-credentials ;
    vc:slug "open-id4-vp" ;
    vc:sourceDomain "security" ;
    vc:uses ngm:digital-identity-wallet,
        ngm:oauth-2-0,
        ngm:verifiable-credentials .

ngm:open-source-framework a owl:Class ;
    rdfs:label "Open Source Framework"@en ;
    rdfs:comment "A publicly licensed software framework whose source code is freely available for inspection, modification, and redistribution under an approved open-source licence. Open source frameworks provide reusable architectural scaffolding—APIs, libraries, conventions, and tooling—that accelerate development whilst enabling community-driven quality assurance, security auditing, and interoperability across vendor boundaries."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:open-source-software ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:api-standard ],
        ngm:infra-software-engineering ;
    skos:broader ngm:infra-software-engineering ;
    vc:enables ngm:interoperability,
        ngm:machine-learning-framework ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:api-standard,
        ngm:open-source-software ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:game-engine,
        ngm:robot-operating-system ;
    vc:slug "open-source-framework" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:open-source-ai .

ngm:operations-research a owl:Class ;
    rdfs:label "Operations Research"@en ;
    rdfs:comment "Operations research (OR) is an analytical discipline that applies advanced mathematical and computational methods — including linear programming, integer optimisation, stochastic modelling, and simulation — to support decision-making in complex systems. It originated during World War II to optimise military logistics and has since expanded to industrial, financial, and humanitarian domains. OR provides rigorous frameworks for formulating trade-off problems as constrained optimisation models, then solving them to global or near-global optimality using exact solvers or heuristic methods. Modern OR integrates machine learning for parameter estimation and reinforcement learning for sequential decision problems."@en ;
    rdfs:subClassOf ngm:optimisation ;
    vc:enables ngm:logistics-optimization,
        ngm:planning-and-scheduling,
        ngm:supply-chain-management ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:decision-support,
        ngm:reinforcement-learning,
        ngm:simulation ;
    vc:slug "operations-research" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:constraint-solver,
        ngm:heuristic-methods,
        ngm:monte-carlo-methods,
        ngm:optimization-algorithm .

ngm:optical-calibration-target a owl:Class ;
    rdfs:label "Optical Calibration Target"@en ;
    rdfs:comment "A precision test pattern used for camera and imaging system calibration, including color charts, resolution targets, and geometric patterns that enable accurate measurement of color reproduction, distortion, magnification, and spatial frequency response in optical systems."@en ;
    rdfs:subClassOf ngm:calibration-equipment,
        ngm:sc-display-and-rendering ;
    skos:broader ngm:sc-display-and-rendering ;
    vc:enables ngm:optical-system-accuracy ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:slug "optical-calibration-target" ;
    vc:sourceDomain "spatial-computing" .

ngm:parameter a owl:Class ;
    rdfs:label "Parameter"@en ;
    rdfs:comment "A Parameter in machine learning and AI is a learnable variable internal to a model whose values are adjusted during training to minimise a loss function, as distinguished from hyperparameters, which are configuration choices set before training begins. In neural networks, parameters encompass weight matrices and bias vectors in each layer; the total parameter count (ranging from thousands in small models to hundreds of billions in large language models) is a primary indicator of model capacity and computational cost. Parameters are initialised randomly or via transfer learning, then updated iteratively through gradient-based optimisation algorithms such as stochastic gradient descent, encoding learned representations of the training distribution."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:model-training ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:loss-function ],
        ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:contrastsWith ngm:hyperparameter ;
    vc:enables ngm:deep-learning,
        ngm:inference ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:dropout,
        ngm:fine-tuning,
        ngm:neural-network-architecture,
        ngm:overfitting,
        ngm:transformer,
        ngm:underfitting ;
    vc:requires ngm:loss-function,
        ngm:model-training ;
    vc:slug "parameter" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:backpropagation,
        ngm:neural-network .

ngm:parametric-modeling a owl:Class ;
    rdfs:label "Parametric Modeling"@en ;
    rdfs:comment "A CAD design modology that uses algorithms and adjustable parameters to generate and modify complex 3D geometry, enabling flexible, constraint-driven design where changes to input values automatically propagate throughout the model."@en ;
    rdfs:subClassOf ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:enables ngm:generative-design ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:slug "parametric-modeling" ;
    vc:sourceDomain "spatial-computing" .

ngm:participant-coordination a owl:Class ;
    rdfs:label "Participant Coordination"@en ;
    rdfs:comment "The synchronization and management of multiple users interacting within shared virtual environments, requiring real-time pose tracking, coordinate system alignment, and collaborative state management to enable seamless multi-user experiences."@en ;
