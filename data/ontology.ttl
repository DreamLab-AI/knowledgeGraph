    vc:slug "robotic-camera-virtual-production-integration" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:machine-learning-discipline,
        ngm:robotics .

ngm:runes a owl:Class ;
    rdfs:label "Runes"@en ;
    rdfs:comment "Runes is a protocol for issuing fungible tokens directly on the Bitcoin blockchain, using the transaction model and recorded in the witness data. It launched at the Bitcoin halving in April 2024."@en ;
