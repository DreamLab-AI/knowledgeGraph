ngm:authentication a owl:Class ;
    rdfs:label "Authentication"@en ;
    rdfs:comment "Authentication is the security process of verifying that a claimed identity of a user, device, application, or service is genuine before granting access to protected resources. It is fundamentally distinct from authorisation, which determines what permissions an authenticated principal possesses. Authentication evidence is categorised into knowledge factors (passwords, PINs, security questions), possession factors (hardware security keys, TOTP devices, mobile authenticators), and inherence factors (biometrics such as fingerprint or facial recognition), with cryptographic proofs (digital signatures, TLS client certificates, FIDO2 passkeys) increasingly replacing shared-secret schemes. Modern secure systems combine multiple independent factors through multi-factor authentication to achieve strong resistance against credential theft, phishing, replay attacks, and session hijacking."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptography ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:identity-verification ],
        ngm:identity-and-access-management ;
    vc:bridgesTo ngm:decentralised-identity,
        ngm:self-sovereign-identity,
        ngm:verifiable-credentials ;
    vc:contrastsWith ngm:anonymity,
        ngm:authorisation ;
    vc:dependsOn ngm:digital-signatures,
        ngm:key-management,
        ngm:secure-communication ;
    vc:enables ngm:access-control,
        ngm:authorisation,
        ngm:session-management,
        ngm:single-sign-on ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:implements ngm:fido2-webauthn,
        ngm:oauth-2,
        ngm:openid-connect,
        ngm:saml ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:biometrics,
        ngm:federation,
        ngm:multi-factor-authentication,
        ngm:threat-model ;
    vc:requires ngm:cryptography,
        ngm:identity-verification,
        ngm:public-key-infrastructure ;
    vc:slug "authentication" ;
    vc:sourceDomain "security" ;
    vc:supports ngm:compliance,
        ngm:privacy,
        ngm:zero-trust-architecture .

