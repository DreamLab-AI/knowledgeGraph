    vc:slug "imf-crypto-asset-classification-framework" ;
    vc:sourceDomain "blockchain" .

ngm:immersion-cooling a owl:Class ;
    rdfs:label "Immersion Cooling"@en ;
    rdfs:comment "Immersion cooling is a thermal-management technique in which electronic hardware is submerged directly in a thermally conductive but electrically insulating dielectric fluid to dissipate heat. It offers far higher heat-transfer efficiency than air cooling, enabling denser deployments and lower cooling energy overhead. The technique is widely adopted in high-density data centres and cryptocurrency-mining facilities."@en ;
    rdfs:subClassOf ngm:computing-infrastructure ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:bitcoin-proof-of-work-protocol-mining ;
    vc:slug "immersion-cooling" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:bitcoin-proof-of-work-protocol-environmental-issues .

