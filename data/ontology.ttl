        ngm:spatial-anchors,
        ngm:web-rtc .

ngm:tele-027-spatial-platform a owl:Class ;
    rdfs:label "TELE-027-spatial-platform"@en ;
    rdfs:comment "Spatial is a collaboration platform that hosts virtual rooms where participants meet as avatars to share documents, 3D models and media for meetings, events and presentations."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
