ngm:instruction-following a owl:Class ;
    rdfs:label "Instruction Following"@en ;
    rdfs:comment "Instruction following is a language model capability enabling accurate parsing and faithful execution of explicit user or system directives specified in natural language, encompassing multi-step tasks, output format constraints, persona assignments, conditional branching, and constraint satisfaction. It is principally acquired through supervised instruction tuning on curated (instruction, response) datasets and further refined via reinforcement learning from human feedback (RLHF) or direct preference optimisation (DPO). Instruction following is evaluated by the degree to which a model correctly fulfils all stated requirements simultaneously without omitting or violating any constraint, and is a prerequisite for reliable agentic behaviour where a model must decompose and execute multi-step plans expressed as natural language specifications. Failure modes include instruction forgetting in long contexts, sycophantic overriding, and specification gaming."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:instruction-tuning ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:supervised-fine-tuning ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:rlhf ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:large-language-model ],
        ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:bridgesTo ngm:human-computer-interaction,
        ngm:robotic-task-planning ;
    vc:contrastsWith ngm:specification-gaming,
        ngm:sycophancy ;
    vc:dependsOn ngm:attention-mechanism,
        ngm:context-window,
        ngm:natural-language-understanding ;
    vc:enables ngm:agentic-ai,
        ngm:autonomous-planning,
        ngm:function-calling,
        ngm:multi-agent-systems,
        ngm:tool-use ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:alignment,
        ngm:constitutional-ai,
        ngm:helpfulness,
        ngm:ifeval,
        ngm:prompt-engineering ;
    vc:requires ngm:instruction-tuning,
        ngm:large-language-model,
        ngm:rlhf,
        ngm:supervised-fine-tuning ;
    vc:slug "instruction-following" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:chain-of-thought-reasoning,
        ngm:direct-preference-optimisation,
        ngm:structured-output,
        ngm:system-prompt .

ngm:key-derivation-function a owl:Class ;
    rdfs:label "Key Derivation Function"@en ;
    rdfs:comment "A cryptographic algorithm that derives one or more secret keys from a master secret using a pseudo-random function, transforming human-readable passwords or seed phrases into cryptographically secure key material while enabling hierarchical key generation, deterministic wallet recovery, and password-based encryption in security and blockchain systems."@en ;
    rdfs:subClassOf ngm:cryptographic-primitive ;
    vc:bridgesTo ngm:blockchain,
        ngm:mnemonic-phrase ;
    vc:contrastsWith ngm:random-key-generation,
        ngm:symmetric-key-exchange ;
    vc:dependsOn ngm:cryptography ;
    vc:enables ngm:asymmetric-encryption,
        ngm:deterministic-key-generation,
        ngm:hierarchical-deterministic-wallet,
        ngm:symmetric-encryption ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:implements ngm:bip32,
        ngm:bip39,
        ngm:password-hashing ;
    vc:isPartOf ngm:public-key-infrastructure ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:argon2,
        ngm:hkdf,
        ngm:pbkdf2,
        ngm:scrypt ;
    vc:requires ngm:entropy-source,
        ngm:master-secret ;
    vc:slug "key-derivation-function" ;
    vc:sourceDomain "security" ;
    vc:standardizedBy ngm:nist-sp800-132,
        ngm:rfc-8018 ;
    vc:supports ngm:key-management,
        ngm:private-key,
        ngm:wallet-security ;
    vc:uses ngm:hash-function,
        ngm:hmac,
        ngm:pseudo-random-function,
        ngm:salt .

ngm:kv-cache a owl:Class ;
    rdfs:label "KV Cache"@en ;
    rdfs:comment "A KV Cache (Key-Value Cache) in transformer-based language models is a memory structure that stores the computed key and value projection tensors from the multi-head self-attention mechanism for all previously processed tokens in a sequence, allowing autoregressive decoding to reuse these intermediate results rather than recomputing them at every generation step, thereby reducing the per-token computational cost from O(N²) to O(N) in generation. Each decoder layer maintains its own KV cache, which grows linearly with sequence length and model width, making memory bandwidth and GPU HBM capacity the primary constraints on inference throughput for long-context models. KV cache management strategies — including paged allocation (PagedAttention), prefix sharing, quantisation, and off-loading — are critical determinants of serving efficiency and cost."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:high-bandwidth-memory ],
        ngm:inference-engine ;
    vc:bridgesTo ngm:distributed-inference,
        ngm:virtual-memory-management ;
    vc:contrastsWith ngm:linear-attention,
        ngm:state-space-model ;
    vc:dependsOn ngm:attention-mechanism,
        ngm:query-key-value,
        ngm:self-attention ;
    vc:enables ngm:autoregressive-decoding,
        ngm:inference,
        ngm:prompt-caching,
        ngm:speculative-decoding ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:key-projection,
        ngm:value-projection ;
    vc:implements ngm:paged-attention,
        ngm:prefix-sharing ;
    vc:isPartOf ngm:inference-engine,
        ngm:transformer-architecture ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:context-window,
        ngm:grouped-query-attention,
        ngm:large-language-models ;
    vc:requires ngm:gpu-memory,
        ngm:high-bandwidth-memory ;
    vc:slug "kv-cache" ;
    vc:sourceDomain "machine-learning" ;
    vc:uses ngm:flash-attention,
        ngm:gpu-compute,
        ngm:hardware-acceleration,
        ngm:quantisation .

ngm:kyc-aml a owl:Class ;
    rdfs:label "KYC/AML"@en ;
    rdfs:comment "KYC/AML refers to Know Your Customer and Anti-Money Laundering regulatory requirements that obligate financial institutions to verify customer identities and monitor transactions for illicit activity. KYC governs identity verification and risk profiling at onboarding, while AML covers ongoing monitoring, suspicious-activity reporting and sanctions screening. These regimes shape compliance for banks, exchanges and crypto-asset service providers."@en ;
    rdfs:subClassOf ngm:regulatory-compliance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:blockchain-analysis,
        ngm:distributed-identity ;
    vc:slug "kyc-aml" ;
    vc:sourceDomain "governance" .

ngm:liquid-democracy a owl:Class ;
    rdfs:label "Liquid Democracy"@en ;
    rdfs:comment "Liquid democracy is a hybrid participatory governance model that synthesises direct democracy and representative democracy by permitting each participant either to cast their vote on a proposal directly or to delegate their voting weight transitively to a trusted proxy, who may in turn re-delegate to another agent, forming an arbitrarily deep delegation chain. Delegations are revocable at any point before a proposal closes, preserving individual sovereignty over the vote. In distributed-systems and blockchain governance contexts the model is implemented via smart-contract delegation registries and off-chain signalling layers, enabling token holders or identity-verified citizens to assign on-chain voting power to domain experts while retaining the right to override on any individual proposal."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:sybil-resistance ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:identity-verification ],
        ngm:bc-governance-and-regulation ;
    skos:broader ngm:bc-governance-and-regulation ;
    vc:bridgesTo ngm:collective-intelligence,
        ngm:multi-agent-systems ;
    vc:contrastsWith ngm:conviction-voting,
        ngm:direct-democracy,
        ngm:quadratic-voting,
        ngm:representative-democracy ;
    vc:dependsOn ngm:erc-20-votes,
        ngm:token-weighted-voting ;
    vc:enables ngm:dao-governance,
        ngm:delegative-democracy,
        ngm:on-chain-governance,
        ngm:participatory-governance ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:implements ngm:transitive-delegation,
        ngm:vote-weight-aggregation ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:decentralised-autonomous-organisation,
        ngm:futarchy,
        ngm:holographic-consensus,
        ngm:snapshot-governance ;
    vc:requires ngm:identity-verification,
        ngm:sybil-resistance,
        ngm:vote-checkpointing ;
    vc:slug "liquid-democracy" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:delegation-graph,
        ngm:governance-token,
        ngm:smart-contract,
        ngm:voting-mechanism .

ngm:load-balancer a owl:Class ;
