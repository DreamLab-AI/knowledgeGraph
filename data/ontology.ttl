ngm:clinical-decision-support a owl:Class ;
    rdfs:label "Clinical Decision Support"@en ;
    rdfs:comment "Clinical Decision Support (CDS) refers to AI systems that provide healthcare professionals with patient-specific assessments, recommendations, and information to support clinical decision-making at the point of care. CDS systems integrate patient data, medical knowledge bases, clinical guidelines, and evidence-based protocols to assist in diagnosis, treatment selection, medication management, and care coordination whilst maintaining clinician autonomy and clinical judgement."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:interoperability ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-integration ],
        ngm:medical-ai ;
    vc:bridgesTo ngm:healthcare-analytics,
        ngm:telecollaboration ;
    vc:contrastsWith ngm:autonomous-medical-ai ;
    vc:enables ngm:medical-diagnosis-ai,
        ngm:medication-safety,
        ngm:preventive-care,
        ngm:treatment-planning-ai ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:alert-fatigue-management,
        ngm:clinical-pathway-guidance,
        ngm:drug-interaction-checking ;
    vc:isPartOf ngm:electronic-health-record ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:explainable-ai,
        ngm:health-data-privacy ;
    vc:requires ngm:data-integration,
        ngm:electronic-health-record,
        ngm:interoperability,
        ngm:medical-knowledge-base ;
    vc:slug "clinical-decision-support" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:standardizedBy ngm:cds-hooks,
