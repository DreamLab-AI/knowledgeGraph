# Resilience Metric
spatial-computing:ResilienceMetric rdf:type owl:Class ;
    rdfs:label "Resilience Metric"@en ;
    rdfs:comment "Resilience metrics are quantitative and qualitative measurements assessing system robustness, fault tolerance, and recovery capabilities within digital and physical infrastructure, encompassing availability percentages, RecoveryTimeObjective, and failure rates that determine operational continuity. These metrics enable proactive IncidentResponse and SLAVerification across CloudInfrastructure, MetaversePlatforms, and BlockchainNetworks. Effective resilience measurement combines real-time monitoring, predictive analytics, and automated remediation to maintain service quality during adverse conditions."@en ;
    skos:prefLabel "Resilience Metric"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:spatial-computing:resilience-metric" ;
    owl:sameAs <urn:visionclaw:concept:spatial-computing:resilience-metric> ;
    vcw:contentHash "sha256-12-f5a0fd45e468" ;
    vcw:qualityScore "0.4"^^xsd:decimal ;
    vcw:legacyTermId "MV-3047" ;
    vcw:ontologyStatus "draft" ;
    vcw:maturityLevel "draft" ;
    vcw:authorityScore "0.0"^^xsd:decimal ;
    dcterms:identifier "MV-3047" ;
    dcterms:subject "spatial-computing" ;
    owl:versionInfo "2.0.0" ;
    dcterms:created "2026-04-26T00:00:00Z"^^xsd:dateTime ;
    dcterms:modified "2026-04-26T13:00:00Z"^^xsd:dateTime ;
    vcw:owlRole "Concept" .

# SLAM
spatial-computing:SLAM rdf:type owl:Class ;
    rdfs:label "SLAM"@en ;
    rdfs:comment "Simultaneous Localization and Mapping (SLAM) is a robotics and computer vision technique enabling devices to build maps of unknown environments whilst simultaneously tracking their own position within those environments, combining LocalizationTechnique and MapConstruction in real-time. Essential for AutonomousNavigation, AugmentedReality, and AutonomousVehicles, SLAM processes sensor data from LiDAR, RGBDCamera, and VisualOdometry to estimate robot pose and build spatial representations. Modern implementations integrate DeepLearning for improved robustness and performance in dynamic environments."@en ;
    skos:prefLabel "SLAM"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:spatial-computing:slam" ;
    owl:sameAs <urn:visionclaw:concept:spatial-computing:slam> ;
    vcw:contentHash "sha256-12-0b5f55181f25" ;
    vcw:qualityScore "0.4"^^xsd:decimal ;
    vcw:legacyTermId "MV-3049" ;
    vcw:ontologyStatus "draft" ;
    vcw:maturityLevel "draft" ;
    vcw:authorityScore "0.0"^^xsd:decimal ;
    dcterms:identifier "MV-3049" ;
    dcterms:subject "spatial-computing" ;
    owl:versionInfo "2.0.0" ;
    dcterms:created "2026-04-26T00:00:00Z"^^xsd:dateTime ;
    dcterms:modified "2026-04-26T13:00:00Z"^^xsd:dateTime ;
    vcw:owlRole "Concept" .

# Authorised Representative
spatial-computing:AuthorisedRepresentative rdf:type owl:Class ;
    rdfs:label "Authorised Representative"@en ;
    rdfs:comment "A natural or legal person located or established in the Union who has received and accepted a written mandate from a provider of an AI system or a general-purpose AI model to, respectively, perform and carry out on its behalf the tasks and procedures established by this Regulation."@en ;
    skos:prefLabel "Authorised Representative"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:spatial-computing:authorised-representative" ;
    owl:sameAs <urn:visionclaw:concept:spatial-computing:authorised-representative> ;
