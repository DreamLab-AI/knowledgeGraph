        ngm:spatial-audio ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:slug "audio-technology" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:audio-processing-system .

ngm:austrian-economics a owl:Class ;
    rdfs:label "Austrian Economics"@en ;
    rdfs:comment "Austrian Economics is a heterodox school of economic thought originating in late 19th-century Vienna, most associated with Carl Menger, Ludwig von Mises, and Friedrich Hayek. It emphasises methodological individualism, the subjective theory of value, and the role of entrepreneurship in coordinating dispersed knowledge through price signals. The school critiques central planning and Keynesian intervention on the grounds that spontaneous market order cannot be replicated by any central authority, and that artificial credit expansion inevitably produces malinvestment and business cycles. Austrian insights have strongly influenced Bitcoin monetary theory, particularly the argument that hard-capped supply reproduces the properties of sound, commodity-backed money."@en ;
    rdfs:subClassOf ngm:economics ;
    vc:contrastsWith ngm:inflation-control,
        ngm:monetary-sovereignty ;
    vc:enables ngm:bitcoin-value-proposition,
        ngm:hyperbitcoinization ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:inflation,
        ngm:monetary-policy-implementation,
        ngm:sound-money ;
    vc:slug "austrian-economics" ;
    vc:sourceDomain "finance" ;
    vc:supports ngm:bitcoin-standard,
        ngm:decentralisation .

ngm:automated-compliance a owl:Class ;
    rdfs:label "Automated Compliance"@en ;
    rdfs:comment "Automated Compliance refers to the use of software systems and rule engines to continuously monitor, evaluate, and enforce regulatory requirements without manual intervention. It encompasses real-time policy checking, evidence collection, and exception reporting across business processes and IT systems. By embedding compliance logic directly into workflows, organisations can dramatically reduce audit burden and human error. The discipline draws on regulatory technology, policy engines, and audit trails to provide defensible evidence of conformance. It is particularly vital in heavily regulated sectors such as financial services, healthcare, and data protection."@en ;
    rdfs:subClassOf ngm:compliance-framework ;
    vc:enables ngm:compliance-audit-trail,
        ngm:compliance-monitoring,
        ngm:compliance-verification ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:ai-governance,
        ngm:gdpr-compliance,
        ngm:risk-management ;
    vc:slug "automated-compliance" ;
    vc:sourceDomain "governance" ;
    vc:uses ngm:audit-trail,
        ngm:policy-engine,
        ngm:regulatory-technology .

ngm:bandwidth-optimization a owl:Class ;
    rdfs:label "Bandwidth Optimization"@en ;
    rdfs:comment "Bandwidth Optimisation is the set of techniques and algorithms that maximise the effective throughput of network links by reducing unnecessary data transmission, prioritising critical traffic, and intelligently managing congestion. It encompasses data compression, deduplication, caching, traffic shaping, protocol selection, and adaptive bitrate strategies applied across local, wide-area, and wireless network infrastructures."@en ;
    rdfs:subClassOf ngm:quality-of-service ;
    vc:enables ngm:latency-management-protocol,
        ngm:low-latency ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:cdn,
        ngm:network-latency ;
    vc:slug "bandwidth-optimization" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:content-delivery-network,
        ngm:data-compression .

ngm:beam-search a owl:Class ;
    rdfs:label "Beam Search"@en ;
    rdfs:comment "Beam search is a heuristic search algorithm that explores a graph by expanding the most promising nodes within a fixed-width frontier, called the beam, at each step. In sequence generation tasks it retains the top-k candidate sequences at each decoding step rather than pursuing a single greedy choice, balancing exploration against computational cost."@en ;
    rdfs:subClassOf ngm:search-algorithm ;
    vc:enables ngm:machine-translation,
        ngm:text-generation ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:beam-search-decoding,
        ngm:monte-carlo-tree-search ;
    vc:slug "beam-search" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:heuristic-methods,
        ngm:language-model .

ngm:behavioral-learning a owl:Class ;
    rdfs:label "Behavioral Learning"@en ;
    rdfs:comment "An AI-driven approach that analyzes and predicts user behavior patterns from digital interactions including clicks, browsing patterns, movement trajectories, and gaze tracking, enabling automated decision-making and personalized experiences through machine learning and pattern recognition."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:machine-learning-models ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-collection ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:pattern-recognition ],
        ngm:machine-learning,
        ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:enables ngm:personalization,
        ngm:predictive-analytics,
        ngm:user-experience-optimization ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:data-collection,
        ngm:machine-learning-models,
        ngm:pattern-recognition ;
    vc:slug "behavioral-learning" ;
    vc:sourceDomain "spatial-computing" .

ngm:binaural-rendering a owl:Class ;
    rdfs:label "Binaural Rendering"@en ;
    rdfs:comment "Binaural rendering is the audio signal processing technique that synthesises a three-dimensional sound field deliverable over standard headphones by convolving audio sources with head-related transfer functions (HRTFs) that model the acoustic filtering imposed by the human head, pinnae, and torso. The result is the perceptual illusion of sounds emanating from specific spatial locations outside the headphones, enabling immersive audio experiences in virtual and augmented reality environments."@en ;
    rdfs:subClassOf ngm:spatial-audio ;
    vc:enables ngm:immersive-audio,
        ngm:immersive-experience ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:audio-spatialization,
        ngm:extended-reality-xr ;
    vc:slug "binaural-rendering" ;
    vc:sourceDomain "spatial" ;
    vc:uses ngm:audio-processing,
        ngm:convolution .

ngm:biometric-binding-mechanism a owl:Class ;
    rdfs:label "Biometric Binding Mechanism"@en ;
    rdfs:comment "Physical hardware device that captures and verifies biometric traits (fingerprints, iris patterns, facial geometry) to bind digital identities to authenticated users."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:encrypted-storage ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:power-supply ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:optical-sensor-array ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:infrared-illuminator ],
        ngm:sc-governance-and-safety ;
    skos:broader ngm:sc-governance-and-safety ;
    vc:enables ngm:access-control,
        ngm:identity-verification,
        ngm:multi-factor-authentication,
        ngm:non-repudiation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:facial-recognition-sensor,
        ngm:fingerprint-scanner,
        ngm:iris-recognition-camera,
        ngm:secure-element-chip,
        ngm:template-matching-processor ;
    vc:isPartOf ngm:identity-management-system,
        ngm:zero-trust-security-framework ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:anti-spoofing-module,
        ngm:encrypted-storage,
        ngm:infrared-illuminator,
        ngm:optical-sensor-array,
        ngm:power-supply ;
    vc:slug "biometric-binding-mechanism" ;
    vc:sourceDomain "spatial-computing" .

ngm:bip-342 a owl:Class ;
    rdfs:label "BIP-342"@en ;
    rdfs:comment "BIP-342 specifies Tapscript, the updated Bitcoin scripting language that replaces legacy script in the script-path spending branch of Taproot (BIP-341) outputs. Tapscript updates the signature opcodes to use BIP-340 Schnorr signatures, introduces the OP_CHECKSIGADD opcode to enable efficient threshold multisignature constructions, relaxes script resource limits, and establishes an extensible opcode upgrade mechanism via OP_SUCCESS opcodes for future soft forks."@en ;
    rdfs:subClassOf ngm:bitcoin-improvement-proposals ;
    vc:enables ngm:multisignature,
        ngm:taproot ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:bip-327,
        ngm:bip-340-schnorr-keypair ;
    vc:slug "bip-342" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:bitcoin-script,
        ngm:schnorr-signature .

ngm:block-height a owl:Class ;
    rdfs:label "Block Height"@en ;
    rdfs:comment "Block Height is a monotonically increasing integer representing the position of a specific block in a blockchain, defined as the count of confirmed blocks preceding it in the canonical chain (the genesis block has height 0). Block height serves as the primary temporal reference for blockchain state: smart contracts use it for time-locked operations, miners use it to calculate block rewards and halving events, and consensus rules use it to enforce protocol upgrade activation thresholds. In the presence of forks, two competing chains may share block height values; the canonical chain is determined by the fork choice rule applied at the point of divergence."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:genesis-block ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:consensus-mechanism ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:block ],
        ngm:bc-protocol-and-consensus,
        ngm:blockchain-entity,
        ngm:distributed-data-structure ;
    skos:broader ngm:bc-protocol-and-consensus ;
    vc:dependsOn ngm:proof-of-work ;
    vc:enables ngm:blockchain-governance,
        ngm:fork-choice-rule,
        ngm:smart-contract ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:block,
        ngm:genesis-block ;
    vc:isPartOf ngm:blockchain,
        ngm:blockchain-protocol ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:block-reward,
        ngm:block-time,
        ngm:chain-reorganization,
        ngm:mining-reward ;
    vc:requires ngm:consensus-mechanism ;
    vc:slug "block-height" ;
    vc:sourceDomain "blockchain" .

ngm:block-structure a owl:Class ;
    rdfs:label "Block Structure"@en ;
    rdfs:comment "Block structure is the internal data layout of a block in a blockchain or distributed ledger, specifying the fields, encoding formats, and cryptographic commitments that constitute a valid unit of the chain. A block consists of a header containing metadata — including the parent block hash, timestamp, nonce, and Merkle root of the transaction set — and a body containing the ordered list of transactions or state transitions. The specific fields, size limits, and serialisation rules of the block structure are defined by the network's consensus protocol and directly govern the chain's security properties, throughput, and upgrade path."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:transaction ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:merkle-root ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:merkle-tree ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:nonce ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:block-header ],
        ngm:block ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:block-header,
        ngm:merkle-root,
        ngm:merkle-tree,
        ngm:nonce,
        ngm:transaction ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:block-size,
        ngm:block-time,
        ngm:blockchain ;
    vc:slug "block-structure" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:cryptographic-hash .

ngm:blockchain-analysis a owl:Class ;
    rdfs:label "Blockchain Analysis"@en ;
    rdfs:comment "Blockchain analysis is the systematic examination of distributed ledger transaction data to identify patterns, trace fund flows, attribute addresses to entities, and detect illicit activity. It applies graph analytics, heuristic clustering, and machine-learning techniques to publicly available on-chain records to support compliance, law enforcement, and financial intelligence functions."@en ;
    rdfs:subClassOf ngm:digital-forensics ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:blockchain-analytics-platform ;
    vc:slug "blockchain-analysis" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:aml-kyc-compliance,
        ngm:kyc-aml ;
    vc:uses ngm:blockchain-analytics,
        ngm:heuristic-methods .

ngm:blockchain-ledger a owl:Class ;
    rdfs:label "Blockchain Ledger"@en ;
    rdfs:comment "A Blockchain Ledger is the authoritative, append-only register of all validated transactions and state changes maintained collectively by participants in a blockchain network, representing the shared ground truth from which account balances, ownership records, and contract states are derived. Unlike a traditional centralised ledger maintained by a single institution, a blockchain ledger is replicated across potentially thousands of nodes, with consensus rules ensuring that all honest participants converge on the same view of history. Its integrity derives from cryptographic chaining rather than institutional trust."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptographic-hash ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:immutable-record ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:blockchain-consensus ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:blockchain-transaction ],
        ngm:distributed-ledger ;
    vc:enables ngm:audit-trail,
        ngm:transparency ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:blockchain-transaction,
        ngm:immutable-record ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:record-keeping-system ;
    vc:requires ngm:blockchain-consensus,
        ngm:cryptographic-hash ;
    vc:slug "blockchain-ledger" ;
    vc:sourceDomain "blockchain" .

ngm:bluetooth-le a owl:Class ;
    rdfs:label "Bluetooth LE"@en ;
    rdfs:comment "Bluetooth LE (Low Energy), also known as Bluetooth Smart, is a short-range wireless communication protocol introduced in Bluetooth 4.0 (2010) and standardised by the Bluetooth SIG, designed to transmit small amounts of data at low duty cycles while consuming a fraction of the power of Classic Bluetooth. It operates in the 2.4 GHz ISM band with 40 channels, using frequency-hopping spread spectrum, and is optimised for battery-constrained devices that need to remain active for months or years on a coin cell."@en ;
    rdfs:subClassOf ngm:bluetooth-low-energy ;
    vc:enables ngm:internet-of-things,
        ngm:proximity-detection ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:embedded-systems,
        ngm:near-field-communication,
        ngm:zigbee ;
    vc:slug "bluetooth-le" ;
    vc:sourceDomain "infrastructure" ;
    vc:standardizedBy ngm:bluetooth-sig ;
    vc:uses ngm:low-energy-consumption .

ngm:bluetooth-low-energy a owl:Class ;
    rdfs:label "Bluetooth Low Energy"@en ;
    rdfs:comment "Bluetooth Low Energy (BLE) is the formal designation of the low-power wireless communication mode introduced in the Bluetooth 4.0 Core Specification (2010), standardised by the Bluetooth SIG, enabling battery-constrained devices to communicate over short ranges (typically 10–100 m) using duty-cycled radio bursts with peak currents measured in milliamps. It defines a complete protocol stack from physical layer through application profiles, and has become the dominant short-range radio for wearable, medical, industrial, and IoT devices."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:bluetooth-le ],
        ngm:internet-of-things ;
    vc:enables ngm:sensor-technology,
        ngm:service-discovery ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:bluetooth-le ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:near-field-communication,
        ngm:thread-protocol,
        ngm:zigbee ;
    vc:slug "bluetooth-low-energy" ;
    vc:sourceDomain "infrastructure" ;
    vc:standardizedBy ngm:bluetooth-sig ;
    vc:uses ngm:embedded-systems .

ngm:bridge-contract a owl:Class ;
    rdfs:label "Bridge Contract"@en ;
    rdfs:comment "A Bridge Contract is a smart contract deployed on one or more blockchain networks that facilitates the transfer of tokens, messages, or state between two separate chains by locking or burning assets on the source chain and minting or releasing equivalent assets on the destination chain. Bridge contracts are the on-chain components of cross-chain bridge protocols, enforcing custody, verifying cryptographic proofs of source-chain events, and coordinating with off-chain relayers or decentralised oracle networks."@en ;
    rdfs:subClassOf ngm:smart-contract ;
    vc:enables ngm:cross-chain-asset-transfer,
        ngm:cross-chain-bridge,
        ngm:wrapped-token ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:cross-chain-interoperability,
        ngm:layer-2-scaling,
        ngm:sidechain ;
    vc:slug "bridge-contract" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:cryptographic-hash,
        ngm:relayer .

ngm:cache-layer a owl:Class ;
    rdfs:label "Cache Layer"@en ;
    rdfs:comment "A cache layer is an intermediate storage tier interposed between a data consumer and an authoritative data source, holding frequently or recently accessed data in faster storage to reduce latency, decrease load on origin systems, and improve overall system throughput. Cache layers operate at multiple levels of a computing stack—CPU caches, in-process memory caches, distributed shared caches, and edge CDN caches—each exploiting temporal or spatial locality of access patterns. Correctness requires coherence protocols or explicit invalidation strategies to prevent stale data from being served."@en ;
    rdfs:subClassOf ngm:storage-layer ;
    vc:enables ngm:performance-optimization,
        ngm:scalability ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:content-delivery-network-cdn,
        ngm:database-system,
        ngm:latency ;
    vc:slug "cache-layer" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:data-storage,
        ngm:kv-cache .

ngm:calibration-standards a owl:Class ;
    rdfs:label "Calibration Standards"@en ;
    rdfs:comment "Documented specifications and reference materials that establish measurement accuracy requirements, traceability to national standards, and systematic procedures for aligning sensors, displays, and imaging systems to known reference values in XR and computer vision applications."@en ;
    rdfs:subClassOf ngm:sc-standards-and-interop,
        ngm:technical-standard ;
    skos:broader ngm:sc-standards-and-interop ;
    vc:enables ngm:device-alignment,
        ngm:measurement-accuracy,
        ngm:quality-assurance ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires ngm:reference-materials,
        ngm:traceability-chain,
        ngm:validation-procedures ;
    vc:slug "calibration-standards" ;
    vc:sourceDomain "spatial-computing" .

ngm:camera-tracking a owl:Class ;
    rdfs:label "Camera Tracking"@en ;
    rdfs:comment "Camera Tracking is the process of continuously estimating the position and orientation (pose) of a camera in 3D space relative to a fixed reference frame or scene, typically using image feature analysis, optical flow, or fiducial marker detection. It underpins augmented reality, visual effects compositing, robotic navigation, and autonomous vehicle perception by enabling virtual or computed elements to be correctly registered to the physical world as the camera moves."@en ;
    rdfs:subClassOf ngm:motion-tracking ;
    vc:enables ngm:augmented-reality,
        ngm:slam,
        ngm:visual-odometry ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:epipolar-geometry,
        ngm:pose-estimation ;
    vc:slug "camera-tracking" ;
    vc:sourceDomain "spatial" ;
    vc:uses ngm:feature-detection,
        ngm:marker-based-tracking,
        ngm:optical-flow .

ngm:capital-adequacy a owl:Class ;
    rdfs:label "Capital Adequacy"@en ;
    rdfs:comment "Capital adequacy is the regulatory and risk management requirement that financial institutions maintain a minimum level of capital relative to their risk-weighted assets, ensuring they can absorb losses without becoming insolvent and thereby protecting depositors, counterparties, and the broader financial system. The Basel Committee on Banking Supervision (BCBS) has codified capital adequacy requirements through successive accords — Basel I (1988), Basel II (2004), Basel III (2010, phased through 2028) — specifying the composition of qualifying capital (Common Equity Tier 1, Additional Tier 1, Tier 2) and the risk-weighting methodologies for credit, market, and operational risk exposures."@en ;
    rdfs:subClassOf ngm:compliance-framework ;
    vc:enables ngm:compliance-monitoring ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:compliance,
        ngm:risk-assessment,
        ngm:risk-management ;
    vc:slug "capital-adequacy" ;
    vc:sourceDomain "finance" ;
    vc:standardizedBy ngm:basel-committee-on-banking-supervision .

ngm:cdn a owl:Class ;
    rdfs:label "CDN"@en ;
    rdfs:comment "A Content Delivery Network (CDN) is a geographically distributed network of proxy servers and data centres that caches and serves web content from locations physically close to end users, reducing latency, relieving origin server load, and improving resilience against traffic spikes and denial-of-service attacks. CDNs operate through anycast routing, edge caching policies, and real-time traffic steering algorithms to deliver optimal user experience across diverse network conditions."@en ;
    rdfs:subClassOf ngm:content-delivery-network ;
    vc:enables ngm:bandwidth-optimization,
        ngm:latency ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:cloud-infrastructure,
        ngm:content-delivery-network-cdn,
        ngm:internet-infrastructure ;
    vc:slug "cdn" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:edge-computing,
        ngm:network-protocol,
        ngm:network-security .

ngm:character-animation a owl:Class ;
    rdfs:label "Character Animation"@en ;
    rdfs:comment "Character animation is the discipline of creating the illusion of life and intentional movement in digital or physical characters through the coordinated manipulation of skeletal rigs, blend shapes, and motion data across time, driven by principles derived from traditional film animation. It encompasses the full pipeline from rigging and skinning a character mesh to authoring, retargeting, and blending motion clips in real time, and extends to AI-driven procedural and physics-based approaches that generate plausible movement without manual keyframing. The field spans offline cinematic animation for film and games and real-time systems for interactive avatars, XR experiences, and virtual humans."@en ;
    rdfs:subClassOf ngm:animation ;
    vc:enables ngm:avatar-animation,
        ngm:dynamic-character-animation,
        ngm:real-time-character-animation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:animation-retargeting,
        ngm:procedural-animation ;
    vc:slug "character-animation" ;
    vc:sourceDomain "graphics" ;
    vc:uses ngm:character-rigging,
        ngm:forward-kinematics,
        ngm:inverse-kinematics,
        ngm:motion-capture .

ngm:climate-modelling a owl:Class ;
    rdfs:label "Climate Modelling"@en ;
    rdfs:comment "Climate Modelling is the scientific discipline of constructing mathematical and computational representations of Earth's climate system to simulate past, present, and future climate states. Models range from simple energy-balance equations to high-resolution coupled atmosphere-ocean-land-ice systems running on supercomputing infrastructure. They underpin global projections published by the Intergovernmental Panel on Climate Change and inform policy decisions on emissions reduction and adaptation. Machine learning is increasingly integrated to accelerate parameterisation and downscaling. Outputs feed directly into carbon accounting, sustainability planning, and digital twin applications."@en ;
    rdfs:subClassOf ngm:digital-twin ;
    vc:enables ngm:carbon-footprint-measurement,
        ngm:carbon-neutrality-planning,
        ngm:sustainability-reporting ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:digital-twin-of-society-dto-s,
        ngm:environmental-sustainability,
        ngm:iso-14064 ;
    vc:slug "climate-modelling" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:high-performance-computing,
        ngm:machine-learning,
        ngm:time-series-forecasting .

ngm:coinbase-transaction a owl:Class ;
    rdfs:label "Coinbase Transaction"@en ;
    rdfs:comment "The first transaction in every blockchain block, created by the miner or block producer, that contains no inputs and issues the block reward plus accumulated transaction fees to the miner's address. Unlike regular transactions, the coinbase transaction has no sender; it creates new coins from protocol-defined issuance rules and serves as the primary mechanism by which new cryptocurrency enters circulation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:consensus-mechanism ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:block-reward ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:transaction-fee ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:mining ],
        ngm:bc-protocol-and-consensus,
        ngm:blockchain-entity,
        ngm:consensus-protocol ;
    skos:broader ngm:bc-protocol-and-consensus ;
    vc:enables ngm:cryptocurrency,
        ngm:mining-reward ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:block-reward,
        ngm:transaction-fee ;
    vc:isPartOf ngm:blockchain-network,
        ngm:blockchain-transaction ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:blockchain-protocol,
        ngm:proof-of-work ;
    vc:requires ngm:consensus-mechanism,
        ngm:mining ;
    vc:slug "coinbase-transaction" ;
    vc:sourceDomain "blockchain" .

ngm:collaboration-tools a owl:Class ;
    rdfs:label "Collaboration Tools"@en ;
    rdfs:comment "Software that supports people working together on shared tasks or documents, including communication, coordination and concurrent editing features."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:network-architecture ],
        ngm:software-development ;
    vc:enables ngm:operational-transformation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:network-architecture ;
    vc:slug "collaboration-tools" ;
    vc:sourceDomain "distributed-systems" .

ngm:collaborative-robotics a owl:Class ;
    rdfs:label "Collaborative Robotics"@en ;
    rdfs:comment "Collaborative Robotics is the engineering discipline concerned with designing, deploying, and operating robotic systems — particularly collaborative robots (cobots) — that share workspace and tasks with human workers without requiring physical barriers, relying instead on force-torque sensing, speed-and-separation monitoring, and power-and-force limiting to maintain safety under ISO 10218 and ISO/TS 15066. Unlike traditional industrial robots that operate in guarded cages, cobots are designed with compliant joints, rounded profiles, and real-time collision-detection to enable direct physical cooperation with humans on assembly, inspection, and logistics tasks. The discipline integrates mechanical design, control theory, human-robot interaction research, and regulatory compliance."@en ;
    rdfs:subClassOf ngm:collaborative-robot ;
    vc:enables ngm:assistive-robotics,
        ngm:manufacturing-automation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:cobot-safety-levels,
        ngm:human-robot-interaction,
        ngm:industrial-robot,
        ngm:robot-safety ;
    vc:slug "collaborative-robotics" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:end-effector,
        ngm:force-torque-sensor,
        ngm:impedance-control .

ngm:collective-governance a owl:Class ;
    rdfs:label "Collective Governance"@en ;
    rdfs:comment "A system of rules, norms, and decision-making processes through which a group of stakeholders jointly determines how shared resources, organisations, or platforms are managed. It distributes authority among participants rather than concentrating it in a single administrator, seeking legitimacy through inclusive participation and transparent deliberation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:coordination-mechanisms ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:collective-action ],
        ngm:community-governance ;
    vc:enables ngm:dao-governance,
        ngm:polycentric-governance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:collective-decision-making,
        ngm:community-decision-making ;
    vc:requires ngm:collective-action,
        ngm:coordination-mechanisms ;
    vc:slug "collective-governance" ;
    vc:sourceDomain "governance" .

ngm:comfy-ui-client a owl:Class ;
    rdfs:label "ComfyUI Client"@en ;
