        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:vr-controllers ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:3-d-user-interface ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
