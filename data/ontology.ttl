ngm:danksharding a skos:Concept ;
    rdfs:label "Danksharding"@en .

ngm:data-availability-sampling a skos:Concept ;
    rdfs:label "Data Availability Sampling"@en .

ngm:data-model a owl:Class ;
    rdfs:label "Data Model"@en ;
    rdfs:comment "A data model is an abstract specification of how data elements are structured, related and constrained within a domain or system. It defines entities, attributes, relationships and integrity rules at conceptual, logical or physical levels of abstraction. Data models are prerequisites for metadata standards and for designing storage, exchange and querying of data."@en ;
    rdfs:subClassOf ngm:infra-data-management ;
    skos:broader ngm:infra-data-management ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:data-management,
        ngm:metadata-standard ;
    vc:slug "data-model" ;
    vc:sourceDomain "data" .

ngm:database-management-system a owl:Class ;
    rdfs:label "Database Management System"@en ;
    rdfs:comment "A database management system (DBMS) is software that defines, stores, retrieves, secures and manages structured data while enforcing integrity, concurrency and durability. It mediates all access to the underlying database through a query interface and transaction manager, supporting models such as relational, document, key-value and graph. It is the foundational platform for persistent data services including ontology repositories and taxonomy registries."@en ;
    rdfs:subClassOf ngm:infra-data-management ;
    skos:broader ngm:infra-data-management ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:digital-ontology-repository,
        ngm:digital-taxonomy-registry ;
    vc:slug "database-management-system" ;
    vc:sourceDomain "data" .

ngm:dds-middleware a owl:Class ;
    rdfs:label "DDS Middleware"@en ;
    rdfs:comment "Data Distribution Service (DDS) Middleware is an OMG-standardised publish-subscribe communication middleware designed for real-time, scalable, and decentralised data exchange in safety-critical and high-performance distributed systems. It defines a Data-Centric Publish-Subscribe (DCPS) model in which participants discover each other automatically and exchange typed data via a global data space, governed by a rich set of Quality of Service (QoS) policies covering reliability, latency, deadline, liveliness, and durability. DDS is the foundational communication layer for ROS 2, NATO's STANAG 4910 tactical networks, and aerospace control systems."@en ;
    rdfs:subClassOf ngm:middleware ;
    vc:enables ngm:collaborative-systems-modality-robotics,
        ngm:industrial-robot,
        ngm:robot-kinematics ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:distributed-system-protocol,
        ngm:middleware-layer,
        ngm:real-time-rendering ;
    vc:slug "dds-middleware" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:communication-protocol,
        ngm:distributed-systems,
        ngm:embedded-systems .

ngm:de-fi-protocol a owl:Class ;
    rdfs:label "De Fi Protocol"@en ;
    rdfs:comment "A blockchain-based financial application providing decentralized financial services via smart contracts."@en ;
    rdfs:subClassOf ngm:bc-defi-and-economics ;
    skos:broader ngm:bc-defi-and-economics ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:implements ngm:blockchain ;
    vc:qualityScore "0.4"^^xsd:float ;
    vc:slug "de-fi-protocol" ;
    vc:sourceDomain "blockchain" .

ngm:decentralised-coordination a owl:Class ;
    rdfs:label "Decentralised Coordination"@en ;
    rdfs:comment "Decentralised coordination refers to mechanisms by which multiple autonomous agents—human or machine—achieve collective outcomes without a central authority directing behaviour, relying instead on shared protocols, incentive structures, consensus rules, or emergent social norms. In blockchain contexts it manifests as DAO governance, token-based voting, and smart-contract-enforced agreements that replace managerial hierarchy with algorithmic rule."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:consensus-mechanism ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:byzantine-fault-tolerance ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:token-weighted-voting ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:conviction-voting ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:smart-contract ],
        ngm:autonomous-governance ;
    vc:bridgesTo ngm:ai-agent-coordination,
        ngm:multi-agent-systems ;
    vc:contrastsWith ngm:centralised-governance,
        ngm:hierarchical-organisation ;
    vc:enables ngm:dao-governance,
        ngm:on-chain-treasury-management,
        ngm:permissionless-participation ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:conviction-voting,
        ngm:multi-sig-treasury,
        ngm:token-weighted-voting ;
    vc:implements ngm:mechanism-design,
        ngm:ostrom-design-principles ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:algorithmic-governance,
        ngm:commons-governance,
        ngm:game-theory ;
    vc:requires ngm:byzantine-fault-tolerance,
        ngm:consensus-mechanism,
        ngm:smart-contract ;
    vc:slug "decentralised-coordination" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:asynchronous-coordination,
        ngm:dao,
        ngm:incentive-mechanism,
        ngm:quadratic-voting .

ngm:decentralised-decision-making a owl:Class ;
    rdfs:label "Decentralised Decision-Making"@en ;
    rdfs:comment "Decentralised Decision-Making is a governance paradigm in which authority to make binding choices is distributed across multiple autonomous actors — individuals, nodes, or smart contracts — rather than concentrated in a single hierarchical centre, typically relying on voting mechanisms, consensus protocols, or market-based coordination to aggregate preferences and resolve conflicts. In blockchain and DAO contexts, decentralised decision-making is operationalised through on-chain proposal-and-vote cycles, token-weighted or quadratic voting, and cryptographically enforced execution of outcomes via smart contracts. The paradigm spans organisational theory, political science, distributed systems, and mechanism design, with implementations ranging from holocratic corporations to fully autonomous protocol governance."@en ;
    rdfs:subClassOf ngm:decentralized-governance ;
    vc:enables ngm:blockchain-governance,
        ngm:dao-governance,
        ngm:on-chain-governance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:consensus-mechanism,
        ngm:dao,
        ngm:liquid-democracy,
        ngm:mechanism-design ;
    vc:slug "decentralised-decision-making" ;
    vc:sourceDomain "governance" ;
    vc:uses ngm:governance-token,
        ngm:quadratic-voting,
        ngm:snapshot-voting .

ngm:decentralized-exchange-dex a owl:Class ;
    rdfs:label "Decentralized Exchange (DEX)"@en ;
    rdfs:comment "Peer-to-peer marketplace enabling direct token swaps and digital asset trading through smart contracts without centralized intermediaries or custodial control."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
