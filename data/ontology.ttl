    vc:relatedTo ngm:blockchain-entity ;
    vc:relatedTo ngm:decentralised-coordination ;
    vc:slug "autonomous-governance" ;
    vc:sourceDomain "blockchain" .
ngm:autonomous-manipulation a owl:Class ;
    rdfs:comment "Autonomous manipulation is the capability of a robot to perceive, plan and physically interact with objects to achieve a task goal without step-by-step human teleoperation. It integrates perception, grasp and motion planning, force control and feedback to handle uncertainty in object pose, shape and contact dynamics. The aim is robust, closed-loop interaction in unstructured environments rather than the repetition of pre-programmed trajectories."@en ;
    rdfs:label "Autonomous Manipulation"@en ;
    rdfs:subClassOf ngm:robotic-manipulation ;
    rdfs:subClassOf _:r2442 ;
    rdfs:subClassOf _:r2443 ;
