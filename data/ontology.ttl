    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:data-management,
        ngm:knowledge-management ;
    vc:slug "ontology-technical-details" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:data-structure,
        ngm:distributed-ledger .

ngm:organisational-theory a owl:Class ;
    rdfs:label "Organisational Theory"@en ;
    rdfs:comment "The study of structural, behavioural, and governance patterns within organisations as they adopt distributed collaboration and immersive technologies. Organisational theory examines how hierarchies, communication channels, decision-making processes, and incentive structures must adapt to support decentralised, asynchronous, and spatially distributed teams operating within metaverse and mixed-reality workspaces."@en ;
    rdfs:subClassOf ngm:dc-protocol-and-infra ;
    skos:broader ngm:dc-protocol-and-infra ;
    vc:enables ngm:community-governance,
        ngm:decentralized-governance ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:collaboration-platform,
        ngm:knowledge-management ;
    vc:slug "organisational-theory" ;
    vc:sourceDomain "distributed-collaboration" ;
    vc:supports ngm:collaboration,
        ngm:governance-model .

ngm:ouroboros-consensus a owl:Class ;
    rdfs:label "Ouroboros Consensus"@en ;
    rdfs:comment "Ouroboros is a provably secure proof-of-stake consensus protocol developed for the Cardano blockchain, the first PoS protocol to be formally verified with cryptographic security proofs equivalent to those of proof-of-work systems. It divides blockchain time into epochs and slots, using a verifiable random function to elect slot leaders from among stake pools proportionally to their delegated stake, enabling secure, energy-efficient block production without trusted setup."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:finality ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:blockchain-protocol ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:consensus-mechanism ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:epoch ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptography ],
        ngm:bc-protocol-and-consensus,
        ngm:proof-of-stake ;
    skos:broader ngm:bc-protocol-and-consensus ;
    vc:contrastsWith ngm:byzantine-fault-tolerance,
        ngm:delegated-proof-of-stake,
        ngm:liquid-proof-of-stake,
        ngm:nominated-proof-of-stake ;
    vc:enables ngm:blockchain-governance,
        ngm:blockchain-sustainability,
        ngm:probabilistic-finality ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:epoch,
        ngm:finality ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:blockchain-network,
        ngm:blockchain-scalability,
        ngm:consensus-algorithm ;
    vc:requires ngm:blockchain-protocol,
        ngm:consensus-mechanism,
