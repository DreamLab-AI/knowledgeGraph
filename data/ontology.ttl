    vc:slug "grc-platform" ;
    vc:sourceDomain "governance" ;
    vc:supports ngm:regulatory-compliance,
        ngm:risk-management ;
    vc:uses ngm:audit-logging,
        ngm:policy-as-code,
        ngm:risk-assessment .

ngm:green-mining-pool a owl:Class ;
    rdfs:label "Green Mining Pool"@en ;
    rdfs:comment "A green mining pool is a cooperative of cryptocurrency miners that aggregates hashing power while sourcing electricity predominantly from renewable or low-carbon generation, often coupling mining to surplus or curtailed grid energy. It rewards participants for verified sustainable energy use and reports the carbon intensity of the pooled hashrate. The model aims to reduce the environmental footprint of proof-of-work consensus."@en ;
    rdfs:subClassOf ngm:bc-network-component ;
    skos:broader ngm:bc-network-component ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:green-blockchain-initiatives,
        ngm:sustainable-bitcoin-protocol ;
    vc:slug "green-mining-pool" ;
    vc:sourceDomain "blockchain" .

