ngm:open-webui-and-pipelines a owl:Class ;
    rdfs:label "Open Webui and Pipelines"@en ;
    rdfs:comment "Open WebUI (formerly Ollama WebUI, created by Tim Jaeryang Baek, first released October 2023, + GitHub stars by mid-2025) is a self-hosted, ChatGPT-equivalent web interface for interacting with local and remote Large Language Models through a polished conversational UI, supporting Ollama ..."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:local-llm-runtime-platform ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:large-language-models ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:model-control-protocols-like-mcp ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:retrieval-augmented-generation-rag ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:local-llm-runtime-platform ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:docker-containerisation-platform ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:function-calling ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:stable-diffusion-image-model ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:compute-infrastructure ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:openai-research-organisation-whisper ],
        ngm:chatbots,
        ngm:retrieval-augmented-generation-rag ;
    vc:bridgesTo ngm:ai-infrastructure ;
    vc:enables ngm:function-calling,
        ngm:knowledge-graphing,
        ngm:model-optimisation-and-performance,
        ngm:prompt-engineering,
        ngm:reasoning ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:function-calling,
        ngm:local-llm-runtime-platform,
        ngm:model-control-protocols-like-mcp,
        ngm:openai-research-organisation-whisper,
        ngm:retrieval-augmented-generation-rag,
        ngm:stable-diffusion-image-model ;
    vc:implements ngm:function-calling,
        ngm:model-control-protocols-like-mcp,
        ngm:retrieval-augmented-generation-rag,
        ngm:speech-and-voice ;
    vc:qualityScore "0.52"^^xsd:float ;
    vc:relatedTo ngm:cli-multi-agent-systems,
        ngm:hardware-and-edge,
        ngm:large-scale-pretrained-foundation-model,
        ngm:meta-llama-model-family-3,
        ngm:mistral-ai-open-weight-model-family ;
    vc:requires ngm:compute-infrastructure,
        ngm:docker-containerisation-platform,
        ngm:large-language-models,
        ngm:local-llm-runtime-platform ;
    vc:slug "open-webui-and-pipelines" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:standardizedBy ngm:function-calling,
        ngm:model-control-protocols-like-mcp ;
    vc:supports ngm:agent-frameworks,
        ngm:education-and-ai,
        ngm:home-assistant,
        ngm:knowledge-graphing,
        ngm:prompt-engineering ;
    vc:uses ngm:flux-1,
        ngm:local-llm-runtime-platform,
        ngm:node-based-diffusion-pipeline-interface,
        ngm:openai-research-organisation-whisper,
        ngm:stable-diffusion-image-model .

