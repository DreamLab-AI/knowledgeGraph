ngm:david-chaum a owl:Class ;
    rdfs:label "David Chaum"@en ;
    rdfs:comment "American computer scientist and cryptographer who pioneered digital cash, blind signatures and anonymous communication, and is widely regarded as a founder of the cypherpunk and privacy technology fields."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:public-key-cryptography ],
        ngm:cryptography ;
    vc:enables ngm:cryptocurrency,
        ngm:privacy ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:public-key-cryptography ;
    vc:slug "david-chaum" ;
    vc:sourceDomain "cryptographic" .

