ngm:embodied-ai-simulation a owl:Class ;
    rdfs:label "Embodied AI Simulation"@en ;
    rdfs:comment "Embodied AI Simulation is the practice of training, evaluating, and validating autonomous agents and robotic systems within physically accurate, interactive virtual environments before deployment on real hardware. These simulation platforms render high-fidelity physics (rigid and soft-body dynamics, fluid simulation, contact forces), sensor models (cameras, LiDAR, IMU, depth sensors), and procedurally generated scenes to expose agents to diverse scenarios at scale. Sim-to-real transfer methods — including domain randomisation, domain adaptation, and curriculum learning — are applied to close the fidelity gap between simulated and real-world conditions. The discipline spans household robot manipulation tasks, autonomous vehicle testing, humanoid locomotion, and multi-agent coordination, bridging artificial intelligence research with physical robotic deployment."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:robot-kinematics ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:synthetic-data ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:physics-engine ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:reinforcement-learning ],
        ngm:virtual-environment ;
    vc:bridgesTo ngm:extended-reality,
        ngm:metaverse,
        ngm:robotics ;
    vc:contrastsWith ngm:hardware-in-the-loop,
        ngm:physical-robot-testing ;
    vc:dependsOn ngm:gpu-computing,
        ngm:parallel-computing ;
    vc:enables ngm:autonomous-vehicle,
        ngm:robo-actuation-and-control,
        ngm:robo-navigation-and-planning,
        ngm:robot-learning ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:physics-engine,
        ngm:scene-generation,
        ngm:sensor-simulation,
        ngm:synthetic-data ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:curriculum-learning,
        ngm:digital-twin,
        ngm:multi-agent-systems ;
    vc:requires ngm:domain-randomisation,
        ngm:reinforcement-learning,
        ngm:robot-kinematics ;
    vc:slug "embodied-ai-simulation" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:computer-vision,
        ngm:deep-learning,
        ngm:generative-adversarial-network,
        ngm:nvidia-corporation-omniverse-platform .

ngm:emergent-capabilities a owl:Class ;
    rdfs:label "Emergent Capabilities"@en ;
    rdfs:comment "Emergent Capabilities are abilities that appear in large language models at scale but are absent or near-random in smaller models, seemingly arising abruptly as parameters, data, or compute increase. Examples include multi-step reasoning, in-context learning, and instruction following. Their unpredictability complicates capability forecasting and is central to debates about scaling and AI safety."@en ;
    rdfs:subClassOf ngm:large-language-models ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:frontier-models,
        ngm:model-training ;
    vc:slug "emergent-capabilities" ;
    vc:sourceDomain "ai" .

ngm:energy-efficiency a owl:Class ;
    rdfs:label "Energy Efficiency"@en ;
    rdfs:comment "Energy efficiency is the property of a system that achieves a given output or function while consuming the least possible energy. In computing, robotics, and control systems it is measured as useful work per unit of energy, and is improved through better algorithms, hardware, scheduling, and motion optimisation. It is a core sustainability objective because reductions in energy draw lower operating cost and carbon footprint without sacrificing performance."@en ;
    rdfs:subClassOf ngm:sustainability ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:sustainability,
        ngm:velocity-control ;
    vc:slug "energy-efficiency" ;
    vc:sourceDomain "infrastructure" .

ngm:etl a skos:Concept ;
    rdfs:label "Etl"@en .

ngm:fca a owl:Class ;
    rdfs:label "FCA"@en ;
    rdfs:comment "The Financial Conduct Authority (FCA) is the UK's statutory conduct regulator for financial services and markets, established under the Financial Services and Markets Act 2000 and reconstituted by the Financial Services Act 2012. Operating independently of government and funded by industry fees, it authorises firms, supervises conduct across retail and wholesale markets, and enforces anti-money-laundering obligations. In the digital asset sphere the FCA registers crypto-asset businesses under the Money Laundering Regulations, regulates crypto financial promotions, and coordinates with the Bank of England and HM Treasury on emerging regulatory frameworks for stablecoins, custody, and tokenised finance."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:compliance-framework ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:kyc ],
        ngm:infra-legal-and-regulatory ;
    skos:broader ngm:infra-legal-and-regulatory ;
    vc:bridgesTo ngm:crypto-asset-regulation,
        ngm:decentralised-finance,
        ngm:digital-asset-custody,
        ngm:stablecoin ;
    vc:contrastsWith ngm:esma,
        ngm:sec ;
    vc:enables ngm:financial-promotion,
        ngm:fintech-innovation,
        ngm:regulatory-sandbox ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:financial-services-and-markets-act,
        ngm:money-laundering-regulations ;
    vc:qualityScore "0.73"^^xsd:float ;
    vc:relatedTo ngm:bank-of-england,
