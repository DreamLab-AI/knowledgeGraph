    owl:onProperty ngm:supports ;
    owl:someValuesFrom rb:CollaborativeRobotics
] .

rb:AdmittanceControl rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:supports ;
    owl:someValuesFrom rb:SurgicalRobotics
] .

rb:AdmittanceControl rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:supports ;
    owl:someValuesFrom rb:AssemblyAutomation
] .

rb:AdmittanceControl rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:supports ;
    owl:someValuesFrom rb:PolishingOperations
] .

rb:AdmittanceControl rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:supports ;
    owl:someValuesFrom rb:RehabilitationRobotics
] .

rb:AdmittanceControl rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:uses ;
    owl:someValuesFrom rb:ForceSensor
] .

rb:AdmittanceControl rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:uses ;
    owl:someValuesFrom rb:PositionControlLoop
] .

rb:AdmittanceControl rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:uses ;
    owl:someValuesFrom rb:AdmittanceFilter
] .

rb:AdmittanceControl rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:uses ;
    owl:someValuesFrom rb:FeedforwardCompensation
] .

rb:AdmittanceControl rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:uses ;
    owl:someValuesFrom rb:AdaptiveControl
] .

rb:AdmittanceControl rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:contrastsWith ;
    owl:someValuesFrom rb:ImpedanceControl
] .

