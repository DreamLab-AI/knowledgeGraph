ngm:distributor a owl:Class ;
    rdfs:label "Distributor"@en ;
    rdfs:comment "A Distributor is a natural or legal person in the AI supply chain, other than the provider or the importer, that makes an AI system available on the Union market without modifying it. Distributors bear verification and cooperation duties under the EU AI Act Article 24, including confirming CE marking, ensuring documentation completeness, and informing authorities of suspected non-compliance."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:regulatory-compliance ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:conformity-assessment ],
        ngm:sc-governance-and-safety ;
    skos:broader ngm:sc-governance-and-safety ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:supply-chain ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:deployer,
        ngm:importer,
        ngm:market-surveillance-authority,
        ngm:provider ;
    vc:requires ngm:conformity-assessment,
        ngm:regulatory-compliance ;
    vc:slug "distributor" ;
    vc:sourceDomain "spatial-computing" .

