ngm:noise-cancellation a owl:Class ;
    rdfs:label "Noise Cancellation"@en ;
    rdfs:comment "Noise cancellation is the process of reducing or eliminating unwanted audio signals from a primary audio stream using signal processing techniques. Active noise cancellation generates an anti-phase signal to destructively interfere with the noise, while passive methods use physical barriers. The technique is applied in audio hardware, telecommunications, and AI-driven speech enhancement systems to improve clarity and intelligibility."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:signal-processing ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:microphone ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:audio-processing ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:digital-signal-processor ],
        ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:contrastsWith ngm:passive-noise-isolation ;
    vc:enables ngm:speech-recognition,
        ngm:voice-communication ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:audio-processing,
        ngm:signal-processing ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:acoustic-engineering,
        ngm:edge-computing,
        ngm:natural-language-processing ;
    vc:requires ngm:digital-signal-processor,
        ngm:microphone ;
    vc:slug "noise-cancellation" ;
    vc:sourceDomain "ai" ;
    vc:supports ngm:spatial-audio,
        ngm:teleconferencing ;
    vc:uses ngm:deep-learning,
        ngm:machine-learning,
        ngm:neural-network .

ngm:noise-function a owl:Class ;
    rdfs:label "Noise Function"@en ;
    rdfs:comment "A Noise Function is a deterministic pseudo-random function that maps spatial coordinates to smoothly varying scalar values, providing the controllable randomness behind procedural content. Gradient-based variants such as Perlin and Simplex noise produce coherent, band-limited fields that can be layered into fractal octaves to synthesise terrain, clouds, and textures. Because output depends only on input coordinates and a seed, noise functions are reproducible and efficiently evaluable on the GPU."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:interpolation ],
        ngm:procedural-generation ;
    vc:bridgesTo ngm:random-number-generation ;
    vc:enables ngm:procedural-generation,
        ngm:shader ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:interpolation ;
    vc:implements ngm:gpu-computing ;
    vc:isPartOf ngm:spatial-computing ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:gpu-computing,
        ngm:interpolation,
        ngm:shader ;
    vc:slug "noise-function" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:procedural-generation ;
    vc:uses ngm:interpolation,
        ngm:random-number-generation .

ngm:noise-mechanisms a owl:Class ;
    rdfs:label "Noise Mechanisms"@en ;
    rdfs:comment "Noise mechanisms are the algorithmic primitives in differential privacy that add calibrated random perturbation to query results or data so that the contribution of any single individual is statistically masked. The amount of noise is calibrated to the query's sensitivity and the desired privacy budget, balancing privacy protection against the accuracy of released statistics. The principal mechanisms are the Laplace, Gaussian, and exponential mechanisms, each suited to particular query types and privacy definitions."@en ;
    rdfs:subClassOf ngm:differential-privacy ;
    vc:dependsOn ngm:privacy-budget,
        ngm:sensitivity ;
    vc:enables ngm:data-privacy,
        ngm:privacy-preserving-technology ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:gaussian-mechanism,
        ngm:laplace-mechanism ;
    vc:implements ngm:differential-privacy ;
    vc:isPartOf ngm:differential-privacy ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:epsilon-differential-privacy,
        ngm:noise-injection ;
    vc:requires ngm:privacy-budget ;
    vc:slug "noise-mechanisms" ;
    vc:sourceDomain "security" ;
    vc:supports ngm:data-anonymization ;
    vc:uses ngm:gaussian-mechanism,
        ngm:laplace-mechanism .

ngm:noise-reduction a owl:Class ;
    rdfs:label "Noise Reduction"@en ;
    rdfs:comment "Noise reduction is the family of techniques that attenuate unwanted random or structured disturbances in a signal while preserving the underlying information of interest. It ranges from classical linear and spectral filtering to statistical estimators and learned denoising models that infer clean signals from noisy observations. Effective noise reduction improves downstream perception, measurement and machine-learning tasks by raising the signal-to-noise ratio."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:signal-processing ],
