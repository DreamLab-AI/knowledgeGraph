ngm:q-learning a owl:Class ;
    rdfs:comment "Q-learning is a model-free, off-policy reinforcement learning algorithm that learns the value of taking a given action in a given state by iteratively updating an action-value (Q) function towards a bootstrapped Bellman target. Because it learns the optimal action-value function regardless of the policy being followed, it converges to optimal behaviour without requiring a model of the environment's dynamics. It is a foundational algorithm extended by deep Q-networks for high-dimensional problems."@en ;
    rdfs:label "Q Learning"@en ;
    rdfs:subClassOf ngm:reinforcement-learning ;
    rdfs:subClassOf ngm:reinforcement-learning-algorithm ;
