    vc:implements ngm:convolutional-neural-network,
        ngm:scale-invariant-feature-transform ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:computer-vision,
        ngm:image-processing-software,
        ngm:object-detection,
        ngm:optical-flow,
        ngm:stereo-vision ;
    vc:requires ngm:c-plus-plus ;
    vc:slug "open-cv" ;
    vc:sourceDomain "machine-learning" ;
    vc:supports ngm:augmented-reality,
