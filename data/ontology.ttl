    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:display-hardware,
        ngm:gpu-resources,
        ngm:graphics-api ;
    vc:slug "visualization-layer" ;
    vc:sourceDomain "spatial-computing" .

