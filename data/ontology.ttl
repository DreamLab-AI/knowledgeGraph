    vc:relatedTo ngm:radar ;
    vc:relatedTo ngm:sensor-fusion ;
    vc:relatedTo ngm:slam ;
    vc:slug "rb-0069-lidar" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:autonomous-vehicle ;
    vc:uses ngm:drone-navigation ;
    vc:uses ngm:mobile-robot .
ngm:rb-0070-tactile-sensing a owl:Class ;
    rdfs:comment "Tactile sensing is the robotic capability to detect and measure contact forces, pressures, textures, and slip at points of physical interaction between the robot and its environment or human operators. Realised through arrays of pressure sensors, capacitive skins, or piezoelectric films distributed across end-effectors and link surfaces, tactile sensing enables compliant grasping, contact-triggered safety stops, and rich feedback for teleoperation. It is a key enabling technology for human-robot collaboration under ISO/TS 15066."@en ;
    rdfs:label "rb 0070 tactile sensing"@en ;
    rdfs:subClassOf ngm:robo-perception ;
    rdfs:subClassOf ngm:tactile-sensor ;
    skos:broader ngm:robo-perception ;
    vc:enables ngm:collaborative-systems-modality-operation ;
    vc:enables ngm:haptic-feedback ;
    vc:enables ngm:rb-0092-protective-stop ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:force-control ;
    vc:relatedTo ngm:sensor-fusion ;
    vc:slug "rb-0070-tactile-sensing" ;
    vc:sourceDomain "robotics" ;
    vc:standardizedBy ngm:iso-ts-15066 ;
    vc:uses ngm:force-torque-sensor ;
    vc:uses ngm:pressure-sensor .
ngm:rb-0072-encoder a owl:Class ;
    rdfs:comment "An encoder in robotics is a proprioceptive transducer that converts the angular or linear position of a joint or actuator shaft into a digital electrical signal, providing the position and velocity feedback essential for closed-loop control. Encoders are categorised as incremental (providing relative position pulses) or absolute (outputting a unique code for each position), with absolute rotary encoders being preferred in safety-critical collaborative robot applications due to their power-loss resilience. High-resolution encoders directly determine robot accuracy, repeatability, and the fidelity of safety functions such as speed limitation."@en ;
    rdfs:label "rb 0072 encoder"@en ;
    rdfs:subClassOf ngm:proprioceptive-sensor ;
    rdfs:subClassOf ngm:robo-perception ;
    rdfs:subClassOf _:r22968 ;
    skos:broader ngm:robo-perception ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:rotary-encoder ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:rb-0026-robot-joint ;
    vc:relatedTo ngm:rb-0034-repeatability ;
    vc:relatedTo ngm:rb-0035-accuracy ;
    vc:slug "rb-0072-encoder" ;
    vc:sourceDomain "robotics" ;
    vc:supports ngm:rb-0047-feedback-control ;
    vc:supports ngm:rb-0054-position-control ;
    vc:supports ngm:rb-0093-speed-limitation ;
    vc:uses ngm:rb-0066-robot-sensor .
ngm:rb-0073-imu a owl:Class ;
    rdfs:comment "An Inertial Measurement Unit (IMU) is an electronic device that measures and reports a body's specific force, angular rate, and sometimes magnetic field using a combination of accelerometers, gyroscopes, and optional magnetometers. In robotics, IMUs provide high-frequency proprioceptive feedback for state estimation, pose tracking, and stabilisation control, and are commonly fused with odometry or SLAM algorithms to reduce drift."@en ;
    rdfs:label "rb 0073 imu"@en ;
    rdfs:subClassOf ngm:inertial-measurement-unit ;
    rdfs:subClassOf ngm:robo-perception ;
    rdfs:subClassOf _:r22969 ;
    rdfs:subClassOf _:r22970 ;
    skos:broader ngm:robo-perception ;
    vc:enables ngm:localisation ;
    vc:enables ngm:odometry ;
    vc:enables ngm:state-estimation ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:accelerometer ;
    vc:hasPart ngm:gyroscope ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:rb-0066-robot-sensor ;
    vc:relatedTo ngm:rb-0072-encoder ;
    vc:relatedTo ngm:sensor-fusion ;
    vc:relatedTo ngm:slam ;
    vc:slug "rb-0073-imu" ;
    vc:sourceDomain "robotics" ;
    vc:supports ngm:autonomous-navigation .
ngm:rb-0075-range-finder a owl:Class ;
    rdfs:comment "A range finder is an exteroceptive sensor that measures the distance between a robot and surrounding objects or surfaces by emitting a signal (laser, ultrasonic, or infrared) and timing its return. Range finders are fundamental to obstacle detection, safety zone monitoring, and environment mapping in mobile and collaborative robots."@en ;
    rdfs:label "rb 0075 range finder"@en ;
    rdfs:subClassOf ngm:exteroceptive-sensor ;
    rdfs:subClassOf ngm:robo-perception ;
    skos:broader ngm:robo-perception ;
