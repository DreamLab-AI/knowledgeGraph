            owl:someValuesFrom ngm:sensor-fusion ],
        ngm:autonomous-agent ;
    vc:bridgesTo ngm:digital-twin,
        ngm:spatial-computing ;
    vc:contrastsWith ngm:teleoperation ;
    vc:dependsOn ngm:coordinate-frame,
        ngm:real-time-computing ;
    vc:enables ngm:autonomous-robot,
        ngm:autonomous-vehicle,
        ngm:unmanned-aerial-vehicle ;
