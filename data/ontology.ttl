    vc:sourceDomain "artificial-intelligence" .

ngm:ai-driven-workforce-displacement-registry a owl:Class ;
    rdfs:label "AI-Driven Workforce Displacement Registry"@en ;
    rdfs:comment "A curated record of mass layoffs in the technology sector from 2023 onwards, cataloguing headcount reductions at major firms alongside UK government estimates that AI automation may displace 10–30% of existing jobs. The tracker contextualises how AI adoption—particularly large language models and agentic AI—is accelerating workforce restructuring across white-collar roles."@en ;
    rdfs:subClassOf ngm:infra-software-engineering ;
    skos:broader ngm:infra-software-engineering ;
    vc:dependsOn ngm:generative-ai,
        ngm:large-language-models ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:relatedTo ngm:agentic-ai,
        ngm:artificial-intelligence,
        ngm:economics ;
    vc:slug "ai-driven-workforce-displacement-registry" ;
    vc:sourceDomain "infrastructure" .

ngm:ai-energy-scarcity a owl:Class ;
    rdfs:label "AI Energy Scarcity"@en ;
    rdfs:comment "Systemic infrastructure bottleneck where exponential growth in AI training and inference compute demand outstrips available energy supply and grid capacity. Drives hyperscaler investment in dedicated power generation including small modular reactors (SMRs) and nuclear recommissioning, while creating geopolitical competition for compute sovereignty."@en ;
    rdfs:subClassOf ngm:infra-computing-and-cloud ;
    skos:broader ngm:infra-computing-and-cloud ;
    vc:contrastsWith ngm:bitcoin-proof-of-work-protocol-mining ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:competition-in-ai,
        ngm:energy-and-power,
        ngm:large-language-models ;
    vc:slug "ai-energy-scarcity" ;
    vc:sourceDomain "infrastructure" .

