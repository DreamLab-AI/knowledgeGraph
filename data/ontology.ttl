        ngm:monitoring-infrastructure ;
    vc:slug "ai-monitoring" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:standardizedBy ngm:eu-ai-act,
        ngm:iso-iec-23894-2023,
        ngm:iso-iec-42001-2023,
        ngm:nist-ai-risk-management-framework ;
    vc:supports ngm:ai-audit,
        ngm:bias,
        ngm:fairness,
        ngm:risk-management .

ngm:ai-security a owl:Class ;
    rdfs:label "AI Security"@en ;
    rdfs:comment "AI Security is the field of protecting artificial intelligence systems and their components from security threats and vulnerabilities, including adversarial attacks, data poisoning, model theft, and unauthorized access to ensure systems perform as intended. It encompasses defending AI models, algorithms, training data, and infrastructure from manipulation, misuse, and exploitation throughout the AI lifecycle."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:adversarial-machine-learning ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:prompt-injection ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:red-teaming ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:access-control ],
        ngm:cybersecurity ;
    vc:bridgesTo ngm:blockchain,
        ngm:zero-trust-architecture ;
    vc:contrastsWith ngm:ai-safety ;
    vc:dependsOn ngm:machine-learning,
        ngm:threat-modeling ;
    vc:enables ngm:secure-ai-deployment,
        ngm:trustworthy-ai ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:adversarial-machine-learning,
        ngm:ai-model-monitoring,
        ngm:prompt-injection,
        ngm:red-teaming ;
    vc:implements ngm:nist-ai-risk-management-framework ;
    vc:isPartOf ngm:ai-governance-and-ethics,
        ngm:cybersecurity ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:data-poisoning,
        ngm:explainable-ai,
        ngm:model-extraction ;
    vc:requires ngm:access-control,
        ngm:adversarial-training,
        ngm:input-validation ;
    vc:slug "ai-security" ;
    vc:sourceDomain "security" ;
    vc:standardizedBy ngm:nist-cybersecurity-framework ;
    vc:supports ngm:ai-risk-management,
        ngm:responsible-ai ;
    vc:uses ngm:anomaly-detection,
        ngm:differential-privacy,
        ngm:federated-learning .

ngm:asset-pipeline a owl:Class ;
    rdfs:label "Asset Pipeline"@en ;
    rdfs:comment "An asset pipeline is an automated, staged workflow that ingests raw digital content—meshes, textures, audio, animations, and shaders—and transforms it through validation, processing, optimisation, and packaging steps into runtime-ready formats consumable by real-time engines, streaming platforms, or spatial computing environments. It enforces deterministic builds, enables version-controlled dependency graphs, and dramatically reduces manual content-preparation labour. Asset pipelines are foundational to game development, visual effects, and metaverse platform engineering, and increasingly incorporate AI-assisted level-of-detail generation, texture compression, and semantic tagging to scale content delivery across heterogeneous device targets."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:content-addressed-storage ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:version-control ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:asset-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:level-of-detail ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:render-pipeline ],
        ngm:content-pipeline ;
    vc:bridgesTo ngm:ai-content-generation,
        ngm:supply-chain-provenance ;
    vc:dependsOn ngm:continuous-integration,
        ngm:metadata-schema ;
    vc:enables ngm:digital-twin-creation,
        ngm:extended-reality,
        ngm:game-engine,
        ngm:real-time-rendering,
        ngm:streaming-content-delivery ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:asset-management,
        ngm:build-system,
        ngm:level-of-detail,
        ngm:render-pipeline,
        ngm:texture-compression ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:asset-format-standards,
        ngm:procedural-generation,
        ngm:vfx-tools ;
    vc:requires ngm:content-addressed-storage,
        ngm:dependency-graph,
        ngm:version-control ;
    vc:slug "asset-pipeline" ;
    vc:sourceDomain "spatial-computing" ;
    vc:standardizedBy ngm:khronos-group,
        ngm:pixar-usd ;
    vc:supports ngm:creator-economy,
        ngm:digital-rights-management ;
    vc:uses ngm:3-d-asset,
        ngm:3-d-file-format,
        ngm:data-compression,
        ngm:gltf,
        ngm:shader,
        ngm:universal-scene-description .

ngm:base-fee a owl:Class ;
    rdfs:label "Base Fee"@en ;
    rdfs:comment "The Base Fee is the algorithmically determined minimum fee per unit of gas that every transaction must pay to be included in an Ethereum block, introduced by EIP-1559. It adjusts automatically each block based on whether the previous block was above or below its gas target, increasing when demand is high and decreasing when low. Unlike miner tips, the base fee is burned rather than paid to validators, creating a deflationary pressure on ETH supply and making gas price prediction more reliable for users."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gas ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:mempool ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:eip-1559 ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:blockchain-transaction ],
        ngm:bc-protocol-and-consensus,
        ngm:blockchain-entity,
        ngm:economic-mechanism ;
    skos:broader ngm:bc-protocol-and-consensus ;
    vc:contrastsWith ngm:miner,
        ngm:priority-fee ;
    vc:enables ngm:burning-mechanism,
        ngm:gas-fee-market,
        ngm:mev ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:blockchain-economics,
        ngm:gas-fee-market ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:block-reward,
        ngm:blockchain-economics,
        ngm:gas-limit,
        ngm:gas-price,
        ngm:priority-fee ;
    vc:requires ngm:blockchain-transaction,
        ngm:eip-1559,
        ngm:gas,
        ngm:mempool ;
    vc:slug "base-fee" ;
    vc:sourceDomain "blockchain" .

ngm:block-propagation a owl:Class ;
    rdfs:label "Block Propagation"@en ;
    rdfs:comment "Block Propagation is the process by which a newly mined or validated block is broadcast across a blockchain peer-to-peer network so that all full nodes can update their local copy of the chain. Propagation latency directly influences the orphan/stale block rate, security against selfish mining, and the degree of centralisation pressure towards large, well-connected mining pools. Techniques such as Compact Block Relay (Bitcoin BIP 152) and Graphene reduce bandwidth requirements by sending block sketches rather than full transaction lists, exploiting the fact that recipient nodes already hold most transactions in their mempools."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:full-node ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:blockchain-network ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:block-propagation-time ],
        ngm:bc-protocol-and-consensus,
        ngm:blockchain-entity,
        ngm:consensus-protocol ;
    skos:broader ngm:bc-protocol-and-consensus ;
    vc:contrastsWith ngm:light-node ;
    vc:dependsOn ngm:blockchain-protocol ;
    vc:enables ngm:blockchain-scalability,
        ngm:consensus-mechanism ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:block-propagation-time ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:block-size,
        ngm:block-time,
        ngm:mempool,
        ngm:miner ;
    vc:requires ngm:blockchain-network,
        ngm:full-node ;
    vc:slug "block-propagation" ;
    vc:sourceDomain "blockchain" .

ngm:carbon-registry a owl:Class ;
    rdfs:label "Carbon Registry"@en ;
    rdfs:comment "A centralized database system that tracks the issuance, ownership, transfer, and retirement of carbon credits, assigning unique serial numbers to each credit for full lifecycle traceability and preventing double-counting across voluntary and compliance carbon markets."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:verification-process ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:regulatory-compliance ],
        ngm:environmental-registry ;
    vc:bridgesTo ngm:blockchain,
        ngm:smart-contract ;
    vc:contrastsWith ngm:compliance-carbon-market,
        ngm:voluntary-carbon-market ;
    vc:enables ngm:carbon-credit-retirement,
        ngm:credit-tracking,
        ngm:double-counting-prevention,
        ngm:emissions-offsetting,
        ngm:market-transparency ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:ownership-ledger,
        ngm:project-documentation,
        ngm:serial-number-issuance ;
    vc:implements ngm:gold-standard,
        ngm:vcs-standard ;
    vc:isPartOf ngm:carbon-market,
        ngm:climate-governance-infrastructure ;
    vc:qualityScore "0.65"^^xsd:float ;
    vc:relatedTo ngm:carbon-offset-project,
        ngm:greenhouse-gas-accounting,
        ngm:redd-plus ;
    vc:requires ngm:database-infrastructure,
        ngm:regulatory-compliance,
        ngm:third-party-auditing,
        ngm:unique-identifiers,
        ngm:verification-process ;
    vc:slug "carbon-registry" ;
    vc:sourceDomain "governance" ;
    vc:standardizedBy ngm:corsia,
        ngm:icvcm .

ngm:closed-loop-control a owl:Class ;
    rdfs:label "Closed-Loop Control"@en ;
    rdfs:comment "A control system that uses feedback from sensors to compare the actual output with the desired output and adjusts the control action to minimize error. The system continuously monitors and corrects its behavior."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:feedback-mechanism ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:controller ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:actuator ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:sensor-system ],
        ngm:control-system,
        ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:enables ngm:rb-1007-trajectory-generation,
        ngm:rb-1013-localization ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:adaptive-control,
        ngm:pid-control ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires ngm:actuator,
        ngm:controller,
        ngm:feedback-mechanism,
        ngm:sensor-system ;
    vc:slug "closed-loop-control" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:actuator,
        ngm:controller,
        ngm:sensor-system .

ngm:curriculum-learning a owl:Class ;
    rdfs:label "Curriculum Learning"@en ;
    rdfs:comment "A training strategy that presents examples to a model in a meaningful order, typically progressing from easy to difficult, mimicking how humans learn. Curriculum learning improves convergence speed, final performance, and generalisation by structuring the learning progression rather than relying on random example ordering."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:training-data ],
        ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:bridgesTo ngm:natural-language-processing,
        ngm:reinforcement-learning,
        ngm:robotics ;
    vc:contrastsWith ngm:anti-curriculum,
        ngm:random-sampling ;
    vc:dependsOn ngm:optimisation-algorithm,
        ngm:supervised-learning ;
    vc:enables ngm:computer-vision,
        ngm:faster-convergence,
        ngm:model-performance,
        ngm:sample-efficiency ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:automatic-curriculum,
        ngm:self-paced-learning,
        ngm:teacher-student-curriculum ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:active-learning,
        ngm:continual-learning,
        ngm:contrastive-learning,
        ngm:machine-learning-discipline,
        ngm:meta-learning,
        ngm:training-strategy,
        ngm:transfer-learning ;
    vc:requires ngm:difficulty-assessment,
        ngm:training-data ;
    vc:slug "curriculum-learning" ;
    vc:sourceDomain "machine-learning" ;
    vc:uses ngm:data-ordering,
        ngm:deep-learning,
        ngm:difficulty-measure .

ngm:custody a owl:Class ;
    rdfs:label "Custody"@en ;
    rdfs:comment "The holding and safekeeping of assets and the keys that control them, defining who has the authority to move funds on behalf of an owner."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:wallet ],
