        ngm:hydraulic-motor ;
    vc:slug "hydraulic-cylinder" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:pid-control,
        ngm:position-control .

ngm:identity a owl:Class ;
    rdfs:label "Identity"@en ;
    rdfs:comment "The set of attributes, credentials, and verifiable claims that uniquely identify a principal — person, organisation, or device — within a digital system, enabling authentication, authorisation, and accountability. In metaverse and Web3 contexts, identity may be self-sovereign, portable across platforms, and anchored to decentralised identifiers."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:authentication ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptography ],
        ngm:infra-security-and-identity ;
    skos:broader ngm:infra-security-and-identity ;
    vc:enables ngm:access-control ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:relatedTo ngm:decentralised-identity,
        ngm:identity-management,
        ngm:self-sovereign-identity ;
    vc:requires ngm:authentication,
        ngm:cryptography ;
    vc:slug "identity" ;
    vc:sourceDomain "infrastructure" .

ngm:iec-61131-3 a owl:Class ;
    rdfs:label "IEC 61131-3"@en ;
    rdfs:comment "IEC 61131-3 is the third part of the IEC 61131 international standard for programmable logic controllers, defining the syntax and semantics of five programming languages used in industrial automation: Ladder Diagram (LD), Function Block Diagram (FBD), Structured Text (ST), Instruction List (IL), and Sequential Function Chart (SFC). The standard provides a common programming model across PLC vendors, enabling portability of control logic and reducing the effort required to maintain industrial systems. It is the primary reference for software engineering practice in the industrial automation domain and forms the basis of IEC 61131-3-compliant toolchains and runtime environments used in manufacturing, process control, and infrastructure systems."@en ;
    rdfs:subClassOf ngm:iso-iec ;
    vc:enables ngm:automated-compliance,
        ngm:planning-and-scheduling ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:iec-61508,
        ngm:industrial-automation,
        ngm:safety-plc ;
    vc:slug "iec-61131-3" ;
    vc:sourceDomain "infrastructure" ;
    vc:standardizedBy ngm:iso-iec-27001 ;
    vc:supports ngm:industrial-robot,
        ngm:sheffield-advanced-manufacturing .

ngm:image-processing-software a owl:Class ;
    rdfs:label "Image Processing Software"@en ;
    rdfs:comment "Software systems that acquire, process, analyse, and visualise digital images for metaverse applications, employing computer vision algorithms for user tracking, environment creation, gesture recognition, 3D reconstruction, and real-time visual enhancement in virtual and augmented reality environ..."@en ;
    rdfs:subClassOf ngm:computer-vision-system,
        ngm:sc-display-and-rendering ;
    skos:broader ngm:sc-display-and-rendering ;
    vc:enables ngm:visual-metaverse-interaction ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:slug "image-processing-software" ;
    vc:sourceDomain "spatial-computing" .

ngm:image-to-image-translation a owl:Class ;
    rdfs:label "Image to Image Translation"@en ;
    rdfs:comment "Image-to-Image Translation transforms images from one visual domain to another whilst preserving content structure, converting between image modalities such as sketch-to-photo, day-to-night, satellite-to-map, or style transfer between artistic styles."@en ;
    rdfs:subClassOf ngm:sc-display-and-rendering ;
    skos:broader ngm:sc-display-and-rendering ;
    vc:dependsOn ngm:computer-vision,
