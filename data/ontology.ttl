ngm:atomic-settlement a owl:Class ;
    rdfs:label "Atomic Settlement"@en ;
    rdfs:comment "Atomic settlement is a transaction completion mechanism in which the transfer of assets between two or more parties either executes in its entirety or not at all, eliminating counterparty risk and the possibility of partial fulfilment. The mechanism is enforced at the protocol level, ensuring that delivery and payment occur simultaneously and indivisibly within a single transaction or smart contract execution. This property derives from atomicity — one of the four ACID properties of database transactions — applied to financial and digital asset exchanges. Atomic settlement is the foundational guarantee underpinning trustless exchange protocols, cross-chain bridges, real-time gross settlement systems, and delivery-versus-payment architectures in both decentralised and regulated financial markets."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:transaction-finality ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:smart-contract ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptographic-commitment ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:hash-time-locked-contract ],
        ngm:transaction ;
    vc:bridgesTo ngm:distributed-transaction,
        ngm:two-phase-commit ;
    vc:contrastsWith ngm:deferred-net-settlement ;
    vc:dependsOn ngm:blockchain,
        ngm:consensus-mechanism,
        ngm:finality ;
    vc:enables ngm:cross-chain-interoperability,
        ngm:decentralized-exchange,
        ngm:securities-settlement,
        ngm:settlement,
        ngm:trustless-settlement ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:acid-properties,
        ngm:delivery-versus-payment ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:atomic-swap,
        ngm:payment-channel,
        ngm:real-time-gross-settlement ;
    vc:requires ngm:cryptographic-commitment,
        ngm:hash-time-locked-contract,
        ngm:smart-contract,
        ngm:transaction-finality ;
    vc:slug "atomic-settlement" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:central-bank-digital-currency-cbdc,
        ngm:de-fi,
        ngm:tokenised-securities ;
    vc:uses ngm:digital-signature,
        ngm:escrow-system,
        ngm:hash-time-locked-contract,
        ngm:smart-contract .

ngm:authentication-standards a owl:Class ;
    rdfs:label "Authentication Standards"@en ;
    rdfs:comment "Authentication Standards encompass protocols and specifications for verifying user identity in digital systems, particularly FIDO2 and WebAuthn standards that enable passwordless, phishing-resistant authentication using public key cryptography and hardware authenticators for secure access to metaverse platforms and blockchain applications."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:public-key-cryptography ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:web-authn ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:fido2 ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:digital-certificate ],
        ngm:security-standards ;
    vc:bridgesTo ngm:access-control,
        ngm:blockchain-identity,
        ngm:did-nostr-identity ;
    vc:contrastsWith ngm:password-authentication ;
    vc:dependsOn ngm:asymmetric-cryptography ;
    vc:enables ngm:multi-factor-authentication,
        ngm:passwordless-authentication,
        ngm:phishing-resistance ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:fido2,
