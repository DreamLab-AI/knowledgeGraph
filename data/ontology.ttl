        ngm:training-data ;
    vc:slug "training-methods" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:transaction-fees a owl:Class ;
    rdfs:label "transaction fees"@en ;
    rdfs:comment "Transaction fees are amounts paid by users to have their transactions included in a blockchain block. They compensate miners or validators and help prioritise transactions when capacity is limited."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:bitcoin-proof-of-work-protocol-network ],
