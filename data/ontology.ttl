ngm:platform-as-a-service a owl:Class ;
    rdfs:comment "Platform as a Service (PaaS) is a cloud computing service model that provides a managed execution environment — including runtime, middleware, databases, and development tools — over the internet, allowing developers to build, deploy, and scale applications without managing underlying infrastructure. PaaS abstracts operating system and server management from the development team, enabling faster iteration cycles and lower operational overhead. Examples include Heroku, Google App Engine, Microsoft Azure App Service, and AWS Elastic Beanstalk."@en ;
    rdfs:label "Platform As A Service"@en ;
    rdfs:subClassOf ngm:cloud-computing ;
