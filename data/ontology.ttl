ngm:storage-engine a owl:Class ;
    rdfs:comment "A storage engine is the component of a database system responsible for how data is physically laid out, written, indexed and retrieved on durable media. It implements the on-disk data structures, transaction and concurrency control, write-ahead logging and recovery that guarantee durability and consistency. Different engines, such as B-tree and log-structured merge-tree designs, optimise for different read, write and space trade-offs."@en ;
    rdfs:label "Storage Engine"@en ;
    rdfs:subClassOf ngm:data-persistence ;
