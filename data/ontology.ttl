ngm:content-delivery a owl:Class ;
    rdfs:comment "Content delivery is the distribution of digital media such as web pages, video and software to end users, typically optimised for speed and reliability. It is commonly accelerated by content delivery networks."@en ;
    rdfs:label "Content Delivery"@en ;
