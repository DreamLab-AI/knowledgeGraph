    vc:sourceDomain "infrastructure" .

ngm:nist-ai-standards a owl:Class ;
    rdfs:label "NIST AI Standards"@en ;
    rdfs:comment "A general reference to NIST work and publications relating to artificial intelligence standards and guidance. No single specific standard is identified by this label alone."@en ;
