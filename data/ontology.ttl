    vc:requires ngm:cryptography,
        ngm:public-key-infrastructure ;
    vc:slug "authentication-service" ;
    vc:sourceDomain "security" ;
    vc:supports ngm:adaptive-authentication,
        ngm:passwordless-authentication ;
    vc:uses ngm:json-data-interchange-format-web-token,
        ngm:lightweight-directory-access-protocol,
        ngm:saml .

ngm:batch-normalisation a owl:Class ;
    rdfs:label "Batch Normalisation"@en ;
    rdfs:comment "A technique that normalises layer inputs within a mini-batch to zero mean and unit variance, stabilising training dynamics, enabling higher learning rates, and acting as a form of regularisation in deep neural networks. Introduced by Ioffe and Szegedy (2015), it reduces internal covariate shift and has become a standard component in convolutional and other deep learning architectures."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:parameter ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:mini-batch ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:stochastic-gradient-descent ],
        ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:bridgesTo ngm:model-deployment,
        ngm:transfer-learning ;
    vc:contrastsWith ngm:group-normalisation,
        ngm:instance-normalisation,
        ngm:layer-normalisation,
        ngm:weight-normalisation ;
    vc:dependsOn ngm:backpropagation,
        ngm:neural-network-layer ;
    vc:enables ngm:deep-learning ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:parameter ;
    vc:isPartOf ngm:convolutional-neural-network,
        ngm:deep-neural-network ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:dropout,
        ngm:gradient-descent,
        ngm:optimisation,
        ngm:regularisation,
        ngm:technique ;
    vc:requires ngm:mini-batch,
        ngm:stochastic-gradient-descent ;
    vc:slug "batch-normalisation" ;
    vc:sourceDomain "machine-learning" ;
    vc:uses ngm:neural-network,
        ngm:statistics .

ngm:carbon-credit-tracking a owl:Class ;
    rdfs:label "Carbon Credit Tracking"@en ;
    rdfs:comment "Carbon Credit Tracking is the application of Blockchain and distributed ledger technology to record, verify, transfer, and permanently retire carbon emission reduction credits across their full lifecycle — from project origination through third-party verification to final environmental claim ..."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:carbon-standard-certification ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:smart-contracts ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:kyc-aml-compliance ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
