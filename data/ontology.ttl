    vc:uses ngm:generative-ai .

ngm:lattice-cryptography a owl:Class ;
    rdfs:label "Lattice Cryptography"@en ;
    rdfs:comment "A family of cryptographic constructions whose security rests on the hardness of computational problems over high-dimensional lattices, such as learning with errors. These problems are believed to resist attacks by quantum computers."@en ;
