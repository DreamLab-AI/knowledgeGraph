    vc:sourceDomain "blockchain" ;
    vc:uses ngm:asset-tokenisation,
        ngm:erc1400-standard,
        ngm:smart-contract .

ngm:self-consistency a owl:Class ;
    rdfs:label "Self-Consistency"@en ;
    rdfs:comment "Self-consistency is a prompting strategy for large language models in which multiple independent reasoning chains are sampled stochastically for a given problem and the final answer is determined by majority vote across those chains. The technique exploits the observation that correct reasoning paths, although varied in surface form, tend to converge on the same answer, whilst incorrect paths are more diverse. Self-consistency substantially improves performance on mathematical reasoning and multi-step logic tasks compared to greedy decoding, and it is commonly combined with chain-of-thought prompting."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:large-language-models ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:chain-of-thought ],
        ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:enables ngm:reasoning,
        ngm:reliability ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:prompt-engineering ;
    vc:requires ngm:chain-of-thought,
        ngm:large-language-models ;
    vc:slug "self-consistency" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:sensor-system a owl:Class ;
    rdfs:label "Sensor System"@en ;
    rdfs:comment "A sensor system is an integrated assembly of physical transducers, signal conditioning hardware, analogue-to-digital conversion, and data management software that captures physical-world phenomena and transforms them into structured digital representations suitable for processing, analysis, or control. Sensor systems range from single-chip inertial measurement units to multi-modal perception arrays combining cameras, LiDAR, RADAR, and acoustic sensors. Calibration, synchronisation, and fusion across heterogeneous modalities are core engineering concerns. Sensor systems are foundational to robotics, autonomous vehicles, industrial IoT, and environmental monitoring."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:signal-processing ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:sensor-data ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:calibration ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:analog-to-digital-converter ],
        ngm:hardware-component ;
    vc:enables ngm:autonomous-navigation,
        ngm:perception-system,
        ngm:real-time-processing ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:analog-to-digital-converter,
        ngm:calibration,
        ngm:sensor-data,
        ngm:signal-processing ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:autonomous-vehicle,
        ngm:edge-computing,
