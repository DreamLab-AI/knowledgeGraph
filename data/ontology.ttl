    vc:enables ngm:randomised-consensus ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:isPartOf ngm:computability-theory ;
    vc:isPartOf ngm:distributed-systems-theory ;
    vc:qualityScore "0.74"^^xsd:float ;
