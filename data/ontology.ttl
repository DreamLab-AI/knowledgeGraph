ngm:data-management-system a owl:Class ;
    rdfs:comment "A data management system is software that stores, organises, secures and provides controlled access to data throughout its lifecycle. It encompasses capabilities for ingestion, modelling, querying, integrity enforcement and governance, with database management systems and graph databases as common specialisations. It is the foundational platform on which metadata standards and downstream applications depend."@en ;
    rdfs:label "Data Management System"@en ;
    rdfs:subClassOf ngm:data-management ;
