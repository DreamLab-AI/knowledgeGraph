ngm:planetary-exploration a owl:Class ;
    rdfs:label "Planetary Exploration"@en ;
    rdfs:comment "Planetary exploration is the robotic investigation of planets, moons, and other bodies using rovers, landers, and orbiters operating in remote, unstructured, communication-delayed environments. It demands highly autonomous navigation and perception because round-trip signal delays make teleoperation impractical, requiring robots to plan paths and avoid hazards on their own. It is a demanding proving ground for autonomous ground-robot capability."@en ;
    rdfs:subClassOf ngm:robo-navigation-and-planning ;
    skos:broader ngm:robo-navigation-and-planning ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:ground-robot,
        ngm:navigation ;
    vc:slug "planetary-exploration" ;
    vc:sourceDomain "robotics" .

ngm:planetary-gearbox a owl:Class ;
    rdfs:label "Planetary Gearbox"@en ;
    rdfs:comment "A planetary gearbox is a gear-reduction mechanism in which several planet gears revolve around a central sun gear inside an outer ring gear. This epicyclic arrangement distributes load across multiple gear meshes, yielding high torque density, coaxial input and output, and compact reduction ratios. It is a core mechanical component in robotic joints and actuators where space and weight are constrained."@en ;
    rdfs:subClassOf ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:mechanical-component ;
    vc:slug "planetary-gearbox" ;
    vc:sourceDomain "robotics" .

ngm:platform-as-a-service a skos:Concept ;
    rdfs:label "Platform As A Service"@en .

ngm:player-agency a owl:Class ;
    rdfs:label "Player Agency"@en ;
    rdfs:comment "Player agency is the degree to which a participant's choices meaningfully shape the state, narrative, and outcomes of an interactive virtual experience. High agency means decisions have consequential, non-trivial effects rather than cosmetic ones, giving players authorship over their path through the world. It is a core design value of open-world and non-linear interactive systems."@en ;
    rdfs:subClassOf ngm:sc-interaction ;
    skos:broader ngm:sc-interaction ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:non-linear-narrative,
        ngm:open-world ;
    vc:slug "player-agency" ;
    vc:sourceDomain "metaverse" .

ngm:player-engagement a owl:Class ;
    rdfs:label "Player Engagement"@en ;
    rdfs:comment "Player engagement is the degree to which a game holds a player's attention, motivation, and continued participation over time. It is measured through behavioural signals such as session length, retention, progression, and emotional investment. Game designers and AI systems optimise engagement to sustain player communities and, in token-based games, to drive economic activity."@en ;
    rdfs:subClassOf ngm:metaverse ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:ai-game-agent,
        ngm:play-to-earn-p2-e ;
    vc:slug "player-engagement" ;
    vc:sourceDomain "metaverse" .

ngm:player-modelling a owl:Class ;
    rdfs:label "Player Modelling"@en ;
    rdfs:comment "Player modelling is the computational construction of representations of a player's preferences, skill, behaviour, and emotional state from in-game data. These models enable games to personalise difficulty, content, and recommendations, and to predict future actions. It is a foundational technique for adaptive and AI-driven game systems."@en ;
    rdfs:subClassOf ngm:ai-application ;
    skos:broader ngm:ai-application ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:ai-in-games ;
    vc:slug "player-modelling" ;
    vc:sourceDomain "ai" .

