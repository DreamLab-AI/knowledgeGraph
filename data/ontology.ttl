ngm:bfloat16 a owl:Class ;
    rdfs:comment "Bfloat16 (brain floating point) is a 16-bit floating-point format that keeps the same 8-bit exponent as 32-bit IEEE float but truncates the mantissa to 7 bits. It preserves the dynamic range of single precision while halving memory and bandwidth, making it well suited to deep-learning training and inference. Because it trades precision for range, it avoids the overflow and underflow problems that affect narrower formats during gradient computation."@en ;
    rdfs:label "Bfloat16"@en ;
    rdfs:subClassOf ngm:mixed-precision-training ;
    rdfs:subClassOf ngm:model-compression ;
