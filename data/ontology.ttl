    vc:uses ngm:smart-contract ;
    vc:uses ngm:wrapped-token .
ngm:lock-and-mint-mechanism a owl:Class ;
    rdfs:comment "Cross-chain asset transfer protocol where tokens are locked in a smart contract on the source chain and equivalent wrapped tokens are minted on the destination chain, maintaining a 1:1 backing ratio."@en ;
    rdfs:label "Lock and Mint Mechanism"@en ;
