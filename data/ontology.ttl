        ngm:large-language-models,
        ngm:programmatic-advertising,
        ngm:recommendation-systems,
        ngm:social-media-algorithms .

ngm:decentralised-application a owl:Class ;
    rdfs:label "Decentralised Application"@en ;
    rdfs:comment "A decentralised application (dApp) is software whose backend logic runs on a decentralised peer-to-peer network, typically as smart contracts on a blockchain, rather than on centrally controlled servers. It combines on-chain contracts for trustless state and logic with off-chain front ends and storage. dApps are a defining component of Web3, enabling permissionless, censorship-resistant services such as exchanges, lending and marketplaces."@en ;
    rdfs:subClassOf ngm:smart-contract ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:web3 ;
    vc:slug "decentralised-application" ;
    vc:sourceDomain "blockchain" .

ngm:deep-dao a owl:Class ;
    rdfs:label "DeepDAO"@en ;
    rdfs:comment "DeepDAO is a leading analytics and data aggregation platform dedicated to tracking and measuring the organisational health, financial activity, governance participation, and membership dynamics of decentralised autonomous organisations across multiple blockchain networks. It provides standardised metrics — total assets under management, number of token holders, proposal counts, voter participation rates, and delegate rankings — that enable comparative analysis of DAO ecosystems and inform investment, research, and governance design decisions."@en ;
    rdfs:subClassOf ngm:dao-analytics ;
    vc:enables ngm:dao-governance,
        ngm:decentralized-governance,
        ngm:decision-transparency ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:dao,
        ngm:dao-tooling ;
    vc:slug "deep-dao" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:blockchain-analytics,
        ngm:governance-token,
        ngm:on-chain-governance .

ngm:deep-learning-framework a owl:Class ;
    rdfs:label "Deep Learning Framework"@en ;
    rdfs:comment "A software library that provides the building blocks for defining, training and deploying deep neural networks, including tensor operations, automatic differentiation and hardware acceleration."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:hardware-acceleration ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:automatic-differentiation ],
        ngm:deep-learning-domain ;
    vc:enables ngm:backpropagation ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:automatic-differentiation,
        ngm:hardware-acceleration ;
    vc:slug "deep-learning-framework" ;
    vc:sourceDomain "deep-learning" .

ngm:deepfake-detection a owl:Class ;
    rdfs:label "Deepfake Detection"@en ;
    rdfs:comment "Deepfake detection is the application of machine learning and signal processing techniques to identify synthetic or manipulated media—including face-swapped video, voice-cloned audio, and AI-generated images—by analysing artefacts, inconsistencies, and statistical signatures that distinguish fabricated from authentic content. It operates as a countermeasure to generative adversarial networks and related synthesis methods."@en ;
    rdfs:subClassOf ngm:computer-vision ;
    vc:contrastsWith ngm:deepfakes ;
    vc:enables ngm:content-authentication,
        ngm:content-authenticity ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:generative-ai ;
    vc:slug "deepfake-detection" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:machine-learning,
        ngm:neural-network .

ngm:delegation-registry a owl:Class ;
    rdfs:label "Delegation Registry"@en ;
    rdfs:comment "A delegation registry is an on-chain contract that records mappings from a token holder's address to a delegate authorised to act or vote on their behalf. In DAO governance it lets holders assign their voting power to a representative without transferring assets, and the registry serves as the canonical source consulted when tallying votes. It enables liquid democracy patterns and separation of custody from voting authority."@en ;
    rdfs:subClassOf ngm:smart-contract ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:on-chain-voting,
        ngm:snapshot-voting ;
    vc:slug "delegation-registry" ;
    vc:sourceDomain "blockchain" .

ngm:delegation-system a owl:Class ;
    rdfs:label "Delegation System"@en ;
    rdfs:comment "A delegation system is the governance mechanism by which stakeholders entrust their decision-making or voting power to chosen representatives. In decentralized governance it supports liquid democracy, where delegated authority can be reassigned or revoked at any time, scaling participation without requiring every holder to vote directly. It balances broad legitimacy with the expertise and availability of active delegates."@en ;
    rdfs:subClassOf ngm:governance-framework ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:decentralized-governance,
        ngm:tokenomics-governance ;
    vc:slug "delegation-system" ;
    vc:sourceDomain "governance" .

ngm:democratic-participation a owl:Class ;
    rdfs:label "Democratic Participation"@en ;
    rdfs:comment "The mechanisms and systems enabling citizens to engage in collective decision-making processes within virtual environments, digital governance platforms, and metaverse communities, encompassing voting, deliberation, and civic engagement through immersive technologies and decentralized governance ..."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:governance-framework ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:voting-systems ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:identity-verification ],
        ngm:digital-governance,
        ngm:sc-governance-and-safety ;
    skos:broader ngm:sc-governance-and-safety ;
    vc:enables ngm:civic-engagement,
        ngm:community-decision-making,
        ngm:virtual-voting ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires ngm:governance-framework,
        ngm:identity-verification,
        ngm:voting-systems ;
    vc:slug "democratic-participation" ;
    vc:sourceDomain "spatial-computing" .

ngm:design-systems a owl:Class ;
    rdfs:label "Design Systems"@en ;
    rdfs:comment "A design system is a single source of truth that combines reusable UI components, design tokens, patterns, and documentation governing how a product looks and behaves. It unifies designers and engineers around a shared component library and usage guidelines, ensuring consistency and accelerating delivery across teams and platforms. It encompasses both the visual language and the coded implementation that enforces it."@en ;
    rdfs:subClassOf ngm:software-development ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:human-computer-interaction,
        ngm:product-design ;
    vc:slug "design-systems" ;
    vc:sourceDomain "infrastructure" .

ngm:destination-chain-execution a owl:Class ;
    rdfs:label "Destination Chain Execution"@en ;
    rdfs:comment "Destination chain execution is the phase of a cross-chain operation in which a message or transaction validated from a source chain is finally executed on the target blockchain. After relayers and verification prove the source event, the destination chain mints, releases, or calls a contract to complete the bridged action. Correct execution requires replay protection, message ordering guarantees, and trust in the verification layer."@en ;
    rdfs:subClassOf ngm:cross-chain-bridge ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:blockchain-interoperability,
        ngm:cross-chain-bridge ;
    vc:slug "destination-chain-execution" ;
    vc:sourceDomain "blockchain" .

ngm:dev-sec-ops a owl:Class ;
    rdfs:label "DevSecOps"@en ;
    rdfs:comment "DevSecOps is a software engineering practice that integrates security controls, testing, and policy enforcement directly into the continuous integration and delivery pipeline, making security a shared responsibility across development, operations, and security teams. It applies the principle of shift-left security, automating vulnerability scanning, dependency auditing, and policy-as-code checks at every stage from code commit through production deployment."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:vulnerability-scanner ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ci-cd-automation ],
        ngm:agile-software-development ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:continuous-integration,
        ngm:vulnerability-management ;
    vc:requires ngm:ci-cd-automation,
        ngm:vulnerability-scanner ;
    vc:slug "dev-sec-ops" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:penetration-testing,
        ngm:security-testing .

ngm:device-drivers a owl:Class ;
    rdfs:label "Device Drivers"@en ;
    rdfs:comment "A device driver is a software component that mediates between an operating system and a specific hardware device, translating generic OS calls into the device's command and register protocol. Drivers expose a uniform interface so applications can use peripherals without knowing their internal details, and they handle interrupts, buffering, and power state. They are the foundation of the hardware abstraction layer that makes hardware portable to software."@en ;
    rdfs:subClassOf ngm:infra-software-engineering ;
    skos:broader ngm:infra-software-engineering ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:hardware-abstraction-layer-hal,
        ngm:human-interface-device ;
    vc:slug "device-drivers" ;
    vc:sourceDomain "infrastructure" .

ngm:di-lo-co a owl:Class ;
    rdfs:label "DiLoCo"@en ;
    rdfs:comment "DiLoCo (Distributed Low-Communication training) is a method for training large language models across loosely connected, geographically distributed compute clusters with minimal inter-node communication. Workers perform many local optimisation steps before periodically synchronising via an outer optimiser, drastically reducing the bandwidth and latency demands of conventional data-parallel training. It enables collaborative model training over the public internet rather than within a single tightly coupled datacentre."@en ;
    rdfs:subClassOf ngm:distributed-computing ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:distributed-ai-training,
        ngm:prime-intellect ;
    vc:slug "di-lo-co" ;
    vc:sourceDomain "ai" .

ngm:did-resolver a owl:Class ;
    rdfs:label "DID Resolver"@en ;
    rdfs:comment "A DID resolver is a component that takes a Decentralized Identifier (DID) and returns its associated DID document containing public keys, verification methods, and service endpoints. It implements the W3C DID Resolution specification, dispatching to method-specific drivers (e.g. did:web, did:ion, did:key) to locate and verify the document. Resolvers are the lookup layer that makes DIDs actionable for authentication and credential exchange."@en ;
    rdfs:subClassOf ngm:digital-identity ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:decentralized-identifiers,
        ngm:decentralized-identity-did ;
    vc:slug "did-resolver" ;
    vc:sourceDomain "security" .

ngm:differential-dynamic-programming a owl:Class ;
    rdfs:label "Differential Dynamic Programming"@en ;
    rdfs:comment "Differential Dynamic Programming (DDP) is a trajectory-optimisation algorithm that solves optimal-control problems by iteratively improving a control sequence using second-order local approximations of the dynamics and cost along the current trajectory. It performs a backward pass computing value-function derivatives and feedback gains, followed by a forward pass that applies the improved controls, converging quadratically near a solution. Together with its Gauss-Newton variant iLQR, DDP is widely used in robotics and model-predictive control for generating smooth, dynamically feasible motions."@en ;
    rdfs:subClassOf ngm:optimal-control ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:markov-decision-process ;
    vc:slug "differential-dynamic-programming" ;
    vc:sourceDomain "robotics" ;
    vc:supports ngm:model-predictive-control ;
    vc:uses ngm:control-theory .

ngm:digital-commerce a owl:Class ;
    rdfs:label "Digital Commerce"@en ;
    rdfs:comment "Digital Commerce encompasses the exchange of goods, services, and digital assets through internet-connected and virtual platforms, including metaverse storefronts, NFT marketplaces, and cryptocurrency-denominated payment rails. It extends conventional e-commerce by incorporating programmable smart contracts for trustless settlement, tokenised ownership of virtual goods, and AI-mediated personalisation. In metaverse contexts, digital commerce enables low-friction cross-border value transfer without leaving the virtual environment."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:digital-identity ],
        ngm:digital-asset-ecosystem,
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:enables ngm:cross-metaverse-commerce,
        ngm:digital-asset-management ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:requires ngm:digital-identity ;
    vc:slug "digital-commerce" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:metaverse ;
    vc:uses ngm:blockchain,
        ngm:smart-contract .

ngm:digital-fabrication a owl:Class ;
    rdfs:label "Digital Fabrication"@en ;
    rdfs:comment "Digital Fabrication, in the AI context, integrates artificial intelligence with additive manufacturing, CNC machining, and robotic production technologies to optimise fabrication processes. AI enables generative design for novel geometries, predictive maintenance via sensor analytics, real-time quality control through computer vision, and adaptive toolpath planning using reinforcement learning. Machine learning models predict material behaviour, detect defects, and enable mass customisation through digital twin simulation before physical production."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:digital-twin ],
        ngm:ai-application ;
    skos:broader ngm:ai-application ;
    vc:enables ngm:autonomous-robot,
        ngm:robotics ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:requires ngm:digital-twin ;
    vc:slug "digital-fabrication" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:digital-asset-management ;
    vc:uses ngm:computer-vision,
        ngm:reinforcement-learning .

