ngm:message-queue a owl:Class ;
    rdfs:label "Message Queue"@en ;
    rdfs:comment "A Message Queue is a durable, ordered buffer that mediates asynchronous inter-process communication, allowing producers to enqueue messages independently of consumers reading them, thereby decoupling components in both time and topology. Messages are persisted by a broker until a consumer retrieves and acknowledges them, with delivery semantics ranging from at-most-once through at-least-once to exactly-once, each trading throughput for reliability. Message queues are foundational to event-driven architectures, microservices integration, and distributed data pipelines, absorbing traffic spikes, enabling backpressure management, and improving system resilience against partial failures. Implementations range from lightweight in-process task queues to enterprise-grade distributed log brokers such as Apache Kafka, RabbitMQ, and Amazon SQS."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:message-broker ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:message-broker ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:persistence-layer ],
        ngm:distributed-systems ;
    vc:bridgesTo ngm:agent-event-stream,
        ngm:stream-processing ;
    vc:contrastsWith ngm:remote-procedure-call,
        ngm:synchronous-communication ;
    vc:dependsOn ngm:distributed-systems,
        ngm:network-protocol ;
    vc:enables ngm:data-pipeline,
        ngm:event-driven-architecture,
        ngm:microservices-architecture ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:consumer-group,
        ngm:message-broker ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:apache-kafka,
        ngm:cloud-computing,
        ngm:data-integration,
        ngm:event-sourcing,
        ngm:rabbitmq ;
    vc:requires ngm:message-broker,
        ngm:persistence-layer ;
    vc:slug "message-queue" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:fault-tolerance,
        ngm:horizontal-scalability ;
    vc:uses ngm:asynchronous-communication,
        ngm:publish-subscribe-pattern,
        ngm:serialisation .

ngm:multi-agent-system a owl:Class ;
    rdfs:label "Multi-Agent System"@en ;
    rdfs:comment "A Multi-Agent System (MAS) is a computational architecture in which multiple autonomous agents — each equipped with local perception, internal state, and independent decision-making capability — interact within a shared environment to accomplish individual or collective objectives. Coordination emerges from direct communication, environmental signalling, stigmergy, or market-like auction mechanisms, without requiring any single agent to hold global knowledge or exert centralised control. MAS formalises distributed problem-solving by composing heterogeneous or homogeneous agent populations whose aggregate behaviour frequently exhibits emergence — properties absent in any individual agent. The paradigm spans robotics swarms, AI orchestration pipelines, financial market simulation, smart-grid balancing, and autonomous software engineering."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:inter-agent-communication ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:agent-communication-language ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:autonomous-agent ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ontology ],
