        <urn:visionflow:linked:regulation-crowdfunding>,
        <urn:visionflow:linked:regulation-d>,
        <urn:visionflow:linked:regulation-s> ;
    vc:maturity "production-ready" ;
    vc:qualityScore "0.52"^^xsd:float ;
