ngm:browser-based-screen-capture a owl:Class ;
    rdfs:label "Browser-Based Screen Capture"@en ;
    rdfs:comment "Browser-based screen capture is the in-browser acquisition of screen, window, or tab video using web APIs such as the Screen Capture API (getDisplayMedia), without installing native software. The captured MediaStream can be recorded locally, encoded, or streamed in real time over WebRTC, making it the foundation for web conferencing, asynchronous video messaging, and screen recording tools. It runs under explicit user permission and within the browser's security sandbox."@en ;
    rdfs:subClassOf ngm:dc-telepresence ;
    skos:broader ngm:dc-telepresence ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:asynchronous-video,
        ngm:screen-recording ;
    vc:slug "browser-based-screen-capture" ;
    vc:sourceDomain "infrastructure" .

ngm:bsi-germany a owl:Class ;
    rdfs:label "BSI Germany"@en ;
    rdfs:comment "The Bundesamt für Sicherheit in der Informationstechnik (BSI), or Federal Office for Information Security, is Germany's national authority for cybersecurity, responsible for protecting digital infrastructure, certifying IT products, and developing security standards. It functions as a central advisory, regulatory, and technical body for both public administration and the private sector across Germany and the European Union."@en ;
    rdfs:subClassOf ngm:standards-body ;
    vc:enables ngm:regulatory-compliance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
