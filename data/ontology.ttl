    vc:slug "barter-system" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:basel-committee a owl:Class ;
    rdfs:label "Basel Committee"@en ;
    rdfs:comment "The Basel Committee on Banking Supervision (BCBS) is an international standard-setting body hosted by the Bank for International Settlements (BIS) in Basel, Switzerland, that develops global regulatory standards for the prudential supervision of banks. Its accords — Basel I (1988), Basel II (2004), and Basel III (2010, finalised 2017) — set internationally agreed minimum capital adequacy, liquidity, and leverage requirements for commercial banks."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:basel-iii ],
        ngm:financial-regulation ;
    vc:bridgesTo ngm:ai-model-risk,
        ngm:cryptoasset-regulation,
        ngm:operational-resilience ;
    vc:enables ngm:cross-border-banking-cooperation,
        ngm:prudential-banking-supervision ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:basel-i,
        ngm:basel-ii,
        ngm:basel-iii,
        ngm:capital-adequacy-framework ;
    vc:implements ngm:leverage-ratio,
        ngm:minimum-capital-requirements ;
    vc:isPartOf ngm:international-financial-architecture ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:bank-supervision,
        ngm:central-bank,
        ngm:compliance-framework,
        ngm:financial-stability-board,
        ngm:imf,
        ngm:risk-management-framework,
        ngm:systemic-risk ;
