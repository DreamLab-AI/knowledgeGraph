ngm:power-supply a owl:Class ;
    rdfs:comment "A power supply unit (PSU) is an internal hardware component that converts alternating current (AC) from mains electricity into regulated low-voltage direct current (DC) required by computing equipment's internal components including motherboard, CPU, GPU, and storage devices. In data centre contexts, power supply systems include redundant PSUs, uninterruptible power supplies (UPS), and power distribution units (PDUs) organised in hierarchical redundancy tiers."@en ;
    rdfs:label "Power Supply"@en ;
    rdfs:subClassOf ngm:hardware-component ;
    rdfs:subClassOf _:r16682 ;
