ngm:hardware-platform-agnostic a owl:Class ;
    rdfs:label "Hardware Platform Agnostic"@en ;
    rdfs:comment "A design principle and architectural quality ensuring that software, systems, or protocols can operate independently of specific hardware architectures or platform implementations. Hardware-agnostic systems achieve portability through abstraction layers—such as virtual machines, containers, or cross-platform runtimes—that decouple application logic from underlying physical or operating-system constraints."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:interoperability-standard ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:open-standard ],
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:contrastsWith ngm:xr-hardware ;
    vc:enables ngm:interoperability,
        ngm:xr-framework ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:requires ngm:interoperability-standard,
        ngm:open-standard ;
    vc:slug "hardware-platform-agnostic" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:extended-reality,
        ngm:metaverse-architecture .

