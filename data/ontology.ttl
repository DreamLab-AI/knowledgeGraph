    vc:slug "virtual-experience" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:extended-reality,
        ngm:immersive-experience .

ngm:virtual-production-pipeline a owl:Class ;
    rdfs:label "Virtual Production Pipeline"@en ;
    rdfs:comment "The end-to-end workflow for creating film and television content using real-time rendering, LED volumes, motion capture, and game engine technology, integrating pre-visualization, on-set virtual environments, and in-camera visual effects to replace traditional post-production VFX processes."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:virtual-production-workflow ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:game-engine ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:real-time-rendering ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:motion-capture ],
        ngm:sc-display-and-rendering,
        ngm:virtual-production ;
    skos:broader ngm:sc-display-and-rendering ;
