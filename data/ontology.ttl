ngm:permissionless-network a owl:Class ;
    rdfs:label "Permissionless Network"@en ;
    rdfs:comment "A Permissionless Network is a blockchain or distributed ledger system in which any entity may join as a node, submit transactions, and participate in consensus without prior authorisation or identity verification from a central authority. Permissionlessness is a foundational design property of public blockchains such as Bitcoin and Ethereum, enabling censorship resistance and global open access at the cost of requiring Sybil-resistant consensus mechanisms—typically proof-of-work or proof-of-stake—to prevent anonymous actors from subverting the network."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:consensus-mechanism ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:peer-to-peer-network ],
        ngm:bc-network-component,
        ngm:blockchain-entity,
        ngm:network-component ;
    skos:broader ngm:bc-network-component ;
    vc:contrastsWith ngm:distributed-ledger-technology ;
    vc:enables ngm:incentive-alignment,
        ngm:public-blockchain ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:51-attack,
        ngm:double-spending,
        ngm:gossip-protocol,
        ngm:nakamoto-consensus,
        ngm:network-topology,
        ngm:proof-of-stake ;
    vc:requires ngm:consensus-mechanism,
        ngm:peer-to-peer-network ;
    vc:slug "permissionless-network" ;
    vc:sourceDomain "blockchain" .

