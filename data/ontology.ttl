        ngm:git-hub-copilot,
        ngm:knowledge-transfer,
        ngm:mob-programming ;
    vc:requires ngm:communication-protocol,
        ngm:real-time-collaborative-editor,
        ngm:shared-development-environment,
        ngm:stable-network-connection,
        ngm:video-conferencing ;
    vc:slug "remote-pair-programming" ;
    vc:sourceDomain "distributed-collaboration" ;
    vc:standardizedBy ngm:agile-manifesto-2001,
        ngm:extreme-programming-explained-beck-1999,
        ngm:team-topologies-skelton-and-pais-2019 ;
    vc:supports ngm:agile-software-development,
        ngm:dev-ops-practices,
        ngm:distributed-team-collaboration,
        ngm:open-source-development,
        ngm:pair-rotation-scheduling ;
    vc:uses ngm:floobits,
        ngm:git-hub-codespaces,
        ngm:jet-brains-code-with-me,
        ngm:neovim,
        ngm:tmux,
        ngm:tuple,
        ngm:vs-code-live-share .

ngm:remote-sensing a owl:Class ;
    rdfs:label "Remote Sensing"@en ;
    rdfs:comment "Remote sensing is the acquisition of information about physical objects or phenomena from a distance, typically using sensors mounted on satellites, aircraft, drones, or ground-based platforms, without direct physical contact with the subject. It encompasses passive sensing (measuring reflected or emitted electromagnetic radiation across optical, infrared, and microwave bands) and active sensing (radar and LiDAR, which emit and measure return signals). Remote sensing data underpins earth observation, environmental monitoring, precision agriculture, disaster response, urban planning, and military reconnaissance."@en ;
    rdfs:subClassOf ngm:sensor-fusion ;
    vc:enables ngm:environmental-assessment,
        ngm:mapping,
        ngm:object-recognition ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:autonomous-vehicle,
        ngm:geospatial-information,
        ngm:perception-system,
        ngm:point-cloud ;
    vc:slug "remote-sensing" ;
    vc:sourceDomain "science" ;
    vc:uses ngm:deep-learning,
        ngm:geospatial-technology,
        ngm:image-processing,
        ngm:lidar .

ngm:rendering-technology a owl:Class ;
    rdfs:label "Rendering Technology"@en ;
    rdfs:comment "Rendering Technology comprises the algorithms, pipelines, and hardware interfaces that convert geometric scene descriptions into pixel images. It encompasses rasterisation, ray tracing, and hybrid approaches, executed on GPUs through APIs such as Vulkan, Metal, and WebGPU, and is foundational to real-time interactive graphics, spatial computing experiences, and digital twin visualisation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:rendering-pipeline ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:shader ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:rendering-engine ],
        ngm:sc-display-and-rendering ;
    skos:broader ngm:sc-display-and-rendering ;
    vc:enables ngm:augmented-reality,
        ngm:real-time-rendering ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:rendering-engine,
        ngm:rendering-pipeline,
        ngm:shader ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:slug "rendering-technology" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:gpu-compute,
        ngm:scene-graph .

ngm:representation-learning a owl:Class ;
    rdfs:label "Representation Learning"@en ;
    rdfs:comment "Representation learning is a subfield of machine learning concerned with automatically discovering the data transformations and feature spaces — representations — that make subsequent learning tasks easier, more accurate, or more data-efficient. Rather than relying on hand-crafted features, representation learning systems learn to encode raw inputs such as images, text, or sensor readings into dense, structured latent vectors that capture semantically meaningful variation. Deep neural networks, particularly transformers and convolutional architectures, have made learned representations ubiquitous across computer vision, natural language processing, and multi-modal AI. The quality of learned representations directly determines the performance ceiling of downstream models trained on top of them."@en ;
    rdfs:subClassOf ngm:machine-learning-technique ;
    vc:enables ngm:contrastive-learning,
        ngm:self-supervised-learning,
        ngm:transfer-learning ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:embedding-model,
        ngm:feature-extraction ;
    vc:slug "representation-learning" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:deep-learning,
        ngm:embeddings,
        ngm:latent-space .

ngm:responsible-scaling-policy a owl:Class ;
    rdfs:label "Responsible Scaling Policy"@en ;
    rdfs:comment "A Responsible Scaling Policy (RSP) is a voluntary safety commitment by frontier AI developers that specifies: the capability thresholds at which enhanced safety evaluations must be conducted before further scaling or deployment; the specific risk criteria (particularly around biological, chemical, nuclear, and cyberweapon uplift) that would trigger deployment restrictions; and the technical and organisational safeguards required at each capability level. RSPs translate high-level safety intentions into concrete, falsifiable commitments, creating accountability mechanisms analogous to a self-imposed regulatory framework operating ahead of formal government regulation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:risk-assessment ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:red-teaming ],
        ngm:ai-governance-and-ethics ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:ai-governance-framework,
        ngm:ai-safety,
        ngm:frontier-model-forum ;
    vc:requires ngm:red-teaming,
        ngm:risk-assessment ;
    vc:slug "responsible-scaling-policy" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:ai-alignment .

ngm:rights-protection a owl:Class ;
    rdfs:label "Rights Protection"@en ;
    rdfs:comment "Rights protection encompasses the institutional, legal, and technical mechanisms through which individual and collective entitlements—civil liberties, digital rights, property rights, privacy rights, and human rights—are identified, defended, and remedied when violated. It spans constitutional and statutory safeguards, judicial and administrative enforcement, technical privacy-by-design measures, and advocacy infrastructure. In digital and AI contexts, rights protection addresses algorithmic discrimination, surveillance overreach, automated decision-making without human review, and the erosion of informational self-determination. Effective rights protection requires both upstream prevention and downstream accountability pathways."@en ;
    rdfs:subClassOf ngm:human-rights ;
    vc:enables ngm:consumer-protection,
        ngm:participant-protection ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:data-protection,
        ngm:digital-rights,
        ngm:privacy-protection ;
    vc:slug "rights-protection" ;
    vc:sourceDomain "governance" ;
    vc:supports ngm:ai-governance,
        ngm:legal-framework ;
    vc:uses ngm:enforcement-mechanism,
        ngm:privacy-by-design .

ngm:rrt-algorithm a owl:Class ;
    rdfs:label "RRT Algorithm"@en ;
    rdfs:comment "A sampling-based path planning algorithm that incrementally builds a tree of collision-free configurations by randomly sampling the configuration space and connecting samples to the nearest existing tree node. It efficiently explores high-dimensional spaces and is probabilistically complete."@en ;
    rdfs:subClassOf ngm:path-planning,
        ngm:robo-navigation-and-planning ;
    skos:broader ngm:robo-navigation-and-planning ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires ngm:collision-checker,
        ngm:configuration-space ;
    vc:slug "rrt-algorithm" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:collision-detection,
        ngm:nearest-neighbor-search .

ngm:scaled-dot-product-attention a owl:Class ;
    rdfs:label "Scaled Dot Product Attention"@en ;
    rdfs:comment "An attention mechanism that computes attention weights using the dot product of queries and keys, scaled by the square root of the key dimension, followed by a softmax normalisation."@en ;
    rdfs:subClassOf ngm:ai-model-architecture,
        ngm:attention-mechanism ;
    skos:broader ngm:ai-model-architecture ;
    vc:enables ngm:multi-head-attention ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:transformer-architecture ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:backpropagation,
        ngm:feed-forward-network,
        ngm:self-attention ;
    vc:slug "scaled-dot-product-attention" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:positional-encoding,
        ngm:query-key-value .

ngm:scripting-language a owl:Class ;
    rdfs:label "Scripting Language"@en ;
    rdfs:comment "A scripting language is an interpreted or dynamically compiled programming language used to automate tasks, define interactive behaviours, and extend the capabilities of host applications or game engines without modifying core engine code. In metaverse contexts, scripting languages such as JavaScript, Lua, Python, and C# enable content creators to author custom gameplay mechanics, NPC behaviour, and dynamic environment logic with rapid iteration cycles."@en ;
    rdfs:subClassOf ngm:infra-software-engineering ;
    skos:broader ngm:infra-software-engineering ;
    vc:enables ngm:game-development,
        ngm:virtual-world-creation ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:programming-language ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:software-engineering ;
    vc:slug "scripting-language" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:game-engine .

ngm:secure-data-sharing a owl:Class ;
    rdfs:label "Secure Data Sharing"@en ;
    rdfs:comment "Cryptographic and access control mechanisms that enable controlled exchange of sensitive information between parties in metaverse environments while maintaining confidentiality, integrity, and regulatory compliance through encryption and permissioned access."@en ;
    rdfs:subClassOf ngm:data-security,
        ngm:infra-security-and-identity ;
    skos:broader ngm:infra-security-and-identity ;
    vc:enables ngm:confidential-collaboration ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:slug "secure-data-sharing" ;
    vc:sourceDomain "infrastructure" .

ngm:security-layer a owl:Class ;
    rdfs:label "Security Layer"@en ;
    rdfs:comment "The Security Layer is the implementation-focused abstraction level that encapsulates cryptographic mechanisms, security protocols, threat models, and defensive architectures protecting blockchain and distributed systems from attacks whilst ensuring data integrity, authenticity, and confidentiality. It encompasses concrete implementations such as hash functions, digital signatures, zero-knowledge proofs, access control, and formal verification, distinct from higher-level conceptual security properties."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:hash-function ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:cryptography ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:digital-signature ],
        ngm:infra-security-and-identity ;
    skos:broader ngm:infra-security-and-identity ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:cryptography,
        ngm:digital-signature,
        ngm:hash-function ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:slug "security-layer" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:cryptographic-security,
        ngm:data-security ;
    vc:uses ngm:formal-verification,
        ngm:zero-knowledge-proof .

ngm:semi-fungible-token a owl:Class ;
    rdfs:label "Semi-Fungible Token"@en ;
    rdfs:comment "A blockchain token standard that combines fungible and non-fungible properties, typically implemented under ERC-1155. Semi-fungible tokens represent classes of interchangeable assets (e.g. event tickets of the same tier) that may transition to uniquely non-fungible assets upon redemption or use, enabling a single contract to manage both fungible currencies and unique collectibles with reduced gas costs."@en ;
    rdfs:subClassOf ngm:bc-token-and-asset,
        ngm:token ;
    skos:broader ngm:bc-token-and-asset ;
    vc:enables ngm:asset-tokenisation,
        ngm:digital-asset-trading ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:digital-asset,
        ngm:fungible-token,
        ngm:nft-marketplace,
        ngm:non-fungible-token-nft,
        ngm:security-token ;
    vc:slug "semi-fungible-token" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:erc-1155,
        ngm:erc1155-standard,
        ngm:smart-contract .

ngm:session-management a owl:Class ;
    rdfs:label "Session Management"@en ;
    rdfs:comment "The infrastructure mechanisms for creating, maintaining, and terminating authenticated user sessions within a networked application or virtual environment. Session management encompasses token issuance, state synchronisation, session timeout and recovery, and revocation, forming a critical layer between user authentication and persistent application state."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:identity-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:authentication ],
        ngm:infra-security-and-identity ;
    skos:broader ngm:infra-security-and-identity ;
    vc:enables ngm:persistent-state ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:access-control,
        ngm:cloud-infrastructure,
        ngm:cybersecurity ;
    vc:requires ngm:authentication,
        ngm:identity-management ;
    vc:slug "session-management" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:encryption .

ngm:shared-knowledge-base a owl:Class ;
    rdfs:label "Shared Knowledge Base"@en ;
    rdfs:comment "A collaborative knowledge repository enabling multiple agents or users to exchange, integrate, and query structured information using semantic web technologies, providing a common understanding of domain concepts through ontologies and linked data standards."@en ;
    rdfs:subClassOf ngm:knowledge-management-system,
        ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:enables ngm:collaborative-knowledge-discovery ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:slug "shared-knowledge-base" ;
    vc:sourceDomain "spatial-computing" .

ngm:skos-vocabulary a owl:Class ;
    rdfs:label "Skos Vocabulary"@en ;
    rdfs:comment "A W3C recommendation providing an RDF-based data model for representing thesauri, taxonomies, classification schemes, and other structured controlled vocabularies, enabling publication and linking of knowledge organization systems on the semantic web through standardized concepts and relationships."@en ;
    rdfs:subClassOf ngm:knowledge-organization-system,
        ngm:sc-standards-and-interop ;
    skos:broader ngm:sc-standards-and-interop ;
    vc:enables ngm:linked-vocabulary-publishing ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:slug "skos-vocabulary" ;
    vc:sourceDomain "spatial-computing" .

ngm:slack a owl:Class ;
    rdfs:label "Slack"@en ;
    rdfs:comment "Slack is a cloud-based team messaging and collaboration platform that organises workplace communication into persistent, searchable channels grouped by topic, project, or team, supplemented by direct messages and threaded conversations. Originally developed as an internal tool for the gaming company Tiny Speck in 2013 before pivoting to a standalone product, Slack is distinguished by its extensible integration ecosystem (over 2,500 app integrations), Workflow Builder for no-code automation, and its role as the de facto communication layer for software development teams. Acquired by Salesforce in 2021 for $27.7 billion, it competes primarily with Microsoft Teams."@en ;
    rdfs:subClassOf ngm:collaboration-platform ;
    vc:enables ngm:remote-collaboration,
        ngm:workflow-automation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:digital-workplace-platform,
        ngm:distributed-team-collaboration,
        ngm:remote-work ;
    vc:slug "slack" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:api-integration,
        ngm:asynchronous-communication,
        ngm:threaded-messaging .

ngm:smart-cities a owl:Class ;
    rdfs:label "Smart Cities"@en ;
    rdfs:comment "Smart Cities are urban environments that integrate digital technologies, data analytics, Internet of Things infrastructure, and connectivity to optimise the delivery of public services, improve quality of life, increase operational efficiency, and advance sustainability goals. They instrumentalise physical infrastructure — transport networks, utilities, buildings, and public spaces — with sensors and actuators connected through communication networks, and apply data-driven decision-making to city operations, planning, and citizen engagement."@en ;
    rdfs:subClassOf ngm:digital-twin-of-society-dto-s ;
    vc:enables ngm:autonomous-vehicle,
        ngm:smart-grid,
        ngm:sustainable-development ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:liverpool-smart-cities,
        ngm:real-time-monitoring ;
    vc:slug "smart-cities" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:digital-twin,
        ngm:edge-ai-for-smart-cities,
        ngm:edge-computing,
        ngm:internet-of-things .

ngm:smart-royalty-contract a owl:Class ;
    rdfs:label "Smart Royalty Contract"@en ;
    rdfs:comment "A programmable blockchain contract that automatically enforces royalty payment terms, calculates compensation amounts, and triggers distributions to creators and rights holders upon qualifying transactions in NFT and digital asset ecosystems."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
