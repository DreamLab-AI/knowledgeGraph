ngm:bridge a owl:Class ;
    rdfs:label "Bridge"@en ;
    rdfs:comment "A protocol that transfers assets or messages between separate ledgers by locking, burning, or attesting value on one chain and reproducing a representation on another."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:lock-and-mint-mechanism ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:relayer ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:oracle ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:validator-set ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:smart-contract ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptographic-proof ],
        ngm:blockchain-interoperability ;
    vc:bridgesTo ngm:cross-chain-bridge,
        ngm:interoperability-protocol ;
    vc:contrastsWith ngm:atomic-swap,
        ngm:layer-2-rollup ;
    vc:dependsOn ngm:consensus-mechanism,
        ngm:finality ;
    vc:enables ngm:cross-chain-asset-transfer,
        ngm:cross-chain-messaging,
        ngm:decentralised-finance,
        ngm:token-wrapping ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:burn-and-release-mechanism,
        ngm:lock-and-mint-mechanism,
        ngm:relayer ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:bridge-exploit,
        ngm:trusted-bridge,
        ngm:trustless-bridge ;
    vc:requires ngm:cryptographic-proof,
        ngm:oracle,
        ngm:smart-contract,
        ngm:validator-set ;
    vc:slug "bridge" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:decentralised-exchange,
        ngm:liquidity-pool ;
    vc:uses ngm:hash-time-locked-contract,
        ngm:multi-signature-scheme,
        ngm:zero-knowledge-proof .

ngm:bridge-exploit a skos:Concept ;
    rdfs:label "Bridge Exploit"@en .

ngm:bridge-protocol a skos:Concept ;
    rdfs:label "Bridge Protocol"@en .

ngm:bridged-stablecoin a skos:Concept ;
    rdfs:label "Bridged Stablecoin"@en .

ngm:bright-id a owl:Class ;
    rdfs:label "BrightID"@en ;
    rdfs:comment "BrightID is a decentralised social identity network that establishes the uniqueness of human participants by analysing the topology of a peer-to-peer social connection graph, without collecting personally identifying information. Each user creates an account identified solely by a public key, then builds mutual verification links with trusted contacts; graph-analysis algorithms infer whether an account corresponds to a distinct human rather than a bot or duplicate. The system provides applications with a binary or graded uniqueness signal usable for Sybil-resistant resource allocation, quadratic voting, and universal basic income distribution without requiring biometric data or a central identity authority."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:peer-to-peer-network ],
        ngm:digital-identity ;
    vc:bridgesTo ngm:federated-learning,
        ngm:privacy-preserving-computation,
        ngm:reputation-system ;
    vc:contrastsWith ngm:biometric-identity,
        ngm:centralised-identity,
        ngm:sybil-attack ;
    vc:enables ngm:decentralised-governance,
        ngm:quadratic-voting,
        ngm:sybil-resistance,
        ngm:universal-basic-income ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:airdrop,
        ngm:decentralised-identifier,
        ngm:proof-of-personhood,
        ngm:self-sovereign-identity,
        ngm:token-distribution,
        ngm:web-of-trust ;
    vc:requires ngm:peer-to-peer-network,
        ngm:public-key-cryptography,
        ngm:social-graph ;
    vc:slug "bright-id" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:decentralised-application,
        ngm:graph-analysis,
        ngm:zero-knowledge-proof .

