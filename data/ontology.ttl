ngm:trade-finance a owl:Class ;
    rdfs:label "Trade Finance"@en ;
    rdfs:comment "Trade finance encompasses the financial instruments, products, and mechanisms that facilitate domestic and international commercial transactions by managing the payment, credit, and risk gap between exporter shipment and importer receipt. Core instruments include letters of credit, bank guarantees, documentary collections, supply chain financing, factoring, and forfaiting, all structured to give exporters payment certainty and importers time to generate revenue from goods before settling. Trade finance is a foundational segment of global banking, representing approximately $9 trillion in annual transaction volume, and is undergoing significant digitisation through blockchain-based platforms, electronic bills of lading, and smart contract automation."@en ;
    rdfs:subClassOf ngm:financial-services ;
    vc:dependsOn ngm:compliance-framework,
        ngm:fatf,
        ngm:financial-regulation ;
    vc:enables ngm:customs-trade-facilitation,
        ngm:importer,
        ngm:supply-chain-management,
        ngm:supply-chain-traceability ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:cross-border-payments,
        ngm:financial-instruments,
        ngm:payment-system,
        ngm:supply-chain,
        ngm:supply-chain-blockchain ;
    vc:slug "trade-finance" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:digital-asset-standards,
        ngm:logistics-optimization ;
    vc:uses ngm:aml-kyc-compliance,
        ngm:blockchain-application,
        ngm:cryptographic-verification,
        ngm:smart-contract,
        ngm:smart-contracts .

ngm:video-compression a owl:Class ;
    rdfs:label "Video Compression"@en ;
    rdfs:comment "Video compression is the process of encoding digital video data to reduce file size and bit rate for efficient storage and transmission, while maintaining perceptually acceptable quality. It exploits three principal forms of redundancy: spatial redundancy within individual frames, temporal redundancy across consecutive frames, and perceptual redundancy based on limitations of human visual perception. Modern video codecs such as H.264/AVC, H.265/HEVC, VP9, and AV1 implement intra-frame prediction, inter-frame motion compensation, discrete cosine or wavelet transforms, quantisation, and entropy coding to achieve compression ratios that make streaming, broadcast, and real-time communication practical over bandwidth-limited networks."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:entropy-coding ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:motion-estimation ],
        ngm:data-compression ;
    vc:bridgesTo ngm:content-delivery-network ;
    vc:contrastsWith ngm:lossless-compression ;
    vc:dependsOn ngm:signal-processing ;
    vc:enables ngm:broadcast-television,
        ngm:content-delivery,
        ngm:real-time-communication,
        ngm:video-streaming ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:entropy-coding,
        ngm:motion-estimation ;
    vc:implements ngm:av1-codec ;
    vc:isPartOf ngm:multimedia-processing,
        ngm:video-codec ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:adaptive-bitrate-streaming,
        ngm:latency ;
    vc:requires ngm:discrete-cosine-transform ;
    vc:slug "video-compression" ;
    vc:sourceDomain "infrastructure" ;
    vc:standardizedBy ngm:alliance-for-open-media,
        ngm:itu-t .

ngm:vision-transformer a owl:Class ;
    rdfs:label "Vision Transformer"@en ;
    rdfs:comment "The Vision Transformer (ViT) is a neural network architecture that applies the transformer self-attention mechanism directly to sequences of fixed-size image patches, treating each patch embedding as a token analogous to a word in natural-language processing. Introduced by Dosovitskiy et al. (2020), ViT demonstrated that pure attention-based models can match or exceed convolutional networks on image classification benchmarks when pre-trained on sufficiently large datasets."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:pre-training ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:feed-forward-network ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:layer-normalisation ],
        ngm:computer-vision ;
    vc:bridgesTo ngm:large-language-model,
        ngm:natural-language-processing ;
    vc:contrastsWith ngm:convolutional-neural-network ;
    vc:enables ngm:multimodal-ai-architecture-learning,
        ngm:text-to-image-generation,
        ngm:video-understanding ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:cls-token,
        ngm:feed-forward-network,
        ngm:layer-normalisation ;
    vc:qualityScore "0.85"^^xsd:float ;
    vc:relatedTo ngm:contrastive-learning,
        ngm:diffusion-transformer,
        ngm:image-segmentation,
        ngm:masked-image-modelling ;
    vc:requires ngm:pre-training ;
    vc:slug "vision-transformer" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:attention-mechanism,
        ngm:multi-head-attention,
        ngm:patch-embedding,
        ngm:positional-encoding .

ngm:voluntary-carbon-market a owl:Class ;
    rdfs:label "Voluntary Carbon Market"@en ;
    rdfs:comment "The Voluntary Carbon Market (VCM) is a decentralised, private-sector marketplace in which corporations, governments, and individuals voluntarily purchase and retire carbon credits representing certified reductions or removals of greenhouse gas emissions, without being compelled by regulatory compliance frameworks. Participation is driven by corporate net-zero commitments, reputational and ESG pressures, and a desire to mobilise private finance for climate projects ahead of, or beyond, mandatory obligations. Each credit typically represents one metric tonne of CO₂-equivalent avoided or sequestered, verified by independent auditors against published standards such as the Verra Verified Carbon Standard (VCS) or the Gold Standard. The market operates through project developers, registries, brokers, and exchanges, with integrity increasingly governed by the Core Carbon Principles issued by the Integrity Council for the Voluntary Carbon Market (ICVCM)."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:additionality ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:carbon-credits ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:third-party-auditing ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:carbon-neutrality-verification ],
        ngm:carbon-markets ;
    vc:bridgesTo ngm:decentralised-finance ;
    vc:contrastsWith ngm:compliance-carbon-market,
        ngm:emissions-trading-scheme ;
    vc:enables ngm:climate-change-mitigation,
        ngm:nature-based-solutions,
        ngm:net-zero-targets ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:carbon-credits ;
    vc:isPartOf ngm:carbon-markets,
        ngm:climate-finance ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:corporate-sustainability-reporting,
        ngm:direct-air-capture,
        ngm:paris-agreement-article-6 ;
    vc:requires ngm:additionality,
        ngm:carbon-neutrality-verification,
        ngm:third-party-auditing ;
    vc:slug "voluntary-carbon-market" ;
    vc:sourceDomain "governance" ;
    vc:standardizedBy ngm:gold-standard,
        ngm:integrity-council-for-the-voluntary-carbon-market,
        ngm:verra-vcs-standard ;
    vc:supports ngm:paris-agreement,
        ngm:redd-plus,
        ngm:sustainable-development-goals ;
    vc:uses ngm:carbon-offsetting,
        ngm:esg-reporting,
        ngm:price-discovery .

ngm:write-ahead-logging a owl:Class ;
    rdfs:label "Write-Ahead Logging"@en ;
    rdfs:comment "Write-Ahead Logging (WAL) is a durability technique in which changes are recorded to a sequential append-only log before they are applied to the main data store. By guaranteeing that the log is flushed to stable storage before the corresponding pages are modified, the system can recover a consistent state after a crash by replaying or undoing logged operations. WAL is foundational to transactional databases, providing atomicity and durability without expensive synchronous writes to scattered data pages."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-persistence ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:audit-trail ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-integrity ],
        ngm:data-persistence ;
    vc:bridgesTo ngm:fault-tolerance ;
    vc:dependsOn ngm:data-persistence ;
    vc:enables ngm:data-integrity,
        ngm:fault-tolerance,
        ngm:transaction ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:audit-trail ;
    vc:implements ngm:data-integrity ;
    vc:isPartOf ngm:data-persistence ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:data-management,
        ngm:database-systems,
        ngm:two-phase-commit ;
    vc:requires ngm:data-integrity,
        ngm:data-persistence ;
    vc:slug "write-ahead-logging" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:database-management-system,
        ngm:relational-database,
        ngm:reliability ;
    vc:uses ngm:data-persistence .

ngm:actuators a owl:Class ;
    rdfs:label "Actuators"@en ;
    rdfs:comment "Actuators are physical devices that convert an electrical, hydraulic, or pneumatic control signal into mechanical motion or force, enabling a control system to produce a desired physical effect in the world. They are the output components of robotic and cyber-physical systems, spanning technologies including servo motors, pneumatic cylinders, hydraulic actuators, and piezoelectric elements, each offering different trade-offs in force output, speed, precision, and energy efficiency."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:series-elastic-actuator ],
        [ a owl:Restriction ;
