    vc:sourceDomain "robotics" ;
    vc:uses ngm:actuator .

ngm:openai-research-organisation-api a owl:Class ;
    rdfs:label "OpenAI API"@en ;
    rdfs:comment "The OpenAI API is a hosted programming interface that gives developers access to OpenAI's models for text generation, reasoning, embeddings, image generation, speech, and tool use over HTTP. Exposing capabilities through endpoints such as chat completions, responses, and embeddings, it abstracts model hosting, scaling, and inference behind a usage-priced REST interface with structured outputs, function calling, and streaming. Its conventions have become a de facto standard widely emulated by other providers and compatible open-source serving stacks."@en ;
    rdfs:subClassOf ngm:api ;
    vc:enables ngm:llm-application-framework,
        ngm:prompt-engineering ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:rest-api ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:gpt ;
    vc:slug "open-ai-api" ;
    vc:sourceDomain "ai" .

ngm:optimism-collective a owl:Class ;
    rdfs:label "Optimism Collective"@en ;
    rdfs:comment "The Optimism Collective is a two-house governance body overseeing the Optimism ecosystem — a suite of Ethereum Layer 2 networks built on the OP Stack rollup technology — consisting of the Token House (OP token holders who vote on protocol upgrades and treasury allocations) and the Citizens' House (non-transferable badge holders who allocate Retroactive Public Goods Funding). It represents one of the most sophisticated real-world experiments in bicameral on-chain governance, designed to balance token-weighted economic interests with broader societal value creation and public goods provision."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:on-chain-governance ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:smart-contract ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:governance-token ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:retroactive-public-goods-funding ],
        ngm:dao-governance ;
    vc:bridgesTo ngm:distributed-collaboration,
        ngm:governance ;
    vc:contrastsWith ngm:governance-token,
        ngm:plutocratic-voting ;
    vc:dependsOn ngm:ethereum,
        ngm:op-stack,
        ngm:optimistic-rollup ;
    vc:enables ngm:dao,
        ngm:decentralized-governance,
        ngm:protocol-upgrades,
        ngm:public-goods-funding ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:retroactive-public-goods-funding ;
    vc:implements ngm:governance,
        ngm:token-weighted-voting ;
    vc:isPartOf ngm:optimism ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:collective-decision-making,
        ngm:layer-2-scaling,
        ngm:sequencer ;
    vc:requires ngm:governance-token,
        ngm:on-chain-governance,
        ngm:smart-contract ;
    vc:slug "optimism-collective" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:attestation,
        ngm:blockchain-governance,
        ngm:multisig-wallet,
        ngm:voting-mechanism .

ngm:orchestration-layer a owl:Class ;
    rdfs:label "Orchestration Layer"@en ;
    rdfs:comment "An Orchestration Layer is a software architectural component that coordinates the execution of heterogeneous services, agents, or microservices — managing task routing, dependency resolution, resource allocation, and fault recovery — to produce coherent outputs from distributed system components. It acts as the control plane above individual execution units, abstracting their composition into unified workflows."@en ;
    rdfs:subClassOf ngm:orchestration ;
    vc:enables ngm:llm-orchestration,
        ngm:multi-agent-orchestration ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.85"^^xsd:float ;
    vc:relatedTo ngm:service-mesh ;
    vc:slug "orchestration-layer" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:kubernetes,
        ngm:microservices,
        ngm:middleware-layer .

ngm:organisational-learning a owl:Class ;
    rdfs:label "Organisational Learning"@en ;
    rdfs:comment "Organisational learning is the process by which a group, team or enterprise creates, retains and transfers knowledge to improve its collective performance over time. It encompasses how experience is encoded into routines, how lessons from success and failure are shared, and how the organisation adapts its mental models and practices in response. As a discipline it bridges knowledge management, continuous improvement and organisational culture."@en ;
    rdfs:subClassOf ngm:knowledge-management ;
    vc:bridgesTo ngm:continuous-improvement,
        ngm:feedback-loop ;
    vc:dependsOn ngm:knowledge-sharing ;
    vc:enables ngm:continuous-improvement,
        ngm:knowledge-transfer ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:feedback-loop ;
    vc:isPartOf ngm:knowledge-management ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:incident-reporting,
        ngm:knowledge-management,
        ngm:training ;
    vc:slug "organisational-learning" ;
    vc:sourceDomain "distributed-collaboration" ;
    vc:supports ngm:collaboration,
        ngm:knowledge-sharing ;
    vc:uses ngm:knowledge-base .

ngm:ownership-record a owl:Class ;
    rdfs:label "Ownership Record"@en ;
    rdfs:comment "An Ownership Record is a persistent entry that attests who holds title to an asset at a given time. On a blockchain it is an immutable, timestamped ledger entry binding an asset identifier to a controlling address, providing tamper-evident provenance and transfer history. Such records underpin tokenized assets like certificates and royalty instruments where verifiable, auditable ownership is essential."@en ;
    rdfs:subClassOf ngm:bc-token-and-asset ;
    skos:broader ngm:bc-token-and-asset ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:creator-royalty-token,
        ngm:renewable-energy-certificates ;
    vc:slug "ownership-record" ;
    vc:sourceDomain "blockchain" .

ngm:paged-attention a owl:Class ;
    rdfs:label "Paged Attention"@en ;
    rdfs:comment "Paged attention is a memory management technique for large language model inference that partitions the key-value cache into fixed-size blocks managed like virtual memory pages. By decoupling logical token positions from physical memory layout it eliminates fragmentation, enables near-zero waste in cache allocation and allows sharing of cached prefixes across requests. Introduced in the vLLM serving system, it substantially increases throughput for high-concurrency inference."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:kv-cache ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:attention-mechanism ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gpu-memory ],
        ngm:kv-cache ;
    vc:bridgesTo ngm:gpu ;
    vc:contrastsWith ngm:flash-attention ;
    vc:dependsOn ngm:transformer ;
    vc:enables ngm:model-serving,
        ngm:throughput ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:kv-cache ;
    vc:implements ngm:continuous-batching,
        ngm:memory-management ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:model-optimisation-and-performance,
        ngm:speculative-decoding ;
    vc:requires ngm:attention-mechanism,
        ngm:gpu-memory ;
    vc:slug "paged-attention" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:inference,
        ngm:large-language-model .

ngm:parameter-count a owl:Class ;
    rdfs:label "Parameter Count"@en ;
    rdfs:comment "The total number of trainable weights and biases in a neural network, serving as the primary measure of model size and capacity. Parameter count typically ranges from millions to hundreds of billions in modern language models, and governs memory requirements, inference cost, and the upper bound on information that can be encoded; scaling law research relates it to training compute and dataset size."@en ;
    rdfs:subClassOf ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:dependsOn ngm:neural-network-architecture ;
    vc:enables ngm:fine-tuning,
        ngm:transfer-learning ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:large-language-models,
        ngm:neural-network ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:machine-learning-discipline-infrastructure ;
    vc:slug "parameter-count" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:payment-channel-network a owl:Class ;
    rdfs:label "Payment Channel Network"@en ;
    rdfs:comment "A Payment Channel Network is a layer-2 scaling architecture in which participants open bilateral payment channels and route payments across a graph of connected channels without settling each transaction on the underlying blockchain. Funds are locked in multisignature channels, and balances update off-chain through signed state, with only channel opening and closing recorded on-chain. This enables high-throughput, low-fee, near-instant payments while inheriting base-layer security."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:payment-channel ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:smart-contract ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:onion-routing ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:multisignature-wallets ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:hash-time-locked-contract ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:timelock ],
        ngm:bc-network-component ;
    skos:broader ngm:bc-network-component ;
    vc:bridgesTo ngm:distributed-systems,
        ngm:finance ;
    vc:contrastsWith ngm:rollup,
        ngm:sidechain ;
    vc:dependsOn ngm:blockchain,
        ngm:digital-signature,
        ngm:peer-to-peer-network ;
    vc:enables ngm:atomic-swap,
        ngm:micropayment,
        ngm:streaming-payments ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:hash-time-locked-contract,
        ngm:onion-routing,
        ngm:payment-channel ;
    vc:implements ngm:layer-2-protocol,
        ngm:state-channel ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:lightning-network,
        ngm:liquidity-management,
        ngm:raiden-network ;
    vc:requires ngm:multisignature-wallets,
        ngm:smart-contract,
        ngm:timelock ;
    vc:slug "payment-channel-network" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:gossip-protocol,
        ngm:source-routing .

ngm:payment-processor a owl:Class ;
    rdfs:label "Payment Processor"@en ;
    rdfs:comment "A payment processor is a service that handles the transaction lifecycle between a merchant, the customer's payment instrument, and the settlement networks. It authorises, captures, clears, and settles funds while applying fraud checks, currency conversion, and compliance controls. Processors are foundational components of digital payment infrastructure, abstracting card networks, bank rails, and blockchain settlement behind a single integration."@en ;
    rdfs:subClassOf ngm:infra-computing-and-cloud ;
    skos:broader ngm:infra-computing-and-cloud ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:digital-payments,
        ngm:payment-infrastructure ;
    vc:slug "payment-processor" ;
    vc:sourceDomain "infrastructure" .

ngm:perimeter-security a owl:Class ;
    rdfs:label "Perimeter Security"@en ;
    rdfs:comment "Perimeter security is a network defence model that establishes a fortified boundary between a trusted internal network and untrusted external networks, concentrating controls such as firewalls and gateways at that boundary. It treats the network edge as the principal line of defence, inspecting and filtering traffic crossing into or out of the protected zone. The approach assumes that hosts inside the perimeter are comparatively trustworthy, an assumption that modern architectures increasingly challenge."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:access-control ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:security-architecture ],
        ngm:network-security ;
    vc:bridgesTo ngm:identity-and-access-management ;
    vc:contrastsWith ngm:zero-trust-architecture ;
    vc:dependsOn ngm:authentication,
        ngm:network-layer ;
    vc:enables ngm:data-loss-prevention,
        ngm:secure-communication ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:data-breach,
        ngm:network-protocol ;
    vc:requires ngm:access-control,
        ngm:security-architecture ;
    vc:slug "perimeter-security" ;
    vc:sourceDomain "security" ;
    vc:supports ngm:authorization,
        ngm:cybersecurity ;
    vc:uses ngm:cryptographic-protocol,
        ngm:threat-detection .

ngm:pharmaceutical-supply-chain a owl:Class ;
    rdfs:label "Pharmaceutical Supply Chain"@en ;
    rdfs:comment "The Pharmaceutical Supply Chain encompasses all entities, processes, and systems involved in the production, storage, distribution, and dispensing of medicinal products, from active pharmaceutical ingredient (API) synthesis through to patient delivery. It is subject to stringent regulatory serialisation and traceability requirements designed to prevent counterfeit medicines from entering the legitimate supply chain."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:rfid ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:dscsa-compliance ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:pharmaceutical-logistics ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gs-1-standards ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:pharmaceutical-traceability ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:cold-chain-monitoring ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:serialisation-format ],
        ngm:supply-chain-management ;
    vc:bridgesTo ngm:blockchain,
        ngm:governance,
        ngm:infrastructure ;
    vc:dependsOn ngm:regulatory-compliance ;
    vc:enables ngm:medication-safety,
        ngm:product-recall-management ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:cold-chain-monitoring,
        ngm:pharmaceutical-logistics,
        ngm:serialisation-format ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:blockchain-provenance,
        ngm:supply-chain-resilience ;
    vc:requires ngm:dscsa-compliance,
        ngm:gs-1-standards,
        ngm:pharmaceutical-traceability,
        ngm:rfid ;
    vc:slug "pharmaceutical-supply-chain" ;
    vc:sourceDomain "supply-chain" ;
    vc:standardizedBy ngm:eu-falsified-medicines-directive,
        ngm:gs-1-standards ;
    vc:uses ngm:barcode-scanning,
        ngm:enterprise-resource-planning,
        ngm:iot-sensor .

ngm:physics-based-animation a owl:Class ;
    rdfs:label "Physics-Based Animation"@en ;
    rdfs:comment "Animation technique that computes object motion through real-time simulation of physical forces, gravity, collisions, and dynamics to create realistic movement and interactions."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:physics-engine ],
