        ngm:interactive-storytelling ;
    vc:slug "narrative-structure" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:character-model .

ngm:narrative-theme a owl:Class ;
    rdfs:label "Narrative Theme"@en ;
    rdfs:comment "The underlying message, central idea, or motif that pervades a story and shapes public perception, constructed through selective framing, language choices, and emphasis on particular details to guide audience interpretation of events, characters, and meaning."@en ;
    rdfs:subClassOf ngm:narrative-structure,
        ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:enables ngm:storytelling ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:slug "narrative-theme" ;
    vc:sourceDomain "spatial-computing" .

ngm:navigation-system a owl:Class ;
    rdfs:label "Navigation System"@en ;
    rdfs:comment "An integrated set of hardware and software components that enables a robot or autonomous agent to determine its position, plan collision-free paths, and execute motion towards a goal. Navigation systems typically combine localisation, mapping, path planning, and obstacle avoidance modules, often relying on sensor fusion from LiDAR, cameras, and IMUs."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:sensor ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:localization ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:slam ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:obstacle-avoidance ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:path-planning ],
        ngm:robo-navigation-and-planning ;
    skos:broader ngm:robo-navigation-and-planning ;
    vc:enables ngm:autonomous-vehicle,
        ngm:mobile-robot ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:localization,
        ngm:obstacle-avoidance,
        ngm:path-planning ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:requires ngm:sensor,
        ngm:slam ;
    vc:slug "navigation-system" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:lidar,
        ngm:motion-planning .

ngm:nearest-neighbor-search a owl:Class ;
    rdfs:label "Nearest Neighbor Search"@en ;
    rdfs:comment "An algorithmic technique used in vector databases to find data points most similar to a query vector by computing distance metrics like cosine similarity or Euclidean distance, with approximate mods (ANN) trading minor accuracy for millisecond-scale retrieval from s of objects."@en ;
    rdfs:subClassOf ngm:sc-content-and-assets,
        ngm:search-algorithm ;
    skos:broader ngm:sc-content-and-assets ;
    vc:enables ngm:semantic-search ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:slug "nearest-neighbor-search" ;
    vc:sourceDomain "spatial-computing" .

ngm:network-analysis a owl:Class ;
    rdfs:label "Network Analysis"@en ;
    rdfs:comment "Network Analysis is the study of complex systems represented as graphs of nodes and edges, using mathematical and computational techniques to characterise structure, detect communities, identify influential nodes, and model dynamic processes such as information diffusion. Rooted in graph theory, sociology, and statistical physics, it encompasses metrics including degree distribution, betweenness centrality, clustering coefficients, and path lengths. Applications span social network mapping, cybersecurity threat detection, supply chain vulnerability assessment, and knowledge graph quality evaluation. Machine learning on graphs, through graph neural networks, has substantially extended analytical capabilities."@en ;
    rdfs:subClassOf ngm:knowledge-graph ;
    vc:enables ngm:knowledge-graph-construction,
        ngm:knowledge-graphing ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:distributed-system,
        ngm:knowledge-management,
        ngm:linked-data,
        ngm:machine-learning ;
    vc:slug "network-analysis" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:graph-neural-network,
        ngm:knowledge-representation,
        ngm:social-network-graph .

ngm:network-slicing a owl:Class ;
    rdfs:label "Network Slicing"@en ;
    rdfs:comment "Network slicing is a virtualisation architecture that partitions a single physical network infrastructure into multiple isolated, logically independent virtual networks — called slices — each configured to provide the specific performance characteristics, security posture, and service topology required by a distinct application or tenant. Defined within 3GPP Release 15 and later releases for 5G networks, each slice is instantiated through software-defined networking and network function virtualisation, enabling differentiated service-level guarantees — such as ultra-low latency for industrial automation or high-throughput for video streaming — without dedicated physical hardware. Slices span radio access, transport, and core network domains and can be dynamically provisioned, scaled, and torn down."@en ;
    rdfs:subClassOf ngm:network-function-virtualization ;
    vc:enables ngm:edge-computing,
        ngm:guaranteed-bandwidth,
        ngm:quality-of-service ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:6-g-network-slice,
        ngm:latency ;
    vc:slug "network-slicing" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:edge-computing-architecture .

ngm:networking-layer a owl:Class ;
    rdfs:label "Networking Layer"@en ;
    rdfs:comment "Communication systems that connect components and users across distributed metaverse environments through network protocols and software."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:physical-network-hardware ],
