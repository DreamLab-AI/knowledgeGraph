        ngm:risk-management ;
    vc:uses ngm:audit-trail .

ngm:gas-metering a owl:Class ;
    rdfs:label "Gas Metering"@en ;
    rdfs:comment "Gas metering is the mechanism by which a blockchain virtual machine accounts for the computational, storage and bandwidth resources consumed by executing a transaction or smart contract. Each low-level operation is assigned a gas cost, and execution proceeds only while the sender's prepaid gas budget remains, halting deterministically when the budget is exhausted. By pricing computation, gas metering deters denial-of-service abuse, bounds execution and forms the basis of transaction fees."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:virtual-machine ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:smart-contract ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:virtual-machine ],
        ngm:smart-contract-platform ;
    vc:dependsOn ngm:smart-contract-platform ;
    vc:enables ngm:gas-fee ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:smart-contract,
        ngm:virtual-machine ;
    vc:implements ngm:smart-contract ;
    vc:isPartOf ngm:smart-contract-platform ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:gas-fee,
        ngm:smart-contract-platform ;
    vc:requires ngm:virtual-machine ;
    vc:slug "gas-metering" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:gas-fee,
        ngm:smart-contract ;
    vc:uses ngm:virtual-machine .

ngm:generative-content a owl:Class ;
    rdfs:label "Generative Content"@en ;
    rdfs:comment "Generative Content is digital media — text, imagery, audio, video, 3D assets, or code — produced algorithmically by generative AI models rather than created directly by human authors. It encompasses outputs of large language models, diffusion models, generative adversarial networks, variational autoencoders, and multimodal neural synthesis systems. The concept carries significant implications for provenance tracking, copyright attribution, content authenticity, and quality assurance, particularly in high-throughput pipelines for spatial computing, metaverse environments, and educational platforms."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:3-d-asset ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:generative-ai ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:foundation-model ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:training-data ],
        ngm:ai-application ;
    skos:broader ngm:ai-application ;
    vc:bridgesTo ngm:c2-pa-standard,
