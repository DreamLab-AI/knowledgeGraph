ngm:bitcoin-proof-of-work-protocol-custody a owl:Class ;
    rdfs:label "Bitcoin Custody"@en ;
    rdfs:comment "Bitcoin custody is the practice and infrastructure for securely holding the private keys that control bitcoin, spanning self-custody, collaborative custody, and qualified institutional custodians. Approaches differ in how they distribute key control and recovery, using techniques such as multi-signature, hardware security modules, and multi-party computation to balance security against operational availability. Custody design is foundational to wallets, federations, and regulated products such as exchange-traded funds."@en ;
    rdfs:subClassOf ngm:digital-asset ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:bitcoin-proof-of-work-protocol-etf,
        ngm:fedimint ;
    vc:slug "bitcoin-custody" ;
    vc:sourceDomain "blockchain" .

ngm:bitcoin-proof-of-work-protocol-de-fi a owl:Class ;
    rdfs:label "Bitcoin DeFi"@en ;
    rdfs:comment "Bitcoin DeFi is the emerging set of decentralised finance applications, such as lending, swaps, and stablecoins, built on or anchored to the Bitcoin network. Because Bitcoin's base layer has limited scripting, these applications typically rely on layers and sidechains, including Lightning, Taproot assets, RGB, and Layer-3 protocols, to add programmability. The goal is to bring DeFi functionality to Bitcoin's liquidity and security while preserving its conservative base-layer design."@en ;
    rdfs:subClassOf ngm:de-fi ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:btc-layer-3 ;
    vc:slug "bitcoin-de-fi" ;
    vc:sourceDomain "blockchain" .

ngm:bitcoin-proof-of-work-protocol-etf-custody a owl:Class ;
    rdfs:label "Bitcoin ETF Custody"@en ;
    rdfs:comment "Bitcoin ETF custody is the institutional safekeeping of the bitcoin backing a spot exchange-traded fund, performed by qualified custodians under regulatory and audit requirements. It typically uses cold storage with multi-signature or multi-party-computation key management, segregation of client assets, insurance, and proof-of-reserves attestation. This custody model bridges traditional regulated finance and on-chain asset control, and is central to the integrity of spot Bitcoin ETFs."@en ;
    rdfs:subClassOf ngm:digital-asset ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:multi-sig-governance ;
    vc:slug "bitcoin-etf-custody" ;
    vc:sourceDomain "blockchain" .

ngm:bitcoin-proof-of-work-protocol-lightning-network a owl:Class ;
    rdfs:label "Bitcoin Lightning Network"@en ;
    rdfs:comment "The Bitcoin Lightning Network is a layer-two payment protocol built on top of Bitcoin that enables fast, low-cost transactions through bidirectional payment channels. Two parties lock funds in a multisignature channel and exchange signed balance updates off-chain, settling the final state on the Bitcoin blockchain only when the channel closes. Payments can be routed across a network of connected channels, allowing transfers between parties that do not share a direct channel."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:bitcoin-proof-of-work-protocol ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:onion-routing ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:channel-factory ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:multisignature ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:payment-channel ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:htlc ],
        ngm:bc-protocol-and-consensus ;
    skos:broader ngm:bc-protocol-and-consensus ;
    vc:bridgesTo ngm:bc-defi-and-economics,
        ngm:decentralised-finance,
        ngm:liquid-network ;
    vc:contrastsWith ngm:bitcoin-proof-of-work-protocol,
        ngm:ethereum-state-channels ;
    vc:dependsOn ngm:channel-liquidity,
        ngm:utxo-model ;
    vc:enables ngm:atomic-swap,
        ngm:instant-settlement,
        ngm:micropayments,
        ngm:streaming-payments ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:channel-factory,
        ngm:htlc,
        ngm:onion-routing,
        ngm:payment-channel ;
    vc:implements ngm:bolt-specification,
        ngm:source-routing ;
    vc:isPartOf ngm:bitcoin-ecosystem ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:layer-two-protocol,
        ngm:routing-algorithm,
        ngm:watchtower-service ;
    vc:requires ngm:bitcoin-proof-of-work-protocol,
        ngm:multisignature,
        ngm:segregated-witness,
        ngm:timelocked-transaction ;
    vc:slug "bitcoin-lightning-network" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:cryptographic-hash-function,
        ngm:elliptic-curve-cryptography .

