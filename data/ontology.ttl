    a owl:Restriction ;
    owl:onProperty ngm:relatedTo ;
    owl:someValuesFrom mv:Previsualization
] .

mv:VirtualProductionWorkflow rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:relatedTo ;
    owl:someValuesFrom mv:VirtualArtDepartment
] .

# Virtual Reality VR
mv:VirtualRealityVR a owl:Class ;
    rdfs:subClassOf mv:ExtendedReality ;
    rdfs:label "Virtual Reality VR"@en ;
    rdfs:comment "An immersive technology that uses head-mounted displays and motion tracking to create fully simulated 3D environments, enabling users to experience and interact with computer-generated worlds through visual, auditory, and haptic feedback while isolated from the physical environment."@en ;
    skos:prefLabel "Virtual Reality VR"@en ;
    dcterms:identifier "MV-10141" ;
    dcterms:subject "mv" .

mv:VirtualRealityVR rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:relatedTo ;
    owl:someValuesFrom mv:VRHeadset
] .

