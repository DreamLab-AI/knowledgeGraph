    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:anomaly-detection,
        ngm:pattern-recognition,
        ngm:predictive-analytics .

ngm:bitcoin-proof-of-work-protocol-script a owl:Class ;
    rdfs:label "Bitcoin Script"@en ;
    rdfs:comment "Bitcoin Script is a non-Turing-complete, stack-based scripting language embedded in every Bitcoin transaction that defines the conditions under which unspent transaction outputs (UTXOs) may be spent. It consists of a constrained set of opcodes operating on a last-in-first-out (LIFO) stack, deliberately designed without loops or unbounded recursion to ensure guaranteed termination and predictable resource consumption. Script programs are expressed as paired locking scripts (scriptPubKey) and unlocking scripts (scriptSig or SegWit witness data) that encode spending conditions including digital signature verification, multisignature requirements, hash pre-image revelation, and time locks. Standard output templates — P2PKH, P2SH, P2WPKH, P2WSH, and P2TR — formalise the most common spending patterns used across the Bitcoin network."@en ;
    rdfs:subClassOf ngm:scripting-language ;
    vc:bridgesTo ngm:formal-verification,
        ngm:zero-knowledge-proof ;
    vc:contrastsWith ngm:ethereum-virtual-machine,
        ngm:solidity,
        ngm:turing-complete-language ;
    vc:enables ngm:atomic-swap,
        ngm:bitcoin-covenant,
        ngm:bitcoin-proof-of-work-protocol-ordinals,
        ngm:hash-time-locked-contract,
        ngm:lightning-network,
        ngm:multisignature-wallet ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:scriptpubkey,
        ngm:scriptsig,
        ngm:witness-data ;
    vc:implements ngm:pay-to-public-key-hash,
        ngm:pay-to-script-hash,
        ngm:taproot ;
    vc:isPartOf ngm:bitcoin-proof-of-work-protocol-core,
        ngm:utxo-model ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:forth-programming-language,
        ngm:merklised-abstract-syntax-tree,
        ngm:segregated-witness ;
    vc:requires ngm:bitcoin-transaction,
        ngm:stack-machine ;
    vc:slug "bitcoin-script" ;
    vc:sourceDomain "blockchain" ;
    vc:standardizedBy ngm:bitcoin-improvement-proposal ;
    vc:uses ngm:cryptographic-hash-function,
        ngm:digital-signature,
        ngm:elliptic-curve-cryptography,
        ngm:opcodes,
        ngm:schnorr-signature .

ngm:bitcoin-proof-of-work-protocol-standard a owl:Class ;
    rdfs:label "Bitcoin Standard"@en ;
    rdfs:comment "The Bitcoin Standard is an economic and monetary thesis proposing that Bitcoin's algorithmically enforced fixed supply of 21 million units, its decentralised Proof of Work consensus mechanism, and its censorship-resistant disinflationary issuance schedule collectively make it a superior store of value and the basis for a new international monetary order analogous to the historical gold standard. Drawing heavily on Austrian economics — particularly Ludwig von Mises's concept of sound money and Saifedean Ammous's eponymous 2018 treatise — the thesis holds that Bitcoin's predictable, politically immutable monetary policy immunises it against the purchasing-power erosion endemic to fiat currencies managed by central banks. In practice the standard informs corporate treasury reserve strategies, nation-state legal-tender experiments, and the design of Bitcoin ETF and custody infrastructure."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:decentralisation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:blockchain ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptographic-security ],
        ngm:bc-token-and-asset ;
    skos:broader ngm:bc-token-and-asset ;
    vc:bridgesTo ngm:digital-asset-governance,
        ngm:macroeconomics ;
    vc:contrastsWith ngm:central-bank-digital-currency,
        ngm:fiat-currency,
        ngm:inflation ;
    vc:dependsOn ngm:network-effect,
        ngm:public-key-cryptography ;
    vc:enables ngm:bitcoin-etf,
        ngm:bitcoin-treasury-reserve,
        ngm:sovereign-bitcoin-adoption ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:austrian-economics,
        ngm:bitcoin-proof-of-work-protocol-as-money,
        ngm:bitcoin-proof-of-work-protocol-value-proposition,
        ngm:monetary-sovereignty,
        ngm:monetary-system,
        ngm:sound-money ;
    vc:requires ngm:blockchain,
        ngm:cryptographic-security,
        ngm:decentralisation ;
    vc:slug "bitcoin-standard" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:bitcoin-mining,
        ngm:cryptocurrency,
        ngm:halving,
        ngm:proof-of-work .

ngm:block-time a owl:Class ;
    rdfs:label "Block Time"@en ;
    rdfs:comment "Block Time is the average elapsed time between the creation of consecutive blocks on a blockchain, governed by the network's consensus mechanism and difficulty adjustment algorithm. Shorter block times increase transaction throughput and reduce confirmation latency but raise the risk of forks due to block propagation delays, creating a fundamental tradeoff between speed and chain security."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:block-propagation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:consensus-mechanism ],
        ngm:bc-protocol-and-consensus,
        ngm:blockchain-entity,
        ngm:distributed-data-structure ;
    skos:broader ngm:bc-protocol-and-consensus ;
    vc:contrastsWith ngm:blockchain-scalability ;
    vc:enables ngm:transaction-confirmation,
        ngm:transaction-finality ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:blockchain-protocol ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:block-height,
        ngm:block-size,
        ngm:blockchain-scalability,
        ngm:finality,
        ngm:mining ;
    vc:requires ngm:block-propagation,
        ngm:consensus-mechanism ;
    vc:slug "block-time" ;
    vc:sourceDomain "blockchain" .

ngm:blockchain-energy-consumption a owl:Class ;
    rdfs:label "Blockchain Energy Consumption"@en ;
    rdfs:comment "The electrical power and computational resources consumed by blockchain networks during transaction validation, block creation, and network security operations, varying significantly across consensus mechanisms from energy-intensive Proof-of-Work (Bitcoin: ~140 TWh/year, 0.65% of global electricity) to energy-efficient Proof-of-Stake (Ethereum post-Merge: 99.95% reduction), with ongoing research into sustainable consensus algorithms, renewable energy mining, carbon credit tokenization, and environmental impact measurement frameworks."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:hash-rate ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:e-waste ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:electricity-consumption ],
        ngm:bc-governance-and-regulation ;
    skos:broader ngm:bc-governance-and-regulation ;
    vc:bridgesTo ngm:ai-energy-optimisation,
        ngm:energy-sector,
        ngm:environmental-regulation,
        ngm:sustainability ;
    vc:contrastsWith ngm:directed-acyclic-graph,
        ngm:proof-of-stake ;
    vc:dependsOn ngm:consensus-mechanism,
