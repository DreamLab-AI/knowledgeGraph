        ngm:fraud-detection,
        ngm:regulatory-reporting ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:anti-money-laundering,
        ngm:fatf ;
    vc:requires ngm:aml-kyc-compliance,
        ngm:risk-assessment ;
    vc:slug "transaction-monitoring" ;
    vc:sourceDomain "finance" ;
    vc:uses ngm:behavioral-analytics,
