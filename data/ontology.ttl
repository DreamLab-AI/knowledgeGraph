        ngm:human-robot-collaboration,
        ngm:manufacturing-automation,
        ngm:warehouse-automation ;
    vc:hasPart ngm:bipedal-locomotion,
        ngm:dexterous-manipulation,
        ngm:onboard-compute,
        ngm:proprioceptive-sensing,
        ngm:series-elastic-actuator,
        ngm:tactile-sensing,
        ngm:vision-system,
        ngm:whole-body-control ;
    vc:implements ngm:model-predictive-control,
        ngm:reinforcement-learning,
        ngm:series-elastic-actuation,
        ngm:sim-to-real-transfer,
        ngm:vision-language-action-models,
        ngm:whole-body-control ;
    vc:maturity "established" ;
    vc:qualityScore "0.52"^^xsd:float ;
    vc:relatedTo ngm:agent-frameworks,
        ngm:agents,
        ngm:ai-adoption,
        ngm:ai-risks,
