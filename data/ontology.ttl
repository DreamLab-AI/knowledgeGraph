ngm:kinematic-element a owl:Class ;
    rdfs:label "Kinematic Element"@en ;
    rdfs:comment "A Kinematic Element is a rigid body or joint primitive within a robot's mechanical structure that participates in the forward and inverse kinematic chain, defining the positional and orientational degrees of freedom of a limb segment. Chains of kinematic elements model the geometry of robotic arms, legs, and manipulators for motion planning and control."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
