        ngm:telecollaboration ;
    vc:contrastsWith ngm:autonomous-mobile-robot,
        ngm:industrial-robot ;
    vc:enables ngm:agile-manufacturing,
        ngm:flexible-assembly,
        ngm:human-robot-collaboration,
        ngm:rapid-deployment,
        ngm:reduced-labour-costs ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:collision-detection-system,
        ngm:end-effector,
        ngm:force-torque-sensor,
        ngm:safety-controller ;
    vc:implements ngm:hand-guiding-mode,
        ngm:iso-10218-safety-standard ;
    vc:isPartOf ngm:collaborative-systems-modality-manufacturing-system ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:teleoperation ;
    vc:requires ngm:iso-ts-15066-compliance,
        ngm:power-and-force-limiting,
        ngm:speed-and-separation-monitoring ;
    vc:slug "collaborative-robot" ;
    vc:sourceDomain "robotics" ;
    vc:standardizedBy ngm:ieee-institute-of-electrical-and-electronics-engineers,
        ngm:iso-international-organization-for-standardization ;
    vc:uses ngm:machine-vision,
        ngm:robot-operating-system,
        ngm:sensor-fusion .

ngm:creator-economy a owl:Class ;
    rdfs:label "Creator Economy"@en ;
    rdfs:comment "Ecosystem enabling individuals and organizations to design, build, and monetize virtual content and experiences through digital marketplaces, tokenization, and economic incentive structures."@en ;
