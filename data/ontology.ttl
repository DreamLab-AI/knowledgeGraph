        ngm:scheduling ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:constraint-programming,
        ngm:constraint-satisfaction-problem,
        ngm:regularisation ;
    vc:implements ngm:answer-set-programming,
        ngm:combinatorial-optimisation,
        ngm:description-logic,
        ngm:integer-programming,
        ngm:linear-programming ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:arc-consistency,
        ngm:loss-function,
        ngm:markov-decision-process,
        ngm:model-checking,
        ngm:parameter,
        ngm:property,
        ngm:satisfiability,
        ngm:system,
        ngm:theorem-proving ;
