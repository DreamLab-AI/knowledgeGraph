        ngm:misinformation,
        ngm:synthetic-media ;
    vc:requires ngm:c2-pa-standard,
        ngm:content-authentication,
        ngm:metadata-standards,
        ngm:provenance-tracking ;
    vc:slug "ai-generated-content-disclosure" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:ai-investment a owl:Class ;
    rdfs:label "AI Investment"@en ;
    rdfs:comment "AI Investment is the allocation of capital toward artificial-intelligence research, talent, compute infrastructure, startups, and data assets in pursuit of strategic or financial returns. It spans venture funding, corporate capital expenditure on data centres and chips, sovereign wealth funds, public research grants, and hyperscaler balance-sheet commitments. The scale and concentration of this capital is a primary driver of competitive dynamics among firms and nations, with global AI corporate investment reaching $581 billion in 2025 and Q1 2026 venture activity alone surpassing that figure. Investment categories include frontier-model lab funding, compute infrastructure build-out, application-layer enterprise AI, and sovereign compute programmes. Returns are gated by access to scarce inputs — advanced semiconductor capacity, high-bandwidth memory, and specialised research talent — creating oligopolistic supply-side dynamics that shape long-run market structure."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cloud-infrastructure ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:venture-capital ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:training-data ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ai-chips ],
        ngm:capital-markets,
        ngm:economics ;
    vc:dependsOn ngm:geopolitics,
        ngm:regulatory-frameworks,
        ngm:semiconductor-industry ;
    vc:enables ngm:ai-sovereignty,
        ngm:economic-competitiveness,
        ngm:enterprise-ai-adoption,
        ngm:frontier-models,
        ngm:innovation-ecosystems ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:corporate-capital-expenditure,
        ngm:mega-round-financing,
        ngm:public-research-grants,
        ngm:sovereign-wealth-fund,
        ngm:venture-capital ;
    vc:implements ngm:export-controls,
        ngm:industrial-strategy,
        ngm:national-ai-strategies ;
    vc:qualityScore "0.88"^^xsd:float ;
    vc:relatedTo ngm:ai-chips,
        ngm:competition-in-ai,
        ngm:market-concentration,
        ngm:open-source-ai,
        ngm:talent-concentration ;
    vc:requires ngm:ai-chips,
        ngm:ai-research-talent,
        ngm:cloud-infrastructure,
        ngm:gpu-supply-chain,
        ngm:training-data ;
    vc:slug "ai-investment" ;
    vc:sourceDomain "economics" ;
    vc:supports ngm:ai-policy,
        ngm:ai-research-talent,
        ngm:compute-access .

ngm:ai-office a owl:Class ;
    rdfs:label "AI Office"@en ;
    rdfs:comment "European Commission body established under AI Act Articles 64–68 as the primary centre of AI expertise for a unified European AI governance system, holding executive authority for supervising general-purpose AI model providers, coordinating cross-border market surveillance, imposing corrective measures and fines, facilitating regulatory sandboxes, and representing the EU in international AI governance forums."@en ;
    rdfs:subClassOf ngm:ai-governance-and-ethics ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:enables ngm:ai-governance,
        ngm:ai-governance-framework ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:relatedTo ngm:ai-risk-management,
        ngm:general-purpose-ai-model ;
    vc:slug "ai-office" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:ai-board,
        ngm:eu-ai-act-regulatory-instrument .

ngm:aiops a owl:Class ;
    rdfs:label "AIOps"@en ;
    rdfs:comment "AIOps (Artificial Intelligence for IT Operations) applies machine learning, natural language processing, and big data analytics to automate and enhance IT operational tasks including event correlation, anomaly detection, root-cause analysis, incident management, and capacity planning. By continuously ingesting telemetry streams — logs, metrics, and traces — from complex distributed systems, AIOps platforms surface actionable insights that would be impossible for human operators to detect at scale, progressively shifting operations from reactive incident response towards predictive and autonomous self-healing."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:ai-incident ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:natural-language-processing ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:ai-monitoring ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-pipeline ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:machine-learning-discipline ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:anomaly-detection ],
        ngm:ai-infrastructure ;
    vc:enables ngm:operational-resilience,
        ngm:platform-engineering,
        ngm:workflow-automation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:ai-incident,
        ngm:ai-monitoring,
        ngm:anomaly-detection ;
