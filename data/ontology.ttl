ngm:dynamic-scalable-bft a owl:Class ;
    rdfs:label "Dynamic Scalable BFT"@en ;
    rdfs:comment "Dynamic Scalable BFT (DSBFT) is an optimised Byzantine fault-tolerant consensus protocol that combines Distributed Key Generation (DKG) with BLS aggregate signatures to allow a validator committee to reach consensus with O(n) rather than O(n²) message complexity, while supporting dynamic membership—nodes may join or leave the committee without requiring a full protocol restart or trusted dealer for key setup."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:consensus-mechanism ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:validator-node ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:key-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:byzantine-fault-tolerance ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:digital-signature ],
        ngm:bc-protocol-and-consensus,
        ngm:practical-byzantine-fault-tolerance ;
    skos:broader ngm:bc-protocol-and-consensus ;
    vc:enables ngm:blockchain-governance,
        ngm:blockchain-scalability,
        ngm:finality ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:consensus-mechanism,
        ngm:validator-node ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:blockchain-network,
        ngm:distributed-systems,
        ngm:fault-tolerance ;
    vc:requires ngm:byzantine-fault-tolerance,
        ngm:digital-signature,
        ngm:key-management ;
    vc:slug "dynamic-scalable-bft" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:consensus-algorithm,
        ngm:cryptographic-primitive .

