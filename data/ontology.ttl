# Sparql Query Engine
spatial-computing:SparqlQueryEngine rdf:type owl:Class ;
    rdfs:subClassOf spatial-computing:QueryProcessor ;
    rdfs:label "Sparql Query Engine"@en ;
    rdfs:comment "A processor implementing the SPARQL Protocol and RDF Query Language (W3C standard) for retrieving, manipulating, and joining data stored in Resource Description Framework graphs, enabling semantic web queries through pattern matching of subject-predicate-object triples with support for filtering, aggregation, and federated queries."@en ;
    skos:prefLabel "Sparql Query Engine"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:spatial-computing:sparql-query-engine" ;
