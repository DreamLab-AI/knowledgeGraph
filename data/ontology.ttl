    vc:slug "database-management-system" ;
    vc:sourceDomain "data" .
ngm:database-query a owl:Class ;
    rdfs:comment "A structured request submitted to a database management system to retrieve, insert, update, or delete data according to defined criteria. Queries are expressed in formal query languages such as SQL for relational databases or SPARQL for RDF triple stores, and underpin knowledge graph retrieval, analytics pipelines, and real-time application data access."@en ;
    rdfs:label "Database Query"@en ;
    rdfs:subClassOf ngm:data-management ;
