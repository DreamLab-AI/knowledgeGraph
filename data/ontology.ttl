ngm:bitcoin-proof-of-work-protocol-network a owl:Class ;
    rdfs:label "Bitcoin Network"@en ;
    rdfs:comment "The Bitcoin Network is the global, permissionless peer-to-peer infrastructure underpinning the Bitcoin cryptocurrency, comprising full nodes, mining nodes, and the gossip protocol that propagates signed transactions and mined blocks across the internet without central coordination. It employs the Nakamoto consensus mechanism—proof-of-work mining on the SHA-256 hash function—to achieve Byzantine-fault-tolerant agreement on a single shared transaction ledger among mutually distrusting participants. The network enforces deterministic monetary policy through its protocol rules, automatically adjusting mining difficulty every 2,016 blocks to target a ten-minute inter-block interval and capping total issuance at 21 million BTC via a geometric halving schedule. Launched in January 2009, it is the longest-continuously-operated public blockchain and the foundational reference implementation for decentralised digital value transfer."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:internet-protocol ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:bitcoin-proof-of-work-protocol-mining ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:mempool ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:bitcoin-script ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:distributed-ledger-technology ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:utxo-model ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:full-node ],
        ngm:peer-to-peer-network ;
    vc:bridgesTo ngm:central-bank-digital-currency,
        ngm:financial-infrastructure ;
    vc:contrastsWith ngm:ethereum,
        ngm:proof-of-stake ;
    vc:dependsOn ngm:merkle-tree,
        ngm:public-key-cryptography ;
    vc:enables ngm:cryptocurrency,
        ngm:decentralised-finance,
        ngm:digital-asset-custody,
        ngm:lightning-network ;
    vc:hasMaturity ngmi:maturity-draft ;
