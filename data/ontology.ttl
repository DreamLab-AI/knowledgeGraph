            owl:someValuesFrom ngm:compliance-monitoring ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:anti-money-laundering ],
        ngm:aml-kyc-compliance,
        ngm:bc-governance-and-regulation ;
