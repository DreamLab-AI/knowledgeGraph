vf:web3 a owl:Class ;
    rdfs:label "Web3"@en ;
    rdfs:comment "Web3 is a blockchain-anchored paradigm for the decentralised web, first coined by Ethereum co-founder Gavin Wood in his April 2014 essay \"DApps: What Web 3.0 Looks Like\", that reconceives the internet as a zero-trust interaction system eliminating the need to trust any individual institution or platform. It assembles four architectural primitives: (1) trustless static content publication via content-addressed storage (IPFS, Filecoin), (2) a pseudonymous low-level messaging layer (Whisper / Waku), (3) a consensus engine executing programmable smart contracts on public blockchains (primarily Ethereum), and (4) an integrated user interface bridging browser-native wallets to on-chain state—together enabling a \"read-write-own\" internet where users hold cryptographic keys to their own assets, identity, and data rather than delegating custody to centralised intermediaries. The dominant execution layer is Ethereum and its growing ecosystem of Layer 2 rollups (Arbitrum, Optimism, Base, zkSync); beyond the Ethereum stack, alternative ecosystems include Solana (high-throughput single-chain), Polkadot (Gavin Wood's substrate-based parachain relay), Cosmos (IBC interoperability), and Bitcoin's "@en ;
    rdfs:subClassOf <urn:visionflow:linked:decentralised-finance>,
        vf:blockchain-network,
        vf:digital-asset,
        vf:distributed-systems,
        vf:peer-to-peer-network ;
    vc:authorityScore "0.87"^^xsd:float ;
    vc:enables <urn:visionflow:linked:decentralised-finance>,
        <urn:visionflow:linked:decentralised-identity>,
        <urn:visionflow:linked:digital-sovereignty>,
        <urn:visionflow:linked:on-chain-governance>,
        vf:agentic-internet,
        vf:tokenisation ;
    vc:hasPart <urn:visionflow:linked:crypto-wallet>,
        <urn:visionflow:linked:decentralised-application>,
        <urn:visionflow:linked:dex>,
        <urn:visionflow:linked:ens>,
        <urn:visionflow:linked:ipfs>,
        <urn:visionflow:linked:nft>,
        <urn:visionflow:linked:restaking>,
        vf:account-abstraction,
        vf:dao,
        vf:smart-contract ;
    vc:implements <urn:visionflow:linked:eip-4361>,
        <urn:visionflow:linked:eip-7702>,
        <urn:visionflow:linked:ens>,
        <urn:visionflow:linked:erc-4337>,
        <urn:visionflow:linked:ipfs>,
        <urn:visionflow:linked:w3-c-did> ;
    vc:maturity "production-ready" ;
    vc:qualityScore "0.52"^^xsd:float ;
    vc:requires <urn:visionflow:linked:content-addressed-storage>,
        vf:consensus-mechanism,
        vf:digital-identity,
        vf:ethereum,
        vf:public-key-cryptography,
        vf:smart-contract ;
    vc:slug "web3" ;
    vc:sourceDomain "blockchain" .

