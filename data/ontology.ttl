ngm:clarity a owl:Class ;
    rdfs:label "Clarity"@en ;
    rdfs:comment "Clarity is a decidable smart contract language designed so that contract behaviour can be analysed before execution, with no compilation step and explicit handling of conditions that could otherwise fail silently."@en ;
