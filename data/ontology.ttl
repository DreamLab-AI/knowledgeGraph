ngm:rb-0012-wheeled-mobile-robot a owl:Class ;
    rdfs:label "rb 0012 wheeled mobile robot"@en ;
    rdfs:comment "A wheeled mobile robot (WMR) is a ground-based autonomous or semi-autonomous robot that uses wheels for locomotion. WMRs range from differential-drive platforms to omnidirectional holonomic designs; they rely on odometry for dead-reckoning, SLAM for map building, and path-planning algorithms for autonomous navigation in structured or semi-structured environments."@en ;
    rdfs:subClassOf ngm:mobile-robot,
        ngm:robo-robot-type ;
    skos:broader ngm:robo-robot-type ;
    vc:dependsOn ngm:autonomous-navigation,
        ngm:path-planning ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:differential-drive-robot,
        ngm:mobile-robot-platform,
        ngm:wheeled-mobile-robot ;
    vc:slug "rb-0012-wheeled-mobile-robot" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:odometry,
        ngm:rb-0075-range-finder,
        ngm:slam .

ngm:rb-0027-robot-link a owl:Class ;
    rdfs:label "rb 0027 robot link"@en ;
    rdfs:comment "A robot link is a rigid (or semi-rigid) structural body that forms one segment of a robot's kinematic chain, connecting adjacent joints and transmitting forces and torques between them. Links define the geometry of the robot's workspace by their length, mass, and inertial properties, and together with joints they constitute the Denavit-Hartenberg representation used in forward and inverse kinematics. Link stiffness, material choice, and mass distribution directly affect dynamic performance, vibration characteristics, and safety in human-robot interaction."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:robot-joint ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:robot-link ],
        ngm:robo-actuation-and-control,
        ngm:robot ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:robot-joint,
        ngm:robot-link ;
    vc:isPartOf ngm:robot,
        ngm:robot-kinematics ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:inertia,
        ngm:kinematics,
        ngm:rb-0039-stiffness,
        ngm:rigid-body ;
    vc:slug "rb-0027-robot-link" ;
    vc:sourceDomain "robotics" .

ngm:rb-0033-payload a owl:Class ;
    rdfs:label "rb 0033 payload"@en ;
    rdfs:comment "Payload in robotics refers to the maximum mass that a robot can carry or manipulate while maintaining its specified performance characteristics, including accuracy, repeatability, and speed. Payload capacity is a fundamental design parameter for robot arms, mobile robots, and drones, directly constraining the tools, parts, or cargo the robot can handle. It is typically quoted at the wrist or end-effector mounting face and may vary with configuration and speed; dynamic payload accounts for inertial forces during acceleration."@en ;
    rdfs:subClassOf ngm:robo-actuation-and-control,
        ngm:robot ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:dependsOn ngm:rb-0022-robot-dynamics,
        ngm:rb-0039-stiffness ;
    vc:enables ngm:end-effector ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:robot ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:rb-0034-repeatability,
        ngm:rb-0035-accuracy,
        ngm:rb-0041-inertia,
        ngm:rb-0043-torque ;
    vc:slug "rb-0033-payload" ;
    vc:sourceDomain "robotics" .

ngm:rb-0040-backlash a owl:Class ;
    rdfs:label "rb 0040 backlash"@en ;
    rdfs:comment "Backlash in robotics is the lost motion in a mechanical transmission — the angular or linear displacement of the output element when the input reverses direction without producing corresponding output movement, caused by clearance gaps between mating gear teeth or other drive components. Backlash degrades positional accuracy and repeatability, introduces nonlinearity into the control loop, and can cause oscillation or chattering in feedback control systems. Minimising backlash is critical for precision robot joints, and it is typically reduced through the use of preloaded gear pairs, harmonic drives, or cycloidal transmissions."@en ;
    rdfs:subClassOf ngm:backlash,
        ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:contrastsWith ngm:rb-0034-repeatability,
        ngm:rb-0035-accuracy ;
    vc:dependsOn ngm:actuator ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:rb-0026-robot-joint,
        ngm:rb-0038-compliance,
        ngm:rb-0039-stiffness,
        ngm:rb-0043-torque,
        ngm:rb-0047-feedback-control ;
    vc:slug "rb-0040-backlash" ;
    vc:sourceDomain "robotics" .

ngm:rb-0073-imu a owl:Class ;
    rdfs:label "rb 0073 imu"@en ;
    rdfs:comment "An Inertial Measurement Unit (IMU) is an electronic device that measures and reports a body's specific force, angular rate, and sometimes magnetic field using a combination of accelerometers, gyroscopes, and optional magnetometers. In robotics, IMUs provide high-frequency proprioceptive feedback for state estimation, pose tracking, and stabilisation control, and are commonly fused with odometry or SLAM algorithms to reduce drift."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:gyroscope ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:accelerometer ],
        ngm:inertial-measurement-unit,
        ngm:robo-perception ;
    skos:broader ngm:robo-perception ;
    vc:enables ngm:localization,
        ngm:odometry,
        ngm:state-estimation ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:accelerometer,
        ngm:gyroscope ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:rb-0066-robot-sensor,
        ngm:rb-0072-encoder,
        ngm:sensor-fusion,
        ngm:slam ;
    vc:slug "rb-0073-imu" ;
    vc:sourceDomain "robotics" ;
    vc:supports ngm:autonomous-navigation .

ngm:rb-0078-infrared-sensor a owl:Class ;
    rdfs:label "rb 0078 infrared sensor"@en ;
    rdfs:comment "An infrared (IR) sensor is an exteroceptive sensor that detects and measures infrared radiation emitted or reflected by objects in the environment, enabling proximity detection, thermal profiling, and obstacle identification in robotic systems. IR sensors operate across near-infrared (NIR), short-wave, mid-wave, and long-wave bands; common robotics applications include proximity switches, line-following, and thermal imaging for human detection. They complement other ranging sensors such as LiDAR and ultrasonic devices, and are frequently fused in multi-modal perception pipelines."@en ;
    rdfs:subClassOf ngm:robo-perception ;
    skos:broader ngm:robo-perception ;
    vc:bridgesTo ngm:sensor ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:infrared-sensor,
        ngm:proximity-sensor,
        ngm:rb-0066-robot-sensor,
        ngm:rb-0069-lidar,
        ngm:rb-0075-range-finder ;
    vc:slug "rb-0078-infrared-sensor" ;
    vc:sourceDomain "robotics" ;
    vc:supports ngm:rb-0052-collision-avoidance,
        ngm:rb-0095-safety-zone ;
    vc:uses ngm:exteroceptive-sensor,
        ngm:sensor-fusion .

ngm:rb-1007-trajectory-generation a owl:Class ;
    rdfs:label "RB-1007-trajectory-generation"@en ;
    rdfs:comment "RB-1007 Trajectory Generation is a robotics knowledge-base entry cataloguing the algorithms, mathematical representations, and computational methods used to synthesise smooth, dynamically feasible motion trajectories for robotic systems, specifying how a robot must move through configuration space or task space from an initial to a goal state while satisfying kinematic, dynamic, and environmental constraints. It covers polynomial spline interpolation, time-optimal trajectory planning, jerk-limited profiles, and learned trajectory generation approaches, forming the bridge between high-level task planning and low-level joint control execution."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:inverse-kinematics ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:kinematics ],
        ngm:trajectory-generation ;
    vc:enables ngm:autonomous-navigation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:rb-0051-trajectory-planning,
        ngm:trajectory-control,
        ngm:trajectory-planning ;
    vc:requires ngm:inverse-kinematics,
        ngm:kinematics ;
    vc:slug "rb-1007-trajectory-generation" ;
    vc:sourceDomain "robotics" ;
    vc:supports ngm:motion-control,
        ngm:motion-planning .

ngm:rb-1008-odometry a owl:Class ;
    rdfs:label "RB-1008-odometry"@en ;
    rdfs:comment "RB-1008-odometry refers to the odometric positioning subsystem of the RB-1008 wheeled mobile robot platform, encompassing the encoder-based wheel odometry algorithms, sensor fusion pipelines, and ROS navigation stack integration used to estimate the robot's pose (position and orientation) relative to a starting frame. The system computes incremental displacement from differential or omnidirectional wheel encoders, corrects for wheel slip and encoder quantisation errors, and fuses encoder data with inertial measurement unit (IMU) readings to produce a continuous odometric estimate used as the prior for simultaneous localisation and mapping (SLAM) and autonomous navigation. Accurate odometry is essential for maintaining coherent map frames and for the navigation stack's local cost-map updates between LIDAR scan matches."@en ;
    rdfs:subClassOf ngm:odometry ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:mobile-robot-platform,
        ngm:wheeled-mobile-robot ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:autonomous-navigation,
        ngm:localization,
        ngm:visual-odometry ;
    vc:slug "rb-1008-odometry" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:ros-navigation-stack,
        ngm:sensor-fusion,
        ngm:slam .

ngm:reactive-programming a skos:Concept ;
    rdfs:label "Reactive Programming"@en .

ngm:read-receipts a owl:Class ;
    rdfs:label "Read Receipts"@en ;
    rdfs:comment "Read receipts are delivery-confirmation signals that indicate whether a message has been seen by its recipient, typically displayed as a checkmark, avatar, or timestamp. They provide senders with visibility into message consumption, reducing uncertainty in asynchronous communication. Their use in distributed collaboration can improve follow-up timing but must be balanced against recipient privacy expectations."@en ;
    rdfs:subClassOf ngm:dc-communication ;
    skos:broader ngm:dc-communication ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:instant-messaging,
        ngm:typing-indicators ;
    vc:slug "read-receipts" ;
    vc:sourceDomain "distributed-collaboration" .

ngm:ready-player-me a owl:Class ;
    rdfs:label "Ready Player Me"@en ;
    rdfs:comment "Ready Player Me (RPM) is a cross-application avatar platform that enables users to create a single personalised 3D humanoid avatar and deploy it across hundreds of games, social VR environments, and virtual worlds via an open SDK and REST API. Founded in 2021 by Wolf3D, it provides a browser-based avatar creator, glTF-compliant avatar meshes, morph-target facial animation, and an OAuth-based identity layer so that the same avatar persona persists across compatible applications. By decoupling avatar creation from any single platform, RPM acts as a shared identity infrastructure for the emerging spatial internet, addressing avatar fragmentation across [[Metaverse]] ecosystems."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:oauth ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:avatar ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gltf-standard ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:rest-api ],
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:bridgesTo ngm:digital-twin,
        ngm:nft,
        ngm:self-sovereign-identity ;
    vc:dependsOn ngm:cloud-storage,
        ngm:digital-identity ;
    vc:enables ngm:avatar-interoperability,
        ngm:cross-platform-identity,
        ngm:social-vr ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:avatar ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:open-metaverse-interoperability ;
    vc:requires ngm:gltf-standard,
        ngm:oauth,
        ngm:rest-api ;
    vc:slug "ready-player-me" ;
    vc:sourceDomain "metaverse" ;
    vc:supports ngm:augmented-reality,
        ngm:metaverse,
        ngm:virtual-reality ;
    vc:uses ngm:3-d-scanning,
        ngm:facial-recognition,
        ngm:physically-based-rendering,
        ngm:skeletal-animation .

ngm:real-esrgan a owl:Class ;
    rdfs:label "Real-ESRGAN"@en ;
    rdfs:comment "Real-ESRGAN is an image super-resolution model that upscales and restores low-quality images, with particular attention to real-world degradations. It extends the ESRGAN architecture using a generative adversarial network trained on synthetic degradation data."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:generative-adversarial-network ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:convolutional-neural-network ],
        ngm:generative-adversarial-network ;
    vc:enables ngm:image-generation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:convolutional-neural-network,
        ngm:generative-adversarial-network ;
    vc:slug "real-esrgan" ;
    vc:sourceDomain "ai" .

