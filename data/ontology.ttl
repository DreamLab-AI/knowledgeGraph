ngm:global-digital-finance a owl:Class ;
    rdfs:label "Global Digital Finance"@en ;
    rdfs:comment "Global Digital Finance (GDF) is an industry membership association and self-regulatory organisation founded to develop voluntary codes of conduct, taxonomies, and governance frameworks for the digital asset and cryptocurrency sector. It convenes cross-sector working groups that produce best-practice guidance on topics such as crypto asset taxonomy, market conduct, custody, and consumer protection, while engaging with regulators, standards bodies, and central banks to inform policy. GDF acts as a liaison body between industry participants and public authorities including the Financial Stability Board, IOSCO, and national financial regulators, promoting responsible adoption of blockchain-based financial instruments. Its outputs serve as voluntary soft-law standards intended to accelerate convergence toward enforceable regulatory frameworks."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:digital-asset ],
        ngm:standards-body ;
    vc:bridgesTo ngm:central-bank-digital-currency,
        ngm:decentralised-finance ;
    vc:contrastsWith ngm:centralised-finance ;
    vc:dependsOn ngm:blockchain,
        ngm:distributed-ledger-technology ;
    vc:enables ngm:cryptocurrency,
        ngm:regulatory-compliance,
        ngm:self-regulation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:code-of-conduct ;
    vc:isPartOf ngm:digital-asset-governance ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:anti-money-laundering,
        ngm:know-your-customer,
        ngm:stablecoin,
        ngm:token-economy ;
    vc:requires ngm:digital-asset ;
    vc:slug "global-digital-finance" ;
    vc:sourceDomain "blockchain" ;
    vc:standardizedBy ngm:financial-stability-board,
        ngm:iosco ;
    vc:supports ngm:consumer-protection,
        ngm:digital-asset-regulation,
        ngm:market-integrity .

ngm:global-localisation a owl:Class ;
    rdfs:label "Global Localisation"@en ;
    rdfs:comment "Global localisation is the problem of estimating a robot's pose within a known map without any prior knowledge of its starting position, often called the kidnapped-robot problem. Unlike pose tracking, it must resolve ambiguity across the entire map, typically by maintaining and refining multiple pose hypotheses from sensor observations. It is fundamental to robot navigation, autonomous vehicles, and recovery from localisation failures."@en ;
    rdfs:subClassOf ngm:robo-navigation-and-planning ;
    skos:broader ngm:robo-navigation-and-planning ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:gps,
        ngm:particle-filter ;
    vc:slug "global-localisation" ;
    vc:sourceDomain "robotics" .

