    vc:slug "sovereign-keyset" ;
    vc:sourceDomain "blockchain" .

ngm:spatial-ai-associate a owl:Class ;
    rdfs:label "Spatial AI Associate"@en ;
    rdfs:comment "A Spatial AI Associate is an AI-powered assistant role or software agent embedded within spatial computing and extended reality environments, responsible for contextual scene understanding, user intent interpretation, and proactive spatial guidance. It combines computer vision, SLAM-derived spatial maps, and large language model reasoning to deliver situated, location-aware assistance within physical or mixed-reality spaces."@en ;
    rdfs:subClassOf ngm:ai-application ;
    skos:broader ngm:ai-application ;
    vc:enables ngm:augmented-reality,
        ngm:extended-reality ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:spatial-computing ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:scene-management ;
    vc:slug "spatial-ai-associate" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:sensor-technology,
        ngm:slam,
        ngm:spatial-ai .

ngm:spatial-audio-scene-description a owl:Class ;
    rdfs:label "Spatial Audio Scene Description"@en ;
    rdfs:comment "A data model for encoding sound sources, listener positions, acoustic environments, and spatial audio metadata in three-dimensional space to enable immersive and realistic audio experiences in virtual environments."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:spatial-audio-processor ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:rendering-engine ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:spatial-metadata ],
        ngm:sc-standards-and-interop ;
    skos:broader ngm:sc-standards-and-interop ;
    vc:enables ngm:acoustic-realism,
        ngm:ambisonics-playback,
        ngm:binaural-rendering,
        ngm:dynamic-audio-mixing,
        ngm:object-based-audio ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:acoustic-properties,
        ngm:ambisonics-representation,
        ngm:audio-object,
        ngm:listener-position,
        ngm:sound-source-position,
        ngm:spatial-metadata ;
    vc:isPartOf ngm:3-d-scene-graph,
