        ngm:predictive-personalization ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:information-retrieval,
        ngm:natural-language-processing,
        ngm:social-media-platform-infrastructure,
        ngm:video-streaming ;
    vc:requires ngm:ab-testing,
        ngm:feature-engineering,
        ngm:user-behaviour-data ;
    vc:slug "recommendation-system" ;
    vc:sourceDomain "machine-learning" ;
    vc:uses ngm:approximate-nearest-neighbour-search,
        ngm:collaborative-systems-modality-filtering,
        ngm:deep-learning,
        ngm:embeddings,
        ngm:graph-neural-network,
        ngm:matrix-factorisation,
        ngm:reinforcement-learning,
        ngm:transformer-architecture .

ngm:robotic-process-automation a owl:Class ;
    rdfs:label "Robotic Process Automation"@en ;
    rdfs:comment "Robotic Process Automation (RPA) is a software technology that deploys configurable software robots to emulate human interactions with digital systems — clicking, typing, copy-pasting data, and navigating graphical user interfaces — in order to execute repetitive, rule-based business processes without modifying underlying applications. RPA robots operate at the presentation layer, integrating with legacy systems through their UI rather than through APIs, and are managed by an orchestration platform that schedules work items, monitors execution, handles exceptions, and maintains audit trails. Modern RPA platforms increasingly incorporate AI capabilities such as optical character recognition, natural language processing, and machine learning to extend automation to semi-structured and unstructured data, giving rise to the broader discipline of intelligent automation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:optical-character-recognition ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:workflow-automation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:business-process-management ],
        ngm:process-automation ;
    vc:bridgesTo ngm:large-language-models,
        ngm:machine-learning ;
    vc:contrastsWith ngm:ai-agents,
        ngm:api-integration,
        ngm:business-process-automation ;
    vc:enables ngm:digital-transformation,
        ngm:enterprise-automation,
        ngm:hyperautomation,
        ngm:intelligent-automation ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:attended-automation,
        ngm:bot-orchestration,
        ngm:unattended-automation ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:document-processing,
        ngm:enterprise-resource-planning,
        ngm:task-automation ;
    vc:requires ngm:business-process-management,
        ngm:optical-character-recognition,
        ngm:workflow-automation ;
    vc:slug "robotic-process-automation" ;
    vc:sourceDomain "ai" ;
    vc:standardizedBy ngm:ieee-standards ;
    vc:uses ngm:computer-vision,
        ngm:low-code-development,
        ngm:natural-language-processing,
        ngm:process-mining,
        ngm:workflow-automation .

ngm:sanctions-screening a owl:Class ;
    rdfs:label "Sanctions Screening"@en ;
    rdfs:comment "Sanctions Screening is the regulatory compliance process by which financial institutions, fintech operators, and other regulated entities check customers, counterparties, and transactions against government-issued sanctions lists—such as those maintained by OFAC, the UN Security Council, HM Treasury, and the EU—to prevent prohibited dealings with designated individuals, entities, and jurisdictions. The process involves name-matching algorithms, fuzzy logic to handle transliterations and aliases, and risk-based escalation procedures for potential matches. In blockchain and digital asset contexts, screening extends to wallet addresses and on-chain transaction flows. Failure to screen adequately exposes institutions to severe civil and criminal penalties."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:audit-trail ],
        ngm:regulatory-compliance ;
    vc:bridgesTo ngm:blockchain-analytics,
        ngm:decentralised-finance ;
    vc:contrastsWith ngm:transaction-monitoring ;
    vc:dependsOn ngm:identity-verification,
        ngm:sanctions-list ;
    vc:enables ngm:compliance-monitoring,
        ngm:risk-based-approach,
        ngm:sanctions-enforcement ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:alert-adjudication,
        ngm:name-matching-algorithm,
        ngm:watchlist-management ;
    vc:isPartOf ngm:aml-kyc-compliance,
        ngm:financial-crime-compliance ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:anti-money-laundering,
        ngm:correspondent-banking,
        ngm:know-your-customer ;
    vc:requires ngm:audit-trail,
        ngm:customer-due-diligence,
        ngm:real-time-data-feed ;
    vc:slug "sanctions-screening" ;
    vc:sourceDomain "finance" ;
    vc:standardizedBy ngm:fatf,
        ngm:financial-regulation ;
    vc:uses ngm:blockchain-compliance,
        ngm:fraud-detection,
        ngm:fuzzy-matching,
        ngm:machine-learning-classifier .

ngm:scope-3-emissions a owl:Class ;
    rdfs:label "Scope 3 Emissions"@en ;
    rdfs:comment "Scope 3 emissions are the indirect greenhouse gas (GHG) emissions that occur across an organisation's value chain as a consequence of its activities but outside its operational boundary, encompassing both upstream sources such as purchased goods and services, capital goods, and business travel, and downstream sources such as the use and end-of-life treatment of sold products. Defined under Category 3 of the GHG Protocol Corporate Standard, Scope 3 emissions typically constitute the largest share of a company's total carbon footprint — often exceeding 70 percent — making their measurement, reporting, and reduction critical to credible corporate climate strategies. Accurate Scope 3 accounting requires collaboration across supply chains and the use of spend-based, activity-based, or supplier-specific emission factors."@en ;
    rdfs:subClassOf ngm:carbon-accounting ;
    vc:bridgesTo ngm:blockchain-provenance-tracking,
        ngm:digital-product-passport,
        ngm:supply-chain-analytics ;
    vc:contrastsWith ngm:scope-1-emissions,
        ngm:scope-2-emissions ;
    vc:enables ngm:esg-reporting,
        ngm:net-zero-commitments,
        ngm:supplier-decarbonisation,
        ngm:sustainability-reporting ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:corporate-climate-strategy,
        ngm:embodied-carbon,
        ngm:financed-emissions,
        ngm:ghg-protocol,
        ngm:scope-1-emissions,
        ngm:scope-2-emissions,
        ngm:supply-chain ;
    vc:requires ngm:supplier-data-collection,
        ngm:value-chain-transparency ;
    vc:slug "scope-3-emissions" ;
    vc:sourceDomain "supply-chain" ;
    vc:standardizedBy ngm:corporate-sustainability-reporting-directive,
        ngm:ghg-protocol-scope-3-standard,
        ngm:ifrs-s2 ;
    vc:uses ngm:activity-based-costing,
        ngm:emission-factors,
        ngm:environmental-accounting,
        ngm:life-cycle-assessment,
        ngm:spend-based-method .

ngm:sensor-data a owl:Class ;
    rdfs:label "Sensor Data"@en ;
    rdfs:comment "Sensor data comprises the raw or pre-processed digital measurements produced by physical transducers—including cameras, LiDAR scanners, inertial measurement units (IMUs), ultrasonic rangers, and microphones—that encode observable properties of the environment such as geometry, colour, acceleration, and sound. In robotic, autonomous, and spatial computing systems, sensor data forms the primary input to perception pipelines responsible for state estimation, object detection, and scene understanding. Data quality characteristics—including frame rate, resolution, noise floor, and synchronisation latency—directly constrain the capabilities of downstream algorithms such as SLAM, sensor fusion, and learned perception models. Sensor data is collected, timestamped, and transmitted through data acquisition systems before being processed through calibration, fusion, and inference stages to produce actionable world representations."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:sensor-calibration ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
