        ngm:emotional-immersion,
        ngm:immersive-experience ;
    vc:slug "psychological-phenomenon" ;
    vc:sourceDomain "spatial-computing" .

ngm:pyodide-knowledge-graph-node-enumerator a owl:Class ;
