ngm:consen-sys a owl:Class ;
    rdfs:label "ConsenSys"@en ;
    rdfs:comment "ConsenSys is a Brooklyn-founded blockchain software company, established in 2014 by Ethereum co-founder Joseph Lubin, that builds developer tooling, infrastructure, and end-user products for the Ethereum ecosystem. Its product portfolio spans the MetaMask browser wallet, the Infura node-as-a-service API network, the Truffle and Hardhat-adjacent development suite, and the Linea zkEVM Layer 2 network. ConsenSys acts as a principal driver of Ethereum protocol adoption by providing the production-grade infrastructure on which the majority of decentralised application front-ends depend. The company also engages in enterprise blockchain consulting and contributes to Ethereum standards through active participation in the Ethereum Foundation and EIP processes."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ethereum ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:proof-of-stake ],
        ngm:bc-network-component ;
    skos:broader ngm:bc-network-component ;
    vc:bridgesTo ngm:digital-asset-custody,
        ngm:enterprise-blockchain ;
    vc:contrastsWith ngm:alchemy,
        ngm:coinbase ;
    vc:enables ngm:decentralised-application,
        ngm:decentralised-finance,
        ngm:web3 ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:infura,
        ngm:linea,
        ngm:metamask,
        ngm:truffle-suite ;
    vc:implements ngm:ethereum-improvement-proposal,
        ngm:zk-rollup ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:blockchain-software-company,
        ngm:ethereum-foundation,
        ngm:layer-2-scaling,
        ngm:token-standard ;
    vc:requires ngm:ethereum,
        ngm:proof-of-stake ;
    vc:slug "consen-sys" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:decentralised-identity,
        ngm:ethereum-virtual-machine,
        ngm:non-fungible-token ;
    vc:uses ngm:json-rpc,
        ngm:smart-contract,
        ngm:solidity .

