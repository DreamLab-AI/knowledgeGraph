ngm:collaboration-platform a owl:Class ;
    rdfs:label "Collaboration Platform"@en ;
    rdfs:comment "A Collaboration Platform is an integrated software environment that unifies communication channels, shared workspaces, workflow automation, and content management tooling to enable coordinated work among distributed teams. Such platforms expose API-first architectures built atop real-time messaging protocols, WebRTC-based media pipelines, and cloud storage with conflict resolution, providing a composable substrate for synchronous and asynchronous teamwork. Enterprise-grade deployments layer in identity federation, data residency controls, compliance archiving, and extensible integration ecosystems, while modern platforms increasingly embed AI-driven capabilities such as meeting transcription, action-item extraction, and intelligent search. The category spans lightweight messaging tools through full unified-communications suites and extends into spatial and immersive collaboration modalities."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:workflow-automation ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:video-conferencing ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:identity-and-access-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cloud-storage ],
        ngm:distributed-systems ;
    vc:bridgesTo ngm:ai-assistant,
        ngm:digital-twin,
        ngm:metaverse-and-telecollaboration ;
    vc:contrastsWith ngm:email-system,
        ngm:point-to-point-communication ;
    vc:enables ngm:augmented-reality-collaboration,
        ngm:digital-twin-collaboration,
        ngm:distributed-team-coordination,
        ngm:remote-work ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:real-time-messaging,
        ngm:shared-document-editing,
        ngm:video-conferencing,
        ngm:workflow-automation ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:enterprise-resource-planning,
        ngm:social-network,
        ngm:xr-meeting-space ;
    vc:requires ngm:cloud-storage,
        ngm:identity-and-access-management,
        ngm:webrtc ;
    vc:slug "collaboration-platform" ;
    vc:sourceDomain "distributed-collaboration" ;
    vc:supports ngm:compliance-and-governance,
        ngm:enterprise-security,
        ngm:knowledge-management ;
    vc:uses ngm:api-gateway,
        ngm:edge-computing,
        ngm:end-to-end-encryption,
        ngm:microservices-architecture .

ngm:constitutional-ai-training-methodology a owl:Class ;
    rdfs:label "Constitutional AI Training Methodology"@en ;
    rdfs:comment "A method for training AI assistants to be harmless through self-improvement, using a set of principles or \"constitution\" to guide behaviour without human labels for harmful outputs. Constitutional AI combines supervised learning for self-critiques and revisions with Reinforcement Learning from AI Feedback (RLAIF), producing models that are helpful, harmless, and honest at scale."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:chain-of-thought-reasoning ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:reinforcement-learning ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:supervised-fine-tuning ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:large-language-models ],
        ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:bridgesTo ngm:ai-regulation,
        ngm:legal-ai-compliance ;
    vc:contrastsWith ngm:reinforcement-learning-from-human-feedback,
        ngm:supervised-learning-from-human-feedback ;
    vc:dependsOn ngm:instruction-following,
        ngm:proximal-policy-optimisation ;
    vc:enables ngm:ai-alignment,
        ngm:ai-safety,
        ngm:harmlessness,
        ngm:scalable-oversight ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:preference-model,
        ngm:reinforcement-learning-from-ai-feedback,
        ngm:self-critique-and-revision,
