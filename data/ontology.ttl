        ngm:yield-farming ;
    vc:requires ngm:liquidity,
        ngm:order-book ;
    vc:slug "arbitrage" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:decentralized-finance,
        ngm:digital-asset-trading ;
    vc:uses ngm:decentralized-exchange,
        ngm:dex,
        ngm:flash-loan .

