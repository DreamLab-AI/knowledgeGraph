ngm:metaverse-content-pipeline a owl:Class ;
    rdfs:label "Metaverse Content Pipeline"@en ;
    rdfs:comment "End-to-end workflow connecting asset creation, optimization, storage, distribution, and real-time rendering for metaverse experiences across platforms."@en ;
