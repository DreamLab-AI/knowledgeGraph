    vc:slug "marine-robot" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:autonomous-navigation,
        ngm:pressure-sensor,
        ngm:sensor-fusion,
        ngm:slam .

ngm:marker-based-tracking a owl:Class ;
    rdfs:label "Marker Based Tracking"@en ;
    rdfs:comment "AR and VR tracking technique that uses predefined visual patterns such as QR codes, April tags, ArUco markers, and fiducial markers to determine device position and orientation for accurate digital content overlay."@en ;
