ngm:retrieval-augmented-generation a owl:Class ;
    rdfs:label "Retrieval-Augmented Generation"@en ;
    rdfs:comment "Retrieval-Augmented Generation (RAG) is an AI inference architecture that augments large language model generation by dynamically retrieving semantically relevant passages from an external knowledge store at query time, concatenating them into the model context window before the response is produced. A retriever component—typically a dense bi-encoder backed by a vector database—embeds both the query and document corpus into a shared latent space and selects the top-k most similar chunks via approximate nearest-neighbour search. This non-parametric memory mechanism decouples factual knowledge from frozen model weights, dramatically reducing hallucination rates, enabling post-deployment knowledge updates without retraining, and providing fine-grained source attribution for generated claims. RAG has become the dominant architectural pattern for enterprise knowledge-intensive natural language processing applications, including question answering, customer support, legal research, and medical information retrieval."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:vector-database ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:embedding-model ],
        ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:bridgesTo ngm:enterprise-search,
        ngm:knowledge-management ;
    vc:contrastsWith ngm:fine-tuning,
        ngm:model-pretraining,
        ngm:parametric-knowledge ;
    vc:enables ngm:hallucination-mitigation,
        ngm:knowledge-grounding,
        ngm:question-answering,
        ngm:semantic-search,
        ngm:source-attribution ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:context-window-management,
        ngm:reader-component,
        ngm:retriever-component ;
    vc:qualityScore "0.76"^^xsd:float ;
    vc:relatedTo ngm:agentic-ai,
        ngm:ai-inference-architecture,
        ngm:information-retrieval,
        ngm:knowledge-graph,
        ngm:natural-language-processing,
        ngm:prompt-engineering ;
    vc:requires ngm:approximate-nearest-neighbour-search,
        ngm:document-chunking,
        ngm:embedding-model,
        ngm:vector-database ;
    vc:slug "retrieval-augmented-generation" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:dense-retrieval,
        ngm:knowledge-base,
        ngm:large-language-models,
        ngm:transformer-architecture .

ngm:digital-asset a owl:Class ;
    rdfs:label "Digital Asset"@en ;
    rdfs:comment "A digital asset is any electronically stored item of value that carries ownership rights and can be transferred, traded, or programmatically controlled — encompassing cryptocurrencies, tokenised securities, non-fungible tokens, stablecoins, and programmable financial instruments. Digital assets achieve verifiable scarcity and ownership through cryptographic proofs, with blockchain-based variants recorded immutably on distributed ledgers and governed by smart contracts. The class spans both on-chain native assets (e.g., BTC, ETH) and real-world asset tokenisations (RWAs), where legal property rights are encoded into blockchain representations enabling fractional ownership, automated compliance, and atomic settlement. Regulatory frameworks globally now classify digital assets across securities, commodities, payment instruments, and utility categories, shaping issuance, custody, and trading obligations."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:smart-contract ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:security-token ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:blockchain ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:stablecoin ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:utility-token ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:digital-wallet ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:cryptocurrency ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptographic-key ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:nft ],
        ngm:bc-token-and-asset ;
    skos:broader ngm:bc-token-and-asset ;
    vc:bridgesTo ngm:artificial-intelligence,
        ngm:decentralised-autonomous-organisation,
        ngm:metaverse-economy ;
    vc:contrastsWith ngm:central-bank-digital-currency,
        ngm:fiat-currency,
        ngm:physical-asset ;
    vc:dependsOn ngm:consensus-mechanism,
        ngm:distributed-ledger,
