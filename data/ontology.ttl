] .

mv:PlatformMiddleware rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:relatedTo ;
    owl:someValuesFrom mv:IntegrationPlatform
] .

# Play To Earn (P2E)
mv:PlayToEarnP2e a owl:Class ;
    rdfs:subClassOf mv:BlockchainGaming ;
    rdfs:label "Play To Earn (P2E)"@en ;
    rdfs:comment "A blockchain gaming model where players earn cryptocurrency tokens or NFT assets with real-world value through gameplay activities, combining entertainment with financial incentives through decentralized ownership of in-game items and characters."@en ;
    skos:prefLabel "Play To Earn (P2E)"@en ;
    dcterms:identifier "MV-10009" ;
    dcterms:subject "mv" .

