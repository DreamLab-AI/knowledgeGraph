    vc:implements ngm:bbs-signature,
        ngm:bitstring-status-list,
        ngm:json-data-interchange-format-ld,
        ngm:json-data-interchange-format-web-token,
        ngm:m-dl-iso-18013-5,
        ngm:open-id4-vc,
        ngm:sd-jwt ;
    vc:qualityScore "0.52"^^xsd:float ;
