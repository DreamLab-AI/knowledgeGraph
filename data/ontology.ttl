ngm:threat-hunting a owl:Class ;
    rdfs:label "Threat Hunting"@en ;
    rdfs:comment "Threat hunting is a proactive cybersecurity practice in which analysts iteratively search through networks, endpoints, and data repositories for hidden adversarial activity that has evaded automated detection. Unlike reactive incident response, threat hunting is hypothesis-driven, combining threat intelligence, behavioural analytics, and expert intuition to identify indicators of compromise or attack techniques before they manifest as confirmed incidents. The discipline reduces dwell time and surfaces novel attacker tradecraft for which signatures do not yet exist."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:security-operations-centre ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:log-management ],
        ngm:security ;
    vc:contrastsWith ngm:intrusion-detection-system,
        ngm:security-information-and-event-management ;
    vc:dependsOn ngm:network-traffic-analysis,
        ngm:threat-intelligence-platform ;
    vc:enables ngm:cyber-resilience,
        ngm:incident-response,
        ngm:threat-intelligence ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:hypothesis-generation,
        ngm:indicator-of-compromise ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:anomaly-detection,
        ngm:mitre-attack,
        ngm:penetration-testing,
        ngm:red-team ;
    vc:requires ngm:log-management,
        ngm:security-operations-centre ;
    vc:slug "threat-hunting" ;
    vc:sourceDomain "security" ;
    vc:supports ngm:zero-trust-architecture ;
    vc:uses ngm:behavioural-analytics,
        ngm:endpoint-detection-and-response,
        ngm:machine-learning .

ngm:threat-intelligence-platform a owl:Class ;
    rdfs:label "Threat Intelligence Platform"@en ;
    rdfs:comment "A threat intelligence platform (TIP) is a security system that aggregates, normalises, and correlates indicators of compromise and adversary intelligence from multiple feeds into an actionable, queryable repository. It enriches and scores indicators, manages their lifecycle, and distributes them to detection and response tooling. A TIP turns raw threat data into context that defenders can use to anticipate, detect, and block attacks."@en ;
    rdfs:subClassOf ngm:cybersecurity ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:cyber-security-and-cryptography,
        ngm:threat-surface-map ;
    vc:slug "threat-intelligence-platform" ;
    vc:sourceDomain "security" .

ngm:throughput-optimisation a skos:Concept ;
    rdfs:label "Throughput Optimisation"@en .

ngm:time-lock a owl:Class ;
    rdfs:label "Time Lock"@en ;
    rdfs:comment "A time lock is a cryptographic and protocol-level constraint that prevents the spending or execution of funds, transactions, or governance actions until a specified time or block height has been reached. Implemented on blockchains through absolute and relative locktime fields and dedicated script opcodes, time locks enforce delayed settlement, contestation windows, and staged execution without trusting a third party. They are foundational to payment channels, atomic swaps, vesting schedules, and the safety delays in DAO governance, where they give participants time to react before irreversible actions occur."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:consensus ],
        ngm:smart-contract ;
    vc:bridgesTo ngm:dao,
        ngm:hashed-timelock-contract ;
    vc:contrastsWith ngm:multisignature ;
    vc:dependsOn ngm:blockchain,
        ngm:consensus ;
    vc:enables ngm:atomic-swap ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:timelock ;
    vc:isPartOf ngm:bitcoin-script ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:atomic-swap,
        ngm:governance,
        ngm:lightning-network ;
    vc:requires ngm:consensus ;
    vc:slug "time-lock" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:governance,
        ngm:hashed-timelock-contract,
        ngm:lightning-network ;
    vc:uses ngm:bitcoin-script,
        ngm:transaction .

ngm:time-of-flight a owl:Class ;
    rdfs:label "Time Of Flight"@en ;
    rdfs:comment "Time of Flight (ToF) is a sensing technique that determines the distance to an object by measuring the elapsed time between the emission of a signal — typically light, sound, or radio waves — and the detection of its reflection. In depth sensing, ToF cameras emit pulsed or modulated infrared light and record the per-pixel round-trip delay to construct a dense depth map. ToF sensors are widely deployed in robotics, autonomous vehicles, augmented reality, and gesture recognition due to their ability to produce real-time depth data without ambient light dependency."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:depth-map ],
        ngm:robotics ;
    skos:broader ngm:robotics ;
    vc:bridgesTo ngm:spatial-computing ;
    vc:contrastsWith ngm:stereo-vision,
        ngm:structured-light ;
    vc:dependsOn ngm:sensor-fusion,
        ngm:signal-processing ;
    vc:enables ngm:3d-reconstruction,
        ngm:depth-sensing,
        ngm:obstacle-detection ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:depth-map ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:computer-vision,
        ngm:slam,
        ngm:spatial-computing ;
    vc:slug "time-of-flight" ;
    vc:sourceDomain "robotics" ;
    vc:supports ngm:augmented-reality,
        ngm:autonomous-navigation,
        ngm:gesture-recognition ;
    vc:uses ngm:infrared-sensing,
        ngm:lidar .

ngm:togaf a owl:Class ;
    rdfs:label "Togaf"@en ;
    rdfs:comment "TOGAF, The Open Group Architecture Framework, is a widely adopted methodology and framework for designing, planning, implementing and governing enterprise information architecture. Its core is the Architecture Development Method, an iterative cycle covering business, data, application and technology architecture. TOGAF provides a common vocabulary, reference models and governance structures that align IT strategy with business objectives."@en ;
    rdfs:subClassOf ngm:governance-framework ;
    vc:bridgesTo ngm:enterprise-integration ;
    vc:contrastsWith ngm:governance-framework ;
    vc:enables ngm:enterprise-integration ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:enterprise-integration ;
    vc:isPartOf ngm:governance-framework ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:regulatory-conformance,
        ngm:strategic-planning ;
    vc:slug "togaf" ;
    vc:sourceDomain "governance" ;
    vc:standardizedBy ngm:standards-documentation ;
    vc:supports ngm:strategic-planning ;
    vc:uses ngm:specification .

ngm:token-bridge a owl:Class ;
    rdfs:label "Token Bridge"@en ;
    rdfs:comment "A Token Bridge is a protocol that enables the transfer of token value or representation between two distinct blockchain networks that cannot natively communicate. It commonly locks or burns tokens on the source chain and mints or releases an equivalent representation on the destination chain, coordinated by validators, relayers or light-client proofs. Token bridges are a core mechanism for cross-chain liquidity but historically a significant locus of security risk."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:secure-enclave ],
        ngm:blockchain-interoperability ;
    vc:bridgesTo ngm:blockchain-interoperability ;
    vc:dependsOn ngm:attestation ;
    vc:enables ngm:blockchain-interoperability,
        ngm:liquidity ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:atomic-swap,
        ngm:cross-chain-communication,
        ngm:wrapped-token ;
    vc:requires ngm:secure-enclave ;
    vc:slug "token-bridge" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:decentralised-exchange ;
    vc:uses ngm:wrapped-token .

ngm:token-governance a skos:Concept ;
    rdfs:label "Token Governance"@en .

ngm:token-transfer a owl:Class ;
    rdfs:label "Token Transfer"@en ;
    rdfs:comment "A token transfer is the operation of moving ownership of a fungible or non-fungible blockchain token from one account to another, recorded as a state change on a distributed ledger. On smart-contract platforms it is typically realised by invoking a transfer function defined by a token standard such as ERC-20, which debits the sender's balance, credits the recipient, and emits an event. Token transfers are the elementary settlement primitive underlying payments, trading, and decentralised finance."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:consensus ],
        ngm:transaction ;
    vc:dependsOn ngm:gas,
        ngm:smart-contract ;
    vc:enables ngm:decentralized-finance,
        ngm:tokenization ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:token ;
    vc:isPartOf ngm:smart-contract-execution ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:event-log,
        ngm:fungible-token,
        ngm:ledger,
        ngm:non-fungible-token ;
    vc:requires ngm:consensus ;
    vc:slug "token-transfer" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:cryptocurrency,
        ngm:token-economics ;
    vc:uses ngm:erc-20,
        ngm:token-standard,
        ngm:wallet .

ngm:tokenisation a skos:Concept ;
    rdfs:label "Tokenisation"@en .

