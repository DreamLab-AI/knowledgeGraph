ngm:sdxl a owl:Class ;
    rdfs:comment "SDXL (Stable Diffusion XL) is a large-scale latent diffusion model released by Stability AI in 2023, comprising a 3.5-billion-parameter UNet and an ensemble of two CLIP text encoders that condition image generation at native 1024×1024 resolution. It introduces a two-stage architecture — a base model followed by a refinement model — and supports advanced conditioning mechanisms including aesthetic scoring and crop coordinates."@en ;
    rdfs:label "SDXL"@en ;
    rdfs:subClassOf ngm:diffusion-models ;
