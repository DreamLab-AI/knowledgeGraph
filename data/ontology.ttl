ngm:voting-mechanism a owl:Class ;
    rdfs:label "Voting Mechanism"@en ;
    rdfs:comment "A voting mechanism is a formalised procedure by which token holders or other stakeholders express preferences or binding decisions on protocol upgrades, parameter changes, treasury allocation, or dispute resolution in a decentralised network. The design of a voting mechanism determines the balance between participation breadth, sybil resistance, plutocracy risk, and voter apathy; common variants include token-weighted voting, quadratic voting, conviction voting, and delegated representation through liquid democracy. The mechanism's properties directly shape the security and legitimacy of on-chain governance outcomes."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:token-weighted-voting ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:on-chain-voting ],
        ngm:bc-governance-and-regulation ;
    skos:broader ngm:bc-governance-and-regulation ;
    vc:enables ngm:on-chain-governance ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:on-chain-voting,
