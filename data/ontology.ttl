    rdfs:label "Data Connectors"@en .
ngm:data-consistency a owl:Class ;
    rdfs:comment "Data consistency is the guarantee that data remains valid, coherent and in agreement across copies, transactions and nodes of a system. In distributed systems it spans a spectrum from strong consistency, where all readers observe the latest write, to eventual consistency, where replicas converge over time. It is a core correctness property traded off against availability and latency, and it underpins fault-tolerant data layers."@en ;
    rdfs:label "Data Consistency"@en ;
    rdfs:subClassOf ngm:distributed-systems ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:data-layer ;
    vc:relatedTo ngm:fault-tolerance ;
    vc:slug "data-consistency" ;
    vc:sourceDomain "infrastructure" .
ngm:data-contracts a owl:Class ;
    rdfs:comment "A data contract is a formal, versioned agreement between data producers and consumers that specifies the schema, semantics, quality guarantees and service-level expectations of a dataset or stream. It makes data interfaces explicit and enforceable, enabling automated validation and breaking-change detection in data pipelines. Data contracts are a metadata-management practice that improves reliability and trust across decentralised data ownership."@en ;
    rdfs:label "Data Contracts"@en ;
    rdfs:subClassOf ngm:data-management ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:metadata-management ;
    vc:slug "data-contracts" ;
    vc:sourceDomain "data" .
ngm:data-controller a skos:Concept ;
    rdfs:label "Data Controller"@en .
ngm:data-corruption a skos:Concept ;
    rdfs:label "Data Corruption"@en .
ngm:data-covariance-spectrum a skos:Concept ;
    rdfs:label "Data Covariance Spectrum"@en .
ngm:data-curation a owl:Class ;
    rdfs:comment "Data curation is the process of collecting, filtering, cleaning, annotating and organising raw data into a coherent, high-quality dataset suitable for training or evaluating machine learning models. It includes deduplication, removal of low-quality or harmful content, balancing of class or source distributions, and documentation of provenance and licensing. Rigorous data curation has a substantial effect on downstream model quality and is increasingly recognised as being as important as model architecture in large-scale AI systems."@en ;
    rdfs:label "Data Curation"@en ;
    rdfs:subClassOf ngm:data-preprocessing ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:data-preprocessing ;
    vc:qualityScore "0.55"^^xsd:float ;
    vc:relatedTo ngm:ade20-k ;
    vc:relatedTo ngm:common-crawl ;
    vc:slug "data-curation" ;
    vc:sourceDomain "artificial-intelligence" .
ngm:data-debt a skos:Concept ;
    rdfs:label "Data Debt"@en .
ngm:data-deduplication a owl:Class ;
    rdfs:comment "Data deduplication is the process of detecting and eliminating redundant copies of data so that only unique instances are retained or referenced. In storage it reduces capacity and bandwidth needs through chunk- or block-level matching, while in data preparation it removes duplicate records to improve quality. It is foundational for clean training data and for identity resolution where records must be matched and merged."@en ;
    rdfs:label "Data Deduplication"@en ;
    rdfs:subClassOf ngm:data-management ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:identity-resolution ;
    vc:relatedTo ngm:training-data ;
    vc:slug "data-deduplication" ;
    vc:sourceDomain "data" .
ngm:data-definition-language a skos:Concept ;
    rdfs:label "Data Definition Language"@en .
ngm:data-destruction a skos:Concept ;
    rdfs:label "Data Destruction"@en .
ngm:data-dictionary a owl:Class ;
    rdfs:comment "A data dictionary is a centralised, structured repository that describes the data elements of an information system, recording each element's name, definition, data type, format, allowable values, relationships and ownership. It serves as an authoritative reference for the meaning and structure of data, distinct from the data itself, enabling consistent understanding across teams and systems. Data dictionaries underpin data governance, integration and quality assurance by making the semantics of stored data explicit."@en ;
    rdfs:label "Data Dictionary"@en ;
    rdfs:subClassOf ngm:metadata-management ;
    rdfs:subClassOf _:r6824 ;
    rdfs:subClassOf _:r6825 ;
    rdfs:subClassOf _:r6826 ;
