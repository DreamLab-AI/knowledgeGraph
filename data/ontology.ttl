ngm:cloud-native a owl:Class ;
    rdfs:label "Cloud Native"@en ;
    rdfs:comment "Cloud Native is an approach to building and running applications that fully exploits the advantages of cloud computing infrastructure — elastic scaling, managed services, pay-per-use economics, and high availability — by designing for containerisation, dynamic orchestration, microservices decomposition, and declarative APIs. The Cloud Native Computing Foundation (CNCF) defines it as the use of containers, service meshes, microservices, immutable infrastructure, and declarative APIs to build resilient, manageable, and observable systems. Cloud Native architectures enable rapid, reproducible delivery of software at scale across public, private, and hybrid cloud environments."@en ;
    rdfs:subClassOf ngm:cloud-computing ;
    vc:enables ngm:continuous-integration,
        ngm:high-availability,
        ngm:scalability ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:edge-computing,
        ngm:fault-tolerance,
        ngm:microservices-architecture ;
    vc:slug "cloud-native" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:kubernetes,
        ngm:microservices,
        ngm:service-mesh .

ngm:cold-storage a owl:Class ;
    rdfs:label "Cold Storage"@en ;
    rdfs:comment "Cold Storage in the context of digital assets and cryptocurrency refers to the practice of holding private keys in an offline environment — physically disconnected from any network — to eliminate the attack surface presented by internet-connected systems. Hardware wallets, air-gapped computers, and paper wallets are common cold storage implementations. By contrast with hot wallets (internet-connected), cold storage sacrifices transaction convenience for maximum security, and is the industry standard for custodying large quantities of cryptocurrency at exchanges, institutional custodians, and high-net-worth individual holders."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:private-key ],
        ngm:custody-infrastructure ;
    vc:bridgesTo ngm:infrastructure,
        ngm:security ;
    vc:contrastsWith ngm:hot-wallet,
        ngm:warm-storage ;
    vc:enables ngm:digital-asset-custody,
        ngm:institutional-custody,
        ngm:key-ceremony,
        ngm:self-custody ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:bitcoin-proof-of-work-protocol-network,
        ngm:decentralized-finance-de-fi,
        ngm:digital-asset-exchange ;
    vc:requires ngm:physical-security,
        ngm:private-key ;
    vc:slug "cold-storage" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:multisignature-wallets,
        ngm:partially-signed-bitcoin-transaction,
        ngm:threshold-signature-scheme ;
    vc:uses ngm:air-gapped-computer,
        ngm:cryptographic-key-management,
        ngm:hardware-security-module,
        ngm:hardware-wallet,
        ngm:multisignature .

ngm:community-governance a owl:Class ;
    rdfs:label "Community Governance"@en ;
    rdfs:comment "Community Governance refers to the structures, processes, and norms through which a community of stakeholders collectively makes decisions, allocates resources, resolves disputes, and sets rules for shared systems or commons. It encompasses formal mechanisms such as voting protocols, proposal systems, and constitutional rules, as well as informal norms of participation, legitimacy, and accountability. Community governance may be implemented on-chain through smart contracts and token-weighted voting in decentralised autonomous organisations, or off-chain through forum deliberation, elected councils, and working groups in open-source projects, platform cooperatives, and public institutions. The field draws on political science, institutional economics, commons theory, and distributed systems to design governance models that are simultaneously legitimate, efficient, and resistant to capture."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:treasury-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:proposal-system ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:dispute-resolution ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:accountability-mechanism ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:voting-mechanism ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:stakeholder-participation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:consensus-mechanism ],
        ngm:decentralised-governance ;
    vc:bridgesTo ngm:ai-alignment,
        ngm:blockchain,
        ngm:digital-commons ;
    vc:contrastsWith ngm:centralised-control,
        ngm:corporate-governance ;
    vc:dependsOn ngm:legitimacy,
        ngm:social-contract ;
    vc:enables ngm:collective-decision-making,
        ngm:commons-stack,
        ngm:protocol-upgrades ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:dispute-resolution,
        ngm:proposal-system,
        ngm:treasury-management,
        ngm:voting-mechanism ;
    vc:isPartOf ngm:decentralised-governance,
        ngm:institutional-design ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:rough-consensus ;
    vc:requires ngm:accountability-mechanism,
        ngm:consensus-mechanism,
        ngm:stakeholder-participation ;
    vc:slug "community-governance" ;
    vc:sourceDomain "governance" ;
    vc:supports ngm:decentralised-autonomous-organisation,
        ngm:open-source ;
    vc:uses ngm:multisig-wallet,
        ngm:quadratic-voting,
        ngm:smart-contract,
        ngm:token-weighted-voting .

ngm:computing-infrastructure a owl:Class ;
    rdfs:label "Computing Infrastructure"@en ;
    rdfs:comment "Computing infrastructure encompasses the physical and virtual resources required for building, running, and delivering applications and services, including servers, storage systems, networking equipment, power systems, and cooling facilities housed in data centres. It provides the foundational capacity that IT systems require to process, store, and transmit digital data. Modern computing infrastructure increasingly extends from on-premises hardware into cloud-hosted and edge environments, and is a prerequisite for AI workloads, distributed applications, and spatial computing platforms."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:gpu-compute ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:networking-infrastructure ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:storage-infrastructure ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:network-infrastructure ],
