        <urn:visionflow:linked:open-xr-loader>,
        <urn:visionflow:linked:open-xr-session>,
        <urn:visionflow:linked:open-xr-space>,
        <urn:visionflow:linked:open-xr-swapchain> ;
    vc:implements <urn:visionflow:linked:khronos-open-xr-1-0-specification>,
        <urn:visionflow:linked:open-xr-extension-registry> ;
    vc:maturity "established" ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires <urn:visionflow:linked:open-gl-es>,
        <urn:visionflow:linked:vulkan-api>,
        <urn:visionflow:linked:xr-hardware-device>,
        <urn:visionflow:linked:xr-runtime> ;
    vc:slug "open-xr" ;
    vc:sourceDomain "spatial-computing" .

