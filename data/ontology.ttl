        ngm:sql .

ngm:distributed-consensus a owl:Class ;
    rdfs:label "Distributed Consensus"@en ;
    rdfs:comment "Distributed consensus is the fundamental computer science problem of achieving reliable agreement on a shared value or sequence of values across a set of independent processes in a distributed system, despite the possibility of node crashes, network partitions, message delays, and Byzantine (arbitrarily malicious) behaviour. The problem is formalised through three core properties: agreement (all non-faulty nodes decide the same value), validity (the decided value was proposed by some participant), and termination (every non-faulty node eventually decides). The Fischer-Lynch-Paterson (FLP) impossibility theorem establishes that deterministic consensus in a fully asynchronous system is impossible even with one crash-faulty process, forcing all practical protocols to make synchrony assumptions or adopt probabilistic termination."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:message-passing ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptographic-signature ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:network-communication ],
        ngm:distributed-computing ;
    vc:bridgesTo ngm:federated-learning,
        ngm:multi-agent-coordination ;
    vc:contrastsWith ngm:eventual-consistency ;
    vc:enables ngm:blockchain,
        ngm:decentralised-trust,
        ngm:distributed-databases,
        ngm:distributed-ledger,
        ngm:state-machine-replication ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:implements ngm:hot-stuff,
        ngm:paxos,
        ngm:pbft,
        ngm:raft,
        ngm:tendermint ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:atomic-broadcast,
        ngm:cap-theorem,
        ngm:distributed-system,
        ngm:proof-of-stake,
        ngm:proof-of-work ;
    vc:requires ngm:cryptographic-signature,
        ngm:message-passing,
        ngm:network-communication ;
    vc:slug "distributed-consensus" ;
    vc:sourceDomain "distributed-systems" ;
    vc:standardizedBy ngm:ieee,
        ngm:ietf ;
    vc:uses ngm:byzantine-fault-tolerance,
        ngm:consensus-algorithm,
        ngm:consensus-protocol,
        ngm:fault-tolerance,
        ngm:leader-election,
        ngm:quorum-system .

ngm:erc-1155 a owl:Class ;
    rdfs:label "ERC-1155"@en ;
    rdfs:comment "ERC-1155 is an Ethereum multi-token standard (formalised as EIP-1155) that enables a single smart contract to manage an arbitrary number of token types — fungible, non-fungible, and semi-fungible — each identified by a uint256 token ID with per-address per-ID balance tracking. Pioneered by Witek Radomski of Enjin in 2018, it introduced safeBatchTransferFrom for atomic multi-token transfers in a single transaction, significantly reducing gas costs relative to deploying separate ERC-20 or ERC-721 contracts for each asset type. The standard's onERC1155Received and onERC1155BatchReceived hooks enforce safe-transfer guarantees on receiver contracts, preventing tokens from being permanently locked. It is widely adopted across blockchain gaming, NFT marketplaces, and on-chain economies requiring a mixture of consumable items and unique collectibles."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:solidity ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ethereum ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gas-fee ],
        ngm:token-standard ;
    vc:bridgesTo ngm:digital-twin,
        ngm:supply-chain-provenance ;
    vc:contrastsWith ngm:erc-20,
        ngm:erc-4626,
        ngm:erc-721 ;
    vc:enables ngm:blockchain-gaming,
        ngm:decentralised-finance,
        ngm:digital-asset-market,
        ngm:nft,
        ngm:semi-fungible-token ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:eip-1155,
        ngm:ethereum-improvement-proposal ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:account-abstraction,
        ngm:open-zeppelin ;
    vc:requires ngm:ethereum,
        ngm:gas-fee,
        ngm:solidity ;
    vc:slug "erc-1155" ;
    vc:sourceDomain "blockchain" ;
    vc:standardizedBy ngm:ethereum-smart-contract-platform-foundation ;
    vc:uses ngm:batch-processing,
        ngm:ethereum-smart-contract-platform-virtual-machine,
        ngm:ipfs,
        ngm:smart-contract .

ngm:etl-pipeline a owl:Class ;
    rdfs:label "ETL Pipeline"@en ;
    rdfs:comment "An Extract-Transform-Load pipeline that automates the movement of data from heterogeneous source systems, applies normalisation and enrichment transformations, and loads the results into target data stores such as data warehouses or feature stores. ETL pipelines are foundational to data engineering and AI/ML workflows."@en ;
