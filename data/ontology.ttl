ngm:externally-owned-account a owl:Class ;
    rdfs:comment "An Externally Owned Account (EOA) is a type of Ethereum account controlled by a private key held outside the blockchain — typically by an end user via a wallet — as opposed to a contract account controlled by smart contract code. EOAs can initiate transactions, sign messages, and hold ether and tokens; they have no associated code. Every Ethereum transaction must originate from an EOA, making them the fundamental actor type in the Ethereum account model."@en ;
    rdfs:label "Externally Owned Account"@en ;
    rdfs:subClassOf ngm:blockchain-wallet ;
    rdfs:subClassOf _:r10194 ;
