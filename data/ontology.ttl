# Creative Media Domain
spatial-computing:CreativeMediaDomain rdf:type owl:Class ;
    rdfs:subClassOf spatial-computing:ArtificialIntelligenceDomain ;
    rdfs:label "Creative Media Domain"@en ;
    rdfs:comment "A cross-cutting domain encompassing AI-enabled creative content generation, including generative art, synthetic media, procedural content creation, AI-assisted design, computational creativity, and the intersection of artificial intelligence with artistic and media production workflows."@en ;
    skos:prefLabel "Creative Media Domain"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:spatial-computing:creative-media-domain" ;
    owl:sameAs <urn:visionclaw:concept:spatial-computing:creative-media-domain> ;
