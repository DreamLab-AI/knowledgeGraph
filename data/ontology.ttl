ngm:l-402 a owl:Class ;
    rdfs:comment "An authentication and payment protocol that combines the HTTP 402 Payment Required status code with Lightning Network invoices and macaroon-based authorisation tokens, enabling per-request access control and machine-to-machine micropayments without user accounts."@en ;
    rdfs:label "L402"@en ;
    rdfs:subClassOf ngm:lightning-network ;
