        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:transparency ],
        ngm:governance-framework ;
    vc:bridgesTo ngm:esg,
        ngm:regulatory-compliance ;
    vc:contrastsWith ngm:self-regulation ;
    vc:dependsOn ngm:audit,
