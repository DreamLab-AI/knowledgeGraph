ngm:learning a owl:Class ;
    rdfs:label "Learning"@en ;
    rdfs:comment "Learning is the process by which a system improves its performance on a task through experience or data. In artificial intelligence it refers to algorithms that adjust internal parameters or rules from observations."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:machine-learning-discipline ],
        ngm:machine-learning-discipline ;
    vc:enables ngm:deep-learning,
        ngm:reinforcement-learning ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:machine-learning-discipline ;
    vc:slug "learning" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:learning-curve a skos:Concept ;
    rdfs:label "Learning Curve"@en .

ngm:learning-experience-platform a skos:Concept ;
    rdfs:label "Learning Experience Platform"@en .

ngm:learning-platform-categorization a owl:Class ;
    rdfs:label "Learning Platform Categorization"@en ;
    rdfs:comment "A taxonomy of platforms and environments used to deliver educational experiences, spanning traditional learning management systems, online learning portals, virtual classrooms, immersive XR-based environments, and metaverse-native learning spaces. The categorization framework identifies dimensions such as modality (synchronous/asynchronous), immersion level, social presence, and assessment integration, enabling educators and institutions to select or compare platforms for pedagogical fit. In the spatial computing context, the taxonomy extends to cover platforms that leverage augmented reality, virtual reality, and simulated environments to enable experiential, collaborative, and gamified learning at scale."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:learning-management-system ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:online-learning ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:virtual-classroom ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:immersive-learning ],
        ngm:metaverse-classification,
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:immersive-learning,
        ngm:learning-management-system,
        ngm:online-learning,
        ngm:virtual-classroom ;
    vc:isPartOf ngm:educational-technology,
        ngm:metaverse-classification ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:augmented-reality,
        ngm:collaborative-systems-modality-learning,
        ngm:extended-reality,
        ngm:metaverse,
        ngm:simulation,
        ngm:virtual-reality ;
    vc:slug "learning-platform-categorization" ;
    vc:sourceDomain "spatial-computing" .

