ngm:brc-20 a owl:Class ;
    rdfs:label "BRC-20"@en ;
    rdfs:comment "BRC-20 is an experimental fungible token standard on the Bitcoin blockchain that encodes deploy, mint, and transfer operations as JSON-formatted Ordinals inscriptions written onto individual satoshis. Token balances are not enforced by Bitcoin consensus rules but are instead computed off-chain by indexers that parse inscription data in sequential ordinal order. Proposed by the pseudonymous developer @domo in March 2023, BRC-20 was the first widely adopted approach to creating transferable fungible tokens natively on Bitcoin without requiring a sidechain or layer-2 network. Its simplicity and permissionless nature drove rapid experimentation but also exposed limitations around scalability, indexer consensus, and on-chain fee pressure."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ordinals ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:bitcoin-proof-of-work-protocol ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:taproot ],
        ngm:token-standard ;
    vc:bridgesTo ngm:decentralised-finance,
        ngm:tokenisation ;
    vc:contrastsWith ngm:erc-20,
        ngm:runes-protocol,
        ngm:spl-token,
        ngm:src-20 ;
    vc:dependsOn ngm:bitcoin-node,
        ngm:ordinals-indexer ;
    vc:enables ngm:decentralised-exchange,
        ngm:fungible-token,
        ngm:token-minting ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:bitcoin-ecosystem ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:bitcoin-script,
        ngm:digital-asset,
        ngm:layer-2-protocol,
