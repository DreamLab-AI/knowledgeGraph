        <urn:visionflow:linked:network-physical-layer>,
        <urn:visionflow:linked:synchronisation-mechanism>,
        vf:fault-tolerance ;
    vc:slug "communication-protocol" ;
    vc:sourceDomain "robotics" .

vf:compliance-framework a owl:Class ;
    rdfs:label "Compliance Framework"@en ;
    rdfs:comment "Compliance Framework is a concept within the metaverse domain. Further enrichment pending."@en ;
    rdfs:subClassOf vf:artificial-intelligence ;
