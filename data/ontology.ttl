ngm:environmental-monitoring a owl:Class ;
    rdfs:label "Environmental Monitoring"@en ;
    rdfs:comment "Environmental monitoring is the systematic collection, measurement, and analysis of physical, chemical, and biological parameters of natural and built environments over time, enabling the detection of change, assessment of regulatory compliance, and support of scientific understanding of ecological and climate systems. It encompasses sensor networks, satellite remote sensing, in-situ measurement stations, and the data pipelines that transform raw measurements into actionable environmental intelligence."@en ;
    rdfs:subClassOf ngm:monitoring ;
    vc:enables ngm:smart-city ;
    vc:hasMaturity ngmi:maturity-draft ;
