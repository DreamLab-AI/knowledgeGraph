    vc:relatedTo ngm:electronic-signature ;
    vc:slug "banking-regulation" ;
    vc:sourceDomain "infrastructure" .

ngm:beacon-chain a owl:Class ;
    rdfs:label "Beacon Chain"@en ;
    rdfs:comment "The Beacon Chain is the proof-of-stake consensus backbone introduced to Ethereum that coordinates validators, manages staking, and finalises blocks. It organises time into slots and epochs, assigns block-proposal and attestation duties, and applies a finality gadget that locks in the canonical chain. The Beacon Chain decouples consensus from execution, providing the security and randomness that the broader sharded and execution layers build upon."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:proof-of-stake ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:validator ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:epoch ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:attestation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:staking ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:validator ],
        ngm:consensus-layer ;
    vc:dependsOn ngm:consensus-mechanism,
        ngm:staking ;
    vc:enables ngm:finality,
        ngm:sharding ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:attestation,
        ngm:epoch,
        ngm:validator ;
    vc:implements ngm:consensus-mechanism,
        ngm:proof-of-stake ;
    vc:isPartOf ngm:consensus-layer ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:ethereum,
        ngm:finality,
        ngm:sharding ;
    vc:requires ngm:proof-of-stake,
        ngm:staking,
        ngm:validator ;
    vc:slug "beacon-chain" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:consensus-layer,
        ngm:ethereum ;
    vc:uses ngm:attestation,
        ngm:block-proposal .

ngm:behavioral-learning a owl:Class ;
    rdfs:label "Behavioral Learning"@en ;
    rdfs:comment "An AI-driven approach that analyzes and predicts user behavior patterns from digital interactions including clicks, browsing patterns, movement trajectories, and gaze tracking, enabling automated decision-making and personalized experiences through machine learning and pattern recognition."@en ;
