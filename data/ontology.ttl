ngm:automatic-differentiation a owl:Class ;
    rdfs:label "Automatic Differentiation"@en ;
    rdfs:comment "Automatic differentiation (AD) is a family of computational techniques for evaluating the derivative of a function specified by a computer program, by systematically applying the chain rule to elementary arithmetic operations rather than through symbolic algebra or finite-difference approximation. It operates in two principal modes: forward mode, which propagates tangent values alongside primal values, and reverse mode (backpropagation), which accumulates gradients in a backward pass over a recorded computation graph. AD produces machine-precision derivatives at a cost linear in the number of program operations, making it the computational backbone of modern deep learning frameworks."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:computation-graph ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:backpropagation ],
        ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:bridgesTo ngm:differentiable-rendering,
        ngm:robotics-control ;
    vc:enables ngm:backpropagation,
        ngm:deep-learning,
        ngm:differentiable-programming,
        ngm:gradient-descent,
        ngm:neural-ordinary-differential-equation,
        ngm:probabilistic-programming,
        ngm:scientific-machine-learning ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:backpropagation,
        ngm:computation-graph,
        ngm:forward-mode-differentiation ;
    vc:qualityScore "0.92"^^xsd:float ;
    vc:relatedTo ngm:automated-reasoning,
        ngm:just-in-time-compilation,
        ngm:loss-function,
        ngm:numerical-methods,
        ngm:optimisation,
        ngm:stochastic-gradient-descent ;
    vc:requires ngm:chain-rule,
        ngm:differentiable-function ;
    vc:slug "automatic-differentiation" ;
    vc:sourceDomain "machine-learning" ;
    vc:supports ngm:differentiable-rendering,
        ngm:physics-simulation,
        ngm:probabilistic-programming,
        ngm:scientific-machine-learning ;
    vc:uses ngm:computation-graph,
        ngm:machine-learning-framework,
        ngm:neural-network .

ngm:block-header a owl:Class ;
    rdfs:label "Block Header"@en ;
    rdfs:comment "The fixed-size metadata section of a blockchain block that encodes the previous block hash, Merkle root of transactions, timestamp, difficulty target, and nonce. The block header is the unit that miners and validators hash during proof-of-work or verify during proof-of-stake, and it commits to the complete block body via the Merkle root without including raw transactions."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptographic-hash-function ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:difficulty ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:nonce ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:timestamp ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:merkle-root ],
        ngm:bc-protocol-and-consensus,
        ngm:blockchain-entity,
        ngm:distributed-data-structure ;
    skos:broader ngm:bc-protocol-and-consensus ;
    vc:bridgesTo ngm:distributed-systems,
        ngm:security ;
    vc:dependsOn ngm:consensus-mechanism,
        ngm:peer-to-peer-network ;
    vc:enables ngm:light-client ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:difficulty,
        ngm:merkle-root,
        ngm:nonce,
        ngm:timestamp ;
    vc:isPartOf ngm:block,
        ngm:blockchain ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:block,
        ngm:block-height,
        ngm:genesis-block,
        ngm:merkle-tree ;
    vc:requires ngm:cryptographic-hash-function ;
    vc:slug "block-header" ;
    vc:sourceDomain "blockchain" ;
    vc:standardizedBy ngm:ieee-2418-1,
        ngm:iso-iec-23257-2021 ;
    vc:supports ngm:merkle-proof,
        ngm:simplified-payment-verification ;
    vc:uses ngm:proof-of-stake,
