ngm:snapshot a owl:Class ;
    rdfs:label "Snapshot"@en ;
    rdfs:comment "Snapshot is an off-chain governance platform that lets token holders and decentralised autonomous organisations vote on proposals without paying on-chain transaction fees. Votes are signed cryptographically with a wallet and weighted according to token holdings recorded at a chosen block height, then aggregated and stored on the InterPlanetary File System. Because voting is gasless and non-binding at the protocol level, results are typically executed separately by multisignature wallets or on-chain modules."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ethereum ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ipfs ],
        ngm:decentralised-finance-domain ;
    vc:enables ngm:decentralised-autonomous-organisation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:ethereum,
        ngm:ipfs ;
    vc:slug "snapshot" ;
    vc:sourceDomain "snapshot" .

ngm:snapshot-block a owl:Class ;
    rdfs:label "Snapshot Block"@en ;
    rdfs:comment "A snapshot block is a specific block height at which token balances are recorded to determine voting weight in a governance proposal, freezing eligibility so that votes reflect holdings at one fixed moment rather than fluctuating balances. Using a past block prevents vote-buying or borrowing tokens after a proposal opens. It is a core primitive in off-chain and on-chain DAO voting systems."@en ;
    rdfs:subClassOf ngm:bc-governance-and-regulation ;
    skos:broader ngm:bc-governance-and-regulation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:governance-token,
        ngm:snapshot-voting ;
    vc:slug "snapshot-block" ;
    vc:sourceDomain "blockchain" .

ngm:social-interaction a owl:Class ;
    rdfs:label "Social Interaction"@en ;
    rdfs:comment "Social Interaction refers to the dynamic process by which two or more agents — human or artificial — mutually influence one another's behaviour, cognition, and emotional states through communicative acts, physical co-presence, or mediated channels. It is the fundamental unit of social life, encompassing verbal conversation, nonverbal signals, turn-taking, joint attention, empathic responsiveness, and negotiation of shared meaning. In the context of digital and AI systems, social interaction extends to human-computer interfaces, social robotics, virtual environments, and AI-mediated communication platforms, where the design of interaction modalities profoundly shapes social outcomes and wellbeing."@en ;
    rdfs:subClassOf ngm:interaction-domain ;
    vc:enables ngm:conversational-ai,
        ngm:emotion-aware-interaction,
        ngm:social-network-graph ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:human-computer-interaction,
        ngm:human-robot-interaction,
        ngm:social-presence ;
    vc:slug "social-interaction" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:emotional-intelligence,
        ngm:natural-interaction,
        ngm:proxemics .

ngm:social-network-analysis a owl:Class ;
    rdfs:label "Social Network Analysis"@en ;
    rdfs:comment "Social network analysis (SNA) is a methodology for studying social structures through graph-theoretic and statistical techniques applied to networks of actors (nodes) and their relationships (edges). It measures structural properties such as centrality, clustering, path length, and community structure to identify influential actors, information bottlenecks, and emergent communities within social systems."@en ;
    rdfs:subClassOf ngm:network-analysis ;
    vc:enables ngm:community-detection ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:network-science,
        ngm:social-network-graph ;
    vc:slug "social-network-analysis" ;
    vc:sourceDomain "governance" ;
    vc:uses ngm:community-detection,
        ngm:graph-theory .

ngm:sociotechnical-system a owl:Class ;
    rdfs:label "Sociotechnical System"@en ;
    rdfs:comment "A sociotechnical system is an analytical and design framework that treats technological artefacts and social structures as mutually constitutive elements of a unified system, recognising that technical components and human actors, organisations, and cultural practices co-evolve in ways that cannot be understood in isolation. Originating in organisational psychology and systems theory, it emphasises that optimising the technical subsystem alone is insufficient; effective system design requires joint optimisation of technical and social elements."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:human-computer-interaction ],
        ngm:complex-systems ;
    vc:contrastsWith ngm:sociotechnical-harm ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:human-computer-interaction ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:human-factors,
        ngm:sociotechnical-analysis,
        ngm:sociotechnical-risk ;
    vc:slug "sociotechnical-system" ;
    vc:sourceDomain "governance" ;
    vc:uses ngm:organisational-theory .

ngm:software-infrastructure a owl:Class ;
    rdfs:label "Software Infrastructure"@en ;
    rdfs:comment "Software Infrastructure comprises the foundational software layers — including operating systems, middleware, APIs, frameworks, and runtime environments — that underpin applications and services without being directly user-facing. It provides the shared services, communication channels, and execution contexts on which higher-level metaverse, AI, and distributed-systems applications are built, analogous to the role that physical infrastructure plays for built environments."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:software-architecture ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:middleware ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:api-gateway ],
