    vc:supports ngm:ai-governance,
        ngm:responsible-ai .

ngm:algorithmic-bias-and-variance a owl:Class ;
    rdfs:label "Algorithmic Bias and Variance"@en ;
    rdfs:comment "Algorithmic Bias and Variance denotes the canonical decomposition of supervised-learning generalisation error into three orthogonal components — squared bias, variance, and irreducible noise — formalised by Geman, Bienenstock & Doursat (1992) as Err(x) = E[(y − f̂(x))²] = (E[f̂(x)] − f(x))² + E[(..."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:loss-function ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:mean-squared-error ],
        ngm:ai-technique,
        ngm:model-evaluation,
        ngm:neural-network ;
    skos:broader ngm:ai-technique ;
    vc:enables ngm:capacity-control,
        ngm:generalisation-bound,
        ngm:hyperparameter-tuning,
        ngm:model-selection,
        ngm:risk-minimisation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:bias-component,
        ngm:hypothesis-class,
        ngm:irreducible-error,
        ngm:learning-curve,
        ngm:mean-squared-error,
        ngm:validation-curve,
        ngm:variance-component ;
    vc:implements ngm:bootstrap,
        ngm:cross-validation,
        ngm:holdout-method,
        ngm:k-fold,
        ngm:loocv,
        ngm:stratified-sampling ;
    vc:qualityScore "0.52"^^xsd:float ;
    vc:relatedTo ngm:benign-overfitting,
        ngm:double-descent,
        ngm:grokking,
        ngm:inductive-bias,
        ngm:neural-scaling-laws,
        ngm:overfitting,
        ngm:underfitting ;
    vc:requires ngm:hypothesis-space,
        ngm:loss-function,
        ngm:resampling-method,
        ngm:sample-complexity,
        ngm:training-distribution ;
    vc:slug "algorithmic-bias-and-variance" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:standardizedBy ngm:hastie-tibshirani-friedman-esl,
        ngm:py-torch,
        ngm:scikit-learn,
