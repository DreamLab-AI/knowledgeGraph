    vc:slug "infrastructure-architecture" ;
    vc:sourceDomain "infrastructure" .

ngm:tensor-parallelism a owl:Class ;
    rdfs:label "Tensor Parallelism"@en ;
    rdfs:comment "Tensor parallelism is a model-parallel training and inference technique that splits individual weight tensors, and the matrix multiplications that use them, across multiple accelerators so that each device holds and computes a shard of every layer. Partial results are combined with collective communication such as all-reduce. It lets models whose layers exceed a single device's memory run at scale, and is typically combined with data and pipeline parallelism."@en ;
    rdfs:subClassOf ngm:ai-infrastructure ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:compute-infrastructure,
        ngm:model-training ;
    vc:slug "tensor-parallelism" ;
    vc:sourceDomain "ai" .

ngm:timestamp-authority a owl:Class ;
    rdfs:label "Timestamp Authority"@en ;
    rdfs:comment "A Timestamp Authority (TSA) is a trusted third party that issues cryptographically signed timestamps attesting that a particular piece of data existed at or before a specified point in time, in accordance with the RFC 3161 Internet X.509 Public Key Infrastructure Time-Stamp Protocol. The TSA receives a hash of the document or data, signs it together with the current time using its private key, and returns a TimeStampToken that can be independently verified by any party holding the TSA's public key certificate. Timestamp tokens are widely used in digital signature workflows to prove long-term validity—establishing that signatures were made before certificate revocation or expiry. Under eIDAS regulation in Europe, qualified TSAs form part of trust service infrastructure with legal standing equivalent to notarisation."@en ;
    rdfs:subClassOf ngm:certificate-authority ;
    vc:enables ngm:audit-trail,
        ngm:compliance-audit-trail,
        ngm:virtual-notary-service ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:digital-certificate,
        ngm:digital-signature,
        ngm:timestamp ;
    vc:slug "timestamp-authority" ;
    vc:sourceDomain "security" ;
    vc:supports ngm:archival-standards,
        ngm:digital-signature-verification ;
    vc:uses ngm:cryptographic-hash-function,
        ngm:cryptographic-signature .

ngm:tiny-ml a owl:Class ;
    rdfs:label "TinyML"@en ;
    rdfs:comment "Machine learning inference deployed on resource-constrained microcontrollers with kilobyte-scale RAM, milliwatt power budgets, and MHz-range processors, enabling always-on intelligent sensing in IoT devices, wearables, and embedded sensors without cloud connectivity. Requires aggressive model optimisation through INT8 quantisation, pruning, and knowledge distillation."@en ;
    rdfs:subClassOf ngm:ai-technique,
        ngm:deep-learning ;
    skos:broader ngm:ai-technique ;
    vc:enables ngm:ai-deployment ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:edge-ai-system,
        ngm:edge-computing,
        ngm:internet-of-things,
        ngm:knowledge-distillation-for-edge,
        ngm:on-device-learning ;
    vc:slug "tiny-ml" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:embedded-ai-frameworks,
        ngm:embedded-systems,
        ngm:model-compression-for-edge,
        ngm:model-pruning-for-edge-deployment,
        ngm:neural-network-quantisation .

ngm:tokeniser a owl:Class ;
    rdfs:label "Tokeniser"@en ;
    rdfs:comment "A tokeniser is a preprocessing component that segments raw text into a sequence of discrete tokens — sub-words, words, or characters — and maps each token to an integer identifier in a fixed vocabulary, forming the numerical input representation consumed by language model architectures. Modern sub-word tokenisers such as Byte Pair Encoding (BPE), WordPiece, and SentencePiece balance vocabulary coverage with sequence length efficiency, enabling models to handle arbitrary Unicode text including rare words, multilingual content, and specialised domains without out-of-vocabulary failures. The tokeniser vocabulary and its associated embedding matrix are co-trained with the model and constitute a foundational design decision that governs sequence length, memory footprint, and cross-lingual fairness. Multimodal extensions of tokenisation discretise images, audio, and video frames into token sequences analogous to text tokens, enabling unified cross-modal architectures."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:vocabulary ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:byte-pair-encoding ],
        ngm:natural-language-processing ;
    vc:bridgesTo ngm:computer-vision,
        ngm:speech-recognition ;
    vc:contrastsWith ngm:character-level-model,
        ngm:word-level-tokenisation ;
    vc:enables ngm:language-modeling,
        ngm:large-language-models,
        ngm:machine-translation,
        ngm:multimodal-learning ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:byte-pair-encoding,
        ngm:sentencepiece,
        ngm:unigram-language-model-tokeniser,
        ngm:wordpiece ;
    vc:isPartOf ngm:language-model-pre-training,
        ngm:natural-language-processing-pipeline ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:attention-mechanism,
        ngm:context-window,
        ngm:embedding-model,
        ngm:tokeniser-fertility ;
    vc:requires ngm:text-preprocessing,
        ngm:unicode-normalisation,
        ngm:vocabulary ;
    vc:slug "tokeniser" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:code-generation,
        ngm:multilingual-models,
        ngm:transformer-architecture ;
    vc:uses ngm:subword-tokenisation,
        ngm:token-embedding .

ngm:trust-anchor a owl:Class ;
    rdfs:label "Trust Anchor"@en ;
    rdfs:comment "A trust anchor is an authoritative entity or cryptographic artifact that serves as the root of a chain of trust, providing the foundational level of trust from which all subsequent trust assertions in a system are derived. In public key infrastructure (PKI), the trust anchor is typically a root certificate authority (CA) whose self-signed certificate is pre-installed in operating systems and browsers as inherently trusted, enabling the validation of all subordinate certificate chains. In decentralised identity systems, trust anchors may be governance-designated issuers, DID-based root entities, or on-chain registries whose cryptographic material is considered authoritative for a particular trust domain. Trust anchors define the scope and boundaries of a trust framework and are the entities that must be trusted by all relying parties in the system."@en ;
    rdfs:subClassOf ngm:trust-framework ;
    vc:enables ngm:decentralized-identity,
        ngm:identity-federation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:certificate-authority,
        ngm:cryptographic-verification,
        ngm:digital-certificate,
        ngm:trust-framework-policy ;
    vc:slug "trust-anchor" ;
    vc:sourceDomain "security" ;
    vc:uses ngm:cryptographic-keys,
        ngm:digital-signature .

ngm:validator a owl:Class ;
    rdfs:label "Validator"@en ;
    rdfs:comment "A validator is a network participant in a proof-of-stake blockchain that is responsible for proposing new blocks, attesting to the validity of blocks proposed by others, and participating in the finality mechanism of the network. Validators commit a quantity of cryptocurrency as collateral (stake), which is subject to slashing — partial or total confiscation — if the validator behaves dishonestly or fails liveness requirements. Through their collective attestations and proposals, validators form the active set that drives consensus and maintains the canonical chain history."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptographic-key ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:proof-of-stake ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:digital-signature ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:staking ],
        ngm:consensus-protocol ;
    vc:bridgesTo ngm:distributed-systems,
        ngm:fault-tolerance,
        ngm:game-theory ;
    vc:contrastsWith ngm:light-client,
        ngm:miner,
        ngm:proof-of-work ;
    vc:dependsOn ngm:block,
        ngm:peer-to-peer-network,
        ngm:slashing ;
    vc:enables ngm:block-finality,
        ngm:consensus-mechanism,
        ngm:decentralised-network ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:attestation,
        ngm:block-proposal,
        ngm:validator-committee ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:decentralised-finance,
        ngm:governance,
        ngm:smart-contract,
        ngm:tokenomics ;
    vc:requires ngm:cryptographic-key,
        ngm:digital-signature,
        ngm:proof-of-stake,
        ngm:staking ;
    vc:slug "validator" ;
    vc:sourceDomain "blockchain" .

ngm:verifiable-random-function a owl:Class ;
    rdfs:label "Verifiable Random Function"@en ;
    rdfs:comment "A Verifiable Random Function (VRF) is a cryptographic primitive, introduced by Micali, Rabin, and Vadhan (1999), that maps an input to a pseudorandom output and produces a non-interactive proof allowing any third party to verify that the output was computed correctly from a given public key and input without learning the private key. The VRF owner possesses a private key SK and public key PK; given input alpha, they compute output beta and proof pi such that any verifier with PK can confirm that beta = VRF(SK, alpha) without requiring SK. VRFs provide both uniqueness (exactly one valid output per key-input pair) and pseudorandomness (output is indistinguishable from random to anyone without SK). They are deployed in blockchain systems for unpredictable, manipulation-resistant leader election (Algorand, Cardano, Hedera), NFT trait generation, on-chain lotteries, and as the cryptographic core of Chainlink VRF and similar oracle randomness services."@en ;
    rdfs:subClassOf ngm:cryptographic-proof ;
    vc:bridgesTo ngm:decentralised-autonomous-organisation,
        ngm:non-fungible-token ;
    vc:contrastsWith ngm:commit-reveal-scheme,
        ngm:trusted-execution-environment ;
    vc:dependsOn ngm:secret-sharing,
        ngm:threshold-cryptography ;
    vc:enables ngm:blockchain-gaming,
        ngm:consensus-mechanism,
        ngm:oracle-network,
        ngm:proof-of-stake,
        ngm:randomness-beacon ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:ecvrf,
        ngm:pseudorandom-function ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:decentralised-randomness,
        ngm:leader-election,
        ngm:random-number-generation ;
    vc:requires ngm:discrete-logarithm-problem,
        ngm:non-interactive-zero-knowledge-proof ;
    vc:slug "verifiable-random-function" ;
    vc:sourceDomain "security" ;
    vc:supports ngm:blockchain-oracle,
        ngm:decentralised-finance,
        ngm:smart-contract ;
    vc:uses ngm:cryptographic-commitment,
        ngm:elliptic-curve-cryptography,
        ngm:hash-function,
        ngm:public-key-cryptography,
        ngm:schnorr-signature .

ngm:virtual-event a owl:Class ;
    rdfs:label "Virtual Event"@en ;
    rdfs:comment "A Virtual Event is a digitally mediated gathering in which geographically distributed participants convene within a shared virtual environment — rendered through web browsers, desktop clients, or immersive XR headsets — to engage in social, educational, commercial, or cultural activities in real or near-real time. The class encompasses a spectrum from simple webinar-style presentations and live-streamed concerts, through avatar-populated social spaces, to fully embodied multi-user XR experiences featuring spatial audio, persistent virtual objects, and interactive exhibits. Virtual Events differ from asynchronous digital content by requiring simultaneous presence and bidirectional communication channels, and they differ from purely textual virtual spaces by incorporating rich media and, optionally, three-dimensional spatial representation. Their design draws on principles from event management, human-computer interaction, streaming media infrastructure, and spatial computing."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:content-delivery-network ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:avatar ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:real-time-communication ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:breakout-room ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:spatial-audio ],
        ngm:distributed-collaboration ;
    skos:broader ngm:distributed-collaboration ;
    vc:bridgesTo ngm:digital-economy,
        ngm:metaverse,
        ngm:non-fungible-token ;
    vc:contrastsWith ngm:hybrid-event,
        ngm:physical-event ;
    vc:dependsOn ngm:cloud-infrastructure,
        ngm:identity-management,
        ngm:webrtc ;
    vc:enables ngm:digital-exhibition,
        ngm:remote-collaboration,
        ngm:telecollaboration,
        ngm:virtual-networking ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:breakout-room,
        ngm:live-streaming,
        ngm:spatial-audio,
        ngm:virtual-venue ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:event-platform,
        ngm:immersive-experience,
        ngm:presence ;
    vc:requires ngm:avatar,
        ngm:content-delivery-network,
        ngm:real-time-communication ;
    vc:slug "virtual-event" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:accessibility,
        ngm:digital-twin ;
    vc:uses ngm:augmented-reality,
        ngm:video-conferencing,
        ngm:virtual-reality .

ngm:virtual-production-volume a owl:Class ;
    rdfs:label "Virtual Production Volume"@en ;
    rdfs:comment "Large-scale physical LED wall or projection stage environment that merges live-action footage with real-time rendered 3D backgrounds, including LED panels, tracking systems, camera infrastructure, and stage hardware."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
