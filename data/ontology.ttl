ngm:multi-armed-bandit a owl:Class ;
    rdfs:comment "A sequential decision-making framework in which an agent repeatedly chooses among a fixed set of actions ('arms') with unknown reward distributions, observing only the reward of the chosen arm, and seeks to maximise cumulative reward — equivalently, to minimise regret against the best arm in hindsight; it isolates the exploration–exploitation trade-off in its purest form, since unlike a full Markov decision process the environment has no state transitions, and underpins algorithms such as epsilon-greedy, UCB, and Thompson sampling used in A/B testing, recommendation, and adaptive experimentation."@en ;
    rdfs:label "Multi-Armed Bandit"@en ;
    rdfs:subClassOf ngm:reinforcement-learning ;
    vc:contrastsWith ngm:markov-decision-process ;
    vc:dependsOn ngm:exploration-exploitation-tradeoff ;
    vc:enables ngm:a-b-testing ;
