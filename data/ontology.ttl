# Glossary_Index
spatial-computing:Glossary_Index rdf:type owl:Class ;
    rdfs:label "Glossary_Index"@en ;
    rdfs:comment "Comprehensive index and organisational framework for metaverse ontology terminology covering 229+ core concepts spanning immersive technologies (AugmentedReality, SpatialComputing), virtual environments (VirtualWorld, DigitalTwin), digital identity and assets (DigitalAvatar, VirtualAsset), blockchain integration (SmartContract, Cryptocurrency), AI systems (NeuralNetwork, ReinforcementLearning), and robotics (ManipulatorArm, AutonomousSystem) organised alphabetically and by semantic domain to enable cross-domain navigation and discovery of interconnected metaverse concepts with standardised URI references enabling semantic linking across distributed knowledge graphs."@en ;
    skos:prefLabel "Glossary_Index"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:spatial-computing:glossaryindex" ;
