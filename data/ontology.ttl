        ngm:cross-chain-bridge,
        ngm:proof-of-stake,
        ngm:smart-contract ;
    vc:requires ngm:consensus-mechanism,
        ngm:nominated-proof-of-stake,
        ngm:validator-node,
        ngm:web-assembly ;
    vc:slug "polkadot-parachains" ;
    vc:sourceDomain "blockchain" .

ngm:positional-audio a owl:Class ;
    rdfs:label "Positional Audio"@en ;
    rdfs:comment "Positional Audio is a technique for rendering sound sources at specific locations within a 3D virtual or mixed-reality environment, simulating how sound propagates, attenuates, and is spatially perceived by the listener. It relies on head-related transfer functions (HRTFs) and room acoustics modelling to create realistic auditory presence."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:audio-spatialization ],
        ngm:sc-display-and-rendering ;
    skos:broader ngm:sc-display-and-rendering ;
    vc:enables ngm:immersive-audio-system,
        ngm:spatial-audio ;
    vc:hasMaturity ngmi:maturity-emerging ;
