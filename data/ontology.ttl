ngm:resilience-metric a owl:Class ;
    rdfs:label "Resilience Metric"@en ;
    rdfs:comment "Resilience metrics are quantitative and qualitative measurements that assess the robustness, fault tolerance, and recovery capabilities of digital and physical infrastructure. Core indicators include availability percentage, Recovery Time Objective (RTO), Recovery Point Objective (RPO), Mean Time Between Failures (MTBF), and Mean Time to Repair (MTTR). Effective resilience measurement combines real-time monitoring, predictive analytics, and automated remediation to maintain service quality under adverse conditions and verify SLA compliance."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cloud-infrastructure ],
        ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:bridgesTo ngm:distributed-systems ;
    vc:enables ngm:computing-infrastructure ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.4"^^xsd:float ;
    vc:relatedTo ngm:fault-tolerance,
        ngm:reliability ;
    vc:requires ngm:cloud-infrastructure ;
    vc:slug "resilience-metric" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:anomaly-detection,
        ngm:compliance-monitoring .

