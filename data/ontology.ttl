ngm:immersive-experience-pipeline a owl:Class ;
    rdfs:label "Immersive Experience Pipeline"@en ;
    rdfs:comment "The end-to-end workflow for creating, processing, and delivering XR content, encompassing concept design, 3D asset creation, game engine integration, optimisation, platform deployment, and cloud streaming to produce immersive virtual experiences for metaverse applications."@en ;
    rdfs:subClassOf ngm:content-production-workflow,
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
