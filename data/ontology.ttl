ngm:threat-detection a owl:Class ;
    rdfs:label "Threat Detection"@en ;
    rdfs:comment "Threat detection is the cybersecurity discipline concerned with identifying malicious or anomalous activity within a system or network in time to enable an effective defensive response, distinguishing genuine threats from benign anomalies across high-volume, noisy telemetry. It encompasses signature-based detection of known attack patterns, behavioural analytics for novel threats, and machine learning models that model normal system baselines and flag statistical deviations. Effective threat detection must balance sensitivity (catching real attacks) against specificity (avoiding alert fatigue from false positives)."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:telemetry ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:log-management ],
        ngm:cybersecurity ;
    vc:bridgesTo ngm:adversarial-machine-learning,
        ngm:supply-chain-security ;
    vc:contrastsWith ngm:vulnerability-scanning ;
    vc:enables ngm:incident-response,
        ngm:security-operations,
        ngm:threat-hunting,
        ngm:threat-surface-map ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:anomaly-detection,
        ngm:attack-vector,
        ngm:intrusion-detection-system,
        ngm:security-information-and-event-management,
        ngm:threat-actor,
        ngm:threat-intelligence,
        ngm:threat-model ;
    vc:requires ngm:log-management,
        ngm:telemetry ;
    vc:slug "threat-detection" ;
    vc:sourceDomain "security" ;
    vc:supports ngm:information-security,
        ngm:network-security,
        ngm:vulnerability-management,
        ngm:zero-trust-architecture ;
    vc:uses ngm:ai-security,
        ngm:behavioural-analytics,
        ngm:endpoint-detection-and-response,
        ngm:machine-learning .

ngm:timestamp a owl:Class ;
    rdfs:label "Timestamp"@en ;
    rdfs:comment "A recorded value indicating the time of block creation in a blockchain system, embedded in each block header to establish chronological ordering of the chain and enable time-based protocol rules. Timestamps support difficulty adjustment, consensus validity checks, and provide an immutable audit trail for transaction ordering and data provenance."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptographic-hash ],
        ngm:distributed-data-structure ;
    vc:bridgesTo ngm:digital-signature,
        ngm:trusted-timestamping ;
    vc:contrastsWith ngm:logical-clock,
        ngm:vector-clock ;
    vc:dependsOn ngm:consensus-protocol,
        ngm:proof-of-work ;
    vc:enables ngm:block-height,
        ngm:data-provenance,
        ngm:difficulty-adjustment,
        ngm:finality ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:block,
        ngm:block-header,
        ngm:merkle-tree ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:audit-trail,
        ngm:blockchain-transaction,
        ngm:transaction-confirmation ;
    vc:requires ngm:cryptographic-hash,
        ngm:network-time-protocol ;
    vc:slug "timestamp" ;
    vc:sourceDomain "blockchain" ;
    vc:standardizedBy ngm:ieee-2418-1,
        ngm:iso-iec-23257-2021 ;
    vc:supports ngm:smart-contract,
        ngm:time-locked-transaction ;
    vc:uses ngm:block-time .

ngm:value-function a owl:Class ;
    rdfs:label "Value Function"@en ;
    rdfs:comment "A value function in reinforcement learning estimates the expected cumulative future reward obtainable from a given state (state-value) or state-action pair (action-value) under a particular policy. It captures the long-term desirability of situations rather than immediate reward, and satisfies the recursive Bellman equation that relates the value of a state to the values of its successors. Value functions are central to dynamic programming, temporal-difference learning, and actor-critic methods, providing the signal that guides an agent toward reward-maximising behaviour."@en ;
    rdfs:subClassOf ngm:reinforcement-learning ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:machine-learning-discipline ;
    vc:slug "value-function" ;
    vc:sourceDomain "ai" ;
    vc:supports ngm:optimal-control ;
    vc:uses ngm:markov-decision-process .

ngm:video-generation a owl:Class ;
    rdfs:label "Video Generation"@en ;
    rdfs:comment "Video generation is the AI-driven synthesis of temporally coherent video sequences from text prompts, reference images, or other conditioning signals using generative models such as latent diffusion, autoregressive transformers, or flow-matching networks. Unlike image generation, video synthesis must maintain temporal consistency across frames, model object trajectories and camera motion, and produce physically plausible dynamics across variable-length sequences. Contemporary approaches encode video into a compressed spatiotemporal latent space via a 3D variational autoencoder, apply a diffusion or flow-matching process in that space conditioned on text or visual embeddings, then decode to pixel space. Scaling laws, large curated training datasets, and architectural advances such as full spatiotemporal attention have driven rapid capability growth, enabling cinematic-quality outputs at multiple seconds of duration."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:text-encoder ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:motion-estimation ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:classifier-free-guidance ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gpu-compute ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:diffusion-model ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:vae ],
        ngm:generative-ai ;
    vc:bridgesTo ngm:metaverse-content,
        ngm:virtual-production ;
    vc:contrastsWith ngm:deepfake-detection,
        ngm:image-generation ;
    vc:dependsOn ngm:clip,
        ngm:flow-matching,
        ngm:latent-diffusion,
        ngm:transformer-architecture ;
    vc:enables ngm:autonomous-driving-simulation,
        ngm:content-creation,
        ngm:synthetic-media ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:classifier-free-guidance,
        ngm:motion-estimation,
        ngm:vae ;
    vc:isPartOf ngm:generative-ai,
        ngm:multimodal-ai-architecture-ai ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:neural-rendering,
        ngm:video-understanding,
        ngm:world-model ;
    vc:requires ngm:diffusion-model,
        ngm:gpu-compute,
        ngm:large-scale-training-data,
        ngm:text-encoder ;
    vc:slug "video-generation" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:convolution,
        ngm:cross-attention,
        ngm:optical-flow,
        ngm:variational-autoencoder .

ngm:ai-agent a owl:Class ;
