    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:embedded-systems,
        ngm:sensor-data ;
    vc:slug "internet-of-things" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:mqtt,
        ngm:sensor .

ngm:ontology a owl:Class ;
    rdfs:label "Ontology"@en ;
    rdfs:comment "In computer science and knowledge engineering, an ontology is a formal, machine-readable specification of a shared conceptualisation within a domain: it explicitly defines the classes of entities that exist, the properties and attributes of those entities, the relationships (object properties) that may hold between them, and the logical axioms that constrain valid world states. Ontologies are expressed using languages such as OWL 2 (Web Ontology Language) built atop RDF, enabling automated reasoning engines to infer implicit knowledge and detect logical inconsistencies. They serve as the schema and semantic backbone of knowledge graphs, linked data systems, and interoperability frameworks across domains."@en ;
    rdfs:subClassOf ngm:infra-data-management ;
    skos:broader ngm:infra-data-management ;
    vc:enables ngm:knowledge-graph,
        ngm:semantic-search ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:knowledge-representation,
        ngm:linked-data,
        ngm:sparql ;
    vc:slug "ontology" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:owl-class-hierarchy,
        ngm:rdf .

ngm:peer-to-peer-network a owl:Class ;
    rdfs:label "Peer-to-Peer Network"@en ;
    rdfs:comment "A decentralised communication architecture in which participating nodes connect directly to one another without a central coordinator, enabling distributed ledger technology to broadcast transactions, propagate blocks, and maintain a shared state across an open membership set. It underlies the censorship resistance and fault tolerance of blockchain systems."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:archival-node ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:bootstrap-node ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:full-node ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:mempool ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:transaction-pool ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:gossip-protocol ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:peer-discovery ],
        ngm:bc-network-component,
        ngm:blockchain-entity ;
    skos:broader ngm:bc-network-component ;
    vc:enables ngm:blockchain-network,
        ngm:nakamoto-consensus ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:archival-node,
        ngm:bootstrap-node,
        ngm:full-node,
        ngm:gossip-protocol,
        ngm:mempool,
        ngm:peer-discovery,
        ngm:transaction-pool ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:blockchain,
        ngm:consensus-protocol ;
    vc:slug "peer-to-peer-network" ;
    vc:sourceDomain "blockchain" .

ngm:sensor a owl:Class ;
    rdfs:label "Sensor"@en ;
    rdfs:comment "Sensors are devices and systems that enable robots to perceive and measure their environment through the detection of physical phenomena."@en ;
    rdfs:subClassOf ngm:hardware-component,
