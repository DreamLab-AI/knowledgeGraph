ngm:noise-suppression a owl:Class ;
    rdfs:label "Noise Suppression"@en ;
    rdfs:comment "Noise suppression is a signal-processing technique that filters ambient, background, and non-speech sounds from audio streams in real time during virtual communication sessions. Modern implementations use deep-learning models to distinguish voice from environmental noise such as keyboard clicks, fan hum, and room echo. It is a foundational audio quality feature for distributed teams working from heterogeneous home or office environments."@en ;
    rdfs:subClassOf ngm:dc-communication ;
    skos:broader ngm:dc-communication ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:live-captions,
        ngm:webinar-broadcast ;
    vc:slug "noise-suppression" ;
    vc:sourceDomain "distributed-collaboration" .

ngm:non-maximum-suppression a owl:Class ;
    rdfs:label "Non Maximum Suppression"@en ;
    rdfs:comment "Non-Maximum Suppression (NMS) is a post-processing algorithm used in object detection to eliminate redundant overlapping bounding box proposals by retaining only the highest-confidence detection and discarding lower-confidence boxes that exceed a predefined intersection-over-union (IoU) threshold. The procedure iteratively selects the detection with the highest class score, suppresses all remaining boxes that sufficiently overlap with it, and repeats until no candidates remain. NMS is a critical component of single-stage and two-stage detectors including YOLO, SSD, and Faster R-CNN families. Soft-NMS and class-agnostic variants address edge cases where multiple legitimate objects are densely packed."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:computer-vision ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:bounding-box-regression ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:bounding-box-regression ],
        ngm:object-detection ;
    vc:contrastsWith ngm:object-detection-and-tracking ;
    vc:dependsOn ngm:object-detection ;
    vc:enables ngm:computer-vision-task,
        ngm:object-detection ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:bounding-box-regression,
        ngm:computer-vision ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:bounding-volume,
        ngm:bounding-volume-hierarchy,
        ngm:heatmap-regression ;
    vc:requires ngm:bounding-box-regression ;
    vc:slug "non-maximum-suppression" ;
    vc:sourceDomain "machine-learning" ;
    vc:supports ngm:computer-vision-system,
        ngm:real-time-ai-inference ;
    vc:uses ngm:convolutional-neural-network,
        ngm:machine-learning .

ngm:nvidia-corporation a owl:Class ;
    rdfs:label "NVIDIA Corporation"@en ;
    rdfs:comment "NVIDIA Corporation is an American multinational technology company specialising in the design and manufacture of graphics processing units (GPUs), system-on-chip units, and related software platforms that underpin modern parallel computing workloads. Founded in 1993, NVIDIA pioneered the GPU category and subsequently extended its platform to cover artificial intelligence accelerators, high-performance computing, autonomous vehicles, robotics, and data centre infrastructure. Its CUDA parallel-computing platform, combined with purpose-built AI accelerator hardware such as the A100 and H100, has made NVIDIA the dominant supplier of compute for training large language models and other deep neural networks. NVIDIA's vertically integrated hardware-software stack—spanning chips, drivers, libraries, and cloud services—positions the company as foundational infrastructure for the AI era."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:semiconductor-fabrication ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
