ngm:single-sign-on a owl:Class ;
    rdfs:comment "Single Sign-On (SSO) is an authentication architecture in which a user authenticates once to a central Identity Provider (IdP) and receives a cryptographically signed assertion or token that grants access to multiple independent service providers without re-entering credentials. Dominant protocol implementations include SAML 2.0 (XML-based assertions), OpenID Connect layered over OAuth 2.0 (JSON Web Token–based), and Kerberos (ticket-granting ticket mechanism in Windows/Active Directory environments). SSO reduces credential exposure and attack surface by centralising authentication at a hardened IdP, simplifies user lifecycle management across enterprise systems, and is the cornerstone of modern Identity and Access Management platforms encompassing provisioning, deprovisioning, and audit."@en ;
    rdfs:label "Single Sign-On"@en ;
    rdfs:subClassOf ngm:authentication ;
    rdfs:subClassOf _:r19380 ;
    rdfs:subClassOf _:r19381 ;
    rdfs:subClassOf _:r19382 ;
    rdfs:subClassOf _:r19383 ;
