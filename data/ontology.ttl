ngm:update-cycle a owl:Class ;
    rdfs:label "Update Cycle"@en ;
    rdfs:comment "An Update Cycle is the recurring interval at which knowledge artefacts, links, or system components are reviewed and refreshed to maintain accuracy and relevance. In knowledge graph and documentation contexts, update cycles are defined per content type based on the rate of underlying change, balancing maintenance effort against information staleness."@en ;
    rdfs:subClassOf ngm:infra-software-engineering ;
    skos:broader ngm:infra-software-engineering ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:knowledge-management,
        ngm:version-control ;
    vc:slug "update-cycle" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:documentation-standards,
        ngm:knowledge-management-system .

ngm:us-regulatory-framework a owl:Class ;
    rdfs:label "US Regulatory Framework"@en ;
    rdfs:comment "The US Regulatory Framework for cryptocurrency operates through a fragmented multi-agency structure in which the SEC applies securities law to tokens, FinCEN supervises money transmission and anti-money laundering compliance, the CFTC regulates commodity-classified digital assets and derivatives, and the OCC addresses banking integration. This jurisdictional overlap creates significant compliance complexity for exchanges, DeFi protocols, and digital asset issuers absent comprehensive Congressional legislation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:blockchain-compliance ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:aml-kyc-compliance ],
        ngm:bc-governance-and-regulation ;
    skos:broader ngm:bc-governance-and-regulation ;
    vc:contrastsWith ngm:bc-governance-and-regulation ;
    vc:dependsOn ngm:blockchain-governance ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:digital-asset,
        ngm:securities-regulation,
        ngm:stablecoin-regulation ;
    vc:requires ngm:aml-kyc-compliance,
        ngm:blockchain-compliance ;
    vc:slug "us-regulatory-framework" ;
    vc:sourceDomain "blockchain" .

ngm:usd-pipeline a owl:Class ;
    rdfs:label "USD Pipeline"@en ;
    rdfs:comment "A USD pipeline is a content production workflow built around Pixar's Universal Scene Description (USD) format, which composes, layers and exchanges complex 3D scene data across digital-content-creation tools. USD enables non-destructive collaboration through composition arcs, variants and references, making it the interchange backbone for film, games and metaverse asset production. It standardises how geometry, materials, animation and motion-capture data flow between applications."@en ;
    rdfs:subClassOf ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:motion-capture,
        ngm:procedural-and-hybrid-4-d ;
    vc:slug "usd-pipeline" ;
    vc:sourceDomain "metaverse" .

ngm:user-consent-token a owl:Class ;
    rdfs:label "User Consent Token"@en ;
    rdfs:comment "A cryptographically verifiable digital token that represents and enforces user consent for data processing, collection, sharing, or participation in virtual environments with granular permission controls and revocation mechanisms."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptographic-keys ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:digital-identity ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-schema ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:consent-registry ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:privacy-policy ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:scope-definition ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:timestamp ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:cryptographic-signature ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:revocation-mechanism ],
        ngm:sc-governance-and-safety ;
    skos:broader ngm:sc-governance-and-safety ;
    vc:enables ngm:automated-privacy-compliance,
        ngm:consent-audit-trail,
