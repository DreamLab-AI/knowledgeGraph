ngm:key-management-system a owl:Class ;
    rdfs:comment "A key management system (KMS) is a service or appliance that generates, stores, rotates, distributes and revokes cryptographic keys over their full lifecycle. It enforces access policies and isolates key material, often backed by hardware security modules, so that applications can perform cryptographic operations without directly handling private keys. A KMS is foundational to secure identity, encryption and digital-asset custody."@en ;
    rdfs:label "Key Management System"@en ;
    rdfs:subClassOf ngm:infra-security-and-identity ;
    skos:broader ngm:infra-security-and-identity ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:custody-infrastructure ;
    vc:relatedTo ngm:decentralized-identifiers ;
    vc:slug "key-management-system" ;
    vc:sourceDomain "security" .
ngm:key-pair a owl:Class ;
    rdfs:comment "A Key Pair is the matched set of a public key and a corresponding private key used in asymmetric cryptography, where the two keys are mathematically related such that data encrypted or signed with one can only be processed with the other. The private key is kept secret by its owner, while the public key may be distributed openly, enabling encryption, digital signatures, and authentication without sharing a secret in advance. Key pairs underpin public-key infrastructure, blockchain wallets, secure messaging, and identity systems. Their security rests on the computational hardness of deriving the private key from the public key."@en ;
    rdfs:label "Key Pair"@en ;
    rdfs:subClassOf ngm:asymmetric-cryptography ;
    rdfs:subClassOf _:r13033 ;
    rdfs:subClassOf _:r13034 ;
    rdfs:subClassOf _:r13035 ;
    rdfs:subClassOf _:r13036 ;
