ngm:prudential-regulation a owl:Class ;
    rdfs:label "Prudential Regulation"@en ;
    rdfs:comment "Prudential regulation is the body of supervisory rules and oversight aimed at ensuring the safety and soundness of individual financial institutions and the stability of the wider financial system. It sets requirements for capital adequacy, liquidity, governance and risk management, and grants supervisors powers to monitor, intervene and resolve failing firms. Microprudential measures protect depositors and counterparties of single firms, while macroprudential measures address risks to the system as a whole."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:regulatory-reporting ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:stress-testing ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:capital-adequacy ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:risk-assessment ],
        ngm:financial-regulation ;
    vc:contrastsWith ngm:systemic-risk ;
    vc:dependsOn ngm:central-bank ;
    vc:enables ngm:financial-stability ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:capital-adequacy,
        ngm:stress-testing ;
    vc:implements ngm:basel-iii ;
    vc:isPartOf ngm:financial-regulation,
