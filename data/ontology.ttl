ngm:docker-containerisation-platform a owl:Class ;
    rdfs:label "Docker Containerisation Platform"@en ;
    rdfs:comment "Docker is an open-source platform that automates the deployment, scaling, and management of applications by packaging them together with their runtime dependencies into lightweight, portable containers built on Linux kernel primitives (namespaces and cgroups). Unlike virtual machines, Docker containers share the host operating system kernel, providing process and filesystem isolation with far lower overhead while guaranteeing consistent execution across heterogeneous computing environments. Launched in 2013 by Docker Inc., the platform introduced an intuitive developer-facing toolchain, a layered image format, and the Docker Hub public registry, collectively mainstreaming container technology and catalysing the cloud-native ecosystem. Docker standardised container packaging through the Open Container Initiative (OCI) specification and remains the dominant interface for building, distributing, and running container images in both development and production contexts."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:container-runtime ],
        ngm:software-platform ;
    vc:bridgesTo ngm:federated-learning,
        ngm:gpu-computing ;
    vc:contrastsWith ngm:serverless-architecture,
        ngm:virtual-machine ;
    vc:dependsOn ngm:cloud-platform,
        ngm:open-source-software ;
    vc:enables ngm:cloud-native-applications,
        ngm:continuous-integration,
        ngm:devops,
        ngm:machine-learning-discipline-infrastructure,
        ngm:microservices-architecture ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:container-image,
        ngm:container-registry,
        ngm:container-runtime ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:cloud-infrastructure,
        ngm:development-platform,
        ngm:kubernetes,
        ngm:software-infrastructure ;
    vc:requires ngm:linux-kernel ;
    vc:slug "docker-containerisation-platform" ;
    vc:sourceDomain "infrastructure" ;
    vc:standardizedBy ngm:open-container-initiative ;
    vc:supports ngm:edge-computing,
        ngm:machine-learning-discipline-pipeline,
        ngm:model-ops,
        ngm:software-engineering .

