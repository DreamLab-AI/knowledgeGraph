ngm:homomorphic-encryption a owl:Class ;
    rdfs:label "Homomorphic Encryption"@en ;
    rdfs:comment "Homomorphic Encryption (HE) is a cryptographic paradigm that permits arbitrary arithmetic and logical operations to be performed directly on ciphertext, yielding an encrypted result that, upon decryption, matches the outcome of the same operations applied to the original plaintext. Fully Homomorphic Encryption (FHE), first constructed by Craig Gentry in 2009 using ideal-lattice hard problems, supports an unbounded depth of operations and enables third parties — such as cloud compute providers — to process sensitive data without ever gaining access to it in plaintext form. Practical FHE schemes include BGV and BFV for exact integer arithmetic, CKKS for approximate real-number arithmetic (widely used in machine-learning inference), and TFHE for fast gate-by-gate bootstrapping over Boolean circuits."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:encryption-scheme ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:lattice-cryptography ],
        ngm:cryptography ;
    vc:bridgesTo ngm:confidential-computing,
        ngm:federated-learning,
        ngm:zero-knowledge-proof ;
    vc:contrastsWith ngm:differential-privacy,
        ngm:garbled-circuits,
        ngm:secure-enclave ;
    vc:dependsOn ngm:post-quantum-cryptography ;
    vc:enables ngm:federated-learning,
        ngm:homomorphic-encryption-for-machine-learning,
        ngm:secure-multi-party-computation ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:ckks-scheme,
        ngm:encryption-scheme ;
    vc:isPartOf ngm:privacy-preserving-technology ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:oblivious-ram,
        ngm:zero-knowledge-proof ;
    vc:requires ngm:lattice-cryptography ;
    vc:slug "homomorphic-encryption" ;
    vc:sourceDomain "security" ;
    vc:standardizedBy ngm:iso-iec-jtc-1 ;
    vc:supports ngm:cloud-computing,
        ngm:healthcare-data-privacy .

ngm:kinematics a owl:Class ;
    rdfs:label "Kinematics"@en ;
    rdfs:comment "Kinematics is the branch of mechanics that studies the geometry and mathematics of motion — positions, velocities, accelerations, and trajectories of bodies — without consideration of the forces or torques that cause that motion. In robotics and spatial computing, it encompasses forward kinematics (mapping joint-space parameters to Cartesian end-effector pose via homogeneous transformation matrices and Denavit-Hartenberg conventions) and inverse kinematics (solving the reverse mapping from desired pose to joint configurations). Kinematic analysis underpins motion planning, trajectory generation, workspace characterisation, collision avoidance, and animation systems across robotics, biomechanics, computer graphics, and autonomous vehicles."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:coordinate-frame ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:homogeneous-transformation ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:differential-kinematics ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:jacobian-matrix ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:forward-kinematics ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:denavit-hartenberg-parameters ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:inverse-kinematics ],
        ngm:robo-navigation-and-planning ;
    skos:broader ngm:robo-navigation-and-planning ;
    vc:bridgesTo ngm:augmented-reality,
        ngm:computer-animation,
        ngm:digital-twin ;
    vc:contrastsWith ngm:dynamics ;
    vc:dependsOn ngm:linear-algebra,
        ngm:rigid-body-dynamics ;
    vc:enables ngm:collision-avoidance,
        ngm:motion-planning,
        ngm:robot-dynamics,
        ngm:trajectory-generation,
        ngm:workspace-analysis ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:differential-kinematics,
        ngm:forward-kinematics,
        ngm:inverse-kinematics,
        ngm:jacobian-matrix ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:autonomous-vehicle,
        ngm:biomechanics ;
    vc:requires ngm:coordinate-frame,
        ngm:denavit-hartenberg-parameters,
        ngm:homogeneous-transformation ;
    vc:slug "kinematics" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:end-effector,
        ngm:kinematic-chain,
        ngm:manipulator,
        ngm:robot-joint .

ngm:knowledge-management a owl:Class ;
    rdfs:label "Knowledge Management"@en ;
    rdfs:comment "Knowledge Management (KM) is the systematic discipline of identifying, capturing, organising, storing, sharing, and applying the collective explicit and tacit knowledge assets of an organisation or distributed community to improve decision-making, innovation, and operational effectiveness. It integrates organisational theory, information science, and technology — spanning knowledge repositories, ontologies, semantic search, and communities of practice — to prevent knowledge loss, enable reuse, and accelerate learning. Modern KM increasingly employs AI-augmented techniques such as knowledge graphs, retrieval-augmented generation, and large language model reasoning to make both structured and unstructured knowledge discoverable and actionable by human and autonomous agents alike. It is a mature field with established frameworks (SECI, DIKW hierarchy, Cynefin) and dedicated standards bodies."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:metadata ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-governance ],
        ngm:infra-data-management ;
    skos:broader ngm:infra-data-management ;
    vc:bridgesTo ngm:distributed-collaboration,
        ngm:large-language-model,
