ngm:autonomous-driving-perception a owl:Class ;
    rdfs:label "Autonomous Driving Perception"@en ;
    rdfs:comment "The subsystem of an autonomous vehicle responsible for interpreting sensor data to construct a structured understanding of the vehicle's immediate environment, including the detection, classification, and tracking of objects, lane geometry, road surfaces, traffic signage, and dynamic actors. Autonomous driving perception fuses inputs from cameras, LiDAR, radar, and ultrasonic sensors to produce a real-time scene representation sufficient for safe navigation decisions."@en ;
    rdfs:subClassOf ngm:perception-system ;
    vc:enables ngm:autonomous-driving,
