    vc:standardizedBy ngm:iec-61508,
        ngm:iso-26262,
        ngm:iso-pas-8800 .

ngm:knowledge-graph-publication-classifier-key-infrastructure a owl:Class ;
    rdfs:label "Public Key Infrastructure"@en ;
    rdfs:comment "Public Key Infrastructure (PKI) is the integrated set of roles, policies, hardware, software, and procedures used to create, manage, distribute, use, store, and revoke digital certificates and manage public-key encryption. PKI binds public keys to verified entity identities through a hierarchical trust chain anchored by Certificate Authorities (CAs), enabling secure authentication, data integrity, and confidential communication across distributed and internet-scale systems. It forms the foundational security layer for TLS/HTTPS, code signing, S/MIME email encryption, VPN access, and emerging decentralised identity frameworks. PKI standards are governed principally by IETF RFCs (X.509, PKIX), NIST guidelines, CA/Browser Forum Baseline Requirements, and ISO/IEC 27001 family controls."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:digital-signature ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:asymmetric-cryptography ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:digital-certificate ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptographic-keys ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:certificate-authority ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:hash-function ],
        ngm:cryptographic-infrastructure ;
    vc:bridgesTo ngm:blockchain-identity,
        ngm:self-sovereign-identity,
        ngm:verifiable-credential ;
