    vc:sourceDomain "artificial-intelligence" .

vf:self-sovereign-identity a owl:Class ;
    rdfs:label "Self Sovereign Identity"@en ;
    rdfs:comment "Self-Sovereign Identity (SSI) is an identity management paradigm — first articulated as a systematic framework by Christopher Allen in \"The Path to Self-Sovereign Identity\" (April 2016) — where individuals hold and control cryptographically verifiable credentials in their own [[Digital Wallet]] rather than depending on [[Centralised Identity]] providers or [[Federated Identity]] intermediaries such as corporate identity providers, national databases, or single-sign-on brokers. SSI rests on three interdependent W3C open standards: [[Decentralized Identifiers]] (DID Core 1.0 became a W3C Recommendation in July 2022; v1.1 in Working Draft as of 2026), [[Verifiable Credentials]] (VC Data Model v2.0 became a W3C Recommendation in May 2025), and the DIDComm v2 secure messaging protocol maintained by the [[Decentralized Identity Foundation]]; these three layers together enable cryptographic proof of identity claims without requiring centralised databases or online validation calls to the issuing authority. Trust roots are anchored to [[Verifiable Data Registry]] infrastructure spanning permissioned ledgers ([[Hyperledger Indy]] underlying the [[Sovrin Network]]), public blockchains ([[Bit"@en ;
    rdfs:subClassOf <urn:visionflow:linked:decentralised-identity>,
        <urn:visionflow:linked:privacy-enhancing-technology>,
        <urn:visionflow:linked:user-centric-identity>,
        vf:cryptographic-protocol,
        vf:digital-identity,
        vf:trust-framework ;
    vc:authorityScore "0.87"^^xsd:float ;
    vc:enables <urn:visionflow:linked:correlation-resistance>,
        <urn:visionflow:linked:cross-border-identity>,
        <urn:visionflow:linked:holder-binding>,
        <urn:visionflow:linked:offline-verification>,
        <urn:visionflow:linked:portable-identity>,
        <urn:visionflow:linked:privacy-preserving-kyc>,
        <urn:visionflow:linked:reusable-identity-verification>,
        <urn:visionflow:linked:selective-disclosure>,
        <urn:visionflow:linked:zero-knowledge-predicate-proof> ;
    vc:hasPart <urn:visionflow:linked:credential-definition>,
        <urn:visionflow:linked:credential-schema>,
        <urn:visionflow:linked:did-document>,
        <urn:visionflow:linked:didcomm>,
        <urn:visionflow:linked:link-secret>,
        <urn:visionflow:linked:revocation-registry>,
        <urn:visionflow:linked:selective-disclosure>,
        vf:decentralized-identifiers,
        vf:digital-wallet,
        vf:verifiable-credentials,
        vf:verifiable-data-registry,
        vf:zero-knowledge-proof ;
    vc:implements <urn:visionflow:linked:anon-creds>,
        <urn:visionflow:linked:bbs-signatures>,
        <urn:visionflow:linked:didcomm-v2>,
        <urn:visionflow:linked:iso-18013-5>,
        <urn:visionflow:linked:open-id-for-verifiable-credentials>,
        <urn:visionflow:linked:sd-jwt>,
        <urn:visionflow:linked:trust-over-ip-stack>,
        <urn:visionflow:linked:w3-c-did-core>,
        <urn:visionflow:linked:w3-c-verifiable-credentials> ;
    vc:maturity "production-ready" ;
    vc:qualityScore "0.52"^^xsd:float ;
    vc:requires <urn:visionflow:linked:issuer-agent>,
        <urn:visionflow:linked:key-management>,
        <urn:visionflow:linked:verifier-agent>,
        <urn:visionflow:linked:wallet-software>,
        vf:blockchain-oracle,
        vf:decentralized-identifiers,
        vf:governance-framework,
        vf:public-key-cryptography,
        vf:trust-framework,
        vf:verifiable-data-registry ;
    vc:slug "self-sovereign-identity" ;
    vc:sourceDomain "identity" .

