ngm:retrieval-augmented-generation-rag a owl:Class ;
    rdfs:label "Retrieval Augmented Generation - RAG"@en ;
    rdfs:comment "Retrieval Augmented Generation (RAG) is a neural architecture paradigm that augments large language model generation with dynamic retrieval of non-parametric external knowledge at inference time, enabling factually grounded, up-to-date, and citation-traceable responses without retraining model we..."@en ;
