    rdfs:label "Real Time Economy"@en .
ngm:real-time-graphics a owl:Class ;
    rdfs:comment "Real-time graphics is the field of computer graphics concerned with generating and displaying images fast enough to produce interactive, continuously updating visuals, typically at frame rates of sixty frames per second or higher. It prioritises low and predictable latency over photorealistic fidelity, relying on hardware acceleration and approximate rendering techniques. It is the foundation for games, simulations and immersive spatial computing experiences."@en ;
    rdfs:label "Real Time Graphics"@en ;
    rdfs:subClassOf ngm:computer-graphics ;
    rdfs:subClassOf _:r17694 ;
    rdfs:subClassOf _:r17695 ;
