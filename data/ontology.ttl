    vc:relatedTo ngm:hardware-abstraction,
        ngm:hardware-and-edge ;
    vc:slug "hardware" ;
    vc:sourceDomain "spatial-computing" .

ngm:healthcare-technology a owl:Class ;
    rdfs:label "Healthcare Technology"@en ;
    rdfs:comment "Healthcare Technology encompasses the digital tools, software systems, and AI-driven applications deployed in clinical and health management contexts, including medical imaging, electronic health records, clinical decision support, and telemedicine platforms. It bridges spatial computing, data analytics, and AI to improve diagnostic accuracy, treatment outcomes, and health system efficiency."@en ;
