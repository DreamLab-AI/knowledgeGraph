# Open AI
artificial-intelligence:Openai rdf:type owl:Class ;
    rdfs:subClassOf artificial-intelligence:AICompanies ;
    rdfs:label "Open AI"@en ;
    rdfs:comment "OpenAI is an American artificial intelligence company founded in December 2015, known for developing the GPT family of large language models, DALL-E image generation, and the Sora video model. Following an October 2025 restructuring, the non-profit OpenAI Foundation holds 26% of the for-profit OpenAI Group PBC (public benefit corporation), with Microsoft owning 27% and the company valued at $500 billion."@en ;
    skos:prefLabel "Open AI"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:artificial-intelligence:open-ai" ;
    owl:sameAs <urn:visionclaw:concept:artificial-intelligence:open-ai> ;
