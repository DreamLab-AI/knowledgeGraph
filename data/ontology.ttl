    rdfs:comment "A digital asset representation built on an existing blockchain platform that represents ownership, utility, or access rights, typically adhering to standardized protocols for transferability and interoperability, implemented as a cryptographically-secured unit that can be owned, transferred, and ..."@en ;
    rdfs:subClassOf ngm:bc-token-and-asset,
        ngm:blockchain-entity,
        ngm:digital-asset ;
    skos:broader ngm:bc-token-and-asset ;
    vc:enables ngm:decentralized-exchange,
        ngm:liquidity-pool,
        ngm:staking,
        ngm:yield-farming ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:slug "token" ;
    vc:sourceDomain "blockchain" .

ngm:token-embedding a owl:Class ;
    rdfs:label "Token Embedding"@en ;
    rdfs:comment "A learnable lookup table that maps each discrete token in a vocabulary to a dense continuous vector, providing the initial semantic encoding fed into transformer model layers. Embeddings are trained end-to-end and combined with positional encodings; they may be tied with the output un-embedding matrix to reduce parameter count and improve training stability."@en ;
    rdfs:subClassOf ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:enables ngm:natural-language-processing ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:encoder-decoder-architecture,
        ngm:transformer ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:relatedTo ngm:neural-network-layer,
        ngm:self-attention ;
    vc:slug "token-embedding" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:deep-learning .

ngm:tool-schema a owl:Class ;
    rdfs:label "Tool Schema"@en ;
    rdfs:comment "A tool schema is a structured, machine-readable specification — typically expressed in JSON Schema format — that formally describes a function or external capability callable by an AI agent: its name, natural-language description, parameter names and types, constraints, and which parameters are required. Tool schemas are provided to large language models at inference time as part of the system or user context, enabling the model to reason about which tools are available and to emit syntactically correct structured function-call outputs that an orchestration layer can execute. They are the core interface contract between AI models and the external systems they interact with."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:json-schema ],
        ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:enables ngm:function-calling,
        ngm:tool-use ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:agentic-ai,
        ngm:model-context-protocol,
        ngm:schema-registry ;
    vc:requires ngm:json-schema ;
    vc:slug "tool-schema" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:verifiable-data-registry a owl:Class ;
    rdfs:label "Verifiable Data Registry"@en ;
    rdfs:comment "A system that mediates the creation, verification, and resolution of decentralized identifiers and verifiable credentials, typically implemented as a blockchain, distributed ledger, or decentralized network for storing public key and revocation information."@en ;
    rdfs:subClassOf ngm:data-registry,
        ngm:infra-data-management ;
    skos:broader ngm:infra-data-management ;
    vc:enables ngm:digital-identity,
        ngm:self-sovereign-identity ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:slug "verifiable-data-registry" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:trust-framework ;
    vc:uses ngm:cryptography,
        ngm:distributed-ledger,
        ngm:public-key-infrastructure .

ngm:video-generation a owl:Class ;
    rdfs:label "Video Generation"@en ;
    rdfs:comment "Video generation is the AI-driven synthesis of temporally coherent video sequences from text prompts, images, or other conditioning inputs using generative models such as latent diffusion or transformer architectures. Beyond static spatial coherence, video generation must maintain temporal consistency across frames, respect physical motion dynamics, and handle variable-length sequences, making it substantially more constrained than image generation. Modern approaches typically encode video into a compressed latent space, apply a diffusion or autoregressive process in that space, and decode back to pixel space, with text conditioning provided via a cross-attention mechanism fed by a text encoder."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:text-encoder ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:diffusion-model ],
        ngm:ai-application ;
    skos:broader ngm:ai-application ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:image-generation,
        ngm:latent-diffusion,
        ngm:multimodal-ai ;
    vc:requires ngm:diffusion-model,
        ngm:text-encoder ;
    vc:slug "video-generation" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:transformer-architecture .

ngm:visual-odometry a owl:Class ;
    rdfs:label "Visual Odometry"@en ;
    rdfs:comment "Visual odometry (VO) is a technique for incrementally estimating the pose (position and orientation) of a camera-equipped agent by detecting and tracking salient features across consecutive image frames and computing the relative camera motion between them. It provides ego-motion estimation without relying on GPS, wheel encoders, or external beacons, making it applicable in GPS-denied environments such as indoor spaces, underground tunnels, and planetary surfaces. Visual odometry is typically combined with inertial measurement data (visual-inertial odometry, VIO) or loop-closure detection to bound drift and form complete SLAM systems."@en ;
    rdfs:subClassOf ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:enables ngm:autonomous-navigation,
        ngm:pose-estimation ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:inertial-measurement-unit,
        ngm:simultaneous-localisation-and-mapping ;
    vc:slug "visual-odometry" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:computer-vision,
        ngm:feature-extraction .

ngm:adversarial-robustness a owl:Class ;
    rdfs:label "Adversarial Robustness"@en ;
    rdfs:comment "The capability of an AI system to maintain correct and consistent behaviour when subjected to adversarial examples—inputs intentionally crafted with small, often imperceptible perturbations designed to cause misclassification or incorrect outputs. Defensive strategies include adversarial training, randomised smoothing, and ensemble methods, each offering different trade-offs between certified guarantees and computational cost."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ai-safety ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:security ],
        ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:contrastsWith ngm:attack-vector,
        ngm:vulnerability ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:resilience,
        ngm:risk ;
    vc:requires ngm:ai-safety,
        ngm:security ;
    vc:slug "adversarial-robustness" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:deep-learning .

ngm:agentic-workflow a owl:Class ;
    rdfs:label "Agentic Workflow"@en ;
    rdfs:comment "An agentic workflow is a structured pattern of autonomous agent behaviour in which an AI model iteratively plans, executes tool calls, observes results, and revises its approach until a goal is achieved or a stopping condition is met. Unlike single-pass inference, agentic workflows employ loops, branching logic, memory, and multi-step reasoning that may span seconds to hours and involve multiple specialised sub-agents. The pattern emerged from large language model capabilities (tool use, function calling, long context) and underlies systems such as AutoGPT, LangGraph, Claude's computer use, and OpenAI's Agents SDK."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:large-language-models ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:context-window ],
        ngm:workflow-automation ;
    vc:enables ngm:ai-agent-system,
        ngm:retrieval-augmented-generation,
        ngm:task-planning ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:agent-frameworks,
        ngm:agentic-ai,
        ngm:multi-agent-systems,
        ngm:orchestration,
        ngm:planning-and-scheduling ;
    vc:requires ngm:context-window,
        ngm:large-language-models ;
    vc:slug "agentic-workflow" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:chain-of-thought,
        ngm:function-calling,
        ngm:prompt-engineering,
        ngm:reasoning,
        ngm:tool-use .

ngm:ai-risk a owl:Class ;
    rdfs:label "AI Risk"@en ;
    rdfs:comment "The potential for AI systems to cause adverse effects on individuals, groups, organizations, communities, or society, arising from technical failures, security vulnerabilities, biased outcomes, privacy violations, or unintended consequences of system design, deployment, or operation."@en ;
    rdfs:subClassOf ngm:ai-governance-and-ethics,
        ngm:risk-management ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:enables ngm:ai-risk-assessment ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:slug "ai-risk" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:ai-safety-research a owl:Class ;
    rdfs:label "AI Safety Research"@en ;
    rdfs:comment "AI Safety Research is an interdisciplinary field that develops theoretical frameworks, empirical methods, and engineering techniques to ensure advanced AI systems behave in ways that are safe, reliable, and aligned with human values across a range of capability levels. The field spans near-term concerns — such as robustness, fairness, and adversarial resistance — and longer-term challenges including scalable oversight, corrigibility, and the avoidance of catastrophic risks from highly capable systems. It draws on machine learning, decision theory, formal verification, and cognitive science."@en ;
    rdfs:subClassOf ngm:ai-governance-and-ethics ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:enables ngm:ai-alignment,
        ngm:responsible-ai ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:ai-risk ;
    vc:slug "ai-safety-research" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:interpretability,
        ngm:red-teaming .

ngm:blockchain-oracle a owl:Class ;
    rdfs:label "Blockchain Oracle"@en ;
    rdfs:comment "A decentralized service that bridges blockchain smart contracts with external real-world data, enabling smart contracts to access off-chain information, execute based on real-world events, and interact with traditional systems while maintaining trustless verification and data integrity."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:price-oracle ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptographic-verification ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:oracle-network ],
        ngm:bc-network-component ;
    skos:broader ngm:bc-network-component ;
    vc:enables ngm:decentralized-finance-de-fi,
        ngm:smart-contract,
        ngm:smart-contract-execution ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:oracle-network,
        ngm:price-oracle ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:blockchain-network,
        ngm:distributed-ledger-technology,
        ngm:smart-contract-platform,
        ngm:smart-contracts ;
    vc:requires ngm:cryptographic-verification ;
    vc:slug "blockchain-oracle" ;
    vc:sourceDomain "blockchain" .

ngm:collision-avoidance a owl:Class ;
    rdfs:label "Collision Avoidance"@en ;
    rdfs:comment "Collision Avoidance - An active safety mechanism using Sensors (lidar, ultrasonic, vision) and path planning algorithms to detect obstacles and dynamically modify Robot Trajectories to prevent unintended contact with people, equipment, or structures."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:real-time-processing ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:perception-system ],
        ngm:robo-navigation-and-planning ;
    skos:broader ngm:robo-navigation-and-planning ;
    vc:enables ngm:autonomous-navigation,
        ngm:safe-human-robot-proximity ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:isPartOf ngm:motion-control,
        ngm:safety-system ;
    vc:qualityScore "0.58"^^xsd:float ;
    vc:requires ngm:emergency-stop,
        ngm:perception-system,
        ngm:real-time-processing ;
    vc:slug "collision-avoidance" ;
    vc:sourceDomain "robotics" .

ngm:computer-graphics a owl:Class ;
    rdfs:label "Computer Graphics"@en ;
    rdfs:comment "Computer Graphics is the discipline concerned with the computational synthesis, manipulation, and display of visual imagery, encompassing geometry processing, rendering algorithms, shading models, and real-time display pipelines. It forms the technical foundation for spatial computing, game engines, and all visual output in metaverse environments."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:rendering-pipeline ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:shader ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:rasterization ],
        ngm:sc-display-and-rendering ;
    skos:broader ngm:sc-display-and-rendering ;
    vc:enables ngm:3-d-animation,
        ngm:level-of-detail ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:rasterization,
        ngm:rendering-pipeline,
        ngm:shader ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:slug "computer-graphics" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:game-engine .

ngm:cyber-physical-systems a owl:Class ;
    rdfs:label "Cyber Physical Systems"@en ;
    rdfs:comment "Cyber Physical Systems (CPS) are engineered systems that tightly integrate computational processes with physical dynamics through networked sensing, actuation, and control. CPS span autonomous vehicles, industrial automation, smart infrastructure, and medical devices, requiring real-time feedback loops, embedded computing, and communication across heterogeneous networks while meeting safety-critical timing and reliability constraints."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:embedded-systems ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:internet-of-things ],
        ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:enables ngm:autonomous-vehicle,
        ngm:industrial-automation ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.3"^^xsd:float ;
    vc:relatedTo ngm:digital-twin,
        ngm:edge-computing ;
    vc:requires ngm:embedded-systems,
        ngm:internet-of-things ;
    vc:slug "cyber-physical-systems" ;
    vc:sourceDomain "robotics" .

ngm:data-lake a owl:Class ;
    rdfs:label "Data Lake"@en ;
    rdfs:comment "A centralized repository that stores structured, semi-structured, and unstructured data at any scale in its native format, deferring schema enforcement to query time (schema-on-read). Data lakes enable big-data analytics, machine learning pipelines, and exploratory analysis without upfront data modelling, serving as the foundational ingestion layer for modern data architectures."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:data-storage ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:batch-processing ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:data-pipeline ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:etl-pipeline ],
        ngm:ai-infrastructure,
        ngm:etsi-domain-data-management-ai ;
    vc:enables ngm:machine-learning-infrastructure,
        ngm:machine-learning-pipeline ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:batch-processing,
        ngm:data-pipeline,
        ngm:data-storage,
        ngm:etl-pipeline ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:data-fabric-architecture,
        ngm:data-storage-layer,
        ngm:graph-database ;
    vc:slug "data-lake" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:data-governance,
        ngm:vector-database .

ngm:decentralized-identity-did a owl:Class ;
    rdfs:label "Decentralized Identity (DID)"@en ;
    rdfs:comment "A W3C standard for self-sovereign digital identities that are globally unique, cryptographically verifiable, and controlled by the identity subject without requiring centralized authorities."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:did-document ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:distributed-ledger ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:verifiable-data-registry ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:public-key-infrastructure ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptographic-keys ],
        ngm:infra-security-and-identity ;
    skos:broader ngm:infra-security-and-identity ;
    vc:enables ngm:cross-domain-identity,
        ngm:decentralized-authentication,
        ngm:privacy-preserving-identity,
        ngm:verifiable-credential-vc ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:did-document,
        ngm:did-method,
        ngm:did-resolver,
        ngm:did-uri,
        ngm:verifiable-data-registry ;
    vc:isPartOf ngm:identity-management-system,
        ngm:self-sovereign-identity-ssi ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:cryptographic-keys,
        ngm:distributed-ledger,
        ngm:public-key-infrastructure ;
    vc:slug "decentralized-identity-did" ;
    vc:sourceDomain "infrastructure" .

ngm:decentralized-storage a owl:Class ;
    rdfs:label "Decentralized Storage"@en ;
    rdfs:comment "A distributed storage infrastructure distributing data across peer-to-peer networks rather than centralised data centres, enabling data persistence, redundancy, and access without single points of failure."@en ;
    rdfs:subClassOf ngm:infra-data-management,
        ngm:network-infrastructure ;
    skos:broader ngm:infra-data-management ;
    vc:contrastsWith ngm:network-infrastructure ;
    vc:enables ngm:censorship-resistance,
        ngm:digital-twin ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.4"^^xsd:float ;
    vc:slug "decentralized-storage" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:blockchain,
        ngm:content-addressing .

ngm:distributed-training a owl:Class ;
    rdfs:label "Distributed Training"@en ;
    rdfs:comment "Distributed training is a machine learning training strategy that partitions computation, data, and/or model parameters across multiple processors, accelerators, or nodes to accelerate training, handle models that exceed the memory capacity of a single device, and improve throughput. The principal parallelism strategies are data parallelism (each worker trains on a different data shard with gradients synchronised), model parallelism (different layers reside on different devices), tensor parallelism (individual weight matrices are partitioned across devices), and pipeline parallelism (different stages of the forward pass run concurrently on different devices). These approaches are frequently combined in large-scale training runs."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:machine-learning-infrastructure ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gpu-compute ],
        ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:enables ngm:model-training ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:deep-learning,
        ngm:distributed-computing,
        ngm:mixed-precision-training ;
    vc:requires ngm:gpu-compute,
        ngm:machine-learning-infrastructure ;
    vc:slug "distributed-training" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:etsi-metaverse-domain-taxonomy a owl:Class ;
    rdfs:label "Etsi Metaverse Domain Taxonomy"@en ;
    rdfs:comment "A hierarchical classification system developed by ETSI organising metaverse concepts, technologies, and services into structured categories, enabling consistent terminology, clear domain boundaries, and interoperable standards development across the telecommunications and immersive technology ind..."@en ;
    rdfs:subClassOf ngm:sc-platform-and-environment,
        ngm:taxonomy ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:enables ngm:standards-interoperability ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:slug "etsi-metaverse-domain-taxonomy" ;
    vc:sourceDomain "spatial-computing" .

ngm:fpga a owl:Class ;
    rdfs:label "FPGA"@en ;
    rdfs:comment "FPGA is a artificial intelligence concept and a type of Inference Hardware. that enables Custom Neural Architectures."@en ;
    rdfs:subClassOf ngm:ai-infrastructure,
        ngm:inference-hardware ;
    vc:enables ngm:custom-neural-architectures ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:slug "fpga" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:gas a owl:Class ;
    rdfs:label "Gas"@en ;
    rdfs:comment "Gas is the unit of computational work measurement within EVM-compatible blockchains. Every opcode executed by the Ethereum Virtual Machine consumes a defined gas quantity; users pay gas_price × gas_used to validators, preventing denial-of-service through unbounded computation and creating a market for block space."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:gas-limit ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:gas-price ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:gas-fee-market ],
        ngm:bc-protocol-and-consensus,
        ngm:blockchain-entity,
        ngm:economic-mechanism ;
    skos:broader ngm:bc-protocol-and-consensus ;
    vc:enables ngm:blockchain-transaction ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:gas-fee-market,
        ngm:gas-limit,
        ngm:gas-price ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:eip-1559,
        ngm:fee-market,
        ngm:smart-contract-execution,
        ngm:tokenomics,
        ngm:transaction-fee ;
    vc:slug "gas" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:smart-contract .

ngm:gpu-computing a owl:Class ;
    rdfs:label "GPU Computing"@en ;
    rdfs:comment "GPU Computing is the use of graphics processing units as massively parallel co-processors to accelerate general-purpose computational workloads beyond rendering. Modern GPUs contain thousands of shader cores organised into streaming multiprocessors capable of executing thousands of threads simultaneously, making them ideal for data-parallel algorithms in deep learning training, scientific simulation, and signal processing. Frameworks such as CUDA and OpenCL expose this parallelism to application developers. GPU computing has become the primary driver of progress in large-scale machine learning, enabling the training of models with hundreds of billions of parameters."@en ;
    rdfs:subClassOf ngm:hardware-acceleration ;
    vc:enables ngm:deep-learning,
        ngm:distributed-training,
        ngm:high-performance-computing ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:gpu-compute,
        ngm:inference-hardware,
        ngm:render-pipeline,
        ngm:tensor-processing-unit ;
    vc:slug "gpu-computing" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:compute-shader,
        ngm:cuda,
        ngm:parallel-processing .

ngm:haptics a owl:Class ;
    rdfs:label "Haptics"@en ;
    rdfs:comment "Physical hardware systems that simulate tactile sensations and force feedback within virtual environments through actuators and sensors."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:power-supply ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
