vf:camera-parameters a owl:Class ;
    rdfs:label "Camera Parameters"@en ;
    rdfs:comment "The intrinsic and extrinsic mathematical values that define a camera's optical characteristics and spatial positioning, comprising focal length, optical center, distortion coefficients (intrinsic) and rotation/translation relative to world coordinates (extrinsic), essential for 3D reconstruction and photogrammetry."@en ;
    rdfs:subClassOf vf:imaging-parameters ;
