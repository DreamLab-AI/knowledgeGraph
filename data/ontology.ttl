    vc:sourceDomain "data" ;
    vc:supports ngm:sybil-resistance ;
    vc:uses ngm:activity-pub,
        ngm:nostr-protocol,
        ngm:pagerank .

ngm:sparql-endpoint a owl:Class ;
    rdfs:label "SPARQL Endpoint"@en ;
    rdfs:comment "A SPARQL Endpoint is a network-accessible service that accepts SPARQL Protocol and RDF Query Language queries and returns structured results over HTTP, enabling federated access to RDF knowledge graphs and linked data stores. It acts as the primary interface between client applications and triple stores, supporting SELECT, CONSTRUCT, ASK, and UPDATE operations. SPARQL Endpoints are foundational to the Semantic Web stack and to provenance-aware knowledge graph systems."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:query-processor ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:sparql-query-engine ],
        ngm:sc-standards-and-interop ;
    skos:broader ngm:sc-standards-and-interop ;
    vc:bridgesTo ngm:data-access-interface ;
    vc:enables ngm:knowledge-graph,
        ngm:linked-data,
        ngm:provenance-ontology-prov-o ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:query-processor,
        ngm:sparql-query-engine ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:database-query,
        ngm:graph-database,
        ngm:knowledge-representation,
        ngm:semantic-web-linked-data-standard,
        ngm:sparql-examples ;
    vc:slug "sparql-endpoint" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:json-data-interchange-format-ld,
        ngm:rdf,
        ngm:sparql .

ngm:spatial-anchors a owl:Class ;
    rdfs:label "Spatial Anchors"@en ;
    rdfs:comment "Spatial anchors are persistent, georeferenced coordinate frames that bind virtual content to specific physical locations, enabling augmented and mixed reality experiences to survive device handoffs, multi-user sessions, and temporal gaps between visits. They are constructed by fusing visual feature maps (point clouds or learned descriptors), inertial measurements, and optionally GPS or Ultra-Wideband signals to produce a stable six-degrees-of-freedom pose estimate within a real-world coordinate system. Platform-level implementations such as ARKit, ARCore, Azure Spatial Anchors, and OpenXR's XR_MSFT_spatial_anchor extension expose this capability through APIs that serialise anchor state for later relocalisation. The technology underpins cross-device shared AR, indoor navigation, and location-aware digital twins by ensuring that virtual overlays remain semantically and geometrically coupled to the objects and surfaces they annotate."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:feature-map ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:visual-inertial-odometry ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:pose-estimation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:sensor-fusion ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:slam ],
        ngm:ar-technology ;
    vc:bridgesTo ngm:geospatial-data,
        ngm:spatial-web ;
    vc:dependsOn ngm:coordinate-system ;
    vc:enables ngm:digital-twin,
        ngm:indoor-navigation,
        ngm:persistent-ar-placement,
        ngm:shared-ar-experiences ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:feature-map,
        ngm:pose-estimation ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:requires ngm:sensor-fusion,
        ngm:slam,
        ngm:visual-inertial-odometry ;
    vc:slug "spatial-anchors" ;
    vc:sourceDomain "spatial-computing" ;
    vc:standardizedBy ngm:arcore,
        ngm:arkit,
        ngm:open-xr ;
    vc:supports ngm:location-based-services,
        ngm:metaverse,
        ngm:mixed-reality ;
    vc:uses ngm:global-positioning-system,
        ngm:lidar,
        ngm:point-cloud,
        ngm:ultra-wideband .

ngm:spatial-database a owl:Class ;
    rdfs:label "Spatial Database"@en ;
    rdfs:comment "A database system optimized for storing, indexing, and querying georeferenced data and geometric objects, supporting spatial data types (points, lines, polygons) and spatial operations (intersection, containment, proximity) per OGC Simple Features specification for GIS and metaverse applications."@en ;
    rdfs:subClassOf ngm:database-system,
        ngm:infra-data-management ;
    skos:broader ngm:infra-data-management ;
    vc:enables ngm:geospatial-data ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:slug "spatial-database" ;
    vc:sourceDomain "infrastructure" .

ngm:speech-and-voice a owl:Class ;
