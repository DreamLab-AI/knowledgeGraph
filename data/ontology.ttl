ngm:consortium-blockchain a owl:Class ;
    rdfs:label "Consortium Blockchain"@en ;
    rdfs:comment "Consortium Blockchain is a permissioned distributed ledger architecture in which a pre-approved set of legally distinct organisations jointly operates the validator infrastructure, governs the protocol rules, and controls the read/write access matrix — occupying a deliberate middle position in th..."@en ;
    rdfs:subClassOf ngm:federated-system,
        ngm:multi-organisation-database ;
    vc:enables ngm:atomic-dv-p-settlement,
        ngm:regulatory-reporting-automation,
        ngm:selective-disclosure,
        ngm:supply-chain-provenance,
        ngm:tokenised-deposit,
        ngm:tokenised-real-world-asset,
        ngm:trade-finance-digitisation,
        ngm:wholesale-cbdc ;
    vc:hasPart ngm:certificate-authority,
        ngm:chaincode-container,
        ngm:channels-and-private-data-collections,
        ngm:endorsement-policy,
        ngm:membership-service-provider,
        ngm:notary-service,
        ngm:off-chain-data-store,
        ngm:ordering-service,
        ngm:validator-node ;
    vc:implements ngm:crash-fault-tolerant-ordering,
        ngm:ibft,
        ngm:pbft,
        ngm:proof-of-authority,
        ngm:qbft,
        ngm:raft-consensus,
        ngm:smart-bft ;
    vc:maturity "established" ;
    vc:qualityScore "0.52"^^xsd:float ;
    vc:relatedTo ngm:blockchain-interoperability,
        ngm:cbdc,
        ngm:distributed-ledger-technology,
        ngm:self-sovereign-identity,
        ngm:smart-contract,
        ngm:supply-chain-management,
        ngm:tokenisation,
        ngm:trade-finance,
        ngm:verifiable-credentials ;
    vc:requires ngm:byzantine-fault-tolerance,
        ngm:identity-management-system,
        ngm:multi-party-governance,
        ngm:network-membership-agreement,
        ngm:public-key-infrastructure,
        ngm:smart-contract-platform ;
    vc:slug "consortium-blockchain" ;
    vc:sourceDomain "blockchain" ;
    vc:standardizedBy ngm:enterprise-ethereum-alliance,
        ngm:eth-trust-security-levels,
        ngm:hyperledger-foundation,
        ngm:inter-work-alliance-token-taxonomy,
        ngm:iso-22739,
        ngm:iso-23257,
        ngm:iso-24165,
        ngm:iso-tr-23455,
        ngm:linux-foundation-decentralized-trust ;
    vc:supports ngm:citi-token-services,
        ngm:ebsi,
        ngm:hsbc-orion,
        ngm:ibm-food-trust,
        ngm:jpmorgan-onyx,
        ngm:kinexys,
        ngm:medi-ledger,
        ngm:project-agor,
        ngm:project-m-bridge,
        ngm:project-rosalind ;
    vc:uses ngm:azure-confidential-consortium-framework,
        ngm:go-quorum,
