ngm:activation-function a owl:Class ;
    rdfs:label "Activation Function"@en ;
    rdfs:comment "An Activation Function is a non-linear mathematical transformation applied to a neuron's weighted input sum, enabling neural networks to learn complex, non-linear mappings. Common variants include Sigmoid, Tanh, ReLU, Leaky ReLU, and GELU; the choice of activation function critically affects gradient flow, convergence speed, and model expressivity."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:backpropagation ],
        ngm:neural-network-component ;
    vc:bridgesTo ngm:neuromorphic-computing,
        ngm:quantum-neural-network ;
    vc:contrastsWith ngm:linear-activation,
        ngm:step-function ;
    vc:dependsOn ngm:neuron,
        ngm:weighted-sum ;
    vc:enables ngm:deep-learning,
        ngm:feature-learning,
        ngm:universal-approximation ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:derivative,
        ngm:nonlinearity ;
    vc:isPartOf ngm:feedforward-neural-network,
        ngm:neural-network ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:batch-normalisation,
        ngm:neural-network-layer,
        ngm:vanishing-gradient,
        ngm:weight-initialisation ;
    vc:requires ngm:backpropagation,
        ngm:differentiability ;
    vc:slug "activation-function" ;
    vc:sourceDomain "machine-learning" ;
    vc:standardizedBy ngm:iso-iec-22989-2022,
        ngm:onnx ;
    vc:supports ngm:convolutional-neural-network,
        ngm:recurrent-neural-network,
        ngm:transformer-architecture ;
    vc:uses ngm:gradient-descent .

ngm:ai-trustworthiness a owl:Class ;
    rdfs:label "AI Trustworthiness"@en ;
    rdfs:comment "The degree to which an AI system demonstrates characteristics that warrant confidence and reliance, encompassing transparency, explainability, fairness, accountability, robustness, reliability, safety, security, and privacy throughout its lifecycle."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
