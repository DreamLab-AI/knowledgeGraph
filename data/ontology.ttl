        ngm:search-space-definition,
        ngm:training-dataset ;
    vc:slug "auto-ml" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:avatar-standard a owl:Class ;
    rdfs:label "Avatar Standard"@en ;
    rdfs:comment "Avatar Standard refers to technical specifications defining file formats, data structures, rigging conventions, and metadata schemas for 3D humanoid avatars, particularly the VRM format built on glTF 2.0 that enables cross-platform avatar interoperability in metaverse environments."@en ;
    rdfs:subClassOf ngm:sc-standards-and-interop,
        ngm:technical-standard ;
    skos:broader ngm:sc-standards-and-interop ;
    vc:enables ngm:avatar-interoperability,
