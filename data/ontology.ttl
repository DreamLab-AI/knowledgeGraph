ngm:virtual-workspace a owl:Class ;
    rdfs:label "Virtual Workspace"@en ;
    rdfs:comment "A Virtual Workspace is a spatially organised digital environment — typically experienced through XR headsets or desktop 3D interfaces — that replicates or enhances the collaborative and cognitive functions of a physical office. It supports remote collaboration, persistent shared artefacts, spatial audio, and embodied presence, addressing the limitations of flat video-conferencing for complex knowledge work."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:avatar ],
