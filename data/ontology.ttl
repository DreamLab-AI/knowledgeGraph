ngm:2-d-li-dar a owl:Class ;
    rdfs:label "2D LiDAR"@en ;
    rdfs:comment "2D LiDAR is a laser scanning sensor that emits a rotating beam in a single horizontal or vertical plane, producing a planar point cloud used for obstacle detection, proximity sensing, and 2D mapping. It is widely deployed on mobile robots and autonomous guided vehicles where full 3D sensing is unnecessary or cost-prohibitive."@en ;
    rdfs:subClassOf ngm:robo-perception ;
    skos:broader ngm:robo-perception ;
    vc:bridgesTo ngm:lidar ;
    vc:enables ngm:localization,
        ngm:proximity-detection,
        ngm:simultaneous-localisation-and-mapping ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:robo-perception ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:3-d-li-dar,
        ngm:laser-scanner,
        ngm:point-cloud,
        ngm:proximity-sensor,
        ngm:slam,
        ngm:ultrasonic-sensor ;
    vc:slug "2-d-li-dar" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:lidar-scanning .

ngm:3-d-design a owl:Class ;
    rdfs:label "3D Design"@en ;
    rdfs:comment "3D Design is the creative and technical discipline of conceiving, modelling, and refining three-dimensional digital objects and environments for interactive, immersive, or real-time applications. It encompasses spatial composition, form language, and visual hierarchy adapted for game engines, virtual reality, and metaverse platforms, requiring performance-conscious workflows such as level-of-detail strategies, UV unwrapping, and real-time shader design."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:rendering-engine ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:3-d-modeling ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
