ngm:learning-platform-categorization a owl:Class ;
    rdfs:label "Learning Platform Categorization"@en ;
    rdfs:comment "A taxonomy of platforms and environments used to deliver educational experiences, spanning traditional learning management systems, online learning portals, virtual classrooms, immersive XR-based environments, and metaverse-native learning spaces. The categorization framework identifies dimensions such as modality (synchronous/asynchronous), immersion level, social presence, and assessment integration, enabling educators and institutions to select or compare platforms for pedagogical fit. In the spatial computing context, the taxonomy extends to cover platforms that leverage augmented reality, virtual reality, and simulated environments to enable experiential, collaborative, and gamified learning at scale."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:online-learning ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:learning-management-system ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:virtual-classroom ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:immersive-learning ],
        ngm:metaverse-classification,
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:immersive-learning,
        ngm:learning-management-system,
        ngm:online-learning,
        ngm:virtual-classroom ;
