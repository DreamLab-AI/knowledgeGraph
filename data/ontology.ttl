    vc:supports ngm:red-teaming ;
    vc:uses ngm:chain-of-custody,
        ngm:evidence-collection .

ngm:format-parser a owl:Class ;
    rdfs:label "Format Parser"@en ;
    rdfs:comment "Software components that interpret and convert various 3D asset file formats into internal representations for metaverse platforms, enabling interoperability between content creation tools and runtime environments whilst preserving geometry, materials, animations, and metadata."@en ;
