            owl:someValuesFrom ngm:data-integrity ],
        ngm:supply-chain ;
    vc:bridgesTo ngm:internet-of-things ;
    vc:dependsOn ngm:data-integrity,
        ngm:sensor-networks ;
    vc:enables ngm:asset-tracking,
        ngm:supply-chain-visibility,
        ngm:traceability ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:provenance,
        ngm:traceability ;
    vc:isPartOf ngm:supply-chain,
