ngm:salt a owl:Class ;
    rdfs:label "Salt"@en ;
    rdfs:comment "A Salt is a randomly generated value appended or prepended to input data before it is processed by a cryptographic hash function, ensuring that two identical inputs produce distinct hash outputs. Salts defeat precomputed dictionary and rainbow-table attacks on hashed credentials and commitments by making each hash unique even when the underlying plaintext is shared. In blockchain contexts, salts appear in commitment schemes, zero-knowledge proofs, and password-based key derivation functions, where they guarantee that a hash reveals no information about the original value to an observer who does not know the salt."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptographic-hash-function ],
        ngm:cryptographic-primitive ;
    vc:enables ngm:cryptographic-verification,
        ngm:differential-privacy ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:cryptography ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:cryptographic-commitment,
        ngm:cryptographic-keys,
        ngm:cryptographic-security,
        ngm:nonce ;
    vc:requires ngm:cryptographic-hash-function ;
    vc:slug "salt" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:cryptographic-protocol .

ngm:sanctions-compliance a owl:Class ;
    rdfs:label "Sanctions Compliance"@en ;
    rdfs:comment "Sanctions compliance is the set of controls organisations implement to avoid transacting with individuals, entities, jurisdictions, or assets prohibited by sanctions regimes such as those administered by the US OFAC, the EU, the UK OFSI, and the UN. It involves screening counterparties against sanctions lists, monitoring transactions for prohibited patterns, blocking or freezing prohibited dealings, and maintaining auditable records. In digital-asset markets it extends to wallet-address screening and analysis of fund provenance, posing distinctive challenges for permissionless and privacy-preserving systems."@en ;
    rdfs:subClassOf ngm:regulatory-compliance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:compliance,
        ngm:financial-regulation ;
    vc:slug "sanctions-compliance" ;
    vc:sourceDomain "governance" ;
    vc:supports ngm:risk-assessment ;
    vc:uses ngm:kyc .

ngm:satisfiability a skos:Concept ;
    rdfs:label "Satisfiability"@en .

ngm:satoshi-nakamoto a owl:Class ;
    rdfs:label "Satoshi Nakamoto"@en ;
    rdfs:comment "Satoshi Nakamoto is the pseudonym used by the unidentified person or group who designed Bitcoin, authored its 2008 white paper and released the first reference implementation in 2009. Nakamoto introduced a practical solution to double-spending in a peer-to-peer electronic cash system through proof-of-work and a public, append-only ledger. The true identity behind the name remains unknown, and Nakamoto withdrew from public involvement in the project around 2010 to 2011."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:peer-to-peer-network ],
        ngm:bc-protocol-and-consensus ;
    skos:broader ngm:bc-protocol-and-consensus ;
    vc:bridgesTo ngm:bc-cryptographic-primitive,
        ngm:distributed-systems,
        ngm:game-theory,
        ngm:internet-privacy ;
    vc:contrastsWith ngm:central-bank,
        ngm:trusted-third-party ;
    vc:enables ngm:bitcoin,
        ngm:blockchain,
        ngm:decentralised-consensus,
        ngm:peer-to-peer-electronic-cash,
        ngm:proof-of-work ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:distributed-ledger,
        ngm:nakamoto-consensus ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:bitcoin-white-paper,
        ngm:cryptocurrency,
        ngm:cypherpunk-movement,
        ngm:double-spend-problem,
        ngm:genesis-block,
        ngm:pseudonymity ;
    vc:requires ngm:peer-to-peer-network,
        ngm:timestamp-server ;
    vc:slug "satoshi-nakamoto" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:cryptographic-hash-function,
        ngm:digital-signature,
        ngm:elliptic-curve-cryptography,
        ngm:merkle-tree,
        ngm:unspent-transaction-output .

ngm:scalability-pattern a owl:Class ;
    rdfs:label "Scalability Pattern"@en ;
    rdfs:comment "A Scalability Pattern is a reusable architectural strategy that enables a system to handle increasing load by adding resources or restructuring components without degrading performance or reliability. Patterns include horizontal scaling (adding parallel instances), vertical scaling (increasing instance capacity), sharding, caching, and event-driven decomposition, each suited to different bottleneck profiles."@en ;
    rdfs:subClassOf ngm:infra-software-engineering ;
    skos:broader ngm:infra-software-engineering ;
    vc:enables ngm:distributed-systems,
        ngm:performance-optimization ;
    vc:hasMaturity ngmi:maturity-emerging ;
