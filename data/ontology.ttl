ngm:ai-game-agent a owl:Class ;
    rdfs:label "AI Game Agent"@en ;
    rdfs:comment "An intelligent autonomous entity within a video game or virtual environment that exhibits goal-directed behavior, adapts to player actions, and creates engaging interactive experiences through AI techniques including behavior trees, reinforcement learning, and procedural generation."@en ;
