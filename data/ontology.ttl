ngm:cryptographic-primitive a owl:Class ;
    rdfs:label "Cryptographic Primitive"@en ;
    rdfs:comment "The fundamental atomic building blocks of all cryptographic systems — including hash functions, symmetric and asymmetric ciphers, digital signatures, and key exchange protocols — each providing specific, well-defined security guarantees. Primitives are insufficient alone and must be combined in higher-level cryptographic protocols to satisfy multiple security requirements such as confidentiality, integrity, authentication, and non-repudiation. Correct selection and composition of primitives is the foundational concern of applied cryptography."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:hash-function ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:key-derivation-function ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:digital-signature ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:symmetric-encryption ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:random-number-generation ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:asymmetric-encryption ],
        ngm:bc-cryptographic-primitive,
        ngm:cryptography ;
    skos:broader ngm:bc-cryptographic-primitive ;
    vc:enables ngm:cryptographic-protocol,
        ngm:public-key-infrastructure,
        ngm:secure-multi-party-computation,
        ngm:zero-knowledge-proof ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:asymmetric-encryption,
        ngm:digital-signature,
        ngm:hash-function,
        ngm:key-derivation-function,
        ngm:random-number-generation,
        ngm:symmetric-encryption ;
    vc:isPartOf ngm:blockchain ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:elliptic-curve-cryptography,
        ngm:homomorphic-encryption,
        ngm:key-management,
        ngm:merkle-tree,
        ngm:post-quantum-cryptography,
        ngm:proof-of-work ;
    vc:slug "cryptographic-primitive" ;
    vc:sourceDomain "blockchain" .

ngm:gradient-descent a owl:Class ;
    rdfs:label "Gradient Descent"@en ;
    rdfs:comment "Gradient Descent is an iterative first-order optimisation algorithm that minimises a differentiable loss function by repeatedly updating model parameters in the direction of the negative gradient. It is the foundational optimisation strategy for training machine learning models, with variants including batch, stochastic, and mini-batch gradient descent, as well as adaptive-rate methods such as Adam and RMSProp."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:backpropagation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:loss-function ],
        ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:enables ngm:fine-tuning,
        ngm:model-training ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires ngm:backpropagation,
        ngm:loss-function ;
    vc:slug "gradient-descent" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:hyperparameter .

ngm:blockchain-transaction a owl:Class ;
    rdfs:label "Blockchain Transaction"@en ;
    rdfs:comment "A Blockchain Transaction is an atomic, cryptographically signed state-change operation recorded on a distributed ledger, representing value transfer, smart contract execution, or data mutation. Each transaction is validated by network nodes according to the active consensus algorithm, included in a block, and made immutable through chaining. Transaction structure, fee markets, and confirmation semantics vary across UTXO-based systems such as Bitcoin and account-based systems such as Ethereum."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:digital-signature ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:consensus-algorithm ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:public-key-cryptography ],
        ngm:bc-protocol-and-consensus ;
    skos:broader ngm:bc-protocol-and-consensus ;
    vc:enables ngm:payment-system,
        ngm:smart-contract ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:blockchain ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires ngm:consensus-algorithm,
        ngm:digital-signature,
        ngm:public-key-cryptography ;
    vc:slug "blockchain-transaction" ;
    vc:sourceDomain "blockchain" .

ngm:consensus-protocol a owl:Class ;
    rdfs:label "Consensus Protocol"@en ;
    rdfs:comment "Consensus Protocol is a blockchain and distributed systems concept and a type of blockchain."@en ;
    rdfs:subClassOf ngm:bc-protocol-and-consensus ;
    skos:broader ngm:bc-protocol-and-consensus ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:implements ngm:blockchain ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:slug "consensus-protocol" ;
    vc:sourceDomain "blockchain" .

ngm:public-key-cryptography a owl:Class ;
    rdfs:label "Public-Key Cryptography"@en ;
    rdfs:comment "An asymmetric cryptographic system using mathematically related key pairs — a public key for encryption or signature verification and a private key for decryption or signing — enabling secure communication, digital signatures, and authentication without requiring shared secrets. In blockchain systems it underpins wallet addresses, transaction signing, and identity verification."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:public-key ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:digital-signature ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:ecdsa ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:private-key ],
        ngm:bc-cryptographic-primitive,
        ngm:blockchain-entity,
        ngm:cryptographic-primitive ;
    skos:broader ngm:bc-cryptographic-primitive ;
    vc:enables ngm:authentication,
        ngm:cryptographic-key-management,
        ngm:digital-signature-verification ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:digital-signature,
        ngm:ecdsa,
        ngm:private-key,
        ngm:public-key ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:public-key-infrastructure,
        ngm:zero-knowledge-proof ;
    vc:slug "public-key-cryptography" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:asymmetric-encryption,
        ngm:elliptic-curve-cryptography .

ngm:bitcoin a owl:Class ;
    rdfs:label "Bitcoin"@en ;
    rdfs:comment "Bitcoin is the first decentralised peer-to-peer electronic cash system, introduced by the pseudonymous Satoshi Nakamoto in a 2008 white paper and launched in January 2009. It operates on a public, permissionless blockchain secured by proof-of-work consensus, with a fixed supply cap of 21 million BTC enforced by its protocol. Bitcoin is simultaneously a payment network, a monetary asset, and the foundational reference implementation for the broader cryptocurrency and blockchain industry."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:bitcoin-value-proposition ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:bitcoin-mining ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:bitcoin-technical-overview ],
        ngm:cryptocurrency ;
    vc:contrastsWith ngm:51-attack,
        ngm:bitcoin-centralisation-risks ;
    vc:enables ngm:bitcoin-as-money,
        ngm:bitcoin-standard ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:bitcoin-mining,
        ngm:bitcoin-technical-overview,
        ngm:bitcoin-value-proposition ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:bitcoin-etf,
        ngm:blockchain,
        ngm:blockchain-economics,
        ngm:blockchain-energy-consumption,
        ngm:decentralized-finance-de-fi,
        ngm:distributed-ledger-technology ;
    vc:slug "bitcoin" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:blockchain-network,
        ngm:consensus-mechanism,
        ngm:cryptography .

ngm:cybersecurity a owl:Class ;
    rdfs:label "Cybersecurity"@en ;
    rdfs:comment "Cybersecurity is the discipline concerned with protecting computer systems, networks, and data from unauthorised access, damage, and attack. In the AI governance context it addresses adversarial threats to machine learning models, data poisoning, model extraction, and the use of AI techniques for automated threat detection, vulnerability analysis, and intrusion detection. It overlaps strongly with privacy, encryption, access control, and authentication."@en ;
    rdfs:subClassOf ngm:ai-governance-and-ethics ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:enables ngm:ai-security,
        ngm:data-protection ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:relatedTo ngm:access-control,
        ngm:privacy,
        ngm:vulnerability ;
    vc:slug "cybersecurity" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:anomaly-detection,
        ngm:authentication,
        ngm:encryption .

ngm:public-key-infrastructure a owl:Class ;
    rdfs:label "Public Key Infrastructure"@en ;
    rdfs:comment "Public Key Infrastructure (PKI) is the set of roles, policies, hardware, software, and procedures needed to create, manage, distribute, use, store, and revoke digital certificates and manage public-key encryption. PKI binds public keys to the identities of entities such as persons and organisations through a trust hierarchy of certificate authorities, enabling secure authentication, data integrity, and confidential communication across distributed systems. It underpins TLS/HTTPS, code signing, email encryption, and decentralised identity frameworks."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptographic-keys ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:digital-signature ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:certificate-authority ],
        ngm:bc-cryptographic-primitive ;
    skos:broader ngm:bc-cryptographic-primitive ;
    vc:enables ngm:digital-identity,
        ngm:encryption ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:certificate-authority ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:relatedTo ngm:cybersecurity ;
    vc:requires ngm:cryptographic-keys,
        ngm:digital-signature ;
    vc:slug "public-key-infrastructure" ;
    vc:sourceDomain "blockchain" .

ngm:diffusion-model a owl:Class ;
    rdfs:label "Diffusion Model"@en ;
    rdfs:comment "A Diffusion Model is a class of generative model that learns to synthesise data by reversing a gradual noising process. During training the model observes how data is progressively corrupted by Gaussian noise; at inference time it iteratively denoises a random sample, guided by a learned score function, to produce high-fidelity outputs such as images, audio, or video. Diffusion models underpin systems like Stable Diffusion and DALL-E 3."@en ;
    rdfs:subClassOf ngm:ai-model-architecture ;
    skos:broader ngm:ai-model-architecture ;
    vc:contrastsWith ngm:generative-adversarial-network ;
    vc:enables ngm:image-generation,
        ngm:text-to-image ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.3"^^xsd:float ;
    vc:slug "diffusion-model" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:neural-network,
        ngm:training-data .

ngm:distributed-systems a owl:Class ;
    rdfs:label "Distributed Systems"@en ;
    rdfs:comment "Collections of independent computing nodes that coordinate through message passing to present a unified service, providing fault tolerance, horizontal scalability, and geographic distribution. Distributed systems are foundational to metaverse platforms, blockchain networks, and large-scale AI inference pipelines, where no single node holds all state and consistency guarantees (CAP theorem trade-offs) govern design choices."@en ;
    rdfs:subClassOf ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:enables ngm:blockchain,
        ngm:orchestration ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:consensus-mechanism,
        ngm:digital-infrastructure ;
    vc:slug "distributed-systems" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:edge-computing,
        ngm:microservices-architecture .

ngm:robo-safety-and-standards a owl:Class,
        skos:Concept ;
    rdfs:label "Safety and Standards"@en ;
    rdfs:comment "Taxonomy hub for robotics safety requirements, certification standards, collision avoidance, force-limiting mechanisms, and regulatory compliance frameworks governing safe robot operation alongside humans in industrial and service environments."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:risk-assessment ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:force-control ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:iso-10218 ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:collision-avoidance ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:cobot-safety-levels ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:functional-safety ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:rb-0090-emergency-stop ],
        ngm:robotics ;
    skos:broader ngm:robotics ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:cobot-safety-levels,
        ngm:collision-avoidance,
        ngm:force-control,
        ngm:functional-safety,
        ngm:iso-10218,
        ngm:rb-0090-emergency-stop ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:compliance-framework,
        ngm:regulatory-framework,
        ngm:robo-actuation-and-control,
        ngm:robo-human-robot-interaction,
        ngm:robo-robot-type ;
    vc:requires ngm:risk-assessment ;
    vc:slug "robo-safety-and-standards" ;
    vc:sourceDomain "robotics" .

ngm:autonomous-navigation a owl:Class ;
    rdfs:label "Autonomous Navigation"@en ;
    rdfs:comment "Autonomous Navigation encompasses the complete system capability for a robot or autonomous agent to move from one location to another without human guidance, integrating perception, localisation, mapping, path planning, obstacle avoidance, and control."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:slam ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:sensor-fusion ],
        ngm:autonomous-agent,
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:enables ngm:autonomous-robot,
        ngm:autonomous-vehicle ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires ngm:sensor-fusion,
        ngm:slam ;
    vc:slug "autonomous-navigation" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:motion-planning,
        ngm:path-planning .

ngm:communication-protocol a owl:Class ;
    rdfs:label "Communication Protocol"@en ;
    rdfs:comment "Communication protocol defines message formats, transmission rules, addressing schemes, and error-handling procedures that enable robots and computational systems to reliably exchange information over wired or wireless channels."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:message-format ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:error-correction ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:addressing-scheme ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:fault-tolerance ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:congestion-control ],
        ngm:robo-human-robot-interaction ;
    skos:broader ngm:robo-human-robot-interaction ;
    vc:enables ngm:distributed-control,
        ngm:remote-teleoperation,
        ngm:sensor-data-fusion,
        ngm:swarm-coordination ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:addressing-scheme,
        ngm:congestion-control,
        ngm:error-correction,
        ngm:message-format ;
    vc:implements ngm:communication-systems,
        ngm:information-architecture ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires ngm:bandwidth-constraints,
        ngm:data-serialisation,
        ngm:fault-tolerance,
        ngm:latency-tolerance,
        ngm:network-physical-layer,
        ngm:synchronisation-mechanism ;
    vc:slug "communication-protocol" ;
    vc:sourceDomain "robotics" .

ngm:encryption a owl:Class ;
    rdfs:label "Encryption"@en ;
    rdfs:comment "Encryption is the cryptographic process of transforming plaintext data into ciphertext using a defined algorithm and key, such that only parties possessing the correct decryption key can recover the original information, thereby ensuring confidentiality. Symmetric encryption schemes (such as AES-GCM) use a shared secret key for both encryption and decryption, while asymmetric schemes (such as RSA-OAEP) use mathematically linked key pairs. Encryption operates at multiple layers of modern infrastructure—at rest in storage systems, in transit via TLS, and at the application layer in end-to-end encrypted messaging protocols."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:key-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptography ],
        ngm:infra-security-and-identity ;
    skos:broader ngm:infra-security-and-identity ;
    vc:enables ngm:confidential-computing,
        ngm:data-protection ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:privacy,
        ngm:zero-knowledge ;
    vc:requires ngm:cryptography,
        ngm:key-management ;
    vc:slug "encryption" ;
    vc:sourceDomain "infrastructure" .

ngm:governance a owl:Class ;
    rdfs:label "Governance"@en ;
    rdfs:comment "Governance is an artificial intelligence concept."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:artificial-intelligence ],
        ngm:ai-governance-and-ethics ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:artificial-intelligence ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:slug "governance" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:merkle-tree a owl:Class ;
    rdfs:label "Merkle Tree"@en ;
    rdfs:comment "A binary tree of cryptographic hashes in which each leaf node contains the hash of a data block and each non-leaf node contains the hash of its children. Merkle trees enable efficient and tamper-evident verification of large data sets; in blockchain systems they allow nodes to confirm individual transaction inclusion without downloading an entire block."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:merkle-proof ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:merkle-root ],
        ngm:bc-cryptographic-primitive,
        ngm:blockchain-entity,
        ngm:cryptographic-primitive ;
    skos:broader ngm:bc-cryptographic-primitive ;
    vc:enables ngm:block-header,
        ngm:blockchain-transaction ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:merkle-proof,
        ngm:merkle-root ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:block,
        ngm:blockchain-scalability,
        ngm:cryptographic-commitment ;
    vc:slug "merkle-tree" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:cryptographic-hash,
        ngm:cryptographic-hash-function .

ngm:retrieval-augmented-generation a owl:Class ;
    rdfs:label "Retrieval-Augmented Generation"@en ;
    rdfs:comment "Retrieval-Augmented Generation (RAG) is an AI inference architecture that grounds large language model responses by dynamically fetching semantically relevant passages from an external knowledge store at query time. A retriever—typically backed by a vector database using dense embeddings—identifies the most relevant document chunks, which are concatenated into the model's context window before generation. RAG reduces hallucination, enables up-to-date knowledge without costly retraining, and allows fine-grained attribution of generated claims to source documents, making it the dominant pattern for enterprise knowledge-intensive question answering."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:embedding-model ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:vector-database ],
        ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:enables ngm:question-answering,
        ngm:semantic-search ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:requires ngm:embedding-model,
        ngm:vector-database ;
    vc:slug "retrieval-augmented-generation" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:knowledge-base,
        ngm:large-language-models .

ngm:transparency a owl:Class ;
    rdfs:label "Transparency"@en ;
    rdfs:comment "The property of an AI system whereby relevant information about the system's design, operation, capabilities, limitations, and decision-making processes is accessible and understandable to appropriate stakeholders."@en ;
    rdfs:subClassOf ngm:ai-governance-and-ethics ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:enables ngm:accountability-ai-0068,
        ngm:explainability-ai-0064 ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:slug "transparency" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:backpropagation a owl:Class ;
    rdfs:label "Backpropagation"@en ;
    rdfs:comment "Backpropagation is the algorithm for computing gradients of the loss function with respect to each weight in a neural network by applying the chain rule of calculus in reverse through the computation graph. It enables efficient gradient calculation across all layers in a single backward pass, making large-scale neural network training computationally feasible."@en ;
    rdfs:subClassOf ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:enables ngm:gradient-descent,
        ngm:model-training ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:relatedTo ngm:activation-function ;
    vc:slug "backpropagation" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:loss-function,
        ngm:neural-network .

ngm:haptic-feedback a owl:Class ;
    rdfs:label "Haptic Feedback"@en ;
    rdfs:comment "Tactile sensory technology providing physical sensations to enhance virtual experiences through actuators integrated into controllers, gloves, and body suits."@en ;
    rdfs:subClassOf ngm:sc-interaction ;
    skos:broader ngm:sc-interaction ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.4"^^xsd:float ;
    vc:slug "haptic-feedback" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:tactile-actuator .

ngm:nft a owl:Class ;
    rdfs:label "NFT"@en ;
    rdfs:comment "A Non-Fungible Token (NFT) is a cryptographic token deployed on a blockchain that provides verifiable, tamper-resistant proof of unique ownership and provenance for a specific digital or physical asset, distinguishing it from fungible tokens where each unit is interchangeable. NFT metadata and media assets are typically stored off-chain (via IPFS or centralised hosting) while only the token identifier and ownership record reside on-chain. Primary token standards include ERC-721 for single-asset tokens and ERC-1155 for semi-fungible batch tokens on Ethereum-compatible chains."@en ;
    rdfs:subClassOf ngm:bc-token-and-asset ;
    skos:broader ngm:bc-token-and-asset ;
    vc:enables ngm:creator-economy,
        ngm:digital-ownership ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:metaverse ;
    vc:slug "nft" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:erc-1155,
        ngm:erc-721,
        ngm:smart-contract .

ngm:risk-management a owl:Class ;
    rdfs:label "Risk Management"@en ;
    rdfs:comment "The coordinated activities to direct and control an AI system with regard to risk, encompassing risk identification, assessment, treatment, monitoring, and communication throughout the AI lifecycle to minimize potential adverse effects while maximizing benefits."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:explainability ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-governance ],
        ngm:ai-governance-and-ethics ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:relatedTo ngm:ai-ethics,
        ngm:responsible-ai ;
    vc:requires ngm:data-governance,
        ngm:explainability ;
    vc:slug "risk-management" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:ai-safety,
        ngm:compliance-framework .

ngm:actuator a owl:Class ;
    rdfs:label "Actuator"@en ;
    rdfs:comment "An actuator is a device that converts energy — electrical, hydraulic, or pneumatic — into mechanical motion or force, serving as the output element of a robot's control chain. Actuators translate commands from a robot controller into joint rotations, linear displacements, or gripping forces, and their dynamic characteristics (torque density, bandwidth, backdrivability) fundamentally constrain a robot's speed, precision, and physical safety in human-robot interaction. Common types include servo motors, hydraulic cylinders, pneumatic actuators, and emerging soft actuator materials."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:hydraulic-actuator ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:feedback-control ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:control-system ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:servo-motor ],
        ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:hydraulic-actuator,
        ngm:servo-motor ;
    vc:isPartOf ngm:robot ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:requires ngm:control-system,
        ngm:feedback-control ;
    vc:slug "actuator" ;
    vc:sourceDomain "robotics" .

ngm:control-system a owl:Class ;
    rdfs:label "Control System"@en ;
    rdfs:comment "Control system encompasses the computational and hardware subsystems that sense environmental state, evaluate performance against desired objectives, and generate actuation commands to regulate robot behaviour toward goals."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:feedback-loop ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:real-time-computation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:sensor-input ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:sensor-interface ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:controller ],
        ngm:robo-actuation-and-control,
        ngm:robotic-system ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:enables ngm:adaptive-behaviour,
        ngm:motion-control,
        ngm:stabilisation,
        ngm:task-execution ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:actuator-driver,
        ngm:controller,
        ngm:feedback-loop,
        ngm:sensor-interface ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires ngm:actuator-output,
        ngm:real-time-computation,
        ngm:sensor-input,
        ngm:timing-synchronisation ;
    vc:slug "control-system" ;
    vc:sourceDomain "robotics" .

ngm:network-protocol a owl:Class ;
    rdfs:label "Network Protocol"@en ;
    rdfs:comment "A network protocol is a set of established rules that specify how to format, send, and receive data between networked devices, enabling diverse communication systems to interact using standard procedures."@en ;
    rdfs:subClassOf ngm:dc-protocol-and-infra ;
    skos:broader ngm:dc-protocol-and-infra ;
    vc:enables ngm:data-transmission,
        ngm:interoperability,
        ngm:network-communication ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:implements ngm:distributed-collaboration ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:slug "network-protocol" ;
    vc:sourceDomain "distributed-collaboration" .

ngm:byzantine-fault-tolerance a owl:Class ;
    rdfs:label "Byzantine Fault Tolerance"@en ;
