ngm:agentic-rag a owl:Class ;
    rdfs:label "Agentic RAG"@en ;
    rdfs:comment "Agentic RAG is an architecture that augments retrieval-augmented generation with an autonomous agent loop, letting a language model plan, decide when and what to retrieve, issue multiple queries, and verify results before answering. Unlike single-shot RAG, it can route between sources, reformulate queries, and iterate retrieval and reasoning steps until a confidence threshold is met. This improves accuracy on multi-hop and ambiguous questions at the cost of higher latency and orchestration complexity."@en ;
    rdfs:subClassOf ngm:information-retrieval ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:rag-pipeline,
        ngm:retrieval-augmented-generation-rag ;
    vc:slug "agentic-rag" ;
    vc:sourceDomain "ai" .

