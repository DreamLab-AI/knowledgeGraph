    vc:uses ngm:algorithmic-auditing,
        ngm:red-teaming .

ngm:algorithmic-bias a owl:Class ;
    rdfs:label "Algorithmic Bias"@en ;
    rdfs:comment "Systematic and repeatable errors in AI systems that create unfair outcomes favouring or discriminating against particular groups or individuals. Bias manifests through historical bias, representation gaps, measurement proxies, aggregation errors, and feedback loops, and is detected through statistical auditing, counterfactual testing, and fairness metrics."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-governance ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:training-data ],
        ngm:ai-governance-and-ethics ;
    skos:broader ngm:ai-governance-and-ethics ;
