    rdfs:comment "Coding Support encompasses AI-assisted tools, IDE integrations, and agent frameworks that augment software developers with capabilities including inline completion, code generation, automated refactoring, debugging assistance, and test generation. Tools range from general-purpose LLM-backed assistants to domain-specific coding agents operating on full codebases."@en ;
    rdfs:subClassOf ngm:infra-software-engineering,
        ngm:software-engineering ;
    skos:broader ngm:infra-software-engineering ;
    vc:enables ngm:code-generation,
        ngm:generative-ai ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:relatedTo ngm:gpt-engineer,
        ngm:tips-and-tricks ;
    vc:slug "coding-support" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:software-engineering ;
    vc:uses ngm:agent-frameworks,
        ngm:large-language-models .

