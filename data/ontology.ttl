        ngm:industrial-io-t ;
    vc:requires ngm:cybersecurity,
        ngm:edge-computing,
        ngm:interoperability ;
    vc:slug "smart-grid" ;
    vc:sourceDomain "infrastructure" ;
    vc:standardizedBy ngm:iec-61968,
        ngm:ieee-2030,
        ngm:nist-smart-grid-framework ;
    vc:supports ngm:ai-energy-scarcity,
        ngm:carbon-markets,
        ngm:distributed-energy-resources ;
    vc:uses ngm:demand-response,
        ngm:io-t-sensor-network,
        ngm:machine-learning,
        ngm:real-time-monitoring,
        ngm:scada .

ngm:tendermint a owl:Class ;
    rdfs:label "Tendermint"@en ;
    rdfs:comment "Tendermint is a Byzantine fault-tolerant (BFT) consensus engine that implements a partially synchronous, round-based, leader-elected protocol providing deterministic finality on each block. It separates the consensus layer from the application layer via the Application BlockChain Interface (ABCI), allowing any deterministic state machine to be driven by its consensus guarantees. Tendermint is the consensus core of the Cosmos SDK and underpins a large family of interoperable application-specific blockchains, offering safety guarantees so long as fewer than one-third of validator voting power is Byzantine. Its design derives from Practical Byzantine Fault Tolerance (PBFT) but introduces pragmatic modifications — rotating proposers, weighted voting, and a three-phase commit protocol — optimised for open, permissionless validator sets."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:digital-signature ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:validator-set ],
        ngm:bc-protocol-and-consensus ;
    skos:broader ngm:bc-protocol-and-consensus ;
    vc:bridgesTo ngm:decentralised-ai,
        ngm:federated-learning ;
    vc:contrastsWith ngm:hotstuff,
        ngm:nakamoto-consensus,
        ngm:proof-of-work ;
    vc:dependsOn ngm:practical-byzantine-fault-tolerance ;
    vc:enables ngm:application-specific-blockchain,
        ngm:cosmos-ibc,
        ngm:cross-chain-communication ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:byzantine-fault-tolerance,
        ngm:deterministic-finality,
        ngm:proof-of-stake,
        ngm:state-machine-replication ;
    vc:isPartOf ngm:cosmos-network ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:cap-theorem,
        ngm:distributed-ledger-technology,
        ngm:smart-contract-platform ;
    vc:requires ngm:digital-signature,
        ngm:partial-synchrony,
        ngm:validator-set ;
    vc:slug "tendermint" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:abci,
        ngm:cosmos-sdk,
        ngm:p2p-gossip-protocol .

ngm:threshold-signature-scheme a owl:Class ;
    rdfs:label "Threshold Signature Scheme"@en ;
    rdfs:comment "A Threshold Signature Scheme (TSS) is a cryptographic protocol in which a private key is distributed among n parties such that any subset of at least t parties can jointly compute a valid digital signature without any single party ever possessing the complete private key, while fewer than t parties gain zero information about the key. TSS extends threshold secret sharing (Shamir's Secret Sharing) to the signing operation itself, producing a signature that is indistinguishable on-chain from a standard single-key signature, thereby enhancing privacy and reducing transaction fees compared to traditional on-chain multisig. TSS underpins distributed key management for exchanges, MPC wallets, and cross-chain bridge custody architectures."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:secure-multi-party-computation ],
        ngm:signature-scheme ;
    vc:bridgesTo ngm:decentralized-finance,
        ngm:trusted-execution-environment ;
    vc:contrastsWith ngm:hardware-security-module,
        ngm:multi-signature,
        ngm:single-key-custody ;
    vc:dependsOn ngm:multi-party-computation,
        ngm:paillier-encryption ;
    vc:enables ngm:decentralized-governance,
        ngm:institutional-custody,
        ngm:key-management,
        ngm:mpc-wallet,
        ngm:threshold-cryptography ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:implements ngm:digital-signature,
        ngm:proactive-secret-sharing ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:bls-signature,
        ngm:taproot ;
    vc:requires ngm:distributed-key-generation,
        ngm:secret-sharing,
        ngm:secure-multi-party-computation ;
    vc:slug "threshold-signature-scheme" ;
    vc:sourceDomain "security" ;
    vc:standardizedBy ngm:ietf-rfc-9591 ;
    vc:supports ngm:cross-chain-bridge,
        ngm:proof-of-stake-consensus ;
    vc:uses ngm:cryptographic-keys,
        ngm:elliptic-curve-cryptography,
        ngm:schnorr-signature,
        ngm:zero-knowledge-proof .

ngm:timestamp a owl:Class ;
    rdfs:label "Timestamp"@en ;
    rdfs:comment "A recorded value indicating the time of block creation in a blockchain system, embedded in each block header to establish chronological ordering of the chain and enable time-based protocol rules. Timestamps support difficulty adjustment, consensus validity checks, and provide an immutable audit trail for transaction ordering and data provenance."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptographic-hash ],
        ngm:distributed-data-structure ;
    vc:bridgesTo ngm:digital-signature,
        ngm:trusted-timestamping ;
    vc:contrastsWith ngm:logical-clock,
        ngm:vector-clock ;
    vc:dependsOn ngm:consensus-protocol,
        ngm:proof-of-work ;
    vc:enables ngm:block-height,
        ngm:chronological-ordering,
        ngm:data-provenance,
        ngm:difficulty-adjustment,
        ngm:finality ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:unix-time ;
    vc:isPartOf ngm:block,
        ngm:block-header,
        ngm:merkle-tree ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:audit-trail,
        ngm:blockchain-transaction,
        ngm:transaction-confirmation ;
    vc:requires ngm:cryptographic-hash,
        ngm:network-time-protocol ;
    vc:slug "timestamp" ;
    vc:sourceDomain "blockchain" ;
    vc:standardizedBy ngm:ieee-2418-1,
        ngm:iso-iec-23257-2021 ;
    vc:supports ngm:smart-contract,
        ngm:time-locked-transaction ;
    vc:uses ngm:block-time,
        ngm:median-time-past .

ngm:voluntary-carbon-market a owl:Class ;
    rdfs:label "Voluntary Carbon Market"@en ;
    rdfs:comment "The Voluntary Carbon Market (VCM) is a decentralised, private-sector marketplace in which corporations, governments, and individuals voluntarily purchase and retire carbon credits representing certified reductions or removals of greenhouse gas emissions, without being compelled by regulatory compliance frameworks. Participation is driven by corporate net-zero commitments, reputational and ESG pressures, and a desire to mobilise private finance for climate projects ahead of, or beyond, mandatory obligations. Each credit typically represents one metric tonne of CO₂-equivalent avoided or sequestered, verified by independent auditors against published standards such as the Verra Verified Carbon Standard (VCS) or the Gold Standard. The market operates through project developers, registries, brokers, and exchanges, with integrity increasingly governed by the Core Carbon Principles issued by the Integrity Council for the Voluntary Carbon Market (ICVCM)."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:carbon-credits ],
        ngm:carbon-markets ;
    vc:bridgesTo ngm:blockchain-carbon-tokens,
        ngm:decentralised-finance,
        ngm:digital-mrvs ;
    vc:contrastsWith ngm:compliance-carbon-market,
        ngm:emissions-trading-scheme ;
    vc:enables ngm:biodiversity-co-benefits,
        ngm:climate-change-mitigation,
        ngm:nature-based-solutions,
        ngm:net-zero-targets ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:carbon-credits,
        ngm:carbon-project-developers,
        ngm:carbon-registries ;
    vc:isPartOf ngm:carbon-markets,
        ngm:climate-finance ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:article-6-paris-agreement,
        ngm:corporate-sustainability-reporting,
        ngm:direct-air-capture ;
    vc:requires ngm:additionality,
        ngm:carbon-verification,
        ngm:third-party-auditing ;
    vc:slug "voluntary-carbon-market" ;
    vc:sourceDomain "governance" ;
    vc:standardizedBy ngm:gold-standard,
        ngm:integrity-council-for-the-voluntary-carbon-market,
        ngm:verra-verified-carbon-standard ;
    vc:supports ngm:paris-agreement,
        ngm:redd-plus,
        ngm:sustainable-development-goals ;
    vc:uses ngm:carbon-offsetting,
        ngm:esg-reporting,
        ngm:price-discovery .

