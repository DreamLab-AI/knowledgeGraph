ngm:syntactic-interoperability a owl:Class ;
    rdfs:label "Syntactic Interoperability"@en ;
    rdfs:comment "Syntactic interoperability is the ability of two or more systems to exchange data using compatible formats, structures, and encoding rules so that the receiving system can correctly parse the transmitted information. It concerns agreement on data formats, message structure, and serialisation grammar, independent of the meaning of the data. Syntactic interoperability is a prerequisite layer beneath semantic interoperability in interoperability frameworks."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:message-format ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-schema ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:data-format ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:protocol ],
        ngm:interoperability ;
    vc:contrastsWith ngm:semantic-interoperability ;
    vc:dependsOn ngm:data ;
    vc:enables ngm:semantic-interoperability ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:data-format,
        ngm:message-format ;
    vc:isPartOf ngm:data-integration,
        ngm:interoperability ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:api,
        ngm:data-model,
        ngm:standards ;
    vc:requires ngm:data-schema,
        ngm:protocol ;
    vc:slug "syntactic-interoperability" ;
    vc:sourceDomain "data" ;
    vc:supports ngm:data-integration ;
    vc:uses ngm:data-mapping,
        ngm:xml .

ngm:synthetic-asset a owl:Class ;
    rdfs:label "Synthetic Asset"@en ;
    rdfs:comment "A Synthetic Asset is a tokenised financial instrument on a blockchain whose value tracks an underlying reference asset, such as a fiat currency, commodity, equity, or index, without requiring direct ownership or custody of that asset. Synthetic assets derive their price through collateralisation and price oracles rather than through a one-to-one backing of the underlying, distinguishing them from wrapped tokens. Protocols such as Synthetix mint synthetic exposures (synths) backed by over-collateralised pools, allowing on-chain trading of real-world price feeds. They enable permissionless access to traditional markets but carry oracle, liquidation, and collateral-risk dependencies."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:peg-mechanism ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:liquidity-pool ],
        ngm:cryptocurrency-token ;
    vc:bridgesTo ngm:finance ;
    vc:contrastsWith ngm:stablecoin,
        ngm:wrapped-token ;
    vc:dependsOn ngm:oracle,
        ngm:price-oracle ;
    vc:enables ngm:decentralized-exchange,
        ngm:decentralized-finance-de-fi,
        ngm:derivatives-trading ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:mint-burn-mechanism,
        ngm:peg-mechanism ;
    vc:implements ngm:defi-protocol ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:algorithmic-stablecoin,
        ngm:synthetix ;
    vc:requires ngm:liquidity-pool ;
    vc:slug "synthetic-asset" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:hedging,
        ngm:risk-management ;
    vc:uses ngm:liquidity-pool,
        ngm:smart-contract .

ngm:tagged-hash a owl:Class ;
    rdfs:label "Tagged Hash"@en ;
    rdfs:comment "A Tagged Hash is a domain-separated hash construction formalised in BIP-340 and used throughout Bitcoin's Taproot/Schnorr signature ecosystem, computed as SHA256(SHA256(tag) || SHA256(tag) || msg), where tag is a human-readable string identifying the protocol context. The double-hashing of the tag prefix creates a unique domain separator that prevents cross-protocol hash collisions — ensuring that a hash computed in one context (e.g. key tweaking) cannot be misinterpreted or replayed in another context (e.g. signature nonce generation). Tagged hashes improve security proofs and simplify protocol composition by making each domain's hash computationally distinct."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:hash-function ],
        ngm:blockchain ;
    skos:broader ngm:blockchain ;
    vc:contrastsWith ngm:hash-function,
        ngm:hmac ;
    vc:dependsOn ngm:cryptography,
        ngm:hash-function,
        ngm:sha256 ;
    vc:enables ngm:collision-resistance,
        ngm:protocol-composition,
        ngm:security-proof ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:bip-340-schnorr-keypair,
        ngm:taproot ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:bitcoin,
        ngm:commitment-scheme,
        ngm:merkel-tree ;
    vc:requires ngm:domain-separation,
        ngm:hash-function ;
    vc:slug "tagged-hash" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:key-tweaking,
        ngm:tapscript ;
    vc:uses ngm:schnorr-signature,
        ngm:taproot .

