ngm:network-latency a owl:Class ;
    rdfs:label "Network Latency"@en ;
    rdfs:comment "Network Latency is the round-trip communication delay between nodes in a blockchain network, directly constraining consensus speed, block propagation, and transaction throughput. High latency increases the probability of forks, degrades user experience in real-time applications, and sets a fundamental lower bound on block time in geographically distributed deployments."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:latency-management-protocol ],
        ngm:bc-network-component,
        ngm:blockchain-entity,
        ngm:network-component ;
    skos:broader ngm:bc-network-component ;
    vc:contrastsWith ngm:latency ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:block-propagation-time,
        ngm:blockchain-network,
        ngm:blockchain-scalability,
        ngm:consensus-mechanism,
        ngm:distributed-system,
        ngm:gossip-protocol,
        ngm:network-topology,
        ngm:sub-millisecond-latency ;
    vc:requires ngm:latency-management-protocol ;
    vc:slug "network-latency" ;
    vc:sourceDomain "blockchain" .

ngm:network-security a owl:Class ;
    rdfs:label "Network Security"@en ;
    rdfs:comment "Network security is the practice of protecting computer networks and the data transmitted across them from unauthorised access, misuse, modification, or denial of service through a combination of hardware controls, software policies, and operational procedures. It encompasses perimeter defence, intrusion detection, traffic analysis, encryption of data in transit, and access control applied at network boundaries and within internal segments. As networks have evolved from isolated LANs to globally distributed cloud and edge architectures, network security has broadened to encompass zero-trust models, software-defined perimeters, and AI-driven anomaly detection. It forms a foundational layer of broader cybersecurity strategy."@en ;
    rdfs:subClassOf ngm:cybersecurity ;
    vc:enables ngm:data-security,
        ngm:digital-security ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
