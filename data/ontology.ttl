    vc:dependsOn ngm:decentralization,
        ngm:hash-chaining ;
    vc:enables ngm:audit-trail,
        ngm:data-integrity,
        ngm:non-repudiation,
        ngm:provenance-tracking,
        ngm:smart-contract-execution ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:bc-protocol-and-consensus ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:append-only-log,
