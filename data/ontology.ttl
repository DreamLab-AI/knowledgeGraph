ngm:peer-review a owl:Class ;
    rdfs:label "Peer Review"@en ;
    rdfs:comment "Peer review is the evaluation of work, proposals or decisions by qualified individuals of comparable competence, used to assess validity, quality and significance before acceptance or publication. In scholarship it gates journal and conference publication; in finance, governance and standards it underpins independent assessment, audit and consensus-based approval. It is a quality-assurance process intended to surface errors, reduce bias and confer credibility through independent scrutiny."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:scientific-method ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:validation-process ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:validation-process ],
        ngm:quality-assurance ;
