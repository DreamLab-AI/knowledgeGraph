ngm:autonomous-vehicle-testing a owl:Class ;
    rdfs:comment "Autonomous vehicle testing is the discipline of validating the safety, reliability, and performance of self-driving systems through simulation, closed-course trials, and supervised public-road operation. It exercises the perception, planning, and control stack against a vast space of driving scenarios, including rare and hazardous edge cases that are impractical to encounter physically. Simulation-based testing has become central because it enables scalable, repeatable, and safe exploration of these scenarios before real-world deployment."@en ;
    rdfs:label "Autonomous Vehicle Testing"@en ;
    rdfs:subClassOf ngm:autonomous-vehicle ;
    rdfs:subClassOf _:r2494 ;
    rdfs:subClassOf _:r2495 ;
