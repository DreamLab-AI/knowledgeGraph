    vc:uses ngm:map-projection,
        ngm:spatial-index .

ngm:gitcoin-passport a owl:Class ;
    rdfs:label "Gitcoin Passport"@en ;
    rdfs:comment "Gitcoin Passport is a decentralised identity aggregation and sybil-resistance protocol that collects verifiable credential stamps from diverse identity providers—including Web2 social platforms, biometric services, on-chain activity records, and professional attestation networks—into a composable trust score attesting to the humanness and uniqueness of a wallet address. The system is built on W3C Decentralised Identifier and Verifiable Credential standards, storing credentials on the Ceramic Network to maintain user sovereignty over personal data without centralised custody. Its primary use case is protecting quadratic funding rounds and other public-goods allocation mechanisms from sybil attacks, where a single actor creates many accounts to multiply their influence. The stamp-based, configurable-weight architecture allows applications to set their own scoring thresholds according to their specific risk tolerance, and the open API enables Gitcoin Passport to function as a composable trust primitive across the broader Web3 ecosystem."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:verifiable-credential-vc ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:digital-wallet ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:decentralized-identifier ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:did-document ],
        ngm:decentralized-identity-did ;
    vc:bridgesTo ngm:ai-content-authenticity,
        ngm:federated-identity ;
    vc:contrastsWith ngm:centralised-identity,
        ngm:sybil-attack ;
    vc:dependsOn ngm:ethereum,
        ngm:w3c-did-specification ;
    vc:enables ngm:decentralized-governance,
        ngm:public-goods-funding,
        ngm:quadratic-funding,
        ngm:token-airdrop ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:did-document,
        ngm:trust-score,
        ngm:verifiable-credential-vc ;
    vc:implements ngm:identity-aggregation,
        ngm:sybil-resistance ;
    vc:isPartOf ngm:gitcoin ;
    vc:qualityScore "0.73"^^xsd:float ;
    vc:relatedTo ngm:identity-verification,
        ngm:reputation-system,
        ngm:self-sovereign-identity ;
    vc:requires ngm:ceramic-network,
        ngm:decentralized-identifier,
        ngm:digital-wallet ;
    vc:slug "gitcoin-passport" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:brightid,
        ngm:ens-ethereum-name-service,
        ngm:proof-of-humanity,
        ngm:zero-knowledge-proof .

ngm:global-inequality a owl:Class ;
    rdfs:label "Global Inequality"@en ;
    rdfs:comment "Global Inequality is the systematic, multi-dimensional divergence in life chances, material resources, political power, and technological access experienced by individuals, households, communities, and nations across the world economic order — encompassing income inequality (the Gini coefficient ..."@en ;
