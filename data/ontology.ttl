    vc:slug "cloud-infrastructure" ;
    vc:sourceDomain "infrastructure" ;
    vc:standardizedBy ngm:iso-iec-17788 ;
    vc:supports ngm:containerisation,
        ngm:hybrid-cloud,
        ngm:multi-cloud,
        ngm:serverless-architecture .

ngm:game-theory a owl:Class ;
    rdfs:label "Game Theory"@en ;
    rdfs:comment "Game theory is the mathematical study of strategic interaction among rational agents, providing formal models for analysing decisions when outcomes depend on the choices of multiple actors with potentially conflicting interests. Founded by von Neumann and Morgenstern (1944) and extended by Nash's equilibrium concept (1950), it encompasses non-cooperative and cooperative game theory, mechanism design, and evolutionary dynamics. Its core solution concepts — Nash equilibrium, dominant strategy equilibrium, subgame-perfect equilibrium, and correlated equilibrium — are applied across economics, computer science, evolutionary biology, AI alignment research, and blockchain protocol design."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:utility-theory ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:cooperative-game-theory ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:mechanism-design ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:nash-equilibrium ],
        ngm:ai-research-area ;
    skos:broader ngm:ai-research-area ;
    vc:bridgesTo ngm:blockchain-governance,
        ngm:cryptography,
        ngm:swarm-intelligence ;
    vc:contrastsWith ngm:decision-theory ;
    vc:enables ngm:auction-theory,
        ngm:incentive-alignment,
        ngm:mechanism-design,
        ngm:multi-agent-reinforcement-learning,
        ngm:prediction-markets ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:cooperative-game-theory,
        ngm:mechanism-design,
        ngm:nash-equilibrium ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:agent-based-modelling,
        ngm:economics,
        ngm:social-choice-theory,
        ngm:token-engineering ;
    vc:requires ngm:utility-theory ;
    vc:slug "game-theory" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:ai-alignment,
        ngm:incentive-structures,
        ngm:protocol-design .

ngm:inverse-kinematics a owl:Class ;
    rdfs:label "Inverse Kinematics"@en ;
    rdfs:comment "The process of determining the joint parameters (angles or displacements) required to place a robot's end-effector at a desired position and orientation in Cartesian space. It maps from task space to joint space, inverting the forward kinematic function and resolving ambiguities such as multiple solutions, singularities, and joint-limit violations."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:joint-configuration ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:rb-0023-degrees-of-freedom ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:kinematic-model ],
        ngm:kinematics ;
    vc:bridgesTo ngm:character-animation ;
    vc:contrastsWith ngm:forward-kinematics ;
    vc:dependsOn ngm:coordinate-frame,
        ngm:forward-kinematics ;
    vc:enables ngm:computer-animation,
        ngm:path-planning,
        ngm:robot-control,
        ngm:surgical-robotics,
        ngm:teleoperation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:motion-planning,
        ngm:robo-actuation-and-control ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:end-effector ;
    vc:requires ngm:joint-configuration,
        ngm:kinematic-model,
        ngm:rb-0023-degrees-of-freedom ;
    vc:slug "inverse-kinematics" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:jacobian-matrix,
        ngm:numerical-methods,
        ngm:optimisation .

ngm:scalability a owl:Class ;
    rdfs:label "Scalability"@en ;
    rdfs:comment "Scalability is the fundamental system property describing the capacity to handle increasing workloads—in throughput, data volume, concurrency, or geographic reach—by adding resources without proportionate degradation in performance, cost efficiency, or reliability. It encompasses both vertical scaling (augmenting the capacity of existing nodes) and horizontal scaling (adding more nodes to a distributed cluster), each with distinct architectural implications governed by coordination overhead, data partitioning strategies, and consistency trade-offs. In distributed systems, achieving linear or near-linear scalability requires careful attention to the CAP theorem and its practical refinement, PACELC, which explicitly models the latency–consistency tension even in partition-free conditions. Scalability is a first-order design concern in cloud-native architectures, blockchain networks, edge computing platforms, and AI inference pipelines serving large or rapidly growing user populations."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:stateless-architecture ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:distributed-systems ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:horizontal-scalability ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:load-balancing ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:data-partitioning ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-partitioning ],
        ngm:infra-software-engineering ;
    skos:broader ngm:infra-software-engineering ;
    vc:bridgesTo ngm:blockchain-scalability ;
    vc:contrastsWith ngm:monolithic-architecture ;
    vc:dependsOn ngm:cap-theorem,
        ngm:network-infrastructure ;
    vc:enables ngm:fault-tolerance,
        ngm:high-performance-computing ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:data-partitioning,
        ngm:horizontal-scalability,
        ngm:load-balancing ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:distributed-architecture,
        ngm:performance-optimization,
        ngm:resilience,
        ngm:scalability-pattern ;
    vc:requires ngm:data-partitioning,
        ngm:distributed-systems,
        ngm:stateless-architecture ;
    vc:slug "scalability" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:ai-inference,
        ngm:cloud-native-architecture,
        ngm:edge-computing ;
    vc:uses ngm:caching,
        ngm:consistent-hashing,
        ngm:kubernetes,
        ngm:microservices-architecture .

ngm:shader a owl:Class ;
    rdfs:label "Shader"@en ;
    rdfs:comment "A shader is a programmable GPU program that replaces fixed-function rendering pipeline stages, executing artist-authored or engine-generated algorithms in parallel across thousands of GPU threads to determine vertex positions, surface colour, lighting, and post-process effects. Shader types include vertex, tessellation control, tessellation evaluation, geometry, fragment (pixel), mesh, ray-generation, and compute shaders, each targeting a distinct stage of the GPU execution pipeline. Written in high-level shading languages such as GLSL, HLSL, Metal Shading Language, or WGSL, shaders are compiled to hardware-specific bytecode and scheduled by the GPU driver onto shader processor cores. In the context of spatial computing, shaders are the fundamental mechanism through which all real-time visual content is generated for head-mounted displays, AR overlays, and immersive 3D environments."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gpu-driver ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:tessellation-shader ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:graphics-processing-unit ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:geometry-shader ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:compute-shader ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
