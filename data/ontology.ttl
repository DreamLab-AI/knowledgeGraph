        ngm:digital-signal-processor,
        ngm:microphone-array,
        ngm:spatial-audio ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:ambisonics,
        ngm:audio-processing-system,
        ngm:binaural-audio ;
    vc:requires ngm:acoustic-model,
        ngm:audio-driver,
        ngm:digital-signal-processing ;
    vc:slug "audio-system" ;
