ngm:graphics-processing-unit a owl:Class ;
    rdfs:label "Graphics Processing Unit"@en ;
    rdfs:comment "A Graphics Processing Unit is a parallel processor designed to accelerate the rendering of images and other data-parallel workloads through many concurrent execution units, and widely repurposed for general-purpose computing in machine learning, scientific simulation, and spatial computing."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
