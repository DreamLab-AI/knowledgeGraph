ngm:model-width a owl:Class ;
    rdfs:label "Model Width"@en ;
    rdfs:comment "The dimensionality of internal representations at each transformer layer, commonly denoted d_model or hidden dimension. Width sets the information-carrying capacity per token and scales the size of attention heads and feed-forward projections, making it a primary axis alongside depth and data volume in neural scaling law research."@en ;
    rdfs:subClassOf ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:contrastsWith ngm:model-depth ;
    vc:dependsOn ngm:hyperparameter,
        ngm:transformer ;
    vc:enables ngm:mixture-of-experts ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:attention-mechanism,
        ngm:parameter-count ;
    vc:slug "model-width" ;
    vc:sourceDomain "artificial-intelligence" .

