    vc:enables ngm:audio-enhancement,
        ngm:spatial-audio,
        ngm:video-processing ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires ngm:algorithm,
        ngm:dsp-hardware,
        ngm:sensor ;
    vc:slug "digital-signal-processing" ;
    vc:sourceDomain "spatial-computing" .

ngm:ens a owl:Class ;
    rdfs:label "ENS"@en ;
    rdfs:comment "The Ethereum Name Service (ENS) is a decentralised, on-chain naming system that maps human-readable names ending in .eth to Ethereum addresses, content hashes, and other on-chain or off-chain resources via ERC-137 compliant smart contracts. It functions as the Web3 analogue of DNS, replacing hexadecimal addresses with memorable labels that are owned and controlled by the holder of the corresponding NFT. ENS resolvers extend the system to support IPFS content hashes, text records, and multi-chain addresses, making it a foundational identity and discoverability layer for the decentralised web."@en ;
    rdfs:subClassOf ngm:bc-protocol-and-consensus,
        ngm:decentralised-identity ;
    skos:broader ngm:bc-protocol-and-consensus ;
    vc:enables ngm:decentralised-web,
        ngm:self-sovereign-identity ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:ipfs ;
    vc:slug "ens" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:nft,
        ngm:smart-contract .

ngm:erc-1155 a owl:Class ;
    rdfs:label "ERC-1155"@en ;
    rdfs:comment "ERC-1155 is an Ethereum multi-token standard that allows a single smart contract to manage an arbitrary number of distinct token types — fungible, non-fungible, and semi-fungible — each identified by a uint256 token ID, with quantities tracked per address per ID. Pioneered by Enjin and formalised as EIP-1155, the standard introduces safeBatchTransferFrom for atomic multi-token transfers in a single transaction, substantially reducing gas costs compared to managing multiple separate ERC-20 or ERC-721 contracts. It is widely adopted in blockchain gaming, NFT collections, and on-chain economies that blend consumable items with unique assets."@en ;
    rdfs:subClassOf ngm:bc-token-and-asset,
        ngm:token-standard ;
    skos:broader ngm:bc-token-and-asset ;
    vc:contrastsWith ngm:erc-20,
        ngm:erc-721 ;
    vc:enables ngm:blockchain-gaming,
        ngm:nft ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:slug "erc-1155" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:batch-processing,
        ngm:smart-contract .

ngm:fee-market a owl:Class ;
    rdfs:label "Fee Market"@en ;
    rdfs:comment "A Fee Market is the mechanism by which blockchain participants competitively bid transaction fees to have their transactions included in blocks, with miners or validators selecting transactions that maximise their revenue given limited block capacity. Fee markets emerge from the interplay between fixed block-space supply and variable transaction demand, producing dynamic price discovery that signals network congestion. Ethereum's EIP-1559 introduced a protocol-level base fee that adjusts algorithmically each block, partially burning fees to reduce token supply and adding a tip mechanism for priority inclusion."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:block-size ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:mempool ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:base-fee ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:transaction-fee ],
        ngm:bc-defi-and-economics,
        ngm:blockchain-entity,
        ngm:economic-mechanism ;
    skos:broader ngm:bc-defi-and-economics ;
    vc:dependsOn ngm:blockchain ;
    vc:enables ngm:blockchain-transaction,
        ngm:miner ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:base-fee,
        ngm:transaction-fee ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:gas-fee-market,
        ngm:gas-price,
        ngm:proof-of-work,
        ngm:tokenomics ;
    vc:requires ngm:block-size,
        ngm:mempool ;
    vc:slug "fee-market" ;
    vc:sourceDomain "blockchain" .

ngm:game-development a owl:Class ;
    rdfs:label "Game Development"@en ;
    rdfs:comment "Game development is the multidisciplinary practice of designing, programming, and shipping interactive software across entertainment and serious-games domains, encompassing game design, art production, audio, narrative scripting, engine programming, and quality assurance. The field is increasingly AI-augmented: procedural content generation automates the creation of levels, terrain, and assets; reinforcement learning trains non-player characters (NPCs) with adaptive behaviour; and generative AI accelerates 2D/3D asset production. Game engines such as Unity and Unreal Engine provide integrated rendering, physics, audio, and scripting runtimes that underpin the production pipeline."@en ;
    rdfs:subClassOf ngm:ai-application ;
    skos:broader ngm:ai-application ;
    vc:enables ngm:npc-interaction,
        ngm:simulation ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:real-time-rendering ;
    vc:slug "game-development" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:game-engine,
        ngm:procedural-content-generation,
        ngm:reinforcement-learning .

ngm:hardware-abstraction a owl:Class ;
    rdfs:label "Hardware Abstraction"@en ;
    rdfs:comment "Hardware Abstraction is the software engineering practice of creating an intermediate layer that exposes a uniform API to higher-level software while hiding the specifics of underlying hardware components. In spatial computing and metaverse platforms this is essential for achieving hardware-agnostic portability across diverse GPU architectures, XR headsets, and edge devices. A well-designed hardware abstraction layer allows rendering engines, physics simulators, and networking stacks to target a single interface rather than coding against vendor-specific hardware SDKs."@en ;
    rdfs:subClassOf ngm:hardware-abstraction-layer-hal,
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:enables ngm:hardware-platform-agnostic,
        ngm:operating-system ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:relatedTo ngm:hardware ;
    vc:slug "hardware-abstraction" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:driver-software,
        ngm:graphics-api .

ngm:hash-time-locked-contract a owl:Class ;
    rdfs:label "Hash Time-Locked Contract"@en ;
    rdfs:comment "A Hash Time-Locked Contract (HTLC) is a type of smart contract that conditionally transfers funds to a recipient only if they can present a cryptographic preimage satisfying a specified hash condition within a defined time window; if the condition is unmet before the timeout, the funds revert to the sender. HTLCs are foundational to trustless cross-chain atomic swaps and payment channel networks such as the Lightning Network, enabling conditional payment routing without requiring both parties to trust each other or a custodial intermediary. The hashlock ensures atomicity—either both legs of a swap complete or neither does—whilst the timelock enforces a bounded settlement window. HTLCs are a primitive from which more complex decentralised finance protocols are constructed."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptographic-hash-function ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:atomic-swap ],
        ngm:smart-contract ;
    vc:enables ngm:cross-chain-interoperability,
        ngm:lightning-network,
        ngm:micropayments ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:cross-chain-bridge,
        ngm:de-fi,
        ngm:payment-system ;
    vc:requires ngm:atomic-swap,
        ngm:cryptographic-hash-function ;
    vc:slug "hash-time-locked-contract" ;
    vc:sourceDomain "blockchain" .

ngm:high-availability a owl:Class ;
    rdfs:label "High Availability"@en ;
    rdfs:comment "High availability (HA) is an infrastructure design property that specifies and implements the conditions under which a system continues to deliver its intended service in the presence of component failures, maintenance windows, or demand spikes. HA is quantified by availability targets expressed in nines (e.g., 99.9% equates to roughly 8.7 hours of permitted downtime per year), achieved through redundant components, active-passive or active-active failover, health monitoring, and automated recovery. It is a core non-functional requirement in cloud-native, telecommunications, and financial systems where service interruption carries regulatory or commercial penalties."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:fault-tolerance ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:reliability ],
        ngm:infra-computing-and-cloud ;
    skos:broader ngm:infra-computing-and-cloud ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:data-replication,
        ngm:microservices-architecture ;
    vc:requires ngm:fault-tolerance,
        ngm:reliability ;
    vc:slug "high-availability" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:cloud-infrastructure,
        ngm:distributed-systems .

ngm:hyperledger-fabric a owl:Class ;
    rdfs:label "Hyperledger Fabric"@en ;
    rdfs:comment "Permissioned blockchain framework enabling enterprise consortia to build modular, confidential systems through PrivateChannels, SmartContract|chaincode, and pluggable consensus mechanisms."@en ;
    rdfs:subClassOf ngm:bc-network-component ;
    skos:broader ngm:bc-network-component ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.4"^^xsd:float ;
    vc:slug "hyperledger-fabric" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:private-channels .

ngm:icml a owl:Class ;
    rdfs:label "ICML"@en ;
    rdfs:comment "The International Conference on Machine Learning (ICML) is the premier annual academic conference for machine learning research, organised by the International Machine Learning Society (IMLS) since 1980. ICML serves as the primary venue for disseminating foundational and applied advances across supervised learning, unsupervised learning, reinforcement learning, deep learning, optimisation, and the theory of machine learning. Acceptance rates have fallen to roughly 26% as submission volumes have grown into the thousands annually, making it one of the most selective and impactful venues in AI research."@en ;
    rdfs:subClassOf ngm:research-methods ;
    vc:enables ngm:benchmark-standard,
        ngm:federated-learning,
        ngm:machine-learning-technique,
        ngm:transfer-learning ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:ai-safety-research,
        ngm:deep-learning,
        ngm:generative-ai,
        ngm:machine-learning,
        ngm:neural-network,
        ngm:reinforcement-learning ;
    vc:slug "icml" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:machine-learning-model,
        ngm:optimization-algorithm .

ngm:identity-systems a owl:Class ;
    rdfs:label "Identity Systems"@en ;
    rdfs:comment "Identity Systems are the technical and organisational frameworks that establish, manage, verify, and revoke digital identities for users, devices, and services. They encompass authentication mechanisms, credential issuance, public-key infrastructure, and decentralised identity models (self-sovereign identity, DIDs) that enable secure, interoperable identification across platforms and jurisdictions."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:self-sovereign-identity ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:public-key-infrastructure ],
        ngm:infra-security-and-identity ;
    skos:broader ngm:infra-security-and-identity ;
    vc:enables ngm:access-control ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:public-key-infrastructure,
        ngm:self-sovereign-identity ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:slug "identity-systems" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:authentication,
        ngm:digital-identity .

ngm:instance-segmentation a owl:Class ;
    rdfs:label "Instance Segmentation"@en ;
    rdfs:comment "A computer vision task that extends object detection by predicting precise pixel-level masks for each individual object instance, jointly performing detection and segmentation to delineate the exact boundaries of distinct objects. Architectures such as Mask R-CNN, YOLACT, and SOLOv2 enable fine-grained object localisation essential for robotics manipulation, autonomous driving, and medical image analysis."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:semantic-segmentation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:object-detection ],
        ngm:computer-vision,
        ngm:sc-interaction ;
    skos:broader ngm:sc-interaction ;
    vc:enables ngm:scene-understanding ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:panoptic-segmentation ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:relatedTo ngm:computer-vision-task ;
    vc:requires ngm:object-detection,
        ngm:semantic-segmentation ;
    vc:slug "instance-segmentation" ;
    vc:sourceDomain "spatial-computing" .

ngm:interoperability-framework a owl:Class ;
    rdfs:label "Interoperability Framework"@en ;
    rdfs:comment "Coordinated set of standards and specifications enabling interaction between heterogeneous systems in metaverse environments."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:universal-manifest ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:metadata-standard ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:data-format ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:standardization-bodies ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:data-integration-interface ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:technical-standards ],
        ngm:infra-network-and-comms,
        ngm:metaverse-architecture ;
    skos:broader ngm:infra-network-and-comms ;
    vc:enables ngm:cross-platform-integration,
        ngm:scalable-architecture,
        ngm:system-interoperability ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:api-specifications,
        ngm:data-format,
        ngm:data-integration-interface,
        ngm:metadata-standard,
        ngm:protocol-definitions,
        ngm:technical-standards,
        ngm:universal-manifest ;
    vc:isPartOf ngm:metaverse-architecture ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:standardization-bodies,
        ngm:technical-documentation ;
    vc:slug "interoperability-framework" ;
    vc:sourceDomain "infrastructure" .

ngm:iso-iec-27001 a owl:Class ;
    rdfs:label "ISO/IEC 27001"@en ;
    rdfs:comment "ISO/IEC 27001 is an internationally recognised standard that specifies the requirements for establishing, implementing, maintaining, and continually improving an Information Security Management System (ISMS) within the context of an organisation's overall business risks. It adopts a risk-based approach, requiring organisations to systematically identify information security risks and apply appropriate controls drawn from Annex A. Certification against ISO/IEC 27001 provides third-party assurance of an organisation's commitment to protecting the confidentiality, integrity, and availability of information assets."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:information-security ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:risk-assessment ],
        ngm:infra-legal-and-regulatory ;
    skos:broader ngm:infra-legal-and-regulatory ;
    vc:enables ngm:audit-trail,
        ngm:compliance-framework ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:cybersecurity,
        ngm:gdpr-compliance ;
    vc:requires ngm:information-security,
        ngm:risk-assessment ;
    vc:slug "iso-iec-27001" ;
    vc:sourceDomain "infrastructure" .

ngm:knowledge-distillation-for-edge a owl:Class ;
    rdfs:label "Knowledge Distillation for Edge"@en ;
    rdfs:comment "Model compression technique that transfers learned representations from large, accurate teacher neural networks to compact student models optimised for edge deployment, achieving 20-30x size reduction while retaining 97%+ of accuracy through soft-target training, temperature scaling, and layer-wise representation matching."@en ;
    rdfs:subClassOf ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:enables ngm:edge-ai-system,
        ngm:on-device-learning,
        ngm:tiny-ml ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:deep-learning,
        ngm:edge-computing,
        ngm:model-compression-for-edge,
        ngm:model-pruning-for-edge-deployment,
        ngm:neural-network-quantisation ;
    vc:slug "knowledge-distillation-for-edge" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:machine-learning,
        ngm:neural-network,
        ngm:transfer-learning .

ngm:learning-rate-schedule a owl:Class ;
    rdfs:label "Learning Rate Schedule"@en ;
    rdfs:comment "A systematic strategy for varying the learning rate hyperparameter during model training, either according to a fixed rule (step decay, cosine annealing, exponential decay) or adaptively in response to training signals. Learning rate schedules improve convergence and final model performance by applying higher rates early for rapid progress and lower rates during fine-tuning, thereby reducing the risk of overshooting loss minima."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:machine-learning ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:deep-learning ],
        ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:enables ngm:training-and-fine-tuning ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:machine-learning-framework,
        ngm:neural-network ;
    vc:requires ngm:deep-learning,
        ngm:machine-learning ;
    vc:slug "learning-rate-schedule" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:gradient-descent,
        ngm:training .

ngm:level-of-detail a owl:Class ;
    rdfs:label "Level of Detail"@en ;
    rdfs:comment "Level of Detail (LOD) is a rendering optimisation technique that dynamically adjusts the geometric complexity, texture resolution, and shader fidelity of 3D objects based on viewing distance or screen-space coverage, trading visual precision for computational efficiency. LOD is essential for maintaining real-time frame rates in large-scale metaverse and spatial computing scenes."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:3-d-asset ],
        ngm:metaverse,
        ngm:sc-display-and-rendering ;
    skos:broader ngm:sc-display-and-rendering ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:occlusion-culling,
        ngm:rendering-pipeline ;
    vc:requires ngm:3-d-asset ;
    vc:slug "level-of-detail" ;
    vc:sourceDomain "spatial-computing" ;
