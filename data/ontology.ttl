        ngm:item-response-theory,
        ngm:learning-management-system .

ngm:compiler-optimization a owl:Class ;
    rdfs:label "Compiler Optimization"@en ;
    rdfs:comment "Compiler optimisation is the set of program transformations a compiler applies to make generated code faster, smaller or more energy-efficient while preserving its observable behaviour. It operates over intermediate representations using analyses such as data-flow and dependence analysis to enable transformations like inlining, loop optimisation and dead-code elimination. Optimisation is central to extracting performance from modern hardware without burdening the programmer."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:static-analysis ],
        ngm:compiler ;
    vc:dependsOn ngm:bytecode,
        ngm:static-analysis ;
    vc:enables ngm:optimization-algorithm,
        ngm:performance-optimization ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:profiling,
        ngm:static-analysis ;
    vc:isPartOf ngm:compiler ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:just-in-time-compilation,
        ngm:performance-optimization,
        ngm:programming-language ;
    vc:slug "compiler-optimization" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:programming-language ;
    vc:uses ngm:just-in-time-compilation,
        ngm:profiling .

ngm:complaint-infrastructure a owl:Class ;
    rdfs:label "Complaint Infrastructure"@en ;
    rdfs:comment "Complaint infrastructure is the organisational and technical system through which consumers can submit, track, escalate, and resolve grievances against providers, and through which regulators monitor systemic harms. It comprises intake channels, case-management workflows, redress mechanisms, and reporting that feed enforcement and policy. It matters because accessible, auditable complaint handling is a structural requirement of consumer-protection regimes, turning individual grievances into actionable signals and remedies."@en ;
    rdfs:subClassOf ngm:regulatory-compliance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:consumer-protection ;
    vc:slug "complaint-infrastructure" ;
    vc:sourceDomain "governance" .

ngm:complex-event-processing a owl:Class ;
    rdfs:label "Complex Event Processing"@en ;
    rdfs:comment "Complex event processing is a paradigm that continuously analyses streams of discrete events to detect meaningful patterns, correlations and derived higher-level events in near real time. Rather than querying stored data after the fact, it evaluates standing pattern queries over moving event streams, recognising temporal sequences, aggregates over windows and absence-of-event conditions. It enables systems to react to situations as they emerge rather than discovering them in later batch analysis."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:message-queue ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:stream-processing ],
        ngm:stream-processing ;
    vc:bridgesTo ngm:message-queue ;
    vc:dependsOn ngm:stream-processing ;
    vc:enables ngm:event-driven-architecture,
        ngm:real-time-analytics ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:stream-processing ;
    vc:isPartOf ngm:event-driven-architecture ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:event-driven-architecture,
        ngm:real-time-analytics ;
    vc:requires ngm:message-queue ;
    vc:slug "complex-event-processing" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:real-time-analytics ;
    vc:uses ngm:message-queue,
        ngm:stream-processing .

ngm:complexity-science a owl:Class ;
    rdfs:label "Complexity Science"@en ;
    rdfs:comment "Complexity science is the interdisciplinary study of complex adaptive systems composed of many interacting components whose collective behaviour cannot be reduced to that of the individual parts. It investigates emergence, self-organisation, networks, nonlinear dynamics, and adaptation across physical, biological, social, and economic systems. It matters because it provides a unifying lens and a set of computational and analytical tools for understanding phenomena such as markets, ecosystems, and epidemics that defy reductionist explanation."@en ;
    rdfs:subClassOf ngm:ai-research-area ;
    skos:broader ngm:ai-research-area ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:economics,
        ngm:emergence ;
    vc:slug "complexity-science" ;
    vc:sourceDomain "data" .

ngm:compliance-automation a skos:Concept ;
    rdfs:label "Compliance Automation"@en .

ngm:compliance-carbon-market a owl:Class ;
    rdfs:label "Compliance Carbon Market"@en ;
    rdfs:comment "A compliance carbon market is a regulated market in which emitters covered by a mandatory cap must surrender allowances or credits equal to their emissions, created under law to enforce climate targets. Prices are set by the supply of capped allowances and demand from regulated entities, creating a financial incentive to abate. It stands in contrast to voluntary carbon markets, where participation and credit purchase are discretionary."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:carbon-accounting ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:regulatory-compliance ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:carbon-registry ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:carbon-credits ],
        ngm:regulatory-framework ;
    vc:contrastsWith ngm:voluntary-carbon-market ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:carbon-credits,
        ngm:carbon-registry ;
    vc:implements ngm:carbon-tax,
        ngm:climate-policy ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:climate-finance,
        ngm:green-finance ;
    vc:requires ngm:carbon-accounting,
        ngm:regulatory-compliance ;
    vc:slug "compliance-carbon-market" ;
    vc:sourceDomain "governance" ;
    vc:standardizedBy ngm:kyoto-protocol,
        ngm:paris-agreement ;
    vc:supports ngm:carbon-offset ;
    vc:uses ngm:verification .

ngm:compliance-systems a owl:Class ;
    rdfs:label "Compliance Systems"@en ;
    rdfs:comment "Compliance systems are the integrated software and process frameworks organisations use to enforce, monitor, and report adherence to laws, regulations, and internal policies. They encompass policy management, control automation, monitoring and alerting, audit-trail capture, and regulatory reporting workflows. They matter because they operationalise obligations such as content-moderation duties under the Digital Services Act or custody and reporting rules for digital assets, turning legal requirements into continuously enforced controls."@en ;
    rdfs:subClassOf ngm:regulatory-compliance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:digital-asset-management,
        ngm:digital-services-act ;
    vc:slug "compliance-systems" ;
    vc:sourceDomain "governance" .

ngm:composability a owl:Class ;
    rdfs:label "Composability"@en ;
    rdfs:comment "Composability is the property by which independent components can be combined into larger systems whose behaviour is predictable from the behaviour of the parts. In blockchain and decentralised finance it describes how permissionless smart contracts can call and build upon one another so that protocols interlock like building blocks, often called money legos. Composability accelerates innovation but couples systems together, propagating both functionality and risk across the stack."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:interoperability ],
        ngm:smart-contract ;
    vc:bridgesTo ngm:decentralized-finance ;
    vc:contrastsWith ngm:interoperability ;
    vc:dependsOn ngm:smart-contract ;
    vc:enables ngm:decentralized-finance,
        ngm:interoperability ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:blockchain ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:decentralized-exchange,
        ngm:defi-protocol,
        ngm:interoperability ;
    vc:requires ngm:interoperability ;
    vc:slug "composability" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:decentralized-finance,
        ngm:defi-protocol ;
    vc:uses ngm:smart-contract .

ngm:computational-neuroscience a owl:Class ;
    rdfs:label "Computational Neuroscience"@en ;
    rdfs:comment "Computational neuroscience is the study of the nervous system through mathematical models, simulations, and information-processing theories that describe how neurons and neural circuits represent, compute, and learn. It spans biophysical models of single neurons, network models of population dynamics, and theories of coding, plasticity, and behaviour. The field both explains experimental data and inspires artificial neural and neuromorphic systems by clarifying the principles of biological computation."@en ;
    rdfs:subClassOf ngm:cognitive-science ;
    vc:bridgesTo ngm:deep-learning ;
    vc:contrastsWith ngm:deep-learning ;
    vc:dependsOn ngm:neural-network ;
    vc:enables ngm:neuromorphic-computing ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:cognitive-science ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:cognitive-science,
        ngm:machine-learning,
        ngm:neural-network ;
    vc:slug "computational-neuroscience" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:cognitive-architecture ;
    vc:uses ngm:machine-learning,
        ngm:reinforcement-learning .

ngm:concept-drift a owl:Class ;
    rdfs:label "Concept Drift"@en ;
    rdfs:comment "Concept Drift is the phenomenon in which the statistical properties of the target variable that a machine learning model was trained to predict change over time, causing model performance to degrade. Drift can be abrupt, gradual, or recurring, and may stem from evolving user behaviour, environmental shifts, or data collection changes. Detecting and adapting to concept drift is essential for maintaining the reliability of deployed ML systems."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:model-monitoring ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:statistics ],
        ngm:ai-technique,
        ngm:machine-learning ;
    skos:broader ngm:ai-technique ;
    vc:contrastsWith ngm:covariate-shift,
        ngm:data-drift ;
    vc:dependsOn ngm:probability-distribution,
        ngm:streaming-data ;
    vc:enables ngm:continual-learning,
        ngm:retraining ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:adwin,
        ngm:drift-detection-method,
        ngm:page-hinkley-test ;
    vc:qualityScore "0.9"^^xsd:float ;
    vc:relatedTo ngm:anomaly-detection,
        ngm:distribution-shift,
        ngm:mlops,
        ngm:online-learning ;
    vc:requires ngm:model-monitoring,
        ngm:statistics ;
    vc:slug "concept-drift" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:ai-governance,
        ngm:observability .

ngm:conditional-random-field a owl:Class ;
    rdfs:label "Conditional Random Field"@en ;
    rdfs:comment "A Conditional Random Field (CRF) is a discriminative probabilistic graphical model used for structured prediction tasks such as sequence labelling, where the model directly estimates the conditional probability P(y|x) of an output label sequence y given an observed input sequence x. CRFs overcome the label bias problem of maximum-entropy Markov models by considering the entire output sequence jointly, making them effective for named entity recognition, part-of-speech tagging, and image segmentation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:feature-extraction ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:probabilistic-model ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:machine-learning-discipline ],
        ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:contrastsWith ngm:convolutional-neural-network,
        ngm:recurrent-neural-network,
        ngm:transformer ;
    vc:enables ngm:named-entity-recognition,
        ngm:natural-language-processing,
        ngm:speech-recognition ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:machine-learning-discipline-technique,
        ngm:named-entity,
        ngm:natural-language-understanding ;
    vc:requires ngm:feature-extraction,
        ngm:machine-learning-discipline,
        ngm:probabilistic-model ;
    vc:slug "conditional-random-field" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:deep-learning,
        ngm:machine-learning-discipline-model .

ngm:configuration a owl:Class ;
    rdfs:label "Configuration"@en ;
    rdfs:comment "Configuration is the set of parameters, settings, and environment variables that determine the runtime behaviour of a spatial computing platform, application, or pipeline component. Proper configuration governs interoperability between subsystems, controls feature flags, and defines integration points between platform services, hardware abstraction layers, and content pipelines."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:hardware-abstraction ],
        ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:bridgesTo ngm:computer-vision ;
    vc:enables ngm:platform-service ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:relatedTo ngm:configuration-setting,
        ngm:platform-engineering ;
    vc:requires ngm:hardware-abstraction ;
    vc:slug "configuration" ;
    vc:sourceDomain "spatial-computing" .

ngm:conformity-assessment-body a owl:Class ;
    rdfs:label "Conformity Assessment Body"@en ;
    rdfs:comment "A conformity assessment body is an accredited organisation authorised to evaluate whether products, processes, or services meet specified standards or regulatory requirements. It performs testing, inspection, and certification activities and issues the formal attestations that allow goods to be placed on a market. Such bodies are themselves accredited by national accreditation authorities to ensure impartiality and competence."@en ;
    rdfs:subClassOf ngm:standards-body ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:robot-standard,
        ngm:trust-framework ;
    vc:slug "conformity-assessment-body" ;
    vc:sourceDomain "governance" .

ngm:connector-standards a owl:Class ;
    rdfs:label "Connector Standards"@en ;
    rdfs:comment "Connector standards are specifications that define the mechanical form factor, pin assignment, and electrical signalling of the physical interfaces used to join cables and devices. They guarantee interoperability across vendors at the physical layer, covering examples such as USB-C, RJ45, and HDMI. Standardised connectors reduce fragmentation and enable plug-and-play interconnection."@en ;
    rdfs:subClassOf ngm:technical-standard ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:physical-layer ;
    vc:slug "connector-standards" ;
    vc:sourceDomain "infrastructure" .

ngm:consent-registry a owl:Class ;
    rdfs:label "Consent Registry"@en ;
    rdfs:comment "A consent registry is a system of record that stores, versions, and serves the consent decisions data subjects have granted or withdrawn for processing their personal data. It provides an auditable, queryable source of truth that data controllers and processors consult before performing a processing activity. It is a central component of privacy-compliance and consent-management architectures."@en ;
    rdfs:subClassOf ngm:identity-management ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:consent-management,
        ngm:user-consent-token ;
    vc:slug "consent-registry" ;
    vc:sourceDomain "security" .

ngm:constraint-based-design a owl:Class ;
    rdfs:label "Constraint Based Design"@en ;
    rdfs:comment "Constraint based design is an engineering and AI methodology in which the valid solution space is explicitly defined by a set of constraints — physical laws, geometric relationships, functional requirements, regulatory bounds, manufacturing limits, or performance thresholds — that any acceptable design must simultaneously satisfy. Constraint solvers, optimisation algorithms, and AI planners traverse or prune this feasible region to discover configurations meeting all constraints, optionally optimising an objective within the feasible space. The method is foundational to parametric CAD, generative design tools, topology optimisation, robotics motion planning, and cyber-physical system validation, and is increasingly integrated with machine learning to learn constraint representations from data and guide search with neural heuristics."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:optimization-algorithm ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:knowledge-representation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:simulation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:constraint-satisfaction ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:constraint-solver ],
        ngm:ai-technique,
        ngm:constraint-satisfaction ;
    skos:broader ngm:ai-technique ;
    vc:bridgesTo ngm:ai-system-component,
        ngm:robotics,
        ngm:simulation-engine ;
    vc:contrastsWith ngm:generative-ai,
        ngm:rule-based-system ;
    vc:enables ngm:co-design,
        ngm:formal-verification,
        ngm:generative-design-tool,
        ngm:motion-planning,
        ngm:product-design,
        ngm:topology-optimization ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:constraint-propagation,
        ngm:constraint-solver,
        ngm:design-space-exploration,
        ngm:feasibility,
        ngm:functional-requirements,
        ngm:geometric-constraint ;
    vc:implements ngm:model-based-systems-engineering,
        ngm:symbolic-ai,
        ngm:systems-engineering ;
    vc:qualityScore "0.9"^^xsd:float ;
    vc:relatedTo ngm:autonomous-robot,
        ngm:combinatorial-optimisation,
        ngm:concurrent-engineering,
        ngm:cyber-physical-systems,
        ngm:digital-twin ;
    vc:requires ngm:constraint-satisfaction,
        ngm:knowledge-representation,
        ngm:optimization-algorithm,
        ngm:simulation ;
    vc:slug "constraint-based-design" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:additive-manufacturing,
        ngm:configuration-management,
