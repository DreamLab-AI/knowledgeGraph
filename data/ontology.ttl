        ngm:fourier-transform,
        ngm:gradient-descent,
        ngm:stationarity-testing .

ngm:token-swapping a owl:Class ;
    rdfs:label "Token Swapping"@en ;
    rdfs:comment "Token swapping is the on-chain exchange of one cryptocurrency or digital token for another without an intermediary custodian, executed atomically within a single transaction through smart contracts. The mechanism is implemented via automated market makers (AMMs), which price assets algorithmically using constant-function market-making formulas against liquidity pools, or via atomic swap protocols using hash time-locked contracts (HTLCs) that enable trustless cross-chain exchanges. Token swapping is the primary interaction primitive of decentralised exchanges and a building block for complex DeFi strategies."@en ;
    rdfs:subClassOf ngm:decentralized-finance-de-fi ;
    vc:enables ngm:de-fi,
        ngm:yield-farming ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:decentralized-exchange-dex,
        ngm:permissionless-trading,
        ngm:uniswap ;
    vc:slug "token-swapping" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:atomic-swap,
        ngm:automated-market-maker,
        ngm:liquidity-pool,
        ngm:smart-contract .

ngm:tracking-technology a owl:Class ;
    rdfs:label "Tracking Technology"@en ;
    rdfs:comment "Tracking Technology refers to the hardware and software systems that determine the real-time position, orientation, and motion of a user or device in physical space for extended reality applications. Approaches include inside-out tracking using onboard cameras and SLAM, outside-in tracking using fixed base stations, eye tracking for gaze-based interaction, and hand/finger tracking for controller-free input."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:sensor-fusion ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:slam ],
        ngm:infra-computing-and-cloud ;
    skos:broader ngm:infra-computing-and-cloud ;
    vc:enables ngm:eye-tracking,
        ngm:hand-tracking,
        ngm:motion-tracking ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:xr-hardware ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:sensor-fusion,
        ngm:slam ;
    vc:slug "tracking-technology" ;
    vc:sourceDomain "infrastructure" .

ngm:training-and-fine-tuning a owl:Class ;
    rdfs:label "Training and fine tuning"@en ;
    rdfs:comment "Fine-tuning is the post-pre-training adaptation of a large neural network — typically a transformer-based Foundation Models or Large Language Models — to narrower task distributions or behavioural objectives by continuing gradient-based optimisation on comparatively small, curated dataset..."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:knowledge-distillation ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:lo-ra-do-ra-etc ],
