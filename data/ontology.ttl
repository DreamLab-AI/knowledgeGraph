ngm:electric-actuator a owl:Class ;
    rdfs:label "Electric Actuator"@en ;
    rdfs:comment "Electric actuator converts electrical energy into controlled mechanical motion through electromagnetic forces, providing the primary means of actuation in modern robots."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:control-signal ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:mechanical-interface ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:electrical-power ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:power-electronics ],
        ngm:robo-actuation-and-control,
        ngm:robot-actuator ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:enables ngm:dynamic-responsiveness,
        ngm:force-exertion,
        ngm:motion-generation,
        ngm:precise-control ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:mechanical-interface,
        ngm:motor-winding,
        ngm:output-transmission,
        ngm:power-electronics ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires ngm:control-signal,
        ngm:electrical-power,
        ngm:load-support,
        ngm:thermal-dissipation ;
    vc:slug "electric-actuator" ;
    vc:sourceDomain "robotics" .

