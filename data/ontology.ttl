ngm:spatial-computing a owl:Class,
        skos:Concept ;
    rdfs:label "Spatial Computing"@en ;
    rdfs:comment "Spatial computing is a computing paradigm in which digital information, computation, and interaction are anchored to and organised within three-dimensional physical or virtual space, enabling humans and machines to engage with data as if it inhabits the real world. It integrates continuous spatial sensing — through depth cameras, LiDAR, inertial measurement units, and computer vision — with real-time 3D rendering and multi-modal input (gaze, gesture, voice, touch) to create systems that perceive, reason about, and respond to the user's physical environment. The paradigm subsumes augmented reality, mixed reality, virtual reality, and autonomous spatial agents, unifying them under a common architectural requirement: the continuous, low-latency alignment of digital representations with physical geometry."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:depth-sensing ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:simultaneous-localisation-and-mapping ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:sensor-fusion ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:low-latency ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:mixed-reality ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:virtual-reality ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:real-time-rendering ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:6-do-f-tracking ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:augmented-reality ] ;
    vc:bridgesTo ngm:3-d-reconstruction,
        ngm:extended-reality-xr,
        ngm:gesture-recognition ;
    vc:contrastsWith ngm:pervasive-computing ;
    vc:enables ngm:digital-twin,
        ngm:immersive-computing,
        ngm:metaverse,
        ngm:scene-understanding ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:6-do-f-tracking,
        ngm:augmented-reality,
        ngm:mixed-reality,
        ngm:simultaneous-localisation-and-mapping,
        ngm:virtual-reality ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:computing-paradigm ;
    vc:requires ngm:depth-sensing,
        ngm:low-latency,
        ngm:real-time-rendering,
        ngm:sensor-fusion ;
    vc:slug "spatial-computing" ;
    vc:sourceDomain "spatial-computing" ;
    vc:standardizedBy ngm:open-xr,
        ngm:web-xr ;
    vc:uses ngm:computer-vision,
        ngm:eye-tracking,
        ngm:geospatial-technology,
        ngm:gpu-computing,
        ngm:hand-tracking,
        ngm:haptic-feedback,
        ngm:head-mounted-display .

