ngm:mlops a owl:Class ;
    rdfs:label "MLOps"@en ;
    rdfs:comment "MLOps (Machine Learning Operations) is the set of practices, tools, and cultural norms that operationalise machine learning models at production scale by applying DevOps and Site Reliability Engineering principles to the full ML lifecycle. It covers end-to-end automation of ML pipelines — data ingestion, feature engineering, model training, evaluation, deployment, serving, and continuous retraining — and addresses the unique challenge that code, data, and model weights all evolve independently and must be versioned, tested, and governed together. MLOps introduces specialised artefacts such as model registries, feature stores, and experiment trackers that have no direct analogue in traditional software delivery. The discipline bridges the organisational gap between data science teams and production engineering, enabling reliable, auditable, and scalable model delivery at the pace business demands."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:feature-engineering ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-versioning ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:empirical-experimental-design-tracking ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:feature-store ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-pipeline ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:model-registry ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:version-control ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:machine-learning-discipline-pipeline ],
        ngm:machine-learning-discipline ;
    vc:bridgesTo ngm:data-engineering,
        ngm:platform-engineering ;
    vc:contrastsWith ngm:devops ;
    vc:dependsOn ngm:ai-monitoring,
        ngm:data-governance ;
    vc:enables ngm:ai-deployment,
        ngm:continuous-training,
        ngm:inference,
        ngm:model-monitoring,
        ngm:model-training ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:empirical-experimental-design-tracking,
        ngm:feature-store,
        ngm:machine-learning-discipline-pipeline,
        ngm:model-registry ;
    vc:isPartOf ngm:ai-lifecycle ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:a-b-testing,
        ngm:data-drift,
        ngm:model-serving ;
    vc:requires ngm:data-pipeline,
