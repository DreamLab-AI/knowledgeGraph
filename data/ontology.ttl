    vc:slug "navigation-stack" ;
    vc:sourceDomain "robotics" .
ngm:navigation-structure a skos:Concept ;
    rdfs:label "Navigation Structure"@en .
ngm:navigation-system a owl:Class ;
    rdfs:comment "An integrated set of hardware and software components that enables a robot or autonomous agent to determine its position, plan collision-free paths, and execute motion towards a goal. Navigation systems typically combine localisation, mapping, path planning, and obstacle avoidance modules, often relying on sensor fusion from LiDAR, cameras, and IMUs."@en ;
    rdfs:label "Navigation System"@en ;
    rdfs:subClassOf ngm:robo-navigation-and-planning ;
