ngm:computability-theory a owl:Class ;
    rdfs:label "Computability Theory"@en ;
    rdfs:comment "Computability theory, also known as recursion theory, is the branch of mathematical logic and theoretical computer science that studies which problems can be solved algorithmically in principle, independent of resource constraints. It defines models of computation such as the Turing machine, establishes the existence of undecidable problems like the halting problem, and characterises the limits of effective procedures via the Church-Turing thesis. It contrasts with complexity theory, which asks how efficiently solvable problems can be solved."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:formal-language ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:turing-machine ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:mathematical-logic ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:automata-theory ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:set-theory ],
        ngm:computational-complexity-theory,
        ngm:mathematical-logic ;
    vc:bridgesTo ngm:artificial-intelligence ;
    vc:contrastsWith ngm:computational-complexity-theory,
        ngm:hypercomputation ;
    vc:dependsOn ngm:mathematical-logic,
        ngm:set-theory ;
    vc:enables ngm:automata-theory,
        ngm:automated-theorem-proving,
        ngm:model-checking,
        ngm:programme-verification,
        ngm:programming-language-theory ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:automata-theory,
        ngm:decidability,
        ngm:formal-language,
        ngm:lambda-calculus,
        ngm:recursive-function,
        ngm:turing-degree,
        ngm:turing-machine ;
    vc:implements ngm:church-turing-thesis,
        ngm:reduction ;
    vc:qualityScore "0.9"^^xsd:float ;
    vc:relatedTo ngm:algorithm,
        ngm:cryptography,
        ngm:formal-language,
        ngm:godel-incompleteness,
        ngm:information-theory,
        ngm:kolmogorov-complexity,
        ngm:quantum-computing,
        ngm:type-theory ;
    vc:requires ngm:mathematical-logic,
        ngm:proof-theory,
        ngm:set-theory ;
    vc:slug "computability-theory" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:ai-safety,
        ngm:automated-reasoning,
        ngm:knowledge-representation .

ngm:computational-creativity a owl:Class ;
    rdfs:label "Computational Creativity"@en ;
    rdfs:comment "Computational creativity is the subfield of artificial intelligence concerned with building systems that exhibit behaviours regarded as creative, such as generating novel and valuable artefacts in art, music, design, or narrative. It studies both the algorithmic generation of original output and the evaluation of novelty, surprise, and value. The field informs generative models, procedural content systems, and AI-assisted creative tooling."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:procedural-content-generation ],
