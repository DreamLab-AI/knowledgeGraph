        <urn:visionflow:linked:signal-amplification>,
        vf:data-processing ;
    vc:slug "force-torque-sensor" ;
    vc:sourceDomain "robotics" .

vf:generative-model a owl:Class ;
    rdfs:label "Generative Model"@en ;
    rdfs:comment "Machine learning models that can generate new data samples by learning the underlying distribution of training data, including architectures like GANs, VAEs, diffusion models, and transformers."@en ;
