ngm:user-research a owl:Class ;
    rdfs:label "User Research"@en ;
    rdfs:comment "Systematic investigation of user behaviors, needs, preferences, and experiences in metaverse environments through qualitative and quantitative mods to inform design decisions and improve virtual world experiences."@en ;
