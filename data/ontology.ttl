    vc:enables ngm:continuous-deployment,
        ngm:high-availability ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:containerisation,
        ngm:microservices-architecture ;
    vc:isPartOf ngm:cloud-infrastructure ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:devops,
