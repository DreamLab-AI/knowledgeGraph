        ngm:spatial-computing ;
    vc:contrastsWith ngm:python,
        ngm:web-assembly ;
    vc:enables ngm:progressive-web-app,
        ngm:serverless-architecture,
        ngm:web-application ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:node-js,
        ngm:type-script,
        ngm:web-assembly ;
    vc:implements ngm:ecmascript ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:css,
