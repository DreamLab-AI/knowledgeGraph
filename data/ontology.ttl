ngm:pose-tracking a owl:Class ;
    rdfs:label "Pose Tracking"@en ;
    rdfs:comment "Pose tracking is the continuous estimation of the position and orientation (6-DoF pose) of a device, user, or body over time. In spatial computing it underpins head, hand, and controller tracking for AR and VR, fusing camera, IMU, and depth data at low latency. Accurate, drift-free pose tracking is essential for stable, comfortable immersive experiences."@en ;
    rdfs:subClassOf ngm:computer-vision ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:ar-display-device,
        ngm:spatial-computing ;
    vc:slug "pose-tracking" ;
    vc:sourceDomain "metaverse" .

ngm:potential-field-method a owl:Class ;
    rdfs:label "Potential Field Method"@en ;
    rdfs:comment "The Potential Field Method is a reactive robot navigation technique that models the goal as an attractive potential and obstacles as repulsive potentials, steering the robot along the negative gradient of the summed field. It produces smooth, real-time motion commands directly from sensor readings without explicit global search. Its principal weakness is susceptibility to local minima, where attractive and repulsive forces cancel and the robot stalls short of the goal."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:sensor-fusion ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:lidar ],
        ngm:path-planning ;
    vc:bridgesTo ngm:reinforcement-learning ;
    vc:contrastsWith ngm:motion-planning ;
    vc:enables ngm:collision-detection ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:motion-planning,
        ngm:path-planning ;
    vc:isPartOf ngm:robotics ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:collision-detection,
        ngm:gradient-descent,
        ngm:navigation ;
    vc:requires ngm:lidar,
        ngm:sensor-fusion ;
    vc:slug "potential-field-method" ;
    vc:sourceDomain "robotics" ;
    vc:supports ngm:mobile-robot ;
    vc:uses ngm:gradient-descent,
        ngm:sensor-fusion .

ngm:poverty-reduction a owl:Class ;
    rdfs:label "Poverty Reduction"@en ;
    rdfs:comment "Poverty Reduction encompasses the policies, programmes, and structural changes aimed at decreasing the proportion of individuals living below nationally or internationally defined poverty thresholds, improving access to essential goods, services, and economic opportunities. Approaches span conditional cash transfer schemes, microfinance, labour market reforms, progressive taxation, and targeted public service delivery. It is central to the United Nations Sustainable Development Goals (SDGs), most directly SDG-1 (No Poverty) and SDG-10 (Reduced Inequalities). Successful poverty reduction typically requires complementary progress in health, education, infrastructure, and governance quality."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:policy ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
