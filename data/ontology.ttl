        ngm:structural-analysis,
        ngm:thermal-management,
        ngm:vibration-damping ;
    vc:slug "robot-link" ;
    vc:sourceDomain "robotics" .

ngm:robotics-platform a owl:Class ;
    rdfs:label "Robotics Platform"@en ;
    rdfs:comment "RoboticsPlatform is an integrated hardware–software–middleware ecosystem providing standardised communication layers, hardware abstraction, simulation environments, motion-planning stacks, real-time control loops, and cloud-edge orchestration that collectively reduce engineering effort for robot ..."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
