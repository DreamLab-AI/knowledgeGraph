ngm:ar-registration a owl:Class ;
    rdfs:label "AR Registration"@en ;
    rdfs:comment "AR Registration is the spatial alignment process that anchors virtual content to real-world coordinates through Computer Vision, Sensor Input, and tracking algorithms."@en ;
