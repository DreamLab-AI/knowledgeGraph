ngm:zero-knowledge-proof-zkp a owl:Class ;
    rdfs:label "Zero-Knowledge Proof (ZKP)"@en ;
    rdfs:comment "A cryptographic protocol that enables one party (the prover) to prove to another party (the verifier) that a statement is true without revealing any information beyond the validity of the statement itself."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:plonk ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:elliptic-curve-cryptography ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:bulletproofs ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:zk-snarks ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptographic-hash-function ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:zk-starks ],
        ngm:cryptography,
        ngm:infra-security-and-identity ;
    skos:broader ngm:infra-security-and-identity ;
    vc:enables ngm:confidential-transactions,
        ngm:privacy-preserving-identity,
        ngm:private-authentication,
        ngm:verifiable-computation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:bulletproofs,
        ngm:interactive-zkp,
        ngm:non-interactive-zkp,
        ngm:plonk,
        ngm:zk-snarks,
        ngm:zk-starks ;
    vc:isPartOf ngm:cryptographic-verification-system,
        ngm:privacy-preserving-protocol ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:cryptographic-hash-function,
        ngm:elliptic-curve-cryptography,
        ngm:polynomial-commitment-scheme ;
    vc:slug "zero-knowledge-proof-zkp" ;
    vc:sourceDomain "infrastructure" .

