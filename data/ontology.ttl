    vcw:owlRole "concept" .

# Supervised Learning
artificial-intelligence:SupervisedLearning rdf:type owl:Class ;
    rdfs:subClassOf artificial-intelligence:owlThing ;
    rdfs:label "Supervised Learning"@en ;
    rdfs:comment "Supervised Learning is the machine learning paradigm where models learn from labeled training data to predict outputs for new, unseen inputs. The learning algorithm finds patterns mapping input features to target labels, guided by a loss function measuring prediction errors. Key tasks include classification (discrete labels) and regression (continuous values). Common algorithms span linear models, decision trees, support vector machines, neural networks, and ensemble methods. Supervised learning requires curated datasets with ground-truth labels and addresses challenges of overfitting, generalization, and class imbalance."@en ;
    skos:prefLabel "Supervised Learning"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:artificial-intelligence:supervised-learning" ;
    owl:sameAs <urn:visionclaw:concept:artificial-intelligence:supervised-learning> ;
    vcw:contentHash "sha256-12-7b7055450eaa" ;
    vcw:qualityScore "0.35"^^xsd:decimal ;
    vcw:legacyTermId "AI-9033" ;
    vcw:ontologyStatus "draft" ;
    vcw:maturityLevel "draft" ;
    vcw:authorityScore "0.0"^^xsd:decimal ;
    dcterms:identifier "AI-9033" ;
    dcterms:subject "artificial-intelligence" ;
    owl:versionInfo "2.0.0" ;
    dcterms:created "2026-04-26T00:00:00Z"^^xsd:dateTime ;
    dcterms:modified "2026-04-26T13:00:00Z"^^xsd:dateTime ;
    vcw:owlRole "concept" .

# System Architecture
artificial-intelligence:SystemArchitecture rdf:type owl:Class ;
    rdfs:subClassOf artificial-intelligence:owlThing ;
    rdfs:label "System Architecture"@en ;
    rdfs:comment "System Architecture in AI defines the holistic structure integrating hardware, software, data infrastructure, and operational components to deliver intelligent capabilities at scale. This encompasses distributed training infrastructure, inference servers, data pipelines, model registries, monitoring systems, and edge-cloud coordination. Architectural decisions address latency requirements, throughput targets, fault tolerance, security, and cost optimization. Modern AI systems adopt cloud-native, containerized architectures with orchestration platforms (Kubernetes), enabling elastic scaling, multi-tenancy, and global deployment."@en ;
    skos:prefLabel "System Architecture"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:artificial-intelligence:system-architecture" ;
    owl:sameAs <urn:visionclaw:concept:artificial-intelligence:system-architecture> ;
    vcw:contentHash "sha256-12-bd479bd670d7" ;
    vcw:qualityScore "0.35"^^xsd:decimal ;
    vcw:legacyTermId "AI-9034" ;
    vcw:ontologyStatus "draft" ;
    vcw:maturityLevel "draft" ;
    vcw:authorityScore "0.0"^^xsd:decimal ;
    dcterms:identifier "AI-9034" ;
    dcterms:subject "artificial-intelligence" ;
    owl:versionInfo "2.0.0" ;
    dcterms:created "2026-04-26T00:00:00Z"^^xsd:dateTime ;
    dcterms:modified "2026-04-26T13:00:00Z"^^xsd:dateTime ;
    vcw:owlRole "concept" .

# Unsupervised Learning
artificial-intelligence:UnsupervisedLearning rdf:type owl:Class ;
    rdfs:subClassOf artificial-intelligence:owlThing ;
    rdfs:label "Unsupervised Learning"@en ;
    rdfs:comment "Unsupervised Learning discovers hidden patterns, structures, and representations in unlabeled data without explicit supervision. Key techniques include clustering (k-means, hierarchical, DBSCAN), dimensionality reduction (PCA, t-SNE, UMAP), density estimation, anomaly detection, and generative modeling (VAEs, GANs). Unsupervised methods extract meaningful features, identify data clusters, reduce dimensionality for visualization, and learn latent representations. Applications span exploratory data analysis, data preprocessing for supervised learning, recommendation systems, and generative AI."@en ;
    skos:prefLabel "Unsupervised Learning"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:artificial-intelligence:unsupervised-learning" ;
    owl:sameAs <urn:visionclaw:concept:artificial-intelligence:unsupervised-learning> ;
    vcw:contentHash "sha256-12-641e60815887" ;
    vcw:qualityScore "0.35"^^xsd:decimal ;
    vcw:legacyTermId "AI-9035" ;
    vcw:ontologyStatus "draft" ;
    vcw:maturityLevel "draft" ;
    vcw:authorityScore "0.0"^^xsd:decimal ;
    dcterms:identifier "AI-9035" ;
    dcterms:subject "artificial-intelligence" ;
    owl:versionInfo "2.0.0" ;
    dcterms:created "2026-04-26T00:00:00Z"^^xsd:dateTime ;
    dcterms:modified "2026-04-26T13:00:00Z"^^xsd:dateTime ;
    vcw:owlRole "concept" .

# Video Processing
artificial-intelligence:VideoProcessing rdf:type owl:Class ;
    rdfs:subClassOf artificial-intelligence:owlThing ;
    rdfs:label "Video Processing"@en ;
    rdfs:comment "Video Processing in AI involves computational analysis, understanding, and manipulation of video data using machine learning and computer vision techniques. Core tasks include object detection and tracking, action recognition, video segmentation, temporal modeling, scene understanding, and video generation. Modern approaches leverage 3D convolutional networks, recurrent architectures, transformers for temporal reasoning, and self-supervised learning on large video datasets. Applications span surveillance, autonomous driving, content moderation, sports analytics, medical imaging, and video editing automation."@en ;
    skos:prefLabel "Video Processing"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:artificial-intelligence:video-processing" ;
    owl:sameAs <urn:visionclaw:concept:artificial-intelligence:video-processing> ;
    vcw:contentHash "sha256-12-eddc39098d50" ;
    vcw:qualityScore "0.35"^^xsd:decimal ;
    vcw:legacyTermId "AI-9036" ;
    vcw:ontologyStatus "draft" ;
    vcw:maturityLevel "draft" ;
    vcw:authorityScore "0.0"^^xsd:decimal ;
