    vc:slug "dense-passage-retrieval" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:embedding,
        ngm:transformer,
        ngm:vector-database .

ngm:density-estimation a owl:Class ;
    rdfs:label "Density Estimation"@en ;
    rdfs:comment "Density estimation is the statistical problem of inferring the underlying probability density function of a random variable from a finite set of observed samples. Parametric approaches assume a fixed functional form whose parameters are fitted by maximum likelihood, while non-parametric approaches such as kernel density estimation and histograms make minimal distributional assumptions. Modern deep density estimation uses normalizing flows, autoregressive models, and variational methods to model complex high-dimensional distributions, making it foundational to generative modelling, anomaly detection, and unsupervised learning."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:maximum-likelihood-estimation ],
        ngm:statistics ;
    vc:contrastsWith ngm:supervised-learning ;
    vc:enables ngm:anomaly-detection,
        ngm:generative-model,
        ngm:outlier-detection ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:kernel-density-estimation,
        ngm:maximum-likelihood-estimation ;
    vc:implements ngm:gaussian-mixture-model,
        ngm:normalizing-flow ;
    vc:isPartOf ngm:unsupervised-learning ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:entropy,
        ngm:information-theory,
        ngm:variational-autoencoder ;
    vc:slug "density-estimation" ;
    vc:sourceDomain "machine-learning" ;
    vc:uses ngm:maximum-likelihood-estimation,
        ngm:probability-distribution,
        ngm:sampling .

ngm:derivatives-trading a owl:Class ;
    rdfs:label "Derivatives Trading"@en ;
    rdfs:comment "Derivatives trading is the buying and selling of financial contracts whose value is derived from an underlying asset, index or rate, such as futures, options, swaps and perpetual contracts. Traders use these instruments to hedge exposure, gain leveraged directional exposure or speculate on price movements without holding the underlying. In decentralised finance, derivatives are implemented through smart contracts that handle margin, settlement and liquidation on-chain."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:settlement ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:liquidity-pool ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:order-book ],
        ngm:digital-asset-trading ;
    vc:bridgesTo ngm:automated-market-maker,
        ngm:decentralized-finance ;
    vc:dependsOn ngm:settlement ;
    vc:enables ngm:digital-asset-trading,
        ngm:risk-management ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:order-book ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:blockchain,
        ngm:digital-asset-trading ;
    vc:requires ngm:liquidity-pool,
        ngm:settlement ;
    vc:slug "derivatives-trading" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:risk-management ;
    vc:uses ngm:order-book,
        ngm:smart-contract .

ngm:design-systems a owl:Class ;
    rdfs:label "Design Systems"@en ;
    rdfs:comment "A design system is a single source of truth that combines reusable UI components, design tokens, patterns, and documentation governing how a product looks and behaves. It unifies designers and engineers around a shared component library and usage guidelines, ensuring consistency and accelerating delivery across teams and platforms. It encompasses both the visual language and the coded implementation that enforces it."@en ;
    rdfs:subClassOf ngm:software-development ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:human-computer-interaction,
