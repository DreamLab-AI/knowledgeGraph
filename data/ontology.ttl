ngm:centralized-swarm-control a owl:Class ;
    rdfs:label "Centralized Swarm Control"@en ;
    rdfs:comment "Swarm robotics control architecture where a central controller coordinates all robot agents, providing global optimisation but creating a single point of failure."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:computational-resources ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:inter-agent-communication ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:communication-network ],
        ngm:control-system,
        ngm:robo-robot-type,
        ngm:swarm-control ;
    skos:broader ngm:robo-robot-type ;
    vc:enables ngm:centralised-monitoring,
        ngm:coordinated-swarm-behaviour,
        ngm:global-task-optimisation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:central-controller,
        ngm:communication-network,
        ngm:global-state-model ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires ngm:computational-resources,
        ngm:inter-agent-communication,
        ngm:synchronised-timing ;
    vc:slug "centralized-swarm-control" ;
    vc:sourceDomain "robotics" .

