ngm:ambisonics a owl:Class ;
    rdfs:label "Ambisonics"@en ;
    rdfs:comment "Ambisonics is a full-sphere surround sound technique that represents a sound field independently of any specific loudspeaker layout by encoding it into spherical harmonic components. A captured or synthesised scene is stored as B-format channels and later decoded to an arbitrary speaker array or to binaural headphones, allowing the same recording to be rendered for many playback configurations. It is widely used for immersive and head-tracked audio in virtual and augmented reality."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:spherical-harmonics ],
        ngm:spatial-audio ;
    vc:dependsOn ngm:signal-processing ;
    vc:enables ngm:immersive-audio,
        ngm:spatial-audio ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:spherical-harmonics ;
    vc:implements ngm:audio-spatialization ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:audio-system,
        ngm:psychoacoustics ;
    vc:slug "ambisonics" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:augmented-reality,
        ngm:virtual-reality ;
    vc:uses ngm:audio-codec,
        ngm:signal-processing .

ngm:animation-retargeting a owl:Class ;
    rdfs:label "Animation Retargeting"@en ;
    rdfs:comment "Animation Retargeting is the process of transferring motion capture or animation data from one character skeleton to another with different proportions, joint configurations, or bone structures, enabling reuse of animation assets across diverse character models in games, film, and virtual environments."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:inverse-kinematics ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:character-rigging ],
        ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:bridgesTo ngm:computer-vision,
        ngm:machine-learning ;
    vc:contrastsWith ngm:keyframe-animation,
        ngm:procedural-animation ;
    vc:dependsOn ngm:animation,
        ngm:motion-capture ;
    vc:enables ngm:avatar,
        ngm:avatar-animation,
        ngm:character-animation,
        ngm:motion-capture,
        ngm:real-time-animation ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:blend-shape,
        ngm:digital-humans,
        ngm:skinning ;
    vc:requires ngm:character-rigging,
        ngm:inverse-kinematics ;
    vc:slug "animation-retargeting" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:coordinate-transformation,
        ngm:forward-kinematics .

ngm:animation-rig a owl:Class ;
    rdfs:label "Animation Rig"@en ;
    rdfs:comment "An animation rig is a hierarchical system of bones, controls, and constraints applied to a 3D character or object to enable articulated movement for animation. It abstracts underlying mesh deformation through a control interface that animators manipulate, translating high-level poses into low-level vertex transformations. Rigs range from simple skeletal setups to complex systems incorporating inverse kinematics, blend shapes, and procedural dynamics."@en ;
    rdfs:subClassOf ngm:skeletal-animation ;
    vc:enables ngm:character-animation,
        ngm:procedural-animation ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:3-d-animation,
        ngm:mesh-data ;
    vc:slug "animation-rig" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:inverse-kinematics,
        ngm:motion-capture .

ngm:api-specification a owl:Class ;
    rdfs:label "API Specification"@en ;
    rdfs:comment "An API Specification is a formal, machine-readable document that precisely defines the interface contract of a software API, including its endpoints, request and response schemas, authentication requirements, and error codes. It enables automated tooling such as code generation, validation, and interactive documentation to be derived directly from a single source of truth. Common specification formats include OpenAPI, AsyncAPI, and GraphQL SDL."@en ;
    rdfs:subClassOf ngm:infra-software-engineering ;
    skos:broader ngm:infra-software-engineering ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:web-services ;
    vc:slug "api-specification" ;
    vc:sourceDomain "infrastructure" .

ngm:assistive-robotics a owl:Class ;
    rdfs:label "Assistive Robotics"@en ;
    rdfs:comment "Assistive Robotics is a branch of robotics concerned with designing, building, and deploying robotic systems that augment, restore, or substitute impaired human physical and cognitive functions for people with disabilities, age-related decline, or rehabilitation needs. Systems span powered exoskeletons for gait restoration, robotic prostheses with sensorimotor feedback, autonomous mobility aids, and socially interactive companion robots that provide cognitive and emotional support. Operating in close physical proximity to humans, these devices must satisfy stringent requirements for safety, transparency, and user control while integrating sensing, AI-driven intent inference, and adaptive interfaces that respond to changing physiological states."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:human-robot-interaction ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:exoskeleton-robot ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:actuator ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:embedded-systems ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:social-robotics ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:sensor-fusion ],
        ngm:robotic-system ;
    vc:bridgesTo ngm:affective-computing,
        ngm:ai-companions ;
    vc:contrastsWith ngm:industrial-robotics ;
    vc:dependsOn ngm:battery-management-system,
        ngm:machine-learning,
        ngm:real-time-control ;
    vc:enables ngm:accessibility,
        ngm:independent-living ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:exoskeleton-robot,
        ngm:social-robotics ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:compliant-actuation,
        ngm:neuroprosthetics,
        ngm:wearable-robotics ;
    vc:requires ngm:actuator,
        ngm:embedded-systems,
        ngm:human-robot-interaction,
        ngm:sensor-fusion ;
    vc:slug "assistive-robotics" ;
    vc:sourceDomain "robotics" ;
    vc:standardizedBy ngm:iso-13482 ;
    vc:supports ngm:disability-inclusion ;
    vc:uses ngm:brain-computer-interfaces,
        ngm:electromyography,
        ngm:lower-limb-exoskeleton,
        ngm:natural-language-processing .

ngm:audio-processing-system a owl:Class ;
    rdfs:label "Audio Processing System"@en ;
    rdfs:comment "An Audio Processing System is a hardware or software subsystem responsible for capturing, transforming, and rendering audio signals within spatial computing environments. It encompasses digital signal processing, spatial audio rendering (binaural, ambisonics, HRTF), noise cancellation, speech recognition integration, and real-time mixing for immersive presence."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:microphone-array ],
        [ a owl:Restriction ;
