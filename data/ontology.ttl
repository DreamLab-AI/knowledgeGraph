ngm:block-size a owl:Class ;
    rdfs:label "Block Size"@en ;
    rdfs:comment "Block Size is the maximum data capacity—measured in bytes or weight units—that a single block in a blockchain may contain, governing how many transactions can be confirmed per block and therefore setting a fundamental upper bound on network throughput. Larger blocks increase per-block transaction capacity but raise propagation latency, orphan-block rates, and hardware requirements for full nodes, while smaller blocks favour decentralisation and faster propagation at the cost of throughput and higher fee markets when demand exceeds capacity. The Bitcoin block-size debate (resulting in the SegWit upgrade and eventual Bitcoin Cash fork) made block size one of the most consequential and politically contentious protocol parameters in blockchain history."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:block ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:blockchain ],
        ngm:bc-protocol-and-consensus,
        ngm:blockchain-entity,
        ngm:distributed-data-structure ;
    skos:broader ngm:bc-protocol-and-consensus ;
    vc:enables ngm:finality,
        ngm:transaction ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:block-time,
        ngm:distributed-ledger,
        ngm:gas,
        ngm:latency,
        ngm:network-protocol,
        ngm:sidechain ;
    vc:requires ngm:block,
        ngm:blockchain ;
    vc:slug "block-size" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:consensus-mechanism,
        ngm:merkle-tree,
        ngm:node .

ngm:block-trails a owl:Class ;
    rdfs:label "Block Trails"@en ;
    rdfs:comment "Block Trails is a minimal Bitcoin-native state-anchoring primitive that records an evolving sequence of states as a cryptographic chain of key tweaks mirroring a Bitcoin spend chain. Each state transition derives a tweak t_i = SHA256(state_i) mod n which is scalar-added to the previous key (d_i = d_(i-1) + t_i), producing a fresh pay-to-Taproot (P2TR) key-path output; spending that output to create the next commitment makes every UTXO a single-use seal. The state bytes themselves live off-chain on IPFS, Git, or Nostr relays, while Bitcoin's UTXO model supplies ordering and double-spend protection so that exactly one valid history can exist. Because trails use full secp256k1 keys, existing Nostr identities can own and advance a trail without key conversion. Application semantics are defined by Profiles such as MRC20 (a fungible-token ledger) and Git-mark (anchoring Git commits)."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:single-use-seals ],
        ngm:client-side-validation ;
    vc:bridgesTo ngm:content-addressed-storage,
        ngm:git,
        ngm:nostr ;
    vc:contrastsWith ngm:rgb-protocol,
        ngm:taproot-assets ;
    vc:dependsOn ngm:bitcoin-network,
        ngm:proof-of-publication,
        ngm:utxo-model ;
    vc:enables ngm:asset-tokenisation,
        ngm:fungible-token,
        ngm:provenance-tracking ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:single-use-seals ;
    vc:implements ngm:client-side-validation,
        ngm:single-use-seals ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:decentralised-application,
        ngm:layer-2-scaling,
        ngm:rgb-and-client-side-validation ;
    vc:slug "block-trails" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:cryptographic-commitment,
        ngm:schnorr-signature,
        ngm:secp256k1,
        ngm:sha-256,
        ngm:taproot .

ngm:bolt a owl:Class ;
    rdfs:label "BOLT"@en ;
    rdfs:comment "BOLT, the Basis of Lightning Technology, is the set of specifications that define how Lightning Network implementations interoperate. The documents cover channels, routing, and messaging."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
