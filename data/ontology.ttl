ngm:client-server-architecture a owl:Class ;
    rdfs:comment "Client-server architecture is a distributed computing model in which client processes request services or resources and dedicated server processes provide them, typically over a network. The model centralises shared resources, data and logic on servers while distributing presentation and interaction to many clients. It is the foundational pattern for the web, networked applications and most online services, and it contrasts with peer-to-peer architectures where every node is both provider and consumer."@en ;
    rdfs:label "Client-Server Architecture"@en ;
    rdfs:subClassOf ngm:distributed-architecture ;
