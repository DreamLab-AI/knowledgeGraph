        <urn:visionflow:linked:material-selection>,
        <urn:visionflow:linked:structural-analysis>,
        <urn:visionflow:linked:thermal-management>,
        <urn:visionflow:linked:vibration-damping> ;
    vc:slug "robot-link" ;
    vc:sourceDomain "robotics" .

