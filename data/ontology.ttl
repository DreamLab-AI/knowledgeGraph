    vc:enables ngm:clinical-decision-support,
        ngm:drug-discovery,
        ngm:genomic-analysis,
        ngm:patient-risk-stratification,
        ngm:precision-medicine ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:ai-ethics,
        ngm:bias-in-ai,
        ngm:pathology-ai,
        ngm:radiology-ai ;
    vc:requires ngm:data-privacy,
        ngm:electronic-health-records,
        ngm:health-data-governance,
        ngm:model-explainability ;
    vc:slug "healthcare-ai" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:standardizedBy ngm:dicom,
        ngm:eu-mdr,
        ngm:fda-samd-regulation,
        ngm:hl7-fhir ;
    vc:uses ngm:computer-vision,
        ngm:deep-learning,
        ngm:federated-learning,
        ngm:large-language-models,
        ngm:medical-imaging,
        ngm:natural-language-processing .

ngm:humanoid-robot a owl:Class ;
    rdfs:label "Humanoid Robot"@en ;
    rdfs:comment "A humanoid robot is an autonomous or semi-autonomous mechanical system whose overall morphology, kinematic chain, and sensorimotor organisation deliberately mirrors the human body plan: a vertical torso supported on two bipedal legs, bilateral upper limbs terminating in multi-fingered end-effecto..."@en ;
