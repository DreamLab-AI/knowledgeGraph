ngm:iso-iec-jtc-1 a owl:Class ;
    rdfs:label "ISO/IEC JTC 1"@en ;
    rdfs:comment "ISO/IEC JTC 1 is the Joint Technical Committee established by the International Organization for Standardization and the International Electrotechnical Commission to develop standards in information technology. Its subcommittees produce standards across areas such as coding, data management, AI, cloud computing, IoT, and multimedia. It is the principal international body coordinating IT standardisation that enables cross-domain convergence and interoperability."@en ;
    rdfs:subClassOf ngm:standards-body ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:convergence,
        ngm:physical-layer ;
    vc:slug "iso-iec-jtc-1" ;
    vc:sourceDomain "governance" .

ngm:iso-iec-jtc-1-sc-27 a owl:Class ;
    rdfs:label "ISO/IEC JTC 1/SC 27"@en ;
    rdfs:comment "ISO/IEC JTC 1/SC 27 is the joint ISO and IEC subcommittee responsible for developing international standards on information security, cybersecurity and privacy protection. Its remit includes the ISO/IEC 27000 family of information security management standards, cryptographic techniques, security evaluation criteria and identity management. It is the principal global body coordinating consensus standards in the security and privacy domain."@en ;
    rdfs:subClassOf ngm:standards-body ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:cryptography-security-and-privacy,
        ngm:decentralized-identifiers ;
    vc:slug "iso-iec-jtc-1-sc-27" ;
    vc:sourceDomain "security" .

ngm:iso-tc-299 a owl:Class ;
    rdfs:label "ISO/TC 299"@en ;
    rdfs:comment "ISO/TC 299 is the ISO technical committee responsible for standardization in the field of robotics, excluding toys and military applications. It develops international standards covering robot terminology, safety requirements, performance criteria and modularity for industrial, service and collaborative robots. Its work underpins the regulatory and interoperability framework for robot deployment worldwide."@en ;
    rdfs:subClassOf ngm:standards-body ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:robot-standard ;
    vc:slug "iso-tc-299" ;
    vc:sourceDomain "robotics" .

ngm:itu-t a owl:Class ;
    rdfs:label "ITU-T"@en ;
    rdfs:comment "ITU-T is the Telecommunication Standardization Sector of the International Telecommunication Union, a United Nations agency that develops international standards (Recommendations) for telecommunications and information technology. Its work spans video and audio coding, network protocols, public-key infrastructure and digital signatures. ITU-T Recommendations such as the H-series video codecs and X.509 are foundational to global communications interoperability."@en ;
    rdfs:subClassOf ngm:standards-body ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:digital-signature,
        ngm:proprietary-video ;
    vc:slug "itu-t" ;
    vc:sourceDomain "infrastructure" .

ngm:java a owl:Class ;
    rdfs:label "Java"@en ;
    rdfs:comment "Java is a class-based, object-oriented, statically typed programming language designed to run on the Java Virtual Machine, enabling write-once-run-anywhere portability across platforms. It compiles to bytecode executed by the JVM and emphasises strong typing, automatic memory management and a vast standard library. Java is widely used in enterprise back-end systems, Android development and permissioned blockchain platforms."@en ;
    rdfs:subClassOf ngm:programming-language ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:enterprise-smart-contracts,
        ngm:kotlin ;
    vc:slug "java" ;
    vc:sourceDomain "infrastructure" .

ngm:jax a owl:Class ;
    rdfs:label "JAX"@en ;
    rdfs:comment "A Python library from Google for high-performance numerical computing and machine learning research, combining NumPy-style array operations with automatic differentiation and just-in-time compilation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:automatic-differentiation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:hardware-acceleration ],
        ngm:deep-learning-domain ;
    vc:enables ngm:backpropagation ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:automatic-differentiation,
        ngm:hardware-acceleration ;
    vc:slug "jax" ;
    vc:sourceDomain "deep-learning" .

ngm:join-semilattice a owl:Class ;
    rdfs:label "Join-Semilattice"@en ;
    rdfs:comment "A join-semilattice is a partially ordered set in which every pair of elements has a least upper bound (join), making the join operation associative, commutative and idempotent. These algebraic properties guarantee that repeated or reordered merges converge to a unique value. The structure is the mathematical foundation for state-based conflict-free replicated data types."@en ;
    rdfs:subClassOf ngm:distributed-data-structure ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:crdt ;
    vc:slug "join-semilattice" ;
    vc:sourceDomain "data" .

ngm:joint-mechanics a owl:Class ;
    rdfs:label "Joint Mechanics"@en ;
    rdfs:comment "Joint mechanics is the study of the physical behaviour of robotic and mechanical joints, including the forces, torques, friction, compliance and backlash that govern their motion. It models how power is transmitted through bearings, gears and linkages and how non-ideal effects degrade precision. Understanding joint mechanics is essential for accurate dynamic modelling and high-fidelity motion control."@en ;
    rdfs:subClassOf ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:backlash,
        ngm:friction ;
    vc:slug "joint-mechanics" ;
    vc:sourceDomain "robotics" .

ngm:journal-of-machine-learning-research a owl:Class ;
    rdfs:label "Journal of Machine Learning Research"@en ;
    rdfs:comment "The Journal of Machine Learning Research (JMLR) is a peer-reviewed, open-access scientific journal publishing original research in all areas of machine learning. Founded in 2000, it is among the most influential venues in the field and freely disseminates articles without author or reader fees. JMLR also publishes software and benchmark contributions that establish methodological standards for the community."@en ;
    rdfs:subClassOf ngm:ai-research-area ;
    skos:broader ngm:ai-research-area ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:learning-algorithm,
        ngm:probabilistic-model ;
    vc:slug "journal-of-machine-learning-research" ;
    vc:sourceDomain "ai" .

ngm:jurisdictional-boundary a owl:Class ;
    rdfs:label "Jurisdictional Boundary"@en ;
    rdfs:comment "Legal and regulatory demarcations applicable to metaverse and virtual world governance, addressing the complex challenge of determining which laws apply when virtual activities span multiple physical jurisdictions with no clear territorial boundaries."@en ;
    rdfs:subClassOf ngm:legal-framework,
        ngm:sc-governance-and-safety ;
    skos:broader ngm:sc-governance-and-safety ;
    vc:enables ngm:virtual-world-governance ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:slug "jurisdictional-boundary" ;
    vc:sourceDomain "spatial-computing" .

ngm:just-transition a owl:Class ;
    rdfs:label "Just Transition"@en ;
    rdfs:comment "A just transition is a framework for shifting economies toward low-carbon and sustainable production while ensuring that the burdens and benefits of that shift are distributed fairly. It seeks to protect workers, communities and developing regions dependent on carbon-intensive industries through retraining, social support and inclusive planning. The concept links climate policy with social equity and labour rights."@en ;
    rdfs:subClassOf ngm:sustainability ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:ethical-sourcing,
        ngm:global-inequality ;
    vc:slug "just-transition" ;
    vc:sourceDomain "governance" .

ngm:k-anonymity-in-datasets a owl:Class ;
    rdfs:label "k-Anonymity in Datasets"@en ;
    rdfs:comment "k-Anonymity is a dataset privacy property that guarantees each record is indistinguishable from at least k-1 other records with respect to quasi-identifier attributes—fields such as age, gender, and postal code that can be combined to re-identify individuals. Anonymization is achieved through generalisation (replacing specific values with broader categories) and suppression (removing highly identifying records), producing equivalence classes where all members share identical quasi-identifier values."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-anonymization-pipeline ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-governance ],
        ngm:ai-technique,
        ngm:privacy-preserving-analytics ;
    skos:broader ngm:ai-technique ;
    vc:contrastsWith ngm:federated-learning,
        ngm:homomorphic-encryption ;
    vc:enables ngm:gdpr-compliance,
        ngm:privacy-preserving-data-sharing ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:data-protection,
        ngm:differential-privacy,
        ngm:privacy-mechanism,
        ngm:privacy-preserving-analytics,
        ngm:synthetic-data ;
    vc:requires ngm:data-anonymization-pipeline,
        ngm:data-governance ;
    vc:slug "k-anonymity-in-datasets" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:synthetic-data-generation .

ngm:kernel-methods a owl:Class ;
    rdfs:label "Kernel Methods"@en ;
    rdfs:comment "Kernel methods are a class of machine learning algorithms that operate on data implicitly mapped into a high-dimensional feature space via a kernel function, without computing coordinates in that space. The kernel trick replaces inner products with kernel evaluations, enabling linear algorithms to learn non-linear relationships. They underpin support vector machines, Gaussian processes and kernel ridge regression."@en ;
    rdfs:subClassOf ngm:machine-learning-technique ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:gaussian-process,
        ngm:stochastic-process ;
    vc:slug "kernel-methods" ;
    vc:sourceDomain "ai" .

ngm:kinematic-element a owl:Class ;
    rdfs:label "Kinematic Element"@en ;
    rdfs:comment "A Kinematic Element is a rigid body or joint primitive within a robot's mechanical structure that participates in the forward and inverse kinematic chain, defining the positional and orientational degrees of freedom of a limb segment. Chains of kinematic elements model the geometry of robotic arms, legs, and manipulators for motion planning and control."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:control-system ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:actuator ],
        ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:enables ngm:legged-robot,
        ngm:mobile-robot ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:actuator ;
    vc:isPartOf ngm:robot ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:control-system ;
    vc:slug "kinematic-element" ;
    vc:sourceDomain "robotics" .

ngm:klima-dao a owl:Class ;
    rdfs:label "KlimaDAO"@en ;
    rdfs:comment "A decentralised organisation that acquires and holds tokenised carbon credits in its treasury, issuing a token backed by those credits to channel capital toward carbon retirement."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:treasury-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:carbon-credit-token ],
        ngm:decentralised-autonomous-organisation ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:carbon-credit-token,
        ngm:treasury-management ;
    vc:slug "klima-dao" ;
    vc:sourceDomain "blockchain" .

ngm:knowhere a owl:Class ;
    rdfs:label "Knowhere"@en ;
    rdfs:comment "KnoWhere is an AI-driven visitor attention-tracking system for museums and immersive experience spaces, using computer vision and machine vision cameras to capture gaze vectors, emotion signals, and spatial attention metrics in real time without wearables. It enables hyper-personalised narrative adaptation and provides curators with actionable behavioural analytics whilst preserving visitor privacy through anonymised data processing."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:segmentation-and-identification ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:privacy ],
        ngm:infra-computing-and-cloud,
        ngm:tracking-technology ;
    skos:broader ngm:infra-computing-and-cloud ;
    vc:enables ngm:immersive-experience,
        ngm:user-experience ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:segmentation-and-identification ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires ngm:privacy ;
    vc:slug "knowhere" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:computer-vision,
        ngm:edge-computing,
        ngm:neural-network,
        ngm:sensor-fusion .

ngm:knowledge-co-construction a owl:Class ;
    rdfs:label "Knowledge Co-Construction"@en ;
    rdfs:comment "Knowledge co-construction is a process in which participants jointly build shared understanding through dialogue, negotiation and the integration of multiple perspectives. Rather than transmitting fixed knowledge, it treats understanding as emergent from collaborative interaction. It is a central mechanism in collaborative and collective learning environments."@en ;
    rdfs:subClassOf ngm:educational-technology ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:collaborative-learning,
        ngm:collective-learning ;
    vc:slug "knowledge-co-construction" ;
    vc:sourceDomain "ai" .

ngm:knowledge-organization a owl:Class ;
    rdfs:label "Knowledge Organization"@en ;
    rdfs:comment "The systematic arrangement, classification, and representation of knowledge structures so that information can be discovered, related, and reasoned over. Knowledge organization encompasses taxonomies, thesauri, ontologies, and knowledge graphs, and underpins semantic search, question answering, and AI knowledge-base construction."@en ;
    rdfs:subClassOf ngm:ai-research-area ;
    skos:broader ngm:ai-research-area ;
    vc:enables ngm:information-retrieval,
        ngm:knowledge-representation ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:relatedTo ngm:knowledge-organization-system,
        ngm:linked-data ;
    vc:slug "knowledge-organization" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:knowledge-graph,
        ngm:ontology .

ngm:knowledge-preservation a owl:Class ;
    rdfs:label "Knowledge Preservation"@en ;
    rdfs:comment "Knowledge preservation is the practice of capturing, organising and retaining institutional and individual knowledge so it remains accessible and usable over time. It mitigates loss from staff turnover, system obsolescence and the decay of tacit expertise by codifying knowledge into durable, retrievable forms. It encompasses documentation, archiving, knowledge bases and AI-assisted capture."@en ;
    rdfs:subClassOf ngm:data-management ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:digital-archive,
        ngm:meeting-ai-assistant ;
    vc:slug "knowledge-preservation" ;
    vc:sourceDomain "data" .

ngm:knowledge-retrieval a owl:Class ;
    rdfs:label "Knowledge Retrieval"@en ;
    rdfs:comment "Knowledge retrieval is the process of locating and returning relevant information from a knowledge source in response to a query or information need. It extends classical information retrieval by operating over structured knowledge, semantic representations and contextual relevance rather than keyword matching alone. It is a foundational capability for question answering, retrieval-augmented generation and conversational agents."@en ;
    rdfs:subClassOf ngm:information-retrieval ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:chatbots,
        ngm:semantic-search ;
    vc:slug "knowledge-retrieval" ;
    vc:sourceDomain "ai" .

ngm:knowledge-transfer a owl:Class ;
    rdfs:label "Knowledge Transfer"@en ;
    rdfs:comment "Knowledge transfer is the movement of expertise, skills and understanding from one person, team or system to another. In collaborative work it occurs through mentoring, shared practice and direct interaction, allowing tacit know-how to spread across an organisation. It is a key outcome of practices such as remote pair programming."@en ;
    rdfs:subClassOf ngm:software-development ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:remote-pair-programming ;
    vc:slug "knowledge-transfer" ;
    vc:sourceDomain "infrastructure" .

ngm:kyc-aml a owl:Class ;
    rdfs:label "KYC/AML"@en ;
    rdfs:comment "KYC/AML refers to Know Your Customer and Anti-Money Laundering regulatory requirements that obligate financial institutions to verify customer identities and monitor transactions for illicit activity. KYC governs identity verification and risk profiling at onboarding, while AML covers ongoing monitoring, suspicious-activity reporting and sanctions screening. These regimes shape compliance for banks, exchanges and crypto-asset service providers."@en ;
    rdfs:subClassOf ngm:regulatory-compliance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:blockchain-analysis,
        ngm:distributed-identity ;
    vc:slug "kyc-aml" ;
    vc:sourceDomain "governance" .

ngm:l-402 a owl:Class ;
    rdfs:label "L402"@en ;
    rdfs:comment "An authentication and payment protocol that combines the HTTP 402 Payment Required status code with Lightning Network invoices and macaroon-based authorisation tokens."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:lightning-network ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:authentication ],
        ngm:lightning-network ;
    vc:enables ngm:micropayment ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:authentication,
        ngm:lightning-network ;
    vc:slug "l-402" ;
    vc:sourceDomain "blockchain" .

ngm:l-402-protocol a owl:Class ;
    rdfs:label "L402 Protocol"@en ;
    rdfs:comment "The specification defining how HTTP 402 responses, Lightning invoices, and macaroon tokens combine to authorise paid access to web resources."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:lightning-network ],
        ngm:l-402 ;
    vc:enables ngm:micropayment ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:lightning-network ;
    vc:slug "l-402-protocol" ;
    vc:sourceDomain "blockchain" .

ngm:label-smoothing a owl:Class ;
    rdfs:label "Label Smoothing"@en ;
    rdfs:comment "A regularisation technique that replaces hard one-hot labels with soft targets by allocating small probability mass to incorrect classes. Label smoothing prevents overconfident predictions and improves model calibration and generalisation."@en ;
    rdfs:subClassOf ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:contrastsWith ngm:overfitting ;
    vc:enables ngm:regularisation ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:relatedTo ngm:deep-learning ;
    vc:slug "label-smoothing" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:loss-function,
        ngm:training .

ngm:lakehouse-architecture a owl:Class ;
    rdfs:label "Lakehouse Architecture"@en ;
    rdfs:comment "Lakehouse architecture is a data management pattern that combines the low-cost, open storage of a data lake with the transactional reliability and performance of a data warehouse. It layers ACID transactions, schema enforcement and indexing over inexpensive object storage using open table formats such as Delta Lake, Apache Iceberg or Hudi. This unifies analytics, business intelligence and machine learning on a single copy of data."@en ;
    rdfs:subClassOf ngm:data-management ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:storage-infrastructure ;
    vc:slug "lakehouse-architecture" ;
    vc:sourceDomain "data" .

ngm:land-parcel a owl:Class ;
    rdfs:label "Land Parcel"@en ;
    rdfs:comment "Discrete units of virtual real estate within metaverse platforms, represented as NFTs that provide proof of ownership for programmable digital spaces where users can build, socialise, host events, and conduct commercial activities."@en ;
    rdfs:subClassOf ngm:sc-platform-and-environment,
        ngm:virtual-asset ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:enables ngm:metaverse-development ;
    vc:hasMaturity ngmi:maturity-draft ;
