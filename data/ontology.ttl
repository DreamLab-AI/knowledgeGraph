        ngm:virtual-reality ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:global-illumination,
        ngm:rasterization,
        ngm:ray-tracing,
        ngm:rendering-pipeline,
        ngm:shader,
        ngm:texture-mapping ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:physically-based-rendering,
        ngm:spatial-computing ;
    vc:requires ngm:3-d-geometry,
