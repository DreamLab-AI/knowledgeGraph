vf:digital-society-harms a owl:Class ;
    rdfs:label "Digital Society Harms"@en ;
    rdfs:comment "Digital Society Harms is the catalogue of empirically documented and structurally anticipated negative impacts arising from the deployment of digital, algorithmic, and AI systems at population scale across information, psychological, economic, social, human-rights, child-safety, environmental, and labour dimensions, formalised through overlapping taxonomies (Ofcom Online Safety Act 2023 Schedule 5 priority illegal harms — child sexual exploitation and abuse CSEA, terrorism, suicide/self-harm content, dishonest content/fraud, controlling or coercive behaviour, harassment/stalking, hate, intimate-image abuse, drugs/weapons; Schedule 6 priority harms to children — pornography, abuse/hate, bullying, violent content, harmful substances, body-stigma content, dangerous-stunts content; Schedule 7 user-empowerment categories — suicide/self-harm content adults can opt out of; Ada Lovelace Institute Harms Framework 2022 distinguishing allocative/representational/quality-of-service/loss-of-liberty/social-system harms; MIT AI Risk Repository Slattery et al. August 2024 cataloguing 700+ unique risks across 23 source documents and 7 risk taxonomies covering causal factors entity/intent/timing and"@en ;
    rdfs:subClassOf <urn:visionflow:linked:sociotechnical-risk>,
        vf:ai-risks,
        vf:digital-safety,
        vf:human-rights,
        vf:platform-governance ;
    vc:authorityScore "0.87"^^xsd:float ;
    vc:enables <urn:visionflow:linked:harm-mitigation>,
        <urn:visionflow:linked:online-safety-regulation>,
        <urn:visionflow:linked:platform-liability>,
        <urn:visionflow:linked:user-empowerment>,
        vf:algorithmic-accountability ;
    vc:hasPart <urn:visionflow:linked:child-safety-harms>,
        <urn:visionflow:linked:economic-harms>,
        <urn:visionflow:linked:environmental-harms>,
        <urn:visionflow:linked:human-rights-harms>,
        <urn:visionflow:linked:information-harms>,
        <urn:visionflow:linked:labour-harms>,
        <urn:visionflow:linked:psychological-harms>,
        <urn:visionflow:linked:social-harms> ;
    vc:implements <urn:visionflow:linked:ada-lovelace-harms-framework>,
        <urn:visionflow:linked:council-of-europe-huderia>,
        <urn:visionflow:linked:ico-children-code>,
        <urn:visionflow:linked:mit-ai-risk-repository-taxonomy>,
        <urn:visionflow:linked:ofcom-online-safety-act-codes> ;
    vc:maturity "production-ready" ;
    vc:qualityScore "0.52"^^xsd:float ;
    vc:requires <urn:visionflow:linked:civil-society-oversight>,
        <urn:visionflow:linked:evidence-base>,
        <urn:visionflow:linked:harm-taxonomy>,
        <urn:visionflow:linked:incident-reporting>,
        vf:regulatory-framework ;
    vc:slug "digital-society-harms" ;
    vc:sourceDomain "society" .

