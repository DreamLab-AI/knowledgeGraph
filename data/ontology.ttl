ngm:bolt12-offers a owl:Class ;
    rdfs:label "BOLT12 Offers"@en ;
    rdfs:comment "BOLT12 Offers is a Lightning Network specification defining reusable, static payment requests called offers, improving on single-use BOLT11 invoices. An offer is a long-lived, shareable code from which payers fetch a fresh invoice on demand via onion messages, enabling recurring payments, refunds, and donation links without a server issuing each invoice. It also improves privacy through blinded paths that hide the recipient's node identity."@en ;
    rdfs:subClassOf ngm:lightning-network ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:lightning-network ;
    vc:slug "bolt12-offers" ;
    vc:sourceDomain "blockchain" .

