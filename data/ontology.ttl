# Virtual Presence
spatial-computing:VirtualPresence rdf:type owl:Class ;
    rdfs:subClassOf spatial-computing:Telepresence ;
    rdfs:label "Virtual Presence"@en ;
    rdfs:comment "The psychological experience of being there within a virtual place or situation, encompassing spatial presence (sense of location), social presence (connection with others), and self-presence (embodiment in virtual form), achieved through telepresence technologies and immersive environments."@en ;
    skos:prefLabel "Virtual Presence"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:spatial-computing:virtual-presence" ;
    owl:sameAs <urn:visionclaw:concept:spatial-computing:virtual-presence> ;
    vcw:contentHash "sha256-12-ff40214a0306" ;
