ngm:vector-database a owl:Class ;
    rdfs:label "Vector Database"@en ;
    rdfs:comment "A vector database is a specialised data storage and retrieval system optimised for indexing and querying high-dimensional dense vectors (embeddings) using approximate nearest-neighbour (ANN) search algorithms such as HNSW, IVF-PQ, and ScaNN. Unlike traditional relational databases, vector databases solve the problem of finding the k most similar vectors to a query in Euclidean or cosine space over millions to billions of embeddings representing text, images, audio, or multimodal content. They combine ANN indexing with structured metadata filtering, persistence, CRUD operations, and access control, enabling retrieval-augmented generation, semantic search, and large-scale recommendation at production quality. The category encompasses dedicated systems (Pinecone, Qdrant, Weaviate, Milvus, Chroma) and vector-search extensions added to existing databases (pgvector for PostgreSQL, Redis Stack)."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:vector-embedding ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:hnsw-index ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:embedding-model ],
        ngm:ai-infrastructure ;
    vc:bridgesTo ngm:data-pipeline,
        ngm:distributed-systems ;
    vc:contrastsWith ngm:document-database,
        ngm:relational-database,
        ngm:search-engine ;
    vc:enables ngm:anomaly-detection,
        ngm:multimodal-search,
        ngm:recommendation-system,
        ngm:retrieval-augmented-generation,
        ngm:semantic-search ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:hnsw-index,
        ngm:inverted-file-index,
        ngm:metadata-filter,
        ngm:product-quantisation ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:information-retrieval,
        ngm:knowledge-graph,
        ngm:large-language-model,
        ngm:nearest-neighbor-search,
        ngm:search-index ;
    vc:requires ngm:approximate-nearest-neighbour-search,
        ngm:embedding-model,
        ngm:vector-embedding ;
    vc:slug "vector-database" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:bm25,
        ngm:cosine-similarity,
        ngm:hybrid-search .

ngm:algorithmic-accountability a owl:Class ;
    rdfs:label "Algorithmic Accountability"@en ;
    rdfs:comment "Algorithmic Accountability is a responsibility framework ensuring that AI systems and their developers are answerable for decisions, outcomes, and societal impacts produced by algorithmic processes. It encompasses mechanisms for redress, transparency, auditing, and oversight to prevent undue harm from automated decision-making."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
