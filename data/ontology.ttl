    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:gpu,
        ngm:nvidia-corporation-h-100 ;
    vc:slug "gpu-cluster" ;
    vc:sourceDomain "infrastructure" .

ngm:graph-theory a owl:Class ;
    rdfs:label "Graph Theory"@en ;
    rdfs:comment "Graph Theory is the branch of mathematics that studies graphs, structures consisting of vertices connected by edges, used to model pairwise relationships between objects. It examines properties such as connectivity, paths, cycles, colourings, matchings and flows, and classifies graphs by structure (for example trees, bipartite and planar graphs). Originating with Euler's 1736 solution of the Seven Bridges of Konigsberg problem, it now underpins network analysis, optimisation and computer science. Graph algorithms are fundamental to routing, scheduling, social network analysis and the representation of knowledge."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:set-theory ],
        ngm:ai-research-area ;
    skos:broader ngm:ai-research-area ;
    vc:bridgesTo ngm:blockchain,
        ngm:cryptography,
        ngm:distributed-systems ;
    vc:contrastsWith ngm:euclidean-geometry,
        ngm:relational-algebra ;
    vc:enables ngm:knowledge-graph,
        ngm:network-analysis,
        ngm:recommendation-system,
        ngm:routing-protocol,
        ngm:social-network-analysis ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:cycle-detection,
        ngm:graph-colouring,
        ngm:graph-traversal,
        ngm:shortest-path,
        ngm:spanning-tree,
        ngm:tree ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:computational-complexity,
        ngm:topology ;
    vc:requires ngm:combinatorics,
        ngm:set-theory ;
    vc:slug "graph-theory" ;
    vc:sourceDomain "data" ;
    vc:supports ngm:graph-neural-network,
        ngm:ontology ;
    vc:uses ngm:adjacency-matrix,
        ngm:dynamic-programming,
        ngm:linear-algebra .

ngm:hardware-abstraction-layer a owl:Class ;
    rdfs:label "Hardware Abstraction Layer"@en ;
    rdfs:comment "A Hardware Abstraction Layer (HAL) is a software layer that presents a uniform, hardware-independent interface to upper software layers — operating systems, middleware, or application code — while encapsulating the vendor-specific, register-level details of physical devices in the implementation beneath it. By isolating hardware dependencies behind a stable API, the HAL enables the same kernel or application binary to run on different processor architectures, microcontroller families, or peripheral configurations without source-code changes. HALs appear throughout the software stack: in embedded microcontroller SDKs (STM32 HAL, Arduino abstraction), in operating-system kernels (Windows HAL.dll), in robotic middleware (ROS Hardware Interface), and in graphics stacks (Vulkan's hardware abstraction over GPU vendors). The HAL pattern is a foundational principle of portable, maintainable system software."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:driver-software ],
        ngm:hardware-abstraction ;
    vc:bridgesTo ngm:graphics-api,
        ngm:robotics-middleware ;
    vc:contrastsWith ngm:bare-metal-programming,
        ngm:direct-memory-access ;
    vc:dependsOn ngm:processor-architecture,
        ngm:system-on-chip ;
    vc:enables ngm:cross-platform-interoperability,
        ngm:operating-system,
        ngm:platform-independence,
        ngm:software-portability ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:application-programming-interface,
        ngm:device-driver ;
    vc:implements ngm:layered-architecture,
        ngm:separation-of-concerns ;
    vc:isPartOf ngm:embedded-software-stack,
        ngm:operating-system-kernel ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:board-support-package,
        ngm:embedded-systems,
        ngm:middleware ;
    vc:requires ngm:driver-software,
        ngm:firmware ;
    vc:slug "hardware-abstraction-layer" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:gpu-compute,
        ngm:real-time-operating-system,
        ngm:robot-operating-system ;
    vc:uses ngm:middleware-layer,
        ngm:system-software .

