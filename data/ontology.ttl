# Decentralized Swarm Control
robotics:DecentralizedSwarmControl rdf:type owl:Class ;
    rdfs:subClassOf robotics:SwarmControl ;
    rdfs:subClassOf robotics:Robotics ;
    rdfs:label "Decentralized Swarm Control"@en ;
    rdfs:comment "Decentralised swarm control distributes decision-making across all robot agents, where each robot computes commands based solely on local sensor information and direct communication with neighbouring agents. This architecture inherently tolerates individual robot failures, scales to arbitrarily large swarms, and enables emergence of collective behaviours from simple local rules, contrasting with Centralized Swarm Control."@en ;
    skos:prefLabel "Decentralized Swarm Control"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:robotics:decentralized-swarm-control" ;
    owl:sameAs <urn:visionclaw:concept:robotics:decentralized-swarm-control> ;
    vcw:contentHash "sha256-12-4ed5153f4640" ;
    vcw:qualityScore "0.5"^^xsd:decimal ;
    vcw:legacyTermId "RB-9004" ;
    vcw:ontologyStatus "draft" ;
    vcw:maturityLevel "emerging" ;
    vcw:authorityScore "0.0"^^xsd:decimal ;
    dcterms:identifier "RB-9004" ;
    dcterms:subject "robotics" ;
