    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires ngm:filter-implementation,
        ngm:grounding-practice,
        ngm:shielding-design,
        ngm:test-facility ;
    vc:slug "emc-standard" ;
    vc:sourceDomain "robotics" .

ngm:employment-contract-restructuring-analysis a owl:Class ;
    rdfs:label "Employment Contract Restructuring Analysis"@en ;
    rdfs:comment "Role reorg denotes an organisational restructuring process in which employment or contractual arrangements are renegotiated, typically comparing permanent employment contracts with temporary or agency-based assignments across dimensions such as salary, holiday entitlement, pension eligibility, notice periods, and additional benefits. Such analysis underpins workforce planning decisions in academic and research institutions, balancing income stability against contractual flexibility and total compensation."@en ;
    rdfs:subClassOf ngm:infra-software-engineering ;
    skos:broader ngm:infra-software-engineering ;
    vc:contrastsWith ngm:civil-service-job ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:relatedTo ngm:augmented-connected-workforce,
        ngm:economics ;
    vc:slug "employment-contract-restructuring-analysis" ;
    vc:sourceDomain "infrastructure" .

ngm:employment-social-contract-under-automation a owl:Class ;
    rdfs:label "Employment Social Contract Under Automation"@en ;
    rdfs:comment "The evolving set of expectations, obligations and entitlements linking workers, employers and the state around employment, income security and social protection, examined specifically under conditions of technological displacement driven by automation, robotics and artificial intelligence. The concept encompasses both descriptive analysis of how existing labour-market settlements are stressed by AI-driven task substitution and normative debates about how governments, firms and civil society should renegotiate the terms of work, welfare and the distribution of productivity gains. It spans labour economics, political philosophy and public policy, treating technological change as a structural challenge to long-standing institutions such as collective bargaining, unemployment insurance and occupational licensing."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:governance ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ai-regulation ],
        ngm:ai-governance-and-ethics ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:bridgesTo ngm:ai-adoption,
        ngm:algorithmic-management,
        ngm:artificial-intelligence,
        ngm:robotics ;
    vc:contrastsWith ngm:gig-economy,
        ngm:technological-unemployment ;
    vc:dependsOn ngm:collective-bargaining,
        ngm:labour-law,
        ngm:social-insurance ;
    vc:enables ngm:economic-redistribution,
        ngm:social-cohesion,
        ngm:workforce-transition ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:future-of-work,
        ngm:income-inequality,
        ngm:job-displacement,
        ngm:platform-economy,
        ngm:reskilling,
        ngm:universal-basic-income ;
    vc:requires ngm:ai-regulation,
        ngm:governance,
        ngm:welfare-state ;
    vc:slug "employment-social-contract-under-automation" ;
    vc:sourceDomain "governance" ;
    vc:supports ngm:democratic-legitimacy,
        ngm:human-dignity .

ngm:ensemble-collaborative-intelligence-principle a owl:Class ;
    rdfs:label "Ensemble Collaborative Intelligence Principle"@en ;
    rdfs:comment "Two Heads Are Better Than One is the principle that collaborative or ensemble approaches to problem-solving outperform individual effort, applied in AI contexts to multi-agent systems, ensemble methods, and human-in-the-loop architectures. It underpins debate-based reasoning, peer-review agent patterns, and consensus mechanisms where diverse model outputs are aggregated to improve accuracy and reduce error."@en ;
    rdfs:subClassOf ngm:infra-software-engineering ;
    skos:broader ngm:infra-software-engineering ;
    vc:enables ngm:ensemble-methods,
