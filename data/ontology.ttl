ngm:w-3-c-verifiable-credentials-2-0 a owl:Class ;
    rdfs:label "W3C Verifiable Credentials 2.0"@en ;
    rdfs:comment "A W3C specification, version 2.0, defining a data model for verifiable credentials and presentations that can be cryptographically verified. It standardises the structure of digital credentials and claims."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
