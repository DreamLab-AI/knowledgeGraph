    vc:supports ngm:ai-trustworthiness,
        ngm:conformity-assessment,
        ngm:regulatory-compliance .

ngm:attention-mechanism a owl:Class ;
    rdfs:label "Attention Mechanism"@en ;
    rdfs:comment "An Attention Mechanism is a neural network component that enables models to dynamically weight the relevance of different input positions when producing each output element, computing weighted combinations based on learned similarity scores. Originally introduced for sequence-to-sequence machine translation, self-attention and multi-head attention are now the core computational primitives of transformer architectures, enabling parallel processing of sequences and capturing long-range dependencies that recurrent models struggle with."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:self-attention ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:query-key-value ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:positional-encoding ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:softmax-function ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:matrix-multiplication ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:multi-head-attention ],
        ngm:neural-network-component ;
    vc:bridgesTo ngm:computer-vision,
        ngm:multimodal-ai-architecture-ai ;
    vc:contrastsWith ngm:long-short-term-memory,
        ngm:recurrent-neural-network ;
    vc:dependsOn ngm:backpropagation,
        ngm:gradient-descent ;
    vc:enables ngm:large-language-models,
        ngm:long-range-dependency-modelling,
        ngm:machine-translation,
        ngm:natural-language-processing ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:multi-head-attention,
        ngm:query-key-value,
        ngm:self-attention,
        ngm:softmax-function ;
    vc:implements ngm:sequence-to-sequence-learning ;
    vc:isPartOf ngm:transformer-architecture ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:explainable-ai,
        ngm:graph-neural-network ;
    vc:requires ngm:matrix-multiplication,
        ngm:positional-encoding ;
    vc:slug "attention-mechanism" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:image-captioning,
        ngm:speech-recognition ;
    vc:uses ngm:neural-network .

ngm:peer-to-peer-network a owl:Class ;
    rdfs:label "Peer-to-Peer Network"@en ;
    rdfs:comment "A decentralised communication architecture in which participating nodes connect directly to one another without a central coordinator, enabling distributed ledger technology to broadcast transactions, propagate blocks, and maintain a shared state across an open membership set. It underlies the censorship resistance and fault tolerance of blockchain systems."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:node ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:peer-discovery ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:kademlia-dht ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:full-node ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:bootstrap-node ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:mempool ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:transaction-pool ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:gossip-protocol ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:tcp-ip ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:network-protocol ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:archival-node ],
        ngm:network-component ;
    vc:bridgesTo ngm:content-delivery-network,
        ngm:decentralised-autonomous-organisation,
        ngm:federated-learning ;
    vc:contrastsWith ngm:client-server-architecture ;
    vc:enables ngm:blockchain-network,
        ngm:censorship-resistance,
        ngm:distributed-storage,
        ngm:fault-tolerance,
        ngm:nakamoto-consensus ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:archival-node,
        ngm:bootstrap-node,
        ngm:full-node,
        ngm:gossip-protocol,
        ngm:kademlia-dht,
        ngm:mempool,
        ngm:peer-discovery,
        ngm:transaction-pool ;
    vc:implements ngm:bittorrent-protocol,
        ngm:libp2p ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:blockchain,
        ngm:consensus-protocol,
        ngm:distributed-ledger-technology ;
    vc:requires ngm:network-protocol,
        ngm:node,
        ngm:tcp-ip ;
    vc:slug "peer-to-peer-network" ;
    vc:sourceDomain "distributed-systems" ;
    vc:uses ngm:kademlia-dht,
        ngm:nat-traversal .

ngm:proof-of-stake a owl:Class ;
    rdfs:label "Proof of Stake"@en ;
    rdfs:comment "A consensus mechanism allowing blockchains to validate transactions and create new blocks based on the number of tokens held or staked by network participants. Validators are selected proportionally to their stake, replacing the energy-intensive mining of Proof of Work with a capital-cost security model that achieves deterministic or probabilistic finality."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptographic-signature ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:delegated-proof-of-stake ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:liquid-proof-of-stake ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:slashing-condition ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:validator-node ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:staking-reward ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:peer-to-peer-network ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:epoch ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:validator-set ],
        ngm:proof-based-consensus ;
    vc:bridgesTo ngm:carbon-footprint,
        ngm:decentralised-finance ;
    vc:contrastsWith ngm:proof-of-authority,
        ngm:proof-of-history,
        ngm:proof-of-work ;
    vc:dependsOn ngm:blockchain,
        ngm:public-key-cryptography,
        ngm:smart-contract ;
    vc:enables ngm:blockchain-sustainability,
        ngm:layer-2-scaling,
        ngm:on-chain-governance,
        ngm:sharding ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:delegated-proof-of-stake,
        ngm:epoch,
        ngm:liquid-proof-of-stake,
        ngm:slashing-condition,
        ngm:staking-reward,
        ngm:validator-node,
        ngm:validator-set ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:byzantine-fault-tolerance,
        ngm:deterministic-finality,
        ngm:finality,
        ngm:sustainable-consensus,
        ngm:sybil-resistance ;
    vc:requires ngm:cryptographic-signature,
        ngm:peer-to-peer-network ;
    vc:slug "proof-of-stake" ;
    vc:sourceDomain "blockchain" .

ngm:sc-display-and-rendering a owl:Class,
        skos:Concept ;
    rdfs:label "Display and Rendering"@en ;
    rdfs:comment "Taxonomy hub for display and rendering technologies within spatial computing, encompassing the pipelines, hardware, and algorithms that transform scene geometry into visual output for AR, VR, and mixed reality experiences. This category bridges hardware display devices with software rendering techniques, covering both real-time and offline methods optimised for immersive perceptual fidelity."@en ;
