ngm:can-bus a owl:Class ;
    rdfs:label "CAN Bus"@en ;
    rdfs:comment "CAN Bus (Controller Area Network) is a reliable serial communication standard that lets microcontrollers and devices exchange messages over a shared two-wire bus without a host computer, widely used in vehicles and robotics."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:embedded-systems ],
        ngm:communication-protocol ;
    vc:enables ngm:motor-driver,
        ngm:real-time-control ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:embedded-systems ;
    vc:slug "can-bus" ;
    vc:sourceDomain "robotics" .

