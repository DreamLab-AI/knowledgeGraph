        <urn:visionflow:linked:w3-c-did-core> ;
    vc:maturity "established" ;
    vc:qualityScore "0.88"^^xsd:float ;
    vc:requires <urn:visionflow:linked:bip-340-cryptography>,
        <urn:visionflow:linked:w3-c-did-method>,
        vf:nostr-protocol ;
    vc:slug "did-nostr-identity" ;
    vc:sourceDomain "blockchain" .

