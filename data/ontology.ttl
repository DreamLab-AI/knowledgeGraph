ngm:co-training a owl:Class ;
    rdfs:label "Co Training"@en ;
    rdfs:comment "Co-training is a semi-supervised machine learning technique where two or more models trained on complementary feature views iteratively label unlabelled data for each other. Each model labels examples confidently classified under its own view, and these pseudo-labels are added to the other model's training set, bootstrapping performance without requiring large labelled corpora."@en ;
    rdfs:subClassOf ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:enables ngm:generative-ai ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:semi-supervised-learning ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:relatedTo ngm:active-learning,
        ngm:self-training ;
    vc:slug "co-training" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:machine-learning,
        ngm:machine-learning-model .

