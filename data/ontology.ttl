    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:avatar,
        ngm:extended-reality .

ngm:telemedicine a owl:Class ;
    rdfs:label "Telemedicine"@en ;
    rdfs:comment "Telemedicine is the delivery of clinical healthcare services — including diagnosis, consultation, monitoring, and treatment guidance — at a distance using telecommunications technology such as video conferencing, secure messaging, and remote sensing devices. It encompasses synchronous consultations (live video visits), asynchronous store-and-forward exchanges (images, test results), and remote patient monitoring (RPM) using wearable sensors and IoT devices. Telemedicine dramatically expands access to specialist care for patients in rural, underserved, or mobility-constrained situations."@en ;
    rdfs:subClassOf ngm:healthcare-technology ;
    vc:enables ngm:clinical-decision-support,
        ngm:precision-medicine,
        ngm:remote-work ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:healthcare-records,
        ngm:medical-ai,
        ngm:wearable-device-integration ;
    vc:slug "telemedicine" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:healthcare-ai,
        ngm:io-t-sensor-network,
        ngm:video-conferencing .

ngm:teleoperation-systems a owl:Class ;
    rdfs:label "Teleoperation Systems"@en ;
    rdfs:comment "Teleoperation Systems are robotic control architectures enabling human operators to command and manipulate remote robots through master-slave or supervisory interfaces, transmitting operator intentions to robot actuators whilst providing sensory feedback (visual, auditory, haptic) from the robot to the operator, creating bidirectional human-machine coupling for remote physical interaction."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:haptic-feedback-telepresence ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:haptic-feedback ],
        ngm:dc-telepresence,
        ngm:robotic-telepresence ;
    skos:broader ngm:dc-telepresence ;
    vc:enables ngm:presence,
        ngm:social-presence ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:haptic-feedback,
        ngm:haptic-feedback-telepresence ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:encoder,
        ngm:haptics,
        ngm:robotic-telepresence,
        ngm:robotics-telepresence-bridge ;
    vc:slug "teleoperation-systems" ;
    vc:sourceDomain "distributed-collaboration" ;
    vc:uses ngm:actuator,
        ngm:feedback-control,
        ngm:human-robot-interaction .

ngm:tendermint-consensus a owl:Class ;
    rdfs:label "Tendermint Consensus"@en ;
    rdfs:comment "Tendermint Consensus is a Byzantine Fault Tolerant consensus engine that combines Practical Byzantine Fault Tolerance (PBFT) with Proof-of-Stake validator sets to achieve immediate block finality and high transaction throughput. It underpins the Cosmos ecosystem and enables inter-blockchain communication by guaranteeing that committed blocks are never reverted, eliminating the probabilistic finality of Proof-of-Work chains."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:proof-of-stake ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:validator-node ],
        ngm:bc-protocol-and-consensus,
        ngm:byzantine-fault-tolerance ;
    skos:broader ngm:bc-protocol-and-consensus ;
    vc:contrastsWith ngm:delegated-proof-of-stake,
        ngm:proof-of-work ;
    vc:enables ngm:blockchain-interoperability,
        ngm:cosmos-ibc ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:blockchain-protocol ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:blockchain-scalability,
        ngm:consensus-mechanism,
        ngm:low-energy-consumption ;
    vc:requires ngm:proof-of-stake,
        ngm:validator-node ;
    vc:slug "tendermint-consensus" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:cryptographic-hash,
        ngm:digital-signature .

ngm:text-to-image-generation a owl:Class ;
    rdfs:label "Text-to-Image Generation"@en ;
    rdfs:comment "Text-to-image generation is a class of generative AI techniques that synthesise photorealistic or stylised images from natural-language textual descriptions, typically using diffusion models, autoregressive transformers, or hybrid architectures trained on large paired datasets of images and captions. The process involves encoding the text prompt into a latent representation that conditions image synthesis, iteratively denoising random noise into structured visual output guided by the conditioning signal. Systems such as DALL-E 3, Stable Diffusion, Midjourney, and Imagen exemplify the paradigm. Text-to-image generation has transformed creative workflows while raising contested questions about copyright, consent, and synthetic media authenticity."@en ;
    rdfs:subClassOf ngm:image-generation ;
    vc:contrastsWith ngm:proprietary-image-generation ;
    vc:enables ngm:multimodal-ai,
        ngm:prompt-engineering ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:diffusion-model,
        ngm:generative-ai,
        ngm:text-to-image ;
    vc:slug "text-to-image-generation" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:diffusion-models,
        ngm:latent-diffusion,
        ngm:transformer-architecture .

ngm:traceability-mechanism a owl:Class ;
    rdfs:label "Traceability Mechanism"@en ;
    rdfs:comment "A Traceability Mechanism is a systematic approach for recording, maintaining, and retrieving comprehensive documentation of an AI system's development process, data lineage, decision-making logic, and operational history to enable accountability, auditability, and debugging. It encompasses data provenance tracking, model versioning, decision logging, and tamper-evident audit trails that allow stakeholders to reconstruct the causal chain from system outputs back to training data and design choices. Regulatory frameworks including the EU AI Act and GDPR increasingly mandate specific traceability capabilities for high-risk AI deployments."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:metadata-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:data-provenance ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:audit-trail ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:model-training ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-governance ],
        ngm:ai-governance-and-ethics,
        ngm:ai-governance-principle ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:enables ngm:accountability,
        ngm:compliance-verification,
        ngm:explainability ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:audit-trail,
        ngm:data-provenance,
        ngm:metadata-management ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:ai-regulation,
        ngm:gdpr-compliance,
        ngm:transparency ;
    vc:requires ngm:data-governance,
        ngm:model-training ;
    vc:slug "traceability-mechanism" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:ai-governance,
        ngm:ai-risk-management .

ngm:tracking-hardware a owl:Class ;
    rdfs:label "Tracking Hardware"@en ;
    rdfs:comment "Tracking Hardware comprises the physical sensors and devices used to determine the position and orientation of users, controllers, and objects within spatial computing environments. This includes inertial measurement units, optical trackers, hand-tracking cameras, eye-tracking modules, and SLAM-based inside-out tracking systems that together provide the 6-DoF pose data essential for immersive VR/AR experiences."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:optical-tracking ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:inertial-measurement-unit ],
        ngm:sc-interaction,
        ngm:tracking-technology ;
    skos:broader ngm:sc-interaction ;
    vc:enables ngm:eye-tracking,
        ngm:hand-tracking ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:inertial-measurement-unit,
        ngm:optical-tracking ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:slug "tracking-hardware" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:sensor-fusion,
        ngm:slam .

