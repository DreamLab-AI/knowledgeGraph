    vc:slug "asset-format-standards" ;
    vc:sourceDomain "spatial-computing" .

ngm:asset-interoperability a owl:Class ;
    rdfs:label "Asset Interoperability"@en ;
    rdfs:comment "Asset Interoperability is the technical capacity for digital assets — including 3D models, avatars, NFTs, in-game items, and financial instruments — to function, be recognised, and retain their properties across multiple distinct platforms, ecosystems, or blockchains without loss of fidelity or ownership provenance. It encompasses both syntactic compatibility (shared file formats and protocols) and semantic compatibility (consistent meaning of asset attributes across contexts). Achieving asset interoperability typically requires common standards bodies, bridge contracts, or cross-chain protocols that translate asset representations between heterogeneous systems. It is a foundational concern for open metaverse architectures, decentralised finance, and multi-chain gaming economies."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:metadata-schema ],
        ngm:interoperability ;
    vc:bridgesTo ngm:decentralised-finance,
        ngm:spatial-computing ;
    vc:contrastsWith ngm:vendor-lock-in,
        ngm:walled-garden ;
    vc:dependsOn ngm:data-format-standard,
        ngm:decentralised-identity,
        ngm:provenance-tracking,
        ngm:smart-contract ;
    vc:enables ngm:blockchain-gaming,
        ngm:cross-protocol-liquidity,
        ngm:digital-asset-ecosystem,
        ngm:user-owned-economy ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:implements ngm:erc-1155,
        ngm:erc-721 ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:avatar-interoperability,
        ngm:blockchain-interoperability,
        ngm:cross-chain-interoperability,
        ngm:digital-twin,
        ngm:interoperability-standard,
        ngm:open-metaverse ;
    vc:requires ngm:metadata-schema,
        ngm:ontology-alignment ;
    vc:slug "asset-interoperability" ;
    vc:sourceDomain "blockchain" ;
    vc:standardizedBy ngm:khronos-group,
        ngm:metaverse-standards-forum,
        ngm:open-metaverse-interoperability-group ;
    vc:uses ngm:bridge-contract,
        ngm:digital-asset-standards,
        ngm:gltf,
        ngm:interoperability-protocol,
        ngm:wrapped-token .

ngm:asset-portability a owl:Class ;
    rdfs:label "Asset Portability"@en ;
    rdfs:comment "Asset portability is the technical and standards-based capability to transfer, import, and faithfully render digital assets — including 3D models, textures, avatars, animations, and environments — across different rendering engines, platforms, and virtual world applications without loss of fidelity or functionality. It depends on open file formats, agreed semantic conventions for material properties and skeletal rigs, and runtime interoperability layers. Asset portability is a prerequisite for platform-neutral digital property ownership in the open metaverse, enabling creators and users to carry value across application boundaries. It intersects with data portability principles in broader digital-rights discourse and with blockchain-based ownership for non-fungible digital items."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:interoperability ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:3-d-file-format ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:physically-based-rendering ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:open-standard ],
        ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:bridgesTo ngm:data-portability,
        ngm:decentralised-identity,
        ngm:non-fungible-token ;
    vc:contrastsWith ngm:proprietary-format,
        ngm:vendor-lock-in ;
    vc:dependsOn ngm:gltf,
        ngm:runtime-api,
        ngm:universal-scene-description ;
    vc:enables ngm:avatar-portability,
        ngm:cross-platform-interoperability,
        ngm:open-metaverse,
        ngm:user-owned-digital-property ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:3-d-asset-standard,
        ngm:content-pipeline,
        ngm:scene-graph ;
    vc:requires ngm:3-d-file-format,
        ngm:interoperability,
        ngm:open-standard,
        ngm:physically-based-rendering ;
    vc:slug "asset-portability" ;
    vc:sourceDomain "spatial-computing" ;
    vc:standardizedBy ngm:alliance-for-openusd,
        ngm:khronos-group,
        ngm:metaverse-standards-forum ;
    vc:supports ngm:digital-twin,
        ngm:extended-reality,
        ngm:spatial-computing ;
    vc:uses ngm:openxr,
        ngm:vrm-format,
        ngm:webxr .

ngm:attention-head a owl:Class ;
    rdfs:label "Attention Head"@en ;
    rdfs:comment "One of multiple parallel scaled dot-product attention mechanisms in a multi-head attention layer, each operating over a distinct linear projection of the input. Individual heads specialise in different linguistic or structural patterns; most learn simple positional relationships and many can be pruned without significant loss, though a subset carry disproportionate representational load."@en ;
    rdfs:subClassOf ngm:ai-model-architecture ;
    skos:broader ngm:ai-model-architecture ;
    vc:enables ngm:transformers ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:attention-mechanism,
        ngm:network-architecture ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:relatedTo ngm:attention,
        ngm:transformer-architecture ;
    vc:slug "attention-head" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:attention-weight .

ngm:audio-signal-processing a owl:Class ;
    rdfs:label "Audio Signal Processing"@en ;
    rdfs:comment "Audio Signal Processing is the application of signal processing theory and algorithms to the analysis, transformation, synthesis, and encoding of audio-frequency signals, operating in either the time domain or frequency domain. It encompasses filtering, equalisation, dynamic range control, time-frequency analysis, psychoacoustic coding, and spatial rendering as applied to sound reproduction, communication, and computational audition systems."@en ;
    rdfs:subClassOf ngm:signal-processing ;
    vc:enables ngm:spatial-audio,
        ngm:speech-recognition,
        ngm:speech-synthesis ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:audio-engine,
        ngm:audio-processing-system ;
    vc:slug "audio-signal-processing" ;
    vc:sourceDomain "metaverse" ;
    vc:uses ngm:audio-parameters,
        ngm:digital-signal-processing .

ngm:audio-system a owl:Class ;
    rdfs:label "Audio System"@en ;
    rdfs:comment "An Audio System is an integrated hardware and software architecture responsible for the capture, processing, transmission, and reproduction of sound signals within computing environments, including spatial audio rendering, acoustic signal processing, voice input/output, and environmental sound simulation. In spatial computing and extended reality contexts it delivers positional audio cues that reinforce presence and depth perception, coordinating microphone arrays, digital signal processors, codecs, and loudspeaker or headphone transducers. Audio systems implement psychoacoustic models — including head-related transfer functions (HRTFs) and room acoustics simulation — to produce convincing three-dimensional soundscapes. They underpin voice communication, speech interaction, accessibility features, and immersive media across consumer electronics, professional audio, telecommunication, and mixed-reality platforms."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:spatial-audio ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:audio-spatialization ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:digital-signal-processing ],
        ngm:signal-processing ;
    vc:bridgesTo ngm:machine-learning,
        ngm:natural-language-processing ;
    vc:contrastsWith ngm:visual-rendering-system ;
    vc:dependsOn ngm:operating-system,
        ngm:real-time-computing ;
    vc:enables ngm:accessibility,
        ngm:augmented-reality,
        ngm:speech-recognition,
        ngm:telecollaboration,
        ngm:voice-user-interface ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:audio-codec,
        ngm:audio-spatialization,
        ngm:digital-signal-processor,
        ngm:microphone-array,
        ngm:spatial-audio ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:ambisonics,
        ngm:audio-processing-system,
        ngm:binaural-audio ;
    vc:requires ngm:acoustic-model,
        ngm:audio-driver,
        ngm:digital-signal-processing ;
    vc:slug "audio-system" ;
    vc:sourceDomain "spatial-computing" ;
    vc:standardizedBy ngm:openal,
        ngm:web-audio-api ;
    vc:supports ngm:mixed-reality,
        ngm:telepresence,
        ngm:virtual-reality ;
    vc:uses ngm:audio-compression,
        ngm:head-related-transfer-function,
        ngm:pulse-code-modulation .

ngm:automation a owl:Class ;
    rdfs:label "Automation"@en ;
    rdfs:comment "Automation is the application of technology, control systems, and software to execute processes, tasks, or workflows with minimal or no human intervention, transferring decision-making and execution from people to machines or algorithms. It encompasses industrial and manufacturing automation driven by programmable logic controllers and robotics, as well as software-driven process automation that replicates repetitive digital workflows. The primary goals are to increase throughput, reduce error rates, lower operational costs, and free human attention for non-routine judgement tasks. Automation exists on a spectrum from fixed mechanisation through programmable control, flexible automation, and fully autonomous adaptive systems."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:industrial-automation ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:workflow-automation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:sensors ],
