ngm:personal-information-protection-law a owl:Class ;
    rdfs:label "Personal Information Protection Law"@en ;
    rdfs:comment "The Personal Information Protection Law (PIPL) is China's comprehensive data-protection statute, effective 2021, governing how personal information of individuals in China is collected, processed, and transferred. It establishes consent and necessity requirements, data-subject rights, security obligations, and strict cross-border transfer controls, with extraterritorial reach and significant penalties. PIPL is a cornerstone of Asia-Pacific data-privacy regulation alongside frameworks like the GDPR."@en ;
    rdfs:subClassOf ngm:infra-legal-and-regulatory ;
    skos:broader ngm:infra-legal-and-regulatory ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:asia-pacific-regulation ;
    vc:slug "personal-information-protection-law" ;
    vc:sourceDomain "governance" .

ngm:pharmaceutical-logistics a owl:Class ;
    rdfs:label "Pharmaceutical Logistics"@en ;
    rdfs:comment "Pharmaceutical logistics is the specialised management of storage, handling, and transport of medicines and biologics under strict regulatory and environmental controls. It enforces cold-chain integrity, serialisation, and chain-of-custody to preserve product efficacy and prevent counterfeiting or diversion. The discipline combines temperature-controlled distribution with traceability and compliance reporting across the supply chain."@en ;
    rdfs:subClassOf ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:logistics-optimization,
        ngm:pharmaceutical-supply-chain ;
    vc:slug "pharmaceutical-logistics" ;
    vc:sourceDomain "supply-chain" .

ngm:philosophy-of-mind a owl:Class ;
    rdfs:label "Philosophy of Mind"@en ;
    rdfs:comment "Philosophy of Mind is the branch of philosophy that investigates the nature of mental phenomena — including consciousness, intentionality, perception, belief, desire, and emotion — and their relationship to physical processes in the brain and body. It encompasses foundational debates over the mind-body problem, such as Cartesian dualism, physicalism, functionalism, and eliminative materialism, seeking to determine whether mental states are reducible to or identical with neurological states. The field directly informs artificial intelligence and cognitive science by establishing conceptual frameworks for what it means to think, represent, and experience, and by posing challenges such as the hard problem of consciousness and the Chinese Room argument against strong AI. It bridges empirical sciences of the mind with normative and metaphysical questions that formal methods alone cannot resolve."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:logic ],
        ngm:cognitive-science ;
    vc:bridgesTo ngm:affective-computing,
        ngm:human-computer-interaction,
        ngm:machine-learning ;
    vc:contrastsWith ngm:behaviourism ;
    vc:dependsOn ngm:neuroscience,
        ngm:psychology ;
    vc:enables ngm:ai-ethics,
        ngm:artificial-intelligence ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:cognitive-science,
        ngm:philosophy ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:embodied-cognition ;
    vc:requires ngm:logic ;
    vc:slug "philosophy-of-mind" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:explainable-ai,
        ngm:natural-language-processing ;
    vc:uses ngm:reasoning .

