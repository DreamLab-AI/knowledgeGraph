ngm:black-rock a owl:Class ;
    rdfs:label "BlackRock"@en ;
    rdfs:comment "BlackRock is the world's largest asset management firm, providing investment management, risk advisory, and financial technology services to institutional investors, sovereign wealth funds, pension funds, and retail clients globally. The firm operates Aladdin, a proprietary risk management and operating system platform that processes risk analytics for trillions of dollars in assets across thousands of financial institutions. BlackRock has expanded beyond traditional asset management into digital assets, sustainable investing, and multi-asset solutions, including launching spot Bitcoin and Ethereum ETFs that attracted significant institutional capital. Its scale and systemic importance across public equities, fixed income, alternatives, and infrastructure positions it as a central node in global capital markets."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:regulatory-compliance ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:risk-management ],
        ngm:asset-management ;
    vc:bridgesTo ngm:bitcoin-etf,
        ngm:esg-data,
        ngm:tokenisation ;
    vc:contrastsWith ngm:fidelity-investments,
        ngm:state-street,
        ngm:vanguard ;
    vc:enables ngm:index-investing,
        ngm:institutional-capital-allocation,
        ngm:investment-management,
        ngm:sustainable-investing ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:aladdin-platform,
        ngm:blackrock-solutions,
        ngm:ishares ;
    vc:isPartOf ngm:financial-system,
        ngm:global-capital-markets ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:alternative-investments,
        ngm:exchange-traded-fund,
        ngm:fixed-income ;
    vc:requires ngm:portfolio-management,
        ngm:regulatory-compliance,
        ngm:risk-management ;
    vc:slug "black-rock" ;
    vc:sourceDomain "finance" ;
    vc:supports ngm:endowment-fund,
        ngm:pension-fund,
        ngm:sovereign-wealth-fund ;
    vc:uses ngm:data-infrastructure,
        ngm:machine-learning,
        ngm:quantitative-finance,
        ngm:risk-analytics .

