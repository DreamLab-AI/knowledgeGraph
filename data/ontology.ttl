    vc:slug "notification-system" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:event-driven-architecture,
        ngm:realtime-communication .

ngm:npc-interaction a owl:Class ;
    rdfs:label "NPC Interaction"@en ;
    rdfs:comment "The systems and mechanics enabling player communication and engagement with non-player characters in video games and virtual worlds, increasingly powered by AI and large language models to generate dynamic, unscripted dialogue and contextual responses."@en ;
    rdfs:subClassOf ngm:game-mechanics,
        ngm:sc-interaction ;
    skos:broader ngm:sc-interaction ;
    vc:enables ngm:immersive-gameplay ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:slug "npc-interaction" ;
    vc:sourceDomain "spatial-computing" .

ngm:nvidia-jetson a owl:Class ;
    rdfs:label "NVIDIA Jetson"@en ;
    rdfs:comment "NVIDIA Jetson is a family of system-on-module (SoM) and developer kit edge computing platforms that combine NVIDIA GPU cores with ARM-based CPU clusters, purpose-built for deploying deep learning inference, computer vision, and robotics workloads at the edge with constrained power budgets. Modules in the Jetson family — including Nano, TX2, Xavier, and Orin — span from entry-level embedded devices to high-performance autonomous machine platforms, all running NVIDIA's JetPack SDK which provides CUDA, cuDNN, TensorRT, and ROS integration."@en ;
    rdfs:subClassOf ngm:edge-ai-accelerator ;
    vc:enables ngm:computer-vision,
        ngm:inference-engine ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:edge-computing,
        ngm:embedded-systems,
        ngm:gpu-computing ;
    vc:slug "nvidia-jetson" ;
    vc:sourceDomain "hardware" ;
    vc:supports ngm:edge-computing-node,
        ngm:inference-hardware ;
    vc:uses ngm:gpu-compute .

ngm:nvidia-omniverse a owl:Class ;
    rdfs:label "NVIDIA Omniverse"@en ;
    rdfs:comment "NVIDIA Omniverse is a real-time 3D simulation and collaboration platform developed by NVIDIA, built on the OpenUSD (Universal Scene Description) standard and designed for creating physically accurate digital twins, collaborative design workflows, and large-scale simulation environments for AI training. It provides a unified compute and rendering fabric that allows multiple applications and users to work simultaneously on shared 3D scenes with physically based rendering, physics simulation, and ray-traced visualisation. Omniverse is deployed across automotive design, industrial digital twins, film and game production pipelines, and as a synthetic data generation platform for training computer vision and robotics AI systems."@en ;
    rdfs:subClassOf ngm:metaverse-platform ;
    vc:enables ngm:digital-twin,
        ngm:embodied-ai-simulation,
        ngm:photorealistic-rendering ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:cross-platform-digital-twins,
        ngm:digital-twin-framework,
        ngm:real-time-rendering ;
    vc:slug "nvidia-omniverse" ;
    vc:sourceDomain "metaverse" ;
    vc:uses ngm:gpu-computing,
        ngm:open-usd,
        ngm:physics-simulation .

ngm:oasis a owl:Class ;
    rdfs:label "OASIS"@en ;
    rdfs:comment "OASIS (Organisation for the Advancement of Structured Information Standards) is an international, not-for-profit standards development body that produces open standards for information technology, with particular strengths in web services, security, content formats, electronic business, and emergency management. Founded in 1993, OASIS operates through technical committees that develop specifications via an open, consensus-based process, producing both OASIS Standards and publicly available specifications that are frequently adopted as ISO/IEC standards. Prominent OASIS standards include MQTT for IoT messaging, SAML for federated identity, XACML for access control, OData for REST-based data access, and the OpenDocument Format. OASIS also co-publishes standards with other bodies including the W3C and ISO."@en ;
    rdfs:subClassOf ngm:standards-body ;
    vc:enables ngm:interoperability-standard,
        ngm:open-standard ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:cybersecurity-standard,
        ngm:iso-iec,
        ngm:iso-standards,
        ngm:w3-c ;
    vc:slug "oasis" ;
    vc:sourceDomain "governance" ;
    vc:supports ngm:virtual-environment-specification ;
    vc:uses ngm:mqtt,
        ngm:rest-api .

ngm:observability a owl:Class ;
    rdfs:label "Observability"@en ;
    rdfs:comment "Observability is the property of a software system that allows its internal state to be inferred from external outputs such as logs, metrics, and traces."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:performance ],
        ngm:reliability-engineering ;
    vc:enables ngm:site-reliability-engineering ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:performance ;
    vc:slug "observability" ;
    vc:sourceDomain "software-engineering" .

ngm:observation-model a owl:Class ;
    rdfs:label "Observation Model"@en ;
    rdfs:comment "An observation model (or measurement model) is the probabilistic relationship that specifies the likelihood of a sensor measurement given the underlying state of a system. In recursive Bayesian estimation it provides the likelihood term used to correct a predicted state belief against incoming data. Its accuracy, including the noise characteristics it encodes, directly governs the quality of state estimation."@en ;
    rdfs:subClassOf ngm:robo-perception ;
    skos:broader ngm:robo-perception ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:bayes-filter,
        ngm:particle-filter ;
    vc:slug "observation-model" ;
    vc:sourceDomain "robotics" .

ngm:oecd-ai-principles a owl:Class ;
    rdfs:label "OECD AI Principles"@en ;
    rdfs:comment "The OECD AI Principles are a set of five intergovernmental policy guidelines adopted by the Organisation for Economic Co-operation and Development in May 2019 and subsequently endorsed by G20 leaders. The principles address inclusive growth and sustainable development, human-centred values and fairness, transparency and explainability, robustness security and safety, and accountability. They represent the first intergovernmental standard on AI and have influenced national AI strategies and regulatory frameworks worldwide. The principles are operationalised through the OECD AI Policy Observatory, which tracks AI policies across member and partner countries."@en ;
    rdfs:subClassOf ngm:responsible-ai-principles ;
    vc:enables ngm:ai-governance-framework,
        ngm:ai-regulation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:ai-ethics,
        ngm:ai-governance,
        ngm:responsible-ai,
        ngm:transparency ;
    vc:slug "oecd-ai-principles" ;
    vc:sourceDomain "governance" ;
    vc:supports ngm:accountability,
        ngm:fairness,
        ngm:human-rights .

ngm:omnichain-application a owl:Class ;
    rdfs:label "Omnichain Application"@en ;
    rdfs:comment "An omnichain application is a decentralised application designed to operate across multiple blockchain networks simultaneously, maintaining unified state, liquidity, and user identity without requiring users to bridge assets manually between chains. Unlike multi-chain applications that deploy isolated instances on separate chains, omnichain applications treat all supported networks as a single logical execution environment connected by cross-chain messaging protocols. LayerZero is the most widely adopted infrastructure enabling omnichain application patterns."@en ;
    rdfs:subClassOf ngm:decentralized-application ;
    vc:enables ngm:cross-chain-asset-transfer,
        ngm:de-fi ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:cross-chain-bridge ;
    vc:slug "omnichain-application" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:blockchain-interoperability,
        ngm:cross-chain-interoperability,
        ngm:cross-chain-messaging .

ngm:on-chain-data-indexing a owl:Class ;
    rdfs:label "On-Chain Data Indexing"@en ;
    rdfs:comment "On-chain data indexing is the process of extracting, transforming, and organising raw blockchain events and state into queryable structures suited to application access patterns. Because base-layer data is optimised for consensus rather than retrieval, indexers ingest blocks and logs, decode them, and serve them through APIs such as GraphQL. It is the data backbone for analytics dashboards and decentralised applications."@en ;
    rdfs:subClassOf ngm:data-management ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:dao-analytics ;
    vc:slug "on-chain-data-indexing" ;
    vc:sourceDomain "blockchain" .

ngm:on-chain-mrv a owl:Class ;
    rdfs:label "On-Chain MRV"@en ;
    rdfs:comment "On-Chain MRV (Measurement, Reporting, and Verification) is the practice of recording carbon and environmental impact data directly on a blockchain to create tamper-evident, auditable proof of climate actions. It combines sensor data, satellite imagery, and oracle feeds with on-chain attestations so that carbon credits and sustainability claims can be independently verified. By anchoring MRV data to an immutable ledger, it reduces double-counting and greenwashing in voluntary and compliance carbon markets."@en ;
    rdfs:subClassOf ngm:sustainability ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:green-blockchain-initiatives ;
    vc:slug "on-chain-mrv" ;
    vc:sourceDomain "blockchain" .

ngm:online-learning a owl:Class ;
    rdfs:label "Online Learning"@en ;
    rdfs:comment "Online Learning is a artificial intelligence concept and a type of Machine Learning. that enables Real-Time Learning."@en ;
    rdfs:subClassOf ngm:ai-technique,
        ngm:machine-learning ;
    skos:broader ngm:ai-technique ;
    vc:enables ngm:real-time-learning ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:slug "online-learning" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:ontology-definition a owl:Class ;
    rdfs:label "Ontology Definition"@en ;
    rdfs:comment "A formal, explicit specification of metaverse concepts, relationships, and axioms using knowledge representation frameworks (OWL, RDF, JSON-LD), defining entities through orthogonal dimensions (physicality, role) to enable semantic interoperability and automated classification across platforms. Ontologies provide foundational standards for governance, identity, and asset management, supporting machine-readable reasoning, validation, and discovery across federated and distributed systems."@en ;
    rdfs:subClassOf ngm:infra-software-engineering ;
    skos:broader ngm:infra-software-engineering ;
    vc:enables ngm:data-governance,
        ngm:interoperability,
        ngm:knowledge-graph ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:slug "ontology-definition" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:identity-management,
        ngm:metaverse-ontology ;
    vc:uses ngm:knowledge-representation,
        ngm:semantic-web .

ngm:opcodes a owl:Class ;
    rdfs:label "Opcodes"@en ;
    rdfs:comment "Opcodes (operation codes) are the atomic instruction primitives of a blockchain scripting language that define permissible computations within transaction scripts, smart contracts, or virtual machine execution environments. Each opcode specifies an operation — such as hash computation, signature verification, stack manipulation, or conditional branching — and the set of valid opcodes for a given blockchain determines its scripting expressiveness and security surface. In Bitcoin, a deliberately restricted opcode set enforces non-Turing-completeness and predictable resource consumption, whereas Ethereum's EVM opcode set supports general computation within gas-metered bounds."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:blockchain-transaction ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:scripting-language ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:script ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:consensus-mechanism ],
        ngm:bc-protocol-and-consensus,
        ngm:blockchain-entity,
        ngm:distributed-data-structure ;
    skos:broader ngm:bc-protocol-and-consensus ;
    vc:enables ngm:programmable-money,
        ngm:smart-contract,
        ngm:smart-contract-execution ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:script,
        ngm:scripting-language ;
    vc:isPartOf ngm:blockchain-protocol,
        ngm:virtual-machine ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:blockchain-network,
        ngm:consensus-protocol,
        ngm:cryptography ;
    vc:requires ngm:blockchain-transaction,
        ngm:consensus-mechanism ;
    vc:slug "opcodes" ;
    vc:sourceDomain "blockchain" .

ngm:open-ai-api a owl:Class ;
    rdfs:label "OpenAI API"@en ;
    rdfs:comment "The OpenAI API is a hosted programming interface that gives developers access to OpenAI's models for text generation, reasoning, embeddings, image generation, speech, and tool use over HTTP. Exposing capabilities through endpoints such as chat completions, responses, and embeddings, it abstracts model hosting, scaling, and inference behind a usage-priced REST interface with structured outputs, function calling, and streaming. Its conventions have become a de facto standard widely emulated by other providers and compatible open-source serving stacks."@en ;
    rdfs:subClassOf ngm:api ;
    vc:enables ngm:llm-application-framework,
        ngm:prompt-engineering ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:rest-api ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:gpt ;
    vc:slug "open-ai-api" ;
    vc:sourceDomain "ai" .

ngm:open-api-specification a owl:Class ;
    rdfs:label "OpenAPI Specification"@en ;
    rdfs:comment "The OpenAPI Specification (OAS) is a language-agnostic, machine-readable standard for describing RESTful HTTP APIs using a structured JSON or YAML document that defines endpoints, request/response schemas, authentication methods, and parameter types. Governed by the OpenAPI Initiative (a Linux Foundation project), it enables automated generation of client SDKs, server stubs, interactive documentation, and contract-based testing from a single source of truth. Originally derived from the Swagger specification, OAS version 3.x is now the dominant industry standard for API description. It promotes interoperability by allowing API consumers to understand a service's capabilities without access to its source code."@en ;
    rdfs:subClassOf ngm:api-standard ;
    vc:enables ngm:api-integration,
        ngm:documentation-generation,
        ngm:microservices ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:api-gateway,
        ngm:api-management ;
    vc:slug "open-api-specification" ;
    vc:sourceDomain "web" ;
    vc:uses ngm:data-schema,
        ngm:json,
        ngm:rest-api .

