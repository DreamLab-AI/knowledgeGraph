# Software Platform
mv:SoftwarePlatform a owl:Class ;
    rdfs:subClassOf mv:TechnologyInfrastructure ;
    rdfs:label "Software Platform"@en ;
    rdfs:comment "An integrated technology foundation providing common services, APIs, and infrastructure for developing, deploying, and running applications, including cloud-native platforms, container orchestration systems, and internal developer platforms that abstract underlying complexity while enabling scalable application delivery."@en ;
