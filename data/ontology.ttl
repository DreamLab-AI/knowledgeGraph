    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:xr-meeting-space ;
    vc:slug "collaboration-platform" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:edge-computing .

ngm:compute-layer a owl:Class ;
    rdfs:label "Compute Layer"@en ;
    rdfs:comment "Software layer managing computational resources and orchestration for rendering, simulation, physics, AI processing, and real-time processing within metaverse systems."@en ;
