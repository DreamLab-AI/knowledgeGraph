ngm:binance a owl:Class ;
    rdfs:label "Binance"@en ;
    rdfs:comment "Binance is a centralised cryptocurrency exchange founded in 2017 by Changpeng Zhao (CZ) and Yi He, which rapidly grew to become one of the highest-volume digital-asset trading venues globally. It provides spot trading, perpetual and futures derivatives, margin lending, staking, savings products, and a token launchpad across hundreds of supported assets. Binance created the BNB token as a native utility and fee-discount instrument, and subsequently developed BNB Chain, an EVM-compatible Layer-1 blockchain that hosts a substantial decentralised-finance and Web3 application ecosystem. The exchange has faced extensive regulatory scrutiny across multiple jurisdictions, including a landmark 2023 settlement with the United States Department of Justice and FinCEN, resulting in substantial financial penalties and a change in executive leadership."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:kyc-aml-compliance ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:bnb-chain ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:order-book ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:liquidity-provision ],
        ngm:digital-asset ;
    vc:bridgesTo ngm:decentralised-finance,
        ngm:digital-identity,
        ngm:non-fungible-token ;
    vc:contrastsWith ngm:coinbase,
        ngm:decentralised-exchange,
        ngm:kraken ;
    vc:dependsOn ngm:blockchain,
        ngm:proof-of-staked-authority,
        ngm:smart-contract ;
    vc:enables ngm:decentralised-finance,
        ngm:derivatives-trading,
        ngm:spot-trading,
        ngm:token-staking ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:binance-launchpad,
        ngm:binance-smart-chain,
        ngm:bnb-chain,
        ngm:bnb-token ;
    vc:isPartOf ngm:cryptocurrency-exchange-ecosystem ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:anti-money-laundering,
        ngm:cryptocurrency,
        ngm:digital-asset,
        ngm:financial-regulation,
        ngm:web3 ;
    vc:requires ngm:kyc-aml-compliance,
        ngm:liquidity-provision,
        ngm:order-book ;
    vc:slug "binance" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:crypto-wallet,
        ngm:ethereum-virtual-machine,
        ngm:matching-engine .

