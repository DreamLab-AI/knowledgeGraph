ngm:bias-mitigation-techniques a owl:Class ;
    rdfs:label "Bias Mitigation Techniques"@en ;
    rdfs:comment "Methods and interventions designed to reduce algorithmic bias and improve fairness in AI systems through modifications at pre-processing (data reweighting, resampling), in-processing (fairness constraints, adversarial debiasing), and post-processing (threshold optimisation) stages of the machine learning pipeline. Each approach involves tradeoffs between fairness improvement and predictive accuracy."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-governance ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:fairness-metrics ],
        ngm:ai-governance-and-ethics ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:bridgesTo ngm:data-governance,
        ngm:human-rights-law ;
    vc:contrastsWith ngm:algorithmic-bias,
        ngm:fairness-accuracy-tradeoffs ;
    vc:enables ngm:algorithmic-accountability,
        ngm:equitable-ai-deployment,
        ngm:fairness-auditing-tools ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:adversarial-debiasing,
        ngm:data-reweighting,
        ngm:resampling-techniques,
        ngm:threshold-optimisation ;
    vc:implements ngm:fairness-constraints ;
    vc:isPartOf ngm:ai-ethics,
        ngm:responsible-ai ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:ai-regulation,
        ngm:differential-privacy,
        ngm:model-explainability ;
    vc:requires ngm:data-governance,
        ngm:fairness-metrics,
        ngm:protected-attributes ;
    vc:slug "bias-mitigation-techniques" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:constrained-optimisation,
        ngm:feature-engineering,
        ngm:machine-learning-discipline-pipeline .

ngm:carbon-neutral-blockchain a owl:Class ;
