# Decentralized Storage
infrastructure:DecentralizedStorage rdf:type owl:Class ;
    rdfs:label "Decentralized Storage"@en ;
    rdfs:comment "A distributed storage infrastructure distributing data across peer-to-peer networks rather than centralised data centres, enabling data persistence, redundancy, and access without single points of failure. Decentralised Storage networks such as IPFS and Filecoin provide Censorship Resistance, Data Availability, and User Sovereignty guarantees."@en ;
    skos:prefLabel "Decentralized Storage"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:infrastructure:decentralized-storage" ;
    owl:sameAs <urn:visionclaw:concept:infrastructure:decentralized-storage> ;
