            owl:someValuesFrom ngm:robotic-process-automation ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:human-in-the-loop ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-pipeline ],
        ngm:ai-application ;
    skos:broader ngm:ai-application ;
    vc:bridgesTo ngm:decentralised-autonomous-organisation,
        ngm:smart-contract ;
    vc:contrastsWith ngm:batch-processing ;
    vc:dependsOn ngm:idempotency,
        ngm:observability,
        ngm:planning-and-scheduling ;
    vc:enables ngm:business-process-management,
        ngm:hyperautomation,
        ngm:intelligent-automation,
        ngm:multi-agent-systems ;
    vc:hasMaturity ngmi:maturity-established ;
