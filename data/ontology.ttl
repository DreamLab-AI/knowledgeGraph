        ngm:nonce,
        ngm:timestamp ;
    vc:isPartOf ngm:blockchain,
        ngm:distributed-ledger ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:blockchain-protocol,
        ngm:consensus-mechanism,
        ngm:merkle-tree ;
    vc:requires ngm:cryptographic-hash,
        ngm:immutability ;
    vc:slug "genesis-block" ;
    vc:sourceDomain "blockchain" .

ngm:gesture-recognition a owl:Class ;
    rdfs:label "Gesture Recognition"@en ;
    rdfs:comment "Gesture recognition is the computational process of identifying and interpreting human physical movements—typically of the hands, arms, head, or full body—as meaningful symbolic inputs to a computing system, enabling touchless, natural interaction paradigms. The field encompasses multiple sensing modalities including optical cameras, depth sensors, inertial measurement units, and electromagnetic field detectors, combined with machine learning pipelines that extract skeletal or surface features and classify movement sequences into semantic categories. Gesture recognition underpins human-computer interaction in extended reality, robotics, automotive interfaces, and accessibility technology, replacing or augmenting physical input devices with embodied motion vocabulary."@en ;
    rdfs:subClassOf ngm:computer-vision ;
    vc:enables ngm:augmented-reality,
        ngm:mixed-reality,
        ngm:spatial-computing,
        ngm:user-interface ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:eye-tracking,
        ngm:hand-tracking,
        ngm:human-computer-interaction,
        ngm:motion-tracking,
        ngm:pose-estimation ;
    vc:slug "gesture-recognition" ;
    vc:sourceDomain "ai" ;
    vc:supports ngm:accessibility,
        ngm:haptic-feedback,
        ngm:multimodal-ai ;
    vc:uses ngm:computer-vision-system,
        ngm:deep-learning,
        ngm:motion-capture,
        ngm:point-cloud,
        ngm:sensor-fusion .

ngm:global-illumination a owl:Class ;
    rdfs:label "Global Illumination"@en ;
    rdfs:comment "Global Illumination (GI) is a rendering approach that simulates all light interactions within a scene, including both direct illumination from light sources and indirect illumination from light bouncing between surfaces. Techniques range from offline radiosity and photon mapping to real-time approximations such as voxel cone tracing, screen-space ambient occlusion, and hardware-accelerated ray tracing, producing physically plausible colour bleeding, soft shadows, and caustics."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ray-tracing ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:rendering-pipeline ],
        ngm:metaverse,
        ngm:sc-display-and-rendering ;
    skos:broader ngm:sc-display-and-rendering ;
    vc:contrastsWith ngm:rasterization ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires ngm:ray-tracing,
        ngm:rendering-pipeline ;
    vc:slug "global-illumination" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:compute-shader,
        ngm:physically-based-rendering .

ngm:governance-model a owl:Class ;
    rdfs:label "Governance Model"@en ;
    rdfs:comment "Framework of rules and decision-making processes defining authority and accountability within a metaverse ecosystem."@en ;
