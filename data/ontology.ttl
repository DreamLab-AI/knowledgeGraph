            owl:someValuesFrom ngm:commitment-scheme ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:zero-knowledge-proof ],
        ngm:cryptographic-proof ;
    vc:bridgesTo ngm:blockchain,
        ngm:cloud-computing,
        ngm:inference ;
    vc:contrastsWith ngm:multi-party-computation,
        ngm:trusted-execution-environments ;
    vc:enables ngm:layer-2-scaling,
        ngm:privacy-preserving-computation,
        ngm:scalability ;
    vc:hasMaturity ngmi:maturity-established ;
