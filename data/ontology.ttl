    vc:slug "disaster-recovery" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:chaos-engineering,
        ngm:cloud-infrastructure,
        ngm:infrastructure-as-code .

ngm:firmware a owl:Class ;
    rdfs:label "Firmware"@en ;
    rdfs:comment "Firmware is the low-level software stored in non-volatile memory that provides the control, monitoring and data-handling logic for a hardware device. It sits between the physical hardware and higher-level software, initialising components, exposing device functions and often forming the only software a simple device runs. Firmware is typically tightly coupled to specific hardware and is updated through controlled mechanisms such as over-the-air updates. It is foundational to embedded systems, peripherals and connected devices."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:microcontroller ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:device-drivers ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:non-volatile-memory ],
        ngm:embedded-systems ;
    vc:contrastsWith ngm:application-software ;
    vc:dependsOn ngm:hardware ;
    vc:enables ngm:device-functionality,
        ngm:hardware-abstraction ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:bootloader,
        ngm:device-drivers ;
    vc:isPartOf ngm:computer-hardware ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:operating-system,
        ngm:real-time-operating-system ;
    vc:requires ngm:microcontroller,
