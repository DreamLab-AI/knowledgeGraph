            owl:someValuesFrom ngm:version-control ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:data-ingestion ],
        ngm:production-pipeline ;
    vc:bridgesTo ngm:cloud-computing,
        ngm:generative-ai,
        ngm:machine-learning ;
    vc:enables ngm:game-engine,
        ngm:real-time-rendering,
        ngm:rendering-pipeline ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:asset-pipeline,
