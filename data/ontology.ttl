    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:computer-graphics ;
    vc:relatedTo ngm:shader ;
    vc:requires ngm:gpu ;
    vc:requires ngm:rendering-pipeline ;
