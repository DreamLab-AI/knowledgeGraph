    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:platform-layer ;
    vc:slug "identity-service" ;
    vc:sourceDomain "security" .
ngm:identity-services a skos:Concept ;
    rdfs:label "Identity Services"@en .
ngm:identity-standards a owl:Class ;
    rdfs:comment "Identity Standards are agreed specifications and protocols governing how digital identities are created, expressed, verified and exchanged across systems. They include standards for decentralised identifiers, verifiable credentials and federated authentication, enabling secure, interoperable identity management across platforms and virtual environments."@en ;
    rdfs:label "Identity Standards"@en ;
    rdfs:subClassOf ngm:infra-security-and-identity ;
    skos:broader ngm:infra-security-and-identity ;
