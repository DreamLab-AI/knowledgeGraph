ngm:hashed-timelock-contract a owl:Class ;
    rdfs:label "Hashed Timelock Contract"@en ;
    rdfs:comment "A Hashed Timelock Contract (HTLC) is a conditional payment construct that locks funds until either a recipient reveals a preimage matching a published hash, or a timeout elapses and the funds revert to the sender. By combining a hashlock with a timelock, it enables trustless, atomic transfers without a central intermediary. HTLCs are the foundational primitive behind Lightning Network payment routing and cross-chain atomic swaps."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:hash-function ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:smart-contract ],
        ngm:lightning-network ;
    vc:bridgesTo ngm:cross-chain-interoperability ;
    vc:contrastsWith ngm:bitcoin ;
    vc:dependsOn ngm:hash-function ;
    vc:enables ngm:atomic-swap,
        ngm:payment-channel ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:smart-contract ;
    vc:isPartOf ngm:lightning-network ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:atomic-swap,
        ngm:cross-chain-interoperability,
        ngm:payment-channel ;
    vc:requires ngm:hash-function,
        ngm:smart-contract ;
    vc:slug "hashed-timelock-contract" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:core-lightning,
        ngm:lightning-network ;
    vc:uses ngm:hash-function .

ngm:hlsl a owl:Class ;
    rdfs:label "HLSL"@en ;
    rdfs:comment "HLSL (High-Level Shading Language) is Microsoft's C-like programming language for writing GPU shader programs targeting the Direct3D graphics API. It lets developers author vertex, pixel, geometry, and compute shaders that run on the programmable stages of the rendering pipeline. HLSL is a cornerstone of real-time graphics on Windows and Xbox platforms."@en ;
    rdfs:subClassOf ngm:programming-language ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:graphics-api,
        ngm:rendering-pipeline ;
    vc:slug "hlsl" ;
    vc:sourceDomain "metaverse" .

ngm:howey-test a owl:Class ;
    rdfs:label "Howey Test"@en ;
    rdfs:comment "The Howey Test is a four-part legal framework established by the U.S. Supreme Court in SEC v. W.J. Howey Co. (1946) to determine whether a transaction qualifies as an 'investment contract' and therefore constitutes a security subject to federal securities regulation. An instrument is a security if it involves (1) an investment of money, (2) in a common enterprise, (3) with an expectation of profits, (4) derived from the efforts of others."@en ;
    rdfs:subClassOf ngm:investment-contract-analysis ;
    vc:bridgesTo ngm:decentralised-autonomous-organisation,
        ngm:initial-coin-offering,
        ngm:security-token-offering ;
    vc:contrastsWith ngm:eu-mi-ca-regulation ;
    vc:dependsOn ngm:securities-act-1933,
        ngm:securities-exchange-act-1934 ;
    vc:enables ngm:enforcement-action ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:isPartOf ngm:financial-regulation,
        ngm:securities-regulation ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:digital-asset-regulation ;
    vc:slug "howey-test" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:investor-protection,
        ngm:securities-disclosure ;
    vc:uses ngm:economic-substance-test .

ngm:hugging-face a owl:Class ;
    rdfs:label "Hugging Face"@en ;
    rdfs:comment "Hugging Face is an AI company and open-source platform that operates the Transformers, Diffusers, Datasets, PEFT, and TRL libraries alongside the Hugging Face Hub — a centralised model and dataset repository hosting hundreds of thousands of community-contributed checkpoints spanning natural language processing, computer vision, audio, multimodal, and reinforcement learning domains. The Hub standardises model cards, dataset cards, and Spaces (interactive Gradio or Streamlit demos), and has become the de facto distribution platform for open-weight large language models and their fine-tuned derivatives. Through its inference API, AutoTrain service, and parameter-efficient fine-tuning tooling, Hugging Face significantly lowers the barrier to deploying and adapting state-of-the-art machine learning models for research and production use."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:hugging-face-diffusers ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
