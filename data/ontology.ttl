vf:linked-data-encoder a owl:Class ;
    rdfs:label "Linked Data Encoder"@en ;
    rdfs:comment "A semantic encoding pipeline that transforms agent state, credentials, events, and metadata into [[JSON-LD 1.1]] format using pinned, versioned [[JSON-LD Context|W3C JSON-LD contexts]], enabling standardised [[Federation Surface|federation surfaces]] (S1–S11) that are queryable, linkable, and machine-readable without agent-specific API adapters."@en ;
    rdfs:subClassOf vf:data-layer ;
    vc:authorityScore "0.91"^^xsd:float ;
    vc:enables <urn:visionflow:linked:cross-system-querying>,
        <urn:visionflow:linked:knowledge-graph-integration>,
        <urn:visionflow:linked:linked-data-consumption>,
        <urn:visionflow:linked:semantic-federation> ;
    vc:hasPart <urn:visionflow:linked:context-pinning>,
        <urn:visionflow:linked:json-ld-context>,
        <urn:visionflow:linked:semantic-mapping>,
        <urn:visionflow:linked:uri-resolution> ;
    vc:implements <urn:visionflow:linked:json-ld-1-1>,
        <urn:visionflow:linked:rdf-semantics>,
        <urn:visionflow:linked:w3-c-linked-data> ;
    vc:maturity "established" ;
    vc:qualityScore "0.87"^^xsd:float ;
    vc:requires <urn:visionflow:linked:canonical-json>,
        <urn:visionflow:linked:json-ld-1-1-standard>,
        <urn:visionflow:linked:w3-c-vocabulary>,
        vf:uri-canonicaliser ;
    vc:slug "linked-data-encoder" ;
    vc:sourceDomain "infrastructure" .

