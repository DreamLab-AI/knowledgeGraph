ngm:bitcoin a owl:Class ;
    rdfs:label "Bitcoin"@en ;
    rdfs:comment "Bitcoin is the first decentralised, permissionless, peer-to-peer electronic cash system, introduced by the pseudonymous Satoshi Nakamoto in a 2008 whitepaper and launched as open-source software in January 2009. It maintains a globally shared, tamper-evident ledger — the blockchain — through a proof-of-work consensus mechanism called Nakamoto Consensus, in which miners compete to extend the chain by finding nonces satisfying a difficulty-adjusted SHA-256 hash target, earning new bitcoin and transaction fees as reward. The monetary supply is strictly bounded by a 21 million coin cap enforced deterministically via a halving schedule that reduces the block subsidy approximately every four years, conferring programmatic scarcity and censorship-resistant value transfer without reliance on any trusted intermediary. Bitcoin's UTXO model, Script-based transaction authorisation, and secp256k1 elliptic-curve cryptography together form the foundational substrate upon which Lightning Network payment channels, Taproot smart contracting, and a growing ecosystem of Layer 2 protocols are built."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:bitcoin-proof-of-work-protocol-mining ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:bitcoin-proof-of-work-protocol-halving ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:bitcoin-script ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:bitcoin-proof-of-work-protocol-layer-2 ],
        ngm:cryptocurrency ;
    vc:bridgesTo ngm:fedimint,
        ngm:nostr ;
    vc:contrastsWith ngm:digital-currency,
        ngm:ethereum-smart-contract-platform,
        ngm:solana ;
    vc:enables ngm:censorship-resistance,
        ngm:decentralised-finance,
        ngm:lightning-network,
        ngm:self-custody ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:bitcoin-proof-of-work-protocol-halving,
        ngm:bitcoin-proof-of-work-protocol-layer-2,
        ngm:bitcoin-proof-of-work-protocol-mining,
        ngm:bitcoin-script ;
    vc:implements ngm:blockchain,
        ngm:consensus-mechanism,
        ngm:sound-money ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:digital-asset,
        ngm:mining-pool ;
    vc:slug "bitcoin" ;
    vc:sourceDomain "blockchain" ;
    vc:standardizedBy ngm:bip-341-taproot,
        ngm:bitcoin-proof-of-work-protocol-improvement-proposals ;
    vc:uses ngm:cryptographic-hash-function,
        ngm:nakamoto-consensus,
        ngm:peer-to-peer-network,
        ngm:proof-of-work,
        ngm:utxo-model .

ngm:blockchain-transaction a owl:Class ;
    rdfs:label "Blockchain Transaction"@en ;
    rdfs:comment "A Blockchain Transaction is an atomic, cryptographically signed instruction that encodes a state-change on a distributed ledger — such as a transfer of digital assets, invocation of a smart contract function, or mutation of on-chain data. Transactions are broadcast to a peer-to-peer network, validated against protocol rules and the active consensus mechanism, and permanently recorded in an ordered block once accepted. The transaction model differs fundamentally between UTXO-based chains (e.g. Bitcoin) and account-based chains (e.g. Ethereum), affecting parallelism, privacy, and composability."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:transaction-fee ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:merkle-tree ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:transaction-output ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:consensus-algorithm ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:digital-signature ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:utxo ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:nonce ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptographic-hash-function ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:public-key-cryptography ],
        ngm:blockchain ;
    skos:broader ngm:blockchain ;
    vc:bridgesTo ngm:digital-identity,
        ngm:supply-chain-traceability ;
    vc:contrastsWith ngm:transaction ;
    vc:enables ngm:atomic-swap,
        ngm:decentralised-finance,
        ngm:payment-system,
        ngm:smart-contract,
        ngm:tokenization ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:merkle-tree,
        ngm:nonce,
        ngm:transaction-input,
        ngm:transaction-output,
        ngm:utxo ;
    vc:isPartOf ngm:blockchain,
        ngm:distributed-ledger ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:block,
        ngm:layer-2-protocol,
        ngm:transaction-throughput ;
    vc:requires ngm:consensus-algorithm,
        ngm:cryptographic-hash-function,
        ngm:digital-signature,
        ngm:public-key-cryptography,
        ngm:transaction-fee ;
    vc:slug "blockchain-transaction" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:elliptic-curve-cryptography,
        ngm:mempool,
        ngm:zero-knowledge-proof .

ngm:central-bank a owl:Class ;
    rdfs:label "Central Bank"@en ;
    rdfs:comment "A central bank is a public financial institution vested with exclusive authority over a nation's or currency union's monetary base, responsible for setting benchmark interest rates, controlling the money supply, and acting as lender of last resort to the commercial banking sector. Central banks implement monetary policy to pursue macroeconomic objectives including price stability, sustainable economic growth, and full employment, typically operating with a degree of independence from short-term political influence. They hold official foreign exchange reserves, supervise the broader banking system, operate or oversee critical payment infrastructure, and increasingly research or issue Central Bank Digital Currencies as sovereign digital money. Major examples include the Federal Reserve, the European Central Bank, the Bank of England, the Bank of Japan, and the People's Bank of China."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:open-market-operations ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:monetary-policy-implementation ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:reserve-requirements ],
        ngm:monetary-system ;
    vc:bridgesTo ngm:distributed-ledger-technology,
        ngm:tokenization ;
    vc:contrastsWith ngm:commercial-bank,
        ngm:decentralised-finance ;
    vc:dependsOn ngm:interbank-market ;
    vc:enables ngm:central-bank-digital-currency,
        ngm:inflation-control,
        ngm:lender-of-last-resort,
        ngm:payment-system ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:monetary-policy-implementation,
        ngm:open-market-operations,
        ngm:reserve-requirements ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:bank-for-international-settlements,
        ngm:digital-currency,
        ngm:financial-regulation,
        ngm:inflation-targeting,
        ngm:quantitative-easing,
        ngm:stablecoin ;
    vc:slug "central-bank" ;
    vc:sourceDomain "finance" ;
    vc:supports ngm:basel-committee-on-banking-supervision,
        ngm:financial-stability,
        ngm:monetary-sovereignty .

ngm:data-integration a owl:Class ;
    rdfs:label "Data Integration"@en ;
    rdfs:comment "Data Integration is the set of processes, architectures, and tools that combine data from multiple heterogeneous sources — including relational databases, APIs, event streams, file systems, and third-party services — into a unified, consistent, and queryable representation suitable for analytics, machine learning, or operational workloads. It encompasses extract-transform-load (ETL) and extract-load-transform (ELT) pipelines, schema harmonisation, semantic mapping, identity resolution, and real-time federation patterns. Modern data integration extends beyond batch movement to include change-data capture (CDC), streaming integration via message brokers, and virtual federation through query engines, enabling organisations to maintain a single source of truth across distributed data estates. In AI and spatial-computing contexts, data integration connects sensor telemetry, digital-twin feeds, user-behaviour streams, and knowledge-graph stores into coherent data products that power downstream inference and immersive experiences."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-governance ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:change-data-capture ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:etl-pipeline ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:metadata-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:identity-resolution ],
        ngm:data-management ;
    vc:bridgesTo ngm:blockchain,
        ngm:digital-twin,
        ngm:knowledge-graph ;
    vc:contrastsWith ngm:data-federation,
        ngm:data-replication ;
    vc:dependsOn ngm:data-quality,
        ngm:interoperability ;
    vc:enables ngm:data-interoperability,
        ngm:data-warehouse,
        ngm:lakehouse-architecture,
        ngm:real-time-analytics,
        ngm:semantic-interoperability ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:change-data-capture,
        ngm:etl-pipeline,
        ngm:identity-resolution ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:requires ngm:data-governance,
        ngm:metadata-management ;
    vc:slug "data-integration" ;
    vc:sourceDomain "data" ;
    vc:standardizedBy ngm:open-lineage,
        ngm:sql ;
    vc:uses ngm:api-gateway,
        ngm:data-catalog,
        ngm:data-pipeline,
        ngm:message-broker .

ngm:monetary-policy a owl:Class ;
    rdfs:label "Monetary Policy"@en ;
    rdfs:comment "Monetary policy is the set of decisions made by a monetary authority — traditionally a central bank — to manage the supply of money, credit conditions, and interest rates in order to achieve macroeconomic objectives such as price stability, full employment, and sustainable economic growth. In traditional finance it encompasses tools such as open market operations, reserve requirements, discount-rate setting, and unconventional measures including quantitative easing and forward guidance. In decentralised systems and blockchain protocols, monetary policy is encoded algorithmically into protocol rules that govern token emission schedules, inflation rates, halving events, and burn mechanisms, removing discretionary human intervention and replacing it with transparent, auditable on-chain governance."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:quantitative-easing ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:open-market-operations ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:central-bank ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:reserve-requirements ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:interest-rate-policy ],
        ngm:economic-governance ;
    vc:bridgesTo ngm:on-chain-governance,
        ngm:smart-contract ;
    vc:contrastsWith ngm:fiscal-policy ;
    vc:dependsOn ngm:economics,
        ngm:macroeconomics ;
    vc:enables ngm:central-bank-digital-currency,
        ngm:inflation-control,
        ngm:price-stability,
        ngm:stablecoin ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:forward-guidance,
        ngm:interest-rate-policy,
        ngm:open-market-operations,
        ngm:quantitative-easing,
        ngm:reserve-requirements ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:defi-protocol ;
    vc:requires ngm:central-bank ;
    vc:slug "monetary-policy" ;
    vc:sourceDomain "finance" ;
    vc:standardizedBy ngm:bank-for-international-settlements,
        ngm:international-monetary-fund ;
    vc:supports ngm:financial-stability,
        ngm:monetary-policy-transmission ;
    vc:uses ngm:economic-mechanism,
        ngm:inflation-targeting,
        ngm:tokenomics .

ngm:nft a owl:Class ;
    rdfs:label "NFT"@en ;
    rdfs:comment "A Non-Fungible Token (NFT) is a cryptographic token deployed on a blockchain that encodes a unique, verifiable ownership claim over a specific digital or physical asset, distinguishing it from fungible tokens where every unit is interchangeable. The on-chain token record contains a unique identifier and owner address, while rich metadata and media assets are typically stored off-chain via IPFS, Arweave, or centralised hosting, with a content-addressed URI anchored in the token. Dominant standards include ERC-721 for individual unique tokens and ERC-1155 for semi-fungible batch collections on Ethereum-compatible chains, with equivalents on Solana (Metaplex), Tezos (FA2), and other ecosystems. NFTs enable programmable royalties, provenance tracking, and cross-platform digital ownership in domains spanning digital art, gaming, music, event ticketing, and real-world asset tokenisation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:blockchain ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:wallet ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gas-fee ],
        ngm:bc-token-and-asset ;
    skos:broader ngm:bc-token-and-asset ;
    vc:bridgesTo ngm:digital-twin,
        ngm:spatial-computing,
        ngm:supply-chain ;
    vc:contrastsWith ngm:cryptocurrency,
        ngm:fungible-token ;
    vc:dependsOn ngm:decentralised-storage,
        ngm:ethereum ;
    vc:enables ngm:creator-economy,
        ngm:digital-ownership,
        ngm:programmable-royalties,
        ngm:provenance-tracking,
        ngm:tokenization ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:web3 ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:decentralised-finance,
        ngm:digital-asset,
        ngm:eip-process,
        ngm:metaverse,
        ngm:real-world-asset-tokenisation ;
    vc:requires ngm:blockchain,
        ngm:gas-fee,
        ngm:wallet ;
    vc:slug "nft" ;
    vc:sourceDomain "blockchain" ;
    vc:standardizedBy ngm:ethereum-improvement-proposal ;
    vc:uses ngm:arweave,
        ngm:erc-1155,
        ngm:erc-721,
        ngm:ipfs,
        ngm:public-key-cryptography,
        ngm:smart-contract .

ngm:nist a owl:Class ;
    rdfs:label "NIST"@en ;
    rdfs:comment "The National Institute of Standards and Technology (NIST) is a non-regulatory US federal agency within the Department of Commerce, responsible for advancing measurement science, standards development, and technology innovation to promote US industrial competitiveness and public safety. NIST produces widely adopted voluntary frameworks for cybersecurity, privacy, risk management, and artificial intelligence governance, including the NIST Cybersecurity Framework and the NIST AI Risk Management Framework. Its Special Publication (SP) 800-series documents serve as mandatory guidance for US federal agencies and are globally referenced by private industry, academic institutions, and regulators. NIST also operates the AI Safety Institute Consortium (AISIC), positioning it as a key convening body for multi-stakeholder AI governance and evaluation methodology development."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:nist-ai-rmf ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:nist-privacy-framework ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:nist-cybersecurity-framework ],
        ngm:standards-body ;
    vc:bridgesTo ngm:algorithmic-auditing,
        ngm:responsible-ai,
        ngm:zero-trust-architecture ;
    vc:contrastsWith ngm:ieee,
        ngm:iso ;
    vc:enables ngm:ai-governance,
        ngm:cybersecurity-standard,
        ngm:privacy-engineering,
        ngm:risk-management,
        ngm:supply-chain-risk-management ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:nist-ai-rmf,
        ngm:nist-cybersecurity-framework,
        ngm:nist-privacy-framework,
        ngm:nist-sp-800-series ;
    vc:isPartOf ngm:us-department-of-commerce ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:ai-risk-management,
        ngm:compliance-framework,
        ngm:metrology,
        ngm:technical-standard ;
    vc:slug "nist" ;
    vc:sourceDomain "governance" ;
    vc:supports ngm:ai-safety,
        ngm:information-security,
        ngm:regulatory-compliance,
        ngm:trustworthy-ai .

ngm:validator-node a owl:Class ;
    rdfs:label "Validator Node"@en ;
    rdfs:comment "A network participant in a Proof of Stake or similar blockchain that locks collateral (stake) to earn the right to propose and attest to blocks, and is subject to slashing penalties for equivocation or liveness failures. Validator nodes form the security backbone of staking-based consensus, replacing the hash-rate competition of mining."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:slashing-condition ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:bls-signature ],
        ngm:blockchain-entity ;
    vc:bridgesTo ngm:distributed-system,
        ngm:trusted-execution-environment ;
    vc:contrastsWith ngm:full-node,
        ngm:mining-node ;
    vc:dependsOn ngm:consensus-mechanism,
        ngm:epoch,
        ngm:validator-selection ;
    vc:enables ngm:block,
        ngm:staking-reward,
        ngm:transaction-finality ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:byzantine-fault-tolerance,
        ngm:proof-of-stake ;
    vc:isPartOf ngm:blockchain-network,
        ngm:peer-to-peer-network,
        ngm:proof-of-stake,
        ngm:validator-set ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:finality,
        ngm:sybil-resistance ;
    vc:requires ngm:bls-signature,
        ngm:slashing-condition ;
    vc:slug "validator-node" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:decentralization,
        ngm:network-security ;
    vc:uses ngm:cryptographic-signature,
        ngm:public-key-infrastructure,
        ngm:schnorr-signature .

ngm:http a owl:Class ;
    rdfs:label "HTTP"@en ;
    rdfs:comment "The Hypertext Transfer Protocol, a stateless application-layer protocol for transferring hypertext and other resources between clients and servers that underpins the World Wide Web."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:dns ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:tcp ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:transport-layer ],
        ngm:application-layer ;
    vc:bridgesTo ngm:microservices,
        ngm:service-mesh ;
    vc:contrastsWith ngm:g-rpc,
        ngm:websocket ;
    vc:enables ngm:api,
        ngm:content-delivery-network,
        ngm:restful-api,
        ngm:web-browser ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:network-protocol,
        ngm:request-response-pattern ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:communication-protocols,
        ngm:http2,
        ngm:http3,
        ngm:quic ;
    vc:requires ngm:dns,
        ngm:tcp,
        ngm:transport-layer ;
    vc:slug "http" ;
    vc:sourceDomain "infrastructure" ;
    vc:standardizedBy ngm:ietf,
        ngm:w3-c ;
    vc:supports ngm:graph-ql,
        ngm:server-sent-events,
        ngm:websocket ;
    vc:uses ngm:http-header,
        ngm:http-status-code,
        ngm:tls .

ngm:rdf a owl:Class ;
    rdfs:label "RDF"@en ;
    rdfs:comment "The Resource Description Framework (RDF) is a W3C-standardised graph data model in which all statements are expressed as subject–predicate–object triples, where each component is identified by an IRI (Internationalised Resource Identifier) or, for literal values, a typed or language-tagged string. RDF triples compose into directed, labelled graphs that can be serialised in multiple syntaxes including Turtle, N-Triples, JSON-LD, N-Quads, and RDF/XML, and queried via the SPARQL protocol and query language. As the foundational layer of the Semantic Web and Linked Data ecosystems, RDF enables machine-readable knowledge representation that supports federated querying, ontological reasoning with OWL2, and cross-source interoperability through shared vocabulary IRIs. The open-world assumption distinguishes RDF from closed-world relational models, allowing independent datasets to be merged without schema negotiation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:iri ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:namespace ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:iri ],
        ngm:knowledge-representation ;
    vc:bridgesTo ngm:decentralised-identifier,
        ngm:machine-learning ;
    vc:contrastsWith ngm:property-graph,
        ngm:relational-database ;
    vc:enables ngm:federated-query,
        ngm:knowledge-graph,
        ngm:linked-data,
        ngm:semantic-web-linked-data-standard ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:iri ;
    vc:implements ngm:graph-data-model,
        ngm:w3c-specification,
        ngm:web-standard ;
    vc:qualityScore "0.76"^^xsd:float ;
    vc:relatedTo ngm:ontology,
        ngm:provenance,
        ngm:schema-org ;
    vc:requires ngm:iri,
        ngm:namespace ;
    vc:slug "rdf" ;
    vc:sourceDomain "data" ;
    vc:standardizedBy ngm:w3-c ;
    vc:supports ngm:owl,
        ngm:shacl,
        ngm:triple-store ;
    vc:uses ngm:json-data-interchange-format-ld,
        ngm:sparql,
        ngm:turtle .

ngm:automated-market-maker a owl:Class ;
    rdfs:label "Automated Market Maker"@en ;
    rdfs:comment "Automated Market Maker (AMM) is a decentralized exchange protocol that uses algorithmic pricing mechanisms and liquidity pools instead of traditional order books, enabling permissionless token swaps where prices adjust automatically based on supply and demand within smart contract-managed reserves."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:lp-token ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:blockchain ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:smart-contracts ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:liquidity-pool ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:token-standard ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:constant-product-formula ],
        ngm:defi-protocol ;
    vc:bridgesTo ngm:decentralized-finance,
        ngm:virtual-economy ;
    vc:contrastsWith ngm:centralized-exchange,
        ngm:order-book-exchange ;
    vc:enables ngm:liquidity-provision,
        ngm:permissionless-trading,
        ngm:price-discovery,
        ngm:yield-farming ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:constant-product-formula,
        ngm:liquidity-pool,
        ngm:lp-token ;
    vc:implements ngm:decentralized-exchange ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:arbitrage,
        ngm:impermanent-loss,
        ngm:miner-extractable-value,
        ngm:slippage ;
    vc:requires ngm:blockchain,
        ngm:smart-contracts,
        ngm:token-standard ;
    vc:slug "automated-market-maker" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:oracle,
        ngm:token-bonding-curve .

ngm:blockchain-entity a owl:Class ;
    rdfs:label "Blockchain Entity"@en ;
    rdfs:comment "A Blockchain Entity is the foundational abstract conceptual class representing any distinct component, construct, or participant within a blockchain ecosystem."@en ;
