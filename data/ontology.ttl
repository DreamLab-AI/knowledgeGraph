        ngm:software-bill-of-materials ;
    vc:implements ngm:in-toto-attestation,
        ngm:slsa-framework ;
    vc:isPartOf ngm:cybersecurity,
        ngm:risk-management ;
    vc:qualityScore "0.73"^^xsd:float ;
