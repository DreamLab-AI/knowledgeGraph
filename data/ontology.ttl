        ngm:messaging-pattern,
        ngm:software-architecture ;
    vc:requires ngm:message-broker,
        ngm:network-transport ;
    vc:slug "publish-subscribe-pattern" ;
    vc:sourceDomain "infrastructure" ;
    vc:standardizedBy ngm:amqp,
        ngm:apache-kafka,
        ngm:mqtt ;
    vc:supports ngm:iot-architecture,
        ngm:microservices-architecture ;
    vc:uses ngm:content-based-routing,
        ngm:serialisation .

ngm:quadratic-funding a owl:Class ;
    rdfs:label "Quadratic Funding"@en ;
    rdfs:comment "Quadratic Funding (QF) is a mechanism-design method for subsidising public goods in which a matching pool is distributed proportionally to the square of the sum of square roots of individual contributions to each project, ensuring that projects with many small donors receive proportionally greater matching than projects with few large donors. Formalised by Vitalik Buterin, Zoe Hitzig, and E. Glen Weyl in the 2018 paper 'Liberal Radicalism', QF is derived from welfare-economics theory as an approximation to the socially optimal provision of public goods under privately observed preferences. It has been deployed on-chain via Gitcoin Grants, where smart contracts automate matching calculations against a community-funded subsidy pool, though it requires robust Sybil resistance mechanisms such as decentralised identity verification to prevent gaming."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:decentralised-identity ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:sybil-resistance ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:smart-contract ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:mechanism-design ],
        ngm:mechanism-design ;
    vc:bridgesTo ngm:cooperative-game-theory,
        ngm:social-choice-theory,
        ngm:zero-knowledge-proof ;
    vc:contrastsWith ngm:linear-matching,
        ngm:one-person-one-vote,
        ngm:plutocratic-voting,
        ngm:quadratic-voting ;
    vc:enables ngm:dao,
        ngm:dao-governance,
        ngm:decentralised-autonomous-organisation,
        ngm:democratic-resource-allocation,
        ngm:open-source-sustainability ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:bc-defi-and-economics ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:collective-action-problem,
        ngm:gitcoin-grants,
        ngm:governance-token,
        ngm:liberal-radicalism,
        ngm:public-goods,
        ngm:quadratic-voting ;
    vc:requires ngm:decentralised-identity,
        ngm:mechanism-design,
        ngm:public-goods-funding,
        ngm:smart-contract,
        ngm:sybil-resistance ;
    vc:slug "quadratic-funding" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:matching-funds,
        ngm:on-chain-governance,
        ngm:welfare-economics .

ngm:quantum-computation-paradigm a owl:Class ;
    rdfs:label "Quantum Computation Paradigm"@en ;
    rdfs:comment "A paradigm of computation that exploits quantum-mechanical phenomena—superposition, entanglement, and interference—to perform certain calculations exponentially faster than classical computers. Quantum computing holds particular relevance for cryptography, optimisation, simulation of molecular systems, and potentially accelerating machine learning workloads, though near-term devices remain limited by qubit decoherence and error rates."@en ;
    rdfs:subClassOf ngm:infra-computing-and-cloud ;
    skos:broader ngm:infra-computing-and-cloud ;
    vc:bridgesTo ngm:artificial-intelligence,
        ngm:blockchain ;
    vc:contrastsWith ngm:classical-computing,
        ngm:cryptography ;
    vc:dependsOn ngm:quantum-mechanics,
        ngm:superconductivity ;
    vc:enables ngm:combinatorial-optimisation,
        ngm:encryption,
        ngm:molecular-simulation,
        ngm:quantum-key-distribution ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:quantum-circuit,
        ngm:quantum-error-correction,
        ngm:quantum-gate,
        ngm:qubit ;
    vc:implements ngm:grovers-algorithm,
        ngm:shors-algorithm ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:deep-learning,
        ngm:distributed-systems,
        ngm:machine-learning-discipline ;
    vc:requires ngm:cryogenic-control-systems,
        ngm:quantum-error-correction ;
    vc:slug "quantum-computation-paradigm" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:post-quantum-cryptography,
        ngm:quantum-machine-learning .

ngm:quorum a owl:Class ;
    rdfs:label "Quorum"@en ;
    rdfs:comment "A quorum is the minimum number or proportion of participants—nodes, validators, voters, or signers—that must concur or be present for a decision, transaction, or consensus round to be considered valid in a distributed system or governance process. In distributed computing, quorum systems are collections of node subsets with the intersection property: any two quorums share at least one member, preventing contradictory decisions across network partitions. In blockchain and DAO governance, quorum thresholds set the participation floor required before a vote or proposal carries binding weight, balancing decision liveness against resistance to minority capture. Threshold signature schemes and multi-signature wallets operationalise quorum as an m-of-n approval requirement that eliminates single points of failure in key custody."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:validator-set ],
        ngm:consensus-mechanism ;
    vc:bridgesTo ngm:distributed-ai-training,
        ngm:federated-learning ;
    vc:contrastsWith ngm:longest-chain-rule,
        ngm:proof-of-work ;
    vc:enables ngm:decentralised-decision-making,
        ngm:fault-tolerance,
        ngm:linearisability,
        ngm:on-chain-governance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:paxos,
        ngm:raft,
        ngm:tendermint ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:byzantine-fault-tolerance,
        ngm:consensus-algorithm,
        ngm:distributed-system,
        ngm:liveness,
        ngm:network-partition,
        ngm:safety ;
    vc:requires ngm:membership-protocol,
        ngm:validator-set ;
    vc:slug "quorum" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:blockchain-governance,
        ngm:dao-governance,
        ngm:multi-signature-wallet,
        ngm:treasury-management ;
    vc:uses ngm:consensus-protocol,
        ngm:stake-weighted-voting,
        ngm:threshold-signature,
        ngm:voting-mechanism .

ngm:reward-function a owl:Class ;
    rdfs:label "Reward Function"@en ;
    rdfs:comment "A mathematical formulation in reinforcement learning that maps state-action pairs to scalar values, guiding AI agent behaviour toward desired outcomes in game environments, virtual worlds, and autonomous systems through feedback signals."@en ;
    rdfs:subClassOf ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
