        ngm:digital-collectible ;
    vc:uses ngm:decentralized-storage .

ngm:notary-service a owl:Class ;
    rdfs:label "Notary Service"@en ;
    rdfs:comment "A notary service is a trusted third-party function that attests to the authenticity, integrity, and existence of a document or digital artefact at a specific point in time, producing a tamper-evident record legally admissible as proof. In digital contexts, notary services hash document content and anchor that hash to a verifiable ledger — blockchain or traditional timestamping authority — binding the evidence to a precise timestamp without revealing the document contents. They bridge traditional legal document authentication with cryptographic proof mechanisms, enabling use cases ranging from intellectual property protection to supply chain provenance. Blockchain-anchored notary services eliminate single-point-of-failure trust assumptions present in classical certificate-authority-based approaches."@en ;
    rdfs:subClassOf ngm:security-services ;
    vc:enables ngm:credential-verification,
        ngm:supply-chain-provenance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:compliance-verification,
        ngm:formal-verification,
        ngm:virtual-notary-service ;
    vc:slug "notary-service" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:cryptographic-hash,
        ngm:digital-certificate,
        ngm:digital-signature-verification .

ngm:occlusion-culling a owl:Class ;
    rdfs:label "Occlusion Culling"@en ;
    rdfs:comment "Occlusion culling is a real-time rendering optimisation technique that determines which scene objects are hidden (occluded) by other geometry from the viewer's current viewpoint and discards them before issuing GPU draw calls. By preventing invisible geometry from traversing the vertex, rasterisation, and fragment shader stages, occlusion culling reduces overdraw and GPU workload, enabling complex scenes with high polygon counts to maintain interactive frame rates. It is a complementary technique to frustum culling, level-of-detail selection, and back-face culling within the broader visibility determination subsystem of a render pipeline. Implementations range from CPU-driven portal and cell systems, to hardware occlusion queries, to GPU-driven indirect rendering with hierarchical Z-buffer occlusion."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:scene-graph ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:depth-buffer ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:spatial-data-structure ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:bounding-volume-hierarchy ],
        ngm:real-time-rendering ;
    vc:bridgesTo ngm:metaverse-infrastructure,
        ngm:spatial-computing ;
    vc:contrastsWith ngm:frustum-culling,
        ngm:level-of-detail ;
    vc:dependsOn ngm:gpu-compute,
        ngm:rasterization ;
    vc:enables ngm:digital-twin,
        ngm:extended-reality,
        ngm:open-world-game,
        ngm:virtual-environment ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:bounding-volume-hierarchy,
        ngm:portal-culling ;
    vc:isPartOf ngm:render-pipeline ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:collision-detection,
        ngm:spatial-partitioning ;
    vc:requires ngm:depth-buffer,
        ngm:scene-graph,
        ngm:spatial-data-structure ;
    vc:slug "occlusion-culling" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:bounding-volume,
        ngm:frustum-culling .

ngm:omnichannel a owl:Class ;
    rdfs:label "Omnichannel"@en ;
    rdfs:comment "Omnichannel is a customer engagement strategy that unifies all interaction channels — physical stores, web, mobile, social media, telephone, and messaging — into a single, consistent experience in which customer context and history transfer seamlessly across channel boundaries. Unlike multichannel approaches that operate channels in silos, omnichannel architectures share a common data layer and orchestration engine so that a session started on one channel can be continued on another without loss of state."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:customer-data-platform ],
        ngm:customer-experience-management ;
    vc:enables ngm:customer-experience,
        ngm:customer-retention ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:crm,
        ngm:omnichannel-routing ;
    vc:requires ngm:customer-data-platform ;
    vc:slug "omnichannel" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:conversational-ai .

ngm:ontology-engineering a owl:Class ;
    rdfs:label "Ontology Engineering"@en ;
    rdfs:comment "Ontology Engineering is the discipline of designing, formalizing, and maintaining ontologies: explicit, machine-readable specifications of concepts, properties, and relationships within a domain. It applies methodologies and logic languages such as OWL and RDFS to produce consistent, reusable, and reasoning-capable knowledge models. The field underpins semantic interoperability, knowledge graphs, and automated inference across heterogeneous data sources."@en ;
    rdfs:subClassOf ngm:data-management ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:knowledge-graphing ;
    vc:slug "ontology-engineering" ;
    vc:sourceDomain "data" .

ngm:open-telemetry a owl:Class ;
    rdfs:label "OpenTelemetry"@en ;
    rdfs:comment "OpenTelemetry (OTel) is a vendor-neutral open-source observability framework and CNCF project that provides unified APIs, SDKs, agents, and wire protocols for collecting distributed traces, metrics, and logs from software systems. It merges the OpenTracing and OpenCensus projects into a single standardised instrumentation layer, enabling consistent telemetry data collection regardless of the backend analysis platform. OpenTelemetry's OpenTelemetry Protocol (OTLP) has become the de-facto standard for telemetry data transport in cloud-native environments."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:distributed-tracing ],
        ngm:monitoring-system ;
    vc:bridgesTo ngm:ai-monitoring,
        ngm:observability ;
    vc:dependsOn ngm:g-rpc,
        ngm:protobuf ;
    vc:enables ngm:cloud-native-applications,
        ngm:microservices-architecture,
        ngm:observability,
        ngm:root-cause-analysis ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:cloud-native-computing-foundation ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:monitoring-dashboard,
        ngm:performance-metrics,
        ngm:real-time-monitoring ;
    vc:requires ngm:distributed-tracing ;
    vc:slug "open-telemetry" ;
    vc:sourceDomain "infrastructure" ;
    vc:standardizedBy ngm:cloud-native-computing-foundation ;
    vc:supports ngm:kubernetes,
        ngm:prometheus ;
    vc:uses ngm:api-standard,
        ngm:distributed-system .

ngm:open-usd a owl:Class ;
    rdfs:label "OpenUSD"@en ;
    rdfs:comment "OpenUSD (Universal Scene Description) is an open-source framework, scene-graph data model, and file format developed by Pixar Animation Studios for composing, simulating, collaborating on, and exchanging richly structured 3D scenes across digital content creation tools and real-time rendering pipelines. Its layered composition engine allows multiple teams or tools to contribute non-destructive overrides to a shared hierarchical scene graph with full time-sampled animation support, making it the de facto interchange format for large-scale visual effects, game engine, and industrial simulation pipelines. Governed since 2023 by the Alliance for OpenUSD (AOUSD) and progressing toward ISO/IEC 22886 standardisation, OpenUSD underpins NVIDIA Omniverse, Apple visionOS/RealityKit, and major digital twin platforms."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:scene-graph ],
        ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:bridgesTo ngm:autonomous-vehicle-simulation,
        ngm:industrial-metaverse ;
    vc:contrastsWith ngm:fbx,
        ngm:gltf-standard ;
    vc:enables ngm:3-d-content-pipeline,
        ngm:digital-twin,
        ngm:physics-simulation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:3-d-asset,
        ngm:nvidia-corporation-omniverse-platform,
        ngm:realitykit,
        ngm:rendering-pipeline ;
    vc:requires ngm:scene-graph ;
    vc:slug "open-usd" ;
    vc:sourceDomain "spatial-computing" ;
    vc:standardizedBy ngm:alliance-for-openusd ;
    vc:supports ngm:level-of-detail,
        ngm:non-destructive-editing ;
    vc:uses ngm:material-x,
        ngm:skeletal-animation .

ngm:opencl a owl:Class ;
    rdfs:label "OpenCL"@en ;
    rdfs:comment "OpenCL (Open Computing Language) is an open, royalty-free standard for writing programs that execute across heterogeneous platforms including CPUs, GPUs, and other accelerators. It defines a C-based kernel language and host API for expressing data-parallel and task-parallel computation portably across vendors. OpenCL underpins general-purpose GPU computing where cross-vendor portability is valued over the deepest single-vendor optimisation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gpu ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:compute-shader ],
        ngm:gpu-computing ;
    vc:bridgesTo ngm:spir-v ;
    vc:contrastsWith ngm:cuda ;
    vc:dependsOn ngm:gpu ;
    vc:enables ngm:gpu-acceleration,
        ngm:portability ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:compute-shader ;
    vc:isPartOf ngm:parallel-computing ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:performance-optimization,
        ngm:spir-v,
        ngm:vulkan ;
    vc:requires ngm:gpu ;
    vc:slug "opencl" ;
    vc:sourceDomain "infrastructure" ;
    vc:standardizedBy ngm:khronos-group ;
    vc:supports ngm:fpga,
        ngm:gpu-computing ;
    vc:uses ngm:parallel-computing .

ngm:optical-character-recognition a owl:Class ;
    rdfs:label "Optical Character Recognition"@en ;
    rdfs:comment "Optical Character Recognition (OCR) is a technology that converts images of typed, printed, or handwritten text into machine-encoded character sequences, enabling downstream search, editing, and automated processing of scanned documents and photographs. Classical approaches segment character glyphs and classify them against trained feature descriptors; contemporary deep-learning pipelines — typically convolutional neural networks paired with sequence models such as CTC or Transformer decoders — recognise whole text lines end-to-end without explicit segmentation. OCR is a foundational building block of document intelligence, information extraction, and accessibility tooling, and underlies virtually every large-scale digitisation effort from cultural heritage archives to enterprise content management."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:language-model ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:convolutional-neural-network ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:image-preprocessing ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:computer-vision ],
        ngm:computer-vision ;
    vc:bridgesTo ngm:digital-twin,
        ngm:robotic-process-automation,
        ngm:supply-chain-visibility ;
    vc:enables ngm:accessibility,
        ngm:document-intelligence,
        ngm:information-extraction,
        ngm:knowledge-graph,
        ngm:legal-research ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:character-segmentation,
        ngm:language-model,
        ngm:layout-analysis,
        ngm:text-detection ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:machine-learning,
        ngm:named-entity-recognition ;
    vc:requires ngm:computer-vision,
        ngm:convolutional-neural-network,
        ngm:image-preprocessing ;
    vc:slug "optical-character-recognition" ;
    vc:sourceDomain "ai" ;
    vc:standardizedBy ngm:pdf-ua,
        ngm:unicode-standard ;
    vc:uses ngm:deep-learning,
        ngm:natural-language-processing,
        ngm:recurrent-neural-network,
        ngm:transformer-architecture .

ngm:patent a owl:Class ;
    rdfs:label "Patent"@en ;
    rdfs:comment "A time-limited exclusive right granted by a sovereign authority to an inventor for a novel, inventive, and industrially applicable invention, in exchange for public disclosure of the invention. In the AI and spatial computing landscape, patents protect novel model architectures, training methods, compression algorithms, and hardware accelerators, with global filings exceeding 3.7 million applications annually as of 2024."@en ;
    rdfs:subClassOf ngm:infra-legal-and-regulatory ;
    skos:broader ngm:infra-legal-and-regulatory ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:ai-ethics,
        ngm:ai-regulation,
        ngm:intellectual-property-rights-framework ;
    vc:slug "patent" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:compliance-framework,
        ngm:conformity-assessment .

ngm:persistence a owl:Class ;
    rdfs:label "Persistence"@en ;
    rdfs:comment "The foundational architectural mechanism ensuring data, state, and identity continuity across sessions, platforms, and time within metaverse ecosystems through distributed databases, blockchain ledgers, and file systems."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:blockchain ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:distributed-systems ],
        ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:enables ngm:digital-twin,
        ngm:identity-management,
        ngm:metaverse ;
    vc:hasMaturity ngmi:maturity-emerging ;
