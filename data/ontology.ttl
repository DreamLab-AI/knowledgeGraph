ngm:uma a owl:Class ;
    rdfs:label "UMA"@en ;
    rdfs:comment "UMA is a decentralised finance protocol on Ethereum that provides an optimistic oracle for reporting data to smart contracts and tooling for creating synthetic assets."@en ;
