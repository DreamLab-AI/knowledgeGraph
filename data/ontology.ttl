        ngm:decentralized-identifiers,
        ngm:verifiable-credentials ;
    vc:implements ngm:e-idas-2-0,
        ngm:iso-27001,
        ngm:w3-c-did-core ;
    vc:isPartOf ngm:technical-standards ;
    vc:qualityScore "0.68"^^xsd:float ;
