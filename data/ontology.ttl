ngm:capital-markets-domain a owl:Class ;
    rdfs:label "Capital Markets Domain"@en ;
    rdfs:comment "The Capital Markets Domain classifies concepts concerned with the issuance, trading, and settlement of financial securities and the institutions that support them. It covers primary issuance, secondary trading venues, market microstructure, and post-trade clearing and settlement. As a top-level subject classification, it scopes the structure of organised markets rather than the individual assets traded or the regulation that governs them."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:settlement-layer ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:order-book ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:price-discovery ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:financial-instruments ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:market-microstructure ],
        ngm:owl-thing ;
    vc:enables ngm:capital-formation,
        ngm:liquidity-provision,
        ngm:price-discovery ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:clearing-house,
        ngm:market-microstructure,
        ngm:order-book,
        ngm:securities-issuance,
        ngm:trading-venue ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:financial-instruments,
        ngm:price-discovery,
        ngm:settlement-layer ;
    vc:slug "capital-markets-domain" ;
    vc:sourceDomain "capital-markets" .

