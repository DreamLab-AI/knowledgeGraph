        <urn:visionflow:linked:sdf-world-model> ;
    vc:implements <urn:visionflow:linked:gz-transport-message-protocol>,
        <urn:visionflow:linked:ros2-control-hardware-interface>,
        <urn:visionflow:linked:sdformat-specification> ;
    vc:maturity "established" ;
