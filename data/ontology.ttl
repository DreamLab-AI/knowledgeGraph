    vc:enables ngm:cryptocurrency ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:asset-management ;
    vc:slug "institutional-investment" ;
    vc:sourceDomain "finance" .

ngm:insurance a owl:Class ;
    rdfs:label "Insurance"@en ;
    rdfs:comment "Insurance is a financial arrangement in which a party pays a premium to transfer the risk of an uncertain future loss to an insurer, which pools premiums from many policyholders and pays valid claims out of that pool. It relies on the law of large numbers and actuarial estimation to price risk so that aggregate premiums cover expected losses, expenses and a margin. Insurance underpins economic resilience by smoothing the financial impact of accidents, illness, property damage and other contingencies."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:risk-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:parametric-insurance ],
        ngm:risk-management ;
    vc:bridgesTo ngm:governance ;
    vc:contrastsWith ngm:parametric-insurance ;
    vc:dependsOn ngm:governance ;
    vc:enables ngm:risk-management ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:parametric-insurance ;
    vc:implements ngm:risk-management ;
