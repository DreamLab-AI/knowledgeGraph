    dcterms:identifier "AI-0245" ;
    dcterms:subject "spatial-computing" ;
    owl:versionInfo "2.0.0" ;
    dcterms:created "2026-04-26T00:00:00Z"^^xsd:dateTime ;
    dcterms:modified "2026-04-26T13:00:00Z"^^xsd:dateTime ;
    vcw:owlRole "Concept" .

# Fine Tuning
artificial-intelligence:FineTuning rdf:type owl:Class ;
    rdfs:label "Fine Tuning"@en ;
    rdfs:comment "The process of adapting a pre-trained model to a specific downstream task by continuing training on task-specific data, typically with a lower learning rate. Fine-tuning leverages knowledge acquired during pre-training whilst specialising the model for particular applications."@en ;
    skos:prefLabel "Fine Tuning"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:artificial-intelligence:fine-tuning" ;
    owl:sameAs <urn:visionclaw:concept:artificial-intelligence:fine-tuning> ;
    vcw:contentHash "sha256-12-2a8098f1eded" ;
    vcw:qualityScore "0.5"^^xsd:decimal ;
    vcw:legacyTermId "AI-0246" ;
    vcw:ontologyStatus "draft" ;
    vcw:maturityLevel "draft" ;
    vcw:authorityScore "0.0"^^xsd:decimal ;
    dcterms:identifier "AI-0246" ;
    dcterms:subject "artificial-intelligence" ;
    owl:versionInfo "2.0.0" ;
    dcterms:created "2026-04-26T00:00:00Z"^^xsd:dateTime ;
    dcterms:modified "2026-04-26T13:00:00Z"^^xsd:dateTime ;
    vcw:owlRole "Concept" .

# Pre Training
artificial-intelligence:PreTraining rdf:type owl:Class ;
    rdfs:label "Pre Training"@en ;
    rdfs:comment "The initial training phase where a model learns general representations from large amounts of unlabelled or weakly labelled data before being adapted to specific tasks. Pre-training establishes foundational knowledge that can be transferred across multiple downstream applications."@en ;
    skos:prefLabel "Pre Training"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:artificial-intelligence:pre-training" ;
    owl:sameAs <urn:visionclaw:concept:artificial-intelligence:pre-training> ;
    vcw:contentHash "sha256-12-bd2b484146e1" ;
    vcw:qualityScore "0.5"^^xsd:decimal ;
    vcw:legacyTermId "AI-0247" ;
    vcw:ontologyStatus "draft" ;
    vcw:maturityLevel "draft" ;
    vcw:authorityScore "0.0"^^xsd:decimal ;
    dcterms:identifier "AI-0247" ;
    dcterms:subject "artificial-intelligence" ;
    owl:versionInfo "2.0.0" ;
    dcterms:created "2026-04-26T00:00:00Z"^^xsd:dateTime ;
    dcterms:modified "2026-04-26T13:00:00Z"^^xsd:dateTime ;
    vcw:owlRole "Concept" .

# Continued Pre Training
artificial-intelligence:ContinuedPreTraining rdf:type owl:Class ;
    rdfs:label "Continued Pre Training"@en ;
    rdfs:comment "An intermediate training phase where a pre-trained model undergoes additional pre-training on domain-specific or task-relevant data before fine-tuning. This technique bridges general pre-training and task-specific fine-tuning, adapting model knowledge to particular domains whilst maintaining broad capabilities."@en ;
    skos:prefLabel "Continued Pre Training"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:artificial-intelligence:continued-pre-training" ;
    owl:sameAs <urn:visionclaw:concept:artificial-intelligence:continued-pre-training> ;
    vcw:contentHash "sha256-12-0b0e91e9720c" ;
    vcw:qualityScore "0.5"^^xsd:decimal ;
    vcw:legacyTermId "AI-0248" ;
    vcw:ontologyStatus "draft" ;
    vcw:maturityLevel "draft" ;
    vcw:authorityScore "0.0"^^xsd:decimal ;
    dcterms:identifier "AI-0248" ;
    dcterms:subject "artificial-intelligence" ;
    owl:versionInfo "2.0.0" ;
    dcterms:created "2026-04-26T00:00:00Z"^^xsd:dateTime ;
    dcterms:modified "2026-04-26T13:00:00Z"^^xsd:dateTime ;
    vcw:owlRole "Concept" .

artificial-intelligence:ContinuedPreTraining vcw:bridgesTo artificial-intelligence:ComputerVision .

# Instruction Tuning
spatial-computing:InstructionTuning rdf:type owl:Class ;
    rdfs:label "Instruction Tuning"@en ;
    rdfs:comment "A fine-tuning technique that trains language models to follow natural language instructions by training on diverse instruction-response pairs. Instruction tuning enables models to generalise to new tasks described through instructions without task-specific training data."@en ;
    skos:prefLabel "Instruction Tuning"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:spatial-computing:instruction-tuning" ;
    owl:sameAs <urn:visionclaw:concept:spatial-computing:instruction-tuning> ;
    vcw:contentHash "sha256-12-d867fbe18703" ;
    vcw:qualityScore "0.5"^^xsd:decimal ;
    vcw:legacyTermId "AI-0249" ;
    vcw:ontologyStatus "draft" ;
    vcw:maturityLevel "draft" ;
    vcw:authorityScore "0.0"^^xsd:decimal ;
    dcterms:identifier "AI-0249" ;
    dcterms:subject "spatial-computing" ;
    owl:versionInfo "2.0.0" ;
    dcterms:created "2026-04-26T00:00:00Z"^^xsd:dateTime ;
    dcterms:modified "2026-04-26T13:00:00Z"^^xsd:dateTime ;
    vcw:owlRole "Concept" .

# Supervised Fine Tuning
artificial-intelligence:SupervisedFineTuning rdf:type owl:Class ;
    rdfs:label "Supervised Fine Tuning"@en ;
    rdfs:comment "A fine-tuning approach that uses labelled training data to adapt a pre-trained model to specific tasks, optimising performance through supervised learning on input-output pairs. Supervised fine-tuning (SFT) represents the most direct path from general pre-training to task-specific capability."@en ;
    skos:prefLabel "Supervised Fine Tuning"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:artificial-intelligence:supervised-fine-tuning" ;
    owl:sameAs <urn:visionclaw:concept:artificial-intelligence:supervised-fine-tuning> ;
    vcw:contentHash "sha256-12-954489affe7c" ;
    vcw:qualityScore "0.5"^^xsd:decimal ;
    vcw:legacyTermId "AI-0250" ;
    vcw:ontologyStatus "draft" ;
    vcw:maturityLevel "draft" ;
    vcw:authorityScore "0.0"^^xsd:decimal ;
    dcterms:identifier "AI-0250" ;
    dcterms:subject "artificial-intelligence" ;
    owl:versionInfo "2.0.0" ;
    dcterms:created "2026-04-26T00:00:00Z"^^xsd:dateTime ;
    dcterms:modified "2026-04-26T13:00:00Z"^^xsd:dateTime ;
    vcw:owlRole "Concept" .

# Prompt Tuning
artificial-intelligence:PromptTuning rdf:type owl:Class ;
    rdfs:label "Prompt Tuning"@en ;
    rdfs:comment "A parameter-efficient fine-tuning method that learns continuous prompt embeddings prepended to the input whilst keeping the pre-trained model frozen. Prompt tuning optimises task-specific soft prompts in the embedding space rather than modifying model weights."@en ;
    skos:prefLabel "Prompt Tuning"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:artificial-intelligence:prompt-tuning" ;
    owl:sameAs <urn:visionclaw:concept:artificial-intelligence:prompt-tuning> ;
    vcw:contentHash "sha256-12-75bb74b98e8f" ;
    vcw:qualityScore "0.5"^^xsd:decimal ;
    vcw:legacyTermId "AI-0251" ;
    vcw:ontologyStatus "draft" ;
    vcw:maturityLevel "draft" ;
    vcw:authorityScore "0.0"^^xsd:decimal ;
    dcterms:identifier "AI-0251" ;
    dcterms:subject "artificial-intelligence" ;
    owl:versionInfo "2.0.0" ;
    dcterms:created "2026-04-26T00:00:00Z"^^xsd:dateTime ;
    dcterms:modified "2026-04-26T13:00:00Z"^^xsd:dateTime ;
    vcw:owlRole "Concept" .

# Prefix Tuning
spatial-computing:PrefixTuning rdf:type owl:Class ;
    rdfs:label "Prefix Tuning"@en ;
    rdfs:comment "A parameter-efficient fine-tuning technique that prepends trainable continuous vectors (prefixes) to the key and value matrices at each transformer layer, whilst keeping the pre-trained model parameters frozen. Unlike prompt tuning which only modifies input embeddings, prefix tuning affects attention computation at every layer."@en ;
    skos:prefLabel "Prefix Tuning"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:spatial-computing:prefix-tuning" ;
    owl:sameAs <urn:visionclaw:concept:spatial-computing:prefix-tuning> ;
    vcw:contentHash "sha256-12-a3c55eee29bf" ;
    vcw:qualityScore "0.5"^^xsd:decimal ;
    vcw:legacyTermId "AI-0252" ;
    vcw:ontologyStatus "draft" ;
    vcw:maturityLevel "draft" ;
    vcw:authorityScore "0.0"^^xsd:decimal ;
    dcterms:identifier "AI-0252" ;
    dcterms:subject "spatial-computing" ;
    owl:versionInfo "2.0.0" ;
    dcterms:created "2026-04-26T00:00:00Z"^^xsd:dateTime ;
    dcterms:modified "2026-04-26T13:00:00Z"^^xsd:dateTime ;
    vcw:owlRole "Concept" .

# Adapter Modules
spatial-computing:AdapterModules rdf:type owl:Class ;
    rdfs:label "Adapter Modules"@en ;
    rdfs:comment "Small neural network modules inserted between transformer layers that are trained whilst keeping the original model frozen. Adapter modules provide a parameter-efficient way to adapt pre-trained models to new tasks by learning task-specific transformations without modifying the base model."@en ;
    skos:prefLabel "Adapter Modules"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:spatial-computing:adapter-modules" ;
    owl:sameAs <urn:visionclaw:concept:spatial-computing:adapter-modules> ;
    vcw:contentHash "sha256-12-4989f132aaa9" ;
    vcw:qualityScore "0.5"^^xsd:decimal ;
    vcw:legacyTermId "AI-0253" ;
    vcw:ontologyStatus "draft" ;
    vcw:maturityLevel "draft" ;
    vcw:authorityScore "0.0"^^xsd:decimal ;
    dcterms:identifier "AI-0253" ;
    dcterms:subject "spatial-computing" ;
    owl:versionInfo "2.0.0" ;
    dcterms:created "2026-04-26T00:00:00Z"^^xsd:dateTime ;
    dcterms:modified "2026-04-26T13:00:00Z"^^xsd:dateTime ;
    vcw:owlRole "Concept" .

spatial-computing:AdapterModules vcw:bridgesTo spatial-computing:ComputerVision .

# Lo RA
spatial-computing:LoRA rdf:type owl:Class ;
    rdfs:label "Lo RA"@en ;
    rdfs:comment "A parameter-efficient fine-tuning method that freezes pre-trained weights and injects trainable low-rank decomposition matrices into each layer of the transformer, dramatically reducing trainable parameters whilst maintaining performance. LoRA represents weight updates as the product of two low-rank matrices."@en ;
    skos:prefLabel "Lo RA"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:spatial-computing:lo-ra" ;
    owl:sameAs <urn:visionclaw:concept:spatial-computing:lo-ra> ;
    vcw:contentHash "sha256-12-ed8bffa92396" ;
    vcw:qualityScore "0.5"^^xsd:decimal ;
    vcw:legacyTermId "AI-0254" ;
    vcw:ontologyStatus "draft" ;
    vcw:maturityLevel "draft" ;
    vcw:authorityScore "0.0"^^xsd:decimal ;
    dcterms:identifier "AI-0254" ;
    dcterms:subject "spatial-computing" ;
    owl:versionInfo "2.0.0" ;
    dcterms:created "2026-04-26T00:00:00Z"^^xsd:dateTime ;
    dcterms:modified "2026-04-26T13:00:00Z"^^xsd:dateTime ;
    vcw:owlRole "Concept" .

# QLoRA
spatial-computing:QLoRA rdf:type owl:Class ;
    rdfs:label "QLoRA"@en ;
    rdfs:comment "An extension of LoRA that combines 4-bit quantisation with low-rank adaptation, enabling fine-tuning of very large models (65B+ parameters) on consumer-grade GPUs. QLoRA uses NormalFloat4 quantisation, double quantisation, and paged optimisers to achieve extreme memory efficiency whilst maintaining performance."@en ;
    skos:prefLabel "QLoRA"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:spatial-computing:qlora" ;
    owl:sameAs <urn:visionclaw:concept:spatial-computing:qlora> ;
    vcw:contentHash "sha256-12-bec4f9ac2770" ;
    vcw:qualityScore "0.5"^^xsd:decimal ;
    vcw:legacyTermId "AI-0255" ;
    vcw:ontologyStatus "draft" ;
    vcw:maturityLevel "draft" ;
    vcw:authorityScore "0.0"^^xsd:decimal ;
    dcterms:identifier "AI-0255" ;
    dcterms:subject "spatial-computing" ;
    owl:versionInfo "2.0.0" ;
    dcterms:created "2026-04-26T00:00:00Z"^^xsd:dateTime ;
    dcterms:modified "2026-04-26T13:00:00Z"^^xsd:dateTime ;
    vcw:owlRole "Concept" .

# Full Fine Tuning
spatial-computing:FullFineTuning rdf:type owl:Class ;
    rdfs:label "Full Fine Tuning"@en ;
    rdfs:comment "A fine-tuning approach that updates all parameters of a pre-trained model during adaptation to a downstream task. Full fine-tuning provides maximum flexibility and performance potential but requires substantial computational resources and memory."@en ;
    skos:prefLabel "Full Fine Tuning"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:spatial-computing:full-fine-tuning" ;
    owl:sameAs <urn:visionclaw:concept:spatial-computing:full-fine-tuning> ;
    vcw:contentHash "sha256-12-2be2e90a4c6e" ;
    vcw:qualityScore "0.5"^^xsd:decimal ;
    vcw:legacyTermId "AI-0257" ;
    vcw:ontologyStatus "draft" ;
    vcw:maturityLevel "draft" ;
    vcw:authorityScore "0.0"^^xsd:decimal ;
    dcterms:identifier "AI-0257" ;
    dcterms:subject "spatial-computing" ;
    owl:versionInfo "2.0.0" ;
    dcterms:created "2026-04-26T00:00:00Z"^^xsd:dateTime ;
    dcterms:modified "2026-04-26T13:00:00Z"^^xsd:dateTime ;
    vcw:owlRole "Concept" .

# Task Specific Head
spatial-computing:TaskSpecificHead rdf:type owl:Class ;
    rdfs:label "Task Specific Head"@en ;
    rdfs:comment "A small neural network layer or module added on top of a pre-trained model to adapt it for specific downstream tasks. Task-specific heads process the pre-trained model's representations to produce task-appropriate outputs (classifications, spans, sequences, etc.)."@en ;
    skos:prefLabel "Task Specific Head"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:spatial-computing:task-specific-head" ;
    owl:sameAs <urn:visionclaw:concept:spatial-computing:task-specific-head> ;
    vcw:contentHash "sha256-12-76b1283d6976" ;
    vcw:qualityScore "0.5"^^xsd:decimal ;
    vcw:legacyTermId "AI-0258" ;
    vcw:ontologyStatus "draft" ;
    vcw:maturityLevel "draft" ;
    vcw:authorityScore "0.0"^^xsd:decimal ;
    dcterms:identifier "AI-0258" ;
    dcterms:subject "spatial-computing" ;
    owl:versionInfo "2.0.0" ;
    dcterms:created "2026-04-26T00:00:00Z"^^xsd:dateTime ;
    dcterms:modified "2026-04-26T13:00:00Z"^^xsd:dateTime ;
    vcw:owlRole "Concept" .

# Multi Task Learning
spatial-computing:MultiTaskLearning rdf:type owl:Class ;
    rdfs:label "Multi Task Learning"@en ;
    rdfs:comment "A machine learning paradigm where a model is trained simultaneously on multiple related tasks, sharing representations across tasks to improve generalization and efficiency. Multi-task learning leverages task relatedness to learn better features than training on each task independently."@en ;
    skos:prefLabel "Multi Task Learning"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:spatial-computing:multi-task-learning" ;
    owl:sameAs <urn:visionclaw:concept:spatial-computing:multi-task-learning> ;
    vcw:contentHash "sha256-12-9d6803e8cae9" ;
    vcw:qualityScore "0.5"^^xsd:decimal ;
    vcw:legacyTermId "AI-0259" ;
    vcw:ontologyStatus "draft" ;
    vcw:maturityLevel "draft" ;
    vcw:authorityScore "0.0"^^xsd:decimal ;
    dcterms:identifier "AI-0259" ;
    dcterms:subject "spatial-computing" ;
    owl:versionInfo "2.0.0" ;
    dcterms:created "2026-04-26T00:00:00Z"^^xsd:dateTime ;
    dcterms:modified "2026-04-26T13:00:00Z"^^xsd:dateTime ;
    vcw:owlRole "Concept" .

# Curriculum Learning
spatial-computing:CurriculumLearning rdf:type owl:Class ;
    rdfs:label "Curriculum Learning"@en ;
    rdfs:comment "A training strategy that presents examples to the model in a meaningful order, typically from easy to difficult, mimicking how humans learn. Curriculum learning can improve convergence speed, final performance, and generalization by structuring the learning progression."@en ;
    skos:prefLabel "Curriculum Learning"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:spatial-computing:curriculum-learning" ;
    owl:sameAs <urn:visionclaw:concept:spatial-computing:curriculum-learning> ;
    vcw:contentHash "sha256-12-0f770f5fe6b2" ;
    vcw:qualityScore "0.5"^^xsd:decimal ;
    vcw:legacyTermId "AI-0260" ;
    vcw:ontologyStatus "draft" ;
    vcw:maturityLevel "draft" ;
    vcw:authorityScore "0.0"^^xsd:decimal ;
    dcterms:identifier "AI-0260" ;
    dcterms:subject "spatial-computing" ;
    owl:versionInfo "2.0.0" ;
    dcterms:created "2026-04-26T00:00:00Z"^^xsd:dateTime ;
    dcterms:modified "2026-04-26T13:00:00Z"^^xsd:dateTime ;
    vcw:owlRole "Concept" .

# Reinforcement Learning from Human Feedback
artificial-intelligence:ReinforcementLearningfromHumanFeedback rdf:type owl:Class ;
    rdfs:label "Reinforcement Learning from Human Feedback"@en ;
    rdfs:comment "A technique for aligning language models with human preferences by training a reward model from human rankings of outputs and using reinforcement learning (typically PPO) to optimise the policy towards maximising predicted human preference. RLHF enables models to learn complex alignment objectives difficult to specify explicitly."@en ;
    skos:prefLabel "Reinforcement Learning from Human Feedback"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:artificial-intelligence:reinforcement-learning-from-human-feedback" ;
    owl:sameAs <urn:visionclaw:concept:artificial-intelligence:reinforcement-learning-from-human-feedback> ;
    vcw:contentHash "sha256-12-1decdbbc90c1" ;
    vcw:qualityScore "0.5"^^xsd:decimal ;
    vcw:legacyTermId "AI-0261" ;
    vcw:ontologyStatus "draft" ;
    vcw:maturityLevel "draft" ;
    vcw:authorityScore "0.0"^^xsd:decimal ;
    dcterms:identifier "AI-0261" ;
    dcterms:subject "artificial-intelligence" ;
    owl:versionInfo "2.0.0" ;
    dcterms:created "2026-04-26T00:00:00Z"^^xsd:dateTime ;
    dcterms:modified "2026-04-26T13:00:00Z"^^xsd:dateTime ;
    vcw:owlRole "Concept" .

# Human Feedback
spatial-computing:HumanFeedback rdf:type owl:Class ;
    rdfs:label "Human Feedback"@en ;
    rdfs:comment "Information provided by human evaluators about model outputs, typically in the form of rankings, ratings, demonstrations, or corrections. Human feedback serves as the training signal for aligning AI systems with human preferences and values, enabling learning of complex objectives difficult to specify formally."@en ;
    skos:prefLabel "Human Feedback"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:spatial-computing:human-feedback" ;
    owl:sameAs <urn:visionclaw:concept:spatial-computing:human-feedback> ;
    vcw:contentHash "sha256-12-cbcff329633f" ;
    vcw:qualityScore "0.5"^^xsd:decimal ;
    vcw:legacyTermId "AI-0262" ;
    vcw:ontologyStatus "draft" ;
    vcw:maturityLevel "draft" ;
    vcw:authorityScore "0.0"^^xsd:decimal ;
    dcterms:identifier "AI-0262" ;
    dcterms:subject "spatial-computing" ;
    owl:versionInfo "2.0.0" ;
    dcterms:created "2026-04-26T00:00:00Z"^^xsd:dateTime ;
    dcterms:modified "2026-04-26T13:00:00Z"^^xsd:dateTime ;
    vcw:owlRole "Concept" .

# Reward Model
spatial-computing:RewardModel rdf:type owl:Class ;
    rdfs:label "Reward Model"@en ;
    rdfs:comment "A neural network trained to predict scalar rewards for model outputs based on human feedback, used to provide learning signals in reinforcement learning from human feedback (RLHF). The reward model serves as a proxy for human preferences, enabling efficient optimization without constant human evaluation."@en ;
    skos:prefLabel "Reward Model"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:spatial-computing:reward-model" ;
    owl:sameAs <urn:visionclaw:concept:spatial-computing:reward-model> ;
    vcw:contentHash "sha256-12-2e9dedb9fe03" ;
    vcw:qualityScore "0.5"^^xsd:decimal ;
    vcw:legacyTermId "AI-0263" ;
    vcw:ontologyStatus "draft" ;
    vcw:maturityLevel "draft" ;
    vcw:authorityScore "0.0"^^xsd:decimal ;
    dcterms:identifier "AI-0263" ;
    dcterms:subject "spatial-computing" ;
    owl:versionInfo "2.0.0" ;
    dcterms:created "2026-04-26T00:00:00Z"^^xsd:dateTime ;
    dcterms:modified "2026-04-26T13:00:00Z"^^xsd:dateTime ;
    vcw:owlRole "Concept" .

# Preference Learning
spatial-computing:PreferenceLearning rdf:type owl:Class ;
    rdfs:label "Preference Learning"@en ;
    rdfs:comment "A machine learning paradigm that learns from comparative judgments (e.g., \"A is better than B\") rather than absolute labels or demonstrations. Preference learning enables training models to align with human values by learning from rankings and comparisons, which are often easier for humans to provide than absolute ratings or demonstrations."@en ;
    skos:prefLabel "Preference Learning"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:spatial-computing:preference-learning" ;
    owl:sameAs <urn:visionclaw:concept:spatial-computing:preference-learning> ;
    vcw:contentHash "sha256-12-5a9843696f1a" ;
    vcw:qualityScore "0.5"^^xsd:decimal ;
    vcw:legacyTermId "AI-0264" ;
    vcw:ontologyStatus "draft" ;
    vcw:maturityLevel "draft" ;
    vcw:authorityScore "0.0"^^xsd:decimal ;
    dcterms:identifier "AI-0264" ;
    dcterms:subject "spatial-computing" ;
    owl:versionInfo "2.0.0" ;
    dcterms:created "2026-04-26T00:00:00Z"^^xsd:dateTime ;
    dcterms:modified "2026-04-26T13:00:00Z"^^xsd:dateTime ;
    vcw:owlRole "Concept" .

# Proximal Policy Optimisation
spatial-computing:ProximalPolicyOptimisation rdf:type owl:Class ;
    rdfs:label "Proximal Policy Optimisation"@en ;
    rdfs:comment "A reinforcement learning algorithm that updates policies through incremental steps whilst constraining how much the policy can change, preventing destabilising updates. PPO is the standard RL algorithm used in RLHF for optimising language models based on reward model feedback."@en ;
    skos:prefLabel "Proximal Policy Optimisation"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:spatial-computing:proximal-policy-optimisation" ;
    owl:sameAs <urn:visionclaw:concept:spatial-computing:proximal-policy-optimisation> ;
    vcw:contentHash "sha256-12-85976c621e17" ;
    vcw:qualityScore "0.5"^^xsd:decimal ;
    vcw:legacyTermId "AI-0265" ;
    vcw:ontologyStatus "draft" ;
    vcw:maturityLevel "draft" ;
    vcw:authorityScore "0.0"^^xsd:decimal ;
    dcterms:identifier "AI-0265" ;
    dcterms:subject "spatial-computing" ;
    owl:versionInfo "2.0.0" ;
    dcterms:created "2026-04-26T00:00:00Z"^^xsd:dateTime ;
    dcterms:modified "2026-04-26T13:00:00Z"^^xsd:dateTime ;
    vcw:owlRole "Concept" .

# Direct Preference Optimisation
spatial-computing:DirectPreferenceOptimisation rdf:type owl:Class ;
    rdfs:label "Direct Preference Optimisation"@en ;
    rdfs:comment "An alignment method that directly uses preference data to fine-tune language models without training a separate reward model or using reinforcement learning, offering a simpler alternative to RLHF. DPO optimizes the policy directly on preference comparisons through a reparameterisation of the reward model objective."@en ;
    skos:prefLabel "Direct Preference Optimisation"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:spatial-computing:direct-preference-optimisation" ;
    owl:sameAs <urn:visionclaw:concept:spatial-computing:direct-preference-optimisation> ;
    vcw:contentHash "sha256-12-2d6a3e2bb4ba" ;
    vcw:qualityScore "0.5"^^xsd:decimal ;
    vcw:legacyTermId "AI-0266" ;
