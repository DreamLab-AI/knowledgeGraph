ngm:value-sensitive-design a owl:Class ;
    rdfs:comment "Value-sensitive design is a methodology for building technology that accounts for human values — such as privacy, autonomy, fairness and wellbeing — throughout the design process rather than as an afterthought. It combines conceptual investigation of stakeholder values, empirical study of how people are actually affected, and technical work to embed the resulting requirements into system design. The approach is widely referenced in AI ethics frameworks and standards, including IEEE 7000, as a structured way to surface and reconcile competing stakeholder values before deployment."@en ;
    rdfs:label "Value-Sensitive Design"@en ;
    rdfs:subClassOf ngm:ai-ethics ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.55"^^xsd:float ;
    vc:slug "value-sensitive-design" ;
    vc:sourceDomain "governance" ;
    vc:uses ngm:ai-ethics .
