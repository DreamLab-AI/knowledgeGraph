    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:convolutional-neural-network,
        ngm:image-segmentation .

ngm:ocsp a owl:Class ;
    rdfs:label "Ocsp"@en ;
    rdfs:comment "The Online Certificate Status Protocol (OCSP) is an internet protocol for obtaining the real-time revocation status of a digital certificate from a responder operated by or on behalf of the issuing certificate authority. A client queries the responder for a specific certificate and receives a signed reply stating whether it is good, revoked, or unknown. OCSP offers a more immediate and bandwidth-efficient alternative to downloading full certificate revocation lists, and OCSP stapling lets servers present a recent status to avoid client-side lookups."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:certificate-authority ],
        ngm:certificate-revocation ;
    vc:contrastsWith ngm:certificate-revocation-list ;
    vc:enables ngm:mutual-tls ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:implements ngm:certificate-revocation ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:online-certificate-status-protocol,
        ngm:privacy,
        ngm:security ;
    vc:requires ngm:certificate-authority ;
    vc:slug "ocsp" ;
    vc:sourceDomain "security" ;
    vc:supports ngm:tls,
        ngm:trust-model ;
    vc:uses ngm:public-key-cryptography,
        ngm:public-key-infrastructure .

ngm:olap a owl:Class ;
    rdfs:label "Olap"@en ;
    rdfs:comment "Online Analytical Processing (OLAP) is a category of data processing optimised for fast, multidimensional analysis of large volumes of historical and aggregated data. It organises measures along dimensions such as time, geography, and product, allowing analysts to slice, dice, roll up, and drill down through data cubes interactively. OLAP underpins business intelligence and decision support by enabling complex aggregate queries that contrast with the row-oriented, transactional focus of operational systems."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-warehouse ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:data-warehouse ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:data-analytics ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-architecture ],
        ngm:data-analytics ;
    vc:bridgesTo ngm:business-intelligence ;
    vc:contrastsWith ngm:data-pipeline ;
    vc:enables ngm:business-intelligence,
        ngm:data-visualisation,
        ngm:decision-support ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:data-analytics,
        ngm:data-warehouse ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:data-architecture,
