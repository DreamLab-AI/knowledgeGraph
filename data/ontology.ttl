ngm:hyperparameter-optimisation a owl:Class ;
    rdfs:label "Hyperparameter Optimisation"@en ;
    rdfs:comment "Hyperparameter optimisation is the automated search process for the configuration values — such as learning rate, regularisation strength, architecture depth, and batch size — that govern a machine learning model's training dynamics but are not learned directly from data, with the aim of maximising held-out validation performance. It encompasses grid search, random search, Bayesian optimisation, and gradient-based meta-learning, operating over an outer loop that wraps the inner model training procedure."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cross-validation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:objective-function ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:validation-set ],
        ngm:hyperparameter ;
    vc:bridgesTo ngm:artificial-intelligence,
        ngm:reinforcement-learning ;
    vc:dependsOn ngm:compute-resources,
        ngm:machine-learning-discipline-framework ;
    vc:enables ngm:automated-machine-learning,
        ngm:machine-learning-discipline-model,
        ngm:model-selection,
        ngm:model-training ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:early-stopping,
        ngm:hyperparameter-tuning,
        ngm:learning-rate-schedule,
        ngm:meta-learning,
        ngm:regularisation ;
    vc:requires ngm:cross-validation,
        ngm:objective-function,
        ngm:validation-set ;
    vc:slug "hyperparameter-optimisation" ;
    vc:sourceDomain "machine-learning" ;
    vc:supports ngm:mlops,
        ngm:model-evaluation ;
    vc:uses ngm:bayesian-optimisation,
        ngm:gaussian-process,
        ngm:gradient-descent,
        ngm:grid-search,
        ngm:machine-learning-discipline-pipeline,
        ngm:neural-architecture-search,
        ngm:random-search .

ngm:immersive-communication a owl:Class ;
    rdfs:label "Immersive Communication"@en ;
    rdfs:comment "Immersive Communication encompasses communication systems and experiences that leverage extended reality (XR) technologies — including virtual reality (VR) meetings, augmented reality (AR) collaboration tools, spatial audio conferencing, and mixed reality platforms — to create spatially-aware, embodied interaction environments that transcend conventional 2D video interfaces. These systems convey presence, embodiment, and spatial context by rendering participants as avatars or volumetric representations within shared virtual or hybrid spaces, enabling natural non-verbal cues, gaze, gesture, and proxemics that flat-screen media cannot replicate. The field draws on human-computer interaction research, telepresence theory, and spatial computing infrastructure to reduce cognitive load and social distance in remote work, education, and social engagement."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:volumetric-video ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:avatar ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:head-mounted-display ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:low-latency-networking ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:extended-reality ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:spatial-audio ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:haptic-feedback ],
        ngm:telecollaboration ;
    vc:bridgesTo ngm:computer-supported-cooperative-work,
        ngm:human-computer-interaction,
        ngm:spatial-computing ;
    vc:enables ngm:presence,
        ngm:remote-collaboration,
        ngm:social-vr,
        ngm:virtual-collaboration ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:avatar,
        ngm:haptic-feedback,
        ngm:spatial-audio,
        ngm:volumetric-video ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:embodied-interaction,
        ngm:non-verbal-communication,
        ngm:telepresence ;
    vc:requires ngm:extended-reality,
        ngm:head-mounted-display,
        ngm:low-latency-networking ;
    vc:slug "immersive-communication" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:distributed-teamwork ;
    vc:uses ngm:augmented-reality,
        ngm:metaverse,
        ngm:mixed-reality,
        ngm:virtual-reality .

ngm:immersive-learning a owl:Class ;
    rdfs:label "Immersive Learning"@en ;
    rdfs:comment "Educational approaches utilising VR, AR, and metaverse technologies to create engaging, interactive learning environments that enable experiential skill development, realistic scenario simulation, and enhanced knowledge retention through presence-based educational experiences."@en ;
