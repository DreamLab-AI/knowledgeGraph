        ngm:rest-api .

ngm:asic a owl:Class ;
    rdfs:label "ASIC"@en ;
    rdfs:comment "An Application-Specific Integrated Circuit (ASIC) is a custom integrated circuit designed and fabricated at the transistor and mask level to perform a specific function or narrow set of functions with maximum efficiency, in contrast to general-purpose processors such as CPUs and GPUs that are optimised for programmable flexibility. ASICs achieve superior performance-per-watt and cost efficiency at production volume by eliminating logic not required for the target workload, at the expense of reconfigurability. Design is conducted using hardware description languages (VHDL, SystemVerilog), electronic design automation suites, and a foundry-specific tape-out flow; non-recurring engineering costs at advanced nodes (5nm, 3nm) can exceed tens of millions of pounds, making economic viability contingent on volume or uniquely demanding performance requirements. ASICs are central to cryptocurrency mining, AI inference and training acceleration, high-speed networking switch fabric, signal processing, and consumer electronics where power, cost, and performance constraints demand purpose-built silicon."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:hardware-description-language ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:foundry ],
        ngm:hardware ;
    vc:bridgesTo ngm:ai-accelerator,
        ngm:proof-of-work ;
    vc:contrastsWith ngm:central-processing-unit,
        ngm:fpga,
        ngm:gpu-compute ;
    vc:dependsOn ngm:supply-chain-management ;
    vc:enables ngm:bitcoin-proof-of-work-protocol-mining,
        ngm:hardware-acceleration,
        ngm:high-speed-networking,
        ngm:inference-hardware,
        ngm:neural-processing-unit ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:implements ngm:cryptographic-hash-function,
        ngm:matrix-multiplication ;
    vc:isPartOf ngm:semiconductor-industry,
        ngm:system-on-chip ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:embedded-systems,
        ngm:hardware-component ;
    vc:requires ngm:electronic-design-automation,
        ngm:foundry,
        ngm:hardware-description-language ;
    vc:slug "asic" ;
    vc:sourceDomain "infrastructure" .

ngm:asset-pipeline a owl:Class ;
    rdfs:label "Asset Pipeline"@en ;
    rdfs:comment "An asset pipeline is an automated, staged workflow that ingests raw digital content—meshes, textures, audio, animations, and shaders—and transforms it through validation, processing, optimisation, and packaging steps into runtime-ready formats consumable by real-time engines, streaming platforms, or spatial computing environments. It enforces deterministic builds, enables version-controlled dependency graphs, and dramatically reduces manual content-preparation labour. Asset pipelines are foundational to game development, visual effects, and metaverse platform engineering, and increasingly incorporate AI-assisted level-of-detail generation, texture compression, and semantic tagging to scale content delivery across heterogeneous device targets."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:texture-compression ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:level-of-detail ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:render-pipeline ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:content-addressed-storage ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:version-control ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:asset-management ],
        ngm:content-pipeline ;
    vc:bridgesTo ngm:content-generation,
        ngm:supply-chain-provenance ;
    vc:dependsOn ngm:continuous-integration,
        ngm:metadata-schema ;
    vc:enables ngm:content-delivery,
