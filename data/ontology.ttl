ngm:shape-memory-alloy-actuator a owl:Class ;
    rdfs:label "Shape Memory Alloy Actuator"@en ;
    rdfs:comment "A shape memory alloy (SMA) actuator exploits the thermoelastic phase transformation of nickel-titanium (Nitinol) or similar alloys, which contract and generate force when thermally activated, then return to their original shape on cooling. SMA actuators are valued for their high force-to-weight ratio, silent operation, and inherent compliance, making them well-suited to soft robotics, minimally invasive surgical tools, and wearable exoskeletons. Control bandwidth is limited by thermal cycle times, which remains a key engineering challenge."@en ;
    rdfs:subClassOf ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:enables ngm:exoskeleton-robot,
        ngm:haptic-feedback,
        ngm:surgical-robot ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:soft-robotics ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:end-effector,
        ngm:hydraulic-actuator,
        ngm:manipulation,
        ngm:pneumatic-actuator,
        ngm:robot-actuator ;
    vc:slug "shape-memory-alloy-actuator" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:tactile-sensor .

ngm:siggraph-pipeline-wg a owl:Class ;
    rdfs:label "SIGGRAPH Pipeline WG"@en ;
    rdfs:comment "The SIGGRAPH Pipeline Working Group is an industry effort associated with the SIGGRAPH community that addresses interoperability and best practice across the stages of 3D content production pipelines."@en ;
