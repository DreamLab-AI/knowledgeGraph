vf:haptic-feedback a owl:Class ;
    rdfs:label "Haptic Feedback"@en ;
    rdfs:comment "Tactile sensory technology providing physical sensations to enhance virtual experiences through actuators integrated into controllers, gloves, and body suits. Haptic feedback simulates touch, pressure, texture, and force feedback by translating digital signals into mechanical vibrations and force responses, enabling users to feel virtual objects and interactions with realistic tactile cues. The technology bridges [[VirtualReality]] and [[AugmentedReality]] systems with [[SensoryImmersion]] through [[TactileActuator|tactile actuators]] calibrated via [[SensorFusion]]."@en ;
    rdfs:subClassOf vf:spatial-computing ;
    vc:authorityScore "0.0"^^xsd:float ;
    vc:maturity "draft" ;
