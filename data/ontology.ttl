    vc:relatedTo ngm:personalized-virtual-experiences,
        ngm:user-experience ;
    vc:requires ngm:avatar-system,
        ngm:virtual-world-infrastructure ;
    vc:slug "virtual-experience" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:extended-reality,
        ngm:immersive-experience .

ngm:virtual-factory a owl:Class ;
    rdfs:label "Virtual Factory"@en ;
    rdfs:comment "A physically accurate digital twin representation of a manufacturing facility that enables modelling, simulation, analysis, and optimisation of production processes, resources, and operations without physical prototypes or pilot plants. It integrates IoT sensor data, AI-driven analytics, and real-time bidirectional synchronisation; platforms such as NVIDIA Omniverse (OpenUSD) and Siemens Tecnomatix are primary implementation environments. Virtual factories are a core Industry 4.0 concept supporting predictive maintenance, layout optimisation, and safe robotics training."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:digital-twin-technology ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:simulation-engine ],
        ngm:digital-twin,
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:enables ngm:digital-twin-collaboration,
