ngm:hmac a owl:Class ;
    rdfs:comment "HMAC (hash-based message authentication code) is a construction that combines a cryptographic hash function with a secret key to produce a fixed-length tag verifying both the integrity and the authenticity of a message. It applies the underlying hash twice with key-derived inner and outer padding, providing security that does not depend on the hash being collision-resistant in the same way a plain hash would. HMAC is widely used to authenticate API requests, tokens, and protocol messages."@en ;
    rdfs:label "HMAC"@en ;
    rdfs:subClassOf ngm:cryptography ;
    rdfs:subClassOf _:r11420 ;
    rdfs:subClassOf _:r11421 ;
