    rdfs:label "Tessellation"@en .
ngm:tessellation-shader a owl:Class ;
    rdfs:comment "A tessellation shader is a programmable stage of the GPU graphics pipeline that subdivides coarse geometric patches into finer primitives at render time, controlling the level of detail of surfaces dynamically. It comprises a control phase that sets tessellation factors and an evaluation phase that positions the generated vertices. By adaptively refining meshes on the GPU, it produces smooth curved surfaces and displacement-mapped detail without inflating the source geometry."@en ;
    rdfs:label "Tessellation Shader"@en ;
    rdfs:subClassOf ngm:shader-language ;
    rdfs:subClassOf _:r20697 ;
    rdfs:subClassOf _:r20698 ;
    rdfs:subClassOf _:r20699 ;
