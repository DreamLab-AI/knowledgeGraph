ngm:argo-blockchain a owl:Class ;
    rdfs:label "Argo Blockchain"@en ;
    rdfs:comment "Argo Blockchain is a publicly listed cryptocurrency mining company that operates data centres performing the hashing that secures proof-of-work networks, chiefly Bitcoin."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:bitcoin-proof-of-work-protocol-mining ],
        ngm:bitcoin-proof-of-work-protocol-mining ;
    vc:enables ngm:bitcoin-proof-of-work-protocol ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:bitcoin-proof-of-work-protocol-mining ;
    vc:slug "argo-blockchain" ;
    vc:sourceDomain "metaverse" .

ngm:attention-mechanisms a owl:Class ;
    rdfs:label "Attention Mechanisms"@en ;
    rdfs:comment "Attention mechanisms let a neural network weight different parts of its input when computing a representation, focusing on the most relevant elements. They are the core component of transformer architectures."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:neural-network ],
        ngm:attention-mechanism ;
    vc:enables ngm:multi-head-attention,
        ngm:transformer ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:neural-network ;
    vc:slug "attention-mechanisms" ;
    vc:sourceDomain "machine-learning" .

ngm:audit-readiness a owl:Class ;
    rdfs:label "Audit Readiness"@en ;
    rdfs:comment "Audit Readiness is the state in which an organization maintains the evidence, controls, documentation, and traceability needed to pass a compliance or security audit at any time with minimal preparation. It involves continuously capturing logs, change records, policy attestations, and control-effectiveness proof mapped to specific regulatory or standards requirements. Sustained readiness shifts auditing from a disruptive periodic scramble to an ongoing, verifiable posture."@en ;
    rdfs:subClassOf ngm:regulatory-compliance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:compliance,
        ngm:regulatory-compliance ;
    vc:slug "audit-readiness" ;
    vc:sourceDomain "governance" .

ngm:authorised-representative a owl:Class ;
    rdfs:label "Authorised Representative"@en ;
    rdfs:comment "A natural or legal person located or established in the EU who has received and accepted a written mandate from a non-EU provider of an AI system or general-purpose AI model to perform regulatory tasks on its behalf, including maintaining technical documentation, cooperating with market surveillance authorities, and serving as the primary EU contact point under the EU AI Act."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:eu-ai-act-regulatory-instrument ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:compliance-framework ],
        ngm:sc-governance-and-safety ;
    skos:broader ngm:sc-governance-and-safety ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:relatedTo ngm:privacy,
        ngm:risk-management ;
    vc:requires ngm:compliance-framework,
        ngm:eu-ai-act-regulatory-instrument ;
    vc:slug "authorised-representative" ;
    vc:sourceDomain "spatial-computing" ;
    vc:standardizedBy ngm:governance-framework ;
    vc:supports ngm:ai-governance-and-ethics,
        ngm:governance .

ngm:auto-gpt a owl:Class ;
    rdfs:label "AutoGPT"@en ;
    rdfs:comment "AutoGPT is an open-source application that chains language model calls to pursue a high-level goal with limited human input. It was an early demonstration of autonomous agents that plan, act and use tools in a loop."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:language-model ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:tool-use ],
        ngm:autonomous-agent ;
    vc:enables ngm:agentic-workflow ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:language-model,
        ngm:tool-use ;
    vc:slug "auto-gpt" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:automated-summarization a owl:Class ;
    rdfs:label "Automated Summarization"@en ;
    rdfs:comment "Automated Summarization is an NLP task in which a system produces a condensed representation of one or more source documents that preserves salient information and is significantly shorter than the original. Extractive approaches select and concatenate verbatim sentences or passages from the source; abstractive approaches generate novel text that may paraphrase, fuse, or infer content not explicitly stated in the source. Modern large language model-based summarizers are predominantly abstractive, achieving strong performance on long-form documents, meeting transcripts, scientific papers, and news articles, but remain susceptible to hallucination, factual inconsistency, and salience mismatch relative to the reader's intent."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:transformer-architecture ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:language-modeling ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:large-language-models ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:natural-language-understanding ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:text-generation ],
        ngm:ai-application,
        ngm:natural-language-processing ;
    skos:broader ngm:ai-application ;
    vc:bridgesTo ngm:meeting-recording ;
    vc:enables ngm:documentation-generation,
        ngm:knowledge-base,
        ngm:meeting-ai-assistant ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:language-modeling,
        ngm:text-generation ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:knowledge-graph-construction,
        ngm:meeting-transcription,
        ngm:question-answering,
        ngm:sentiment-analysis ;
    vc:requires ngm:large-language-models,
        ngm:natural-language-understanding,
        ngm:transformer-architecture ;
    vc:slug "automated-summarization" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:information-retrieval,
        ngm:retrieval-augmented-generation .

ngm:automatic-1111-web-ui a owl:Class ;
    rdfs:label "AUTOMATIC1111 WebUI"@en ;
    rdfs:comment "AUTOMATIC1111 WebUI is an open-source browser interface for running Stable Diffusion image models locally. It exposes generation, image-to-image, inpainting and extension features through a web front end."@en ;
