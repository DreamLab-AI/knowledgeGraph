    vc:slug "image-editing" ;
    vc:sourceDomain "media" ;
    vc:uses ngm:computer-vision,
        ngm:diffusion-model,
        ngm:generative-ai .

ngm:image-sensor a owl:Class ;
    rdfs:label "Image Sensor"@en ;
    rdfs:comment "An image sensor is a solid-state device that converts incident light into electrical signals to capture a digital image, typically implemented as a CMOS or CCD array of photodetector pixels. Each pixel accumulates charge proportional to received photons, which is read out, digitised, and assembled into a frame. Image sensors are the core capture element in cameras and many computer-vision and tracking systems."@en ;
    rdfs:subClassOf ngm:sensor ;
    vc:enables ngm:eye-tracking ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:camera ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:slug "image-sensor" ;
    vc:sourceDomain "robotics" .

ngm:immersive-audio a owl:Class ;
    rdfs:label "Immersive Audio"@en ;
    rdfs:comment "Immersive audio refers to audio reproduction and processing technologies that create a convincing three-dimensional sound field, enveloping the listener in a spatially accurate sonic environment. It encompasses object-based audio formats, binaural rendering, ambisonics, and head-related transfer function (HRTF) personalisation, enabling the perception of sounds positioned above, below, and around the listener rather than confined to a flat stereo plane."@en ;
    rdfs:subClassOf ngm:audio-technology ;
    vc:enables ngm:extended-reality-xr,
        ngm:immersive-experience-pipeline ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:audio-engine,
        ngm:audio-spatialization ;
    vc:slug "immersive-audio" ;
    vc:sourceDomain "spatial" ;
    vc:uses ngm:audio-processing,
        ngm:binaural-rendering,
        ngm:spatial-audio .

ngm:immersive-computing a owl:Class ;
    rdfs:label "Immersive Computing"@en ;
    rdfs:comment "Immersive computing is the broad discipline of designing and operating computing systems that surround users with synthetic or blended sensory environments — encompassing virtual reality, augmented reality, and mixed reality — to create a subjective sense of presence within a digitally mediated space. It integrates real-time 3D rendering, spatial tracking, haptic feedback, and multi-modal interaction to replace or augment the user's natural perceptual field."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:augmented-reality ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:immersive-experience ],
        ngm:extended-reality ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:augmented-reality,
        ngm:immersive-experience ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:immersive-collaboration,
        ngm:spatial-computing ;
    vc:slug "immersive-computing" ;
    vc:sourceDomain "metaverse" ;
    vc:uses ngm:3-d-rendering .

ngm:impact-metrics a owl:Class ;
    rdfs:label "Impact Metrics"@en ;
    rdfs:comment "Impact metrics are quantitative and qualitative indicators used to measure the social, environmental, or economic outcomes produced by an intervention, project, or organisation. They translate a theory of change into measurable outputs, outcomes, and longer-term impacts, enabling comparison, accountability, and decision-making. Standardised metric catalogues such as IRIS+ promote comparability across programmes."@en ;
    rdfs:subClassOf ngm:evaluation-metric ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:social-impact-assessment-sia ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:climate-action-dao ;
    vc:slug "impact-metrics" ;
    vc:sourceDomain "governance" .

ngm:industrial-manipulation a owl:Class ;
    rdfs:label "Industrial Manipulation"@en ;
    rdfs:comment "Industrial Manipulation refers to the robotic discipline and practice of using articulated robot arms and end-effectors to physically interact with objects in manufacturing, assembly, logistics, and processing environments, performing tasks such as pick-and-place, assembly, welding, painting, and material handling at production scale with repeatability and precision exceeding human capability. It encompasses the full kinematic and dynamic modelling of robot mechanisms, trajectory planning, force and torque control, and the integration of sensing for adaptive behaviour in structured industrial settings. Industrial manipulation robots are among the most economically significant deployed robotics systems, forming the backbone of automotive, electronics, and consumer goods production worldwide."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:end-effector ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:actuator ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:kinematics ],
        ngm:manipulation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:actuator,
        ngm:end-effector,
        ngm:kinematics ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:industrial-robot,
        ngm:manufacturing-automation ;
    vc:slug "industrial-manipulation" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:force-control,
        ngm:inverse-kinematics,
        ngm:motion-planning .

ngm:industrial-robotics a owl:Class ;
    rdfs:label "Industrial Robotics"@en ;
    rdfs:comment "Industrial robotics is the application of programmable robots to manufacturing tasks such as assembly, welding, handling and inspection."@en ;
