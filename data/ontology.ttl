        ngm:risk-management ;
    vc:uses ngm:bayesian-inference,
        ngm:causal-reasoning .

ngm:dense-retrieval a owl:Class ;
    rdfs:label "Dense Retrieval"@en ;
    rdfs:comment "Dense retrieval is an information-retrieval method that encodes queries and documents into dense vector embeddings and ranks results by vector similarity rather than lexical term overlap. A learned bi-encoder maps text into a shared semantic space so that conceptually related items are close even without shared keywords. It underpins semantic search and retrieval-augmented generation, often paired with approximate nearest-neighbour indexes for scale."@en ;
    rdfs:subClassOf ngm:information-retrieval ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:embedding-search,
        ngm:semantic-search ;
    vc:slug "dense-retrieval" ;
    vc:sourceDomain "ai" .

ngm:depth-buffer a owl:Class ;
    rdfs:label "Depth Buffer"@en ;
    rdfs:comment "A depth buffer (also called a z-buffer) is a per-pixel array maintained during rasterised rendering that stores the depth of the nearest surface drawn at each screen position. As fragments are generated, their interpolated depth is compared against the stored value, and only fragments closer to the camera overwrite the colour and depth, resolving visibility automatically. The depth buffer is the standard hidden-surface-removal mechanism in real-time graphics pipelines."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:texture-mapping ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gpu ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:rasterization ],
        ngm:rendering-pipeline ;
    vc:contrastsWith ngm:ray-tracing ;
    vc:enables ngm:occlusion-culling ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:texture-mapping ;
    vc:isPartOf ngm:graphics-pipeline,
        ngm:rendering-pipeline ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:gpu,
        ngm:spatial-computing,
        ngm:texture-mapping ;
    vc:requires ngm:gpu,
        ngm:rasterization ;
    vc:slug "depth-buffer" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:computer-graphics ;
    vc:uses ngm:gpu-acceleration .

ngm:did-resolver a owl:Class ;
    rdfs:label "DID Resolver"@en ;
    rdfs:comment "A DID resolver is a component that takes a Decentralized Identifier (DID) and returns its associated DID document containing public keys, verification methods, and service endpoints. It implements the W3C DID Resolution specification, dispatching to method-specific drivers (e.g. did:web, did:ion, did:key) to locate and verify the document. Resolvers are the lookup layer that makes DIDs actionable for authentication and credential exchange."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:did-method ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:did-method ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:verifiable-data-registry ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:did-document ],
        ngm:digital-identity ;
    vc:bridgesTo ngm:smart-contract,
        ngm:web-of-trust ;
    vc:contrastsWith ngm:certificate-authority,
        ngm:dns-resolver ;
    vc:dependsOn ngm:distributed-ledger-technology,
        ngm:dns,
        ngm:public-key-infrastructure ;
    vc:enables ngm:decentralized-authentication,
        ngm:self-sovereign-identity,
        ngm:verifiable-credentials ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:did-document,
        ngm:did-method ;
    vc:implements ngm:did-resolution,
        ngm:w-3-c-did-core-specification ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:decentralized-identifiers,
        ngm:decentralized-identity-did,
        ngm:identity-verification ;
    vc:requires ngm:did-method,
        ngm:verifiable-data-registry ;
    vc:slug "did-resolver" ;
    vc:sourceDomain "security" ;
    vc:standardizedBy ngm:w3-c ;
    vc:uses ngm:cryptographic-key-pair,
        ngm:json-data-interchange-format-ld .

ngm:discrete-logarithm-problem a owl:Class ;
    rdfs:label "Discrete Logarithm Problem"@en ;
    rdfs:comment "The discrete logarithm problem (DLP) is the computational task of finding the integer exponent x given a generator g and the value g^x within a finite cyclic group such as a multiplicative group modulo a prime or the point group of an elliptic curve. It is widely believed to be intractable for classical computers when the group is suitably large, and this presumed hardness underpins much of public-key cryptography. The elliptic-curve variant (ECDLP) offers equivalent security with smaller keys than the finite-field variant."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptographic-protocol ],
        ngm:cryptography ;
    vc:bridgesTo ngm:quantum-computing ;
    vc:contrastsWith ngm:rsa ;
    vc:dependsOn ngm:cryptography ;
    vc:enables ngm:asymmetric-cryptography,
        ngm:digital-signature,
        ngm:public-key-cryptography ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:cryptographic-primitive ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:asymmetric-cryptography,
        ngm:cryptographic-primitive,
        ngm:digital-signature,
        ngm:elliptic-curve-cryptography ;
    vc:requires ngm:cryptographic-protocol ;
    vc:slug "discrete-logarithm-problem" ;
    vc:sourceDomain "security" ;
    vc:supports ngm:schnorr-signature ;
    vc:uses ngm:elliptic-curve-cryptography .

ngm:ed25519 a owl:Class ;
    rdfs:label "Ed25519"@en ;
    rdfs:comment "Ed25519 is a high-performance elliptic-curve digital signature scheme instantiated on the Twisted Edwards curve over the prime field GF(2^255-19), offering approximately 128 bits of security with deterministic signing and compact 64-byte signatures. Designed by Bernstein, Duif, Lange, Schwabe, and Yang, it is engineered to resist side-channel attacks through constant-time implementation properties and eliminates the weak-nonce vulnerabilities that affect ECDSA. Ed25519 is standardised in RFC 8032 and FIPS 186-5, and is widely deployed across blockchain networks, SSH authentication, TLS handshakes, and decentralised identity systems."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:public-key ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:private-key ],
        ngm:digital-signature ;
    vc:bridgesTo ngm:blockchain,
        ngm:nostr-protocol,
        ngm:verifiable-credential-vc ;
    vc:contrastsWith ngm:ecdsa,
        ngm:rsa ;
    vc:dependsOn ngm:hash-function,
        ngm:random-number-generation ;
    vc:enables ngm:authentication,
        ngm:non-repudiation,
        ngm:zero-knowledge-proof ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:implements ngm:elliptic-curve-cryptography,
        ngm:public-key-cryptography,
        ngm:schnorr-signature ;
    vc:isPartOf ngm:curve25519,
        ngm:twisted-edwards-curve ;
    vc:qualityScore "0.73"^^xsd:float ;
    vc:relatedTo ngm:post-quantum-cryptography,
        ngm:x25519 ;
    vc:requires ngm:private-key,
        ngm:public-key ;
    vc:slug "ed25519" ;
    vc:sourceDomain "security" ;
    vc:standardizedBy ngm:fips-186-5,
        ngm:rfc-8032 ;
    vc:supports ngm:decentralised-identity,
        ngm:verifiable-credential-vc .

ngm:edge-inference a owl:Class ;
    rdfs:label "Edge Inference"@en ;
    rdfs:comment "The execution of machine learning model inference on local edge devices rather than in centralised cloud infrastructure, close to where data is generated, enabling low-latency, privacy-preserving and bandwidth-efficient AI applications."@en ;
