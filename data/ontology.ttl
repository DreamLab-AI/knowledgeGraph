    vc:sourceDomain "robotics" ;
    vc:supports ngm:digital-twin,
        ngm:rapid-prototyping ;
    vc:uses ngm:3d-modelling .

ngm:computer-supported-cooperative-work a owl:Class ;
    rdfs:label "Computer-Supported Cooperative Work"@en ;
    rdfs:comment "Computer-Supported Cooperative Work (CSCW) is the interdisciplinary research field that studies how people work together using computer systems and how to design technology that supports their collaboration. It examines coordination, communication, awareness and the social organisation of group work across time and space, informing the design of groupware and collaborative tools. CSCW bridges human-computer interaction, the social sciences and distributed-systems engineering."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:awareness ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:presence ],
        ngm:distributed-collaboration ;
    skos:broader ngm:distributed-collaboration ;
    vc:bridgesTo ngm:human-computer-interaction ;
    vc:enables ngm:remote-collaboration,
        ngm:shared-workspace ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:awareness,
        ngm:presence ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:crdt,
        ngm:distributed-collaboration ;
    vc:slug "computer-supported-cooperative-work" ;
    vc:sourceDomain "distributed-collaboration" ;
    vc:supports ngm:collaboration,
        ngm:remote-work ;
    vc:uses ngm:synchronisation .

ngm:conflict-free-replicated-data-type a owl:Class ;
    rdfs:label "Conflict Free Replicated Data Type"@en ;
    rdfs:comment "A conflict-free replicated data type (CRDT) is a data structure that can be replicated across many nodes and updated independently, with mathematical guarantees that all replicas converge to the same state once they have exchanged updates. By designing operations to be commutative or merges to be monotonic, CRDTs avoid the need for coordination or central conflict resolution. They are a foundational technique for offline-first and real-time collaborative distributed systems."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:eventual-consistency ],
        ngm:eventual-consistency ;
    vc:bridgesTo ngm:distributed-system ;
    vc:contrastsWith ngm:operational-transformation ;
    vc:dependsOn ngm:concurrency,
        ngm:replication ;
    vc:enables ngm:conflict-resolution,
        ngm:operational-transformation,
        ngm:state-synchronisation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:eventual-consistency ;
    vc:isPartOf ngm:distributed-collaboration,
        ngm:distributed-system ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:concurrency,
        ngm:conflict-resolution,
        ngm:vector-clock ;
    vc:requires ngm:eventual-consistency ;
    vc:slug "conflict-free-replicated-data-type" ;
    vc:sourceDomain "distributed-collaboration" ;
    vc:supports ngm:distributed-collaboration,
        ngm:state-synchronisation ;
    vc:uses ngm:replication,
        ngm:vector-clock .

ngm:connectionism a owl:Class ;
    rdfs:label "Connectionism"@en ;
    rdfs:comment "Connectionism is an approach in cognitive science and artificial intelligence that models mental and computational phenomena as emergent from networks of simple, densely interconnected units whose collective activity, governed by weighted connections, gives rise to behaviour. It treats knowledge as distributed across connection strengths rather than stored as explicit symbols, and learning as the adjustment of those weights through experience. The paradigm provides the theoretical foundation for artificial neural networks and deep learning."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:neural-network ],
        ngm:cognitive-science ;
    vc:bridgesTo ngm:cognitive-science,
        ngm:machine-learning ;
    vc:contrastsWith ngm:symbolic-ai,
        ngm:symbolic-reasoning ;
    vc:enables ngm:deep-learning,
        ngm:machine-learning ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:neural-network ;
    vc:implements ngm:neural-network ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:artificial-general-intelligence,
        ngm:deep-learning,
        ngm:neural-network ;
    vc:slug "connectionism" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:artificial-intelligence ;
    vc:uses ngm:backpropagation,
        ngm:gradient-descent .

ngm:consistent-hashing a owl:Class ;
    rdfs:label "Consistent Hashing"@en ;
    rdfs:comment "Consistent hashing is a distribution technique that maps both data keys and storage nodes onto the same circular hash space, so that each key is assigned to the next node encountered clockwise on the ring. When a node joins or leaves, only the keys in its immediate neighbourhood are remapped rather than the entire key space, minimising data movement. Virtual nodes are commonly used to smooth load distribution across heterogeneous servers."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:hash-function ],
        ngm:distributed-hash-table ;
    vc:enables ngm:fault-tolerance,
        ngm:scalability,
        ngm:sharding ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:implements ngm:data-partitioning,
        ngm:load-balancing ;
    vc:isPartOf ngm:distributed-hash-table ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:distributed-systems,
        ngm:node,
        ngm:peer-to-peer-network ;
    vc:requires ngm:hash-function ;
    vc:slug "consistent-hashing" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:caching,
        ngm:load-balancing ;
    vc:uses ngm:data-partitioning,
        ngm:hash-function .

ngm:constrained-decoding a skos:Concept ;
    rdfs:label "Constrained Decoding"@en .

ngm:constraint-specification a owl:Class ;
    rdfs:label "Constraint Specification"@en ;
    rdfs:comment "A constraint specification is a formal statement of the limits and conditions a control system or plan must satisfy, such as joint limits, actuator bounds, obstacle avoidance, and safety envelopes. It is supplied to control and optimisation algorithms so that generated commands remain feasible and safe. Precise constraint specification is essential for model-based and optimisation-based control design."@en ;
    rdfs:subClassOf ngm:control-theory ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:control-algorithm,
        ngm:model-based-control ;
    vc:slug "constraint-specification" ;
    vc:sourceDomain "robotics" .

ngm:context-aware-computing a owl:Class ;
    rdfs:label "Context Aware Computing"@en ;
    rdfs:comment "Context Aware Computing is a paradigm in which systems automatically adapt their behaviour based on contextual signals such as the user's location, activity, device state, social environment, and temporal cues. In spatial computing and XR applications, context awareness allows virtual overlays and services to respond intelligently to physical surroundings, enabling location-sensitive AR, adaptive user interfaces, and personalised immersive experiences."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:internet-of-things ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:sensor-fusion ],
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:bridgesTo ngm:computer-vision,
        ngm:scene-understanding ;
    vc:enables ngm:augmented-reality,
        ngm:immersive-experience,
        ngm:user-experience ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:internet-of-things,
        ngm:sensor-fusion ;
    vc:slug "context-aware-computing" ;
    vc:sourceDomain "spatial-computing" .

ngm:control-law a owl:Class ;
    rdfs:label "Control Law"@en ;
    rdfs:comment "A control law is the mathematical rule that maps measured system state and reference signals to the control inputs applied to a plant. It is the algorithmic core of a feedback controller, expressed as functions such as PID, state feedback, or impedance laws. The choice of control law determines stability, tracking accuracy, and disturbance rejection of the closed-loop system."@en ;
    rdfs:subClassOf ngm:control-theory ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:force-control,
        ngm:position-control ;
    vc:slug "control-law" ;
    vc:sourceDomain "robotics" .

ngm:coordinate-reference-system a owl:Class ;
    rdfs:label "Coordinate Reference System"@en ;
    rdfs:comment "A coordinate reference system (CRS) is a framework that defines how positions are described and measured on or near the Earth's surface, combining a datum, a coordinate system, and often a map projection. It enables consistent interpretation of spatial coordinates by anchoring them to a known model of the Earth. CRSs are essential for aligning geospatial data sets and for accurate location computations."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:geospatial-data ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:geospatial-data ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gps ],
        ngm:geospatial-data ;
    vc:bridgesTo ngm:spatial-computing ;
    vc:dependsOn ngm:geospatial-data ;
    vc:enables ngm:geographic-information-system,
        ngm:spatial-computing ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:geospatial-data ;
    vc:isPartOf ngm:geospatial-data ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:geographic-information-system,
        ngm:spatial-computing ;
    vc:requires ngm:geospatial-data,
        ngm:gps ;
    vc:slug "coordinate-reference-system" ;
    vc:sourceDomain "spatial-computing" ;
    vc:standardizedBy ngm:standards ;
    vc:supports ngm:geographic-information-system ;
    vc:uses ngm:gps .

ngm:cpu-computing a owl:Class ;
    rdfs:label "CPU Computing"@en ;
    rdfs:comment "CPU computing is the execution of computational workloads on a general-purpose central processing unit, which performs instructions sequentially across a small number of high-clock cores optimised for low latency and complex control flow. It excels at branch-heavy, irregular, and serial tasks but contrasts with the massively parallel throughput model of GPU computing. CPUs follow a stored-program architecture with deep cache hierarchies, out-of-order execution, and rich instruction sets."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:cpu ],
        ngm:parallel-computing ;
    vc:bridgesTo ngm:gpu ;
    vc:contrastsWith ngm:gpu-computing ;
    vc:dependsOn ngm:integrated-circuit ;
    vc:enables ngm:hardware-acceleration ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:cpu ;
    vc:isPartOf ngm:hardware ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:graphics-processing-unit,
        ngm:parallel-computing ;
    vc:requires ngm:semiconductor ;
    vc:slug "cpu-computing" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:compute-shader ;
    vc:uses ngm:central-processing-unit,
        ngm:instruction-set-architecture .

ngm:creative-industries a owl:Class ;
    rdfs:label "Creative Industries"@en ;
    rdfs:comment "The creative industries are the economic sectors that generate value primarily from individual creativity, skill, and intellectual property, spanning design, fashion, film, music, gaming, advertising, architecture, and publishing. They combine cultural production with commercial distribution and are increasingly reshaped by generative AI tooling. As an economic domain they constitute a significant employer and exporter of cultural goods — contributing £124 billion in gross value added to the UK economy in 2023 — while simultaneously representing the sector most affected by unresolved questions of copyright, training data use, and AI-enabled labour displacement."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:digital-content-creation ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:advertising ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:licensing ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:game-development ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:copyright ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:fashion ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-governance ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:intellectual-property-rights-framework ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:music-generation ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:film-production ],
        ngm:economics,
        ngm:knowledge-economy ;
    vc:bridgesTo ngm:augmented-reality,
        ngm:digital-twin,
        ngm:metaverse ;
    vc:enables ngm:content-creation,
        ngm:cultural-heritage,
        ngm:platform-economy ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:advertising,
        ngm:design,
        ngm:digital-content-creation,
        ngm:fashion,
        ngm:film-production,
        ngm:game-development,
        ngm:music-generation,
        ngm:publishing ;
    vc:qualityScore "0.9"^^xsd:float ;
    vc:relatedTo ngm:ai-companies,
        ngm:ai-ethics,
        ngm:ai-regulation,
        ngm:freelance-economy,
        ngm:human-ai-collaboration,
        ngm:nft,
        ngm:synthetic-media ;
    vc:requires ngm:copyright,
        ngm:data-governance,
        ngm:intellectual-property-rights-framework,
        ngm:licensing ;
    vc:slug "creative-industries" ;
    vc:sourceDomain "economics" ;
    vc:supports ngm:knowledge-economy ;
    vc:uses ngm:creative-ai,
        ngm:creative-software,
        ngm:diffusion-model,
        ngm:foundation-model,
        ngm:generative-ai,
        ngm:large-language-models .

ngm:cross-metaverse-commerce a owl:Class ;
    rdfs:label "Cross Metaverse Commerce"@en ;
    rdfs:comment "Economic activities and transactions that span multiple metaverse platforms and virtual worlds, enabled by interoperability standards, blockchain-based digital assets, and unified digital identity systems that allow users to buy, sell, trade, and transfer value seamlessly across different virtual..."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:blockchain-infrastructure ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:digital-wallet ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:interoperability-standard ],
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:bridgesTo ngm:virtual-economy ;
    vc:enables ngm:asset-portability ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:blockchain-infrastructure,
        ngm:digital-wallet,
        ngm:interoperability-standard ;
    vc:slug "cross-metaverse-commerce" ;
    vc:sourceDomain "spatial-computing" .

ngm:crowdfunding a owl:Class ;
    rdfs:label "Crowdfunding"@en ;
    rdfs:comment "Crowdfunding is a financing model in which a project or venture raises capital from a large number of contributors, each providing a relatively small amount, typically through an online platform. Models range from donation and reward-based campaigns to equity and debt offerings, and blockchain variants use token sales to distribute ownership or utility rights. The approach broadens access to early-stage capital while distributing risk across many backers."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:tokenomics ],
        ngm:decentralised-finance ;
    vc:bridgesTo ngm:ico,
        ngm:initial-coin-offering,
        ngm:security-token-offering ;
    vc:contrastsWith ngm:venture-capital ;
    vc:enables ngm:token-distribution ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:smart-contract ;
    vc:isPartOf ngm:decentralised-finance ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:dao,
        ngm:decentralised-finance,
        ngm:ico,
        ngm:venture-capital ;
    vc:requires ngm:tokenomics ;
    vc:slug "crowdfunding" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:decentralised-finance ;
    vc:uses ngm:smart-contract,
        ngm:token-distribution,
        ngm:tokenomics .

ngm:crypto-trading a owl:Class ;
    rdfs:label "Crypto Trading"@en ;
    rdfs:comment "Crypto trading is the buying and selling of cryptocurrencies and digital assets for profit, conducted on centralised exchanges, decentralised exchanges, and over-the-counter desks. It spans spot, margin, derivatives, and algorithmic strategies, with prices driven by liquidity, sentiment, and on-chain activity. It is a primary use case and liquidity source for the broader crypto-asset market."@en ;
    rdfs:subClassOf ngm:financial-services ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:kraken,
        ngm:tether ;
    vc:slug "crypto-trading" ;
    vc:sourceDomain "blockchain" .

ngm:cryptoasset-regulation a owl:Class ;
    rdfs:label "Cryptoasset Regulation"@en ;
    rdfs:comment "Cryptoasset regulation is the body of laws, supervisory rules, and policy frameworks governing the issuance, custody, trading, and use of digital assets such as cryptocurrencies, stablecoins, and tokenised securities. It applies traditional financial-services objectives, consumer protection, market integrity, financial stability, and the prevention of money laundering and terrorist financing, to crypto-native business models. Landmark regimes include the EU Markets in Crypto-Assets regulation and the UK's phased approach led by the Financial Conduct Authority and HM Treasury, alongside global standards from the Financial Action Task Force such as the travel rule."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:anti-money-laundering ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:kyc ],
        ngm:regulation ;
    vc:bridgesTo ngm:blockchain ;
    vc:contrastsWith ngm:monetary-policy ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:implements ngm:markets-in-crypto-assets,
        ngm:travel-rule ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:central-bank,
        ngm:institutional-trust ;
    vc:requires ngm:anti-money-laundering,
        ngm:kyc ;
    vc:slug "cryptoasset-regulation" ;
    vc:sourceDomain "finance" ;
    vc:supports ngm:financial-stability,
        ngm:risk-management ;
    vc:uses ngm:governance .

ngm:cryptographic-library a owl:Class ;
    rdfs:label "Cryptographic Library"@en ;
    rdfs:comment "A cryptographic library is a software package that implements cryptographic primitives and protocols — encryption, hashing, signing, key exchange, and random-number generation — behind a programming interface that application developers can use without reimplementing the underlying mathematics. Well-designed libraries such as OpenSSL, libsodium, BoringSSL, and the Rust RustCrypto suite emphasise constant-time implementations, safe defaults, and resistance to misuse. The correctness and side-channel resistance of these libraries is critical, since flaws propagate to every application that depends on them."@en ;
    rdfs:subClassOf ngm:cryptographic-protocol ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:digital-signature,
        ngm:encryption,
        ngm:hash-function ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:key-management ;
    vc:slug "cryptographic-library" ;
    vc:sourceDomain "security" ;
    vc:uses ngm:public-key-cryptography .

ngm:custodial-exchange a owl:Class ;
    rdfs:label "Custodial Exchange"@en ;
    rdfs:comment "A custodial exchange is a cryptocurrency trading venue that holds users' assets and private keys on their behalf, settling trades on its internal ledger rather than on-chain. Users gain convenience, liquidity and familiar account-based access, but cede control of their keys and accept counterparty risk in the operator. It is the centralised counterpart to non-custodial and decentralised trading models."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:know-your-customer ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:custodial-wallet ],
        ngm:cryptocurrency-exchange ;
    vc:contrastsWith ngm:decentralized-exchange,
        ngm:self-custody ;
    vc:dependsOn ngm:regulatory-compliance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:proof-of-reserve ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:centralized-exchange,
        ngm:digital-asset-custody,
        ngm:qualified-custodian,
        ngm:wallet ;
    vc:requires ngm:custodial-wallet,
        ngm:know-your-customer ;
    vc:slug "custodial-exchange" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:liquidity ;
    vc:uses ngm:cold-storage,
        ngm:custody .

ngm:customer-support-automation a owl:Class ;
    rdfs:label "Customer Support Automation"@en ;
    rdfs:comment "Customer Support Automation (CSA-Support) is the application of artificial intelligence, natural language processing, and workflow orchestration to the technical and post-sale support domain, automatically handling customer enquiries, diagnosing faults, routing and resolving service tickets, and delivering self-service resolution pathways through chatbots, virtual agents, and agentic AI systems. It specialises the broader Customer Service Automation domain toward helpdesk operations, IT service management, and product support contexts, integrating with ticketing platforms, knowledge bases, diagnostic APIs, and CRM systems to achieve autonomous first-line resolution of technical and product queries at scale."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:intent-classification ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:knowledge-base ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:dialogue-systems ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:chatbot ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:natural-language-understanding ],
        ngm:conversational-ai,
        ngm:customer-service-automation ;
    vc:dependsOn ngm:dialogue-management,
        ngm:robotic-process-automation,
        ngm:workflow-automation ;
    vc:enables ngm:intelligent-ticket-routing,
        ngm:omnichannel,
        ngm:self-service-portal ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.9"^^xsd:float ;
    vc:relatedTo ngm:ai-agent,
        ngm:business-process-automation,
        ngm:customer-service-automation ;
    vc:requires ngm:chatbot,
        ngm:dialogue-systems,
        ngm:intent-classification,
        ngm:knowledge-base,
        ngm:natural-language-understanding ;
    vc:slug "customer-support-automation" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:active-learning,
        ngm:agentic-rag,
        ngm:large-language-model,
        ngm:named-entity-recognition,
        ngm:natural-language-processing,
        ngm:retrieval-augmented-generation,
        ngm:sentiment-analysis,
        ngm:transformer-architecture .

ngm:cybersecurity-framework a owl:Class ;
    rdfs:label "Cybersecurity Framework"@en ;
    rdfs:comment "A cybersecurity framework is a structured set of standards, guidelines and practices that organisations use to identify, protect against, detect, respond to and recover from cyber threats. Frameworks such as the NIST Cybersecurity Framework provide a common taxonomy and maturity model for managing security risk in a repeatable, auditable way. They align technical controls with governance, risk management and regulatory obligations."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:incident-reporting ],
        ngm:security-framework ;
    vc:bridgesTo ngm:compliance-framework,
        ngm:risk-management-framework ;
    vc:contrastsWith ngm:compliance-framework ;
    vc:dependsOn ngm:risk-management ;
    vc:enables ngm:ai-trustworthiness ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:implements ngm:risk-management ;
    vc:isPartOf ngm:security-framework ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:nist-ai-risk-management-framework,
        ngm:nist-cybersecurity-framework ;
    vc:requires ngm:incident-reporting ;
    vc:slug "cybersecurity-framework" ;
    vc:sourceDomain "governance" ;
    vc:standardizedBy ngm:nist-cybersecurity-framework ;
    vc:supports ngm:compliance-framework,
        ngm:gdpr-compliance ;
    vc:uses ngm:zero-trust-architecture .

ngm:cylindrical-robot a owl:Class ;
    rdfs:label "Cylindrical Robot"@en ;
    rdfs:comment "Cylindrical robot employs one rotary joint (azimuth) and two prismatic joints (radial and vertical) that produce a cylindrical workspace, enabling efficient reach over rectangular work envelopes."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:actuators ],
        ngm:robo-actuation-and-control,
        ngm:robo-robot-type ;
    skos:broader ngm:robo-actuation-and-control,
