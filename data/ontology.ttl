ngm:risk-register a owl:Class ;
    rdfs:comment "A risk register is a structured record that captures identified risks together with their description, likelihood, impact, ownership, mitigation actions and current status. It serves as the central artefact of a risk management process, enabling organisations to track, prioritise and report on risks over time. The register supports governance by making risk exposure visible and accountable to decision-makers."@en ;
    rdfs:label "Risk Register"@en ;
    rdfs:subClassOf ngm:risk-management ;
