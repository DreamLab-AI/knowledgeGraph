ngm:3-d-modeling a owl:Class ;
    rdfs:label "3D Modeling"@en ;
    rdfs:comment "3D Modeling is the artistic and technical discipline of creating three-dimensional digital forms using specialised software tools, encompassing polygonal modeling, digital sculpting, procedural generation, and CAD techniques to produce assets for animation, rendering, games, and immersive environments."@en ;
