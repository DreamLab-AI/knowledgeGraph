ngm:mas a owl:Class ;
    rdfs:label "MAS"@en ;
    rdfs:comment "A Multi-Agent System (MAS) is a computational framework composed of multiple interacting autonomous agents that perceive their environment and act to achieve individual or collective goals. Each agent maintains local knowledge, reasoning capabilities, and the ability to communicate with peers, enabling emergent collective intelligence without centralised control. MAS architectures address problems that are too complex, distributed, or dynamic for monolithic solutions, drawing on distributed AI, game theory, and coordination theory. The paradigm spans reactive swarm systems, deliberative BDI agents, and modern LLM-orchestrated agentic pipelines."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:agent-communication-language ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:communication-protocol ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:coordination-mechanisms ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:autonomous-agent ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:distributed-computing ],
        ngm:ai-agent-system ;
    vc:bridgesTo ngm:decentralised-autonomous-organisation,
        ngm:large-language-model ;
    vc:contrastsWith ngm:control-system,
        ngm:monolithic-ai ;
    vc:enables ngm:collective-intelligence,
        ngm:decentralized-swarm-control,
        ngm:emergent-behavior,
        ngm:participant-coordination ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:agent-communication-language,
        ngm:autonomous-agent,
        ngm:coordination-mechanisms ;
    vc:implements ngm:fipa-standard,
        ngm:game-theory ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:agent-based-modelling,
        ngm:distributed-artificial-intelligence,
        ngm:swarm-robotics ;
    vc:requires ngm:communication-protocol,
        ngm:distributed-computing ;
    vc:slug "mas" ;
    vc:sourceDomain "ai" ;
    vc:supports ngm:agentic-pipeline,
        ngm:multi-agent-reinforcement-learning ;
    vc:uses ngm:belief-desire-intention,
        ngm:consensus-mechanism,
        ngm:contract-net-protocol,
        ngm:reinforcement-learning .

ngm:materials-science a skos:Concept ;
    rdfs:label "Materials Science"@en .

ngm:math-library a owl:Class ;
    rdfs:label "Math Library"@en ;
    rdfs:comment "A Math Library is a software library providing optimised implementations of mathematical operations — including vector and matrix arithmetic, quaternion transformations, geometric queries, interpolation, and numerical methods — that underpin real-time 3D graphics, physics simulation, and spatial computing systems. These libraries abstract hardware-level SIMD optimisations and GPU-friendly data layouts, enabling physics engines, rendering pipelines, and game engines to perform high-throughput computation at interactive frame rates."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:quaternion-math ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:coordinate-system ],
        ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:bridgesTo ngm:software-library ;
    vc:enables ngm:compute-shader,
        ngm:fluid-simulation,
        ngm:physics-engine,
        ngm:physics-simulation ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:gpu-compute,
        ngm:graphics-library,
        ngm:noise-function-library,
        ngm:spatial-coordinates ;
    vc:requires ngm:coordinate-system,
        ngm:quaternion-math ;
    vc:slug "math-library" ;
    vc:sourceDomain "spatial-computing" .

ngm:media-authenticity a owl:Class ;
    rdfs:label "Media Authenticity"@en ;
    rdfs:comment "Media authenticity is the property and practice of establishing that a piece of digital media is genuine, unaltered, and accurately attributed to its source. It combines cryptographic provenance metadata, watermarking, and forensic analysis to distinguish authentic recordings from synthetic or manipulated content. As generative models make convincing synthetic media inexpensive, media authenticity has become central to combating disinformation and preserving trust in visual and audio evidence."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:content-provenance ],
        [ a owl:Restriction ;
