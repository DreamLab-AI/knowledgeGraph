ngm:staking a owl:Class ;
    rdfs:label "Staking"@en ;
    rdfs:comment "The act of locking cryptocurrency as a stake to participate in a proof-of-stake network's validation process, earning rewards and risking penalties for misbehaviour. The staked amount aligns a validator's incentives with the network's correct operation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:validator ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:proof-of-stake ],
        ngm:proof-of-stake ;
    vc:enables ngm:network-security ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:proof-of-stake,
        ngm:validator ;
    vc:slug "staking" ;
    vc:sourceDomain "blockchain" .

