        ngm:gas,
        ngm:latency,
        ngm:network-protocol,
        ngm:sidechain ;
    vc:requires ngm:block,
        ngm:blockchain ;
    vc:slug "block-size" ;
    vc:sourceDomain "blockchain" ;
