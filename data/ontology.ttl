ngm:pyodide-rag-corpus-builder-script a owl:Class ;
    rdfs:comment "Python to build RAG data page is a Logseq Pyodide script that enumerates all pages with the `public:: true` property, loads their block content, applies text-cleaning routines (URL removal, bracket stripping, special-character normalisation), and appends the cleaned content to a dedicated FULLRAG page. This page then serves as the consolidated corpus for local Retrieval-Augmented Generation pipelines, enabling semantic search over the entire public knowledge graph without external data transfer."@en ;
    rdfs:label "Pyodide RAG Corpus Builder Script"@en ;
