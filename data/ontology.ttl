    vc:qualityScore "0.35"^^xsd:float ;
    vc:slug "spatial-computing-system" ;
    vc:sourceDomain "spatial-computing" .

ngm:spatial-coordinates a owl:Class ;
    rdfs:label "Spatial Coordinates"@en ;
    rdfs:comment "A unified reference frame system for positioning objects in three-dimensional virtual or mixed reality environments, including geographically-anchored poses (GeoPose) tied to Earth coordinates and local coordinate systems for scene-relative object placement with support for coordinate transformat..."@en ;
    rdfs:subClassOf ngm:coordinate-system,
        ngm:sc-standards-and-interop ;
    skos:broader ngm:sc-standards-and-interop ;
    vc:enables ngm:object-positioning ;
