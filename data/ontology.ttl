ngm:proprioceptive-sensing a owl:Class ;
    rdfs:label "Proprioceptive Sensing"@en ;
    rdfs:comment "Proprioceptive sensing is a robot's perception of its own internal state, such as joint angles, motor torques, link velocities, and body orientation, as distinct from exteroceptive sensing of the external environment. It relies on encoders, force/torque sensors, and inertial measurement units. It is essential for balance, whole-body control, and safe interaction, especially in legged and humanoid robots."@en ;
    rdfs:subClassOf ngm:robo-perception ;
    skos:broader ngm:robo-perception ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:humanoid-robot,
        ngm:mechanical-component ;
    vc:slug "proprioceptive-sensing" ;
    vc:sourceDomain "robotics" .

ngm:proteus-effect a owl:Class ;
    rdfs:label "Proteus Effect"@en ;
    rdfs:comment "The Proteus Effect is the phenomenon whereby the visual characteristics of a user's digital avatar unconsciously shape that user's own behaviour, attitudes, and self-perception within virtual environments. Named after the shape-shifting Greek deity, it was empirically demonstrated by Yee and Bailenson (2007): users assigned taller or more attractive avatars exhibited corresponding shifts in confidence and social openness, while users embodying outgroup avatars showed reduced implicit bias. The effect arises through the intersection of self-perception theory, stereotype activation, and embodied cognition, and has direct implications for therapeutic applications, metaverse platform design, and ethical avatar-assignment practices."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:avatar ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:virtual-environment ],
        ngm:metaverse,
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:enables ngm:behavioral-modeling,
        ngm:immersive-experience ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:avatar-customization,
        ngm:embodied-ai,
        ngm:social-presence,
        ngm:vr-psychology ;
    vc:requires ngm:avatar,
        ngm:virtual-environment ;
    vc:slug "proteus-effect" ;
    vc:sourceDomain "spatial-computing" .

