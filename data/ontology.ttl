        ngm:ecdsa,
        ngm:key-pair,
        ngm:knowledge-graph-publication-classifier-key,
        ngm:private-key ;
    vc:implements ngm:diffie-hellman-key-exchange,
        ngm:knowledge-graph-publication-classifier-key-infrastructure,
        ngm:tls-protocol ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:certificate-authority,
        ngm:post-quantum-cryptography,
        ngm:zero-knowledge-proof ;
    vc:requires ngm:hash-function,
