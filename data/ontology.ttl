ngm:chain-of-thought a owl:Class ;
    rdfs:label "Chain of Thought"@en ;
    rdfs:comment "Chain-of-Thought (CoT) prompting is a technique for eliciting explicit intermediate reasoning steps from autoregressive large language models before producing a final answer, substantially improving accuracy on arithmetic, symbolic, commonsense, and multi-hop reasoning tasks. The mechanism exploits the sequential token-generation process of transformer-based models: each generated reasoning token conditions all subsequent tokens, enabling multi-step deductions that single-pass prompting cannot reliably perform. CoT encompasses a family of variants — few-shot exemplar CoT, zero-shot CoT, self-consistency decoding, tree-of-thought search, and process reward modelling — collectively forming a foundational paradigm for inference-time compute scaling and complex reasoning in large language models."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:large-language-models ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:prompt-engineering ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:self-consistency ],
        ngm:prompt-engineering ;
    vc:bridgesTo ngm:search-algorithms,
        ngm:symbolic-ai ;
    vc:contrastsWith ngm:direct-answer-prompting,
        ngm:retrieval-augmented-generation,
        ngm:standard-prompting ;
    vc:dependsOn ngm:emergent-capabilities,
        ngm:model-scale ;
    vc:enables ngm:commonsense-reasoning,
        ngm:inference-time-compute-scaling,
        ngm:mathematical-reasoning,
        ngm:multi-hop-reasoning,
        ngm:reasoning ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:process-reward-model,
        ngm:self-consistency,
        ngm:tree-of-thought,
        ngm:zero-shot-chain-of-thought ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:ai-agent,
        ngm:planning,
        ngm:reinforcement-learning-from-human-feedback,
        ngm:scratchpad-reasoning ;
