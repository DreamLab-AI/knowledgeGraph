ngm:reality-capture-system a owl:Class ;
    rdfs:label "Reality Capture System"@en ;
    rdfs:comment "Physical hardware system comprising 3D scanners, LIDAR sensors, photogrammetry cameras, and associated equipment for acquiring spatial and visual data from real-world environments to create digital representations."@en ;
    rdfs:subClassOf ngm:spatial-computing ;
    vc:enables ngm:3-d-model-generation,
        ngm:digital-twin-creation,
        ngm:environment-reconstruction,
        ngm:visual-representation ;
    vc:hasPart ngm:3-d-scanner,
        ngm:depth-sensor,
        ngm:lidar-sensor,
        ngm:motion-capture-rig,
        ngm:photogrammetry-camera,
        ngm:point-cloud-processor,
        ngm:tracking-system ;
    vc:isPartOf ngm:digital-twin-creation-pipeline,
        ngm:virtual-production-workflow ;
    vc:maturity "established" ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:data-processing-hardware,
        ngm:spatial-calibration,
        ngm:storage-infrastructure ;
    vc:slug "reality-capture-system" ;
    vc:sourceDomain "spatial-computing" .

