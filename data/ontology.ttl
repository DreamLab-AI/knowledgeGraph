    vc:relatedTo ngm:rb-0103-collaborative-operation ;
    vc:relatedTo ngm:rb-0105-speed-and-separation-monitoring ;
    vc:requires ngm:rb-0055-velocity-control ;
    vc:requires ngm:rb-0072-encoder ;
    vc:slug "rb-0093-speed-limitation" ;
    vc:sourceDomain "robotics" ;
