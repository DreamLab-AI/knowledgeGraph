    vc:slug "validator-node" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:cryptographic-signature,
        ngm:schnorr-signature .

ngm:agent-frameworks a owl:Class ;
    rdfs:label "Agent Frameworks"@en ;
    rdfs:comment "Agent Frameworks are software libraries, runtimes, and orchestration platforms that compose large language models (LLMs) with tool-use, memory, planning, and inter-agent communication into autonomous or semi-autonomous systems capable of multi-step goal pursuit, encompassing single-agent harnesse..."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:tool-use ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:prompt-template ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:tool-registry ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:large-language-models ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:context-window ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:memory-store ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:agent-runtime ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:persistence-layer ],
        ngm:ai-infrastructure,
        ngm:llm-orchestration,
        ngm:workflow-engine ;
    vc:enables ngm:autonomous-coding,
        ngm:browser-automation,
        ngm:computer-use,
        ngm:conversational-ai,
        ngm:multi-agent-collaboration,
        ngm:scientific-discovery,
        ngm:tool-augmented-reasoning,
        ngm:workflow-automation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:agent-runtime,
        ngm:evaluator-module,
        ngm:executor-module,
        ngm:hook-system,
        ngm:memory-store,
        ngm:planner-module,
        ngm:prompt-template,
        ngm:state-graph,
        ngm:tool-registry,
        ngm:trace-logger ;
    vc:implements ngm:chain-of-thought,
        ngm:hierarchical-topology,
        ngm:mesh-topology,
        ngm:plan-and-execute-pattern,
        ngm:re-act-pattern,
        ngm:reflexion-pattern,
        ngm:self-consistency,
        ngm:toolformer-pattern,
        ngm:tree-of-thoughts ;
    vc:qualityScore "0.52"^^xsd:float ;
    vc:relatedTo ngm:agentic-ai,
        ngm:foundation-models,
        ngm:llm-evaluation,
        ngm:prompt-engineering,
        ngm:retrieval-augmented-generation,
        ngm:tool-use ;
    vc:requires ngm:context-window,
        ngm:inference-endpoint,
        ngm:large-language-models,
        ngm:observability-stack,
        ngm:persistence-layer,
        ngm:tool-use ;
    vc:slug "agent-frameworks" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:standardizedBy ngm:agent-communication-protocol,
        ngm:agent-to-agent-protocol,
        ngm:agntcy-collective,
        ngm:model-context-protocol ;
    vc:supports ngm:coding-assistant,
        ngm:customer-service-agent,
        ngm:data-analysis-agent,
        ngm:rag-pipeline,
        ngm:research-assistant,
        ngm:workflow-automation ;
    vc:uses ngm:a2-a-protocol,
        ngm:acp-protocol,
        ngm:function-calling,
        ngm:json-rpc,
        ngm:mcp-protocol,
        ngm:open-api,
        ngm:server-sent-events .

ngm:autonomous-robot a owl:Class ;
    rdfs:label "Autonomous Robot"@en ;
    rdfs:comment "A robotic system equipped with sensors, processing units, and actuators that operates independently to perform tasks without direct human control, using Artificial Intelligence and Autonomous Navigation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:computer-vision ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:sensor-fusion ],
        ngm:robo-robot-type ;
    skos:broader ngm:robo-robot-type ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.4"^^xsd:float ;
    vc:relatedTo ngm:multi-agent-systems,
        ngm:robot-learning ;
    vc:requires ngm:computer-vision,
        ngm:sensor-fusion ;
    vc:slug "autonomous-robot" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:motion-planning,
        ngm:reinforcement-learning .

ngm:avatar-system a owl:Class ;
    rdfs:label "Avatar System"@en ;
    rdfs:comment "Avatar System is the integrated technical architecture for creating, customizing, animating, and rendering digital representations of users in virtual environments, encompassing character models, animation systems, facial expression rigs, physics simulations, and real-time rendering pipelines."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:3-d-rendering-engine ],
