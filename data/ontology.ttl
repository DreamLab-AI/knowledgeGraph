ngm:semantic-search a owl:Class ;
    rdfs:label "Semantic Search"@en ;
    rdfs:comment "Semantic search is a retrieval paradigm that understands the meaning and intent of queries and documents rather than relying solely on lexical keyword overlap, deploying continuous vector representations of text—produced by neural encoder models that compress sentences into dense embedding spaces..."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:vector-database ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:embedding-model ],
        ngm:ai-application,
        ngm:knowledge-retrieval,
        ngm:search-technology ;
    skos:broader ngm:ai-application ;
    vc:enables ngm:conversational-search,
        ngm:document-retrieval,
        ngm:enterprise-search,
        ngm:knowledge-graph-query,
        ngm:question-answering,
        ngm:retrieval-augmented-generation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:approximate-nearest-neighbour,
        ngm:document-encoder,
        ngm:embedding-model,
        ngm:hybrid-retrieval,
        ngm:inverted-index,
        ngm:query-encoder,
        ngm:reranker,
        ngm:vector-index ;
    vc:implements ngm:bi-encoder-architecture,
        ngm:bm25,
        ngm:col-bert-late-interaction,
        ngm:cross-encoder-reranking,
        ngm:dense-retrieval,
        ngm:hnsw-index,
        ngm:reciprocal-rank-fusion ;
    vc:qualityScore "0.52"^^xsd:float ;
    vc:relatedTo ngm:knowledge-base,
        ngm:knowledge-graph,
        ngm:large-language-models,
        ngm:multimodal-ai,
        ngm:ontology,
        ngm:question-answering ;
    vc:requires ngm:evaluation-benchmark,
        ngm:language-model,
        ngm:query-understanding,
        ngm:text-embeddings,
        ngm:vector-database ;
    vc:slug "semantic-search" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:standardizedBy ngm:beir-benchmark,
        ngm:ms-marco,
        ngm:mteb-benchmark,
        ngm:nist-ir-evaluation,
        ngm:trec ;
    vc:supports ngm:biomedical-information-retrieval,
        ngm:e-commerce-search,
        ngm:enterprise-search,
        ngm:legal-document-retrieval,
        ngm:question-answering,
        ngm:retrieval-augmented-generation ;
