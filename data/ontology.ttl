ngm:decentralized-exchange-dex a owl:Class ;
    rdfs:label "Decentralized Exchange (DEX)"@en ;
    rdfs:comment "Peer-to-peer marketplace enabling direct token swaps and digital asset trading through smart contracts without centralized intermediaries or custodial control."@en ;
    rdfs:subClassOf ngm:smart-contract ;
    vc:enables ngm:decentralized-trading,
        ngm:liquidity-provision,
        ngm:price-discovery,
        ngm:token-swapping ;
    vc:hasPart ngm:automated-market-maker,
        ngm:liquidity-pool,
        ngm:price-oracle,
        ngm:smart-contract,
        ngm:trading-interface ;
    vc:maturity "established" ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:blockchain,
        ngm:consensus-mechanism,
        ngm:digital-wallet,
        ngm:token-standard ;
    vc:slug "decentralized-exchange-dex" ;
    vc:sourceDomain "blockchain" .

