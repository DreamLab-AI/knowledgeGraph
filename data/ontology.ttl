ngm:data-sovereignty a owl:Class ;
    rdfs:label "Data Sovereignty"@en ;
    rdfs:comment "Data sovereignty is the legal and political principle that digital data is subject to the laws, governance structures, and enforcement jurisdiction of the nation or region in which it originates or is processed. It encompasses requirements such as data localisation (mandating that data remain physically within specified borders), restrictions on cross-border data flows, and the right of governments to compel access for regulatory or security purposes. Data sovereignty directly shapes cloud architecture decisions, AI training dataset curation, and multinational data-sharing agreements."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-governance ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:regulatory-compliance ],
        ngm:infra-legal-and-regulatory ;
    skos:broader ngm:infra-legal-and-regulatory ;
    vc:contrastsWith ngm:localisation ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:data-protection,
        ngm:privacy ;
    vc:requires ngm:data-governance,
        ngm:regulatory-compliance ;
    vc:slug "data-sovereignty" ;
    vc:sourceDomain "infrastructure" .

ngm:depth-sensing a owl:Class ;
    rdfs:label "Depth Sensing"@en ;
    rdfs:comment "Depth Sensing is the measurement and capture of per-pixel distance information from a sensor to surfaces in the environment, producing depth maps or point clouds. Technologies include structured light, time-of-flight (ToF), active stereoscopy, and LiDAR. Depth sensing is foundational to augmented reality occlusion, robotic navigation, 3D scene reconstruction, and gesture recognition in spatial computing systems."@en ;
    rdfs:subClassOf ngm:sc-interaction ;
    skos:broader ngm:sc-interaction ;
    vc:enables ngm:3-d-reconstruction,
        ngm:point-cloud,
        ngm:slam ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:relatedTo ngm:depth-estimation ;
    vc:slug "depth-sensing" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:lidar,
        ngm:stereo-camera .

ngm:deterministic-finality a owl:Class ;
    rdfs:label "Deterministic Finality"@en ;
    rdfs:comment "Transaction finality achieved through explicit protocol mechanisms in BFT-based consensus systems, providing absolute mathematical guarantee that finalized blocks cannot be reverted."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:validator-set ],
        ngm:bc-protocol-and-consensus ;
    skos:broader ngm:bc-protocol-and-consensus ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires ngm:validator-set ;
    vc:slug "deterministic-finality" ;
    vc:sourceDomain "blockchain" .

ngm:digital-currency a owl:Class ;
    rdfs:label "Digital Currency"@en ;
    rdfs:comment "Any form of monetary value that exists purely in electronic format, encompassing central bank digital currencies, cryptocurrencies, stablecoins, and virtual currencies used within metaverse economies for transactions, payments, and value exchange without physical representation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:security-infrastructure ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:digital-wallet ],
