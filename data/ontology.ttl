            owl:someValuesFrom ngm:regulatory-compliance ],
        ngm:infra-legal-and-regulatory ;
    skos:broader ngm:infra-legal-and-regulatory ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:digital-tax-compliance-node,
        ngm:financial-regulation,
        ngm:legal-compliance ;
    vc:requires ngm:regulatory-compliance,
        ngm:uk-company-financial-filing-obligations ;
    vc:slug "corporate-tax-compliance-framework" ;
    vc:sourceDomain "infrastructure" ;
    vc:standardizedBy ngm:legal-framework .

ngm:corrigibility a owl:Class ;
    rdfs:label "Corrigibility"@en ;
    rdfs:comment "Corrigibility is the property of an AI system that allows it to be corrected, redirected or shut down by authorised humans without resisting, deceiving or manipulating them. A corrigible agent does not treat interventions as threats to its objectives and cooperates with oversight even when doing so conflicts with its current goals. It is a central concept in AI safety because it keeps powerful systems amenable to human control as they grow more capable."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
