ngm:sampling a owl:Class ;
    rdfs:label "Sampling"@en ;
    rdfs:comment "Sampling is the family of computational and statistical procedures that draw representative or informative values from probability distributions — ranging from classical Markov chain Monte Carlo mods (Metropolis-Hastings, Gibbs, Hamiltonian Monte Carlo, NUTS) and sequential mods (Sequential Monte..."@en ;
    rdfs:subClassOf ngm:numerical-methods,
        ngm:stochastic-processes ;
    vc:enables ngm:bayesian-inference,
        ngm:foundation-models,
        ngm:large-language-models,
        ngm:particle-filter,
        ngm:stable-diffusion,
        ngm:uncertainty-quantification ;
    vc:hasPart ngm:autoregressive-sampling,
        ngm:diffusion-models,
        ngm:importance-sampling,
        ngm:markov-chain-monte-carlo,
        ngm:nested-sampling,
        ngm:quasi-monte-carlo,
        ngm:rejection-sampling,
        ngm:sequential-monte-carlo ;
    vc:implements ngm:ddim,
        ngm:dpm-solver,
        ngm:gibbs-sampling,
        ngm:hamiltonian-monte-carlo,
        ngm:metropolis-hastings-algorithm,
        ngm:nucleus-sampling,
        ngm:nuts,
        ngm:speculative-decoding ;
    vc:maturity "established" ;
    vc:qualityScore "0.52"^^xsd:float ;
    vc:relatedTo ngm:attention,
        ngm:checkpoints,
        ngm:comfy-ui,
        ngm:foundation-models,
        ngm:model-optimisation-and-performance,
        ngm:monte-carlo-methods,
        ngm:probabilistic-model,
        ngm:reasoning,
        ngm:stable-diffusion,
        ngm:training-data,
        ngm:transformers ;
    vc:requires ngm:convergence-criterion,
        ngm:probability-distribution,
        ngm:proposal-distribution,
        ngm:random-number-generator,
        ngm:target-density ;
    vc:slug "sampling" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:standardizedBy ngm:hugging-face-diffusers,
        ngm:num-pyro,
        ngm:py-mc,
        ngm:robert-casella-monte-carlo-statistical-methods,
        ngm:stan-probabilistic-programming ;
    vc:supports ngm:comfy-ui,
        ngm:comfy-ui-workflows,
        ngm:diffusion-models,
        ngm:large-language-models,
        ngm:particle-filter,
        ngm:variational-inference ;
    vc:uses ngm:entropy,
        ngm:gradient-information,
        ngm:kullback-leibler-divergence,
        ngm:markov-chain-monte-carlo,
        ngm:noise-schedule,
        ngm:score-function .

