ngm:archival-node a owl:Class ;
    rdfs:label "Archival Node"@en ;
    rdfs:comment "An Archival Node is a blockchain network participant that stores the complete historical state of the ledger—every block, transaction, and state root from genesis to the current tip—without pruning older data. Unlike pruned nodes or light nodes, an archival node can respond to queries about any historical state at any block height, making it essential for block explorers, analytics services, and smart contract developers who need point-in-time state access."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:peer-to-peer-network ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:blockchain-protocol ],
        ngm:bc-network-component,
        ngm:blockchain-entity,
        ngm:network-component ;
    skos:broader ngm:bc-network-component ;
    vc:contrastsWith ngm:light-node,
        ngm:pruned-node ;
    vc:enables ngm:blockchain-compliance,
        ngm:blockchain-transaction,
        ngm:long-term-archival ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:blockchain-infrastructure,
        ngm:blockchain-network,
        ngm:chain-state,
        ngm:full-node ;
    vc:requires ngm:blockchain-protocol,
        ngm:peer-to-peer-network ;
    vc:slug "archival-node" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:state-machine-replication .

