    vc:slug "voice-user-interface" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:accessibility,
        ngm:human-computer-interaction ;
    vc:uses ngm:intent-classification,
        ngm:natural-language-processing .

ngm:vote-escrow a owl:Class ;
    rdfs:label "Vote Escrow"@en ;
    rdfs:comment "Vote escrow (ve) is a tokenomics mechanism in which holders lock governance tokens for a chosen duration in exchange for non-transferable, time-decaying voting power and often boosted protocol rewards. Popularised by Curve's veCRV model, it aligns voter incentives with long-term protocol health by rewarding commitment over short-term speculation. Locked positions decay linearly to zero at unlock, requiring periodic re-locking to maintain influence."@en ;
    rdfs:subClassOf ngm:bc-defi-and-economics ;
    skos:broader ngm:bc-defi-and-economics ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:on-chain-voting,
        ngm:tokenomics-governance ;
    vc:slug "vote-escrow" ;
    vc:sourceDomain "blockchain" .

ngm:vpn a owl:Class ;
    rdfs:label "VPN"@en ;
    rdfs:comment "A Virtual Private Network (VPN) is a security technology that establishes an encrypted tunnel between a user's device and a remote server, routing traffic through it so that data confidentiality and integrity are preserved across untrusted networks. By encapsulating and encrypting packets, a VPN conceals the user's originating address and protects communications from interception on shared or public infrastructure. VPNs are widely used for secure remote access to private networks, for privacy on public Wi-Fi, and for circumventing network-level filtering."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:network-transport ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:network-protocol ],
        ngm:network-security ;
    vc:bridgesTo ngm:network-layer ;
    vc:contrastsWith ngm:onion-routing,
        ngm:tor ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:encryption,
        ngm:secure-communication,
        ngm:tls ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:firewall,
        ngm:network-security,
        ngm:privacy-preserving-computation ;
    vc:requires ngm:network-protocol,
        ngm:network-transport ;
    vc:slug "vpn" ;
    vc:sourceDomain "security" ;
    vc:supports ngm:access-control,
        ngm:data-privacy,
        ngm:privacy ;
    vc:uses ngm:authentication,
        ngm:cryptographic-protocols .

ngm:vulnerability-assessment a owl:Class ;
    rdfs:label "Vulnerability Assessment"@en ;
    rdfs:comment "Vulnerability assessment is the structured evaluation of an organisation's systems against known weaknesses, producing a prioritised inventory of exposures and recommended mitigations. It is typically scope-bounded and recurring, using automated scanners and authenticated checks to map findings to severity and asset criticality. Mandated by many cybersecurity standards, it provides the baseline evidence for compliance and continuous risk reduction."@en ;
    rdfs:subClassOf ngm:cybersecurity ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:cybersecurity-standard,
        ngm:threat-modelling ;
    vc:slug "vulnerability-assessment" ;
    vc:sourceDomain "security" .

ngm:w3-c-did a owl:Class ;
    rdfs:label "W3C DID"@en ;
    rdfs:comment "W3C DID (Decentralised Identifier) is a W3C Recommendation standard (published July 2022) that defines a new type of globally unique, persistent, and cryptographically verifiable identifier that does not require a centralised registration authority. A DID resolves to a DID Document — a JSON-LD data structure containing public keys, authentication mechanisms, and service endpoints — enabling the DID subject to prove control and establish secure communication without depending on a third-party identity provider. DIDs are the foundational primitive for self-sovereign identity systems."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:verifiable-data-registry ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:did-document ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:decentralized-identifiers ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:did-method ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:verification-method ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:did-resolver ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:json-data-interchange-format-ld ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:public-key-cryptography ],
        ngm:w3-c-did-core ;
    vc:bridgesTo ngm:blockchain,
        ngm:digital-identity-wallet,
        ngm:open-id4-vc ;
    vc:contrastsWith ngm:oauth-2-0,
        ngm:open-id-connect,
        ngm:public-key-infrastructure ;
    vc:enables ngm:authentication,
        ngm:decentralised-trust,
        ngm:digital-identity-management,
        ngm:selective-disclosure,
        ngm:self-sovereign-identity ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:decentralized-identifiers,
        ngm:did-document,
        ngm:did-method,
        ngm:did-resolver,
        ngm:verification-method ;
    vc:implements ngm:trust-over-ip-stack,
        ngm:w3-c-verifiable-credentials ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:decentralized-identity,
        ngm:sidetree-protocol ;
    vc:requires ngm:json-data-interchange-format-ld,
        ngm:public-key-cryptography,
        ngm:verifiable-data-registry ;
    vc:slug "w3-c-did" ;
    vc:sourceDomain "security" ;
    vc:standardizedBy ngm:w3-c ;
    vc:uses ngm:elliptic-curve-cryptography,
        ngm:uri .

ngm:web-id a owl:Class ;
    rdfs:label "WebID"@en ;
    rdfs:comment "WebID is a decentralised identity mechanism in which a person or agent is identified by an HTTP(S) URI that dereferences to a machine-readable profile document describing them in RDF. Combined with authentication methods such as WebID-TLS or WebID-OIDC, it lets users prove control of their identifier without a central identity provider. WebID is a foundational building block of the Solid project and the broader linked-data web, enabling user-controlled identity, profiles, and access control across decentralised applications."@en ;
    rdfs:subClassOf ngm:decentralized-identity ;
    vc:enables ngm:federated-identity ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:self-sovereign-identity,
        ngm:semantic-web-linked-data-standard ;
    vc:slug "web-id" ;
    vc:sourceDomain "security" ;
    vc:uses ngm:linked-data,
        ngm:rdf .

ngm:weight-matrix a owl:Class ;
    rdfs:label "Weight Matrix"@en ;
    rdfs:comment "A weight matrix is a two-dimensional array of learnable parameters that defines the linear transformation applied between two layers of a neural network. Each element encodes the strength of the connection between an input unit and an output unit, and the matrix is multiplied with the input activation vector to produce the pre-activation output. Weight matrices are initialised, then iteratively updated during training via gradient-based optimisation to minimise a loss function."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:optimisation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:training ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gradient-descent ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:parameter ],
        ngm:neural-network ;
    vc:dependsOn ngm:loss-function,
        ngm:tensor ;
    vc:enables ngm:activation-function,
        ngm:inference ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:parameter ;
    vc:isPartOf ngm:deep-learning,
        ngm:machine-learning,
        ngm:neural-network ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:backpropagation,
        ngm:model-training ;
    vc:requires ngm:gradient-descent,
        ngm:optimisation,
        ngm:training ;
    vc:slug "weight-matrix" ;
    vc:sourceDomain "machine-learning" ;
    vc:uses ngm:linear-algebra,
        ngm:matrix-multiplication .

ngm:wikidata a owl:Class ;
    rdfs:label "Wikidata"@en ;
    rdfs:comment "Wikidata is a free, collaboratively edited knowledge base operated by the Wikimedia Foundation that stores structured data as machine-readable items and statements, serving as a central data repository for Wikipedia and the broader web. Each item has a stable identifier and is described by property-value statements with references and qualifiers, exported as linked data and queryable via SPARQL. Multilingual by design and released under a public-domain licence, Wikidata is one of the largest open knowledge graphs and a key hub in the linked-data web."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:structured-data ],
        ngm:knowledge-graph ;
    vc:bridgesTo ngm:artificial-intelligence,
        ngm:distributed-collaboration ;
    vc:enables ngm:federated-query,
        ngm:open-data,
        ngm:semantic-web-linked-data-standard ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:structured-data ;
    vc:isPartOf ngm:semantic-web-linked-data-standard ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:collaborative-editing,
        ngm:knowledge-graph,
        ngm:ontology,
        ngm:semantic-search ;
    vc:slug "wikidata" ;
    vc:sourceDomain "data" ;
    vc:supports ngm:natural-language-processing,
        ngm:question-answering,
        ngm:retrieval-augmented-generation ;
    vc:uses ngm:entity-resolution,
        ngm:json-data-interchange-format-ld,
        ngm:linked-data,
        ngm:rdf,
        ngm:sparql .

ngm:yield-generation a owl:Class ;
    rdfs:label "Yield Generation"@en ;
    rdfs:comment "Yield generation in the context of decentralised finance (DeFi) refers to the set of mechanisms by which cryptocurrency holders earn returns on their assets by deploying them into productive on-chain activities — including liquidity provision to automated market makers, lending on money market protocols, staking in proof-of-stake consensus, and participating in yield optimisation vaults — thereby converting idle digital assets into income-generating positions. Yield is typically expressed as an annualised percentage rate (APR) or annual percentage yield (APY) and derives from trading fees, interest payments from borrowers, block rewards, and protocol token emissions. Yield generation is a core economic primitive of DeFi, enabling capital efficiency but also introducing smart contract, liquidation, and impermanent loss risks."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:staking-reward ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:token-economics ],
        ngm:de-fi ;
    vc:bridgesTo ngm:finance,
        ngm:risk-management ;
    vc:contrastsWith ngm:traditional-finance ;
    vc:dependsOn ngm:decentralized-exchange,
        ngm:oracle ;
    vc:enables ngm:capital-efficiency,
        ngm:decentralized-finance-de-fi,
        ngm:liquidity-mining,
        ngm:passive-income ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:staking-reward ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:annual-percentage-yield,
        ngm:digital-asset-lending,
        ngm:impermanent-loss,
        ngm:liquidity-pool,
        ngm:liquidity-provision,
        ngm:real-world-asset-tokenisation,
        ngm:yield-farming ;
    vc:requires ngm:collateral,
        ngm:token-economics ;
    vc:slug "yield-generation" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:automated-market-maker,
        ngm:governance-token,
        ngm:liquid-staking,
        ngm:proof-of-stake,
        ngm:smart-contract .

ngm:zero-knowledge-rollup a owl:Class ;
    rdfs:label "Zero-Knowledge Rollup"@en ;
    rdfs:comment "A zero-knowledge rollup (ZK-rollup) is a layer-2 scaling construction that executes transactions off-chain in batches and posts a succinct validity proof to a base chain attesting that the new state was computed correctly. Because the proof cryptographically guarantees correctness, the base chain need not re-execute the transactions, achieving high throughput while inheriting the security of the underlying ledger. ZK-rollups offer near-instant finality once a proof is verified, distinguishing them from optimistic designs that rely on challenge periods."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:zero-knowledge-proof ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:data-availability ],
        ngm:rollup ;
    vc:contrastsWith ngm:optimistic-rollup ;
    vc:dependsOn ngm:data-availability,
        ngm:ethereum ;
    vc:enables ngm:blockchain-scalability ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:data-availability,
        ngm:zero-knowledge-proof ;
    vc:implements ngm:blockchain-scalability,
        ngm:transaction-finality ;
    vc:isPartOf ngm:rollup ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:gas-fee,
        ngm:polygon,
        ngm:starknet ;
    vc:slug "zero-knowledge-rollup" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:smart-contract ;
    vc:uses ngm:plonk,
        ngm:zero-knowledge-proof,
        ngm:zk-snark .

ngm:aave a owl:Class ;
    rdfs:label "Aave"@en ;
    rdfs:comment "Aave is a decentralised, non-custodial liquidity protocol deployed on Ethereum and multiple EVM-compatible networks that allows users to supply crypto assets into pooled reserves to earn algorithmically set interest, and to borrow against over-collateralised positions at variable or stable rates. Pioneered by Stani Kulechov and launched as ETHLend in 2017 before rebranding in 2020, it introduced the flash loan — an uncollateralised loan that must be atomically repaid within a single transaction block — as a foundational DeFi primitive. Governance is exercised by AAVE token holders who vote on Aave Improvement Proposals controlling risk parameters, supported asset listings, protocol upgrades, and treasury allocations."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:wallet ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:oracle ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:over-collateralisation ],
        ngm:decentralised-finance ;
    vc:bridgesTo ngm:risk-modelling ;
    vc:contrastsWith ngm:compound,
        ngm:maker-dao,
        ngm:traditional-finance ;
    vc:enables ngm:collateralised-borrowing,
        ngm:flash-loan,
        ngm:self-liquidation,
        ngm:yield-farming ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:on-chain-governance ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:cross-chain-bridge,
        ngm:liquidation-mechanism,
        ngm:stablecoin,
        ngm:token-governance ;
    vc:requires ngm:oracle,
        ngm:over-collateralisation,
        ngm:wallet ;
    vc:slug "aave" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:chainlink,
        ngm:ethereum,
        ngm:evm,
        ngm:liquidity-pool,
        ngm:smart-contracts .

ngm:accessibility-standard a owl:Class ;
    rdfs:label "Accessibility Standard"@en ;
    rdfs:comment "Normative specification ensuring equitable access to digital content, services, and experiences for users with diverse abilities and disabilities, covering visual, auditory, motor, cognitive, and neurological access paths with testable conformance criteria."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:xr-accessibility-guideline ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:user-interface-standard ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:assistive-technology ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:xr-accessibility-guideline ],
        ngm:sc-governance-and-safety ;
    skos:broader ngm:sc-governance-and-safety ;
    vc:bridgesTo ngm:human-computer-interaction,
        ngm:telecollaboration ;
    vc:enables ngm:digital-inclusion,
        ngm:equitable-access,
        ngm:inclusive-xr-experience,
        ngm:universal-design ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:xr-accessibility-guideline ;
    vc:implements ngm:section-508,
        ngm:wcag-2-2 ;
    vc:isPartOf ngm:compliance-framework,
        ngm:governance-framework ;
    vc:qualityScore "0.68"^^xsd:float ;
    vc:relatedTo ngm:ai-governance-and-ethics,
        ngm:middleware-layer ;
    vc:requires ngm:assistive-technology,
        ngm:user-interface-standard,
        ngm:xr-accessibility-guideline ;
    vc:slug "accessibility-standard" ;
    vc:sourceDomain "standards" ;
    vc:standardizedBy ngm:etsi,
        ngm:iso,
        ngm:w3-c ;
    vc:supports ngm:user-experience-design .

ngm:accessibility-standards a owl:Class ;
    rdfs:label "Accessibility Standards"@en ;
    rdfs:comment "Accessibility Standards for the metaverse and extended reality (XR) encompass guidelines, technical specifications, and design principles that ensure virtual environments, interfaces, and interactions are usable by people with diverse disabilities including visual, auditory, physical, cognitive, and neurological impairments. Key bodies include the W3C XR Accessibility User Requirements (XRAUR), WCAG 2.2/3.0 adaptations, ADA digital interpretations, and inclusive immersion frameworks covering multi-modal input, hardware ergonomics, and spatial interface design."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:assistive-technology-integration ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:eye-tracking ],
        ngm:sc-governance-and-safety ;
    skos:broader ngm:sc-governance-and-safety ;
    vc:bridgesTo ngm:governance,
        ngm:human-computer-interaction,
        ngm:infra-legal-and-regulatory ;
    vc:contrastsWith ngm:interface-standards ;
    vc:enables ngm:equitable-access,
        ngm:inclusive-xr-experience,
        ngm:universal-design ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:implements ngm:inclusive-design ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:extended-reality,
        ngm:spatial-computing,
        ngm:user-experience-design ;
    vc:requires ngm:assistive-technology-integration,
        ngm:eye-tracking ;
    vc:slug "accessibility-standards" ;
    vc:sourceDomain "spatial-computing" ;
    vc:standardizedBy ngm:w3-c,
        ngm:wcag-2-2,
        ngm:xr-accessibility-user-requirements ;
    vc:supports ngm:metaverse,
        ngm:telecollaboration .

ngm:accountability-mechanism a owl:Class ;
    rdfs:label "Accountability Mechanism"@en ;
    rdfs:comment "An accountability mechanism is a specific procedural, technical, or institutional instrument through which an actor can be held answerable for their decisions and conduct—for example, an audit trail, an ombudsman process, an algorithmic impact assessment, or a public reporting obligation. Whereas an accountability framework defines the overall structure of responsibility, an accountability mechanism is the concrete tool that makes accountability operational within or across that framework."@en ;
    rdfs:subClassOf ngm:accountability ;
    vc:enables ngm:compliance,
        ngm:transparency ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:accountability-framework ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:algorithmic-accountability,
        ngm:regulatory-framework ;
    vc:slug "accountability-mechanism" ;
    vc:sourceDomain "governance" ;
    vc:uses ngm:audit-log,
        ngm:audit-trail .

ngm:action-space a owl:Class ;
    rdfs:label "Action Space"@en ;
    rdfs:comment "The action space in reinforcement learning and control theory is the complete set of actions available to an agent at any given decision step, defining the boundaries of what the agent may do when interacting with its environment. It may be discrete—a finite enumeration of choices—or continuous—a real-valued manifold such as joint torques or steering angles—and its structure fundamentally determines which learning algorithms are applicable and how efficiently a policy can be discovered."@en ;
    rdfs:subClassOf ngm:state-space ;
    vc:dependsOn ngm:environment-model,
        ngm:simulation-environment ;
    vc:enables ngm:deep-reinforcement-learning,
        ngm:policy-optimisation,
        ngm:reinforcement-learning-algorithm,
        ngm:safe-reinforcement-learning ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:continuous-action,
        ngm:discrete-action ;
    vc:qualityScore "0.87"^^xsd:float ;
    vc:relatedTo ngm:control-theory,
        ngm:exploration-exploitation,
        ngm:markov-decision-process,
        ngm:reinforcement-learning,
        ngm:reward-function ;
    vc:slug "action-space" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:policy-gradient-methods,
        ngm:reinforcement-learning-for-robotics .

ngm:agent-event-stream a owl:Class ;
    rdfs:label "Agent Event Stream"@en ;
    rdfs:comment "A real-time telemetry stream (surface S6) that emits ActivityStream|ActivityStreams-based JSON-LD events for agent lifecycle events (birth, startup, activity, completion, error, termination) via WebSocket, Nostr relay, or message queue, enabling external monitoring systems, dashboards, and or..."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:json-data-interchange-format-ld-1-1 ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:web-socket ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:real-time-streaming ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:event-emission ],
        ngm:ai-infrastructure ;
    vc:enables ngm:anomaly-detection,
        ngm:real-time-monitoring ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:event-emission,
        ngm:real-time-streaming ;
    vc:implements ngm:json-data-interchange-format-ld-1-1 ;
    vc:qualityScore "0.85"^^xsd:float ;
    vc:requires ngm:json-data-interchange-format-ld-1-1,
        ngm:web-socket ;
    vc:slug "agent-event-stream" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:agent-execution-sandboxes a owl:Class ;
    rdfs:label "Agent Execution Sandboxes"@en ;
    rdfs:comment "Isolated execution environments providing secure, ephemeral containers and virtual machines for AI-generated code execution, tool use, and autonomous agent operation — including E2B, Daytona, Docker MCP Gateway, Cloudflare Sandboxes, Modal, Vercel Sandbox, and Fly Machines — with hardware-level isolation via Firecracker microVMs, gVisor syscall interception, or Kata Containers to prevent escape to host infrastructure."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:containerisation ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:container-runtime ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:tool-use ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:mcp-server ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:code-execution ],
        ngm:agent-harness,
        ngm:ai-infrastructure ;
    vc:contrastsWith ngm:internal-ai-harness ;
    vc:enables ngm:agentic-workflow,
        ngm:autonomous-coding,
        ngm:terminal-coding-agents ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:code-execution,
        ngm:container-runtime,
        ngm:mcp-server ;
