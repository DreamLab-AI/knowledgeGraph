ngm:eu-mi-ca-regulation a owl:Class ;
    rdfs:label "EU MiCA Regulation"@en ;
    rdfs:comment "The EU Markets in Crypto-Assets Regulation is a European Union framework establishing harmonised rules for crypto-asset issuance, trading and service provision."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:regulatory-frameworks ],
