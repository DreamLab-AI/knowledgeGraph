    vc:relatedTo ngm:large-language-models ;
    vc:slug "byte-pair-encoding" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:transformer .

ngm:calibration-target a owl:Class ;
    rdfs:label "Calibration Target"@en ;
    rdfs:comment "A physical or displayed reference pattern with precisely known geometric, photometric, or colorimetric properties used to determine camera intrinsic and extrinsic parameters, enabling accurate lens distortion correction, spatial measurement, and color reproduction in imaging systems."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
