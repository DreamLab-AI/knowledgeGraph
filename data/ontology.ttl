        ngm:industrial-io-t,
        ngm:machine-learning .

ngm:inference-serving a owl:Class ;
    rdfs:label "Inference Serving"@en ;
    rdfs:comment "Inference serving is the end-to-end runtime discipline of deploying trained machine learning models as production services that respond to prediction requests at scale, with controlled latency and high throughput. It encompasses the inference engine, request routing, dynamic batching, accelerator scheduling, autoscaling, and observability infrastructure needed to meet service-level objectives. Unlike model training, inference serving must optimise for request-level latency, cost-per-query, and concurrent user load simultaneously. Modern inference serving platforms add specialised techniques such as continuous batching, quantisation, and KV-cache management to sustain high GPU utilisation across large language models and other deep neural network workloads."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ai-model-inference-engine ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:observability ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:load-balancer ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gpu ],
        ngm:model-serving ;
    vc:bridgesTo ngm:api-gateway,
        ngm:edge-computing ;
    vc:contrastsWith ngm:model-training,
        ngm:offline-batch-processing ;
    vc:dependsOn ngm:distributed-computing,
        ngm:model-registry ;
    vc:enables ngm:batch-inference,
        ngm:llm-deployment,
        ngm:real-time-inference ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:autoscaling,
        ngm:dynamic-batching,
        ngm:model-runtime,
        ngm:observability,
        ngm:request-queue ;
    vc:isPartOf ngm:ai-infrastructure,
        ngm:mlops ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:latency,
        ngm:ray-serve,
        ngm:service-level-objective,
        ngm:throughput,
        ngm:triton-inference-server ;
    vc:requires ngm:ai-model-inference-engine,
        ngm:container-orchestration,
        ngm:gpu,
        ngm:load-balancer ;
    vc:slug "inference-serving" ;
    vc:sourceDomain "machine-learning" ;
    vc:uses ngm:kv-cache,
        ngm:model-quantisation,
        ngm:tensor-parallelism .

ngm:intellectual-property a skos:Concept ;
    rdfs:label "Intellectual Property"@en .

ngm:intellectual-property-rights-framework a owl:Class ;
    rdfs:label "Intellectual Property Rights Framework"@en ;
    rdfs:comment "An Intellectual Property Rights Framework is the structured system of legal doctrines, statutes, treaties, and enforcement mechanisms that grant creators and innovators exclusive, time-limited rights over their intangible works — encompassing copyright, patent, trade mark, and trade secret regimes. The framework defines conditions of ownership, permissible use, licensing, and transfer of rights, balancing the incentive to create against the public interest in open knowledge. In the context of AI, spatial computing, and distributed digital environments, the framework is under active re-negotiation as autonomous generation, data-intensive training, and cross-jurisdictional virtual economies challenge foundational assumptions about authorship and originality."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:legal-compliance ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:digital-rights-management ],
        ngm:legal-framework ;
    vc:bridgesTo ngm:ai-governance,
        ngm:data-governance,
        ngm:decentralised-autonomous-organisation,
        ngm:non-fungible-token ;
    vc:contrastsWith ngm:generative-ai,
        ngm:open-data,
        ngm:public-domain ;
    vc:enables ngm:creative-commons,
        ngm:open-source-licensing,
        ngm:technology-transfer ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:copyright,
        ngm:licensing,
        ngm:patent-law,
        ngm:trade-mark,
        ngm:trade-secret ;
    vc:isPartOf ngm:legal-framework ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:content-moderation,
        ngm:digital-rights,
        ngm:fair-use,
        ngm:regulatory-compliance ;
    vc:requires ngm:digital-rights-management,
        ngm:legal-compliance ;
    vc:slug "intellectual-property-rights-framework" ;
    vc:sourceDomain "governance" ;
    vc:standardizedBy ngm:trips-agreement,
        ngm:world-intellectual-property-organization ;
    vc:supports ngm:content-monetisation,
        ngm:digital-rights,
        ngm:innovation-ecosystem .

ngm:key-exchange a owl:Class ;
    rdfs:label "Key Exchange"@en ;
    rdfs:comment "Key exchange is a cryptographic procedure by which two parties establish a shared secret over an insecure channel for use in subsequent encrypted communication."@en ;
