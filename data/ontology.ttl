ngm:scorm a owl:Class ;
    rdfs:label "Scorm"@en ;
    rdfs:comment "SCORM (Sharable Content Object Reference Model) is a set of technical standards for packaging and exchanging e-learning content so that courses run consistently across compliant learning management systems. It defines content packaging, run-time communication and sequencing so that a course can report completion, scores and time to the host platform. SCORM established interoperability for digital learning content and is a predecessor to xAPI."@en ;
    rdfs:subClassOf ngm:education-technology ;
    vc:enables ngm:data-interoperability ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:implements ngm:metadata,
        ngm:xml ;
    vc:isPartOf ngm:education-technology ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:learning-analytics ;
    vc:slug "scorm" ;
    vc:sourceDomain "spatial-computing" ;
    vc:standardizedBy ngm:interoperability,
        ngm:standards ;
    vc:supports ngm:learning-management-system ;
    vc:uses ngm:xml .

ngm:screen-capture-api a owl:Class ;
    rdfs:label "Screen Capture API"@en ;
    rdfs:comment "The Screen Capture API is a W3C web platform interface, centred on getDisplayMedia, that lets web applications obtain a live media stream of a user-selected screen, window, or browser tab. It exposes the captured display as a MediaStream usable for recording, sharing, or processing, gated by an explicit user-selection prompt. It is the standard browser foundation for screen sharing and recording features."@en ;
    rdfs:subClassOf ngm:technical-standard ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:screen-recording,
        ngm:screen-sharing ;
    vc:slug "screen-capture-api" ;
    vc:sourceDomain "infrastructure" .

ngm:search-discovery a owl:Class ;
    rdfs:label "Search Discovery"@en ;
    rdfs:comment "Systems and interfaces that enable users to find relevant content, assets, experiences, and other users within metaverse platforms through keyword search, semantic queries, recommendations, and spatial exploration mechanisms."@en ;
    rdfs:subClassOf ngm:sc-standards-and-interop ;
    skos:broader ngm:sc-standards-and-interop ;
    vc:bridgesTo ngm:information-retrieval ;
    vc:enables ngm:user-navigation ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:slug "search-discovery" ;
    vc:sourceDomain "spatial-computing" .

ngm:second-order-optimisation a owl:Class ;
    rdfs:label "Second Order Optimisation"@en ;
    rdfs:comment "Second-order optimisation is a family of optimisation methods that use second-derivative (curvature) information, typically the Hessian matrix or its approximations, to determine search directions and step sizes. By accounting for the curvature of the objective, these methods can converge in far fewer iterations than first-order methods near a minimum, at the cost of higher per-iteration computation and memory. Examples include Newton's method, quasi-Newton methods such as L-BFGS, and conjugate-gradient approaches."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:convex-optimisation ],
        ngm:convex-optimisation ;
    vc:contrastsWith ngm:gradient-descent,
        ngm:stochastic-gradient-descent ;
    vc:dependsOn ngm:machine-learning ;
    vc:enables ngm:convergence ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:optimiser ;
    vc:isPartOf ngm:convex-optimisation ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:convergence,
        ngm:gradient-descent,
        ngm:optimiser ;
    vc:requires ngm:convex-optimisation ;
    vc:slug "second-order-optimisation" ;
    vc:sourceDomain "machine-learning" ;
    vc:supports ngm:machine-learning,
        ngm:optimiser ;
    vc:uses ngm:loss-function .

ngm:secondary-market a owl:Class ;
    rdfs:label "Secondary Market"@en ;
    rdfs:comment "A secondary market is a venue in which existing financial assets are bought and sold among investors after their initial issuance, rather than purchased directly from the issuer. By allowing holders to exit positions and new buyers to enter, it provides liquidity, continuous price discovery, and a mechanism for valuing assets through ongoing trading. Secondary markets are essential to the functioning of capital markets because the ability to resell makes initial investment far more attractive."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:asset-trading ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:liquidity ],
        ngm:finance ;
    vc:bridgesTo ngm:decentralised-exchange ;
    vc:contrastsWith ngm:capital-allocation ;
    vc:dependsOn ngm:liquidity ;
    vc:enables ngm:asset-trading,
        ngm:liquidity,
        ngm:price-discovery ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:asset-trading ;
    vc:implements ngm:price-discovery ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:capital-allocation,
        ngm:decentralised-exchange,
        ngm:interest-rate ;
    vc:requires ngm:liquidity ;
    vc:slug "secondary-market" ;
    vc:sourceDomain "finance" ;
    vc:supports ngm:capital-allocation,
        ngm:liquidity ;
    vc:uses ngm:asset-trading,
        ngm:price-discovery .

ngm:secondary-market-integration a owl:Class ;
    rdfs:label "Secondary Market Integration"@en ;
    rdfs:comment "Technical and business infrastructure connecting primary asset creation with resale marketplaces, enabling liquidity for digital collectibles, virtual real estate, and NFTs through automated royalty distribution and cross-platform trading protocols."@en ;
    rdfs:subClassOf ngm:digital-asset-trading,
