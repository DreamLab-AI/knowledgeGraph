ngm:un-global-compact a owl:Class ;
    rdfs:label "UN Global Compact"@en ;
    rdfs:comment "The UN Global Compact is a voluntary United Nations initiative encouraging businesses worldwide to adopt sustainable and socially responsible policies aligned with ten principles covering human rights, labour, environment, and anti-corruption. Signatory companies commit to embedding these principles in their operations and to reporting annual progress, making it the world's largest corporate sustainability initiative."@en ;
    rdfs:subClassOf ngm:governance-framework ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:ethical-sourcing,
        ngm:sustainability ;
    vc:slug "un-global-compact" ;
    vc:sourceDomain "governance" .

ngm:un-guiding-principles-on-business-and-human-rights a owl:Class ;
    rdfs:label "UN Guiding Principles on Business and Human Rights"@en ;
    rdfs:comment "The UN Guiding Principles on Business and Human Rights (UNGPs) are a set of 31 principles endorsed by the UN Human Rights Council in 2011 that establish a global standard for preventing and addressing adverse human rights impacts linked to business activity. They rest on three pillars: the state duty to protect, the corporate responsibility to respect, and access to remedy. The framework underpins human-rights due diligence across supply chains, including ethical sourcing of materials and labour."@en ;
    rdfs:subClassOf ngm:governance-framework ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:ethical-sourcing ;
    vc:slug "un-guiding-principles-on-business-and-human-rights" ;
    vc:sourceDomain "governance" .

ngm:universal-access a owl:Class ;
    rdfs:label "Universal Access"@en ;
    rdfs:comment "Universal access is the design principle and policy goal that products, services and digital experiences be usable by the widest possible range of people regardless of ability, device, connectivity or context. In immersive and metaverse settings it requires accommodating diverse sensory, motor and cognitive capabilities so that no user is excluded from participation. It is the foundation on which accessible experiences and accessibility guidelines are built."@en ;
    rdfs:subClassOf ngm:sc-governance-and-safety ;
    skos:broader ngm:sc-governance-and-safety ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:accessible-experience,
        ngm:xr-accessibility-guideline ;
    vc:slug "universal-access" ;
    vc:sourceDomain "metaverse" .

ngm:universal-avatar a owl:Class ;
    rdfs:label "Universal Avatar"@en ;
    rdfs:comment "A cross-platform digital representation of a user that maintains consistent identity, appearance, and asset customisations across multiple metaverse applications, games, and virtual environments. Universal avatars rely on interoperability standards such as glTF and VRM to enable a single avatar to function across thousands of compatible platforms without requiring recreation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:avatar-standard ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:avatar-interoperability ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:avatar-customization ],
        ngm:avatar,
        ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:enables ngm:avatar-portability,
        ngm:cross-platform-identity ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:avatar-customization ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:requires ngm:avatar-interoperability,
        ngm:avatar-standard ;
    vc:slug "universal-avatar" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:gltf-standard,
        ngm:vrm-format .

ngm:universal-basic-income a owl:Class ;
    rdfs:label "Universal Basic Income"@en ;
    rdfs:comment "Universal basic income (UBI) is an economic policy under which all members of a population receive a regular, unconditional cash payment from the state or another institution, independent of employment status or means. It is debated as a mechanism to reduce poverty, buffer labour displacement from automation and AI, and address structural inequality. Proponents view it as a redistributive instrument while critics question its fiscal sustainability and incentive effects."@en ;
    rdfs:subClassOf ngm:economic-mechanism ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:global-inequality ;
    vc:slug "universal-basic-income" ;
    vc:sourceDomain "governance" .

ngm:universal-manifest a owl:Class ;
    rdfs:label "Universal Manifest"@en ;
    rdfs:comment "A standardized metadata document describing identifiers, permissions, relationships, and provenance of a user's digital assets and identities across platforms, enabling cross-platform portability and interoperability."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
