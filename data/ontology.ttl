ngm:halving a owl:Class ;
    rdfs:label "Halving"@en ;
    rdfs:comment "A programmatic event in proof-of-work blockchains, most notably Bitcoin, whereby the block reward issued to miners is cut in half at a predetermined block height. Halvings enforce a fixed, disinflationary supply schedule that asymptotically approaches the maximum coin supply. By reducing new coin issuance, halvings create predictable scarcity and are a central component of Bitcoin's monetary policy."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:consensus-rule ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:mining-reward ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:block-reward ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:proof-of-work ],
        ngm:bc-defi-and-economics,
        ngm:blockchain-entity,
        ngm:economic-mechanism ;
    skos:broader ngm:bc-defi-and-economics ;
    vc:enables ngm:deflationary-token,
        ngm:fixed-supply-token,
        ngm:inflation-control ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:block-reward,
        ngm:mining-reward ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:bitcoin-mining,
        ngm:bitcoin-value-proposition,
        ngm:circulating-supply,
        ngm:difficulty-adjustment,
        ngm:incentive-alignment,
        ngm:monetary-policy-implementation,
        ngm:tokenomics ;
    vc:requires ngm:consensus-rule,
        ngm:proof-of-work ;
    vc:slug "halving" ;
    vc:sourceDomain "blockchain" .

ngm:hardware-abstraction-layer a owl:Class ;
    rdfs:label "Hardware Abstraction Layer"@en ;
    rdfs:comment "A Hardware Abstraction Layer (HAL) is a software layer that presents a uniform, hardware-independent interface to upper software layers — operating systems, middleware, or application code — while encapsulating the vendor-specific, register-level details of physical devices in the implementation beneath it. By isolating hardware dependencies behind a stable API, the HAL enables the same kernel or application binary to run on different processor architectures, microcontroller families, or peripheral configurations without source-code changes. HALs appear throughout the software stack: in embedded microcontroller SDKs (STM32 HAL, Arduino abstraction), in operating-system kernels (Windows HAL.dll), in robotic middleware (ROS Hardware Interface), and in graphics stacks (Vulkan's hardware abstraction over GPU vendors). The HAL pattern is a foundational principle of portable, maintainable system software."@en ;
    rdfs:subClassOf ngm:hardware-abstraction ;
    vc:enables ngm:cross-platform-interoperability,
        ngm:operating-system ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:driver-software,
        ngm:embedded-systems,
        ngm:middleware ;
    vc:slug "hardware-abstraction-layer" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:gpu-compute,
        ngm:real-time-operating-system,
        ngm:robot-operating-system ;
    vc:uses ngm:middleware-layer,
        ngm:system-software .

ngm:home-assistant a owl:Class ;
