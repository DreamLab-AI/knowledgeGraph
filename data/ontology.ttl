    a owl:Restriction ;
    owl:onProperty ngm:relatedTo ;
    owl:someValuesFrom mv:IoTIntegration
] .

mv:RealTimeDigitalTwinSynchronization rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:relatedTo ;
