    vc:enables ngm:cross-border-payment,
        ngm:micropayment,
        ngm:payment-token,
        ngm:recurring-billing,
        ngm:x402-and-l402-payment-protocols ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:currency-conversion,
        ngm:fraud-detection,
        ngm:tokenisation ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:central-bank-digital-currency,
        ngm:digital-payment-system,
        ngm:open-banking ;
    vc:requires ngm:acquiring-bank,
