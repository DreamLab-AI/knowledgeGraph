ngm:property-schema a owl:Class ;
    rdfs:comment "A formal specification of the object properties, data properties, and annotation properties that relate classes within an ontology, including domain and range constraints, cardinality axioms, and logical characteristics such as transitivity and symmetry. Property schemas are the mechanism by which OWL2 ontologies encode typed, machine-readable relations between entities."@en ;
    rdfs:label "Property Schema"@en ;
    rdfs:subClassOf ngm:software-engineering ;
