ngm:telepresence a owl:Class ;
    rdfs:label "Telepresence"@en ;
    rdfs:comment "Telepresence is a suite of technologies and interaction paradigms that create a compelling perceptual sense of physical presence in a remote or virtual location, enabling natural communication, social interaction, and physical manipulation across geographic distance. Systems span high-definition video conferencing with matched room geometries and spatial audio, robotic telepresence platforms that provide mobile embodied presence, and fully immersive extended-reality environments that deliver volumetric representations and haptic feedback. The defining characteristic is the degree of presence — the subjective feeling of 'being there' — which depends on sensory fidelity, low latency, spatial coherence, and natural interaction affordances. Convergent advances in spatial computing, network infrastructure, and AI-driven media processing are progressively closing the gap between telepresent and co-located experience."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:volumetric-capture ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:real-time-communication ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:video-conferencing ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:display-technology ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:spatial-audio ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:haptic-feedback ],
        ngm:distributed-collaboration ;
    skos:broader ngm:distributed-collaboration ;
    vc:bridgesTo ngm:metaverse,
