# TPU
artificial-intelligence:TPU rdf:type owl:Class ;
    rdfs:subClassOf artificial-intelligence:ArtificialIntelligence ;
    rdfs:label "TPU"@en ;
    rdfs:comment "Tensor Processing Unit, Google's custom-developed application-specific integrated circuit (ASIC) optimized for neural network machine learning workloads."@en ;
    skos:prefLabel "TPU"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:artificial-intelligence:tpu" ;
