ngm:inference-infrastructure a owl:Class ;
    rdfs:label "Inference Infrastructure"@en ;
    rdfs:comment "Inference infrastructure is the stack of hardware, serving software, and orchestration used to deploy machine-learning models for low-latency, high-throughput prediction in production. It encompasses accelerator fleets, model servers, autoscaling, load balancing, batching engines, and caching layers that route requests and manage GPU memory. It is what makes real-time AI services such as search and chat economically and operationally viable at scale."@en ;
    rdfs:subClassOf ngm:ai-infrastructure ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:ai-search,
        ngm:proprietary-large-language-models ;
    vc:slug "inference-infrastructure" ;
    vc:sourceDomain "ai" .

ngm:inference-layer a owl:Class ;
    rdfs:label "Inference Layer"@en ;
    rdfs:comment "The Inference Layer is the stratum that executes trained models to produce predictions from new inputs. In the canonical stack it sits above the Model Layer and below the Middleware Layer, turning static artefacts into a live serving capability. It contains serving runtimes, batching and caching logic, and the request handling that delivers predictions."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:model-layer ],
        ngm:ai-model-architecture ;
    skos:broader ngm:ai-model-architecture ;
    vc:enables ngm:application-layer,
        ngm:middleware-layer ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:model-layer ;
    vc:slug "inference-layer" ;
    vc:sourceDomain "ai" .

ngm:instant-messaging a owl:Class ;
    rdfs:label "Instant Messaging"@en ;
    rdfs:comment "Instant messaging is a form of real-time, text-based direct communication between two or more participants over a network. Messages are delivered with minimal latency, enabling synchronous or near-synchronous conversation without the formality of email. It serves as a foundational channel for informal coordination and rapid decision-making in distributed teams."@en ;
    rdfs:subClassOf ngm:dc-communication ;
    skos:broader ngm:dc-communication ;
    vc:enables ngm:real-time-communication ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:group-chat-channel,
        ngm:mentions-and-notifications ;
    vc:slug "instant-messaging" ;
    vc:sourceDomain "distributed-collaboration" .

ngm:integration-testing a owl:Class ;
    rdfs:label "Integration Testing"@en ;
    rdfs:comment "Integration testing is a software verification phase that exercises the interfaces and interactions between combined components or systems, rather than units in isolation. It detects defects in data contracts, protocols, timing, and configuration that emerge only when modules are wired together. Sitting between unit and system testing, it is essential for catching interface mismatches before end-to-end and acceptance stages."@en ;
    rdfs:subClassOf ngm:infra-software-engineering ;
    skos:broader ngm:infra-software-engineering ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:compatibility-process,
        ngm:testing-process ;
    vc:slug "integration-testing" ;
    vc:sourceDomain "infrastructure" .

ngm:iri a owl:Class ;
    rdfs:label "IRI"@en ;
    rdfs:comment "An Internationalised Resource Identifier (IRI) is a compact string that uniquely identifies an abstract or physical resource, generalising the Uniform Resource Identifier (URI) to permit characters from the full Unicode repertoire rather than only ASCII. IRIs are the foundational naming mechanism of the Semantic Web: every node and predicate in an RDF graph is named by an IRI, allowing data published by independent parties to refer unambiguously to the same entity. An IRI may be mapped to an equivalent URI through percent-encoding, preserving compatibility with legacy web infrastructure."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:metadata ],
        ngm:linked-data ;
    vc:enables ngm:knowledge-graph,
        ngm:ontology ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:linked-data,
        ngm:rdf ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:content-identifier,
        ngm:decentralised-identifier,
        ngm:namespace,
        ngm:uri ;
    vc:requires ngm:metadata ;
    vc:slug "iri" ;
    vc:sourceDomain "data" ;
    vc:standardizedBy ngm:schema-org ;
    vc:supports ngm:sparql,
        ngm:turtle ;
    vc:uses ngm:http .

ngm:iso-8373 a owl:Class ;
    rdfs:label "ISO 8373"@en ;
    rdfs:comment "An ISO standard defining terms and vocabulary for robots and robotic devices. It establishes standardised terminology used across robotics standards, including industrial robots, service robots, manipulators, and related components."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:iso-8373-robotics-vocabulary ],
        [ a owl:Restriction ;
