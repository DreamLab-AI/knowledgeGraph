        ngm:orientation-reference ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:isPartOf ngm:attitude-determination,
        ngm:inertial-measurement-unit ;
    vc:qualityScore "0.56"^^xsd:float ;
    vc:requires ngm:bias-compensation,
        ngm:sensor-fusion ;
    vc:slug "gyroscope" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:robotics .

ngm:hallucination a owl:Class ;
    rdfs:label "Hallucination"@en ;
    rdfs:comment "In artificial intelligence, hallucination is the generation of plausible but factually incorrect or unsupported content by a model. It is a recognised failure mode of large language models and other generative systems."@en ;
    rdfs:subClassOf ngm:ai-risk ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:slug "hallucination" ;
    vc:sourceDomain "ai-safety" .

ngm:hardware-security a owl:Class ;
    rdfs:label "Hardware Security"@en ;
    rdfs:comment "Hardware security protects systems by building trust and isolation into physical components, using features such as secure enclaves, key storage and tamper resistance to defend against attacks software alone cannot stop."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:computer-hardware ],
        ngm:computer-hardware ;
    vc:enables ngm:trusted-execution-environment ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:computer-hardware ;
    vc:slug "hardware-security" ;
    vc:sourceDomain "metaverse" .

ngm:hardware-wallet a owl:Class ;
    rdfs:label "Hardware Wallet"@en ;
    rdfs:comment "A hardware wallet is a dedicated physical device that stores cryptocurrency private keys in a secure element and signs transactions internally, so the keys never leave the device or touch an internet-connected computer. It protects against malware and remote key theft by isolating signing operations behind on-device confirmation. Hardware wallets are a foundational tool for self-custody of digital assets."@en ;
    rdfs:subClassOf ngm:infra-security-and-identity ;
    skos:broader ngm:infra-security-and-identity ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:multi-sig-governance ;
    vc:slug "hardware-wallet" ;
    vc:sourceDomain "blockchain" .

ngm:harm-taxonomy a owl:Class ;
    rdfs:label "Harm Taxonomy"@en ;
    rdfs:comment "A harm taxonomy is a structured classification of the potential negative impacts arising from a technology, used to organise risk assessment and mitigation. In AI it categorises harms such as misinformation, discrimination, privacy violation, manipulation, and physical or economic damage. A clear taxonomy enables systematic red-teaming, policy mapping, and accountability for deployed systems."@en ;
    rdfs:subClassOf ngm:ai-governance-and-ethics ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:ai-risks,
        ngm:digital-society-harms ;
    vc:slug "harm-taxonomy" ;
    vc:sourceDomain "governance" .

ngm:harmonic-drive a owl:Class ;
    rdfs:label "Harmonic Drive"@en ;
    rdfs:comment "A harmonic drive is a strain-wave gearing mechanism that achieves very high reduction ratios in a compact, lightweight package with near-zero backlash. It uses a flexible spline deformed by an elliptical wave generator to mesh with a rigid outer gear, transmitting motion with high precision. Harmonic drives are widely used in robot joints, where accuracy and torque density are critical."@en ;
    rdfs:subClassOf ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:mechanical-component ;
    vc:slug "harmonic-drive" ;
    vc:sourceDomain "robotics" .

ngm:heatmap-regression a owl:Class ;
    rdfs:label "Heatmap Regression"@en ;
    rdfs:comment "Heatmap regression is a computer-vision technique for keypoint localisation in which a network predicts a 2D probability map per landmark rather than directly regressing coordinates. The peak of each predicted heatmap indicates the most likely location, and Gaussian-blurred ground-truth targets make training spatially smooth and robust. It is the dominant approach for human pose estimation and facial landmark detection."@en ;
    rdfs:subClassOf ngm:computer-vision ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:pose-estimation ;
    vc:slug "heatmap-regression" ;
    vc:sourceDomain "ai" .

ngm:hevc a owl:Class ;
    rdfs:label "HEVC"@en ;
    rdfs:comment "HEVC (High Efficiency Video Coding), also known as H.265, is a video compression standard that roughly doubles the data compression ratio of its predecessor H.264 at the same visual quality. It introduces larger, flexible coding tree units and improved prediction and entropy coding to support 4K and 8K video. As a proprietary, patent-encumbered codec it carries licensing obligations that motivate royalty-free alternatives."@en ;
    rdfs:subClassOf ngm:technical-standard ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:proprietary-video ;
    vc:slug "hevc" ;
    vc:sourceDomain "metaverse" .

ngm:historical-research a owl:Class ;
    rdfs:label "Historical Research"@en ;
    rdfs:comment "Historical research is the systematic investigation of past events, peoples, and material culture through the examination of primary and secondary sources. In digital contexts it increasingly draws on digitised archives, 3D reconstructions, and computational analysis to interpret and present the past. It provides the evidentiary and interpretive basis for cultural heritage applications such as site reconstruction and virtual museums."@en ;
    rdfs:subClassOf ngm:educational-technology ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:archaeological-site-reconstruction,
        ngm:digital-archive ;
    vc:slug "historical-research" ;
    vc:sourceDomain "metaverse" .

ngm:hodl-waves a owl:Class ;
    rdfs:label "HODL Waves"@en ;
    rdfs:comment "HODL Waves is an on-chain analytics visualisation that bands the entire Bitcoin supply by the age since each coin last moved, showing what proportion is held over various time horizons. The coloured bands reveal accumulation and distribution behaviour, distinguishing long-term holders from short-term speculators. It is a key tool for interpreting holder conviction and market cycles from blockchain data."@en ;
    rdfs:subClassOf ngm:economic-mechanism ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:bitcoin-distribution ;
    vc:slug "hodl-waves" ;
    vc:sourceDomain "blockchain" .

ngm:homeostasis a owl:Class ;
    rdfs:label "Homeostasis"@en ;
    rdfs:comment "Homeostasis is the property of a biological or engineered system by which it maintains internal state variables within a defined physiological or operational range despite external perturbations, achieved through negative feedback control loops that sense deviations from a setpoint and activate corrective effectors. It is a foundational principle of physiology, cybernetics, and adaptive control engineering."@en ;
    rdfs:subClassOf ngm:cybernetics ;
    vc:bridgesTo ngm:complex-systems ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:emergence,
        ngm:systems-theory ;
    vc:slug "homeostasis" ;
    vc:sourceDomain "science" ;
    vc:uses ngm:feedback-control,
        ngm:feedback-loop .

ngm:homomorphic-encryption-for-machine-learning a owl:Class ;
    rdfs:label "Homomorphic Encryption for Machine Learning"@en ;
    rdfs:comment "Homomorphic Encryption for Machine Learning is a cryptographic paradigm that enables arithmetic computations to be performed directly on ciphertext, so that AI model training and inference can proceed on encrypted data without any decryption step, guaranteeing that neither cloud servers nor third parties ever observe plaintext inputs, intermediate activations, or model weights. The approach relies on algebraic homomorphisms—addition and multiplication over encrypted values—combined with bootstrapping techniques to manage noise accumulation, with schemes such as CKKS targeting approximate real-number arithmetic well-suited to neural-network workloads. Applications span privacy-preserving inference, encrypted federated learning aggregation, and collaborative multi-party model training on sensitive data spanning healthcare, finance, and government."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:encryption ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptography ],
        ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:enables ngm:federated-learning,
        ngm:privacy ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:cybersecurity,
        ngm:differential-privacy,
        ngm:inference,
        ngm:model-training ;
    vc:requires ngm:cryptography,
        ngm:encryption ;
    vc:slug "homomorphic-encryption-for-machine-learning" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:data-protection,
        ngm:privacy-preserving-data-mining ;
    vc:uses ngm:machine-learning,
        ngm:secure-multi-party-computation .

ngm:human-robot-collaboration a owl:Class ;
    rdfs:label "Human-Robot Collaboration"@en ;
    rdfs:comment "Human-robot collaboration is the design and operation of robots that work alongside people in a shared workspace, coordinating tasks safely through sensing, control and interaction."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:sensor-fusion ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:human-robot-interaction ],
        ngm:robotics-domain ;
    vc:enables ngm:assistive-robotics,
        ngm:collaborative-robot ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:human-robot-interaction,
        ngm:sensor-fusion ;
    vc:slug "human-robot-collaboration" ;
    vc:sourceDomain "robotics" .

ngm:humanity-attestation a owl:Class ;
    rdfs:label "Humanity Attestation"@en ;
    rdfs:comment "Verification process that confirms a digital identity represents a human rather than an automated agent, bot, or AI system."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:biometric-verification ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:digital-identity ],
        ngm:sc-governance-and-safety ;
    skos:broader ngm:sc-governance-and-safety ;
    vc:enables ngm:account-security,
        ngm:bot-prevention,
        ngm:fraud-prevention,
        ngm:trust-establishment ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:behavioral-analysis,
        ngm:biometric-verification,
        ngm:captcha,
        ngm:challenge-response-protocol ;
    vc:isPartOf ngm:authentication-system,
        ngm:identity-verification ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:challenge-protocol,
        ngm:digital-identity,
        ngm:verification-mechanism ;
    vc:slug "humanity-attestation" ;
    vc:sourceDomain "spatial-computing" .

ngm:hybrid-retrieval a owl:Class ;
    rdfs:label "Hybrid Retrieval"@en ;
    rdfs:comment "Hybrid retrieval is an information-retrieval technique that combines lexical (sparse, keyword-based) scoring such as BM25 with semantic (dense, embedding-based) vector search to rank documents. By fusing the complementary strengths of exact-term matching and meaning-based similarity, it improves recall and precision over either method alone. Fusion is typically performed with reciprocal rank fusion or weighted score combination."@en ;
    rdfs:subClassOf ngm:information-retrieval ;
    vc:enables ngm:ai-search ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:semantic-search ;
    vc:slug "hybrid-retrieval" ;
    vc:sourceDomain "ai" .

ngm:hybrid-search a owl:Class ;
    rdfs:label "Hybrid Search"@en ;
    rdfs:comment "Hybrid search is an information retrieval approach that combines sparse lexical retrieval — typically BM25 or TF-IDF — with dense vector search over neural embeddings, fusing their complementary strengths: precise keyword matching and semantic understanding respectively. The combination consistently outperforms either method alone across diverse query types, and has become the dominant retrieval pattern underpinning Retrieval-Augmented Generation pipelines."@en ;
    rdfs:subClassOf ngm:information-retrieval ;
    vc:dependsOn ngm:deep-learning ;
    vc:enables ngm:cross-encoder-reranking,
        ngm:retrieval-augmented-generation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:neural-network,
        ngm:retrieval-augmented-generation-rag ;
    vc:slug "hybrid-search" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:bm25,
        ngm:semantic-search,
        ngm:vector-embedding .

ngm:hydraulic-motor a owl:Class ;
    rdfs:label "Hydraulic Motor"@en ;
    rdfs:comment "A Hydraulic Motor is an actuation device that converts pressurised hydraulic fluid flow into continuous rotational mechanical torque, functioning as the rotary counterpart to the hydraulic cylinder (which produces linear force). It is distinguished by extremely high power-to-weight ratio and the ability to sustain high torques at low rotational speeds without gearbox inefficiencies, making it the preferred actuator for heavy robotic joints, industrial manipulators, and mobile machinery operating in harsh environments. Common design types include gear motors, vane motors, and axial-piston motors, each offering different torque-speed-efficiency trade-offs."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:hydraulic-cylinder ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:actuator ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:servo-control ],
        ngm:hydraulic-actuator,
        ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:contrastsWith ngm:electric-actuator,
        ngm:electric-motor,
        ngm:pneumatic-motor,
        ngm:servo-motor ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:actuator ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:force-torque-sensor,
        ngm:mechanical-component,
        ngm:robotics-systems ;
    vc:requires ngm:hydraulic-cylinder,
        ngm:servo-control ;
    vc:slug "hydraulic-motor" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:robot-actuator,
        ngm:torque-control .

ngm:hyperledger-aries a owl:Class ;
    rdfs:label "Hyperledger Aries"@en ;
    rdfs:comment "Hyperledger Aries is an open-source toolkit providing the infrastructure for peer-to-peer interactions, secure messaging, and the exchange of verifiable credentials between decentralised identity agents. It implements DIDComm messaging and credential protocols, sitting above the ledger layer so that agents can issue, hold, and verify credentials independently of any specific blockchain. Aries is commonly paired with Hyperledger Indy as its verifiable-data registry."@en ;
    rdfs:subClassOf ngm:digital-identity ;
    vc:dependsOn ngm:hyperledger-indy ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:hyperledger-indy ;
    vc:slug "hyperledger-aries" ;
    vc:sourceDomain "infrastructure" .

ngm:idempotency a owl:Class ;
    rdfs:label "Idempotency"@en ;
    rdfs:comment "Idempotency is the property of an operation whereby applying it multiple times produces the same result as applying it once. In distributed systems and APIs it is essential for safe retries, ensuring that duplicated requests caused by network failures do not corrupt state or cause unintended side effects. Idempotency is commonly enforced via idempotency keys, deterministic merge functions, or naturally commutative state updates."@en ;
    rdfs:subClassOf ngm:distributed-systems ;
    vc:enables ngm:fault-tolerance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:crdt ;
    vc:slug "idempotency" ;
    vc:sourceDomain "infrastructure" .

ngm:identity-graph a owl:Class ;
    rdfs:label "Identity Graph"@en ;
    rdfs:comment "A network-based data structure representing entities, their digital identities, and relationships in a graph database optimized for identity resolution, trust scoring, and social network analysis."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptographic-keys ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:relationship-edge ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:graph-database ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:graph-database ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:identity-provider ],
        ngm:infra-security-and-identity ;
    skos:broader ngm:infra-security-and-identity ;
    vc:enables ngm:fraud-detection,
        ngm:identity-resolution,
        ngm:reputation-system,
        ngm:social-network-analysis ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:graph-database,
        ngm:identity-node,
        ngm:relationship-edge,
        ngm:trust-attribute ;
    vc:isPartOf ngm:identity-management-system,
        ngm:trust-framework ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:cryptographic-keys,
        ngm:graph-database,
        ngm:identity-provider ;
    vc:slug "identity-graph" ;
    vc:sourceDomain "infrastructure" .

ngm:identity-portability a owl:Class ;
    rdfs:label "Identity Portability"@en ;
    rdfs:comment "Identity portability is the capacity for a user to move their digital identity, credentials, and associated reputation across platforms, services, or virtual worlds without re-establishing them from scratch. It relies on interoperable identity standards and user-controlled wallets so that authentication and verified attributes remain valid across boundaries. Portability is a cornerstone of self-sovereign identity and an open metaverse."@en ;
    rdfs:subClassOf ngm:digital-identity ;
    vc:enables ngm:avatar-interoperability ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:credential-format-standard ;
    vc:slug "identity-portability" ;
    vc:sourceDomain "infrastructure" .

ngm:identity-proofing a owl:Class ;
    rdfs:label "Identity Proofing"@en ;
    rdfs:comment "Identity proofing is the process of collecting and validating evidence to establish that a claimed identity corresponds to a real, unique person before issuing credentials or granting access. It typically combines document verification, biometric checks, and authoritative-source confirmation, graded by assurance levels such as those defined in NIST SP 800-63A. Identity proofing precedes authentication and is foundational to trustworthy onboarding."@en ;
    rdfs:subClassOf ngm:identity-management ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:identity-verification ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:trust-framework ;
    vc:slug "identity-proofing" ;
    vc:sourceDomain "security" .

ngm:identity-provider-id-p a owl:Class ;
    rdfs:label "Identity Provider (IdP)"@en ;
    rdfs:comment "An authentication service system that creates, maintains, and manages identity information for principals while providing authentication services to relying party applications within a federation or distributed network."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:session-manager ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:policy-engine ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:authentication-protocol ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:credential-store ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:user-directory ],
        ngm:infra-security-and-identity ;
    skos:broader ngm:infra-security-and-identity ;
    vc:enables ngm:access-control,
        ngm:identity-federation,
        ngm:multi-factor-authentication,
        ngm:single-sign-on-sso,
        ngm:user-provisioning ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:authentication-server,
        ngm:credential-store,
        ngm:policy-engine,
        ngm:session-manager,
        ngm:token-issuer,
        ngm:user-directory ;
    vc:isPartOf ngm:federation-infrastructure,
        ngm:identity-management-system ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:authentication-protocol,
        ngm:cryptographic-key-store,
        ngm:user-database ;
    vc:slug "identity-provider-id-p" ;
    vc:sourceDomain "infrastructure" .

ngm:ieee-1872 a owl:Class ;
    rdfs:label "IEEE 1872"@en ;
    rdfs:comment "IEEE 1872 defines an ontology for robotics and automation, providing a standard vocabulary and structure for representing knowledge in that domain."@en ;
