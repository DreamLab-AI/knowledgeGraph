ngm:content-delivery-network a owl:Class ;
    rdfs:label "Content Delivery Network"@en ;
    rdfs:comment "A Content Delivery Network (CDN) is a geographically distributed system of edge servers and Points of Presence (PoPs) that cache, replicate, and serve web assets — static files, media streams, and increasingly dynamic API responses — from locations physically near end users, substantially reducing round-trip latency and offloading origin-server load. CDNs use anycast routing, DNS-based request steering, and intelligent load balancing to direct each client request to the nearest healthy PoP, with cache coherence governed by HTTP cache-control semantics (RFC 9111) and conditional request mechanisms. Modern CDNs have evolved into full edge-compute platforms, offering TLS termination, DDoS mitigation, Web Application Firewall (WAF) services, and serverless edge runtimes (e.g. Cloudflare Workers, Fastly Compute) that execute application logic at PoPs without origin round-trips, blurring the boundary between network infrastructure and distributed application hosting."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:dns ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:tls ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:web-application-firewall ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:load-balancer ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:anycast-routing ],
        ngm:network-infrastructure ;
    vc:bridgesTo ngm:edge-inference,
        ngm:spatial-computing ;
    vc:contrastsWith ngm:origin-server,
        ngm:peer-to-peer-network ;
    vc:enables ngm:ddos-mitigation,
        ngm:edge-computing,
        ngm:low-latency ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:edge-server,
        ngm:load-balancer,
        ngm:point-of-presence,
        ngm:web-application-firewall ;
    vc:isPartOf ngm:internet-infrastructure ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:caching,
        ngm:network-latency,
        ngm:reverse-proxy ;
    vc:requires ngm:anycast-routing,
        ngm:dns,
        ngm:tls ;
    vc:slug "content-delivery-network" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:cloud-infrastructure,
        ngm:microservices-architecture,
        ngm:scalability-pattern,
        ngm:streaming-media ;
    vc:uses ngm:anycast-routing,
        ngm:encryption,
        ngm:http-caching,
        ngm:quic .

ngm:feature-engineering a owl:Class ;
    rdfs:label "Feature Engineering"@en ;
    rdfs:comment "The process of using domain knowledge and statistical transformations to construct, select, and encode input variables from raw data so that they better represent the underlying predictive signal for machine learning models. Techniques include polynomial expansion, normalisation, temporal feature extraction, embedding of categorical variables, and dimensionality reduction via PCA or autoencoders."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:exploratory-data-analysis ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-preprocessing ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:feature-selection ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:dimensionality-reduction ],
        ngm:data-preprocessing ;
    vc:bridgesTo ngm:autonomous-robot,
        ngm:digital-twin ;
    vc:contrastsWith ngm:end-to-end-learning,
        ngm:representation-learning ;
    vc:dependsOn ngm:data-pipeline ;
    vc:enables ngm:machine-learning-discipline,
        ngm:model-training,
        ngm:predictive-modelling ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:dimensionality-reduction,
        ngm:feature-selection ;
    vc:isPartOf ngm:auto-ml,
        ngm:machine-learning-discipline-pipeline ;
    vc:qualityScore "0.68"^^xsd:float ;
    vc:relatedTo ngm:data-augmentation,
        ngm:feature-store,
        ngm:shap ;
    vc:requires ngm:data-preprocessing,
        ngm:exploratory-data-analysis ;
    vc:slug "feature-engineering" ;
    vc:sourceDomain "machine-learning" ;
    vc:supports ngm:deep-learning,
        ngm:transfer-learning ;
    vc:uses ngm:autoencoder,
        ngm:data-pipeline,
        ngm:principal-component-analysis .

ngm:bayesian-inference a owl:Class ;
    rdfs:label "Bayesian Inference"@en ;
    rdfs:comment "Bayesian Inference is a principled statistical framework that updates the probability of a hypothesis as new evidence is observed, using Bayes' theorem to combine a prior distribution over parameters with a likelihood function derived from data to yield a posterior distribution. Unlike frequentist methods, it treats probability as a degree of belief and propagates uncertainty through every step of reasoning, enabling calibrated predictions and natural model comparison via marginal likelihoods. In machine learning, it underpins probabilistic graphical models, Gaussian processes, Bayesian neural networks, variational inference, and Markov Chain Monte Carlo methods. Its capacity to incorporate domain knowledge through priors and to quantify epistemic uncertainty makes it foundational for safety-critical AI, active learning, and sequential decision-making."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:probability-theory ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:posterior-distribution ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:markov-chain-monte-carlo ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:prior-distribution ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:likelihood-function ],
        ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:bridgesTo ngm:causal-inference,
        ngm:decision-theory ;
    vc:contrastsWith ngm:maximum-likelihood-estimation ;
    vc:enables ngm:active-learning,
        ngm:anomaly-detection,
        ngm:model-selection,
        ngm:uncertainty-quantification ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:likelihood-function,
        ngm:markov-chain-monte-carlo,
        ngm:posterior-distribution,
        ngm:prior-distribution ;
    vc:implements ngm:bayes-theorem ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:deep-learning,
        ngm:gaussian-process,
        ngm:graphical-model,
        ngm:information-theory ;
    vc:requires ngm:probability-theory,
        ngm:statistical-model ;
    vc:slug "bayesian-inference" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:machine-learning,
        ngm:natural-language-processing,
        ngm:reinforcement-learning ;
    vc:uses ngm:expectation-maximisation,
        ngm:knowledge-representation,
        ngm:variational-inference .

ngm:control-system a owl:Class ;
    rdfs:label "Control System"@en ;
    rdfs:comment "Control system encompasses the computational and hardware subsystems that sense environmental state, evaluate performance against desired objectives, and generate actuation commands to regulate robot behaviour toward goals."@en ;
