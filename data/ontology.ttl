ngm:centralised-exchange a owl:Class ;
    rdfs:label "Centralised Exchange"@en ;
    rdfs:comment "A centralised exchange (CEX) is a custodial trading venue operated by a single company that matches buy and sell orders for cryptocurrencies and other assets through an internal order book. Users deposit funds into accounts the operator controls, and the exchange maintains the ledger of balances off-chain, settling trades internally rather than on a public blockchain. Centralised exchanges typically enforce identity verification and provide high liquidity and fast execution, at the cost of requiring trust in the operator."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:custody ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:kyc ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:order-book ],
        ngm:financial-infrastructure ;
    vc:contrastsWith ngm:decentralised-exchange ;
    vc:enables ngm:liquidity ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:order-book ;
    vc:implements ngm:aml ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:binance,
        ngm:blockchain,
        ngm:coinbase,
        ngm:financial-services ;
    vc:requires ngm:custody,
        ngm:kyc ;
    vc:slug "centralised-exchange" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:liquidity ;
    vc:uses ngm:identity-verification .

ngm:chain-of-custody a owl:Class ;
    rdfs:label "Chain of Custody"@en ;
    rdfs:comment "Chain of Custody is a documented, unbroken sequence of records that tracks the possession, handling, transfer, analysis, and disposition of physical or digital items from their point of origin to their ultimate use—most critically in legal proceedings and regulated industries. Each handoff event must be recorded with the identity of the parties involved, the time and location of transfer, and the state of the item, ensuring that the integrity and authenticity of the item can be demonstrated to any subsequent examiner. In digital contexts the concept extends to data provenance, AI training datasets, and blockchain-based asset transfer records."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:custody ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:tamper-detection ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptographic-hash-function ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:audit-logging ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:identity-verification ],
        ngm:provenance-tracking ;
    vc:bridgesTo ngm:blockchain-provenance,
        ngm:data-lineage ;
    vc:contrastsWith ngm:record-keeping ;
    vc:dependsOn ngm:access-control,
        ngm:trusted-timestamping ;
    vc:enables ngm:compliance-verification,
        ngm:legal-evidence,
        ngm:provenance-verification ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:custody,
        ngm:tamper-detection ;
    vc:implements ngm:non-repudiation ;
    vc:isPartOf ngm:compliance-framework,
        ngm:evidence-management ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:data-provenance,
        ngm:digital-evidence-chain-of-custody ;
    vc:requires ngm:audit-logging,
        ngm:cryptographic-hash-function,
        ngm:identity-verification ;
    vc:slug "chain-of-custody" ;
    vc:sourceDomain "security" ;
    vc:supports ngm:data-governance,
        ngm:digital-forensics,
        ngm:supply-chain-traceability ;
    vc:uses ngm:audit-trail,
