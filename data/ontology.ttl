# Privacy
spatial-computing:Privacy rdf:type owl:Class ;
    rdfs:label "Privacy"@en ;
    rdfs:comment "The protection of personal information and individual autonomy in AI systems, encompassing data minimization, purpose limitation, transparency, and individual control over how personal data is collected, processed, stored, and shared throughout the AI lifecycle."@en ;
    skos:prefLabel "Privacy"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:spatial-computing:privacy" ;
    owl:sameAs <urn:visionclaw:concept:spatial-computing:privacy> ;
