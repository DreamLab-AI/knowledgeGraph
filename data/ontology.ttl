ngm:tracking-hardware a owl:Class ;
    rdfs:label "Tracking Hardware"@en ;
    rdfs:comment "Tracking Hardware comprises the physical sensors and devices used to determine the position and orientation of users, controllers, and objects within spatial computing environments. This includes inertial measurement units, optical trackers, hand-tracking cameras, eye-tracking modules, and SLAM-based inside-out tracking systems that together provide the 6-DoF pose data essential for immersive VR/AR experiences."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:inertial-measurement-unit ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:optical-tracking ],
        ngm:sc-interaction ;
    skos:broader ngm:sc-interaction ;
    vc:bridgesTo ngm:tracking-technology ;
    vc:enables ngm:eye-tracking,
        ngm:hand-tracking ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:inertial-measurement-unit,
        ngm:optical-tracking ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:slug "tracking-hardware" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:sensor-fusion,
        ngm:slam .

ngm:traditional-corporation a owl:Class ;
    rdfs:label "Traditional Corporation"@en ;
    rdfs:comment "A traditional corporation is a centralised legal entity owned by shareholders and directed by a board, granting limited liability and a hierarchical management structure under company law. Decision-making authority and capital are concentrated, with accountability mediated through fiduciary duties and regulatory oversight. It is the conventional organisational form against which decentralised autonomous organisations are contrasted."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:fiduciary-duty ],
        ngm:governance ;
    vc:bridgesTo ngm:rule-of-law ;
    vc:contrastsWith ngm:dao,
        ngm:decentralized-governance ;
    vc:dependsOn ngm:fiduciary-duty ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:isPartOf ngm:governance ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:accountability,
        ngm:fiduciary-duty,
        ngm:governance,
        ngm:treasury-management ;
    vc:requires ngm:fiduciary-duty ;
    vc:slug "traditional-corporation" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:accountability ;
    vc:uses ngm:treasury-management .

ngm:traditional-securities a owl:Class ;
    rdfs:label "Traditional Securities"@en ;
    rdfs:comment "Traditional Securities are conventional financial instruments such as equities, bonds and fund units that are issued, held and transferred through established centralised market infrastructure including exchanges, central securities depositories and custodians. They represent legal claims on assets or income and are governed by long-standing securities regulation. In blockchain discourse they form the baseline against which tokenised and on-chain security tokens are compared."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:regulatory-conformance ],
        ngm:blockchain ;
    skos:broader ngm:blockchain ;
    vc:bridgesTo ngm:asset-tokenization,
        ngm:security-token ;
    vc:contrastsWith ngm:asset-tokenization,
        ngm:security-token ;
    vc:dependsOn ngm:centralised-exchange ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:isPartOf ngm:capital-markets ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:capital-markets,
        ngm:centralised-exchange ;
    vc:requires ngm:regulatory-conformance ;
    vc:slug "traditional-securities" ;
    vc:sourceDomain "blockchain" ;
    vc:standardizedBy ngm:regulatory-conformance ;
    vc:supports ngm:capital-markets .

ngm:traffic-shaping a skos:Concept ;
    rdfs:label "Traffic Shaping"@en .

ngm:training-data-repository a owl:Class ;
    rdfs:label "Training Data Repository"@en ;
    rdfs:comment "A centralized or distributed storage system for collecting, organizing, versioning, and managing datasets used to train AI and machine learning models, including data provenance tracking, quality assurance, and access control."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
