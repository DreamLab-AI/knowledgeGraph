    vc:isPartOf ngm:governance,
        ngm:public-policy ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:audit,
        ngm:certification,
        ngm:licensing ;
    vc:requires ngm:accountability,
        ngm:compliance,
