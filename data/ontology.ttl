ngm:mu-sig-2 a owl:Class ;
    rdfs:label "MuSig2"@en ;
    rdfs:comment "MuSig2 is a two-round multi-signature protocol for the Schnorr signature scheme, enabling a group of signers to collaboratively produce a single aggregate signature and a single aggregate public key that are indistinguishable on-chain from a standard single-signer Schnorr signature. It improves upon the original MuSig (three-round) by eliminating one communication round without sacrificing security, using a technique of committing to multiple nonces per signer and computing a linear combination of those nonces after seeing all co-signers' commitments. The scheme is proven secure in the random oracle model under the discrete logarithm assumption and is resistant to the rogue-key and Wagner attacks that affect naive key-aggregation approaches."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:elliptic-curve-cryptography ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:schnorr-signatures ],
        ngm:multisignature ;
    vc:bridgesTo ngm:decentralised-autonomous-organisation,
        ngm:secure-multi-party-computation ;
    vc:contrastsWith ngm:ecdsa-multisig,
        ngm:frost,
        ngm:musig,
        ngm:shamir-secret-sharing ;
    vc:enables ngm:collaborative-custody,
        ngm:privacy-preserving-transactions,
        ngm:taproot,
        ngm:threshold-signatures ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:bip-327,
        ngm:key-aggregation-protocol ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:adaptor-signatures,
        ngm:digital-signature,
        ngm:discrete-logarithm,
        ngm:proof-of-work,
        ngm:script-less-contracts ;
    vc:requires ngm:elliptic-curve-cryptography,
        ngm:key-aggregation,
        ngm:nonce-commitment,
        ngm:schnorr-signatures ;
    vc:slug "mu-sig-2" ;
    vc:sourceDomain "security" ;
    vc:standardizedBy ngm:bitcoin-improvement-proposal ;
    vc:supports ngm:bitcoin,
        ngm:hardware-wallet,
        ngm:lightning-network ;
    vc:uses ngm:hash-function,
        ngm:random-oracle-model,
        ngm:secp256k1 .

ngm:multi-signature-scheme a skos:Concept ;
    rdfs:label "Multi Signature Scheme"@en .

ngm:multimodal-ai-architecture-models a owl:Class ;
    rdfs:label "Multimodal Models"@en ;
    rdfs:comment "Multimodal models are machine learning architectures that jointly process, align, and reason over information from two or more distinct data modalities — such as text, images, audio, video, or depth — within a unified model. They learn shared or bridged representations that enable cross-modal tasks including visual question answering, image captioning, speech recognition conditioned on vision, and text-to-image synthesis. These models extend unimodal foundations (typically large language models or vision encoders) by integrating modality-specific encoders or tokenisers with cross-attention or projection layers that align heterogeneous feature spaces. Multimodal models represent the convergence of natural language processing, computer vision, and speech processing into a single, generalist AI paradigm."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:transformer ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cross-attention ],
        ngm:multimodal-ai-architecture-ai ;
    vc:bridgesTo ngm:human-computer-interaction,
        ngm:spatial-computing ;
    vc:contrastsWith ngm:modality-specific-pipeline,
        ngm:unimodal-models ;
    vc:dependsOn ngm:foundation-models,
        ngm:self-supervised-learning ;
    vc:enables ngm:audio-visual-speech-recognition,
        ngm:image-captioning,
        ngm:multimodal-retrieval,
        ngm:text-to-image,
        ngm:visual-question-answering ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:modality-specific-encoder,
        ngm:multimodal-decoder,
        ngm:projection-layer ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:clip,
        ngm:diffusion-models,
        ngm:instruction-tuning ;
    vc:requires ngm:cross-attention,
        ngm:paired-training-data,
        ngm:transformer ;
    vc:slug "multimodal-models" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:contrastive-learning,
        ngm:embedding-space,
        ngm:large-language-model,
        ngm:vision-encoder .

