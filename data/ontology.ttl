ngm:latent-diffusion-model-training a owl:Class ;
    rdfs:label "Latent Diffusion Model Training"@en ;
    rdfs:comment "Stable Diffusion training is the process of fitting a latent text-to-image diffusion model by teaching a denoising network to reverse a gradual noising process in a compressed latent space, conditioned on text embeddings. Operating in latent rather than pixel space sharply reduces compute and memory, while techniques such as fine-tuning, LoRA, and DreamBooth adapt a base model to new styles or subjects. It underpins much of open-weight generative image and video tooling."@en ;
    rdfs:subClassOf ngm:generative-model ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:fast-ai,
        ngm:proprietary-ai-video ;
    vc:slug "latent-diffusion-model-training" ;
    vc:sourceDomain "ai" .

ngm:lattice-based-cryptography a skos:Concept ;
    rdfs:label "Lattice Based Cryptography"@en .

ngm:law-enforcement-access a owl:Class ;
    rdfs:label "Law Enforcement Access"@en ;
    rdfs:comment "Law enforcement access refers to the legally authorised mechanisms by which police and regulatory authorities obtain data, records or information held by service providers for investigation and prosecution. In financial and crypto contexts it covers lawful requests for customer and transaction information under court orders, subpoenas or statutory disclosure rules such as the FATF Travel Rule. It sits at the intersection of compliance obligations and privacy safeguards."@en ;
    rdfs:subClassOf ngm:regulatory-compliance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:travel-rule ;
    vc:slug "law-enforcement-access" ;
    vc:sourceDomain "governance" .

ngm:layer-2-security-council a owl:Class ;
    rdfs:label "Layer 2 Security Council"@en ;
    rdfs:comment "A Layer 2 Security Council is a designated multi-signature governance body empowered to take privileged actions on a Layer 2 rollup, such as pausing the bridge, executing emergency upgrades, or resolving stuck states during the maturation period before fully trustless operation. It typically comprises a quorum of independent signers from distinct organisations to mitigate single-party capture. The construct trades some decentralisation for the ability to respond rapidly to critical vulnerabilities."@en ;
    rdfs:subClassOf ngm:bc-governance-and-regulation ;
    skos:broader ngm:bc-governance-and-regulation ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:multi-sig-governance ;
    vc:slug "layer-2-security-council" ;
    vc:sourceDomain "blockchain" .

ngm:layer-zero a owl:Class ;
    rdfs:label "LayerZero"@en ;
    rdfs:comment "LayerZero is a cross-chain interoperability protocol that allows smart contracts on different blockchains to send messages to one another. It uses a configurable security model in which an oracle delivers block headers and an independent relayer delivers transaction proofs, with a message accepted only when the two agree. This separation is intended to avoid reliance on a single intermediary chain for verifying cross-chain communication."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:smart-contract ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:relayer ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:oracle ],
        ngm:blockchain ;
    skos:broader ngm:blockchain ;
    vc:bridgesTo ngm:bridge,
        ngm:distributed-systems,
        ngm:interoperability ;
    vc:contrastsWith ngm:axelar,
        ngm:ibc-protocol,
        ngm:polkadot-xcm,
        ngm:wormhole ;
    vc:dependsOn ngm:decentralized-oracle-network,
        ngm:evm-compatible-blockchain ;
    vc:enables ngm:cross-chain-governance,
        ngm:cross-chain-messaging,
        ngm:omnichain-application,
        ngm:token-bridge ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:cross-chain-interoperability-protocol,
        ngm:message-passing-interface ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:blockchain-security,
        ngm:omni-fungible-token,
        ngm:stargate-finance ;
    vc:requires ngm:endpoint-contract,
        ngm:oracle,
        ngm:relayer,
        ngm:smart-contract ;
    vc:slug "layer-zero" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:cross-chain-liquidity,
        ngm:defi-protocol,
        ngm:nft-bridging ;
    vc:uses ngm:block-header,
        ngm:transaction-proof,
        ngm:ultra-light-node .

