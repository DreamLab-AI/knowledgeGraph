ngm:ondo-finance a owl:Class ;
    rdfs:label "Ondo Finance"@en ;
    rdfs:comment "Ondo Finance is a company that issues tokenised versions of traditional financial products, including funds holding US Treasury securities, on public blockchains."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:neural-network-text-tokenisation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:asset-tokenisation ],
        ngm:asset-tokenisation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:asset-tokenisation,
        ngm:neural-network-text-tokenisation ;
    vc:slug "ondo-finance" ;
    vc:sourceDomain "blockchain" .

