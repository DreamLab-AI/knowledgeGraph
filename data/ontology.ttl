    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:relatedTo ngm:intellectual-property-rights-framework ;
    vc:requires ngm:digital-rights ;
    vc:slug "content-protection" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:access-control,
        ngm:digital-rights-management,
        ngm:encryption .

