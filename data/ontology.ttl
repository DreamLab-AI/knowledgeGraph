ngm:scalable-deployment a owl:Class ;
    rdfs:comment "Scalable deployment is the practice of releasing and operating software so that capacity can grow or shrink with demand without redesign. It relies on stateless services, horizontal scaling, load balancing, container orchestration, and infrastructure-as-code to add resources elastically. It is essential for systems such as digital twins that must serve fluctuating workloads reliably."@en ;
    rdfs:label "Scalable Deployment"@en ;
    rdfs:subClassOf ngm:infra-computing-and-cloud ;
