ngm:runtime-environment a owl:Class ;
    rdfs:label "Runtime Environment"@en ;
    rdfs:comment "A Runtime Environment is the integrated set of software components, libraries, and managed services that provide the execution context in which application code operates at run time, encompassing memory management, instruction dispatch, system-call mediation, and API surface exposure. It abstracts the underlying hardware and operating system to deliver a consistent, portable execution substrate — whether a bytecode interpreter, a just-in-time compiler, a managed virtual machine, or a native process sandbox. Runtime environments coordinate lifecycle events (initialisation, garbage collection, signal handling, graceful shutdown) and expose introspection facilities such as profilers, debuggers, and telemetry hooks. They are foundational to cloud-native, edge, and immersive computing stacks, underpinning containerised microservices, WebAssembly workloads, game engine scripting layers, and on-device AI inference pipelines."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:operating-system ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:hardware-abstraction-layer ],
        ngm:infra-computing-and-cloud ;
    skos:broader ngm:infra-computing-and-cloud ;
    vc:bridgesTo ngm:machine-learning-inference,
        ngm:spatial-computing ;
    vc:contrastsWith ngm:bare-metal-execution,
        ngm:compile-time-environment ;
    vc:dependsOn ngm:instruction-set-architecture,
        ngm:process-scheduler ;
    vc:enables ngm:containerisation,
        ngm:edge-computing,
        ngm:game-engine,
        ngm:scripting-language,
        ngm:serverless-computing ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:garbage-collector,
        ngm:just-in-time-compiler,
        ngm:memory-management,
        ngm:standard-library ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:execution-model,
        ngm:software-development-kit ;
    vc:requires ngm:hardware-abstraction-layer,
        ngm:operating-system ;
    vc:slug "runtime-environment" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:3-d-rendering-engine,
        ngm:cross-platform-interoperability,
        ngm:debugging,
        ngm:on-device-inference ;
    vc:uses ngm:application-programming-interface,
        ngm:virtual-machine,
        ngm:web-assembly .

ngm:secure-communication a owl:Class ;
    rdfs:label "Secure Communication"@en ;
    rdfs:comment "Secure communication is the practice and set of technologies that protect the confidentiality, integrity, and authenticity of information exchanged between parties over potentially adversarial networks, ensuring that eavesdroppers cannot read message content, tamperers cannot alter it undetected, and impersonators cannot forge the identity of legitimate participants. The discipline encompasses transport-layer security protocols (TLS, DTLS, QUIC with TLS), end-to-end encryption protocols (Signal Protocol, MLS, Matrix), secure messaging standards (S/MIME, PGP), VPN tunnelling (IPsec, WireGuard), and the cryptographic primitives—asymmetric key exchange, symmetric cipher suites, authenticated encryption, and digital signatures—that underpin them. Security properties are formally analysed through cryptographic protocol proofs and verified implementations."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:certificate-authority ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:authentication ],
        ngm:cryptographic-protocol ;
    vc:bridgesTo ngm:data-governance,
        ngm:iot-security ;
    vc:contrastsWith ngm:plaintext-communication ;
    vc:dependsOn ngm:post-quantum-cryptography ;
    vc:enables ngm:confidential-computing,
        ngm:privacy,
        ngm:secure-remote-access,
        ngm:zero-trust-architecture ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:end-to-end-encryption,
        ngm:signal-protocol,
        ngm:vpn ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:cryptographic-security,
        ngm:network-security,
        ngm:tls-encryption ;
    vc:requires ngm:authentication,
        ngm:certificate-authority,
        ngm:forward-secrecy ;
    vc:slug "secure-communication" ;
    vc:sourceDomain "security" ;
    vc:standardizedBy ngm:ietf,
        ngm:nist ;
    vc:uses ngm:authenticated-encryption,
        ngm:cryptographic-key-management,
        ngm:digital-signature,
        ngm:encryption,
        ngm:key-exchange,
        ngm:public-key-infrastructure,
        ngm:tls .

ngm:service-discovery a owl:Class ;
    rdfs:label "Service Discovery"@en ;
    rdfs:comment "Service discovery is the runtime mechanism by which distributed applications automatically locate the network endpoints of services they depend on, without relying on hardcoded addresses or manual configuration. It operates through a service registry that maintains a dynamic catalogue of available service instances alongside their health status, enabling clients to resolve service names to live endpoints at query time. Discovery patterns divide into client-side discovery, where the consumer queries the registry directly and selects from returned healthy instances, and server-side discovery, where a load balancer or API gateway mediates resolution transparently. It is a foundational pattern in microservices and cloud-native architectures, enabling dynamic scaling, zero-downtime rolling updates, and fault-tolerant inter-service communication."@en ;
    rdfs:subClassOf ngm:distributed-system-architecture ;
    vc:bridgesTo ngm:ai-agent,
        ngm:tool-use ;
    vc:contrastsWith ngm:monolithic-architecture,
        ngm:static-configuration ;
    vc:dependsOn ngm:consensus-algorithm,
        ngm:dns,
        ngm:load-balancing ;
    vc:enables ngm:fault-tolerance,
        ngm:horizontal-scaling,
        ngm:operational-resilience,
        ngm:zero-downtime-deployment ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:health-check,
        ngm:service-registration,
        ngm:service-registry ;
    vc:isPartOf ngm:cloud-native-computing,
        ngm:microservices-architecture ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:circuit-breaker,
        ngm:configuration-management,
        ngm:distributed-systems,
        ngm:orchestration,
        ngm:sidecar-proxy ;
    vc:requires ngm:network-addressing,
        ngm:service-registry ;
    vc:slug "service-discovery" ;
    vc:sourceDomain "distributed-systems" ;
    vc:supports ngm:container-orchestration,
        ngm:distributed-system,
        ngm:microservices ;
    vc:uses ngm:api-gateway,
        ngm:kubernetes,
        ngm:service-mesh .

ngm:sim-to-real-transfer a owl:Class ;
    rdfs:label "Sim-to-Real Transfer"@en ;
    rdfs:comment "Sim-to-real transfer is the set of techniques and methodologies for training robotic policies, perception models, and control algorithms inside physics simulators and then deploying the resulting models on physical hardware with acceptable performance degradation. The fundamental barrier is the reality gap: discrepancies in physics fidelity, contact dynamics, sensor noise characteristics, visual appearance, and actuator latency cause policies optimised entirely in simulation to fail on real systems. Mitigation strategies include domain randomisation, domain adaptation, system identification, adaptive dynamics models, and photorealistic rendering to progressively close this gap. The field sits at the intersection of reinforcement learning, robot learning, and transfer learning, and underpins practical large-scale autonomous system deployment."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:physics-engine ],
        ngm:transfer-learning ;
    vc:bridgesTo ngm:digital-twin,
        ngm:embodied-ai ;
    vc:contrastsWith ngm:imitation-learning,
        ngm:real-world-robot-learning ;
    vc:dependsOn ngm:domain-adaptation,
        ngm:transfer-learning ;
    vc:enables ngm:autonomous-manipulation,
        ngm:autonomous-navigation,
        ngm:legged-locomotion,
        ngm:robot-learning ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:generative-adversarial-network,
        ngm:model-based-reinforcement-learning,
        ngm:photorealistic-rendering,
        ngm:policy-gradient,
        ngm:reality-gap ;
    vc:requires ngm:physics-engine,
        ngm:robot-simulation-environment ;
    vc:slug "sim-to-real-transfer" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:domain-randomisation,
        ngm:physics-simulation,
        ngm:reinforcement-learning,
        ngm:simulation,
        ngm:synthetic-data,
        ngm:system-identification .

ngm:supply-chain-provenance a owl:Class ;
    rdfs:label "Supply Chain Provenance"@en ;
    rdfs:comment "Supply chain provenance is the verified documentary record of an item's origin, material composition, transformation steps, custody changes, and transportation history from raw material extraction through to the end consumer, enabling authenticity verification, ethical sourcing attestation, and regulatory compliance. It extends data provenance principles to physical goods, typically combining IoT sensor data, third-party audit records, and cryptographic anchors (hashes or blockchain transactions) to create an immutable chain of evidence that resists falsification and supports granular attribution."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-integrity ],
        ngm:provenance-tracking ;
    vc:bridgesTo ngm:zero-knowledge-proof ;
    vc:contrastsWith ngm:self-reported-origin ;
    vc:enables ngm:anti-counterfeiting,
        ngm:ethical-sourcing,
        ngm:regulatory-compliance,
        ngm:supply-chain-transparency ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:epcis,
        ngm:gs1-standards ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:chain-of-custody,
        ngm:conflict-minerals,
        ngm:digital-product-passport,
        ngm:supply-chain,
        ngm:supply-chain-traceability ;
    vc:requires ngm:data-integrity,
        ngm:unique-identifier ;
    vc:slug "supply-chain-provenance" ;
    vc:sourceDomain "supply-chain" ;
    vc:standardizedBy ngm:gs1-digital-link,
        ngm:w3c-provenance ;
    vc:supports ngm:esg-reporting,
        ngm:food-safety,
        ngm:provenance-verification ;
    vc:uses ngm:audit-trail,
        ngm:cryptographic-hashing,
        ngm:decentralized-identifiers,
        ngm:iot-sensor-data,
        ngm:supply-chain-blockchain,
        ngm:verifiable-credentials .

ngm:tensor-processing-unit a owl:Class ;
    rdfs:label "Tensor Processing Unit"@en ;
    rdfs:comment "A Tensor Processing Unit (TPU) is Google's custom application-specific integrated circuit (ASIC) designed to accelerate machine learning workloads, particularly tensor operations in deep neural network training and inference. Built around a systolic array architecture for highly efficient matrix multiplication, TPUs prioritise throughput and power efficiency over general-purpose flexibility, and have been instrumental in training large-scale models such as BERT, PaLM, and Gemini."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:high-bandwidth-memory ],
        ngm:inference-hardware ;
    vc:bridgesTo ngm:cloud-computing,
        ngm:edge-computing ;
    vc:contrastsWith ngm:field-programmable-gate-array,
        ngm:graphics-processing-unit,
        ngm:intelligence-processing-unit ;
    vc:dependsOn ngm:bfloat16,
        ngm:google-cloud-platform ;
    vc:enables ngm:deep-learning-training,
        ngm:large-language-models,
        ngm:neural-network-inference,
        ngm:transformer-models ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:high-bandwidth-memory,
        ngm:matrix-multiply-unit,
        ngm:systolic-array ;
    vc:implements ngm:asic-design,
        ngm:matrix-multiplication ;
    vc:isPartOf ngm:ai-infrastructure,
        ngm:tpu-pod ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:model-parallelism,
        ngm:neural-processing-unit ;
    vc:requires ngm:tensorflow,
        ngm:xla-compiler ;
    vc:slug "tensor-processing-unit" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:natural-language-processing,
        ngm:reinforcement-learning ;
    vc:uses ngm:inter-chip-interconnect,
        ngm:jax .

ngm:timelock a owl:Class ;
    rdfs:label "Timelock"@en ;
    rdfs:comment "A timelock is a cryptographic or smart-contract mechanism that prevents a transaction, function call, or asset transfer from executing until a specified block height or Unix timestamp has been reached. Timelocks enforce temporal constraints on blockchain operations, separating the proposal of an action from its execution to allow inspection, challenge, or cancellation during a mandatory delay window."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:access-control-module ],
        ngm:smart-contract ;
    vc:bridgesTo ngm:layer-2-rollup,
        ngm:regulatory-compliance ;
    vc:contrastsWith ngm:flashloan,
        ngm:immediate-execution ;
    vc:dependsOn ngm:evm-smart-contract,
        ngm:role-based-access-control ;
    vc:enables ngm:decentralized-governance,
        ngm:fraud-proof-window,
        ngm:on-chain-governance,
        ngm:optimistic-governance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:cancellation-window,
        ngm:execution-delay,
        ngm:operation-queue ;
    vc:implements ngm:bitcoin-script,
        ngm:time-release-encryption ;
    vc:isPartOf ngm:dao-treasury,
        ngm:protocol-upgrade-pipeline ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:atomic-swap,
        ngm:escrow-system,
        ngm:governance-token,
        ngm:htlc,
        ngm:vesting-schedule ;
    vc:requires ngm:access-control-module,
        ngm:block-timestamp ;
    vc:slug "timelock" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:cryptographic-hash,
        ngm:multisignature .

ngm:trade-finance a owl:Class ;
    rdfs:label "Trade Finance"@en ;
    rdfs:comment "Trade finance encompasses the financial instruments, products, and mechanisms that facilitate domestic and international commercial transactions by managing the payment, credit, and risk gap between exporter shipment and importer receipt. Core instruments include letters of credit, bank guarantees, documentary collections, supply chain financing, factoring, and forfaiting, all structured to give exporters payment certainty and importers time to generate revenue from goods before settling. Trade finance is a foundational segment of global banking, representing approximately $9 trillion in annual transaction volume, and is undergoing significant digitisation through blockchain-based platforms, electronic bills of lading, and smart contract automation."@en ;
    rdfs:subClassOf ngm:financial-services ;
    vc:dependsOn ngm:compliance-framework,
        ngm:fatf,
        ngm:financial-regulation ;
    vc:enables ngm:customs-trade-facilitation,
        ngm:importer,
        ngm:supply-chain-management,
        ngm:supply-chain-traceability ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:cross-border-payments,
        ngm:financial-instruments,
        ngm:payment-system,
        ngm:supply-chain,
        ngm:supply-chain-blockchain ;
    vc:slug "trade-finance" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:digital-asset-standards,
        ngm:logistics-optimization ;
    vc:uses ngm:aml-kyc-compliance,
        ngm:blockchain-application,
        ngm:cryptographic-verification,
        ngm:smart-contract,
        ngm:smart-contracts .

ngm:utxo a owl:Class ;
    rdfs:label "UTXO"@en ;
    rdfs:comment "UTXO (Unspent Transaction Output) is an accounting model used by Bitcoin and several other blockchains in which the ledger state consists of discrete unspent outputs rather than account balances. Each transaction consumes one or more existing unspent outputs as inputs and creates new outputs, and a coin is simply an output that has not yet been spent. Ownership is established by satisfying the locking script attached to an output, typically by providing a valid signature. The model contrasts with the account-based approach used by Ethereum and supports straightforward parallel validation and privacy techniques."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:digital-signature ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptographic-hash-function ],
        ngm:blockchain ;
    skos:broader ngm:blockchain ;
    vc:bridgesTo ngm:extended-utxo-model,
        ngm:lightning-network ;
    vc:contrastsWith ngm:account-model,
        ngm:ethereum-state-model ;
    vc:enables ngm:bitcoin-proof-of-work-protocol,
        ngm:coin-selection,
        ngm:parallel-transaction-validation,
        ngm:payment-channel ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:change-output,
        ngm:transaction-output,
        ngm:unlocking-script ;
    vc:implements ngm:utxo-accounting-model ;
    vc:isPartOf ngm:bitcoin-transaction,
        ngm:blockchain-ledger ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:cardano,
        ngm:proof-of-work,
        ngm:wallet ;
    vc:requires ngm:cryptographic-hash-function,
        ngm:digital-signature,
        ngm:locking-script,
        ngm:transaction-input ;
    vc:slug "utxo" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:light-client-verification,
        ngm:privacy-technique,
        ngm:stateless-validation ;
    vc:uses ngm:merkle-tree,
        ngm:script-language .

ngm:volumetric-capture a owl:Class ;
    rdfs:label "Volumetric Capture"@en ;
    rdfs:comment "Volumetric Capture is the acquisition process that records a subject or environment in three spatial dimensions over time, using arrays of cameras, depth sensors, structured-light projectors, or LiDAR to produce a fully navigable 4D (space + time) representation. The captured data — typically as dense point-cloud sequences, multi-view video, or neural radiance fields — can be rendered from any arbitrary viewpoint and replayed freely in time, enabling photorealistic holographic telepresence, immersive sports and entertainment broadcasting, and real-time digital-twin creation. It sits at the convergence of photogrammetry, computer vision, and real-time graphics pipelines, demanding tightly calibrated hardware rigs and specialised compression and streaming infrastructure."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:real-time-rendering ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:video-compression ],
        ngm:photogrammetry ;
    vc:bridgesTo ngm:gaussian-splatting,
        ngm:machine-learning ;
    vc:contrastsWith ngm:360-video,
        ngm:stereoscopic-3d ;
    vc:dependsOn ngm:computer-vision,
        ngm:mesh-reconstruction ;
    vc:enables ngm:3-d-reconstruction,
        ngm:digital-twin,
        ngm:extended-reality,
        ngm:holographic-telepresence,
        ngm:immersive-media ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:light-field-display,
        ngm:motion-capture,
        ngm:real-time-rendering ;
    vc:requires ngm:multi-camera-rig,
        ngm:real-time-rendering,
        ngm:video-compression ;
    vc:slug "volumetric-capture" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:mixed-reality,
        ngm:spatial-computing,
        ngm:virtual-production ;
    vc:uses ngm:camera-calibration,
        ngm:depth-sensing,
        ngm:lidar,
        ngm:neural-radiance-field,
        ngm:photogrammetry,
        ngm:point-cloud,
        ngm:structured-light .

ngm:3-d-model a owl:Class ;
    rdfs:label "3D Model"@en ;
    rdfs:comment "A 3D Model is a digital representation of a three-dimensional object or environment constructed from vertices, edges, faces, and materials, encoded in standard formats such as glTF, OBJ, FBX, or USD, and used as a foundational asset in spatial computing, simulation, gaming, and metaverse applications."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:3-d-modeling ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:material-definition ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:texture-mapping ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:mesh-data ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:3-d-file-format ],
        ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:bridgesTo ngm:3-d-development,
        ngm:computer-vision ;
    vc:enables ngm:3-d-rendering,
        ngm:animation-retargeting,
        ngm:augmented-reality,
        ngm:interactive-visualization,
        ngm:virtual-reality ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:material-definition,
        ngm:mesh-data,
        ngm:skeletal-rig,
        ngm:texture-mapping ;
    vc:isPartOf ngm:digital-asset,
        ngm:virtual-environment-design ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:photogrammetry,
        ngm:procedural-generation ;
    vc:requires ngm:3-d-file-format,
