ngm:telemedicine a owl:Class ;
    rdfs:label "Telemedicine"@en ;
    rdfs:comment "Telemedicine is the delivery of clinical healthcare services — including diagnosis, consultation, monitoring, and treatment guidance — at a distance using telecommunications technology such as video conferencing, secure messaging, and remote sensing devices. It encompasses synchronous consultations (live video visits), asynchronous store-and-forward exchanges (images, test results), and remote patient monitoring (RPM) using wearable sensors and IoT devices. Telemedicine dramatically expands access to specialist care for patients in rural, underserved, or mobility-constrained situations."@en ;
    rdfs:subClassOf ngm:healthcare-technology ;
    vc:enables ngm:clinical-decision-support,
        ngm:precision-medicine,
        ngm:remote-work ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:healthcare-records,
        ngm:medical-ai,
        ngm:wearable-device-integration ;
    vc:slug "telemedicine" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:healthcare-ai,
        ngm:io-t-sensor-network,
        ngm:video-conferencing .

ngm:telemetry a skos:Concept ;
    rdfs:label "Telemetry"@en .

ngm:temporal-motion-diffusion-adapter a owl:Class ;
    rdfs:label "Temporal Motion Diffusion Adapter"@en ;
    rdfs:comment "AnimateDiff is an open-source framework that inserts lightweight motion-module adapters into pre-trained text-to-image diffusion models to generate temporally consistent animated sequences without retraining the base image model. Developed by researchers at CUHK and ByteDance and released in 2023, it enables personalised diffusion model checkpoints to produce video clips by learning motion priors from video data in a plug-and-play manner. AnimateDiff integrates natively with the Stable Diffusion ecosystem, including ControlNet conditioning and LoRA fine-tuning."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:diffusion-model ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:attention-mechanism ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:latent-diffusion ],
        ngm:video-generation ;
    vc:contrastsWith ngm:motion-capture-technology ;
    vc:enables ngm:animation-technique,
        ngm:image-to-image-translation,
        ngm:video-generation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:3-d-animation,
        ngm:computer-vision-video-analysis,
        ngm:generative-ai,
        ngm:stable-diffusion-image-model ;
    vc:requires ngm:attention-mechanism,
        ngm:diffusion-model,
        ngm:latent-diffusion ;
    vc:slug "temporal-motion-diffusion-adapter" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:fine-tuning,
        ngm:generative-model,
        ngm:motion-capture,
        ngm:parameter-efficient-fine-tuning .

ngm:tendermint-consensus a owl:Class ;
    rdfs:label "Tendermint Consensus"@en ;
    rdfs:comment "Tendermint Consensus is a Byzantine Fault Tolerant consensus engine that combines Practical Byzantine Fault Tolerance (PBFT) with Proof-of-Stake validator sets to achieve immediate block finality and high transaction throughput. It underpins the Cosmos ecosystem and enables inter-blockchain communication by guaranteeing that committed blocks are never reverted, eliminating the probabilistic finality of Proof-of-Work chains."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:proof-of-stake ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:validator-node ],
        ngm:bc-protocol-and-consensus,
        ngm:byzantine-fault-tolerance ;
    skos:broader ngm:bc-protocol-and-consensus ;
    vc:contrastsWith ngm:delegated-proof-of-stake,
        ngm:proof-of-work ;
    vc:enables ngm:blockchain-interoperability,
        ngm:cosmos-ibc ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:blockchain-protocol ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:blockchain-scalability,
        ngm:consensus-mechanism,
        ngm:low-energy-consumption ;
    vc:requires ngm:proof-of-stake,
        ngm:validator-node ;
    vc:slug "tendermint-consensus" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:cryptographic-hash,
        ngm:digital-signature .

ngm:text-classification a skos:Concept ;
    rdfs:label "Text Classification"@en .

ngm:thread-protocol a owl:Class ;
    rdfs:label "Thread Protocol"@en ;
    rdfs:comment "Thread is an IPv6-based, low-power wireless mesh networking protocol designed for IoT devices in home and commercial environments, using IEEE 802.15.4 as its radio layer and providing self-healing, self-configuring mesh topology with native IP routing, secure device commissioning, and no single point of failure. Thread is managed by the Thread Group and forms the network and transport foundation for the Matter smart-home application protocol."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ieee-802-15-4 ],
        ngm:ieee-802-15-4 ;
    vc:bridgesTo ngm:internet-of-things,
        ngm:local-area-network ;
    vc:contrastsWith ngm:bluetooth-mesh,
        ngm:z-wave,
        ngm:zigbee ;
    vc:dependsOn ngm:aes-128-encryption,
        ngm:dtls ;
    vc:enables ngm:industrial-iot,
        ngm:matter-protocol,
        ngm:smart-home-automation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:openthread,
        ngm:thread-border-router,
        ngm:thread-commissioning-protocol ;
    vc:implements ngm:link-state-routing,
        ngm:mesh-networking ;
    vc:isPartOf ngm:iot-networking-stack ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:building-automation,
        ngm:home-area-network,
        ngm:mesh-routing-software,
        ngm:wireless-radio ;
    vc:requires ngm:6lowpan,
        ngm:ieee-802-15-4,
        ngm:ipv6 ;
    vc:slug "thread-protocol" ;
    vc:sourceDomain "infrastructure" ;
    vc:standardizedBy ngm:thread-group ;
    vc:supports ngm:device-commissioning,
        ngm:low-power-device ;
    vc:uses ngm:coap,
        ngm:network-layer,
        ngm:udp .

ngm:throughput a skos:Concept ;
    rdfs:label "Throughput"@en .

ngm:tpu a owl:Class ;
    rdfs:label "TPU"@en ;
    rdfs:comment "Tensor Processing Unit — Google's custom ASIC optimised for the dense matrix multiplications that dominate neural network training and inference. TPUs use systolic arrays to achieve high throughput on 8-bit and 16-bit arithmetic at significantly lower energy per FLOP than general-purpose GPUs, and are available via Google Cloud as Cloud TPUs for large-scale model training."@en ;
    rdfs:subClassOf ngm:ai-hardware,
        ngm:ai-infrastructure ;
    vc:enables ngm:distributed-training,
        ngm:large-language-models ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:edge-ai-accelerator,
