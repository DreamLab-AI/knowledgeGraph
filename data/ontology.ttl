ngm:set-of-mark-prompting a owl:Class ;
    rdfs:label "Set-of-Mark Prompting"@en ;
    rdfs:comment "Set-of-mark prompting is a visual-prompting technique that overlays an image with numbered or coloured marks on segmented regions so a multimodal language model can refer to and reason about specific elements by label. By grounding the model's references in explicit visual tokens, it sharply improves spatial grounding, visual question answering, and GUI element selection. It is a key enabler of vision-driven computer-use agents."@en ;
    rdfs:subClassOf ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:computer-use-and-browser-agents ;
    vc:slug "set-of-mark-prompting" ;
    vc:sourceDomain "ai" .

ngm:shadow-mapping a owl:Class ;
    rdfs:label "Shadow Mapping"@en ;
    rdfs:comment "Shadow Mapping is a real-time computer graphics technique for rendering shadows by rendering the scene from the perspective of each light source into a depth texture (the shadow map), then comparing scene-point depth values against that map during the main render pass to determine visibility. It is the dominant method for dynamic shadows in games and real-time rendering engines due to its GPU efficiency and flexibility. Artefacts such as shadow acne and perspective aliasing are mitigated through techniques like bias adjustment, percentage-closer filtering, and cascaded shadow maps. The technique is fundamental to photorealistic rendering in spatial computing and XR applications."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:shader ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:depth-buffer ],
        ngm:spatial-computing ;
    skos:broader ngm:spatial-computing ;
    vc:contrastsWith ngm:ray-tracing,
        ngm:shadow-volumes ;
    vc:dependsOn ngm:graphics-pipeline,
        ngm:rasterisation ;
    vc:enables ngm:dynamic-lighting,
        ngm:photorealistic-rendering ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:depth-buffer,
        ngm:shader ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:depth-buffer,
        ngm:global-illumination,
        ngm:rasterisation,
        ngm:real-time-rendering ;
    vc:slug "shadow-mapping" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:augmented-reality,
        ngm:game-engine,
        ngm:virtual-reality ;
    vc:uses ngm:gpu,
        ngm:texture-mapping .

