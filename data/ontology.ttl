ngm:technology-power-structure-visualisation a owl:Class ;
    rdfs:comment "Calculating Empires is a large-scale research visualisation project by Kate Crawford and Vladan Joler that maps the co-evolution of technology and power structures from 1500 to the present. The work contextualises contemporary AI within five centuries of imperial infrastructure, surveillance, and control systems, foregrounding continuities between historical colonialism and digital power."@en ;
    rdfs:label "Technology Power Structure Visualisation"@en ;
    rdfs:subClassOf ngm:software-engineering ;
    vc:bridgesTo ngm:digital-society-surveillance ;
    vc:bridgesTo ngm:education-and-ai ;
    vc:contrastsWith ngm:cyber-security-and-military ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.35"^^xsd:float ;
