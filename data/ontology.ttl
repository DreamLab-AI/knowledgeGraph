# Model Property
artificial-intelligence:ModelProperty rdf:type owl:Class ;
    rdfs:subClassOf artificial-intelligence:AIConcept ;
    rdfs:label "Model Property"@en ;
    rdfs:comment "A meta-classification for properties, characteristics, and measurable attributes of machine learning models including performance metrics (accuracy, latency, throughput), architectural properties (parameters, layers, context length), and operational characteristics (memory footprint, inference cost, training requirements)."@en ;
    skos:prefLabel "Model Property"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:artificial-intelligence:model-property" ;
    owl:sameAs <urn:visionclaw:concept:artificial-intelligence:model-property> ;
