    vc:supports ngm:digital-twin,
        ngm:metaverse ;
    vc:uses ngm:level-of-detail,
        ngm:uv-mapping .

ngm:ai-risk a owl:Class ;
    rdfs:label "AI Risk"@en ;
    rdfs:comment "The potential for AI systems to cause adverse effects on individuals, groups, organizations, communities, or society, arising from technical failures, security vulnerabilities, biased outcomes, privacy violations, or unintended consequences of system design, deployment, or operation. AI risks span from immediate operational failures to long-term catastrophic scenarios requiring proactive identification, assessment, and mitigation strategies."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:human-oversight ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:algorithmic-bias ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ai-risk-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:ai-security ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:ai-safety ],
        ngm:risk-management ;
    vc:bridgesTo ngm:cybersecurity,
        ngm:smart-contract ;
    vc:contrastsWith ngm:ai-safety ;
    vc:dependsOn ngm:high-risk-ai-system,
        ngm:large-language-models ;
    vc:enables ngm:ai-incident,
        ngm:ai-risk-assessment ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:ai-safety,
        ngm:ai-security,
        ngm:algorithmic-bias,
        ngm:technical-risk ;
    vc:implements ngm:iso-iec-23894,
        ngm:nist-ai-rmf ;
    vc:isPartOf ngm:ai-governance-and-ethics ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:ai-regulation,
        ngm:model-alignment,
        ngm:responsible-ai ;
    vc:requires ngm:ai-risk-management,
        ngm:human-oversight ;
    vc:slug "ai-risk" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:standardizedBy ngm:eu-ai-act,
        ngm:gdpr ;
    vc:supports ngm:ai-ethics,
        ngm:ai-trustworthiness ;
    vc:uses ngm:explainable-ai,
        ngm:red-teaming .

ngm:asset-tokenization a owl:Class ;
    rdfs:label "Asset Tokenization"@en ;
    rdfs:comment "Asset Tokenization is the process of representing ownership rights to real-world or digital assets as cryptographically secured tokens recorded on a distributed ledger, enabling programmable transfer, fractional ownership, and automated governance via smart contracts without traditional intermediaries. Tokenization converts illiquid assets such as real estate, commodities, equity instruments, and intellectual property into fungible or non-fungible on-chain representations with transparent provenance. The process typically involves legal structuring to bind the on-chain token to off-chain asset rights, oracle integration for real-world data feeds, and compliance with jurisdiction-specific securities and property regulations. Asset Tokenization underpins decentralised finance protocols, security token offerings, and digital-asset markets in both permissioned enterprise blockchains and public networks."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:smart-contract ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:blockchain ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:distributed-ledger ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptographic-hash ],
        ngm:digital-asset ;
    vc:bridgesTo ngm:digital-twin,
        ngm:real-estate,
        ngm:supply-chain-finance ;
    vc:contrastsWith ngm:fiat-currency,
        ngm:traditional-securities ;
    vc:dependsOn ngm:consensus-mechanism,
        ngm:oracle,
        ngm:public-key-infrastructure ;
    vc:enables ngm:fractional-ownership,
        ngm:liquidity,
        ngm:nft,
        ngm:security-token-offering ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:anti-money-laundering,
        ngm:custody,
        ngm:decentralized-autonomous-organization ;
    vc:requires ngm:blockchain,
        ngm:cryptographic-hash,
        ngm:distributed-ledger,
        ngm:smart-contract ;
    vc:slug "asset-tokenization" ;
    vc:sourceDomain "blockchain" ;
    vc:standardizedBy ngm:erc-1400,
        ngm:erc-20,
        ngm:erc-721 ;
    vc:supports ngm:decentralized-exchange,
        ngm:regulatory-compliance ;
    vc:uses ngm:decentralized-finance-de-fi,
        ngm:digital-wallet,
        ngm:token-standard .

ngm:autoencoder a owl:Class ;
    rdfs:label "Autoencoder"@en ;
    rdfs:comment "An Autoencoder is a neural network trained to reconstruct its input by learning a compressed latent representation. The encoder maps input data to a lower-dimensional latent space and the decoder reconstructs the original from this representation, minimising a reconstruction loss. Variants including variational autoencoders (VAEs), denoising autoencoders, and convolutional autoencoders extend this framework to generative modelling, anomaly detection, and feature extraction."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:backpropagation ],
        ngm:deep-learning ;
    vc:bridgesTo ngm:computer-vision,
        ngm:natural-language-processing,
        ngm:signal-processing ;
    vc:contrastsWith ngm:generative-adversarial-network,
        ngm:principal-component-analysis ;
    vc:enables ngm:anomaly-detection,
        ngm:data-denoising,
        ngm:dimensionality-reduction,
        ngm:representation-learning ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:decoder-network,
        ngm:encoder-network,
        ngm:latent-space ;
    vc:implements ngm:nonlinear-dimensionality-reduction ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:feature-extraction,
        ngm:generative-model,
        ngm:neural-network,
        ngm:transfer-learning,
        ngm:variational-autoencoders ;
    vc:requires ngm:backpropagation,
        ngm:reconstruction-loss ;
    vc:slug "autoencoder" ;
    vc:sourceDomain "machine-learning" ;
    vc:uses ngm:gradient-descent,
        ngm:neural-network-latent-space,
        ngm:unsupervised-learning .

ngm:autonomous-systems a skos:Concept ;
    rdfs:label "Autonomous Systems"@en .

ngm:bias a owl:Class ;
    rdfs:label "Bias"@en ;
    rdfs:comment "Systematic deviation from fairness, objectivity, or expected outcomes in an AI system that leads to prejudiced results favouring or disfavouring particular groups, individuals, or outcomes, arising from data, algorithms, or deployment contexts."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
