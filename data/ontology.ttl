ngm:sustainability a owl:Class ;
    rdfs:label "Sustainability"@en ;
    rdfs:comment "Sustainability in digital and metaverse contexts addresses the long-term viability of technology systems across environmental, social, and economic dimensions. Environmental sustainability encompasses energy-efficient rendering, carbon footprint reduction via green hosting, and electronic waste minimisation. Social sustainability includes digital accessibility, equity of access, and psychological wellbeing. Economic sustainability requires viable creator economies and protection against exploitative practices."@en ;
    rdfs:subClassOf ngm:infra-legal-and-regulatory ;
    skos:broader ngm:infra-legal-and-regulatory ;
    vc:enables ngm:circular-economy ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:relatedTo ngm:blockchain-energy-consumption,
        ngm:esg-reporting ;
    vc:slug "sustainability" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:carbon-footprint-measurement,
        ngm:renewable-energy-certificates .

ngm:sybil-attack a owl:Class ;
    rdfs:label "Sybil Attack"@en ;
    rdfs:comment "A Sybil Attack is a network security threat in which a single adversary creates a large number of pseudonymous identities to gain disproportionate influence over a peer-to-peer system. In blockchain and distributed ledger contexts it can subvert reputation systems, distort consensus voting, facilitate eclipse attacks, and undermine proof-of-stake weighting. Countermeasures include proof-of-work, stake-weighted voting, identity verification, and peer diversity requirements."@en ;
    rdfs:subClassOf ngm:bc-protocol-and-consensus,
        ngm:blockchain-entity,
        ngm:network-component ;
    skos:broader ngm:bc-protocol-and-consensus ;
    vc:contrastsWith ngm:byzantine-fault-tolerance,
        ngm:proof-of-stake,
        ngm:proof-of-work ;
    vc:enables ngm:double-spending,
        ngm:eclipse-attack ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:51-attack,
        ngm:network-topology,
        ngm:peer-to-peer-network,
        ngm:selfish-mining ;
    vc:slug "sybil-attack" ;
    vc:sourceDomain "blockchain" .

ngm:transaction-confirmation a owl:Class ;
    rdfs:label "Transaction Confirmation"@en ;
    rdfs:comment "The process by which a blockchain transaction achieves inclusion in a mined or validated block and subsequently accumulates additional blocks on top of it, reducing the probability of reversal. The number of confirmations required for sufficient security depends on consensus mechanism and transaction value; Bitcoin typically requires 6 confirmations while Proof-of-Stake systems with deterministic finality may confirm in a single block."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:consensus-mechanism ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:validator-node ],
        ngm:bc-protocol-and-consensus,
        ngm:blockchain-entity,
        ngm:distributed-data-structure ;
    skos:broader ngm:bc-protocol-and-consensus ;
    vc:enables ngm:audit-trail,
        ngm:blockchain-compliance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:blockchain-transaction,
        ngm:deterministic-finality,
        ngm:finality,
        ngm:transaction-finality ;
    vc:requires ngm:consensus-mechanism,
        ngm:validator-node ;
    vc:slug "transaction-confirmation" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:block,
        ngm:block-time,
        ngm:timestamp .

ngm:user-safety a owl:Class ;
    rdfs:label "User Safety"@en ;
    rdfs:comment "User Safety in spatial computing and metaverse environments encompasses the technical, policy, and design measures that protect participants from harm including harassment, predatory behaviour, physical discomfort from extended immersive use, and unwanted exposure to harmful content. Because interactions in the metaverse occur in real-time and within spatially embodied contexts, abusive behaviour resembles physical-world harm more closely than conventional social media, demanding proactive moderation, privacy-preserving reporting mechanisms, and platform-level governance frameworks."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:content-moderation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:privacy ],
        ngm:metaverse-and-spatial-risks,
        ngm:sc-governance-and-safety ;
    skos:broader ngm:sc-governance-and-safety ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:relatedTo ngm:digital-rights,
        ngm:risk-management ;
    vc:requires ngm:content-moderation,
        ngm:privacy ;
    vc:slug "user-safety" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:governance-framework,
        ngm:metaverse-safety-protocol .

ngm:virtual-currency a owl:Class ;
    rdfs:label "Virtual Currency"@en ;
    rdfs:comment "A digital representation of value issued and controlled by platform developers, used and accepted electronically within a specific virtual community. Virtual currencies include closed in-game currencies (e.g., World of Warcraft gold), hybrid purchasable tokens (e.g., Robux), and convertible currencies exchangeable for fiat money, each with distinct regulatory and economic implications."@en ;
    rdfs:subClassOf ngm:digital-asset,
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
