        ngm:moderation-infrastructure,
        ngm:reporting-mechanisms,
        ngm:risk-assessment ;
    vc:slug "digital-services-act" ;
    vc:sourceDomain "governance" ;
    vc:standardizedBy ngm:european-commission .

ngm:direct-preference-optimisation a owl:Class ;
    rdfs:label "Direct Preference Optimisation"@en ;
    rdfs:comment "An alignment mod that directly uses preference data to fine-tune language models without training a separate reward model or using reinforcement learning, offering a simpler alternative to RLHF."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:large-language-models ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:preference-learning ],
        ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:contrastsWith ngm:reinforcement-learning-from-human-feedback ;
    vc:enables ngm:ai-alignment,
        ngm:fine-tuning ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires ngm:large-language-models,
        ngm:preference-learning ;
    vc:slug "direct-preference-optimisation" ;
    vc:sourceDomain "spatial-computing" .

ngm:e-commerce a owl:Class ;
    rdfs:label "E-Commerce"@en ;
    rdfs:comment "E-Commerce (electronic commerce) is the commercial exchange of goods, services, and information conducted over digital networks, encompassing business-to-consumer (B2C), business-to-business (B2B), consumer-to-consumer (C2C), and direct-to-consumer (D2C) transaction models. It relies on integrated layers of digital payment infrastructure, identity and authentication, logistics coordination, and data-driven personalisation to operate at scale. Modern e-commerce platforms leverage cloud infrastructure, recommendation engines, and APIs to connect buyers, sellers, and fulfilment networks globally. It is a mature commercial domain that continues to evolve through mobile-first experiences, conversational commerce, and blockchain-based payment rails."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:payment-system ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:digital-identity ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:authentication ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:logistics ],
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:bridgesTo ngm:decentralised-finance,
        ngm:metaverse-commerce ;
    vc:contrastsWith ngm:traditional-retail ;
    vc:dependsOn ngm:cloud-infrastructure,
        ngm:cybersecurity ;
    vc:enables ngm:digital-payments,
        ngm:personalisation,
        ngm:supply-chain-visibility ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:order-management,
        ngm:product-catalogue,
        ngm:shopping-cart ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:conversion-rate-optimisation,
        ngm:customer-data-platform,
        ngm:virtual-tourism ;
    vc:requires ngm:authentication,
        ngm:digital-identity,
        ngm:logistics,
        ngm:payment-system ;
    vc:slug "e-commerce" ;
    vc:sourceDomain "finance" ;
    vc:uses ngm:api,
        ngm:blockchain,
        ngm:content-delivery-network,
        ngm:marketplace,
        ngm:recommendation-system .

ngm:edge-inference a owl:Class ;
    rdfs:label "Edge Inference"@en ;
    rdfs:comment "The execution of machine learning model inference on local edge devices rather than in centralised cloud infrastructure, close to where data is generated, enabling low-latency, privacy-preserving and bandwidth-efficient AI applications."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:inference-engine ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:knowledge-distillation ],
        ngm:edge-ai ;
    vc:bridgesTo ngm:federated-learning,
        ngm:iot-device,
        ngm:spatial-computing ;
    vc:contrastsWith ngm:centralised-ai,
        ngm:cloud-inference ;
    vc:dependsOn ngm:embedded-systems,
        ngm:neural-processing-unit ;
    vc:enables ngm:offline-ai,
        ngm:on-device-privacy,
        ngm:real-time-ai ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:model-pruning,
        ngm:model-quantisation,
        ngm:on-device-runtime ;
    vc:implements ngm:machine-learning-inference ;
    vc:isPartOf ngm:edge-computing,
        ngm:tinyml ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:data-privacy,
        ngm:latency-optimisation ;
    vc:requires ngm:hardware-accelerator,
        ngm:inference-engine,
        ngm:knowledge-distillation,
        ngm:neural-network-compression ;
    vc:slug "edge-inference" ;
    vc:sourceDomain "machine-learning" ;
    vc:uses ngm:onnx-runtime,
        ngm:pytorch-mobile,
        ngm:tensorflow-lite .

ngm:education-technology a owl:Class ;
    rdfs:label "Education Technology"@en ;
    rdfs:comment "Education Technology (EdTech) is the systematic application of digital tools, AI-driven systems, data analytics, and immersive platforms to enhance teaching efficacy, personalise learning pathways, and streamline educational administration across formal, informal, and professional learning contexts. Modern EdTech leverages adaptive learning algorithms that adjust content difficulty and pacing to individual learner performance, natural language processing for automated tutoring and essay scoring, and extended-reality environments that create immersive simulations for fields such as medicine, engineering, and the sciences. It bridges pedagogical theory with computational infrastructure, drawing on learning science research to design interventions at scale while grappling with data-privacy obligations and algorithmic-bias risks inherent in learner-profiling systems."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:accessibility ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:intelligent-tutoring-system ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:learning-management-system ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:learning-analytics ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:digital-infrastructure ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:adaptive-learning ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-privacy ],
        ngm:ai-application ;
    skos:broader ngm:ai-application ;
    vc:bridgesTo ngm:augmented-reality,
        ngm:digital-twin,
        ngm:large-language-model,
        ngm:virtual-reality ;
    vc:contrastsWith ngm:traditional-classroom-instruction ;
    vc:enables ngm:collaborative-learning,
        ngm:competency-based-education,
        ngm:personalised-learning,
        ngm:remote-education ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:adaptive-learning,
        ngm:automated-assessment,
        ngm:intelligent-tutoring-system,
        ngm:learning-analytics,
        ngm:learning-management-system ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:cognitive-science,
        ngm:gamification,
        ngm:knowledge-graph,
        ngm:open-educational-resources ;
    vc:requires ngm:accessibility,
        ngm:data-privacy,
        ngm:digital-infrastructure ;
    vc:slug "education-technology" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:standardizedBy ngm:ieee-learning-technology,
        ngm:scorm,
        ngm:xapi ;
    vc:uses ngm:immersive-learning,
        ngm:machine-learning,
        ngm:natural-language-processing,
        ngm:recommendation-systems,
        ngm:speech-recognition .

ngm:ens a owl:Class ;
    rdfs:label "ENS"@en ;
    rdfs:comment "The Ethereum Name Service (ENS) is a decentralised, on-chain naming system built on Ethereum that maps human-readable names ending in .eth to Ethereum addresses, content hashes, multi-coin addresses, and arbitrary text records via ERC-137 compliant smart contracts and pluggable resolver contracts. It functions as the Web3 analogue of DNS, replacing opaque hexadecimal addresses with memorable, self-sovereign labels backed by ERC-721 NFTs and governed by the ENS DAO. Off-chain resolution via CCIP-Read (EIP-3668) extends the system to conventional databases with on-chain verification, reducing gas overhead for high-frequency updates whilst preserving trustless resolution semantics."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:on-chain-governance ],
        ngm:decentralised-identity ;
    vc:bridgesTo ngm:decentralised-identifier,
        ngm:verifiable-credential ;
    vc:contrastsWith ngm:dns,
        ngm:unstoppable-domains ;
    vc:enables ngm:decentralised-application,
        ngm:decentralised-web,
        ngm:self-sovereign-identity,
        ngm:web3 ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:eip-3668,
        ngm:erc-137,
        ngm:slip-0044 ;
    vc:isPartOf ngm:ethereum-ecosystem ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:dao,
        ngm:governance-token,
        ngm:name-registry,
        ngm:wallet-address ;
    vc:requires ngm:ethereum-virtual-machine,
        ngm:on-chain-governance ;
    vc:slug "ens" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:erc-721,
        ngm:ethereum,
        ngm:ipfs,
        ngm:nft,
        ngm:smart-contract .

ngm:ensemble-methods a owl:Class ;
    rdfs:label "Ensemble Methods"@en ;
    rdfs:comment "Machine learning techniques that combine multiple base models (weak learners) to produce a stronger, more accurate predictor by aggregating their predictions, thereby reducing variance, bias, or both, and achieving better generalisation than any single model alone."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:boosting ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:bagging ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:training-data ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:stacking ],
        ngm:machine-learning ;
    vc:bridgesTo ngm:digital-twin,
        ngm:federated-learning ;
    vc:contrastsWith ngm:neural-network,
        ngm:single-model ;
    vc:enables ngm:bias-reduction,
        ngm:generalization,
        ngm:model-combination,
        ngm:variance-reduction ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:bagging,
        ngm:boosting,
        ngm:stacking,
        ngm:voting-classifier ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:bias-variance-tradeoff,
        ngm:hyperparameter-tuning,
        ngm:overfitting ;
    vc:requires ngm:base-learner,
        ngm:training-data ;
    vc:slug "ensemble-methods" ;
    vc:sourceDomain "machine-learning" ;
    vc:uses ngm:cross-validation,
        ngm:decision-tree,
        ngm:gradient-boosting,
        ngm:random-forest .

ngm:entity-resolution a owl:Class ;
    rdfs:label "Entity Resolution"@en ;
    rdfs:comment "Entity resolution is the computational process of determining whether two or more records — potentially from disparate sources, formats, or schemas — refer to the same real-world entity, and then linking, merging, or deduplicating them into a single canonical representation. It encompasses blocking strategies that reduce the candidate comparison space, similarity scoring across attributes, and decision logic (deterministic, probabilistic, or ML-based) that determines match, non-match, or possible-match outcomes. Widely applied in master data management, knowledge graph construction, fraud detection, and census processing, it forms a foundational layer of data integration pipelines that require a consistent, unified view of entities such as persons, organisations, products, or locations."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-quality ],
        ngm:data-integration ;
    vc:bridgesTo ngm:federated-learning,
        ngm:knowledge-graph-embedding,
        ngm:named-entity-recognition ;
    vc:contrastsWith ngm:data-deduplication,
        ngm:ontology-alignment ;
    vc:enables ngm:data-lineage,
        ngm:fraud-detection,
        ngm:knowledge-graph,
        ngm:master-data-management ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:data-integration,
        ngm:master-data-management ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:data-catalog,
        ngm:data-governance,
        ngm:identity-resolution ;
    vc:requires ngm:blocking,
        ngm:data-quality,
        ngm:schema-mapping,
        ngm:string-similarity ;
    vc:slug "entity-resolution" ;
    vc:sourceDomain "data" ;
    vc:uses ngm:embedding,
        ngm:graph-neural-network,
        ngm:machine-learning,
        ngm:probabilistic-matching .

ngm:frontier-ai a owl:Class ;
    rdfs:label "Frontier AI"@en ;
    rdfs:comment "Frontier AI denotes the most capable and computationally intensive artificial intelligence systems at the leading edge of current technical progress, typically characterised by unprecedentedly large training compute budgets, novel emergent capabilities, and performance that approaches or exceeds human expert level across diverse cognitive tasks. These systems, predominantly large language models and multimodal foundation models, exhibit qualitatively new behaviours not present in smaller predecessors, including in-context learning, chain-of-thought reasoning, and cross-domain generalisation. Their development is concentrated among a small number of resource-rich organisations, raising distinct safety, governance, and geopolitical considerations absent from earlier AI generations. Regulatory frameworks such as the EU AI Act and the UK AI Safety Institute use compute-threshold criteria to demarcate frontier systems from other AI, typically above 10^26 training FLOPs for general-purpose AI."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:emergent-capabilities ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:large-language-models ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:high-performance-computing ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:reinforcement-learning-from-human-feedback ],
        ngm:large-scale-pretrained-foundation-model ;
    vc:contrastsWith ngm:edge-ai,
        ngm:narrow-ai ;
    vc:dependsOn ngm:gpt,
        ngm:scaling-laws,
        ngm:transformers ;
    vc:enables ngm:agentic-ai-systems,
        ngm:ai-enabled-scientific-discovery,
        ngm:generative-ai,
        ngm:history-and-path-to-agi ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:emergent-capabilities,
        ngm:large-language-models,
        ngm:multimodal-ai ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:ai-alignment,
        ngm:compute-governance,
        ngm:existential-risk ;
    vc:requires ngm:high-performance-computing,
        ngm:large-scale-data-infrastructure,
        ngm:reinforcement-learning-from-human-feedback ;
    vc:slug "frontier-ai" ;
    vc:sourceDomain "ai" ;
    vc:standardizedBy ngm:eu-ai-act,
        ngm:frontier-model-forum ;
    vc:supports ngm:ai-governance,
        ngm:ai-safety ;
    vc:uses ngm:mechanistic-interpretability,
        ngm:model-evaluation-results,
        ngm:red-teaming,
        ngm:scalable-oversight .

ngm:grasp-planning a owl:Class ;
    rdfs:label "Grasp Planning"@en ;
    rdfs:comment "Grasp planning is the computational problem of determining stable contact configurations between a robotic end-effector and an object, such that the resulting grasp resists external disturbances and enables the desired manipulation task. It combines geometric modelling of object shape, force-closure analysis, kinematics constraints, and task-level objectives to synthesise executable grasp poses."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:robot-kinematics ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:perception-system ],
        ngm:manipulation ;
    vc:bridgesTo ngm:computer-vision,
        ngm:reinforcement-learning ;
    vc:dependsOn ngm:3d-shape-representation,
        ngm:end-effector,
        ngm:inverse-kinematics,
        ngm:object-recognition ;
    vc:enables ngm:in-hand-manipulation,
        ngm:pick-and-place,
        ngm:task-execution ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:grasp-candidate-generation,
        ngm:grasp-evaluation ;
    vc:implements ngm:deep-learning-for-robotics,
        ngm:sampling-based-planning ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:dexterous-manipulation,
        ngm:motion-planning,
        ngm:sim-to-real-transfer,
        ngm:tactile-sensing ;
    vc:requires ngm:contact-model,
        ngm:perception-system,
        ngm:robot-kinematics ;
    vc:slug "grasp-planning" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:collision-detection,
        ngm:depth-sensor,
        ngm:force-closure,
        ngm:grasp-quality-metric,
        ngm:point-cloud,
        ngm:pose-estimation .

ngm:green-finance a owl:Class ;
    rdfs:label "Green Finance"@en ;
    rdfs:comment "Green finance is the broad domain of financial instruments, investment strategies, market mechanisms, and regulatory frameworks that direct capital towards environmentally sustainable economic activities with the explicit objectives of mitigating climate change, halting biodiversity loss, and accelerating the transition to a low-carbon circular economy. It encompasses green bonds, sustainability-linked loans and bonds, green funds, voluntary and compliance carbon markets, blended finance structures, and impact investment vehicles, all underpinned by taxonomic classification systems such as the EU Taxonomy for Sustainable Activities and the ICMA Green Bond Principles that define and verify environmental eligibility criteria. Green finance sits at the intersection of macroeconomic policy, capital markets, and environmental science, requiring robust ESG disclosure, lifecycle assessment methodologies, and increasingly blockchain-backed registries to prevent greenwashing and ensure traceability of environmental claims."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:life-cycle-assessment ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:esg-reporting ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:carbon-markets ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:impact-investing ],
        ngm:sustainable-finance ;
    vc:bridgesTo ngm:blockchain-tokenisation,
        ngm:decentralised-finance,
        ngm:regenerative-finance ;
    vc:contrastsWith ngm:conventional-finance,
        ngm:greenwashing ;
    vc:enables ngm:carbon-credit-tracking,
        ngm:environmental-sustainability,
        ngm:net-zero-transition,
        ngm:renewable-energy-investment ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:blended-finance,
        ngm:carbon-markets,
        ngm:green-bonds,
        ngm:impact-investing,
        ngm:sustainability-linked-loans ;
    vc:isPartOf ngm:capital-markets,
        ngm:sustainable-finance ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:climate-risk,
        ngm:corporate-social-responsibility,
        ngm:sustainable-development-goals ;
    vc:requires ngm:esg-reporting,
        ngm:green-taxonomy,
        ngm:life-cycle-assessment ;
    vc:slug "green-finance" ;
    vc:sourceDomain "finance" ;
