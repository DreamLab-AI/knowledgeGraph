        ngm:data-provenance,
        ngm:pharmaceutical-traceability,
        ngm:supply-chain-blockchain ;
    vc:requires ngm:consortium-blockchain ;
    vc:slug "food-safety-blockchain" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:hyperledger-fabric,
        ngm:internet-of-things,
        ngm:permissioned-blockchain,
