ngm:diversity-non-discrimination-and-fairness a owl:Class ;
    rdfs:label "Diversity, Non-Discrimination, and Fairness"@en ;
    rdfs:comment "Diversity, Non-Discrimination, and Fairness is a foundational trustworthiness dimension of responsible AI that requires systems to avoid unfair bias against protected characteristics (sex, race, religion, disability, age, sexual orientation), ensure equitable treatment and outcomes across demographic groups, implement accessibility and universal design for people with diverse abilities, and enable inclusive stakeholder participation throughout the AI development lifecycle. It encompasses three interdependent pillars: unfair-bias avoidance through pre-processing data corrections, in-processing fairness constraints, and post-processing adjustments; accessibility and universal design aligned with WCAG and the European Accessibility Act; and participatory design methodologies that co-create systems with affected communities. Legal mandates including the EU AI Act and GDPR enforce these requirements with substantial penalties."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:fairness ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:accountability ],
        ngm:ai-governance-and-ethics ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:enables ngm:accessibility,
        ngm:equity,
        ngm:trustworthy-ai ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:ai-ethics,
        ngm:ai-impact-assessment,
        ngm:explainability,
        ngm:stakeholder,
        ngm:transparency ;
    vc:requires ngm:accountability,
        ngm:fairness ;
    vc:slug "diversity-non-discrimination-and-fairness" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:human-rights,
        ngm:responsible-ai ;
    vc:uses ngm:algorithmic-bias,
        ngm:bias .

