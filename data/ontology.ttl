mv:SpatialTrackingSystem a owl:Class ;
    rdfs:subClassOf mv:MotionTracking ;
    rdfs:label "Spatial Tracking System"@en ;
    rdfs:comment "Technology for determining the six-degrees-of-freedom (6DOF) position and orientation of devices, controllers, or body parts in three-dimensional space, using visual-inertial SLAM, stereo cameras, and IMU sensors for precise real-time tracking in VR, AR, and mixed reality applications."@en ;
    skos:prefLabel "Spatial Tracking System"@en ;
    dcterms:identifier "MV-10065" ;
    dcterms:subject "mv" .

mv:SpatialTrackingSystem rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:enables ;
    owl:someValuesFrom mv:PreciseSpatialPositioning
] .

mv:SpatialTrackingSystem rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:relatedTo ;
    owl:someValuesFrom mv:6DOFTracking
] .

mv:SpatialTrackingSystem rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:relatedTo ;
    owl:someValuesFrom mv:VisualSLAM
] .

mv:SpatialTrackingSystem rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:relatedTo ;
    owl:someValuesFrom mv:IMUSensors
] .

# Spatial Tracking
mv:SpatialTracking a owl:Class ;
    rdfs:subClassOf mv:MotionTracking ;
    rdfs:label "Spatial Tracking"@en ;
    rdfs:comment "Technology that determines the position and orientation of objects in three-dimensional space using six degrees of freedom (6DoF), enabling precise tracking of headsets, controllers, and body movements through inside-out or outside-in sensor configurations."@en ;
    skos:prefLabel "Spatial Tracking"@en ;
    dcterms:identifier "MV-10066" ;
    dcterms:subject "mv" .

mv:SpatialTracking rdfs:subClassOf [
