ngm:virtual-group-dynamics a owl:Class ;
    rdfs:comment "The psychological and behavioural patterns of interaction, role formation, norm development, decision-making, conflict, and cohesion within groups operating in virtual environments, shaped by unique affordances of digital mediation such as anonymity, persistence, and spatial distribution. Key phenomena include the online disinhibition effect, avatar-mediated identity, emergent leadership hierarchies, and scalable broadcast communication structures."@en ;
    rdfs:label "Virtual Group Dynamics"@en ;
    rdfs:subClassOf ngm:metaverse ;
    rdfs:subClassOf ngm:sc-platform-and-environment ;
