    owl:onProperty ngm:relatedTo ;
    owl:someValuesFrom mv:WorldLocking
] .

mv:SpatialAnchoring rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:relatedTo ;
    owl:someValuesFrom mv:SLAMTechnology
] .

mv:SpatialAnchoring rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:relatedTo ;
    owl:someValuesFrom mv:PersistentARContent
] .

# Spatial Anchors
mv:SpatialAnchors a owl:Class ;
    rdfs:subClassOf mv:ARTechnology ;
    rdfs:label "Spatial Anchors"@en ;
    rdfs:comment "Virtual reference points that bind digital content to specific physical locations in augmented reality environments, using sensor fusion from cameras, GPS, and accelerometers to maintain persistent positioning and orientation of virtual objects relative to real-world spaces."@en ;
    skos:prefLabel "Spatial Anchors"@en ;
    dcterms:identifier "MV-10051" ;
    dcterms:subject "mv" .

