    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:ethereum-smart-contract-platform ;
    vc:slug "erc-3525" ;
    vc:sourceDomain "standards" .

ngm:erc-4337-account-abstraction a owl:Class ;
    rdfs:label "ERC-4337 Account Abstraction"@en ;
    rdfs:comment "An Ethereum standard defining account abstraction using a higher-layer pseudo-transaction object called a UserOperation, without changes to the core protocol. It enables smart contract wallets with custom validation logic."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ethereum-smart-contract-platform ],
        ngm:technical-standard ;
    vc:hasMaturity ngmi:maturity-established ;
