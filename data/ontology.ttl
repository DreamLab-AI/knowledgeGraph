        ngm:investment-management,
        ngm:sustainable-finance ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:isPartOf ngm:financial-system,
        ngm:global-capital-markets ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:exchange-traded-fund ;
    vc:requires ngm:portfolio-management,
        ngm:regulatory-compliance,
        ngm:risk-management ;
    vc:slug "black-rock" ;
    vc:sourceDomain "finance" ;
    vc:uses ngm:data-infrastructure,
        ngm:machine-learning,
        ngm:quantitative-finance .

ngm:black-rock-buidl a owl:Class ;
