# Reality Virtuality Continuum
mv:RealityVirtualityContinuum a owl:Class ;
    rdfs:subClassOf mv:XRFramework ;
    rdfs:label "Reality Virtuality Continuum"@en ;
    rdfs:comment "A theoretical framework introduced by Milgram and Kishino in 1994 describing the continuous spectrum between purely physical reality and fully virtual environments, with augmented reality and augmented virtuality as intermediate mixed reality states along this scale."@en ;
    skos:prefLabel "Reality Virtuality Continuum"@en ;
    dcterms:identifier "MV-10018" ;
    dcterms:subject "mv" .

mv:RealityVirtualityContinuum rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:enables ;
    owl:someValuesFrom mv:CrossRealityExperiences
] .

