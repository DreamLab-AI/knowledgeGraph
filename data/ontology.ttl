    vc:hasMaturity ngmi:maturity-draft ;
    vc:implements ngm:graphics-api ;
    vc:isPartOf ngm:graphics-pipeline ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:compute-shader,
        ngm:hardware-acceleration,
        ngm:khronos-group,
        ngm:vulkan ;
    vc:requires ngm:graphics-api ;
    vc:slug "metal-api" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:graphics-pipeline ;
    vc:uses ngm:compute-shader,
        ngm:hardware-acceleration .

ngm:metaverse-architecture-stack a owl:Class ;
    rdfs:label "Metaverse Architecture Stack"@en ;
    rdfs:comment "Layered framework defining functional components and interfaces for metaverse systems to interoperate at network, data, and application levels."@en ;
