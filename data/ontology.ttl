        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:consent-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:access-control ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:privacy-impact-assessment ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-minimisation ],
        ngm:regulatory-framework ;
    vc:bridgesTo ngm:blockchain,
        ngm:federated-learning,
        ngm:zero-knowledge-proof ;
    vc:contrastsWith ngm:data-free-flow,
        ngm:surveillance-capitalism ;
    vc:enables ngm:accountability,
        ngm:data-subject-rights,
        ngm:informed-consent ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:consent-management,
        ngm:data-subject-rights,
        ngm:gdpr,
        ngm:privacy-impact-assessment ;
    vc:qualityScore "0.74"^^xsd:float ;
