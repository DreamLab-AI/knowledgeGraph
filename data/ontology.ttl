ngm:kraken a owl:Class ;
    rdfs:label "Kraken"@en ;
    rdfs:comment "Kraken is a centralised cryptocurrency exchange founded in 2011 and headquartered in the United States. It provides spot trading, margin and futures trading, staking and custody services across a wide range of digital assets and fiat currencies. It is among the longer-established exchanges and is noted for its emphasis on regulatory compliance, security and the provision of fiat on-ramps in multiple jurisdictions."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:order-book ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:custody ],
        ngm:digital-asset-domain ;
    vc:enables ngm:crypto-trading,
        ngm:fiat-on-ramp ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:custody,
        ngm:order-book ;
    vc:slug "kraken" ;
    vc:sourceDomain "kraken" .

