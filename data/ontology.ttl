        vf:agent-frameworks,
        vf:agentic-internet,
        vf:ai-adoption,
        vf:cli-multi-agent-systems,
        vf:code-generation ;
    vc:hasPart <urn:visionflow:linked:azure-open-ai-service>,
        <urn:visionflow:linked:copilot-pc>,
        <urn:visionflow:linked:copilot-studio>,
        <urn:visionflow:linked:git-hub-copilot>,
        <urn:visionflow:linked:m365-copilot>,
        <urn:visionflow:linked:security-copilot>,
        <urn:visionflow:linked:windows-recall> ;
    vc:implements <urn:visionflow:linked:multi-agent-systems>,
        <urn:visionflow:linked:retrieval-augmented-generation>,
        vf:function-calling,
        vf:model-context-protocol,
        vf:prompt-engineering ;
    vc:maturity "production-ready" ;
