        ngm:traditional-securities-custody ;
    vc:contrastsWith ngm:exchange-custody,
        ngm:self-custody ;
    vc:enables ngm:digital-asset-etf,
        ngm:institutional-digital-asset-custody,
        ngm:tokenised-real-world-assets ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:cold-storage,
        ngm:hardware-security-module,
        ngm:key-management-system,
        ngm:policy-engine ;
