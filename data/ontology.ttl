ngm:bitcoin-proof-of-work-protocol-core a owl:Class ;
    rdfs:label "Bitcoin Core"@en ;
    rdfs:comment "Bitcoin Core is the canonical, open-source reference implementation of the Bitcoin protocol, written primarily in C++, which full nodes run to independently validate transactions, enforce consensus rules, and maintain a complete local copy of the blockchain. Originally released by Satoshi Nakamoto in January 2009 and subsequently maintained by a global community of contributors, it establishes the authoritative behaviour of the Bitcoin network through its codebase. The software bundles a peer-to-peer networking layer, a UTXO-based scripting engine, a deterministic wallet, a mining interface, and a JSON-RPC API for integration with higher-level applications. Protocol changes are introduced exclusively via Bitcoin Improvement Proposals, requiring broad community review and backward-compatible soft-fork activation to preserve network cohesion."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:distributed-ledger ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:json-data-interchange-format-rpc ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:full-node ],
        ngm:blockchain-protocol ;
    vc:bridgesTo ngm:cryptography,
        ngm:distributed-systems ;
    vc:contrastsWith ngm:ethereum,
        ngm:proof-of-stake ;
    vc:dependsOn ngm:bitcoin-proof-of-work-protocol-network,
        ngm:open-source-software ;
    vc:enables ngm:decentralised-finance,
        ngm:digital-asset-custody,
        ngm:lightning-network ;
    vc:hasMaturity ngmi:maturity-draft ;
