        ngm:regularisation ;
    vc:slug "batch-normalisation" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:neural-network,
        ngm:neural-network-layer .

ngm:bayesian-optimisation a owl:Class ;
    rdfs:label "Bayesian Optimisation"@en ;
    rdfs:comment "Bayesian Optimisation is a sequential, sample-efficient strategy for optimising expensive black-box objective functions by building a probabilistic surrogate model — most commonly a Gaussian process — over the function's input space, then using an acquisition function to decide which point to evaluate next by trading off exploration of uncertain regions against exploitation of known optima. Unlike grid search or random search, it accumulates knowledge about the objective between evaluations, making it particularly valuable when each evaluation is computationally or financially costly, such as neural architecture search, hyperparameter tuning, and laboratory experiment design. The method produces a posterior distribution over the objective that quantifies uncertainty and guides efficient convergence."@en ;
    rdfs:subClassOf ngm:optimisation ;
    vc:enables ngm:auto-ml,
        ngm:neural-architecture-search ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:acquisition-function,
        ngm:bayesian-inference,
        ngm:hyperparameter-tuning,
        ngm:optimization-algorithm ;
    vc:slug "bayesian-optimisation" ;
    vc:sourceDomain "ai" ;
    vc:supports ngm:machine-learning ;
    vc:uses ngm:machine-learning-model .

ngm:bip-341 a owl:Class ;
    rdfs:label "BIP-341"@en ;
    rdfs:comment "BIP-341 is the Bitcoin Improvement Proposal that defines the Taproot upgrade, introducing Pay-to-Taproot (P2TR) as a new output type that merges script and key-path spending under a unified commitment scheme. It combines Schnorr signatures with Merklised Abstract Syntax Trees (MAST) to allow complex spending conditions to be committed on-chain while only revealing the executed branch at spend time. The proposal activated on the Bitcoin mainnet in November 2021 at block height 709,632. BIP-341 is accompanied by BIP-340 (Schnorr signatures) and BIP-342 (Tapscript), forming the complete Taproot bundle. The upgrade significantly improves privacy, fungibility, and script expressiveness for Bitcoin."@en ;
    rdfs:subClassOf ngm:bitcoin-improvement-proposals ;
    vc:enables ngm:bitcoin-network,
        ngm:script ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:bip-340,
        ngm:taproot-assets,
        ngm:utxo-model ;
    vc:slug "bip-341" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:cryptographic-commitment,
        ngm:merkle-tree,
        ngm:schnorr-signature .

ngm:bis a owl:Class ;
    rdfs:label "BIS"@en ;
    rdfs:comment "The Bank for International Settlements (BIS) is an international financial institution owned by member central banks, founded in 1930 and headquartered in Basel, Switzerland. It serves as a bank for central banks, providing financial services, research, and a forum for monetary and financial cooperation at the global level. The BIS hosts the Basel Committee on Banking Supervision, which produces globally influential prudential standards such as the Basel Accords, and runs the BIS Innovation Hub, which actively researches central bank digital currencies and financial technology. Through its publications and policy recommendations, the BIS exerts significant influence over global financial regulation and stability frameworks."@en ;
    rdfs:subClassOf ngm:central-bank ;
    vc:enables ngm:cross-border-payments,
