        ngm:motion-planning,
        ngm:tactile-sensing .

ngm:collateral a skos:Concept ;
    rdfs:label "Collateral"@en .

ngm:concentrated-liquidity a owl:Class ;
    rdfs:label "Concentrated Liquidity"@en ;
    rdfs:comment "Concentrated liquidity is a capital efficiency mechanism for automated market makers (AMMs) in which liquidity providers deposit assets within user-specified price ranges rather than uniformly across the full price curve from zero to infinity. Within an active price range, the capital deployed behaves equivalently to a much larger position in a constant-product AMM, dramatically increasing fee revenue per unit of capital while simultaneously reducing the price impact of trades of a given size. This design was pioneered by Uniswap v3 and has since been widely adopted across decentralised exchanges."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:fee-tier ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:price-oracle ],
        ngm:liquidity-provision ;
    vc:bridgesTo ngm:financial-derivatives,
        ngm:market-microstructure ;
    vc:contrastsWith ngm:constant-product-amm,
        ngm:order-book-exchange ;
    vc:dependsOn ngm:blockchain,
        ngm:impermanent-loss ;
    vc:enables ngm:capital-efficiency,
        ngm:decentralized-exchange,
        ngm:liquidity,
        ngm:token-economics,
        ngm:yield-farming ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:liquidity-position ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:de-fi,
        ngm:perpetual-futures,
        ngm:protocol-owned-liquidity,
        ngm:uniswap ;
    vc:requires ngm:fee-tier,
        ngm:price-oracle ;
    vc:slug "concentrated-liquidity" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:automated-market-maker,
        ngm:liquidity-pool,
        ngm:non-fungible-token,
        ngm:smart-contract .

ngm:configuration-space a owl:Class ;
    rdfs:label "Configuration Space"@en ;
    rdfs:comment "Configuration space, often written C-space, is the set of all possible configurations of a robot, where each point fully specifies the position of every part of the mechanism. Its dimensionality equals the robot's degrees of freedom, and obstacles in the physical workspace map to forbidden regions, partitioning C-space into free and blocked subsets. Motion planning is then recast as finding a continuous path through the free portion of configuration space."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:forward-kinematics ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:collision-detection ],
        ngm:motion-planning ;
    vc:bridgesTo ngm:workspace ;
    vc:enables ngm:obstacle-avoidance,
        ngm:path-planning ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:degrees-of-freedom,
        ngm:joint-space ;
    vc:isPartOf ngm:robotics ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:inverse-kinematics,
        ngm:kinematics,
        ngm:probabilistic-roadmap,
        ngm:rapidly-exploring-random-tree ;
    vc:requires ngm:collision-detection,
        ngm:forward-kinematics ;
    vc:slug "configuration-space" ;
    vc:sourceDomain "robotics" ;
    vc:supports ngm:robot-manipulation ;
    vc:uses ngm:sampling-based-planning .

ngm:consensus-layer a owl:Class ;
    rdfs:label "Consensus Layer"@en ;
    rdfs:comment "The Consensus Layer is the stratum responsible for agreement on a single canonical ordering of events across distributed participants. In the canonical stack it sits directly above the Protocol Layer and below the Data Layer, converting peer-to-peer message exchange into a shared, append-only history. It contains the agreement algorithms, fork-choice rules, and finality conditions that all participants follow."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:protocol-layer ],
        ngm:bc-protocol-and-consensus ;
    skos:broader ngm:bc-protocol-and-consensus ;
    vc:enables ngm:data-layer ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:protocol-layer ;
    vc:slug "consensus-layer" ;
    vc:sourceDomain "blockchain" .

ngm:content-authentication a owl:Class ;
    rdfs:label "Content Authentication"@en ;
    rdfs:comment "Content Authentication is the process of verifying the origin, integrity, and provenance of digital content through cryptographic techniques such as digital signatures, watermarking, and blockchain-anchored certificates. It enables consumers and platforms to distinguish authentic content from synthetically generated or tampered media, particularly critical as generative AI proliferates."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:digital-signature ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:public-key-infrastructure ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptographic-verification ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:certificate-authority ],
        ngm:infra-security-and-identity ;
    skos:broader ngm:infra-security-and-identity ;
    vc:bridgesTo ngm:artificial-intelligence,
        ngm:distributed-collaboration ;
    vc:contrastsWith ngm:deepfakes,
        ngm:synthetic-media ;
    vc:enables ngm:deepfake-detection,
        ngm:trust-establishment ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:implements ngm:c2-pa-content-credentials,
        ngm:c2-pa-standard ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:digital-rights-management,
        ngm:non-fungible-token,
        ngm:zero-knowledge-proof ;
    vc:requires ngm:certificate-authority,
        ngm:cryptographic-verification,
        ngm:digital-signature,
        ngm:public-key-infrastructure ;
    vc:slug "content-authentication" ;
    vc:sourceDomain "security" ;
    vc:supports ngm:digital-rights-management,
        ngm:information-integrity ;
    vc:uses ngm:blockchain,
        ngm:cryptographic-hash-function,
        ngm:digital-content-provenance-marking,
        ngm:merkle-tree,
        ngm:watermarking-service .

ngm:content-creation-pipeline a owl:Class ;
    rdfs:label "Content Creation Pipeline"@en ;
    rdfs:comment "A Content Creation Pipeline is a structured, orchestrated workflow that sequences and parallelises the stages of producing digital content—spanning ideation, scripting, asset generation, editorial review, quality assurance, and multi-platform distribution—into a reproducible and scalable production system. Modern pipelines integrate AI generation models, digital asset management systems, localisation engines, and publishing endpoints to deliver high-throughput content production with traceable asset provenance. They are the operational backbone of film VFX studios, game development, streaming platforms, and enterprise marketing operations, governing how raw creative intent is transformed into finished, distributed artefacts. Pipeline architecture choices directly determine release velocity, brand consistency, and the cost structure of large-scale content organisations."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:content-management-system ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:workflow-orchestration ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:asset-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:digital-asset-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:quality-assurance ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:version-control ],
        ngm:content-creation ;
    vc:bridgesTo ngm:data-pipeline,
        ngm:machine-learning-discipline-pipeline ;
    vc:dependsOn ngm:cloud-computing,
        ngm:content-delivery-network ;
    vc:enables ngm:localisation,
        ngm:media-production,
        ngm:metaverse-content-creation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:asset-management,
        ngm:distribution-platform,
        ngm:quality-assurance,
        ngm:workflow-orchestration ;
    vc:implements ngm:directed-acyclic-graph,
        ngm:provenance-tracking ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:digital-content-creation,
        ngm:video-production-pipeline ;
    vc:requires ngm:content-management-system,
        ngm:digital-asset-management,
        ngm:version-control ;
    vc:slug "content-creation-pipeline" ;
    vc:sourceDomain "distributed-collaboration" ;
    vc:uses ngm:content-creation-tool,
        ngm:generative-ai,
        ngm:render-farm,
        ngm:workflow-engine .

ngm:content-production-workflow a owl:Class ;
    rdfs:label "Content Production Workflow"@en ;
    rdfs:comment "A structured sequence of stages and toolchain integrations through which raw creative inputs are transformed into publishable digital assets, covering pre-production, asset authoring, review, rendering, and distribution. In spatial computing contexts, such workflows incorporate 3D asset pipelines, real-time rendering checks, and version-controlled delivery to metaverse platforms."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:rendering-pipeline ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:asset-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:digital-content-creation ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:version-control ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:digital-asset-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:asset-pipeline ],
        ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:bridgesTo ngm:artificial-intelligence,
        ngm:distributed-collaboration ;
    vc:dependsOn ngm:cloud-infrastructure,
        ngm:content-delivery-network ;
    vc:enables ngm:content-distribution,
        ngm:digital-content,
        ngm:real-time-rendering ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:asset-management,
        ngm:digital-content-creation,
        ngm:rendering-pipeline,
        ngm:version-control ;
    vc:isPartOf ngm:media-production ;
    vc:qualityScore "0.68"^^xsd:float ;
    vc:relatedTo ngm:3-d-content-pipeline,
        ngm:metaverse-content-pipeline ;
    vc:requires ngm:asset-pipeline,
        ngm:digital-asset-management ;
    vc:slug "content-production-workflow" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:extended-reality,
        ngm:spatial-computing ;
    vc:uses ngm:computer-vision,
        ngm:generative-ai .

ngm:controller a owl:Class ;
    rdfs:label "Controller"@en ;
    rdfs:comment "A Controller is a computational or hardware module that receives a reference setpoint and measured feedback signals, applies a control law or learned policy, and generates command signals that drive a plant or process towards desired states. Controllers span a spectrum from classical linear regulators such as PID and LQR to nonlinear model-based controllers such as Model Predictive Control and computed-torque methods, as well as data-driven approaches including neural network policies trained via reinforcement learning. Operating within closed-loop feedback architectures, the controller continuously computes an error signal — the difference between desired and measured output — and produces corrective actuation to minimise that error subject to stability and performance constraints."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:sensor ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:actuator ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:feedback-loop ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:plant-model ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:error-signal ],
        ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:bridgesTo ngm:digital-twin,
        ngm:neural-network,
        ngm:reinforcement-learning ;
    vc:contrastsWith ngm:open-loop-control ;
    vc:dependsOn ngm:real-time-computing,
        ngm:system-identification ;
    vc:enables ngm:motion-planning,
        ngm:robot-control,
        ngm:stability,
        ngm:trajectory-tracking ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:error-signal ;
    vc:implements ngm:linear-quadratic-regulator,
        ngm:model-predictive-control ;
    vc:isPartOf ngm:closed-loop-control,
        ngm:cyber-physical-systems ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:dynamics,
        ngm:kalman-filter,
        ngm:kinematics,
        ngm:state-observer ;
    vc:requires ngm:actuator,
        ngm:feedback-loop,
        ngm:plant-model,
        ngm:sensor ;
    vc:slug "controller" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:control-law,
        ngm:feedback-control,
        ngm:pid-controller,
        ngm:state-space-model .

ngm:coordination-mechanisms a owl:Class ;
    rdfs:label "Coordination Mechanisms"@en ;
    rdfs:comment "Coordination Mechanisms are the structural arrangements, protocols, and incentive designs that enable multiple autonomous agents—whether human organisations, software processes, or robotic systems—to align their actions toward shared goals whilst managing conflicts, resource contention, and information asymmetries. They include market-based mechanisms, hierarchical authority structures, consensus protocols, and shared state systems."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:voting-mechanism ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:byzantine-fault-tolerance ],
        ngm:governance-framework ;
    vc:bridgesTo ngm:artificial-intelligence,
        ngm:distributed-collaboration,
        ngm:robotics ;
    vc:contrastsWith ngm:market-mechanism ;
    vc:dependsOn ngm:communication-protocol,
        ngm:distributed-ledger,
        ngm:information-exchange ;
    vc:enables ngm:collective-action,
        ngm:decentralised-governance,
        ngm:multi-agent-system,
        ngm:task-allocation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:byzantine-fault-tolerance,
        ngm:voting-mechanism ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:contract-net-protocol,
        ngm:coordination-protocol,
        ngm:game-theory,
        ngm:mechanism-design ;
    vc:slug "coordination-mechanisms" ;
    vc:sourceDomain "governance" ;
    vc:supports ngm:orchestration,
        ngm:swarm-intelligence,
        ngm:workflow-automation ;
    vc:uses ngm:auction-mechanism,
        ngm:consensus-mechanism,
        ngm:incentive-structures,
        ngm:shared-memory .

ngm:corporate-tax-compliance-frameworkonomy a owl:Class ;
    rdfs:label "Taxonomy"@en ;
    rdfs:comment "A taxonomy is a hierarchical classification scheme that organises concepts or entities into nested categories based on shared characteristics, typically expressing broader-than and narrower-than relationships. It provides a controlled vocabulary that supports consistent naming, navigation, and retrieval within a domain. Taxonomies are a simpler precursor to fuller ontologies, which add richer relations and formal axioms."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:category-hierarchies ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:controlled-vocabulary ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:classification ],
        ngm:data-management ;
    vc:bridgesTo ngm:artificial-intelligence,
        ngm:knowledge-graph ;
    vc:contrastsWith ngm:folksonomy,
        ngm:ontology ;
    vc:enables ngm:data-governance,
        ngm:knowledge-retrieval ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:category-hierarchies,
        ngm:classification,
        ngm:controlled-vocabulary ;
    vc:isPartOf ngm:information-architecture,
        ngm:knowledge-organization-system ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:domain-ontology,
        ngm:etsi-metaverse-domain-taxonomy,
        ngm:information-retrieval,
        ngm:linked-data,
        ngm:metadata-schema ;
    vc:slug "taxonomy" ;
    vc:sourceDomain "data" ;
    vc:uses ngm:skos-vocabulary,
        ngm:thesaurus .

ngm:counter-terrorist-financing a owl:Class ;
    rdfs:label "Counter-Terrorist Financing"@en ;
    rdfs:comment "Counter-Terrorist Financing (CTF or CFT) is a set of legal, regulatory, and operational measures designed to detect, prevent, and disrupt the funding of terrorist activities. It complements anti-money-laundering regimes and is enforced through obligations such as customer due diligence, transaction monitoring, and reporting of suspicious activity. In digital assets, CTF underpins requirements like the FATF Travel Rule that mandate originator and beneficiary information for transfers."@en ;
    rdfs:subClassOf ngm:financial-regulation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:travel-rule ;
    vc:slug "counter-terrorist-financing" ;
    vc:sourceDomain "blockchain" .

ngm:credential-issuance a owl:Class ;
    rdfs:label "Credential Issuance"@en ;
    rdfs:comment "Credential issuance is the process by which an authoritative entity — an issuer — creates, signs, and delivers a structured attestation about a subject's attributes, qualifications, or identity to that subject or to a designated holder. In the W3C Verifiable Credentials model, issuance involves binding claims to a subject's decentralised identifier using the issuer's cryptographic key, producing a tamper-evident credential that the holder can present to verifiers without returning to the issuer. The issuance process encompasses schema selection, claim population, signature generation, and delivery, and may be implemented with varying degrees of issuer privacy, holder binding strength, and revocability."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:holder-binding ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:identity-proofing ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:key-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:certificate-authority ],
        ngm:identity-management ;
    vc:bridgesTo ngm:blockchain,
        ngm:governance ;
    vc:contrastsWith ngm:federated-identity ;
    vc:dependsOn ngm:digital-identity,
        ngm:trust-framework ;
    vc:enables ngm:credential-presentation,
        ngm:credential-verification,
        ngm:decentralised-identity,
        ngm:digital-trust,
        ngm:self-sovereign-identity ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:credential-revocation,
        ngm:holder-binding ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:digital-wallet,
        ngm:e-idas ;
    vc:requires ngm:certificate-authority,
        ngm:identity-proofing,
        ngm:key-management ;
    vc:slug "credential-issuance" ;
    vc:sourceDomain "security" ;
    vc:standardizedBy ngm:sd-jwt-vc,
        ngm:w3-c-verifiable-credentials ;
    vc:uses ngm:credential-schema,
        ngm:cryptographic-signature,
        ngm:decentralized-identifiers,
        ngm:oauth-2-0,
        ngm:public-key-infrastructure,
        ngm:selective-disclosure,
        ngm:verifiable-credentials .

ngm:cryptographic-algorithm a owl:Class ;
    rdfs:label "Cryptographic Algorithm"@en ;
    rdfs:comment "A Cryptographic Algorithm is a precisely defined mathematical procedure that transforms data to achieve security properties—confidentiality, integrity, authentication, or non-repudiation—based on computational hardness assumptions. The class encompasses symmetric ciphers, asymmetric (public-key) schemes, hash functions, digital signature algorithms, and zero-knowledge proof systems, each providing different security guarantees and performance characteristics."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:random-number-generation ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:public-key-cryptography ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:symmetric-encryption ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:hardware-security-module ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:hash-function ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:key-management ],
        ngm:cryptography ;
    vc:bridgesTo ngm:blockchain,
        ngm:distributed-systems ;
    vc:contrastsWith ngm:obfuscation,
        ngm:steganography ;
    vc:enables ngm:authentication,
        ngm:data-integrity,
        ngm:digital-signature,
        ngm:encryption,
        ngm:secure-communication ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:hash-function,
        ngm:public-key-cryptography,
        ngm:symmetric-encryption ;
    vc:implements ngm:computational-hardness-assumption,
        ngm:post-quantum-cryptography ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:homomorphic-encryption,
        ngm:message-authentication-code,
        ngm:public-key-cryptography ;
    vc:requires ngm:hardware-security-module,
        ngm:key-management,
        ngm:random-number-generation ;
    vc:slug "cryptographic-algorithm" ;
    vc:sourceDomain "security" ;
    vc:standardizedBy ngm:internet-engineering-task-force ;
    vc:supports ngm:public-key-infrastructure,
        ngm:transport-layer-security,
        ngm:zero-knowledge-proof .

ngm:data-catalogue a owl:Class ;
    rdfs:label "Data Catalogue"@en ;
    rdfs:comment "A data catalogue is a centralised, searchable inventory of an organisation's data assets enriched with metadata, descriptions, lineage and usage information. It helps users discover, understand, trust and govern data by linking technical metadata with business context and policies. Modern catalogues often automate metadata harvesting and use collaboration features to capture institutional knowledge."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:metadata ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:data-lineage ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:metadata-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:data-dictionary ],
        ngm:data-management ;
    vc:bridgesTo ngm:data-lake,
        ngm:master-data-management ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:data-dictionary,
        ngm:data-lineage,
        ngm:metadata ;
    vc:isPartOf ngm:data-management ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:data-management ;
    vc:requires ngm:metadata-management ;
    vc:slug "data-catalogue" ;
    vc:sourceDomain "data" ;
    vc:supports ngm:data-discovery,
        ngm:data-governance,
        ngm:data-quality ;
    vc:uses ngm:data-standards,
        ngm:dublin-core .

ngm:data-center a owl:Class ;
    rdfs:label "Data Center"@en ;
    rdfs:comment "A data center is a purpose-built facility that houses computing servers, storage, and networking equipment together with the power, cooling, and physical security required to run them reliably at scale. It provides the controlled environment and redundant infrastructure that underpin cloud computing, internet services, and enterprise IT. Data centers range from small server rooms to hyperscale campuses and are increasingly designed for energy efficiency and renewable supply."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:power-grid ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:renewable-energy ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:liquid-cooling ],
        ngm:cloud-infrastructure ;
    vc:bridgesTo ngm:infrastructure ;
    vc:enables ngm:high-availability ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:liquid-cooling,
        ngm:server ;
    vc:isPartOf ngm:cloud-computing ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:cdn,
        ngm:geographic-distribution ;
    vc:requires ngm:power-grid,
        ngm:renewable-energy ;
    vc:slug "data-center" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:edge-computing,
        ngm:failover ;
    vc:uses ngm:gpu,
        ngm:redundancy .

ngm:didcomm a owl:Class ;
    rdfs:label "DIDComm"@en ;
    rdfs:comment "DIDComm (Decentralised Identifier Communication) is a secure, private messaging protocol built on top of the W3C Decentralised Identifiers specification, enabling peer-to-peer, end-to-end encrypted communication between parties whose identities are anchored to DIDs. The protocol specifies how messages are packaged, signed, and encrypted using keys derived from DID documents, without reliance on any central server or directory. DIDComm messages are transport-agnostic, operating over HTTP, Bluetooth, NFC, or any delivery mechanism, making the protocol suitable for both online and offline identity interactions. It forms the communication backbone of the self-sovereign identity ecosystem."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:did-resolver ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:end-to-end-encryption ],
        ngm:decentralized-identity-did ;
    vc:bridgesTo ngm:internet-of-things ;
    vc:contrastsWith ngm:oauth-2-0,
        ngm:open-id-connect ;
    vc:enables ngm:credential-issuance,
        ngm:credential-presentation,
        ngm:inter-agent-communication,
        ngm:protocol-layer,
        ngm:verifiable-credential-vc ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:decentralized-identity-foundation,
        ngm:hyperledger-aries,
        ngm:json-web-encryption,
        ngm:self-sovereign-identity,
        ngm:trust-over-ip-stack,
        ngm:w3-c-did-core ;
    vc:requires ngm:did-resolver,
        ngm:end-to-end-encryption ;
    vc:slug "didcomm" ;
    vc:sourceDomain "security" ;
    vc:standardizedBy ngm:decentralized-identity-foundation,
        ngm:w3-c-did-core ;
    vc:uses ngm:did-document,
        ngm:did-resolution,
        ngm:peer-to-peer-network,
        ngm:public-key-cryptography,
        ngm:verifiable-credentials .

ngm:digital-preservation a owl:Class ;
    rdfs:label "Digital Preservation"@en ;
    rdfs:comment "Digital Preservation is the managed set of processes, standards, and technologies applied to ensure that digital objects remain accessible, authentic, and usable over extended time periods, spanning decades or centuries. It encompasses format migration, bit-level integrity verification via checksumming, redundant and geographically distributed storage, and comprehensive provenance tracking through metadata standards such as OAIS and PREMIS. Effective digital preservation requires active management of hardware and software obsolescence, format dependency chains, and institutional policy frameworks that together prevent the loss or corruption of cultural, scientific, and organisational digital assets. It is distinguished from simple backup by its explicit concern with long-term interpretability and authenticity rather than mere bit-level recovery."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-integrity ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:metadata-standard ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:format-migration ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:metadata-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:provenance-tracking ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:storage-infrastructure ],
        ngm:data-management ;
    vc:bridgesTo ngm:decentralised-storage,
        ngm:knowledge-graph,
        ngm:smart-contract ;
    vc:contrastsWith ngm:backup-and-recovery ;
    vc:enables ngm:digital-asset-management,
        ngm:etsi-domain-data-management-cultural-heritage ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:checksum-verification,
        ngm:format-migration,
        ngm:metadata-management,
        ngm:provenance-tracking ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:archival-standards,
        ngm:digital-rights-management,
        ngm:lifecycle-management ;
    vc:requires ngm:data-integrity,
        ngm:metadata-standard,
        ngm:storage-infrastructure ;
    vc:slug "digital-preservation" ;
    vc:sourceDomain "infrastructure" ;
    vc:standardizedBy ngm:iso-14721,
        ngm:metadata-standard,
        ngm:reference-model ;
    vc:uses ngm:blockchain,
        ngm:content-addressed-storage,
        ngm:cryptographic-hash,
        ngm:distributed-storage .

ngm:disclosure a skos:Concept ;
    rdfs:label "Disclosure"@en .

ngm:double-spend-prevention a owl:Class ;
    rdfs:label "Double-Spend Prevention"@en ;
    rdfs:comment "Double-spend prevention refers to the set of cryptographic, consensus-based, and protocol-level mechanisms that ensure a given unit of digital value cannot be spent more than once within a payment or transaction system. This problem is fundamental to digital money because, unlike physical currency, digital data can be trivially copied; preventing double-spending without a trusted central authority was the key unsolved challenge that Satoshi Nakamoto's Bitcoin whitepaper addressed through the combination of a public transaction ledger and proof-of-work consensus."@en ;
    rdfs:subClassOf ngm:blockchain-security ;
    vc:contrastsWith ngm:double-spending ;
    vc:enables ngm:distributed-consensus,
        ngm:finality ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:byzantine-fault-tolerance,
        ngm:nakamoto-consensus ;
    vc:slug "double-spend-prevention" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:consensus-mechanism,
        ngm:cryptographic-hash,
        ngm:proof-of-stake,
        ngm:proof-of-work .

ngm:early-stopping a owl:Class ;
    rdfs:label "Early Stopping"@en ;
    rdfs:comment "A regularisation technique that terminates model training when validation performance ceases to improve for a configurable number of epochs (the patience parameter), preventing overfitting by restoring the best checkpoint before performance degraded. Early stopping balances training progress against generalisation to unseen data and is most effective when combined with other regularisation techniques such as dropout and weight decay."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:epoch ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:regularisation ],
        ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:contrastsWith ngm:overfitting ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:deep-learning ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:batch-size,
        ngm:hyperparameter ;
    vc:requires ngm:epoch,
        ngm:regularisation ;
    vc:slug "early-stopping" ;
    vc:sourceDomain "spatial-computing" .

ngm:eip-712 a owl:Class ;
    rdfs:label "EIP-712"@en ;
    rdfs:comment "EIP-712 (Ethereum Improvement Proposal 712) is a standard for hashing and signing typed structured data in Ethereum, enabling wallets to display human-readable transaction information instead of opaque hexadecimal byte strings before a user signs a message. It defines a domain separator (chainId, contract address, version) that binds a signature to a specific deployment context to prevent cross-chain or cross-contract replay attacks, and a type-encoding scheme that recursively hashes structured fields to produce a deterministic 32-byte digest that the ECDSA private key signs. EIP-712 is the foundation of off-chain signing workflows — gasless approvals, meta-transactions, permit() functions (EIP-2612), delegated votes, and order book signatures in decentralised exchanges — making it one of the most widely deployed Ethereum standards."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ecdsa ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ethereum-smart-contract-platform-virtual-machine ],
        ngm:digital-signature ;
    vc:bridgesTo ngm:digital-identity,
        ngm:zero-knowledge-proof ;
    vc:enables ngm:account-abstraction,
        ngm:de-fi,
        ngm:digital-wallet,
        ngm:gasless-transaction,
        ngm:meta-transaction ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:replay-attack-prevention ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:cryptographic-signature,
        ngm:eip-1559,
        ngm:non-fungible-token,
        ngm:smart-contract ;
    vc:requires ngm:ecdsa,
        ngm:ethereum-smart-contract-platform-virtual-machine ;
    vc:slug "eip-712" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:decentralised-exchange,
        ngm:on-chain-governance,
        ngm:smart-contract-execution ;
    vc:uses ngm:digital-signature-verification,
        ngm:erc-721 .

ngm:embedding-layer a owl:Class ;
    rdfs:label "Embedding Layer"@en ;
    rdfs:comment "An embedding layer is a trainable component of a neural network that maps discrete tokens or categorical indices to dense, continuous vector representations. It is implemented as a lookup table whose rows are learned vectors, transforming sparse one-hot inputs into low-dimensional embeddings that capture semantic and relational structure. Embedding layers are the standard entry point for language, recommendation, and sequence models."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:tokenization ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:vocabulary ],
        ngm:neural-network ;
    vc:contrastsWith ngm:one-hot-encoding ;
    vc:dependsOn ngm:machine-learning ;
    vc:enables ngm:representation-learning,
        ngm:word-embedding ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:embedding ;
    vc:isPartOf ngm:neural-network,
        ngm:transformer ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:encoder,
        ngm:positional-encoding ;
    vc:requires ngm:tokenization,
        ngm:vocabulary ;
    vc:slug "embedding-layer" ;
    vc:sourceDomain "machine-learning" ;
    vc:supports ngm:natural-language-processing ;
    vc:uses ngm:backpropagation,
        ngm:one-hot-encoding .

ngm:embedding-space a owl:Class ;
    rdfs:label "Embedding Space"@en ;
    rdfs:comment "An embedding space is a continuous vector space into which discrete or high-dimensional objects — such as words, images, or graph nodes — are mapped so that geometric relationships encode semantic similarity. Learned by models during representation learning, the space arranges related items close together and supports operations like nearest-neighbour search and analogy via vector arithmetic. It is the substrate underlying semantic search, retrieval, and many downstream machine-learning tasks."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:dimensionality-reduction ],
        ngm:representation-learning ;
    vc:bridgesTo ngm:word-embedding ;
    vc:contrastsWith ngm:latent-space ;
    vc:dependsOn ngm:embedding,
        ngm:training-data ;
    vc:enables ngm:clustering,
        ngm:semantic-search ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:latent-space ;
    vc:isPartOf ngm:representation-learning ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:deep-neural-network,
        ngm:knowledge-graph-embedding,
        ngm:transfer-learning,
        ngm:vector-embedding ;
    vc:requires ngm:dimensionality-reduction ;
    vc:slug "embedding-space" ;
    vc:sourceDomain "machine-learning" ;
    vc:supports ngm:vector-database ;
    vc:uses ngm:cosine-similarity,
        ngm:embedding .

ngm:emergent-behavior a owl:Class ;
    rdfs:label "Emergent Behavior"@en ;
    rdfs:comment "Emergent Behavior is complex, system-level behaviour that arises from the interactions of many simpler components or agents and is not explicitly programmed into any individual part. In AI-driven game agents and open-world simulations it produces lifelike, unscripted dynamics from local rules and agent decisions. Emergence is valued for richness and replayability but can be hard to predict, test, and control."@en ;
    rdfs:subClassOf ngm:ai-agent-system ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:ai-game-agent,
        ngm:open-world ;
    vc:slug "emergent-behavior" ;
    vc:sourceDomain "ai" .

ngm:entropy-source a owl:Class ;
    rdfs:label "Entropy Source"@en ;
    rdfs:comment "An entropy source is a physical or computational process that produces unpredictable raw data used to seed cryptographic random number generation. Good entropy sources draw on inherently uncertain phenomena, such as electronic noise, timing jitter or radioactive decay, so that their output cannot be predicted or reproduced by an adversary. The quality of an entropy source directly determines the strength of keys, nonces and other security-critical random values derived from it."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:entropy ],
        ngm:random-number-generation ;
    vc:dependsOn ngm:hardware-security-module ;
    vc:enables ngm:cryptographic-key,
        ngm:key-generation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:randomness ;
    vc:isPartOf ngm:random-number-generation ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:cryptography,
        ngm:key-management ;
    vc:requires ngm:entropy ;
    vc:slug "entropy-source" ;
    vc:sourceDomain "security" ;
    vc:supports ngm:initialization-vector,
        ngm:nonce ;
    vc:uses ngm:random-bit-generation .

ngm:environment-mapping a owl:Class ;
    rdfs:label "Environment Mapping"@en ;
    rdfs:comment "Environment mapping is the robotics and computer-vision process of building a spatial representation of a robot's surroundings from sensor data such as lidar, cameras, or depth sensors. Representations include occupancy grids, point clouds, and topological or semantic maps that record obstacles, free space, and landmarks. Accurate mapping is a prerequisite for localisation, path planning, and safe autonomous navigation."@en ;
    rdfs:subClassOf ngm:robo-navigation-and-planning ;
    skos:broader ngm:robo-navigation-and-planning ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:mobile-robot-platform,
        ngm:occupancy-grid ;
    vc:slug "environment-mapping" ;
    vc:sourceDomain "robotics" .

ngm:environment-model a owl:Class ;
    rdfs:label "Environment Model"@en ;
    rdfs:comment "An environment model is an internal representation maintained by a robot, autonomous agent, or AI system that encodes the geometry, semantics, dynamics, and state of its surrounding physical or virtual world, enabling planning, navigation, and interaction without direct real-time sensor observation of every aspect of the scene. It may range from metric maps and occupancy grids to rich semantic scene graphs and learned neural radiance fields."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:pose-estimation ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:topological-map ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:inertial-measurement-unit ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:lidar ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:depth-sensor ],
        ngm:scene-graph ;
    vc:bridgesTo ngm:embodied-ai,
        ngm:spatial-computing ;
    vc:contrastsWith ngm:reactive-control ;
    vc:dependsOn ngm:computer-vision,
        ngm:state-estimation ;
    vc:enables ngm:autonomous-navigation,
        ngm:collision-avoidance,
        ngm:digital-twin,
        ngm:motion-planning,
        ngm:task-planning ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:semantic-map,
        ngm:topological-map ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:depth-sensor,
        ngm:embodied-ai,
        ngm:gaussian-splatting,
        ngm:lidar,
        ngm:world-model ;
    vc:requires ngm:depth-sensor,
        ngm:inertial-measurement-unit,
        ngm:lidar,
        ngm:pose-estimation ;
    vc:slug "environment-model" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:neural-radiance-field,
        ngm:occupancy-grid,
        ngm:point-cloud,
        ngm:sensor-fusion,
        ngm:simultaneous-localisation-and-mapping,
        ngm:voxel-grid .

ngm:ether-cat a owl:Class ;
    rdfs:label "EtherCAT"@en ;
    rdfs:comment "EtherCAT (Ethernet for Control Automation Technology) is an open, IEC 61158-standardised real-time Ethernet fieldbus protocol developed by Beckhoff Automation, enabling deterministic, high-bandwidth communication between industrial master controllers and distributed slave devices such as servo drives, I/O modules, and encoders. Its on-the-fly processing architecture allows each slave node to extract addressed data from and insert its response into a propagating Ethernet frame, achieving sub-microsecond synchronisation across large distributed networks. Governed by the EtherCAT Technology Group (ETG), the standard is widely deployed in industrial robotics, CNC machining, semiconductor manufacturing, and laboratory automation, with the Safety over EtherCAT (FSoE) extension providing IEC 61784-3-compliant functional safety over the same physical layer."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ethernet ],
        ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:bridgesTo ngm:industrial-io-t,
        ngm:time-sensitive-networking ;
    vc:contrastsWith ngm:profinet ;
    vc:enables ngm:motion-control,
        ngm:real-time-communication ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:implements ngm:iec-61158 ;
    vc:qualityScore "0.73"^^xsd:float ;
    vc:relatedTo ngm:functional-safety,
        ngm:industrial-automation,
        ngm:opc-ua,
        ngm:robot-operating-system ;
    vc:requires ngm:ethernet ;
    vc:slug "ether-cat" ;
    vc:sourceDomain "robotics" ;
    vc:standardizedBy ngm:iec ;
    vc:supports ngm:cnc-machining,
        ngm:industrial-robot,
        ngm:programmable-logic-controller,
        ngm:servo-motor .

ngm:european-commission a owl:Class ;
    rdfs:label "European Commission"@en ;
    rdfs:comment "The European Commission is the politically independent executive body of the European Union, holding the exclusive right of legislative initiative and responsible for proposing legislation, implementing decisions of the Council of the European Union, managing the EU budget, and upholding EU treaties and law across all 27 member states. In the technology domain it has authored landmark regulatory frameworks including the EU AI Act, the Data Governance Act, the Digital Markets Act, and the Digital Services Act, constituting the most comprehensive digital governance agenda of any jurisdiction. It also directs research funding through Horizon Europe, coordinates AI standardisation mandates to CEN-CENELEC and ETSI, and operates cross-border digital infrastructure such as the European Blockchain Services Infrastructure."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:european-parliament ],
        ngm:infra-legal-and-regulatory ;
    skos:broader ngm:infra-legal-and-regulatory ;
    vc:bridgesTo ngm:blockchain,
        ngm:distributed-ledger-technology,
        ngm:machine-learning ;
    vc:enables ngm:ai-regulation,
        ngm:data-governance,
        ngm:digital-markets-act,
        ngm:digital-services-act ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:data-protection-regulation,
        ngm:eu-ai-act-regulatory-instrument ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:artificial-intelligence,
        ngm:conformity-assessment,
        ngm:digital-identity,
        ngm:regulatory-authority,
        ngm:risk-based-regulation ;
    vc:requires ngm:european-parliament ;
    vc:slug "european-commission" ;
    vc:sourceDomain "governance" ;
    vc:standardizedBy ngm:cen-cenelec,
        ngm:etsi ;
    vc:supports ngm:digital-single-market,
        ngm:governance,
        ngm:open-data,
        ngm:regulatory-compliance .

ngm:face-recognition a owl:Class ;
    rdfs:label "Face Recognition"@en ;
    rdfs:comment "Face recognition is a biometric identification and verification technology that locates human faces in images or video frames, extracts a compact numerical embedding of facial geometry and texture, and compares that embedding against one or more enrolled templates to establish identity. It is a specialised subfield of Computer Vision and Biometric Authentication that combines deep convolutional feature learning with metric-learning loss functions such as ArcFace and AdaFace to achieve sub-second, high-accuracy identification at scale."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:image-processing ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:pattern-recognition ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:feature-extraction ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:presentation-attack-detection ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:convolutional-neural-network ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:deep-learning ],
        ngm:biometric-authentication,
        ngm:computer-vision ;
    vc:contrastsWith ngm:fingerprint-recognition,
        ngm:iris-recognition ;
    vc:dependsOn ngm:annotated-dataset,
        ngm:gpu-computing ;
    vc:enables ngm:access-control,
        ngm:digital-identity-verification,
        ngm:emotion-recognition,
        ngm:identity-verification,
        ngm:surveillance-systems ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:embedding-generation,
        ngm:face-alignment,
        ngm:face-detection,
        ngm:feature-extraction,
        ngm:presentation-attack-detection ;
    vc:implements ngm:adaface,
        ngm:arcface ;
    vc:qualityScore "0.92"^^xsd:float ;
    vc:relatedTo ngm:deepfake-detection,
        ngm:differential-privacy,
        ngm:eu-ai-act,
        ngm:facial-action-coding-system,
        ngm:gdpr ;
    vc:requires ngm:convolutional-neural-network,
        ngm:deep-learning,
        ngm:image-processing,
        ngm:metric-learning,
        ngm:pattern-recognition ;
    vc:slug "face-recognition" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:affective-computing,
        ngm:biometric-authentication,
        ngm:facial-action-coding-system .

ngm:fiscal-policy a owl:Class ;
    rdfs:label "Fiscal Policy"@en ;
    rdfs:comment "Fiscal policy is the use of government spending and taxation to influence aggregate demand, employment, inflation and economic growth within an economy. It is enacted by a government's treasury or finance ministry through budgets that adjust expenditure programmes, tax rates and public borrowing, and it is the principal counterpart to the monetary policy operated by a central bank. Expansionary fiscal policy raises spending or cuts taxes to stimulate a weak economy, while contractionary policy does the reverse to restrain overheating or reduce public debt."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:treasury-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:hm-treasury ],
        ngm:macroeconomics ;
    vc:contrastsWith ngm:monetary-policy ;
    vc:enables ngm:economic-growth,
        ngm:inflation-control ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:isPartOf ngm:macroeconomics ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:central-bank,
        ngm:economic-model,
        ngm:economic-systems,
        ngm:economics,
        ngm:inflation,
        ngm:political-economy ;
    vc:requires ngm:hm-treasury,
        ngm:treasury-management ;
    vc:slug "fiscal-policy" ;
    vc:sourceDomain "finance" ;
    vc:supports ngm:economic-governance ;
    vc:uses ngm:econometrics,
        ngm:quantitative-easing .

ngm:fleet-management a owl:Class ;
    rdfs:label "Fleet Management"@en ;
    rdfs:comment "Fleet management is the coordinated administration, monitoring, and optimisation of a collection of mobile assets — vehicles, drones, robots, or edge devices — across their operational lifecycle, encompassing real-time telemetry collection, route and task planning, maintenance scheduling, regulatory compliance, driver or operator management, and fuel or energy consumption optimisation. Modern fleet management systems integrate GPS tracking, telematics sensors, AI-driven analytics, and communications networks to provide operators with situational awareness and control over large numbers of assets dispersed across wide geographic areas."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:predictive-maintenance ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cellular-network ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:logistics-optimisation ],
        ngm:asset-management ;
    vc:bridgesTo ngm:artificial-intelligence,
        ngm:robotics ;
    vc:dependsOn ngm:cloud-computing,
        ngm:data-analytics ;
    vc:enables ngm:autonomous-navigation,
        ngm:energy-management,
        ngm:technology-programme-delivery-planning ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:logistics-optimisation,
        ngm:predictive-maintenance,
        ngm:telematics ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:autonomous-vehicle,
        ngm:logistics-optimization ;
    vc:requires ngm:cellular-network ;
    vc:slug "fleet-management" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:regulatory-compliance,
        ngm:supply-chain ;
    vc:uses ngm:digital-twin,
        ngm:edge-computing,
        ngm:io-t-sensor-network,
        ngm:machine-learning,
        ngm:real-time-monitoring .

ngm:floating-point-arithmetic a owl:Class ;
    rdfs:label "Floating-Point Arithmetic"@en ;
    rdfs:comment "Floating-point arithmetic is a method of representing and computing with real numbers on digital hardware using a sign, a fixed-precision significand, and an exponent, most commonly standardised by IEEE 754. It trades exactness for a wide dynamic range, so operations introduce rounding error, and properties such as associativity no longer hold exactly. Understanding its precision limits, rounding modes, and special values is essential for numerically reliable simulation, graphics, and machine learning."@en ;
    rdfs:subClassOf ngm:computing-infrastructure ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:collision-detection,
        ngm:model-optimisation-and-performance ;
    vc:slug "floating-point-arithmetic" ;
    vc:sourceDomain "infrastructure" .

ngm:flow-control a owl:Class ;
    rdfs:label "Flow Control"@en ;
    rdfs:comment "Flow control is the mechanism by which a data communication protocol prevents a fast sender from overwhelming a slower receiver. It regulates the rate or volume of data in transit using techniques such as sliding windows, credit schemes and backpressure, so that the receiver's buffers are not exceeded. Distinct from congestion control, which protects the shared network, flow control is an end-to-end concern that protects the individual receiving endpoint."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:reliability ],
        ngm:network-protocol ;
    vc:contrastsWith ngm:congestion-control ;
    vc:enables ngm:network-transport,
        ngm:reliability ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:reliability ;
    vc:isPartOf ngm:network-transport,
        ngm:transport-layer ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:concurrency,
        ngm:congestion-control,
        ngm:network-protocol ;
    vc:slug "flow-control" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:quic,
        ngm:reliability ;
    vc:uses ngm:communication-protocols,
        ngm:rate-limiting .

ngm:flow-matching a owl:Class ;
    rdfs:label "Flow Matching"@en ;
    rdfs:comment "Flow Matching is a generative modelling framework that trains a neural network to parameterise the vector field of a continuous normalising flow by directly regressing on analytically tractable target vector fields defined along conditional flow paths between a source distribution (typically Gaussian noise) and a data distribution. Unlike score-based diffusion models, which require simulating a stochastic differential equation during training, flow matching uses deterministic conditional flow paths that can be computed in closed form via Conditional Flow Matching (CFM), yielding stable and efficient training without ODE simulation at training time. At inference the learned vector field is integrated with an ODE solver to transport samples from noise to data, enabling high-quality generation with fewer neural function evaluations than diffusion alternatives. The framework unifies and generalises prior work on continuous normalising flows, score matching, and diffusion probabilistic models under a single regression objective."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:neural-network ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:probability-distribution ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ordinary-differential-equation ],
        ngm:generative-model ;
    vc:bridgesTo ngm:computational-biology,
        ngm:drug-discovery ;
    vc:contrastsWith ngm:diffusion-model,
        ngm:generative-adversarial-network,
        ngm:normalising-flow,
        ngm:variational-autoencoder ;
    vc:enables ngm:audio-generation,
        ngm:image-synthesis,
        ngm:protein-structure-prediction ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:normalising-flow ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:latent-diffusion,
        ngm:probabilistic-model,
        ngm:rectified-flow,
        ngm:score-based-generative-model ;
    vc:requires ngm:neural-network,
        ngm:ordinary-differential-equation,
        ngm:probability-distribution ;
    vc:slug "flow-matching" ;
    vc:sourceDomain "machine-learning" ;
    vc:uses ngm:deep-learning,
        ngm:optimal-transport,
        ngm:score-matching .

ngm:fluid-simulation a owl:Class ;
    rdfs:label "Fluid Simulation"@en ;
    rdfs:comment "Fluid Simulation is the computational modelling of liquid and gas dynamics using numerical methods — notably computational fluid dynamics (CFD) and Navier-Stokes solvers — to produce physically plausible representations of water, smoke, fire, and atmospheric phenomena in real-time or offline rendering pipelines. In spatial computing and metaverse environments it contributes to environmental immersion and interactive physics, running on GPU compute shaders for performance-critical applications."@en ;
    rdfs:subClassOf ngm:sc-display-and-rendering ;
    skos:broader ngm:sc-display-and-rendering ;
    vc:enables ngm:embodied-ai-simulation ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:physics-simulation ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:3-d-rendering-engine,
        ngm:computer-graphics,
        ngm:game-engine,
        ngm:particle-system,
        ngm:physics-engine ;
    vc:slug "fluid-simulation" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:compute-shader,
        ngm:gpu-compute,
        ngm:math-library .

ngm:forward-secrecy a owl:Class ;
    rdfs:label "Forward Secrecy"@en ;
    rdfs:comment "Forward secrecy, also called perfect forward secrecy, is a property of key-agreement protocols ensuring that the compromise of long-term private keys does not allow an attacker to decrypt previously recorded session traffic. It is achieved by deriving ephemeral session keys for each connection through a fresh key exchange and discarding them afterwards, so that no single persistent secret can retroactively unlock past communications. The property is a cornerstone of modern transport-layer security."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:key-exchange ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptography ],
        ngm:cryptographic-protocol ;
    vc:enables ngm:data-protection,
        ngm:secure-communication ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:cryptographic-protocol,
        ngm:key-exchange ;
    vc:isPartOf ngm:information-security ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:encryption,
        ngm:public-key-cryptography,
        ngm:symmetric-encryption ;
    vc:requires ngm:cryptography,
        ngm:key-exchange ;
    vc:slug "forward-secrecy" ;
    vc:sourceDomain "security" ;
    vc:supports ngm:tls-encryption,
        ngm:transport-layer-security .

ngm:gauge-voting a owl:Class ;
    rdfs:label "Gauge Voting"@en ;
    rdfs:comment "Gauge voting is a mechanism in DeFi protocols such as Curve where token holders allocate weights to liquidity pool gauges, determining how reward emissions are distributed across pools each epoch. Voting power is typically proportional to vote-escrowed (veToken) balances, creating direct economic incentives for bribe markets and liquidity direction."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:vote-escrow ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:epoch ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:liquidity-pool ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:curve-finance ],
        ngm:governance-token ;
    vc:bridgesTo ngm:decentralized-finance,
        ngm:governance ;
    vc:contrastsWith ngm:quadratic-voting ;
    vc:dependsOn ngm:decentralized-autonomous-organization ;
    vc:enables ngm:bribe-market,
        ngm:hidden-hand,
        ngm:votium ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:epoch ;
    vc:implements ngm:tokenomics ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:convex-finance,
        ngm:curve-wars,
        ngm:liquidity-mining,
        ngm:protocol-owned-liquidity ;
    vc:requires ngm:curve-finance,
        ngm:liquidity-pool,
        ngm:vote-escrow ;
    vc:slug "gauge-voting" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:automated-market-maker,
        ngm:smart-contract .

ngm:generator-network a owl:Class ;
    rdfs:label "Generator Network"@en ;
    rdfs:comment "A generator network is the synthesis component of a generative deep learning architecture — most prominently within Generative Adversarial Networks (GANs) — that learns to map samples from a low-dimensional latent space into high-dimensional data outputs (images, audio, video, 3D shapes) whose statistical distribution matches that of a training dataset. The generator is trained in adversarial competition with a discriminator network, receiving gradient signal not from direct comparison with target samples but from the discriminator's attempt to distinguish generated from real samples, forcing the generator to produce increasingly realistic outputs. Generator networks are the conceptual precursors to the decoder components of VAEs and the denoising networks of diffusion models."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:adversarial-training ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:convolution ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:loss-function ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:discriminator-network ],
        ngm:generative-model ;
    vc:bridgesTo ngm:robotics,
        ngm:spatial-computing ;
    vc:contrastsWith ngm:diffusion-model,
        ngm:discriminator-network,
        ngm:variational-autoencoders ;
    vc:enables ngm:data-augmentation,
        ngm:image-generation,
        ngm:style-transfer,
        ngm:super-resolution,
        ngm:synthetic-data-generator,
        ngm:text-to-image-generation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:convolution ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:deep-generative-model,
        ngm:noise-injection,
        ngm:transformer-architecture ;
    vc:requires ngm:adversarial-training,
        ngm:discriminator-network,
        ngm:loss-function ;
    vc:slug "generator-network" ;
    vc:sourceDomain "machine-learning" ;
    vc:uses ngm:backpropagation,
        ngm:batch-normalisation,
        ngm:convolutional-neural-network,
        ngm:generative-adversarial-network,
        ngm:neural-network-architecture,
        ngm:neural-network-latent-space .

ngm:geographic-information-system a owl:Class ;
    rdfs:label "Geographic Information System"@en ;
    rdfs:comment "A Geographic Information System (GIS) is an integrated framework for capturing, storing, managing, analysing and visualising data that is referenced to locations on the Earth's surface. It combines spatial databases, coordinate systems and analytical operations to model geographic phenomena and answer questions about place, distance, pattern and relationship. GIS underpins applications ranging from urban planning and environmental monitoring to logistics and emergency response."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:coordinate-system ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
