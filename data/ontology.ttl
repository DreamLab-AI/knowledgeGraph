    rdfs:subClassOf mv:3DAsset ;
    rdfs:label "Virtual Model"@en ;
    rdfs:comment "A digital 3D representation of objects, characters, environments, or systems created using computer graphics software for use in metaverse platforms, simulations, games, and virtual production, including static assets, animated models, and procedurally generated content."@en ;
