        ngm:sftp,
        ngm:xbrl .

ngm:render-pipeline a owl:Class ;
    rdfs:label "Render Pipeline"@en ;
    rdfs:comment "A Render Pipeline is the ordered sequence of programmable and fixed-function GPU stages that transforms 3D scene geometry and material data into a final 2D image frame, encompassing vertex shading, rasterisation, fragment shading, post-processing, and presentation. Modern pipelines in Vulkan, Metal, and WebGPU expose fine-grained control over each stage, enabling techniques such as deferred rendering, ray tracing, and compute-shader-based effects that underpin real-time immersive experiences in XR headsets and metaverse platforms."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:shader ],
        ngm:sc-display-and-rendering ;
    skos:broader ngm:sc-display-and-rendering ;
    vc:enables ngm:immersive-experience,
        ngm:simulation ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:shader ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:relatedTo ngm:signal-processing ;
    vc:slug "render-pipeline" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:3-d-rendering-engine,
        ngm:physics-engine .

ngm:reward-model a owl:Class ;
    rdfs:label "Reward Model"@en ;
    rdfs:comment "A neural network trained to predict scalar rewards for model outputs based on human feedback, used to provide learning signals in reinforcement learning from human feedback (RLHF). The reward model serves as a proxy for human preferences, enabling efficient optimization without constant human evaluation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:human-feedback ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:supervised-fine-tuning ],
        ngm:ai-technique,
        ngm:reinforcement-learning ;
    skos:broader ngm:ai-technique ;
    vc:enables ngm:ai-alignment,
        ngm:reinforcement-learning-from-human-feedback ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:model-performance ;
    vc:requires ngm:human-feedback,
        ngm:supervised-fine-tuning ;
    vc:slug "reward-model" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:servo-motor a owl:Class ;
    rdfs:label "Servo Motor"@en ;
    rdfs:comment "Servo motor provides precise position, velocity, and torque control."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
