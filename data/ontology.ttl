    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:chatbot,
        ngm:dialogue-systems ;
    vc:slug "customer-support-automation" ;
    vc:sourceDomain "ai" .

ngm:cvss a skos:Concept ;
    rdfs:label "Cvss"@en .

ngm:cybernetics a owl:Class ;
    rdfs:label "Cybernetics"@en ;
    rdfs:comment "Cybernetics is the transdisciplinary science of regulatory systems, feedback mechanisms, and goal-directed behaviour in animals, machines, and organisations, founded by Norbert Wiener in 1948 to provide a unified framework for understanding how systems use information to maintain stability and achieve purposes across biological, mechanical, and social domains. It centres on the study of circular causal processes — feedback loops — through which a system compares its actual state against a desired state and acts to reduce the discrepancy, extending naturally to concepts of information, communication, control, and self-organisation. Second-order cybernetics extends this to include the observer as a participant in the system being observed, influencing systems theory, cognitive science, constructivism, and AI."@en ;
    rdfs:subClassOf ngm:control-theory ;
    vc:enables ngm:adaptive-control,
        ngm:brain-computer-interfaces,
        ngm:human-robot-interaction ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:cognitive-science,
        ngm:emergence ;
    vc:slug "cybernetics" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:feedback-control,
        ngm:feedback-loop,
        ngm:signal-processing .

ngm:cybersecurity-framework a skos:Concept ;
    rdfs:label "Cybersecurity Framework"@en .

ngm:cybersecurity-policy a skos:Concept ;
    rdfs:label "Cybersecurity Policy"@en .

ngm:d-yd-x a owl:Class ;
    rdfs:label "dYdX"@en ;
    rdfs:comment "dYdX is a decentralised exchange focused on perpetual-futures trading, allowing users to take leveraged long and short positions on cryptocurrencies. Earlier versions operated on Ethereum using a layer-two scaling solution with an off-chain order book and on-chain settlement, while a later version migrated to a purpose-built application-specific blockchain in the Cosmos ecosystem. It combines the order-book trading experience of centralised venues with non-custodial settlement."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:smart-contract ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:validator-set ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:order-book ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:order-book ],
        ngm:decentralised-finance ;
    vc:bridgesTo ngm:cosmos,
        ngm:derivatives-trading,
        ngm:layer-two-scaling ;
    vc:contrastsWith ngm:automated-market-maker,
        ngm:centralised-exchange,
        ngm:gmx ;
    vc:dependsOn ngm:cosmos,
        ngm:tendermint-consensus,
        ngm:zero-knowledge-rollup ;
    vc:enables ngm:leveraged-trading,
        ngm:non-custodial-settlement,
        ngm:perpetual-futures,
        ngm:short-selling ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:funding-rate-mechanism,
        ngm:liquidation-engine,
        ngm:order-book ;
    vc:implements ngm:application-specific-blockchain,
        ngm:central-limit-order-book ;
    vc:isPartOf ngm:decentralised-finance,
        ngm:defi-derivatives-market ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:decentralised-exchange,
        ngm:ethereum ;
    vc:requires ngm:margin-collateral,
        ngm:order-book,
        ngm:smart-contract,
        ngm:validator-set ;
    vc:slug "d-yd-x" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:governance-token,
        ngm:off-chain-order-matching,
        ngm:on-chain-settlement .

