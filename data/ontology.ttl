    vc:slug "labelled-data" ;
    vc:sourceDomain "artificial-intelligence" .
ngm:labelled-dataset a owl:Class ;
    rdfs:comment "A labelled dataset is a collection of data examples each paired with one or more target annotations that specify the correct output for a learning task. The labels constitute the supervisory signal that allows a model to learn the mapping from inputs to outputs during training. Label quality, coverage and balance strongly determine the performance and fairness of the resulting model."@en ;
    rdfs:label "Labelled Dataset"@en ;
    rdfs:subClassOf ngm:training-data ;
    rdfs:subClassOf _:r13206 ;
