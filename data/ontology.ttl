ngm:ai-agents a owl:Class ;
    rdfs:label "AI Agents"@en ;
    rdfs:comment "AI Agents are software entities that combine a reasoning core (typically a large language model) with tool-use capabilities, memory, and a perception-action loop to autonomously pursue user-specified goals across multiple steps. They differ from single-shot inference systems by operating in iterative observe-think-act cycles, invoking external APIs, executing code, browsing the web, or delegating sub-tasks to specialised agents. The architecture integrates classical notions of rational agency with modern deep learning, spanning planning, grounding, and self-correction mechanisms. Safety, controllability, and alignment are first-class concerns because agents can initiate irreversible real-world side-effects."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:tool-use ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:reasoning ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:perception ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:planning-and-scheduling ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:large-language-models ],
        ngm:ai-application ;
    skos:broader ngm:ai-application ;
    vc:bridgesTo ngm:robotic-systems,
        ngm:smart-contracts ;
    vc:contrastsWith ngm:chatbots,
        ngm:robotic-process-automation ;
    vc:dependsOn ngm:cognitive-architecture,
        ngm:function-calling,
        ngm:vector-databases ;
    vc:enables ngm:autonomous-decision-making,
        ngm:multi-agent-systems,
        ngm:workflow-automation ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:action-execution,
        ngm:perception,
        ngm:planning-and-scheduling ;
    vc:implements ngm:plan-and-execute,
        ngm:react-framework ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:ai-safety,
        ngm:human-in-the-loop,
        ngm:prompt-injection,
        ngm:reinforcement-learning ;
    vc:requires ngm:large-language-models,
        ngm:memory,
        ngm:reasoning,
        ngm:tool-use ;
    vc:slug "ai-agents" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:prompt-engineering,
        ngm:retrieval-augmented-generation,
        ngm:sandboxing .

