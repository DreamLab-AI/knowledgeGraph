    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:3-d-rendering-engine,
        ngm:animation-controller,
        ngm:input-processing ;
    vc:slug "avatar-system" ;
    vc:sourceDomain "spatial-computing" .

