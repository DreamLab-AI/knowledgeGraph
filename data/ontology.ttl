    vc:sourceDomain "robotics" ;
    vc:standardizedBy ngm:iso-8373 ;
    vc:uses ngm:linear-algebra,
        ngm:quaternion-math .

ngm:training-dataset a owl:Class ;
    rdfs:label "Training Dataset"@en ;
    rdfs:comment "A Training Dataset is a curated collection of labelled or unlabelled data used to fit the parameters of a machine learning model, establishing the empirical foundation from which the model generalises to unseen inputs. Its composition—size, diversity, label quality, representational balance, and provenance—fundamentally determines the capabilities and failure modes of the resulting model. Training datasets range from manually annotated corpora (ImageNet, SQuAD) to web-scraped large-scale collections (Common Crawl, LAION-5B) and synthetically generated data. Questions of copyright, consent, bias, and traceability in training datasets have become central to AI governance and legal disputes."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:data-annotation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-governance ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-labelling ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-preprocessing ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:training-dataset-metadata ],
        ngm:training-data ;
    vc:bridgesTo ngm:algorithmic-bias,
        ngm:data-privacy,
        ngm:intellectual-property-rights-framework ;
    vc:contrastsWith ngm:test-dataset,
        ngm:validation-dataset ;
    vc:dependsOn ngm:data-collection,
        ngm:training-data-repository ;
    vc:enables ngm:evaluation-benchmarks-and-leaderboards,
        ngm:foundation-model,
        ngm:machine-learning-discipline-model,
        ngm:model-training,
        ngm:transfer-learning ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:data-annotation,
        ngm:training-dataset-metadata ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:data-centric-ai,
        ngm:federated-learning ;
    vc:requires ngm:data-governance,
        ngm:data-labelling,
        ngm:data-preprocessing ;
    vc:slug "training-dataset" ;
    vc:sourceDomain "machine-learning" ;
    vc:uses ngm:benchmark-standard,
        ngm:crowdsourcing,
        ngm:data-augmentation,
        ngm:synthetic-data .

ngm:variational-inference a owl:Class ;
    rdfs:label "Variational Inference"@en ;
    rdfs:comment "Variational inference (VI) is a family of algorithms in Bayesian machine learning that approximates intractable posterior distributions p(z|x) by positing a simpler, tractable family of distributions q(z; φ) and optimising its parameters to minimise the Kullback-Leibler divergence from the true posterior, equivalently maximising the Evidence Lower BOund (ELBO) on the log marginal likelihood. By recasting probabilistic inference as an optimisation problem rather than a sampling problem, VI achieves scalability to large datasets and high-dimensional latent spaces that Markov Chain Monte Carlo methods cannot easily reach. The reparameterisation trick enables gradient-based ELBO optimisation through stochastic estimates, making VI the foundational inference engine for Variational Autoencoders, hierarchical generative models, and probabilistic programming systems. VI trades posterior exactness for computational tractability, and is the preferred method wherever fast, amortised, or online Bayesian inference is required."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:graphical-model ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
