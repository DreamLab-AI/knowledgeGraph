        ngm:gain-tuning,
        ngm:low-pass-filtering,
        ngm:time-derivative ;
    vc:slug "derivative-control" ;
    vc:sourceDomain "robotics" .

ngm:design-systems a owl:Class ;
    rdfs:label "Design Systems"@en ;
    rdfs:comment "A design system is a single source of truth that combines reusable UI components, design tokens, patterns, and documentation governing how a product looks and behaves. It unifies designers and engineers around a shared component library and usage guidelines, ensuring consistency and accelerating delivery across teams and platforms. It encompasses both the visual language and the coded implementation that enforces it."@en ;
    rdfs:subClassOf ngm:software-development ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:human-computer-interaction,
        ngm:product-design ;
    vc:slug "design-systems" ;
    vc:sourceDomain "infrastructure" .

ngm:destination-chain-execution a owl:Class ;
    rdfs:label "Destination Chain Execution"@en ;
    rdfs:comment "Destination chain execution is the phase of a cross-chain operation in which a message or transaction validated from a source chain is finally executed on the target blockchain. After relayers and verification prove the source event, the destination chain mints, releases, or calls a contract to complete the bridged action. Correct execution requires replay protection, message ordering guarantees, and trust in the verification layer."@en ;
    rdfs:subClassOf ngm:cross-chain-bridge ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:blockchain-interoperability,
        ngm:cross-chain-bridge ;
    vc:slug "destination-chain-execution" ;
    vc:sourceDomain "blockchain" .

ngm:dev-sec-ops a owl:Class ;
    rdfs:label "DevSecOps"@en ;
    rdfs:comment "DevSecOps is a software engineering practice that integrates security controls, testing, and policy enforcement directly into the continuous integration and delivery pipeline, making security a shared responsibility across development, operations, and security teams. It applies the principle of shift-left security, automating vulnerability scanning, dependency auditing, and policy-as-code checks at every stage from code commit through production deployment."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ci-cd-automation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:vulnerability-scanner ],
        ngm:agile-software-development ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:continuous-integration,
        ngm:vulnerability-management ;
    vc:requires ngm:ci-cd-automation,
        ngm:vulnerability-scanner ;
    vc:slug "dev-sec-ops" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:penetration-testing,
        ngm:security-testing .

ngm:device-drivers a owl:Class ;
    rdfs:label "Device Drivers"@en ;
    rdfs:comment "A device driver is a software component that mediates between an operating system and a specific hardware device, translating generic OS calls into the device's command and register protocol. Drivers expose a uniform interface so applications can use peripherals without knowing their internal details, and they handle interrupts, buffering, and power state. They are the foundation of the hardware abstraction layer that makes hardware portable to software."@en ;
    rdfs:subClassOf ngm:infra-software-engineering ;
    skos:broader ngm:infra-software-engineering ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:hardware-abstraction-layer-hal,
        ngm:human-interface-device ;
    vc:slug "device-drivers" ;
    vc:sourceDomain "infrastructure" .

ngm:di-lo-co a owl:Class ;
    rdfs:label "DiLoCo"@en ;
    rdfs:comment "DiLoCo (Distributed Low-Communication training) is a method for training large language models across loosely connected, geographically distributed compute clusters with minimal inter-node communication. Workers perform many local optimisation steps before periodically synchronising via an outer optimiser, drastically reducing the bandwidth and latency demands of conventional data-parallel training. It enables collaborative model training over the public internet rather than within a single tightly coupled datacentre."@en ;
    rdfs:subClassOf ngm:distributed-computing ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:distributed-ai-training,
        ngm:prime-intellect ;
    vc:slug "di-lo-co" ;
    vc:sourceDomain "ai" .

ngm:dialogue-management a skos:Concept ;
    rdfs:label "Dialogue Management"@en .

ngm:dicom a skos:Concept ;
    rdfs:label "Dicom"@en .

ngm:did-nostr a owl:Class ;
    rdfs:label "did:nostr"@en ;
    rdfs:comment "did:nostr is a W3C DID Core-conformant decentralised identifier method that represents a Nostr public key as a universally resolvable DID of the form did:nostr:{pubkey}, where {pubkey} is the 64-character hex secp256k1 key already used by the Nostr protocol. Because the identifier is the key, no registration, server, or fee is required: anyone with a Nostr keypair already has a DID. Resolution degrades gracefully across three layers — HTTP fetch of a .well-known/did/nostr/{pubkey}.json document, relay-enhanced resolution from Nostr kind 0 (metadata) and kind 10002 (relay list) events, and an offline fallback that derives a minimal valid DID document from the key alone. Keys are expressed in W3C Multikey/Multibase form (secp256k1 multicodec), letting Nostr identities authenticate to any DID-aware system, including Solid login, SSO, and verifiable-credential flows."@en ;
    rdfs:subClassOf ngm:did-method ;
    vc:bridgesTo ngm:block-trails,
        ngm:javascript-solid-server,
        ngm:solid,
        ngm:web-id ;
    vc:contrastsWith ngm:did-web ;
    vc:dependsOn ngm:did-resolution ;
    vc:enables ngm:self-sovereign-identity,
        ngm:single-sign-on,
        ngm:solid-oidc,
        ngm:w3c-verifiable-credentials ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:implements ngm:decentralised-identifier,
        ngm:w3c-did-core ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:decentralised-identity,
        ngm:web-contracts,
        ngm:webauthn ;
    vc:slug "did-nostr" ;
    vc:sourceDomain "security" ;
    vc:uses ngm:multibase,
        ngm:nostr,
        ngm:schnorr-signature,
        ngm:secp256k1 .

ngm:differential-dynamic-programming a owl:Class ;
    rdfs:label "Differential Dynamic Programming"@en ;
    rdfs:comment "Differential Dynamic Programming (DDP) is a trajectory-optimisation algorithm that solves optimal-control problems by iteratively improving a control sequence using second-order local approximations of the dynamics and cost along the current trajectory. It performs a backward pass computing value-function derivatives and feedback gains, followed by a forward pass that applies the improved controls, converging quadratically near a solution. Together with its Gauss-Newton variant iLQR, DDP is widely used in robotics and model-predictive control for generating smooth, dynamically feasible motions."@en ;
    rdfs:subClassOf ngm:optimal-control ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:markov-decision-process ;
    vc:slug "differential-dynamic-programming" ;
    vc:sourceDomain "robotics" ;
    vc:supports ngm:model-predictive-control ;
    vc:uses ngm:control-theory .

ngm:digital-asset-regulation a skos:Concept ;
    rdfs:label "Digital Asset Regulation"@en .

ngm:digital-certificates a skos:Concept ;
    rdfs:label "Digital Certificates"@en .

ngm:digital-democracy a owl:Class ;
    rdfs:label "Digital Democracy"@en ;
    rdfs:comment "Digital democracy is the use of digital technologies to broaden and deepen citizen participation in political decision-making, including online deliberation, e-petitions, participatory budgeting, and novel voting mechanisms. It seeks to make governance more transparent, inclusive, and responsive by lowering the barriers to engagement. It encompasses both incremental e-government tools and experimental collective-choice systems such as quadratic voting."@en ;
    rdfs:subClassOf ngm:governance ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:civic-participation,
        ngm:quadratic-voting ;
    vc:slug "digital-democracy" ;
    vc:sourceDomain "governance" .

ngm:digital-divide a owl:Class ;
    rdfs:label "Digital Divide"@en ;
    rdfs:comment "The digital divide describes the structured inequality between individuals, communities, and nations in their ability to access, afford, use, and benefit from information and communication technologies, including broadband connectivity, computing devices, and the digital literacy skills required for effective participation. The divide operates across multiple axes — geographic (urban versus rural), socioeconomic (income and education), demographic (age, gender, disability), and geopolitical (Global North versus Global South) — and is self-reinforcing because limited digital access restricts access to the economic and educational resources needed to close the gap. Policy interventions target three layers: physical infrastructure deployment, affordability of devices and data, and cultivation of digital skills and trust through digital literacy programmes. As digital systems mediate healthcare, education, employment, public services, and civic participation, the digital divide functions as a meta-inequality that amplifies pre-existing social disparities."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:telecommunications ],
        ngm:digital-economy ;
    vc:bridgesTo ngm:ai-fairness,
        ngm:algorithmic-bias,
        ngm:edge-computing,
        ngm:spatial-computing ;
    vc:contrastsWith ngm:connected-society,
        ngm:digital-inclusion ;
    vc:enables ngm:digital-transformation,
        ngm:e-government,
        ngm:e-learning ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:digital-economy,
        ngm:social-inequality ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:accessibility,
        ngm:data-sovereignty,
        ngm:human-rights,
        ngm:internet-governance,
        ngm:privacy,
        ngm:universal-service-obligation ;
    vc:requires ngm:broadband-infrastructure,
        ngm:digital-literacy,
        ngm:telecommunications ;
    vc:slug "digital-divide" ;
    vc:sourceDomain "governance" ;
    vc:standardizedBy ngm:itu,
        ngm:un-sustainable-development-goals .

