ngm:offline-verification a owl:Class ;
    rdfs:comment "Offline verification is the ability to cryptographically validate a credential or claim without requiring a live connection to the issuer or a central server. The verifier checks digital signatures against the issuer's public key and any revocation data already held, confirming authenticity and integrity locally. It is a defining property of decentralised identity, enabling trust in low-connectivity or privacy-sensitive settings."@en ;
    rdfs:label "Offline Verification"@en ;
    rdfs:subClassOf ngm:digital-identity ;
