    vc:qualityScore "0.0"^^xsd:float ;
    vc:requires ngm:real-time-rendering ;
    vc:slug "virtual-city-model" ;
    vc:sourceDomain "spatial-computing" ;
    vc:standardizedBy ngm:interoperability-standard ;
    vc:uses ngm:lidar,
        ngm:photogrammetry .

ngm:virtual-environment-connectivity a owl:Class ;
    rdfs:label "Virtual Environment Connectivity"@en ;
    rdfs:comment "The networking technologies and protocols that enable seamless communication, data synchronisation, and user interaction across distributed virtual environments, including real-time streaming, peer-to-peer networks, and cross-platform interoperability systems. Achieving sub-20ms latency for VR experiences requires a combination of 5G/6G mobile networks, edge computing, WebRTC for browser-to-browser communication, and software-defined networking for traffic management."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:edge-computing ],
        [ a owl:Restriction ;
