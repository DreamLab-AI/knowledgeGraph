ngm:cryptographic-hash a owl:Class ;
    rdfs:label "Cryptographic Hash"@en ;
    rdfs:comment "Deterministic mathematical function transforming arbitrary input data into fixed-length output ensuring data integrity verification and tamper detection through collision resistance properties."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:hash-function ],
        ngm:bc-cryptographic-primitive ;
