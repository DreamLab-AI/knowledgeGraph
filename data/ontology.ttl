    rdfs:comment "Software platforms and tools enabling artists to create, manipulate, and distribute visual art using digital technologies, including generative AI systems, 3D modeling software, and NFT minting platforms that facilitate artistic expression and commerce in virtual environments."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:user-interface ],
        ngm:creative-software,
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:enables ngm:digital-art-creation,
        ngm:nft-minting,
        ngm:virtual-exhibitions ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires ngm:graphics-processing,
        ngm:storage-systems,
        ngm:user-interface ;
    vc:slug "digital-art-application" ;
    vc:sourceDomain "spatial-computing" .

ngm:digital-certificate a owl:Class ;
    rdfs:label "Digital Certificate"@en ;
    rdfs:comment "A cryptographic credential issued by a Certificate Authority that validates the identity of entities, authenticates users, and secures transactions within virtual environments, metaverse platforms, and blockchain networks through public key infrastructure and verifiable attestations."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptographic-keys ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:certificate-authority ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:public-key-infrastructure ],
        ngm:digital-security,
        ngm:sc-governance-and-safety ;
    skos:broader ngm:sc-governance-and-safety ;
    vc:enables ngm:identity-verification,
        ngm:secure-communication,
        ngm:trust-establishment ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires ngm:certificate-authority,
        ngm:cryptographic-keys,
        ngm:public-key-infrastructure ;
    vc:slug "digital-certificate" ;
    vc:sourceDomain "spatial-computing" .

