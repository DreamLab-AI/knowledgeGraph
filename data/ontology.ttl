ngm:gradient-descent a owl:Class ;
    rdfs:label "Gradient Descent"@en ;
    rdfs:comment "Gradient Descent is an iterative first-order optimisation algorithm that minimises a differentiable loss function by repeatedly updating model parameters in the direction of the negative gradient. It is the foundational optimisation strategy for training machine learning models, with variants including batch, stochastic, and mini-batch gradient descent, as well as adaptive-rate methods such as Adam and RMSProp."@en ;
