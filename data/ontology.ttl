ngm:knowledge-distillation a owl:Class ;
    rdfs:label "Knowledge Distillation"@en ;
    rdfs:comment "A model compression technique where a smaller \"student\" model is trained to mimic the behaviour of a larger \"teacher\" model, transferring knowledge through soft targets. The student learns from the teacher's output probability distributions (soft targets) rather than ground-truth hard labels, enabling competitive performance at a fraction of the computational cost."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:training-data ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:neural-network ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:large-language-models ],
        ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:bridgesTo ngm:federated-learning,
        ngm:iot-devices ;
    vc:contrastsWith ngm:model-pruning,
        ngm:parameter-efficient-fine-tuning,
        ngm:quantisation ;
    vc:enables ngm:edge-computing,
        ngm:efficient-inference,
        ngm:model-compression-for-edge,
        ngm:on-device-inference ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:soft-targets,
        ngm:student-model,
        ngm:teacher-model ;
    vc:implements ngm:offline-distillation,
        ngm:online-distillation,
        ngm:self-distillation ;
    vc:isPartOf ngm:model-compression,
        ngm:neural-network-optimisation ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:distilbert,
        ngm:reinforcement-learning-from-human-feedback,
        ngm:transfer-learning ;
    vc:requires ngm:large-language-models,
        ngm:neural-network,
        ngm:softmax-temperature,
        ngm:training-data ;
    vc:slug "knowledge-distillation" ;
    vc:sourceDomain "machine-learning" ;
    vc:uses ngm:cross-entropy-loss,
        ngm:kullback-leibler-divergence .

ngm:real-time-processing a owl:Class ;
    rdfs:label "Real-time Processing"@en ;
    rdfs:comment "Real-time Processing is a computational model where data is processed immediately upon arrival or generation, with minimal latency between input and output. Systems respond to events within strict time constraints (typically microseconds to seconds), enabling immediate decision-making through continuous stream-oriented processing rather than deferred batch operations."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:message-queue ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:stream-processing ],
        ngm:data-processing ;
    vc:bridgesTo ngm:real-time-rendering,
        ngm:robotics-control ;
    vc:contrastsWith ngm:batch-processing,
        ngm:lambda-architecture ;
    vc:dependsOn ngm:edge-computing,
        ngm:event-driven-architecture ;
    vc:enables ngm:anomaly-detection,
        ngm:intrusion-detection,
        ngm:predictive-maintenance,
        ngm:real-time-analytics ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:complex-event-processing,
        ngm:in-memory-computing,
        ngm:stream-processing ;
    vc:isPartOf ngm:data-processing ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:backpressure,
        ngm:fault-tolerance,
        ngm:time-series-database ;
    vc:requires ngm:low-latency-network,
        ngm:message-queue ;
    vc:slug "real-time-processing" ;
    vc:sourceDomain "data" ;
