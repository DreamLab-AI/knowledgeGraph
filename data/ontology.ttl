ngm:humaninthe-loop-learning a owl:Class ;
    rdfs:label "Humaninthe Loop Learning"@en ;
    rdfs:comment "A machine learning paradigm in which human annotators or domain experts are incorporated into the training loop to provide labels, corrections, or preference signals at points where automated methods are insufficient. Human-in-the-loop learning improves model quality on ambiguous or high-stakes tasks and is foundational to techniques such as active learning and RLHF."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:machine-learning-discipline ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
