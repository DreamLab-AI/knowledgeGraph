ngm:singularity a owl:Class ;
    rdfs:label "Singularity"@en ;
    rdfs:comment "The Technological Singularity is a hypothesised future point at which artificial intelligence surpasses human cognitive capacity in all economically and strategically relevant domains, triggering a phase transition in civilisational development so rapid and so structurally discontinuous that extr..."@en ;
