    vc:implements ngm:api-design ;
    vc:isPartOf ngm:api-design ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:http,
        ngm:rest,
        ngm:web-standards ;
    vc:requires ngm:client-server-architecture ;
    vc:slug "graphql" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:microservices ;
    vc:uses ngm:http,
        ngm:schema .

