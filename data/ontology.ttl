        ngm:scene-graph .

ngm:speaker-diarisation a owl:Class ;
    rdfs:label "Speaker Diarisation"@en ;
    rdfs:comment "Speaker diarisation is the automated process of partitioning a continuous multi-speaker audio stream into temporally contiguous, speaker-homogeneous segments and assigning a speaker label to each segment, answering the question 'who spoke when?' without necessarily mapping labels to real-world identities. A canonical pipeline comprises voice activity detection, acoustic feature extraction, speaker embedding (via models such as x-vectors or ECAPA-TDNN), agglomerative or spectral clustering to group embeddings into speaker clusters, optional overlap detection, and a resegmentation or ViterBI refinement step. End-to-end neural approaches such as EEND (End-to-End Neural Diarisation) unify segmentation and assignment into a single sequence-labelling model capable of handling overlapping speech. Speaker diarisation is a foundational component in meeting transcription systems, clinical consultation recording, broadcast media indexing, and any dialogue-analytic pipeline that requires utterance attribution."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:audio-processing-system ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:transformer-architecture ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:deep-learning ],
        ngm:speech-processing ;
    vc:bridgesTo ngm:multimodal-learning,
        ngm:real-time-collaboration ;
    vc:contrastsWith ngm:speaker-recognition,
        ngm:speaker-verification ;
    vc:dependsOn ngm:automatic-speech-recognition,
        ngm:signal-processing ;
    vc:enables ngm:clinical-note-generation,
        ngm:dialogue-act-recognition,
        ngm:meeting-transcription,
        ngm:real-time-transcription,
        ngm:speaker-identification ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:acoustic-feature-extraction,
        ngm:overlap-detection,
        ngm:speaker-embedding,
        ngm:spectral-clustering,
        ngm:voice-activity-detection ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:emotion-recognition,
        ngm:forced-alignment,
        ngm:natural-language-processing,
        ngm:noise-reduction ;
    vc:requires ngm:audio-processing-system,
        ngm:deep-learning,
        ngm:transformer-architecture ;
    vc:slug "speaker-diarisation" ;
    vc:sourceDomain "ai" .

