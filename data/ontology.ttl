        ngm:decentralised-storage ;
    vc:implements ngm:ethereum ;
    vc:isPartOf ngm:decentralised-web ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:layer-2-scaling,
        ngm:zero-knowledge-proof ;
    vc:requires ngm:cryptographic-key-management,
        ngm:distributed-ledger-technology,
