        ngm:augmented-reality,
        ngm:digital-twin,
        ngm:geospatial-data,
        ngm:volumetric-capture .

ngm:virtual-workspace a owl:Class ;
    rdfs:label "Virtual Workspace"@en ;
    rdfs:comment "A Virtual Workspace is a spatially organised digital environment — typically experienced through XR headsets or desktop 3D interfaces — that replicates or enhances the collaborative and cognitive functions of a physical office. It supports remote collaboration, persistent shared artefacts, spatial audio, and embodied presence, addressing the limitations of flat video-conferencing for complex knowledge work."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:avatar ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:spatial-audio ],
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:enables ngm:knowledge-management,
        ngm:remote-collaboration,
        ngm:telepresence ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:relatedTo ngm:social-vr,
        ngm:virtual-world ;
    vc:requires ngm:avatar,
        ngm:spatial-audio ;
    vc:slug "virtual-workspace" ;
    vc:sourceDomain "spatial-computing" .

ngm:visual-place-recognition a owl:Class ;
    rdfs:label "Visual Place Recognition"@en ;
    rdfs:comment "Visual place recognition (VPR) is the task of identifying whether a currently observed scene corresponds to a previously visited location by matching image content against a database of geotagged or topologically indexed images. It underpins loop closure in SLAM and global re-localisation for autonomous systems, relying on appearance- and condition-invariant descriptors. Robustness to viewpoint, illumination, and seasonal change is the central research challenge."@en ;
    rdfs:subClassOf ngm:robo-perception ;
    skos:broader ngm:robo-perception ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:topological-map,
        ngm:visual-slam ;
    vc:slug "visual-place-recognition" ;
    vc:sourceDomain "robotics" .

ngm:visual-slam a owl:Class ;
    rdfs:label "Visual SLAM"@en ;
    rdfs:comment "Visual simultaneous localisation and mapping (Visual SLAM) is the process of concurrently estimating a camera's trajectory and reconstructing a map of an unknown environment using image data alone or fused with inertial measurements. It combines feature tracking or direct photometric alignment with pose-graph or bundle-adjustment optimisation and loop closure. Visual SLAM is foundational to AR headsets, drones, and mobile robots that lack external positioning."@en ;
    rdfs:subClassOf ngm:robo-navigation-and-planning ;
    skos:broader ngm:robo-navigation-and-planning ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:depth-estimation,
        ngm:visual-place-recognition ;
    vc:slug "visual-slam" ;
    vc:sourceDomain "robotics" .

ngm:volumetric-rendering a owl:Class ;
    rdfs:label "Volumetric Rendering"@en ;
    rdfs:comment "Volumetric rendering is the process of producing images of three-dimensional density fields where light is absorbed, emitted, and scattered as it travels through a participating medium. Rather than rendering surfaces, it integrates radiance along rays passing through a volume, capturing effects such as smoke, clouds, fog, and translucent materials. The technique underlies medical visualisation, visual effects, and neural scene representations that store the world as a continuous volumetric function."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:voxel ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:ray-marching ],
        ngm:rendering ;
    vc:enables ngm:medical-imaging,
        ngm:neural-radiance-fields ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:ray-marching,
        ngm:voxel ;
    vc:implements ngm:global-illumination,
        ngm:ray-tracing ;
    vc:isPartOf ngm:computer-graphics ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:gaussian-splatting,
        ngm:neural-radiance-fields,
        ngm:ray-tracing ;
    vc:slug "volumetric-rendering" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:cloud-rendering,
        ngm:real-time-rendering ;
    vc:uses ngm:gpu,
        ngm:point-cloud .

ngm:voting-round a owl:Class ;
    rdfs:label "Voting Round"@en ;
    rdfs:comment "A voting round is a discrete phase within a Byzantine fault-tolerant consensus protocol during which participating nodes exchange and tally votes on a proposed value or block. Multi-round protocols such as PBFT and Tendermint progress through prepare, pre-commit, and commit rounds to achieve agreement despite faulty or malicious participants. The round abstraction provides liveness via view changes and safety via supermajority thresholds."@en ;
    rdfs:subClassOf ngm:consensus-protocol ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:byzantine-fault-tolerance,
        ngm:consensus-mechanism ;
    vc:slug "voting-round" ;
    vc:sourceDomain "blockchain" .

ngm:voxel-grid a owl:Class ;
    rdfs:label "Voxel Grid"@en ;
    rdfs:comment "A voxel grid is a regular three-dimensional lattice that partitions space into uniformly sized cubic cells, each cell (voxel) storing occupancy, colour, density, or other attributes of the volume it covers. It provides a structured spatial representation used to discretise point clouds, build occupancy maps, and accelerate spatial queries in robotics and computer graphics. By contrast with continuous point sets, the fixed cell structure trades fine resolution for predictable indexing and constant-time neighbourhood access."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:perception ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:sensor ],
        ngm:spatial-computing ;
    skos:broader ngm:spatial-computing ;
    vc:bridgesTo ngm:robotics ;
    vc:contrastsWith ngm:mapping ;
    vc:dependsOn ngm:perception ;
    vc:enables ngm:mapping ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:perception ;
    vc:implements ngm:mapping ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:lidar,
        ngm:perception,
        ngm:sensor,
        ngm:slam,
        ngm:spatial-computing ;
    vc:requires ngm:sensor ;
    vc:slug "voxel-grid" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:slam ;
    vc:uses ngm:lidar .

ngm:vr-rendering-engine a owl:Class ;
    rdfs:label "VR Rendering Engine"@en ;
    rdfs:comment "Specialised real-time graphics software that generates stereoscopic imagery for virtual reality headsets, optimising frame rates (minimum 90 fps), motion-to-photon latency (sub-20 ms), and visual fidelity while managing VR-specific pipeline requirements including foveated rendering, asynchronous reprojection, and lens distortion correction. Leading implementations include Unreal Engine 5 (Lumen, Nanite) and Unity (URP/HDRP), both supporting major XR hardware via OpenXR and platform-specific SDKs."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:real-time-rendering ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:xr-device ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:real-time-rendering-pipeline ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:foveated-rendering ],
        ngm:game-engine,
        ngm:sc-display-and-rendering ;
    skos:broader ngm:sc-display-and-rendering ;
    vc:enables ngm:immersive-experience,
        ngm:virtual-production ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:foveated-rendering,
        ngm:real-time-rendering-pipeline ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:requires ngm:real-time-rendering,
        ngm:xr-device ;
    vc:slug "vr-rendering-engine" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:spatial-computing .

ngm:waste-management a owl:Class ;
    rdfs:label "Waste Management"@en ;
    rdfs:comment "The collection, transport, processing, and disposal of waste materials, increasingly augmented by blockchain-based distributed ledgers and smart contracts that create immutable records of waste generation, segregation, and recovery throughout the circular economy lifecycle. Blockchain-enabled systems enable verifiable recycling rates, incentivise responsible disposal, and prevent illegal dumping."@en ;
    rdfs:subClassOf ngm:bc-network-component ;
    skos:broader ngm:bc-network-component ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.4"^^xsd:float ;
    vc:relatedTo ngm:blockchain-sustainability,
        ngm:environmental-accounting ;
    vc:slug "waste-management" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:circular-economy,
        ngm:environmental-sustainability ;
    vc:uses ngm:blockchain,
        ngm:smart-contract .

ngm:waveguide-optics a owl:Class ;
    rdfs:label "Waveguide Optics"@en ;
    rdfs:comment "Waveguide optics is the optical-engineering approach used in augmented- and mixed-reality displays to channel projected light from a microdisplay into the user's eye via total internal reflection in a thin transparent substrate. Diffractive, reflective, or holographic gratings couple light in and out, enabling compact, see-through eyewear with a wide eyebox. It is the dominant optical architecture for consumer AR glasses, trading manufacturing complexity for form factor and transparency."@en ;
    rdfs:subClassOf ngm:sc-display-and-rendering ;
    skos:broader ngm:sc-display-and-rendering ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:ar-frame,
        ngm:mixed-reality ;
    vc:slug "waveguide-optics" ;
    vc:sourceDomain "metaverse" .

ngm:wearable-computing a owl:Class ;
    rdfs:label "Wearable Computing"@en ;
    rdfs:comment "Wearable computing is the design and use of computing devices worn on or close to the body, integrating sensing, processing and display into garments, accessories and head-mounted units. These devices provide continuous, context-aware interaction and data capture without occupying the hands, enabling hands-free assistance, health monitoring and immersive experiences. It is a foundational layer of spatial and ambient computing."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:sensor ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:internet-of-things ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:head-mounted-display ],
        ngm:spatial-computing ;
    skos:broader ngm:spatial-computing ;
    vc:enables ngm:augmented-reality,
        ngm:human-computer-interaction ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:head-mounted-display,
        ngm:sensor ;
    vc:isPartOf ngm:ambient-computing,
        ngm:spatial-computing ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:ambient-computing,
        ngm:augmented-reality,
        ngm:human-computer-interaction ;
    vc:requires ngm:internet-of-things ;
    vc:slug "wearable-computing" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:extended-reality ;
    vc:uses ngm:internet-of-things,
        ngm:sensor .

ngm:web-application a owl:Class ;
    rdfs:label "Web Application"@en ;
    rdfs:comment "A web application is interactive software delivered over the web and executed primarily within a browser, combining client-side code with server-side services accessed over HTTP. It renders user interfaces, manages state, and communicates with back-end APIs to provide functionality comparable to native applications without installation. Web applications rely on open web standards for portability across devices and platforms."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:compute-infrastructure ],
        ngm:infrastructure ;
    skos:broader ngm:infrastructure ;
    vc:bridgesTo ngm:devops ;
    vc:dependsOn ngm:http,
