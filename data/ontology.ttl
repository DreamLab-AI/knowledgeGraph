ngm:biometric-verification a owl:Class ;
    rdfs:label "Biometric Verification"@en ;
    rdfs:comment "Biometric verification is the one-to-one matching process in which a live biometric sample presented by a claimant is compared against a single pre-enrolled template associated with the claimed identity, producing an accept or reject decision based on a similarity threshold. It is distinct from biometric identification, which performs a one-to-many search across an entire database, making verification faster and more privacy-preserving for authentication use cases."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:presentation-attack-detection ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-protection ],
        ngm:identity-verification ;
    vc:bridgesTo ngm:artificial-intelligence,
        ngm:distributed-collaboration ;
    vc:contrastsWith ngm:biometric-identification,
        ngm:password-authentication ;
    vc:enables ngm:access-control,
        ngm:biometric-authentication,
        ngm:identity-proofing,
        ngm:know-your-customer ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:aml-kyc-compliance,
        ngm:digital-identity-verification,
        ngm:face-recognition,
        ngm:privacy-preserving-authentication ;
    vc:requires ngm:data-protection,
        ngm:presentation-attack-detection ;
    vc:slug "biometric-verification" ;
    vc:sourceDomain "security" ;
