ngm:content-pipeline a owl:Class ;
    rdfs:comment "A Content Pipeline is the end-to-end automated or semi-automated workflow that transforms raw creative assets—geometry, textures, audio, video, or data—from authoring tools into the optimised, platform-specific formats required by a runtime engine, distribution system, or media player. It encompasses ingestion, validation, processing, compression, and delivery stages with dependency tracking and incremental rebuild capabilities."@en ;
    rdfs:label "Content Pipeline"@en ;
    rdfs:subClassOf ngm:production-pipeline ;
