ngm:fasb-asu-2023-08 a owl:Class ;
    rdfs:label "FASB ASU 2023-08"@en ;
    rdfs:comment "FASB Accounting Standards Update 2023-08 is a US accounting standard issued by the Financial Accounting Standards Board that requires public companies to measure certain cryptocurrency assets at fair value and recognise gains and losses in net income each reporting period. The standard applies to fungible crypto assets listed on active markets, effective for fiscal years beginning after 15 December 2024. It represents a significant departure from the previous indefinite-lived intangible asset treatment that suppressed recognised gains."@en ;
    rdfs:subClassOf ngm:compliance-standards ;
    vc:contrastsWith ngm:mi-ca-regulation ;
    vc:enables ngm:compliance-monitoring,
        ngm:regulatory-reporting ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:cryptocurrency,
        ngm:digital-asset,
        ngm:digital-asset-standards,
        ngm:financial-regulation ;
    vc:slug "fasb-asu-2023-08" ;
    vc:sourceDomain "governance" ;
    vc:supports ngm:digital-asset-market,
        ngm:financial-services,
        ngm:financial-stability .

ngm:federated-edge-learning a owl:Class ;
    rdfs:label "Federated Edge Learning"@en ;
    rdfs:comment "Federated Edge Learning combines distributed machine learning with edge computing, enabling collaborative model training across decentralised edge devices while keeping training data locally on-device. Participants train local models on their private datasets and securely aggregate only model updates—rather than raw data—into a shared global model, preserving data sovereignty whilst enabling collective intelligence."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:federated-learning ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:model-training ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:edge-computing ],
        ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:enables ngm:differential-privacy,
        ngm:privacy-preserving-analytics ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:autonomous-robot,
        ngm:distributed-computing,
        ngm:machine-learning,
        ngm:privacy-utility-tradeoffs ;
    vc:requires ngm:edge-computing,
        ngm:federated-learning,
        ngm:model-training ;
    vc:slug "federated-edge-learning" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:edge-computing-node,
        ngm:gradient-descent,
        ngm:neural-network .

ngm:feed-forward-network a owl:Class ;
    rdfs:label "Feed Forward Network"@en ;
    rdfs:comment "A feed-forward network (FFN) is a class of artificial neural network in which information propagates strictly in one direction — from input nodes through one or more hidden layers to output nodes — with no feedback cycles, recurrent connections, or lateral synapses between units at the same layer."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:hidden-layer ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:activation-function ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:automatic-differentiation ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:loss-function ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:backpropagation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:training-data ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gradient-descent ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:hyperparameter-tuning ],
        ngm:ai-model-architecture,
        ngm:neural-network ;
    skos:broader ngm:ai-model-architecture ;
    vc:enables ngm:feature-learning,
        ngm:fine-tuning,
        ngm:pattern-recognition,
        ngm:transfer-learning,
        ngm:universal-approximation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:activation-function,
        ngm:backpropagation,
        ngm:bias-vector,
        ngm:hidden-layer,
        ngm:input-layer,
        ngm:loss-function,
        ngm:output-layer,
        ngm:weight-matrix ;
    vc:implements ngm:mixture-of-experts,
        ngm:multi-layer-perceptron,
        ngm:position-wise-ffn,
        ngm:residual-connection,
        ngm:swi-glu ;
    vc:qualityScore "0.52"^^xsd:float ;
    vc:relatedTo ngm:autoencoder,
        ngm:diffusion-model,
        ngm:large-language-models,
        ngm:transformer,
        ngm:variational-autoencoders ;
    vc:requires ngm:automatic-differentiation,
        ngm:gradient-descent,
        ngm:hyperparameter-tuning,
        ngm:training-data,
        ngm:weight-initialisation ;
    vc:slug "feed-forward-network" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:standardizedBy ngm:iclr,
        ngm:icml,
        ngm:ieee,
        ngm:neur-ips ;
    vc:supports ngm:computer-vision,
        ngm:generative-ai,
        ngm:natural-language-processing,
        ngm:reinforcement-learning,
        ngm:speech-recognition ;
    vc:uses ngm:attention-mechanism,
        ngm:dropout,
        ngm:gelu,
        ngm:layer-normalisation,
        ngm:re-lu .

ngm:few-shot-prompting a owl:Class ;
    rdfs:label "Few-Shot Prompting"@en ;
    rdfs:comment "Few-shot prompting is a prompt engineering technique in which a small number of input-output demonstration examples are included directly in the context provided to a large language model, guiding the model to produce outputs conforming to the demonstrated pattern without any parameter updates. The approach exploits the in-context learning capability of transformer-based models, allowing task specification through examples rather than task-specific fine-tuning."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:context-window ],
        ngm:prompt-engineering ;
    vc:contrastsWith ngm:few-shot-learning ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:chain-of-thought-prompting,
        ngm:zero-shot-prompting ;
    vc:requires ngm:context-window ;
    vc:slug "few-shot-prompting" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:few-shot-examples,
        ngm:in-context-learning .

ngm:filecoin a owl:Class ;
    rdfs:label "Filecoin"@en ;
    rdfs:comment "Filecoin is a decentralised storage network and blockchain protocol developed by Protocol Labs that creates a peer-to-peer marketplace for file storage and retrieval, using cryptographic proofs—Proof of Replication (PoRep) and Proof of Spacetime (PoSt)—to verifiably demonstrate that storage providers are dedicating physical disk space to client data over time. Storage providers earn FIL tokens by fulfilling storage deals and continuously proving their commitments on-chain, while clients pay FIL to store data with economic guarantees backed by the provider's staked collateral. Filecoin is built on top of IPFS (InterPlanetary File System) for content-addressed data retrieval and represents the economic incentive layer designed to make decentralised storage commercially viable."@en ;
    rdfs:subClassOf ngm:decentralized-storage ;
    vc:enables ngm:decentralized-application ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:distributed-storage,
        ngm:peer-to-peer-network,
        ngm:token-economics ;
    vc:slug "filecoin" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:content-addressed-storage,
        ngm:ipfs,
        ngm:libp2p .

ngm:finality-gadget a owl:Class ;
    rdfs:label "Finality Gadget"@en ;
    rdfs:comment "A Finality Gadget is a protocol component layered onto a block-producing (typically probabilistically-final) blockchain to provide periodic deterministic finality for checkpointed epochs, operating as a BFT overlay that requires a supermajority of validator stake to attest to a canonical chain prefix before that prefix is considered irreversible. The archetypal finality gadget is Casper the Friendly Finality Gadget (Casper FFG), which Ethereum uses in its Gasper consensus construction alongside LMD-GHOST fork-choice to combine liveness (blocks always added) with periodic safety (epochs finalised every ~12.8 minutes). Finality gadgets decouple the latency-optimised block-production layer from the safety-optimised finality layer, allowing chains to maintain high throughput while providing applications with a provable point after which reorganisation is cryptoeconomically infeasible."@en ;
    rdfs:subClassOf ngm:consensus-mechanism ;
    vc:enables ngm:blockchain-security,
        ngm:transaction-finality ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:checkpoints,
        ngm:deterministic-finality,
        ngm:epoch,
        ngm:finality,
        ngm:gasper-consensus ;
    vc:slug "finality-gadget" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:probabilistic-finality,
        ngm:validator-node,
        ngm:validator-set .

ngm:fleet-management a owl:Class ;
    rdfs:label "Fleet Management"@en ;
    rdfs:comment "Fleet management is the coordinated administration, monitoring, and optimisation of a collection of mobile assets — vehicles, drones, robots, or edge devices — across their operational lifecycle, encompassing real-time telemetry collection, route and task planning, maintenance scheduling, regulatory compliance, driver or operator management, and fuel or energy consumption optimisation. Modern fleet management systems integrate GPS tracking, telematics sensors, AI-driven analytics, and communications networks to provide operators with situational awareness and control over large numbers of assets dispersed across wide geographic areas."@en ;
    rdfs:subClassOf ngm:asset-management ;
    vc:enables ngm:autonomous-navigation,
        ngm:delivery-planning ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:autonomous-vehicle,
        ngm:digital-twin,
        ngm:logistics-optimization ;
    vc:slug "fleet-management" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:edge-computing,
        ngm:io-t-sensor-network,
        ngm:real-time-monitoring .

ngm:flow-matching a owl:Class ;
    rdfs:label "Flow Matching"@en ;
    rdfs:comment "Flow Matching is a generative modelling framework that trains a neural network to parameterise the vector field of a continuous normalising flow by directly regressing on analytically tractable target vector fields defined along flow paths between a source distribution (typically Gaussian noise) and a data distribution. Unlike score-based diffusion models, which require simulating a stochastic differential equation during training, flow matching uses deterministic conditional flow paths that can be computed in closed form, yielding stable and efficient training. At inference, the learned vector field is integrated with an ODE solver to transport samples from noise to data."@en ;
    rdfs:subClassOf ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:contrastsWith ngm:generative-adversarial-network ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:diffusion-model,
        ngm:generative-model ;
    vc:slug "flow-matching" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:deep-learning,
        ngm:neural-network .

ngm:fluid-simulation a owl:Class ;
    rdfs:label "Fluid Simulation"@en ;
    rdfs:comment "Fluid Simulation is the computational modelling of liquid and gas dynamics using numerical methods — notably computational fluid dynamics (CFD) and Navier-Stokes solvers — to produce physically plausible representations of water, smoke, fire, and atmospheric phenomena in real-time or offline rendering pipelines. In spatial computing and metaverse environments it contributes to environmental immersion and interactive physics, running on GPU compute shaders for performance-critical applications."@en ;
    rdfs:subClassOf ngm:sc-display-and-rendering ;
    skos:broader ngm:sc-display-and-rendering ;
    vc:enables ngm:embodied-ai-simulation ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:physics-simulation ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:3-d-rendering-engine,
        ngm:computer-graphics,
        ngm:game-engine,
        ngm:particle-system,
        ngm:physics-engine ;
    vc:slug "fluid-simulation" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:compute-shader,
        ngm:gpu-compute,
        ngm:math-library .

ngm:food-safety a owl:Class ;
    rdfs:label "Food Safety"@en ;
    rdfs:comment "Food Safety is the discipline concerned with preventing foodborne illness and injury through systematic controls applied across the entire food production and distribution chain, from farm to consumer. It encompasses hazard analysis, regulatory compliance, traceability, temperature monitoring, and the technical and institutional practices that ensure food products are safe for consumption."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:rfid ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:blockchain-provenance ],
        ngm:compliance ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.85"^^xsd:float ;
    vc:relatedTo ngm:compliance-monitoring,
        ngm:food-safety-blockchain ;
    vc:requires ngm:blockchain-provenance,
        ngm:rfid ;
    vc:slug "food-safety" ;
    vc:sourceDomain "governance" .

ngm:force-feedback a owl:Class ;
    rdfs:label "Force Feedback"@en ;
    rdfs:comment "Force feedback is a class of haptic technology that renders mechanical forces — including resistance, weight, texture, and impact — directly to a user's body through a controlled actuator system, enabling the sense of touch and proprioception to convey information about virtual or remote physical environments. Distinguished from simpler vibrotactile feedback by its ability to generate directional, grounded forces (requiring a mechanical linkage to the user), force feedback systems are used in surgical simulators, teleoperation of remote robots, vehicle simulation, and advanced XR interfaces. The fidelity of the rendered force field is constrained by the bandwidth, peak force, backdrivability, and transparency of the underlying actuator mechanism."@en ;
    rdfs:subClassOf ngm:haptics ;
    vc:enables ngm:haptic-feedback-telepresence,
        ngm:physics-simulation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:haptic-feedback,
        ngm:haptic-feedback-system,
        ngm:tactile-sensing ;
    vc:slug "force-feedback" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:actuator,
        ngm:motion-control,
        ngm:series-elastic-actuator .

ngm:gas-limit a owl:Class ;
    rdfs:label "Gas Limit"@en ;
    rdfs:comment "A Gas Limit is the maximum amount of gas — the unit measuring computational effort — that a sender authorises for a blockchain transaction or that a block may contain in aggregate. It serves as a hard cap preventing unbounded resource consumption, protecting network nodes from denial-of-service attacks and ensuring predictable block processing times. On Ethereum, each transaction carries a user-set gas limit and each block carries a protocol-enforced block gas limit that validators adjust over time."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:consensus-mechanism ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:blockchain-transaction ],
        ngm:bc-protocol-and-consensus,
        ngm:blockchain-entity,
        ngm:economic-mechanism ;
    skos:broader ngm:bc-protocol-and-consensus ;
    vc:contrastsWith ngm:proof-of-stake,
        ngm:proof-of-work ;
    vc:dependsOn ngm:base-fee,
        ngm:fee-market ;
    vc:enables ngm:blockchain-scalability,
        ngm:smart-contract-execution ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:block-size,
        ngm:blockchain-economics,
        ngm:gas-price,
        ngm:mempool,
        ngm:mev,
        ngm:transaction-fee,
        ngm:validator-node ;
    vc:requires ngm:blockchain-transaction,
        ngm:consensus-mechanism ;
    vc:slug "gas-limit" ;
    vc:sourceDomain "blockchain" .

ngm:generative-content a owl:Class ;
    rdfs:label "Generative Content"@en ;
    rdfs:comment "Generative Content is digital media — text, imagery, audio, 3D assets, or code — produced by generative AI models rather than human authors. It encompasses outputs of large language models, diffusion models, GANs, and neural synthesis systems, and raises distinct questions of provenance, copyright, and quality assurance in metaverse and spatial computing pipelines."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:generative-ai ],
        ngm:ai-application ;
    skos:broader ngm:ai-application ;
    vc:enables ngm:metaverse-content-pipeline ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:3-d-asset,
        ngm:educational-methodology ;
    vc:requires ngm:generative-ai ;
    vc:slug "generative-content" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:large-language-models .

ngm:generative-design a owl:Class ;
    rdfs:label "Generative Design"@en ;
    rdfs:comment "Generative Design is a computational design methodology in which algorithms autonomously explore a defined design space—bounded by performance constraints, manufacturing requirements, and material properties—to generate and evaluate large numbers of design candidates, surfacing options that meet objectives a human designer specifies but did not hand-craft. Implemented through topology optimisation, evolutionary algorithms, and increasingly through deep generative models, it produces geometrically complex structures—often resembling organic forms—that achieve material efficiency or performance targets unattainable through conventional manual design. The output is typically a ranked set of design alternatives that engineers evaluate and refine."@en ;
    rdfs:subClassOf ngm:parametric-modeling ;
    vc:enables ngm:digital-twin,
        ngm:smart-manufacturing ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:generative-design-tool,
        ngm:optimization-algorithm,
        ngm:parametric ;
    vc:slug "generative-design" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:deep-generative-model,
        ngm:physics-simulation,
        ngm:simulation .

ngm:generative-modelling-domain a owl:Class ;
    rdfs:label "Generative Modelling Domain"@en ;
    rdfs:comment "The Generative Modelling Domain covers statistical models that learn a data distribution and can sample new instances from it. Its scope includes latent variable models, autoregressive models, diffusion processes and adversarial training. It is a methodological sub-area of the Artificial Intelligence Domain situated within the Machine Learning Domain. The boundary is the modelling of distributions, distinguishing it from the applied Generative AI Domain that deploys such models in products."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:generative-adversarial-network ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:autoregressive-model ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:diffusion-model ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:normalising-flow ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:variational-autoencoder ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:information-theory ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:machine-learning-domain ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:probability-theory ],
        ngm:artificial-intelligence-domain ;
    vc:enables ngm:data-synthesis,
        ngm:density-estimation,
        ngm:generative-ai-domain ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:autoregressive-model,
        ngm:diffusion-model,
        ngm:generative-adversarial-network,
        ngm:normalising-flow,
        ngm:variational-autoencoder ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:information-theory,
        ngm:machine-learning-domain,
        ngm:probability-theory ;
    vc:slug "generative-modelling-domain" ;
    vc:sourceDomain "generative-modelling" .

ngm:generator-network a owl:Class ;
    rdfs:label "Generator Network"@en ;
    rdfs:comment "A generator network is the synthesis component of a generative deep learning architecture — most prominently within Generative Adversarial Networks (GANs) — that learns to map samples from a low-dimensional latent space into high-dimensional data outputs (images, audio, video, 3D shapes) whose statistical distribution matches that of a training dataset. The generator is trained in adversarial competition with a discriminator network, receiving gradient signal not from direct comparison with target samples but from the discriminator's attempt to distinguish generated from real samples, forcing the generator to produce increasingly realistic outputs. Generator networks are the conceptual precursors to the decoder components of VAEs and the denoising networks of diffusion models."@en ;
    rdfs:subClassOf ngm:generative-model ;
    vc:enables ngm:image-generation,
        ngm:style-transfer,
        ngm:synthetic-data-generator ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:deep-generative-model,
        ngm:variational-autoencoders ;
    vc:slug "generator-network" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:generative-adversarial-network,
        ngm:latent-space,
        ngm:neural-network-architecture .

ngm:ghg-protocol-corporate-standard a owl:Class ;
    rdfs:label "GHG Protocol Corporate Standard"@en ;
    rdfs:comment "The GHG Protocol Corporate Accounting and Reporting Standard is the most widely used international framework for measuring and reporting an organisation's greenhouse-gas emissions. Developed by the World Resources Institute and the World Business Council for Sustainable Development, it organises emissions into Scope 1 (direct), Scope 2 (purchased energy), and Scope 3 (value-chain) categories, establishing consistent boundaries, accounting principles, and disclosure rules. It underpins corporate climate reporting, science-based targets, and most national and regional emissions-disclosure regulations."@en ;
    rdfs:subClassOf ngm:technical-standard ;
    vc:enables ngm:regulatory-compliance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:carbon-offset ;
    vc:slug "ghg-protocol-corporate-standard" ;
    vc:sourceDomain "sustainability" ;
    vc:supports ngm:carbon-accounting .

ngm:gitcoin a owl:Class ;
    rdfs:label "Gitcoin"@en ;
    rdfs:comment "Gitcoin is a blockchain-based platform founded in 2017 that funds open-source software development and public goods through decentralised grant programmes, bounties, and quadratic funding rounds. It popularised the application of quadratic funding mechanisms to allocate matching pools democratically, amplifying contributions from a broad base of small donors relative to large single donors. Gitcoin has distributed tens of millions of dollars to Ethereum ecosystem developers and has expanded into identity and Sybil resistance through the Gitcoin Passport credential system."@en ;
    rdfs:subClassOf ngm:public-goods-funding ;
    vc:enables ngm:grant-programs,
        ngm:retroactive-public-goods-funding ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:dao,
        ngm:open-source-software,
        ngm:quadratic-funding ;
    vc:slug "gitcoin" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:decentralised-autonomous-organisation ;
    vc:uses ngm:gitcoin-passport,
        ngm:sybil-resistance .

ngm:gl-tf-3-d-file-format a owl:Class ;
    rdfs:label "glTF (3D File Format)"@en ;
    rdfs:comment "A royalty-free, open-standard 3D asset transmission format developed by Khronos Group that efficiently specifies scene structure, geometry, materials, animations, and other properties for real-time rendering."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:material-definition ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:binary-encoding ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:json-schema ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:graphics-api ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:binary-buffer ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:mesh-data ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:scene-graph ],
        ngm:sc-standards-and-interop ;
    skos:broader ngm:sc-standards-and-interop ;
    vc:enables ngm:3-d-asset-exchange,
        ngm:content-interoperability,
        ngm:cross-platform-compatibility,
        ngm:runtime-rendering ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:animation-channels,
        ngm:binary-buffer,
        ngm:material-definition,
        ngm:mesh-data,
        ngm:scene-graph,
        ngm:texture-references ;
    vc:isPartOf ngm:3-d-content-pipeline,
        ngm:asset-interchange-system ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:binary-encoding,
        ngm:graphics-api,
        ngm:json-schema ;
    vc:slug "gl-tf-3-d-file-format" ;
    vc:sourceDomain "spatial-computing" .

ngm:graphics-processing a owl:Class ;
    rdfs:label "Graphics Processing"@en ;
    rdfs:comment "Graphics processing is the computation that transforms scene descriptions into rendered images, covering geometry transformation, shading, rasterisation and output to a display."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:rendering-pipeline ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gpu ],
        ngm:spatial-computing-domain ;
    vc:enables ngm:3-d-rendering,
        ngm:real-time-rendering ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:gpu,
        ngm:rendering-pipeline ;
    vc:slug "graphics-processing" ;
    vc:sourceDomain "general" .

ngm:haptic-feedback-system a owl:Class ;
    rdfs:label "Haptic Feedback System"@en ;
    rdfs:comment "A Haptic Feedback System is a hardware-software assembly that generates controlled tactile and kinaesthetic sensations in response to digital events, using actuator arrays (vibrotactile motors, piezoelectric patches, pneumatic bladders, or shape-memory alloys), real-time rendering engines, and closed-loop sensorimotor control loops to simulate textures, resistances, impacts, and spatial forces for users of VR/AR headsets, surgical simulators, teleoperation systems, and mobile devices. The system comprises transducers that convert electrical signals into mechanical motion, driver electronics that modulate waveform parameters (frequency, amplitude, duration), rendering middleware that maps virtual-world physics to actuator commands, and perceptual models calibrated to human mechanoreceptor response characteristics."@en ;
    rdfs:subClassOf ngm:haptic-feedback ;
    vc:enables ngm:extended-reality,
        ngm:human-robot-interaction,
        ngm:immersive-experience ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:force-feedback,
        ngm:haptic-feedback-telepresence,
        ngm:haptics,
        ngm:sensor-fusion ;
    vc:slug "haptic-feedback-system" ;
    vc:sourceDomain "graphics" ;
    vc:uses ngm:actuator,
        ngm:force-control,
        ngm:tactile-sensor .

ngm:hardware-abstraction-layer-hal a owl:Class ;
    rdfs:label "Hardware Abstraction Layer (HAL)"@en ;
    rdfs:comment "Software interface that lets applications interact with hardware without device-specific code, providing a standardized abstraction between software and hardware components."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:operating-system ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:hardware-resources ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:device-drivers ],
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:enables ngm:device-portability,
        ngm:platform-independence,
        ngm:unified-hardware-access ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:abstraction-modules,
        ngm:api-interfaces,
        ngm:device-drivers ;
    vc:isPartOf ngm:infrastructure-layer ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:hardware-resources,
        ngm:operating-system ;
    vc:slug "hardware-abstraction-layer-hal" ;
    vc:sourceDomain "spatial-computing" .

ngm:hash-rate a owl:Class ;
    rdfs:label "Hash Rate"@en ;
    rdfs:comment "Hash rate is the aggregate computational throughput of a proof-of-work blockchain network, measured as the number of hash function evaluations performed per unit of time across all participating mining nodes. It serves as the primary quantitative indicator of a network's security: a higher hash rate means an attacker must control and operate more hardware to execute a 51% attack, making double-spend attacks proportionally more expensive. Hash rate is typically expressed in hashes per second (H/s) with SI prefixes (kH/s, MH/s, GH/s, TH/s, PH/s, EH/s) and fluctuates with the entry or exit of miners, hardware efficiency improvements, and changes in mining profitability."@en ;
    rdfs:subClassOf ngm:proof-of-work ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:51-attack,
        ngm:bitcoin-mining,
        ngm:difficulty,
        ngm:difficulty-adjustment,
        ngm:mining,
        ngm:mining-pool,
        ngm:network-hash-rate ;
    vc:slug "hash-rate" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:compute-resources,
        ngm:cryptographic-hash-function,
        ngm:hash-function .

ngm:healthcare-analytics a owl:Class ;
    rdfs:label "Healthcare Analytics"@en ;
    rdfs:comment "The application of artificial intelligence and data science to healthcare data for population health management, operational efficiency optimisation, clinical outcome prediction, resource allocation, and healthcare policy decision-making. Healthcare analytics systems analyse electronic health records, claims data, public health datasets, and operational metrics to derive actionable insights for clinical and administrative improvement."@en ;
    rdfs:subClassOf ngm:ai-application,
        ngm:machine-learning ;
    skos:broader ngm:ai-application ;
    vc:enables ngm:healthcare-technology,
        ngm:medical-ai ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:medical-imaging-ai,
        ngm:pathology-ai,
        ngm:privacy-preserving-analytics ;
    vc:slug "healthcare-analytics" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:data-analytics,
        ngm:machine-learning .

ngm:howey-test a owl:Class ;
    rdfs:label "Howey Test"@en ;
    rdfs:comment "The Howey Test is a four-part legal framework established by the U.S. Supreme Court in SEC v. W.J. Howey Co. (1946) to determine whether a transaction qualifies as an 'investment contract' and therefore constitutes a security subject to federal securities regulation. An instrument is a security if it involves (1) an investment of money, (2) in a common enterprise, (3) with an expectation of profits, (4) derived from the efforts of others."@en ;
    rdfs:subClassOf ngm:investment-contract-analysis ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:financial-regulation,
        ngm:securities-regulation,
        ngm:security-token-offering ;
    vc:slug "howey-test" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:securities-exchange-act-1934 .

ngm:hugging-face-diffusers a owl:Class ;
    rdfs:label "Hugging Face Diffusers"@en ;
    rdfs:comment "Hugging Face Diffusers is an open-source Python library that provides a modular, composable toolkit for training, fine-tuning, and running inference with state-of-the-art diffusion models for image, audio, and video generation. The library abstracts the scheduling, noise prediction, and decoder stages of diffusion pipelines behind a consistent API, enabling rapid experimentation with architectures such as Stable Diffusion, DALL-E-style flows, and audio diffusion models. It integrates natively with the Hugging Face Hub for model discovery and versioning, and with PyTorch and JAX as compute backends."@en ;
    rdfs:subClassOf ngm:ai-infrastructure ;
    vc:enables ngm:fine-tuning,
        ngm:image-generation,
        ngm:text-to-image ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:hugging-face-hub ;
    vc:slug "hugging-face-diffusers" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:diffusion-model,
        ngm:generative-ai .

ngm:human-factors a owl:Class ;
    rdfs:label "Human Factors"@en ;
    rdfs:comment "Human factors encompasses the interdisciplinary study of how humans interact with, perceive, and respond to robotic systems, integrating ergonomics, psychology, cognitive science, and design principles to ensure robots enhance rather than impede human performance and safety."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:user-research ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:safety-assessment ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:usability-testing ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:performance-metrics ],
        ngm:interaction-design,
        ngm:robo-human-robot-interaction,
        ngm:systems-engineering ;
    skos:broader ngm:robo-human-robot-interaction ;
    vc:enables ngm:efficient-collaboration,
        ngm:intuitive-control,
        ngm:operator-safety,
        ngm:user-acceptance ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:cognitive-load-analysis,
        ngm:ergonomics,
        ngm:safety-assessment,
        ngm:trust-calibration,
        ngm:usability-testing ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires ngm:interface-design,
        ngm:performance-metrics,
        ngm:task-analysis,
        ngm:user-research ;
    vc:slug "human-factors" ;
    vc:sourceDomain "robotics" .

ngm:humanoid-robotics a owl:Class ;
    rdfs:label "Humanoid Robotics"@en ;
    rdfs:comment "Humanoid robotics is the subfield of robotics concerned with the design, construction, and control of robots that exhibit a human-like morphology, typically including a bipedal lower body and articulated upper limbs. Such robots are engineered to operate in environments built for humans, using the same tools, furniture, and physical interfaces. Key technical challenges include stable bipedal locomotion across uneven terrain, dexterous manipulation of varied objects, real-time perception and planning under uncertainty, and safe physical interaction with humans. Advances in machine learning and actuator technology have accelerated commercial deployments in manufacturing, logistics, and care."@en ;
    rdfs:subClassOf ngm:humanoid-robot ;
    vc:enables ngm:assistive-robotics,
        ngm:collaborative-robot ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:embodied-ai,
        ngm:human-robot-interaction,
        ngm:legged-locomotion,
        ngm:manipulation ;
    vc:slug "humanoid-robotics" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:motion-planning,
        ngm:sensor-fusion .

ngm:hyperledger-besu a owl:Class ;
    rdfs:label "Hyperledger Besu"@en ;
    rdfs:comment "Enterprise-grade ereum client developed by Hyperledger Foundation supporting both public and private blockchain deployments with multiple consensus mechanisms—ProofOfWork, ProofOfAuthority, Practical Byzantine Fault Tolerance|PBFT."@en ;
    rdfs:subClassOf ngm:bc-network-component ;
    skos:broader ngm:bc-network-component ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:implements ngm:consensus-protocol ;
    vc:qualityScore "0.4"^^xsd:float ;
    vc:slug "hyperledger-besu" ;
    vc:sourceDomain "blockchain" .

ngm:icvcm-core-carbon-principles a owl:Class ;
    rdfs:label "ICVCM Core Carbon Principles"@en ;
    rdfs:comment "The ICVCM Core Carbon Principles (CCPs) are a set of ten threshold standards established by the Integrity Council for the Voluntary Carbon Market to define what constitutes a high-quality carbon credit. They cover governance, emissions impact, and sustainable development dimensions, requiring that credits be real, additional, quantified, permanent, independently verified, and contribute positively to sustainable development goals without causing harm to local communities or ecosystems."@en ;
    rdfs:subClassOf ngm:icvcm-framework ;
    vc:enables ngm:carbon-credit-retirement,
        ngm:voluntary-carbon-market ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:carbon-standard-certification,
        ngm:verra-vcs-standard ;
    vc:slug "icvcm-core-carbon-principles" ;
    vc:sourceDomain "governance" ;
    vc:standardizedBy ngm:integrity-council-for-the-voluntary-carbon-market ;
    vc:supports ngm:carbon-markets .

ngm:identity a owl:Class ;
    rdfs:label "Identity"@en ;
    rdfs:comment "The set of attributes, credentials, and verifiable claims that uniquely identify a principal — person, organisation, or device — within a digital system, enabling authentication, authorisation, and accountability. In metaverse and Web3 contexts, identity may be self-sovereign, portable across platforms, and anchored to decentralised identifiers."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptography ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:authentication ],
        ngm:infra-security-and-identity ;
    skos:broader ngm:infra-security-and-identity ;
    vc:enables ngm:access-control ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:relatedTo ngm:decentralised-identity,
        ngm:identity-management,
        ngm:self-sovereign-identity ;
    vc:requires ngm:authentication,
        ngm:cryptography ;
    vc:slug "identity" ;
    vc:sourceDomain "infrastructure" .

ngm:immersive-interface a owl:Class ;
    rdfs:label "Immersive Interface"@en ;
    rdfs:comment "User interaction systems for VR, AR, and metaverse applications encompassing spatial user interfaces, haptic feedback devices, gesture recognition, voice control, and multimodal input mods that enable natural, intuitive engagement with virtual environments."@en ;
    rdfs:subClassOf ngm:human-computer-interface,
