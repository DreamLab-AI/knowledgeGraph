ngm:commit a owl:Class ;
    rdfs:comment "The atomic unit of change in a version control system: an immutable, uniquely identified snapshot of a project's tracked content together with metadata — author, timestamp, descriptive message, and references to one or more parent commits — so that the full set of commits forms a directed acyclic graph recording the project's history; in Git each commit is content-addressed by a cryptographic hash of its tree and parents, making history tamper-evident and enabling branching, merging, reverting, and precise attribution of every line of a codebase."@en ;
    rdfs:label "Commit"@en ;
    rdfs:subClassOf ngm:data-structure ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:isPartOf ngm:git ;
    vc:isPartOf ngm:version-control ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:merkle-tree ;
    vc:slug "commit" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:cryptographic-hash ;
    vc:uses ngm:directed-acyclic-graph .
