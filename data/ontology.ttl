    dcterms:modified "2026-04-26T13:00:00Z"^^xsd:dateTime ;
    vcw:owlRole "Concept" .

# Virtual Production Workflow
spatial-computing:VirtualProductionWorkflow rdf:type owl:Class ;
    rdfs:subClassOf spatial-computing:ProductionPipeline ;
    rdfs:label "Virtual Production Workflow"@en ;
    rdfs:comment "The end-to-end process for creating film and television content using virtual production techniques, integrating pre-visualization, virtual art department asset creation, real-time game engine rendering, LED volume shooting, and post-production refinement in a non-linear pipeline where VFX work begins in pre-production rather than post-production."@en ;
    skos:prefLabel "Virtual Production Workflow"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:spatial-computing:virtual-production-workflow" ;
    owl:sameAs <urn:visionclaw:concept:spatial-computing:virtual-production-workflow> ;
