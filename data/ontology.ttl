ngm:fsdp a owl:Class ;
    rdfs:label "FSDP"@en ;
    rdfs:comment "Fully Sharded Data Parallel (FSDP) is a distributed training technique implemented natively in PyTorch that shards a model's parameters, gradients, and optimizer states across multiple GPUs or nodes, enabling training of models too large for a single device's memory. Each worker holds only a fraction of every parameter tensor and gathers the full tensor on demand via all-gather collective operations before each layer's forward computation, immediately discarding the assembled tensor after use so that only the local shard is persistently stored. FSDP implements the ZeRO Stage 3 memory partitioning algorithm as a first-class PyTorch primitive, and integrates with sharded Distributed Checkpointing (DCP) so that each rank writes and reads its own parameter shard independently, enabling checkpoint resharding across different cluster topologies at load time."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gpu-compute ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:python-pytorch-deep-learning-stack ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:collective-communication ],
        ngm:cat-ai-infrastructure,
        ngm:distributed-training ;
    skos:broader ngm:cat-ai-infrastructure ;
    vc:contrastsWith ngm:deep-speed,
        ngm:distributed-data-parallel,
        ngm:megatron-lm ;
    vc:dependsOn ngm:backpropagation,
        ngm:distributed-computing,
        ngm:gradient-descent,
        ngm:mixed-precision-training,
        ngm:nvidia-nccl ;
    vc:enables ngm:checkpoint-resharding,
        ngm:foundation-model,
        ngm:large-language-model-training,
        ngm:model-scaling ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:all-gather-collective,
        ngm:distributed-checkpointing,
        ngm:reduce-scatter-collective,
        ngm:sharded-gradient,
        ngm:sharded-optimiser-state,
        ngm:sharded-parameter ;
    vc:implements ngm:data-parallelism,
        ngm:distributed-checkpointing,
        ngm:zero-stage-3 ;
    vc:qualityScore "0.89"^^xsd:float ;
    vc:relatedTo ngm:checkpoints,
        ngm:distributed-computing,
        ngm:distributed-training,
        ngm:hugging-face-accelerate,
        ngm:model-parallelism,
        ngm:pipeline-parallelism,
        ngm:tensor-parallelism,
        ngm:torchtitan,
        ngm:zero-redundancy-optimiser ;
    vc:requires ngm:collective-communication,
        ngm:gpu-compute,
        ngm:gradient-synchronisation,
        ngm:python-pytorch-deep-learning-stack ;
    vc:slug "fsdp" ;
    vc:sourceDomain "machine-learning" ;
    vc:supports ngm:checkpoints,
        ngm:deep-learning,
        ngm:fine-tuning,
        ngm:reinforcement-learning-from-human-feedback ;
    vc:uses ngm:gradient-checkpointing,
