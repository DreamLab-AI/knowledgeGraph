ngm:model-evaluation a owl:Class ;
    rdfs:label "Model Evaluation"@en ;
    rdfs:comment "Model Evaluation is the systematic process of measuring the performance, reliability, safety, and fitness-for-purpose of machine learning models against defined metrics, held-out datasets, and behavioural benchmarks. It encompasses quantitative metric computation, qualitative red-teaming, and comparative benchmarking to inform deployment decisions and ongoing monitoring."@en ;
    rdfs:subClassOf ngm:machine-learning ;
    vc:enables ngm:model-evaluation-results ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
