ngm:file-storage a owl:Class ;
    rdfs:comment "File storage is a storage model that organises data as named files within a hierarchical directory tree, accessed through file-system semantics such as open, read, write and seek. It presents a familiar path-based namespace and is typically shared over network protocols for concurrent access. File storage contrasts with block storage, which exposes raw volumes, and object storage, which uses a flat namespace of objects addressed by key."@en ;
    rdfs:label "File Storage"@en ;
    rdfs:subClassOf ngm:storage-infrastructure ;
