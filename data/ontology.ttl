    vc:requires ngm:computational-resources,
        ngm:distributed-computing ;
    vc:slug "scientific-computing" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:cuda,
        ngm:gpu-computing,
        ngm:mpi,
        ngm:openmp,
        ngm:simulation-engine .

ngm:semantic-interoperability a owl:Class ;
    rdfs:label "Semantic Interoperability"@en ;
    rdfs:comment "Semantic interoperability is the capability of disparate information systems to exchange data with shared, unambiguous meaning by aligning their data models, ontologies, and controlled vocabularies at the level of semantics rather than syntax. Unlike syntactic interoperability, which concerns format agreement alone, semantic interoperability requires that the interpretation of exchanged values is consistent across system boundaries — typically enforced through shared formal ontologies expressed in OWL2, RDF-based linked data representations, and standardised schema mappings. It is a foundational property of federated knowledge graphs, cross-enterprise data sharing, healthcare information exchange, and machine-readable regulatory compliance. Achieving it demands governance as much as technology: communities must agree on canonical concept identifiers, term definitions, and relationship axioms before any technical implementation can succeed."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ontology ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:controlled-vocabulary ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:schema-mapping ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-standards ],
        ngm:interoperability ;
    vc:bridgesTo ngm:ai-knowledge-base,
        ngm:digital-twin ;
    vc:contrastsWith ngm:structural-interoperability,
        ngm:syntactic-interoperability ;
    vc:enables ngm:data-interoperability,
        ngm:federated-data-sharing,
        ngm:knowledge-graph,
        ngm:machine-readable-compliance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:data-governance,
        ngm:interoperability-standard,
        ngm:knowledge-representation,
        ngm:linked-data ;
    vc:requires ngm:controlled-vocabulary,
        ngm:data-standards,
        ngm:ontology,
        ngm:schema-mapping ;
    vc:slug "semantic-interoperability" ;
    vc:sourceDomain "data" ;
    vc:standardizedBy ngm:hl7-fhir,
        ngm:iso-11179,
        ngm:w3-c ;
    vc:uses ngm:json-data-interchange-format-ld,
        ngm:owl,
        ngm:rdf,
        ngm:sparql .

ngm:skeletal-animation a owl:Class ;
    rdfs:label "Skeletal Animation"@en ;
    rdfs:comment "Skeletal animation is a character animation technique in which a hierarchical rig of joints defines the articulated structure of a character or creature, and mesh vertices are deformed by the weighted influence of surrounding joints through a process known as skinning. Artists author motion by keyframing or procedurally driving joint transforms over time; the underlying mesh deforms accordingly in real time on the GPU via linear blend skinning or dual-quaternion skinning. The approach is the dominant method for animating characters in games, virtual reality, film visual effects, and virtual avatar systems due to its runtime efficiency, compact data representation, and amenability to motion capture retargeting and machine-learning-driven synthesis."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:blend-tree ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:character-rigging ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:scene-graph ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:animation-state-machine ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gpu-compute ],
        ngm:character-animation ;
    vc:bridgesTo ngm:digital-twin,
        ngm:neural-motion-synthesis ;
    vc:enables ngm:avatar-animation,
        ngm:facial-animation,
        ngm:pose-estimation,
        ngm:real-time-character-animation,
        ngm:virtual-production ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:animation-state-machine,
        ngm:blend-tree,
        ngm:character-rigging ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:animation-controller,
        ngm:gl-tf-3-d-file-format,
        ngm:level-of-detail,
        ngm:morph-target-animation,
        ngm:physics-based-animation,
        ngm:procedural-animation ;
    vc:requires ngm:gpu-compute,
        ngm:scene-graph ;
    vc:slug "skeletal-animation" ;
    vc:sourceDomain "spatial-computing" ;
    vc:standardizedBy ngm:gltf-standard ;
    vc:uses ngm:animation-retargeting,
        ngm:forward-kinematics,
        ngm:inverse-kinematics,
        ngm:motion-capture,
        ngm:vertex-shader .

ngm:value-alignment a owl:Class ;
    rdfs:label "Value Alignment"@en ;
    rdfs:comment "The challenge and process of ensuring AI systems pursue objectives that align with human values, even as those systems become more capable and autonomous. Value alignment addresses both technical and philosophical questions about encoding human preferences into AI behaviour."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
