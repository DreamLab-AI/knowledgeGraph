    vc:sourceDomain "spatial-computing" .

ngm:emotional-immersion a owl:Class ;
    rdfs:label "Emotional Immersion"@en ;
    rdfs:comment "Psychological absorption and empathetic engagement experienced during virtual interaction, characterized by affective resonance with virtual content and reduced awareness of physical surroundings."@en ;
