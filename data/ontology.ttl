ngm:identity-resolution a owl:Class ;
    rdfs:comment "Identity resolution is the process of determining that multiple data records, identifiers, or signals across different systems refer to the same real-world entity — whether a person, organisation, or device — and consolidating them into a unified, persistent representation. It combines probabilistic and deterministic matching algorithms, data enrichment, and graph-linking to resolve fragmented identities across first-party, second-party, and third-party data sources."@en ;
    rdfs:label "Identity Resolution"@en ;
    rdfs:subClassOf ngm:entity-resolution ;
