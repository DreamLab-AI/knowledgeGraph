        ngm:semantic-interoperability .

ngm:open-source a owl:Class ;
    rdfs:label "Open Source"@en ;
    rdfs:comment "Open source designates software whose source code is released under a licence conforming to the Open Source Definition, granting anyone the rights to use, study, modify, and redistribute the code and derivative works. It is a development paradigm rooted in decentralised, community-driven collaboration where peer review, transparent workflows, and shared governance replace proprietary, closed development. Open source underpins the majority of modern computing infrastructure — from operating systems and compilers to cloud platforms and AI frameworks — and has expanded beyond software into hardware designs, datasets, models, and scientific research artefacts. Licences range from permissive (MIT, Apache 2.0) to copyleft (GPL, AGPL), with the choice of licence shaping how downstream users may integrate the code."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:code-review ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:version-control ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:version-control ],
        ngm:software-development ;
    vc:bridgesTo ngm:decentralised-autonomous-organisation,
        ngm:federated-learning,
        ngm:open-source-ai ;
    vc:contrastsWith ngm:closed-source,
        ngm:proprietary-software ;
    vc:enables ngm:collaborative-development,
        ngm:continuous-integration,
        ngm:reproducible-research,
        ngm:supply-chain-transparency ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:code-review,
        ngm:open-source-licence,
        ngm:package-management,
        ngm:version-control ;
    vc:isPartOf ngm:commons-based-peer-production,
        ngm:software-development ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:inner-source,
        ngm:open-hardware,
        ngm:software-bill-of-materials ;
    vc:requires ngm:open-source-licence,
        ngm:version-control ;
    vc:slug "open-source" ;
    vc:sourceDomain "distributed-collaboration" ;
    vc:standardizedBy ngm:free-software-foundation,
        ngm:open-source-initiative ;
    vc:supports ngm:ai-model-transparency,
        ngm:decentralised-governance,
        ngm:software-supply-chain ;
    vc:uses ngm:continuous-integration,
        ngm:git,
        ngm:issue-tracking .

ngm:open-telemetry a owl:Class ;
    rdfs:label "OpenTelemetry"@en ;
    rdfs:comment "OpenTelemetry (OTel) is a vendor-neutral open-source observability framework and CNCF project that provides unified APIs, SDKs, agents, and wire protocols for collecting distributed traces, metrics, and logs from software systems. It merges the OpenTracing and OpenCensus projects into a single standardised instrumentation layer, enabling consistent telemetry data collection regardless of the backend analysis platform. OpenTelemetry's OpenTelemetry Protocol (OTLP) has become the de-facto standard for telemetry data transport in cloud-native environments."@en ;
    rdfs:subClassOf ngm:monitoring-system ;
    vc:bridgesTo ngm:ai-system-monitoring,
        ngm:llm-observability ;
    vc:dependsOn ngm:grpc,
