    rdfs:label "Semantic Organization"@en .
ngm:semantic-parsing a owl:Class ;
    rdfs:comment "Semantic parsing is the task of mapping natural-language utterances onto structured, machine-interpretable meaning representations such as logical forms, executable queries or programs. It converts ambiguous human language into precise formalisms that can be reasoned over or executed against a database or knowledge graph. Applications include question answering, text-to-SQL and instruction-to-code translation."@en ;
    rdfs:label "Semantic Parsing"@en ;
    rdfs:subClassOf ngm:natural-language-processing ;
    rdfs:subClassOf _:r19102 ;
