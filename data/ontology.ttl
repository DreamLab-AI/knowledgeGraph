    rdfs:label "Human vs AI"@en ;
    rdfs:comment "The contested domain examining comparative capabilities, limitations, and complementarities between human cognition and artificial intelligence systems, encompassing debates about autonomy, agency, creativity, and the appropriate division of decision-making authority between people and machines."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:accountability ],
        ngm:ai-governance-and-ethics ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:contrastsWith ngm:artificial-general-intelligence,
        ngm:autonomous-ai-agents ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:ai-ethics,
        ngm:ai-safety,
        ngm:fairness ;
    vc:requires ngm:accountability ;
    vc:slug "human-vs-ai" ;
    vc:sourceDomain "artificial-intelligence" .

