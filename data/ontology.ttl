    vc:qualityScore "0.35"^^xsd:float ;
    vc:slug "secondary-market-integration" ;
    vc:sourceDomain "spatial-computing" .

ngm:secure-email a owl:Class ;
    rdfs:label "Secure Email"@en ;
    rdfs:comment "Secure email is the set of technologies and practices that protect the confidentiality, integrity, and authenticity of electronic mail in transit and at rest. It combines transport encryption between mail servers, end-to-end message encryption and signing schemes, and sender-authentication and anti-spoofing controls, so that recipients can trust who sent a message and that its contents were not read or altered along the way."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptography ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:public-key-infrastructure ],
        ngm:secure-communication ;
    vc:contrastsWith ngm:tls ;
    vc:dependsOn ngm:digital-signature ;
    vc:enables ngm:secure-communication ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:end-to-end-encryption ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:cryptography,
        ngm:public-key-infrastructure ;
    vc:requires ngm:cryptography,
        ngm:public-key-infrastructure ;
    vc:slug "secure-email" ;
    vc:sourceDomain "security" ;
    vc:standardizedBy ngm:public-key-infrastructure ;
    vc:supports ngm:compliance ;
    vc:uses ngm:end-to-end-encryption,
        ngm:tls .

ngm:securities-act-1933 a owl:Class ;
    rdfs:label "Securities Act 1933"@en ;
    rdfs:comment "The Securities Act of 1933 is the foundational United States federal statute governing the offer and sale of securities. It requires that securities offered to the public be registered with regulators and accompanied by truthful disclosure, with the aim of preventing fraud and protecting investors. In digital-asset contexts it is central to determining whether a token sale constitutes an unregistered securities offering."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:financial-regulation ],
        ngm:securities-law ;
    vc:bridgesTo ngm:security-token ;
    vc:contrastsWith ngm:financial-regulation ;
    vc:dependsOn ngm:regulatory-compliance ;
    vc:enables ngm:investor-protection ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:implements ngm:investor-protection ;
    vc:isPartOf ngm:securities-law ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:regulatory-framework,
        ngm:security-token ;
    vc:requires ngm:financial-regulation ;
    vc:slug "securities-act-1933" ;
    vc:sourceDomain "blockchain" ;
    vc:standardizedBy ngm:securities-regulation ;
    vc:supports ngm:investor-protection ;
    vc:uses ngm:howey-test .

ngm:security-by-design a owl:Class ;
    rdfs:label "Security By Design"@en ;
    rdfs:comment "Security by design is an engineering approach in which security is treated as a foundational requirement and built into systems from the earliest stages rather than bolted on retrospectively. It favours secure defaults, minimal attack surface, defence in depth and least-privilege access, supported by threat modelling and continuous verification across the development lifecycle. The principle is increasingly mandated by regulators and procurement frameworks for connected products and critical infrastructure."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:software-engineering ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:risk-management ],
        ngm:cybersecurity ;
    vc:enables ngm:resilience,
        ngm:vulnerability-management ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:access-control,
        ngm:authentication,
        ngm:encryption ;
    vc:isPartOf ngm:security ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:privacy-by-design,
        ngm:threat-model,
        ngm:threat-modelling ;
    vc:requires ngm:risk-management,
        ngm:software-engineering ;
    vc:slug "security-by-design" ;
    vc:sourceDomain "security" ;
    vc:supports ngm:cybersecurity,
        ngm:zero-trust-architecture ;
    vc:uses ngm:defense-in-depth,
        ngm:least-privilege .

ngm:security-engineering a owl:Class ;
    rdfs:label "Security Engineering"@en ;
    rdfs:comment "Security engineering is the discipline of designing, building, and maintaining systems that remain dependable and trustworthy in the face of malice, error, and accident. It applies systematic engineering practices to protect the confidentiality, integrity, and availability of information and assets, integrating threat modelling, secure architecture, and verifiable controls across the development lifecycle. Security engineers reason about adversaries, attack surfaces, and trust boundaries to make risk decisions defensible and economically rational."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:key-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:security-architecture ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:risk-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptography ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:security-testing ],
        ngm:software-engineering ;
    vc:bridgesTo ngm:supply-chain-security ;
    vc:contrastsWith ngm:privacy-engineering ;
    vc:enables ngm:data-protection,
        ngm:defense-in-depth ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:key-management,
        ngm:security-architecture,
        ngm:security-testing ;
    vc:isPartOf ngm:cybersecurity ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:security ;
    vc:requires ngm:cryptography,
        ngm:risk-management ;
    vc:slug "security-engineering" ;
    vc:sourceDomain "security" ;
    vc:supports ngm:incident-response,
        ngm:vulnerability-management ;
    vc:uses ngm:access-control,
        ngm:authentication,
        ngm:authorization,
        ngm:penetration-testing .

ngm:security-standards a owl:Class ;
    rdfs:label "Security Standards"@en ;
    rdfs:comment "Security standards are published specifications that define requirements, controls, and best practices for protecting information systems. They span management frameworks such as ISO/IEC 27001, control catalogues such as NIST SP 800-53, and authentication standards. They provide a common basis for designing, assessing, and certifying the security posture of organisations and products."@en ;
    rdfs:subClassOf ngm:technical-standard ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:authentication-standards,
        ngm:cybersecurity-standard ;
    vc:slug "security-standards" ;
    vc:sourceDomain "security" .

ngm:self-training a owl:Class ;
    rdfs:label "Self Training"@en ;
    rdfs:comment "A semi-supervised learning technique where a model is iteratively improved by training on its own high-confidence predictions on unlabelled data. Self-training enables learning from large amounts of unlabelled data by using the model's own predictions as pseudo-labels."@en ;
    rdfs:subClassOf ngm:ai-technique,
        ngm:semi-supervised-learning ;
    skos:broader ngm:ai-technique ;
    vc:enables ngm:active-learning,
        ngm:large-language-models ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:semi-supervised-learning ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:knowledge-distillation ;
    vc:slug "self-training" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:transfer-learning .

