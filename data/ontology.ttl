ngm:paris-agreement-article-6 a owl:Class ;
    rdfs:comment "Paris Agreement Article 6 is the provision of the 2015 Paris Agreement that establishes mechanisms for countries to cooperate in meeting emissions-reduction targets, including international transfer of mitigation outcomes and a centralized crediting market. It defines accounting rules to prevent double-counting when carbon reductions are traded between parties. Article 6 provides the international legal basis for cross-border carbon markets and corresponding adjustments."@en ;
    rdfs:label "Paris Agreement Article 6"@en ;
    rdfs:subClassOf ngm:regulatory-compliance ;
