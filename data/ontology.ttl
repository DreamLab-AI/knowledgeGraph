        ngm:machine-learning-discipline-pipeline .

ngm:speaker-diarisation a owl:Class ;
    rdfs:label "Speaker Diarisation"@en ;
    rdfs:comment "Speaker diarisation is the automated process of partitioning a continuous multi-speaker audio stream into temporally contiguous, speaker-homogeneous segments and assigning a speaker label to each segment, answering the question 'who spoke when?' without necessarily mapping labels to real-world identities. A canonical pipeline comprises voice activity detection, acoustic feature extraction, speaker embedding (via models such as x-vectors or ECAPA-TDNN), agglomerative or spectral clustering to group embeddings into speaker clusters, optional overlap detection, and a resegmentation or ViterBI refinement step. End-to-end neural approaches such as EEND (End-to-End Neural Diarisation) unify segmentation and assignment into a single sequence-labelling model capable of handling overlapping speech. Speaker diarisation is a foundational component in meeting transcription systems, clinical consultation recording, broadcast media indexing, and any dialogue-analytic pipeline that requires utterance attribution."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:speaker-embedding ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:voice-activity-detection ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:transformer-architecture ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:audio-processing-system ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:feature-extraction ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:deep-learning ],
        ngm:speech-processing ;
    vc:bridgesTo ngm:multimodal-ai-architecture-learning,
        ngm:real-time-collaboration ;
    vc:contrastsWith ngm:speaker-recognition,
        ngm:speaker-verification ;
    vc:dependsOn ngm:automatic-speech-recognition,
        ngm:signal-processing ;
    vc:enables ngm:meeting-transcription,
        ngm:real-time-transcription ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:feature-extraction,
        ngm:speaker-embedding,
        ngm:spectral-clustering,
        ngm:voice-activity-detection ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:emotion-recognition,
        ngm:natural-language-processing,
        ngm:noise-reduction ;
    vc:requires ngm:audio-processing-system,
        ngm:deep-learning,
        ngm:transformer-architecture ;
    vc:slug "speaker-diarisation" ;
    vc:sourceDomain "ai" .

ngm:static-analysis a owl:Class ;
    rdfs:label "Static Analysis"@en ;
    rdfs:comment "Static analysis is the examination of software source code, byte code or binaries without executing the program, in order to detect defects, security vulnerabilities, style violations and correctness properties. Techniques range from simple pattern-based linting to formal abstract interpretation and data-flow analysis over the program's control structure. It is commonly integrated into editors and continuous-integration pipelines to provide early feedback before code runs."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:compiler ],
        ngm:software-testing ;
    vc:bridgesTo ngm:compiler,
        ngm:formal-verification ;
    vc:contrastsWith ngm:simulation ;
    vc:enables ngm:code-review,
        ngm:security-audit ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:verification ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:formal-verification,
        ngm:security-audit,
        ngm:testing ;
    vc:requires ngm:compiler ;
    vc:slug "static-analysis" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:code-review,
        ngm:software-testing ;
    vc:uses ngm:code-generation,
        ngm:compiler .

ngm:supply-chain-provenance a owl:Class ;
    rdfs:label "Supply Chain Provenance"@en ;
    rdfs:comment "Supply chain provenance is the verified documentary record of an item's origin, material composition, transformation steps, custody changes, and transportation history from raw material extraction through to the end consumer, enabling authenticity verification, ethical sourcing attestation, and regulatory compliance. It extends data provenance principles to physical goods, typically combining IoT sensor data, third-party audit records, and cryptographic anchors (hashes or blockchain transactions) to create an immutable chain of evidence that resists falsification and supports granular attribution."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:unique-identifier ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-integrity ],
        ngm:provenance-tracking ;
    vc:bridgesTo ngm:zero-knowledge-proof ;
    vc:enables ngm:anti-counterfeiting,
        ngm:ethical-sourcing,
        ngm:regulatory-compliance,
        ngm:supply-chain-transparency ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:gs-1-standards,
        ngm:gs1-epcis ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:chain-of-custody,
        ngm:conflict-mineral-tracking,
        ngm:digital-product-passport,
        ngm:supply-chain,
        ngm:supply-chain-traceability ;
    vc:requires ngm:data-integrity,
        ngm:unique-identifier ;
    vc:slug "supply-chain-provenance" ;
    vc:sourceDomain "supply-chain" ;
    vc:standardizedBy ngm:gs1-digital-link,
        ngm:provenance-standard ;
    vc:supports ngm:esg-reporting,
        ngm:food-safety,
        ngm:provenance-verification ;
    vc:uses ngm:audit-trail,
        ngm:cryptographic-hash-function,
        ngm:decentralized-identifiers,
        ngm:sensor-data,
        ngm:supply-chain-blockchain,
        ngm:verifiable-credentials .

ngm:supply-chain-visibility a owl:Class ;
    rdfs:label "Supply Chain Visibility"@en ;
    rdfs:comment "Supply chain visibility is the capability to track, monitor, and share accurate, real-time information about the location, status, and condition of goods, components, and materials as they move through a supply network from raw material sourcing through production, distribution, and delivery to end customers. It requires integration of data from disparate logistics systems, IoT sensors, carrier APIs, and ERP platforms, and provides the situational awareness needed for proactive disruption management, regulatory compliance, and demand-driven inventory optimisation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-integration ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:real-time-data-processing ],
        ngm:supply-chain-management ;
    vc:bridgesTo ngm:blockchain,
        ngm:machine-learning ;
    vc:enables ngm:cold-chain-monitoring,
        ngm:compliance-monitoring,
        ngm:demand-forecasting,
        ngm:risk-management,
        ngm:supply-chain-provenance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:supply-chain,
        ngm:supply-chain-blockchain,
        ngm:supply-chain-transparency ;
    vc:requires ngm:data-integration,
        ngm:real-time-data-processing ;
    vc:slug "supply-chain-visibility" ;
    vc:sourceDomain "supply-chain" ;
    vc:supports ngm:digital-product-passport,
        ngm:esg-reporting,
        ngm:scope-3-emissions ;
    vc:uses ngm:api-integration,
        ngm:io-t-sensors,
        ngm:logistics-optimization,
        ngm:provenance-tracking,
        ngm:rfid,
        ngm:supply-chain-traceability .

ngm:sustainable-development-goals a owl:Class ;
    rdfs:label "Sustainable Development Goals"@en ;
    rdfs:comment "The Sustainable Development Goals (SDGs) are a set of 17 interlinked global goals adopted by all United Nations member states in 2015 as part of the 2030 Agenda for Sustainable Development, spanning the elimination of poverty, zero hunger, quality education, gender equality, clean energy, decent work, reduced inequalities, climate action, and partnerships for implementation. Each goal is operationalised through targets and indicators that define measurable progress benchmarks, providing a shared framework for national governments, international organisations, civil society, and the private sector to align strategies and report progress. The SDGs extend and deepen the Millennium Development Goals, recognising that sustainable development requires integrated action across social, economic, and environmental dimensions simultaneously."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:sustainability-reporting ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:environmental-sustainability ],
        ngm:sustainable-development ;
    vc:bridgesTo ngm:blockchain-governance ;
    vc:enables ngm:carbon-accounting,
        ngm:esg-reporting,
        ngm:green-finance,
        ngm:impact-investing ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:paris-agreement ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:environmental-standards,
        ngm:esg-investing,
        ngm:global-inequality,
        ngm:societal-and-environmental-wellbeing ;
    vc:requires ngm:environmental-sustainability,
        ngm:multilateral-cooperation,
        ngm:sustainability-reporting ;
    vc:slug "sustainable-development-goals" ;
    vc:sourceDomain "governance" ;
    vc:supports ngm:climate-action,
        ngm:poverty-reduction .

ngm:synchronisation a owl:Class ;
    rdfs:label "Synchronisation"@en ;
    rdfs:comment "Synchronisation is the coordination of multiple processes, devices, or data replicas so that they reach a consistent state or act in a precise temporal relationship. In computing it covers concurrency primitives like locks and barriers; in distributed and robotic systems it covers clock alignment and coordinated motion. Accurate synchronisation is essential wherever independent components must agree on order, timing, or shared state."@en ;
    rdfs:subClassOf ngm:distributed-systems ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:delta-robot,
        ngm:edge-computing ;
    vc:slug "synchronisation" ;
    vc:sourceDomain "infrastructure" .

ngm:tensor a owl:Class ;
    rdfs:label "Tensor"@en ;
    rdfs:comment "A tensor is a multidimensional array of numerical values characterised by a rank, a shape and a data type, generalising scalars, vectors and matrices to arbitrary dimensions. In machine learning it is the fundamental data structure that holds inputs, parameters, activations and gradients as they flow through a model. Tensor operations such as contraction, broadcasting and elementwise functions are the computational primitives executed on accelerators during training and inference."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:computation-graph ],
        ngm:linear-algebra ;
    vc:dependsOn ngm:linear-algebra ;
    vc:enables ngm:automatic-differentiation,
        ngm:backpropagation,
        ngm:deep-learning ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:computation-graph ;
    vc:implements ngm:py-torch,
        ngm:tensor-flow ;
    vc:isPartOf ngm:linear-algebra,
        ngm:neural-network ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:automatic-differentiation,
        ngm:deep-learning,
        ngm:tensor-processing-unit ;
    vc:slug "tensor" ;
    vc:sourceDomain "machine-learning" ;
    vc:supports ngm:computation-graph,
        ngm:neural-network ;
    vc:uses ngm:gpu,
        ngm:tensor-processing-unit .

ngm:time-series-database a owl:Class ;
    rdfs:label "Time-Series Database"@en ;
    rdfs:comment "A time-series database (TSDB) is a database system optimised for storing, querying, and analysing data points indexed by time. It is designed for workloads dominated by high-volume, append-only writes of timestamped measurements and by queries that aggregate over time ranges. TSDBs employ time-aware partitioning, columnar layouts, and specialised compression to handle the scale and access patterns of metrics, events, and sensor readings efficiently."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:time-series-data ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:data-ingestion ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:retention-policy ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:indexing ],
        ngm:database-management-system ;
    vc:contrastsWith ngm:nosql-database,
        ngm:relational-database ;
    vc:dependsOn ngm:database ;
    vc:enables ngm:monitoring,
        ngm:observability,
        ngm:real-time-analytics ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:data-ingestion,
        ngm:retention-policy ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:database-management-system ;
    vc:requires ngm:indexing,
        ngm:time-series-data ;
    vc:slug "time-series-database" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:metrics ;
    vc:uses ngm:data-compression,
        ngm:data-storage .

ngm:traditional-finance a owl:Class ;
    rdfs:label "Traditional Finance"@en ;
    rdfs:comment "Traditional Finance (TradFi) denotes the incumbent financial system comprising central banks, commercial and investment banks, securities exchanges, clearing houses, custodians, and regulated intermediaries that operate under sovereign legal frameworks. It relies on trusted third parties to record ownership, settle transactions, and extend credit, in contrast to decentralised or blockchain-native alternatives. Its architecture encompasses fractional-reserve banking, fiat currency issuance, and multilateral settlement rails such as SWIFT and RTGS systems. TradFi institutions are subject to prudential regulation, capital adequacy requirements (Basel III/IV), and conduct oversight by bodies such as the SEC, FCA, and ECB."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:traditional-banking ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:kyc-aml ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:fiat-currency ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:regulatory-compliance ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:clearing-house ],
        ngm:financial-infrastructure ;
    vc:bridgesTo ngm:blockchain-interoperability,
        ngm:central-bank-digital-currency,
        ngm:tokenised-real-world-assets,
        ngm:tokenization ;
    vc:contrastsWith ngm:cryptocurrency,
        ngm:de-fi,
        ngm:decentralised-finance ;
    vc:dependsOn ngm:central-banking,
        ngm:financial-infrastructure ;
    vc:enables ngm:capital-markets,
        ngm:institutional-adoption,
        ngm:payment-system ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:central-banking,
        ngm:clearing-house,
        ngm:investment-banking,
        ngm:traditional-banking ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:asset-management,
        ngm:financial-regulation,
        ngm:market-microstructure,
        ngm:risk-management ;
    vc:requires ngm:fiat-currency,
        ngm:kyc-aml,
        ngm:regulatory-compliance ;
    vc:slug "traditional-finance" ;
    vc:sourceDomain "finance" .

ngm:type-system a owl:Class ;
    rdfs:label "Type System"@en ;
    rdfs:comment "A type system is a formal component of a programming language that classifies values and expressions into types and defines rules constraining how they may be combined. It is enforced by a checker that rejects programs violating these rules, preventing classes of errors before or during execution. Type systems vary along axes such as static versus dynamic checking, strength, and expressiveness, trading safety guarantees against flexibility."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:programming-language ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:interface ],
        ngm:programming-language ;
    vc:dependsOn ngm:compiler ;
    vc:enables ngm:quality-assurance,
        ngm:software-engineering ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:interface ;
    vc:implements ngm:type-script ;
    vc:isPartOf ngm:programming-language ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:interface,
        ngm:software-architecture,
        ngm:type-script ;
    vc:requires ngm:programming-language ;
    vc:slug "type-system" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:api ;
    vc:uses ngm:compiler .

ngm:usability-testing a owl:Class ;
    rdfs:label "Usability Testing"@en ;
    rdfs:comment "Usability testing is an empirical user research method in which representative users are observed attempting to complete realistic tasks with a product, system, or prototype, while the evaluator records errors, task completion times, help-seeking behaviour, and verbal commentary to identify usability problems and inform design improvements. Unlike expert-based heuristic evaluation, usability testing generates direct evidence of how real people interact with an interface under ecologically valid conditions. It is a core practice in human-computer interaction, product design, and user experience research, conducted through moderated in-person sessions, remote think-aloud protocols, or automated unmoderated testing platforms."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:session-recording ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:research-methods ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:user-research ],
        ngm:user-research ;
    vc:bridgesTo ngm:artificial-intelligence,
        ngm:spatial-computing ;
    vc:contrastsWith ngm:a-b-testing,
        ngm:heuristic-evaluation ;
    vc:enables ngm:evidence-based-design,
        ngm:iterative-design,
        ngm:product-design,
        ngm:user-interface ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:session-recording ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:accessibility,
        ngm:cognitive-load,
        ngm:eye-tracking,
        ngm:heuristic-methods,
        ngm:human-computer-interaction,
        ngm:task-analysis,
        ngm:think-aloud-protocol,
        ngm:user-experience ;
    vc:requires ngm:prototype,
        ngm:research-methods,
        ngm:user-research ;
    vc:slug "usability-testing" ;
    vc:sourceDomain "data" ;
    vc:standardizedBy ngm:iso-9241,
        ngm:wcag-2-2 ;
    vc:uses ngm:participant-recruitment,
        ngm:quality-assurance,
        ngm:research-methods,
