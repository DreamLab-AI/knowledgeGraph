ngm:sharding a owl:Class ;
    rdfs:label "Sharding"@en ;
    rdfs:comment "Sharding is a horizontal partitioning technique for distributed databases and blockchain networks in which a dataset or workload is divided into disjoint subsets called shards, each maintained by a distinct subset of nodes, so that the total system throughput scales with the number of shards rather than being bounded by the capacity of a single node. In databases, sharding routes queries to the appropriate shard by a sharding key. In blockchain, each shard processes its own subset of transactions and stores its own portion of the state, with cross-shard communication handled by a coordination layer. Sharding dramatically increases transaction throughput and reduces storage requirements per node at the cost of increased architectural complexity and cross-shard coordination overhead."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:consensus-protocol ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:beacon-chain ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:validator-set ],
        ngm:blockchain-scalability ;
    vc:contrastsWith ngm:layer-2-scaling,
        ngm:replication ;
    vc:dependsOn ngm:distributed-hash-table,
        ngm:peer-to-peer-network ;
    vc:enables ngm:blockchain-network,
        ngm:distributed-computing,
        ngm:horizontal-scalability ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:beacon-chain ;
    vc:implements ngm:data-partitioning ;
    vc:isPartOf ngm:blockchain-scalability,
        ngm:distributed-system ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:consensus-mechanism,
        ngm:danksharding,
        ngm:distributed-data-structure,
        ngm:rollup ;
    vc:requires ngm:consensus-protocol,
        ngm:validator-set ;
    vc:slug "sharding" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:consensus-protocol,
        ngm:distributed-hash-table,
        ngm:merkle-tree .

ngm:sql a owl:Class ;
    rdfs:label "SQL"@en ;
    rdfs:comment "SQL (Structured Query Language) is a declarative, domain-specific language for defining, manipulating, and querying data held in relational database management systems. A user expresses the desired result set through clauses such as SELECT, FROM, WHERE, JOIN, and GROUP BY, while the database query optimiser determines the physical execution plan. Standardised by ANSI and ISO since 1986, SQL spans data definition (DDL), data manipulation (DML), and transaction control, and remains the predominant interface for structured data despite the rise of NoSQL alternatives."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:query-optimiser ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:schema ],
        ngm:database-system ;
    vc:bridgesTo ngm:object-relational-mapping ;
    vc:contrastsWith ngm:graph-query-language,
        ngm:nosql ;
    vc:enables ngm:data-analytics,
        ngm:transaction-processing ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:data-definition-language,
        ngm:data-manipulation-language,
        ngm:query-optimiser ;
    vc:implements ngm:declarative-query,
        ngm:relational-algebra ;
    vc:isPartOf ngm:relational-database ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:data-management,
        ngm:stored-procedure ;
    vc:requires ngm:schema ;
    vc:slug "sql" ;
    vc:sourceDomain "data" ;
    vc:standardizedBy ngm:ansi,
        ngm:iso-iec-9075 ;
    vc:supports ngm:business-intelligence,
        ngm:data-warehouse ;
    vc:uses ngm:acid-transactions,
        ngm:indexing .

ngm:text-generation a owl:Class ;
    rdfs:label "Text Generation"@en ;
    rdfs:comment "Text Generation is the NLP task of producing coherent, contextually appropriate natural language text using neural language models, including applications such as story generation, article writing, code generation, and creative content production. Modern text generation employs transformer-based language models with autoregressive or sequence-to-sequence architectures, controllable generation techniques, and prompt engineering to produce human-quality text across diverse domains and styles."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:large-language-models ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:transformer ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:beam-search ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:training-data ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:autoregressive-generation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:neural-network ],
        ngm:language-modeling ;
    vc:bridgesTo ngm:agent-frameworks,
        ngm:knowledge-graphing ;
    vc:contrastsWith ngm:image-generation,
        ngm:speech-and-voice ;
    vc:dependsOn ngm:language-modeling,
        ngm:neural-network-latent-space ;
    vc:enables ngm:code-generation,
