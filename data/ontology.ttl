    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:probability-theory ;
    vc:slug "markov-chain" ;
    vc:sourceDomain "mathematics" .

ngm:middleware-layer a owl:Class ;
    rdfs:label "Middleware Layer"@en ;
    rdfs:comment "The MiddlewareLayer represents the abstraction level of integration components, orchestration systems, abstraction layers, API implementations, and coordination services that bridge between different system layers, domains, or components in blockchain and distributed systems."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
