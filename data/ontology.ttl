ngm:rapid-ai-deployment a owl:Class ;
    rdfs:label "Rapid AI Deployment"@en ;
    rdfs:comment "Rapid AI Deployment refers to accelerated processes for taking AI models from development into production, prioritising speed-to-market through streamlined MLOps pipelines, automated testing, and pre-built infrastructure. It encompasses practices such as continuous delivery of model updates, containerised inference serving, and automated monitoring to minimise the time between model training and live operation while managing associated risks."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:machine-learning-pipeline ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cloud-infrastructure ],
        ngm:ai-infrastructure ;
    vc:contrastsWith ngm:federated-learning ;
    vc:dependsOn ngm:inference-hardware,
        ngm:machine-learning-model ;
    vc:enables ngm:ai-deployment,
        ngm:inference ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:ai-lifecycle,
        ngm:ai-risk-management,
        ngm:responsible-ai ;
    vc:requires ngm:cloud-infrastructure,
        ngm:machine-learning-pipeline ;
    vc:slug "rapid-ai-deployment" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:api-gateway,
        ngm:machine-learning-infrastructure .

