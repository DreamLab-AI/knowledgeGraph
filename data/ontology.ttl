        ngm:classification-metric,
        ngm:model-performance ;
    vc:requires ngm:classification,
        ngm:confusion-matrix ;
    vc:slug "precision" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:standardizedBy ngm:iso-iec-25059,
        ngm:nist-ai-rmf ;
    vc:supports ngm:fairness-assessment,
        ngm:model-selection,
        ngm:responsible-ai ;
    vc:uses ngm:precision-recall-curve .

ngm:public-goods-funding a owl:Class ;
    rdfs:label "Public Goods Funding"@en ;
    rdfs:comment "Public goods funding encompasses the mechanisms, institutions, and coordination protocols that allocate capital toward resources which are non-excludable and non-rival — goods whose consumption by one party does not diminish availability to others and from which no party can be practically excluded. In open digital ecosystems, this addresses a structural market failure: rational actors under-invest in shared infrastructure because they can free-ride on others' contributions. Blockchain-native primitives such as quadratic funding, retroactive grants, and DAO-managed treasuries have revived and extended classical public economics, enabling transparent, on-chain allocation of capital toward open-source software, protocol research, and collective knowledge commons. The field sits at the intersection of mechanism design, cryptoeconomics, and welfare economics, driving continuous innovation in sybil resistance, matching fund architecture, and governance legitimacy."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:mechanism-design ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:on-chain-governance ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:identity-verification ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:quadratic-funding ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:retroactive-public-goods-funding ],
        ngm:bc-defi-and-economics ;
    skos:broader ngm:bc-defi-and-economics ;
    vc:bridgesTo ngm:decentralised-autonomous-organisation,
        ngm:digital-commons ;
    vc:contrastsWith ngm:venture-capital ;
    vc:dependsOn ngm:cryptoeconomics,
        ngm:token-governance ;
    vc:enables ngm:commons-based-peer-production,
        ngm:open-source-software,
        ngm:protocol-development ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:quadratic-funding,
        ngm:retroactive-public-goods-funding ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:collective-action,
        ngm:welfare-economics ;
    vc:requires ngm:identity-verification,
        ngm:mechanism-design,
        ngm:on-chain-governance ;
    vc:slug "public-goods-funding" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:dao,
        ngm:quadratic-voting,
        ngm:smart-contract,
        ngm:sybil-resistance,
        ngm:treasury-management .

ngm:quantitative-easing a owl:Class ;
    rdfs:label "Quantitative Easing"@en ;
    rdfs:comment "Quantitative easing (QE) is an unconventional monetary policy in which a central bank purchases large quantities of longer-dated financial assets, typically government bonds, to inject liquidity into the financial system and lower long-term interest rates. It is deployed when short-term policy rates are already near zero and conventional rate cuts are exhausted. By expanding the central bank's balance sheet and the monetary base, QE aims to stimulate lending, asset prices and aggregate demand."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:liquidity ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:central-bank ],
        ngm:monetary-policy ;
    vc:contrastsWith ngm:fiscal-policy ;
    vc:dependsOn ngm:interest-rate ;
    vc:enables ngm:financial-stability ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:liquidity ;
    vc:isPartOf ngm:monetary-policy ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:financial-stability,
        ngm:inflation,
        ngm:interest-rate ;
    vc:requires ngm:central-bank ;
    vc:slug "quantitative-easing" ;
    vc:sourceDomain "finance" ;
    vc:supports ngm:liquidity ;
    vc:uses ngm:central-bank .

ngm:rb-0094-power-and-force-limiting a owl:Class ;
    rdfs:label "rb 0094 power and force limiting"@en ;
    rdfs:comment "Power and Force Limiting (PFL) is a collaborative robot safety mode defined in ISO/TS 15066 in which the robot's mechanical power, force, and momentum are continuously constrained so that any contact with a human remains below biomechanical injury thresholds. Unlike speed-and-separation monitoring, PFL allows direct physical contact by ensuring that contact forces can never exceed prescribed quasi-static and transient limits."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:rb-0067-force-torque-sensor ],
        ngm:robo-safety-and-standards,
        ngm:robot-safety ;
    skos:broader ngm:robo-safety-and-standards ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:cobot-safety-levels,
        ngm:rb-0089-risk-assessment,
        ngm:rb-0091-safety-rated-monitored-stop,
        ngm:rb-0092-protective-stop,
        ngm:rb-0093-speed-limitation ;
    vc:requires ngm:rb-0067-force-torque-sensor ;
    vc:slug "rb-0094-power-and-force-limiting" ;
    vc:sourceDomain "robotics" ;
    vc:standardizedBy ngm:iso-10218,
        ngm:iso-ts-15066 ;
    vc:supports ngm:human-robot-interaction,
        ngm:rb-0057-admittance-control .

