] .

mv:SpatialAudioSystem rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:relatedTo ;
    owl:someValuesFrom mv:VRAudio
] .

mv:SpatialAudioSystem rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:relatedTo ;
    owl:someValuesFrom mv:Ambisonics
] .

# Spatial Audio
