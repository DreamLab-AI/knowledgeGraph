    vc:relatedTo ngm:bandwidth,
        ngm:mesh-network,
        ngm:network-latency ;
    vc:requires ngm:communication-protocol,
        ngm:network-security,
        ngm:radio-frequency-spectrum ;
    vc:slug "wireless-connectivity" ;
    vc:sourceDomain "infrastructure" ;
    vc:standardizedBy ngm:3-gpp,
        ngm:ieee,
        ngm:itu ;
    vc:supports ngm:autonomous-vehicle,
        ngm:distributed-collaboration ;
    vc:uses ngm:encryption,
        ngm:packet-switching .

ngm:workflow-orchestration a owl:Class ;
    rdfs:label "Workflow Orchestration"@en ;
    rdfs:comment "Workflow orchestration is the coordination of multiple interdependent tasks, services, or agents into a coherent end-to-end process, managing ordering, data flow, conditional branching, error handling, and resource allocation. It centralises control logic so that distributed components execute in the correct sequence with the right inputs. In agentic AI systems, orchestration governs how tool calls, sub-agents, and model invocations are sequenced to accomplish complex goals."@en ;
    rdfs:subClassOf ngm:ai-agent-system ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:ai-application,
        ngm:function-calling ;
    vc:slug "workflow-orchestration" ;
    vc:sourceDomain "ai" .

ngm:3-d-content-generation a owl:Class ;
    rdfs:label "3D Content Generation"@en ;
    rdfs:comment "The computational process of producing three-dimensional digital content through algorithmic and AI-driven methods, encompassing procedural generation, neural rendering, NeRF-based scene synthesis, and GAN-based 3D model creation. Applications span game development, virtual reality, digital twins, and automated CAD, enabling scalable production of photorealistic 3D assets from text or image inputs."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:deep-learning ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
