            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:consensus-algorithm ],
        ngm:infra-computing-and-cloud ;
    skos:broader ngm:infra-computing-and-cloud ;
    vc:bridgesTo ngm:decentralised-finance,
        ngm:smart-contract-platform ;
    vc:contrastsWith ngm:crash-fault-tolerant-system,
        ngm:paxos-consensus,
        ngm:raft-consensus ;
    vc:dependsOn ngm:cryptographic-signature,
        ngm:network-communication-model,
        ngm:peer-to-peer-network ;
    vc:enables ngm:atomic-broadcast,
        ngm:consensus-mechanism,
        ngm:consensus-protocol,
        ngm:distributed-ledger ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:leader-election,
        ngm:prepare-commit-phase,
        ngm:view-change-protocol ;
    vc:implements ngm:byzantine-fault-tolerance,
        ngm:state-machine-replication ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:byzantine-generals-problem,
        ngm:hotstuff-protocol,
        ngm:pbft,
        ngm:tendermint ;
    vc:requires ngm:consensus-algorithm,
        ngm:message-authentication,
        ngm:quorum-system ;
    vc:slug "byzantine-fault-tolerant-system" ;
    vc:sourceDomain "distributed-systems" ;
    vc:supports ngm:blockchain-network,
        ngm:permissioned-blockchain,
        ngm:replicated-state-machine .

ngm:cable-drive a owl:Class ;
    rdfs:label "Cable Drive"@en ;
    rdfs:comment "A cable drive (cable-driven transmission) is a mechanical actuation mechanism that transmits force and motion through tensioned cables, tendons, or belts routed over pulleys, rather than through rigid gear trains. It allows actuators to be located remotely from the joint they drive, reducing distal mass and inertia in robotic limbs and surgical instruments. Cable drives matter in robotics because they enable lightweight, compliant, backdrivable joints with low backlash."@en ;
    rdfs:subClassOf ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:mechanical-component ;
    vc:slug "cable-drive" ;
    vc:sourceDomain "robotics" .

