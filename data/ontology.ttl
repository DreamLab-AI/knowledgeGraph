ngm:monero a owl:Class ;
    rdfs:label "Monero"@en ;
    rdfs:comment "Monero (XMR) is an open-source, privacy-preserving cryptocurrency launched in April 2014 as a fork of the Bytecoin codebase, distinguished by making confidentiality mandatory for every transaction rather than optional. It achieves unlinkability and untraceability through three complementary cryptographic primitives: ring signatures that blend the spender's output among decoys drawn from the blockchain history, one-time stealth addresses that prevent linking payments to a recipient's public key, and Ring Confidential Transactions (RingCT) that hide transferred amounts using Pedersen commitments. The protocol employs a proof-of-work algorithm — originally CryptoNight, later RandomX — engineered to maintain parity between CPUs and GPUs while resisting ASIC specialisation, thereby preserving decentralised mining participation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:proof-of-work ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:stealth-address ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:pedersen-commitment ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ring-signature ],
        ngm:bc-token-and-asset ;
    skos:broader ngm:bc-token-and-asset ;
    vc:bridgesTo ngm:secure-multi-party-computation,
        ngm:zero-knowledge-proof ;
    vc:contrastsWith ngm:bitcoin,
        ngm:ethereum,
        ngm:zcash ;
    vc:enables ngm:censorship-resistance,
        ngm:financial-privacy,
        ngm:fungibility ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:confidential-transactions ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:anti-money-laundering,
        ngm:blockchain,
        ngm:cryptocurrency,
        ngm:decentralised-finance,
        ngm:regulatory-compliance ;
    vc:requires ngm:pedersen-commitment,
        ngm:proof-of-work,
        ngm:ring-signature,
        ngm:stealth-address ;
    vc:slug "monero" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:bulletproofs,
        ngm:elliptic-curve-cryptography .

ngm:monetary-policy-transmission a owl:Class ;
    rdfs:label "Monetary Policy Transmission"@en ;
    rdfs:comment "Monetary policy transmission is the process by which changes in a central bank's policy instruments—primarily short-term interest rates or reserve quantities—propagate through financial markets and the broader economy to affect output, employment, and the price level. The transmission operates through multiple channels including the interest rate channel (altering borrowing costs), the credit channel (influencing bank lending and balance-sheet constraints), the exchange rate channel (shifting the relative price of tradeable goods), the asset price channel (changing wealth and Tobin's q), and expectations channels (anchoring or re-anchoring inflation expectations). The strength, speed, and reliability of each channel depends on the institutional structure of the financial system, the degree of market completeness, and the prevailing monetary regime."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:central-bank ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:banking-system ],
        ngm:monetary-policy ;
    vc:bridgesTo ngm:central-bank-digital-currency ;
    vc:dependsOn ngm:financial-system,
        ngm:monetary-system ;
    vc:enables ngm:financial-stability,
        ngm:inflation-control,
        ngm:price-stability ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:exchange-rate,
        ngm:inflation,
        ngm:interest-rate,
        ngm:monetary-policy-implementation ;
    vc:requires ngm:banking-system,
        ngm:central-bank ;
    vc:slug "monetary-policy-transmission" ;
    vc:sourceDomain "finance" ;
    vc:uses ngm:forward-guidance,
        ngm:quantitative-easing .

ngm:multi-agent-orchestration a owl:Class ;
    rdfs:label "Multi-Agent Orchestration"@en ;
    rdfs:comment "Multi-agent orchestration is the coordination and management of multiple autonomous AI agents — each capable of perceiving, reasoning, and acting — such that their collective behaviour accomplishes complex tasks beyond the capacity of any single agent. Orchestration encompasses task decomposition, agent assignment, inter-agent communication, state sharing, conflict resolution, and result aggregation, typically mediated by an orchestrator layer or emergent via peer protocols."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:orchestration-layer ],
        [ a owl:Restriction ;
