ngm:audio-generation a owl:Class ;
    rdfs:label "Audio Generation"@en ;
    rdfs:comment "Audio generation is the use of generative machine-learning models to synthesise sound — including speech, music, sound effects, and ambient audio — from inputs such as text, symbolic scores, or learned latent representations. Models learn the statistical structure of audio either in the raw waveform domain or in compressed time-frequency representations such as spectrograms, then sample new outputs that are perceptually realistic. The field encompasses text-to-speech, music generation, voice cloning, and general audio synthesis, drawing on autoregressive, diffusion, and adversarial generative architectures."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:audio-codec ],
        ngm:generative-ai ;
    vc:bridgesTo ngm:ethical-ai,
        ngm:multimodal-ai ;
    vc:dependsOn ngm:audio-processing,
        ngm:deep-learning,
        ngm:neural-network ;
    vc:enables ngm:music-generation,
