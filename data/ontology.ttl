        ngm:signal-processing,
        ngm:time-series-analysis,
        ngm:training-data ;
    vc:slug "predictive-maintenance" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:standardizedBy ngm:iec-61499,
        ngm:ieee-1451,
        ngm:iso-10816,
        ngm:iso-13374,
        ngm:iso-13379,
        ngm:iso-20816,
        ngm:iso-55000 ;
    vc:supports ngm:aerospace-mro,
        ngm:manufacturing-quality-control,
        ngm:oil-and-gas-operations,
        ngm:power-generation,
