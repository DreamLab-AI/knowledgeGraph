# Model Performance
artificial-intelligence:ModelPerformance rdf:type owl:Class ;
    rdfs:label "Model Performance"@en ;
    rdfs:comment "The quantitative and qualitative measure of how effectively an artificial intelligence model accomplishes its designated tasks, typically assessed through statistical metrics evaluating prediction accuracy, reliability, generalisability, computational efficiency, and robustness, considered across different data distributions, operational conditions, and stakeholder requirements, serving as a critical basis for model selection, deployment decisions, ongoing monitoring, and continuous improvement throughout the AI lifecycle."@en ;
    skos:prefLabel "Model Performance"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:artificial-intelligence:model-performance" ;
    owl:sameAs <urn:visionclaw:concept:artificial-intelligence:model-performance> ;
    vcw:contentHash "sha256-12-3021a8109459" ;
    vcw:qualityScore "0.5"^^xsd:decimal ;
    vcw:legacyTermId "AI-0106" ;
    vcw:ontologyStatus "draft" ;
    vcw:maturityLevel "draft" ;
    vcw:authorityScore "0.0"^^xsd:decimal ;
    dcterms:identifier "AI-0106" ;
    dcterms:subject "artificial-intelligence" ;
    owl:versionInfo "2.0.0" ;
    dcterms:created "2026-04-26T00:00:00Z"^^xsd:dateTime ;
    dcterms:modified "2026-04-26T13:00:00Z"^^xsd:dateTime ;
    vcw:owlRole "Concept" .

# Accuracy
artificial-intelligence:Accuracy rdf:type owl:Class ;
    rdfs:label "Accuracy"@en ;
    rdfs:comment "A classification performance metric representing the proportion of correct predictions made by an artificial intelligence model across all instances in a dataset, calculated as the ratio of the sum of true positives and true negatives to the total number of predictions, providing an aggregate measure of overall model correctness but potentially obscuring performance disparities across classes, particularly in datasets with imbalanced class distributions or asymmetric misclassification costs."@en ;
    skos:prefLabel "Accuracy"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:artificial-intelligence:accuracy" ;
    owl:sameAs <urn:visionclaw:concept:artificial-intelligence:accuracy> ;
    vcw:contentHash "sha256-12-53ececcfa757" ;
    vcw:qualityScore "0.5"^^xsd:decimal ;
    vcw:legacyTermId "AI-0107" ;
    vcw:ontologyStatus "draft" ;
    vcw:maturityLevel "draft" ;
    vcw:authorityScore "0.0"^^xsd:decimal ;
    dcterms:identifier "AI-0107" ;
    dcterms:subject "artificial-intelligence" ;
    owl:versionInfo "2.0.0" ;
    dcterms:created "2026-04-26T00:00:00Z"^^xsd:dateTime ;
    dcterms:modified "2026-04-26T20:11:27Z"^^xsd:dateTime ;
    vcw:owlRole "Concept" .

artificial-intelligence:Accuracy vcw:bridgesTo artificial-intelligence:ComputerVision .

# Precision
spatial-computing:Precision rdf:type owl:Class ;
    rdfs:label "Precision"@en ;
    rdfs:comment "A classification performance metric representing the proportion of positive predictions made by an artificial intelligence model that are actually correct, calculated as the ratio of true positives to all positive predictions (true positives plus false positives), measuring the model's ability to avoid false alarms and providing critical insight into prediction reliability, particularly important in applications where the cost or consequence of false positive errors is significant."@en ;
    skos:prefLabel "Precision"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:spatial-computing:precision" ;
    owl:sameAs <urn:visionclaw:concept:spatial-computing:precision> ;
    vcw:contentHash "sha256-12-ed19056fac93" ;
    vcw:qualityScore "0.5"^^xsd:decimal ;
    vcw:legacyTermId "AI-0108" ;
    vcw:ontologyStatus "draft" ;
    vcw:maturityLevel "draft" ;
    vcw:authorityScore "0.0"^^xsd:decimal ;
    dcterms:identifier "AI-0108" ;
    dcterms:subject "spatial-computing" ;
    owl:versionInfo "2.0.0" ;
    dcterms:created "2026-04-26T00:00:00Z"^^xsd:dateTime ;
    dcterms:modified "2026-04-26T13:00:00Z"^^xsd:dateTime ;
    vcw:owlRole "Concept" .

# Recall
spatial-computing:Recall rdf:type owl:Class ;
    rdfs:label "Recall"@en ;
    rdfs:comment "A classification performance metric representing the proportion of actual positive instances that an artificial intelligence model correctly identifies, calculated as the ratio of true positives to all actual positives (true positives plus false negatives), measuring the model's completeness in detecting positive cases, particularly critical in applications where missing positive instances (false negatives) carries significant cost or consequences."@en ;
    skos:prefLabel "Recall"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:spatial-computing:recall" ;
    owl:sameAs <urn:visionclaw:concept:spatial-computing:recall> ;
    vcw:contentHash "sha256-12-fe3016490030" ;
    vcw:qualityScore "0.5"^^xsd:decimal ;
    vcw:legacyTermId "AI-0109" ;
    vcw:ontologyStatus "draft" ;
    vcw:maturityLevel "draft" ;
    vcw:authorityScore "0.0"^^xsd:decimal ;
    dcterms:identifier "AI-0109" ;
    dcterms:subject "spatial-computing" ;
    owl:versionInfo "2.0.0" ;
    dcterms:created "2026-04-26T00:00:00Z"^^xsd:dateTime ;
    dcterms:modified "2026-04-26T13:00:00Z"^^xsd:dateTime ;
    vcw:owlRole "Concept" .

# F1 Score
spatial-computing:F1Score rdf:type owl:Class ;
    rdfs:label "F1 Score"@en ;
    rdfs:comment "A classification performance metric representing the harmonic mean of precision and recall, providing a single score that balances a model's ability to avoid false positives (precision) with its ability to avoid false negatives (recall), calculated to give equal weight to both metrics whilst penalising extreme imbalances, particularly useful for comparing models or setting decision thresholds when both prediction reliability and completeness are important and when class distributions are imbalanced."@en ;
    skos:prefLabel "F1 Score"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:spatial-computing:f1-score" ;
    owl:sameAs <urn:visionclaw:concept:spatial-computing:f1-score> ;
    vcw:contentHash "sha256-12-a46e72ae851c" ;
    vcw:qualityScore "0.5"^^xsd:decimal ;
    vcw:legacyTermId "AI-0110" ;
    vcw:ontologyStatus "draft" ;
    vcw:maturityLevel "draft" ;
    vcw:authorityScore "0.0"^^xsd:decimal ;
    dcterms:identifier "AI-0110" ;
    dcterms:subject "spatial-computing" ;
    owl:versionInfo "2.0.0" ;
    dcterms:created "2026-04-26T00:00:00Z"^^xsd:dateTime ;
    dcterms:modified "2026-04-26T13:00:00Z"^^xsd:dateTime ;
    vcw:owlRole "Concept" .

# Confusion Matrix
spatial-computing:ConfusionMatrix rdf:type owl:Class ;
    rdfs:label "Confusion Matrix"@en ;
    rdfs:comment "A tabular visualisation and analytical tool summarising the performance of a classification model by displaying the counts or proportions of predictions cross-tabulated against actual class labels, typically organised with predicted classes as columns and actual classes as rows (or vice versa), enabling systematic analysis of where a model succeeds and fails, calculation of various performance metrics, and identification of specific confusion patterns between classes."@en ;
    skos:prefLabel "Confusion Matrix"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:spatial-computing:confusion-matrix" ;
    owl:sameAs <urn:visionclaw:concept:spatial-computing:confusion-matrix> ;
    vcw:contentHash "sha256-12-6814adbf97f7" ;
    vcw:qualityScore "0.5"^^xsd:decimal ;
    vcw:legacyTermId "AI-0111" ;
    vcw:ontologyStatus "draft" ;
    vcw:maturityLevel "draft" ;
    vcw:authorityScore "0.0"^^xsd:decimal ;
    dcterms:identifier "AI-0111" ;
    dcterms:subject "spatial-computing" ;
    owl:versionInfo "2.0.0" ;
    dcterms:created "2026-04-26T00:00:00Z"^^xsd:dateTime ;
    dcterms:modified "2026-04-26T13:00:00Z"^^xsd:dateTime ;
    vcw:owlRole "Concept" .

spatial-computing:ConfusionMatrix rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty infrastructure:enables ;
    owl:someValuesFrom spatial-computing:Erroranalysis
] .

spatial-computing:ConfusionMatrix rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty infrastructure:enables ;
    owl:someValuesFrom spatial-computing:fairnessassessment
] .

spatial-computing:ConfusionMatrix rdfs:subClassOf [
