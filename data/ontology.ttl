] .

bc:NetworkComponent rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:relatedTo ;
    owl:someValuesFrom bc:BlockchainNetwork
] .

# Supply Chain Management
bc:SupplyChainManagement a owl:Class ;
    rdfs:subClassOf bc:BlockchainEntity ;
    rdfs:label "Supply Chain Management"@en ;
    rdfs:comment "Supply Chain Management in blockchain contexts refers to the application of distributed ledger technology for tracking, verifying, and managing the flow of goods, services, and information across supply networks. This includes traceability systems, provenance verification, and transparency solutions that leverage blockchain's immutability and decentralisation."@en ;
    skos:prefLabel "Supply Chain Management"@en ;
    dcterms:identifier "BC-0605" ;
    dcterms:subject "bc" .

bc:SupplyChainManagement rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:isParentOf ;
    owl:someValuesFrom bc:Traceability
] .

bc:SupplyChainManagement rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:isParentOf ;
    owl:someValuesFrom bc:Provenance
] .

bc:SupplyChainManagement rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:isParentOf ;
    owl:someValuesFrom bc:SupplyChainTransparency
] .

bc:SupplyChainManagement rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:relatedTo ;
    owl:someValuesFrom bc:SmartContract
] .

# NftMinting
bc:NftMinting a owl:Class ;
    rdfs:subClassOf bc:BlockchainProcess ;
    rdfs:label "NftMinting"@en ;
    rdfs:comment "A nft minting component in the Blockchain domain that enables DigitalAssetWorkflow."@en ;
    skos:prefLabel "NftMinting"@en ;
    dcterms:identifier "BC-1000" ;
    dcterms:subject "bc" ;
    dcterms:type "emerging" .

# Blockchain Oracle
bc:Oracle a owl:Class ;
    rdfs:label "Blockchain Oracle"@en ;
    rdfs:comment "A decentralized service that bridges blockchain smart contracts with external real-world data, enabling smart contracts to access off-chain information, execute based on real-world events, and interact with traditional systems while maintaining trustless verification and data integrity."@en ;
    skos:prefLabel "Blockchain Oracle"@en ;
    dcterms:identifier "BC-3007" ;
    dcterms:subject "bc" ;
    dcterms:type "production-ready" ;
    rdf:type owl:DataBridgeClass .

# PrivateBlockchain
bc:PrivateBlockchain a owl:Class ;
    rdfs:label "PrivateBlockchain"@en ;
    rdfs:comment "A permissioned Blockchain network where access, participation, and validation rights are restricted to authorized entities, typically used in enterprise and consortium settings with controlled governance and enhanced privacy."@en ;
    skos:prefLabel "PrivateBlockchain"@en ;
    dcterms:identifier "BC-3050" ;
    dcterms:subject "bc" ;
    dcterms:type "production-ready" ;
    rdf:type owl:TechnologyArchetypeClass .

# Bitcoin
bc:Bitcoin a owl:Class ;
    rdfs:subClassOf bc:Cryptocurrency ;
    rdfs:subClassOf bc:Blockchain ;
