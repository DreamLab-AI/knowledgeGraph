ngm:iso-iec-jtc1-sc42 a owl:Class ;
    rdfs:label "ISO IEC JTC1 SC42"@en ;
    rdfs:comment "ISO/IEC JTC 1/SC 42 is the joint ISO and IEC subcommittee responsible for international standardisation in the field of artificial intelligence. It develops foundational standards covering AI concepts and terminology, risk management, trustworthiness, data quality for machine learning, governance, and the AI system lifecycle. Its outputs, including ISO/IEC 22989 and ISO/IEC 23894, provide a common vocabulary and management framework that regulators and industry reference when assuring AI systems. SC 42 coordinates with national standards bodies and aligns with emerging AI regulation."@en ;
    rdfs:subClassOf ngm:standards-body ;
    vc:bridgesTo ngm:artificial-intelligence ;
    vc:enables ngm:ai-governance,
        ngm:trustworthy-ai ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:iso ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:governance,
        ngm:iso-iec-23894,
        ngm:nist-ai-rmf,
        ngm:standards ;
    vc:slug "iso-iec-jtc1-sc42" ;
    vc:sourceDomain "governance" ;
    vc:standardizedBy ngm:iso ;
    vc:supports ngm:ai-risk-management,
        ngm:policy-framework .

ngm:jailbreaking a owl:Class ;
    rdfs:label "Jailbreaking"@en ;
    rdfs:comment "Jailbreaking of large language models (LLMs) is the practice of crafting inputs—prompts, instruction sequences, encoded payloads, or multi-turn conversational strategies—that cause a model to produce outputs that circumvent its safety training, content policies, or alignment objectives."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:transformer-architecture ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:instruction-tuning ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:prompt-injection ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:large-language-models ],
        ngm:ai-technique,
        ngm:prompt-engineering ;
    skos:broader ngm:ai-technique ;
    vc:bridgesTo ngm:adversarial-machine-learning ;
    vc:enables ngm:adversarial-testing,
        ngm:red-teaming ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:prompt-injection ;
    vc:implements ngm:constitutional-ai-training-methodology,
        ngm:rlhf ;
    vc:qualityScore "0.52"^^xsd:float ;
    vc:relatedTo ngm:agent-frameworks,
        ngm:agentic-internet,
        ngm:agents,
        ngm:ai-companies,
        ngm:ai-liability,
        ngm:cli-multi-agent-systems,
        ngm:constitutional-ai-training-methodology-language-model-family,
        ngm:instruction-following-conversational-ai-system ;
    vc:requires ngm:instruction-tuning,
        ngm:large-language-models,
        ngm:transformer-architecture ;
    vc:slug "jailbreaking" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:standardizedBy ngm:aisi,
        ngm:eu-ai-act-regulatory-instrument,
        ngm:mitre-atlas,
        ngm:nist-ai-rmf ;
    vc:supports ngm:ai-governance,
