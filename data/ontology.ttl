        ngm:network-science,
        ngm:social-network-graph ;
    vc:requires ngm:data-structure,
        ngm:network-topology ;
    vc:slug "social-network-analysis" ;
    vc:sourceDomain "data" ;
    vc:uses ngm:adjacency-matrix,
        ngm:community-detection,
        ngm:graph-theory,
        ngm:statistical-inference .

ngm:standards-conformance a owl:Class ;
    rdfs:label "Standards Conformance"@en ;
    rdfs:comment "The state or process of meeting the requirements specified in a technical standard, specification, or guideline, ensuring that a product, process, or system aligns with internal or industry-specific standards for interoperability, quality, and compatibility."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:technical-standards ],
        ngm:sc-standards-and-interop,
        ngm:standards ;
