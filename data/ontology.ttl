        ngm:semantic-web-standards,
        ngm:sparql-endpoint ;
    vc:requires ngm:graph-database,
        ngm:rdf ;
    vc:slug "sparql" ;
    vc:sourceDomain "infrastructure" .

ngm:tokenization a owl:Class ;
