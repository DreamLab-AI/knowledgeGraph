    rdfs:label "EU HLEG AI"@en ;
    rdfs:comment "The European Commission High-Level Expert Group on Artificial Intelligence, an advisory body convened in 2018 that produced the Ethics Guidelines for Trustworthy AI and related policy recommendations."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
