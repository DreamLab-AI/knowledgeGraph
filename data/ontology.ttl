        ngm:presence ;
    vc:slug "presence-detection" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:computer-vision,
        ngm:sensor-fusion .

ngm:prior-distribution a owl:Class ;
    rdfs:label "Prior Distribution"@en ;
    rdfs:comment "A prior distribution is the probability distribution over unknown quantities that encodes belief before observing data, in Bayesian inference. It is combined with the likelihood via Bayes' theorem to produce the posterior. The choice of prior, ranging from informative to weakly informative or uninformative, encodes assumptions and regularises inference, especially with limited data."@en ;
    rdfs:subClassOf ngm:machine-learning ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:bayes-filter,
        ngm:posterior-distribution,
        ngm:probabilistic-model ;
    vc:slug "prior-distribution" ;
    vc:sourceDomain "ai" .

ngm:privacy-enhancing-computation-pec a owl:Class ;
    rdfs:label "Privacy-Enhancing Computation (PEC)"@en ;
    rdfs:comment "Computational techniques that enable data processing and analysis while preserving privacy through cryptographic mods such as homomorphic encryption, secure multi-party computation, and differential privacy."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptographic-primitive ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:homomorphic-encryption ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:key-management ],
        [ a owl:Restriction ;
