ngm:educational-methodology a owl:Class ;
    rdfs:label "Educational Methodology"@en ;
    rdfs:comment "Educational Methodology is a structured approach to the design, delivery, and evaluation of learning experiences, encompassing pedagogical theories, instructional design models, and assessment frameworks. In spatial computing contexts it includes immersive, experiential, and simulation-based learning paradigms enabled by XR technologies."@en ;
    rdfs:subClassOf ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:enables ngm:generative-content ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:augmented-reality,
        ngm:digital-twin ;
    vc:slug "educational-methodology" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:simulation,
        ngm:virtual-reality .

ngm:eigen-layer a owl:Class ;
    rdfs:label "EigenLayer"@en ;
    rdfs:comment "EigenLayer is an Ethereum-based restaking protocol that allows ETH stakers to extend their cryptoeconomic security — the stake already deposited to validate the Ethereum consensus layer — to additional decentralised services called Actively Validated Services (AVS). By opting into EigenLayer smart contracts, stakers grant the protocol the right to apply slashing conditions from multiple AVS operators simultaneously, enabling new protocols such as data availability layers, bridges, oracles, and sequencers to bootstrap economic security without deploying their own native token staking systems. EigenLayer fundamentally reuses and resells Ethereum's security budget."@en ;
    rdfs:subClassOf ngm:blockchain-protocol ;
    vc:enables ngm:de-fi-protocol,
        ngm:decentralized-application,
        ngm:layer-2-scaling ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:liquid-proof-of-stake,
        ngm:validator-economics,
        ngmi:ethereum ;
    vc:slug "eigen-layer" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:cryptographic-protocol,
        ngm:proof-of-stake,
        ngm:validator-node .

ngm:emotional-analytics-engine a owl:Class ;
    rdfs:label "Emotional Analytics Engine"@en ;
    rdfs:comment "AI module analyzing affective states from facial, voice, or physiological data to enable adaptive agent responses and affective computing."@en ;
