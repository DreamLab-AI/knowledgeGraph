ngm:immersive-audio-technology a owl:Class ;
    rdfs:label "Immersive Audio Technology"@en ;
    rdfs:comment "Technologies and techniques for rendering spatially accurate, three-dimensional soundscapes within virtual and augmented reality environments. Encompasses binaural rendering, ambisonics, head-related transfer function (HRTF) personalisation, and real-time positional audio to create convincing auditory presence that reinforces visual immersion."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:rendering-pipeline ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:xr-runtime-environment ],
        ngm:sc-display-and-rendering ;
    skos:broader ngm:sc-display-and-rendering ;
    vc:enables ngm:immersive-experience,
        ngm:virtual-theater ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:requires ngm:rendering-pipeline,
        ngm:xr-runtime-environment ;
    vc:slug "immersive-audio-technology" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:augmented-reality,
        ngm:virtual-reality ;
    vc:uses ngm:signal-processing,
        ngm:spatial-audio .

ngm:immersive-computing a owl:Class ;
    rdfs:label "Immersive Computing"@en ;
    rdfs:comment "Immersive computing is the broad discipline of designing and operating computing systems that surround users with synthetic or blended sensory environments — encompassing virtual reality, augmented reality, and mixed reality — to create a subjective sense of presence within a digitally mediated space. It integrates real-time 3D rendering, spatial tracking, haptic feedback, and multi-modal interaction to replace or augment the user's natural perceptual field."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:haptic-feedback ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:immersive-experience ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:real-time-rendering ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:virtual-reality ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:spatial-audio ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:head-mounted-display ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:augmented-reality ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:mixed-reality ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:graphics-processing-unit ],
        ngm:extended-reality ;
    vc:bridgesTo ngm:artificial-intelligence,
        ngm:distributed-collaboration,
        ngm:metaverse ;
    vc:contrastsWith ngm:desktop-computing ;
    vc:enables ngm:digital-twin,
        ngm:immersive-collaboration,
        ngm:virtual-training ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:augmented-reality,
        ngm:haptic-feedback,
        ngm:immersive-experience,
        ngm:mixed-reality,
        ngm:spatial-audio,
        ngm:virtual-reality ;
    vc:isPartOf ngm:human-computer-interaction,
        ngm:spatial-computing ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:immersive-collaboration,
        ngm:spatial-computing,
        ngm:web-xr ;
    vc:requires ngm:graphics-processing-unit,
        ngm:head-mounted-display,
        ngm:real-time-rendering ;
    vc:slug "immersive-computing" ;
    vc:sourceDomain "spatial-computing" ;
    vc:standardizedBy ngm:khronos-group ;
    vc:uses ngm:3-d-rendering,
        ngm:open-xr,
        ngm:simultaneous-localisation-and-mapping .

ngm:immersive-gaming a owl:Class ;
    rdfs:label "Immersive Gaming"@en ;
    rdfs:comment "Video gaming experiences enhanced through VR, AR, and metaverse technologies that place players within interactive 3D environments, enabling physical interaction, spatial awareness, and presence-based gameplay through advanced headsets, motion tracking, and haptic feedback systems."@en ;
    rdfs:subClassOf ngm:digital-gaming,
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:slug "immersive-gaming" ;
    vc:sourceDomain "spatial-computing" .

ngm:immersive-workspaces a owl:Class ;
    rdfs:label "Immersive Workspaces"@en ;
    rdfs:comment "Immersive workspaces are physical or virtual environments enhanced with spatial and extended-reality technologies—including AR, VR, and mixed reality—that allow users to interact intuitively with digital content and collaborators in three-dimensional space, fostering a strong sense of presence and engagement. They integrate spatial computing principles to support real-time manipulation of data, collaborative visualisation, immersive training, and seamless transitions between physical and digital environments. Immersive workspaces are increasingly deployed across corporate, industrial, and educational settings to support hybrid and remote collaboration at scale."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:augmented-reality ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:spatial-audio ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:virtual-reality ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:haptic-feedback ],
        ngm:metaverse-and-telecollaboration,
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:enables ngm:immersive-learning,
        ngm:remote-collaboration,
        ngm:telepresence ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:augmented-reality,
        ngm:haptic-feedback,
        ngm:spatial-audio,
        ngm:virtual-reality ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:immersive-experience,
        ngm:spatial-computing ;
    vc:slug "immersive-workspaces" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:digital-twin,
        ngm:extended-reality-xr,
        ngm:xr-device .

ngm:imu-sensors a owl:Class ;
    rdfs:label "IMU Sensors"@en ;
    rdfs:comment "An inertial measurement unit (IMU) is a sensor package that measures a body's specific force and angular rate, typically combining a three-axis accelerometer and a three-axis gyroscope, often with a magnetometer. By integrating these measurements it estimates orientation, velocity, and relative motion without external references. IMUs are central to motion tracking, navigation, and stabilisation in robotics, XR, and aerospace."@en ;
    rdfs:subClassOf ngm:sensor ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:motion-capture-rig ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:lens-and-camera-calibration ;
    vc:slug "imu-sensors" ;
    vc:sourceDomain "robotics" .

ngm:in-hand-manipulation a owl:Class ;
    rdfs:label "In Hand Manipulation"@en ;
    rdfs:comment "In-hand manipulation is the robotic skill of repositioning or reorienting a grasped object using the fingers and palm of a hand, without placing it down or relying on the arm to reposition it. It demands coordinated finger control, tactile sensing and contact modelling to maintain stable grasps while controlled slip and finger gaiting move the object. It is a core capability of dexterous manipulation in multi-fingered robotic hands."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:tactile-sensing ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:force-control ],
        ngm:dexterous-manipulation ;
    vc:contrastsWith ngm:compliant-manipulation ;
    vc:dependsOn ngm:grasping,
        ngm:sensorimotor-control ;
    vc:enables ngm:autonomous-manipulation,
        ngm:dexterity ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:finger-gaiting,
        ngm:object-reorientation ;
    vc:isPartOf ngm:dexterous-manipulation ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:multi-fingered-hand,
        ngm:tactile-feedback ;
    vc:requires ngm:force-control,
        ngm:tactile-sensing ;
    vc:slug "in-hand-manipulation" ;
    vc:sourceDomain "robotics" ;
    vc:supports ngm:manipulation-planning ;
    vc:uses ngm:proprioception,
        ngm:robot-hand .

ngm:infiniband a owl:Class ;
    rdfs:label "Infiniband"@en ;
    rdfs:comment "InfiniBand is a high-throughput, low-latency switched-fabric interconnect standard used to connect servers, storage, and accelerators in high-performance computing and large-scale AI training clusters. It provides remote direct memory access (RDMA) that bypasses the operating system kernel, enabling near-wire-speed data movement between nodes. InfiniBand is widely deployed as the backbone fabric for GPU clusters where collective communication bandwidth determines training scalability."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gpu ],
        ngm:artificial-intelligence ;
    skos:broader ngm:artificial-intelligence ;
    vc:bridgesTo ngm:checkpoints ;
    vc:contrastsWith ngm:nvlink ;
    vc:enables ngm:collective-communication,
        ngm:distributed-training,
        ngm:model-parallelism ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:data-parallelism,
        ngm:latency,
        ngm:parallel-processing,
        ngm:throughput ;
    vc:requires ngm:gpu ;
    vc:slug "infiniband" ;
    vc:sourceDomain "ai" ;
    vc:supports ngm:compute-infrastructure,
        ngm:data-centre,
        ngm:high-performance-computing ;
    vc:uses ngm:network-fabric,
        ngm:rdma .

ngm:information-governance a owl:Class ;
    rdfs:label "Information Governance"@en ;
    rdfs:comment "Information Governance is the framework of policies, processes, roles, and standards that organisations use to manage the availability, usability, integrity, and security of their information assets throughout the data lifecycle. It encompasses data stewardship, regulatory compliance, records management, and accountability structures. Effective information governance ensures that data is trustworthy, properly classified, and handled in accordance with legal and business requirements."@en ;
    rdfs:subClassOf ngm:infra-data-management ;
    skos:broader ngm:infra-data-management ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:data-quality ;
    vc:slug "information-governance" ;
    vc:sourceDomain "infrastructure" .

ngm:infrared-camera a owl:Class ;
    rdfs:label "Infrared Camera"@en ;
    rdfs:comment "Imaging devices that capture infrared light wavelengths for VR/AR tracking applications, enabling position tracking, eye tracking, hand gesture recognition, and movement detection in immersive environments through dedicated IR-sensitive sensors and algorithms."@en ;
    rdfs:subClassOf ngm:sc-interaction,
        ngm:tracking-hardware ;
    skos:broader ngm:sc-interaction ;
    vc:enables ngm:motion-tracking ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:slug "infrared-camera" ;
    vc:sourceDomain "spatial-computing" .

ngm:innovation-diffusion a owl:Class ;
    rdfs:label "Innovation Diffusion"@en ;
    rdfs:comment "Innovation diffusion is the process by which a new technology, practice or idea spreads through a population over time. It is studied with adoption curves that describe how successive groups take up an innovation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:technology-adoption ],
        ngm:technology-adoption ;
    vc:enables ngm:agent-based-modelling ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:technology-adoption ;
    vc:slug "innovation-diffusion" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:institutional-design a owl:Class ;
    rdfs:label "Institutional Design"@en ;
    rdfs:comment "Institutional design is the deliberate construction of the rules, roles, and decision-making procedures that structure how a collective coordinates, allocates authority, and resolves disputes. Drawing on economics, political science, and mechanism design, it shapes incentives so that self-interested actors produce outcomes aligned with shared goals. It applies to states, firms, standards bodies, and on-chain organisations alike, where formal rules and enforcement determine legitimacy and durability."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:incentive-alignment ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:regulatory-compliance ],
        ngm:institutional-economics ;
    vc:bridgesTo ngm:strategic-planning ;
    vc:enables ngm:dao,
        ngm:decentralized-governance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:governance-mechanism,
        ngm:incentive-alignment ;
    vc:isPartOf ngm:governance ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:institutional-economics,
        ngm:standards-body,
        ngm:tokenomics ;
    vc:requires ngm:regulatory-compliance ;
    vc:slug "institutional-design" ;
    vc:sourceDomain "governance" ;
    vc:supports ngm:voting-mechanism ;
    vc:uses ngm:mechanism-design .

ngm:institutional-economics a owl:Class ;
    rdfs:label "Institutional Economics"@en ;
    rdfs:comment "A school of economic thought that analyses how formal institutions (laws, regulations, contracts) and informal institutions (norms, customs, culture) shape economic behaviour, incentive structures, and aggregate outcomes. It departs from neoclassical assumptions of frictionless exchange by foregrounding transaction costs, bounded rationality, and the evolutionary path-dependence of rules. The field spans the original institutionalism of Veblen and Commons and the New Institutional Economics (NIE) of Coase, North, and Williamson, which provided micro-foundations for why institutions exist and how they change. Institutional economics informs applied work in development economics, regulatory design, organisational theory, and governance of digital platforms."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:economics ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:bounded-rationality ],
        ngm:economics ;
    vc:bridgesTo ngm:decentralised-autonomous-organisation,
        ngm:platform-governance,
        ngm:smart-contracts ;
    vc:contrastsWith ngm:behavioural-economics,
        ngm:neoclassical-economics ;
    vc:dependsOn ngm:path-dependence,
        ngm:transaction-costs ;
    vc:enables ngm:development-economics,
        ngm:governance,
        ngm:property-rights ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:original-institutionalism,
        ngm:transaction-cost-economics ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:commons-governance,
        ngm:evolutionary-economics,
        ngm:public-choice-theory,
        ngm:social-norms ;
    vc:requires ngm:bounded-rationality,
        ngm:economics ;
    vc:slug "institutional-economics" ;
    vc:sourceDomain "governance" ;
    vc:supports ngm:organisational-theory,
        ngm:political-economy ;
    vc:uses ngm:contract-theory,
        ngm:game-theory,
        ngm:principal-agent-theory .

ngm:integer-programming a owl:Class ;
    rdfs:label "Integer Programming"@en ;
    rdfs:comment "Integer programming is a class of mathematical optimisation in which some or all decision variables are constrained to take integer values, while the objective and constraints are typically linear. The integrality requirement makes these problems NP-hard in general, yet it lets them model discrete decisions such as selection, assignment, and sequencing exactly. Solvers combine the linear-programming relaxation with branch-and-bound and cutting-plane techniques to find provably optimal solutions."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:algorithm ],
        ngm:combinatorial-optimisation ;
    vc:contrastsWith ngm:convex-optimisation ;
    vc:dependsOn ngm:linear-programming ;
    vc:enables ngm:operations-research ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:implements ngm:linear-programming ;
    vc:isPartOf ngm:combinatorial-optimisation ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:algorithm,
        ngm:convex-optimisation,
        ngm:operations-research ;
    vc:requires ngm:algorithm ;
    vc:slug "integer-programming" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:operations-research ;
    vc:uses ngm:constraint-satisfaction,
        ngm:linear-programming .

ngm:intellectual-property a skos:Concept ;
    rdfs:label "Intellectual Property"@en .

ngm:interest-rate-policy a owl:Class ;
    rdfs:label "Interest Rate Policy"@en ;
    rdfs:comment "Interest rate policy is the use of a central bank's control over short-term policy interest rates to steer borrowing costs, credit demand and inflation. By raising or lowering its target rate, the central bank influences money-market rates, lending, investment and consumption throughout the economy. It is the primary monetary-policy instrument in most modern economies, transmitted through the financial system to output and prices."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:interest-rate ],
        ngm:monetary-policy ;
    vc:bridgesTo ngm:liquidity ;
    vc:contrastsWith ngm:quantitative-easing,
        ngm:reserve-requirements ;
    vc:dependsOn ngm:central-banking ;
    vc:enables ngm:inflation-targeting ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:interest-rate ;
    vc:implements ngm:monetary-policy ;
    vc:isPartOf ngm:monetary-policy ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:financial-stability,
        ngm:inflation-targeting,
        ngm:quantitative-easing ;
    vc:requires ngm:central-banking ;
    vc:slug "interest-rate-policy" ;
    vc:sourceDomain "finance" ;
    vc:supports ngm:financial-stability,
        ngm:liquidity ;
    vc:uses ngm:open-market-operations .

ngm:iot-security a owl:Class ;
    rdfs:label "Iot Security"@en ;
    rdfs:comment "IoT security is the discipline of protecting Internet of Things devices, the networks they connect to, and the data they generate and exchange. It addresses the constrained compute, intermittent connectivity, and large attack surface characteristic of embedded sensors and actuators, applying authentication, encryption, secure boot, and lifecycle patch management. Because IoT devices are often physically exposed and deployed at scale, weak credentials and unpatched firmware are recurrent risks that can be conscripted into botnets."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:encryption ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:firmware ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:secure-boot ],
        ngm:network-security ;
    vc:bridgesTo ngm:edge-computing,
        ngm:network-security ;
    vc:contrastsWith ngm:network-security ;
    vc:dependsOn ngm:authentication ;
    vc:enables ngm:data-protection ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:attack-vector,
        ngm:iot-device,
        ngm:threat-model,
        ngm:vulnerability ;
    vc:requires ngm:encryption,
        ngm:firmware,
        ngm:secure-boot ;
    vc:slug "iot-security" ;
    vc:sourceDomain "security" ;
    vc:standardizedBy ngm:iso,
        ngm:standards ;
    vc:supports ngm:incident-response ;
    vc:uses ngm:digital-signature,
        ngm:mqtt,
        ngm:mutual-tls .

ngm:iso-12100 a owl:Class ;
    rdfs:label "ISO 12100"@en ;
    rdfs:comment "ISO 12100 is the foundational international standard for the safety of machinery, setting out general principles for design, risk assessment and risk reduction. It defines a structured methodology in which designers identify hazards, estimate and evaluate risk, then apply inherently safe design, safeguarding and information-for-use in a defined order of priority. As a Type-A standard it provides the overarching framework that more specific Type-B and Type-C machinery standards build upon."@en ;
    rdfs:subClassOf ngm:safety-standard ;
    vc:dependsOn ngm:hazard-analysis,
        ngm:risk-assessment ;
    vc:enables ngm:industrial-robot ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:robot-standard ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:iec-62061,
        ngm:iso-10218,
        ngm:iso-13482,
        ngm:iso-13849,
        ngm:robot-standard ;
    vc:slug "iso-12100" ;
    vc:sourceDomain "robotics" ;
    vc:standardizedBy ngm:iso ;
    vc:supports ngm:ce-marking,
        ngm:conformity-assessment,
        ngm:functional-safety .

ngm:iso-14001 a owl:Class ;
    rdfs:label "ISO 14001"@en ;
    rdfs:comment "ISO 14001 is an international standard, published by the International Organization for Standardization, that specifies the requirements for an environmental management system (EMS). It provides a framework for an organisation to identify, manage, monitor, and continually improve its environmental performance through a plan-do-check-act cycle. Certification against ISO 14001 demonstrates conformance to a recognised set of environmental governance practices and supports regulatory compliance."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:certification ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:audit ],
        ngm:standards ;
    vc:bridgesTo ngm:esg ;
    vc:contrastsWith ngm:iso-9001 ;
    vc:enables ngm:certification ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:governance ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:carbon-footprint,
        ngm:iso-27001,
        ngm:iso-9001 ;
    vc:requires ngm:audit,
        ngm:certification ;
    vc:slug "iso-14001" ;
    vc:sourceDomain "governance" ;
    vc:standardizedBy ngm:iso,
        ngm:standards-body ;
    vc:supports ngm:compliance,
        ngm:environmental-sustainability ;
    vc:uses ngm:environmental-assessment,
        ngm:lifecycle-assessment .

ngm:iso-14040 a owl:Class ;
    rdfs:label "ISO 14040"@en ;
    rdfs:comment "ISO 14040 sets out the principles and framework for life cycle assessment as part of environmental management."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:iso ],
        ngm:technical-standard ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:iso ;
    vc:slug "iso-14040" ;
    vc:sourceDomain "standards" .

ngm:iso-24165 a owl:Class ;
    rdfs:label "ISO 24165"@en ;
    rdfs:comment "ISO 24165 is an international standard specifying the Digital Token Identifier (DTI), a universal system for uniquely identifying digital tokens regardless of the distributed ledger or blockchain platform on which they reside. It defines the structure, syntax, and assignment procedures of the DTI, enabling interoperability across exchanges, regulators, financial institutions, and infrastructure providers. The standard is maintained by the Digital Token Identifier Foundation (DTIF) as the Registration Authority under ISO, and addresses persistent identification needs for cryptocurrencies, stablecoins, tokenised assets, and other on-chain instruments. ISO 24165 complements financial instrument identification standards such as ISIN and FIGI by providing blockchain-native unambiguous references usable in regulatory reporting, settlement, and data aggregation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:token ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:distributed-ledger-technology ],
        ngm:technical-standard ;
    vc:bridgesTo ngm:data-governance,
        ngm:financial-instruments ;
    vc:dependsOn ngm:blockchain,
        ngm:smart-contract ;
    vc:enables ngm:data-aggregation,
        ngm:interoperability,
        ngm:regulatory-reporting ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:registration-authority ;
    vc:implements ngm:unique-identifier ;
    vc:isPartOf ngm:iso ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:asset-tokenisation,
        ngm:decentralised-finance,
        ngm:lei-system ;
    vc:requires ngm:distributed-ledger-technology,
        ngm:token ;
    vc:slug "iso-24165" ;
    vc:sourceDomain "blockchain" ;
    vc:standardizedBy ngm:iso ;
    vc:supports ngm:cryptocurrency,
        ngm:stablecoin,
        ngm:tokenized-asset ;
    vc:uses ngm:cryptographic-hash,
        ngm:namespace .

ngm:iso-42001 a owl:Class ;
    rdfs:label "ISO 42001"@en ;
    rdfs:comment "ISO/IEC 42001 specifies requirements for establishing, implementing, maintaining and continually improving an artificial intelligence management system within an organisation."@en ;
    rdfs:subClassOf ngm:technical-standard ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:slug "iso-42001" ;
    vc:sourceDomain "standards" .

ngm:iso-9283 a owl:Class ;
    rdfs:label "ISO 9283"@en ;
    rdfs:comment "ISO 9283 is an international standard that defines performance criteria and test methods for manipulating industrial robots, specifying how to measure and report pose accuracy, pose repeatability, path accuracy, and path velocity characteristics under controlled conditions. The standard provides a common vocabulary and methodology enabling manufacturers, integrators, and end users to make meaningful, reproducible comparisons of robot performance across different systems and vendors. It covers both Cartesian-space and joint-space metrics and prescribes the environmental and loading conditions under which measurements are to be taken. ISO 9283 is maintained by ISO/TC 299 and is complemented by related standards covering safety, collaborative operation, and application-specific performance."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:benchmarks ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:manipulator ],
        ngm:robot-standard ;
    vc:enables ngm:rb-0034-repeatability,
        ngm:rb-0035-accuracy ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:industrial-robot,
        ngm:iso-10218,
        ngm:iso-ts-15066,
        ngm:performance-benchmarks ;
    vc:requires ngm:benchmarks,
        ngm:manipulator ;
    vc:slug "iso-9283" ;
    vc:sourceDomain "robotics" ;
    vc:standardizedBy ngm:iso .

ngm:iso-iec-23257-2021 a owl:Class ;
    rdfs:label "ISO-IEC 23257 2021"@en ;
    rdfs:comment "ISO/IEC 23257:2021 specifies a reference architecture for blockchain and distributed ledger technology systems, covering concepts, components, roles and the relationships between them."@en ;
