ngm:rdf-xml a owl:Class ;
    rdfs:comment "RDF/XML is the original World Wide Web Consortium serialisation format for the Resource Description Framework, expressing RDF triples as XML documents. It encodes subjects, predicates, and objects using XML elements and attributes, making RDF data parseable by generic XML tooling. Although verbose and historically awkward to read, it remains a standardised interchange format alongside more concise alternatives such as Turtle and JSON-LD."@en ;
    rdfs:label "Rdf Xml"@en ;
    rdfs:subClassOf ngm:rdf ;
    rdfs:subClassOf _:r17674 ;
    rdfs:subClassOf _:r17675 ;
