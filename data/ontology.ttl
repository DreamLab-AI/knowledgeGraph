    a owl:Restriction ;
    owl:onProperty ngm:requires ;
    owl:someValuesFrom mv:TrustMechanism
] .

mv:BarterSystem rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:enables ;
    owl:someValuesFrom mv:PeertoPeerTrading
] .

mv:BarterSystem rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:enables ;
    owl:someValuesFrom mv:AssetExchange
] .

mv:BarterSystem rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:enables ;
    owl:someValuesFrom mv:VirtualEconomy
] .

mv:BarterSystem rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:relatedTo ;
    owl:someValuesFrom mv:DigitalCurrency
] .

mv:BarterSystem rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:relatedTo ;
    owl:someValuesFrom mv:Blockchain
] .

mv:BarterSystem rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:relatedTo ;
    owl:someValuesFrom mv:DecentralizedExchange
] .

# Behavioral Learning
mv:BehavioralLearning a owl:Class ;
    rdfs:subClassOf mv:MachineLearning ;
    rdfs:label "Behavioral Learning"@en ;
    rdfs:comment "An AI-driven approach that analyzes and predicts user behavior patterns from digital interactions including clicks, browsing patterns, movement trajectories, and gaze tracking, enabling automated decision-making and personalized experiences through machine learning and pattern recognition."@en ;
    skos:prefLabel "Behavioral Learning"@en ;
    dcterms:identifier "MV-9795" ;
    dcterms:subject "mv" .

