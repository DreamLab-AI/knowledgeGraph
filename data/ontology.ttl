    vc:uses ngm:access-control,
        ngm:tcp-ip .

ngm:flash-attention a owl:Class ;
    rdfs:label "Flash Attention"@en ;
    rdfs:comment "Flash Attention is an IO-aware, exact attention algorithm that exploits the GPU memory hierarchy by tiling query, key, and value matrices to keep intermediate activations in fast on-chip SRAM rather than the much slower high-bandwidth DRAM (HBM), thereby eliminating the O(N²) memory materialisation of standard scaled dot-product attention. By applying an online softmax recomputation strategy, it achieves bitwise-identical output to vanilla attention while reducing HBM reads and writes proportionally to the SRAM tile size. Originally introduced by Dao et al. in 2022, it has been extended through FlashAttention-2 (improved thread-block partitioning) and FlashAttention-3 (Hopper-native asynchrony and FP8 support), and is now embedded in PyTorch, JAX, vLLM, and virtually every frontier model training pipeline."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cuda ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:transformer-architecture ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gpu-compute ],
        ngm:attention-mechanism ;
    vc:bridgesTo ngm:hardware-accelerator-design ;
    vc:contrastsWith ngm:gradient-checkpointing,
        ngm:linear-attention,
        ngm:sparse-attention ;
    vc:dependsOn ngm:high-bandwidth-memory,
        ngm:model-training ;
    vc:enables ngm:inference,
        ngm:large-language-models,
        ngm:long-context-modelling,
        ngm:multi-head-attention ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:online-softmax,
        ngm:scaled-dot-product-attention ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:memory-bandwidth-optimisation,
        ngm:paged-attention,
        ngm:rotary-position-embedding,
        ngm:tensor-parallelism ;
    vc:requires ngm:cuda,
        ngm:gpu-compute,
        ngm:transformer-architecture ;
    vc:slug "flash-attention" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:continuous-batching,
        ngm:kv-cache,
        ngm:speculative-decoding ;
    vc:uses ngm:kernel-fusion,
        ngm:mixed-precision-training,
        ngm:sram,
        ngm:tiling .

ngm:formal-language a owl:Class ;
    rdfs:label "Formal Language"@en ;
    rdfs:comment "A formal language is a set of strings of symbols drawn from a finite alphabet, defined precisely by formal rules such as a grammar or automaton rather than by usage or convention. The Chomsky hierarchy classifies formal languages by the generative power required to describe them, ranging from regular languages recognised by finite automata to recursively enumerable languages recognised by Turing machines. Formal languages provide the mathematical foundation for specifying syntax in programming languages, parsers, logic, and knowledge representation. They are studied in automata theory and underpin compilers and ontology languages."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:regular-expression ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:automata-theory ],
        ngm:automata-theory ;
    vc:dependsOn ngm:formal-grammar,
        ngm:logic ;
    vc:enables ngm:knowledge-representation,
        ngm:programming-language ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:context-free-grammar,
        ngm:regular-expression ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:computational-linguistics,
        ngm:natural-language-processing,
        ngm:ontology ;
    vc:requires ngm:automata-theory,
        ngm:formal-grammar ;
    vc:slug "formal-language" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:artificial-intelligence ;
    vc:uses ngm:syntax .

ngm:formal-logic a owl:Class ;
    rdfs:label "Formal Logic"@en ;
    rdfs:comment "Formal logic is the study of inference using precisely defined symbolic languages and rules, abstracting valid reasoning patterns from the content of particular arguments. It specifies syntax for well-formed formulae and semantics that assign truth conditions, enabling proofs to be checked mechanically. In artificial intelligence it underpins knowledge representation, automated reasoning and the verification of systems."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:knowledge-representation ],
        ngm:logic ;
    vc:contrastsWith ngm:artificial-intelligence ;
    vc:dependsOn ngm:logic ;
    vc:enables ngm:automated-reasoning,
        ngm:inference ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:implements ngm:ontology ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:knowledge-representation,
        ngm:symbolic-ai ;
    vc:requires ngm:knowledge-representation ;
    vc:slug "formal-logic" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:formal-verification,
        ngm:symbolic-ai ;
    vc:uses ngm:description-logic,
        ngm:reasoning .

ngm:graph-search a owl:Class ;
    rdfs:label "Graph Search"@en ;
    rdfs:comment "Graph search encompasses algorithms that systematically traverse graph-structured state spaces — sets of nodes (states) connected by edges (transitions) — to discover paths, optimal solutions, or reachable configurations satisfying given criteria. Classical uninformed methods (Breadth-First Search, Depth-First Search, Dijkstra) provide completeness and optimality guarantees on finite discrete graphs; informed heuristic methods (A*, IDA*, weighted A*) accelerate search using problem-specific cost estimates; sampling-based planners (RRT, PRM, RRT*) extend graph search to high-dimensional continuous configuration spaces by building implicit graphs from random samples. Graph search is the algorithmic backbone of robot motion planning, AI planning, knowledge graph querying, route navigation, and game-tree evaluation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:search-algorithm ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:breadth-first-search ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:depth-first-search ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:heuristic-function ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-structure ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:dijkstra-algorithm ],
        ngm:graph-algorithms ;
    vc:bridgesTo ngm:graph-neural-network,
        ngm:spatial-index ;
    vc:contrastsWith ngm:evolutionary-algorithm,
        ngm:reinforcement-learning ;
    vc:dependsOn ngm:data-structure,
        ngm:knowledge-representation ;
    vc:enables ngm:game-tree-search,
        ngm:motion-planning,
        ngm:navigation,
        ngm:route-planning ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:breadth-first-search,
        ngm:depth-first-search,
        ngm:dijkstra-algorithm,
        ngm:search-algorithm ;
    vc:isPartOf ngm:combinatorial-optimisation,
        ngm:graph-algorithms ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:monte-carlo-tree-search,
        ngm:satisfiability ;
    vc:requires ngm:data-structure,
        ngm:heuristic-function ;
    vc:slug "graph-search" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:automated-planning,
        ngm:constraint-satisfaction,
        ngm:knowledge-graph ;
    vc:uses ngm:dynamic-programming,
        ngm:heuristic-function,
        ngm:priority-queue .

ngm:hardware-wallet a owl:Class ;
    rdfs:label "Hardware Wallet"@en ;
    rdfs:comment "A hardware wallet is a dedicated physical device that stores cryptocurrency private keys in a secure element and signs transactions internally, so the keys never leave the device or touch an internet-connected computer. It protects against malware and remote key theft by isolating signing operations behind on-device confirmation. Hardware wallets are a foundational tool for self-custody of digital assets."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:private-key ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:secure-element ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:firmware ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:seed-phrase ],
        ngm:infra-security-and-identity ;
    skos:broader ngm:infra-security-and-identity ;
    vc:bridgesTo ngm:cryptographic-key-management,
        ngm:security ;
    vc:contrastsWith ngm:custodial-wallet,
        ngm:hot-wallet,
        ngm:wallet ;
    vc:enables ngm:cold-storage,
        ngm:self-custody,
        ngm:transaction-signing ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:firmware,
        ngm:private-key,
        ngm:secure-element ;
    vc:implements ngm:bip39,
        ngm:bip44,
        ngm:hierarchical-deterministic-wallet ;
    vc:qualityScore "0.73"^^xsd:float ;
    vc:relatedTo ngm:cryptocurrency,
        ngm:decentralized-finance,
        ngm:multi-sig-governance ;
    vc:requires ngm:seed-phrase,
        ngm:usb-interface ;
    vc:slug "hardware-wallet" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:digital-asset,
        ngm:institutional-custody .

ngm:healthcare-ai a owl:Class ;
    rdfs:label "Healthcare AI"@en ;
    rdfs:comment "Healthcare AI is the systematic application of machine learning, natural language processing, computer vision, and large language models to clinical and operational problems in medicine—encompassing diagnostic imaging analysis, clinical decision support, drug discovery, genomic interpretation, patient outcome prediction, and administrative automation. The field operates under stringent regulatory oversight (FDA, MHRA, EU MDR/IVDR) requiring prospective clinical validation, post-market surveillance, and clearly defined human-AI workflow integration to ensure patient safety. Fairness, explainability, and bias auditing are central technical and ethical concerns given the high-stakes nature of clinical decisions, where model underperformance across demographic subgroups can directly harm patients. Federated learning, differential privacy, and synthetic data generation are increasingly adopted to enable model training without centralising sensitive patient records."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:electronic-health-record ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-privacy ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:explainability ],
        ngm:ai-application ;
    skos:broader ngm:ai-application ;
    vc:bridgesTo ngm:digital-twin ;
    vc:contrastsWith ngm:clinical-decision-support,
        ngm:expert-systems ;
    vc:dependsOn ngm:differential-privacy ;
    vc:enables ngm:clinical-decision-support,
        ngm:drug-discovery,
        ngm:patient-risk-stratification,
        ngm:precision-medicine ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:ai-ethics,
        ngm:bias-in-ai,
        ngm:pathology-ai,
        ngm:radiology-ai ;
    vc:requires ngm:data-privacy,
        ngm:electronic-health-record,
        ngm:explainability ;
    vc:slug "healthcare-ai" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:standardizedBy ngm:dicom,
        ngm:hl7-fhir ;
    vc:uses ngm:computer-vision,
        ngm:deep-learning,
        ngm:federated-learning,
        ngm:large-language-models,
        ngm:medical-imaging,
        ngm:natural-language-processing .

ngm:human-robot-collaboration a owl:Class ;
    rdfs:label "Human-Robot Collaboration"@en ;
    rdfs:comment "Human-robot collaboration is the design and operation of robots that work alongside people in a shared workspace, coordinating tasks safely through sensing, control and interaction."@en ;
