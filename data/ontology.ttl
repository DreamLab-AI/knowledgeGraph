ngm:web-standard a owl:Class ;
    rdfs:label "Web Standard"@en ;
    rdfs:comment "Web Standard is a technology infrastructure concept and a type of infrastructure."@en ;
    rdfs:subClassOf ngm:infra-legal-and-regulatory ;
    skos:broader ngm:infra-legal-and-regulatory ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:implements ngm:infrastructure ;
