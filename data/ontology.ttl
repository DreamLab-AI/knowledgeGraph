            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:blockchain-infrastructure ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptographic-keys ],
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:enables ngm:asset-interoperability,
        ngm:cross-chain-asset-transfer,
        ngm:enhanced-token-functionality ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:metadata-mapping,
        ngm:smart-contract,
        ngm:token-standard ;
    vc:isPartOf ngm:asset-tokenization ;
    vc:qualityScore "0.35"^^xsd:float ;
