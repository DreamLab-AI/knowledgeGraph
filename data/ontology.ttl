ngm:schema-versioning a owl:Class ;
    rdfs:comment "Schema versioning is the discipline of managing changes to a data schema over time so that producers and consumers can evolve independently without breaking interoperability. It defines policies and mechanisms — version identifiers, compatibility rules, deprecation windows and migration paths — that govern how additions, removals and modifications to fields and types are introduced. Robust schema versioning underpins reliable data interchange in distributed systems, event streams and long-lived APIs."@en ;
    rdfs:label "Schema Versioning"@en ;
    rdfs:subClassOf ngm:data-versioning ;
    rdfs:subClassOf _:r18829 ;
