    rdfs:label "AI Bill Of Materials"@en .

ngm:ai-board a owl:Class ;
    rdfs:label "AI Board"@en ;
    rdfs:comment "EU Advisory body under Articles 65–67 of the AI Act, composed of one senior representative per Member State and supported by the AI Office as secretariat. Its mandate spans issuing harmonisation guidelines, resolving cross-border jurisdictional conflicts, coordinating joint enforcement actions, and advising the AI Office on GPAI systemic-risk classification and codes-of-practice adequacy."@en ;
    rdfs:subClassOf ngm:ai-governance-and-ethics ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:enables ngm:ai-governance,
        ngm:ai-governance-framework ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:relatedTo ngm:ai-risk-management,
        ngm:general-purpose-ai-model ;
    vc:slug "ai-board" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:ai-office,
        ngm:eu-ai-act-regulatory-instrument .

