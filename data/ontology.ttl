ngm:continuous-improvement a owl:Class ;
    rdfs:label "continuous improvement"@en ;
    rdfs:comment "Continuous improvement is an iterative organisational and engineering philosophy in which processes, products, and systems are systematically and incrementally refined over time through structured cycles of measurement, analysis, experimentation, and implementation, rather than through large-scale periodic overhauls. Rooted in Japanese manufacturing philosophy (kaizen), it was formalised in quality management frameworks including the Plan-Do-Check-Act cycle, ISO 9001, and Lean methodologies, and has since been adopted throughout software engineering via DevOps, agile retrospectives, and MLOps pipelines. The practice relies on feedback loops that surface inefficiencies, defects, or opportunities close to their point of origin, enabling rapid corrective action and cumulative quality gains."@en ;
    rdfs:subClassOf ngm:software-development-process ;
    vc:enables ngm:mlops,
        ngm:software-development ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:feedback-loop,
        ngm:monitoring-system,
        ngm:performance-metrics,
        ngm:quality-assurance ;
    vc:slug "continuous-improvement" ;
    vc:sourceDomain "ai" ;
    vc:supports ngm:ai-deployment ;
    vc:uses ngm:real-time-monitoring .

ngm:control-loop a owl:Class ;
    rdfs:label "Control Loop"@en ;
    rdfs:comment "A control loop is the cyclical process by which a system measures its current state, compares it against a desired set point and applies corrective action to reduce the difference. Closed-loop control uses feedback from sensors to continuously regulate an actuator, while open-loop control acts without such feedback. Control loops are foundational to automation, cyber-physical systems and the reconciliation pattern used in infrastructure orchestration."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:sensor ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:feedback-loop ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:actuator ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:feedback-loop ],
        ngm:control-system ;
    vc:bridgesTo ngm:cyber-physical-systems ;
    vc:dependsOn ngm:feedback-loop ;
    vc:enables ngm:automation,
        ngm:cyber-physical-systems ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:actuator,
        ngm:feedback-loop,
        ngm:sensor ;
    vc:implements ngm:automation,
        ngm:process-control ;
    vc:isPartOf ngm:control-system ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:automation,
        ngm:control-system,
        ngm:cyber-physical-systems,
        ngm:digital-twin ;
    vc:requires ngm:feedback-loop ;
    vc:slug "control-loop" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:actuator,
        ngm:sensor,
        ngm:state-estimation .

ngm:convex-finance a owl:Class ;
    rdfs:label "Convex Finance"@en ;
    rdfs:comment "Convex Finance is a decentralised finance (DeFi) meta-protocol built on Ethereum that enables Curve Finance liquidity providers and CRV holders to earn enhanced rewards without individually locking their own CRV tokens as veCRV. By aggregating vote-escrowed CRV (veCRV) from users who deposit CRV in exchange for cvxCRV, Convex accumulates collective governance and boost power which it redistributes pro-rata to depositors, eliminating the individual capital lockup barrier inherent in Curve's vote-escrow tokenomics. The protocol's native CVX token governs allocation of this aggregated veCRV voting power via vlCVX staking, creating a secondary governance layer — the so-called Curve Wars — in which DeFi protocols competitively bribe CVX holders to direct CRV emissions toward their own liquidity pools."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:smart-contract ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ethereum ],
        ngm:de-fi-protocol ;
    vc:bridgesTo ngm:mechanism-design,
        ngm:on-chain-governance ;
    vc:contrastsWith ngm:aura-finance,
        ngm:concentrated-liquidity,
        ngm:yearn ;
    vc:dependsOn ngm:liquidity-mining,
        ngm:stablecoin ;
    vc:enables ngm:bribe-economy,
        ngm:liquidity-provision,
        ngm:meta-governance,
        ngm:yield-farming,
        ngm:yield-generation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:curve-wars,
        ngm:decentralized-finance-de-fi ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:decentralized-autonomous-organization,
        ngm:frax-finance,
        ngm:total-value-locked ;
    vc:requires ngm:ethereum,
        ngm:smart-contract,
        ngm:vote-escrow-tokenomics ;
    vc:slug "convex-finance" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:automated-market-maker,
        ngm:curve-finance,
        ngm:governance-token,
        ngm:liquidity-pool,
        ngm:token-economics .

ngm:coordination-layer a owl:Class ;
    rdfs:label "Coordination Layer"@en ;
    rdfs:comment "The Coordination Layer is the cross-cutting stratum that orchestrates the work of multiple agents or services toward a shared objective. It sits above control and integration concerns and below the application goals it serves. It contains schedulers, workflow engines, consensus on task assignment, and the protocols that keep distributed actors aligned."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:integration-layer ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:control-layer ],
        ngm:dc-protocol-and-infra ;
    skos:broader ngm:dc-protocol-and-infra ;
    vc:enables ngm:agent-layer,
        ngm:application-layer ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:control-layer,
        ngm:integration-layer ;
    vc:slug "coordination-layer" ;
    vc:sourceDomain "distributed-systems" .

ngm:corporate-tax-compliance-framework a owl:Class ;
    rdfs:label "Corporate Tax Compliance Framework"@en ;
    rdfs:comment "Tax, in the context of this knowledge graph, refers to the statutory obligations imposed on individuals and legal entities — particularly limited companies — by HMRC and comparable revenue authorities, covering corporation tax on trading profits, self-assessment for personal income drawn as salary or dividends, and VAT registration thresholds. Compliance requires accurate bookkeeping, timely filing of CT600 returns, and annual accounts submission to Companies House."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:uk-company-financial-filing-obligations ],
        [ a owl:Restriction ;
