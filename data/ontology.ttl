        ngm:secp256k1 ;
    vc:isPartOf ngm:public-key-cryptography ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:cryptographic-protocol,
        ngm:cryptographic-security,
        ngm:cryptographic-signature,
        ngm:decentralization ;
    vc:requires ngm:discrete-logarithm-problem,
        ngm:finite-field ;
    vc:slug "elliptic-curve-cryptography" ;
    vc:sourceDomain "security" ;
    vc:standardizedBy ngm:ieee-2418-1,
        ngm:nist ;
    vc:supports ngm:transport-layer-security ;
    vc:uses ngm:modular-arithmetic .

ngm:verifiable-credentials a owl:Class ;
    rdfs:label "Verifiable Credentials"@en ;
    rdfs:comment "Cryptographically secured, tamper-evident digital credentials standardised by the W3C Verifiable Credentials Data Model v2.0 (May 2025 REC) that encode machine-verifiable claims about subjects — enabling a holder/issuer/verifier triangle in which issuers sign claims with DIDs, holders selectively..."@en ;
