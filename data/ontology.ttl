ngm:proof-of-work a owl:Class ;
    rdfs:label "Proof Of Work"@en ;
    rdfs:comment "A consensus mechanism requiring network participants to expend significant computational effort solving a cryptographic puzzle before appending a new block to the blockchain. The difficulty of the puzzle self-adjusts to maintain a target block interval, making chain rewriting computationally prohibitive and providing Sybil resistance through physical resource expenditure."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:energy-consumption ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:network-hash-rate ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:block-reward ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:difficulty-adjustment ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:mining-pool ],
        ngm:consensus-protocol ;
    vc:bridgesTo ngm:energy-infrastructure,
        ngm:semiconductor-manufacturing ;
    vc:contrastsWith ngm:proof-of-spacetime,
        ngm:proof-of-stake,
        ngm:proof-of-useful-work ;
    vc:dependsOn ngm:blockchain,
        ngm:peer-to-peer-network ;
    vc:enables ngm:decentralization,
        ngm:distributed-ledger-technology,
        ngm:immutability,
        ngm:transaction-finality ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:block-reward,
        ngm:difficulty-adjustment,
        ngm:mining-pool,
        ngm:network-hash-rate ;
    vc:implements ngm:byzantine-fault-tolerance,
        ngm:sybil-resistance ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:51-percent-attack,
        ngm:blockchain-network,
        ngm:consensus-algorithm,
        ngm:consensus-mechanism,
        ngm:halving,
        ngm:mempool,
        ngm:selfish-mining ;
    vc:requires ngm:energy-consumption,
        ngm:mining-hardware ;
    vc:slug "proof-of-work" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:double-spending-prevention,
        ngm:network-security ;
    vc:uses ngm:asic,
        ngm:cryptographic-hash-function,
        ngm:hash-function,
        ngm:nonce,
        ngm:sha-256 .

ngm:cryptographic-hash-function a owl:Class ;
    rdfs:label "Cryptographic Hash Function"@en ;
    rdfs:comment "A cryptographic hash function is a deterministic, one-way algorithm that maps an input of arbitrary length to a fixed-size digest (typically 160–512 bits), satisfying three core security properties: preimage resistance (infeasibility of recovering input from digest), second-preimage resistance (infeasibility of finding a distinct input that maps to the same digest as a known input), and collision resistance (infeasibility of finding any two distinct inputs that share a digest). These properties make hash functions foundational primitives for data integrity verification, digital signatures, message authentication codes, and proof-of-work consensus. Widely deployed algorithms include SHA-256 (Bitcoin), Keccak-256 (Ethereum), BLAKE2, and SHA-3 (NIST FIPS 202); Grover's algorithm on quantum hardware reduces effective security by half, motivating ongoing standardisation of quantum-resistant alternatives by NIST."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:collision-resistance ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:preimage-resistance ],
        ngm:cryptographic-primitive ;
    vc:bridgesTo ngm:decentralised-identifier,
        ngm:post-quantum-cryptography,
        ngm:verifiable-credential ;
    vc:contrastsWith ngm:checksums,
        ngm:symmetric-encryption ;
    vc:enables ngm:commitment-scheme,
        ngm:digital-signature,
        ngm:merkle-tree,
        ngm:message-authentication-code,
        ngm:proof-of-work,
        ngm:zero-knowledge-proof ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:implements ngm:one-way-function,
        ngm:pseudorandom-function ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:hmac,
        ngm:key-derivation-function ;
    vc:requires ngm:avalanche-effect,
        ngm:collision-resistance,
        ngm:preimage-resistance,
        ngm:second-preimage-resistance ;
    vc:slug "cryptographic-hash-function" ;
    vc:sourceDomain "security" ;
    vc:standardizedBy ngm:ietf,
        ngm:nist ;
    vc:supports ngm:blockchain,
        ngm:content-addressed-storage,
        ngm:password-hashing,
        ngm:public-key-infrastructure ;
    vc:uses ngm:blake2,
        ngm:keccak-256,
        ngm:sha-256,
        ngm:sha-3 .

