ngm:deep-generative-model a owl:Class ;
    rdfs:label "Deep Generative Model"@en ;
    rdfs:comment "A Deep Generative Model is a class of deep neural network trained to learn and approximate the underlying probability distribution of a dataset so that novel, statistically plausible samples can be drawn from it. The principal families — Generative Adversarial Networks (GANs), Variational Autoencoders (VAEs), normalising flows, and diffusion models — differ in how they parameterise and optimise the generative distribution, offering distinct trade-offs among sample fidelity, mode coverage, training stability, and latent-space interpretability. These models underpin modern generative AI capabilities across images, audio, video, text, and structured scientific data such as molecular graphs."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:probabilistic-inference ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:neural-network ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:variational-autoencoder ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:autoregressive-model ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:diffusion-model ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:normalising-flow ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:training-data ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:generative-adversarial-network ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:backpropagation ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:flow-matching ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:neural-network-latent-space ],
        ngm:deep-learning,
        ngm:generative-ai ;
    vc:bridgesTo ngm:governance,
        ngm:privacy-preserving-machine-learning,
        ngm:synthetic-media ;
    vc:contrastsWith ngm:classifier,
        ngm:discriminative-model ;
    vc:enables ngm:audio-synthesis,
        ngm:data-augmentation,
        ngm:drug-discovery,
        ngm:image-generation,
        ngm:model-based-reinforcement-learning,
        ngm:natural-language-generation,
        ngm:synthetic-data,
        ngm:text-to-image,
        ngm:video-generation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:autoregressive-model,
        ngm:diffusion-model,
        ngm:flow-matching,
        ngm:generative-adversarial-network,
        ngm:latent-diffusion-model,
        ngm:normalising-flow,
        ngm:variational-autoencoder ;
    vc:isPartOf ngm:deep-learning,
        ngm:generative-ai ;
    vc:qualityScore "0.9"^^xsd:float ;
    vc:relatedTo ngm:consistency-distillation,
        ngm:density-estimation,
        ngm:flow-matching,
        ngm:foundation-model,
        ngm:large-language-model,
        ngm:representation-learning,
        ngm:score-matching,
        ngm:spatial-computing ;
    vc:requires ngm:backpropagation,
        ngm:neural-network,
        ngm:neural-network-latent-space,
        ngm:probabilistic-inference,
        ngm:training-data ;
    vc:slug "deep-generative-model" ;
    vc:sourceDomain "machine-learning" ;
    vc:uses ngm:attention-mechanism,
        ngm:backpropagation,
        ngm:decoder-network,
        ngm:encoder-decoder-architecture,
