ngm:i-proov a owl:Class ;
    rdfs:label "iProov"@en ;
    rdfs:comment "iProov is a British biometric technology company founded in 2011 that specialises in remote face verification and liveness detection for digital identity assurance. Its core technology, Genuine Presence Assurance, uses controlled illumination sequences to verify that a real, live person is present during an online authentication event, distinguishing genuine users from spoofing attacks using photographs, videos, or synthetic deepfakes. iProov is deployed by governments, financial institutions, and healthcare providers to underpin Know Your Customer (KYC) onboarding, border control systems, and high-assurance remote authentication. The platform integrates with broader identity document verification and identity orchestration frameworks, providing a biometric binding layer within electronic identity (eID) and digital wallet schemes."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:liveness-detection ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:facial-recognition ],
        ngm:biometric-authentication ;
    vc:bridgesTo ngm:deepfake-detection,
        ngm:presentation-attack-detection ;
    vc:contrastsWith ngm:face-id,
        ngm:jumio,
        ngm:onfido ;
    vc:enables ngm:digital-onboarding,
        ngm:identity-verification-system,
        ngm:know-your-customer ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:e-idas,
        ngm:gdpr,
        ngm:iso-30107 ;
    vc:requires ngm:facial-recognition,
        ngm:liveness-detection ;
    vc:slug "i-proov" ;
    vc:sourceDomain "security" ;
    vc:supports ngm:anti-money-laundering,
        ngm:digital-wallet ;
    vc:uses ngm:computer-vision,
        ngm:deep-learning,
        ngm:neural-network .

