vf:silo-ai a owl:Class ;
    rdfs:label "Silo AI"@en ;
    rdfs:comment "Silo AI is a Finnish artificial intelligence company founded in Helsinki in 2017, recognised as Europe's largest private AI lab prior to its acquisition by Advanced Micro Devices (AMD) in August 2024, specialising in end-to-end enterprise AI solutions, multilingual open-source large language model development, and European digital sovereignty through language technology research, having produced the Poro 34B model (2023) — the first major open Finnish/English LLM trained on the LUMI EuroHPC supercomputer — and the Viking model family (7B, 13B, 33B, 2024) covering all Nordic languages (Danish, Finnish, Icelandic, Norwegian, Swedish) and programming languages under the Apache 2.0 licence, training models on up to 4,096 AMD MI250X GPUs with datasets of 1–2 trillion tokens using architectures ranging from BLOOM with ALiBi embeddings (Poro) to Llama-2-style transformer stacks with flash attention, rotary embeddings and grouped query attention (Viking), both produced via the LumiOpen collaboration between Silo AI's SiloGen arm, the University of Turku's TurkuNLP group, and the EU-funded High Performance Language Technologies (HPLT) project, addressing the fundamental challenge of low-res"@en ;
    rdfs:subClassOf vf:agent-frameworks,
        vf:ai-companies,
        vf:anthropic-claude,
        vf:artificial-general-intelligence,
        vf:competition-in-ai ;
    vc:authorityScore "0.87"^^xsd:float ;
    vc:enables vf:ai-adoption,
        vf:ai-scrapers,
        vf:ai-search,
        vf:chatbots,
        vf:cognitive-ai ;
    vc:hasPart vf:agent-frameworks,
        vf:agentic-internet,
        vf:ai-adoption,
        vf:large-language-models ;
    vc:implements vf:algorithmic-bias-and-variance,
        vf:attention,
        vf:bias-in-large-language-models,
        vf:checkpoints ;
    vc:maturity "production-ready" ;
    vc:qualityScore "0.52"^^xsd:float ;
    vc:requires vf:attention,
        vf:checkpoints,
        vf:comfy-ui,
        vf:natural-language-processing ;
    vc:slug "silo-ai" ;
    vc:sourceDomain "artificial-intelligence" .

vf:singularity a owl:Class ;
    rdfs:label "Singularity"@en ;
    rdfs:comment "The Technological Singularity is a hypothesised future point at which artificial intelligence surpasses human cognitive capacity in all economically and strategically relevant domains, triggering a phase transition in civilisational development so rapid and so structurally discontinuous that extrapolation from prior history becomes unreliable. The concept synthesises three distinct but mutually reinforcing intellectual traditions: (1) Vernor Vinge's 1993 essay \"The Coming Technological Singularity,\" which introduced the modern framing by analogy to a mathematical singularity — a point at which the value of a function diverges beyond finite bound — arguing that the creation of entities smarter than human beings would constitute \"the last invention that man need ever make,\" after which human history as a comprehensible narrative would end; (2) I. J. Good's 1965 \"Speculations Concerning the First Ultraintelligent Machine,\" which formalised the notion of an intelligence explosion: if an ultraintelligent machine can design machines smarter than itself, then by induction the smartest machine ever built would rapidly become incomprehensibly superior to humanity, with the survival of the s"@en ;
    rdfs:subClassOf <urn:visionflow:linked:existential-risk>,
        <urn:visionflow:linked:futures-studies>,
        <urn:visionflow:linked:philosophy-of-mind>,
        <urn:visionflow:linked:transhumanism>,
        vf:artificial-general-intelligence ;
    vc:authorityScore "0.87"^^xsd:float ;
    vc:enables <urn:visionflow:linked:intelligence-amplification>,
        <urn:visionflow:linked:mind-uploading>,
        <urn:visionflow:linked:post-scarcity-economics>,
        <urn:visionflow:linked:superintelligence>,
        <urn:visionflow:linked:technological-acceleration> ;
    vc:hasPart <urn:visionflow:linked:agi-timelines>,
        <urn:visionflow:linked:intelligence-amplification>,
        <urn:visionflow:linked:intelligence-explosion>,
        <urn:visionflow:linked:mind-uploading>,
        <urn:visionflow:linked:recursive-self-improvement>,
        <urn:visionflow:linked:superintelligence>,
        <urn:visionflow:linked:takeoff-scenarios> ;
    vc:implements <urn:visionflow:linked:exponential-growth-models>,
        <urn:visionflow:linked:intelligence-explosion>,
        <urn:visionflow:linked:kurzweil-law-of-accelerating-returns>,
        <urn:visionflow:linked:recursive-self-improvement> ;
    vc:maturity "production-ready" ;
    vc:qualityScore "0.52"^^xsd:float ;
    vc:requires <urn:visionflow:linked:recursive-self-improvement>,
        vf:ai-alignment,
        vf:artificial-general-intelligence,
        vf:compute-infrastructure,
