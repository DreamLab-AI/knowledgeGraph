        ngm:supply-chain-transparency ;
    vc:contrastsWith ngm:iso-14067,
        ngm:pas-2060 ;
    vc:enables ngm:carbon-neutral-certification,
        ngm:carbon-offsetting,
        ngm:esg-reporting,
        ngm:science-based-targets ;
    vc:hasMaturity ngmi:maturity-draft ;
