        ngm:schnorr-signature ;
    vc:slug "discreet-log-contracts" ;
    vc:sourceDomain "blockchain" .

ngm:disruptive-technology a owl:Class ;
    rdfs:label "Disruptive Technology"@en ;
    rdfs:comment "Disruptive Technology refers to innovations that initially address simple or underserved applications with more accessible and affordable solutions, then move upmarket to displace established incumbents and redefine entire industries. Following Christensen's framework, disruptive technologies succeed not through direct head-on competition but by creating new value networks and business models that incumbents cannot easily replicate. Contemporary examples include generative AI, blockchain, edge computing, and spatial computing."@en ;
    rdfs:subClassOf ngm:infra-computing-and-cloud ;
    skos:broader ngm:infra-computing-and-cloud ;
    vc:contrastsWith ngm:technology-stack ;
    vc:enables ngm:edge-computing,
        ngm:generative-ai,
        ngm:internet-of-things,
        ngm:machine-learning ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:disruptive-tech-domain ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:blockchain,
        ngm:digital-transformation,
        ngm:disruption,
        ngm:technology-adoption ;
    vc:slug "disruptive-technology" ;
    vc:sourceDomain "infrastructure" .

ngm:distributed-communication a owl:Class ;
    rdfs:label "Distributed Communication"@en ;
    rdfs:comment "Distributed communication is the exchange of messages between processes running on separate machines across a network, forming the substrate of distributed systems. It encompasses paradigms such as remote procedure calls, message queues, publish-subscribe, and streaming, each managing serialisation, addressing, ordering, and failure handling. Middleware abstracts these mechanics so application components can interact reliably despite network partitions and latency."@en ;
    rdfs:subClassOf ngm:distributed-systems ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:middleware,
        ngm:networking-domain ;
    vc:slug "distributed-communication" ;
    vc:sourceDomain "infrastructure" .

ngm:distributed-databases a owl:Class ;
    rdfs:label "Distributed Databases"@en ;
    rdfs:comment "A distributed database stores and manages data across multiple networked nodes, presenting a unified logical database while partitioning and replicating data for scale and resilience. It must reconcile the trade-offs of the CAP theorem, choosing among strong consistency, availability, and partition tolerance through consensus, quorum, or conflict-resolution strategies. It underpins large-scale applications that exceed the capacity or fault-tolerance limits of a single server."@en ;
    rdfs:subClassOf ngm:data-management ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:crdt,
        ngm:distributed-computing ;
    vc:slug "distributed-databases" ;
    vc:sourceDomain "data" .

ngm:distributed-teams a owl:Class ;
    rdfs:label "Distributed Teams"@en ;
    rdfs:comment "Distributed teams are groups of collaborators who work from different geographic locations and often across time zones, coordinating primarily through digital communication and collaboration tools. They rely on asynchronous workflows, shared documentation, and recorded or AI-assisted meetings to maintain alignment without co-location. They have become a dominant model of knowledge work, trading the spontaneity of the office for flexibility and access to a global talent pool."@en ;
    rdfs:subClassOf ngm:dc-communication ;
    skos:broader ngm:dc-communication ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:asynchronous-video,
        ngm:meeting-ai-assistant ;
    vc:slug "distributed-teams" ;
    vc:sourceDomain "infrastructure" .

ngm:documentation-as-code a owl:Class ;
    rdfs:label "Documentation As Code"@en ;
    rdfs:comment "Documentation as Code is a software-engineering practice in which technical documentation is authored in plain-text markup, stored in version control alongside source code, and built and published through the same automated pipelines used for software. It applies developer workflows such as pull requests, code review, linting, and continuous integration to documentation. The approach keeps docs synchronised with code and improves consistency, traceability, and collaboration."@en ;
    rdfs:subClassOf ngm:software-development ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:diagrams-as-code ;
    vc:slug "documentation-as-code" ;
    vc:sourceDomain "infrastructure" .

ngm:domain-model a owl:Class ;
    rdfs:label "Domain Model"@en ;
    rdfs:comment "A Domain Model is a conceptual representation of the entities, attributes, relationships, and rules of a particular problem domain, independent of any specific software implementation. It captures the shared vocabulary and structural constraints that stakeholders agree describe the domain, serving as a blueprint for data schemas, APIs, and system behaviour. Standardised domain models enable interoperability by giving distinct systems a common semantic reference."@en ;
    rdfs:subClassOf ngm:software-architecture ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:data-layer,
        ngm:etsi-metaverse-domain-model ;
    vc:slug "domain-model" ;
    vc:sourceDomain "data" .

ngm:dora a skos:Concept ;
    rdfs:label "Dora"@en .

ngm:drake a owl:Class ;
    rdfs:label "Drake"@en ;
    rdfs:comment "Drake is an open-source C++/Python toolbox for model-based design and verification of robotics systems, originally developed at MIT and maintained by the Toyota Research Institute. It provides rigorous multibody dynamics, kinematics, and optimisation tooling, including analytical gradients, contact modelling, and trajectory optimisation. Drake is widely used for simulating manipulators and mobile robots and for solving collision-detection and motion-planning problems."@en ;
    rdfs:subClassOf ngm:robo-navigation-and-planning ;
    skos:broader ngm:robo-navigation-and-planning ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:collision-detection,
        ngm:kinematics-model ;
    vc:slug "drake" ;
    vc:sourceDomain "robotics" .

ngm:drone-navigation a owl:Class ;
    rdfs:label "Drone Navigation"@en ;
    rdfs:comment "Drone navigation is the set of methods by which unmanned aerial vehicles determine position, plan routes and control flight to reach objectives."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:path-planning ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:inertial-measurement-unit ],
        ngm:mobile-robotics ;
    vc:enables ngm:mapping ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:inertial-measurement-unit,
        ngm:path-planning ;
    vc:slug "drone-navigation" ;
    vc:sourceDomain "robotics" .

ngm:dvc a owl:Class ;
    rdfs:label "DVC"@en ;
    rdfs:comment "DVC (Data Version Control) is an open-source tool that brings Git-style versioning to machine-learning datasets, models, and pipelines. It stores large binary artefacts in external object storage while keeping lightweight metadata pointers in Git, enabling reproducible experiments and shareable data lineage. DVC also defines pipeline stages and tracks model checkpoints so that experiments can be rerun and compared deterministically."@en ;
    rdfs:subClassOf ngm:ai-infrastructure ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:checkpoints ;
    vc:slug "dvc" ;
    vc:sourceDomain "ai" .

ngm:dwpose a owl:Class ;
    rdfs:label "DWPose"@en ;
    rdfs:comment "DWPose is a whole-body 2D human pose estimation model that detects body, hand, face, and foot keypoints with high accuracy using a two-stage distillation approach. It is widely used to generate skeletal conditioning maps for controllable image and video generation. In generative pipelines DWPose output drives spatial-conditioning systems such as ControlNet to constrain pose and gesture."@en ;
    rdfs:subClassOf ngm:computer-vision ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:control-net-and-similar-spatial-conditioning-systems,
        ngm:pose-estimation ;
    vc:slug "dwpose" ;
    vc:sourceDomain "ai" .

ngm:dynamic-pricing a owl:Class ;
    rdfs:label "Dynamic Pricing"@en ;
    rdfs:comment "Dynamic Pricing is a strategy in which the price of a good or service is adjusted in real time based on demand, supply, competitor prices, inventory, and customer signals. It is typically driven by machine-learning models that forecast willingness to pay and optimise revenue or other objectives. Common in e-commerce, ride-hailing, travel, and logistics, it relies on continuous data feeds and automated decisioning."@en ;
    rdfs:subClassOf ngm:ai-application ;
    skos:broader ngm:ai-application ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:hyper-personalisation,
        ngm:logistics-optimization ;
    vc:slug "dynamic-pricing" ;
    vc:sourceDomain "ai" .

ngm:ebsi a owl:Class ;
    rdfs:label "EBSI"@en ;
    rdfs:comment "The European Blockchain Services Infrastructure (EBSI) is a pan-European permissioned blockchain network operated by EU member states and the European Commission to deliver cross-border public services. It anchors verifiable credentials and decentralised identifiers, enabling trusted exchange of diplomas, official documents, and identity attestations between governments. EBSI is a leading example of a public-sector consortium blockchain supporting self-sovereign identity."@en ;
    rdfs:subClassOf ngm:bc-network-component ;
    skos:broader ngm:bc-network-component ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:consortium-blockchain,
        ngm:decentralized-identifiers ;
    vc:slug "ebsi" ;
    vc:sourceDomain "blockchain" .

ngm:ecb-digital-euro-regulation a owl:Class ;
    rdfs:label "ECB Digital Euro Regulation"@en ;
    rdfs:comment "The ECB Digital Euro Regulation is the legal and regulatory framework governing a potential central bank digital currency issued by the European Central Bank for the euro area. It defines the digital euro's legal-tender status, privacy safeguards, holding limits, and the roles of the Eurosystem and intermediaries in distribution. It establishes the rules under which a retail CBDC would operate alongside cash and commercial bank money."@en ;
    rdfs:subClassOf ngm:financial-regulation ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:cbdcs,
        ngm:digital-euro ;
    vc:slug "ecb-digital-euro-regulation" ;
    vc:sourceDomain "blockchain" .

ngm:ecb-digital-euro-regulation-proposal a owl:Class ;
    rdfs:label "ECB Digital Euro Regulation Proposal"@en ;
    rdfs:comment "The ECB Digital Euro Regulation Proposal is the European Commission's draft legislative package, published in 2023, that would establish the legal basis for a digital euro. It sets out proposed rules for legal-tender status, privacy protections, distribution by supervised intermediaries, and offline functionality before adoption by EU co-legislators. As a proposal it frames the policy options and obligations that any future digital-euro framework would codify."@en ;
    rdfs:subClassOf ngm:financial-regulation ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:cbdc-frameworks,
        ngm:digital-euro ;
    vc:slug "ecb-digital-euro-regulation-proposal" ;
    vc:sourceDomain "blockchain" .

ngm:ecodesign-for-sustainable-products-regulation a owl:Class ;
    rdfs:label "Ecodesign For Sustainable Products Regulation"@en ;
    rdfs:comment "The Ecodesign for Sustainable Products Regulation (ESPR) is an EU framework that sets ecodesign requirements to improve the durability, reusability, repairability, and recyclability of products placed on the EU market. It introduces the Digital Product Passport to carry product sustainability and supply-chain data, and bans the destruction of unsold goods in some categories. ESPR is a cornerstone of the EU circular-economy agenda."@en ;
    rdfs:subClassOf ngm:regulatory-compliance ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:circular-economy ;
    vc:slug "ecodesign-for-sustainable-products-regulation" ;
    vc:sourceDomain "supply-chain" .

ngm:econometrics a owl:Class ;
    rdfs:label "Econometrics"@en ;
    rdfs:comment "Econometrics is the application of statistical and mathematical methods to economic data in order to test hypotheses, estimate relationships, and forecast economic phenomena. It combines economic theory with regression analysis, time-series modelling, and causal-inference techniques to quantify effects such as elasticities and policy impacts. Econometrics is foundational to empirical economics and increasingly overlaps with machine learning for prediction."@en ;
    rdfs:subClassOf ngm:economics ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:economics,
        ngm:time-series-forecasting ;
    vc:slug "econometrics" ;
    vc:sourceDomain "data" .

ngm:economic-growth a owl:Class ;
    rdfs:label "Economic Growth"@en ;
    rdfs:comment "Economic Growth is the increase over time in the value of goods and services produced by an economy, typically measured as the rise in real gross domestic product. It is driven by accumulation of capital, growth in the labour force, and improvements in productivity from technology and innovation. Sustained growth is a primary objective of economic policy and a frequently cited benefit of technology adoption."@en ;
    rdfs:subClassOf ngm:economics ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:adoption-of-convergent-technologies,
        ngm:ai-adoption ;
    vc:slug "economic-growth" ;
    vc:sourceDomain "governance" .

ngm:economic-security a owl:Class ;
    rdfs:label "Economic Security"@en ;
    rdfs:comment "Cost of attack vs reward within blockchain systems, providing essential functionality for distributed ledger technology operations and properties."@en ;
    rdfs:subClassOf ngm:bc-defi-and-economics,
        ngm:economic-mechanism ;
    skos:broader ngm:bc-defi-and-economics ;
    vc:enables ngm:blockchain-entity ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:slug "economic-security" ;
    vc:sourceDomain "blockchain" .

ngm:ecosystem-connectivity a owl:Class ;
    rdfs:label "Ecosystem Connectivity"@en ;
    rdfs:comment "Ecosystem Connectivity is the degree to which distinct platforms, services, and participants in a technology ecosystem can discover, interoperate with, and exchange value across one another. It depends on shared standards, compatible interfaces, and gateways that link otherwise siloed systems. High connectivity amplifies network effects and lowers switching and integration costs across the ecosystem."@en ;
    rdfs:subClassOf ngm:sc-standards-and-interop ;
    skos:broader ngm:sc-standards-and-interop ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:compatibility-process,
        ngm:network-effects ;
    vc:slug "ecosystem-connectivity" ;
    vc:sourceDomain "infrastructure" .

ngm:edge-ai-accelerators a owl:Class ;
    rdfs:label "Edge AI Accelerators"@en ;
    rdfs:comment "Edge AI Accelerators are specialised hardware processors — including Neural Processing Units (NPUs), Tensor Processing Units (TPUs), FPGAs, and custom ASICs — designed to execute machine learning inference workloads on resource-constrained edge devices with dramatically higher throughput and energy efficiency than general-purpose CPUs. By exploiting the inherent parallelism of neural network matrix operations and using low-precision arithmetic (INT8, FP16), edge accelerators achieve 5–100x performance gains over CPUs at 10–50x lower power per inference, enabling real-time AI on mobile, embedded, automotive, and IoT platforms without cloud connectivity."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:hardware-acceleration ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:tpu ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:gpu-compute ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:inference ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:npu ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:fpga ],
        ngm:ai-infrastructure ;
    vc:dependsOn ngm:knowledge-distillation-for-edge,
        ngm:model-compression-for-edge ;
    vc:enables ngm:autonomous-vehicle,
        ngm:edge-ai-system,
        ngm:edge-computing,
        ngm:federated-learning ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:fpga,
        ngm:gpu-compute,
        ngm:npu,
        ngm:tpu ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:edge-ai-security,
        ngm:embedded-systems,
        ngm:inference-hardware,
        ngm:neuromorphic-computing ;
    vc:requires ngm:hardware-acceleration,
        ngm:inference ;
    vc:slug "edge-ai-accelerators" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:autonomous-robot,
        ngm:digital-twin ;
    vc:uses ngm:embedded-ai-frameworks,
        ngm:model-pruning-for-edge-deployment .

ngm:edge-ai-security a owl:Class ;
    rdfs:label "Edge AI Security"@en ;
    rdfs:comment "The discipline of protecting machine learning systems deployed on distributed edge devices against adversarial attacks, model theft, data poisoning, physical tampering, and unauthorised access, while respecting the severe resource constraints of embedded and IoT environments. Edge AI Security integrates hardware-level protections (Trusted Execution Environments, secure boot), software hardening (model encryption, differential privacy), and algorithmic defences (certified robustness, Byzantine-robust aggregation) into defence-in-depth architectures."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:adversarial-robustness ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:hardware-security-module ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:federated-learning ],
        ngm:ai-governance-and-ethics ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:contrastsWith ngm:adversarial-attacks ;
    vc:dependsOn ngm:edge-computing,
        ngm:internet-of-things,
        ngm:model-compression-for-edge ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:ai-safety,
        ngm:cybersecurity,
        ngm:privacy-preserving-technology ;
    vc:requires ngm:adversarial-robustness,
        ngm:federated-learning,
        ngm:hardware-security-module ;
    vc:slug "edge-ai-security" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:edge-ai-system .

ngm:edge-mesh-network a owl:Class ;
    rdfs:label "Edge Mesh Network"@en ;
    rdfs:comment "Decentralized interconnection of edge computing nodes providing dynamic load balancing, redundancy, and peer-to-peer communication for distributed workloads."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:load-balancer ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:edge-computing-node ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:routing-protocol ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:network-connectivity ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:service-discovery ],
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:enables ngm:decentralized-computation,
        ngm:dynamic-load-balancing,
        ngm:fault-tolerance,
        ngm:redundant-processing ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:edge-computing-node,
