ngm:mechanical-component a owl:Class ;
    rdfs:label "Mechanical Component"@en ;
    rdfs:comment "MechanicalComponent is the ontological superclass for all physical structural, kinematic, and power-transmission elements constituting robotic hardware systems."@en ;
    rdfs:subClassOf ngm:kinematic-chain,
        ngm:manufacturing-product ;
    vc:enables ngm:backdrivability,
        ngm:force-control,
        ngm:impedance-control,
        ngm:payload-capacity,
        ngm:positional-accuracy,
        ngm:quasi-direct-drive,
        ngm:robot-dynamics,
        ngm:robot-kinematics,
        ngm:series-elastic-actuation ;
    vc:hasPart ngm:actuator,
        ngm:ball-screw,
        ngm:bearing,
        ngm:cable-drive,
        ngm:coupling,
        ngm:cycloidal-drive,
        ngm:end-effector,
        ngm:flexure,
        ngm:harmonic-drive,
        ngm:mounting-interface,
        ngm:planetary-gearbox,
        ngm:sensor-housing,
        ngm:structural-frame,
        ngm:transmission ;
    vc:implements ngm:ball-screw-mechanism,
        ngm:cable-drive,
        ngm:cycloidal-drive,
        ngm:harmonic-drive,
        ngm:planetary-gearbox,
        ngm:quasi-direct-drive,
        ngm:series-elastic-actuation,
        ngm:strain-wave-gearing ;
    vc:maturity "established" ;
    vc:qualityScore "0.52"^^xsd:float ;
    vc:relatedTo ngm:additive-manufacturing,
        ngm:digital-twin,
        ngm:force-sensing,
        ngm:human-robot-interaction,
        ngm:predictive-maintenance,
        ngm:proprioceptive-sensing,
        ngm:robot-design,
        ngm:topology-optimisation ;
    vc:requires ngm:fatigue-analysis,
        ngm:finite-element-analysis,
        ngm:lubrication,
        ngm:manufacturing-process,
        ngm:material-science,
        ngm:surface-finishing,
        ngm:tolerance-stack-analysis,
        ngm:tribology ;
    vc:slug "mechanical-component" ;
    vc:sourceDomain "robotics" ;
    vc:standardizedBy ngm:din-3960-gear-standards,
        ngm:ieee-robotics-standards,
        ngm:iso-10218,
        ngm:iso-281-bearing-life,
        ngm:iso-9283,
        ngm:iso-ts-15066 ;
    vc:supports ngm:collaborative-robots,
        ngm:delta-robot,
        ngm:humanoid-robots,
        ngm:industrial-manipulators,
        ngm:legged-robotics,
        ngm:prosthetics,
        ngm:soft-robotics,
        ngm:space-robotics,
        ngm:surgical-robotics ;
    vc:uses ngm:additive-manufacturing,
        ngm:aluminium-alloy,
        ngm:carbon-fibre-composite,
        ngm:cfrp-laminate,
        ngm:elastomer,
        ngm:piezoelectric-material,
        ngm:shape-memory-alloy,
        ngm:steel-alloy,
        ngm:titanium-alloy .

