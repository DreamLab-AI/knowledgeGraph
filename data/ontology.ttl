ngm:hidden-state a owl:Class ;
    rdfs:label "Hidden State"@en ;
    rdfs:comment "The vector representation of a token or sequence at any layer in a neural network, encoding contextualised information learned by the model. Hidden states are progressively refined through self-attention and feed-forward transformations, with deeper layers capturing increasingly abstract semantic features used in downstream tasks."@en ;
