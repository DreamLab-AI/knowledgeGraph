ngm:quantisation a owl:Class ;
    rdfs:label "Quantisation"@en ;
    rdfs:comment "Quantisation is a model compression technique that reduces the numerical precision of a neural network's weights and activations from high-precision floating-point formats used during training (typically FP32 or BF16) to lower bit-widths such as INT8, INT4, FP8, or binary representations. This precision reduction decreases memory footprint and accelerates matrix operations on hardware with native low-precision arithmetic units, enabling deployment of large models on memory-constrained or power-limited devices with minimal accuracy degradation. The two primary paradigms are post-training quantisation (PTQ), which applies precision reduction after training using a calibration dataset, and quantisation-aware training (QAT), which simulates low-precision arithmetic during the forward pass so the model adapts its weight distributions to minimise quantisation error. Advanced algorithms such as GPTQ, AWQ, and SmoothQuant extend these approaches to very large language models and diffusion models."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:calibration ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:post-training-quantisation ],
        ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:bridgesTo ngm:digital-signal-processing,
        ngm:floating-point-arithmetic ;
    vc:contrastsWith ngm:knowledge-distillation,
        ngm:low-rank-adaptation,
        ngm:pruning ;
    vc:dependsOn ngm:floating-point-arithmetic,
        ngm:hardware-acceleration ;
    vc:enables ngm:edge-ai-accelerator,
        ngm:inference,
        ngm:model-deployment,
        ngm:on-device-ai ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:post-training-quantisation,
        ngm:quantisation-aware-training ;
    vc:isPartOf ngm:mlops,
        ngm:model-compression ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:large-language-model,
        ngm:model-compression-for-edge,
        ngm:neural-architecture-search,
        ngm:speculative-decoding,
        ngm:transformer ;
    vc:requires ngm:calibration ;
    vc:slug "quantisation" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:hardware-acceleration,
        ngm:tensor-decomposition .

ngm:regularisation a owl:Class ;
    rdfs:label "Regularisation"@en ;
    rdfs:comment "A family of techniques that constrain or penalise model complexity during training to prevent overfitting and improve generalisation to unseen data. Common methods include L1 (Lasso) and L2 (Ridge) weight penalties, dropout, early stopping, and data augmentation, each discouraging the model from memorising noise at the expense of learning underlying patterns."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:dropout ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:loss-function ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:early-stopping ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:hyperparameter-tuning ],
        ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:bridgesTo ngm:bayesian-inference,
        ngm:explainable-ai ;
    vc:contrastsWith ngm:overfitting,
        ngm:underfitting ;
    vc:dependsOn ngm:cross-validation,
        ngm:gradient-descent ;
    vc:enables ngm:deep-learning,
        ngm:generalisation,
        ngm:model-robustness ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:dropout,
        ngm:early-stopping ;
    vc:isPartOf ngm:model-training ;
    vc:qualityScore "0.68"^^xsd:float ;
    vc:relatedTo ngm:bias-variance-tradeoff,
        ngm:model-complexity,
        ngm:training ;
    vc:requires ngm:hyperparameter-tuning,
        ngm:loss-function ;
    vc:slug "regularisation" ;
    vc:sourceDomain "machine-learning" ;
    vc:supports ngm:feature-selection,
        ngm:model-training ;
    vc:uses ngm:weight-decay .

ngm:settlement a owl:Class ;
    rdfs:label "Settlement"@en ;
    rdfs:comment "Settlement is the final, legally binding transfer of an asset or funds from one party to another that extinguishes the obligation arising from a trade, payment, or contract. In traditional financial markets, settlement follows trade execution after a defined delay (e.g. T+2) during which counterparty risk persists; in distributed ledger systems, settlement occurs when a transaction achieves irreversible confirmation according to the network's consensus rules. Achieving settlement finality is the core objective of payment and securities clearing infrastructure, as it determines when legal title definitively passes and operational risk is eliminated. The shift towards real-time gross settlement (RTGS), delivery-versus-payment (DvP), and atomic settlement on distributed ledgers represents a decades-long effort to compress settlement latency and reduce systemic risk."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:clearing ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:settlement-finality ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:liquidity ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:delivery-versus-payment ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:risk-management ],
        ngm:financial-infrastructure ;
    vc:bridgesTo ngm:central-bank-digital-currency,
        ngm:distributed-ledger-technology,
        ngm:smart-contract ;
    vc:contrastsWith ngm:clearing,
        ngm:trade-execution ;
    vc:dependsOn ngm:central-bank,
        ngm:central-securities-depository,
        ngm:payment-system ;
    vc:enables ngm:atomic-settlement,
