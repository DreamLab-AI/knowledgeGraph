        ngm:identity-management ;
    vc:slug "ai-governance-framework" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:conformity-assessment a owl:Class ;
    rdfs:label "Conformity Assessment"@en ;
    rdfs:comment "Conformity Assessment is a structured set of procedures used to determine whether a product, system, service, or process meets specified requirements defined in regulations, standards, or contractual obligations. In the context of AI and digital systems, it encompasses technical documentation review, testing, auditing, risk analysis, and post-market surveillance carried out either by the developer as a self-assessment or by an accredited third-party notified body. Under frameworks such as the EU AI Act, ISO/IEC 17000-series standards, and NIST guidelines, the conformity declaration produced is a legal and operational precondition for market entry and continued deployment. It inherits procedural principles from product safety certification while adapting them to the probabilistic, data-dependent, and emergent behaviour of machine learning systems."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:technical-documentation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:risk-assessment ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:auditability ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:transparency ],
        ngm:ai-governance-and-ethics ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:bridgesTo ngm:federated-learning,
        ngm:model-cards ;
    vc:contrastsWith ngm:self-certification,
        ngm:voluntary-disclosure ;
    vc:dependsOn ngm:data-governance,
        ngm:market-surveillance ;
    vc:enables ngm:market-access,
        ngm:regulatory-compliance,
        ngm:trustworthy-ai ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:eu-ai-act-regulatory-instrument,
        ngm:nist-ai-rmf ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:certification ;
    vc:requires ngm:auditability,
        ngm:risk-assessment,
        ngm:technical-documentation,
        ngm:transparency ;
    vc:slug "conformity-assessment" ;
    vc:sourceDomain "governance" ;
    vc:standardizedBy ngm:etsi,
        ngm:iso-iec-jtc1-sc42,
        ngm:nist ;
    vc:supports ngm:ai-regulation,
        ngm:ai-safety,
        ngm:consumer-protection ;
    vc:uses ngm:explainability,
        ngm:model-evaluation,
        ngm:robustness-testing .

ngm:consensus a owl:Class ;
    rdfs:label "Consensus"@en ;
    rdfs:comment "The general problem of getting distributed processes to agree on a common value or decision despite failures, communication delays or adversarial behaviour."@en ;
