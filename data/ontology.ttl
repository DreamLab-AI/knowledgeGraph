    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:ai-alignment,
        ngm:reinforcement-learning-from-human-feedback ;
    vc:requires ngm:agent-memory,
        ngm:function-calling,
        ngm:sandboxed-code-execution ;
    vc:slug "llm-agents" ;
    vc:sourceDomain "ai" ;
    vc:supports ngm:ai-safety,
        ngm:human-in-the-loop ;
    vc:uses ngm:chain-of-thought-prompting,
        ngm:context-window,
        ngm:large-language-models,
        ngm:retrieval-augmented-generation,
        ngm:tool-use,
        ngm:vector-database .

ngm:log-replication a owl:Class ;
    rdfs:label "Log Replication"@en ;
    rdfs:comment "Log replication is the mechanism by which an ordered, append-only sequence of commands is copied consistently across the nodes of a distributed system so that each replica can apply the same operations in the same order. In leader-based consensus protocols such as Raft, the leader appends client commands to its log and replicates entries to followers, committing an entry once a quorum has durably stored it. By ensuring every replica converges on an identical log, it is the substrate for state machine replication and strong consistency. It must handle leader failover, log divergence, and consistency checks to keep replicas in agreement."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:leader-election ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:leader-election ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:quorum ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:distributed-consensus ],
        ngm:replication ;
    vc:enables ngm:fault-tolerance,
        ngm:linearizability ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:leader-election,
        ngm:quorum ;
    vc:implements ngm:consensus-algorithm,
        ngm:state-machine-replication ;
    vc:isPartOf ngm:raft ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:consistency-model,
        ngm:distributed-systems ;
    vc:requires ngm:distributed-consensus,
        ngm:leader-election ;
    vc:slug "log-replication" ;
    vc:sourceDomain "distributed-systems" ;
    vc:uses ngm:paxos,
        ngm:raft .

ngm:lossless-compression a owl:Class ;
    rdfs:label "Lossless Compression"@en ;
    rdfs:comment "Lossless compression is a class of data compression in which the original data can be reconstructed exactly, bit for bit, from the compressed representation. It exploits statistical redundancy through techniques such as entropy coding and dictionary substitution, contrasting with lossy compression which discards perceptually insignificant information for higher ratios. It is essential where fidelity must be preserved, such as for text, executables, and archival data."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-quality ],
        ngm:data-compression ;
    vc:contrastsWith ngm:lossy-compression ;
    vc:dependsOn ngm:information-theory ;
    vc:enables ngm:backup,
        ngm:file-format ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:codec ;
    vc:implements ngm:data-compression ;
    vc:isPartOf ngm:data-compression ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:image-compression,
        ngm:video-compression ;
    vc:requires ngm:data-quality ;
    vc:slug "lossless-compression" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:data-storage,
        ngm:data-warehouse ;
    vc:uses ngm:entropy-coding,
        ngm:information-theory .

