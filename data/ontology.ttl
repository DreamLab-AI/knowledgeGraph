    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:w3-c ;
    vc:slug "w-3-c-web-xr" ;
    vc:sourceDomain "standards" .

ngm:w3-c-web-speech-api a owl:Class ;
    rdfs:label "W3C Web Speech API"@en ;
    rdfs:comment "The W3C Web Speech API is a browser interface specification that exposes speech recognition (speech-to-text) and speech synthesis (text-to-speech) to web applications through standardised JavaScript objects. It lets pages capture spoken input and produce spoken output without bespoke plugins, underpinning voice-driven and accessibility features on the web. Implementation depth and recognition backends vary across browsers, with some delegating recognition to cloud services."@en ;
    rdfs:subClassOf ngm:technical-standard ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:real-time-translation,
        ngm:speech-and-voice ;
    vc:slug "w3-c-web-speech-api" ;
    vc:sourceDomain "metaverse" .

ngm:w3c-recommendation a owl:Class ;
    rdfs:label "W3C Recommendation"@en ;
    rdfs:comment "A W3C Recommendation is the final, ratified stage of a technical specification produced by the World Wide Web Consortium, signifying that the document has completed the consortium's review process and is endorsed for broad deployment. It carries the strongest standing in the W3C Recommendation Track, having passed through Working Draft, Candidate Recommendation and Proposed Recommendation maturity levels. Many web security and identity specifications, such as WebAuthn and Verifiable Credentials, are published as W3C Recommendations."@en ;
    rdfs:subClassOf ngm:web-standard ;
    vc:bridgesTo ngm:json-ld ;
    vc:contrastsWith ngm:open-standards ;
    vc:enables ngm:decentralised-identifiers ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:implements ngm:specification ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:specification,
        ngm:user-interface-standard ;
    vc:slug "w3c-recommendation" ;
    vc:sourceDomain "security" ;
    vc:standardizedBy ngm:standards-documentation ;
    vc:supports ngm:verifiable-credentials,
        ngm:web-authn ;
    vc:uses ngm:specification .

