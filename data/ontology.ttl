        ngm:machine-learning-infrastructure ;
    vc:uses ngm:auto-ml,
        ngm:data-pipeline .

ngm:ai-user a owl:Class ;
    rdfs:label "AI User"@en ;
    rdfs:comment "An individual or entity who interacts with, relies upon, or is affected by the outputs, decisions, or recommendations of an AI system in order to accomplish tasks, obtain services, or achieve objectives—either through direct interaction or indirect exposure to AI-mediated decisions. AI users are the primary experiencers of AI benefits and harms, encompassing diverse populations with varying technical literacy, accessibility needs, and degrees of voluntary engagement, making their rights and interests central to responsible AI governance."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:explainability ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:fairness ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:human-oversight ],
        ngm:ai-governance-and-ethics ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:dependsOn ngm:eu-ai-act,
        ngm:responsible-ai ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:relatedTo ngm:accountability,
        ngm:ai-operator,
        ngm:ai-provider ;
    vc:requires ngm:explainability,
        ngm:fairness,
        ngm:human-oversight ;
    vc:slug "ai-user" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:algorand a owl:Class ;
    rdfs:label "Algorand"@en ;
    rdfs:comment "Algorand is a permissionless, pure proof-of-stake Layer 1 blockchain protocol designed by MIT cryptographer Silvio Micali, providing instant transaction finality, high throughput, and carbon-negative operation through a cryptographically random committee-selection consensus mechanism. It resolves the blockchain trilemma of security, scalability, and decentralisation without forks by ensuring all confirmed blocks are final. The Algorand Virtual Machine (AVM) supports smart contract execution in TEAL bytecode and, via ARC standards, enables NFTs, DeFi, and tokenised assets at scale."@en ;
    rdfs:subClassOf ngm:blockchain-protocol ;
    vc:enables ngm:asset-tokenization,
        ngm:decentralized-application,
        ngm:smart-contract ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:blockchain-scalability,
        ngm:financial-technology ;
    vc:slug "algorand" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:consensus-mechanism,
        ngm:pure-proof-of-stake,
        ngm:verifiable-random-function .

ngm:application-layer a owl:Class ;
    rdfs:label "Application Layer"@en ;
    rdfs:comment "Software layer providing domain-specific application interfaces and services for metaverse experiences including education, commerce, healthcare, and entertainment applications."@en ;
