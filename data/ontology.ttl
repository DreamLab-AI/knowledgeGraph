ngm:physical-layer a owl:Class ;
    rdfs:label "Physical Layer"@en ;
    rdfs:comment "The Physical Layer (OSI Layer 1) is the foundational stratum of the Open Systems Interconnection reference model defined in ISO/IEC 7498-1 and ITU-T X.200, responsible for raw transmission and reception of unstructured bit streams over a physical communication medium."@en ;
