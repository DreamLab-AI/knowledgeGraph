ngm:federated-social-networks a owl:Class ;
    rdfs:label "Federated Social Networks"@en ;
    rdfs:comment "Federated social networks are distributed communication platforms composed of independently operated servers that interoperate via shared open protocols, allowing users on different instances to follow, mention, and exchange content across administrative boundaries without centralised ownership. The model contrasts with siloed proprietary networks by enabling user data portability, operator sovereignty, and community-driven moderation policies."@en ;
    rdfs:subClassOf ngm:distributed-systems ;
    vc:contrastsWith ngm:social-network-graph ;
    vc:enables ngm:data-privacy,
        ngm:social-network-analysis ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:decentralised-identity,
        ngm:interoperability-standard ;
    vc:slug "federated-social-networks" ;
    vc:sourceDomain "web" ;
    vc:uses ngm:activity-pub,
        ngm:distributed-system-protocol .

ngm:feedforward-control a owl:Class ;
    rdfs:label "Feedforward Control"@en ;
    rdfs:comment "Feedforward control is a control strategy in which the controller acts on a reference command or a measured disturbance before it affects the output, rather than reacting to output error after the fact. Because it does not rely on output measurement, pure feedforward cannot correct for unmodelled effects and is therefore usually paired with feedback. It is widely used in motion and process control to improve command tracking and pre-empt known disturbances."@en ;
    rdfs:subClassOf ngm:control-system ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:motion-control,
        ngm:velocity-control ;
    vc:slug "feedforward-control" ;
    vc:sourceDomain "robotics" .

ngm:few-shot-examples a owl:Class ;
    rdfs:label "Few-Shot Examples"@en ;
    rdfs:comment "Few-shot examples are a small set of input-output demonstrations placed within a language model's prompt to illustrate the desired task, format, or reasoning pattern. By conditioning on these in-context examples, the model can perform the task without weight updates, leveraging in-context learning. The number, quality, ordering, and representativeness of the examples strongly influence output accuracy and consistency."@en ;
    rdfs:subClassOf ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:context-engineering,
        ngm:few-shot-prompting ;
    vc:slug "few-shot-examples" ;
    vc:sourceDomain "ai" .

ngm:few-shot-learning a owl:Class ;
    rdfs:label "Few-Shot Learning"@en ;
    rdfs:comment "A learning setting in which a model is required to generalise to a new task or class from only a small number of labelled examples."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:meta-learning ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:transfer-learning ],
        ngm:machine-learning ;
    vc:enables ngm:in-context-learning ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:meta-learning,
        ngm:transfer-learning ;
    vc:slug "few-shot-learning" ;
    vc:sourceDomain "machine-learning" .

ngm:fig-jam a owl:Class ;
    rdfs:label "FigJam"@en ;
    rdfs:comment "FigJam is an online collaborative whiteboard application from Figma designed for real-time ideation, brainstorming, diagramming, and workshop facilitation. It provides multi-user infinite canvases with sticky notes, shapes, connectors, stamps, and templates, synchronising edits across participants for distributed teams. FigJam complements Figma's design tooling by focusing on the early, divergent phases of product and design work."@en ;
    rdfs:subClassOf ngm:dc-workspace-tools ;
    skos:broader ngm:dc-workspace-tools ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:collaborative-whiteboard,
        ngm:figma ;
    vc:slug "fig-jam" ;
    vc:sourceDomain "metaverse" .

ngm:figma a owl:Class ;
    rdfs:label "Figma"@en ;
    rdfs:comment "Figma is a browser-based collaborative interface-design and prototyping platform that lets multiple designers work simultaneously on the same files in real time. It provides vector editing, component and design-system management, interactive prototyping, and developer hand-off, all stored in the cloud for seamless multiplayer collaboration. Figma has become a standard tool for UI/UX design and cross-functional product teams."@en ;
    rdfs:subClassOf ngm:dc-workspace-tools ;
    skos:broader ngm:dc-workspace-tools ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:collaborative-whiteboard,
        ngm:fig-jam ;
    vc:slug "figma" ;
    vc:sourceDomain "metaverse" .

ngm:fin-cen a owl:Class ;
    rdfs:label "FinCEN"@en ;
    rdfs:comment "The Financial Crimes Enforcement Network (FinCEN) is a bureau of the US Department of the Treasury established in 1990 that serves as the primary US financial intelligence unit (FIU). FinCEN administers the Bank Secrecy Act (BSA), collects financial transaction reports from financial institutions (SARs, CTRs), analyses this data for patterns of money laundering, terrorist financing, and financial fraud, and shares intelligence with law enforcement and foreign FIUs through the Egmont Group. FinCEN also issues regulatory guidance and rulemaking for digital asset service providers including money service businesses (MSBs) and, since 2019, cryptocurrency exchanges."@en ;
    rdfs:subClassOf ngm:regulatory-framework ;
    vc:enables ngm:aml-kyc-compliance,
        ngm:anti-money-laundering,
        ngm:sanctions-enforcement ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:blockchain-compliance,
        ngm:financial-regulation,
        ngm:sanctions-screening,
        ngm:us-regulatory-framework ;
    vc:slug "fin-cen" ;
    vc:sourceDomain "finance" ;
    vc:uses ngm:compliance-audit-trail,
        ngm:compliance-framework .

ngm:fixed-supply-token a owl:Class ;
    rdfs:label "Fixed Supply Token"@en ;
    rdfs:comment "A Fixed Supply Token is a fungible blockchain token whose total issuance is capped at a hard-coded maximum that the protocol cannot exceed, regardless of future governance decisions. Distribution of the supply over time is governed by a predetermined emission schedule, and no additional tokens can be minted once the cap is reached, conferring deflationary scarcity properties analogous to precious metals."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:total-supply ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:emission-schedule ],
        ngm:bc-token-and-asset,
        ngm:fungible-token ;
    skos:broader ngm:bc-token-and-asset ;
    vc:contrastsWith ngm:deflationary-token,
        ngm:inflationary-token ;
    vc:enables ngm:burning-mechanism ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:emission-schedule,
        ngm:total-supply ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:circulating-supply,
        ngm:halving,
        ngm:market-capitalization,
        ngm:token-economics,
        ngm:tokenomics ;
    vc:slug "fixed-supply-token" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:blockchain-protocol .

ngm:fog-computing a owl:Class ;
    rdfs:label "Fog Computing"@en ;
    rdfs:comment "Fog computing is a distributed architecture that places compute, storage, and networking resources in an intermediate tier between end devices and the cloud, typically in gateways, routers, and local servers near the data source. It extends cloud capabilities toward the network edge to reduce latency, conserve bandwidth, and improve resilience and privacy for geographically dispersed Internet-of-Things deployments. Distinct from edge computing's focus on the device itself, fog computing emphasises a coordinated, hierarchical layer of regional nodes orchestrating many edges."@en ;
    rdfs:subClassOf ngm:distributed-computing ;
    vc:enables ngm:low-latency-computing ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:cloud-computing ;
    vc:slug "fog-computing" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:edge-computing .

ngm:forensic-investigation a owl:Class ;
    rdfs:label "Forensic Investigation"@en ;
    rdfs:comment "Forensic investigation is the systematic collection, preservation, examination, and analysis of evidence — digital, physical, or financial — using scientifically validated methods that maintain legal admissibility and chain of custody, with the purpose of reconstructing events, attributing responsibility, and supporting judicial or regulatory proceedings. In digital contexts it encompasses disk imaging, memory acquisition, network traffic analysis, and log correlation."@en ;
    rdfs:subClassOf ngm:digital-forensics ;
    vc:enables ngm:compliance,
        ngm:incident-response ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:digital-evidence-chain-of-custody,
        ngm:digital-forensics-framework ;
    vc:slug "forensic-investigation" ;
    vc:sourceDomain "security" ;
    vc:supports ngm:red-teaming ;
    vc:uses ngm:chain-of-custody,
        ngm:evidence-collection .

ngm:formal-specification a owl:Class ;
    rdfs:label "Formal Specification"@en ;
    rdfs:comment "A formal specification is a precise, mathematically grounded description of the intended behaviour or structure of a system, written in a language with well-defined syntax and semantics. It allows properties of the system to be stated unambiguously and reasoned about or verified mechanically. Formal specifications underpin formal methods, model checking, and the construction of provably correct software and ontologies."@en ;
    rdfs:subClassOf ngm:infra-software-engineering ;
    skos:broader ngm:infra-software-engineering ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:domain-ontology,
        ngm:formal-methods-domain ;
    vc:slug "formal-specification" ;
    vc:sourceDomain "infrastructure" .

ngm:format-parser a owl:Class ;
    rdfs:label "Format Parser"@en ;
    rdfs:comment "Software components that interpret and convert various 3D asset file formats into internal representations for metaverse platforms, enabling interoperability between content creation tools and runtime environments whilst preserving geometry, materials, animations, and metadata."@en ;
    rdfs:subClassOf ngm:data-processing,
        ngm:sc-standards-and-interop ;
    skos:broader ngm:sc-standards-and-interop ;
    vc:enables ngm:cross-platform-content ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:slug "format-parser" ;
    vc:sourceDomain "spatial-computing" .

ngm:frontier-model-training a owl:Class ;
    rdfs:label "Frontier Model Training"@en ;
    rdfs:comment "Frontier model training refers to the end-to-end process of constructing the largest and most capable AI systems at the current performance frontier, encompassing data curation at web scale, distributed pretraining across thousands of accelerators, supervised fine-tuning, and reinforcement learning from human feedback, at compute costs exceeding tens of millions of US dollars per run. These training pipelines push the boundaries of achievable capability and introduce novel safety, governance, and infrastructure challenges not present in smaller-scale model development."@en ;
    rdfs:subClassOf ngm:large-language-model-training ;
    vc:dependsOn ngm:model-training ;
    vc:enables ngm:frontier-models,
        ngm:model-evaluation ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:benchmarks,
        ngm:machine-learning-infrastructure ;
    vc:slug "frontier-model-training" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:distributed-training,
        ngm:gpu-computing,
        ngm:reinforcement-learning-from-human-feedback .

ngm:fsb a owl:Class ;
    rdfs:label "FSB"@en ;
    rdfs:comment "The Financial Stability Board, an international body that monitors the global financial system and makes recommendations to promote financial stability."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:financial-regulation ],
        ngm:financial-regulation ;
    vc:enables ngm:financial-stability ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:financial-regulation ;
    vc:slug "fsb" ;
    vc:sourceDomain "governance" .

ngm:full-fine-tuning a owl:Class ;
    rdfs:label "Full Fine Tuning"@en ;
    rdfs:comment "A fine-tuning approach that updates all parameters of a pre-trained model during adaptation to a downstream task, requiring approximately four times the model's memory footprint to store weights, gradients, and optimiser states. Full fine-tuning provides maximum task-specific flexibility and sets the performance ceiling against which parameter-efficient alternatives such as LoRA are benchmarked, but creates a separate full-sized model copy per task."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:transfer-learning ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:large-language-models ],
        ngm:ai-technique,
        ngm:fine-tuning ;
    skos:broader ngm:ai-technique ;
    vc:contrastsWith ngm:continued-pre-training ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:early-stopping,
        ngm:overfitting ;
    vc:requires ngm:large-language-models,
        ngm:transfer-learning ;
    vc:slug "full-fine-tuning" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:deep-learning,
        ngm:gradient-descent .

ngm:futarchy a owl:Class ;
    rdfs:label "Futarchy"@en ;
    rdfs:comment "Futarchy is a governance mechanism proposed by economist Robin Hanson in which policy decisions are made by first defining measurable societal welfare metrics and then adopting whichever policy candidate is predicted by speculative prediction markets to maximise those metrics. Under futarchy, democratic institutions vote on the values or welfare criteria to optimise, while market prices — which aggregate information from many participants through financial incentives — determine the means by which those values are pursued, on the premise that markets are better information aggregators than committees for empirical questions about causal consequences."@en ;
    rdfs:subClassOf ngm:voting-mechanism ;
    vc:enables ngm:dao-governance,
        ngm:decentralized-governance,
        ngm:transparent-decision-making ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:conviction-voting,
        ngm:quadratic-voting ;
    vc:slug "futarchy" ;
    vc:sourceDomain "governance" ;
    vc:uses ngm:collective-decision-making,
        ngm:mechanism-design,
        ngm:on-chain-voting .

ngm:game-asset-generation a owl:Class ;
    rdfs:label "Game Asset Generation"@en ;
    rdfs:comment "Game asset generation is the automated or semi-automated production of digital resources — including 3D meshes, textures, animations, sound effects, and narrative content — used in interactive entertainment, employing procedural algorithms, machine learning models, or generative AI to reduce manual authoring costs, accelerate iteration cycles, and enable content scale impossible through purely human workflows."@en ;
    rdfs:subClassOf ngm:procedural-content-generation ;
    vc:dependsOn ngm:procedural-generation ;
    vc:enables ngm:asset-pipeline,
        ngm:game-engine ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:3-d-asset,
        ngm:text-to-image-generation ;
    vc:slug "game-asset-generation" ;
    vc:sourceDomain "media" ;
    vc:uses ngm:3-d-modeling,
        ngm:generative-model,
        ngm:texture-mapping .

ngm:gan a owl:Class ;
    rdfs:label "GAN"@en ;
    rdfs:comment "Generative adversarial network: a generative model in which a generator and a discriminator are trained in opposition, the generator producing samples and the discriminator distinguishing real from generated data."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:backpropagation ],
        ngm:generative-adversarial-network ;
    vc:enables ngm:image-generation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:backpropagation ;
    vc:slug "gan" ;
    vc:sourceDomain "deep-learning" .

ngm:gas-mechanism a owl:Class ;
    rdfs:label "Gas Mechanism"@en ;
    rdfs:comment "The system in a blockchain such as Ethereum that meters and prices computation, requiring users to pay fees denominated in units of gas for the operations their transactions perform. It limits resource use and prioritises transactions."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ethereum-virtual-machine ],
        ngm:ethereum ;
    vc:enables ngm:smart-contract ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:ethereum-virtual-machine ;
    vc:slug "gas-mechanism" ;
    vc:sourceDomain "blockchain" .

ngm:generative-ai-engineering a owl:Class ;
    rdfs:label "Generative AI Engineering"@en ;
    rdfs:comment "Generative AI Engineering is the applied discipline concerned with designing, developing, fine-tuning, and deploying generative AI systems—such as large language models, diffusion models, and multimodal transformer architectures—to create novel artefacts including text, images, audio, code, and synthetic data. It encompasses the full engineering lifecycle from model selection and prompt engineering through retrieval-augmented generation, evaluation, and production observability. The field bridges machine learning research and software engineering, requiring competence in model architecture, infrastructure, and responsible AI practices."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ai-infrastructure ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:fine-tuning ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:synthetic-data-generation ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:retrieval-augmented-generation ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:prompt-engineering ],
        ngm:ai-application ;
    skos:broader ngm:ai-application ;
    vc:enables ngm:autonomous-ai-agents,
        ngm:workflow-automation ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:fine-tuning,
        ngm:prompt-engineering,
        ngm:retrieval-augmented-generation,
        ngm:synthetic-data-generation ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:generative-ai,
        ngm:natural-language-processing ;
    vc:requires ngm:ai-infrastructure ;
    vc:slug "generative-ai-engineering" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:large-language-models,
        ngm:neural-network,
        ngm:transformer-architecture .

ngm:gguf-format a owl:Class ;
    rdfs:label "GGUF Format"@en ;
    rdfs:comment "GGUF (GPT-Generated Unified Format) is a binary file format for storing large language model weights, metadata, and tokenizer data in a single self-contained file optimised for fast loading and local inference. Developed in the llama.cpp ecosystem as a successor to GGML, it supports a range of quantization schemes and embeds the metadata needed to run a model without external configuration. It is the de facto format for running quantized LLMs on consumer hardware."@en ;
    rdfs:subClassOf ngm:ai-infrastructure ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:model-optimisation-and-performance,
        ngm:open-generative-ai-tools ;
    vc:slug "gguf-format" ;
    vc:sourceDomain "ai" .

ngm:gitcoin-grants a owl:Class ;
    rdfs:label "Gitcoin Grants"@en ;
    rdfs:comment "Gitcoin Grants is a decentralised crowdfunding programme for open-source and public goods projects in the Web3 ecosystem, which implements quadratic funding as its core matching mechanism to amplify contributions from a broad community of small donors relative to a smaller number of large funders. In quadratic funding, the matching pool allocation for each project is proportional to the square of the sum of the square roots of individual contributions, incentivising broad participation over concentrated giving and making grant outcomes resistant to plutocratic capture. Gitcoin Grants operates in periodic rounds with a central matching pool funded by protocols, DAOs, and foundations, and uses Gitcoin Passport as a Sybil resistance layer to prevent fake identity manipulation of the quadratic formula."@en ;
    rdfs:subClassOf ngm:public-goods-funding ;
    vc:enables ngm:dao,
        ngm:open-source-development,
        ngm:retroactive-public-goods-funding ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:decentralized-autonomous-organization,
        ngm:gitcoin,
        ngm:web3 ;
    vc:slug "gitcoin-grants" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:gitcoin-passport,
        ngm:quadratic-funding,
        ngm:smart-contract,
        ngm:sybil-resistance .

ngm:gmx a owl:Class ;
    rdfs:label "GMX"@en ;
    rdfs:comment "GMX is a decentralised spot and perpetual-futures exchange deployed on the Arbitrum and Avalanche networks. It allows traders to take leveraged positions against a shared multi-asset liquidity pool rather than a traditional order book, with prices supplied by external oracles. Liquidity providers deposit assets into the pool and earn a share of trading fees while acting as the counterparty to traders."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:liquidity-pool ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:oracle ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:arbitrum ],
        ngm:decentralised-finance-domain ;
    vc:enables ngm:leveraged-trading,
        ngm:perpetual-futures ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:arbitrum,
        ngm:liquidity-pool,
        ngm:oracle ;
    vc:slug "gmx" ;
    vc:sourceDomain "gmx" .

ngm:go-quorum a owl:Class ;
    rdfs:label "GoQuorum"@en ;
    rdfs:comment "GoQuorum is an open-source, enterprise-focused Ethereum client originally developed by J.P. Morgan and forked from go-ethereum to support permissioned consortium networks. It adds private transactions and contracts, permissioning, and pluggable consensus algorithms such as IBFT, QBFT, and Raft suited to known-validator settings. It is widely used to build private and consortium blockchains for financial and supply-chain applications."@en ;
    rdfs:subClassOf ngm:bc-network-component ;
