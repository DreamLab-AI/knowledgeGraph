        ngm:rendering-technique ;
    vc:slug "animation-technique" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:game-engine ;
    vc:uses ngm:motion-capture,
        ngm:physics-simulation .

ngm:assistive-robotics a owl:Class ;
    rdfs:label "Assistive Robotics"@en ;
    rdfs:comment "Assistive Robotics is a branch of robotics focused on designing and deploying robotic systems that support or augment human physical and cognitive capabilities for individuals with disabilities, age-related decline, or rehabilitation needs. These systems range from powered exoskeletons and mobility aids to companion robots that provide social and emotional support. They operate in close physical proximity to humans and must meet stringent safety, usability, and ethical standards. Integration with sensors, AI, and adaptive interfaces enables them to respond intelligently to user intent and changing physiological states."@en ;
    rdfs:subClassOf ngm:robotic-system ;
    vc:enables ngm:accessibility,
        ngm:ai-companions,
        ngm:social-interaction ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:exoskeleton-robot,
        ngm:human-robot-interaction,
        ngm:social-robotics ;
    vc:slug "assistive-robotics" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:actuator,
        ngm:embedded-systems,
        ngm:lower-limb-exoskeleton .

ngm:audio-system a owl:Class ;
    rdfs:label "Audio System"@en ;
    rdfs:comment "An Audio System in spatial computing manages the capture, processing, and playback of sound within immersive environments, encompassing spatial audio rendering, voice communication, and environmental sound simulation. It coordinates audio hardware and software to deliver positional audio that reinforces presence and enables natural verbal interaction in virtual and mixed-reality contexts."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:spatial-audio ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:audio-spatialization ],
        ngm:sc-display-and-rendering ;
    skos:broader ngm:sc-display-and-rendering ;
    vc:enables ngm:speech-recognition,
        ngm:telecollaboration ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:audio-spatialization,
        ngm:spatial-audio ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:relatedTo ngm:audio-processing-system ;
    vc:slug "audio-system" ;
    vc:sourceDomain "spatial-computing" .

ngm:avatar-portability a owl:Class ;
    rdfs:label "Avatar Portability"@en ;
    rdfs:comment "Avatar Portability is the capability to transfer digital avatar representations between different metaverse platforms, applications, and virtual worlds while maintaining visual fidelity, customization, and associated digital assets, enabled by standardized formats and interoperability frameworks."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:standardized-formats ],
        ngm:bc-token-and-asset,
        ngm:sc-standards-and-interop ;
    skos:broader ngm:bc-token-and-asset,
        ngm:sc-standards-and-interop ;
    vc:enables ngm:asset-continuity,
        ngm:cross-platform-identity,
        ngm:seamless-world-transitions ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:platform-integration,
        ngm:standardized-formats,
        ngm:translation-frameworks ;
    vc:slug "avatar-portability" ;
    vc:sourceDomain "spatial-computing" .

ngm:blockchain-gaming a owl:Class ;
    rdfs:label "Blockchain Gaming"@en ;
    rdfs:comment "A gaming paradigm in which in-game assets, economies, and ownership records are managed on distributed ledgers, enabling players to hold verifiable ownership of digital items as NFTs, participate in play-to-earn economies, and trade assets across compatible platforms without relying on centralised game servers for provenance or scarcity guarantees."@en ;
    rdfs:subClassOf ngm:infra-computing-and-cloud ;
    skos:broader ngm:infra-computing-and-cloud ;
    vc:dependsOn ngm:blockchain-protocol,
        ngm:nft-marketplace ;
    vc:enables ngm:digital-ownership,
        ngm:virtual-currency,
        ngm:virtual-economy ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:tokenization ;
    vc:slug "blockchain-gaming" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:blockchain,
        ngm:nft,
        ngm:smart-contract .

ngm:blockchain-security a owl:Class ;
    rdfs:label "Blockchain Security"@en ;
    rdfs:comment "Blockchain security is the multidisciplinary field concerned with protecting distributed ledger systems against attacks on their consensus mechanisms, smart contract logic, cryptographic primitives, and network topology, while preserving the properties of immutability, censorship resistance, and trustless operation. It encompasses threat modelling, formal verification of on-chain code, cryptographic auditing, economic game-theory analysis to prevent incentive manipulation, and incident response for decentralised protocols. The discipline is complicated by the public, permissionless nature of most blockchains, where adversaries can observe and interact with the system before attacking."@en ;
    rdfs:subClassOf ngm:cybersecurity ;
    vc:contrastsWith ngm:51-attack,
        ngm:double-spending,
        ngm:sybil-attack ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:blockchain,
        ngm:cryptographic-security,
        ngm:smart-contract ;
    vc:slug "blockchain-security" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:consensus-mechanism,
        ngm:cryptographic-protocol,
        ngm:immutability .

ngm:carbon-footprint-assessment a owl:Class ;
    rdfs:label "Carbon Footprint Assessment"@en ;
    rdfs:comment "A comprehensive emodology that quantifies total greenhouse gas emissions associated with a product, service, or organization across its entire lifecycle using Life Cycle Assessment principles, expressed in CO2 equivalent units to identify emission hotspots and reduction opportunities."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:emission-factors ],
        ngm:environmental-assessment,
        ngm:sc-governance-and-safety ;
    skos:broader ngm:sc-governance-and-safety ;
    vc:enables ngm:hotspot-identification,
        ngm:impact-quantification,
        ngm:reduction-strategy ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires ngm:boundary-definition,
        ngm:emission-factors,
        ngm:lifecycle-data ;
    vc:slug "carbon-footprint-assessment" ;
    vc:sourceDomain "spatial-computing" .

ngm:chain-of-custody a owl:Class ;
    rdfs:label "Chain of Custody"@en ;
    rdfs:comment "Chain of Custody is a documented, unbroken sequence of records that tracks the possession, handling, transfer, analysis, and disposition of physical or digital items from their point of origin to their ultimate use—most critically in legal proceedings and regulated industries. Each handoff event must be recorded with the identity of the parties involved, the time and location of transfer, and the state of the item, ensuring that the integrity and authenticity of the item can be demonstrated to any subsequent examiner. In digital contexts the concept extends to data provenance, AI training datasets, and blockchain-based asset transfer records."@en ;
    rdfs:subClassOf ngm:provenance-tracking ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:audit-trail,
        ngm:data-provenance,
        ngm:digital-evidence-chain-of-custody,
        ngm:digital-forensics ;
    vc:slug "chain-of-custody" ;
    vc:sourceDomain "governance" ;
    vc:supports ngm:compliance-verification,
        ngm:provenance-verification,
        ngm:supply-chain-traceability ;
    vc:uses ngm:audit-logging .

ngm:chain-of-thought-prompting a owl:Class ;
    rdfs:label "Chain-of-Thought Prompting"@en ;
    rdfs:comment "Chain-of-thought (CoT) prompting is a prompt engineering technique that elicits intermediate reasoning steps from a large language model before it produces a final answer, substantially improving performance on multi-step arithmetic, commonsense reasoning, and symbolic manipulation tasks. By including exemplars that demonstrate step-by-step reasoning or by appending the instruction 'Let's think step by step' (zero-shot CoT), the technique leverages the model's autoregressive generation to decompose complex problems into tractable substeps. CoT prompting was formally characterised by Wei et al. (2022) and has become a foundational capability-elicitation method for frontier language models."@en ;
    rdfs:subClassOf ngm:prompt-engineering ;
    vc:enables ngm:common-sense-reasoning,
        ngm:mathematical-reasoning,
        ngm:multi-step-reasoning ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:chain-of-thought-reasoning,
        ngm:reasoning-engine ;
    vc:slug "chain-of-thought-prompting" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:few-shot-prompting,
        ngm:in-context-learning,
        ngm:large-language-models .

ngm:chain-of-thought-reasoning a owl:Class ;
    rdfs:label "Chain-of-Thought Reasoning"@en ;
    rdfs:comment "Chain-of-Thought (CoT) Reasoning refers to the capacity of large language models to generate and utilise coherent sequences of intermediate logical or mathematical steps as part of producing a final answer, treating reasoning as an emergent computational process instantiated in the token generation sequence rather than purely as an elicitation artefact. This framing emphasises the model's internal mechanism — how intermediate tokens shape attention and residual stream computations in subsequent layers — rather than the prompting technique that triggers the behaviour. CoT Reasoning underpins a family of advanced inference-time compute strategies including self-consistency, step-level verifiers, and process reward models."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:large-language-models ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:reasoning ],
        ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:enables ngm:transformer ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:chain-of-thought,
        ngm:prompt-engineering ;
    vc:requires ngm:large-language-models,
        ngm:reasoning ;
    vc:slug "chain-of-thought-reasoning" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:circulating-supply a owl:Class ;
    rdfs:label "Circulating Supply"@en ;
    rdfs:comment "Circulating Supply is the quantity of a blockchain token that is publicly available and actively tradeable in the market at a given point in time—excluding tokens locked in smart contracts, held in treasury reserves, vested to team members, or burned. It serves as the operative supply figure for computing market capitalisation and price-to-earnings metrics, and changes continuously as new tokens are emitted via block rewards and locked tokens are released according to vesting schedules."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:emission-schedule ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:blockchain-protocol ],
        ngm:bc-defi-and-economics,
        ngm:blockchain-entity,
        ngm:economic-mechanism ;
    skos:broader ngm:bc-defi-and-economics ;
    vc:contrastsWith ngm:deflationary-token,
        ngm:inflationary-token ;
    vc:enables ngm:blockchain-economics,
        ngm:burning-mechanism ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:fixed-supply-token,
        ngm:halving,
        ngm:market-capitalization,
        ngm:token-economics,
        ngm:tokenomics,
        ngm:total-supply ;
    vc:requires ngm:blockchain-protocol,
        ngm:emission-schedule ;
    vc:slug "circulating-supply" ;
    vc:sourceDomain "blockchain" .

ngm:cognitive-architecture a owl:Class ;
    rdfs:label "Cognitive Architecture"@en ;
    rdfs:comment "Cognitive Architecture is the overarching computational design that specifies how a reasoning agent perceives, represents, stores, and acts upon knowledge. In AI contexts it defines the interplay between symbolic reasoning, neural learning subsystems, memory stores, and planning mechanisms that together produce intelligent behaviour. Cognitive architectures such as ACT-R, SOAR, and neural-symbolic hybrids inform the design of agentic AI systems, autonomous robots, and adaptive human-computer interfaces."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:planning-and-scheduling ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:reasoning ],
        ngm:infra-computing-and-cloud ;
    skos:broader ngm:infra-computing-and-cloud ;
    vc:enables ngm:agentic-ai,
        ngm:symbolic-reasoning ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:planning-and-scheduling,
        ngm:reasoning ;
    vc:qualityScore "0.3"^^xsd:float ;
    vc:relatedTo ngm:knowledge-representation ;
    vc:slug "cognitive-architecture" ;
    vc:sourceDomain "infrastructure" .

ngm:compliance-dashboard a owl:Class ;
    rdfs:label "Compliance Dashboard"@en ;
    rdfs:comment "A visual interface and monitoring system that provides real-time visibility into regulatory compliance status, risk metrics, and audit trails across blockchain networks and digital platforms, enabling organizations to track adherence to legal requirements, detect anomalies, and demonstrate compli..."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-integration ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:blockchain-network ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:analytics-engine ],
        ngm:ai-governance-and-ethics,
        ngm:regulatory-technology ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:enables ngm:real-time-monitoring,
        ngm:regulatory-reporting,
        ngm:risk-visualization ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires ngm:analytics-engine,
        ngm:blockchain-network,
        ngm:data-integration ;
    vc:slug "compliance-dashboard" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:computer-hardware a owl:Class ;
    rdfs:label "Computer Hardware"@en ;
    rdfs:comment "Physical computing components optimised for artificial intelligence and spatial computing workloads, encompassing GPUs, TPUs, FPGAs, ASICs, and neuromorphic chips. Modern AI hardware emphasises parallel matrix processing, high-bandwidth memory, mixed-precision arithmetic, and energy-efficient inference at scale, enabling both large-model training and real-time rendering in immersive applications."@en ;
    rdfs:subClassOf ngm:ai-infrastructure ;
    vc:enables ngm:deep-learning,
        ngm:gpu-compute ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:distributed-computing,
        ngm:training ;
    vc:slug "computer-hardware" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:autonomous-robot,
        ngm:digital-twin ;
    vc:uses ngm:hardware-acceleration .

ngm:continuous-integration a owl:Class ;
    rdfs:label "Continuous Integration"@en ;
    rdfs:comment "Continuous Integration (CI) is a software engineering practice in which developers frequently merge code changes into a shared repository—typically multiple times per day—triggering automated build and test pipelines that provide rapid feedback on integration correctness. CI reduces the cost and risk of integration by detecting conflicts, regressions, and build failures early, and serves as the foundation of broader continuous delivery and DevOps workflows."@en ;
    rdfs:subClassOf ngm:software-engineering ;
    vc:enables ngm:code-review ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:agile-software-development,
        ngm:automated-testing,
        ngm:ci-cd-automation ;
    vc:slug "continuous-integration" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:git,
        ngm:version-control .

ngm:controlled-vocabulary a owl:Class ;
    rdfs:label "Controlled Vocabulary"@en ;
    rdfs:comment "A restricted list of standardized terms or phrases used within a specific domain for consistent cataloging, tagging, and indexing, where users may only apply terms from the approved list to ensure uniform description and enable reliable information retrieval across systems and platforms."@en ;
    rdfs:subClassOf ngm:information-architecture,
        ngm:sc-standards-and-interop ;
    skos:broader ngm:sc-standards-and-interop ;
    vc:enables ngm:accurate-retrieval,
        ngm:content-discovery,
        ngm:data-standardization ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:domain-expertise,
        ngm:maintenance-process,
        ngm:term-governance ;
    vc:slug "controlled-vocabulary" ;
    vc:sourceDomain "spatial-computing" .

ngm:coordinate-system a owl:Class ;
    rdfs:label "Coordinate System"@en ;
    rdfs:comment "A Coordinate System is a mathematical framework that assigns unique numerical tuples to every point in a space, enabling the precise specification of position, orientation, and scale. In spatial computing and extended reality, coordinate systems define local object frames, world frames, and camera frames that must be carefully transformed and composed to align virtual content with the physical environment."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:spatial-mapping ],
        ngm:sc-standards-and-interop ;
    skos:broader ngm:sc-standards-and-interop ;
    vc:enables ngm:pose-estimation,
        ngm:slam,
        ngm:spatial-anchor ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:relatedTo ngm:computer-vision,
