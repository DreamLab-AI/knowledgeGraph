    skos:broader ngm:sc-content-and-assets ;
    vc:bridgesTo ngm:distributed-storage,
        ngm:non-fungible-token ;
    vc:contrastsWith ngm:analogue-content-production ;
    vc:dependsOn ngm:cloud-computing,
        ngm:graphics-processing-unit ;
    vc:enables ngm:digital-content,
        ngm:immersive-experience,
