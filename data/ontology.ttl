        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:trust-framework ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:did-document ],
        ngm:bc-cryptographic-primitive,
        ngm:cryptographic-proof,
        ngm:w-3-c-standard ;
    skos:broader ngm:bc-cryptographic-primitive ;
    vc:enables ngm:cross-border-identity-recognition,
        ngm:offline-verification,
        ngm:privacy-preserving-identity,
        ngm:selective-disclosure,
        ngm:self-sovereign-identity ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:credential-schema,
        ngm:credential-status,
        ngm:credential-subject,
        ngm:proof-method,
        ngm:verifiable-credentials,
