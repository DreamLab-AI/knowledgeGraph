    vc:slug "procedural-content-generation" ;
    vc:sourceDomain "spatial-computing" .

ngm:prompt-injection a owl:Class ;
    rdfs:label "Prompt Injection"@en ;
    rdfs:comment "Prompt injection is a class of adversarial attacks against large language model (LLM) systems in which attacker-controlled text embedded within the model's input context overrides or subverts the developer-specified system prompt, causing the model to follow attacker instructions instead of its intended operating constraints. Direct prompt injection occurs when a user submits malicious instructions directly; indirect prompt injection occurs when the model retrieves or processes external content such as web pages, documents, or tool outputs that contain embedded adversarial instructions. As LLMs are increasingly deployed in agentic pipelines with tool-calling and autonomous action capabilities, prompt injection constitutes a critical security boundary violation that can lead to data exfiltration, privilege escalation, and unauthorised actions on external systems."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:large-language-model ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:system-prompt ],
        ngm:adversarial-attack ;
    vc:bridgesTo ngm:ai-regulation,
        ngm:governance ;
    vc:contrastsWith ngm:adversarial-robustness,
        ngm:input-sanitisation ;
    vc:dependsOn ngm:context-window,
        ngm:instruction-following ;
    vc:enables ngm:adversarial-testing,
        ngm:data-exfiltration,
        ngm:privilege-escalation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:direct-prompt-injection,
        ngm:indirect-prompt-injection ;
    vc:isPartOf ngm:ai-safety,
        ngm:llm-security ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:alignment,
        ngm:constitutional-ai,
        ngm:jailbreaking,
        ngm:red-teaming,
        ngm:social-engineering,
        ngm:sql-injection ;
    vc:requires ngm:large-language-model,
        ngm:system-prompt ;
    vc:slug "prompt-injection" ;
    vc:sourceDomain "security" ;
    vc:standardizedBy ngm:nist-ai-rmf,
        ngm:owasp-llm-top-10 ;
    vc:uses ngm:agentic-ai,
        ngm:retrieval-augmented-generation .

ngm:publish-subscribe-pattern a owl:Class ;
    rdfs:label "Publish-Subscribe Pattern"@en ;
    rdfs:comment "A messaging design pattern in which message producers (publishers) emit typed events to named topics or channels without direct knowledge of consumers, and message consumers (subscribers) declare interest in specific topics to receive matching events asynchronously. A broker or event bus mediates delivery, fully decoupling senders from receivers in space, time, and control flow. This architectural separation enables independent scaling, fault isolation, and runtime addition or removal of participants without coordination. Pub/Sub underpins event-driven architectures, stream processing systems, and reactive microservices."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:message-broker ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:message-broker ],
        ngm:infra-software-engineering ;
    skos:broader ngm:infra-software-engineering ;
    vc:bridgesTo ngm:digital-twin,
        ngm:federated-learning ;
    vc:contrastsWith ngm:point-to-point-messaging,
        ngm:polling-pattern,
        ngm:request-reply-pattern ;
    vc:dependsOn ngm:distributed-systems,
        ngm:message-queue ;
    vc:enables ngm:event-driven-architecture,
        ngm:loose-coupling,
        ngm:reactive-systems,
        ngm:stream-processing ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:event-channel,
        ngm:message-broker,
        ngm:topic ;
    vc:implements ngm:observer-pattern ;
    vc:isPartOf ngm:event-driven-architecture ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:cqrs,
