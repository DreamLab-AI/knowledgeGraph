ngm:climate-risk a owl:Class ;
    rdfs:comment "Climate risk is the set of financial, operational and strategic threats that arise from climate change and the transition to a low-carbon economy. It is conventionally divided into physical risk, stemming from acute and chronic climate impacts, and transition risk, arising from policy, technology, market and reputational shifts. Organisations assess and disclose climate risk to inform capital allocation, resilience planning and regulatory compliance."@en ;
    rdfs:label "Climate Risk"@en ;
    rdfs:subClassOf ngm:risk-management ;
    rdfs:subClassOf _:r4417 ;
    rdfs:subClassOf _:r4418 ;
