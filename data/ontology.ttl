# Physics-Based Animation
mv:PhysicsBasedAnimation a owl:Class ;
    rdfs:label "Physics-Based Animation"@en ;
    rdfs:comment "Animation technique that computes object motion through real-time simulation of physical forces, gravity, collisions, and dynamics to create realistic movement and interactions."@en ;
    skos:prefLabel "Physics-Based Animation"@en ;
    dcterms:identifier "MV-4000" ;
    dcterms:subject "mv" ;
    dcterms:type "mature" ;
    rdf:type owl:ProcessClass .

mv:PhysicsBasedAnimation rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:hasPart ;
    owl:someValuesFrom mv:PhysicsSimulationEngine
] .

mv:PhysicsBasedAnimation rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:hasPart ;
    owl:someValuesFrom mv:CollisionDetectionSystem
] .

mv:PhysicsBasedAnimation rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:hasPart ;
    owl:someValuesFrom mv:ConstraintSolver
] .

mv:PhysicsBasedAnimation rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:hasPart ;
    owl:someValuesFrom mv:ForceIntegrator
] .

mv:PhysicsBasedAnimation rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:isPartOf ;
    owl:someValuesFrom mv:RealTimeRenderingPipeline
] .

mv:PhysicsBasedAnimation rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:requires ;
    owl:someValuesFrom mv:PhysicsEngine
] .

mv:PhysicsBasedAnimation rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:requires ;
    owl:someValuesFrom mv:3DTransformSystem
] .

mv:PhysicsBasedAnimation rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:requires ;
    owl:someValuesFrom mv:AnimationController
] .

mv:PhysicsBasedAnimation rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:dependsOn ;
    owl:someValuesFrom mv:NumericalIntegration
] .

mv:PhysicsBasedAnimation rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:dependsOn ;
    owl:someValuesFrom mv:RigidBodyDynamics
] .

mv:PhysicsBasedAnimation rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:dependsOn ;
    owl:someValuesFrom mv:SoftBodySimulation
] .

mv:PhysicsBasedAnimation rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:enables ;
    owl:someValuesFrom mv:DynamicCharacterAnimation
] .

mv:PhysicsBasedAnimation rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:enables ;
    owl:someValuesFrom mv:ParticleSystems
] .

mv:PhysicsBasedAnimation rdfs:subClassOf [
    a owl:Restriction ;
