            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:optical-tracking ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:binaural-rendering ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:binaural-rendering ],
        ngm:sc-display-and-rendering ;
    skos:broader ngm:sc-display-and-rendering ;
    vc:bridgesTo ngm:human-computer-interaction,
        ngm:metaverse ;
    vc:contrastsWith ngm:stereo-audio ;
    vc:enables ngm:3-d-perception,
        ngm:immersive-audio,
        ngm:localization,
        ngm:presence ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:ambisonics,
        ngm:binaural-rendering,
        ngm:hrtf-filters,
        ngm:interaural-level-difference,
