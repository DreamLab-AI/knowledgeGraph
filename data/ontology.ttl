    vc:bridgesTo ngm:augmented-reality,
        ngm:metaverse ;
    vc:contrastsWith ngm:anthropic,
        ngm:google-deepmind,
        ngm:openai ;
    vc:enables ngm:multimodal-ai,
        ngm:on-device-inference,
        ngm:open-source-ai,
        ngm:transfer-learning ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:fundamental-ai-research,
        ngm:imagebind,
        ngm:llama,
        ngm:segment-anything ;
    vc:implements ngm:model-card,
