ngm:real-time-data-access a owl:Class ;
    rdfs:comment "Real-time data access is the capability to query and retrieve current, up-to-date data from underlying systems with minimal delay between data generation and availability to consumers. It is typically achieved through data virtualization layers, streaming pipelines, or optimised database query paths that avoid batch-processing latency. Real-time data access underpins applications such as live dashboards, operational monitoring, and time-sensitive decision-making that cannot tolerate stale data."@en ;
    rdfs:label "Real-Time Data Access"@en ;
    rdfs:subClassOf ngm:data-virtualization ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:slug "real-time-data-access" ;
    vc:sourceDomain "data" .
