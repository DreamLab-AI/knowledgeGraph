        ngm:wmt-shared-tasks ;
    vc:supports ngm:accessibility,
        ngm:cross-border-commerce,
        ngm:diplomatic-communication,
        ngm:healthcare-communication,
        ngm:localisation,
        ngm:scientific-publishing ;
