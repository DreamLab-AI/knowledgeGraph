ngm:rb-0026-robot-joint a owl:Class ;
    rdfs:label "rb 0026 robot joint"@en ;
    rdfs:comment "A robot joint is a mechanical articulation connecting two adjacent robot links that permits one or more degrees of relative motion—translational (prismatic) or rotational (revolute). Robot joints are the fundamental kinematic elements that determine a manipulator's workspace and degrees of freedom; their dynamic properties, including inertia, backlash, and compliance, critically influence both control precision and safe interaction with the environment."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:rb-0072-encoder ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:robot-actuator ],
        ngm:robo-actuation-and-control,
        ngm:robot ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:enables ngm:rb-0021-robot-kinematics,
        ngm:rb-0054-position-control ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:rb-0072-encoder,
        ngm:robot-actuator ;
    vc:isPartOf ngm:rb-0027-robot-link ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:rb-0038-compliance,
        ngm:rb-0039-stiffness,
        ngm:rb-0040-backlash,
        ngm:rb-0041-inertia ;
    vc:slug "rb-0026-robot-joint" ;
    vc:sourceDomain "robotics" .

ngm:rb-0054-position-control a owl:Class ;
    rdfs:label "rb 0054 position control"@en ;
    rdfs:comment "Position control is a robot control strategy in which the primary objective is to drive each joint or end-effector to a desired spatial configuration, using closed-loop feedback from encoders or resolvers to minimise position error. It forms the foundation for precise manipulation tasks and is typically implemented via PID controllers, and may be combined with force or impedance control for compliant operation in contact-rich environments."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:rb-0051-trajectory-planning ],
        ngm:motion-control,
        ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:rb-0053-force-control,
        ngm:rb-0055-velocity-control,
        ngm:rb-0056-impedance-control ;
    vc:requires ngm:rb-0051-trajectory-planning ;
    vc:slug "rb-0054-position-control" ;
    vc:sourceDomain "robotics" ;
    vc:supports ngm:rb-0091-safety-rated-monitored-stop ;
    vc:uses ngm:rb-0047-feedback-control,
        ngm:rb-0048-pid-controller,
        ngm:rb-0072-encoder .

ngm:rb-0090-emergency-stop a owl:Class ;
    rdfs:label "rb 0090 emergency stop"@en ;
    rdfs:comment "An Emergency Stop (E-stop) is a safety function that immediately removes power or halts the motion of a robot system upon activation, bringing the robot to a controlled or uncontrolled halt to prevent injury or damage. Defined under ISO 10218 and IEC 60204-1, it is a hardwired, independently monitored stop category (typically Stop Category 0 or 1) that takes priority over all other controls. E-stops must be clearly marked, accessible, and self-latching so that the robot cannot restart until the stop is deliberately reset."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:rb-0089-risk-assessment ],
        ngm:robo-safety-and-standards,
        ngm:robot-safety ;
    skos:broader ngm:robo-safety-and-standards ;
    vc:contrastsWith ngm:rb-0093-speed-limitation ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:rb-0091-safety-rated-monitored-stop,
        ngm:rb-0092-protective-stop,
        ngm:rb-0095-safety-zone,
        ngm:rb-0096-safeguarding ;
    vc:requires ngm:rb-0089-risk-assessment ;
    vc:slug "rb-0090-emergency-stop" ;
    vc:sourceDomain "robotics" ;
    vc:standardizedBy ngm:functional-safety,
        ngm:iso-10218 .

ngm:rb-0091-safety-rated-monitored-stop a owl:Class ;
    rdfs:label "rb 0091 safety rated monitored stop"@en ;
    rdfs:comment "A safety-rated monitored stop (SRMS) is a robot stopping function in which the robot halts motion while the control system continuously monitors joint positions to verify the robot remains stationary, without removing power to the actuators. Unlike an emergency stop, SRMS allows rapid resumption of operation when the hazardous condition clears, and is central to collaborative robot (cobot) safety architectures defined in ISO 10218 and ISO/TS 15066."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:rb-0054-position-control ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:rb-0089-risk-assessment ],
        ngm:robo-safety-and-standards,
        ngm:robot-safety ;
    skos:broader ngm:robo-safety-and-standards ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:rb-0090-emergency-stop,
        ngm:rb-0092-protective-stop,
        ngm:rb-0093-speed-limitation ;
    vc:requires ngm:rb-0054-position-control,
        ngm:rb-0089-risk-assessment ;
    vc:slug "rb-0091-safety-rated-monitored-stop" ;
    vc:sourceDomain "robotics" ;
    vc:standardizedBy ngm:iso-10218,
        ngm:iso-ts-15066 ;
    vc:supports ngm:human-robot-interaction,
        ngm:rb-0096-safeguarding .

ngm:rb-0093-speed-limitation a owl:Class ;
    rdfs:label "rb 0093 speed limitation"@en ;
    rdfs:comment "Speed limitation is a collaborative robotics safety function that restricts the maximum velocity of robot joints or the tool centre point to a defined safe threshold, as specified by ISO/TS 15066 and ISO 10218. It is a key mechanism for enabling safe human-robot collaboration in shared workspaces by ensuring robot motion cannot exceed speeds that would cause unacceptable injury risk upon contact. Speed limitation operates continuously or is activated when a human is detected within a monitored zone."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:rb-0055-velocity-control ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:rb-0072-encoder ],
        ngm:robo-safety-and-standards,
        ngm:robot-safety ;
    skos:broader ngm:robo-safety-and-standards ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:rb-0092-protective-stop,
        ngm:rb-0094-power-and-force-limiting,
        ngm:rb-0103-collaborative-operation,
        ngm:rb-0105-speed-and-separation-monitoring ;
    vc:requires ngm:rb-0055-velocity-control,
        ngm:rb-0072-encoder ;
    vc:slug "rb-0093-speed-limitation" ;
    vc:sourceDomain "robotics" ;
    vc:standardizedBy ngm:iso-ts-15066,
        ngm:rb-0087-safety-standard ;
    vc:supports ngm:rb-0007-collaborative-robot .

ngm:re-act a owl:Class ;
    rdfs:label "ReAct"@en ;
    rdfs:comment "ReAct (Reasoning and Acting) is a prompting framework for large language models that interleaves free-form reasoning traces (thought steps) with structured action calls (tool invocations) in a single output sequence, enabling the model to dynamically plan multi-step tasks, observe the results of tool actions, and revise its reasoning accordingly. Unlike pure chain-of-thought prompting which only produces reasoning without grounding, or pure action-only agents which cannot explain their decisions, ReAct unifies both in a synergistic loop that improves task completion rates and interpretability. ReAct has become foundational to agentic AI frameworks including LangChain, LlamaIndex, and OpenAI's Assistants API."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:chain-of-thought ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:tool-use ],
        ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:enables ngm:agentic-ai,
        ngm:autonomous-agent ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:planning-and-scheduling,
        ngm:reasoning ;
    vc:requires ngm:chain-of-thought,
        ngm:tool-use ;
    vc:slug "re-act" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:replication a owl:Class ;
    rdfs:label "Replication"@en ;
    rdfs:comment "Replication is the practice of maintaining multiple copies of data or services across different machines or locations to improve availability, durability, fault tolerance, and read performance. Strategies range from synchronous replication, which guarantees copies are identical before acknowledging a write, to asynchronous replication, which favours latency at the risk of temporary divergence. Replication is foundational to distributed databases, content-delivery networks, and high-availability systems, and its design forces explicit choices among consistency, availability, and partition tolerance."@en ;
    rdfs:subClassOf ngm:fault-tolerance ;
    vc:enables ngm:data-availability ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:distributed-storage,
        ngm:distributed-systems ;
    vc:slug "replication" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:crdt .

ngm:reward-distribution a owl:Class ;
    rdfs:label "Reward Distribution"@en ;
    rdfs:comment "Tokenomic mechanisms that calculate and allocate staking rewards, validator incentives, and participation benefits within blockchain networks through mathematically designed emission schedules and fee distribution protocols."@en ;
    rdfs:subClassOf ngm:sc-platform-and-environment,
        ngm:tokenomics ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:enables ngm:network-participation ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:slug "reward-distribution" ;
    vc:sourceDomain "spatial-computing" .

