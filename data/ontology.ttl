        ngm:motion-capture .

ngm:hybrid-consensus a owl:Class ;
    rdfs:label "Hybrid Consensus"@en ;
    rdfs:comment "A consensus mechanism that combines two or more distinct consensus approaches—typically pairing a proof-based method such as Proof of Work or Proof of Stake with a Byzantine Fault Tolerant finality layer—to balance security, throughput, and finality properties. Hybrid designs aim to capture the best characteristics of each constituent mechanism while mitigating their individual weaknesses."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:byzantine-fault-tolerance ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:validator-set ],
        ngm:bc-protocol-and-consensus,
        ngm:consensus-mechanism ;
    skos:broader ngm:bc-protocol-and-consensus ;
    vc:contrastsWith ngm:proof-of-stake,
        ngm:proof-of-work ;
    vc:enables ngm:blockchain-scalability,
        ngm:finality ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:block-time,
        ngm:blockchain-protocol,
        ngm:fork-choice-rule,
        ngm:validator-node ;
    vc:requires ngm:byzantine-fault-tolerance,
        ngm:validator-set ;
    vc:slug "hybrid-consensus" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:proof-of-stake,
        ngm:proof-of-work .

ngm:hybrid-robot a owl:Class ;
    rdfs:label "Hybrid Robot"@en ;
    rdfs:comment "A robotic system that combines two or more distinct locomotion or manipulation modalities—such as wheeled and legged movement, or fixed-base and mobile operation—to extend operational range and adaptability across heterogeneous environments. Hybrid robots exploit the efficiency of specialised subsystems whilst maintaining versatility that no single modality can achieve alone."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:robot-actuator ],
        [ a owl:Restriction ;
