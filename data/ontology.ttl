        ngm:transfer-learning ;
    vc:contrastsWith ngm:group-normalisation,
        ngm:instance-normalisation,
        ngm:layer-normalisation,
        ngm:weight-normalisation ;
    vc:dependsOn ngm:backpropagation,
        ngm:neural-network-layer ;
    vc:enables ngm:deep-learning,
        ngm:faster-convergence,
        ngm:higher-learning-rate ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:learnable-scale-parameter,
        ngm:learnable-shift-parameter ;
    vc:isPartOf ngm:convolutional-neural-network,
        ngm:deep-neural-network ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:dropout,
        ngm:gradient-descent,
        ngm:internal-covariate-shift,
        ngm:normalisation-technique,
        ngm:optimisation-landscape-smoothing,
        ngm:regularisation ;
    vc:requires ngm:mini-batch,
        ngm:stochastic-gradient-descent ;
    vc:slug "batch-normalisation" ;
    vc:sourceDomain "machine-learning" ;
    vc:uses ngm:mean-and-variance-statistics,
        ngm:neural-network .

ngm:benchmarks a owl:Class ;
    rdfs:label "Benchmarks"@en ;
    rdfs:comment "Benchmarks are standardised tasks, datasets, or workloads used to measure and compare the capabilities or performance of systems, models, or components under controlled, reproducible conditions. In artificial intelligence they encompass curated evaluation suites that probe language understanding, mathematical reasoning, coding, and multimodal perception to produce comparable scores across model generations and research groups. In computing, robotics, and hardware engineering, benchmarks quantify throughput, latency, accuracy, and energy efficiency against fixed reference workloads. Benchmark results are published via leaderboards and model cards to support reproducible science, informed procurement, and regulatory accountability."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
