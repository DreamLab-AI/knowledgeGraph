        ngm:robot-joint ;
    vc:isPartOf ngm:robotics ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:cylindrical-robot,
        ngm:delta-robot,
        ngm:robot-hardware,
        ngm:scara-robot ;
    vc:slug "polar-robot" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:robot-kinematics .

ngm:policy-update-magnitude a owl:Class ;
    rdfs:label "Policy Update Magnitude"@en ;
    rdfs:comment "Policy Update Magnitude is a measure of how much a reinforcement learning agent's policy changes between successive gradient update steps, typically quantified as the KL divergence between the old and new policy distributions or as the Euclidean norm of the parameter change vector. Controlling this magnitude is essential to training stability: excessively large updates can cause catastrophic performance collapse, whilst excessively small updates slow convergence. Algorithms such as Proximal Policy Optimisation (PPO) and Trust Region Policy Optimisation (TRPO) impose explicit constraints on policy update magnitude to balance exploration, exploitation, and stability."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:reinforcement-learning ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gradient-descent ],
        ngm:reinforcement-learning ;
    vc:enables ngm:reinforcement-learning-from-human-feedback ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:reinforcement-learning-algorithm ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:loss-function,
        ngm:proximal-policy-optimisation,
        ngm:reinforcement-learning-algorithm,
        ngm:reward-function ;
    vc:requires ngm:gradient-descent,
        ngm:reinforcement-learning ;
    vc:slug "policy-update-magnitude" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:gradient-clipping,
        ngm:learning-rate-schedule .

ngm:pool-share a owl:Class ;
    rdfs:label "Pool Share"@en ;
    rdfs:comment "A proof-of-work unit submitted by an individual miner to a mining pool server demonstrating that the miner performed a bounded amount of computational work toward finding a valid block hash. Pool shares have a lower difficulty target than the network block target, allowing the pool to credit each contributor proportional work units and distribute block rewards fairly, regardless of which specific miner finds the winning nonce."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:consensus-mechanism ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:proof-of-work ],
        ngm:bc-protocol-and-consensus,
        ngm:blockchain-entity,
        ngm:consensus-protocol ;
    skos:broader ngm:bc-protocol-and-consensus ;
    vc:contrastsWith ngm:proof-of-stake ;
    vc:enables ngm:block-reward,
        ngm:mining-reward ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:mining,
        ngm:mining-pool ;
