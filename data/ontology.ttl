    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:open-zeppelin ;
    vc:requires ngm:compiler,
        ngm:node-js ;
    vc:slug "hardhat" ;
