        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:generator-network ],
        ngm:ai-technique,
        ngm:computer-vision ;
    skos:broader ngm:ai-technique ;
    vc:bridgesTo ngm:image-editing ;
    vc:enables ngm:generative-fill,
        ngm:image-and-video-restoration,
        ngm:outpainting ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:generator-network,
        ngm:loss-function,
        ngm:sampling-procedure ;
    vc:implements ngm:conditional-generation,
        ngm:variational-inference ;
    vc:qualityScore "0.52"^^xsd:float ;
    vc:relatedTo ngm:adobe-firefly,
