    skos:broader ngm:infra-computing-and-cloud ;
    vc:enables ngm:distributed-computing,
        ngm:high-availability,
        ngm:low-latency,
        ngm:scalability ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:5-g-network,
        ngm:cdn,
        ngm:cloud-computing,
        ngm:edge-computing,
        ngm:hardware-abstraction-layer-hal,
        ngm:spatial-computing,
        ngm:storage-layer ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:network-infrastructure,
        ngm:physical-hardware,
        ngm:power-systems ;
    vc:slug "infrastructure-layer" ;
    vc:sourceDomain "infrastructure" .

ngm:technology-stack a owl:Class ;
    rdfs:label "Technology Stack"@en ;
    rdfs:comment "The integrated set of software components, frameworks, libraries, runtime environments, and infrastructure services that together support the development and operation of a digital application or platform. In spatial computing contexts, a technology stack spans from hardware drivers and operating systems through XR runtimes, game engines, and application frameworks up to user-facing interfaces and cloud services."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:runtime-environment ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:middleware ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:system-software ],
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:dependsOn ngm:operating-system,
        ngm:xr-runtime-environment ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:middleware,
        ngm:runtime-environment,
        ngm:system-software ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:slug "technology-stack" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:game-engine,
        ngm:rendering-engine .

ngm:temporal-motion-diffusion-adapter a owl:Class ;
    rdfs:label "Temporal Motion Diffusion Adapter"@en ;
    rdfs:comment "AnimateDiff is an open-source framework that inserts lightweight motion-module adapters into pre-trained text-to-image diffusion models to generate temporally consistent animated sequences without retraining the base image model. Developed by researchers at CUHK and ByteDance and released in 2023, it enables personalised diffusion model checkpoints to produce video clips by learning motion priors from video data in a plug-and-play manner. AnimateDiff integrates natively with the Stable Diffusion ecosystem, including ControlNet conditioning and LoRA fine-tuning."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:latent-diffusion ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:diffusion-model ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:attention-mechanism ],
        ngm:video-generation ;
    vc:contrastsWith ngm:motion-capture-technology ;
    vc:enables ngm:animation-technique,
        ngm:image-to-image-translation,
        ngm:video-generation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:3-d-animation,
        ngm:computer-vision-video-analysis,
        ngm:generative-ai,
        ngm:stable-diffusion-image-model ;
    vc:requires ngm:attention-mechanism,
        ngm:diffusion-model,
        ngm:latent-diffusion ;
    vc:slug "temporal-motion-diffusion-adapter" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:fine-tuning,
        ngm:generative-model,
        ngm:motion-capture,
        ngm:parameter-efficient-fine-tuning .

ngm:text-to-video-generation a owl:Class ;
    rdfs:label "Text-to-Video Generation"@en ;
    rdfs:comment "Text-to-video generation is a generative-AI task in which a model synthesises a coherent video clip directly from a natural-language description. It extends text-to-image diffusion and transformer methods with temporal modelling so that motion, object permanence, and scene consistency hold across frames. The field advanced rapidly with large latent-diffusion and spatiotemporal-transformer models capable of producing seconds of high-fidelity footage from a prompt."@en ;
    rdfs:subClassOf ngm:generative-ai ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:ai-video,
        ngm:proprietary-ai-video ;
    vc:slug "text-to-video-generation" ;
    vc:sourceDomain "ai" .

ngm:thermodynamics a owl:Class ;
    rdfs:label "Thermodynamics"@en ;
    rdfs:comment "Thermodynamics is the branch of physics concerned with heat, work, temperature and energy, and the laws governing their transformation and the direction of spontaneous processes. Its core principles - conservation of energy, the increase of entropy, and absolute-zero limits - underpin engineering of engines, cooling and energy systems. In computing infrastructure it constrains power consumption, heat dissipation and the efficiency of data-centre cooling."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:thermal-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:entropy ],
        ngm:infrastructure ;
    skos:broader ngm:infrastructure ;
    vc:bridgesTo ngm:information-theory,
        ngm:statistical-mechanics ;
    vc:dependsOn ngm:entropy ;
    vc:enables ngm:energy-management,
        ngm:green-computing ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:entropy ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:energy-efficiency,
        ngm:statistical-mechanics ;
    vc:requires ngm:thermal-management ;
    vc:slug "thermodynamics" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:energy-efficiency,
        ngm:power-consumption ;
    vc:uses ngm:thermal-management .

ngm:time-series-data a owl:Class ;
    rdfs:label "Time Series Data"@en ;
    rdfs:comment "Time series data is a sequence of observations indexed in time order, typically recorded at regular or irregular intervals from sensors, systems or markets. Its temporal structure exposes trends, seasonality and autocorrelation that distinguish it from cross-sectional data and demand specialised storage, querying and analysis. Time series underpin monitoring, forecasting and anomaly detection across many domains."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:time-series-database ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-storage ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:sensor-data ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:timestamp ],
        ngm:data ;
    vc:bridgesTo ngm:data-pipeline ;
    vc:contrastsWith ngm:data-structure ;
    vc:enables ngm:anomaly-detection,
        ngm:time-series-analysis ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:sensor-data,
        ngm:timestamp ;
    vc:isPartOf ngm:data ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:data,
        ngm:data-analytics,
        ngm:monitoring,
        ngm:telemetry ;
    vc:requires ngm:data-storage,
        ngm:time-series-database ;
    vc:slug "time-series-data" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:monitoring,
        ngm:stream-processing ;
    vc:uses ngm:sampling,
        ngm:timestamp .

ngm:token-bonding-curve a owl:Class ;
    rdfs:label "Token Bonding Curve"@en ;
    rdfs:comment "Algorithmic pricing mechanism that defines token value as a mathematical function of circulating supply and reserve balance, providing continuous liquidity through automated market making."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:constant-product-formula ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:liquidity ],
        [ a owl:Restriction ;
