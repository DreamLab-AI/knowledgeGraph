    vc:slug "dynamic-character-animation" ;
    vc:sourceDomain "spatial-computing" .

ngm:e-idas-2-0 a owl:Class ;
    rdfs:label "eIDAS 2.0"@en ;
    rdfs:comment "eIDAS 2.0 is the revised EU regulation on electronic identification, authentication, and trust services, adopted in 2024 as an amendment to the original eIDAS regulation of 2014. Its central innovation is the European Digital Identity Wallet (EUDIW), a mandatory infrastructure obligation requiring EU member states to provide citizens and businesses with a personal digital wallet capable of storing verifiable credentials, qualified electronic signatures, and attribute attestations. The regulation mandates that large online platforms accept the wallet for authentication, directly challenging private identity providers and establishing a public-interest counterweight to platform data concentration. eIDAS 2.0 aligns with W3C Verifiable Credentials and Decentralised Identifiers standards, embedding open interoperability requirements into binding EU law."@en ;
    rdfs:subClassOf ngm:digital-identity-framework ;
    vc:enables ngm:authentication-standards,
        ngm:digital-identity-management ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:digital-identity-standards,
        ngm:digital-identity-wallet,
        ngm:self-sovereign-identity,
        ngm:verifiable-credentials ;
    vc:slug "e-idas-2-0" ;
    vc:sourceDomain "governance" ;
    vc:supports ngm:data-protection-regulation,
        ngm:digital-regulation .

ngm:eba a owl:Class ;
    rdfs:label "EBA"@en ;
    rdfs:comment "The European Banking Authority (EBA) is an independent EU regulatory agency established in 2011 to ensure consistent prudential regulation and supervision across the European banking sector. It develops binding technical standards and guidelines that national supervisors must implement, conducts EU-wide stress tests to assess banking system resilience, and plays a central role in developing anti-money laundering supervisory frameworks. The EBA's remit has expanded into digital finance, including technical standards for crypto-asset service providers under the MiCA Regulation and guidelines on ICT risk management."@en ;
    rdfs:subClassOf ngm:financial-regulation ;
    vc:enables ngm:aml-kyc-compliance,
        ngm:regulatory-compliance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:mi-ca-regulation ;
    vc:slug "eba" ;
    vc:sourceDomain "governance" ;
    vc:supports ngm:financial-stability,
        ngm:systemic-risk .

ngm:eccv a owl:Class ;
    rdfs:label "ECCV"@en ;
    rdfs:comment "ECCV, the European Conference on Computer Vision, is a biennial premier venue for research in computer vision and pattern recognition, held in alternating years with ICCV to provide the community with annual high-quality publication opportunities. Founded in 1990, it attracts thousands of submissions covering topics from low-level image processing and 3D reconstruction to high-level scene understanding and video analysis. ECCV proceedings published through Springer LNCS constitute one of the most-cited bodies of literature in artificial intelligence. Acceptance at ECCV carries high prestige, signalling rigorous peer review and methodological significance."@en ;
    rdfs:subClassOf ngm:computer-vision ;
    vc:enables ngm:benchmarks,
        ngm:model-evaluation-results ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:cvpr,
        ngm:iccv,
        ngm:iclr ;
    vc:slug "eccv" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:convolutional-neural-network,
        ngm:deep-learning,
        ngm:object-detection,
        ngm:semantic-segmentation .

ngm:economic-layer a owl:Class ;
    rdfs:label "Economic Layer"@en ;
    rdfs:comment "The Economic Layer is the abstraction level at which concrete economic mechanisms are implemented in blockchain and distributed systems, encompassing fee markets, reward distribution formulae, automated market makers, staking yield calculations, and game-theoretic incentive structures. It is distinct from conceptual economic theory in that it specifies exact parameters, formulas, and on-chain behaviours."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:governance-model ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:governance-token ],
        ngm:infra-computing-and-cloud ;
    skos:broader ngm:infra-computing-and-cloud ;
    vc:enables ngm:metaverse-as-markets ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:governance-model,
        ngm:governance-token ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:governance,
        ngm:governance-framework ;
    vc:slug "economic-layer" ;
    vc:sourceDomain "infrastructure" .

ngm:economic-systems a owl:Class ;
    rdfs:label "Economic Systems"@en ;
    rdfs:comment "Economic Systems are the structured sets of rules, institutions, and mechanisms that govern the production, distribution, and consumption of goods, value, and digital assets within a platform or environment. In spatial computing and Web3 contexts, economic systems encompass tokenomics, smart-contract-enforced incentive structures, and decentralised exchange mechanisms."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:tokenomics ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:token-economics ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:smart-contract ],
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:token-economics,
        ngm:tokenomics ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:relatedTo ngm:blockchain-economics,
        ngm:dao-governance ;
    vc:requires ngm:smart-contract ;
    vc:slug "economic-systems" ;
    vc:sourceDomain "spatial-computing" .

ngm:ed-dsa a owl:Class ;
    rdfs:label "EdDSA"@en ;
    rdfs:comment "EdDSA (Edwards-curve Digital Signature Algorithm) is a high-performance digital signature scheme based on twisted Edwards elliptic curves, standardised in RFC 8032. It provides deterministic signing—eliminating the random number generation vulnerabilities that afflicted earlier schemes like ECDSA—whilst offering strong security with compact key and signature sizes. The most widely deployed instantiation is Ed25519, which operates over Curve25519 and produces 64-byte signatures with 128-bit security. EdDSA is extensively used in secure communications protocols, blockchain systems, verifiable credentials, and decentralised identity frameworks."@en ;
    rdfs:subClassOf ngm:digital-signature ;
    vc:enables ngm:cryptographic-verification,
        ngm:digital-signature-verification ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:cryptographic-protocol,
        ngm:ed25519,
        ngm:public-key-cryptography,
        ngm:schnorr-signature,
        ngm:signature-scheme ;
    vc:slug "ed-dsa" ;
    vc:sourceDomain "security" ;
    vc:uses ngm:cryptographic-hash-function,
        ngm:elliptic-curve-cryptography .

ngm:edge-cloud-collaboration a owl:Class ;
    rdfs:label "Edge-Cloud Collaboration"@en ;
    rdfs:comment "Edge-Cloud Collaboration is a hybrid architecture that dynamically partitions AI workloads between resource-constrained edge devices and powerful cloud infrastructure, optimising end-to-end latency, bandwidth utilisation, energy consumption, and inference accuracy through adaptive offloading, model splitting, early exit, and cascaded inference strategies. The architecture enables edge devices to handle time-sensitive inference locally while delegating computationally intensive or contextually uncertain tasks to the cloud, achieving the complementary strengths of both deployment tiers."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:cloud-infrastructure ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:bandwidth-adaptation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:federated-edge-learning ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:edge-ai-system ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:machine-learning-infrastructure ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:edge-computing ],
        ngm:ai-infrastructure ;
    vc:contrastsWith ngm:edge-computing-node ;
    vc:enables ngm:digital-twin,
        ngm:io-t-ai-integration,
        ngm:latency-aware-edge-ai ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:bandwidth-adaptation,
        ngm:cloud-infrastructure,
        ngm:edge-computing ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:cloud-native-applications,
        ngm:edge-ai-accelerators,
        ngm:machine-learning-platform ;
    vc:requires ngm:edge-ai-system,
        ngm:federated-edge-learning,
        ngm:machine-learning-infrastructure ;
    vc:slug "edge-cloud-collaboration" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:edge-computing-architecture,
        ngm:edge-orchestration,
        ngm:federated-learning .

ngm:edge-inference a owl:Class ;
    rdfs:label "Edge Inference"@en ;
    rdfs:comment "The execution of machine learning model inference on local edge devices rather than in centralised cloud infrastructure, close to where data is generated."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:knowledge-distillation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:inference-engine ],
        ngm:edge-ai ;
    vc:enables ngm:edge-ai ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:inference-engine,
        ngm:knowledge-distillation ;
    vc:slug "edge-inference" ;
    vc:sourceDomain "machine-learning" .

ngm:educational-methodology a owl:Class ;
    rdfs:label "Educational Methodology"@en ;
    rdfs:comment "Educational Methodology is a structured approach to the design, delivery, and evaluation of learning experiences, encompassing pedagogical theories, instructional design models, and assessment frameworks. In spatial computing contexts it includes immersive, experiential, and simulation-based learning paradigms enabled by XR technologies."@en ;
    rdfs:subClassOf ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:enables ngm:generative-content ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:augmented-reality,
        ngm:digital-twin ;
    vc:slug "educational-methodology" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:simulation,
        ngm:virtual-reality .

ngm:eip-712 a owl:Class ;
    rdfs:label "EIP-712"@en ;
    rdfs:comment "EIP-712 (Ethereum Improvement Proposal 712) is a standard for hashing and signing typed structured data in Ethereum, enabling wallets to display human-readable transaction information instead of opaque hexadecimal byte strings before a user signs a message. It defines a domain separator (chainId, contract address, version) that binds a signature to a specific deployment context to prevent cross-chain or cross-contract replay attacks, and a type-encoding scheme that recursively hashes structured fields to produce a deterministic 32-byte digest that the ECDSA private key signs. EIP-712 is the foundation of off-chain signing workflows — gasless approvals, meta-transactions, permit() functions (EIP-2612), delegated votes, and order book signatures in decentralised exchanges — making it one of the most widely deployed Ethereum standards."@en ;
    rdfs:subClassOf ngm:digital-signature ;
    vc:enables ngm:account-abstraction,
        ngm:de-fi,
        ngm:digital-wallet ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:cryptographic-signature,
        ngm:eip-1559,
        ngm:smart-contract ;
    vc:slug "eip-712" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:smart-contract-execution ;
    vc:uses ngm:digital-signature-verification,
        ngm:erc-721 .

ngm:electric-linear-actuator a owl:Class ;
    rdfs:label "Electric Linear Actuator"@en ;
    rdfs:comment "An actuator that converts rotary electrical motor output into controlled linear displacement using a mechanical transmission such as a lead screw, rack-and-pinion, or belt drive. Electric linear actuators offer precise position control, programmable stroke lengths, and clean operation, making them preferable to pneumatic or hydraulic counterparts in many robotics and automation applications."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:rack-and-pinion-actuator ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:lead-screw-actuator ],
        ngm:electric-actuator,
        ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:enables ngm:parallel-robot ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:lead-screw-actuator,
        ngm:rack-and-pinion-actuator ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:hydraulic-actuator,
        ngm:pneumatic-actuator,
        ngm:servo-motor,
        ngm:stepper-motor ;
    vc:slug "electric-linear-actuator" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:electric-motor,
        ngm:motion-control,
        ngm:position-control .

ngm:electrical-power a owl:Class ;
    rdfs:label "Electrical Power"@en ;
    rdfs:comment "Electrical Power is the rate at which electrical energy is transferred or consumed by a system, measured in watts. It is the fundamental resource that drives compute infrastructure, robotic actuators, sensors, and communications equipment. The availability, capacity, and efficiency of electrical power are primary constraints on data-centre scale and on the autonomy of mobile and robotic systems."@en ;
    rdfs:subClassOf ngm:digital-infrastructure ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:compute-infrastructure,
        ngm:electric-actuator ;
    vc:slug "electrical-power" ;
    vc:sourceDomain "infrastructure" .

ngm:embedded-systems-domain a owl:Class ;
    rdfs:label "Embedded Systems Domain"@en ;
    rdfs:comment "The Embedded Systems Domain covers computing systems built into devices to perform dedicated functions under constraints on power, memory and timing. Its scope includes microcontrollers, real-time operating systems, firmware and hardware-software co-design. It is a sub-area of the Robotics Domain that provides the computational substrate for physical machines. The boundary excludes general-purpose server and cloud computing, which belongs to the Infrastructure Domain."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:compute-layer ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:real-time-operating-system ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:sensor-interface ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:control-theory-domain ],
        ngm:robotics-domain ;
    vc:enables ngm:device-control,
        ngm:edge-computing,
        ngm:real-time-sensing ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:firmware,
        ngm:hardware-software-co-design,
        ngm:microcontroller,
        ngm:real-time-operating-system,
        ngm:sensor-interface ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:compute-layer,
        ngm:control-theory-domain,
        ngm:digital-electronics ;
    vc:slug "embedded-systems-domain" ;
    vc:sourceDomain "embedded-systems" .

ngm:emotional-analytics-engine a owl:Class ;
    rdfs:label "Emotional Analytics Engine"@en ;
    rdfs:comment "AI module analyzing affective states from facial, voice, or physiological data to enable adaptive agent responses and affective computing."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:machine-learning-model ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:real-time-processing ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:privacy-protection ],
        ngm:sc-interaction ;
    skos:broader ngm:sc-interaction ;
    vc:enables ngm:adaptive-user-interface,
        ngm:emotion-aware-interaction,
        ngm:mental-health-monitoring,
        ngm:sentiment-analysis ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:affective-state-predictor,
        ngm:facial-expression-analyzer,
        ngm:physiological-sensor-processor,
        ngm:sentiment-classification-model,
        ngm:voice-emotion-detector ;
    vc:isPartOf ngm:affective-computing-system,
        ngm:user-experience-analytics-platform ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:machine-learning-model,
        ngm:privacy-protection,
        ngm:real-time-processing,
        ngm:sensor-data-stream ;
    vc:slug "emotional-analytics-engine" ;
    vc:sourceDomain "spatial-computing" .

ngm:encrypted-storage a owl:Class ;
    rdfs:label "Encrypted Storage"@en ;
    rdfs:comment "Encrypted Storage is the protection of data at rest by transforming it with cryptographic algorithms so that it is unreadable without the corresponding decryption keys. It can operate at the disk, filesystem, database, or object level, and is essential for confidentiality of sensitive data such as biometric templates. Proper key management, including secure key generation, rotation, and access control, is critical to its effectiveness."@en ;
    rdfs:subClassOf ngm:infra-security-and-identity ;
    skos:broader ngm:infra-security-and-identity ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:biometric-binding-mechanism,
        ngm:etsi-domain-data-management-security ;
    vc:slug "encrypted-storage" ;
    vc:sourceDomain "security" .

ngm:encryption-scheme a owl:Class ;
    rdfs:label "Encryption Scheme"@en ;
    rdfs:comment "An Encryption Scheme is a cryptographic construction comprising key-generation, encryption, and decryption algorithms that together transform plaintext into ciphertext and back under a key. Schemes are categorised as symmetric (shared key, e.g. AES) or asymmetric (public/private key, e.g. RSA, ECC), and are evaluated by their security definitions such as semantic security. They are the building blocks of confidentiality in cryptographic protocols."@en ;
    rdfs:subClassOf ngm:cryptographic-primitive ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:cryptographic-protocol,
        ngm:cryptography ;
    vc:slug "encryption-scheme" ;
    vc:sourceDomain "security" .

ngm:encryption-service a owl:Class ;
    rdfs:label "Encryption Service"@en ;
    rdfs:comment "An encryption service is a system or component that provides cryptographic protection of data, typically offering key management and encryption operations through an interface. It supports confidentiality of stored and transmitted data."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:symmetric-encryption ],
        ngm:cryptography ;
    vc:enables ngm:privacy ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:symmetric-encryption ;
    vc:slug "encryption-service" ;
    vc:sourceDomain "general" .

ngm:endorsement-policy a owl:Class ;
    rdfs:label "Endorsement Policy"@en ;
    rdfs:comment "An Endorsement Policy is a rule, used in permissioned blockchains such as Hyperledger Fabric, that specifies which organisations' peers must execute and cryptographically sign a transaction proposal before it is considered valid. It encodes the trust and approval requirements for a smart contract, for example requiring signatures from a majority or a named set of consortium members. Endorsement policies are central to multi-party governance of enterprise distributed ledgers."@en ;
    rdfs:subClassOf ngm:bc-protocol-and-consensus ;
    skos:broader ngm:bc-protocol-and-consensus ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:consortium-blockchain,
        ngm:enterprise-smart-contracts ;
    vc:slug "endorsement-policy" ;
    vc:sourceDomain "blockchain" .

ngm:environmental-registry a owl:Class ;
    rdfs:label "Environmental Registry"@en ;
    rdfs:comment "A catalogued, authoritative store of descriptors for physical or virtual environments, recording their spatial bounds, safety parameters, hazard zones, and compliance status. XR systems query the environmental registry during session initialisation to validate that the current space meets operational and safety requirements before permitting immersive interactions."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:spatial-anchor ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:room-scale ],
        ngm:sc-governance-and-safety ;
    skos:broader ngm:sc-governance-and-safety ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:room-scale,
        ngm:spatial-anchor ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:calibration-tools ;
    vc:slug "environmental-registry" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:environmental-verification,
        ngm:xr-runtime-environment ;
    vc:uses ngm:data-management,
        ngm:database-query .

ngm:environmental-sensing a owl:Class ;
    rdfs:label "Environmental Sensing"@en ;
    rdfs:comment "Environmental sensing is the acquisition of data about physical surroundings, such as temperature, light, humidity, air quality, sound, or proximity, using sensors. It provides the raw perceptual input that systems use to understand and respond to their context. In robotics, IoT, and context-aware applications it is the foundational layer enabling situational awareness and adaptive behaviour."@en ;
    rdfs:subClassOf ngm:robo-perception ;
    skos:broader ngm:robo-perception ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:context-awareness,
        ngm:sensor ;
    vc:slug "environmental-sensing" ;
    vc:sourceDomain "robotics" .

ngm:environmental-standards a owl:Class ;
    rdfs:label "Environmental Standards"@en ;
    rdfs:comment "Regulatory frameworks and technical specifications governing the environmental sustainability of metaverse infrastructure, including energy efficiency requirements for data centres, carbon footprint disclosure mandates, and e-waste management guidelines for XR hardware."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:environmental-assessment ],
        ngm:sc-governance-and-safety,
        ngm:technical-standards ;
    skos:broader ngm:sc-governance-and-safety ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:relatedTo ngm:blockchain-sustainability,
        ngm:carbon-accounting ;
    vc:requires ngm:environmental-assessment ;
    vc:slug "environmental-standards" ;
    vc:sourceDomain "spatial-computing" ;
    vc:standardizedBy ngm:iso-standards ;
    vc:supports ngm:circular-economy,
        ngm:environmental-sustainability .

ngm:erc-20-token-standard a owl:Class ;
    rdfs:label "ERC-20 Token Standard"@en ;
    rdfs:comment "The ERC-20 Token Standard is the foundational Ethereum Request for Comments specification that defines a common interface for fungible tokens on the Ethereum blockchain, enabling seamless interoperability between token contracts, wallets, decentralised exchanges, and other smart contract systems. Proposed by Fabian Vogelsteller in 2015 and formalised as an Ethereum Improvement Proposal, it specifies six mandatory functions—totalSupply, balanceOf, transfer, transferFrom, approve, and allowance—and two events. ERC-20 standardisation catalysed the 2017 ICO boom and remains the dominant token interface in decentralised finance, with thousands of tokens deployed to this specification. Its simplicity has made it the basis for numerous extended standards including ERC-777, ERC-1400, and ERC-3643."@en ;
    rdfs:subClassOf ngm:enterprise-token-standards ;
    vc:enables ngm:asset-tokenisation,
        ngm:decentralised-finance,
        ngm:decentralized-exchange-dex ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:erc-20,
        ngm:erc-721,
        ngm:erc1400-standard,
        ngm:fungible-token,
        ngm:governance-token,
        ngm:utility-token ;
    vc:slug "erc-20-token-standard" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:enterprise-smart-contracts .

ngm:erc-721-standard a owl:Class ;
    rdfs:label "ERC-721 Standard"@en ;
    rdfs:comment "ERC-721 is an Ethereum token standard defining a minimal interface for non-fungible tokens (NFTs), where each token carries a unique identifier that distinguishes it from every other token in the same contract. It specifies ownership tracking, safe transfer functions, and an optional metadata extension for associating URIs with token properties."@en ;
    rdfs:subClassOf ngm:nft-standard ;
    vc:contrastsWith ngm:erc20-standard ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:erc-1155,
        ngm:ethereum,
        ngm:nft ;
    vc:slug "erc-721-standard" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:ipfs .

ngm:erc1400-standard a owl:Class ;
    rdfs:label "ERC1400 Standard"@en ;
    rdfs:comment "Security token standard with compliance controls and transfer restrictions."@en ;
    rdfs:subClassOf ngm:bc-token-and-asset ;
    skos:broader ngm:bc-token-and-asset ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:smart-contract-platform ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:slug "erc1400-standard" ;
    vc:sourceDomain "blockchain" .

ngm:erc20-standard a owl:Class ;
    rdfs:label "ERC20 Standard"@en ;
    rdfs:comment "Technical standard for fungible tokens on ereum, defining required mods and events for token contracts."@en ;
    rdfs:subClassOf ngm:bc-token-and-asset ;
    skos:broader ngm:bc-token-and-asset ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:blockchain ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:slug "erc20-standard" ;
    vc:sourceDomain "blockchain" .

ngm:erc20-token a owl:Class ;
    rdfs:label "ERC20 Token"@en ;
    rdfs:comment "An ERC20 Token is a fungible token implementing the ERC-20 interface standard on the Ethereum blockchain, which defines a uniform set of six mandatory functions (totalSupply, balanceOf, transfer, transferFrom, approve, allowance) enabling interoperability between token contracts, decentralised exchanges, wallets, and DeFi protocols without bespoke integration. ERC-20 became the dominant token standard following its formalisation in 2015 and is used for utility tokens, governance tokens, stablecoins, and wrapped assets. The standard's fungibility means all token units are identical and mutually interchangeable, contrasting with ERC-721 non-fungible tokens that represent distinct assets."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:token-standard ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:blockchain ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:smart-contract ],
        ngm:bc-token-and-asset,
        ngm:fungible-token ;
    skos:broader ngm:bc-token-and-asset ;
    vc:contrastsWith ngm:erc-721,
        ngm:nft ;
    vc:enables ngm:transaction,
        ngm:wallet ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:governance-token,
        ngm:liquidity-pool,
        ngm:payment-token,
        ngm:security-token,
        ngm:stablecoin-token,
        ngm:utility-token ;
    vc:requires ngm:blockchain,
        ngm:smart-contract,
        ngm:token-standard ;
    vc:slug "erc20-token" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:gas,
        ngm:token-economics .

ngm:erc20-votes-standard a owl:Class ;
    rdfs:label "ERC20Votes Standard"@en ;
    rdfs:comment "ERC20Votes is an extension of the ERC-20 fungible-token standard that adds on-chain governance capabilities by tracking historical voting power through checkpointed balances and supporting delegation of votes. It records a snapshot of each account's balance at every block where it changes, so a governance contract can query voting weight at a specific past block, preventing double-voting and flash-loan manipulation. Implemented in widely audited libraries, it is the dominant pattern for token-based voting in decentralised autonomous organisations."@en ;
    rdfs:subClassOf ngm:erc20-standard ;
    vc:enables ngm:dao ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:erc-20-votes,
        ngm:ethereum ;
    vc:slug "erc20-votes-standard" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:smart-contract .

ngm:error-calculation a owl:Class ;
    rdfs:label "Error Calculation"@en ;
    rdfs:comment "Error calculation is the step in a control system that computes the difference between a desired setpoint and the measured process variable. This error term is the input that drives corrective action in feedback controllers such as PID loops. Accurate, low-latency error calculation is essential for stable and responsive position, velocity, and other regulated control behaviours."@en ;
    rdfs:subClassOf ngm:control-system ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:position-control,
        ngm:velocity-control ;
    vc:slug "error-calculation" ;
    vc:sourceDomain "robotics" .

ngm:error-signal a owl:Class ;
    rdfs:label "Error Signal"@en ;
    rdfs:comment "An error signal is the quantity in a feedback control system representing the instantaneous difference between the reference setpoint and the actual measured output. It is the driving input to the controller, which acts to reduce it toward zero. The error signal's magnitude, rate of change, and accumulated value are processed by proportional, derivative, and integral control terms respectively."@en ;
    rdfs:subClassOf ngm:control-system ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:derivative-control,
        ngm:feedback-loop ;
    vc:slug "error-signal" ;
    vc:sourceDomain "robotics" .

ngm:ethics-and-law a owl:Class ;
    rdfs:label "Ethics and Law"@en ;
    rdfs:comment "Ethics and law is the combined domain concerned with the moral principles and binding legal rules that govern the development and deployment of technology. Ethics addresses what ought to be done, while law codifies enforceable obligations such as liability, privacy, and rights. In AI and data governance the two are treated together because responsible systems must satisfy both normative expectations and statutory requirements."@en ;
    rdfs:subClassOf ngm:ai-governance-and-ethics ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:ai-ethics,
        ngm:governance ;
    vc:slug "ethics-and-law" ;
    vc:sourceDomain "governance" .

ngm:etsi-domain-identity-and-trust a owl:Class ;
    rdfs:label "ETSI Domain Identity and Trust"@en ;
    rdfs:comment "An ETSI governance domain establishing identity management, authentication, and trust infrastructure for virtual environments. It integrates decentralised identity models, verifiable credentials, biometric authentication, zero-trust architecture, and multi-party trust platforms aligned with eIDAS 2.0 and ISO/IEC 24760, enabling secure, privacy-respecting identity assurance across distributed metaverse platforms and consortia."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:digital-identity ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:zero-trust-architecture ],
        ngm:infra-security-and-identity ;
    skos:broader ngm:infra-security-and-identity ;
    vc:enables ngm:digital-identity-framework,
        ngm:digital-identity-wallet ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:etsi-domain-security-and-privacy ;
    vc:requires ngm:digital-identity,
        ngm:zero-trust-architecture ;
    vc:slug "etsi-domain-identity-and-trust" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:decentralised-identity,
        ngm:did-nostr-identity,
        ngm:verifiable-credentials .

ngm:etsi-domain-security-and-privacy a owl:Class ;
    rdfs:label "ETSI Domain Security and Privacy"@en ;
    rdfs:comment "The ETSI Domain Security and Privacy is a governance framework protecting metaverse ecosystems through comprehensive controls spanning cryptography, access management, data governance, and compliance measures. It addresses threat surface mapping, post-quantum cryptographic resilience, privacy-enhancing computation, digital evidence chain of custody, and psychological profiling safeguards for users of immersive environments."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:security-layer ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:privacy-enhancing-computation-pec ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:threat-surface-map ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:post-quantum-cryptography ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:zero-trust-architecture-zta ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:privacy-impact-assessment ],
        ngm:metaverse-governance-and-safeguarding,
        ngm:sc-governance-and-safety ;
    skos:broader ngm:sc-governance-and-safety ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:post-quantum-cryptography,
        ngm:privacy-impact-assessment,
        ngm:security-layer,
        ngm:threat-surface-map ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:digital-evidence-chain-of-custody,
        ngm:etsi-domain-identity-and-trust ;
    vc:requires ngm:privacy-enhancing-computation-pec,
        ngm:zero-trust-architecture-zta ;
    vc:slug "etsi-domain-security-and-privacy" ;
    vc:sourceDomain "spatial-computing" .

ngm:eu-ai-act-article-50 a owl:Class ;
    rdfs:label "EU AI Act Article 50"@en ;
    rdfs:comment "EU AI Act Article 50 establishes transparency obligations that apply to providers and deployers of specific categories of AI system within the European Union's Artificial Intelligence Act regulatory framework. The article requires that AI systems designed to interact with natural persons, or that generate synthetic audio, image, video, or text content, must disclose their AI nature to affected individuals. Providers of deep fake content generation tools are required to label outputs in machine-readable form, and broadcast media and online platforms carrying synthetic media must carry appropriate disclosures. The article represents the EU's approach to mandating content authentication and countering AI-generated deception at scale."@en ;
    rdfs:subClassOf ngm:eu-ai-act ;
    vc:contrastsWith ngm:high-risk-ai-system,
        ngm:prohibited-ai-practice ;
    vc:enables ngm:compliance-framework,
        ngm:content-authentication ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:ai-generated-content-disclosure,
        ngm:ai-transparency-framework,
        ngm:deepfakes ;
    vc:slug "eu-ai-act-article-50" ;
    vc:sourceDomain "governance" ;
    vc:supports ngm:conformity-assessment .

ngm:event-emission a owl:Class ;
    rdfs:label "Event Emission"@en ;
    rdfs:comment "Event emission is the act by which a smart contract or software component publishes a structured log entry recording that something notable occurred during execution. On blockchains, emitted events are written to transaction logs that off-chain applications and indexers subscribe to, since contracts cannot push data outward directly. Events provide a cheap, queryable record of state changes and are the primary bridge between on-chain logic and external systems."@en ;
    rdfs:subClassOf ngm:smart-contract ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:agent-event-stream,
        ngm:smart-contract ;
    vc:slug "event-emission" ;
    vc:sourceDomain "blockchain" .

ngm:event-sourcing a owl:Class ;
    rdfs:label "Event Sourcing"@en ;
    rdfs:comment "Event sourcing is an architectural pattern for data persistence in which the state of a system is stored not as a mutable current-state record but as an append-only, ordered log of discrete domain events — each representing a fact that occurred at a specific point in time. Current application state is derived by replaying the event log from the beginning (or from a periodic snapshot), making the full history of state transitions a first-class, queryable artefact. This contrasts with CRUD-oriented architectures where only the latest state is stored, discarding historical change information."@en ;
    rdfs:subClassOf ngm:software-architecture ;
    vc:enables ngm:agent-event-stream,
        ngm:state-management ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:audit-log,
        ngm:event-driven-architecture,
        ngm:microservices-architecture ;
    vc:slug "event-sourcing" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:apache-kafka,
        ngm:data-persistence,
        ngm:message-queue .

ngm:eventual-consistency a owl:Class ;
    rdfs:label "Eventual Consistency"@en ;
    rdfs:comment "A consistency model for distributed data stores in which, given no new updates, all replicas eventually converge to the same value. It favours availability and partition tolerance over immediate consistency."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:distributed-computing ],
        ngm:distributed-computing ;
    vc:enables ngm:distributed-storage ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:distributed-computing ;
    vc:slug "eventual-consistency" ;
    vc:sourceDomain "distributed-systems" .

ngm:exchange-mechanism a owl:Class ;
    rdfs:label "Exchange Mechanism"@en ;
    rdfs:comment "An Exchange Mechanism is a protocol or technical construct that governs the transfer of digital assets, tokens, or value between parties within a virtual economy or cross-platform environment. Exchange mechanisms specify the rules for matching buyers and sellers, executing atomic swaps, handling liquidity, and settling transactions, forming the economic infrastructure of metaverse marketplaces."@en ;
    rdfs:subClassOf ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:enables ngm:digital-asset-trading,
        ngm:marketplace ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:relatedTo ngm:liquidity-pool,
        ngm:token-economics ;
    vc:slug "exchange-mechanism" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:blockchain,
        ngm:smart-contract .

ngm:executive-sponsorship a owl:Class ;
    rdfs:label "Executive Sponsorship"@en ;
    rdfs:comment "Executive sponsorship is the active, visible backing of a major initiative by a senior leader who secures funding, removes organisational obstacles, and aligns the effort with strategy. It is widely identified as a critical success factor in technology adoption and transformation programmes because it confers authority, accountability, and resource commitment. Without credible executive sponsorship, large-scale initiatives commonly stall amid competing priorities."@en ;
    rdfs:subClassOf ngm:governance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:adoption-of-convergent-technologies,
        ngm:ai-adoption ;
    vc:slug "executive-sponsorship" ;
    vc:sourceDomain "governance" .

ngm:facial-capture-system a owl:Class ;
    rdfs:label "Facial Capture System"@en ;
    rdfs:comment "A facial capture system is hardware and software that records the detailed movements of a performer's face and transfers them onto a digital character or model. Such systems use head-mounted cameras, structured light, marker-based tracking, or markerless computer-vision pipelines to reconstruct expressions, lip movement, and micro-deformations in real time or in post-production. They are central to high-fidelity digital characters in film, games, and virtual production."@en ;
    rdfs:subClassOf ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:digital-performance-capture,
        ngm:motion-capture ;
    vc:slug "facial-capture-system" ;
    vc:sourceDomain "metaverse" .

ngm:feature-pyramid-network a owl:Class ;
    rdfs:label "Feature Pyramid Network"@en ;
    rdfs:comment "A Feature Pyramid Network (FPN) is a convolutional neural-network architecture that builds a multi-scale feature hierarchy with strong semantics at all levels by combining a bottom-up pathway with a top-down pathway and lateral connections. This design lets detectors and segmenters recognise objects across a wide range of sizes using features that are simultaneously high-resolution and semantically rich. FPN is a standard backbone component in modern object-detection and instance-segmentation pipelines."@en ;
    rdfs:subClassOf ngm:neural-network ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:image-segmentation,
        ngm:segmentation-and-identification ;
    vc:slug "feature-pyramid-network" ;
    vc:sourceDomain "ai" .

ngm:federation-surface a owl:Class ;
    rdfs:label "Federation Surface"@en ;
    rdfs:comment "A standardised JSON-LD 1.1 encoding surface (S1–S11) that exposes agent state, credentials, events, and work metadata in a queryable, linkable format, enabling federated consumption by heterogeneous external systems (monitoring dashboards, compliance audits, blockchain oracles, knowledge grap..."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:w-3-c-vocabulary ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:uri-canonicaliser ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:json-ld-1-1-standard ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:json-ld-context ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:content-addressing ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:linked-data-encoder ],
        ngm:infra-network-and-comms,
        ngm:middleware-layer ;
    skos:broader ngm:infra-network-and-comms ;
    vc:enables ngm:automated-monitoring,
        ngm:blockchain-oracle-integration,
        ngm:cross-system-querying,
        ngm:knowledge-graph-federation,
        ngm:linked-data-consumption ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:content-addressing,
        ngm:json-ld-context,
        ngm:linked-data-encoder,
        ngm:uri-canonicaliser ;
    vc:implements ngm:json-ld-1-1,
        ngm:w-3-c-linked-data-platform ;
    vc:qualityScore "0.86"^^xsd:float ;
    vc:requires ngm:http-endpoint,
        ngm:json-ld-1-1-standard,
        ngm:w-3-c-vocabulary ;
    vc:slug "federation-surface" ;
    vc:sourceDomain "infrastructure" .

ngm:fee-tier a owl:Class ;
    rdfs:label "Fee Tier"@en ;
    rdfs:comment "A fee tier is a discrete level of trading or swap fee applied to a market or liquidity pool, allowing different markets to charge fees commensurate with their volatility and liquidity risk. On automated-market-maker decentralized exchanges, each pool is created under a chosen fee tier (for example 0.05%, 0.30%, or 1.00%), and the collected fees accrue to liquidity providers. Tiering lets stable pairs use low fees while volatile or exotic pairs use higher fees to compensate providers."@en ;
    rdfs:subClassOf ngm:bc-defi-and-economics ;
    skos:broader ngm:bc-defi-and-economics ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:decentralized-exchange,
        ngm:liquidity-provision ;
    vc:slug "fee-tier" ;
    vc:sourceDomain "blockchain" .

ngm:feedback-sensor a owl:Class ;
    rdfs:label "Feedback Sensor"@en ;
    rdfs:comment "A feedback sensor is a transducer that measures the actual state of an actuator or controlled system, such as position, velocity, force, or current, and reports it back to a controller to close the control loop. By comparing the measured value with the commanded reference, the controller can correct errors and reject disturbances. Encoders, resolvers, tachometers, and load cells are common feedback sensors in servo and motion-control systems."@en ;
    rdfs:subClassOf ngm:sensor ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:dc-servo-motor,
        ngm:hydraulic-actuator ;
    vc:slug "feedback-sensor" ;
    vc:sourceDomain "robotics" .

ngm:feedforward-compensation a owl:Class ;
    rdfs:label "Feedforward Compensation"@en ;
    rdfs:comment "Feedforward compensation is a control technique that uses a model of the system or known disturbances to compute corrective control action in advance, rather than waiting for an error to appear at the output. By anticipating required effort, for example to overcome inertia, friction, or measurable load disturbances, it improves tracking and disturbance rejection beyond what feedback alone provides. It is typically combined with feedback control to handle modelling errors and unmeasured disturbances."@en ;
    rdfs:subClassOf ngm:control-system ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:position-control,
        ngm:velocity-control ;
    vc:slug "feedforward-compensation" ;
    vc:sourceDomain "robotics" .

ngm:film-vfx a owl:Class ;
    rdfs:label "Film VFX"@en ;
    rdfs:comment "Film VFX (Visual Effects) encompasses the full suite of techniques used to create, augment, or manipulate imagery in cinematic productions that cannot be practically achieved through conventional photography, including computer-generated imagery (CGI), digital compositing, motion capture-driven character animation, photorealistic simulation of natural phenomena, and digital environment creation. Modern film VFX pipelines integrate real-time rendering engines, deep learning-based tools for rotoscoping, denoising, and face replacement, and virtual production stages using LED volume displays to blend physical and digital environments in-camera rather than in post-production. VFX is distinct from practical effects (pyrotechnics, prosthetics) and from colour grading, though all three coexist within the broader post-production discipline."@en ;
    rdfs:subClassOf ngm:visual-effects ;
    vc:enables ngm:generative-content ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:film-production,
        ngm:motion-capture,
        ngm:neural-rendering,
        ngm:photorealistic-rendering,
        ngm:vfx-tools ;
    vc:slug "film-vfx" ;
    vc:sourceDomain "graphics" ;
    vc:uses ngm:diffusion-model,
        ngm:real-time-rendering,
        ngm:virtual-production .

ngm:filtration a owl:Class ;
    rdfs:label "Filtration"@en ;
    rdfs:comment "In probability theory, a filtration is an increasing family of sigma-algebras indexed by time that formally represents the accumulation of information available up to each instant. It models what is knowable at each point as a stochastic process unfolds, with each sigma-algebra containing all events whose outcomes are determined by then. Filtrations are fundamental to defining adapted processes, martingales, and conditional expectations in stochastic analysis and mathematical finance."@en ;
    rdfs:subClassOf ngm:machine-learning-technique ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:probabilistic-model,
        ngm:stochastic-process ;
    vc:slug "filtration" ;
    vc:sourceDomain "data" .

ngm:financial-crime-detection a owl:Class ;
    rdfs:label "Financial Crime Detection"@en ;
    rdfs:comment "Financial crime detection is the application of data analysis, machine learning, and rule-based systems to identify patterns indicative of money laundering, fraud, terrorist financing, bribery, market manipulation, and related illicit activities within financial transaction data. It operates at the intersection of compliance obligation and risk management, producing alerts that human investigators triage and escalate to regulatory or law-enforcement bodies."@en ;
    rdfs:subClassOf ngm:fraud-detection ;
    vc:enables ngm:anti-money-laundering,
        ngm:compliance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:aml-kyc-compliance,
        ngm:know-your-customer ;
    vc:slug "financial-crime-detection" ;
    vc:sourceDomain "finance" ;
    vc:supports ngm:blockchain-analytics ;
    vc:uses ngm:machine-learning,
        ngm:transaction-monitoring .

ngm:financial-infrastructure-domain a owl:Class ;
    rdfs:label "Financial Infrastructure Domain"@en ;
    rdfs:comment "The Financial Infrastructure Domain classifies concepts concerning the systems that move, clear and settle value between parties. It covers payment rails, settlement, clearing and the messaging standards that connect institutions. As a top-level subject axis it provides the operational substrate on which financial services and markets depend."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:settlement ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:security-domain ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:distributed-systems-domain ],
        ngm:owl-thing ;
    vc:enables ngm:real-time-settlement,
        ngm:value-transfer ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:central-counterparty,
        ngm:clearing,
        ngm:messaging-standard,
        ngm:payment-rail,
        ngm:settlement ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:distributed-systems-domain,
        ngm:security-domain ;
    vc:slug "financial-infrastructure-domain" ;
    vc:sourceDomain "financial-infrastructure" .

ngm:financial-privacy a owl:Class ;
    rdfs:label "Financial Privacy"@en ;
    rdfs:comment "Financial Privacy refers to the rights, mechanisms, and technical controls that protect individuals and organisations from unwanted disclosure of their financial transactions, holdings, and economic behaviour. It encompasses both legal frameworks—such as bank secrecy laws and GDPR financial data provisions—and cryptographic techniques such as zero-knowledge proofs, stealth addresses, and confidential transactions. The tension between financial privacy and regulatory transparency requirements (AML, KYC) is a defining challenge of the digital payments era, particularly as public blockchain ledgers make transaction histories permanently visible. Financial privacy is increasingly recognised as a precondition for personal autonomy, political freedom, and protection against targeted financial censorship."@en ;
    rdfs:subClassOf ngm:cryptography-security-and-privacy ;
    vc:contrastsWith ngm:blockchain-analytics,
        ngm:compliance-framework ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:aml-kyc-compliance,
        ngm:differential-privacy,
        ngm:zero-knowledge-proof ;
    vc:slug "financial-privacy" ;
    vc:sourceDomain "finance" ;
    vc:uses ngm:confidential-computing,
        ngm:homomorphic-encryption,
        ngm:zero-knowledge .

ngm:floating-point-arithmetic a owl:Class ;
    rdfs:label "Floating-Point Arithmetic"@en ;
    rdfs:comment "Floating-point arithmetic is a method of representing and computing with real numbers on digital hardware using a sign, a fixed-precision significand, and an exponent, most commonly standardised by IEEE 754. It trades exactness for a wide dynamic range, so operations introduce rounding error, and properties such as associativity no longer hold exactly. Understanding its precision limits, rounding modes, and special values is essential for numerically reliable simulation, graphics, and machine learning."@en ;
    rdfs:subClassOf ngm:computing-infrastructure ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:collision-detection,
        ngm:model-optimisation-and-performance ;
    vc:slug "floating-point-arithmetic" ;
    vc:sourceDomain "infrastructure" .

ngm:food-safety-blockchain a owl:Class ;
    rdfs:label "Food Safety Blockchain"@en ;
    rdfs:comment "Food Safety Blockchain is the application of distributed ledger technology to establish immutable, multi-party farm-to-fork audit trails that enable near-instantaneous contamination source identification and surgical product recalls. By recording each Critical Tracking Event—harvest, cooling, packing, shipment, receipt—as a cryptographically linked on-chain entry, the approach reduces trace-back from days to seconds, minimises the volume of food unnecessarily recalled, and provides regulators and consumers with verifiable provenance data."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:consortium-blockchain ],
        ngm:blockchain-application ;
    vc:enables ngm:audit-trail,
        ngm:provenance-tracking,
        ngm:supply-chain-traceability ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:blockchain-compliance,
        ngm:data-provenance,
        ngm:pharmaceutical-traceability,
        ngm:supply-chain-blockchain ;
    vc:requires ngm:consortium-blockchain ;
    vc:slug "food-safety-blockchain" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:hyperledger-fabric,
        ngm:internet-of-things,
        ngm:permissioned-blockchain,
        ngm:smart-contracts .

ngm:force-sensor a owl:Class ;
    rdfs:label "Force Sensor"@en ;
    rdfs:comment "A force sensor is a transducer that measures the magnitude (and sometimes direction) of an applied mechanical force or torque, typically by converting strain in an elastic element into an electrical signal. Single-axis load cells and multi-axis force-torque sensors give robots haptic awareness of contact and interaction forces. Such measurements are essential for compliant manipulation, assembly, and safe physical human-robot interaction."@en ;
    rdfs:subClassOf ngm:sensor ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:admittance-control,
        ngm:hydraulic-actuator ;
    vc:slug "force-sensor" ;
    vc:sourceDomain "robotics" .

ngm:forecast-horizon a owl:Class ;
    rdfs:label "Forecast Horizon"@en ;
    rdfs:comment "The forecast horizon is the length of time into the future over which a predictive model generates estimates, measured as the number of time steps ahead from the last observation. It is a key design parameter in time-series forecasting that trades off relevance against uncertainty, since predictive error generally grows with the horizon. Choice of horizon shapes model selection, evaluation strategy, and the operational decisions a forecast supports."@en ;
    rdfs:subClassOf ngm:machine-learning-technique ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:demand-forecasting,
        ngm:time-series-forecasting ;
    vc:slug "forecast-horizon" ;
    vc:sourceDomain "data" .

ngm:format-compliance a owl:Class ;
    rdfs:label "Format Compliance"@en ;
    rdfs:comment "Format compliance is the property of a digital asset or file conforming exactly to the structural, encoding, and schema rules of a defined file or data format specification. Verifying compliance ensures that assets can be reliably parsed, exchanged, and rendered by conformant tools across the supply chain. It is a precondition for interoperability between content producers and consumers."@en ;
    rdfs:subClassOf ngm:sc-standards-and-interop ;
    skos:broader ngm:sc-standards-and-interop ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:asset-format-standards,
        ngm:avatar-standard ;
    vc:slug "format-compliance" ;
    vc:sourceDomain "supply-chain" .

ngm:fractionalized-nft a owl:Class ;
    rdfs:label "Fractionalized NFT"@en ;
    rdfs:comment "A non-fungible token whose ownership has been divided into multiple fungible token shares, enabling collective ownership and enhanced liquidity of high-value unique digital assets."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:nft ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:fungible-token ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:smart-contract ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:token-standard ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:erc-1155 ],
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:enables ngm:collective-ownership,
        ngm:fractional-trading,
        ngm:nft-liquidity,
        ngm:price-discovery ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:fractionalization-contract,
        ngm:fungible-token,
        ngm:nft,
        ngm:ownership-registry ;
    vc:isPartOf ngm:shared-ownership-model,
        ngm:tokenization-system ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:erc-1155,
        ngm:fractionalization-protocol,
        ngm:smart-contract,
        ngm:token-standard ;
    vc:slug "fractionalized-nft" ;
    vc:sourceDomain "spatial-computing" .

ngm:frustum-culling a owl:Class ;
    rdfs:label "Frustum Culling"@en ;
    rdfs:comment "Frustum culling is a real-time rendering visibility optimisation technique that discards scene objects whose bounding volumes lie entirely outside the camera's view frustum—the truncated pyramid defined by the near and far clipping planes and the four side planes corresponding to the viewport edges. By testing object bounding spheres or axis-aligned bounding boxes against the six frustum planes before submitting draw calls, the GPU receives only geometry that could potentially contribute to the final image, dramatically reducing vertex processing and rasterisation work. It is a foundational stage in all production scene management pipelines."@en ;
    rdfs:subClassOf ngm:rendering-technique ;
    vc:enables ngm:performance-optimization,
        ngm:real-time-rendering,
        ngm:scene-optimization ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:level-of-detail,
        ngm:occlusion-culling,
        ngm:scene-management ;
    vc:slug "frustum-culling" ;
    vc:sourceDomain "graphics" ;
    vc:uses ngm:scene-graph .

ngm:fuzzy-logic a owl:Class ;
    rdfs:label "Fuzzy Logic"@en ;
    rdfs:comment "Fuzzy Logic is a artificial intelligence concept and a type of Artificial Intelligence. that enables Control Systems."@en ;
    rdfs:subClassOf ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:enables ngm:control-system ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:slug "fuzzy-logic" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:game-ai a owl:Class ;
    rdfs:label "Game AI"@en ;
    rdfs:comment "Game AI is the branch of artificial intelligence applied to interactive entertainment, encompassing the design and implementation of non-player character behaviour, opponent strategy, pathfinding, procedural content generation, and narrative decision systems within game engines. It prioritises perceived intelligence, responsiveness, and entertainment value over computational optimality, distinguishing it from classical AI research focused on provably correct or globally optimal solutions."@en ;
    rdfs:subClassOf ngm:machine-learning ;
    vc:enables ngm:game-mechanics,
        ngm:procedural-content-generation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:generative-model,
        ngm:neural-network ;
    vc:slug "game-ai" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:game-engine,
        ngm:procedural-generation,
        ngm:reinforcement-learning .

ngm:game-narratives a owl:Class ;
    rdfs:label "Game Narratives"@en ;
    rdfs:comment "Interactive storytelling frameworks within metaverse gaming environments featuring branching storylines, player-driven plot progression, and adaptive narratives that evolve based on collective player decisions, creating dynamic and personalised gaming experiences."@en ;
    rdfs:subClassOf ngm:interactive-storytelling,
        ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:enables ngm:immersive-gaming-experiences ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:slug "game-narratives" ;
    vc:sourceDomain "spatial-computing" .

ngm:gas-fee a owl:Class ;
    rdfs:label "Gas Fee"@en ;
    rdfs:comment "A gas fee is the payment a user makes to a blockchain network to have a transaction or smart contract operation executed and included in a block."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:smart-contract ],
        ngm:transaction-fee ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:smart-contract ;
    vc:slug "gas-fee" ;
    vc:sourceDomain "blockchain" .

ngm:gaussian-distribution a owl:Class ;
    rdfs:label "Gaussian Distribution"@en ;
    rdfs:comment "A continuous probability distribution, also called the normal distribution, characterised by a symmetric bell-shaped density defined by its mean and variance."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:statistics ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:probability-theory ],
        ngm:probability-theory ;
    vc:enables ngm:bayesian-inference ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:probability-theory,
        ngm:statistics ;
    vc:slug "gaussian-distribution" ;
    vc:sourceDomain "mathematics" .

ngm:gaze-control a owl:Class ;
    rdfs:label "Gaze Control"@en ;
    rdfs:comment "Gaze control regulates robot eye and head movement to establish, maintain, and redirect visual attention toward objects and people, conveying robot intent and facilitating natural Human-Robot Interaction."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:target-tracking ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:visual-perception ],
        ngm:neural-network,
        ngm:robo-human-robot-interaction ;
    skos:broader ngm:robo-human-robot-interaction ;
    vc:enables ngm:attention-redirection,
        ngm:joint-attention,
        ngm:natural-interaction,
        ngm:social-signal-transmission ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:eye-movement-controller,
        ngm:gaze-target-estimator,
        ngm:head-movement-mechanism,
        ngm:visual-attention-model ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires ngm:camera-actuators,
        ngm:social-understanding,
        ngm:target-tracking,
        ngm:visual-perception ;
    vc:slug "gaze-control" ;
    vc:sourceDomain "robotics" .

ngm:gazebo-simulator a owl:Class ;
    rdfs:label "Gazebo Simulator"@en ;
    rdfs:comment "Gazebo Simulator (now branded Gz Sim following the Open Robotics / Intrinsic rebranding) is an open-source, physics-accurate 3D robotics simulator providing rigid-body dynamics (via ODE, Bullet, DART, or Simbody), sensor simulation (cameras, LiDAR, IMU, GPS), and a plugin architecture for custom ..."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:3-d-rendering-engine ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:urdf-robot-model ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:physics-engine ],
        ngm:robo-actuation-and-control,
        ngm:robotics ;
    skos:broader ngm:robo-actuation-and-control,
        ngm:robotics ;
    vc:enables ngm:hardware-in-the-loop-testing,
        ngm:multi-robot-simulation,
        ngm:reinforcement-learning-training,
        ngm:sensor-simulation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:gazebo-plugin-api,
        ngm:gz-physics-plugin,
        ngm:gz-rendering,
        ngm:gz-sensors,
        ngm:gz-transport,
        ngm:sdf-world-model ;
    vc:implements ngm:gz-transport-message-protocol,
        ngm:ros2-control-hardware-interface,
        ngm:sdformat-specification ;
    vc:isPartOf ngm:robot-operating-system,
        ngm:sim-to-real-transfer-workflow ;
    vc:qualityScore "0.55"^^xsd:float ;
    vc:requires ngm:3-d-rendering-engine,
        ngm:physics-engine,
        ngm:sdf-robot-description,
        ngm:urdf-robot-model ;
    vc:slug "gazebo-simulator" ;
    vc:sourceDomain "robotics" .

ngm:general-purpose-ai-model a owl:Class ;
    rdfs:label "General Purpose AI Model"@en ;
    rdfs:comment "An AI model that displays significant generality and is capable of competently performing a wide range of distinct tasks regardless of the way the model is placed on the market, as defined by EU AI Act Article 3(63). GPAI models face specific transparency and documentation obligations, with enhanced requirements for those meeting systemic risk thresholds based on training compute or high-impact capability benchmarks."@en ;
    rdfs:subClassOf ngm:ai-model-architecture ;
    skos:broader ngm:ai-model-architecture ;
    vc:dependsOn ngm:ai-governance,
        ngm:ai-regulation ;
    vc:enables ngm:large-language-models ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:ai-governance-framework ;
    vc:slug "general-purpose-ai-model" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:fine-tuning,
        ngm:pre-training,
        ngm:transformer-architecture .

ngm:generative-ai-domain a owl:Class ;
    rdfs:label "Generative AI Domain"@en ;
    rdfs:comment "The Generative AI Domain covers the application of generative models to produce text, images, audio, code and other content for end users. Its scope includes prompting, fine-tuning, retrieval augmentation and the integration of generative models into products and workflows. It is an applied sub-area of the Artificial Intelligence Domain that builds on the Generative Modelling Domain. The boundary excludes the formal study of the underlying distributions, which belongs to generative modelling."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:compute-layer ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:generative-modelling-domain ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:retrieval-augmented-generation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:natural-language-processing-domain ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:large-language-models ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:text-to-image-generation ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:prompt-engineering ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:fine-tuning ],
        ngm:artificial-intelligence-domain ;
    vc:enables ngm:code-assistance,
        ngm:content-generation,
        ngm:conversational-agents ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:fine-tuning,
        ngm:large-language-models,
        ngm:prompt-engineering,
        ngm:retrieval-augmented-generation,
        ngm:text-to-image-generation ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:compute-layer,
        ngm:generative-modelling-domain,
        ngm:natural-language-processing-domain ;
    vc:slug "generative-ai-domain" ;
    vc:sourceDomain "generative-ai" .

ngm:geospatial-data a owl:Class ;
    rdfs:label "Geospatial Data"@en ;
    rdfs:comment "Geospatial data is information that is explicitly tied to a location on or near the Earth's surface, expressed through coordinates, geometries, or raster grids. It encompasses vector features, satellite and aerial imagery, point clouds, and attributes associated with places. Such data powers mapping, navigation, logistics, and spatial analysis across many domains."@en ;
    rdfs:subClassOf ngm:data-management ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:logistics-optimization,
        ngm:point-cloud-generation ;
    vc:slug "geospatial-data" ;
    vc:sourceDomain "data" .

ngm:geospatial-engine a owl:Class ;
    rdfs:label "Geospatial Engine"@en ;
    rdfs:comment "Software platforms that stream, render, and process large volumes of geographic and 3D spatial data in real-time for metaverse applications, enabling digital twins of real-world locations, location-based experiences, and integration between physical geography and virtual environments."@en ;
    rdfs:subClassOf ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:enables ngm:geospatially-accurate-metaverse ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:slug "geospatial-engine" ;
    vc:sourceDomain "spatial-computing" .

ngm:geospatial-information a owl:Class ;
    rdfs:label "Geospatial Information"@en ;
    rdfs:comment "Geospatial Information is data that describes objects, events, or phenomena with reference to a location on or near the Earth's surface. It integrates coordinate systems, geographic data layers, and spatial analytics to support location-aware applications including digital twins, augmented reality overlays, and urban simulation."@en ;
    rdfs:subClassOf ngm:sc-standards-and-interop ;
    skos:broader ngm:sc-standards-and-interop ;
    vc:enables ngm:geospatial-engine,
        ngm:location-based-experience ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:relatedTo ngm:geospatial-technology,
        ngm:spatial-data-structure ;
    vc:slug "geospatial-information" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:coordinate-system,
        ngm:lidar,
        ngm:point-cloud .

ngm:global-explanation a owl:Class ;
    rdfs:label "Global Explanation"@en ;
    rdfs:comment "Interpretability techniques that characterise the overall behaviour, decision-making patterns, and feature importance of a machine learning model across its entire input space, rather than explaining individual predictions. Global explanations—such as feature importance rankings, partial dependence plots, and surrogate model trees—reveal systematic model tendencies and support auditing, debugging, and regulatory compliance."@en ;
    rdfs:subClassOf ngm:ai-technique,
        ngm:explainability ;
    skos:broader ngm:ai-technique ;
    vc:contrastsWith ngm:local-explanation ;
    vc:enables ngm:fairness,
        ngm:model-transparency ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:explainable-ai ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:slug "global-explanation" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:feature-importance,
        ngm:model-interpretability .

ngm:goal-configuration a owl:Class ;
    rdfs:label "Goal Configuration"@en ;
    rdfs:comment "A goal configuration is the desired target state of a robot or articulated system, expressed in its configuration space as a set of joint angles or a pose. Motion planners search for a collision-free path from the start configuration to this goal. Specifying it precisely is a prerequisite for path planning and trajectory generation."@en ;
    rdfs:subClassOf ngm:robo-navigation-and-planning ;
    skos:broader ngm:robo-navigation-and-planning ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:path-planning,
        ngm:trajectory-generation ;
    vc:slug "goal-configuration" ;
    vc:sourceDomain "robotics" .

ngm:goal-specification a owl:Class ;
    rdfs:label "Goal Specification"@en ;
    rdfs:comment "Goal specification is the formal description of what an autonomous agent or planner is meant to achieve, expressed as target states, conditions, objectives, or reward functions. It translates high-level intent into a representation that planning and reasoning systems can evaluate and pursue. Clear goal specification is essential for task planning and avoiding misaligned or unsafe agent behaviour."@en ;
    rdfs:subClassOf ngm:ai-agent-system ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:autonomous-agent,
        ngm:task-planning ;
    vc:slug "goal-specification" ;
    vc:sourceDomain "ai" .

ngm:google-deep-mind a owl:Class ;
    rdfs:label "Google DeepMind"@en ;
    rdfs:comment "Google DeepMind is an AI research laboratory formed in 2023 by the merger of Google Brain and the original DeepMind (acquired by Google in 2014), operating as a division of Alphabet Inc. It is responsible for foundational advances including AlphaGo, AlphaFold, Gemini, and numerous contributions to reinforcement learning and deep learning theory. The organisation pursues both long-term fundamental AI research and the development of AI products deployed across Google's services. With thousands of researchers across London, Mountain View, and other global locations, it is one of the largest and most influential AI research institutions in the world."@en ;
    rdfs:subClassOf ngm:ai-companies ;
    vc:contrastsWith ngm:anthropic,
        ngm:open-ai ;
    vc:enables ngm:gemini,
        ngm:reinforcement-learning ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:ai-alignment,
        ngm:ai-safety-research,
        ngm:artificial-general-intelligence ;
    vc:slug "google-deep-mind" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:deep-learning,
        ngm:large-language-models .

ngm:gpu-rendering a owl:Class ;
    rdfs:label "GPU Rendering"@en ;
    rdfs:comment "GPU rendering is the computation of images from 2D or 3D scene descriptions using the massively parallel processing units of a graphics processing unit rather than the CPU. By executing shading, rasterisation, and ray-tracing workloads across thousands of cores, it delivers real-time interactive graphics and accelerates offline rendering. It is foundational to game engines, visualisation, and digital-content creation tools."@en ;
    rdfs:subClassOf ngm:rendering-technique ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:animation-software,
        ngm:unreal-engine ;
    vc:slug "gpu-rendering" ;
    vc:sourceDomain "metaverse" .

ngm:gradient-checkpointing a owl:Class ;
    rdfs:label "Gradient Checkpointing"@en ;
    rdfs:comment "A memory-saving technique for training neural networks that stores only a subset of intermediate activations during the forward pass and recomputes the rest during the backward pass. It trades extra computation for reduced memory use."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:backpropagation ],
        ngm:backpropagation ;
    vc:enables ngm:deep-learning ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:backpropagation ;
    vc:slug "gradient-checkpointing" ;
    vc:sourceDomain "machine-learning" .

ngm:gradient-clipping a owl:Class ;
    rdfs:label "Gradient Clipping"@en ;
    rdfs:comment "A technique that limits the magnitude of gradients during backpropagation to prevent exploding gradients and training instability. Gradient clipping rescales gradients when their norm exceeds a threshold, enabling stable training of deep networks, especially recurrent architectures."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:backpropagation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:neural-network ],
        ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:enables ngm:deep-learning,
        ngm:recurrent-neural-network ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:large-language-models,
        ngm:optimiser ;
    vc:requires ngm:backpropagation,
        ngm:neural-network ;
    vc:slug "gradient-clipping" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:gradient-descent,
        ngm:loss-function .

ngm:grant-programs a owl:Class ;
    rdfs:label "Grant Programs"@en ;
    rdfs:comment "Grant Programs are structured resource allocation mechanisms through which DAOs and blockchain protocols deploy governance treasuries to ecosystem development, public goods, protocol research, and community initiatives. They range from prospective grants and quadratic funding (Gitcoin) to retroactive public goods funding (Optimism RetroPGF), and are administered by elected committees, independent foundations, or algorithmic allocation systems."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:governance-token ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:dao ],
        ngm:bc-governance-and-regulation ;
    skos:broader ngm:bc-governance-and-regulation ;
    vc:enables ngm:public-goods-funding ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.4"^^xsd:float ;
    vc:relatedTo ngm:tokenomics-governance ;
    vc:requires ngm:dao,
        ngm:governance-token ;
    vc:slug "grant-programs" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:dao-governance,
        ngm:treasury-management .

ngm:graph-algorithms a owl:Class ;
    rdfs:label "Graph Algorithms"@en ;
    rdfs:comment "A family of computational methods that operate on graph structures—nodes and edges—to solve problems such as shortest-path finding, community detection, ranking, and traversal. Graph algorithms are foundational to knowledge graph querying, social network analysis, and AI reasoning over relational data."@en ;
    rdfs:subClassOf ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:enables ngm:feature-importance,
        ngm:knowledge-graph-construction ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:machine-learning,
        ngm:neural-network ;
    vc:slug "graph-algorithms" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:knowledge-graph,
        ngm:sparql .

ngm:graph-analytics a owl:Class ;
    rdfs:label "Graph Analytics"@en ;
    rdfs:comment "Graph Analytics is a computational discipline that applies graph-theoretic algorithms to structured relational data in order to discover patterns, measure importance, detect communities, and predict missing links. It operates on data modelled as nodes (entities) and edges (relationships), enabling analyses that are intractable with tabular data models when relationship structure is central to insight."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:link-prediction ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:community-detection ],
        ngm:network-analysis ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:community-detection,
        ngm:link-prediction ;
    vc:qualityScore "0.85"^^xsd:float ;
    vc:relatedTo ngm:social-network-analysis ;
    vc:slug "graph-analytics" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:graph-neural-network,
        ngm:knowledge-graph .

ngm:h-264 a owl:Class ;
    rdfs:label "H.264"@en ;
    rdfs:comment "H.264, also known as AVC (Advanced Video Coding) or MPEG-4 Part 10, is a block-oriented, motion-compensated video compression standard jointly developed by the ITU-T and ISO/IEC and finalised in 2003. It achieves substantially better compression efficiency than its predecessors through advanced intra and inter prediction, variable block-size motion compensation, an in-loop deblocking filter, and context-adaptive entropy coding. For two decades it has been the most widely deployed video codec, used in streaming, broadcast, Blu-ray, video conferencing, and surveillance, with broad hardware acceleration."@en ;
    rdfs:subClassOf ngm:video-codec ;
    vc:enables ngm:video-encoding ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:technical-standard ;
    vc:slug "h-264" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:video-compression .

ngm:harmful-bias a owl:Class ;
    rdfs:label "Harmful Bias"@en ;
    rdfs:comment "Systematic and unjust discrimination in AI system outcomes that disadvantages individuals or groups based on protected characteristics (race, gender, age, disability, religion, etc.) or other sensitive attributes, resulting in material harm, dignity violations, or perpetuation of societal inequal..."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:bias-detection-methods ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:bias-mitigation-techniques ],
        ngm:ai-governance-and-ethics ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:contrastsWith ngm:fairness,
        ngm:fairness-metrics ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:ai-ethics,
        ngm:ai-risk ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:accountability,
        ngm:training-data ;
    vc:requires ngm:bias-detection-methods,
        ngm:bias-mitigation-techniques ;
    vc:slug "harmful-bias" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:hidden-layer a owl:Class ;
    rdfs:label "Hidden Layer"@en ;
    rdfs:comment "A hidden layer is an intermediate layer of neurons in a neural network situated between the input and output layers, whose activations are not directly observed. Each hidden layer applies a learned linear transformation followed by a non-linear activation, building increasingly abstract feature representations. Stacking multiple hidden layers is what gives deep networks their representational power."@en ;
    rdfs:subClassOf ngm:neural-network ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:deep-learning,
        ngm:feed-forward-network ;
    vc:slug "hidden-layer" ;
    vc:sourceDomain "ai" .

ngm:hidden-state a owl:Class ;
    rdfs:label "Hidden State"@en ;
    rdfs:comment "The vector representation of a token or sequence at any layer in a neural network, encoding contextualised information learned by the model. Hidden states are progressively refined through self-attention and feed-forward transformations, with deeper layers capturing increasingly abstract semantic features used in downstream tasks."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:token-embedding ],
        ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:enables ngm:language-modeling,
        ngm:transfer-learning ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:neural-network,
        ngm:transformer ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:attention-mechanism ;
    vc:requires ngm:token-embedding ;
    vc:slug "hidden-state" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:high-bandwidth-memory a owl:Class ;
    rdfs:label "High Bandwidth Memory"@en ;
    rdfs:comment "High Bandwidth Memory (HBM) is a 3D-stacked DRAM technology that places multiple memory dies on a silicon interposer adjacent to a processor, delivering very wide buses and high memory bandwidth at low power per bit. It is the standard memory for AI accelerators and GPUs where feeding compute units with data is the dominant bottleneck. HBM enables training and inference of large models that would otherwise be memory-bandwidth bound."@en ;
    rdfs:subClassOf ngm:hardware ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:compute-infrastructure,
        ngm:data-processing-hardware ;
    vc:slug "high-bandwidth-memory" ;
    vc:sourceDomain "infrastructure" .

ngm:holography a owl:Class ;
    rdfs:label "Holography"@en ;
    rdfs:comment "A technique for recording and reconstructing the full wavefront of light, including both amplitude and phase, to reproduce three-dimensional images. It records the interference pattern between a reference beam and light scattered from an object."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:camera ],
        ngm:owl-thing ;
    vc:enables ngm:holographic-display ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:camera ;
    vc:slug "holography" ;
    vc:sourceDomain "optics" .

ngm:htlc a owl:Class ;
    rdfs:label "HTLC"@en ;
    rdfs:comment "A Hashed Time-Locked Contract is a conditional payment construct that releases funds when a preimage is revealed before a deadline, otherwise refunding the sender."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:hash-function ],
        ngm:smart-contract ;
    vc:enables ngm:lightning-network,
        ngm:payment-channel ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:hash-function ;
    vc:slug "htlc" ;
    vc:sourceDomain "blockchain" .

ngm:htn-planning a owl:Class ;
    rdfs:label "HTN Planning"@en ;
    rdfs:comment "HTN (Hierarchical Task Network) planning is an automated planning approach that solves problems by recursively decomposing high-level compound tasks into ordered subtasks using a library of methods, until only directly executable primitive actions remain. Unlike classical goal-state planning, it encodes domain knowledge as task decompositions, yielding efficient, human-interpretable plans. HTN planning is widely used in robotics, game AI, and workflow automation."@en ;
    rdfs:subClassOf ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:ai-in-games,
        ngm:task-planning ;
    vc:slug "htn-planning" ;
    vc:sourceDomain "ai" .

ngm:human-agency-and-oversight a owl:Class ;
    rdfs:label "Human Agency and Oversight"@en ;
    rdfs:comment "Human Agency and Oversight is a core trustworthiness dimension of responsible AI that encompasses two coupled principles: human agency—protecting individuals' freedom to make informed, uncoerced decisions when interacting with or affected by AI systems—and human oversight—establishing technical and organisational mechanisms that allow authorised humans to monitor, intervene in, correct, or deactivate AI operations at appropriate granularity. The EU AI Act Article 14 mandates these mechanisms for high-risk AI systems, requiring that oversight be achievable by qualified natural persons who understand system outputs and can exercise meaningful authority over them."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:human-in-the-loop ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:explainability ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:transparency ],
        ngm:ai-governance-and-ethics ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:enables ngm:accountability,
        ngm:ai-safety,
        ngm:ai-trustworthiness ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:ai-governance,
        ngm:audit-trail,
        ngm:fairness,
        ngm:model-interpretability,
        ngm:robustness ;
    vc:requires ngm:explainability,
        ngm:human-in-the-loop,
        ngm:transparency ;
    vc:slug "human-agency-and-oversight" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:ai-governance-framework,
        ngm:ai-regulation .

ngm:hyperledger-iroha a owl:Class ;
    rdfs:label "Hyperledger Iroha"@en ;
    rdfs:comment "Hyperledger Iroha is a general-purpose permissioned Byzantine-fault-tolerant Distributed Ledger framework originally designed by Soramitsu (Tokyo, Japan) in collaboration with Hitachi, NTT Data and Colu, contributed to the Hyperledger Foundation (now Linux Foundation Decentralised Trust) ..."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:public-key-infrastructure ],
        ngm:bc-network-component,
        ngm:blockchain ;
    skos:broader ngm:bc-network-component,
        ngm:blockchain ;
    vc:enables ngm:asset-tokenisation,
