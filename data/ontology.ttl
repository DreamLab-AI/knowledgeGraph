        ngm:regulatory-reporting ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:digital-token-identifier,
        ngm:registration-authority ;
    vc:implements ngm:unique-identifier ;
    vc:isPartOf ngm:iso ;
