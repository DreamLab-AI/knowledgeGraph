ngm:disparate-impact a owl:Class ;
    rdfs:label "Disparate Impact"@en ;
    rdfs:comment "Disparate Impact is a legal doctrine and AI fairness concept denoting the condition where a facially neutral policy, practice, or algorithmic decision system produces outcomes that disproportionately disadvantage a legally protected group relative to a comparator group, regardless of discriminatory intent. Measured via the four-fifths rule or statistical significance tests, it is legally actionable in employment (US EEOC guidelines), lending, housing, and insurance, and is the analytical basis for algorithmic bias audits under the EU AI Act and GDPR. Remediation requires either demonstrating business necessity or adopting less discriminatory alternatives."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:bias-detection-methods ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:fairness-metrics ],
        ngm:ai-fairness,
        ngm:ai-governance-and-ethics ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:contrastsWith ngm:fairness-accuracy-tradeoffs,
        ngm:group-vs-individual-fairness ;
    vc:enables ngm:algorithmic-accountability,
        ngm:fairness-auditing-tools ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:algorithmic-bias,
        ngm:bias-mitigation-techniques,
        ngm:diversity-non-discrimination-and-fairness,
        ngm:harmful-bias,
        ngm:intersectional-fairness,
        ngm:regulatory-compliance ;
    vc:requires ngm:bias-detection-methods,
        ngm:fairness-metrics ;
    vc:slug "disparate-impact" ;
    vc:sourceDomain "artificial-intelligence" .

