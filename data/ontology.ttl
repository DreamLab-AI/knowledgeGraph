ngm:strict-encoding a owl:Class ;
    rdfs:comment "Strict encoding is a deterministic binary serialisation scheme used in the RGB protocol that guarantees a single canonical byte representation for any given data structure. By forbidding ambiguous orderings and optional layout choices, it ensures that independently computed commitments and hashes match exactly, which is essential for client-side validation. It pairs with strict types to give RGB its reproducible, consensus-free verification."@en ;
    rdfs:label "Strict Encoding"@en ;
    rdfs:subClassOf ngm:cryptographic-primitive ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:rgb-and-client-side-validation ;
    vc:relatedTo ngm:strict-types ;
    vc:slug "strict-encoding" ;
    vc:sourceDomain "blockchain" .
