ngm:semantic-interoperability a owl:Class ;
    rdfs:label "Semantic Interoperability"@en ;
    rdfs:comment "Semantic interoperability is the capability of disparate systems to exchange data with shared, unambiguous meaning by aligning data models, ontologies, and controlled vocabularies. Unlike syntactic interoperability, which concerns data format agreement, semantic interoperability requires that the interpretation of data values is consistent across system boundaries, typically enforced through shared ontologies, RDF triplestores, or standardised schema mappings. It underpins federated knowledge graphs, cross-platform data sharing, and machine-readable regulatory compliance."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ontology ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
