        ngm:proof-of-work,
        ngm:token-economics,
        ngm:transaction-fee ;
    vc:requires ngm:gas,
        ngm:gas-limit,
        ngm:transaction ;
    vc:slug "gas-price" ;
    vc:sourceDomain "blockchain" .

ngm:gini-coefficient a owl:Class ;
    rdfs:label "Gini Coefficient"@en ;
    rdfs:comment "The Gini coefficient is a scalar summary statistic derived from the Lorenz curve that measures the degree of inequality in a distribution, yielding 0 for perfect equality and 1 for maximum concentration in a single entity. Originally developed by statistician Corrado Gini to measure income and wealth inequality, it has been applied in blockchain analytics to quantify the concentration of token holdings, staking power, or validator stake across on-chain addresses. High Gini values in a proof-of-stake network signal plutocratic tendencies that may undermine decentralisation claims."@en ;
    rdfs:subClassOf ngm:bc-governance-and-regulation ;
    skos:broader ngm:bc-governance-and-regulation ;
    vc:contrastsWith ngm:proof-of-stake ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:financial-inclusion,
        ngm:token-economics,
        ngm:tokenomics ;
    vc:slug "gini-coefficient" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:blockchain-governance .

ngm:gitcoin-passport a owl:Class ;
    rdfs:label "Gitcoin Passport"@en ;
    rdfs:comment "Gitcoin Passport is a decentralised identity and sybil-resistance protocol that aggregates verifiable credentials from diverse identity providers—including Web2 platforms, biometric services, and on-chain activity records—into a composable score that attests to the humanness and trustworthiness of a wallet address. It is used primarily to protect quadratic funding rounds and other public goods allocation mechanisms from manipulation by coordinated sybil attacks. The passport stores credentials using the Ceramic Network and Decentralised Identifier standards, enabling portability across Web3 applications without centralising personal data. Its stamp-based architecture allows flexible weighting of identity evidence according to the risk tolerance of each application."@en ;
    rdfs:subClassOf ngm:decentralized-identity-did ;
    vc:enables ngm:public-goods-funding,
        ngm:quadratic-funding ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:identity-verification,
        ngm:sybil-attack,
        ngm:sybil-resistance,
        ngm:verifiable-credential-vc ;
    vc:slug "gitcoin-passport" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:did-document,
        ngm:gitcoin .

ngm:governance-domain a owl:Class ;
    rdfs:label "Governance Domain"@en ;
    rdfs:comment "The Governance Domain classifies concepts concerned with the structures, processes and decision rights by which collective systems are directed and held accountable. It covers the formation, ratification and enforcement of rules across organisations, protocols and public institutions. As a top-level subject axis, it is orthogonal to architectural Layer and provides the social and procedural framing for systems that other domains realise technically."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:accountability ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
