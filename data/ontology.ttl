        ngm:do-ra,
        ngm:dreambooth,
        ngm:lo-ra,
        ngm:ly-coris,
        ngm:noise-scheduler,
        ngm:resolution-bucketing,
        ngm:textual-inversion,
        ngm:wd14-tagger ;
    vc:implements ngm:cached-latent-encoding,
        ngm:do-ra,
        ngm:dream-booth-lo-ra,
        ngm:dreambooth-training,
        ngm:low-rank-adaptation,
        ngm:ly-coris,
