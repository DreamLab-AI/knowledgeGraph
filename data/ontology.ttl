ngm:hm-treasury a owl:Class ;
    rdfs:label "HM Treasury"@en ;
    rdfs:comment "HM Treasury (His Majesty's Treasury) is the United Kingdom government's principal economics and finance ministry, responsible for setting and implementing fiscal policy, managing public expenditure, and overseeing the financial services regulatory framework. Led by the Chancellor of the Exchequer, it coordinates macroeconomic strategy, tax policy, and sovereign debt management through the Debt Management Office. HM Treasury acts as the primary interface between the UK government and major financial regulators — including the Bank of England, the Financial Conduct Authority, and the Prudential Regulation Authority — establishing the legislative framework within which those bodies operate. It also leads the UK government's policy position on emerging financial technologies including cryptoassets, stablecoins, and central bank digital currencies."@en ;
    rdfs:subClassOf ngm:infra-legal-and-regulatory ;
    skos:broader ngm:infra-legal-and-regulatory ;
    vc:bridgesTo ngm:central-bank-digital-currency,
        ngm:cryptoasset-regulation,
        ngm:open-banking ;
    vc:contrastsWith ngm:european-central-bank,
        ngm:us-treasury ;
    vc:dependsOn ngm:bank-of-england,
        ngm:financial-conduct-authority ;
    vc:enables ngm:financial-regulation,
        ngm:monetary-policy,
        ngm:sovereign-debt-management ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:debt-management-office,
        ngm:office-for-budget-responsibility ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:anti-money-laundering,
        ngm:chancellor-of-the-exchequer,
        ngm:government-institution,
        ngm:prudential-regulation-authority ;
    vc:requires ngm:fiscal-policy,
        ngm:public-finance ;
    vc:slug "hm-treasury" ;
    vc:sourceDomain "finance" ;
    vc:standardizedBy ngm:financial-services-and-markets-act,
        ngm:uk-parliament ;
    vc:supports ngm:consumer-protection,
        ngm:economic-growth,
        ngm:financial-stability ;
    vc:uses ngm:public-spending,
        ngm:taxation .

