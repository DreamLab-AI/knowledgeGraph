ngm:epipolar-geometry a owl:Class ;
    rdfs:label "Epipolar Geometry"@en ;
    rdfs:comment "Epipolar Geometry is the projective geometry of stereo vision, describing the geometric relationship between two camera views of the same 3D scene. It is encapsulated in the Fundamental Matrix (uncalibrated cameras) and Essential Matrix (calibrated cameras), which constrain the search for correspondences between images to one-dimensional epipolar lines rather than the full 2D image plane."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:feature-matching ],
        ngm:computer-vision ;
    vc:bridgesTo ngm:augmented-reality,
