        ngm:transformer-architecture ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:bert,
        ngm:diffusion-model,
        ngm:large-language-model ;
    vc:requires ngm:query-key-value,
        ngm:scaled-dot-product-attention,
        ngm:softmax-function ;
    vc:slug "cross-attention" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:layer-normalisation,
        ngm:positional-encoding .

ngm:cross-entropy-loss a owl:Class ;
    rdfs:label "Cross-Entropy Loss"@en ;
    rdfs:comment "Cross-entropy loss is a differentiable scalar objective function that measures the dissimilarity between a model's predicted probability distribution and the true label distribution, computed as the negative log-likelihood of the correct class under the model's output. It is the canonical training objective for classification tasks and language modelling, directly optimising the model to assign maximum probability mass to correct outputs. Minimising cross-entropy is equivalent to maximising the likelihood of the training data under the model's parameterised distribution."@en ;
    rdfs:subClassOf ngm:loss-function ;
    vc:contrastsWith ngm:contrastive-loss,
        ngm:focal-loss,
        ngm:mean-squared-error ;
    vc:enables ngm:fine-tuning,
        ngm:language-modeling,
        ngm:model-training,
        ngm:supervised-learning ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.9"^^xsd:float ;
    vc:relatedTo ngm:direct-preference-optimisation,
        ngm:information-theory,
        ngm:kl-divergence,
        ngm:large-language-models,
        ngm:perplexity,
        ngm:reinforcement-learning-from-human-feedback,
        ngm:transformer ;
    vc:slug "cross-entropy-loss" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:backpropagation,
        ngm:gradient-descent,
        ngm:maximum-likelihood-estimation,
        ngm:softmax-function .

ngm:data-parallelism a owl:Class ;
    rdfs:label "Data Parallelism"@en ;
    rdfs:comment "Data parallelism is a parallel computing strategy in which the same operation is applied simultaneously to different partitions of a dataset distributed across multiple processing units. In machine learning it is the dominant approach to scaling model training: the model is replicated on every worker, each worker computes gradients on a distinct mini-batch shard, and gradients are aggregated through collective communication such as all-reduce before the synchronised parameter update. This contrasts with model parallelism, which splits a single model across devices, and underpins large-scale training on GPU and TPU clusters."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:collective-communication ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gpu-cluster ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:mini-batch ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:synchronisation ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:gradient-aggregation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:network-bandwidth ],
        ngm:parallel-processing ;
    vc:bridgesTo ngm:expert-parallelism,
        ngm:tensor-parallelism ;
    vc:contrastsWith ngm:federated-learning,
        ngm:model-parallelism,
        ngm:pipeline-parallelism ;
    vc:dependsOn ngm:backpropagation,
        ngm:gradient-descent,
        ngm:loss-function ;
    vc:enables ngm:large-scale-training,
        ngm:llm-pretraining,
        ngm:throughput-scaling ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:all-reduce,
        ngm:gradient-aggregation,
        ngm:gradient-compression,
        ngm:mini-batch,
        ngm:ring-all-reduce ;
    vc:isPartOf ngm:3d-parallelism,
        ngm:distributed-training ;
    vc:qualityScore "0.9"^^xsd:float ;
    vc:relatedTo ngm:deepspeed,
        ngm:high-performance-computing,
        ngm:sharded-data-parallel,
        ngm:zero-optimizer ;
    vc:requires ngm:collective-communication,
        ngm:gpu-cluster,
        ngm:nccl,
        ngm:network-bandwidth,
        ngm:synchronisation ;
    vc:slug "data-parallelism" ;
    vc:sourceDomain "machine-learning" ;
    vc:supports ngm:deep-learning,
        ngm:neural-network-training,
        ngm:transformer-architecture ;
    vc:uses ngm:mixed-precision-training,
        ngm:parameter-server,
        ngm:stochastic-gradient-descent .

ngm:defi-protocol a owl:Class ;
    rdfs:label "DeFi Protocol"@en ;
    rdfs:comment "A DeFi Protocol is a set of immutable or upgradeable smart contracts deployed on a public blockchain that implements a specific financial primitive—such as lending, decentralised exchange, derivatives, or yield aggregation—in a permissionless and non-custodial manner. Protocol logic encodes all rules governing asset custody, interest-rate models, fee distribution, and liquidation mechanics directly in on-chain code that executes deterministically without intermediaries. Most DeFi protocols expose a composable interface through standardised token standards so that outputs (liquidity tokens, receipt tokens, or yield-bearing positions) can be consumed as inputs by other protocols. Governance over protocol parameters is typically delegated to token holders via an on-chain voting system, making protocol evolution itself a decentralised process."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:blockchain-oracle ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:token-standard ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:erc-20 ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:governance-token ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:smart-contract ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:liquidity-pool ],
        ngm:decentralised-finance ;
    vc:bridgesTo ngm:cross-chain-bridge,
        ngm:regulatory-compliance ;
    vc:contrastsWith ngm:traditional-finance ;
    vc:dependsOn ngm:composability ;
    vc:enables ngm:flash-loan,
        ngm:liquidity-mining,
        ngm:yield-farming ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:governance-token,
        ngm:liquidity-pool,
        ngm:smart-contract ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:blockchain-security,
        ngm:dao,
        ngm:impermanent-loss,
        ngm:mev,
        ngm:tokenomics ;
    vc:requires ngm:blockchain-oracle,
        ngm:erc-20,
        ngm:token-standard ;
    vc:slug "defi-protocol" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:automated-market-maker,
        ngm:price-oracle,
        ngm:stablecoin .

ngm:difficulty-adjustment a owl:Class ;
    rdfs:label "Difficulty Adjustment"@en ;
    rdfs:comment "Difficulty Adjustment is a Proof-of-Work consensus mechanism that periodically recalibrates the cryptographic puzzle difficulty so that blocks are produced at a statistically stable rate (e.g., approximately every 10 minutes in Bitcoin). It ensures network stability and security as total hash rate fluctuates."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:hash-rate ],
        ngm:bc-protocol-and-consensus ;
    skos:broader ngm:bc-protocol-and-consensus ;
    vc:bridgesTo ngm:distributed-systems,
        ngm:game-theory ;
    vc:contrastsWith ngm:delegated-proof-of-stake,
        ngm:proof-of-stake ;
    vc:dependsOn ngm:block-header,
        ngm:blockchain-node,
        ngm:mining ;
    vc:enables ngm:block-production,
        ngm:mining-incentive,
        ngm:network-security,
        ngm:validator-node ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:feedback-control,
        ngm:nakamoto-consensus ;
    vc:isPartOf ngm:consensus-mechanism,
        ngm:proof-of-work ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:block-reward,
        ngm:halving,
        ngm:miner,
        ngm:transaction-fee ;
    vc:requires ngm:block-timestamp,
        ngm:hash-rate ;
    vc:slug "difficulty-adjustment" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:51-attack,
        ngm:decentralization ;
    vc:uses ngm:proof-of-work,
        ngm:sha-256 .

ngm:digital-governance a owl:Class ;
    rdfs:label "Digital Governance"@en ;
    rdfs:comment "Digital Governance is the set of policies, institutional frameworks, regulatory instruments, and accountability mechanisms through which societies, organisations, and governments manage the development, deployment, and societal impact of digital technologies and data systems. It encompasses rule-making for the internet, data protection, platform regulation, algorithmic accountability, and cybersecurity policy. Digital Governance operates at multiple levels — international, national, and organisational — and draws on both technical standards and legal norms to align technological capability with public values. As digital infrastructure becomes critical to economic and social life, effective digital governance balances innovation incentives with risk mitigation, rights protection, and equitable access."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:cybersecurity-policy ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:multi-stakeholder-governance ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:data-protection ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:digital-rights ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:regulatory-framework ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:algorithmic-accountability ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:digital-infrastructure ],
        ngm:ai-governance-and-ethics ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:bridgesTo ngm:ai-governance-and-ethics,
        ngm:blockchain,
