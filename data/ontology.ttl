        ngm:public-key-infrastructure,
        ngm:xml ;
    vc:slug "saml" ;
    vc:sourceDomain "security" ;
    vc:standardizedBy ngm:oasis ;
    vc:uses ngm:xml-encryption .

ngm:search-engine a owl:Class ;
    rdfs:label "Search Engine"@en ;
    rdfs:comment "A search engine is a software system that systematically crawls, indexes, and ranks digital content to retrieve relevant results in response to user queries. It combines web crawling, inverted-index construction, relevance ranking (including PageRank-style link analysis and learning-to-rank models), and query understanding (tokenisation, stemming, NLP) into an end-to-end pipeline. Modern search engines increasingly integrate semantic embeddings, dense retrieval, and large language model components to handle natural-language and multimodal queries. They constitute foundational information infrastructure for the open web, enterprise knowledge bases, e-commerce catalogues, and emerging spatial and metaverse content layers."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:relevance-ranking ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:natural-language-processing ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:query-processing ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:distributed-computing ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:inverted-index ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-storage ],
        ngm:information-retrieval ;
    vc:bridgesTo ngm:metaverse,
        ngm:retrieval-augmented-generation,
        ngm:spatial-search ;
    vc:contrastsWith ngm:knowledge-graph,
        ngm:recommendation-system ;
    vc:enables ngm:content-discovery,
        ngm:knowledge-discovery,
        ngm:question-answering ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:inverted-index,
        ngm:query-processing,
        ngm:relevance-ranking,
        ngm:web-crawler ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:enterprise-search,
        ngm:search-engine-optimisation,
        ngm:semantic-search ;
    vc:requires ngm:data-storage,
        ngm:distributed-computing,
        ngm:natural-language-processing ;
    vc:slug "search-engine" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:large-language-model,
        ngm:machine-learning,
        ngm:pagerank,
        ngm:vector-search .

ngm:serverless-architecture a owl:Class ;
    rdfs:label "Serverless Architecture"@en ;
    rdfs:comment "Serverless Architecture is a cloud execution model in which application logic is deployed as discrete, stateless functions that are provisioned and scaled automatically by the cloud provider in response to events, with billing proportional to actual execution time. By abstracting away server provisioning and capacity management, serverless architectures reduce operational overhead and enable fine-grained, event-driven compute patterns suited to metaverse backends, AI inference endpoints, and IoT data pipelines."@en ;
    rdfs:subClassOf ngm:infra-computing-and-cloud ;
    skos:broader ngm:infra-computing-and-cloud ;
    vc:contrastsWith ngm:computing-infrastructure ;
    vc:enables ngm:cloud-native-applications,
        ngm:microservices-architecture ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:software-infrastructure ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:slug "serverless-architecture" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:cloud-infrastructure,
        ngm:event-driven-architecture .

ngm:system-identification a owl:Class ;
    rdfs:label "System Identification"@en ;
    rdfs:comment "System identification is the discipline of constructing or refining a mathematical model of a dynamical system—parametric or non-parametric—from observed input-output experimental data, enabling accurate simulation and model-based control design. It spans classical methods such as prediction error minimisation, subspace identification, and autoregressive modelling for linear time-invariant systems, through to Gaussian process regression, neural ordinary differential equations, and physics-informed learning for nonlinear and hybrid systems. In robotics and mechatronics, system identification calibrates rigid-body dynamics parameters—link inertia tensors, joint friction coefficients, and actuator gains—required by whole-body controllers and model predictive controllers to generate physically consistent torque commands. The field occupies an intersection of statistical estimation theory, control engineering, and machine learning, and is foundational to closing the sim-to-real gap in data-driven robot learning."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:sensor-fusion ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:state-estimation ],
        ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:bridgesTo ngm:physics-informed-neural-network,
        ngm:sim-to-real-transfer ;
    vc:contrastsWith ngm:domain-randomisation,
        ngm:model-free-control ;
    vc:dependsOn ngm:experimental-design,
        ngm:physics-simulation,
        ngm:signal-processing ;
    vc:enables ngm:adaptive-control,
        ngm:digital-twin,
        ngm:model-predictive-control,
        ngm:whole-body-control ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.73"^^xsd:float ;
    vc:relatedTo ngm:observer-design,
        ngm:parameter-estimation,
        ngm:reinforcement-learning,
        ngm:structural-dynamics ;
    vc:requires ngm:excitation-trajectory,
        ngm:sensor-fusion,
        ngm:state-estimation ;
    vc:slug "system-identification" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:gaussian-process-regression,
        ngm:kalman-filter,
        ngm:maximum-likelihood-estimation,
        ngm:neural-ode,
        ngm:regression .

ngm:tracking-system a owl:Class ;
    rdfs:label "Tracking System"@en ;
    rdfs:comment "A Tracking System is a hardware and software assembly that continuously determines the position, orientation, and motion of one or more objects or agents within a defined reference frame, using sensing technologies such as optical cameras, inertial measurement units, electromagnetic emitters, ultrasound, GPS, or LiDAR. Tracking systems are foundational components of augmented and virtual reality, robotics, surgical navigation, sports analytics, logistics, and autonomous vehicles, where precise real-time knowledge of spatial state is essential for interaction, control, or safety."@en ;
    rdfs:subClassOf ngm:spatial-tracking-system ;
    vc:enables ngm:augmented-reality,
        ngm:autonomous-navigation,
        ngm:surgical-navigation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:pose-estimation,
        ngm:spatial-mapping ;
    vc:slug "tracking-system" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:computer-vision,
        ngm:imu,
        ngm:lidar,
        ngm:sensor-fusion,
        ngm:slam .

ngm:virtualisation a owl:Class ;
    rdfs:label "Virtualisation"@en ;
    rdfs:comment "Virtualisation is the creation of abstracted, software-defined representations of physical computing resources — processors, memory, storage and networks — allowing multiple isolated environments to share one set of hardware. A hypervisor or equivalent control layer presents each environment with the illusion of dedicated resources while multiplexing the underlying hardware. It is the foundational technology behind cloud computing, enabling consolidation, isolation, elastic provisioning and efficient utilisation of infrastructure."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:compute-resources ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:virtual-machine ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:resource-management ],
        ngm:infrastructure ;
    skos:broader ngm:infrastructure ;
    vc:bridgesTo ngm:kubernetes ;
    vc:dependsOn ngm:hardware-abstraction ;
    vc:enables ngm:cloud-computing,
        ngm:network-function-virtualization,
        ngm:scalability ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:virtual-machine ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:cloud-computing,
        ngm:hypervisor,
        ngm:operating-system ;
    vc:requires ngm:compute-resources,
        ngm:resource-management ;
    vc:slug "virtualisation" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:data-centre,
        ngm:resource-management ;
    vc:uses ngm:hardware-abstraction,
        ngm:hypervisor,
        ngm:operating-system .

ngm:vocabulary a owl:Class ;
    rdfs:label "Vocabulary"@en ;
    rdfs:comment "The complete set of unique tokens in a language model's tokenisation scheme, typically ranging from 32,000 to 128,000 entries in modern architectures. Vocabulary size directly governs embedding matrix dimensions, output layer size, and token-level granularity, with larger vocabularies improving expressiveness and training efficiency at the cost of increased memory during inference."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:neural-network-text-tokenisation ],
        ngm:sc-standards-and-interop ;
    skos:broader ngm:sc-standards-and-interop ;
    vc:enables ngm:inference,
        ngm:natural-language-processing ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:transformer ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires ngm:neural-network-text-tokenisation ;
    vc:slug "vocabulary" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:byte-pair-encoding,
        ngm:subword-tokenisation,
        ngm:word-piece .

ngm:wrapped-token a owl:Class ;
    rdfs:label "Wrapped Token"@en ;
    rdfs:comment "A Wrapped Token is a digital asset on one blockchain that represents, at a 1:1 peg, an asset from a different blockchain or currency system, created by locking the original asset in a custody mechanism (custodian, bridge smart contract, or MPC wallet) and minting an equivalent representation on the target chain. Wrapped tokens enable cross-chain liquidity by making assets from non-smart-contract blockchains (such as Bitcoin) or from other chains available within DeFi ecosystems. WBTC (Wrapped Bitcoin on Ethereum, ERC-20) is the canonical example, allowing Bitcoin to participate in Ethereum-based lending, trading, and yield protocols. Wrapped tokens introduce custodial or bridge risk as the peg relies on the integrity of the locking and minting mechanism."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:custodian ],
        ngm:cryptocurrency-token ;
    vc:bridgesTo ngm:automated-market-maker ;
    vc:contrastsWith ngm:algorithmic-stablecoin,
        ngm:native-token,
        ngm:synthetic-asset ;
    vc:dependsOn ngm:oracle,
        ngm:proof-of-reserve ;
    vc:enables ngm:cross-chain-interoperability,
        ngm:decentralized-exchange,
        ngm:decentralized-finance-de-fi,
        ngm:liquidity-pool,
        ngm:yield-farming ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:blockchain-interoperability,
        ngm:cross-chain-asset-transfer,
        ngm:cross-chain-bridge,
        ngm:liquid-staking-token,
        ngm:peg-mechanism ;
    vc:requires ngm:custodian,
        ngm:mint-burn-mechanism ;
    vc:slug "wrapped-token" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:erc-20,
        ngm:multi-party-computation,
        ngm:smart-contract,
        ngm:threshold-signature-scheme .

ngm:xr-hardware a owl:Class ;
    rdfs:label "XR Hardware"@en ;
    rdfs:comment "XR Hardware comprises the physical computing and sensing devices — including head-mounted displays, spatial computing headsets, hand-tracking controllers, haptic peripherals, and body-worn sensors — that enable augmented, mixed, and virtual reality experiences across the extended reality spectrum. These devices integrate high-resolution micro-display optics, inertial measurement units, inside-out positional tracking cameras, and wireless connectivity stacks to deliver low-latency immersive spatial content. Modern XR hardware increasingly embeds dedicated neural processing units for on-device spatial AI inference, eye-tracking modules for foveated rendering, and environmental depth sensors for real-time world reconstruction. The category spans standalone untethered headsets, tethered PC-class systems, and lightweight optical see-through spectacles optimised for always-on wearability."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:head-mounted-display ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:haptic-feedback ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:real-time-rendering ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:wireless-connectivity ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:inertial-measurement-unit ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:eye-tracking ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:depth-sensing ],
        ngm:spatial-computing ;
    skos:broader ngm:spatial-computing ;
    vc:bridgesTo ngm:digital-twin,
        ngm:edge-inference ;
    vc:contrastsWith ngm:desktop-computing,
        ngm:flat-panel-display ;
    vc:enables ngm:augmented-reality,
        ngm:foveated-rendering,
        ngm:mixed-reality,
        ngm:spatial-presence,
        ngm:virtual-reality ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:depth-sensing,
        ngm:eye-tracking,
        ngm:haptic-feedback,
        ngm:head-mounted-display,
        ngm:inertial-measurement-unit ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:human-computer-interaction,
        ngm:sc-display-and-rendering,
        ngm:wearable-computing ;
    vc:requires ngm:real-time-rendering,
        ngm:wireless-connectivity ;
    vc:slug "xr-hardware" ;
    vc:sourceDomain "spatial-computing" ;
    vc:standardizedBy ngm:khronos-group,
        ngm:open-xr ;
    vc:supports ngm:hand-tracking,
        ngm:passthrough-video,
        ngm:spatial-audio ;
    vc:uses ngm:inside-out-tracking,
        ngm:neural-processing-unit,
        ngm:simultaneous-localisation-and-mapping,
        ngm:spatial-computing .

ngm:accuracy a owl:Class ;
    rdfs:label "Accuracy"@en ;
    rdfs:comment "A classification performance metric representing the proportion of correct predictions made by an artificial intelligence model across all instances in a dataset, calculated as the ratio of the sum of true positives and true negatives to the total number of predictions, providing an aggregate measure of overall model correctness but potentially obscuring performance disparities across classes, particularly in datasets with imbalanced class distributions or asymmetric misclassification costs."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:true-negative ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:confusion-matrix ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ground-truth-labels ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:true-positive ],
        ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:bridgesTo ngm:computer-vision,
        ngm:evaluation-metric ;
    vc:contrastsWith ngm:f1-score,
        ngm:matthews-correlation-coefficient ;
    vc:dependsOn ngm:classification-threshold ;
    vc:enables ngm:model-selection,
        ngm:performance-monitoring ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:true-negative,
        ngm:true-positive ;
    vc:isPartOf ngm:model-evaluation,
        ngm:model-performance ;
    vc:qualityScore "0.68"^^xsd:float ;
    vc:relatedTo ngm:fairness,
        ngm:sensitivity,
        ngm:specificity ;
    vc:requires ngm:confusion-matrix,
        ngm:ground-truth-labels ;
    vc:slug "accuracy" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:standardizedBy ngm:iso-iec-25059,
        ngm:nist-ai-rmf ;
    vc:uses ngm:precision,
        ngm:recall,
        ngm:roc-curve .

ngm:ai-inference a owl:Class ;
    rdfs:label "AI Inference"@en ;
    rdfs:comment "AI Inference is the operational phase of a machine learning system in which a trained model processes new input data to generate predictions, classifications, embeddings, or generative outputs — as distinct from the training phase in which model parameters are optimised. It is the production-time workload that determines the latency, throughput, cost, and scalability characteristics experienced by end users and downstream systems. Inference encompasses the full serving stack: model loading and memory management, request batching, hardware-specific kernel execution, and output post-processing. Modern inference optimisation techniques — including quantisation, speculative decoding, continuous batching, and KV-cache management — are essential for deploying large models at commercially viable cost."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:inference-runtime ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:continuous-batching ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:speculative-decoding ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:kv-cache ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:flash-attention ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:hardware-accelerator ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:model-weights ],
        ngm:machine-learning ;
    vc:bridgesTo ngm:cloud-computing,
        ngm:distributed-systems ;
    vc:contrastsWith ngm:fine-tuning,
        ngm:model-training ;
    vc:dependsOn ngm:deep-learning,
        ngm:model-training ;
    vc:enables ngm:autonomous-agent,
        ngm:computer-vision,
        ngm:generative-ai,
        ngm:natural-language-processing,
        ngm:real-time-ai-inference ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:continuous-batching,
        ngm:flash-attention,
        ngm:kv-cache,
        ngm:prefix-caching,
        ngm:speculative-decoding ;
    vc:qualityScore "0.91"^^xsd:float ;
    vc:relatedTo ngm:edge-computing,
        ngm:inference-compute,
        ngm:inference-optimisation,
        ngm:mlops,
        ngm:model-serving,
        ngm:on-device-ai,
        ngm:retrieval-augmented-generation ;
    vc:requires ngm:hardware-accelerator,
        ngm:inference-runtime,
        ngm:model-weights ;
    vc:slug "ai-inference" ;
    vc:sourceDomain "machine-learning" ;
    vc:uses ngm:ai-model,
        ngm:ai-model-architecture,
        ngm:gpu-acceleration,
        ngm:quantisation,
        ngm:tensor-parallelism .

ngm:annotated-training-data a owl:Class ;
    rdfs:label "Annotated Training Data"@en ;
    rdfs:comment "Annotated Training Data is a dataset whose examples have been augmented with ground-truth labels, bounding boxes, segmentation masks, or other targets that supervised models learn to predict. The annotations are produced by humans, programmatic rules, or model-assisted labeling and define the task the model is trained to solve. Its quality, coverage, and label consistency are primary determinants of supervised-model performance."@en ;
    rdfs:subClassOf ngm:machine-learning-discipline ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:cross-validation,
        ngm:segmentation-and-identification ;
    vc:slug "annotated-training-data" ;
    vc:sourceDomain "data" .

ngm:authentication-service a owl:Class ;
    rdfs:label "Authentication Service"@en ;
    rdfs:comment "An authentication service is a system component that verifies the identity of users, devices, or applications attempting to access protected resources. It validates credentials against stored identity information and issues tokens or assertions that enable authorised access across applications and services, forming the foundation of secure identity management in enterprise systems."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptography ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:public-key-infrastructure ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:identity-provider ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:credential-store ],
        ngm:infra-security-and-identity ;
    skos:broader ngm:infra-security-and-identity ;
    vc:bridgesTo ngm:decentralised-identity,
        ngm:security-services ;
    vc:contrastsWith ngm:authorisation ;
    vc:enables ngm:authorisation,
        ngm:federated-identity,
        ngm:multi-factor-authentication,
        ngm:session-management,
        ngm:single-sign-on ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:credential-store,
        ngm:identity-provider,
        ngm:token-service ;
    vc:implements ngm:identity-verification,
