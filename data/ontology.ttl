ngm:grasp-planning a owl:Class ;
    rdfs:label "Grasp Planning"@en ;
    rdfs:comment "Grasp planning is the computational problem of determining stable contact configurations between a robotic end-effector and an object, such that the resulting grasp resists external disturbances and enables the desired manipulation task. It combines geometric modelling of object shape, force-closure analysis, kinematics constraints, and task-level objectives to synthesise executable grasp poses."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:robot-kinematics ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:perception-system ],
        ngm:manipulation ;
    vc:bridgesTo ngm:computer-vision,
        ngm:reinforcement-learning ;
    vc:dependsOn ngm:end-effector,
