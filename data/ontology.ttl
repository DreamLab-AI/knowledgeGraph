ngm:text-summarisation a owl:Class ;
    rdfs:label "Text Summarisation"@en ;
    rdfs:comment "Text summarisation is the NLP task of producing concise, coherent summaries that capture the essential information from longer documents or collections. Systems employ extractive methods (selecting key sentences) or abstractive methods (generating new text) using transformer architectures such as BART, PEGASUS, and T5, with applications spanning news aggregation, research synthesis, and document retrieval."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:language-modeling ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:natural-language-processing ],
        ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:enables ngm:information-retrieval ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:prompt-engineering,
        ngm:text-generation ;
    vc:requires ngm:language-modeling,
        ngm:natural-language-processing ;
    vc:slug "text-summarisation" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:bart,
        ngm:large-language-models .

ngm:text-summarization a skos:Concept ;
    rdfs:label "Text Summarization"@en .

ngm:text-to-3-d a owl:Class ;
    rdfs:label "Text-to-3D"@en ;
    rdfs:comment "Text-to-3D is a generative AI capability that synthesises three-dimensional geometry, texture, and material properties from natural-language descriptions, bridging the gap between linguistic intent and spatial representation. Dominant technical approaches include score-distillation sampling (SDS) that distils a 2D diffusion prior into a NeRF or 3D Gaussian Splatting field, multi-view diffusion models that jointly generate consistent images from multiple viewpoints before reconstructing a mesh, and image-conditioned 3D reconstruction pipelines. Text-to-3D has transformative applications in game asset creation, virtual production, digital twins, augmented-reality content authoring, and e-commerce visualisation, dramatically reducing the time and expertise required to populate 3D environments."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:diffusion-model ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:neural-radiance-field ],
        ngm:ai-application,
        ngm:generative-ai ;
    skos:broader ngm:ai-application ;
    vc:enables ngm:3-d-asset,
        ngm:3-d-model,
        ngm:digital-twin ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:3-d-content-generation,
        ngm:3-d-reconstruction,
        ngm:augmented-reality,
        ngm:image-generation,
        ngm:virtual-reality ;
    vc:requires ngm:diffusion-model,
        ngm:neural-radiance-field ;
    vc:slug "text-to-3-d" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:3-d-gaussian-splatting,
        ngm:computer-vision,
        ngm:prompt-engineering,
        ngm:text-to-image .

