ngm:stakeholder a owl:Class ;
    rdfs:label "Stakeholder"@en ;
    rdfs:comment "Any individual, group, organisation, or entity that has an interest in, is affected by, influences, or holds rights regarding an artificial intelligence system throughout its lifecycle, including those who develop, deploy, operate, use, regulate, are impacted by, or hold accountability for AI systems, as well as broader society and communities whose interests may be affected by AI system design, deployment, or outcomes, encompassing both direct participants in AI value chains and indirect parties with legitimate concerns about AI systems' societal implications."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:accountability ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:ai-user ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:ai-provider ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:transparency ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:ai-operator ],
        ngm:infra-legal-and-regulatory,
        ngm:regulatory-framework ;
    skos:broader ngm:infra-legal-and-regulatory ;
    vc:bridgesTo ngm:artificial-intelligence,
        ngm:distributed-collaboration ;
    vc:dependsOn ngm:stakeholder-engagement ;
    vc:enables ngm:ai-governance,
        ngm:ai-impact-assessment,
        ngm:risk-management ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:ai-operator,
        ngm:ai-provider,
        ngm:ai-user,
        ngm:civil-society ;
    vc:implements ngm:ai-ethics,
        ngm:regulatory-compliance ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:ai-governance,
        ngm:ai-impact-assessment,
        ngm:trust ;
    vc:requires ngm:accountability,
        ngm:participation,
        ngm:transparency ;
    vc:slug "stakeholder" ;
    vc:sourceDomain "governance" ;
    vc:supports ngm:fairness,
        ngm:governance-framework,
        ngm:human-rights-due-diligence .

ngm:systems-engineering a owl:Class ;
    rdfs:label "Systems Engineering"@en ;
    rdfs:comment "Systems Engineering is an interdisciplinary methodology for designing, integrating, and managing complex systems over their entire lifecycle, from concept definition through disposal. It applies structured processes — requirements analysis, functional decomposition, architecture definition, interface control, verification, and validation — to ensure that the emergent behaviour of integrated subsystems meets overall system objectives within defined cost, schedule, and performance constraints. Systems Engineering is distinguished from narrower disciplines by its holistic perspective: it treats the system as a whole rather than optimising individual components in isolation. Governing standards include ISO/IEC/IEEE 15288 (Systems and Software Life Cycle Processes) and the INCOSE Systems Engineering Handbook."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:system-architecture ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:requirements-engineering ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:risk-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:stakeholder-analysis ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:configuration-management ],
        ngm:infra-software-engineering ;
    skos:broader ngm:infra-software-engineering ;
    vc:bridgesTo ngm:artificial-intelligence,
        ngm:cyber-physical-systems,
        ngm:robotics ;
    vc:contrastsWith ngm:project-management,
        ngm:software-engineering ;
    vc:enables ngm:digital-twin,
        ngm:technical-architecture-framework,
        ngm:technology-infrastructure ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:requirements-engineering,
        ngm:risk-management,
        ngm:system-architecture ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:computational-complexity-theory,
        ngm:lifecycle-management ;
    vc:requires ngm:configuration-management,
        ngm:model-based-systems-engineering,
        ngm:stakeholder-analysis ;
    vc:slug "systems-engineering" ;
    vc:sourceDomain "infrastructure" ;
    vc:standardizedBy ngm:open-standard ;
    vc:supports ngm:functional-safety,
        ngm:regulatory-compliance,
        ngm:robo-safety-and-standards ;
    vc:uses ngm:distributed-systems,
        ngm:formal-methods,
        ngm:simulation,
        ngm:software-engineering .

ngm:tcfd a owl:Class ;
    rdfs:label "TCFD"@en ;
    rdfs:comment "The Task Force on Climate-related Financial Disclosures (TCFD) is a disclosure framework established by the Financial Stability Board in 2015 under Mark Carney's initiative, designed to help companies and financial institutions consistently report material climate-related risks and opportunities in a format useful to investors, lenders, and insurers. The framework is structured around four thematic pillars—Governance, Strategy, Risk Management, and Metrics and Targets—and emphasises scenario analysis to disclose how different climate futures (aligned with 1.5°C, 2°C, or 4°C pathways) affect an organisation's financial position. TCFD recommendations have been incorporated into mandatory regulatory regimes in the UK, EU, New Zealand, and other jurisdictions, and serve as the conceptual foundation for the IFRS Sustainability Disclosure Standards (ISSB S2)."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:climate-governance ],
        ngm:sustainability-reporting ;
    vc:bridgesTo ngm:ngfs,
        ngm:sustainable-finance ;
    vc:enables ngm:climate-stress-testing,
        ngm:environmental-sustainability,
        ngm:green-finance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:climate-governance,
        ngm:climate-scenario-analysis,
        ngm:physical-risk,
        ngm:transition-risk ;
    vc:implements ngm:ifrs-s2 ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:climate-risk,
        ngm:esg-investing,
        ngm:esg-reporting,
        ngm:greenhouse-gas-emissions,
        ngm:net-zero,
        ngm:risk-assessment,
        ngm:risk-management,
        ngm:scenario-analysis,
        ngm:tnfd ;
    vc:slug "tcfd" ;
    vc:sourceDomain "governance" ;
    vc:standardizedBy ngm:financial-stability-board,
        ngm:ifrs-foundation ;
    vc:supports ngm:investor-disclosure .

ngm:technology-infrastructure a owl:Class ;
    rdfs:label "Technology Infrastructure"@en ;
    rdfs:comment "Technology Infrastructure encompasses the foundational hardware, networking, cloud services, and software platforms upon which higher-level applications and services are built. In the metaverse and spatial-computing domains it includes compute clusters, edge nodes, low-latency networking, content delivery networks, and the operating standards and APIs that enable interoperable, scalable, and resilient digital environments."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:distributed-computing ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:edge-computing ],
        ngm:infra-computing-and-cloud ;
    skos:broader ngm:infra-computing-and-cloud ;
    vc:enables ngm:metaverse-and-telecollaboration,
        ngm:technology-ecosystem ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:distributed-computing,
        ngm:edge-computing ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:systems-engineering,
        ngm:technical-architecture-framework ;
    vc:slug "technology-infrastructure" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:machine-learning-discipline-infrastructure .

ngm:tiny-ml a owl:Class ;
    rdfs:label "TinyML"@en ;
    rdfs:comment "Machine learning inference deployed on resource-constrained microcontrollers with kilobyte-scale RAM, milliwatt power budgets, and MHz-range processors, enabling always-on intelligent sensing in IoT devices, wearables, and embedded sensors without cloud connectivity. Requires aggressive model optimisation through INT8 quantisation, pruning, and knowledge distillation."@en ;
    rdfs:subClassOf ngm:ai-technique,
        ngm:deep-learning ;
    skos:broader ngm:ai-technique ;
    vc:enables ngm:ai-deployment ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:edge-ai-system,
        ngm:edge-computing,
        ngm:internet-of-things,
        ngm:knowledge-distillation-for-edge,
        ngm:on-device-learning ;
    vc:slug "tiny-ml" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:embedded-ai-frameworks,
        ngm:embedded-systems,
        ngm:model-compression-for-edge,
        ngm:model-pruning-for-edge-deployment,
        ngm:neural-network-quantisation .

ngm:tree-of-thoughts a owl:Class ;
    rdfs:label "Tree of Thoughts"@en ;
    rdfs:comment "Tree of Thoughts (ToT) is a deliberate reasoning framework for large language models that generalises linear chain-of-thought prompting into a tree-structured search over intermediate thought steps. At each node in the tree the model generates multiple candidate next-thoughts, evaluates their promise using an LLM-based heuristic, and selects branches to expand via breadth-first or depth-first search with backtracking. This enables systematic exploration of alternative reasoning paths and is particularly effective for combinatorial planning, mathematical proof construction, or multi-step problem-solving where greedy left-to-right decoding is insufficient. ToT was formalised by Yao et al. (2023) and represents the foundational instance of inference-time compute scaling through structured search."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:search-algorithm ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:large-language-models ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:prompt-engineering ],
        ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:bridgesTo ngm:heuristic-search,
        ngm:reinforcement-learning ;
    vc:contrastsWith ngm:chain-of-thought,
        ngm:react-prompting,
        ngm:self-consistency ;
    vc:enables ngm:automated-planning,
        ngm:mathematical-reasoning,
        ngm:multi-step-reasoning ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:search-algorithm ;
    vc:isPartOf ngm:inference-compute,
        ngm:reasoning ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:graph-of-thoughts,
        ngm:monte-carlo-tree-search,
        ngm:process-reward-model,
        ngm:speculative-decoding ;
    vc:requires ngm:large-language-models,
        ngm:prompt-engineering ;
    vc:slug "tree-of-thoughts" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:beam-search,
        ngm:breadth-first-search,
        ngm:depth-first-search .

ngm:trust-infrastructure a owl:Class ;
    rdfs:label "Trust Infrastructure"@en ;
    rdfs:comment "Foundational systems providing authentication, authorisation, encryption, and trust establishment mechanisms. Enables secure interaction between participants in distributed systems through cryptographic protocols, identity verification, and access control policies. Comprises the hardware, software, and procedural controls that collectively guarantee confidentiality, integrity, and availability of trusted communications."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:identity-provider ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:certificate-authority ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:physical-layer ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:public-key-infrastructure ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:key-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:encryption-service ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:network-layer ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptographic-primitive ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:access-control ],
        ngm:infra-security-and-identity ;
    skos:broader ngm:infra-security-and-identity ;
    vc:bridgesTo ngm:blockchain-governance,
        ngm:decentralised-identity,
        ngm:self-sovereign-identity ;
    vc:contrastsWith ngm:zero-trust-architecture ;
    vc:enables ngm:authentication,
        ngm:authorisation,
        ngm:data-confidentiality,
        ngm:non-repudiation,
        ngm:secure-communication ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:access-control,
        ngm:certificate-authority,
        ngm:encryption-service,
        ngm:identity-provider,
        ngm:key-management,
        ngm:public-key-infrastructure ;
    vc:implements ngm:policy-enforcement,
        ngm:trust-framework ;
    vc:qualityScore "0.68"^^xsd:float ;
    vc:relatedTo ngm:zero-knowledge-proof ;
    vc:requires ngm:cryptographic-primitive,
        ngm:network-layer,
        ngm:physical-layer ;
    vc:slug "trust-infrastructure" ;
    vc:sourceDomain "infrastructure" ;
    vc:standardizedBy ngm:oauth-2-0,
        ngm:open-id-connect,
        ngm:x509-standard ;
    vc:supports ngm:digital-signature,
        ngm:federated-identity .

ngm:utility-token a owl:Class ;
    rdfs:label "Utility Token"@en ;
    rdfs:comment "A blockchain token that confers its holder a right to access, use, or consume a specific product, service, or platform resource rather than representing equity or a claim on profits. Utility tokens derive value from the utility of the underlying service and are a primary means of bootstrapping decentralised protocol economies."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ledger ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:token-standard ],
        ngm:bc-token-and-asset,
        ngm:cryptocurrency-token ;
    skos:broader ngm:bc-token-and-asset ;
    vc:bridgesTo ngm:digital-economy,
