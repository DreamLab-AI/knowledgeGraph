        ngm:network-infrastructure,
        ngm:network-topology,
        ngm:security-architecture ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:digital-transformation,
        ngm:enterprise-architecture,
        ngm:microservices-architecture ;
    vc:slug "infrastructure-domain" ;
    vc:sourceDomain "infrastructure" .

ngm:inspection-robot a owl:Class ;
    rdfs:label "Inspection Robot"@en ;
    rdfs:comment "A specialised robotic system designed to autonomously examine physical structures, components, or manufactured products for defects, faults, or deviations from specification. Inspection robots combine computer vision, sensor fusion, and AI-driven anomaly detection to replace or augment manual quality-assurance processes in hazardous or high-throughput environments."@en ;
    rdfs:subClassOf ngm:robo-robot-type ;
    skos:broader ngm:robo-robot-type ;
    vc:enables ngm:quality-assurance ;
