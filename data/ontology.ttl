ngm:metaverse-interoperability a owl:Class ;
    rdfs:label "Metaverse Interoperability"@en ;
    rdfs:comment "Metaverse interoperability is the capability for users, avatars, digital assets, and experiences to move and function across multiple independently operated virtual worlds and platforms without loss of identity, ownership, or fidelity. It depends on shared standards for asset formats, identity, and transport, alongside the economic and governance arrangements that make cross-platform portability viable. The goal is an open, connected metaverse rather than a set of isolated walled gardens."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:decentralized-identity ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:interoperability-standard ],
        ngm:interoperability ;
    vc:bridgesTo ngm:cross-chain-bridge,
        ngm:open-metaverse ;
    vc:dependsOn ngm:digital-twin ;
    vc:enables ngm:avatar,
        ngm:digital-asset ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:metaverse ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:spatial-anchor,
        ngm:spatial-computing ;
    vc:requires ngm:decentralized-identity,
        ngm:interoperability-standard ;
    vc:slug "metaverse-interoperability" ;
    vc:sourceDomain "spatial-computing" ;
    vc:standardizedBy ngm:interoperability-protocol ;
    vc:supports ngm:asset-portability,
