    rdfs:label "Workflow Json Format"@en .
ngm:workflow-management a skos:Concept ;
    rdfs:label "Workflow Management"@en .
ngm:workflow-node a skos:Concept ;
    rdfs:label "Workflow Node"@en .
ngm:workflow-orchestration a owl:Class ;
    rdfs:comment "Workflow orchestration is the coordination of multiple interdependent tasks, services, or agents into a coherent end-to-end process, managing ordering, data flow, conditional branching, error handling, and resource allocation. It centralises control logic so that distributed components execute in the correct sequence with the right inputs. In agentic AI systems, orchestration governs how tool calls, sub-agents, and model invocations are sequenced to accomplish complex goals."@en ;
    rdfs:label "Workflow Orchestration"@en ;
    rdfs:subClassOf ngm:ai-agent-system ;
