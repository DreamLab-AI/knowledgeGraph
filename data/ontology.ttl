ngm:direct-preference-optimization a owl:Class ;
    rdfs:label "Direct Preference Optimization"@en ;
    rdfs:comment "Direct Preference Optimization (DPO) is a preference-based language model alignment algorithm introduced by Rafael Rafailov, Archit Sharma, Eric Mitchell, Stefano Ermon, Christopher D."@en ;
