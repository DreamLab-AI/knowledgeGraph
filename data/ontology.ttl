# Attention Aware Interaction
artificial-intelligence:AttentionAwareInteraction rdf:type owl:Class ;
    rdfs:subClassOf artificial-intelligence:HumanComputerInteraction ;
    rdfs:label "Attention Aware Interaction"@en ;
    rdfs:comment "Attention Aware Interaction refers to human-computer interaction techniques that leverage eye tracking, gaze detection, and attention modeling to understand user focus and adapt interfaces accordingly, enabling foveated rendering, gaze-based selection, and contextual content presentation in VR, AR, and metaverse environments."@en ;
