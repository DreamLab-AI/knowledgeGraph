    vc:contrastsWith ngm:few-shot-learning,
        ngm:reinforcement-learning,
        ngm:zero-shot-learning ;
    vc:dependsOn ngm:gradient-descent,
        ngm:large-language-model,
        ngm:transfer-learning ;
    vc:enables ngm:direct-preference-optimisation,
        ngm:instruction-following,
        ngm:reinforcement-learning-from-human-feedback,
        ngm:reward-model ;
    vc:hasMaturity ngmi:maturity-emerging ;
