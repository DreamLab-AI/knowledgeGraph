ngm:virtual-society a owl:Class ;
    rdfs:comment "An organised social structure emerging within virtual worlds and metaverse platforms, comprising the norms, governance mechanisms, economic systems, communities, and social interactions of persistent digital environments. Virtual societies exhibit properties analogous to physical societies — ownership, law, culture, and commerce — mediated through digital platforms, avatars, and blockchain-based economies."@en ;
    rdfs:label "Virtual Society"@en ;
    rdfs:subClassOf ngm:metaverse ;
    rdfs:subClassOf ngm:sc-platform-and-environment ;
