ngm:distributed-ledger-technology a owl:Class ;
    rdfs:label "Distributed Ledger Technology"@en ;
    rdfs:comment "Distributed Ledger Technology (DLT) is a class of decentralised database protocols in which transaction records are replicated, shared, and synchronised across multiple networked nodes without a central administrator. Consensus mechanisms — including proof-of-work, proof-of-stake, and Byzantine fault-tolerant protocols — ensure agreement on the canonical ledger state across participants who may not mutually trust one another. DLT encompasses permissionless public networks such as Bitcoin and Ethereum as well as permissioned enterprise ledgers such as Hyperledger Fabric and R3 Corda, spanning use cases in finance, supply chain, identity management, and tokenised assets. The technology achieves tamper-evidence through cryptographic chaining of records, making retrospective alteration computationally infeasible."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:cryptographic-hash-function ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:consensus-mechanism ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:blockchain ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:digital-signature ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:merkle-tree ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:public-key-cryptography ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:peer-to-peer-network ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:network-protocol ],
        ngm:distributed-systems ;
    vc:bridgesTo ngm:federated-learning,
        ngm:internet-of-things,
        ngm:zero-knowledge-proof ;
    vc:contrastsWith ngm:centralised-database,
        ngm:payment-system ;
    vc:enables ngm:central-bank-digital-currency,
        ngm:decentralised-finance,
        ngm:self-sovereign-identity,
        ngm:smart-contract,
        ngm:tokenization ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:blockchain,
        ngm:consensus-mechanism,
        ngm:cryptographic-hash-function,
        ngm:merkle-tree,
        ngm:peer-to-peer-network ;
    vc:implements ngm:byzantine-fault-tolerance,
        ngm:immutability ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:blockchain-governance,
        ngm:data-integrity,
        ngm:digital-asset,
        ngm:financial-regulation,
        ngm:supply-chain-transparency ;
