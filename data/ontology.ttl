    vc:slug "adversarial-attacks" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:age-verification a owl:Class ;
    rdfs:label "Age Verification"@en ;
    rdfs:comment "Age verification is a set of technical and procedural mechanisms used to confirm that a user meets a minimum age threshold before accessing restricted digital content or services. It encompasses document-based checks, biometric estimation, and privacy-preserving cryptographic proofs. Regulatory frameworks such as the UK Online Safety Act mandate age verification for platforms hosting harmful content. The field balances effective enforcement against privacy risks and the potential exclusion of legitimate users."@en ;
    rdfs:subClassOf ngm:compliance-verification ;
    vc:enables ngm:content-moderation,
        ngm:parental-controls ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
