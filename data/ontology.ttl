    vc:relatedTo ngm:constitutional-ai,
        ngm:ipo,
        ngm:iterative-dpo,
        ngm:kto,
        ngm:online-dpo,
        ngm:orpo,
        ngm:rlhf,
        ngm:sim-po ;
    vc:requires ngm:cross-entropy-loss,
        ngm:frozen-reference-policy,
        ngm:gpu-compute,
        ngm:pairwise-preference-data,
        ngm:stochastic-gradient-descent,
        ngm:supervised-fine-tuned-model ;
    vc:slug "direct-preference-optimization" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:standardizedBy ngm:aisi-inspect-framework,
        ngm:axolotl,
        ngm:hugging-face-trl,
        ngm:iclr,
