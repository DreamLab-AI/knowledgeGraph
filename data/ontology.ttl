            owl:someValuesFrom ngm:carbon-footprint-measurement ],
        ngm:governance ;
    vc:bridgesTo ngm:federated-learning,
        ngm:smart-contracts ;
    vc:contrastsWith ngm:planned-obsolescence,
        ngm:rebound-effect ;
    vc:dependsOn ngm:energy-efficiency,
        ngm:regulatory-compliance,
        ngm:supply-chain-transparency ;
    vc:enables ngm:circular-economy,
        ngm:green-computing,
        ngm:renewable-energy-certificates ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:economic-sustainability,
        ngm:environmental-sustainability,
        ngm:social-sustainability ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:blockchain-energy-consumption,
        ngm:digital-equity,
        ngm:scope-3-emissions ;
    vc:requires ngm:carbon-footprint-measurement,
        ngm:esg-reporting,
        ngm:life-cycle-assessment ;
    vc:slug "sustainability" ;
    vc:sourceDomain "infrastructure" ;
    vc:standardizedBy ngm:ghg-protocol,
        ngm:iso-14001,
        ngm:w3c-sustainable-web-design ;
    vc:supports ngm:carbon-aware-computing,
        ngm:digital-accessibility,
        ngm:net-zero .

ngm:microservices-architecture a owl:Class ;
    rdfs:label "Microservices Architecture"@en ;
    rdfs:comment "A distributed software architecture pattern that decomposes applications into independent, loosely coupled services communicating via APIs, enabling high concurrency, scalability, and resilience through containerisation technologies like Docker and orchestration platforms like Kubernetes."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
