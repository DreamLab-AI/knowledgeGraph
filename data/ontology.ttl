ngm:sensor-system a owl:Class ;
    rdfs:label "Sensor System"@en ;
    rdfs:comment "A sensor system is an integrated assembly of physical transducers, signal conditioning hardware, analogue-to-digital conversion, and data management software that captures physical-world phenomena and transforms them into structured digital representations suitable for processing, analysis, or control. Sensor systems range from single-chip inertial measurement units to multi-modal perception arrays combining cameras, LiDAR, RADAR, and acoustic sensors. Calibration, synchronisation, and fusion across heterogeneous modalities are core engineering concerns. Sensor systems are foundational to robotics, autonomous vehicles, industrial IoT, and environmental monitoring."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:signal-processing ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:analog-to-digital-converter ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:sensor-data ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:calibration ],
        ngm:hardware-component ;
    vc:enables ngm:autonomous-navigation,
        ngm:perception-system,
        ngm:real-time-processing ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:analog-to-digital-converter,
        ngm:calibration,
        ngm:sensor-data,
        ngm:signal-processing ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:autonomous-vehicle,
        ngm:edge-computing,
        ngm:embedded-systems,
        ngm:reliability ;
    vc:slug "sensor-system" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:camera,
        ngm:imu,
        ngm:lidar,
        ngm:sensor-fusion .

ngm:sequencer a skos:Concept ;
    rdfs:label "Sequencer"@en .

ngm:series-elastic-actuator a owl:Class ;
    rdfs:label "Series Elastic Actuator"@en ;
    rdfs:comment "A Series Elastic Actuator (SEA) is a robotic joint mechanism that interposes a compliant spring element in series between the gearbox output and the load, deliberately introducing controlled elasticity into the drivetrain. By measuring the spring deflection with a position sensor, the SEA provides accurate, low-noise torque measurement without a dedicated force-torque sensor, while simultaneously providing passive mechanical compliance that absorbs impact energy and reduces stiffness at the point of contact. This architecture enables safe, backdrivable interactions between robots and humans or unstructured environments."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:motor-driver ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:rotary-encoder ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:position-sensor ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:feedback-control ],
        ngm:robot-actuator ;
    vc:bridgesTo ngm:biomechanics,
        ngm:physical-human-robot-interaction-safety ;
    vc:contrastsWith ngm:hydraulic-actuator,
        ngm:quasi-direct-drive-actuator,
        ngm:rigid-actuator ;
    vc:enables ngm:human-robot-interaction,
        ngm:legged-locomotion,
        ngm:prosthetic-limb,
        ngm:soft-robotics ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:compliant-spring-element,
        ngm:gearbox,
        ngm:rotary-encoder,
        ngm:torque-control-loop ;
    vc:implements ngm:force-torque-estimation,
        ngm:series-elastic-actuation ;
    vc:isPartOf ngm:collaborative-robot,
        ngm:humanoid-robot,
        ngm:powered-exoskeleton ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:proprioceptive-actuator,
        ngm:robotic-joint,
        ngm:series-elastic-actuation,
        ngm:variable-stiffness-actuator ;
    vc:requires ngm:feedback-control,
        ngm:motor-driver,
        ngm:position-sensor ;
    vc:slug "series-elastic-actuator" ;
    vc:sourceDomain "robotics" ;
    vc:supports ngm:backdrivability,
        ngm:force-control,
        ngm:impedance-control,
        ngm:variable-impedance-control ;
    vc:uses ngm:hookes-law,
        ngm:pid-controller,
        ngm:position-sensor,
        ngm:torque-control .

ngm:service-robot a owl:Class ;
    rdfs:label "Service Robot"@en ;
    rdfs:comment "A Service Robot is an autonomous or semi-autonomous robotic system designed to perform tasks for humans in non-industrial settings such as healthcare, logistics, hospitality, and domestic environments. Unlike fixed industrial robots, service robots operate in dynamic, unstructured spaces and must navigate safely around people, relying on sensor fusion, motion planning, and human-robot interaction capabilities."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:motion-planning ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:sensor-fusion ],
        ngm:robo-robot-type ;
    skos:broader ngm:robo-robot-type ;
    vc:enables ngm:human-robot-interaction ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:relatedTo ngm:robot-control ;
    vc:requires ngm:motion-planning,
        ngm:sensor-fusion ;
    vc:slug "service-robot" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:autonomous-robot,
        ngm:computer-vision .

ngm:simulation-environment a owl:Class ;
    rdfs:label "Simulation Environment"@en ;
    rdfs:comment "A simulation environment is a software-defined system that models physical or virtual worlds with sufficient fidelity to support training, testing, or validation of agents, algorithms, or hardware without exposure to real-world risk or cost. It integrates a physics engine, sensor models, actuator dynamics, and observation/action interfaces, and is used across robotics, autonomous vehicle development, reinforcement learning research, and military mission planning. Fidelity-reality gaps — differences between simulated and real-world dynamics — are the primary challenge in transferring learned behaviours from simulation to deployment."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:action-space ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:rendering-engine ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:physics-engine ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:physics-engine ],
        ngm:simulation ;
    vc:bridgesTo ngm:digital-twin,
        ngm:metaverse,
        ngm:virtual-environment ;
    vc:contrastsWith ngm:hardware-in-the-loop,
        ngm:real-world-deployment ;
    vc:enables ngm:domain-randomisation,
        ngm:embodied-ai-simulation,
        ngm:reinforcement-learning,
        ngm:sim-to-real-transfer,
        ngm:synthetic-data-generation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:action-space,
        ngm:actuator-model,
        ngm:observation-space,
        ngm:physics-engine,
        ngm:sensor-model ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:openai-gym,
        ngm:physics-simulation,
        ngm:world-model ;
    vc:requires ngm:physics-engine,
        ngm:rendering-engine ;
    vc:slug "simulation-environment" ;
    vc:sourceDomain "robotics" ;
    vc:supports ngm:autonomous-vehicle-testing,
        ngm:robot-learning,
        ngm:simulation-engine ;
    vc:uses ngm:game-engine,
        ngm:neural-rendering .

ngm:sound-money a owl:Class ;
    rdfs:label "Sound Money"@en ;
    rdfs:comment "Sound Money refers to a monetary medium characterised by a stable, predictable supply that cannot be arbitrarily expanded by a government or central authority, thereby preserving purchasing power over time and functioning as a reliable store of value. The concept is historically associated with commodity-backed currencies—particularly the classical gold standard—and in the contemporary context with Bitcoin's algorithmically fixed supply schedule. Sound money theorists, drawing heavily on the Austrian School, argue that monetary expansion through credit creation distorts price signals, misallocates capital, and produces inflationary cycles that systematically transfer wealth from savers to debtors and from the public to the financial sector. The notion stands in direct opposition to the discretionary monetary policy frameworks of modern central banking."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:monetary-sovereignty ],
        ngm:monetary-system ;
    vc:bridgesTo ngm:cryptographic-proof-of-work,
        ngm:financial-sovereignty ;
    vc:contrastsWith ngm:central-bank-digital-currency,
        ngm:fiat-currency,
        ngm:fractional-reserve-banking,
        ngm:monetary-policy-implementation,
        ngm:quantitative-easing ;
    vc:dependsOn ngm:decentralised-consensus,
        ngm:property-rights ;
    vc:enables ngm:bitcoin-proof-of-work-protocol-value-proposition,
        ngm:hyperbitcoinization,
        ngm:long-term-savings,
        ngm:price-signal-integrity ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:bitcoin-protocol,
        ngm:gold-standard ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:austrian-economics,
        ngm:bitcoin-proof-of-work-protocol-standard,
        ngm:commodity-money,
        ngm:deflationary-economics,
        ngm:gold,
        ngm:inflation,
        ngm:purchasing-power,
        ngm:store-of-value ;
    vc:requires ngm:fixed-supply-schedule,
        ngm:monetary-sovereignty,
        ngm:scarcity ;
    vc:slug "sound-money" ;
    vc:sourceDomain "finance" .

ngm:speech-synthesis a owl:Class ;
    rdfs:label "SpeechSynthesis"@en ;
    rdfs:comment "Speech synthesis, or text-to-speech (TTS), is the artificial generation of human speech from text or linguistic representations using computational models that map phonetic, prosodic, and acoustic features to waveform output. Modern neural TTS systems use end-to-end deep learning pipelines—typically a text front-end, an acoustic model (Tacotron, FastSpeech, or diffusion-based), and a neural vocoder (WaveNet, HiFi-GAN, Vocos)—to produce speech that is perceptually natural, expressive, and stylistically controllable. Speech synthesis underpins screen readers, virtual assistants, navigation systems, voice cloning tools, and interactive conversational agents, and its quality is now at or approaching human parity on standard benchmarks for many languages."@en ;
    rdfs:subClassOf ngm:text-to-speech ;
    vc:enables ngm:speech-and-voice,
        ngm:voice-interaction ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:audio-processing,
        ngm:natural-language-processing,
        ngm:speech-recognition,
        ngm:voice-cloning ;
    vc:slug "speech-synthesis" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:deep-learning,
        ngm:neural-network-architecture .

ngm:sql a skos:Concept ;
    rdfs:label "Sql"@en .

ngm:stakeholder-trust a owl:Class ;
    rdfs:label "Stakeholder Trust"@en ;
    rdfs:comment "Stakeholder trust is the confident reliance that individuals, groups, or organisations — including users, operators, regulators, and affected communities — place in a system, institution, or technology to behave reliably, safely, and in accordance with stated values. In the context of AI and automated systems, stakeholder trust encompasses both calculative assessments of technical competence and affective judgements about integrity and ethical alignment, and is recognised as a prerequisite for adoption, legitimate deployment, and effective governance. It must be earned through demonstrated performance, transparency, and accountability rather than assumed."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:transparency ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:explainability ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:fairness ],
        ngm:trust ;
    vc:bridgesTo ngm:decentralised-governance,
        ngm:digital-identity ;
    vc:contrastsWith ngm:algorithmic-bias,
        ngm:automation-bias ;
    vc:dependsOn ngm:algorithmic-accountability,
        ngm:risk-communication ;
    vc:enables ngm:ai-governance,
        ngm:human-ai-collaboration,
        ngm:technology-adoption,
        ngm:trustworthy-ai ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:ai-trustworthiness,
        ngm:legitimacy,
        ngm:reputational-risk,
        ngm:social-licence-to-operate,
        ngm:stakeholder,
        ngm:stakeholder-engagement,
        ngm:trust-framework ;
    vc:requires ngm:auditability,
        ngm:explainability,
        ngm:fairness,
        ngm:transparency ;
    vc:slug "stakeholder-trust" ;
    vc:sourceDomain "governance" ;
    vc:supports ngm:accountability,
        ngm:ai-ethics,
        ngm:regulatory-compliance,
        ngm:trust-and-safety .

ngm:standards-compliance a owl:Class ;
    rdfs:label "Standards Compliance"@en ;
    rdfs:comment "The process of ensuring that systems, processes, products, or services meet the requirements of established technical standards, industry specifications, regulatory frameworks, and governance policies applicable to metaverse and virtual world technologies."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
