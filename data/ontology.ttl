ngm:collaborative-systems-modality-operation a owl:Class ;
    rdfs:label "Collaborative Operation"@en ;
    rdfs:comment "Collaborative Operation - Coordinated execution of tasks between Human Operators and Robotic Systems within the same workspace, governed by safety protocols, task allocation mechanisms, and real-time communication to achieve shared objectives."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:force-feedback ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:safety-monitoring ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:task-planning ],
        ngm:robo-human-robot-interaction ;
    skos:broader ngm:robo-human-robot-interaction ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:isPartOf ngm:human-robot-interaction,
