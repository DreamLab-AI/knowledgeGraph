    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:data-pipeline ;
    vc:relatedTo ngm:membership-inference ;
    vc:relatedTo ngm:model-inversion ;
    vc:relatedTo ngm:pattern-recognition ;
