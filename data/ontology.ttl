        ngm:autonomous-navigation ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:spatial-computing ;
    vc:qualityScore "0.4"^^xsd:float ;
    vc:requires ngm:sensor-fusion ;
    vc:slug "slam" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:deep-learning,
        ngm:pose-estimation .

ngm:access-control a owl:Class ;
    rdfs:label "Access Control"@en ;
    rdfs:comment "Access control is a fundamental security mechanism that regulates which users, systems, or processes can view, use, or modify resources within a computing environment."@en ;
