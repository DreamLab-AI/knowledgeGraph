ngm:development-platform a owl:Class ;
    rdfs:comment "A Development Platform is an integrated suite of tools, APIs, runtimes, and infrastructure services that enables engineers and creators to build, test, and deploy applications. In spatial computing contexts, development platforms provide SDKs for XR hardware, scene-graph editors, physics engines, and asset pipelines supporting OpenXR and Universal Scene Description (USD). They abstract hardware heterogeneity and supply governance tooling for collaborative multi-stakeholder development."@en ;
    rdfs:label "Development Platform"@en ;
    rdfs:subClassOf ngm:sc-platform-and-environment ;
