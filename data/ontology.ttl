    vc:slug "response-time-prediction" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:anomaly-detection,
        ngm:machine-learning .

ngm:revision-list a owl:Class ;
    rdfs:label "Revision List"@en ;
    rdfs:comment "A Revision List is a curated, task-tracked syllabus of technologies, frameworks, and concepts that a practitioner aims to learn or revisit, typically structured as a prioritised backlog with completion states. In a data science and AI context, such a list spans programming languages, ML frameworks, cloud platforms, DevOps tooling, and conceptual foundations such as deep learning, NLP, and reinforcement learning. It functions as a personal knowledge-gap audit and learning roadmap."@en ;
