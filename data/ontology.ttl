        ngm:leeds,
        ngm:liverpool,
        ngm:salford,
        ngm:urban-region ;
    vc:requires ngm:digital-infrastructure,
        ngm:transport-network ;
    vc:slug "manchester" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:distributed-collaboration,
        ngm:open-data,
        ngm:regional-connectivity .

ngm:manchester-tech-cluster a owl:Class ;
    rdfs:label "Manchester Tech Cluster"@en ;
    rdfs:comment "Manchester Tech Cluster is Greater Manchester's technology and digital innovation ecosystem, forming the UK's second-largest tech hub after London with over 10,000 digital businesses contributing a £5 billion digital economy. The cluster is anchored by MediaCityUK, the University of Manchester, Manchester Science Park, and the ID Manchester innovation district, with notable strengths in artificial intelligence, FinTech, and eCommerce."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
