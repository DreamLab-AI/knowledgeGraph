ngm:ai-game-agent a owl:Class ;
    rdfs:label "AI Game Agent"@en ;
    rdfs:comment "An AI Game Agent is an intelligent autonomous entity embedded within a video game or interactive virtual environment that perceives its local Game State through sensory abstraction, reasons over a structured decision framework, and executes goal-directed actions to create engaging, adaptive, and believable interactive experiences. Contemporary AI Game Agents synthesise classical symbolic control techniques — Finite State Machines, Behavior Trees, Goal-Oriented Action Planning, Hierarchical Task Networks — with data-driven methods including deep Reinforcement Learning, Imitation Learning from expert demonstrations, and Markov Decision Process formulations over Partially Observable environments. The most capable agents further incorporate Large Language Models as an 'inner monologue' for context-aware dialogue and high-level planning, while a learned Reinforcement Learning policy serves as the low-level action executor under Real-Time Constraints. The archetype spans NPC characters in narrative games, competitive game-playing agents trained through Self-Play such as AlphaGo and OpenAI Five, procedurally adaptive companions that model player behaviour through Player Modelling, and scripted simulation agents used in Automated Playtesting and Game Analytics pipelines."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:game-engine ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:decision-engine ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:state-machine ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:navigation-mesh ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:finite-state-machine ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:behavior-tree ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:markov-decision-process ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:pathfinding ],
        ngm:ai-agent-system,
        ngm:ai-application ;
    skos:broader ngm:ai-application ;
    vc:bridgesTo ngm:ai-in-games,
        ngm:intelligent-virtual-entity ;
    vc:enables ngm:automated-playtesting,
        ngm:dynamic-difficulty-adjustment,
        ngm:emergent-behavior,
        ngm:emergent-gameplay,
        ngm:player-engagement ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:behavior-tree,
        ngm:decision-engine,
        ngm:finite-state-machine,
        ngm:influence-map,
        ngm:npc-dialogue-system,
        ngm:pathfinding,
        ngm:state-machine ;
    vc:implements ngm:adaptive-difficulty,
