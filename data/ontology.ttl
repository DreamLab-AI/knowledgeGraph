ngm:cryptographic-signature a owl:Class ;
    rdfs:label "Cryptographic Signature"@en ;
    rdfs:comment "A cryptographic signature is a mathematical scheme that allows a private-key holder to produce an unforgeable, publicly-verifiable proof that a specific message or data item was authorised by them, delivering both authenticity and non-repudiation. The signing algorithm combines a cryptographic hash of the message with the signer's private key to produce a compact signature value; any party holding the corresponding public key can verify the signature without accessing the private key. Dominant schemes include ECDSA (Bitcoin, Ethereum), Ed25519 (Solana, Cosmos, OpenSSH), RSA-PSS (TLS, S/MIME), and Schnorr (BIP-340). Cryptographic signatures are a foundational primitive underpinning transaction authorisation, code signing, verifiable credentials, and authenticated key exchange across virtually all secure digital infrastructure."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:key-management ],
        ngm:asymmetric-cryptography ;
    vc:bridgesTo ngm:ai-model-provenance,
        ngm:self-sovereign-identity,
        ngm:supply-chain-attestation ;
    vc:contrastsWith ngm:message-authentication-code,
        ngm:symmetric-encryption ;
    vc:enables ngm:blockchain,
        ngm:code-signing,
        ngm:decentralised-identity,
        ngm:non-repudiation,
        ngm:smart-contract,
        ngm:verifiable-credential ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:implements ngm:ecdsa,
        ngm:ed25519,
        ngm:rsa-pss,
        ngm:schnorr-signature ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:blind-signature,
        ngm:multi-signature,
        ngm:post-quantum-cryptography,
        ngm:threshold-signature ;
    vc:requires ngm:key-management,
        ngm:public-key-infrastructure ;
    vc:slug "cryptographic-signature" ;
    vc:sourceDomain "security" ;
    vc:standardizedBy ngm:fips-186,
        ngm:ietf,
        ngm:nist ;
    vc:supports ngm:secure-email,
        ngm:transport-layer-security,
        ngm:zero-knowledge-proof ;
    vc:uses ngm:elliptic-curve-cryptography,
        ngm:hash-function,
        ngm:private-key,
        ngm:public-key,
        ngm:public-key-cryptography .

