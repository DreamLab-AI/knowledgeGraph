    vc:slug "prompt-engineering-reference-library" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:code-generation,
        ngm:prompt-engineering .

ngm:property-registry a owl:Class ;
    rdfs:label "Property Registry"@en ;
    rdfs:comment "Blockchain-based land title recording systems employing immutable distributed ledgers, cryptographic signatures, and timestamp verification to create tamper-proof property ownership records, reduce fraud, and accelerate transaction processing from 30–90 days to 72 hours. Dubai processed 188,000+ transactions worth AED 625 billion in 2024; Georgia was the first country to adopt blockchain land administration at national scale."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:distributed-ledger ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:smart-contract ],
        ngm:bc-token-and-asset,
        ngm:real-estate-tokenization ;
    skos:broader ngm:bc-token-and-asset ;
    vc:enables ngm:asset-registry,
        ngm:asset-tokenization ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:relatedTo ngm:decentralised-identity,
        ngm:digital-identity ;
    vc:requires ngm:distributed-ledger,
        ngm:smart-contract ;
    vc:slug "property-registry" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:blockchain,
        ngm:cryptography .

ngm:property-system a owl:Class ;
    rdfs:label "Property System"@en ;
    rdfs:comment "A Property System is a software architecture pattern for attaching typed key-value attributes to entities within a metaverse or game engine context, enabling data binding, runtime configuration, and dynamic object behaviour without hard-coded class inheritance. It underpins avatar customisation, world-object state management, and reactive UI data flows in spatial computing platforms."@en ;
    rdfs:subClassOf ngm:infra-software-engineering ;
    skos:broader ngm:infra-software-engineering ;
    vc:enables ngm:avatar-customization,
        ngm:avatar-system ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:spatial-computing ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:relatedTo ngm:asset-management,
        ngm:digital-asset ;
    vc:slug "property-system" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:game-engine .

ngm:provider-agnostic-dev-environment-tool a owl:Class ;
    rdfs:label "Provider-Agnostic Dev Environment Tool"@en ;
    rdfs:comment "DevPod is an open-source, provider-agnostic tool for creating reproducible cloud development environments defined by devcontainer specifications. It abstracts over compute providers — including local Docker, Kubernetes clusters, cloud VMs, and managed container services — allowing developers to spin up identical, pre-configured workspaces on any infrastructure without vendor lock-in. DevPod acts as a portable alternative to managed cloud IDE products such as GitHub Codespaces or GitPod, enabling teams to self-host development environments on their own Kubernetes or cloud infrastructure."@en ;
    rdfs:subClassOf ngm:infra-computing-and-cloud ;
    skos:broader ngm:infra-computing-and-cloud ;
    vc:enables ngm:compute-infrastructure ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:cloud-native-applications,
        ngm:microservices-architecture,
        ngm:software-development-process,
        ngm:virtual-machine ;
    vc:slug "provider-agnostic-dev-environment-tool" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:cloud-infrastructure,
        ngm:version-control .

ngm:psychological-phenomenon a owl:Class ;
    rdfs:label "Psychological Phenomenon"@en ;
    rdfs:comment "A Psychological Phenomenon, in the context of spatial computing, denotes any observable, reproducible effect on cognition, emotion, or behaviour that arises from interaction with immersive virtual environments. Established examples include the Proteus Effect (avatar-driven behavioural conformity), simulator sickness (sensorimotor conflict), flow states, social presence, and embodiment illusions. Understanding these phenomena is foundational to ethical metaverse design, therapeutic XR applications, and the study of human-computer interaction at scale."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:social-presence ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:vr-psychology ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:proteus-effect ],
        ngm:digital-human-avatar-representation,
        ngm:infra-software-engineering ;
    skos:broader ngm:infra-software-engineering ;
    vc:enables ngm:behavioral-modeling ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:proteus-effect,
        ngm:social-presence,
        ngm:vr-psychology ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:cognitive-science,
        ngm:embodied-ai,
        ngm:emotional-immersion,
        ngm:immersive-experience ;
    vc:slug "psychological-phenomenon" ;
    vc:sourceDomain "spatial-computing" .

ngm:pyodide-knowledge-graph-node-enumerator a owl:Class ;
    rdfs:label "Pyodide Knowledge Graph Node Enumerator"@en ;
    rdfs:comment "Python to list nodes is a Logseq Pyodide script that iterates over all pages in the knowledge graph, filters those with the `public:: true` metadata property, and returns a comma-separated list of public page names. It demonstrates direct integration of Python scripting with the Logseq Plugin API for programmatic knowledge-graph introspection and inventory generation."@en ;
    rdfs:subClassOf ngm:infra-software-engineering ;
    skos:broader ngm:infra-software-engineering ;
    vc:enables ngm:information-retrieval ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:software-engineering ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:data-governance,
        ngm:semantic-search ;
    vc:slug "pyodide-knowledge-graph-node-enumerator" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:knowledge-graph,
        ngm:knowledge-management .

ngm:pyodide-rag-corpus-builder-script a owl:Class ;
    rdfs:label "Pyodide RAG Corpus Builder Script"@en ;
    rdfs:comment "Python to build RAG data page is a Logseq Pyodide script that enumerates all pages with the `public:: true` property, loads their block content, applies text-cleaning routines (URL removal, bracket stripping, special-character normalisation), and appends the cleaned content to a dedicated FULLRAG page. This page then serves as the consolidated corpus for local Retrieval-Augmented Generation pipelines, enabling semantic search over the entire public knowledge graph without external data transfer."@en ;
    rdfs:subClassOf ngm:ai-application ;
    skos:broader ngm:ai-application ;
    vc:dependsOn ngm:embedding-model,
        ngm:vector-database ;
    vc:enables ngm:retrieval-augmented-generation,
        ngm:semantic-search ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:knowledge-management ;
    vc:slug "pyodide-rag-corpus-builder-script" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:data-pipeline,
        ngm:knowledge-graph,
        ngm:tokenization .

ngm:python-sample1 a owl:Class ;
    rdfs:label "Python Sample1"@en ;
    rdfs:comment "Python Sample1 is a Logseq Python code block that demonstrates the Logseq Plugin API via Pyodide: it defines helper utilities for inspecting JavaScript objects, appending timestamped entries to a named Logseq page, and searching all pages for a given term using the Logseq search API. The sample illustrates the pattern of bridging Python scripting with the Logseq knowledge-graph API for automated page discovery and log management."@en ;
    rdfs:subClassOf ngm:infra-software-engineering ;
    skos:broader ngm:infra-software-engineering ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:software-engineering ;
    vc:qualityScore "0.0"^^xsd:float ;
