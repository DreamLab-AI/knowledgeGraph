    vc:contrastsWith ngm:enterprise-service-bus,
        ngm:service-mesh ;
    vc:dependsOn ngm:load-balancer,
        ngm:service-discovery ;
    vc:enables ngm:api-integration,
        ngm:api-monetisation,
        ngm:microservices-architecture ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:api-gateway,
        ngm:authentication-service,
        ngm:developer-portal,
        ngm:monitoring-system ;
    vc:implements ngm:openapi-specification,
        ngm:zero-trust-security ;
    vc:isPartOf ngm:cloud-native-architecture ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:container-orchestration ;
    vc:requires ngm:identity-provider,
        ngm:tls-ssl ;
    vc:slug "api-management" ;
    vc:sourceDomain "infrastructure" ;
    vc:standardizedBy ngm:api-standard,
        ngm:openapi-initiative ;
    vc:supports ngm:api-versioning,
        ngm:rest-api ;
    vc:uses ngm:graph-ql,
        ngm:json-web-token,
        ngm:oauth-2-0 .

