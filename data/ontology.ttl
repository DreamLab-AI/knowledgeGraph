ngm:traceability a owl:Class ;
    rdfs:label "Traceability"@en ;
    rdfs:comment "Traceability is the ability to verify the history, location, or application of an item or piece of information by means of recorded identification. It requires that each unit or event be uniquely identified and that the linkages between successive states be persistently recorded, enabling both forward tracking from origin to destination and backward tracing from any point to its provenance. Traceability is foundational to supply-chain integrity, regulatory compliance, food and pharmaceutical safety, and software and data provenance, and it is increasingly underpinned by tamper-evident ledgers."@en ;
    rdfs:subClassOf ngm:process ;
    vc:enables ngm:compliance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.78"^^xsd:float ;
    vc:relatedTo ngm:provenance-tracking,
        ngm:supply-chain-traceability,
        ngm:traceability-mechanism ;
    vc:slug "traceability" ;
    vc:sourceDomain "supply-chain" .

