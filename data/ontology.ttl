        ngm:pre-training,
        ngm:transfer-learning .

ngm:machine-learning-discipline-technique a owl:Class ;
    rdfs:label "Machine Learning Technique"@en ;
    rdfs:comment "A specific algorithmic approach or methodology within machine learning used to enable systems to learn from data. Machine learning techniques span supervised, unsupervised, and reinforcement paradigms and include methods such as gradient descent optimisation, backpropagation, fine-tuning, transfer learning, boosting, and bagging that enable models to improve performance through exposure to training data."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:backpropagation ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:transfer-learning ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:fine-tuning ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:unsupervised-learning ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:reinforcement-learning ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:gradient-descent ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
