ngm:citi-token-services a owl:Class ;
    rdfs:label "Citi Token Services"@en ;
    rdfs:comment "A service from Citi that issues tokenised representations of institutional client deposits on a permissioned blockchain to support faster cash management and trade transactions. It operates within the bank's regulated infrastructure rather than on a public network."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:tokenization ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:permissioned-blockchain ],
        ngm:trade-finance ;
    vc:enables ngm:payment-channel ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:permissioned-blockchain,
        ngm:tokenization ;
    vc:slug "citi-token-services" ;
    vc:sourceDomain "blockchain" .

