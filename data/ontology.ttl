] .

# Well Being
spatial-computing:WellBeing rdf:type owl:Class ;
    rdfs:label "Well Being"@en ;
    rdfs:comment "AI should enhance human and societal well-being by augmenting human capabilities, enriching quality of life, supporting physical and mental health, enabling meaningful work, strengthening social connections, and contributing to flourishing individuals and communities."@en ;
    skos:prefLabel "Well Being"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:spatial-computing:well-being" ;
    owl:sameAs <urn:visionclaw:concept:spatial-computing:well-being> ;
    vcw:contentHash "sha256-12-5f53e67749a3" ;
    vcw:qualityScore "0.5"^^xsd:decimal ;
    vcw:legacyTermId "AI-0158" ;
    vcw:ontologyStatus "draft" ;
    vcw:maturityLevel "draft" ;
    vcw:authorityScore "0.0"^^xsd:decimal ;
    dcterms:identifier "AI-0158" ;
    dcterms:subject "spatial-computing" ;
