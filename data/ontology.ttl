    vc:standardizedBy ngm:iso-27701 ;
    vc:supports ngm:digital-rights,
        ngm:information-security ;
    vc:uses ngm:data-breach-notification,
        ngm:data-protection-impact-assessment .

ngm:dc-servo-motor a owl:Class ;
    rdfs:label "DC Servo Motor"@en ;
    rdfs:comment "DC servo motor combines a direct-current electric motor with integrated or external feedback control electronics to enable precise position, velocity, or torque regulation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:feedback-sensor ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:power-supply ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:mechanical-load ],
