        ngm:document-authentication,
        ngm:legal-compliance,
        ngm:non-repudiation,
        ngm:provenance-verification,
        ngm:tamper-evidence,
        ngm:trusted-timestamping ;
    vc:hasPart ngm:audit-trail-generator,
        ngm:blockchain-anchoring,
        ngm:certificate-authority-interface,
        ngm:digital-signature-verification,
        ngm:hash-function-module,
        ngm:timestamping-service,
        ngm:verification-protocol ;
    vc:maturity "established" ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:cryptographic-hash-function,
        ngm:digital-signature,
        ngm:distributed-ledger-technology-dlt,
        ngm:identity-verification,
        ngm:public-key-infrastructure,
        ngm:timestamp-authority ;
    vc:slug "virtual-notary-service" ;
    vc:sourceDomain "spatial-computing" .

