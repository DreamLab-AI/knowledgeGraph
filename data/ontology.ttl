ngm:ark-protocol a owl:Class ;
    rdfs:label "Ark Protocol"@en ;
    rdfs:comment "Ark is a layer-two protocol for Bitcoin that uses shared, periodically refreshed off-chain outputs to let users transact cheaply and privately while retaining the ability to settle on the base chain."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:bitcoin ],
