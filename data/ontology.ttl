ngm:sme-ai-productivity-toolkit a owl:Class ;
    rdfs:label "SME AI Productivity Toolkit"@en ;
    rdfs:comment "Consumer Tools for SMEs encompasses the accessible AI-powered productivity applications, creative tools, and automation platforms used by small and medium enterprises. These tools lower the barrier to adopting generative AI and workflow automation without requiring technical expertise or enterprise-scale infrastructure investment."@en ;
    rdfs:subClassOf ngm:infra-computing-and-cloud ;
    skos:broader ngm:infra-computing-and-cloud ;
    vc:enables ngm:workflow-automation ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:relatedTo ngm:ai-assisted-developer-tooling,
        ngm:blockchain ;
    vc:slug "sme-ai-productivity-toolkit" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:generative-ai,
        ngm:large-language-models .

