    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:cryptography ;
    vc:slug "multisig" ;
    vc:sourceDomain "blockchain" .

ngm:nakamoto-coefficient a owl:Class ;
    rdfs:label "Nakamoto Coefficient"@en ;
    rdfs:comment "The Nakamoto Coefficient is a quantitative metric for blockchain decentralisation, defined as the minimum number of independent entities in a given subsystem (such as mining pool concentration, validator set, or client software diversity) whose collusion or failure would be sufficient to compromise network security, liveness, or integrity. A higher Nakamoto Coefficient indicates a more resilient, decentralised network; a coefficient of one denotes a single point of failure. The metric is applicable across multiple dimensions of a network simultaneously, yielding a multi-dimensional decentralisation profile rather than a single scalar."@en ;
    rdfs:subClassOf ngm:bc-governance-and-regulation ;
    skos:broader ngm:bc-governance-and-regulation ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:51-attack,
        ngm:blockchain-governance,
        ngm:sybil-resistance ;
    vc:slug "nakamoto-coefficient" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:proof-of-stake,
        ngm:validator-set .

ngm:natural-interaction a owl:Class ;
    rdfs:label "Natural Interaction"@en ;
    rdfs:comment "Natural Interaction describes human-computer interaction modalities that leverage innate human capabilities—speech, gesture, gaze, touch, and whole-body movement—rather than requiring users to learn abstract symbolic interfaces such as keyboards or command-line syntax. The goal is to reduce cognitive translation costs and make technology accessible to a broader range of users by aligning the interaction channel with the way humans naturally communicate and manipulate objects in the physical world. Natural interaction is foundational to spatial computing, mixed reality, and embodied AI systems where traditional 2D pointing devices are ergonomically or practically unsuitable."@en ;
    rdfs:subClassOf ngm:human-computer-interaction ;
    vc:enables ngm:embodied-ai,
        ngm:spatial-computing,
        ngm:voice-interaction ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:eye-tracking,
        ngm:gesture-recognition,
        ngm:haptic-feedback,
        ngm:speech-recognition ;
    vc:slug "natural-interaction" ;
    vc:sourceDomain "metaverse" ;
    vc:uses ngm:conversational-ai,
        ngm:hand-tracking,
        ngm:multimodal-ai-architecture-ai .

ngm:network-hash-rate a owl:Class ;
    rdfs:label "Network Hash Rate"@en ;
    rdfs:comment "The aggregate computational power (measured in hashes per second) expended by all miners participating in a proof-of-work blockchain at a given time. A higher network hash rate increases attack cost for a 51% attack and triggers upward difficulty adjustments to maintain target block times; conversely, drops in hash rate trigger downward adjustments."@en ;
    rdfs:subClassOf ngm:bc-protocol-and-consensus,
        ngm:blockchain-entity,
        ngm:consensus-protocol ;
    skos:broader ngm:bc-protocol-and-consensus ;
    vc:enables ngm:nakamoto-consensus ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:51-attack,
        ngm:block-reward,
        ngm:difficulty-adjustment,
        ngm:mining-pool,
        ngm:proof-of-work,
        ngm:selfish-mining ;
    vc:slug "network-hash-rate" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:cryptographic-hash-function,
        ngm:mining .

ngm:network-segmentation a owl:Class ;
    rdfs:label "Network Segmentation"@en ;
    rdfs:comment "Network segmentation is the security practice of dividing a computer network into smaller, isolated zones so that traffic between them is controlled, inspected, and restricted by policy. By limiting the blast radius of a compromise, segmentation prevents an attacker who breaches one zone from moving laterally to others. It is a core control in defence-in-depth and a prerequisite for zero-trust network architectures."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:firewall ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:network-architecture ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:access-control ],
        ngm:network-security ;
    vc:contrastsWith ngm:network-architecture ;
    vc:dependsOn ngm:firewall,
        ngm:software-defined-networking ;
    vc:enables ngm:defence-in-depth,
        ngm:zero-trust-architecture ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:firewall,
        ngm:microsegmentation,
        ngm:vlan ;
    vc:isPartOf ngm:network-security ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:access-control,
        ngm:lateral-movement ;
    vc:requires ngm:access-control,
        ngm:network-architecture ;
    vc:slug "network-segmentation" ;
    vc:sourceDomain "security" ;
    vc:standardizedBy ngm:iec-62443 ;
    vc:supports ngm:network-security ;
    vc:uses ngm:firewall .

ngm:neuro-symbolic-ai a owl:Class ;
    rdfs:label "Neuro Symbolic Ai"@en ;
    rdfs:comment "Neuro-symbolic AI integrates neural (sub-symbolic) learning with symbolic reasoning and knowledge representation to combine the perceptual strengths of deep networks with the interpretability, compositionality and logical rigour of symbolic systems. It aims to deliver models that learn from data yet reason over explicit knowledge, support verifiable inference and generalise from limited examples. Architectures range from neural networks that produce symbolic structures to symbolic engines guided by learned representations."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:knowledge-representation ],
        ngm:artificial-intelligence ;
    skos:broader ngm:artificial-intelligence ;
    vc:bridgesTo ngm:deep-learning,
        ngm:symbolic-ai ;
    vc:contrastsWith ngm:deep-learning ;
    vc:enables ngm:explainable-ai ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:implements ngm:automated-reasoning,
        ngm:knowledge-representation ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:machine-learning,
        ngm:symbolic-ai ;
    vc:requires ngm:knowledge-representation ;
    vc:slug "neuro-symbolic-ai" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:explainable-ai,
        ngm:reasoning ;
    vc:uses ngm:knowledge-graph,
        ngm:logic-programming,
        ngm:neural-network .

ngm:non-volatile-memory a owl:Class ;
    rdfs:label "Non Volatile Memory"@en ;
    rdfs:comment "Non-volatile memory (NVM) is computer storage that retains its data after power is removed, in contrast to volatile memory such as DRAM and SRAM. It encompasses technologies including NAND and NOR flash, EEPROM, and emerging persistent-memory devices that combine byte-addressability with durability. NVM is fundamental to firmware storage, embedded systems, solid-state drives, and the bootstrapping of computing platforms."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:firmware ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:power-management ],
        ngm:hardware ;
    vc:bridgesTo ngm:edge-computing ;
    vc:contrastsWith ngm:sram ;
    vc:dependsOn ngm:hardware ;
    vc:enables ngm:firmware ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:firmware ;
    vc:isPartOf ngm:embedded-systems ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:energy-efficiency,
        ngm:io-t,
        ngm:memory,
        ngm:reliability ;
    vc:requires ngm:power-management ;
    vc:slug "non-volatile-memory" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:edge-computing,
        ngm:microcontroller ;
    vc:uses ngm:signal-processing .

ngm:normalising-flows a owl:Class ;
    rdfs:label "Normalising Flows"@en ;
    rdfs:comment "Normalising flows are a class of generative models that learn complex probability distributions by composing a series of invertible, differentiable transformations that map a simple base distribution (typically Gaussian) to the target distribution, with exact log-likelihood computation via the change-of-variables formula and the Jacobian determinant. Both sampling and density evaluation are tractable."@en ;
    rdfs:subClassOf ngm:generative-ai ;
    vc:bridgesTo ngm:probabilistic-programming,
        ngm:scientific-machine-learning ;
    vc:contrastsWith ngm:markov-chain-monte-carlo ;
    vc:enables ngm:bayesian-inference,
        ngm:density-estimation,
        ngm:generative-model,
        ngm:latent-variable-model,
        ngm:posterior-approximation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:generative-model,
        ngm:variational-inference ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:diffusion-model,
        ngm:flow-matching,
        ngm:gaussian-process,
        ngm:generative-adversarial-network,
        ngm:neural-ordinary-differential-equation,
        ngm:variational-autoencoder ;
    vc:requires ngm:differentiable-programming,
        ngm:invertible-neural-network ;
    vc:slug "normalising-flows" ;
    vc:sourceDomain "machine-learning" ;
    vc:uses ngm:autoregressive-model,
        ngm:change-of-variables,
        ngm:gaussian-distribution,
        ngm:jacobian-determinant,
        ngm:maximum-likelihood-estimation .

ngm:oblivious-transfer a owl:Class ;
    rdfs:label "Oblivious Transfer"@en ;
    rdfs:comment "Oblivious transfer is a foundational cryptographic protocol in which a sender transmits one of several pieces of information to a receiver, but remains oblivious to which piece was received, while the receiver learns nothing about the other pieces. The canonical 1-out-of-2 variant lets a receiver choose one of two sender messages without revealing the choice and without learning the unchosen message. Oblivious transfer is complete for secure two-party computation and underpins protocols such as garbled circuits and private set intersection."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:key-exchange ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:public-key-cryptography ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:public-key-cryptography ],
        ngm:secure-multi-party-computation ;
    vc:bridgesTo ngm:security ;
    vc:contrastsWith ngm:homomorphic-encryption ;
    vc:enables ngm:secure-aggregation,
        ngm:secure-multi-party-computation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:public-key-cryptography ;
    vc:isPartOf ngm:secure-multi-party-computation ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:federated-learning,
        ngm:homomorphic-encryption,
        ngm:zero-knowledge-proof ;
    vc:requires ngm:key-exchange,
        ngm:public-key-cryptography ;
    vc:slug "oblivious-transfer" ;
    vc:sourceDomain "security" ;
    vc:supports ngm:differential-privacy ;
    vc:uses ngm:cryptographic-hash-function .

ngm:open-access a owl:Class ;
    rdfs:label "Open Access"@en ;
    rdfs:comment "Open access is the practice of making scholarly and other knowledge outputs freely available online without subscription or most copyright and licensing barriers. It aims to maximise the dissemination, reuse and impact of research by removing paywalls and granting broad reuse rights. Open access is a core component of the wider open science and open data movements."@en ;
    rdfs:subClassOf ngm:open-data ;
    vc:bridgesTo ngm:academic-research ;
    vc:contrastsWith ngm:intellectual-property-rights ;
    vc:dependsOn ngm:intellectual-property-rights ;
    vc:enables ngm:knowledge-sharing,
        ngm:knowledge-transfer ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:open-data ;
    vc:isPartOf ngm:open-data ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:academic-research,
        ngm:knowledge-sharing,
        ngm:open-source ;
    vc:slug "open-access" ;
    vc:sourceDomain "governance" ;
    vc:supports ngm:open-science,
        ngm:scientific-research ;
    vc:uses ngm:creative-commons,
        ngm:peer-review .

ngm:ordinary-differential-equation a owl:Class ;
    rdfs:label "Ordinary Differential Equation"@en ;
    rdfs:comment "An ordinary differential equation (ODE) is a mathematical equation relating a function of a single independent variable to its derivatives. It describes how a quantity changes continuously with respect to that variable, and its solution is the function or family of functions satisfying the relation, often determined by initial conditions. ODEs are foundational tools for modelling dynamical systems in physics, biology, engineering, and increasingly in machine learning."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:numerical-methods ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:numerical-integration ],
        ngm:numerical-methods ;
    vc:bridgesTo ngm:neural-ordinary-differential-equation ;
    vc:contrastsWith ngm:stochastic-differential-equation ;
    vc:enables ngm:dynamical-systems,
        ngm:neural-ordinary-differential-equation,
        ngm:simulation ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:numerical-integration ;
    vc:implements ngm:numerical-integration ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:dynamical-systems,
        ngm:optimisation,
        ngm:scientific-computing ;
    vc:requires ngm:numerical-methods ;
    vc:slug "ordinary-differential-equation" ;
    vc:sourceDomain "machine-learning" ;
    vc:supports ngm:scientific-computing,
        ngm:simulation ;
    vc:uses ngm:interpolation,
        ngm:numerical-integration .

ngm:pbft a owl:Class ;
    rdfs:label "PBFT"@en ;
    rdfs:comment "Practical Byzantine Fault Tolerance (PBFT) is a state-machine replication protocol designed by Castro and Liskov (1999) that achieves consensus in asynchronous distributed systems despite up to f arbitrarily faulty (Byzantine) nodes, requiring a total of at least 3f+1 replicas. It proceeds through pre-prepare, prepare, and commit phases to ensure all correct replicas execute the same sequence of operations, providing both safety and liveness under partial synchrony assumptions. PBFT was the first Byzantine fault-tolerant protocol deemed practical for deployed systems, with latency polynomial rather than exponential in the number of nodes. Its communication complexity of O(n²) limits scalability but makes it highly suitable for small-to-medium permissioned blockchain networks."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:public-key-infrastructure ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:partial-synchrony ],
        ngm:byzantine-fault-tolerance ;
    vc:bridgesTo ngm:enterprise-blockchain,
        ngm:hyperledger-fabric ;
    vc:contrastsWith ngm:crash-fault-tolerance,
        ngm:proof-of-stake,
        ngm:proof-of-work ;
    vc:enables ngm:blockchain-infrastructure,
        ngm:deterministic-finality,
        ngm:distributed-ledger-technology,
        ngm:permissioned-blockchain,
        ngm:state-machine-replication ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:byzantine-agreement,
        ngm:total-order-broadcast ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:bc-protocol-and-consensus,
        ngm:consensus-mechanism,
        ngm:dynamic-scalable-bft,
        ngm:hot-stuff,
        ngm:tendermint ;
    vc:requires ngm:partial-synchrony,
        ngm:public-key-infrastructure ;
    vc:slug "pbft" ;
    vc:sourceDomain "distributed-systems" ;
    vc:uses ngm:bc-cryptographic-primitive,
        ngm:consensus-protocol,
        ngm:distributed-system,
        ngm:message-authentication-code,
        ngm:quorum-system,
        ngm:view-change-protocol .

ngm:pci-dss a owl:Class ;
    rdfs:label "PCI-DSS"@en ;
    rdfs:comment "The Payment Card Industry Data Security Standard (PCI-DSS) is a security standard governing the handling of cardholder data by organisations that store, process, or transmit payment card information. It defines a set of requirements covering network security, encryption, access control, monitoring, and vulnerability management to reduce the risk of card data breaches. Compliance is mandated by the major card brands and verified through self-assessment questionnaires or external audits depending on transaction volume."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:audit ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:access-control ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:tokenization ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:encryption ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:vulnerability-management ],
        ngm:compliance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:information-security ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:fraud-detection,
        ngm:kyc-aml-compliance,
        ngm:payment-gateway,
        ngm:payment-network ;
    vc:requires ngm:access-control,
        ngm:audit,
        ngm:encryption,
        ngm:tokenization,
        ngm:vulnerability-management ;
    vc:slug "pci-dss" ;
    vc:sourceDomain "finance" ;
    vc:standardizedBy ngm:regulatory-compliance,
        ngm:standards ;
    vc:supports ngm:e-commerce,
        ngm:financial-services .

ngm:plan-and-execute-pattern a owl:Class ;
    rdfs:label "Plan and Execute Pattern"@en ;
    rdfs:comment "The plan-and-execute pattern is an agent-architecture design in which a dedicated planner component produces a structured task plan that an executor component then realises step by step using tools. Formalising the strategy as a reusable pattern lets agent frameworks separate high-level reasoning from low-level tool invocation, enabling re-planning and observability. It is widely implemented through function-calling pipelines in LLM agent frameworks."@en ;
    rdfs:subClassOf ngm:ai-agent-system ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:agent-frameworks,
        ngm:function-calling ;
    vc:slug "plan-and-execute-pattern" ;
    vc:sourceDomain "ai" .

ngm:plonk a owl:Class ;
    rdfs:label "PLONK"@en ;
    rdfs:comment "PLONK is a zero-knowledge proof system that uses polynomial commitments and a universal trusted setup. It is used to build succinct proofs for verifiable computation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptography ],
        ngm:zero-knowledge-proof ;
    vc:enables ngm:rollup ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:cryptography ;
    vc:slug "plonk" ;
    vc:sourceDomain "blockchain" .

ngm:power-distribution-unit a owl:Class ;
    rdfs:label "Power Distribution Unit"@en ;
    rdfs:comment "A power distribution unit (PDU) is a device that delivers and manages electrical power to multiple pieces of equipment within a data centre rack or row. It takes input from an upstream supply such as a UPS or the building electrical feed and distributes regulated, often metered, power across many outlets. Modern intelligent PDUs add remote monitoring, per-outlet switching and environmental sensing to support availability and energy-efficiency goals."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:monitoring ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:high-availability ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:power-supply ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:redundancy ],
        ngm:computing-infrastructure ;
    vc:contrastsWith ngm:power-supply ;
    vc:dependsOn ngm:energy-and-power,
        ngm:power-supply ;
    vc:enables ngm:fault-tolerance,
        ngm:observability ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:monitoring,
        ngm:power-supply ;
    vc:isPartOf ngm:computing-infrastructure,
        ngm:data-centre ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:cooling-system,
        ngm:sustainability ;
    vc:requires ngm:high-availability,
        ngm:redundancy ;
    vc:slug "power-distribution-unit" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:data-centre,
        ngm:energy-efficiency,
        ngm:high-availability .

ngm:power-grid a owl:Class ;
    rdfs:label "Power Grid"@en ;
    rdfs:comment "A power grid is the interconnected network of generation, transmission and distribution infrastructure that delivers electrical power from producers to consumers. It balances supply and demand in real time across high-voltage transmission lines, substations and lower-voltage distribution networks. Modern grids increasingly integrate renewable generation and digital controls to maintain stability and reliability."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:power-supply ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:power-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:power-systems ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:power-distribution-unit ],
        ngm:power-infrastructure ;
    vc:bridgesTo ngm:renewable-energy ;
    vc:dependsOn ngm:electrical-power,
        ngm:transmission-network ;
    vc:enables ngm:renewable-energy-integration ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:power-supply,
        ngm:power-systems ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:grid-infrastructure,
        ngm:smart-grid ;
    vc:requires ngm:power-distribution-unit,
        ngm:power-management ;
    vc:slug "power-grid" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:data-centre,
        ngm:energy-management ;
    vc:uses ngm:power-electronics .

ngm:power-infrastructure a owl:Class ;
    rdfs:label "Power Infrastructure"@en ;
    rdfs:comment "Power infrastructure is the set of electrical generation, distribution, conditioning and backup systems that deliver reliable energy to computing and physical facilities. In data centres it encompasses utility feeds, power distribution units, uninterruptible supplies and generators that together guarantee continuity under load and fault. It is a foundational dependency for high-availability infrastructure, often co-designed with cooling and capacity planning."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:electrical-power ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:capacity-planning ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:redundancy ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:power-supply ],
        ngm:infrastructure ;
    skos:broader ngm:infrastructure ;
    vc:contrastsWith ngm:cooling-system ;
    vc:dependsOn ngm:electrical-power,
        ngm:renewable-energy ;
    vc:enables ngm:high-availability ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:electrical-power,
        ngm:power-supply ;
    vc:isPartOf ngm:cloud-infrastructure ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:carbon-footprint,
        ngm:renewable-energy ;
    vc:requires ngm:capacity-planning,
        ngm:redundancy ;
    vc:slug "power-infrastructure" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:cloud-infrastructure,
        ngm:cooling-system ;
    vc:uses ngm:energy-efficiency .

ngm:privacy-preserving-identity a owl:Class ;
    rdfs:label "Privacy-Preserving Identity"@en ;
    rdfs:comment "Privacy-preserving identity refers to identity management architectures and protocols that enable individuals to prove attributes, credentials, or facts about themselves to verifiers without revealing unnecessary personal information, leveraging cryptographic techniques such as zero-knowledge proofs, selective disclosure, and unlinkable credentials. These systems reconcile strong authentication guarantees with user privacy, countering surveillance by minimising the attack surface of identity data aggregation and preventing cross-context correlation of user activity. They are foundational to self-sovereign identity frameworks, anonymous credential schemes, hardware-backed identity wallets, and privacy-respecting regulatory compliance workflows. The field spans cryptographic research, standardisation bodies (W3C, IETF, ISO), and deployment infrastructure including secure enclaves and decentralised ledgers."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptographic-commitment ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:digital-signature ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:public-key-infrastructure ],
        ngm:digital-identity ;
    vc:bridgesTo ngm:blockchain,
        ngm:secure-multi-party-computation ;
    vc:contrastsWith ngm:centralised-identity,
        ngm:federated-identity ;
    vc:dependsOn ngm:decentralized-identity,
        ngm:digital-identity-wallet ;
    vc:enables ngm:age-verification,
        ngm:anonymous-credential,
        ngm:identity-verification,
        ngm:privacy-preserving-authentication,
        ngm:self-sovereign-identity ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:implements ngm:e-idas-2-0,
        ngm:sd-jwt,
        ngm:w3-c-verifiable-credentials ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:data-minimisation,
        ngm:unlinkability ;
    vc:requires ngm:cryptographic-commitment,
        ngm:digital-signature,
        ngm:public-key-infrastructure ;
    vc:slug "privacy-preserving-identity" ;
    vc:sourceDomain "security" ;
    vc:standardizedBy ngm:ietf,
        ngm:w3-c ;
    vc:supports ngm:gdpr-compliance,
        ngm:know-your-customer ;
    vc:uses ngm:bbs-signatures,
        ngm:decentralized-identifiers,
        ngm:selective-disclosure,
        ngm:trusted-execution-environment,
        ngm:verifiable-credentials,
        ngm:zero-knowledge-proof,
        ngm:zk-snark .

ngm:probabilistic-programming a owl:Class ;
    rdfs:label "Probabilistic Programming"@en ;
    rdfs:comment "Probabilistic programming is a paradigm in which statistical models are expressed as programs that include random variables and conditioning statements, with inference performed automatically by the language runtime. It lets practitioners specify generative models declaratively while delegating the mechanics of Bayesian inference, such as sampling or variational optimisation, to the system. This separation of model specification from inference enables rapid iteration on complex probabilistic models across science and machine learning."@en ;
    rdfs:subClassOf ngm:probabilistic-model ;
    vc:bridgesTo ngm:deep-learning,
        ngm:normalising-flows ;
    vc:dependsOn ngm:inference ;
    vc:enables ngm:bayesian-inference,
        ngm:uncertainty-quantification ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:markov-chain-monte-carlo,
        ngm:variational-inference ;
    vc:isPartOf ngm:machine-learning ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:bayesian-inference,
        ngm:gradient-descent,
        ngm:representation-learning ;
    vc:slug "probabilistic-programming" ;
    vc:sourceDomain "machine-learning" ;
    vc:supports ngm:generative-model,
        ngm:statistical-modelling ;
    vc:uses ngm:probabilistic-model .

ngm:process-reward-model a owl:Class ;
    rdfs:label "Process Reward Model"@en ;
    rdfs:comment "A process reward model is a reward model that scores the individual intermediate steps of a model's reasoning trajectory rather than only its final answer. By supervising each step of a chain of thought, it provides dense, step-level feedback that guides search and reinforcement learning toward sound reasoning processes. Process reward models contrast with outcome reward models, which assign a single reward based solely on the final result."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:large-language-model ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:reward-modelling ],
        ngm:reward-model ;
    vc:dependsOn ngm:reward-model ;
    vc:enables ngm:reasoning ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:reward-modelling ;
    vc:implements ngm:preference-learning ;
