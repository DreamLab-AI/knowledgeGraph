    vc:supports ngm:network-security,
        ngm:quality-of-service ;
    vc:uses ngm:packet-switching,
        ngm:tls-encryption .

ngm:network-slicing a owl:Class ;
    rdfs:label "Network Slicing"@en ;
    rdfs:comment "Network slicing is a virtualisation architecture that partitions a single physical network infrastructure into multiple isolated, logically independent virtual networks — called slices — each configured to provide the specific performance characteristics, security posture, and service topology required by a distinct application or tenant. Defined within 3GPP Release 15 and later releases for 5G networks, each slice is instantiated through software-defined networking and network function virtualisation, enabling differentiated service-level guarantees — such as ultra-low latency for industrial automation or high-throughput for video streaming — without dedicated physical hardware. Slices span radio access, transport, and core network domains and can be dynamically provisioned, scaled, and torn down."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:network-function-virtualization ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:software-defined-networking ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:radio-access-network ],
        ngm:network-function-virtualization ;
    vc:bridgesTo ngm:multi-access-edge-computing ;
    vc:contrastsWith ngm:best-effort-networking ;
    vc:dependsOn ngm:5g-core-network,
        ngm:service-level-agreement ;
    vc:enables ngm:edge-computing,
        ngm:guaranteed-bandwidth,
        ngm:multi-tenancy,
        ngm:private-5g-network,
        ngm:quality-of-service ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:radio-access-network ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:6-g-network-slice,
        ngm:latency ;
    vc:requires ngm:network-function-virtualization,
        ngm:software-defined-networking ;
    vc:slug "network-slicing" ;
    vc:sourceDomain "infrastructure" ;
    vc:standardizedBy ngm:3-gpp,
        ngm:etsi-nfv ;
    vc:supports ngm:edge-computing-architecture,
        ngm:industrial-io-t,
        ngm:vehicle-to-everything .

ngm:open-api-specification a owl:Class ;
    rdfs:label "OpenAPI Specification"@en ;
    rdfs:comment "The OpenAPI Specification (OAS) is a language-agnostic, machine-readable standard for describing RESTful HTTP APIs using a structured JSON or YAML document that defines endpoints, request/response schemas, authentication methods, and parameter types. Governed by the OpenAPI Initiative (a Linux Foundation project), it enables automated generation of client SDKs, server stubs, interactive documentation, and contract-based testing from a single source of truth. Originally derived from the Swagger specification, OAS version 3.x is now the dominant industry standard for API description. It promotes interoperability by allowing API consumers to understand a service's capabilities without access to its source code."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:rest ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:http-protocol ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:json-data-interchange-format-schema ],
        ngm:api-standard ;
    vc:bridgesTo ngm:large-language-model ;
    vc:contrastsWith ngm:asyncapi,
        ngm:g-rpc,
        ngm:graph-ql ;
    vc:enables ngm:api-integration,
        ngm:code-generation,
        ngm:contract-testing,
        ngm:documentation-generation,
        ngm:microservices ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:json-data-interchange-format-schema,
        ngm:yaml ;
    vc:isPartOf ngm:linux-foundation,
        ngm:openapi-initiative ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:api-gateway,
        ngm:api-management,
        ngm:api-versioning ;
    vc:requires ngm:http-protocol,
        ngm:rest ;
    vc:slug "open-api-specification" ;
    vc:sourceDomain "infrastructure" ;
    vc:standardizedBy ngm:openapi-initiative ;
    vc:uses ngm:data-schema,
        ngm:json-data-interchange-format,
        ngm:rest-api .

ngm:owl a owl:Class ;
    rdfs:label "OWL"@en ;
    rdfs:comment "OWL (Web Ontology Language) is a W3C-standardised semantic web language for defining and sharing ontologies on the World Wide Web, built on RDF and grounded in Description Logics to provide formal semantics with decidable reasoning. OWL enables the specification of classes, properties, individuals, and axioms that constrain their relationships, supporting automated inference and knowledge graph construction."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:description-logic ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:rdf ],
        ngm:semantic-web-linked-data-standard ;
    vc:bridgesTo ngm:digital-twin,
        ngm:large-language-model ;
    vc:contrastsWith ngm:json-data-interchange-format-schema ;
    vc:enables ngm:automated-reasoning,
