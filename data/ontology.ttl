        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:liquidity-pool ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:liquidity-pool ],
        ngm:decentralised-finance ;
    vc:bridgesTo ngm:derivatives-market,
        ngm:risk-management,
        ngm:token-economics ;
    vc:contrastsWith ngm:centralised-exchange,
        ngm:d-yd-x,
        ngm:order-book-exchange ;
    vc:dependsOn ngm:arbitrum,
        ngm:avalanche-network,
        ngm:chainlink-oracle,
        ngm:ethereum-virtual-machine ;
    vc:enables ngm:fee-distribution,
        ngm:leveraged-trading,
        ngm:liquidity-provision,
        ngm:perpetual-futures ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:glp-token,
        ngm:gmx-token,
        ngm:liquidity-pool ;
