        ngm:prompt-engineering,
        ngm:rlhf,
        ngm:transfer-learning ;
    vc:requires ngm:fine-tuning,
        ngm:instruction-response-dataset,
        ngm:large-language-model,
        ngm:supervised-learning ;
    vc:slug "instruction-tuning" ;
    vc:sourceDomain "machine-learning" ;
    vc:uses ngm:chain-of-thought-prompting,
