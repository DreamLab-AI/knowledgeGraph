ngm:remittances a owl:Class ;
    rdfs:label "Remittances"@en ;
    rdfs:comment "Remittances are cross-border transfers of money, typically sent by migrant workers to family in their home country, representing a major global flow of funds to developing economies. Traditional rails impose high fees and slow settlement, which cryptocurrencies and the Lightning Network aim to reduce. As a use case, remittances anchor much of the argument for Bitcoin and stablecoins as practical money."@en ;
    rdfs:subClassOf ngm:financial-services ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:bitcoin-proof-of-work-protocol-as-money,
        ngm:bitcoin-proof-of-work-protocol-value-proposition ;
    vc:slug "remittances" ;
    vc:sourceDomain "blockchain" .

ngm:remote-control a skos:Concept ;
    rdfs:label "Remote Control"@en .

ngm:remote-rendering a owl:Class ;
    rdfs:label "Remote Rendering"@en ;
    rdfs:comment "Remote Rendering offloads GPU-intensive 3D scene computation to a server or cloud node, streaming compressed video frames to a thin client such as an XR headset or mobile device. This approach decouples visual fidelity from device hardware constraints, enabling photorealistic graphics on low-power endpoints while centralising GPU resources. Latency and bandwidth are critical quality-of-service parameters; edge computing deployments minimise round-trip delay to support interactive frame rates."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:latency ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gpu-compute ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:edge-computing ],
        ngm:infra-computing-and-cloud ;
    skos:broader ngm:infra-computing-and-cloud ;
    vc:enables ngm:photorealistic-rendering ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:edge-computing,
        ngm:gpu-compute,
        ngm:latency ;
    vc:slug "remote-rendering" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:cloud-infrastructure,
        ngm:content-delivery-network .

ngm:remote-surgery a skos:Concept ;
    rdfs:label "Remote Surgery"@en .

ngm:remote-work-infrastructure a owl:Class ;
    rdfs:label "Remote Work Infrastructure"@en ;
    rdfs:comment "Remote work infrastructure is the combined set of networking, collaboration, and presence technologies that let distributed teams work together as if co-located. It includes real-time communication, shared workspaces, presence and status signalling, and adaptive transport that copes with variable connectivity. As workforces decentralise, this infrastructure underpins productivity, security, and a sense of shared presence."@en ;
    rdfs:subClassOf ngm:dc-telepresence ;
    skos:broader ngm:dc-telepresence ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
