ngm:haptic-feedback a owl:Class ;
    rdfs:label "Haptic Feedback"@en ;
    rdfs:comment "Tactile sensory technology that provides physical sensations to enhance virtual and augmented experiences by translating digital signals into mechanical vibrations, force responses, and pressure cues through actuators integrated into controllers, gloves, and body suits, enabling users to perceive touch, texture, and resistance when interacting with virtual objects."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:force-feedback ],
        ngm:sc-interaction ;
    skos:broader ngm:sc-interaction ;
    vc:bridgesTo ngm:machine-learning,
        ngm:robotic-system ;
    vc:contrastsWith ngm:visual-feedback ;
    vc:dependsOn ngm:motion-tracking,
