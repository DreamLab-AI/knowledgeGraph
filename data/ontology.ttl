    vc:supports ngm:ai-inference,
        ngm:cad-software,
        ngm:game-engine,
        ngm:medical-imaging,
        ngm:professional-visualisation,
        ngm:scientific-computing,
        ngm:web-rendering,
        ngm:xr-compositing ;
    vc:uses ngm:glsl,
        ngm:hlsl,
        ngm:kernel-mode-driver,
        ngm:msl,
        ngm:spir-v,
        ngm:vendor-driver,
        ngm:wgsl .

ngm:manipulation a owl:Class ;
    rdfs:label "Manipulation"@en ;
    rdfs:comment "Manipulation in robotics refers to the ability of robotic systems to physically interact with and control objects in their environment."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:motion-planning ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:inverse-kinematics ],
        ngm:robo-actuation-and-control,
        ngm:robotics-systems ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:relatedTo ngm:haptics ;
    vc:requires ngm:inverse-kinematics,
        ngm:motion-planning ;
    vc:slug "manipulation" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:end-effector,
        ngm:force-control .

ngm:neural-network-architecture a owl:Class ;
    rdfs:label "Neural Network Architecture"@en ;
    rdfs:comment "Neural network architecture defines the structural organisation of artificial neurons into layers and the connectivity patterns between them, determining how a network processes and transforms input data through weighted connections and activation functions. Different architectural families — feedforward, convolutional, recurrent, and transformer — embody distinct inductive biases suited to different data modalities and task types. Architectural choices govern capacity, training stability, and generalisation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:transformer-architecture ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:activation-function ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:recurrent-neural-network ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:dropout ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gradient-descent ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:attention-mechanism ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:backpropagation ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:convolutional-neural-network ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:loss-function ],
        ngm:ai-model-architecture ;
    skos:broader ngm:ai-model-architecture ;
    vc:enables ngm:computer-vision,
        ngm:deep-learning,
        ngm:natural-language-processing,
        ngm:transfer-learning ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:activation-function,
        ngm:attention-mechanism,
        ngm:convolutional-neural-network,
        ngm:dropout,
        ngm:recurrent-neural-network,
        ngm:transformer-architecture ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:generative-adversarial-network,
        ngm:machine-learning,
        ngm:reinforcement-learning ;
    vc:requires ngm:backpropagation,
        ngm:gradient-descent,
        ngm:loss-function ;
    vc:slug "neural-network-architecture" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:hyperparameter,
        ngm:model-training .

ngm:optimization-algorithm a owl:Class ;
    rdfs:label "Optimization Algorithm"@en ;
    rdfs:comment "A procedure that iteratively adjusts model parameters to minimise or maximise an objective function. In machine learning, optimisation algorithms govern the training dynamics of neural networks by computing gradient-based parameter updates; prominent instances include stochastic gradient descent, Adam, and their adaptive variants, each balancing convergence speed, memory cost, and generalisation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:stochastic-gradient-descent ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:loss-function ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:backpropagation ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:gradient-descent ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:adam-optimiser ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:learning-rate-schedule ],
        ngm:ai-technique,
        ngm:algorithm ;
    skos:broader ngm:ai-technique ;
    vc:enables ngm:machine-learning-model,
        ngm:neural-network-architecture ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:adam-optimiser,
        ngm:gradient-descent,
        ngm:learning-rate-schedule,
        ngm:stochastic-gradient-descent ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:convergence,
        ngm:hyperparameter ;
    vc:requires ngm:backpropagation,
        ngm:loss-function ;
    vc:slug "optimization-algorithm" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:physically-based-rendering a owl:Class ;
    rdfs:label "Physically Based Rendering"@en ;
    rdfs:comment "Physically Based Rendering (PBR) is a rendering methodology that simulates the physical behaviour of light interacting with materials by adhering to real-world optical principles such as energy conservation, microfacet theory, and the reflectance equation. PBR uses parameterised material models — typically albedo, metallic, roughness, and normal maps — to produce consistent, predictable visual results across varied lighting conditions. It is the standard material workflow for real-time 3D engines used in games, metaverse platforms, and digital twin visualisation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:rendering-pipeline ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:shader ],
        ngm:infra-computing-and-cloud ;
    skos:broader ngm:infra-computing-and-cloud ;
    vc:enables ngm:3-d-asset,
        ngm:real-time-rendering ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:relatedTo ngm:ray-tracing,
        ngm:rendering-technique ;
    vc:requires ngm:rendering-pipeline,
        ngm:shader ;
    vc:slug "physically-based-rendering" ;
    vc:sourceDomain "infrastructure" .

ngm:predictive-analytics a owl:Class ;
    rdfs:label "Predictive Analytics"@en ;
    rdfs:comment "Predictive Analytics is the practice of extracting information from existing data sets and applying statistical algorithms and machine learning techniques to forecast future outcomes. It combines feature engineering, model training, and evaluation pipelines to generate actionable predictions in domains such as user behaviour, demand forecasting, anomaly detection, and risk assessment. Predictive models are trained on historical data and deployed as AI applications embedded in business intelligence systems and decision-support workflows."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:machine-learning ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:feature-engineering ],
        ngm:ai-application ;
    skos:broader ngm:ai-application ;
    vc:enables ngm:anomaly-detection ;
    vc:hasMaturity ngmi:maturity-emerging ;
