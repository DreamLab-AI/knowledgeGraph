        ngm:nfc-chip-reading,
        ngm:sanctions-screening-engine,
        ngm:travel-rule-protocol,
        ngm:verifiable-credentials .

ngm:autonomous-navigation a owl:Class ;
    rdfs:label "Autonomous Navigation"@en ;
    rdfs:comment "Autonomous Navigation encompasses the complete system capability for a robot or autonomous agent to move from one location to another without human guidance, integrating perception, localisation, mapping, path planning, obstacle avoidance, and control."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:slam ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:sensor-fusion ],
        ngm:autonomous-agent,
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:enables ngm:autonomous-robot,
        ngm:autonomous-vehicle ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires ngm:sensor-fusion,
        ngm:slam ;
    vc:slug "autonomous-navigation" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:motion-planning,
        ngm:path-planning .

ngm:actuator a owl:Class ;
    rdfs:label "Actuator"@en ;
    rdfs:comment "An actuator is a device that converts energy — electrical, hydraulic, or pneumatic — into mechanical motion or force, serving as the output element of a robot's control chain. Actuators translate commands from a robot controller into joint rotations, linear displacements, or gripping forces, and their dynamic characteristics (torque density, bandwidth, backdrivability) fundamentally constrain a robot's speed, precision, and physical safety in human-robot interaction. Common types include servo motors, hydraulic cylinders, pneumatic actuators, and emerging soft actuator materials."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:servo-motor ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:feedback-control ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:control-system ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:hydraulic-actuator ],
        ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:hydraulic-actuator,
        ngm:servo-motor ;
    vc:isPartOf ngm:robot ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:requires ngm:control-system,
        ngm:feedback-control ;
    vc:slug "actuator" ;
    vc:sourceDomain "robotics" .

ngm:robotics a owl:Class,
        skos:Concept ;
    rdfs:label "Robotics"@en ;
    rdfs:comment "Robotics is the interdisciplinary field encompassing the design, construction, operation, and application of robots and automated systems."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:control-system ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:motion-control ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:computer-vision ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:machine-learning ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:kinematics ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:sensor-system ],
        owl:Thing ;
    vc:enables ngm:autonomous-manufacturing,
        ngm:humanoid-robotics,
        ngm:industrial-automation,
        ngm:precision-engineering,
        ngm:smart-manufacturing,
        ngm:warehouse-automation ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:computer-vision,
        ngm:machine-learning,
        ngm:motion-control,
        ngm:robotic-arm,
        ngm:sensor-system ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires ngm:actuators,
        ngm:control-system,
        ngm:kinematics ;
    vc:slug "robotics" ;
    vc:sourceDomain "robotics" .

ngm:cryptography a owl:Class ;
    rdfs:label "Cryptography"@en ;
    rdfs:comment "Cryptography is the mathematical science of transforming information through encryption, ensuring confidentiality, authenticity, and integrity in digital communications and blockchain systems."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:digital-signature ],
        ngm:cryptographic-security,
        ngm:infra-security-and-identity ;
    skos:broader ngm:infra-security-and-identity ;
    vc:enables ngm:consensus-protocol,
        ngm:cryptographic-protocol,
        ngm:digital-asset ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.55"^^xsd:float ;
    vc:requires ngm:digital-signature,
        ngm:encryption-scheme ;
    vc:slug "cryptography" ;
    vc:sourceDomain "infrastructure" .

ngm:smart-contracts a owl:Class ;
    rdfs:label "Smart Contracts"@en ;
    rdfs:comment "Self-executing programs stored on a blockchain that automatically enforce and execute the terms of an agreement when predetermined conditions are met, eliminating the need for intermediaries and enabling trustless, transparent, and immutable transaction automation."@en ;
    rdfs:subClassOf ngm:bc-network-component,
        ngm:distributed-computing ;
    skos:broader ngm:bc-network-component ;
    vc:enables ngm:automated-market-maker,
        ngm:decentralized-application,
        ngm:tokenization ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:relatedTo ngm:decentralized-finance-de-fi,
        ngmi:ethereum ;
    vc:slug "smart-contracts" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:cryptographic-hash-function,
        ngm:digital-signature .

ngm:transfer-learning a owl:Class ;
    rdfs:label "Transfer Learning"@en ;
    rdfs:comment "Transfer Learning is a machine learning methodology whereby a model pre-trained on a large source task or dataset is adapted to a different but related target task, leveraging previously acquired representations to improve sample efficiency and performance. It is the dominant paradigm for deploying large language models and vision models, enabling fine-tuning with modest task-specific data."@en ;
    rdfs:subClassOf ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:enables ngm:fine-tuning,
        ngm:large-language-models ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.3"^^xsd:float ;
    vc:relatedTo ngm:deep-learning ;
    vc:slug "transfer-learning" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:model-training,
        ngm:neural-network .

ngm:network-infrastructure a owl:Class ;
    rdfs:label "Network Infrastructure"@en ;
    rdfs:comment "Network Infrastructure comprises the physical and logical communication systems — fibre, wireless, routing, and switching equipment, alongside software-defined networking layers — that enable data transmission for real-time collaboration and distributed computing. Modern network infrastructure integrates 5G/6G wireless, SD-WAN, content delivery networks, and multi-access edge computing to support low-latency, high-bandwidth applications such as immersive XR experiences and autonomous systems."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:edge-computing ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:network-component ],
        ngm:infra-network-and-comms ;
    skos:broader ngm:infra-network-and-comms ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:edge-computing,
        ngm:network-component ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:relatedTo ngm:cybersecurity,
        ngm:telecommunications-infrastructure ;
    vc:slug "network-infrastructure" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:ai-infrastructure,
        ngm:spatial-computing .

ngm:fine-tuning a owl:Class ;
    rdfs:label "Fine Tuning"@en ;
    rdfs:comment "The process of adapting a pre-trained model to a specific downstream task by continuing training on task-specific data, typically with a lower learning rate. Fine-tuning leverages knowledge acquired during pre-training whilst specialising the model for particular applications."@en ;
    rdfs:subClassOf ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:dependsOn ngm:training-data,
        ngm:transfer-learning ;
    vc:enables ngm:image-generation,
        ngm:large-language-models ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:slug "fine-tuning" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:gradient-descent .

ngm:virtual-reality a owl:Class ;
    rdfs:label "Virtual Reality"@en ;
    rdfs:comment "Virtual Reality (VR) is a fully immersive simulation technology that replaces the user's physical environment with a computer-generated three-dimensional world, experienced through head-mounted displays with stereoscopic rendering, spatial audio, and motion tracking. VR applications span entertainment, education, remote collaboration, surgical training, and therapeutic interventions."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:haptic-feedback ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:physics-simulation ],
        ngm:extended-reality-xr,
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:relatedTo ngm:augmented-reality,
        ngm:metaverse ;
    vc:requires ngm:haptic-feedback,
        ngm:physics-simulation ;
    vc:slug "virtual-reality" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:3-d-model,
        ngm:game-engine .

ngm:attention-mechanism a owl:Class ;
    rdfs:label "Attention Mechanism"@en ;
    rdfs:comment "An Attention Mechanism is a neural network component that enables models to dynamically weight the relevance of different input positions when producing each output element, computing weighted combinations based on learned similarity scores. Originally introduced for sequence-to-sequence machine translation, self-attention and multi-head attention are now the core computational primitives of transformer architectures, enabling parallel processing of sequences and capturing long-range dependencies that recurrent models struggle with."@en ;
    rdfs:subClassOf ngm:ai-model-architecture,
        ngm:neural-network-component ;
    skos:broader ngm:ai-model-architecture ;
    vc:enables ngm:large-language-models,
        ngm:natural-language-processing ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:transformer-architecture ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:relatedTo ngm:explainable-ai ;
    vc:slug "attention-mechanism" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:neural-network .

ngm:game-engine a owl:Class ;
    rdfs:label "Game Engine"@en ;
    rdfs:comment "Software framework providing core functionality for rendering, physics, and interaction in real-time 3D environments."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:compute-infrastructure ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:scene-graph ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:asset-management-system ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:physics-engine ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:operating-system ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:rendering-pipeline ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:real-time-rendering-pipeline ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:graphics-api ],
        ngm:sc-platform-and-environment,
        ngm:software-platform ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:enables ngm:interactive-experience,
        ngm:multiplayer-gameplay,
        ngm:procedural-content-generation,
        ngm:real-time-rendering,
        ngm:virtual-world-creation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:asset-management-system,
        ngm:audio-engine,
        ngm:physics-engine,
        ngm:real-time-rendering-pipeline,
        ngm:rendering-pipeline,
        ngm:scene-graph,
        ngm:scripting-runtime ;
    vc:isPartOf ngm:development-infrastructure,
        ngm:software-platform ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:compute-infrastructure,
        ngm:graphics-api,
        ngm:operating-system ;
    vc:slug "game-engine" ;
    vc:sourceDomain "spatial-computing" .

ngm:motion-planning a owl:Class ;
    rdfs:label "Motion Planning"@en ;
    rdfs:comment "Motion Planning extends path planning by incorporating robot dynamics, control constraints, and time-parametrisation to generate dynamically feasible trajectories that account for velocity, acceleration, jerk, and actuator limitations."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:control-theory ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:path-planning ],
        ngm:robo-navigation-and-planning ;
    skos:broader ngm:robo-navigation-and-planning ;
    vc:enables ngm:autonomous-robot,
        ngm:autonomous-vehicle ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:autonomous-navigation ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires ngm:control-theory,
        ngm:path-planning ;
    vc:slug "motion-planning" ;
    vc:sourceDomain "robotics" .

ngm:immersive-experience a owl:Class ;
    rdfs:label "Immersive Experience"@en ;
    rdfs:comment "An Immersive Experience is a deeply engaging interaction or environment that induces a compelling sense of presence by combining high-fidelity multi-sensory stimulation, responsive interaction, and narrative coherence across visual, auditory, and haptic channels. Underpinned by virtual reality, augmented reality, and spatial audio technologies, immersive experiences span VR training simulations, therapeutic applications, collaborative virtual workspaces, and entertainment, with quality measured through presence questionnaires, physiological indicators, and behavioural engagement metrics."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:haptic-feedback ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:virtual-reality ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:spatial-audio ],
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:enables ngm:simulation,
        ngm:telepresence ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:relatedTo ngm:augmented-reality ;
    vc:requires ngm:haptic-feedback,
        ngm:spatial-audio,
        ngm:virtual-reality ;
    vc:slug "immersive-experience" ;
    vc:sourceDomain "spatial-computing" .

ngm:cryptographic-hash-function a owl:Class ;
    rdfs:label "Cryptographic Hash Function"@en ;
    rdfs:comment "A Cryptographic Hash Function is a deterministic algorithm that maps arbitrary-length input data to a fixed-length output digest of fixed size, such that it is computationally infeasible to reverse the mapping, find two inputs producing the same digest (collision resistance), or derive the input from the digest alone (preimage resistance). Hash functions such as SHA-256 and Keccak-256 underpin blockchain data integrity, Merkle tree construction, and digital signature schemes. They are a foundational primitive for proof-of-work consensus, address derivation, and commitment schemes across distributed ledger systems."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:collision-resistance ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:preimage-resistance ],
        ngm:bc-cryptographic-primitive ;
    skos:broader ngm:bc-cryptographic-primitive ;
    vc:enables ngm:digital-signature,
        ngm:merkle-tree ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:keccak-256,
        ngm:sha-256 ;
    vc:requires ngm:collision-resistance,
        ngm:preimage-resistance ;
    vc:slug "cryptographic-hash-function" ;
    vc:sourceDomain "blockchain" .

ngm:zero-knowledge-proof a owl:Class ;
    rdfs:label "Zero-Knowledge Proof"@en ;
    rdfs:comment "A cryptographic protocol allowing one party (prover) to convince another party (verifier) that a statement is true without revealing any information beyond the validity of the statement itself. Zero-knowledge proofs provide privacy-preserving verification in blockchain systems, enabling private transactions, identity attestation, and scalable computation via ZK-rollups."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:zk-snarks ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:zk-starks ],
        ngm:bc-cryptographic-primitive,
