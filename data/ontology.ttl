# Gazebo Simulator
robotics:GazeboSimulator rdf:type owl:Class ;
    rdfs:subClassOf robotics:PhysicsSimulator ;
    rdfs:subClassOf robotics:RoboticsDevelopmentTool ;
    rdfs:label "Gazebo Simulator"@en ;
    rdfs:comment "Gazebo Simulator (now branded Gz Sim following the Open Robotics / Intrinsic rebranding) is an open-source, physics-accurate 3D robotics simulator providing rigid-body dynamics (via ODE, Bullet, DART, or Simbody), sensor simulation (cameras, LiDAR, IMU, GPS), and a plugin architecture for custom actuators and environments, enabling hardware-in-the-loop (HIL) development, Robot Operating System integration testing, and reinforcement learning training environments without requiring physical hardware, making it the de facto simulation substrate for Robot Operating System development pipelines and a key component in sim-to-real transfer workflows."@en ;
    skos:prefLabel "Gazebo Simulator"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:robotics:gazebo-simulator" ;
    owl:sameAs <urn:visionclaw:concept:robotics:gazebo-simulator> ;
    vcw:contentHash "sha256-12-9e3a7c5f2b1d" ;
    vcw:qualityScore "0.55"^^xsd:decimal ;
    vcw:legacyTermId "RB-gazebo-simulator" ;
    vcw:ontologyStatus "complete" ;
    vcw:maturityLevel "established" ;
    vcw:authorityScore "0.7"^^xsd:decimal ;
    dcterms:identifier "RB-gazebo-simulator" ;
    dcterms:subject "robotics" ;
    owl:versionInfo "1.0.0" ;
    dcterms:created "2026-04-26T00:00:00Z"^^xsd:dateTime ;
    dcterms:modified "2026-04-26T00:00:00Z"^^xsd:dateTime ;
    vcw:owlRole "Object" .

