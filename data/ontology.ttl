    rdfs:label "Limit Order"@en .

ngm:lindy-effect a owl:Class ;
    rdfs:label "Lindy Effect"@en ;
    rdfs:comment "The Lindy Effect is a heuristic stating that the future life expectancy of a non-perishable thing, such as a technology or idea, is proportional to its current age, so the longer it has survived the longer it is expected to persist. Popularised by Nassim Taleb, it implies robustness accrues through demonstrated longevity. In crypto discourse it is invoked to argue that Bitcoin's continued survival strengthens its credibility as a store of value."@en ;
    rdfs:subClassOf ngm:economic-mechanism ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:bitcoin-proof-of-work-protocol,
        ngm:bitcoin-proof-of-work-protocol-value-proposition ;
    vc:slug "lindy-effect" ;
    vc:sourceDomain "blockchain" .

ngm:linear-projection a skos:Concept ;
    rdfs:label "Linear Projection"@en .

ngm:linked-open-data a owl:Class ;
    rdfs:label "Linked Open Data"@en ;
    rdfs:comment "Linked Open Data is the practice of publishing structured data on the web under open licences using Linked Data principles, RDF and dereferenceable URIs so that datasets can be interlinked and queried across sources. It forms a global web of data, complementary to the web of documents, in which entities reference one another across organisational boundaries. Reference datasets such as DBpedia and Wikidata are central hubs, and Berners-Lee's five-star scheme rates the openness and linkage of published data."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:metadata ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:linked-data ],
        ngm:linked-data ;
    vc:bridgesTo ngm:dbpedia,
        ngm:wikidata ;
    vc:enables ngm:data-integration,
        ngm:data-interoperability,
        ngm:knowledge-graph ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:linked-data,
        ngm:metadata ;
    vc:implements ngm:triple-store ;
    vc:isPartOf ngm:artificial-intelligence ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:data-provenance,
        ngm:ontology,
        ngm:owl ;
    vc:slug "linked-open-data" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:open-data,
        ngm:semantic-web ;
    vc:uses ngm:rdf,
        ngm:sparql,
        ngm:uri .

