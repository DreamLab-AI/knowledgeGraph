    vc:requires ngm:forward-kinematics ;
    vc:slug "joint-configuration" ;
    vc:sourceDomain "robotics" .

ngm:json-data-interchange-format-ld-1-1 a owl:Class ;
    rdfs:label "JSON-LD 1.1"@en ;
    rdfs:comment "JSON-LD 1.1 is a W3C Recommendation (published July 2020) that extends JSON-LD 1.0 with scoped contexts, type-scoped and property-scoped contexts, propagation control, and the @protected keyword, enabling richer and safer mapping of JSON document terms to IRIs within RDF-based knowledge systems. It standardises compaction, expansion, flattening, and framing algorithms that allow any conformant document to be normalised to a canonical RDF graph without custom mapping code. JSON-LD 1.1 serves as the primary serialisation format for Verifiable Credentials, ActivityPub, the Solid ecosystem, and numerous Linked Data Platform implementations. The specification is maintained by the W3C JSON-LD Working Group and is defined across three companion documents covering syntax, processing algorithms, and the framing API."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:iri ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:json-data-interchange-format ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:rdf ],
        ngm:linked-data ;
    vc:bridgesTo ngm:decentralised-identifiers,
        ngm:knowledge-graph-embedding,
        ngm:verifiable-credentials ;
    vc:contrastsWith ngm:json-data-interchange-format-schema,
        ngm:n-triples,
        ngm:rdf-xml,
        ngm:turtle ;
    vc:enables ngm:decentralised-identifiers,
        ngm:knowledge-graph,
        ngm:linked-data-platform,
        ngm:semantic-interoperability,
        ngm:verifiable-credentials ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:semantic-web-linked-data-standard ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:activity-pub,
        ngm:schema-org,
        ngm:solid,
        ngm:sparql ;
    vc:requires ngm:iri,
        ngm:json-data-interchange-format,
        ngm:rdf ;
    vc:slug "json-ld-1-1" ;
    vc:sourceDomain "data" ;
    vc:standardizedBy ngm:world-wide-web-consortium ;
    vc:uses ngm:json-data-interchange-format-ld .

