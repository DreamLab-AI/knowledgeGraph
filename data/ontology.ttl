ngm:application-development a owl:Class ;
    rdfs:label "Application Development"@en ;
    rdfs:comment "Application development is the systematic process of designing, building, testing, and deploying software applications to meet specified user or organisational requirements, encompassing activities from requirements analysis through to release and maintenance. It involves selecting appropriate technology stacks, architectural patterns, and development methodologies to produce reliable, maintainable, and performant software. The discipline spans mobile, web, desktop, and embedded application domains, each with distinct toolchains and constraints."@en ;
    rdfs:subClassOf ngm:software-development ;
    vc:enables ngm:cloud-native-applications,
        ngm:platform-service ;
    vc:hasMaturity ngmi:maturity-draft ;
