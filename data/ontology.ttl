        ngm:risk-management ;
    vc:requires ngm:compliance-framework,
        ngm:eu-ai-act ;
    vc:slug "authorised-representative" ;
    vc:sourceDomain "spatial-computing" ;
    vc:standardizedBy ngm:governance-framework ;
    vc:supports ngm:ai-governance-and-ethics,
        ngm:governance .

ngm:auto-gpt a owl:Class ;
    rdfs:label "AutoGPT"@en ;
    rdfs:comment "AutoGPT is an open-source application that chains language model calls to pursue a high-level goal with limited human input. It was an early demonstration of autonomous agents that plan, act and use tools in a loop."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:language-model ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:tool-use ],
        ngm:autonomous-agent ;
    vc:enables ngm:agentic-workflow ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:language-model,
        ngm:tool-use ;
    vc:slug "auto-gpt" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:automated-summarization a owl:Class ;
    rdfs:label "Automated Summarization"@en ;
    rdfs:comment "Automated Summarization is an NLP task in which a system produces a condensed representation of one or more source documents that preserves salient information and is significantly shorter than the original. Extractive approaches select and concatenate verbatim sentences or passages from the source; abstractive approaches generate novel text that may paraphrase, fuse, or infer content not explicitly stated in the source. Modern large language model-based summarizers are predominantly abstractive, achieving strong performance on long-form documents, meeting transcripts, scientific papers, and news articles, but remain susceptible to hallucination, factual inconsistency, and salience mismatch relative to the reader's intent."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:text-generation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:transformer-architecture ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:large-language-models ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:language-modeling ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:natural-language-understanding ],
        ngm:ai-application,
        ngm:natural-language-processing ;
    skos:broader ngm:ai-application ;
    vc:bridgesTo ngm:meeting-recording ;
    vc:enables ngm:documentation-generation,
        ngm:knowledge-base,
        ngm:meeting-ai-assistant ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:language-modeling,
        ngm:text-generation ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:knowledge-graph-construction,
        ngm:meeting-transcription,
        ngm:question-answering,
        ngm:sentiment-analysis ;
    vc:requires ngm:large-language-models,
        ngm:natural-language-understanding,
        ngm:transformer-architecture ;
    vc:slug "automated-summarization" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:information-retrieval,
        ngm:retrieval-augmented-generation .

