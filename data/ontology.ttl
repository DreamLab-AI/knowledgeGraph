ngm:bundle-adjustment a owl:Class ;
    rdfs:label "Bundle Adjustment"@en ;
    rdfs:comment "Bundle adjustment is a non-linear least-squares optimisation technique in computer vision and photogrammetry that simultaneously refines estimates of 3-D point positions and camera extrinsic and intrinsic parameters so that reprojected 3-D points best match their observed 2-D image locations across all views. It is the gold-standard global refinement step in structure-from-motion pipelines and visual SLAM systems, producing metrically accurate reconstructions from overlapping images or video frames. The term 'bundle' refers to the bundle of light rays connecting each camera centre to observed scene points."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:feature-extraction ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:camera-calibration ],
        ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:enables ngm:3-d-reconstruction,
        ngm:photogrammetry ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:structure-from-motion ;
    vc:requires ngm:camera-calibration,
        ngm:feature-extraction ;
    vc:slug "bundle-adjustment" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:burning-mechanism a owl:Class ;
    rdfs:label "Burning Mechanism"@en ;
    rdfs:comment "A Burning Mechanism is an economic design pattern in tokenised blockchain systems whereby tokens are permanently removed from circulating supply by sending them to an unspendable address (a null or black-hole address) or by protocol-enforced destruction, permanently contracting the total token supply. Token burning is deployed as a deflationary monetary policy tool to counteract inflationary issuance, to create token scarcity as a value-accrual mechanism, to implement fee markets (as in Ethereum's EIP-1559 base fee burn), and to regulate supply in algorithmic stablecoins and tokenomics models. The economic effect depends critically on the rate and predictability of burning relative to issuance."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:smart-contract ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:base-fee ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:blockchain-transaction ],
        ngm:bc-defi-and-economics,
        ngm:blockchain-entity,
        ngm:economic-mechanism ;
    skos:broader ngm:bc-defi-and-economics ;
    vc:contrastsWith ngm:block-reward,
        ngm:inflationary-token ;
    vc:dependsOn ngm:eip-1559,
        ngm:token-economics ;
    vc:enables ngm:deflationary-token,
        ngm:inflation-control,
        ngm:tokenomics ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:base-fee ;
    vc:isPartOf ngm:tokenomics-governance ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:blockchain-economics,
        ngm:fee-market,
        ngm:market-capitalization,
        ngm:virtual-economy ;
    vc:requires ngm:blockchain-transaction,
        ngm:smart-contract ;
    vc:slug "burning-mechanism" ;
    vc:sourceDomain "blockchain" .

