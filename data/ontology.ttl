ngm:sustainability-framework a owl:Class ;
    rdfs:label "Sustainability Framework"@en ;
    rdfs:comment "A sustainability framework is a structured set of principles, metrics, and reporting standards used to measure and manage the environmental, social, and governance impact of an organisation or system. It defines what to measure, how to compute indicators such as carbon footprint, and how to disclose results so that performance can be compared and audited. Frameworks like GHG Protocol and emerging crypto-specific schemes provide the methodological backbone for sustainability claims."@en ;
    rdfs:subClassOf ngm:governance-framework ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:carbon-credit-token,
        ngm:environmental-impact-metric ;
    vc:slug "sustainability-framework" ;
    vc:sourceDomain "governance" .

ngm:sustainable-technology a owl:Class ;
    rdfs:label "Sustainable Technology"@en ;
    rdfs:comment "Technology designed, deployed, and operated to minimise long-term environmental impact through energy efficiency, use of renewable energy sources, responsible lifecycle management, and reduction of waste and carbon emissions. In IT and spatial computing contexts this encompasses energy-efficient data centres, green cloud computing, virtualisation, sustainable software engineering practices, circular economy principles applied to hardware, and AI-driven optimisation of resource consumption. Sustainable technology sits at the intersection of governance, infrastructure design, and environmental accountability, and is increasingly mandated by corporate ESG commitments and governmental net-zero regulations."@en ;
    rdfs:subClassOf ngm:sc-governance-and-safety ;
    skos:broader ngm:sc-governance-and-safety ;
    vc:enables ngm:digital-transformation,
        ngm:edge-computing,
        ngm:internet-of-things ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.75"^^xsd:float ;
