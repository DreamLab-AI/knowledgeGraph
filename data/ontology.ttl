ngm:time-sensitive-networking a owl:Class ;
    rdfs:label "Time-Sensitive Networking"@en ;
    rdfs:comment "Time-Sensitive Networking (TSN) is a set of IEEE 802.1 standards that add deterministic, bounded-latency delivery to standard Ethernet, enabling time-critical and best-effort traffic to share the same network. TSN provides precise time synchronisation, traffic scheduling, frame preemption, and reservation mechanisms so that control-loop and audio-video data arrive within guaranteed time windows. It is foundational to industrial automation, automotive in-vehicle networks, and professional media, replacing proprietary fieldbuses with converged standard Ethernet."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:network-switch ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ethernet ],
        ngm:network-protocol ;
    vc:bridgesTo ngm:ethernet,
        ngm:industry-4-0,
        ngm:operational-technology ;
    vc:contrastsWith ngm:best-effort-networking,
        ngm:fieldbus,
        ngm:profinet ;
    vc:enables ngm:deterministic-networking,
        ngm:industrial-automation,
        ngm:interoperability ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:communication-protocol,
        ngm:networking-standard ;
    vc:requires ngm:ethernet,
        ngm:network-switch,
        ngm:precision-time-protocol ;
    vc:slug "time-sensitive-networking" ;
    vc:sourceDomain "infrastructure" ;
    vc:standardizedBy ngm:ieee,
        ngm:ieee-802-x ;
    vc:uses ngm:clock-synchronization,
        ngm:quality-of-service .

ngm:timelock-controller a owl:Class ;
    rdfs:label "Timelock Controller"@en ;
    rdfs:comment "A timelock controller is a smart contract governance primitive that enforces a mandatory waiting period — the timelock delay — between the scheduling of an on-chain operation (such as a protocol upgrade, parameter change, or treasury disbursement) and its execution, giving token holders, security researchers, and affected parties an opportunity to review, object to, or exit before the change takes effect. Operations must be queued with their full parameters, remain in the queue for the configured delay, and then be explicitly executed; they may also be cancelled by authorised roles during the waiting period. Timelock controllers are a fundamental safety mechanism in DeFi and DAO governance, protecting against malicious or erroneous governance proposals."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:governance-token ],
        ngm:on-chain-governance ;
    vc:bridgesTo ngm:governance,
        ngm:security ;
    vc:enables ngm:blockchain-governance,
        ngm:dao-governance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:access-control,
        ngm:hash-time-locked-contract,
        ngm:multisignature-wallets,
        ngm:open-zeppelin-governor,
        ngm:protocol-upgrades,
        ngm:role-based-access-control,
        ngm:smart-contract ;
    vc:requires ngm:governance-token ;
    vc:slug "timelock-controller" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:defi-protocol,
        ngm:treasury-management ;
    vc:uses ngm:cryptographic-hash-function,
        ngm:operation-queue,
        ngm:proposal-system,
        ngm:voting-mechanism .

ngm:token-swapping a owl:Class ;
    rdfs:label "Token Swapping"@en ;
    rdfs:comment "Token swapping is the on-chain exchange of one cryptocurrency or digital token for another without an intermediary custodian, executed atomically within a single transaction through smart contracts. The mechanism is implemented via automated market makers (AMMs), which price assets algorithmically using constant-function market-making formulas against liquidity pools, or via atomic swap protocols using hash time-locked contracts (HTLCs) that enable trustless cross-chain exchanges. Token swapping is the primary interaction primitive of decentralised exchanges and a building block for complex DeFi strategies."@en ;
    rdfs:subClassOf ngm:decentralized-finance-de-fi ;
    vc:enables ngm:de-fi,
        ngm:yield-farming ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:decentralized-exchange-dex,
        ngm:permissionless-trading,
        ngm:uniswap ;
    vc:slug "token-swapping" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:atomic-swap,
        ngm:automated-market-maker,
        ngm:liquidity-pool,
        ngm:smart-contract .

ngm:trajectory-control a owl:Class ;
    rdfs:label "Trajectory Control"@en ;
    rdfs:comment "Trajectory Control is a robotics control methodology that tracks desired time-varying position, velocity, and acceleration profiles along planned paths. It coordinates joint-space and task-space motion to ensure smooth, precise end-effector movement while respecting dynamic and kinematic constraints."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:state-estimation ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:trajectory-planning ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:kinematics ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:feedback-control ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:trajectory-generation ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:position-control ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:velocity-control ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:inverse-kinematics ],
        ngm:motion-control,
        ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:bridgesTo ngm:machine-learning,
        ngm:spatial-computing ;
    vc:contrastsWith ngm:position-control ;
    vc:enables ngm:autonomous-navigation,
        ngm:human-robot-interaction,
        ngm:robotic-manipulation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:acceleration-profile,
        ngm:position-control,
        ngm:trajectory-generation,
        ngm:trajectory-planning,
        ngm:velocity-control ;
    vc:implements ngm:model-predictive-control,
        ngm:pid-controller ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:collision-avoidance,
        ngm:motion-planning,
        ngm:optimal-control,
        ngm:path-planning,
        ngm:robot-control,
        ngm:task-space-control ;
    vc:requires ngm:feedback-control,
        ngm:inverse-kinematics,
        ngm:kinematics,
        ngm:state-estimation ;
    vc:slug "trajectory-control" ;
    vc:sourceDomain "robotics" .

ngm:transaction-signing a owl:Class ;
    rdfs:label "Transaction Signing"@en ;
    rdfs:comment "Transaction signing is the cryptographic process by which the holder of a private key authorises a blockchain transaction by producing a digital signature over its contents. The signature proves that the legitimate key holder approved the exact transaction without revealing the private key, and it binds the transaction to a specific account so that the network can verify authenticity and integrity. It is fundamental to self-custody, wallet security and the trustless validation of transactions."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:private-key ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:digital-signature ],
        ngm:cryptography ;
    vc:bridgesTo ngm:blockchain ;
    vc:dependsOn ngm:cryptography,
        ngm:private-key ;
    vc:enables ngm:custody,
        ngm:smart-contract ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:digital-signature ;
    vc:isPartOf ngm:digital-wallet ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:digital-wallet,
        ngm:ethereum,
        ngm:hardware-wallet ;
    vc:requires ngm:digital-signature,
        ngm:private-key ;
    vc:slug "transaction-signing" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:hardware-wallet,
        ngm:multi-signature-wallet ;
    vc:uses ngm:ecdsa,
        ngm:elliptic-curve-cryptography,
        ngm:nonce .

ngm:udp a owl:Class ;
    rdfs:label "UDP"@en ;
    rdfs:comment "The User Datagram Protocol (UDP) is a connectionless transport-layer protocol that sends discrete datagrams without establishing a session, handshaking, ordering or guaranteed delivery. By omitting the reliability and congestion-control machinery of connection-oriented protocols, UDP achieves low latency and minimal overhead, leaving any required reliability to the application layer. It is the foundation for real-time and high-throughput workloads such as voice, video, gaming, DNS and modern transport protocols built atop it."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:packet-switching ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:internet-protocol ],
        ngm:transport-protocol ;
    vc:contrastsWith ngm:congestion-control ;
    vc:enables ngm:dns,
        ngm:real-time-communication ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:isPartOf ngm:internet-protocol,
        ngm:network-protocol ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:bandwidth,
        ngm:http,
        ngm:latency,
        ngm:network-layer ;
    vc:requires ngm:internet-protocol,
        ngm:packet-switching ;
    vc:slug "udp" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:gaming,
        ngm:quic ;
    vc:uses ngm:packet-switching .

ngm:uk-online-safety-act a owl:Class ;
    rdfs:label "UK Online Safety Act"@en ;
    rdfs:comment "The UK Online Safety Act 2023 is landmark primary legislation that imposes statutory duties of care on providers of user-to-user services and search engines operating in or accessible from the United Kingdom, compelling them to assess and mitigate risks of illegal content and content harmful to children. It designates Ofcom as the UK's online safety regulator with powers to set binding codes of practice, conduct compliance audits, and impose fines of up to ten per cent of global annual turnover for non-compliance. The Act introduces mandatory age assurance obligations for services hosting pornographic or other age-restricted content, transparency reporting requirements, and a suite of user empowerment tools designed to give adults greater control over the content they encounter. A contested set of provisions concerning end-to-end encrypted messaging — deferring client-side scanning requirements until Ofcom deems them technically feasible — reflect the Act's tension between child protection goals and the integrity of secure communications."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:regulatory-compliance ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:platform-accountability ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:transparency-reporting ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:content-moderation ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:age-verification ],
        ngm:digital-regulation ;
    vc:bridgesTo ngm:client-side-scanning,
        ngm:verifiable-credentials ;
    vc:contrastsWith ngm:digital-services-act,
        ngm:gdpr ;
    vc:enables ngm:trust-and-safety,
        ngm:user-safety ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:age-verification,
        ngm:transparency-reporting ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:end-to-end-encryption,
        ngm:platform-governance ;
    vc:requires ngm:content-moderation,
        ngm:platform-accountability,
        ngm:regulatory-compliance ;
    vc:slug "uk-online-safety-act" ;
    vc:sourceDomain "governance" ;
    vc:standardizedBy ngm:ofcom,
        ngm:uk-parliament ;
    vc:supports ngm:data-protection,
        ngm:freedom-of-expression ;
    vc:uses ngm:content-moderation-standards,
        ngm:regulatory-reporting .

ngm:unit-testing a owl:Class ;
    rdfs:label "Unit Testing"@en ;
    rdfs:comment "Unit testing is a software testing practice in which individual units of source code — typically functions, methods, or classes — are exercised in isolation to verify that each behaves as specified. Tests are written as small, deterministic, automated checks that assert expected outputs for given inputs and run quickly as part of the development loop. The practice underpins refactoring confidence, regression protection, and continuous integration pipelines."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:regression-testing ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:test-automation ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:test-automation ],
        ngm:software-testing ;
    vc:bridgesTo ngm:continuous-integration ;
    vc:contrastsWith ngm:integration-testing,
        ngm:regression-testing ;
    vc:enables ngm:test-driven-development ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:regression-testing,
        ngm:test-automation ;
    vc:isPartOf ngm:quality-assurance,
        ngm:software-testing ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:continuous-delivery,
        ngm:software-quality,
        ngm:verification ;
    vc:requires ngm:test-automation ;
    vc:slug "unit-testing" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:continuous-integration,
        ngm:software-development,
        ngm:software-engineering ;
    vc:uses ngm:test-automation .

ngm:universal-design a owl:Class ;
    rdfs:label "Universal Design"@en ;
    rdfs:comment "Universal Design is the architectural, product, and communication design philosophy asserting that environments, systems, and products should be designed from the outset to be usable by all people — regardless of age, disability, or circumstance — to the greatest extent possible without the need for adaptation or specialised design. Codified by architect Ronald Mace at NC State University in the 1990s across seven principles (equitable use, flexibility, simple and intuitive use, perceptible information, tolerance for error, low physical effort, size and space for approach and use), Universal Design goes beyond legal accessibility compliance to treat inclusive design as a quality standard that benefits all users. It has been extended to digital products, extended reality experiences, and AI systems."@en ;
    rdfs:subClassOf ngm:design-thinking ;
    vc:bridgesTo ngm:artificial-intelligence-ethics,
        ngm:natural-language-interfaces,
        ngm:spatial-computing ;
    vc:contrastsWith ngm:retrofitting ;
    vc:enables ngm:assistive-technology,
        ngm:digital-technology-access-equity,
        ngm:inclusive-participation,
        ngm:inclusive-xr-experience,
        ngm:xr-accessibility-standards ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:multimodal-interaction ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:accessibility,
        ngm:accessibility-standards,
        ngm:ergonomics,
        ngm:human-centred-design,
        ngm:inclusive-design,
        ngm:user-experience ;
    vc:slug "universal-design" ;
    vc:sourceDomain "standards" ;
    vc:standardizedBy ngm:eu-accessibility-act,
        ngm:un-convention-on-rights-of-persons-with-disabilities,
        ngm:web-content-accessibility-guidelines,
        ngm:xr-accessibility-user-requirements ;
    vc:supports ngm:built-environment,
        ngm:human-factors,
        ngm:product-design,
        ngm:user-interface-design .

ngm:user-authentication a owl:Class ;
    rdfs:label "User Authentication"@en ;
    rdfs:comment "User authentication is the process of verifying that a person claiming a digital identity is who they assert to be, by validating one or more authentication factors: something they know (password, PIN), something they have (hardware token, mobile device), or something they are (biometric). It is the gateway control between unauthenticated network access and authorised use of a system or resource, and its assurance level — defined by standards such as NIST SP 800-63 — must be calibrated to the sensitivity of protected resources. Modern implementations favour phishing-resistant factors (passkeys, hardware security keys) over knowledge-based authentication."@en ;
    rdfs:subClassOf ngm:authentication ;
    vc:enables ngm:access-control,
        ngm:identity-and-access-management ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:identity-verification,
        ngm:multi-factor-authentication,
        ngm:passwordless-authentication ;
    vc:slug "user-authentication" ;
    vc:sourceDomain "security" ;
    vc:supports ngm:single-sign-on ;
    vc:uses ngm:fido2,
        ngm:oauth-2-0,
        ngm:web-authn .

ngm:verifiable-random-function a owl:Class ;
    rdfs:label "Verifiable Random Function"@en ;
    rdfs:comment "A Verifiable Random Function (VRF) is a cryptographic primitive, introduced by Micali, Rabin, and Vadhan (1999), that maps an input to a pseudorandom output and produces a non-interactive proof allowing any third party to verify that the output was computed correctly from a given public key and input without learning the private key. The VRF owner possesses a private key SK and public key PK; given input alpha, they compute output beta and proof pi such that any verifier with PK can confirm that beta = VRF(SK, alpha) without requiring SK. VRFs provide both uniqueness (exactly one valid output per key-input pair) and pseudorandomness (output is indistinguishable from random to anyone without SK). They are deployed in blockchain systems for unpredictable, manipulation-resistant leader election (Algorand, Cardano, Hedera), NFT trait generation, on-chain lotteries, and as the cryptographic core of Chainlink VRF and similar oracle randomness services."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:discrete-logarithm-problem ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:zero-knowledge-proof ],
        ngm:cryptographic-proof ;
    vc:bridgesTo ngm:decentralised-autonomous-organisation,
        ngm:non-fungible-token ;
    vc:contrastsWith ngm:commit-reveal-scheme,
        ngm:trusted-execution-environment ;
    vc:dependsOn ngm:secret-sharing,
        ngm:threshold-cryptography ;
    vc:enables ngm:blockchain-gaming,
        ngm:consensus-mechanism,
        ngm:oracle-network,
        ngm:proof-of-stake ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:pseudorandom-function ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:leader-election,
        ngm:random-number-generation ;
    vc:requires ngm:discrete-logarithm-problem,
        ngm:zero-knowledge-proof ;
    vc:slug "verifiable-random-function" ;
    vc:sourceDomain "security" ;
    vc:supports ngm:blockchain-oracle,
        ngm:decentralised-finance,
        ngm:smart-contract ;
    vc:uses ngm:cryptographic-commitment,
        ngm:elliptic-curve-cryptography,
        ngm:hash-function,
        ngm:public-key-cryptography,
        ngm:schnorr-signature .

ngm:verification-method a owl:Class ;
    rdfs:label "Verification Method"@en ;
    rdfs:comment "A verification method is an entry in a decentralised identifier document that specifies the cryptographic material and parameters used to authenticate or authorise actions on behalf of the identifier subject. It typically expresses a public key, key type and controller, and is referenced by verification relationships such as authentication, assertion and key agreement. Verification methods are the mechanism by which proofs presented by a subject are checked against the published DID document."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:public-key ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptographic-key ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:cryptographic-key ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:key-management ],
        ngm:did-document ;
    vc:dependsOn ngm:self-sovereign-identity ;
    vc:enables ngm:credential-verification,
        ngm:identity-verification ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:cryptographic-key,
        ngm:public-key ;
    vc:implements ngm:authentication ;
    vc:isPartOf ngm:did-document ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:verification,
        ngm:zero-knowledge-proof ;
    vc:requires ngm:cryptographic-key,
        ngm:key-management ;
    vc:slug "verification-method" ;
    vc:sourceDomain "blockchain" ;
    vc:standardizedBy ngm:decentralized-identifier ;
    vc:supports ngm:verifiable-credential-vc ;
    vc:uses ngm:cryptographic-proof,
        ngm:digital-signature .

ngm:vesting-schedule a owl:Class ;
    rdfs:label "Vesting Schedule"@en ;
    rdfs:comment "A vesting schedule is a contractually or programmatically enforced timetable that releases allocated digital assets or equity to recipients incrementally over a defined period, typically beginning after an initial cliff during which no release occurs. In blockchain and token-based systems, schedules are commonly encoded in smart contracts that autonomously unlock portions of a token allocation at fixed intervals or milestones, aligning the long-term incentives of founders, contributors, and investors with project health. The schedule's parameters — cliff length, total duration, release cadence, and revocation conditions — are a principal instrument of tokenomics design and governance risk management."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:smart-contract ],
        ngm:bc-token-and-asset ;
    skos:broader ngm:bc-token-and-asset ;
    vc:bridgesTo ngm:defi-protocol ;
    vc:contrastsWith ngm:airdrop ;
    vc:dependsOn ngm:blockchain,
        ngm:time-lock ;
    vc:enables ngm:incentive-alignment ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:token ;
    vc:isPartOf ngm:tokenomics ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:initial-coin-offering,
        ngm:staking,
        ngm:tokenomics-governance,
        ngm:treasury-management ;
    vc:requires ngm:smart-contract ;
    vc:slug "vesting-schedule" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:dao,
        ngm:governance-token ;
    vc:uses ngm:escrow-system,
        ngm:multisig-wallet .

ngm:virtual-reality-platform a owl:Class ;
    rdfs:label "Virtual Reality Platform"@en ;
    rdfs:comment "An integrated hardware and software ecosystem that provides the compute, display, tracking, and runtime services required to deliver immersive virtual reality experiences. A VR platform encompasses the headset, motion controllers, inside-out or external tracking system, operating system, SDK, content store, and developer toolchain. Platforms differ in their openness to third-party applications, support for room-scale interaction, and adherence to interoperability standards such as OpenXR."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:sensor-fusion ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:game-engine ],
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:enables ngm:room-scale,
        ngm:virtual-reality,
        ngm:xr-meeting-space ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:augmented-reality,
        ngm:mixed-reality ;
    vc:requires ngm:game-engine,
        ngm:sensor-fusion ;
    vc:slug "virtual-reality-platform" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:haptics,
        ngm:spatial-audio .

ngm:voice-user-interface a owl:Class ;
    rdfs:label "Voice User Interface"@en ;
    rdfs:comment "A Voice User Interface (VUI) is a human-computer interaction modality in which users issue commands and receive responses through spoken language rather than visual controls. It chains automatic speech recognition, natural-language understanding, dialogue management and speech synthesis to turn utterances into actions and synthesised replies. VUIs power virtual assistants, in-car systems and accessibility tools where hands-free or eyes-free operation is valuable."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:natural-language-understanding ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:text-to-speech ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:intent-classification ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:speech-synthesis ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:speech-recognition ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:dialogue-system ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:automatic-speech-recognition ],
        ngm:user-interface ;
    vc:bridgesTo ngm:conversational-ai ;
    vc:dependsOn ngm:speech-recognition ;
    vc:enables ngm:conversational-ai,
        ngm:voice-assistant ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:dialogue-system,
        ngm:intent-classification,
        ngm:speech-recognition,
        ngm:speech-synthesis ;
    vc:isPartOf ngm:user-interface ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:chatbot,
        ngm:user-experience,
        ngm:voice-assistant ;
    vc:requires ngm:automatic-speech-recognition,
