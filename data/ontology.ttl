    rdfs:comment "ETSI domain crossover representing security governance policies, risk management frameworks, and compliance enforcement across metaverse infrastructure and services. These Security Governance Systems coordinate Access Controls, Threat Management, and Compliance Verification."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:artificial-intelligence ],
        ngm:ai-governance-and-ethics ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:artificial-intelligence ;
    vc:qualityScore "0.4"^^xsd:float ;
    vc:slug "etsi-domain-governance-security" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:etsi-domain-governance-society a owl:Class ;
    rdfs:label "ETSI_Domain_Governance___Society"@en ;
    rdfs:comment "An ETSI governance domain addressing societal impacts, inclusion, community wellbeing, and cultural considerations for metaverse and digital infrastructure."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
