        ngm:io-t-sensor-network ;
    vc:slug "industrial-metaverse" ;
    vc:sourceDomain "spatial-computing" .

ngm:inflation-hedge a owl:Class ;
    rdfs:label "Inflation Hedge"@en ;
    rdfs:comment "An inflation hedge is an asset expected to retain or increase its value as the general price level rises, protecting purchasing power. Commonly cited examples include gold, real estate and index-linked bonds."@en ;
    rdfs:subClassOf ngm:store-of-value ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:slug "inflation-hedge" ;
    vc:sourceDomain "finance" .

ngm:infrared-illuminator a owl:Class ;
    rdfs:label "Infrared Illuminator"@en ;
    rdfs:comment "Light-emitting devices that project infrared wavelengths to enable VR/AR tracking sensors to function in low-light or dark environments, enhancing hand tracking accuracy, controller detection, and spatial awareness for immersive experiences."@en ;
    rdfs:subClassOf ngm:sc-interaction,
        ngm:tracking-hardware ;
    skos:broader ngm:sc-interaction ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:slug "infrared-illuminator" ;
    vc:sourceDomain "spatial-computing" .

ngm:initial-public-offering a owl:Class ;
    rdfs:label "Initial Public Offering"@en ;
    rdfs:comment "An initial public offering (IPO) is the process by which a privately held company first sells its shares to the public on a regulated stock exchange, transitioning into a publicly traded entity. It is intermediated by investment banks that underwrite the issue, set a price range, and allocate shares to institutional and retail investors under securities regulation. In blockchain discourse the IPO serves as the regulated, equity-based reference point against which token-based fundraising mechanisms are contrasted."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:regulatory-compliance ],
        ngm:capital-markets ;
    vc:bridgesTo ngm:security-token-offering ;
    vc:contrastsWith ngm:initial-coin-offering,
        ngm:security-token-offering ;
    vc:dependsOn ngm:regulatory-compliance ;
    vc:enables ngm:capital-markets ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:implements ngm:regulatory-compliance ;
    vc:isPartOf ngm:capital-markets ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:crowdfunding,
        ngm:venture-capital ;
    vc:requires ngm:regulatory-compliance ;
    vc:slug "initial-public-offering" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:venture-capital ;
    vc:uses ngm:capital-markets .

ngm:inner-source a owl:Class ;
    rdfs:label "Inner Source"@en ;
    rdfs:comment "Inner source is the adoption of open-source development practices, tools and culture within the boundaries of a single organisation, allowing teams to discover, use and contribute to each other's code as if it were open source internally. It promotes shared repositories, transparent collaboration, peer review and meritocratic contribution while keeping the code private to the company. The approach aims to reduce duplication, improve quality and spread knowledge across organisational silos."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:governance-model ],
        ngm:distributed-collaboration ;
    skos:broader ngm:distributed-collaboration ;
    vc:bridgesTo ngm:distributed-collaboration ;
    vc:contrastsWith ngm:proprietary-software ;
    vc:enables ngm:collaboration,
        ngm:knowledge-sharing ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:implements ngm:open-source ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:collaboration,
        ngm:community,
        ngm:open-source ;
    vc:requires ngm:governance-model ;
    vc:slug "inner-source" ;
    vc:sourceDomain "distributed-collaboration" ;
    vc:supports ngm:software-development,
        ngm:software-engineering ;
    vc:uses ngm:open-source,
        ngm:version-control .

