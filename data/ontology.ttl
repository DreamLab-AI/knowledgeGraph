ngm:consensus-algorithm a owl:Class ;
    rdfs:label "Consensus Algorithm"@en ;
    rdfs:comment "Distributed computational protocol ensuring all participants in a Blockchain Network agree on the canonical transaction history and current state without centralised authority, tolerating a bounded fraction of faulty or malicious nodes."@en ;
