ngm:sensor-fusion-layer a owl:Class ;
    rdfs:label "Sensor Fusion Layer"@en ;
    rdfs:comment "The Sensor Fusion Layer is the stratum that combines data from multiple sensors into a single, more reliable estimate of state. It sits above the Hardware sensing devices and below the Perception Layer that interprets the fused result. It contains alignment, filtering, and fusion algorithms together with uncertainty models."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
