ngm:crew-ai a owl:Class ;
    rdfs:label "CrewAI"@en ;
    rdfs:comment "CrewAI is an open-source Python framework for orchestrating teams of autonomous LLM-powered agents that collaborate on complex tasks through defined roles, backstories, goals, and structured processes. It models a crew of specialised agents—each with distinct capabilities and a designated toolset—that delegate work, share context through a shared memory system, and execute sequential, parallel, or hierarchical workflows toward a common objective. With 47,800+ GitHub stars, 27 million downloads, and adoption by 63% of the Fortune 500 as of mid-2026, CrewAI has become one of the fastest-growing multi-agent orchestration frameworks in the agentic AI ecosystem."@en ;
    rdfs:subClassOf ngm:ai-agent-system,
        ngm:multi-agent-systems ;
    vc:enables ngm:multi-agent-coordination,
        ngm:workflow-automation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.9"^^xsd:float ;
    vc:relatedTo ngm:agentic-workflow,
        ngm:auto-gen,
        ngm:cli-multi-agent-systems,
        ngm:langgraph ;
    vc:slug "crew-ai" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:large-language-model,
        ngm:model-context-protocol,
        ngm:tool-use .

