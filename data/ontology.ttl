ngm:neuroimaging a owl:Class ;
    rdfs:comment "Neuroimaging is the set of techniques used to visualise the structure, function, or physiology of the nervous system, including magnetic resonance imaging (MRI and fMRI), positron emission tomography (PET), and electroencephalography (EEG). It provides the empirical measurements that cognitive science and cognitive psychology use to relate observed brain activity to mental processes such as perception, memory, and decision-making. Neuroimaging data increasingly feeds machine learning pipelines that decode cognitive states or diagnose neurological conditions from scan data."@en ;
    rdfs:label "Neuroimaging"@en ;
    rdfs:subClassOf ngm:neuroscience ;
    vc:enables ngm:cognitive-science ;
