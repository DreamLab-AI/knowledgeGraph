    vc:relatedTo ngm:software-architecture,
        ngm:system-architecture ;
    vc:slug "conceptual-layer" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:knowledge-representation,
        ngm:ontology .

ngm:conflict-mineral-tracking a owl:Class ;
    rdfs:label "Conflict Mineral Tracking"@en ;
    rdfs:comment "Conflict Mineral Tracking denotes the use of blockchain technology to record and verify the provenance of 3TG minerals (tin, tantalum, tungsten, gold) through complex supply chains, ensuring they do not finance armed conflict or human rights abuses in the Democratic Republic of Congo and adjoining regions. Implementations combine immutable custody chains, cryptographic material fingerprinting, and smart-contract-enforced compliance checks to satisfy regulatory obligations including Dodd-Frank Section 1502 and the EU Conflict Minerals Regulation while enabling premium pricing for verified responsible sourcing."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:compliance-verification ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:supply-chain-management ],
        ngm:bc-network-component ;
    skos:broader ngm:bc-network-component ;
    vc:enables ngm:audit-trail,
        ngm:provenance-tracking,
        ngm:supply-chain-traceability ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:blockchain-compliance,
        ngm:consortium-blockchain,
        ngm:esg-reporting,
        ngm:supply-chain-blockchain ;
    vc:requires ngm:compliance-verification,
        ngm:supply-chain-management ;
    vc:slug "conflict-mineral-tracking" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:hyperledger-fabric,
        ngm:internet-of-things,
        ngm:permissioned-blockchain,
        ngm:smart-contracts .

ngm:conspiratorial-thinking-in-technology-communities a owl:Class ;
    rdfs:label "Conspiratorial Thinking in Technology Communities"@en ;
    rdfs:comment "Conspiracies, in the context of technology communities, refers to the recurring pattern of conspiratorial thinking that attaches to emerging technologies such as cryptocurrency and AI. Often rooted in legitimate governance concerns, such thinking can escalate into disinformation ecosystems, creating tensions within technology policy, AI safety debates, and open-source governance."@en ;
    rdfs:subClassOf ngm:infra-software-engineering ;
    skos:broader ngm:infra-software-engineering ;
    vc:bridgesTo ngm:california-ai-bill,
        ngm:open-source-ai ;
    vc:contrastsWith ngm:ai-governance,
        ngm:safety-and-alignment ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:relatedTo ngm:ai-governance-law-and-privacy,
        ngm:blockchain ;
    vc:slug "conspiratorial-thinking-in-technology-communities" ;
    vc:sourceDomain "infrastructure" .

ngm:constitutional-principle a owl:Class ;
    rdfs:label "Constitutional Principle"@en ;
    rdfs:comment "A Constitutional Principle in AI alignment is a natural-language rule or norm—derived from human rights frameworks, professional codes, or organisational policies—that is embedded into an AI system's training or inference process to constrain its behaviour across diverse contexts. Constitutional AI, introduced by Anthropic, uses a curated list of such principles as a self-critique scaffold during reinforcement learning from AI feedback (RLAIF), enabling large language models to evaluate and revise their own outputs against explicit normative standards without requiring a human rater for every example. Constitutional Principles serve as the value-bearing component of this approach, operationalising abstract ethical commitments into verifiable behavioural constraints."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:reinforcement-learning ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:value-alignment ],
        ngm:ai-governance-and-ethics ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:enables ngm:ai-alignment,
        ngm:ai-safety,
        ngm:human-agency-and-oversight ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:constitutional-ai-training-methodology ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:accountability,
        ngm:ai-ethics,
        ngm:ai-governance-principle,
        ngm:ai-regulation,
        ngm:fairness ;
    vc:requires ngm:reinforcement-learning,
        ngm:value-alignment ;
    vc:slug "constitutional-principle" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:ai-governance-framework .

ngm:control-framework a owl:Class ;
    rdfs:label "Control Framework"@en ;
    rdfs:comment "A control framework is a structured set of governance, risk, and compliance controls that an organisation adopts to manage risk and demonstrate conformance to regulatory or industry requirements. Examples include NIST CSF, COBIT, ISO 27001, and SOC 2, each mapping objectives to specific control activities and evidence. It provides a common reference for designing, operating, and auditing controls consistently."@en ;
    rdfs:subClassOf ngm:governance-framework ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:compliance,
        ngm:regulatory-compliance ;
    vc:slug "control-framework" ;
    vc:sourceDomain "governance" .

ngm:convergence-concept a owl:Class ;
    rdfs:label "Convergence Concept"@en ;
    rdfs:comment "Convergence Concept describes the synthesis of previously distinct technologies, domains, and paradigms into unified systems. In telecollaboration and spatial computing, convergence encompasses XR integration, AI-human collaboration, physical-digital fusion via digital twins, and platform unification over shared protocols such as WebXR and OpenXR. The convergence of edge and cloud computing creates hybrid architectures that optimise latency and scalability for real-time collaborative experiences."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:open-xr ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:interoperability ],
        ngm:infra-computing-and-cloud ;
    skos:broader ngm:infra-computing-and-cloud ;
    vc:bridgesTo ngm:collaboration ;
    vc:dependsOn ngm:spatial-computing ;
    vc:enables ngm:digital-twin,
        ngm:telecollaboration ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:cross-domain-bridge ;
    vc:requires ngm:interoperability,
        ngm:open-xr ;
    vc:slug "convergence-concept" ;
    vc:sourceDomain "infrastructure" .

ngm:copper-co a owl:Class ;
    rdfs:label "Copper.co"@en ;
    rdfs:comment "Copper.co is a digital asset custody and infrastructure company serving institutional clients. It provides secure storage, settlement and prime services for cryptocurrencies."@en ;
