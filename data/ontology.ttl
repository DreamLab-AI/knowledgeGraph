    vc:supports ngm:data-engineering,
        ngm:data-processing ;
    vc:uses ngm:data-pipeline .

ngm:forward-kinematics a owl:Class ;
    rdfs:label "Forward Kinematics"@en ;
    rdfs:comment "The process of determining the position and orientation of a robot's end-effector in Cartesian space given the joint parameters (angles or displacements). It maps from joint space to task space using geometric and trigonometric relationships, producing a unique closed-form solution via sequential homogeneous transformation matrices."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:rotation-matrix ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:joint-configuration ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:denavit-hartenberg-parameters ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:end-effector ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:kinematic-model ],
        ngm:kinematics ;
    vc:bridgesTo ngm:augmented-reality,
        ngm:spatial-computing ;
    vc:contrastsWith ngm:inverse-kinematics ;
    vc:dependsOn ngm:jacobian-matrix,
        ngm:rigid-body-dynamics ;
    vc:enables ngm:collision-detection,
        ngm:robot-simulation,
        ngm:trajectory-planning,
        ngm:workspace-analysis ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:end-effector,
        ngm:joint-configuration ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:configuration-space,
        ngm:singularity-analysis ;
    vc:requires ngm:denavit-hartenberg-parameters,
        ngm:kinematic-model,
        ngm:rotation-matrix ;
    vc:slug "forward-kinematics" ;
    vc:sourceDomain "robotics" ;
    vc:supports ngm:motion-planning,
        ngm:robot-programming ;
    vc:uses ngm:coordinate-frame,
        ngm:coordinate-transformation .

ngm:graph-neural-network a owl:Class ;
    rdfs:label "Graph Neural Network"@en ;
    rdfs:comment "A Graph Neural Network (GNN) is a deep learning architecture that operates directly on graph-structured data by iteratively propagating and aggregating feature information across node neighbourhoods. GNNs generalise convolutional and attention mechanisms to non-Euclidean domains, learning node, edge, and graph-level representations suitable for tasks including node classification, link prediction, and graph classification across domains such as knowledge graphs, social networks, molecular modelling, and recommendation systems."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:adjacency-matrix ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:graph-attention-network ],
        ngm:neural-network ;
    vc:bridgesTo ngm:fraud-detection,
        ngm:knowledge-graphing,
        ngm:semantic-web-linked-data-standard ;
    vc:contrastsWith ngm:convolutional-neural-network,
        ngm:recurrent-neural-network ;
    vc:dependsOn ngm:backpropagation,
        ngm:gradient-descent ;
    vc:enables ngm:anomaly-detection,
        ngm:graph-classification,
        ngm:link-prediction,
        ngm:node-classification,
        ngm:recommendation-system,
        ngm:retrieval-augmented-generation ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:graph-attention-network,
        ngm:graph-convolutional-network ;
    vc:implements ngm:message-passing-neural-network,
        ngm:spectral-graph-theory ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:graph-rag,
        ngm:transformer ;
    vc:requires ngm:adjacency-matrix,
        ngm:graph-structured-data ;
    vc:slug "graph-neural-network" ;
    vc:sourceDomain "machine-learning" ;
    vc:supports ngm:drug-discovery,
        ngm:social-network-analysis ;
    vc:uses ngm:deep-learning,
        ngm:graph-attention-mechanism,
        ngm:knowledge-graph,
        ngm:message-passing,
        ngm:node-embedding .

ngm:large-scale-pretrained-foundation-model a owl:Class ;
    rdfs:label "Large-Scale Pretrained Foundation Model"@en ;
    rdfs:comment "Foundation models are large-scale neural networks trained on broad, diverse datasets via self-supervised learning that acquire general-purpose representations transferable to a wide range of downstream tasks. They are characterised by massive parameter counts, emergent capabilities not explicitly trained for, and the ability to be fine-tuned or prompted for specialised applications. Prominent examples include GPT-4, BERT, CLIP, and Stable Diffusion, spanning language, vision, and multimodal domains. Their scale and generality make them qualitatively distinct from narrow task-specific models."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gpu-compute ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
