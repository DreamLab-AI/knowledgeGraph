        ngm:volumetric-rendering ;
    vc:isPartOf ngm:computer-graphics,
        ngm:real-time-rendering ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:3d-modelling,
        ngm:ray-tracing,
        ngm:texture-mapping ;
    vc:requires ngm:compute-shader,
        ngm:physically-based-rendering,
        ngm:rendering-pipeline ;
    vc:slug "visual-effects" ;
    vc:sourceDomain "spatial-computing" ;
