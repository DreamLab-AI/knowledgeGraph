    vc:implements ngm:off-chain-scaling,
        ngm:peer-to-peer-protocol ;
    vc:isPartOf ngm:layer-2-scaling,
        ngm:off-chain-scaling ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:connext,
