    vc:slug "3-d-asset-standard" ;
    vc:sourceDomain "infrastructure" .

ngm:3-d-file-format a owl:Class ;
    rdfs:label "3D File Format"@en ;
    rdfs:comment "3D File Formats are standardised container structures for encoding three-dimensional geometric data, textures, materials, animations, and metadata."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:material-definition ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:mesh-data ],
        ngm:data-format-standard,
        ngm:sc-standards-and-interop ;
    skos:broader ngm:sc-standards-and-interop ;
    vc:enables ngm:3-d-rendering,
        ngm:cross-platform-asset-exchange,
        ngm:digital-asset-management ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires ngm:animation-keyframes,
        ngm:material-definition,
        ngm:mesh-data ;
    vc:slug "3-d-file-format" ;
    vc:sourceDomain "spatial-computing" .

ngm:3-d-model a owl:Class ;
    rdfs:label "3D Model"@en ;
    rdfs:comment "A 3D Model is a digital representation of a three-dimensional object or environment constructed from vertices, edges, faces, and materials, encoded in formats such as 3D File Format."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:material-definition ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:mesh-data ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:texture-mapping ],
