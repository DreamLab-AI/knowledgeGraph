        ngm:sha-256 .

ngm:overfitting a owl:Class ;
    rdfs:label "Overfitting"@en ;
    rdfs:comment "Overfitting is a phenomenon in machine learning where a model learns the training data too precisely—including noise and spurious correlations—resulting in poor generalisation to unseen data. It corresponds to high variance and low bias in the bias-variance tradeoff, and is mitigated through regularisation, dropout, early stopping, and data augmentation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:training-data ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:model-training ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:model-capacity ],
        ngm:ai-research-area ;
    skos:broader ngm:ai-research-area ;
    vc:bridgesTo ngm:ai-robustness,
        ngm:model-governance ;
    vc:contrastsWith ngm:generalisation,
        ngm:underfitting ;
    vc:dependsOn ngm:bias-variance-tradeoff,
        ngm:statistical-learning-theory ;
    vc:enables ngm:memorisation ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:cross-validation,
        ngm:data-augmentation,
        ngm:deep-learning,
        ngm:dropout,
        ngm:early-stopping,
        ngm:machine-learning-phenomenon,
        ngm:neural-network,
        ngm:regularisation,
        ngm:validation-data ;
    vc:requires ngm:model-capacity,
        ngm:model-training,
        ngm:training-data ;
    vc:slug "overfitting" ;
    vc:sourceDomain "machine-learning" ;
    vc:uses ngm:empirical-risk-minimisation,
        ngm:loss-function .

ngm:social-presence a owl:Class ;
    rdfs:label "Social Presence"@en ;
    rdfs:comment "Subjective experience of feeling connected to and aware of other people in a mediated communication environment, fostering social interactions and relationships. Social presence is heightened by richer media, avatar fidelity, spatial audio, and shared immersive spaces, and is a key quality metric for telecollaboration and virtual world platforms."@en ;
