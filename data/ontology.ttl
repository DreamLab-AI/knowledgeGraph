    vc:hasPart ngm:consent-management,
        ngm:data-subject-rights,
        ngm:gdpr,
        ngm:privacy-impact-assessment ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:ai-safety,
