ngm:carbon-neutrality-verification a owl:Class ;
    rdfs:comment "The independent third-party audit process that validates an organization's carbon neutrality claims by verifying emission calculations, reduction measures, and offset quality against established standards such as ISO 14068-1 and PAS 2060."@en ;
    rdfs:label "Carbon Neutrality Verification"@en ;
