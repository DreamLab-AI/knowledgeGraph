        ngm:zero-knowledge-proof .

ngm:cryptocurrency-wallet a owl:Class ;
    rdfs:label "Cryptocurrency Wallet"@en ;
    rdfs:comment "A cryptocurrency wallet is software or hardware that manages the cryptographic keys controlling blockchain assets and constructs, signs and broadcasts transactions on a user's behalf. It does not store coins, which exist only as ledger entries, but rather safeguards the private keys that authorise spending and prove ownership. Wallets range from custodial services that hold keys for users to non-custodial and hardware wallets that give users sole control."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:private-key ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:private-key ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:key-management ],
        ngm:wallet ;
    vc:bridgesTo ngm:decentralised-application ;
    vc:dependsOn ngm:blockchain ;
    vc:enables ngm:decentralised-application ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:private-key ;
    vc:implements ngm:key-management ;
    vc:isPartOf ngm:cryptocurrency ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:decentralised-finance,
        ngm:hardware-wallet,
        ngm:staking ;
    vc:requires ngm:key-management,
        ngm:private-key ;
    vc:slug "cryptocurrency-wallet" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:custody,
        ngm:self-custody ;
    vc:uses ngm:digital-signature .

ngm:data-versioning a owl:Class ;
    rdfs:label "Data Versioning"@en ;
    rdfs:comment "Data Versioning is the systematic practice of tracking, storing, and managing changes to datasets, model artefacts, and derived data products over time, providing reproducibility of experiments, auditability of data lineage, and governance of the full ML data supply chain. It applies software version-control semantics — branching, tagging, diffing, commit history, and rollback — to the large binary assets that underpin machine learning: raw datasets, processed feature stores, trained model weights, and pipeline configuration. Tools such as DVC (Data Version Control), lakeFS, and Apache Iceberg implement data versioning at different granularities, from file-level pointers through table-level snapshots to full environment branching over petabyte-scale data lakes. Data Versioning is a required foundation for reproducible science, regulatory compliance under frameworks such as the EU AI Act, and the operationalisation of mature MLOps practice."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-governance ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:artifact-metadata ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:artifact-metadata ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:dvc ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:data-lineage ],
        ngm:ai-infrastructure,
        ngm:data-management,
        ngm:machine-learning-discipline-pipeline ;
    vc:contrastsWith ngm:static-dataset ;
    vc:enables ngm:continuous-training,
        ngm:empirical-experimental-design,
        ngm:experiment-tracking,
        ngm:feature-engineering,
        ngm:model-training,
        ngm:reproducibility ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:artifact-metadata,
        ngm:data-lineage,
        ngm:dvc ;
    vc:isPartOf ngm:data-management,
        ngm:machine-learning-discipline-pipeline,
        ngm:mlops ;
    vc:qualityScore "0.9"^^xsd:float ;
    vc:relatedTo ngm:blockchain,
        ngm:feature-store,
        ngm:machine-learning-discipline-infrastructure,
        ngm:model-registry,
        ngm:workflow-automation ;
    vc:requires ngm:artifact-metadata,
        ngm:data-governance ;
    vc:slug "data-versioning" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:ai-governance,
        ngm:data-governance,
        ngm:mlops ;
    vc:uses ngm:data-pipeline,
        ngm:object-storage,
        ngm:version-control,
        ngm:workflow-automation .

ngm:database-management-system a owl:Class ;
    rdfs:label "Database Management System"@en ;
    rdfs:comment "A database management system (DBMS) is software that defines, stores, retrieves, secures and manages structured data while enforcing integrity, concurrency and durability. It mediates all access to the underlying database through a query interface and transaction manager, supporting models such as relational, document, key-value and graph. It is the foundational platform for persistent data services including ontology repositories and taxonomy registries."@en ;
    rdfs:subClassOf ngm:infra-data-management ;
    skos:broader ngm:infra-data-management ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:digital-ontology-repository,
        ngm:digital-taxonomy-registry ;
    vc:slug "database-management-system" ;
    vc:sourceDomain "data" .

ngm:dialogue-system a owl:Class ;
    rdfs:label "Dialogue System"@en ;
    rdfs:comment "A Dialogue System (conversational AI system) is an AI application that engages in natural language conversations with users through text or speech, managing multi-turn interactions, maintaining conversational context, and executing task-oriented or open-domain dialogues. Modern dialogue systems employ transformer-based language models, dialogue state tracking, and reinforcement learning to power virtual assistants, customer service chatbots, and conversational interfaces."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:natural-language-understanding ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:natural-language-understanding ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:dialogue-state-tracking ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:intent-recognition ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:transformer ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:speech-recognition ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:natural-language-generation ],
        ngm:ai-application,
        ngm:natural-language-processing ;
    skos:broader ngm:ai-application ;
    vc:bridgesTo ngm:human-computer-interaction,
        ngm:spatial-computing,
        ngm:telecollaboration ;
    vc:contrastsWith ngm:rule-based-systems,
        ngm:search-engine ;
