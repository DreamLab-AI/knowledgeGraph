# OpticalSensorArray
rb:OpticalSensorArray a owl:Class ;
    rdfs:label "OpticalSensorArray"@en ;
    rdfs:comment "A optical sensor array component in the Robotics domain that required by BiometricBindingMechanism."@en ;
    skos:prefLabel "OpticalSensorArray"@en ;
    dcterms:identifier "RB-4000" ;
    dcterms:subject "rb" .

# Robotics Systems
rb:RoboticsSystems a owl:Class ;
    rdfs:subClassOf rb:TechnologyDomain ;
    rdfs:label "Robotics Systems"@en ;
    rdfs:comment "The foundational technology domain encompassing autonomous and semi-autonomous mechanical systems, including manipulators, mobile robots, humanoids, and collaborative robots (cobots), along with their control systems, sensors, actuators, kinematics, and the integration of perception, planning, and action for physical world interaction."@en ;
    skos:prefLabel "Robotics Systems"@en ;
    dcterms:identifier "RB-4001" ;
    dcterms:subject "rb" ;
    dcterms:type "stable" ;
    rdf:type owl:DomainClass .

# Robotics
rb:Robotics a owl:Class ;
    rdfs:label "Robotics"@en ;
    rdfs:comment "Robotics is the interdisciplinary field encompassing the design, construction, operation, and application of robots and automated systems. Modern robotics integrates artificial intelligence, machine vision, advanced sensors, IoT connectivity, and digital twins to create adaptive, flexible, and increasingly autonomous systems capable of operating in unstructured environments alongside humans."@en ;
    skos:prefLabel "Robotics"@en ;
    dcterms:identifier "RB-7000" ;
    dcterms:subject "rb" ;
    dcterms:type "reviewed" ;
    rdf:type owl:ConceptClass .

# RoboticsDomain
rb:Roboticsdomain a owl:Class ;
    rdfs:label "RoboticsDomain"@en ;
    rdfs:comment "The Robotics Domain encompasses intelligent machines and automated systems, providing a formal ontological framework for knowledge representation, autonomous reasoning, and robotic behaviors. It includes concepts for robot architectures, sensor systems, actuators, motion planning, human-robot interaction, and autonomous decision-making, enabling unambiguous knowledge transfer among humans, robots, and artificial systems."@en ;
    skos:prefLabel "RoboticsDomain"@en ;
    dcterms:identifier "RB-7001" ;
    dcterms:subject "rb" ;
    dcterms:type "reviewed" ;
    rdf:type owl:DomainClass .

# IoT Sensors
rb:IotSensors a owl:Class ;
    rdfs:label "IoT Sensors"@en ;
    rdfs:comment "IoT Sensors are networked sensing devices that collect physical and environmental data (temperature, pressure, motion, humidity, vibration, etc.) and transmit it via internet protocols to edge or cloud systems for processing and analysis. Modern IoT sensors increasingly incorporate on-device AI/ML accelerators enabling local inference, predictive analytics, and autonomous decision-making without cloud dependency."@en ;
    skos:prefLabel "IoT Sensors"@en ;
    dcterms:identifier "RB-7002" ;
    dcterms:subject "rb" ;
    dcterms:type "reviewed" ;
    rdf:type owl:HardwareClass .

# Shape Memory Alloy Actuator
rb:ShapeMemoryAlloyActuator a owl:Class ;
    rdfs:label "Shape Memory Alloy Actuator"@en ;
    rdfs:comment "Soft robotics actuator using shape memory alloys that change shape when heated, enabling lightweight and compact actuation for compliant robots."@en ;
    skos:prefLabel "Shape Memory Alloy Actuator"@en ;
    dcterms:identifier "RB-9002" ;
    dcterms:subject "rb" ;
    dcterms:type "emerging" ;
    rdf:type owl:ObjectClass .

# Centralized Swarm Control
rb:CentralizedSwarmControl a owl:Class ;
    rdfs:label "Centralized Swarm Control"@en ;
    rdfs:comment "Swarm robotics control architecture where a central controller coordinates all robot agents, providing global optimization but creating a single point of failure."@en ;
    skos:prefLabel "Centralized Swarm Control"@en ;
    dcterms:identifier "RB-9003" ;
    dcterms:subject "rb" ;
    dcterms:type "mature" ;
    rdf:type owl:ProcessClass .

# Decentralized Swarm Control
rb:DecentralizedSwarmControl a owl:Class ;
    rdfs:label "Decentralized Swarm Control"@en ;
    rdfs:comment "Swarm robotics control architecture where each robot makes autonomous decisions based on local information and interactions, enabling fault tolerance and scalability."@en ;
    skos:prefLabel "Decentralized Swarm Control"@en ;
    dcterms:identifier "RB-9004" ;
    dcterms:subject "rb" ;
    dcterms:type "emerging" ;
    rdf:type owl:ProcessClass .

# Stigmergy
rb:Stigmergy a owl:Class ;
    rdfs:label "Stigmergy"@en ;
    rdfs:comment "Indirect coordination mechanism in swarm robotics where agents communicate through environmental modifications, enabling emergent collective behavior without direct communication."@en ;
    skos:prefLabel "Stigmergy"@en ;
    dcterms:identifier "RB-9005" ;
    dcterms:subject "rb" ;
    dcterms:type "emerging" ;
    rdf:type owl:ProcessClass .

# Proxemics
rb:Proxemics a owl:Class ;
    rdfs:label "Proxemics"@en ;
    rdfs:comment "Study and application of spatial relationships between humans and robots, including personal space, social distance, and comfort zones for effective human-robot interaction."@en ;
    skos:prefLabel "Proxemics"@en ;
    dcterms:identifier "RB-9006" ;
    dcterms:subject "rb" ;
    dcterms:type "emerging" ;
    rdf:type owl:ProcessClass .

# Gaze Control
rb:GazeControl a owl:Class ;
    rdfs:label "Gaze Control"@en ;
    rdfs:comment "Robot eye and head movement control to establish and maintain visual attention, conveying intent and social cues during human-robot interaction."@en ;
    skos:prefLabel "Gaze Control"@en ;
    dcterms:identifier "RB-9007" ;
    dcterms:subject "rb" ;
    dcterms:type "emerging" ;
    rdf:type owl:ProcessClass .

# Social Navigation
rb:SocialNavigation a owl:Class ;
    rdfs:label "Social Navigation"@en ;
    rdfs:comment "Robot navigation strategies that account for social norms, human comfort, and contextual appropriateness when moving through human-populated environments."@en ;
    skos:prefLabel "Social Navigation"@en ;
    dcterms:identifier "RB-9008" ;
    dcterms:subject "rb" ;
    dcterms:type "emerging" ;
    rdf:type owl:ProcessClass .

