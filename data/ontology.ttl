ngm:base a owl:Class ;
    rdfs:label "Base"@en ;
    rdfs:comment "An Ethereum Layer 2 network built by Coinbase using the Optimism OP Stack, providing low-cost, EVM-compatible transactions settled on and secured by the Ethereum mainnet."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
