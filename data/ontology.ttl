ngm:transformer-architecture a owl:Class ;
    rdfs:label "Transformer Architecture"@en ;
    rdfs:comment "A neural network architecture based solely on self-attention mechanisms, dispensing with recurrence and convolutions entirely, enabling parallel sequence processing and underpinning modern large language models and multimodal AI systems."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:attention-mechanism ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:layer-normalisation ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:encoder-decoder-architecture ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:positional-encoding ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:feed-forward-network ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:multi-head-attention ],
        ngm:ai-model-architecture ;
    skos:broader ngm:ai-model-architecture ;
