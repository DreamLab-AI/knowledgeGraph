ngm:mecanum-wheel-robot a owl:Class ;
    rdfs:label "Mecanum Wheel Robot"@en ;
    rdfs:comment "A Mecanum Wheel Robot is a wheeled mobile robot platform that achieves true omnidirectional movement by mounting four independently driven mecanum wheels—each fitted with a ring of passive rollers oriented at 45 degrees to the wheel's rotation axis. By differentially controlling the speeds and directions of the four wheels, the platform can translate in any horizontal direction, rotate in place, or combine translation and rotation simultaneously without requiring steering joints or changing wheel orientation. Invented by Bengt Ilon at Mecanum AB in 1972, the design is widely used in warehousing, logistics, and research platforms where unrestricted planar mobility is required in confined spaces."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:robot-control ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:kinematics ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:actuator ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:robot-component ],
        ngm:omnidirectional-robot,
        ngm:robo-robot-type ;
    skos:broader ngm:robo-robot-type ;
    vc:contrastsWith ngm:differential-drive-robot,
        ngm:wheeled-robot ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:actuator,
        ngm:robot-component ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:mobile-robot,
        ngm:robot-dynamics,
        ngm:wheeled-mobile-robot ;
    vc:requires ngm:kinematics,
        ngm:robot-control ;
    vc:slug "mecanum-wheel-robot" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:motion-planning,
        ngm:robotics-control .

