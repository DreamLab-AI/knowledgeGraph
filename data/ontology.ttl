    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires ngm:smart-contract,
        ngm:vulnerability ;
    vc:slug "third-party-auditor" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:blockchain,
        ngm:risk-assessment .

ngm:tls-encryption a owl:Class ;
    rdfs:label "TLS Encryption"@en ;
    rdfs:comment "TLS (Transport Layer Security) encryption is the cryptographic protocol layer that provides confidentiality, integrity, and server authentication for communications over TCP/IP networks, most visibly as the foundation of HTTPS. It operates through a handshake that negotiates cipher suites, authenticates servers (and optionally clients) via X.509 certificates, establishes ephemeral session keys using asymmetric key exchange (ECDHE), and then encrypts all subsequent data using symmetric ciphers (AES-GCM). TLS 1.3 (RFC 8446, 2018) is the current standard, eliminating obsolete constructs and reducing handshake latency to one round trip."@en ;
    rdfs:subClassOf ngm:cryptographic-protocol ;
    vc:enables ngm:network-security,
        ngm:secure-communication ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:cryptographic-key-management,
        ngm:key-derivation-function,
        ngm:tls ;
    vc:slug "tls-encryption" ;
    vc:sourceDomain "security" ;
    vc:uses ngm:asymmetric-encryption,
        ngm:certificate-authority,
        ngm:digital-certificate,
        ngm:public-key-infrastructure,
        ngm:symmetric-encryption .

ngm:tpu a owl:Class ;
    rdfs:label "TPU"@en ;
    rdfs:comment "Tensor Processing Unit — Google's custom ASIC optimised for the dense matrix multiplications that dominate neural network training and inference. TPUs use systolic arrays to achieve high throughput on 8-bit and 16-bit arithmetic at significantly lower energy per FLOP than general-purpose GPUs, and are available via Google Cloud as Cloud TPUs for large-scale model training."@en ;
    rdfs:subClassOf ngm:ai-hardware,
        ngm:ai-infrastructure ;
    vc:enables ngm:distributed-training,
        ngm:large-language-models ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:edge-ai-accelerator,
        ngm:fpga,
        ngm:gpu-compute,
        ngm:hardware-acceleration,
        ngm:npu ;
    vc:slug "tpu" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:deep-learning,
        ngm:model-training .

ngm:tracking-system a owl:Class ;
    rdfs:label "Tracking System"@en ;
    rdfs:comment "A Tracking System is a hardware and software assembly that continuously determines the position, orientation, and motion of one or more objects or agents within a defined reference frame, using sensing technologies such as optical cameras, inertial measurement units, electromagnetic emitters, ultrasound, GPS, or LiDAR. Tracking systems are foundational components of augmented and virtual reality, robotics, surgical navigation, sports analytics, logistics, and autonomous vehicles, where precise real-time knowledge of spatial state is essential for interaction, control, or safety."@en ;
    rdfs:subClassOf ngm:spatial-tracking-system ;
    vc:enables ngm:augmented-reality,
        ngm:autonomous-navigation,
        ngm:surgical-navigation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:pose-estimation,
        ngm:spatial-mapping ;
    vc:slug "tracking-system" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:computer-vision,
        ngm:imu,
        ngm:lidar,
        ngm:sensor-fusion,
        ngm:slam .

ngm:trajectory-generation a owl:Class ;
    rdfs:label "Trajectory Generation"@en ;
    rdfs:comment "The process of computing a time-parameterized path that specifies the position, velocity, and acceleration of a robot's joints or end-effector as functions of time, enabling smooth motion from start to goal configurations while respecting kinematic and dynamic constraints."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:path-planning ],
        ngm:motion-planning,
        ngm:robo-navigation-and-planning ;
    skos:broader ngm:robo-navigation-and-planning ;
    vc:enables ngm:robot-motion,
        ngm:task-execution ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires ngm:goal-configuration,
        ngm:path-planning,
        ngm:start-configuration ;
    vc:slug "trajectory-generation" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:rb-1005-forward-kinematics,
        ngm:rb-1006-inverse-kinematics .

ngm:trajectory-tracking a owl:Class ;
    rdfs:label "Trajectory Tracking"@en ;
    rdfs:comment "Trajectory tracking is the control problem of causing a dynamical system—typically a robot, vehicle, or aerial platform—to follow a prescribed time-parameterised path through configuration space with minimal deviation. It couples a reference trajectory generated by a planner with a feedback controller that corrects errors arising from disturbances, model mismatch, and actuation limits. Trajectory tracking controllers range from classical PID and linear quadratic regulators to model predictive controllers and learning-based approaches. It is a central capability in mobile robotics, autonomous driving, drone flight, and industrial manipulator control."@en ;
    rdfs:subClassOf ngm:trajectory-control ;
    vc:dependsOn ngm:state-estimation,
        ngm:trajectory-planning ;
    vc:enables ngm:autonomous-navigation,
        ngm:motion-control ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:path-planning,
        ngm:trajectory-generation ;
    vc:slug "trajectory-tracking" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:feedback-control,
        ngm:model-predictive-control,
        ngm:motion-model,
        ngm:pid-controller .

ngm:transaction-processing a owl:Class ;
    rdfs:label "Transaction Processing"@en ;
    rdfs:comment "Transaction Processing encompasses the end-to-end lifecycle of blockchain transactions — from cryptographic signing and mempool propagation through validation, deterministic state execution, and finality confirmation. It includes parallelisation strategies, layer-2 scaling (state channels, rollups), and cross-chain atomic operations, with MEV mitigation and encrypted mempools addressing ordering fairness."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:smart-contract ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:consensus-mechanism ],
        ngm:blockchain-transaction,
        ngm:infra-computing-and-cloud ;
    skos:broader ngm:infra-computing-and-cloud ;
    vc:enables ngm:decentralised-finance,
        ngm:payment-system,
        ngm:transaction-finality ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:requires ngm:consensus-mechanism,
        ngm:smart-contract ;
    vc:slug "transaction-processing" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:stablecoin,
        ngm:transaction-fee,
        ngm:transaction-pool .

ngm:tree-of-thoughts a owl:Class ;
    rdfs:label "Tree of Thoughts"@en ;
    rdfs:comment "Tree of Thoughts (ToT) is a deliberate reasoning framework for large language models that generalises linear chain-of-thought prompting into a tree-structured search over intermediate thought steps. At each node in the tree the model generates multiple candidate next-thoughts, evaluates their promise using an LLM-based heuristic, and selects branches to expand via breadth-first or depth-first search with backtracking. This framework enables systematic exploration of alternative reasoning paths and is particularly effective for tasks requiring combinatorial planning, mathematical proof construction, or multi-step problem-solving where greedy left-to-right decoding is insufficient."@en ;
    rdfs:subClassOf ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:enables ngm:mathematical-reasoning ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:chain-of-thought,
        ngm:monte-carlo-tree-search,
        ngm:prompt-engineering ;
    vc:slug "tree-of-thoughts" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:large-language-models .

ngm:trust a owl:Class ;
    rdfs:label "Trust"@en ;
    rdfs:comment "Trust is a cognitive and relational disposition in which an agent accepts vulnerability to the actions of another party, based on a positive expectation that the trusted party will act competently, honestly, and benevolently towards the trusting party's interests. In sociotechnical and AI contexts, trust extends beyond interpersonal relationships to encompass institutional trust in organisations, systems trust in technological artefacts, and algorithmic trust in AI decision-making processes. Trust is simultaneously a psychological state, a social institution, and a design property of systems, and its calibration — whether systems are trusted appropriately, too much, or too little — has profound implications for human welfare, democratic function, and the effective deployment of AI."@en ;
    rdfs:subClassOf ngm:trust-framework ;
    vc:enables ngm:trust-establishment,
        ngm:trust-infrastructure,
        ngm:trust-score-metric ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:ai-trustworthiness,
        ngm:trust-and-safety,
        ngm:trust-architecture ;
    vc:slug "trust" ;
    vc:sourceDomain "governance" ;
    vc:supports ngm:ai-trust-risk-and-security-management,
        ngm:trust-in-automation,
        ngm:trust-over-ip-foundation .

ngm:trust-anchor a owl:Class ;
    rdfs:label "Trust Anchor"@en ;
    rdfs:comment "A trust anchor is an authoritative entity or cryptographic artifact that serves as the root of a chain of trust, providing the foundational level of trust from which all subsequent trust assertions in a system are derived. In public key infrastructure (PKI), the trust anchor is typically a root certificate authority (CA) whose self-signed certificate is pre-installed in operating systems and browsers as inherently trusted, enabling the validation of all subordinate certificate chains. In decentralised identity systems, trust anchors may be governance-designated issuers, DID-based root entities, or on-chain registries whose cryptographic material is considered authoritative for a particular trust domain. Trust anchors define the scope and boundaries of a trust framework and are the entities that must be trusted by all relying parties in the system."@en ;
    rdfs:subClassOf ngm:trust-framework ;
    vc:enables ngm:decentralized-identity,
        ngm:identity-federation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:certificate-authority,
        ngm:cryptographic-verification,
        ngm:digital-certificate,
        ngm:trust-framework-policy ;
    vc:slug "trust-anchor" ;
    vc:sourceDomain "security" ;
    vc:uses ngm:cryptographic-keys,
        ngm:digital-signature .

ngm:uk-online-safety-act a owl:Class ;
    rdfs:label "UK Online Safety Act"@en ;
    rdfs:comment "The UK Online Safety Act 2023 is landmark legislation that places statutory duties of care on platforms hosting user-generated content and search services, requiring them to identify, assess, and mitigate risks of illegal content and content harmful to children. It establishes Ofcom as the UK's internet regulator with powers to issue codes of practice, conduct audits, and levy fines of up to ten per cent of global annual turnover for non-compliance. The Act introduces mandatory age verification obligations, transparency reporting requirements, and provisions — controversially — concerning encrypted communications and client-side scanning."@en ;
    rdfs:subClassOf ngm:digital-regulation ;
    vc:enables ngm:age-verification,
        ngm:trust-and-safety ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:content-moderation,
        ngm:digital-services-act,
        ngm:online-safety-act-2023 ;
    vc:slug "uk-online-safety-act" ;
    vc:sourceDomain "governance" ;
    vc:supports ngm:user-safety ;
    vc:uses ngm:content-moderation-standards,
        ngm:regulatory-reporting .

ngm:virtual-classroom a owl:Class ;
    rdfs:label "Virtual Classroom"@en ;
    rdfs:comment "An online learning environment that replicates a traditional classroom's interactive experience without physical boundaries, leveraging education technology to connect students and instructors through real-time engagement, collaboration tools, and shared learning materials."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
