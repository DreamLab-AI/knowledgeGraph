ngm:smart-contract-deployment a skos:Concept ;
    rdfs:label "Smart Contract Deployment"@en .

ngm:smart-contract-enforcement a owl:Class ;
    rdfs:label "Smart Contract Enforcement"@en ;
    rdfs:comment "Smart contract enforcement is the property by which the terms encoded in a self-executing on-chain program are carried out automatically and irreversibly once predefined conditions are met, without requiring trust in a counterparty or intermediary. Enforcement derives from the deterministic execution of code on a distributed ledger and the immutability of recorded state. It reduces reliance on external legal recourse while raising questions of how code-based outcomes interact with conventional contract law."@en ;
    rdfs:subClassOf ngm:smart-contract ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:arbitration-process,
        ngm:non-repudiation ;
    vc:slug "smart-contract-enforcement" ;
    vc:sourceDomain "blockchain" .

ngm:smart-contract-governance a owl:Class ;
    rdfs:label "Smart Contract Governance"@en ;
    rdfs:comment "Smart contract governance is the set of mechanisms by which the rules, upgrades, and parameters of deployed on-chain contracts are proposed, decided, and applied, typically through token voting, multisig control, or upgrade proxies. It addresses how immutable code can nonetheless evolve safely and who holds authority to change protocol behaviour. Effective governance balances decentralisation against the need for timely security fixes and legal accountability."@en ;
    rdfs:subClassOf ngm:governance-framework ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:dao-legal-structures,
        ngm:e-contract-arbitration,
        ngm:smart-contract ;
    vc:slug "smart-contract-governance" ;
    vc:sourceDomain "blockchain" .

ngm:smpl-body-model a owl:Class ;
    rdfs:label "SMPL Body Model"@en ;
    rdfs:comment "SMPL (Skinned Multi-Person Linear model) is a parametric 3D human body model that represents body shape and pose with a low-dimensional set of parameters driving a deformable triangle mesh. It separates identity-dependent shape blend shapes from pose-dependent corrective deformations, enabling realistic articulated bodies that fit motion capture and image data. It is a foundational representation in human pose and shape estimation pipelines."@en ;
    rdfs:subClassOf ngm:computer-vision ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:motion-capture,
        ngm:pose-estimation ;
    vc:slug "smpl-body-model" ;
    vc:sourceDomain "ai" .

ngm:soap a skos:Concept ;
    rdfs:label "Soap"@en .

ngm:soar a owl:Class ;
    rdfs:label "SOAR"@en ;
    rdfs:comment "SOAR (Security Orchestration, Automation and Response) is a class of platforms that coordinate detection tools, automate repetitive incident-handling workflows, and orchestrate response actions across a security stack through codified playbooks. It ingests alerts from disparate sources, enriches them with context, and executes graded responses to reduce analyst workload and mean time to respond. The acronym also denotes Soar, a cognitive architecture for modelling general intelligence, but in security contexts the orchestration sense dominates."@en ;
    rdfs:subClassOf ngm:cybersecurity ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:cognitive-ai,
