        ngm:formative-assessment ;
    vc:uses ngm:collaboration-platform,
        ngm:immersive-technology,
        ngm:spatial-audio .

ngm:computational-complexity-theory a owl:Class ;
    rdfs:label "Computational Complexity Theory"@en ;
    rdfs:comment "The mathematical study of the resources — principally time and memory (space) — required to solve computational problems, and the classification of problems according to their inherent difficulty into complexity classes such as P, NP, PSPACE, BPP, and EXPTIME. It establishes which problems are tractable (solvable efficiently in polynomial time) and which are intractable, and investigates the relationships between complexity classes, most famously the unresolved P vs NP question."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:automata-theory ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:turing-machine ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:set-theory ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:algorithm ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:mathematical-logic ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:formal-language ],
        ngm:ai-research-area,
        ngm:theoretical-computer-science ;
    skos:broader ngm:ai-research-area ;
    vc:bridgesTo ngm:cryptography,
        ngm:machine-learning,
        ngm:quantum-information ;
    vc:contrastsWith ngm:computability-theory ;
    vc:dependsOn ngm:computability-theory,
        ngm:information-theory,
        ngm:mathematical-logic,
        ngm:set-theory ;
    vc:enables ngm:approximation-algorithms,
        ngm:computational-learning-theory,
        ngm:cryptographic-hardness-assumption,
        ngm:quantum-computing,
        ngm:sat-solving ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:approximation-algorithms,
        ngm:circuit-complexity,
        ngm:counting-complexity,
        ngm:derandomisation,
        ngm:fine-grained-complexity,
        ngm:interactive-proofs,
        ngm:parameterised-complexity,
        ngm:proof-complexity ;
    vc:qualityScore "0.9"^^xsd:float ;
    vc:relatedTo ngm:coding-theory,
        ngm:constraint-satisfaction,
        ngm:information-theory,
        ngm:theoretical-computer-science ;
    vc:requires ngm:algorithm,
        ngm:automata-theory,
        ngm:formal-language,
        ngm:mathematical-logic,
        ngm:set-theory,
        ngm:turing-machine ;
    vc:slug "computational-complexity-theory" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:automated-reasoning,
        ngm:cryptography,
        ngm:formal-verification,
        ngm:knowledge-representation,
        ngm:machine-learning,
        ngm:ontology .

ngm:content-provenance a owl:Class ;
    rdfs:label "Content Provenance"@en ;
    rdfs:comment "Content provenance is the verifiable, machine-readable record of the origin, authorship, creation context, and transformation history of a piece of digital media, enabling downstream consumers and automated systems to establish authenticity and detect unauthorised alteration. It relies on cryptographic signing, structured metadata schemas, and tamper-evident manifests attached to or bound with the asset at point of creation. As generative AI proliferates synthetic media, content provenance serves as the principal technical mechanism for distinguishing camera-captured or human-authored material from algorithmically generated content. Governance frameworks and regulatory instruments increasingly mandate provenance disclosure as a baseline trust control for media distributed at scale."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:digital-signatures ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptography ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:public-key-infrastructure ],
        ngm:provenance ;
    vc:bridgesTo ngm:blockchain,
        ngm:decentralised-identity,
        ngm:generative-ai ;
    vc:contrastsWith ngm:deepfakes,
        ngm:synthetic-media ;
    vc:enables ngm:media-authentication ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:data-lineage,
        ngm:information-integrity,
        ngm:watermarking-service ;
    vc:requires ngm:cryptography,
        ngm:digital-signatures,
        ngm:public-key-infrastructure ;
    vc:slug "content-provenance" ;
    vc:sourceDomain "governance" ;
    vc:standardizedBy ngm:c2-pa,
        ngm:iptc-photo-metadata ;
    vc:supports ngm:ai-governance,
        ngm:content-moderation,
        ngm:digital-rights-management ;
    vc:uses ngm:metadata-standards,
        ngm:verifiable-credentials .

ngm:curriculum-learning a owl:Class ;
    rdfs:label "Curriculum Learning"@en ;
    rdfs:comment "A training strategy that presents examples to a model in a meaningful order, typically progressing from easy to difficult, mimicking how humans learn. Curriculum learning improves convergence speed, final performance, and generalisation by structuring the learning progression rather than relying on random example ordering."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:training-data ],
        ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:bridgesTo ngm:natural-language-processing,
        ngm:reinforcement-learning,
        ngm:robotics ;
    vc:contrastsWith ngm:anti-curriculum,
        ngm:random-sampling ;
    vc:dependsOn ngm:optimisation-algorithm,
        ngm:supervised-learning ;
    vc:enables ngm:computer-vision,
        ngm:model-performance,
        ngm:sample-efficiency ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:automatic-curriculum,
        ngm:self-paced-learning,
        ngm:teacher-student-curriculum ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:active-learning,
        ngm:continual-learning,
        ngm:contrastive-learning,
        ngm:machine-learning-discipline,
        ngm:meta-learning,
        ngm:training-strategy,
        ngm:transfer-learning ;
    vc:requires ngm:difficulty-assessment,
        ngm:training-data ;
    vc:slug "curriculum-learning" ;
    vc:sourceDomain "machine-learning" ;
    vc:uses ngm:data-ordering,
        ngm:deep-learning,
        ngm:difficulty-measure .

ngm:customer-data-platform a owl:Class ;
    rdfs:label "Customer Data Platform"@en ;
    rdfs:comment "A Customer Data Platform (CDP) is a packaged software system that ingests first-party customer data from disparate online and offline sources, resolves fragmented identifiers into persistent, unified customer profiles, and exposes those profiles via APIs to downstream marketing, analytics, and personalisation systems. Unlike data warehouses or CRM systems, a CDP is marketer-managed, real-time capable, and purpose-built for identity resolution and audience activation. CDPs enforce consent and privacy preferences at the profile level, making them a key architectural component for compliant, data-driven customer engagement."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:consent-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-governance ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:data-ingestion ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:identity-resolution ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-integration ],
        ngm:data-management ;
    vc:bridgesTo ngm:machine-learning,
        ngm:predictive-analytics ;
    vc:contrastsWith ngm:customer-relationship-management,
        ngm:data-management-platform,
        ngm:data-warehouse ;
    vc:enables ngm:audience-segmentation,
        ngm:personalisation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:data-ingestion,
        ngm:unified-customer-profile ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:data-protection-regulation,
        ngm:master-data-management,
        ngm:privacy ;
    vc:requires ngm:consent-management,
        ngm:data-governance,
        ngm:data-integration,
        ngm:identity-resolution ;
    vc:slug "customer-data-platform" ;
    vc:sourceDomain "data" ;
    vc:uses ngm:api-gateway,
        ngm:event-streaming .

ngm:data-analysis a owl:Class ;
    rdfs:label "Data Analysis"@en ;
    rdfs:comment "Data analysis is the systematic process of inspecting, cleaning, transforming, and modelling data to extract useful information, support decision-making, and test hypotheses. It encompasses descriptive summarisation, exploratory analysis to surface structure and anomalies, inferential statistics to generalise from samples, and predictive modelling. Data analysis spans manual statistical work through to automated analytics pipelines, and it is the disciplinary core from which data science, business intelligence, and machine-learning workflows draw. Rigorous analysis attends to data quality, sampling bias, and the validity of inferential assumptions."@en ;
    rdfs:subClassOf ngm:process ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.78"^^xsd:float ;
    vc:relatedTo ngm:predictive-analytics,
        ngm:time-series-analysis ;
    vc:slug "data-analysis" ;
    vc:sourceDomain "data" ;
    vc:uses ngm:data-analytics,
        ngm:statistics .

ngm:data-visualisation a owl:Class ;
    rdfs:label "Data Visualisation"@en ;
    rdfs:comment "Data Visualisation is the systematic practice of encoding data attributes into perceptual channels — position, colour, size, shape, and motion — to enable rapid human comprehension of patterns, trends, anomalies, and relational structures within datasets. It encompasses both static and interactive representations, spanning two-dimensional charts, network graphs, geospatial maps, and immersive three-dimensional scenes rendered in augmented or virtual reality environments. Effective data visualisation integrates principles from information design, cognitive psychology, and computer graphics, requiring rendering infrastructure, data pipelines, and interaction paradigms suited to the display medium. In the context of real-time analytics and spatial computing, visualisation systems must handle streaming data, high-dimensionality reduction, and multi-user collaborative viewing at interactive frame rates."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-pipeline ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:rendering-engine ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-access-interface ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:monitoring-dashboard ],
        ngm:infra-data-management ;
    skos:broader ngm:infra-data-management ;
    vc:bridgesTo ngm:explainable-ai,
        ngm:machine-learning,
        ngm:spatial-computing ;
    vc:dependsOn ngm:data-model,
        ngm:graphics-processing-unit ;
    vc:enables ngm:decision-support,
        ngm:digital-twin,
        ngm:exploratory-data-analysis ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:monitoring-dashboard ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:scientific-visualisation ;
    vc:requires ngm:data-access-interface,
        ngm:data-pipeline,
        ngm:rendering-engine ;
    vc:slug "data-visualisation" ;
    vc:sourceDomain "data" ;
    vc:supports ngm:augmented-reality,
        ngm:business-intelligence,
        ngm:telecollaboration ;
    vc:uses ngm:computer-vision,
        ngm:dimensionality-reduction,
        ngm:human-computer-interaction .

ngm:decentralised-identifiers a owl:Class ;
    rdfs:label "Decentralised Identifiers"@en ;
    rdfs:comment "A W3C standard for globally unique identifiers that are created, owned and controlled by their subject without reliance on a central registration authority, enabling verifiable, self-sovereign digital identity."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:did-document ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:public-key-infrastructure ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptography ],
        ngm:digital-identity ;
    vc:bridgesTo ngm:blockchain,
        ngm:web-of-trust ;
    vc:contrastsWith ngm:centralized-identity-provider,
        ngm:oauth ;
    vc:enables ngm:decentralised-authentication,
        ngm:selective-disclosure,
        ngm:self-sovereign-identity,
        ngm:verifiable-credentials ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:uri-scheme,
        ngm:w3-c-did-specification ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:authentication,
        ngm:identity,
        ngm:trust-framework ;
    vc:requires ngm:cryptography,
        ngm:did-document,
        ngm:public-key-infrastructure ;
    vc:slug "decentralised-identifiers" ;
    vc:sourceDomain "security" ;
    vc:standardizedBy ngm:w3-c ;
    vc:supports ngm:privacy-by-design,
        ngm:zero-knowledge-proof ;
    vc:uses ngm:did-method,
        ngm:digital-signature,
        ngm:distributed-ledger .

ngm:decentralised-storage a owl:Class ;
    rdfs:label "Decentralised Storage"@en ;
    rdfs:comment "Storage systems that distribute data across many independent nodes rather than a single central provider, using content addressing and cryptographic verification to ensure data integrity, availability, and censorship resistance without a trusted intermediary."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:data-replication ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:peer-to-peer-network ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptographic-hash ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:distributed-hash-table ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:content-addressing ],
        ngm:distributed-systems ;
    vc:bridgesTo ngm:smart-contract,
        ngm:spatial-computing ;
    vc:contrastsWith ngm:cloud-storage ;
    vc:dependsOn ngm:blockchain,
        ngm:consensus-mechanism ;
    vc:enables ngm:censorship-resistance,
        ngm:data-sovereignty,
        ngm:provenance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:content-addressing,
        ngm:data-replication,
        ngm:peer-to-peer-network ;
    vc:implements ngm:arweave,
        ngm:filecoin,
        ngm:ipfs ;
    vc:isPartOf ngm:web-3-infrastructure ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:data-availability,
        ngm:encryption ;
    vc:requires ngm:cryptographic-hash,
        ngm:distributed-hash-table ;
    vc:slug "decentralised-storage" ;
    vc:sourceDomain "distributed-systems" ;
    vc:supports ngm:decentralised-application,
        ngm:non-fungible-token ;
    vc:uses ngm:erasure-coding,
        ngm:merkle-dag .

ngm:decentralised-web a owl:Class ;
    rdfs:label "Decentralised Web"@en ;
    rdfs:comment "Decentralised Web (dWeb) is the architectural counter-movement to platform-consolidated Web 2.0, comprising the family of protocols, data models, identity primitives and economic mechanisms that re-establish the original distributed character of the internet by replacing location-addressed client..."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:public-key-infrastructure ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:activity-pub ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:filecoin ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:farcaster ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:ens ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:self-sovereign-identity ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:solid ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:arweave ],
