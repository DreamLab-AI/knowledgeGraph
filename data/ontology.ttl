ngm:privacy-preserving-technology a owl:Class ;
    rdfs:label "Privacy Preserving Technology"@en ;
    rdfs:comment "Privacy Preserving Technology encompasses cryptographic and computational techniques—such as differential privacy, federated learning, homomorphic encryption, and zero-knowledge proofs—that allow data to be analysed or shared without exposing sensitive individual information. These approaches are foundational to building trustworthy AI systems, compliant data pipelines, and secure multi-party computation scenarios where raw data must never leave its owner's control."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:federated-learning ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:differential-privacy ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:zero-knowledge-proof ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
