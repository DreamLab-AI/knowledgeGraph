    vc:enables ngm:assembly-operations,
        ngm:material-handling,
        ngm:precision-manufacturing ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:isPartOf ngm:manipulation-system,
        ngm:robot-arm ;
