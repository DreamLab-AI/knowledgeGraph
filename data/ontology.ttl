ngm:feature-detection a owl:Class ;
    rdfs:comment "Feature detection is the programmatic technique of querying a runtime environment to determine whether a specific capability, API, or behaviour is available before invoking it, rather than inferring support from user-agent strings or version numbers. In computer vision, it also denotes the algorithmic identification of salient points, edges, or regions within images that carry discriminative information for downstream tasks."@en ;
    rdfs:label "Feature Detection"@en ;
    rdfs:subClassOf ngm:runtime-inspection ;
    rdfs:subClassOf _:r10379 ;
