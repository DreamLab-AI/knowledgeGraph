    vc:sourceDomain "blockchain" .

ngm:keras a owl:Class ;
    rdfs:label "Keras"@en ;
    rdfs:comment "Keras is an open-source high-level neural network API written in Python, designed for fast experimentation. It runs on top of backends such as TensorFlow and is integrated as TensorFlow's official high-level interface."@en ;
    rdfs:subClassOf ngm:deep-learning-framework ;
