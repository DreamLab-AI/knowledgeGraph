    vc:requires ngm:application-binary-interface,
        ngm:smart-contract ;
    vc:slug "token-standard" ;
    vc:sourceDomain "blockchain" ;
    vc:standardizedBy ngm:ethereum-improvement-proposal ;
    vc:supports ngm:governance-token,
        ngm:nft,
        ngm:stablecoin ;
    vc:uses ngm:cryptographic-hash-function,
        ngm:event-log .

ngm:version-control a owl:Class ;
    rdfs:label "Version Control"@en ;
    rdfs:comment "Version control is a methodology and toolset for systematically tracking, managing, and auditing changes to files and artefacts over time, enabling multiple contributors to develop concurrently on isolated branches and integrate their work through well-defined merge strategies. Distributed version control systems such as Git maintain a full directed-acyclic-graph (DAG) history locally on every node, supporting offline operation, cryptographically signed commits, and fine-grained blame and bisect operations. Version control underpins modern software delivery practices including continuous integration, infrastructure-as-code, dataset lineage, and MLOps pipelines by providing immutable, content-addressed snapshots of any evolving asset."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:distributed-systems ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:git ],
        ngm:software-engineering ;
    vc:bridgesTo ngm:blockchain,
        ngm:data-lineage ;
    vc:contrastsWith ngm:centralised-version-control ;
    vc:dependsOn ngm:file-system,
        ngm:network-protocol ;
    vc:enables ngm:code-review,
        ngm:collaboration,
        ngm:continuous-integration,
        ngm:infrastructure-as-code ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:branching-strategy,
        ngm:commit,
        ngm:git,
        ngm:merge-conflict-resolution ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:audit-trail,
        ngm:code-generation,
        ngm:data-provenance,
        ngm:dataset-versioning,
        ngm:knowledge-management ;
    vc:requires ngm:cryptographic-hashing,
        ngm:distributed-systems ;
    vc:slug "version-control" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:ai-augmented-software-engineering,
        ngm:devops,
        ngm:mlops .

ngm:embedded-systems a owl:Class ;
    rdfs:label "Embedded Systems"@en ;
    rdfs:comment "Embedded Systems are specialised computing systems designed and deployed to perform dedicated functions within larger mechanical, electronic, or cyber-physical host devices, operating under strict resource constraints, real-time deadlines, and tight hardware-software coupling. They comprise microcontrollers, microprocessors, FPGAs, ASICs, sensors, actuators, and the firmware or RTOS environments that orchestrate them. Unlike general-purpose computers, embedded systems are optimised for a specific task domain — motor control, signal processing, network communication, or safety-critical actuation — and must satisfy reliability, power-budget, thermal, and often functional-safety requirements simultaneously. They form the foundational computational layer beneath robotics, industrial automation, consumer electronics, automotive ECUs, medical devices, and the Internet of Things."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:real-time-operating-system ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:fpga ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:hardware-abstraction-layer ],
        ngm:infra-computing-and-cloud ;
    skos:broader ngm:infra-computing-and-cloud ;
    vc:bridgesTo ngm:cyber-physical-systems,
        ngm:edge-computing,
        ngm:machine-learning ;
    vc:contrastsWith ngm:cloud-computing,
        ngm:general-purpose-computing ;
    vc:dependsOn ngm:memory-management,
        ngm:power-management ;
    vc:enables ngm:edge-ai,
        ngm:industrial-automation,
        ngm:internet-of-things,
        ngm:robotics ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:firmware,
        ngm:fpga,
        ngm:microcontroller,
        ngm:real-time-operating-system ;
    vc:implements ngm:communication-protocol,
        ngm:control-loop ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:computing-systems,
        ngm:control-system,
        ngm:hardware-security ;
    vc:requires ngm:hardware-abstraction-layer,
        ngm:real-time-scheduling ;
    vc:slug "embedded-systems" ;
    vc:sourceDomain "infrastructure" ;
    vc:standardizedBy ngm:iec-61508,
        ngm:iso-26262,
        ngm:misra-c ;
    vc:supports ngm:functional-safety,
        ngm:over-the-air-update ;
    vc:uses ngm:actuator,
        ngm:digital-signal-processor,
        ngm:interrupt-controller,
        ngm:sensor .

ngm:human-robot-interaction a owl:Class ;
    rdfs:label "Human Robot Interaction"@en ;
    rdfs:comment "Interdisciplinary field studying how humans and robots communicate, collaborate, and interact safely and effectively in shared physical and virtual spaces. HRI combines robotics engineering, AI, human factors engineering, and cognitive science to design systems with natural interaction modalities including gesture recognition, natural language processing, and haptic feedback."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:gesture-recognition ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:haptic-feedback ],
        ngm:robo-human-robot-interaction ;
    skos:broader ngm:robo-human-robot-interaction ;
    vc:bridgesTo ngm:augmented-reality,
        ngm:human-computer-interaction,
        ngm:virtual-reality ;
    vc:contrastsWith ngm:autonomous-robot ;
    vc:dependsOn ngm:computer-vision,
        ngm:machine-learning ;
    vc:enables ngm:collaborative-robot,
        ngm:intuitive-interface,
        ngm:safety-metrics ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:gesture-recognition,
        ngm:haptic-feedback,
        ngm:safety-protocol,
        ngm:teach-pendant ;
    vc:isPartOf ngm:robotics ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:cognitive-ergonomics,
        ngm:intent-recognition,
        ngm:interaction-paradigm,
        ngm:robot-ethics ;
    vc:requires ngm:safety-metrics,
        ngm:shared-workspace ;
    vc:slug "human-robot-interaction" ;
    vc:sourceDomain "robotics" ;
    vc:supports ngm:assistive-robotics,
        ngm:social-robotics,
        ngm:telepresence ;
    vc:uses ngm:artificial-intelligence,
        ngm:manipulator-arm,
        ngm:natural-language-processing .

ngm:linked-data a owl:Class ;
    rdfs:label "Linked Data"@en ;
    rdfs:comment "Linked Data is a set of design principles articulated by Tim Berners-Lee for publishing machine-readable structured data on the Web, requiring that entities be identified by HTTP URIs, that those URIs dereference to useful RDF descriptions, and that descriptions include typed links to further URIs enabling traversal across a global Web of Data. It constitutes the application layer of the Semantic Web stack and provides the architectural foundation for open knowledge graphs such as Wikidata, DBpedia, and the Linked Open Data cloud. The four canonical principles — use URIs as names, use HTTP URIs, return structured data on lookup, and include outbound links — create a decentralised, self-describing information mesh that transcends the boundaries of individual databases and siloed repositories."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:http ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:rdf ],
        ngm:infra-data-management ;
    skos:broader ngm:infra-data-management ;
    vc:bridgesTo ngm:entity-linking,
        ngm:knowledge-representation,
        ngm:retrieval-augmented-generation ;
    vc:contrastsWith ngm:data-silo,
        ngm:relational-database ;
    vc:enables ngm:federated-query,
        ngm:knowledge-graph,
        ngm:knowledge-graph-construction,
        ngm:open-data ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:five-star-data,
        ngm:linked-data-platform ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:dbpedia,
        ngm:dublin-core,
        ngm:ontology,
        ngm:wikidata ;
    vc:requires ngm:http,
        ngm:rdf,
        ngm:uri ;
    vc:slug "linked-data" ;
    vc:sourceDomain "data" ;
    vc:standardizedBy ngm:rdf-schema,
        ngm:w3c ;
    vc:uses ngm:json-ld,
        ngm:owl,
        ngm:schema-org,
        ngm:sparql,
        ngm:turtle .

ngm:communication-protocol a owl:Class ;
    rdfs:label "Communication Protocol"@en ;
    rdfs:comment "Communication protocol defines message formats, transmission rules, addressing schemes, and error-handling procedures that enable robots and computational systems to reliably exchange information over wired or wireless channels."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:addressing-scheme ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:congestion-control ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:message-format ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:fault-tolerance ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:error-correction ],
        ngm:robo-human-robot-interaction ;
    skos:broader ngm:robo-human-robot-interaction ;
    vc:enables ngm:distributed-control,
        ngm:remote-teleoperation,
        ngm:sensor-data-fusion,
        ngm:swarm-coordination ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:addressing-scheme,
        ngm:congestion-control,
        ngm:error-correction,
        ngm:message-format ;
    vc:implements ngm:communication-systems,
        ngm:information-architecture ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires ngm:bandwidth-constraints,
        ngm:data-serialisation,
        ngm:fault-tolerance,
        ngm:latency-tolerance,
        ngm:network-physical-layer,
        ngm:synchronisation-mechanism ;
    vc:slug "communication-protocol" ;
    vc:sourceDomain "robotics" .

ngm:privacy a owl:Class ;
    rdfs:label "Privacy"@en ;
    rdfs:comment "The protection of personal information and individual autonomy in digital and AI systems, encompassing data minimization, purpose limitation, transparency, consent management, and individual control over how personal data is collected, processed, stored, and shared; grounded in legal frameworks (GDPR, AI Act) and technical mechanisms (encryption, differential privacy, zero-knowledge proofs) across the full data lifecycle."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:access-control ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-minimisation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:encryption ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:consent-management ],
        ngm:infra-legal-and-regulatory ;
    skos:broader ngm:infra-legal-and-regulatory ;
    vc:bridgesTo ngm:blockchain,
        ngm:cypherpunk,
        ngm:decentralised-web,
        ngm:federated-learning ;
    vc:contrastsWith ngm:hyper-personalisation,
        ngm:mass-data-collection,
        ngm:surveillance ;
    vc:dependsOn ngm:data-protection,
        ngm:identity-management,
        ngm:trust-and-safety ;
    vc:enables ngm:anonymous-credential,
        ngm:differential-privacy,
        ngm:self-sovereign-identity,
        ngm:zero-knowledge-proof ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:implements ngm:gdpr,
        ngm:iso-iec-27701,
        ngm:privacy-by-design ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:cybersecurity,
        ngm:data-rights,
        ngm:digital-rights ;
    vc:requires ngm:access-control,
        ngm:consent-management,
        ngm:data-minimisation,
        ngm:encryption ;
    vc:slug "privacy" ;
    vc:sourceDomain "governance" ;
    vc:standardizedBy ngm:iso-iec-29100,
        ngm:nist-privacy-framework .

ngm:spatial-audio a owl:Class ;
    rdfs:label "Spatial Audio"@en ;
    rdfs:comment "Three-dimensional sound technology that uses head-related transfer functions (HRTF) and object-based mixing to position audio sources in 3D space around the listener, creating immersive auditory experiences that replicate natural sound perception."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:digital-signal-processing ],
        ngm:audio-technology ;
    vc:bridgesTo ngm:human-computer-interaction,
        ngm:metaverse ;
    vc:contrastsWith ngm:stereo-audio ;
    vc:dependsOn ngm:audio-codec,
        ngm:speaker-system ;
    vc:enables ngm:audio-augmented-reality,
        ngm:immersive-experiences,
        ngm:virtual-presence ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:ambisonics,
        ngm:binaural-audio,
        ngm:head-related-transfer-function,
        ngm:object-based-audio ;
    vc:implements ngm:dolby-atmos,
        ngm:dts-x,
        ngm:mpeg-h-audio ;
    vc:isPartOf ngm:extended-reality,
        ngm:immersive-media ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:spatial-computing,
        ngm:surround-sound ;
    vc:requires ngm:digital-signal-processing,
        ngm:psychoacoustics ;
    vc:slug "spatial-audio" ;
    vc:sourceDomain "spatial-computing" ;
    vc:standardizedBy ngm:3gpp,
        ngm:mpeg ;
    vc:supports ngm:gaming,
        ngm:virtual-reality ;
    vc:uses ngm:room-acoustics-modelling .

ngm:nft a owl:Class ;
    rdfs:label "NFT"@en ;
    rdfs:comment "A Non-Fungible Token (NFT) is a cryptographic token deployed on a blockchain that encodes a unique, verifiable ownership claim over a specific digital or physical asset, distinguishing it from fungible tokens where every unit is interchangeable. The on-chain token record contains a unique identifier and owner address, while rich metadata and media assets are typically stored off-chain via IPFS, Arweave, or centralised hosting, with a content-addressed URI anchored in the token. Dominant standards include ERC-721 for individual unique tokens and ERC-1155 for semi-fungible batch collections on Ethereum-compatible chains, with equivalents on Solana (Metaplex), Tezos (FA2), and other ecosystems. NFTs enable programmable royalties, provenance tracking, and cross-platform digital ownership in domains spanning digital art, gaming, music, event ticketing, and real-world asset tokenisation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:wallet ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:blockchain ],
        ngm:bc-token-and-asset ;
    skos:broader ngm:bc-token-and-asset ;
    vc:bridgesTo ngm:digital-twin,
        ngm:spatial-computing,
        ngm:supply-chain ;
    vc:contrastsWith ngm:cryptocurrency,
        ngm:fungible-token ;
    vc:dependsOn ngm:decentralised-storage,
        ngm:ethereum ;
    vc:enables ngm:creator-economy,
        ngm:digital-ownership,
        ngm:programmable-royalties,
        ngm:provenance-tracking,
        ngm:tokenisation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:web3 ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:decentralised-finance,
        ngm:digital-asset,
        ngm:eip-process,
        ngm:metaverse,
        ngm:real-world-asset-tokenisation ;
    vc:requires ngm:blockchain,
        ngm:gas-fees,
        ngm:wallet ;
    vc:slug "nft" ;
    vc:sourceDomain "blockchain" ;
    vc:standardizedBy ngm:ethereum-improvement-proposal ;
    vc:uses ngm:arweave,
        ngm:erc-1155,
        ngm:erc-721,
        ngm:ipfs,
        ngm:public-key-cryptography,
        ngm:smart-contract .

ngm:decentralised-autonomous-organisation a owl:Class ;
    rdfs:label "Decentralised Autonomous Organisation"@en ;
    rdfs:comment "A Decentralised Autonomous Organisation (DAO) is a blockchain-native organisational structure in which governance rules, treasury management, and operational logic are encoded as smart contracts executing on a public distributed ledger, enabling token-holder communities to propose, deliberate, and vote on decisions without recourse to centralised management or traditional corporate hierarchy. DAOs achieve censorship-resistant, transparent coordination by replacing trusted intermediaries with deterministic on-chain execution, typically combining governance tokens that confer weighted voting rights with treasury contracts that custodise and disburse collective assets. As an emergent governance primitive, DAOs span DeFi protocols, grant programmes, investment collectives, open-source software foundations, and decentralised media organisations, presenting novel challenges around legal personality, voter apathy, and Sybil resistance."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:consensus-mechanism ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:voting-mechanism ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptographic-key-management ],
        ngm:bc-governance-and-regulation ;
    skos:broader ngm:bc-governance-and-regulation ;
    vc:bridgesTo ngm:collective-intelligence,
        ngm:distributed-collaboration ;
    vc:contrastsWith ngm:centralised-autonomous-organisation,
        ngm:traditional-corporation ;
    vc:dependsOn ngm:decentralised-finance,
        ngm:tokenomics ;
    vc:enables ngm:on-chain-governance,
        ngm:permissionless-participation,
        ngm:protocol-governance,
        ngm:treasury-management ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:governance-module,
        ngm:treasury-contract,
        ngm:voting-mechanism ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:decentralised-governance,
        ngm:liquid-democracy,
        ngm:sybil-resistance,
        ngm:token-weighted-voting ;
    vc:requires ngm:consensus-mechanism,
        ngm:cryptographic-key-management,
        ngm:public-blockchain ;
    vc:slug "decentralised-autonomous-organisation" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:governance-token,
        ngm:multisig-wallet,
        ngm:quadratic-voting,
        ngm:smart-contract .

ngm:encryption a owl:Class ;
    rdfs:label "Encryption"@en ;
    rdfs:comment "Encryption is the cryptographic process of transforming plaintext data into ciphertext using a defined algorithm and secret key, rendering the data unintelligible to any party that does not possess the corresponding decryption key, thereby ensuring confidentiality. Symmetric schemes such as AES-GCM use a single shared secret for both encryption and decryption, providing authenticated encryption with associated data (AEAD) in a single pass; asymmetric schemes such as RSA-OAEP and ECDH use mathematically linked key pairs where the public key encrypts and the private key decrypts. Hybrid constructions combine both paradigms — using asymmetric key exchange to establish a shared session key and then symmetric ciphers for bulk data — as exemplified by TLS 1.3. Encryption is foundational to data-at-rest protection, data-in-transit security, end-to-end encrypted messaging, confidential computing, and post-quantum cryptography."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptography ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:key-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:random-number-generation ],
        ngm:cryptography ;
    vc:bridgesTo ngm:blockchain,
        ngm:federated-learning ;
    vc:contrastsWith ngm:obfuscation,
        ngm:steganography ;
    vc:enables ngm:confidential-computing,
        ngm:data-protection,
        ngm:end-to-end-encryption,
        ngm:privacy,
        ngm:secure-communication ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:implements ngm:aes,
        ngm:elliptic-curve-cryptography,
        ngm:post-quantum-cryptography,
        ngm:rsa ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:access-control,
        ngm:homomorphic-encryption,
        ngm:zero-knowledge ;
    vc:requires ngm:cryptography,
        ngm:key-management,
        ngm:public-key-infrastructure,
        ngm:random-number-generation ;
    vc:slug "encryption" ;
    vc:sourceDomain "security" ;
    vc:standardizedBy ngm:iso-iec-18033,
        ngm:nist ;
    vc:supports ngm:secure-multiparty-computation,
        ngm:transport-layer-security ;
    vc:uses ngm:digital-signature,
        ngm:hash-function,
        ngm:key-exchange .

ngm:liquidity-pool a owl:Class ;
    rdfs:label "Liquidity Pool"@en ;
    rdfs:comment "A smart contract-governed reserve of paired cryptocurrency tokens that enables decentralized trading through automated market-making algorithms, providing continuous liquidity without traditional order books."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:price-oracle ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:smart-contract-platform ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:liquidity-provider ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:lp-token ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:smart-contract ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:amm-algorithm ],
        ngm:bc-defi-and-economics,
        ngm:smart-contract ;
    skos:broader ngm:bc-defi-and-economics ;
    vc:enables ngm:automated-market-making,
        ngm:price-discovery,
