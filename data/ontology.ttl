ngm:model-deployment a owl:Class ;
    rdfs:label "Model Deployment"@en ;
    rdfs:comment "The engineering process of making a trained machine learning model available for use in a production environment so that it can serve predictions to applications or users."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:inference-engine ],
