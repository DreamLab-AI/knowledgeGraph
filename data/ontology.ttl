ngm:training-pipeline a owl:Class ;
    rdfs:comment "The orchestrated, repeatable sequence of stages that turns raw data into a trained machine-learning model: ingestion and validation, preprocessing and augmentation, batching, the optimisation loop itself, evaluation against held-out data, and registration of versioned artefacts. Treating training as a pipeline rather than a script makes runs reproducible, resumable, and automatable, and is the precondition for continuous retraining and reliable model deployment within MLOps practice."@en ;
    rdfs:label "Training Pipeline"@en ;
    rdfs:subClassOf ngm:data-pipeline ;
