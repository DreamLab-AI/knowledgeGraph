        <urn:visionflow:linked:fatf-recommendations>,
        <urn:visionflow:linked:mi-fid-ii>,
        vf:aml-kyc-compliance,
        vf:eu-mi-ca-regulation ;
    vc:maturity "production-ready" ;
    vc:qualityScore "0.52"^^xsd:float ;
