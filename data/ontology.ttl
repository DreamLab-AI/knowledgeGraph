    vc:slug "quantum-cryptography" ;
    vc:sourceDomain "security" .
ngm:quantum-detailed-balance a skos:Concept ;
    rdfs:label "Quantum Detailed Balance"@en .
ngm:quantum-error-correction a owl:Class ;
    rdfs:comment "Quantum error correction is the set of techniques that protect quantum information against decoherence and operational noise by encoding a logical qubit redundantly across many physical qubits. Stabiliser measurements detect errors without collapsing the encoded state, allowing the system to diagnose and reverse bit-flip and phase-flip faults. It is the central prerequisite for fault-tolerant quantum computation, where logical error rates can be driven arbitrarily low provided physical error rates fall below a threshold."@en ;
    rdfs:label "Quantum Error Correction"@en ;
    rdfs:subClassOf ngm:quantum-computation-paradigm ;
    rdfs:subClassOf _:r17481 ;
