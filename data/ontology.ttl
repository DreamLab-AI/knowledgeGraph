ngm:physics-based-animation a owl:Class ;
    rdfs:label "Physics-Based Animation"@en ;
    rdfs:comment "Animation technique that computes object motion through real-time simulation of physical forces, gravity, collisions, and dynamics to create realistic movement and interactions."@en ;
    rdfs:subClassOf ngm:real-time-rendering ;
    vc:enables ngm:cloth-simulation,
        ngm:dynamic-character-animation,
        ngm:particle-systems,
        ngm:ragdoll-physics ;
    vc:hasPart ngm:collision-detection-system,
        ngm:constraint-solver,
        ngm:force-integrator,
        ngm:physics-simulation-engine ;
    vc:isPartOf ngm:real-time-rendering-pipeline ;
    vc:maturity "established" ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:3-d-transform-system,
        ngm:animation-controller,
        ngm:physics-engine ;
    vc:slug "physics-based-animation" ;
    vc:sourceDomain "spatial-computing" .

