# EMC Standard
robotics:EmcStandard rdf:type owl:Class ;
    rdfs:subClassOf robotics:RobotStandard ;
    rdfs:subClassOf robotics:ElectromagneticCompatibility ;
    rdfs:label "EMC Standard"@en ;
    rdfs:comment "EMC standard ensures robots neither emit electromagnetic interference that disrupts other equipment nor experience susceptibility to external electromagnetic noise that degrades performance. These standards, including IEC 61000 series and equivalents, define measurement procedures and immunity limits enabling robots to operate reliably alongside other industrial equipment."@en ;
    skos:prefLabel "EMC Standard"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:robotics:emc-standard" ;
    owl:sameAs <urn:visionclaw:concept:robotics:emc-standard> ;
