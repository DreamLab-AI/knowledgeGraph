ngm:graph-databases a owl:Class ;
    rdfs:label "Graph Databases"@en ;
    rdfs:comment "Graph databases are database management systems that represent and store data as a network of nodes (entities) and edges (relationships), with both capable of carrying named property sets. Unlike relational models that encode relationships through foreign-key joins, graph databases make adjacency a first-class storage primitive, enabling traversal-based queries that navigate multi-hop paths in near-constant time per hop. They implement the property-graph or RDF triple-store data models, and are queried via languages such as Cypher, Gremlin, or SPARQL. Their native graph storage and index-free adjacency make them especially suited to domains where relationships are as semantically rich as the entities themselves."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:rdf-triple-store ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:graph-algorithms ],
        ngm:database-systems ;
    vc:bridgesTo ngm:graph-neural-networks,
        ngm:knowledge-representation,
        ngm:ontology-engineering ;
    vc:contrastsWith ngm:columnar-databases,
        ngm:document-stores,
        ngm:relational-databases ;
    vc:enables ngm:fraud-detection,
        ngm:knowledge-graphs,
        ngm:network-analysis,
        ngm:recommendation-systems,
        ngm:semantic-search ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:graph-query-language,
        ngm:index-free-adjacency,
        ngm:property-graph-model,
        ngm:rdf-triple-store ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:linked-data,
        ngm:nosql-databases,
        ngm:social-network-analysis ;
    vc:requires ngm:graph-algorithms,
        ngm:graph-data-model ;
    vc:slug "graph-databases" ;
    vc:sourceDomain "data" ;
    vc:uses ngm:cypher-query-language,
        ngm:gremlin-traversal-language,
        ngm:sparql .

