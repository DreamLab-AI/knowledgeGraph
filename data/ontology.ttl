ngm:video-codec a owl:Class ;
    rdfs:label "Video Codec"@en ;
    rdfs:comment "A video codec (coder-decoder) is an algorithm or hardware implementation that compresses and decompresses digital video by exploiting spatial redundancy within frames (intra-prediction), temporal redundancy across frames (inter-prediction with motion compensation), and transform coding of residuals, enabling practical storage and transmission of video at bitrates orders of magnitude lower than uncompressed formats whilst maintaining perceptual quality."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:convolution ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:encoder ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:decoder ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:motion-estimation ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:entropy-coding ],
        ngm:encoder-decoder-architecture ;
    vc:bridgesTo ngm:machine-learning,
        ngm:spatial-computing ;
    vc:contrastsWith ngm:audio-codec,
        ngm:lossless-compression ;
    vc:enables ngm:adaptive-bitrate-streaming,
        ngm:bandwidth-optimization,
        ngm:computer-vision-video-analysis,
        ngm:video-encoding ;
