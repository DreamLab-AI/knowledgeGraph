    vc:slug "cryptographic-hash" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:blockchain,
        ngm:encryption,
        ngm:zero-knowledge-proof .

ngm:de-fi a owl:Class ;
    rdfs:label "DeFi"@en ;
    rdfs:comment "DeFi (Decentralised Finance) is the ecosystem of open, permissionless financial protocols and applications deployed as Smart Contracts on public blockchains — primarily Ethereum — that replicate and extend traditional financial services (lending, borrowing, trading, yield generation, derivatives) without centralised intermediaries such as banks, brokers, or clearinghouses. Core DeFi primitives include Automated Market Makers (AMMs), over-collateralised lending protocols, algorithmic stablecoins, and yield aggregators, all coordinated through token-based incentive mechanisms and governed by Decentralised Autonomous Organisations (DAOs). DeFi protocols are composable: outputs of one protocol can be inputs to another, enabling complex financial strategies assembled from protocol lego blocks."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:smart-contract ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:blockchain ],
        ngm:bc-defi-and-economics ;
    skos:broader ngm:bc-defi-and-economics ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:dao-governance,
        ngm:token-economics ;
    vc:requires ngm:blockchain,
        ngm:smart-contract ;
    vc:slug "de-fi" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:governance-token,
        ngm:liquidity-pool .

ngm:differential-privacy a owl:Class ;
    rdfs:label "Differential Privacy"@en ;
    rdfs:comment "Differential Privacy is a mathematical framework providing provable privacy guarantees by adding carefully calibrated noise to data queries or model outputs, ensuring that the presence or absence of any single individual's data has negligible impact on analysis results. The epsilon (ε) parameter quantifies the privacy budget, with smaller values indicating stronger guarantees."@en ;
    rdfs:subClassOf ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:enables ngm:federated-edge-learning,
        ngm:privacy-by-design ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:data-minimisation,
        ngm:federated-learning,
        ngm:homomorphic-encryption,
        ngm:privacy-budget-management,
        ngm:privacy-mechanism ;
    vc:slug "differential-privacy" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:data-protection,
        ngm:gdpr-compliance ;
    vc:uses ngm:machine-learning .

ngm:extended-reality a owl:Class ;
    rdfs:label "Extended Reality"@en ;
    rdfs:comment "Extended Reality (XR) is an umbrella term encompassing Virtual Reality (VR), Augmented Reality (AR), and Mixed Reality (MR). XR technologies alter or extend the user's perception of the physical environment through head-mounted displays, spatial tracking, and real-time rendering. XR serves as the primary experiential layer of the spatial computing stack, bridging physical and digital environments across training, collaboration, entertainment, and industrial applications."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:virtual-reality ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:augmented-reality ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:mixed-reality ],
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:enables ngm:immersive-experience,
        ngm:virtual-environment ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:augmented-reality,
        ngm:mixed-reality,
        ngm:virtual-reality ;
    vc:qualityScore "0.3"^^xsd:float ;
    vc:slug "extended-reality" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:haptics,
        ngm:xr-hardware .

ngm:generative-model a owl:Class ;
    rdfs:label "Generative Model"@en ;
    rdfs:comment "A class of machine learning models that learn the underlying probability distribution of training data and can sample novel instances from that distribution. Architectures include generative adversarial networks, variational autoencoders, diffusion models, normalising flows, and autoregressive transformers, covering domains such as text, image, audio, and code generation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:generative-adversarial-network ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:deep-generative-model ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:autoencoder ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:large-language-models ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:diffusion-model ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:latent-diffusion ],
        ngm:ai-model-architecture,
        ngm:machine-learning ;
    skos:broader ngm:ai-model-architecture ;
    vc:enables ngm:image-generation,
        ngm:text-generation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:autoencoder,
        ngm:deep-generative-model,
        ngm:diffusion-model,
        ngm:generative-adversarial-network,
        ngm:large-language-models,
        ngm:latent-diffusion ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:deep-learning,
        ngm:transformer ;
    vc:slug "generative-model" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:physics-simulation a owl:Class ;
    rdfs:label "Physics Simulation"@en ;
    rdfs:comment "Physics Simulation is the computational modelling of physical phenomena — including rigid-body dynamics, soft-body deformation, fluid behaviour, and collision detection — to produce physically plausible behaviour in virtual environments. It underpins interactive experiences in virtual reality, robotics training, and digital-twin applications by enabling real-time or near-real-time approximations of classical mechanics."@en ;
    rdfs:subClassOf ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
