    rdfs:label "Sequence Model"@en .

ngm:service-robotics a owl:Class ;
    rdfs:label "Service Robotics"@en ;
    rdfs:comment "Service robotics is the branch of robotics concerned with robots that perform useful tasks for humans outside industrial manufacturing, including cleaning, logistics, hospitality, healthcare, and domestic assistance. These systems emphasise autonomous navigation in unstructured human environments, safe interaction, and task planning under uncertainty. It is a rapidly growing application domain of mobile and collaborative robots."@en ;
    rdfs:subClassOf ngm:robotics ;
    skos:broader ngm:robotics ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:robotics-core-concepts,
        ngm:task-planning ;
    vc:slug "service-robotics" ;
    vc:sourceDomain "robotics" .

ngm:shading-model a owl:Class ;
    rdfs:label "Shading Model"@en ;
    rdfs:comment "A shading model is a mathematical description of how a surface reflects and emits light, determining the colour and intensity seen at each point given the lighting and viewing geometry. It encapsulates a bidirectional reflectance distribution function together with parameters such as albedo, roughness and metalness. Shading models range from simple empirical formulations to physically based formulations grounded in energy conservation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:brdf ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:material-system ],
        ngm:rendering ;
    vc:dependsOn ngm:brdf ;
    vc:enables ngm:global-illumination,
        ngm:real-time-rendering ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:brdf,
        ngm:material-system ;
    vc:implements ngm:physically-based-rendering ;
    vc:isPartOf ngm:graphics-pipeline ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:material-system,
        ngm:physically-based-rendering,
        ngm:rendering-technique ;
    vc:slug "shading-model" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:gpu-rendering ;
    vc:uses ngm:shader,
        ngm:texture-mapping .

ngm:shadow-banking a owl:Class ;
    rdfs:label "Shadow Banking"@en ;
    rdfs:comment "Shadow banking refers to credit intermediation and maturity transformation conducted by non-bank financial entities that operate outside the perimeter of conventional deposit-taking banking regulation. It encompasses activities such as money-market funds, securitisation vehicles, repo markets, and hedge-fund lending that perform bank-like functions without access to central-bank backstops or deposit insurance. Because it sits beyond standard prudential oversight, shadow banking can amplify systemic risk during periods of market stress."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:market-microstructure ],
        ngm:finance ;
    vc:bridgesTo ngm:finance ;
    vc:contrastsWith ngm:central-bank,
        ngm:traditional-banking ;
    vc:dependsOn ngm:liquidity ;
    vc:enables ngm:price-discovery ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:finance ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:liquidity,
        ngm:market-microstructure,
        ngm:systemic-risk ;
    vc:requires ngm:market-microstructure ;
    vc:slug "shadow-banking" ;
    vc:sourceDomain "finance" ;
    vc:supports ngm:price-discovery,
        ngm:regulatory-compliance ;
    vc:uses ngm:high-frequency-trading .

ngm:shared-ar-experiences a owl:Class ;
    rdfs:label "Shared Ar Experiences"@en ;
    rdfs:comment "Collaborative augmented reality interactions enabling multiple users to simultaneously view and interact with digital content overlaid on shared physical environments, supporting real-time synchronization of virtual objects across devices for social connection and joint activities."@en ;
    rdfs:subClassOf ngm:augmented-reality,
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:slug "shared-ar-experiences" ;
    vc:sourceDomain "spatial-computing" .

ngm:shared-virtual-space a owl:Class ;
    rdfs:label "Shared Virtual Space"@en ;
    rdfs:comment "A Shared Virtual Space is a persistent, synchronised three-dimensional environment that multiple remote participants inhabit simultaneously through their avatars or representations. It provides a common spatial context for collaboration, enabling participants to co-locate, manipulate shared artefacts, and engage in spatial communication as if physically together. Such spaces underpin immersive remote collaboration by combining real-time synchronisation, access control, and spatial audio to create a convincing sense of co-presence."@en ;
    rdfs:subClassOf ngm:dc-telepresence ;
    skos:broader ngm:dc-telepresence ;
    vc:enables ngm:immersive-collaboration ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:avatar-embodiment,
        ngm:virtual-reality-telepresence ;
    vc:slug "shared-virtual-space" ;
    vc:sourceDomain "distributed-collaboration" .

ngm:simplified-payment-verification a owl:Class ;
    rdfs:label "Simplified Payment Verification"@en ;
    rdfs:comment "Simplified Payment Verification (SPV) is a technique that lets a lightweight client confirm that a transaction is included in a blockchain without downloading the entire chain, by holding only block headers and requesting a Merkle proof linking the transaction to a header's Merkle root. Described in the original Bitcoin design, it trades the full validation guarantees of a complete node for drastically reduced storage and bandwidth, relying on the proof-of-work in headers and the honest-majority assumption. It is what makes mobile and embedded cryptocurrency wallets practical."@en ;
    rdfs:subClassOf ngm:blockchain ;
    skos:broader ngm:blockchain ;
    vc:contrastsWith ngm:full-node ;
    vc:dependsOn ngm:block-header,
        ngm:merkle-proof ;
    vc:enables ngm:light-node,
        ngm:scalability ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:light-client ;
    vc:isPartOf ngm:blockchain-node ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:bloom-filter,
        ngm:utxo-model ;
    vc:slug "simplified-payment-verification" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:bitcoin ;
    vc:uses ngm:merkle-root,
        ngm:merkle-tree .

ngm:single-point-of-failure a owl:Class ;
    rdfs:label "Single Point Of Failure"@en ;
    rdfs:comment "A single point of failure is a component, service, or dependency within a system whose failure would cause the entire system to stop functioning, because no redundant alternative exists to take over its role. Identifying and eliminating single points of failure is a central goal of high-availability and fault-tolerant design. Mitigation strategies include redundancy, replication, clustering, and load balancing so that no individual element is indispensable."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:health-monitoring ],
        ngm:reliability-engineering ;
    vc:bridgesTo ngm:load-balancing ;
    vc:contrastsWith ngm:fault-tolerance,
        ngm:high-availability,
        ngm:redundancy ;
    vc:dependsOn ngm:infrastructure ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:reliability-engineering ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:clustering,
        ngm:disaster-recovery,
        ngm:distributed-systems,
        ngm:resilience ;
    vc:requires ngm:health-monitoring ;
    vc:slug "single-point-of-failure" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:monitoring .

ngm:slack a owl:Class ;
    rdfs:label "Slack"@en ;
    rdfs:comment "Slack is a cloud-based team messaging and collaboration platform that organises workplace communication into persistent, searchable channels grouped by topic, project, or team, supplemented by direct messages and threaded conversations. Originally developed as an internal tool for the gaming company Tiny Speck in 2013 before pivoting to a standalone product, Slack is distinguished by its extensible integration ecosystem (over 2,500 app integrations), Workflow Builder for no-code automation, and its role as the de facto communication layer for software development teams. Acquired by Salesforce in 2021 for $27.7 billion, it competes primarily with Microsoft Teams."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:identity-and-access-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:workflow-engine ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cloud-infrastructure ],
        ngm:collaboration-platform ;
    vc:bridgesTo ngm:artificial-intelligence,
        ngm:distributed-collaboration ;
    vc:contrastsWith ngm:email,
        ngm:microsoft-teams ;
    vc:enables ngm:incident-management,
        ngm:remote-collaboration,
        ngm:workflow-automation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:channel,
        ngm:workflow-engine ;
    vc:implements ngm:real-time-messaging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:devops,
        ngm:digital-workplace-platform,
        ngm:distributed-team-collaboration,
        ngm:remote-work ;
    vc:requires ngm:cloud-infrastructure,
        ngm:identity-and-access-management ;
    vc:slug "slack" ;
    vc:sourceDomain "distributed-collaboration" ;
    vc:uses ngm:api-integration,
        ngm:asynchronous-communication,
        ngm:oauth,
        ngm:threaded-messaging,
        ngm:websocket .

ngm:smart-building a owl:Class ;
    rdfs:label "Smart Building"@en ;
    rdfs:comment "A Smart Building is a facility that integrates networked sensors, actuators, control systems, and analytical software to automatically optimise energy consumption, occupant comfort, security, and operational efficiency in real time. Building systems — HVAC, lighting, access control, fire detection, lifts, and power distribution — are connected through a building management system (BMS) and increasingly exposed through open protocols such as BACnet, Modbus, MQTT, and OPC-UA to enable data-driven control strategies. Machine learning models analyse sensor streams to predict occupancy, detect anomalies, and schedule maintenance proactively. Smart buildings are fundamental nodes in [[Smart City]] infrastructure, integrating with district energy grids, electric vehicle charging, and urban mobility platforms."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:real-time-data-processing ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:iot-security ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:iot-sensor ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:building-automation ],
        ngm:building-automation ;
    vc:bridgesTo ngm:building-information-modelling,
        ngm:smart-city ;
    vc:dependsOn ngm:industrial-iot,
        ngm:iot-integration ;
    vc:enables ngm:iot-ai-integration,
        ngm:real-time-control,
        ngm:smart-city-infrastructure ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:building-automation,
        ngm:iot-infrastructure,
        ngm:iot-sensor ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:cyber-physical-systems,
        ngm:iot,
        ngm:smart-home-automation ;
    vc:requires ngm:iot-security,
        ngm:real-time-data-processing ;
    vc:slug "smart-building" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:smart-city,
        ngm:smart-grid,
        ngm:smart-home ;
    vc:uses ngm:iot-device,
        ngm:iot-sensor-network,
        ngm:real-time-analytics .

ngm:smart-cities a owl:Class ;
    rdfs:label "Smart Cities"@en ;
    rdfs:comment "Smart Cities are urban environments that integrate digital technologies, data analytics, Internet of Things infrastructure, and connectivity to optimise the delivery of public services, improve quality of life, increase operational efficiency, and advance sustainability goals. They instrumentalise physical infrastructure — transport networks, utilities, buildings, and public spaces — with sensors and actuators connected through communication networks, and apply data-driven decision-making to city operations, planning, and citizen engagement."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cybersecurity ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-governance ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:smart-grid ],
        ngm:digital-twin-of-society-dto-s ;
    vc:bridgesTo ngm:distributed-collaboration,
        ngm:governance,
        ngm:spatial-computing ;
    vc:dependsOn ngm:distributed-systems,
        ngm:infrastructure ;
    vc:enables ngm:autonomous-vehicle,
        ngm:open-data,
        ngm:predictive-maintenance,
        ngm:smart-grid,
        ngm:sustainable-development ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:smart-grid ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:liverpool-smart-cities,
        ngm:privacy,
        ngm:real-time-monitoring,
        ngm:urban-computing ;
    vc:requires ngm:cybersecurity,
        ngm:data-governance,
        ngm:urban-infrastructure ;
    vc:slug "smart-cities" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:5-g-network,
        ngm:artificial-intelligence,
        ngm:cloud-computing,
        ngm:data-analytics,
        ngm:digital-twin,
        ngm:edge-ai-for-smart-cities,
        ngm:edge-computing,
        ngm:internet-of-things .

ngm:smart-royalty-contract a owl:Class ;
    rdfs:label "Smart Royalty Contract"@en ;
    rdfs:comment "A programmable blockchain contract that automatically enforces royalty payment terms, calculates compensation amounts, and triggers distributions to creators and rights holders upon qualifying transactions in NFT and digital asset ecosystems."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:payment-token ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:token-standard ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:smart-contract-platform ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:event-emission ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:oracle-service ],
