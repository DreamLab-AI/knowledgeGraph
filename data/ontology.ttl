# Virtual Wedding
spatial-computing:VirtualWedding rdf:type owl:Class ;
    rdfs:subClassOf spatial-computing:VirtualEvent ;
    rdfs:label "Virtual Wedding"@en ;
    rdfs:comment "A marriage ceremony conducted in virtual environments or metaverse platforms where participants are represented by digital avatars, enabling global attendance, customizable virtual venues, and unique digital elements like NFT wedding gifts, often requiring accompaniment by legal proceedings for official recognition."@en ;
    skos:prefLabel "Virtual Wedding"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:spatial-computing:virtual-wedding" ;
    owl:sameAs <urn:visionclaw:concept:spatial-computing:virtual-wedding> ;
