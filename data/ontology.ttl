    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:interchain-token-service,
        ngm:smart-contract,
        ngm:squid-router,
        ngm:token ;
    vc:isPartOf ngm:cosmos ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:bridge,
        ngm:interoperability-protocol ;
    vc:requires ngm:threshold-cryptography,
        ngm:validator-set ;
    vc:slug "axelar" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:defi-protocol,
        ngm:evm,
        ngm:non-evm-chain ;
    vc:uses ngm:consensus-mechanism,
        ngm:message-passing,
        ngm:proof-of-stake .

ngm:aztec-protocol a owl:Class ;
    rdfs:label "Aztec Protocol"@en ;
    rdfs:comment "The protocol underlying the Aztec network that combines zero-knowledge proofs with an encrypted note model to provide confidential transactions and private smart contracts on Ethereum, enabling programmable privacy through a UTXO-style note commitment scheme verified by recursive ZK rollup proofs."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
