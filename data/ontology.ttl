ngm:data-acquisition a owl:Class ;
    rdfs:label "Data Acquisition"@en ;
    rdfs:comment "Data acquisition is the process of gathering raw signals and measurements from sensors and the environment, then conditioning and recording them for downstream use in perception, learning, and control. In robotics it spans sampling sensor streams, time-synchronising heterogeneous sources, and logging structured datasets for training and analysis. High-quality acquisition is foundational because the fidelity of perception and learned policies depends on the data captured."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:sensor ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:telemetry ],
        ngm:data-collection ;
    vc:bridgesTo ngm:teleoperation ;
    vc:enables ngm:computer-vision,
        ngm:perception ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:data-collection ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:data-collection,
        ngm:perception,
        ngm:sensor ;
    vc:requires ngm:sensor,
        ngm:telemetry ;
    vc:slug "data-acquisition" ;
    vc:sourceDomain "robotics" ;
    vc:supports ngm:data-pipeline,
        ngm:imitation-learning ;
    vc:uses ngm:lidar-sensor,
        ngm:sensor,
        ngm:sensor-fusion .

ngm:data-drift a owl:Class ;
    rdfs:label "Data Drift"@en ;
    rdfs:comment "Data drift is the change over time in the statistical distribution of the input data fed to a deployed machine learning model relative to the distribution it was trained on. Unlike concept drift, which alters the relationship between inputs and targets, data drift (also called covariate or feature drift) shifts the marginal distribution of the features themselves and can silently degrade model accuracy even when the learned mapping remains valid. Detecting and responding to data drift is a central concern of model monitoring and MLOps, typically driving alerts, scheduled retraining, or fallback policies."@en ;
    rdfs:subClassOf ngm:concept-drift ;
    vc:bridgesTo ngm:mlops ;
    vc:contrastsWith ngm:concept-drift ;
    vc:dependsOn ngm:feature-distribution,
        ngm:probability-distribution ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:model-monitoring ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:anomaly-detection,
        ngm:covariate-shift,
        ngm:distribution-shift ;
    vc:requires ngm:retraining ;
    vc:slug "data-drift" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:density-estimation,
        ngm:statistics .

ngm:data-infrastructure a owl:Class ;
    rdfs:label "Data Infrastructure"@en ;
    rdfs:comment "Data infrastructure is the integrated set of systems, platforms, and pipelines that ingest, store, process, govern, and serve data across an organisation. It encompasses storage layers such as data warehouses and data lakes, processing and integration pipelines, cataloguing and governance, and the compute fabric that supports analytics and machine learning. Data infrastructure provides the reliable, scalable foundation on which data products and decision-making depend."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-engineering ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:data-lake ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:data-pipeline ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-integration ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:data-warehouse ],
        ngm:infrastructure ;
    skos:broader ngm:infrastructure ;
    vc:bridgesTo ngm:data-governance,
        ngm:observability ;
    vc:dependsOn ngm:networking,
        ngm:scalability ;
    vc:enables ngm:data-architecture ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:data-lake,
        ngm:data-pipeline,
        ngm:data-warehouse ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:data-catalog,
        ngm:reliability ;
    vc:requires ngm:data-engineering,
        ngm:data-integration ;
    vc:slug "data-infrastructure" ;
    vc:sourceDomain "data" ;
    vc:supports ngm:business-intelligence,
        ngm:machine-learning ;
    vc:uses ngm:cloud-computing,
        ngm:database .

ngm:database-systems a owl:Class ;
    rdfs:label "Database Systems"@en ;
    rdfs:comment "Database systems are organised software stacks — comprising a storage engine, query processor, transaction manager, and access-control layer — that persistently store, retrieve, and manipulate structured or semi-structured data. They enforce ACID or BASE consistency guarantees, coordinate concurrent access via locking or multi-version concurrency control (MVCC), and expose declarative query languages such as SQL or graph-query dialects. Modern database systems span relational, document, key-value, columnar, time-series, and graph data models, each optimised for distinct access patterns and workload characteristics."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:nosql-database ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:time-series-database ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:query-processing ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:relational-database ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:concurrency-control ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:storage-systems ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:graph-databases ],
        ngm:data-management ;
    vc:bridgesTo ngm:knowledge-graphs,
        ngm:machine-learning ;
    vc:contrastsWith ngm:file-system,
        ngm:memory-store ;
    vc:dependsOn ngm:distributed-systems,
        ngm:operating-system ;
    vc:enables ngm:data-analytics,
        ngm:data-warehousing,
        ngm:microservices,
        ngm:real-time-processing ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:columnar-storage,
        ngm:graph-databases,
        ngm:nosql-database,
        ngm:relational-database,
        ngm:time-series-database ;
    vc:implements ngm:acid-transactions,
        ngm:structured-query-language ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:data-lake,
        ngm:data-modelling,
        ngm:event-streaming ;
    vc:requires ngm:concurrency-control,
        ngm:query-processing,
        ngm:storage-systems ;
    vc:slug "database-systems" ;
    vc:sourceDomain "data" ;
    vc:standardizedBy ngm:iso-iec-9075 ;
    vc:supports ngm:access-control,
        ngm:data-governance ;
    vc:uses ngm:caching,
        ngm:indexing,
        ngm:replication .

ngm:dead-reckoning a owl:Class ;
    rdfs:label "Dead Reckoning"@en ;
    rdfs:comment "Dead reckoning is a navigation technique that estimates an entity's current position by applying its known speed, heading, and elapsed time to a previously determined position. It relies on relative motion measurements from sensors such as inertial measurement units and wheel encoders rather than external position fixes. Because errors accumulate over time as drift, dead reckoning is typically fused with absolute references like GPS to maintain accuracy."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:state-estimation ],
        ngm:localisation ;
    vc:bridgesTo ngm:sensor-fusion ;
    vc:contrastsWith ngm:gps ;
    vc:dependsOn ngm:inertial-measurement-unit,
        ngm:odometry ;
    vc:enables ngm:autonomous-navigation,
        ngm:pose-estimation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:imu,
        ngm:kalman-filter,
        ngm:navigation,
        ngm:sensor-fusion ;
    vc:requires ngm:state-estimation ;
    vc:slug "dead-reckoning" ;
    vc:sourceDomain "robotics" ;
    vc:supports ngm:mobile-robot,
        ngm:simultaneous-localisation-and-mapping ;
    vc:uses ngm:accelerometer,
        ngm:gyroscope,
        ngm:velocity .

ngm:decentralised-coordination a owl:Class ;
    rdfs:label "Decentralised Coordination"@en ;
    rdfs:comment "Decentralised coordination refers to mechanisms by which multiple autonomous agents—human or machine—achieve collective outcomes without a central authority directing behaviour, relying instead on shared protocols, incentive structures, consensus rules, or emergent social norms. In blockchain contexts it manifests as DAO governance, token-based voting, and smart-contract-enforced agreements that replace managerial hierarchy with algorithmic rule."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:token-weighted-voting ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:byzantine-fault-tolerance ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:conviction-voting ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:consensus-mechanism ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:smart-contract ],
        ngm:autonomous-governance ;
    vc:bridgesTo ngm:ai-agent-coordination,
        ngm:multi-agent-systems ;
    vc:contrastsWith ngm:centralised-governance,
        ngm:hierarchical-organisation ;
    vc:enables ngm:dao-governance,
        ngm:permissionless-participation,
        ngm:treasury-management ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:conviction-voting,
        ngm:token-weighted-voting ;
    vc:implements ngm:mechanism-design ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:algorithmic-governance,
        ngm:commons-governance,
        ngm:game-theory ;
    vc:requires ngm:byzantine-fault-tolerance,
        ngm:consensus-mechanism,
        ngm:smart-contract ;
    vc:slug "decentralised-coordination" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:asynchronous-coordination,
        ngm:dao,
        ngm:incentive-mechanism,
        ngm:quadratic-voting .

ngm:decentralised-trust a owl:Class ;
    rdfs:label "Decentralised Trust"@en ;
    rdfs:comment "Decentralised trust is an architectural property of a system in which confidence in the correctness of data, identity claims, or transaction outcomes is derived from cryptographic proofs, distributed consensus, and transparent protocol rules rather than from reliance on any single central authority or intermediary. Rather than placing faith in a bank, government registry, or certificate authority, participants in a decentralised trust model verify claims independently using public-key cryptography, Merkle proofs, or zero-knowledge proofs enforced by a distributed network. The result is a system where trust is a computable property of the protocol rather than a social or legal delegation to an institution."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:distributed-ledger ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:byzantine-fault-tolerance ],
        ngm:trust ;
    vc:bridgesTo ngm:digital-governance,
        ngm:supply-chain-provenance ;
    vc:contrastsWith ngm:certificate-authority,
        ngm:public-key-infrastructure ;
    vc:dependsOn ngm:hash-function,
        ngm:peer-to-peer-network ;
    vc:enables ngm:decentralised-finance,
        ngm:decentralised-identity,
        ngm:permissionless-participation,
        ngm:self-sovereign-identity,
        ngm:trustless-settlement ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:blockchain,
        ngm:decentralisation,
        ngm:oracle-problem,
        ngm:web-of-trust ;
    vc:requires ngm:byzantine-fault-tolerance,
        ngm:distributed-ledger ;
    vc:slug "decentralised-trust" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:cryptographic-proof,
        ngm:cryptographic-verification,
        ngm:digital-signature,
        ngm:distributed-consensus,
        ngm:merkle-proof,
        ngm:public-key-cryptography,
        ngm:trust-anchor,
        ngm:zero-knowledge-proof .

ngm:decentralized-exchange-dex a owl:Class ;
    rdfs:label "Decentralized Exchange (DEX)"@en ;
    rdfs:comment "Peer-to-peer marketplace enabling direct token swaps and digital asset trading through smart contracts without centralized intermediaries or custodial control."@en ;
