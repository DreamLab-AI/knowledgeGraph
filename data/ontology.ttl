ngm:data-augmentation a owl:Class ;
    rdfs:label "Data Augmentation"@en ;
    rdfs:comment "Data augmentation is a machine learning technique that expands a training dataset by applying label-preserving transformations or synthesising new examples from existing data. Typical methods include geometric and photometric image transforms, noise injection, and generative model sampling such as GAN-produced samples. It improves model generalisation and robustness, mitigating overfitting when labelled data is scarce."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:training-dataset ],
        ngm:machine-learning-discipline-technique ;
    vc:bridgesTo ngm:computer-vision,
        ngm:natural-language-processing ;
    vc:contrastsWith ngm:active-learning,
        ngm:data-collection ;
    vc:dependsOn ngm:data-preprocessing,
        ngm:training-pipeline ;
    vc:enables ngm:class-imbalance-mitigation,
        ngm:model-generalisation,
        ngm:overfitting-prevention ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:colour-jitter,
        ngm:geometric-transformation,
        ngm:mixup-augmentation,
        ngm:noise-injection ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:few-shot-learning,
        ngm:regularisation ;
    vc:requires ngm:label-preserving-transformation,
        ngm:training-dataset ;
    vc:slug "data-augmentation" ;
    vc:sourceDomain "machine-learning" ;
    vc:supports ngm:semi-supervised-learning,
        ngm:supervised-learning,
        ngm:transfer-learning ;
    vc:uses ngm:diffusion-model,
        ngm:generative-adversarial-networks,
        ngm:synthetic-data-generator,
        ngm:variational-autoencoder .

