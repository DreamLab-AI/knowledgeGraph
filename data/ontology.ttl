ngm:low-latency-interaction a owl:Class ;
    rdfs:label "Low-Latency Interaction"@en ;
    rdfs:comment "Low-latency interaction is the design property of a system in which the delay between a user action and the corresponding system response is minimised to preserve a sense of immediacy. In immersive and real-time contexts such as the metaverse, latency below roughly 20 milliseconds is critical to avoid perceptual disconnect and motion sickness. Achieving it requires optimised networking, predictive rendering, and edge computation."@en ;
    rdfs:subClassOf ngm:sc-interaction ;
    skos:broader ngm:sc-interaction ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:latency-management-protocol,
        ngm:networking-layer ;
    vc:slug "low-latency-interaction" ;
    vc:sourceDomain "metaverse" .

ngm:low-rank-decomposition a skos:Concept ;
    rdfs:label "Low Rank Decomposition"@en .

ngm:low-resource-nlp a skos:Concept ;
    rdfs:label "Low Resource NLP"@en .

ngm:lower-limb-exoskeleton a owl:Class ;
    rdfs:label "Lower Limb Exoskeleton"@en ;
    rdfs:comment "A Lower Limb Exoskeleton is a wearable robotic device that attaches externally to the legs and pelvis to assist, augment, or rehabilitate walking and lower-body movements by generating torques at hip, knee, and ankle joints. Devices span fully-active systems driven by electric actuators or hydraulics, passive systems using spring and damping elements to redirect energy, and hybrid configurations combining both. Applications include stroke rehabilitation (restoring gait through repetitive, robot-guided movement therapy), spinal-cord-injury locomotion assistance, load-carrying augmentation for industrial and military tasks, and fall prevention in elderly populations. Control strategies range from finite-state machines triggered by gait-phase detection through inertial measurement units and pressure sensors, to intent-recognition systems integrating electromyography and machine learning."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:sensor ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:imu ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:torque ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:actuator ],
        ngm:exoskeleton-robot,
        ngm:robo-robot-type ;
    skos:broader ngm:robo-robot-type ;
    vc:enables ngm:human-robot-interaction,
        ngm:safety ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:collaborative-systems-modality-robot,
        ngm:collision-avoidance,
        ngm:embodied-ai,
        ngm:iso-10218 ;
    vc:requires ngm:actuator,
        ngm:imu,
        ngm:sensor,
        ngm:torque ;
    vc:slug "lower-limb-exoskeleton" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:force-control,
        ngm:motion-planning,
        ngm:reinforcement-learning,
        ngm:variable-impedance-control .

ngm:lsm-tree a skos:Concept ;
    rdfs:label "Lsm Tree"@en .

ngm:lstm a owl:Class ;
    rdfs:label "LSTM"@en ;
    rdfs:comment "Long Short-Term Memory (LSTM) is a specialised recurrent neural network architecture introduced by Hochreiter and Schmidhuber in 1997, designed to learn long-range temporal dependencies in sequential data. It employs a gated cell state mechanism—comprising input, forget, and output gates—that allows gradients to flow across many time steps without vanishing or exploding, overcoming the principal failure mode of vanilla recurrent neural networks. LSTMs encode contextual information in a learnable cell state that persists across sequence steps, making them highly effective for variable-length sequence modelling tasks such as language modelling, machine translation, and time-series forecasting. Although largely superseded by Transformer-based architectures for many NLP tasks, LSTMs remain widely deployed in low-latency, resource-constrained, and streaming scenarios."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gradient-descent ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:backpropagation ],
        ngm:recurrent-neural-network ;
    vc:bridgesTo ngm:anomaly-detection,
        ngm:edge-inference ;
    vc:contrastsWith ngm:gated-recurrent-unit,
        ngm:transformer,
        ngm:vanilla-rnn ;
    vc:enables ngm:handwriting-recognition,
        ngm:language-modelling,
        ngm:machine-translation,
        ngm:speech-recognition,
        ngm:time-series-forecasting ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:cell-state,
        ngm:forget-gate,
        ngm:input-gate,
        ngm:output-gate ;
    vc:isPartOf ngm:deep-learning,
        ngm:sequence-modelling ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:attention-mechanism,
        ngm:encoder-decoder,
        ngm:natural-language-processing,
        ngm:vanishing-gradient-problem ;
    vc:requires ngm:backpropagation,
        ngm:backpropagation-through-time,
        ngm:gradient-descent ;
    vc:slug "lstm" ;
    vc:sourceDomain "machine-learning" ;
    vc:uses ngm:dropout-regularisation,
        ngm:sigmoid-activation,
        ngm:tanh-activation .

ngm:luxury-goods-authentication a owl:Class ;
    rdfs:label "Luxury Goods Authentication"@en ;
    rdfs:comment "Luxury Goods Authentication is the application of blockchain technology to combat counterfeit luxury goods through immutable digital certificates of authenticity, NFC-enabled provenance records, and cryptographic verification that cannot be physically replicated. Implementations such as the LVMH Aura Blockchain Consortium register millions of luxury products with unique digital identities linked to manufacturing details, ownership history, and authentication credentials, enabling both primary-market consumer confidence and secondary-market resale verification."@en ;
    rdfs:subClassOf ngm:bc-network-component ;
    skos:broader ngm:bc-network-component ;
    vc:bridgesTo ngm:provenance-tracking ;
    vc:enables ngm:nft-ownership-proof,
        ngm:supply-chain-traceability ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:blockchain-application,
        ngm:consortium-blockchain,
        ngm:data-provenance,
        ngm:supply-chain-blockchain ;
    vc:slug "luxury-goods-authentication" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:cryptographic-verification,
        ngm:digital-certificate,
        ngm:non-fungible-token-nft,
        ngm:permissioned-blockchain,
        ngm:smart-contract .

ngm:m-bridge a owl:Class ;
    rdfs:label "M-Bridge"@en ;
    rdfs:comment "mBridge (Project mBridge) is a multi-central-bank digital currency platform built on distributed ledger technology to enable real-time, cross-border, multi-currency payments and foreign-exchange settlement. Developed by the BIS Innovation Hub with central banks including those of China, Hong Kong, Thailand, and the UAE, it lets participating institutions transact wholesale CBDCs on a shared ledger. It aims to reduce cost, latency, and intermediary dependence in correspondent banking."@en ;
    rdfs:subClassOf ngm:cross-chain-bridge ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:cbdcs,
        ngm:hyperledger-iroha ;
    vc:slug "m-bridge" ;
    vc:sourceDomain "blockchain" .

