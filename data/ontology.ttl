    vc:sourceDomain "automation" .

ngm:tax a owl:Class ;
    rdfs:label "Tax"@en ;
    rdfs:comment "Tax, in the context of this knowledge graph, refers to the statutory obligations imposed on individuals and legal entities — particularly limited companies — by HMRC and comparable revenue authorities, covering corporation tax on trading profits, self-assessment for personal income drawn as salary or dividends, and VAT registration thresholds. Compliance requires accurate bookkeeping, timely filing of CT600 returns, and annual accounts submission to Companies House."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:accounts ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:regulatory-compliance ],
        ngm:infra-legal-and-regulatory ;
    skos:broader ngm:infra-legal-and-regulatory ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:digital-tax-compliance-node,
        ngm:financial-regulation,
        ngm:legal-compliance ;
    vc:requires ngm:accounts,
        ngm:regulatory-compliance ;
    vc:slug "tax" ;
    vc:sourceDomain "infrastructure" ;
    vc:standardizedBy ngm:legal-framework .

ngm:taxonomy a owl:Class ;
    rdfs:label "Taxonomy"@en ;
    rdfs:comment "A taxonomy is a hierarchical classification scheme that organises concepts or entities into nested categories based on shared characteristics, typically expressing broader-than and narrower-than relationships. It provides a controlled vocabulary that supports consistent naming, navigation, and retrieval within a domain. Taxonomies are a simpler precursor to fuller ontologies, which add richer relations and formal axioms."@en ;
    rdfs:subClassOf ngm:data-management ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:domain-ontology,
        ngm:etsi-metaverse-domain-taxonomy ;
    vc:slug "taxonomy" ;
    vc:sourceDomain "data" .

ngm:technical-architecture-framework a owl:Class ;
    rdfs:label "Technical Architecture Framework"@en ;
    rdfs:comment "A Technical Architecture Framework is a structured methodology or reference model that defines the components, interfaces, and integration patterns needed to design and evaluate complex technology systems — such as metaverse platforms, distributed applications, or spatial-computing stacks. Frameworks such as ETSI's metaverse domain model or IEEE P2874 provide vocabulary, layered decompositions, and conformance criteria that guide architectural decision-making and interoperability."@en ;
    rdfs:subClassOf ngm:definitions-and-frameworks-for-metaverse,
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:enables ngm:technology-ecosystem,
        ngm:technology-infrastructure ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:etsi-metaverse-domain-model,
        ngm:technical-architecture ;
    vc:slug "technical-architecture-framework" ;
    vc:sourceDomain "spatial-computing" ;
    vc:standardizedBy ngm:open-standard ;
    vc:uses ngm:distributed-system-architecture,
        ngm:systems-engineering .

ngm:technology-acceptance-model a owl:Class ;
    rdfs:label "Technology Acceptance Model"@en ;
    rdfs:comment "The Technology Acceptance Model (TAM) is an information-systems theory, introduced by Fred Davis, that predicts user adoption of a technology from two key beliefs: perceived usefulness and perceived ease of use. These beliefs shape attitudes and behavioural intention, which in turn drive actual usage. TAM is one of the most widely applied frameworks for explaining and forecasting the uptake of new technologies."@en ;
    rdfs:subClassOf ngm:governance-framework ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:adoption-of-convergent-technologies,
        ngm:ai-adoption ;
    vc:slug "technology-acceptance-model" ;
    vc:sourceDomain "governance" .

ngm:tele-050-neuralrenderingtelepresence a owl:Class ;
    rdfs:label "TELE 050 neuralrenderingtelepresence"@en ;
    rdfs:comment "Neural Rendering Telepresence (TELE 050) is a class of telepresence systems that replace conventional rasterisation pipelines with neural rendering techniques — including neural radiance fields, Gaussian splatting, and differentiable rendering — to reconstruct and transmit photorealistic volumetric representations of remote participants in real time. These approaches substantially reduce capture hardware requirements while improving perceptual fidelity and supporting free-viewpoint synthesis."@en ;
    rdfs:subClassOf ngm:dc-telepresence,
        ngm:tele-001-telepresence ;
    skos:broader ngm:dc-telepresence ;
    vc:enables ngm:metaverse-and-telecollaboration,
        ngm:volumetric-capture ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:real-time-rendering,
        ngm:tele020virtualrealitytelepresence ;
    vc:slug "tele-050-neuralrenderingtelepresence" ;
    vc:sourceDomain "distributed-collaboration" ;
    vc:uses ngm:gaussian-splatting,
        ngm:neural-radiance-field,
        ngm:neural-rendering .

ngm:tele-110-spatial-audio-processing a owl:Class ;
    rdfs:label "TELE-110-spatial-audio-processing"@en ;
    rdfs:comment "Spatial audio processing is the set of signal-processing techniques that position sound sources in three-dimensional space for a listener, using cues such as direction, distance and room acoustics."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:binaural-rendering ],
        ngm:spatial-audio ;
    vc:enables ngm:telepresence ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:binaural-rendering ;
    vc:slug "tele-110-spatial-audio-processing" ;
    vc:sourceDomain "metaverse" .

ngm:tele020virtualrealitytelepresence a owl:Class ;
    rdfs:label "TELE020virtualrealitytelepresence"@en ;
    rdfs:comment "Virtual Reality Telepresence (TELE020) combines immersive head-mounted display technology with real-time communication infrastructure to create a compelling shared sense of presence among geographically distributed participants. Key technical components include stereoscopic rendering, head-related transfer function spatial audio, full-body motion tracking for avatar animation, and bandwidth-adaptive network transport; modern platforms extend to eye tracking, facial capture, haptic feedback, and mixed-reality blending of physical and virtual participants."@en ;
    rdfs:subClassOf ngm:infra-computing-and-cloud ;
    skos:broader ngm:infra-computing-and-cloud ;
    vc:enables ngm:immersive-experience,
        ngm:metaverse-and-telecollaboration ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:mixed-reality,
        ngm:tele-050-neuralrenderingtelepresence ;
    vc:slug "tele020virtualrealitytelepresence" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:haptic-feedback,
        ngm:spatial-audio,
        ngm:virtual-reality .

ngm:temporal-entity a owl:Class ;
    rdfs:label "Temporal Entity"@en ;
    rdfs:comment "A temporal entity is an ontological category for anything that exists in or is defined by time, such as an instant, an interval, an event, or a process. In knowledge representation it serves as a shared superclass that anchors time-bearing concepts so they can be related by ordering, duration, and containment. The notion follows established time ontologies like the W3C OWL-Time vocabulary."@en ;
    rdfs:subClassOf ngm:entity ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:event,
        ngm:process ;
    vc:slug "temporal-entity" ;
    vc:sourceDomain "data" .

ngm:tensor-flow a owl:Class ;
    rdfs:label "TensorFlow"@en ;
    rdfs:comment "An open-source machine learning framework developed by Google for building and deploying numerical computation and deep learning models across CPUs, GPUs and specialised accelerators."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:hardware-acceleration ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:automatic-differentiation ],
        ngm:machine-learning ;
    vc:enables ngm:backpropagation ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:automatic-differentiation,
        ngm:hardware-acceleration ;
    vc:slug "tensor-flow" ;
    vc:sourceDomain "deep-learning" .

ngm:tensor-parallelism a owl:Class ;
    rdfs:label "Tensor Parallelism"@en ;
    rdfs:comment "Tensor parallelism is a model-parallel training and inference technique that splits individual weight tensors, and the matrix multiplications that use them, across multiple accelerators so that each device holds and computes a shard of every layer. Partial results are combined with collective communication such as all-reduce. It lets models whose layers exceed a single device's memory run at scale, and is typically combined with data and pipeline parallelism."@en ;
    rdfs:subClassOf ngm:ai-infrastructure ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:compute-infrastructure,
        ngm:model-training ;
    vc:slug "tensor-parallelism" ;
    vc:sourceDomain "ai" .

ngm:tether a owl:Class ;
    rdfs:label "Tether"@en ;
    rdfs:comment "Tether is the issuer of USDT, the largest fiat-collateralised stablecoin by circulating supply, designed to maintain a value pegged to the United States dollar. Tokens are issued on numerous blockchains and are intended to be redeemable one-to-one for dollars, backed by reserves held by the issuer. Tether is widely used for trading, settlement and as a dollar proxy on exchanges, and its reserve composition and transparency have been subjects of regulatory scrutiny."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:blockchain ],
        ngm:digital-asset-domain ;
    vc:enables ngm:crypto-trading,
        ngm:stablecoin ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:blockchain,
        ngm:reserve-backing ;
    vc:slug "tether" ;
    vc:sourceDomain "tether" .

ngm:text-summarisation a owl:Class ;
    rdfs:label "Text Summarisation"@en ;
    rdfs:comment "Text summarisation is the NLP task of producing concise, coherent summaries that capture the essential information from longer documents or collections. Systems employ extractive methods (selecting key sentences) or abstractive methods (generating new text) using transformer architectures such as BART, PEGASUS, and T5, with applications spanning news aggregation, research synthesis, and document retrieval."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:natural-language-processing ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:language-modeling ],
        ngm:natural-language-processing,
        ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:enables ngm:information-retrieval ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:prompt-engineering,
        ngm:text-generation ;
    vc:requires ngm:language-modeling,
        ngm:natural-language-processing ;
    vc:slug "text-summarisation" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:bart,
        ngm:large-language-models .

ngm:tezos a owl:Class ;
    rdfs:label "Tezos"@en ;
    rdfs:comment "A proof-of-stake Layer 1 blockchain with on-chain governance that allows the protocol to amend itself through a formal voting process."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:liquid-proof-of-stake ],
        ngm:layer-1 ;
    vc:enables ngm:smart-contract ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:liquid-proof-of-stake ;
    vc:slug "tezos" ;
    vc:sourceDomain "blockchain" .

ngm:threat-intelligence-platform a owl:Class ;
    rdfs:label "Threat Intelligence Platform"@en ;
    rdfs:comment "A threat intelligence platform (TIP) is a security system that aggregates, normalises, and correlates indicators of compromise and adversary intelligence from multiple feeds into an actionable, queryable repository. It enriches and scores indicators, manages their lifecycle, and distributes them to detection and response tooling. A TIP turns raw threat data into context that defenders can use to anticipate, detect, and block attacks."@en ;
    rdfs:subClassOf ngm:cybersecurity ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:cyber-security-and-cryptography,
        ngm:threat-surface-map ;
    vc:slug "threat-intelligence-platform" ;
    vc:sourceDomain "security" .

ngm:three-dimensional-graphics a owl:Class ;
    rdfs:label "Three Dimensional Graphics"@en ;
    rdfs:comment "Three Dimensional Graphics encompasses the computational techniques for modelling, transforming, and rendering three-dimensional geometry onto two-dimensional display surfaces, encompassing rasterisation, ray tracing, shading, and scene graph management. It underpins game engines, virtual and augmented reality platforms, digital twins, and scientific visualisation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:3-d-asset-standard ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:3-d-modeling ],
        ngm:infra-computing-and-cloud ;
    skos:broader ngm:infra-computing-and-cloud ;
    vc:enables ngm:augmented-reality,
        ngm:digital-twin ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:3-d-asset-standard,
        ngm:3-d-modeling ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:slug "three-dimensional-graphics" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:3-d-rendering-engine,
        ngm:game-engine .

ngm:time-of-flight-sensor a owl:Class ;
    rdfs:label "Time-of-Flight Sensor"@en ;
    rdfs:comment "A time-of-flight (ToF) sensor measures distance by emitting a light signal, typically infrared, and timing how long it takes to reflect back from a surface, yielding a per-pixel depth map. Because it directly measures travel time, it produces depth in real time without the baseline geometry needed by stereo cameras. ToF sensors are widely used for hand and gesture tracking, scene reconstruction, and mixed-reality depth sensing."@en ;
    rdfs:subClassOf ngm:sensor ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:hand-tracking,
        ngm:mixed-reality ;
    vc:slug "time-of-flight-sensor" ;
    vc:sourceDomain "robotics" .

ngm:tnfd a owl:Class ;
    rdfs:label "TNFD"@en ;
    rdfs:comment "The Taskforce on Nature-related Financial Disclosures (TNFD) is a global framework that guides organisations in assessing, reporting, and acting on nature- and biodiversity-related risks, dependencies, and impacts. Modelled on the climate-focused TCFD, it provides recommended disclosures structured around governance, strategy, risk management, and metrics so that capital can be redirected toward nature-positive outcomes."@en ;
    rdfs:subClassOf ngm:governance-framework ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:esg-reporting ;
    vc:slug "tnfd" ;
    vc:sourceDomain "governance" .

ngm:toe-framework a owl:Class ;
    rdfs:label "TOE Framework"@en ;
    rdfs:comment "The Technology-Organization-Environment (TOE) framework is an organisational-level theory explaining how a firm's technological context, organisational characteristics, and external environment jointly shape the adoption and assimilation of technological innovations. It is widely applied in information-systems research to model the determinants of enterprise uptake of emerging technologies such as AI and cloud computing."@en ;
    rdfs:subClassOf ngm:governance-framework ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:ai-adoption ;
    vc:slug "toe-framework" ;
    vc:sourceDomain "governance" .

ngm:token-engineering a owl:Class ;
    rdfs:label "Token Engineering"@en ;
    rdfs:comment "The discipline of designing token systems and their incentive structures using methods from economics, control theory and systems engineering. It treats a token economy as a system to be specified, simulated and tested before deployment."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:mechanism-design ],
        ngm:tokenomics ;
    vc:enables ngm:token-economics ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:mechanism-design ;
    vc:slug "token-engineering" ;
    vc:sourceDomain "blockchain" .

ngm:tokenised-real-world-asset-transfer a owl:Class ;
    rdfs:label "Tokenised Real World Asset Transfer"@en ;
    rdfs:comment "Tokenised real-world asset transfer is the movement of on-chain tokens representing claims on off-chain assets such as real estate, commodities, or securities between parties or across blockchain networks. It requires that the cryptographic transfer of the token remains legally and operationally bound to the underlying asset, often relying on cross-chain bridges and interoperability protocols to preserve provenance across ledgers."@en ;
    rdfs:subClassOf ngm:bc-token-and-asset ;
    skos:broader ngm:bc-token-and-asset ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:blockchain-interoperability,
        ngm:cross-chain-bridge ;
    vc:slug "tokenised-real-world-asset-transfer" ;
    vc:sourceDomain "blockchain" .

ngm:tokenised-real-world-assets a owl:Class ;
    rdfs:label "Tokenised Real World Assets"@en ;
    rdfs:comment "Tokenised real-world assets (RWAs) are blockchain tokens that represent ownership or economic rights in tangible or traditional financial assets such as property, bonds, equities, or commodities. By mapping off-chain value onto programmable tokens, they enable fractional ownership, continuous settlement, and integration with decentralised finance while still depending on legal frameworks and custodians for enforceability."@en ;
    rdfs:subClassOf ngm:digital-asset ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:decentralized-finance-de-fi,
        ngm:distributed-ledger ;
    vc:slug "tokenised-real-world-assets" ;
    vc:sourceDomain "blockchain" .

ngm:tokenised-securities a owl:Class ;
    rdfs:label "Tokenised Securities"@en ;
    rdfs:comment "Tokenised securities are regulated financial instruments such as equities, bonds, or fund units issued and transferred as blockchain tokens that carry the same legal rights as their traditional counterparts. They embed compliance logic, including transfer restrictions and investor accreditation checks, directly into smart contracts so that securities laws are enforced programmatically at the point of transaction."@en ;
    rdfs:subClassOf ngm:digital-asset ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:enterprise-smart-contracts,
        ngm:securities-regulation ;
    vc:slug "tokenised-securities" ;
    vc:sourceDomain "blockchain" .

ngm:tokenization-system a owl:Class ;
    rdfs:label "Tokenization System"@en ;
    rdfs:comment "A tokenization system is the end-to-end technical and operational infrastructure that converts rights, assets, or value into blockchain tokens and manages their lifecycle of issuance, transfer, custody, and redemption. It combines smart-contract templates, identity and compliance modules, and registry services to ensure that tokens reliably represent and preserve their underlying claims."@en ;
    rdfs:subClassOf ngm:bc-token-and-asset ;
    skos:broader ngm:bc-token-and-asset ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:crypto-token,
        ngm:fractionalized-nft ;
    vc:slug "tokenization-system" ;
    vc:sourceDomain "blockchain" .

ngm:tool-augmented-llm a owl:Class ;
    rdfs:label "Tool-Augmented LLM"@en ;
    rdfs:comment "A tool-augmented large language model is an LLM that can invoke external tools, APIs, code execution, or retrieval systems during inference to overcome the limits of its parametric knowledge. By emitting structured calls and incorporating the returned results, it can perform calculations, access live data, and act on the world rather than relying solely on text generation."@en ;
    rdfs:subClassOf ngm:large-language-models ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:agents,
        ngm:computer-use-and-browser-agents ;
    vc:slug "tool-augmented-llm" ;
    vc:sourceDomain "ai" .

ngm:tooling-layer a owl:Class ;
    rdfs:label "Tooling Layer"@en ;
    rdfs:comment "The Tooling Layer is the cross-cutting stratum that provides the development, deployment, and observability instruments used to build and operate the rest of the system. It sits beside the production strata rather than within the runtime data path and supports operational and research work. It contains build systems, debuggers, monitors, and automation utilities."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:runtime-layer ],
        ngm:owl-thing ;
    vc:enables ngm:operational-layer,
        ngm:research-layer ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:runtime-layer ;
    vc:slug "tooling-layer" ;
    vc:sourceDomain "tooling" .

ngm:tornado-cash a owl:Class ;
    rdfs:label "Tornado Cash"@en ;
    rdfs:comment "Tornado Cash is a set of non-custodial smart contracts on Ethereum and compatible networks that obscure the on-chain link between a deposit and a withdrawal. Users deposit a fixed denomination of a token into a pool and later withdraw the same amount to a different address, using a zero-knowledge proof to demonstrate ownership of a valid deposit without revealing which one. It became widely known both as a privacy tool and as the subject of sanctions by the United States Office of Foreign Assets Control in 2022."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:zero-knowledge-proof ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ethereum ],
        ngm:cryptographic-domain ;
    vc:enables ngm:transaction-privacy ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:ethereum,
        ngm:zero-knowledge-proof ;
    vc:slug "tornado-cash" ;
    vc:sourceDomain "tornado-cash" .

ngm:toucan-protocol a owl:Class ;
    rdfs:label "Toucan Protocol"@en ;
    rdfs:comment "A blockchain protocol that brings voluntary carbon market credits on-chain as tokens, intended to make carbon offsets tradeable and composable within decentralised finance."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:carbon-credits ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:smart-contract ],
        ngm:carbon-markets ;
    vc:enables ngm:voluntary-carbon-market ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:carbon-credits,
        ngm:smart-contract ;
    vc:slug "toucan-protocol" ;
    vc:sourceDomain "blockchain" .

ngm:tourism-metaverse a owl:Class ;
    rdfs:label "Tourism Metaverse"@en ;
    rdfs:comment "A virtual platform enabling users to explore, preview, and experience tourist destinations, cultural sites, and travel experiences through immersive digital environments, supporting sustainable tourism and accessibility to remote or restricted locations."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:avatar-system ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:spatial-audio ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:3-d-rendering-engine ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:virtual-destination ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:geospatial-engine ],
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:enables ngm:accessibility-enhancement,
        ngm:cultural-heritage-preservation,
        ngm:destination-marketing,
        ngm:virtual-tourism ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:cultural-exhibit,
        ngm:geospatial-engine,
        ngm:tour-guide-system,
        ngm:travel-planner,
        ngm:virtual-destination ;
    vc:isPartOf ngm:metaverse-platform,
        ngm:virtual-world ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:3-d-rendering-engine,
        ngm:avatar-system,
        ngm:content-management-system,
        ngm:spatial-audio ;
    vc:slug "tourism-metaverse" ;
    vc:sourceDomain "spatial-computing" .

ngm:traditional-finance a owl:Class ;
    rdfs:label "Traditional Finance"@en ;
    rdfs:comment "Traditional finance refers to the established financial system of banks, exchanges, brokers, and regulated intermediaries that predates decentralised and blockchain-based finance."@en ;
    rdfs:subClassOf ngm:financial-infrastructure ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:slug "traditional-finance" ;
    vc:sourceDomain "finance" .

ngm:transferable-right a owl:Class ;
    rdfs:label "Transferable Right"@en ;
    rdfs:comment "A Transferable Right is a legally or technically encoded entitlement that can be assigned, sold, or delegated from one party to another, typically enforced via smart contracts on a blockchain. Examples include tokenised intellectual property licences, digital asset ownership tokens, and royalty claims encoded in NFT standards."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:digital-ownership ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:digital-rights ],
        ngm:bc-token-and-asset ;
    skos:broader ngm:bc-token-and-asset ;
    vc:enables ngm:asset-tokenisation,
        ngm:royalty-distribution ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:implements ngm:smart-contract ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:relatedTo ngm:license,
        ngm:nft ;
    vc:requires ngm:digital-ownership,
        ngm:digital-rights ;
    vc:slug "transferable-right" ;
    vc:sourceDomain "blockchain" .

ngm:transformative-ai a owl:Class ;
    rdfs:label "Transformative AI"@en ;
    rdfs:comment "Transformative AI refers to artificial intelligence advanced enough to precipitate change on the scale of the agricultural or industrial revolutions, fundamentally reshaping the economy, society, and the trajectory of civilisation. The term, used prominently in AI strategy and safety research, deliberately focuses on societal impact rather than on a specific architecture or a threshold of human-level cognition."@en ;
    rdfs:subClassOf ngm:artificial-intelligence ;
    skos:broader ngm:artificial-intelligence ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:artificial-general-intelligence ;
    vc:slug "transformative-ai" ;
    vc:sourceDomain "ai" .

ngm:transparency-oecd a owl:Class ;
    rdfs:label "Transparency (OECD)"@en ;
    rdfs:comment "AI actors should commit to transparency and responsible disclosure regarding AI systems, providing sufficient information to enable people to understand AI outcomes, challenge decisions and participate meaningfully in AI-influenced processes."@en ;
    rdfs:subClassOf ngm:ai-governance-and-ethics ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:enables ngm:contestability,
        ngm:informed-decision-making,
        ngm:trust ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:slug "transparency-oecd" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:trust-building a owl:Class ;
    rdfs:label "Trust Building"@en ;
    rdfs:comment "Trust building is the deliberate process of establishing confidence among participants in a digital system through transparency, accountability, reliable behaviour, and clear communication. In online communities and AI-mediated platforms it is fostered by practices such as content provenance, disclosure of automated generation, and enforced community standards that make actors and outputs verifiable."@en ;
    rdfs:subClassOf ngm:governance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:ai-generated-content-disclosure,
        ngm:community-standards ;
    vc:slug "trust-building" ;
    vc:sourceDomain "governance" .

ngm:trust-in-automation a owl:Class ;
    rdfs:label "Trust in Automation"@en ;
    rdfs:comment "The psychological state in which a human user accepts vulnerability to an automated system's actions based on expectations that the system will perform appropriately to achieve the user's goals, despite uncertainty and the possibility of negative consequences. It represents the user's confidence in the system's reliability, competence, and integrity, and when miscalibrated manifests as over-trust (complacency) or under-trust (disuse)."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:transparency ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:explainability ],
        ngm:human-factors,
        ngm:robo-human-robot-interaction ;
    skos:broader ngm:robo-human-robot-interaction ;
    vc:enables ngm:collaborative-robot,
        ngm:technology-adoption ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:ai-trustworthiness,
        ngm:explainable-ai,
        ngm:human-robot-interaction,
        ngm:robot,
        ngm:safety ;
    vc:requires ngm:explainability,
        ngm:transparency ;
    vc:slug "trust-in-automation" ;
    vc:sourceDomain "robotics" .

ngm:trust-in-digital-platforms a owl:Class ;
    rdfs:label "Trust in Digital Platforms"@en ;
    rdfs:comment "Trust in digital platforms is the confidence users place in online services to handle their data, transactions, and interactions safely, fairly, and reliably. It is shaped by security and privacy guarantees, transparent policies, dispute resolution, and consumer-protection measures, and is a prerequisite for sustained participation and economic activity in digital markets."@en ;
    rdfs:subClassOf ngm:governance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:consumer-protection,
        ngm:participant-protection ;
    vc:slug "trust-in-digital-platforms" ;
    vc:sourceDomain "governance" .

ngm:trust-score-metric a owl:Class ;
    rdfs:label "Trust Score Metric"@en ;
    rdfs:comment "A quantitative measurement representing an entity's trustworthiness, credibility, or risk level, expressed as a numerical value with associated confidence intervals and time validity, used to inform authorization decisions, transaction approvals, and access control policies."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:reputation-scoring-model ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:calculation-parameters ],
        ngm:sc-governance-and-safety,
        ngm:trust-infrastructure ;
    skos:broader ngm:sc-governance-and-safety ;
    vc:enables ngm:access-control-decisions,
        ngm:identity-verification,
        ngm:risk-assessment,
        ngm:transaction-approval ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:calculation-timestamp,
        ngm:confidence-interval,
        ngm:score-value,
        ngm:scoring-methodology-reference,
        ngm:validity-period ;
    vc:isPartOf ngm:trust-infrastructure ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:behavioral-data,
        ngm:calculation-parameters,
        ngm:reputation-scoring-model ;
    vc:slug "trust-score-metric" ;
