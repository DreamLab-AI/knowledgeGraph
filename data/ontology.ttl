ngm:information-asymmetry a owl:Class ;
    rdfs:label "Information Asymmetry"@en ;
    rdfs:comment "Information asymmetry is a condition in which one party to a transaction or interaction possesses more or better information than another, distorting decisions and market outcomes. It gives rise to adverse selection and moral hazard, and motivates institutions such as signalling, screening, disclosure rules, and reputation systems. It is a foundational concept in microeconomics and is increasingly relevant to AI systems whose training data and outputs can encode hidden biases."@en ;
    rdfs:subClassOf ngm:economic-mechanism ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:bias-in-large-language-models,
        ngm:economics ;
    vc:slug "information-asymmetry" ;
    vc:sourceDomain "governance" .

ngm:information-extraction a owl:Class ;
    rdfs:label "Information Extraction"@en ;
    rdfs:comment "Information Extraction (IE) is the automated process of identifying and structuring specific pieces of information from unstructured or semi-structured natural language text, producing machine-readable records such as typed entities, relational tuples, and event frames. Core subtasks include Named Entity Recognition, relation extraction, event extraction, coreference resolution, and slot filling. IE pipelines underpin knowledge graph population, question answering, and downstream analytics by converting free-form prose into structured representations consumable by databases and reasoning systems. Modern IE systems leverage pretrained transformer language models fine-tuned with supervised or few-shot learning, substantially improving generalisation across domains compared to earlier rule-based and feature-engineered approaches."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:slot-filling ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:named-entity-recognition ],
        ngm:natural-language-processing ;
    vc:bridgesTo ngm:data-integration,
        ngm:knowledge-graph,
        ngm:semantic-web ;
    vc:contrastsWith ngm:information-retrieval,
        ngm:text-classification ;
    vc:enables ngm:document-summarisation,
        ngm:knowledge-graph-construction,
        ngm:question-answering ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:coreference-resolution,
        ngm:event-extraction,
        ngm:named-entity-recognition,
        ngm:relation-extraction,
        ngm:slot-filling ;
    vc:isPartOf ngm:natural-language-processing ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:entity-linking,
        ngm:open-information-extraction,
        ngm:text-mining ;
    vc:requires ngm:dependency-parsing,
        ngm:part-of-speech-tagging,
        ngm:tokenisation ;
    vc:slug "information-extraction" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:conditional-random-field,
        ngm:sequence-labelling,
        ngm:transformer-model .

ngm:intent-recognition a owl:Class ;
    rdfs:label "Intent Recognition"@en ;
    rdfs:comment "Intent recognition is the natural-language-processing task of inferring a user's underlying goal or desired action from an utterance, query, or interaction. It maps free-form input to a discrete set of intents and extracts associated parameters, forming the comprehension layer of conversational systems. Accurate intent recognition is what lets chatbots and voice assistants route requests to the correct skill or response."@en ;
    rdfs:subClassOf ngm:natural-language-processing ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:chatbots,
        ngm:intent-classification ;
    vc:slug "intent-recognition" ;
    vc:sourceDomain "ai" .

