    vc:sourceDomain "spatial-computing" .

ngm:kinematic-model a owl:Class ;
    rdfs:label "KinematicModel"@en ;
    rdfs:comment "A mathematical description of the geometry of a robot's motion—relating joint variables to end-effector position and orientation—without considering the forces or torques that cause motion."@en ;
