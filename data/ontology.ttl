ngm:definitions-and-frameworks-for-metaverse a owl:Class ;
    rdfs:label "Definitions and frameworks for Metaverse"@en ;
    rdfs:comment "This page surveys competing definitions and analytical frameworks used to characterise the metaverse, drawing from industry reports, academic literature, and standards bodies. It compares platform-centric, social-first, and open-interoperability framings; examines primitives such as persistence, embodiment, real-time 3D graphics, and economic actors; and contextualises failed early attempts (Decentraland, Sandbox) against more enduring platforms (Roblox). The analysis informs design principles for trust, value transfer, and AI-mediated governance in spatial social systems."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:telecollaboration ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:metaverse ],
        ngm:metaverse-ontology,
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:enables ngm:digital-commerce ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:metaverse,
        ngm:telecollaboration ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:ai-governance,
        ngm:digital-twin ;
    vc:slug "definitions-and-frameworks-for-metaverse" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:augmented-reality,
        ngm:blockchain .

