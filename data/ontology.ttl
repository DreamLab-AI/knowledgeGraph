    vc:relatedTo ngm:embedded-systems ;
    vc:slug "asic-hardware" ;
    vc:sourceDomain "infrastructure" .

ngm:asset-database a owl:Class ;
    rdfs:label "Asset Database"@en ;
    rdfs:comment "An Asset Database is a structured, queryable repository that stores descriptive records, binary references, version histories, and relational metadata for digital assets within a production or distribution system. It provides the persistent backbone enabling discovery, retrieval, provenance tracking, and lifecycle management of assets across teams and pipelines."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:metadata ],
        ngm:database-system ;
