ngm:minimal-risk-ai a owl:Class ;
    rdfs:label "Minimal Risk AI"@en ;
    rdfs:comment "The residual tier in the EU AI Act's four-level risk pyramid, covering AI systems not classified as prohibited, high-risk, or limited-risk. Such systems carry no AI Act-specific compliance obligations and remain subject only to applicable horizontal legislation such as GDPR and product liability rules."@en ;
    rdfs:subClassOf ngm:ai-governance-and-ethics ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:contrastsWith ngm:high-risk-ai-system ;
    vc:dependsOn ngm:accountability,
        ngm:risk-management ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:regulatory-framework ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:ai-governance,
        ngm:responsible-ai,
        ngm:transparency ;
    vc:slug "minimal-risk-ai" ;
    vc:sourceDomain "artificial-intelligence" .

