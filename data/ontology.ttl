ngm:polygon-agg-layer a owl:Class ;
    rdfs:label "Polygon AggLayer"@en ;
    rdfs:comment "The Polygon AggLayer (Aggregation Layer) is a cross-chain settlement protocol that unifies liquidity and state across independent Polygon and zk-based chains. It uses zero-knowledge proofs to aggregate proofs from connected chains and enable near-atomic cross-chain transactions while preserving each chain's sovereignty. It aims to make a network of L1s and L2s feel like a single unified chain."@en ;
    rdfs:subClassOf ngm:cross-chain-bridge ;
