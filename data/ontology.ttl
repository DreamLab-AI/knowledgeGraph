            owl:someValuesFrom ngm:data-link-layer ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:physical-layer ],
        ngm:communication-network ;
    vc:bridgesTo ngm:decentralised-network,
        ngm:edge-computing ;
    vc:dependsOn ngm:network-infrastructure ;
    vc:enables ngm:cloud-computing,
        ngm:distributed-computing,
        ngm:internet-of-things ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:data-link-layer,
        ngm:network-layer,
        ngm:physical-layer,
        ngm:protocol-stack,
        ngm:transport-layer ;
    vc:implements ngm:osi-model ;
    vc:qualityScore "0.85"^^xsd:float ;
