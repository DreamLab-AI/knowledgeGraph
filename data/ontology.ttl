    vc:enables ngm:edge-computing,
        ngm:model-compression-for-edge ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:relatedTo ngm:transfer-learning ;
    vc:requires ngm:large-language-models,
        ngm:training-data ;
    vc:slug "knowledge-distillation" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:language-modeling a owl:Class ;
    rdfs:label "Language Modeling"@en ;
