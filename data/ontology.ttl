ngm:metaverse-core-concepts a owl:Class ;
    rdfs:label "metaverse core concepts"@en ;
    rdfs:comment "Metaverse core concepts is an index class grouping the foundational building blocks of persistent shared virtual spaces: immersive rendering technologies (Augmented Reality, Spatial Computing, Haptic Feedback), virtual environments (Virtual World, Social VR, Digital Twin), digital identity and economic primitives (Digital Avatar, Virtual Asset, Virtual Economy), and cross-platform integration enablers (Interoperability). Together these concepts define the design space for metaverse platforms and standards such as those developed by the Metaverse Standards Forum."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:digital-twin ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:spatial-computing ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:virtual-economy ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:haptic-feedback ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:virtual-world ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:interoperability ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:digital-avatar ],
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:digital-avatar,
        ngm:digital-twin,
        ngm:haptic-feedback,
        ngm:virtual-economy,
        ngm:virtual-world ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:extended-reality,
        ngm:social-vr,
        ngm:virtual-asset ;
    vc:requires ngm:interoperability,
        ngm:spatial-computing ;
    vc:slug "metaverse-core-concepts" ;
    vc:sourceDomain "spatial-computing" .

