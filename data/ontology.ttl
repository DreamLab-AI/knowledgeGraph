    vc:sourceDomain "data" .

ngm:c2-pa-standard a owl:Class ;
    rdfs:label "C2PA Standard"@en ;
    rdfs:comment "An open technical standard developed by the Coalition for Content Provenance and Authenticity that establishes cryptographically-signed Content Credentials to certify the origin, history, and authenticity of digital media, functioning like a tamper-evident nutrition label for digital content."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
