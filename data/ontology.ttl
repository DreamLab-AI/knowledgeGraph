ngm:cap-theorem a owl:Class ;
    rdfs:label "CAP Theorem"@en ;
    rdfs:comment "The CAP Theorem states that a distributed data store cannot simultaneously guarantee all three of consistency, availability and partition tolerance. When a network partition occurs and messages between nodes are lost or delayed, a system must choose between remaining available, by serving possibly stale data, and remaining consistent, by refusing requests it cannot safely satisfy. Formulated by Eric Brewer and later proved formally by Gilbert and Lynch, it frames a fundamental trade-off in distributed systems design."@en ;
    rdfs:subClassOf ngm:owl-thing ;
    vc:enables ngm:distributed-database-design ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:slug "cap-theorem" ;
    vc:sourceDomain "cap-theorem" .

