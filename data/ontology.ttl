    vc:slug "bytecode" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:solidity ;
    vc:uses ngm:compiler,
        ngm:virtual-machine .

ngm:c2-pa-content-credentials a owl:Class ;
    rdfs:label "C2PA Content Credentials"@en ;
    rdfs:comment "C2PA Content Credentials are cryptographically signed metadata manifests, defined by the Coalition for Content Provenance and Authenticity (C2PA) technical specification, that are embedded in or bound to digital media assets to record their origin, capture conditions, AI generation provenance, and editing history in a tamper-evident chain. Each Content Credential is a JUMBF-structured (JPEG Universal Metadata Box Format) assertion set signed using the COSE (CBOR Object Signing and Encryption) standard, anchored to the asset via a cryptographic hash binding that detects post-signing modifications. Verifiers — including browser extensions, social media platforms, AI disclosure tools, and editing software — can retrieve and display the full credential chain, enabling transparent and auditable provenance for photographs, video, audio, documents, and AI-generated synthetic content. The mechanism serves as the primary interoperability layer between hardware capture devices, editing software, AI generation systems, and distribution platforms participating in the broader content authenticity ecosystem."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:certificate-authority ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:hardware-security-module ],
        ngm:infra-security-and-identity ;
    skos:broader ngm:infra-security-and-identity ;
    vc:bridgesTo ngm:ai-regulation,
        ngm:generative-ai ;
    vc:contrastsWith ngm:deepfakes,
        ngm:steganography ;
    vc:enables ngm:ai-transparency-framework,
        ngm:supply-chain-traceability ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:implements ngm:c2-pa-standard,
        ngm:cryptographic-signing ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:content-authenticity,
        ngm:iptc-photo-metadata,
        ngm:metadata,
        ngm:provenance,
        ngm:w3-c-verifiable-credentials ;
    vc:requires ngm:certificate-authority,
        ngm:hardware-security-module ;
    vc:slug "c2-pa-content-credentials" ;
    vc:sourceDomain "security" ;
    vc:supports ngm:ai-generated-content-disclosure,
        ngm:disinformation-countermeasures,
        ngm:media-authenticity,
        ngm:provenance-verification,
        ngm:trust-and-safety ;
    vc:uses ngm:cryptographic-hash,
        ngm:digital-signature,
        ngm:provenance-tracking,
        ngm:public-key-infrastructure,
        ngm:x-509-certificate .

ngm:cache-layer a owl:Class ;
    rdfs:label "Cache Layer"@en ;
    rdfs:comment "A cache layer is an intermediate storage tier interposed between a data consumer and an authoritative data source, holding frequently or recently accessed data in faster storage to reduce latency, decrease load on origin systems, and improve overall system throughput. Cache layers operate at multiple levels of a computing stack—CPU caches, in-process memory caches, distributed shared caches, and edge CDN caches—each exploiting temporal or spatial locality of access patterns. Correctness requires coherence protocols or explicit invalidation strategies to prevent stale data from being served."@en ;
    rdfs:subClassOf ngm:storage-layer ;
    vc:enables ngm:performance-optimization,
        ngm:scalability ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:content-delivery-network-cdn,
        ngm:database-system,
        ngm:latency ;
    vc:slug "cache-layer" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:data-storage,
        ngm:kv-cache .

ngm:carbon-footprint-assessment a owl:Class ;
    rdfs:label "Carbon Footprint Assessment"@en ;
    rdfs:comment "A comprehensive emodology that quantifies total greenhouse gas emissions associated with a product, service, or organization across its entire lifecycle using Life Cycle Assessment principles, expressed in CO2 equivalent units to identify emission hotspots and reduction opportunities."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
