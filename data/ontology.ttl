    rdfs:label "Deadline Scheduling"@en .

ngm:decentraland a owl:Class ;
    rdfs:label "Decentraland"@en ;
    rdfs:comment "Decentraland is a blockchain-based virtual world in which users own parcels of virtual land and in-world assets as non-fungible tokens on the Ethereum network, governed by a decentralised autonomous organisation through on-chain voting with governance tokens."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:smart-contract ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ethereum ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptocurrency-wallet ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:non-fungible-token ],
        ngm:metaverse-platform ;
    vc:bridgesTo ngm:digital-twin,
        ngm:distributed-governance,
        ngm:spatial-computing ;
    vc:contrastsWith ngm:roblox,
        ngm:the-sandbox ;
    vc:enables ngm:asset-tokenization,
        ngm:play-to-earn-p2-e,
        ngm:social-vr,
        ngm:user-generated-content,
        ngm:virtual-land-rights ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:land-nft ;
    vc:implements ngm:decentralized-autonomous-organization,
        ngm:erc-721 ;
    vc:isPartOf ngm:open-metaverse,
        ngm:web3 ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:metaverse,
        ngm:virtual-reality ;
    vc:requires ngm:cryptocurrency-wallet,
        ngm:ethereum,
        ngm:non-fungible-token,
        ngm:smart-contract ;
    vc:slug "decentraland" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:ethereum-smart-contract-platform,
        ngm:ipfs .

