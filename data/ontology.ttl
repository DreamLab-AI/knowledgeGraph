    vc:uses ngm:convolutional-neural-network,
        ngm:deep-learning,
        ngm:gram-matrix,
        ngm:perceptual-loss,
        ngm:vgg-network .

ngm:surgical-robot a owl:Class ;
    rdfs:label "Surgical Robot"@en ;
    rdfs:comment "A Surgical Robot is a teleoperated or semi-autonomous robotic system designed to assist surgeons in performing minimally invasive procedures with enhanced precision, dexterity, and haptic feedback. Systems such as the da Vinci platform translate the surgeon's hand movements—filtered for tremor—into sub-millimetre instrument motions within the patient's body, enabling laparoscopic, urological, and cardiac procedures through small incisions."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:sensor-fusion ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:robot-kinematics ],
        ngm:robo-robot-type,
        ngm:service-robot ;
