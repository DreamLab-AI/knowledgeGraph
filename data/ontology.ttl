ngm:surgical-simulation a owl:Class ;
    rdfs:comment "Surgical simulation is the use of interactive virtual environments to model surgical procedures for training, planning and assessment. It combines real-time graphics, deformable tissue modelling, collision detection and haptic feedback to recreate the visual and tactile experience of operating. Surgical simulators allow clinicians to rehearse techniques and acquire skills without risk to patients."@en ;
    rdfs:label "Surgical Simulation"@en ;
    rdfs:subClassOf ngm:medical-simulation ;
