ngm:timelock-contract a owl:Class ;
    rdfs:label "Timelock Contract"@en ;
    rdfs:comment "A smart contract or transaction condition that prevents funds or actions from being executed until a specified time or block height is reached. It is used to enforce delays and to coordinate conditional payments."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:smart-contract ],
        ngm:smart-contract ;
    vc:enables ngm:hash-time-locked-contract ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:smart-contract ;
    vc:slug "timelock-contract" ;
    vc:sourceDomain "blockchain" .

ngm:timer a owl:Class ;
    rdfs:label "Timer"@en ;
    rdfs:comment "A timer is a software or hardware mechanism that measures elapsed time or schedules an action to occur after a delay or at a recurring interval. In collaborative and real-time applications it provides shared countdowns, time-boxing, and synchronised triggers that all participants observe consistently. Timers are a basic building block of event scheduling, animation, and time-bounded interaction."@en ;
    rdfs:subClassOf ngm:dc-workspace-tools ;
    skos:broader ngm:dc-workspace-tools ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:collaborative-systems-modality-whiteboard,
        ngm:real-time ;
    vc:slug "timer" ;
    vc:sourceDomain "metaverse" .

ngm:timestamping-service a owl:Class ;
    rdfs:label "Timestamping Service"@en ;
    rdfs:comment "A timestamping service is a system that issues verifiable proof that a piece of data existed at or before a particular time, often using cryptographic methods."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
