ngm:flux-1 a owl:Class ;
    rdfs:label "Flux.1"@en ;
    rdfs:comment "Flux.1 is a family of open-weight text-to-image generative models developed by Black Forest Labs, founded by former Stability AI researchers including Robin Rombach, the co-creator of Latent Diffusion. Released in August 2024, Flux.1 employs a hybrid architecture combining multimodal and parallel diffusion transformer (DiT) blocks, achieving state-of-the-art image quality and prompt adherence that surpasses earlier diffusion models on benchmarks such as GenEval and T2I-CompBench. The family offers three variants — Flux.1 [pro], Flux.1 [dev], and Flux.1 [schnell] — spanning commercial API, open-weights research, and fast inference use cases respectively."@en ;
    rdfs:subClassOf ngm:diffusion-model ;
    vc:contrastsWith ngm:stable-diffusion-image-model ;
    vc:dependsOn ngm:model-training ;
    vc:enables ngm:inpainting,
        ngm:open-source-ai ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:diffusion-models,
        ngm:image-generation,
        ngm:latent-diffusion,
        ngm:text-to-image ;
    vc:slug "flux-1" ;
    vc:sourceDomain "ai" ;
    vc:supports ngm:lo-ra-do-ra-etc,
        ngm:node-based-diffusion-pipeline-interface-workflows ;
    vc:uses ngm:deep-learning,
        ngm:neural-network-architecture .

ngm:fourier-transform a owl:Class ;
    rdfs:label "Fourier Transform"@en ;
    rdfs:comment "The Fourier Transform is a mathematical operation that decomposes a function of time or space into its constituent frequency components, expressing the function as a sum of sinusoids weighted by complex amplitudes. It establishes a bijective mapping between the time domain and the frequency domain, enabling analysis, filtering, compression, and convolution of signals. The Discrete Fourier Transform (DFT) and its fast algorithm (FFT) are the computational workhorses of digital signal processing, image analysis, and frequency-domain machine learning."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:statistical-analysis ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:numerical-methods ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:linear-algebra ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:tensor-computation ],
        ngm:signal-processing ;
    vc:bridgesTo ngm:artificial-intelligence ;
    vc:contrastsWith ngm:euclidean-distance ;
    vc:enables ngm:data-modelling,
        ngm:machine-learning ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:numerical-methods,
        ngm:statistical-analysis ;
    vc:implements ngm:signal-processing ;
