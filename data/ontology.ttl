        ngm:safety-system ;
    vc:uses ngm:camera,
        ngm:lidar,
        ngm:potential-field-method,
        ngm:radar,
        ngm:ultrasonic-sensor .

ngm:reliability-engineering a owl:Class ;
    rdfs:label "Reliability Engineering"@en ;
    rdfs:comment "Reliability engineering is the engineering discipline that applies probabilistic and statistical methods to design, analyse, and verify that systems perform their required functions for a specified period under stated operating conditions without failure. It encompasses systematic techniques including fault tree analysis, failure mode and effects analysis, and accelerated life testing to quantify failure probabilities and identify design weaknesses. The discipline establishes dependability metrics such as MTBF, MTTF, and availability, and prescribes design strategies including redundancy, derating, and fault-tolerant architectures to achieve reliability targets. It spans hardware, software, and socio-technical systems and is foundational to safety-critical engineering in aerospace, automotive, medical devices, nuclear, and large-scale cloud infrastructure."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:fmea ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-collection ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:probabilistic-risk-assessment ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:fault-tree-analysis ],
        ngm:systems-engineering ;
    vc:bridgesTo ngm:ai-safety,
        ngm:chaos-engineering,
        ngm:site-reliability-engineering ;
    vc:contrastsWith ngm:safety-engineering ;
    vc:dependsOn ngm:fault-tolerance,
        ngm:redundancy ;
    vc:enables ngm:predictive-maintenance,
        ngm:risk-assessment,
        ngm:safety-assurance ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:fault-tree-analysis,
        ngm:fmea ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:requires ngm:data-collection,
        ngm:probabilistic-risk-assessment ;
    vc:slug "reliability-engineering" ;
    vc:sourceDomain "infrastructure" ;
    vc:standardizedBy ngm:iec-61508,
        ngm:iso-26262 ;
    vc:supports ngm:functional-safety ;
    vc:uses ngm:markov-chain,
        ngm:monte-carlo-simulation .

ngm:robotic-process-automation a owl:Class ;
    rdfs:label "Robotic Process Automation"@en ;
    rdfs:comment "Robotic Process Automation (RPA) is a software technology that deploys configurable software robots to emulate human interactions with digital systems — clicking, typing, copy-pasting data, and navigating graphical user interfaces — in order to execute repetitive, rule-based business processes without modifying underlying applications. RPA robots operate at the presentation layer, integrating with legacy systems through their UI rather than through APIs, and are managed by an orchestration platform that schedules work items, monitors execution, handles exceptions, and maintains audit trails. Modern RPA platforms increasingly incorporate AI capabilities such as optical character recognition, natural language processing, and machine learning to extend automation to semi-structured and unstructured data, giving rise to the broader discipline of intelligent automation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:workflow-automation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:optical-character-recognition ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:business-process-management ],
        ngm:process-automation ;
    vc:bridgesTo ngm:large-language-models,
        ngm:machine-learning ;
    vc:contrastsWith ngm:ai-agents,
        ngm:api-integration,
        ngm:business-process-automation ;
    vc:enables ngm:digital-transformation,
        ngm:enterprise-automation,
        ngm:hyperautomation,
        ngm:intelligent-automation ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:document-processing,
        ngm:enterprise-resource-planning,
        ngm:task-automation ;
    vc:requires ngm:business-process-management,
        ngm:optical-character-recognition,
        ngm:workflow-automation ;
    vc:slug "robotic-process-automation" ;
    vc:sourceDomain "ai" ;
    vc:standardizedBy ngm:ieee-standards ;
    vc:uses ngm:computer-vision,
        ngm:natural-language-processing,
        ngm:process-mining,
        ngm:workflow-automation .

ngm:structure-from-motion a owl:Class ;
    rdfs:label "Structure-from-Motion"@en ;
    rdfs:comment "Structure-from-Motion (SfM) is a photogrammetric pipeline that simultaneously recovers three-dimensional scene geometry and camera motion parameters from an unordered collection of overlapping two-dimensional images. Sparse feature correspondences—detected via descriptors such as SIFT, ORB, or learned alternatives—seed an incremental or global pose-estimation stage that triangulates a sparse point cloud. Bundle adjustment then jointly refines all camera extrinsics, intrinsics, and 3D point coordinates by minimising reprojection error across the full image set. SfM is a foundational technique in computer vision, photogrammetry, autonomous navigation, and spatial computing, serving as the upstream stage for multi-view stereo densification and neural scene representations."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:feature-matching ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:camera-calibration ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:bundle-adjustment ],
        ngm:photogrammetry ;
    vc:bridgesTo ngm:autonomous-vehicle,
        ngm:digital-twin,
        ngm:robotics ;
    vc:contrastsWith ngm:lidar-scanning,
        ngm:slam,
        ngm:visual-odometry ;
    vc:enables ngm:3d-mapping,
        ngm:augmented-reality,
        ngm:depth-estimation,
        ngm:multi-view-stereo,
        ngm:point-cloud ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:isPartOf ngm:3-d-reconstruction,
        ngm:photogrammetry ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:3-d-scene-reconstruction,
        ngm:gaussian-splatting,
        ngm:neural-radiance-fields,
        ngm:stereo-vision ;
    vc:requires ngm:bundle-adjustment,
        ngm:camera-calibration,
        ngm:feature-matching ;
    vc:slug "structure-from-motion" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:computer-vision,
        ngm:epipolar-geometry,
        ngm:feature-detection,
        ngm:ransac .

ngm:training a owl:Class ;
    rdfs:label "Training"@en ;
    rdfs:comment "Training is the supervised or self-supervised process of iteratively adjusting the parameters of a machine learning model to minimise a loss function over a labelled or unlabelled dataset. It encompasses forward passes, backpropagation, gradient descent optimisation, and regularisation techniques such as dropout and weight decay. The output of training is a fitted model whose learned weights encode patterns from the training data, ready for inference on unseen inputs."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:validation-process ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:forward-pass ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:loss-function ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:training-data ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:compute-resources ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:labelled-dataset ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:hyperparameter-tuning ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gradient-descent ],
        ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
