ngm:octree-spatial-index a owl:Class ;
    rdfs:label "Octree Spatial Index"@en ;
    rdfs:comment "An octree spatial index is a tree data structure that recursively subdivides 3D space into eight octants, organising objects by their spatial location for efficient querying. It accelerates operations such as range queries, nearest-neighbour search, collision detection, and visibility culling by pruning regions that cannot contain relevant objects. It is a core building block for spatial partitioning in 3D engines and virtual worlds."@en ;
    rdfs:subClassOf ngm:sc-display-and-rendering ;
    skos:broader ngm:sc-display-and-rendering ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:vircadia ;
    vc:slug "octree-spatial-index" ;
    vc:sourceDomain "metaverse" .

ngm:oecd a owl:Class ;
    rdfs:label "OECD"@en ;
    rdfs:comment "The OECD (Organisation for Economic Co-operation and Development) is an intergovernmental organisation founded in 1961, headquartered in Paris, comprising 38 member states committed to market economies and democratic governance. It produces comparative economic analysis, harmonised statistics, and binding and non-binding policy instruments spanning taxation, trade, education, digital policy, and emerging technology governance. Its AI Principles (2019) were the first intergovernmental standard for trustworthy artificial intelligence, and its Crypto-Asset Reporting Framework (CARF) extends automatic exchange of financial information to digital assets. OECD outputs exert normative influence through peer review, mutual recognition agreements, and adoption by broader multilateral bodies including the G20."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-sharing ],
        ngm:governance ;
    vc:bridgesTo ngm:ai-governance,
        ngm:blockchain-regulation,
        ngm:mi-ca ;
    vc:contrastsWith ngm:international-monetary-fund,
        ngm:world-trade-organization ;
    vc:enables ngm:automatic-exchange-of-information,
        ngm:international-tax-compliance,
        ngm:policy-harmonisation,
        ngm:trustworthy-ai ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:ai-principles,
        ngm:base-erosion-and-profit-shifting,
        ngm:crypto-asset-reporting-framework,
        ngm:programme-for-international-student-assessment ;
    vc:implements ngm:common-reporting-standard,
        ngm:global-minimum-tax ;
    vc:isPartOf ngm:international-governance-institutions ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:eu-ai-act,
        ngm:fatf,
        ngm:financial-stability-board ;
    vc:requires ngm:data-sharing,
        ngm:multilateral-cooperation ;
    vc:slug "oecd" ;
    vc:sourceDomain "governance" ;
    vc:standardizedBy ngm:g20,
        ngm:oecd-council ;
    vc:supports ngm:digital-economy,
        ngm:infra-legal-and-regulatory,
        ngm:open-government ;
    vc:uses ngm:comparative-statistics,
        ngm:peer-review .

