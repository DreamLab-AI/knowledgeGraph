    vc:enables ngm:cryptoasset-policy,
        ngm:cryptocurrency-regulation,
        ngm:fintech-benchmarking ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:cambridge-bitcoin-electricity-consumption-index,
        ngm:global-alternative-finance-market-benchmarking-report,
        ngm:global-cryptoasset-benchmarking-study ;
    vc:isPartOf ngm:cambridge-judge-business-school ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:alternative-finance,
        ngm:crowdfunding,
        ngm:cryptocurrency ;
    vc:requires ngm:empirical-research-methodology,
        ngm:survey-based-data-collection ;
    vc:slug "cambridge-centre-for-alternative-finance" ;
