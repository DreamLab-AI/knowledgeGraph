ngm:test-automation a owl:Class ;
    rdfs:label "Test Automation"@en ;
    rdfs:comment "Test automation is the practice of using software tools to execute predefined tests against an application, compare actual outcomes with expected results and report defects without manual intervention. It accelerates feedback, improves repeatability and enables tests to run continuously as part of integration and delivery pipelines. Test automation spans unit, integration, regression, performance and end-to-end testing, and is central to maintaining quality in fast-moving software systems."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:software-engineering ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:continuous-integration ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:test-driven-development ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:version-control ],
        ngm:software-testing ;
    vc:dependsOn ngm:monitoring ;
    vc:enables ngm:continuous-deployment,
        ngm:quality-assurance,
        ngm:reliability ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:continuous-integration,
        ngm:test-driven-development ;
    vc:implements ngm:test-driven-development ;
    vc:isPartOf ngm:quality-assurance,
        ngm:software-testing ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:automation,
        ngm:fault-tolerance,
        ngm:git ;
    vc:requires ngm:software-engineering,
        ngm:version-control ;
    vc:slug "test-automation" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:devops,
        ngm:software-engineering ;
    vc:uses ngm:api,
        ngm:continuous-integration .

ngm:text-encoder a owl:Class ;
    rdfs:label "Text Encoder"@en ;
    rdfs:comment "A text encoder is a neural network component that maps raw text—after tokenisation—into dense, contextualised vector representations that capture semantic, syntactic, and relational information for use in downstream tasks. Transformer-based encoders such as BERT, RoBERTa, and ALBERT produce bidirectional contextual embeddings via masked language model pre-training, whilst CLIP's text tower produces contrastively aligned embeddings shared with a visual encoder. In generative image and video pipelines, the text encoder translates natural language prompts into conditioning vectors that guide the diffusion denoising process via cross-attention."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:tokeniser ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:attention-mechanism ],
        ngm:ai-model-architecture ;
    skos:broader ngm:ai-model-architecture ;
    vc:enables ngm:image-generation,
        ngm:video-generation ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:clip,
        ngm:embedding-model,
        ngm:token-embedding ;
    vc:requires ngm:attention-mechanism,
        ngm:tokeniser ;
    vc:slug "text-encoder" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:third-party-verification a owl:Class ;
    rdfs:label "Third Party Verification"@en ;
    rdfs:comment "Third party verification is the independent assessment of a claim, asset, process, or record by an entity that has no stake in the outcome, providing impartial assurance that stated facts are accurate and conform to defined standards. By separating the verifier from the parties being assessed, it increases trust, reduces conflicts of interest, and supports accountability in markets, supply chains, and reporting. It is central to audit, certification, and attestation regimes."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:audit ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:provenance ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-integrity ],
        ngm:verification ;
    vc:dependsOn ngm:trust,
        ngm:verification ;
    vc:enables ngm:quality-assurance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:verification ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:audit,
        ngm:compliance,
        ngm:trust ;
    vc:requires ngm:audit,
        ngm:data-integrity,
        ngm:provenance ;
    vc:slug "third-party-verification" ;
    vc:sourceDomain "finance" ;
    vc:supports ngm:carbon-credits,
        ngm:compliance .

ngm:thread-protocol a owl:Class ;
    rdfs:label "Thread Protocol"@en ;
    rdfs:comment "Thread is an IPv6-based, low-power wireless mesh networking protocol designed for IoT devices in home and commercial environments, using IEEE 802.15.4 as its radio layer and providing self-healing, self-configuring mesh topology with native IP routing, secure device commissioning, and no single point of failure. Thread is managed by the Thread Group and forms the network and transport foundation for the Matter smart-home application protocol."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ieee-802-15-4 ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ipv6 ],
        ngm:ieee-802-15-4 ;
    vc:bridgesTo ngm:internet-of-things,
        ngm:local-area-network ;
    vc:contrastsWith ngm:bluetooth-mesh,
        ngm:z-wave,
        ngm:zigbee ;
    vc:dependsOn ngm:dtls,
        ngm:symmetric-encryption ;
    vc:enables ngm:industrial-io-t,
        ngm:matter-protocol,
        ngm:smart-home-automation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:openthread ;
    vc:implements ngm:mesh-networking ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:building-automation,
        ngm:home-area-network,
        ngm:mesh-routing-software,
        ngm:wireless-radio ;
    vc:requires ngm:6lowpan,
        ngm:ieee-802-15-4,
        ngm:ipv6 ;
    vc:slug "thread-protocol" ;
    vc:sourceDomain "infrastructure" ;
    vc:standardizedBy ngm:thread-group ;
    vc:supports ngm:device-commissioning,
        ngm:low-power-device ;
    vc:uses ngm:co-ap,
        ngm:network-layer,
        ngm:udp .

ngm:transaction-confirmation a owl:Class ;
    rdfs:label "Transaction Confirmation"@en ;
    rdfs:comment "The process by which a blockchain transaction achieves inclusion in a mined or validated block and subsequently accumulates additional blocks on top of it, reducing the probability of reversal. The number of confirmations required for sufficient security depends on consensus mechanism and transaction value; Bitcoin typically requires 6 confirmations while Proof-of-Stake systems with deterministic finality may confirm in a single block."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:validator-node ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:consensus-mechanism ],
        ngm:bc-protocol-and-consensus,
        ngm:blockchain-entity,
        ngm:distributed-data-structure ;
    skos:broader ngm:bc-protocol-and-consensus ;
    vc:enables ngm:audit-trail,
        ngm:blockchain-compliance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:blockchain-transaction,
        ngm:deterministic-finality,
        ngm:finality,
        ngm:transaction-finality ;
    vc:requires ngm:consensus-mechanism,
        ngm:validator-node ;
    vc:slug "transaction-confirmation" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:block,
        ngm:block-time,
        ngm:timestamp .

ngm:usd a owl:Class ;
    rdfs:label "USD"@en ;
    rdfs:comment "The United States dollar, the sovereign fiat currency issued by the United States Federal Reserve, serving as the world's primary reserve currency and the dominant unit of account against which digital assets, stablecoins, commodities, and international trade flows are quoted and settled."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
