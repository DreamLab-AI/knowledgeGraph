    vc:isPartOf ngm:tokenization ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:money,
        ngm:stablecoin ;
    vc:requires ngm:token-standard ;
    vc:slug "fungibility" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:cryptocurrency,
        ngm:liquidity ;
    vc:uses ngm:token-standard .

ngm:future-of-work a owl:Class ;
    rdfs:label "Future Of Work"@en ;
    rdfs:comment "Future of Work is the study and anticipation of how technological change, especially artificial intelligence and automation, reshapes jobs, skills, organisational structures, and the broader labour economy. It examines task automation and augmentation, the emergence of new roles, shifts toward distributed and hybrid working, and the policy responses needed for equitable transitions. The field blends economics, organisational behaviour, and technology forecasting."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ai-governance ],
        [ a owl:Restriction ;
