    vc:slug "future-of-humanity-institute" ;
    vc:sourceDomain "ai" .

ngm:g-rpc a owl:Class ;
    rdfs:label "gRPC"@en ;
    rdfs:comment "gRPC (gRPC Remote Procedure Call) is an open-source, high-performance remote procedure call framework developed by Google and released in 2015, built on HTTP/2 transport and Protocol Buffers as the interface definition language and serialisation format. It supports four communication patterns—unary, server-streaming, client-streaming, and bidirectional streaming—enabling efficient, strongly typed, low-latency communication between services in polyglot distributed systems. gRPC generates client and server stubs in over a dozen programming languages from a single .proto service definition, making it the dominant choice for internal microservices communication in cloud-native architectures. Its binary encoding and multiplexed HTTP/2 connections deliver significantly lower overhead than REST/JSON at high throughput."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:tls ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:protocol-buffer ],
        ngm:communication-protocol ;
    vc:bridgesTo ngm:internet-of-things,
        ngm:mobile-computing ;
    vc:contrastsWith ngm:graphql,
        ngm:rest-api,
        ngm:websocket ;
    vc:enables ngm:distributed-system,
        ngm:polyglot-microservices,
        ngm:realtime-communication,
        ngm:service-mesh ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:bidirectional-streaming,
        ngm:proto-file,
        ngm:stub-generation ;
    vc:implements ngm:remote-procedure-call,
        ngm:service-interface-definition ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:api-gateway,
        ngm:api-standard,
        ngm:microservices-architecture,
        ngm:mutual-tls ;
    vc:requires ngm:http2,
        ngm:protocol-buffer,
        ngm:tls ;
    vc:slug "g-rpc" ;
    vc:sourceDomain "infrastructure" ;
    vc:standardizedBy ngm:cloud-native-computing-foundation ;
    vc:supports ngm:load-balancing ;
    vc:uses ngm:cloud-native-applications,
        ngm:envoy-proxy,
        ngm:kubernetes .

ngm:game-mechanics a owl:Class ;
    rdfs:label "Game Mechanics"@en ;
    rdfs:comment "The formal rules, feedback systems, and interaction patterns that govern player agency, emergent behaviour, and progression within a game, simulation, or interactive virtual environment. Game mechanics define the space of possible player actions and their consequences through structures such as reward loops, resource management, collision and physics constraints, NPC behaviour trees, and win or loss conditions. In metaverse and blockchain-enabled contexts, mechanics are increasingly encoded in smart contracts, enabling transparent, tamper-resistant enforcement and player-owned economies. The discipline draws on systems theory, behavioural psychology, and human-computer interaction to produce engaging, balanced, and culturally durable play experiences."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:resource-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:game-engine ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:collision-detection ],
        [ a owl:Restriction ;
