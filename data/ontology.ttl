    vc:slug "timestamping-service" ;
    vc:sourceDomain "security" .

ngm:tinyml a skos:Concept ;
    rdfs:label "Tinyml"@en .

ngm:token-swapping a owl:Class ;
    rdfs:label "Token Swapping"@en ;
    rdfs:comment "Token swapping is the on-chain exchange of one cryptocurrency or digital token for another without an intermediary custodian, executed atomically within a single transaction through smart contracts. The mechanism is implemented via automated market makers (AMMs), which price assets algorithmically using constant-function market-making formulas against liquidity pools, or via atomic swap protocols using hash time-locked contracts (HTLCs) that enable trustless cross-chain exchanges. Token swapping is the primary interaction primitive of decentralised exchanges and a building block for complex DeFi strategies."@en ;
    rdfs:subClassOf ngm:decentralized-finance-de-fi ;
    vc:enables ngm:de-fi,
        ngm:yield-farming ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:decentralized-exchange-dex,
        ngm:permissionless-trading,
        ngm:uniswap ;
    vc:slug "token-swapping" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:atomic-swap,
        ngm:automated-market-maker,
        ngm:liquidity-pool,
        ngm:smart-contract .

ngm:tokenised-real-world-assets a owl:Class ;
    rdfs:label "Tokenised Real World Assets"@en ;
    rdfs:comment "Tokenised real-world assets (RWAs) are blockchain tokens that represent ownership or economic rights in tangible or traditional financial assets such as property, bonds, equities, or commodities. By mapping off-chain value onto programmable tokens, they enable fractional ownership, continuous settlement, and integration with decentralised finance while still depending on legal frameworks and custodians for enforceability."@en ;
    rdfs:subClassOf ngm:digital-asset ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:decentralized-finance-de-fi,
        ngm:distributed-ledger ;
    vc:slug "tokenised-real-world-assets" ;
    vc:sourceDomain "blockchain" .

ngm:total-order-broadcast a skos:Concept ;
    rdfs:label "Total Order Broadcast"@en .

ngm:traceability-mechanism a owl:Class ;
    rdfs:label "Traceability Mechanism"@en ;
    rdfs:comment "A Traceability Mechanism is a systematic approach for recording, maintaining, and retrieving comprehensive documentation of an AI system's development process, data lineage, decision-making logic, and operational history to enable accountability, auditability, and debugging. It encompasses data provenance tracking, model versioning, decision logging, and tamper-evident audit trails that allow stakeholders to reconstruct the causal chain from system outputs back to training data and design choices. Regulatory frameworks including the EU AI Act and GDPR increasingly mandate specific traceability capabilities for high-risk AI deployments."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-governance ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:audit-trail ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:data-provenance ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:model-training ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:metadata-management ],
        ngm:ai-governance-and-ethics,
        ngm:ai-governance-principle ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:enables ngm:accountability,
        ngm:compliance-verification,
        ngm:explainability ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:audit-trail,
        ngm:data-provenance,
        ngm:metadata-management ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:ai-regulation,
        ngm:gdpr-compliance,
        ngm:transparency ;
    vc:requires ngm:data-governance,
        ngm:model-training ;
    vc:slug "traceability-mechanism" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:ai-governance,
        ngm:ai-risk-management .

ngm:tracking-technology a owl:Class ;
    rdfs:label "Tracking Technology"@en ;
    rdfs:comment "Tracking Technology refers to the hardware and software systems that determine the real-time position, orientation, and motion of a user or device in physical space for extended reality applications. Approaches include inside-out tracking using onboard cameras and SLAM, outside-in tracking using fixed base stations, eye tracking for gaze-based interaction, and hand/finger tracking for controller-free input."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:slam ],
