ngm:full-node a owl:Class ;
    rdfs:label "Full Node"@en ;
    rdfs:comment "A blockchain node that independently downloads, validates, and stores the complete transaction history of the chain from the genesis block, enforcing all consensus rules without trusting external parties. Full nodes are the gold standard for trustless participation and are the backbone of decentralisation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
