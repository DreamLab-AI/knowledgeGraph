ngm:digital-experience a owl:Class ;
    rdfs:label "Digital Experience"@en ;
    rdfs:comment "Digital Experience encompasses the totality of interactions a user has with digital products, services, and environments — spanning web, mobile, and immersive (XR) surfaces. It integrates user interface design, content delivery, personalisation, and spatial computing to shape how users perceive and engage with digital platforms."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:user-interface ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:user-experience ],
        ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:enables ngm:immersive-experience,
        ngm:virtual-world ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:relatedTo ngm:digital-content ;
    vc:requires ngm:user-experience,
        ngm:user-interface ;
    vc:slug "digital-experience" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:content-delivery-network .

