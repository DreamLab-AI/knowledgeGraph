    vc:slug "digital-payment-system" ;
    vc:sourceDomain "spatial-computing" .

ngm:digital-society-surveillance a owl:Class ;
    rdfs:label "Digital Society Surveillance"@en ;
    rdfs:comment "Digital Society Surveillance is the systematic observation, collection, processing, and analysis of personal data, communications, movements, and behavioural signals generated by individuals participating in digital infrastructure — encompassing state mass-surveillance programmes, commercial surv..."@en ;
