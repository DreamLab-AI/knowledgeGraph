    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:ai-security ;
    vc:requires ngm:cryptographic-security,
        ngm:cybersecurity ;
    vc:slug "digital-security" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:data-security,
