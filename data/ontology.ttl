    rdfs:label "Digital Asset"@en ;
    rdfs:comment "DigitalAsset is a concept within the ngm domain."@en ;
    rdfs:subClassOf vf:blockchain ;
    vc:authorityScore "0.0"^^xsd:float ;
    vc:maturity "draft" ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:slug "digital-asset" ;
