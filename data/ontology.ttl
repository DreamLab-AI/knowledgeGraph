        ngm:slam ;
    vc:slug "rb-0069-lidar" ;
    vc:sourceDomain "robotics" .

ngm:rb-0092-protective-stop a owl:Class ;
    rdfs:label "rb 0092 protective stop"@en ;
    rdfs:comment "A protective stop is a safety-initiated cessation of robot motion that halts all hazardous movement when a safety function is triggered, without necessarily cutting power to the drive system. Unlike an emergency stop, a protective stop permits automatic restart once the triggering condition is resolved, making it a standard mechanism in collaborative robot cells operating under ISO 10218 and ISO/TS 15066. It is fundamental to speed-and-separation monitoring and power-and-force-limiting safety strategies."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:risk-assessment ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:functional-safety ],
        ngm:robo-safety-and-standards,
        ngm:robot-safety ;
    skos:broader ngm:robo-safety-and-standards ;
    vc:enables ngm:collaborative-operation,
        ngm:human-robot-interaction ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:collaborative-robot,
        ngm:robot-safety ;
    vc:requires ngm:functional-safety,
        ngm:risk-assessment ;
    vc:slug "rb-0092-protective-stop" ;
    vc:sourceDomain "robotics" ;
    vc:standardizedBy ngm:iso-10218,
        ngm:iso-ts-15066 .

ngm:rb-0095-safety-zone a owl:Class ;
    rdfs:label "rb 0095 safety zone"@en ;
    rdfs:comment "A safety zone is a defined spatial region around a robot or autonomous system within which human presence or other objects trigger protective actions such as speed reduction, monitored stops, or full emergency stops. Safety zones are configured and monitored via safeguarding devices and are a central mechanism for achieving collaborative and safe robot operation in accordance with ISO 10218 and ISO/TS 15066."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:rb-0087-safety-standard ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:rb-0089-risk-assessment ],
        ngm:robo-safety-and-standards,
        ngm:robot-safety ;
    skos:broader ngm:robo-safety-and-standards ;
    vc:dependsOn ngm:functional-safety,
        ngm:rb-0075-range-finder ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:rb-0091-safety-rated-monitored-stop,
        ngm:rb-0092-protective-stop,
        ngm:rb-0093-speed-limitation,
        ngm:rb-0096-safeguarding ;
    vc:requires ngm:rb-0087-safety-standard,
        ngm:rb-0089-risk-assessment ;
    vc:slug "rb-0095-safety-zone" ;
    vc:sourceDomain "robotics" .

ngm:real-time-transcription a owl:Class ;
    rdfs:label "Real-time Transcription"@en ;
    rdfs:comment "Real-time transcription is the automated conversion of streaming audio to text with latency sufficiently low (typically below 500 ms word latency) to support synchronous human use cases such as live captioning, voice-controlled interfaces, meeting assistance, and broadcast subtitling. It requires streaming automatic speech recognition (ASR) architectures that produce partial and final hypotheses incrementally as audio frames arrive, rather than processing complete utterances offline. Modern systems combine acoustic models (typically based on conformer or whisper-encoder architectures), language models for hypothesis rescoring, and punctuation/formatting post-processors to produce readable output in real time."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:automatic-speech-recognition ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:real-time-processing ],
        ngm:ai-application ;
    skos:broader ngm:ai-application ;
    vc:enables ngm:accessibility,
        ngm:voice-interaction ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:natural-language-processing,
        ngm:speech-recognition ;
    vc:requires ngm:automatic-speech-recognition,
        ngm:real-time-processing ;
    vc:slug "real-time-transcription" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:regulatory-technology a owl:Class ;
    rdfs:label "Regulatory Technology"@en ;
    rdfs:comment "Regulatory Technology (RegTech) applies digital tools—including AI, machine learning, and distributed ledger systems—to automate and streamline regulatory compliance processes such as KYC/AML checks, audit trail generation, risk reporting, and consent management. In spatial-computing and metaverse contexts, RegTech addresses jurisdiction-sensitive data flows, real-time content moderation, and smart-contract-based enforcement of platform governance rules."@en ;
    rdfs:subClassOf ngm:sc-governance-and-safety ;
    skos:broader ngm:sc-governance-and-safety ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:relatedTo ngm:governance-framework ;
    vc:slug "regulatory-technology" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:compliance-framework,
        ngm:data-protection-regulation ;
    vc:uses ngm:machine-learning,
        ngm:smart-contracts .

ngm:relayer a owl:Class ;
    rdfs:label "Relayer"@en ;
    rdfs:comment "Infrastructure operator that facilitates cross-chain message passing by monitoring source chains for events, generating cryptographic proofs of state, and submitting verified transactions to destination chains."@en ;
    rdfs:subClassOf ngm:bc-network-component,
        ngm:blockchain-interoperability ;
    skos:broader ngm:bc-network-component ;
    vc:enables ngm:cross-chain-bridge ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:implements ngm:message-passing ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:slug "relayer" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:light-client .

ngm:resource-management a owl:Class ;
    rdfs:label "Resource Management"@en ;
    rdfs:comment "The systematic allocation, scheduling, and monitoring of computational resources — CPU, GPU, memory, storage, and network bandwidth — across applications and services within an infrastructure, ensuring efficient utilisation, quality-of-service guarantees, and graceful degradation under load. Encompasses asset lifecycle management, resource pooling, and dynamic scaling strategies."@en ;
    rdfs:subClassOf ngm:infra-computing-and-cloud ;
    skos:broader ngm:infra-computing-and-cloud ;
    vc:enables ngm:metaverse-infrastructure ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:relatedTo ngm:content-delivery-network ;
    vc:slug "resource-management" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:computing-infrastructure,
        ngm:distributed-system ;
    vc:uses ngm:edge-computing .

ngm:sanctions-screening a owl:Class ;
    rdfs:label "Sanctions Screening"@en ;
    rdfs:comment "Sanctions Screening is the regulatory compliance process by which financial institutions, fintech operators, and other regulated entities check customers, counterparties, and transactions against government-issued sanctions lists—such as those maintained by OFAC, the UN Security Council, HM Treasury, and the EU—to prevent prohibited dealings with designated individuals, entities, and jurisdictions. The process involves name-matching algorithms, fuzzy logic to handle transliterations and aliases, and risk-based escalation procedures for potential matches. In blockchain and digital asset contexts, screening extends to wallet addresses and on-chain transaction flows. Failure to screen adequately exposes institutions to severe civil and criminal penalties."@en ;
    rdfs:subClassOf ngm:regulatory-compliance ;
    vc:enables ngm:compliance-monitoring,
        ngm:sanctions-enforcement ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:aml-kyc-compliance,
        ngm:anti-money-laundering,
        ngm:fatf,
        ngm:financial-regulation ;
    vc:slug "sanctions-screening" ;
    vc:sourceDomain "finance" ;
    vc:uses ngm:audit-trail,
        ngm:blockchain-compliance,
        ngm:fraud-detection .

ngm:scope-3-emissions a owl:Class ;
    rdfs:label "Scope 3 Emissions"@en ;
    rdfs:comment "Scope 3 emissions are the indirect greenhouse gas (GHG) emissions that occur across an organisation's value chain as a consequence of its activities but outside its operational boundary, encompassing both upstream sources such as purchased goods and services, capital goods, and business travel, and downstream sources such as the use and end-of-life treatment of sold products. Defined under Category 3 of the GHG Protocol Corporate Standard, Scope 3 emissions typically constitute the largest share of a company's total carbon footprint — often exceeding 70 percent — making their measurement, reporting, and reduction critical to credible corporate climate strategies. Accurate Scope 3 accounting requires collaboration across supply chains and the use of spend-based, activity-based, or supplier-specific emission factors."@en ;
    rdfs:subClassOf ngm:carbon-accounting ;
    vc:enables ngm:esg-reporting,
        ngm:sustainability-reporting ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:ghg-protocol,
        ngm:scope-1-emissions,
        ngm:scope-2-emissions,
        ngm:supply-chain ;
    vc:slug "scope-3-emissions" ;
    vc:sourceDomain "science" ;
    vc:uses ngm:emission-factors,
        ngm:environmental-accounting .

ngm:secp256k1 a owl:Class ;
    rdfs:label "secp256k1"@en ;
    rdfs:comment "secp256k1 is a Koblitz elliptic curve defined by the equation y² = x³ + 7 over the 256-bit prime field Fp (where p = 2²⁵⁶ − 2³² − 977), standardised in SEC 2 by the Standards for Efficient Cryptography Group (SECG). It is the cryptographic foundation of Bitcoin and Ethereum, where it underpins the Elliptic Curve Digital Signature Algorithm (ECDSA) used to authenticate transactions and derive public keys from private keys. secp256k1's specific choice of parameters enables unusually efficient computation via the Frobenius endomorphism, making scalar multiplication faster than on comparably secure non-Koblitz curves such as NIST P-256."@en ;
    rdfs:subClassOf ngm:bc-cryptographic-primitive ;
    skos:broader ngm:bc-cryptographic-primitive ;
    vc:enables ngm:cryptographic-keys,
        ngm:digital-signature ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:public-key-cryptography ;
    vc:slug "secp256k1" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:ecdsa,
        ngm:elliptic-curve-cryptography .

ngm:selfish-mining a owl:Class ;
    rdfs:label "Selfish Mining"@en ;
    rdfs:comment "A strategic block-withholding attack in proof-of-work blockchains where a mining pool privately mines a secret chain and selectively publishes blocks to waste the computational work of honest miners, thereby earning a disproportionate share of block rewards relative to its hash-rate contribution. Selfish mining is profitable when the attacker controls more than ~33% of network hash-rate."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:block ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:blockchain-network ],
        ngm:bc-protocol-and-consensus,
        ngm:blockchain-entity,
        ngm:network-component ;
    skos:broader ngm:bc-protocol-and-consensus ;
    vc:contrastsWith ngm:consensus-mechanism,
        ngm:decentralization ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:51-attack,
        ngm:bitcoin-mining,
        ngm:double-spending,
        ngm:longest-chain-rule,
        ngm:mining-pool ;
    vc:requires ngm:block,
        ngm:blockchain-network ;
    vc:slug "selfish-mining" ;
    vc:sourceDomain "blockchain" .

ngm:server-sent-events a owl:Class ;
    rdfs:label "Server-Sent Events"@en ;
    rdfs:comment "Server-Sent Events (SSE) is a W3C-standardised unidirectional server-to-client streaming protocol layered on HTTP/1.1 and HTTP/2, enabling servers to push a continuous stream of text-based events to browser or API clients without the bidirectional overhead of WebSockets. Each event is delimited by the text/event-stream MIME type and carries optional id, event, data, and retry fields, supporting automatic reconnection. SSE is widely adopted in AI inference APIs—including the Anthropic and OpenAI streaming endpoints—and in the Model Context Protocol (MCP) transport layer for streaming tool responses."@en ;
    rdfs:subClassOf ngm:ai-infrastructure ;
    vc:enables ngm:model-control-protocols-like-mcp,
        ngm:real-time-processing ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:api-gateway,
        ngm:event-driven-architecture ;
    vc:slug "server-sent-events" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:communication-protocol .

ngm:signal-conditioning a owl:Class ;
    rdfs:label "Signal Conditioning"@en ;
    rdfs:comment "Signal conditioning is the processing of raw electrical outputs from sensors — through amplification, filtering, analogue-to-digital conversion, isolation, and calibration — to produce clean, scaled, and calibrated digital representations suitable for downstream control, estimation, and machine-learning algorithms. It sits at the boundary between the physical world and digital processing pipelines, and its quality directly determines the accuracy of perception systems built on top of it. In robotic systems, signal conditioning circuits and firmware handle inputs from IMUs, force-torque sensors, encoders, pressure sensors, and cameras before data is consumed by SLAM, Kalman filters, or neural networks."@en ;
    rdfs:subClassOf ngm:robo-perception ;
    skos:broader ngm:robo-perception ;
    vc:enables ngm:kalman-filter,
        ngm:sensor-fusion ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:accelerometer,
        ngm:signal-processing ;
    vc:slug "signal-conditioning" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:digital-signal-processing,
        ngm:imu .

ngm:skeletal-animation a owl:Class ;
    rdfs:label "Skeletal Animation"@en ;
    rdfs:comment "Skeletal animation is a character animation technique in which a hierarchical rig of bones (joints) defines the articulated structure of a character or creature, and mesh vertices are deformed by the weighted influence of surrounding bones through a process known as skinning. Artists author motion by keyframing or procedurally driving bone transforms over time; the underlying mesh deforms accordingly in real time on the GPU. Skeletal animation is the dominant method for animating characters in games, virtual reality, film visual effects, and virtual avatar systems due to its runtime efficiency, data compactness, and amenability to motion capture retargeting."@en ;
    rdfs:subClassOf ngm:character-animation ;
    vc:enables ngm:avatar-animation,
        ngm:pose-estimation,
        ngm:real-time-character-animation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:animation-controller,
        ngm:gl-tf-3-d-file-format,
        ngm:physics-based-animation,
        ngm:procedural-animation ;
    vc:slug "skeletal-animation" ;
    vc:sourceDomain "graphics" ;
    vc:uses ngm:animation-retargeting,
        ngm:character-rigging,
        ngm:inverse-kinematics,
        ngm:motion-capture .

ngm:smart-grid a owl:Class ;
    rdfs:label "Smart Grid"@en ;
    rdfs:comment "A smart grid is a modernised electricity distribution network that integrates digital communication, real-time sensing, and automated control to improve efficiency, reliability, and sustainability relative to the traditional centralised grid. It enables bidirectional power and information flows, accommodating distributed generation from renewable sources, battery storage, and vehicle-to-grid interactions. Smart grids use advanced metering infrastructure, demand-response programmes, and grid-edge intelligence to balance supply and demand dynamically. They are a foundational component of low-carbon energy infrastructure and increasingly incorporate AI-driven forecasting and optimisation."@en ;
    rdfs:subClassOf ngm:cyber-physical-systems ;
    vc:enables ngm:energy-and-power,
        ngm:renewable-energy-certificates ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:anomaly-detection,
        ngm:industrial-io-t,
        ngm:power-management ;
    vc:slug "smart-grid" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:ai-energy-scarcity ;
    vc:uses ngm:demand-response,
        ngm:io-t-sensor-network,
        ngm:real-time-monitoring .

ngm:social-robotics a owl:Class ;
    rdfs:label "Social Robotics"@en ;
    rdfs:comment "A field of robotics focused on designing robots capable of interacting and communicating with humans and other autonomous agents in a socially acceptable manner, following social rules, norms, and expectations of human interaction."@en ;
    rdfs:subClassOf ngm:human-robot-interaction,
        ngm:robo-human-robot-interaction ;
    skos:broader ngm:robo-human-robot-interaction ;
    vc:enables ngm:assistive-robotics,
        ngm:human-robot-collaboration ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires ngm:communication-capabilities,
        ngm:social-intelligence ;
    vc:slug "social-robotics" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:affective-computing,
        ngm:computer-vision,
        ngm:natural-language-processing .

ngm:spatial-anchor a owl:Class ;
    rdfs:label "Spatial Anchor"@en ;
    rdfs:comment "Coordinate reference that binds a virtual object's pose to a stable location in physical space, enabling persistent AR placement and physical-virtual registration."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:tracking-system ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:coordinate-system ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:coordinate-transformation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
