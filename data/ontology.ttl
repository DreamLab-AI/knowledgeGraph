ngm:web-3-domain a owl:Class ;
    rdfs:label "Web3 Domain"@en ;
    rdfs:comment "The Web3 Domain classifies concepts for an internet architecture in which applications interact directly with public ledgers and user-controlled keys rather than centralised platforms. It covers decentralised applications, wallets, naming, and storage that together let users own assets and identity. As a subject classification under the Blockchain Domain, it scopes the application and interaction model rather than the consensus layer or the finance built upon it."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:decentralised-storage ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:public-key-cryptography ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:smart-contract ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:decentralised-application ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:digital-asset-domain ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:crypto-wallet ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:decentralised-autonomous-organisation ],
        ngm:blockchain-domain ;
    vc:enables ngm:permissionless-applications,
        ngm:self-custody,
        ngm:user-owned-data ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:crypto-wallet,
        ngm:decentralised-application,
        ngm:decentralised-autonomous-organisation,
        ngm:decentralised-storage,
        ngm:naming-service ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:digital-asset-domain,
        ngm:public-key-cryptography,
        ngm:smart-contract ;
    vc:slug "web-3-domain" ;
    vc:sourceDomain "web" .

