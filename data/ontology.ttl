ngm:kalman-filter a owl:Class ;
    rdfs:label "Kalman Filter"@en ;
    rdfs:comment "An optimal recursive Bayesian filter that estimates the state of a linear dynamic system from a series of noisy measurements. It minimizes the mean squared error of the estimated state by combining a model-based prediction step with a measurement update step, weighting each by their respective uncertainty covariances to yield the minimum-variance unbiased estimate."@en ;
    rdfs:subClassOf ngm:state-estimation ;
    vc:bridgesTo ngm:gps-positioning,
        ngm:inertial-navigation-system ;
    vc:contrastsWith ngm:extended-kalman-filter,
        ngm:rb-1014-monte-carlo-localization,
        ngm:unscented-kalman-filter ;
    vc:dependsOn ngm:linear-algebra,
        ngm:probability-theory ;
    vc:enables ngm:navigation,
        ngm:sensor-fusion,
        ngm:slam,
        ngm:target-tracking ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:kalman-gain,
        ngm:measurement-update-step,
        ngm:prediction-step ;
    vc:implements ngm:bayes-filter,
        ngm:recursive-estimator ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:control-theory,
        ngm:rb-1002-closed-loop-control,
        ngm:rb-1013-localization,
        ngm:signal-processing ;
    vc:requires ngm:covariance-matrix,
        ngm:gaussian-noise-assumption,
        ngm:linear-system-model,
        ngm:state-transition-model ;
    vc:slug "kalman-filter" ;
    vc:sourceDomain "machine-learning" ;
    vc:uses ngm:mean-squared-error,
        ngm:rb-1008-odometry .

ngm:knowledge-graph-publication-classifier-key-cryptography a owl:Class ;
    rdfs:label "Public-Key Cryptography"@en ;
    rdfs:comment "An asymmetric cryptographic system using mathematically related key pairs — a public key for encryption or signature verification and a private key for decryption or signing — enabling secure communication, digital signatures, and authentication without requiring shared secrets. In blockchain systems it underpins wallet addresses, transaction signing, and identity verification."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
