    skos:broader ngm:infra-data-management ;
    vc:bridgesTo ngm:computer-vision,
        ngm:federated-learning,
        ngm:spatial-computing ;
    vc:dependsOn ngm:cloud-computing,
        ngm:data-processing ;
    vc:enables ngm:business-intelligence,
        ngm:decision-support-system,
        ngm:real-time-analytics ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:descriptive-analytics,
        ngm:diagnostic-analytics,
        ngm:predictive-analytics,
        ngm:prescriptive-analytics ;
