    vc:slug "asset-format-standards" ;
    vc:sourceDomain "spatial-computing" .

ngm:atomic-settlement a owl:Class ;
    rdfs:label "Atomic Settlement"@en ;
    rdfs:comment "Atomic settlement is a transaction completion mechanism in which the transfer of assets between two or more parties either executes in its entirety or not at all, eliminating counterparty risk and the possibility of partial fulfilment. The mechanism is enforced at the protocol level, ensuring that delivery and payment occur simultaneously and indivisibly within a single transaction or smart contract execution. This property derives from atomicity — one of the four ACID properties of database transactions — applied to financial and digital asset exchanges. Atomic settlement is the foundational guarantee underpinning trustless exchange protocols, cross-chain bridges, and real-time gross settlement systems."@en ;
    rdfs:subClassOf ngm:transaction ;
    vc:enables ngm:decentralized-exchange,
        ngm:instant-value-settlement,
        ngm:securities-settlement ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:atomic-swap,
        ngm:finality,
        ngm:transaction-finality,
        ngm:trustless-settlement ;
    vc:slug "atomic-settlement" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:hash-time-locked-contract,
        ngm:smart-contract .

ngm:authorisation a owl:Class ;
    rdfs:label "Authorisation"@en ;
    rdfs:comment "Authorisation is the process of determining and enforcing whether an authenticated principal—user, service, or device—has the right to perform a requested action on a protected resource. It operates downstream of authentication, translating verified identity claims into permitted operations according to configured policies. Modern authorisation frameworks encompass role-based, attribute-based, and policy-based access control models. Robust authorisation design underpins compliance, auditability, and the principle of least privilege across digital systems."@en ;
    rdfs:subClassOf ngm:security ;
    vc:enables ngm:audit-trail,
        ngm:compliance-monitoring,
        ngm:privacy-controls ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:access-control,
        ngm:authentication,
        ngm:identity-management ;
    vc:slug "authorisation" ;
    vc:sourceDomain "security" ;
    vc:uses ngm:access-control-system,
        ngm:compliance-framework .

ngm:automated-compliance a owl:Class ;
    rdfs:label "Automated Compliance"@en ;
    rdfs:comment "Automated Compliance refers to the use of software systems and rule engines to continuously monitor, evaluate, and enforce regulatory requirements without manual intervention. It encompasses real-time policy checking, evidence collection, and exception reporting across business processes and IT systems. By embedding compliance logic directly into workflows, organisations can dramatically reduce audit burden and human error. The discipline draws on regulatory technology, policy engines, and audit trails to provide defensible evidence of conformance. It is particularly vital in heavily regulated sectors such as financial services, healthcare, and data protection."@en ;
    rdfs:subClassOf ngm:compliance-framework ;
    vc:enables ngm:compliance-audit-trail,
        ngm:compliance-monitoring,
        ngm:compliance-verification ;
    vc:hasMaturity ngmi:maturity-established ;
