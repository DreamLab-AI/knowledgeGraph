ngm:hybrid-robot a owl:Class ;
    rdfs:label "Hybrid Robot"@en ;
    rdfs:comment "A robotic system that combines two or more distinct locomotion or manipulation modalities—such as wheeled and legged movement, or fixed-base and mobile operation—to extend operational range and adaptability across heterogeneous environments. Hybrid robots exploit the efficiency of specialised subsystems whilst maintaining versatility that no single modality can achieve alone."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:robot-actuator ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:robot-sensor ],
        ngm:robo-robot-type ;
    skos:broader ngm:robo-robot-type ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:robot-actuator,
        ngm:robot-sensor ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:autonomous-robot,
        ngm:collaborative-systems-modality-robot,
        ngm:robotic-system ;
    vc:slug "hybrid-robot" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:feedback-control,
        ngm:sensor-fusion .

