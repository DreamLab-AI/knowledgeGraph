    dcterms:modified "2026-04-26T13:00:00Z"^^xsd:dateTime ;
    vcw:owlRole "Concept" .

# Governance Token
blockchain:GovernanceToken rdf:type owl:Class ;
    rdfs:label "Governance Token"@en ;
    rdfs:comment "Cryptographic asset conferring voting rights and protocol decision-making authority to holders, enabling decentralised governance through blockchain-based tokens rather than traditional shareholder structures. Governance tokens implement ERC20Votes or similar mechanisms supporting delegation, historical balance snapshots, and preventing flash-loan manipulation, creating programmable governance with transparent, auditable voting processes. Tokens may accrue value through fee-sharing, buyback-and-burn mechanisms, staking yields, or governance premium on DecentralisedAutonomousOrganisation."@en ;
    skos:prefLabel "Governance Token"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:blockchain:governance-token" ;
    owl:sameAs <urn:visionclaw:concept:blockchain:governance-token> ;
    vcw:contentHash "sha256-12-b39010e600fc" ;
    vcw:qualityScore "0.4"^^xsd:decimal ;
    vcw:legacyTermId "BC-0463" ;
    vcw:ontologyStatus "stub-needs-content" ;
    vcw:maturityLevel "draft" ;
    vcw:authorityScore "0.0"^^xsd:decimal ;
    dcterms:identifier "BC-0463" ;
    dcterms:subject "blockchain" ;
    owl:versionInfo "2.0.0" ;
    dcterms:created "2026-04-26T00:00:00Z"^^xsd:dateTime ;
    dcterms:modified "2026-04-26T13:00:00Z"^^xsd:dateTime ;
    vcw:owlRole "Concept" .

blockchain:GovernanceToken rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty infrastructure:implements ;
    owl:someValuesFrom blockchain:SmartContract
] .

blockchain:GovernanceToken rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty infrastructure:enablesGovernance ;
    owl:someValuesFrom blockchain:DecentralisedAutonomousOrganisation
] .

# Treasury Management
blockchain:TreasuryManagement rdf:type owl:Class ;
    rdfs:label "Treasury Management"@en ;
    rdfs:comment "Treasury management in DAO involves governance-directed allocation of organisational funds (drawn from TokenRevenue, community contributions, and reserves) to fund development, marketing, and operational activities whilst maintaining financial stability and long-term sustainability. DAO employ DAO, SmartContract, and TransparencyRequirements to ensure accountability, with Snapshot enabling community input on significant expenditures before funds transfer. Effective treasury management requires balancing aggressive growth investments against conservative reserve accumulation, often employing Investment, StakingRewards, and TreasuryOptimization to maximise long-term protocol value creation."@en ;
    skos:prefLabel "Treasury Management"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:blockchain:treasury-management" ;
    owl:sameAs <urn:visionclaw:concept:blockchain:treasury-management> ;
    vcw:contentHash "sha256-12-bdbc7138074c" ;
    vcw:qualityScore "0.4"^^xsd:decimal ;
    vcw:legacyTermId "BC-0464" ;
    vcw:ontologyStatus "stub-needs-content" ;
    vcw:maturityLevel "draft" ;
    vcw:authorityScore "0.0"^^xsd:decimal ;
    dcterms:identifier "BC-0464" ;
    dcterms:subject "blockchain" ;
    owl:versionInfo "2.0.0" ;
    dcterms:created "2026-04-26T00:00:00Z"^^xsd:dateTime ;
    dcterms:modified "2026-04-26T13:00:00Z"^^xsd:dateTime ;
    vcw:owlRole "Concept" .

# Proposal System
blockchain:ProposalSystem rdf:type owl:Class ;
    rdfs:label "Proposal System"@en ;
    rdfs:comment "Multi-stage governance workflows enabling DAO community members to initiate, discuss, deliberate, vote upon, and execute protocol changes through structured processes combining off-chain deliberation (forums, governance calls), Snapshot signalling, and binding OnChainVoting via SmartContract. Proposal systems implement thresholds—GovernanceToken requirements for initiation, quorum thresholds for binding, timelocks before execution—creating barriers preventing spam whilst enabling broad participation. Systems balance bottom-up permissionless initiation with governance efficiency, facing challenges around proposal spam, voter fatigue (5-15% typical participation), and professionalization concentrating power amongst technical elites."@en ;
    skos:prefLabel "Proposal System"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:blockchain:proposal-system" ;
    owl:sameAs <urn:visionclaw:concept:blockchain:proposal-system> ;
    vcw:contentHash "sha256-12-1f8b89eb3503" ;
    vcw:qualityScore "0.4"^^xsd:decimal ;
    vcw:legacyTermId "BC-0465" ;
    vcw:ontologyStatus "stub-needs-content" ;
    vcw:maturityLevel "draft" ;
    vcw:authorityScore "0.0"^^xsd:decimal ;
    dcterms:identifier "BC-0465" ;
    dcterms:subject "blockchain" ;
    owl:versionInfo "2.0.0" ;
    dcterms:created "2026-04-26T00:00:00Z"^^xsd:dateTime ;
    dcterms:modified "2026-04-26T13:00:00Z"^^xsd:dateTime ;
    vcw:owlRole "Concept" .

blockchain:ProposalSystem rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty infrastructure:requires ;
    owl:someValuesFrom blockchain:Snapshot
] .

blockchain:ProposalSystem rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty infrastructure:enables ;
    owl:someValuesFrom blockchain:OnChainVoting
] .

# Quadratic Voting
blockchain:QuadraticVoting rdf:type owl:Class ;
    rdfs:label "Quadratic Voting"@en ;
    rdfs:comment "Voting mechanism where the cost of votes increases quadratically—casting n votes requires n² voice credits—measuring preference intensity whilst preventing wealthy actors from dominating outcomes. Quadratic voting addresses plutocracy in token-weighted systems and indifference in one-person-one-vote by making large vote counts prohibitively expensive, encouraging honest preference revelation and broad-based support over concentrated wealth. Gitcoin deployed quadratic funding (dual mechanism) distributing £50M+ to public goods since 2019, facing persistent Sybil resistance challenges requiring identity verification and zero-knowledge proof innovations."@en ;
    skos:prefLabel "Quadratic Voting"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:blockchain:quadratic-voting" ;
    owl:sameAs <urn:visionclaw:concept:blockchain:quadratic-voting> ;
    vcw:contentHash "sha256-12-10505807cf3c" ;
    vcw:qualityScore "0.4"^^xsd:decimal ;
    vcw:legacyTermId "BC-0466" ;
    vcw:ontologyStatus "stub-needs-content" ;
    vcw:maturityLevel "draft" ;
    vcw:authorityScore "0.0"^^xsd:decimal ;
    dcterms:identifier "BC-0466" ;
    dcterms:subject "blockchain" ;
    owl:versionInfo "2.0.0" ;
    dcterms:created "2026-04-26T00:00:00Z"^^xsd:dateTime ;
    dcterms:modified "2026-04-26T13:00:00Z"^^xsd:dateTime ;
    vcw:owlRole "Concept" .

blockchain:QuadraticVoting rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty infrastructure:requires ;
    owl:someValuesFrom blockchain:SybilResistance
] .

blockchain:QuadraticVoting rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty infrastructure:usedIn ;
    owl:someValuesFrom blockchain:GitcoinGrants
] .

# Conviction Voting
blockchain:ConvictionVoting rdf:type owl:Class ;
    rdfs:label "Conviction Voting"@en ;
    rdfs:comment "Governance mechanism allowing participants to vote with variable weight on decisions based on their conviction level, allocating voting power across multiple proposals to signal preference strength. This Voting System in DAO Governance enables nuanced preference expression beyond simple majority rule."@en ;
    skos:prefLabel "Conviction Voting"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:blockchain:conviction-voting" ;
    owl:sameAs <urn:visionclaw:concept:blockchain:conviction-voting> ;
    vcw:contentHash "sha256-12-5e05b9397b85" ;
    vcw:qualityScore "0.4"^^xsd:decimal ;
    vcw:legacyTermId "BC-0467" ;
    vcw:ontologyStatus "stub-needs-content" ;
    vcw:maturityLevel "draft" ;
    vcw:authorityScore "0.0"^^xsd:decimal ;
    dcterms:identifier "BC-0467" ;
    dcterms:subject "blockchain" ;
    owl:versionInfo "2.0.0" ;
    dcterms:created "2026-04-26T00:00:00Z"^^xsd:dateTime ;
    dcterms:modified "2026-04-26T13:00:00Z"^^xsd:dateTime ;
    vcw:owlRole "Concept" .

blockchain:ConvictionVoting vcw:bridgesTo blockchain:AIAgentSystem .

# Multi Sig Governance
blockchain:MultiSigGovernance rdf:type owl:Class ;
    rdfs:label "Multi Sig Governance"@en ;
    rdfs:comment "Threshold signature scheme requiring m-of-n signatures from designated keyholders before transactions execute, eliminating single points of failure and enabling efficient governance compromise between responsiveness and decentralisation. Multi-sig eliminates unilateral control vulnerabilities whilst remaining more operationally practical than full token-weighted voting for treasury management and emergency protocol controls. Deployed across 50%+ of DAO treasuries through Safe, managing tens of billions in assets including Ethereum Foundation, Gitcoin, UNI, and ENS governance decisions."@en ;
    skos:prefLabel "Multi Sig Governance"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:blockchain:multi-sig-governance" ;
    owl:sameAs <urn:visionclaw:concept:blockchain:multi-sig-governance> ;
    vcw:contentHash "sha256-12-01455b473733" ;
    vcw:qualityScore "0.4"^^xsd:decimal ;
    vcw:legacyTermId "BC-0468" ;
    vcw:ontologyStatus "stub-needs-content" ;
    vcw:maturityLevel "draft" ;
    vcw:authorityScore "0.0"^^xsd:decimal ;
    dcterms:identifier "BC-0468" ;
    dcterms:subject "blockchain" ;
    owl:versionInfo "2.0.0" ;
    dcterms:created "2026-04-26T00:00:00Z"^^xsd:dateTime ;
    dcterms:modified "2026-04-26T13:00:00Z"^^xsd:dateTime ;
    vcw:owlRole "Concept" .

blockchain:MultiSigGovernance rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty infrastructure:enables ;
    owl:someValuesFrom blockchain:TreasuryManagement
] .

blockchain:MultiSigGovernance rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty infrastructure:implements ;
    owl:someValuesFrom blockchain:AccessControl
] .

# Snapshot Voting
blockchain:SnapshotVoting rdf:type owl:Class ;
    rdfs:label "Snapshot Voting"@en ;
    rdfs:comment "Snapshot is an off-chain governance infrastructure enabling gasless voting for DecentralizedAutonomousOrganization through cryptographic signatures (EIP-712) rather than blockchain transactions, eliminating participation costs that previously restricted voter participation. The platform aggregates voter preferences using flexible voting strategies—from simple TokenWeightedVoting to QuadraticVoting—indexed against historical blockchain state to prevent manipulation, storing immutable vote records on IPFS for transparency and auditability. Used by 10,000+ DAOs including major protocols like Aave, Uniswap, and ENS, Snapshot has become the de facto standard for on-chain DAO signalling, with optional SafeSnap integration enabling binding on-chain execution of vote results."@en ;
    skos:prefLabel "Snapshot Voting"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:blockchain:snapshot-voting" ;
    owl:sameAs <urn:visionclaw:concept:blockchain:snapshot-voting> ;
    vcw:contentHash "sha256-12-409b4e6c4789" ;
    vcw:qualityScore "0.4"^^xsd:decimal ;
    vcw:legacyTermId "BC-0469" ;
    vcw:ontologyStatus "stub-needs-content" ;
    vcw:maturityLevel "draft" ;
    vcw:authorityScore "0.0"^^xsd:decimal ;
    dcterms:identifier "BC-0469" ;
    dcterms:subject "blockchain" ;
    owl:versionInfo "2.0.0" ;
    dcterms:created "2026-04-26T00:00:00Z"^^xsd:dateTime ;
    dcterms:modified "2026-04-26T13:00:00Z"^^xsd:dateTime ;
    vcw:owlRole "Concept" .

# DAO Legal Structures
blockchain:DAOLegalStructures rdf:type owl:Class ;
    rdfs:label "DAO Legal Structures"@en ;
    rdfs:comment "Organisational and jurisdictional frameworks establishing legal entity status, liability limits, and regulatory recognition for Decentralised Autonomous Organisations operating under various governance models. These Legal Frameworks address Liability Protection, Tax Treatment, and Regulatory Compliance."@en ;
    skos:prefLabel "DAO Legal Structures"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:blockchain:dao-legal-structures" ;
