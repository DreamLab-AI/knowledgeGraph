ngm:ipfs a owl:Class ;
    rdfs:label "IPFS"@en ;
    rdfs:comment "The InterPlanetary File System (IPFS) is a peer-to-peer, content-addressed hypermedia protocol and distributed file system in which each piece of content is identified by a Content Identifier (CID) — a self-describing cryptographic hash derived from the content itself — rather than by its network location. Nodes exchange data blocks via Bitswap and route lookups through a Kademlia-based Distributed Hash Table implemented in libp2p, while the underlying data model (IPLD) structures blocks as a Merkle DAG enabling deduplication and efficient versioning. IPFS operates as the primary off-chain storage layer for Web3 applications, decentralised websites, NFT metadata, and distributed knowledge repositories, complemented by Filecoin's incentive layer for long-term data persistence."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:ipld ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:content-identifier ],
        ngm:peer-to-peer-network ;
    vc:bridgesTo ngm:blockchain,
        ngm:decentralised-autonomous-organisation,
        ngm:smart-contract ;
    vc:contrastsWith ngm:centralised-cloud-storage,
        ngm:hypertext-transfer-protocol ;
    vc:dependsOn ngm:kademlia-dht,
        ngm:multihash ;
    vc:enables ngm:decentralised-file-storage,
        ngm:decentralised-web,
        ngm:nft,
        ngm:web3 ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:bitswap,
        ngm:ipld,
        ngm:multicodec ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:bittorrent,
        ngm:ens,
        ngm:filecoin,
        ngm:git ;
    vc:requires ngm:content-identifier,
        ngm:pinning-service ;
    vc:slug "ipfs" ;
    vc:sourceDomain "distributed-systems" ;
    vc:uses ngm:content-addressing,
        ngm:cryptographic-hash,
        ngm:distributed-hash-table,
        ngm:libp2p,
        ngm:merkle-dag,
        ngm:merkle-tree .

ngm:rdf a owl:Class ;
    rdfs:label "RDF"@en ;
    rdfs:comment "The Resource Description Framework (RDF) is a W3C-standardised graph data model in which all statements are expressed as subject–predicate–object triples, where each component is identified by an IRI (Internationalised Resource Identifier) or, for literal values, a typed or language-tagged string. RDF triples compose into directed, labelled graphs that can be serialised in multiple syntaxes including Turtle, N-Triples, JSON-LD, N-Quads, and RDF/XML, and queried via the SPARQL protocol and query language. As the foundational layer of the Semantic Web and Linked Data ecosystems, RDF enables machine-readable knowledge representation that supports federated querying, ontological reasoning with OWL2, and cross-source interoperability through shared vocabulary IRIs. The open-world assumption distinguishes RDF from closed-world relational models, allowing independent datasets to be merged without schema negotiation."@en ;
    rdfs:subClassOf ngm:knowledge-representation ;
    vc:bridgesTo ngm:decentralised-identifier,
        ngm:machine-learning ;
    vc:contrastsWith ngm:property-graph,
        ngm:relational-database ;
    vc:enables ngm:federated-query,
        ngm:knowledge-graph,
        ngm:linked-data,
        ngm:ontological-reasoning,
        ngm:semantic-web ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:iri,
        ngm:rdf-graph,
        ngm:rdf-literal,
        ngm:rdf-triple ;
    vc:implements ngm:graph-data-model,
        ngm:w3c-specification,
        ngm:web-standard ;
    vc:qualityScore "0.76"^^xsd:float ;
    vc:relatedTo ngm:ontology,
        ngm:provenance,
        ngm:schema-org ;
    vc:requires ngm:iri,
        ngm:namespace ;
    vc:slug "rdf" ;
    vc:sourceDomain "data" ;
    vc:standardizedBy ngm:w3c ;
    vc:supports ngm:owl,
        ngm:shacl,
        ngm:triple-store ;
    vc:uses ngm:json-ld,
        ngm:rdfs,
        ngm:sparql,
        ngm:turtle .

ngm:signal-processing a owl:Class ;
    rdfs:label "Signal Processing"@en ;
    rdfs:comment "Signal processing is the mathematical and engineering discipline concerned with the representation, analysis, transformation, synthesis, filtering, and compression of signals — time-varying or spatially varying quantities such as audio, video, sensor telemetry, radio-frequency waveforms, biomedical readings, and seismic data. It encompasses both continuous (analogue) and discrete (digital) domains, applying techniques from Fourier analysis, linear algebra, probability theory, and optimisation to extract information, remove noise, encode data, and control systems. Digital signal processing (DSP) executes these operations on sampled data using algorithms implemented in hardware or software, making it foundational to telecommunications, audio engineering, image processing, radar, and AI feature extraction pipelines. Modern signal processing increasingly fuses classical deterministic methods with statistical and machine-learning approaches, enabling adaptive filters, compressed sensing, and deep neural network-based feature representations."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:linear-algebra ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:probability-theory ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:digital-signal-processing ],
        ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:bridgesTo ngm:neural-network,
        ngm:spatial-computing ;
    vc:contrastsWith ngm:symbolic-ai ;
    vc:enables ngm:depth-sensing,
        ngm:image-processing,
        ngm:radar-sensing,
        ngm:spatial-audio,
        ngm:speech-recognition ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:digital-signal-processing,
        ngm:filter-design,
        ngm:fourier-transform,
        ngm:sampling-theory ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:data,
        ngm:data-compression,
        ngm:feature-extraction,
        ngm:noise-reduction,
        ngm:render-pipeline ;
    vc:requires ngm:linear-algebra,
        ngm:probability-theory ;
    vc:slug "signal-processing" ;
    vc:sourceDomain "ai" ;
    vc:supports ngm:machine-learning,
        ngm:motion-capture,
        ngm:telecommunications ;
    vc:uses ngm:compressed-sensing,
        ngm:fast-fourier-transform,
        ngm:kalman-filter,
        ngm:wavelet-transform .

ngm:simulation a owl:Class ;
    rdfs:label "Simulation"@en ;
    rdfs:comment "Simulation is the computational reproduction of real-world systems, physical phenomena, or abstract processes through mathematical models that evolve over time, enabling experimentation, training, and prediction without risk to personnel or infrastructure. Simulations span a fidelity spectrum from simplified discrete-event models to high-fidelity continuous-physics environments powered by physics engines, rendering pipelines, and stochastic solvers. In spatial computing and metaverse contexts, real-time simulation underpins immersive training, digital twin synchronisation, and AI agent incubation. Simulation outputs are validated against empirical data and uncertainty quantified to ensure transferability of findings to the real world."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:real-time-computing ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:physics-engine ],
