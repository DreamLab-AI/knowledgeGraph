        ngm:neural-network-quantisation ;
    vc:slug "knowledge-distillation-for-edge" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:machine-learning-discipline,
        ngm:neural-network,
        ngm:transfer-learning .

ngm:light-node a owl:Class ;
    rdfs:label "Light Node"@en ;
    rdfs:comment "A Light Node is a blockchain network participant that downloads and verifies only block headers rather than the full transaction history, using Simplified Payment Verification (SPV) to confirm transaction inclusion via Merkle proofs. This design allows resource-constrained devices—mobile wallets, IoT devices, embedded clients—to interact securely with a blockchain without the storage and bandwidth demands of a Full Node, relying on connected full nodes to supply the underlying transaction data when required."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptographic-hash-function ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:peer-to-peer-network ],
        ngm:blockchain-entity ;
    vc:contrastsWith ngm:archival-node,
        ngm:full-node ;
    vc:enables ngm:digital-wallet ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:blockchain-infrastructure ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:blockchain-protocol,
        ngm:bootstrap-node,
        ngm:validator-node ;
    vc:requires ngm:cryptographic-hash-function,
        ngm:peer-to-peer-network ;
    vc:slug "light-node" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:blockchain-network,
        ngm:cryptographic-protocol .

ngm:manufacturing-automation a owl:Class ;
    rdfs:label "Manufacturing Automation"@en ;
    rdfs:comment "Manufacturing automation is the systematic application of control technologies, robotics, sensors, machine vision, and software to perform production tasks with minimal human intervention across discrete, process, and hybrid manufacturing environments. It encompasses programmable logic controllers (PLCs), industrial robots, computer numerical control (CNC) machines, distributed control systems (DCS), and integrated supervisory architectures that coordinate material flow, quality inspection, and assembly operations. Modern implementations leverage AI-driven process optimisation, digital twin synchronisation, and edge-cloud hybrid architectures to achieve adaptive, self-correcting production lines capable of real-time reconfiguration. The discipline aims to increase throughput, improve consistency, reduce cycle times, and enhance worker safety by reassigning operators away from hazardous or highly repetitive tasks."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:machine-vision ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:industrial-io-t ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:edge-computing ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:control-system ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:sensor-fusion ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:industrial-robot ],
        ngm:industrial-automation ;
    vc:bridgesTo ngm:predictive-maintenance,
        ngm:reinforcement-learning ;
    vc:enables ngm:cyber-physical-systems,
        ngm:flexible-manufacturing,
        ngm:mass-customisation,
        ngm:supply-chain ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:cnc-machining,
        ngm:control-system,
        ngm:industrial-robot,
        ngm:machine-vision,
        ngm:programmable-logic-controller,
