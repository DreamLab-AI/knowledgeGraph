ngm:agent-orchestrator a owl:Class ;
    rdfs:label "Agent Orchestrator"@en ;
    rdfs:comment "An Agent Orchestrator is a control component within a multi-agent system responsible for decomposing high-level goals into sub-tasks, assigning those tasks to appropriate specialised agents, monitoring execution progress, handling failures and retries, and assembling partial results into coherent outputs. It acts as the coordination hub that transforms a pool of individual autonomous agents into a collaborative system capable of accomplishing complex, multi-step objectives."@en ;
    rdfs:subClassOf ngm:ai-agent-system ;
    vc:enables ngm:agentic-workflow,
        ngm:autonomous-task-execution ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:coordination-mechanisms ;
    vc:slug "agent-orchestrator" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:agent-communication-protocol,
        ngm:agent-runtime,
        ngm:task-planning .

ngm:agent-runtime a owl:Class ;
    rdfs:label "Agent Runtime"@en ;
    rdfs:comment "An Agent Runtime is the execution environment that manages the lifecycle, resource allocation, tool access, memory state, and communication channels of one or more autonomous AI agents. It provides the foundational services — process isolation, context persistence, tool-call dispatch, and inter-agent messaging — upon which agent application logic is built, analogous to how an operating system runtime supports application processes."@en ;
    rdfs:subClassOf ngm:ai-agent-system ;
    vc:enables ngm:autonomous-task-execution ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:execution-model ;
    vc:slug "agent-runtime" ;
    vc:sourceDomain "ai" ;
    vc:supports ngm:agent-orchestrator,
        ngm:agentic-workflow ;
    vc:uses ngm:model-context-protocol,
        ngm:tool-use .

