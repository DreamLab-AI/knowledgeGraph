    vc:slug "model-training-pipeline" ;
    vc:sourceDomain "machine-learning" ;
    vc:supports ngm:mlops ;
    vc:uses ngm:data-preprocessing,
        ngm:loss-function .

ngm:motion-estimation a owl:Class ;
    rdfs:label "Motion Estimation"@en ;
    rdfs:comment "Motion estimation is the process of determining motion vectors that describe how regions of one video frame map to corresponding regions in another, capturing the apparent movement of objects and the camera between frames. It is the computational heart of inter-frame video compression, where predicting a block from a previously coded frame removes temporal redundancy. The same techniques underpin optical-flow analysis and frame interpolation in computer vision."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:signal-processing ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:signal-processing ],
        ngm:video-compression ;
    vc:bridgesTo ngm:machine-learning ;
    vc:contrastsWith ngm:image-compression ;
    vc:enables ngm:bitrate,
        ngm:video-compression ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:signal-processing ;
    vc:implements ngm:lossy-compression ;
    vc:isPartOf ngm:video-compression ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:codec,
        ngm:entropy-coding,
        ngm:optical-flow ;
