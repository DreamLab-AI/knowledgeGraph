ngm:production-facility a owl:Class ;
    rdfs:label "Production Facility"@en ;
    rdfs:comment "A Production Facility is a specialised physical and digital infrastructure for professional metaverse and immersive content creation, encompassing motion-capture stages, volumetric capture rigs, LED volume virtual production sets, GPU render farms, and cloud-based asset management pipelines. It integrates real-time rendering engines with collaborative tools enabling distributed global teams to produce high-fidelity 3D and spatial content."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:motion-capture ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:real-time-rendering ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:asset-management ],
        ngm:infra-computing-and-cloud ;
