            owl:someValuesFrom ngm:cuda ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:hardware ],
        ngm:gpu-computing ;
    vc:bridgesTo ngm:digital-twin,
        ngm:omniverse,
        ngm:spatial-computing ;
    vc:contrastsWith ngm:intel,
        ngm:tpu ;
    vc:enables ngm:autonomous-vehicle,
        ngm:computer-vision,
        ngm:deep-learning,
        ngm:high-performance-computing,
        ngm:large-language-model ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:cuda,
        ngm:nvlink,
        ngm:tensor-core ;
    vc:qualityScore "0.76"^^xsd:float ;
    vc:relatedTo ngm:generative-ai,
        ngm:transformer-architecture ;
    vc:requires ngm:hardware,
        ngm:semiconductor-fabrication ;
    vc:slug "nvidia-corporation" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:data-centre,
        ngm:machine-learning,
        ngm:robotics,
        ngm:scientific-computing ;
    vc:uses ngm:parallel-computing .

ngm:obfuscation a owl:Class ;
    rdfs:label "Obfuscation"@en ;
    rdfs:comment "Obfuscation is the deliberate transformation of data, code, or communication into a form that is difficult to understand or analyse while preserving its function, used to protect intellectual property, hinder reverse engineering, and conceal sensitive information. Unlike encryption, which renders data unreadable without a key, obfuscation aims to raise the effort required to comprehend an artefact rather than to guarantee secrecy. It is widely applied in software protection and privacy engineering."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:security ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
