ngm:bayesian-knowledge-tracing a owl:Class ;
    rdfs:label "Bayesian Knowledge Tracing"@en ;
    rdfs:comment "Bayesian Knowledge Tracing (BKT) is a probabilistic modelling technique that estimates a learner's mastery of a skill over time by treating knowledge as a latent binary state inferred from a sequence of correct and incorrect responses. Using a hidden Markov model with parameters for prior knowledge, learning, guessing, and slipping, BKT updates the probability that a student has mastered each skill after every interaction. It is a cornerstone of intelligent tutoring systems and adaptive learning, enabling personalised pacing and content selection."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:educational-technology ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:probabilistic-inference ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:hidden-markov-model ],
        ngm:adaptive-learning,
        ngm:learner-model,
        ngm:probabilistic-model ;
    vc:bridgesTo ngm:artificial-intelligence,
        ngm:deep-knowledge-tracing,
        ngm:explainable-ai ;
    vc:contrastsWith ngm:deep-knowledge-tracing,
        ngm:item-response-theory ;
    vc:enables ngm:computerised-adaptive-testing,
        ngm:formative-assessment,
        ngm:intelligent-tutoring-system,
        ngm:learning-analytics,
        ngm:mastery-learning,
        ngm:personalised-learning ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:hidden-markov-model,
        ngm:knowledge-component-model,
