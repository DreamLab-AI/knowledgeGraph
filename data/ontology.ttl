            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:vulnerability-scanner ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:continuous-monitoring ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:security-testing ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ci-cd-automation ],
        ngm:agile-software-development,
        ngm:cybersecurity,
        ngm:software-engineering ;
