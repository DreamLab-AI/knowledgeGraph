ngm:immersive-technology a owl:Class ;
    rdfs:label "Immersive Technology"@en ;
    rdfs:comment "The collective technologies comprising virtual reality (VR), augmented reality (AR), mixed reality (MR), and extended reality (XR) that create digital experiences blending physical and virtual environments, enabling user presence and interaction within computer-generated or enhanced spaces."@en ;
