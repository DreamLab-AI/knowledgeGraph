    vc:bridgesTo ngm:digital-asset,
        ngm:exchange-infrastructure,
        ngm:institutional-finance ;
    vc:contrastsWith ngm:bitcoin-lightning-network,
        ngm:rollup ;
    vc:enables ngm:asset-issuance,
        ngm:confidential-transactions,
        ngm:fast-settlement,
        ngm:security-token,
        ngm:stablecoin ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:federated-block-production,
        ngm:liquid-bitcoin ;
    vc:implements ngm:confidential-assets-protocol,
        ngm:sidechain ;
    vc:isPartOf ngm:bitcoin-layer-2-ecosystem ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:blockstream,
        ngm:peg-mechanism,
        ngm:transaction-privacy ;
    vc:requires ngm:bitcoin-proof-of-work-protocol,
