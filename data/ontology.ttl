    vc:slug "search-algorithm" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:graph-search,
        ngm:heuristic-methods .

ngm:security-token-offering a owl:Class ;
    rdfs:label "Security Token Offering"@en ;
    rdfs:comment "A Security Token Offering (STO) is a regulated fundraising mechanism in which blockchain-based tokens representing ownership rights, revenue shares, or other financial entitlements are offered to investors under applicable securities law. Unlike utility token sales, STOs require issuer compliance with financial regulation, investor accreditation, and prospectus or exemption filings, bringing traditional capital market discipline to tokenised asset issuance."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:identity-verification ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:regulatory-compliance ],
        [ a owl:Restriction ;
