ngm:data-standards a owl:Class ;
    rdfs:label "Data Standards"@en ;
    rdfs:comment "Data Standards are formally agreed specifications, schemas, formats, vocabularies, and protocols that define how data is structured, encoded, exchanged, and interpreted across systems, organisations, and domains. They enable interoperability between heterogeneous systems by establishing shared semantics and syntactic conventions, reducing integration costs and data quality errors. Governed by bodies such as ISO, W3C, IETF, and NIST, data standards span a spectrum from de facto industry conventions (e.g., JSON, CSV) to de jure normative specifications (e.g., SQL:2023, OWL2, FHIR). They are foundational to data governance, metadata management, and the reliable operation of distributed data ecosystems."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-quality ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:controlled-vocabulary ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:semantic-interoperability ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:metadata-standard ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:data-schema ],
        ngm:data-governance ;
    vc:bridgesTo ngm:federated-learning,
        ngm:knowledge-graph,
        ngm:semantic-web ;
    vc:contrastsWith ngm:data-silo,
        ngm:proprietary-format ;
    vc:dependsOn ngm:consensus-process,
        ngm:standards-body ;
    vc:enables ngm:data-integration,
        ngm:data-interoperability,
        ngm:linked-data,
        ngm:open-data ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:controlled-vocabulary,
        ngm:data-exchange-format,
        ngm:data-schema,
        ngm:metadata-standard ;
    vc:implements ngm:fair-principles ;
    vc:isPartOf ngm:data-governance ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:data-architecture,
