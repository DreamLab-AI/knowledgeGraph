        vf:natural-language-processing,
        vf:speech-recognition ;
    vc:slug "call-centres" ;
    vc:sourceDomain "artificial-intelligence" .

vf:carbon-credit-tracking a owl:Class ;
    rdfs:label "Carbon Credit Tracking"@en ;
    rdfs:comment "**Carbon Credit Tracking** is the application of [[Blockchain]] and distributed ledger technology to record, verify, transfer, and permanently retire carbon emission reduction credits across their full lifecycle — from project origination through third-party verification to final environmental claim — replacing fragmented centralised registries with immutable, publicly auditable on-chain provenance that eliminates double-counting and enables programmatic carbon accounting. Each tokenised carbon credit — standardly representing one metric tonne of CO2 equivalent (tCO2e) removed or avoided — is minted as a cryptographic token embedding verifiable metadata: project type, vintage year, geographic coordinates, applicable carbon standard ([[Verra VCS]] or [[Gold Standard]] or [[Climate Action Reserve]]), UN Sustainable Development Goal co-benefits, and monitoring provenance."@en ;
    rdfs:subClassOf <urn:visionflow:linked:carbon-markets>,
        <urn:visionflow:linked:distributed-ledger-application>,
        <urn:visionflow:linked:environmental-finance>,
        <urn:visionflow:linked:green-finance>,
        <urn:visionflow:linked:real-world-asset-tokenisation> ;
    vc:authorityScore "0.87"^^xsd:float ;
    vc:enables <urn:visionflow:linked:article-6-compliance>,
        <urn:visionflow:linked:automated-carbon-accounting>,
        <urn:visionflow:linked:carbon-price-discovery>,
        <urn:visionflow:linked:corporate-carbon-neutrality>,
        <urn:visionflow:linked:fractional-carbon-credit-ownership>,
        <urn:visionflow:linked:real-time-carbon-offsetting>,
        <urn:visionflow:linked:voluntary-carbon-markets> ;
    vc:hasPart <urn:visionflow:linked:carbon-registry-bridge>,
        <urn:visionflow:linked:corresponding-adjustment-record>,
        <urn:visionflow:linked:credit-issuance-engine>,
        <urn:visionflow:linked:mrv-oracle>,
        <urn:visionflow:linked:permanence-buffer-pool>,
        <urn:visionflow:linked:retirement-smart-contract>,
        vf:carbon-credit-token ;
    vc:implements <urn:visionflow:linked:corsia-aviation-offsets>,
        <urn:visionflow:linked:eu-taxonomy-green-finance>,
        <urn:visionflow:linked:gold-standard-certification>,
        <urn:visionflow:linked:icvcm-core-carbon-principles>,
        <urn:visionflow:linked:paris-agreement-article-6>,
        <urn:visionflow:linked:verra-vcs-methodology> ;
    vc:maturity "production-ready" ;
    vc:qualityScore "0.52"^^xsd:float ;
    vc:requires <urn:visionflow:linked:carbon-standard-certification>,
        <urn:visionflow:linked:immutable-audit-trail>,
