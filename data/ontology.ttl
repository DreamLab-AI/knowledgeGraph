    vc:requires ngm:mechanical-load,
        ngm:motor-driver,
        ngm:power-supply ;
    vc:slug "electric-motor" ;
    vc:sourceDomain "robotics" .

ngm:embedded-ai-frameworks a owl:Class ;
    rdfs:label "Embedded AI Frameworks"@en ;
    rdfs:comment "Software infrastructure and tooling optimised for deploying and running machine learning models on resource-constrained embedded systems and edge devices, with footprints of 100 KB to 10 MB, supporting INT8/FP16 quantisation, NPU/FPGA/DSP hardware acceleration abstraction, and streamlined memory allocation to avoid heap fragmentation on microcontrollers."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:model-pruning-for-edge-deployment ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:model-compression-for-edge ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:tiny-ml ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:edge-ai-accelerator ],
        ngm:ai-infrastructure ;
    vc:enables ngm:autonomous-robot,
        ngm:edge-ai-system,
        ngm:latency-aware-edge-ai,
        ngm:real-time-inference-at-edge ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:edge-ai-accelerator,
        ngm:model-compression-for-edge,
        ngm:model-pruning-for-edge-deployment,
        ngm:tiny-ml ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:edge-computing,
        ngm:io-t-ai-integration ;
    vc:slug "embedded-ai-frameworks" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:embedded-systems,
        ngm:fpga,
        ngm:hardware-acceleration,
        ngm:inference .

ngm:embodied-ai-simulation a owl:Class ;
    rdfs:label "Embodied AI Simulation"@en ;
    rdfs:comment "Embodied AI Simulation is the practice of training, evaluating, and validating autonomous agents and robotic systems within physically accurate, interactive virtual environments before deployment on real hardware. These simulation platforms render high-fidelity physics (rigid and soft-body dynamics, fluid simulation, contact forces), sensor models (cameras, LiDAR, IMU, depth sensors), and procedurally generated scenes to expose agents to diverse scenarios at scale. Sim-to-real transfer methods — including domain randomisation, domain adaptation, and curriculum learning — are applied to close the fidelity gap between simulated and real-world conditions. The discipline spans household robot manipulation tasks, autonomous vehicle testing, humanoid locomotion, and multi-agent coordination, bridging artificial intelligence research with physical robotic deployment."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:robot-kinematics ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:physics-engine ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:synthetic-data ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:domain-randomisation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:reinforcement-learning ],
        ngm:virtual-environment ;
    vc:bridgesTo ngm:extended-reality,
        ngm:metaverse,
        ngm:robotics ;
    vc:contrastsWith ngm:hardware-in-the-loop-testing ;
    vc:dependsOn ngm:gpu-computing,
        ngm:parallel-computing ;
    vc:enables ngm:autonomous-vehicle,
        ngm:robo-actuation-and-control,
        ngm:robo-navigation-and-planning,
        ngm:robot-learning ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:physics-engine,
        ngm:sensor-simulation,
        ngm:synthetic-data ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:curriculum-learning,
        ngm:digital-twin,
        ngm:multi-agent-systems ;
    vc:requires ngm:domain-randomisation,
        ngm:reinforcement-learning,
        ngm:robot-kinematics ;
    vc:slug "embodied-ai-simulation" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:computer-vision,
        ngm:deep-learning,
        ngm:generative-adversarial-network,
        ngm:nvidia-corporation-omniverse-platform .

ngm:enterprise-token-standards a owl:Class ;
