    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:cross-chain-messaging,
        ngm:digital-asset-ecosystem,
        ngm:spatial-computing .

ngm:legal-compliance a owl:Class ;
    rdfs:label "Legal Compliance"@en ;
    rdfs:comment "Legal compliance in the context of AI systems encompasses the organisational processes, controls, and evidence required to demonstrate adherence to applicable legislation, regulatory requirements, technical standards, and contractual obligations across the full lifecycle of AI development, deployment, and operation. Key legal instruments include the EU AI Act (risk-based product safety regulation), the GDPR (lawful processing and data subject rights for personal data used in training and inference), sector-specific financial regulations, and product liability laws. Compliance obligations are operationalised through risk assessments, technical documentation, conformity procedures, and ongoing monitoring."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:risk-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:compliance-framework ],
        ngm:ai-governance-and-ethics ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:ai-regulation,
        ngm:data-protection,
        ngm:regulatory-compliance ;
    vc:requires ngm:compliance-framework,
        ngm:risk-management ;
    vc:slug "legal-compliance" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:responsible-ai .

ngm:life-cycle-assessment a owl:Class ;
    rdfs:label "Life Cycle Assessment"@en ;
    rdfs:comment "Life Cycle Assessment (LCA) is a standardised, systematic methodology (ISO 14040/14044) for compiling and evaluating the inputs, outputs, and potential environmental impacts of a product system across all stages of its life cycle—from raw material acquisition through production, use, and end-of-life treatment. LCA quantifies a range of environmental impact categories including global warming potential (greenhouse gas emissions), acidification, eutrophication, water depletion, and land use, providing a comprehensive evidence base for comparing product alternatives and informing design for environment decisions. The results of LCA studies increasingly feed into ESG reporting, green finance due diligence, and supply chain transparency requirements."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:environmental-assessment ],
        ngm:infra-legal-and-regulatory ;
    skos:broader ngm:infra-legal-and-regulatory ;
    vc:enables ngm:carbon-footprint-assessment,
        ngm:environmental-sustainability ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:circular-economy,
        ngm:esg-reporting,
        ngm:supply-chain-traceability ;
    vc:requires ngm:environmental-assessment ;
    vc:slug "life-cycle-assessment" ;
    vc:sourceDomain "infrastructure" .

ngm:manipulator-arm a owl:Class ;
    rdfs:label "Manipulator Arm"@en ;
    rdfs:comment "A multi-jointed mechanical or virtual robotic arm integrated with avatars or immersive systems to enable precise object manipulation and physical interaction within virtual or mixed reality environments through control systems, haptic feedback, and inverse kinematics algorithms."@en ;
