        ngm:convolutional-neural-network,
        ngm:deep-learning,
        ngm:embeddings,
        ngm:neural-network-latent-space,
        ngm:transformer-architecture .

ngm:texture-mapping a owl:Class ;
    rdfs:label "Texture Mapping"@en ;
    rdfs:comment "Texture mapping is the computer graphics technique of applying a 2D image (texture) to the surface of a 3D geometric model so as to simulate surface colour, roughness, reflectance, and fine structural detail without subdividing the underlying mesh. The process involves establishing a correspondence between 3D surface points and 2D texture coordinates (UV space), then sampling the texture through a pipeline that handles filtering, mipmapping, and perspective-correct interpolation. Modern pipelines extend the concept to multi-channel PBR texture sets (albedo, metalness, roughness, normal, ambient-occlusion, emissive) that together drive physically-based shading models, enabling photorealistic rendering in both real-time and offline contexts."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:rasterization ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gpu ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:texture-atlas ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:uv-mapping ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:pixel-shader ],
        ngm:computer-graphics ;
    vc:bridgesTo ngm:generative-adversarial-network,
        ngm:neural-radiance-field ;
    vc:contrastsWith ngm:displacement-mapping,
        ngm:procedural-texture ;
    vc:enables ngm:differentiable-rendering,
        ngm:photorealism,
        ngm:physically-based-rendering,
        ngm:real-time-rendering ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:mipmap,
        ngm:normal-mapping,
        ngm:texture-atlas,
        ngm:uv-mapping ;
    vc:isPartOf ngm:3-d-rendering-engine,
        ngm:rendering-pipeline ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:material-definition,
        ngm:shader ;
    vc:requires ngm:gpu,
        ngm:pixel-shader,
        ngm:rasterization,
        ngm:uv-unwrapping ;
    vc:slug "texture-mapping" ;
    vc:sourceDomain "spatial-computing" ;
    vc:standardizedBy ngm:khronos-group,
        ngm:open-gl ;
    vc:supports ngm:augmented-reality,
        ngm:metaverse,
        ngm:virtual-reality ;
    vc:uses ngm:compute-shader,
        ngm:procedural-texture,
        ngm:texture-compression .

ngm:trust a owl:Class ;
    rdfs:label "Trust"@en ;
    rdfs:comment "Trust is a cognitive, relational, and institutional disposition in which an agent accepts vulnerability to the actions of another party based on a positive expectation that the trusted party will act competently, honestly, and benevolently toward the trusting party's interests. In sociotechnical and AI contexts, trust extends beyond interpersonal relationships to encompass institutional trust in organisations, systems trust in technological artefacts, and algorithmic trust in AI decision-making processes. Trust is simultaneously a psychological state, a social institution, and a design property of engineered systems; its calibration — whether systems are trusted appropriately, excessively, or insufficiently — carries profound implications for human welfare, democratic function, and the responsible deployment of AI. Across distributed and decentralised architectures, trust is increasingly operationalised via cryptographic attestation, verifiable credentials, and reputation mechanisms that replace reliance on a single central authority."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:transparency ],
        ngm:social-contract ;
    vc:bridgesTo ngm:decentralised-identity,
        ngm:explainability,
        ngm:verifiable-credentials ;
    vc:contrastsWith ngm:automation-bias,
        ngm:zero-trust-architecture ;
    vc:dependsOn ngm:authentication,
        ngm:identity ;
    vc:enables ngm:cooperation,
        ngm:delegation,
        ngm:trust-establishment,
        ngm:trust-infrastructure,
        ngm:trust-score-metric ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:accountability,
        ngm:ai-trustworthiness,
        ngm:legitimacy,
        ngm:reputation-system,
        ngm:trust-and-safety,
        ngm:trust-architecture ;
    vc:requires ngm:transparency ;
    vc:slug "trust" ;
    vc:sourceDomain "governance" ;
    vc:standardizedBy ngm:eu-ai-act-regulatory-instrument,
        ngm:iso-iec-42001,
        ngm:nist-ai-rmf ;
    vc:supports ngm:ai-trust-risk-and-security-management,
        ngm:governance,
        ngm:human-ai-collaboration,
        ngm:trust-in-automation,
        ngm:trust-over-ip-foundation .

ngm:cuda a owl:Class ;
    rdfs:label "CUDA"@en ;
    rdfs:comment "CUDA (Compute Unified Device Architecture) is NVIDIA's proprietary parallel computing platform and programming model that exposes GPU hardware through a C/C++ extension, enabling thousands of threads to execute concurrently across thousands of GPU cores via a three-level hierarchy of grids, blocks, and warps. It provides a unified memory model spanning host (CPU) and device (GPU) address spaces, complemented by curated libraries such as cuBLAS, cuDNN, and NCCL that deliver optimised primitives for linear algebra, deep neural network operations, and multi-GPU communication. Originally released in 2006, CUDA has become the de facto execution substrate for production deep learning training and inference, underpinning frameworks such as PyTorch and TensorFlow, and is the primary determinant of GPU vendor lock-in in the AI infrastructure stack."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:nvidia-gpu ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:tensor-core ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gpu-compute ],
        ngm:parallel-computing ;
    vc:bridgesTo ngm:gpu-rendering,
        ngm:high-performance-computing ;
    vc:contrastsWith ngm:opencl,
        ngm:rocm ;
    vc:enables ngm:deep-learning,
        ngm:inference,
        ngm:mixed-precision-training,
        ngm:scientific-computing,
        ngm:training ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:tensor-core ;
    vc:isPartOf ngm:ai-infrastructure ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:memory-bandwidth,
        ngm:python-pytorch-deep-learning-stack,
        ngm:tensor-flow ;
    vc:requires ngm:gpu-compute,
        ngm:nvidia-gpu ;
    vc:slug "cuda" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:computer-vision,
        ngm:large-language-model,
        ngm:machine-learning-discipline-framework,
        ngm:neural-network ;
    vc:uses ngm:shared-memory .

ngm:economics a owl:Class ;
    rdfs:label "Economics"@en ;
    rdfs:comment "Economics, as applied to the digital and AI-driven era, is the systematic study of how scarce resources are allocated through markets, institutions, and mechanisms when the primary inputs and outputs are information goods, algorithmic capabilities, autonomous agents, and cryptographic assets."@en ;
