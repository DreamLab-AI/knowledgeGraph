    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:embodied-ai .

ngm:game-theory a owl:Class ;
    rdfs:label "Game Theory"@en ;
    rdfs:comment "Game theory is the mathematical study of strategic interaction among rational agents, providing formal models for analysing decisions when outcomes depend on the choices of multiple actors with potentially conflicting interests. Its core concepts—Nash equilibrium, dominant strategies, cooperative and non-cooperative games, mechanism design, and information economics—are applied across economics, computer science, evolutionary biology, and AI system design."@en ;
    rdfs:subClassOf ngm:economics,
        ngm:mechanism-design ;
