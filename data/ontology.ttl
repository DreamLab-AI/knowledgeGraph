        ngm:infrastructure-domain ;
    vc:slug "enterprise-software-domain" ;
    vc:sourceDomain "enterprise-software" .

ngm:environmental-domain a owl:Class ;
    rdfs:label "Environmental Domain"@en ;
    rdfs:comment "The Environmental Domain covers the modelling, monitoring and management of natural and built environments and their resources. Its scope includes climate and ecological modelling, environmental sensing, sustainability assessment and resource management. It is a top-level subject classification applied across many technologies. The boundary excludes economic and market analysis of resources, which belongs to the Financial Markets Domain."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:environmental-sensing ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
