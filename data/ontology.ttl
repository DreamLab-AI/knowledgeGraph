    vcw:ontologyStatus "draft" ;
    vcw:maturityLevel "draft" ;
    vcw:authorityScore "0.0"^^xsd:decimal ;
    dcterms:identifier "MV-9545" ;
    dcterms:subject "infrastructure" ;
    owl:versionInfo "2.0.0" ;
    dcterms:created "2026-04-26T00:00:00Z"^^xsd:dateTime ;
    dcterms:modified "2026-04-26T12:00:00Z"^^xsd:dateTime ;
    vcw:owlRole "Foundational-Technology" .

infrastructure:Cryptography rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty infrastructure:requires ;
    owl:someValuesFrom infrastructure:HashFunction
] .

infrastructure:Cryptography rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty infrastructure:requires ;
    owl:someValuesFrom infrastructure:DigitalSignature
] .

infrastructure:Cryptography rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty infrastructure:requires ;
    owl:someValuesFrom infrastructure:EncryptionScheme
] .

infrastructure:Cryptography rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty infrastructure:enables ;
    owl:someValuesFrom infrastructure:ConsensusProtocol
] .

infrastructure:Cryptography rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty infrastructure:enables ;
    owl:someValuesFrom infrastructure:DigitalAsset
] .

infrastructure:Cryptography rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty infrastructure:enables ;
    owl:someValuesFrom infrastructure:CryptographicProtocol
] .

