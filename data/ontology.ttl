ngm:securities-settlement a owl:Class ;
    rdfs:label "Securities Settlement"@en ;
    rdfs:comment "Securities settlement is the process by which the buyer of a security receives the asset and the seller receives payment, completing a trade through the final transfer of legal ownership and funds between counterparties, typically via a central securities depository (CSD) or clearing house. Traditional settlement occurs on a T+1 or T+2 basis after trade execution, involves complex chains of custodians, CSDs, and central counterparty clearing houses (CCPs), and carries counterparty risk during the settlement window. Distributed ledger technology and tokenised securities are driving a shift toward atomic and real-time settlement."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:central-securities-depository ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:delivery-versus-payment ],
        ngm:financial-system ;
    vc:bridgesTo ngm:blockchain,
        ngm:decentralised-finance ;
    vc:contrastsWith ngm:atomic-settlement,
        ngm:instant-value-settlement ;
    vc:dependsOn ngm:financial-infrastructure,
        ngm:payment-system,
        ngm:real-time-gross-settlement ;
    vc:enables ngm:digital-asset-trading,
        ngm:tokenised-securities,
        ngm:trustless-settlement ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:delivery-versus-payment ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:counterparty-risk,
        ngm:financial-market-infrastructure,
        ngm:systemic-risk ;
    vc:requires ngm:central-counterparty-clearing,
        ngm:central-securities-depository,
        ngm:custodian-bank ;
    vc:slug "securities-settlement" ;
    vc:sourceDomain "finance" ;
    vc:standardizedBy ngm:securities-regulation ;
    vc:uses ngm:digital-asset-infrastructure,
        ngm:distributed-ledger-technology,
        ngm:smart-contract .

ngm:security-architecture a owl:Class ;
    rdfs:label "Security Architecture"@en ;
    rdfs:comment "A comprehensive framework defining security controls, policies, and technologies that protect systems, infrastructure, user data, and digital assets through defence-in-depth strategies including authentication, encryption, access control, threat monitoring, and zero-trust principles."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:identity-and-access-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:encryption ],
        [ a owl:Restriction ;
