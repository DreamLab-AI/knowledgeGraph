vf:interpretable-ai a owl:Class ;
    rdfs:label "Interpretable AI"@en ;
    rdfs:comment "Machine learning models and systems whose internal decision-making processes are inherently transparent and understandable to humans without requiring additional post-hoc explanation techniques."@en ;
