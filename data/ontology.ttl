# Visual Marker
spatial-computing:VisualMarker rdf:type owl:Class ;
    rdfs:subClassOf spatial-computing:ARTechnology ;
    rdfs:label "Visual Marker"@en ;
    rdfs:comment "A distinctive visual pattern or fiducial placed in physical environments to enable computer vision systems to track position, orientation, and pose for augmented reality applications, including QR codes, AprilTags, ARTags, and custom image targets that serve as reference points for overlaying digital content."@en ;
    skos:prefLabel "Visual Marker"@en ;
