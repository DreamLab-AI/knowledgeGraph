ngm:across-protocol a owl:Class ;
    rdfs:label "Across Protocol"@en ;
    rdfs:comment "Across Protocol is a decentralised cross-chain bridging protocol that uses an optimistic verification model and a network of liquidity providers—called relayers—to enable fast, capital-efficient transfers of ERC-20 tokens between Ethereum mainnet and Layer 2 networks such as Optimism, Arbitrum, and Polygon. Relayers front user funds immediately on the destination chain and are reimbursed from a liquidity pool on Ethereum after an optimistic challenge period, creating a bridge architecture that prioritises speed and low fees over trustless finality."@en ;
    rdfs:subClassOf ngm:cross-chain-bridge ;
    vc:dependsOn ngm:ethereum-smart-contract-platform,
        ngm:layer-2-solutions ;
    vc:enables ngm:cross-chain-asset-transfer,
        ngm:cross-chain-interoperability ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:interoperability-protocol ;
    vc:slug "across-protocol" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:liquidity-pool,
        ngm:liquidity-provider .

