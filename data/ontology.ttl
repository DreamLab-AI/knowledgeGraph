ngm:transaction-parameter a owl:Class ;
    rdfs:label "Transaction Parameter"@en ;
    rdfs:comment "Transaction Parameters are the configuration values that define the execution characteristics of a blockchain transaction, including gas limit, gas price (or priority fee under EIP-1559), nonce, value, and calldata. These parameters determine transaction priority, cost, computational resources consumed, and ordering within blocks, directly influencing DeFi strategies such as MEV extraction and Layer 2 batching efficiency."@en ;
    rdfs:subClassOf ngm:bc-protocol-and-consensus,
        ngm:blockchain-transaction ;
    skos:broader ngm:bc-protocol-and-consensus ;
    vc:enables ngm:gas-optimization,
