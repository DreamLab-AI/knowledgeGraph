        ngm:serverless-computing ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:bigquery,
        ngm:cloud-run,
        ngm:cloud-storage,
        ngm:google-kubernetes-engine,
        ngm:tensor-processing-unit,
        ngm:vertex-ai ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:cloud-native-computing,
        ngm:google-workspace,
        ngm:identity-and-access-management ;
    vc:requires ngm:cloud-computing,
        ngm:data-centre,
        ngm:internet-connectivity ;
    vc:slug "google-cloud" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:devops,
