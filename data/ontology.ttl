        ngm:velocity-measurement ;
    vc:implements ngm:adaptive-control,
        ngm:cascade-control,
        ngm:feedforward-control,
        ngm:observer-design,
        ngm:picontrol ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires ngm:bandwidth-design,
        ngm:controller-tuning,
        ngm:noise-filtering,
        ngm:stability-analysis,
        ngm:velocity-estimation ;
    vc:slug "velocity-control" ;
    vc:sourceDomain "robotics" .

ngm:video-streaming a owl:Class ;
    rdfs:label "Video Streaming"@en ;
    rdfs:comment "Video Streaming is the continuous, real-time transmission of encoded video data over a network to a client device that decodes and renders the content progressively, without requiring the complete file to be downloaded before playback begins. It relies on transport protocols such as RTMP, HLS, DASH, and WebRTC, combined with adaptive bitrate (ABR) algorithms that dynamically adjust resolution and compression to match available network conditions. Modern deployments encompass live streaming, video-on-demand (VoD), 360-degree video, volumetric video, and cloud-rendered remote-display streaming, each with distinct latency, bandwidth, and codec trade-offs. Content delivery networks (CDNs), edge computing nodes, and specialised video codecs such as H.264, H.265/HEVC, AV1, and VP9 are the principal technical pillars enabling scalable, low-latency distribution at global scale."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:network-infrastructure ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:edge-computing ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:content-delivery-network ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:volumetric-video ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:video-codec ],
        ngm:network-infrastructure ;
    vc:bridgesTo ngm:machine-learning-inference,
        ngm:spatial-computing ;
    vc:contrastsWith ngm:broadcast-television,
        ngm:file-download ;
    vc:dependsOn ngm:bandwidth-management,
        ngm:latency-optimisation ;
    vc:enables ngm:cloud-gaming,
        ngm:metaverse-platform,
        ngm:remote-rendering,
        ngm:virtual-production ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:adaptive-bitrate-streaming,
        ngm:live-streaming,
        ngm:video-on-demand,
        ngm:volumetric-video ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:bandwidth-adaptation,
        ngm:digital-rights-management,
        ngm:quality-of-service ;
    vc:requires ngm:content-delivery-network,
        ngm:edge-computing,
        ngm:network-infrastructure,
        ngm:video-codec ;
    vc:slug "video-streaming" ;
    vc:sourceDomain "infrastructure" ;
    vc:standardizedBy ngm:mpeg-dash,
        ngm:webrtc ;
    vc:supports ngm:360-degree-video,
        ngm:extended-reality,
        ngm:social-vr ;
    vc:uses ngm:data-compression,
        ngm:http-live-streaming,
        ngm:real-time-rendering,
        ngm:webrtc .

ngm:virtual-asset a owl:Class ;
    rdfs:label "Virtual Asset"@en ;
    rdfs:comment "Digital items with economic value within metaverse environments, spanning non-fungible tokens representing unique digital collectibles, avatars and avatar customisations, virtual real estate, and in-game items with market-tradeable value. Ownership and transfer of virtual assets rely on blockchain smart contracts or centralised platform ledgers, with interoperability standards enabling asset portability across platforms and markets. Economic significance spans consumer entertainment and investment speculation, with regulatory frameworks increasingly addressing taxation and classification under securities laws."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:digital-wallet ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
