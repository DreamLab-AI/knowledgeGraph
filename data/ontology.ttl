        ngm:spatial-computing,
        ngm:virtual-reality ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:micro-oled-display,
        ngm:spatial-audio-system,
        ngm:tracking-system ;
    vc:implements ngm:openxr-standard ;
    vc:isPartOf ngm:metaverse,
        ngm:wearable-computing-platform ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:field-of-view ;
    vc:requires ngm:real-time-rendering,
