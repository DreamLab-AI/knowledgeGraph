ngm:monte-carlo-localization a owl:Class ;
    rdfs:label "Monte Carlo Localization"@en ;
    rdfs:comment "A probabilistic localization algorithm that represents the robot's belief about its position using a set of weighted particles (samples), where each particle represents a hypothesis of the robot's pose. It implements a particle filter to recursively estimate the robot's pose distribution."@en ;
    rdfs:subClassOf ngm:rb-1013-localization ;
    vc:enables ngm:global-localization,
        ngm:kidnapped-robot-problem ;
    vc:maturity "established" ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires ngm:map,
        ngm:motion-model,
        ngm:sensor-measurements ;
    vc:slug "monte-carlo-localization" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:importance-sampling,
        ngm:rb-1008-odometry,
        ngm:sensor-fusion .

