    vc:implements ngm:financial-system ;
    vc:isPartOf ngm:financial-system ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:economics,
        ngm:fiat-currency,
        ngm:liquidity,
        ngm:money ;
    vc:slug "fractional-reserve-banking" ;
    vc:sourceDomain "finance" ;
    vc:standardizedBy ngm:financial-regulation ;
    vc:supports ngm:monetary-policy ;
    vc:uses ngm:interest-rate .

