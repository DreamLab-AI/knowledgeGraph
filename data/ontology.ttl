# Human Factors
robotics:HumanFactors rdf:type owl:Class ;
    rdfs:subClassOf robotics:InteractionDesign ;
    rdfs:subClassOf robotics:SystemsEngineering ;
    rdfs:label "Human Factors"@en ;
    rdfs:comment "Human factors encompasses the interdisciplinary study of how humans interact with, perceive, and respond to robotic systems, integrating ergonomics, psychology, cognitive science, and design principles to ensure robots enhance rather than impede human performance and safety. Effective human factors engineering is critical for successful Human-Robot Interaction, Collaborative Robotics, and safe deployment in human-centred environments."@en ;
    skos:prefLabel "Human Factors"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:robotics:human-factors" ;
    owl:sameAs <urn:visionclaw:concept:robotics:human-factors> ;
