ngm:university-of-oxford a owl:Class ;
    rdfs:label "University of Oxford"@en ;
    rdfs:comment "The University of Oxford is a collegiate research university located in Oxford, England, widely regarded as one of the world's foremost institutions of higher education and research. Founded in the twelfth century, it comprises forty-four autonomous colleges and a network of academic departments spanning the humanities, sciences, social sciences, and engineering. Oxford is a leading site of research in artificial intelligence, machine learning, computer vision, natural language processing, and computational biology, and plays a central role in UK and global AI policy, ethics, and governance discourse. Its Future of Humanity Institute and Oxford Internet Institute are internationally recognised centres for the study of transformative technologies and their societal implications."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:oxford-internet-institute ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:future-of-humanity-institute ],
        ngm:ai-research-area ;
    skos:broader ngm:ai-research-area ;
    vc:bridgesTo ngm:blockchain-governance,
        ngm:quantum-computing,
        ngm:spatial-computing ;
    vc:enables ngm:ai-safety-research,
        ngm:artificial-intelligence,
        ngm:computer-vision,
        ngm:machine-learning,
        ngm:natural-language-processing ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:future-of-humanity-institute,
        ngm:oxford-internet-institute,
        ngm:oxford-robotics-institute ;
    vc:isPartOf ngm:russell-group,
        ngm:uk-higher-education-sector ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:alan-turing-institute,
        ngm:cambridge-university,
        ngm:deepmind,
        ngm:european-laboratory-for-molecular-biology,
        ngm:imperial-college-london,
        ngm:research-institution,
        ngm:uk-research-and-innovation ;
    vc:slug "university-of-oxford" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:ai-governance,
        ngm:data-science,
        ngm:open-source-software .

