    vc:slug "storage-layer" ;
    vc:sourceDomain "infrastructure" .

ngm:structured-output a owl:Class ;
    rdfs:label "Structured Output"@en ;
    rdfs:comment "Structured output is a technique for constraining a language model to emit responses that conform to a predefined schema such as JSON, a regular grammar, or a typed object. It is enforced through prompt instructions, constrained decoding, or function-calling interfaces so that downstream systems can parse results reliably. Structured output bridges free-form generation and deterministic software by guaranteeing machine-readable, validatable responses."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:json-data-interchange-format-schema ],
        ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:bridgesTo ngm:data,
        ngm:infrastructure ;
    vc:contrastsWith ngm:chain-of-thought ;
    vc:dependsOn ngm:large-language-models,
        ngm:tokenization ;
    vc:enables ngm:ai-agent,
        ngm:function-calling,
        ngm:retrieval-augmented-generation,
        ngm:tool-use ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:grammar-constrained-generation,
        ngm:schema-validation ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:large-language-models,
        ngm:openai-research-organisation-api,
        ngm:prompt-engineering,
        ngm:pydantic ;
    vc:requires ngm:constrained-decoding,
        ngm:json-data-interchange-format-schema ;
    vc:slug "structured-output" ;
    vc:sourceDomain "ai" ;
    vc:supports ngm:agentic-workflow,
        ngm:api-integration,
        ngm:information-extraction ;
    vc:uses ngm:prompt-engineering,
        ngm:regular-expression,
        ngm:type-system .

ngm:subword-tokenisation a owl:Class ;
    rdfs:label "Subword Tokenisation"@en ;
    rdfs:comment "A tokenisation strategy that segments text into sub-word units (via algorithms such as Byte-Pair Encoding, WordPiece, or SentencePiece), balancing vocabulary size against the ability to represent rare, morphologically complex, and out-of-vocabulary words. Subword tokenisation is the de facto standard preprocessing step for large language models."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:language-modeling ],
        ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:enables ngm:large-language-models,
        ngm:natural-language-processing ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:neural-network-text-tokenisation ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:relatedTo ngm:natural-language-understanding ;
    vc:requires ngm:language-modeling ;
    vc:slug "subword-tokenisation" ;
    vc:sourceDomain "spatial-computing" .

ngm:supervisory-authority a owl:Class ;
    rdfs:label "Supervisory Authority"@en ;
    rdfs:comment "A supervisory authority is an independent public body empowered by law to monitor, enforce, and provide guidance on compliance with a regulatory regime within a defined jurisdiction. In data-protection law, for example, supervisory authorities oversee how organisations process personal data, investigate complaints, conduct audits, and impose corrective measures or fines. More broadly the term covers sectoral regulators that license, examine, and sanction the entities they govern, deriving their legitimacy from statute and exercising powers of investigation, enforcement, and rule-setting."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:compliance ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:audit ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:regulatory-compliance ],
        ngm:regulation ;
    vc:bridgesTo ngm:compliance ;
    vc:dependsOn ngm:governance,
        ngm:regulation ;
    vc:enables ngm:regulatory-compliance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:audit,
        ngm:compliance ;
    vc:implements ngm:gdpr ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:central-bank,
        ngm:data-protection,
        ngm:gdpr ;
    vc:requires ngm:regulatory-compliance ;
    vc:slug "supervisory-authority" ;
    vc:sourceDomain "governance" ;
    vc:supports ngm:data-protection ;
    vc:uses ngm:audit .

ngm:support-vector-machine a owl:Class ;
    rdfs:label "Support Vector Machine"@en ;
    rdfs:comment "A support vector machine (SVM) is a supervised learning model that finds the hyperplane separating classes with the maximum margin between the nearest training examples, called support vectors. Through the kernel trick it can construct non-linear decision boundaries by implicitly mapping inputs into higher-dimensional feature spaces. SVMs are grounded in statistical learning theory and are effective for classification and regression on small to medium, high-dimensional datasets."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:feature-engineering ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:labelled-dataset ],
        ngm:supervised-learning ;
    vc:contrastsWith ngm:deep-learning,
        ngm:neural-network ;
    vc:enables ngm:model-evaluation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:classification,
        ngm:regression ;
    vc:isPartOf ngm:supervised-learning ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:classification,
        ngm:overfitting ;
    vc:requires ngm:feature-engineering,
        ngm:labelled-dataset ;
    vc:slug "support-vector-machine" ;
    vc:sourceDomain "machine-learning" ;
    vc:supports ngm:machine-learning ;
    vc:uses ngm:optimization-algorithm,
        ngm:statistical-learning-theory .

ngm:synchronous-collaboration a owl:Class ;
    rdfs:label "Synchronous Collaboration"@en ;
    rdfs:comment "\"Real-time interaction mode where distributed participants engage simultaneously through technology-mediated channels, enabling immediate feedback, spontaneous ideation, and social presence comparable to co-located teamwork.\""@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:communication-protocols ],
        ngm:dc-communication,
        ngm:telecollaboration ;
