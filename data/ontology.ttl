    vc:contrastsWith ngm:natural-language-generation ;
    vc:enables ngm:dialogue-management,
        ngm:information-extraction,
        ngm:machine-translation,
        ngm:question-answering,
        ngm:sentiment-analysis ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:coreference-resolution,
        ngm:intent-classification,
        ngm:named-entity-recognition,
        ngm:relation-extraction,
        ngm:semantic-role-labelling ;
    vc:isPartOf ngm:computational-linguistics,
