            owl:someValuesFrom ngm:formal-verification ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:real-time-operating-system ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:functional-safety ],
        ngm:embedded-systems ;
    vc:bridgesTo ngm:artificial-intelligence,
        ngm:blockchain,
        ngm:spatial-computing ;
    vc:contrastsWith ngm:information-technology,
        ngm:operational-technology ;
    vc:dependsOn ngm:edge-computing,
