ngm:mathematical-foundations a owl:Class ;
    rdfs:label "Mathematical Foundations"@en ;
    rdfs:comment "Mathematical Foundations refers to the collection of core mathematical disciplines — including linear algebra, calculus, probability theory, discrete mathematics, and number theory — that underpin the formal reasoning required across computer science, cryptography, artificial intelligence, and engineering. These disciplines provide the rigorous axiomatic structures and analytical tools upon which algorithms, proofs, models, and systems are built. Mastery of mathematical foundations is considered prerequisite knowledge for deep work in machine learning, cryptographic protocol design, and distributed systems. They bridge pure abstract reasoning with applied computational practice."@en ;
    rdfs:subClassOf ngm:mathematical-science ;
    vc:enables ngm:cryptography,
        ngm:formal-verification,
        ngm:machine-learning,
        ngm:optimization-algorithm ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:mathematical-hard-problems,
        ngm:mathematical-reasoning,
        ngm:quantum-computing ;
    vc:slug "mathematical-foundations" ;
    vc:sourceDomain "science" ;
    vc:supports ngm:deep-learning,
        ngm:gradient-descent .

ngm:microservices a owl:Class ;
    rdfs:label "Microservices"@en ;
    rdfs:comment "Microservices is an architectural style in which a large application is decomposed into a collection of small, independently deployable services, each responsible for a specific business capability and communicating via well-defined APIs. Each service runs in its own process, can be developed and scaled independently, and may use its own data storage technology. This approach contrasts with monolithic architectures and enables continuous delivery, polyglot development, and fine-grained fault isolation."@en ;
    rdfs:subClassOf ngm:microservices-architecture ;
    vc:enables ngm:cloud-computing,
        ngm:open-telemetry ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:cloud-native-applications,
        ngm:distributed-system,
        ngm:software-architecture ;
    vc:slug "microservices" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:api-gateway,
        ngm:kubernetes,
        ngm:rest-api,
        ngm:service-discovery .

ngm:mobile-robot-platform a owl:Class ;
    rdfs:label "Mobile Robot Platform"@en ;
    rdfs:comment "A Mobile Robot Platform is an integrated mechatronic base that provides locomotion, power, computing, and sensor-mounting infrastructure upon which higher-level autonomy stacks—perception, planning, and control—are deployed."@en ;
