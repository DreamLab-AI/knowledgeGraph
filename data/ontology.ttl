        ngm:calibration-target,
        ngm:data-interface,
        ngm:optical-window,
        ngm:sensing-element,
        ngm:sensor-housing,
        ngm:signal-conditioning ;
    vc:implements ngm:acoustic-sensing,
        ngm:event-driven-sensing,
        ngm:radar-sensing,
        ngm:range-sensing,
        ngm:tactile-sensing,
        ngm:thermal-sensing,
        ngm:vision-sensing ;
    vc:qualityScore "0.52"^^xsd:float ;
