    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:deep-learning .

ngm:model-calibration a owl:Class ;
    rdfs:label "Model Calibration"@en ;
    rdfs:comment "Model calibration is the process of ensuring that the probabilities a predictive model outputs reflect the true likelihood of outcomes, so that, for example, events predicted with 70 per cent confidence occur roughly 70 per cent of the time. A well-calibrated model produces reliable confidence estimates, which is essential when predictions inform risk-sensitive decisions. Calibration is assessed with reliability diagrams and metrics such as expected calibration error, and corrected with post-hoc techniques that adjust a model's output probabilities without changing its rankings."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:model-evaluation ],
        ngm:model-evaluation ;
    vc:bridgesTo ngm:uncertainty-quantification ;
    vc:dependsOn ngm:probabilistic-model ;
    vc:enables ngm:decision-making,
        ngm:trustworthy-ai ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:model-evaluation ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:loss-function,
        ngm:model-evaluation,
        ngm:probabilistic-model,
        ngm:uncertainty-quantification ;
    vc:requires ngm:model-evaluation ;
    vc:slug "model-calibration" ;
    vc:sourceDomain "machine-learning" ;
    vc:supports ngm:model-deployment,
        ngm:trustworthy-ai ;
    vc:uses ngm:loss-function .

ngm:model-checkpoint a owl:Class ;
    rdfs:label "Model Checkpoint"@en ;
    rdfs:comment "A model checkpoint is a serialised snapshot of a machine learning model's learned parameters (weights), often including optimiser state, captured at a point during or after training. Checkpoints allow training to resume after interruption, enable model sharing and deployment, and support evaluation of intermediate states. They are typically stored in formats such as safetensors, PyTorch .pt, or framework-native files."@en ;
    rdfs:subClassOf ngm:ai-infrastructure ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:node-based-diffusion-pipeline-interface-workflows,
        ngm:safetensors ;
    vc:slug "model-checkpoint" ;
    vc:sourceDomain "ai" .

ngm:model-training-pipeline a owl:Class ;
    rdfs:label "Model Training Pipeline"@en ;
    rdfs:comment "A model training pipeline is the orchestrated sequence of stages that transforms raw data into a trained, validated machine-learning model ready for deployment. It typically chains data ingestion and preprocessing, feature engineering, model fitting, hyperparameter tuning and evaluation into a reproducible, automatable workflow. As a backbone of MLOps, the pipeline enforces consistency, versioning and repeatability across training runs."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:hyperparameter-tuning ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:feature-engineering ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-preprocessing ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:model-evaluation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-pipeline ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:loss-function ],
        ngm:machine-learning ;
    vc:enables ngm:model-deployment ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:feature-engineering,
        ngm:hyperparameter-tuning,
        ngm:model-evaluation ;
    vc:implements ngm:model-evaluation ;
    vc:isPartOf ngm:machine-learning,
        ngm:mlops ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:data-pipeline,
