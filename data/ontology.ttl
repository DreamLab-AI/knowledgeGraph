    vc:slug "energy-and-power" ;
    vc:sourceDomain "infrastructure" .

vf:enterprise-blockchain-architecture a owl:Class ;
    rdfs:label "Enterprise Blockchain Architecture"@en ;
    rdfs:comment "Permissioned, enterprise-grade blockchain infrastructure implementing [[Consensus Mechanism|consensus mechanisms]], [[Smart Contract|smart contracts]], and governance frameworks for organisations requiring controlled participation, privacy, and regulatory compliance—exemplified by [[Hyperledger Fabric]], [[Hyperledger Besu]], and [[Corda]]."@en ;
    rdfs:subClassOf vf:smart-contract-platform ;
    vc:authorityScore "0.0"^^xsd:float ;
    vc:maturity "draft" ;
    vc:qualityScore "0.4"^^xsd:float ;
    vc:requires <urn:visionflow:linked:bc-0120-consensus-mechanism> ;
    vc:slug "enterprise-blockchain-architecture" ;
    vc:sourceDomain "blockchain" .

vf:enterprise-smart-contracts a owl:Class ;
    rdfs:label "Enterprise Smart Contracts"@en ;
    rdfs:comment "**Enterprise smart contracts** are self-executing code artefacts deployed on permissioned [[Distributed Ledger Technology]] platforms — [[Hyperledger Fabric]] chaincode (Go/Node.js/Java), [[R3 Corda]] CorDapps (Kotlin/JVM), [[Quorum Blockchain]] and [[Hyperledger Besu]] (EVM permissioned with Tessera/Orion private state), [[Hyperledger Iroha]] (command-based), [[R3 Conclave]] (Intel SGX confidential computing), [[JPM Onyx]] Coin Systems, and Microsoft's Confidential Consortium Framework — that automate multi-party business agreements under regulated governance, confidentiality, and legal-enforceability constraints fundamentally different from public-blockchain code (e.g., [[Ethereum]] [[Solidity]] on Mainnet, [[Solana]] programs). Where public smart contracts prioritise trustlessness, censorship resistance, and immutable \"code is law\" semantics, enterprise smart contracts prioritise organisational governance (multi-party endorsement, on-chain voting), regulatory compliance (KYC/AML/sanctions screening, [[GDPR]] right-to-erasure reconciliation), business confidentiality (private data collections, point-to-point flows, encrypted contracts via Tessera/Orion, [[Zero-Knowledge Proofs]] "@en ;
    rdfs:subClassOf <urn:visionflow:linked:business-logic-code>,
        <urn:visionflow:linked:distributed-application>,
        <urn:visionflow:linked:multi-party-agreement>,
        <urn:visionflow:linked:permissioned-compute-artefact>,
        vf:smart-contracts ;
    vc:authorityScore "0.87"^^xsd:float ;
    vc:enables <urn:visionflow:linked:atomic-settlement>,
        <urn:visionflow:linked:delivery-versus-payment>,
        <urn:visionflow:linked:insurance-claim-automation>,
        <urn:visionflow:linked:regulatory-reporting-automation>,
        <urn:visionflow:linked:syndicated-lending-automation>,
        <urn:visionflow:linked:tokenised-securities>,
        <urn:visionflow:linked:trade-finance-automation>,
        vf:provenance-tracking ;
    vc:hasPart <urn:visionflow:linked:chaincode>,
        <urn:visionflow:linked:contract-state>,
        <urn:visionflow:linked:cor-dapp>,
        <urn:visionflow:linked:endorsement-policy>,
        <urn:visionflow:linked:flow-logic>,
        <urn:visionflow:linked:notary-service>,
        <urn:visionflow:linked:private-data-collection>,
        <urn:visionflow:linked:ricardian-contract-template>,
        <urn:visionflow:linked:solidity-contract> ;
    vc:implements <urn:visionflow:linked:accord-project-cicero>,
        <urn:visionflow:linked:erc-1400-security-token>,
        <urn:visionflow:linked:erc-3475-abstract-bond>,
        <urn:visionflow:linked:erc-3643-t-rex>,
        <urn:visionflow:linked:finos-common-domain-model>,
        <urn:visionflow:linked:isda-common-domain-model>,
        <urn:visionflow:linked:ricardian-contracts> ;
    vc:maturity "production-ready" ;
    vc:qualityScore "0.52"^^xsd:float ;
    vc:requires <urn:visionflow:linked:audit-function>,
        <urn:visionflow:linked:certificate-authority>,
        <urn:visionflow:linked:legal-agreement>,
        vf:governance-framework,
        vf:identity-management,
        vf:permissioned-blockchain,
        vf:public-key-infrastructure ;
    vc:slug "enterprise-smart-contracts" ;
    vc:sourceDomain "blockchain" .

