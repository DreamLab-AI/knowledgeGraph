        ngm:financial-regulation,
        ngm:risk-management ;
    vc:slug "institutional-adoption" ;
    vc:sourceDomain "finance" ;
    vc:supports ngm:capital-markets,
        ngm:traditional-finance ;
    vc:uses ngm:distributed-ledger-technology,
        ngm:exchange-traded-fund,
        ngm:smart-contract .

ngm:interactive-proof-system a owl:Class ;
    rdfs:label "Interactive Proof System"@en ;
    rdfs:comment "An Interactive Proof System is a protocol in which a computationally powerful prover convinces a probabilistic, resource-bounded verifier of the truth of a statement through a sequence of message exchanges. It satisfies completeness, so true statements are accepted with high probability, and soundness, so false statements are rejected except with negligible probability. Interactive proofs generalise classical proofs and form the theoretical basis for zero-knowledge proofs and many cryptographic protocols."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:commitment-scheme ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptographic-protocol ],
        ngm:proof-system ;
    vc:bridgesTo ngm:zero-knowledge-proof ;
    vc:contrastsWith ngm:zero-knowledge-proof ;
    vc:enables ngm:zero-knowledge-proof,
        ngm:zk-snark ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:commitment-scheme ;
    vc:implements ngm:cryptographic-protocol ;
    vc:isPartOf ngm:proof-system ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:fiat-shamir-heuristic,
        ngm:proof-system ;
    vc:requires ngm:cryptographic-protocol ;
    vc:slug "interactive-proof-system" ;
    vc:sourceDomain "security" ;
    vc:supports ngm:zk-snark ;
    vc:uses ngm:commitment-scheme,
        ngm:fiat-shamir-heuristic .

ngm:internet-governance a owl:Class ;
    rdfs:label "Internet Governance"@en ;
    rdfs:comment "Internet Governance is the collective development and application of shared principles, norms, rules, decision-making procedures, and programmes that shape the evolution and use of the Internet. It spans technical coordination of identifiers and protocols, allocation of addresses, and policy debates over access, security, and rights, conducted through a multistakeholder model involving governments, the private sector, civil society, and the technical community. Internet governance balances global interoperability against competing claims of sovereignty, openness, and public interest."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:internet-protocol ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:standards-body ],
        ngm:digital-governance ;
    vc:bridgesTo ngm:data-sovereignty ;
    vc:dependsOn ngm:internet-protocol ;
    vc:enables ngm:interoperability ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:digital-governance,
        ngm:governance ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:cybersecurity,
        ngm:data-protection ;
    vc:requires ngm:internet-protocol,
        ngm:standards-body ;
    vc:slug "internet-governance" ;
    vc:sourceDomain "governance" ;
    vc:supports ngm:digital-rights ;
    vc:uses ngm:policy,
        ngm:regulation .

ngm:internet-infrastructure a owl:Class ;
    rdfs:label "Internet Infrastructure"@en ;
    rdfs:comment "Internet Infrastructure encompasses the networking protocols, distributed systems, edge computing platforms, content delivery networks, and cloud architectures that enable large-scale deployment, operation, and interconnection of digital services including AI workloads across global networks."@en ;
