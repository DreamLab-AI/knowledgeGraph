ngm:signature-aggregation a owl:Class ;
    rdfs:comment "Signature Aggregation is a cryptographic technique that combines multiple digital signatures over distinct or identical messages into a single compact signature that can be verified with one operation. It reduces on-chain storage and verification cost in blockchain systems where many parties sign, such as validator committees. Schemes such as BLS and Schnorr support aggregation, improving scalability and bandwidth efficiency for distributed consensus."@en ;
    rdfs:label "Signature Aggregation"@en ;
    rdfs:subClassOf ngm:digital-signature ;
