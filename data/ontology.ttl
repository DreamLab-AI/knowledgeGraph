ngm:scientific-research a owl:Class ;
    rdfs:label "Scientific Research"@en ;
    rdfs:comment "Scientific research is the systematic investigation of phenomena through observation, hypothesis, experiment, and analysis to produce reproducible knowledge. As an application domain for AI, it spans literature review, data analysis, modelling, and experiment automation. Modern AI systems and autonomous agents increasingly support researchers across the discovery, verification, and dissemination stages."@en ;
    rdfs:subClassOf ngm:ai-application ;
    skos:broader ngm:ai-application ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:agents,
        ngm:ai-companies ;
    vc:slug "scientific-research" ;
    vc:sourceDomain "ai" .

ngm:secure-boot a owl:Class ;
    rdfs:label "Secure Boot"@en ;
    rdfs:comment "Secure Boot is a platform security mechanism that verifies the cryptographic signature of each component loaded during system start-up, allowing only software trusted by an established chain of keys to execute. By validating firmware, bootloaders, and the operating system loader before handing over control, it prevents persistent low-level malware such as bootkits from running. Secure Boot establishes a hardware-anchored chain of trust from power-on through to the operating system."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptography ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:sha-256 ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:firmware ],
        ngm:security ;
    vc:bridgesTo ngm:supply-chain ;
    vc:contrastsWith ngm:authorization ;
    vc:dependsOn ngm:firmware,
        ngm:hardware ;
    vc:enables ngm:security ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:firmware ;
    vc:implements ngm:authentication ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:cryptography,
        ngm:firmware,
        ngm:hardware,
        ngm:security ;
    vc:requires ngm:cryptography,
        ngm:sha-256 ;
    vc:slug "secure-boot" ;
    vc:sourceDomain "security" ;
    vc:standardizedBy ngm:standards ;
    vc:supports ngm:infrastructure ;
    vc:uses ngm:cryptography .

ngm:security-operations-centre a owl:Class ;
    rdfs:label "Security Operations Centre"@en ;
    rdfs:comment "A Security Operations Centre (SOC) is a centralised function, combining people, processes and technology, that continuously monitors, detects, analyses and responds to cybersecurity threats across an organisation. Analysts triage alerts from telemetry sources, investigate incidents, and coordinate containment and remediation, typically aided by SIEM and SOAR platforms. The SOC is the operational hub of an enterprise security programme, providing the situational awareness and response capability needed to limit the impact of attacks."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:monitoring ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:siem ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:soar ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:threat-intelligence ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:telemetry ],
        ngm:cybersecurity ;
    vc:enables ngm:incident-response,
        ngm:threat-detection ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:siem,
        ngm:soar,
        ngm:threat-intelligence ;
    vc:implements ngm:security ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:cloud-security,
        ngm:data-breach ;
    vc:requires ngm:monitoring,
        ngm:telemetry ;
    vc:slug "security-operations-centre" ;
    vc:sourceDomain "security" ;
    vc:supports ngm:observability,
        ngm:zero-trust-architecture ;
    vc:uses ngm:anomaly-detection,
        ngm:vulnerability-management .

ngm:seg-wit a owl:Class ;
    rdfs:label "SegWit"@en ;
    rdfs:comment "Segregated Witness (SegWit) is a Bitcoin protocol upgrade (BIP141/BIP143/BIP144) that moves witness data (signatures and scripts) into a separate structure outside the traditional transaction serialisation, eliminating transaction malleability, introducing a weight-based block-size accounting system, and enabling second-layer protocols such as the Lightning Network and subsequent upgrades such as Taproot."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:soft-fork ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:bitcoin-script ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:witness-data ],
        ngm:bitcoin-protocol ;
    vc:bridgesTo ngm:layer-2-protocol,
        ngm:state-channel ;
    vc:contrastsWith ngm:bitcoin-proof-of-work-protocol-cash,
        ngm:block-size ;
    vc:dependsOn ngm:bitcoin-proof-of-work-protocol,
        ngm:unspent-transaction-output ;
    vc:enables ngm:atomic-swap,
        ngm:lightning-network,
        ngm:payment-channel,
        ngm:taproot ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:witness-data ;
    vc:isPartOf ngm:bitcoin-proof-of-work-protocol-improvement-proposals,
        ngm:bitcoin-protocol ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:blockchain-scalability,
        ngm:digital-signature,
        ngm:transaction-throughput ;
    vc:requires ngm:bitcoin-script,
        ngm:soft-fork ;
    vc:slug "seg-wit" ;
    vc:sourceDomain "blockchain" ;
    vc:standardizedBy ngm:bitcoin-proof-of-work-protocol-core ;
    vc:uses ngm:elliptic-curve-digital-signature-algorithm,
        ngm:merkle-tree .

ngm:selfish-mining a owl:Class ;
    rdfs:label "Selfish Mining"@en ;
    rdfs:comment "A strategic block-withholding attack in proof-of-work blockchains where a mining pool privately mines a secret chain and selectively publishes blocks to waste the computational work of honest miners, thereby earning a disproportionate share of block rewards relative to its hash-rate contribution. Selfish mining is profitable when the attacker controls more than ~33% of network hash-rate."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:private-blockchain ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:block ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:blockchain-network ],
        ngm:bc-protocol-and-consensus,
        ngm:blockchain-entity,
        ngm:network-component ;
    skos:broader ngm:bc-protocol-and-consensus ;
    vc:bridgesTo ngm:distributed-systems,
        ngm:game-theory,
        ngm:mechanism-design ;
    vc:contrastsWith ngm:consensus-mechanism,
        ngm:decentralization,
        ngm:proof-of-stake ;
    vc:dependsOn ngm:fork-choice-rule,
        ngm:proof-of-work ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:security ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:51-attack,
        ngm:bitcoin-proof-of-work-protocol-mining,
        ngm:double-spending,
        ngm:hash-rate,
        ngm:longest-chain-rule,
        ngm:mining-pool,
        ngm:nakamoto-consensus,
        ngm:proof-of-work ;
    vc:requires ngm:block,
        ngm:blockchain-network,
        ngm:private-blockchain ;
    vc:slug "selfish-mining" ;
    vc:sourceDomain "blockchain" .

ngm:specificity a owl:Class ;
    rdfs:label "Specificity"@en ;
    rdfs:comment "Specificity (also called the True Negative Rate or TNR) is the proportion of actual negative instances that a binary classifier or diagnostic test correctly identifies as negative, computed as TN / (TN + FP). It quantifies a model's ability to avoid false positives, complementing sensitivity (recall) in characterising the full operating behaviour of a classifier. Together with sensitivity, specificity defines the two axes of the Receiver Operating Characteristic (ROC) curve, enabling principled threshold selection across tasks ranging from medical diagnostics to spam filtering and anomaly detection."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:classification ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:confusion-matrix ],
        ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:bridgesTo ngm:fraud-detection,
        ngm:medical-diagnosis-ai ;
    vc:contrastsWith ngm:false-positive-rate,
        ngm:precision,
        ngm:sensitivity ;
    vc:enables ngm:anomaly-detection,
        ngm:roc-curve,
        ngm:threshold-selection ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:classifier-evaluation,
        ngm:model-evaluation ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:auc-roc,
        ngm:classification-metric,
        ngm:f1-score,
        ngm:recall,
        ngm:roc-curve ;
    vc:requires ngm:classification,
        ngm:confusion-matrix ;
    vc:slug "specificity" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:false-positive,
        ngm:true-negative .

ngm:spir-v a owl:Class ;
    rdfs:label "SPIR-V"@en ;
    rdfs:comment "SPIR-V is a binary intermediate representation for shaders and parallel-compute kernels standardised by the Khronos Group, used as the portable bytecode target for Vulkan, OpenCL, and OpenGL. High-level shading languages such as GLSL and HLSL compile to SPIR-V, which drivers then translate to native GPU instructions, decoupling source languages from hardware. It enables offline compilation, validation, and optimisation of graphics and compute programs across vendors."@en ;
    rdfs:subClassOf ngm:technical-standard ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:graphics-api,
        ngm:rendering-pipeline ;
    vc:slug "spir-v" ;
    vc:sourceDomain "infrastructure" .

ngm:stability-analysis a owl:Class ;
    rdfs:label "Stability Analysis"@en ;
    rdfs:comment "Stability analysis is the systematic mathematical investigation of whether a dynamical system — physical, computational, financial, or ecological — will remain bounded, return to equilibrium, or diverge when subjected to perturbations from an operating point. Classical techniques include Lyapunov stability theory, eigenvalue analysis of linearised systems, Bode and Nyquist frequency-domain methods, and Floquet theory for periodic systems. In AI, stability analysis extends to training dynamics, gradient flow, and the behaviour of neural networks under input distribution shifts."@en ;
    rdfs:subClassOf ngm:control-theory ;
    vc:enables ngm:financial-stability,
        ngm:model-predictive-control,
        ngm:robotic-control ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:control-system,
        ngm:robot-dynamics,
        ngm:training-instability ;
    vc:slug "stability-analysis" ;
    vc:sourceDomain "machine-learning" ;
    vc:uses ngm:optimization-algorithm,
        ngm:signal-processing,
        ngm:simulation .

ngm:stable-coins a owl:Class ;
    rdfs:label "Stable Coins"@en ;
    rdfs:comment "Stable Coins (stablecoins) are blockchain-native digital tokens engineered to maintain stable value relative to an external reference asset — most commonly the US dollar at 1:1 parity — through one of four primary stabilisation mechanisms: (i) fiat-collateralised custody, where off-chain reserves..."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:oracle-network ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:regulatory-licence ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:price-oracle ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
