ngm:fid-benchmark-protocol a owl:Class ;
    rdfs:label "FID Benchmark Protocol"@en ;
    rdfs:comment "The FID benchmark protocol is the standardised methodology for evaluating generative image models using the Fréchet Inception Distance, which compares the distribution of generated images with that of real images in the feature space of a pretrained Inception network. The protocol fixes the feature extractor, the number of samples, and preprocessing so that scores are comparable across models; lower FID indicates greater similarity to real data. It is the de facto standard for benchmarking GANs and diffusion models."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:probability-theory ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:feature-extraction ],
        ngm:benchmark,
        ngm:evaluation-metric ;
    vc:contrastsWith ngm:cmmd,
        ngm:inception-score ;
    vc:enables ngm:generative-model,
        ngm:image-synthesis,
        ngm:medical-image-synthesis,
        ngm:synthetic-data-generation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:clean-fid,
        ngm:feature-extraction,
        ngm:frechet-distance,
        ngm:inception-v3,
        ngm:precision-recall ;
    vc:implements ngm:frechet-distance,
        ngm:wasserstein-distance ;
    vc:qualityScore "0.9"^^xsd:float ;
    vc:relatedTo ngm:computer-vision,
        ngm:diffusion-models,
        ngm:frechet-audio-distance,
        ngm:frechet-video-distance,
        ngm:generative-adversarial-networks ;
    vc:requires ngm:convolutional-neural-networks,
        ngm:image-net,
        ngm:inception-v3,
        ngm:probability-theory ;
    vc:slug "fid-benchmark-protocol" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:standardizedBy ngm:cvpr,
        ngm:neur-ips ;
    vc:supports ngm:diffusion-models,
        ngm:generative-adversarial-networks,
        ngm:text-to-image,
        ngm:variational-autoencoder ;
    vc:uses ngm:clip-encoder,
        ngm:deep-learning,
        ngm:inception-v3,
        ngm:representation-learning .

