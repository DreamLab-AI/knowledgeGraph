ngm:algorithmic-accountability a owl:Class ;
    rdfs:label "Algorithmic Accountability"@en ;
    rdfs:comment "Algorithmic Accountability is a responsibility framework ensuring that AI systems and their developers are answerable for decisions, outcomes, and societal impacts produced by algorithmic processes. It encompasses mechanisms for redress, transparency, auditing, and oversight to prevent undue harm from automated decision-making."@en ;
