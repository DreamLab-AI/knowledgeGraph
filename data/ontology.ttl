ngm:consistency-checking a owl:Class ;
    rdfs:comment "Consistency checking is the process of verifying that a set of statements, data items or constraints contains no contradictions and that all derivable conclusions remain mutually compatible. In knowledge representation it confirms that an ontology or knowledge base admits at least one model, while in data systems it confirms that records satisfy declared integrity rules. The technique underpins trust in automated reasoning by rejecting configurations that would license arbitrary or unsound inferences."@en ;
    rdfs:label "Consistency Checking"@en ;
    rdfs:subClassOf ngm:verification ;
    rdfs:subClassOf _:r5396 ;
    rdfs:subClassOf _:r5397 ;
