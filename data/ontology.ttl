ngm:dao-treasury a owl:Class ;
    rdfs:label "Dao Treasury"@en ;
    rdfs:comment "A DAO treasury is the pool of on-chain assets collectively owned and governed by a decentralised autonomous organisation, typically held in smart contracts and controlled through member governance. It funds operations, grants and incentives, with disbursements authorised by token-weighted votes and executed by multisignature or programmatic controls. Treasury management balances runway, diversification and accountability without a central custodian."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:governance-token ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:multisig ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:smart-contract ],
        ngm:dao ;
    vc:enables ngm:staking ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:governance-token,
        ngm:multisig ;
    vc:isPartOf ngm:dao,
        ngm:decentralized-governance ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:token,
        ngm:tokenomics ;
    vc:requires ngm:smart-contract ;
    vc:slug "dao-treasury" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:decentralized-governance,
        ngm:liquidity ;
    vc:uses ngm:smart-contract,
        ngm:treasury-management .

ngm:data-curation a skos:Concept ;
    rdfs:label "Data Curation"@en .

ngm:data-exchange-format a owl:Class ;
    rdfs:label "Data Exchange Format"@en ;
    rdfs:comment "A data exchange format is an agreed structure and encoding for representing data so that it can be reliably transmitted, stored, and interpreted between independent systems. It defines syntax, data types, and often a schema, allowing a producer and a consumer that share no internal code to exchange information without loss of meaning. Common examples include JSON, XML, CSV, and binary formats such as Protocol Buffers, each trading off readability, compactness, and parsing speed."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:schema ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:schema ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:metadata ],
        ngm:data-format ;
    vc:bridgesTo ngm:interoperability ;
    vc:contrastsWith ngm:data-model ;
    vc:dependsOn ngm:data-serialization ;
    vc:enables ngm:api,
        ngm:interoperability ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:metadata,
        ngm:schema ;
    vc:implements ngm:data-serialization ;
    vc:isPartOf ngm:interoperability ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:data-standards,
        ngm:protocol-buffer ;
    vc:requires ngm:schema ;
    vc:slug "data-exchange-format" ;
    vc:sourceDomain "infrastructure" ;
    vc:standardizedBy ngm:standardization ;
    vc:supports ngm:api ;
    vc:uses ngm:json,
        ngm:xml .

ngm:data-lineage-tracking a owl:Class ;
    rdfs:label "Data Lineage Tracking"@en ;
    rdfs:comment "Data lineage tracking is the automated capture and maintenance of provenance metadata as data is created, transformed and moved across pipelines and platforms. It instruments transformations and queries to build a continuously updated lineage graph rather than a static map. Often expressed using provenance vocabularies such as PROV-O, it underpins reproducibility, trust and governance in data fabric architectures."@en ;
    rdfs:subClassOf ngm:infra-data-management ;
    skos:broader ngm:infra-data-management ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:data-fabric-architecture,
        ngm:provenance-ontology-prov-o ;
    vc:slug "data-lineage-tracking" ;
    vc:sourceDomain "data" .

ngm:data-mapping a owl:Class ;
    rdfs:label "Data Mapping"@en ;
    rdfs:comment "Data mapping is the process of defining correspondences between fields, elements, or schemas of a source data structure and those of a target, specifying how each attribute is matched, transformed, or combined during movement between systems. It is foundational to data integration, migration, and interoperability, guiding extract-transform-load pipelines and message translation so that semantically equivalent information aligns across heterogeneous models. In privacy and governance contexts, data mapping also denotes the cataloguing of where personal data resides and how it flows, which is a prerequisite for lineage tracking and regulatory compliance."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-catalogue ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-transformation ],
        ngm:data-integration ;
    vc:dependsOn ngm:data-modelling,
        ngm:schema-mapping ;
    vc:enables ngm:data-lineage,
        ngm:interoperability ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:data-integration ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:data-protection ;
    vc:requires ngm:data-catalogue,
        ngm:data-transformation ;
    vc:slug "data-mapping" ;
    vc:sourceDomain "governance" ;
    vc:standardizedBy ngm:iso-20022 ;
    vc:supports ngm:data-governance,
        ngm:regulatory-compliance ;
    vc:uses ngm:etl-pipeline .

ngm:data-marketplace a skos:Concept ;
    rdfs:label "Data Marketplace"@en .

ngm:data-silo a owl:Class ;
    rdfs:label "Data Silo"@en ;
    rdfs:comment "A data silo is an isolated repository of data controlled by one team, system, or department and not readily accessible to the rest of an organisation. Silos arise from fragmented tooling, organisational boundaries, and incompatible formats, producing duplicated, inconsistent, and underused data. They are the principal obstacle that data integration, governance, and interoperability efforts seek to dismantle."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-quality ],
        ngm:data-management ;
    vc:bridgesTo ngm:interoperability ;
    vc:contrastsWith ngm:data-fabric,
        ngm:data-integration,
        ngm:data-mesh ;
    vc:dependsOn ngm:data-management ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:data-management ;
    vc:isPartOf ngm:data-management ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:data-governance,
        ngm:enterprise-data ;
    vc:requires ngm:data-quality ;
    vc:slug "data-silo" ;
    vc:sourceDomain "data" ;
    vc:supports ngm:data-warehouse ;
    vc:uses ngm:metadata-management .

ngm:dbpedia a owl:Class ;
    rdfs:label "DBpedia"@en ;
    rdfs:comment "DBpedia is a community project that extracts structured information from Wikipedia and publishes it as an interlinked, openly licensed knowledge graph in RDF. It exposes millions of entities through a SPARQL endpoint and dereferenceable URIs, forming a central hub of the Linked Open Data cloud. It is widely used as background knowledge for knowledge-graph construction, entity linking and semantic search."@en ;
    rdfs:subClassOf ngm:infra-data-management ;
    skos:broader ngm:infra-data-management ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:knowledge-graphing ;
    vc:slug "dbpedia" ;
    vc:sourceDomain "data" .

ngm:debugging a owl:Class ;
    rdfs:label "Debugging"@en ;
    rdfs:comment "Debugging is the systematic process of locating, diagnosing and resolving defects in software so that it behaves as intended. It typically involves reproducing the fault, observing program state through breakpoints, logging and runtime inspection, forming hypotheses about the cause, and verifying a fix. Debugging spans interactive use of debuggers, analysis of stack traces and logs, and reasoning about concurrency and integration boundaries. It is a core software development activity complementary to, but distinct from, automated testing."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:runtime-environment ],
        ngm:software-development ;
    vc:bridgesTo ngm:devops ;
    vc:contrastsWith ngm:testing ;
    vc:dependsOn ngm:observability ;
    vc:enables ngm:fault-tolerance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:software-testing ;
    vc:isPartOf ngm:software-engineering ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:reliability,
        ngm:software-testing,
        ngm:version-control ;
    vc:requires ngm:runtime-environment ;
    vc:slug "debugging" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:reliability,
        ngm:software-engineering ;
    vc:uses ngm:observability,
        ngm:runtime-environment .

ngm:decentralised-ai a owl:Class ;
    rdfs:label "Decentralised Ai"@en ;
    rdfs:comment "Decentralised AI refers to artificial intelligence systems whose training, inference, data provenance, or governance are distributed across many independent participants rather than controlled by a single centralised entity. It commonly combines machine-learning techniques such as federated learning with blockchain or peer-to-peer infrastructure to coordinate compute, verify contributions, and align incentives through crypto-economic mechanisms. The goal is to reduce single points of control and failure, preserve data sovereignty, and enable open marketplaces for models, data, and compute."@en ;
    rdfs:subClassOf ngm:blockchain ;
    skos:broader ngm:blockchain ;
    vc:bridgesTo ngm:artificial-intelligence,
        ngm:machine-learning ;
    vc:dependsOn ngm:distributed-ledger,
        ngm:tokenization ;
    vc:enables ngm:data-sovereignty,
        ngm:edge-ai,
        ngm:privacy-preserving-machine-learning ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:implements ngm:decentralised-identity ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:blockchain-consensus,
        ngm:proof-of-stake ;
    vc:slug "decentralised-ai" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:web3 ;
    vc:uses ngm:federated-learning,
        ngm:peer-to-peer-network,
        ngm:smart-contract .

ngm:decentralised-network a owl:Class ;
    rdfs:label "Decentralised Network"@en ;
    rdfs:comment "A Decentralised Network is a network architecture in which control, data and decision-making are distributed across many independent nodes rather than concentrated in a central authority or server. Nodes communicate peer-to-peer, share responsibility for routing, storage and consensus, and the network continues to operate even when individual nodes fail or leave. This topology improves resilience, censorship resistance and fault tolerance at the cost of greater coordination complexity."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:consensus-mechanism ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:network-protocol ],
        ngm:distributed-systems ;
    vc:bridgesTo ngm:blockchain-network,
        ngm:peer-to-peer-network ;
    vc:contrastsWith ngm:federation ;
    vc:dependsOn ngm:node ;
    vc:enables ngm:censorship-resistance,
        ngm:decentralization,
        ngm:fault-tolerance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:distributed-systems ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:distributed-hash-table,
        ngm:federation,
        ngm:ipfs ;
    vc:requires ngm:consensus-mechanism,
        ngm:network-protocol ;
    vc:slug "decentralised-network" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:distributed-ledger,
        ngm:resilience ;
    vc:uses ngm:gossip-protocol,
        ngm:overlay-network .

ngm:demographic-parity a owl:Class ;
    rdfs:label "Demographic Parity"@en ;
    rdfs:comment "Demographic parity is a group-fairness criterion requiring that a model's positive prediction rate be equal across protected groups, independent of the true label. Also called statistical parity, it is satisfied when the probability of a favourable decision does not depend on membership of a protected attribute such as gender or ethnicity. It is one of several formal, often mutually incompatible, definitions of algorithmic fairness."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:model-evaluation ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:classification ],
        ngm:algorithmic-fairness ;
    vc:bridgesTo ngm:disparate-impact ;
    vc:contrastsWith ngm:accuracy ;
    vc:dependsOn ngm:classification ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:classification ;
    vc:implements ngm:algorithmic-fairness ;
    vc:isPartOf ngm:fairness ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:bias,
        ngm:disparate-impact,
        ngm:responsible-ai,
        ngm:transparency ;
    vc:requires ngm:model-evaluation ;
    vc:slug "demographic-parity" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:fairness ;
    vc:uses ngm:model-evaluation .

ngm:design-pattern a skos:Concept ;
    rdfs:label "Design Pattern"@en .

ngm:development-platform a owl:Class ;
    rdfs:label "Development Platform"@en ;
    rdfs:comment "A Development Platform is an integrated suite of tools, APIs, runtimes, and infrastructure services that enables engineers and creators to build, test, and deploy applications. In spatial computing contexts, development platforms provide SDKs for XR hardware, scene-graph editors, physics engines, and asset pipelines supporting OpenXR and Universal Scene Description (USD). They abstract hardware heterogeneity and supply governance tooling for collaborative multi-stakeholder development."@en ;
    rdfs:subClassOf ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:dependsOn ngm:digital-infrastructure ;
    vc:enables ngm:digital-twin,
        ngm:spatial-computing ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:slug "development-platform" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:collaboration,
        ngm:digital-fabrication ;
    vc:uses ngm:computer-vision,
        ngm:open-xr .

ngm:diffusion-policy a owl:Class ;
    rdfs:label "Diffusion Policy"@en ;
    rdfs:comment "Diffusion Policy is a class of robot learning algorithms that represent robot action sequences as the output of a conditional denoising diffusion process, treating action prediction as iterative noise removal conditioned on sensor observations rather than as direct regression or classification. By leveraging the expressiveness of diffusion models to capture multi-modal action distributions, Diffusion Policy can represent one-to-many mappings from observation to action — a critical capability for dexterous manipulation tasks where multiple valid action trajectories exist. The approach, introduced by Chi et al. (2023), achieves state-of-the-art performance on imitation learning benchmarks and generalises across diverse manipulation settings."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:proprioception ],
        ngm:robot-learning ;
    vc:bridgesTo ngm:generative-ai,
        ngm:vision-language-model ;
    vc:contrastsWith ngm:gaussian-mixture-model,
        ngm:reinforcement-learning ;
    vc:enables ngm:dexterous-manipulation,
        ngm:embodied-ai,
        ngm:robot-control,
        ngm:robot-manipulation,
        ngm:teleoperation ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:implements ngm:behavioural-cloning ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:end-effector,
        ngm:score-based-generative-model ;
    vc:requires ngm:demonstration-data,
        ngm:proprioception ;
    vc:slug "diffusion-policy" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:convolutional-neural-network,
        ngm:denoising-score-matching,
        ngm:diffusion-model,
        ngm:flow-matching,
        ngm:imitation-learning,
        ngm:transformer-architecture .

ngm:digital-asset-infrastructure a owl:Class ;
    rdfs:label "Digital Asset Infrastructure"@en ;
    rdfs:comment "The foundational technology stack comprising blockchain networks, node infrastructure, custody systems, key management solutions, and integration APIs that enable secure creation, storage, transfer, and management of digital assets across institutional and retail applications."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
