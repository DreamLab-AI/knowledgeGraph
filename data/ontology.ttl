ngm:scaling-laws a owl:Class ;
    rdfs:label "Scaling Laws"@en ;
    rdfs:comment "Scaling Laws are empirical power-law relationships describing how the performance of neural networks — typically measured as held-out cross-entropy loss — varies predictably as a function of model parameters (N), training data volume (D), and total compute budget (C). Foundational Kaplan et al. (2020) work established smooth, predictable loss curves across many orders of magnitude, while Hoffmann et al. (2022) Chinchilla analyses refined optimal compute allocation to roughly equal scaling of model size and training tokens. These relationships guide architectural decisions, compute budgeting, and capability forecasting for large foundation models. Scaling laws have since been extended beyond language modelling to vision transformers, multimodal architectures, and reinforcement learning from human feedback."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:parameter-count ],
        ngm:ai-research-area ;
    skos:broader ngm:ai-research-area ;
    vc:bridgesTo ngm:ai-hardware,
        ngm:ai-safety ;
    vc:contrastsWith ngm:emergent-capabilities ;
    vc:dependsOn ngm:cross-entropy-loss,
        ngm:model-training,
        ngm:training-data ;
    vc:enables ngm:capability-forecasting,
        ngm:large-language-models,
        ngm:pre-training ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:parameter-count ;
    vc:qualityScore "0.73"^^xsd:float ;
    vc:relatedTo ngm:model-compression ;
    vc:slug "scaling-laws" ;
    vc:sourceDomain "machine-learning" ;
    vc:supports ngm:foundation-model,
        ngm:neural-architecture-search ;
    vc:uses ngm:neural-network,
        ngm:transformer-architecture .

ngm:smart-contract-execution a owl:Class ;
    rdfs:label "Smart Contract Execution"@en ;
    rdfs:comment "Smart contract execution is the deterministic, on-chain processing of immutable bytecode deployed at a specific blockchain address, triggered by an inbound transaction and evaluated identically by every validating node in the network. Execution occurs within a sandboxed virtual machine—such as the Ethereum Virtual Machine (EVM) or Solana Virtual Machine (SVM)—which enforces gas or fee metering to bound computation costs, maintains state isolation, and guarantees identical outputs across all nodes given the same inputs and world state. The execution model encompasses transaction ingestion, opcode interpretation, state transition application, event emission, and atomicity enforcement, with failed executions reverting all state changes. Smart contract execution underpins trustless multi-party agreements, decentralised finance protocols, non-fungible token operations, cross-chain messaging, and decentralised autonomous organisations without reliance on a central intermediary."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:consensus-mechanism ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gas ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:blockchain-node ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptographic-signature ],
        ngm:bc-protocol-and-consensus ;
    skos:broader ngm:bc-protocol-and-consensus ;
    vc:bridgesTo ngm:decentralised-ai-inference,
        ngm:trusted-execution-environment,
        ngm:zero-knowledge-proof ;
    vc:contrastsWith ngm:traditional-contract ;
    vc:dependsOn ngm:distributed-ledger,
        ngm:merkle-tree,
        ngm:state-machine ;
    vc:enables ngm:cross-chain-messaging,
        ngm:decentralised-autonomous-organisation,
        ngm:decentralised-finance,
        ngm:non-fungible-token,
        ngm:token-transfer ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:eip-1559,
        ngm:solidity ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:inter-blockchain-communication,
        ngm:mev,
        ngm:smart-contract-audit ;
    vc:requires ngm:blockchain-node,
        ngm:consensus-mechanism,
        ngm:cryptographic-signature,
        ngm:gas ;
    vc:slug "smart-contract-execution" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:formal-verification,
        ngm:layer-2-scaling,
        ngm:oracle-network ;
    vc:uses ngm:application-binary-interface,
        ngm:blockchain-transaction,
        ngm:bytecode,
        ngm:ethereum-smart-contract-platform-virtual-machine,
