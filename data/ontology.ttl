            owl:someValuesFrom ngm:rate-limiting ],
        ngm:reverse-proxy ;
    vc:dependsOn ngm:kubernetes ;
    vc:enables ngm:load-balancing,
        ngm:traffic-management ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:circuit-breaker,
