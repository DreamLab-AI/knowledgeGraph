ngm:cosmos a owl:Class ;
    rdfs:label "Cosmos"@en ;
    rdfs:comment "Cosmos is an ecosystem of sovereign, application-specific blockchains that interoperate through the Inter-Blockchain Communication (IBC) protocol, coordinated by a central hub (the Cosmos Hub, secured by the ATOM staking token) and constructed using the Cosmos SDK, a modular Go framework for building proof-of-stake chains. Each chain in the ecosystem runs the CometBFT (formerly Tendermint BFT) consensus engine, which provides instant deterministic finality and enables IBC light-client proofs across trust boundaries without centralised bridges. The architecture decouples application logic from consensus, permitting developers to optimise validator sets, fee markets, and governance parameters independently while participating in a shared interoperability fabric often described as the Internet of Blockchains."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:cosmos-sdk ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:cosmos-ibc ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:tendermint ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:proof-of-stake ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:validator-node ],
        ngm:blockchain-network ;
    vc:bridgesTo ngm:data-availability,
        ngm:modular-blockchain ;
    vc:contrastsWith ngm:ethereum,
        ngm:polkadot,
        ngm:rollup ;
    vc:enables ngm:blockchain-interoperability,
        ngm:cross-chain-asset-transfer,
        ngm:cross-chain-interoperability,
        ngm:decentralised-finance,
        ngm:interchain-accounts ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:cosmos-ibc,
        ngm:cosmos-sdk ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:application-specific-blockchain,
        ngm:distributed-ledger-technology,
        ngm:liquid-staking ;
    vc:requires ngm:proof-of-stake,
        ngm:tendermint,
        ngm:validator-node ;
    vc:slug "cosmos" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:deterministic-finality,
        ngm:light-client,
        ngm:on-chain-governance,
        ngm:tendermint-consensus .

ngm:cross-chain-asset-transfer a owl:Class ;
    rdfs:label "Cross Chain Asset Transfer"@en ;
    rdfs:comment "Cross-chain asset transfer is the cryptographic and protocol-level process of moving digital assets — cryptocurrencies, fungible tokens, or non-fungible tokens — from one blockchain network to a distinct, independent blockchain network while preserving the asset's economic properties and enforcing integrity guarantees across the transfer. Because independent blockchains maintain no shared global state, protocols must ensure that an asset locked or burned on the source chain is atomically minted or released on the destination chain, preventing double-spend and maintaining supply conservation. Implementations range from hash time-locked contracts (HTLCs) and lock-and-mint bridge contracts overseen by validator committees to native inter-blockchain communication protocols (IBC) and zero-knowledge proof-based verification bridges that eliminate trusted attestors entirely."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptographic-proof ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:consensus-mechanism ],
        ngm:cross-chain-interoperability ;
    vc:bridgesTo ngm:decentralised-finance,
        ngm:digital-asset-regulation ;
    vc:contrastsWith ngm:centralised-exchange,
        ngm:wrapped-token ;
    vc:enables ngm:blockchain-interoperability,
        ngm:cross-chain-liquidity,
        ngm:de-fi,
        ngm:multi-chain-ecosystem,
        ngm:wrapped-token ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:blockchain-security,
        ngm:cross-chain-messaging,
        ngm:layer-2-scaling,
        ngm:rollup,
        ngm:sidechain,
        ngm:token-standard ;
    vc:requires ngm:consensus-mechanism,
        ngm:cryptographic-proof,
        ngm:validator-network ;
    vc:slug "cross-chain-asset-transfer" ;
    vc:sourceDomain "blockchain" ;
    vc:standardizedBy ngm:cosmos-ibc,
        ngm:polkadot-xcm ;
    vc:uses ngm:atomic-swap,
        ngm:blockchain-protocol,
        ngm:cross-chain-bridge,
        ngm:hash-time-locked-contract,
        ngm:light-client,
        ngm:smart-contract,
        ngm:zero-knowledge-proof .

ngm:customer-due-diligence a owl:Class ;
    rdfs:label "Customer Due Diligence"@en ;
    rdfs:comment "Customer due diligence (CDD) is the set of regulated procedures by which a financial institution or obliged entity identifies and verifies a customer, understands the nature and purpose of the business relationship, and assesses the money-laundering and terrorist-financing risk it poses. It encompasses identity verification, beneficial-ownership identification, screening against sanctions and politically exposed person lists, and ongoing monitoring of transactions and risk profile. CDD is a core obligation of anti-money-laundering regimes, calibrated through a risk-based approach that escalates to enhanced due diligence for higher-risk customers and permits simplified measures for lower-risk ones."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:beneficial-ownership ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:sanctions-screening ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:identity-verification ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:identity-verification ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:enhanced-due-diligence ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:risk-based-approach ],
        ngm:know-your-customer ;
    vc:bridgesTo ngm:digital-identity ;
    vc:contrastsWith ngm:enhanced-due-diligence ;
    vc:enables ngm:transaction-monitoring ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:beneficial-ownership,
        ngm:enhanced-due-diligence,
        ngm:identity-verification ;
    vc:isPartOf ngm:anti-money-laundering ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:anti-money-laundering,
        ngm:transaction-monitoring ;
    vc:requires ngm:identity-verification,
        ngm:risk-based-approach,
        ngm:sanctions-screening ;
    vc:slug "customer-due-diligence" ;
    vc:sourceDomain "finance" ;
    vc:standardizedBy ngm:fatf ;
    vc:supports ngm:regulatory-compliance ;
    vc:uses ngm:politically-exposed-person .

ngm:customer-service-automation a owl:Class ;
    rdfs:label "Customer Service Automation"@en ;
    rdfs:comment "Customer Service Automation (CSA) is the systematic application of artificial intelligence, rule-based logic, and workflow orchestration to resolve customer enquiries, execute transactions, and manage service interactions without requiring continuous human agent involvement. It integrates conversational AI, intent classification, sentiment analysis, and retrieval-augmented generation with CRM platforms, ticketing systems, and enterprise knowledge bases to deliver contextually accurate, personalised responses at scale. Modern CSA pipelines increasingly use large language models as the generation backbone, enabling coherent multi-turn dialogue capable of handling nuanced, composite, or cross-channel queries. Effectiveness is measured by containment rate, first-contact resolution, and customer satisfaction metrics, with human-in-the-loop escalation pathways ensuring quality and regulatory compliance."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:chatbot ],
        ngm:ai-application ;
    skos:broader ngm:ai-application ;
    vc:bridgesTo ngm:business-process-automation ;
    vc:contrastsWith ngm:automation,
        ngm:human-agent-assistance ;
    vc:dependsOn ngm:customer-relationship-management,
        ngm:dialogue-management,
        ngm:knowledge-base,
        ngm:natural-language-understanding,
        ngm:retrieval-augmented-generation ;
    vc:enables ngm:intelligent-ticket-routing,
        ngm:omnichannel,
        ngm:self-service-portal ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:chatbot,
        ngm:escalation-management,
        ngm:interactive-voice-response,
        ngm:virtual-agent ;
    vc:qualityScore "0.9"^^xsd:float ;
    vc:relatedTo ngm:ai-agent,
        ngm:customer-support-automation,
        ngm:robotic-process-automation,
        ngm:workflow-automation ;
    vc:slug "customer-service-automation" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:active-learning,
        ngm:agentic-rag,
        ngm:conversational-ai,
