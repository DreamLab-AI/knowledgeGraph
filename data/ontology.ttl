ngm:iot-sensor a owl:Class ;
    rdfs:comment "An IoT sensor is a networked device that measures physical or environmental conditions — such as temperature, humidity, location, vibration or light — and transmits the resulting data over a communications network to back-end systems for monitoring and analysis. By embedding sensing and connectivity into assets and environments, IoT sensors provide continuous, real-time visibility that supports automation and data-driven decisions. In supply chains they are central to cold-chain monitoring, asset tracking and condition-based maintenance."@en ;
    rdfs:label "IoT Sensor"@en ;
    rdfs:subClassOf ngm:sensor ;
    rdfs:subClassOf _:r12884 ;
