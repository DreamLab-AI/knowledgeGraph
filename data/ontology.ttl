    vc:slug "north-england-innovation-corridor" ;
    vc:sourceDomain "infrastructure" .

ngm:ollama a owl:Class ;
    rdfs:label "ollama"@en ;
    rdfs:comment "An open-source runtime and model management platform that allows users to download, serve, and interact with large language models locally on macOS, Windows, and Linux. Ollama provides an OpenAI-compatible REST API, enabling integration with tools such as Open WebUI, ComfyUI, and agent frameworks, making local LLM inference accessible without cloud dependencies."@en ;
    rdfs:subClassOf ngm:ai-infrastructure ;
    vc:enables ngm:function-calling,
