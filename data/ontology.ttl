ngm:disruptive-technology a owl:Class ;
    rdfs:label "Disruptive Technology"@en ;
    rdfs:comment "Disruptive Technology refers to innovations that initially address simple or underserved applications with more accessible and affordable solutions, then move upmarket to displace established incumbents and redefine entire industries. Following Christensen's framework, disruptive technologies succeed not through direct head-on competition but by creating new value networks and business models that incumbents cannot easily replicate. Contemporary examples include generative AI, blockchain, edge computing, and spatial computing."@en ;
    rdfs:subClassOf ngm:infra-computing-and-cloud ;
    skos:broader ngm:infra-computing-and-cloud ;
    vc:contrastsWith ngm:technology-stack ;
    vc:enables ngm:edge-computing,
        ngm:generative-ai,
        ngm:internet-of-things,
        ngm:machine-learning ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:disruptive-tech-domain ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:blockchain,
        ngm:digital-transformation,
        ngm:disruption,
        ngm:technology-adoption ;
    vc:slug "disruptive-technology" ;
    vc:sourceDomain "infrastructure" .

ngm:economic-security a owl:Class ;
    rdfs:label "Economic Security"@en ;
