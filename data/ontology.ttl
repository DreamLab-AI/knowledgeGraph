        ngm:smart-contract,
        ngm:verifiable-credential ;
    vc:contrastsWith ngm:password-based-authentication ;
    vc:enables ngm:blockchain,
        ngm:content-authentication,
        ngm:decentralised-identity,
        ngm:non-repudiation,
        ngm:trusted-execution-environment ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:implements ngm:certificate-authority,
