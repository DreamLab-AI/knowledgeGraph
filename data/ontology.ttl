        ngm:token-weighted-voting ;
    vc:uses ngm:ipfs,
        ngm:web3-wallet .

ngm:technical-debt a owl:Class ;
    rdfs:label "Technical Debt"@en ;
    rdfs:comment "Technical debt is the implied future cost incurred when a software team chooses an expedient solution over a better but slower approach, accruing rework that must eventually be paid down through refactoring. Like financial debt it carries interest: the longer suboptimal code persists, the more effort future changes require. Managing it involves making the debt visible, prioritising repayment, and balancing delivery speed against long-term maintainability."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:project-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:software-architecture ],
        ngm:software-engineering ;
    vc:bridgesTo ngm:devops ;
    vc:contrastsWith ngm:software-testing ;
    vc:dependsOn ngm:software-development ;
    vc:enables ngm:continuous-delivery ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:agile-software-development,
        ngm:continuous-integration,
        ngm:software-engineering ;
    vc:requires ngm:project-management,
        ngm:software-architecture ;
    vc:slug "technical-debt" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:software-engineering ;
    vc:uses ngm:code-review,
        ngm:quality-assurance .

ngm:temporal-difference-learning a owl:Class ;
    rdfs:label "Temporal Difference Learning"@en ;
    rdfs:comment "Temporal difference (TD) learning is a class of model-free reinforcement learning methods that estimate value functions by bootstrapping: each value estimate is updated towards a target composed of the immediate reward plus the discounted estimate of the successor state, rather than waiting for a full episode return. The TD error, the difference between the bootstrapped target and the current estimate, drives incremental updates and underpins algorithms such as TD(0), TD(lambda), SARSA, and Q-learning. By combining the sampling of Monte Carlo methods with the bootstrapping of dynamic programming, TD learning enables online, incremental learning from incomplete sequences."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:reward-signal ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:value-function ],
        ngm:reinforcement-learning ;
    vc:contrastsWith ngm:monte-carlo-methods ;
    vc:dependsOn ngm:reward-signal ;
    vc:enables ngm:deep-learning,
        ngm:policy-gradient ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:reward-signal,
        ngm:value-function ;
    vc:implements ngm:q-learning,
        ngm:sarsa ;
    vc:isPartOf ngm:reinforcement-learning ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:bellman-equation,
