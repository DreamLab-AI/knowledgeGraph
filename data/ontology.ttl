ngm:cloud-infrastructure a owl:Class ;
    rdfs:label "Cloud Infrastructure"@en ;
    rdfs:comment "Cloud infrastructure is a computing model that provides on-demand access to virtualized computing resources including servers, storage, networking, and platform services delivered over the internet, enabling organizations to provision and scale IT resources dynamically through IaaS, PaaS, and SaaS service models without managing physical hardware."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:virtualisation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:network-connectivity ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:virtual-machine ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:object-storage ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:identity-and-access-management ],
        ngm:infra-computing-and-cloud ;
