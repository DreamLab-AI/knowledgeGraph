ngm:versioning-system a owl:Class ;
    rdfs:comment "A versioning system is a mechanism that tracks, identifies and manages successive states of an artefact such as code, data, documents or taxonomy entries over time. It records changes, supports retrieval of historical versions, and resolves concurrent edits, enabling reproducibility, auditability and rollback. In curation and registry contexts it ensures controlled evolution of records while preserving provenance."@en ;
    rdfs:label "Versioning System"@en ;
    rdfs:subClassOf ngm:data-management ;
