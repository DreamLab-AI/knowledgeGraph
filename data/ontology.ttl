ngm:decentralized-storage a owl:Class ;
    rdfs:label "Decentralized Storage"@en ;
    rdfs:comment "A distributed storage infrastructure that distributes data across peer-to-peer networks rather than centralised data centres, enabling data persistence, redundancy, and access without single points of failure, often incentivised by cryptographic token mechanisms."@en ;
