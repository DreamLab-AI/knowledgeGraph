            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:question-answering ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:machine-learning-domain ],
        ngm:artificial-intelligence-domain ;
    vc:enables ngm:conversational-interfaces,
        ngm:document-understanding,
        ngm:information-retrieval-domain ;
