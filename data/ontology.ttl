    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:decentralization,
        ngm:multi-agent-systems,
        ngm:robotics ;
    vc:slug "stigmergy" ;
    vc:sourceDomain "robotics" .

