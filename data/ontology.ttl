ngm:cultural-provenance-record a owl:Class ;
    rdfs:label "Cultural Provenance Record"@en ;
    rdfs:comment "A structured metadata object that documents the origin, ownership history, authenticity verification, and cultural context of cultural artifacts, artworks, or digital cultural assets to establish legitimacy and preserve heritage lineage."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:metadata-schema ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:artifact-metadata ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:blockchain-ledger ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:digital-signature ],
        ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:enables ngm:authenticity-certification,
        ngm:cultural-heritage-tracking,
        ngm:ownership-transfer,
        ngm:provenance-verification ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:artifact-metadata,
        ngm:authentication-record,
        ngm:condition-report,
        ngm:cultural-context,
        ngm:ownership-chain ;
    vc:isPartOf ngm:cultural-heritage-management-system,
        ngm:museum-information-system ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:blockchain-ledger,
        ngm:conservation-database,
        ngm:digital-signature,
        ngm:metadata-schema ;
    vc:slug "cultural-provenance-record" ;
    vc:sourceDomain "spatial-computing" .

