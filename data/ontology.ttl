# Large Language Models
artificial-intelligence:LargeLanguageModel rdf:type owl:Class ;
    rdfs:subClassOf artificial-intelligence:FoundationModels ;
    rdfs:subClassOf artificial-intelligence:NeuralNetwork ;
    rdfs:subClassOf artificial-intelligence:DeepLearning ;
    rdfs:subClassOf artificial-intelligence:MachineLearning ;
    rdfs:label "Large Language Models"@en ;
    rdfs:comment "Large Language Models (LLMs) are Foundation Models with billions to trillions of parameters trained on massive text corpora using Transformer architectures and Self-Supervised Learning, capable of performing diverse Natural Language Processing tasks through Few-Shot Learning, Zero-Shot Learning, and Prompt Engineering. LLMs represent a paradigm shift in Artificial Intelligence, demonstrating emergent capabilities in reasoning, code generation, multilingual understanding, and complex task decomposition."@en ;
    skos:prefLabel "Large Language Models"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:artificial-intelligence:large-language-models" ;
    owl:sameAs <urn:visionclaw:concept:artificial-intelligence:large-language-models> ;
