        ngm:web-rtc,
        ngm:web-socket .

ngm:state-space-representation a owl:Class ;
    rdfs:label "State Space Representation"@en ;
    rdfs:comment "State space representation is a mathematical model that describes a dynamical system through a set of state variables, capturing all information needed to determine the system's future behaviour given its inputs. It expresses the system as first-order differential or difference equations relating states, inputs and outputs, typically in matrix form. The formulation underpins modern control, estimation, planning and search by providing a compact, computable description of the system over time."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:motion-model ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:motion-model ],
        ngm:dynamical-systems-theory ;
    vc:bridgesTo ngm:robotics ;
    vc:contrastsWith ngm:search-algorithms ;
    vc:dependsOn ngm:dynamical-systems-theory ;
    vc:enables ngm:closed-loop-control,
        ngm:model-predictive-control,
        ngm:optimal-control ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:motion-model ;
    vc:isPartOf ngm:dynamical-systems-theory ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:markov-decision-process,
        ngm:optimal-control ;
    vc:requires ngm:motion-model ;
    vc:slug "state-space-representation" ;
    vc:sourceDomain "robotics" ;
    vc:supports ngm:motion-planning,
        ngm:path-planning,
        ngm:planning ;
    vc:uses ngm:kalman-filter .

ngm:statistical-modelling a owl:Class ;
    rdfs:label "Statistical Modelling"@en ;
    rdfs:comment "Statistical modelling is the practice of representing data-generating processes with mathematical structures built on probability theory, in order to describe relationships, quantify uncertainty, test hypotheses, and make inferences or predictions. It encompasses approaches such as regression, generalised linear models, time-series models, and Bayesian methods, emphasising interpretable parameters and explicit assumptions. It provides the formal foundation on which much of machine learning and data analysis is built."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-quality ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:feature-engineering ],
        ngm:data-analysis ;
    vc:contrastsWith ngm:deep-learning ;
    vc:dependsOn ngm:probability-theory ;
    vc:enables ngm:anomaly-detection,
        ngm:predictive-analytics ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:isPartOf ngm:data-analysis ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:bayesian-inference,
        ngm:predictive-analytics,
        ngm:probability-theory ;
    vc:requires ngm:data-quality,
        ngm:feature-engineering ;
    vc:slug "statistical-modelling" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:machine-learning,
        ngm:supervised-learning ;
    vc:uses ngm:bayesian-inference,
        ngm:time-series-analysis .

ngm:storage-layer a owl:Class ;
    rdfs:label "Storage Layer"@en ;
    rdfs:comment "Hardware and software infrastructure responsible for persistent retention, retrieval, and management of data and digital assets across distributed systems."@en ;
