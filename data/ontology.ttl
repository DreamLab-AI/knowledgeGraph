    vc:relatedTo ngm:ai-infrastructure ;
    vc:slug "asynchronous-communication" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:edge-computing,
        ngm:parallel-processing ;
    vc:uses ngm:event-driven-architecture .

ngm:authorisation a owl:Class ;
    rdfs:label "Authorisation"@en ;
    rdfs:comment "Authorisation is the process of determining and enforcing whether an authenticated principal—user, service, or device—has the right to perform a requested action on a protected resource. It operates downstream of authentication, translating verified identity claims into permitted operations according to configured policies. Modern authorisation frameworks encompass role-based, attribute-based, and policy-based access control models. Robust authorisation design underpins compliance, auditability, and the principle of least privilege across digital systems."@en ;
    rdfs:subClassOf ngm:security ;
    vc:enables ngm:audit-trail,
        ngm:compliance-monitoring,
        ngm:privacy-controls ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:access-control,
        ngm:authentication,
        ngm:identity-management ;
    vc:slug "authorisation" ;
    vc:sourceDomain "security" ;
    vc:uses ngm:access-control-system,
        ngm:compliance-framework .

ngm:bitcoin-script a owl:Class ;
    rdfs:label "Bitcoin Script"@en ;
    rdfs:comment "Bitcoin Script is the non-Turing-complete, stack-based scripting language embedded in every Bitcoin transaction that defines the conditions under which output funds may be spent. It consists of a constrained set of opcodes operating on a last-in-first-out stack, deliberately designed without loops or recursion to ensure termination and predictable resource consumption. Script programs (scriptPubKey and scriptSig pairs) encode spending conditions such as digital signature verification, multisignature requirements, hash pre-image revelation, and time locks."@en ;
    rdfs:subClassOf ngm:scripting-language ;
    vc:enables ngm:bitcoin-ordinals,
        ngm:hash-time-locked-contract,
        ngm:lightning-network ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:isPartOf ngm:bitcoin-core ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:slug "bitcoin-script" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:cryptographic-hash-function,
        ngm:digital-signature,
        ngm:opcodes .

ngm:bitcoin-standard a owl:Class ;
    rdfs:label "Bitcoin Standard"@en ;
    rdfs:comment "The Bitcoin Standard is an economic and monetary thesis proposing that Bitcoin's fixed supply cap of 21 million units, its decentralised consensus via Proof of Work, and its censorship-resistant issuance schedule make it a superior store of value and a viable basis for a new international monetary order, analogous to the historical gold standard. Proponents argue that Bitcoin's predictable, algorithmically enforced monetary policy immunises it against political inflation, contrasting with fiat currencies subject to central bank intervention. The thesis draws on Austrian economics, particularly the concept of sound money."@en ;
    rdfs:subClassOf ngm:bc-token-and-asset ;
    skos:broader ngm:bc-token-and-asset ;
    vc:contrastsWith ngm:inflation ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:bitcoin-as-money,
        ngm:bitcoin-value-proposition,
        ngm:monetary-system ;
    vc:slug "bitcoin-standard" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:cryptocurrency,
        ngm:proof-of-work .

ngm:block-propagation a owl:Class ;
    rdfs:label "Block Propagation"@en ;
    rdfs:comment "Block Propagation is the process by which a newly mined or validated block is broadcast across a blockchain peer-to-peer network so that all full nodes can update their local copy of the chain. Propagation latency directly influences the orphan/stale block rate, security against selfish mining, and the degree of centralisation pressure towards large, well-connected mining pools. Techniques such as Compact Block Relay (Bitcoin BIP 152) and Graphene reduce bandwidth requirements by sending block sketches rather than full transaction lists, exploiting the fact that recipient nodes already hold most transactions in their mempools."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:blockchain-network ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:block-propagation-time ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:full-node ],
        ngm:bc-protocol-and-consensus,
        ngm:blockchain-entity,
        ngm:consensus-protocol ;
    skos:broader ngm:bc-protocol-and-consensus ;
    vc:contrastsWith ngm:light-node ;
    vc:dependsOn ngm:blockchain-protocol ;
    vc:enables ngm:blockchain-scalability,
        ngm:consensus-mechanism ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:block-propagation-time ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:block-size,
        ngm:block-time,
        ngm:mempool,
        ngm:miner ;
    vc:requires ngm:blockchain-network,
        ngm:full-node ;
    vc:slug "block-propagation" ;
    vc:sourceDomain "blockchain" .

ngm:block-time a owl:Class ;
    rdfs:label "Block Time"@en ;
    rdfs:comment "Block Time is the average elapsed time between the creation of consecutive blocks on a blockchain, governed by the network's consensus mechanism and difficulty adjustment algorithm. Shorter block times increase transaction throughput and reduce confirmation latency but raise the risk of forks due to block propagation delays, creating a fundamental tradeoff between speed and chain security."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:block-propagation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:consensus-mechanism ],
        ngm:bc-protocol-and-consensus,
        ngm:blockchain-entity,
        ngm:distributed-data-structure ;
    skos:broader ngm:bc-protocol-and-consensus ;
    vc:contrastsWith ngm:blockchain-scalability ;
    vc:enables ngm:transaction-confirmation,
        ngm:transaction-finality ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:blockchain-protocol ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:block-height,
        ngm:block-size,
        ngm:blockchain-scalability,
        ngm:finality,
        ngm:mining ;
    vc:requires ngm:block-propagation,
        ngm:consensus-mechanism ;
    vc:slug "block-time" ;
    vc:sourceDomain "blockchain" .

ngm:blockchain-application a owl:Class ;
    rdfs:label "Blockchain Application"@en ;
    rdfs:comment "A decentralized application (dApp) that runs on a blockchain or peer-to-peer network rather than centralized servers, combining smart contract backend logic with frontend interfaces to provide enhanced security, transparency, censorship resistance, and zero downtime through distributed execution."@en ;
    rdfs:subClassOf ngm:bc-network-component,
        ngm:blockchain ;
    skos:broader ngm:bc-network-component,
        ngm:blockchain ;
    vc:enables ngm:web3 ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:relatedTo ngm:decentralized-finance-de-fi,
        ngm:smart-contracts ;
    vc:requires ngm:cryptocurrency-wallet ;
    vc:slug "blockchain-application" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:blockchain-infrastructure .

ngm:bootstrap-node a owl:Class ;
    rdfs:label "Bootstrap Node"@en ;
    rdfs:comment "A Bootstrap Node is a well-known, stable network entry point that newly joining peers contact to obtain their initial list of active participants in a peer-to-peer blockchain network. By providing a curated, long-lived set of peer addresses, bootstrap nodes solve the cold-start problem: without them a new client would have no means of discovering the network. They do not typically validate or store blocks themselves; their function is purely topological—seeding new participants into the gossip network so that subsequent peer discovery can proceed organically."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptographic-protocol ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:distributed-system ],
        ngm:blockchain-entity ;
    vc:enables ngm:blockchain-network,
        ngm:peer-to-peer-network ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:blockchain-infrastructure ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:full-node,
        ngm:gossip-protocol,
        ngm:light-node,
        ngm:validator-node ;
    vc:requires ngm:cryptographic-protocol,
        ngm:distributed-system ;
    vc:slug "bootstrap-node" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:blockchain-scalability .

ngm:calibration-target a owl:Class ;
    rdfs:label "Calibration Target"@en ;
    rdfs:comment "A physical or displayed reference pattern with precisely known geometric, photometric, or colorimetric properties used to determine camera intrinsic and extrinsic parameters, enabling accurate lens distortion correction, spatial measurement, and color reproduction in imaging systems."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:precision-manufacturing ],
        ngm:reference-standard,
        ngm:sc-standards-and-interop ;
    skos:broader ngm:sc-standards-and-interop ;
    vc:enables ngm:camera-calibration,
        ngm:color-accuracy,
        ngm:lens-distortion-correction ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires ngm:flatness-control,
        ngm:pattern-definition,
        ngm:precision-manufacturing ;
    vc:slug "calibration-target" ;
    vc:sourceDomain "spatial-computing" .

ngm:carbon-markets a owl:Class ;
    rdfs:label "Carbon Markets"@en ;
    rdfs:comment "Carbon markets are trading systems in which carbon credits or allowances — each representing one metric tonne of CO₂ equivalent — are bought and sold between emitters, governments, financial intermediaries, and voluntary buyers, using price signals to incentivise least-cost emissions reductions across the economy. They encompass compliance markets (mandatory emissions trading schemes such as the EU ETS, California Cap-and-Trade, and Article 6 mechanisms under the Paris Agreement) and voluntary carbon markets (VCMs) where organisations purchase credits from independently verified projects to offset residual emissions against net-zero commitments. Market integrity depends on rigorous project standards, independent verification, and robust registry systems to prevent double counting."@en ;
    rdfs:subClassOf ngm:environmental-asset-market ;
    vc:enables ngm:carbon-neutrality,
        ngm:carbon-offset-trading,
        ngm:net-zero-targets ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:carbon-price-discovery,
        ngm:voluntary-carbon-market ;
    vc:slug "carbon-markets" ;
    vc:sourceDomain "finance" ;
    vc:uses ngm:carbon-credits,
        ngm:carbon-registry .

ngm:carbon-registry a owl:Class ;
    rdfs:label "Carbon Registry"@en ;
    rdfs:comment "A centralized database system that tracks the issuance, ownership, transfer, and retirement of carbon credits, assigning unique serial numbers to each credit for full lifecycle traceability and preventing double-counting across voluntary and compliance carbon markets."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:verification-process ],
        ngm:environmental-registry,
        ngm:sc-governance-and-safety ;
    skos:broader ngm:sc-governance-and-safety ;
    vc:enables ngm:credit-tracking,
        ngm:double-counting-prevention,
        ngm:market-transparency ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:database-infrastructure,
        ngm:unique-identifiers,
        ngm:verification-process ;
    vc:slug "carbon-registry" ;
    vc:sourceDomain "spatial-computing" .

ngm:creative-tools a owl:Class ;
    rdfs:label "Creative Tools"@en ;
    rdfs:comment "Creative Tools are AI-powered software applications that assist or augment human creative processes across modalities including image generation, music composition, video synthesis, 3D asset creation, and long-form text authoring. They typically rely on foundation models—particularly diffusion models and large language models—exposed through interactive interfaces or API endpoints. Their role is dual: serving as productivity accelerators for professional practitioners and as accessibility bridges that allow non-expert users to produce high-quality creative outputs."@en ;
    rdfs:subClassOf ngm:ai-application ;
    skos:broader ngm:ai-application ;
    vc:enables ngm:image-generation,
        ngm:text-to-image ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:ai-application ;
    vc:slug "creative-tools" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:diffusion-model,
        ngm:generative-ai .

ngm:data-availability a owl:Class ;
    rdfs:label "Data Availability"@en ;
    rdfs:comment "Data availability in the context of blockchain and distributed systems refers to the guarantee that all data necessary to verify and reconstruct the state of a network—particularly transaction data published by block producers—is accessible to any participant who wishes to retrieve it. The data availability problem arises when validators or light clients cannot verify that a block producer has published the full data backing a block header without downloading and checking every byte. Modern solutions to data availability employ erasure coding and data availability sampling (DAS), allowing light nodes to probabilistically verify full data availability by checking only a small random subset of encoded chunks. Data availability is a foundational property in modular blockchain architectures and rollup scaling systems."@en ;
    rdfs:subClassOf ngm:data-layer ;
    vc:enables ngm:blockchain-scalability,
        ngm:layer-2-scaling ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:content-addressed-storage,
        ngm:sharding,
        ngm:zero-knowledge-proof ;
    vc:slug "data-availability" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:cryptographic-commitment,
        ngm:erasure-coding,
        ngm:merkle-tree,
        ngm:sampling .

ngm:data-structure a owl:Class ;
    rdfs:label "Data Structure"@en ;
    rdfs:comment "Data Structures in AI represent the organizational schemes for efficiently storing, accessing, and manipulating data used in machine learning algorithms."@en ;
    rdfs:subClassOf ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:enables ngm:graph-neural-network,
        ngm:neural-network ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:relatedTo ngm:machine-learning ;
    vc:slug "data-structure" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:algorithm,
        ngm:gpu-compute .

ngm:deflationary-token a owl:Class ;
    rdfs:label "Deflationary Token"@en ;
    rdfs:comment "A Deflationary Token is a cryptocurrency or blockchain token whose total circulating supply decreases over time through one or more programmatic burning mechanisms—such as transaction fee burns, scheduled buyback-and-burn events, or protocol-level token destruction—creating supply-side scarcity intended to exert upward price pressure and incentivise long-term holding."@en ;
    rdfs:subClassOf ngm:bc-token-and-asset,
        ngm:blockchain-entity,
        ngm:economic-mechanism ;
    skos:broader ngm:bc-token-and-asset ;
    vc:contrastsWith ngm:inflationary-token,
        ngm:native-token ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:token-economics-domain ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:blockchain-economics,
        ngm:governance-token,
        ngm:token-economics,
        ngm:tokenomics,
        ngm:transaction-fee ;
    vc:slug "deflationary-token" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:burning-mechanism,
        ngm:supply-cap .

ngm:digital-asset-domain a owl:Class ;
    rdfs:label "Digital Asset Domain"@en ;
    rdfs:comment "The Digital Asset Domain classifies concepts relating to value representations that are recorded, transferred, and settled on distributed ledgers. It covers tokens, their issuance and lifecycle, and the standards that define their behaviour. As a subject classification under the Blockchain Domain, it scopes the asset abstraction itself rather than the trading venues or regulatory regimes that surround it."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:non-fungible-token ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:fungible-token ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:distributed-ledger ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:stablecoin ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:smart-contract ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:token-standard ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptographic-primitive ],
        ngm:blockchain-domain ;
    vc:enables ngm:asset-tokenisation,
        ngm:atomic-settlement,
        ngm:programmable-ownership ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:fungible-token,
        ngm:non-fungible-token,
        ngm:stablecoin,
        ngm:token-standard,
        ngm:tokenised-security ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:cryptographic-primitive,
        ngm:distributed-ledger,
        ngm:smart-contract ;
    vc:slug "digital-asset-domain" ;
    vc:sourceDomain "digital-asset" .

ngm:digital-payments a owl:Class ;
    rdfs:label "Digital Payments"@en ;
    rdfs:comment "Electronic monetary transactions executed through digital channels including blockchain networks, mobile wallets, and online platforms, enabling the transfer of value for virtual goods, services, and assets within metaverse economies and across traditional e-commerce systems."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:digital-wallet ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:payment-processor ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:network-infrastructure ],
        ngm:financial-transactions,
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:enables ngm:cross-border-transfer,
        ngm:e-commerce,
        ngm:virtual-purchases ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires ngm:digital-wallet,
        ngm:network-infrastructure,
        ngm:payment-processor ;
    vc:slug "digital-payments" ;
    vc:sourceDomain "spatial-computing" .

ngm:display-technology a owl:Class ;
    rdfs:label "Display Technology"@en ;
    rdfs:comment "Display Technology encompasses the hardware, optical systems, and electronic components used to visually present information to human observers across a range of form factors, from flat panels and projection systems to head-mounted and retinal displays. Modern display systems span LCD, OLED, microLED, and laser projection substrates, each with distinct characteristics in brightness, contrast, colour gamut, refresh rate, and power consumption. For immersive computing applications including augmented and virtual reality, display technology must additionally address field of view, vergence-accommodation conflict, and waveguide efficiency. Advances in microdisplay resolution and optical engineering are critical enablers of lightweight, socially acceptable XR headsets."@en ;
    rdfs:subClassOf ngm:display-hardware ;
    vc:enables ngm:ar-display-device,
        ngm:foveated-rendering,
        ngm:mixed-reality ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:augmented-reality,
        ngm:display-metrology,
        ngm:extended-reality ;
    vc:slug "display-technology" ;
    vc:sourceDomain "metaverse" ;
    vc:supports ngm:xr-device ;
    vc:uses ngm:optical-calibration-target,
        ngm:photorealistic-rendering .

ngm:domain-adaptation a owl:Class ;
    rdfs:label "Domain Adaptation"@en ;
    rdfs:comment "Domain adaptation is a sub-field of transfer learning concerned with reducing the performance degradation that occurs when a model trained on a labelled source domain is applied to a target domain whose data distribution differs. Adaptation methods range from feature alignment (learning domain-invariant representations via adversarial training or maximum mean discrepancy minimisation) to instance re-weighting and self-training on unlabelled target data. It is applied extensively in NLP, computer vision, and speech recognition when labelled target data is scarce or costly to acquire."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:pre-training ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:training-data ],
        ngm:ai-technique,
        ngm:transfer-learning ;
    skos:broader ngm:ai-technique ;
    vc:enables ngm:fine-tuning ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:knowledge-distillation,
        ngm:machine-learning ;
    vc:requires ngm:pre-training,
        ngm:training-data ;
    vc:slug "domain-adaptation" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:education-technology a owl:Class ;
    rdfs:label "Education Technology"@en ;
    rdfs:comment "Education Technology (EdTech) is the application of digital tools, AI-driven systems, and immersive platforms to enhance teaching, personalise learning pathways, and streamline educational administration. Modern EdTech leverages adaptive learning algorithms that adjust content difficulty and pacing to individual learner performance, natural language processing for automated essay scoring and tutoring dialogue, and XR environments that create immersive simulations for fields such as medicine, engineering, and history. It spans formal K-12 and higher education, professional development, and informal self-directed learning."@en ;
    rdfs:subClassOf ngm:ai-application ;
    skos:broader ngm:ai-application ;
    vc:enables ngm:augmented-reality,
        ngm:virtual-reality ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:natural-language-processing ;
    vc:slug "education-technology" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:immersive-learning,
        ngm:learning-management-system .

ngm:erasure-coding a owl:Class ;
    rdfs:label "Erasure Coding"@en ;
    rdfs:comment "Erasure coding is a forward error-correction technique that encodes a data object into n fragments (shards), distributed across nodes or storage devices, such that any k of those n fragments are sufficient to reconstruct the original data without any centralised copy. The redundancy overhead (n − k) / k is typically much lower than full replication, making erasure coding the preferred durability mechanism in large-scale distributed storage systems and distributed ledgers where storage efficiency matters. Common schemes include Reed-Solomon codes, and more computationally efficient variants such as LDPC and Cauchy Reed-Solomon."@en ;
    rdfs:subClassOf ngm:infra-data-management ;
    skos:broader ngm:infra-data-management ;
    vc:enables ngm:distributed-systems,
        ngm:fault-tolerance ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:distributed-ledger,
        ngm:ipfs,
        ngm:storage-infrastructure ;
    vc:slug "erasure-coding" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:data-replication .

ngm:erc-1155 a owl:Class ;
    rdfs:label "ERC-1155"@en ;
    rdfs:comment "ERC-1155 is an Ethereum multi-token standard that allows a single smart contract to manage an arbitrary number of distinct token types — fungible, non-fungible, and semi-fungible — each identified by a uint256 token ID, with quantities tracked per address per ID. Pioneered by Enjin and formalised as EIP-1155, the standard introduces safeBatchTransferFrom for atomic multi-token transfers in a single transaction, substantially reducing gas costs compared to managing multiple separate ERC-20 or ERC-721 contracts. It is widely adopted in blockchain gaming, NFT collections, and on-chain economies that blend consumable items with unique assets."@en ;
    rdfs:subClassOf ngm:bc-token-and-asset,
        ngm:token-standard ;
    skos:broader ngm:bc-token-and-asset ;
    vc:contrastsWith ngm:erc-20,
        ngm:erc-721 ;
    vc:enables ngm:blockchain-gaming,
        ngm:nft ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:slug "erc-1155" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:batch-processing,
        ngm:smart-contract .

ngm:etsi-domain-taxonomy a owl:Class ;
    rdfs:label "ETSI Domain Taxonomy"@en ;
    rdfs:comment "The ETSI Domain Taxonomy is a hierarchical classification framework produced by the European Telecommunications Standards Institute for systematically organising AI-related technical specifications, standards, and work items across application domains such as transportation, healthcare, telecommunications, and public safety. It provides a controlled vocabulary and structural ontology that enables consistent referencing of AI standards across ETSI technical committees and supports cross-domain applicability analysis. The taxonomy underpins ETSI's AI standardisation roadmap and facilitates alignment with CEN-CENELEC and ISO/IEC standardisation activities."@en ;
    rdfs:subClassOf ngm:ai-governance-and-ethics ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:etsi ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:slug "etsi-domain-taxonomy" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:ai-regulation,
        ngm:interoperability ;
    vc:uses ngm:controlled-vocabulary,
        ngm:ontology .

ngm:financial-instruments a owl:Class ;
    rdfs:label "Financial Instruments"@en ;
    rdfs:comment "Financial Instruments are contractual agreements that represent a monetary value and can be created, traded, modified, or settled. In blockchain and decentralised finance ecosystems they include smart contract-based derivatives, lending protocols, automated market makers, yield aggregators, and synthetic assets that replicate exposure to real-world financial assets through on-chain collateralisation and oracle price feeds."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:financial-regulation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:smart-contracts ],
