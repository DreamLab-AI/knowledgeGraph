        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:real-time-rendering ],
        ngm:sc-platform-and-environment,
        ngm:tourism-industry ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:metaverse ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires ngm:real-time-rendering,
        ngm:virtual-reality ;
    vc:slug "virtual-tourism" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:digital-twin,
        ngm:volumetric-capture .

ngm:vr-rendering-engine a owl:Class ;
    rdfs:label "VR Rendering Engine"@en ;
    rdfs:comment "Specialised real-time graphics software that generates stereoscopic imagery for virtual reality headsets, optimising frame rates (minimum 90 fps), motion-to-photon latency (sub-20 ms), and visual fidelity while managing VR-specific pipeline requirements including foveated rendering, asynchronous reprojection, and lens distortion correction. Leading implementations include Unreal Engine 5 (Lumen, Nanite) and Unity (URP/HDRP), both supporting major XR hardware via OpenXR and platform-specific SDKs."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:xr-device ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:real-time-rendering ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:foveated-rendering ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:real-time-rendering-pipeline ],
        ngm:game-engine,
        ngm:sc-display-and-rendering ;
    skos:broader ngm:sc-display-and-rendering ;
    vc:enables ngm:immersive-experience,
        ngm:virtual-production ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:foveated-rendering,
        ngm:real-time-rendering-pipeline ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:requires ngm:real-time-rendering,
        ngm:xr-device ;
    vc:slug "vr-rendering-engine" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:spatial-computing .

ngm:vulnerability-management a owl:Class ;
    rdfs:label "Vulnerability Management"@en ;
    rdfs:comment "The continuous process of identifying, assessing, prioritising and remediating security weaknesses across systems and software to reduce the risk of exploitation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:vulnerability ],
        ngm:cybersecurity ;
    vc:enables ngm:risk-management ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:vulnerability ;
    vc:slug "vulnerability-management" ;
    vc:sourceDomain "general" .

ngm:w3-c-verifiable-credentials a owl:Class ;
    rdfs:label "W3C Verifiable Credentials"@en ;
    rdfs:comment "W3C Verifiable Credentials (VCs) are a standardised data model and serialisation format published by the World Wide Web Consortium that enables the cryptographic expression of credentials — such as educational qualifications, identity attributes, or professional licences — in a tamper-evident, machine-verifiable form. The standard defines three roles: issuer (creates and signs the credential), holder (stores and presents credentials), and verifier (validates the signature and claims), forming a trust triangle that operates without requiring a centralised credential registry. VCs are designed to work with Decentralised Identifiers (DIDs) to create self-sovereign identity systems."@en ;
    rdfs:subClassOf ngm:verifiable-credentials ;
    vc:enables ngm:credential-verification,
        ngm:federated-credential-exchange,
        ngm:privacy-preserving-identity ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:credential-format-standard,
        ngm:decentralized-identity-did,
        ngm:self-sovereign-identity,
        ngm:verifiable-credential-vc ;
    vc:slug "w3-c-verifiable-credentials" ;
    vc:sourceDomain "security" ;
    vc:uses ngm:cryptographic-security,
        ngm:did-document .

ngm:web-id a owl:Class ;
    rdfs:label "WebID"@en ;
    rdfs:comment "WebID is a decentralised identity mechanism in which a person or agent is identified by an HTTP(S) URI that dereferences to a machine-readable profile document describing them in RDF. Combined with authentication methods such as WebID-TLS or WebID-OIDC, it lets users prove control of their identifier without a central identity provider. WebID is a foundational building block of the Solid project and the broader linked-data web, enabling user-controlled identity, profiles, and access control across decentralised applications."@en ;
    rdfs:subClassOf ngm:decentralized-identity ;
    vc:enables ngm:federated-identity ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:self-sovereign-identity,
        ngm:semantic-web ;
    vc:slug "web-id" ;
    vc:sourceDomain "identity" ;
    vc:uses ngm:linked-data,
        ngm:rdf .

ngm:wholesale-cbdc a owl:Class ;
    rdfs:label "Wholesale CBDC"@en ;
    rdfs:comment "A Wholesale Central Bank Digital Currency (wCBDC) is a form of central bank money issued in digital form and restricted to use by financial institutions—commercial banks, clearing houses, and other regulated entities—for large-value interbank settlement and financial market infrastructure operations, as distinct from retail CBDC which is available to the general public. Wholesale CBDCs are designed to modernise payment system infrastructure by enabling atomic delivery-versus-payment settlement, programmable payment conditions through smart contracts, and 24/7 settlement finality, addressing inefficiencies in legacy correspondent banking and real-time gross settlement systems. Multiple central banks are actively piloting wholesale CBDC, including Project Jura (BIS, Banque de France, SNB), Project Dunbar (BIS, MAS, SARB, RBA, BNM), and the Bank of England's New Payments Architecture."@en ;
    rdfs:subClassOf ngm:central-bank-digital-currency ;
    vc:enables ngm:cross-border-payments,
        ngm:instant-value-settlement,
        ngm:monetary-policy-implementation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:cbdcs,
        ngm:central-bank,
        ngm:financial-infrastructure ;
    vc:slug "wholesale-cbdc" ;
    vc:sourceDomain "finance" ;
    vc:supports ngm:monetary-sovereignty,
        ngm:monetary-system ;
    vc:uses ngm:digital-payment-system,
        ngm:interoperability-protocol .

ngm:wireless-radio a owl:Class ;
    rdfs:label "Wireless Radio"@en ;
    rdfs:comment "Wireless radio refers to the technology and systems that transmit and receive information using electromagnetic waves propagated through free space without physical conductors, encompassing the hardware, protocols, modulation schemes, and spectrum management practices that enable wireless communication across a range of frequencies from kilohertz to millimetre-wave bands. It is the physical-layer foundation of all wireless networking standards including cellular, Wi-Fi, Bluetooth, and satellite communications."@en ;
    rdfs:subClassOf ngm:telecommunications ;
    vc:enables ngm:telecommunications-infrastructure,
        ngm:wi-fi ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:antenna-array,
        ngm:radio-access-network,
        ngm:wireless-connectivity ;
    vc:slug "wireless-radio" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:radio-transceiver .

ngm:3-d-rendering a owl:Class ;
    rdfs:label "3D Rendering"@en ;
    rdfs:comment "3D rendering is the computational process of generating a two-dimensional image or animation from a three-dimensional scene description by simulating the interaction of light with surfaces, materials, and geometry. It encompasses techniques ranging from real-time rasterization used in interactive applications to physically-based ray tracing used for photorealistic offline production. The pipeline converts geometric primitives, shader programs, texture maps, and lighting data into final pixel colours via a GPU compute pipeline or software renderer."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:compute-shader ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:ray-tracing ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:pixel-shader ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:rasterization ],
        ngm:computer-graphics ;
    vc:enables ngm:foveated-rendering,
        ngm:photorealistic-rendering,
        ngm:physically-based-rendering ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:compute-shader,
        ngm:pixel-shader,
        ngm:rasterization,
        ngm:ray-tracing ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:3-d-rendering-engine,
        ngm:differentiable-rendering ;
    vc:slug "3-d-rendering" ;
    vc:sourceDomain "graphics" ;
    vc:uses ngm:3-d-model,
        ngm:gpu-compute .

ngm:3-d-scanning a owl:Class ;
    rdfs:label "3D Scanning"@en ;
    rdfs:comment "3D Scanning is the process of capturing the three-dimensional shape, and optionally the colour and texture, of real-world objects, people, or environments using hardware such as structured-light scanners, time-of-flight LiDAR, photogrammetry rigs, or depth cameras, producing digital point clouds or meshes that represent the physical source. The resulting data feeds into digital preservation, reverse engineering, visual-effects production, quality inspection, and spatial computing pipelines. Accuracy, resolution, and scan volume are the primary quality axes that distinguish scanning technologies."@en ;
    rdfs:subClassOf ngm:3-d-reconstruction ;
    vc:enables ngm:3-d-scene-reconstruction,
        ngm:digital-twin-creation,
        ngm:point-cloud-processing ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:3-d-perception,
        ngm:point-cloud,
        ngm:structure-from-motion ;
    vc:slug "3-d-scanning" ;
    vc:sourceDomain "spatial" ;
    vc:uses ngm:3-d-li-dar,
        ngm:depth-sensor,
        ngm:photogrammetry .

ngm:actuators a owl:Class ;
    rdfs:label "Actuators"@en ;
    rdfs:comment "Actuators are physical devices that convert an electrical, hydraulic, or pneumatic control signal into mechanical motion or force, enabling a control system to produce a desired physical effect in the world. They are the output components of robotic and cyber-physical systems, spanning technologies including servo motors, pneumatic cylinders, hydraulic actuators, and piezoelectric elements, each offering different trade-offs in force output, speed, precision, and energy efficiency."@en ;
    rdfs:subClassOf ngm:robot-component ;
    vc:enables ngm:haptic-feedback,
        ngm:robot-manipulation ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:isPartOf ngm:cyber-physical-systems,
        ngm:robot ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:control-system,
        ngm:robot-actuator ;
    vc:slug "actuators" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:feedback-control,
        ngm:servo-motor .

ngm:adapter-modules a owl:Class ;
    rdfs:label "Adapter Modules"@en ;
    rdfs:comment "Adapter Modules are compact bottleneck neural network sub-networks inserted between frozen transformer layers, trained exclusively on task-specific data whilst leaving the base model unchanged. They typically comprise a down-projection, a non-linearity, and an up-projection with a residual connection, constituting under 1% of model parameters and enabling efficient multi-task deployment from a single frozen base model."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:fine-tuning ],
        ngm:parameter-efficient-fine-tuning ;
    vc:contrastsWith ngm:prefix-tuning,
        ngm:prompt-tuning ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:parameter-efficient-fine-tuning ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires ngm:fine-tuning ;
    vc:slug "adapter-modules" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:neural-network-layer,
