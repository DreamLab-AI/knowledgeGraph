ngm:national-sovereign-ai-procurement-initiative a owl:Class ;
    rdfs:label "National Sovereign AI Procurement Initiative"@en ;
    rdfs:comment "A Sovereign AI bid is a state or regional initiative to develop, procure, or deploy AI infrastructure and foundation models under national control, reducing dependence on foreign hyperscalers and ensuring that AI capabilities, data residency, and compute sovereignty remain within a defined jurisdiction. Such bids typically involve national compute investment, open-source model adoption, and alignment with local regulatory frameworks including the EU AI Act."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:compute-infrastructure ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ai-governance ],
        ngm:ai-governance-and-ethics ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:bridgesTo ngm:ai-capability-temporal-horizon-framework ;
    vc:enables ngm:ai-deployment ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:ai-regulation,
        ngm:inference-hardware,
        ngm:sovereign-ai ;
    vc:requires ngm:ai-governance,
        ngm:compute-infrastructure ;
    vc:slug "national-sovereign-ai-procurement-initiative" ;
    vc:sourceDomain "artificial-intelligence" .

