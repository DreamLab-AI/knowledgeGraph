ngm:transfer-learning a owl:Class ;
    rdfs:label "Transfer Learning"@en ;
    rdfs:comment "Transfer learning is a machine learning paradigm in which knowledge encoded in a model trained on a source task or domain is systematically reused to improve learning efficiency and performance on a different but related target task or domain. By exploiting shared representations — such as low-level feature detectors, syntactic structures, or visual hierarchies — the technique drastically reduces the labelled data, compute, and training time required for downstream tasks. It is foundational to modern deep learning practice, underpinning pre-trained large language models, vision transformers, and multi-modal systems that are subsequently adapted via fine-tuning, prompt tuning, or adapter layers. The paradigm bridges the gap between data-rich source domains and data-scarce target settings, enabling deployment in low-resource clinical, scientific, and industrial contexts."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:domain-adaptation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:pre-trained-model ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:adapter-modules ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:prompt-tuning ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:fine-tuning ],
        ngm:machine-learning ;
    vc:bridgesTo ngm:computer-vision,
        ngm:natural-language-processing,
        ngm:robotics ;
    vc:contrastsWith ngm:training-from-scratch ;
    vc:dependsOn ngm:representation-learning,
        ngm:supervised-learning ;
    vc:enables ngm:few-shot-learning,
        ngm:foundation-model,
        ngm:large-language-models,
        ngm:zero-shot-learning ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:adapter-modules,
