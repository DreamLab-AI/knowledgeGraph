    rdfs:label "Intelligent Tutoring"@en .
ngm:intelligent-tutoring-system a owl:Class ;
    rdfs:comment "An AI-powered software system that delivers personalised instruction by modelling a learner's knowledge state, selecting appropriate pedagogical strategies, and adapting content difficulty in real time without requiring a human instructor. Intelligent tutoring systems integrate domain knowledge, learner models, and tutoring strategies to provide one-on-one instructional support at scale."@en ;
    rdfs:label "Intelligent Tutoring System"@en ;
    rdfs:subClassOf ngm:educational-technology ;
    vc:enables ngm:adaptive-learning ;
