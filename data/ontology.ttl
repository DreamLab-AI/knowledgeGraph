ngm:testnet a owl:Class ;
    rdfs:label "Testnet"@en ;
    rdfs:comment "Blockchain testnet is a parallel blockchain network maintained by protocol developers and validators that mirrors the structure, consensus rules, and transaction semantics of a production mainnet whilst operating in a sandboxed environment with free or faucet-dispensed native tokens (typically 1 ..."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:state-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:validator-node ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:genesis-block ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:consensus-rule ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:peerto-peer-protocol ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptographic-primitive ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:block-explorer ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:consensus-mechanism ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:full-node ],
        ngm:bc-protocol-and-consensus,
        ngm:blockchain,
        ngm:testing-infrastructure ;
    skos:broader ngm:bc-protocol-and-consensus,
        ngm:blockchain ;
    vc:enables ngm:consensus-research,
        ngm:cross-chain-integration,
        ngm:d-app-deployment,
        ngm:protocol-testing,
        ngm:smart-contract-development ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:block-explorer,
        ngm:consensus-mechanism,
        ngm:faucet,
        ngm:full-node,
        ngm:genesis-block,
        ngm:mining-staking-pool,
        ngm:validator-node ;
    vc:implements ngm:pbft-consensus,
        ngm:proof-of-stake,
        ngm:proof-of-work,
        ngm:state-machine-replication,
        ngm:validator-selection ;
    vc:qualityScore "0.51"^^xsd:float ;
