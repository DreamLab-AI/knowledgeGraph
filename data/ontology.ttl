ngm:quantexa a owl:Class ;
    rdfs:label "Quantexa"@en ;
    rdfs:comment "Quantexa is a company that provides data analytics software for connecting and analysing data to support decision intelligence, including fraud and financial crime detection."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-analytics ],
