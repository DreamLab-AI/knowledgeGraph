        ngm:risk-assessment ;
    vc:requires ngm:rb-0087-safety-standard ;
    vc:slug "rb-0089-risk-assessment" ;
    vc:sourceDomain "robotics" .

ngm:remote-procedure-call a owl:Class ;
    rdfs:label "Remote Procedure Call"@en ;
    rdfs:comment "A remote procedure call (RPC) is a communication paradigm in which a program invokes a procedure that executes on a different address space, typically another machine on a network, as if it were a local call. The runtime marshals arguments, transmits them over a transport, executes the procedure remotely, and returns the result, hiding the underlying network mechanics from the caller. RPC underpins distributed systems and service-to-service communication, with modern frameworks adding streaming, code generation, and efficient binary serialisation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:protocol ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:service-discovery ],
        ngm:network-protocol ;
    vc:contrastsWith ngm:asynchronous-communication,
        ngm:rest-api ;
    vc:enables ngm:distributed-computing,
        ngm:microservices ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:implements ngm:message-passing,
        ngm:synchronous-communication ;
    vc:isPartOf ngm:distributed-systems,
        ngm:networking ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:api,
        ngm:distributed-protocol ;
    vc:requires ngm:protocol,
        ngm:service-discovery ;
    vc:slug "remote-procedure-call" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:api-design,
        ngm:service-mesh ;
    vc:uses ngm:http,
        ngm:network-protocol .

ngm:rendering-technique a owl:Class ;
    rdfs:label "Rendering Technique"@en ;
    rdfs:comment "A rendering technique is a specific algorithm or computational methodology for transforming a three-dimensional geometric scene description into a two-dimensional pixel image, inherently balancing image fidelity against computational cost and latency. The fundamental paradigms are rasterization (projecting geometry to screen space via edge-walking and interpolation), ray tracing (physically simulating light transport by casting rays from the virtual camera), and path tracing (extending ray tracing with Monte Carlo sampling for unbiased global illumination). Modern systems layer shading models (forward, deferred, clustered), global illumination approximations, and screen-space post-processing into hybrid pipelines that target real-time or offline quality budgets across hardware ranging from mobile GPUs to dedicated ray-tracing silicon."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:rasterization ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:shader ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:path-tracing ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:scene-graph ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:global-illumination ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:post-processing ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:ray-tracing ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:graphics-processing-unit ],
        ngm:sc-display-and-rendering ;
    skos:broader ngm:sc-display-and-rendering ;
    vc:bridgesTo ngm:machine-learning,
        ngm:neural-rendering ;
    vc:contrastsWith ngm:rasterization,
        ngm:ray-tracing ;
    vc:dependsOn ngm:graphics-api,
        ngm:level-of-detail ;
    vc:enables ngm:augmented-reality,
        ngm:real-time-3d-graphics,
        ngm:virtual-reality,
        ngm:visual-effects ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:global-illumination,
        ngm:path-tracing,
        ngm:post-processing,
        ngm:rasterization,
        ngm:ray-tracing ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:ambient-occlusion,
        ngm:deferred-rendering ;
    vc:requires ngm:graphics-processing-unit,
