ngm:player-two-code a owl:Class ;
    rdfs:label "Player Two code"@en ;
    rdfs:comment "Player Two code is the technical implementation layer of the Player Two platform, comprising a Vue.js front-end, BIP85-derived key management for trustless authentication, a Nostr-relay-based messaging architecture, and middleware whitelist logic. It enables encrypted group collaboration without server-held keys, using derivation path m/44'/1237 for per-user identity."@en ;
    rdfs:subClassOf ngm:infra-software-engineering ;
    skos:broader ngm:infra-software-engineering ;
    vc:dependsOn ngm:collaboration-platform ;
    vc:enables ngm:identity-management ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:implements ngm:decentralised-identity,
        ngm:player-two ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:slug "player-two-code" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:authentication,
        ngm:cryptography .

ngm:pneumatic-motor a owl:Class ;
    rdfs:label "Pneumatic Motor"@en ;
    rdfs:comment "A Pneumatic Motor is an actuator that converts the energy stored in compressed air into continuous rotational mechanical motion, producing torque and speed proportional to the supply pressure and airflow rate. Pneumatic motors are characterised by high power-to-weight ratios, inherent overload protection through stall behaviour, and suitability for hazardous environments where electrical motors would pose ignition risks. They are widely used in industrial tooling, material handling equipment, and mobile robotics applications requiring lightweight, spark-free drive systems."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:torque ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:pneumatic-actuator ],
        ngm:pneumatic-actuator,
        ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:contrastsWith ngm:hydraulic-motor,
        ngm:servo-motor ;
    vc:enables ngm:robotics ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:torque ;
    vc:isPartOf ngm:robo-actuation-and-control,
        ngm:robotic-system ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:industrial-robot,
        ngm:pneumatic-cylinder,
        ngm:robotics-control ;
    vc:requires ngm:pneumatic-actuator ;
    vc:slug "pneumatic-motor" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:torque-control .

ngm:polkadot-parachains a owl:Class ;
    rdfs:label "Polkadot Parachains"@en ;
    rdfs:comment "Application-specific sovereign blockchains that lease a slot on the Polkadot Relay Chain, inheriting its shared security model and cross-chain messaging infrastructure. Parachains can have custom runtime logic, consensus rules, and token economics whilst relying on the relay chain's validator set for finalisation, enabling heterogeneous specialised chains to interoperate without sacrificing security or decentralisation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:web-assembly ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:validator-node ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:nominated-proof-of-stake ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:consensus-mechanism ],
        ngm:bc-network-component ;
    skos:broader ngm:bc-network-component ;
    vc:enables ngm:blockchain-interoperability,
        ngm:blockchain-scalability,
        ngm:cross-chain-messaging ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:blockchain,
        ngm:blockchain-network ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:blockchain-governance,
