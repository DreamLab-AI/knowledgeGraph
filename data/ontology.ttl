ngm:elliptic-curve-cryptography a owl:Class ;
    rdfs:label "Elliptic Curve Cryptography"@en ;
    rdfs:comment "A public-key cryptographic system based on the algebraic structure of elliptic curves over finite fields, providing strong security guarantees with shorter key lengths than RSA. ECC underpins digital signatures (ECDSA), key agreement (ECDH), and identity operations throughout blockchain infrastructure."@en ;
    rdfs:subClassOf ngm:bc-cryptographic-primitive,
        ngm:blockchain-entity,
        ngm:cryptographic-primitive ;
    skos:broader ngm:bc-cryptographic-primitive ;
