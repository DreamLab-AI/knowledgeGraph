# XR Testing Infrastructure
mv:XrTestingInfrastructure a owl:Class ;
    rdfs:subClassOf mv:TestingInfrastructure ;
    rdfs:label "XR Testing Infrastructure"@en ;
    rdfs:comment "The hardware, software, and methodological frameworks for validating extended reality applications, including automated testing tools, motion capture systems, user testing labs, performance profiling equipment, and simulation environments for quality assurance of VR, AR, and MR experiences."@en ;
    skos:prefLabel "XR Testing Infrastructure"@en ;
    dcterms:identifier "MV-10174" ;
