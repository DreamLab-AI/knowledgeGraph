ngm:linked-data a owl:Class ;
    rdfs:label "Linked Data"@en ;
    rdfs:comment "Linked Data is a set of design principles articulated by Tim Berners-Lee for publishing machine-readable structured data on the Web, requiring that entities be identified by HTTP URIs, that those URIs dereference to useful RDF descriptions, and that descriptions include typed links to further URIs enabling traversal across a global Web of Data. It constitutes the application layer of the Semantic Web stack and provides the architectural foundation for open knowledge graphs such as Wikidata, DBpedia, and the Linked Open Data cloud. The four canonical principles — use URIs as names, use HTTP URIs, return structured data on lookup, and include outbound links — create a decentralised, self-describing information mesh that transcends the boundaries of individual databases and siloed repositories."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:http ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:uri ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:rdf ],
        ngm:infra-data-management ;
    skos:broader ngm:infra-data-management ;
    vc:bridgesTo ngm:entity-linking,
        ngm:knowledge-representation,
        ngm:retrieval-augmented-generation ;
    vc:contrastsWith ngm:data-silo,
        ngm:relational-database ;
    vc:enables ngm:federated-query,
        ngm:knowledge-graph,
        ngm:knowledge-graph-construction,
        ngm:open-data ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:linked-data-platform ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:dbpedia,
        ngm:dublin-core,
        ngm:ontology,
        ngm:wikidata ;
    vc:requires ngm:http,
        ngm:rdf,
        ngm:uri ;
    vc:slug "linked-data" ;
    vc:sourceDomain "data" ;
    vc:standardizedBy ngm:rdf-schema,
        ngm:w3-c ;
    vc:uses ngm:json-data-interchange-format-ld,
        ngm:owl,
        ngm:schema-org,
        ngm:sparql,
        ngm:turtle .

ngm:anti-money-laundering a owl:Class ;
    rdfs:label "Anti-Money Laundering"@en ;
    rdfs:comment "Anti-Money Laundering (AML) encompasses the legislative frameworks, regulatory obligations, and operational procedures that financial institutions and other regulated entities must implement to detect, prevent, and report the concealment and integration of proceeds from criminal activity. AML programmes are built around customer due diligence (CDD), enhanced due diligence (EDD) for high-risk relationships, continuous transaction monitoring, suspicious activity reporting (SAR), and sanctions screening against watch-lists maintained by bodies such as OFAC, the EU, and the UN. International standards are promulgated by the Financial Action Task Force (FATF) through its Forty Recommendations and transposed into national law by member jurisdictions, covering banks, virtual asset service providers (VASPs), lawyers, accountants, and real-estate agents. Modern AML increasingly relies on machine learning, graph analytics, and RegTech automation to surface complex layering schemes that evade traditional rule-based systems."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:transaction-monitoring ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:customer-due-diligence ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:know-your-customer ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:identity-verification ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:sanctions-screening ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:risk-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:fraud-detection ],
        ngm:regulatory-compliance ;
    vc:bridgesTo ngm:federated-learning,
        ngm:zero-knowledge-proof ;
    vc:contrastsWith ngm:financial-privacy,
        ngm:privacy-preserving-computation ;
    vc:enables ngm:asset-recovery,
        ngm:financial-intelligence ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:customer-due-diligence,
        ngm:know-your-customer,
        ngm:sanctions-screening,
        ngm:suspicious-activity-reporting,
        ngm:transaction-monitoring ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:blockchain-compliance,
        ngm:counter-terrorist-financing,
        ngm:financial-crime-detection,
        ngm:regtech ;
    vc:requires ngm:fraud-detection,
        ngm:identity-verification,
        ngm:risk-management ;
    vc:slug "anti-money-laundering" ;
    vc:sourceDomain "finance" ;
    vc:standardizedBy ngm:basel-committee-on-banking-supervision,
        ngm:financial-action-task-force ;
    vc:uses ngm:anomaly-detection,
        ngm:graph-neural-network,
        ngm:machine-learning,
        ngm:natural-language-processing .

ngm:network-security a owl:Class ;
    rdfs:label "Network Security"@en ;
    rdfs:comment "Network security is the practice of protecting computer networks and the data transmitted across them from unauthorised access, misuse, modification, or denial of service through a combination of hardware controls, software policies, and operational procedures. It encompasses perimeter defence, intrusion detection and prevention, traffic analysis, encryption of data in transit, and access control applied at network boundaries and within internal segments. As networks have evolved from isolated LANs to globally distributed cloud and edge architectures, network security has broadened to encompass zero-trust models, software-defined perimeters, and AI-driven anomaly detection. It forms a foundational layer of broader cybersecurity strategy, intersecting with identity management, cryptographic standards, and regulatory compliance frameworks."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:firewall ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:network-segmentation ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:virtual-private-network ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:intrusion-detection-system ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:identity-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:access-control ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:security-information-and-event-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:authentication-mechanism ],
        ngm:cybersecurity ;
    vc:bridgesTo ngm:machine-learning,
        ngm:software-defined-networking ;
    vc:contrastsWith ngm:perimeter-security ;
    vc:dependsOn ngm:cryptography,
        ngm:public-key-infrastructure ;
    vc:enables ngm:compliance-management,
        ngm:data-security,
        ngm:digital-security,
        ngm:secure-communication ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:firewall,
        ngm:intrusion-detection-system,
        ngm:network-segmentation,
        ngm:security-information-and-event-management,
        ngm:virtual-private-network ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:endpoint-security,
        ngm:information-security,
        ngm:threat-intelligence,
        ngm:vulnerability-management,
        ngm:zero-trust-architecture ;
    vc:requires ngm:access-control,
        ngm:authentication-mechanism,
        ngm:identity-management ;
    vc:slug "network-security" ;
    vc:sourceDomain "security" ;
    vc:standardizedBy ngm:iso-iec-27001,
        ngm:nist-cybersecurity-framework ;
    vc:uses ngm:anomaly-detection,
        ngm:encryption,
        ngm:network-protocol,
        ngm:transport-layer-security .

ngm:digital-wallet a owl:Class ;
    rdfs:label "Digital Wallet"@en ;
    rdfs:comment "A software application or hardware device that stores private keys and enables users to manage, send, and receive cryptocurrencies and digital assets on blockchain networks, with self-custody wallets providing complete user control over private keys without third-party intermediaries."@en ;
