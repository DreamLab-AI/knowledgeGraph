    a owl:Restriction ;
    owl:onProperty infrastructure:enables ;
    owl:someValuesFrom spatial-computing:InclusiveVirtualExperiences
] .

spatial-computing:AccessibilityStandards rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty infrastructure:enables ;
    owl:someValuesFrom spatial-computing:UniversalDesign
] .

