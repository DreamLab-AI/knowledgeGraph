ngm:invoke-ai a owl:Class ;
    rdfs:label "InvokeAI"@en ;
    rdfs:comment "An open-source application and toolkit for running text-to-image diffusion models such as Stable Diffusion, providing a web interface and workflow tools for image generation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:stable-diffusion ],
        ngm:generative-ai ;
    vc:enables ngm:text-to-image ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:stable-diffusion ;
    vc:slug "invoke-ai" ;
    vc:sourceDomain "generative-ai" .

ngm:inworld-ai a owl:Class ;
    rdfs:label "Inworld AI"@en ;
    rdfs:comment "Inworld AI is a company providing tools for building interactive AI-driven characters for games and virtual experiences. Its platform combines language models, speech and behaviour controls to drive non-player characters and avatars."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:language-model ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:text-to-speech ],
        ngm:conversational-ai ;
    vc:enables ngm:avatar,
        ngm:game-ai ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:language-model,
        ngm:text-to-speech ;
    vc:slug "inworld-ai" ;
    vc:sourceDomain "artificial-intelligence" .

