ngm:key-vector a owl:Class ;
    rdfs:label "Key Vector"@en ;
    rdfs:comment "In transformer-based neural networks, a Key Vector is one of three learned linear projections of an input token embedding—alongside the Query Vector and Value Vector—that together implement the scaled dot-product attention mechanism. The key vector represents what a given token has to offer: each query–key dot product measures the compatibility or relevance between a querying token and every other token in the sequence, with the resulting attention weights determining how much each value vector contributes to the output representation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:token-embedding ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:transformer ],
        ngm:neural-network-component ;
    vc:enables ngm:semantic-search,
        ngm:vector-database ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:attention-mechanism,
        ngm:multi-head-attention ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:positional-encoding,
        ngm:query-key-value,
        ngm:query-vector,
        ngm:self-attention,
        ngm:value-vector ;
    vc:requires ngm:token-embedding,
        ngm:transformer ;
    vc:slug "key-vector" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:embedding-model .

ngm:khronos-group-gl-tf-2-0-specification a owl:Class ;
