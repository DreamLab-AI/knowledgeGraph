    vc:sourceDomain "robotics" ;
    vc:uses ngm:robo-actuation-and-control,
        ngm:robo-navigation-and-planning .

ngm:online-identity a owl:Class ;
    rdfs:label "Online Identity"@en ;
    rdfs:comment "The digital representation and persistent persona that an individual constructs and maintains across online platforms and virtual environments, encompassing usernames, avatars, credentials, reputation data, and linked digital assets. Online identity management raises questions of authentication, portability, privacy, and the mapping between real-world and digital personas."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:authentication ],
