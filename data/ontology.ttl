ngm:remediation-plan a owl:Class ;
    rdfs:label "Remediation Plan"@en ;
    rdfs:comment "A remediation plan is a structured set of corrective actions, owners, and deadlines drawn up to address identified non-conformities, risks, or harms discovered through audit or monitoring. It links each finding to a specific fix and tracks progress to closure. In compliance and ethical-sourcing contexts it is the mechanism that turns a violation into demonstrable improvement."@en ;
    rdfs:subClassOf ngm:regulatory-compliance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:compliance-control,
        ngm:ethical-sourcing ;
    vc:slug "remediation-plan" ;
    vc:sourceDomain "governance" .

ngm:render-target a owl:Class ;
    rdfs:label "Render Target"@en ;
    rdfs:comment "A memory buffer or texture surface to which a GPU writes the output of a rendering pass, including the default framebuffer displayed on screen and off-screen targets used for post-processing effects, shadow maps, reflections, and multi-pass rendering in real-time graphics pipelines."@en ;
    rdfs:subClassOf ngm:render-pipeline,
        ngm:sc-display-and-rendering ;
    skos:broader ngm:sc-display-and-rendering ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:real-time-rendering-pipeline ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:pixel-shader,
        ngm:shader,
        ngm:vertex-shader ;
    vc:slug "render-target" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:compute-shader,
        ngm:gpu-compute .

ngm:renderer a owl:Class ;
    rdfs:label "Renderer"@en ;
    rdfs:comment "A renderer is the software or hardware component that converts a scene description, such as geometry, materials, lights, or a markup specification, into a final image or visual output. Renderers range from real-time rasterisers and ray tracers to text-and-diagram engines that draw from declarative source. The choice of renderer determines visual fidelity, performance, and the formats a system can produce."@en ;
    rdfs:subClassOf ngm:sc-display-and-rendering ;
    skos:broader ngm:sc-display-and-rendering ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:diagrams-as-code,
        ngm:universal-scene-description ;
    vc:slug "renderer" ;
    vc:sourceDomain "metaverse" .

ngm:replication-system a owl:Class ;
    rdfs:label "Replication System"@en ;
    rdfs:comment "A replication system maintains synchronised copies of data or state across multiple nodes in a distributed environment, ensuring consistency, availability, and fault tolerance. It coordinates state propagation through protocols such as leader-based or leaderless replication, supporting both synchronous and asynchronous update strategies in blockchain, database, and metaverse infrastructure contexts."@en ;
    rdfs:subClassOf ngm:infra-data-management ;
    skos:broader ngm:infra-data-management ;
    vc:dependsOn ngm:consensus-mechanism,
        ngm:distributed-system ;
    vc:enables ngm:fault-tolerance,
        ngm:high-availability ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:implements ngm:data-replication ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:database-system ;
    vc:slug "replication-system" ;
    vc:sourceDomain "infrastructure" .

ngm:reporting-mechanisms a owl:Class ;
    rdfs:label "Reporting Mechanisms"@en ;
    rdfs:comment "Reporting mechanisms are the user-facing tools and processes through which people flag illegal content, abuse, or policy violations to a platform or authority. They are a mandated component of content-moderation regimes, requiring accessible channels, acknowledgement, and traceable handling of notices. Well-designed mechanisms balance ease of reporting against abuse of the reporting system itself."@en ;
    rdfs:subClassOf ngm:metaverse-governance-and-safeguarding ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:community-standards,
        ngm:digital-services-act ;
    vc:slug "reporting-mechanisms" ;
    vc:sourceDomain "governance" .

ngm:request-response-pattern a skos:Concept ;
