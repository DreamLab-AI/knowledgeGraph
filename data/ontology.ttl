        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:sparql-endpoint ],
        ngm:sc-standards-and-interop ;
    skos:broader ngm:sc-standards-and-interop ;
    vc:enables ngm:automated-reasoning,
        ngm:knowledge-graph-construction,
        ngm:ontology-based-data-access,
        ngm:semantic-interoperability ;
    vc:hasMaturity ngmi:maturity-established ;
