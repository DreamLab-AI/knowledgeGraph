ngm:open-metaverse a owl:Class ;
    rdfs:comment "The open metaverse is a vision of interconnected virtual worlds built on open standards, interoperable formats, and user-owned assets and identity, in contrast to closed, single-vendor platforms. It emphasises portability of avatars, content, and value across experiences, decentralised ownership, and protocols rather than walled gardens. The open metaverse depends on shared standards for 3D assets, identity, and interoperability so that participation is not locked to any one provider."@en ;
    rdfs:label "Open Metaverse"@en ;
    rdfs:subClassOf ngm:metaverse ;
