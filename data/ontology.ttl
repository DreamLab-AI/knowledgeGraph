    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:decentralised-exchange ;
    vc:relatedTo ngm:stablecoin ;
    vc:relatedTo ngm:tokenomics ;
    vc:slug "cross-chain-liquidity" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:de-fi ;
    vc:supports ngm:dex ;
    vc:uses ngm:atomic-swap ;
    vc:uses ngm:cross-chain-bridge ;
    vc:uses ngm:liquidity-pool ;
    vc:uses ngm:relayer .
