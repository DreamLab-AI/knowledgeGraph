        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:robo-actuation-and-control ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:sensor-fusion ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:robo-human-robot-interaction ],
        ngm:technology-domain ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:autonomous-robot,
        ngm:motion-planning,
        ngm:perception-system,
        ngm:robo-actuation-and-control,
        ngm:robo-human-robot-interaction,
        ngm:sensor-fusion ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:human-robot-interaction,
        ngm:robotics ;
    vc:slug "robotics-domain" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:computer-vision,
        ngm:machine-learning .

ngm:royalty-distribution a owl:Class ;
    rdfs:label "Royalty Distribution"@en ;
    rdfs:comment "Automated, trustless distribution of royalty payments to creators and rights-holders via blockchain smart contracts, triggered on every secondary-market sale or licensing event, enforcing on-chain revenue sharing without intermediaries and enabling programmable intellectual property economics."@en ;
    rdfs:subClassOf ngm:bc-defi-and-economics ;
    skos:broader ngm:bc-defi-and-economics ;
    vc:enables ngm:digital-asset ;
    vc:hasMaturity ngmi:maturity-established ;
