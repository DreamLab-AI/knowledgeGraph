    vc:slug "decentralised-agent-coordination-initiative" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:distributed-computing,
        ngm:distributed-identity,
        ngm:nostr-protocol .

ngm:decentralised-authentication a owl:Class ;
    rdfs:label "Decentralised Authentication"@en ;
    rdfs:comment "Decentralised authentication verifies the identity of a party without relying on a single central identity provider, instead using cryptographic keys, decentralised identifiers and verifiable credentials controlled by the user. The holder proves control of an identifier and presents credentials that a verifier checks against a distributed trust registry rather than a federated login service. This shifts control of identity from platforms to individuals while preserving cryptographic assurance."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:did-document ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:trust-anchor ],
        ngm:authentication-protocol ;
    vc:bridgesTo ngm:verifiable-credentials ;
    vc:contrastsWith ngm:centralised-identity,
        ngm:user-authentication ;
    vc:dependsOn ngm:decentralised-identifiers ;
    vc:enables ngm:decentralised-identity,
        ngm:self-sovereign-identity-ssi ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:implements ngm:authentication-protocol ;
    vc:isPartOf ngm:decentralised-identity ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:blockchain-identity,
        ngm:oauth-2-0 ;
    vc:requires ngm:did-document,
        ngm:trust-anchor ;
    vc:slug "decentralised-authentication" ;
    vc:sourceDomain "security" ;
    vc:supports ngm:multi-factor-authentication,
        ngm:web-authn ;
    vc:uses ngm:decentralised-identifiers,
        ngm:did-method,
        ngm:verifiable-credentials .

ngm:decentralized-authentication a owl:Class ;
    rdfs:label "Decentralized Authentication"@en ;
    rdfs:comment "Decentralised Authentication is an approach to verifying identity claims without relying on a single central authority or identity provider. It uses cryptographic credentials, decentralised identifiers and distributed trust mechanisms so that users control their own authentication material and prove claims directly to relying parties. The model reduces single points of failure, limits data centralisation and aligns with self-sovereign identity principles."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:verifiable-credentials ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptography ],
        ngm:authentication ;
    vc:bridgesTo ngm:zero-knowledge-proof ;
    vc:contrastsWith ngm:oauth,
        ngm:single-sign-on ;
    vc:dependsOn ngm:blockchain,
        ngm:decentralized-identity ;
    vc:enables ngm:decentralized-identity,
        ngm:self-sovereign-identity ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:authentication ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:digital-identity,
        ngm:identity-provider ;
    vc:requires ngm:cryptography,
        ngm:verifiable-credentials ;
    vc:slug "decentralized-authentication" ;
    vc:sourceDomain "security" ;
    vc:supports ngm:biometric-authentication,
        ngm:multi-factor-authentication ;
    vc:uses ngm:digital-signature,
        ngm:public-key-cryptography .

ngm:decentralized-swarm-control a owl:Class ;
    rdfs:label "Decentralized Swarm Control"@en ;
    rdfs:comment "Decentralised swarm control distributes decision-making across all robot agents, where each robot computes commands based solely on local sensor information and direct communication with neighbouring agents."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:emergent-behavior ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:inter-agent-communication ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:asynchronous-coordination ],
        ngm:robo-robot-type,
        ngm:swarm-robotics ;
    skos:broader ngm:robo-robot-type ;
    vc:enables ngm:adaptive-behaviour,
        ngm:fault-tolerance,
        ngm:scalability ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:emergent-behavior ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires ngm:asynchronous-coordination,
        ngm:inter-agent-communication ;
    vc:slug "decentralized-swarm-control" ;
    vc:sourceDomain "robotics" .

ngm:deep-dao a owl:Class ;
    rdfs:label "DeepDAO"@en ;
    rdfs:comment "DeepDAO is a leading analytics and data aggregation platform dedicated to tracking and measuring the organisational health, financial activity, governance participation, and membership dynamics of decentralised autonomous organisations across multiple blockchain networks. It provides standardised metrics — total assets under management, number of token holders, proposal counts, voter participation rates, and delegate rankings — that enable comparative analysis of DAO ecosystems and inform investment, research, and governance design decisions."@en ;
    rdfs:subClassOf ngm:dao-analytics ;
    vc:enables ngm:dao-governance,
        ngm:decentralized-governance,
        ngm:decision-transparency ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:dao,
        ngm:dao-tooling ;
    vc:slug "deep-dao" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:blockchain-analytics,
        ngm:governance-token,
        ngm:on-chain-governance .

ngm:deferred-rendering a owl:Class ;
    rdfs:label "Deferred Rendering"@en ;
    rdfs:comment "Deferred rendering is a real-time shading technique that separates geometry processing from lighting by first rasterising scene attributes into a set of screen-space buffers, then computing lighting in a second pass over those buffers. By storing per-pixel position, normal, albedo, and material data in a geometry buffer, lighting cost becomes independent of scene complexity and scales with the number of lights instead. This decoupling makes it efficient to render scenes with many dynamic light sources."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gpu-rendering ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:graphics-pipeline ],
        ngm:rendering-technique ;
    vc:contrastsWith ngm:rasterization ;
    vc:enables ngm:global-illumination ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:implements ngm:rendering-technique ;
    vc:isPartOf ngm:rendering-technique ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:graphics-pipeline,
        ngm:rasterization,
        ngm:real-time-rendering ;
    vc:requires ngm:gpu-rendering,
        ngm:graphics-pipeline ;
    vc:slug "deferred-rendering" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:real-time-rendering ;
    vc:uses ngm:gpu-rendering,
        ngm:rasterization,
        ngm:shader .

ngm:delegation-registry a owl:Class ;
    rdfs:label "Delegation Registry"@en ;
    rdfs:comment "A delegation registry is an on-chain contract that records mappings from a token holder's address to a delegate authorised to act or vote on their behalf. In DAO governance it lets holders assign their voting power to a representative without transferring assets, and the registry serves as the canonical source consulted when tallying votes. It enables liquid democracy patterns and separation of custody from voting authority."@en ;
    rdfs:subClassOf ngm:smart-contract ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:on-chain-voting,
        ngm:snapshot-voting ;
    vc:slug "delegation-registry" ;
    vc:sourceDomain "blockchain" .

ngm:demand-response-mining a owl:Class ;
    rdfs:label "Demand Response Mining"@en ;
    rdfs:comment "Demand response mining is the practice of operating cryptocurrency miners as a flexible, interruptible electrical load that ramps up or down in response to grid conditions and price signals. Miners absorb surplus or stranded generation and shut off during peak demand, helping balance the grid while monetising otherwise curtailed energy. It is studied as both a grid-stabilisation tool and a mitigation for the environmental criticism of proof-of-work mining."@en ;
    rdfs:subClassOf ngm:sustainability ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:bitcoin-proof-of-work-protocol-environmental-issues,
        ngm:stranded-energy-monetisation ;
    vc:slug "demand-response-mining" ;
    vc:sourceDomain "blockchain" .

ngm:democratic-participation a owl:Class ;
    rdfs:label "Democratic Participation"@en ;
    rdfs:comment "The mechanisms and systems enabling citizens to engage in collective decision-making processes within virtual environments, digital governance platforms, and metaverse communities, encompassing voting, deliberation, and civic engagement through immersive technologies and decentralized governance ..."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:governance-framework ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:voting-systems ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:identity-verification ],
        ngm:sc-governance-and-safety ;
    skos:broader ngm:sc-governance-and-safety ;
    vc:bridgesTo ngm:digital-governance ;
    vc:enables ngm:civic-participation,
        ngm:community-decision-making ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires ngm:governance-framework,
        ngm:identity-verification,
        ngm:voting-systems ;
    vc:slug "democratic-participation" ;
    vc:sourceDomain "spatial-computing" .

ngm:democratic-values a owl:Class ;
    rdfs:label "Democratic Values"@en ;
    rdfs:comment "Principles and practices of democratic governance—including pluralism, participatory decision-making, transparent governance, electoral integrity, free formation of political will, and protection of civic space—which AI systems and digital platforms should respect and strengthen rather than undermine. As codified in the OECD AI Principles 2024 and the EU AI Act, these values impose specific constraints on AI deployment in electoral, civic, and public-interest contexts."@en ;
    rdfs:subClassOf ngm:infra-legal-and-regulatory,
        ngm:policy-enforcement ;
    skos:broader ngm:infra-legal-and-regulatory ;
    vc:contrastsWith ngm:attack-vector ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:democratic-governance,
        ngm:eu-ai-act-regulatory-instrument,
        ngm:privacy ;
    vc:slug "democratic-values" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:accountability,
        ngm:governance,
        ngm:transparency .

ngm:depth-camera a owl:Class ;
    rdfs:label "Depth Camera"@en ;
    rdfs:comment "A depth camera is a sensor that captures, for each pixel, the distance from the camera to objects in the scene, producing a depth map or 3D point cloud rather than only colour intensity. Common operating principles include structured light, time-of-flight, and stereo disparity, often combined with a colour stream to yield RGB-D data. Depth cameras are foundational sensors for spatial perception, enabling reconstruction, mapping, and interaction with three-dimensional environments."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:calibration ],
        ngm:camera ;
    vc:bridgesTo ngm:computer-vision ;
    vc:contrastsWith ngm:lidar ;
    vc:enables ngm:depth-sensing,
        ngm:point-cloud,
        ngm:spatial-mapping ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:sensor ;
    vc:isPartOf ngm:perception ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:mapping,
        ngm:object-detection,
        ngm:photogrammetry ;
    vc:requires ngm:calibration ;
    vc:slug "depth-camera" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:augmented-reality,
        ngm:gesture-recognition,
        ngm:slam ;
    vc:uses ngm:stereo-vision,
        ngm:structured-light .

ngm:deregulation a owl:Class ;
    rdfs:label "Deregulation"@en ;
    rdfs:comment "Deregulation is the process of removing, reducing, or simplifying government rules and controls that constrain how firms operate in a market, typically to increase competition, lower barriers to entry, and improve economic efficiency. It is the deliberate counterpart to regulation and is often pursued in sectors such as telecommunications, finance, energy, and transport. Deregulation does not mean the absence of oversight but rather a shift toward lighter-touch or market-based governance."@en ;
    rdfs:subClassOf ngm:regulation ;
    vc:bridgesTo ngm:internet-governance ;
    vc:contrastsWith ngm:regulation,
        ngm:regulatory-compliance ;
    vc:dependsOn ngm:policy ;
    vc:enables ngm:telecommunications ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:governance,
        ngm:regulation ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:digital-governance,
        ngm:digital-regulation,
        ngm:financial-regulation,
        ngm:governance-framework,
        ngm:net-neutrality ;
    vc:slug "deregulation" ;
    vc:sourceDomain "governance" ;
    vc:supports ngm:compliance .

ngm:derivative-control a owl:Class ;
    rdfs:label "Derivative Control"@en ;
    rdfs:comment "Derivative control responds to the rate of change of system error, providing damping that opposes oscillations and improves transient response."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:error-signal ],
        ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires ngm:error-signal,
        ngm:gain-tuning ;
    vc:slug "derivative-control" ;
    vc:sourceDomain "robotics" .

ngm:destination-chain-execution a owl:Class ;
    rdfs:label "Destination Chain Execution"@en ;
    rdfs:comment "Destination chain execution is the phase of a cross-chain operation in which a message or transaction validated from a source chain is finally executed on the target blockchain. After relayers and verification prove the source event, the destination chain mints, releases, or calls a contract to complete the bridged action. Correct execution requires replay protection, message ordering guarantees, and trust in the verification layer."@en ;
    rdfs:subClassOf ngm:cross-chain-bridge ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:blockchain-interoperability,
        ngm:cross-chain-bridge ;
    vc:slug "destination-chain-execution" ;
    vc:sourceDomain "blockchain" .

ngm:detailed-balance a owl:Class ;
    rdfs:label "Detailed Balance"@en ;
    rdfs:comment "Detailed balance is a condition on a Markov chain stating that, in equilibrium, the probability flux between any two states is equal in both directions. When a transition kernel satisfies detailed balance with respect to a target distribution, that distribution is a stationary distribution of the chain. It is the central design principle behind most Markov chain Monte Carlo samplers, including Metropolis-Hastings."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:markov-chain ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:probability-distribution ],
        ngm:markov-chain-monte-carlo ;
    vc:contrastsWith ngm:stochastic-process ;
    vc:enables ngm:markov-chain-monte-carlo,
        ngm:sampling ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:markov-chain ;
    vc:isPartOf ngm:markov-chain-monte-carlo ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:convergence,
        ngm:posterior-distribution,
        ngm:probabilistic-model,
        ngm:sampling ;
    vc:requires ngm:markov-chain,
        ngm:probability-distribution ;
    vc:slug "detailed-balance" ;
    vc:sourceDomain "ai" ;
    vc:supports ngm:bayesian-inference ;
    vc:uses ngm:stochastic-process .

ngm:deterministic-networking a skos:Concept ;
    rdfs:label "Deterministic Networking"@en .

ngm:di-lo-co a owl:Class ;
    rdfs:label "DiLoCo"@en ;
    rdfs:comment "DiLoCo (Distributed Low-Communication training) is a method for training large language models across loosely connected, geographically distributed compute clusters with minimal inter-node communication. Workers perform many local optimisation steps before periodically synchronising via an outer optimiser, drastically reducing the bandwidth and latency demands of conventional data-parallel training. It enables collaborative model training over the public internet rather than within a single tightly coupled datacentre."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:collective-communication ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:collective-communication ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:adam-optimiser ],
        ngm:distributed-ai-training,
        ngm:distributed-computing,
        ngm:federated-learning ;
    vc:enables ngm:collaborative-model-ownership,
        ngm:compute-democratisation,
        ngm:decentralised-ai ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:collective-communication,
        ngm:local-sgd,
        ngm:pseudo-gradient-aggregation ;
    vc:qualityScore "0.95"^^xsd:float ;
    vc:relatedTo ngm:bittensor,
        ngm:distributed-ai-training,
        ngm:federated-learning,
        ngm:prime-intellect ;
    vc:requires ngm:adam-optimiser,
        ngm:checkpoint-recovery,
        ngm:collective-communication ;
    vc:slug "di-lo-co" ;
    vc:sourceDomain "ai" .

ngm:did-nostr a owl:Class ;
    rdfs:label "did:nostr"@en ;
    rdfs:comment "did:nostr is a W3C DID Core-conformant decentralised identifier method that represents a Nostr public key as a universally resolvable DID of the form did:nostr:{pubkey}, where {pubkey} is the 64-character hex secp256k1 key already used by the Nostr protocol. Because the identifier is the key, no registration, server, or fee is required: anyone with a Nostr keypair already has a DID. Resolution degrades gracefully across three layers — HTTP fetch of a .well-known/did/nostr/{pubkey}.json document, relay-enhanced resolution from Nostr kind 0 (metadata) and kind 10002 (relay list) events, and an offline fallback that derives a minimal valid DID document from the key alone. Keys are expressed in W3C Multikey/Multibase form (secp256k1 multicodec), letting Nostr identities authenticate to any DID-aware system, including Solid login, SSO, and verifiable-credential flows."@en ;
    rdfs:subClassOf ngm:did-method ;
    vc:bridgesTo ngm:block-trails,
        ngm:javascript-solid-server,
        ngm:solid,
        ngm:web-id ;
    vc:contrastsWith ngm:did-web ;
    vc:dependsOn ngm:did-resolution ;
    vc:enables ngm:self-sovereign-identity,
        ngm:single-sign-on,
        ngm:solid-oidc,
        ngm:w3-c-verifiable-credentials ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:implements ngm:decentralised-identifier,
        ngm:w3-c-did-core ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:decentralised-identity,
        ngm:web-authn,
        ngm:web-contracts ;
    vc:slug "did-nostr" ;
    vc:sourceDomain "security" ;
    vc:uses ngm:multibase,
        ngm:nostr,
        ngm:schnorr-signature,
        ngm:secp256k1 .

ngm:differential-dynamic-programming a owl:Class ;
    rdfs:label "Differential Dynamic Programming"@en ;
    rdfs:comment "Differential Dynamic Programming (DDP) is a trajectory-optimisation algorithm that solves optimal-control problems by iteratively improving a control sequence using second-order local approximations of the dynamics and cost along the current trajectory. It performs a backward pass computing value-function derivatives and feedback gains, followed by a forward pass that applies the improved controls, converging quadratically near a solution. Together with its Gauss-Newton variant iLQR, DDP is widely used in robotics and model-predictive control for generating smooth, dynamically feasible motions."@en ;
    rdfs:subClassOf ngm:optimal-control ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:markov-decision-process ;
    vc:slug "differential-dynamic-programming" ;
    vc:sourceDomain "robotics" ;
    vc:supports ngm:model-predictive-control ;
    vc:uses ngm:control-theory .

ngm:difficulty a owl:Class ;
    rdfs:label "Difficulty"@en ;
    rdfs:comment "Difficulty is a dynamic parameter in proof-of-work blockchain systems that expresses the computational effort required to find a valid block hash—specifically, the number of leading zeros (or equivalent target threshold) that a candidate block hash must satisfy for the block to be accepted by the network. The difficulty value is adjusted periodically by the protocol based on the observed rate of block production relative to the target interval, ensuring that new blocks are produced at a predictable rate regardless of fluctuations in aggregate network hash rate. Difficulty is the primary mechanism by which proof-of-work blockchains self-regulate their monetary policy and security budget."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:hash-function ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:proof-of-work ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:difficulty-adjustment ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:nonce ],
        ngm:bc-cryptographic-primitive,
        ngm:blockchain-entity,
        ngm:cryptographic-primitive ;
    skos:broader ngm:bc-cryptographic-primitive ;
    vc:dependsOn ngm:blockchain-network ;
    vc:enables ngm:consensus-protocol,
        ngm:mining ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:difficulty-adjustment,
        ngm:nonce ;
    vc:isPartOf ngm:blockchain-protocol,
        ngm:consensus-mechanism ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:block-height,
        ngm:block-time,
        ngm:blockchain-energy-consumption,
        ngm:mining-reward ;
    vc:requires ngm:hash-function,
        ngm:proof-of-work ;
    vc:slug "difficulty" ;
    vc:sourceDomain "blockchain" .

ngm:digital-asset-regulation a owl:Class ;
    rdfs:label "Digital Asset Regulation"@en ;
    rdfs:comment "Digital asset regulation is the body of legal and supervisory rules governing the issuance, trading, custody, and use of cryptographic assets such as cryptocurrencies, tokens, and stablecoins. It spans securities law, anti-money-laundering requirements, consumer and investor protection, and bespoke frameworks tailored to blockchain-based instruments. Because asset classifications and jurisdictional approaches differ widely, the field is characterised by evolving guidance, enforcement actions, and efforts toward harmonised cross-border standards."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:audit ],
        ngm:financial-regulation ;
    vc:bridgesTo ngm:asset-tokenization,
        ngm:digital-securities ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:implements ngm:securities-law,
        ngm:securities-regulation ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:crypto-asset,
        ngm:cryptocurrency-regulation,
        ngm:digital-asset,
        ngm:stablecoin ;
    vc:requires ngm:audit ;
    vc:slug "digital-asset-regulation" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:investor-protection,
        ngm:regulatory-compliance ;
    vc:uses ngm:compliance,
        ngm:howey-test .

ngm:digital-heritage a owl:Class ;
    rdfs:label "Digital Heritage"@en ;
    rdfs:comment "The digitisation, preservation, and interactive presentation of cultural artefacts, historical sites, and intangible heritage through spatial computing technologies such as 3D reconstruction, AR, and VR. Digital heritage enables remote access, scholarly analysis, and public engagement with cultural memory that may otherwise be physically inaccessible or at risk of loss."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:cultural-heritage-xr-experience ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:archival-standards ],
