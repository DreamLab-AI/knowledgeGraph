ngm:confidential-computing a owl:Class ;
    rdfs:label "Confidential Computing"@en ;
    rdfs:comment "A hardware-based security paradigm that protects data in use by isolating computation within trusted execution environments (TEEs) backed by processor security extensions (Intel SGX, AMD SEV, ARM TrustZone). It extends encryption from data at rest and in transit to data actively being processed, preventing access even by privileged software, hypervisors, or cloud providers. Key AI applications include secure model training, private inference, and TEE-protected federated learning aggregation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:secure-enclave ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:trusted-execution-environment ],
        ngm:hardware-security ;
    vc:bridgesTo ngm:blockchain,
        ngm:digital-twin ;
    vc:contrastsWith ngm:full-disk-encryption,
        ngm:transport-layer-security ;
    vc:dependsOn ngm:amd-sev,
        ngm:arm-trustzone,
        ngm:intel-sgx ;
    vc:enables ngm:federated-learning,
        ngm:privacy-preserving-machine-learning,
        ngm:private-inference ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:remote-attestation,
        ngm:secure-enclave,
        ngm:trusted-execution-environment ;
    vc:implements ngm:zero-trust-architecture ;
    vc:isPartOf ngm:cloud-security ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:ai-security,
        ngm:cybersecurity,
        ngm:data-security ;
    vc:requires ngm:memory-encryption,
        ngm:processor-security-extensions ;
    vc:slug "confidential-computing" ;
    vc:sourceDomain "security" ;
    vc:standardizedBy ngm:confidential-computing-consortium ;
    vc:supports ngm:gdpr-compliance,
        ngm:hardware-security-module ;
    vc:uses ngm:differential-privacy,
        ngm:homomorphic-encryption,
        ngm:secure-multi-party-computation .

ngm:content-addressed-storage a owl:Class ;
    rdfs:label "Content-Addressed Storage"@en ;
    rdfs:comment "Content-addressed storage (CAS) is a data storage paradigm in which each piece of data is identified and retrieved by a cryptographic hash of its content rather than by its location or a human-assigned name. Because the identifier is derived deterministically from the data itself, identical content always maps to the same address, enabling automatic deduplication and verifiable integrity without requiring trust in the storage provider. Content-addressed storage forms the basis of distributed systems such as IPFS, Git, and Arweave, and underlies the content-integrity mechanisms of blockchain data layers. It is fundamentally different from location-addressed storage, where the same content can exist at multiple addresses or the same address can point to different content over time."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:hash-function ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:content-identifier ],
        ngm:data-storage ;
    vc:bridgesTo ngm:blockchain-data-layer,
        ngm:dataset-versioning,
        ngm:model-registry ;
    vc:contrastsWith ngm:location-addressed-storage,
        ngm:object-storage ;
    vc:enables ngm:cryptographic-verification,
        ngm:data-availability,
        ngm:data-deduplication,
        ngm:reproducible-builds,
        ngm:tamper-evidence,
        ngm:verifiable-provenance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:arweave,
        ngm:filecoin,
        ngm:git,
        ngm:ipfs ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:data-integrity,
        ngm:zero-knowledge-proof ;
    vc:requires ngm:content-identifier,
        ngm:hash-function ;
    vc:slug "content-addressed-storage" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:decentralized-storage,
        ngm:distributed-storage,
        ngm:peer-to-peer-network,
        ngm:version-control ;
    vc:uses ngm:content-addressing,
        ngm:cryptographic-hash,
        ngm:distributed-hash-table,
        ngm:kzg-commitment,
        ngm:merkle-tree .

ngm:data-lineage a owl:Class ;
    rdfs:label "Data Lineage"@en ;
    rdfs:comment "Data lineage is the documented record of data's origins, movements, transformations and consumption as it flows through systems and pipelines. It maps how a data element is derived end to end, supporting impact analysis, debugging, audit and regulatory compliance. As a pillar of data governance and metadata management it makes data trustworthy by exposing its provenance."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:data-provenance ],
