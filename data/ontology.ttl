        ngm:mcmc-sampling,
        ngm:neural-sde,
        ngm:reinforcement-learning,
        ngm:uncertainty-quantification ;
    vc:hasPart ngm:filtration,
        ngm:gaussian-process,
        ngm:l-vy-process,
        ngm:markov-chain,
        ngm:martingale,
        ngm:ornstein-uhlenbeck-process,
        ngm:poisson-process,
        ngm:sample-path,
        ngm:stochastic-differential-equation,
        ngm:wiener-process ;
    vc:implements ngm:chapman-kolmogorov-equation,
        ngm:detailed-balance,
        ngm:fokker-planck-equation,
        ngm:it-lemma,
        ngm:kolmogorov-backward-equation,
        ngm:markov-property,
        ngm:score-matching ;
    vc:maturity "established" ;
    vc:qualityScore "0.52"^^xsd:float ;
    vc:relatedTo ngm:control-theory,
        ngm:deep-learning,
        ngm:diffusion-models,
        ngm:information-theory,
        ngm:machine-learning,
        ngm:statistical-physics ;
    vc:requires ngm:filtration,
        ngm:it-calculus,
        ngm:measure-theory,
        ngm:probability-space,
        ngm:sigma-algebra,
        ngm:stochastic-integration ;
    vc:slug "stochastic-process" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:standardizedBy ngm:annals-of-probability,
        ngm:journal-of-the-royal-statistical-society,
        ngm:probability-theory-and-related-fields,
        ngm:stochastic-processes-and-their-applications ;
