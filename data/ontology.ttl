ngm:allo-protocol a owl:Class ;
    rdfs:label "Allo Protocol"@en ;
    rdfs:comment "Allo Protocol is an on-chain framework developed by Gitcoin for allocating capital, supporting funding mechanisms such as quadratic funding and grants."@en ;
