ngm:cross-platform-rendering a owl:Class ;
    rdfs:comment "Cross-platform rendering is a rendering approach that produces consistent visual output across different operating systems, hardware GPUs and graphics APIs, typically by targeting an abstraction layer rather than a single vendor-specific API. It allows a single rendering codebase to run on Windows, macOS, Linux, mobile and web targets, translating draw calls to the underlying native graphics API such as Vulkan, Metal or DirectX. Standards bodies such as the Khronos Group maintain the graphics APIs and specifications that make cross-platform rendering practical."@en ;
    rdfs:label "Cross-Platform Rendering"@en ;
    rdfs:subClassOf ngm:graphics-api ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.55"^^xsd:float ;
    vc:slug "cross-platform-rendering" ;
    vc:sourceDomain "spatial-computing" ;
