ngm:signal-processing a owl:Class ;
    rdfs:label "Signal Processing"@en ;
    rdfs:comment "Signal Processing is the mathematical discipline concerned with the analysis, synthesis, filtering, transformation, and compression of analogue and digital signals including audio, video, sensor telemetry, and communications data. In spatial computing and immersive systems, signal processing underpins spatial audio rendering, motion capture noise reduction, depth-sensor filtering, and the real-time fusion of multi-modal sensor streams required for robust AR/VR tracking and interaction."@en ;
    rdfs:subClassOf ngm:sc-display-and-rendering ;
    skos:broader ngm:sc-display-and-rendering ;
    vc:enables ngm:depth-sensing,
        ngm:spatial-audio,
        ngm:speech-recognition ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:relatedTo ngm:motion-capture,
        ngm:render-pipeline ;
    vc:slug "signal-processing" ;
    vc:sourceDomain "spatial-computing" .

ngm:sparql a owl:Class ;
    rdfs:label "SPARQL"@en ;
    rdfs:comment "SPARQL (SPARQL Protocol and RDF Query Language) is a W3C Recommendation defining a query language, update language, and HTTP-based protocol for retrieving and modifying data stored in RDF graph databases and Linked Data endpoints. SPARQL 1.1 (2013) introduced federated queries across multiple SPARQL endpoints via the SERVICE keyword, property paths for navigating arbitrary-length chains of RDF triples, aggregation functions, and the SPARQL Update (SPARUL) sublanguage for graph mutation. It is the standard access layer for the Semantic Web and knowledge graph ecosystems, analogous to SQL for relational databases."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:graph-database ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
