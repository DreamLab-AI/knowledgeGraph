    vc:slug "screen-capture" ;
    vc:sourceDomain "infrastructure" .

ngm:sd-jwt-vc a owl:Class ;
    rdfs:label "SD-JWT VC"@en ;
    rdfs:comment "A verifiable credential format that uses Selective Disclosure JSON Web Tokens, allowing a holder to reveal only chosen claims to a verifier. It combines the JWT structure with salted hashes that support selective disclosure."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:json-data-interchange-format-web-token ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:selective-disclosure ],
        ngm:json-data-interchange-format-web-token ;
    vc:enables ngm:digital-identity ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:json-data-interchange-format-web-token,
        ngm:selective-disclosure ;
    vc:slug "sd-jwt-vc" ;
    vc:sourceDomain "security" .

ngm:sdxl a owl:Class ;
    rdfs:label "SDXL"@en ;
    rdfs:comment "SDXL (Stable Diffusion XL) is a large-scale latent diffusion model released by Stability AI in 2023, comprising a 3.5-billion-parameter UNet and an ensemble of two CLIP text encoders that condition image generation at native 1024×1024 resolution. It introduces a two-stage architecture — a base model followed by a refinement model — and supports advanced conditioning mechanisms including aesthetic scoring and crop coordinates."@en ;
    rdfs:subClassOf ngm:latent-diffusion ;
    vc:contrastsWith ngm:stable-diffusion-image-model ;
    vc:enables ngm:image-generation,
        ngm:lo-ra-fine-tuning ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:diffusion-model,
        ngm:hugging-face-diffusers ;
    vc:slug "sdxl" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:classifier-free-guidance,
        ngm:clip-encoder,
        ngm:vae .

ngm:section-508 a owl:Class ;
    rdfs:label "Section 508"@en ;
    rdfs:comment "Section 508 is an amendment to the US Rehabilitation Act requiring federal agencies to make their electronic and information technology accessible to people with disabilities. Its 2017 refresh harmonised the technical requirements with the WCAG 2.0 Level AA success criteria. It functions as an enforceable procurement and compliance standard for accessibility in US government IT."@en ;
    rdfs:subClassOf ngm:technical-standard ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:accessibility ;
