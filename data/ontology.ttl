ngm:document-store a owl:Class ;
    rdfs:label "Document Store"@en ;
    rdfs:comment "A document store is a category of NoSQL database that persists, retrieves, and manages data as self-describing documents, typically encoded as JSON, BSON, or XML. Each document is a flexible, schema-optional aggregate that groups related data together, allowing nested structures and varying fields across records. Document stores favour horizontal scalability and developer-friendly data modelling over the rigid tabular schema of relational databases."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:persistence ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:query-engine ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:data-model ],
        ngm:database ;
    vc:contrastsWith ngm:relational-database ;
    vc:dependsOn ngm:data-format ;
    vc:enables ngm:query-engine ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:data-model,
        ngm:query-engine ;
    vc:isPartOf ngm:database,
        ngm:infrastructure ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:data-schema,
        ngm:schema-registry,
        ngm:xml ;
    vc:requires ngm:persistence ;
    vc:slug "document-store" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:data-integration ;
    vc:uses ngm:data-format,
        ngm:persistence .

ngm:document-summarisation a owl:Class ;
    rdfs:label "Document Summarisation"@en ;
    rdfs:comment "Document summarisation is the natural language processing task of producing a concise, faithful representation of the salient information in one or more source documents. It encompasses extractive approaches, which select and concatenate important spans, and abstractive approaches, which generate new text that paraphrases the content. Modern systems are built predominantly on transformer-based large language models and are evaluated for informativeness, coherence, and factual consistency."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:model-evaluation ],
        ngm:natural-language-processing ;
    vc:bridgesTo ngm:knowledge-management ;
    vc:enables ngm:information-retrieval,
        ngm:knowledge-management ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:natural-language-processing ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:content-generation,
        ngm:document-processing,
        ngm:generative-ai ;
    vc:requires ngm:model-evaluation ;
    vc:slug "document-summarisation" ;
    vc:sourceDomain "ai" ;
    vc:supports ngm:question-answering,
        ngm:semantic-search ;
    vc:uses ngm:large-language-models,
        ngm:text-summarisation,
        ngm:transformer .

