    vc:enables ngm:automated-reasoning,
        ngm:knowledge-graph-construction,
        ngm:semantic-interoperability ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:namespace-declarations,
        ngm:ontology-property-definitions,
        ngm:owl-class-hierarchy,
        ngm:validation-constraints ;
    vc:isPartOf ngm:knowledge-representation,
        ngm:semantic-web-linked-data-standard-infrastructure ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:rdf-triple-store,
        ngm:sparql-endpoint ;
    vc:slug "metaverse-ontology-schema" ;
    vc:sourceDomain "spatial-computing" .

ngm:micro-oled-display a owl:Class ;
    rdfs:label "Micro-OLED Display"@en ;
    rdfs:comment "A micro-OLED display is an organic light-emitting diode panel fabricated directly on a silicon backplane (OLED-on-silicon), yielding pixel pitches of a few micrometres and very high pixel densities. Its compact size, high contrast, fast response, and low power make it the dominant near-eye display technology for AR and VR headsets. The silicon substrate enables integrated drive circuitry impossible on glass."@en ;
    rdfs:subClassOf ngm:sc-display-and-rendering ;
    skos:broader ngm:sc-display-and-rendering ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:ar-frame,
        ngm:mixed-reality ;
    vc:slug "micro-oled-display" ;
    vc:sourceDomain "metaverse" .

ngm:microdisplay a owl:Class ;
    rdfs:label "Microdisplay"@en ;
    rdfs:comment "A microdisplay is a miniature display panel, typically under an inch diagonal, with very high pixel density, used in near-eye optical systems such as headsets, viewfinders and projectors. Built on technologies including micro-OLED, liquid-crystal-on-silicon (LCoS) and microLED, it produces a small bright image that magnifying or waveguide optics expand into a large virtual image for the eye. Microdisplays are a critical enabling component for augmented and virtual reality head-mounted displays, where size, brightness, resolution and power efficiency are paramount."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:display-hardware ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:display-hardware ],
        ngm:display-hardware ;
    vc:bridgesTo ngm:head-mounted-display ;
    vc:contrastsWith ngm:display-technology ;
    vc:dependsOn ngm:display-technology ;
    vc:enables ngm:augmented-reality,
        ngm:virtual-reality ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:display-hardware ;
    vc:implements ngm:display-technology ;
    vc:isPartOf ngm:display-technology,
        ngm:head-mounted-display ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:augmented-reality,
        ngm:head-mounted-display,
        ngm:spatial-computing ;
    vc:requires ngm:display-hardware ;
    vc:slug "microdisplay" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:spatial-computing ;
    vc:uses ngm:display-hardware .

ngm:mistral-ai-open-weight-model-family a owl:Class ;
    rdfs:label "Mistral AI Open-Weight Model Family"@en ;
    rdfs:comment "Mistral AI is a French AI company that developed a family of open-weight large language models, including the dense Mistral 7B and the sparse Mixture-of-Experts Mixtral 8x7B and 8x22B architectures. These models are distinguished by their efficient use of grouped-query attention, sliding window attention, and sparse expert routing, achieving performance competitive with much larger models at a fraction of the inference cost. Released under permissive licences, they have become foundational reference models for the open-source AI community."@en ;
    rdfs:subClassOf ngm:large-language-models ;
    vc:contrastsWith ngm:constitutional-ai-training-methodology-language-model-family,
        ngm:gpt ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:fine-tuning,
        ngm:inference-engine,
        ngm:instruction-tuning,
        ngm:open-source-ai ;
    vc:slug "mistral-ai-open-weight-model-family" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:attention-mechanism,
        ngm:context-window,
        ngm:mixture-of-experts-architecture,
        ngm:transformer-architecture .

ngm:model-complexity a owl:Class ;
    rdfs:label "Model Complexity"@en ;
    rdfs:comment "Model complexity is a measure of the capacity of a machine-learning model to fit varied patterns in data, governed by factors such as the number of parameters, the richness of the hypothesis space, and the flexibility of the functional form. Higher complexity lets a model capture intricate structure but raises the risk of overfitting, while lower complexity risks underfitting. Managing complexity is central to achieving good generalisation on unseen data."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:model-capacity ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:regularisation ],
        ngm:machine-learning ;
    vc:contrastsWith ngm:overfitting,
        ngm:underfitting ;
    vc:dependsOn ngm:hyperparameter,
        ngm:number-of-parameters ;
    vc:enables ngm:model-capacity ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:model-capacity,
        ngm:number-of-parameters,
        ngm:vc-dimension ;
    vc:isPartOf ngm:machine-learning ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:bias-variance-tradeoff,
        ngm:hyperparameter,
        ngm:model-interpretability,
        ngm:occams-razor ;
    vc:requires ngm:regularisation ;
    vc:slug "model-complexity" ;
    vc:sourceDomain "machine-learning" ;
    vc:supports ngm:generalisation ;
    vc:uses ngm:cross-validation .

ngm:model-pruning a owl:Class ;
    rdfs:label "Model Pruning"@en ;
    rdfs:comment "Model pruning is a neural-network compression technique that removes redundant or low-importance parameters, neurons, or structural components from a trained model to reduce its size and computational cost while preserving accuracy. Pruning may be unstructured, zeroing individual weights to induce sparsity, or structured, removing whole channels, filters, or layers to yield models that run faster on standard hardware. Importance is judged by criteria such as weight magnitude or sensitivity, and pruning is typically followed by fine-tuning to recover lost accuracy. It is a core method for deploying large models on resource-constrained and edge environments."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:fine-tuning ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:parameter ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:fine-tuning ],
        ngm:model-compression ;
    vc:contrastsWith ngm:knowledge-distillation ;
    vc:dependsOn ngm:neural-network ;
    vc:enables ngm:edge-computing ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:fine-tuning,
        ngm:parameter ;
    vc:isPartOf ngm:model-optimization ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:knowledge-distillation,
        ngm:model-optimization,
        ngm:parameter ;
    vc:requires ngm:fine-tuning ;
    vc:slug "model-pruning" ;
    vc:sourceDomain "machine-learning" ;
    vc:supports ngm:edge-computing,
        ngm:model-compression ;
    vc:uses ngm:fine-tuning,
        ngm:neural-network .

ngm:monitoring-infrastructure a owl:Class ;
    rdfs:label "Monitoring Infrastructure"@en ;
    rdfs:comment "Monitoring infrastructure is the collection of systems that gather, store, and analyse metrics, logs, and traces to observe the health, performance, and behaviour of software and physical systems. It underpins alerting, capacity planning, incident response, and, for AI systems, tracking of drift, cost, and environmental impact. Components typically include collectors, time-series databases, dashboards, and alerting engines."@en ;
    rdfs:subClassOf ngm:infra-computing-and-cloud ;
    skos:broader ngm:infra-computing-and-cloud ;
    vc:hasMaturity ngmi:maturity-established ;
