        ngm:algorithmic-auditing,
        ngm:model-cards,
        ngm:robustness-testing .

ngm:utxo-model a owl:Class ;
    rdfs:label "UTXO Model"@en ;
    rdfs:comment "Unspent Transaction Output accounting model used in Bitcoin and related blockchains, where each coin is represented as a discrete unspent output that must be fully consumed and re-created by a transaction. The model enables straightforward parallel validation, eliminates double-spend via simple output-state queries, and underpins script-based programmability."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:digital-signature ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptographic-hash-function ],
        ngm:bc-protocol-and-consensus ;
    skos:broader ngm:bc-protocol-and-consensus ;
    vc:bridgesTo ngm:smart-contract,
        ngm:state-channel ;
    vc:contrastsWith ngm:account-based-model,
        ngm:decentralized-finance-de-fi ;
    vc:dependsOn ngm:distributed-ledger,
        ngm:merkle-tree ;
    vc:enables ngm:cryptographic-verification,
        ngm:double-spend-prevention,
        ngm:immutability,
