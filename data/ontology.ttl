    vc:slug "admittance-control" ;
    vc:sourceDomain "robotics" .

ngm:ai-art-categorization a owl:Class ;
    rdfs:label "Ai Art Categorization"@en ;
    rdfs:comment "AI Art Categorization encompasses taxonomies, classification systems, and machine learning mods for organizing, labeling, and evaluating AI-generated and AI-assisted artworks based on creation modology, style, medium, aesthetic properties, and the degree of autonomous system involvement in the cr..."@en ;
