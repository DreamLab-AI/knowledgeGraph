# Proportional Control
robotics:ProportionalControl rdf:type owl:Class ;
    rdfs:subClassOf robotics:FeedbackControl ;
    rdfs:label "Proportional Control"@en ;
    rdfs:comment "Proportional control applies gain to current error signal."@en ;
    skos:prefLabel "Proportional Control"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:robotics:proportional-control" ;
    owl:sameAs <urn:visionclaw:concept:robotics:proportional-control> ;
