ngm:mechanical-engineering-domain a owl:Class ;
    rdfs:label "Mechanical Engineering Domain"@en ;
    rdfs:comment "The Mechanical Engineering Domain classifies concepts concerning the design, analysis and manufacture of physical mechanisms and structures. It covers kinematics, dynamics, materials and the actuation that produces motion and force. As a sub-domain of the Robotics Domain it provides the physical embodiment on which robotic and autonomous systems depend."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:control-systems-domain ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:mechanism-design ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:dynamics ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:kinematics ],
        ngm:robotics-domain ;
    vc:enables ngm:locomotion,
        ngm:physical-manipulation ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:actuation,
        ngm:dynamics,
        ngm:kinematics,
        ngm:materials,
        ngm:mechanism-design ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:control-systems-domain ;
    vc:slug "mechanical-engineering-domain" ;
    vc:sourceDomain "mechanical-engineering" .

