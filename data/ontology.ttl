    vc:slug "etsi-metaverse-domain-taxonomy" ;
    vc:sourceDomain "spatial-computing" .

ngm:high-availability a owl:Class ;
    rdfs:label "High Availability"@en ;
    rdfs:comment "High availability (HA) is an infrastructure design property that specifies and implements the conditions under which a system continues to deliver its intended service in the presence of component failures, maintenance windows, or demand spikes. HA is quantified by availability targets expressed in nines (e.g., 99.9% equates to roughly 8.7 hours of permitted downtime per year), achieved through redundant components, active-passive or active-active failover, health monitoring, and automated recovery. It is a core non-functional requirement in cloud-native, telecommunications, and financial systems where service interruption carries regulatory or commercial penalties."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:fault-tolerance ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:reliability ],
        ngm:infra-computing-and-cloud ;
    skos:broader ngm:infra-computing-and-cloud ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:data-replication,
        ngm:microservices-architecture ;
    vc:requires ngm:fault-tolerance,
        ngm:reliability ;
    vc:slug "high-availability" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:cloud-infrastructure,
        ngm:distributed-systems .

ngm:hyperparameter a owl:Class ;
    rdfs:label "Hyperparameter"@en ;
    rdfs:comment "A configuration variable set before training that controls the learning process but is not learned from data. Examples include learning rate, batch size, number of layers, dropout rate, and regularisation coefficients. Hyperparameter selection directly determines model capacity, convergence speed, and generalisation, making their tuning a critical step in building effective machine learning systems."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:batch-size ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:learning-rate-schedule ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:dropout ],
        ngm:ai-technique,
        ngm:machine-learning ;
    skos:broader ngm:ai-technique ;
    vc:enables ngm:model-training,
        ngm:neural-network-architecture ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:batch-size,
        ngm:dropout,
        ngm:learning-rate-schedule ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:auto-ml,
        ngm:deep-learning,
        ngm:gradient-descent,
        ngm:overfitting ;
    vc:slug "hyperparameter" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:stochastic-gradient-descent .

ngm:iec-61508 a owl:Class ;
    rdfs:label "IEC 61508"@en ;
    rdfs:comment "IEC 61508 is a foundational international functional safety standard published by the International Electrotechnical Commission that specifies requirements for the design, development, validation, and lifecycle management of electrical, electronic, and programmable electronic (E/E/PE) safety-related systems across all application domains. It defines Safety Integrity Levels (SIL 1–4) as quantitative risk-reduction targets and prescribes the development methods—fault trees, FMEAs, formal methods, and software design constraints—appropriate to each SIL. Sector-specific derivative standards including ISO 26262 (automotive) and EN 50128 (rail) inherit its SIL framework and lifecycle requirements."@en ;
    rdfs:subClassOf ngm:robo-safety-and-standards ;
    skos:broader ngm:robo-safety-and-standards ;
    vc:enables ngm:functional-safety,
        ngm:risk-assessment ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:autonomous-vehicle,
        ngm:cybersecurity-standard,
        ngm:embedded-systems ;
    vc:slug "iec-61508" ;
    vc:sourceDomain "robotics" ;
    vc:standardizedBy ngm:robo-safety-and-standards .

