        ngm:federated-learning ;
    vc:contrastsWith ngm:full-fine-tuning,
        ngm:knowledge-distillation ;
    vc:dependsOn ngm:backpropagation,
        ngm:gradient-descent ;
    vc:enables ngm:continual-learning,
        ngm:edge-deployment,
        ngm:multi-task-learning ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:ada-lo-ra,
        ngm:adapter-modules,
        ngm:lo-ra-fine-tuning,
        ngm:prefix-tuning,
        ngm:prompt-tuning,
        ngm:qlo-ra ;
    vc:isPartOf ngm:model-adaptation,
        ngm:transfer-learning ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:model-compression ;
    vc:requires ngm:pre-trained-model,
        ngm:training-data ;
    vc:slug "parameter-efficient-fine-tuning" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:instruction-tuning,
