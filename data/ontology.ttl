ngm:cryptographic-keys a owl:Class ;
    rdfs:label "Cryptographic Keys"@en ;
    rdfs:comment "Strings of data used in cryptographic algorithms to encrypt, decrypt, sign, or verify data, serving as the secret parameters that transform plaintext to ciphertext and vice versa."@en ;
    rdfs:subClassOf ngm:bc-cryptographic-primitive,
        ngm:cryptography ;
    skos:broader ngm:bc-cryptographic-primitive ;
    vc:enables ngm:digital-signature ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:slug "cryptographic-keys" ;
    vc:sourceDomain "blockchain" .

ngm:finality a owl:Class ;
    rdfs:label "Finality"@en ;
    rdfs:comment "The property of a blockchain transaction or block whereby it becomes irreversible and cannot be reverted by any future state of the network. Probabilistic finality—as in proof-of-work chains—increases with confirmation depth, while deterministic finality—as in BFT-based protocols—is achieved at the point of commitment, with strong consequences for payment settlement, cross-chain interoperability, and user trust."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:transaction-confirmation ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:probabilistic-finality ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:deterministic-finality ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:consensus-protocol ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:transaction-finality ],
        ngm:bc-protocol-and-consensus,
        ngm:blockchain-entity ;
    skos:broader ngm:bc-protocol-and-consensus ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:deterministic-finality,
        ngm:probabilistic-finality,
        ngm:transaction-finality ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:blockchain-transaction,
        ngm:chain-reorganization,
        ngm:nakamoto-consensus,
        ngm:proof-of-stake ;
    vc:requires ngm:consensus-protocol,
        ngm:transaction-confirmation ;
    vc:slug "finality" ;
    vc:sourceDomain "blockchain" .

ngm:functional-safety a owl:Class ;
    rdfs:label "Functional Safety"@en ;
    rdfs:comment "Functional Safety - The discipline of designing, implementing, and verifying safety-critical control systems (per IEC 61508, ISO 26262) to ensure robots fail safely and prevent hazardous failures that could harm humans, equipment, or processes through systematic risk assessment and redundancy."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:hazard-analysis ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:fault-tree-analysis ],
        ngm:robo-safety-and-standards,
        ngm:safety-engineering ;
    skos:broader ngm:robo-safety-and-standards ;
    vc:enables ngm:human-robot-safety,
        ngm:liability-mitigation,
        ngm:safe-operation-certification ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:isPartOf ngm:regulatory-compliance,
        ngm:risk-management ;
    vc:qualityScore "0.64"^^xsd:float ;
    vc:requires ngm:fault-tree-analysis,
        ngm:hazard-analysis,
        ngm:testing-and-validation ;
    vc:slug "functional-safety" ;
    vc:sourceDomain "robotics" .

ngm:privacy-by-design a owl:Class ;
    rdfs:label "Privacy By Design"@en ;
    rdfs:comment "Privacy by Design is a proactive privacy framework and GDPR requirement (Article 25) mandating that data protection be embedded into system architecture, business practices, and technologies from inception rather than bolted on as afterthought, implementing privacy as the default setting. The framework comprises seven foundational principles including data minimisation, consent management, and transparency, requiring engineers and product teams to treat privacy as a design constraint from the earliest specification stage."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-protection ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:consent-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-governance ],
        ngm:ai-governance-and-ethics ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:enables ngm:differential-privacy,
        ngm:gdpr-compliance,
        ngm:transparency ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:ai-ethics,
        ngm:ai-risk-management,
        ngm:algorithmic-accountability,
        ngm:data-protection-regulation,
        ngm:transparency-and-explainability ;
    vc:requires ngm:consent-management,
        ngm:data-governance,
        ngm:data-protection ;
    vc:slug "privacy-by-design" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:reinforcement-learning-from-human-feedback a owl:Class ;
    rdfs:label "Reinforcement Learning from Human Feedback"@en ;
    rdfs:comment "A technique for aligning language models with human preferences by training a reward model from human rankings of outputs and using reinforcement learning (typically PPO) to optimise the policy towards maximising predicted human preference."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:supervised-fine-tuning ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:human-feedback ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:reward-model ],
        ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:contrastsWith ngm:direct-preference-optimisation ;
    vc:enables ngm:ai-alignment,
        ngm:large-language-models ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires ngm:human-feedback,
        ngm:reward-model,
        ngm:supervised-fine-tuning ;
    vc:slug "reinforcement-learning-from-human-feedback" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:software-engineering a owl:Class ;
    rdfs:label "Software Engineering"@en ;
    rdfs:comment "Software Engineering is the disciplined application of systematic, quantifiable approaches to the development, operation, and maintenance of software. It encompasses requirements engineering, architectural design, implementation, testing, and DevOps practices for producing reliable, maintainable, and scalable systems. In metaverse and distributed real-time contexts, software engineering addresses concurrent state synchronisation, cross-platform compatibility, and asset pipeline management."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:software-architecture ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:software-testing ],
        ngm:infra-software-engineering ;
    skos:broader ngm:infra-software-engineering ;
    vc:enables ngm:system-integration ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:software-architecture,
        ngm:software-testing ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:relatedTo ngm:software-architecture,
        ngm:version-control ;
    vc:slug "software-engineering" ;
    vc:sourceDomain "infrastructure" .

ngm:tokenisation a owl:Class ;
    rdfs:label "Tokenisation"@en ;
    rdfs:comment "The process of breaking text into discrete units (tokens) that can be processed by neural networks, ranging from characters to subwords to whole words."@en ;
    rdfs:subClassOf ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:enables ngm:large-language-models,
        ngm:transformer-architecture ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:natural-language-processing ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:relatedTo ngm:text-generation ;
    vc:slug "tokenisation" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:neural-network .

ngm:workflow-automation a owl:Class ;
    rdfs:label "Workflow Automation"@en ;
    rdfs:comment "Workflow automation is the systematic encoding of business processes, data-transformation pipelines, or task sequences into software so that they execute reliably and repeatedly with minimal human intervention, using rule-based triggers, conditional branching, and, increasingly, AI-driven orchestration of tool-using agents. It spans a spectrum from deterministic robotic process automation (RPA), which replicates human UI interactions, to agentic AI systems where large language models plan and execute multi-step tasks by calling APIs, running code, and delegating sub-tasks. Workflow automation reduces operational latency, enforces process compliance, and enables organisations to scale knowledge-work capacity."@en ;
    rdfs:subClassOf ngm:ai-application ;
    skos:broader ngm:ai-application ;
    vc:enables ngm:function-calling,
        ngm:multi-agent-systems ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:planning-and-scheduling ;
    vc:slug "workflow-automation" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:agentic-ai,
        ngm:orchestration .

ngm:knowledge-management a owl:Class ;
    rdfs:label "Knowledge Management"@en ;
    rdfs:comment "Knowledge Management is the systematic practice of capturing, organising, sharing, and applying the collective knowledge of an organisation or platform to improve decision-making and innovation. In AI-augmented and spatial computing contexts it encompasses knowledge graphs, ontologies, semantic search, and retrieval-augmented generation pipelines that make tacit and explicit knowledge discoverable and reusable by both human users and autonomous agents."@en ;
    rdfs:subClassOf ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:enables ngm:retrieval-augmented-generation,
        ngm:semantic-web ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.35"^^xsd:float ;
