ngm:just-in-time-compilation a owl:Class ;
    rdfs:comment "Just-in-time (JIT) compilation translates code, such as bytecode, an intermediate representation, or a traced computation graph, into native machine code at run time rather than fully ahead of time, allowing the compiler to specialise on the shapes, types and hot paths actually observed during execution. It trades a warm-up compilation cost for the performance of native code plus dynamic optimisation opportunities unavailable to static ahead-of-time compilers. It is used both in general-purpose language runtimes and in machine learning frameworks such as JAX to accelerate numerical computation graphs."@en ;
    rdfs:label "Just-In-Time Compilation"@en ;
    rdfs:subClassOf ngm:compiler ;
    vc:hasMaturity ngmi:maturity-draft ;
