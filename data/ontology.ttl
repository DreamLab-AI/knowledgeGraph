    vc:uses ngm:authentication,
        ngm:identity-management .

ngm:progressive-download a owl:Class ;
    rdfs:label "Progressive Download"@en ;
    rdfs:comment "Progressive Download is a content delivery technique in which assets—3D models, textures, audio, or video—are streamed and partially consumed before the full file is retrieved. It enables early playback or rendering from incomplete data, reduces perceived loading latency in metaverse environments, and underpins level-of-detail streaming and lazy asset loading strategies."@en ;
    rdfs:subClassOf ngm:infra-network-and-comms ;
    skos:broader ngm:infra-network-and-comms ;
    vc:enables ngm:3-d-asset,
        ngm:video-streaming ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:relatedTo ngm:asset-management,
        ngm:web-assembly ;
    vc:slug "progressive-download" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:content-delivery-network,
        ngm:level-of-detail .

ngm:projection-mapping a owl:Class ;
    rdfs:label "Projection Mapping"@en ;
    rdfs:comment "Projection Mapping is a spatial AR display technique that aligns projected imagery precisely onto three-dimensional physical surfaces, transforming arbitrary geometry into dynamic visual canvases. It requires real-time rendering of geometry-corrected frames, spatial calibration, and surface modelling, enabling immersive installations, virtual production environments, and location-based XR experiences."@en ;
    rdfs:subClassOf ngm:sc-display-and-rendering ;
    skos:broader ngm:sc-display-and-rendering ;
    vc:enables ngm:immersive-entertainment,
        ngm:immersive-experience ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:relatedTo ngm:ar-technology,
        ngm:spatial-computing ;
    vc:slug "projection-mapping" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:augmented-reality,
        ngm:real-time-rendering .

ngm:property-registry a owl:Class ;
    rdfs:label "Property Registry"@en ;
    rdfs:comment "Blockchain-based land title recording systems employing immutable distributed ledgers, cryptographic signatures, and timestamp verification to create tamper-proof property ownership records, reduce fraud, and accelerate transaction processing from 30–90 days to 72 hours. Dubai processed 188,000+ transactions worth AED 625 billion in 2024; Georgia was the first country to adopt blockchain land administration at national scale."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:distributed-ledger ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
