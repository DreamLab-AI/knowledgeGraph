ngm:asset-trading a owl:Class ;
    rdfs:label "Asset Trading"@en ;
    rdfs:comment "The exchange of digital and traditional financial assets through centralized exchanges (CEXs), decentralized exchanges (DEXs), and hybrid platforms."@en ;
