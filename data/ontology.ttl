ngm:cryptographic-protocol a owl:Class ;
    rdfs:label "Cryptographic Protocol"@en ;
    rdfs:comment "Cryptographic Protocol encompasses mathematical frameworks and algorithmic procedures that secure digital systems through cryptographic primitives including hash functions, digital signatures, encryption schemes, zero-knowledge proofs, and commitment protocols, enabling confidentiality, integrity, authentication, and non-repudiation across distributed and blockchain applications."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
