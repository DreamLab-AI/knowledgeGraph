ngm:gpt-4 a owl:Class ;
    rdfs:label "GPT 4"@en ;
    rdfs:comment "A large multimodal language model released by OpenAI in 2023, capable of accepting text and image inputs and producing text outputs, and a successor to the GPT-3.5 series."@en ;
