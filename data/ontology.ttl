# Nearest Neighbor Search
mv:NearestNeighborSearch a owl:Class ;
    rdfs:subClassOf mv:SearchAlgorithm ;
    rdfs:label "Nearest Neighbor Search"@en ;
    rdfs:comment "An algorithmic technique used in vector databases to find data points most similar to a query vector by computing distance metrics like cosine similarity or Euclidean distance, with approximate methods (ANN) trading minor accuracy for millisecond-scale retrieval from billions of objects."@en ;
    skos:prefLabel "Nearest Neighbor Search"@en ;
    dcterms:identifier "MV-9981" ;
    dcterms:subject "mv" .

mv:NearestNeighborSearch rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:enables ;
    owl:someValuesFrom mv:SemanticSearch
] .

