ngm:information-theory a owl:Class ;
    rdfs:label "Information Theory"@en ;
    rdfs:comment "Information Theory is the mathematical study of the quantification, storage and communication of information, founded by Claude Shannon in 1948. It introduces entropy as a measure of uncertainty in a random source and defines channel capacity, the maximum rate at which information can be transmitted reliably over a noisy channel. The theory underpins data compression, error-correcting codes and modern digital communication. It also connects to statistics, cryptography and machine learning through measures such as mutual information and Kullback-Leibler divergence."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:channel-coding ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:probability-theory ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:entropy ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:statistics ],
        ngm:applied-mathematics ;
    vc:bridgesTo ngm:network-coding,
        ngm:quantum-information,
        ngm:thermodynamics ;
    vc:contrastsWith ngm:algorithmic-information-theory ;
    vc:enables ngm:cryptography,
        ngm:data-compression,
        ngm:digital-communication,
        ngm:error-correcting-code ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:channel-capacity,
        ngm:channel-coding,
        ngm:entropy,
        ngm:kullback-leibler-divergence,
        ngm:mutual-information,
        ngm:source-coding ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:coding-theory,
        ngm:signal-processing ;
    vc:requires ngm:probability-theory,
        ngm:statistics ;
    vc:slug "information-theory" ;
    vc:sourceDomain "machine-learning" ;
    vc:supports ngm:feature-selection,
        ngm:machine-learning,
        ngm:natural-language-processing ;
    vc:uses ngm:logarithmic-measure,
        ngm:random-variable .

ngm:json-data-interchange-format-schema a owl:Class ;
    rdfs:label "JSON Schema"@en ;
    rdfs:comment "JSON Schema is an IETF-standardised declarative vocabulary for annotating and validating the structure, data types, required fields, and value constraints of JSON documents. It defines a set of keywords — including type, properties, required, additionalProperties, format, pattern, minimum, maximum, and combiners such as allOf, anyOf, and oneOf — that together constitute a machine-readable contract between data producers and consumers. Originally developed as a series of Internet-Drafts, the 2020-12 dialect is the most widely implemented stable revision. JSON Schema underpins REST API documentation via OpenAPI, event-driven API documentation via AsyncAPI, configuration validation in Kubernetes CRDs and Helm charts, and verifiable credential subject validation in decentralised identity ecosystems."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:json-data-interchange-format ],
        ngm:infra-data-management ;
    skos:broader ngm:infra-data-management ;
    vc:bridgesTo ngm:decentralised-identity,
        ngm:infrastructure-as-code ;
    vc:contrastsWith ngm:apache-avro,
        ngm:protocol-buffers,
        ngm:xml-schema-definition ;
    vc:enables ngm:api-contract-testing,
        ngm:code-generation,
        ngm:credential-schema,
        ngm:form-generation,
        ngm:rest-api ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:implements ngm:declarative-constraint-specification,
        ngm:ietf-standard ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:data-format,
        ngm:graphql-schema,
        ngm:json-data-interchange-format-ld,
        ngm:open-api-specification,
        ngm:schema-language ;
    vc:requires ngm:json-data-interchange-format,
