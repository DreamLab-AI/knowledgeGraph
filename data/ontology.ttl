ngm:community-detection a owl:Class ;
    rdfs:label "Community Detection"@en ;
    rdfs:comment "Community detection is the task of partitioning a network into groups of nodes that are more densely connected internally than with the rest of the graph. It is a core method in network analysis."@en ;
