ngm:fatf a owl:Class ;
    rdfs:label "FATF"@en ;
    rdfs:comment "The Financial Action Task Force (FATF) is an intergovernmental policy-making body founded in 1989 that sets global standards for combating money laundering, terrorist financing, and proliferation financing. Its 40 Recommendations constitute the international framework that member jurisdictions are expected to implement through national legislation and regulatory action. FATF conducts mutual evaluations of member countries' compliance, publishes grey and black lists of high-risk jurisdictions, and issues guidance on emerging risks including those arising from virtual assets and virtual asset service providers."@en ;
    rdfs:subClassOf ngm:infra-legal-and-regulatory ;
    skos:broader ngm:infra-legal-and-regulatory ;
    vc:enables ngm:anti-money-laundering,
        ngm:financial-stability ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:compliance-framework,
        ngm:fatf-travel-rule,
        ngm:virtual-asset ;
    vc:slug "fatf" ;
    vc:sourceDomain "infrastructure" ;
    vc:standardizedBy ngm:standards-organization .

ngm:gas a owl:Class ;
    rdfs:label "Gas"@en ;
    rdfs:comment "Gas is the unit of computational work measurement within EVM-compatible blockchains. Every opcode executed by the Ethereum Virtual Machine consumes a defined gas quantity; users pay gas_price × gas_used to validators, preventing denial-of-service through unbounded computation and creating a market for block space."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:gas-price ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:gas-fee-market ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:gas-limit ],
        ngm:bc-protocol-and-consensus,
        ngm:blockchain-entity,
        ngm:economic-mechanism ;
    skos:broader ngm:bc-protocol-and-consensus ;
    vc:enables ngm:blockchain-transaction ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:gas-fee-market,
        ngm:gas-limit,
        ngm:gas-price ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:eip-1559,
        ngm:fee-market,
        ngm:smart-contract-execution,
        ngm:tokenomics,
        ngm:transaction-fee ;
    vc:slug "gas" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:smart-contract .

ngm:graph-neural-network a owl:Class ;
    rdfs:label "Graph Neural Network"@en ;
    rdfs:comment "A Graph Neural Network (GNN) is a deep learning architecture that operates directly on graph-structured data by iteratively propagating and aggregating feature information across node neighbourhoods. GNNs generalise convolutional and attention mechanisms to non-Euclidean domains, learning node, edge, and graph-level representations suitable for tasks including node classification, link prediction, and graph classification across domains such as knowledge graphs, social networks, molecular modelling, and recommendation systems."@en ;
    rdfs:subClassOf ngm:ai-model-architecture,
        ngm:neural-network ;
    skos:broader ngm:ai-model-architecture ;
    vc:enables ngm:anomaly-detection,
        ngm:retrieval-augmented-generation ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:relatedTo ngm:semantic-web,
        ngm:transformer ;
    vc:slug "graph-neural-network" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:deep-learning,
        ngm:knowledge-graph .

ngm:hash-time-locked-contract a owl:Class ;
    rdfs:label "Hash Time-Locked Contract"@en ;
    rdfs:comment "A Hash Time-Locked Contract (HTLC) is a type of smart contract that conditionally transfers funds to a recipient only if they can present a cryptographic preimage satisfying a specified hash condition within a defined time window; if the condition is unmet before the timeout, the funds revert to the sender. HTLCs are foundational to trustless cross-chain atomic swaps and payment channel networks such as the Lightning Network, enabling conditional payment routing without requiring both parties to trust each other or a custodial intermediary. The hashlock ensures atomicity—either both legs of a swap complete or neither does—whilst the timelock enforces a bounded settlement window. HTLCs are a primitive from which more complex decentralised finance protocols are constructed."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptographic-hash-function ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:atomic-swap ],
        ngm:smart-contract ;
    vc:enables ngm:cross-chain-interoperability,
        ngm:lightning-network,
        ngm:micropayments ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:cross-chain-bridge,
        ngm:de-fi,
        ngm:payment-system ;
    vc:requires ngm:atomic-swap,
        ngm:cryptographic-hash-function ;
    vc:slug "hash-time-locked-contract" ;
    vc:sourceDomain "blockchain" .

ngm:healthcare-ai a owl:Class ;
    rdfs:label "Healthcare AI"@en ;
    rdfs:comment "Healthcare AI is the systematic application of machine learning, natural language processing, computer vision, and large language models to clinical and operational problems in healthcare—including diagnostic imaging analysis, clinical decision support, drug discovery, genomic interpretation, and patient outcome prediction. The field operates under stringent regulatory oversight (FDA, MHRA, MDR) requiring prospective clinical validation, post-market surveillance, and clear human-AI workflow integration to ensure patient safety. Fairness, explainability, and bias auditing are central concerns given the high-stakes nature of clinical decisions."@en ;
    rdfs:subClassOf ngm:ai-application ;
    skos:broader ngm:ai-application ;
    vc:enables ngm:clinical-decision-support,
        ngm:drug-discovery ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:pathology-ai,
        ngm:radiology-ai ;
    vc:slug "healthcare-ai" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:deep-learning,
        ngm:medical-imaging .

ngm:high-performance-computing a owl:Class ;
    rdfs:label "High-Performance Computing"@en ;
    rdfs:comment "High-Performance Computing (HPC) refers to the use of aggregated computational resources — clusters, supercomputers, and massively parallel systems — to solve problems requiring sustained compute throughput, memory bandwidth, or I/O rates far beyond those achievable on commodity servers. HPC systems combine specialised processors (CPUs, GPUs, FPGAs, TPUs), high-speed interconnects (InfiniBand, NVLink), parallel file systems, and workload-management software to execute scientific simulations, large-scale machine learning training, genomics, climate modelling, and computational fluid dynamics at peta- or exascale performance."@en ;
    rdfs:subClassOf ngm:computing-infrastructure ;
    vc:dependsOn ngm:compute-infrastructure,
        ngm:computing-hardware ;
    vc:enables ngm:blockchain-analytics,
        ngm:deep-learning,
        ngm:machine-learning-infrastructure,
        ngm:neur-ips ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:ai-hardware,
        ngm:ai-infrastructure,
        ngm:cloud-infrastructure,
        ngm:distributed-computing,
        ngm:edge-computing ;
    vc:slug "high-performance-computing" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:batch-processing,
        ngm:cuda,
        ngm:fpga,
        ngm:gpu-compute,
        ngm:parallel-processing,
        ngm:tpu .

ngm:human-feedback a owl:Class ;
    rdfs:label "Human Feedback"@en ;
    rdfs:comment "Information provided by human evaluators about model outputs, typically in the form of rankings, ratings, demonstrations, or corrections."@en ;
