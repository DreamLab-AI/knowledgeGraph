        ngm:digital-identity ;
    vc:uses ngm:post-quantum-cryptography,
        ngm:zero-trust-architecture .

ngm:digital-society a owl:Class ;
    rdfs:label "Digital Society"@en ;
    rdfs:comment "The emergent social order in which digital networks, platforms, and data systems become primary mediators of economic activity, civic participation, cultural expression, and interpersonal relationships. Digital society encompasses the institutions, norms, rights, and governance mechanisms needed to ensure equitable, secure, and rights-respecting participation in digital environments including the metaverse."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
