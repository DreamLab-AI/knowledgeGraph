        ngm:generative-model,
        ngm:self-supervised-learning,
        ngm:transfer-learning ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:aaai,
        ngm:ai-safety-research,
        ngm:cvpr,
        ngm:icml,
        ngm:neur-ips,
        ngm:open-source-ai ;
    vc:slug "iclr" ;
    vc:sourceDomain "ai" ;
    vc:supports ngm:large-language-model,
        ngm:neural-network,
        ngm:scientific-machine-learning ;
    vc:uses ngm:attention-mechanism,
        ngm:reinforcement-learning,
        ngm:representation-learning,
        ngm:transformer .

ngm:idempotency a owl:Class ;
    rdfs:label "Idempotency"@en ;
    rdfs:comment "Idempotency is the property of an operation whereby applying it multiple times produces the same result as applying it once. In distributed systems and APIs it is essential for safe retries, ensuring that duplicated requests caused by network failures do not corrupt state or cause unintended side effects. Idempotency is commonly enforced via idempotency keys, deterministic merge functions, or naturally commutative state updates."@en ;
    rdfs:subClassOf ngm:distributed-systems ;
    vc:enables ngm:fault-tolerance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:crdt ;
    vc:slug "idempotency" ;
    vc:sourceDomain "infrastructure" .

ngm:image-sensor a owl:Class ;
    rdfs:label "Image Sensor"@en ;
    rdfs:comment "An image sensor is a solid-state device that converts incident light into electrical signals to capture a digital image, typically implemented as a CMOS or CCD array of photodetector pixels. Each pixel accumulates charge proportional to received photons, which is read out, digitised, and assembled into a frame. Image sensors are the core capture element in cameras and many computer-vision and tracking systems."@en ;
    rdfs:subClassOf ngm:sensor ;
    vc:enables ngm:eye-tracking ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:camera ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:slug "image-sensor" ;
    vc:sourceDomain "robotics" .

ngm:incident-management a owl:Class ;
    rdfs:label "Incident Management"@en ;
    rdfs:comment "Incident management is the operational discipline of detecting, responding to, resolving, and learning from unplanned disruptions to a service. It coordinates people and tooling through detection, triage, escalation, mitigation, and recovery, then conducts blameless post-mortems to prevent recurrence. Closely associated with site reliability engineering and ITIL practice, it aims to minimise mean time to recovery and protect service-level objectives."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:incident-response ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:monitoring ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:observability ],
        ngm:site-reliability-engineering ;
