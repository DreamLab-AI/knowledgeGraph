ngm:interoperability a owl:Class ;
    rdfs:label "Interoperability"@en ;
    rdfs:comment "The capability of distinct systems, applications, or organizational entities to exchange information, interpret shared data correctly, and utilize exchanged information for coordinated operations. Encompasses technical protocol compatibility, semantic data alignment, and organizational process integration across heterogeneous environments including blockchain networks, healthcare systems, and distributed infrastructure."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:technical-standards ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:interoperability-standard ],
        ngm:infra-network-and-comms ;
    skos:broader ngm:infra-network-and-comms ;
    vc:bridgesTo ngm:semantic-web-linked-data-standard ;
    vc:contrastsWith ngm:vendor-lock-in ;
    vc:dependsOn ngm:data-governance,
        ngm:identity-management,
        ngm:network-connectivity ;
    vc:enables ngm:blockchain-interoperability,
        ngm:cross-platform-interoperability,
        ngm:data-portability ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:data-standards,
