ngm:dao a owl:Class ;
    rdfs:label "DAO"@en ;
    rdfs:comment "Decentralised Autonomous Organisation operating through transparent code-based rules and distributed governance rather than hierarchical management, enabling community coordination at scale via smart contracts, token-based voting, and on-chain treasury management."@en ;
