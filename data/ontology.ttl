ngm:natural-language-generation a owl:Class ;
    rdfs:label "Natural Language Generation"@en ;
    rdfs:comment "Natural Language Generation (NLG) is the subfield of natural language processing concerned with producing coherent, contextually appropriate human-readable text from structured data, internal representations, or prompts. It encompasses content determination, sentence planning, and surface realisation, and is today dominated by neural language models that generate text token by token. NLG is the productive counterpart to natural language understanding within end-to-end conversational and generative systems."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:text-generation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:language-model ],
        ngm:natural-language-processing ;
    vc:bridgesTo ngm:natural-language-understanding ;
    vc:contrastsWith ngm:natural-language-understanding ;
    vc:dependsOn ngm:transformer ;
    vc:enables ngm:chatbot,
        ngm:content-creation,
        ngm:dialogue-system ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:text-generation ;
    vc:isPartOf ngm:natural-language-processing ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:gpt,
        ngm:prompt-engineering ;
    vc:requires ngm:language-model ;
    vc:slug "natural-language-generation" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:machine-translation ;
    vc:uses ngm:language-model,
        ngm:large-language-model,
        ngm:transformer .

ngm:network-function-virtualization a owl:Class ;
    rdfs:label "Network Function Virtualization"@en ;
    rdfs:comment "Network Function Virtualization (NFV) is an architectural paradigm that decouples network functions — such as firewalls, load balancers, intrusion detection systems, and routers — from dedicated proprietary hardware appliances and implements them as software running on commercial off-the-shelf (COTS) servers, switches, and storage. Standardised by ETSI's NFV Industry Specification Group, NFV introduces a three-layer model comprising the NFV Infrastructure (NFVI), Virtual Network Functions (VNFs), and the NFV Management and Orchestration (MANO) framework. By enabling elastic provisioning, rapid deployment, and lifecycle automation of network services, NFV reduces capital and operational expenditure while providing the flexibility required for 5G, edge computing, and cloud-native telecom architectures. It is closely related to and operationally complementary with Software-Defined Networking (SDN), which separates the network control plane from the data plane."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cloud-computing ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:hypervisor ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:virtualisation ],
        ngm:network-architecture ;
    vc:bridgesTo ngm:distributed-systems,
        ngm:edge-ai ;
    vc:dependsOn ngm:software-defined-networking ;
    vc:enables ngm:edge-computing,
        ngm:network-slicing ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:software-defined-networking ;
    vc:requires ngm:cloud-computing,
        ngm:hypervisor,
        ngm:virtualisation ;
    vc:slug "network-function-virtualization" ;
    vc:sourceDomain "infrastructure" ;
    vc:standardizedBy ngm:etsi,
        ngm:ietf ;
    vc:supports ngm:5-g-network ;
    vc:uses ngm:container-orchestration,
        ngm:microservices-architecture .

ngm:nist-ai-risk-management-framework a owl:Class ;
    rdfs:label "NIST AI Risk Management Framework"@en ;
    rdfs:comment "The NIST AI Risk Management Framework (AI RMF 1.0), published by the National Institute of Standards and Technology in January 2023, is a voluntary, use-case-agnostic guidance document that helps organisations design, develop, deploy, and evaluate AI systems in a manner that is trustworthy and risk-informed. It organises AI risk management activities into four core functions — GOVERN, MAP, MEASURE, and MANAGE — and supports cross-functional integration of safety, reliability, fairness, privacy, and accountability considerations throughout the AI lifecycle. The framework is accompanied by a Playbook of suggested actions and is intended to complement existing risk management practices rather than replace sector-specific regulations or standards."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:nist-ai-rmf ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:stakeholder-engagement ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ai-risk-assessment ],
        ngm:ai-governance-framework ;
    vc:bridgesTo ngm:data-governance,
        ngm:machine-learning-operations ;
    vc:contrastsWith ngm:eu-ai-act-regulatory-instrument,
        ngm:iso-iec-42001 ;
    vc:enables ngm:ai-transparency-framework,
        ngm:algorithmic-accountability,
        ngm:responsible-ai,
        ngm:trustworthy-ai ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:govern-function,
        ngm:manage-function,
        ngm:map-function,
        ngm:measure-function,
        ngm:nist-ai-rmf ;
    vc:implements ngm:ai-safety,
        ngm:risk-management ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:ai-incident-reporting,
        ngm:model-cards,
        ngm:nist-cybersecurity-framework ;
    vc:requires ngm:ai-lifecycle-management,
        ngm:ai-risk-assessment,
        ngm:stakeholder-engagement ;
    vc:slug "nist-ai-risk-management-framework" ;
    vc:sourceDomain "governance" ;
    vc:standardizedBy ngm:nist ;
    vc:supports ngm:ai-ethics,
        ngm:ai-fairness,
        ngm:explainable-ai,
        ngm:privacy-preserving-ai .

ngm:novel-view-synthesis a owl:Class ;
    rdfs:label "Novel View Synthesis"@en ;
    rdfs:comment "Novel view synthesis (NVS) is a computer vision and computer graphics task that involves generating photorealistic images of a scene from camera viewpoints not present in the original set of captured images, given a collection of reference photographs and their corresponding camera poses. The task requires learning an implicit or explicit representation of the scene's geometry and appearance that supports free-viewpoint rendering with high fidelity. It is a foundational capability for immersive media, telepresence, and spatial computing applications, and has been dramatically advanced by neural scene representations such as Neural Radiance Fields and 3D Gaussian Splatting."@en ;
    rdfs:subClassOf ngm:computer-vision-task ;
    vc:bridgesTo ngm:autonomous-driving-simulation,
        ngm:extended-reality,
        ngm:generative-ai ;
    vc:contrastsWith ngm:3-d-reconstruction ;
    vc:dependsOn ngm:ray-casting,
        ngm:scene-representation ;
    vc:enables ngm:free-viewpoint-video,
        ngm:media-production,
        ngm:synthetic-data-generation,
        ngm:virtual-reality-telepresence,
        ngm:volumetric-capture ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:3-d-gaussian-splatting,
        ngm:3-d-scene-reconstruction,
        ngm:differentiable-rendering,
        ngm:neural-radiance-field,
        ngm:photogrammetry ;
    vc:requires ngm:camera-pose-estimation,
        ngm:multi-view-images ;
    vc:slug "novel-view-synthesis" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:camera-calibration,
        ngm:depth-estimation,
        ngm:multi-layer-perceptron,
        ngm:neural-rendering,
        ngm:structure-from-motion,
        ngm:volume-rendering .

ngm:open-zeppelin-governor a owl:Class ;
    rdfs:label "OpenZeppelin Governor"@en ;
    rdfs:comment "OpenZeppelin Governor is a modular, security-audited Solidity smart-contract framework that provides the core infrastructure for deploying on-chain governance systems on EVM-compatible blockchains, succeeding the Compound Governor Bravo pattern. It implements a canonical proposal lifecycle — proposal creation, configurable voting delay, voting period, quorum validation, and timelock-guarded execution — with pluggable extension modules for vote-counting strategies (simple majority, Bravo-style, fractional), token-based voting-power sources (ERC-20 with EIP-5805 checkpointing or ERC-721), and TimelockController integration. The framework is maintained by the OpenZeppelin security team as part of OpenZeppelin Contracts, has undergone multiple third-party audits, and is adopted as the de facto governance standard by major decentralised autonomous organisations and DeFi protocols including Uniswap, ENS, and Compound."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:solidity ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ethereum-smart-contract-platform-virtual-machine ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:vote-delegation ],
        ngm:bc-governance-and-regulation ;
    skos:broader ngm:bc-governance-and-regulation ;
    vc:bridgesTo ngm:collective-intelligence,
        ngm:liquid-democracy ;
    vc:contrastsWith ngm:multisig-wallet,
        ngm:optimistic-governance ;
    vc:dependsOn ngm:eip-5805,
        ngm:eip-712,
        ngm:smart-contracts ;
    vc:enables ngm:dao-governance,
        ngm:protocol-upgrades,
        ngm:treasury-management,
        ngm:voting-mechanism ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:compound-governor-bravo,
        ngm:on-chain-governance ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:quorum,
        ngm:snapshot-voting,
        ngm:token-weighted-voting ;
    vc:requires ngm:ethereum-smart-contract-platform-virtual-machine,
        ngm:solidity,
        ngm:vote-delegation ;
    vc:slug "open-zeppelin-governor" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:decentralised-autonomous-organisation,
        ngm:defi-protocol ;
    vc:uses ngm:erc-20,
        ngm:erc-721,
        ngm:governance-token,
        ngm:smart-contract,
        ngm:timelock-controller .

ngm:optical-flow a owl:Class ;
    rdfs:label "Optical Flow"@en ;
    rdfs:comment "Optical flow is the pattern of apparent motion of objects, surfaces, and edges in a visual scene between consecutive frames of video, caused by relative movement between the observer and the scene. It is computed as a dense or sparse 2D velocity field over the image plane and is used in computer vision for motion estimation, video interpolation, action recognition, and autonomous navigation. Classical algorithms (Horn-Schunck, Lucas-Kanade) and deep learning approaches (RAFT, FlowNet) constitute the main methodological lineages."@en ;
    rdfs:subClassOf ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:bridgesTo ngm:deep-generative-model,
        ngm:neural-radiance-field,
        ngm:robotics-perception ;
    vc:contrastsWith ngm:depth-estimation ;
    vc:enables ngm:action-recognition,
        ngm:autonomous-driving-perception,
        ngm:differentiable-rendering,
        ngm:motion-capture-technology,
        ngm:visual-odometry ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:computer-vision,
        ngm:video-understanding ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:camera,
        ngm:image-segmentation,
        ngm:stereo-vision,
        ngm:structure-from-motion,
        ngm:video-compression ;
    vc:slug "optical-flow" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:constraint,
        ngm:convolutional-neural-network,
        ngm:feature-matching,
        ngm:image-processing .

ngm:owl-2-web-ontology-language a owl:Class ;
    rdfs:label "OWL 2 Web Ontology Language"@en ;
    rdfs:comment "A World Wide Web Consortium standard for representing ontologies on the web, providing formal semantics based on description logic for classes, properties and individuals. It extends earlier web ontology work with richer modelling features and defined reasoning profiles."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:rdf ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:description-logic ],
