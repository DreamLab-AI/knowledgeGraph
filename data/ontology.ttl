# 3D Reconstruction
spatial-computing:3DReconstruction rdf:type owl:Class ;
    rdfs:subClassOf spatial-computing:ComputerVision ;
    rdfs:label "3D Reconstruction"@en ;
    rdfs:comment "3D Reconstruction is the computational process of recovering three-dimensional geometric and structural information from multiple 2D images or sensor data (such as LiDAR or depth cameras) using techniques including Computer Vision, photogrammetry, and Structure-from-Motion (SfM). This technology enables digital capture of real-world objects and environments for Digital Twin creation and immersive environment mapping."@en ;
    skos:prefLabel "3D Reconstruction"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:spatial-computing:3d-reconstruction" ;
    owl:sameAs <urn:visionclaw:concept:spatial-computing:3d-reconstruction> ;
    vcw:contentHash "sha256-12-9a4e9fa565fc" ;
    vcw:qualityScore "0.5"^^xsd:decimal ;
