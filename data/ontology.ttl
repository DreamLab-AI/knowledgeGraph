    vc:slug "linked-data-encoder" ;
    vc:sourceDomain "infrastructure" .

ngm:lo-ra-fine-tuning a owl:Class ;
    rdfs:label "LoRA Fine-Tuning"@en ;
    rdfs:comment "LoRA (Low-Rank Adaptation) fine-tuning is a parameter-efficient fine-tuning technique that adapts large pre-trained transformer models by inserting pairs of trainable low-rank matrices (A ∈ ℝ^{d×r} and B ∈ ℝ^{r×d}, where r ≪ d) alongside frozen weight matrices in selected layers, so that the effective weight update ΔW = BA is constrained to a low-dimensional subspace. By training only the injected adapter matrices — typically representing 0.1–1% of the original parameter count — LoRA achieves near full fine-tuning performance at a fraction of the GPU memory and compute cost, enabling adaptation of billion-parameter models on consumer hardware. It is now the dominant technique in the PEFT ecosystem and is implemented in Hugging Face's PEFT library."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:large-language-models ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:pre-training ],
        ngm:ai-technique,
        ngm:parameter-efficient-fine-tuning ;
    skos:broader ngm:ai-technique ;
    vc:enables ngm:domain-adaptation,
        ngm:fine-tuning ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:model-training,
        ngm:quantisation ;
    vc:requires ngm:large-language-models,
        ngm:pre-training ;
    vc:slug "lo-ra-fine-tuning" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:low-rank-adaptation a owl:Class ;
    rdfs:label "Low-Rank Adaptation"@en ;
    rdfs:comment "Low-Rank Adaptation is a parameter-efficient fine-tuning method that adds small trainable low-rank matrices to a frozen pre-trained model. It reduces the cost of adapting large models."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:neural-network ],
        ngm:parameter-efficient-fine-tuning ;
    vc:enables ngm:transfer-learning ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:neural-network ;
    vc:slug "low-rank-adaptation" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:machine-vision a owl:Class ;
    rdfs:label "Machine Vision"@en ;
    rdfs:comment "Machine vision is the engineering discipline that applies digital imaging, optics, and automated image analysis to perform inspection, measurement, guidance, and identification tasks in industrial and manufacturing environments. It integrates hardware components — cameras, illumination, optics, and frame grabbers — with software pipelines that extract actionable decisions from image data, typically operating in real time under strict cycle-time constraints. Distinguished from the broader research field of computer vision by its emphasis on reliability, determinism, and seamless integration with programmable logic controllers and industrial automation systems. Modern machine vision systems increasingly incorporate deep learning inference alongside classical morphological and blob-analysis algorithms to handle appearance variability that rule-based methods alone cannot address."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:pattern-recognition ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:sensor ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:feature-extraction ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:camera ],
        ngm:computer-vision ;
    vc:bridgesTo ngm:augmented-reality,
        ngm:deep-learning,
        ngm:digital-twin ;
    vc:contrastsWith ngm:computer-vision ;
    vc:enables ngm:defect-detection,
        ngm:dimensional-measurement,
        ngm:object-detection,
        ngm:optical-character-recognition,
        ngm:robot-guidance ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:feature-extraction,
        ngm:image-acquisition,
        ngm:image-preprocessing,
        ngm:pattern-recognition ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:3d-imaging,
        ngm:barcode-scanning ;
    vc:requires ngm:camera,
        ngm:illumination,
        ngm:optics,
        ngm:sensor ;
    vc:slug "machine-vision" ;
    vc:sourceDomain "ai" ;
    vc:standardizedBy ngm:aia-standards,
        ngm:genisys-standard ;
    vc:supports ngm:industrial-automation,
        ngm:quality-control,
        ngm:robotics ;
    vc:uses ngm:convolutional-neural-network,
        ngm:edge-detection,
        ngm:image-segmentation .

ngm:market-surveillance-authority a owl:Class ;
    rdfs:label "Market Surveillance Authority"@en ;
    rdfs:comment "National authority responsible for carrying out market surveillance activities on AI systems, including inspections, testing, enforcement, and ensuring compliance with EU AI Act requirements within a Member State."@en ;
