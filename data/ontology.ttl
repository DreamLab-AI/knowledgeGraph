ngm:bias-variance-tradeoff a owl:Class ;
    rdfs:label "Bias-Variance Tradeoff"@en ;
    rdfs:comment "The bias-variance tradeoff is the central principle in supervised learning describing how a model's expected generalisation error decomposes into bias, variance, and irreducible noise, and how reducing one component tends to increase the other. Bias is error from overly simplistic assumptions that cause systematic underfitting, while variance is error from excessive sensitivity to the training sample that causes overfitting. Effective model selection seeks a complexity sweet spot that minimises total expected error on unseen data, balancing these competing sources rather than eliminating either alone."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:overfitting ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:statistical-learning-theory ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:underfitting ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:model-complexity ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cross-validation ],
        ngm:statistical-learning-theory ;
    vc:contrastsWith ngm:double-descent,
        ngm:overfitting,
        ngm:underfitting ;
    vc:dependsOn ngm:loss-function,
        ngm:model-complexity,
        ngm:supervised-learning,
        ngm:training-data ;
    vc:enables ngm:hyperparameter-tuning,
        ngm:learning-curve-analysis,
        ngm:model-evaluation,
        ngm:model-selection ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:generalisation-error,
        ngm:irreducible-error,
        ngm:model-complexity,
        ngm:overfitting,
        ngm:underfitting ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:algorithmic-bias-and-variance,
        ngm:bayesian-inference,
        ngm:cross-validation,
        ngm:hyperparameter-tuning,
        ngm:pac-learning,
        ngm:regularisation,
        ngm:vc-dimension ;
    vc:requires ngm:cross-validation,
        ngm:statistical-learning-theory ;
    vc:slug "bias-variance-tradeoff" ;
    vc:sourceDomain "machine-learning" ;
    vc:supports ngm:dimensionality-reduction,
        ngm:ensemble-learning,
        ngm:feature-selection,
        ngm:model-training ;
    vc:uses ngm:cross-validation,
        ngm:ensemble-methods,
        ngm:regularisation .

ngm:bluetooth-low-energy a owl:Class ;
    rdfs:label "Bluetooth Low Energy"@en ;
    rdfs:comment "Bluetooth Low Energy (BLE) is the formal designation of the low-power wireless communication mode introduced in the Bluetooth 4.0 Core Specification (2010), standardised by the Bluetooth SIG, enabling battery-constrained devices to communicate over short ranges (typically 10–100 m) using duty-cycled radio bursts with peak currents measured in milliamps. It defines a complete protocol stack from physical layer through application profiles, and has become the dominant short-range radio for wearable, medical, industrial, and IoT devices."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:bluetooth-le ],
        ngm:internet-of-things ;
    vc:bridgesTo ngm:robotics,
        ngm:spatial-computing ;
