    vc:slug "data-fabric-architecture" ;
    vc:sourceDomain "infrastructure" .

ngm:data-federation a owl:Class ;
    rdfs:label "Data Federation"@en ;
    rdfs:comment "Data federation is a data integration technique that presents multiple distributed and heterogeneous data sources as a single virtual database queryable in place, without physically moving or copying the data. A federation engine decomposes queries, pushes work to source systems and combines results on the fly. It enables real-time unified access and is a core mechanism behind data virtualization and integration interfaces."@en ;
    rdfs:subClassOf ngm:infra-data-management ;
    skos:broader ngm:infra-data-management ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:data-integration-interface,
        ngm:data-virtualization ;
    vc:slug "data-federation" ;
    vc:sourceDomain "data" .

ngm:data-management-platform a owl:Class ;
    rdfs:label "Data Management Platform"@en ;
    rdfs:comment "A data management platform is a centralised system for collecting, organising, segmenting, and activating large volumes of data drawn from multiple sources so that it can be used for analytics, audience targeting, and decision-making. Historically associated with advertising, where it aggregated and anonymised audience data for campaign targeting, the term also denotes broader enterprise platforms that unify data pipelines, storage, and governance. It is closely related to, but distinct from, customer data platforms and data warehouses."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:data-warehouse ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:consent-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:data-pipeline ],
        ngm:data ;
    vc:contrastsWith ngm:customer-data-platform ;
    vc:dependsOn ngm:data ;
    vc:enables ngm:programmatic-advertising ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:data-pipeline,
        ngm:data-warehouse ;
    vc:isPartOf ngm:data-integration ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:data-warehouse,
        ngm:synthetic-data-generator ;
    vc:requires ngm:consent-management ;
    vc:slug "data-management-platform" ;
    vc:sourceDomain "data" ;
    vc:supports ngm:advertising,
        ngm:data-governance ;
    vc:uses ngm:data-integration .

ngm:data-mining a skos:Concept ;
    rdfs:label "Data Mining"@en .

ngm:data-models a owl:Class ;
    rdfs:label "Data Models"@en ;
    rdfs:comment "Data models are the collected structural specifications that define how information is represented, related and constrained within a system or framework. In digital-twin and layered service architectures they describe the shape of state, telemetry and interactions exchanged between components. Well-defined data models are a prerequisite for interoperability, validation and consistent behaviour across service layers."@en ;
    rdfs:subClassOf ngm:infra-data-management ;
    skos:broader ngm:infra-data-management ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:digital-twin-framework,
        ngm:service-layer ;
    vc:slug "data-models" ;
    vc:sourceDomain "data" .

ngm:data-monetisation a owl:Class ;
    rdfs:label "Data Monetisation"@en ;
    rdfs:comment "Data monetisation is the practice of generating economic value from data assets, either directly by selling data and data-derived products, or indirectly by using data to improve decisions, products and operations. It spans approaches from licensing raw or aggregated datasets through data marketplaces to embedding analytics in services that command a premium. Responsible data monetisation must be balanced against data privacy, consent and governance obligations, and it raises questions about data ownership and the ethics of treating personal information as a tradeable resource."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:consent-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-governance ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-quality ],
        ngm:data-governance ;
    vc:contrastsWith ngm:data-privacy,
        ngm:surveillance-capitalism ;
    vc:dependsOn ngm:data-quality,
        ngm:metadata-management ;
    vc:enables ngm:data-marketplace ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:data-classification,
        ngm:data-protection,
        ngm:regulatory-compliance ;
    vc:requires ngm:consent-management,
        ngm:data-governance,
        ngm:data-quality ;
    vc:slug "data-monetisation" ;
    vc:sourceDomain "governance" ;
    vc:standardizedBy ngm:gdpr ;
    vc:supports ngm:data-sharing ;
    vc:uses ngm:data-marketplace,
        ngm:data-sharing .

ngm:data-processing-hardware a owl:Class ;
    rdfs:label "Data Processing Hardware"@en ;
    rdfs:comment "The computing infrastructure including GPUs, CPUs, specialized accelerators, and edge computing devices that power metaverse applications, virtual reality experiences, and immersive environments, providing the massive processing capabilities required for real-time 3D rendering, AI inference, and ..."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:power-infrastructure ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cooling-system ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:high-bandwidth-memory ],
        ngm:computing-infrastructure,
        ngm:infra-computing-and-cloud ;
    skos:broader ngm:infra-computing-and-cloud ;
    vc:enables ngm:immersive-computing,
        ngm:real-time-rendering ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:cooling-system,
        ngm:high-bandwidth-memory,
        ngm:power-infrastructure ;
    vc:slug "data-processing-hardware" ;
    vc:sourceDomain "infrastructure" .

ngm:data-virtualization a owl:Class ;
    rdfs:label "Data Virtualization"@en ;
    rdfs:comment "A data integration approach that creates a virtual abstraction layer enabling users and applications to access, query, and integrate data from multiple disparate sources as a single unified system without physically moving or replicating the underlying data, supporting real-time access and reduci..."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:query-engine ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:metadata-management ],
        ngm:data-integration,
        ngm:infra-data-management ;
    skos:broader ngm:infra-data-management ;
    vc:enables ngm:data-federation,
        ngm:real-time-data-access ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires ngm:data-connectors,
        ngm:metadata-management,
        ngm:query-engine ;
    vc:slug "data-virtualization" ;
    vc:sourceDomain "infrastructure" .

ngm:database-schema a owl:Class ;
    rdfs:label "Database Schema"@en ;
    rdfs:comment "A database schema is the formal, declarative description of the logical structure of a database, specifying its tables, columns, data types, primary and foreign keys, integrity constraints, views, indexes, and relationships. It constitutes the logical layer of a three-level ANSI/SPARC architecture that separates the conceptual organisation of data from physical storage details and from application-level views, and is enforced at runtime by the Database Management System. Schemas evolve through controlled migration scripts — governed by tools such as Flyway and Liquibase — and contrast with ontologies in being prescriptive, closed-world storage structures rather than open, inference-supporting conceptual models for reasoning."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:database-management-system ],
        ngm:data-model ;
    vc:bridgesTo ngm:object-relational-mapping,
        ngm:owl-class-hierarchy ;
    vc:contrastsWith ngm:knowledge-representation,
        ngm:nosql-database,
        ngm:ontology ;
    vc:enables ngm:acid-transactions,
        ngm:data-interoperability,
        ngm:database-query ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:index,
        ngm:normalisation,
        ngm:referential-integrity,
        ngm:view ;
    vc:implements ngm:data-model ;
    vc:isPartOf ngm:database,
        ngm:relational-database ;
    vc:qualityScore "0.9"^^xsd:float ;
    vc:relatedTo ngm:data-migration,
        ngm:metadata ;
    vc:requires ngm:database-management-system ;
    vc:slug "database-schema" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:data-governance,
        ngm:data-integration,
        ngm:data-warehouse ;
    vc:uses ngm:data-model,
        ngm:relational-algebra,
        ngm:sql .

ngm:dataset a owl:Class ;
    rdfs:label "Dataset"@en ;
    rdfs:comment "A Dataset is a structured collection of data records sharing a common schema, gathered for a specific purpose such as training machine learning models, conducting research, or supporting analytics. Datasets are characterised by their size, modality (text, image, tabular, audio, video, graph, etc.), provenance, and licensing terms, all of which affect their fitness for use. Data quality, curation methodology, and bias documentation are critical attributes that determine the reliability of downstream AI systems. The movement from model-centric to data-centric AI has elevated dataset engineering to a first-class research and engineering discipline, with dataset documentation frameworks such as Datasheets for Datasets, Dataset Nutrition Labels, and the Croissant machine-readable format formalising the metadata contract between dataset creators and downstream consumers."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:schema ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:metadata ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-cleaning ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-annotation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-governance ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:ground-truth-labels ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-lineage ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-collection ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-labelling ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:evaluation-metric ],
        ngm:cat-ai-infrastructure,
        ngm:data-architecture ;
    skos:broader ngm:cat-ai-infrastructure ;
    vc:enables ngm:benchmarking,
        ngm:data-analysis,
        ngm:machine-learning,
        ngm:model-evaluation,
        ngm:reinforcement-learning,
        ngm:supervised-learning,
        ngm:transfer-learning,
        ngm:unsupervised-learning ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:data-record,
        ngm:data-split,
        ngm:evaluation-metric,
        ngm:ground-truth-labels,
        ngm:metadata,
        ngm:schema ;
    vc:qualityScore "0.9"^^xsd:float ;
    vc:relatedTo ngm:bias,
        ngm:computational-modelling,
        ngm:data-quality,
        ngm:fairness,
        ngm:privacy,
        ngm:regulation ;
    vc:requires ngm:data-annotation,
        ngm:data-cleaning,
        ngm:data-collection,
        ngm:data-governance,
        ngm:data-labelling,
        ngm:data-lineage ;
    vc:slug "dataset" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:computer-vision,
        ngm:explainable-ai,
        ngm:foundation-model,
        ngm:large-language-models,
        ngm:natural-language-processing .

