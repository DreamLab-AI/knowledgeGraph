    vc:relatedTo ngm:knowledge-graph,
        ngm:machine-learning-infrastructure ;
    vc:slug "software-architecture" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:supply-chain-management a owl:Class ;
    rdfs:label "Supply Chain Management"@en ;
    rdfs:comment "Supply Chain Management in blockchain contexts refers to the application of distributed ledger technology for tracking, verifying, and managing the flow of goods, services, and information across supply networks."@en ;
