ngm:distributed-systems-theory a owl:Class ;
    rdfs:label "Distributed Systems Theory"@en ;
    rdfs:comment "The theoretical study of computational systems whose components run on separate networked machines and coordinate by passing messages, encompassing fundamental impossibility results, consistency models, and formal proofs of consensus and replication protocols."@en ;
