        ngm:trustworthy-ai ;
    vc:uses ngm:gradient-aggregation,
        ngm:zero-knowledge-proof .

ngm:probabilistic-reasoning a owl:Class ;
    rdfs:label "Probabilistic Reasoning"@en ;
    rdfs:comment "Probabilistic reasoning is the process of drawing conclusions under uncertainty by representing beliefs as probability distributions and updating them with evidence according to the rules of probability. It uses models such as graphical models and applies inference procedures, often grounded in Bayesian updating, to compute the likelihood of hypotheses given observations. By quantifying uncertainty explicitly, it supports robust decision-making where deterministic logic would be brittle."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:probabilistic-model ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:inference-engine ],
        ngm:reasoning ;
    vc:contrastsWith ngm:fuzzy-logic ;
    vc:enables ngm:decision-making,
        ngm:uncertainty-quantification ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:inference,
        ngm:statistical-inference ;
    vc:isPartOf ngm:artificial-intelligence ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:bayesian-inference,
        ngm:markov-chain,
        ngm:uncertainty ;
    vc:requires ngm:inference-engine,
        ngm:probabilistic-model ;
    vc:slug "probabilistic-reasoning" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:machine-learning ;
    vc:uses ngm:bayesian-inference,
        ngm:graphical-model,
        ngm:probability-distribution .

ngm:process-mining a owl:Class ;
    rdfs:label "Process Mining"@en ;
    rdfs:comment "Process mining is a family of data-driven techniques that reconstruct, analyse, and improve real business processes by extracting knowledge from event logs recorded in enterprise information systems. It encompasses process discovery, which infers a process model from observed event sequences; conformance checking, which compares the discovered behaviour against a reference model; and enhancement, which enriches models with performance and frequency data. By grounding analysis in actual recorded execution rather than idealised documentation, it reveals bottlenecks, deviations, and automation opportunities."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:event-log ],
        ngm:business-process-management ;
    vc:contrastsWith ngm:robotic-process-automation ;
    vc:dependsOn ngm:event-log ;
    vc:enables ngm:hyperautomation,
        ngm:process-automation,
        ngm:robotic-process-automation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:event-log ;
    vc:isPartOf ngm:business-process-management ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:business-intelligence,
        ngm:workflow-automation ;
    vc:slug "process-mining" ;
    vc:sourceDomain "ai" ;
    vc:supports ngm:intelligent-automation ;
    vc:uses ngm:business-intelligence,
        ngm:event-log,
        ngm:machine-learning .

ngm:programming-paradigm a owl:Class ;
    rdfs:label "Programming Paradigm"@en ;
    rdfs:comment "Programming Paradigms in AI represent fundamental styles and approaches to structuring code for artificial intelligence systems. Key paradigms include imperative (procedural, object-oriented), declarative (functional, logic-based), and differentiable programming, each shaping how models are specified, composed, and optimised across symbolic and neural approaches."@en ;
    rdfs:subClassOf ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:enables ngm:ai-augmented-software-engineering,
        ngm:deep-learning ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:software-engineering,
        ngm:symbolic-ai ;
    vc:slug "programming-paradigm" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:logic-programming,
        ngm:machine-learning-discipline .

ngm:proportional-valve a owl:Class ;
    rdfs:label "Proportional Valve"@en ;
    rdfs:comment "A proportional valve is a fluid-power control element that modulates flow rate, pressure, or direction continuously and proportionally in response to an electrical command signal, in contrast to on/off solenoid valves that switch between two discrete states. The valve's spool or poppet position is controlled by a proportional solenoid or voice-coil actuator whose force output is linearly related to the applied current, enabling smooth, variable control of hydraulic or pneumatic systems."@en ;
    rdfs:subClassOf ngm:fluid-power-device ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:isPartOf ngm:industrial-automation ;
    vc:qualityScore "0.85"^^xsd:float ;
    vc:relatedTo ngm:hydraulic-actuator,
        ngm:pneumatic-actuator,
        ngm:servo-valve ;
    vc:slug "proportional-valve" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:feedback-control,
        ngm:pid-controller .

ngm:protocol-owned-liquidity a owl:Class ;
    rdfs:label "Protocol-Owned Liquidity"@en ;
    rdfs:comment "Protocol-owned liquidity (POL) is a DeFi treasury strategy in which a protocol acquires and holds its own trading-pair liquidity rather than renting it from third-party liquidity providers through mercenary incentives. By owning the liquidity, the protocol earns trading fees, gains durable market depth, and reduces dependence on emissions that can trigger capital flight. It was popularised by bonding mechanisms in OlympusDAO-style designs."@en ;
    rdfs:subClassOf ngm:bc-defi-and-economics ;
    skos:broader ngm:bc-defi-and-economics ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:treasury-management ;
    vc:slug "protocol-owned-liquidity" ;
    vc:sourceDomain "blockchain" .

ngm:protocol-specification a owl:Class ;
    rdfs:label "Protocol Specification"@en ;
    rdfs:comment "A protocol specification is a precise, unambiguous document that defines how independent systems must exchange messages to interoperate, covering message formats, encodings, sequencing, state machines, error handling and timing. It serves as the authoritative contract that implementers follow so that conforming systems built by different parties can communicate reliably. Well-formed specifications separate the wire format and behaviour from any particular implementation, and they are typically published and maintained by standards bodies to ensure long-term interoperability."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
