    vc:sourceDomain "artificial-intelligence" .

ngm:schnorr-signature a owl:Class ;
    rdfs:label "Schnorr Signature"@en ;
    rdfs:comment "A provably secure digital signature scheme based on the discrete logarithm problem over elliptic curves, offering linearity properties that enable key and signature aggregation. Within blockchain systems Schnorr signatures underpin features such as Taproot, MuSig multi-signature protocols, and threshold signing, providing smaller signature sizes and stronger privacy compared to ECDSA."@en ;
    rdfs:subClassOf ngm:bc-cryptographic-primitive,
        ngm:blockchain-entity,
        ngm:cryptographic-primitive ;
    skos:broader ngm:bc-cryptographic-primitive ;
    vc:enables ngm:digital-signature-verification,
        ngm:merkle-tree ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:digital-signature,
        ngm:ecdsa,
        ngm:elliptic-curve-cryptography,
        ngm:signature-scheme,
        ngm:taproot-assets ;
    vc:slug "schnorr-signature" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:cryptographic-hash-function,
        ngm:secp256k1 .

ngm:supply-chain a owl:Class ;
    rdfs:label "Supply Chain"@en ;
    rdfs:comment "A supply chain is the end-to-end network of organisations, processes, logistics flows, and information systems involved in producing and delivering a product from raw material sourcing through manufacturing, distribution, and retail to the final consumer. Supply chains are characterised by multi-tier supplier relationships, demand variability, lead-time uncertainty, and growing regulatory requirements around environmental and social provenance. Blockchain-based traceability systems and AI-driven demand-forecasting tools are increasingly applied to improve resilience, transparency, and sustainability reporting across supply chain tiers."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:supply-chain-traceability ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:supply-chain-management ],
        ngm:infra-data-management ;
    skos:broader ngm:infra-data-management ;
