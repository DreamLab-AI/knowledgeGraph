    vc:slug "fraud-prevention" ;
    vc:sourceDomain "security" .
ngm:fraud-proof a owl:Class ;
    rdfs:comment "A fraud proof is a cryptographic mechanism that allows any observer (a challenger) to demonstrate on-chain that a previously published off-chain state transition is invalid. It is the primary dispute mechanism for optimistic rollups, where sequencers post state roots optimistically and a challenge window allows watchers to submit a fraud proof if they detect an incorrect computation. Upon successful verification of a fraud proof by the base layer, the invalid state root is reverted and the sequencer's bonded stake is slashed as a penalty."@en ;
    rdfs:label "Fraud Proof"@en ;
    rdfs:subClassOf ngm:cryptographic-proof ;
    rdfs:subClassOf _:r10745 ;
    vc:bridgesTo ngm:formal-verification ;
    vc:bridgesTo ngm:game-theory ;
    vc:contrastsWith ngm:validity-proof ;
