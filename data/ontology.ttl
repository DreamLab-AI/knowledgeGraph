        ngm:real-time-monitoring .

ngm:fluid-simulation a owl:Class ;
    rdfs:label "Fluid Simulation"@en ;
    rdfs:comment "Fluid Simulation is the computational modelling of liquid and gas dynamics using numerical methods — notably computational fluid dynamics (CFD) and Navier-Stokes solvers — to produce physically plausible representations of water, smoke, fire, and atmospheric phenomena in real-time or offline rendering pipelines. In spatial computing and metaverse environments it contributes to environmental immersion and interactive physics, running on GPU compute shaders for performance-critical applications."@en ;
    rdfs:subClassOf ngm:sc-display-and-rendering ;
    skos:broader ngm:sc-display-and-rendering ;
    vc:enables ngm:embodied-ai-simulation ;
