ngm:video-generation a owl:Class ;
    rdfs:label "Video Generation"@en ;
    rdfs:comment "Video generation is the AI-driven synthesis of temporally coherent video sequences from text prompts, images, or other conditioning inputs using generative models such as latent diffusion or transformer architectures. Beyond static spatial coherence, video generation must maintain temporal consistency across frames, respect physical motion dynamics, and handle variable-length sequences, making it substantially more constrained than image generation. Modern approaches typically encode video into a compressed latent space, apply a diffusion or autoregressive process in that space, and decode back to pixel space, with text conditioning provided via a cross-attention mechanism fed by a text encoder."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:diffusion-model ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:text-encoder ],
        ngm:ai-application ;
    skos:broader ngm:ai-application ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:image-generation,
        ngm:latent-diffusion,
        ngm:multimodal-ai ;
    vc:requires ngm:diffusion-model,
        ngm:text-encoder ;
    vc:slug "video-generation" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:transformer-architecture .

ngm:51-attack a owl:Class ;
    rdfs:label "51% Attack"@en ;
    rdfs:comment "A 51% Attack is a consensus-layer attack on a Proof-of-Work blockchain in which a single entity or coalition controls more than half of the network's hash rate, enabling double-spending, transaction censorship, and chain reorganisation. The attack exploits the longest-chain rule: the attacker mines a private fork containing fraudulent transactions and, once it exceeds the honest chain in cumulative work, broadcasts it to override confirmed history."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:mining-pool ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:proof-of-work ],
        ngm:bc-protocol-and-consensus ;
    skos:broader ngm:bc-protocol-and-consensus ;
    vc:contrastsWith ngm:byzantine-fault-tolerance,
        ngm:proof-of-stake ;
    vc:enables ngm:double-spending ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:relatedTo ngm:finality,
        ngm:selfish-mining ;
    vc:requires ngm:mining-pool,
        ngm:proof-of-work ;
    vc:slug "51-attack" ;
    vc:sourceDomain "blockchain" .

ngm:ai-risk a owl:Class ;
    rdfs:label "AI Risk"@en ;
    rdfs:comment "The potential for AI systems to cause adverse effects on individuals, groups, organizations, communities, or society, arising from technical failures, security vulnerabilities, biased outcomes, privacy violations, or unintended consequences of system design, deployment, or operation."@en ;
