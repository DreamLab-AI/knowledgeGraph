    vc:slug "investor-protection" ;
    vc:sourceDomain "governance" .

ngm:ip-adapter a owl:Class ;
    rdfs:label "IP-Adapter"@en ;
    rdfs:comment "IP-Adapter (Image Prompt Adapter) is a lightweight adapter module for pre-trained text-to-image diffusion models that enables image-conditioned generation by injecting reference image features via a decoupled cross-attention mechanism. Introduced by Tencent AI Lab in 2023, it allows users to supply a reference image alongside a text prompt to control style, subject identity, or composition without fine-tuning the base diffusion model. The adapter architecture inserts parallel cross-attention layers that process image embeddings from a pre-trained image encoder such as CLIP, keeping base model weights frozen."@en ;
    rdfs:subClassOf ngm:adapter-modules ;
    vc:contrastsWith ngm:fine-tuning ;
    vc:dependsOn ngm:attention-mechanism,
        ngm:cross-attention,
        ngm:diffusion-model,
        ngm:stable-diffusion ;
    vc:enables ngm:computer-vision,
        ngm:generative-ai ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:control-net,
        ngm:fine-tuning,
        ngm:image-to-image-translation,
        ngm:inpainting,
        ngm:style-transfer ;
    vc:slug "ip-adapter" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:hugging-face-diffusers,
        ngm:image-generation,
        ngm:prompt-engineering .

ngm:iso-tc-307 a owl:Class ;
    rdfs:label "ISO TC 307"@en ;
    rdfs:comment "ISO/TC 307 is the ISO technical committee established in 2016 with a mandate to develop international standards for blockchain and distributed ledger technologies, covering terminology (ISO 22739), reference architecture, security and privacy, smart contract interactions, identity, and governance frameworks. The committee coordinates with other bodies including IEEE, ITU, and national standards organisations to ensure interoperability of DLT systems and provides normative vocabulary that underpins regulatory and procurement language in blockchain-related initiatives worldwide."@en ;
    rdfs:subClassOf ngm:bc-governance-and-regulation ;
    skos:broader ngm:bc-governance-and-regulation ;
    vc:enables ngm:blockchain-interoperability,
        ngm:distributed-ledger-technology ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:blockchain,
        ngm:digital-identity-standards,
        ngm:smart-contract ;
    vc:slug "iso-tc-307" ;
    vc:sourceDomain "blockchain" ;
    vc:standardizedBy ngm:blockchain-governance .

ngm:khronos-group a owl:Class ;
    rdfs:label "Khronos Group"@en ;
    rdfs:comment "The Khronos Group is an open, member-driven industry consortium that creates and maintains royalty-free standards for graphics, compute, and media APIs across a wide range of platforms and devices. Founded in 2000, its portfolio includes OpenGL, Vulkan, OpenCL, OpenXR, glTF, and NNEF, among others. Khronos standards form the foundational layer for GPU-accelerated rendering, XR runtimes, and portable neural network deployment across the technology industry."@en ;
    rdfs:subClassOf ngm:standardization-bodies ;
    vc:enables ngm:3-d-graphics-standard,
        ngm:gpu-compute,
        ngm:graphics-api,
        ngm:spatial-computing ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:3-d-file-format,
        ngm:interoperability-standard,
        ngm:open-standard,
        ngm:rendering-technology,
        ngm:technical-standard ;
    vc:slug "khronos-group" ;
    vc:sourceDomain "governance" ;
    vc:supports ngm:augmented-reality,
        ngm:machine-learning-framework,
        ngm:mixed-reality,
        ngm:virtual-reality .

ngm:khronos-open-xr a owl:Class ;
    rdfs:label "Khronos OpenXR"@en ;
    rdfs:comment "Khronos OpenXR is an open, royalty-free standard that defines a common application interface for virtual and augmented reality devices, decoupling XR applications from specific runtimes and hardware."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:open-xr ],
        ngm:spatial-computing-domain ;
    vc:enables ngm:augmented-reality,
        ngm:virtual-reality ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:open-xr ;
    vc:slug "khronos-open-xr" ;
    vc:sourceDomain "metaverse" .

ngm:kinematic-chain a owl:Class ;
    rdfs:label "Kinematic Chain"@en ;
    rdfs:comment "A kinematic chain is an assembly of rigid bodies (links) connected by joints that constrain their relative motion, forming the structural and mathematical basis for analysing and controlling the motion of mechanisms and robots. Open kinematic chains (serial manipulators) have one free end and exhibit simple forward kinematics but complex inverse kinematics; closed kinematic chains (parallel manipulators) have all links connected in loops, offering higher stiffness and load capacity. The Denavit-Hartenberg convention provides the canonical parameterisation for representing joint geometry and computing transformations along the chain, underpinning all modern robot programming and simulation systems."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:kinematic-element ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:end-effector ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:actuator ],
        ngm:kinematics ;
    vc:enables ngm:forward-kinematics,
        ngm:inverse-kinematics,
        ngm:motion-planning,
        ngm:trajectory-planning ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:actuator,
        ngm:end-effector,
        ngm:kinematic-element ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:differential-kinematics,
        ngm:manipulator-arm,
        ngm:robot-kinematics ;
    vc:slug "kinematic-chain" ;
    vc:sourceDomain "robotics" .

ngm:leader-election a owl:Class ;
    rdfs:label "Leader Election"@en ;
    rdfs:comment "Leader election is a fundamental coordination primitive in distributed computing that enables a cluster of peer nodes to agree on a single node — the leader — that assumes special coordination responsibilities such as sequencing writes, directing consensus rounds, or managing resource allocation on behalf of the group. In the presence of node failures, network partitions, or leader crashes, the leader election protocol must reliably select a new leader from the surviving nodes while ensuring safety (at most one leader at a time) and liveness (a leader is eventually elected) properties hold."@en ;
    rdfs:subClassOf ngm:distributed-consensus ;
    vc:enables ngm:consensus-protocol,
        ngm:distributed-system,
        ngm:service-discovery ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:byzantine-fault-tolerance,
        ngm:participant-coordination ;
    vc:slug "leader-election" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:consensus-algorithm,
        ngm:fault-tolerance,
        ngm:paxos,
        ngm:raft .

ngm:learning-module a owl:Class ;
    rdfs:label "Learning Module"@en ;
    rdfs:comment "Self-contained educational units within VR and metaverse training systems that provide structured learning experiences, including interactive simulations, assessments, and collaborative activities designed for specific skill development objectives."@en ;
    rdfs:subClassOf ngm:educational-technology,
        ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:enables ngm:structured-training ;
