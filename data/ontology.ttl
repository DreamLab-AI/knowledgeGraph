    vc:slug "ai-generated-content" ;
    vc:sourceDomain "governance" ;
    vc:standardizedBy ngm:c2pa ;
    vc:supports ngm:digital-watermarking .

ngm:ai-group-formation a owl:Class ;
    rdfs:label "AI Group Formation"@en ;
    rdfs:comment "AI Group Formation is the automated assignment of participants into subgroups using models that optimise for criteria such as skill balance, topic affinity, social diversity, or learning objectives. In collaborative and meeting platforms it drives features like intelligent breakout-room allocation, replacing manual or random grouping. The technique combines clustering, optimisation, and sometimes reinforcement learning over participant attributes and interaction signals."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-pipeline ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:constraint-satisfaction ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:distance-metric ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:feature-engineering ],
        ngm:ai-application,
        ngm:combinatorial-optimisation ;
    skos:broader ngm:ai-application ;
    vc:contrastsWith ngm:automatic-grouping,
        ngm:manual-room-assignment ;
    vc:dependsOn ngm:learning-analytics,
        ngm:learning-management-system ;
    vc:enables ngm:breakout-room,
        ngm:collaborative-learning,
        ngm:participation-equity,
        ngm:personalised-learning ;
    vc:hasMaturity ngmi:maturity-emerging ;
