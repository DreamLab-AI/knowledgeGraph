        ngm:multisig-wallet ;
    vc:requires ngm:key-management ;
    vc:slug "hot-wallet" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:cryptocurrency-exchange,
        ngm:de-fi ;
