ngm:eidas-regulation a owl:Class ;
    rdfs:comment "The eIDAS Regulation is the European Union framework on electronic identification and trust services for electronic transactions in the internal market. It establishes legal recognition and cross-border interoperability for electronic identification schemes and for trust services such as electronic signatures, seals, timestamps and website authentication. Its revision introduces the European Digital Identity Wallet, extending qualified trust services to verifiable digital credentials."@en ;
    rdfs:label "eIDAS Regulation"@en ;
    rdfs:subClassOf ngm:regulatory-compliance ;
