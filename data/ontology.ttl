    vc:sourceDomain "spatial-computing" .

ngm:etsi-domain-infrastructure-data a owl:Class ;
    rdfs:label "ETSI_Domain_Infrastructure_Data"@en ;
    rdfs:comment "The ETSI Infrastructure Data domain is the foundational technical and architectural framework enabling trustworthy, sovereign data exchange within metaverse and digital ecosystems through decentralised data spaces, spatial intelligence integration, and policy-driven governance standards. It operationalises Trustworthy Data Spaces via NGSI-LD APIs, Federated Catalogs, Policy Enforcement Points, and F5G backbone connectivity to address data sovereignty, security, and real-to-virtual integration across distributed networks."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:storage-layer ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:data-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:verifiable-credentials ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-governance ],
        ngm:infra-data-management ;
    skos:broader ngm:infra-data-management ;
    vc:enables ngm:distributed-ledger-technology-dlt,
        ngm:edge-computing ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:data-management,
        ngm:storage-layer ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:etsi-domain-data-management,
        ngm:etsi-domain-infrastructure ;
    vc:requires ngm:data-governance,
        ngm:verifiable-credentials ;
    vc:slug "etsi-domain-infrastructure-data" ;
    vc:sourceDomain "infrastructure" .

ngm:etsi-domain-interoperability a owl:Class ;
    rdfs:label "ETSI_Domain_Interoperability"@en ;
    rdfs:comment "ETSI domain consolidating standards enabling different systems and organisations to work together effectively through technical and semantic data exchange mechanisms, shared vocabularies such as NGSI-LD and SAREF, and standardised protocols. It covers avatar interoperability, digital twin synchronisation, state synchronisation, and portability of digital assets across metaverse platforms."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:digital-twin-interop-protocol ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:avatar-interoperability ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:portability ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:state-synchronization ],
        ngm:infra-network-and-comms ;
    skos:broader ngm:infra-network-and-comms ;
    vc:enables ngm:discovery-layer,
        ngm:interoperability ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:avatar-interoperability,
        ngm:digital-twin-interop-protocol,
        ngm:portability,
        ngm:state-synchronization ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:slug "etsi-domain-interoperability" ;
    vc:sourceDomain "infrastructure" ;
    vc:standardizedBy ngm:api-standard,
        ngm:interoperability-framework .

ngm:exchange-mechanism a owl:Class ;
    rdfs:label "Exchange Mechanism"@en ;
    rdfs:comment "An Exchange Mechanism is a protocol or technical construct that governs the transfer of digital assets, tokens, or value between parties within a virtual economy or cross-platform environment. Exchange mechanisms specify the rules for matching buyers and sellers, executing atomic swaps, handling liquidity, and settling transactions, forming the economic infrastructure of metaverse marketplaces."@en ;
    rdfs:subClassOf ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:enables ngm:digital-asset-trading,
        ngm:marketplace ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:relatedTo ngm:liquidity-pool,
        ngm:token-economics ;
    vc:slug "exchange-mechanism" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:blockchain,
        ngm:smart-contract .

ngm:experiment a owl:Class ;
    rdfs:label "experiment"@en ;
    rdfs:comment "An experiment is a structured empirical procedure designed to test a hypothesis or evaluate a system under controlled conditions, producing observable and repeatable results. In the context of AI and software engineering it encompasses both scientific investigations (measuring model behaviour, benchmarking performance) and engineering trials (A/B tests, canary deployments, feature flags) aimed at generating evidence to guide design decisions."@en ;
    rdfs:subClassOf ngm:infra-software-engineering ;
    skos:broader ngm:infra-software-engineering ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:evaluation-benchmarks-and-leaderboards,
        ngm:machine-learning,
        ngm:research-methods,
        ngm:scientific-discovery ;
    vc:slug "experiment" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:benchmark-standard ;
    vc:uses ngm:software-testing,
        ngm:validation-process .

ngm:explainability-oecd a owl:Class ;
    rdfs:label "Explainability (OECD)"@en ;
    rdfs:comment "The OECD AI Principle (1.3) requiring that people affected by AI-based outcomes are able to understand how and why particular decisions or recommendations were reached. Explanations must be contextually appropriate, enable meaningful contestation, and illuminate causal factors—operationalised through LIME, SHAP, attention visualisation, and inherently interpretable model architectures."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ai-regulation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:human-in-the-loop ],
        ngm:ai-governance-and-ethics ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:contrastsWith ngm:ai-ethics ;
    vc:enables ngm:ai-safety ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:accountability-oecd,
        ngm:fairness-oecd,
        ngm:human-centred-values ;
    vc:requires ngm:ai-regulation,
        ngm:human-in-the-loop ;
    vc:slug "explainability-oecd" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:fault-tolerance-system a owl:Class ;
    rdfs:label "Fault Tolerance System"@en ;
    rdfs:comment "A Fault Tolerance System is an engineering design framework enabling a distributed system to continue correct operation despite component failures, network disruptions, or malicious behaviour by a subset of participants. These systems employ redundancy, error detection, and automatic recovery to mask failures from end users, with Byzantine fault tolerance being the gold standard for adversarial environments such as public blockchains, which require at least 3f+1 total nodes to tolerate f Byzantine failures."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:byzantine-fault-tolerance ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:data-replication ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:replication-system ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:consensus-mechanism ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:distributed-system ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:distributed-systems ],
        ngm:bc-network-component,
        ngm:blockchain-entity ;
    skos:broader ngm:bc-network-component ;
    vc:contrastsWith ngm:distributed-ledger-technology ;
    vc:enables ngm:blockchain,
