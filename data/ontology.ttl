    vc:contrastsWith ngm:differential-privacy ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:relatedTo ngm:adversarial-attack,
        ngm:data-protection,
        ngm:model-inversion,
        ngm:privacy ;
    vc:requires ngm:machine-learning-discipline-model,
        ngm:training-data ;
    vc:slug "membership-inference" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:merkle-dag a owl:Class ;
    rdfs:label "Merkle DAG"@en ;
    rdfs:comment "A Merkle Directed Acyclic Graph (DAG) is a data structure combining Merkle tree hash-linking with a generalised directed acyclic graph topology, allowing nodes to have multiple parents and enabling content-addressed, tamper-evident storage of arbitrary graph-shaped data. Unlike a binary Merkle tree, each node's cryptographic hash is derived from all its children, forming a unique, immutable identifier for any subgraph."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:content-addressing ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:collision-resistance ],
        ngm:content-addressing ;
    vc:bridgesTo ngm:cross-chain-interoperability,
        ngm:data-structure,
        ngm:zero-knowledge-proof ;
    vc:contrastsWith ngm:merkle-patricia-trie,
        ngm:merkle-tree ;
    vc:dependsOn ngm:immutable-record,
        ngm:peer-to-peer-network ;
    vc:enables ngm:deduplication,
        ngm:distributed-storage,
        ngm:ipfs,
        ngm:tamper-evident-storage,
        ngm:verifiable-computation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:data-structure ;
    vc:isPartOf ngm:ipld ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:distributed-ledger-technology,
        ngm:filecoin,
        ngm:git,
        ngm:merkle-tree ;
    vc:requires ngm:collision-resistance,
        ngm:content-addressing ;
    vc:slug "merkle-dag" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:reproducible-builds,
        ngm:version-control ;
    vc:uses ngm:content-identifier,
        ngm:cryptographic-hash-function,
        ngm:directed-acyclic-graph .

ngm:middleware-layer a owl:Class ;
    rdfs:label "Middleware Layer"@en ;
    rdfs:comment "The Middleware Layer is the stratum of software infrastructure that sits between low-level platform services or network protocols and the application-facing interfaces that consume them, providing integration, abstraction, orchestration, and interoperability services. It decouples system components by standardising communication contracts through APIs, messaging buses, and RPC frameworks, and bridges heterogeneous subsystems — including on-chain protocols, off-chain data sources, and cross-network boundaries — without requiring changes to the underlying protocol or the consuming application. In distributed and blockchain architectures the layer encompasses API gateways, oracle networks, cross-chain bridges, indexing services, wallet connectors, and transaction orchestration utilities that collectively raise the abstraction level available to developers. Its maturity is well-established in enterprise computing and rapidly maturing in decentralised ecosystems."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:json-data-interchange-format-rpc ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:api-gateway ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:service-mesh ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:price-oracle ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:message-broker ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:network-protocol ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:application-programming-interface ],
        ngm:infra-computing-and-cloud ;
    skos:broader ngm:infra-computing-and-cloud ;
    vc:bridgesTo ngm:inference,
        ngm:oracle-network,
        ngm:smart-contract ;
    vc:contrastsWith ngm:application-layer,
        ngm:protocol-layer ;
    vc:dependsOn ngm:protocol-layer,
        ngm:transport-layer ;
    vc:enables ngm:cross-chain-bridge,
        ngm:interoperability,
        ngm:microservices,
        ngm:scalability ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:api-gateway,
        ngm:json-data-interchange-format-rpc,
        ngm:message-broker,
        ngm:price-oracle,
        ngm:service-mesh ;
    vc:implements ngm:event-driven-architecture,
        ngm:service-oriented-architecture ;
    vc:isPartOf ngm:distributed-system,
        ngm:software-architecture ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:abstraction-layer,
        ngm:enterprise-service-bus ;
    vc:requires ngm:application-programming-interface,
        ngm:network-protocol ;
    vc:slug "middleware-layer" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:application-layer,
        ngm:decentralised-application ;
    vc:uses ngm:load-balancing,
        ngm:publish-subscribe-pattern,
        ngm:remote-procedure-call .

ngm:mini-batch a owl:Class ;
    rdfs:label "Mini-Batch"@en ;
    rdfs:comment "A mini-batch is a small, fixed-size subset of a training dataset processed together in a single forward and backward pass when training a machine learning model. Mini-batch gradient descent computes the gradient over the mini-batch rather than over a single example (stochastic) or the entire dataset (full batch), balancing the noise-reduction benefits of larger batches against the computational and memory cost. The mini-batch size is a key hyperparameter that influences convergence behaviour, gradient variance, hardware utilisation and generalisation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:backpropagation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:optimization-algorithm ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:loss-function ],
        ngm:stochastic-gradient-descent ;
    vc:contrastsWith ngm:epoch ;
    vc:enables ngm:data-parallelism ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:loss-function ;
    vc:isPartOf ngm:gradient-descent,
        ngm:model-training ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:convolutional-neural-network,
        ngm:overfitting ;
    vc:requires ngm:backpropagation,
        ngm:optimization-algorithm ;
    vc:slug "mini-batch" ;
    vc:sourceDomain "machine-learning" ;
    vc:supports ngm:deep-learning,
        ngm:neural-network ;
    vc:uses ngm:gpu-acceleration,
        ngm:matrix-multiplication .

ngm:model-governance a owl:Class ;
    rdfs:label "Model Governance"@en ;
    rdfs:comment "Model governance is the framework of policies, roles, controls, and documentation that an organisation applies across the lifecycle of its machine learning and statistical models to manage their risk, ensure their fitness for purpose, and satisfy regulatory and ethical obligations. It establishes accountability for model development, validation, approval, deployment, and ongoing monitoring, supported by artefacts such as model cards, audit trails, and validation reports. By imposing oversight, documentation, and review gates, it ensures models remain accurate, fair, explainable, and compliant rather than opaque or unaccountable."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:explainability ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:model-validation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:audit-trail ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:model-cards ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:model-monitoring ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:model-documentation ],
        ngm:ai-governance ;
    vc:bridgesTo ngm:data-governance,
        ngm:mlops ;
    vc:enables ngm:regulatory-compliance,
        ngm:responsible-ai ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:model-cards,
        ngm:model-documentation,
        ngm:model-validation ;
    vc:isPartOf ngm:ai-governance ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:model-deployment,
        ngm:responsible-ai ;
    vc:requires ngm:audit-trail,
        ngm:explainability,
        ngm:model-monitoring ;
    vc:slug "model-governance" ;
    vc:sourceDomain "machine-learning" ;
    vc:supports ngm:fairness,
        ngm:regulatory-compliance ;
    vc:uses ngm:model-evaluation,
        ngm:model-registry .

ngm:model-inversion a owl:Class ;
    rdfs:label "Model Inversion"@en ;
    rdfs:comment "An inference-time privacy attack that reconstructs sensitive training data or personal attributes from a trained model by iteratively querying model outputs, confidence scores, or internal representations. Model inversion attacks expose a fundamental tension between model utility and data privacy, motivating defences such as differential privacy, federated learning, and membership-inference auditing."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:model-weights ],
        ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:contrastsWith ngm:differential-privacy,
        ngm:federated-learning ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:relatedTo ngm:adversarial-attacks,
        ngm:membership-inference ;
    vc:requires ngm:model-weights ;
    vc:slug "model-inversion" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:ai-safety .

ngm:model-transparency a owl:Class ;
    rdfs:label "Model Transparency"@en ;
    rdfs:comment "The capability to understand, explain, and interpret the decision-making processes within AI and machine learning models, encompassing explainability, interpretability, and accountability requirements essential for responsible AI deployment."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
