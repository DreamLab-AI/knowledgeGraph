vf:bitcoin-mining a owl:Class ;
    rdfs:label "Bitcoin Mining"@en ;
    rdfs:comment "**Bitcoin Mining** is the [[proof-of-work]] [[Nakamoto consensus]] process by which the [[Bitcoin]] [[blockchain]] is extended, secured, and monetised through competitive computation of [[SHA-256]] double-hash preimages whose output, interpreted as a 256-bit unsigned integer, falls below a network-adjusted [[difficulty target]] (currently corresponding to ~10^23 to ~10^24 hashes per block), executed by purpose-built [[ASIC]] (Application-Specific Integrated Circuit) hardware operating at industrial scale in geographically-distributed data centres that as of Q1 2026 collectively dissipate ~700-1000 EH/s (exahashes/second, ~10^21 hashes/second), consume approximately 175-200 TWh/year of electricity (CBECI midpoint), and generate roughly 144 new [[block]]s per day each carrying a [[block subsidy]] of **3.125 BTC** (since the fourth [[halving]] on **20 April 2024** at block 840,000, reduced from the prior 6.25 BTC under the geometric series 50 → 25 → 12.5 → 6.25 → 3.125 → ... → 0 BTC scheduled to terminate near block 6,930,000 around 2140) plus cumulative [[transaction fees]] from included [[mempool]] entries (a fee market increasingly material with [[Ordinals]]/[[Inscriptions]]/[[Rune"@en ;
    rdfs:subClassOf <urn:visionflow:linked:cryptographic-mining>,
        <urn:visionflow:linked:industrial-process>,
        vf:consensus-mechanism,
        vf:distributed-computing,
        vf:proof-of-work ;
    vc:authorityScore "0.87"^^xsd:float ;
    vc:enables <urn:visionflow:linked:bitcoin-issuance>,
        <urn:visionflow:linked:blockchain-security>,
        <urn:visionflow:linked:demand-response-services>,
        <urn:visionflow:linked:double-spend-prevention>,
        <urn:visionflow:linked:permissionless-settlement>,
        vf:transaction-confirmation ;
    vc:hasPart <urn:visionflow:linked:asic>,
        <urn:visionflow:linked:nonce-search>,
        <urn:visionflow:linked:sha-256-hashing>,
        vf:block-header,
        vf:coinbase-transaction,
        vf:difficulty-target,
        vf:mempool,
        vf:merkle-tree,
        vf:mining-pool ;
    vc:implements <urn:visionflow:linked:coinbase-reward-distribution>,
        <urn:visionflow:linked:difficulty-adjustment-algorithm>,
        <urn:visionflow:linked:halving-schedule>,
        vf:longest-chain-rule,
        vf:nakamoto-consensus ;
    vc:maturity "production-ready" ;
    vc:qualityScore "0.52"^^xsd:float ;
    vc:requires <urn:visionflow:linked:asic-hardware>,
        <urn:visionflow:linked:bitcoin-full-node>,
        <urn:visionflow:linked:cooling-system>,
        <urn:visionflow:linked:electricity>,
        <urn:visionflow:linked:network-connectivity>,
        <urn:visionflow:linked:stratum-protocol> ;
    vc:slug "bitcoin-mining" ;
    vc:sourceDomain "blockchain" .

vf:blockchain-interoperability a owl:Class ;
    rdfs:label "Blockchain Interoperability"@en ;
    rdfs:comment "**Blockchain Interoperability** is the technical and economic capability for distinct, sovereign blockchain networks to securely communicate state, transfer assets, invoke smart contracts, and propagate consensus across heterogeneous trust domains without relinquishing each chain's independent finality, governance, or economic security — addressing the structural fragmentation of the 2026 blockchain landscape in which 200+ production layer-1 networks plus 50+ Ethereum rollups (Optimism, Arbitrum, Base, zkSync, Starknet, Linea, Scroll, Polygon zkEVM, Mantle, Blast, Mode, Fraxtal, Cyber, Soneium and growing weekly via Conduit, Caldera, AltLayer rollup-as-a-service), 100+ Cosmos zones connected via IBC, and 50+ Polkadot parachains operate as economically and computationally isolated trust islands collectively securing roughly $3.5 trillion in 2025-cycle peak market capitalisation across incompatible consensus mechanisms (Nakamoto PoW, Tendermint BFT, GRANDPA/BABE PoS, GHOST-Casper, HotStuff variants, DAG-based), virtual machines (EVM, WASM, MoveVM, SVM, Bitcoin Script, Cairo VM, RISC-V via Polkadot JAM 2025+), state models (UTXO, account-based, object-centric Sui/Aptos), and finality "@en ;
    rdfs:subClassOf <urn:visionflow:linked:cross-chain-communication>,
        <urn:visionflow:linked:distributed-systems-protocol>,
        <urn:visionflow:linked:network-interoperability>,
        vf:blockchain-infrastructure,
        vf:cryptographic-protocol ;
    vc:authorityScore "0.87"^^xsd:float ;
    vc:enables <urn:visionflow:linked:cross-chain-asset-transfer>,
        <urn:visionflow:linked:cross-chain-governance>,
        <urn:visionflow:linked:interchain-token-standard>,
        <urn:visionflow:linked:modular-blockchain-architecture>,
        <urn:visionflow:linked:multi-chain-de-fi>,
        <urn:visionflow:linked:omnichain-application>,
        <urn:visionflow:linked:unified-liquidity> ;
    vc:hasPart <urn:visionflow:linked:bridge-contract>,
        <urn:visionflow:linked:cryptographic-proof-system>,
        <urn:visionflow:linked:message-passing-protocol>,
        <urn:visionflow:linked:state-verification-mechanism>,
        <urn:visionflow:linked:trust-assumption-model>,
        <urn:visionflow:linked:validator-set>,
        vf:light-client,
        vf:relayer ;
    vc:implements <urn:visionflow:linked:burn-and-mint-bridge>,
