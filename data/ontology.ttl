ngm:various-links a owl:Class ;
    rdfs:label "Various Links"@en ;
    rdfs:comment "A curated collection of external hyperlinks spanning blockchain, cryptocurrency, augmented and virtual reality, AI generative tools, and media production resources, assembled as a research reference page for cross-domain topics relevant to the NarrativeGoldmine knowledge graph."@en ;
    rdfs:subClassOf ngm:infra-software-engineering ;
