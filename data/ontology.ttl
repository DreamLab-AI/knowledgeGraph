        ngm:reduction-strategy ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires ngm:boundary-definition,
        ngm:emission-factors,
        ngm:lifecycle-data ;
    vc:slug "carbon-footprint-assessment" ;
    vc:sourceDomain "spatial-computing" .

ngm:cloud-native-computing-foundation a skos:Concept ;
    rdfs:label "Cloud Native Computing Foundation"@en .

ngm:coinbase-transaction a owl:Class ;
    rdfs:label "Coinbase Transaction"@en ;
    rdfs:comment "The first transaction in every blockchain block, created by the miner or block producer, that contains no inputs and issues the block reward plus accumulated transaction fees to the miner's address. Unlike regular transactions, the coinbase transaction has no sender; it creates new coins from protocol-defined issuance rules and serves as the primary mechanism by which new cryptocurrency enters circulation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:block-reward ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:transaction-fee ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:mining ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:consensus-mechanism ],
        ngm:bc-protocol-and-consensus,
        ngm:blockchain-entity,
        ngm:consensus-protocol ;
    skos:broader ngm:bc-protocol-and-consensus ;
    vc:enables ngm:cryptocurrency,
        ngm:mining-reward ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:block-reward,
        ngm:transaction-fee ;
    vc:isPartOf ngm:blockchain-network,
        ngm:blockchain-transaction ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:blockchain-protocol,
        ngm:proof-of-work ;
    vc:requires ngm:consensus-mechanism,
        ngm:mining ;
    vc:slug "coinbase-transaction" ;
    vc:sourceDomain "blockchain" .

ngm:collision-resistance a owl:Class ;
    rdfs:label "Collision Resistance"@en ;
    rdfs:comment "A security property of a cryptographic hash function asserting that it is computationally infeasible to find two distinct inputs that produce the same output digest. Collision resistance underpins the integrity guarantees of Merkle trees, digital signatures, and proof-of-work puzzles, and its absence would allow adversaries to forge blocks or certificates."@en ;
    rdfs:subClassOf ngm:bc-cryptographic-primitive,
        ngm:blockchain-entity ;
    skos:broader ngm:bc-cryptographic-primitive ;
    vc:enables ngm:digital-signature,
        ngm:merkle-tree,
        ngm:proof-of-work ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:bc-cryptographic-primitive ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:cryptographic-hash-function,
        ngm:hash-function,
        ngm:keccak-256,
        ngm:preimage-resistance,
        ngm:sha-256 ;
    vc:slug "collision-resistance" ;
    vc:sourceDomain "blockchain" .

ngm:community-detection a owl:Class ;
    rdfs:label "Community Detection"@en ;
    rdfs:comment "Community detection is the computational task of identifying cohesive subgroups, or communities, within a network graph, where nodes within each group are more densely interconnected than they are with nodes in other groups. Algorithms such as the Louvain and Leiden methods optimise a modularity objective to partition the graph, whilst spectral clustering, label propagation, and stochastic block models offer alternative formulations. The problem is formally NP-hard in its general form, making approximation and heuristic approaches the practical norm. Applications span social-network analysis, bioinformatics, knowledge-graph organisation, recommendation systems, and cybersecurity anomaly detection."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:graph-theory ],
        ngm:network-analysis ;
    vc:bridgesTo ngm:blockchain-governance,
        ngm:distributed-systems ;
    vc:contrastsWith ngm:graph-partitioning,
        ngm:hierarchical-clustering ;
    vc:enables ngm:anomaly-detection,
        ngm:data-aggregation,
        ngm:knowledge-graph-embedding,
        ngm:recommendation-systems ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:label-propagation,
        ngm:leiden-algorithm,
        ngm:louvain-algorithm,
        ngm:spectral-clustering,
        ngm:stochastic-block-model ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:clustering,
        ngm:link-prediction,
        ngm:network-topology,
        ngm:social-network-analysis ;
    vc:requires ngm:graph-theory,
        ngm:modularity-optimisation ;
    vc:slug "community-detection" ;
    vc:sourceDomain "machine-learning" ;
    vc:uses ngm:graph-neural-networks,
        ngm:matrix-factorisation,
        ngm:random-walks .

ngm:compiler a owl:Class ;
    rdfs:label "Compiler"@en ;
    rdfs:comment "A software system that translates source code written in a high-level programming language into a lower-level representation — typically machine code, bytecode, or an intermediate representation — performing lexical analysis, syntactic parsing, semantic checking, optimisation, and code emission in a structured pipeline. Compilers are foundational to software development, enabling human-readable programs to run efficiently on hardware."@en ;
    rdfs:subClassOf ngm:software-development ;
    vc:enables ngm:code-generation,
        ngm:runtime-environment ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:onnx-runtime,
        ngm:opcodes ;
    vc:slug "compiler" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:ai-augmented-software-engineering ;
    vc:uses ngm:programming-language .

ngm:compliance-dashboard a owl:Class ;
    rdfs:label "Compliance Dashboard"@en ;
    rdfs:comment "A visual interface and monitoring system that provides real-time visibility into regulatory compliance status, risk metrics, and audit trails across blockchain networks and digital platforms, enabling organizations to track adherence to legal requirements, detect anomalies, and demonstrate compli..."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
