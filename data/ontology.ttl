    vc:enables ngm:open-source-ai ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:implements ngm:digital-markets-act ;
    vc:implements ngm:gdpr ;
    vc:qualityScore "0.8"^^xsd:float ;
