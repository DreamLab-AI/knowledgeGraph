ngm:real-world-asset-tokenisation a owl:Class ;
    rdfs:label "Real-World Asset Tokenisation"@en ;
    rdfs:comment "Real-world asset tokenisation (RWA) is the process of issuing blockchain-based digital tokens that represent legally enforceable ownership or economic claims over physical or financial assets — including real estate, government bonds, private credit, commodities, and infrastructure. Ownership rights, transfer restrictions, and distribution logic are encoded in smart contracts, enabling fractional ownership and 24/7 secondary-market liquidity. The process requires a legal wrapper such as a special purpose vehicle or trust, oracle infrastructure to price off-chain assets on-chain, and compliance with applicable securities regulation in each issuing jurisdiction."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:smart-contract ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:digital-identity ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:kyc-aml-compliance ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:redemption-mechanism ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:token-issuance ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:oracle-network ],
        ngm:bc-token-and-asset ;
    skos:broader ngm:bc-token-and-asset ;
    vc:bridgesTo ngm:asset-management,
        ngm:capital-markets,
        ngm:trade-finance ;
    vc:contrastsWith ngm:cryptocurrency,
        ngm:non-fungible-token ;
    vc:enables ngm:automated-market-maker,
        ngm:decentralised-finance,
        ngm:fractional-ownership,
        ngm:liquidity-provision ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:redemption-mechanism,
        ngm:token-issuance ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:digital-asset,
        ngm:security-token,
        ngm:security-token-offering,
        ngm:stablecoin ;
    vc:requires ngm:digital-identity,
        ngm:kyc-aml-compliance,
        ngm:oracle-network,
        ngm:smart-contract,
        ngm:special-purpose-vehicle ;
    vc:slug "real-world-asset-tokenisation" ;
    vc:sourceDomain "blockchain" ;
    vc:standardizedBy ngm:bis-innovation-hub,
        ngm:financial-stability-board,
        ngm:iosco ;
    vc:uses ngm:distributed-ledger-technology,
