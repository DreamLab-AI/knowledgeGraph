ngm:sustainable-development-goals a owl:Class ;
    rdfs:label "Sustainable Development Goals"@en ;
    rdfs:comment "The Sustainable Development Goals (SDGs) are a set of 17 interlinked global goals adopted by all United Nations member states in 2015 as part of the 2030 Agenda for Sustainable Development, spanning the elimination of poverty, zero hunger, quality education, gender equality, clean energy, decent work, reduced inequalities, climate action, and partnerships for implementation. Each goal is operationalised through targets and indicators that define measurable progress benchmarks, providing a shared framework for national governments, international organisations, civil society, and the private sector to align strategies and report progress. The SDGs extend and deepen the Millennium Development Goals, recognising that sustainable development requires integrated action across social, economic, and environmental dimensions simultaneously."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:environmental-sustainability ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:sustainability-reporting ],
        ngm:sustainable-development ;
    vc:enables ngm:carbon-accounting,
        ngm:esg-reporting ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:environmental-standards,
        ngm:esg-investing,
        ngm:global-inequality,
        ngm:societal-and-environmental-wellbeing ;
    vc:requires ngm:environmental-sustainability,
        ngm:sustainability-reporting ;
    vc:slug "sustainable-development-goals" ;
    vc:sourceDomain "governance" .

ngm:swarm-intelligence a owl:Class ;
    rdfs:label "Swarm Intelligence"@en ;
    rdfs:comment "Swarm intelligence is the collective behaviour that emerges from many simple agents following local rules and interactions, producing coordinated global behaviour without central control."@en ;
    rdfs:subClassOf ngm:autonomous-systems-domain ;
    vc:enables ngm:multi-robot-systems,
        ngm:swarm-robotics ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:slug "swarm-intelligence" ;
    vc:sourceDomain "robotics" .

ngm:symbol-grounding a owl:Class ;
    rdfs:label "Symbol Grounding"@en ;
    rdfs:comment "Symbol grounding is the problem and process of connecting abstract symbols manipulated by an intelligent system to their referents in the perceptual and physical world, so that the symbols carry intrinsic meaning rather than being defined only by other symbols. First articulated by Stevan Harnad, it asks how a system can avoid an infinite regress of definitions and acquire understanding tied to sensory experience. It is central to debates about whether language models truly understand the concepts they process."@en ;
    rdfs:subClassOf ngm:ai-research-area ;
    skos:broader ngm:ai-research-area ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:ai-grounded-domain,
        ngm:cognitive-ai ;
    vc:slug "symbol-grounding" ;
    vc:sourceDomain "ai" .

ngm:synchronisation a owl:Class ;
    rdfs:label "Synchronisation"@en ;
    rdfs:comment "Synchronisation is the coordination of multiple processes, devices, or data replicas so that they reach a consistent state or act in a precise temporal relationship. In computing it covers concurrency primitives like locks and barriers; in distributed and robotic systems it covers clock alignment and coordinated motion. Accurate synchronisation is essential wherever independent components must agree on order, timing, or shared state."@en ;
    rdfs:subClassOf ngm:distributed-systems ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:delta-robot,
        ngm:edge-computing ;
    vc:slug "synchronisation" ;
    vc:sourceDomain "infrastructure" .

ngm:system-software a owl:Class ;
    rdfs:label "System Software"@en ;
    rdfs:comment "Low-level software that directly manages hardware resources and provides foundational services upon which application software operates. In XR and spatial computing contexts, system software encompasses device drivers, operating system kernels, firmware, and hardware abstraction layers that expose display, tracking, and input peripherals to higher-level runtimes."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:operating-system ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:hardware-abstraction ],
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:enables ngm:rendering-pipeline,
        ngm:xr-runtime-environment ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:hardware-abstraction,
        ngm:operating-system ;
    vc:isPartOf ngm:technology-stack ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:slug "system-software" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:middleware .

ngm:tamper-detection a owl:Class ;
    rdfs:label "Tamper Detection"@en ;
    rdfs:comment "Tamper detection is the set of technical mechanisms and protocols that identify whether a digital asset, data record, physical device, or communication has been unauthorisedly modified since its creation or last verified state. In the digital domain it employs cryptographic hash functions, digital signatures, Merkle proofs, and content-addressed storage to generate verifiable commitments that reveal any change to the protected content. Applied to media authenticity, hardware integrity, and data provenance, tamper detection is a foundational component of trust architectures for critical systems, supply chains, digital forensics, and content authenticity verification."@en ;
    rdfs:subClassOf ngm:data-integrity ;
    vc:enables ngm:content-authentication,
        ngm:digital-forensics,
        ngm:provenance-verification ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:anomaly-detection,
        ngm:audit-trail ;
    vc:slug "tamper-detection" ;
    vc:sourceDomain "security" ;
    vc:uses ngm:cryptographic-hash-function,
        ngm:cryptographic-signature,
        ngm:digital-signature .

ngm:task-and-motion-planning a owl:Class ;
    rdfs:label "Task and Motion Planning"@en ;
    rdfs:comment "Task and motion planning is an approach in robotics that combines high-level task planning with low-level motion planning to produce executable plans. It addresses both what to do and how to move."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:planning ],
        ngm:motion-planning ;
    vc:enables ngm:robot-control ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:planning ;
    vc:slug "task-and-motion-planning" ;
    vc:sourceDomain "robotics" .

ngm:technical-expertise a owl:Class ;
    rdfs:label "Technical Expertise"@en ;
    rdfs:comment "Technical expertise is the specialised knowledge, skill, and practical judgement required to design, build, or operate within a complex technical domain. It is a prerequisite and a gating factor for advanced work, and its scarcity can both enable progress and act as a barrier to misuse. The level and distribution of expertise materially affects how quickly capabilities such as AI development or biotechnology proliferate."@en ;
    rdfs:subClassOf ngm:governance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:ai-development,
        ngm:bio-terror ;
    vc:slug "technical-expertise" ;
    vc:sourceDomain "governance" .

ngm:tele-001-telepresence a owl:Class ;
    rdfs:label "TELE 001 telepresence"@en ;
    rdfs:comment "TELE 001 Telepresence is a foundational concept within the telecollaboration domain that defines the sense of physical presence transmitted across a distance through audio-visual, haptic, and immersive communication technologies. It serves as the baseline specification for how distributed participants experience co-presence in collaborative environments, underpinning higher-order telecollaboration and virtual meeting systems."@en ;
    rdfs:subClassOf ngm:dc-telepresence ;
    skos:broader ngm:dc-telepresence ;
    vc:enables ngm:immersive-communication,
        ngm:virtual-collaboration ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:distributed-collaboration,
        ngm:telecollaboration ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:slug "tele-001-telepresence" ;
    vc:sourceDomain "distributed-collaboration" ;
    vc:uses ngm:audio-system,
        ngm:avatar .

ngm:tendermint-consensus a owl:Class ;
    rdfs:label "Tendermint Consensus"@en ;
    rdfs:comment "Tendermint Consensus is a Byzantine Fault Tolerant consensus engine that combines Practical Byzantine Fault Tolerance (PBFT) with Proof-of-Stake validator sets to achieve immediate block finality and high transaction throughput. It underpins the Cosmos ecosystem and enables inter-blockchain communication by guaranteeing that committed blocks are never reverted, eliminating the probabilistic finality of Proof-of-Work chains."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:proof-of-stake ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:validator-node ],
        ngm:bc-protocol-and-consensus,
        ngm:byzantine-fault-tolerance ;
    skos:broader ngm:bc-protocol-and-consensus ;
    vc:contrastsWith ngm:delegated-proof-of-stake,
        ngm:proof-of-work ;
    vc:enables ngm:blockchain-interoperability,
        ngm:cosmos-ibc ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:blockchain-protocol ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:blockchain-scalability,
        ngm:consensus-mechanism,
        ngm:low-energy-consumption ;
    vc:requires ngm:proof-of-stake,
        ngm:validator-node ;
    vc:slug "tendermint-consensus" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:cryptographic-hash,
        ngm:digital-signature .

ngm:term-definitions a owl:Class ;
    rdfs:label "Term Definitions"@en ;
    rdfs:comment "Term definitions are the authoritative, machine-readable descriptions that bind a label or identifier to its precise meaning within a controlled vocabulary, glossary, or ontology. Each definition fixes the intension of a term so that data producers and consumers interpret it consistently. They are the atomic content of glossaries and semantic registries and are essential for interoperability across systems."@en ;
    rdfs:subClassOf ngm:data-management ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:glossary-index,
        ngm:semantic-metadata-registry ;
    vc:slug "term-definitions" ;
    vc:sourceDomain "data" .

ngm:testing a owl:Class ;
    rdfs:label "Testing"@en ;
    rdfs:comment "Testing is the software-engineering practice of verifying that a system behaves as specified and detecting defects by executing it against defined inputs and checking the outputs. It spans levels from unit and integration to system and acceptance testing, and styles from manual to fully automated. Systematic testing is a primary mechanism for establishing software reliability and guarding against regressions."@en ;
    rdfs:subClassOf ngm:infra-software-engineering ;
    skos:broader ngm:infra-software-engineering ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:reliability,
        ngm:software-engineering-domain ;
    vc:slug "testing" ;
    vc:sourceDomain "infrastructure" .

ngm:text-embeddings a owl:Class ;
    rdfs:label "Text Embeddings"@en ;
    rdfs:comment "Text embeddings are dense numerical vector representations of words, sentences, or documents that place semantically similar text close together in a high-dimensional space. They are produced by neural models trained so that distance or cosine similarity in the vector space reflects meaning rather than surface form. Embeddings are the foundation of semantic search, clustering, and retrieval-augmented generation."@en ;
    rdfs:subClassOf ngm:natural-language-processing ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:retrieval-augmented-generation-rag,
        ngm:semantic-search ;
    vc:slug "text-embeddings" ;
    vc:sourceDomain "ai" .

ngm:threat-intelligence a owl:Class ;
    rdfs:label "Threat Intelligence"@en ;
    rdfs:comment "Threat intelligence is the collection, analysis and sharing of information about cyber threats to support detection, prevention and response."@en ;
    rdfs:subClassOf ngm:cybersecurity ;
    vc:enables ngm:network-security ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:slug "threat-intelligence" ;
    vc:sourceDomain "distributed-systems" .

ngm:timelock-contract a owl:Class ;
    rdfs:label "Timelock Contract"@en ;
    rdfs:comment "A smart contract or transaction condition that prevents funds or actions from being executed until a specified time or block height is reached. It is used to enforce delays and to coordinate conditional payments."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:smart-contract ],
        ngm:smart-contract ;
    vc:enables ngm:hash-time-locked-contract ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:smart-contract ;
    vc:slug "timelock-contract" ;
    vc:sourceDomain "blockchain" .

ngm:timer a owl:Class ;
    rdfs:label "Timer"@en ;
    rdfs:comment "A timer is a software or hardware mechanism that measures elapsed time or schedules an action to occur after a delay or at a recurring interval. In collaborative and real-time applications it provides shared countdowns, time-boxing, and synchronised triggers that all participants observe consistently. Timers are a basic building block of event scheduling, animation, and time-bounded interaction."@en ;
    rdfs:subClassOf ngm:dc-workspace-tools ;
    skos:broader ngm:dc-workspace-tools ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:collaborative-whiteboard,
        ngm:real-time ;
    vc:slug "timer" ;
    vc:sourceDomain "metaverse" .

ngm:timestamping-service a owl:Class ;
    rdfs:label "Timestamping Service"@en ;
    rdfs:comment "A timestamping service is a system that issues verifiable proof that a piece of data existed at or before a particular time, often using cryptographic methods."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:hash-function ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptography ],
        ngm:trusted-timestamping ;
    vc:enables ngm:content-provenance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:cryptography,
        ngm:hash-function ;
    vc:slug "timestamping-service" ;
    vc:sourceDomain "cryptography" .

ngm:token-metadata a owl:Class ;
    rdfs:label "Token Metadata"@en ;
    rdfs:comment "Token metadata is the structured descriptive data associated with a blockchain token, typically including attributes such as name, description, image references, traits, and provenance. For non-fungible tokens it is commonly stored as a JSON document referenced by a tokenURI and often hosted on decentralised storage such as IPFS to preserve immutability and addressability."@en ;
    rdfs:subClassOf ngm:bc-token-and-asset ;
    skos:broader ngm:bc-token-and-asset ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:nft-minting,
        ngm:non-fungible-token-nft ;
    vc:slug "token-metadata" ;
    vc:sourceDomain "blockchain" .

ngm:token-swapping a owl:Class ;
    rdfs:label "Token Swapping"@en ;
    rdfs:comment "Token swapping is the on-chain exchange of one cryptocurrency or digital token for another without an intermediary custodian, executed atomically within a single transaction through smart contracts. The mechanism is implemented via automated market makers (AMMs), which price assets algorithmically using constant-function market-making formulas against liquidity pools, or via atomic swap protocols using hash time-locked contracts (HTLCs) that enable trustless cross-chain exchanges. Token swapping is the primary interaction primitive of decentralised exchanges and a building block for complex DeFi strategies."@en ;
    rdfs:subClassOf ngm:decentralized-finance-de-fi ;
    vc:enables ngm:de-fi,
        ngm:yield-farming ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:decentralized-exchange-dex,
        ngm:permissionless-trading,
        ngm:uniswap ;
    vc:slug "token-swapping" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:atomic-swap,
        ngm:automated-market-maker,
        ngm:liquidity-pool,
        ngm:smart-contract .

ngm:tool-registry a owl:Class ;
    rdfs:label "Tool Registry"@en ;
    rdfs:comment "A tool registry is a catalogue that stores the definitions, schemas, permissions, and metadata of the external tools and functions an AI agent can invoke. It enables agents to discover, validate, and route calls to available capabilities at runtime, providing a governed and extensible interface between language models and the systems they act upon."@en ;
    rdfs:subClassOf ngm:ai-agent-system ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:agent-frameworks,
        ngm:agentic-internet ;
    vc:slug "tool-registry" ;
    vc:sourceDomain "ai" .

ngm:traceability a owl:Class ;
    rdfs:label "Traceability"@en ;
    rdfs:comment "Traceability is the ability to verify the history, location, or application of an item or piece of information by means of recorded identification. It requires that each unit or event be uniquely identified and that the linkages between successive states be persistently recorded, enabling both forward tracking from origin to destination and backward tracing from any point to its provenance. Traceability is foundational to supply-chain integrity, regulatory compliance, food and pharmaceutical safety, and software and data provenance, and it is increasingly underpinned by tamper-evident ledgers."@en ;
    rdfs:subClassOf ngm:process ;
    vc:enables ngm:compliance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.78"^^xsd:float ;
    vc:relatedTo ngm:provenance-tracking,
        ngm:supply-chain-traceability,
        ngm:traceability-mechanism ;
    vc:slug "traceability" ;
    vc:sourceDomain "supply-chain" .

ngm:traceability-mechanism a owl:Class ;
    rdfs:label "Traceability Mechanism"@en ;
    rdfs:comment "A Traceability Mechanism is a systematic approach for recording, maintaining, and retrieving comprehensive documentation of an AI system's development process, data lineage, decision-making logic, and operational history to enable accountability, auditability, and debugging. It encompasses data provenance tracking, model versioning, decision logging, and tamper-evident audit trails that allow stakeholders to reconstruct the causal chain from system outputs back to training data and design choices. Regulatory frameworks including the EU AI Act and GDPR increasingly mandate specific traceability capabilities for high-risk AI deployments."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-governance ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:audit-trail ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:data-provenance ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:model-training ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:metadata-management ],
        ngm:ai-governance-and-ethics,
        ngm:ai-governance-principle ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:enables ngm:accountability,
        ngm:compliance-verification,
        ngm:explainability ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:audit-trail,
        ngm:data-provenance,
        ngm:metadata-management ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:ai-regulation,
        ngm:gdpr-compliance,
        ngm:transparency ;
    vc:requires ngm:data-governance,
        ngm:model-training ;
    vc:slug "traceability-mechanism" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:ai-governance,
        ngm:ai-risk-management .

ngm:tracking-technology a owl:Class ;
    rdfs:label "Tracking Technology"@en ;
    rdfs:comment "Tracking Technology refers to the hardware and software systems that determine the real-time position, orientation, and motion of a user or device in physical space for extended reality applications. Approaches include inside-out tracking using onboard cameras and SLAM, outside-in tracking using fixed base stations, eye tracking for gaze-based interaction, and hand/finger tracking for controller-free input."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:slam ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:sensor-fusion ],
        ngm:infra-computing-and-cloud ;
    skos:broader ngm:infra-computing-and-cloud ;
    vc:enables ngm:eye-tracking,
        ngm:hand-tracking,
        ngm:motion-tracking ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:xr-hardware ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:sensor-fusion,
        ngm:slam ;
    vc:slug "tracking-technology" ;
    vc:sourceDomain "infrastructure" .

ngm:training-and-fine-tuning a owl:Class ;
    rdfs:label "Training and fine tuning"@en ;
    rdfs:comment "Fine-tuning is the post-pre-training adaptation of a large neural network — typically a transformer-based Foundation Models or Large Language Models — to narrower task distributions or behavioural objectives by continuing gradient-based optimisation on comparatively small, curated dataset..."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:reward-model ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
