ngm:machine-learning-discipline-platform a owl:Class ;
    rdfs:label "Machine Learning Platform"@en ;
    rdfs:comment "Comprehensive cloud-based or enterprise software systems that provide integrated tools for building, training, deploying, and managing machine learning models, including AutoML capabilities, model registries, and MLOps features."@en ;
    rdfs:subClassOf ngm:ai-infrastructure ;
    vc:bridgesTo ngm:cloud-computing ;
    vc:enables ngm:enterprise-ai-adoption ;
