ngm:system-architecture a owl:Class ;
    rdfs:label "System Architecture"@en ;
    rdfs:comment "System Architecture defines the holistic structure integrating hardware, software, data infrastructure, and operational components to deliver capabilities at scale, encompassing distributed training infrastructure, inference servers, data pipelines, model registries, monitoring systems, and edge-cloud coordination."@en ;
