ngm:concurrency a owl:Class ;
    rdfs:label "Concurrency"@en ;
    rdfs:comment "Concurrency is the composition of independently executing computations that make progress within overlapping time periods, whether or not they run simultaneously on separate processors. It is a way of structuring a program so that multiple tasks can be in flight at once, coordinating access to shared state through synchronisation primitives. Concurrency is distinct from parallelism: it concerns the dealing with many things at once, while parallelism concerns the doing of many things at once."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:operating-system ],
        ngm:infrastructure ;
    skos:broader ngm:infrastructure ;
    vc:contrastsWith ngm:parallel-computing ;
    vc:dependsOn ngm:multithreading ;
    vc:enables ngm:real-time-analytics ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:actor-model,
        ngm:flow-control,
        ngm:parallel-processing ;
    vc:requires ngm:operating-system ;
    vc:slug "concurrency" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:high-throughput-computing,
        ngm:parallel-computing ;
    vc:uses ngm:asynchronous-programming,
        ngm:event-loop,
        ngm:message-passing,
        ngm:multithreading .

ngm:corporate-governance a owl:Class ;
    rdfs:label "Corporate Governance"@en ;
    rdfs:comment "The system of rules, practices and processes by which a company is directed and controlled, balancing the interests of shareholders, management and other stakeholders, including board oversight, executive accountability, disclosure obligations, and mechanisms that align the interests of management, shareholders, and wider society."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
