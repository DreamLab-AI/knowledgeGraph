ngm:pick-and-place a owl:Class ;
    rdfs:label "Pick and Place"@en ;
    rdfs:comment "Pick and place is a canonical robotic manipulation task in which a manipulator grasps an object at a source location and deposits it at a target location. It chains perception to localise the object, motion planning to reach and grasp it, and controlled placement, often repeated at high speed in structured settings. It is the foundational operation of industrial automation in assembly, packaging, and sorting."@en ;
    rdfs:subClassOf ngm:manipulation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:cylindrical-robot,
        ngm:position-control ;
    vc:slug "pick-and-place" ;
    vc:sourceDomain "robotics" .

ngm:plant-model a owl:Class ;
    rdfs:label "Plant Model"@en ;
    rdfs:comment "A plant model is a mathematical representation of the dynamic system being controlled, mapping control inputs and disturbances to the system's state and outputs over time. Usually expressed as differential equations, transfer functions, or state-space form, it captures how the plant responds so a controller can be designed and tuned against it. Accurate plant models are central to control theory and to model-based control synthesis and simulation."@en ;
    rdfs:subClassOf ngm:control-theory ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:control-algorithm ;
    vc:slug "plant-model" ;
    vc:sourceDomain "robotics" .

ngm:platform-accountability a owl:Class ;
    rdfs:label "Platform Accountability"@en ;
    rdfs:comment "Platform accountability is the principle and regulatory expectation that online platforms bear responsibility for the systems, content, and harms arising on their services. It encompasses obligations such as transparency reporting, risk assessment, content-moderation due process, and remedies for illegal or harmful material. Frameworks like the Digital Services Act codify these duties, shifting platforms from passive intermediaries toward governed actors."@en ;
    rdfs:subClassOf ngm:infra-legal-and-regulatory ;
    skos:broader ngm:infra-legal-and-regulatory ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:death-of-the-internet,
        ngm:digital-services-act ;
    vc:slug "platform-accountability" ;
    vc:sourceDomain "governance" .

ngm:policy-optimisation a owl:Class ;
    rdfs:label "Policy Optimisation"@en ;
    rdfs:comment "Policy optimisation is the process of searching over a parameterised space of decision-making policies to maximise a scalar objective, typically a cumulative reward signal in a reinforcement learning context. It encompasses both gradient-based methods such as proximal policy optimisation and gradient-free approaches such as evolutionary strategies, applied across discrete and continuous action spaces."@en ;
    rdfs:subClassOf ngm:optimisation ;
    vc:enables ngm:deep-reinforcement-learning,
        ngm:reinforcement-learning-for-robotics ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:proximal-policy-optimisation ;
    vc:slug "policy-optimisation" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:reinforcement-learning-algorithm,
        ngm:reward-function,
        ngm:value-function .

ngm:precision-agriculture a owl:Class ;
    rdfs:label "Precision Agriculture"@en ;
    rdfs:comment "Precision agriculture is a farming-management approach that uses sensing, geolocation, and data analytics to observe and respond to variability within fields at fine spatial resolution. It applies inputs such as water, fertiliser, and pesticide only where and when needed, improving yield and reducing waste. It integrates IoT sensors, satellite and drone imagery, and increasingly autonomous ground robots."@en ;
    rdfs:subClassOf ngm:ai-application ;
    skos:broader ngm:ai-application ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:ground-robot,
        ngm:io-t-sensor-network ;
    vc:slug "precision-agriculture" ;
    vc:sourceDomain "robotics" .

ngm:precision-manufacturing a owl:Class ;
    rdfs:label "Precision Manufacturing"@en ;
    rdfs:comment "Precision manufacturing is a set of industrial processes and quality systems that produce mechanical components and assemblies within extremely tight dimensional tolerances — typically sub-micrometre to nanometre scale — using advanced machining, metrology, and process control techniques. It encompasses CNC machining, ultra-precision grinding, electrical discharge machining (EDM), and micro-fabrication, combined with in-process measurement and statistical process control to ensure conformance to specification. Precision manufacturing is fundamental to the production of optical systems, semiconductor equipment, aerospace components, medical implants, and scientific instruments where dimensional accuracy directly determines system performance."@en ;
    rdfs:subClassOf ngm:manufacturing-automation ;
    vc:enables ngm:digital-twin,
        ngm:industrial-robot ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:digital-fabrication,
        ngm:display-metrology,
        ngm:industrial-automation,
        ngm:quality-assurance ;
    vc:slug "precision-manufacturing" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:industrial-inspection,
        ngm:smart-manufacturing .

ngm:prediction-markets a owl:Class ;
    rdfs:label "Prediction Markets"@en ;
    rdfs:comment "Prediction markets are exchanges where participants trade contracts whose payoff depends on the outcome of future events, so the market price reflects an aggregated probability estimate."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:order-book ],
        ngm:economics ;
    vc:enables ngm:de-fi ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:order-book ;
    vc:slug "prediction-markets" ;
    vc:sourceDomain "metaverse" .

ngm:predictive-personalization a owl:Class ;
    rdfs:label "Predictive Personalization"@en ;
    rdfs:comment "The use of machine learning models to anticipate individual user preferences and dynamically tailor content, recommendations, interfaces, and experiences before an explicit request is made. Systems combine behavioural analytics, user profiling, and predictive models to deliver contextually relevant personalisation at scale."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-governance ],
        ngm:ai-application ;
    skos:broader ngm:ai-application ;
    vc:enables ngm:user-experience ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:natural-language-processing,
        ngm:predictive-analytics,
        ngm:recommendation-engine,
        ngm:user-experience ;
    vc:requires ngm:data-governance ;
    vc:slug "predictive-personalization" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:behavioral-analytics,
        ngm:machine-learning-discipline,
        ngm:machine-learning-discipline-model .

ngm:prefix-tuning a owl:Class ;
    rdfs:label "Prefix Tuning"@en ;
    rdfs:comment "A parameter-efficient fine-tuning technique that prepends trainable continuous vectors (prefixes) to the key and value matrices at each transformer layer, whilst keeping the pre-trained model parameters frozen. Unlike prompt tuning, which operates only on input embeddings, prefix tuning influences the attention mechanism at every layer, achieving stronger task-specific adaptation with roughly 0.1% of model parameters."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:fine-tuning ],
        ngm:parameter-efficient-fine-tuning ;
    vc:contrastsWith ngm:adapter-modules,
        ngm:prompt-tuning ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:parameter-efficient-fine-tuning ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires ngm:fine-tuning ;
    vc:slug "prefix-tuning" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:attention-mechanism,
        ngm:transfer-learning .

ngm:preimage-resistance a owl:Class ;
    rdfs:label "Preimage Resistance"@en ;
    rdfs:comment "Preimage Resistance is a security property of a cryptographic hash function requiring that, given a hash output h, it is computationally infeasible to find any input m such that H(m) = h. This one-way property is foundational for password hashing, proof-of-work puzzles, and blockchain address derivation, ensuring that knowledge of a public address does not reveal the corresponding private key."@en ;
    rdfs:subClassOf ngm:bc-cryptographic-primitive,
        ngm:blockchain-entity,
        ngm:cryptographic-primitive ;
    skos:broader ngm:bc-cryptographic-primitive ;
    vc:enables ngm:cryptographic-security,
        ngm:merkle-proof ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:cryptographic-hash-function,
        ngm:hash-function ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:blake2,
        ngm:collision-resistance,
        ngm:keccak-256,
        ngm:private-key,
        ngm:proof-of-work,
        ngm:sha-256 ;
    vc:slug "preimage-resistance" ;
    vc:sourceDomain "blockchain" .

ngm:pressure-sensor a owl:Class ;
    rdfs:label "Pressure Sensor"@en ;
    rdfs:comment "Pressure Sensor is a robotics and autonomous systems concept and a type of robotics."@en ;
    rdfs:subClassOf ngm:robo-perception ;
