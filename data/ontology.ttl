    vc:slug "stacks" ;
    vc:sourceDomain "blockchain" .

ngm:standardization a skos:Concept ;
    rdfs:label "Standardization"@en .

ngm:standardized-formats a owl:Class ;
    rdfs:label "Standardized Formats"@en ;
    rdfs:comment "Standardized formats are openly specified, consistently structured file and data encodings, such as glTF for 3D assets, USD for scene description, or VRM for avatars, that allow content to be created in one tool and faithfully consumed in another. By fixing geometry, material, animation, and metadata conventions, they decouple content from any single application or platform. They are the precondition for portability, archival longevity, and interoperability across the metaverse content pipeline."@en ;
    rdfs:subClassOf ngm:sc-standards-and-interop ;
    skos:broader ngm:sc-standards-and-interop ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:asset-archive,
        ngm:avatar-portability ;
    vc:slug "standardized-formats" ;
    vc:sourceDomain "metaverse" .

ngm:state-change a owl:Class ;
    rdfs:label "State Change"@en ;
    rdfs:comment "A State Change is the transition from one defined configuration or status to another within a system, component, or entity, representing how systems evolve through discrete or continuous modifications to their properties. State changes are fundamental to distributed systems, blockchain ledgers (where account balances and smart-contract storage are updated atomically), digital twins (where physical sensor readings update virtual representations), and agentic AI systems (where goal statuses transition through planning and execution). Formal modelling of state changes enables audit trails, causality analysis, and consistency guarantees."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:state-synchronization ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:state-machine ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:state-machine-replication ],
        ngm:artificial-intelligence ;
    skos:broader ngm:artificial-intelligence ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:state-machine,
        ngm:state-machine-replication,
        ngm:state-synchronization ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:consensus-mechanism,
        ngm:digital-twin,
        ngm:distributed-systems,
        ngm:smart-contract,
        ngm:state-estimation ;
    vc:slug "state-change" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:event,
        ngm:event-driven-architecture,
        ngm:transaction .

ngm:stateless-protocol a owl:Class ;
    rdfs:label "Stateless Protocol"@en ;
    rdfs:comment "A stateless protocol is a communication protocol in which each request from a client to a server is treated independently, carrying all the information needed to be understood without relying on stored context from previous requests. The server retains no session state between requests, which simplifies server design and improves scalability and resilience because any server instance can handle any request. HTTP is the canonical example; where continuity is needed, state is reintroduced at a higher layer through tokens, cookies or explicit session management."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:client-server-architecture ],
        ngm:protocol ;
    vc:bridgesTo ngm:load-balancer ;
    vc:contrastsWith ngm:session-management ;
    vc:dependsOn ngm:session-management ;
    vc:enables ngm:fault-tolerance,
        ngm:load-balancer ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:rest ;
    vc:isPartOf ngm:protocol ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:http,
        ngm:idempotency,
        ngm:rest ;
    vc:requires ngm:client-server-architecture ;
    vc:slug "stateless-protocol" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:idempotency,
        ngm:reliability ;
    vc:uses ngm:http .

ngm:statistical-mechanics a skos:Concept ;
    rdfs:label "Statistical Mechanics"@en .

ngm:stdio-transport a owl:Class ;
    rdfs:label "Stdio Transport"@en ;
    rdfs:comment "Stdio transport is a communication mechanism in which a client and server exchange messages over the standard input and standard output streams of a locally spawned process. It is one of the primary transports defined by the Model Context Protocol, where the host launches the server as a subprocess and frames JSON-RPC messages through stdin/stdout. It suits local, single-machine integrations because it requires no network sockets and inherits the operating system's process isolation."@en ;
    rdfs:subClassOf ngm:communication-protocol ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:model-context-protocol,
        ngm:model-control-protocols-like-mcp ;
    vc:slug "stdio-transport" ;
    vc:sourceDomain "infrastructure" .

ngm:sticky-notes a owl:Class ;
    rdfs:label "Sticky Notes"@en ;
    rdfs:comment "Sticky Notes are digital equivalents of physical adhesive notes used on virtual whiteboards or collaboration surfaces to capture brief ideas, action items, or annotations. Multiple participants can add, move, and colour-code notes simultaneously, making them a lightweight tool for brainstorming and retrospectives in remote teams. They are widely supported in tools such as Miro, FigJam, and Microsoft Whiteboard."@en ;
    rdfs:subClassOf ngm:dc-workspace-tools ;
    skos:broader ngm:dc-workspace-tools ;
    vc:enables ngm:retrospective ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:collaborative-systems-modality-whiteboard ;
    vc:slug "sticky-notes" ;
    vc:sourceDomain "distributed-collaboration" .

ngm:stratum-protocol a owl:Class ;
    rdfs:label "Stratum Protocol"@en ;
    rdfs:comment "The Stratum Protocol is a lightweight, JSON-based line protocol used to coordinate work between cryptocurrency mining pools and individual miners. The pool server distributes block templates and difficulty targets to connected mining clients, which return valid share submissions, allowing aggregated hashing power to be measured and rewarded. Stratum reduces bandwidth and latency compared with earlier polling schemes and remains the dominant pool communication standard for proof-of-work coins."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:mining-pool ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:proof-of-work ],
        ngm:mining-pool ;
    vc:bridgesTo ngm:bandwidth ;
    vc:dependsOn ngm:latency,
        ngm:network-protocol ;
    vc:enables ngm:mining-hardware ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:blockchain ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:cryptocurrency,
        ngm:mining-hardware,
        ngm:proof-of-work ;
    vc:requires ngm:mining-pool,
        ngm:proof-of-work ;
    vc:slug "stratum-protocol" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:mining-pool ;
    vc:uses ngm:network-protocol,
        ngm:websocket .

ngm:strict-types a owl:Class ;
    rdfs:label "Strict Types"@en ;
    rdfs:comment "Strict types is a type system and schema language used by the RGB protocol to define data structures with a fully deterministic memory layout and a content-addressable type identity. Each type has a unique hash derived from its definition, so schemas can be referenced and verified without ambiguity. It provides the typed foundation that strict encoding serialises during client-side validation."@en ;
    rdfs:subClassOf ngm:programming-language ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:rgb-and-client-side-validation,
        ngm:strict-encoding ;
    vc:slug "strict-types" ;
    vc:sourceDomain "blockchain" .

ngm:strips a owl:Class ;
    rdfs:label "STRIPS"@en ;
    rdfs:comment "STRIPS (Stanford Research Institute Problem Solver) is a classical automated planning formalism that represents world states as conjunctions of propositions and defines actions via precondition, add-list, and delete-list operators. It introduced the core abstraction underlying modern planning languages such as PDDL and remains foundational to symbolic AI planning."@en ;
    rdfs:subClassOf ngm:ai-technique,
        ngm:knowledge-representation ;
    skos:broader ngm:ai-technique ;
    vc:bridgesTo ngm:path-planning ;
    vc:enables ngm:automated-planning ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:reinforcement-learning ;
    vc:slug "strips" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:knowledge-representation .

ngm:subsurface-scattering a owl:Class ;
    rdfs:label "Subsurface Scattering"@en ;
    rdfs:comment "Subsurface scattering is a light-transport phenomenon in which light penetrates the surface of a translucent material, scatters within it, and exits at a different point, producing the soft, diffuse glow characteristic of skin, wax, marble, and milk. In computer graphics it is modelled as part of global illumination to render such materials realistically, since a purely surface-level reflectance model cannot capture the way light bleeds beneath and through them. Approaches range from physically based diffusion and path-traced volumetric scattering to fast screen-space and pre-integrated approximations used in real-time rendering. It is essential to photorealistic depiction of organic and semi-transparent matter."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:shader ],
        ngm:global-illumination ;
    vc:dependsOn ngm:global-illumination ;
    vc:enables ngm:physically-based-rendering,
        ngm:real-time-rendering ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:shader ;
    vc:implements ngm:physically-based-rendering ;
    vc:isPartOf ngm:global-illumination ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:brdf,
        ngm:physically-based-rendering,
        ngm:ray-tracing,
        ngm:rendering-pipeline,
        ngm:texture-mapping ;
    vc:slug "subsurface-scattering" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:rendering-pipeline ;
    vc:uses ngm:ray-tracing,
        ngm:shader .

ngm:surgical-navigation a owl:Class ;
    rdfs:label "Surgical Navigation"@en ;
    rdfs:comment "Surgical Navigation is the intraoperative technology and methodology that provides surgeons with real-time spatial guidance by registering preoperative imaging data (CT, MRI) with the patient's anatomy and continuously tracking the position of surgical instruments relative to that registered model. It is analogous to GPS navigation but for the operating room, enabling submillimetre accuracy in procedures where anatomical landmarks are obscured, such as orthopaedic, neurosurgery, and spinal operations."@en ;
    rdfs:subClassOf ngm:navigation-system ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:augmented-reality,
        ngm:haptic-feedback,
        ngm:surgical-robot,
        ngm:surgical-robotics ;
    vc:slug "surgical-navigation" ;
    vc:sourceDomain "robotics" ;
    vc:supports ngm:healthcare-ai,
        ngm:precision-medicine ;
    vc:uses ngm:medical-imaging,
        ngm:pose-estimation,
        ngm:sensor-fusion,
        ngm:tracking-system .

ngm:system-software a owl:Class ;
    rdfs:label "System Software"@en ;
    rdfs:comment "Low-level software that directly manages hardware resources and provides foundational services upon which application software operates. In XR and spatial computing contexts, system software encompasses device drivers, operating system kernels, firmware, and hardware abstraction layers that expose display, tracking, and input peripherals to higher-level runtimes."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:operating-system ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:hardware-abstraction ],
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:enables ngm:rendering-pipeline,
        ngm:xr-runtime-environment ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:hardware-abstraction,
        ngm:operating-system ;
    vc:isPartOf ngm:technology-stack ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:slug "system-software" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:middleware .

ngm:task-delegation a owl:Class ;
    rdfs:label "Task Delegation"@en ;
    rdfs:comment "Task Delegation is the mechanism by which an agent assigns a sub-task to another agent or tool deemed more capable, available or specialised for that work. In multi-agent and agentic systems it underpins division of labour, allowing a coordinating agent to decompose a goal and route components to subordinate executors. Effective delegation requires shared task representation, capability awareness and result aggregation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:agent-communication-language ],
        ngm:multi-agent-system ;
    vc:bridgesTo ngm:workflow-orchestration ;
    vc:contrastsWith ngm:autonomous-agent ;
    vc:dependsOn ngm:autonomous-agent ;
    vc:enables ngm:multi-agent-coordination,
        ngm:workflow-orchestration ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:multi-agent-system ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:multi-agent-coordination,
        ngm:task-allocation ;
    vc:requires ngm:agent-communication-language ;
    vc:slug "task-delegation" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:decision-making ;
    vc:uses ngm:inter-agent-communication .

ngm:technical-expertise a owl:Class ;
    rdfs:label "Technical Expertise"@en ;
    rdfs:comment "Technical expertise is the specialised knowledge, skill, and practical judgement required to design, build, or operate within a complex technical domain. It is a prerequisite and a gating factor for advanced work, and its scarcity can both enable progress and act as a barrier to misuse. The level and distribution of expertise materially affects how quickly capabilities such as AI development or biotechnology proliferate."@en ;
    rdfs:subClassOf ngm:governance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:ai-development,
        ngm:bio-terror ;
    vc:slug "technical-expertise" ;
    vc:sourceDomain "governance" .

ngm:technology-ecosystem a owl:Class ;
    rdfs:label "Technology Ecosystem"@en ;
    rdfs:comment "A Technology Ecosystem is the interconnected network of platforms, developer tools, standards bodies, runtime environments, and community participants that collectively sustain a technology domain. In the metaverse context it encompasses rendering engines, spatial-computing SDKs, open standards (OpenXR, USD, WebXR), cloud infrastructure, hardware manufacturers, and application developers whose interdependencies determine adoption trajectories and competitive dynamics."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
