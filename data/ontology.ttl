ngm:cross-chain-interoperability a owl:Class ;
    rdfs:label "Cross-Chain Interoperability"@en ;
    rdfs:comment "Cross-Chain Interoperability refers to the technical capacity for distinct blockchain networks to communicate, transfer assets, and share state without relying on a centralised intermediary. It encompasses atomic swaps, cross-chain messaging protocols, relay chains, bridge smart contracts, and inter-blockchain communication standards such as Cosmos IBC and Polkadot's XCMP. Achieving trustless interoperability requires solving the heterogeneous consensus problem—two chains with different finality guarantees must reach agreement on the validity of a cross-chain event—which is a non-trivial distributed systems challenge. The field is critical to the vision of a composable multi-chain ecosystem in which assets and logic can flow freely across sovereign networks."@en ;
    rdfs:subClassOf ngm:blockchain-interoperability ;
    vc:enables ngm:cross-chain-governance,
        ngm:decentralised-finance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:atomic-swap,
        ngm:cosmos-ibc,
        ngm:cross-chain-bridge,
        ngm:polkadot ;
    vc:slug "cross-chain-interoperability" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:cross-chain-messaging,
        ngm:interoperability-protocol .

ngm:cryptographic-commitment a owl:Class ;
    rdfs:label "Cryptographic Commitment"@en ;
    rdfs:comment "A cryptographic scheme that allows a party to commit to a chosen value while keeping it hidden, with the ability to reveal it later, satisfying the binding property (cannot change the committed value) and the hiding property (the commitment reveals no information about the value). Used in zero-knowledge proofs, atomic swaps, and confidential transactions."@en ;
    rdfs:subClassOf ngm:bc-cryptographic-primitive,
        ngm:blockchain-entity,
        ngm:cryptographic-primitive ;
    skos:broader ngm:bc-cryptographic-primitive ;
    vc:enables ngm:cryptographic-protocol,
        ngm:immutability,
        ngm:zk-snarks,
        ngm:zk-starks ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:digital-signature,
        ngm:merkle-tree,
        ngm:schnorr-signature,
        ngm:zero-knowledge ;
    vc:slug "cryptographic-commitment" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:cryptographic-hash-function,
        ngm:hash-function,
        ngm:zero-knowledge-proof .

ngm:data-provenance a owl:Class ;
    rdfs:label "Data Provenance"@en ;
    rdfs:comment "A continuous process of recording and tracking the origin, lineage, and transformation history of data objects, enabling traceability, validation of data quality, and verification of authenticity throughout the data lifecycle."@en ;
