ngm:statistics a owl:Class ;
    rdfs:label "Statistics"@en ;
    rdfs:comment "The discipline concerned with collecting, analysing, interpreting, and drawing conclusions from data under uncertainty, encompassing both frequentist and Bayesian frameworks for inference, estimation, and hypothesis testing."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:probability-theory ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:linear-algebra ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:bayesian-inference ],
        ngm:probability-theory ;
    vc:bridgesTo ngm:financial-modelling,
        ngm:information-theory,
        ngm:signal-processing ;
    vc:contrastsWith ngm:deterministic-modelling ;
    vc:dependsOn ngm:data-collection,
        ngm:sampling-theory ;
    vc:enables ngm:data-analysis,
        ngm:experimental-design,
        ngm:machine-learning,
        ngm:statistical-learning-theory ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:bayesian-inference,
        ngm:descriptive-statistics,
        ngm:estimation-theory,
        ngm:hypothesis-testing,
        ngm:regression-analysis ;
    vc:implements ngm:frequentist-inference,
        ngm:maximum-likelihood-estimation ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:data-science,
        ngm:stochastic-processes ;
    vc:requires ngm:calculus,
        ngm:linear-algebra,
        ngm:probability-theory ;
    vc:slug "statistics" ;
    vc:sourceDomain "data" ;
    vc:supports ngm:causal-inference,
        ngm:empirical-science ;
    vc:uses ngm:confidence-intervals,
        ngm:p-values .

ngm:synthetic-data-generation a owl:Class ;
    rdfs:label "Synthetic Data Generation"@en ;
    rdfs:comment "Synthetic Data Generation is the process of algorithmically producing artificial datasets that statistically mirror real-world distributions without exposing sensitive personal information. Techniques include generative adversarial networks, diffusion models, physics simulation, and rule-based sampling, enabling model training where real data is scarce, private, or costly to label."@en ;
    rdfs:subClassOf ngm:data-engineering ;
    vc:bridgesTo ngm:digital-twin,
        ngm:privacy-law ;
    vc:contrastsWith ngm:data-annotation,
        ngm:real-world-data-collection ;
    vc:dependsOn ngm:compute-cluster,
        ngm:machine-learning-infrastructure ;
    vc:enables ngm:data-augmentation,
        ngm:embodied-ai-simulation,
        ngm:federated-learning,
        ngm:model-training,
        ngm:privacy-preserving-data-sharing ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
