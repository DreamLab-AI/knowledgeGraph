ngm:mlperf a owl:Class ;
    rdfs:label "Mlperf"@en ;
    rdfs:comment "MLPerf is a suite of standardised benchmarks, governed by the MLCommons consortium, that measures the performance of machine learning hardware, software and systems for both training and inference. It defines fixed reference models, datasets, quality targets and submission rules so that results from different vendors are reproducible and directly comparable. MLPerf has become an industry reference for evaluating accelerators, frameworks and end-to-end systems on representative deep learning workloads."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:training ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:inference ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:reproducibility ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:model-training ],
        ngm:performance-benchmarks ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:inference,
        ngm:training ;
    vc:implements ngm:benchmark-standard,
        ngm:benchmarks ;
    vc:isPartOf ngm:performance-benchmarks ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:artificial-intelligence,
        ngm:latency,
        ngm:neural-network,
        ngm:throughput ;
