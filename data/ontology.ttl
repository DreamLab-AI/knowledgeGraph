        ngm:virtual-team ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:asynchronous-collaboration,
        ngm:presence-mechanism,
        ngm:shared-workspace,
        ngm:synchronous-collaboration ;
    vc:qualityScore "0.72"^^xsd:float ;
