ngm:risk-management-domain a owl:Class ;
    rdfs:label "Risk Management Domain"@en ;
    rdfs:comment "The Risk Management Domain classifies concepts concerned with identifying, assessing, and controlling exposure to adverse events across financial, operational, and technical systems. It covers risk taxonomies, measurement methods, controls, and governance frameworks. As a top-level subject classification, it scopes the systematic treatment of uncertainty and loss rather than the specific domains in which risks arise."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:risk-assessment ],
