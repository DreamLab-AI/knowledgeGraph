    vc:sourceDomain "ai" .
ngm:tool-call-loop a owl:Class ;
    rdfs:comment "The core execution cycle of an LLM agent, in which the model emits a structured tool invocation, the harness executes it against the real environment (shell, file system, API, browser), appends the result to the conversation, and re-invokes the model — repeating until the model judges the task complete and returns a final answer; this iterate-observe-act loop is what turns single-turn text generation into grounded, autonomous task execution."@en ;
    rdfs:label "Tool Call Loop"@en ;
    rdfs:subClassOf ngm:agent-loop ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:agentic-workflow ;
