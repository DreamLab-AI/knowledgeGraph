    vc:slug "fig-jam" ;
    vc:sourceDomain "metaverse" .

ngm:fin-cen a owl:Class ;
    rdfs:label "FinCEN"@en ;
    rdfs:comment "The Financial Crimes Enforcement Network (FinCEN) is a bureau of the US Department of the Treasury established in 1990 that serves as the primary US financial intelligence unit (FIU). FinCEN administers the Bank Secrecy Act (BSA), collects financial transaction reports from financial institutions (SARs, CTRs), analyses this data for patterns of money laundering, terrorist financing, and financial fraud, and shares intelligence with law enforcement and foreign FIUs through the Egmont Group. FinCEN also issues regulatory guidance and rulemaking for digital asset service providers including money service businesses (MSBs) and, since 2019, cryptocurrency exchanges."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:suspicious-activity-report ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:beneficial-ownership-disclosure ],
        ngm:regulatory-framework ;
    vc:bridgesTo ngm:bc-0456-virtual-asset-service-providers,
        ngm:blockchain-compliance,
        ngm:travel-rule ;
    vc:dependsOn ngm:bank-secrecy-act,
        ngm:usa-patriot-act ;
    vc:enables ngm:aml-kyc-compliance,
        ngm:anti-money-laundering,
        ngm:counter-terrorist-financing,
        ngm:sanctions-enforcement ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:currency-transaction-report,
        ngm:suspicious-activity-report ;
    vc:implements ngm:financial-action-task-force ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:financial-regulation,
        ngm:sanctions-screening,
        ngm:us-regulatory-framework ;
    vc:requires ngm:beneficial-ownership-disclosure,
        ngm:customer-identification-programme ;
    vc:slug "fin-cen" ;
    vc:sourceDomain "finance" ;
    vc:supports ngm:corporate-transparency-act ;
    vc:uses ngm:compliance-audit-trail,
        ngm:compliance-framework,
        ngm:financial-intelligence .

ngm:financial-modelling a owl:Class ;
    rdfs:label "Financial Modelling"@en ;
    rdfs:comment "Financial modelling is the practice of constructing abstract, quantitative representations of an organisation's financial performance, typically as interlinked spreadsheets or programmatic models that project future cash flows, valuations and outcomes under varying assumptions. Models combine historical data, accounting logic and forward-looking drivers to support decision-making, investment analysis and risk assessment. Common forms include three-statement models, discounted cash-flow valuations and scenario-based projections."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data ],
        ngm:quantitative-finance ;
    vc:bridgesTo ngm:finance,
        ngm:quantitative-finance ;
    vc:dependsOn ngm:statistics ;
    vc:enables ngm:scenario-analysis ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:monte-carlo-simulation,
        ngm:risk-management,
        ngm:statistics ;
    vc:requires ngm:data ;
