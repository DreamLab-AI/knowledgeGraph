ngm:labelled-dataset a owl:Class ;
    rdfs:label "Labelled Dataset"@en ;
    rdfs:comment "A labelled dataset is a collection of data examples each paired with one or more target annotations that specify the correct output for a learning task. The labels constitute the supervisory signal that allows a model to learn the mapping from inputs to outputs during training. Label quality, coverage and balance strongly determine the performance and fairness of the resulting model."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:data-annotation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-annotation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-preprocessing ],
        ngm:training-data ;
    vc:dependsOn ngm:data-quality ;
    vc:enables ngm:model-training,
        ngm:supervised-learning ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:data-annotation ;
    vc:isPartOf ngm:training-data ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:feature-engineering,
        ngm:support-vector-machine ;
    vc:requires ngm:data-annotation,
        ngm:data-preprocessing ;
    vc:slug "labelled-dataset" ;
    vc:sourceDomain "machine-learning" ;
    vc:supports ngm:classification,
        ngm:model-evaluation ;
    vc:uses ngm:machine-learning .

ngm:light-node a owl:Class ;
    rdfs:label "Light Node"@en ;
    rdfs:comment "A Light Node is a blockchain network participant that downloads and verifies only block headers rather than the full transaction history, using Simplified Payment Verification (SPV) to confirm transaction inclusion via Merkle proofs. This design allows resource-constrained devices—mobile wallets, IoT devices, embedded clients—to interact securely with a blockchain without the storage and bandwidth demands of a Full Node, relying on connected full nodes to supply the underlying transaction data when required."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptographic-hash-function ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:peer-to-peer-network ],
        ngm:blockchain-entity ;
    vc:contrastsWith ngm:archival-node,
        ngm:full-node ;
    vc:enables ngm:digital-wallet ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:blockchain-infrastructure ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:blockchain-protocol,
        ngm:bootstrap-node,
        ngm:validator-node ;
    vc:requires ngm:cryptographic-hash-function,
        ngm:peer-to-peer-network ;
    vc:slug "light-node" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:blockchain-network,
        ngm:cryptographic-protocol .

ngm:locomotion a owl:Class ;
    rdfs:label "Locomotion"@en ;
    rdfs:comment "Locomotion is the capability of a robot or embodied agent to move its body through an environment by coordinating actuators against ground or fluid reaction forces. It encompasses gait generation, balance control, and trajectory execution across modalities such as legged walking, wheeled rolling, and aerial or aquatic propulsion. Robust locomotion is fundamental to autonomous mobility and physical task execution."@en ;
    rdfs:subClassOf ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:control-system,
        ngm:mobile-robot ;
    vc:slug "locomotion" ;
    vc:sourceDomain "robotics" .

ngm:logic-programming a owl:Class ;
    rdfs:label "Logic Programming"@en ;
    rdfs:comment "Logic Programming is a programming paradigm in which computation is expressed as logical inference over a set of facts and rules written in formal logic. Programs describe what is true rather than how to compute, and an inference engine derives answers by applying resolution and unification. Prolog is the canonical language; descendant systems include Datalog, Answer Set Programming, and constraint logic programming."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:knowledge-representation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:reasoning ],
        ngm:ai-technique,
        ngm:programming-paradigm ;
    skos:broader ngm:ai-technique ;
    vc:enables ngm:expert-systems,
        ngm:formal-verification,
        ngm:knowledge-graph ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:artificial-intelligence,
        ngm:knowledge-base,
        ngm:natural-language-processing,
        ngm:semantic-web-linked-data-standard,
        ngm:software-engineering,
        ngm:symbolic-ai ;
    vc:requires ngm:knowledge-representation,
        ngm:reasoning ;
    vc:slug "logic-programming" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:database-query .

ngm:measure-theory a owl:Class ;
    rdfs:label "Measure Theory"@en ;
    rdfs:comment "Measure Theory is the branch of mathematical analysis that studies measures, which assign a consistent notion of size, length, area, volume or probability to subsets of a space. It provides the rigorous foundation for the Lebesgue integral, which generalises the Riemann integral and handles a wider class of functions and limiting operations. It is the formal basis of modern probability theory, where a probability is a measure of total mass one."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:topology ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:sigma-algebra ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:real-analysis ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:set-theory ],
        ngm:ai-research-area ;
    skos:broader ngm:ai-research-area ;
    vc:bridgesTo ngm:functional-analysis,
        ngm:quantitative-finance,
        ngm:quantum-mechanics ;
    vc:dependsOn ngm:set-theory ;
    vc:enables ngm:ergodic-theory,
        ngm:information-theory,
        ngm:probability-theory,
        ngm:statistical-learning-theory,
        ngm:stochastic-processes ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:sigma-algebra ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:fourier-analysis ;
    vc:requires ngm:real-analysis,
        ngm:set-theory,
        ngm:topology ;
    vc:slug "measure-theory" ;
    vc:sourceDomain "machine-learning" ;
    vc:supports ngm:bayesian-inference,
        ngm:monte-carlo-methods ;
    vc:uses ngm:convergence .

ngm:monetary-policy-implementation a owl:Class ;
    rdfs:label "Monetary Policy Implementation"@en ;
    rdfs:comment "Monetary Policy Implementation encompasses the operational processes, tools, and institutional mechanisms through which central banks and monetary authorities translate policy decisions—such as interest rate targets or quantitative measures—into observable effects on the financial system. In digital and metaverse economic contexts it extends to the programmatic enforcement of monetary parameters via Central Bank Digital Currencies (CBDCs), smart contracts, and programmable money frameworks. Effective implementation requires coordination between inflation control targets, payment system design, financial stability oversight, and regulatory compliance."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:open-market-operations ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:reserve-requirements ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:central-bank ],
        ngm:economic-mechanism ;
    vc:bridgesTo ngm:distributed-ledger-technology,
        ngm:sc-governance-and-safety,
        ngm:smart-contract ;
    vc:contrastsWith ngm:decentralised-finance,
        ngm:fiscal-policy ;
    vc:enables ngm:central-bank-digital-currency-cbdc,
        ngm:financial-stability,
        ngm:liquidity-management,
        ngm:programmable-money ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:forward-guidance,
        ngm:open-market-operations,
        ngm:reserve-requirements ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:economic-governance,
        ngm:financial-regulation,
        ngm:inflation-control,
        ngm:interest-rate-policy,
        ngm:monetary-sovereignty,
        ngm:quantitative-easing ;
    vc:requires ngm:central-bank,
        ngm:interbank-market ;
    vc:slug "monetary-policy-implementation" ;
    vc:sourceDomain "finance" ;
    vc:supports ngm:economic-growth,
        ngm:price-stability ;
    vc:uses ngm:cbdc-frameworks,
        ngm:payment-system,
        ngm:real-time-gross-settlement,
        ngm:stablecoin .

ngm:multisig-wallet a owl:Class ;
    rdfs:label "Multisig Wallet"@en ;
    rdfs:comment "A multisig wallet is a cryptocurrency wallet that requires multiple independent signatures to authorise a transaction, typically following an M-of-N threshold scheme where M of N designated keys must sign. By distributing signing authority across keys held by different people or devices, it removes single points of failure and enforces shared control. It is widely used for treasury management, custody and decentralised-organisation governance."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:key-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:digital-signature ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:key-management ],
        ngm:cryptocurrency-wallet ;
    vc:bridgesTo ngm:bitcoin ;
    vc:contrastsWith ngm:hot-wallet ;
    vc:dependsOn ngm:cryptocurrency-wallet ;
    vc:enables ngm:self-custody,
        ngm:treasury-management ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:digital-signature,
        ngm:key-management ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:custody,
        ngm:ethereum,
        ngm:on-chain-governance ;
    vc:requires ngm:key-management ;
    vc:slug "multisig-wallet" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:custody,
        ngm:dao ;
    vc:uses ngm:digital-signature,
        ngm:smart-contract,
        ngm:threshold-cryptography .

ngm:networking-infrastructure a owl:Class ;
    rdfs:label "Networking Infrastructure"@en ;
    rdfs:comment "Networking infrastructure comprises the integrated ensemble of physical hardware, logical protocols, and software-defined systems—including routers, switches, fibre optic links, wireless access points, content delivery networks (CDNs), edge nodes, load balancers, and DNS services—that collectively enable communication between computing systems across local, metropolitan, and wide-area scales. It forms the foundational substrate upon which distributed applications, cloud services, and real-time collaborative platforms depend, governing end-to-end latency, throughput, reliability, and security. Modern networking infrastructure increasingly incorporates software-defined networking (SDN), network function virtualisation (NFV), and programmable data planes that decouple control logic from physical forwarding hardware. For latency-sensitive domains such as spatial computing, extended reality, and distributed AI inference, infrastructure design must additionally satisfy stringent quality-of-service guarantees through traffic engineering, edge offloading, and geographically distributed state synchronisation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:load-balancer ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:edge-computing ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:network-function-virtualization ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:content-delivery-network ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:software-defined-networking ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:quality-of-service ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:domain-name-system ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:network-security ],
        ngm:infra-network-and-comms ;
    skos:broader ngm:infra-network-and-comms ;
    vc:bridgesTo ngm:decentralised-network,
        ngm:inference-infrastructure ;
    vc:contrastsWith ngm:compute-infrastructure,
        ngm:storage-infrastructure ;
    vc:dependsOn ngm:bandwidth-adaptation,
        ngm:latency,
        ngm:network-protocol,
        ngm:optical-fibre ;
    vc:enables ngm:cloud-computing,
        ngm:distributed-systems,
        ngm:federated-learning,
        ngm:metaverse-infrastructure,
        ngm:realtime-communication ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:content-delivery-network,
        ngm:domain-name-system,
        ngm:edge-computing,
        ngm:load-balancer,
        ngm:network-function-virtualization,
        ngm:software-defined-networking ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:5-g-network,
        ngm:network-topology ;
    vc:requires ngm:network-security,
        ngm:quality-of-service ;
    vc:slug "networking-infrastructure" ;
    vc:sourceDomain "infrastructure" ;
    vc:standardizedBy ngm:3-gpp,
        ngm:ieee-802-x,
        ngm:ietf ;
    vc:supports ngm:autonomous-system,
        ngm:internet-of-things,
        ngm:spatial-computing .

ngm:nostr a owl:Class ;
    rdfs:label "Nostr"@en ;
    rdfs:comment "Nostr (Notes and Other Stuff Transmitted by Relays) is an open, censorship-resistant social-messaging protocol in which user identity is a secp256k1 cryptographic key pair and all user activity consists of signed JSON events published to one or more relay servers over WebSocket connections. The protocol has no central authority: identity is purely the public key, relays are interchangeable infrastructure that store and forward events without requiring account registration, and clients subscribe using filter objects to receive matching events. Nostr Improvement Proposals (NIPs) extend the core event-kind system to cover short-form notes, long-form articles, encrypted direct messages, Lightning Network zap payments, community moderation, and decentralised identity verification. Its radical simplicity, cryptographic self-sovereignty, and tight integration with the Bitcoin and Lightning ecosystem have made Nostr the dominant open social layer for value-aligned decentralised communication."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:nostr-relay ],
        ngm:infra-network-and-comms ;
    skos:broader ngm:infra-network-and-comms ;
    vc:bridgesTo ngm:block-trails,
        ngm:decentralised-ai,
        ngm:did-nostr,
        ngm:inter-agent-communication,
        ngm:javascript-solid-server,
        ngm:web-contracts ;
    vc:contrastsWith ngm:activity-pub,
        ngm:federated-social-networks,
        ngm:matrix-protocol ;
    vc:dependsOn ngm:bitcoin,
        ngm:lightning-network ;
    vc:enables ngm:censorship-resistance,
        ngm:decentralised-identity,
        ngm:decentralised-web,
        ngm:micropayment,
        ngm:social-network-graph ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:nostr-event,
        ngm:nostr-relay ;
    vc:implements ngm:open-protocol,
        ngm:self-sovereign-identity ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:did-nostr-identity,
        ngm:peer-to-peer-network ;
    vc:slug "nostr" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:json-data-interchange-format,
        ngm:public-key-cryptography,
        ngm:schnorr-signature,
        ngm:secp256k1,
        ngm:web-socket .

ngm:occupancy-grid a owl:Class ;
    rdfs:label "Occupancy Grid"@en ;
    rdfs:comment "An occupancy grid is a probabilistic spatial representation of a robot's environment as a discretised lattice of cells, each storing a probability or log-odds value indicating the likelihood that the corresponding region of space is occupied by an obstacle. It provides a metric map suitable for collision avoidance, path planning, and SLAM by fusing noisy sensor measurements through Bayesian updates."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:rb-0075-range-finder ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:pose-estimation ],
        ngm:environment-mapping ;
    vc:contrastsWith ngm:feature-map,
        ngm:topological-map ;
    vc:enables ngm:autonomous-navigation,
        ngm:collision-avoidance,
        ngm:motion-planning,
        ngm:path-planning ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:isPartOf ngm:metric-map ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:costmap,
        ngm:point-cloud,
        ngm:slam,
        ngm:voxel-grid ;
    vc:requires ngm:pose-estimation,
        ngm:rb-0075-range-finder ;
    vc:slug "occupancy-grid" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:bayesian-inference,
        ngm:lidar-sensor,
        ngm:sensor-fusion .

ngm:on-device-inference a owl:Class ;
    rdfs:label "On-Device Inference"@en ;
    rdfs:comment "On-device inference is the execution of machine learning model forward passes entirely on the end-user's hardware — such as a smartphone, wearable, embedded controller, or edge server — without transmitting input data to a remote cloud backend. It requires models to be compressed, quantised, or distilled to fit within tight memory, compute, and power budgets while maintaining acceptable accuracy."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:model-compression-for-edge ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:hardware-acceleration ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:post-training-quantisation ],
        ngm:edge-inference ;
    vc:bridgesTo ngm:augmented-reality,
        ngm:autonomous-vehicle,
        ngm:federated-learning ;
    vc:contrastsWith ngm:cloud-inference ;
    vc:dependsOn ngm:knowledge-distillation-for-edge,
        ngm:npu ;
    vc:enables ngm:offline-ai,
        ngm:privacy-preserving-ai,
        ngm:real-time-inference ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:mlir,
        ngm:onnx ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:speculative-decoding,
        ngm:tiny-ml ;
    vc:requires ngm:hardware-acceleration,
        ngm:model-compression-for-edge,
        ngm:post-training-quantisation ;
    vc:slug "on-device-inference" ;
    vc:sourceDomain "machine-learning" ;
    vc:uses ngm:onnx-runtime,
        ngm:tensor-flow-lite .

ngm:onnx-runtime a owl:Class ;
    rdfs:label "ONNX Runtime"@en ;
    rdfs:comment "ONNX Runtime is an open-source, cross-platform inference and training acceleration engine developed by Microsoft that executes models represented in the Open Neural Network Exchange (ONNX) format. It applies a multi-pass graph optimisation pipeline—including operator fusion, constant folding, and common subexpression elimination—before routing computation through hardware-specific execution providers such as CUDA, TensorRT, DirectML, OpenVINO, CoreML, and QNN to maximise throughput and minimise latency. The runtime decouples training-time framework choice from deployment-time execution environment, allowing models trained in PyTorch, TensorFlow, or scikit-learn to be deployed with a single, vendor-neutral API. In 2024–2025 it extended into large language model inference via the onnxruntime-genai extensions, adding KV-cache management and autoregressive decoding primitives."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:onnx ],
        ngm:inference-engine ;
    vc:contrastsWith ngm:openvino,
        ngm:tensor-rt ;
    vc:dependsOn ngm:cuda ;
    vc:enables ngm:edge-inference,
        ngm:model-deployment,
        ngm:real-time-inference ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:onnx-operator-set,
        ngm:onnx-standard ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:mlops,
        ngm:model-optimisation-and-performance ;
    vc:requires ngm:onnx ;
    vc:slug "onnx-runtime" ;
    vc:sourceDomain "ai" ;
    vc:standardizedBy ngm:onnx ;
    vc:supports ngm:python-pytorch-deep-learning-stack,
        ngm:scikit-learn,
        ngm:tensor-flow,
        ngm:transformers ;
    vc:uses ngm:graph-optimisation,
        ngm:kv-cache,
        ngm:neural-network-quantisation,
        ngm:operator-fusion .

ngm:open-id-foundation a owl:Class ;
    rdfs:label "OpenID Foundation"@en ;
    rdfs:comment "The OpenID Foundation (OIDF) is an international, member-driven, non-profit standards organisation that stewards the OpenID family of identity specifications, including OpenID Connect, FAPI (Financial-grade API), MODRNA, and Digital Credentials. It coordinates working groups composed of identity providers, relying parties, and government bodies to develop, test interoperability of, and maintain open specifications for federated authentication and authorisation. The Foundation operates certification programmes to verify implementation conformance to published profiles, reducing interoperability barriers across global digital identity ecosystems. Founded in 2007, the OIDF operates under a royalty-free intellectual property policy, ensuring open access to its specifications without patent encumbrance."@en ;
    rdfs:subClassOf ngm:standards-body ;
    vc:bridgesTo ngm:digital-wallet,
        ngm:e-idas ;
    vc:contrastsWith ngm:saml,
        ngm:w3-c-did ;
    vc:enables ngm:federated-identity,
        ngm:open-banking,
        ngm:single-sign-on,
        ngm:standards-conformance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:digital-credentials-working-group,
        ngm:fapi-working-group,
        ngm:modrna-working-group,
        ngm:openid-connect-working-group ;
    vc:implements ngm:json-data-interchange-format-web-token,
        ngm:oauth-2-0 ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:authentication-standards,
        ngm:decentralised-identity,
        ngm:identity-federation,
        ngm:self-sovereign-identity ;
    vc:slug "open-id-foundation" ;
    vc:sourceDomain "security" ;
    vc:supports ngm:digital-identity-standards,
        ngm:financial-grade-api,
        ngm:open-id-connect,
        ngm:verifiable-credentials .

ngm:open-science a owl:Class ;
    rdfs:label "Open Science"@en ;
    rdfs:comment "Open science is a movement and set of practices aimed at making scientific research, data and dissemination accessible, transparent and reproducible for all members of society. It encompasses open access to publications, open data, open-source tools and open methodologies, lowering barriers to participation and verification of research. By promoting sharing throughout the research lifecycle, open science seeks to accelerate discovery, improve reproducibility and broaden public trust in science."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-sharing ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:metadata ],
        ngm:governance ;
    vc:bridgesTo ngm:digital-commons,
        ngm:open-source ;
    vc:enables ngm:reproducibility,
        ngm:transparency ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:scientific-method ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:open-data,
        ngm:reproducibility,
        ngm:transparency ;
    vc:requires ngm:data-sharing,
        ngm:metadata ;
    vc:slug "open-science" ;
    vc:sourceDomain "governance" ;
    vc:supports ngm:collaboration,
        ngm:knowledge-sharing,
        ngm:open-access,
        ngm:peer-review ;
    vc:uses ngm:open-data,
        ngm:open-source-software .

ngm:open-source-development a owl:Class ;
    rdfs:label "Open Source Development"@en ;
    rdfs:comment "Open source development is a software production methodology in which source code is made publicly available under licences permitting inspection, modification, and redistribution, enabling distributed communities of contributors to collaboratively build and maintain software. The model contrasts with proprietary development by prioritising transparency, peer review, and meritocratic contribution over closed, hierarchical ownership. It encompasses practices including version-controlled public repositories, issue tracking, pull-request-based code review, and community governance structures. Open source development has become the dominant paradigm for infrastructure software, AI frameworks, and blockchain protocols."@en ;
