    vc:slug "reward-function" ;
    vc:sourceDomain "machine-learning" ;
    vc:supports ngm:inverse-reinforcement-learning,
        ngm:multi-objective-optimisation,
        ngm:reward-shaping ;
    vc:uses ngm:temporal-difference-learning,
        ngm:value-function .

ngm:robo-human-robot-interaction a owl:Class,
        skos:Concept ;
    rdfs:label "Human-Robot Interaction"@en ;
    rdfs:comment "Taxonomy hub covering the methods, interfaces, and social dynamics through which humans and robots communicate, cooperate, and coordinate. This category spans teleoperation, haptic feedback, social robotics, speech and gesture interfaces, and safety considerations for shared human-robot workspaces."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:social-robotics ],
        [ a owl:Restriction ;
