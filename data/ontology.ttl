    vc:sourceDomain "artificial-intelligence" .

ngm:artificial-superintelligence a owl:Class ;
    rdfs:label "artificial superintelligence"@en ;
    rdfs:comment "A hypothetical form of artificial intelligence that surpasses human cognitive performance across all domains, capable of recursive self-improvement leading to an intelligence explosion. Distinguished from artificial general intelligence by the degree of capability surplus; considered an existential risk scenario requiring robust safety and alignment research before any attempt at development."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:machine-learning ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:artificial-general-intelligence ],
        ngm:infra-computing-and-cloud ;
    skos:broader ngm:infra-computing-and-cloud ;
    vc:contrastsWith ngm:artificial-intelligence ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:ai-risks,
        ngm:ai-safety,
        ngm:singularity ;
    vc:requires ngm:artificial-general-intelligence,
        ngm:machine-learning ;
    vc:slug "artificial-superintelligence" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:aiethics .

ngm:asynchronous-execution a owl:Class ;
    rdfs:label "Asynchronous Execution"@en ;
    rdfs:comment "An execution model in which operations are initiated without blocking the calling thread; completion is signalled via callbacks, promises, futures, or events, enabling high-throughput concurrent processing particularly suited to I/O-bound workloads and distributed system communication."@en ;
    rdfs:subClassOf ngm:ai-infrastructure,
        ngm:execution-model ;
    vc:enables ngm:microservices-architecture,
        ngm:parallel-processing ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:slug "asynchronous-execution" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:ai-agent-system,
        ngm:edge-computing ;
    vc:uses ngm:asynchronous-communication,
        ngm:event-driven-architecture .

ngm:attention-aware-interaction a owl:Class ;
    rdfs:label "Attention Aware Interaction"@en ;
    rdfs:comment "Attention Aware Interaction refers to human-computer interaction techniques that leverage eye tracking, gaze detection, and attention modeling to understand user focus and adapt interfaces accordingly, enabling foveated rendering, gaze-based selection, and contextual content presentation in VR, A..."@en ;
    rdfs:subClassOf ngm:ai-application,
        ngm:human-computer-interaction ;
    skos:broader ngm:ai-application ;
    vc:enables ngm:adaptive-interfaces,
        ngm:foveated-rendering,
        ngm:gaze-based-selection ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:attention-modeling,
        ngm:eye-tracking-hardware,
        ngm:gaze-detection-algorithms ;
    vc:slug "attention-aware-interaction" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:autonomous-ai-agents a owl:Class ;
    rdfs:label "Autonomous AI Agents"@en ;
    rdfs:comment "Autonomous AI Agents are intelligent software systems capable of independently perceiving their environment, reasoning over goals, planning multi-step action sequences, and executing tasks without continuous human intervention, typically powered by large language models or reinforcement learning. They differ from simpler AI tools by their ability to set sub-goals, call external tools, manage memory, and adapt dynamically to novel situations. Autonomous agents are increasingly deployed in enterprise workflows, research automation, customer service, and multi-agent collaborative systems."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ai-safety ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:reasoning ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:planning-and-scheduling ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:explainability ],
        ngm:ai-agent-system,
        ngm:ai-application ;
    skos:broader ngm:ai-application ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:planning-and-scheduling,
        ngm:reasoning ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:agentic-ai,
        ngm:autonomous-agent,
        ngm:autonomous-robot,
        ngm:multi-agent-systems ;
    vc:requires ngm:ai-safety,
        ngm:explainability ;
    vc:slug "autonomous-ai-agents" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:large-language-models,
        ngm:reinforcement-learning,
        ngm:workflow-automation .

ngm:avatar-creation a owl:Class ;
    rdfs:label "Avatar Creation"@en ;
    rdfs:comment "Avatar Creation is the process of designing and generating 3D digital representations of users for metaverse environments, encompassing selfie-based AI generation, manual customization tools, full-body scanning, and procedural generation techniques that enable personalized virtual identities."@en ;
    rdfs:subClassOf ngm:digital-identity-creation,
        ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:enables ngm:digital-persona-management,
        ngm:metaverse-participation,
        ngm:virtual-self-expression ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:3-d-modeling-tools,
        ngm:ai-generation-systems,
        ngm:customization-interfaces ;
    vc:slug "avatar-creation" ;
    vc:sourceDomain "spatial-computing" .

ngm:avatar-wearable a owl:Class ;
    rdfs:label "Avatar Wearable"@en ;
    rdfs:comment "Digital clothing, accessories, and cosmetic items that can be equipped by avatars in virtual environments, often tokenised as NFTs to enable ownership, cross-platform portability, and secondary-market trading within metaverse economies."@en ;
    rdfs:subClassOf ngm:digital-asset,
        ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:enables ngm:virtual-economy-infrastructure ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:avatar-system,
        ngm:virtual-economy ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:avatar,
        ngm:avatar-customization,
        ngm:avatar-interoperability,
        ngm:nft,
        ngm:nft-standard ;
    vc:slug "avatar-wearable" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:3-d-asset,
        ngm:digital-asset-management .

ngm:bagging a owl:Class ;
    rdfs:label "Bagging"@en ;
    rdfs:comment "Bagging is a artificial intelligence concept and a type of Ensemble Mods. that enables Parallel Training."@en ;
    rdfs:subClassOf ngm:ai-technique,
        ngm:ensemble-methods ;
    skos:broader ngm:ai-technique ;
    vc:enables ngm:parallel-training ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:slug "bagging" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:barter-system a owl:Class ;
    rdfs:label "Barter System"@en ;
    rdfs:comment "A decentralized exchange mechanism enabling peer-to-peer trading of goods, services, or digital assets without monetary intermediaries, enhanced in digital contexts through blockchain-based matching algorithms and smart contracts that solve the traditional \"double coincidence of wants\" problem."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:smart-contracts ],
        ngm:ai-governance-and-ethics,
        ngm:exchange-mechanism ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:enables ngm:asset-exchange,
        ngm:peer-to-peer-trading,
        ngm:virtual-economy ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:matching-algorithm,
        ngm:smart-contracts,
        ngm:trust-mechanism ;
    vc:slug "barter-system" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:basel-committee-on-banking-supervision a owl:Class ;
    rdfs:label "Basel Committee on Banking Supervision"@en ;
    rdfs:comment "The Basel Committee on Banking Supervision (BCBS) is the primary global standard-setter for the prudential regulation of banks, operating under the auspices of the Bank for International Settlements in Basel, Switzerland. It develops minimum capital, liquidity, and leverage requirements — collectively the Basel Accords (Basel I, II, III, and the finalised Basel III framework completed in 2017) — that are adopted into national law by its 45-member jurisdictions. The Committee does not possess formal supranational authority; compliance is achieved through voluntary adoption by member central banks and supervisory agencies."@en ;
    rdfs:subClassOf ngm:regulatory-authority ;
    vc:enables ngm:regulatory-compliance,
        ngm:regulatory-framework ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:central-bank,
        ngm:financial-regulation,
        ngm:regulatory-standards,
        ngm:risk-management,
        ngm:systemic-risk ;
    vc:slug "basel-committee-on-banking-supervision" ;
    vc:sourceDomain "finance" ;
    vc:standardizedBy ngm:regulatory-technology .

ngm:biometric-binding-mechanism a owl:Class ;
    rdfs:label "Biometric Binding Mechanism"@en ;
    rdfs:comment "Physical hardware device that captures and verifies biometric traits (fingerprints, iris patterns, facial geometry) to bind digital identities to authenticated users."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:power-supply ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:optical-sensor-array ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:infrared-illuminator ],
        ngm:sc-governance-and-safety ;
    skos:broader ngm:sc-governance-and-safety ;
    vc:enables ngm:access-control,
        ngm:identity-verification,
        ngm:multi-factor-authentication,
        ngm:non-repudiation ;
    vc:hasMaturity ngmi:maturity-established ;
