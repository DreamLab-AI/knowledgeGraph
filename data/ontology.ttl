        ngm:optimisation .

ngm:meeting-ai-assistant a owl:Class ;
    rdfs:label "Meeting AI Assistant"@en ;
    rdfs:comment "An AI-powered software agent that attends synchronous and asynchronous Virtual Meetings either as an autonomous bot participant or as capability embedded within a Meeting Platform, providing continuous Automated Transcription via large-vocabulary Automatic Speech Recognition (ASR)..."@en ;
