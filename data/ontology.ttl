    vc:slug "spectrum-management" ;
    vc:sourceDomain "infrastructure" ;
    vc:standardizedBy ngm:ofcom ;
    vc:supports ngm:infrastructure,
        ngm:io-t .

ngm:stealth-address a owl:Class ;
    rdfs:label "Stealth Address"@en ;
    rdfs:comment "A stealth address is a privacy-enhancing technique that lets a recipient publish a single static address while every payment is sent to a unique, unlinkable one-time address derived on-chain. The sender combines the recipient's public scan and spend keys with ephemeral randomness, using elliptic-curve Diffie-Hellman to compute a destination only the recipient can detect and spend. Stealth addresses break the public linkage between a recipient's identity and their incoming transactions without requiring interaction or a shared secret beforehand."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:elliptic-curve-cryptography ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:public-key-cryptography ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:key-exchange ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptography ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:wallet ],
        ngm:privacy-preserving-blockchain ;
    vc:bridgesTo ngm:wallet ;
    vc:contrastsWith ngm:ring-signature,
        ngm:zero-knowledge-proof ;
    vc:enables ngm:anonymity,
        ngm:privacy,
        ngm:unlinkability ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:key-exchange,
        ngm:public-key-cryptography ;
    vc:isPartOf ngm:privacy-preserving-blockchain ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:monero,
        ngm:privacy-preserving-blockchain,
        ngm:unlinkability ;
    vc:requires ngm:cryptography,
        ngm:elliptic-curve-cryptography,
        ngm:wallet ;
    vc:slug "stealth-address" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:anonymity,
        ngm:privacy ;
    vc:uses ngm:elliptic-curve-cryptography,
        ngm:key-exchange,
        ngm:public-key-cryptography .

ngm:stepper-motor a owl:Class ;
    rdfs:label "Stepper Motor"@en ;
    rdfs:comment "A stepper motor is an electromechanical actuator that divides a full rotation into a fixed number of discrete angular steps, enabling precise open-loop position control without requiring feedback sensors. By energising coils in sequence, the rotor advances one step per pulse, making stepper motors essential for applications demanding repeatable positioning such as CNC machining, 3D printing, and robotic joints."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:embedded-systems ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:open-loop-control ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:encoder ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:motion-control ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:rotary-encoder ],
        ngm:electric-motor,
        ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:contrastsWith ngm:dc-servo-motor,
        ngm:servo-motor ;
    vc:enables ngm:robotics-control,
        ngm:robotics-process ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:encoder,
        ngm:rotary-encoder ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:robot-actuator,
        ngm:robotics ;
    vc:requires ngm:embedded-systems,
        ngm:motion-control,
        ngm:open-loop-control ;
    vc:slug "stepper-motor" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:actuator,
        ngm:electric-actuator .

ngm:strong-consistency a owl:Class ;
    rdfs:label "Strong Consistency"@en ;
    rdfs:comment "Strong consistency is a property of a distributed data system in which every read returns the result of the most recently completed write, so that all clients observe a single, up-to-date view of the data. It typically corresponds to linearizability, where operations appear to take effect instantaneously at some point between their invocation and response. Achieving strong consistency requires coordination such as consensus and, under the CAP theorem, trades availability for consistency during network partitions."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:quorum ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:consensus ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:consensus-algorithm ],
        ngm:distributed-systems ;
    vc:bridgesTo ngm:distributed-systems ;
    vc:contrastsWith ngm:eventual-consistency ;
    vc:dependsOn ngm:total-order-broadcast ;
    vc:enables ngm:linearizability,
        ngm:state-machine-replication ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:cap-theorem,
        ngm:replication ;
    vc:requires ngm:consensus,
        ngm:consensus-algorithm,
        ngm:quorum ;
    vc:slug "strong-consistency" ;
    vc:sourceDomain "distributed-systems" ;
    vc:uses ngm:paxos,
        ngm:raft .

ngm:structured-data a owl:Class ;
    rdfs:label "Structured Data"@en ;
    rdfs:comment "Structured data is information organised according to a predefined schema or model so that its meaning and relationships are explicit and machine-readable. By conforming to fixed fields, types, and constraints, it can be reliably queried, validated, exchanged, and reasoned over, in contrast to unstructured text or media. On the web it commonly takes the form of annotations such as Schema.org markup that let machines interpret page content."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:metadata ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-format ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:schema-org ],
        ngm:data-model ;
    vc:bridgesTo ngm:graph-database ;
    vc:contrastsWith ngm:rdf-xml ;
    vc:enables ngm:data-validation,
        ngm:interoperability,
        ngm:search-engine ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:metadata,
        ngm:schema-org ;
    vc:implements ngm:data-model ;
    vc:isPartOf ngm:data-model ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:ontology,
        ngm:rdf,
        ngm:semantic-web ;
    vc:requires ngm:data-format ;
    vc:slug "structured-data" ;
    vc:sourceDomain "data" ;
    vc:supports ngm:knowledge-graph,
        ngm:linked-data ;
    vc:uses ngm:data-format,
        ngm:metadata,
        ngm:schema-org .

ngm:superintelligence a owl:Class ;
    rdfs:label "Superintelligence"@en ;
    rdfs:comment "Superintelligence refers to a hypothetical form of artificial intelligence that surpasses the cognitive performance of any human across virtually all domains of interest, including scientific reasoning, social manipulation, and strategic planning. Nick Bostrom distinguishes speed superintelligence (same algorithms, faster hardware), collective superintelligence (many coordinated AI agents), and quality superintelligence (genuinely superior algorithms), each presenting distinct safety and control challenges."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ai-alignment ],
        ngm:artificial-superintelligence-theory ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.85"^^xsd:float ;
    vc:relatedTo ngm:agi-timelines ;
    vc:requires ngm:ai-alignment ;
    vc:slug "superintelligence" ;
    vc:sourceDomain "ai" .

ngm:supply-cap a owl:Class ;
    rdfs:label "Supply Cap"@en ;
    rdfs:comment "A Supply Cap is a hard-coded or governance-determined upper bound on the total number of tokens or coins that will ever be issued by a blockchain protocol, creating a form of programmatic scarcity that underpins deflationary monetary policy. Bitcoin's 21 million coin cap is the canonical example, encoded in the protocol's halvening schedule and providing a predictable issuance curve. Supply caps differentiate blockchain-native assets from fiat currencies and influence long-run security models, since block rewards approach zero as the cap is neared and transaction fees must compensate."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:consensus-algorithm ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:block-reward ],
        ngm:bc-defi-and-economics,
        ngm:blockchain-entity,
        ngm:economic-mechanism ;
    skos:broader ngm:bc-defi-and-economics ;
    vc:contrastsWith ngm:fee-market ;
    vc:dependsOn ngm:blockchain-protocol ;
    vc:enables ngm:bitcoin-proof-of-work-protocol-standard,
        ngm:bitcoin-proof-of-work-protocol-value-proposition ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:circulating-supply,
        ngm:cryptocurrency,
        ngm:token-economics,
        ngm:tokenomics ;
    vc:requires ngm:block-reward,
        ngm:consensus-algorithm ;
    vc:slug "supply-cap" ;
    vc:sourceDomain "blockchain" .

ngm:supply-chain-optimisation a owl:Class ;
    rdfs:label "Supply Chain Optimisation"@en ;
    rdfs:comment "Supply chain optimisation is the application of analytical and machine-learning techniques to plan and operate the flow of goods, information, and funds across sourcing, production, inventory, and distribution so as to minimise cost and risk while meeting service targets. It combines demand forecasting, inventory and network design, and routing decisions, often formulated as mathematical programmes or learned policies. AI-driven approaches increasingly use predictive analytics and digital twins to make these decisions adaptive to real-time conditions."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:demand-forecasting ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:operations-research ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:inventory-management ],
        ngm:supply-chain-management ;
    vc:bridgesTo ngm:digital-twin ;
    vc:dependsOn ngm:demand-forecasting ;
    vc:enables ngm:inventory-management ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:demand-forecasting,
        ngm:inventory-management ;
    vc:implements ngm:operations-research ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:logistics,
        ngm:supply-chain,
        ngm:warehouse-automation ;
    vc:requires ngm:operations-research ;
    vc:slug "supply-chain-optimisation" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:logistics ;
    vc:uses ngm:linear-programming,
        ngm:predictive-analytics,
        ngm:reinforcement-learning .

ngm:synchronization-protocol a owl:Class ;
    rdfs:label "Synchronization Protocol"@en ;
    rdfs:comment "A synchronization protocol is a set of rules by which distributed parties bring their state, clocks, or data into agreement despite operating independently and communicating over unreliable channels. It encompasses clock-synchronisation protocols (NTP, PTP) that align time across machines, and data-synchronisation protocols that reconcile divergent replicas using version vectors, operational transforms, or conflict-free replicated data types. Synchronization protocols are foundational to distributed databases, collaborative editing, mobile offline-first applications, and any system where multiple nodes must converge on a consistent view."@en ;
    rdfs:subClassOf ngm:network-protocol ;
    vc:enables ngm:fault-tolerance,
        ngm:replication ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:distributed-systems ;
    vc:slug "synchronization-protocol" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:clock-synchronization .

ngm:synchronous-communication a owl:Class ;
    rdfs:label "Synchronous Communication"@en ;
    rdfs:comment "Synchronous communication is an interaction pattern in which participants exchange messages in real time, with sender and receiver engaged simultaneously and responses expected without significant delay. In collaboration it covers video conferencing, live chat and voice calls; in distributed systems it covers blocking request-response exchanges where a caller waits for a reply. It favours immediacy and tight coordination at the cost of requiring co-presence and tolerance to latency."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:instant-messaging ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:video-conferencing ],
        ngm:real-time-communication ;
    vc:contrastsWith ngm:asynchronous-communication ;
    vc:dependsOn ngm:latency,
        ngm:presence ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:instant-messaging,
        ngm:video-conferencing ;
    vc:implements ngm:remote-procedure-call,
        ngm:web-rtc ;
    vc:isPartOf ngm:collaboration,
        ngm:real-time-communication ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:collaboration,
        ngm:remote-collaboration,
        ngm:web-rtc ;
    vc:slug "synchronous-communication" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:remote-collaboration,
        ngm:telepresence ;
    vc:uses ngm:communication-protocol,
        ngm:message-passing .

ngm:system-interoperability a owl:Class ;
    rdfs:label "System Interoperability"@en ;
    rdfs:comment "System interoperability is the ability of different information technology systems, applications, and devices to exchange data, interpret shared information, and use it in a mutually useful way without requiring special translation or middleware. It enables diverse systems to communicate and work together seamlessly through adherence to common standards, protocols, and data formats, facilitating efficient information flow across organisational and technical boundaries."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:api-gateway ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:interoperability ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:semantic-interoperability ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:message-broker ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-transformation ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:syntactic-interoperability ],
        ngm:infra-network-and-comms ;
    skos:broader ngm:infra-network-and-comms ;
    vc:bridgesTo ngm:artificial-intelligence,
        ngm:blockchain,
        ngm:sc-standards-and-interop,
        ngm:spatial-computing ;
    vc:contrastsWith ngm:proprietary-protocol,
        ngm:vendor-lock-in ;
    vc:enables ngm:data-sharing,
        ngm:distributed-collaboration,
        ngm:system-integration ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:interoperability,
        ngm:semantic-interoperability,
        ngm:syntactic-interoperability ;
    vc:implements ngm:restful-api,
        ngm:standardized-formats ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:enterprise-service-bus,
        ngm:microservices-architecture,
        ngm:service-oriented-architecture ;
    vc:requires ngm:api-gateway,
        ngm:data-transformation,
        ngm:message-broker ;
    vc:slug "system-interoperability" ;
    vc:sourceDomain "infrastructure" ;
    vc:standardizedBy ngm:iso-iec,
        ngm:open-api-specification .

ngm:target-tracking a owl:Class ;
    rdfs:label "Target Tracking"@en ;
    rdfs:comment "Target tracking is a computational and signal-processing discipline concerned with estimating the state — typically position, velocity, and orientation — of one or more moving objects over time from sequences of noisy sensor observations. It encompasses algorithms such as Kalman filters, particle filters, and multi-hypothesis trackers, applied across radar, sonar, computer vision, and LiDAR modalities. Applications span aerospace surveillance, autonomous vehicle perception, robotic manipulation, sports analytics, and augmented reality. Modern deep-learning-based trackers jointly perform detection and tracking, achieving robust performance in complex, cluttered environments."@en ;
    rdfs:subClassOf ngm:object-detection-and-tracking ;
    vc:enables ngm:anomaly-detection,
        ngm:human-pose-slam-capture-system ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:computer-vision,
        ngm:motion-tracking,
        ngm:object-detection,
        ngm:sensor-fusion ;
    vc:slug "target-tracking" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:spatial-tracking-system,
        ngm:trajectory-tracking .

ngm:task-analysis a owl:Class ;
    rdfs:label "Task Analysis"@en ;
    rdfs:comment "Task analysis is the systematic study of how users accomplish goals, decomposing activities into the sequence of actions, decisions, and cognitive operations required to complete them. It produces structured descriptions such as hierarchical task models and workflow maps that inform interface design, error prevention, and training. By making implicit work practices explicit, it grounds design decisions in observed user behaviour rather than assumption."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:requirements-engineering ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:user-research ],
        ngm:interaction-design ;
    vc:contrastsWith ngm:requirements-engineering ;
    vc:enables ngm:information-architecture,
        ngm:interaction-design ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:human-computer-interaction ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:cognitive-load,
        ngm:usability,
        ngm:user-research ;
    vc:requires ngm:requirements-engineering,
        ngm:user-research ;
    vc:slug "task-analysis" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:usability,
        ngm:user-experience ;
    vc:uses ngm:prototyping,
        ngm:usability-testing .

ngm:technology-infrastructure-domain-layer a owl:Class ;
    rdfs:label "Infrastructure Layer"@en ;
    rdfs:comment "Foundational base layer providing computing, storage, and network capabilities that enable metaverse applications and services to operate at scale."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:spatial-computing ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:hardware-abstraction-layer-hal ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:cdn ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:cloud-computing ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:5-g-network ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:network-infrastructure ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:storage-layer ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:power-systems ],
        [ a owl:Restriction ;
