    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:audit-trail,
        ngm:consent-management ;
    vc:requires ngm:compliance,
        ngm:data-protection-officer,
        ngm:regulatory-framework ;
    vc:slug "legal-framework" ;
    vc:sourceDomain "governance" ;
    vc:standardizedBy ngm:eu-ai-act-regulatory-instrument,
