ngm:autonomous-robot a owl:Class ;
    rdfs:label "Autonomous Robot"@en ;
    rdfs:comment "A robotic system equipped with sensors, processing units, and actuators that operates independently to perform tasks without direct human control, using Artificial Intelligence and Autonomous Navigation to perceive, reason, and act in physical or virtual environments."@en ;
