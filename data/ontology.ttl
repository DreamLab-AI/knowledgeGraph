    vc:isPartOf ngm:computer-graphics ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:colour-grading ;
    vc:relatedTo ngm:post-processing ;
    vc:relatedTo ngm:tone-mapping ;
    vc:requires ngm:global-illumination ;
    vc:requires ngm:physically-based-rendering ;
    vc:requires ngm:ray-tracing ;
