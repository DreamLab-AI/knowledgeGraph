ngm:wave-net a owl:Class ;
    rdfs:label "WaveNet"@en ;
    rdfs:comment "A deep autoregressive neural network for generating raw audio waveforms one sample at a time, using stacks of dilated causal convolutions."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:convolution ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:autoregressive-model ],
        ngm:convolutional-neural-network ;
    vc:enables ngm:text-to-speech ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:autoregressive-model,
        ngm:convolution ;
    vc:slug "wave-net" ;
    vc:sourceDomain "machine-learning" .

