    vc:slug "customer-service-automation" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:conversational-ai,
        ngm:natural-language-processing,
        ngm:sentiment-analysis .

ngm:delegated-proof-of-stake a owl:Class ;
    rdfs:label "Delegated Proof of Stake"@en ;
    rdfs:comment "A Proof-of-Stake variant in which token holders delegate block production rights to a fixed number of elected delegates (witnesses or block producers) via a token-weighted democratic voting mechanism. DPoS achieves high throughput and fast block times by concentrating validation among a small elected set, with delegates subject to removal by voters if they misbehave or underperform."@en ;
    rdfs:subClassOf ngm:bc-protocol-and-consensus,
        ngm:proof-of-stake ;
    skos:broader ngm:bc-protocol-and-consensus ;
    vc:contrastsWith ngm:nakamoto-consensus,
        ngm:proof-of-work ;
    vc:enables ngm:deterministic-finality,
        ngm:virtual-economy ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:blockchain-governance,
        ngm:consensus-mechanism,
        ngm:delegate-democracy,
        ngm:liquid-proof-of-stake,
        ngm:nominated-proof-of-stake ;
    vc:slug "delegated-proof-of-stake" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:epoch,
        ngm:governance-token,
        ngm:validator-set .

ngm:difficulty-adjustment a owl:Class ;
    rdfs:label "Difficulty Adjustment"@en ;
    rdfs:comment "Difficulty Adjustment is a Proof-of-Work consensus mechanism that periodically recalibrates the cryptographic puzzle difficulty so that blocks are produced at a statistically stable rate (e.g., approximately every 10 minutes in Bitcoin). It ensures network stability and security as total hash rate fluctuates."@en ;
    rdfs:subClassOf ngm:bc-protocol-and-consensus ;
    skos:broader ngm:bc-protocol-and-consensus ;
    vc:enables ngm:cryptographic-hash-function,
        ngm:validator-node ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:consensus-mechanism,
        ngm:proof-of-work ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:block-reward,
        ngm:blockchain,
        ngm:miner,
        ngm:mining,
        ngm:transaction-fee ;
    vc:slug "difficulty-adjustment" ;
    vc:sourceDomain "blockchain" .

ngm:eip-1559 a owl:Class ;
    rdfs:label "EIP-1559"@en ;
    rdfs:comment "EIP-1559 is an Ethereum Improvement Proposal implemented in the London hard fork that fundamentally reformed Ethereum's transaction fee market. It replaced the simple first-price auction mechanism with a protocol-determined base fee that automatically adjusts each block based on demand relative to a target block gas usage. The base fee is burned rather than paid to validators, creating a deflationary pressure on ether supply. Users optionally add a priority fee (tip) to incentivise timely inclusion. The mechanism improves fee predictability for users and reduces the miner extractable value (MEV) captured through fee sniping."@en ;
    rdfs:subClassOf ngm:bc-protocol-and-consensus ;
    skos:broader ngm:bc-protocol-and-consensus ;
    vc:contrastsWith ngm:proof-of-work ;
    vc:enables ngm:blockchain-transaction ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:blockchain-economics,
        ngm:gas-fee-market,
        ngm:transaction-fee ;
    vc:slug "eip-1559" ;
    vc:sourceDomain "blockchain" .

ngm:epoch a owl:Class ;
    rdfs:label "Epoch"@en ;
    rdfs:comment "In machine learning, an Epoch is one complete pass through the entire training dataset, during which model parameters are updated after each constituent batch. The number of epochs is a primary training hyperparameter: too few yield underfitting, whilst too many risk overfitting—a trade-off managed by techniques such as early stopping and learning-rate scheduling."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:batch-size ],
        ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:contrastsWith ngm:overfitting ;
    vc:dependsOn ngm:deep-learning,
