        ngm:edge-computing ;
    vc:slug "computing-infrastructure" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:power-management,
        ngm:sustainability .

ngm:cryptographic-commitment a owl:Class ;
    rdfs:label "Cryptographic Commitment"@en ;
    rdfs:comment "A cryptographic scheme that allows a party to commit to a chosen value while keeping it hidden, with the ability to reveal it later, satisfying the binding property (cannot change the committed value) and the hiding property (the commitment reveals no information about the value). Used in zero-knowledge proofs, atomic swaps, and confidential transactions."@en ;
    rdfs:subClassOf ngm:bc-cryptographic-primitive,
        ngm:blockchain-entity,
        ngm:cryptographic-primitive ;
    skos:broader ngm:bc-cryptographic-primitive ;
    vc:enables ngm:cryptographic-protocol,
        ngm:immutability,
        ngm:zk-snarks,
        ngm:zk-starks ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:digital-signature,
        ngm:merkle-tree,
        ngm:schnorr-signature,
        ngm:zero-knowledge ;
    vc:slug "cryptographic-commitment" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:cryptographic-hash-function,
        ngm:hash-function,
        ngm:zero-knowledge-proof .

ngm:deterministic-finality a owl:Class ;
    rdfs:label "Deterministic Finality"@en ;
    rdfs:comment "Transaction finality achieved through explicit protocol mechanisms in BFT-based consensus systems, providing absolute mathematical guarantee that finalized blocks cannot be reverted."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:validator-set ],
        ngm:bc-protocol-and-consensus ;
