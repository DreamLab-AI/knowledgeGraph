    vc:slug "xr-testing-infrastructure" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:extended-reality,
        ngm:immersive-experience,
        ngm:user-research .

ngm:zero-trust-architecture-zta a owl:Class ;
    rdfs:label "Zero-Trust Architecture (ZTA)"@en ;
    rdfs:comment "Security model requiring continuous verification of all entities and transactions with least-privilege access enforcement, eliminating implicit trust within metaverse network boundaries."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:policy-engine ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:policy-enforcement-point ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:identity-verification ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:encryption ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:policy-decision-point ],
