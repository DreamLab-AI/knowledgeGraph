ngm:feedback-control a owl:Class ;
    rdfs:label "Feedback Control"@en ;
    rdfs:comment "Feedback Control - A closed-loop control mechanism in which Sensor measurements of actual system state are continuously compared against desired Setpoints, and control actions are adjusted in real time to minimise error and maintain stable, accurate Robot Behaviour."@en ;
