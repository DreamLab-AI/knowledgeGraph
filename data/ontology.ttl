ngm:embedding a owl:Class ;
    rdfs:label "Embedding"@en ;
    rdfs:comment "An embedding is a learned mapping from discrete or high-dimensional objects—such as words, sentences, images, graphs, or code—into a continuous, low-dimensional vector space, such that semantically or functionally similar inputs are mapped to geometrically proximate vectors. Embeddings are fundamental to modern machine learning, enabling downstream tasks including similarity search, classification, clustering, and retrieval through compact, transferable representations. The quality of an embedding space is typically measured by how well geometric proximity in the vector space reflects semantic or functional similarity in the original domain."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:training-data ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:loss-function ],
        ngm:representation-learning ;
    vc:bridgesTo ngm:knowledge-graph,
        ngm:spatial-index ;
    vc:contrastsWith ngm:one-hot-encoding,
        ngm:sparse-representation ;
    vc:enables ngm:clustering,
        ngm:cross-modal-retrieval,
        ngm:recommendation-system,
        ngm:retrieval-augmented-generation,
        ngm:semantic-search,
        ngm:text-classification,
        ngm:vector-database ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:bert,
        ngm:feature-extraction,
        ngm:knowledge-graph-embedding,
        ngm:nearest-neighbor-search,
        ngm:neural-network-latent-space ;
    vc:requires ngm:loss-function,
        ngm:training-data ;
    vc:slug "embedding" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:contrastive-learning,
        ngm:dimensionality-reduction,
        ngm:encoder,
        ngm:neural-network,
        ngm:transformer .

ngm:kalman-filter a owl:Class ;
    rdfs:label "Kalman Filter"@en ;
    rdfs:comment "An optimal recursive Bayesian filter that estimates the state of a linear dynamic system from a series of noisy measurements. It minimizes the mean squared error of the estimated state by combining a model-based prediction step with a measurement update step, weighting each by their respective uncertainty covariances to yield the minimum-variance unbiased estimate."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:state-transition-function ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:covariance-matrix ],
        ngm:state-estimation ;
    vc:bridgesTo ngm:gps,
        ngm:inertial-navigation-system ;
    vc:contrastsWith ngm:extended-kalman-filter,
        ngm:monte-carlo-localization,
        ngm:unscented-kalman-filter ;
    vc:dependsOn ngm:linear-algebra,
        ngm:probability-theory ;
    vc:enables ngm:navigation,
        ngm:sensor-fusion,
        ngm:slam,
        ngm:target-tracking ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:bayes-filter ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:closed-loop-control,
        ngm:control-theory,
        ngm:rb-1013-localization,
        ngm:signal-processing ;
    vc:requires ngm:covariance-matrix,
        ngm:state-transition-function ;
    vc:slug "kalman-filter" ;
    vc:sourceDomain "machine-learning" ;
    vc:uses ngm:mean-squared-error,
        ngm:rb-1008-odometry .

ngm:post-quantum-cryptography a owl:Class ;
    rdfs:label "Post-Quantum Cryptography"@en ;
    rdfs:comment "Cryptographic algorithms and protocols designed to be resistant to attacks from both classical and quantum computers, protecting secure communications in the post-quantum era."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
