    vc:slug "computing-hardware" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:hardware-and-edge,
        ngm:mixed-reality .

ngm:computing-platform a owl:Class ;
    rdfs:label "Computing Platform"@en ;
    rdfs:comment "A computing platform is a hardware and software environment that provides the foundational execution context for applications, services, and AI workloads. It encompasses the combination of processor architecture, operating system, runtime libraries, and supporting infrastructure—such as cloud, edge, or on-premises nodes—that determines what software can run and how it performs."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:middleware ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:operating-system ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:gpu-compute ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:hardware ],
