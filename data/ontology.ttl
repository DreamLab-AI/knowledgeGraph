ngm:elliptic a owl:Class ;
    rdfs:label "Elliptic"@en ;
    rdfs:comment "Elliptic is a blockchain analytics and financial crime compliance company that provides software tools to trace, analyse, and risk-score cryptocurrency transactions across multiple blockchain networks. Its technology maps on-chain flows to real-world entities — exchanges, darknet markets, ransomware wallets, and sanctioned addresses — enabling financial institutions, crypto businesses, and law enforcement to detect and prevent money laundering, terrorist financing, and sanctions evasion. Elliptic's transaction monitoring and wallet screening solutions are used by regulated virtual-asset service providers globally to satisfy AML/CFT obligations under frameworks such as the FATF Travel Rule and MiCA."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:blockchain-analytics ],
        ngm:blockchain-analytics ;
    vc:bridgesTo ngm:financial-crime-compliance ;
    vc:contrastsWith ngm:chainalysis ;
    vc:enables ngm:anti-money-laundering,
        ngm:regulatory-compliance,
        ngm:sanctions-screening,
        ngm:transaction-monitoring ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:dark-web-monitoring,
        ngm:decentralised-finance,
        ngm:know-your-customer ;
    vc:requires ngm:blockchain-analytics,
        ngm:graph-analysis,
        ngm:on-chain-data ;
    vc:slug "elliptic" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:bc-0456-virtual-asset-service-providers,
        ngm:fatf-travel-rule ;
    vc:uses ngm:heuristic-clustering,
        ngm:machine-learning,
        ngm:risk-scoring .

