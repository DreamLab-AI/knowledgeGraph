ngm:knowledge-co-construction a owl:Class ;
    rdfs:comment "Knowledge co-construction is a process in which participants jointly build shared understanding through dialogue, negotiation and the integration of multiple perspectives. Rather than transmitting fixed knowledge, it treats understanding as emergent from collaborative interaction. It is a central mechanism in collaborative and collective learning environments."@en ;
    rdfs:label "Knowledge Co-Construction"@en ;
    rdfs:subClassOf ngm:educational-technology ;
