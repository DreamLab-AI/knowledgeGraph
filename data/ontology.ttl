        ngm:social-vr ;
    vc:slug "interactive-storytelling" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:dialogue-system,
        ngm:game-engine .

ngm:international-trade a owl:Class ;
    rdfs:label "International Trade"@en ;
    rdfs:comment "International trade is the exchange of goods, services, and capital across national borders, allowing countries to specialise according to comparative advantage and access markets, inputs, and resources beyond their own economies. It is governed by tariffs, trade agreements, and institutions such as the World Trade Organization, and is recorded in the balance of payments. It is a primary driver of economic growth and global interdependence."@en ;
    rdfs:subClassOf ngm:macroeconomics ;
    vc:dependsOn ngm:supply-chain ;
    vc:enables ngm:economic-growth ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:customs,
        ngm:global-trade ;
    vc:isPartOf ngm:macroeconomics ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:global-trade,
        ngm:gross-domestic-product,
        ngm:macroeconomics ;
    vc:requires ngm:customs ;
    vc:slug "international-trade" ;
    vc:sourceDomain "finance" ;
    vc:standardizedBy ngm:world-trade-organization ;
    vc:supports ngm:supply-chain ;
    vc:uses ngm:balance-of-payments .

ngm:inverse-reinforcement-learning a owl:Class ;
    rdfs:label "Inverse Reinforcement Learning"@en ;
    rdfs:comment "Inverse reinforcement learning (IRL) is a machine-learning approach that infers the reward function an agent appears to be optimising from observations of its behaviour, rather than being told the reward in advance. It inverts the usual reinforcement-learning problem: instead of finding a policy that maximises a known reward, it recovers the reward that best explains demonstrated, near-optimal trajectories. The recovered reward can then be used to train new policies that generalise the demonstrated intent to unseen situations, making IRL central to learning complex objectives that are hard to specify by hand."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:markov-decision-process ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:reward-function ],
        ngm:imitation-learning ;
    vc:bridgesTo ngm:apprenticeship-learning ;
    vc:contrastsWith ngm:reinforcement-learning ;
    vc:dependsOn ngm:markov-decision-process ;
    vc:enables ngm:apprenticeship-learning,
        ngm:robot-perception ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:imitation-learning ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:machine-learning,
        ngm:model-evaluation ;
    vc:requires ngm:markov-decision-process,
        ngm:reward-function ;
    vc:slug "inverse-reinforcement-learning" ;
    vc:sourceDomain "machine-learning" ;
    vc:supports ngm:reward-function,
        ngm:robotics ;
    vc:uses ngm:neural-network,
        ngm:reinforcement-learning .

ngm:ipsec a owl:Class ;
    rdfs:label "Ipsec"@en ;
    rdfs:comment "IPsec (Internet Protocol Security) is a suite of protocols that secures IP communications by authenticating and encrypting each packet at the network layer. It provides confidentiality, integrity and origin authentication through the Authentication Header and Encapsulating Security Payload protocols, with keys negotiated via the Internet Key Exchange. IPsec is the foundational technology for site-to-site and remote-access virtual private networks operating transparently beneath application protocols."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:internet-protocol ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:key-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:authentication ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:encryption ],
        ngm:network-security ;
    vc:bridgesTo ngm:vpn ;
    vc:contrastsWith ngm:tls ;
    vc:dependsOn ngm:internet-protocol ;
    vc:enables ngm:vpn ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:authentication,
        ngm:encryption ;
    vc:implements ngm:authentication ;
    vc:isPartOf ngm:network-security ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:cryptography,
        ngm:public-key-cryptography,
        ngm:vpn ;
    vc:requires ngm:internet-protocol,
        ngm:key-management ;
    vc:slug "ipsec" ;
    vc:sourceDomain "security" ;
    vc:standardizedBy ngm:internet-protocol ;
    vc:supports ngm:network-security,
        ngm:vpn ;
    vc:uses ngm:encryption,
        ngm:key-management,
        ngm:public-key-cryptography .

ngm:ipv6 a owl:Class ;
    rdfs:label "Ipv6"@en ;
    rdfs:comment "IPv6 (Internet Protocol version 6) is the current generation of the Internet Protocol, designed to replace IPv4 by providing a vastly larger 128-bit address space, simplified header structure, and built-in support for autoconfiguration and security. Its expanded addressing — roughly 3.4 x 10^38 addresses — resolves the exhaustion of IPv4 addresses and removes the need for widespread network address translation. IPv6 supports stateless address autoconfiguration, mandatory support for IPsec, and improved multicast and mobility. It is fundamental to the continued growth of the internet and the addressing of vast numbers of Internet of Things devices."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:routing-protocol ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:network-protocol ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:ip-addressing ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:packet-switching ],
        ngm:internet-protocol ;
    vc:contrastsWith ngm:network-topology ;
    vc:enables ngm:edge-computing,
        ngm:internet-of-things ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:ip-addressing,
        ngm:network-protocol ;
    vc:implements ngm:internet-protocol ;
    vc:isPartOf ngm:internet-protocol ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:thread-protocol ;
    vc:requires ngm:packet-switching,
        ngm:routing-protocol ;
    vc:slug "ipv6" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:broadband-connectivity,
        ngm:network-infrastructure ;
    vc:uses ngm:dns,
        ngm:tcp-ip .

ngm:iso-31000 a owl:Class ;
    rdfs:label "ISO 31000"@en ;
    rdfs:comment "An ISO standard providing principles and guidelines for risk management applicable to organisations of any type or size. It describes a framework and process for managing risk rather than certifiable requirements."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:iso ],
        ngm:technical-standard ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:iso ;
    vc:slug "iso-31000" ;
    vc:sourceDomain "standards" .

ngm:iso-9001 a owl:Class ;
    rdfs:label "Iso 9001"@en ;
    rdfs:comment "ISO 9001 is an international standard that specifies the requirements for a quality management system (QMS), enabling organisations to demonstrate their ability to consistently provide products and services that meet customer and regulatory requirements. Published by the International Organization for Standardization, it is built on principles such as customer focus, process approach and continual improvement. Organisations can be independently certified against ISO 9001 to evidence conformity."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:quality-assurance ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:audit ],
        ngm:standards ;
    vc:bridgesTo ngm:certification ;
    vc:contrastsWith ngm:iso-27001 ;
    vc:dependsOn ngm:iso ;
    vc:enables ngm:certification,
        ngm:compliance ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:isPartOf ngm:standards ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:audit,
        ngm:quality-assurance ;
    vc:requires ngm:audit,
        ngm:quality-assurance ;
    vc:slug "iso-9001" ;
