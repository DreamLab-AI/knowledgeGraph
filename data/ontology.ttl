    vc:sourceDomain "spatial-computing" .

ngm:tor a owl:Class ;
    rdfs:label "Tor"@en ;
    rdfs:comment "A free overlay network and software that provides anonymous communication by routing traffic through a series of volunteer-operated relays using layered encryption."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
