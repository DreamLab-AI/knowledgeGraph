        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:neural-rendering ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:procedural-generation ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:mesh-generation ],
        ngm:generative-ai ;
    vc:bridgesTo ngm:autonomous-robot,
        ngm:extended-reality,
        ngm:metaverse ;
    vc:contrastsWith ngm:3-d-modeling,
        ngm:photogrammetry ;
    vc:dependsOn ngm:gpu-compute ;
    vc:enables ngm:digital-asset,
        ngm:digital-twin,
