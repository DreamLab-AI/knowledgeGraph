        ngm:interplanetary-file-system ;
    vc:requires ngm:consensus-mechanism,
        ngm:oracle-network,
        ngm:public-key-infrastructure ;
    vc:slug "blockchain-provenance" ;
    vc:sourceDomain "blockchain" ;
    vc:standardizedBy ngm:gs1-epcis,
        ngm:w3-c-verifiable-credentials ;
    vc:supports ngm:intellectual-property-rights,
        ngm:regulatory-compliance ;
    vc:uses ngm:content-addressed-storage,
        ngm:cryptographic-hash,
        ngm:digital-signature,
        ngm:distributed-ledger-technology,
        ngm:merkle-tree,
