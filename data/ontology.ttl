ngm:schnorr-signature a owl:Class ;
    rdfs:label "Schnorr Signature"@en ;
    rdfs:comment "A provably secure digital signature scheme based on the discrete logarithm problem over elliptic curves, offering linearity properties that enable key and signature aggregation. Within blockchain systems Schnorr signatures underpin features such as Taproot, MuSig multi-signature protocols, and threshold signing, providing smaller signature sizes and stronger privacy compared to ECDSA."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:private-key ],
        ngm:digital-signature ;
    vc:bridgesTo ngm:blockchain-transaction,
        ngm:decentralised-identity ;
    vc:contrastsWith ngm:bls-signature,
        ngm:ecdsa ;
    vc:enables ngm:digital-signature-verification,
        ngm:key-aggregation,
        ngm:signature-aggregation,
        ngm:threshold-signature-scheme ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:bitcoin-proof-of-work-protocol-improvement-proposals,
        ngm:taproot ;
    vc:isPartOf ngm:bitcoin-protocol,
        ngm:cryptographic-primitive ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:discrete-logarithm-problem,
        ngm:ecdsa,
        ngm:elliptic-curve-cryptography,
        ngm:signature-scheme,
        ngm:taproot-assets ;
    vc:requires ngm:elliptic-curve-group,
        ngm:private-key ;
    vc:slug "schnorr-signature" ;
    vc:sourceDomain "security" ;
    vc:standardizedBy ngm:bip-340,
        ngm:iso-iec-14888 ;
    vc:supports ngm:multi-party-computation,
        ngm:zero-knowledge-proof ;
    vc:uses ngm:cryptographic-hash-function,
        ngm:elliptic-curve-cryptography,
        ngm:secp256k1 .

ngm:trusted-execution-environment a owl:Class ;
    rdfs:label "Trusted Execution Environment"@en ;
    rdfs:comment "A Trusted Execution Environment (TEE) is a hardware-enforced, isolated processing domain within a processor that guarantees confidentiality and integrity of code and data even when the host operating system, hypervisor, or privileged firmware is compromised or untrusted. TEEs are instantiated via technologies such as Intel SGX, AMD SEV-SNP, and Arm TrustZone, each providing hardware-rooted attestation mechanisms that allow a relying party to cryptographically verify the identity, configuration, and integrity of an enclave before exchanging sensitive material. By encrypting enclave memory pages in DRAM and enforcing access control at the silicon level, TEEs form the hardware foundation for confidential computing — enabling private AI inference, secure key management, privacy-preserving multi-party collaboration, and verifiable off-chain computation in blockchain systems."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:secure-boot ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:remote-attestation ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:memory-encryption ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:hardware-root-of-trust ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptographic-key-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:secure-enclave ],
        ngm:infra-security-and-identity ;
    skos:broader ngm:infra-security-and-identity ;
    vc:bridgesTo ngm:blockchain-oracle,
        ngm:federated-learning ;
    vc:enables ngm:confidential-computing,
        ngm:privacy-enhancing-computation-pec,
        ngm:private-inference,
        ngm:secure-multi-party-computation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:memory-encryption,
        ngm:remote-attestation,
        ngm:secure-enclave ;
    vc:implements ngm:zero-trust-architecture ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:secure-element,
        ngm:trusted-platform-module ;
    vc:requires ngm:cryptographic-key-management,
        ngm:hardware-root-of-trust,
        ngm:secure-boot ;
    vc:slug "trusted-execution-environment" ;
    vc:sourceDomain "security" ;
    vc:standardizedBy ngm:confidential-computing-consortium ;
    vc:supports ngm:biometric-authentication,
        ngm:digital-rights-management ;
    vc:uses ngm:hardware-security-module,
        ngm:public-key-infrastructure,
        ngm:symmetric-encryption .

ngm:distributed-system a owl:Class ;
    rdfs:label "Distributed System"@en ;
    rdfs:comment "A distributed system is a collection of autonomous computing nodes interconnected by a network, coordinating their actions through message passing to appear as a single coherent system to end users or applications. The architecture is governed by fundamental trade-offs formalised in the CAP theorem — a system can guarantee at most two of consistency, availability, and partition tolerance simultaneously. Correctness in the presence of node failures and malicious actors is addressed by Byzantine Fault Tolerance protocols and consensus mechanisms such as Paxos, Raft, and Practical Byzantine Fault Tolerance. Canonical instantiations span peer-to-peer networks, blockchain ledgers, microservices architectures, distributed databases, and large-scale cloud infrastructure."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptographic-hash ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:consensus-mechanism ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:fault-tolerance ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-replication ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:distributed-ledger ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:network-protocol ],
