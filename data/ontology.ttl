ngm:autonomous-task-execution a owl:Class ;
    rdfs:label "Autonomous Task Execution"@en ;
    rdfs:comment "Autonomous Task Execution refers to the capacity of AI agents or automated systems to independently carry out goal-directed actions — including planning, tool invocation, error recovery, and result validation — without continuous human supervision. It encompasses the full lifecycle from task decomposition through completion, spanning single-step tool calls and long-horizon multi-step workflows."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:tool-use ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:task-decomposition ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:task-decomposition ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:task-planning ],
        ngm:agentic-ai ;
    vc:bridgesTo ngm:digital-twin,
        ngm:distributed-collaboration,
        ngm:robotics ;
    vc:contrastsWith ngm:robotic-process-automation,
        ngm:single-turn-inference ;
    vc:dependsOn ngm:agent-memory,
        ngm:context-management,
        ngm:reasoning,
        ngm:retrieval-augmented-generation,
        ngm:vector-database ;
    vc:enables ngm:agentic-workflow,
        ngm:human-in-the-loop,
        ngm:multi-agent-orchestration,
        ngm:process-automation,
        ngm:software-engineering-automation,
        ngm:workflow-automation ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:error-recovery,
        ngm:sandboxed-execution,
        ngm:task-decomposition,
        ngm:tool-use ;
    vc:qualityScore "0.92"^^xsd:float ;
    vc:relatedTo ngm:ai-alignment,
        ngm:autonomous-operation,
        ngm:llm-agents,
        ngm:long-horizon-planning,
        ngm:prompt-injection,
        ngm:react-prompting,
        ngm:swe-bench ;
    vc:requires ngm:error-recovery,
        ngm:foundation-models,
        ngm:sandboxed-execution,
        ngm:task-decomposition,
        ngm:task-planning ;
    vc:slug "autonomous-task-execution" ;
    vc:sourceDomain "ai" ;
    vc:standardizedBy ngm:eu-ai-act,
        ngm:model-context-protocol,
        ngm:nist-ai-rmf ;
    vc:uses ngm:automated-planning,
        ngm:chain-of-thought,
        ngm:function-calling,
        ngm:large-language-models,
        ngm:model-context-protocol,
        ngm:reinforcement-learning,
        ngm:tool-use,
        ngm:working-memory .

ngm:big-data a owl:Class ;
    rdfs:label "Big Data"@en ;
    rdfs:comment "Big data denotes datasets whose volume, velocity and variety exceed the capacity of conventional single-machine tools, demanding distributed storage and parallel computation. It is characterised by horizontally scalable architectures, schema-flexible stores, and batch or streaming processing frameworks that move computation to where data resides. The term also names the discipline of extracting value from such datasets through analytics, mining and machine learning at scale."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:stream-processing ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:scalability ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:distributed-computing ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:batch-processing ],
        ngm:data-processing ;
    vc:bridgesTo ngm:data-engineering ;
    vc:dependsOn ngm:cloud-computing ;
    vc:enables ngm:data-analytics,
        ngm:predictive-analytics ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:batch-processing,
        ngm:stream-processing ;
    vc:implements ngm:data-pipeline ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:data-lake,
        ngm:data-warehouse,
        ngm:distributed-systems ;
    vc:requires ngm:distributed-computing,
        ngm:scalability ;
    vc:slug "big-data" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:data-mining,
        ngm:machine-learning ;
    vc:uses ngm:apache-spark,
        ngm:nosql-database .

ngm:binary-encoding a owl:Class ;
    rdfs:label "Binary Encoding"@en ;
    rdfs:comment "A data representation format that converts information into sequences of binary digits (0s and 1s) for efficient storage, transmission, and processing, offering compact machine-friendly representations that optimize bandwidth, reduce latency, and enable cross-platform data exchange."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:schema-definition ],
        ngm:sc-standards-and-interop ;
    skos:broader ngm:sc-standards-and-interop ;
    vc:bridgesTo ngm:data-format ;
    vc:enables ngm:data-serialization,
        ngm:transmission-network ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:schema-definition ;
    vc:slug "binary-encoding" ;
    vc:sourceDomain "spatial-computing" .

ngm:biosecurity a owl:Class ;
    rdfs:label "Biosecurity"@en ;
    rdfs:comment "Biosecurity is the set of policies, practices, and controls aimed at preventing the accidental or deliberate misuse of biological agents, including pathogens, toxins, and biotechnology. It spans laboratory containment, pathogen access controls, dual-use research oversight, and increasingly the governance of AI tools that could lower barriers to engineering dangerous organisms. As a field, it is central to mitigating biological existential and catastrophic risks."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:access-control ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:risk-assessment ],
        ngm:governance ;
    vc:bridgesTo ngm:ai-safety,
        ngm:artificial-intelligence,
        ngm:cybersecurity ;
    vc:contrastsWith ngm:bio-terror ;
    vc:dependsOn ngm:regulatory-compliance ;
    vc:enables ngm:pandemic-preparedness ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:bioethics,
        ngm:existential-risk,
        ngm:gain-of-function-research,
        ngm:synthetic-biology ;
    vc:requires ngm:access-control,
        ngm:international-treaty,
        ngm:risk-assessment ;
    vc:slug "biosecurity" ;
    vc:sourceDomain "governance" .

ngm:bip-340-schnorr-keypair a owl:Class ;
    rdfs:label "BIP-340 Schnorr Keypair"@en ;
    rdfs:comment "A BIP-340 Schnorr Keypair is the 32-byte public key and associated private key pairing defined by Bitcoin Improvement Proposal 340, which introduced Schnorr signature support to Bitcoin via the Taproot upgrade activated in November 2021. Unlike the earlier ECDSA scheme used in Bitcoin, BIP-340 uses x-only public keys — just the x-coordinate of the secp256k1 curve point — reducing on-chain byte footprint and simplifying key aggregation. The scheme is provably secure under the discrete logarithm assumption and supports native key and signature aggregation via protocols such as MuSig2, enabling multi-party signing that is indistinguishable from single-party signing on-chain. BIP-340 keypairs are the cryptographic foundation for Taproot outputs, Tapscript, and the Nostr identity protocol."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:secp256k1-elliptic-curve ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:private-key ],
        ngm:cryptographic-keys ;
    vc:bridgesTo ngm:decentralized-identifier,
        ngm:digital-identity ;
    vc:contrastsWith ngm:ecdsa ;
    vc:dependsOn ngm:hash-function,
        ngm:tagged-hash ;
    vc:enables ngm:bip-342-tapscript,
        ngm:key-aggregation,
        ngm:mu-sig-2,
        ngm:multi-sig-governance,
        ngm:nostr-protocol,
        ngm:taproot-assets ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:bitcoin-proof-of-work-protocol-improvement-proposals,
        ngm:taproot ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:bip-327,
        ngm:bip-340,
        ngm:bip-341,
        ngm:discrete-logarithm-problem,
        ngm:schnorr-signature,
        ngm:secp256k1 ;
    vc:requires ngm:private-key,
        ngm:secp256k1-elliptic-curve ;
    vc:slug "bip-340-schnorr-keypair" ;
    vc:sourceDomain "blockchain" ;
    vc:standardizedBy ngm:bitcoin-proof-of-work-protocol-core ;
    vc:uses ngm:elliptic-curve-cryptography,
        ngm:random-oracle-model,
        ngm:x-only-public-key .

ngm:bitcoin-proof-of-work-protocol-standard a owl:Class ;
    rdfs:label "Bitcoin Standard"@en ;
    rdfs:comment "The Bitcoin Standard is an economic and monetary thesis proposing that Bitcoin's algorithmically enforced fixed supply of 21 million units, its decentralised Proof of Work consensus mechanism, and its censorship-resistant disinflationary issuance schedule collectively make it a superior store of value and the basis for a new international monetary order analogous to the historical gold standard. Drawing heavily on Austrian economics — particularly Ludwig von Mises's concept of sound money and Saifedean Ammous's eponymous 2018 treatise — the thesis holds that Bitcoin's predictable, politically immutable monetary policy immunises it against the purchasing-power erosion endemic to fiat currencies managed by central banks. In practice the standard informs corporate treasury reserve strategies, nation-state legal-tender experiments, and the design of Bitcoin ETF and custody infrastructure."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptographic-security ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:blockchain ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:decentralisation ],
        ngm:bc-token-and-asset ;
    skos:broader ngm:bc-token-and-asset ;
    vc:bridgesTo ngm:digital-asset-governance,
        ngm:macroeconomics ;
    vc:contrastsWith ngm:central-bank-digital-currency,
        ngm:fiat-currency,
        ngm:inflation ;
    vc:dependsOn ngm:network-effects,
        ngm:public-key-cryptography ;
    vc:enables ngm:bitcoin-proof-of-work-protocol-etf,
        ngm:sovereign-bitcoin-adoption,
        ngm:strategic-bitcoin-reserve ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:austrian-economics,
        ngm:bitcoin-proof-of-work-protocol-as-money,
        ngm:bitcoin-proof-of-work-protocol-value-proposition,
        ngm:monetary-sovereignty,
        ngm:monetary-system,
        ngm:sound-money ;
    vc:requires ngm:blockchain,
        ngm:cryptographic-security,
        ngm:decentralisation ;
    vc:slug "bitcoin-standard" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:bitcoin-proof-of-work-protocol-mining,
        ngm:cryptocurrency,
        ngm:halving,
        ngm:proof-of-work .

ngm:blockchain-node a owl:Class ;
    rdfs:label "Blockchain Node"@en ;
    rdfs:comment "A blockchain node is a computer running the protocol software of a blockchain network that maintains a copy of the ledger, validates transactions and blocks, and relays them to peers. Nodes collectively enforce the consensus rules and provide the decentralisation and redundancy that make the network trustworthy. They range from full nodes that store and verify the complete chain to light clients that verify selectively, and validator nodes that additionally participate in block production."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:mempool ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:transaction-validation ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:full-node ],
        ngm:blockchain ;
    skos:broader ngm:blockchain ;
    vc:bridgesTo ngm:distributed-systems ;
    vc:dependsOn ngm:consensus-mechanism,
        ngm:peer-to-peer-network ;
    vc:enables ngm:validator ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:full-node,
        ngm:mempool ;
    vc:implements ngm:block-propagation ;
    vc:isPartOf ngm:blockchain,
        ngm:peer-to-peer-network ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:consensus,
        ngm:full-node,
        ngm:light-client ;
    vc:requires ngm:transaction-validation ;
    vc:slug "blockchain-node" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:decentralisation,
        ngm:distributed-ledger ;
    vc:uses ngm:state-synchronisation .

ngm:boosting a owl:Class ;
    rdfs:label "Boosting"@en ;
    rdfs:comment "A sequential ensemble learning technique that combines multiple weak learners into a strong predictor by iteratively training each new model to correct the errors of its predecessors. Instance weights are adjusted after each round so that misclassified examples receive more attention; the final prediction is a weighted vote across all weak learners. Key algorithms include AdaBoost, Gradient Boosting, XGBoost, LightGBM, and CatBoost."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:machine-learning-discipline ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:training-data ],
        ngm:ai-technique,
        ngm:ensemble-methods ;
    skos:broader ngm:ai-technique ;
    vc:contrastsWith ngm:deep-learning ;
    vc:enables ngm:overfitting ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:requires ngm:machine-learning-discipline,
        ngm:training-data ;
    vc:slug "boosting" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:gradient-descent,
        ngm:regularisation .

ngm:brdf a owl:Class ;
    rdfs:label "BRDF"@en ;
    rdfs:comment "A Bidirectional Reflectance Distribution Function (BRDF) is a function that defines how light is reflected at an opaque surface, giving the ratio of reflected radiance to incident irradiance for each pair of incoming and outgoing directions. It encodes material appearance such as diffuse, glossy, and specular behaviour and is the core of physically based shading. Renderers evaluate the BRDF at surface intersections to compute realistic light transport."@en ;
    rdfs:subClassOf ngm:rendering-technique ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:ray-tracing ;
    vc:slug "brdf" ;
    vc:sourceDomain "metaverse" .

ngm:bulletproofs a owl:Class ;
    rdfs:label "Bulletproofs"@en ;
    rdfs:comment "Bulletproofs are a class of short, non-interactive zero-knowledge proof system that enables efficient range proofs and arbitrary arithmetic circuit satisfiability without a trusted setup. Based on the discrete logarithm assumption over elliptic curves, they produce logarithmically-sized proofs that can be aggregated and batched, making them particularly well-suited to confidential transaction systems in public blockchains where proof size and verification cost are critical constraints."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:computational-hardness-assumption ],
        ngm:zero-knowledge-proof ;
    vc:bridgesTo ngm:distributed-systems,
        ngm:security ;
    vc:contrastsWith ngm:groth-16,
        ngm:zk-snark,
        ngm:zk-starks ;
    vc:enables ngm:batch-verification,
        ngm:confidential-transactions,
        ngm:cryptographic-proof,
        ngm:privacy-preserving-computation,
        ngm:range-proof ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:non-interactive-proof ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:multi-party-computation,
        ngm:privacy-preserving-blockchain,
        ngm:proof-aggregation ;
    vc:requires ngm:computational-hardness-assumption ;
    vc:slug "bulletproofs" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:decentralised-finance,
        ngm:monero ;
    vc:uses ngm:commitment-scheme,
        ngm:elliptic-curve-cryptography,
        ngm:fiat-shamir-transform,
        ngm:pedersen-commitment,
        ngm:schnorr-signature .

ngm:business-process-management a owl:Class ;
    rdfs:label "Business Process Management"@en ;
    rdfs:comment "Business Process Management (BPM) is a discipline that uses methods, techniques, and software tools to discover, model, analyse, measure, improve, and automate business processes — end-to-end workflows that produce value for internal stakeholders or external customers. It combines organisational management practice with process automation technology to make organisational operations more efficient, agile, and aligned with strategic goals."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:process-mining ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:business-rules-engine ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:event-driven-architecture ],
        ngm:enterprise-architecture ;
    vc:bridgesTo ngm:artificial-intelligence,
        ngm:low-code-platform ;
    vc:enables ngm:continuous-improvement,
        ngm:digital-transformation,
        ngm:operational-efficiency,
        ngm:process-automation,
        ngm:workflow-automation ;
    vc:hasMaturity ngmi:maturity-draft ;
