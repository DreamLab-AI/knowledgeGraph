ngm:miner-extractable-value a owl:Class ;
    rdfs:label "Miner Extractable Value"@en ;
    rdfs:comment "Miner extractable value, now more broadly termed maximal extractable value, is the profit that block producers (miners or validators) and other actors can capture by reordering, inserting or censoring transactions within the blocks they produce. Because the producer controls transaction ordering, they can exploit pending transactions in the mempool through strategies such as front-running, back-running and sandwich attacks, especially around decentralised exchanges. MEV has significant implications for fairness, network economics, censorship resistance and protocol design."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:smart-contract ],
        ngm:blockchain-economics ;
    vc:bridgesTo ngm:blockchain ;
    vc:contrastsWith ngm:censorship-resistance ;
    vc:dependsOn ngm:proof-of-stake,
        ngm:validator ;
    vc:enables ngm:flash-loan ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:blockchain-economics ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:decentralised-exchange,
        ngm:eip-1559,
        ngm:ethereum,
        ngm:gas-fee,
        ngm:mev ;
    vc:requires ngm:smart-contract ;
    vc:slug "miner-extractable-value" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:blockchain-economics ;
    vc:uses ngm:automated-market-maker,
        ngm:liquidity-pool .

ngm:mining-hardware a owl:Class ;
    rdfs:label "Mining Hardware"@en ;
    rdfs:comment "Mining hardware is the specialised computing equipment used to perform the cryptographic work that secures proof-of-work blockchains, racing to find valid block hashes in exchange for block rewards. It has progressed from general-purpose CPUs and GPUs to dedicated application-specific integrated circuits (ASICs) optimised for a single hashing algorithm. The efficiency and concentration of this hardware shape network security, energy consumption, and mining centralisation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:gpu ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:asic ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:energy-consumption ],
        ngm:cryptocurrency-mining ;
    vc:bridgesTo ngm:infrastructure ;
    vc:contrastsWith ngm:proof-of-stake ;
    vc:dependsOn ngm:energy-consumption,
        ngm:mining-difficulty ;
    vc:enables ngm:hash-rate,
        ngm:proof-of-work ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:asic,
        ngm:gpu ;
    vc:implements ngm:proof-of-work ;
    vc:isPartOf ngm:cryptocurrency-mining,
        ngm:proof-of-work ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:double-spending,
        ngm:hash-rate ;
    vc:requires ngm:energy-consumption ;
    vc:slug "mining-hardware" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:block-reward,
        ngm:mining-pool ;
    vc:uses ngm:asic,
        ngm:gpu .

ngm:model-validation a owl:Class ;
    rdfs:label "Model Validation"@en ;
    rdfs:comment "Model validation is the process of assessing whether a trained model meets its intended requirements for accuracy, robustness, fairness and generalisation before it is trusted in practice. It uses held-out data, cross-validation and stress tests to estimate performance on unseen inputs and to detect overfitting, bias or specification gaps. Distinct from evaluation metrics alone, validation judges fitness for purpose within the model lifecycle."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:cross-validation ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:model-evaluation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-quality ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:model-training ],
        ngm:ai-lifecycle ;
    vc:enables ngm:model-deployment,
        ngm:model-selection ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:cross-validation,
        ngm:model-evaluation ;
    vc:isPartOf ngm:ai-lifecycle ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:explainability,
        ngm:hyperparameter-tuning,
        ngm:interpretability ;
    vc:requires ngm:data-quality,
        ngm:model-training ;
    vc:slug "model-validation" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:model-monitoring ;
    vc:uses ngm:confusion-matrix,
        ngm:sensitivity-analysis .

ngm:model-versioning a owl:Class ;
    rdfs:label "Model Versioning"@en ;
    rdfs:comment "Model versioning is the practice of tracking and managing successive versions of machine learning models, recording the code, data, hyperparameters, and checkpoints that produced each one. It enables reproducibility, rollback, lineage tracing, and controlled promotion of models through development and production stages. Model registries and artefact stores implement versioning as a core MLOps capability."@en ;
    rdfs:subClassOf ngm:ai-infrastructure ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:checkpoints,
        ngm:mlflow ;
    vc:slug "model-versioning" ;
    vc:sourceDomain "ai" .

ngm:modular-blockchain a owl:Class ;
    rdfs:label "Modular Blockchain"@en ;
    rdfs:comment "A modular blockchain is a blockchain architecture that separates the core functions of execution, settlement, consensus, and data availability into distinct, specialised layers rather than handling them all in a single monolithic chain. Each layer can be optimised and scaled independently, and components can be mixed and matched across networks. This decomposition aims to overcome the scalability constraints of monolithic designs while preserving security and decentralisation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-availability ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:settlement-layer ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:data-availability ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:consensus-layer ],
        ngm:blockchain ;
    skos:broader ngm:blockchain ;
    vc:bridgesTo ngm:celestia,
        ngm:cosmos ;
    vc:contrastsWith ngm:blockchain ;
    vc:enables ngm:blockchain-scalability,
        ngm:rollup,
        ngm:scalability ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:consensus-layer,
        ngm:data-availability,
        ngm:settlement-layer ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:fraud-proof ;
    vc:requires ngm:data-availability ;
    vc:slug "modular-blockchain" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:layer-2-scaling,
        ngm:layer2 ;
    vc:uses ngm:data-availability-sampling,
        ngm:optimistic-rollup,
        ngm:zk-rollup .

ngm:multi-robot-systems a owl:Class ;
    rdfs:label "Multi-Robot Systems"@en ;
    rdfs:comment "Multi-robot systems (MRS) are coordinated ensembles of two or more robotic agents that collaborate to accomplish tasks beyond the reach of a single robot, using communication, task allocation, and shared world models. They span architectures from tightly coupled homogeneous fleets to loosely coupled heterogeneous teams where robots with different capabilities complement each other. Key research challenges include task and motion planning, collision avoidance, fault tolerance, and communication bandwidth constraints in dynamic environments. MRS find application in search and rescue, warehouse automation, precision agriculture, and planetary exploration."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:swarm-robot ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:collision-avoidance ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:communication-protocol ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:autonomous-robot ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:collaborative-systems-modality-robot ],
        ngm:autonomous-system ;
    vc:bridgesTo ngm:artificial-intelligence,
        ngm:distributed-systems ;
    vc:contrastsWith ngm:single-robot-system,
        ngm:teleoperation ;
    vc:dependsOn ngm:fault-tolerance,
        ngm:motion-planning,
        ngm:sensor-fusion ;
    vc:enables ngm:precision-agriculture,
        ngm:search-and-rescue-robotics,
        ngm:warehouse-automation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:autonomous-robot,
        ngm:collaborative-systems-modality-robot,
        ngm:inter-robot-communication,
        ngm:swarm-robot,
        ngm:task-allocation-mechanism ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:autonomous-navigation,
        ngm:fleet-management,
        ngm:human-robot-interaction,
        ngm:multi-agent-system,
        ngm:swarm-robotics ;
    vc:requires ngm:collision-avoidance,
        ngm:communication-protocol,
        ngm:distributed-sensing ;
    vc:slug "multi-robot-systems" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:consensus-algorithm,
        ngm:reinforcement-learning,
        ngm:robot-operating-system,
        ngm:robotic-control .

ngm:multi-task-learning a owl:Class ;
    rdfs:label "Multi Task Learning"@en ;
    rdfs:comment "Multi Task Learning is a machine learning paradigm where a single model is trained simultaneously on multiple related tasks, sharing intermediate representations to improve generalisation, sample efficiency, and regularisation relative to independently trained single-task models."@en ;
    rdfs:subClassOf ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:contrastsWith ngm:overfitting ;
    vc:enables ngm:multimodal-ai-architecture-ai ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:supervised-learning,
        ngm:transfer-learning ;
    vc:slug "multi-task-learning" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:neural-network-architecture .

ngm:multimodal-ai-architecture-models a owl:Class ;
    rdfs:label "Multimodal Models"@en ;
    rdfs:comment "Multimodal models are machine learning architectures that jointly process, align, and reason over information from two or more distinct data modalities — such as text, images, audio, video, or depth — within a unified model. They learn shared or bridged representations that enable cross-modal tasks including visual question answering, image captioning, speech recognition conditioned on vision, and text-to-image synthesis. These models extend unimodal foundations (typically large language models or vision encoders) by integrating modality-specific encoders or tokenisers with cross-attention or projection layers that align heterogeneous feature spaces. Multimodal models represent the convergence of natural language processing, computer vision, and speech processing into a single, generalist AI paradigm."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cross-attention ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:transformer ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:training-data ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:decoder ],
        ngm:multimodal-ai-architecture-ai ;
    vc:bridgesTo ngm:human-computer-interaction,
        ngm:spatial-computing ;
    vc:dependsOn ngm:foundation-model,
        ngm:self-supervised-learning ;
    vc:enables ngm:image-captioning,
        ngm:speech-recognition,
        ngm:text-to-image,
        ngm:visual-question-answering ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:decoder,
        ngm:modality-specific-encoder ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:clip,
        ngm:diffusion-models,
        ngm:instruction-tuning ;
    vc:requires ngm:cross-attention,
        ngm:training-data,
        ngm:transformer ;
    vc:slug "multimodal-models" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:contrastive-learning,
        ngm:embedding-space,
        ngm:encoder,
        ngm:large-language-model .

ngm:multimodal-interaction a owl:Class ;
    rdfs:label "Multimodal Interaction"@en ;
    rdfs:comment "Multimodal interaction is a style of human-computer interaction in which users communicate with a system through two or more input or output modalities — such as speech, gesture, gaze, touch, and haptics — used in combination or interchangeably. By fusing complementary signals, multimodal systems interpret intent more robustly and naturally than any single channel, and they are central to spatial and immersive computing where physical input is rich. It is a key paradigm for designing interfaces in augmented and virtual reality."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:eye-tracking ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:haptic-feedback ],
        ngm:human-computer-interaction ;
    vc:bridgesTo ngm:conversational-ai ;
    vc:enables ngm:augmented-reality,
        ngm:virtual-reality ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:eye-tracking,
        ngm:haptic-feedback ;
    vc:implements ngm:interaction-design ;
    vc:isPartOf ngm:user-interface ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:human-computer-interaction,
        ngm:interaction-design ;
    vc:slug "multimodal-interaction" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:spatial-interaction,
        ngm:universal-design ;
    vc:uses ngm:gesture-recognition,
        ngm:speech-recognition .

ngm:national-competent-authority a owl:Class ;
    rdfs:label "National Competent Authority"@en ;
    rdfs:comment "A body designated by an EU Member State under the AI Act — encompassing market surveillance authorities, notifying authorities, and data protection authorities — responsible for supervising provider and deployer compliance with the Act's requirements, enforcing penalties, and coordinating with the AI Office on cross-border and GPAI model matters."@en ;
    rdfs:subClassOf ngm:infra-legal-and-regulatory,
        ngm:regulatory-framework ;
    skos:broader ngm:infra-legal-and-regulatory ;
    vc:dependsOn ngm:accountability,
        ngm:transparency ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:implements ngm:ai-governance ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:slug "national-competent-authority" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:ai-office,
        ngm:conformity-assessment ;
    vc:uses ngm:market-surveillance-authority,
        ngm:notified-body .

ngm:network-performance-metrics a owl:Class ;
    rdfs:label "Network Performance Metrics"@en ;
    rdfs:comment "Network Performance Metrics are quantitative measures used to characterise the operational quality of a communication network, encompassing latency, throughput, packet loss rate, jitter, and availability. These metrics are collected continuously from network devices, links, and endpoints to support quality-of-service enforcement, capacity planning, fault detection, and SLA compliance verification. They underpin all layers of network management from physical links to application-level experience."@en ;
    rdfs:subClassOf ngm:quality-of-service ;
    vc:enables ngm:latency-aware-edge-ai ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:bandwidth-adaptation,
        ngm:edge-computing,
        ngm:internet-infrastructure,
        ngm:latency ;
