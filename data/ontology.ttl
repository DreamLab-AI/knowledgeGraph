ngm:connext a owl:Class ;
    rdfs:label "Connext"@en ;
    rdfs:comment "A cross-chain interoperability protocol that enables fast transfers and contract calls between Ethereum-compatible blockchains and Layer 2 networks without relying on a single trusted custodian."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ethereum ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:liquidity-pool ],
        ngm:cross-chain-bridge ;
    vc:enables ngm:interoperability ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:ethereum,
        ngm:liquidity-pool ;
    vc:slug "connext" ;
    vc:sourceDomain "blockchain" .

