        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-privacy ],
        ngm:digital-economy ;
    vc:bridgesTo ngm:artificial-intelligence,
        ngm:fraud-detection,
        ngm:supply-chain-finance ;
    vc:contrastsWith ngm:traditional-banking ;
    vc:dependsOn ngm:cryptography,
        ngm:internet-infrastructure ;
    vc:enables ngm:central-bank-digital-currency,
