ngm:access-control a owl:Class ;
    rdfs:label "Access Control"@en ;
    rdfs:comment "Access control is a fundamental security mechanism that regulates which users, systems, or processes can view, use, or modify resources within a computing environment. It encompasses the policies, procedures, and technologies that govern the granting and restricting of access rights, ensuring that only authorised entities can perform specific actions on protected resources based on their identity, role, or attributes."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:identity-and-access-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptography ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:authorisation ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:authentication ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:identity-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:audit-logging ],
        ngm:infra-security-and-identity ;
    skos:broader ngm:infra-security-and-identity ;
    vc:bridgesTo ngm:decentralised-identity,
        ngm:smart-contract ;
    vc:contrastsWith ngm:open-access ;
    vc:enables ngm:compliance,
        ngm:data-protection,
        ngm:least-privilege,
        ngm:security,
        ngm:separation-of-duties ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:audit-logging,
        ngm:authentication,
        ngm:authorisation,
        ngm:identity-and-access-management ;
    vc:implements ngm:attribute-based-access-control,
        ngm:mandatory-access-control,
        ngm:role-based-access-control ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:multi-factor-authentication,
        ngm:network-security,
        ngm:security ;
    vc:requires ngm:cryptography,
        ngm:identity-management ;
    vc:slug "access-control" ;
    vc:sourceDomain "security" ;
    vc:standardizedBy ngm:iso-iec-27001,
        ngm:nist-sp-800-53 ;
    vc:supports ngm:regulatory-compliance,
        ngm:zero-trust-architecture ;
    vc:uses ngm:access-control-list,
        ngm:identity-and-access-management,
        ngm:privileged-access-management .

ngm:authentication a owl:Class ;
    rdfs:label "Authentication"@en ;
    rdfs:comment "Authentication is the security process of verifying that a claimed identity of a user, device, application, or service is genuine before granting access to protected resources. It is fundamentally distinct from authorisation, which determines what permissions an authenticated principal possesses. Authentication evidence is categorised into knowledge factors (passwords, PINs, security questions), possession factors (hardware security keys, TOTP devices, mobile authenticators), and inherence factors (biometrics such as fingerprint or facial recognition), with cryptographic proofs (digital signatures, TLS client certificates, FIDO2 passkeys) increasingly replacing shared-secret schemes. Modern secure systems combine multiple independent factors through multi-factor authentication to achieve strong resistance against credential theft, phishing, replay attacks, and session hijacking."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:public-key-infrastructure ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptography ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:identity-verification ],
        ngm:identity-and-access-management ;
    vc:bridgesTo ngm:decentralised-identity,
        ngm:self-sovereign-identity,
        ngm:verifiable-credentials ;
    vc:contrastsWith ngm:anonymity,
        ngm:authorisation ;
    vc:dependsOn ngm:digital-signatures,
        ngm:key-management,
        ngm:secure-communication ;
    vc:enables ngm:access-control,
        ngm:authorisation,
        ngm:session-management,
        ngm:single-sign-on ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:implements ngm:fido2,
        ngm:oauth-2-0,
        ngm:open-id-connect,
        ngm:saml ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:federation,
        ngm:multi-factor-authentication,
        ngm:threat-model ;
    vc:requires ngm:cryptography,
        ngm:identity-verification,
        ngm:public-key-infrastructure ;
    vc:slug "authentication" ;
    vc:sourceDomain "security" ;
    vc:supports ngm:compliance,
        ngm:privacy,
        ngm:zero-trust-architecture .

ngm:robotics a owl:Class,
