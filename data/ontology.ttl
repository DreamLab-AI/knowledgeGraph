    vc:slug "transaction-parameter" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:eip-1559,
        ngm:gas-limit,
        ngm:gas-price .

ngm:trojan-attack a owl:Class ;
    rdfs:label "Trojan Attack"@en ;
    rdfs:comment "A Trojan Attack is a supply-chain-oriented backdoor attack on AI models in which a pre-trained model or training pipeline is maliciously modified to embed hidden triggers; the model performs normally on clean inputs but produces attacker-defined outputs when specific trigger patterns are present. Unlike general backdoor attacks, Trojan attacks emphasise persistence through fine-tuning and distribution via public model repositories."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:supply-chain ],
        ngm:sc-governance-and-safety ;
    skos:broader ngm:sc-governance-and-safety ;
    vc:contrastsWith ngm:adversarial-robustness ;
    vc:dependsOn ngm:ai-security ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:adversarial-attack,
        ngm:backdoor-attack,
        ngm:data-poisoning ;
    vc:requires ngm:supply-chain ;
    vc:slug "trojan-attack" ;
    vc:sourceDomain "spatial-computing" .

ngm:true-positive-rate a owl:Class ;
    rdfs:label "True Positive Rate"@en ;
    rdfs:comment "True positive rate is a classification metric measuring the proportion of actual positive cases that a model correctly identifies, also known as sensitivity or recall."@en ;
