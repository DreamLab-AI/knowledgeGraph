        ngm:neural-network .

ngm:image-classification a owl:Class ;
    rdfs:label "Image Classification"@en ;
    rdfs:comment "Image Classification is the computer vision task of assigning a categorical label to an entire image from a predefined set of classes, determining what is depicted in the image as a whole."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:convolutional-neural-network ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:deep-learning ],
        ngm:ai-application ;
    skos:broader ngm:ai-application ;
    vc:enables ngm:object-detection,
        ngm:scene-understanding ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:computer-vision ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires ngm:convolutional-neural-network,
        ngm:deep-learning ;
    vc:slug "image-classification" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:transfer-learning .

ngm:impedance-control a owl:Class ;
    rdfs:label "Impedance Control"@en ;
    rdfs:comment "Impedance Control - A Hybrid Control strategy that dynamically modulates a robot's mechanical compliance (stiffness and damping) to establish compliant contact with objects or humans, enabling safe interaction and force regulation without explicit force feedback in some configurations."@en ;
    rdfs:subClassOf ngm:control-system,
        ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:enables ngm:adaptive-manipulation,
