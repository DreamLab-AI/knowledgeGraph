ngm:interface-layer a owl:Class ;
    rdfs:label "Interface Layer"@en ;
    rdfs:comment "The Interface Layer is the cross-cutting stratum that defines the boundaries and contracts through which components communicate. It sits above the integration and transport mechanisms that carry calls and below the applications that consume the contracts. It contains interface definitions, schemas, and the conventions that govern interaction."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:integration-layer ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:apilayer ],
        ngm:infra-software-engineering ;
    skos:broader ngm:infra-software-engineering ;
    vc:enables ngm:application-layer,
        ngm:presentation-layer ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:apilayer,
        ngm:integration-layer ;
    vc:slug "interface-layer" ;
    vc:sourceDomain "infrastructure" .

