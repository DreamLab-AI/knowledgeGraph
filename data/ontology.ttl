ngm:stakeholder-consultation-engine a skos:Concept ;
    rdfs:label "Stakeholder Consultation Engine"@en .
ngm:stakeholder-coordination a owl:Class ;
    rdfs:comment "The process of aligning the interests, incentives, and actions of diverse participants — token holders, developers, validators, users, and institutional actors — so that a shared protocol, organisation, or ecosystem can reach collective decisions and execute them coherently. It combines formal mechanisms such as voting, delegation, and incentive design with informal channels such as forums, working groups, and signalling, and it is the central problem that governance systems exist to solve."@en ;
    rdfs:label "Stakeholder Coordination"@en ;
    rdfs:subClassOf ngm:governance ;
    vc:enables ngm:dao ;
    vc:hasMaturity ngmi:maturity-established ;
