    vcw:owlRole "Concept" .

# Autonomous Robot
robotics:AutonomousRobot rdf:type owl:Class ;
    rdfs:label "Autonomous Robot"@en ;
    rdfs:comment "A robotic system equipped with sensors, processing units, and actuators that operates independently to perform tasks without direct human control, using Artificial Intelligence and Autonomous Navigation. These systems integrate Computer Vision, Motion Planning, and Obstacle Detection to interact safely with physical environments."@en ;
    skos:prefLabel "Autonomous Robot"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:robotics:autonomous-robot" ;
    owl:sameAs <urn:visionclaw:concept:robotics:autonomous-robot> ;
    vcw:contentHash "sha256-12-ea98a37eb2a9" ;
    vcw:qualityScore "0.4"^^xsd:decimal ;
    vcw:legacyTermId "RB-3006" ;
    vcw:ontologyStatus "draft" ;
    vcw:maturityLevel "draft" ;
    vcw:authorityScore "0.0"^^xsd:decimal ;
