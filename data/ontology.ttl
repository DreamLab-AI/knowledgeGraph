# ==============================================================================
# OBJECT PROPERTY DECLARATIONS
# ==============================================================================

ngm:hasPart a owl:ObjectProperty, owl:TransitiveProperty ;
    rdfs:label "has part"@en ;
    rdfs:comment "Indicates compositional part-whole relationships"@en ;
    owl:inverseOf ngm:isPartOf .

ngm:isPartOf a owl:ObjectProperty, owl:TransitiveProperty ;
    rdfs:label "is part of"@en ;
    rdfs:comment "Inverse of hasPart"@en ;
    owl:inverseOf ngm:hasPart .

ngm:requires a owl:ObjectProperty ;
    rdfs:label "requires"@en ;
    rdfs:comment "Indicates technical dependencies and prerequisites"@en ;
    owl:inverseOf ngm:isRequiredBy .

ngm:dependsOn a owl:ObjectProperty, owl:TransitiveProperty ;
    rdfs:label "depends on"@en ;
    rdfs:comment "Indicates logical or functional dependencies"@en .

ngm:enables a owl:ObjectProperty ;
    rdfs:label "enables"@en ;
    rdfs:comment "Indicates capabilities and functionalities provided"@en ;
    owl:inverseOf ngm:isEnabledBy .

ngm:relatesTo a owl:ObjectProperty, owl:SymmetricProperty ;
    rdfs:label "relates to"@en ;
    rdfs:comment "General semantic association"@en .

ngm:affects a owl:ObjectProperty ;
    rdfs:label "affects"@en .

ngm:alternativeTo a owl:ObjectProperty ;
    rdfs:label "alternative to"@en .

ngm:appliedIn a owl:ObjectProperty ;
    rdfs:label "applied in"@en .

ngm:appliedTo a owl:ObjectProperty ;
    rdfs:label "applied to"@en .

