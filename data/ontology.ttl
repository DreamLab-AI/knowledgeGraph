ngm:operational-resilience a owl:Class ;
    rdfs:label "Operational Resilience"@en ;
    rdfs:comment "Operational Resilience is the organisational and technical capacity to anticipate, prepare for, withstand, recover from, and adapt to disruptions—whether caused by cyber-attacks, infrastructure failures, natural disasters, or human error—while maintaining continuity of critical business services within pre-defined impact tolerances. It extends traditional Business Continuity Management and Disaster Recovery by demanding that organisations identify their most important business services, quantify the maximum tolerable disruption for each, and validate end-to-end resilience through realistic scenario testing. Regulatory frameworks such as the Bank of England's Supervisory Statement SS1/21, the EU Digital Operational Resilience Act (DORA), and NIST SP 800-160 Vol. 2 have transformed operational resilience from a best-practice aspiration into a legal compliance obligation. Technically it is realised through layered redundancy, fault-tolerant architectures, chaos engineering disciplines, and automated recovery orchestration."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:incident-response ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:high-availability ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:fault-tolerance ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:disaster-recovery ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:risk-assessment ],
        ngm:resilience ;
    vc:bridgesTo ngm:aiops,
        ngm:distributed-systems ;
    vc:contrastsWith ngm:business-continuity-planning,
        ngm:disaster-recovery ;
    vc:dependsOn ngm:chaos-engineering,
        ngm:monitoring-and-observability,
        ngm:redundancy ;
    vc:enables ngm:business-continuity,
        ngm:regulatory-compliance,
        ngm:service-reliability ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:dora-regulation,
        ngm:iso-22301 ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:compliance-framework,
        ngm:cyber-risk,
        ngm:service-level-agreement,
        ngm:supply-chain-risk,
        ngm:third-party-risk-management ;
    vc:requires ngm:disaster-recovery,
        ngm:fault-tolerance,
        ngm:high-availability,
        ngm:incident-response,
        ngm:risk-assessment ;
    vc:slug "operational-resilience" ;
    vc:sourceDomain "infrastructure" ;
    vc:standardizedBy ngm:iso-27001,
        ngm:nist-cybersecurity-framework .

ngm:owl a owl:Class ;
    rdfs:label "OWL"@en ;
    rdfs:comment "OWL (Web Ontology Language) is a W3C-standardised semantic web language for defining and sharing ontologies on the World Wide Web, built on RDF and grounded in Description Logics to provide formal semantics with decidable reasoning. OWL enables the specification of classes, properties, individuals, and axioms that constrain their relationships, supporting automated inference and knowledge graph construction."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:description-logic ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:rdf ],
        ngm:semantic-web-linked-data-standard ;
    vc:bridgesTo ngm:digital-twin,
        ngm:large-language-model ;
    vc:contrastsWith ngm:json-schema,
        ngm:sql-schema ;
    vc:enables ngm:automated-reasoning,
        ngm:knowledge-graph,
        ngm:knowledge-representation,
        ngm:ontology-alignment,
        ngm:semantic-interoperability ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:implements ngm:description-logic,
        ngm:open-world-assumption ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:gene-ontology,
        ngm:owl-2-web-ontology-language,
        ngm:protege-ontology-editor,
        ngm:snomed-ct ;
    vc:requires ngm:description-logic,
        ngm:rdf,
        ngm:rdfs ;
    vc:slug "owl" ;
    vc:sourceDomain "standards" ;
    vc:standardizedBy ngm:w3c ;
    vc:supports ngm:biomedical-ontology,
        ngm:linked-open-data,
        ngm:neuro-symbolic-ai ;
    vc:uses ngm:sparql,
        ngm:turtle-serialisation,
        ngm:xml .

ngm:paris-agreement a owl:Class ;
    rdfs:label "Paris Agreement"@en ;
    rdfs:comment "The Paris Agreement is a legally binding international treaty on climate change, adopted under the United Nations Framework Convention on Climate Change (UNFCCC) at COP21 in December 2015 and entering into force in November 2016. It establishes a long-term global temperature goal, requiring parties to limit the increase in global average temperature to well below 2 degrees Celsius above pre-industrial levels while pursuing efforts to limit warming to 1.5 degrees Celsius. Each signatory submits Nationally Determined Contributions (NDCs) — self-defined emissions-reduction pledges — subject to a five-year review and ratchet mechanism designed to progressively strengthen ambition. The treaty also creates a transparency framework for monitoring, reporting, and verification, and provisions for climate finance, technology transfer, and capacity building to support developing nations."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:carbon-accounting ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:climate-finance ],
        ngm:infra-legal-and-regulatory ;
    skos:broader ngm:infra-legal-and-regulatory ;
    vc:bridgesTo ngm:digital-mrv,
        ngm:esg-reporting,
        ngm:supply-chain-decarbonisation ;
    vc:contrastsWith ngm:kyoto-protocol ;
    vc:enables ngm:carbon-credits,
        ngm:carbon-offsetting,
        ngm:net-zero-target,
        ngm:voluntary-carbon-market ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:global-stocktake,
        ngm:nationally-determined-contribution,
        ngm:transparency-framework ;
    vc:implements ngm:climate-governance,
        ngm:sustainability ;
    vc:isPartOf ngm:multilateral-environmental-agreement,
        ngm:unfccc ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:cop26,
        ngm:ipcc,
        ngm:just-transition,
        ngm:loss-and-damage,
        ngm:sustainable-development-goals ;
    vc:requires ngm:carbon-accounting,
        ngm:climate-finance,
        ngm:emissions-monitoring ;
    vc:slug "paris-agreement" ;
    vc:sourceDomain "governance" ;
    vc:standardizedBy ngm:conference-of-parties,
        ngm:unfccc .

ngm:performance-optimization a owl:Class ;
    rdfs:label "Performance Optimization"@en ;
    rdfs:comment "Performance optimization is the systematic process of enhancing the efficiency, speed, and effectiveness of software systems by tuning code, algorithms, and resource utilization to minimize response time and maximize throughput. It encompasses profiling to identify bottlenecks, algorithmic improvements, caching strategies, parallel processing, and compiler optimizations to meet defined performance targets."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:observability ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:load-balancing ],
        ngm:optimization-technique ;
    vc:bridgesTo ngm:energy-efficiency,
        ngm:machine-learning-inference-optimization ;
    vc:contrastsWith ngm:premature-optimization ;
    vc:dependsOn ngm:algorithmic-complexity,
        ngm:data-structures,
        ngm:memory-management ;
    vc:enables ngm:high-availability,
        ngm:resource-efficiency,
        ngm:system-scalability,
        ngm:user-experience ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:caching,
        ngm:compiler-optimization,
        ngm:load-balancing,
        ngm:profiling ;
    vc:qualityScore "0.65"^^xsd:float ;
    vc:relatedTo ngm:database-query-optimization,
        ngm:distributed-systems,
        ngm:software-engineering ;
    vc:requires ngm:benchmarking,
        ngm:observability,
        ngm:performance-monitoring ;
    vc:slug "performance-optimization" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:asynchronous-processing,
        ngm:connection-pooling,
        ngm:parallel-processing .

ngm:platform-economy a owl:Class ;
    rdfs:label "Platform Economy"@en ;
    rdfs:comment "The Platform Economy describes an economic model in which digital intermediaries — platforms — create value by facilitating interactions, transactions, and information exchanges between two or more distinct user groups, typically producers and consumers. Platforms achieve scale through network effects: the value of the platform increases with the number of participants on one or both sides, creating winner-take-most market dynamics. Major platform types include transaction platforms (e-commerce, gig labour), innovation platforms (app stores, developer ecosystems), and content platforms (social media, streaming). Platform operators capture value through transaction fees, data monetisation, advertising, and software licences while externalising costs and risks to platform participants."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:digital-infrastructure ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:platform-governance ],
        ngm:digital-platform ;
    vc:bridgesTo ngm:decentralised-finance,
        ngm:tokenised-economy ;
    vc:contrastsWith ngm:decentralised-autonomous-organisation,
        ngm:vertically-integrated-firm ;
    vc:dependsOn ngm:algorithmic-recommendation,
        ngm:data-monetisation ;
    vc:enables ngm:creator-monetization,
        ngm:digital-marketplace,
        ngm:gig-economy,
        ngm:metaverse-platform,
        ngm:nft-marketplace ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:network-effect,
        ngm:platform-governance,
        ngm:two-sided-market ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:antitrust-regulation,
        ngm:digital-markets-act,
        ngm:marketplace ;
    vc:requires ngm:application-programming-interface,
        ngm:digital-infrastructure ;
    vc:slug "platform-economy" ;
    vc:sourceDomain "finance" ;
    vc:supports ngm:creator-economy,
        ngm:marketplace-integration,
        ngm:open-source-software ;
    vc:uses ngm:cloud-computing,
        ngm:platform-layer,
        ngm:platform-service .

ngm:post-processing a owl:Class ;
    rdfs:label "Post Processing"@en ;
    rdfs:comment "Post processing is the stage in a real-time or offline rendering pipeline where image-space operations are applied to the fully rasterised or ray-traced framebuffer before it is displayed or composited. Effects—such as bloom, depth of field, motion blur, tone mapping, colour grading, screen-space ambient occlusion (SSAO), temporal anti-aliasing (TAA), and chromatic aberration—are executed as one or more full-screen shader passes that read from and write back to render targets. By operating in screen space rather than on scene geometry, post processing achieves high visual fidelity at comparatively low computational cost, and has become an indispensable component of game engines, virtual production pipelines, and XR head-mounted display rendering stacks."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:shader ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:render-target ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gpu ],
        ngm:sc-display-and-rendering ;
    skos:broader ngm:sc-display-and-rendering ;
    vc:bridgesTo ngm:machine-learning-supersampling,
        ngm:neural-rendering ;
    vc:contrastsWith ngm:forward-rendering,
        ngm:ray-tracing ;
    vc:dependsOn ngm:g-buffer,
        ngm:rendering-technique ;
    vc:enables ngm:cinematic-rendering,
        ngm:photorealism,
        ngm:visual-fidelity ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:anti-aliasing,
        ngm:bloom,
        ngm:colour-grading,
        ngm:depth-of-field,
        ngm:motion-blur,
        ngm:screen-space-ambient-occlusion,
        ngm:tone-mapping ;
    vc:isPartOf ngm:rendering-pipeline ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:deferred-rendering,
        ngm:high-dynamic-range ;
    vc:requires ngm:framebuffer,
        ngm:gpu,
        ngm:render-target,
        ngm:shader ;
    vc:slug "post-processing" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:virtual-production,
        ngm:visual-effects,
        ngm:xr-rendering ;
    vc:uses ngm:compute-shader,
        ngm:rasterization,
        ngm:texture-sampling .

ngm:preference-learning a owl:Class ;
    rdfs:label "Preference Learning"@en ;
    rdfs:comment "A machine learning paradigm that trains models from comparative human judgements (e.g., 'A is better than B') rather than absolute labels or demonstrations, enabling alignment with human values. Preference learning underpins reinforcement learning from human feedback and direct preference optimisation, and is the standard technique for aligning large language models."@en ;
    rdfs:subClassOf ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:enables ngm:reinforcement-learning-from-human-feedback,
        ngm:reward-model ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:relatedTo ngm:training ;
    vc:slug "preference-learning" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:ai-safety ;
    vc:uses ngm:machine-learning-discipline,
        ngm:reinforcement-learning .

ngm:privacy-preserving-technology a owl:Class ;
    rdfs:label "Privacy Preserving Technology"@en ;
    rdfs:comment "Privacy Preserving Technology (PPT) is the family of cryptographic and computational methods that enable analysis, sharing, and machine learning on sensitive data without exposing raw individual records. Core paradigms include differential privacy (injecting calibrated noise into query outputs), federated learning (training models across distributed silos without centralising data), homomorphic encryption (computing directly on ciphertext), secure multi-party computation (joint computation among mutually distrusting parties), and zero-knowledge proofs (demonstrating a statement's truth without revealing the witness). Together these techniques form the technical foundation for privacy-by-design engineering under regulatory regimes such as GDPR, CCPA, and the EU AI Act, and are increasingly integral to trusted AI pipelines, healthcare analytics, and decentralised identity systems."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:zero-knowledge-proof ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:differential-privacy ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:federated-learning ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:secure-multi-party-computation ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:trusted-execution-environment ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptography ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:homomorphic-encryption ],
        ngm:infra-security-and-identity ;
    skos:broader ngm:infra-security-and-identity ;
    vc:bridgesTo ngm:blockchain,
        ngm:decentralised-data-marketplace,
        ngm:federated-learning,
        ngm:machine-learning-security ;
    vc:contrastsWith ngm:data-anonymisation,
        ngm:pseudonymisation ;
    vc:dependsOn ngm:elliptic-curve-cryptography,
        ngm:noise-mechanisms ;
    vc:enables ngm:confidential-computing,
        ngm:consent-management,
        ngm:decentralised-identity,
        ngm:privacy-by-design ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:differential-privacy,
        ngm:federated-learning,
        ngm:homomorphic-encryption,
        ngm:secure-multi-party-computation,
        ngm:trusted-execution-environment,
        ngm:zero-knowledge-proof ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:biometric-data-protection,
        ngm:eu-ai-act,
        ngm:gdpr ;
    vc:requires ngm:cryptography,
        ngm:public-key-infrastructure ;
    vc:slug "privacy-preserving-technology" ;
    vc:sourceDomain "security" ;
    vc:supports ngm:data-governance,
        ngm:data-minimisation,
        ngm:regulatory-compliance .

