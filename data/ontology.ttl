ngm:data-governance-framework a owl:Class ;
    rdfs:label "Data Governance Framework"@en ;
    rdfs:comment "A Data Governance Framework is a structured set of policies, processes, roles, and standards that define how an organisation acquires, manages, protects, and disposes of data assets throughout their lifecycle. It establishes accountability structures, data quality standards, metadata management practices, and compliance mechanisms aligned to regulatory obligations such as GDPR. Effective frameworks balance centralised oversight with federated data ownership through data mesh and stewardship models. They underpin trustworthy AI deployments by ensuring training data provenance and ongoing monitoring of data quality and lineage."@en ;
    rdfs:subClassOf ngm:data-governance ;
    vc:enables ngm:compliance-monitoring,
        ngm:gdpr-compliance,
        ngm:privacy-and-data-governance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:ai-governance-framework,
        ngm:data-protection,
        ngm:metadata-registry ;
    vc:slug "data-governance-framework" ;
    vc:sourceDomain "governance" ;
    vc:uses ngm:data-mesh,
        ngm:data-pipeline,
        ngm:metadata-management .

ngm:data-persistence a owl:Class ;
    rdfs:label "Data Persistence"@en ;
    rdfs:comment "Data Persistence is the property of data surviving beyond the lifetime of the process, session, or physical medium that created it, encompassing all mechanisms and design patterns — relational databases, distributed file systems, append-only event logs, object stores, and key-value stores — that guarantee this durability. In transactional systems, persistence is formalised through the ACID properties (Atomicity, Consistency, Isolation, Durability), where the Durability guarantee ensures committed transactions survive system failure by means of write-ahead logging and fsync operations. Beyond single-node databases, distributed systems trade aspects of consistency for availability and partition tolerance as described in the CAP theorem and the PACELC model, producing a spectrum of persistence strategies from strongly consistent relational systems to eventually consistent distributed NoSQL stores. The selection of a persistence strategy profoundly shapes a system's fault tolerance, latency, throughput, and operational complexity."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:event-sourcing ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:file-system ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:database-system ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:object-storage ],
        ngm:data-management ;
    vc:bridgesTo ngm:blockchain-ledger,
        ngm:knowledge-graph,
        ngm:vector-database ;
    vc:contrastsWith ngm:eventual-consistency,
        ngm:in-memory-computing,
        ngm:volatile-storage ;
    vc:dependsOn ngm:acid-properties,
        ngm:consensus-algorithm,
        ngm:distributed-system ;
    vc:enables ngm:audit-logging,
        ngm:crash-recovery,
        ngm:data-governance,
        ngm:fault-tolerance ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:database-replication,
        ngm:event-sourcing,
        ngm:object-storage,
        ngm:write-ahead-logging ;
    vc:implements ngm:cap-theorem,
        ngm:pacelc-model ;
    vc:isPartOf ngm:data-management,
        ngm:system-architecture ;
    vc:qualityScore "0.73"^^xsd:float ;
    vc:relatedTo ngm:backup-and-recovery,
        ngm:data-serialisation,
        ngm:distributed-computing,
        ngm:replication-system ;
    vc:requires ngm:database-system,
        ngm:file-system,
        ngm:storage-engine ;
    vc:slug "data-persistence" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:cqrs-pattern,
        ngm:event-driven-architecture,
        ngm:microservices-architecture ;
    vc:uses ngm:b-tree-index,
        ngm:erasure-coding,
        ngm:lsm-tree .

ngm:data-structure a owl:Class ;
    rdfs:label "Data Structure"@en ;
    rdfs:comment "A data structure is an organizational scheme for efficiently storing, accessing, and manipulating data, encompassing arrays, trees, graphs, hash tables, and tensors that underpin algorithmic computation and machine learning systems."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
