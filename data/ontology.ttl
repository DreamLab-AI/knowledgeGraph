        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:security-architecture ],
        ngm:infra-computing-and-cloud ;
    skos:broader ngm:infra-computing-and-cloud ;
    vc:enables ngm:cloud-native-applications,
        ngm:distributed-systems,
        ngm:edge-computing ;
    vc:hasMaturity ngmi:maturity-emerging ;
