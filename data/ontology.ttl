] .

rb:Odometry rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:enables ;
    owl:someValuesFrom rb:Navigation
] .

rb:Odometry rdfs:subClassOf [
    a owl:Restriction ;
