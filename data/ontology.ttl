ngm:convex-finance a owl:Class ;
    rdfs:label "Convex Finance"@en ;
    rdfs:comment "Convex Finance is a decentralised finance (DeFi) protocol built on Ethereum that enables Curve Finance liquidity providers to earn enhanced CRV token rewards without locking their own CRV tokens. By aggregating veCRV voting power from CVX token holders, Convex boosts yield for depositors while distributing governance influence across its community, creating a meta-governance layer above Curve's vote-escrowed tokenomics model. Convex became one of the largest holders of veCRV by 2022, making CVX effectively a proxy for Curve governance influence."@en ;
    rdfs:subClassOf ngm:de-fi-protocol ;
    vc:enables ngm:liquidity-provision,
        ngm:yield-farming,
        ngm:yield-generation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:concentrated-liquidity,
        ngm:decentralized-finance-de-fi,
        ngm:liquidity-mining ;
    vc:slug "convex-finance" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:automated-market-maker,
        ngm:liquidity-pool,
        ngm:smart-contract,
        ngm:token-economics .

ngm:cooling-system a owl:Class ;
    rdfs:label "Cooling System"@en ;
    rdfs:comment "A system that removes heat from equipment to keep it within safe operating temperatures. In computing it covers air, liquid, and immersion methods used in servers and data centres."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:hardware ],
