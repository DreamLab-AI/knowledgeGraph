    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:governance-token,
        ngm:token-economics ;
    vc:requires ngm:automated-market-maker,
        ngm:liquidity-pool ;
    vc:slug "liquidity-mining" ;
    vc:sourceDomain "blockchain" .

ngm:lo-ra a owl:Class ;
    rdfs:label "Lo RA"@en ;
    rdfs:comment "A parameter-efficient fine-tuning mod that freezes pre-trained weights and injects trainable low-rank decomposition matrices into each layer of the transformer, dramatically reducing trainable parameters whilst maintaining performance."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
