        ngm:workflow-automation .

ngm:avalanche-effect a owl:Class ;
    rdfs:label "Avalanche Effect"@en ;
    rdfs:comment "The avalanche effect is a desirable property of cryptographic primitives whereby a tiny change in the input, such as flipping a single bit, produces an extensive, unpredictable change in the output, ideally altering about half of the output bits. In hash functions and ciphers it is the practical expression of diffusion, ensuring that outputs reveal no exploitable correlation with their inputs. A strong avalanche effect is essential for collision and preimage resistance and for resisting differential cryptanalysis."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:cryptographic-hash ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptographic-hash-function ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:hash-function ],
        ngm:cryptography ;
    vc:enables ngm:collision-resistance,
        ngm:preimage-resistance ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:cryptographic-hash ;
    vc:implements ngm:cryptographic-hash-function ;
    vc:isPartOf ngm:cryptography ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:information-security,
        ngm:merkle-tree ;
    vc:requires ngm:cryptographic-hash-function,
        ngm:hash-function ;
    vc:slug "avalanche-effect" ;
    vc:sourceDomain "security" ;
    vc:supports ngm:blockchain-security,
        ngm:digital-signature,
        ngm:encryption ;
    vc:uses ngm:hash-function .

ngm:avionics a owl:Class ;
    rdfs:label "Avionics"@en ;
    rdfs:comment "Avionics refers to the electronic systems used on aircraft and spacecraft for communication, navigation, flight control, monitoring, and mission management. These systems are safety-critical and must meet stringent real-time, reliability, and certification standards such as DO-178C and DO-254. Avionics is a canonical domain for hard real-time computing, where deterministic timing and fault tolerance are essential to flight safety."@en ;
    rdfs:subClassOf ngm:control-system ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:real-time ;
    vc:slug "avionics" ;
    vc:sourceDomain "infrastructure" .

ngm:axelar a owl:Class ;
    rdfs:label "Axelar"@en ;
    rdfs:comment "Axelar is a decentralised cross-chain communication network that enables general message passing and token transfers between heterogeneous blockchains via a proof-of-stake overlay network and a permissionless gateway smart contract model. It provides a Universal Message Passing (UMP) primitive that allows any contract on any connected chain to call any contract on any other connected chain as a single composable operation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:threshold-cryptography ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:validator-set ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:token ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:squid-router ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:smart-contract ],
        ngm:cross-chain-interoperability ;
    vc:bridgesTo ngm:cosmos-ibc,
        ngm:ethereum-smart-contract-platform ;
    vc:contrastsWith ngm:chainlink-ccip,
        ngm:layer-zero,
        ngm:wormhole ;
    vc:dependsOn ngm:byzantine-fault-tolerance,
        ngm:cosmos-sdk ;
    vc:enables ngm:cross-chain-dex,
        ngm:cross-chain-governance,
        ngm:cross-chain-messaging,
