        ngm:cross-platform-interoperability,
        ngm:gl-tf-3-d-file-format,
        ngm:open-usd,
        ngm:open-xr,
        ngm:web-xr-api ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:sc-content-and-assets,
