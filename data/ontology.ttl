ngm:direct-answer-prompting a owl:Class ;
    rdfs:label "Direct Answer Prompting"@en ;
    rdfs:comment "Direct answer prompting is a prompting strategy in which a large language model is instructed to produce a final answer immediately, without showing intermediate reasoning steps. It contrasts with chain-of-thought approaches by optimising for brevity, latency and cost on tasks where extended reasoning offers little benefit. The technique is used when an answer is expected to be retrievable or shallow, trading interpretability and complex-reasoning accuracy for efficiency."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:large-language-model ],
        ngm:prompt-engineering ;
    vc:bridgesTo ngm:in-context-learning ;
    vc:contrastsWith ngm:chain-of-thought-reasoning,
        ngm:standard-prompting ;
    vc:dependsOn ngm:large-language-model ;
    vc:enables ngm:in-context-learning ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:prompt-engineering ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:few-shot-prompting,
        ngm:prompt-template,
        ngm:zero-shot-prompting ;
    vc:requires ngm:large-language-model ;
    vc:slug "direct-answer-prompting" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:natural-language-processing ;
    vc:uses ngm:large-language-model,
        ngm:prompt-template .

ngm:discriminative-model a owl:Class ;
    rdfs:label "Discriminative Model"@en ;
    rdfs:comment "A discriminative model is a class of machine learning model that directly learns the conditional probability of a target label given the observed input, rather than modelling how the data itself is generated. It focuses on the decision boundary that separates classes, which often yields strong predictive accuracy on classification and regression tasks. Discriminative models contrast with generative models, which learn the joint distribution of inputs and outputs."@en ;
    rdfs:subClassOf ngm:supervised-learning ;
    vc:bridgesTo ngm:generative-model ;
    vc:contrastsWith ngm:generative-model ;
    vc:dependsOn ngm:model-training ;
    vc:enables ngm:classification ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:support-vector-machine ;
    vc:isPartOf ngm:machine-learning,
        ngm:supervised-learning ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:deep-learning,
        ngm:neural-network,
        ngm:probabilistic-model ;
    vc:slug "discriminative-model" ;
    vc:sourceDomain "machine-learning" ;
    vc:supports ngm:classification,
        ngm:decision-theory ;
    vc:uses ngm:feature-extraction,
        ngm:maximum-likelihood-estimation .

ngm:disparity-map a owl:Class ;
    rdfs:label "Disparity Map"@en ;
    rdfs:comment "A disparity map is an image in which each pixel encodes the horizontal displacement of corresponding points between the two views of a stereo pair. Because disparity is inversely proportional to scene depth, the map converts directly to a depth map given the camera baseline and focal length. It is the core intermediate product of passive stereo vision, computed by rectifying the images and searching for correspondences along epipolar lines."@en ;
    rdfs:subClassOf ngm:stereo-vision ;
    vc:contrastsWith ngm:lidar ;
    vc:dependsOn ngm:camera-calibration,
        ngm:epipolar-geometry ;
    vc:enables ngm:depth-estimation,
        ngm:depth-map,
        ngm:point-cloud ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:stereo-camera,
        ngm:stereo-vision ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:computer-vision,
        ngm:slam ;
    vc:slug "disparity-map" ;
    vc:sourceDomain "robotics" ;
    vc:supports ngm:perception,
        ngm:visual-perception ;
    vc:uses ngm:feature-matching,
        ngm:image-processing .

ngm:distributed-file-system a owl:Class ;
    rdfs:label "Distributed File System"@en ;
    rdfs:comment "A distributed file system presents a unified file or namespace interface over storage that is physically spread across many networked machines. It transparently handles data placement, replication, fault tolerance, and concurrent access so that clients interact with remote, partitioned storage much as they would with a local file system. Such systems scale capacity and throughput beyond a single node while tolerating individual machine failures."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-replication ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:data-replication ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:fault-tolerance ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:file-system ],
        ngm:distributed-systems ;
    vc:bridgesTo ngm:ipfs,
        ngm:object-storage ;
    vc:contrastsWith ngm:file-system ;
    vc:dependsOn ngm:distributed-systems ;
    vc:enables ngm:object-storage ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:data-replication,
        ngm:file-system ;
    vc:isPartOf ngm:distributed-systems ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:ceph,
        ngm:ipfs,
        ngm:object-storage ;
