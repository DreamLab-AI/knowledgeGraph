        ngm:physics-simulation,
        ngm:procedural-animation .

ngm:ai-lifecycle a owl:Class ;
    rdfs:label "AI Lifecycle"@en ;
    rdfs:comment "The series of distinct phases through which an artificial intelligence system progresses from initial conception to eventual decommissioning, encompassing planning, design, development, verification, deployment, operation, monitoring, maintenance, and retirement, with each phase involving specific activities, stakeholder roles, documentation requirements, and governance controls to ensure responsible and effective AI system management."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:ai-monitoring ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:ai-deployment ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:ai-development ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:human-oversight ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-governance ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:risk-management ],
        ngm:ai-governance ;
    vc:bridgesTo ngm:fda-software-as-medical-device,
        ngm:update-cycle ;
    vc:contrastsWith ngm:software-development-lifecycle ;
    vc:dependsOn ngm:ai-impact-assessment,
        ngm:version-control ;
    vc:enables ngm:ai-accountability,
        ngm:model-performance,
        ngm:regulatory-compliance ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:ai-decommissioning,
        ngm:ai-deployment,
        ngm:ai-development,
        ngm:ai-monitoring,
        ngm:model-validation ;
    vc:implements ngm:mlops ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:continuous-integration,
        ngm:model-drift ;
    vc:requires ngm:data-governance,
        ngm:human-oversight,
        ngm:risk-management,
        ngm:stakeholder-engagement-throughout ;
    vc:slug "ai-lifecycle" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:standardizedBy ngm:iso-iec-23053,
        ngm:iso-iec-42001-2023,
        ngm:iso-iec-5338-2023,
        ngm:nist-ai-risk-management-framework ;
    vc:supports ngm:ai-governance,
        ngm:responsible-ai ;
    vc:uses ngm:ai-agent-system .

ngm:ai-monitoring a owl:Class ;
    rdfs:label "AI Monitoring"@en ;
    rdfs:comment "The systematic and ongoing observation, measurement, and analysis of an artificial intelligence system's behaviour, performance, inputs, outputs, and impacts during operational use, employing automated tools and human oversight to detect degradation, anomalies, bias, safety issues, or unintended consequences, enabling timely intervention, maintenance, and continuous improvement whilst ensuring accountability and compliance with governance requirements."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:monitoring-infrastructure ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:anomaly-detection ],
        ngm:ai-lifecycle ;
    vc:bridgesTo ngm:ai-agent-system,
        ngm:data-drift ;
    vc:contrastsWith ngm:ai-audit,
        ngm:static-testing ;
    vc:dependsOn ngm:ai-deployment,
        ngm:model-performance ;
    vc:enables ngm:ai-maintenance,
        ngm:continuous-improvement,
        ngm:human-oversight,
        ngm:incident-response,
        ngm:model-updating ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:anomaly-detection,
        ngm:data-drift-detection,
        ngm:fairness-monitoring,
        ngm:performance-monitoring ;
    vc:isPartOf ngm:ai-governance,
        ngm:ai-lifecycle ;
    vc:qualityScore "0.65"^^xsd:float ;
    vc:relatedTo ngm:ai-operator,
        ngm:explainability,
        ngm:model-retraining ;
    vc:requires ngm:alert-thresholds,
        ngm:baseline-metrics,
