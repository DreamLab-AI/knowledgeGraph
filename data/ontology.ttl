ngm:cat-ai-infrastructure a owl:Class,
        skos:Concept ;
    rdfs:label "AI Infrastructure"@en ;
    rdfs:comment "Intermediate category of the Artificial Intelligence domain covering the compute, data, tooling, and platform infrastructure that supports training, fine-tuning, serving, and orchestration of machine-learning and foundation-model systems — including accelerators, distributed-training frameworks, model registries, and inference platforms."@en ;
    rdfs:subClassOf ngm:artificial-intelligence ;
    skos:broader ngm:artificial-intelligence ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.85"^^xsd:float ;
    vc:slug "cat-ai-infrastructure" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:causal-language-modelling a owl:Class ;
    rdfs:label "Causal Language Modelling"@en ;
    rdfs:comment "Causal language modelling is a self-supervised pre-training objective in which a neural network learns to predict the next token in a sequence given all preceding tokens, modelling the joint probability of text as an autoregressive product of conditional distributions. The term 'causal' refers to the unidirectional (left-to-right) attention mask that enforces the temporal ordering of tokens, preventing the model from attending to future context. This objective is the foundation of decoder-only transformer architectures such as GPT, LLaMA, and Claude, which power the majority of state-of-the-art large language models."@en ;
    rdfs:subClassOf ngm:large-language-model-training ;
    vc:enables ngm:chain-of-thought-prompting,
        ngm:gpt,
        ngm:large-language-models ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:in-context-learning,
        ngm:instruction-tuning ;
    vc:slug "causal-language-modelling" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:attention-mechanism,
        ngm:causal-attention .

ngm:central-limit-theorem a owl:Class ;
    rdfs:label "Central Limit Theorem"@en ;
    rdfs:comment "The Central Limit Theorem states that, under broad conditions, the distribution of the sum or mean of a large number of independent, identically distributed random variables approaches a normal distribution regardless of the underlying distribution's shape. It explains the ubiquity of the Gaussian distribution and provides the theoretical basis for many inferential procedures, including confidence intervals and significance tests. It is foundational to statistics, machine learning, and Monte Carlo estimation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:inference ],
        ngm:probability-theory ;
    vc:dependsOn ngm:probability-theory,
        ngm:sampling ;
    vc:enables ngm:bayesian-inference,
        ngm:statistical-analysis,
        ngm:statistical-testing ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:inference ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:data-analysis,
        ngm:machine-learning,
        ngm:probability-theory,
        ngm:uncertainty-quantification ;
    vc:slug "central-limit-theorem" ;
    vc:sourceDomain "machine-learning" ;
    vc:supports ngm:monte-carlo-integration,
        ngm:monte-carlo-simulation ;
    vc:uses ngm:gaussian-distribution,
        ngm:statistics .

ngm:central-securities-depository a owl:Class ;
    rdfs:label "Central Securities Depository"@en ;
    rdfs:comment "A central securities depository (CSD) is a financial market infrastructure that holds securities in dematerialised or immobilised form and enables their transfer through book-entry, providing safekeeping and settlement of trades. It maintains the authoritative record of securities ownership and supports the final leg of post-trade processing, often in conjunction with clearing houses. By centralising custody and settlement, a CSD reduces operational risk and is foundational to the integrity of securities markets."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:custody ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:settlement-finality ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:securities-settlement ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:custody ],
        ngm:financial-market-infrastructure ;
    vc:bridgesTo ngm:blockchain ;
    vc:contrastsWith ngm:blockchain ;
    vc:dependsOn ngm:clearing-and-settlement,
        ngm:settlement ;
    vc:enables ngm:atomic-settlement,
        ngm:delivery-versus-payment ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:custody,
        ngm:securities-settlement ;
    vc:isPartOf ngm:financial-market-infrastructure ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:netting,
        ngm:trade-execution ;
    vc:requires ngm:custody,
        ngm:settlement-finality ;
    vc:slug "central-securities-depository" ;
    vc:sourceDomain "finance" ;
    vc:supports ngm:settlement ;
    vc:uses ngm:settlement .

ngm:centralised-governance a owl:Class ;
    rdfs:label "Centralised Governance"@en ;
    rdfs:comment "Centralised governance is a model in which decision-making authority over a system, protocol, or organisation is concentrated in a single entity or a small controlling group. In contrast to distributed models, changes, upgrades, and policy are determined by this authority rather than by broad stakeholder consensus, which can deliver faster, more decisive action at the cost of reduced censorship resistance and a single point of control. It is the conventional baseline against which decentralised governance defines itself."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:access-control ],
        ngm:decentralised-governance ;
    vc:contrastsWith ngm:dao,
        ngm:decentralisation,
        ngm:decentralised-governance ;
    vc:enables ngm:audit,
        ngm:compliance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:governance ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:corporate-governance,
        ngm:governance,
        ngm:regulatory-compliance ;
    vc:requires ngm:access-control ;
    vc:slug "centralised-governance" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:financial-services .

ngm:chunking a owl:Class ;
    rdfs:label "Chunking"@en ;
    rdfs:comment "Chunking is the process of segmenting source documents into smaller, semantically coherent passages before they are embedded and indexed for retrieval-augmented generation. Strategies range from fixed-size and overlapping windows to recursive, sentence-aware, and semantic chunking that respects document structure. It matters because chunk size and boundaries directly govern retrieval precision and the relevance of context supplied to a language model, making chunking a primary lever for RAG quality."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:embedding-model ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:tokeniser ],
        ngm:information-retrieval ;
    vc:contrastsWith ngm:fine-tuning,
        ngm:full-document-indexing ;
    vc:dependsOn ngm:rag-pipeline,
        ngm:vector-database ;
    vc:enables ngm:dense-retrieval,
        ngm:hallucination-reduction,
        ngm:retrieval-augmented-generation,
        ngm:semantic-search ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:chunk-boundary,
        ngm:chunk-metadata,
        ngm:chunk-overlap ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:context-window,
        ngm:gpts-and-custom-assistants,
        ngm:information-extraction,
        ngm:knowledge-graph,
        ngm:rag-pipeline ;
    vc:requires ngm:document-parser,
        ngm:embedding-model,
        ngm:tokeniser ;
    vc:slug "chunking" ;
    vc:sourceDomain "ai" ;
    vc:supports ngm:enterprise-search,
        ngm:question-answering,
        ngm:source-attribution ;
    vc:uses ngm:large-language-models,
        ngm:natural-language-processing,
        ngm:sentence-transformers .

ngm:ci-cd-automation a owl:Class ;
    rdfs:label "CI-CD Automation"@en ;
    rdfs:comment "Continuous integration and continuous delivery (CI/CD) automation is the practice of automatically building, testing, and deploying software changes through a defined pipeline triggered by source-control events. Continuous integration merges and validates changes frequently to detect defects early; continuous delivery extends this to produce always-deployable artefacts, while continuous deployment automates release to production. CI/CD automation reduces integration risk, shortens feedback loops, and makes deployments repeatable and auditable. It is implemented through pipeline-as-code definitions executed by orchestrators such as GitHub Actions, GitLab CI, and Jenkins."@en ;
    rdfs:subClassOf ngm:automation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.78"^^xsd:float ;
    vc:relatedTo ngm:model-deployment,
        ngm:software-engineering ;
    vc:slug "ci-cd-automation" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:data-pipeline .

ngm:claude a owl:Class ;
    rdfs:label "Claude"@en ;
    rdfs:comment "Claude is a family of large language model AI assistants developed by Anthropic, trained using Constitutional AI and reinforcement learning from human feedback to be helpful, harmless, and honest. The Claude model family encompasses tiered variants (Haiku, Sonnet, and Opus) spanning cost-performance trade-offs, with support for extended context windows, multimodal inputs, tool use, and agentic workflows via the Model Context Protocol. Claude embodies Anthropic's research programme on aligning advanced AI systems with human values, serving as both a commercial API product and a living demonstration that safety and capability are complementary rather than opposed. The model family has evolved through multiple generations, with each iteration advancing state-of-the-art performance on reasoning, coding, and instruction-following benchmarks whilst maintaining rigorous safety evaluation."@en ;
    rdfs:subClassOf ngm:large-language-model ;
    vc:bridgesTo ngm:enterprise-software-integration,
        ngm:workflow-automation ;
