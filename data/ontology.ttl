    vcw:owlRole "Concept" .

# Constitutional AI
artificial-intelligence:ConstitutionalAI rdf:type owl:Class ;
    rdfs:label "Constitutional AI"@en ;
    rdfs:comment "A method for training AI assistants to be harmless through self-improvement, using a set of principles or \"constitution\" to guide behaviour without human labels for harmful outputs. Constitutional AI combines supervised learning for self-critiques and revisions with RL from AI Feedback (RLAIF)."@en ;
    skos:prefLabel "Constitutional AI"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:artificial-intelligence:constitutional-ai" ;
    owl:sameAs <urn:visionclaw:concept:artificial-intelligence:constitutional-ai> ;
    vcw:contentHash "sha256-12-88b6d4b42d37" ;
    vcw:qualityScore "0.5"^^xsd:decimal ;
    vcw:legacyTermId "AI-0267" ;
    vcw:ontologyStatus "draft" ;
    vcw:maturityLevel "draft" ;
    vcw:authorityScore "0.0"^^xsd:decimal ;
    dcterms:identifier "AI-0267" ;
    dcterms:subject "artificial-intelligence" ;
    owl:versionInfo "2.0.0" ;
    dcterms:created "2026-04-26T00:00:00Z"^^xsd:dateTime ;
    dcterms:modified "2026-04-26T13:00:00Z"^^xsd:dateTime ;
    vcw:owlRole "Concept" .

artificial-intelligence:ConstitutionalAI vcw:bridgesTo artificial-intelligence:ComputerVision .

# AI Alignment
artificial-intelligence:AIAlignment rdf:type owl:Class ;
    rdfs:label "AI Alignment"@en ;
    rdfs:comment "The process of making AI systems' behaviour and goals consistent with human values, preferences, and intentions. AI alignment encompasses technical methods and research aimed at ensuring AI systems act in accordance with human interests, even as they become more capable."@en ;
    skos:prefLabel "AI Alignment"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:artificial-intelligence:ai-alignment" ;
    owl:sameAs <urn:visionclaw:concept:artificial-intelligence:ai-alignment> ;
    vcw:contentHash "sha256-12-61af96c6c433" ;
    vcw:qualityScore "0.5"^^xsd:decimal ;
    vcw:legacyTermId "AI-0268" ;
    vcw:ontologyStatus "draft" ;
    vcw:maturityLevel "draft" ;
    vcw:authorityScore "0.0"^^xsd:decimal ;
    dcterms:identifier "AI-0268" ;
    dcterms:subject "artificial-intelligence" ;
    owl:versionInfo "2.0.0" ;
    dcterms:created "2026-04-26T00:00:00Z"^^xsd:dateTime ;
    dcterms:modified "2026-04-26T13:00:00Z"^^xsd:dateTime ;
    vcw:owlRole "Concept" .

artificial-intelligence:AIAlignment vcw:bridgesTo artificial-intelligence:AIAgentSystem .

# Value Alignment
artificial-intelligence:ValueAlignment rdf:type owl:Class ;
    rdfs:label "Value Alignment"@en ;
    rdfs:comment "The challenge and process of ensuring AI systems pursue objectives that align with human values, even as those systems become more capable and autonomous. Value alignment addresses both technical and philosophical questions about encoding human preferences into AI behaviour."@en ;
    skos:prefLabel "Value Alignment"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:artificial-intelligence:value-alignment" ;
    owl:sameAs <urn:visionclaw:concept:artificial-intelligence:value-alignment> ;
    vcw:contentHash "sha256-12-3ba7d82db558" ;
    vcw:qualityScore "0.5"^^xsd:decimal ;
    vcw:legacyTermId "AI-0269" ;
    vcw:ontologyStatus "draft" ;
    vcw:maturityLevel "draft" ;
    vcw:authorityScore "0.0"^^xsd:decimal ;
    dcterms:identifier "AI-0269" ;
    dcterms:subject "artificial-intelligence" ;
    owl:versionInfo "2.0.0" ;
    dcterms:created "2026-04-26T00:00:00Z"^^xsd:dateTime ;
    dcterms:modified "2026-04-26T13:00:00Z"^^xsd:dateTime ;
    vcw:owlRole "Concept" .

# Red Teaming
spatial-computing:RedTeaming rdf:type owl:Class ;
    rdfs:label "Red Teaming"@en ;
    rdfs:comment "The practice of deliberately attempting to elicit harmful, biased, or undesired outputs from AI systems to identify vulnerabilities and weaknesses. Red teaming involves adversarial testing where human evaluators or automated systems probe for failure modes, informing alignment training and safety improvements."@en ;
    skos:prefLabel "Red Teaming"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:spatial-computing:red-teaming" ;
    owl:sameAs <urn:visionclaw:concept:spatial-computing:red-teaming> ;
    vcw:contentHash "sha256-12-0ede76daed48" ;
    vcw:qualityScore "0.5"^^xsd:decimal ;
    vcw:legacyTermId "AI-0270" ;
    vcw:ontologyStatus "draft" ;
    vcw:maturityLevel "draft" ;
    vcw:authorityScore "0.0"^^xsd:decimal ;
    dcterms:identifier "AI-0270" ;
    dcterms:subject "spatial-computing" ;
    owl:versionInfo "2.0.0" ;
    dcterms:created "2026-04-26T00:00:00Z"^^xsd:dateTime ;
    dcterms:modified "2026-04-26T13:00:00Z"^^xsd:dateTime ;
    vcw:owlRole "Concept" .

# Adversarial Testing
artificial-intelligence:AdversarialTesting rdf:type owl:Class ;
    rdfs:label "Adversarial Testing"@en ;
    rdfs:comment "Testing methodology that deliberately attempts to cause AI system failures through adversarial inputs, edge cases, and challenging scenarios. Adversarial testing helps identify robustness issues, safety vulnerabilities, and alignment failures before deployment."@en ;
    skos:prefLabel "Adversarial Testing"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:artificial-intelligence:adversarial-testing" ;
    owl:sameAs <urn:visionclaw:concept:artificial-intelligence:adversarial-testing> ;
    vcw:contentHash "sha256-12-f58d91c833bc" ;
    vcw:qualityScore "0.5"^^xsd:decimal ;
    vcw:legacyTermId "AI-0271" ;
    vcw:ontologyStatus "draft" ;
    vcw:maturityLevel "draft" ;
    vcw:authorityScore "0.0"^^xsd:decimal ;
    dcterms:identifier "AI-0271" ;
    dcterms:subject "artificial-intelligence" ;
    owl:versionInfo "2.0.0" ;
    dcterms:created "2026-04-26T00:00:00Z"^^xsd:dateTime ;
    dcterms:modified "2026-04-26T20:12:53Z"^^xsd:dateTime ;
    vcw:owlRole "Concept" .

artificial-intelligence:AdversarialTesting vcw:bridgesTo artificial-intelligence:DigitalTwin .

# Safety Fine Tuning
spatial-computing:SafetyFineTuning rdf:type owl:Class ;
    rdfs:label "Safety Fine Tuning"@en ;
    rdfs:comment "Fine-tuning specifically aimed at improving AI system safety, reducing harmful outputs, and enhancing alignment with safety principles. Safety fine-tuning typically follows general capability training and uses safety-focused datasets and objectives."@en ;
    skos:prefLabel "Safety Fine Tuning"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:spatial-computing:safety-fine-tuning" ;
    owl:sameAs <urn:visionclaw:concept:spatial-computing:safety-fine-tuning> ;
    vcw:contentHash "sha256-12-b7e00967414b" ;
    vcw:qualityScore "0.5"^^xsd:decimal ;
    vcw:legacyTermId "AI-0272" ;
    vcw:ontologyStatus "draft" ;
    vcw:maturityLevel "draft" ;
    vcw:authorityScore "0.0"^^xsd:decimal ;
    dcterms:identifier "AI-0272" ;
    dcterms:subject "spatial-computing" ;
    owl:versionInfo "2.0.0" ;
    dcterms:created "2026-04-26T00:00:00Z"^^xsd:dateTime ;
    dcterms:modified "2026-04-26T13:00:00Z"^^xsd:dateTime ;
    vcw:owlRole "Concept" .

# Harmlessness
spatial-computing:Harmlessness rdf:type owl:Class ;
    rdfs:label "Harmlessness"@en ;
    rdfs:comment "An alignment objective ensuring AI systems avoid generating outputs that could cause harm, including toxic, dangerous, misleading, or unethical content. Harmlessness represents a key dimension of AI safety alongside helpfulness and honesty."@en ;
    skos:prefLabel "Harmlessness"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:spatial-computing:harmlessness" ;
    owl:sameAs <urn:visionclaw:concept:spatial-computing:harmlessness> ;
    vcw:contentHash "sha256-12-392478124cb8" ;
    vcw:qualityScore "0.5"^^xsd:decimal ;
    vcw:legacyTermId "AI-0273" ;
    vcw:ontologyStatus "draft" ;
    vcw:maturityLevel "draft" ;
    vcw:authorityScore "0.0"^^xsd:decimal ;
    dcterms:identifier "AI-0273" ;
    dcterms:subject "spatial-computing" ;
    owl:versionInfo "2.0.0" ;
    dcterms:created "2026-04-26T00:00:00Z"^^xsd:dateTime ;
    dcterms:modified "2026-04-26T13:00:00Z"^^xsd:dateTime ;
    vcw:owlRole "Concept" .

# Helpfulness
spatial-computing:Helpfulness rdf:type owl:Class ;
    rdfs:label "Helpfulness"@en ;
    rdfs:comment "An alignment objective ensuring AI systems provide useful, relevant, and informative responses to user queries. Helpfulness represents a key dimension of AI utility that must be balanced against harmlessness and honesty."@en ;
    skos:prefLabel "Helpfulness"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:spatial-computing:helpfulness" ;
    owl:sameAs <urn:visionclaw:concept:spatial-computing:helpfulness> ;
    vcw:contentHash "sha256-12-b57a7f753661" ;
    vcw:qualityScore "0.5"^^xsd:decimal ;
    vcw:legacyTermId "AI-0274" ;
    vcw:ontologyStatus "draft" ;
    vcw:maturityLevel "draft" ;
    vcw:authorityScore "0.0"^^xsd:decimal ;
    dcterms:identifier "AI-0274" ;
    dcterms:subject "spatial-computing" ;
    owl:versionInfo "2.0.0" ;
    dcterms:created "2026-04-26T00:00:00Z"^^xsd:dateTime ;
    dcterms:modified "2026-04-26T13:00:00Z"^^xsd:dateTime ;
    vcw:owlRole "Concept" .

# Honesty
spatial-computing:Honesty rdf:type owl:Class ;
    rdfs:label "Honesty"@en ;
    rdfs:comment "An alignment objective ensuring AI systems provide truthful and accurate information, avoiding false claims and acknowledging uncertainty when appropriate. Honesty (also called truthfulness) represents a critical dimension of trustworthy AI alongside helpfulness and harmlessness."@en ;
    skos:prefLabel "Honesty"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:spatial-computing:honesty" ;
    owl:sameAs <urn:visionclaw:concept:spatial-computing:honesty> ;
    vcw:contentHash "sha256-12-3a183a4b6aef" ;
    vcw:qualityScore "0.5"^^xsd:decimal ;
    vcw:legacyTermId "AI-0275" ;
    vcw:ontologyStatus "draft" ;
    vcw:maturityLevel "draft" ;
    vcw:authorityScore "0.0"^^xsd:decimal ;
    dcterms:identifier "AI-0275" ;
    dcterms:subject "spatial-computing" ;
    owl:versionInfo "2.0.0" ;
    dcterms:created "2026-04-26T00:00:00Z"^^xsd:dateTime ;
    dcterms:modified "2026-04-26T13:00:00Z"^^xsd:dateTime ;
    vcw:owlRole "Concept" .

# Mixture of Experts
spatial-computing:MixtureofExperts rdf:type owl:Class ;
    rdfs:label "Mixture of Experts"@en ;
    rdfs:comment "An architecture that uses multiple specialised sub-networks (experts) with a gating mechanism that routes inputs to a sparse subset of experts, enabling scaling without proportional compute increases. MoE is adopted in production LLMs like GPT-4, enabling massive scale with controlled costs."@en ;
    skos:prefLabel "Mixture of Experts"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:spatial-computing:mixture-of-experts" ;
    owl:sameAs <urn:visionclaw:concept:spatial-computing:mixture-of-experts> ;
    vcw:contentHash "sha256-12-5287acf61b47" ;
    vcw:qualityScore "0.5"^^xsd:decimal ;
    vcw:legacyTermId "AI-0276" ;
    vcw:ontologyStatus "draft" ;
    vcw:maturityLevel "draft" ;
    vcw:authorityScore "0.0"^^xsd:decimal ;
    dcterms:identifier "AI-0276" ;
    dcterms:subject "spatial-computing" ;
    owl:versionInfo "2.0.0" ;
    dcterms:created "2026-04-26T00:00:00Z"^^xsd:dateTime ;
    dcterms:modified "2026-04-26T13:00:00Z"^^xsd:dateTime ;
    vcw:owlRole "Concept" .

# Sparse Mixture of Experts
spatial-computing:SparseMixtureofExperts rdf:type owl:Class ;
    rdfs:label "Sparse Mixture of Experts"@en ;
    rdfs:comment "An MoE variant with a trainable gating network that selects only a sparse combination of experts for each example, dramatically increasing model capacity whilst maintaining computational efficiency. Sparsely-gated MoE enables models with up to 137 billion parameters with manageable inference costs."@en ;
    skos:prefLabel "Sparse Mixture of Experts"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:spatial-computing:sparse-mixture-of-experts" ;
    owl:sameAs <urn:visionclaw:concept:spatial-computing:sparse-mixture-of-experts> ;
    vcw:contentHash "sha256-12-c1541e83dce5" ;
    vcw:qualityScore "0.5"^^xsd:decimal ;
    vcw:legacyTermId "AI-0277" ;
    vcw:ontologyStatus "draft" ;
    vcw:maturityLevel "draft" ;
    vcw:authorityScore "0.0"^^xsd:decimal ;
    dcterms:identifier "AI-0277" ;
    dcterms:subject "spatial-computing" ;
    owl:versionInfo "2.0.0" ;
    dcterms:created "2026-04-26T00:00:00Z"^^xsd:dateTime ;
    dcterms:modified "2026-04-26T13:00:00Z"^^xsd:dateTime ;
    vcw:owlRole "Concept" .

# Model Ensembling
artificial-intelligence:ModelEnsembling rdf:type owl:Class ;
    rdfs:label "Model Ensembling"@en ;
    rdfs:comment "A technique that combines predictions from multiple independently trained models to improve overall performance and robustness. Ensembling leverages diversity among models to reduce variance, improve generalisation, and provide more reliable predictions."@en ;
    skos:prefLabel "Model Ensembling"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:artificial-intelligence:model-ensembling" ;
    owl:sameAs <urn:visionclaw:concept:artificial-intelligence:model-ensembling> ;
    vcw:contentHash "sha256-12-cc53cb066a28" ;
    vcw:qualityScore "0.5"^^xsd:decimal ;
    vcw:legacyTermId "AI-0278" ;
    vcw:ontologyStatus "draft" ;
    vcw:maturityLevel "draft" ;
    vcw:authorityScore "0.0"^^xsd:decimal ;
    dcterms:identifier "AI-0278" ;
    dcterms:subject "artificial-intelligence" ;
    owl:versionInfo "2.0.0" ;
    dcterms:created "2026-04-26T00:00:00Z"^^xsd:dateTime ;
    dcterms:modified "2026-04-26T13:00:00Z"^^xsd:dateTime ;
    vcw:owlRole "Concept" .

# Knowledge Distillation
artificial-intelligence:KnowledgeDistillation rdf:type owl:Class ;
    rdfs:label "Knowledge Distillation"@en ;
    rdfs:comment "A model compression technique where a smaller \"student\" model is trained to mimic the behaviour of a larger \"teacher\" model, transferring knowledge through soft targets. Knowledge distillation enables simple student networks with few parameters to achieve comparable performance to deep teacher networks."@en ;
    skos:prefLabel "Knowledge Distillation"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:artificial-intelligence:knowledge-distillation" ;
    owl:sameAs <urn:visionclaw:concept:artificial-intelligence:knowledge-distillation> ;
    vcw:contentHash "sha256-12-92cc670300a8" ;
    vcw:qualityScore "0.5"^^xsd:decimal ;
    vcw:legacyTermId "AI-0279" ;
    vcw:ontologyStatus "draft" ;
    vcw:maturityLevel "draft" ;
    vcw:authorityScore "0.0"^^xsd:decimal ;
    dcterms:identifier "AI-0279" ;
    dcterms:subject "artificial-intelligence" ;
    owl:versionInfo "2.0.0" ;
    dcterms:created "2026-04-26T00:00:00Z"^^xsd:dateTime ;
    dcterms:modified "2026-04-26T13:00:00Z"^^xsd:dateTime ;
    vcw:owlRole "Concept" .

# Teacher Student Training
artificial-intelligence:TeacherStudentTraining rdf:type owl:Class ;
    rdfs:label "Teacher Student Training"@en ;
    rdfs:comment "A training paradigm where a larger, more capable \"teacher\" model guides the training of a smaller \"student\" model. Teacher-student training transfers knowledge from the teacher's learned representations or predictions to improve student model performance."@en ;
    skos:prefLabel "Teacher Student Training"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:artificial-intelligence:teacher-student-training" ;
    owl:sameAs <urn:visionclaw:concept:artificial-intelligence:teacher-student-training> ;
    vcw:contentHash "sha256-12-02a95a6d3c5d" ;
    vcw:qualityScore "0.5"^^xsd:decimal ;
    vcw:legacyTermId "AI-0280" ;
    vcw:ontologyStatus "draft" ;
    vcw:maturityLevel "draft" ;
    vcw:authorityScore "0.0"^^xsd:decimal ;
    dcterms:identifier "AI-0280" ;
    dcterms:subject "artificial-intelligence" ;
    owl:versionInfo "2.0.0" ;
    dcterms:created "2026-04-26T00:00:00Z"^^xsd:dateTime ;
    dcterms:modified "2026-04-26T13:00:00Z"^^xsd:dateTime ;
    vcw:owlRole "Concept" .

artificial-intelligence:TeacherStudentTraining vcw:bridgesTo artificial-intelligence:ComputerVision .

# Self Training
artificial-intelligence:SelfTraining rdf:type owl:Class ;
    rdfs:label "Self Training"@en ;
    rdfs:comment "A semi-supervised learning technique where a model is iteratively improved by training on its own high-confidence predictions on unlabelled data. Self-training enables learning from large amounts of unlabelled data by using the model's own predictions as pseudo-labels."@en ;
    skos:prefLabel "Self Training"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:artificial-intelligence:self-training" ;
    owl:sameAs <urn:visionclaw:concept:artificial-intelligence:self-training> ;
    vcw:contentHash "sha256-12-26eda5d0aca7" ;
    vcw:qualityScore "0.5"^^xsd:decimal ;
    vcw:legacyTermId "AI-0281" ;
    vcw:ontologyStatus "draft" ;
    vcw:maturityLevel "draft" ;
    vcw:authorityScore "0.0"^^xsd:decimal ;
    dcterms:identifier "AI-0281" ;
    dcterms:subject "artificial-intelligence" ;
    owl:versionInfo "2.0.0" ;
    dcterms:created "2026-04-26T00:00:00Z"^^xsd:dateTime ;
    dcterms:modified "2026-04-26T13:00:00Z"^^xsd:dateTime ;
    vcw:owlRole "Concept" .

# Co Training
artificial-intelligence:CoTraining rdf:type owl:Class ;
    rdfs:label "Co Training"@en ;
    rdfs:comment "A semi-supervised learning technique where two or more models with different views of the data train each other by labelling unlabelled examples. Co-training leverages complementary feature sets or model architectures to improve performance through mutual teaching."@en ;
    skos:prefLabel "Co Training"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:artificial-intelligence:co-training" ;
    owl:sameAs <urn:visionclaw:concept:artificial-intelligence:co-training> ;
    vcw:contentHash "sha256-12-4985275b6154" ;
    vcw:qualityScore "0.5"^^xsd:decimal ;
    vcw:legacyTermId "AI-0282" ;
    vcw:ontologyStatus "draft" ;
    vcw:maturityLevel "draft" ;
    vcw:authorityScore "0.0"^^xsd:decimal ;
    dcterms:identifier "AI-0282" ;
    dcterms:subject "artificial-intelligence" ;
    owl:versionInfo "2.0.0" ;
    dcterms:created "2026-04-26T00:00:00Z"^^xsd:dateTime ;
    dcterms:modified "2026-04-26T17:00:00Z"^^xsd:dateTime ;
    vcw:owlRole "Concept" .

# Contrastive Learning
spatial-computing:ContrastiveLearning rdf:type owl:Class ;
    rdfs:label "Contrastive Learning"@en ;
    rdfs:comment "A self-supervised learning approach that learns representations by contrasting positive pairs (similar samples) against negative pairs (dissimilar samples). Contrastive learning enables models to learn powerful representations without explicit labels by pushing similar examples together and dissimilar ones apart in embedding space."@en ;
    skos:prefLabel "Contrastive Learning"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:spatial-computing:contrastive-learning" ;
    owl:sameAs <urn:visionclaw:concept:spatial-computing:contrastive-learning> ;
    vcw:contentHash "sha256-12-01791667a606" ;
    vcw:qualityScore "0.5"^^xsd:decimal ;
    vcw:legacyTermId "AI-0283" ;
    vcw:ontologyStatus "draft" ;
    vcw:maturityLevel "draft" ;
    vcw:authorityScore "0.0"^^xsd:decimal ;
    dcterms:identifier "AI-0283" ;
    dcterms:subject "spatial-computing" ;
    owl:versionInfo "2.0.0" ;
    dcterms:created "2026-04-26T00:00:00Z"^^xsd:dateTime ;
    dcterms:modified "2026-04-26T13:00:00Z"^^xsd:dateTime ;
    vcw:owlRole "Concept" .

spatial-computing:ContrastiveLearning vcw:bridgesTo spatial-computing:ComputerVision .

# Momentum Contrast
spatial-computing:MomentumContrast rdf:type owl:Class ;
    rdfs:label "Momentum Contrast"@en ;
    rdfs:comment "A contrastive learning framework that maintains a large and consistent dictionary of encoded samples using a momentum-updated encoder, enabling effective contrastive learning with many negatives. MoCo provides stable comparison targets through the momentum encoder."@en ;
    skos:prefLabel "Momentum Contrast"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:spatial-computing:momentum-contrast" ;
    owl:sameAs <urn:visionclaw:concept:spatial-computing:momentum-contrast> ;
    vcw:contentHash "sha256-12-2a5063421efd" ;
    vcw:qualityScore "0.5"^^xsd:decimal ;
    vcw:legacyTermId "AI-0284" ;
    vcw:ontologyStatus "draft" ;
    vcw:maturityLevel "draft" ;
    vcw:authorityScore "0.0"^^xsd:decimal ;
    dcterms:identifier "AI-0284" ;
    dcterms:subject "spatial-computing" ;
    owl:versionInfo "2.0.0" ;
    dcterms:created "2026-04-26T00:00:00Z"^^xsd:dateTime ;
    dcterms:modified "2026-04-26T13:00:00Z"^^xsd:dateTime ;
    vcw:owlRole "Concept" .

# SimCLR
spatial-computing:SimCLR rdf:type owl:Class ;
    rdfs:label "SimCLR"@en ;
    rdfs:comment "A self-supervised learning framework that learns visual representations through contrastive learning with data augmentation. A linear classifier on SimCLR representations achieves 76.5% top-1 accuracy, matching supervised ResNet-50 performance."@en ;
    skos:prefLabel "SimCLR"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:spatial-computing:simclr" ;
    owl:sameAs <urn:visionclaw:concept:spatial-computing:simclr> ;
    vcw:contentHash "sha256-12-c47e5d058e79" ;
    vcw:qualityScore "0.5"^^xsd:decimal ;
    vcw:legacyTermId "AI-0285" ;
    vcw:ontologyStatus "draft" ;
    vcw:maturityLevel "draft" ;
    vcw:authorityScore "0.0"^^xsd:decimal ;
    dcterms:identifier "AI-0285" ;
    dcterms:subject "spatial-computing" ;
    owl:versionInfo "2.0.0" ;
    dcterms:created "2026-04-26T00:00:00Z"^^xsd:dateTime ;
    dcterms:modified "2026-04-26T13:00:00Z"^^xsd:dateTime ;
    vcw:owlRole "Concept" .

# Data Augmentation Strategies
artificial-intelligence:DataAugmentationStrategies rdf:type owl:Class ;
    rdfs:label "Data Augmentation Strategies"@en ;
    rdfs:comment "Techniques that create modified versions of training examples to increase dataset diversity and model robustness. Data augmentation strategies apply transformations that preserve label semantics whilst introducing variation, improving generalisation and reducing overfitting."@en ;
    skos:prefLabel "Data Augmentation Strategies"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:artificial-intelligence:data-augmentation-strategies" ;
    owl:sameAs <urn:visionclaw:concept:artificial-intelligence:data-augmentation-strategies> ;
    vcw:contentHash "sha256-12-6bb9e44e19b7" ;
    vcw:qualityScore "0.5"^^xsd:decimal ;
    vcw:legacyTermId "AI-0286" ;
    vcw:ontologyStatus "draft" ;
    vcw:maturityLevel "draft" ;
    vcw:authorityScore "0.0"^^xsd:decimal ;
    dcterms:identifier "AI-0286" ;
    dcterms:subject "artificial-intelligence" ;
    owl:versionInfo "2.0.0" ;
    dcterms:created "2026-04-26T00:00:00Z"^^xsd:dateTime ;
    dcterms:modified "2026-04-26T13:00:00Z"^^xsd:dateTime ;
    vcw:owlRole "Concept" .

# Mixup
spatial-computing:Mixup rdf:type owl:Class ;
    rdfs:label "Mixup"@en ;
    rdfs:comment "A data augmentation technique that creates virtual training examples by linearly interpolating pairs of examples and their labels. Mixup improves generalisation, calibration, and robustness by training on convex combinations of training samples."@en ;
    skos:prefLabel "Mixup"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:spatial-computing:mixup" ;
    owl:sameAs <urn:visionclaw:concept:spatial-computing:mixup> ;
    vcw:contentHash "sha256-12-c65d624f3ca4" ;
    vcw:qualityScore "0.5"^^xsd:decimal ;
    vcw:legacyTermId "AI-0287" ;
    vcw:ontologyStatus "draft" ;
    vcw:maturityLevel "draft" ;
    vcw:authorityScore "0.0"^^xsd:decimal ;
    dcterms:identifier "AI-0287" ;
    dcterms:subject "spatial-computing" ;
    owl:versionInfo "2.0.0" ;
    dcterms:created "2026-04-26T00:00:00Z"^^xsd:dateTime ;
    dcterms:modified "2026-04-26T13:00:00Z"^^xsd:dateTime ;
    vcw:owlRole "Concept" .

# Cut Mix
spatial-computing:CutMix rdf:type owl:Class ;
    rdfs:label "Cut Mix"@en ;
    rdfs:comment "A data augmentation technique that creates training examples by cutting and pasting patches between images, with labels mixed proportionally to the patch areas. CutMix improves model robustness and localisation ability by forcing attention to less discriminative regions."@en ;
    skos:prefLabel "Cut Mix"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:spatial-computing:cut-mix" ;
    owl:sameAs <urn:visionclaw:concept:spatial-computing:cut-mix> ;
    vcw:contentHash "sha256-12-aea2c584fb6d" ;
    vcw:qualityScore "0.5"^^xsd:decimal ;
    vcw:legacyTermId "AI-0288" ;
    vcw:ontologyStatus "draft" ;
    vcw:maturityLevel "draft" ;
    vcw:authorityScore "0.0"^^xsd:decimal ;
    dcterms:identifier "AI-0288" ;
    dcterms:subject "spatial-computing" ;
    owl:versionInfo "2.0.0" ;
    dcterms:created "2026-04-26T00:00:00Z"^^xsd:dateTime ;
    dcterms:modified "2026-04-26T13:00:00Z"^^xsd:dateTime ;
    vcw:owlRole "Concept" .

# Label Smoothing
spatial-computing:LabelSmoothing rdf:type owl:Class ;
    rdfs:label "Label Smoothing"@en ;
    rdfs:comment "A regularisation technique that replaces hard one-hot labels with soft targets by allocating small probability mass to incorrect classes. Label smoothing prevents overconfident predictions and improves model calibration and generalisation."@en ;
    skos:prefLabel "Label Smoothing"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:spatial-computing:label-smoothing" ;
    owl:sameAs <urn:visionclaw:concept:spatial-computing:label-smoothing> ;
    vcw:contentHash "sha256-12-900ab4594489" ;
    vcw:qualityScore "0.5"^^xsd:decimal ;
    vcw:legacyTermId "AI-0289" ;
    vcw:ontologyStatus "draft" ;
    vcw:maturityLevel "draft" ;
    vcw:authorityScore "0.0"^^xsd:decimal ;
    dcterms:identifier "AI-0289" ;
    dcterms:subject "spatial-computing" ;
    owl:versionInfo "2.0.0" ;
    dcterms:created "2026-04-26T00:00:00Z"^^xsd:dateTime ;
    dcterms:modified "2026-04-26T13:00:00Z"^^xsd:dateTime ;
    vcw:owlRole "Concept" .

# Early Stopping
spatial-computing:EarlyStopping rdf:type owl:Class ;
    rdfs:label "Early Stopping"@en ;
    rdfs:comment "A regularisation technique that terminates training when validation performance stops improving, preventing overfitting by avoiding overtraining on the training set. Early stopping balances training progress against generalisation to unseen data."@en ;
    skos:prefLabel "Early Stopping"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:spatial-computing:early-stopping" ;
    owl:sameAs <urn:visionclaw:concept:spatial-computing:early-stopping> ;
    vcw:contentHash "sha256-12-1ebe4999e40e" ;
    vcw:qualityScore "0.5"^^xsd:decimal ;
    vcw:legacyTermId "AI-0290" ;
    vcw:ontologyStatus "draft" ;
    vcw:maturityLevel "draft" ;
    vcw:authorityScore "0.0"^^xsd:decimal ;
    dcterms:identifier "AI-0290" ;
    dcterms:subject "spatial-computing" ;
    owl:versionInfo "2.0.0" ;
    dcterms:created "2026-04-26T00:00:00Z"^^xsd:dateTime ;
    dcterms:modified "2026-04-26T13:00:00Z"^^xsd:dateTime ;
    vcw:owlRole "Concept" .

# Learning Rate Schedule
spatial-computing:LearningRateSchedule rdf:type owl:Class ;
    rdfs:label "Learning Rate Schedule"@en ;
    rdfs:comment "A strategy for adjusting the learning rate during training according to a predefined or adaptive schedule. Learning rate schedules improve convergence and final performance by using higher rates early for rapid progress and lower rates later for fine-tuning."@en ;
    skos:prefLabel "Learning Rate Schedule"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:spatial-computing:learning-rate-schedule" ;
    owl:sameAs <urn:visionclaw:concept:spatial-computing:learning-rate-schedule> ;
    vcw:contentHash "sha256-12-368b5c0d6f66" ;
    vcw:qualityScore "0.5"^^xsd:decimal ;
    vcw:legacyTermId "AI-0291" ;
    vcw:ontologyStatus "draft" ;
    vcw:maturityLevel "draft" ;
    vcw:authorityScore "0.0"^^xsd:decimal ;
    dcterms:identifier "AI-0291" ;
    dcterms:subject "spatial-computing" ;
    owl:versionInfo "2.0.0" ;
    dcterms:created "2026-04-26T00:00:00Z"^^xsd:dateTime ;
    dcterms:modified "2026-04-26T13:00:00Z"^^xsd:dateTime ;
    vcw:owlRole "Concept" .

# Warmup
spatial-computing:Warmup rdf:type owl:Class ;
    rdfs:label "Warmup"@en ;
    rdfs:comment "A training technique where the learning rate starts small and gradually increases at the beginning of training to stabilise optimisation. Warmup is standard practice for training large transformer models, preventing instability from large gradients early in training."@en ;
    skos:prefLabel "Warmup"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:spatial-computing:warmup" ;
    owl:sameAs <urn:visionclaw:concept:spatial-computing:warmup> ;
    vcw:contentHash "sha256-12-46c1c53bed17" ;
    vcw:qualityScore "0.5"^^xsd:decimal ;
    vcw:legacyTermId "AI-0292" ;
    vcw:ontologyStatus "draft" ;
    vcw:maturityLevel "draft" ;
    vcw:authorityScore "0.0"^^xsd:decimal ;
    dcterms:identifier "AI-0292" ;
    dcterms:subject "spatial-computing" ;
    owl:versionInfo "2.0.0" ;
    dcterms:created "2026-04-26T00:00:00Z"^^xsd:dateTime ;
    dcterms:modified "2026-04-26T13:00:00Z"^^xsd:dateTime ;
    vcw:owlRole "Concept" .

# Weight Decay
artificial-intelligence:WeightDecay rdf:type owl:Class ;
    rdfs:label "Weight Decay"@en ;
    rdfs:comment "A regularisation technique that adds a penalty proportional to the magnitude of weights to the loss function, encouraging smaller weight values. Weight decay (L2 regularisation) prevents overfitting by limiting model complexity and promoting simpler solutions."@en ;
    skos:prefLabel "Weight Decay"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:artificial-intelligence:weight-decay" ;
    owl:sameAs <urn:visionclaw:concept:artificial-intelligence:weight-decay> ;
    vcw:contentHash "sha256-12-7293891741ee" ;
    vcw:qualityScore "0.5"^^xsd:decimal ;
    vcw:legacyTermId "AI-0293" ;
    vcw:ontologyStatus "draft" ;
    vcw:maturityLevel "draft" ;
    vcw:authorityScore "0.0"^^xsd:decimal ;
    dcterms:identifier "AI-0293" ;
    dcterms:subject "artificial-intelligence" ;
    owl:versionInfo "2.0.0" ;
    dcterms:created "2026-04-26T00:00:00Z"^^xsd:dateTime ;
    dcterms:modified "2026-04-26T13:00:00Z"^^xsd:dateTime ;
    vcw:owlRole "Concept" .

# Gradient Clipping
artificial-intelligence:GradientClipping rdf:type owl:Class ;
    rdfs:label "Gradient Clipping"@en ;
    rdfs:comment "A technique that limits the magnitude of gradients during backpropagation to prevent exploding gradients and training instability. Gradient clipping rescales gradients when their norm exceeds a threshold, enabling stable training of deep networks, especially recurrent architectures."@en ;
    skos:prefLabel "Gradient Clipping"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:artificial-intelligence:gradient-clipping" ;
    owl:sameAs <urn:visionclaw:concept:artificial-intelligence:gradient-clipping> ;
    vcw:contentHash "sha256-12-df4462c1c826" ;
    vcw:qualityScore "0.5"^^xsd:decimal ;
    vcw:legacyTermId "AI-0294" ;
    vcw:ontologyStatus "draft" ;
    vcw:maturityLevel "draft" ;
    vcw:authorityScore "0.0"^^xsd:decimal ;
    dcterms:identifier "AI-0294" ;
    dcterms:subject "artificial-intelligence" ;
    owl:versionInfo "2.0.0" ;
    dcterms:created "2026-04-26T00:00:00Z"^^xsd:dateTime ;
    dcterms:modified "2026-04-26T13:00:00Z"^^xsd:dateTime ;
    vcw:owlRole "Concept" .

# Mixed Precision Training
artificial-intelligence:MixedPrecisionTraining rdf:type owl:Class ;
    rdfs:label "Mixed Precision Training"@en ;
    rdfs:comment "A training technique that uses lower precision (FP16) for most computations whilst maintaining higher precision (FP32) for critical operations, reducing memory usage and increasing training speed without sacrificing model quality. Mixed precision training leverages modern GPU tensor cores for significant speedups."@en ;
    skos:prefLabel "Mixed Precision Training"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:artificial-intelligence:mixed-precision-training" ;
    owl:sameAs <urn:visionclaw:concept:artificial-intelligence:mixed-precision-training> ;
    vcw:contentHash "sha256-12-3e8dd671f3f7" ;
    vcw:qualityScore "0.5"^^xsd:decimal ;
    vcw:legacyTermId "AI-0295" ;
    vcw:ontologyStatus "draft" ;
    vcw:maturityLevel "draft" ;
    vcw:authorityScore "0.0"^^xsd:decimal ;
    dcterms:identifier "AI-0295" ;
    dcterms:subject "artificial-intelligence" ;
    owl:versionInfo "2.0.0" ;
    dcterms:created "2026-04-26T00:00:00Z"^^xsd:dateTime ;
    dcterms:modified "2026-04-26T13:00:00Z"^^xsd:dateTime ;
    vcw:owlRole "Concept" .

# Explainable AI
artificial-intelligence:ExplainableAI rdf:type owl:Class ;
    rdfs:label "Explainable AI"@en ;
    rdfs:comment "AI systems designed to provide clear, understandable explanations of their decision-making processes, enabling stakeholders to comprehend how and why specific outputs are generated."@en ;
    skos:prefLabel "Explainable AI"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:artificial-intelligence:explainable-ai" ;
    owl:sameAs <urn:visionclaw:concept:artificial-intelligence:explainable-ai> ;
    vcw:contentHash "sha256-12-1cb77c907da0" ;
    vcw:qualityScore "0.5"^^xsd:decimal ;
    vcw:legacyTermId "AI-0296" ;
    vcw:ontologyStatus "draft" ;
    vcw:maturityLevel "draft" ;
    vcw:authorityScore "0.0"^^xsd:decimal ;
    dcterms:identifier "AI-0296" ;
    dcterms:subject "artificial-intelligence" ;
    owl:versionInfo "2.0.0" ;
    dcterms:created "2026-04-26T00:00:00Z"^^xsd:dateTime ;
    dcterms:modified "2026-04-26T13:00:00Z"^^xsd:dateTime ;
    vcw:owlRole "Concept" .

# Interpretable AI
artificial-intelligence:InterpretableAI rdf:type owl:Class ;
    rdfs:label "Interpretable AI"@en ;
    rdfs:comment "Machine learning models and systems whose internal decision-making processes are inherently transparent and understandable to humans without requiring additional post-hoc explanation techniques."@en ;
    skos:prefLabel "Interpretable AI"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:artificial-intelligence:interpretable-ai" ;
    owl:sameAs <urn:visionclaw:concept:artificial-intelligence:interpretable-ai> ;
    vcw:contentHash "sha256-12-a55dc6f77488" ;
    vcw:qualityScore "0.5"^^xsd:decimal ;
    vcw:legacyTermId "AI-0297" ;
    vcw:ontologyStatus "draft" ;
    vcw:maturityLevel "draft" ;
    vcw:authorityScore "0.0"^^xsd:decimal ;
    dcterms:identifier "AI-0297" ;
    dcterms:subject "artificial-intelligence" ;
    owl:versionInfo "2.0.0" ;
    dcterms:created "2026-04-26T00:00:00Z"^^xsd:dateTime ;
    dcterms:modified "2026-04-26T13:00:00Z"^^xsd:dateTime ;
    vcw:owlRole "Concept" .

# Model Interpretability
artificial-intelligence:ModelInterpretability rdf:type owl:Class ;
    rdfs:label "Model Interpretability"@en ;
    rdfs:comment "The degree to which a human can understand the cause-effect relationships within a machine learning model's decision-making process, encompassing both the model's internal mechanisms and the reasoning behind specific predictions."@en ;
    skos:prefLabel "Model Interpretability"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:artificial-intelligence:model-interpretability" ;
    owl:sameAs <urn:visionclaw:concept:artificial-intelligence:model-interpretability> ;
    vcw:contentHash "sha256-12-a24d7dc10d10" ;
    vcw:qualityScore "0.5"^^xsd:decimal ;
    vcw:legacyTermId "AI-0298" ;
    vcw:ontologyStatus "draft" ;
    vcw:maturityLevel "draft" ;
    vcw:authorityScore "0.0"^^xsd:decimal ;
    dcterms:identifier "AI-0298" ;
    dcterms:subject "artificial-intelligence" ;
    owl:versionInfo "2.0.0" ;
    dcterms:created "2026-04-26T00:00:00Z"^^xsd:dateTime ;
    dcterms:modified "2026-04-26T13:00:00Z"^^xsd:dateTime ;
    vcw:owlRole "Concept" .

# Post Hoc Explanation
spatial-computing:PostHocExplanation rdf:type owl:Class ;
    rdfs:label "Post Hoc Explanation"@en ;
    rdfs:comment "Interpretability techniques applied after a machine learning model has been trained, providing explanations for model behaviour and predictions without modifying the model's architecture or requiring retraining."@en ;
    skos:prefLabel "Post Hoc Explanation"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:spatial-computing:post-hoc-explanation" ;
    owl:sameAs <urn:visionclaw:concept:spatial-computing:post-hoc-explanation> ;
    vcw:contentHash "sha256-12-ca8913a04f2f" ;
    vcw:qualityScore "0.5"^^xsd:decimal ;
    vcw:legacyTermId "AI-0299" ;
    vcw:ontologyStatus "draft" ;
    vcw:maturityLevel "draft" ;
    vcw:authorityScore "0.0"^^xsd:decimal ;
    dcterms:identifier "AI-0299" ;
    dcterms:subject "spatial-computing" ;
    owl:versionInfo "2.0.0" ;
    dcterms:created "2026-04-26T00:00:00Z"^^xsd:dateTime ;
    dcterms:modified "2026-04-26T13:00:00Z"^^xsd:dateTime ;
    vcw:owlRole "Concept" .

# Intrinsic Interpretability
artificial-intelligence:IntrinsicInterpretability rdf:type owl:Class ;
    rdfs:label "Intrinsic Interpretability"@en ;
    rdfs:comment "The inherent transparency and understandability of a machine learning model's architecture and decision-making process, achieved through model design rather than external explanation techniques, enabling direct human comprehension without additional interpretability methods."@en ;
    skos:prefLabel "Intrinsic Interpretability"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:artificial-intelligence:intrinsic-interpretability" ;
    owl:sameAs <urn:visionclaw:concept:artificial-intelligence:intrinsic-interpretability> ;
    vcw:contentHash "sha256-12-c595b47200ce" ;
    vcw:qualityScore "0.5"^^xsd:decimal ;
    vcw:legacyTermId "AI-0300" ;
    vcw:ontologyStatus "draft" ;
    vcw:maturityLevel "draft" ;
    vcw:authorityScore "0.0"^^xsd:decimal ;
    dcterms:identifier "AI-0300" ;
    dcterms:subject "artificial-intelligence" ;
    owl:versionInfo "2.0.0" ;
    dcterms:created "2026-04-26T00:00:00Z"^^xsd:dateTime ;
    dcterms:modified "2026-04-26T13:00:00Z"^^xsd:dateTime ;
    vcw:owlRole "Concept" .

# Local Explanation
spatial-computing:LocalExplanation rdf:type owl:Class ;
    rdfs:label "Local Explanation"@en ;
    rdfs:comment "Interpretability techniques that explain individual model predictions for specific instances, providing insight into why a particular input produced a given output without necessarily characterising the model's global behaviour."@en ;
    skos:prefLabel "Local Explanation"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:spatial-computing:local-explanation" ;
    owl:sameAs <urn:visionclaw:concept:spatial-computing:local-explanation> ;
    vcw:contentHash "sha256-12-7016cb717394" ;
    vcw:qualityScore "0.5"^^xsd:decimal ;
    vcw:legacyTermId "AI-0301" ;
    vcw:ontologyStatus "draft" ;
    vcw:maturityLevel "draft" ;
    vcw:authorityScore "0.0"^^xsd:decimal ;
    dcterms:identifier "AI-0301" ;
    dcterms:subject "spatial-computing" ;
    owl:versionInfo "2.0.0" ;
    dcterms:created "2026-04-26T00:00:00Z"^^xsd:dateTime ;
    dcterms:modified "2026-04-26T13:00:00Z"^^xsd:dateTime ;
    vcw:owlRole "Concept" .

# Global Explanation
spatial-computing:GlobalExplanation rdf:type owl:Class ;
    rdfs:label "Global Explanation"@en ;
    rdfs:comment "Interpretability techniques that characterise the overall behaviour, decision-making patterns, and feature importance of a machine learning model across its entire input space, rather than explaining individual predictions."@en ;
    skos:prefLabel "Global Explanation"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:spatial-computing:global-explanation" ;
    owl:sameAs <urn:visionclaw:concept:spatial-computing:global-explanation> ;
    vcw:contentHash "sha256-12-3cadee238e24" ;
    vcw:qualityScore "0.5"^^xsd:decimal ;
    vcw:legacyTermId "AI-0302" ;
    vcw:ontologyStatus "draft" ;
    vcw:maturityLevel "draft" ;
    vcw:authorityScore "0.0"^^xsd:decimal ;
    dcterms:identifier "AI-0302" ;
    dcterms:subject "spatial-computing" ;
    owl:versionInfo "2.0.0" ;
    dcterms:created "2026-04-26T00:00:00Z"^^xsd:dateTime ;
    dcterms:modified "2026-04-26T13:00:00Z"^^xsd:dateTime ;
    vcw:owlRole "Concept" .

# Feature Importance
spatial-computing:FeatureImportance rdf:type owl:Class ;
    rdfs:label "Feature Importance"@en ;
    rdfs:comment "Quantitative measures indicating the relative contribution or influence of individual input features on a machine learning model's predictions, enabling identification of the most critical variables driving model outputs."@en ;
    skos:prefLabel "Feature Importance"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:spatial-computing:feature-importance" ;
    owl:sameAs <urn:visionclaw:concept:spatial-computing:feature-importance> ;
    vcw:contentHash "sha256-12-d07bf81edbfb" ;
    vcw:qualityScore "0.5"^^xsd:decimal ;
    vcw:legacyTermId "AI-0303" ;
    vcw:ontologyStatus "draft" ;
    vcw:maturityLevel "draft" ;
    vcw:authorityScore "0.0"^^xsd:decimal ;
    dcterms:identifier "AI-0303" ;
    dcterms:subject "spatial-computing" ;
    owl:versionInfo "2.0.0" ;
    dcterms:created "2026-04-26T00:00:00Z"^^xsd:dateTime ;
    dcterms:modified "2026-04-26T13:00:00Z"^^xsd:dateTime ;
    vcw:owlRole "Concept" .

# Clinical Decision Support
spatial-computing:ClinicalDecisionSupport rdf:type owl:Class ;
    rdfs:label "Clinical Decision Support"@en ;
    rdfs:comment "Clinical Decision Support (CDS) refers to AI systems that provide healthcare professionals with patient-specific assessments, recommendations, and information to support clinical decision-making at the point of care. CDS systems integrate patient data, medical knowledge bases, clinical guidelines, and evidence-based protocols to assist in diagnosis, treatment selection, medication management, and care coordination whilst maintaining clinician autonomy and clinical judgement."@en ;
    skos:prefLabel "Clinical Decision Support"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:spatial-computing:clinical-decision-support" ;
    owl:sameAs <urn:visionclaw:concept:spatial-computing:clinical-decision-support> ;
    vcw:contentHash "sha256-12-0a597d0c447a" ;
    vcw:qualityScore "0.5"^^xsd:decimal ;
    vcw:legacyTermId "AI-0337" ;
    vcw:ontologyStatus "draft" ;
    vcw:maturityLevel "draft" ;
    vcw:authorityScore "0.0"^^xsd:decimal ;
    dcterms:identifier "AI-0337" ;
    dcterms:subject "spatial-computing" ;
    owl:versionInfo "2.0.0" ;
    dcterms:created "2026-04-26T00:00:00Z"^^xsd:dateTime ;
    dcterms:modified "2026-04-26T13:00:00Z"^^xsd:dateTime ;
    vcw:owlRole "Concept" .

spatial-computing:ClinicalDecisionSupport vcw:bridgesTo spatial-computing:Telecollaboration .

# Medical Imaging AI
artificial-intelligence:MedicalImagingAI rdf:type owl:Class ;
    rdfs:label "Medical Imaging AI"@en ;
    rdfs:comment "Medical Imaging AI encompasses artificial intelligence systems designed to analyse, interpret, and enhance medical images including radiological scans, pathology slides, and other diagnostic imaging modalities. These systems employ deep learning architectures, particularly convolutional neural networks, to perform tasks such as lesion detection, disease classification, segmentation of anatomical structures, and quantitative image analysis whilst adhering to clinical validation standards and regulatory requirements."@en ;
    skos:prefLabel "Medical Imaging AI"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:artificial-intelligence:medical-imaging-ai" ;
    owl:sameAs <urn:visionclaw:concept:artificial-intelligence:medical-imaging-ai> ;
    vcw:contentHash "sha256-12-cccd669f5312" ;
    vcw:qualityScore "0.5"^^xsd:decimal ;
    vcw:legacyTermId "AI-0338" ;
    vcw:ontologyStatus "draft" ;
    vcw:maturityLevel "draft" ;
    vcw:authorityScore "0.0"^^xsd:decimal ;
    dcterms:identifier "AI-0338" ;
    dcterms:subject "artificial-intelligence" ;
    owl:versionInfo "2.0.0" ;
    dcterms:created "2026-04-26T00:00:00Z"^^xsd:dateTime ;
    dcterms:modified "2026-04-26T13:00:00Z"^^xsd:dateTime ;
    vcw:owlRole "Concept" .

# Radiology AI
artificial-intelligence:RadiologyAI rdf:type owl:Class ;
    rdfs:label "Radiology AI"@en ;
    rdfs:comment "Radiology AI refers to artificial intelligence systems specifically designed for the interpretation and analysis of radiological imaging modalities including X-ray, computed tomography (CT), magnetic resonance imaging (MRI), and ultrasound. These systems automate detection, classification, and quantification tasks whilst integrating with PACS workflows and providing radiologist-level diagnostic performance validated through clinical trials."@en ;
    skos:prefLabel "Radiology AI"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:artificial-intelligence:radiology-ai" ;
    owl:sameAs <urn:visionclaw:concept:artificial-intelligence:radiology-ai> ;
    vcw:contentHash "sha256-12-673b33ffad94" ;
    vcw:qualityScore "0.5"^^xsd:decimal ;
    vcw:legacyTermId "AI-0339" ;
    vcw:ontologyStatus "draft" ;
    vcw:maturityLevel "draft" ;
    vcw:authorityScore "0.0"^^xsd:decimal ;
    dcterms:identifier "AI-0339" ;
    dcterms:subject "artificial-intelligence" ;
    owl:versionInfo "2.0.0" ;
    dcterms:created "2026-04-26T00:00:00Z"^^xsd:dateTime ;
    dcterms:modified "2026-04-26T13:00:00Z"^^xsd:dateTime ;
    vcw:owlRole "Concept" .

# Pathology AI
artificial-intelligence:PathologyAI rdf:type owl:Class ;
    rdfs:label "Pathology AI"@en ;
    rdfs:comment "Pathology AI comprises artificial intelligence systems for automated analysis of histopathology slides, cytology specimens, and other pathological images. These systems perform tasks including cancer detection, grading, biomarker quantification, and morphological analysis using whole slide imaging and deep learning architectures tailored for gigapixel pathology images."@en ;
    skos:prefLabel "Pathology AI"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:artificial-intelligence:pathology-ai" ;
    owl:sameAs <urn:visionclaw:concept:artificial-intelligence:pathology-ai> ;
    vcw:contentHash "sha256-12-f97a9790a99a" ;
    vcw:qualityScore "0.5"^^xsd:decimal ;
    vcw:legacyTermId "AI-0340" ;
    vcw:ontologyStatus "draft" ;
    vcw:maturityLevel "draft" ;
    vcw:authorityScore "0.0"^^xsd:decimal ;
    dcterms:identifier "AI-0340" ;
    dcterms:subject "artificial-intelligence" ;
    owl:versionInfo "2.0.0" ;
    dcterms:created "2026-04-26T00:00:00Z"^^xsd:dateTime ;
    dcterms:modified "2026-04-26T13:00:00Z"^^xsd:dateTime ;
    vcw:owlRole "Concept" .

# Drug Discovery AI
artificial-intelligence:DrugDiscoveryAI rdf:type owl:Class ;
    rdfs:label "Drug Discovery AI"@en ;
    rdfs:comment "Drug Discovery AI encompasses artificial intelligence systems that accelerate pharmaceutical research and development through automated molecular design, virtual screening, target identification, toxicity prediction, and clinical trial optimisation. These systems integrate cheminformatics, molecular modelling, and machine learning to reduce drug development timelines and costs whilst improving success rates."@en ;
    skos:prefLabel "Drug Discovery AI"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:artificial-intelligence:drug-discovery-ai" ;
    owl:sameAs <urn:visionclaw:concept:artificial-intelligence:drug-discovery-ai> ;
    vcw:contentHash "sha256-12-4e41c5bfda23" ;
    vcw:qualityScore "0.5"^^xsd:decimal ;
    vcw:legacyTermId "AI-0341" ;
    vcw:ontologyStatus "draft" ;
    vcw:maturityLevel "draft" ;
    vcw:authorityScore "0.0"^^xsd:decimal ;
    dcterms:identifier "AI-0341" ;
    dcterms:subject "artificial-intelligence" ;
    owl:versionInfo "2.0.0" ;
    dcterms:created "2026-04-26T00:00:00Z"^^xsd:dateTime ;
    dcterms:modified "2026-04-26T13:00:00Z"^^xsd:dateTime ;
    vcw:owlRole "Concept" .

# Precision Medicine
spatial-computing:PrecisionMedicine rdf:type owl:Class ;
    rdfs:label "Precision Medicine"@en ;
    rdfs:comment "Precision Medicine utilises artificial intelligence to tailor medical treatment to individual patient characteristics, integrating genomic data, clinical information, lifestyle factors, and environmental data to predict treatment response, identify optimal therapies, and stratify patient populations. AI-driven precision medicine enables personalised diagnosis, prognosis, and therapeutic selection based on multi-omic data integration and predictive modelling."@en ;
    skos:prefLabel "Precision Medicine"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:spatial-computing:precision-medicine" ;
    owl:sameAs <urn:visionclaw:concept:spatial-computing:precision-medicine> ;
    vcw:contentHash "sha256-12-7f5435fdc590" ;
    vcw:qualityScore "0.5"^^xsd:decimal ;
    vcw:legacyTermId "AI-0342" ;
    vcw:ontologyStatus "draft" ;
    vcw:maturityLevel "draft" ;
    vcw:authorityScore "0.0"^^xsd:decimal ;
    dcterms:identifier "AI-0342" ;
    dcterms:subject "spatial-computing" ;
    owl:versionInfo "2.0.0" ;
    dcterms:created "2026-04-26T00:00:00Z"^^xsd:dateTime ;
    dcterms:modified "2026-04-26T13:00:00Z"^^xsd:dateTime ;
    vcw:owlRole "Concept" .

# Medical Diagnosis AI
artificial-intelligence:MedicalDiagnosisAI rdf:type owl:Class ;
    rdfs:label "Medical Diagnosis AI"@en ;
    rdfs:comment "Medical Diagnosis AI refers to artificial intelligence systems that automate or assist in the diagnostic process by analysing patient symptoms, medical history, laboratory results, imaging findings, and other clinical data to generate differential diagnoses, diagnostic hypotheses, and diagnostic recommendations. These systems employ machine learning, knowledge representation, and clinical reasoning algorithms validated against expert physician performance."@en ;
    skos:prefLabel "Medical Diagnosis AI"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:artificial-intelligence:medical-diagnosis-ai" ;
    owl:sameAs <urn:visionclaw:concept:artificial-intelligence:medical-diagnosis-ai> ;
    vcw:contentHash "sha256-12-6bc396e4754a" ;
    vcw:qualityScore "0.5"^^xsd:decimal ;
    vcw:legacyTermId "AI-0343" ;
    vcw:ontologyStatus "draft" ;
    vcw:maturityLevel "draft" ;
    vcw:authorityScore "0.0"^^xsd:decimal ;
    dcterms:identifier "AI-0343" ;
    dcterms:subject "artificial-intelligence" ;
    owl:versionInfo "2.0.0" ;
    dcterms:created "2026-04-26T00:00:00Z"^^xsd:dateTime ;
    dcterms:modified "2026-04-26T13:00:00Z"^^xsd:dateTime ;
    vcw:owlRole "Concept" .

# Treatment Planning AI
artificial-intelligence:TreatmentPlanningAI rdf:type owl:Class ;
    rdfs:label "Treatment Planning AI"@en ;
    rdfs:comment "Treatment Planning AI encompasses artificial intelligence systems that optimise therapeutic interventions through automated treatment selection, dosage optimisation, radiation therapy planning, surgical planning, and personalised care pathway design. These systems integrate patient-specific data, treatment guidelines, outcome predictions, and resource constraints to generate evidence-based, individualised treatment plans."@en ;
    skos:prefLabel "Treatment Planning AI"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:artificial-intelligence:treatment-planning-ai" ;
    owl:sameAs <urn:visionclaw:concept:artificial-intelligence:treatment-planning-ai> ;
    vcw:contentHash "sha256-12-7a83ebe5aaff" ;
    vcw:qualityScore "0.5"^^xsd:decimal ;
    vcw:legacyTermId "AI-0344" ;
    vcw:ontologyStatus "draft" ;
