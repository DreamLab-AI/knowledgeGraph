ngm:digital-signature-verification a owl:Class ;
    rdfs:label "Digital Signature Verification"@en ;
    rdfs:comment "The cryptographic process of validating the authenticity and integrity of digitally signed data by applying the signer's public key to confirm that the signature was produced by the corresponding private key and that the signed content has not been altered."@en ;
