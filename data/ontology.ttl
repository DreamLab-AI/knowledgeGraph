    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:edge-computing,
        ngm:sensor .

ngm:io-t-integration a owl:Class ;
    rdfs:label "IoT Integration"@en ;
    rdfs:comment "IoT integration is the connection of networked physical sensors and actuators with software systems so that real-world telemetry flows into analytics, control, and decision platforms. It encompasses device connectivity, protocol gateways, data ingestion, and the synchronisation of physical state with digital models. It is the prerequisite for digital twins, real-time monitoring, and logistics optimisation that depend on live sensor data."@en ;
    rdfs:subClassOf ngm:infra-network-and-comms ;
    skos:broader ngm:infra-network-and-comms ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:digital-twin-creation,
        ngm:logistics-optimization ;
    vc:slug "io-t-integration" ;
    vc:sourceDomain "infrastructure" .

ngm:ipfs-content-addressing a owl:Class ;
    rdfs:label "IPFS Content Addressing"@en ;
    rdfs:comment "The addressing scheme used by the InterPlanetary File System, in which content is identified by a cryptographic hash of its data rather than by location. The resulting content identifier changes if the content changes."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptographic-hash ],
        ngm:ipfs ;
    vc:enables ngm:distributed-storage ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:cryptographic-hash ;
    vc:slug "ipfs-content-addressing" ;
    vc:sourceDomain "distributed-systems" .

ngm:isda-cdm a owl:Class ;
    rdfs:label "ISDA CDM"@en ;
    rdfs:comment "The ISDA CDM (Common Domain Model) is a standardised, machine-readable data and process model for derivatives and other financial transactions, published by the International Swaps and Derivatives Association. It provides a single, consistent representation of trade events, lifecycle processes, and legal terms so that disparate systems and smart contracts interpret them identically. It is foundational to interoperable enterprise tokenisation and automated post-trade processing on distributed ledgers."@en ;
    rdfs:subClassOf ngm:technical-standard ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:enterprise-smart-contracts,
        ngm:enterprise-token-standards ;
    vc:slug "isda-cdm" ;
    vc:sourceDomain "blockchain" .

ngm:iso-14067 a owl:Class ;
    rdfs:label "ISO 14067"@en ;
    rdfs:comment "ISO 14067 is an international standard that specifies principles, requirements, and guidelines for quantifying and reporting the carbon footprint of a product based on life-cycle assessment. It defines how greenhouse-gas emissions associated with a product's life cycle are calculated and communicated, expressed in CO2-equivalent. It provides the methodological backbone for credible product-level carbon-footprint measurement and disclosure."@en ;
    rdfs:subClassOf ngm:technical-standard ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:carbon-footprint-measurement ;
    vc:slug "iso-14067" ;
    vc:sourceDomain "supply-chain" .

ngm:iso-22739 a owl:Class ;
    rdfs:label "ISO 22739"@en ;
    rdfs:comment "ISO 22739:2020 is the foundational International Organisation for Standardisation standard that establishes a comprehensive vocabulary of terms and definitions for distributed ledger technology (DLT) and blockchain systems, providing a normative reference for terminology used across all subsequent blockchain-related ISO standards, regulatory documents, and technical specifications. The standard was developed by ISO/TC 307 (Blockchain and distributed ledger technologies) and covers over 60 core concepts including blockchain, distributed ledger, smart contract, consensus mechanism, node, fork, digital asset, cryptographic key, and wallet."@en ;
    rdfs:subClassOf ngm:iso-standards ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:blockchain-governance,
        ngm:consensus-mechanism,
        ngm:digital-asset ;
    vc:slug "iso-22739" ;
    vc:sourceDomain "blockchain" ;
    vc:standardizedBy ngm:blockchain,
        ngm:blockchain-core-concepts ;
    vc:supports ngm:blockchain-compliance,
        ngm:compliance-standards,
        ngm:interoperability-standard .

ngm:iso-3691-4 a owl:Class ;
    rdfs:label "ISO 3691-4"@en ;
    rdfs:comment "ISO 3691-4 specifies safety requirements for driverless industrial trucks and their systems."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:iso ],
        ngm:technical-standard ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:iso ;
    vc:slug "iso-3691-4" ;
    vc:sourceDomain "standards" .

ngm:jira a owl:Class ;
    rdfs:label "Jira"@en ;
    rdfs:comment "Jira is an issue and project tracking platform developed by Atlassian, widely used for planning, tracking, and releasing software across agile and traditional software development workflows. It provides configurable issue types (epics, stories, tasks, bugs), workflow state machines, sprint planning boards, backlog management, and reporting dashboards that support Scrum, Kanban, and hybrid methodologies. Jira integrates deeply with development toolchains—source control, CI/CD pipelines, monitoring systems—and serves as a central system of record for engineering work status, enabling cross-team coordination and stakeholder visibility at scale. It is available as a cloud SaaS product (Jira Cloud) and a self-hosted server or data centre deployment."@en ;
    rdfs:subClassOf ngm:project-management ;
    vc:enables ngm:collaboration,
        ngm:software-development-process ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:api-integration,
        ngm:collaboration-platform,
        ngm:software-platform ;
    vc:slug "jira" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:cloud-platform,
        ngm:software-development,
        ngm:workflow-automation .

ngm:json-rpc-2-0 a owl:Class ;
    rdfs:label "JSON-RPC 2.0"@en ;
    rdfs:comment "JSON-RPC 2.0 is a lightweight, transport-agnostic remote procedure call protocol that encodes method invocations and responses as JSON objects. It defines request, response, notification and batch message structures along with a standard error object, while leaving the transport layer unspecified. Its simplicity has made it the wire format for many blockchain node APIs and AI tool-invocation protocols."@en ;
    rdfs:subClassOf ngm:communication-protocol ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:function-calling,
        ngm:model-context-protocol ;
    vc:slug "json-rpc-2-0" ;
    vc:sourceDomain "infrastructure" .

ngm:json-serialisation a owl:Class ;
    rdfs:label "JSON Serialisation"@en ;
    rdfs:comment "JSON serialisation is the process of encoding in-memory data structures into JavaScript Object Notation text and decoding that text back into structured values. It provides a human-readable, language-independent representation for objects, arrays, numbers, strings and booleans. JSON serialisation is the default interchange format for web APIs, configuration files and message-passing between heterogeneous systems."@en ;
    rdfs:subClassOf ngm:data-management ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:comfy-ui-workflows,
        ngm:nostr-protocol ;
    vc:slug "json-serialisation" ;
    vc:sourceDomain "data" .

ngm:jvm-runtime a owl:Class ;
    rdfs:label "JVM Runtime"@en ;
    rdfs:comment "The JVM runtime is the execution environment provided by the Java Virtual Machine, which loads, verifies and runs platform-independent bytecode. It supplies just-in-time compilation, automatic garbage collection, threading and a security model that isolates executing code. The JVM hosts many languages beyond Java, including Kotlin and Scala, and underpins several enterprise blockchain platforms."@en ;
    rdfs:subClassOf ngm:computing-infrastructure ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:kotlin,
        ngm:r3-corda ;
    vc:slug "jvm-runtime" ;
    vc:sourceDomain "infrastructure" .

ngm:keccak-256-hashing a owl:Class ;
    rdfs:label "Keccak-256 Hashing"@en ;
    rdfs:comment "Keccak-256 is a cryptographic hash function from the Keccak family, producing a fixed 256-bit digest using a sponge construction. It is the specific variant adopted by Ethereum, distinct from the later NIST-standardised SHA3-256 due to a difference in padding. Keccak-256 provides collision and preimage resistance for addresses, transaction hashes and message commitments in blockchain systems."@en ;
    rdfs:subClassOf ngm:cryptographic-primitive ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:snapshot-voting ;
    vc:slug "keccak-256-hashing" ;
    vc:sourceDomain "blockchain" .

ngm:kerberos a owl:Class ;
    rdfs:label "Kerberos"@en ;
    rdfs:comment "Kerberos is a network authentication protocol that uses tickets and symmetric key cryptography to allow nodes to prove identity over an untrusted network."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:encryption ],
        ngm:authentication ;
    vc:enables ngm:single-sign-on ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:encryption ;
    vc:slug "kerberos" ;
    vc:sourceDomain "distributed-systems" .

ngm:key-management-system a owl:Class ;
    rdfs:label "Key Management System"@en ;
    rdfs:comment "A key management system (KMS) is a service or appliance that generates, stores, rotates, distributes and revokes cryptographic keys over their full lifecycle. It enforces access policies and isolates key material, often backed by hardware security modules, so that applications can perform cryptographic operations without directly handling private keys. A KMS is foundational to secure identity, encryption and digital-asset custody."@en ;
    rdfs:subClassOf ngm:infra-security-and-identity ;
    skos:broader ngm:infra-security-and-identity ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:custody-infrastructure,
        ngm:decentralized-identifiers ;
    vc:slug "key-management-system" ;
    vc:sourceDomain "security" .

ngm:keypoint-detection a owl:Class ;
    rdfs:label "Keypoint Detection"@en ;
    rdfs:comment "Keypoint detection is a computer vision task that locates salient, semantically meaningful points in an image, such as body joints, facial landmarks or object corners. It outputs spatial coordinates, often with confidence scores, that can be tracked across frames or matched between views. Keypoint detection is a building block for pose estimation, image registration and structure-from-motion."@en ;
    rdfs:subClassOf ngm:computer-vision ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:image-segmentation,
        ngm:pose-estimation ;
    vc:slug "keypoint-detection" ;
    vc:sourceDomain "ai" .

ngm:khronos-gl-tf a owl:Class ;
    rdfs:label "Khronos glTF"@en ;
    rdfs:comment "Khronos glTF (GL Transmission Format) is an open royalty-free specification maintained by the Khronos Group that defines a JSON-based container format for 3D scenes and models, designed for efficient runtime delivery and rendering rather than authoring — storing geometry as compact binary buffer views, referencing PBR (Physically Based Rendering) material parameters, animation data, skeletal hierarchies, and scene graphs in a format that maps closely to GPU resource layouts, minimising parse and upload overhead. glTF 2.0 (2017) established the core specification and is widely regarded as the 'JPEG of 3D' due to its adoption across web browsers (via Three.js and Babylon.js), game engines (Unreal, Unity, Godot), AR/VR runtimes (OpenXR, WebXR), and digital twin platforms."@en ;
    rdfs:subClassOf ngm:gl-tf-3-d-file-format ;
    vc:enables ngm:asset-interoperability,
        ngm:augmented-reality,
        ngm:extended-reality ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:gltf-standard,
        ngm:khronos-group,
        ngm:open-xr,
        ngm:physically-based-rendering,
        ngm:vulkan ;
    vc:slug "khronos-gl-tf" ;
    vc:sourceDomain "graphics" ;
    vc:supports ngm:virtual-production ;
    vc:uses ngm:3-d-file-format .

ngm:knowledge-sharing a owl:Class ;
    rdfs:label "Knowledge Sharing"@en ;
    rdfs:comment "Collaborative practices and platforms within metaverse environments that facilitate the exchange of information, expertise, and learning experiences among users through immersive virtual spaces, avatars, and AI-enhanced interactions."@en ;
    rdfs:subClassOf ngm:collaborative-technology,
        ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:enables ngm:distributed-team-collaboration ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:slug "knowledge-sharing" ;
    vc:sourceDomain "spatial-computing" .

ngm:kto a owl:Class ;
    rdfs:label "KTO"@en ;
    rdfs:comment "KTO (Kahneman-Tversky Optimization) is a method for aligning language models that learns from binary good or bad feedback on individual outputs rather than paired preference comparisons. Drawing on prospect theory, it defines a utility-based loss that down-weights losses relative to gains, simplifying data collection compared with preference-pair methods. It is an alternative to direct preference optimization in the post-training alignment toolkit."@en ;
    rdfs:subClassOf ngm:parameter-efficient-fine-tuning ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:direct-preference-optimization,
        ngm:model-training ;
    vc:slug "kto" ;
    vc:sourceDomain "ai" .

ngm:kyc-aml-compliance a owl:Class ;
    rdfs:label "KYC/AML Compliance"@en ;
    rdfs:comment "KYC/AML compliance is the operational implementation of Know Your Customer and Anti-Money Laundering obligations within a product or platform, embedding identity verification, screening and monitoring into business processes. It encompasses the controls, workflows and audit evidence needed to demonstrate adherence to regulators. In tokenised systems it is increasingly encoded into smart contracts and asset standards."@en ;
    rdfs:subClassOf ngm:regulatory-compliance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:carbon-credit-tracking,
        ngm:enterprise-token-standards ;
    vc:slug "kyc-aml-compliance" ;
    vc:sourceDomain "governance" .

ngm:language-translation a owl:Class ;
    rdfs:label "Language Translation"@en ;
    rdfs:comment "Language translation is the automated or human-assisted conversion of text or speech from a source language into a target language whilst preserving semantic meaning, tone, and cultural context. Modern neural machine translation systems, built on transformer architectures and large language models, enable real-time multilingual communication across distributed collaboration platforms and metaverse environments."@en ;
    rdfs:subClassOf ngm:dc-communication ;
    skos:broader ngm:dc-communication ;
    vc:enables ngm:localization ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:implements ngm:machine-translation ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:distributed-collaboration ;
    vc:slug "language-translation" ;
    vc:sourceDomain "distributed-collaboration" ;
    vc:uses ngm:large-language-models,
        ngm:natural-language-processing,
        ngm:transformer .

ngm:laser-scanner a owl:Class ;
    rdfs:label "Laser Scanner"@en ;
    rdfs:comment "A Laser Scanner is a sensor that emits laser pulses and measures the time-of-flight or phase-shift of the returned signal to compute precise distance measurements across a scene, generating dense point clouds. In robotics and spatial computing, laser scanners serve as primary perception instruments for environment mapping, obstacle detection, and the construction of digital twins via LiDAR-based SLAM pipelines."@en ;
    rdfs:subClassOf ngm:robo-perception ;
    skos:broader ngm:robo-perception ;
    vc:enables ngm:point-cloud,
        ngm:slam,
        ngm:spatial-mapping ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:relatedTo ngm:photogrammetry,
        ngm:sensor-fusion ;
    vc:slug "laser-scanner" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:lidar .

ngm:last-mile-delivery a owl:Class ;
    rdfs:label "Last-Mile Delivery"@en ;
    rdfs:comment "Last-mile delivery is the final stage of a logistics chain in which goods move from a transport hub or distribution centre to the end recipient. It is typically the most expensive, time-sensitive and operationally complex segment because of fragmented destinations and traffic constraints. It is a primary target for automation through delivery robots, drones and route-optimisation systems."@en ;
    rdfs:subClassOf ngm:robo-navigation-and-planning ;
    skos:broader ngm:robo-navigation-and-planning ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:ground-robot,
        ngm:logistics-optimization ;
    vc:slug "last-mile-delivery" ;
    vc:sourceDomain "robotics" .

ngm:layer-normalization a owl:Class ;
    rdfs:label "Layer Normalization"@en ;
    rdfs:comment "A neural network technique that normalises the activations across the features of a single training example, stabilising and accelerating training. It is widely used in transformer architectures where it normalises each token's representation independently of the batch."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:activation-function ],
        ngm:neural-network ;
    vc:enables ngm:transformer-architecture ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:activation-function ;
    vc:slug "layer-normalization" ;
    vc:sourceDomain "general" .

ngm:layer2 a owl:Class ;
    rdfs:label "Layer2"@en ;
    rdfs:comment "Secondary protocols built atop Layer 1 blockchains that process transactions off-chain or in parallel batches, then periodically commit aggregated state changes to the main chain. Layer 2 solutions achieve dramatically higher throughput, lower fees, and improved user experience while inheriting the security guarantees of the underlying base layer. Principal approaches include rollups (optimistic and ZK), state channels, and sidechains."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:sidechain ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:lightning-and-similar-l2 ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:state-channel ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:lightning-network ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:layer2-scaling ],
        ngm:bc-network-component,
        ngm:smart-contract-platform ;
    skos:broader ngm:bc-network-component ;
    vc:enables ngm:blockchain-interoperability,
        ngm:blockchain-scalability ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:layer2-scaling,
        ngm:lightning-and-similar-l2,
        ngm:lightning-network,
        ngm:sidechain,
        ngm:state-channel ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:cross-chain-messaging,
        ngm:transaction-confirmation ;
    vc:slug "layer2" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:cross-chain-bridge,
        ngm:smart-contract,
        ngm:zero-knowledge-proof .

ngm:ldap a owl:Class ;
    rdfs:label "LDAP"@en ;
    rdfs:comment "The Lightweight Directory Access Protocol (LDAP) is an open, vendor-neutral application protocol for accessing and maintaining distributed directory information services over an IP network, standardised in RFC 4511 (2006) as a simplification of the X.500 Directory Access Protocol. LDAP organises directory entries in a hierarchical tree structure (Directory Information Tree, DIT) where entries contain typed attribute-value pairs conforming to object class schemas, and supports operations for search, add, modify, delete, compare, and bind (authentication). It serves as the foundational protocol for enterprise identity management, enabling centralised authentication, authorisation, and user attribute storage across heterogeneous systems."@en ;
    rdfs:subClassOf ngm:network-protocol ;
    vc:enables ngm:access-control,
        ngm:authentication,
        ngm:identity-management ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:authentication-standards,
        ngm:federated-identity,
        ngm:identity-and-access-management ;
    vc:slug "ldap" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:enterprise-architecture .

ngm:ldp-container a owl:Class ;
    rdfs:label "LDP Container"@en ;
    rdfs:comment "An LDP Container is a resource defined by the W3C Linked Data Platform specification that groups and manages other linked-data resources, exposing them through HTTP affordances for creation, retrieval, and deletion. Containers come in basic, direct, and indirect variants that differ in how membership triples are generated. They provide the hierarchical, REST-like structure that Solid pods and other LDP servers use to organise data."@en ;
    rdfs:subClassOf ngm:infra-data-management ;
    skos:broader ngm:infra-data-management ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:solid,
        ngm:solid-pod ;
    vc:slug "ldp-container" ;
    vc:sourceDomain "data" .

ngm:ldpc-codes a owl:Class ;
    rdfs:label "LDPC Codes"@en ;
    rdfs:comment "Low-Density Parity-Check (LDPC) codes are a class of linear error-correcting codes defined by a sparse parity-check matrix and decoded with iterative belief-propagation algorithms. They approach the Shannon capacity limit while remaining computationally tractable, making them a dominant forward-error-correction scheme in modern communications. LDPC codes are mandated in standards such as Wi-Fi 6, 5G NR data channels, and DVB-S2."@en ;
    rdfs:subClassOf ngm:infra-network-and-comms ;
    skos:broader ngm:infra-network-and-comms ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:forward-error-correction,
        ngm:physical-layer ;
    vc:slug "ldpc-codes" ;
    vc:sourceDomain "infrastructure" .

ngm:lead-screw-actuator a owl:Class ;
    rdfs:label "Lead Screw Actuator"@en ;
    rdfs:comment "A linear actuation mechanism that converts rotational motion from a motor into controlled axial displacement by driving a threaded nut along a precision-cut helical screw shaft. Lead screw actuators provide high mechanical advantage, inherent load-holding capability (due to the self-locking property when lead angle is below the friction angle), and positional repeatability, making them widely used in CNC machines, 3D printers, robotic joints, and medical devices."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:actuator ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:mechanical-component ],
        ngm:electric-linear-actuator,
        ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:contrastsWith ngm:pid-controller ;
    vc:enables ngm:industrial-robot,
        ngm:torque-control ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:actuator,
        ngm:mechanical-component ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:robotics-control,
        ngm:robotics-systems ;
    vc:slug "lead-screw-actuator" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:servo-motor,
        ngm:stepper-motor,
        ngm:torque .

ngm:learning-from-demonstration a owl:Class ;
    rdfs:label "Learning from Demonstration"@en ;
    rdfs:comment "Learning from demonstration is an approach in which an agent acquires behaviour by observing examples performed by a teacher. It is used to bootstrap policies in robotics and control without hand-specified reward functions."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:imitation-learning ],
        ngm:imitation-learning ;
    vc:enables ngm:offline-reinforcement-learning ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:imitation-learning ;
    vc:slug "learning-from-demonstration" ;
    vc:sourceDomain "machine-learning" .

ngm:learning-resources a owl:Class ;
    rdfs:label "Learning Resources"@en ;
    rdfs:comment "Educational materials and content designed for delivery through VR, AR, and metaverse platforms, including 3D models, interactive simulations, virtual environments, and AI-generated adaptive content for immersive learning experiences."@en ;
    rdfs:subClassOf ngm:educational-technology,
        ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:enables ngm:immersive-education ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:slug "learning-resources" ;
    vc:sourceDomain "spatial-computing" .

ngm:leeds-digital-hub a owl:Class ;
    rdfs:label "Leeds Digital Hub"@en ;
    rdfs:comment "Leeds Digital Hub is a regional technology cluster centred in Leeds city centre, UK, that concentrates collaborative workspace, mentoring, and innovation infrastructure to support digital startups and established technology companies in healthtech, fintech, and digital creative sectors. It operates as a node within the broader UK Tech Ecosystem and North England Innovation Corridor, leveraging anchor institutions such as the University of Leeds and Leeds Teaching Hospitals NHS Trust to translate research into commercial ventures."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:digital-economy ],
        ngm:infra-computing-and-cloud ;
    skos:broader ngm:infra-computing-and-cloud ;
    vc:enables ngm:digital-economy ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:digital-economy ;
    vc:isPartOf ngm:north-england-innovation-corridor,
        ngm:uk-tech-ecosystem ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:digital-economy,
        ngm:north-england-innovation-corridor,
        ngm:uk-tech-ecosystem ;
    vc:slug "leeds-digital-hub" ;
    vc:sourceDomain "infrastructure" .

ngm:legged-robot a owl:Class ;
    rdfs:label "Legged Robot"@en ;
    rdfs:comment "A Legged Robot is a mobile robotic system that achieves locomotion via articulated limbs rather than wheels or tracks, drawing on bio-inspired design and gait control algorithms to navigate complex, unstructured terrain. Contemporary platforms combine reinforcement learning, sensor fusion, and compliant actuators to achieve robust autonomous operation across search-and-rescue, logistics, and infrastructure inspection scenarios."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:actuator ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:control-system ],
        ngm:robo-robot-type ;
    skos:broader ngm:robo-robot-type ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:actuator,
        ngm:control-system ;
    vc:isPartOf ngm:mobile-robot ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:relatedTo ngm:digital-twin,
        ngm:simulation ;
    vc:slug "legged-robot" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:reinforcement-learning,
        ngm:robot-operating-system,
        ngm:sensor-fusion .

ngm:lei-system a owl:Class ;
    rdfs:label "LEI System"@en ;
    rdfs:comment "The LEI System is the Global Legal Entity Identifier System, a federated infrastructure overseen by the GLEIF that issues, maintains, and publishes Legal Entity Identifiers and their reference data. It comprises a Regulatory Oversight Committee, accredited Local Operating Units, and an open global directory queryable by anyone. The system provides a single authoritative source for identifying legal entities in financial markets."@en ;
    rdfs:subClassOf ngm:infra-legal-and-regulatory ;
    skos:broader ngm:infra-legal-and-regulatory ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:legal-entity-identifier,
        ngm:regulatory-reporting ;
    vc:slug "lei-system" ;
    vc:sourceDomain "governance" .

ngm:lens-protocol a owl:Class ;
    rdfs:label "Lens Protocol"@en ;
    rdfs:comment "Lens Protocol is a decentralised social networking protocol in which user profiles and social connections are represented as on-chain assets."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:decentralised-identity ],
        ngm:decentralised-identity ;
    vc:enables ngm:web3 ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:decentralised-identity ;
    vc:slug "lens-protocol" ;
    vc:sourceDomain "blockchain" .

ngm:license a owl:Class ;
    rdfs:label "license"@en ;
    rdfs:comment "A legal instrument that specifies the permissions, conditions, and restrictions under which intellectual property — including software, data, and creative works — may be used, reproduced, modified, and distributed, forming the contractual basis for open-source and open-data ecosystems."@en ;
    rdfs:subClassOf ngm:infra-legal-and-regulatory ;
    skos:broader ngm:infra-legal-and-regulatory ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:copyright,
        ngm:digital-rights,
        ngm:digital-rights-management,
        ngm:open-source-software ;
    vc:slug "license" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:data-governance,
        ngm:open-standard .

ngm:lidar-sensor a owl:Class ;
    rdfs:label "LiDAR Sensor"@en ;
    rdfs:comment "A LiDAR sensor measures distance by emitting laser pulses and timing their reflections, producing dense 3D point clouds of the surrounding environment. Variants include mechanical spinning, solid-state, and flash designs that trade field of view, range, and cost. LiDAR is a cornerstone perception modality for autonomous robots, reality capture, and occupancy mapping."@en ;
    rdfs:subClassOf ngm:sensor ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:occupancy-grid,
        ngm:reality-capture-system ;
    vc:slug "lidar-sensor" ;
    vc:sourceDomain "robotics" .

ngm:light-curtain a owl:Class ;
    rdfs:label "Light Curtain"@en ;
    rdfs:comment "A Light Curtain is an optoelectronic safety device that creates an invisible infrared detection zone around hazardous machinery or robot work cells. When an object or person interrupts the beam matrix, the curtain triggers an emergency stop, enforcing compliance with ISO 8373 and IEC 61496 safety standards."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:functional-safety ],
        ngm:robo-safety-and-standards ;
    skos:broader ngm:robo-safety-and-standards ;
    vc:enables ngm:collaborative-robot ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:relatedTo ngm:cobot-safety-levels ;
    vc:requires ngm:functional-safety ;
    vc:slug "light-curtain" ;
    vc:sourceDomain "robotics" ;
    vc:standardizedBy ngm:iso-10218 ;
    vc:supports ngm:human-robot-interaction .

ngm:lindy-effect a owl:Class ;
    rdfs:label "Lindy Effect"@en ;
    rdfs:comment "The Lindy Effect is a heuristic stating that the future life expectancy of a non-perishable thing, such as a technology or idea, is proportional to its current age, so the longer it has survived the longer it is expected to persist. Popularised by Nassim Taleb, it implies robustness accrues through demonstrated longevity. In crypto discourse it is invoked to argue that Bitcoin's continued survival strengthens its credibility as a store of value."@en ;
    rdfs:subClassOf ngm:economic-mechanism ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:bitcoin,
        ngm:bitcoin-value-proposition ;
    vc:slug "lindy-effect" ;
    vc:sourceDomain "blockchain" .

ngm:linear-quadratic-regulator a owl:Class ;
    rdfs:label "Linear Quadratic Regulator"@en ;
    rdfs:comment "The Linear Quadratic Regulator (LQR) is an optimal control framework that computes the state-feedback gain matrix minimising a quadratic cost function — a weighted sum of squared state deviations and squared control inputs over a time horizon — for a linear dynamical system, yielding the globally optimal linear feedback law in closed form through the algebraic Riccati equation. LQR provides a principled, tunable controller where the designer specifies performance-energy trade-offs through cost weight matrices Q (penalising state error) and R (penalising control effort), and the solution guarantees both optimality with respect to this cost and closed-loop stability for controllable systems. Despite its linearity assumption, LQR is widely extended to nonlinear systems via linearisation, iterative LQR (iLQR), and as the backbone of linear-quadratic-Gaussian (LQG) control when combined with Kalman filtering."@en ;
    rdfs:subClassOf ngm:optimal-control ;
    vc:enables ngm:model-predictive-control,
        ngm:robot-control,
        ngm:trajectory-tracking ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:adaptive-control,
        ngm:pid-controller ;
    vc:slug "linear-quadratic-regulator" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:kalman-filter,
        ngm:stability-analysis,
        ngm:state-space-control .

ngm:link-prediction a owl:Class ;
    rdfs:label "Link Prediction"@en ;
    rdfs:comment "Link prediction is the machine-learning task of inferring missing or future edges in a graph from its observed structure and node attributes. Techniques range from similarity heuristics and matrix factorisation to graph neural networks and knowledge-graph embeddings. It underpins recommendation, knowledge-graph completion, and social-network analysis."@en ;
    rdfs:subClassOf ngm:machine-learning-technique ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:graph-analytics,
        ngm:knowledge-graphing ;
    vc:slug "link-prediction" ;
    vc:sourceDomain "ai" .

ngm:linked-data-platform a owl:Class ;
    rdfs:label "Linked Data Platform"@en ;
    rdfs:comment "A W3C specification defining rules and HTTP conventions for reading and writing linked data resources, enabling RESTful management of RDF data on the web."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:rdf ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:linked-data ],
        ngm:linked-data ;
    vc:enables ngm:semantic-web ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:linked-data,
        ngm:rdf ;
    vc:slug "linked-data-platform" ;
    vc:sourceDomain "general" .

ngm:liquid-cooling a owl:Class ;
    rdfs:label "Liquid Cooling"@en ;
    rdfs:comment "Liquid cooling is a thermal-management technique that removes heat from compute hardware using a circulating liquid coolant, which has far higher heat capacity than air. Implementations include direct-to-chip cold plates and full immersion in dielectric fluid, both enabling higher power densities and lower energy overhead. It is increasingly essential for cooling dense GPU clusters used in AI training and high-performance computing."@en ;
    rdfs:subClassOf ngm:infra-computing-and-cloud ;
    skos:broader ngm:infra-computing-and-cloud ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:compute-infrastructure,
        ngm:sustainability ;
    vc:slug "liquid-cooling" ;
    vc:sourceDomain "infrastructure" .

ngm:liverpool-smart-cities a owl:Class ;
    rdfs:label "Liverpool Smart Cities"@en ;
    rdfs:comment "Liverpool Smart Cities refers to the Merseyside city region's integrated programme of digital innovation, IoT deployment, and sustainable urban infrastructure targeting net-zero carbon status by 2030 and 100,000 new jobs by 2040. It encompasses city council strategy, university-led research (University of Liverpool, LJMU, Edge Hill), the Horizons innovation programme backed by the UK Shared Prosperity Fund, and partnerships driving smart transport, digital health, and climate technology."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:digital-infrastructure ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:sensor-data ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:io-t-sensor-network ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:io-t-sensors ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:edge-ai-for-smart-cities ],
        ngm:infra-computing-and-cloud ;
    skos:broader ngm:infra-computing-and-cloud ;
    vc:enables ngm:industrial-io-t,
        ngm:io-t-ai-integration ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:digital-infrastructure,
        ngm:edge-ai-for-smart-cities,
        ngm:io-t-sensor-network ;
    vc:isPartOf ngm:north-england-innovation-corridor,
        ngm:uk-tech-ecosystem ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:leeds-digital-hub,
        ngm:manchester-tech-cluster,
        ngm:newcastle-ai-and-health-innovation,
        ngm:sheffield-advanced-manufacturing ;
    vc:requires ngm:io-t-sensors,
        ngm:sensor-data ;
    vc:slug "liverpool-smart-cities" ;
    vc:sourceDomain "infrastructure" .

ngm:llama-index a owl:Class ;
    rdfs:label "LlamaIndex"@en ;
    rdfs:comment "LlamaIndex (formerly GPT Index) is an open-source data framework and Python library that provides the abstractions and tooling needed to connect large language models with external data sources through structured indexing, retrieval, and query pipelines, primarily enabling production-grade retrieval-augmented generation (RAG) applications. It handles the full pipeline from document ingestion and chunking, through embedding and vector storage, to query decomposition, retrieval, reranking, and response synthesis, providing high-level abstractions over underlying LLMs, embedding models, and vector databases. LlamaIndex is positioned as the data orchestration complement to LangChain's agent orchestration focus, with particular strength in structured data retrieval and multi-document reasoning."@en ;
    rdfs:subClassOf ngm:agent-frameworks ;
    vc:enables ngm:knowledge-graph-construction,
        ngm:retrieval-augmented-generation,
        ngm:semantic-search ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:information-retrieval,
        ngm:lang-chain ;
    vc:slug "llama-index" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:embeddings,
        ngm:large-language-models,
        ngm:vector-database .

ngm:lo-ra-wan a owl:Class ;
    rdfs:label "LoRaWAN"@en ;
    rdfs:comment "LoRaWAN is a media-access-control protocol and network architecture for low-power wide-area networks, built on the LoRa physical layer's chirp spread-spectrum modulation. It connects battery-powered devices to gateways over distances of several kilometres at low data rates, with end-to-end encryption and adaptive data-rate management. LoRaWAN is widely used for long-range, low-throughput IoT telemetry such as cold-chain and environmental monitoring."@en ;
    rdfs:subClassOf ngm:communication-protocol ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:cold-chain-monitoring,
        ngm:io-t-sensor-network ;
    vc:slug "lo-ra-wan" ;
    vc:sourceDomain "infrastructure" .

ngm:load-balancing a owl:Class ;
    rdfs:label "Load Balancing"@en ;
    rdfs:comment "Load balancing is the distribution of incoming work across multiple compute resources to maximise throughput, minimise latency, and avoid overloading any single node. It operates at network layers from L4 transport to L7 application routing, using algorithms such as round-robin, least-connections, and consistent hashing. Health checking and failover make it foundational to scalable, resilient distributed systems."@en ;
    rdfs:subClassOf ngm:distributed-systems ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:distributed-architecture,
        ngm:service-mesh ;
    vc:slug "load-balancing" ;
    vc:sourceDomain "infrastructure" .

ngm:local-explanation a owl:Class ;
    rdfs:label "Local Explanation"@en ;
    rdfs:comment "Interpretability techniques that explain individual model predictions for specific instances, providing insight into why a particular input produced a given output without necessarily characterising the model's global behaviour. Methods such as LIME and SHAP generate feature-attribution scores scoped to the neighbourhood of a single query point."@en ;
    rdfs:subClassOf ngm:model-interpretability,
        ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:contrastsWith ngm:global-explanation ;
    vc:enables ngm:accountability,
        ngm:fairness ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:explainable-ai ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:slug "local-explanation" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:feature-importance .

ngm:lock-and-mint-bridge a owl:Class ;
    rdfs:label "Lock-and-Mint Bridge"@en ;
    rdfs:comment "A lock-and-mint bridge is a cross-chain interoperability mechanism that transfers asset value between blockchains by locking the original asset in a custodial smart contract on the source chain and minting an equivalent synthetic (wrapped) representation on the destination chain, with the peg maintained by a network of validators or relayers who attest to the lock event."@en ;
    rdfs:subClassOf ngm:cross-chain-bridge ;
    vc:enables ngm:cross-chain-asset-transfer,
        ngm:cross-chain-interoperability ;
