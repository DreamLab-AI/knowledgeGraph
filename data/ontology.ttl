    vc:qualityScore "0.5"^^xsd:float ;
    vc:slug "immersive-experience-pipeline" ;
    vc:sourceDomain "spatial-computing" .

ngm:implementation-examples a owl:Class ;
    rdfs:label "implementation examples"@en ;
    rdfs:comment "Concrete, production-oriented code samples and reference designs demonstrating how theoretical concepts translate into functioning systems. In metaverse and blockchain contexts these span smart contract patterns (DeFi AMMs, NFT contracts, DAO governance), gas optimisation techniques, security patterns such as checks-effects-interactions, and upgradeability proxies. They serve as educational resources and accelerators for developers, reducing deployment risk through audited, annotated reference implementations."@en ;
    rdfs:subClassOf ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:enables ngm:decentralised-autonomous-organisation,
        ngm:decentralised-finance ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.4"^^xsd:float ;
    vc:slug "implementation-examples" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:digital-asset,
        ngm:smart-contracts ;
    vc:uses ngm:blockchain,
        ngm:smart-contract .

ngm:industry-cloud-platforms a owl:Class ;
    rdfs:label "Industry Cloud Platforms"@en ;
    rdfs:comment "Industry Cloud Platforms (ICPs) are collections of integrated cloud IT assets — including applications, data services, AI pipelines, and compliance tooling — tailored to the specific workflows, regulatory requirements, and data models of a vertical industry such as healthcare, financial services, manufacturing, or retail. They combine horizontal cloud infrastructure with deep domain knowledge, enabling organisations to run both vertical and cross-functional business applications on a unified platform while maintaining appropriate security controls. Gartner identified ICPs as a top strategic technology trend for 2024, driven by the need to reduce IT sprawl and accelerate industry-specific digital transformation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:regulatory-compliance ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:data-analytics ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:compliance-framework ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:platform-service ],
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:enables ngm:digital-transformation,
        ngm:healthcare-technology,
        ngm:supply-chain-management ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:compliance-framework,
        ngm:data-analytics,
        ngm:platform-service,
        ngm:regulatory-compliance ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:microservices-architecture,
        ngm:platform-engineering ;
    vc:slug "industry-cloud-platforms" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:cloud-infrastructure,
        ngm:cloud-native-applications,
        ngm:data-governance,
        ngm:enterprise-architecture .

ngm:intelligent-npc a owl:Class ;
    rdfs:label "Intelligent NPC"@en ;
    rdfs:comment "An Intelligent NPC (Non-Player Character) is a virtual agent in a game, simulation, or metaverse environment whose behaviour is driven by AI systems — typically combining perception, reasoning, planning, and natural-language interaction — rather than purely scripted or rule-based finite state machines. Modern intelligent NPCs leverage large language models for open-ended dialogue, reinforcement learning for adaptive combat and movement, and behavioural AI architectures (behaviour trees, goal-oriented action planning) to produce emergent, contextually appropriate responses to player actions and environmental stimuli. They form the interactive population of persistent virtual worlds and are central to immersive narrative experiences."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:behavioral-modeling ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:natural-language-processing ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:dialogue-system ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:behavioral-learning ],
        ngm:digital-humans ;
    vc:dependsOn ngm:conversational-ai,
        ngm:generative-ai,
        ngm:pathfinding-algorithm ;
    vc:enables ngm:immersive-experience,
        ngm:interactive-storytelling,
        ngm:npc-interaction ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:behavioral-learning,
        ngm:dialogue-system ;
    vc:isPartOf ngm:metaverse ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:avatar,
        ngm:character-model,
        ngm:game-mechanics,
        ngm:procedural-content-generation ;
    vc:requires ngm:behavioral-modeling,
        ngm:natural-language-processing ;
    vc:slug "intelligent-npc" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:agentic-ai,
        ngm:game-engine .

ngm:intelligent-virtual-entity a owl:Class ;
    rdfs:label "Intelligent Virtual Entity"@en ;
    rdfs:comment "AI-driven representation within a virtual world that responds adaptively to users and context, combining perception, reasoning, learning, and interaction capabilities to create sophisticated virtual presences."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
