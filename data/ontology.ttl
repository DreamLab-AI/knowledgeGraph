    vc:slug "api-standard" ;
    vc:sourceDomain "infrastructure" .

ngm:authentication-service a owl:Class ;
    rdfs:label "Authentication Service"@en ;
    rdfs:comment "An authentication service is a system component that verifies the identity of users, devices, or applications attempting to access protected resources."@en ;
