    vc:slug "real-time-transcription" ;
    vc:sourceDomain "artificial-intelligence" .
ngm:real-time-translation a owl:Class ;
    rdfs:comment "Real-time translation is the automatic conversion of spoken or written language content into one or more target languages with latency low enough to sustain live human communication, defined operationally as end-to-end processing delay below milliseconds for speech-to-speech pipelines and below 5..."@en ;
    rdfs:label "Real-time Translation"@en ;
