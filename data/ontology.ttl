        ngm:taproot ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:block-weight,
        ngm:witness-data,
        ngm:witness-discount ;
    vc:implements ngm:bip141,
        ngm:bip143,
        ngm:bip144 ;
    vc:isPartOf ngm:bitcoin-improvement-proposal,
        ngm:bitcoin-protocol ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:blockchain-scalability,
        ngm:digital-signature,
        ngm:transaction-throughput ;
    vc:requires ngm:bitcoin-script,
        ngm:soft-fork ;
    vc:slug "seg-wit" ;
    vc:sourceDomain "blockchain" ;
    vc:standardizedBy ngm:bitcoin-core ;
