    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:consent-management,
        ngm:data-minimisation,
        ngm:data-protection-impact-assessment,
        ngm:privacy-by-design ;
    vc:implements ngm:ccpa,
        ngm:gdpr,
        ngm:iso-29100 ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:anonymisation,
        ngm:biometric-data,
        ngm:pseudonymisation ;
    vc:requires ngm:access-control,
        ngm:audit-logging,
        ngm:encryption,
        ngm:zero-knowledge-proof ;
    vc:slug "privacy-framework" ;
    vc:sourceDomain "governance" ;
    vc:supports ngm:differential-privacy,
        ngm:digital-identity,
        ngm:federated-learning .

ngm:procedural-content-generation a owl:Class ;
