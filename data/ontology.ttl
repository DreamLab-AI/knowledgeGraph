    vc:requires ngm:tele-110-spatial-audio-processing ;
    vc:slug "virtual-reality-telepresence" ;
    vc:sourceDomain "distributed-collaboration" .

ngm:virtual-tourism a owl:Class ;
    rdfs:label "Virtual Tourism"@en ;
    rdfs:comment "The use of VR, AR, and metaverse technologies to explore travel destinations remotely, enabling users to experience locations, hotels, and attractions virtually before booking or as an alternative to physical travel, particularly for those with physical, economic, or accessibility constraints."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:real-time-rendering ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:virtual-reality ],
        ngm:sc-platform-and-environment,
        ngm:tourism-industry ;
