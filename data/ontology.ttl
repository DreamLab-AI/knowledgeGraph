ngm:hugging-face-diffusers a owl:Class ;
    rdfs:label "Hugging Face Diffusers"@en ;
    rdfs:comment "Hugging Face Diffusers is an open-source Python library that provides a modular, composable toolkit for training, fine-tuning, and running inference with state-of-the-art diffusion models for image, audio, and video generation. The library abstracts the scheduling, noise prediction, and decoder stages of diffusion pipelines behind a consistent API, exposing interchangeable components — noise schedulers (DDPM, DDIM, DPM-Solver), denoising U-Net or Diffusion Transformer (DiT) backbones, and variational autoencoders — that researchers can recombine freely. It integrates natively with the Hugging Face Hub for model discovery, versioning, and model-card governance, and supports PyTorch and JAX as compute backends with optional xFormers memory-efficient attention and Accelerate-based distributed training."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:noise-schedule ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:variational-autoencoder ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:u-net ],
        ngm:cat-ai-infrastructure ;
    skos:broader ngm:cat-ai-infrastructure ;
    vc:bridgesTo ngm:augmented-reality-content-creation,
        ngm:spatial-computing ;
    vc:contrastsWith ngm:generative-adversarial-network,
        ngm:variational-autoencoder ;
    vc:dependsOn ngm:hugging-face-hub,
        ngm:transformers-library ;
    vc:enables ngm:audio-generation,
        ngm:fine-tuning,
        ngm:image-generation,
        ngm:inpainting,
        ngm:text-to-image,
        ngm:video-generation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:noise-schedule,
        ngm:u-net,
        ngm:variational-autoencoder ;
    vc:implements ngm:latent-diffusion,
        ngm:score-based-generative-model ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:clip,
        ngm:generative-ai,
        ngm:hugging-face-model-hub,
        ngm:stable-diffusion-image-model ;
    vc:slug "hugging-face-diffusers" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:control-net,
        ngm:kohya-dreambooth-and-similar,
        ngm:lora,
        ngm:textual-inversion ;
    vc:uses ngm:diffusion-model,
        ngm:hugging-face-accelerate,
        ngm:jax,
        ngm:python-pytorch-deep-learning-stack .

ngm:humanoid-robotics a owl:Class ;
    rdfs:label "Humanoid Robotics"@en ;
    rdfs:comment "Humanoid robotics is the subfield of robotics concerned with the design, construction, and control of robots that exhibit a human-like morphology, typically including a bipedal lower body and articulated upper limbs. Such robots are engineered to operate in environments built for humans, using the same tools, furniture, and physical interfaces. Key technical challenges include stable bipedal locomotion across uneven terrain, dexterous manipulation of varied objects, real-time perception and planning under uncertainty, and safe physical interaction with humans. Advances in machine learning and actuator technology have accelerated commercial deployments in manufacturing, logistics, and care."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:whole-body-control ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:dexterous-manipulation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:actuator ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:proprioception ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:real-time-control ],
        ngm:humanoid-robot ;
    vc:bridgesTo ngm:artificial-intelligence,
        ngm:spatial-computing ;
    vc:dependsOn ngm:robot-kinematics,
        ngm:sim-to-real-transfer ;
    vc:enables ngm:assistive-robotics,
        ngm:autonomous-manipulation,
        ngm:collaborative-systems-modality-robot ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:bipedal-locomotion,
        ngm:dexterous-manipulation,
        ngm:whole-body-control ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:embodied-ai,
        ngm:human-robot-interaction,
        ngm:legged-locomotion,
        ngm:manipulation,
        ngm:robot-perception,
        ngm:tactile-sensing ;
    vc:requires ngm:actuator,
        ngm:proprioception,
        ngm:real-time-control ;
    vc:slug "humanoid-robotics" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:imitation-learning,
        ngm:model-predictive-control,
        ngm:motion-planning,
        ngm:reinforcement-learning,
        ngm:sensor-fusion .

ngm:hybrid-retrieval a owl:Class ;
    rdfs:label "Hybrid Retrieval"@en ;
    rdfs:comment "Hybrid retrieval is an information-retrieval technique that combines lexical (sparse, keyword-based) scoring such as BM25 with semantic (dense, embedding-based) vector search to rank documents. By fusing the complementary strengths of exact-term matching and meaning-based similarity, it improves recall and precision over either method alone. Fusion is typically performed with reciprocal rank fusion or weighted score combination."@en ;
    rdfs:subClassOf ngm:information-retrieval ;
    vc:enables ngm:ai-search ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:semantic-search ;
    vc:slug "hybrid-retrieval" ;
    vc:sourceDomain "ai" .

ngm:incentive-compatibility a owl:Class ;
    rdfs:label "Incentive Compatibility"@en ;
    rdfs:comment "A property of a mechanism or protocol in which every participant's dominant strategy is to act truthfully, such that honest reporting of private information is individually rational. Incentive compatibility ensures that the designed rules align agents' self-interest with socially desirable outcomes, eliminating the benefit of strategic misrepresentation."@en ;
    rdfs:subClassOf ngm:mechanism-design ;
    vc:enables ngm:automated-market-maker,
        ngm:decentralized-finance-de-fi ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:dao-governance,
        ngm:game-theory,
        ngm:tokenomics ;
    vc:slug "incentive-compatibility" ;
    vc:sourceDomain "finance" ;
    vc:uses ngm:smart-contract .

ngm:industrial-robotics a owl:Class ;
    rdfs:label "Industrial Robotics"@en ;
    rdfs:comment "Industrial robotics is the application of programmable, reprogrammable robots to manufacturing tasks including assembly, welding, material handling, painting and inspection, operating within structured production environments to improve consistency, throughput and safety."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
