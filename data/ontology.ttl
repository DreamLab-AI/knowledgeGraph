    vc:slug "cryptographic-key-management" ;
    vc:sourceDomain "blockchain" .

vf:cryptography-security-and-privacy a owl:Class ;
    rdfs:label "Cryptography Security and Privacy"@en ;
    rdfs:comment "Cryptography Security and Privacy denotes the cross-disciplinary infrastructure layer combining mathematical primitives (symmetric encryption AES-GCM/ChaCha20-Poly1305/ASCON-128 NIST lightweight finalist February 2023, hash functions SHA-2/SHA-3 Keccak/BLAKE3 throughput 6.8 GB/s single-thread, password hashing Argon2id RFC 9106/bcrypt/scrypt RFC 7914, asymmetric RSA-2048/4096, elliptic-curve ECDH X25519/NIST P-256/P-384/P-521, digital signatures EdDSA Ed25519 RFC 8032/Schnorr BIP-340, post-quantum NIST FIPS 203 ML-KEM CRYSTALS-Kyber August 2024/FIPS 204 ML-DSA CRYSTALS-Dilithium/FIPS 205 SLH-DSA SPHINCS+/FIPS 206 FN-DSA Falcon draft 2025), advanced protocols (zero-knowledge proofs zk-SNARKs Groth16/PLONK/Halo2 recursive composition, zk-STARKs StarkWare transparent quantum-resistant 100K-1M constraints/second, Bulletproofs range proofs without trusted setup, fully homomorphic encryption FHE Microsoft SEAL/IBM HELib/OpenFHE/Zama Concrete/fhEVM Aleo Penumbra 2024 bootstrapping 10ms-1s per gate, secure multi-party computation SPDZ active security/MASCOT OT-based/AGMPC garbled circuits/Inpher Sepior threshold signing 2-of-3 to n-of-n), trusted execution environments (Intel SGX deprecate"@en ;
    rdfs:subClassOf <urn:visionflow:linked:applied-mathematics>,
        <urn:visionflow:linked:computer-science>,
        <urn:visionflow:linked:privacy-engineering>,
        <urn:visionflow:linked:trusted-computing>,
        vf:information-security ;
    vc:authorityScore "0.87"^^xsd:float ;
    vc:enables <urn:visionflow:linked:anonymous-communication>,
        <urn:visionflow:linked:authentication>,
        <urn:visionflow:linked:confidentiality>,
        <urn:visionflow:linked:data-integrity>,
        <urn:visionflow:linked:end-to-end-encryption>,
        <urn:visionflow:linked:privacy-preserving-computation>,
        <urn:visionflow:linked:verifiable-computation>,
        vf:confidential-computing,
        vf:non-repudiation ;
    vc:hasPart <urn:visionflow:linked:homomorphic-encryption>,
        <urn:visionflow:linked:key-exchange>,
        <urn:visionflow:linked:message-authentication-code>,
        <urn:visionflow:linked:trusted-execution-environment>,
        vf:differential-privacy,
        vf:digital-signature,
        vf:hash-function,
        vf:key-derivation-function,
        vf:post-quantum-cryptography,
        vf:public-key-cryptography,
        vf:random-number-generation,
        vf:secure-multi-party-computation,
        vf:symmetric-encryption,
        vf:zero-knowledge-proof ;
    vc:implements <urn:visionflow:linked:aes-gcm>,
        <urn:visionflow:linked:argon2>,
        <urn:visionflow:linked:blake3>,
        <urn:visionflow:linked:cha-cha20-poly1305>,
        <urn:visionflow:linked:ed25519>,
        <urn:visionflow:linked:ml-dsa>,
        <urn:visionflow:linked:ml-kem>,
        <urn:visionflow:linked:schnorr-signatures>,
        <urn:visionflow:linked:sha-3>,
        <urn:visionflow:linked:signal-protocol>,
        <urn:visionflow:linked:slh-dsa>,
        <urn:visionflow:linked:tls-1-3>,
        <urn:visionflow:linked:x25519> ;
    vc:maturity "production-ready" ;
    vc:qualityScore "0.52"^^xsd:float ;
    vc:requires <urn:visionflow:linked:computational-hardness-assumption>,
        <urn:visionflow:linked:cryptographic-library>,
        <urn:visionflow:linked:entropy-source>,
        <urn:visionflow:linked:key-management>,
        <urn:visionflow:linked:mathematical-foundations>,
        <urn:visionflow:linked:random-oracle-model>,
        vf:standards-compliance ;
    vc:slug "cryptography-security-and-privacy" ;
    vc:sourceDomain "infrastructure" .

