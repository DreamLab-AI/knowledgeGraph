ngm:reinforcement-learning-from-human-feedback a owl:Class ;
    rdfs:label "Reinforcement Learning from Human Feedback"@en ;
    rdfs:comment "A technique for aligning language models with human preferences by training a reward model from human rankings of outputs and using reinforcement learning (typically PPO) to optimise the policy towards maximising predicted human preference."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:human-feedback ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:supervised-fine-tuning ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:reward-model ],
        ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:contrastsWith ngm:direct-preference-optimisation ;
    vc:enables ngm:ai-alignment,
        ngm:large-language-models ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires ngm:human-feedback,
        ngm:reward-model,
        ngm:supervised-fine-tuning ;
    vc:slug "reinforcement-learning-from-human-feedback" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:tool-use a owl:Class ;
    rdfs:label "Tool Use"@en ;
    rdfs:comment "Tool Use is the capability of large language models and AI agent systems to invoke external functions, APIs, databases, or services at inference time, extending the model's effective knowledge and action repertoire beyond pure text generation. The model receives a structured description of available tools (a tool schema), reasons about which tool to call and with what arguments, and incorporates the returned result into its response. This capability is foundational to agentic AI systems that must take real-world actions such as code execution, web search, database queries, or actuator control."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:function-calling ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:tool-schema ],
        ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:enables ngm:agentic-ai,
        ngm:retrieval-augmented-generation ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:large-language-models,
        ngm:model-context-protocol ;
    vc:requires ngm:function-calling,
        ngm:tool-schema ;
    vc:slug "tool-use" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:vector-database a owl:Class ;
    rdfs:label "Vector Database"@en ;
    rdfs:comment "A vector database is a specialised data storage and retrieval system optimised for indexing and querying high-dimensional dense vectors (embeddings) using approximate nearest-neighbour (ANN) search algorithms such as HNSW, IVF-PQ, and ScaNN. These systems support efficient similarity search over millions to billions of embedding vectors representing text, images, or multimodal content, enabling retrieval-augmented generation, semantic search, and recommendation at scale. Vector databases typically provide filtering on structured metadata in conjunction with vector similarity, persistence, and versioning capabilities beyond what generic ANN libraries offer."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:embedding-model ],
        ngm:ai-infrastructure ;
    vc:enables ngm:retrieval-augmented-generation,
        ngm:semantic-search ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:information-retrieval,
        ngm:nearest-neighbor-search,
        ngm:search-index ;
    vc:requires ngm:embedding-model ;
    vc:slug "vector-database" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:cryptographic-key-management a owl:Class ;
    rdfs:label "Cryptographic Key Management"@en ;
    rdfs:comment "The administration of cryptographic keys throughout their lifecycle, including generation, storage, distribution, rotation, backup, recovery, and destruction, ensuring the security and availability of keying material while preventing unauthorized access or compromise."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:random-number-generation ],
        ngm:bc-cryptographic-primitive,
        ngm:cryptography ;
    skos:broader ngm:bc-cryptographic-primitive ;
    vc:enables ngm:digital-signature ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires ngm:random-number-generation ;
    vc:slug "cryptographic-key-management" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:key-derivation-function .

ngm:cryptographic-signature a owl:Class ;
    rdfs:label "Cryptographic Signature"@en ;
    rdfs:comment "A cryptographic signature is a mathematical construction that allows a signing party to attach an unforgeable, verifiable proof of origin and integrity to a message or transaction, providing both authenticity and non-repudiation. Signatures are computed from the message content and the signer's private key using an asymmetric cryptographic algorithm; any party possessing the corresponding public key can independently verify the signature without learning the private key. Common schemes include ECDSA, Ed25519, and RSA-PSS, each with distinct performance and security profiles relevant to their deployment context."@en ;
    rdfs:subClassOf ngm:bc-cryptographic-primitive ;
    skos:broader ngm:bc-cryptographic-primitive ;
    vc:enables ngm:blockchain,
        ngm:digital-signature ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:ed25519 ;
    vc:slug "cryptographic-signature" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:hash-function,
        ngm:public-key-cryptography .

ngm:dao a owl:Class ;
    rdfs:label "DAO"@en ;
    rdfs:comment "Decentralised Autonomous Organisation operating through transparent code-based rules and distributed governance rather than hierarchical management, enabling community coordination at scale."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:smart-contract-platform ],
        ngm:bc-governance-and-regulation ;
    skos:broader ngm:bc-governance-and-regulation ;
    vc:enables ngm:decentralized-governance ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.4"^^xsd:float ;
    vc:relatedTo ngm:blockchain-infrastructure,
        ngm:dao-governance ;
    vc:requires ngm:smart-contract-platform ;
    vc:slug "dao" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:governance-token,
        ngm:smart-contract .

ngm:distributed-ledger-technology a owl:Class ;
    rdfs:label "Distributed Ledger Technology"@en ;
    rdfs:comment "Distributed Ledger Technology (DLT) refers to a class of decentralised database protocols in which transaction records are replicated, shared, and synchronised across multiple networked nodes without a central administrator. Consensus mechanisms — such as proof-of-work, proof-of-stake, and Byzantine fault-tolerant protocols — ensure agreement on the canonical state of the ledger. DLT underpins blockchain networks, permissioned enterprise ledgers, and novel consensus architectures used in finance, supply chain, and identity management."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:blockchain ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:consensus-mechanism ],
        ngm:bc-network-component ;
    skos:broader ngm:bc-network-component ;
    vc:enables ngm:decentralised-finance,
        ngm:smart-contract ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:blockchain,
        ngm:consensus-mechanism ;
    vc:qualityScore "0.3"^^xsd:float ;
    vc:relatedTo ngm:blockchain-governance,
        ngm:financial-regulation ;
    vc:slug "distributed-ledger-technology" ;
    vc:sourceDomain "blockchain" .

ngm:finality a owl:Class ;
    rdfs:label "Finality"@en ;
    rdfs:comment "The property of a blockchain transaction or block whereby it becomes irreversible and cannot be reverted by any future state of the network. Probabilistic finality—as in proof-of-work chains—increases with confirmation depth, while deterministic finality—as in BFT-based protocols—is achieved at the point of commitment, with strong consequences for payment settlement, cross-chain interoperability, and user trust."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:probabilistic-finality ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:deterministic-finality ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:consensus-protocol ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:transaction-finality ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:transaction-confirmation ],
        ngm:bc-protocol-and-consensus,
        ngm:blockchain-entity ;
    skos:broader ngm:bc-protocol-and-consensus ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:deterministic-finality,
        ngm:probabilistic-finality,
        ngm:transaction-finality ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:blockchain-transaction,
        ngm:chain-reorganization,
        ngm:nakamoto-consensus,
        ngm:proof-of-stake ;
    vc:requires ngm:consensus-protocol,
        ngm:transaction-confirmation ;
    vc:slug "finality" ;
    vc:sourceDomain "blockchain" .

ngm:perception-system a owl:Class ;
    rdfs:label "Perception System"@en ;
    rdfs:comment "A Perception System is the sensor processing and environmental understanding component of Autonomous Systems that interprets raw Sensor Data to build a coherent representation of the surrounding environment, including Object Detection, Classification, Tracking,"@en ;
    rdfs:subClassOf ngm:ai-technique,
        ngm:autonomous-system ;
    skos:broader ngm:ai-technique ;
    vc:enables ngm:autonomous-navigation,
        ngm:environmental-mapping,
        ngm:object-recognition,
        ngm:situational-awareness ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:ai-agent-system,
        ngm:autonomous-system,
        ngm:intelligent-virtual-entity,
        ngm:robotics-systems ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:slug "perception-system" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:point-cloud a owl:Class ;
    rdfs:label "Point Cloud"@en ;
    rdfs:comment "A Point Cloud is a set of data points in three-dimensional space, each defined by X, Y, Z coordinates and optionally colour or intensity values, produced by LiDAR scanners, depth cameras, or photogrammetry pipelines. Point clouds serve as the raw geometric representation of real-world objects and environments before downstream processing into meshes, 3D models, or spatial maps. They are fundamental to SLAM, 3D reconstruction, and digital twin workflows in spatial computing."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:depth-sensing ],
        ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:enables ngm:3-d-reconstruction,
        ngm:spatial-mapping ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:relatedTo ngm:photogrammetry,
        ngm:sensor-fusion,
        ngm:slam ;
    vc:requires ngm:depth-sensing ;
    vc:slug "point-cloud" ;
    vc:sourceDomain "spatial-computing" .

ngm:user-experience a owl:Class ;
    rdfs:label "User Experience"@en ;
    rdfs:comment "User Experience (UX) is the totality of perceptions, responses, and outcomes that a person encounters when interacting with a product or system, spanning functional usability, aesthetic appeal, emotional resonance, accessibility, and long-term satisfaction. In spatial and immersive computing contexts, UX additionally encompasses physical comfort, motion sickness mitigation, spatial audio fidelity, haptic feedback, and the cognitive load imposed by three-dimensional interaction paradigms. UX design is an iterative discipline informed by user research, prototyping, and empirical evaluation methods including heuristic analysis and usability testing."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:user-research ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:human-factors ],
        ngm:sc-interaction ;
    skos:broader ngm:sc-interaction ;
    vc:enables ngm:immersive-experience ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:accessibility,
        ngm:human-computer-interaction ;
    vc:requires ngm:human-factors,
        ngm:user-research ;
    vc:slug "user-experience" ;
    vc:sourceDomain "spatial-computing" .

ngm:virtual-environment a owl:Class ;
    rdfs:label "Virtual Environment"@en ;
    rdfs:comment "A simulated three-dimensional (3D) digital space created with computer hardware and software that enables users to explore, interact, and experience an immersive surrounding approximating reality, accessed through devices such as VR headsets, AR glasses, or standard displays."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:spatial-audio ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:avatar ],
        ngm:metaverse,
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:enables ngm:digital-twin,
        ngm:immersive-experience ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:avatar,
        ngm:spatial-audio ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:slug "virtual-environment" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:extended-reality,
        ngm:xr-hardware .

ngmi:anthropic-claude a owl:NamedIndividual,
        ngm:proprietary-large-language-models ;
    rdfs:label "Anthropic Claude"@en ;
    rdfs:comment "Anthropic Claude is a family of large language models developed by Anthropic PBC, designed around Constitutional AI principles that prioritise safety, helpfulness, and honesty. The model series spans Claude Instant, Claude 2, Claude 3 (Haiku, Sonnet, Opus), and Claude 3.5, with each generation advancing reasoning, coding, and multilingual capabilities. Claude is distinguished by its long context windows (up to 200k tokens in Claude 3) and its training methodology that emphasises harmlessness through RLHF and Constitutional AI feedback loops."@en ;
    vc:contrastsWith ngmi:chat-gpt,
        ngmi:gemini ;
    vc:dependsOn ngm:deep-learning,
        ngm:model-training ;
    vc:enables ngm:ai-alignment,
        ngm:conversational-ai ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:constitutional-ai,
        ngm:instruction-tuning ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:anthropic,
        ngm:constitutional-ai,
        ngm:large-language-models,
        ngm:rlhf ;
    vc:slug "anthropic-claude" ;
    vc:sourceDomain "ai" ;
    vc:supports ngm:ai-safety,
        ngm:responsible-ai .

