            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:public-key ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:random-number-generator ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:hardware-security-module ],
        ngm:bc-cryptographic-primitive ;
    skos:broader ngm:bc-cryptographic-primitive ;
    vc:bridgesTo ngm:public-key-infrastructure ;
    vc:enables ngm:credential-issuance,
        ngm:decentralised-trust,
        ngm:message-signing,
        ngm:peer-authentication,
        ngm:self-sovereign-identity ;
    vc:hasMaturity ngmi:maturity-established ;
