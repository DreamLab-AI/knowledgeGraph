        ngm:data-warehouse ;
    vc:requires ngm:file-format ;
    vc:slug "apache-parquet" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:apache-spark,
        ngm:schema-evolution ;
    vc:uses ngm:columnar-storage,
        ngm:data-serialization .

ngm:api-economy a owl:Class ;
    rdfs:label "Api Economy"@en ;
    rdfs:comment "The API economy is the ecosystem of business value created when organisations expose their data and services as application-programming interfaces that other parties can consume, compose, and monetise. By packaging capabilities as products, firms turn internal functions into reusable building blocks that partners and developers integrate, enabling new revenue streams, faster innovation, and platform network effects. It underpins models such as open banking and embedded services, and its growth depends on robust API management, gateways, and developer experience to govern access, security, and consumption at scale."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:api ],
        [ a owl:Restriction ;
