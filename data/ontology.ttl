ngm:key-vector a owl:Class ;
    rdfs:label "Key Vector"@en ;
    rdfs:comment "In transformer-based neural networks, a Key Vector is one of three learned linear projections of an input token embedding—alongside the Query Vector and Value Vector—that together implement the scaled dot-product attention mechanism. The key vector represents what a given token has to offer: each query–key dot product measures the compatibility or relevance between a querying token and every other token in the sequence, with the resulting attention weights determining how much each value vector contributes to the output representation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:transformer ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:token-embedding ],
        ngm:neural-network-component ;
    vc:enables ngm:semantic-search,
        ngm:vector-database ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:attention-mechanism,
        ngm:multi-head-attention ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:positional-encoding,
        ngm:query-key-value,
        ngm:query-vector,
        ngm:self-attention,
        ngm:value-vector ;
    vc:requires ngm:token-embedding,
        ngm:transformer ;
    vc:slug "key-vector" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:embedding-model .

ngm:knowledge-graph-diagnostic-node a owl:Class ;
    rdfs:label "Knowledge Graph Diagnostic Node"@en ;
    rdfs:comment "A debug linked node is a diagnostic artefact within a knowledge graph or ontology system — a placeholder page that is deliberately linked to from another node in order to verify that the wikilink resolution, graph edge creation, and link-traversal mechanisms are functioning correctly. It serves as a test fixture for the ontology pipeline, confirming that bidirectional link references are parsed, stored as edges, and retrievable through graph queries."@en ;
    rdfs:subClassOf ngm:infra-software-engineering ;
    skos:broader ngm:infra-software-engineering ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:knowledge-graph ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:distributed-logseq-knowledge-network,
        ngm:linked-data,
        ngm:node,
        ngm:software-testing ;
    vc:slug "knowledge-graph-diagnostic-node" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:knowledge-graph-construction .

ngm:knowledge-graph-presentation-session-artefact a owl:Class ;
    rdfs:label "Knowledge Graph Presentation Session Artefact"@en ;
    rdfs:comment "Today Presentation 2 is a knowledge-graph page capturing the content or embedded block reference for a second working presentation session, likely associated with DreamLab AI's applied research and demonstration programme. As a session artefact it serves as a container node linking to embedded Logseq blocks that hold presentation slides, notes, or structured outputs. It connects to broader themes of knowledge representation, immersive technology, and responsible AI governance that form DreamLab's public-facing educational work."@en ;
