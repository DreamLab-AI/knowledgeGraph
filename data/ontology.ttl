ngm:audit-logging a owl:Class ;
    rdfs:label "Audit Logging"@en ;
    rdfs:comment "Audit logging is the systematic, tamper-evident recording of security-relevant events, user actions, and system operations to an immutable or append-only store, enabling retrospective forensic analysis, regulatory compliance, and incident response. Each log entry captures who performed an action, what was performed, when, from where, and the outcome, providing an authoritative chain of evidence. Audit logs are distinct from general application logs by their integrity guarantees and structured, queryable format."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:access-control ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:trusted-timestamping ],
        ngm:audit-log ;
    vc:bridgesTo ngm:blockchain-immutability,
        ngm:data-provenance ;
    vc:dependsOn ngm:cryptographic-hash-function ;
    vc:enables ngm:algorithmic-auditing,
        ngm:compliance-verification,
        ngm:forensic-analysis,
        ngm:incident-response,
        ngm:non-repudiation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:identity-and-access-management,
        ngm:security-information-and-event-management ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:cybersecurity,
        ngm:information-security ;
    vc:requires ngm:access-control,
        ngm:trusted-timestamping ;
    vc:slug "audit-logging" ;
    vc:sourceDomain "security" ;
    vc:standardizedBy ngm:iso-iec-27001,
        ngm:nist ;
    vc:supports ngm:audit-trail,
        ngm:compliance-framework,
        ngm:compliance-monitoring,
        ngm:regulatory-reporting,
        ngm:zero-trust-architecture .

ngm:content-addressing a owl:Class ;
    rdfs:label "Content Addressing"@en ;
    rdfs:comment "The fundamental principle (R1 in ADR-013) that derives a resource's URI deterministically from its Content Hash|cryptographic content hash (SHA-256), ensuring immutability, tamper-detection, and deduplication, enabling VisionClaw Agentic Container|VisionClaw artefacts (credentials, receip..."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:deterministic-serialisation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptographic-hash-function ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:canonical-json ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:sha-256-hashing ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:content-identifier ],
        ngm:bc-network-component ;
    skos:broader ngm:bc-network-component ;
