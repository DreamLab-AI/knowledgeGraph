ngm:civil-service-job a owl:Class ;
    rdfs:label "civil service job"@en ;
    rdfs:comment "A civil service job is a public-sector employment position within a government department or agency, typically accessed through competitive application. This page specifically records a Principal Technologist vacancy at the UK Government Digital Service (OCTO), covering AI and platform technology leadership at Grade 6 level — relevant context for career decisions and the AI policy landscape."@en ;
    rdfs:subClassOf ngm:infra-software-engineering ;
    skos:broader ngm:infra-software-engineering ;
    vc:dependsOn ngm:cloud-infrastructure,
        ngm:open-source-software ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:artificial-intelligence,
        ngm:digital-transformation,
        ngm:platform-engineering ;
    vc:slug "civil-service-job" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:machine-learning,
        ngm:software-architecture .

