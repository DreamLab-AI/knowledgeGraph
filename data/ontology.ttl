ngm:session-management a owl:Class ;
    rdfs:label "Session Management"@en ;
    rdfs:comment "Session management is the set of mechanisms by which a networked system creates, maintains, secures, and terminates bounded interaction contexts — called sessions — between a client and a server or distributed service. It encompasses token issuance and validation, state serialisation and synchronisation, session expiry and renewal, concurrent-session policy, and secure revocation. Session management bridges authentication (establishing identity) and authorisation (enforcing capability) by preserving verified context across otherwise stateless request–response cycles. It is a foundational layer for any multi-user application, from web platforms and APIs to real-time collaborative environments and spatial computing runtimes."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:identity-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:token ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:authentication ],
        ngm:infra-security-and-identity ;
    skos:broader ngm:infra-security-and-identity ;
    vc:bridgesTo ngm:digital-twin,
        ngm:spatial-computing ;
    vc:contrastsWith ngm:stateless-architecture ;
    vc:dependsOn ngm:key-management,
        ngm:transport-layer-security ;
    vc:enables ngm:api,
        ngm:multi-user-systems,
        ngm:persistent-state,
        ngm:single-sign-on ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:cloud-infrastructure,
