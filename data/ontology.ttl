ngm:functional-analysis a owl:Class ;
    rdfs:label "Functional Analysis"@en ;
    rdfs:comment "Functional analysis is the branch of mathematics studying vector spaces with a notion of limit, such as Banach and Hilbert spaces, and the linear operators acting on them. It underlies much of modern analysis and its applications."@en ;
