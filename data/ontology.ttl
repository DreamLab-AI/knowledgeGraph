ngm:cobot-safety-levels a owl:Class ;
    rdfs:label "Cobot Safety Levels"@en ;
    rdfs:comment "Standardized safety classifications and requirements for collaborative robots (cobots) operating in shared workspaces with humans, defining protection measures, risk assessments, and operational modes to ensure safe human-robot interaction according to ISO/TS 15066."@en ;
