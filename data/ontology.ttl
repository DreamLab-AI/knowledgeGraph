ngm:cybersecurity-framework a owl:Class ;
    rdfs:comment "A cybersecurity framework is a structured set of standards, guidelines and practices that organisations use to identify, protect against, detect, respond to and recover from cyber threats. Frameworks such as the NIST Cybersecurity Framework provide a common taxonomy and maturity model for managing security risk in a repeatable, auditable way. They align technical controls with governance, risk management and regulatory obligations."@en ;
    rdfs:label "Cybersecurity Framework"@en ;
    rdfs:subClassOf ngm:security-framework ;
    rdfs:subClassOf _:r6553 ;
