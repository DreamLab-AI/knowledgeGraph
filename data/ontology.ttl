ngm:carbon-footprint-assessment a owl:Class ;
    rdfs:label "Carbon Footprint Assessment"@en ;
    rdfs:comment "A comprehensive emodology that quantifies total greenhouse gas emissions associated with a product, service, or organization across its entire lifecycle using Life Cycle Assessment principles, expressed in CO2 equivalent units to identify emission hotspots and reduction opportunities."@en ;
    rdfs:subClassOf ngm:environmental-assessment ;
    vc:enables ngm:hotspot-identification,
        ngm:impact-quantification,
        ngm:reduction-strategy ;
    vc:maturity "draft" ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires ngm:boundary-definition,
        ngm:emission-factors,
        ngm:lifecycle-data ;
    vc:slug "carbon-footprint-assessment" ;
    vc:sourceDomain "spatial-computing" .

ngm:carbon-footprint-indicator a owl:Class ;
    rdfs:label "Carbon Footprint Indicator"@en ;
    rdfs:comment "A quantitative environmental performance metric that measures and tracks an organization's greenhouse gas emissions in CO2 equivalent units, serving as a key sustainability KPI for monitoring progress toward emission reduction targets and enabling comparative analysis across operations."@en ;
    rdfs:subClassOf ngm:environmental-kpi ;
    vc:enables ngm:benchmarking,
        ngm:performance-monitoring,
        ngm:target-tracking ;
    vc:maturity "draft" ;
