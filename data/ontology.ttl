ngm:cloud-storage a owl:Class ;
    rdfs:label "Cloud Storage"@en ;
    rdfs:comment "Cloud storage is a model of data storage in which digital data is persisted on remote servers managed by a cloud service provider and accessed over a network, typically the internet, rather than on local hardware. Providers maintain redundant, geographically distributed infrastructure to ensure durability, availability, and scalability, charging users based on capacity consumed and data transfer volume. Cloud storage underpins object storage services (such as Amazon S3, Google Cloud Storage, and Azure Blob Storage), file synchronisation services, and database backup systems. It is a foundational component of cloud computing infrastructure and modern application architectures."@en ;
    rdfs:subClassOf ngm:data-storage ;
    vc:contrastsWith ngm:content-addressed-storage,
        ngm:distributed-storage ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:cloud-infrastructure,
        ngm:cloud-platform,
        ngm:data-management,
        ngm:decentralized-storage ;
    vc:slug "cloud-storage" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:cloud-computing,
        ngm:content-delivery-network,
        ngm:encryption .

ngm:compute-resources a owl:Class ;
    rdfs:label "Compute Resources"@en ;
    rdfs:comment "Compute resources are the aggregate processing capacity available to execute computational workloads, encompassing CPUs, GPUs, specialised accelerators (TPUs, NPUs), memory, network bandwidth, and associated storage I/O. They are quantified by metrics such as FLOPS, memory bandwidth, core count, and clock speed, and are provisioned via physical hardware, virtualised cloud instances, or serverless functions. Effective allocation and scheduling of compute resources is the foundational concern of cloud computing, high-performance computing, and AI infrastructure."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:compute-layer ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:gpu-resources ],
        ngm:computational-resources ;
    vc:enables ngm:gpu-computing,
        ngm:high-performance-computing,
        ngm:model-training ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:compute-layer,
        ngm:gpu-resources ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:ai-infrastructure,
        ngm:cloud-computing ;
    vc:slug "compute-resources" ;
    vc:sourceDomain "infrastructure" .

ngm:content-addressed-storage a owl:Class ;
    rdfs:label "Content-Addressed Storage"@en ;
    rdfs:comment "Content-addressed storage (CAS) is a data storage paradigm in which each piece of data is identified and retrieved by a cryptographic hash of its content rather than by its location or a human-assigned name. Because the identifier is derived deterministically from the data itself, identical content always maps to the same address, enabling automatic deduplication and verifiable integrity without requiring trust in the storage provider. Content-addressed storage forms the basis of systems such as IPFS, Git, and Arweave, and underlies the content-integrity mechanisms of blockchain data layers. It is fundamentally different from location-addressed storage, where the same content can exist at multiple addresses or the same address can point to different content over time."@en ;
    rdfs:subClassOf ngm:data-storage ;
    vc:enables ngm:cryptographic-verification,
        ngm:data-availability ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:arweave,
        ngm:decentralized-storage,
        ngm:distributed-storage,
        ngm:ipfs ;
    vc:slug "content-addressed-storage" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:content-addressing,
        ngm:cryptographic-hash,
        ngm:merkle-tree .

ngm:credential-verification a owl:Class ;
    rdfs:label "Credential Verification"@en ;
    rdfs:comment "Credential verification is the process of cryptographically or institutionally confirming the authenticity, integrity, and validity of a credential — such as a digital certificate, verifiable credential, or identity assertion — issued by a trusted authority to a subject, so that a relying party can grant access or trust without contacting the original issuer. In decentralised identity systems it relies on public-key cryptography and distributed ledgers to enable privacy-preserving, tamper-evident verification. The process must also check revocation status to ensure credentials that have been invalidated cannot be fraudulently reused."@en ;
    rdfs:subClassOf ngm:authentication ;
    vc:enables ngm:access-control,
        ngm:digital-identity-management ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:credential-schema,
        ngm:decentralized-identity,
        ngm:digital-identity ;
    vc:slug "credential-verification" ;
    vc:sourceDomain "security" ;
    vc:uses ngm:cryptographic-signature,
        ngm:cryptographic-verification,
        ngm:decentralized-identity-did .

ngm:cvpr a owl:Class ;
    rdfs:label "CVPR"@en ;
    rdfs:comment "CVPR (Conference on Computer Vision and Pattern Recognition) is the premier annual academic conference for computer vision research, co-sponsored by the IEEE and the Computer Vision Foundation (CVF). It is consistently ranked among the most impactful venues in artificial intelligence, publishing breakthroughs in image recognition, object detection, semantic segmentation, generative modelling, and 3D vision. Acceptance at CVPR is highly competitive and publication there is a widely recognised marker of significant research contribution."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:object-detection ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:semantic-segmentation ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:image-classification ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:3-d-reconstruction ],
        ngm:computer-vision ;
    vc:enables ngm:benchmark-standard,
        ngm:evaluation-metric ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:3-d-reconstruction,
        ngm:image-classification,
        ngm:object-detection,
        ngm:semantic-segmentation ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:iccv,
        ngm:iclr,
        ngm:icml,
        ngm:neur-ips ;
    vc:slug "cvpr" ;
    vc:sourceDomain "ai" ;
    vc:supports ngm:computer-vision,
        ngm:deep-learning .

ngm:data-privacy a owl:Class ;
    rdfs:label "Data Privacy"@en ;
    rdfs:comment "Data Privacy is the field governing the appropriate collection, processing, storage, and sharing of personal information, ensuring that individuals retain meaningful control over their own data through technical safeguards, legal frameworks, and organisational policies. It encompasses both the regulatory compliance dimension—expressed in instruments such as GDPR, CCPA, and sector-specific regulations—and the engineering discipline of implementing privacy-by-design principles that minimise data exposure through techniques such as anonymisation, pseudonymisation, differential privacy, and consent management. Data privacy is now a core organisational risk management domain as data breaches, surveillance capitalism, and AI training practices raise the stakes of personal information handling."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:data-anonymization-pipeline ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:consent-management ],
        ngm:compliance-framework ;
    vc:enables ngm:granular-consent-control,
        ngm:informed-consent ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:consent-management,
        ngm:data-anonymization-pipeline ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:gdpr,
        ngm:gdpr-compliance,
        ngm:personal-data-store ;
    vc:slug "data-privacy" ;
    vc:sourceDomain "governance" ;
    vc:uses ngm:cryptographic-security .

ngm:digital-rights-management a owl:Class ;
    rdfs:label "Digital Rights Management"@en ;
    rdfs:comment "Technology systems and protocols that control access to, distribution of, and usage rights for digital content including media, software, and virtual assets, increasingly leveraging blockchain and smart contracts for transparent, decentralised rights enforcement and automated royalty distribution."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
