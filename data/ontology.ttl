ngm:tezos a owl:Class ;
    rdfs:label "Tezos"@en ;
    rdfs:comment "Tezos is a self-amending, proof-of-stake Layer 1 blockchain platform launched in 2018 that enables on-chain governance through a formal, stakeholder-driven amendment process, allowing protocol upgrades to be proposed, debated, and applied without hard forks. It uses a Liquid Proof of Stake consensus mechanism in which token holders (XTZ holders) may either bake blocks themselves or delegate their stake to bakers, earning proportional rewards. The platform supports Turing-complete smart contracts written in Michelson and higher-level languages such as Ligo and SmartPy, targeting decentralised finance, NFT issuance, and digital asset custody. Its on-chain governance model is considered a pioneering example of decentralised protocol evolution and formal verification-friendly contract design."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:proof-of-stake ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:liquid-proof-of-stake ],
        ngm:layer-1 ;
    vc:bridgesTo ngm:formal-methods,
        ngm:institutional-finance ;
    vc:contrastsWith ngm:cardano,
        ngm:ethereum,
        ngm:polkadot,
        ngm:solana ;
    vc:enables ngm:decentralised-finance,
        ngm:digital-asset-custody,
        ngm:non-fungible-token,
        ngm:on-chain-governance,
        ngm:smart-contract ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:bft-consensus,
        ngm:on-chain-governance ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:blockchain,
        ngm:cryptographic-token,
        ngm:decentralised-application,
        ngm:protocol-upgrade,
        ngm:staking ;
    vc:requires ngm:liquid-proof-of-stake,
        ngm:proof-of-stake ;
    vc:slug "tezos" ;
    vc:sourceDomain "blockchain" ;
    vc:standardizedBy ngm:tezos-improvement-proposal ;
    vc:uses ngm:consensus-protocol,
        ngm:formal-verification,
        ngm:michelson .

