        ngm:industrial-metaverse ;
    vc:contrastsWith ngm:collada-format,
        ngm:fbx-format,
        ngm:gltf-standard ;
    vc:enables ngm:3-d-content-pipeline,
        ngm:augmented-reality-content,
        ngm:collaborative-3-d-editing,
        ngm:digital-twin,
        ngm:physics-simulation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:usd-composition-arcs,
        ngm:usd-hydra-renderer,
        ngm:usd-schema-plugin,
        ngm:usdz-package-format ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:3-d-asset,
        ngm:nvidia-omniverse,
        ngm:realitykit,
        ngm:rendering-pipeline ;
    vc:requires ngm:hierarchical-data-model,
        ngm:scene-graph ;
    vc:slug "open-usd" ;
    vc:sourceDomain "spatial-computing" ;
    vc:standardizedBy ngm:alliance-for-openusd,
        ngm:iso-iec-22886 ;
