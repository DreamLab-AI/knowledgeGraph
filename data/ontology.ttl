    vc:enables ngm:deep-learning ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:onnx ;
    vc:slug "onnx-standard" ;
    vc:sourceDomain "metaverse" .

ngm:ontology-engineering a owl:Class ;
    rdfs:label "Ontology Engineering"@en ;
    rdfs:comment "Ontology Engineering is the discipline of designing, formalizing, and maintaining ontologies: explicit, machine-readable specifications of concepts, properties, and relationships within a domain. It applies methodologies and logic languages such as OWL and RDFS to produce consistent, reusable, and reasoning-capable knowledge models. The field underpins semantic interoperability, knowledge graphs, and automated inference across heterogeneous data sources."@en ;
    rdfs:subClassOf ngm:data-management ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:knowledge-graphing ;
    vc:slug "ontology-engineering" ;
    vc:sourceDomain "data" .

ngm:ontology-property-definitions a owl:Class ;
    rdfs:label "Ontology Property Definitions"@en ;
    rdfs:comment "Comprehensive definitions of object properties and datatype properties used throughout the Disruptive Technology Ontology, establishing formal semantic relationships between concepts across AI, blockchain, robotics, and metaverse domains. Properties define typed, directional links (enables, requires, hasPart, uses, etc.) with explicit domains, ranges, inverse relationships, and logical characteristics enabling automated reasoning and knowledge graph traversal."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:ontology-definition ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:ontology-structure ],
        ngm:infra-software-engineering ;
    skos:broader ngm:infra-software-engineering ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:ontology-definition,
        ngm:ontology-structure ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:domain-ontology,
        ngm:knowledge-graph,
        ngm:knowledge-representation,
        ngm:linked-data,
        ngm:owl-class-hierarchy,
        ngm:semantic-web-standards ;
    vc:slug "ontology-property-definitions" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:artificial-intelligence-domain,
        ngm:blockchain-domain,
        ngm:robotics-domain .

ngm:open-home-foundation a owl:Class ;
    rdfs:label "Open Home Foundation"@en ;
    rdfs:comment "The Open Home Foundation is a non-profit organization that stewards open-source smart-home projects, most notably Home Assistant, to advance privacy, choice, and sustainability in home automation. It holds and governs the intellectual property of these projects, funds development, and protects them from commercial capture. Its mission centers on local-first, user-controlled home technology rather than cloud-dependent proprietary platforms."@en ;
    rdfs:subClassOf ngm:standards-body ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:home-assistant ;
    vc:slug "open-home-foundation" ;
    vc:sourceDomain "infrastructure" .

ngm:open-source a owl:Class ;
    rdfs:label "Open Source"@en ;
    rdfs:comment "Open source refers to software whose source code is made available under a licence that permits use, study, modification, and redistribution. It supports collaborative development."@en ;
    rdfs:subClassOf ngm:software-development ;
    vc:enables ngm:software-development ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:slug "open-source" ;
    vc:sourceDomain "general" .

ngm:operational-layer a owl:Class ;
    rdfs:label "Operational Layer"@en ;
    rdfs:comment "The Operational Layer is the cross-cutting stratum concerned with running, maintaining, and recovering a system in production. It sits above the runtime and tooling strata it relies on and supports the institutional commitments made above. It contains deployment pipelines, monitoring, incident response, and capacity management."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:runtime-layer ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:tooling-layer ],
        ngm:owl-thing ;
    vc:enables ngm:application-layer,
        ngm:institutional-layer ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:runtime-layer,
        ngm:tooling-layer ;
    vc:slug "operational-layer" ;
    vc:sourceDomain "operational" .

ngm:optimism-collective a owl:Class ;
    rdfs:label "Optimism Collective"@en ;
    rdfs:comment "The Optimism Collective is a two-house governance body overseeing the Optimism ecosystem — a suite of Ethereum Layer 2 networks built on the OP Stack rollup technology — consisting of the Token House (OP token holders who vote on protocol upgrades and treasury allocations) and the Citizens' House (non-transferable badge holders who allocate Retroactive Public Goods Funding). It represents one of the most sophisticated real-world experiments in bicameral on-chain governance, designed to balance token-weighted economic interests with broader societal value creation and public goods provision."@en ;
    rdfs:subClassOf ngm:dao-governance ;
    vc:enables ngm:dao,
        ngm:decentralized-governance ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:collective-decision-making,
        ngm:governance-token,
        ngm:layer-2-scaling,
        ngm:on-chain-governance ;
    vc:slug "optimism-collective" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:blockchain-governance,
        ngm:voting-mechanism .

ngm:optimization-technique a owl:Class ;
    rdfs:label "Optimization Technique"@en ;
    rdfs:comment "A systematic method applied to improve computational performance, memory efficiency, or rendering throughput in metaverse and spatial computing infrastructure. Optimisation techniques span algorithmic improvements (level-of-detail, culling, compression), hardware utilisation strategies (GPU parallelism, cache coherence), and software-level approaches (batching, shader optimisation) that collectively reduce latency and resource consumption."@en ;
    rdfs:subClassOf ngm:infra-computing-and-cloud ;
    skos:broader ngm:infra-computing-and-cloud ;
    vc:enables ngm:metaverse-infrastructure,
        ngm:rendering-pipeline ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:slug "optimization-technique" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:latency,
        ngm:optimization-algorithms ;
    vc:uses ngm:data-compression,
        ngm:gpu-compute .

ngm:or-set a owl:Class ;
    rdfs:label "OR-Set"@en ;
    rdfs:comment "An OR-Set (Observed-Remove Set) is a conflict-free replicated data type (CRDT) that supports concurrent add and remove operations on a set while guaranteeing eventual consistency across replicas. Each added element is tagged with a unique identifier so that concurrent adds and removes resolve deterministically, with adds winning over concurrent removes of unobserved tags. It is a foundational structure for collaborative applications that must merge edits without central coordination."@en ;
    rdfs:subClassOf ngm:distributed-data-structure ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:collaborative-whiteboard,
        ngm:crdt ;
    vc:slug "or-set" ;
    vc:sourceDomain "data" .

ngm:organisational-layer a owl:Class ;
    rdfs:label "Organisational Layer"@en ;
    rdfs:comment "The Organisational Layer is the cross-cutting stratum that represents the internal structure, roles, and processes of an operating body. It sits above the Institutional Layer that grants it standing and supports operational and social activity. It contains organisational units, responsibilities, reporting lines, and internal processes."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:institutional-layer ],
        ngm:owl-thing ;
    vc:enables ngm:operational-layer,
        ngm:process-layer ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:institutional-layer ;
    vc:slug "organisational-layer" ;
    vc:sourceDomain "organisational" .

ngm:outpainting a owl:Class ;
    rdfs:label "Outpainting"@en ;
    rdfs:comment "Outpainting is a generative AI technique that extends an existing image beyond its original canvas boundaries by synthesising new, contextually consistent pixel content in the surrounding regions. A masked version of the source image—padded with blank or noise-filled regions—is fed to a conditioned image generation model (typically a latent diffusion model) which fills the extended area while respecting the style, lighting, and semantic content of the original. Outpainting is widely used in content creation pipelines for widening aspect ratios, reconstructing damaged artwork borders, and generating panoramic background extensions for virtual production and 3D scene authoring."@en ;
    rdfs:subClassOf ngm:ai-application ;
    skos:broader ngm:ai-application ;
    vc:enables ngm:generative-content ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:image-generation,
        ngm:inpainting ;
    vc:slug "outpainting" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:diffusion-model,
        ngm:latent-diffusion .

ngm:ownership-transfer a owl:Class ;
    rdfs:label "Ownership Transfer"@en ;
    rdfs:comment "Ownership transfer is the process by which legal or functional control of an asset — physical, digital, or tokenised — passes from one party to another, recorded in a registry, ledger, or smart contract. In blockchain and Web3 contexts it typically refers to atomic state transitions that update on-chain ownership records for fungible tokens, NFTs, or tokenised real-world assets, with cryptographic proofs replacing traditional notarial or escrow intermediaries. The mechanism must satisfy atomicity, finality, and auditability requirements."@en ;
    rdfs:subClassOf ngm:digital-asset-management ;
    vc:enables ngm:fractional-ownership,
        ngm:nft-marketplace ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:asset-tokenization,
        ngm:digital-ownership,
        ngm:property-rights ;
    vc:slug "ownership-transfer" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:cross-chain-asset-transfer ;
    vc:uses ngm:digital-asset,
        ngm:provenance-tracking .

ngm:pairwise-qf a owl:Class ;
    rdfs:label "Pairwise QF"@en ;
    rdfs:comment "Pairwise QF (Pairwise-bounded Quadratic Funding) is a variant of quadratic funding that limits the matching subsidy attributable to coordinating groups of contributors by discounting the influence of pairs who repeatedly co-fund. It mitigates collusion and Sybil attacks that plague naive quadratic funding by capping the matching any pair of donors can jointly unlock. The mechanism preserves quadratic funding's democratic weighting of many small contributions while resisting manipulation."@en ;
    rdfs:subClassOf ngm:economic-mechanism ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:quadratic-voting ;
    vc:slug "pairwise-qf" ;
    vc:sourceDomain "blockchain" .

ngm:parallel-computing a owl:Class ;
    rdfs:label "Parallel Computing"@en ;
    rdfs:comment "Parallel computing executes many operations simultaneously across multiple processing units to reduce wall-clock time for workloads that can be decomposed into independent or loosely coupled parts."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gpu-architecture ],
        ngm:distributed-computing ;
    vc:enables ngm:pipeline-parallelism,
        ngm:real-time-rendering ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:gpu-architecture ;
    vc:slug "parallel-computing" ;
    vc:sourceDomain "metaverse" .

ngm:participant-protection a owl:Class ;
    rdfs:label "Participant Protection"@en ;
    rdfs:comment "Policies, technologies, and practices designed to safeguard users' privacy, data, and safety on digital platforms, encompassing regulatory compliance, privacy-enhancing technologies, and platform safety features that protect against data misuse, harassment, and harmful content."@en ;
    rdfs:subClassOf ngm:digital-safety,
        ngm:sc-governance-and-safety ;
    skos:broader ngm:sc-governance-and-safety ;
    vc:enables ngm:trust-in-digital-platforms ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:slug "participant-protection" ;
    vc:sourceDomain "spatial-computing" .

ngm:particle-systems a owl:Class ;
    rdfs:label "Particle Systems"@en ;
    rdfs:comment "The collective infrastructure and tooling for creating and managing particle-based visual effects in game engines and VFX software, encompassing emitter configuration, physics integration, and real-time or offline rendering pipelines."@en ;
    rdfs:subClassOf ngm:sc-display-and-rendering,
        ngm:vfx-tools ;
    skos:broader ngm:sc-display-and-rendering ;
    vc:enables ngm:real-time-vfx ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:slug "particle-systems" ;
    vc:sourceDomain "spatial-computing" .

ngm:pathfinding-algorithm a owl:Class ;
    rdfs:label "Pathfinding Algorithm"@en ;
    rdfs:comment "A computational algorithm that determines an optimal or near-optimal route between a start and goal node in a graph or spatial environment. Pathfinding algorithms are central to autonomous navigation, game AI, robotics, and metaverse movement systems, with classical examples including Dijkstra's algorithm for shortest paths and A* for heuristic-guided search in spatial graphs."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:graph-search ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:dijkstra-algorithm ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:heuristic-methods ],
        ngm:ai-technique,
        ngm:algorithm ;
    skos:broader ngm:ai-technique ;
    vc:enables ngm:autonomous-navigation,
        ngm:metaverse-navigation-systems,
        ngm:navigation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:dijkstra-algorithm,
        ngm:graph-search,
        ngm:heuristic-methods ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:autonomous-agent,
        ngm:fast-spatial-queries,
        ngm:search-algorithms ;
    vc:slug "pathfinding-algorithm" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:graph-algorithms,
        ngm:search-algorithm .

ngm:payment-channel-network a owl:Class ;
    rdfs:label "Payment Channel Network"@en ;
    rdfs:comment "A Payment Channel Network is a layer-2 scaling architecture in which participants open bilateral payment channels and route payments across a graph of connected channels without settling each transaction on the underlying blockchain. Funds are locked in multisignature channels, and balances update off-chain through signed state, with only channel opening and closing recorded on-chain. This enables high-throughput, low-fee, near-instant payments while inheriting base-layer security."@en ;
    rdfs:subClassOf ngm:bc-network-component ;
    skos:broader ngm:bc-network-component ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:lightning-network ;
    vc:slug "payment-channel-network" ;
    vc:sourceDomain "blockchain" .

ngm:pddl a owl:Class ;
    rdfs:label "PDDL"@en ;
    rdfs:comment "The Planning Domain Definition Language (PDDL) is a standardised formal language for encoding automated-planning problems as domains and problem instances. A domain specifies predicates and actions with preconditions and effects, while a problem instance defines objects, an initial state, and a goal. PDDL provides a common input format that lets generic planners compute action sequences, and it underpins much of classical AI task planning."@en ;
    rdfs:subClassOf ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:task-planning ;
    vc:slug "pddl" ;
    vc:sourceDomain "ai" .

ngm:pedersen-commitment a owl:Class ;
    rdfs:label "Pedersen Commitment"@en ;
    rdfs:comment "A cryptographic commitment scheme that lets a party commit to a value while keeping it hidden, with the ability to reveal it later. It is both binding and information-theoretically hiding, and it is additively homomorphic."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:elliptic-curve-cryptography ],
        ngm:cryptographic-commitment ;
    vc:enables ngm:zero-knowledge-proof ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:elliptic-curve-cryptography ;
    vc:slug "pedersen-commitment" ;
    vc:sourceDomain "cryptography" .

ngm:peerto-peer-protocol a owl:Class ;
    rdfs:label "Peerto Peer Protocol"@en ;
    rdfs:comment "Peerto Peer Protocol is a blockchain concept."@en ;
    rdfs:subClassOf ngm:bc-protocol-and-consensus ;
    skos:broader ngm:bc-protocol-and-consensus ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:implements ngm:blockchain ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:slug "peerto-peer-protocol" ;
    vc:sourceDomain "blockchain" .

ngm:pegasus-spyware a owl:Class ;
    rdfs:label "Pegasus Spyware"@en ;
    rdfs:comment "Pegasus is commercial surveillance spyware developed by the NSO Group that covertly compromises smartphones, often via zero-click exploits requiring no user interaction. Once installed it can exfiltrate messages, calls, location, microphone, and camera data, granting near-total device control. It is a prominent case study in state-level digital surveillance and the human-rights risks of the commercial intrusion-software market."@en ;
    rdfs:subClassOf ngm:cybersecurity ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:digital-society-surveillance ;
    vc:slug "pegasus-spyware" ;
    vc:sourceDomain "security" .

ngm:perception-layer a owl:Class ;
    rdfs:label "Perception Layer"@en ;
    rdfs:comment "The Perception Layer is the stratum that converts raw sensor signals into structured observations of the environment. It sits above the Sensor Fusion and Hardware sensing strata and below decision-making layers, providing the interpreted percepts that agents and controllers act on. It contains detection, recognition, segmentation, and state-estimation components."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:sensor-fusion-layer ],
        ngm:owl-thing ;
    vc:enables ngm:agent-layer,
        ngm:control-layer ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:sensor-fusion-layer ;
    vc:slug "perception-layer" ;
    vc:sourceDomain "perception" .

ngm:performing-arts a owl:Class ;
    rdfs:label "Performing Arts"@en ;
    rdfs:comment "Time-based artistic disciplines—including theatre, dance, music, and live performance—that occur in shared space between performers and audience. In spatial computing contexts, performing arts intersect with virtual production, motion capture, and location-based experiences to create hybrid physical-digital performances that extend audience reach and deepen narrative immersion."@en ;
    rdfs:subClassOf ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:enables ngm:immersive-experience,
        ngm:location-based-experience ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:creative-media-domain,
        ngm:music-and-audio ;
    vc:slug "performing-arts" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:motion-capture,
        ngm:spatial-audio,
        ngm:virtual-production .

ngm:persistent-identifier a owl:Class ;
    rdfs:label "Persistent Identifier"@en ;
    rdfs:comment "A persistent identifier (PID) is a long-lasting, globally unique reference to a digital object that remains stable even as the object's location or custodian changes. PIDs such as DOIs, Handles, and ARKs are resolved through a managed indirection service that maps the identifier to current metadata and access endpoints. They are foundational to citation, provenance, and interoperability in scholarly and digital-object infrastructure."@en ;
    rdfs:subClassOf ngm:infra-data-management ;
    skos:broader ngm:infra-data-management ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:digital-objects ;
    vc:slug "persistent-identifier" ;
    vc:sourceDomain "data" .

ngm:persistent-state a owl:Class ;
    rdfs:label "Persistent State"@en ;
    rdfs:comment "The durable retention of application or world state across user sessions, server restarts, and network interruptions, such that virtual environments, user progress, and asset ownership remain consistent over time. In metaverse and multiplayer systems, persistent state is typically achieved through distributed databases, cloud storage synchronisation, or blockchain-based ledgers."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cloud-infrastructure ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-storage ],
        ngm:infra-data-management ;
    skos:broader ngm:infra-data-management ;
    vc:enables ngm:metaverse-application,
        ngm:session-management ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:blockchain,
        ngm:distributed-system ;
    vc:requires ngm:cloud-infrastructure,
        ngm:data-storage ;
    vc:slug "persistent-state" ;
    vc:sourceDomain "infrastructure" .

ngm:persona a owl:Class ;
    rdfs:label "Persona"@en ;
    rdfs:comment "A persona is a defined personality, role, and behavioural profile assigned to a conversational AI to shape its tone, knowledge framing, and interaction style. It encodes traits such as voice, expertise, boundaries, and goals, often via system prompts, so that responses stay consistent and aligned with a product's intent. Personas make chatbots feel coherent and purposeful rather than generic."@en ;
    rdfs:subClassOf ngm:ai-application ;
    skos:broader ngm:ai-application ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:chatbots ;
    vc:slug "persona" ;
    vc:sourceDomain "ai" .

ngm:personal-information-protection-law a owl:Class ;
    rdfs:label "Personal Information Protection Law"@en ;
    rdfs:comment "The Personal Information Protection Law (PIPL) is China's comprehensive data-protection statute, effective 2021, governing how personal information of individuals in China is collected, processed, and transferred. It establishes consent and necessity requirements, data-subject rights, security obligations, and strict cross-border transfer controls, with extraterritorial reach and significant penalties. PIPL is a cornerstone of Asia-Pacific data-privacy regulation alongside frameworks like the GDPR."@en ;
    rdfs:subClassOf ngm:infra-legal-and-regulatory ;
    skos:broader ngm:infra-legal-and-regulatory ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:asia-pacific-regulation ;
    vc:slug "personal-information-protection-law" ;
    vc:sourceDomain "governance" .

ngm:pervasive-computing a owl:Class ;
    rdfs:label "Pervasive Computing"@en ;
    rdfs:comment "Pervasive computing — also termed ubiquitous computing — is a paradigm in which computational capability is embedded throughout the physical environment and integrated seamlessly into everyday objects and infrastructure, such that computation becomes a background utility rather than a discrete user activity. Coined by Mark Weiser at Xerox PARC in 1991, the vision encompasses context-aware, networked devices that sense, process, and communicate without explicit user interaction. It is the conceptual precursor to the Internet of Things and ambient intelligence."@en ;
    rdfs:subClassOf ngm:ambient-computing ;
    vc:enables ngm:context-aware-computing,
        ngm:internet-of-things,
        ngm:wearable-computing-platform ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:context-awareness,
        ngm:sociotechnical-system ;
    vc:slug "pervasive-computing" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:embedded-systems,
        ngm:io-t-sensor-network .

ngm:physical-hardware a owl:Class ;
    rdfs:label "Physical Hardware"@en ;
    rdfs:comment "The tangible computing devices and peripherals required for metaverse and XR experiences, including VR headsets, AR glasses, haptic devices, motion controllers, and supporting infrastructure like GPUs and networking equipment."@en ;
    rdfs:subClassOf ngm:hardware,
        ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
