ngm:mesh-shading a owl:Class ;
    rdfs:comment "Mesh shading is a GPU rendering pipeline model, exposed through APIs such as Vulkan and DirectX 12, that replaces the fixed vertex-and-geometry-shader stages with programmable task and mesh shaders operating on small groups of primitives called meshlets. It gives applications direct control over primitive culling, level-of-detail selection and amplification within the shader itself, removing bottlenecks inherent in the traditional pipeline. Mesh shading is used to render highly detailed geometry more efficiently in modern real-time graphics engines."@en ;
    rdfs:label "Mesh Shading"@en ;
    rdfs:subClassOf ngm:graphics-api ;
    rdfs:subClassOf _:r14099 ;
