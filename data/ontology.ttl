            owl:someValuesFrom ngm:differential-privacy ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:k-anonymity-in-datasets ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
