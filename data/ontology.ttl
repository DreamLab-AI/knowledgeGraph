ngm:network-infrastructure a owl:Class ;
    rdfs:label "Network Infrastructure"@en ;
    rdfs:comment "Network Infrastructure is the integrated ensemble of physical hardware, logical software layers, and communication protocols that enable data transmission, interconnection, and service delivery across computing environments. It encompasses wired and wireless transmission media, routing and switching equipment, software-defined networking (SDN) control planes, and edge computing nodes that collectively form the backbone of digital communication. Modern network infrastructure is characterised by convergence across 5G/6G mobile networks, fibre optic backbones, satellite constellations, and multi-access edge computing (MEC) to deliver low-latency, high-throughput connectivity. It underpins virtually all digital services — from cloud computing and AI inference to immersive spatial experiences, autonomous systems, and distributed enterprise collaboration."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:network-security ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:content-delivery-network ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:network-protocol ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:physical-layer ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:identity-and-access-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:network-component ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:edge-computing ],
        ngm:infra-network-and-comms ;
    skos:broader ngm:infra-network-and-comms ;
    vc:bridgesTo ngm:blockchain-network,
        ngm:federated-learning ;
    vc:contrastsWith ngm:overlay-network ;
    vc:dependsOn ngm:power-infrastructure,
        ngm:telecommunications-infrastructure ;
    vc:enables ngm:cloud-computing,
        ngm:distributed-systems,
        ngm:internet-of-things,
        ngm:real-time-communication ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:content-delivery-network,
        ngm:edge-computing,
        ngm:network-component,
        ngm:network-protocol,
        ngm:software-defined-networking ;
    vc:isPartOf ngm:digital-infrastructure ;
    vc:qualityScore "0.72"^^xsd:float ;
