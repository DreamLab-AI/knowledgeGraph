ngm:risk-intensity-heatmap a owl:Class ;
    rdfs:label "Risk Intensity Heatmap"@en ;
    rdfs:comment "A heatmap is a data visualisation technique that encodes numerical values as colour intensities in a two-dimensional matrix, allowing rapid visual comparison of magnitudes across categorical dimensions. In the context of AI risk and impact analysis, heatmaps are used to compare urgency, impact, and composite severity scores across AI risk categories (such as security risks, algorithmic bias, job automation, and AI ethics), guiding prioritisation for governance and regulation. Heatmaps are typically rendered with colour-scheme gradients (e.g., Vega-Lite's blues scheme) and can be embedded directly in knowledge-graph pages for interactive analysis."@en ;
    rdfs:subClassOf ngm:infra-software-engineering ;
    skos:broader ngm:infra-software-engineering ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:ai-ethics,
        ngm:ai-governance,
        ngm:ai-risk,
        ngm:algorithmic-bias ;
    vc:slug "risk-intensity-heatmap" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:ai-regulation,
        ngm:ai-risk-management,
        ngm:visualization-layer ;
    vc:uses ngm:data-analytics,
        ngm:data-visualisation .

ngm:robin-hanson-ai-sceptic-economist a owl:Class ;
    rdfs:label "Robin Hanson AI Sceptic Economist"@en ;
    rdfs:comment "Robin Hanson is an economist, futurist, and author (George Mason University) known for contrarian analysis of AI progress timelines, the economics of prediction markets, and his book Age of Em which models a future dominated by brain emulations. He maintains a measured scepticism about near-term AGI, arguing that inertia, demographic decline, and adoption barriers make transformative AI further off than mainstream discourse suggests. His blog Overcoming Bias applies economic and evolutionary reasoning to cognition, signalling, and technology adoption."@en ;
    rdfs:subClassOf ngm:infra-software-engineering ;
    skos:broader ngm:infra-software-engineering ;
    vc:contrastsWith ngm:history-and-path-to-agi ;
    vc:enables ngm:trustworthy-ai ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:relatedTo ngm:artificial-general-intelligence,
        ngm:economics ;
    vc:slug "robin-hanson-ai-sceptic-economist" ;
    vc:sourceDomain "infrastructure" .

ngm:robot-rb-0001 a owl:Class ;
    rdfs:label "Robot RB-0001"@en ;
    rdfs:comment "Robot RB-0001 is an identifier-class for a reference mobile-manipulator robot platform that combines a mobile base with an articulated manipulator arm. As a composite robot, it integrates locomotion and manipulation subsystems so the system can both navigate an environment and perform physical tasks within it. It serves as a canonical example linking mobile-robot and manipulator capabilities."@en ;
    rdfs:subClassOf ngm:robo-robot-type ;
    skos:broader ngm:robo-robot-type ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:manipulator,
        ngm:mobile-robot ;
    vc:slug "robot-rb-0001" ;
    vc:sourceDomain "robotics" .

ngm:robotic-camera-virtual-production-integration a owl:Class ;
    rdfs:label "Robotic Camera Virtual Production Integration"@en ;
    rdfs:comment "The VP Robotics Project (VisionFlow) is a feasibility study investigating the integration of robotic camera control with machine learning and virtual production workflows. It inverts conventional pre-visualisation pipelines by deriving scene-driven camera motion from AI-generated content, combining open-source robotics software with parallax-plates-as-a-service delivery for the film and television industry."@en ;
    rdfs:subClassOf ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:enables ngm:virtual-production,
        ngm:virtual-set-design ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:motion-capture,
        ngm:robotics-control ;
    vc:slug "robotic-camera-virtual-production-integration" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:machine-learning-discipline,
        ngm:robotics .

