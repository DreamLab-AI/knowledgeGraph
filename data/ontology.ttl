ngm:asymmetric-key-pair a owl:Class ;
    rdfs:comment "An asymmetric key pair is the pair of mathematically related keys, a public key and a private key, that together enable asymmetric cryptography: data encrypted or signed with one key can only be decrypted or verified with the other. The private key must be kept secret by its owner, while the public key can be freely distributed, allowing anyone to encrypt a message intended for the owner or verify a signature the owner has produced. Asymmetric key pairs underpin public-key infrastructure, digital signatures, and blockchain account ownership."@en ;
    rdfs:label "Asymmetric Key Pair"@en ;
    rdfs:subClassOf ngm:asymmetric-cryptography ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:asymmetric-cryptography ;
