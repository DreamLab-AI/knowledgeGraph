ngm:block-header a owl:Class ;
    rdfs:label "Block Header"@en ;
    rdfs:comment "The fixed-size metadata section of a blockchain block that encodes the previous block hash, Merkle root of transactions, timestamp, difficulty target, and nonce. The block header is the unit that miners and validators hash during proof-of-work or verify during proof-of-stake, and it commits to the complete block body via the Merkle root without including raw transactions."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:difficulty ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:timestamp ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:nonce ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:merkle-root ],
        ngm:bc-protocol-and-consensus,
        ngm:blockchain-entity,
        ngm:distributed-data-structure ;
    skos:broader ngm:bc-protocol-and-consensus ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:difficulty,
        ngm:merkle-root,
        ngm:nonce,
        ngm:timestamp ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:block,
        ngm:block-height,
        ngm:genesis-block,
        ngm:merkle-tree ;
    vc:slug "block-header" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:cryptographic-hash-function,
        ngm:proof-of-work .

