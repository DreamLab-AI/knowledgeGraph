    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:relatedTo ngm:asset-tokenization,
        ngm:digital-asset ;
    vc:requires ngm:financial-regulation,
        ngm:identity-verification,
        ngm:regulatory-compliance ;
    vc:slug "security-token-offering" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:security-token,
        ngm:smart-contract .

ngm:self-supervised-learning a owl:Class ;
    rdfs:label "Self-Supervised Learning"@en ;
    rdfs:comment "Self-Supervised Learning (SSL) is a machine learning paradigm in which a model learns rich representations of data by solving pretext tasks whose supervisory signal is derived automatically from the input data itself, requiring no human-provided labels. The model learns to predict masked or hidden portions of an input, to match different views of the same data, or to distinguish positive from negative data pairs, developing features that transfer effectively to downstream supervised tasks with limited labelled data. Self-supervised learning has become the dominant pre-training strategy for large language models, visual foundation models, and multimodal systems, enabling training at scales that would be infeasible with manually annotated datasets."@en ;
    rdfs:subClassOf ngm:machine-learning-technique ;
    vc:enables ngm:parameter-efficient-fine-tuning,
        ngmi:foundation-models ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:contrastive-learning,
        ngm:semi-supervised-learning,
        ngm:unsupervised-learning ;
    vc:slug "self-supervised-learning" ;
    vc:sourceDomain "ai" ;
    vc:supports ngm:deep-learning ;
    vc:uses ngm:pretrained-model,
        ngm:transformer-architecture .

ngm:semi-supervised-learning a owl:Class ;
    rdfs:label "Semi-Supervised Learning"@en ;
    rdfs:comment "Semi-Supervised Learning is a artificial intelligence concept and a type of Machine Learning. that enables Data-Efficient Learning."@en ;
    rdfs:subClassOf ngm:ai-technique,
        ngm:machine-learning ;
    skos:broader ngm:ai-technique ;
    vc:enables ngm:data-efficient-learning ;
