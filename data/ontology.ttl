ngm:real-time-ai a owl:Class ;
    rdfs:label "Real-Time AI"@en ;
    rdfs:comment "Real-Time AI refers to the application of artificial intelligence inference within strict latency bounds — typically sub-second to sub-millisecond — required for time-sensitive tasks such as autonomous driving, robotics control, live speech processing, financial trading, and augmented reality. It integrates specialised hardware (NPUs, GPUs, FPGAs), optimised model representations (quantisation, pruning, TensorRT/ONNX), and edge deployment architectures to ensure deterministic response times. The distinction from batch AI lies in the hard or soft real-time constraints that govern system correctness."@en ;
    rdfs:subClassOf ngm:real-time-computation ;
    vc:enables ngm:autonomous-vehicle,
        ngm:real-time-inference-at-edge,
        ngm:real-time-monitoring ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:latency,
        ngm:real-time-processing ;
    vc:slug "real-time-ai" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:edge-computing,
        ngm:hardware-acceleration,
        ngm:inference-engine,
        ngm:npu .

ngm:real-time-ai-inference a owl:Class ;
    rdfs:label "Real-Time AI Inference"@en ;
    rdfs:comment "Real-time AI inference is the execution of trained machine learning model forward passes within latency bounds tight enough to support interactive or time-critical applications, typically measured in milliseconds to tens of milliseconds. It requires co-optimisation of model architecture, runtime software, and hardware accelerators — including GPUs, NPUs, and dedicated AI ASICs — to meet throughput and latency targets whilst maintaining acceptable accuracy. Applications include autonomous vehicles, real-time video analysis, voice assistants, and spatial computing overlays."@en ;
    rdfs:subClassOf ngm:ai-inference ;
    vc:enables ngm:edge-ai-system,
        ngm:latency-aware-edge-ai ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:low-latency-computing,
        ngm:model-compression-for-edge ;
    vc:slug "real-time-ai-inference" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:gpu-acceleration,
        ngm:inference-engine,
        ngm:npu,
        ngm:onnx-runtime .

ngm:real-time-computation a owl:Class ;
    rdfs:label "Real-Time Computation"@en ;
    rdfs:comment "Real-time computation refers to computational processes that must produce correct outputs within specified, externally imposed time constraints—where the correctness of a result depends not only on its logical accuracy but on its delivery before a deadline. Hard real-time systems guarantee deadline satisfaction under all conditions, soft real-time systems tolerate occasional deadline misses, and firm real-time systems discard late results as worthless. Applications span industrial control, autonomous vehicles, robotics, financial trading, and interactive media. Real-time computation requires deterministic execution paths, bounded memory allocation, and often specialised hardware or operating system schedulers."@en ;
    rdfs:subClassOf ngm:real-time ;
    vc:enables ngm:control-system,
        ngm:sensor-fusion ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:embedded-systems,
        ngm:latency,
        ngm:real-time-ai ;
    vc:slug "real-time-computation" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:autonomous-system,
        ngm:digital-signal-processing ;
    vc:uses ngm:edge-computing,
        ngm:parallel-processing .

ngm:regression-testing a owl:Class ;
    rdfs:label "Regression Testing"@en ;
    rdfs:comment "Regression testing is the practice of re-executing previously passing tests after a code change to confirm that existing behaviour has not been broken. It guards against regressions introduced by new features, bug fixes or refactoring by maintaining a suite of repeatable checks that are run automatically as part of integration and delivery pipelines. The discipline trades upfront test authoring and maintenance for sustained confidence in evolving systems."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:test-automation ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:unit-testing ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:integration-testing ],
        ngm:software-testing ;
    vc:contrastsWith ngm:penetration-testing ;
    vc:dependsOn ngm:version-control ;
    vc:enables ngm:quality-assurance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:integration-testing,
        ngm:unit-testing ;
    vc:isPartOf ngm:quality-assurance ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:observability,
        ngm:reproducibility ;
    vc:requires ngm:test-automation ;
    vc:slug "regression-testing" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:continuous-delivery,
        ngm:continuous-integration ;
    vc:uses ngm:test-automation,
        ngm:unit-testing .

ngm:regtech a owl:Class ;
    rdfs:label "RegTech"@en ;
    rdfs:comment "RegTech (regulatory technology) is the application of technologies such as data analytics, machine learning, cloud computing and automation to help regulated firms meet compliance obligations more efficiently and accurately. It streamlines tasks including identity verification, transaction monitoring, regulatory reporting and risk surveillance. RegTech reduces the manual cost of compliance while improving the timeliness and consistency of regulatory outcomes."@en ;
    rdfs:subClassOf ngm:regulatory-technology ;
    vc:bridgesTo ngm:anti-money-laundering ;
    vc:enables ngm:aml,
        ngm:kyc ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:implements ngm:prudential-regulation ;
    vc:isPartOf ngm:regulatory-compliance,
        ngm:regulatory-technology ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:data-governance,
        ngm:risk-assessment ;
    vc:slug "regtech" ;
    vc:sourceDomain "governance" ;
    vc:supports ngm:compliance-verification,
        ngm:regulatory-reporting ;
    vc:uses ngm:artificial-intelligence,
        ngm:automation,
        ngm:machine-learning .

ngm:remittances a owl:Class ;
    rdfs:label "Remittances"@en ;
    rdfs:comment "Remittances are cross-border transfers of money, typically sent by migrant workers to family in their home country, representing a major global flow of funds to developing economies. Traditional rails impose high fees and slow settlement, which cryptocurrencies and the Lightning Network aim to reduce. As a use case, remittances anchor much of the argument for Bitcoin and stablecoins as practical money."@en ;
    rdfs:subClassOf ngm:financial-services ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:bitcoin-proof-of-work-protocol-as-money,
        ngm:bitcoin-proof-of-work-protocol-value-proposition ;
    vc:slug "remittances" ;
    vc:sourceDomain "blockchain" .

ngm:research-methods a owl:Class ;
    rdfs:label "Research Methods"@en ;
    rdfs:comment "Research Methods are the systematic procedures and techniques used to collect, analyse, and interpret data in order to generate reliable knowledge. They encompass qualitative approaches (interviews, ethnography), quantitative approaches (controlled experiments, statistical analysis), and mixed-methods designs, with evaluation benchmarks and user studies being particularly relevant to AI and spatial computing research."@en ;
    rdfs:subClassOf ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:enables ngm:evaluation-benchmarks-and-leaderboards ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:relatedTo ngm:ai-research-area,
        ngm:clinical-trials,
        ngm:data-augmentation-strategies ;
    vc:slug "research-methods" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:user-research .

ngm:responsible-ai-principles a owl:Class ;
    rdfs:label "Responsible AI Principles"@en ;
    rdfs:comment "Foundational ethical commitments and normative guidelines governing AI system design, development, deployment, and monitoring to ensure beneficial, fair, and rights-respecting outcomes. Core principles—including fairness, transparency, accountability, privacy, safety, and human oversight—are operationalised through frameworks such as the OECD AI Principles, the EU Ethics Guidelines for Trustworthy AI, and UNESCO's Recommendation on the Ethics of AI."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:ai-fairness ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:human-oversight ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:transparency-and-explainability ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:ai-alignment ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:accountability ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:ai-safety ],
        ngm:ai-ethics,
        ngm:ai-governance-and-ethics ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:accountability,
        ngm:ai-alignment,
        ngm:ai-fairness,
        ngm:ai-safety,
        ngm:human-oversight,
        ngm:transparency-and-explainability ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:ai-governance,
        ngm:algorithmic-bias,
        ngm:bias-mitigation-techniques,
        ngm:differential-privacy,
        ngm:explainability ;
    vc:slug "responsible-ai-principles" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:revocation-mechanism a owl:Class ;
    rdfs:label "Revocation Mechanism"@en ;
    rdfs:comment "A revocation mechanism is a cryptographic or registry-based procedure for invalidating a previously issued credential, certificate, or access token before its natural expiry, allowing issuers to withdraw trust following compromise, policy change, or holder misconduct. In digital identity systems, revocation mechanisms range from Certificate Revocation Lists and OCSP for X.509 certificates to Bitstring Status Lists and cryptographic accumulators for verifiable credentials. The privacy characteristics and scalability of each approach differ substantially, making mechanism selection a critical design decision."@en ;
    rdfs:subClassOf ngm:cryptographic-infrastructure ;
    vc:enables ngm:decentralized-identity-did,
        ngm:self-sovereign-identity-ssi ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:certificate-authority,
        ngm:credential-definition ;
    vc:slug "revocation-mechanism" ;
    vc:sourceDomain "security" ;
    vc:uses ngm:bitstring-status-list,
        ngm:cryptographic-accumulator,
        ngm:verifiable-credentials .

ngm:robot-simulation a owl:Class ;
    rdfs:label "Robot Simulation"@en ;
    rdfs:comment "Robot simulation is the use of physics-based virtual environments to model a robot's kinematics, dynamics, sensors, and interactions before or instead of deploying on hardware. It enables developers to test control software, validate motion plans, and generate training data safely and cheaply. Tight integration with robot middleware lets the same code run in simulation and on the physical robot."@en ;
    rdfs:subClassOf ngm:robotics ;
    skos:broader ngm:robotics ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:forward-kinematics,
        ngm:robot-operating-system ;
    vc:slug "robot-simulation" ;
    vc:sourceDomain "robotics" .

ngm:robotic-telepresence a owl:Class ;
    rdfs:label "Robotic Telepresence"@en ;
    rdfs:comment "\"The projection of human presence into remote physical locations through mobile robotic platforms equipped with cameras, displays, microphones, and speakers, enabling remote operators to navigate environments, interact with people, and manipulate objects as if physically present, bridging virtual..."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:autonomous-navigation ],
        ngm:dc-telepresence,
        ngm:tele-001-telepresence ;
    skos:broader ngm:dc-telepresence ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires ngm:autonomous-navigation ;
    vc:slug "robotic-telepresence" ;
    vc:sourceDomain "distributed-collaboration" .

ngm:safety-assessment a owl:Class ;
    rdfs:label "Safety Assessment"@en ;
    rdfs:comment "Safety assessment is a systematic analytical process that identifies, evaluates, and mitigates hazards associated with a system, product, or operational process to demonstrate that residual risk is tolerable within accepted standards and regulatory frameworks. It encompasses methods such as Failure Modes and Effects Analysis (FMEA), Fault Tree Analysis (FTA), Hazard and Operability Studies (HAZOP), and probabilistic safety analysis, applied across domains including aerospace, automotive, nuclear, medical devices, and increasingly AI systems. Safety assessments form the evidentiary basis for certification against safety standards such as IEC 61508 and ISO 26262."@en ;
    rdfs:subClassOf ngm:risk-assessment ;
    vc:enables ngm:ai-risk-assessment,
        ngm:safety-critical-systems ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:iec-61508,
        ngm:iso-26262,
        ngm:safety-standard ;
    vc:slug "safety-assessment" ;
    vc:sourceDomain "governance" ;
    vc:uses ngm:functional-safety,
        ngm:hazard-analysis,
        ngm:risk-assessment-methodology .

ngm:schema-mapping a owl:Class ;
    rdfs:label "Schema Mapping"@en ;
    rdfs:comment "Schema mapping is the specification of correspondences between the elements of two or more data schemas so that data structured under one can be translated to another. It captures how fields, types and relationships relate, including transformations, defaults and conflict resolution. Schema mapping is a core enabler of data integration, migration and semantic interoperability across heterogeneous systems."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:schema ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-model ],
        ngm:data-integration ;
    vc:bridgesTo ngm:interoperability,
        ngm:semantic-interoperability ;
    vc:dependsOn ngm:data-quality,
        ngm:schema ;
    vc:enables ngm:data-integration,
        ngm:entity-resolution,
        ngm:semantic-interoperability ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:data-integration ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:data-governance,
        ngm:entity-resolution,
        ngm:ontology-alignment ;
    vc:requires ngm:data-model,
        ngm:schema ;
    vc:slug "schema-mapping" ;
    vc:sourceDomain "data" ;
    vc:supports ngm:data-pipeline,
        ngm:data-warehouse,
        ngm:master-data-management ;
    vc:uses ngm:data-model,
        ngm:ontology,
        ngm:ontology-alignment .

ngm:schema-validation a owl:Class ;
    rdfs:label "Schema Validation"@en ;
    rdfs:comment "Schema validation is the process of checking that a data instance conforms to a formally declared structure, asserting required fields, types, value constraints and relationships before the data is accepted or processed. It uses a schema language such as JSON Schema or XML Schema to define the contract and a validator to report conformance and errors. Schema validation enforces data integrity at system boundaries and underpins reliable interoperability."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:data-contracts ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-schema ],
        ngm:data-validation ;
    vc:contrastsWith ngm:asyncapi ;
    vc:dependsOn ngm:data-schema ;
    vc:enables ngm:data-quality,
        ngm:interoperability-standard ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:data-contracts,
        ngm:json-schema ;
    vc:implements ngm:data-validation ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:data-quality,
        ngm:openapi ;
    vc:requires ngm:data-schema,
        ngm:json-schema ;
    vc:slug "schema-validation" ;
    vc:sourceDomain "standards" ;
    vc:standardizedBy ngm:json-schema ;
    vc:supports ngm:api-specification,
        ngm:data-contracts ;
    vc:uses ngm:json-schema,
        ngm:openapi .

ngm:secure-element a owl:Class ;
    rdfs:label "Secure Element"@en ;
    rdfs:comment "A Secure Element (SE) is a tamper-resistant hardware component, typically a dedicated microcontroller, that securely stores cryptographic keys and executes sensitive operations such as signing and authentication in physical isolation from the host system. It enforces hardware-backed access controls so that secret material never leaves the chip in plaintext, resisting both software extraction and many physical attacks. Secure Elements underpin hardware wallets, payment cards, SIMs and mobile secure payment systems, and are commonly certified against standards such as Common Criteria EAL levels."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:private-key ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:key-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:firmware ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptography ],
        ngm:hardware-security-module ;
    vc:contrastsWith ngm:tee ;
    vc:enables ngm:authentication,
        ngm:cold-storage,
        ngm:digital-signature ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:firmware,
        ngm:private-key ;
    vc:isPartOf ngm:hardware-wallet,
        ngm:trusted-execution-environment ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:secure-enclave,
        ngm:side-channel-attack,
        ngm:trusted-platform-module ;
    vc:requires ngm:cryptography,
        ngm:key-management ;
    vc:slug "secure-element" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:self-custody ;
    vc:uses ngm:encryption .

ngm:security-operations a owl:Class ;
    rdfs:label "Security Operations"@en ;
    rdfs:comment "Security operations is the ongoing practice of monitoring, detecting, investigating, and responding to security threats across an organisation's systems. Centred on a security operations centre, it integrates log collection, SIEM correlation, alert triage, threat intelligence, and incident response. Its goal is to reduce dwell time and limit the impact of attacks through continuous vigilance."@en ;
    rdfs:subClassOf ngm:cybersecurity ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:compliance-monitoring ;
    vc:slug "security-operations" ;
    vc:sourceDomain "security" .

ngm:semantic-web-linked-data-standard-standards a owl:Class ;
    rdfs:label "Semantic Web Standards"@en ;
    rdfs:comment "A set of W3C specifications including RDF (Resource Description Framework) and OWL (Web Ontology Language) that enable machine-readable data interchange, knowledge representation, and automated reasoning across distributed web applications."@en ;
    rdfs:subClassOf ngm:sc-standards-and-interop,
        ngm:web-standards ;
    skos:broader ngm:sc-standards-and-interop ;
    vc:enables ngm:data-interoperability ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:slug "semantic-web-standards" ;
    vc:sourceDomain "spatial-computing" .

ngm:semiconductor-fabrication a owl:Class ;
    rdfs:label "Semiconductor Fabrication"@en ;
    rdfs:comment "Semiconductor fabrication is the industrial process by which integrated circuits and discrete semiconductor devices are constructed on crystalline silicon or compound semiconductor wafers through iterative cycles of deposition, photolithography, etching, doping, and planarisation. Each process generation, characterised by a technology node (e.g. 7 nm, 3 nm, 2 nm), defines achievable feature sizes and transistor densities, directly determining the computational density and power efficiency of the resulting chips. Fabrication occurs in ISO Class 1–5 cleanrooms to suppress particle contamination, with yield management and statistical process control being critical disciplines. The field bridges materials science, quantum mechanics, chemical engineering, and precision metrology to produce the foundational hardware layer for all digital computing, AI accelerators, communications infrastructure, and embedded systems."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:process-control ],
        ngm:infra-computing-and-cloud ;
    skos:broader ngm:infra-computing-and-cloud ;
    vc:bridgesTo ngm:neuromorphic-computing,
        ngm:quantum-computation-paradigm ;
    vc:contrastsWith ngm:additive-manufacturing ;
    vc:dependsOn ngm:energy-consumption,
        ngm:supply-chain ;
    vc:enables ngm:gpu ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:moore-s-law ;
    vc:requires ngm:process-control ;
    vc:slug "semiconductor-fabrication" ;
    vc:sourceDomain "infrastructure" ;
    vc:standardizedBy ngm:jedec .

ngm:sensor-system a owl:Class ;
    rdfs:label "Sensor System"@en ;
    rdfs:comment "A sensor system is an integrated assembly of physical transducers, signal conditioning hardware, analogue-to-digital conversion, and data management software that captures physical-world phenomena and transforms them into structured digital representations suitable for processing, analysis, or control. Sensor systems range from single-chip inertial measurement units to multi-modal perception arrays combining cameras, LiDAR, RADAR, and acoustic sensors. Calibration, synchronisation, and fusion across heterogeneous modalities are core engineering concerns. Sensor systems are foundational to robotics, autonomous vehicles, industrial IoT, and environmental monitoring."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:calibration ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:signal-processing ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:sensor-data ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:analog-to-digital-converter ],
        ngm:hardware-component ;
    vc:enables ngm:autonomous-navigation,
        ngm:perception-system,
        ngm:real-time-processing ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:analog-to-digital-converter,
        ngm:calibration,
        ngm:sensor-data,
        ngm:signal-processing ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:autonomous-vehicle,
        ngm:edge-computing,
        ngm:embedded-systems,
        ngm:reliability ;
    vc:slug "sensor-system" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:camera,
        ngm:imu,
        ngm:lidar,
        ngm:sensor-fusion .

ngm:series-elastic-actuation a owl:Class ;
    rdfs:label "Series Elastic Actuation"@en ;
    rdfs:comment "Series Elastic Actuation (SEA) is a robotic actuation paradigm in which a calibrated compliant element — typically a torsional or linear spring — is interposed in series between a motor-gearbox drive train and the output link of a robot joint. The spring deflection under load provides an indirect torque measurement via Hooke's Law, enabling high-fidelity closed-loop torque control without the complexity of strain-gauge transducers. This intrinsic mechanical compliance attenuates shock loads, lowers the reflected inertia experienced during unintended contact, and passively limits peak interaction forces — properties that are essential for safe physical human–robot interaction. SEA is a foundational technology in legged locomotion systems, rehabilitation exoskeletons, prosthetic limbs, and compliant collaborative robots, and stands as the seminal example of intentional mechanical compliance in actuation design."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:torque-sensor ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:torque-control ],
        ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:bridgesTo ngm:prosthetics,
        ngm:wearable-robotics ;
    vc:contrastsWith ngm:actuator,
        ngm:hydraulic-actuator,
        ngm:variable-stiffness-actuator ;
    vc:dependsOn ngm:actuator,
        ngm:pid-controller ;
    vc:enables ngm:admittance-control,
        ngm:force-control,
        ngm:impedance-control,
        ngm:safe-human-robot-interaction ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:compliant-spring-element,
        ngm:torque-sensor ;
    vc:isPartOf ngm:robot-joint ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:backdrivability,
        ngm:collaborative-systems-modality-robot ;
    vc:requires ngm:position-encoder,
        ngm:torque-control ;
    vc:slug "series-elastic-actuation" ;
    vc:sourceDomain "robotics" ;
    vc:standardizedBy ngm:iso-10218,
        ngm:iso-ts-15066 ;
    vc:supports ngm:legged-locomotion,
        ngm:rehabilitation-robotics,
        ngm:robo-human-robot-interaction ;
    vc:uses ngm:hookes-law,
        ngm:rotary-encoder .

ngm:situational-awareness a owl:Class ;
    rdfs:label "Situational Awareness"@en ;
    rdfs:comment "Situational awareness is an agent's perception of relevant elements in its environment, comprehension of their meaning and projection of their near-future state, supporting timely decisions."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:computer-vision ],
        ngm:robotics ;
    skos:broader ngm:robotics ;
    vc:enables ngm:autonomous-agent ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:computer-vision ;
    vc:slug "situational-awareness" ;
    vc:sourceDomain "metaverse" .

ngm:six-degrees-of-freedom a owl:Class ;
    rdfs:label "Six Degrees Of Freedom"@en ;
    rdfs:comment "Six degrees of freedom (6DoF) describes the full set of ways a rigid body can move in three-dimensional space: translation along three perpendicular axes and rotation about each of them. In spatial computing it characterises tracking systems that capture both an object's position and its orientation. Supporting 6DoF is essential for convincing virtual and augmented reality, robotics and motion-tracked interaction."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:sensor-fusion ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:pose-estimation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:inertial-measurement-unit ],
        ngm:tracking-system ;
    vc:bridgesTo ngm:robotics,
        ngm:spatial-computing ;
    vc:dependsOn ngm:pose-estimation,
        ngm:tracking-system ;
    vc:enables ngm:augmented-reality,
        ngm:immersion,
        ngm:virtual-reality ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:spatial-tracking,
        ngm:tracking-system ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:motion-tracking,
        ngm:spatial-tracking ;
    vc:requires ngm:inertial-measurement-unit,
        ngm:pose-estimation,
        ngm:sensor-fusion ;
    vc:slug "six-degrees-of-freedom" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:head-mounted-display,
        ngm:locomotion,
        ngm:motion-tracking ;
    vc:uses ngm:inertial-measurement-unit,
        ngm:sensor-fusion,
        ngm:slam .

ngm:soap a owl:Class ;
    rdfs:label "SOAP"@en ;
    rdfs:comment "SOAP (Simple Object Access Protocol) is a standardised, XML-based messaging protocol for exchanging structured information between applications, typically over HTTP but also over other transports. It defines an envelope structure with a header and body, supports remote procedure calls and document-style messaging, and is described by WSDL contracts and extended by the WS-* specifications for security, transactions, and reliable messaging. SOAP underpinned the first generation of enterprise web services and remains common in regulated and legacy integration scenarios, contrasting with the lighter, resource-oriented REST style."@en ;
    rdfs:subClassOf ngm:web-services ;
    vc:bridgesTo ngm:api,
        ngm:middleware ;
    vc:contrastsWith ngm:rest ;
    vc:dependsOn ngm:xml ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:implements ngm:remote-procedure-call ;
    vc:isPartOf ngm:web-services ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:json,
        ngm:remote-procedure-call,
        ngm:service-oriented-architecture ;
    vc:slug "soap" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:enterprise-integration,
        ngm:service-oriented-architecture ;
    vc:uses ngm:http,
        ngm:xml .

ngm:social-contract a owl:Class ;
    rdfs:label "Social Contract"@en ;
    rdfs:comment "A philosophical and political theory positing that individuals consent, either explicitly or tacitly, to surrender certain freedoms and submit to authority in exchange for protection of their remaining rights and maintenance of social order."@en ;
    rdfs:subClassOf ngm:infra-legal-and-regulatory ;
    skos:broader ngm:infra-legal-and-regulatory ;
    vc:enables ngm:civil-society,
        ngm:democratic-governance ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:slug "social-contract" ;
    vc:sourceDomain "infrastructure" .

ngm:social-interaction a owl:Class ;
    rdfs:label "Social Interaction"@en ;
    rdfs:comment "Social Interaction refers to the dynamic process by which two or more agents — human or artificial — mutually influence one another's behaviour, cognition, and emotional states through communicative acts, physical co-presence, or mediated channels. It is the fundamental unit of social life, encompassing verbal conversation, nonverbal signals, turn-taking, joint attention, empathic responsiveness, and negotiation of shared meaning. In the context of digital and AI systems, social interaction extends to human-computer interfaces, social robotics, virtual environments, and AI-mediated communication platforms, where the design of interaction modalities profoundly shapes social outcomes and wellbeing."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:dialogue-management ],
        ngm:sc-interaction ;
    skos:broader ngm:sc-interaction ;
    vc:bridgesTo ngm:distributed-collaboration,
        ngm:robotics,
        ngm:spatial-computing ;
    vc:enables ngm:collaborative-systems-modality-learning,
        ngm:conversational-ai,
        ngm:emotion-aware-interaction,
        ngm:social-network-graph,
        ngm:trust-building ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:dialogue-management ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:human-computer-interaction,
        ngm:human-robot-interaction,
        ngm:joint-attention,
        ngm:nonverbal-communication,
        ngm:social-presence,
        ngm:theory-of-mind,
        ngm:turn-taking ;
    vc:requires ngm:communication-channel ;
    vc:slug "social-interaction" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:affective-computing,
        ngm:emotional-intelligence,
        ngm:natural-interaction,
        ngm:natural-language-processing,
        ngm:proxemics .

ngm:soft-fork a owl:Class ;
    rdfs:label "Soft Fork"@en ;
    rdfs:comment "A Soft Fork is a backward-compatible change to a blockchain's consensus rules in which the set of valid blocks is tightened so that newly produced blocks remain acceptable to non-upgraded nodes. Because old nodes still recognise the stricter blocks as valid, the network does not split provided a majority of hash power or stake enforces the new rules. Soft forks are commonly used to deploy protocol upgrades such as new script types without requiring every participant to update."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:consensus-mechanism ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:backward-compatibility ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:validation-rules ],
        ngm:hard-fork ;
    vc:contrastsWith ngm:hard-fork ;
    vc:dependsOn ngm:full-node,
        ngm:node-software ;
    vc:enables ngm:bip-342,
        ngm:taproot ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:user-activated-soft-fork ;
    vc:isPartOf ngm:blockchain-governance ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:blockchain-governance,
        ngm:consensus-mechanism ;
    vc:requires ngm:backward-compatibility,
        ngm:consensus-mechanism,
        ngm:validation-rules ;
    vc:slug "soft-fork" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:backward-compatibility ;
    vc:uses ngm:block-validation,
        ngm:validation-rules .

ngm:sound-money a owl:Class ;
    rdfs:label "Sound Money"@en ;
    rdfs:comment "Sound Money refers to a monetary medium characterised by a stable, predictable supply that cannot be arbitrarily expanded by a government or central authority, thereby preserving purchasing power over time and functioning as a reliable store of value. The concept is historically associated with commodity-backed currencies—particularly the classical gold standard—and in the contemporary context with Bitcoin's algorithmically fixed supply schedule. Sound money theorists, drawing heavily on the Austrian School, argue that monetary expansion through credit creation distorts price signals, misallocates capital, and produces inflationary cycles that systematically transfer wealth from savers to debtors and from the public to the financial sector. The notion stands in direct opposition to the discretionary monetary policy frameworks of modern central banking."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:monetary-sovereignty ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:scarcity ],
        ngm:monetary-system ;
    vc:bridgesTo ngm:financial-sovereignty,
        ngm:proof-of-work ;
    vc:contrastsWith ngm:central-bank-digital-currency,
        ngm:fiat-currency,
        ngm:fractional-reserve-banking,
        ngm:monetary-policy-implementation,
        ngm:quantitative-easing ;
    vc:dependsOn ngm:consensus,
        ngm:property-rights ;
    vc:enables ngm:bitcoin-proof-of-work-protocol-value-proposition,
        ngm:hyperbitcoinization ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:bitcoin-protocol,
        ngm:gold-standard ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:austrian-economics,
        ngm:bitcoin-proof-of-work-protocol-standard,
        ngm:commodity-money,
        ngm:gold,
        ngm:inflation,
        ngm:purchasing-power,
        ngm:store-of-value ;
    vc:requires ngm:fixed-supply-schedule,
        ngm:monetary-sovereignty,
        ngm:scarcity ;
    vc:slug "sound-money" ;
    vc:sourceDomain "finance" .

ngm:staking-reward a owl:Class ;
    rdfs:label "Staking Reward"@en ;
    rdfs:comment "A staking reward is the compensation paid to participants who lock cryptocurrency to help secure a proof-of-stake network. Rewards are typically funded by protocol issuance and transaction fees and are distributed in proportion to the amount staked and the validator's correct, online participation in consensus. They create the economic incentive that aligns validator behaviour with network security and liveness."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:transaction-fee ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:slashing ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:block-reward ],
        ngm:economic-mechanism ;
    vc:dependsOn ngm:consensus-mechanism,
        ngm:validator-node ;
    vc:enables ngm:liquid-staking,
        ngm:yield-generation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:block-reward,
        ngm:transaction-fee ;
    vc:isPartOf ngm:proof-of-stake ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:cryptocurrency,
        ngm:delegated-proof-of-stake,
        ngm:inflation ;
    vc:requires ngm:slashing ;
    vc:slug "staking-reward" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:economic-mechanism ;
    vc:uses ngm:staking,
        ngm:token-economics .

ngm:storage-hardware a owl:Class ;
    rdfs:label "Storage Hardware"@en ;
    rdfs:comment "Storage Hardware comprises the physical devices and subsystems responsible for persistently recording, retrieving, and managing digital data within computing infrastructure. This category covers technologies ranging from solid-state drives and NVMe arrays to distributed storage nodes and archival media. In AI and spatial computing contexts, storage hardware is a critical constraint on model training throughput, inference latency, and the scalability of data pipelines."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:data-storage-layer ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:storage-layer ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-storage ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:storage-infrastructure ],
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:bridgesTo ngm:hardware-component ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:data-storage-layer,
        ngm:storage-layer ;
    vc:isPartOf ngm:computing-hardware,
        ngm:hardware-and-edge ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:data-processing-hardware,
        ngm:inference-hardware,
        ngm:processing-hardware,
        ngm:training-hardware ;
    vc:requires ngm:data-storage,
        ngm:storage-infrastructure ;
    vc:slug "storage-hardware" ;
    vc:sourceDomain "spatial-computing" .

ngm:stranded-energy-monetisation a owl:Class ;
    rdfs:label "Stranded Energy Monetisation"@en ;
    rdfs:comment "Stranded energy monetisation is the practice of converting otherwise wasted or non-transmittable electricity—including curtailed renewable generation, flared natural gas, and grid-overflow surplus—into economic value through flexible, interruptible load processes such as Bitcoin mining or electrolyser hydrogen production. By co-locating computation or industrial loads at the energy source, it captures value that cannot reach load centres due to grid constraints."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:methane-mitigation-mining ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:demand-response-mining ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:renewable-energy ],
        ngm:stranded-energy ;
    vc:bridgesTo ngm:green-hydrogen-production,
        ngm:infrastructure,
        ngm:sustainable-bitcoin-protocol ;
    vc:contrastsWith ngm:grid-scale-energy-storage,
        ngm:renewable-energy ;
    vc:dependsOn ngm:bitcoin-proof-of-work-protocol-mining,
        ngm:grid-infrastructure ;
    vc:enables ngm:methane-emissions-reduction,
        ngm:renewable-energy-investment ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:demand-response-mining,
        ngm:methane-mitigation-mining ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:blockchain-sustainability,
        ngm:carbon-footprint ;
    vc:requires ngm:renewable-energy ;
    vc:slug "stranded-energy-monetisation" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:bitcoin-proof-of-work-protocol-mining,
        ngm:demand-response,
        ngm:methane-abatement,
        ngm:mining,
        ngm:proof-of-work .

ngm:swift-messaging a owl:Class ;
    rdfs:label "SWIFT Messaging"@en ;
    rdfs:comment "SWIFT Messaging is the standardised, structured financial message exchange system operated over the Society for Worldwide Interbank Financial Telecommunication (SWIFT) network, enabling banks, brokers, custodians, and other financial institutions to communicate payment instructions, securities transactions, treasury operations, and trade finance data. Messages are governed by two principal format families: the legacy MT (Message Type) standards encoded in SWIFT's own syntax, and the modern ISO 20022 MX messages encoded in XML, which carry richer, more granular data and support global harmonisation. SWIFT itself functions as a secure messaging infrastructure rather than a settlement system; actual fund movement occurs via correspondent banking relationships, real-time gross settlement (RTGS) systems, and central bank facilities. The network is subject to multi-jurisdictional regulatory oversight and is a critical node in the global financial stability architecture."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:iso-20022 ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:swift ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:correspondent-banking ],
        ngm:infra-network-and-comms ;
    skos:broader ngm:infra-network-and-comms ;
    vc:bridgesTo ngm:central-bank-digital-currency,
        ngm:distributed-ledger-technology ;
    vc:dependsOn ngm:public-key-infrastructure,
        ngm:real-time-gross-settlement ;
    vc:enables ngm:cross-border-payments,
        ngm:securities-settlement,
        ngm:trade-finance,
        ngm:treasury-management ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:iso-20022 ;
    vc:implements ngm:cpmi-iosco-pfmi,
        ngm:iso-20022 ;
    vc:isPartOf ngm:financial-infrastructure,
        ngm:swift ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:financial-market-infrastructure,
        ngm:payment-system ;
    vc:requires ngm:business-identifier-code,
        ngm:correspondent-banking,
        ngm:swift ;
    vc:slug "swift-messaging" ;
    vc:sourceDomain "finance" ;
    vc:standardizedBy ngm:swift ;
    vc:supports ngm:anti-money-laundering,
        ngm:know-your-customer,
        ngm:sanctions-screening ;
    vc:uses ngm:message-authentication-code .

ngm:symbolic-reasoning a owl:Class ;
    rdfs:label "Symbolic Reasoning"@en ;
    rdfs:comment "A family of AI techniques that represent knowledge as explicit symbols, rules, and logical relations and derive new conclusions through formal inference mechanisms such as resolution, forward/backward chaining, or constraint propagation. Symbolic reasoning underpins expert systems, knowledge graphs, and logic programming, and contrasts with sub-symbolic connectionist approaches while being combined with them in neuro-symbolic architectures."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:knowledge-representation ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:logic-programming ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:fuzzy-logic ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:expert-systems ],
        ngm:ai-technique,
        ngm:reasoning ;
    skos:broader ngm:ai-technique ;
    vc:contrastsWith ngm:machine-learning-discipline ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:expert-systems,
        ngm:fuzzy-logic,
        ngm:knowledge-representation,
        ngm:logic-programming ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:automated-planning,
        ngm:chain-of-thought-reasoning,
        ngm:knowledge-graph,
        ngm:mathematical-reasoning ;
    vc:slug "symbolic-reasoning" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:inference .

ngm:system-integration a owl:Class ;
    rdfs:label "System Integration"@en ;
    rdfs:comment "System Integration is the engineering discipline of connecting and orchestrating disparate software components, services, databases, and external platforms so that they behave as a unified, interoperable system. It spans interface design via APIs and messaging protocols, middleware orchestration, data transformation pipelines, identity federation, and governance of information flows across organisational and technical boundaries. Unlike simple point-to-point coupling, mature system integration imposes coherent contracts, observability, and error-recovery strategies so that independently developed or procured subsystems can exchange information reliably. The discipline underpins enterprise IT, cloud-native architectures, IoT deployments, and the composable software stacks that drive spatial computing and AI platforms."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:identity-federation ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:api-gateway ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:data-pipeline ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:api-design ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:message-broker ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:middleware ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-serialization ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:service-mesh ],
        ngm:software-architecture ;
    vc:bridgesTo ngm:spatial-computing,
        ngm:supply-chain-visibility ;
    vc:contrastsWith ngm:monolithic-architecture,
        ngm:point-to-point-integration ;
    vc:dependsOn ngm:network-protocol,
        ngm:security-policy ;
    vc:enables ngm:composable-architecture,
        ngm:digital-twin,
        ngm:distributed-systems,
        ngm:interoperability ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:api-gateway,
        ngm:data-pipeline,
        ngm:message-broker,
        ngm:middleware,
        ngm:service-mesh ;
    vc:implements ngm:event-driven-architecture,
        ngm:microservices,
        ngm:service-oriented-architecture ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:devops,
        ngm:enterprise-architecture,
        ngm:observability ;
    vc:requires ngm:api-design,
        ngm:data-serialization,
        ngm:identity-federation ;
    vc:slug "system-integration" ;
    vc:sourceDomain "infrastructure" ;
    vc:standardizedBy ngm:asyncapi,
        ngm:open-api-specification ;
    vc:uses ngm:apache-kafka,
        ngm:g-rpc,
        ngm:graph-ql,
        ngm:rest-api .

ngm:tally a owl:Class ;
    rdfs:label "Tally"@en ;
    rdfs:comment "A web platform and toolset for creating and managing on-chain decentralised autonomous organisations, providing interfaces for proposal creation, delegation and governance voting across widely used governance contract frameworks."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
