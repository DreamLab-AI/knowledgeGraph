    vc:sourceDomain "artificial-intelligence" .

ngm:lattice-cryptography a owl:Class ;
    rdfs:label "Lattice Cryptography"@en ;
    rdfs:comment "A family of cryptographic constructions whose security rests on the hardness of computational problems over high-dimensional lattices, such as learning with errors. These problems are believed to resist attacks by quantum computers."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptography ],
        ngm:post-quantum-cryptography ;
    vc:enables ngm:digital-signature,
        ngm:encryption ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:cryptography ;
    vc:slug "lattice-cryptography" ;
    vc:sourceDomain "security" .

ngm:layout-algorithm a owl:Class ;
    rdfs:label "Layout Algorithm"@en ;
    rdfs:comment "A layout algorithm is a computational procedure that automatically assigns spatial positions to graphical elements such as nodes, edges, or boxes to produce a readable diagram or interface. Common families include force-directed, hierarchical (Sugiyama), orthogonal, and tree layouts, each optimising criteria like minimal edge crossings, uniform spacing, or compactness. Layout algorithms are central to diagram rendering and graph visualisation."@en ;
    rdfs:subClassOf ngm:infra-software-engineering ;
    skos:broader ngm:infra-software-engineering ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:ai-diagram-tools,
        ngm:diagrams-as-code ;
    vc:slug "layout-algorithm" ;
    vc:sourceDomain "infrastructure" .

ngm:ldpc-codes a owl:Class ;
    rdfs:label "LDPC Codes"@en ;
    rdfs:comment "Low-Density Parity-Check (LDPC) codes are a class of linear error-correcting codes defined by a sparse parity-check matrix and decoded with iterative belief-propagation algorithms. They approach the Shannon capacity limit while remaining computationally tractable, making them a dominant forward-error-correction scheme in modern communications. LDPC codes are mandated in standards such as Wi-Fi 6, 5G NR data channels, and DVB-S2."@en ;
    rdfs:subClassOf ngm:infra-network-and-comms ;
    skos:broader ngm:infra-network-and-comms ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:forward-error-correction,
        ngm:physical-layer ;
    vc:slug "ldpc-codes" ;
    vc:sourceDomain "infrastructure" .

ngm:learner-model a skos:Concept ;
    rdfs:label "Learner Model"@en .

ngm:legal-entity-identifier a owl:Class ;
    rdfs:label "Legal Entity Identifier"@en ;
    rdfs:comment "A Legal Entity Identifier (LEI) is a 20-character alphanumeric code, standardised as ISO 17442, that uniquely identifies a legally distinct entity participating in financial transactions. It is issued by accredited Local Operating Units under the Global LEI System and carries reference data on the entity's ownership and registration. LEIs enable counterparty transparency and are increasingly required for regulatory and trade reporting."@en ;
    rdfs:subClassOf ngm:infra-legal-and-regulatory ;
    skos:broader ngm:infra-legal-and-regulatory ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:regulatory-reporting,
        ngm:travel-rule ;
    vc:slug "legal-entity-identifier" ;
    vc:sourceDomain "governance" .

ngm:legal-entity-structure a owl:Class ;
    rdfs:label "Legal Entity Structure"@en ;
    rdfs:comment "A legal entity structure is the organisational arrangement of incorporated bodies, subsidiaries, foundations, and operating companies through which an organisation conducts business and holds assets. It determines liability boundaries, tax treatment, governance rights, and regulatory obligations across jurisdictions. In crypto and DAO contexts it often pairs on-chain governance with off-chain foundations or LLCs to obtain legal personality."@en ;
    rdfs:subClassOf ngm:infra-legal-and-regulatory ;
    skos:broader ngm:infra-legal-and-regulatory ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:cross-border-compliance,
        ngm:treasury-management ;
    vc:slug "legal-entity-structure" ;
    vc:sourceDomain "governance" .

ngm:liberal-radicalism a owl:Class ;
    rdfs:label "Liberal Radicalism"@en ;
    rdfs:comment "Liberal Radicalism (LR) is a mechanism-design framework, introduced by Buterin, Hitzig, and Weyl, for optimally funding public goods through a matching scheme in which contributions are pooled and the matching amount allocated to each project grows with the square of the sum of the square roots of individual contributions. This mathematical structure rewards the breadth of support — the number of distinct contributors — over the concentration of large donations, aligning funding with collective preference. It is the theoretical basis for quadratic funding as deployed in real-world grants programmes."@en ;
    rdfs:subClassOf ngm:mechanism-design ;
    vc:enables ngm:public-goods-funding,
        ngm:quadratic-funding ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:quadratic-voting ;
    vc:slug "liberal-radicalism" ;
    vc:sourceDomain "governance" .

ngm:linear-quadratic-regulator a owl:Class ;
    rdfs:label "Linear Quadratic Regulator"@en ;
    rdfs:comment "The Linear Quadratic Regulator (LQR) is an optimal control framework that computes the state-feedback gain matrix minimising a quadratic cost function — a weighted sum of squared state deviations and squared control inputs over a time horizon — for a linear dynamical system, yielding the globally optimal linear feedback law in closed form through the algebraic Riccati equation. LQR provides a principled, tunable controller where the designer specifies performance-energy trade-offs through cost weight matrices Q (penalising state error) and R (penalising control effort), and the solution guarantees both optimality with respect to this cost and closed-loop stability for controllable systems. Despite its linearity assumption, LQR is widely extended to nonlinear systems via linearisation, iterative LQR (iLQR), and as the backbone of linear-quadratic-Gaussian (LQG) control when combined with Kalman filtering."@en ;
    rdfs:subClassOf ngm:optimal-control ;
    vc:enables ngm:model-predictive-control,
        ngm:robot-control,
        ngm:trajectory-tracking ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:adaptive-control,
        ngm:pid-controller ;
    vc:slug "linear-quadratic-regulator" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:kalman-filter,
        ngm:stability-analysis,
        ngm:state-space-control .

ngm:linked-data-platform a owl:Class ;
    rdfs:label "Linked Data Platform"@en ;
    rdfs:comment "A W3C specification defining rules and HTTP conventions for reading and writing linked data resources, enabling RESTful management of RDF data on the web."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:rdf ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:linked-data ],
        ngm:linked-data ;
    vc:enables ngm:semantic-web-linked-data-standard ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:linked-data,
        ngm:rdf ;
    vc:slug "linked-data-platform" ;
    vc:sourceDomain "standards" .

ngm:lo-ra-wan a owl:Class ;
    rdfs:label "LoRaWAN"@en ;
    rdfs:comment "LoRaWAN is a media-access-control protocol and network architecture for low-power wide-area networks, built on the LoRa physical layer's chirp spread-spectrum modulation. It connects battery-powered devices to gateways over distances of several kilometres at low data rates, with end-to-end encryption and adaptive data-rate management. LoRaWAN is widely used for long-range, low-throughput IoT telemetry such as cold-chain and environmental monitoring."@en ;
    rdfs:subClassOf ngm:communication-protocol ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:cold-chain-monitoring,
        ngm:io-t-sensor-network ;
    vc:slug "lo-ra-wan" ;
    vc:sourceDomain "infrastructure" .

ngm:locality-sensitive-hashing a owl:Class ;
    rdfs:label "Locality-Sensitive Hashing"@en ;
    rdfs:comment "Locality-sensitive hashing (LSH) is a family of hashing techniques that map similar high-dimensional inputs to the same hash bucket with high probability, enabling sub-linear approximate nearest-neighbour search. By trading exactness for speed, LSH makes similarity search and deduplication tractable over very large datasets. It is widely applied to embeddings, document near-duplicate detection, and retrieval pipelines."@en ;
    rdfs:subClassOf ngm:machine-learning-discipline-technique ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:information-retrieval,
        ngm:training-data ;
    vc:slug "locality-sensitive-hashing" ;
    vc:sourceDomain "ai" .

ngm:log-aggregation a owl:Class ;
    rdfs:label "Log Aggregation"@en ;
    rdfs:comment "Log aggregation is the practice of collecting log events from many distributed sources into a centralised, searchable store so they can be parsed, indexed, correlated, and analysed as a unified stream. It is a foundational component of observability and monitoring pipelines, enabling operators to debug incidents, detect anomalies, and satisfy audit requirements across services that would otherwise emit logs in isolation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:indexing ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:indexing ],
        ngm:observability ;
    vc:dependsOn ngm:logging ;
    vc:enables ngm:monitoring ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:indexing,
        ngm:logging ;
    vc:isPartOf ngm:monitoring,
        ngm:observability ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:metrics-collection,
        ngm:microservices ;
    vc:requires ngm:indexing ;
    vc:slug "log-aggregation" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:audit-logging,
        ngm:siem ;
    vc:uses ngm:full-text-search .

ngm:logical-clock a owl:Class ;
    rdfs:label "Logical Clock"@en ;
    rdfs:comment "A logical clock is a mechanism for ordering events in a distributed system without relying on synchronised physical time. It assigns monotonically increasing counters to events so that causal relationships between them can be inferred, supporting the happened-before relation. Logical clocks underpin consistency, coordination and debugging in systems where no global wall-clock can be trusted."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:vector-clock ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:concurrency ],
        ngm:distributed-systems-theory ;
    vc:bridgesTo ngm:consensus ;
    vc:contrastsWith ngm:time-synchronisation,
        ngm:timestamp ;
    vc:enables ngm:consensus ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:vector-clock ;
    vc:isPartOf ngm:distributed-systems-theory ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:distributed-systems,
        ngm:timestamp,
        ngm:vector-clock ;
    vc:requires ngm:concurrency ;
    vc:slug "logical-clock" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:distributed-computing,
        ngm:distributed-systems ;
    vc:uses ngm:concurrency .

ngm:logistics-automation a owl:Class ;
    rdfs:label "Logistics Automation"@en ;
    rdfs:comment "Logistics automation is the application of robotics, software, and AI to the physical and informational tasks of moving, storing, and tracking goods across supply chains — including goods-to-person fulfilment, autonomous transport, and intelligent route optimisation — with the goal of reducing labour costs, improving throughput, and increasing reliability."@en ;
    rdfs:subClassOf ngm:supply-chain-management ;
    vc:enables ngm:logistics-optimization,
        ngm:supply-chain ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:mobile-robotics ;
    vc:slug "logistics-automation" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:autonomous-vehicle,
        ngm:machine-learning-discipline,
        ngm:warehouse-automation .

ngm:long-term-preservation a owl:Class ;
    rdfs:label "Long-Term Preservation"@en ;
    rdfs:comment "Long-term preservation is the set of policies, strategies, and technical practices that ensure digital assets, records, and information objects remain accessible, authentic, and usable across decades or centuries. It encompasses format migration, bit-level integrity monitoring, metadata stewardship, and provenance documentation to guard against technological obsolescence, media decay, and institutional discontinuity. The field draws on archival science, information management, and computer science to maintain the evidential and informational value of materials well beyond the lifespan of their originating systems. Standards such as OAIS (ISO 14721) provide reference models that underpin most compliant preservation programmes."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:content-addressed-storage ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-format-standard ],
        ngm:digital-preservation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:archival-standards,
        ngm:data-integrity,
        ngm:metadata-standard ;
    vc:requires ngm:content-addressed-storage,
        ngm:data-format-standard ;
    vc:slug "long-term-preservation" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:cultural-heritage-preservation,
        ngm:long-term-archival ;
    vc:uses ngm:archival-node,
        ngm:digital-archive .

ngm:lossy-compression a skos:Concept ;
    rdfs:label "Lossy Compression"@en .

ngm:ly-coris a owl:Class ;
    rdfs:label "LyCORIS"@en ;
    rdfs:comment "LyCORIS (Lora beYond Conventional methods, Other Rank adaptation Implementations for Stable diffusion) is an open-source library implementing a family of parameter-efficient fine-tuning methods for diffusion and other models that extend beyond standard low-rank adaptation. It includes techniques such as LoHa (Hadamard-product decomposition), LoKr (Kronecker-product decomposition), and full or convolutional adaptations, giving practitioners a richer set of expressiveness-versus-size trade-offs. LyCORIS is widely used in the image-generation community to train compact, shareable model adapters."@en ;
    rdfs:subClassOf ngm:parameter-efficient-fine-tuning ;
    vc:enables ngm:fine-tuning ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:deep-learning ;
    vc:slug "ly-coris" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:low-rank-adaptation .

ngm:maci a owl:Class ;
    rdfs:label "MACI"@en ;
    rdfs:comment "Minimal Anti-Collusion Infrastructure, a set of smart contracts and zero-knowledge techniques designed to reduce bribery and collusion in on-chain voting. It hides individual votes from coercers while allowing public verification of results."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:zero-knowledge-proof ],
        ngm:quadratic-voting ;
    vc:enables ngm:decentralized-autonomous-organization ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:zero-knowledge-proof ;
    vc:slug "maci" ;
    vc:sourceDomain "blockchain" .

ngm:market-access a owl:Class ;
    rdfs:label "Market Access"@en ;
    rdfs:comment "Market access is the ability of a product, service or system to be lawfully sold and adopted within a target jurisdiction or sector, conditioned on meeting regulatory, certification and conformity requirements. For robotic and physical-automation systems it depends on demonstrating compliance with safety, electromagnetic and product-directive obligations such as CE marking before placement on a market. Achieving market access is therefore a gateway to commercialisation rather than a purely commercial activity."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:regulatory-approval ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:compliance ],
        ngm:robotics ;
    skos:broader ngm:robotics ;
    vc:bridgesTo ngm:supply-chain ;
    vc:contrastsWith ngm:regulatory-approval ;
    vc:dependsOn ngm:ce-marking ;
    vc:enables ngm:supply-chain ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:ce-marking,
        ngm:compliance,
        ngm:regulatory-approval ;
    vc:requires ngm:compliance,
        ngm:regulatory-approval ;
    vc:slug "market-access" ;
    vc:sourceDomain "robotics" ;
    vc:standardizedBy ngm:ce-marking ;
    vc:supports ngm:risk-assessment .

ngm:mass-customisation a owl:Class ;
    rdfs:label "Mass Customisation"@en ;
    rdfs:comment "Mass customisation is a production strategy that delivers individually tailored goods or services at costs approaching those of mass production. It combines flexible manufacturing, modular design, and digital configuration so customers can specify variants without sacrificing scale economies. Robotics, additive manufacturing, and data-driven personalisation are key enablers across sectors such as fashion and consumer goods."@en ;
    rdfs:subClassOf ngm:economic-mechanism ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:fashion,
        ngm:industrial-robot ;
    vc:slug "mass-customisation" ;
    vc:sourceDomain "robotics" .

ngm:mcp-client a owl:Class ;
    rdfs:label "MCP Client"@en ;
    rdfs:comment "An MCP client is the component within an AI host application that establishes and maintains a connection to one or more Model Context Protocol servers. It negotiates capabilities, forwards tool, resource, and prompt requests from the language model, and relays results back into the model's context. Each client maintains a one-to-one session with a server, mediating the model's access to external systems."@en ;
    rdfs:subClassOf ngm:ai-agent-system ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:mcp-server,
        ngm:model-context-protocol ;
    vc:slug "mcp-client" ;
    vc:sourceDomain "ai" .

ngm:medical-simulation a owl:Class ;
    rdfs:label "Medical Simulation"@en ;
    rdfs:comment "Medical simulation is the use of virtual environments, mannequins, and digital models to replicate clinical scenarios for training, assessment, and procedure planning. Immersive and motion-tracked simulations let clinicians rehearse surgery and emergency response without risk to patients. It is a core application of metaverse and XR technologies within healthcare education and practice."@en ;
    rdfs:subClassOf ngm:virtual-environment ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:health-metaverse-application,
        ngm:motion-capture ;
    vc:slug "medical-simulation" ;
    vc:sourceDomain "metaverse" .

