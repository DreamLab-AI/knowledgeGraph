ngm:private-blockchain a owl:Class ;
    rdfs:label "Private Blockchain"@en ;
    rdfs:comment "A private blockchain is a permissioned distributed ledger in which access, participation, and validation rights are restricted to a pre-approved set of known entities, typically operated by a single organisation or a closed consortium. Unlike public blockchains, private blockchains prioritise throughput, deterministic finality, and data confidentiality over open participation, relying on governance frameworks and identity management rather than anonymous proof-of-work mining to secure the network."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:blockchain-compliance ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:blockchain-governance ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:permissioned-network ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:consensus-mechanism ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:smart-contract ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:access-control ],
        ngm:bc-network-component ;
    skos:broader ngm:bc-network-component ;
    vc:contrastsWith ngm:consortium-blockchain,
        ngm:public-blockchain ;
    vc:enables ngm:blockchain-interoperability,
        ngm:enterprise-blockchain,
        ngm:supply-chain-blockchain ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:access-control,
        ngm:consensus-mechanism,
        ngm:smart-contract ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:blockchain-scalability,
        ngm:deterministic-finality,
        ngm:distributed-ledger ;
    vc:requires ngm:blockchain-compliance,
        ngm:blockchain-governance,
        ngm:permissioned-network ;
    vc:slug "private-blockchain" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:byzantine-fault-tolerance,
        ngm:hyperledger-besu,
        ngm:hyperledger-fabric .

ngm:private-channels a owl:Class ;
    rdfs:label "Private Channels"@en ;
    rdfs:comment "Confidential transaction subsets in PermissionedBlockchain|permissioned blockchains where designated participants conduct transactions invisibly to other network members, implementing Encryption|encryption and AccessControl|access control to segregate sensitive business data whilst ma..."@en ;
    rdfs:subClassOf ngm:bc-network-component ;
    skos:broader ngm:bc-network-component ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.4"^^xsd:float ;
    vc:slug "private-channels" ;
    vc:sourceDomain "blockchain" ;
