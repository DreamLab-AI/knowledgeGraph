    vc:enables ngm:reinforcement-learning,
        ngm:value-alignment ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:ai-research-area ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:deep-learning,
        ngm:machine-learning-discipline,
        ngm:reinforcement-learning-from-human-feedback,
        ngm:reward-model ;
    vc:requires ngm:loss-function,
        ngm:reward-function ;
    vc:slug "value-vector" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:optimization-technique,
        ngm:preference-learning .

