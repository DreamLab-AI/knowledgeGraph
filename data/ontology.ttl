ngm:transfer-learning a owl:Class ;
    rdfs:label "Transfer Learning"@en ;
    rdfs:comment "Transfer learning is a machine learning paradigm in which knowledge encoded in a model trained on a source task or domain is systematically reused to improve learning efficiency and performance on a different but related target task or domain. By exploiting shared representations — such as low-level feature detectors, syntactic structures, or visual hierarchies — the technique drastically reduces the labelled data, compute, and training time required for downstream tasks. It is foundational to modern deep learning practice, underpinning pre-trained large language models, vision transformers, and multi-modal systems that are subsequently adapted via fine-tuning, prompt tuning, or adapter layers. The paradigm bridges the gap between data-rich source domains and data-scarce target settings, enabling deployment in low-resource clinical, scientific, and industrial contexts."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:fine-tuning ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:prompt-tuning ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:domain-adaptation ],
        ngm:machine-learning ;
    vc:bridgesTo ngm:computer-vision,
        ngm:natural-language-processing,
        ngm:robotics ;
    vc:contrastsWith ngm:multitask-learning,
        ngm:training-from-scratch ;
    vc:dependsOn ngm:representation-learning,
        ngm:supervised-learning ;
    vc:enables ngm:few-shot-learning,
        ngm:foundation-models,
        ngm:large-language-models,
        ngm:zero-shot-learning ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:adapter-layers,
        ngm:domain-adaptation,
        ngm:fine-tuning,
        ngm:prompt-tuning ;
    vc:qualityScore "0.76"^^xsd:float ;
    vc:relatedTo ngm:continual-learning,
        ngm:meta-learning,
        ngm:model-compression ;
    vc:requires ngm:feature-representation,
        ngm:pre-trained-model ;
    vc:slug "transfer-learning" ;
    vc:sourceDomain "machine-learning" ;
    vc:uses ngm:backpropagation,
        ngm:deep-learning,
        ngm:model-training,
        ngm:neural-network .

ngm:decentralised-identity a owl:Class ;
    rdfs:label "Decentralised Identity"@en ;
    rdfs:comment "Decentralised Identity is a model for digital identity management in which individuals, organisations, and devices create, own, and control their own cryptographic identifiers and verifiable credentials without dependence on centralised identity providers or registries. Identifiers are anchored to a verifiable data registry — typically a blockchain or distributed ledger — as Decentralised Identifiers (DIDs) standardised by the W3C DID Core 1.0 specification, which defines a URI scheme resolving to a DID Document containing public keys and service endpoints. Credentials attesting to attributes of the DID subject are issued by trusted parties as W3C Verifiable Credentials, stored in a user-controlled digital wallet, and selectively disclosed to verifiers using zero-knowledge proofs or selective-disclosure mechanisms. The model operationalises Self-Sovereign Identity principles, giving subjects full autonomy over their identity data across systems and jurisdictions."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:did-method ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptographic-key-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:verifiable-data-registry ],
        ngm:digital-identity ;
    vc:bridgesTo ngm:access-control,
        ngm:ai-agent-identity ;
    vc:contrastsWith ngm:centralised-identity-provider,
        ngm:federated-identity ;
    vc:enables ngm:cross-border-digital-identity,
        ngm:privacy-preserving-authentication,
        ngm:selective-disclosure,
        ngm:self-sovereign-identity ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:implements ngm:openid-for-verifiable-credentials,
        ngm:w3c-did-specification ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:credential-schema,
        ngm:federated-identity,
        ngm:oauth2,
        ngm:trust-framework ;
    vc:requires ngm:cryptographic-key-management,
        ngm:did-method,
        ngm:verifiable-data-registry ;
    vc:slug "decentralised-identity" ;
    vc:sourceDomain "blockchain" ;
    vc:standardizedBy ngm:openid-foundation,
        ngm:w3c ;
    vc:uses ngm:did-document,
        ngm:digital-identity-wallet,
        ngm:public-key-cryptography,
        ngm:verifiable-credentials,
        ngm:zero-knowledge-proof .

