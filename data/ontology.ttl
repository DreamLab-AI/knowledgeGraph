ngm:fatfrecommendations a owl:Class ;
    rdfs:label "FATFRecommendations"@en ;
    rdfs:comment "The FATF Recommendations are the comprehensive international standards established by the Financial Action Task Force—an intergovernmental body founded in 1989 comprising 40 member jurisdictions—for combating money laundering, terrorist financing, and proliferation financing, covering customer due diligence, suspicious transaction reporting, record-keeping, and the regulation of virtual asset service providers through Recommendation 15 and the Travel Rule. They constitute the primary global anti-financial-crime framework that national regulators translate into domestic law, creating compliance obligations for financial institutions and cryptocurrency exchanges."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:travel-rule ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:compliance-monitoring ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:compliance-framework ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:anti-money-laundering ],
        ngm:aml-kyc-compliance,
        ngm:bc-governance-and-regulation ;
    skos:broader ngm:bc-governance-and-regulation ;
    vc:enables ngm:blockchain-governance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:compliance-framework,
        ngm:compliance-monitoring ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:blockchain-compliance,
        ngm:cryptocurrency,
        ngm:decentralised-finance,
        ngm:regulatory-compliance,
        ngm:virtual-asset ;
    vc:requires ngm:anti-money-laundering,
        ngm:travel-rule ;
    vc:slug "fatfrecommendations" ;
    vc:sourceDomain "blockchain" ;
    vc:standardizedBy ngm:financial-regulation ;
    vc:uses ngm:blockchain-compliance,
        ngm:risk-assessment .

ngm:fda a owl:Class ;
    rdfs:label "FDA"@en ;
    rdfs:comment "The Food and Drug Administration (FDA) is a United States federal regulatory agency within the Department of Health and Human Services responsible for protecting public health by ensuring the safety, efficacy, and security of human and veterinary drugs, biological products, medical devices, the nation's food supply, cosmetics, and products that emit radiation. The agency enforces the Federal Food, Drug, and Cosmetic Act alongside a portfolio of additional statutes, conducting pre-market review and post-market surveillance across its regulated domains. Its approval pathways — including New Drug Applications, Biologics License Applications, and Premarket Approval — establish globally influential benchmarks that shape international pharmaceutical regulation, medical-device standards, and increasingly the governance of AI-enabled diagnostics and digital health software."@en ;
    rdfs:subClassOf ngm:infra-legal-and-regulatory ;
    skos:broader ngm:infra-legal-and-regulatory ;
    vc:bridgesTo ngm:ai-medical-devices,
        ngm:bioinformatics,
        ngm:software-as-a-medical-device ;
    vc:contrastsWith ngm:ema,
        ngm:mhra ;
    vc:enables ngm:drug-approval,
        ngm:medical-device-clearance,
        ngm:public-health-protection ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:center-for-biologics-evaluation-and-research,
        ngm:center-for-devices-and-radiological-health,
        ngm:center-for-drug-evaluation-and-research,
        ngm:center-for-food-safety-and-applied-nutrition ;
    vc:isPartOf ngm:department-of-health-and-human-services,
        ngm:federal-government ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:bioethics,
        ngm:drug-regulation,
        ngm:regulatory-agency,
        ngm:risk-benefit-analysis ;
    vc:requires ngm:clinical-trial,
        ngm:good-manufacturing-practice,
        ngm:regulatory-submission ;
    vc:slug "fda" ;
    vc:sourceDomain "governance" ;
    vc:standardizedBy ngm:21-cfr,
        ngm:federal-food-drug-and-cosmetic-act ;
    vc:supports ngm:digital-health,
        ngm:personalised-medicine,
        ngm:synthetic-biology ;
    vc:uses ngm:pharmacovigilance,
        ngm:post-market-surveillance,
        ngm:randomised-controlled-trial .

