ngm:browser-based-screen-capture a owl:Class ;
    rdfs:comment "Browser-based screen capture is the in-browser acquisition of screen, window, or tab video using web APIs such as the Screen Capture API (getDisplayMedia), without installing native software. The captured MediaStream can be recorded locally, encoded, or streamed in real time over WebRTC, making it the foundation for web conferencing, asynchronous video messaging, and screen recording tools. It runs under explicit user permission and within the browser's security sandbox."@en ;
    rdfs:label "Browser-Based Screen Capture"@en ;
    rdfs:subClassOf ngm:telepresence ;
