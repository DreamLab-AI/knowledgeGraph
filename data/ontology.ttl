    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:force-feedback-actuators,
        ngm:piezoelectric-sensors,
        ngm:tactile-actuators,
        ngm:vibration-motors ;
    vc:isPartOf ngm:human-interface-device ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:driver-software,
