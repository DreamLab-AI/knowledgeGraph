    rdfs:subClassOf _:r21393 ;
    rdfs:subClassOf _:r21394 ;
    rdfs:subClassOf _:r21395 ;
    rdfs:subClassOf _:r21396 ;
    rdfs:subClassOf _:r21397 ;
