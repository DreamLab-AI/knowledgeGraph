        ngm:predictive-analytics ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:decision-tree,
        ngm:ensemble-methods,
        ngm:neural-network,
        ngm:support-vector-machine ;
    vc:implements ngm:reinforcement-learning,
