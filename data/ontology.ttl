# Quorum Blockchain
blockchain:QuorumBlockchain rdf:type owl:Class ;
    rdfs:label "Quorum Blockchain"@en ;
    rdfs:comment "An enterprise-focused Ethereum-compatible permissioned blockchain developed by JPMorgan Chase and acquired by ConsenSys, implementing private transactions through the Tessera privacy manager, pluggable consensus mechanisms (Raft, Istanbul BFT, Clique), and comprehensive permissioning to address institutional requirements for confidentiality, performance, and regulatory compliance. Supporting multiple implementations—GoQuorum (Go-based) and Hyperledger Besu (Java-based)—Quorum enables organisations to deploy Solidity smart contracts with enterprise privacy, eliminating Proof of Work computational overhead whilst providing finality guarantees critical for financial applications, exemplified by JPMorgan's JPM Coin institutional payments, Alastria's 500+ participant national blockchain in Spain, and commodity trade finance platforms like Komgo processing multi-million-pound transactions."@en ;
    skos:prefLabel "Quorum Blockchain"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:blockchain:quorum-blockchain" ;
    owl:sameAs <urn:visionclaw:concept:blockchain:quorum-blockchain> ;
    vcw:contentHash "sha256-12-162e55bc6e24" ;
    vcw:qualityScore "0.4"^^xsd:decimal ;
    vcw:legacyTermId "BC-0438" ;
    vcw:ontologyStatus "stub-needs-content" ;
    vcw:maturityLevel "draft" ;
    vcw:authorityScore "0.0"^^xsd:decimal ;
    dcterms:identifier "BC-0438" ;
    dcterms:subject "blockchain" ;
    owl:versionInfo "2.0.0" ;
    dcterms:created "2026-04-26T00:00:00Z"^^xsd:dateTime ;
    dcterms:modified "2026-04-26T13:00:00Z"^^xsd:dateTime ;
    vcw:owlRole "Concept" .

# Enterprise Smart Contracts
blockchain:EnterpriseSmartContracts rdf:type owl:Class ;
    rdfs:label "Enterprise Smart Contracts"@en ;
    rdfs:comment "Adaptation of SmartContract to regulated business environments implementing organisational governance, regulatory compliance, and business confidentiality requirements through permissioned execution, privacy controls, and upgrade mechanisms. Enterprise smart contracts diverge from public blockchain immutability by requiring bug fixes, regulatory adaptation, and business process evolution without disrupting operational systems, implemented across platforms including HyperledgerFabric (chaincode with endorsement policies), R3Corda (point-to-point privacy), QuorumBlockchain (private contracts), and HyperledgerIroha (command-based models). Technical architecture addresses access control, privacy-preserving computation, contract upgrade governance, and integration with legacy ERP and core banking systems through oracle patterns, event-driven triggers, and strategic migration approaches balancing automation benefits with organisational control requirements."@en ;
    skos:prefLabel "Enterprise Smart Contracts"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:blockchain:enterprise-smart-contracts" ;
    owl:sameAs <urn:visionclaw:concept:blockchain:enterprise-smart-contracts> ;
    vcw:contentHash "sha256-12-f822c8760635" ;
    vcw:qualityScore "0.4"^^xsd:decimal ;
    vcw:legacyTermId "BC-0439" ;
    vcw:ontologyStatus "stub-needs-content" ;
    vcw:maturityLevel "draft" ;
    vcw:authorityScore "0.0"^^xsd:decimal ;
    dcterms:identifier "BC-0439" ;
    dcterms:subject "blockchain" ;
    owl:versionInfo "2.0.0" ;
    dcterms:created "2026-04-26T00:00:00Z"^^xsd:dateTime ;
    dcterms:modified "2026-04-26T13:00:00Z"^^xsd:dateTime ;
    vcw:owlRole "Concept" .

# Blockchain Interoperability
blockchain:BlockchainInteroperability rdf:type owl:Class ;
    rdfs:label "Blockchain Interoperability"@en ;
    rdfs:comment "Technical capability enabling seamless communication and asset transfer between disparate blockchain networks through cross-chain bridges, atomic swaps, and standardised protocols. Interoperability Solutions reduce Blockchain Silos and enable Cross Chain Transactions across heterogeneous networks."@en ;
    skos:prefLabel "Blockchain Interoperability"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:blockchain:blockchain-interoperability" ;
    owl:sameAs <urn:visionclaw:concept:blockchain:blockchain-interoperability> ;
