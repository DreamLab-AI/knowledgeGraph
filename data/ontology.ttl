    vc:slug "digital-society-harms" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:standardizedBy ngm:digital-services-act,
        ngm:eu-ai-act-regulatory-instrument,
        ngm:online-safety-act-2023 ;
    vc:supports ngm:child-safety-online ;
    vc:uses ngm:algorithmic-auditing,
        ngm:impact-assessment,
        ngm:risk-assessment,
        ngm:transparency-reporting .

ngm:disaster-response a owl:Class ;
    rdfs:label "Disaster Response"@en ;
    rdfs:comment "Disaster response is the coordinated use of sensing, mapping and robotic systems to assess damage, locate survivors and direct relief in the aftermath of natural or human-made catastrophes. Spatial-computing techniques fuse aerial imagery, LiDAR, satellite remote sensing and ground-robot telemetry into situational maps that guide responders. Speed, robustness under degraded conditions, and accurate geospatial localisation are the defining requirements."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:real-time-inference ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:sensor-calibration ],
        ngm:spatial-computing ;
    skos:broader ngm:spatial-computing ;
    vc:bridgesTo ngm:search-and-rescue-robotics ;
    vc:dependsOn ngm:geospatial-data ;
    vc:enables ngm:remote-sensing,
        ngm:search-and-rescue-robotics ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:remote-sensing ;
    vc:isPartOf ngm:spatial-computing ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:disaster-recovery,
        ngm:ground-robot ;
    vc:requires ngm:real-time-inference,
        ngm:sensor-calibration ;
    vc:slug "disaster-response" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:drone-navigation,
        ngm:rescue-robot ;
    vc:uses ngm:geospatial-data,
        ngm:multirotor-uav,
        ngm:remote-sensing .

