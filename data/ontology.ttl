        ngm:smart-contract-execution,
        ngm:smart-contract-platform ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:evm-memory,
        ngm:evm-stack,
        ngm:evm-storage,
        ngm:gas-metering ;
    vc:implements ngm:eip,
        ngm:ethereum-yellow-paper ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:eof,
