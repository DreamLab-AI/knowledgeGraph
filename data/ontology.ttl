            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:communication-tools ],
        ngm:educational-methodology ;
    vc:bridgesTo ngm:federated-learning,
        ngm:telecollaboration ;
    vc:dependsOn ngm:avatar,
        ngm:network-infrastructure ;
