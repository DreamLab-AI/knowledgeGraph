# DAO Tooling
blockchain:DAOTooling rdf:type owl:Class ;
    rdfs:label "DAO Tooling"@en ;
    rdfs:comment "Software infrastructure and development frameworks enabling Decentralised Autonomous Organisation creation, governance execution, and community coordination, including voting systems and treasury management. These Tools integrate Smart Contracts, Governance Interfaces, and Community Collaboration features."@en ;
