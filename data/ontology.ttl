ngm:mesh-network a owl:Class ;
    rdfs:label "Mesh Network"@en ;
    rdfs:comment "A mesh network is a network topology in which each node relays data for the network, cooperating to distribute information so that traffic can take multiple paths between source and destination. Mesh networks self-organise and self-heal: when a link or node fails, traffic is rerouted around the fault without manual reconfiguration. They are widely used in wireless sensor networks, smart-home protocols, and community and industrial deployments where infrastructure-free, resilient connectivity is required."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:routing-protocol ],
        ngm:network-topology ;
    vc:dependsOn ngm:wireless-network ;
    vc:enables ngm:internet-of-things,
        ngm:sensor-networks,
        ngm:smart-home ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:routing-protocol ;
    vc:implements ngm:fault-tolerance ;
    vc:isPartOf ngm:network-topology ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:bluetooth-low-energy,
        ngm:thread-protocol,
        ngm:zigbee ;
    vc:slug "mesh-network" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:edge-computing,
        ngm:io-t ;
    vc:uses ngm:routing-protocol .

ngm:metaverse-venue a owl:Class ;
    rdfs:label "Metaverse Venue"@en ;
    rdfs:comment "Virtual 3D spaces within metaverse platforms designed to host events, conferences, exhibitions, and social gatherings, enabling global participation through customisable avatars and interactive environments that transcend physical location constraints."@en ;
    rdfs:subClassOf ngm:sc-platform-and-environment,
        ngm:virtual-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:slug "metaverse-venue" ;
    vc:sourceDomain "spatial-computing" .

ngm:misinformation a skos:Concept ;
    rdfs:label "Misinformation"@en .

ngm:mlcommons a owl:Class ;
    rdfs:label "MLCommons"@en ;
    rdfs:comment "MLCommons is an open engineering consortium that builds benchmarks, datasets, and best practices to accelerate machine learning innovation in a fair and reproducible way. It is best known for the MLPerf benchmark suites, which measure training and inference performance across hardware and software stacks. Membership includes major chip vendors, cloud providers, and research institutions."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:mlperf ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:compute-infrastructure ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:deep-learning-framework ],
        ngm:standards-body ;
    vc:bridgesTo ngm:governance,
        ngm:infrastructure ;
    vc:contrastsWith ngm:spec-benchmark,
        ngm:supercomputer-top500 ;
    vc:enables ngm:model-evaluation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:mlperf,
        ngm:mlperf-inference,
        ngm:peoples-speech-dataset ;
    vc:implements ngm:benchmarking,
        ngm:reproducible-research ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:compute-infrastructure,
        ngm:evaluation-benchmarks-and-leaderboards,
        ngm:machine-learning,
        ngm:model-performance,
        ngm:neural-network,
        ngm:training-data ;
    vc:requires ngm:compute-infrastructure,
        ngm:deep-learning-framework ;
    vc:slug "mlcommons" ;
