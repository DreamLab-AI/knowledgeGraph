ngm:functional-safety a owl:Class ;
    rdfs:label "Functional Safety"@en ;
    rdfs:comment "Functional Safety - The discipline of designing, implementing, and verifying safety-critical control systems (per IEC 61508, ISO 26262) to ensure systems fail safely and prevent hazardous failures that could harm humans, equipment, or processes through systematic risk assessment, safety integrity levels, and redundancy in electrical, electronic, and programmable electronic systems."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:safety-integrity-level ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:fault-tree-analysis ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:redundancy ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:risk-assessment ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:hazard-analysis ],
        ngm:safety-engineering ;
    vc:bridgesTo ngm:ai-agent-system,
        ngm:ai-safety,
        ngm:governance ;
    vc:contrastsWith ngm:security-engineering ;
    vc:enables ngm:robot-safety,
        ngm:safety-case ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:failure-mode-effects-analysis,
        ngm:redundancy,
        ngm:safety-instrumented-system ;
    vc:isPartOf ngm:regulatory-compliance,
        ngm:risk-management,
        ngm:systems-engineering ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:requires ngm:fault-tree-analysis,
        ngm:hazard-analysis,
        ngm:risk-assessment,
        ngm:safety-integrity-level ;
    vc:slug "functional-safety" ;
    vc:sourceDomain "robotics" ;
    vc:standardizedBy ngm:iec-61508,
        ngm:iso-26262,
        ngm:iso-pas-8800 .

ngm:operating-system a owl:Class ;
    rdfs:label "Operating System"@en ;
    rdfs:comment "An Operating System (OS) is system software that manages computer hardware, software resources, and provides common services for application programs — encompassing process scheduling, memory management, file-system abstraction, device-driver interfaces, networking stacks, and security enforcement. Acting as the intermediary between hardware and user-space applications, the OS exposes stable APIs that decouple software from underlying physical or virtualised hardware. Specialised variants range from real-time operating systems (RTOS) for deterministic control loops in embedded and robotic systems, to hypervisor-based OSes supporting full hardware virtualisation, to spatial-computing runtime stacks that coordinate sensor fusion, GPU pipelines, and display refresh at sub-millisecond latencies."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:device-drivers ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:file-system ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cpu ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:hardware ],
        ngm:infra-computing-and-cloud ;
    skos:broader ngm:infra-computing-and-cloud ;
    vc:bridgesTo ngm:robot-operating-system,
        ngm:spatial-computing ;
    vc:contrastsWith ngm:real-time-operating-system ;
    vc:enables ngm:cloud-computing,
        ngm:containerisation,
        ngm:edge-computing,
        ngm:embedded-systems,
        ngm:virtual-machine ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:device-drivers,
        ngm:file-system,
        ngm:memory-management-unit,
        ngm:process-scheduler,
        ngm:system-call-interface ;
    vc:implements ngm:open-xr,
        ngm:posix ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:firmware,
        ngm:middleware,
        ngm:resource-management ;
    vc:requires ngm:cpu,
        ngm:hardware,
        ngm:memory ;
    vc:slug "operating-system" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:inter-process-communication,
        ngm:multithreading ;
    vc:uses ngm:hypervisor,
        ngm:virtualisation .

ngm:token a owl:Class ;
    rdfs:label "Token"@en ;
    rdfs:comment "A digital asset representation built on an existing blockchain platform that represents ownership, utility, or access rights, typically adhering to standardized protocols for transferability and interoperability, implemented as a cryptographically-secured unit that can be owned, transferred, and programmably controlled through smart contracts according to defined rules and token standards."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:non-fungible-token ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:fungible-token ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:utility-token ],
