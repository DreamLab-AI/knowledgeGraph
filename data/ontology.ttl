        ngm:path-planning ;
    vc:requires ngm:control-system,
        ngm:robot-sensor ;
    vc:slug "robot-joint" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:inverse-kinematics .

ngm:secure-multi-party-computation a owl:Class ;
    rdfs:label "Secure Multi-Party Computation"@en ;
    rdfs:comment "Secure Multi-Party Computation (MPC) is a cryptographic protocol enabling multiple parties to jointly compute functions over their combined private inputs without revealing individual inputs to other participants or third parties. Only the final output is disclosed; intermediate computations remain confidential. Key implementation techniques include secret sharing (Shamir), garbled circuits (Yao), and oblivious transfer primitives."@en ;
    rdfs:subClassOf ngm:cryptography,
        ngm:infra-security-and-identity ;
    skos:broader ngm:infra-security-and-identity ;
    vc:enables ngm:differential-privacy,
        ngm:federated-learning,
        ngm:privacy-preserving-data-sharing ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:cryptographic-primitive,
        ngm:privacy-enhancing-computation-pec,
        ngm:privacy-preserving-technology ;
    vc:slug "secure-multi-party-computation" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:cryptographic-protocol,
        ngm:homomorphic-encryption,
        ngm:zero-knowledge-proof .

ngm:sensor-data a owl:Class ;
    rdfs:label "Sensor Data"@en ;
    rdfs:comment "Sensor data comprises the raw or pre-processed digital measurements produced by physical transducers—including cameras, LiDAR scanners, inertial measurement units (IMUs), ultrasonic rangers, and microphones—that encode observable properties of the environment such as geometry, colour, acceleration, and sound. In robotic and autonomous systems, sensor data forms the primary input to perception pipelines responsible for state estimation, object detection, and scene understanding. Data quality characteristics including frame rate, resolution, noise floor, and synchronisation latency directly constrain the capabilities of downstream algorithms such as SLAM, sensor fusion, and learned perception models."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:lidar ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:camera ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:imu ],
        ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:enables ngm:sensor-fusion,
        ngm:slam ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:camera,
        ngm:imu,
        ngm:lidar ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:slug "sensor-data" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:perception-system .

ngm:trustworthy-ai a owl:Class ;
    rdfs:label "Trustworthy AI"@en ;
    rdfs:comment "Trustworthy AI refers to artificial intelligence systems that are designed, developed, and deployed in accordance with a structured set of properties including lawfulness, ethical soundness, robustness, fairness, transparency, and accountability, ensuring they operate reliably and safely in their intended context. The concept is codified in frameworks such as the EU High-Level Expert Group's guidelines on Trustworthy AI and operationalised through the EU AI Act's risk-tiered obligations. Trustworthy AI requires meaningful human oversight mechanisms, explainable decision processes, bias monitoring, and documented accountability chains across the AI lifecycle."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:explainable-ai ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:human-oversight ],
        ngm:ai-governance-and-ethics ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:ai-safety,
        ngm:responsible-ai ;
    vc:requires ngm:explainable-ai,
        ngm:human-oversight ;
    vc:slug "trustworthy-ai" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:fairness,
        ngm:transparency .

ngm:w3-c a owl:Class ;
    rdfs:label "W3C"@en ;
    rdfs:comment "The World Wide Web Consortium (W3C) is the principal international standards organisation for the World Wide Web, founded by Tim Berners-Lee in 1994 and operating through a global membership model to develop open, interoperable web standards. W3C produces technical specifications, guidelines, and software that define the core technologies of the web including HTML, CSS, SVG, XML, RDF, and the semantic web stack. Its standards process emphasises consensus, royalty-free licensing, and broad implementability across browsers and platforms."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:w3-c-did-core ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:verifiable-credential-standard ],
        ngm:standards-body ;
    vc:enables ngm:accessibility,
        ngm:interoperability,
        ngm:interoperability-standard ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:verifiable-credential-standard,
        ngm:w3-c-did-core ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:ietf,
        ngm:linked-data,
        ngm:semantic-web,
        ngm:web-standard,
        ngm:web-standards ;
    vc:slug "w3-c" ;
    vc:sourceDomain "governance" ;
    vc:standardizedBy ngm:open-standard ;
    vc:supports ngm:decentralized-identity-did,
        ngm:verifiable-credentials,
        ngm:web-technology ;
    vc:uses ngm:json-ld,
        ngm:rdf,
        ngm:semantic-web-standards .

ngm:carbon-credits a owl:Class ;
    rdfs:label "Carbon Credits"@en ;
    rdfs:comment "Carbon credits are tradeable instruments, each representing the verified reduction or removal of one tonne of carbon dioxide equivalent (tCO₂e) from the atmosphere, used in both compliance and voluntary markets to incentivise greenhouse gas mitigation. In compliance cap-and-trade systems, regulators issue a capped total of allowances and require regulated emitters to surrender one allowance per tonne emitted, creating a price signal for abatement. Voluntary carbon markets allow organisations to purchase credits from validated offset projects — such as reforestation, renewable energy deployment, or methane capture — to offset residual emissions."@en ;
    rdfs:subClassOf ngm:infra-legal-and-regulatory ;
    skos:broader ngm:infra-legal-and-regulatory ;
    vc:enables ngm:carbon-accounting,
        ngm:carbon-credit-token ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:carbon-offset-trading,
        ngm:carbon-registry ;
    vc:slug "carbon-credits" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:environmental-accounting .

