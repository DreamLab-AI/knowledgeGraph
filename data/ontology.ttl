ngm:bradley-terry-model a owl:Class ;
    rdfs:label "Bradley Terry Model"@en ;
    rdfs:comment "The Bradley-Terry model is a probabilistic model for paired comparisons that estimates a latent strength or quality score for each item and predicts the probability that one item beats another via the logistic of their score difference. Fitted by maximum-likelihood from observed comparison outcomes, it produces a global ranking from local pairwise data. In machine learning it underpins preference modelling and reward learning from human comparisons."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:pairwise-comparison ],
        ngm:machine-learning ;
    vc:bridgesTo ngm:rlhf ;
    vc:dependsOn ngm:maximum-likelihood-estimation ;
    vc:enables ngm:direct-preference-optimisation,
        ngm:reward-model ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:pairwise-comparison ;
    vc:implements ngm:preference-learning ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:preference-learning,
        ngm:probabilistic-model,
        ngm:statistical-model ;
    vc:slug "bradley-terry-model" ;
    vc:sourceDomain "machine-learning" ;
    vc:supports ngm:reinforcement-learning-from-human-feedback,
        ngm:reward-model ;
    vc:uses ngm:maximum-likelihood-estimation,
        ngm:pairwise-comparison .

ngm:brc-20 a owl:Class ;
    rdfs:label "BRC-20"@en ;
    rdfs:comment "BRC-20 is an experimental fungible token standard on the Bitcoin blockchain that encodes deploy, mint, and transfer operations as JSON-formatted Ordinals inscriptions written onto individual satoshis. Token balances are not enforced by Bitcoin consensus rules but are instead computed off-chain by indexers that parse inscription data in sequential ordinal order. Proposed by the pseudonymous developer @domo in March 2023, BRC-20 was the first widely adopted approach to creating transferable fungible tokens natively on Bitcoin without requiring a sidechain or layer-2 network. Its simplicity and permissionless nature drove rapid experimentation but also exposed limitations around scalability, indexer consensus, and on-chain fee pressure."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ordinals ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:bitcoin-proof-of-work-protocol ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:taproot ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:seg-wit ],
        ngm:token-standard ;
    vc:bridgesTo ngm:decentralised-finance,
        ngm:tokenization ;
    vc:contrastsWith ngm:erc-20,
        ngm:runes-protocol,
        ngm:spl-token,
        ngm:src-20 ;
    vc:dependsOn ngm:bitcoin-node,
        ngm:ordinals-indexer ;
    vc:enables ngm:decentralised-exchange,
        ngm:fungible-token,
        ngm:minting ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:bitcoin-ecosystem ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:bitcoin-script,
        ngm:digital-asset,
        ngm:layer-2-protocol,
        ngm:mempool,
        ngm:non-fungible-token ;
    vc:requires ngm:bitcoin-proof-of-work-protocol,
        ngm:ordinals,
        ngm:seg-wit,
        ngm:taproot ;
    vc:slug "brc-20" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:inscription,
        ngm:json-data-interchange-format,
        ngm:satoshi,
        ngm:utxo-model .

ngm:c2-pa-standard a owl:Class ;
    rdfs:label "C2PA Standard"@en ;
    rdfs:comment "An open technical standard developed by the Coalition for Content Provenance and Authenticity that establishes cryptographically-signed Content Credentials to certify the origin, history, and authenticity of digital media, functioning like a tamper-evident nutrition label for digital content."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
