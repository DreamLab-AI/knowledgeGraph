        ngm:training-data ;
    vc:slug "safety-fine-tuning" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:ai-safety,
        ngm:responsible-ai,
        ngm:value-alignment .

ngm:safety-system a owl:Class ;
    rdfs:label "Safety System"@en ;
    rdfs:comment "A safety system is an engineered arrangement of hardware, software, and procedural controls designed to prevent, detect, and mitigate hazards in industrial, transport, robotic, or cyber-physical environments, ensuring that a process or machine reaches a safe state when faults or dangerous conditions are detected. Safety systems are defined by their Safety Integrity Level (SIL) or Performance Level (PL) ratings under standards such as IEC 61508 and ISO 26262, which quantify the required probability of failure on demand. They encompass emergency shutdown systems, safety PLCs, watchdog timers, interlocks, redundant sensors, and AI-based anomaly detection."@en ;
    rdfs:subClassOf ngm:control-system ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:functional-safety,
        ngm:iec-61508,
        ngm:iso-26262 ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:autonomous-vehicle,
        ngm:real-time-operating-system,
        ngm:robot-safety,
        ngm:safety-measure ;
    vc:slug "safety-system" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:embedded-systems,
        ngm:monitoring-system,
        ngm:safety-plc .

ngm:sampling-based-planning a owl:Class ;
    rdfs:label "Sampling Based Planning"@en ;
    rdfs:comment "Sampling-based planning is a family of motion-planning methods that find feasible paths by randomly sampling the configuration space and connecting collision-free samples into a graph or tree, rather than constructing an explicit representation of the free space. By trading completeness for probabilistic completeness, these methods scale to the high-dimensional spaces typical of articulated robots. Representative algorithms include the Probabilistic Roadmap and the Rapidly Exploring Random Tree."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:collision-detection ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:rapidly-exploring-random-tree ],
        ngm:motion-planning ;
    vc:contrastsWith ngm:path-planning ;
    vc:enables ngm:autonomous-navigation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:rapidly-exploring-random-tree ;
    vc:implements ngm:motion-planning,
        ngm:path-planning ;
    vc:isPartOf ngm:motion-planning,
        ngm:robotics ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:path-planning,
        ngm:robot-operating-system ;
    vc:requires ngm:collision-detection ;
    vc:slug "sampling-based-planning" ;
    vc:sourceDomain "robotics" ;
    vc:supports ngm:motion-planning ;
    vc:uses ngm:collision-detection,
        ngm:configuration-space .

ngm:sampling-theory a owl:Class ;
    rdfs:label "Sampling Theory"@en ;
    rdfs:comment "Sampling theory is the body of statistical and signal-processing principles governing how a subset of observations is selected from a larger population or continuous signal so that valid inferences can be drawn about the whole. In statistics it formalises how representative samples are drawn, how estimator variance and bias behave, and how confidence in conclusions scales with sample size. In signal processing it specifies the conditions under which a continuous signal can be reconstructed without loss from discrete samples. The discipline underpins survey design, experimental design, digital signal acquisition, and Monte Carlo estimation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:sampling ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:random-sampling ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:random-sampling ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:probability-theory ],
        ngm:statistics ;
    vc:contrastsWith ngm:bias ;
    vc:dependsOn ngm:central-limit-theorem,
        ngm:probability-theory ;
    vc:enables ngm:data-collection,
        ngm:signal-processing ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:random-sampling,
        ngm:sampling ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:central-limit-theorem,
        ngm:data-quality,
        ngm:signal-processing ;
    vc:requires ngm:probability-theory,
        ngm:random-sampling ;
    vc:slug "sampling-theory" ;
    vc:sourceDomain "data" ;
    vc:supports ngm:data-quality,
        ngm:statistics ;
    vc:uses ngm:probability-theory .

ngm:sanctions-enforcement a owl:Class ;
    rdfs:label "Sanctions Enforcement"@en ;
    rdfs:comment "Sanctions enforcement is the regulatory and operational process by which financial institutions, governments, and technology platforms identify, screen, and block transactions, assets, and relationships involving sanctioned individuals, entities, or jurisdictions as designated by authorities such as OFAC, the UN Security Council, the European Union, or HM Treasury. It encompasses real-time screening of payment flows against consolidated sanctions lists, asset-freezing procedures, reporting obligations, and the maintenance of audit trails demonstrating compliance. In digital asset and blockchain contexts, sanctions enforcement extends to on-chain transaction monitoring and the blocking of wallet addresses associated with designated parties."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:sanctions-screening ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:compliance-audit-trail ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:entity-resolution ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:know-your-customer ],
        ngm:compliance-framework ;
    vc:bridgesTo ngm:decentralised-finance,
        ngm:smart-contract-compliance ;
    vc:contrastsWith ngm:anti-money-laundering,
        ngm:counter-terrorist-financing ;
    vc:enables ngm:aml-kyc-compliance,
        ngm:regulatory-reporting ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:compliance-audit-trail,
        ngm:sanctions-screening ;
    vc:isPartOf ngm:aml,
        ngm:financial-regulation ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:requires ngm:entity-resolution,
        ngm:know-your-customer,
        ngm:watchlist-management ;
    vc:slug "sanctions-enforcement" ;
    vc:sourceDomain "governance" ;
    vc:standardizedBy ngm:fatf,
        ngm:ofac ;
    vc:uses ngm:blockchain-analytics,
        ngm:machine-learning-classifier .

ngm:scarcity a owl:Class ;
    rdfs:label "Scarcity"@en ;
    rdfs:comment "Scarcity is the economic condition in which a resource is limited relative to demand for it, giving rise to value, price and the need for allocation choices. In monetary and token economics scarcity is often engineered through fixed or capped supply, issuance schedules or burning mechanisms to support a store-of-value proposition. It is the foundational premise from which supply-and-demand pricing dynamics emerge."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:inflation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:monetary-policy ],
        ngm:monetary-policy ;
    vc:bridgesTo ngm:tokenomics ;
    vc:contrastsWith ngm:inflation ;
    vc:dependsOn ngm:monetary-policy ;
    vc:enables ngm:liquidity,
        ngm:market-microstructure ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:inflation ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:monetary-policy,
        ngm:token,
        ngm:tokenomics ;
    vc:requires ngm:monetary-policy ;
    vc:slug "scarcity" ;
    vc:sourceDomain "finance" ;
    vc:supports ngm:collateral,
        ngm:market-maker .

ngm:scene-management a owl:Class ;
    rdfs:label "Scene Management"@en ;
    rdfs:comment "Scene Management encompasses the runtime systems and data structures responsible for organising, loading, and unloading 3D scene content in real-time environments. It coordinates scene graph traversal, hierarchical object relationships, asset streaming, and spatial partitioning to ensure that only geometrically and logically relevant content is active at any moment, enabling scalable and performant virtual worlds."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:ar-scene-graph ],
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:enables ngm:occlusion-culling,
        ngm:scene-optimization ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:ar-scene-graph ;
    vc:isPartOf ngm:render-pipeline ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:slug "scene-management" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:asset-management,
        ngm:level-of-detail .

ngm:scientific-visualisation a owl:Class ;
    rdfs:label "Scientific Visualisation"@en ;
    rdfs:comment "Scientific visualisation is the rendering of multidimensional scientific data into visual form to support analysis and communication. It includes volume rendering, isosurface extraction, flow and vector-field visualisation, and time-varying simulation playback. It depends on graphics rendering pipelines and techniques such as ray tracing to convey spatial and quantitative structure accurately."@en ;
    rdfs:subClassOf ngm:computer-graphics ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:ray-tracing,
        ngm:rendering-pipeline ;
    vc:slug "scientific-visualisation" ;
    vc:sourceDomain "infrastructure" .

ngm:scim a owl:Class ;
    rdfs:label "SCIM"@en ;
    rdfs:comment "SCIM (System for Cross-domain Identity Management) is an open standard that defines a common schema and a RESTful protocol for automating the exchange of user and group identity information between identity providers and service providers. It lets organisations create, update, deactivate and deprovision accounts across applications without bespoke integrations. SCIM is widely used to automate user lifecycle management in enterprise single sign-on and cloud deployments."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:authorization ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:authentication ],
        ngm:identity-management ;
    vc:contrastsWith ngm:oauth ;
    vc:dependsOn ngm:directory-service ;
    vc:enables ngm:access-control ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:identity-management ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:identity-management,
        ngm:infrastructure ;
    vc:requires ngm:authentication,
        ngm:authorization ;
    vc:slug "scim" ;
    vc:sourceDomain "infrastructure" ;
    vc:standardizedBy ngm:standards ;
    vc:supports ngm:identity-federation,
        ngm:single-sign-on ;
    vc:uses ngm:rest-api .

ngm:score-based-generative-model a owl:Class ;
    rdfs:label "Score-Based Generative Model"@en ;
    rdfs:comment "A score-based generative model is a class of generative model that learns the gradient of the log probability density of data — the score function — and samples by reversing a noising process using that learned score. Training perturbs data with noise at multiple scales and fits a neural network to estimate the score at each scale, after which Langevin-style or reverse stochastic-differential-equation dynamics transform noise into samples. The framework provides a unifying continuous-time view that subsumes denoising diffusion models."@en ;
    rdfs:subClassOf ngm:generative-model ;
    vc:bridgesTo ngm:flow-matching,
        ngm:markov-chain-monte-carlo ;
    vc:contrastsWith ngm:generative-adversarial-network,
        ngm:variational-autoencoder ;
    vc:dependsOn ngm:neural-network,
        ngm:stochastic-differential-equation ;
    vc:enables ngm:classifier-free-guidance,
        ngm:diffusion-policy ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:generative-model ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:diffusion-model,
        ngm:latent-diffusion ;
    vc:slug "score-based-generative-model" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:deep-learning .

ngm:sec a owl:Class ;
    rdfs:label "SEC"@en ;
    rdfs:comment "The Securities and Exchange Commission (SEC) is the principal US federal regulatory agency responsible for enforcing federal securities laws, overseeing securities markets, and protecting investors. Established by the Securities Exchange Act of 1934 in the wake of the 1929 stock market crash, the SEC requires public companies to disclose material financial information and polices against fraud, insider trading, and market manipulation. In the digital asset domain, the SEC has asserted jurisdiction over many cryptocurrencies and token offerings on the grounds that they constitute investment contracts under the Howey Test, leading to high-profile enforcement actions against exchanges, issuers, and DeFi protocols. The SEC's regulatory posture towards crypto assets is a defining factor in the shape of the US digital asset industry."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:securities-regulation ],
        ngm:financial-regulation ;
    vc:bridgesTo ngm:bitcoin-proof-of-work-protocol-etf,
        ngm:defi-protocol,
        ngm:digital-asset-regulation ;
    vc:contrastsWith ngm:cftc,
        ngm:financial-conduct-authority,
        ngm:us-regulatory-framework ;
    vc:enables ngm:compliance-audit-trail,
        ngm:investor-protection,
        ngm:regulatory-reporting,
        ngm:securities-disclosure ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:regulation,
        ngm:securities-act-1933,
        ngm:securities-exchange-act-1934 ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:digital-asset-risks,
        ngm:howey-test,
        ngm:mi-ca-regulation,
        ngm:regulatory-framework,
        ngm:securities-regulation ;
    vc:requires ngm:broker-dealer-registration,
        ngm:securities-regulation ;
    vc:slug "sec" ;
    vc:sourceDomain "governance" ;
    vc:supports ngm:market-integrity,
        ngm:regulatory-standards ;
    vc:uses ngm:enforcement-mechanism,
        ngm:regulatory-technology .

ngm:secure-channel a owl:Class ;
    rdfs:label "Secure Channel"@en ;
    rdfs:comment "A Secure Channel is a communication path between two parties that protects the confidentiality, integrity and authenticity of exchanged data against eavesdropping and tampering. It is typically established by a key-exchange and authentication handshake that derives session keys, then protects subsequent traffic with authenticated encryption. Secure channels underpin protocols such as TLS and are foundational to trustworthy communication over untrusted networks."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:key-exchange ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:encryption ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:authentication ],
        ngm:secure-communication ;
    vc:bridgesTo ngm:public-key-cryptography ;
    vc:dependsOn ngm:cryptographic-protocol,
        ngm:cryptography ;
    vc:enables ngm:data-confidentiality,
        ngm:data-integrity,
        ngm:end-to-end-encryption ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:implements ngm:transport-layer-security ;
    vc:isPartOf ngm:secure-communication ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:diffie-hellman-key-exchange,
        ngm:digital-signature,
        ngm:key-management ;
    vc:requires ngm:authentication,
        ngm:encryption,
        ngm:key-exchange ;
    vc:slug "secure-channel" ;
    vc:sourceDomain "security" ;
    vc:standardizedBy ngm:tls ;
    vc:supports ngm:forward-secrecy ;
    vc:uses ngm:authenticated-encryption,
        ngm:message-authentication-code,
        ngm:symmetric-encryption .

ngm:securities-law a owl:Class ;
    rdfs:label "Securities Law"@en ;
    rdfs:comment "Securities law is the body of statutory and regulatory rules governing the issuance, sale, and trading of financial instruments classified as securities, with the aim of protecting investors and ensuring fair, transparent markets. It defines disclosure obligations, registration requirements, and anti-fraud provisions, and applies tests to determine when an instrument such as a token constitutes a security. In the digital-asset context it shapes whether token offerings must register and comply with investor-protection regimes."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:kyc-aml ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:compliance ],
        ngm:financial-regulation ;
    vc:bridgesTo ngm:ico,
        ngm:security-token-offering ;
    vc:enables ngm:investor-protection ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:implements ngm:regulatory-compliance ;
    vc:isPartOf ngm:financial-regulation ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:financial-regulation,
        ngm:ico,
        ngm:security-token-offering ;
    vc:requires ngm:compliance,
        ngm:kyc-aml ;
    vc:slug "securities-law" ;
    vc:sourceDomain "blockchain" ;
    vc:standardizedBy ngm:sec ;
    vc:supports ngm:compliance,
        ngm:investor-protection ;
    vc:uses ngm:howey-test .

ngm:security-testing a owl:Class ;
    rdfs:label "Security Testing"@en ;
    rdfs:comment "Security testing is the evaluation of software to discover vulnerabilities and verify that security controls behave as intended. It includes static application security testing, dynamic testing, dependency and secret scanning, fuzzing, and penetration testing. Integrated into development pipelines, it shifts vulnerability discovery earlier and continuously throughout the software lifecycle."@en ;
    rdfs:subClassOf ngm:cybersecurity ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:dev-sec-ops,
        ngm:testing-process ;
    vc:slug "security-testing" ;
    vc:sourceDomain "security" .

ngm:semantic-parsing a owl:Class ;
    rdfs:label "Semantic Parsing"@en ;
    rdfs:comment "Semantic parsing is the task of mapping natural-language utterances onto structured, machine-interpretable meaning representations such as logical forms, executable queries or programs. It converts ambiguous human language into precise formalisms that can be reasoned over or executed against a database or knowledge graph. Applications include question answering, text-to-SQL and instruction-to-code translation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:natural-language-understanding ],
        ngm:natural-language-processing ;
    vc:contrastsWith ngm:sequence-labelling ;
    vc:dependsOn ngm:knowledge-graph ;
    vc:enables ngm:code-generation,
        ngm:question-answering ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:natural-language-processing ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:information-extraction,
