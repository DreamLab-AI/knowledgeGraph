ngm:cryptocurrency-exchange a owl:Class ;
    rdfs:label "Cryptocurrency Exchange"@en ;
    rdfs:comment "A cryptocurrency exchange is a platform that enables the trading of digital assets for other cryptocurrencies or for fiat currency. Exchanges match buy and sell orders, provide custody or settlement of funds, and supply liquidity and price discovery for crypto markets. They range from centralised intermediaries holding customer assets to decentralised protocols that execute trades on-chain."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:blockchain ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:wallet ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:hot-wallet ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:custody ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:order-book ],
        ngm:digital-economy ;
    vc:bridgesTo ngm:fiat-currency ;
    vc:contrastsWith ngm:centralised-exchange,
        ngm:decentralised-exchange ;
    vc:enables ngm:liquidity ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:hot-wallet,
        ngm:order-book,
        ngm:wallet ;
    vc:isPartOf ngm:digital-economy ;
