ngm:record-keeping a owl:Class ;
    rdfs:label "Record Keeping"@en ;
    rdfs:comment "Record keeping is the systematic retention of transaction, customer, and decision records so that activities can be reconstructed and verified by auditors or regulators. In financial compliance it mandates preserving identity documentation, transaction details, and risk assessments for prescribed periods. Robust record keeping is a precondition for meeting anti-money-laundering and travel-rule obligations."@en ;
    rdfs:subClassOf ngm:regulatory-compliance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:aml-kyc-compliance,
        ngm:travel-rule ;
    vc:slug "record-keeping" ;
    vc:sourceDomain "governance" .

ngm:regulatory-approval a owl:Class ;
    rdfs:label "Regulatory Approval"@en ;
    rdfs:comment "Regulatory approval is the formal authorisation by a regulator that permits an entity, product or activity to proceed under defined conditions."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:regulatory-requirements ],
        ngm:regulation ;
    vc:enables ngm:compliance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:regulatory-requirements ;
    vc:slug "regulatory-approval" ;
    vc:sourceDomain "governance" .

ngm:regulatory-requirements a owl:Class ;
    rdfs:label "Regulatory Requirements"@en ;
    rdfs:comment "Regulatory requirements are the legally binding or supervisory obligations imposed on organisations and individuals by governmental bodies, statutory agencies, and international instruments, specifying the conditions under which they may lawfully operate, offer products, or provide services. They derive from primary legislation, secondary instruments, and supervisory rulebooks, and are operationalised through licensing, capital adequacy, conduct-of-business, reporting, record-keeping, and data-protection mandates. Entities must demonstrate adherence through formal compliance programmes, independent audits, and periodic regulatory filings, with failure exposing them to financial penalties, operational restrictions, or revocation of authorisation. Regulatory requirements are increasingly sector-specific and jurisdictionally layered, requiring cross-border harmonisation mechanisms to reconcile conflicting national regimes."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-governance ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:audit ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:record-keeping ],
        ngm:regulation ;
    vc:bridgesTo ngm:ai-governance,
        ngm:algorithmic-accountability,
        ngm:data-sovereignty ;
    vc:contrastsWith ngm:self-regulation,
        ngm:voluntary-standards ;
    vc:dependsOn ngm:legislation,
        ngm:standards ;
    vc:enables ngm:compliance,
        ngm:regulatory-reporting,
        ngm:risk-management ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:capital-requirements,
        ngm:conduct-of-business-rules,
        ngm:data-protection-obligations,
        ngm:licensing ;
    vc:isPartOf ngm:governance,
        ngm:regulatory-frameworks ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:enforcement,
        ngm:policy,
        ngm:supervisory-authority ;
    vc:requires ngm:audit,
        ngm:data-governance,
        ngm:record-keeping ;
    vc:slug "regulatory-requirements" ;
    vc:sourceDomain "governance" ;
    vc:standardizedBy ngm:basel-committee,
        ngm:financial-stability-board,
        ngm:international-standards-organisation .

ngm:regulatory-sandbox a owl:Class ;
    rdfs:label "Regulatory Sandbox"@en ;
    rdfs:comment "A regulatory sandbox is a supervised testing environment in which firms can trial innovative products, services, or business models with real customers under temporary regulatory relief and close oversight. It lets regulators observe emerging technology and firms validate compliance before full-scale launch. Sandboxes are a common policy tool for fintech, blockchain, and other convergent technologies."@en ;
    rdfs:subClassOf ngm:financial-regulation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:adoption-of-convergent-technologies,
        ngm:asia-pacific-regulation ;
    vc:slug "regulatory-sandbox" ;
    vc:sourceDomain "governance" .

ngm:reinforcement-learning-algorithm a owl:Class ;
    rdfs:label "Reinforcement Learning Algorithm"@en ;
    rdfs:comment "Reinforcement Learning Algorithms enable agents to learn optimal decision-making policies through interaction with environments, guided by reward signals. Core families include value-based methods (Q-learning, DQN), policy gradient methods (REINFORCE, PPO, TRPO), and actor-critic approaches (A3C, SAC), all of which balance exploration against exploitation to maximise cumulative expected reward."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:reward-function ],
        ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:enables ngm:autonomous-navigation,
        ngm:reinforcement-learning-from-human-feedback ;
