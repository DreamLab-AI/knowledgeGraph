ngm:user-identity-management a owl:Class ;
    rdfs:comment "User identity management is the set of processes and systems that create, maintain, authenticate and deprovision the digital identities of users across a platform's lifecycle. It governs how users register, prove who they are, manage profiles and link accounts, and is foundational to access control and personalised experiences. In collaborative and metaverse platforms it also coordinates presence, avatars and cross-session continuity."@en ;
    rdfs:label "User Identity Management"@en ;
    rdfs:subClassOf ngm:identity-management ;
