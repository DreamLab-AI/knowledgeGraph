ngm:autonomous-driving-perception a owl:Class ;
    rdfs:label "Autonomous Driving Perception"@en ;
    rdfs:comment "The subsystem of an autonomous vehicle responsible for interpreting sensor data to construct a structured understanding of the vehicle's immediate environment, including the detection, classification, and tracking of objects, lane geometry, road surfaces, traffic signage, and dynamic actors. Autonomous driving perception fuses inputs from cameras, LiDAR, radar, and ultrasonic sensors to produce a real-time scene representation sufficient for safe navigation decisions."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:object-detection ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:depth-estimation ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:semantic-segmentation ],
        ngm:perception-system ;
    vc:dependsOn ngm:edge-computing,
        ngm:functional-safety ;
    vc:enables ngm:autonomous-driving,
        ngm:motion-planning,
        ngm:scene-understanding ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:bird-eye-view,
        ngm:depth-estimation,
        ngm:object-detection,
        ngm:object-tracking,
        ngm:semantic-segmentation ;
    vc:qualityScore "0.85"^^xsd:float ;
    vc:relatedTo ngm:reinforcement-learning,
        ngm:simultaneous-localisation-and-mapping ;
    vc:slug "autonomous-driving-perception" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:computer-vision,
        ngm:convolutional-neural-network,
        ngm:deep-learning,
        ngm:hd-maps,
        ngm:lidar,
        ngm:point-cloud,
        ngm:sensor-fusion,
        ngm:transformer-architecture .

ngm:avatar-animation a owl:Class ;
    rdfs:label "Avatar Animation"@en ;
    rdfs:comment "Avatar animation is the specialised subset of digital animation concerned with driving the motion and expression of user-controlled or AI-controlled avatar representations in real-time interactive environments. It encompasses full-body locomotion, facial expression synthesis, hand and gaze tracking, and upper-body gesture systems, all coordinated to produce social believability within virtual and extended reality spaces. Avatar animation systems must balance visual fidelity with low-latency responsiveness to maintain user embodiment and presence. Standards such as VRM and glTF define interchange formats that allow avatar animations to transfer across platforms."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:pose-estimation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:real-time-rendering ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:facial-animation ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:gaze-tracking ],
        ngm:animation ;
    vc:bridgesTo ngm:machine-learning,
        ngm:natural-language-processing ;
    vc:contrastsWith ngm:animation ;
    vc:enables ngm:embodied-interaction,
        ngm:immersive-experience,
        ngm:social-presence,
        ngm:telepresence ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:facial-animation,
        ngm:gaze-tracking,
        ngm:lip-sync ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:avatar,
        ngm:avatar-interoperability,
        ngm:avatar-system,
        ngm:embodiment,
        ngm:non-verbal-communication,
        ngm:virtual-reality ;
    vc:requires ngm:pose-estimation,
        ngm:real-time-rendering ;
    vc:slug "avatar-animation" ;
    vc:sourceDomain "spatial-computing" ;
    vc:standardizedBy ngm:gltf-standard,
        ngm:metaverse-standards-forum ;
    vc:uses ngm:animation-retargeting,
        ngm:blend-tree,
        ngm:inverse-kinematics,
        ngm:motion-capture,
        ngm:skeletal-animation,
        ngm:vrm-format .

ngm:avatar-portability a owl:Class ;
    rdfs:label "Avatar Portability"@en ;
    rdfs:comment "Avatar Portability is the capability to transfer digital avatar representations between different metaverse platforms, applications, and virtual worlds while maintaining visual fidelity, customization, and associated digital assets, enabled by standardized formats and interoperability frameworks."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:standardized-formats ],
        [ a owl:Restriction ;
