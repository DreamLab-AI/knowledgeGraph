    vc:contrastsWith ngm:basic-authentication,
        ngm:openid-connect,
        ngm:saml ;
    vc:dependsOn ngm:identity-provider,
        ngm:token-endpoint ;
    vc:enables ngm:api-security,
        ngm:delegated-authorisation,
        ngm:federated-identity,
        ngm:single-sign-on ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:access-token,
        ngm:authorisation-code,
        ngm:refresh-token,
        ngm:scope ;
    vc:implements ngm:oauth-2-0 ;
    vc:isPartOf ngm:identity-and-access-management ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:authentication,
        ngm:zero-trust-security ;
    vc:requires ngm:access-control,
        ngm:authorisation,
        ngm:client-credentials,
        ngm:https ;
    vc:slug "oauth" ;
    vc:sourceDomain "security" ;
    vc:standardizedBy ngm:ietf,
        ngm:rfc-6749 ;
    vc:supports ngm:mobile-application,
