        ngm:virtual-reality ;
    vc:slug "shared-whiteboards" ;
    vc:sourceDomain "distributed-collaboration" ;
    vc:uses ngm:augmented-reality,
        ngm:telepresence .

ngm:sim-clr a owl:Class ;
    rdfs:label "SimCLR"@en ;
    rdfs:comment "A self-supervised learning framework that learns visual representations through contrastive learning with data augmentation. A linear classifier on SimCLR representations achieves top-1 accuracy, matching supervised ResNet-50 performance."@en ;
