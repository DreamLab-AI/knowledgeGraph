ngm:data-integration a owl:Class ;
    rdfs:label "Data Integration"@en ;
    rdfs:comment "Data Integration is the process of combining data from heterogeneous sources into a unified, consistent view suitable for analysis, model training, or operational use. It involves ETL/ELT pipelines, schema harmonisation, semantic mapping, and API-based federation. In metaverse and AI contexts, data integration connects sensor streams, user telemetry, digital-twin feeds, and blockchain records into coherent data products."@en ;
    rdfs:subClassOf ngm:infra-data-management ;
    skos:broader ngm:infra-data-management ;
    vc:enables ngm:data-interoperability,
        ngm:semantic-interoperability ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:relatedTo ngm:data-pipeline,
        ngm:interoperability ;
    vc:slug "data-integration" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:api-gateway,
        ngm:etl-pipeline .

ngm:data-sovereignty a owl:Class ;
    rdfs:label "Data Sovereignty"@en ;
    rdfs:comment "Data sovereignty is the legal and political principle that digital data is subject to the laws, governance structures, and enforcement jurisdiction of the nation or region in which it originates or is processed. It encompasses requirements such as data localisation (mandating that data remain physically within specified borders), restrictions on cross-border data flows, and the right of governments to compel access for regulatory or security purposes. Data sovereignty directly shapes cloud architecture decisions, AI training dataset curation, and multinational data-sharing agreements."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:regulatory-compliance ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-governance ],
        ngm:infra-legal-and-regulatory ;
    skos:broader ngm:infra-legal-and-regulatory ;
    vc:contrastsWith ngm:localisation ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:data-protection,
        ngm:privacy ;
    vc:requires ngm:data-governance,
        ngm:regulatory-compliance ;
    vc:slug "data-sovereignty" ;
    vc:sourceDomain "infrastructure" .

ngm:differentiable-rendering a owl:Class ;
    rdfs:label "Differentiable Rendering"@en ;
    rdfs:comment "Differentiable rendering is a class of rendering algorithms that formulate the image formation process in a manner that admits the computation of gradients of pixel values with respect to scene parameters — including geometry, materials, lighting, and camera pose. By backpropagating through the rendering pipeline, these methods enable gradient-based optimisation to reconstruct 3D scenes from 2D observations, train neural scene representations, and perform inverse rendering. Differentiable rendering forms a bridge between classical computer graphics and deep learning, enabling end-to-end training of 3D-aware generative and perception models."@en ;
    rdfs:subClassOf ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:enables ngm:3-d-reconstruction,
        ngm:neural-radiance-field ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:computer-vision,
        ngm:gaussian-splatting ;
    vc:slug "differentiable-rendering" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:gradient-descent,
        ngm:ray-tracing .

ngm:environmental-sustainability a owl:Class ;
    rdfs:label "Environmental Sustainability"@en ;
    rdfs:comment "The responsible stewardship of natural resources and environmental systems in AI development and deployment, minimising ecological harm whilst potentially leveraging AI to address environmental challenges including climate change, biodiversity loss and resource depletion."@en ;
    rdfs:subClassOf ngm:sc-governance-and-safety ;
    skos:broader ngm:sc-governance-and-safety ;
    vc:contrastsWith ngm:bitcoin-environmental-issues ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:blockchain-energy-consumption,
        ngm:carbon-credits,
        ngm:sustainability ;
    vc:slug "environmental-sustainability" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:ai-governance-and-ethics .

ngm:erc-20 a owl:Class ;
    rdfs:label "ERC-20"@en ;
    rdfs:comment "ERC-20 is the Ethereum Request for Comment standard that defines a mandatory six-function interface — totalSupply, balanceOf, transfer, transferFrom, approve, and allowance — enabling any conformant fungible token to interoperate seamlessly with wallets, decentralised exchanges, and smart contract protocols without bespoke integration. Proposed by Fabian Vogelsteller and Vitalik Buterin in 2015 and formalised as an Ethereum Improvement Proposal, ERC-20 became the foundational primitive of the DeFi ecosystem and the predominant format for utility tokens, governance tokens, and stablecoins."@en ;
    rdfs:subClassOf ngm:bc-token-and-asset,
        ngm:token-standard ;
    skos:broader ngm:bc-token-and-asset ;
    vc:contrastsWith ngm:erc-1155,
        ngm:erc-721 ;
    vc:enables ngm:decentralised-finance,
        ngm:fungible-token ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:slug "erc-20" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:smart-contract .

ngm:extended-reality-xr a owl:Class ;
    rdfs:label "Extended Reality (XR)"@en ;
    rdfs:comment "Umbrella term encompassing all immersive technologies including Augmented Reality (AR), Virtual Reality (VR), and Mixed Reality (MR), representing the full spectrum from entirely physical to entirely virtual environments and all hybrid states between."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:head-mounted-display ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:real-time-rendering ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:reality-virtuality-continuum ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:virtual-reality-vr ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:spatial-tracking ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:augmented-reality-ar ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:mixed-reality-mr ],
        ngm:immersive-technology,
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:enables ngm:cross-reality-transitions,
        ngm:immersive-experiences,
        ngm:presence,
        ngm:spatial-interaction ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:augmented-reality-ar,
        ngm:mixed-reality-mr,
        ngm:reality-virtuality-continuum,
        ngm:virtual-reality-vr ;
    vc:isPartOf ngm:immersive-technology,
        ngm:spatial-computing ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:head-mounted-display,
        ngm:input-device,
        ngm:real-time-rendering,
        ngm:spatial-tracking ;
    vc:slug "extended-reality-xr" ;
    vc:sourceDomain "spatial-computing" .

ngm:feature-engineering a owl:Class ;
    rdfs:label "Feature Engineering"@en ;
    rdfs:comment "The process of using domain knowledge and statistical transformations to construct, select, and encode input variables from raw data so that they better represent the underlying predictive signal for machine learning models. Techniques include polynomial expansion, normalisation, temporal feature extraction, embedding of categorical variables, and dimensionality reduction via PCA or autoencoders."@en ;
    rdfs:subClassOf ngm:ai-technique,
        ngm:data-preprocessing ;
    skos:broader ngm:ai-technique ;
    vc:bridgesTo ngm:digital-twin ;
    vc:enables ngm:machine-learning,
        ngm:model-training ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:relatedTo ngm:feature-store,
        ngm:transfer-learning ;
    vc:slug "feature-engineering" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:data-pipeline .

ngm:financial-stability a owl:Class ;
    rdfs:label "Financial Stability"@en ;
    rdfs:comment "Financial stability refers to the condition in which the financial system — comprising banks, markets, payment infrastructure, and intermediaries — can absorb shocks and continue to perform its core functions of credit intermediation, risk transfer, and payment settlement. In the context of blockchain and crypto-assets, financial stability analysis examines how the growth of crypto markets, the interconnections between crypto and traditional finance, and the failure of large participants can propagate systemic risk. Regulatory bodies such as the Financial Stability Board, BIS, and IMF monitor these dynamics and advise on macroprudential policy responses."@en ;
    rdfs:subClassOf ngm:bc-governance-and-regulation ;
    skos:broader ngm:bc-governance-and-regulation ;
    vc:dependsOn ngm:compliance-framework ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:financial-regulation,
        ngm:stablecoin,
        ngm:systemic-risk ;
    vc:slug "financial-stability" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:anti-money-laundering .

ngm:fraud-detection a owl:Class ;
    rdfs:label "Fraud Detection"@en ;
    rdfs:comment "Fraud detection is the real-time or near-real-time identification of deceptive or unauthorised activities—such as payment fraud, account takeover, and identity theft—using statistical models, machine learning classifiers, and rule-based engines applied to transactional and behavioural data. The field operates under severe class-imbalance constraints, where fraudulent events are rare relative to legitimate activity, demanding specialised sampling strategies and evaluation metrics such as precision-recall curves and F1 scores. Explainability of model decisions is increasingly mandated by financial regulators to support human review of adverse determinations."@en ;
    rdfs:subClassOf ngm:infra-security-and-identity ;
    skos:broader ngm:infra-security-and-identity ;
    vc:enables ngm:anti-money-laundering,
        ngm:risk-management ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:explainable-ai ;
    vc:slug "fraud-detection" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:anomaly-detection,
        ngm:machine-learning,
        ngm:supervised-learning .

ngm:immersive-communication a owl:Class ;
    rdfs:label "Immersive Communication"@en ;
    rdfs:comment "Communication systems and experiences that leverage extended reality (XR) technologies — including VR meetings, AR collaboration tools, spatial audio conferencing, and mixed reality platforms — to create spatially-aware interaction environments that transcend conventional 2D video interfaces and convey presence, embodiment, and spatial context."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:avatar ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:spatial-audio ],
        ngm:dc-telepresence,
        ngm:telecollaboration ;
    skos:broader ngm:dc-telepresence ;
    vc:bridgesTo ngm:remote-collaboration,
        ngm:virtual-collaboration ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:avatar,
        ngm:spatial-audio ;
    vc:slug "immersive-communication" ;
    vc:sourceDomain "distributed-collaboration" ;
    vc:uses ngm:metaverse .

ngm:latent-diffusion a owl:Class ;
    rdfs:label "Latent Diffusion"@en ;
    rdfs:comment "Latent Diffusion Models (LDMs) are a class of generative models that perform the iterative denoising diffusion process in the compressed latent space of a pre-trained variational autoencoder (VAE), rather than directly in pixel space. This design reduces the computational cost of training and inference by an order of magnitude whilst retaining perceptual quality, because the VAE encodes high-dimensional image data into a compact, semantically rich latent representation. LDMs are conditioned on text, image, or other modalities via cross-attention mechanisms inside a U-Net backbone, enabling text-to-image synthesis and image-to-image translation at practical compute budgets."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:variational-autoencoders ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:diffusion-model ],
        ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:enables ngm:image-generation,
        ngm:text-to-image ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:generative-model,
        ngm:latent-space ;
    vc:requires ngm:diffusion-model,
        ngm:variational-autoencoders ;
    vc:slug "latent-diffusion" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:manipulation a owl:Class ;
    rdfs:label "Manipulation"@en ;
    rdfs:comment "Manipulation in robotics refers to the ability of robotic systems to physically interact with and control objects in their environment."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
