    vc:sourceDomain "governance" .

ngm:regulatory-clarity a owl:Class ;
    rdfs:label "Regulatory Clarity"@en ;
    rdfs:comment "The condition in which the rules applying to an activity or product are sufficiently clear and predictable for participants to assess their legal obligations with confidence."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:transparency ],
        [ a owl:Restriction ;
