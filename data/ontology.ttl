    vc:slug "online-learning" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:open-market-operations a owl:Class ;
    rdfs:label "Open Market Operations"@en ;
    rdfs:comment "Open market operations (OMO) are the purchase and sale of government securities and other eligible assets by a central bank in the open market to steer short-term interest rates and the supply of reserves in the banking system. By adding or draining reserves, OMO move the policy rate toward its target and transmit monetary policy to the wider economy. They are the principal day-to-day tool of monetary-policy implementation in most advanced economies."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:reserve-asset ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:central-bank ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:liquidity-management ],
        ngm:monetary-policy-implementation ;
    vc:contrastsWith ngm:reserve-asset ;
    vc:dependsOn ngm:central-bank ;
    vc:enables ngm:monetary-policy-transmission ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:liquidity-management,
        ngm:reserve-asset ;
    vc:implements ngm:monetary-policy ;
    vc:isPartOf ngm:monetary-policy-implementation ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:liquidity-management,
        ngm:monetary-system ;
    vc:requires ngm:central-bank ;
    vc:slug "open-market-operations" ;
    vc:sourceDomain "finance" ;
    vc:supports ngm:inflation-targeting,
        ngm:interest-rate ;
    vc:uses ngm:financial-infrastructure,
        ngm:liquidity .

ngm:open-world-assumption a owl:Class ;
    rdfs:label "Open World Assumption"@en ;
    rdfs:comment "The open world assumption (OWA) is a logical stance in knowledge representation under which the absence of a statement from a knowledge base does not imply that the statement is false, only that its truth value is unknown. It is the foundational semantic principle of description logics and the Web Ontology Language (OWL), reflecting the incomplete and distributed nature of knowledge on the Semantic Web. The OWA contrasts directly with the closed world assumption used in conventional databases and logic programming, where unstated facts are treated as false."@en ;
    rdfs:subClassOf ngm:ontology ;
    vc:bridgesTo ngm:automated-reasoner ;
    vc:contrastsWith ngm:closed-world-assumption,
        ngm:negation-as-failure ;
    vc:dependsOn ngm:formal-semantics,
        ngm:logical-inference ;
    vc:enables ngm:knowledge-integration,
        ngm:semantic-reasoning ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:description-logic,
        ngm:monotonic-reasoning ;
    vc:isPartOf ngm:knowledge-representation ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:domain-ontology,
        ngm:knowledge-graph ;
    vc:requires ngm:no-unique-name-assumption ;
    vc:slug "open-world-assumption" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:linked-data,
        ngm:semantic-web ;
    vc:uses ngm:rdf,
        ngm:web-ontology-language .

ngm:payment-infrastructure a owl:Class ;
    rdfs:label "Payment Infrastructure"@en ;
    rdfs:comment "Payment infrastructure is the aggregate of networks, protocols, clearing houses, settlement systems, and regulatory frameworks that enable the transfer of monetary value between parties. It spans card networks, interbank messaging (SWIFT, ISO 20022), real-time gross settlement (RTGS) systems, and emerging digital-asset rails including stablecoins and central bank digital currencies. The infrastructure defines latency, finality, cost, and access characteristics that shape the global economy."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:clearing-house ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:identity-verification ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:payment-system ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:payment-channel-network ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:real-time-gross-settlement ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:payment-processor ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptographic-security ],
        ngm:financial-infrastructure ;
    vc:bridgesTo ngm:blockchain,
        ngm:distributed-collaboration ;
    vc:contrastsWith ngm:decentralized-finance ;
    vc:dependsOn ngm:network-infrastructure,
        ngm:regulatory-framework ;
    vc:enables ngm:cross-border-payments,
        ngm:financial-inclusion,
        ngm:micropayment ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:clearing-house,
        ngm:payment-channel-network,
        ngm:payment-processor,
        ngm:payment-system,
        ngm:real-time-gross-settlement ;
    vc:implements ngm:iso-20022,
        ngm:swift-messaging ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:cbdc-infrastructure,
        ngm:correspondent-banking,
        ngm:fraud-detection,
        ngm:lightning-network,
        ngm:stablecoin ;
    vc:requires ngm:cryptographic-security,
        ngm:identity-verification ;
    vc:slug "payment-infrastructure" ;
    vc:sourceDomain "finance" ;
    vc:supports ngm:digital-commerce .

ngm:payment-settlement a owl:Class ;
    rdfs:label "Payment Settlement"@en ;
    rdfs:comment "Payment settlement is the process by which a payment obligation between parties is irrevocably discharged through the transfer of value, completing a transaction so that the recipient gains final, unconditional ownership of funds. Settlement may occur gross or net, in real time or in batches, and across traditional rails or blockchain ledgers, with finality being the property that the transfer can no longer be reversed. In distributed-ledger contexts, settlement is achieved when an on-chain transaction reaches consensus finality."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:finality ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:liquidity ],
        ngm:settlement ;
    vc:bridgesTo ngm:distributed-ledger ;
    vc:contrastsWith ngm:state-channel ;
    vc:dependsOn ngm:central-bank,
        ngm:consensus ;
    vc:enables ngm:atomic-swap,
        ngm:stablecoin ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:financial-regulation ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:blockchain-transaction,
        ngm:liquidity,
        ngm:settlement ;
    vc:requires ngm:finality,
        ngm:liquidity ;
    vc:slug "payment-settlement" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:swift ;
    vc:uses ngm:on-chain-transaction,
        ngm:real-time-gross-settlement .

ngm:performance-benchmarks a owl:Class ;
    rdfs:label "Performance Benchmarks"@en ;
    rdfs:comment "Performance benchmarks are standardised, reproducible test suites and associated metric sets used to measure, compare, and rank the behavioural characteristics of software systems, hardware platforms, algorithms, or AI models under controlled or representative workload conditions. They quantify dimensions such as latency, throughput, resource utilisation, scalability, accuracy, and energy efficiency, enabling objective evaluation across vendors, versions, and deployment environments. Benchmark suites range from micro-benchmarks targeting isolated components to macro-benchmarks simulating realistic end-to-end workloads. Formal benchmark governance — through bodies such as SPEC, MLCommons, and TPC — establishes methodology rules, disclosure requirements, and result auditing to prevent benchmark gaming."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:observability ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:resource-efficiency ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:testing ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:latency ],
        ngm:software-testing ;
    vc:bridgesTo ngm:hardware-acceleration,
        ngm:model-evaluation ;
    vc:contrastsWith ngm:stress-testing,
        ngm:unit-testing ;
    vc:dependsOn ngm:metrics-collection,
        ngm:statistical-analysis ;
    vc:enables ngm:capacity-planning,
        ngm:performance-optimization ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:latency,
        ngm:resource-efficiency ;
    vc:implements ngm:benchmarks,
        ngm:mlperf ;
    vc:isPartOf ngm:quality-assurance,
        ngm:software-testing ;
    vc:qualityScore "0.73"^^xsd:float ;
    vc:relatedTo ngm:continuous-integration,
        ngm:service-level-objective ;
    vc:requires ngm:observability,
        ngm:profiling,
        ngm:testing ;
    vc:slug "performance-benchmarks" ;
    vc:sourceDomain "infrastructure" ;
    vc:standardizedBy ngm:mlcommons ;
    vc:uses ngm:reproducible-experiments,
        ngm:time-series-data .

ngm:portfolio-management a owl:Class ;
    rdfs:label "Portfolio Management"@en ;
    rdfs:comment "Portfolio Management is the discipline of selecting, weighting and overseeing a collection of financial assets so that their combined risk and return characteristics align with an investor's objectives and constraints. It applies diversification, asset allocation and ongoing rebalancing to balance expected return against tolerable risk over a defined horizon. The practice spans both passive strategies that track benchmarks and active strategies that seek to outperform them."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:asset-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:risk-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:risk-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:financial-instruments ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-analytics ],
        ngm:investment-management ;
    vc:bridgesTo ngm:decentralized-finance,
        ngm:fintech ;
    vc:dependsOn ngm:risk-management ;
    vc:enables ngm:asset-management,
        ngm:financial-services ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:asset-management,
        ngm:risk-management ;
    vc:isPartOf ngm:investment-management ;
