ngm:ce-marking a owl:Class ;
    rdfs:label "CE Marking"@en ;
    rdfs:comment "CE marking is a mandatory conformity mark indicating that a product placed on the European Economic Area market meets the applicable EU health, safety, and environmental protection requirements. For machinery and robots it signals compliance with directives such as the Machinery Regulation, the EMC Directive, and relevant harmonised standards, often supported by a declaration of conformity and technical file. It matters because it is a legal precondition for market access and embeds robot safety standards into commercial deployment."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:conformity-assessment ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:risk-assessment ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:notified-body ],
        ngm:robo-safety-and-standards ;
    skos:broader ngm:robo-safety-and-standards ;
    vc:bridgesTo ngm:governance,
        ngm:supply-chain ;
    vc:contrastsWith ngm:safety-certification ;
    vc:dependsOn ngm:emc-standard,
        ngm:regulation ;
    vc:enables ngm:market-access ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:declaration-of-conformity,
        ngm:risk-assessment ;
    vc:implements ngm:ai-product-and-risk-framework ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:product-liability,
        ngm:robot-standard ;
