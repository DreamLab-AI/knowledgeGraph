ngm:ve-chain a owl:Class ;
    rdfs:label "VeChain"@en ;
    rdfs:comment "VeChain is a public blockchain platform oriented toward supply-chain management and enterprise applications. It uses a proof-of-authority consensus model in which a limited set of authorised validators produce blocks, prioritising throughput and predictability for business use. The platform employs a dual-token design, separating the asset used to hold value from the token used to pay for transaction costs."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:smart-contract ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:proof-of-authority ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:distributed-ledger ],
        ngm:blockchain ;
    skos:broader ngm:blockchain ;
    vc:bridgesTo ngm:digital-asset,
        ngm:supply-chain-management ;
    vc:contrastsWith ngm:ethereum,
        ngm:hyperledger-fabric ;
    vc:dependsOn ngm:consensus-mechanism,
        ngm:validator-node ;
    vc:enables ngm:anti-counterfeiting,
        ngm:product-provenance,
        ngm:supply-chain-tracking,
        ngm:sustainability-reporting ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:vechain-thor,
        ngm:vethor-token ;
    vc:implements ngm:decentralised-application,
        ngm:tokenisation ;
    vc:isPartOf ngm:enterprise-blockchain ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:decentralised-finance,
        ngm:non-fungible-token ;
    vc:requires ngm:distributed-ledger,
        ngm:proof-of-authority,
        ngm:smart-contract ;
    vc:slug "ve-chain" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:enterprise-resource-planning,
        ngm:logistics-management ;
    vc:uses ngm:digital-identity,
        ngm:dual-token-model,
        ngm:internet-of-things .

