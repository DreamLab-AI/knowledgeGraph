    vc:slug "video-conferencing" ;
    vc:sourceDomain "distributed-collaboration" .

ngm:virtual-production a owl:Class ;
    rdfs:label "Virtual Production"@en ;
    rdfs:comment "Real-time filmmaking technique combining LED Volume stages, game engine rendering, and in-camera visual effects (ICVFX) to create photorealistic virtual environments during live-action production, enabling directors to see final composited imagery on set. It integrates motion capture, photogrammetry, and neural rendering to compress post-production timelines and allow creative decisions to be made on set rather than in post."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:virtual-production-volume ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:virtual-production-pipeline ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:virtual-stage ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:virtual-production-workflow ],
        ngm:real-time-rendering,
        ngm:sc-display-and-rendering ;
    skos:broader ngm:sc-display-and-rendering ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:virtual-production-pipeline,
        ngm:virtual-production-volume,
        ngm:virtual-production-workflow,
        ngm:virtual-stage ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:film-production,
        ngm:vfx-tools,
        ngm:volumetric-capture ;
    vc:slug "virtual-production" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:display-hardware,
        ngm:game-engine,
        ngm:motion-capture,
        ngm:neural-rendering,
        ngm:photogrammetry,
        ngm:real-time-rendering-pipeline .

ngm:vulnerability a owl:Class ;
    rdfs:label "Vulnerability"@en ;
    rdfs:comment "A Vulnerability is a weakness, flaw, or inadequacy in a system's design, implementation, or configuration that can be exploited to violate security policies or compromise integrity. Vulnerabilities are classified by origin (design flaw, implementation bug, configuration error), severity (CVSS score), and CIA impact (confidentiality, integrity, availability), and are managed through scanning, patching, and compensating controls."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:risk-assessment ],
        ngm:bc-protocol-and-consensus ;
    skos:broader ngm:bc-protocol-and-consensus ;
    vc:contrastsWith ngm:security ;
    vc:dependsOn ngm:risk ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:relatedTo ngm:attack-vector,
        ngm:resilience,
        ngm:threat-actor ;
    vc:requires ngm:risk-assessment ;
    vc:slug "vulnerability" ;
    vc:sourceDomain "blockchain" .

ngm:adaptive-control a owl:Class ;
    rdfs:label "Adaptive Control"@en ;
    rdfs:comment "A control strategy that automatically adjusts its parameters in real-time to maintain desired performance as system dynamics change or uncertainties are encountered. The controller learns and adapts to variations in the system or environment."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:system-identification ],
        ngm:closed-loop-control,
        ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:enables ngm:robust-control,
        ngm:self-tuning-systems ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires ngm:parameter-adaptation-mechanism,
        ngm:system-identification ;
    vc:slug "adaptive-control" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:parameter-estimation,
        ngm:system-identification .

ngm:api-standard a owl:Class ;
    rdfs:label "API Standard"@en ;
    rdfs:comment "Specification defining how independent software components communicate within metaverse systems, establishing protocols and data formats for interoperability."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
