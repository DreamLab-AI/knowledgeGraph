        ngm:event-sourcing,
        ngm:object-storage,
        ngm:write-ahead-logging ;
    vc:implements ngm:cap-theorem,
        ngm:pacelc-model ;
    vc:isPartOf ngm:data-management,
        ngm:system-architecture ;
    vc:qualityScore "0.73"^^xsd:float ;
