ngm:photorealistic-synthesis a owl:Class ;
    rdfs:comment "Photorealistic synthesis is the generation of images or scenes that are visually indistinguishable from real photographs. It is achieved with generative models such as diffusion networks and GANs, or with physically based rendering, that reproduce accurate lighting, materials, geometry, and texture detail. It underpins high-fidelity image generation and the creation of realistic 4D and procedural content."@en ;
    rdfs:label "Photorealistic Synthesis"@en ;
    rdfs:subClassOf ngm:generative-ai ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:procedural-and-hybrid-4-d ;
    vc:relatedTo ngm:proprietary-image-generation ;
    vc:slug "photorealistic-synthesis" ;
    vc:sourceDomain "ai" .
ngm:photorealistic-telepresence a owl:Class ;
    rdfs:comment "Photorealistic telepresence is remote real-time communication in which participants appear as lifelike, volumetrically accurate representations rather than video tiles or stylised avatars. It reconstructs a person's appearance and motion using techniques such as neural avatars and 3D Gaussian splatting, rendering them convincingly in a shared spatial scene. The goal is a sense of co-presence that closely matches being physically together."@en ;
    rdfs:label "Photorealistic Telepresence"@en ;
    rdfs:subClassOf ngm:telepresence ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:3-d-gaussian-splatting ;
    vc:relatedTo ngm:ai-avatars ;
    vc:slug "photorealistic-telepresence" ;
    vc:sourceDomain "metaverse" .
