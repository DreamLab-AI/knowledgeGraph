        ngm:supply-chain-traceability ;
    vc:contrastsWith ngm:centralised-database,
        ngm:record-keeping-system ;
    vc:enables ngm:audit-trail,
        ngm:decentralised-finance,
        ngm:smart-contract,
        ngm:tokenization,
        ngm:transparency ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:blockchain-transaction,
        ngm:genesis-block,
        ngm:immutable-record,
        ngm:merkle-tree,
        ngm:utxo ;
    vc:implements ngm:append-only-log,
        ngm:byzantine-fault-tolerance ;
    vc:isPartOf ngm:blockchain,
        ngm:peer-to-peer-network ;
    vc:qualityScore "0.8"^^xsd:float ;
