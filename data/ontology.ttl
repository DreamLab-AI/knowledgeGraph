ngm:centralised-database a owl:Class ;
    rdfs:label "Centralised Database"@en ;
    rdfs:comment "A centralised database is a data management system in which all data is stored, administered, and accessed through a single physical or logical location under a single controlling authority. It provides a unified, authoritative view of data with strong consistency guarantees, simplified access control, and a single point of administration. All read and write operations are routed to this central node or cluster, making it the canonical source of truth for the entire system. The centralised model contrasts with distributed and decentralised architectures by sacrificing geographic fault-tolerance and autonomy in exchange for consistency, reduced coordination overhead, and operational simplicity."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:backup-and-recovery ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:network-infrastructure ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:access-control ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-storage ],
        ngm:database-management-system ;
    vc:bridgesTo ngm:cloud-storage,
        ngm:data-lake,
        ngm:federated-learning ;
    vc:contrastsWith ngm:blockchain,
        ngm:decentralised-storage,
        ngm:distributed-database,
        ngm:peer-to-peer-network ;
    vc:dependsOn ngm:operating-system,
        ngm:server-infrastructure ;
    vc:enables ngm:acid-compliance,
        ngm:centralised-access-control,
        ngm:data-consistency ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:access-control,
        ngm:query-engine,
        ngm:relational-database,
        ngm:transaction-management ;
    vc:implements ngm:acid-transactions,
        ngm:sql ;
    vc:isPartOf ngm:data-management,
        ngm:information-system ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:cap-theorem,
        ngm:data-warehouse,
        ngm:nosql-database,
        ngm:single-point-of-failure ;
    vc:requires ngm:backup-and-recovery,
        ngm:data-storage,
        ngm:network-infrastructure ;
    vc:slug "centralised-database" ;
    vc:sourceDomain "data" ;
    vc:standardizedBy ngm:ansi-sql,
        ngm:iso-iec-9075 ;
    vc:supports ngm:audit-logging,
        ngm:data-governance,
        ngm:regulatory-compliance ;
    vc:uses ngm:indexing,
        ngm:query-optimisation,
        ngm:replication .

ngm:change-management a owl:Class ;
    rdfs:label "Change Management"@en ;
    rdfs:comment "Change Management is the structured discipline of guiding organisations, teams, and individuals through transitions in technology, process, or culture to achieve desired outcomes whilst minimising disruption and resistance. It encompasses planning, communication, training, stakeholder alignment, and feedback loops that collectively ensure adoption of new working methods. In technology contexts it also covers the formal control of modifications to systems and infrastructure to reduce risk. Effective change management is widely recognised as a critical determinant of whether digital transformation initiatives deliver their intended value."@en ;
    rdfs:subClassOf ngm:ai-governance-framework ;
    vc:enables ngm:ai-adoption,
        ngm:workforce-development ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:digital-transformation,
        ngm:human-factors,
        ngm:stakeholder-engagement ;
    vc:slug "change-management" ;
    vc:sourceDomain "governance" ;
    vc:uses ngm:audit-trail,
        ngm:compliance-monitoring,
        ngm:risk-assessment .

ngm:code-signing a owl:Class ;
    rdfs:label "Code Signing"@en ;
    rdfs:comment "Code Signing is a cryptographic practice in which software publishers digitally sign executables, scripts, container images, and other software artefacts using a private key, enabling recipients to verify the artefact's authenticity and integrity through the corresponding public key certificate. Implemented via asymmetric cryptography and X.509 certificate chains anchored to trusted Certificate Authorities or transparency logs, code signing is a fundamental control in software supply chain security, preventing the distribution of tampered or malicious software. Modern approaches include keyless signing via short-lived certificates and cryptographic transparency logs."@en ;
    rdfs:subClassOf ngm:cryptographic-signing ;
    vc:enables ngm:provenance-tracking,
        ngm:supply-chain-traceability,
        ngm:trusted-execution-environment ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:cryptographic-hash-function,
        ngm:notary-service,
        ngm:supply-chain ;
    vc:slug "code-signing" ;
    vc:sourceDomain "security" ;
    vc:uses ngm:certificate-authority,
        ngm:digital-signature,
        ngm:knowledge-graph-publication-classifier-key-infrastructure .

ngm:cold-storage a owl:Class ;
    rdfs:label "Cold Storage"@en ;
    rdfs:comment "Cold Storage in the context of digital assets and cryptocurrency refers to the practice of holding private keys in an offline environment — physically disconnected from any network — to eliminate the attack surface presented by internet-connected systems. Hardware wallets, air-gapped computers, and paper wallets are common cold storage implementations. By contrast with hot wallets (internet-connected), cold storage sacrifices transaction convenience for maximum security, and is the industry standard for custodying large quantities of cryptocurrency at exchanges, institutional custodians, and high-net-worth individual holders."@en ;
    rdfs:subClassOf ngm:custody-infrastructure ;
    vc:enables ngm:institutional-custody,
        ngm:self-custody ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:bitcoin-proof-of-work-protocol-network,
        ngm:decentralized-finance-de-fi,
        ngm:multisignature-wallets,
        ngm:threshold-signature-scheme ;
    vc:slug "cold-storage" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:cryptographic-key-management,
        ngm:hardware-security-module,
        ngm:multisignature .

ngm:compute-resources a owl:Class ;
    rdfs:label "Compute Resources"@en ;
    rdfs:comment "Compute resources are the aggregate processing capacity available to execute computational workloads, encompassing CPUs, GPUs, specialised accelerators (TPUs, NPUs), memory, network bandwidth, and associated storage I/O. They are quantified by metrics such as FLOPS, memory bandwidth, core count, and clock speed, and are provisioned via physical hardware, virtualised cloud instances, or serverless functions. Effective allocation and scheduling of compute resources is the foundational concern of cloud computing, high-performance computing, and AI infrastructure."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:gpu-resources ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:compute-layer ],
        ngm:computational-resources ;
    vc:enables ngm:gpu-computing,
        ngm:high-performance-computing,
        ngm:model-training ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:compute-layer,
        ngm:gpu-resources ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:ai-infrastructure,
        ngm:cloud-computing ;
    vc:slug "compute-resources" ;
    vc:sourceDomain "infrastructure" .

ngm:computer-vision-system a owl:Class ;
    rdfs:label "Computer Vision System"@en ;
    rdfs:comment "An integrated assembly of hardware and software components—cameras, depth sensors, inference pipelines, and output interfaces—that acquires, processes, and interprets visual information from the physical world. Computer vision systems underpin spatial computing applications such as AR tracking, spatial mapping, and object detection, translating raw image data into actionable semantic understanding for downstream tasks."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:depth-sensor ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:camera-calibration ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:image-sensor ],
        ngm:sc-interaction ;
    skos:broader ngm:sc-interaction ;
    vc:bridgesTo ngm:computer-vision,
        ngm:robotics-perception ;
    vc:contrastsWith ngm:lidar-system ;
    vc:enables ngm:augmented-reality,
        ngm:object-detection,
        ngm:pose-estimation,
        ngm:simultaneous-localization-and-mapping,
        ngm:spatial-mapping ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:camera-calibration,
        ngm:depth-sensor,
        ngm:image-sensor,
        ngm:inference-pipeline ;
    vc:implements ngm:image-classification,
        ngm:semantic-segmentation ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:pattern-recognition,
        ngm:real-time-processing ;
    vc:requires ngm:gpu-accelerator,
        ngm:image-preprocessing,
        ngm:labeled-dataset ;
    vc:slug "computer-vision-system" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:autonomous-vehicle,
        ngm:industrial-robot ;
    vc:uses ngm:convolutional-neural-network,
        ngm:deep-learning,
        ngm:feature-extraction,
        ngm:optical-flow .

ngm:constraint-satisfaction a owl:Class ;
    rdfs:label "Constraint Satisfaction"@en ;
    rdfs:comment "Constraint Satisfaction is a paradigm in artificial intelligence and combinatorial mathematics in which a problem is represented as a set of variables, each with a domain of possible values, and a set of constraints that restrict the allowable combinations of those values. The goal is to find an assignment of values to all variables such that every constraint is simultaneously satisfied, or to determine that no such assignment exists. Solution methods combine systematic backtracking search with constraint propagation techniques — notably arc consistency and path consistency — that prune infeasible values early, dramatically reducing the search space. Constraint satisfaction underpins scheduling, configuration, planning, and combinatorial optimisation across virtually every engineering domain."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:search-algorithm ],
        ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:bridgesTo ngm:network-configuration,
        ngm:robotic-task-planning,
        ngm:supply-chain-optimisation ;
    vc:contrastsWith ngm:linear-programming,
        ngm:satisfiability ;
    vc:dependsOn ngm:combinatorial-optimisation,
        ngm:graph-theory ;
    vc:enables ngm:automated-planning,
        ngm:configuration-management,
        ngm:resource-allocation,
        ngm:scheduling ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:arc-consistency,
        ngm:backtracking-search,
        ngm:constraint-propagation,
        ngm:variable-ordering-heuristic ;
    vc:implements ngm:symbolic-ai ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:integer-programming,
        ngm:probabilistic-inference,
        ngm:propositional-logic ;
    vc:requires ngm:domain-representation,
        ngm:search-algorithm ;
    vc:slug "constraint-satisfaction" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:decision-making,
        ngm:knowledge-representation ;
    vc:uses ngm:heuristic,
        ngm:inference-engine,
        ngm:local-search .

ngm:cooling-system a owl:Class ;
    rdfs:label "Cooling System"@en ;
    rdfs:comment "A system that removes heat from equipment to keep it within safe operating temperatures. In computing it covers air, liquid, and immersion methods used in servers and data centres."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:hardware ],
        ngm:hardware ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:hardware ;
    vc:slug "cooling-system" ;
    vc:sourceDomain "infrastructure" .

ngm:coordinate-frame a owl:Class ;
    rdfs:label "Coordinate Frame"@en ;
    rdfs:comment "A coordinate frame is a reference system defined by an origin and a set of axes against which positions, orientations, and motions are measured. In robotics and perception, multiple frames (world, base, sensor, tool) are related by rigid-body transforms so that data from different sources can be expressed consistently. Correct frame management is essential for sensor fusion, motion planning, and collision checking."@en ;
    rdfs:subClassOf ngm:robo-navigation-and-planning ;
    skos:broader ngm:robo-navigation-and-planning ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:collision-detection,
        ngm:exteroceptive-sensor ;
    vc:slug "coordinate-frame" ;
    vc:sourceDomain "robotics" .

ngm:creative-tools a owl:Class ;
    rdfs:label "Creative Tools"@en ;
    rdfs:comment "Creative Tools are AI-powered and digitally-augmented software applications that assist, augment, or automate human creative processes across modalities including image generation, music composition, video synthesis, 3D asset creation, and long-form text authoring. They typically expose foundation models—particularly diffusion models and large language models—through interactive interfaces or programmable API endpoints, enabling both professionals and non-expert users to produce high-quality creative outputs. Their role is dual: serving as productivity accelerators for practitioners and as accessibility bridges lowering barriers to creative expression. Provenance attribution, intellectual property frameworks, and content authentication standards such as C2PA are active governance concerns around AI-generated content produced by these tools."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gpu-compute ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:foundation-model ],
        ngm:ai-application ;
    skos:broader ngm:ai-application ;
    vc:bridgesTo ngm:digital-twin,
        ngm:metaverse-content,
        ngm:spatial-computing ;
    vc:contrastsWith ngm:rule-based-procedural-generation,
        ngm:traditional-design-software ;
    vc:dependsOn ngm:api-endpoint,
        ngm:training-data ;
    vc:enables ngm:3d-asset-creation,
        ngm:content-creation,
        ngm:image-generation,
        ngm:music-generation,
        ngm:text-to-image,
        ngm:video-synthesis ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:ai-application,
        ngm:content-provenance,
        ngm:human-ai-collaboration,
        ngm:intellectual-property ;
    vc:requires ngm:foundation-model,
        ngm:gpu-compute ;
    vc:slug "creative-tools" ;
    vc:sourceDomain "ai" ;
    vc:supports ngm:creative-economy,
        ngm:human-computer-interaction ;
    vc:uses ngm:diffusion-model,
        ngm:generative-ai,
        ngm:large-language-model,
        ngm:multimodal-model,
        ngm:prompt-engineering .

ngm:cross-entropy-loss a owl:Class ;
    rdfs:label "Cross-Entropy Loss"@en ;
    rdfs:comment "Cross-entropy loss is a differentiable scalar objective function that measures the dissimilarity between a model's predicted probability distribution and the true label distribution, computed as the negative log-likelihood of the correct class under the model's output. It is the canonical training objective for classification tasks and language modelling, directly optimising the model to assign maximum probability mass to correct outputs. Minimising cross-entropy is equivalent to maximising the likelihood of the training data under the model's parameterised distribution."@en ;
    rdfs:subClassOf ngm:loss-function ;
    vc:enables ngm:language-modeling,
        ngm:model-training,
        ngm:supervised-learning ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:large-language-models,
        ngm:transformer ;
    vc:slug "cross-entropy-loss" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:backpropagation,
        ngm:gradient-descent .

ngm:data-format-standard a owl:Class ;
    rdfs:label "Data Format Standard"@en ;
    rdfs:comment "Technical specifications defining how data is structured, encoded, and exchanged across metaverse platforms and 3D applications, including standards like glTF for efficient 3D asset transmission and Universal Scene Description (USD) for complex scene composition and collaboration."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
