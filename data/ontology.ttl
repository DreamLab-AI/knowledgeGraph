ngm:social-vr a owl:Class ;
    rdfs:label "Social VR"@en ;
    rdfs:comment "Social VR encompasses immersive virtual reality experiences specifically designed for real-time social interaction and collaboration among multiple users within shared persistent virtual spaces, leveraging avatar-based presence and synchronised communication."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
