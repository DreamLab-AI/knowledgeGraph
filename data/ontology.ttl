ngm:open-metaverse-interoperability-group a owl:Class ;
    rdfs:comment "The Open Metaverse Interoperability Group (OMI) is a community-driven body that develops open protocols and schemas for moving identity, avatars, and virtual objects between independent virtual worlds. It produces specifications for portable avatars, glTF extensions, and cross-platform identity so that metaverse experiences are not locked into single proprietary platforms. Its work aims to make virtual environments composable and interoperable rather than walled gardens."@en ;
    rdfs:label "Open Metaverse Interoperability Group"@en ;
    rdfs:subClassOf ngm:sc-standards-and-interop ;
    skos:broader ngm:sc-standards-and-interop ;
