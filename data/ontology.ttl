ngm:camera-sensor a owl:Class ;
    rdfs:comment "A camera sensor is the photosensitive component, typically a CMOS or CCD array, that converts incident light focused by the optics into an electrical signal forming an image. Its characteristics, including resolution, pixel size, dynamic range, noise and frame rate, determine the quality of the captured imagery and shutter behaviour. It is the primary exteroceptive vision input for robots, autonomous vehicles and immersive devices, and is frequently fused with complementary sensors such as lidar."@en ;
    rdfs:label "Camera Sensor"@en ;
    rdfs:subClassOf ngm:sensor ;
    rdfs:subClassOf _:r3881 ;
    rdfs:subClassOf _:r3882 ;
