            owl:someValuesFrom ngm:distributed-computing ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:edge-computing ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:virtual-world-infrastructure ],
        ngm:infra-computing-and-cloud ;
    skos:broader ngm:infra-computing-and-cloud ;
    vc:bridgesTo ngm:blockchain-infrastructure,
        ngm:decentralised-storage ;
    vc:dependsOn ngm:cloud-computing,
