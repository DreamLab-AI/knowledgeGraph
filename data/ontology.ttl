ngm:objective-function a owl:Class ;
    rdfs:label "Objective Function"@en ;
    rdfs:comment "An objective function is a scalar-valued function that quantifies the quality of a candidate solution, which an optimisation or learning process seeks to minimise or maximise. In machine learning it formalises the goal of training — for example minimising prediction error or maximising likelihood — so that algorithms can adjust parameters to improve it. The choice of objective function determines what a model is rewarded for, shaping its behaviour, biases and generalisation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:optimization-algorithm ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:evaluation-metric ],
        ngm:optimisation ;
    vc:bridgesTo ngm:machine-learning ;
    vc:contrastsWith ngm:evaluation-metric,
        ngm:loss-function ;
    vc:dependsOn ngm:evaluation-metric,
        ngm:optimisation ;
    vc:enables ngm:learning-algorithm ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:implements ngm:optimisation ;
    vc:isPartOf ngm:optimisation ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:convex-optimisation,
        ngm:optimization-algorithm ;
    vc:requires ngm:evaluation-metric,
        ngm:optimization-algorithm ;
    vc:slug "objective-function" ;
    vc:sourceDomain "machine-learning" ;
    vc:supports ngm:hyperparameter-tuning ;
    vc:uses ngm:gradient-descent .

ngm:optimiser a owl:Class ;
    rdfs:label "Optimiser"@en ;
    rdfs:comment "An Optimiser is an algorithm that adjusts model parameters during training to minimise a loss function, guiding convergence towards an optimal solution. Modern optimisers such as Adam, RMSProp, and AdaGrad extend stochastic gradient descent with adaptive learning rates, momentum accumulation, and second-moment estimates, enabling faster and more stable training of deep neural networks across diverse tasks."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:learning-rate ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:loss-function ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gradient-descent ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:backpropagation ],
        ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:bridgesTo ngm:artificial-intelligence,
        ngm:robotics ;
    vc:contrastsWith ngm:evolutionary-algorithm,
        ngm:second-order-optimisation ;
    vc:dependsOn ngm:hyperparameter,
        ngm:weight-initialisation ;
    vc:enables ngm:convergence,
        ngm:deep-learning,
        ngm:model-training,
        ngm:neural-network ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.68"^^xsd:float ;
    vc:relatedTo ngm:batch-normalisation,
        ngm:gradient-clipping,
        ngm:regularisation ;
    vc:requires ngm:backpropagation,
        ngm:gradient-descent,
        ngm:learning-rate,
        ngm:loss-function ;
    vc:slug "optimiser" ;
    vc:sourceDomain "machine-learning" ;
    vc:supports ngm:reinforcement-learning,
        ngm:transfer-learning ;
    vc:uses ngm:adaptive-learning-rate,
        ngm:momentum,
        ngm:stochastic-gradient-descent .

ngm:parallel-processing a owl:Class ;
    rdfs:label "Parallel Processing"@en ;
    rdfs:comment "Parallel Processing is a computational paradigm in which multiple calculations or processes are carried out simultaneously by decomposing a problem into sub-tasks that execute concurrently across multiple processor cores, GPUs, or distributed compute nodes. It exploits data parallelism, task parallelism, and pipeline parallelism to reduce wall-clock execution time and increase throughput. Parallel processing is foundational to modern high-performance computing, enabling workloads such as large-scale neural network training, real-time physics simulation, and petabyte-scale data analytics that would be infeasible on sequential hardware."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:computing-infrastructure ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:data-parallelism ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:memory-bandwidth ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:pipeline-parallelism ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:interconnect ],
        ngm:computing-infrastructure ;
    vc:bridgesTo ngm:federated-learning,
        ngm:spatial-computing ;
    vc:contrastsWith ngm:sequential-computing ;
    vc:dependsOn ngm:load-balancing,
        ngm:synchronisation ;
    vc:enables ngm:deep-learning,
        ngm:distributed-training,
        ngm:large-language-model,
        ngm:real-time-rendering,
        ngm:scientific-simulation ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:data-parallelism,
        ngm:pipeline-parallelism,
        ngm:simd,
        ngm:task-parallelism ;
    vc:isPartOf ngm:high-performance-computing ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:asynchronous-programming,
        ngm:concurrency,
        ngm:distributed-computing ;
    vc:requires ngm:computing-infrastructure,
        ngm:interconnect,
        ngm:memory-bandwidth ;
    vc:slug "parallel-processing" ;
    vc:sourceDomain "infrastructure" ;
    vc:standardizedBy ngm:cuda,
        ngm:mpi,
        ngm:openmp ;
    vc:uses ngm:gpu-compute,
        ngm:thread-protocol .

ngm:payment-gateway a owl:Class ;
    rdfs:label "Payment Gateway"@en ;
    rdfs:comment "A Payment Gateway is a technology service that authorises, processes, and routes financial transactions between buyers and merchants, acting as the intermediary between a merchant's point-of-sale or e-commerce system and the acquiring bank or payment network. It encrypts sensitive payment credentials, communicates with card networks and issuing banks to obtain authorisation, and returns the result to the merchant in real time. Modern payment gateways provide APIs, SDKs, fraud detection, currency conversion, and compliance tooling, and increasingly support cryptocurrency payments and programmable settlement rails alongside traditional card and bank transfer methods. Payment gateways are foundational infrastructure for e-commerce and digital commerce ecosystems."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:fraud-detection ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:tokenization ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:pci-dss ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:tls ],
        ngm:payment-system ;
    vc:bridgesTo ngm:lightning-network,
        ngm:smart-contract ;
    vc:contrastsWith ngm:payment-processor ;
    vc:dependsOn ngm:card-network ;
    vc:enables ngm:cross-border-payments,
        ngm:micropayment,
        ngm:payment-token,
        ngm:x402-and-l402-payment-protocols ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:currency-conversion,
        ngm:fraud-detection,
        ngm:tokenization ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:central-bank-digital-currency,
        ngm:digital-payment-system,
        ngm:open-banking ;
    vc:requires ngm:pci-dss,
        ngm:tls ;
    vc:slug "payment-gateway" ;
    vc:sourceDomain "finance" ;
    vc:standardizedBy ngm:iso-20022 ;
    vc:supports ngm:agentic-ai,
        ngm:e-commerce,
        ngm:point-of-sale ;
    vc:uses ngm:api-gateway,
        ngm:digital-wallet,
        ngm:encryption,
        ngm:restful-api .

ngm:pipeline-parallelism a owl:Class ;
    rdfs:label "Pipeline Parallelism"@en ;
    rdfs:comment "Pipeline parallelism splits a computation into ordered stages assigned to different processing units, so that distinct items occupy different stages at once and throughput rises once the pipeline is filled. It is widely used to train large deep learning models across multiple devices by assigning successive layers or micro-batches to separate accelerators."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:parallel-computing ],
        ngm:distributed-computing ;
    vc:bridgesTo ngm:distributed-training,
        ngm:gpu-architecture,
        ngm:graphics-pipeline ;
    vc:contrastsWith ngm:data-parallelism,
        ngm:expert-parallelism ;
    vc:dependsOn ngm:gpu-architecture,
        ngm:high-bandwidth-interconnect ;
    vc:enables ngm:model-training,
        ngm:real-time-rendering ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:graphics-pipeline ;
    vc:isPartOf ngm:model-parallelism ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:deep-speed,
        ngm:megatron-lm ;
    vc:requires ngm:micro-batch-scheduling,
        ngm:parallel-computing ;
    vc:slug "pipeline-parallelism" ;
    vc:sourceDomain "machine-learning" ;
    vc:supports ngm:data-parallelism,
        ngm:tensor-parallelism ;
    vc:uses ngm:gradient-accumulation,
        ngm:gradient-checkpointing .

ngm:pneumatic-actuator a owl:Class ;
    rdfs:label "Pneumatic Actuator"@en ;
    rdfs:comment "PneumaticActuator is a mechanical device that converts compressed-air energy into controlled mechanical motion — linear (cylinders, bellows), rotary (vane motors, semi-rotary actuators), or contractile (McKibben muscles, fibre-reinforced elastomers, Festo fluidic muscles) — and serves as the prim..."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:pneumatic-cylinder ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:proportional-valve ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:position-sensor ],
        ngm:fluid-power-device,
        ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:enables ngm:human-robot-interaction,
        ngm:locomotion,
        ngm:rehabilitation-robotics,
        ngm:robotic-grasping,
        ngm:safe-human-robot-interaction ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:directional-control-valve,
        ngm:mc-kibben-muscle,
        ngm:pneumatic-cylinder,
        ngm:pneumatic-network,
        ngm:position-sensor,
        ngm:pressure-regulator,
        ngm:proportional-valve ;
    vc:implements ngm:iso ;
    vc:qualityScore "0.52"^^xsd:float ;
    vc:relatedTo ngm:series-elastic-actuator,
        ngm:variable-stiffness-actuator ;
    vc:requires ngm:directional-control-valves,
        ngm:pressure-regulation ;
    vc:slug "pneumatic-actuator" ;
    vc:sourceDomain "robotics" ;
    vc:standardizedBy ngm:emc-standard,
        ngm:iso ;
    vc:supports ngm:agricultural-robotics,
        ngm:collaborative-systems-modality-robotics,
        ngm:exoskeleton,
