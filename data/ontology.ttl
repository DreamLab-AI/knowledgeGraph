    vc:requires ngm:display-hardware,
        ngm:slam ;
    vc:slug "digital-content-overlay" ;
    vc:sourceDomain "spatial-computing" .

ngm:digital-curation-platform a owl:Class ;
    rdfs:label "Digital Curation Platform"@en ;
    rdfs:comment "Digital Curation Platform is a type of Digital Asset Management in the spatial computing domain."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:authentication-service ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:metadata-standards ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
