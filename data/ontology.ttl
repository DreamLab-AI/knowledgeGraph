ngm:controlled-vocabularies a owl:Class ;
    rdfs:label "Controlled Vocabularies"@en ;
    rdfs:comment "Standardized sets of terms, phrases, and hierarchical relationships used to describe and organize information within knowledge management systems, databases, and metadata schemas, ensuring consistent indexing, retrieval, and interoperability across digital platforms and virtual environments."@en ;
