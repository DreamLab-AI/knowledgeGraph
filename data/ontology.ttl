ngm:cross-border-payments a owl:Class ;
    rdfs:label "Cross-Border Payments"@en ;
    rdfs:comment "Cross-Border Payments are financial transactions that originate in one country and are settled in another, requiring currency conversion, multi-jurisdiction regulatory compliance, and interoperability between disparate payment systems. Traditional correspondent banking networks rely on SWIFT messaging and chains of intermediary banks, incurring multi-day settlement cycles, layered fees, and significant opacity. Blockchain-based payment rails—including stablecoins, payment channels, and Central Bank Digital Currencies—compress settlement latency and reduce intermediary costs by enabling atomic finality and programmable escrow. The domain sits at the intersection of monetary policy, AML/KYC regulation, ISO 20022 standardisation, and distributed-ledger technology."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:correspondent-banking ],
        ngm:financial-services ;
    vc:bridgesTo ngm:blockchain,
        ngm:consensus-mechanism,
        ngm:tokenisation ;
    vc:contrastsWith ngm:correspondent-banking,
        ngm:domestic-payments ;
    vc:dependsOn ngm:interoperability,
        ngm:payment-infrastructure,
        ngm:regulatory-compliance ;
    vc:enables ngm:financial-inclusion,
        ngm:remittance,
        ngm:trade-finance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:central-bank-digital-currency,
        ngm:decentralised-finance,
        ngm:fatf-travel-rule,
        ngm:forex ;
    vc:requires ngm:aml-kyc,
        ngm:correspondent-banking,
        ngm:currency-exchange ;
    vc:slug "cross-border-payments" ;
    vc:sourceDomain "finance" ;
    vc:standardizedBy ngm:bis-cpmi,
        ngm:financial-stability-board ;
    vc:uses ngm:iso-20022,
        ngm:lightning-network,
        ngm:smart-contract,
        ngm:stablecoin,
        ngm:swift-messaging .

ngm:cryptographic-commitment a owl:Class ;
    rdfs:label "Cryptographic Commitment"@en ;
    rdfs:comment "A cryptographic scheme that allows a party to commit to a chosen value while keeping it hidden, with the ability to reveal it later, satisfying the binding property (cannot change the committed value) and the hiding property (the commitment reveals no information about the value). Used in zero-knowledge proofs, atomic swaps, and confidential transactions."@en ;
    rdfs:subClassOf ngm:cryptographic-primitive ;
    vc:bridgesTo ngm:ai-agent-system,
        ngm:verifiable-credential ;
    vc:contrastsWith ngm:digital-signature,
        ngm:encryption ;
    vc:dependsOn ngm:discrete-logarithm-problem,
        ngm:random-oracle-model ;
    vc:enables ngm:atomic-swap,
        ngm:confidential-transaction,
        ngm:cryptographic-protocol,
        ngm:immutability,
        ngm:secure-multiparty-computation,
        ngm:zk-snarks,
        ngm:zk-starks ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:polynomial-commitment,
        ngm:vector-commitment ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:coin-flipping-protocol,
        ngm:digital-signature,
        ngm:merkle-tree,
        ngm:oblivious-transfer,
        ngm:schnorr-signature,
        ngm:zero-knowledge ;
    vc:requires ngm:binding-property,
        ngm:hiding-property ;
    vc:slug "cryptographic-commitment" ;
    vc:sourceDomain "security" ;
    vc:supports ngm:blockchain,
        ngm:smart-contract ;
    vc:uses ngm:cryptographic-hash-function,
        ngm:elliptic-curve-cryptography,
        ngm:hash-function,
        ngm:pedersen-commitment,
        ngm:zero-knowledge-proof .

ngm:data-provenance a owl:Class ;
    rdfs:label "Data Provenance"@en ;
    rdfs:comment "A continuous process of recording and tracking the origin, lineage, and transformation history of data objects, enabling traceability, validation of data quality, and verification of authenticity throughout the data lifecycle."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:timestamp-authority ],
        [ a owl:Restriction ;
