    vc:slug "blockchain" ;
    vc:sourceDomain "blockchain" .

ngm:smart-contract a owl:Class ;
    rdfs:label "Smart Contract"@en ;
    rdfs:comment "A Smart Contract is a self-executing digital program deployed on a blockchain that encodes contractual terms, business logic, and state-transition rules directly in code, automatically enforcing obligations when predetermined on-chain conditions are satisfied without requiring trusted interme..."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
