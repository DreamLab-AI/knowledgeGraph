    vc:dependsOn ngm:slashing ;
    vc:enables ngm:economic-security ;
    vc:enables ngm:settlement-finality ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:slashing ;
    vc:hasPart ngm:staking ;
    vc:qualityScore "0.62"^^xsd:float ;
