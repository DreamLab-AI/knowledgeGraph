ngm:user-directory a owl:Class ;
    rdfs:label "User Directory"@en ;
    rdfs:comment "A user directory is a centralised repository that stores and organises identity records, attributes and credentials for the principals of a system, supporting authentication and authorisation queries. Common implementations include LDAP directories, Active Directory and cloud identity stores, which identity providers consume to validate and describe users. It is a core component of identity and access management infrastructure."@en ;
    rdfs:subClassOf ngm:identity-management ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:identity-provider,
        ngm:identity-provider-id-p ;
    vc:slug "user-directory" ;
    vc:sourceDomain "security" .

ngm:user-monitoring a owl:Class ;
    rdfs:label "User Monitoring"@en ;
    rdfs:comment "User monitoring is the observation and logging of user behaviour and interactions within a platform to detect policy violations, abuse, safety risks or anomalous activity. In metaverse and online environments it supports trust-and-safety enforcement and agreement compliance, balancing protective oversight against privacy and consent. It typically feeds moderation, incident response and compliance reporting workflows."@en ;
    rdfs:subClassOf ngm:sc-governance-and-safety ;
    skos:broader ngm:sc-governance-and-safety ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:metaverse-safety-protocol,
        ngm:user-agreement-compliance ;
    vc:slug "user-monitoring" ;
    vc:sourceDomain "governance" .

ngm:user-sovereignty a owl:Class ;
    rdfs:label "User Sovereignty"@en ;
    rdfs:comment "User sovereignty is the principle that individuals should control their own data, identity, and assets rather than depending on intermediaries. It is associated with decentralised systems and privacy advocacy."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptography ],
        ngm:digital-rights ;
    vc:enables ngm:privacy ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:cryptography ;
    vc:slug "user-sovereignty" ;
    vc:sourceDomain "governance" .

ngm:user-trust a owl:Class ;
    rdfs:label "User Trust"@en ;
    rdfs:comment "User trust is the confidence individuals place in a system to handle their data, decisions and interactions reliably, securely and in their interests. It is built through transparency, predictable behaviour, privacy safeguards and demonstrable accountability, and is a key outcome of privacy and data-protection practices. Eroded trust undermines adoption, while sustained trust is a competitive and ethical asset."@en ;
    rdfs:subClassOf ngm:ai-governance-and-ethics ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:data-protection,
        ngm:privacy-impact-assessment-pia ;
    vc:slug "user-trust" ;
    vc:sourceDomain "governance" .

ngm:validation-constraints a owl:Class ;
    rdfs:label "Validation Constraints"@en ;
    rdfs:comment "Validation constraints are the formally specified rules that data or metadata must satisfy to be considered valid against a schema, covering datatypes, cardinality, value ranges, required fields and structural relationships. Expressed through languages such as SHACL, JSON Schema or XSD, they let systems automatically verify conformance and reject malformed input. They are an integral part of metadata standards and ontology schemas."@en ;
    rdfs:subClassOf ngm:data-management ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:metadata-standard,
        ngm:metaverse-ontology-schema ;
    vc:slug "validation-constraints" ;
    vc:sourceDomain "data" .

ngm:validator-selection a owl:Class ;
    rdfs:label "Validator Selection"@en ;
    rdfs:comment "Validator selection is the consensus mechanism by which a proof-of-stake blockchain chooses which staked participants are eligible to propose and attest to blocks in a given slot or epoch. It typically uses stake-weighted, often pseudo-randomised sampling to assign block production while preserving security and decentralisation. The design directly affects fairness, finality, energy efficiency and resistance to manipulation."@en ;
    rdfs:subClassOf ngm:proof-of-stake ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:proof-of-stake-sustainability,
        ngm:testnet ;
    vc:slug "validator-selection" ;
    vc:sourceDomain "blockchain" .

ngm:vc-dimension a skos:Concept ;
    rdfs:label "Vc Dimension"@en .

ngm:vector-commitment a owl:Class ;
    rdfs:label "Vector Commitment"@en ;
    rdfs:comment "A vector commitment is a cryptographic primitive that produces a short, binding commitment to an ordered sequence of values such that the committer can later open any individual position with a compact proof of its value. It is position-binding, meaning one cannot produce valid openings of two different values at the same index, and it supports succinct membership and update proofs. Vector commitments generalise Merkle trees and underpin verifiable databases, stateless blockchains and proof systems."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:merkle-proof ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptographic-commitment ],
        ngm:commitment-scheme ;
    vc:bridgesTo ngm:verifiable-computation ;
    vc:contrastsWith ngm:merkle-tree ;
    vc:dependsOn ngm:zero-knowledge ;
    vc:enables ngm:merkle-proof,
        ngm:verifiable-computation ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:merkle-proof ;
    vc:implements ngm:commitment-scheme ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:merkle-tree,
        ngm:polynomial-commitment ;
    vc:requires ngm:cryptographic-commitment ;
    vc:slug "vector-commitment" ;
    vc:sourceDomain "security" ;
