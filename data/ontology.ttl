        <urn:visionflow:linked:sanctions-screening>,
        <urn:visionflow:linked:transfer-impact-assessment>,
        vf:privacy-impact-assessment ;
    vc:slug "cross-border-compliance" ;
    vc:sourceDomain "regulation" .

