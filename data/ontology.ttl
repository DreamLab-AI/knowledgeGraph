    owl:onProperty infrastructure:enables ;
    owl:someValuesFrom spatial-computing:PreciseSpatialPositioning
] .

# Spatial Tracking
spatial-computing:SpatialTracking rdf:type owl:Class ;
    rdfs:subClassOf spatial-computing:MotionTracking ;
    rdfs:label "Spatial Tracking"@en ;
    rdfs:comment "Technology that determines the position and orientation of objects in three-dimensional space using six degrees of freedom (6DoF), enabling precise tracking of headsets, controllers, and body movements through inside-out or outside-in sensor configurations."@en ;
    skos:prefLabel "Spatial Tracking"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:spatial-computing:spatial-tracking" ;
