ngm:waveguide-optics a owl:Class ;
    rdfs:label "Waveguide Optics"@en ;
    rdfs:comment "Waveguide optics is the optical-engineering approach used in augmented- and mixed-reality displays to channel projected light from a microdisplay into the user's eye via total internal reflection in a thin transparent substrate. Diffractive, reflective, or holographic gratings couple light in and out, enabling compact, see-through eyewear with a wide eyebox. It is the dominant optical architecture for consumer AR glasses, trading manufacturing complexity for form factor and transparency."@en ;
    rdfs:subClassOf ngm:sc-display-and-rendering ;
    skos:broader ngm:sc-display-and-rendering ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:ar-frame,
        ngm:mixed-reality ;
    vc:slug "waveguide-optics" ;
    vc:sourceDomain "metaverse" .

ngm:wearable-computing-platform a owl:Class ;
    rdfs:label "Wearable Computing Platform"@en ;
    rdfs:comment "Hardware and software ecosystems for body-worn computing devices including smartwatches, smart glasses, fitness trackers, and XR headsets, providing operating systems, development frameworks, and connectivity infrastructure for continuous personal computing and metaverse interaction."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
