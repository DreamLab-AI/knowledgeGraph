ngm:linked-data a owl:Class ;
    rdfs:label "Linked Data"@en ;
    rdfs:comment "Linked Data is a collection of design principles articulated by Tim Berners-Lee for publishing machine-readable structured data on the Web, requiring that entities be identified by HTTP URIs, that those URIs resolve to useful descriptions in RDF, and that descriptions include links to other URIs so that data from different sources can be traversed and aggregated into a global information graph. It constitutes the application layer of the Semantic Web stack and provides the architectural foundation for open knowledge graphs such as Wikidata and DBpedia. Linked Data sits above the RDF data model and is typically queried using SPARQL endpoints."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:rdf ],
        ngm:infra-data-management,
        ngm:semantic-web ;
    skos:broader ngm:infra-data-management ;
    vc:enables ngm:knowledge-graph,
        ngm:knowledge-graph-construction ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:requires ngm:rdf ;
    vc:slug "linked-data" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:json-ld-1-1,
        ngm:sparql .

ngm:w3-c a owl:Class ;
    rdfs:label "W3C"@en ;
    rdfs:comment "The World Wide Web Consortium (W3C) is the principal international standards organisation for the World Wide Web, founded by Tim Berners-Lee in 1994 and operating through a global membership model to develop open, interoperable web standards. W3C produces technical specifications, guidelines, and software that define the core technologies of the web including HTML, CSS, SVG, XML, RDF, and the semantic web stack. Its standards process emphasises consensus, royalty-free licensing, and broad implementability across browsers and platforms."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:verifiable-credential-standard ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:w3-c-did-core ],
        ngm:standards-body ;
    vc:enables ngm:accessibility,
        ngm:interoperability,
        ngm:interoperability-standard ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:verifiable-credential-standard,
