    vc:uses ngm:rasterization .

ngm:stablecoin a owl:Class ;
    rdfs:label "Stablecoin"@en ;
    rdfs:comment "A cryptocurrency whose value is algorithmically or institutionally pegged to a reserve asset to maintain price stability, enabling reliable medium of exchange and store of value in virtual economies."@en ;
