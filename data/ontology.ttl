# Manipulator Arm
spatial-computing:ManipulatorArm rdf:type owl:Class ;
    rdfs:label "Manipulator Arm"@en ;
    rdfs:comment "A multi-jointed mechanical or virtual robotic arm integrated with avatars or immersive systems to enable precise object manipulation and physical interaction within virtual or mixed reality environments through control systems, haptic feedback, and inverse kinematics algorithms. Manipulator arms combine robotics hardware (mechanical joints, actuators, end-effectors), computer vision guidance, and AI-driven control enabling naturalistic manipulation and grasping in XR applications, exemplified by the Avatarm system enabling remote physical object manipulation whilst maintaining immersive virtual presence, and deployed in surgical robotics, laboratory automation, pick-and-place operations, and immersive training simulators addressing challenges around latency, haptic feedback fidelity, and standardised interfaces for physical-virtual interaction."@en ;
    skos:prefLabel "Manipulator Arm"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:spatial-computing:manipulator-arm" ;
    owl:sameAs <urn:visionclaw:concept:spatial-computing:manipulator-arm> ;
    vcw:contentHash "sha256-12-6a9eaa61ccde" ;
    vcw:qualityScore "0.4"^^xsd:decimal ;
    vcw:legacyTermId "MV-3013" ;
    vcw:ontologyStatus "draft" ;
    vcw:maturityLevel "draft" ;
    vcw:authorityScore "0.0"^^xsd:decimal ;
    dcterms:identifier "MV-3013" ;
    dcterms:subject "spatial-computing" ;
    owl:versionInfo "2.0.0" ;
    dcterms:created "2026-04-26T00:00:00Z"^^xsd:dateTime ;
    dcterms:modified "2026-04-26T13:00:00Z"^^xsd:dateTime ;
    vcw:owlRole "Concept" .

# Data Pipeline
infrastructure:DataPipeline rdf:type owl:Class ;
    rdfs:label "Data Pipeline"@en ;
    rdfs:comment "A series of connected data processing stages orchestrating Data Ingestion, Data Transformation, Quality Assurance, and Data Delivery to produce actionable analytical outputs. Data pipelines implement ETL Patterns, Data Validation, Error Handling, and Monitoring to ensure Data Reliability and Availability."@en ;
    skos:prefLabel "Data Pipeline"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:infrastructure:data-pipeline" ;
    owl:sameAs <urn:visionclaw:concept:infrastructure:data-pipeline> ;
