    dcterms:modified "2026-04-26T13:00:00Z"^^xsd:dateTime ;
    vcw:owlRole "Concept" .

# Communication Theory
distributed-collaboration:CommunicationTheory rdf:type owl:Class ;
    rdfs:subClassOf distributed-collaboration:Telecollaboration ;
    rdfs:label "Communication Theory"@en ;
    rdfs:comment "Communication Theory provides the theoretical foundations for understanding how information, meaning, and social presence are transmitted and perceived in mediated communication contexts. Key frameworks include media richness theory, social presence theory, and theories of computer-mediated communication that inform the design of telecollaboration systems."@en ;
    skos:prefLabel "Communication Theory"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:distributed-collaboration:communication-theory" ;
    owl:sameAs <urn:visionclaw:concept:distributed-collaboration:communication-theory> ;
    vcw:contentHash "sha256-12-feca62dcaccc" ;
    vcw:qualityScore "0.35"^^xsd:decimal ;
    vcw:legacyTermId "TC-0604" ;
    vcw:ontologyStatus "active" ;
    vcw:maturityLevel "draft" ;
    vcw:authorityScore "0.0"^^xsd:decimal ;
    dcterms:identifier "TC-0604" ;
    dcterms:subject "distributed-collaboration" ;
    owl:versionInfo "2.0.0" ;
    dcterms:created "2026-04-26T00:00:00Z"^^xsd:dateTime ;
    dcterms:modified "2026-04-26T13:00:00Z"^^xsd:dateTime ;
    vcw:owlRole "Concept" .

# Immersive Communication
distributed-collaboration:ImmersiveCommunication rdf:type owl:Class ;
    rdfs:subClassOf distributed-collaboration:Telecollaboration ;
    rdfs:label "Immersive Communication"@en ;
    rdfs:comment "Immersive Communication refers to communication systems and experiences that leverage extended reality (XR) technologies to create highly engaging, spatially-aware interaction environments. This includes VR meetings, AR collaboration tools, spatial audio conferencing, and mixed reality communication platforms that transcend traditional 2D video interfaces."@en ;
    skos:prefLabel "Immersive Communication"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:distributed-collaboration:immersive-communication" ;
    owl:sameAs <urn:visionclaw:concept:distributed-collaboration:immersive-communication> ;
    vcw:contentHash "sha256-12-a2d3b781f50f" ;
    vcw:qualityScore "0.35"^^xsd:decimal ;
    vcw:legacyTermId "TC-0605" ;
    vcw:ontologyStatus "active" ;
    vcw:maturityLevel "draft" ;
    vcw:authorityScore "0.0"^^xsd:decimal ;
    dcterms:identifier "TC-0605" ;
    dcterms:subject "distributed-collaboration" ;
    owl:versionInfo "2.0.0" ;
    dcterms:created "2026-04-26T00:00:00Z"^^xsd:dateTime ;
    dcterms:modified "2026-04-26T13:00:00Z"^^xsd:dateTime ;
    vcw:owlRole "Concept" .

# Virtual Reality Telepresence
distributed-collaboration:VirtualRealityTelepresence rdf:type owl:Class ;
    rdfs:subClassOf distributed-collaboration:TELE001telepresence ;
    rdfs:label "Virtual Reality Telepresence"@en ;
    rdfs:comment "\"The use of virtual reality head-mounted displays and immersive 3D environments to enable remote participants to experience shared virtual spaces with stereoscopic vision, spatial audio, head tracking, and avatar embodiment, creating a subjective sense of co-location despite geographical separation.\""@en ;
    skos:prefLabel "Virtual Reality Telepresence"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:distributed-collaboration:virtual-reality-telepresence" ;
    owl:sameAs <urn:visionclaw:concept:distributed-collaboration:virtual-reality-telepresence> ;
    vcw:contentHash "sha256-12-2b91dea23b1f" ;
    vcw:qualityScore "0.5"^^xsd:decimal ;
    vcw:legacyTermId "TC-4000" ;
    vcw:ontologyStatus "active" ;
    vcw:maturityLevel "developing" ;
    vcw:authorityScore "0.0"^^xsd:decimal ;
    dcterms:identifier "TC-4000" ;
    dcterms:subject "distributed-collaboration" ;
    owl:versionInfo "2.0.0" ;
    dcterms:created "2026-04-26T00:00:00Z"^^xsd:dateTime ;
    dcterms:modified "2026-04-26T13:00:00Z"^^xsd:dateTime ;
    vcw:owlRole "Object" .

distributed-collaboration:VirtualRealityTelepresence rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty infrastructure:requires ;
    owl:someValuesFrom distributed-collaboration:TELE110spatialaudioprocessing
] .

distributed-collaboration:VirtualRealityTelepresence rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty infrastructure:enables ;
    owl:someValuesFrom distributed-collaboration:RemoteDesignReview
] .

# Networkcomponent
distributed-collaboration:Networkcomponent rdf:type owl:Class ;
    rdfs:label "Networkcomponent"@en ;
    rdfs:comment "Network Components are the physical and virtual hardware devices that comprise telecommunications and computer network infrastructure, enabling network connectivity, communication, and data routing between users, devices, applications, and the internet. Core components include switches for local traffic routing, routers for inter-network packet forwarding, and firewalls for security enforcement, forming the foundation of modern digital communications."@en ;
    skos:prefLabel "Networkcomponent"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:distributed-collaboration:networkcomponent" ;
    owl:sameAs <urn:visionclaw:concept:distributed-collaboration:networkcomponent> ;
    vcw:contentHash "sha256-12-8f2219f3abb7" ;
    vcw:qualityScore "0.5"^^xsd:decimal ;
    vcw:legacyTermId "TC-7000" ;
    vcw:ontologyStatus "active" ;
    vcw:maturityLevel "reviewed" ;
    vcw:authorityScore "0.0"^^xsd:decimal ;
    dcterms:identifier "TC-7000" ;
    dcterms:subject "distributed-collaboration" ;
    owl:versionInfo "2.0.0" ;
    dcterms:created "2026-04-26T00:00:00Z"^^xsd:dateTime ;
    dcterms:modified "2026-04-26T13:00:00Z"^^xsd:dateTime ;
    vcw:owlRole "Concept" .

# Network Protocol
distributed-collaboration:NetworkProtocol rdf:type owl:Class ;
    rdfs:label "Network Protocol"@en ;
    rdfs:comment "A network protocol is a set of established rules that specify how to format, send, and receive data between networked devices, enabling diverse communication systems to interact using standard procedures. Protocols are organized into layered architectures such as the OSI model (7 layers) and TCP/IP model (4 layers), each layer handling specific aspects of network communication."@en ;
    skos:prefLabel "Network Protocol"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:distributed-collaboration:network-protocol" ;
    owl:sameAs <urn:visionclaw:concept:distributed-collaboration:network-protocol> ;
    vcw:contentHash "sha256-12-7e2e38dac200" ;
    vcw:qualityScore "0.5"^^xsd:decimal ;
    vcw:legacyTermId "TC-7001" ;
    vcw:ontologyStatus "active" ;
    vcw:maturityLevel "reviewed" ;
    vcw:authorityScore "0.0"^^xsd:decimal ;
    dcterms:identifier "TC-7001" ;
    dcterms:subject "distributed-collaboration" ;
    owl:versionInfo "2.0.0" ;
    dcterms:created "2026-04-26T00:00:00Z"^^xsd:dateTime ;
    dcterms:modified "2026-04-26T13:00:00Z"^^xsd:dateTime ;
    vcw:owlRole "Standard" .

distributed-collaboration:NetworkProtocol rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty infrastructure:enables ;
    owl:someValuesFrom distributed-collaboration:NetworkCommunication
] .

