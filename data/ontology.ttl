ngm:ieee a owl:Class ;
    rdfs:label "IEEE"@en ;
    rdfs:comment "The Institute of Electrical and Electronics Engineers (IEEE) is the world's largest technical professional organisation, comprising over 400,000 members across 160 countries, whose Standards Association (IEEE SA) develops and maintains more than 1,300 active standards governing electrical engineering, electronics, telecommunications, computer science, and emerging disciplines including artificial intelligence and autonomous systems. IEEE standards define foundational networking protocols such as IEEE 802.11 (Wi-Fi), IEEE 802.3 (Ethernet), and IEEE 802.15.4 (low-power wireless), as well as critical infrastructure specifications including IEEE 754 (floating-point arithmetic) and IEEE 1588 (Precision Time Protocol). The organisation conducts standards development through consensus-based volunteer working groups spanning industry, academia, and government, and publishes its technical library via IEEE Xplore. IEEE has expanded into AI ethics (IEEE 7000 series), autonomous vehicles, quantum computing, and neural interfaces, making it a primary governance body across both traditional and emerging technology domains."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:ieee-standards-association ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:ieee-802-15-4 ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:ieee-802-11 ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:ieee-802-3 ],
        ngm:standards-body ;
    vc:bridgesTo ngm:ai-governance,
        ngm:neural-interface,
        ngm:post-quantum-cryptography ;
    vc:enables ngm:interoperability-standard,
        ngm:open-standard,
        ngm:technical-standards,
        ngm:time-sensitive-networking,
        ngm:wireless-networking ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:ieee-1588,
        ngm:ieee-754,
        ngm:ieee-802-11,
        ngm:ieee-802-15-4,
        ngm:ieee-802-3,
        ngm:ieee-standards-association ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:3gpp,
        ngm:ansi,
        ngm:ietf,
        ngm:iso,
