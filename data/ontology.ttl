    vc:slug "cognitive-psychology" ;
    vc:sourceDomain "ai" .

ngm:coinbase a owl:Class ;
    rdfs:label "Coinbase"@en ;
    rdfs:comment "Coinbase is a publicly traded United States cryptocurrency exchange, custody, and financial services company founded in 2012 by Brian Armstrong and Fred Ehrsam. It provides retail and institutional trading, custodial and self-custody wallet services, staking, lending, and payment infrastructure, operating as one of the most regulated crypto platforms in the United States. The company completed a direct listing on Nasdaq in April 2021, becoming the first major cryptocurrency exchange to go public in the US. Beyond exchange operations, Coinbase develops the Base layer-2 network (built on the OP Stack), offers a developer platform for on-chain applications, and provides institutional prime brokerage services."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptographic-key-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:regulatory-compliance ],
        ngm:digital-asset ;
    vc:bridgesTo ngm:securities-regulation,
        ngm:traditional-finance ;
    vc:contrastsWith ngm:binance,
        ngm:decentralised-exchange,
        ngm:kraken ;
    vc:dependsOn ngm:blockchain,
        ngm:public-key-infrastructure ;
    vc:enables ngm:cryptocurrency-trading,
        ngm:decentralised-finance,
        ngm:digital-asset-custody,
        ngm:staking ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:base-network,
        ngm:coinbase-custody,
        ngm:coinbase-prime,
        ngm:coinbase-wallet ;
    vc:implements ngm:know-your-customer,
        ngm:proof-of-stake ;
    vc:qualityScore "0.73"^^xsd:float ;
    vc:relatedTo ngm:centralised-exchange,
        ngm:layer-2-scaling,
        ngm:optimism ;
    vc:requires ngm:blockchain-wallet,
        ngm:cryptographic-key-management,
        ngm:regulatory-compliance ;
    vc:slug "coinbase" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:ethereum,
        ngm:op-stack,
        ngm:smart-contract .

ngm:collaborative-learning a skos:Concept ;
    rdfs:label "Collaborative Learning"@en .

ngm:collaborative-systems-modality-technology a owl:Class ;
    rdfs:label "Collaborative Technology"@en ;
    rdfs:comment "Collaborative Technology encompasses the hardware, software, protocols, and infrastructure components that enable distributed teams to work together effectively across time and space. This includes real-time media processing, synchronisation protocols, edge computing for latency reduction, and zero-trust security models forming the technological substrate of telecollaboration."@en ;
    rdfs:subClassOf ngm:infra-computing-and-cloud ;
    skos:broader ngm:infra-computing-and-cloud ;
