ngm:industrial-automation a owl:Class ;
    rdfs:label "IndustrialAutomation"@en ;
    rdfs:comment "Industrial automation is the application of control systems—including programmable logic controllers (PLCs), distributed control systems (DCS), and robotic manipulators—along with information technologies to operate industrial processes and machinery with minimal or no human intervention. It spans discrete manufacturing (assembly lines, packaging, welding) and process industries (chemical plants, oil refineries, power generation), increasing throughput, consistency, and safety by removing humans from hazardous environments. Industrial automation integrates mechanical, electrical, and software engineering disciplines and is increasingly augmented by machine vision, collaborative robots, and AI-driven process optimisation."@en ;
    rdfs:subClassOf ngm:robo-robot-type ;
    skos:broader ngm:robo-robot-type ;
    vc:enables ngm:industrial-io-t,
        ngm:predictive-maintenance ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:digital-twin,
        ngm:real-time-processing ;
    vc:slug "industrial-automation" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:actuator,
        ngm:control-system .

ngm:iso-10218 a owl:Class ;
    rdfs:label "ISO 10218"@en ;
    rdfs:comment "ISO 10218 is a two-part international safety standard published by the International Organisation for Standardisation that specifies requirements for the design, construction, and safeguarding of industrial robots and robot systems. Part 1 addresses the robot itself and requires manufacturers to conduct risk assessments and implement safety-rated stop functions, speed and force limitation, and workspace monitoring. Part 2 addresses the integration of robots into workcells, covering safety-rated control functions, safeguarding devices, and the responsibilities of system integrators."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:human-robot-interaction ],
        ngm:robo-safety-and-standards ;
    skos:broader ngm:robo-safety-and-standards ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:functional-safety,
        ngm:iso-ts-15066,
        ngm:risk-assessment ;
    vc:requires ngm:human-robot-interaction ;
    vc:slug "iso-10218" ;
    vc:sourceDomain "robotics" ;
    vc:supports ngm:collaborative-robot,
        ngm:robot-safety .

