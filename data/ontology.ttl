] .

# Virtual Network
mv:VirtualNetwork a owl:Class ;
    rdfs:subClassOf mv:NetworkInfrastructure ;
    rdfs:label "Virtual Network"@en ;
    rdfs:comment "A software-defined network infrastructure that creates logical network segments over physical hardware, enabling isolated, configurable communication channels for metaverse platforms, cloud services, and distributed applications through technologies like VLANs, VPNs, and network slicing."@en ;
    skos:prefLabel "Virtual Network"@en ;
    dcterms:identifier "MV-10133" ;
