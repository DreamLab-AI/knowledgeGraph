        ngm:key-ceremony,
        ngm:pay-to-script-hash,
        ngm:schnorr-signature,
        ngm:threshold-signature-scheme ;
    vc:requires ngm:digital-signature,
        ngm:key-management ;
    vc:slug "multi-signature" ;
    vc:sourceDomain "blockchain" ;
    vc:standardizedBy ngm:bitcoin-proof-of-work-protocol-improvement-proposals,
