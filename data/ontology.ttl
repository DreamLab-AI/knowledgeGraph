ngm:direct-preference-optimisation a owl:Class ;
    rdfs:label "Direct Preference Optimisation"@en ;
    rdfs:comment "An alignment mod that directly uses preference data to fine-tune language models without training a separate reward model or using reinforcement learning, offering a simpler alternative to RLHF."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:preference-learning ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:large-language-models ],
        ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:contrastsWith ngm:reinforcement-learning-from-human-feedback ;
    vc:enables ngm:ai-alignment,
        ngm:fine-tuning ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires ngm:large-language-models,
        ngm:preference-learning ;
    vc:slug "direct-preference-optimisation" ;
    vc:sourceDomain "spatial-computing" .

ngm:directory-service a owl:Class ;
    rdfs:label "Directory Service"@en ;
    rdfs:comment "A directory service is a specialised database that stores, organises, and provides access to information about the entities of a network — users, groups, devices, and services — optimised for high-volume reads and hierarchical lookup. Accessed through protocols such as LDAP, it underpins authentication, authorisation, and resource discovery in enterprise environments, with implementations including Active Directory and OpenLDAP. Directory services centralise identity data so that credentials and access policies can be managed once and enforced consistently across many systems."@en ;
    rdfs:subClassOf ngm:identity-provider ;
    vc:enables ngm:federated-identity ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:decentralized-identity ;
    vc:slug "directory-service" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:network-protocol .

ngm:distributed-protocol a owl:Class ;
    rdfs:label "Distributed Protocol"@en ;
    rdfs:comment "A Distributed Protocol is a formally specified set of rules, message formats, and procedures governing communication, coordination, and state synchronization among independent nodes in a distributed network without centralized control."@en ;
    rdfs:subClassOf ngm:bc-protocol-and-consensus ;
    skos:broader ngm:bc-protocol-and-consensus ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:blockchain-entity ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:slug "distributed-protocol" ;
    vc:sourceDomain "blockchain" .

ngm:distributed-system-protocol a owl:Class ;
    rdfs:label "Distributed System Protocol"@en ;
    rdfs:comment "A Distributed System Protocol defines the communication and coordination mechanisms enabling distributed nodes to achieve collective functionality through standardised message formats, state synchronisation procedures, and failure recovery mechanisms. Such protocols underpin blockchain networks, peer-to-peer systems, and consensus-based infrastructure through gossip dissemination, leader election, distributed hash tables, and inter-node authentication channels."@en ;
    rdfs:subClassOf ngm:infra-network-and-comms,
        ngm:protocol-layer ;
    skos:broader ngm:infra-network-and-comms ;
    vc:enables ngm:blockchain-network,
        ngm:distributed-system ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:implements ngm:communication-protocol,
        ngm:consensus-protocol ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:distributed-ledger-technology ;
    vc:slug "distributed-system-protocol" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:cryptographic-protocol,
        ngm:network-infrastructure .

ngm:distributed-team-collaboration a owl:Class ;
    rdfs:label "Distributed Team Collaboration"@en ;
    rdfs:comment "Distributed team collaboration encompasses the practices, tools, and organisational patterns that enable geographically dispersed individuals working across multiple time zones to coordinate effectively on shared goals without co-location. It integrates asynchronous communication protocols, synchronous video conferencing, shared digital workspaces, version-controlled artefacts, and social norms around documentation and decision-making transparency to replicate — and often surpass — the coordination bandwidth of co-located teams. The discipline has grown from a niche practice of open-source communities and multinational corporations into a mainstream organisational capability following the global shift to remote work accelerated by the 2020 pandemic."@en ;
    rdfs:subClassOf ngm:distributed-collaboration ;
    skos:broader ngm:distributed-collaboration ;
    vc:enables ngm:synchronous-collaboration,
        ngm:telecollaboration ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:asynchronous-collaboration,
        ngm:remote-collaboration,
        ngm:remote-work ;
    vc:slug "distributed-team-collaboration" ;
    vc:sourceDomain "governance" ;
    vc:uses ngm:asynchronous-communication,
        ngm:collaboration-platform,
        ngm:realtime-communication .

ngm:do-178-c a owl:Class ;
    rdfs:label "DO-178C"@en ;
    rdfs:comment "DO-178C (Software Considerations in Airborne Systems and Equipment Certification) is the primary international standard governing the development and certification of airborne software, published by RTCA in 2011 as the successor to DO-178B. It defines five software levels (A through E) based on failure severity, each requiring progressively more rigorous development assurance activities including requirements traceability, structural coverage testing, and independence in reviews. Compliance with DO-178C is required by aviation regulatory authorities (FAA, EASA) for software installed in certified aircraft."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:formal-verification ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:software-testing ],
        ngm:safety-standard ;
    vc:enables ngm:embedded-systems,
        ngm:quality-assurance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:functional-safety,
        ngm:iec-61508,
        ngm:iso-26262 ;
    vc:requires ngm:formal-verification,
        ngm:software-testing ;
    vc:slug "do-178-c" ;
    vc:sourceDomain "infrastructure" .

ngm:dynamic-model a owl:Class ;
    rdfs:label "Dynamic Model"@en ;
    rdfs:comment "A Dynamic Model is a mathematical or computational representation of a system that explicitly captures how the system's state evolves over time in response to inputs, internal dynamics, and disturbances. Distinguished from static models by their time-varying state equations—typically differential equations for continuous systems or recurrence relations for discrete systems—dynamic models are fundamental to control engineering, physics simulation, robotics, and economic forecasting. They may be physics-derived from first principles, identified from data using system identification techniques, or learned end-to-end from observations using neural networks."@en ;
    rdfs:subClassOf ngm:simulation ;
    vc:enables ngm:cyber-physical-systems,
        ngm:model-based-control,
        ngm:simulation-engine ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:digital-twin,
        ngm:physics-simulation,
        ngm:probabilistic-model,
        ngm:world-model ;
    vc:slug "dynamic-model" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:bayesian-inference,
        ngm:state-machine .

ngm:eclipse-attack a owl:Class ;
    rdfs:label "Eclipse Attack"@en ;
    rdfs:comment "An Eclipse Attack is a peer-to-peer network attack in which an adversary monopolises all of a target node's inbound and outbound connections, isolating it from the honest network. The eclipsed node is fed a fabricated view of the blockchain, enabling the attacker to double-spend against that node, delay its transaction confirmations, or waste its mining resources on a private fork. Countermeasures include connection diversity, random peer selection, and detecting network-level routing anomalies."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:sybil-attack ],
        ngm:bc-protocol-and-consensus,
        ngm:blockchain-entity,
        ngm:network-component ;
    skos:broader ngm:bc-protocol-and-consensus ;
    vc:contrastsWith ngm:byzantine-fault-tolerance,
        ngm:network-synchronization ;
    vc:enables ngm:double-spending ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:51-attack,
        ngm:blockchain-protocol,
        ngm:network-topology,
        ngm:peer-to-peer-network,
        ngm:selfish-mining ;
    vc:requires ngm:sybil-attack ;
    vc:slug "eclipse-attack" ;
    vc:sourceDomain "blockchain" .

ngm:economics-domain a owl:Class ;
    rdfs:label "Economics Domain"@en ;
    rdfs:comment "The Economics Domain classifies concepts concerned with how agents allocate scarce resources and how incentives shape behaviour and outcomes. It covers micro and macro analysis, market structure, monetary phenomena, and the token economics that arise in ledger-based systems. As a top-level subject classification, it scopes the analytical study of allocation and incentives rather than the design of specific mechanisms."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:macroeconomics ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:monetary-theory ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:game-theory ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:token-economics ],
        ngm:owl-thing ;
    vc:enables ngm:incentive-analysis,
        ngm:policy-evaluation,
        ngm:resource-allocation ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:game-theory,
        ngm:macroeconomics,
        ngm:microeconomics,
        ngm:monetary-theory,
        ngm:token-economics ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:incentive-structure,
        ngm:market-participants ;
    vc:slug "economics-domain" ;
    vc:sourceDomain "economics" .

ngm:edge-gateway a owl:Class ;
    rdfs:label "Edge Gateway"@en ;
    rdfs:comment "An edge gateway is a network device or software component deployed at the boundary between a local edge environment and wider network infrastructure—such as the internet or a cloud backend—that performs protocol translation, security enforcement, traffic routing, and local data preprocessing before forwarding selected data to upstream systems. Edge gateways aggregate data from IoT devices, sensors, and local compute nodes, filter and normalise it, enforce access control policies, and reduce bandwidth consumption by processing and compressing data at the point of collection rather than transmitting raw streams to the cloud. They are essential components of edge computing architectures in industrial IoT, smart cities, autonomous systems, and distributed XR infrastructure."@en ;
    rdfs:subClassOf ngm:edge-computing-node ;
    vc:enables ngm:edge-orchestration,
        ngm:internet-of-things ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:content-delivery-network,
        ngm:edge-computing-architecture,
        ngm:edge-network ;
    vc:slug "edge-gateway" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:api-gateway,
        ngm:edge-computing,
        ngm:network-protocol,
        ngm:network-security .

ngm:education-metaverse a owl:Class ;
    rdfs:label "Education Metaverse"@en ;
    rdfs:comment "A virtual platform that provides immersive educational experiences through interconnected digital learning environments, enabling collaborative instruction, skills development, and knowledge transfer across distributed participants."@en ;
