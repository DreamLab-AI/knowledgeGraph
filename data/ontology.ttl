ngm:compliance-audit-trail a owl:Class ;
    rdfs:label "Compliance Audit Trail"@en ;
    rdfs:comment "Immutable record system demonstrating adherence to policies and regulations through cryptographically sealed logs of compliance verification activities and evidence."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptographic-hash ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:access-control ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:timestamp ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:policy-engine ],
        ngm:ai-governance-and-ethics ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:enables ngm:accountability,
        ngm:compliance-verification,
