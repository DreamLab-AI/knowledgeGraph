        ngm:hyperparameter,
        ngm:information-theory,
        ngm:machine-learning-discipline,
        ngm:reinforcement-learning ;
    vc:requires ngm:probabilistic-inference,
        ngm:surrogate-model ;
    vc:slug "acquisition-function" ;
    vc:sourceDomain "ai" ;
    vc:supports ngm:auto-ml,
