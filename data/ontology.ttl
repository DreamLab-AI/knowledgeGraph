            owl:someValuesFrom ngm:smart-contract ],
        ngm:bc-token-and-asset,
        ngm:virtual-economy ;
    skos:broader ngm:bc-token-and-asset ;
    vc:enables ngm:automated-royalty-distribution,
        ngm:creator-compensation,
        ngm:fan-investment,
