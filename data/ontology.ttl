    vc:slug "level-of-detail" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:metaverse,
        ngm:performance-optimization,
        ngm:virtual-reality ;
    vc:uses ngm:rasterization,
        ngm:shader .

ngm:natural-language-understanding a owl:Class ;
    rdfs:label "Natural Language Understanding"@en ;
    rdfs:comment "Natural Language Understanding (NLU) is the subfield of Natural Language Processing dedicated to enabling machines to comprehend the meaning, intent, and pragmatic context of human language input beyond surface-level syntax. Core NLU tasks include semantic role labelling, named entity recognition, coreference resolution, intent classification, relation extraction, and natural language inference, all requiring models to construct structured semantic representations of utterance meaning. Modern NLU systems are predominantly built on large pre-trained Transformer architectures such as BERT and its derivatives, which learn contextualised word representations from massive corpora via self-supervised objectives. NLU serves as the comprehension layer in conversational AI, information extraction pipelines, question answering systems, and dialogue management frameworks."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:semantic-parsing ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:intent-classification ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:coreference-resolution ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:named-entity-recognition ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:relation-extraction ],
        ngm:natural-language-processing ;
    vc:bridgesTo ngm:knowledge-representation,
        ngm:multimodal-ai-architecture-ai ;
    vc:contrastsWith ngm:natural-language-generation ;
    vc:enables ngm:dialogue-management,
