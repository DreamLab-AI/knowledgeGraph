ngm:decision-support a owl:Class ;
    rdfs:label "Decision Support"@en ;
    rdfs:comment "Decision Support refers to the class of information systems, analytical frameworks, and AI-augmented tools designed to improve the quality, speed, and consistency of human or automated decision-making by surfacing relevant data, models, and recommendations at the point of choice. Modern decision support systems integrate structured data from enterprise systems with unstructured signals from documents, sensor streams, and language models to present synthesised options with associated confidence levels and risk profiles. They range from simple rule-based dashboards to sophisticated agentic pipelines that autonomously gather evidence, run simulations, and present ranked courses of action. The field spans domains including clinical medicine, financial trading, military command, supply chain management, and public policy."@en ;
    rdfs:subClassOf ngm:artificial-intelligence-domain ;
    vc:enables ngm:distributed-decision-making,
        ngm:strategic-planning ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:clinical-decision-support,
        ngm:informed-decision-making,
        ngm:predictive-analytics,
        ngm:transparent-decision-making ;
    vc:slug "decision-support" ;
    vc:sourceDomain "ai" ;
    vc:supports ngm:decision-transparency ;
    vc:uses ngm:data-analytics,
        ngm:large-language-models .

ngm:decision-transparency a owl:Class ;
    rdfs:label "Decision Transparency"@en ;
    rdfs:comment "Decision transparency is the property of an AI system whereby the basis, logic, and contributing factors of its outputs are made accessible and comprehensible to relevant stakeholders. It requires that decision processes be traceable — from input data through model architecture to final output — and that explanations be appropriate to the audience, whether technical developers, domain experts, or affected individuals. Decision transparency is a foundational prerequisite for meaningful accountability, contestability, and regulatory compliance in AI deployments."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:interpretability ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:audit-trail ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:explainable-ai ],
        ngm:ai-governance-and-ethics ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:enables ngm:accountability,
        ngm:ai-trustworthiness,
        ngm:algorithmic-accountability ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:ai-ethics,
        ngm:ai-fairness,
        ngm:ai-model-card,
        ngm:algorithmic-transparency-index,
        ngm:human-oversight,
        ngm:model-interpretability,
        ngm:stakeholder-engagement-in-ai ;
    vc:requires ngm:audit-trail,
        ngm:explainable-ai,
        ngm:interpretability ;
    vc:slug "decision-transparency" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:ai-governance,
        ngm:regulatory-compliance,
        ngm:responsible-ai .

ngm:delta-robot a owl:Class ;
    rdfs:label "Delta Robot"@en ;
    rdfs:comment "Delta robot employs parallel kinematics where three or more kinematic chains connect actuators to an end-effector platform, constraining motion through parallelogram linkages to pure translation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:kinematic-chain ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:synchronisation ],
