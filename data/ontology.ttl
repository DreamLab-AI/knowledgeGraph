    vc:isPartOf ngm:encoder-decoder-architecture,
        ngm:transformer-architecture ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires ngm:query-key-value ;
    vc:slug "cross-attention" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:cross-chain-asset-transfer a owl:Class ;
    rdfs:label "Cross Chain Asset Transfer"@en ;
    rdfs:comment "Cross-chain asset transfer is the cryptographic and protocol-level process of moving digital assets — cryptocurrencies, fungible tokens, or non-fungible tokens — from one blockchain network to a distinct, independent blockchain network while preserving the asset's economic properties and enforcing integrity guarantees across the transfer. Because independent blockchains maintain no shared global state, protocols must ensure that an asset locked or burned on the source chain is atomically minted or released on the destination chain, preventing double-spend and maintaining supply conservation. Implementations range from hash time-locked contracts (HTLCs) and lock-and-mint bridge contracts overseen by validator committees to native inter-blockchain communication protocols (IBC) and zero-knowledge proof-based verification bridges that eliminate trusted attestors entirely."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:consensus-mechanism ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptographic-proof ],
        ngm:cross-chain-interoperability ;
    vc:bridgesTo ngm:decentralised-finance,
        ngm:digital-asset-regulation ;
    vc:contrastsWith ngm:centralised-exchange,
        ngm:wrapped-token ;
    vc:enables ngm:blockchain-interoperability,
        ngm:cross-chain-liquidity,
        ngm:de-fi,
        ngm:multi-chain-ecosystem,
        ngm:wrapped-token ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:blockchain-security,
        ngm:cross-chain-messaging,
        ngm:layer-2-scaling,
        ngm:rollup,
        ngm:sidechain,
        ngm:token-standard ;
    vc:requires ngm:consensus-mechanism,
        ngm:cryptographic-proof,
        ngm:validator-network ;
    vc:slug "cross-chain-asset-transfer" ;
    vc:sourceDomain "blockchain" ;
    vc:standardizedBy ngm:cosmos-ibc,
        ngm:polkadot-xcm ;
    vc:uses ngm:atomic-swap,
        ngm:blockchain-protocol,
        ngm:cross-chain-bridge,
        ngm:hash-time-locked-contract,
        ngm:light-client,
        ngm:smart-contract,
        ngm:zero-knowledge-proof .

ngm:data-interoperability a owl:Class ;
    rdfs:label "Data Interoperability"@en ;
    rdfs:comment "Data Interoperability is the capability of heterogeneous systems, applications, and data sources to exchange, interpret, and act upon shared data without loss of meaning across organisational and technical boundaries. It encompasses syntactic interoperability (shared formats and wire protocols), semantic interoperability (common vocabularies, ontologies, and data models), and pragmatic interoperability (agreed processes, policies, and trust frameworks). Achieving full data interoperability requires alignment across API contracts, schema registries, identity frameworks, and data governance regimes. It is a foundational property enabling federated analytics, cross-domain knowledge graphs, and open ecosystem integration."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-standards ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:schema-registry ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-format ],
        ngm:data-management ;
    vc:bridgesTo ngm:blockchain,
        ngm:decentralised-identifier,
        ngm:verifiable-credential ;
    vc:contrastsWith ngm:data-silos,
        ngm:vendor-lock-in ;
    vc:dependsOn ngm:data-governance,
        ngm:identity-management,
        ngm:metadata-management ;
    vc:enables ngm:data-pipeline,
        ngm:federated-learning,
        ngm:interoperability,
        ngm:knowledge-graph,
        ngm:open-data ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:graphql,
        ngm:linked-data,
        ngm:rest-api ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:data-fabric,
        ngm:data-integration,
        ngm:data-mesh,
        ngm:semantic-interoperability,
        ngm:syntactic-interoperability ;
    vc:requires ngm:api-contract,
        ngm:data-format,
        ngm:data-standards,
        ngm:schema-registry ;
    vc:slug "data-interoperability" ;
    vc:sourceDomain "data" ;
    vc:standardizedBy ngm:iso,
        ngm:oasis,
        ngm:w3c .

ngm:decentralized-identity-did a owl:Class ;
    rdfs:label "Decentralized Identity (DID)"@en ;
    rdfs:comment "A W3C standard for self-sovereign digital identities that are globally unique, cryptographically verifiable, and controlled by the identity subject without requiring centralized authorities."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:did-method ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptographic-keys ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:did-document ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:distributed-ledger ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:did-resolver ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:verifiable-data-registry ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:knowledge-graph-publication-classifier-key-infrastructure ],
        ngm:infra-security-and-identity ;
    skos:broader ngm:infra-security-and-identity ;
    vc:enables ngm:cross-domain-identity,
        ngm:decentralized-authentication,
        ngm:privacy-preserving-identity,
        ngm:verifiable-credential-vc ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:did-document,
        ngm:did-method,
        ngm:did-resolver,
        ngm:did-uri,
        ngm:verifiable-data-registry ;
    vc:isPartOf ngm:identity-management-system,
        ngm:self-sovereign-identity-ssi ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:cryptographic-keys,
        ngm:distributed-ledger,
        ngm:knowledge-graph-publication-classifier-key-infrastructure ;
    vc:slug "decentralized-identity-did" ;
    vc:sourceDomain "infrastructure" .

ngm:digital-asset-trading a owl:Class ;
    rdfs:label "Digital Asset Trading"@en ;
    rdfs:comment "The buying, selling, and exchange of cryptocurrencies, tokens, and other blockchain-based assets through centralised exchanges, decentralised protocols, and over-the-counter markets using various order types, trading strategies, and execution mechanisms to achieve price discovery and liquidity."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:blockchain ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:digital-wallet ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:decentralised-exchange ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptographic-key-management ],
        ngm:financial-trading ;
    vc:bridgesTo ngm:decentralised-finance,
        ngm:regulatory-compliance,
        ngm:tokenisation ;
    vc:contrastsWith ngm:fiat-currency-exchange,
        ngm:traditional-securities-trading ;
    vc:dependsOn ngm:consensus-mechanism,
        ngm:custody-solution ;
    vc:enables ngm:algorithmic-trading,
        ngm:arbitrage,
        ngm:liquidity-provision,
        ngm:market-making,
        ngm:price-discovery ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:decentralised-exchange,
        ngm:derivatives-trading,
        ngm:over-the-counter-trading,
        ngm:spot-trading ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:market-microstructure ;
    vc:requires ngm:blockchain,
        ngm:cryptographic-key-management,
        ngm:digital-wallet,
        ngm:exchange-platform,
        ngm:order-matching,
        ngm:settlement-systems ;
    vc:slug "digital-asset-trading" ;
    vc:sourceDomain "finance" ;
    vc:uses ngm:automated-market-maker,
        ngm:order-book,
        ngm:smart-contract .

ngm:double-spending a owl:Class ;
    rdfs:label "Double Spending"@en ;
    rdfs:comment "Double spending is the fraudulent attempt to spend the same digital asset more than once by broadcasting conflicting transactions to different parts of a blockchain network before they are confirmed. It represents the fundamental security problem that consensus mechanisms are designed to prevent in distributed ledger systems."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:distributed-ledger ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:transaction-finality ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:peer-to-peer-network ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:consensus-mechanism ],
        ngm:bc-protocol-and-consensus ;
    skos:broader ngm:bc-protocol-and-consensus ;
    vc:bridgesTo ngm:central-bank-digital-currency,
        ngm:digital-currency ;
    vc:contrastsWith ngm:byzantine-fault-tolerance,
        ngm:finality,
        ngm:transaction-confirmation ;
    vc:dependsOn ngm:blockchain-transaction,
        ngm:transaction-propagation,
        ngm:utxo ;
    vc:enables ngm:51-percent-attack,
        ngm:attack-vector,
        ngm:finney-attack,
        ngm:race-attack ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:blockchain-security,
        ngm:cybersecurity ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:block-confirmation,
        ngm:cryptographic-signature,
        ngm:eclipse-attack,
        ngm:payment-channel,
        ngm:proof-of-stake,
        ngm:proof-of-work,
        ngm:selfish-mining,
        ngm:sybil-attack ;
    vc:requires ngm:consensus-mechanism,
        ngm:distributed-ledger,
        ngm:peer-to-peer-network,
        ngm:transaction-finality ;
    vc:slug "double-spending" ;
    vc:sourceDomain "blockchain" .

ngm:end-to-end-encryption a owl:Class ;
    rdfs:label "End-to-End Encryption"@en ;
    rdfs:comment "End-to-end encryption (E2EE) is a communication security model in which data is encrypted on the sender's device and can only be decrypted by the intended recipient's device, ensuring that no intermediate party—including service providers, network operators, or infrastructure owners—can access the plaintext content. It combines asymmetric key exchange with symmetric session encryption to provide confidentiality, integrity, and authenticity without trusting intermediaries."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:hardware-security-module ],
        ngm:encryption ;
    vc:bridgesTo ngm:decentralised-identity,
        ngm:post-quantum-cryptography,
        ngm:secure-multiparty-computation ;
    vc:contrastsWith ngm:lawful-interception,
        ngm:server-side-encryption,
        ngm:transport-layer-security ;
    vc:dependsOn ngm:authentication,
        ngm:cryptographic-key-management,
        ngm:trusted-execution-environment ;
    vc:enables ngm:forward-secrecy,
        ngm:privacy,
        ngm:privacy-by-design,
        ngm:secure-messaging ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:data-protection-regulation,
        ngm:digital-rights ;
    vc:requires ngm:digital-certificates,
        ngm:hardware-security-module ;
    vc:slug "end-to-end-encryption" ;
    vc:sourceDomain "security" ;
    vc:standardizedBy ngm:ietf,
        ngm:nist-post-quantum-cryptography ;
    vc:supports ngm:data-sovereignty,
        ngm:zero-knowledge-architecture ;
    vc:uses ngm:asymmetric-cryptography,
        ngm:diffie-hellman-key-exchange,
        ngm:key-management,
        ngm:public-key-infrastructure,
        ngm:signal-protocol .

ngm:esg-investing a owl:Class ;
    rdfs:label "ESG Investing"@en ;
    rdfs:comment "ESG Investing is an investment methodology that systematically integrates Environmental, Social, and Governance criteria into the analysis, selection, and management of portfolios, enabling investors to assess material sustainability risks and ethical impact alongside conventional financial returns. Environmental factors encompass carbon emissions, resource consumption, and climate transition exposure; social factors cover labour practices, supply-chain conditions, human rights, and community impact; governance factors evaluate board composition, executive remuneration, audit independence, and shareholder rights. ESG signals are incorporated through negative screening, positive best-in-class selection, engagement and proxy voting, or the construction of fully ESG-integrated thematic funds, each reflecting different theories of how non-financial data predicts long-run financial performance."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:corporate-governance ],
        ngm:sustainable-finance ;
    vc:bridgesTo ngm:carbon-credit,
        ngm:decentralised-autonomous-organisation,
        ngm:tokenization ;
    vc:contrastsWith ngm:conventional-investing,
        ngm:greenwashing ;
    vc:dependsOn ngm:esg-rating,
        ngm:non-financial-reporting ;
    vc:enables ngm:green-bond,
        ngm:impact-measurement,
        ngm:stewardship ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:corporate-governance,
        ngm:environmental-criteria,
        ngm:social-criteria ;
    vc:isPartOf ngm:impact-investing,
        ngm:sustainable-finance ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:green-finance,
        ngm:socially-responsible-investing,
        ngm:sustainability ;
    vc:requires ngm:esg-data-disclosure,
        ngm:materiality-assessment ;
    vc:slug "esg-investing" ;
    vc:sourceDomain "finance" ;
    vc:standardizedBy ngm:gri-standards,
        ngm:sfdr,
        ngm:tcfd ;
    vc:supports ngm:climate-risk-management,
        ngm:governance,
        ngm:sustainable-development-goals ;
    vc:uses ngm:portfolio-screening,
        ngm:proxy-voting,
        ngm:stakeholder-engagement .

ngm:facial-recognition a owl:Class ;
    rdfs:label "Facial Recognition"@en ;
    rdfs:comment "Facial Recognition is a computer vision technology that automatically detects, aligns, and identifies or verifies individuals by analysing facial features extracted from images or video frames, producing compact numerical embeddings that encode discriminative facial geometry and appearance. These embeddings are compared against a gallery of known identities using similarity metrics (cosine similarity or L2 distance), operating in one-to-one verification mode (confirming claimed identity) or one-to-many identification mode (searching against a database of enrolled individuals). Modern systems rely on deep convolutional neural networks trained on large-scale labelled datasets and are subject to increasing regulatory oversight relating to accuracy disparities across demographic groups, privacy obligations, and prohibition in high-risk contexts under frameworks such as the EU AI Act."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:training-data ],
        ngm:computer-vision ;
    vc:bridgesTo ngm:digital-identity,
        ngm:smart-city ;
    vc:contrastsWith ngm:deepfake-detection,
        ngm:fingerprint-recognition,
        ngm:iris-recognition ;
    vc:enables ngm:access-control,
        ngm:biometric-verification,
        ngm:border-control,
        ngm:digital-identity-verification,
        ngm:surveillance ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:algorithmic-bias,
        ngm:data-protection,
        ngm:eu-ai-act,
        ngm:privacy ;
    vc:requires ngm:face-detection,
        ngm:image-preprocessing,
        ngm:training-data ;
    vc:slug "facial-recognition" ;
    vc:sourceDomain "ai" ;
    vc:standardizedBy ngm:iso-iec-19794,
        ngm:nist-frvt ;
    vc:uses ngm:approximate-nearest-neighbour-search,
        ngm:biometric-authentication,
        ngm:camera,
        ngm:convolutional-neural-network,
        ngm:deep-learning,
        ngm:face-embedding .

ngm:feature-matching a owl:Class ;
    rdfs:label "Feature Matching"@en ;
    rdfs:comment "Feature Matching is a computer vision technique that identifies and associates corresponding salient regions—keypoints and their descriptors—across two or more images or point clouds, enabling geometric relationships such as homographies, fundamental matrices, or rigid-body transformations to be estimated. Classical detectors such as SIFT, SURF, and ORB extract rotation- and scale-invariant descriptors; modern deep learning approaches learn matched embeddings end-to-end from training data. Feature matching is a foundational step in Structure-from-Motion, visual odometry, SLAM, and image-based localisation pipelines. The accuracy and efficiency of matching directly determine downstream reconstruction quality and real-time performance in robotics and augmented reality applications."@en ;
    rdfs:subClassOf ngm:computer-vision ;
    vc:bridgesTo ngm:augmented-reality,
        ngm:robotic-perception ;
    vc:contrastsWith ngm:optical-flow,
        ngm:template-matching ;
    vc:enables ngm:image-based-localisation,
        ngm:photogrammetry,
        ngm:pose-estimation,
        ngm:slam,
        ngm:structure-from-motion,
        ngm:visual-odometry ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:outlier-rejection,
        ngm:ratio-test ;
    vc:implements ngm:epipolar-geometry,
        ngm:homography-estimation ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:computer-vision-system,
        ngm:depth-sensing,
        ngm:image-retrieval,
        ngm:lidar,
        ngm:object-recognition,
        ngm:point-cloud ;
    vc:requires ngm:image-preprocessing,
        ngm:ransac ;
    vc:slug "feature-matching" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:deep-learning,
        ngm:depth-estimation,
        ngm:descriptor-extraction,
        ngm:keypoint-detection,
        ngm:nearest-neighbour-search,
        ngm:stereo-camera .

ngm:feature-store a owl:Class ;
    rdfs:label "Feature Store"@en ;
    rdfs:comment "A centralised repository for storing, managing, versioning, and serving machine learning features at scale. It ensures point-in-time consistency between training and online inference, prevents training-serving skew, and enables cross-team feature reuse so that features computed once can be shared across multiple models and pipelines."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:feature-engineering ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-warehouse ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-lake ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:feature-extraction ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-pipeline ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:training-data ],
        ngm:ai-infrastructure ;
    vc:bridgesTo ngm:data-mesh,
        ngm:digital-twin ;
    vc:contrastsWith ngm:data-mart,
        ngm:model-registry ;
    vc:dependsOn ngm:data-engineering,
        ngm:key-value-store ;
    vc:enables ngm:machine-learning-discipline-pipeline,
        ngm:model-training,
        ngm:point-in-time-correctness,
        ngm:real-time-inference ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:feature-catalog,
        ngm:feature-engineering,
        ngm:feature-extraction,
        ngm:offline-store,
        ngm:online-store,
        ngm:training-data ;
    vc:isPartOf ngm:ml-platform,
        ngm:mlops ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:ai-infrastructure,
        ngm:experiment-tracking,
        ngm:vector-database ;
    vc:requires ngm:data-lake,
        ngm:data-pipeline,
        ngm:data-warehouse ;
    vc:slug "feature-store" ;
    vc:sourceDomain "machine-learning" ;
    vc:supports ngm:fraud-detection,
        ngm:recommendation-system ;
    vc:uses ngm:apache-kafka,
        ngm:apache-spark .

ngm:game-development a owl:Class ;
    rdfs:label "Game Development"@en ;
    rdfs:comment "Game development is the multidisciplinary engineering and creative practice of designing, building, and publishing interactive software experiences, spanning the full production pipeline from concept and pre-production through asset creation, engine programming, quality assurance, and live operations. It integrates disciplines including game design, real-time rendering, audio engineering, narrative scripting, physics simulation, and network programming into a unified production workflow centred on a game engine runtime. The field increasingly leverages machine learning for procedural content generation, NPC behaviour training via reinforcement learning, and generative AI for accelerating art and dialogue pipelines. Game development techniques have generalised beyond entertainment into spatial computing, robotics simulation, digital twins, and serious-games applications."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:game-engine ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:graphics-processing-unit ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:quality-assurance ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:real-time-rendering ],
        ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:bridgesTo ngm:machine-learning,
        ngm:robotics-simulation,
        ngm:spatial-computing ;
    vc:dependsOn ngm:asset-pipeline,
        ngm:physics-engine ;
    vc:enables ngm:digital-twin,
        ngm:extended-reality,
        ngm:npc-interaction,
        ngm:serious-games,
        ngm:simulation ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:audio-engineering,
        ngm:game-design,
        ngm:game-engine,
        ngm:game-physics,
        ngm:quality-assurance,
        ngm:real-time-rendering ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:computer-graphics,
        ngm:human-computer-interaction,
        ngm:interactive-software-development,
        ngm:metaverse,
        ngm:virtual-world ;
    vc:requires ngm:graphics-processing-unit,
        ngm:software-development-kit ;
    vc:slug "game-development" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:generative-ai,
        ngm:procedural-content-generation,
        ngm:reinforcement-learning,
        ngm:shader-programming,
        ngm:version-control .

ngm:global-illumination a owl:Class ;
    rdfs:label "Global Illumination"@en ;
    rdfs:comment "Global Illumination (GI) is a rendering approach that simulates all light interactions within a scene, including both direct illumination from light sources and indirect illumination from light bouncing between surfaces. Techniques range from offline radiosity and photon mapping to real-time approximations such as voxel cone tracing, screen-space ambient occlusion, and hardware-accelerated ray tracing, producing physically plausible colour bleeding, soft shadows, and caustics."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:compute-shader ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:ambient-occlusion ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ray-tracing ],
        ngm:sc-display-and-rendering ;
    skos:broader ngm:sc-display-and-rendering ;
    vc:bridgesTo ngm:machine-learning-denoising,
        ngm:neural-radiance-field ;
    vc:contrastsWith ngm:local-illumination,
        ngm:rasterization ;
    vc:enables ngm:colour-bleeding,
        ngm:photorealistic-rendering,
        ngm:soft-shadows ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:ambient-occlusion,
        ngm:caustics,
        ngm:direct-illumination,
        ngm:indirect-illumination ;
    vc:isPartOf ngm:rendering-pipeline ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:lightmap-baking,
        ngm:subsurface-scattering,
        ngm:voxel-cone-tracing ;
    vc:requires ngm:compute-shader,
        ngm:light-transport-simulation,
        ngm:ray-tracing ;
    vc:slug "global-illumination" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:architectural-visualisation,
        ngm:metaverse,
        ngm:virtual-reality ;
    vc:uses ngm:light-probe,
        ngm:photon-mapping,
        ngm:physically-based-rendering,
        ngm:radiosity .

ngm:human-robot-collaboration a owl:Class ;
    rdfs:label "Human-Robot Collaboration"@en ;
    rdfs:comment "Human-robot collaboration is the design and operation of robots that work alongside people in a shared workspace, coordinating tasks safely through sensing, control and interaction."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
