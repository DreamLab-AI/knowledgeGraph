        ngm:virtual-asset-exchange ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires ngm:blockchain-infrastructure,
        ngm:digital-wallet,
        ngm:smart-contracts ;
    vc:slug "digital-marketplace" ;
    vc:sourceDomain "spatial-computing" .

ngm:digital-payment-system a owl:Class ;
    rdfs:label "Digital Payment System"@en ;
    rdfs:comment "The integrated infrastructure of protocols, platforms, and financial instruments enabling secure monetary transactions within metaverse environments, encompassing cryptocurrency payments, stablecoin transfers, fiat gateways, and smart contract-based payment automation for virtual goods and servic..."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:blockchain-network ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:payment-gateway ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:digital-wallet ],
        ngm:financial-infrastructure,
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:enables ngm:cross-border-payments,
        ngm:micropayments,
        ngm:virtual-transactions ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires ngm:blockchain-network,
        ngm:digital-wallet,
        ngm:payment-gateway ;
    vc:slug "digital-payment-system" ;
    vc:sourceDomain "spatial-computing" .

ngm:digital-product-passport a owl:Class ;
    rdfs:label "Digital Product Passport"@en ;
    rdfs:comment "A Digital Product Passport (DPP) is a standardised digital record that captures and communicates information about a product's material composition, origin, manufacturing process, environmental footprint, repair history, and end-of-life options throughout its lifecycle. Mandated by EU ecodesign and product sustainability legislation, DPPs are designed to be machine-readable and accessible to consumers, regulators, recyclers, and supply chain actors via data carriers such as QR codes or RFID. They are a foundational instrument of circular economy policy and are frequently implemented using blockchain or distributed ledger technology to ensure provenance integrity and tamper-evident audit trails."@en ;
    rdfs:subClassOf ngm:infra-data-management ;
    skos:broader ngm:infra-data-management ;
    vc:enables ngm:circular-economy,
        ngm:supply-chain-traceability ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:blockchain,
        ngm:esg-reporting,
        ngm:supply-chain ;
    vc:slug "digital-product-passport" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:provenance-tracking .

ngm:dispute-resolution a owl:Class ;
    rdfs:label "Dispute Resolution"@en ;
    rdfs:comment "Dispute Resolution encompasses the processes and mechanisms by which conflicting parties reach a binding or agreed settlement without necessarily resorting to formal court litigation, including negotiation, mediation, arbitration, and online dispute resolution (ODR) platforms. In blockchain and smart-contract contexts, dispute resolution refers to the programmatic or semi-programmatic adjudication of disagreements arising from contract ambiguity, code exploits, or off-chain facts that automated execution cannot verify, using decentralised arbitration protocols, escrow mechanisms, and cryptoeconomic incentives to produce impartial outcomes. Effective dispute resolution balances finality, cost, speed, and procedural fairness across both traditional legal frameworks and emerging decentralised governance structures."@en ;
    rdfs:subClassOf ngm:dispute-resolution-mechanism ;
    vc:enables ngm:dao-governance,
        ngm:e-contract-arbitration ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:arbitration-process,
        ngm:conflict-resolution,
        ngm:dao-legal-structures,
        ngm:legal-framework ;
    vc:slug "dispute-resolution" ;
    vc:sourceDomain "governance" ;
    vc:uses ngm:arbitration-decision-engine,
        ngm:legal-compliance,
        ngm:smart-contract .

ngm:diversity-non-discrimination-and-fairness a owl:Class ;
    rdfs:label "Diversity, Non-Discrimination, and Fairness"@en ;
    rdfs:comment "Diversity, Non-Discrimination, and Fairness is a foundational trustworthiness dimension of responsible AI that requires systems to avoid unfair bias against protected characteristics (sex, race, religion, disability, age, sexual orientation), ensure equitable treatment and outcomes across demographic groups, implement accessibility and universal design for people with diverse abilities, and enable inclusive stakeholder participation throughout the AI development lifecycle. It encompasses three interdependent pillars: unfair-bias avoidance through pre-processing data corrections, in-processing fairness constraints, and post-processing adjustments; accessibility and universal design aligned with WCAG and the European Accessibility Act; and participatory design methodologies that co-create systems with affected communities. Legal mandates including the EU AI Act and GDPR enforce these requirements with substantial penalties."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:accountability ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:fairness ],
        ngm:ai-governance-and-ethics ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:enables ngm:accessibility,
        ngm:equity,
        ngm:trustworthy-ai ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:ai-ethics,
        ngm:ai-impact-assessment,
        ngm:explainability,
        ngm:stakeholder,
        ngm:transparency ;
    vc:requires ngm:accountability,
        ngm:fairness ;
