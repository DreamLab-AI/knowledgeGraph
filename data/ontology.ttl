    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:interoperability,
        ngm:open-standard,
        ngm:regulatory-compliance ;
    vc:slug "industry-consortium" ;
    vc:sourceDomain "ai" ;
    vc:standardizedBy ngm:standards ;
    vc:supports ngm:ai,
        ngm:technology-adoption ;
    vc:uses ngm:distributed-collaboration .

ngm:inertia a owl:Class ;
    rdfs:label "Inertia"@en ;
    rdfs:comment "The physical property of a body that resists changes in its state of motion, whether translational or rotational. In robotics and actuation systems, inertia determines how much force or torque is required to accelerate or decelerate a component, and must be modelled accurately for stable, precise control."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:robotics-control ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:actuator ],
        ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:control-system,
        ngm:kinematics ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:autonomous-navigation,
        ngm:robotics ;
    vc:requires ngm:actuator,
        ngm:robotics-control ;
    vc:slug "inertia" ;
    vc:sourceDomain "robotics" .

ngm:inference-algorithm a owl:Class ;
    rdfs:label "Inference Algorithm"@en ;
    rdfs:comment "An inference algorithm is a computational procedure for deriving conclusions about unobserved quantities from a model and observed data, typically by computing or approximating posterior distributions in probabilistic models. Common families include exact methods (variable elimination, belief propagation), sampling methods (Markov chain Monte Carlo, importance sampling), and variational approximations. It is the engine that turns a model specification into actionable estimates or predictions."@en ;
    rdfs:subClassOf ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:hamiltonian-monte-carlo,
        ngm:probabilistic-model ;
    vc:slug "inference-algorithm" ;
    vc:sourceDomain "ai" .

ngm:information-integrity a owl:Class ;
    rdfs:label "Information Integrity"@en ;
    rdfs:comment "Information integrity is the property and governance objective of ensuring that information remains accurate, complete, authentic and resistant to unauthorised or deceptive alteration across its lifecycle. In the digital-content context it spans provenance, authenticity verification and resilience against misinformation and disinformation. It draws on technical measures such as digital watermarking and cryptographic provenance alongside institutional trust-and-safety practices."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:verifiable-credentials ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:authentication ],
        ngm:content-provenance ;
    vc:bridgesTo ngm:provenance ;
    vc:contrastsWith ngm:disinformation,
        ngm:misinformation ;
    vc:dependsOn ngm:content-provenance,
        ngm:data-integrity ;
    vc:enables ngm:fact-checking,
        ngm:media-literacy ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:epistemic-security ;
    vc:requires ngm:authentication,
        ngm:verifiable-credentials ;
    vc:slug "information-integrity" ;
    vc:sourceDomain "governance" ;
    vc:supports ngm:trust,
        ngm:trust-and-safety ;
    vc:uses ngm:content-authenticity,
        ngm:digital-watermarking .

ngm:information-theoretic-security a owl:Class ;
    rdfs:label "Information Theoretic Security"@en ;
    rdfs:comment "Information theoretic security is a class of cryptographic guarantee in which a scheme is secure against an adversary with unlimited computational power, because the ciphertext or protocol transcript carries no statistical information about the secret. Unlike computational security, which rests on the assumed hardness of mathematical problems, these guarantees follow from the structure of information itself and remain valid even against future advances such as quantum computers. Canonical examples include the one-time pad and threshold secret sharing."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:information-theory ],
        ngm:cryptography ;
    vc:bridgesTo ngm:quantum-key-distribution ;
    vc:contrastsWith ngm:encryption ;
    vc:enables ngm:commitment-scheme,
        ngm:secret-sharing ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:secret-sharing ;
    vc:isPartOf ngm:cryptography ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:cryptography,
        ngm:information-theory ;
    vc:requires ngm:information-theory ;
    vc:slug "information-theoretic-security" ;
    vc:sourceDomain "security" ;
    vc:supports ngm:quantum-key-distribution ;
    vc:uses ngm:information-theory .

ngm:initial-dex-offering a owl:Class ;
    rdfs:label "Initial Dex Offering"@en ;
    rdfs:comment "An initial DEX offering (IDO) is a token fundraising and distribution model in which a new token is launched directly on a decentralised exchange, with liquidity provided into an automated market maker pool so trading begins immediately. Unlike centralised or regulated offerings, an IDO is permissionless and settled on-chain through smart contracts, often using launchpads that manage allocation and anti-bot measures. It contrasts with the initial coin offering and the regulated initial public offering by emphasising immediate liquidity and decentralised access."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:smart-contract ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:liquidity-pool ],
        ngm:token-sale ;
    vc:bridgesTo ngm:security-token-offering ;
    vc:contrastsWith ngm:initial-coin-offering,
        ngm:initial-public-offering ;
    vc:dependsOn ngm:liquidity-pool ;
    vc:enables ngm:decentralized-finance ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:implements ngm:smart-contract ;
    vc:isPartOf ngm:token-sale ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:blockchain-token,
        ngm:yield-farming ;
    vc:requires ngm:liquidity-pool,
        ngm:smart-contract ;
    vc:slug "initial-dex-offering" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:decentralized-finance ;
    vc:uses ngm:automated-market-maker,
        ngm:decentralized-exchange .

