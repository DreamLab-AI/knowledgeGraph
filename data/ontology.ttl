        ngm:spatial-computing,
        ngm:virtual-reality ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:implements ngm:open-standard,
        ngm:runtime-environment ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:requires ngm:hardware-abstraction,
        ngm:rendering-pipeline ;
    vc:slug "xr-runtime-environment" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:middleware,
        ngm:optical-tracking .

ngm:agent a owl:Class ;
    rdfs:label "Agent"@en ;
    rdfs:comment "An autonomous computational or physical entity that perceives its environment, reasons about its perceptions using internal beliefs and goals, and acts to achieve specified objectives—exhibiting autonomy, reactivity, proactivity, and social ability across AI, blockchain, robotics, and metaverse domains."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:autonomy-level ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ai-agent-system ],
