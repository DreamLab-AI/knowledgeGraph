ngm:tls-1-3 a owl:Class ;
    rdfs:label "TLS 1.3"@en ;
    rdfs:comment "TLS 1.3 (Transport Layer Security version 1.3, standardised in RFC 8446, August 2018) is the current major version of the TLS protocol, redesigned to eliminate legacy cryptographic weaknesses, reduce handshake round-trips from two to one (zero for session resumption), mandate forward secrecy on every connection, and restrict the cipher suite to a small set of authenticated encryption algorithms. It replaces TLS 1.2 as the baseline secure transport for HTTPS, QUIC, and virtually all authenticated internet communications."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:public-key-infrastructure ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:certificate-authority ],
        ngm:encryption-protocol,
        ngm:transport-layer-security ;
    vc:bridgesTo ngm:distributed-collaboration,
        ngm:infrastructure ;
    vc:contrastsWith ngm:ssl,
        ngm:tls ;
    vc:enables ngm:forward-secrecy,
        ngm:http,
        ngm:network-security,
        ngm:quic ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:certificate-transparency,
        ngm:http-protocol,
        ngm:mutual-tls,
        ngm:post-quantum-cryptography ;
    vc:requires ngm:certificate-authority,
        ngm:public-key-infrastructure ;
    vc:slug "tls-1-3" ;
    vc:sourceDomain "security" ;
    vc:standardizedBy ngm:ietf,
        ngm:rfc-8446 ;
    vc:uses ngm:authenticated-encryption,
        ngm:cryptography,
        ngm:digital-certificate,
        ngm:elliptic-curve-diffie-hellman,
        ngm:key-exchange,
        ngm:x-509-certificate .

ngm:total-order-broadcast a owl:Class ;
    rdfs:label "Total Order Broadcast"@en ;
    rdfs:comment "Total order broadcast, also called atomic broadcast, is a communication primitive in distributed systems that guarantees all correct processes deliver the same set of messages in exactly the same order. It strengthens reliable broadcast with a total ordering property, ensuring that every replica observes an identical sequence of events. Total order broadcast is provably equivalent to consensus and forms the foundation of state machine replication."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:fault-tolerance ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:quorum ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:leader-election ],
        ngm:distributed-systems ;
    vc:bridgesTo ngm:distributed-systems ;
    vc:dependsOn ngm:byzantine-fault-tolerance ;
    vc:enables ngm:linearizability,
        ngm:replication ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:state-machine-replication ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:consensus,
        ngm:consensus-algorithm,
        ngm:distributed-ledger ;
    vc:requires ngm:fault-tolerance,
        ngm:leader-election,
        ngm:quorum ;
    vc:slug "total-order-broadcast" ;
    vc:sourceDomain "distributed-systems" ;
    vc:uses ngm:paxos,
        ngm:raft .

ngm:trade-finance-automation a owl:Class ;
    rdfs:label "Trade Finance Automation"@en ;
    rdfs:comment "Trade Finance Automation is the application of digital technologies—including blockchain-based smart contracts, AI-driven document processing, and electronic data interchange—to streamline and accelerate the complex financial instruments and workflows that facilitate international commerce. Traditional trade finance relies on paper-intensive instruments such as letters of credit, bills of lading, and documentary collections, which are slow, error-prone, and costly to process. Automation replaces manual document verification with machine-readable structured data, triggers payment obligations automatically upon verified delivery conditions, and reduces counterparty risk through distributed ledger transparency. The result is faster settlement, lower operational costs, and improved access to working capital for exporters and importers globally."@en ;
    rdfs:subClassOf ngm:trade-finance ;
    vc:enables ngm:cross-border-payments,
        ngm:logistics-optimization,
        ngm:supply-chain-management ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:blockchain-compliance,
        ngm:customs-trade-facilitation,
        ngm:financial-instruments,
        ngm:supply-chain-blockchain ;
    vc:slug "trade-finance-automation" ;
    vc:sourceDomain "finance" ;
    vc:uses ngm:blockchain,
        ngm:enterprise-smart-contracts,
        ngm:smart-contract,
        ngm:supply-chain-traceability .

ngm:training-and-fine-tuning a owl:Class ;
