ngm:two-tier-distribution-model a owl:Class ;
    rdfs:label "Two-Tier Distribution Model"@en ;
    rdfs:comment "The two-tier distribution model is the architecture commonly proposed for central bank digital currencies in which the central bank issues the digital currency but commercial banks and licensed intermediaries handle distribution, wallets, and customer service. This preserves the central bank's monetary authority while leveraging existing financial institutions for onboarding, compliance, and the user-facing layer."@en ;
    rdfs:subClassOf ngm:economic-mechanism ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:cbdc-frameworks,
        ngm:cbdcs ;
    vc:slug "two-tier-distribution-model" ;
    vc:sourceDomain "blockchain" .

ngm:type-script a owl:Class ;
    rdfs:label "TypeScript"@en ;
    rdfs:comment "TypeScript is a statically typed superset of JavaScript developed and maintained by Microsoft that adds optional type annotations, interfaces, generics, and compile-time type checking to the JavaScript language. Source code is transpiled by the TypeScript compiler (tsc) to plain JavaScript, making it compatible with any JavaScript runtime or browser without requiring runtime changes. The type system enables large-scale application development by surfacing errors at development time, improving editor tooling such as intelligent autocompletion, safe refactoring, and inline documentation. TypeScript has become the dominant choice for enterprise front-end and Node.js back-end development, underpinning major frameworks such as Angular, NestJS, and Deno."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:interface ],
        ngm:programming-language ;
    vc:bridgesTo ngm:api-design,
        ngm:large-language-model ;
    vc:contrastsWith ngm:dart,
        ngm:flow-type-checker,
        ngm:javascript ;
    vc:dependsOn ngm:ecmascript,
        ngm:npm ;
    vc:enables ngm:refactoring,
        ngm:software-engineering,
        ngm:static-analysis,
        ngm:web-application ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:generics,
        ngm:interface,
        ngm:type-system,
        ngm:typescript-compiler ;
    vc:implements ngm:structural-typing,
        ngm:type-inference ;
    vc:isPartOf ngm:javascript-ecosystem ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:eslint,
        ngm:transpilation,
        ngm:webpack ;
    vc:requires ngm:javascript,
        ngm:node-js ;
    vc:slug "type-script" ;
    vc:sourceDomain "infrastructure" ;
    vc:standardizedBy ngm:ecma-international,
        ngm:microsoft ;
    vc:supports ngm:angular,
        ngm:deno,
        ngm:react ;
    vc:uses ngm:abstract-syntax-tree,
        ngm:language-server-protocol .

