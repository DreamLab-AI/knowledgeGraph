    rdfs:label "Framebuffer"@en .

ngm:futarchy a owl:Class ;
    rdfs:label "Futarchy"@en ;
    rdfs:comment "Futarchy is a governance mechanism proposed by economist Robin Hanson in which policy decisions are made by first defining measurable societal welfare metrics and then adopting whichever policy candidate is predicted by speculative prediction markets to maximise those metrics. Under futarchy, democratic institutions vote on the values or welfare criteria to optimise, while market prices — which aggregate information from many participants through financial incentives — determine the means by which those values are pursued, on the premise that markets are better information aggregators than committees for empirical questions about causal consequences."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:market-making ],
        ngm:voting-mechanism ;
    vc:bridgesTo ngm:automated-market-maker,
        ngm:decentralized-finance ;
    vc:contrastsWith ngm:conviction-voting,
        ngm:quadratic-voting,
        ngm:representative-democracy,
        ngm:token-weighted-voting ;
    vc:enables ngm:dao-governance,
        ngm:decentralized-governance,
        ngm:evidence-based-policy,
        ngm:information-aggregation,
        ngm:transparent-decision-making ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:implements ngm:efficient-market-hypothesis,
        ngm:wisdom-of-crowds ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:decision-market,
        ngm:epistocracy,
        ngm:technocracy ;
    vc:requires ngm:liquid-prediction-market,
        ngm:market-making,
        ngm:measurable-welfare-criterion ;
    vc:slug "futarchy" ;
    vc:sourceDomain "governance" ;
    vc:uses ngm:collective-decision-making,
        ngm:conditional-futures-market,
        ngm:mechanism-design,
        ngm:on-chain-voting,
        ngm:prediction-market,
        ngm:welfare-metric .

ngm:game-ai a owl:Class ;
    rdfs:label "Game AI"@en ;
    rdfs:comment "Game AI is the branch of artificial intelligence applied to interactive entertainment, encompassing the design and implementation of non-player character behaviour, opponent strategy, pathfinding, procedural content generation, and narrative decision systems within game engines. It prioritises perceived intelligence, responsiveness, and entertainment value over computational optimality, distinguishing it from classical AI research focused on provably correct or globally optimal solutions."@en ;
    rdfs:subClassOf ngm:machine-learning-discipline ;
    vc:enables ngm:game-mechanics,
        ngm:procedural-content-generation ;
    vc:hasMaturity ngmi:maturity-established ;
