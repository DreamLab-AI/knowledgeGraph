    vc:enables ngm:image-generation,
        ngm:style-transfer ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:slug "image-to-image-translation" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:diffusion-model,
        ngm:generative-adversarial-network .

ngm:imaging-parameters a owl:Class ;
    rdfs:label "Imaging Parameters"@en ;
    rdfs:comment "Imaging Parameters are the configurable settings—such as exposure time, aperture, ISO, focal length, white balance, and sensor gain—that govern how a camera or depth sensor captures light and produces a digital image. In spatial computing pipelines, correct imaging parameter calibration is essential for photogrammetric reconstruction, volumetric capture, and computer-vision model accuracy across varying lighting conditions."@en ;
    rdfs:subClassOf ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:enables ngm:image-classification,
        ngm:real-time-rendering ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:camera ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:relatedTo ngm:camera-parameters,
        ngm:photogrammetry ;
    vc:slug "imaging-parameters" ;
    vc:sourceDomain "spatial-computing" .

ngm:immersive-audio-technology a owl:Class ;
    rdfs:label "Immersive Audio Technology"@en ;
    rdfs:comment "Technologies and techniques for rendering spatially accurate, three-dimensional soundscapes within virtual and augmented reality environments. Encompasses binaural rendering, ambisonics, head-related transfer function (HRTF) personalisation, and real-time positional audio to create convincing auditory presence that reinforces visual immersion."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:xr-runtime-environment ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
