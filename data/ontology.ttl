ngm:digital-asset-custody a owl:Class ;
    rdfs:label "Digital Asset Custody"@en ;
    rdfs:comment "Digital asset custody is the safekeeping and administration of cryptographic private keys that control crypto-assets on behalf of their owners. Custodians use controls such as hardware security modules, multi-party computation, and cold storage to protect keys against theft, loss, and unauthorised use while meeting regulatory and audit requirements. It is the trust and security backbone enabling institutional participation in digital-asset markets."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:multi-party-computation ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:cold-storage ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:hardware-security-module ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:multisignature ],
        ngm:digital-asset ;
    vc:bridgesTo ngm:institutional-custody,
        ngm:insurance,
        ngm:regulatory-compliance ;
    vc:contrastsWith ngm:decentralised-exchange,
        ngm:self-custody ;
    vc:dependsOn ngm:blockchain-network,
        ngm:cryptographic-key,
        ngm:smart-contract ;
    vc:enables ngm:institutional-adoption,
        ngm:staking,
        ngm:tokenised-securities ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:cold-storage,
        ngm:hot-wallet,
        ngm:multi-party-computation,
        ngm:multisignature ;
    vc:implements ngm:qualified-custodian-standard ;
    vc:qualityScore "0.73"^^xsd:float ;
    vc:relatedTo ngm:custody-risk,
        ngm:institutional-custody,
        ngm:securities-regulation,
        ngm:wallet-infrastructure ;
    vc:requires ngm:hardware-security-module,
        ngm:key-ceremony,
        ngm:private-key-management,
        ngm:proof-of-reserves ;
    vc:slug "digital-asset-custody" ;
    vc:sourceDomain "blockchain" ;
    vc:standardizedBy ngm:securities-regulation ;
    vc:supports ngm:asset-segregation,
        ngm:audit-trail ;
    vc:uses ngm:air-gap,
