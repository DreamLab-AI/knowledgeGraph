ngm:cognitive-architecture a owl:Class ;
    rdfs:label "Cognitive Architecture"@en ;
    rdfs:comment "A cognitive architecture is a formal specification of the fixed computational structures, memory systems, and control mechanisms that together constitute a general-purpose intelligent agent, independent of any particular task or domain. It prescribes how perception, attention, memory retrieval, reasoning, learning, and action selection are integrated into a unified processing cycle, providing a theoretical and engineering framework for building systems that exhibit adaptive, goal-directed behaviour. Classical examples include ACT-R (Adaptive Control of Thought–Rational), SOAR, and LIDA; contemporary variants extend these principles to neural-symbolic hybrids, transformer-based agent frameworks, and large language model scaffolding systems. Cognitive architectures serve simultaneously as psychological theories of the human mind and as blueprints for artificial intelligence systems."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:machine-learning ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:reasoning ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ontology ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:perception ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:planning-and-scheduling ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:knowledge-representation ],
        ngm:artificial-intelligence ;
    skos:broader ngm:artificial-intelligence ;
    vc:bridgesTo ngm:brain-computer-interface,
        ngm:robotics ;
    vc:contrastsWith ngm:narrow-ai,
        ngm:task-specific-model ;
    vc:enables ngm:agentic-ai,
        ngm:autonomous-agents,
        ngm:human-computer-interaction,
        ngm:symbolic-reasoning ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:action-selection,
        ngm:long-term-memory,
        ngm:perception,
        ngm:planning-and-scheduling,
        ngm:reasoning,
        ngm:working-memory ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:cognitive-science,
        ngm:computational-neuroscience,
        ngm:general-intelligence,
        ngm:large-language-models ;
    vc:requires ngm:knowledge-representation,
        ngm:machine-learning,
        ngm:ontology ;
    vc:slug "cognitive-architecture" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:bayesian-inference,
