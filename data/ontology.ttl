ngm:bundle-adjustment a owl:Class ;
    rdfs:label "Bundle Adjustment"@en ;
    rdfs:comment "Bundle adjustment is a non-linear least-squares optimisation technique in computer vision and photogrammetry that simultaneously refines estimates of 3-D point positions and camera extrinsic and intrinsic parameters so that reprojected 3-D points best match their observed 2-D image locations across all views. It is the gold-standard global refinement step in structure-from-motion pipelines and visual SLAM systems, producing metrically accurate reconstructions from overlapping images or video frames. The term 'bundle' refers to the bundle of light rays connecting each camera centre to observed scene points."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:camera-calibration ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:feature-extraction ],
        ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
