        ngm:presence-indicator ;
    vc:slug "remote-work-infrastructure" ;
    vc:sourceDomain "metaverse" .

ngm:remotely-operated-vehicle-rov a owl:Class ;
    rdfs:label "Remotely Operated Vehicle (ROV)"@en ;
    rdfs:comment "A Remotely Operated Vehicle (ROV) is a tethered underwater robot controlled by a human operator at the surface via a cable that supplies electrical power and bidirectional communications. ROVs are deployed for inspection, maintenance, and intervention tasks in environments too hazardous or deep for human divers, including oil and gas infrastructure, offshore wind farms, and scientific ocean exploration."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:camera ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:control-system ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:actuator ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:sensor ],
        ngm:robo-robot-type,
        ngm:underwater-robot ;
    skos:broader ngm:robo-robot-type ;
    vc:contrastsWith ngm:autonomous-system ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:actuator,
        ngm:camera,
        ngm:control-system,
        ngm:sensor ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:autonomous-robot,
        ngm:inspection-robot,
        ngm:marine-robot,
        ngm:robotics ;
    vc:slug "remotely-operated-vehicle-rov" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:navigation,
        ngm:sensor-fusion .

