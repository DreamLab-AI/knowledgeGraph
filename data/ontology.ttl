        ngm:simultaneous-localisation-and-mapping ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:relatedTo ngm:autonomous-navigation,
        ngm:point-cloud,
        ngm:sensor-fusion,
        ngm:slam ;
    vc:slug "rb-0069-lidar" ;
    vc:sourceDomain "robotics" .

ngm:rb-0092-protective-stop a owl:Class ;
    rdfs:label "rb 0092 protective stop"@en ;
    rdfs:comment "A protective stop is a safety-initiated cessation of robot motion that halts all hazardous movement when a safety function is triggered, without necessarily cutting power to the drive system. Unlike an emergency stop, a protective stop permits automatic restart once the triggering condition is resolved, making it a standard mechanism in collaborative robot cells operating under ISO 10218 and ISO/TS 15066. It is fundamental to speed-and-separation monitoring and power-and-force-limiting safety strategies."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:functional-safety ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:risk-assessment ],
        ngm:robo-safety-and-standards,
        ngm:robot-safety ;
    skos:broader ngm:robo-safety-and-standards ;
    vc:enables ngm:collaborative-operation,
        ngm:human-robot-interaction ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:collaborative-robot,
        ngm:robot-safety ;
    vc:requires ngm:functional-safety,
        ngm:risk-assessment ;
    vc:slug "rb-0092-protective-stop" ;
    vc:sourceDomain "robotics" ;
    vc:standardizedBy ngm:iso-10218,
        ngm:iso-ts-15066 .

ngm:rb-0095-safety-zone a owl:Class ;
    rdfs:label "rb 0095 safety zone"@en ;
    rdfs:comment "A safety zone is a defined spatial region around a robot or autonomous system within which human presence or other objects trigger protective actions such as speed reduction, monitored stops, or full emergency stops. Safety zones are configured and monitored via safeguarding devices and are a central mechanism for achieving collaborative and safe robot operation in accordance with ISO 10218 and ISO/TS 15066."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:rb-0087-safety-standard ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:rb-0089-risk-assessment ],
        ngm:robo-safety-and-standards,
        ngm:robot-safety ;
    skos:broader ngm:robo-safety-and-standards ;
    vc:dependsOn ngm:functional-safety,
        ngm:rb-0075-range-finder ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:rb-0091-safety-rated-monitored-stop,
        ngm:rb-0092-protective-stop,
        ngm:rb-0093-speed-limitation,
        ngm:rb-0096-safeguarding ;
    vc:requires ngm:rb-0087-safety-standard,
        ngm:rb-0089-risk-assessment ;
    vc:slug "rb-0095-safety-zone" ;
    vc:sourceDomain "robotics" .

ngm:real-time a owl:Class ;
    rdfs:label "Real Time"@en ;
    rdfs:comment "Real-Time Computing is the discipline of designing computing systems, operating environments, and algorithmic frameworks in which program correctness depends not only on the logical result of computation but also on the time at which those results are produced, enforcing temporal constraints — de..."@en ;
