        ngm:neural-network-layer,
        ngm:positional-encoding,
        ngm:residual-connection ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:deep-learning,
        ngm:neural-network-architecture ;
    vc:slug "neural-network-component" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:neural-network-inference a owl:Class ;
    rdfs:label "Neural Network Inference"@en ;
    rdfs:comment "Neural network inference is the phase in which a trained neural-network model is applied to new input data to produce predictions, classifications or generations, as distinct from the training phase that learns the model's parameters. It is computationally dominated by forward-pass matrix and tensor operations and is frequently accelerated on GPUs and dedicated hardware. Inference efficiency, measured in latency, throughput and energy, is critical for deploying models in real-time, edge and large-scale serving environments."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:model-optimization ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:neural-network ],
        ngm:inference ;
    vc:bridgesTo ngm:model-deployment,
        ngm:model-serving ;
    vc:dependsOn ngm:model-training,
        ngm:neural-network ;
    vc:enables ngm:edge-computing,
        ngm:model-serving ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:inference ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:deep-learning,
        ngm:latency,
        ngm:neural-network-training,
        ngm:power-management ;
    vc:requires ngm:model-optimization,
        ngm:neural-network ;
    vc:slug "neural-network-inference" ;
    vc:sourceDomain "ai" ;
    vc:supports ngm:model-optimization ;
    vc:uses ngm:batch-processing,
        ngm:gpu,
        ngm:gpu-computing,
        ngm:onnx .

ngm:nominated-proof-of-stake a owl:Class ;
    rdfs:label "Nominated Proof of Stake"@en ;
    rdfs:comment "Nominated Proof of Stake (NPoS) is a consensus mechanism variant in which token holders nominate a set of validator candidates; an election algorithm selects the active validator set to maximise stake distribution while satisfying security constraints. Elected validators produce and finalise blocks, while nominators share both block rewards and slashing penalties, aligning incentives across the broader token holder community."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:validator-set ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:consensus-mechanism ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:validator-node ],
        ngm:bc-protocol-and-consensus,
        ngm:proof-of-stake ;
    skos:broader ngm:bc-protocol-and-consensus ;
    vc:contrastsWith ngm:pure-proof-of-stake ;
    vc:enables ngm:block-reward,
        ngm:blockchain-governance,
        ngm:deterministic-finality ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:blockchain-protocol,
        ngm:delegated-proof-of-stake,
        ngm:liquid-proof-of-stake,
        ngm:polkadot-parachains ;
    vc:requires ngm:consensus-mechanism,
        ngm:validator-node,
        ngm:validator-set ;
    vc:slug "nominated-proof-of-stake" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:consensus-algorithm .

ngm:non-custodial-wallet a owl:Class ;
    rdfs:label "Non-Custodial Wallet"@en ;
    rdfs:comment "A non-custodial wallet is a cryptocurrency wallet in which the user, rather than a third party, exclusively holds and controls the private keys that authorise transactions. Because no intermediary can move or freeze funds, the user bears full responsibility for key security and recovery, typically managed through a seed phrase. Non-custodial wallets are the technical embodiment of self-custody and a prerequisite for permissionless interaction with decentralised protocols."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:key-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:private-key ],
        ngm:cryptocurrency-wallet ;
    vc:bridgesTo ngm:decentralization ;
    vc:contrastsWith ngm:custodial-wallet ;
    vc:dependsOn ngm:custody ;
    vc:enables ngm:permissionless-trading,
        ngm:self-custody ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:self-custody ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:cold-storage,
        ngm:digital-wallet,
        ngm:hardware-wallet,
        ngm:self-sovereign-identity ;
    vc:requires ngm:key-management,
        ngm:private-key ;
    vc:slug "non-custodial-wallet" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:account-abstraction,
        ngm:decentralized-finance ;
    vc:uses ngm:digital-signature,
        ngm:public-key-cryptography .

ngm:normal-map a owl:Class ;
    rdfs:label "Normal Map"@en ;
    rdfs:comment "A normal map is a texture that encodes per-texel surface normal directions, typically storing the X, Y, and Z components of a normal vector in the red, green, and blue channels. It allows a low-polygon mesh to react to lighting as if it had the fine geometric detail of a much denser surface, by perturbing the shading normal without changing the underlying geometry. Normal maps are a foundational technique in real-time and physically based rendering for adding visual detail efficiently."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gpu ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:texture-mapping ],
        ngm:texture-mapping ;
    vc:bridgesTo ngm:shader ;
    vc:dependsOn ngm:texture-mapping ;
    vc:enables ngm:physically-based-rendering ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:texture-mapping ;
    vc:implements ngm:rendering-technique ;
    vc:isPartOf ngm:physically-based-rendering ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:gpu,
        ngm:rendering-technique,
        ngm:spatial-computing ;
    vc:requires ngm:gpu ;
    vc:slug "normal-map" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:polygon-mesh ;
    vc:uses ngm:shader .

ngm:npu a owl:Class ;
    rdfs:label "NPU"@en ;
    rdfs:comment "A Neural Processing Unit (NPU) is a dedicated silicon accelerator architected to execute artificial neural network operations — principally matrix multiplications and activation functions — with far greater energy efficiency and throughput than general-purpose CPUs or GPUs. NPUs are integrated into mobile SoCs, edge devices, and data-centre accelerator cards to enable low-latency AI inference on-device. They are increasingly central to deploying large language models, computer vision pipelines, and speech recognition at the edge without relying on cloud round-trips."@en ;
    rdfs:subClassOf ngm:ai-hardware,
        ngm:ai-infrastructure ;
    vc:enables ngm:deep-learning,
        ngm:edge-computing,
        ngm:inference ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:ai-hardware,
        ngm:ai-infrastructure ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:fpga,
        ngm:hardware-acceleration,
        ngm:tpu ;
    vc:slug "npu" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:computer-vision,
        ngm:natural-language-processing,
        ngm:speech-recognition ;
    vc:uses ngm:neural-network .

ngm:object-recognition a owl:Class ;
    rdfs:label "Object Recognition"@en ;
    rdfs:comment "Object recognition is a computer vision task that involves identifying and localising instances of predefined object categories within images or video streams, producing class labels, bounding boxes, segmentation masks, or pose estimates depending on the task variant. It subsumes tasks including image classification, object detection, semantic segmentation, and instance segmentation, and has become a core capability of autonomous systems, augmented reality, and content understanding pipelines. Modern approaches are dominated by deep convolutional and transformer-based architectures trained on large annotated datasets."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:bounding-box-regression ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:annotated-training-data ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:non-maximum-suppression ],
        ngm:computer-vision-task ;
    vc:bridgesTo ngm:robotics,
        ngm:spatial-computing ;
    vc:contrastsWith ngm:image-classification ;
    vc:enables ngm:augmented-reality,
        ngm:autonomous-driving,
        ngm:robotics,
        ngm:scene-understanding,
        ngm:visual-question-answering ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:bounding-box-regression,
        ngm:non-maximum-suppression ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:foundation-model,
        ngm:image-classification,
        ngm:image-segmentation,
        ngm:object-detection,
        ngm:pattern-recognition,
        ngm:remote-sensing ;
    vc:requires ngm:annotated-training-data ;
    vc:slug "object-recognition" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:convolutional-neural-network,
        ngm:deep-learning,
        ngm:feature-extraction,
        ngm:neural-architecture-search,
        ngm:transfer-learning,
        ngm:vision-transformer .

ngm:octree-spatial-index a owl:Class ;
    rdfs:label "Octree Spatial Index"@en ;
    rdfs:comment "An octree spatial index is a tree data structure that recursively subdivides 3D space into eight octants, organising objects by their spatial location for efficient querying. It accelerates operations such as range queries, nearest-neighbour search, collision detection, and visibility culling by pruning regions that cannot contain relevant objects. It is a core building block for spatial partitioning in 3D engines and virtual worlds."@en ;
    rdfs:subClassOf ngm:sc-display-and-rendering ;
    skos:broader ngm:sc-display-and-rendering ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:vircadia ;
    vc:slug "octree-spatial-index" ;
    vc:sourceDomain "metaverse" .

ngm:ofcom a owl:Class ;
    rdfs:label "Ofcom"@en ;
    rdfs:comment "Ofcom (the Office of Communications) is the independent statutory regulator and competition authority for the UK communications industries, established by the Communications Act 2003. Its remit covers broadcasting, telecommunications, postal services, and — following the Online Safety Act 2023 — online platforms. It enforces spectrum management, sets licence conditions for broadcasters and telecoms operators, adjudicates on consumer complaints, and oversees compliance with the UK Online Safety Act framework requiring platforms to implement systems preventing access to illegal content."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:risk-assessment ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:transparency-reporting ],
        ngm:regulatory-authority ;
    vc:bridgesTo ngm:artificial-intelligence,
        ngm:infrastructure ;
    vc:contrastsWith ngm:co-regulation,
        ngm:self-regulation ;
    vc:enables ngm:compliance-monitoring,
        ngm:consumer-protection,
        ngm:content-moderation-standards,
        ngm:market-competition ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:age-verification ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:content-moderation,
        ngm:net-neutrality,
        ngm:online-safety-act-2023,
        ngm:spectrum-management,
        ngm:telecommunications-infrastructure,
        ngm:uk-online-safety-act ;
    vc:requires ngm:risk-assessment,
        ngm:transparency-reporting ;
    vc:slug "ofcom" ;
    vc:sourceDomain "governance" ;
    vc:standardizedBy ngm:compliance-framework,
        ngm:digital-regulation ;
    vc:supports ngm:child-safety-online,
        ngm:data-protection .

ngm:on-chain-transaction a owl:Class ;
    rdfs:label "On-Chain Transaction"@en ;
    rdfs:comment "An on-chain transaction is a value or state transfer that is broadcast to a blockchain network, validated by consensus, and permanently recorded in a block on the shared ledger. Because settlement occurs through the network's consensus mechanism, on-chain transactions inherit the chain's security, immutability, and public verifiability, but also its latency, throughput limits, and fee costs. They contrast with off-chain and layer-two approaches that defer or aggregate ledger updates to improve scalability."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gas ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:consensus ],
        ngm:blockchain-transaction ;
    vc:contrastsWith ngm:rollup,
        ngm:state-channel ;
    vc:dependsOn ngm:consensus,
        ngm:finality ;
    vc:enables ngm:settlement ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:distributed-ledger,
        ngm:ledger ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:bitcoin,
        ngm:ethereum,
        ngm:smart-contract,
        ngm:transaction ;
    vc:requires ngm:consensus,
        ngm:gas ;
    vc:slug "on-chain-transaction" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:block,
        ngm:mempool .

ngm:ontology-alignment a owl:Class ;
    rdfs:label "Ontology Alignment"@en ;
    rdfs:comment "Ontology alignment is the process of determining correspondences between the concepts, properties and relations of two or more separately developed ontologies. The output, an alignment or set of mappings, allows systems using different ontologies to interoperate by translating or relating their terms. Alignment is a core enabler of semantic interoperability across heterogeneous knowledge sources and is closely related to schema matching and entity resolution."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:reasoning ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:mapping ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ontology ],
        ngm:ontology ;
    vc:contrastsWith ngm:entity-resolution ;
    vc:enables ngm:data-integration,
        ngm:semantic-interoperability ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:mapping ;
    vc:isPartOf ngm:ontology ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:linked-data,
        ngm:owl,
        ngm:semantic-web ;
    vc:requires ngm:ontology,
        ngm:reasoning ;
    vc:slug "ontology-alignment" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:interoperability,
        ngm:knowledge-graph ;
    vc:uses ngm:reasoning .

ngm:opc-ua a owl:Class ;
    rdfs:label "OPC UA"@en ;
    rdfs:comment "OPC Unified Architecture (OPC UA) is an open, platform-independent, service-oriented communication standard developed by the OPC Foundation for secure and reliable data exchange in industrial automation and the Industrial Internet of Things. It provides a unified information model that merges process data, alarms, historical data, and device metadata into a single addressable namespace accessible via TCP binary or HTTPS transport, replacing the earlier COM/DCOM-based OPC Classic specifications with a cross-platform, scalable architecture."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:x-509-certificate ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:tcp-ip ],
        ngm:interoperability-standard ;
    vc:bridgesTo ngm:cloud-computing,
        ngm:edge-computing ;
    vc:contrastsWith ngm:profinet ;
    vc:enables ngm:digital-twin,
        ngm:industrial-automation,
        ngm:industrial-io-t,
        ngm:real-time-monitoring,
        ngm:smart-manufacturing ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:publish-subscribe-pattern,
        ngm:service-oriented-architecture ;
    vc:isPartOf ngm:industry-4-0 ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:control-system,
        ngm:programmable-logic-controller,
        ngm:scada,
        ngm:sensor ;
    vc:requires ngm:tcp-ip,
        ngm:x-509-certificate ;
    vc:slug "opc-ua" ;
    vc:sourceDomain "infrastructure" ;
    vc:standardizedBy ngm:iec,
        ngm:opc-foundation ;
    vc:uses ngm:mqtt,
        ngm:open-standard,
        ngm:semantic-interoperability .

ngm:optical-tracking a owl:Class ;
    rdfs:label "Optical Tracking"@en ;
    rdfs:comment "A sensing technology that uses camera-based systems and computer vision algorithms to determine the position and orientation of objects or users within physical space. Implementations range from marker-based infrared systems achieving sub-millimetre accuracy to markerless inside-out tracking using SLAM, enabling motion capture, hand tracking, and environmental mapping for XR applications."@en ;
    rdfs:subClassOf ngm:infra-computing-and-cloud ;
    skos:broader ngm:infra-computing-and-cloud ;
    vc:dependsOn ngm:photogrammetry,
        ngm:structure-from-motion ;
    vc:enables ngm:hand-tracking,
        ngm:motion-capture,
        ngm:xr-runtime-environment ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:slug "optical-tracking" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:computer-vision,
        ngm:pose-estimation,
        ngm:slam .

ngm:pddl a owl:Class ;
    rdfs:label "PDDL"@en ;
    rdfs:comment "The Planning Domain Definition Language (PDDL) is a standardised formal language for encoding automated-planning problems as domains and problem instances. A domain specifies predicates and actions with preconditions and effects, while a problem instance defines objects, an initial state, and a goal. PDDL provides a common input format that lets generic planners compute action sequences, and it underpins much of classical AI task planning."@en ;
    rdfs:subClassOf ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:task-planning ;
    vc:slug "pddl" ;
    vc:sourceDomain "ai" .

ngm:perception-module a owl:Class ;
    rdfs:label "Perception Module"@en ;
    rdfs:comment "A perception module is the component of an autonomous or cognitive agent that transforms raw sensory input into structured representations of the environment. It performs sensing, filtering, feature extraction, object detection, and state estimation to produce a world model usable by planning and control. As the agent's interface to reality, its accuracy bounds the quality of all downstream decisions."@en ;
    rdfs:subClassOf ngm:ai-infrastructure ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:autonomous-agent,
        ngm:cognitive-ai ;
    vc:slug "perception-module" ;
    vc:sourceDomain "ai" .

ngm:personal-data a owl:Class ;
    rdfs:label "Personal Data"@en ;
    rdfs:comment "Personal data is any information relating to an identified or identifiable natural person, known as the data subject. Under data protection regimes such as the GDPR, identifiability can be direct (a name or identification number) or indirect (factors specific to a person's physical, economic, cultural or social identity). Special categories such as health, biometric or political data attract heightened protection. The concept anchors most privacy and data governance obligations, determining when processing rules, consent requirements and individual rights apply."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:consent-management ],
        ngm:data-governance ;
    vc:bridgesTo ngm:identity ;
    vc:contrastsWith ngm:anonymisation ;
    vc:dependsOn ngm:gdpr,
        ngm:privacy ;
    vc:enables ngm:personal-data-store ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:data-protection ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:data-breach,
        ngm:data-privacy,
        ngm:right-to-be-forgotten,
        ngm:surveillance ;
    vc:requires ngm:consent-management ;
    vc:slug "personal-data" ;
    vc:sourceDomain "governance" ;
    vc:standardizedBy ngm:gdpr ;
    vc:supports ngm:data-sovereignty ;
    vc:uses ngm:anonymisation,
        ngm:pseudonymisation .

ngm:pharmaceutical-traceability a owl:Class ;
    rdfs:label "Pharmaceutical Traceability"@en ;
    rdfs:comment "Blockchain-based pharmaceutical supply chain systems employing unit-level serialisation, immutable audit trails, and automated smart-contract verification to combat counterfeit medicines, enable DSCSA and EU FMD regulatory compliance, and deliver cold-chain monitoring and clinical-trial supply management across consortium networks such as MediLedger."@en ;
    rdfs:subClassOf ngm:bc-network-component ;
    skos:broader ngm:bc-network-component ;
    vc:enables ngm:audit-trail,
        ngm:compliance-verification,
        ngm:provenance-tracking ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:blockchain-compliance,
        ngm:consortium-blockchain,
