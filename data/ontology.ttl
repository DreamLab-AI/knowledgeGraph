    skos:broader ngm:sc-platform-and-environment ;
    vc:dependsOn ngm:distributed-system ;
    vc:enables ngm:metaverse,
        ngm:mixed-reality-platform ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:avatar,
        ngm:network-quality-metric ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:requires ngm:latency,
        ngm:networking-technology ;
    vc:slug "multi-user-systems" ;
    vc:sourceDomain "spatial-computing" .

ngm:nakamoto-coefficient a owl:Class ;
    rdfs:label "Nakamoto Coefficient"@en ;
    rdfs:comment "The Nakamoto Coefficient is a quantitative metric for blockchain decentralisation, defined as the minimum number of independent entities in a given subsystem (such as mining pool concentration, validator set, or client software diversity) whose collusion or failure would be sufficient to compromise network security, liveness, or integrity. A higher Nakamoto Coefficient indicates a more resilient, decentralised network; a coefficient of one denotes a single point of failure. The metric is applicable across multiple dimensions of a network simultaneously, yielding a multi-dimensional decentralisation profile rather than a single scalar."@en ;
    rdfs:subClassOf ngm:bc-governance-and-regulation ;
    skos:broader ngm:bc-governance-and-regulation ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:51-attack,
        ngm:blockchain-governance,
        ngm:sybil-resistance ;
    vc:slug "nakamoto-coefficient" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:proof-of-stake,
        ngm:validator-set .

ngm:nav2 a owl:Class ;
    rdfs:label "Nav2"@en ;
    rdfs:comment "Nav2 (Navigation2) is the production-ready autonomous navigation framework for ROS 2, providing a composable, lifecycle-managed stack of planners, controllers, costmap layers, and behaviour-tree-based task orchestration. It enables mobile robots to safely compute and execute collision-free paths in structured and semi-structured environments."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ros-2 ],
        ngm:navigation-stack ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:autonomous-mobile-robots,
        ngm:autonomous-navigation ;
    vc:requires ngm:ros-2 ;
    vc:slug "nav2" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:behavior-tree,
        ngm:costmap .

ngm:ne-rf a owl:Class ;
    rdfs:label "NeRF"@en ;
    rdfs:comment "Neural Radiance Field (NeRF) is a neural scene representation technique that encodes a continuous volumetric scene as a multi-layer perceptron mapping 3D coordinates and viewing directions to colour and density values, enabling photorealistic novel view synthesis from a sparse set of input images. Originally introduced by Mildenhall et al. in 2020, NeRF uses volumetric ray marching during rendering to integrate along rays through the implicit field, producing high-fidelity reconstructions without explicit geometry. It has catalysed a broad family of neural rendering methods spanning real-time variants, dynamic scenes, and large-scale outdoor capture."@en ;
    rdfs:subClassOf ngm:neural-radiance-field ;
    vc:enables ngm:3-d-reconstruction,
        ngm:novel-view-synthesis,
        ngm:photorealistic-rendering ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:augmented-reality,
        ngm:point-cloud,
        ngm:volumetric-capture ;
    vc:slug "ne-rf" ;
    vc:sourceDomain "graphics" ;
    vc:uses ngm:deep-learning,
        ngm:differentiable-rendering,
        ngm:neural-network .

ngm:network-function-virtualization a owl:Class ;
    rdfs:label "Network Function Virtualization"@en ;
    rdfs:comment "A network architecture approach that decouples network functions from proprietary hardware by deploying them as virtual machines or containers on commercial off-the-shelf servers, enabling flexible, scalable network services without vendor lock-in."@en ;
    rdfs:subClassOf ngm:network-architecture,
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:enables ngm:network-scalability ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:slug "network-function-virtualization" ;
    vc:sourceDomain "spatial-computing" .

ngm:neural-architecture-search a owl:Class ;
    rdfs:label "Neural Architecture Search"@en ;
    rdfs:comment "Neural Architecture Search (NAS) is an automated machine learning technique that searches a defined space of neural network designs to discover architectures that maximise predictive performance or satisfy multi-objective constraints such as latency, parameter count, and energy consumption. NAS algorithms explore the architecture search space using strategies that include reinforcement learning, evolutionary algorithms, differentiable relaxations (DARTS), and predictor-based approaches, each making different trade-offs between search cost and solution quality. The field emerged from the observation that hand-designed architectures require substantial expert knowledge and iterative experimentation, and that automated search can discover non-obvious configurations that outperform human-designed baselines on targeted hardware or task distributions."@en ;
    rdfs:subClassOf ngm:auto-ml ;
    vc:enables ngm:knowledge-distillation-for-edge,
        ngm:model-compression-for-edge ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:deep-learning,
        ngm:machine-learning-pipeline,
        ngm:neural-network-architecture ;
    vc:slug "neural-architecture-search" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:differentiable-architecture,
        ngm:hyperparameter-tuning,
        ngm:machine-learning-framework .

ngm:notary-service a owl:Class ;
    rdfs:label "Notary Service"@en ;
    rdfs:comment "A notary service is a trusted third-party function that attests to the authenticity, integrity, and existence of a document or digital artefact at a specific point in time, producing a tamper-evident record legally admissible as proof. In digital contexts, notary services hash document content and anchor that hash to a verifiable ledger — blockchain or traditional timestamping authority — binding the evidence to a precise timestamp without revealing the document contents. They bridge traditional legal document authentication with cryptographic proof mechanisms, enabling use cases ranging from intellectual property protection to supply chain provenance. Blockchain-anchored notary services eliminate single-point-of-failure trust assumptions present in classical certificate-authority-based approaches."@en ;
    rdfs:subClassOf ngm:security-services ;
    vc:enables ngm:credential-verification,
        ngm:supply-chain-provenance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:compliance-verification,
        ngm:formal-verification,
        ngm:virtual-notary-service ;
    vc:slug "notary-service" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:cryptographic-hash,
        ngm:digital-certificate,
        ngm:digital-signature-verification .

ngm:novel-view-synthesis a owl:Class ;
    rdfs:label "Novel View Synthesis"@en ;
    rdfs:comment "Novel view synthesis (NVS) is a computer vision and computer graphics task that involves generating photorealistic images of a scene from camera viewpoints not present in the original set of captured images, given a collection of reference photographs and their corresponding camera poses. The task requires learning an implicit or explicit representation of the scene's geometry and appearance that supports free-viewpoint rendering with high fidelity. It is a foundational capability for immersive media, telepresence, and spatial computing applications, and has been dramatically advanced by neural scene representations such as Neural Radiance Fields and 3D Gaussian Splatting."@en ;
    rdfs:subClassOf ngm:computer-vision-task ;
    vc:enables ngm:virtual-reality-telepresence,
        ngm:volumetric-capture ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:3-d-gaussian-splatting,
        ngm:differentiable-rendering,
        ngm:neural-radiance-field,
        ngm:photogrammetry ;
    vc:slug "novel-view-synthesis" ;
    vc:sourceDomain "graphics" ;
    vc:uses ngm:camera-calibration,
        ngm:depth-estimation,
        ngm:neural-rendering .

ngm:numerical-methods a owl:Class ;
    rdfs:label "Numerical Methods"@en ;
    rdfs:comment "Techniques for obtaining approximate solutions to mathematical problems that cannot be solved exactly, using finite sequences of arithmetic operations."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:differential-equations ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:linear-algebra ],
        ngm:owl-thing ;
    vc:enables ngm:simulation ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:differential-equations,
        ngm:linear-algebra ;
    vc:slug "numerical-methods" ;
    vc:sourceDomain "mathematics" .

ngm:occlusion-culling a owl:Class ;
    rdfs:label "Occlusion Culling"@en ;
    rdfs:comment "A real-time rendering optimisation technique that identifies and discards geometry hidden from the viewer's perspective before the GPU processes it. By eliminating draw calls for fully occluded objects, occlusion culling reduces GPU load and enables higher frame rates in complex virtual environments such as virtual worlds and XR applications."@en ;
    rdfs:subClassOf ngm:sc-display-and-rendering ;
    skos:broader ngm:sc-display-and-rendering ;
    vc:enables ngm:gpu-compute,
        ngm:virtual-environment ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:real-time-rendering,
        ngm:render-pipeline ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:collision-detection,
        ngm:level-of-detail ;
    vc:slug "occlusion-culling" ;
    vc:sourceDomain "spatial-computing" .

ngm:occupancy-grid a owl:Class ;
    rdfs:label "Occupancy Grid"@en ;
    rdfs:comment "An occupancy grid is a probabilistic spatial representation of a robot's environment as a discretised lattice of cells, each storing a probability or log-odds value indicating the likelihood that the corresponding region of space is occupied by an obstacle. It provides a metric map suitable for collision avoidance, path planning, and SLAM by fusing noisy sensor measurements through Bayesian updates."@en ;
    rdfs:subClassOf ngm:environment-mapping ;
    vc:enables ngm:motion-planning ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:point-cloud,
        ngm:slam ;
    vc:slug "occupancy-grid" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:lidar-sensor,
        ngm:sensor-fusion .

ngm:omnichannel a owl:Class ;
    rdfs:label "Omnichannel"@en ;
    rdfs:comment "Omnichannel is a customer engagement strategy that unifies all interaction channels — physical stores, web, mobile, social media, telephone, and messaging — into a single, consistent experience in which customer context and history transfer seamlessly across channel boundaries. Unlike multichannel approaches that operate channels in silos, omnichannel architectures share a common data layer and orchestration engine so that a session started on one channel can be continued on another without loss of state."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:customer-data-platform ],
        ngm:customer-experience-management ;
    vc:enables ngm:customer-experience,
        ngm:customer-retention ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:crm,
        ngm:omnichannel-routing ;
    vc:requires ngm:customer-data-platform ;
    vc:slug "omnichannel" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:conversational-ai .

ngm:onion-routing a owl:Class ;
    rdfs:label "Onion Routing"@en ;
    rdfs:comment "Onion routing is an anonymous-communication technique in which messages are wrapped in successive layers of encryption and relayed through a sequence of intermediary nodes, each of which removes one layer to learn only the next hop. Because no single relay knows both the source and destination, onion routing conceals the network path and protects communication metadata. It is the basis of the Tor network and is adapted in systems such as the Lightning Network for private multi-hop payment forwarding."@en ;
    rdfs:subClassOf ngm:network-protocol ;
    vc:enables ngm:censorship-resistance,
        ngm:privacy ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:communication-protocol ;
    vc:slug "onion-routing" ;
    vc:sourceDomain "security" ;
    vc:uses ngm:encryption,
        ngm:public-key-cryptography .

ngm:open-source-development a owl:Class ;
    rdfs:label "Open Source Development"@en ;
    rdfs:comment "Open source development is a software production methodology in which source code is made publicly available under licences permitting inspection, modification, and redistribution, enabling distributed communities of contributors to collaboratively build and maintain software. The model contrasts with proprietary development by prioritising transparency, peer review, and meritocratic contribution over closed, hierarchical ownership. It encompasses practices including version-controlled public repositories, issue tracking, pull-request-based code review, and community governance structures. Open source development has become the dominant paradigm for infrastructure software, AI frameworks, and blockchain protocols."@en ;
    rdfs:subClassOf ngm:software-development ;
    vc:enables ngm:collaboration-platform,
        ngm:open-source-ai ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:open-source-framework,
        ngm:open-source-software,
        ngm:version-control ;
    vc:slug "open-source-development" ;
    vc:sourceDomain "ai" ;
    vc:supports ngm:ai-augmented-software-engineering,
        ngm:community-governance ;
    vc:uses ngm:software-development-process .

ngm:open-telemetry a owl:Class ;
    rdfs:label "OpenTelemetry"@en ;
    rdfs:comment "OpenTelemetry (OTel) is a vendor-neutral open-source observability framework and CNCF project that provides unified APIs, SDKs, agents, and wire protocols for collecting distributed traces, metrics, and logs from software systems. It merges the OpenTracing and OpenCensus projects into a single standardised instrumentation layer, enabling consistent telemetry data collection regardless of the backend analysis platform. OpenTelemetry's OpenTelemetry Protocol (OTLP) has become the de-facto standard for telemetry data transport in cloud-native environments."@en ;
    rdfs:subClassOf ngm:monitoring-system ;
    vc:enables ngm:cloud-native-applications,
        ngm:microservices-architecture ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:monitoring-dashboard,
        ngm:performance-metrics,
        ngm:real-time-monitoring ;
    vc:slug "open-telemetry" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:kubernetes ;
    vc:uses ngm:api-standard,
        ngm:distributed-system .

ngm:open-usd a owl:Class ;
    rdfs:label "OpenUSD"@en ;
    rdfs:comment "OpenUSD (Universal Scene Description) is an open-source framework and file format developed by Pixar Animation Studios for composing, simulating, collaborating on, and exchanging richly structured 3D scenes across digital content creation tools and real-time rendering pipelines. USD encodes a hierarchical scene graph with support for layered composition, non-destructive overrides, and time-sampled animation, enabling multiple departments or tools to contribute to a shared scene without overwriting each other's work. OpenUSD has been adopted as the foundation for Apple's RealityKit (.usdz), NVIDIA's Omniverse platform, and the emerging ISO/IEC 22886 standard for 3D scene exchange."@en ;
    rdfs:subClassOf ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:contrastsWith ngm:gltf-standard ;
    vc:enables ngm:3-d-content-pipeline,
        ngm:digital-twin ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:3-d-asset,
        ngm:3-d-asset-standard,
        ngm:rendering-pipeline ;
    vc:slug "open-usd" ;
    vc:sourceDomain "spatial-computing" .

ngm:owl a owl:Class ;
    rdfs:label "OWL"@en ;
    rdfs:comment "OWL (Web Ontology Language) is a W3C-standardised semantic web language for defining and sharing ontologies on the World Wide Web, built on RDF and grounded in Description Logics to provide formal semantics with decidable reasoning. OWL enables the specification of classes, properties, individuals, and axioms that constrain their relationships, supporting automated inference and knowledge graph construction."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:rdf ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:description-logic ],
        ngm:semantic-web ;
    vc:enables ngm:knowledge-graph,
        ngm:knowledge-representation ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:owl-2-web-ontology-language,
        ngm:sparql ;
    vc:requires ngm:description-logic,
        ngm:rdf ;
    vc:slug "owl" ;
    vc:sourceDomain "ai" .

ngm:panoptic-segmentation a owl:Class ;
    rdfs:label "Panoptic Segmentation"@en ;
    rdfs:comment "A computer vision task that unifies semantic segmentation and instance segmentation by assigning every image pixel both a class label and an instance identifier, providing holistic scene parsing that distinguishes countable foreground objects (\"things\") from amorphous background regions (\"stuff\"). Architectures such as Panoptic FPN, Panoptic-DeepLab, and MaskFormer formalise this unified representation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:object-detection ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:instance-segmentation ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:semantic-segmentation ],
        ngm:sc-interaction ;
    skos:broader ngm:sc-interaction ;
    vc:enables ngm:scene-understanding ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:instance-segmentation,
        ngm:semantic-segmentation ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:relatedTo ngm:computer-vision-task ;
    vc:requires ngm:object-detection ;
    vc:slug "panoptic-segmentation" ;
    vc:sourceDomain "spatial-computing" .

ngm:perception a owl:Class ;
    rdfs:label "Perception"@en ;
    rdfs:comment "In artificial intelligence, the capability of a system to acquire and interpret sensory input, such as images, audio or other signals, to build an internal representation of its environment."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:sensor ],
        ngm:artificial-intelligence ;
    skos:broader ngm:artificial-intelligence ;
    vc:enables ngm:robotics ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:sensor ;
    vc:slug "perception" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:pharmaceutical-supply-chain a owl:Class ;
    rdfs:label "Pharmaceutical Supply Chain"@en ;
    rdfs:comment "The Pharmaceutical Supply Chain encompasses all entities, processes, and systems involved in the production, storage, distribution, and dispensing of medicinal products, from active pharmaceutical ingredient (API) synthesis through to patient delivery. It is subject to stringent regulatory serialisation and traceability requirements designed to prevent counterfeit medicines from entering the legitimate supply chain."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:dscsa-compliance ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:pharmaceutical-traceability ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:rfid ],
        ngm:supply-chain-management ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.85"^^xsd:float ;
    vc:relatedTo ngm:blockchain-provenance,
        ngm:cold-chain-monitoring ;
    vc:requires ngm:dscsa-compliance,
        ngm:pharmaceutical-traceability,
        ngm:rfid ;
    vc:slug "pharmaceutical-supply-chain" ;
    vc:sourceDomain "governance" ;
    vc:uses ngm:pharmaceutical-logistics .

ngm:planning a owl:Class ;
    rdfs:label "Planning"@en ;
    rdfs:comment "In artificial intelligence, the process of selecting a sequence of actions that transforms an initial state into a desired goal state, given a model of how actions change the world."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:search-algorithm ],
        ngm:artificial-intelligence ;
    skos:broader ngm:artificial-intelligence ;
    vc:enables ngm:autonomous-agent ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:search-algorithm ;
    vc:slug "planning" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:platform-economy a owl:Class ;
    rdfs:label "Platform Economy"@en ;
    rdfs:comment "The Platform Economy describes an economic model in which digital intermediaries — platforms — create value by facilitating interactions, transactions, and information exchanges between two or more distinct user groups, typically producers and consumers. Platforms achieve scale through network effects: the value of the platform increases with the number of participants on one or both sides, creating winner-take-most market dynamics. Major platform types include transaction platforms (e-commerce, gig labour), innovation platforms (app stores, developer ecosystems), and content platforms (social media, streaming). Platform operators capture value through transaction fees, data monetisation, advertising, and software licences while externalising costs and risks to platform participants."@en ;
    rdfs:subClassOf ngm:digital-platform ;
    vc:enables ngm:digital-marketplace,
        ngm:metaverse-platform,
        ngm:nft-marketplace ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:creator-economy,
        ngm:marketplace,
        ngm:platform-governance ;
    vc:slug "platform-economy" ;
    vc:sourceDomain "finance" ;
    vc:supports ngm:creator-monetization,
        ngm:marketplace-integration ;
    vc:uses ngm:platform-layer,
        ngm:platform-service .

ngm:platform-engineering a owl:Class ;
    rdfs:label "Platform Engineering"@en ;
    rdfs:comment "Platform Engineering is the discipline of designing, building, and operating internal developer platforms (IDPs) that abstract infrastructure complexity and provide self-service toolchains, automated CI/CD pipelines, and standardised operational workflows for software engineering teams. It treats the IDP as a product, applying product management techniques to improve developer experience and reduce cognitive load. Platform Engineering sits at the intersection of DevOps, site reliability engineering, and cloud-native infrastructure."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:version-control ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:infrastructure-architecture ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:api-gateway ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:orchestration ],
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:enables ngm:digital-transformation,
        ngm:software-engineering ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:api-gateway,
        ngm:infrastructure-architecture,
        ngm:orchestration,
        ngm:version-control ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:computing-platform,
        ngm:development-platform,
        ngm:digital-infrastructure,
        ngm:industry-cloud-platforms,
        ngm:service-oriented-architecture ;
    vc:slug "platform-engineering" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:cloud-infrastructure,
        ngm:cloud-native-applications,
        ngm:microservices-architecture .

ngm:polkadot a owl:Class ;
    rdfs:label "Polkadot"@en ;
    rdfs:comment "Polkadot is a heterogeneous multi-chain blockchain protocol designed by Gavin Wood and developed by Parity Technologies that enables independent blockchains — called parachains — to connect to a central relay chain, share its pooled security, and exchange messages and assets through the Cross-Consensus Message format. Its nominated proof-of-stake consensus mechanism uses DOT token validators to secure the relay chain whilst parachains benefit from shared security without needing to bootstrap their own validator sets. Polkadot is built on the Substrate framework, which allows developers to construct purpose-built application chains that plug into the ecosystem."@en ;
    rdfs:subClassOf ngm:blockchain-protocol ;
    vc:contrastsWith ngm:cosmos-ibc ;
    vc:enables ngm:blockchain-interoperability,
        ngm:cross-chain-messaging ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:cross-chain-interoperability,
        ngm:nominated-proof-of-stake,
        ngm:polkadot-parachains ;
    vc:slug "polkadot" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:validator-set,
        ngm:web-assembly .

ngm:position-sensor a owl:Class ;
    rdfs:label "Position Sensor"@en ;
    rdfs:comment "A position sensor is a transducer that measures the displacement, angle, or spatial location of an object or joint relative to a reference frame, converting mechanical position into an electrical signal suitable for control system feedback. Position sensors are fundamental to closed-loop robotic and mechatronic systems, enabling precise joint control, end-effector placement, and localisation. They span a wide range of physical measurement principles including optical encoding, magnetic hall-effect sensing, capacitive displacement, and inductive resolver techniques."@en ;
    rdfs:subClassOf ngm:sensor ;
    vc:enables ngm:localization,
        ngm:robot-manipulation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:encoder,
        ngm:imu,
        ngm:linear-encoder,
        ngm:proprioceptive-sensor,
        ngm:rotary-encoder ;
    vc:slug "position-sensor" ;
    vc:sourceDomain "robotics" ;
    vc:supports ngm:robot-kinematics,
        ngm:robotic-control .

ngm:precision-manufacturing a owl:Class ;
    rdfs:label "Precision Manufacturing"@en ;
    rdfs:comment "Precision manufacturing is a set of industrial processes and quality systems that produce mechanical components and assemblies within extremely tight dimensional tolerances — typically sub-micrometre to nanometre scale — using advanced machining, metrology, and process control techniques. It encompasses CNC machining, ultra-precision grinding, electrical discharge machining (EDM), and micro-fabrication, combined with in-process measurement and statistical process control to ensure conformance to specification. Precision manufacturing is fundamental to the production of optical systems, semiconductor equipment, aerospace components, medical implants, and scientific instruments where dimensional accuracy directly determines system performance."@en ;
    rdfs:subClassOf ngm:manufacturing-automation ;
    vc:enables ngm:digital-twin,
        ngm:industrial-robot ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:digital-fabrication,
        ngm:display-metrology,
        ngm:industrial-automation,
        ngm:quality-assurance ;
    vc:slug "precision-manufacturing" ;
    vc:sourceDomain "hardware" ;
    vc:uses ngm:industrial-inspection,
        ngm:smart-manufacturing .

ngm:predictive-personalization a owl:Class ;
    rdfs:label "Predictive Personalization"@en ;
    rdfs:comment "The use of machine learning models to anticipate individual user preferences and dynamically tailor content, recommendations, interfaces, and experiences before an explicit request is made. Systems combine behavioural analytics, user profiling, and predictive models to deliver contextually relevant personalisation at scale."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-governance ],
        ngm:ai-application ;
    skos:broader ngm:ai-application ;
    vc:enables ngm:user-experience ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:natural-language-processing,
        ngm:predictive-analytics,
        ngm:recommendation-engine,
        ngm:user-experience ;
    vc:requires ngm:data-governance ;
    vc:slug "predictive-personalization" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:behavioral-analytics,
        ngm:machine-learning,
        ngm:machine-learning-model .

ngm:prefix-tuning a owl:Class ;
    rdfs:label "Prefix Tuning"@en ;
    rdfs:comment "A parameter-efficient fine-tuning technique that prepends trainable continuous vectors (prefixes) to the key and value matrices at each transformer layer, whilst keeping the pre-trained model parameters frozen. Unlike prompt tuning, which operates only on input embeddings, prefix tuning influences the attention mechanism at every layer, achieving stronger task-specific adaptation with roughly 0.1% of model parameters."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:fine-tuning ],
        ngm:parameter-efficient-fine-tuning ;
    vc:contrastsWith ngm:adapter-modules,
        ngm:prompt-tuning ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:parameter-efficient-fine-tuning ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires ngm:fine-tuning ;
    vc:slug "prefix-tuning" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:attention-mechanism,
        ngm:transfer-learning .

ngm:pressure-sensor a owl:Class ;
    rdfs:label "Pressure Sensor"@en ;
    rdfs:comment "Pressure Sensor is a robotics and autonomous systems concept and a type of robotics."@en ;
    rdfs:subClassOf ngm:robo-perception,
        ngm:sensor ;
    skos:broader ngm:robo-perception ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:slug "pressure-sensor" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:robotics .

ngm:privacy-enhancing-technologies a owl:Class ;
    rdfs:label "Privacy Enhancing Technologies"@en ;
    rdfs:comment "Privacy Enhancing Technologies (PETs) are a family of cryptographic and systems-engineering techniques designed to minimise the collection, use, and disclosure of personal data while still enabling legitimate data processing for analytics, machine learning, and regulatory compliance. The family encompasses Zero-Knowledge Proofs, Differential Privacy, Homomorphic Encryption, Secure Multi-Party Computation, Trusted Execution Environments, anonymisation pipelines, pseudonymisation, and synthetic data generation. PETs implement the data-minimisation and privacy-by-design principles mandated by frameworks such as GDPR and the UK Data Protection Act 2018. They are increasingly deployed by financial institutions, healthcare providers, and government agencies to unlock the utility of sensitive data without exposing individual records, and are recognised by the UK ICO, European Data Protection Board, and US NIST as essential infrastructure for trustworthy data ecosystems."@en ;
    rdfs:subClassOf ngm:privacy-preserving-technology ;
    vc:enables ngm:data-minimisation,
        ngm:privacy-preserving-analytics ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:data-protection,
        ngm:gdpr,
        ngm:privacy-by-design ;
    vc:slug "privacy-enhancing-technologies" ;
    vc:sourceDomain "security" ;
    vc:supports ngm:data-protection-regulation ;
    vc:uses ngm:differential-privacy,
        ngm:homomorphic-encryption,
        ngm:secure-multi-party-computation,
        ngm:zero-knowledge-proof .

ngm:privacy-preserving-authentication a owl:Class ;
    rdfs:label "Privacy-Preserving Authentication"@en ;
    rdfs:comment "Privacy-preserving authentication encompasses cryptographic mechanisms that allow a party to prove identity, membership, or credential possession to a verifier without revealing the underlying identity attributes, credential content, or linkage information across sessions. Core techniques include zero-knowledge proofs, anonymous credentials (e.g., U-Prove, BBS+), blind signatures, and selective disclosure, enabling authentication that is both unforgeable and unlinkable. The goal is to satisfy verifier assurance requirements while minimising the personal data exposed in each authentication event."@en ;
    rdfs:subClassOf ngm:authentication ;
    vc:enables ngm:decentralised-identity,
        ngm:verifiable-credentials ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:privacy-preserving-identity,
        ngm:selective-disclosure,
        ngm:zero-knowledge-proof ;
    vc:slug "privacy-preserving-authentication" ;
    vc:sourceDomain "security" ;
    vc:supports ngm:privacy-by-design ;
    vc:uses ngm:cryptographic-proof,
        ngm:zero-knowledge-proof-zkp .

ngm:proportional-valve a owl:Class ;
    rdfs:label "Proportional Valve"@en ;
    rdfs:comment "A proportional valve is a fluid-power control element that modulates flow rate, pressure, or direction continuously and proportionally in response to an electrical command signal, in contrast to on/off solenoid valves that switch between two discrete states. The valve's spool or poppet position is controlled by a proportional solenoid or voice-coil actuator whose force output is linearly related to the applied current, enabling smooth, variable control of hydraulic or pneumatic systems."@en ;
    rdfs:subClassOf ngm:fluid-power-device ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:isPartOf ngm:industrial-automation ;
    vc:qualityScore "0.85"^^xsd:float ;
    vc:relatedTo ngm:hydraulic-actuator,
        ngm:pneumatic-actuator,
        ngm:servo-valve ;
    vc:slug "proportional-valve" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:feedback-control,
        ngm:pid-controller .

ngm:proprioceptive-sensor a owl:Class ;
    rdfs:label "Proprioceptive Sensor"@en ;
    rdfs:comment "ProprioceptiveSensor is a transducer or sensing system that measures a robot's internal physical state — encompassing joint angle, angular velocity, linear and angular acceleration, motor torque, drive current, strain, and contact force — without reference to external landmarks or environmental f..."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:sensor-calibration ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:signal-conditioning ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:current-sensor ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:analog-to-digital-converter ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:inertial-measurement-unit ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:force-torque-sensor ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:real-time-operating-system ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:tactile-sensor ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:motor-driver ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:joint-encoder ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:actuator ],
        ngm:robo-actuation-and-control,
        ngm:robo-perception ;
    skos:broader ngm:robo-actuation-and-control,
        ngm:robo-perception ;
    vc:enables ngm:closed-loop-control,
        ngm:collision-detection,
        ngm:impedance-control,
        ngm:legged-locomotion,
        ngm:safe-physical-human-robot-interaction,
        ngm:sensor-fusion,
        ngm:state-estimation,
        ngm:torque-control ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:current-sensor,
        ngm:force-torque-sensor,
        ngm:inertial-measurement-unit,
        ngm:joint-encoder,
        ngm:resolver,
        ngm:strain-gauge,
        ngm:tachometer,
        ngm:tactile-sensor ;
    vc:implements ngm:hall-effect-sensing,
        ngm:mems-gyroscope,
        ngm:photometric-stereo,
        ngm:quadrature-encoding,
        ngm:series-elastic-actuation,
        ngm:wheatstone-bridge-measurement ;
    vc:qualityScore "0.52"^^xsd:float ;
    vc:relatedTo ngm:digital-twin,
        ngm:model-predictive-control,
        ngm:reinforcement-learning-for-robotics,
