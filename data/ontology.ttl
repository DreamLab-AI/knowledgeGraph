            owl:someValuesFrom ngm:large-language-models ],
        ngm:language-modeling ;
    vc:bridgesTo ngm:agent-frameworks,
        ngm:knowledge-graphing ;
    vc:contrastsWith ngm:image-generation,
        ngm:speech-and-voice ;
    vc:dependsOn ngm:language-modeling,
