    vc:requires ngm:cybersecurity ;
    vc:slug "penetration-testing" ;
    vc:sourceDomain "cryptographic" .

ngm:perception-module a owl:Class ;
    rdfs:label "Perception Module"@en ;
    rdfs:comment "A perception module is the component of an autonomous or cognitive agent that transforms raw sensory input into structured representations of the environment. It performs sensing, filtering, feature extraction, object detection, and state estimation to produce a world model usable by planning and control. As the agent's interface to reality, its accuracy bounds the quality of all downstream decisions."@en ;
    rdfs:subClassOf ngm:ai-infrastructure ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:autonomous-agent,
        ngm:cognitive-ai ;
    vc:slug "perception-module" ;
    vc:sourceDomain "ai" .

ngm:persistence-layer a owl:Class ;
    rdfs:label "Persistence Layer"@en ;
    rdfs:comment "A persistence layer is the architectural tier responsible for durably storing and retrieving application state across sessions and process restarts. It abstracts the underlying storage technology, databases, object stores, or distributed logs, behind a uniform interface for reading and writing data. In agent and spatial-computing systems it preserves memory, anchors, and context so that state survives beyond a single runtime."@en ;
    rdfs:subClassOf ngm:infra-data-management ;
    skos:broader ngm:infra-data-management ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:agent-frameworks,
        ngm:spatial-anchor ;
    vc:slug "persistence-layer" ;
    vc:sourceDomain "infrastructure" .

ngm:personalised-learning a owl:Class ;
    rdfs:label "Personalised Learning"@en ;
    rdfs:comment "Personalised learning is an educational approach in which the pace, content, modality, and assessment of instruction are dynamically adapted to the knowledge state, learning style, goals, and preferences of the individual learner. Technology-enabled personalised learning uses data about learner interactions and performance to drive adaptive algorithms that present the most effective next learning experience for each person, contrasting with one-size-fits-all curriculum delivery."@en ;
    rdfs:subClassOf ngm:adaptive-learning ;
    vc:enables ngm:education-and-ai,
        ngm:immersive-learning ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:curriculum-learning,
        ngm:education-technology,
        ngm:educational-methodology ;
    vc:slug "personalised-learning" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:federated-learning,
        ngm:knowledge-graph,
        ngm:large-language-models .

ngm:physics-based-animation a owl:Class ;
    rdfs:label "Physics-Based Animation"@en ;
    rdfs:comment "Animation technique that computes object motion through real-time simulation of physical forces, gravity, collisions, and dynamics to create realistic movement and interactions."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:collision-detection-system ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:animation-controller ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:physics-engine ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:physics-simulation-engine ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:constraint-solver ],
        ngm:real-time-rendering,
        ngm:sc-display-and-rendering ;
    skos:broader ngm:sc-display-and-rendering ;
    vc:enables ngm:cloth-simulation,
        ngm:dynamic-character-animation,
        ngm:particle-systems,
        ngm:ragdoll-physics ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:collision-detection-system,
        ngm:constraint-solver,
        ngm:force-integrator,
        ngm:physics-simulation-engine ;
    vc:isPartOf ngm:real-time-rendering-pipeline ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:3-d-transform-system,
        ngm:animation-controller,
        ngm:physics-engine ;
    vc:slug "physics-based-animation" ;
    vc:sourceDomain "spatial-computing" .

ngm:pipeline-parallelism a owl:Class ;
    rdfs:label "Pipeline Parallelism"@en ;
    rdfs:comment "Pipeline parallelism splits a computation into ordered stages assigned to different processing units, so that distinct items occupy different stages at once and throughput rises once the pipeline is filled."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:parallel-computing ],
        ngm:distributed-computing ;
    vc:enables ngm:real-time-rendering ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:parallel-computing ;
    vc:slug "pipeline-parallelism" ;
    vc:sourceDomain "metaverse" .

ngm:plant-model a owl:Class ;
    rdfs:label "Plant Model"@en ;
    rdfs:comment "A plant model is a mathematical representation of the dynamic system being controlled, mapping control inputs and disturbances to the system's state and outputs over time. Usually expressed as differential equations, transfer functions, or state-space form, it captures how the plant responds so a controller can be designed and tuned against it. Accurate plant models are central to control theory and to model-based control synthesis and simulation."@en ;
    rdfs:subClassOf ngm:control-theory ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:control-algorithm ;
    vc:slug "plant-model" ;
    vc:sourceDomain "robotics" .

ngm:plonk a owl:Class ;
    rdfs:label "PLONK"@en ;
    rdfs:comment "PLONK is a zero-knowledge proof system that uses polynomial commitments and a universal trusted setup. It is used to build succinct proofs for verifiable computation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptography ],
        ngm:zero-knowledge-proof ;
    vc:enables ngm:rollup ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:cryptography ;
    vc:slug "plonk" ;
    vc:sourceDomain "blockchain" .

ngm:pneumatic-cylinder a owl:Class ;
    rdfs:label "Pneumatic Cylinder"@en ;
    rdfs:comment "A pneumatic cylinder is a mechanical actuator that converts compressed air pressure into linear mechanical force and motion, producing strokes from a few millimetres to over a metre. Pneumatic cylinders are widely used in industrial robotics, material handling, and assembly systems because of their high force-to-weight ratio, fast response, and inherent compliance compared to hydraulic counterparts."@en ;
    rdfs:subClassOf ngm:pneumatic-actuator,
        ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:enables ngm:end-effector,
        ngm:manipulator ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:robo-actuation-and-control ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:electric-linear-actuator,
        ngm:hydraulic-cylinder,
        ngm:pneumatic-motor,
        ngm:pressure-sensor,
        ngm:robot-joint ;
    vc:slug "pneumatic-cylinder" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:actuator,
        ngm:mechanical-component .

ngm:politics-law-privacy a owl:Class ;
    rdfs:label "Politics, Law, Privacy"@en ;
    rdfs:comment "The intersecting domain of political governance, legal frameworks, and individual privacy rights as they apply to AI and digital technologies. This cluster addresses how legislation (e.g., EU AI Act, GDPR), regulatory enforcement, and political economy shape what AI systems are permitted to do, how data about individuals is collected and used, and how citizens can exercise rights against automated decision-making and surveillance."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:digital-rights ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gdpr-compliance ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:data-protection ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:ai-regulation ],
        ngm:infra-legal-and-regulatory ;
    skos:broader ngm:infra-legal-and-regulatory ;
    vc:contrastsWith ngm:digital-society-surveillance ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:ai-regulation,
        ngm:data-protection,
        ngm:digital-rights ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:copyright,
        ngm:education-and-ai,
        ngm:trust-and-safety ;
    vc:requires ngm:gdpr-compliance ;
    vc:slug "politics-law-privacy" ;
    vc:sourceDomain "infrastructure" .

ngm:pose-tracking a owl:Class ;
    rdfs:label "Pose Tracking"@en ;
    rdfs:comment "Pose tracking is the continuous estimation of the position and orientation (6-DoF pose) of a device, user, or body over time. In spatial computing it underpins head, hand, and controller tracking for AR and VR, fusing camera, IMU, and depth data at low latency. Accurate, drift-free pose tracking is essential for stable, comfortable immersive experiences."@en ;
    rdfs:subClassOf ngm:computer-vision ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:ar-display-device,
        ngm:spatial-computing-domain ;
    vc:slug "pose-tracking" ;
    vc:sourceDomain "metaverse" .

ngm:post-hoc-explanation a owl:Class ;
    rdfs:label "Post Hoc Explanation"@en ;
    rdfs:comment "Interpretability techniques applied after a machine learning model has been trained, providing explanations for model behaviour and predictions without modifying the model's architecture or requiring retraining."@en ;
    rdfs:subClassOf ngm:ai-technique,
        ngm:explainability ;
    skos:broader ngm:ai-technique ;
