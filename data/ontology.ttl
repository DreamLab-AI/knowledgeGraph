        ngm:digital-signature,
        ngm:smart-contract .

ngm:prompt-injection a owl:Class ;
    rdfs:label "Prompt Injection"@en ;
    rdfs:comment "Prompt injection is a class of adversarial attacks against large language model (LLM) systems in which attacker-controlled text embedded within the model's input context overrides or subverts the developer-specified system prompt, causing the model to follow attacker instructions instead of its intended operating constraints. Direct prompt injection occurs when a user submits malicious instructions directly; indirect prompt injection occurs when the model retrieves or processes external content such as web pages, documents, or tool outputs that contain embedded adversarial instructions. As LLMs are increasingly deployed in agentic pipelines with tool-calling and autonomous action capabilities, prompt injection constitutes a critical security boundary violation that can lead to data exfiltration, privilege escalation, and unauthorised actions on external systems."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:system-prompt ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:large-language-model ],
        ngm:adversarial-attack ;
    vc:bridgesTo ngm:ai-regulation,
        ngm:governance ;
    vc:contrastsWith ngm:adversarial-robustness ;
    vc:dependsOn ngm:context-window,
        ngm:instruction-following ;
    vc:enables ngm:adversarial-testing,
        ngm:privilege-escalation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:ai-safety ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:alignment,
        ngm:constitutional-ai-training-methodology,
        ngm:jailbreaking,
        ngm:red-teaming,
        ngm:social-engineering ;
    vc:requires ngm:large-language-model,
        ngm:system-prompt ;
    vc:slug "prompt-injection" ;
    vc:sourceDomain "security" ;
    vc:standardizedBy ngm:nist-ai-rmf,
        ngm:owasp-llm-top-10-2025 ;
    vc:uses ngm:agentic-ai,
        ngm:retrieval-augmented-generation .

ngm:raft-consensus a owl:Class ;
    rdfs:label "RAFT Consensus"@en ;
    rdfs:comment "Raft is a distributed consensus algorithm designed as a more understandable alternative to Paxos, decomposing consensus into three relatively independent sub-problems: leader election, log replication, and safety. A Raft cluster elects a single leader by majority vote during which followers grant a term-limited mandate; the leader receives all client writes, appends them to its log, and replicates them to followers, committing entries once a quorum acknowledges receipt. Raft guarantees that committed entries are never lost as long as a majority of nodes remain connected, providing crash fault tolerance but not Byzantine fault tolerance."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:consensus-algorithm ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:distributed-system ],
        ngm:bc-protocol-and-consensus ;
    skos:broader ngm:bc-protocol-and-consensus ;
    vc:contrastsWith ngm:byzantine-fault-tolerance ;
    vc:enables ngm:fault-tolerance,
        ngm:state-machine-replication ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:distributed-ledger ;
    vc:requires ngm:consensus-algorithm,
        ngm:distributed-system ;
    vc:slug "raft-consensus" ;
    vc:sourceDomain "blockchain" .

ngm:remote-work a owl:Class ;
    rdfs:label "Remote Work"@en ;
    rdfs:comment "Remote work is a work arrangement in which employees perform their professional duties from locations outside the traditional employer premises — including home offices, co-working spaces, or while travelling — using digital communication, collaboration, and productivity tools to maintain output and team cohesion. It encompasses fully remote models, hybrid arrangements that blend in-office and remote days, and asynchronous-first organisational cultures that decouple productive work from synchronous physical presence. The practice spans individual contributor roles through entire distributed organisations and intersects deeply with workforce management, digital infrastructure provisioning, cybersecurity policy, and organisational design. Remote work has become a core dimension of modern knowledge-work governance, influencing talent acquisition geographically, commercial real estate demand, and the architecture of digital workplace platforms."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:identity-and-access-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:communication-infrastructure ],
        ngm:distributed-work ;
    vc:bridgesTo ngm:meeting-ai-assistant,
        ngm:zero-trust-architecture ;
    vc:dependsOn ngm:broadband-internet,
        ngm:cloud-storage,
        ngm:project-management-software ;
    vc:enables ngm:asynchronous-collaboration,
        ngm:distributed-collaboration ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:distributed-team-collaboration,
        ngm:hybrid-work,
        ngm:knowledge-management,
        ngm:remote-collaboration,
        ngm:telecollaboration,
        ngm:workforce-management ;
    vc:requires ngm:communication-infrastructure,
        ngm:endpoint-security,
        ngm:identity-and-access-management ;
    vc:slug "remote-work" ;
    vc:sourceDomain "distributed-collaboration" ;
    vc:uses ngm:asynchronous-communication,
        ngm:cloud-computing,
        ngm:collaboration-platform,
        ngm:digital-workplace-platform,
        ngm:video-conferencing,
        ngm:virtual-private-network .

ngm:robot-joint a owl:Class ;
    rdfs:label "Robot Joint"@en ;
    rdfs:comment "A Robot Joint is a mechanical articulation between two robot links that permits controlled relative motion — rotational, translational, or compound — enabling the full kinematic range of a robotic arm or manipulator. Joint types include revolute, prismatic, and spherical, each characterised by degrees of freedom and load capacity."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:joint-encoder ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:robot-sensor ],
