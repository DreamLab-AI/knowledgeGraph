ngm:refresh-token a owl:Class ;
    rdfs:comment "A refresh token is a long-lived credential issued alongside a short-lived access token, used to obtain new access tokens without prompting the user to re-authenticate. By keeping access tokens short-lived and exchanging the refresh token at the authorisation server, systems limit the damage of a leaked access token while preserving a smooth user session. Refresh tokens are sensitive and typically bound, rotated, and revocable."@en ;
    rdfs:label "Refresh Token"@en ;
    rdfs:subClassOf ngm:oauth-2-0 ;
