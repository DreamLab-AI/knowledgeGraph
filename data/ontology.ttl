    vc:sourceDomain "spatial-computing" .

ngm:pathology-ai a owl:Class ;
    rdfs:label "Pathology AI"@en ;
    rdfs:comment "Artificial intelligence systems for automated analysis of histopathology slides, cytology specimens, and other pathological images. Pathology AI performs tasks including cancer detection and grading, biomarker quantification, and morphological analysis using whole-slide imaging pipelines and deep learning architectures tailored for gigapixel images at multi-scale resolution."@en ;
    rdfs:subClassOf ngm:ai-application,
        ngm:medical-imaging-ai ;
    skos:broader ngm:ai-application ;
    vc:dependsOn ngm:image-segmentation ;
    vc:enables ngm:medical-ai ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:healthcare-analytics,
        ngm:radiology-ai ;
    vc:slug "pathology-ai" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:computer-vision,
        ngm:deep-learning .

ngm:payment-token a owl:Class ;
    rdfs:label "Payment Token"@en ;
    rdfs:comment "A Payment Token is a cryptocurrency token whose primary purpose is to serve as a medium of exchange and store of value for peer-to-peer and merchant payments, distinguished from utility tokens (access rights) and security tokens (equity/asset claims). Examples include Bitcoin, Litecoin, and CBDC-backed digital currencies."@en ;
    rdfs:subClassOf ngm:bc-token-and-asset,
        ngm:cryptocurrency-token ;
    skos:broader ngm:bc-token-and-asset ;
    vc:contrastsWith ngm:governance-token,
        ngm:stablecoin,
        ngm:utility-token ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:decentralized-finance-de-fi ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:cbdcs,
        ngm:cryptocurrency,
        ngm:digital-currency,
        ngm:lightning-network,
        ngm:tokenomics,
        ngm:transaction-fee ;
    vc:slug "payment-token" ;
    vc:sourceDomain "blockchain" .

ngm:pbft a owl:Class ;
    rdfs:label "PBFT"@en ;
    rdfs:comment "Practical Byzantine Fault Tolerance (PBFT) is a state-machine replication protocol designed by Castro and Liskov (1999) that achieves consensus in asynchronous distributed systems despite up to f arbitrarily faulty (Byzantine) nodes, requiring a total of at least 3f+1 replicas. It proceeds through pre-prepare, prepare, and commit phases to ensure all correct replicas execute the same sequence of operations, providing both safety and liveness under partial synchrony assumptions. PBFT was the first Byzantine fault-tolerant protocol deemed practical for deployed systems, with latency polynomial rather than exponential in the number of nodes. Its communication complexity of O(n²) limits scalability but makes it highly suitable for small-to-medium permissioned blockchain networks."@en ;
    rdfs:subClassOf ngm:byzantine-fault-tolerance ;
    vc:contrastsWith ngm:proof-of-work ;
    vc:enables ngm:blockchain-infrastructure,
        ngm:distributed-ledger-technology ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:bc-protocol-and-consensus,
        ngm:consensus-mechanism,
        ngm:dynamic-scalable-bft ;
    vc:slug "pbft" ;
    vc:sourceDomain "blockchain" ;
