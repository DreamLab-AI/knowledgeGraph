            owl:someValuesFrom ngm:owl-class-hierarchy ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:ontology-property-definitions ],
        ngm:sc-standards-and-interop ;
    skos:broader ngm:sc-standards-and-interop ;
    vc:enables ngm:knowledge-graph,
        ngm:linked-data ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:ontology-definition,
        ngm:ontology-property-definitions,
        ngm:owl-class-hierarchy ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:slug "ontology-structure" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:controlled-vocabulary .

ngm:open-loop-control a owl:Class ;
    rdfs:label "Open-Loop Control"@en ;
    rdfs:comment "A control system where the control action is independent of the output. The system executes pre-programmed commands without feedback from sensors to verify if the desired state was achieved."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
