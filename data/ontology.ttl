ngm:metaverse-commerce a owl:Class ;
    rdfs:label "Metaverse Commerce"@en ;
    rdfs:comment "Metaverse commerce is the buying, selling and trading of goods, services and experiences within immersive virtual worlds and spatial environments. It spans virtual goods, wearables and real estate, branded experiences and the digital twins of physical products, often settled with virtual currencies or tokens. Metaverse commerce extends e-commerce into embodied, social and persistent 3D spaces where avatars browse, transact and own digital assets."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:marketplace-integration ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:avatar ],
        ngm:metaverse ;
    vc:bridgesTo ngm:e-commerce ;
    vc:contrastsWith ngm:e-commerce ;
    vc:dependsOn ngm:digital-asset ;
    vc:enables ngm:virtual-currency,
        ngm:virtual-economy ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:implements ngm:marketplace ;
    vc:isPartOf ngm:metaverse ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:creator-economy,
        ngm:virtual-event ;
    vc:requires ngm:avatar,
        ngm:marketplace-integration ;
    vc:slug "metaverse-commerce" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:marketplace,
        ngm:virtual-world ;
    vc:uses ngm:digital-asset,
        ngm:nft .

ngm:metaverse-content-creation a owl:Class ;
    rdfs:label "Metaverse Content Creation"@en ;
    rdfs:comment "Metaverse content creation is the production of three-dimensional assets, environments, avatars, and interactive experiences for immersive virtual worlds. It spans modelling, texturing, animation, scripting, and increasingly generative AI workflows, and is the supply side that populates persistent shared spaces. Quality, interoperability, and real-time performance constraints distinguish it from conventional digital media production."@en ;
    rdfs:subClassOf ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:content-creation-pipeline,
        ngm:metaverse-application-platform ;
    vc:slug "metaverse-content-creation" ;
    vc:sourceDomain "metaverse" .

ngm:metaverse-navigation-systems a owl:Class ;
    rdfs:label "Metaverse Navigation Systems"@en ;
    rdfs:comment "Metaverse navigation systems are spatially-embedded interaction mechanisms that enable users to traverse, orient, and coordinate within persistent three-dimensional virtual environments through modalities such as gaze-based controls, hand-tracking, locomotion techniques (joystick, teleportation, redirected walking), and spatial overlays including mini-maps and AR wayfinding cues. These systems integrate environmental awareness, social presence, and user experience design to maintain spatial cognition across interconnected virtual worlds. They form a critical infrastructure layer for usable, inclusive metaverse participation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:extended-reality ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:virtual-reality ],
        ngm:metaverse-and-telecollaboration,
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:metaverse,
        ngm:spatial-computing ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:augmented-reality,
        ngm:social-vr,
        ngm:telecollaboration,
        ngm:virtual-environment ;
    vc:requires ngm:extended-reality,
        ngm:virtual-reality ;
    vc:slug "metaverse-navigation-systems" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:avatar-system,
        ngm:presence,
        ngm:spatial-audio .

ngm:metaverse-technology a owl:Class ;
    rdfs:label "Metaverse Technology"@en ;
    rdfs:comment "The foundational technology domain encompassing persistent, synchronous 3D virtual worlds, augmented reality environments, spatial computing platforms, and immersive internet infrastructure that enable shared experiences with interoperable digital assets, persistent identity systems, and real-time social interaction across physical and virtual boundaries."@en ;
