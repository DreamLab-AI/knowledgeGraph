ngm:marketplace a owl:Class ;
    rdfs:label "Marketplace"@en ;
    rdfs:comment "Digital platform enabling discovery, exchange, and transaction of virtual goods, services, and assets within or across metaverse systems through listing, escrow, and reputation mechanisms."@en ;
