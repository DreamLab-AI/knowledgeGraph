        ngm:digital-marketplace,
        ngm:non-fungible-token-nft ;
    vc:slug "nft-marketplace" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:erc-1155,
        ngm:erc-721,
        ngm:smart-contract .

ngm:observability a owl:Class ;
    rdfs:label "Observability"@en ;
    rdfs:comment "Observability is the capability of a system that allows engineers to infer its internal state and behaviour solely from externally observable outputs — primarily logs, metrics, and distributed traces. Derived from control-systems theory, it answers whether the complete internal state can be reconstructed from a sequence of outputs. In modern software engineering, observability enables debugging, performance tuning, incident response, and proactive reliability assurance across complex distributed architectures where direct inspection is impractical."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-collection ],
        ngm:reliability-engineering ;
    vc:bridgesTo ngm:anomaly-detection,
        ngm:machine-learning-operations ;
    vc:contrastsWith ngm:debugging,
        ngm:monitoring ;
    vc:dependsOn ngm:distributed-systems,
        ngm:microservices ;
    vc:enables ngm:capacity-planning,
        ngm:chaos-engineering,
        ngm:incident-response,
        ngm:site-reliability-engineering ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:alerting,
        ngm:distributed-tracing,
        ngm:logging,
        ngm:metrics ;
    vc:implements ngm:opentelemetry ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:fault-tolerance,
        ngm:performance,
        ngm:service-level-objective ;
    vc:requires ngm:data-collection,
        ngm:instrumentation,
        ngm:telemetry ;
    vc:slug "observability" ;
    vc:sourceDomain "infrastructure" ;
    vc:standardizedBy ngm:cloud-native-computing-foundation,
        ngm:opentelemetry ;
    vc:supports ngm:continuous-delivery,
        ngm:devops ;
    vc:uses ngm:log-aggregation,
        ngm:service-mesh,
        ngm:time-series-database .

ngm:optimisation a owl:Class ;
    rdfs:label "Optimisation"@en ;
    rdfs:comment "Optimisation is the mathematical and computational discipline concerned with finding the best solution — maximum or minimum — of an objective function subject to given constraints, across a search space of possible decisions or parameter configurations. It encompasses deterministic methods (linear programming, convex optimisation, gradient-based search), stochastic methods (simulated annealing, evolutionary algorithms, Monte Carlo sampling), and learned methods (differentiable optimisation, meta-learning, neural combinatorial solvers). Optimisation is the theoretical core of machine learning training, operations research, control engineering, signal processing, and resource scheduling. The choice of optimisation algorithm fundamentally determines convergence speed, solution quality, and computational cost across all application domains."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:constraint ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:bayesian-optimisation ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:convex-optimisation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:loss-function ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:gradient-descent ],
        ngm:mathematical-foundations ;
    vc:bridgesTo ngm:quantum-computing ;
    vc:contrastsWith ngm:satisfiability ;
    vc:enables ngm:deep-learning,
        ngm:hyperparameter-tuning,
        ngm:machine-learning,
        ngm:operations-research,
        ngm:optimal-control ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:bayesian-optimisation,
        ngm:convex-optimisation,
        ngm:evolutionary-algorithm,
        ngm:gradient-descent,
        ngm:linear-programming ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:game-theory,
        ngm:information-theory,
        ngm:numerical-methods ;
    vc:requires ngm:constraint,
        ngm:loss-function,
        ngm:objective-function ;
    vc:slug "optimisation" ;
    vc:sourceDomain "machine-learning" ;
    vc:supports ngm:neural-network-training,
        ngm:portfolio-optimisation,
        ngm:reinforcement-learning,
        ngm:supply-chain-management ;
    vc:uses ngm:calculus,
        ngm:linear-algebra,
        ngm:probability-theory .

ngm:oracle-network a owl:Class ;
    rdfs:label "Oracle Network"@en ;
    rdfs:comment "An oracle network is a decentralised infrastructure layer composed of independent node operators that collectively fetch, validate, aggregate, and deliver off-chain data — such as asset prices, weather readings, sports outcomes, or IoT sensor readings — to smart contracts executing on a blockchain. Because deterministic blockchain ledgers cannot natively make external HTTP requests or access off-chain databases, oracle networks serve as the cryptoeconomically-secured bridge between on-chain logic and real-world state. Node operators are aligned to honest reporting through staking, slashing, and reputation mechanisms, while aggregation techniques such as median computation and time-weighted average pricing reduce susceptibility to individual node manipulation. Oracle networks underpin critical decentralised finance primitives including lending protocols, synthetic assets, prediction markets, insurance products, cross-chain bridges, and real-world asset settlement."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-aggregation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:staking ],
        ngm:bc-network-component ;
    skos:broader ngm:bc-network-component ;
    vc:bridgesTo ngm:ai-agent,
        ngm:data-marketplace,
        ngm:iot-sensor-network ;
    vc:contrastsWith ngm:centralised-oracle,
        ngm:trusted-execution-environment ;
    vc:dependsOn ngm:blockchain-consensus,
        ngm:smart-contract ;
    vc:enables ngm:cross-chain-interoperability,
        ngm:price-oracle,
        ngm:proof-of-reserve,
        ngm:verifiable-random-function ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:aggregation-contract,
        ngm:off-chain-reporting,
        ngm:slashing-mechanism ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:blockchain-oracle,
        ngm:decentralised-autonomous-organisation,
        ngm:decentralised-infrastructure,
        ngm:zero-knowledge-proof ;
    vc:requires ngm:cryptoeconomic-incentive,
        ngm:data-aggregation,
        ngm:node-operator,
        ngm:staking ;
    vc:slug "oracle-network" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:decentralised-finance,
        ngm:prediction-market,
        ngm:real-world-asset-tokenisation,
        ngm:smart-contract-execution .

ngm:pid-controller a owl:Class ;
    rdfs:label "Pid Controller"@en ;
    rdfs:comment "A PID Controller (Proportional-Integral-Derivative Controller) is a closed-loop feedback control algorithm that continuously calculates an error value as the difference between a desired setpoint and a measured process variable, then applies corrections based on proportional, integral, and derivative terms. PID controllers are foundational in robotics, autonomous systems, and industrial automation for precisely regulating position, velocity, and force."@en ;
    rdfs:subClassOf ngm:sc-interaction ;
    skos:broader ngm:sc-interaction ;
    vc:bridgesTo ngm:rb-0047-feedback-control ;
    vc:enables ngm:motion-planning,
        ngm:robot-control ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:control-system,
        ngm:feedback-control ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:relatedTo ngm:actuator,
        ngm:autonomous-system ;
    vc:slug "pid-controller" ;
    vc:sourceDomain "spatial-computing" .

ngm:predictive-analytics a owl:Class ;
    rdfs:label "Predictive Analytics"@en ;
    rdfs:comment "Predictive Analytics is the discipline of extracting patterns from historical data using statistical algorithms and machine learning models to generate probabilistic forecasts of future events, behaviours, or conditions. It encompasses the full workflow from data ingestion and feature engineering through model selection, training, validation, and operationalised deployment within business intelligence and decision-support systems. The field draws on regression, classification, ensemble methods, and time-series modelling to produce actionable outputs in domains ranging from demand forecasting and risk assessment to anomaly detection and personalised recommendation. It is distinguished from descriptive analytics by its forward-looking orientation and from prescriptive analytics by its focus on prediction rather than optimised action."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:feature-engineering ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:machine-learning ],
        ngm:ai-application ;
    skos:broader ngm:ai-application ;
    vc:bridgesTo ngm:digital-twin,
        ngm:spatial-analytics ;
    vc:contrastsWith ngm:descriptive-analytics,
        ngm:prescriptive-analytics ;
    vc:enables ngm:anomaly-detection,
        ngm:decision-support-system,
        ngm:demand-forecasting,
        ngm:recommendation-system,
        ngm:risk-assessment ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:isPartOf ngm:business-intelligence ;
    vc:qualityScore "0.74"^^xsd:float ;
