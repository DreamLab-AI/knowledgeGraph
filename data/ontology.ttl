# Disruptive Tech Domain
infrastructure:DisruptiveTechDomain rdf:type owl:Class ;
    rdfs:subClassOf infrastructure:Domain ;
    rdfs:label "Disruptive Tech Domain"@en ;
    rdfs:comment "A cross-cutting classification domain identifying technologies with transformative potential that significantly alter markets, industries, or societal practices. This domain spans AI, Blockchain, Metaverse, Robotics, and Telecollaboration, tagging concepts that represent paradigm shifts, emerging capabilities, or technologies displacing established approaches. Used for strategic analysis, trend identification, and innovation portfolio management."@en ;
    skos:prefLabel "Disruptive Tech Domain"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:infrastructure:disruptive-tech-domain" ;
    owl:sameAs <urn:visionclaw:concept:infrastructure:disruptive-tech-domain> ;
    vcw:contentHash "sha256-12-f3f8183a6256" ;
    vcw:qualityScore "0.5"^^xsd:decimal ;
    vcw:legacyTermId "NGM-0020" ;
    vcw:ontologyStatus "active" ;
    vcw:maturityLevel "stable" ;
    vcw:authorityScore "0.0"^^xsd:decimal ;
    dcterms:identifier "NGM-0020" ;
    dcterms:subject "infrastructure" ;
    owl:versionInfo "2.0.0" ;
    dcterms:created "2026-04-26T00:00:00Z"^^xsd:dateTime ;
    dcterms:modified "2026-04-26T13:00:00Z"^^xsd:dateTime ;
    vcw:owlRole "Domain" .

infrastructure:DisruptiveTechDomain rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty infrastructure:hasPart ;
    owl:someValuesFrom infrastructure:AIApplicationsDomain
] .

infrastructure:DisruptiveTechDomain rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty infrastructure:enables ;
    owl:someValuesFrom infrastructure:TechnologyForecasting
] .

infrastructure:DisruptiveTechDomain vcw:bridgesTo infrastructure:Blockchain .

