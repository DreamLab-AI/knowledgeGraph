    vc:slug "metadata-standard" ;
    vc:sourceDomain "spatial-computing" .

ngm:mqtt a owl:Class ;
    rdfs:label "MQTT"@en ;
    rdfs:comment "MQTT (Message Queuing Telemetry Transport) is a lightweight publish-subscribe messaging protocol standardised as ISO/IEC 20922 and OASIS MQTT 5.0, designed for constrained devices and low-bandwidth or unreliable networks with minimal protocol overhead. Clients connect to a central broker that routes messages hierarchically by topic string; publishers post payloads to topic endpoints and subscribers receive all messages matching wildcard-capable topic filters. MQTT defines three quality-of-service levels—at most once (QoS 0), at least once (QoS 1), and exactly once (QoS 2)—enabling integrators to balance delivery guarantees against network and compute cost across heterogeneous deployments spanning embedded microcontrollers to cloud-scale brokers."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:message-broker ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:publish-subscribe-pattern ],
        ngm:infra-network-and-comms ;
    skos:broader ngm:infra-network-and-comms ;
    vc:bridgesTo ngm:digital-twin,
        ngm:machine-learning-inference,
        ngm:ros2 ;
    vc:contrastsWith ngm:amqp,
        ngm:coap,
        ngm:http,
        ngm:stomp ;
    vc:dependsOn ngm:embedded-systems,
        ngm:network-infrastructure ;
    vc:enables ngm:event-driven-architecture,
        ngm:internet-of-things,
        ngm:real-time-data-streaming,
        ngm:sensor-data,
        ngm:telemetry-and-analytics ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:implements ngm:publish-subscribe-pattern ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:data-serialisation,
        ngm:scada,
        ngm:sparkplug-b ;
    vc:requires ngm:message-broker,
        ngm:publish-subscribe-pattern ;
    vc:slug "mqtt" ;
    vc:sourceDomain "infrastructure" ;
    vc:standardizedBy ngm:iso-iec-20922,
        ngm:oasis-open ;
    vc:supports ngm:edge-computing,
        ngm:industrial-iot,
        ngm:smart-home-automation,
        ngm:vehicle-telematics ;
    vc:uses ngm:communication-protocol,
        ngm:tcp-ip,
        ngm:tls-ssl,
        ngm:websockets .

ngm:multi-party-computation a owl:Class ;
    rdfs:label "Multi-Party Computation"@en ;
    rdfs:comment "Multi-Party Computation (MPC) is a subfield of cryptography that enables a set of mutually distrusting parties to jointly compute a function over their private inputs without revealing those inputs to any other participant. Correctness is guaranteed even when a bounded subset of participants behave maliciously, making MPC a cornerstone of privacy-preserving collaborative computation. The technique generalises two-party secure computation to arbitrary numbers of participants using secret-sharing or garbled-circuit protocols."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptographic-protocol ],
        ngm:cryptography ;
    vc:bridgesTo ngm:decentralised-finance,
        ngm:digital-asset-custody,
        ngm:federated-learning ;
    vc:contrastsWith ngm:trusted-third-party ;
    vc:dependsOn ngm:authenticated-channel,
        ngm:computational-hardness-assumption ;
    vc:enables ngm:privacy-preserving-analytics,
        ngm:privacy-preserving-data-sharing,
        ngm:private-set-intersection,
        ngm:threshold-key-management,
        ngm:verifiable-computation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:differential-privacy,
        ngm:homomorphic-encryption,
        ngm:threshold-cryptography,
        ngm:trusted-execution-environment,
        ngm:zero-knowledge-proof ;
    vc:requires ngm:cryptographic-protocol,
        ngm:oblivious-transfer,
        ngm:secret-sharing ;
    vc:slug "multi-party-computation" ;
    vc:sourceDomain "security" ;
    vc:supports ngm:data-sovereignty,
        ngm:gdpr-compliance ;
    vc:uses ngm:arithmetic-circuit,
        ngm:boolean-circuit,
        ngm:garbled-circuits,
        ngm:public-key-cryptography .

ngm:object-storage a owl:Class ;
    rdfs:label "Object Storage"@en ;
    rdfs:comment "Object storage is a data storage architecture that manages data as discrete objects — each comprising an opaque payload, a globally unique identifier, and extensible metadata — accessed via a flat namespace through RESTful HTTP APIs rather than a file hierarchy or block device. It is designed for massive horizontal scalability, high durability, and cost-effective storage of unstructured data such as media files, backups, and machine-learning datasets. Amazon S3 established the de facto API standard, now implemented by numerous compatible services."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:erasure-coding ],
        ngm:data-storage ;
    vc:bridgesTo ngm:model-registry,
        ngm:training-dataset ;
    vc:contrastsWith ngm:block-storage,
