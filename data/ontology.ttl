        ngm:ssl-tls ;
    vc:slug "payment-gateway" ;
    vc:sourceDomain "finance" ;
    vc:standardizedBy ngm:iso-20022 ;
    vc:supports ngm:agentic-ai,
        ngm:e-commerce,
        ngm:point-of-sale ;
    vc:uses ngm:api-gateway,
        ngm:digital-wallet,
        ngm:encryption,
        ngm:restful-api .

ngm:persistent-storage a owl:Class ;
    rdfs:label "Persistent Storage"@en ;
    rdfs:comment "Persistent storage refers to any data storage mechanism that retains data independently of the lifecycle of the process or system that created it, surviving power-off events, container restarts, and application failures. It contrasts with ephemeral or in-memory storage whose contents are lost when the host process terminates. Persistent storage encompasses file systems, relational and NoSQL databases, object stores, block volumes, and distributed storage systems, all of which provide durability guarantees through techniques such as write-ahead logging, replication, and erasure coding. It is a foundational concern in cloud-native architectures, stateful microservices, and any system that must maintain reliable long-term data."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:database-system ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:cloud-storage ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:file-system ],
        ngm:data-storage ;
    vc:enables ngm:data-management,
        ngm:training-data ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:cloud-storage,
        ngm:database-system,
        ngm:file-system ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:data-storage-layer,
        ngm:distributed-storage,
        ngm:vector-database ;
    vc:slug "persistent-storage" ;
    vc:sourceDomain "infrastructure" .

ngm:pixel-shader a owl:Class ;
    rdfs:label "Pixel Shader"@en ;
    rdfs:comment "A programmable GPU stage that executes once per rasterised fragment, determining each pixel's final colour and depth by sampling textures, computing lighting models, and applying material properties. Pixel shaders operate in a massively parallel fashion and are the primary site for physically-based rendering calculations in real-time graphics pipelines."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gpu ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
