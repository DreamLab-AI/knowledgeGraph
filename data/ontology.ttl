        ngm:sparql ;
    vc:slug "property-graph" ;
    vc:sourceDomain "data" ;
    vc:supports ngm:knowledge-graph-embedding ;
    vc:uses ngm:graph-database,
        ngm:knowledge-representation .

ngm:proprietary-format a owl:Class ;
    rdfs:label "Proprietary Format"@en ;
    rdfs:comment "A proprietary format is a data or file format whose specification is controlled by a single vendor and is not openly published or freely implementable. Access to and interpretation of the data typically depend on the vendor's software, which can constrain interoperability, archival longevity, and user control. Proprietary formats stand in contrast to open standards and are a common source of vendor lock-in."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:metadata ],
        ngm:data-format ;
    vc:bridgesTo ngm:interoperability,
        ngm:standards ;
    vc:contrastsWith ngm:open-source,
        ngm:open-standard ;
    vc:dependsOn ngm:proprietary-software ;
    vc:enables ngm:vendor-lock-in ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:isPartOf ngm:file-format ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:asset-portability,
        ngm:interoperability-standard,
        ngm:web-standard ;
    vc:requires ngm:metadata ;
    vc:slug "proprietary-format" ;
    vc:sourceDomain "standards" ;
    vc:supports ngm:digital-asset ;
    vc:uses ngm:encryption .

ngm:proprietary-software a owl:Class ;
    rdfs:label "Proprietary Software"@en ;
    rdfs:comment "Proprietary software is software whose source code and usage rights are owned and controlled by a vendor, distributed under restrictive licences that limit copying, modification and redistribution. Users typically receive only compiled binaries and a licence granting specified use, while the owner retains the underlying intellectual property. It contrasts with open source, where source code is freely available under permissive or copyleft terms, and is often associated with commercial licensing and vendor control."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:licensing ],
        ngm:software-development ;
    vc:bridgesTo ngm:open-source ;
    vc:contrastsWith ngm:inner-source,
        ngm:open-source,
        ngm:open-source-licence ;
    vc:dependsOn ngm:licensing ;
    vc:enables ngm:vendor-lock-in ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:proprietary-format,
        ngm:software-engineering,
        ngm:vendor-lock-in ;
    vc:requires ngm:licensing ;
    vc:slug "proprietary-software" ;
    vc:sourceDomain "distributed-collaboration" ;
    vc:supports ngm:software-development ;
    vc:uses ngm:licensing .

ngm:proprioception a owl:Class ;
    rdfs:label "Proprioception"@en ;
    rdfs:comment "Proprioception is a robot's internal sense of its own configuration and motion, derived from sensors that report joint angles, velocities, motor torques, body orientation and contact forces. Distinct from exteroceptive sensing of the external world, proprioceptive feedback lets a system estimate its pose and dynamics without external references, which is essential for stable balance, compliant interaction and dead-reckoning. It provides the fast, low-latency state signal that closed-loop motor controllers depend upon."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:feedback-control ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:sensor-fusion ],
        ngm:robot-perception ;
    vc:bridgesTo ngm:robotic-manipulation ;
    vc:dependsOn ngm:sensor-calibration ;
    vc:enables ngm:feedback-control,
        ngm:humanoid-robotics ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:robot-perception ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:robot-perception,
        ngm:sensor-fusion ;
    vc:requires ngm:feedback-control,
        ngm:sensor-fusion ;
    vc:slug "proprioception" ;
    vc:sourceDomain "robotics" ;
    vc:supports ngm:humanoid-robotics,
        ngm:robotic-manipulation ;
    vc:uses ngm:sensor-fusion .

ngm:proprioceptive-sensor a owl:Class ;
