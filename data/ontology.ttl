ngm:token-governance a owl:Class ;
    rdfs:comment "A decision-making mechanism for blockchain protocols and DAOs in which voting power is allocated in proportion to holdings of a governance token, so that proposals — parameter changes, treasury spending, protocol upgrades — are ratified by token-weighted ballots executed through smart contracts, trading the legitimacy problems of plutocratic weighting against the sybil resistance and skin-in-the-game that stake-based voting provides."@en ;
    rdfs:label "Token Governance"@en ;
    rdfs:subClassOf ngm:decentralised-governance ;
