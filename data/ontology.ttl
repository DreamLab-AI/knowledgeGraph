        ngm:siemens-xcelerator,
        ngmi:nvidia-omniverse .

ngm:price-oracle a owl:Class ;
    rdfs:label "Price Oracle"@en ;
    rdfs:comment "A price oracle is an on-chain or hybrid data feed that supplies decentralised protocols with reliable, manipulation-resistant market prices for tokens, synthetic assets, and other financial instruments. On-chain price oracles—such as time-weighted average price (TWAP) feeds derived from automated market maker pool reserves—are fully decentralised but lag real-time prices. Off-chain oracle networks aggregate prices from multiple centralised and decentralised exchanges before committing them on-chain, offering fresher data at the cost of additional trust assumptions on node operators. Price oracles are foundational to DeFi lending protocols (collateral valuation), synthetic asset minting, perpetual futures settlement, and insurance claim adjudication."@en ;
    rdfs:subClassOf ngm:bc-defi-and-economics ;
    skos:broader ngm:bc-defi-and-economics ;
    vc:dependsOn ngm:oracle-network ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:automated-market-maker,
        ngm:blockchain-oracle ;
    vc:slug "price-oracle" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:decentralised-finance,
        ngm:liquidity-pool .

ngm:procedural-generation a owl:Class ;
    rdfs:label "Procedural Generation"@en ;
    rdfs:comment "Procedural Generation is the algorithmic creation of content — including terrain, textures, vegetation, buildings, and narrative elements — using mathematical functions, noise algorithms, and rule-based systems rather than manual authoring. It is foundational to scalable world-building in games and metaverse platforms, enabling vast, varied environments from compact seed parameters."@en ;
    rdfs:subClassOf ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:enables ngm:procedural-terrain,
        ngm:world-building ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:relatedTo ngm:game-engine,
        ngm:generative-ai ;
    vc:slug "procedural-generation" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:3-d-content-generation,
        ngm:noise-function-library .

ngm:rasterization a owl:Class ;
    rdfs:label "Rasterization"@en ;
    rdfs:comment "The dominant real-time rendering technique that converts 3D geometric primitives — predominantly triangles — into a 2D pixel representation by determining per-pixel coverage, depth, and colour through a GPU-accelerated pipeline of vertex processing, primitive assembly, scan conversion, fragment shading, and output merging. Rasterization trades photorealistic accuracy for deterministic, high-throughput performance suitable for interactive applications."@en ;
    rdfs:subClassOf ngm:metaverse,
        ngm:sc-display-and-rendering ;
    skos:broader ngm:sc-display-and-rendering ;
    vc:contrastsWith ngm:ray-tracing ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:relatedTo ngm:level-of-detail ;
    vc:slug "rasterization" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:post-processing,
        ngm:rendering-technique ;
    vc:uses ngm:pixel-shader,
        ngm:vertex-shader .

ngm:remote-collaboration a owl:Class ;
    rdfs:label "Remote Collaboration"@en ;
    rdfs:comment "Work practices, tools, and methodologies enabling geographically distributed teams to coordinate effectively without physical co-location, combining synchronous channels (video conferencing, real-time co-editing, spatial audio) with asynchronous coordination (version control, project management, persistent chat) to maintain team cohesion and productivity across time zones."@en ;
    rdfs:subClassOf ngm:infra-network-and-comms ;
    skos:broader ngm:infra-network-and-comms ;
    vc:bridgesTo ngm:telecollaboration,
        ngm:virtual-collaboration ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:relatedTo ngm:immersive-communication,
        ngm:virtual-workspace ;
    vc:slug "remote-collaboration" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:encryption,
        ngm:spatial-audio .

ngm:software-development-process a owl:Class ;
    rdfs:label "Software Development Process"@en ;
    rdfs:comment "The structured set of methodologies, workflows, and best practices governing how software — including AI and machine learning systems — is conceived, built, tested, deployed, and maintained. For AI systems this encompasses data-centric workflows, experiment tracking, model validation protocols, MLOps pipelines, and cross-functional collaboration between data scientists, engineers, and domain experts across the full model lifecycle."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:software-testing ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:software-engineering ],
        ngm:ai-infrastructure ;
    vc:enables ngm:ai-augmented-software-engineering,
        ngm:ai-deployment ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:requires ngm:software-engineering,
        ngm:software-testing ;
    vc:slug "software-development-process" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:standards-conformance-testing ;
    vc:uses ngm:ai-development-tools,
        ngm:machine-learning-pipeline .

ngm:surgical-robotics a owl:Class ;
    rdfs:label "Surgical Robotics"@en ;
    rdfs:comment "Surgical robotics is the application of robotic systems, real-time computer vision, and AI-driven control to assist surgeons or perform procedures autonomously with enhanced precision, dexterity, tremor cancellation, and minimally invasive access. Systems range from teleoperated master-slave platforms—where a surgeon's hand movements are scaled and filtered—to semi-autonomous robots capable of suturing or tissue manipulation under human supervision. Key technical challenges include sub-millimetre motion tracking, intraoperative tissue deformation modelling, real-time haptic feedback, and regulatory compliance under medical device frameworks such as ISO 13485 and IEC 62304."@en ;
    rdfs:subClassOf ngm:ai-application ;
    skos:broader ngm:ai-application ;
    vc:enables ngm:medical-ai ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:medical-robot,
        ngm:surgical-robot ;
    vc:slug "surgical-robotics" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:computer-vision,
        ngm:haptic-feedback,
        ngm:teleoperation .

ngm:sustainability-reporting a owl:Class ;
    rdfs:label "SustainabilityReporting"@en ;
    rdfs:comment "Sustainability reporting is the structured practice of disclosing an organisation's environmental, social, and governance (ESG) performance data to investors, regulators, and wider stakeholders in accordance with recognised frameworks such as GRI, TCFD, ISSB, and the EU Corporate Sustainability Reporting Directive (CSRD). High-quality sustainability disclosure requires consistent data collection across scope 1, 2, and 3 emissions, reliable carbon accounting methodologies, and assurance processes comparable to financial audit. Blockchain-based provenance mechanisms and tokenised carbon credits are increasingly used to enhance the integrity and verifiability of reported ESG claims."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:carbon-accounting ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-governance ],
        ngm:bc-governance-and-regulation ;
    skos:broader ngm:bc-governance-and-regulation ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:blockchain-sustainability,
        ngm:carbon-footprint-measurement ;
    vc:requires ngm:carbon-accounting,
        ngm:data-governance ;
    vc:slug "sustainability-reporting" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:transparency .

ngm:text-to-image a owl:Class ;
    rdfs:label "Text-to-Image"@en ;
    rdfs:comment "A generative AI capability that synthesises visual imagery from natural language textual descriptions. Systems such as diffusion models iteratively denoise latent representations conditioned on text embeddings, enabling creation of photorealistic and artistic images from prompts without requiring explicit pixel-level instructions."@en ;
    rdfs:subClassOf ngm:ai-application,
        ngm:generative-ai ;
    skos:broader ngm:ai-application ;
    vc:enables ngm:3-d-content-generation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:generative-ai-engineering ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:diffusion-models,
        ngm:image-generation,
        ngm:multimodal-ai,
        ngm:natural-language-processing ;
    vc:slug "text-to-image" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:diffusion-model,
        ngm:prompt-engineering,
        ngm:transformer .

ngm:value-alignment a owl:Class ;
    rdfs:label "Value Alignment"@en ;
    rdfs:comment "The challenge and process of ensuring AI systems pursue objectives that align with human values, even as those systems become more capable and autonomous. Value alignment addresses both technical and philosophical questions about encoding human preferences into AI behaviour."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:reinforcement-learning-from-human-feedback ],
        ngm:ai-governance-and-ethics ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:dependsOn ngm:interpretability ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:bias,
        ngm:fairness,
        ngm:safety-fine-tuning ;
    vc:requires ngm:reinforcement-learning-from-human-feedback ;
    vc:slug "value-alignment" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:ai-governance,
        ngm:ai-safety .

ngmi:comfy-ui a owl:NamedIndividual,
        ngm:ai-framework ;
    rdfs:label "ComfyUI"@en ;
    rdfs:comment "ComfyUI is an open-source, node-based graphical interface for constructing and executing Stable Diffusion image-generation pipelines. It exposes the underlying diffusion inference graph as a visual workflow of interconnected nodes, enabling non-destructive, reproducible experimentation. The tool has become a de-facto community standard for advanced image and video synthesis workflows."@en ;
    vc:enables ngm:generative-ai,
        ngm:image-generation,
        ngm:video-generation ;
    vc:hasMaturity ngmi:maturity-established ;
