    vc:slug "taxonomic-framework" ;
    vc:sourceDomain "robotics" ;
    vc:standardizedBy ngm:semantic-web-standards .

ngm:temporary-asset-access a owl:Class ;
    rdfs:label "Temporary Asset Access"@en ;
    rdfs:comment "A mechanism enabling time-limited usage rights to digital assets in the metaverse without transferring ownership, implemented through smart contracts that separate user roles from owner roles with automatic expiration."@en ;
