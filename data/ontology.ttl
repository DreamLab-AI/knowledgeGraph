            owl:someValuesFrom ngm:validator-set ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:public-key-infrastructure ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ed25519 ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:g-rpc ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:rust-systems-programming-language ],
        ngm:bc-network-component,
        ngm:blockchain ;
    skos:broader ngm:bc-network-component,
        ngm:blockchain ;
    vc:enables ngm:asset-tokenisation,
        ngm:central-bank-digital-currency,
        ngm:cross-border-payments,
        ngm:digital-identity,
        ngm:payment-system ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:multi-party-transactions,
