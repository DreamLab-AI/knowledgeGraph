ngm:difficulty a owl:Class ;
    rdfs:label "Difficulty"@en ;
    rdfs:comment "Difficulty is a dynamic parameter in proof-of-work blockchain systems that expresses the computational effort required to find a valid block hash—specifically, the number of leading zeros (or equivalent target threshold) that a candidate block hash must satisfy for the block to be accepted by the network. The difficulty value is adjusted periodically by the protocol based on the observed rate of block production relative to the target interval, ensuring that new blocks are produced at a predictable rate regardless of fluctuations in aggregate network hash rate. Difficulty is the primary mechanism by which proof-of-work blockchains self-regulate their monetary policy and security budget."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:hash-function ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:difficulty-adjustment ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:nonce ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:proof-of-work ],
        ngm:bc-cryptographic-primitive,
        ngm:blockchain-entity,
        ngm:cryptographic-primitive ;
    skos:broader ngm:bc-cryptographic-primitive ;
    vc:dependsOn ngm:blockchain-network ;
    vc:enables ngm:consensus-protocol,
        ngm:mining ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:difficulty-adjustment,
        ngm:nonce ;
    vc:isPartOf ngm:blockchain-protocol,
        ngm:consensus-mechanism ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:block-height,
        ngm:block-time,
        ngm:blockchain-energy-consumption,
        ngm:mining-reward ;
    vc:requires ngm:hash-function,
        ngm:proof-of-work ;
    vc:slug "difficulty" ;
    vc:sourceDomain "blockchain" .

ngm:difficulty-target a owl:Class ;
    rdfs:label "Difficulty Target"@en ;
    rdfs:comment "A 256-bit threshold value in proof-of-work blockchains that a block's hash must be numerically less than or equal to for the block to be considered valid. The difficulty target is periodically recalculated by the Difficulty Adjustment algorithm to maintain a consistent average inter-block time regardless of changes in aggregate hash power. It is the primary mechanism by which mining difficulty is quantified and enforced across all network participants."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptographic-hash-function ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:proof-of-work ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:difficulty-adjustment ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:nonce ],
        ngm:bc-protocol-and-consensus,
        ngm:blockchain-entity,
        ngm:consensus-protocol ;
    skos:broader ngm:bc-protocol-and-consensus ;
    vc:dependsOn ngm:consensus-rule,
        ngm:network-hash-rate ;
    vc:enables ngm:blockchain-network,
        ngm:consensus-mechanism ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:difficulty-adjustment ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:bitcoin-proof-of-work-protocol-mining,
        ngm:block-reward,
        ngm:blockchain-energy-consumption,
        ngm:halving,
