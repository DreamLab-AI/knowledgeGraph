    vc:slug "bolt" ;
    vc:sourceDomain "blockchain" .

ngm:bounding-volume-hierarchy a owl:Class ;
    rdfs:label "Bounding Volume Hierarchy"@en ;
    rdfs:comment "A tree-structured acceleration data structure that recursively organizes geometric objects within nested bounding volumes, enabling efficient spatial queries, collision detection, and ray-scene intersection testing by rapidly culling large portions of geometry that cannot intersect with a query."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:bounding-volume ],
        ngm:sc-display-and-rendering,
        ngm:spatial-data-structure ;
    skos:broader ngm:sc-display-and-rendering ;
    vc:enables ngm:collision-detection,
        ngm:frustum-culling,
        ngm:ray-tracing ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:bounding-volume,
        ngm:traversal-algorithm,
        ngm:tree-construction ;
    vc:slug "bounding-volume-hierarchy" ;
    vc:sourceDomain "spatial-computing" .

ngm:byte-pair-encoding a owl:Class ;
    rdfs:label "Byte Pair Encoding"@en ;
    rdfs:comment "A subword tokenisation algorithm that iteratively merges the most frequent pairs of characters or character sequences to build a vocabulary, originally developed for data compression."@en ;
    rdfs:subClassOf ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:enables ngm:natural-language-processing,
        ngm:text-generation ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:tokenisation ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:relatedTo ngm:large-language-models ;
    vc:slug "byte-pair-encoding" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:transformer .

ngm:c2-pa a owl:Class ;
    rdfs:label "C2PA"@en ;
    rdfs:comment "C2PA (Coalition for Content Provenance and Authenticity) is a cross-industry technical standards initiative and specification that defines how to cryptographically bind signed provenance metadata — including capture origin, AI generation disclosure, and editing history — to digital media assets such as images, video, audio, and documents. Founded by Adobe, Arm, BBC, Intel, Microsoft, and Truepic, C2PA publishes the C2PA technical specification under the Joint Development Foundation, which defines the manifest container format (JUMBF), assertion vocabularies, signing mechanism (COSE), and trust model. C2PA Content Credentials are the concrete artefact instantiating the specification."@en ;
    rdfs:subClassOf ngm:ai-governance-and-ethics ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:contrastsWith ngm:deepfakes,
        ngm:synthetic-media ;
    vc:enables ngm:c2-pa-content-credentials,
        ngm:provenance-verification ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:slug "c2-pa" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:digital-signature,
        ngm:provenance-tracking .

ngm:camera-intrinsics a owl:Class ;
    rdfs:label "Camera Intrinsics"@en ;
    rdfs:comment "Camera Intrinsics are the internal optical and geometric parameters of a camera that define the mathematical relationship between 3D points in the camera's coordinate frame and their 2D projections onto the image sensor. The intrinsic parameter matrix encodes focal length in pixel units along each image axis, the principal point (optical axis intersection with the sensor), and skew, whilst associated distortion coefficients correct for lens aberrations that cause deviations from the ideal pinhole projection model."@en ;
    rdfs:subClassOf ngm:computer-vision ;
    vc:enables ngm:photogrammetry,
        ngm:pose-estimation,
        ngm:stereo-vision ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:epipolar-geometry,
        ngm:structure-from-motion ;
    vc:slug "camera-intrinsics" ;
    vc:sourceDomain "spatial" ;
    vc:uses ngm:optical-calibration-target,
        ngm:sensor-calibration .

ngm:carbon-neutrality-planning a owl:Class ;
    rdfs:label "Carbon Neutrality Planning"@en ;
    rdfs:comment "The strategic process of developing a comprehensive roadmap to achieve net-zero greenhouse gas emissions, encompassing emission measurement, science-based reduction targets, interim milestones, decarbonization actions, and residual emission neutralization through permanent carbon removal."@en ;
    rdfs:subClassOf ngm:sc-governance-and-safety,
        ngm:strategic-planning ;
    skos:broader ngm:sc-governance-and-safety ;
    vc:enables ngm:climate-action,
        ngm:decarbonization,
        ngm:net-zero-achievement ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires ngm:ghg-baseline,
        ngm:implementation-strategy,
        ngm:reduction-targets ;
    vc:slug "carbon-neutrality-planning" ;
    vc:sourceDomain "spatial-computing" .

ngm:cbeci a owl:Class ;
    rdfs:label "CBECI"@en ;
    rdfs:comment "The Cambridge Bitcoin Electricity Consumption Index (CBECI) is a real-time model produced by the Cambridge Centre for Alternative Finance that estimates the annualised electricity consumption and carbon footprint of the Bitcoin proof-of-work mining network. It aggregates hardware efficiency data from known ASIC models, network hash rate, and electricity price assumptions to produce lower-, central-, and upper-bound estimates."@en ;
    rdfs:subClassOf ngm:benchmark-evaluation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:bitcoin-environmental-issues,
        ngm:cambridge-centre-for-alternative-finance,
        ngm:proof-of-work-energy-consumption ;
    vc:slug "cbeci" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:cbeci-methodology,
        ngm:electricity-consumption,
        ngm:hash-rate .

ngm:clock-synchronization a owl:Class ;
    rdfs:label "Clock Synchronization"@en ;
    rdfs:comment "Clock Synchronization is the process of coordinating the time references of distributed computing nodes or electronic systems so that they share a consistent and accurate notion of time, enabling correct ordering of events, coordinated actions, and time-stamped record-keeping. Protocols such as NTP (Network Time Protocol) and PTP (Precision Time Protocol, IEEE 1588) achieve synchronization by exchanging timestamped messages and compensating for network propagation delays. Accurate clock synchronization is critical for distributed databases, consensus algorithms, telecommunications, industrial control systems, and financial transaction ordering."@en ;
    rdfs:subClassOf ngm:network-synchronization ;
    vc:enables ngm:consensus-mechanism,
        ngm:distributed-systems,
        ngm:time-sensitive-networking ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:internet-of-things,
        ngm:latency,
        ngm:timestamp-service ;
    vc:slug "clock-synchronization" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:synchronization-protocol,
        ngm:timestamp .

ngm:cold-storage a owl:Class ;
    rdfs:label "Cold Storage"@en ;
    rdfs:comment "Cold Storage in the context of digital assets and cryptocurrency refers to the practice of holding private keys in an offline environment — physically disconnected from any network — to eliminate the attack surface presented by internet-connected systems. Hardware wallets, air-gapped computers, and paper wallets are common cold storage implementations. By contrast with hot wallets (internet-connected), cold storage sacrifices transaction convenience for maximum security, and is the industry standard for custodying large quantities of cryptocurrency at exchanges, institutional custodians, and high-net-worth individual holders."@en ;
    rdfs:subClassOf ngm:custody-infrastructure ;
    vc:enables ngm:institutional-custody,
        ngm:self-custody ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:bitcoin-network,
        ngm:decentralized-finance-de-fi,
        ngm:multisignature-wallets,
        ngm:threshold-signature-scheme ;
    vc:slug "cold-storage" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:cryptographic-key-management,
        ngm:hardware-security-module,
        ngm:multisignature .

ngm:collective-action a owl:Class ;
    rdfs:label "Collective Action"@en ;
    rdfs:comment "Coordinated behaviour by a group of individuals or organisations toward a shared goal that no single actor could achieve unilaterally. It is characterised by interdependence, the risk of free-riding, and the need for mechanisms — such as incentives, norms, or contracts — to align individual contributions with the group objective."@en ;
    rdfs:subClassOf ngm:coordination-mechanisms ;
    vc:enables ngm:collective-governance,
        ngm:public-goods-funding ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:collective-intelligence,
        ngm:common-pool-resources,
        ngm:community-governance ;
    vc:slug "collective-action" ;
    vc:sourceDomain "governance" ;
    vc:uses ngm:coordination-protocol .

ngm:communication-interface a owl:Class ;
    rdfs:label "Communication Interface"@en ;
    rdfs:comment "A communication interface is a defined boundary — hardware, software, or logical — through which two or more distinct systems, components, or agents exchange data, commands, or signals according to agreed protocols and encodings. It abstracts the internal implementation details of each participant, exposing only the contract necessary for interoperability, and may operate synchronously or asynchronously across local buses, networks, or inter-process mechanisms. Communication interfaces are fundamental to modular system design, enabling independent development, testing, and replacement of components without disrupting the broader system."@en ;
    rdfs:subClassOf ngm:communication-protocol ;
    vc:enables ngm:api-integration,
        ngm:distributed-system,
        ngm:microservices ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:data-access-interface,
        ngm:network-protocol,
        ngm:user-interface ;
    vc:slug "communication-interface" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:middleware,
        ngm:rest-api .

ngm:compliance-domain a owl:Class ;
    rdfs:label "Compliance Domain"@en ;
    rdfs:comment "The Compliance Domain covers the processes by which organisations demonstrate adherence to laws, regulations, standards and internal policies. Its scope includes control frameworks, monitoring, audit and reporting of conformance. It is a top-level subject classification applied across regulated activities. The boundary excludes the creation of the rules themselves, which belongs to the Regulation Domain."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:control-framework ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:regulation-domain ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:risk-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:knowledge-representation-domain ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:audit ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:compliance-monitoring ],
        ngm:owl-thing ;
    vc:enables ngm:audit-readiness,
        ngm:obligation-tracking,
        ngm:regulatory-conformance ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:audit,
        ngm:compliance-monitoring,
        ngm:conformance-reporting,
        ngm:control-framework,
        ngm:policy-management ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:knowledge-representation-domain,
        ngm:regulation-domain,
        ngm:risk-management ;
    vc:slug "compliance-domain" ;
    vc:sourceDomain "compliance" .

ngm:compound-governor-bravo a owl:Class ;
    rdfs:label "Compound Governor Bravo"@en ;
    rdfs:comment "Compound Governor Bravo is the second-generation on-chain governance contract deployed by the Compound protocol, superseding the original Governor Alpha with enhanced parameter configurability and an abstraction layer that separates governance logic from the Timelock executor. It enables COMP token holders to create, vote on, and execute governance proposals that modify protocol parameters such as interest rate models, collateral factors, and supported assets. Governor Bravo introduced the ability to update governance parameters without a full contract migration, reducing the friction of iterative governance improvements. The contract has become an influential reference implementation, widely forked by other DeFi protocols seeking battle-tested on-chain governance infrastructure."@en ;
    rdfs:subClassOf ngm:on-chain-governance ;
    vc:enables ngm:dao,
        ngm:decentralised-finance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:compound,
        ngm:dao-governance,
        ngm:governance-token ;
    vc:slug "compound-governor-bravo" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:blockchain-governance ;
    vc:uses ngm:proposal-system,
        ngm:token-weighted-voting,
        ngm:voting-mechanism .

ngm:computational-infrastructure a owl:Class ;
    rdfs:label "Computational Infrastructure"@en ;
    rdfs:comment "Computational infrastructure refers to the ensemble of physical and virtualised hardware resources, networking fabric, storage systems, and supporting services that provide the computational substrate upon which software workloads execute. It encompasses data centres, server clusters, GPUs, networking interconnects, and the orchestration layers that manage resource allocation, scheduling, and fault tolerance. In the context of AI and large-scale distributed systems, computational infrastructure determines the ceiling on model scale, training throughput, and inference latency, making it a strategic bottleneck as much as a technical one."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:cloud-infrastructure ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:storage-infrastructure ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:gpu-computing ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:compute-resources ],
        ngm:digital-infrastructure ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:cloud-infrastructure,
        ngm:compute-resources,
        ngm:gpu-computing,
        ngm:storage-infrastructure ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:compute-layer,
        ngm:computing-infrastructure ;
    vc:slug "computational-infrastructure" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:ai-infrastructure,
        ngm:blockchain-infrastructure .

ngm:content-delivery-network-cdn a owl:Class ;
    rdfs:label "Content Delivery Network (CDN)"@en ;
    rdfs:comment "A geographically distributed network of proxy servers and data centers designed to provide high availability, high performance, and low latency content delivery by caching content closer to end-users."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:routing-protocol ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:storage-systems ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:load-balancer ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:network-infrastructure ],
        ngm:infra-network-and-comms,
        ngm:network-infrastructure ;
    skos:broader ngm:infra-network-and-comms ;
    vc:enables ngm:ddo-s-protection,
        ngm:geographic-redundancy,
        ngm:low-latency-content-delivery,
        ngm:scalable-distribution ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:cache-system,
        ngm:edge-server,
        ngm:load-balancer,
        ngm:origin-server,
        ngm:routing-protocol ;
    vc:isPartOf ngm:network-infrastructure ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:dns-service,
        ngm:network-infrastructure,
        ngm:storage-systems ;
    vc:slug "content-delivery-network-cdn" ;
    vc:sourceDomain "infrastructure" .

ngm:control-layer a owl:Class ;
    rdfs:label "Control Layer"@en ;
    rdfs:comment "The Control Layer is the stratum that issues commands to actuators or subsystems to drive a system toward desired states. It sits above the Perception Layer, on whose estimates it acts, and below planning and agent strata that set goals. It contains controllers, feedback loops, set-point logic, and the actuation interfaces that effect change."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:perception-layer ],
        ngm:owl-thing ;
    vc:enables ngm:agent-layer,
        ngm:coordination-layer ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:perception-layer ;
    vc:slug "control-layer" ;
    vc:sourceDomain "control" .

ngm:convergence a owl:Class ;
    rdfs:label "Convergence"@en ;
    rdfs:comment "Technological Convergence is the macro-level process by which previously distinct technologies, disciplines, and sociotechnical systems merge, overlap, and mutually reinforce to produce qualitatively new capabilities, applications, and social configurations that none of the converging components ..."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:nbic-convergence ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:quantum-computing ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:internet-of-things ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:digital-twin ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:moore-s-law ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:interoperability-protocol ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:open-standard ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:cyber-physical-systems ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:spatial-computing ],
        [ a owl:Restriction ;
