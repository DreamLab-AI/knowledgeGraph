ngm:ethical-sourcing a owl:Class ;
    rdfs:label "Ethical Sourcing"@en ;
    rdfs:comment "ical Sourcing is the corporate and institutional procurement discipline that selects, qualifies and monitors suppliers across multi-tier global supply chains against verifiable human rights, labour, environmental and anti-corruption standards — operationalised through codified frameworks ("@en ;
