        ngm:retrieval-augmented-generation ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:positional-encoding,
        ngm:token ;
    vc:isPartOf ngm:large-language-models,
        ngm:transformer-architecture ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:context-engineering,
        ngm:language-modeling,
        ngm:lost-in-the-middle-effect,
        ngm:model-context-protocol,
        ngm:model-hyperparameter,
        ngm:prompt-engineering ;
    vc:requires ngm:attention-mechanism,
        ngm:key-value-cache,
        ngm:neural-network-text-tokenisation ;
    vc:slug "context-window" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:dc-protocol-and-infra a owl:Class,
        skos:Concept ;
    rdfs:label "Protocol and Infrastructure"@en ;
    rdfs:comment "Taxonomy hub for the communication protocols, data-interchange formats, and underlying infrastructure that enable distributed collaboration. Encompasses decentralised messaging protocols, identity systems, content-addressed storage, version control, and the networking substrate on which remote collaborative workflows operate."@en ;
