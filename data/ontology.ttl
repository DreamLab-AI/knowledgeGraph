ngm:narrative-content a owl:Class ;
    rdfs:label "Narrative Content"@en ;
    rdfs:comment "Digital storytelling material that combines video, audio, images, text, and interactive elements to create immersive narrative experiences, enabling audiences to engage with stories through multiple media formats and increasingly through participatory technologies like VR, AR, and interactive video."@en ;
    rdfs:subClassOf ngm:digital-content,
        ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:enables ngm:personalized-virtual-experiences ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:slug "narrative-content" ;
    vc:sourceDomain "spatial-computing" .

ngm:navigation-stack a owl:Class ;
    rdfs:label "Navigation Stack"@en ;
    rdfs:comment "A navigation stack is the integrated software subsystem of a mobile robot responsible for taking it from a current pose to a goal pose while avoiding obstacles. It composes mapping, localisation, global path planning, and local trajectory control into a coordinated pipeline. The stack consumes sensor data and a map, and emits velocity commands that drive the robot's actuators."@en ;
    rdfs:subClassOf ngm:robo-navigation-and-planning ;
    skos:broader ngm:robo-navigation-and-planning ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:ground-robot,
        ngm:nav2 ;
    vc:slug "navigation-stack" ;
    vc:sourceDomain "robotics" .

ngm:nbic-convergence a owl:Class ;
    rdfs:label "NBIC Convergence"@en ;
    rdfs:comment "NBIC convergence refers to the integration of Nanotechnology, Biotechnology, Information technology, and Cognitive science into mutually reinforcing capabilities. The premise is that advances in each field accelerate the others, enabling systems that span the molecular, biological, computational, and cognitive scales. It is a foundational framing in technology-foresight and innovation-policy discussions of long-horizon transformative change."@en ;
    rdfs:subClassOf ngm:economics ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:convergence ;
    vc:slug "nbic-convergence" ;
    vc:sourceDomain "governance" .

ngm:network-interface-card a owl:Class ;
    rdfs:label "Network Interface Card"@en ;
    rdfs:comment "A network interface card (NIC) is the hardware component that connects a computing device to a network and implements the physical and data-link layer functions for sending and receiving frames. It encodes outgoing data onto the transmission medium, decodes incoming signals, and carries a unique MAC address for link-layer addressing. Modern NICs often offload checksum, segmentation, and encryption work from the CPU."@en ;
    rdfs:subClassOf ngm:network-component ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:physical-layer ;
    vc:slug "network-interface-card" ;
    vc:sourceDomain "infrastructure" .

ngm:network-participation a owl:Class ;
    rdfs:label "Network Participation"@en ;
    rdfs:comment "Network participation is the act of an entity contributing resources or actions to a decentralised network in exchange for the right to influence and benefit from it. In blockchain systems this includes running nodes, validating or proposing blocks, providing liquidity, or voting, typically backed by staked capital or computational work. Participation rules and incentives determine the network's security, decentralisation, and reward distribution."@en ;
    rdfs:subClassOf ngm:economic-mechanism ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:blockchain-entity,
        ngm:reward-distribution ;
    vc:slug "network-participation" ;
    vc:sourceDomain "blockchain" .

ngm:neural-audio-enhancement a owl:Class ;
    rdfs:label "Neural Audio Enhancement"@en ;
    rdfs:comment "Neural audio enhancement is the use of deep learning models to improve the perceptual quality of recorded audio by removing noise, reverberation, and artefacts or by restoring lost detail. Models are trained on paired clean and degraded audio to learn a mapping that suppresses unwanted components while preserving the target signal. It is widely applied to speech in podcasting, conferencing, and media post-production."@en ;
    rdfs:subClassOf ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:automated-podcasting ;
    vc:slug "neural-audio-enhancement" ;
    vc:sourceDomain "ai" .

ngm:neural-network-training a owl:Class ;
    rdfs:label "Neural Network Training"@en ;
    rdfs:comment "Neural network training is the process of iteratively adjusting a model's weights to minimise a loss function over a dataset, typically using gradient descent with backpropagation. Each step computes the gradient of the loss with respect to parameters and updates them via an optimiser, repeating across many batches and epochs. Training quality depends on data, objective design, regularisation, and substantial parallel compute."@en ;
    rdfs:subClassOf ngm:machine-learning-technique ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:generative-ai,
        ngm:training-hardware ;
    vc:slug "neural-network-training" ;
    vc:sourceDomain "ai" .

ngm:neuromorphic-chip a owl:Class ;
    rdfs:label "Neuromorphic Chip"@en ;
    rdfs:comment "A neuromorphic chip is a specialised integrated circuit designed to emulate the structure and dynamics of biological neural networks, employing analogue or mixed-signal circuits to implement spiking neuron models that process information through sparse, event-driven spikes rather than continuous clock-driven computation. This brain-inspired architecture achieves orders-of-magnitude improvements in energy efficiency for pattern recognition, sensory processing, and on-device inference compared with conventional von Neumann processors. Representative implementations include IBM TrueNorth and Intel Loihi."@en ;
    rdfs:subClassOf ngm:ai-infrastructure ;
    vc:enables ngm:edge-ai-accelerator,
        ngm:on-device-learning,
        ngm:tiny-ml ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:ai-hardware,
        ngm:neuromorphic-computing ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:cognitive-architecture,
        ngm:gpu-compute,
        ngm:tensor-processing-unit ;
    vc:slug "neuromorphic-chip" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:inference-hardware,
        ngm:parallel-processing .

ngm:noise-schedule a owl:Class ;
    rdfs:label "Noise Schedule"@en ;
    rdfs:comment "A noise schedule is the function that determines how much Gaussian noise is added at each step of a diffusion model's forward process and, correspondingly, removed during sampling. It governs the variance trajectory from clean data to pure noise and strongly affects sample quality, training stability, and the number of steps required. Common forms include linear, cosine, and learned schedules."@en ;
    rdfs:subClassOf ngm:machine-learning-technique ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:diffusion-models,
        ngm:sampling ;
    vc:slug "noise-schedule" ;
    vc:sourceDomain "ai" .

ngm:normalising-flows a owl:Class ;
    rdfs:label "Normalising Flows"@en ;
    rdfs:comment "Normalising flows are a class of generative models that learn complex probability distributions by composing a series of invertible, differentiable transformations that map a simple base distribution (typically Gaussian) to the target distribution, with exact log-likelihood computation via the change-of-variables formula and the Jacobian determinant. Both sampling and density evaluation are tractable."@en ;
    rdfs:subClassOf ngm:generative-ai ;
    vc:enables ngm:bayesian-inference ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:diffusion-model,
        ngm:gaussian-process ;
    vc:slug "normalising-flows" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:gaussian-distribution .

ngm:notion a owl:Class ;
    rdfs:label "Notion"@en ;
    rdfs:comment "Notion is a cloud-based productivity and knowledge-management platform that unifies note-taking, relational databases, wikis, project management boards, and document editing into a single composable workspace. Its block-based editor treats every content element — text, tables, embeds, code, and media — as a manipulable unit that can be nested, linked, and filtered, enabling teams to construct custom workflows without traditional software development. Notion serves as an all-in-one tool replacing multiple specialised SaaS products for many knowledge workers and organisations. Since 2023 Notion has integrated generative AI capabilities directly into its editing and querying workflows."@en ;
    rdfs:subClassOf ngm:knowledge-management-system ;
    vc:enables ngm:asynchronous-collaboration,
        ngm:shared-knowledge-base ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:collaboration-platform,
        ngm:knowledge-base,
        ngm:knowledge-management ;
    vc:slug "notion" ;
    vc:sourceDomain "web" ;
    vc:uses ngm:api-integration,
        ngm:database-system .

ngm:nuclear-energy a owl:Class ;
    rdfs:label "Nuclear Energy"@en ;
    rdfs:comment "Nuclear energy is electrical power generated by harnessing the heat released from nuclear fission of heavy isotopes, typically uranium-235, in a controlled reactor. It provides high-density, low-carbon, dispatchable baseload generation independent of weather conditions. Its role in decarbonisation is balanced against concerns over capital cost, long construction times, radioactive-waste management, and safety."@en ;
    rdfs:subClassOf ngm:sustainability ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:energy-and-power ;
    vc:slug "nuclear-energy" ;
    vc:sourceDomain "infrastructure" .

ngm:object-detection-and-tracking a owl:Class ;
    rdfs:label "Object Detection and Tracking"@en ;
    rdfs:comment "Object Detection and Tracking combines spatial object localisation with temporal tracking to identify, classify, and follow objects across video frames or sensor streams."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:computer-vision ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:deep-learning ],
        ngm:sc-interaction ;
    skos:broader ngm:sc-interaction ;
    vc:enables ngm:autonomous-navigation,
        ngm:human-tracking-and-slam-capture ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:object-detection ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:requires ngm:computer-vision,
        ngm:deep-learning ;
    vc:slug "object-detection-and-tracking" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:convolutional-neural-network,
        ngm:image-segmentation .

ngm:octree-spatial-index a owl:Class ;
    rdfs:label "Octree Spatial Index"@en ;
    rdfs:comment "An octree spatial index is a tree data structure that recursively subdivides 3D space into eight octants, organising objects by their spatial location for efficient querying. It accelerates operations such as range queries, nearest-neighbour search, collision detection, and visibility culling by pruning regions that cannot contain relevant objects. It is a core building block for spatial partitioning in 3D engines and virtual worlds."@en ;
    rdfs:subClassOf ngm:sc-display-and-rendering ;
    skos:broader ngm:sc-display-and-rendering ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:vircadia ;
    vc:slug "octree-spatial-index" ;
    vc:sourceDomain "metaverse" .

ngm:ofcom a owl:Class ;
    rdfs:label "Ofcom"@en ;
    rdfs:comment "Ofcom (the Office of Communications) is the independent statutory regulator and competition authority for the UK communications industries, established by the Communications Act 2003. Its remit covers broadcasting, telecommunications, postal services, and — following the Online Safety Act 2023 — online platforms. It enforces spectrum management, sets licence conditions for broadcasters and telecoms operators, adjudicates on consumer complaints, and oversees compliance with the UK Online Safety Act framework requiring platforms to implement systems preventing access to illegal content."@en ;
    rdfs:subClassOf ngm:regulatory-authority ;
    vc:enables ngm:compliance-monitoring,
        ngm:content-moderation-standards ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:content-moderation,
        ngm:online-safety-act-2023,
        ngm:telecommunications-infrastructure,
        ngm:uk-online-safety-act ;
    vc:slug "ofcom" ;
    vc:sourceDomain "governance" ;
    vc:standardizedBy ngm:compliance-framework,
        ngm:digital-regulation .

ngm:oma-3 a owl:Class ;
    rdfs:label "OMA3"@en ;
    rdfs:comment "The Open Metaverse Alliance for Web3, an industry consortium of companies working to develop open standards and interoperability for metaverse platforms and digital assets."@en ;
    rdfs:subClassOf ngm:standards-body ;
    vc:enables ngm:interoperability-standards ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:slug "oma-3" ;
    vc:sourceDomain "governance" .

ngm:on-chain-identity a owl:Class ;
    rdfs:label "On-Chain Identity"@en ;
    rdfs:comment "On-chain identity is a persistent, cryptographically controlled identifier recorded on a blockchain that an entity uses to accumulate verifiable attributes, history, and reputation. Anchored to an address or smart contract and controlled by private keys, it can hold credentials, tokens, and attestations that other applications read trustlessly. It enables portable reputation and access control across decentralised applications."@en ;
    rdfs:subClassOf ngm:digital-identity ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:nft-minting,
        ngm:reputation-system ;
    vc:slug "on-chain-identity" ;
    vc:sourceDomain "blockchain" .

ngm:on-device-inference a owl:Class ;
    rdfs:label "On-Device Inference"@en ;
    rdfs:comment "On-device inference is the execution of machine learning model forward passes entirely on the end-user's hardware — such as a smartphone, wearable, embedded controller, or edge server — without transmitting input data to a remote cloud backend. It requires models to be compressed, quantised, or distilled to fit within tight memory, compute, and power budgets while maintaining acceptable accuracy."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:hardware-acceleration ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:model-compression-for-edge ],
        ngm:edge-inference ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.88"^^xsd:float ;
    vc:relatedTo ngm:knowledge-distillation-for-edge,
        ngm:npu,
        ngm:privacy-preserving-ai ;
    vc:requires ngm:hardware-acceleration,
        ngm:model-compression-for-edge ;
    vc:slug "on-device-inference" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:onnx-runtime .

ngm:onnx-operator-set a owl:Class ;
    rdfs:label "ONNX Operator Set"@en ;
    rdfs:comment "An ONNX operator set is a versioned collection of the computational operators defined by the Open Neural Network Exchange format, fixing the operators and their semantics that a model may use."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:onnx ],
        ngm:onnx ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:onnx ;
    vc:slug "onnx-operator-set" ;
    vc:sourceDomain "machine-learning" .

ngm:onnx-standard a owl:Class ;
    rdfs:label "ONNX Standard"@en ;
    rdfs:comment "The ONNX standard defines an open format for representing machine learning models as a computation graph of typed operators, enabling models to move between training and inference frameworks."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:onnx ],
