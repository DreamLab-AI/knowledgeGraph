    vc:requires ngm:audio-processing ;
    vc:slug "speech-processing" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:spherical-harmonics a owl:Class ;
    rdfs:label "Spherical Harmonics"@en ;
    rdfs:comment "Spherical harmonics are a complete set of orthogonal basis functions defined on the surface of a sphere, used to represent functions of direction compactly as a weighted sum of coefficients. Analogous to a Fourier series on the sphere, they allow smooth angular functions — such as incoming light or a directional colour — to be approximated with a small number of low-order coefficients. In computer graphics they underpin precomputed radiance transfer, irradiance environment lighting, and, more recently, view-dependent colour in Gaussian splatting and neural rendering."@en ;
    rdfs:subClassOf ngm:computer-graphics ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:gaussian-splatting,
        ngm:rendering-pipeline ;
    vc:slug "spherical-harmonics" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:neural-rendering,
        ngm:real-time-rendering .

ngm:stakeholder-consultation a owl:Class ;
    rdfs:label "Stakeholder Consultation"@en ;
    rdfs:comment "Stakeholder consultation is the structured process of seeking, gathering, and incorporating the views of parties affected by or interested in a decision, policy, or project. It enhances legitimacy, surfaces risks and local knowledge, and builds trust by giving affected groups a genuine voice before decisions are finalised. Consultation ranges from informing and gathering feedback through to collaborative and participatory decision-making."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:transparency ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:accountability ],
        ngm:governance-framework ;
    vc:bridgesTo ngm:governance ;
    vc:contrastsWith ngm:regulatory-compliance ;
    vc:dependsOn ngm:accountability ;
    vc:enables ngm:impact-assessment,
        ngm:policy-framework ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:governance-framework ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:impact-assessment,
        ngm:policy-framework,
        ngm:transparency ;
    vc:requires ngm:accountability,
        ngm:transparency ;
    vc:slug "stakeholder-consultation" ;
    vc:sourceDomain "governance" ;
    vc:supports ngm:governance-framework,
        ngm:regulatory-compliance ;
    vc:uses ngm:impact-assessment .

ngm:stakeholder-participation a owl:Class ;
    rdfs:label "Stakeholder Participation"@en ;
    rdfs:comment "Stakeholder participation is the structured involvement of affected and interested parties in the deliberation, design, and decision-making processes that govern a system, organisation, or protocol. It encompasses mechanisms for consultation, representation, and shared authority that aim to surface diverse interests and confer legitimacy on collective decisions. In governance contexts it is a precondition for accountable, inclusive, and durable outcomes."@en ;
    rdfs:subClassOf ngm:stakeholder-engagement-in-ai ;
    vc:bridgesTo ngm:legitimacy ;
    vc:contrastsWith ngm:decentralised-governance ;
    vc:dependsOn ngm:multi-stakeholder-governance ;
    vc:enables ngm:legitimacy ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:multi-stakeholder-governance ;
    vc:isPartOf ngm:governance-process ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:governance,
        ngm:stakeholder-engagement-in-ai ;
    vc:requires ngm:public-consultation ;
    vc:slug "stakeholder-participation" ;
    vc:sourceDomain "governance" ;
    vc:supports ngm:consensus-mechanism,
        ngm:decentralised-governance ;
    vc:uses ngm:public-consultation .

ngm:standardization-bodies a owl:Class ;
    rdfs:label "Standardization Bodies"@en ;
    rdfs:comment "Organizations developing technical standards for metaverse technologies, including IEEE (Metaverse Standards Committee), W3C (Immersive Web Working Group), ISO/IEC (3D formats), ITU (telecommunications), and the Metaverse Standards Forum coordinating member organizations for interoperability."@en ;
    rdfs:subClassOf ngm:sc-standards-and-interop ;
