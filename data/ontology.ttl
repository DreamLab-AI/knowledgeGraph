ngm:life-cycle-assessment a owl:Class ;
    rdfs:label "Life Cycle Assessment"@en ;
    rdfs:comment "Life Cycle Assessment (LCA) is a standardised, systematic methodology governed by ISO 14040 and ISO 14044 for compiling and evaluating the inputs, outputs, and potential environmental impacts of a product system across every stage of its life cycle — from raw material extraction through manufacturing, distribution, use, and end-of-life treatment. The methodology quantifies a broad range of environmental impact categories including global warming potential, acidification, eutrophication, water depletion, particulate matter formation, and land use, translating mass and energy inventory flows into midpoint and endpoint indicators via characterisation factor methods such as ReCiPe and CML. LCA provides a rigorous comparative evidence base for eco-design decisions, environmental product declarations, and regulatory compliance, and its scope has expanded to encompass social LCA (S-LCA) and life cycle costing (LCC) within a broader life cycle sustainability assessment framework."@en ;
    rdfs:subClassOf ngm:environmental-assessment ;
    vc:bridgesTo ngm:blockchain-provenance,
        ngm:digital-product-passport,
        ngm:industrial-internet-of-things ;
    vc:contrastsWith ngm:environmental-impact-assessment,
        ngm:material-flow-analysis ;
    vc:enables ngm:carbon-footprint-assessment,
        ngm:eco-design,
        ngm:environmental-product-declaration,
        ngm:environmental-sustainability,
        ngm:green-public-procurement ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:goal-and-scope-definition,
        ngm:lca-interpretation,
        ngm:life-cycle-impact-assessment,
        ngm:life-cycle-inventory ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:carbon-accounting,
        ngm:environmental-impact-assessment,
        ngm:supply-chain-traceability ;
    vc:requires ngm:functional-unit,
        ngm:inventory-data,
        ngm:system-boundary ;
    vc:slug "life-cycle-assessment" ;
    vc:sourceDomain "supply-chain" ;
    vc:standardizedBy ngm:iso-14040,
        ngm:iso-14044,
        ngm:product-environmental-footprint ;
    vc:supports ngm:circular-economy,
        ngm:esg-reporting,
        ngm:scope-3-emissions ;
    vc:uses ngm:characterisation-factors,
        ngm:ecoinvent-database,
        ngm:material-flow-analysis .

ngm:middleware a owl:Class ;
    rdfs:label "Middleware"@en ;
    rdfs:comment "Software layer that mediates between applications and underlying services or infrastructure to enable communication, resource access, and interoperability."@en ;
