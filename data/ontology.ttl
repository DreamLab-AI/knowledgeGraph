ngm:machine-learning-classifier a owl:Class ;
    rdfs:comment "A machine learning classifier is a supervised learning model trained to assign an input to one of a discrete set of predefined categories, based on patterns learned from labelled training examples. Implementations range from logistic regression and decision trees to deep neural networks, selected according to data volume, interpretability needs and accuracy requirements. Classifiers are deployed in screening and enforcement pipelines that must flag entities matching a target category, such as sanctions screening."@en ;
    rdfs:label "Machine Learning Classifier"@en ;
    rdfs:subClassOf ngm:supervised-learning ;
    rdfs:subClassOf _:r13748 ;
    vc:hasMaturity ngmi:maturity-draft ;
