ngm:generative-adversarial-network a owl:Class ;
    rdfs:label "Generative Adversarial Network"@en ;
    rdfs:comment "A Generative Adversarial Network (GAN) is a deep learning architecture in which a generator network and a discriminator network are trained simultaneously in an adversarial min-max game: the generator learns to produce synthetic samples indistinguishable from real data, while the discriminator learns to detect fakes. GANs underpin high-fidelity image synthesis, video generation, data augmentation, and synthetic data creation across domains including healthcare, finance, and computer vision."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:backpropagation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:neural-network ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:generator-network ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:training-data ],
        ngm:ai-model-architecture ;
    skos:broader ngm:ai-model-architecture ;
    vc:bridgesTo ngm:federated-learning,
        ngm:privacy-preserving-ai ;
    vc:contrastsWith ngm:autoencoder,
        ngm:diffusion-model,
        ngm:variational-autoencoder ;
    vc:enables ngm:data-augmentation,
        ngm:deepfake,
        ngm:image-generation,
        ngm:super-resolution,
        ngm:synthetic-data,
        ngm:synthetic-media ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:adversarial-training,
        ngm:discriminator-network,
        ngm:generator-network ;
    vc:implements ngm:min-max-game,
        ngm:unsupervised-learning ;
    vc:isPartOf ngm:deep-learning,
        ngm:generative-ai ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:computer-vision,
        ngm:natural-language-processing ;
    vc:requires ngm:backpropagation,
        ngm:neural-network,
        ngm:training-data ;
    vc:slug "generative-adversarial-network" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:convolutional-neural-network,
        ngm:latent-space .

ngm:know-your-customer a owl:Class ;
    rdfs:label "Know Your Customer"@en ;
    rdfs:comment "Know Your Customer (KYC) is a regulatory and compliance process by which financial institutions and other regulated entities verify the identity of their clients, assess their risk profiles, and understand the nature of their financial activities to prevent money laundering, terrorist financing, and other financial crimes. KYC encompasses identity document verification, biometric checks, beneficial ownership disclosure, and ongoing transaction monitoring. The process is mandated by the Financial Action Task Force (FATF) recommendations and implemented through national legislation including the EU Anti-Money Laundering Directives, the US Bank Secrecy Act, and equivalent statutes in over 200 jurisdictions."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:biometric-verification ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:digital-identity-verification ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:risk-assessment ],
        ngm:compliance ;
