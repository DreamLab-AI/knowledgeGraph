        ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:bridgesTo ngm:ai-framework,
        ngm:digital-twin ;
    vc:contrastsWith ngm:brute-force-search,
        ngm:heuristic-methods ;
    vc:enables ngm:automated-planning,
        ngm:game-ai,
        ngm:inference,
        ngm:procedural-content-generation,
        ngm:reinforcement-learning,
        ngm:robotics ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:algorithm,
        ngm:data-structure,
        ngm:graph-algorithms,
        ngm:heuristic-methods,
        ngm:learning-algorithm,
