ngm:based-on a owl:Class ;
    rdfs:label "based on"@en ;
    rdfs:comment "\"Based on\" is a provenance and derivation relation used in robotics standards and quality management frameworks to indicate that a system, design, or specification is derived from or conforms to an authoritative reference standard such as ISO 9001 or functional-safety norms. Within the robotics domain it records the normative lineage of robot software architectures, safety certifications, and performance benchmarks relative to their governing standards."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:standardization-bodies ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:standards-documentation ],
        ngm:robo-safety-and-standards,
        ngm:safety-standard ;
    skos:broader ngm:robo-safety-and-standards ;
    vc:bridgesTo ngm:robotics-platform ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:functional-safety,
        ngm:iso-standards,
        ngm:quality-standard,
        ngm:robotics ;
    vc:requires ngm:standardization-bodies,
        ngm:standards-documentation ;
    vc:slug "based-on" ;
    vc:sourceDomain "robotics" ;
    vc:supports ngm:robot-safety,
        ngm:robotics-systems ;
    vc:uses ngm:compliance-standards,
        ngm:standards-conformance .

