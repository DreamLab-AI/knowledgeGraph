ngm:programmable-money a owl:Class ;
    rdfs:label "Programmable Money"@en ;
    rdfs:comment "Programmable Money is a form of digital currency in which the conditions governing the creation, transfer, and use of monetary units are encoded as executable logic—typically within smart contracts on a public or permissioned blockchain—and enforced autonomously without requiring trusted intermediaries. This enables payment instruments that can embed compliance rules, spending constraints, vesting schedules, or multi-party approval workflows directly into the currency itself, transforming money from a passive bearer instrument into an active, self-enforcing contractual construct. Central bank digital currencies (CBDCs), tokenised commercial bank deposits, DeFi stablecoins, and protocol-native assets are all instances of programmable money at different points on the decentralisation and trust spectrum. The paradigm extends the concept of money from a static store of value and medium of exchange into a substrate for encoding and automating financial relationships."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:cbdcs ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:stablecoin ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:consensus-mechanism ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:blockchain ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:token-standard ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:smart-contract ],
        ngm:digital-currency ;
    vc:bridgesTo ngm:algorithmic-governance,
        ngm:machine-economy,
        ngm:multi-agent-systems ;
    vc:contrastsWith ngm:commodity-money,
        ngm:electronic-money,
        ngm:fiat-currency ;
    vc:dependsOn ngm:cryptographic-hash-function,
        ngm:digital-identity,
        ngm:distributed-ledger-technology ;
    vc:enables ngm:atomic-swap,
        ngm:automated-market-maker,
        ngm:decentralized-finance-de-fi,
        ngm:delivery-versus-payment,
        ngm:payment-system ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:cbdcs,
        ngm:stablecoin,
        ngm:token-standard ;
    vc:qualityScore "0.73"^^xsd:float ;
    vc:relatedTo ngm:decentralized-autonomous-organisation,
        ngm:financial-regulation,
        ngm:liquidity,
        ngm:monetary-policy ;
    vc:requires ngm:blockchain,
        ngm:consensus-mechanism,
        ngm:smart-contract,
        ngm:tokenisation ;
    vc:slug "programmable-money" ;
    vc:sourceDomain "blockchain" .

ngm:py-torch a owl:Class ;
    rdfs:label "PyTorch"@en ;
    rdfs:comment "PyTorch is an open-source deep learning framework developed by Meta AI Research that provides a dynamic computation graph, automatic differentiation via autograd, and tight integration with Python for flexible model development and research. It has become the dominant framework in academic machine learning research and is widely used in production via TorchServe and TorchScript. PyTorch's tensor operations are GPU-accelerated through CUDA, and its ecosystem encompasses libraries such as TorchVision, TorchAudio, and PyTorch Lightning."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gpu-compute ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cuda ],
        ngm:machine-learning-discipline-framework ;
    vc:enables ngm:deep-learning,
        ngm:diffusion-model,
        ngm:fine-tuning,
        ngm:neural-network ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:generative-ai,
        ngm:large-scale-pretrained-foundation-model,
        ngm:open-source-framework ;
    vc:requires ngm:cuda,
        ngm:gpu-compute ;
    vc:slug "py-torch" ;
    vc:sourceDomain "ai" ;
    vc:supports ngm:parameter-efficient-fine-tuning,
        ngm:transfer-learning ;
    vc:uses ngm:attention-mechanism,
        ngm:batch-processing,
        ngm:python-pytorch-deep-learning-stack .

ngm:raft-consensus a owl:Class ;
    rdfs:label "RAFT Consensus"@en ;
    rdfs:comment "Raft is a distributed consensus algorithm designed as a more understandable alternative to Paxos, decomposing consensus into three relatively independent sub-problems: leader election, log replication, and safety. A Raft cluster elects a single leader by majority vote during which followers grant a term-limited mandate; the leader receives all client writes, appends them to its log, and replicates them to followers, committing entries once a quorum acknowledges receipt. Raft guarantees that committed entries are never lost as long as a majority of nodes remain connected, providing crash fault tolerance but not Byzantine fault tolerance."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:consensus-algorithm ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:distributed-system ],
        ngm:bc-protocol-and-consensus ;
    skos:broader ngm:bc-protocol-and-consensus ;
    vc:contrastsWith ngm:byzantine-fault-tolerance ;
    vc:enables ngm:fault-tolerance,
        ngm:state-machine-replication ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:distributed-ledger ;
    vc:requires ngm:consensus-algorithm,
        ngm:distributed-system ;
    vc:slug "raft-consensus" ;
    vc:sourceDomain "blockchain" .

ngm:rb-0021-robot-kinematics a owl:Class ;
    rdfs:label "rb 0021 robot kinematics"@en ;
    rdfs:comment "Robot kinematics is the study of the geometry and motion of robot mechanisms — particularly manipulator arms — without regard to the forces or torques that cause motion. It encompasses forward kinematics (computing end-effector pose from joint configurations), inverse kinematics (computing joint configurations for a desired end-effector pose), Jacobian analysis relating joint velocities to Cartesian velocities, and singularity analysis. Kinematic models are foundational inputs to motion planning, trajectory generation, and control law design."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:inverse-kinematics ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:forward-kinematics ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:rb-0030-jacobian-matrix ],
        ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:enables ngm:rb-0049-motion-planning,
        ngm:rb-0064-computed-torque-control ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:forward-kinematics,
        ngm:inverse-kinematics,
        ngm:rb-0030-jacobian-matrix ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:rb-0022-robot-dynamics,
        ngm:rb-0023-degrees-of-freedom,
        ngm:rb-0031-singularity ;
    vc:slug "rb-0021-robot-kinematics" ;
    vc:sourceDomain "robotics" .

ngm:secp256k1 a owl:Class ;
    rdfs:label "secp256k1"@en ;
    rdfs:comment "secp256k1 is a Koblitz elliptic curve defined by the short Weierstrass equation y² = x³ + 7 over the 256-bit prime field ᴽₚ (where p = 2²⁵⁶ − 2³² − 977), standardised in SEC 2 by the Standards for Efficient Cryptography Group (SECG) and widely adopted as the asymmetric cryptographic backbone of Bitcoin, Ethereum, and dozens of subsequent blockchain protocols. Its specific Koblitz-form parameters permit the Frobenius endomorphism optimisation (GLV decomposition), yielding scalar multiplication roughly 30% faster than equivalent-security NIST curves without requiring a random-looking but opaque seed. The curve underpins both the Elliptic Curve Digital Signature Algorithm (ECDSA) used for transaction authorisation and, via BIP 340, the Schnorr signature scheme that enables key and signature aggregation in Taproot-based Bitcoin smart contracts."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:private-key ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:random-number-generation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:hash-function ],
        ngm:elliptic-curve-cryptography ;
    vc:bridgesTo ngm:multi-party-computation,
        ngm:zero-knowledge-proof ;
    vc:contrastsWith ngm:curve25519,
        ngm:ed25519,
        ngm:nist-p-256 ;
    vc:enables ngm:bitcoin-transaction,
        ngm:digital-signature,
        ngm:public-key-cryptography,
        ngm:taproot,
        ngm:threshold-signature,
        ngm:wallet-address-derivation ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:implements ngm:sec-2-standard ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:blockchain-security,
        ngm:hierarchical-deterministic-wallet,
        ngm:key-derivation-function ;
    vc:requires ngm:hash-function,
        ngm:private-key,
        ngm:random-number-generation ;
    vc:slug "secp256k1" ;
    vc:sourceDomain "blockchain" ;
    vc:standardizedBy ngm:standards-for-efficient-cryptography-group ;
    vc:supports ngm:bitcoin,
        ngm:ethereum,
        ngm:lightning-network,
        ngm:nostr-protocol ;
    vc:uses ngm:ecdsa,
        ngm:elliptic-curve-cryptography,
        ngm:finite-field-arithmetic,
        ngm:schnorr-signature .

