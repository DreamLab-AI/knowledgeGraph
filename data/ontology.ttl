    vc:hasPart ngm:closed-loop-currency,
        ngm:convertible-virtual-currency,
        ngm:non-convertible-virtual-currency ;
    vc:isPartOf ngm:financial-system,
        ngm:virtual-economy ;
    vc:qualityScore "0.0"^^xsd:float ;
