ngm:accountability-ai-0068 a owl:Class ;
    rdfs:label "Accountability (AI-0068)"@en ;
    rdfs:comment "Accountability (AI-0068) is the principle — codified under ontology reference identifier AI-0068 in structured AI ethics and governance frameworks — requiring that organisations developing, deploying, or operating AI systems must be able to demonstrate traceable, enforceable responsibility for the systems' decisions and impacts, provide redress mechanisms when harm occurs, maintain identifiable human oversight over automated processes, and document the entire lifecycle of AI systems through auditable artefacts. It grounds the ethical aspiration of accountability in specific technical and organisational obligations, distinguishing it from aspirational guidelines by imposing concrete requirements for AI audit trails, explainability outputs, model documentation, incident response procedures, and designated role assignments for liability."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:transparency ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:human-oversight ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:incident-response ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:model-registry ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:ai-impact-assessment ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:ai-audit ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:explainable-ai ],
        ngm:accountability,
        ngm:ai-governance-and-ethics ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:enables ngm:ai-regulation,
        ngm:contestability,
        ngm:regulatory-compliance,
        ngm:trust ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:ai-audit,
        ngm:ai-impact-assessment,
        ngm:incident-response,
        ngm:model-card,
        ngm:model-registry ;
    vc:implements ngm:eu-ai-act,
        ngm:iso-iec-42001-2023,
        ngm:nist-ai-risk-management-framework,
        ngm:oecd-ai-principles ;
    vc:qualityScore "0.93"^^xsd:float ;
    vc:relatedTo ngm:ai-governance,
        ngm:algorithmic-accountability,
        ngm:fairness-ai,
        ngm:liability,
        ngm:responsible-ai ;
    vc:requires ngm:ai-documentation,
        ngm:explainable-ai,
        ngm:human-oversight,
        ngm:transparency ;
    vc:slug "accountability-ai-0068" ;
    vc:sourceDomain "ai-governance" ;
    vc:supports ngm:ai-regulation,
