        ngm:front-running,
        ngm:market-surveillance-authority,
        ngm:wash-trading ;
    vc:requires ngm:anti-money-laundering,
        ngm:order-book-transparency,
        ngm:price-discovery ;
    vc:slug "market-integrity" ;
    vc:sourceDomain "finance" ;
    vc:supports ngm:compliance-monitoring,
        ngm:investor-confidence,
        ngm:regulatory-compliance .

ngm:markov-decision-process a owl:Class ;
    rdfs:label "Markov Decision Process"@en ;
    rdfs:comment "A mathematical framework for modelling sequential decision-making where outcomes are partly random and partly under the control of a decision maker, comprising states, actions, transition probabilities, and a reward function, solved by computing a policy that maximises expected cumulative reward."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:state-space ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:reward-function ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:reward-function ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:value-function ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:markov-chain ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:action-space ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:probability-theory ],
        ngm:markov-chain ;
    vc:bridgesTo ngm:autonomous-agent,
        ngm:robotics-planning ;
    vc:contrastsWith ngm:multi-armed-bandit,
        ngm:partially-observable-markov-decision-process ;
    vc:enables ngm:dynamic-programming,
        ngm:optimal-control,
        ngm:policy-gradient-methods,
        ngm:reinforcement-learning ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:discount-factor,
        ngm:policy,
        ngm:reward-function,
        ngm:transition-probability-function,
