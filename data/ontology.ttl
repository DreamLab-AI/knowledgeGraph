            owl:someValuesFrom ngm:iso ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:manipulator ],
        ngm:technical-standard ;
    vc:bridgesTo ngm:artificial-intelligence,
        ngm:infrastructure,
        ngm:supply-chain ;
    vc:enables ngm:interoperability,
        ngm:regulatory-compliance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:iso-8373-robotics-vocabulary,
