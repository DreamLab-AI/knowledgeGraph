ngm:multimodal-ai-architecture-ai a owl:Class ;
    rdfs:label "Multimodal AI"@en ;
    rdfs:comment "Multimodal AI refers to machine learning systems that process and integrate information from multiple data modalities — including text, images, audio, and video — simultaneously to produce contextually richer outputs than single-modality systems. These architectures employ specialised neural network fusion techniques to replicate the human brain's capacity to synthesise diverse sensory inputs, enabling applications in healthcare diagnostics, human-computer interaction, and cross-modal content generation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:natural-language-processing ],
        [ a owl:Restriction ;
