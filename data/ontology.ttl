ngm:net-zero-target-setting a owl:Class ;
    rdfs:label "Net Zero Target Setting"@en ;
    rdfs:comment "Net zero target setting is the structured process by which an organisation or jurisdiction defines, scopes, and commits to balancing its greenhouse-gas emissions with removals by a stated date. It involves establishing a baseline, defining the emission scopes covered, setting interim milestones, and aligning the trajectory with a science-based decarbonisation pathway. Credible targets specify boundaries and the role of offsets to avoid greenwashing."@en ;
    rdfs:subClassOf ngm:sustainability ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:carbon-footprint-measurement,
        ngm:net-zero-targets ;
    vc:slug "net-zero-target-setting" ;
    vc:sourceDomain "governance" .

ngm:net-zero-transition a owl:Class ;
    rdfs:label "Net Zero Transition"@en ;
    rdfs:comment "The net zero transition is the structural shift of economies and financial portfolios toward balancing residual greenhouse-gas emissions with removals, in line with limiting global warming. It mobilises capital toward low-carbon technologies, retires or retrofits high-emitting assets, and aligns corporate strategy and disclosure with decarbonisation pathways. Transition finance provides the funding and instruments that allow hard-to-abate sectors to decarbonise credibly over time."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:sustainable-finance ],
        ngm:climate-finance ;
    vc:bridgesTo ngm:green-finance,
        ngm:impact-investing ;
    vc:dependsOn ngm:climate-finance,
        ngm:renewable-energy ;
    vc:enables ngm:decarbonisation,
        ngm:renewable-energy ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:climate-finance ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:climate-finance,
        ngm:esg,
        ngm:net-zero ;
    vc:requires ngm:sustainable-finance ;
    vc:slug "net-zero-transition" ;
    vc:sourceDomain "finance" ;
    vc:supports ngm:decarbonisation,
        ngm:sustainability ;
    vc:uses ngm:carbon-markets,
        ngm:sustainable-finance .

ngm:network-routing a skos:Concept ;
    rdfs:label "Network Routing"@en .

ngm:network-standards a owl:Class ;
    rdfs:label "Network Standards"@en ;
    rdfs:comment "Technical specifications and protocols developed by standards bodies like IEEE, IETF, ITU, and ISO that define how network devices communicate, ensuring interoperability, security, and performance across telecommunications and internet infrastructure."@en ;
