    vc:hasPart ngm:copyright,
        ngm:licensing,
        ngm:patent ;
    vc:isPartOf ngm:legal-framework ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:content-moderation,
        ngm:digital-rights,
        ngm:regulatory-compliance ;
    vc:requires ngm:digital-rights-management,
        ngm:legal-compliance ;
    vc:slug "intellectual-property-rights-framework" ;
    vc:sourceDomain "governance" ;
    vc:supports ngm:content-monetisation,
        ngm:digital-rights .

ngm:language-modeling a owl:Class ;
    rdfs:label "Language Modeling"@en ;
    rdfs:comment "Language Modeling is the fundamental NLP task of learning probability distributions over sequences of words or tokens to predict the likelihood of text sequences and generate plausible continuations. Language models underpin virtually all modern NLP applications through pre-training on massive text corpora, capturing syntactic structure, semantic relationships, and world knowledge that transfer to downstream tasks."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:transformer ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:deep-learning ],
