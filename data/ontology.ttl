            owl:someValuesFrom ngm:database-system ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:platform-middleware ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:authentication-system ],
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:enables ngm:application-development,
        ngm:asset-portability,
        ngm:cross-world-interoperability,
        ngm:user-identity-management ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:asset-service,
        ngm:identity-service,
        ngm:persistence-service,
        ngm:platform-middleware,
        ngm:world-state-service ;
    vc:isPartOf ngm:infrastructure-architecture ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:authentication-system,
        ngm:database-system,
        ngm:networking-layer ;
    vc:slug "platform-layer" ;
    vc:sourceDomain "spatial-computing" .

ngm:polycentric-governance a owl:Class ;
    rdfs:label "Polycentric Governance"@en ;
    rdfs:comment "Polycentric governance is a theory and practice of institutional arrangement in which authority over a shared domain is distributed across multiple overlapping, semi-autonomous decision-making centres rather than concentrated in a single hierarchy. Developed by Vincent and Elinor Ostrom through empirical study of common-pool resource management, the framework holds that complex social-ecological and sociotechnical systems benefit from diverse, redundant governance layers that can adapt, experiment, and mutually check one another. Each governance unit retains meaningful autonomy while engaging with others through negotiation, conflict-resolution mechanisms, and shared rules. Polycentric governance is increasingly applied to internet regulation, AI governance, and decentralised protocol design."@en ;
    rdfs:subClassOf ngm:governance ;
    vc:contrastsWith ngm:governance-architecture ;
    vc:enables ngm:dao-governance,
        ngm:participatory-policy-making ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:community-governance,
        ngm:decentralized-governance,
        ngm:democratic-governance ;
    vc:slug "polycentric-governance" ;
    vc:sourceDomain "governance" ;
    vc:supports ngm:ai-governance,
        ngm:data-governance .

ngm:portability a owl:Class ;
    rdfs:label "Portability"@en ;
    rdfs:comment "The capability for seamless migration of digital assets, identities, and experiences across heterogeneous virtual platforms through standardised formats (glTF, USD), metadata schemas, and blockchain bridges—enabling users to transfer avatars, digital goods, and social connections without vendor lock-in."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:asset-format-standards ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:interoperability ],
        ngm:sc-standards-and-interop ;
    skos:broader ngm:sc-standards-and-interop ;
    vc:enables ngm:avatar-portability,
        ngm:cross-platform-interoperability ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:requires ngm:asset-format-standards,
        ngm:interoperability ;
    vc:slug "portability" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:metaverse ;
    vc:uses ngm:blockchain,
        ngm:digital-identity .

ngm:portal-system a owl:Class ;
    rdfs:label "Portal System"@en ;
    rdfs:comment "A spatial computing mechanism that enables instantaneous traversal between distinct virtual locations, worlds, or platform environments, rendering a visual aperture through which users can see and enter the destination, thereby facilitating cross-world navigation and interoperability in metaverse platforms."@en ;
    rdfs:subClassOf ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:enables ngm:cross-platform-interoperability,
        ngm:virtual-world-traversal ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:metaverse-navigation-systems,
        ngm:virtual-environment ;
    vc:slug "portal-system" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:real-time-rendering,
        ngm:virtual-location .

ngm:postgre-sql a owl:Class ;
    rdfs:label "PostgreSQL"@en ;
    rdfs:comment "PostgreSQL is an open-source, ACID-compliant object-relational database management system (ORDBMS) that extends the SQL standard with features such as table inheritance, function overloading, and a rich type system including arrays, JSON, and user-defined types. It supports both relational and document storage paradigms, advanced indexing strategies including GIN, GiST, BRIN, and B-tree, and full-text search, making it a versatile choice for analytical and transactional workloads. Developed from the POSTGRES project at UC Berkeley (1986), it has been maintained as free software since 1996 and is widely regarded as the most standards-compliant open-source relational database."@en ;
    rdfs:subClassOf ngm:database-system ;
    vc:enables ngm:data-governance,
        ngm:machine-learning-infrastructure ;
