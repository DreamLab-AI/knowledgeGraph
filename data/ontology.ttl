        ngm:kubernetes,
        ngm:openapi,
        ngm:verifiable-credentials ;
    vc:uses ngm:controlled-vocabulary,
        ngm:regular-expression .

ngm:multi-party-computation a owl:Class ;
    rdfs:label "Multi-Party Computation"@en ;
    rdfs:comment "Multi-Party Computation (MPC) is a subfield of cryptography that enables a set of mutually distrusting parties to jointly compute a function over their private inputs without revealing those inputs to any other participant. Correctness is guaranteed even when a bounded subset of participants behave maliciously, making MPC a cornerstone of privacy-preserving collaborative computation. The technique generalises two-party secure computation to arbitrary numbers of participants using secret-sharing or garbled-circuit protocols."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:oblivious-transfer ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptographic-protocol ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:secret-sharing ],
        ngm:cryptography ;
    vc:bridgesTo ngm:decentralised-finance,
        ngm:digital-asset-custody,
        ngm:federated-learning ;
    vc:contrastsWith ngm:trusted-third-party ;
    vc:dependsOn ngm:computational-hardness-assumption ;
    vc:enables ngm:privacy-preserving-analytics,
        ngm:privacy-preserving-data-sharing,
        ngm:private-set-intersection,
        ngm:verifiable-computation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:differential-privacy,
        ngm:homomorphic-encryption,
        ngm:threshold-cryptography,
        ngm:trusted-execution-environment,
        ngm:zero-knowledge-proof ;
    vc:requires ngm:cryptographic-protocol,
        ngm:oblivious-transfer,
        ngm:secret-sharing ;
    vc:slug "multi-party-computation" ;
    vc:sourceDomain "security" ;
    vc:supports ngm:data-sovereignty,
        ngm:gdpr-compliance ;
    vc:uses ngm:arithmetic-circuit,
        ngm:garbled-circuits,
        ngm:public-key-cryptography .

ngm:planning a owl:Class ;
    rdfs:label "Planning"@en ;
    rdfs:comment "Planning is the cognitive and computational process of deliberating over a set of possible actions and selecting a sequence that transforms an initial state into a desired goal state, given a model of how actions change the world. In artificial intelligence, automated planning formalises this problem using state representations, action schemas with preconditions and effects, and search or optimisation algorithms to synthesise executable plans. Planning encompasses both classical deterministic formulations (e.g. STRIPS, PDDL) and richer variants that handle uncertainty, partial observability, continuous time, resources, and preferences. It underpins autonomous agents, robotics, supply-chain management, and any system that must reason prospectively about future action consequences."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:hierarchical-task-network ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:state-space-representation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:search-algorithm ],
        ngm:automated-planning ;
    vc:bridgesTo ngm:multi-agent-system,
        ngm:supply-chain-management ;
    vc:contrastsWith ngm:reactive-control,
        ngm:reinforcement-learning ;
    vc:dependsOn ngm:knowledge-representation,
        ngm:reasoning ;
    vc:enables ngm:autonomous-agent,
        ngm:decision-making,
        ngm:motion-planning ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:hierarchical-task-network ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:optimisation,
        ngm:planning-and-scheduling,
        ngm:temporal-reasoning ;
    vc:requires ngm:search-algorithm,
        ngm:state-space-representation ;
    vc:slug "planning" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:constraint-satisfaction,
        ngm:heuristic-function,
        ngm:markov-decision-process .

