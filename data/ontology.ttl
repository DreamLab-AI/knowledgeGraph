ngm:smart-contracts a owl:Class ;
    rdfs:label "Smart Contracts"@en ;
    rdfs:comment "Self-executing programs stored on a blockchain that automatically enforce and execute the terms of an agreement when predetermined conditions are met, eliminating the need for intermediaries and enabling trustless, transparent, and immutable transaction automation."@en ;
