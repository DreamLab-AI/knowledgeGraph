ngm:relational-database a owl:Class ;
    rdfs:comment "A relational database organises data into tables of rows and columns, where relationships between tables are expressed through shared key values rather than physical pointers, following the relational model. Data is queried and manipulated declaratively, conventionally through SQL, and integrity is enforced via constraints, keys and typed schemas. Relational systems typically provide ACID transactions, making them the default choice for consistent, structured operational data."@en ;
    rdfs:label "Relational Database"@en ;
    rdfs:subClassOf ngm:database-management-system ;
