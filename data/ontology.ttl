    vc:slug "character-model" ;
    vc:sourceDomain "spatial-computing" .

ngm:circulating-supply a owl:Class ;
    rdfs:label "Circulating Supply"@en ;
    rdfs:comment "Circulating Supply is the quantity of a blockchain token that is publicly available and actively tradeable in the market at a given point in time—excluding tokens locked in smart contracts, held in treasury reserves, vested to team members, or burned. It serves as the operative supply figure for computing market capitalisation and price-to-earnings metrics, and changes continuously as new tokens are emitted via block rewards and locked tokens are released according to vesting schedules."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:blockchain-protocol ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:emission-schedule ],
        ngm:bc-defi-and-economics,
        ngm:blockchain-entity,
        ngm:economic-mechanism ;
    skos:broader ngm:bc-defi-and-economics ;
    vc:contrastsWith ngm:deflationary-token,
        ngm:inflationary-token ;
    vc:enables ngm:blockchain-economics,
        ngm:burning-mechanism ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:fixed-supply-token,
        ngm:halving,
        ngm:market-capitalization,
        ngm:token-economics,
        ngm:tokenomics,
        ngm:total-supply ;
    vc:requires ngm:blockchain-protocol,
        ngm:emission-schedule ;
    vc:slug "circulating-supply" ;
    vc:sourceDomain "blockchain" .

ngm:classification a owl:Class ;
    rdfs:label "Classification"@en ;
    rdfs:comment "Classification is a supervised machine learning task in which a model learns a mapping from input features to a discrete set of predefined category labels, using labelled training examples to optimise decision boundaries. At inference time the model assigns each unseen input to one or more categories by applying a learned discriminant function or probabilistic scoring rule. The task encompasses binary, multi-class, and multi-label variants, and underpins applications ranging from image recognition and natural language understanding to medical diagnosis and fraud detection. Performance is evaluated with metrics such as accuracy, precision, recall, F1-score, and the area under the receiver-operating-characteristic curve, selected according to class imbalance and the relative cost of false positives versus false negatives."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:feature-engineering ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:supervised-learning ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:loss-function ],
        ngm:supervised-learning ;
    vc:bridgesTo ngm:knowledge-graph,
        ngm:robotic-perception ;
    vc:contrastsWith ngm:anomaly-detection,
        ngm:clustering,
        ngm:regression ;
    vc:dependsOn ngm:cross-validation,
        ngm:hyperparameter-tuning,
        ngm:training-data ;
    vc:enables ngm:image-recognition,
        ngm:medical-diagnosis,
        ngm:object-detection,
        ngm:sentiment-analysis,
        ngm:spam-filtering ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:probabilistic-inference,
        ngm:statistical-learning-theory,
        ngm:transfer-learning ;
    vc:requires ngm:feature-engineering,
        ngm:labelled-dataset,
        ngm:loss-function,
        ngm:supervised-learning ;
    vc:slug "classification" ;
    vc:sourceDomain "machine-learning" ;
    vc:uses ngm:decision-tree,
        ngm:logistic-regression,
        ngm:naive-bayes,
        ngm:neural-network,
        ngm:random-forest,
        ngm:support-vector-machine .

ngm:congestion-control a owl:Class ;
    rdfs:label "Congestion Control"@en ;
    rdfs:comment "Congestion Control is the set of mechanisms and algorithms that regulate the rate of data transmission across a network to prevent any sender, link, or node from being overwhelmed by more traffic than it can handle, thereby maintaining overall network stability and fairness. Operating primarily at the transport layer, congestion control algorithms infer network capacity from signals such as packet loss, explicit congestion notification, and round-trip time variations, adjusting sender rates accordingly. Classical implementations include TCP Tahoe, Reno, CUBIC, and BBR; modern variants extend to QUIC, WebRTC, and multipath scenarios where joint path management adds additional complexity."@en ;
    rdfs:subClassOf ngm:network-protocol ;
    vc:bridgesTo ngm:content-delivery-network,
        ngm:reinforcement-learning ;
    vc:contrastsWith ngm:flow-control,
        ngm:traffic-shaping ;
    vc:dependsOn ngm:internet-protocol,
        ngm:transport-layer ;
    vc:enables ngm:latency-management-protocol,
        ngm:network-fairness,
        ngm:peer-to-peer-network ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:active-queue-management,
        ngm:congestion-avoidance,
        ngm:slow-start ;
    vc:implements ngm:bbr-algorithm,
        ngm:quic-transport,
        ngm:tcp-cubic ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:bandwidth-adaptation,
        ngm:network-latency,
        ngm:quality-of-service ;
    vc:requires ngm:packet-loss-detection,
        ngm:round-trip-time-measurement ;
    vc:slug "congestion-control" ;
    vc:sourceDomain "infrastructure" ;
    vc:standardizedBy ngm:ietf ;
    vc:supports ngm:distributed-computing,
        ngm:networking-infrastructure,
        ngm:real-time-communication ;
    vc:uses ngm:explicit-congestion-notification,
        ngm:sliding-window-protocol .

