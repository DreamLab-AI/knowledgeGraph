        ngm:real-time-inference,
        ngm:sensor-fusion ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:autonomous-mobile-robots,
        ngm:edge-computing,
        ngm:embedded-systems,
        ngm:gpu-computing ;
    vc:requires ngm:operating-system ;
    vc:slug "nvidia-jetson" ;
    vc:sourceDomain "robotics" ;
    vc:supports ngm:deep-learning,
        ngm:edge-computing-node,
        ngm:inference-hardware,
        ngm:ros ;
    vc:uses ngm:cuda,
        ngm:gpu-compute,
        ngm:tensor-rt .

ngm:nvidia-corporation-omniverse-platform a owl:Class ;
    rdfs:label "NVIDIA Omniverse Platform"@en ;
    rdfs:comment "NVIDIA Omniverse Platform is a real-time 3D simulation, rendering, and collaborative development platform built by NVIDIA on the OpenUSD (Universal Scene Description) open standard, designed to enable physically accurate digital twins, multi-user design workflows, and large-scale synthetic data generation for AI and robotics training. It provides a unified GPU-accelerated compute and rendering fabric — comprising the Nucleus collaboration server, the Kit application framework, and Connector plugins — that allows multiple applications and users to simultaneously edit shared 3D scenes with physically based rendering, ray tracing, and physics simulation. Omniverse bridges creative content-creation pipelines, industrial engineering workflows, and AI training infrastructure, with deployments spanning automotive design, factory digital twins, autonomous vehicle simulation, and robot learning environments."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gpu ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:omniverse ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:nvidia-corporation-isaac-sim ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:universal-scene-description ],
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:bridgesTo ngm:reinforcement-learning,
        ngm:sim-to-real-transfer ;
    vc:contrastsWith ngm:unity,
        ngm:unreal-engine ;
    vc:enables ngm:collaborative-systems-modality-design,
        ngm:digital-twin,
        ngm:embodied-ai-simulation,
        ngm:photorealistic-rendering,
        ngm:robot-learning,
        ngm:synthetic-data-generation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:nvidia-corporation-isaac-sim,
        ngm:omniverse ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:collaboration-platform,
        ngm:real-time-rendering ;
    vc:requires ngm:gpu,
        ngm:universal-scene-description ;
    vc:slug "nvidia-omniverse-platform" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:autonomous-vehicle-simulation,
        ngm:digital-twin ;
    vc:uses ngm:gpu-computing,
        ngm:material-x,
