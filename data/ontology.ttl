        ngm:decentralised-finance,
        ngm:spatial-computing ;
    vc:contrastsWith ngm:just-in-time-manufacturing,
        ngm:value-chain-management ;
    vc:enables ngm:provenance-tracking,
        ngm:sustainability-reporting,
        ngm:trade-finance ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:demand-forecasting,
        ngm:inventory-management,
        ngm:logistics-optimization,
        ngm:procurement,
        ngm:supplier-relationship-management ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:circular-economy,
        ngm:resilience-engineering,
        ngm:trade-compliance ;
    vc:requires ngm:data-integration,
