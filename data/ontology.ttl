ngm:tool-use a owl:Class ;
    rdfs:label "Tool Use"@en ;
    rdfs:comment "Tool Use is the capability of large language models and AI agent systems to invoke external functions, APIs, databases, or services at inference time, extending the model's effective knowledge and action repertoire beyond pure text generation. The model receives a structured description of available tools — a tool schema encoding names, descriptions, and JSON Schema parameter specifications — reasons about which tool to call and with what arguments, executes that call via a surrounding orchestration layer, and incorporates the returned observation into its subsequent reasoning. This capability is foundational to agentic AI systems that must take real-world actions such as code execution, web search, database queries, file manipulation, or actuator control, bridging the boundary between language generation and executable computation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:function-calling ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:orchestration-layer ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:tool-schema ],
        ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:bridgesTo ngm:api-gateway,
        ngm:robotic-process-automation ;
    vc:contrastsWith ngm:fine-tuning,
        ngm:retrieval-augmented-generation ;
    vc:dependsOn ngm:inference-time-computation,
        ngm:prompt-engineering ;
    vc:enables ngm:agentic-ai,
        ngm:autonomous-agent,
        ngm:code-execution,
