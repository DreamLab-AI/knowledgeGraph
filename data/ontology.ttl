# Virtual Replica
spatial-computing:VirtualReplica rdf:type owl:Class ;
    rdfs:subClassOf spatial-computing:DigitalModel ;
    rdfs:label "Virtual Replica"@en ;
    rdfs:comment "A digital representation of a physical object, system, or environment created through 3D modeling, photogrammetry, or scanning technologies, serving as a static or dynamic copy for visualization, simulation, analysis, and testing purposes without the real-time data connectivity that characterizes digital twins."@en ;
    skos:prefLabel "Virtual Replica"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:spatial-computing:virtual-replica" ;
    owl:sameAs <urn:visionclaw:concept:spatial-computing:virtual-replica> ;
