    vc:slug "rb-0087-safety-standard" ;
    vc:sourceDomain "robotics" ;
    vc:supports ngm:functional-safety ;
    vc:supports ngm:robot-safety .
ngm:rb-0088-iso-13482-compliance a owl:Class ;
    rdfs:comment "ISO 13482 compliance refers to conformance with ISO 13482:2014, the international safety standard for personal care robots that interact with humans in non-industrial settings. Achieving compliance requires demonstrating that hazards have been identified, risks reduced to acceptable levels via protective measures, and that the robot meets defined performance and safety integrity criteria throughout its operational life."@en ;
    rdfs:label "rb 0088 iso 13482 compliance"@en ;
    rdfs:subClassOf ngm:functional-safety ;
    rdfs:subClassOf ngm:robo-safety-and-standards ;
    rdfs:subClassOf _:r22975 ;
    rdfs:subClassOf _:r22976 ;
    skos:broader ngm:robo-safety-and-standards ;
    vc:contrastsWith ngm:iso-10218 ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:rb-0087-safety-standard ;
    vc:relatedTo ngm:rb-0091-safety-rated-monitored-stop ;
    vc:relatedTo ngm:rb-0096-safeguarding ;
    vc:relatedTo ngm:service-robot ;
