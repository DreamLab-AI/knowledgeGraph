ngm:operations-research a owl:Class ;
    rdfs:label "Operations Research"@en ;
    rdfs:comment "Operations research (OR) is an analytical discipline that applies advanced mathematical and computational methods — including linear programming, integer optimisation, stochastic modelling, and simulation — to support decision-making in complex systems. It originated during World War II to optimise military logistics and has since expanded to industrial, financial, and humanitarian domains. OR provides rigorous frameworks for formulating trade-off problems as constrained optimisation models, then solving them to global or near-global optimality using exact solvers or heuristic methods. Modern OR integrates machine learning for parameter estimation and reinforcement learning for sequential decision problems."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:linear-programming ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:game-theory ],
        ngm:optimisation ;
    vc:bridgesTo ngm:artificial-intelligence,
        ngm:machine-learning,
        ngm:supply-chain ;
    vc:contrastsWith ngm:heuristic-methods ;
    vc:enables ngm:fleet-management,
        ngm:logistics-optimization,
        ngm:planning-and-scheduling,
        ngm:resource-allocation,
        ngm:supply-chain-management ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:game-theory,
        ngm:linear-programming,
        ngm:queuing-theory ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:decision-support,
        ngm:decision-theory,
        ngm:reinforcement-learning,
        ngm:simulation,
        ngm:systems-engineering ;
    vc:requires ngm:data,
        ngm:mathematical-modelling ;
    vc:slug "operations-research" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:constraint-solver,
        ngm:heuristic-methods,
        ngm:integer-programming,
        ngm:monte-carlo-methods,
        ngm:optimization-algorithm,
        ngm:stochastic-modelling .

ngm:payment-network a owl:Class ;
    rdfs:label "Payment Network"@en ;
    rdfs:comment "A payment network is an infrastructure system of interconnected nodes, protocols, messaging standards, and settlement mechanisms that enables the authenticated transfer of value between participants — individuals, merchants, financial institutions, or autonomous software agents — with guarantees on finality, atomicity, and fraud prevention. Payment networks operate at multiple layers: a messaging layer (e.g. SWIFT MT/MX, ISO 20022) carries authenticated payment instructions; a clearing layer nets obligations across participants; and a settlement layer achieves irrevocable finality through central bank reserves or distributed ledger consensus. The architecture spans traditional four-party card networks (Visa, Mastercard), interbank clearing systems (SWIFT, ACH, SEPA, Fedwire), cryptographic peer-to-peer blockchain networks, and second-layer off-chain channel networks such as the Lightning Network, collectively underpinning commerce, financial inclusion, and machine-to-machine value exchange."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:state-channel ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:network-protocol ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:settlement-layer ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:digital-identity ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:payment-system ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:clearing-house ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:trust-model ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:payment-gateway ],
        ngm:financial-infrastructure ;
    vc:bridgesTo ngm:agentic-ai,
        ngm:internet-of-things ;
    vc:contrastsWith ngm:barter-system,
        ngm:central-bank-digital-currency ;
    vc:dependsOn ngm:internet-infrastructure,
        ngm:public-key-infrastructure ;
    vc:enables ngm:cross-border-payments,
        ngm:machine-to-machine-payments,
        ngm:micropayments,
        ngm:programmable-money,
        ngm:real-time-payments ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:clearing-house,
        ngm:payment-gateway,
        ngm:payment-system,
        ngm:settlement-layer,
        ngm:state-channel ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:decentralised-finance,
        ngm:layer-2-scaling,
        ngm:lightning-network,
        ngm:stablecoin ;
