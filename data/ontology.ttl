# Open-Loop Control
robotics:OpenLoopControl rdf:type owl:Class ;
    rdfs:subClassOf robotics:ControlSystem ;
    rdfs:label "Open-Loop Control"@en ;
    rdfs:comment "A control system where the control action is independent of the output. The system executes pre-programmed commands without feedback from sensors to verify if the desired state was achieved."@en ;
    skos:prefLabel "Open-Loop Control"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:robotics:open-loop-control" ;
    owl:sameAs <urn:visionclaw:concept:robotics:open-loop-control> ;
    vcw:contentHash "sha256-12-fd22b53e637f" ;
    vcw:qualityScore "0.5"^^xsd:decimal ;
