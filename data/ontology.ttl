vf:cortex-agent a owl:Class ;
    rdfs:label "Cortex Agent"@en ;
    rdfs:comment "Cortex Agent is a class of enterprise agentic AI system that orchestrates multi-step reasoning and action across both structured and unstructured data sources within a governed cloud data platform, with Snowflake Cortex Agents (General Availability November 4, 2025) as the dominant production instantiation — a framework that receives natural-language user queries, plans multi-step execution strategies using a frontier LLM orchestrator, invokes a registered toolkit (Cortex Analyst translating NL to SQL for structured warehoused data via YAML semantic models or native Semantic Views with full RBAC; Cortex Search executing hybrid BM25-plus-vector retrieval over unstructured document collections managed within Snowflake; custom stored procedures and user-defined functions for domain computation; and Brave-API web search for real-time external information), executes a four-stage cognitive cycle of planning, tool use, reflection, and monitoring, and synthesises grounded natural-language responses with optional data citations — all without data leaving the Snowflake account perimeter, ensuring governance and data sovereignty across financial services, healthcare, life sciences, retail, an"@en ;
    rdfs:subClassOf vf:agent-frameworks,
        vf:agentic-internet,
        vf:agents,
        vf:cognitive-ai,
        vf:foundation-models ;
    vc:authorityScore "0.87"^^xsd:float ;
    vc:enables vf:call-centres,
        vf:chatbots,
        vf:cli-multi-agent-systems,
        vf:computer-use-and-browser-agents,
        vf:gpts-and-custom-assistants ;
    vc:hasPart vf:context-engineering,
        vf:evaluation-benchmarks-and-leaderboards,
        vf:feedback-loop,
        vf:function-calling,
        vf:graph-database ;
    vc:implements <urn:visionflow:linked:retrieval-augmented-generation>,
        vf:attention,
        vf:context-engineering,
        vf:feedback-loop,
        vf:function-calling ;
    vc:maturity "production-ready" ;
    vc:qualityScore "0.52"^^xsd:float ;
    vc:requires vf:api-gateway,
        vf:data-layer,
        vf:distributed-computing,
        vf:fault-tolerance,
        vf:foundation-models ;
