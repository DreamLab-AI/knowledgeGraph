ngm:flash-attention a owl:Class ;
    rdfs:label "Flash Attention"@en ;
    rdfs:comment "Flash Attention is an IO-aware, exact attention algorithm that exploits the GPU memory hierarchy by tiling query, key, and value matrices to keep intermediate activations in fast on-chip SRAM rather than the much slower high-bandwidth DRAM (HBM), thereby eliminating the O(N²) memory materialisation of standard scaled dot-product attention. By applying an online softmax recomputation strategy, it achieves bitwise-identical output to vanilla attention while reducing HBM reads and writes proportionally to the SRAM tile size. Originally introduced by Dao et al. in 2022, it has been extended through FlashAttention-2 (improved thread-block partitioning) and FlashAttention-3 (Hopper-native asynchrony and FP8 support), and is now embedded in PyTorch, JAX, vLLM, and virtually every frontier model training pipeline."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cuda ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gpu-compute ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:transformer-architecture ],
        ngm:attention-mechanism ;
    vc:bridgesTo ngm:hardware-accelerator-design ;
    vc:contrastsWith ngm:gradient-checkpointing,
        ngm:linear-attention,
        ngm:sparse-attention ;
    vc:dependsOn ngm:high-bandwidth-memory,
        ngm:model-training ;
    vc:enables ngm:inference,
        ngm:large-language-models,
        ngm:long-context-modelling,
        ngm:multi-head-attention ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:online-softmax,
        ngm:scaled-dot-product-attention ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:memory-bandwidth-optimisation,
        ngm:paged-attention,
        ngm:rotary-position-embedding,
        ngm:tensor-parallelism ;
    vc:requires ngm:cuda,
        ngm:gpu-compute,
        ngm:transformer-architecture ;
    vc:slug "flash-attention" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:continuous-batching,
        ngm:kv-cache,
        ngm:speculative-decoding ;
    vc:uses ngm:kernel-fusion,
        ngm:mixed-precision-training,
        ngm:sram,
        ngm:tiling .

ngm:floating-point-arithmetic a owl:Class ;
    rdfs:label "Floating-Point Arithmetic"@en ;
    rdfs:comment "Floating-point arithmetic is a method of representing and computing with real numbers on digital hardware using a sign, a fixed-precision significand, and an exponent, most commonly standardised by IEEE 754. It trades exactness for a wide dynamic range, so operations introduce rounding error, and properties such as associativity no longer hold exactly. Understanding its precision limits, rounding modes, and special values is essential for numerically reliable simulation, graphics, and machine learning."@en ;
    rdfs:subClassOf ngm:computing-infrastructure ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:collision-detection,
        ngm:model-optimisation-and-performance ;
    vc:slug "floating-point-arithmetic" ;
    vc:sourceDomain "infrastructure" .

ngm:food-safety a owl:Class ;
    rdfs:label "Food Safety"@en ;
    rdfs:comment "Food Safety is the discipline concerned with preventing foodborne illness and injury through systematic controls applied across the entire food production and distribution chain, from farm to consumer. It encompasses hazard analysis, regulatory compliance, traceability, temperature monitoring, and the technical and institutional practices that ensure food products are safe for consumption."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:blockchain-provenance ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:rfid ],
        ngm:compliance ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.85"^^xsd:float ;
    vc:relatedTo ngm:compliance-monitoring,
        ngm:food-safety-blockchain ;
    vc:requires ngm:blockchain-provenance,
        ngm:rfid ;
    vc:slug "food-safety" ;
    vc:sourceDomain "governance" .

ngm:force-feedback a owl:Class ;
    rdfs:label "Force Feedback"@en ;
    rdfs:comment "Force feedback is a class of haptic technology that renders mechanical forces — including resistance, weight, texture, and impact — directly to a user's body through a controlled actuator system, enabling the sense of touch and proprioception to convey information about virtual or remote physical environments. Distinguished from simpler vibrotactile feedback by its ability to generate directional, grounded forces (requiring a mechanical linkage to the user), force feedback systems are used in surgical simulators, teleoperation of remote robots, vehicle simulation, and advanced XR interfaces. The fidelity of the rendered force field is constrained by the bandwidth, peak force, backdrivability, and transparency of the underlying actuator mechanism."@en ;
    rdfs:subClassOf ngm:haptics ;
    vc:enables ngm:haptic-feedback-telepresence,
        ngm:physics-simulation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:haptic-feedback,
        ngm:haptic-feedback-system,
        ngm:tactile-sensing ;
    vc:slug "force-feedback" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:actuator,
        ngm:motion-control,
        ngm:series-elastic-actuator .

