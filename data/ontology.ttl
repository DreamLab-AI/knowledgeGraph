ngm:responsible-scaling-policy a owl:Class ;
    rdfs:label "Responsible Scaling Policy"@en ;
    rdfs:comment "A Responsible Scaling Policy (RSP) is a voluntary self-regulatory commitment by a frontier AI developer that ties further capability scaling and deployment to measurable safety milestones. It specifies: the capability evaluation thresholds (often called AI Safety Levels) at which enhanced assessments must be completed before training or deploying a more capable model; the specific risk domains—particularly uplift to chemical, biological, radiological, nuclear, and cyberweapon development—that would trigger deployment restrictions or halts; and the technical and organisational safeguards required at each level. RSPs translate aspirational safety intentions into concrete, time-bound, falsifiable commitments, creating accountability mechanisms that operate ahead of formal government regulation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:red-teaming ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:third-party-verification ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:risk-assessment ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:capability-evaluation ],
        ngm:ai-governance-framework ;
    vc:bridgesTo ngm:biosecurity ;
    vc:contrastsWith ngm:ai-regulation,
        ngm:compute-governance ;
    vc:dependsOn ngm:frontier-models,
        ngm:interpretability ;
    vc:enables ngm:ai-safety ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:implements ngm:ai-governance-and-ethics,
        ngm:precautionary-principle ;
    vc:qualityScore "0.73"^^xsd:float ;
    vc:relatedTo ngm:ai-model-card,
        ngm:ai-safety-institute,
        ngm:frontier-model-forum ;
    vc:requires ngm:capability-evaluation,
        ngm:red-teaming,
        ngm:risk-assessment,
        ngm:third-party-verification ;
    vc:slug "responsible-scaling-policy" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:ai-alignment,
        ngm:ai-regulation .

ngm:risk-assessment-methodology a owl:Class ;
    rdfs:label "Risk Assessment Methodology"@en ;
    rdfs:comment "A Risk Assessment Methodology is a structured, repeatable set of procedures for identifying, analysing, and evaluating potential hazards or threats to an organisation's objectives, assets, or stakeholders, producing a prioritised risk register that informs mitigation decisions. Methodologies range from qualitative (likelihood-impact matrices) to quantitative (Monte Carlo simulation, fault tree analysis) approaches, and are codified in standards such as ISO 31000, NIST SP 800-30, and FAIR for cybersecurity contexts."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:threat-modelling ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:risk-register ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:stakeholder-analysis ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:risk-analysis ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:risk-treatment ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:risk-assessment-matrix ],
        ngm:risk-assessment ;
    vc:bridgesTo ngm:ai-risk-management,
        ngm:cybersecurity-risk-assessment,
        ngm:supply-chain-risk-management ;
    vc:enables ngm:enterprise-risk-management,
        ngm:risk-assessment-engine ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:risk-analysis,
        ngm:risk-evaluation,
        ngm:risk-identification,
        ngm:risk-register,
        ngm:risk-treatment ;
    vc:implements ngm:iso-31000-risk-management,
        ngm:nist-cybersecurity-framework ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:failure-mode-effects-analysis,
        ngm:fault-tree-analysis,
        ngm:monte-carlo-simulation,
        ngm:probabilistic-risk-assessment,
        ngm:red-teaming ;
    vc:requires ngm:risk-assessment-matrix,
        ngm:stakeholder-analysis,
        ngm:threat-modelling ;
    vc:slug "risk-assessment-methodology" ;
    vc:sourceDomain "governance" ;
    vc:standardizedBy ngm:iso-31000-risk-management,
        ngm:nist-sp-800-30 .

ngm:risk-based-approach a owl:Class ;
    rdfs:label "Risk-Based Approach"@en ;
    rdfs:comment "A risk-based approach is a regulatory and compliance methodology that allocates scrutiny and controls in proportion to assessed risk, rather than applying uniform requirements to all cases. In anti-money-laundering and cross-border compliance it directs enhanced due diligence at higher-risk customers and transactions while streamlining low-risk ones. It improves effectiveness and efficiency by focusing limited resources where harm is most likely."@en ;
    rdfs:subClassOf ngm:regulatory-compliance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:aml-kyc-compliance,
        ngm:cross-border-compliance ;
    vc:slug "risk-based-approach" ;
    vc:sourceDomain "governance" .

ngm:risk-management-framework a owl:Class ;
    rdfs:label "Risk Management Framework"@en ;
    rdfs:comment "A Risk Management Framework is a structured methodology for identifying, assessing, treating, and monitoring risks to an organisation's objectives, assets, or systems. It provides a repeatable process and governance structure that links risk appetite, control selection, and assurance activities into a coherent programme aligned with recognised standards such as ISO 31000, NIST RMF, or the NIST AI RMF."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:risk-register ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:risk-assessment ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:risk-mitigation ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:continuous-monitoring ],
        ngm:risk-management ;
    vc:bridgesTo ngm:ai-governance,
        ngm:supply-chain-risk-management ;
    vc:enables ngm:audit,
        ngm:compliance ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:continuous-monitoring,
        ngm:risk-register ;
    vc:implements ngm:iso-31000,
        ngm:nist-ai-rmf,
        ngm:nist-cybersecurity-framework ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:business-continuity-planning,
        ngm:information-security-management-system ;
    vc:requires ngm:risk-assessment,
        ngm:risk-identification,
        ngm:risk-mitigation ;
    vc:slug "risk-management-framework" ;
    vc:sourceDomain "governance" ;
    vc:supports ngm:governance-framework,
        ngm:organisational-resilience ;
    vc:uses ngm:grc-platform,
        ngm:nist,
        ngm:security-framework,
        ngm:threat-modelling .

ngm:robotic-arm a owl:Class ;
    rdfs:label "Robotic Arm"@en ;
    rdfs:comment "A robotic arm is a programmable mechanical manipulator, typically composed of rigid links connected by actuated joints, that positions and orients an end-effector within a workspace. Its degrees of freedom allow it to reach and manipulate objects under the control of motion-planning and kinematics algorithms. Robotic arms range from industrial units performing repetitive high-precision tasks to collaborative arms designed to work safely alongside people. They are a foundational platform across manufacturing, surgery, logistics and research."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:actuator ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:servo-motor ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:end-effector ],
        ngm:manipulator ;
    vc:dependsOn ngm:control-system,
        ngm:motion-planning ;
    vc:enables ngm:grasping,
        ngm:pick-and-place ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:actuator,
        ngm:end-effector,
        ngm:servo-motor ;
    vc:isPartOf ngm:industrial-robot ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:collaborative-robot,
        ngm:robotics ;
    vc:requires ngm:degrees-of-freedom ;
    vc:slug "robotic-arm" ;
    vc:sourceDomain "robotics" ;
    vc:supports ngm:manufacturing-automation ;
    vc:uses ngm:forward-kinematics,
        ngm:inverse-kinematics .

ngm:ros a owl:Class ;
    rdfs:label "ROS"@en ;
    rdfs:comment "ROS (Robot Operating System) is an open-source middleware framework providing publish-subscribe communication, build tooling and reusable libraries for constructing robot software from distributed, composable components."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:middleware ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:operating-system ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:dds-middleware ],
        ngm:robot-operating-system ;
    vc:bridgesTo ngm:artificial-intelligence,
        ngm:edge-computing ;
    vc:dependsOn ngm:inter-process-communication,
