    vc:slug "transaction-fee" ;
    vc:sourceDomain "blockchain" .

ngm:voting-mechanism a owl:Class ;
    rdfs:label "Voting Mechanism"@en ;
    rdfs:comment "A voting mechanism is a formalised procedure by which participants in a collective system — such as token holders in a decentralised protocol, members of a cooperative, or delegates in a representative body — express preferences or binding decisions on resource allocation, parameter changes, protocol upgrades, or dispute resolution. The design of a voting mechanism encodes trade-offs between participation breadth, sybil resistance, plutocracy risk, voter apathy, and decisional legitimacy; canonical variants include token-weighted voting, quadratic voting, conviction voting, ranked-choice voting, and delegated liquid democracy. The chosen mechanism directly shapes the security, fairness, and perceived legitimacy of governance outcomes in both on-chain and off-chain contexts."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:governance-token ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:quorum ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:liquid-democracy ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:on-chain-voting ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:conviction-voting ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:sybil-resistance ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:token-weighted-voting ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:snapshot-off-chain-voting ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:quadratic-voting ],
        ngm:bc-governance-and-regulation ;
    skos:broader ngm:bc-governance-and-regulation ;
    vc:bridgesTo ngm:collective-intelligence,
        ngm:multi-agent-systems ;
    vc:contrastsWith ngm:delegated-proof-of-stake,
        ngm:governance,
        ngm:proof-of-work ;
    vc:enables ngm:dao-governance,
        ngm:decentralised-decision-making,
        ngm:on-chain-governance,
        ngm:protocol-upgrades ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:conviction-voting,
        ngm:liquid-democracy,
        ngm:on-chain-voting,
        ngm:quadratic-voting,
        ngm:snapshot-off-chain-voting,
        ngm:token-weighted-voting ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:game-theory,
        ngm:governance-attack,
        ngm:mechanism-design,
        ngm:social-choice-theory,
        ngm:treasury-management ;
    vc:requires ngm:governance-token,
        ngm:quorum,
        ngm:sybil-resistance ;
    vc:slug "voting-mechanism" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:multisig,
        ngm:smart-contract,
        ngm:snapshot-voting,
        ngm:timelock .

ngm:web3 a owl:Class ;
    rdfs:label "Web3"@en ;
    rdfs:comment "Web3 is a blockchain-anchored paradigm for the decentralised web, first coined by ereum co-founder Gavin Wood in his April 2014 essay \"DApps: What Web 3.0 Looks Like\", that reconceives the internet as a zero-trust interaction system eliminating the need to trust any individual institution or plat..."@en ;
