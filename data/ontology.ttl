ngm:attention a owl:Class ;
    rdfs:label "Attention"@en ;
    rdfs:comment "Attention is a differentiable content-based addressing mechanism for neural networks that computes a weighted combination of value vectors according to learned compatibility scores between a query vector and a set of key vectors, formalised in its most influential form as Scaled Dot-Product Atten..."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:queries ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gpu-compute ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:value ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:embedding ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:positional-encoding ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:differentiable-architecture ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:backpropagation ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:attention-head ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:attention-weight ],
        ngm:ai-model-architecture,
        ngm:neural-network ;
    skos:broader ngm:ai-model-architecture ;
    vc:enables ngm:cross-modal-conditioning,
        ngm:in-context-learning,
        ngm:large-language-models,
        ngm:long-context-window,
        ngm:neural-machine-translation,
        ngm:transformer,
        ngm:vision-transformer ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:attention-head,
        ngm:attention-score,
        ngm:attention-weight,
        ngm:key,
        ngm:positional-encoding,
        ngm:queries,
