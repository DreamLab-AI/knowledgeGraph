ngm:servo-valve a owl:Class ;
    rdfs:label "Servo Valve"@en ;
    rdfs:comment "A servo valve is an electrohydraulic device that proportionally controls the flow and pressure of hydraulic fluid in response to a low-power electrical command, typically via a torque-motor-driven pilot stage. It provides high-bandwidth, closed-loop modulation of hydraulic actuators, delivering large forces with precise position control. It is a key element of high-power robotic and aerospace actuation systems."@en ;
    rdfs:subClassOf ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:hydraulic-actuator,
        ngm:proportional-valve ;
    vc:slug "servo-valve" ;
    vc:sourceDomain "robotics" .

ngm:session-initiation-protocol a skos:Concept ;
