        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:expert-parallelism ],
        ngm:ai-model-architecture ;
    skos:broader ngm:ai-model-architecture ;
    vc:bridgesTo ngm:distributed-systems ;
    vc:contrastsWith ngm:deep-learning ;
    vc:dependsOn ngm:distributed-training,
        ngm:neural-network ;
    vc:enables ngm:large-language-models,
