ngm:decentralized-identity a owl:Class ;
    rdfs:label "Decentralized Identity"@en ;
    rdfs:comment "Decentralized Identity is an approach to digital identity management in which individuals, organisations, and devices hold cryptographic control over their own identifiers and credentials without dependence on any centralised identity provider. Built upon the W3C Decentralized Identifiers (DID) v1.0 Recommendation and the W3C Verifiable Credentials Data Model, it establishes a tripartite trust triangle of issuers, holders, and verifiers where credential authenticity is established through public-key cryptography anchored to a verifiable data registry — such as a distributed ledger or DNS — rather than through a privileged intermediary. This architecture realises self-sovereign identity principles: the subject generates and controls their key material, selectively discloses attributes using mechanisms such as BBS+ signatures or SD-JWT, and satisfies verifiers without exposing credentials to central surveillance or requiring real-time queries to the issuer."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptographic-signature ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:verifiable-data-registry ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:did-document ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:digital-identity-wallet ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:didcomm ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:credential-verification ],
        ngm:digital-identity ;
    vc:bridgesTo ngm:iot-device-authentication,
        ngm:smart-contract,
        ngm:web3 ;
    vc:contrastsWith ngm:centralised-identity-provider,
        ngm:federated-identity,
        ngm:oauth ;
    vc:enables ngm:cross-border-authentication,
        ngm:privacy-by-design,
        ngm:selective-disclosure,
        ngm:self-sovereign-identity ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:credential-verification,
        ngm:did-document,
        ngm:didcomm,
        ngm:digital-identity-wallet,
        ngm:verifiable-credential ;
    vc:implements ngm:verifiable-credentials-data-model,
        ngm:w3c-did-specification ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:access-control,
        ngm:data-sovereignty,
        ngm:trust-framework ;
    vc:requires ngm:cryptographic-signature,
        ngm:verifiable-data-registry ;
    vc:slug "decentralized-identity" ;
    vc:sourceDomain "security" ;
    vc:standardizedBy ngm:decentralized-identity-foundation,
        ngm:openid-foundation,
        ngm:w3c ;
    vc:uses ngm:blockchain,
        ngm:cryptographic-keys,
        ngm:distributed-ledger-technology,
        ngm:public-key-infrastructure,
        ngm:zero-knowledge-proof .

ngm:devops a owl:Class ;
    rdfs:label "DevOps"@en ;
    rdfs:comment "DevOps is a sociotechnical discipline that unifies software development (Dev) and IT operations (Ops) through cultural practices, shared toolchains, and automation pipelines to shorten the system development lifecycle and deliver high-quality software continuously. It operationalises collaboration between development and operations teams by eliminating organisational silos, embracing infrastructure as code, and instrumenting every stage of delivery with feedback loops spanning continuous integration, continuous delivery, monitoring, and incident response. The discipline extends Agile principles beyond code authorship to encompass deployment, reliability engineering, and production observability as first-class engineering concerns."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:monitoring-system ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:continuous-integration ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:version-control ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:incident-response ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:automated-testing ],
        ngm:software-engineering ;
    vc:bridgesTo ngm:devsecops,
        ngm:mlops ;
    vc:contrastsWith ngm:siloed-operations,
        ngm:waterfall-development ;
    vc:dependsOn ngm:cloud-computing,
        ngm:containerisation,
        ngm:microservices ;
    vc:enables ngm:mlops,
        ngm:platform-engineering,
        ngm:site-reliability-engineering ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:continuous-delivery,
        ngm:continuous-deployment,
        ngm:continuous-integration,
        ngm:incident-response,
        ngm:infrastructure-as-code,
        ngm:monitoring-system ;
    vc:implements ngm:agile-software-development,
        ngm:lean-software-development,
        ngm:shift-left-testing ;
    vc:isPartOf ngm:software-delivery-lifecycle ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:feature-flags,
        ngm:observability-platform ;
    vc:requires ngm:automated-testing,
        ngm:build-automation,
        ngm:version-control ;
    vc:slug "devops" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:cloud-platform,
        ngm:security-scanning,
        ngm:software-development ;
    vc:uses ngm:docker,
        ngm:github-actions,
        ngm:kubernetes,
        ngm:terraform .

ngm:inertial-measurement-unit a owl:Class ;
    rdfs:label "Inertial Measurement Unit"@en ;
    rdfs:comment "An Inertial Measurement Unit (IMU) is an electronic device that integrates tri-axial accelerometers, tri-axial gyroscopes, and optionally tri-axial magnetometers to measure a rigid body's specific force, angular rate, and magnetic field, enabling computation of linear acceleration, orientation, and heading relative to an inertial reference frame. MEMS-based IMUs dominate consumer and robotics applications due to low cost, small form factor, and adequate noise performance, while tactical, navigation, and strategic grades using ring-laser or fibre-optic gyroscopes serve aerospace, defence, and surveying applications demanding higher accuracy and lower drift. The raw sensor data are fused through algorithms such as extended Kalman filters, complementary filters, or pre-integration on manifolds to produce robust pose and velocity estimates for autonomous systems. IMUs are foundational to visual-inertial odometry, SLAM pipelines, flight control, pedestrian dead reckoning, and augmented reality tracking."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:accelerometer ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:gyroscope ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:kalman-filter ],
        ngm:robot-sensor ;
    vc:bridgesTo ngm:augmented-reality-tracking,
        ngm:pedestrian-dead-reckoning,
        ngm:spatial-computing ;
    vc:contrastsWith ngm:optical-flow-sensor,
        ngm:wheel-odometry ;
    vc:enables ngm:attitude-estimation,
        ngm:dead-reckoning,
        ngm:odometry,
        ngm:sensor-fusion,
        ngm:visual-inertial-odometry ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:accelerometer,
        ngm:gyroscope,
        ngm:magnetometer ;
    vc:isPartOf ngm:autonomous-vehicle,
        ngm:flight-control-system,
        ngm:robot-hardware ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:allan-variance,
        ngm:gnss,
        ngm:lidar,
        ngm:pose-estimation,
        ngm:slam ;
    vc:requires ngm:imu-calibration,
        ngm:kalman-filter ;
    vc:slug "inertial-measurement-unit" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:complementary-filter,
        ngm:extended-kalman-filter,
        ngm:mems .

ngm:liquidity-provision a owl:Class ;
    rdfs:label "Liquidity Provision"@en ;
    rdfs:comment "Liquidity Provision is the decentralised financial mechanism whereby cryptocurrency holders deposit paired or single-asset collateral into Automated Market Maker smart-contract pools to enable continuous permissionless Token Swap without traditional counterparties or order books, earning ..."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
