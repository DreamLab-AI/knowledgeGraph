ngm:health-check a owl:Class ;
    rdfs:comment "A health check is a periodic probe that determines whether a service instance is functioning correctly and able to handle requests. Health checks distinguish between liveness, whether a process is running and should be restarted if not, and readiness, whether it is prepared to receive traffic. Load balancers, orchestrators, and service meshes use health checks to route around failed instances, trigger restarts, and gate traffic, making them a foundational primitive for high availability and self-healing distributed systems."@en ;
    rdfs:label "Health Check"@en ;
    rdfs:subClassOf ngm:high-availability ;
    rdfs:subClassOf _:r11595 ;
