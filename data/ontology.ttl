ngm:regularisation a owl:Class ;
    rdfs:label "Regularisation"@en ;
    rdfs:comment "A family of techniques that constrain or penalise model complexity during training to prevent overfitting and improve generalisation to unseen data. Common methods include L1 (Lasso) and L2 (Ridge) weight penalties, dropout, early stopping, and data augmentation, each discouraging the model from memorising noise at the expense of learning underlying patterns."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:loss-function ],
        ngm:ai-technique,
        ngm:machine-learning ;
    skos:broader ngm:ai-technique ;
    vc:contrastsWith ngm:overfitting ;
    vc:enables ngm:deep-learning ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:relatedTo ngm:dropout,
        ngm:training ;
    vc:requires ngm:loss-function ;
    vc:slug "regularisation" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:model-training .

ngm:reliability-engineering a owl:Class ;
    rdfs:label "Reliability Engineering"@en ;
    rdfs:comment "Reliability engineering is the discipline concerned with the systematic design, analysis, and verification of systems to ensure they perform their required functions for a specified period under stated conditions without failure. It applies probabilistic and statistical methods — including failure mode analysis, fault tree analysis, and accelerated life testing — to quantify and improve the dependability of hardware, software, and socio-technical systems."@en ;
    rdfs:subClassOf ngm:safety-engineering ;
    vc:enables ngm:risk-assessment ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:fault-tolerance,
        ngm:redundancy,
        ngm:site-reliability-engineering ;
    vc:slug "reliability-engineering" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:fault-tree-analysis,
        ngm:fmea .

ngm:renewable-energy a owl:Class ;
    rdfs:label "Renewable Energy"@en ;
    rdfs:comment "Renewable Energy encompasses energy derived from naturally replenishing sources — principally solar photovoltaic, wind, hydropower, geothermal, and biomass — that are not depleted by use and produce little or no direct greenhouse gas emissions. It forms the primary technical basis for decarbonising electricity systems, with global installed capacity growing at record rates driven by falling costs, policy support, and corporate sustainability commitments requiring clean power procurement."@en ;
    rdfs:subClassOf ngm:energy-and-power ;
    vc:enables ngm:carbon-neutrality-planning,
