    vc:sourceDomain "spatial-computing" .

vf:ar-frame a owl:Class ;
    rdfs:label "AR Frame"@en ;
    rdfs:comment "An **AR Frame** is a head-worn optical see-through augmented reality platform integrating a transparent or semi-transparent microdisplay (typically a microOLED, LCoS, or holographic waveguide projecting 480p-1080p imagery onto a combiner lens of 20°-50° diagonal field-of-view), onboard processing (ARM Cortex-M, Qualcomm Snapdragon AR, or Apple R-series silicon ranging from a 64MHz Cortex-M4F in the Brilliant Labs Frame at 39g through a 3nm Snapdragon AR2 Gen 1 in Meta Orion at 98g to an Apple M2 + R1 chip pair in Vision Pro at 600-650g), a multimodal sensor suite (6-DOF inertial measurement unit, RGB world-facing camera 1-12MP, optional depth sensor or LiDAR, microphone array for spatial audio capture, optional eye-tracking and electrooculography), wireless connectivity (Bluetooth 5.x BLE for phone tethering, Wi-Fi 6/6E for cloud integration, increasingly 5G via tethered companion), and a developer-facing software stack (Lua scripting on Frame, C++ Snapdragon Spaces SDK on Qualcomm reference designs, Unity XR Plugin Management or Unreal OpenXR runtimes for higher-tier devices, Apple visionOS for the spatial-computing apex device) to deliver hands-free augmented reality experiences "@en ;
    rdfs:subClassOf <urn:visionflow:linked:ar-hardware>,
        <urn:visionflow:linked:head-mounted-display>,
        <urn:visionflow:linked:optical-see-through-hmd>,
        <urn:visionflow:linked:spatial-computing-platform>,
        <urn:visionflow:linked:wearable-device> ;
    vc:authorityScore "0.87"^^xsd:float ;
    vc:enables <urn:visionflow:linked:environmental-awareness>,
        <urn:visionflow:linked:hands-free-interaction>,
        <urn:visionflow:linked:heads-up-display>,
        <urn:visionflow:linked:persistent-content-anchoring>,
        <urn:visionflow:linked:remote-expert-guidance>,
        <urn:visionflow:linked:visual-question-answering>,
        vf:real-time-translation ;
    vc:hasPart <urn:visionflow:linked:battery>,
        <urn:visionflow:linked:eye-tracking-sensor>,
        <urn:visionflow:linked:inertial-measurement-unit>,
        <urn:visionflow:linked:microdisplay>,
        <urn:visionflow:linked:microphone-array>,
        <urn:visionflow:linked:onboard-so-c>,
        <urn:visionflow:linked:optical-combiner>,
        <urn:visionflow:linked:wireless-radio>,
        <urn:visionflow:linked:world-facing-camera> ;
    vc:implements <urn:visionflow:linked:foveated-rendering>,
        <urn:visionflow:linked:late-stage-reprojection>,
        <urn:visionflow:linked:open-xr-runtime>,
        <urn:visionflow:linked:slam-tracking>,
        vf:sensor-fusion ;
    vc:maturity "production-ready" ;
    vc:qualityScore "0.52"^^xsd:float ;
    vc:requires <urn:visionflow:linked:inertial-sensors>,
