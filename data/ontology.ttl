ngm:microcontroller a owl:Class ;
    rdfs:label "Microcontroller"@en ;
    rdfs:comment "A microcontroller is a compact integrated circuit that combines a processor core, memory and programmable input and output peripherals on a single chip, designed to run a dedicated control program. Unlike a general-purpose processor, it embeds the resources needed for embedded control directly, enabling low-cost, low-power operation in devices that sense and actuate their environment. Microcontrollers execute firmware in real time and are the computational heart of countless embedded and robotic systems."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:firmware ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:non-volatile-memory ],
        ngm:hardware-component ;
    vc:contrastsWith ngm:system-on-chip ;
    vc:dependsOn ngm:hardware ;
    vc:enables ngm:embedded-system,
        ngm:iot-device ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:memory,
        ngm:non-volatile-memory ;
    vc:isPartOf ngm:embedded-system ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:edge-computing,
        ngm:hardware-component,
        ngm:motor-driver ;
    vc:requires ngm:firmware ;
    vc:slug "microcontroller" ;
    vc:sourceDomain "robotics" ;
    vc:supports ngm:actuator,
        ngm:sensor ;
    vc:uses ngm:real-time-operating-system .

ngm:network-latency a owl:Class ;
    rdfs:label "Network Latency"@en ;
    rdfs:comment "Network Latency is the round-trip communication delay between nodes in a network, directly constraining consensus speed, block propagation, transaction throughput, real-time application responsiveness, and distributed system coordination. High latency increases the probability of forks in blockchain systems, degrades user experience in interactive applications, and sets a fundamental lower bound on achievable synchronisation intervals in geographically distributed deployments."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:latency-management-protocol ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:propagation-delay ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:network-infrastructure ],
        ngm:network-component ;
    vc:bridgesTo ngm:blockchain-scalability,
        ngm:distributed-collaboration,
        ngm:spatial-computing ;
    vc:contrastsWith ngm:latency,
        ngm:throughput ;
    vc:dependsOn ngm:bandwidth,
        ngm:network-topology ;
    vc:enables ngm:real-time-communication ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:processing-delay,
        ngm:propagation-delay,
        ngm:transmission-delay ;
    vc:isPartOf ngm:network-performance-metrics,
        ngm:quality-of-service ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:blockchain-network,
        ngm:distributed-system,
        ngm:gossip-protocol,
        ngm:sub-millisecond-latency ;
    vc:requires ngm:latency-management-protocol,
        ngm:network-infrastructure ;
    vc:slug "network-latency" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:block-propagation-time,
        ngm:consensus-mechanism ;
    vc:uses ngm:round-trip-time .

ngm:operational-resilience a owl:Class ;
    rdfs:label "Operational Resilience"@en ;
    rdfs:comment "Operational Resilience is the organisational and technical capacity to anticipate, prepare for, withstand, recover from, and adapt to disruptions—whether caused by cyber-attacks, infrastructure failures, natural disasters, or human error—while maintaining continuity of critical business services within pre-defined impact tolerances. It extends traditional Business Continuity Management and Disaster Recovery by demanding that organisations identify their most important business services, quantify the maximum tolerable disruption for each, and validate end-to-end resilience through realistic scenario testing. Regulatory frameworks such as the Bank of England's Supervisory Statement SS1/21, the EU Digital Operational Resilience Act (DORA), and NIST SP 800-160 Vol. 2 have transformed operational resilience from a best-practice aspiration into a legal compliance obligation. Technically it is realised through layered redundancy, fault-tolerant architectures, chaos engineering disciplines, and automated recovery orchestration."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:disaster-recovery ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:risk-assessment ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:incident-response ],
        [ a owl:Restriction ;
