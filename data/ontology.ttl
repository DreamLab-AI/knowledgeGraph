        ngm:natural-language-processing,
        ngm:process-reward-model,
        ngm:sampling ;
    vc:requires ngm:autoregressive-model,
        ngm:probability-distribution,
        ngm:vocabulary ;
    vc:slug "beam-search-decoding" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:attention-mechanism,
        ngm:encoder-decoder-architecture,
        ngm:kv-cache,
        ngm:large-language-models,
        ngm:length-normalisation,
        ngm:log-probability,
        ngm:transformer-architecture .

ngm:bilinear-pairing a owl:Class ;
    rdfs:label "Bilinear Pairing"@en ;
    rdfs:comment "A bilinear pairing is a mathematical map between two groups to a third group that is linear in each argument separately, commonly realised as the Weil or Tate pairing on elliptic curves over finite fields. Bilinear pairings enable advanced cryptographic constructions including identity-based encryption, short signature schemes (BLS), and zero-knowledge proof systems. They form the algebraic foundation of pairing-based cryptography, which underpins threshold signatures and SNARKs used in modern blockchain protocols."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:elliptic-curve-cryptography ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:finite-field-arithmetic ],
        ngm:security ;
    vc:contrastsWith ngm:rsa ;
    vc:dependsOn ngm:bls12-381-curve,
        ngm:bn254-curve ;
    vc:enables ngm:bls-signature,
        ngm:identity-based-encryption,
        ngm:threshold-signature,
        ngm:zero-knowledge-proof ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:ate-pairing,
        ngm:weil-pairing ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:cryptographic-accumulator,
        ngm:digital-signature,
        ngm:multi-party-computation ;
    vc:requires ngm:elliptic-curve-cryptography,
        ngm:finite-field-arithmetic ;
    vc:slug "bilinear-pairing" ;
    vc:sourceDomain "security" ;
    vc:supports ngm:blockchain,
        ngm:snark ;
    vc:uses ngm:pairing-based-cryptography,
        ngm:public-key-cryptography .

ngm:bim-software a owl:Class ;
