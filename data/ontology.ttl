    vc:slug "communication-theory" ;
    vc:sourceDomain "distributed-collaboration" ;
    vc:supports ngm:collaborative-systems-modality-technology,
        ngm:telecollaboration .

ngm:compatibility-process a owl:Class ;
    rdfs:label "Compatibility Process"@en ;
    rdfs:comment "Systematic procedure for ensuring that digital assets, applications, and systems conform to common standards, protocols, and specifications to enable seamless exchange, integration, and interoperability across metaverse platforms."@en ;
