        ngm:machine-learning-pipeline ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:access-control-list,
        ngm:bucket,
        ngm:object-metadata ;
    vc:implements ngm:s3-api ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:cloud-storage,
        ngm:data-durability,
        ngm:immutable-storage ;
    vc:requires ngm:distributed-key-value-store,
        ngm:erasure-coding ;
    vc:slug "object-storage" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:geo-redundant-replication,
        ngm:http-protocol,
        ngm:rest-api,
        ngm:storage-tiering .

