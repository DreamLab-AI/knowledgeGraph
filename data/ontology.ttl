ngm:twap-oracle a owl:Class ;
    rdfs:label "Twap Oracle"@en ;
    rdfs:comment "A TWAP oracle is a price oracle that reports the time-weighted average price of an asset over a chosen window rather than its instantaneous spot price. By accumulating price-time observations and dividing by elapsed time, it produces a smoothed figure that is expensive to manipulate within a single block or short interval. TWAP oracles are widely deployed by on-chain automated market makers to supply manipulation-resistant price feeds to lending, derivatives, and liquidation systems."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:liquidity-pool ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:automated-market-maker ],
        ngm:price-oracle ;
    vc:bridgesTo ngm:automated-market-maker ;
    vc:contrastsWith ngm:chainlink,
        ngm:oracle ;
    vc:dependsOn ngm:on-chain-data ;
    vc:enables ngm:decentralized-finance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:liquidity-pool,
        ngm:on-chain-data ;
    vc:isPartOf ngm:price-oracle ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:arbitrage,
        ngm:price-oracle,
        ngm:uniswap ;
    vc:requires ngm:automated-market-maker,
        ngm:on-chain-data ;
    vc:slug "twap-oracle" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:decentralized-finance,
        ngm:dex ;
    vc:uses ngm:automated-market-maker,
        ngm:liquidity-pool,
        ngm:smart-contract .

ngm:twelve-factor-app a owl:Class ;
    rdfs:label "Twelve Factor App"@en ;
    rdfs:comment "The Twelve-Factor App is a methodology for building software-as-a-service applications that are portable, resilient, and suitable for deployment on modern cloud platforms. It defines twelve guidelines covering codebase management, declared dependencies, configuration in the environment, backing services, build-release-run separation, stateless processes, port binding, concurrency, disposability, dev/prod parity, logs as event streams, and admin tasks. Adherence yields applications that scale horizontally, deploy continuously, and integrate cleanly with containerised and orchestrated infrastructure."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:configuration-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:configuration-management ],
        ngm:cloud-native-applications ;
    vc:bridgesTo ngm:containerisation ;
    vc:contrastsWith ngm:microservices ;
    vc:dependsOn ngm:configuration-management ;
    vc:enables ngm:continuous-delivery,
        ngm:scalability ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:configuration-management ;
    vc:implements ngm:cloud-native ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:cloud-native,
        ngm:microservices,
        ngm:software-architecture ;
    vc:requires ngm:configuration-management ;
    vc:slug "twelve-factor-app" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:devops ;
    vc:uses ngm:containerisation .

ngm:ubiquitous-computing a owl:Class ;
    rdfs:label "Ubiquitous Computing"@en ;
    rdfs:comment "Ubiquitous Computing is a paradigm in which computational capability is embedded pervasively throughout the physical environment, making computers effectively invisible by integrating them into everyday objects and spaces. Coined by Mark Weiser, the concept encompasses smart devices, ambient intelligence, and the Internet of Things, aiming for seamless and context-aware interaction between people and technology. It contrasts with desktop computing by distributing computation across many heterogeneous, networked devices that operate without demanding explicit user attention."@en ;
    rdfs:subClassOf ngm:infra-computing-and-cloud ;
    skos:broader ngm:infra-computing-and-cloud ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:internet-of-things ;
    vc:slug "ubiquitous-computing" ;
    vc:sourceDomain "infrastructure" .

ngm:uk-industrial-strategy a owl:Class ;
    rdfs:label "Uk Industrial Strategy"@en ;
    rdfs:comment "UK Industrial Strategy is the United Kingdom government's framework of coordinated public policy aimed at raising productivity, supporting strategic sectors, and steering long-term economic development through targeted investment, skills, and innovation funding. It identifies priority sectors and missions—such as advanced manufacturing, clean energy, and digital technologies—and aligns regulation, infrastructure, and research support behind them. The strategy seeks to balance market dynamics with directed state intervention to address regional and sectoral imbalances."@en ;
    rdfs:subClassOf ngm:infrastructure ;
    skos:broader ngm:infrastructure ;
    vc:bridgesTo ngm:compute-infrastructure ;
    vc:dependsOn ngm:governance ;
    vc:enables ngm:infrastructure,
        ngm:supply-chain ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:public-policy ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:governance,
        ngm:regulation,
        ngm:regulatory-framework ;
    vc:slug "uk-industrial-strategy" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:advanced-manufacturing,
        ngm:economic-development,
        ngm:national-ai-strategy ;
    vc:uses ngm:regulatory-framework .

ngm:uk-research-and-innovation a owl:Class ;
    rdfs:label "Uk Research And Innovation"@en ;
    rdfs:comment "UK Research and Innovation (UKRI) is the United Kingdom's national funding agency for research and innovation, established in 2018 as a non-departmental public body bringing together the seven research councils, Innovate UK, and Research England. It allocates public funding across the disciplines, supports universities and businesses, and shapes national research strategy, including substantial investment in artificial intelligence and data science. UKRI underpins much of the UK's academic research and innovation ecosystem."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:research-and-development ],
        ngm:research-and-development ;
    vc:bridgesTo ngm:alan-turing-institute ;
    vc:dependsOn ngm:academic-research,
