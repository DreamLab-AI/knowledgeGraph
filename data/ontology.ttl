        ngm:stewart-platform ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:end-effector,
        ngm:inverse-kinematics,
        ngm:kinematics,
        ngm:scara-robot ;
    vc:slug "parallel-robot" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:electric-linear-actuator,
        ngm:forward-kinematics,
        ngm:robot-joint .

ngm:parameter a owl:Class ;
    rdfs:label "Parameter"@en ;
    rdfs:comment "A Parameter in machine learning and AI is a learnable variable internal to a model whose values are adjusted during training to minimise a loss function, as distinguished from hyperparameters, which are configuration choices set before training begins. In neural networks, parameters encompass weight matrices and bias vectors in each layer; the total parameter count (ranging from thousands in small models to hundreds of billions in large language models) is a primary indicator of model capacity and computational cost. Parameters are initialised randomly or via transfer learning, then updated iteratively through gradient-based optimisation algorithms such as stochastic gradient descent, encoding learned representations of the training distribution."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:model-training ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:loss-function ],
        ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:contrastsWith ngm:hyperparameter ;
    vc:enables ngm:deep-learning,
        ngm:inference ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:dropout,
        ngm:fine-tuning,
        ngm:neural-network-architecture,
        ngm:overfitting,
        ngm:transformer,
        ngm:underfitting ;
    vc:requires ngm:loss-function,
        ngm:model-training ;
    vc:slug "parameter" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:backpropagation,
        ngm:neural-network .

ngm:parameter-count a owl:Class ;
    rdfs:label "Parameter Count"@en ;
    rdfs:comment "The total number of trainable weights and biases in a neural network, serving as the primary measure of model size and capacity. Parameter count typically ranges from millions to hundreds of billions in modern language models, and governs memory requirements, inference cost, and the upper bound on information that can be encoded; scaling law research relates it to training compute and dataset size."@en ;
    rdfs:subClassOf ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:dependsOn ngm:neural-network-architecture ;
    vc:enables ngm:fine-tuning,
        ngm:transfer-learning ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:large-language-models,
        ngm:neural-network ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:machine-learning-discipline-infrastructure ;
    vc:slug "parameter-count" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:pay-to-script-hash a skos:Concept ;
    rdfs:label "Pay To Script Hash"@en .

ngm:pddl a owl:Class ;
    rdfs:label "PDDL"@en ;
    rdfs:comment "The Planning Domain Definition Language (PDDL) is a standardised formal language for encoding automated-planning problems as domains and problem instances. A domain specifies predicates and actions with preconditions and effects, while a problem instance defines objects, an initial state, and a goal. PDDL provides a common input format that lets generic planners compute action sequences, and it underpins much of classical AI task planning."@en ;
    rdfs:subClassOf ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:task-planning ;
    vc:slug "pddl" ;
    vc:sourceDomain "ai" .

ngm:perimeter-security a skos:Concept ;
    rdfs:label "Perimeter Security"@en .

ngm:permissionless-trading a owl:Class ;
    rdfs:label "Permissionless Trading"@en ;
    rdfs:comment "Permissionless trading refers to the ability to execute financial trades — buying, selling, or swapping digital assets — without requiring authorisation from a centralised intermediary, gatekeeper, or identity provider. Enabled by on-chain smart contracts and automated market makers (AMMs), permissionless trading removes the account approval, KYC, and whitelist requirements of traditional financial markets, allowing any wallet address to interact directly with liquidity pools. It is a foundational property of decentralised finance (DeFi) protocols."@en ;
    rdfs:subClassOf ngm:decentralized-finance-de-fi ;
    vc:enables ngm:asset-trading,
        ngm:yield-farming ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:decentralized-exchange,
        ngm:permissionless-network,
        ngm:token-swapping,
        ngm:uniswap ;
    vc:slug "permissionless-trading" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:automated-market-maker,
        ngm:liquidity-pool,
        ngm:smart-contract .

ngm:persistence-layer a owl:Class ;
    rdfs:label "Persistence Layer"@en ;
    rdfs:comment "A persistence layer is the architectural tier responsible for durably storing and retrieving application state across sessions and process restarts. It abstracts the underlying storage technology, databases, object stores, or distributed logs, behind a uniform interface for reading and writing data. In agent and spatial-computing systems it preserves memory, anchors, and context so that state survives beyond a single runtime."@en ;
    rdfs:subClassOf ngm:infra-data-management ;
    skos:broader ngm:infra-data-management ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:agent-frameworks,
        ngm:spatial-anchor ;
    vc:slug "persistence-layer" ;
    vc:sourceDomain "infrastructure" .

ngm:persistent-memory a owl:Class ;
    rdfs:label "Persistent Memory"@en ;
    rdfs:comment "Persistent Memory (PMEM) is a class of byte-addressable, non-volatile storage technology that occupies the memory bus and exposes its capacity directly to processor load/store instructions, combining the persistence of storage media with latency approaching that of DRAM. It sits in a new tier of the memory hierarchy between volatile DRAM and block-accessed SSDs, enabling applications to retain state across power cycles without the overhead of traditional I/O system calls."@en ;
    rdfs:subClassOf ngm:hardware ;
    vc:enables ngm:machine-learning-discipline-infrastructure,
        ngm:real-time-processing ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:compute-infrastructure,
        ngm:data-persistence,
        ngm:data-storage,
        ngm:hardware-acceleration ;
    vc:slug "persistent-memory" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:inference-engine,
        ngm:vector-database .

ngm:personalized-virtual-experiences a owl:Class ;
    rdfs:label "Personalized Virtual Experiences"@en ;
    rdfs:comment "Personalized Virtual Experiences are AI-driven, dynamically adaptive virtual environments, narratives, and interactions that are tailored to the preferences, behaviour history, physiological signals, and declared identity of individual users. They integrate recommendation systems, adaptive content generation, avatar customisation, and contextual sensing to construct unique, user-specific pathways through spatial computing environments such as virtual reality, augmented reality, and metaverse platforms. The personalisation layer continuously models user intent and affect, adjusting scene composition, difficulty, pacing, social matchmaking, and content curation in real time. As a convergence point of machine learning, spatial computing, and human-computer interaction, these systems raise significant concerns around data sovereignty, consent, and algorithmic bias."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:recommendation-systems ],
        ngm:virtual-experience ;
    vc:bridgesTo ngm:digital-twin,
        ngm:federated-identity,
        ngm:generative-ai ;
    vc:contrastsWith ngm:shared-virtual-environment,
        ngm:static-virtual-experience ;
    vc:dependsOn ngm:cloud-rendering,
        ngm:edge-computing,
        ngm:user-data-collection ;
    vc:enables ngm:adaptive-learning,
        ngm:immersive-storytelling,
        ngm:user-engagement ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:behavioural-analytics,
        ngm:dynamic-content-generation ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:affective-computing,
        ngm:data-privacy,
        ngm:extended-reality,
        ngm:metaverse ;
    vc:requires ngm:real-time-data-processing,
        ngm:recommendation-systems,
        ngm:user-profiling ;
    vc:slug "personalized-virtual-experiences" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:avatar-systems,
        ngm:machine-learning,
        ngm:natural-language-processing,
        ngm:spatial-audio .

ngm:physics-simulation-engine a owl:Class ;
    rdfs:label "Physics Simulation Engine"@en ;
    rdfs:comment "A physics simulation engine is software that computes the motion and interaction of objects according to physical laws, such as rigid body dynamics and collisions. It is used in games, robotics, and engineering."@en ;
