        ngm:shared-virtual-world ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:conflict-resolution-engine,
        ngm:consistency-protocol,
        ngm:delta-compression,
        ngm:state-replication,
        ngm:timestamp-ordering ;
    vc:isPartOf ngm:digital-twin-interop-protocol,
