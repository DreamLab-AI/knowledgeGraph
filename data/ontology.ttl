    rdfs:label "Visual Design"@en .

ngm:visual-grounding a owl:Class ;
    rdfs:label "Visual Grounding"@en ;
    rdfs:comment "Visual grounding is the task of localising the region of an image or scene that corresponds to a natural-language expression, linking words to specific visual entities. It connects language understanding to perception, enabling models to point at, select or act on the object a user refers to. Visual grounding is foundational for vision-language models and for agents that operate graphical interfaces."@en ;
    rdfs:subClassOf ngm:computer-vision ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:computer-use-and-browser-agents,
        ngm:vision-language-model ;
    vc:slug "visual-grounding" ;
    vc:sourceDomain "ai" .

ngm:visual-marker a owl:Class ;
    rdfs:label "Visual Marker"@en ;
    rdfs:comment "A distinctive visual pattern or fiducial placed in physical environments to enable computer vision systems to determine position, orientation, and pose for augmented reality applications. Types include QR codes, AprilTags, ARTags, and custom image targets that serve as reference points for overlaying digital content; detection relies on camera capture, template matching, and pose estimation algorithms, often combined with SLAM or IMU sensor fusion for robust tracking."@en ;
    rdfs:subClassOf ngm:ar-technology,
        ngm:sc-interaction ;
    skos:broader ngm:sc-interaction ;
    vc:enables ngm:augmented-reality,
        ngm:spatial-mapping ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:relatedTo ngm:object-detection,
        ngm:slam ;
    vc:slug "visual-marker" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:computer-vision,
        ngm:pose-estimation,
        ngm:sensor-fusion .

ngm:visual-representation a owl:Class ;
    rdfs:label "Visual Representation"@en ;
    rdfs:comment "A visual representation is a learned encoding of image or video content into a feature vector or embedding that captures semantic and structural properties useful for downstream tasks. Such representations, produced by convolutional or transformer-based encoders, support classification, retrieval, detection, and multimodal alignment. The quality of a visual representation determines transferability and sample efficiency across vision applications."@en ;
    rdfs:subClassOf ngm:computer-vision ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:reality-capture-system,
        ngm:vision-language-model ;
    vc:slug "visual-representation" ;
    vc:sourceDomain "ai" .

ngm:visualization-layer a owl:Class ;
    rdfs:label "Visualization Layer"@en ;
    rdfs:comment "Graphics and rendering systems responsible for displaying virtual environments, objects, and interfaces through advanced rendering pipelines and visual processing."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:display-hardware ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
