vf:death-of-the-internet a owl:Class ;
    rdfs:label "Death of the Internet"@en ;
    rdfs:comment "**Death of the Internet** is a concept cluster in the ethics-society and [[Media Theory]] domains capturing the convergent degradation of the public World Wide Web as a space for authentic human knowledge-exchange, discovery, and democratic discourse. The cluster synthesises four interlocking phenomena operating on different timescales and through different causal mechanisms, yet mutually reinforcing in their combined effect on [[Information Integrity]] and [[Digital Society Surveillance]]: **(1) The Dead Internet Theory** — originally a 2021 fringe hypothesis posted anonymously on Agora Road forum, now substantially corroborated empirically, proposing that the majority of online activity is driven by bots, automated content systems, algorithmic feeds, and state and corporate manipulation rather than genuine human-to-human interaction. The theory predicts that organic, serendipitous human discourse has been displaced by choreographed, commercially or politically motivated automated activity that mimics the appearance of human engagement whilst serving radically different incentive structures. By 2024, empirical measurement had validated the core claim: Imperva's Bad Bot Report 2024"@en ;
    rdfs:subClassOf <urn:visionflow:linked:information-integrity>,
        <urn:visionflow:linked:platform-decay>,
        <urn:visionflow:linked:surveillance-capitalism>,
        vf:ai-ethics,
        vf:digital-society-surveillance,
        vf:media-theory ;
    vc:authorityScore "0.87"^^xsd:float ;
    vc:enables <urn:visionflow:linked:algorithmic-capture>,
        <urn:visionflow:linked:attention-manipulation>,
        <urn:visionflow:linked:digital-divide>,
        <urn:visionflow:linked:disinformation-ecosystem>,
        <urn:visionflow:linked:epistemic-degradation>,
        <urn:visionflow:linked:model-collapse>,
        <urn:visionflow:linked:surveillance-capitalism> ;
    vc:hasPart <urn:visionflow:linked:algorithmic-capture>,
        <urn:visionflow:linked:background-tokens>,
        <urn:visionflow:linked:bot-traffic>,
        <urn:visionflow:linked:dark-forest-theory>,
        <urn:visionflow:linked:dead-internet-theory>,
        <urn:visionflow:linked:enshittification>,
        <urn:visionflow:linked:filter-bubble>,
        <urn:visionflow:linked:habsburg-ai>,
        <urn:visionflow:linked:synthetic-content-saturation> ;
    vc:implements <urn:visionflow:linked:age-verification>,
        <urn:visionflow:linked:api-rate-limiting>,
        <urn:visionflow:linked:content-credentials>,
        <urn:visionflow:linked:online-safety-act-2023>,
        <urn:visionflow:linked:robots-txt-enforcement>,
        vf:c2-pa-standard ;
    vc:maturity "production-ready" ;
    vc:qualityScore "0.52"^^xsd:float ;
    vc:requires <urn:visionflow:linked:authentic-content>,
        <urn:visionflow:linked:content-provenance>,
        <urn:visionflow:linked:epistemic-infrastructure>,
