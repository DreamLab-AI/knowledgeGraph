ngm:immersive-audio-technology a owl:Class ;
    rdfs:label "Immersive Audio Technology"@en ;
    rdfs:comment "Technologies and techniques for rendering spatially accurate, three-dimensional soundscapes within virtual and augmented reality environments. Encompasses binaural rendering, ambisonics, head-related transfer function (HRTF) personalisation, and real-time positional audio to create convincing auditory presence that reinforces visual immersion."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:xr-runtime-environment ],
        [ a owl:Restriction ;
