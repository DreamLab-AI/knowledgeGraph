    owl:onProperty ngm:variantOf ;
    owl:someValuesFrom rb:RRTStar
] .

rb:RRTAlgorithm rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:variantOf ;
    owl:someValuesFrom rb:RRTConnect
] .

rb:RRTAlgorithm rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:variantOf ;
    owl:someValuesFrom rb:InformedRRTStar
] .

rb:RRTAlgorithm rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:uses ;
    owl:someValuesFrom rb:NearestNeighborSearch
] .

rb:RRTAlgorithm rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:uses ;
    owl:someValuesFrom rb:CollisionDetection
] .

rb:RRTAlgorithm rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:appliedIn ;
    owl:someValuesFrom rb:MobileRobots
] .

rb:RRTAlgorithm rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:appliedIn ;
    owl:someValuesFrom rb:Manipulators
] .

rb:RRTAlgorithm rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:appliedIn ;
    owl:someValuesFrom rb:AutonomousVehicles
] .

# Dijkstra Algorithm
rb:DijkstraAlgorithm a owl:Class ;
    rdfs:subClassOf rb:RB1016pathplanning ;
    rdfs:subClassOf rb:GraphSearch ;
    rdfs:label "Dijkstra Algorithm"@en ;
    rdfs:comment "A graph search algorithm that finds the shortest path from a source node to all other nodes in a weighted graph with non-negative edge weights. It systematically explores nodes in order of increasing distance from the source, guaranteeing optimal solutions."@en ;
    skos:prefLabel "Dijkstra Algorithm"@en ;
    dcterms:identifier "RB-1018" ;
    dcterms:subject "rb" ;
    dcterms:type "mature" ;
    dcterms:conformsTo "0.99"^^xsd:decimal ;
    rdf:type owl:AlgorithmClass .

