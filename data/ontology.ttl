    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:infra-software-engineering .

ngm:digital-dualism a owl:Class ;
    rdfs:label "Digital Dualism"@en ;
    rdfs:comment "Digital Dualism is the conceptual framework positing a fundamental, hierarchical separation between digital/virtual and physical/offline experience domains, treating them as mutually exclusive rather than mutually constitutive. Critiqued by Nathan Jurgenson (2011), who proposed an augmented reality perspective recognising that digital and physical are increasingly entangled: digital interactions produce physical consequences, and physical activities generate digital traces. The critique is particularly relevant to metaverse and telecollaboration design, where dualist assumptions lead to poorly integrated hybrid experiences."@en ;
    rdfs:subClassOf ngm:metaverse,
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:bridgesTo ngm:digital-twin ;
    vc:contrastsWith ngm:augmented-reality,
        ngm:telecollaboration ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:digital-identity,
        ngm:metaverse ;
    vc:slug "digital-dualism" ;
    vc:sourceDomain "spatial-computing" .

