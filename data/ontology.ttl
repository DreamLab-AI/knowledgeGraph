ngm:hierarchical-task-network a owl:Class ;
    rdfs:label "Hierarchical Task Network"@en ;
    rdfs:comment "A hierarchical task network (HTN) is an automated planning formalism in which planning proceeds by recursively decomposing high-level compound tasks into networks of smaller subtasks until only primitive, directly executable actions remain. Decomposition is guided by domain-specific methods that encode expert knowledge about how tasks may be accomplished, together with ordering constraints between subtasks. HTN planning contrasts with classical state-space planning by searching over task decompositions rather than over world states alone, which often yields stronger guidance and greater efficiency in well-structured domains."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:automated-reasoning ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:goal ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:task-decomposition ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:task-decomposition ],
        ngm:automated-planning ;
    vc:bridgesTo ngm:robotics ;
    vc:contrastsWith ngm:reinforcement-learning ;
    vc:dependsOn ngm:automated-planning ;
    vc:enables ngm:decision-making,
        ngm:planning ;
    vc:hasMaturity ngmi:maturity-established ;
