ngm:threat-intelligence a owl:Class ;
    rdfs:label "Threat Intelligence"@en ;
    rdfs:comment "Threat intelligence is the disciplined process of collecting, processing, analysing, and disseminating information about adversaries, their capabilities, intentions, and tactics in order to enable organisations to make informed defensive and strategic decisions. It transforms raw threat data — indicators of compromise, malware signatures, actor profiles, campaign timelines — into contextualised, actionable knowledge tailored to a specific audience. Intelligence is typically classified by time horizon and consumer: strategic intelligence informs executive risk decisions, operational intelligence guides incident response planning, and tactical intelligence feeds real-time detection and blocking systems. Sharing platforms such as STIX/TAXII and ISACs enable cross-organisational distribution of finished intelligence to raise collective defensive posture."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:threat-actor ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-aggregation ],
        ngm:cybersecurity ;
    vc:bridgesTo ngm:artificial-intelligence,
        ngm:data-governance ;
    vc:contrastsWith ngm:vulnerability-management ;
    vc:dependsOn ngm:data-collection,
        ngm:threat-modelling ;
    vc:enables ngm:incident-response,
        ngm:network-security,
        ngm:risk-management,
        ngm:security-operations-centre ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:threat-actor ;
    vc:implements ngm:stix-taxii ;
    vc:isPartOf ngm:information-security ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:dark-web-monitoring,
        ngm:threat-hunting ;
    vc:requires ngm:data-aggregation,
        ngm:open-source-intelligence ;
    vc:slug "threat-intelligence" ;
    vc:sourceDomain "security" ;
    vc:standardizedBy ngm:oasis ;
    vc:supports ngm:endpoint-detection-and-response,
        ngm:security-information-and-event-management ;
    vc:uses ngm:graph-database,
        ngm:machine-learning,
        ngm:natural-language-processing .

ngm:threshold-signature-scheme a owl:Class ;
    rdfs:label "Threshold Signature Scheme"@en ;
    rdfs:comment "A Threshold Signature Scheme (TSS) is a cryptographic protocol in which a private key is distributed among n parties such that any subset of at least t parties can jointly compute a valid digital signature without any single party ever possessing the complete private key, while fewer than t parties gain zero information about the key. TSS extends threshold secret sharing (Shamir's Secret Sharing) to the signing operation itself, producing a signature that is indistinguishable on-chain from a standard single-key signature, thereby enhancing privacy and reducing transaction fees compared to traditional on-chain multisig. TSS underpins distributed key management for exchanges, MPC wallets, and cross-chain bridge custody architectures."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:secure-multi-party-computation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:distributed-key-generation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:secret-sharing ],
        ngm:signature-scheme ;
    vc:bridgesTo ngm:decentralized-finance,
        ngm:trusted-execution-environment ;
    vc:contrastsWith ngm:hardware-security-module,
        ngm:multi-signature ;
    vc:dependsOn ngm:homomorphic-encryption,
        ngm:multi-party-computation ;
    vc:enables ngm:decentralized-governance,
        ngm:institutional-custody,
        ngm:key-management,
        ngm:mpc-wallet,
        ngm:threshold-cryptography ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:implements ngm:digital-signature ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:bls-signature,
        ngm:taproot ;
    vc:requires ngm:distributed-key-generation,
        ngm:secret-sharing,
        ngm:secure-multi-party-computation ;
    vc:slug "threshold-signature-scheme" ;
    vc:sourceDomain "security" ;
    vc:supports ngm:cross-chain-bridge,
        ngm:proof-of-stake ;
    vc:uses ngm:cryptographic-keys,
        ngm:elliptic-curve-cryptography,
        ngm:schnorr-signature,
        ngm:zero-knowledge-proof .

ngm:token-weighted-voting a owl:Class ;
    rdfs:label "Token-Weighted Voting"@en ;
    rdfs:comment "Token-weighted voting is an on-chain governance mechanism in which each participant's voting power is directly proportional to the quantity of governance tokens they hold, lock, or stake. It is the dominant decision-making primitive in decentralised autonomous organisations and DeFi protocols, enabling transparent, programmable, and censorship-resistant governance of parameter changes, treasury allocations, and protocol upgrades. The mechanism exhibits plutocratic tendencies in which large token holders disproportionately control outcomes, motivating research into alternative weighting schemes such as quadratic voting, conviction voting, and vote-escrow models. Implementations range from fully on-chain execution via Governor Bravo and OpenZeppelin Governor to off-chain gasless signalling via platforms such as Snapshot."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:quorum-threshold ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:erc-20-tokens ],
        ngm:bc-governance-and-regulation ;
    skos:broader ngm:bc-governance-and-regulation ;
