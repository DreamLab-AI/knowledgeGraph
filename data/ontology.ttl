ngm:eu-ai-act a owl:Class ;
    rdfs:label "EU AI Act"@en ;
    rdfs:comment "The EU AI Act (Regulation 2024/1689) is the European Union's comprehensive legal framework for artificial intelligence, establishing harmonised rules for the development, deployment, and use of AI systems based on a risk-tiered classification. It prohibits certain AI practices outright, imposes strict conformity obligations on high-risk AI systems, and mandates transparency for limited-risk AI. Enacted in 2024 and progressively entering into force through 2026–2027, it is the world's first binding horizontal AI regulation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:conformity-assessment ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:notified-body ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:risk-assessment ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:human-oversight ],
        ngm:ai-regulation ;
    vc:enables ngm:ai-governance-framework,
        ngm:regulatory-compliance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:ai-ethics,
        ngm:ai-governance,
        ngm:ai-risk-management,
        ngm:data-protection,
        ngm:high-risk-ai-system,
        ngm:prohibited-ai-practice,
        ngm:transparency ;
    vc:requires ngm:conformity-assessment,
        ngm:human-oversight,
        ngm:notified-body,
        ngm:risk-assessment ;
    vc:slug "eu-ai-act" ;
    vc:sourceDomain "governance" ;
    vc:standardizedBy ngm:european-commission .

ngm:information-retrieval a owl:Class ;
    rdfs:label "Information Retrieval"@en ;
    rdfs:comment "Information Retrieval (IR) is the discipline and set of techniques for finding relevant documents, passages, or facts from a corpus in response to a query. Modern IR systems employ inverted indices, vector embeddings, and semantic search to match queries against large-scale knowledge bases and document collections. In spatial computing, IR underpins context-aware search, knowledge graph querying, and retrieval-augmented generation pipelines that ground AI responses in factual content."@en ;
    rdfs:subClassOf ngm:sc-standards-and-interop ;
    skos:broader ngm:sc-standards-and-interop ;
    vc:enables ngm:retrieval-augmented-generation,
        ngm:search-engine ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:relatedTo ngm:natural-language-processing ;
    vc:slug "information-retrieval" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:knowledge-graph,
        ngm:semantic-search,
        ngm:vector-database .

ngm:loss-function a owl:Class ;
    rdfs:label "Loss Function"@en ;
    rdfs:comment "Loss Function is a artificial intelligence concept and a type of artificial-intelligence."@en ;
    rdfs:subClassOf ngm:ai-technique,
        ngm:evaluation-metric ;
    skos:broader ngm:ai-technique ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:relatedTo ngm:artificial-intelligence ;
    vc:slug "loss-function" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:tokenomics a owl:Class ;
    rdfs:label "Tokenomics"@en ;
    rdfs:comment "Tokenomics describes the economic design and incentive structures of blockchain-based token systems, covering token supply mechanics, distribution schedules, utility functions, and governance rights. Within virtual economies and metaverse platforms, tokenomics governs how digital assets are minted, traded, staked, and burned to sustain ecosystem participation and align stakeholder incentives. Sound tokenomic design balances inflationary rewards for contributors against deflationary sinks, using mechanisms such as bonding curves, liquidity pools, and vesting schedules."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:blockchain ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:smart-contract ],
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:enables ngm:dao,
        ngm:payment-system ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:relatedTo ngm:nft ;
    vc:requires ngm:blockchain,
        ngm:smart-contract ;
    vc:slug "tokenomics" ;
    vc:sourceDomain "spatial-computing" .

