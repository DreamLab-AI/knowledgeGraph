    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:leader-election,
        ngm:voting-round ;
    vc:implements ngm:byzantine-fault-tolerance,
        ngm:paxos,
        ngm:raft ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:byzantine-generals-problem,
        ngm:partial-synchrony,
        ngm:tendermint ;
    vc:requires ngm:distributed-systems,
        ngm:fault-tolerance,
        ngm:message-passing,
        ngm:quorum ;
    vc:slug "consensus" ;
    vc:sourceDomain "distributed-systems" ;
    vc:supports ngm:blockchain,
        ngm:smart-contract ;
    vc:uses ngm:cryptographic-hash,
        ngm:digital-signature .

ngm:open-standard a owl:Class ;
    rdfs:label "Open Standard"@en ;
    rdfs:comment "An open standard is a publicly accessible specification for a technology, protocol, format, or interface that is developed through a transparent, consensus-based process and can be implemented and used without discriminatory restrictions. Open standards enable interoperability between systems from different vendors by providing a shared, stable technical baseline. They are maintained by recognised standards bodies and are typically available royalty-free or under FRAND (Fair, Reasonable And Non-Discriminatory) licensing terms. Open standards contrast with proprietary specifications controlled by a single vendor and are foundational to open, competitive ecosystems."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:reference-implementation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:consensus-process ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:standards-conformance-testing ],
        ngm:sc-standards-and-interop ;
    skos:broader ngm:sc-standards-and-interop ;
    vc:bridgesTo ngm:gltf-standard,
        ngm:open-xr,
        ngm:web-xr ;
    vc:contrastsWith ngm:closed-specification,
        ngm:proprietary-format,
        ngm:vendor-lock-in ;
    vc:enables ngm:data-portability,
        ngm:interoperability,
        ngm:vendor-neutrality ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:reference-implementation,
        ngm:specification-document,
        ngm:standards-conformance-testing ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:api,
        ngm:digital-sovereignty,
        ngm:frand-licensing,
        ngm:open-source-software,
        ngm:protocol ;
    vc:requires ngm:consensus-process ;
    vc:slug "open-standard" ;
    vc:sourceDomain "standards" ;
    vc:standardizedBy ngm:ieee,
        ngm:ietf,
        ngm:iso,
        ngm:standards-development-organisation,
        ngm:w3-c .

ngm:probabilistic-model a owl:Class ;
    rdfs:label "Probabilistic Model"@en ;
    rdfs:comment "ProbabilisticModel is an owl:Class within the artificial-intelligence domain representing any computational or mathematical framework that explicitly represents uncertainty over random variables through probability distributions, enabling principled inference, prediction, and decision-making unde..."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
