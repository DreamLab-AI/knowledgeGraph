ngm:cortex-agent a owl:Class ;
    rdfs:label "Cortex Agent"@en ;
    rdfs:comment "Cortex Agent is a class of enterprise agentic AI system that orchestrates multi-step reasoning and action across both structured and unstructured data sources within a governed cloud data platform, with Snowflake Cortex Agents (General Availability November 4, 2025) as the dominant production ins..."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
