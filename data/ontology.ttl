ngm:scene-capture-and-reconstruction a owl:Class ;
    rdfs:label "Scene Capture and Reconstruction"@en ;
    rdfs:comment "Scene Capture and Reconstruction is a fundamental computer-vision and spatial-computing discipline concerned with recovering complete geometric, radiometric, and semantic representations of physical environments from sensor observations — primarily calibrated multi-view photographs, RGB-D frames,..."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:point-cloud ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:structure-from-motion ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:signed-distance-function ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gpu-compute ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:feature-matching ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:neural-radiance-field ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:volume-rendering ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:camera-calibration ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:bundle-adjustment ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:differentiable-rendering ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:camera-parameters ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:multi-view-stereo ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:differentiable-rendering ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:3-d-gaussian-splatting ],
        ngm:ai-technique,
        ngm:computer-vision ;
    skos:broader ngm:ai-technique ;
    vc:enables ngm:3-d-asset,
        ngm:3-d-content-generation,
        ngm:ar-technology,
        ngm:autonomous-navigation,
        ngm:cultural-heritage-preservation,
        ngm:digital-twin,
        ngm:surgical-navigation,
        ngm:virtual-production ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:3-d-gaussian-splatting,
        ngm:camera-calibration,
        ngm:differentiable-rendering,
        ngm:multi-view-stereo,
        ngm:neural-radiance-field,
        ngm:point-cloud,
        ngm:signed-distance-function,
        ngm:structure-from-motion,
        ngm:volume-rendering ;
    vc:implements ngm:bundle-adjustment,
        ngm:differentiable-rendering,
        ngm:gaussian-splatting,
        ngm:signed-distance-function,
        ngm:structure-from-motion,
        ngm:volume-rendering ;
    vc:qualityScore "0.52"^^xsd:float ;
    vc:relatedTo ngm:3-d-file-format,
        ngm:computer-vision-system,
        ngm:depth-estimation,
        ngm:etsi-domain-immersive-reality-capture-crossover,
        ngm:human-capture-and-recognition,
        ngm:human-pose-slam-capture-system,
        ngm:image-segmentation ;
    vc:requires ngm:bundle-adjustment,
        ngm:camera-parameters,
        ngm:differentiable-rendering,
        ngm:feature-matching,
        ngm:gpu-compute,
        ngm:multi-view-images ;
    vc:slug "scene-capture-and-reconstruction" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:standardizedBy ngm:cvpr,
        ngm:eccv,
        ngm:iccv,
        ngm:neur-ips,
        ngm:siggraph ;
    vc:supports ngm:3-d-content-pipeline,
        ngm:augmented-reality,
        ngm:autonomous-navigation,
        ngm:digital-avatar,
        ngm:extended-reality-xr,
        ngm:slam,
        ngm:virtual-reality ;
    vc:uses ngm:3-d-gaussian-splatting,
        ngm:colmap,
        ngm:luma-ai,
        ngm:reality-capture .

