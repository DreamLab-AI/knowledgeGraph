        ngm:game-engine,
        ngm:virtual-production-workflow .

ngm:flux-1 a owl:Class ;
    rdfs:label "Flux.1"@en ;
    rdfs:comment "Flux.1 is a family of open-weight text-to-image generative models developed by Black Forest Labs, founded by former Stability AI researchers including Robin Rombach, the co-creator of Latent Diffusion. Released in August 2024, Flux.1 employs a hybrid architecture combining multimodal and parallel diffusion transformer (DiT) blocks, achieving state-of-the-art image quality and prompt adherence that surpasses earlier diffusion models on benchmarks such as GenEval and T2I-CompBench. The family offers three variants — Flux.1 [pro], Flux.1 [dev], and Flux.1 [schnell] — spanning commercial API, open-weights research, and fast inference use cases respectively."@en ;
    rdfs:subClassOf ngm:diffusion-model ;
    vc:contrastsWith ngm:stable-diffusion ;
    vc:dependsOn ngm:model-training ;
    vc:enables ngm:inpainting,
        ngm:open-source-ai ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:diffusion-models,
        ngm:image-generation,
        ngm:latent-diffusion,
        ngm:text-to-image ;
    vc:slug "flux-1" ;
    vc:sourceDomain "ai" ;
    vc:supports ngm:comfy-ui-workflows,
        ngm:lo-ra-do-ra-etc ;
    vc:uses ngm:deep-learning,
        ngm:neural-network-architecture .

ngm:gaussian-process a owl:Class ;
    rdfs:label "Gaussian Process"@en ;
    rdfs:comment "A Gaussian Process (GP) is a non-parametric Bayesian model that places a probability distribution over functions, fully specified by a mean function and a covariance (kernel) function, such that any finite collection of function values follows a joint Gaussian distribution. GPs provide principled uncertainty quantification alongside predictions and serve as flexible surrogate models in scientific computing and optimisation."@en ;
    rdfs:subClassOf ngm:bayesian-inference ;
    vc:enables ngm:bayesian-optimisation ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:gaussian-process-regression,
        ngm:hamiltonian-monte-carlo,
        ngm:kernel-methods ;
    vc:slug "gaussian-process" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:gaussian-distribution .

ngm:genesis-block a owl:Class ;
    rdfs:label "Genesis Block"@en ;
    rdfs:comment "The genesis block is the first block in a blockchain, hardcoded into the client software and serving as the immutable anchor from which the entire chain of subsequent blocks descends. It establishes the initial chain state, encodes the founding parameters of the network, and contains no reference to a previous block hash. Because it cannot be altered without invalidating all subsequent blocks, the genesis block is the ultimate root of trust for the distributed ledger."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptographic-hash ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:coinbase-transaction ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:immutability ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:nonce ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:timestamp ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:block-header ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:merkle-root ],
        ngm:bc-protocol-and-consensus,
        ngm:blockchain-entity,
        ngm:distributed-data-structure ;
    skos:broader ngm:bc-protocol-and-consensus ;
    vc:enables ngm:block-height,
        ngm:blockchain-network ;
