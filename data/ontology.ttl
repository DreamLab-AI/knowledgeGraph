    vc:implements ngm:reverse-proxy ;
    vc:isPartOf ngm:service-mesh ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:infrastructure,
        ngm:microservices ;
    vc:slug "envoy-proxy" ;
    vc:sourceDomain "infrastructure" ;
