ngm:arcore a owl:Class ;
    rdfs:label "Arcore"@en ;
    rdfs:comment "ARCore is Google's software development kit for building augmented-reality applications on Android and, via web standards, the browser. It provides motion tracking, environmental understanding and light estimation by fusing camera frames with inertial sensors to anchor virtual content in the physical world. ARCore is the principal counterpart to Apple's ARKit in the mobile-AR ecosystem."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:camera-calibration ],
        ngm:augmented-reality ;
    vc:contrastsWith ngm:augmented-reality ;
    vc:dependsOn ngm:visual-slam ;
    vc:enables ngm:scene-understanding ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:slam ;
    vc:isPartOf ngm:augmented-reality ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:spatial-anchors ;
