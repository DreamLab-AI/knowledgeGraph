ngm:data-brokers a owl:Class ;
    rdfs:label "Data Brokers"@en ;
    rdfs:comment "Data brokers are firms that collect, aggregate, enrich and resell personal and behavioural data about individuals, typically without a direct relationship with those individuals. They assemble profiles from public records, online tracking and commercial sources for marketing, scoring and risk uses. They are a focal point of privacy regulation and surveillance concern because their trade can enable pervasive monitoring and profiling."@en ;
    rdfs:subClassOf ngm:data-management ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:digital-society-surveillance ;
    vc:slug "data-brokers" ;
    vc:sourceDomain "governance" .

ngm:data-catalog a owl:Class ;
    rdfs:label "Data Catalog"@en ;
    rdfs:comment "A data catalog is a centralised, searchable inventory of an organisation's data assets enriched with metadata, descriptions, ownership and usage context. It enables discovery, governance and self-service analytics by indexing datasets, schemas and their relationships, often integrating glossaries and lineage. As a component of metadata management and data fabric architectures it is essential for finding and trusting data at scale."@en ;
    rdfs:subClassOf ngm:infra-data-management ;
    skos:broader ngm:infra-data-management ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:data-fabric-architecture,
        ngm:metadata-management ;
    vc:slug "data-catalog" ;
    vc:sourceDomain "data" .

ngm:data-confidentiality a owl:Class ;
    rdfs:label "Data Confidentiality"@en ;
    rdfs:comment "The property that data is accessible only to those authorised to view it, protecting information from disclosure to unauthorised parties. It is one of the core objectives of information security."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptography ],
        ngm:information-security ;
    vc:enables ngm:privacy ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:cryptography ;
    vc:slug "data-confidentiality" ;
    vc:sourceDomain "information-security" .

ngm:data-engineering a owl:Class ;
    rdfs:label "Data Engineering"@en ;
    rdfs:comment "Data Engineering is the discipline concerned with designing, building and operating the systems that collect, store, transform and serve data at scale. It covers data pipelines, storage architectures, batch and streaming processing, data modelling and the orchestration and monitoring of workflows. Its purpose is to make reliable, well-structured data available for analytics, reporting and machine learning."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:distributed-systems-domain ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:data-warehouse ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:data-pipeline ],
        ngm:infrastructure-domain ;
    vc:enables ngm:business-intelligence,
        ngm:machine-learning-domain ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:data-pipeline,
        ngm:data-warehouse,
        ngm:etl ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:distributed-systems-domain ;
    vc:slug "data-engineering" ;
    vc:sourceDomain "data-engineering" .

ngm:data-fabric-architecture a owl:Class ;
    rdfs:label "Data Fabric Architecture"@en ;
    rdfs:comment "An integrated data-management architecture that provides unified access, governance, security, and orchestration across distributed and heterogeneous data sources through active metadata management, automated data integration, and policy-driven controls."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:data-virtualization ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:identity-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:data-catalog ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:distributed-storage ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:api-gateway ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:metadata-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:metadata-repository ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:governance-framework ],
        [ a owl:Restriction ;
