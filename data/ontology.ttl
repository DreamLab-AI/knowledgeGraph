    vc:isPartOf ngm:neural-network-layer ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:attention-mechanism ;
    vc:relatedTo ngm:large-language-models ;
    vc:slug "rmsnorm" ;
    vc:sourceDomain "artificial-intelligence" .
ngm:rmsprop a owl:Class ;
    rdfs:comment "A stochastic gradient descent variant, proposed by Geoffrey Hinton in his 2012 Coursera lectures, that divides each parameter's update by the root of an exponentially weighted moving average of its squared gradients, giving every parameter its own adaptive step size; it cured AdaGrad's vanishing learning rate, made recurrent networks practical to train, and supplied the second-moment machinery later absorbed into Adam."@en ;
    rdfs:label "RMSProp"@en ;
    rdfs:subClassOf ngm:optimisation-algorithm ;
    vc:contrastsWith ngm:adam-optimiser ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:implements ngm:adaptive-learning-rate ;
