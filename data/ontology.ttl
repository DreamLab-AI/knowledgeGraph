ngm:service-mesh a owl:Class ;
    rdfs:label "Service Mesh"@en ;
    rdfs:comment "A service mesh is a dedicated infrastructure layer for managing service-to-service communication within a microservices architecture, providing traffic management, mutual TLS encryption, observability, and policy enforcement transparently to application code through sidecar proxies or eBPF-based data planes. It decouples operational concerns—load balancing, retries, circuit breaking, telemetry—from business logic, enabling consistent reliability and security across heterogeneous services."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:container-orchestration ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:certificate-authority ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:service-discovery ],
        ngm:microservices-architecture ;
    vc:bridgesTo ngm:web-assembly,
        ngm:zero-trust-architecture ;
    vc:contrastsWith ngm:api-gateway ;
    vc:enables ngm:canary-deployment,
        ngm:observability,
        ngm:zero-trust-architecture ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:control-plane,
        ngm:sidecar-proxy ;
    vc:implements ngm:distributed-tracing ;
    vc:isPartOf ngm:cloud-native,
        ngm:microservices-architecture ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:microservices ;
    vc:requires ngm:certificate-authority,
        ngm:container-orchestration,
        ngm:service-discovery ;
    vc:slug "service-mesh" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:traffic-management ;
