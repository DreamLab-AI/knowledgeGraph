ngm:multiformats a owl:Class ;
    rdfs:comment "Multiformats is a collection of self-describing protocol and value specifications designed to make data formats future-proof and interoperable across decentralised systems. Rather than hard-coding a single hash, encoding, or address scheme, each multiformat prefixes the value with a compact code declaring which algorithm or format it uses, so software can interpret it unambiguously and evolve without breaking. Components include multihash, multibase, multicodec, and multiaddr, and the family underpins content addressing in IPFS and libp2p."@en ;
    rdfs:label "Multiformats"@en ;
    rdfs:subClassOf ngm:content-addressing ;
    rdfs:subClassOf _:r14958 ;
    rdfs:subClassOf _:r14959 ;
