        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:digital-asset ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:nft ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:3-d-asset ],
        ngm:spatial-computing ;
    skos:broader ngm:spatial-computing ;
    vc:enables ngm:immersive-entertainment ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:3-d-asset,
        ngm:avatar,
        ngm:digital-asset,
        ngm:digital-content-creation,
        ngm:nft,
        ngm:rendering-pipeline ;
