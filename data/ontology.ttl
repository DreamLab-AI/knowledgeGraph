# Virtual Currency
spatial-computing:VirtualCurrency rdf:type owl:Class ;
    rdfs:subClassOf spatial-computing:DigitalAsset ;
    rdfs:label "Virtual Currency"@en ;
    rdfs:comment "A digital representation of value that is typically unregulated, issued and controlled by its developers, used and accepted electronically among members of a specific virtual community, including in-game currencies, platform tokens, and convertible digital currencies."@en ;
    skos:prefLabel "Virtual Currency"@en ;
