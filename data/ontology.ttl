        ngm:soft-prompt-embedding,
        ngm:token-embedding ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:slug "embeddings" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:natural-language-processing,
        ngm:transformer .

ngm:embodied-ai-simulation a owl:Class ;
    rdfs:label "Embodied AI Simulation"@en ;
    rdfs:comment "Use of physically accurate virtual environments as training grounds for embodied AI agents and robotic systems. Sim-to-real transfer leverages spatial computing platforms (NVIDIA Omniverse, Isaac Gym, Habitat) to generate synthetic training data, test robot behaviours, and validate control policies before physical deployment."@en ;
    rdfs:subClassOf ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:bridgesTo ngm:robo-navigation-and-planning,
        ngm:robot-learning ;
    vc:enables ngm:robo-actuation-and-control ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:synthetic-data,
        ngm:virtual-environment,
        ngmi:nvidia-omniverse ;
    vc:slug "embodied-ai-simulation" ;
    vc:sourceDomain "spatial-computing" .

ngm:emission-factors a owl:Class ;
    rdfs:label "Emission Factors"@en ;
    rdfs:comment "Emission Factors are coefficients that quantify the average amount of a pollutant—typically greenhouse gases expressed in CO2-equivalent—released per unit of an activity, such as per kilowatt-hour of electricity consumed or per kilometre driven by a particular vehicle class. They are derived from empirical measurement campaigns and modelling studies, and published by bodies such as the IPCC, the IEA, and national environmental agencies. Emission factors are the fundamental input to carbon accounting frameworks such as the GHG Protocol, enabling organisations to calculate their Scope 1, 2, and 3 inventories from activity data. Regular revision of these factors reflects technological change and regional grid decarbonisation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:life-cycle-assessment ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ghg-protocol ],
        ngm:carbon-accounting ;
    vc:enables ngm:carbon-footprint-measurement,
        ngm:environmental-impact-metric ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:carbon-credits,
        ngm:carbon-footprint-assessment,
        ngm:environmental-accounting,
        ngm:sustainability-reporting ;
    vc:requires ngm:ghg-protocol,
        ngm:life-cycle-assessment ;
    vc:slug "emission-factors" ;
    vc:sourceDomain "governance" .

ngm:emission-schedule a owl:Class ;
    rdfs:label "Emission Schedule"@en ;
    rdfs:comment "An Emission Schedule is the predetermined, protocol-encoded timeline that specifies the rate at which new tokens are minted and distributed to participants over the lifetime of a blockchain network. It governs how the total supply of a token expands from genesis toward any eventual supply cap or steady-state inflation rate, directly shaping the economic incentives for validators, miners, and stakers. Well-designed emission schedules balance early bootstrapping of network security with long-term sustainability once adoption is established."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:halving ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:block-reward ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:total-supply ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:consensus-mechanism ],
        ngm:bc-defi-and-economics,
        ngm:blockchain-entity,
        ngm:economic-mechanism ;
    skos:broader ngm:bc-defi-and-economics ;
    vc:enables ngm:incentive-alignment,
        ngm:validator-node ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:block-reward,
        ngm:halving ;
    vc:qualityScore "0.0"^^xsd:float ;
