ngm:meta-learning a owl:Class ;
    rdfs:label "Meta-Learning"@en ;
    rdfs:comment "Meta-Learning, colloquially described as 'learning to learn', is the study and design of machine learning systems that improve their own learning algorithms or initialisation through experience across multiple tasks, enabling rapid adaptation to new tasks with minimal data. Rather than learning a task directly, a meta-learning algorithm learns a prior or inductive bias that facilitates fast generalisation. Key paradigms include model-agnostic meta-learning (MAML), which optimises for a parameter initialisation that is close to good solutions for many tasks, and metric-based approaches such as prototypical networks that learn a task-agnostic embedding space. Meta-learning is central to few-shot learning, continual learning, and automated machine learning research."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gradient-descent ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:training-dataset ],
        ngm:machine-learning-discipline-technique ;
    vc:bridgesTo ngm:drug-discovery,
        ngm:large-language-model ;
    vc:contrastsWith ngm:reinforcement-learning,
        ngm:supervised-learning ;
    vc:enables ngm:automated-machine-learning,
        ngm:continual-learning,
        ngm:few-shot-learning,
        ngm:parameter-efficient-fine-tuning ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:metric-based-meta-learning,
        ngm:model-agnostic-meta-learning,
        ngm:prototypical-networks ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:curriculum-learning,
        ngm:in-context-learning,
        ngm:self-supervised-learning,
        ngm:transfer-learning ;
    vc:requires ngm:gradient-descent,
        ngm:task-distribution,
        ngm:training-dataset ;
    vc:slug "meta-learning" ;
    vc:sourceDomain "machine-learning" ;
    vc:uses ngm:bi-level-optimisation,
        ngm:domain-adaptation,
        ngm:fine-tuning,
        ngm:neural-network .

ngm:metaverse-standards-forum a owl:Class ;
    rdfs:label "Metaverse Standards Forum"@en ;
    rdfs:comment "The Metaverse Standards Forum (MSF) is an industry consortium hosted by the Khronos Group, founded in June 2022, that coordinates existing standards-development organisations to promote interoperability across metaverse and spatial-computing platforms rather than authoring competing specifications. With several hundred member organisations — including Meta, Microsoft, NVIDIA, Sony, Epic Games, the W3C, and ISO — it operates domain-specific working groups that identify interoperability gaps and produce exploratory prototypes whose outputs feed back into recognised bodies for normative ratification. Its model of pre-competitive alignment distinguishes it from traditional specification-writing bodies: it acts as a coordination layer, convening the standards ecosystem to prevent the fragmentation that would result from proprietary, siloed virtual worlds."@en ;
    rdfs:subClassOf ngm:standards-body ;
    vc:bridgesTo ngm:artificial-intelligence,
        ngm:web3 ;
    vc:contrastsWith ngm:closed-platform,
        ngm:proprietary-ecosystem ;
    vc:dependsOn ngm:khronos-group,
        ngm:w3c ;
    vc:enables ngm:cross-platform-avatar,
        ngm:digital-twin,
        ngm:interoperability,
        ngm:open-standard ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:interoperability-prototype,
        ngm:working-group ;
    vc:implements ngm:coordination-layer ;
    vc:isPartOf ngm:open-standards-ecosystem ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:3d-asset-interchange,
        ngm:digital-fashion,
        ngm:technical-standard,
        ngm:web-standard ;
    vc:requires ngm:multi-stakeholder-governance,
        ngm:technical-consensus ;
    vc:slug "metaverse-standards-forum" ;
    vc:sourceDomain "standards" ;
    vc:standardizedBy ngm:ieee,
        ngm:iso ;
    vc:supports ngm:decentralised-identity,
        ngm:extended-reality,
        ngm:spatial-computing,
        ngm:virtual-world ;
    vc:uses ngm:gltf,
        ngm:openxr,
        ngm:usd,
        ngm:webxr .

ngm:mev a owl:Class ;
    rdfs:label "MEV"@en ;
    rdfs:comment "Maximal Extractable Value (MEV) represents the profit that block producers can extract through strategic transaction ordering, inclusion, or exclusion within blocks, arising from their privileged position to control execution sequencing in blockchain networks."@en ;
