blockchain:AsymmetricEncryption rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty infrastructure:implements ;
    owl:someValuesFrom blockchain:EllipticCurveCryptography
] .

# Atomic Swap
blockchain:AtomicSwap rdf:type owl:Class ;
    rdfs:subClassOf blockchain:Blockchain ;
    rdfs:label "Atomic Swap"@en ;
    rdfs:comment "Trustless peer-to-peer cryptocurrency exchange mechanism across different blockchains using Hash Time-Locked Contracts (HTLCs) that guarantees atomic execution where the swap either completes fully or not at all, eliminating counterparty risk without requiring centralized intermediaries."@en ;
    skos:prefLabel "Atomic Swap"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:blockchain:atomic-swap" ;
    owl:sameAs <urn:visionclaw:concept:blockchain:atomic-swap> ;
    vcw:contentHash "sha256-12-20ef46fe2323" ;
    vcw:qualityScore "0.5"^^xsd:decimal ;
    vcw:legacyTermId "BC-8002" ;
    vcw:ontologyStatus "active" ;
    vcw:maturityLevel "draft" ;
    vcw:authorityScore "0.0"^^xsd:decimal ;
    dcterms:identifier "BC-8002" ;
    dcterms:subject "blockchain" ;
    owl:versionInfo "2.0.0" ;
    dcterms:created "2026-04-26T00:00:00Z"^^xsd:dateTime ;
    dcterms:modified "2026-04-26T13:00:00Z"^^xsd:dateTime ;
    vcw:owlRole "Concept" .

blockchain:AtomicSwap rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty infrastructure:enables ;
    owl:someValuesFrom blockchain:CrossChainInteroperability
] .

blockchain:AtomicSwap vcw:bridgesTo blockchain:VirtualEconomy .

blockchain:AtomicSwap rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty infrastructure:implements ;
    owl:someValuesFrom blockchain:HashTimeLockedContract
] .

# Deterministic Finality
blockchain:DeterministicFinality rdf:type owl:Class ;
    rdfs:subClassOf blockchain:Blockchain ;
    rdfs:label "Deterministic Finality"@en ;
    rdfs:comment "Transaction finality achieved through explicit protocol mechanisms in BFT-based consensus systems, providing absolute mathematical guarantee that finalized blocks cannot be reverted. Requires supermajority validator agreement (typically 2/3+) and delivers instant certainty without probabilistic confirmation waiting."@en ;
    skos:prefLabel "Deterministic Finality"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:blockchain:deterministic-finality" ;
    owl:sameAs <urn:visionclaw:concept:blockchain:deterministic-finality> ;
    vcw:contentHash "sha256-12-9372123862a4" ;
    vcw:qualityScore "0.5"^^xsd:decimal ;
    vcw:legacyTermId "BC-8004" ;
    vcw:ontologyStatus "active" ;
    vcw:maturityLevel "draft" ;
    vcw:authorityScore "0.0"^^xsd:decimal ;
    dcterms:identifier "BC-8004" ;
    dcterms:subject "blockchain" ;
    owl:versionInfo "2.0.0" ;
    dcterms:created "2026-04-26T00:00:00Z"^^xsd:dateTime ;
    dcterms:modified "2026-04-26T13:00:00Z"^^xsd:dateTime ;
    vcw:owlRole "Concept" .

blockchain:DeterministicFinality rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty infrastructure:requires ;
    owl:someValuesFrom blockchain:ValidatorSet
] .

blockchain:DeterministicFinality vcw:bridgesTo blockchain:AIAgentSystem .

blockchain:DeterministicFinality vcw:bridgesTo blockchain:VirtualEconomy .

# Gas Optimization
blockchain:GasOptimization rdf:type owl:Class ;
    rdfs:subClassOf blockchain:Blockchain ;
    rdfs:label "Gas Optimization"@en ;
    rdfs:comment "Gas optimization is the systematic reduction of computational resources required for smart contract execution on blockchain networks, achieved through efficient storage patterns, opcode selection, data structure design, and batching strategies to minimise transaction costs and improve economic viability."@en ;
    skos:prefLabel "Gas Optimization"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:blockchain:gas-optimization" ;
    owl:sameAs <urn:visionclaw:concept:blockchain:gas-optimization> ;
