    vc:sourceDomain "security" ;
    vc:supports ngm:audit-logging,
        ngm:multi-tenancy ;
    vc:uses ngm:directory-service .

ngm:semantic-web a owl:Class ;
    rdfs:label "Semantic Web"@en ;
    rdfs:comment "The Semantic Web is an extension of the World Wide Web in which information is given well-defined, machine-readable meaning so that software agents can interpret, combine and reason over data published by different parties. It is realised through a stack of standards including RDF for data modelling, ontologies in OWL for shared vocabularies, and SPARQL for querying. The Semantic Web enables linked data, interoperability and automated inference across distributed sources."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:linked-data ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:metadata ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:sparql ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:rdf ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ontology ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:owl ],
        ngm:knowledge-representation ;
    vc:bridgesTo ngm:knowledge-graph,
        ngm:linked-data ;
    vc:dependsOn ngm:ontology-engineering ;
    vc:enables ngm:data-integration,
        ngm:interoperability,
        ngm:semantic-interoperability ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:linked-data,
        ngm:owl,
        ngm:rdf,
        ngm:sparql ;
    vc:isPartOf ngm:knowledge-representation ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:knowledge-base,
        ngm:natural-language-processing ;
    vc:requires ngm:metadata,
