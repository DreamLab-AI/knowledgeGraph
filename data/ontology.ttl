        ngm:opengl ;
    vc:supports ngm:augmented-reality,
        ngm:metaverse,
        ngm:virtual-reality ;
    vc:uses ngm:compute-shader,
        ngm:procedural-texture,
        ngm:texture-compression .

ngm:tls a owl:Class ;
    rdfs:label "TLS"@en ;
    rdfs:comment "Transport Layer Security (TLS) is an IETF-standardised cryptographic protocol that provides authenticated, confidential, and integrity-protected communication channels over reliable transports such as TCP and QUIC. TLS 1.3 (RFC 8446, 2018) achieves a one-round-trip handshake using ephemeral Diffie-Hellman key exchange with mandatory forward secrecy, encrypting the server certificate within the handshake to prevent passive fingerprinting. It is the security foundation of HTTPS, gRPC, MQTT, SMTP-over-TLS, LDAPS, and virtually every application-layer protocol requiring channel security, with mutual TLS (mTLS) extending the model to bidirectional client and server authentication."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:certificate-authority ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:digital-certificate ],
        ngm:cryptographic-protocol ;
    vc:bridgesTo ngm:blockchain,
        ngm:federated-learning ;
    vc:contrastsWith ngm:ipsec,
        ngm:ssl,
        ngm:wireguard ;
    vc:enables ngm:encrypted-communication,
        ngm:https,
        ngm:mutual-tls,
        ngm:network-security ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:implements ngm:authentication,
        ngm:encryption,
        ngm:forward-secrecy ;
    vc:qualityScore "0.76"^^xsd:float ;
    vc:relatedTo ngm:encrypted-client-hello,
        ngm:post-quantum-cryptography,
        ngm:public-key-cryptography,
        ngm:quic,
        ngm:x509-certificate ;
    vc:requires ngm:certificate-authority,
