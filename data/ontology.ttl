# Gps
robotics:GPS rdf:type owl:Class ;
    rdfs:subClassOf robotics:Robotics ;
    rdfs:subClassOf robotics:NavigationSystem ;
    rdfs:label "Gps"@en ;
    rdfs:comment "**GPS** (Global Positioning System) - A satellite-based Navigation System that determines the absolute geographical location of a robot, providing latitude, longitude, and altitude data for large-scale autonomous navigation, outdoor delivery, and trajectory planning with typical accuracy of 5-15 metres."@en ;
