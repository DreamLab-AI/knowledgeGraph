ngm:numerical-integration a owl:Class ;
    rdfs:comment "Numerical integration is the family of algorithms that approximate definite integrals and advance differential equations in time when closed-form solutions are unavailable. In physics simulation it denotes the time-stepping schemes (such as explicit and implicit Euler, Verlet, and Runge-Kutta methods) that integrate equations of motion to update positions and velocities each frame. The choice of scheme balances accuracy, numerical stability, and computational cost."@en ;
    rdfs:label "Numerical Integration"@en ;
    rdfs:subClassOf ngm:physics-simulation ;
