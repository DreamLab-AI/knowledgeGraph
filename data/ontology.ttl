ngm:delivery-planning a owl:Class ;
    rdfs:label "Delivery Planning"@en ;
    rdfs:comment "Delivery Planning is the structured process of decomposing a technology programme into milestones, tasks, resource assignments, and timelines to ensure coherent execution. In the context of spatial computing and AI platform development, delivery planning coordinates parallel workstreams—GenAI model development, platform infrastructure, digital asset creation, human tracking integration, and USD file format implementation—typically represented as Gantt charts or sprint boards."@en ;
    rdfs:subClassOf ngm:infra-software-engineering ;
    skos:broader ngm:infra-software-engineering ;
    vc:dependsOn ngm:collaboration ;
    vc:enables ngm:development-platform ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:slug "delivery-planning" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:digital-infrastructure,
        ngm:digital-twin ;
    vc:uses ngm:ai-agent-system,
        ngm:digital-platform .

