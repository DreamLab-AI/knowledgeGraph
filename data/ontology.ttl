    rdfs:label "Process Calculus"@en .
ngm:process-control a owl:Class ;
    rdfs:comment "Process control is the discipline of regulating continuous industrial processes, such as chemical reactions, temperature, flow, and pressure, to maintain outputs at desired setpoints despite disturbances. It relies on sensors, controllers, and actuators arranged in feedback loops, using techniques from PID control to model predictive control. It is fundamental to manufacturing, energy, and process-industry automation."@en ;
    rdfs:label "Process Control"@en ;
    rdfs:subClassOf ngm:control-system ;
