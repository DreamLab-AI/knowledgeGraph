    vc:slug "spatial-index" ;
    vc:sourceDomain "spatial-computing" .

ngm:spatial-tracking a owl:Class ;
    rdfs:label "Spatial Tracking"@en ;
    rdfs:comment "Technology that determines the position and orientation of objects in three-dimensional space using six degrees of freedom (6DoF), enabling precise tracking of headsets, controllers, and body movements through inside-out or outside-in sensor configurations."@en ;
    rdfs:subClassOf ngm:sc-interaction ;
    skos:broader ngm:sc-interaction ;
