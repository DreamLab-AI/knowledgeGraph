ngm:rb-0008-autonomous-robot a owl:Class ;
    rdfs:label "rb 0008 autonomous robot"@en ;
    rdfs:comment "An autonomous robot is a robotic system capable of performing tasks in unstructured environments without continuous human intervention, relying on onboard sensing, perception, decision-making, and actuation. Autonomy spans a spectrum from simple programmed responses to full cognitive agency; key enabling technologies include SLAM, path planning, machine learning-based perception, and safety-certified control architectures."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:perception-system ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:rb-0089-risk-assessment ],
        ngm:robo-robot-type ;
    skos:broader ngm:robo-robot-type ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:autonomous-navigation,
        ngm:autonomous-system,
        ngm:rb-0007-collaborative-robot,
        ngm:rb-0012-wheeled-mobile-robot ;
    vc:requires ngm:perception-system,
        ngm:rb-0089-risk-assessment ;
    vc:slug "rb-0008-autonomous-robot" ;
    vc:sourceDomain "robotics" ;
    vc:supports ngm:rb-0096-safeguarding ;
    vc:uses ngm:machine-learning-discipline,
        ngm:rb-0049-motion-planning,
        ngm:slam .

ngm:rb-0017-rescue-robot a owl:Class ;
    rdfs:label "rb 0017 rescue robot"@en ;
    rdfs:comment "A rescue robot is a mobile robotic system specifically designed or adapted for deployment in disaster, emergency, or hazardous environments where direct human access is dangerous or impossible. Rescue robots perform tasks such as victim search-and-detection, structural reconnaissance, rubble traversal, gas sensing, and teleoperated manipulation of debris. They typically integrate rugged locomotion systems (tracked, legged, or serpentine), multiple sensor modalities (thermal, depth camera, LIDAR, gas detectors), and semi-autonomous navigation with human-on-the-loop teleoperation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:obstacle-avoidance ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:autonomous-navigation ],
        ngm:mobile-robot,
        ngm:robo-robot-type ;
    skos:broader ngm:robo-robot-type ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:mobile-robot-platform,
        ngm:rb-0008-autonomous-robot,
        ngm:rb-0018-inspection-robot ;
    vc:requires ngm:autonomous-navigation,
        ngm:obstacle-avoidance ;
    vc:slug "rb-0017-rescue-robot" ;
    vc:sourceDomain "robotics" ;
    vc:supports ngm:rescue-robot,
        ngm:swarm-robotics ;
    vc:uses ngm:rb-0069-lidar,
        ngm:rb-0077-depth-camera,
        ngm:slam .

ngm:rb-0018-inspection-robot a owl:Class ;
    rdfs:label "rb 0018 inspection robot"@en ;
    rdfs:comment "An inspection robot is a mobile robotic system designed to autonomously or semi-autonomously navigate environments that are hazardous, inaccessible, or inefficient for human workers, in order to assess the structural, mechanical, or operational condition of infrastructure, equipment, or facilities. Equipped with sensor arrays (cameras, LiDAR, ultrasonic, thermal IR), inspection robots collect data for predictive maintenance, safety auditing, and non-destructive testing across industries such as oil and gas pipelines, power-grid infrastructure, bridges, and confined industrial spaces."@en ;
    rdfs:subClassOf ngm:mobile-robot,
        ngm:robo-robot-type ;
    skos:broader ngm:robo-robot-type ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:autonomous-robot,
        ngm:rb-0012-wheeled-mobile-robot,
        ngm:rb-0017-rescue-robot ;
    vc:slug "rb-0018-inspection-robot" ;
    vc:sourceDomain "robotics" ;
    vc:supports ngm:rb-0089-risk-assessment ;
    vc:uses ngm:rb-0066-robot-sensor,
        ngm:rb-0068-vision-system,
        ngm:rb-0069-lidar,
        ngm:rb-0078-infrared-sensor .

ngm:rb-0065-visual-servoing a owl:Class ;
    rdfs:label "rb 0065 visual servoing"@en ;
    rdfs:comment "Visual servoing is a robot control technique that uses real-time visual feedback from a camera to regulate the motion of a robot toward a goal configuration. Image-based visual servoing (IBVS) minimises an image-feature error directly, while position-based visual servoing (PBVS) reconstructs 3-D pose from vision before computing Cartesian control signals. The approach is widely used in manipulation, assembly, and tracking tasks where precise end-effector placement relative to a visually perceived target is required."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:rb-0030-jacobian-matrix ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:rb-0047-feedback-control ],
        ngm:feedback-control,
        ngm:robo-perception ;
    skos:broader ngm:robo-perception ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:object-detection,
        ngm:pose-estimation,
        ngm:rb-0064-computed-torque-control ;
    vc:requires ngm:rb-0030-jacobian-matrix,
        ngm:rb-0047-feedback-control ;
    vc:slug "rb-0065-visual-servoing" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:computer-vision,
        ngm:feature-extraction,
        ngm:rb-0068-vision-system .

ngm:rb-0070-tactile-sensing a owl:Class ;
    rdfs:label "rb 0070 tactile sensing"@en ;
    rdfs:comment "Tactile sensing is the robotic capability to detect and measure contact forces, pressures, textures, and slip at points of physical interaction between the robot and its environment or human operators. Realised through arrays of pressure sensors, capacitive skins, or piezoelectric films distributed across end-effectors and link surfaces, tactile sensing enables compliant grasping, contact-triggered safety stops, and rich feedback for teleoperation. It is a key enabling technology for human-robot collaboration under ISO/TS 15066."@en ;
    rdfs:subClassOf ngm:robo-perception,
        ngm:tactile-sensor ;
    skos:broader ngm:robo-perception ;
    vc:enables ngm:collaborative-systems-modality-operation,
        ngm:haptic-feedback,
        ngm:rb-0092-protective-stop ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:force-control,
        ngm:sensor-fusion ;
    vc:slug "rb-0070-tactile-sensing" ;
    vc:sourceDomain "robotics" ;
    vc:standardizedBy ngm:iso-ts-15066 ;
    vc:uses ngm:force-torque-sensor,
        ngm:pressure-sensor .

ngm:rb-0080-radar a owl:Class ;
    rdfs:label "rb 0080 radar"@en ;
    rdfs:comment "Radar (Radio Detection and Ranging) is an active sensing technology that emits radio-frequency electromagnetic pulses and detects reflected returns to measure the range, velocity, and bearing of objects in the environment. In robotics, radar sensors provide reliable obstacle detection and velocity estimation across diverse weather and lighting conditions where cameras and LiDAR may degrade, making them particularly valuable for autonomous ground vehicles, drones, and safety-critical proximity monitoring in industrial settings."@en ;
    rdfs:subClassOf ngm:robo-perception ;
    skos:broader ngm:robo-perception ;
    vc:bridgesTo ngm:sensor ;
    vc:contrastsWith ngm:rb-0077-depth-camera ;
    vc:enables ngm:object-detection,
        ngm:proximity-detection,
        ngm:rb-0052-collision-avoidance ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:rb-0066-robot-sensor,
        ngm:rb-0069-lidar,
        ngm:rb-0075-range-finder,
        ngm:sensor-fusion ;
    vc:slug "rb-0080-radar" ;
    vc:sourceDomain "robotics" .

