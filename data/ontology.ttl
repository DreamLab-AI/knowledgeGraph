    rdfs:label "Embodiment"@en .

ngm:encryption-protocol a owl:Class ;
    rdfs:label "Encryption Protocol"@en ;
    rdfs:comment "An Encryption Protocol is a defined set of rules and message exchanges that uses cryptographic algorithms to establish keys and protect the confidentiality and integrity of data in transit or at rest. It specifies handshakes, cipher negotiation, key exchange, and authentication so that interoperating parties can communicate securely. TLS 1.3 is a widely deployed example securing internet traffic."@en ;
    rdfs:subClassOf ngm:cryptographic-protocol ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:cybersecurity-standard,
        ngm:tls-1-3 ;
    vc:slug "encryption-protocol" ;
    vc:sourceDomain "security" .

ngm:end-to-end-learning a skos:Concept ;
    rdfs:label "End To End Learning"@en .

ngm:ens-dao a owl:Class ;
    rdfs:label "ENS DAO"@en ;
    rdfs:comment "ENS DAO is the decentralised autonomous organisation that governs the Ethereum Name Service (ENS), the primary naming infrastructure for the Ethereum ecosystem, using the ENS governance token ($ENS) to enable token-weighted voting on protocol upgrades, treasury allocation, and price oracle parameter changes through a Governor Bravo-compatible on-chain governance contract. Established in November 2021 via a retroactive airdrop of 25 million ENS tokens to historical registrants and contributors, the DAO holds a treasury of tens of millions of dollars in ETH and ENS, oversees the root multi-sig controlling the ENS root keys, and appoints stewards for working groups covering Meta-Governance, Ecosystem, Public Goods, and Community operations. ENS DAO represents one of the largest and most active protocol DAOs by voter participation and treasury size."@en ;
    rdfs:subClassOf ngm:dao ;
    vc:enables ngm:blockchain-governance,
        ngm:dao-governance,
        ngm:decentralised-decision-making ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:decentralized-identity,
        ngm:digital-identity,
        ngm:ens,
        ngm:on-chain-governance ;
    vc:slug "ens-dao" ;
    vc:sourceDomain "governance" ;
    vc:uses ngm:compound-governor-bravo,
        ngm:governance-token,
        ngm:snapshot-voting,
        ngm:timelock-controller .

ngm:enterprise-automation a owl:Class ;
    rdfs:label "Enterprise Automation"@en ;
    rdfs:comment "Enterprise automation is the application of software and AI to execute repeatable business processes with minimal human intervention across an organisation. It combines techniques such as robotic process automation, workflow orchestration, business rules engines, and increasingly AI agents that handle unstructured tasks. The goal is to reduce cost, error rates, and cycle time while freeing human workers for higher-value activity."@en ;
    rdfs:subClassOf ngm:ai-application ;
    skos:broader ngm:ai-application ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
