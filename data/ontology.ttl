    vc:slug "synthetix" ;
    vc:sourceDomain "blockchain" .

ngm:task-adaptation a owl:Class ;
    rdfs:label "Task Adaptation"@en ;
    rdfs:comment "The process of specialising a pre-trained or general-purpose machine learning model to perform well on a specific downstream task by adjusting its parameters, architecture, or inference behaviour. Task adaptation encompasses techniques such as fine-tuning, instruction tuning, prompt engineering, and parameter-efficient methods (LoRA, adapters) that bridge the gap between a model's pre-training distribution and the requirements of a target application."@en ;
    rdfs:subClassOf ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:contrastsWith ngm:federated-learning ;
    vc:dependsOn ngm:machine-learning-model,
