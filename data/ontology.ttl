        ngm:instant-ngp ;
    vc:requires ngm:camera-calibration,
        ngm:differentiable-rendering,
        ngm:structure-from-motion ;
    vc:slug "neural-radiance-field" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:gradient-descent,
        ngm:ray-marching,
        ngm:volume-rendering .

ngm:nostr-protocol a owl:Class ;
    rdfs:label "Nostr Protocol"@en ;
    rdfs:comment "Nostr (Notes and Other Stuff Transmitted by Relays) is a minimalist open protocol for censorship-resistant, decentralised messaging and identity, in which clients sign events with Schnorr Signatures|Schnorr signatures over the secp256k1 elliptic curve and broadcast them to any number of s..."@en ;
