    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:monte-carlo-integration ;
    vc:slug "sequential-monte-carlo" ;
    vc:sourceDomain "metaverse" .

ngm:sha-256-hashing a owl:Class ;
    rdfs:label "SHA-256 Hashing"@en ;
    rdfs:comment "SHA-256 Hashing refers to the application of the SHA-256 (Secure Hash Algorithm 256-bit) cryptographic hash function — a member of the SHA-2 family standardised by NIST in 2001 — to produce a fixed-length 256-bit (32-byte) message digest from an arbitrary-length input, with the properties of determinism, pre-image resistance, second pre-image resistance, and collision resistance. The algorithm operates via 64 rounds of bit manipulation, modular addition, and nonlinear functions over a 512-bit block schedule. SHA-256 is the foundational hash function of Bitcoin's proof-of-work mining, block header commitments, and Merkle tree construction, as well as a critical primitive in TLS, code signing, and certificate transparency."@en ;
    rdfs:subClassOf ngm:cryptographic-hash-function ;
    vc:enables ngm:bitcoin-proof-of-work-protocol-mining,
        ngm:data-integrity,
        ngm:merkle-proof ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:merkle-tree,
        ngm:proof-of-work,
        ngm:sha-256 ;
    vc:slug "sha-256-hashing" ;
    vc:sourceDomain "security" ;
    vc:uses ngm:blockchain-security,
        ngm:cryptographic-hash .

ngm:sha-3 a owl:Class ;
    rdfs:label "SHA-3"@en ;
    rdfs:comment "SHA-3 is a family of cryptographic hash functions standardised by NIST in FIPS 202, based on the Keccak sponge construction rather than the Merkle-Damgaard design of SHA-2. Its sponge structure provides strong resistance to length-extension attacks and offers configurable output lengths and extendable-output functions. It is used as a collision-resistant primitive in digital signatures and integrity verification."@en ;
    rdfs:subClassOf ngm:cryptographic-primitive ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:cryptography-security-and-privacy,
        ngm:digital-signature ;
    vc:slug "sha-3" ;
    vc:sourceDomain "security" .

ngm:sigma-algebra a owl:Class ;
    rdfs:label "Sigma-Algebra"@en ;
    rdfs:comment "A sigma-algebra is a collection of subsets of a sample space that contains the whole space and is closed under complementation and countable unions. It specifies exactly which sets are measurable, providing the domain on which measures and probability are rigorously defined. It is the structural foundation of measure theory, integration, and the theory of stochastic processes."@en ;
    rdfs:subClassOf ngm:optimisation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:measure-theory,
        ngm:stochastic-process ;
    vc:slug "sigma-algebra" ;
    vc:sourceDomain "data" .

ngm:signal-protocol a owl:Class ;
    rdfs:label "Signal Protocol"@en ;
    rdfs:comment "Signal Protocol is an open-source cryptographic messaging protocol that provides end-to-end encryption for instant messaging applications, combining the Double Ratchet Algorithm with the X3DH (Extended Triple Diffie-Hellman) key agreement protocol. It achieves forward secrecy and break-in recovery (future secrecy) by continuously rotating encryption keys after each message exchange."@en ;
    rdfs:subClassOf ngm:secure-messaging ;
    vc:bridgesTo ngm:decentralised-identity,
        ngm:federated-messaging ;
    vc:contrastsWith ngm:pgp-encryption,
        ngm:transport-layer-security ;
    vc:dependsOn ngm:cryptography,
        ngm:knowledge-graph-publication-classifier-key-cryptography ;
    vc:enables ngm:asynchronous-encrypted-communication,
        ngm:private-messaging ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:deniable-authentication,
        ngm:forward-secrecy,
        ngm:post-compromise-security ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:kyber-kem,
        ngm:messaging-layer-security,
        ngm:noise-protocol,
        ngm:pqxdh ;
    vc:requires ngm:public-key-infrastructure,
        ngm:x3dh-key-agreement ;
    vc:slug "signal-protocol" ;
    vc:sourceDomain "security" ;
    vc:uses ngm:aes-gcm,
