        ngm:technical-committee ;
    vc:slug "etsi" ;
    vc:sourceDomain "standards" ;
    vc:supports ngm:5g,
        ngm:edge-computing,
        ngm:quantum-safe-cryptography,
        ngm:zero-trust-architecture .

ngm:hardware a owl:Class ;
    rdfs:label "Hardware"@en ;
    rdfs:comment "Hardware denotes the physical, tangible components of a computing system — processors, memory modules, storage devices, input/output peripherals, power subsystems, and interconnects — that collectively provide the substrate on which software executes. In the spatial-computing and infrastructure context it encompasses both general-purpose devices (CPUs, GPUs, FPGAs, ASICs) and specialised sensors and actuators (depth cameras, inertial measurement units, haptic controllers, head-mounted displays) that enable immersive and intelligent workloads. Hardware capability sets the fundamental performance, latency, power, and thermal envelope that software stacks must respect, making hardware design decisions inseparable from system architecture, operating-system abstractions, and application-level trade-offs. The discipline spans semiconductor fabrication, PCB design, embedded firmware, hardware security primitives, and the standards that allow heterogeneous devices to interoperate."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:sensor ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:gpu-compute ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:operating-system ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:hardware-component ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:power-management ],
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:bridgesTo ngm:neural-processing-unit,
        ngm:trusted-execution-environment ;
    vc:contrastsWith ngm:software,
        ngm:virtual-machine ;
    vc:dependsOn ngm:semiconductor-fabrication,
        ngm:supply-chain ;
    vc:enables ngm:edge-computing,
        ngm:embedded-systems,
        ngm:hardware-acceleration,
        ngm:on-device-inference,
        ngm:real-time-rendering ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:central-processing-unit,
        ngm:gpu-compute,
        ngm:hardware-component,
        ngm:memory-subsystem,
        ngm:sensor,
        ngm:storage-device ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:firmware,
        ngm:hardware-abstraction,
        ngm:hardware-and-edge,
        ngm:hardware-security-module ;
    vc:requires ngm:device-driver,
        ngm:operating-system,
        ngm:power-management ;
    vc:slug "hardware" ;
    vc:sourceDomain "spatial-computing" ;
    vc:standardizedBy ngm:ieee,
        ngm:jedec ;
    vc:supports ngm:artificial-intelligence,
        ngm:augmented-reality,
        ngm:robotics,
        ngm:virtual-reality .

ngm:message-broker a owl:Class ;
    rdfs:label "Message Broker"@en ;
    rdfs:comment "A message broker is an intermediary software component that translates messages between disparate messaging protocols and routes them between producers and consumers, decoupling the two sides of a communication so that neither needs direct knowledge of the other. It typically provides guaranteed delivery, message queuing, routing rules, protocol translation, and persistence semantics."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:network-protocol ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:persistent-storage ],
        ngm:middleware ;
    vc:bridgesTo ngm:iot-platform,
        ngm:multi-agent-system ;
    vc:contrastsWith ngm:enterprise-service-bus,
        ngm:remote-procedure-call ;
    vc:enables ngm:asynchronous-messaging,
        ngm:event-streaming,
        ngm:loose-coupling,
        ngm:microservices-architecture ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:dead-letter-queue,
        ngm:routing-rule,
        ngm:topic ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:apache-kafka,
        ngm:apache-pulsar,
        ngm:event-driven-architecture,
        ngm:event-sourcing,
        ngm:rabbitmq ;
    vc:requires ngm:network-protocol,
        ngm:persistent-storage ;
    vc:slug "message-broker" ;
    vc:sourceDomain "infrastructure" ;
    vc:standardizedBy ngm:amqp ;
    vc:uses ngm:amqp,
        ngm:message-queue,
        ngm:mqtt,
        ngm:publish-subscribe-pattern .

ngm:message-queue a owl:Class ;
    rdfs:label "Message Queue"@en ;
    rdfs:comment "A Message Queue is a durable, ordered buffer that mediates asynchronous inter-process communication, allowing producers to enqueue messages independently of consumers reading them, thereby decoupling components in both time and topology. Messages are persisted by a broker until a consumer retrieves and acknowledges them, with delivery semantics ranging from at-most-once through at-least-once to exactly-once, each trading throughput for reliability. Message queues are foundational to event-driven architectures, microservices integration, and distributed data pipelines, absorbing traffic spikes, enabling backpressure management, and improving system resilience against partial failures. Implementations range from lightweight in-process task queues to enterprise-grade distributed log brokers such as Apache Kafka, RabbitMQ, and Amazon SQS."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:message-broker ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:persistence-layer ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:message-broker ],
        ngm:distributed-systems ;
    vc:bridgesTo ngm:agent-event-stream,
        ngm:stream-processing ;
    vc:contrastsWith ngm:remote-procedure-call,
        ngm:synchronous-communication ;
    vc:dependsOn ngm:distributed-systems,
        ngm:network-protocol ;
    vc:enables ngm:backpressure-management,
        ngm:data-pipeline,
        ngm:event-driven-architecture,
        ngm:load-levelling,
        ngm:microservices-architecture ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:consumer-group,
        ngm:dead-letter-queue,
        ngm:message-broker ;
    vc:implements ngm:competing-consumers-pattern,
        ngm:producer-consumer-pattern ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:apache-kafka,
        ngm:cloud-computing,
        ngm:data-integration,
        ngm:event-sourcing,
        ngm:rabbitmq ;
    vc:requires ngm:message-broker,
        ngm:persistence-layer ;
    vc:slug "message-queue" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:fault-tolerance,
        ngm:horizontal-scalability,
        ngm:service-decoupling ;
    vc:uses ngm:asynchronous-communication,
        ngm:publish-subscribe-pattern,
        ngm:serialisation .

ngm:neural-network-architecture a owl:Class ;
    rdfs:label "Neural Network Architecture"@en ;
    rdfs:comment "Neural network architecture defines the structural organisation of artificial neurons into layers and the connectivity patterns between them, determining how a network processes and transforms input data through weighted connections and activation functions. Different architectural families — feedforward, convolutional, recurrent, and transformer — embody distinct inductive biases suited to different data modalities and task types. Architectural choices govern capacity, training stability, and generalisation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:convolutional-neural-network ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:transformer-architecture ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:attention-mechanism ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:recurrent-neural-network ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:backpropagation ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:activation-function ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:loss-function ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:dropout ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gradient-descent ],
        ngm:ai-model-architecture ;
    skos:broader ngm:ai-model-architecture ;
    vc:enables ngm:computer-vision,
        ngm:deep-learning,
        ngm:natural-language-processing,
        ngm:transfer-learning ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:activation-function,
        ngm:attention-mechanism,
        ngm:convolutional-neural-network,
        ngm:dropout,
        ngm:recurrent-neural-network,
        ngm:transformer-architecture ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:generative-adversarial-network,
        ngm:machine-learning-discipline,
        ngm:reinforcement-learning ;
    vc:requires ngm:backpropagation,
        ngm:gradient-descent,
        ngm:loss-function ;
    vc:slug "neural-network-architecture" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:hyperparameter,
        ngm:model-training .

ngm:nft-marketplace a owl:Class ;
    rdfs:label "NFT Marketplace"@en ;
    rdfs:comment "A digital platform enabling the creation, listing, buying, selling, and auctioning of non-fungible tokens (NFTs). NFT marketplaces provide discovery, escrow, royalty enforcement, and settlement infrastructure for unique digital assets, typically integrating smart contracts for trustless ownership transfer and on-chain provenance tracking."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:nft-minting ],
        [ a owl:Restriction ;
