    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:edge-computing ;
    vc:uses ngm:signal-processing .

ngm:working-memory a owl:Class ;
    rdfs:label "Working Memory"@en ;
    rdfs:comment "Working memory is the short-lived, actively maintained store an agent uses to hold and manipulate the information relevant to its current task. In large-language-model agents it is realised through the context window, intermediate reasoning traces, and scratchpads, augmented by external stores when the active context is insufficient. It is distinguished from long-term memory by its limited capacity, volatility, and tight coupling to ongoing reasoning."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:attention-mechanism ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:context-window ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:attention-mechanism ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:context-window ],
        ngm:cognitive-architecture ;
    vc:dependsOn ngm:context-window ;
    vc:enables ngm:planning,
        ngm:reasoning,
        ngm:tool-use ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:attention-mechanism,
        ngm:context-window ;
    vc:isPartOf ngm:ai-agent,
        ngm:cognitive-architecture ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:large-language-model,
        ngm:recurrent-neural-network,
        ngm:transformer ;
