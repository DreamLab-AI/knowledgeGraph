ngm:virtual-office-spaces a owl:Class ;
    rdfs:label "Virtual Office Spaces"@en ;
    rdfs:comment "Virtual office spaces are persistent 3D environments hosted on VR or metaverse platforms where distributed teams gather as avatars to collaborate, attend meetings, use shared whiteboards, and navigate spatial office layouts, replicating physical workplace social dynamics whilst enabling global remote participation through immersive telepresence. Unlike transient video calls, these environments preserve spatial context across sessions — desks remain assigned, whiteboards retain content, and colleagues can be discovered by proximity cues. Leading implementations include Microsoft Mesh, Meta Horizon Workrooms, and Spatial."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:extended-reality ],
        ngm:dc-workspace-tools,
        ngm:virtual-environment ;
    skos:broader ngm:dc-workspace-tools ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:distributed-collaboration,
        ngm:telecollaboration ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:digital-twin,
        ngm:mixed-reality,
        ngm:remote-collaboration,
        ngm:social-vr ;
    vc:requires ngm:extended-reality ;
    vc:slug "virtual-office-spaces" ;
    vc:sourceDomain "distributed-collaboration" ;
    vc:uses ngm:avatar-system,
        ngm:presence,
        ngm:spatial-audio,
        ngm:virtual-reality .

ngm:virtual-replica a owl:Class ;
    rdfs:label "Virtual Replica"@en ;
    rdfs:comment "A digital representation of a physical object, system, or environment created through 3D modelling, photogrammetry, or LiDAR scanning, serving as a static or dynamic copy for visualisation, simulation, analysis, and testing without the real-time bidirectional data connectivity that distinguishes a full digital twin. Virtual replicas are typically point-in-time snapshots; they support heritage preservation, product safety testing, urban planning, and manufacturing visualisation workflows."@en ;
    rdfs:subClassOf ngm:digital-model,
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:contrastsWith ngm:digital-twin ;
