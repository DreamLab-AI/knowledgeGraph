    vc:relatedTo ngm:fault-tolerance ;
    vc:relatedTo ngm:quorum ;
    vc:requires ngm:consensus-protocol ;
    vc:requires ngm:leader-election ;
    vc:slug "partial-synchrony" ;
    vc:sourceDomain "distributed-systems" ;
    vc:supports ngm:paxos ;
    vc:supports ngm:raft ;
    vc:supports ngm:tendermint ;
    vc:uses ngm:gossip-protocol .
