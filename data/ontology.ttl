ngm:data-link-layer a owl:Class ;
    rdfs:label "Data Link Layer"@en ;
    rdfs:comment "The data link layer is the second layer of the OSI model, responsible for node-to-node data transfer across a single physical link and for framing raw bits from the physical layer into structured frames. It provides addressing through hardware (MAC) addresses, error detection, and media access control that arbitrates shared transmission media. By presenting a reliable link to the network layer above, it abstracts away the imperfections of the underlying physical medium."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:physical-layer ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:ethernet ],
        ngm:osi-model ;
    vc:contrastsWith ngm:network-layer ;
    vc:enables ngm:ethernet,
        ngm:network-protocol ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:ethernet ;
    vc:isPartOf ngm:osi-model ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:network-layer,
        ngm:network-protocol,
        ngm:tcp-ip ;
    vc:requires ngm:physical-layer ;
    vc:slug "data-link-layer" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:infrastructure,
        ngm:network-layer .

ngm:decentralized-identity-foundation a owl:Class ;
    rdfs:label "Decentralized Identity Foundation"@en ;
    rdfs:comment "The Decentralized Identity Foundation (DIF) is an open industry consortium founded in 2017 that develops interoperable specifications, protocols, and reference implementations for decentralised digital identity systems. It produces foundational work items including the Presentation Exchange specification, the Decentralized Web Node (DWN) protocol for identity-linked personal data storage, the DIDComm messaging protocol, and the Sidetree protocol family for scalable DID method implementations. DIF operates as a coordination layer complementing W3C standards bodies, bridging specification gaps between DID methods, verifiable credential formats, and identity wallet implementations. Its outputs are adopted in major identity frameworks including the European Union Digital Identity (EUDI) Wallet Architecture Reference Framework."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:sidetree-protocol ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:public-key-infrastructure ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptographic-key-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:didcomm ],
        ngm:standards-body ;
    vc:bridgesTo ngm:eudi-wallet,
        ngm:identity-verification ;
    vc:contrastsWith ngm:centralised-identity,
        ngm:federated-identity ;
    vc:enables ngm:decentralized-identifier,
        ngm:did-document,
        ngm:self-sovereign-identity,
        ngm:verifiable-credentials ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:decentralized-web-node,
        ngm:didcomm,
        ngm:presentation-exchange,
        ngm:sidetree-protocol ;
    vc:implements ngm:w-3-c-verifiable-credentials-data-model,
        ngm:w3-c-did-core ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:blockchain,
        ngm:trust-framework,
        ngm:zero-knowledge-proof ;
    vc:requires ngm:cryptographic-key-management,
        ngm:public-key-infrastructure ;
    vc:slug "decentralized-identity-foundation" ;
    vc:sourceDomain "blockchain" ;
    vc:standardizedBy ngm:open-id-foundation,
        ngm:world-wide-web-consortium ;
    vc:supports ngm:digital-identity,
        ngm:identity,
        ngm:privacy-preserving-computation .

ngm:deepfake-detection a owl:Class ;
    rdfs:label "Deepfake Detection"@en ;
    rdfs:comment "Deepfake detection is the application of machine learning and signal processing techniques to identify synthetic or manipulated media—including face-swapped video, voice-cloned audio, and AI-generated images—by analysing artefacts, inconsistencies, and statistical signatures that distinguish fabricated from authentic content. It operates as a countermeasure to generative adversarial networks and related synthesis methods."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:computer-vision-video-analysis ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:training-dataset ],
        ngm:computer-vision ;
    vc:bridgesTo ngm:ai-regulation,
        ngm:c2-pa ;
    vc:contrastsWith ngm:deepfakes,
        ngm:generative-adversarial-network,
        ngm:synthetic-media ;
    vc:dependsOn ngm:deep-learning,
        ngm:signal-processing ;
    vc:enables ngm:content-authentication,
        ngm:content-authenticity,
        ngm:media-forensics ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:diffusion-model,
        ngm:generative-ai ;
    vc:requires ngm:computer-vision-video-analysis,
        ngm:training-dataset ;
    vc:slug "deepfake-detection" ;
    vc:sourceDomain "ai" ;
    vc:supports ngm:content-provenance,
        ngm:trust-and-safety ;
    vc:uses ngm:convolutional-neural-network,
        ngm:face-recognition,
        ngm:machine-learning-discipline,
        ngm:neural-network,
        ngm:vision-transformer .

ngm:deflationary-token a owl:Class ;
    rdfs:label "Deflationary Token"@en ;
    rdfs:comment "A Deflationary Token is a cryptocurrency or blockchain token whose total circulating supply decreases over time through one or more programmatic burning mechanisms—such as transaction fee burns, scheduled buyback-and-burn events, or protocol-level token destruction—creating supply-side scarcity intended to exert upward price pressure and incentivise long-term holding."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:on-chain-governance ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:consensus-mechanism ],
        ngm:bc-token-and-asset,
        ngm:blockchain-entity,
        ngm:economic-mechanism ;
    skos:broader ngm:bc-token-and-asset ;
    vc:bridgesTo ngm:decentralized-finance,
        ngm:non-fungible-token,
        ngm:virtual-economy ;
    vc:contrastsWith ngm:inflationary-token,
        ngm:native-token,
        ngm:stablecoin ;
    vc:dependsOn ngm:distributed-ledger,
        ngm:token-standard ;
    vc:enables ngm:economic-incentive ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:blockchain,
        ngm:token-economics ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:blockchain-economics,
        ngm:governance-token,
        ngm:monetary-policy,
        ngm:scarcity,
        ngm:store-of-value,
        ngm:token-economics,
        ngm:tokenomics,
        ngm:transaction-fee ;
    vc:requires ngm:consensus-mechanism,
        ngm:on-chain-governance ;
    vc:slug "deflationary-token" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:burning-mechanism,
        ngm:proof-of-work,
        ngm:smart-contract,
        ngm:supply-cap .

ngm:delivery-versus-payment a owl:Class ;
    rdfs:label "Delivery-Versus-Payment"@en ;
    rdfs:comment "Delivery-Versus-Payment (DvP) is a securities settlement mechanism that links the transfer of a financial instrument to the simultaneous transfer of payment, ensuring that delivery occurs if and only if payment occurs, thereby eliminating principal risk in securities transactions. It is the standard settlement model mandated or strongly encouraged by financial market infrastructures globally."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:financial-infrastructure ],
        ngm:payment-system ;
    vc:enables ngm:custody-infrastructure,
        ngm:digital-asset-trading ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:digital-asset-market ;
    vc:requires ngm:financial-infrastructure ;
    vc:slug "delivery-versus-payment" ;
    vc:sourceDomain "finance" ;
    vc:uses ngm:atomic-swap,
        ngm:digital-asset .

ngm:denavit-hartenberg-parameters a owl:Class ;
    rdfs:label "Denavit-Hartenberg Parameters"@en ;
    rdfs:comment "Denavit-Hartenberg (DH) parameters are a standardised four-parameter convention for describing the relative geometry between consecutive links of a robotic manipulator. Each joint is characterised by link length, link twist, link offset, and joint angle, yielding a homogeneous transformation matrix per joint. Chaining these matrices gives a compact, systematic model of the arm's kinematics."@en ;
    rdfs:subClassOf ngm:control-theory ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:forward-kinematics,
        ngm:kinematics-model ;
    vc:slug "denavit-hartenberg-parameters" ;
    vc:sourceDomain "robotics" .

ngm:digital-identity-management a owl:Class ;
    rdfs:label "Digital Identity Management"@en ;
    rdfs:comment "The systems, processes, and technologies for creating, maintaining, and verifying digital representations of individuals and entities across virtual environments, incorporating self-sovereign identity principles, decentralized identifiers, and verifiable credentials for secure cross-platform authentication."@en ;
