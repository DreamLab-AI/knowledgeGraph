ngm:dlss a owl:Class ;
    rdfs:label "DLSS"@en ;
    rdfs:comment "DLSS (Deep Learning Super Sampling) is NVIDIA's family of AI-based rendering techniques that use neural networks running on dedicated tensor hardware to reconstruct high-resolution, high-frame-rate images from lower-resolution rendered inputs. By upscaling, accumulating temporal information, and generating intermediate frames, DLSS delivers image quality approaching or exceeding native rendering at a fraction of the GPU cost, enabling demanding effects such as real-time ray tracing to run smoothly. It exemplifies the integration of learned models into the real-time graphics pipeline."@en ;
    rdfs:subClassOf ngm:rendering-technology ;
    vc:enables ngm:real-time-rendering ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:neural-rendering,
        ngm:rendering-pipeline ;
    vc:slug "dlss" ;
    vc:sourceDomain "graphics" ;
    vc:uses ngm:deep-learning,
        ngm:gpu .

ngm:dlt a owl:Class ;
    rdfs:label "DLT"@en ;
    rdfs:comment "Distributed Ledger Technology (DLT) is a class of systems in which transaction records are replicated, shared, and synchronised across multiple nodes without a single central authority. Blockchains are one form of DLT, but the term also covers directed-acyclic-graph and other non-chained ledger structures. DLT underpins many digital-asset and central-bank-digital-currency designs because it provides tamper-evidence, auditability, and resilience."@en ;
    rdfs:subClassOf ngm:distributed-data-structure ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:cbdc-frameworks,
        ngm:cbdcs ;
    vc:slug "dlt" ;
    vc:sourceDomain "blockchain" .

ngm:domain-access-control a owl:Class ;
    rdfs:label "Domain Access Control"@en ;
    rdfs:comment "Domain Access Control is the set of mechanisms that govern which users, avatars, or services may enter, view, or modify resources within a bounded virtual-world domain or server cluster. In metaverse platforms it enforces ownership and permission boundaries at the level of a hosted domain, mediating connection requests and content rights. It is foundational to multi-tenant virtual environments where independent operators host interoperable spaces."@en ;
    rdfs:subClassOf ngm:sc-governance-and-safety ;
    skos:broader ngm:sc-governance-and-safety ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:vircadia ;
    vc:slug "domain-access-control" ;
    vc:sourceDomain "metaverse" .

ngm:double-spend-prevention a owl:Class ;
    rdfs:label "Double-Spend Prevention"@en ;
    rdfs:comment "Double-spend prevention refers to the set of cryptographic, consensus-based, and protocol-level mechanisms that ensure a given unit of digital value cannot be spent more than once within a payment or transaction system. This problem is fundamental to digital money because, unlike physical currency, digital data can be trivially copied; preventing double-spending without a trusted central authority was the key unsolved challenge that Satoshi Nakamoto's Bitcoin whitepaper addressed through the combination of a public transaction ledger and proof-of-work consensus."@en ;
    rdfs:subClassOf ngm:blockchain-security ;
    vc:contrastsWith ngm:double-spending ;
    vc:enables ngm:distributed-consensus,
        ngm:finality ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:byzantine-fault-tolerance,
        ngm:nakamoto-consensus ;
    vc:slug "double-spend-prevention" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:consensus-mechanism,
        ngm:cryptographic-hash,
        ngm:proof-of-stake,
        ngm:proof-of-work .

ngm:dreamlab a owl:Class ;
    rdfs:label "Dreamlab"@en ;
    rdfs:comment "Dreamlab is a UK-based creative technologist collective offering multidisciplinary services spanning AI and machine learning, virtual production, immersive XR experiences, generative media, spatial computing, and strategic R&D partnerships. It operates at the intersection of advanced AI infrastructure, real-time rendering, and immersive storytelling for creative and enterprise clients."@en ;
    rdfs:subClassOf ngm:infra-software-engineering ;
    skos:broader ngm:infra-software-engineering ;
    vc:enables ngm:immersive-experience,
        ngm:knowledge-management ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:ai-infrastructure,
        ngm:extended-reality-xr ;
    vc:slug "dreamlab" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:generative-ai,
        ngm:immersive-technology,
        ngm:spatial-computing .

ngm:drug-discovery-ai a owl:Class ;
    rdfs:label "Drug Discovery AI"@en ;
    rdfs:comment "Drug Discovery AI encompasses artificial intelligence systems that accelerate pharmaceutical research and development through automated molecular design, virtual screening, target identification, toxicity prediction, and clinical trial optimisation. These systems integrate cheminformatics, molecular modelling, and machine learning — including graph neural networks and generative models — to reduce drug development timelines and costs whilst improving candidate success rates."@en ;
    rdfs:subClassOf ngm:ai-application ;
    skos:broader ngm:ai-application ;
    vc:enables ngm:treatment-planning-ai ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:medical-ai ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:computer-vision,
        ngm:drug-discovery ;
    vc:slug "drug-discovery-ai" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:deep-learning,
        ngm:graph-neural-network,
        ngm:reinforcement-learning .

ngm:dscsa-compliance a owl:Class ;
    rdfs:label "DSCSA Compliance"@en ;
    rdfs:comment "DSCSA Compliance refers to meeting the requirements of the U.S. Drug Supply Chain Security Act, which mandates electronic, interoperable tracing of prescription drugs at the unit (package) level throughout the supply chain. It requires serialisation, product identifiers, transaction history exchange, and verification of suspect or illegitimate product. Full enforcement of unit-level traceability obligates manufacturers, distributors, and dispensers to maintain auditable end-to-end records."@en ;
    rdfs:subClassOf ngm:regulatory-compliance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:cold-chain-monitoring,
        ngm:pharmaceutical-supply-chain ;
    vc:slug "dscsa-compliance" ;
    vc:sourceDomain "supply-chain" .

ngm:dublin-core a owl:Class ;
    rdfs:label "Dublin Core"@en ;
    rdfs:comment "Dublin Core is a standardised set of fifteen core metadata elements defined by the Dublin Core Metadata Initiative (DCMI) to describe digital and physical resources in a simple, interoperable manner. It provides a lowest-common-denominator vocabulary applicable across libraries, repositories, the web, and cross-domain data exchange."@en ;
    rdfs:subClassOf ngm:metadata-standard ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:linked-data,
        ngm:rdf-schema,
        ngm:schema-org ;
    vc:slug "dublin-core" ;
    vc:sourceDomain "ai" ;
    vc:standardizedBy ngm:interoperability-standard ;
    vc:uses ngm:json-ld .

ngm:dune-analytics a owl:Class ;
    rdfs:label "Dune Analytics"@en ;
    rdfs:comment "Dune Analytics is a platform for querying and visualising blockchain data through user-created dashboards and shared queries."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:blockchain-analytics ],
        ngm:blockchain-analytics ;
    vc:enables ngm:data-visualisation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:blockchain-analytics ;
    vc:slug "dune-analytics" ;
    vc:sourceDomain "blockchain" .

ngm:dynamic-lighting a owl:Class ;
    rdfs:label "Dynamic Lighting"@en ;
    rdfs:comment "Dynamic lighting is a real-time rendering technique in which light sources, shadows, and indirect illumination are computed per-frame based on the current state of a scene, allowing lights to move, change intensity or colour, and interact with animated geometry without relying on pre-baked static lighting data. It is foundational to believable 3D environments in games, virtual production, and spatial computing applications."@en ;
    rdfs:subClassOf ngm:rendering-technique ;
    vc:enables ngm:global-illumination,
        ngm:real-time-rendering ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:rendering-pipeline ;
    vc:slug "dynamic-lighting" ;
    vc:sourceDomain "spatial" ;
    vc:uses ngm:physically-based-rendering,
        ngm:ray-tracing,
        ngm:shader .

ngm:dynamical-systems-theory a owl:Class ;
    rdfs:label "Dynamical Systems Theory"@en ;
    rdfs:comment "The mathematical study of systems that evolve over time according to fixed rules, focusing on long-term behaviour, stability, and qualitative structure."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:linear-algebra ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:differential-equations ],
        ngm:owl-thing ;
    vc:enables ngm:complex-systems ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:differential-equations,
        ngm:linear-algebra ;
    vc:slug "dynamical-systems-theory" ;
    vc:sourceDomain "mathematics" .

ngm:dynamics a owl:Class ;
    rdfs:label "Dynamics"@en ;
    rdfs:comment "Dynamics is the branch of mechanics that studies the forces and torques that cause motion and the resulting accelerations of bodies. In robotics it provides the equations of motion that relate joint forces to accelerations, essential for force control, simulation, and model-based control. It contrasts with kinematics, which describes motion without reference to the forces that produce it."@en ;
    rdfs:subClassOf ngm:control-theory ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:control-algorithm,
        ngm:mechanical-engineering-domain ;
    vc:slug "dynamics" ;
    vc:sourceDomain "robotics" .

ngm:e-waste a owl:Class ;
    rdfs:label "E-Waste"@en ;
    rdfs:comment "E-waste is discarded electrical and electronic equipment, including devices that have reached the end of their useful life. Managing it involves recycling, recovery, and safe disposal."@en ;
    rdfs:subClassOf ngm:circular-economy ;
    vc:enables ngm:sustainability ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:slug "e-waste" ;
    vc:sourceDomain "governance" .

ngm:early-stopping a owl:Class ;
    rdfs:label "Early Stopping"@en ;
    rdfs:comment "A regularisation technique that terminates model training when validation performance ceases to improve for a configurable number of epochs (the patience parameter), preventing overfitting by restoring the best checkpoint before performance degraded. Early stopping balances training progress against generalisation to unseen data and is most effective when combined with other regularisation techniques such as dropout and weight decay."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:epoch ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:regularisation ],
        ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:contrastsWith ngm:overfitting ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:deep-learning ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:batch-size,
        ngm:hyperparameter ;
    vc:requires ngm:epoch,
        ngm:regularisation ;
    vc:slug "early-stopping" ;
    vc:sourceDomain "spatial-computing" .

ngm:eba-travel-rule-guidelines a owl:Class ;
    rdfs:label "EBA Travel Rule Guidelines"@en ;
    rdfs:comment "The EBA Travel Rule Guidelines are guidance issued by the European Banking Authority on how payment service providers and crypto-asset service providers must comply with the EU Transfer of Funds Regulation. They specify the originator and beneficiary information that must accompany transfers of funds and crypto-assets, implementing the FATF Travel Rule within EU law. They define data fields, thresholds, and responsibilities for intermediaries to support anti-money-laundering controls."@en ;
    rdfs:subClassOf ngm:financial-regulation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:travel-rule ;
    vc:slug "eba-travel-rule-guidelines" ;
    vc:sourceDomain "blockchain" .

ngm:ecdsa-cryptography a owl:Class ;
    rdfs:label "ECDSA Cryptography"@en ;
    rdfs:comment "ECDSA (Elliptic Curve Digital Signature Algorithm) is a public-key signature scheme that uses the algebra of elliptic curves over finite fields to produce compact, efficient digital signatures. It provides strong security with much smaller keys than RSA, making it the dominant signing algorithm in blockchains such as Bitcoin and Ethereum. ECDSA enables verifiable authorship and integrity of messages and transactions without revealing the private key."@en ;
    rdfs:subClassOf ngm:cryptographic-primitive ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:snapshot-voting ;
    vc:slug "ecdsa-cryptography" ;
    vc:sourceDomain "blockchain" .

ngm:economic-exchange a owl:Class ;
    rdfs:label "Economic Exchange"@en ;
    rdfs:comment "Economic exchange is the voluntary transfer of goods, services, information, or rights between parties according to mutually agreed terms of value equivalence, constituting the fundamental transaction unit through which market economies allocate resources, generate price signals, and produce social surplus. It encompasses the full spectrum from primitive barter to complex multi-party financial instrument transactions, requiring coordination mechanisms — markets, prices, contracts, platforms — to match counterparties, communicate value, and enforce agreements. Modern digital economic exchange increasingly occurs through automated market makers, decentralised exchange protocols, and algorithmic trading systems that reduce friction and enable global, continuous, programmatic commerce."@en ;
    rdfs:subClassOf ngm:economic-mechanism ;
    vc:enables ngm:automated-market-maker,
        ngm:decentralized-exchange,
        ngm:digital-marketplace ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:economics,
        ngm:tokenomics ;
    vc:slug "economic-exchange" ;
    vc:sourceDomain "finance" ;
    vc:uses ngm:barter-system,
        ngm:mechanism-design,
        ngm:price-discovery .

ngm:economic-governance a owl:Class ;
    rdfs:label "Economic Governance"@en ;
    rdfs:comment "Economic Governance is an artificial intelligence concept."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:artificial-intelligence ],
        ngm:ai-governance-and-ethics ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:artificial-intelligence ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:slug "economic-governance" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:economic-model a owl:Class ;
    rdfs:label "Economic Model"@en ;
    rdfs:comment "An economic model is a simplified representation of an economy or market used to analyse behaviour and predict outcomes. It expresses relationships between variables such as supply, demand, prices and output."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:economics ],
        ngm:economics ;
    vc:enables ngm:agent-based-modelling ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:economics ;
    vc:slug "economic-model" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:eigen-layer a owl:Class ;
    rdfs:label "EigenLayer"@en ;
    rdfs:comment "EigenLayer is an Ethereum-based restaking protocol that allows ETH stakers to extend their cryptoeconomic security — the stake already deposited to validate the Ethereum consensus layer — to additional decentralised services called Actively Validated Services (AVS). By opting into EigenLayer smart contracts, stakers grant the protocol the right to apply slashing conditions from multiple AVS operators simultaneously, enabling new protocols such as data availability layers, bridges, oracles, and sequencers to bootstrap economic security without deploying their own native token staking systems. EigenLayer fundamentally reuses and resells Ethereum's security budget."@en ;
    rdfs:subClassOf ngm:blockchain-protocol ;
    vc:enables ngm:de-fi-protocol,
        ngm:decentralized-application,
        ngm:layer-2-scaling ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:ethereum,
        ngm:liquid-proof-of-stake,
        ngm:validator-economics ;
    vc:slug "eigen-layer" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:cryptographic-protocol,
        ngm:proof-of-stake,
        ngm:validator-node .

ngm:electricity-consumption a owl:Class ;
    rdfs:label "Electricity Consumption"@en ;
    rdfs:comment "Electricity Consumption is the total quantity of electrical energy used by a system over a period, typically measured in kilowatt- or terawatt-hours. For blockchains it quantifies the energy drawn by mining, validation, and node operation, and is a central metric in debates over their environmental impact. Indices such as the Cambridge Bitcoin Electricity Consumption Index estimate network-wide consumption from hardware and hashrate data."@en ;
    rdfs:subClassOf ngm:sustainability ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:blockchain-energy-consumption,
        ngm:cbeci ;
    vc:slug "electricity-consumption" ;
    vc:sourceDomain "blockchain" .

ngm:emotional-intelligence a owl:Class ;
    rdfs:label "Emotional Intelligence"@en ;
    rdfs:comment "Emotional Intelligence in AI refers to the capacity of artificial systems to recognise, interpret, and respond appropriately to human emotional states, expressed through text, voice, facial expression, or physiological signals. It extends classical AI with affective computing capabilities, enabling machines to calibrate their outputs based on a user's emotional context. Applications span conversational agents, digital humans, therapeutic tools, and immersive experience design where user engagement depends on emotionally-resonant interaction."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:emotion-aware-interaction ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:natural-language-processing ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:emotional-analytics-engine ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:sentiment-analysis ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:machine-learning ],
        ngm:ai-research-area ;
    skos:broader ngm:ai-research-area ;
    vc:bridgesTo ngm:behavioral-modeling,
        ngm:digital-human-technology ;
    vc:enables ngm:emotional-immersion,
        ngm:empathetic-ai,
        ngm:hyper-personalisation,
        ngm:personalized-virtual-experiences ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:emotion-aware-interaction,
        ngm:emotional-analytics-engine,
        ngm:sentiment-analysis ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:attention-aware-interaction,
        ngm:cognitive-science,
        ngm:conversational-ai,
        ngm:digital-humans,
        ngm:human-computer-interaction,
        ngm:social-presence ;
    vc:requires ngm:machine-learning,
        ngm:natural-language-processing ;
    vc:slug "emotional-intelligence" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:cognitive-architecture,
        ngm:deep-learning .

ngm:encryption-protocol a owl:Class ;
    rdfs:label "Encryption Protocol"@en ;
    rdfs:comment "An Encryption Protocol is a defined set of rules and message exchanges that uses cryptographic algorithms to establish keys and protect the confidentiality and integrity of data in transit or at rest. It specifies handshakes, cipher negotiation, key exchange, and authentication so that interoperating parties can communicate securely. TLS 1.3 is a widely deployed example securing internet traffic."@en ;
    rdfs:subClassOf ngm:cryptographic-protocol ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:cybersecurity-standard,
        ngm:tls-1-3 ;
    vc:slug "encryption-protocol" ;
    vc:sourceDomain "security" .

ngm:energy-attribute-certificates a owl:Class ;
    rdfs:label "Energy Attribute Certificates"@en ;
    rdfs:comment "Energy Attribute Certificates (EACs) are tradable instruments that each represent proof that one megawatt-hour of electricity was generated from a specific source, typically renewable. They decouple the environmental attributes of energy from the underlying physical electricity, allowing those attributes to be sold, retired, or tracked independently. In blockchain contexts they are increasingly tokenised to provide auditable, fraud-resistant accounting of clean-energy consumption and to offset network energy use."@en ;
    rdfs:subClassOf ngm:economic-mechanism ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:green-blockchain-initiatives,
        ngm:sustainability ;
    vc:slug "energy-attribute-certificates" ;
    vc:sourceDomain "blockchain" .

ngm:energy-efficiency a owl:Class ;
    rdfs:label "Energy Efficiency"@en ;
    rdfs:comment "Energy efficiency is the property of a system that achieves a given output or function while consuming the least possible energy. In computing, robotics, and control systems it is measured as useful work per unit of energy, and is improved through better algorithms, hardware, scheduling, and motion optimisation. It is a core sustainability objective because reductions in energy draw lower operating cost and carbon footprint without sacrificing performance."@en ;
    rdfs:subClassOf ngm:sustainability ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:sustainability,
        ngm:velocity-control ;
    vc:slug "energy-efficiency" ;
    vc:sourceDomain "infrastructure" .

ngm:enforcement-action a owl:Class ;
    rdfs:label "Enforcement Action"@en ;
    rdfs:comment "An enforcement action is a formal measure taken by a regulatory or supervisory authority against an entity that has violated laws, rules, or licence conditions. It can include fines, cease-and-desist orders, licence revocation, restitution to affected parties, or referral for prosecution. Enforcement actions are the operative mechanism by which consumer-protection and market-conduct regulations are made binding."@en ;
    rdfs:subClassOf ngm:regulatory-compliance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:consumer-protection,
        ngm:regulatory-domain ;
    vc:slug "enforcement-action" ;
    vc:sourceDomain "governance" .

ngm:ens-dao a owl:Class ;
    rdfs:label "ENS DAO"@en ;
    rdfs:comment "ENS DAO is the decentralised autonomous organisation that governs the Ethereum Name Service (ENS), the primary naming infrastructure for the Ethereum ecosystem, using the ENS governance token ($ENS) to enable token-weighted voting on protocol upgrades, treasury allocation, and price oracle parameter changes through a Governor Bravo-compatible on-chain governance contract. Established in November 2021 via a retroactive airdrop of 25 million ENS tokens to historical registrants and contributors, the DAO holds a treasury of tens of millions of dollars in ETH and ENS, oversees the root multi-sig controlling the ENS root keys, and appoints stewards for working groups covering Meta-Governance, Ecosystem, Public Goods, and Community operations. ENS DAO represents one of the largest and most active protocol DAOs by voter participation and treasury size."@en ;
    rdfs:subClassOf ngm:dao ;
    vc:enables ngm:blockchain-governance,
        ngm:dao-governance,
        ngm:decentralised-decision-making ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:decentralized-identity,
        ngm:digital-identity,
        ngm:ens,
        ngm:on-chain-governance ;
    vc:slug "ens-dao" ;
    vc:sourceDomain "governance" ;
    vc:uses ngm:compound-governor-bravo,
        ngm:governance-token,
        ngm:snapshot-voting,
        ngm:timelock-controller .

ngm:enterprise-workflow a owl:Class ;
    rdfs:label "Enterprise Workflow"@en ;
    rdfs:comment "An enterprise workflow is a defined sequence of tasks and approvals that an organisation uses to carry out a business process. Software systems coordinate and automate these workflows."@en ;
    rdfs:subClassOf ngm:workflow-automation ;
    vc:enables ngm:workflow-automation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:slug "enterprise-workflow" ;
    vc:sourceDomain "general" .

ngm:environmental-asset-market a owl:Class ;
    rdfs:label "Environmental Asset Market"@en ;
    rdfs:comment "Blockchain-enabled trading platforms for environmental assets including carbon credits, renewable energy certificates, and biodiversity offsets, utilising tokenisation and smart contracts to enhance transparency, prevent double-counting, and enable fractional ownership of sustainability instruments."@en ;
    rdfs:subClassOf ngm:digital-asset-market,
        ngm:sc-governance-and-safety ;
    skos:broader ngm:sc-governance-and-safety ;
    vc:enables ngm:sustainable-finance ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:slug "environmental-asset-market" ;
    vc:sourceDomain "spatial-computing" .

ngm:environmental-certificate a owl:Class ;
    rdfs:label "Environmental Certificate"@en ;
    rdfs:comment "A verifiable credential or token attesting that a digital platform, virtual environment, or computational process meets defined environmental sustainability thresholds. Environmental certificates underpin accountability frameworks for metaverse and spatial computing infrastructure by providing tamper-evident proof of carbon offset, renewable energy use, or compliance with environmental KPIs."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-governance ],
        ngm:sc-governance-and-safety ;
    skos:broader ngm:sc-governance-and-safety ;
    vc:enables ngm:blockchain ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:carbon-credit-token,
        ngm:environmental-k-p-i ;
    vc:requires ngm:data-governance ;
    vc:slug "environmental-certificate" ;
    vc:sourceDomain "spatial-computing" ;
    vc:standardizedBy ngm:interoperability-framework .

ngm:environmental-mapping a owl:Class ;
    rdfs:label "Environmental Mapping"@en ;
    rdfs:comment "Environmental mapping is the computational process of constructing spatial representations of a physical environment from sensor data, enabling autonomous agents or robots to understand, navigate, and interact with their surroundings. It encompasses techniques that transform raw sensory inputs—such as lidar point clouds, camera imagery, and depth data—into structured geometric or semantic maps used for path planning and obstacle avoidance."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:sensor-fusion ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:lidar ],
        ngm:mapping ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:localization,
        ngm:occupancy-grid ;
    vc:requires ngm:lidar,
        ngm:sensor-fusion ;
    vc:slug "environmental-mapping" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:point-cloud,
        ngm:slam .

ngm:environmental-sensor a owl:Class ;
    rdfs:label "Environmental Sensor"@en ;
    rdfs:comment "An environmental sensor is a device that measures ambient physical conditions of its surroundings, such as temperature, humidity, pressure, light level, air quality, or sound. As an exteroceptive sensor it perceives the external world rather than a system's internal state. These sensors supply the contextual data used by robots, augmented-reality systems, and smart-environment applications to adapt their behaviour."@en ;
    rdfs:subClassOf ngm:sensor ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:augmented-reality-ar,
        ngm:exteroceptive-sensor ;
    vc:slug "environmental-sensor" ;
    vc:sourceDomain "robotics" .

ngm:environmental-understanding a owl:Class ;
    rdfs:label "Environmental Understanding"@en ;
    rdfs:comment "Environmental understanding is the capability of a robot or autonomous system to perceive, interpret, and build a usable model of its surroundings from sensor data."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:perception ],
        ngm:scene-understanding ;
    vc:enables ngm:mobile-manipulation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:perception ;
    vc:slug "environmental-understanding" ;
    vc:sourceDomain "robotics" .

ngm:environmental-verification a owl:Class ;
    rdfs:label "Environmental Verification"@en ;
    rdfs:comment "The process of validating that a physical or virtual environment meets defined safety, compliance, or operational standards before allowing XR interactions to proceed. Encompasses spatial boundary checks, hazard detection, and cross-referencing environment state against authoritative registries to ensure user safety and regulatory compliance."@en ;
    rdfs:subClassOf ngm:sc-governance-and-safety ;
    skos:broader ngm:sc-governance-and-safety ;
    vc:dependsOn ngm:environmental-registry,
        ngm:verification-standard ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:calibration-tools ;
    vc:slug "environmental-verification" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:spatial-computing,
        ngm:xr-runtime-environment ;
    vc:uses ngm:optical-tracking,
        ngm:slam .

ngm:erc-4337 a owl:Class ;
    rdfs:label "ERC-4337"@en ;
    rdfs:comment "ERC-4337 is an Ethereum Request for Comment specifying an account abstraction standard that enables smart contract accounts to function as first-class transaction originators without requiring changes to the Ethereum consensus protocol. It introduces a separate transaction processing pipeline — the user operation mempool — in which bundlers aggregate user operations (UserOps), simulate them for validity, and submit them as bundled transactions to the EntryPoint smart contract, which validates and executes them on behalf of the respective smart contract wallets. Paymasters, a complementary component, allow third parties to sponsor gas fees, enabling gasless transactions and alternative fee payment tokens."@en ;
    rdfs:subClassOf ngm:account-abstraction ;
    vc:enables ngm:digital-wallet,
        ngm:multi-signature-wallet,
        ngm:wallet ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:ethereum,
        ngm:smart-contract-execution,
        ngm:transaction-standard ;
    vc:slug "erc-4337" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:evm,
        ngm:gas,
        ngm:gas-optimization,
        ngm:smart-contract .

ngm:erc3643-standard a owl:Class ;
    rdfs:label "ERC3643 Standard"@en ;
    rdfs:comment "Permissioned token standard with on-chain identity verification for regulatory compliance."@en ;
    rdfs:subClassOf ngm:bc-token-and-asset ;
    skos:broader ngm:bc-token-and-asset ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:aml-kyc-compliance ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:slug "erc3643-standard" ;
    vc:sourceDomain "blockchain" .

ngm:erc721 a owl:Class ;
    rdfs:label "ERC721"@en ;
    rdfs:comment "ERC721 is the Ethereum non-fungible token standard enabling unique, individually identified digital assets each with a distinct tokenId and metadata URI. It specifies eight mandatory functions and three events supporting ownership transfer, provenance tracking, and approval management, underpinning NFT markets, digital art, gaming items, and tokenised real-world assets on EVM-compatible blockchains."@en ;
    rdfs:subClassOf ngm:bc-token-and-asset ;
    skos:broader ngm:bc-token-and-asset ;
    vc:contrastsWith ngm:erc20 ;
    vc:enables ngm:digital-asset-management,
        ngm:digital-ownership,
        ngm:nft ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:implements ngm:smart-contract,
        ngm:token-standard ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:slug "erc721" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:ethereum,
        ngm:provenance-tracking .

ngm:escrow-system a owl:Class ;
    rdfs:label "Escrow System"@en ;
    rdfs:comment "An escrow system is a mechanism that holds assets or funds with a trusted third party or, on blockchains, in a smart contract until predefined release conditions are met. It reduces counterparty risk in transactions by guaranteeing that neither party can unilaterally seize value before obligations are fulfilled. On-chain escrows use conditional logic and timelocks to release or refund funds automatically."@en ;
    rdfs:subClassOf ngm:economic-mechanism ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:marketplace,
        ngm:timelock ;
    vc:slug "escrow-system" ;
    vc:sourceDomain "blockchain" .

ngm:esg a owl:Class ;
