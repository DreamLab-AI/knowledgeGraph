    vc:sourceDomain "artificial-intelligence" .

ngm:simulation-engine a owl:Class ;
    rdfs:label "Simulation Engine"@en ;
    rdfs:comment "A simulation engine is the computational core responsible for advancing synthetic world state over discrete or continuous time steps, resolving inter-object interactions, enforcing physical or logical constraints, and exposing deterministic replay and instrumentation interfaces. It abstracts heterogeneous hardware (CPU thread pools, GPU compute shaders, distributed clusters) behind a unified loop that separates physics integration, collision detection, agent behaviour evaluation, and sensor data generation into composable subsystems. Specialised variants include rigid-body and soft-body physics engines (PhysX, Bullet, Havok), behaviour-simulation engines, robotics simulators (Isaac Sim, Gazebo), and synthetic-data factories used to train and evaluate machine-learning models at scale."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:real-time-processing ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:scene-graph ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gpu-compute ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:physics-engine ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:collision-detection ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:event-loop ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:deterministic-execution ],
        ngm:simulation-software ;
    vc:bridgesTo ngm:metaverse-platform,
        ngm:virtual-reality ;
    vc:contrastsWith ngm:game-engine,
        ngm:rendering-engine ;
    vc:enables ngm:autonomous-vehicle-testing,
        ngm:digital-twin,
        ngm:reinforcement-learning,
        ngm:synthetic-data-generation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:collision-detection,
        ngm:event-loop,
        ngm:physics-engine,
        ngm:scene-graph ;
    vc:isPartOf ngm:simulation-software ;
    vc:qualityScore "0.73"^^xsd:float ;
    vc:relatedTo ngm:behaviour-tree,
        ngm:finite-element-analysis,
        ngm:monte-carlo-methods ;
    vc:requires ngm:deterministic-execution,
        ngm:gpu-compute,
        ngm:real-time-processing ;
    vc:slug "simulation-engine" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:agent-based-modelling,
        ngm:machine-learning-discipline,
        ngm:robotics ;
    vc:uses ngm:multithreading,
        ngm:numerical-integration,
        ngm:spatial-partitioning .

ngm:slot-filling a owl:Class ;
    rdfs:label "Slot Filling"@en ;
    rdfs:comment "Slot filling is a natural language processing task in which a system extracts and populates predefined semantic fields (slots) from user utterances within a task-oriented dialogue context, enabling the system to gather the structured information required to fulfil a user request. It operates alongside intent classification to transform free-form text into actionable structured representations."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:intent-classification ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:sequence-labelling ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:tokenization ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:named-entity-recognition ],
        ngm:information-extraction ;
    vc:bridgesTo ngm:distributed-collaboration,
        ngm:robotic-process-automation ;
    vc:contrastsWith ngm:information-extraction,
        ngm:relation-extraction ;
    vc:dependsOn ngm:pretrained-model ;
    vc:enables ngm:conversational-ai,
        ngm:dialogue-system,
        ngm:task-oriented-dialogue,
        ngm:voice-assistant,
        ngm:workflow-automation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:coreference-resolution,
        ngm:dialogue-state-tracking,
        ngm:few-shot-learning,
        ngm:natural-language-understanding,
        ngm:semantic-parsing ;
    vc:requires ngm:intent-classification,
        ngm:named-entity-recognition,
        ngm:sequence-labelling,
        ngm:tokenization ;
    vc:slug "slot-filling" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:question-answering ;
    vc:uses ngm:bert,
        ngm:transfer-learning .

ngm:social-choice-theory a owl:Class ;
    rdfs:label "Social Choice Theory"@en ;
    rdfs:comment "Social choice theory is the formal study of how individual preferences can be aggregated into a collective decision, examining the properties, fairness, and impossibility constraints of voting rules and welfare functions. Foundational results such as Arrow's impossibility theorem show that no rank-aggregation rule can simultaneously satisfy a small set of seemingly reasonable fairness axioms. It provides the theoretical underpinning for voting mechanism design in both political and digital governance systems."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:preference-aggregation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:game-theory ],
        ngm:economics ;
    vc:bridgesTo ngm:artificial-intelligence,
        ngm:consensus-mechanism,
        ngm:decentralized-autonomous-organization,
        ngm:distributed-collaboration ;
    vc:contrastsWith ngm:individual-rationality,
        ngm:market-mechanism ;
    vc:enables ngm:mechanism-design,
        ngm:quadratic-voting,
        ngm:ranked-choice-voting,
        ngm:voting-mechanism ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:arrows-impossibility-theorem ;
    vc:qualityScore "0.73"^^xsd:float ;
    vc:relatedTo ngm:economics,
        ngm:governance,
        ngm:political-science ;
    vc:requires ngm:game-theory,
        ngm:preference-aggregation ;
    vc:slug "social-choice-theory" ;
    vc:sourceDomain "governance" ;
    vc:supports ngm:collective-decision-making,
        ngm:governance,
        ngm:public-choice-theory ;
    vc:uses ngm:formal-logic,
