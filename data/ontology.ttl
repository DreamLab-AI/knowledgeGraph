    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:slug "real-time-processing" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:rest-api a owl:Class ;
    rdfs:label "REST API"@en ;
    rdfs:comment "A REST API (Representational State Transfer Application Programming Interface) is a web service interface architected around the six REST constraints—client–server separation, statelessness, cacheability, uniform interface, layered system, and optional code-on-demand—that collectively enable scalable, evolvable distributed systems. Resources are addressed by IRIs, manipulated via standard HTTP verbs (GET, POST, PUT, PATCH, DELETE), and represented in negotiated formats such as JSON or XML. In AI infrastructure, REST APIs serve as the primary integration surface between model inference servers, orchestration platforms, and downstream applications, exposing endpoints for prediction, model management, dataset ingestion, and telemetry collection in a language-agnostic, horizontally scalable manner."@en ;
    rdfs:subClassOf ngm:ai-infrastructure ;
    vc:enables ngm:microservices-architecture ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:implements ngm:api-standard,
        ngm:web-standard ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:slug "rest-api" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:json,
        ngm:software-architecture .

ngm:scene-graph a owl:Class ;
    rdfs:label "Scene Graph"@en ;
    rdfs:comment "A hierarchical tree-based data structure organizing and describing the spatial, logical, and rendering relationships among objects in a 3D scene, enabling efficient traversal, culling, and rendering operations."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:spatial-index ],
        [ a owl:Restriction ;
