    vc:slug "virtual-reality-vr" ;
    vc:sourceDomain "spatial-computing" .

ngm:virtual-world-building a owl:Class ;
    rdfs:label "Virtual World Building"@en ;
    rdfs:comment "The process of creating 3D virtual environments for metaverse platforms, games, and simulations using tools ranging from no-code drag-and-drop builders to professional game engines, enabling the construction of immersive digital spaces with customisable assets, terrain, physics, and interactive elements. Generative AI is rapidly lowering barriers through voice and text-prompt environment generation, while Unity and Unreal Engine remain the professional standard for complex, large-scale world creation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:game-engine ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:real-time-rendering ],
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:bridgesTo ngm:3-d-design ;
    vc:enables ngm:virtual-destination,
        ngm:virtual-environment-creation,
        ngm:virtual-world-platform ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:virtual-world-creation ;
    vc:requires ngm:game-engine,
        ngm:real-time-rendering ;
    vc:slug "virtual-world-building" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:3-d-modeling,
        ngm:immersive-experience .

ngm:visual-perception a owl:Class ;
    rdfs:label "Visual Perception"@en ;
    rdfs:comment "Visual perception is a robot or agent's capability to interpret its environment from camera and visual sensor data, extracting the objects, surfaces, motion and spatial structure needed to act. It transforms raw imagery into actionable scene understanding that drives behaviours such as gaze control, manipulation and navigation. Visual perception is a core perceptual modality for embodied robotic systems."@en ;
    rdfs:subClassOf ngm:robo-perception ;
    skos:broader ngm:robo-perception ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:camera,
        ngm:gaze-control ;
    vc:slug "visual-perception" ;
    vc:sourceDomain "robotics" .

ngm:visual-place-recognition a owl:Class ;
    rdfs:label "Visual Place Recognition"@en ;
    rdfs:comment "Visual place recognition (VPR) is the task of identifying whether a currently observed scene corresponds to a previously visited location by matching image content against a database of geotagged or topologically indexed images. It underpins loop closure in SLAM and global re-localisation for autonomous systems, relying on appearance- and condition-invariant descriptors. Robustness to viewpoint, illumination, and seasonal change is the central research challenge."@en ;
    rdfs:subClassOf ngm:robo-perception ;
    skos:broader ngm:robo-perception ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:topological-map,
        ngm:visual-slam ;
    vc:slug "visual-place-recognition" ;
    vc:sourceDomain "robotics" .

ngm:voice-assistant a owl:Class ;
    rdfs:label "Voice Assistant"@en ;
    rdfs:comment "A voice assistant is a software agent that responds to spoken commands and questions using speech recognition and natural language processing. Examples include assistants built into phones and smart speakers."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:speech-recognition ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:natural-language-processing ],
        ngm:conversational-ai ;
    vc:enables ngm:user-experience ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:natural-language-processing,
        ngm:speech-recognition ;
    vc:slug "voice-assistant" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:volumetric-rendering a skos:Concept ;
    rdfs:label "Volumetric Rendering"@en .

ngm:voting-round a owl:Class ;
    rdfs:label "Voting Round"@en ;
    rdfs:comment "A voting round is a discrete phase within a Byzantine fault-tolerant consensus protocol during which participating nodes exchange and tally votes on a proposed value or block. Multi-round protocols such as PBFT and Tendermint progress through prepare, pre-commit, and commit rounds to achieve agreement despite faulty or malicious participants. The round abstraction provides liveness via view changes and safety via supermajority thresholds."@en ;
    rdfs:subClassOf ngm:consensus-protocol ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:byzantine-fault-tolerance,
        ngm:consensus-mechanism ;
    vc:slug "voting-round" ;
    vc:sourceDomain "blockchain" .

ngm:voxel-grid a skos:Concept ;
    rdfs:label "Voxel Grid"@en .

ngm:vr-psychology a owl:Class ;
    rdfs:label "VR Psychology"@en ;
    rdfs:comment "VR Psychology is the scientific study of how virtual reality environments affect human cognition, perception, emotion, behaviour, and wellbeing. It encompasses research into presence, embodiment, cybersickness, avatar effects, and therapeutic applications of immersive virtual environments, informing the design of XR systems that are psychologically safe and effective."@en ;
    rdfs:subClassOf ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:relatedTo ngm:cognitive-science,
        ngm:haptic-feedback,
        ngm:presence,
        ngm:user-experience ;
    vc:slug "vr-psychology" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:immersion,
        ngm:virtual-reality .

ngm:vrm-format a owl:Class ;
    rdfs:label "VRM Format"@en ;
    rdfs:comment "An open file format standard for 3D humanoid avatars built on glTF, designed for cross-platform interoperability in VR, AR, and metaverse applications. It incorporates standardised humanoid rigging, facial blend-shape expressions, first-person gaze controls, and embedded licensing metadata, enabling seamless avatar portability across different virtual environments. In 2024 the VRM Consortium began collaboration with the Khronos Group to advance VRM specifications as official glTF extensions for international standardisation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:3-d-file-format ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gltf-standard ],
        ngm:sc-standards-and-interop ;
    skos:broader ngm:sc-standards-and-interop ;
    vc:enables ngm:avatar-interoperability,
        ngm:avatar-portability ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:requires ngm:3-d-file-format,
        ngm:gltf-standard ;
    vc:slug "vrm-format" ;
    vc:sourceDomain "spatial-computing" ;
    vc:standardizedBy ngm:interoperability-standard,
