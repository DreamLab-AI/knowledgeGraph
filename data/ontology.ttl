    skos:broader ngm:ai-technique ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:ai-model-card ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:benchmark-standard,
        ngm:evaluation-benchmarks-and-leaderboards,
        ngm:explainability,
        ngm:model-performance,
        ngm:performance-benchmarks ;
    vc:requires ngm:model-architecture,
        ngm:model-training ;
    vc:slug "model-evaluation-results" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:accuracy,
        ngm:auc,
        ngm:confusion-matrix,
        ngm:f1-score .

ngm:monitoring-dashboard a owl:Class ;
    rdfs:label "Monitoring Dashboard"@en ;
    rdfs:comment "Visual interfaces that aggregate and display real-time metrics, logs, and traces from systems and applications, enabling observability, performance tracking, incident detection, and data-driven decision making through unified visualisation platforms."@en ;
    rdfs:subClassOf ngm:ai-infrastructure,
        ngm:data-visualisation ;
    vc:enables ngm:operational-intelligence ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:slug "monitoring-dashboard" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:monitoring-system a owl:Class ;
    rdfs:label "Monitoring System"@en ;
    rdfs:comment "A monitoring system is an integrated platform that continuously collects, aggregates, and evaluates signals from target environments — including software services, physical infrastructure, AI models, or financial markets — to detect anomalies, assess health, and trigger alerts or automated responses. It encompasses data-collection agents, time-series storage, visualisation dashboards, and alerting pipelines. Monitoring systems form a foundational layer of operational reliability for modern distributed systems."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:data-pipeline ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:monitoring-dashboard ],
        ngm:infrastructure ;
    skos:broader ngm:infrastructure ;
    vc:enables ngm:ai-monitoring,
        ngm:compliance-monitoring,
        ngm:real-time-monitoring ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:data-pipeline,
        ngm:monitoring-dashboard ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:slug "monitoring-system" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:data-analytics,
        ngm:open-telemetry,
        ngm:predictive-analytics .

ngm:named-entity-recognition a owl:Class ;
    rdfs:label "Named Entity Recognition"@en ;
    rdfs:comment "Named Entity Recognition (NER) is the NLP task of identifying and classifying named entities (persons, organisations, locations, dates, quantities) within unstructured text into predefined categories."@en ;
    rdfs:subClassOf ngm:ai-application,
        ngm:natural-language-processing ;
    skos:broader ngm:ai-application ;
    vc:enables ngm:information-retrieval,
        ngm:knowledge-graph-construction,
        ngm:question-answering ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:natural-language-processing ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:slug "named-entity-recognition" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:encoder,
        ngm:transformer-architecture .

ngm:open-id-connect a owl:Class ;
    rdfs:label "OpenID Connect"@en ;
    rdfs:comment "OpenID Connect (OIDC) is a federated identity protocol standardised by the OpenID Foundation that adds an authentication layer on top of the OAuth 2.0 authorisation framework. Upon successful authentication, an OIDC-compliant identity provider issues a signed JSON Web Token (ID Token) containing identity claims—such as subject identifier, email, and session expiry—which the relying party verifies cryptographically without querying the provider again. OIDC defines standard flows (authorisation code, implicit, hybrid) and a UserInfo endpoint, enabling single sign-on across web and mobile applications and serving as the identity spine for enterprise federation, consumer logins, and decentralised identity wallets."@en ;
    rdfs:subClassOf ngm:infra-security-and-identity ;
    skos:broader ngm:infra-security-and-identity ;
    vc:dependsOn ngm:oauth-2-0 ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:digital-identity ;
    vc:slug "open-id-connect" ;
    vc:sourceDomain "infrastructure" ;
    vc:standardizedBy ngm:open-id-foundation ;
    vc:supports ngm:authentication,
        ngm:identity-federation .

ngm:pattern-recognition a owl:Class ;
    rdfs:label "Pattern Recognition"@en ;
    rdfs:comment "Pattern Recognition is the automated identification of regularities, structures, and categories in data using machine learning algorithms."@en ;
    rdfs:subClassOf ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:enables ngm:computer-vision,
        ngm:object-detection ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:machine-learning ;
    vc:slug "pattern-recognition" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:deep-learning,
        ngm:feature-extraction .

ngm:planning-and-scheduling a owl:Class ;
    rdfs:label "Planning and Scheduling"@en ;
    rdfs:comment "Planning and Scheduling is a artificial intelligence concept and a type of Artificial Intelligence. that enables Resource Management, Robotics."@en ;
    rdfs:subClassOf ngm:ai-research-area ;
    skos:broader ngm:ai-research-area ;
    vc:enables ngm:resource-management,
        ngm:robotics ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:slug "planning-and-scheduling" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:strips .

ngm:power-management a owl:Class ;
    rdfs:label "Power Management"@en ;
    rdfs:comment "Power management in robotics encompasses the hardware circuits, firmware algorithms, and system-level strategies responsible for regulating, distributing, monitoring, and optimising electrical energy flow across a robot's actuators, sensors, computation units, and communication modules. It includes battery management systems (BMS) that track state-of-charge and cell health, DC–DC conversion topologies that match supply voltage to load requirements, dynamic power scaling that throttles compute or actuators under low-charge conditions, and energy recovery mechanisms such as regenerative braking in joint drives. Effective power management directly determines operational endurance, thermal safety margins, and the feasibility of untethered deployment in field and human-collaborative scenarios."@en ;
    rdfs:subClassOf ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:real-time-processing,
        ngm:robot-hardware ;
    vc:slug "power-management" ;
    vc:sourceDomain "robotics" ;
    vc:supports ngm:autonomous-robot,
        ngm:mobile-robot ;
    vc:uses ngm:embedded-systems,
        ngm:power-supply .

ngm:programmable-money a owl:Class ;
    rdfs:label "Programmable Money"@en ;
    rdfs:comment "Programmable Money is a form of digital currency in which the conditions governing the creation, transfer, and use of monetary units are encoded as executable logic—typically within smart contracts on a public or permissioned blockchain—and enforced autonomously without requiring trusted intermediaries. This enables payment instruments that can embed compliance rules, spending constraints, vesting schedules, or multi-party approval workflows directly into the currency itself. Central bank digital currencies (CBDCs), tokenised commercial bank deposits, and DeFi stablecoins are all instances of programmable money at different points on the decentralisation spectrum."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:smart-contract ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:digital-currency ],
        ngm:bc-defi-and-economics ;
    skos:broader ngm:bc-defi-and-economics ;
    vc:enables ngm:decentralized-finance-de-fi,
        ngm:payment-system ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:cbdcs,
        ngm:stablecoin ;
    vc:requires ngm:digital-currency,
        ngm:smart-contract ;
    vc:slug "programmable-money" ;
    vc:sourceDomain "blockchain" .

ngm:quantisation a owl:Class ;
    rdfs:label "Quantisation"@en ;
    rdfs:comment "Quantisation is a model compression technique that reduces the numerical precision of a neural network's weights and, optionally, activations from the floating-point formats used during training (typically FP32 or BF16) to lower bit-widths such as INT8, INT4, or binary representations. This reduction decreases memory consumption and accelerates matrix operations on hardware with native low-precision arithmetic units, enabling deployment of large models on memory-constrained devices with minimal accuracy degradation. Techniques include post-training quantisation (PTQ) and quantisation-aware training (QAT), which differ in when the precision reduction is applied relative to the training process."@en ;
    rdfs:subClassOf ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:enables ngm:edge-ai-accelerator,
        ngm:inference ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:knowledge-distillation,
        ngm:model-compression-for-edge,
        ngm:neural-network-quantisation ;
    vc:slug "quantisation" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:hardware-acceleration .

ngm:rb-0087-safety-standard a owl:Class ;
    rdfs:label "rb 0087 safety standard"@en ;
    rdfs:comment "A safety standard in robotics is a normative document, published by a recognised standards body, that specifies requirements and guidelines to achieve acceptable levels of safety for robot systems, their components, and their operating environments. Key robotics safety standards include ISO 10218-1/2 for industrial robots, ISO/TS 15066 for collaborative operation, and ISO 13482 for personal care robots. Such standards define hazard categories, risk assessment methodology, required safety functions, performance levels, and verification procedures that manufacturers and system integrators must satisfy before deployment."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:rb-0089-risk-assessment ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:rb-0100-safety-integrity-level ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:rb-0101-performance-level ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:rb-0088-iso-13482-compliance ],
        ngm:robo-safety-and-standards,
        ngm:robot-standard ;
    skos:broader ngm:robo-safety-and-standards ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:rb-0088-iso-13482-compliance,
        ngm:rb-0100-safety-integrity-level,
        ngm:rb-0101-performance-level ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:iec-61508,
        ngm:iso-10218,
        ngm:iso-ts-15066 ;
    vc:requires ngm:rb-0089-risk-assessment ;
    vc:slug "rb-0087-safety-standard" ;
    vc:sourceDomain "robotics" ;
    vc:supports ngm:functional-safety,
        ngm:robot-safety .

ngm:robot-sensor a owl:Class ;
    rdfs:label "Robot Sensor"@en ;
    rdfs:comment "A Robot Sensor is a transducer or measurement device integrated into a robotic system to acquire data about the robot's internal state (proprioception: joint angles, torques, currents) or external environment (exteroception: proximity, force, vision, lidar). Sensor data drives closed-loop control, obstacle avoidance, and higher-level perception pipelines."@en ;
    rdfs:subClassOf ngm:robo-perception ;
    skos:broader ngm:robo-perception ;
    vc:enables ngm:sensor-fusion,
        ngm:slam ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:robotics ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:control-system,
        ngm:lidar ;
    vc:slug "robot-sensor" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:signal-processing .

ngm:scene-understanding a owl:Class ;
    rdfs:label "Scene Understanding"@en ;
    rdfs:comment "Scene Understanding is the high-level semantic interpretation of visual and sensor data to comprehend the structure, context, objects, relationships, and dynamics of an environment."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:computer-vision ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:semantic-segmentation ],
        ngm:sc-interaction ;
    skos:broader ngm:sc-interaction ;
    vc:enables ngm:autonomous-vehicle,
        ngm:digital-twin ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:perception-system ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires ngm:computer-vision,
        ngm:semantic-segmentation ;
    vc:slug "scene-understanding" ;
    vc:sourceDomain "spatial-computing" .

ngm:simultaneous-localisation-and-mapping a owl:Class ;
    rdfs:label "Simultaneous Localisation and Mapping"@en ;
    rdfs:comment "Simultaneous Localisation and Mapping (SLAM) is a computational technique by which a mobile robot or autonomous agent concurrently estimates its own pose and builds a consistent map of a previously unknown environment from sequential sensor observations, solving the circular dependency between localisation (which requires a map) and mapping (which requires a known pose). SLAM algorithms process observations from sensors including LiDAR, stereo cameras, IMUs, and depth cameras using probabilistic frameworks such as particle filters, extended Kalman filters, or pose-graph optimisation to maintain joint estimates of the robot state and environment map."@en ;
    rdfs:subClassOf ngm:robo-navigation-and-planning ;
    skos:broader ngm:robo-navigation-and-planning ;
    vc:enables ngm:autonomous-navigation,
        ngm:visual-odometry ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:localisation,
        ngm:odometry ;
    vc:slug "simultaneous-localisation-and-mapping" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:kalman-filter,
        ngm:lidar,
        ngm:particle-filter .

ngm:single-sign-on a owl:Class ;
    rdfs:label "Single Sign-On"@en ;
    rdfs:comment "Single Sign-On (SSO) is an authentication scheme that allows a user to authenticate once to a central identity provider and obtain delegated access tokens that grant entry to multiple related but independent service providers without re-entering credentials. Common protocol implementations include SAML 2.0, OAuth 2.0 with OpenID Connect, and Kerberos, each varying in how assertions are encoded and transported. SSO reduces credential exposure, simplifies user lifecycle management, and is a foundational component of enterprise identity and access management (IAM) platforms."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
