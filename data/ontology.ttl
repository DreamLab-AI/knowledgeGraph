        ngm:path-planning,
        ngm:sensor-fusion,
        ngm:simultaneous-localisation-and-mapping,
        ngm:slam,
        ngm:trajectory-planning ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:robo-actuation-and-control,
        ngm:robo-perception ;
    vc:slug "robo-navigation-and-planning" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:lidar,
        ngm:navigation .

ngm:convolutional-neural-network a owl:Class ;
    rdfs:label "Convolutional Neural Network"@en ;
    rdfs:comment "A Convolutional Neural Network (CNN) is a feed-forward deep learning architecture that applies learned convolutional filters across spatial dimensions of input data, enabling hierarchical feature extraction from images and other grid-structured inputs. Weight sharing and local receptive fields make CNNs highly parameter-efficient for visual recognition tasks including image classification, object detection, and semantic segmentation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gpu-computing ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:activation-function ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:training-data ],
        ngm:ai-model-architecture ;
    skos:broader ngm:ai-model-architecture ;
    vc:bridgesTo ngm:augmented-reality,
        ngm:autonomous-vehicle-perception ;
    vc:contrastsWith ngm:recurrent-neural-network,
        ngm:transformer-architecture ;
    vc:dependsOn ngm:gradient-descent-optimisation,
        ngm:weight-sharing ;
    vc:enables ngm:feature-extraction,
        ngm:image-classification,
        ngm:object-detection,
        ngm:semantic-segmentation ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:activation-function,
        ngm:convolutional-layer,
        ngm:fully-connected-layer,
        ngm:pooling-layer ;
    vc:implements ngm:feedforward-neural-network ;
    vc:isPartOf ngm:deep-learning ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:adversarial-robustness,
        ngm:resnet ;
    vc:requires ngm:gpu-computing,
        ngm:training-data ;
    vc:slug "convolutional-neural-network" ;
    vc:sourceDomain "machine-learning" ;
    vc:supports ngm:computer-vision,
        ngm:medical-image-analysis ;
    vc:uses ngm:backpropagation,
        ngm:batch-normalisation,
        ngm:stochastic-gradient-descent,
        ngm:transfer-learning .

ngm:actuator a owl:Class ;
    rdfs:label "Actuator"@en ;
    rdfs:comment "An actuator is a transducer that converts a stored or supplied energy form — electrical, hydraulic, pneumatic, or thermochemical — into controlled mechanical motion or force, functioning as the output effector in any closed-loop control chain. Actuators execute commands issued by a controller by producing joint rotations, linear displacements, gripping forces, or compliant deformations, and their dynamic properties (torque density, bandwidth, backdrivability, stiffness) fundamentally bound a system's achievable speed, precision, payload capacity, and intrinsic safety during physical interaction. The choice of actuation technology cascades through every level of system design, from mechanical linkage geometry and energy storage requirements to real-time control law selection and safety-rated force limitation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:control-system ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:sensor ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:servo-motor ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:hydraulic-actuator ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:power-electronics ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:pneumatic-actuator ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:feedback-control ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:series-elastic-actuator ],
        ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:bridgesTo ngm:digital-twin,
        ngm:internet-of-things ;
    vc:contrastsWith ngm:passive-mechanism,
        ngm:transducer ;
    vc:dependsOn ngm:embedded-system,
        ngm:encoder,
        ngm:pid-controller ;
    vc:enables ngm:human-robot-interaction,
        ngm:motion-planning,
        ngm:robot-kinematics,
        ngm:teleoperation ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:hydraulic-actuator,
        ngm:linear-actuator,
        ngm:pneumatic-actuator,
        ngm:series-elastic-actuator,
        ngm:servo-motor ;
    vc:isPartOf ngm:cyber-physical-system,
        ngm:mechatronic-system,
        ngm:robot ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:impedance-control,
        ngm:industrial-automation,
        ngm:soft-robotics,
        ngm:torque-control ;
