ngm:project-dunbar a owl:Class ;
    rdfs:label "Project Dunbar"@en ;
    rdfs:comment "Project Dunbar was a multi-central-bank experiment exploring a shared platform for multiple central bank digital currencies to settle cross-border transactions directly."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:central-bank-digital-currency ],
        ngm:central-bank-digital-currency ;
    vc:enables ngm:cross-border-payments ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:central-bank-digital-currency ;
    vc:slug "project-dunbar" ;
    vc:sourceDomain "metaverse" .

