ngm:webinar-broadcast a owl:Class ;
    rdfs:comment "A webinar broadcast is a one-to-many online event in which one or more presenters stream audio and video to a large remote audience with limited bidirectional interaction. Participants typically engage through moderated Q&A, polls, and chat rather than direct audio or video contribution. Webinars are used for training, product launches, and large-scale knowledge dissemination across geographically distributed audiences."@en ;
    rdfs:label "Webinar Broadcast"@en ;
