ngm:industrial-automation a owl:Class ;
    rdfs:label "IndustrialAutomation"@en ;
    rdfs:comment "Industrial automation is the systematic application of control technologies—including programmable logic controllers (PLCs), distributed control systems (DCS), supervisory control and data acquisition (SCADA), and robotic manipulators—together with information technologies to operate industrial processes and machinery with minimal or no human intervention. It encompasses both discrete manufacturing (assembly lines, packaging, welding) and continuous process industries (chemical plants, oil refineries, power generation), delivering gains in throughput, consistency, quality, and safety by removing workers from hazardous or repetitive environments. The discipline integrates mechanical, electrical, software, and network engineering and is increasingly augmented by machine vision, collaborative robots (cobots), edge computing, and AI-driven process optimisation. Modern industrial automation converges with the Industrial Internet of Things (IIoT), digital twin modelling, and cyber-physical systems to enable adaptive, closed-loop manufacturing at scale."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:machine-vision ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:industrial-robot ],
        ngm:cyber-physical-systems ;
    vc:bridgesTo ngm:edge-computing,
        ngm:machine-learning ;
    vc:contrastsWith ngm:manual-manufacturing ;
    vc:dependsOn ngm:industrial-ethernet,
        ngm:real-time-operating-system ;
    vc:enables ngm:industrial-io-t,
        ngm:lights-out-manufacturing,
        ngm:mass-production,
        ngm:predictive-maintenance ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:distributed-control-system,
        ngm:industrial-robot,
        ngm:machine-vision,
        ngm:programmable-logic-controller,
        ngm:scada ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:collaborative-robot,
        ngm:digital-twin,
        ngm:real-time-processing ;
    vc:slug "industrial-automation" ;
    vc:sourceDomain "robotics" ;
    vc:standardizedBy ngm:iec-61131,
        ngm:iec-62443,
        ngm:iso-10218 ;
    vc:uses ngm:actuator,
        ngm:control-system,
        ngm:fieldbus,
        ngm:human-machine-interface,
        ngm:sensor .

ngm:private-key a owl:Class ;
    rdfs:label "Private Key"@en ;
    rdfs:comment "A Private Key is a secret scalar value generated through cryptographically secure randomness that serves as the sole proof of ownership within asymmetric cryptographic systems. In blockchain contexts it authorises transaction signing via digital signatures, controls access to associated public addresses and funds, and underpins the non-custodial security model where loss or exposure is irreversible."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:secure-storage ],
        ngm:cryptographic-primitive ;
