    vc:contrastsWith ngm:aaai,
        ngm:cvpr,
        ngm:iclr,
        ngm:neur-ips ;
    vc:enables ngm:benchmark-standard,
        ngm:federated-learning,
        ngm:machine-learning-research,
        ngm:peer-review,
        ngm:transfer-learning ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:journal-of-machine-learning-research,
        ngm:machine-learning ;
    vc:qualityScore "0.73"^^xsd:float ;
    vc:relatedTo ngm:academic-conference,
