ngm:distributed-team-collaboration a owl:Class ;
    rdfs:label "Distributed Team Collaboration"@en ;
    rdfs:comment "Distributed team collaboration encompasses the practices, tools, and organisational patterns that enable geographically dispersed individuals working across multiple time zones to coordinate effectively on shared goals without co-location. It integrates asynchronous communication protocols, synchronous video conferencing, shared digital workspaces, version-controlled artefacts, and social norms around documentation and decision-making transparency to replicate — and often surpass — the coordination bandwidth of co-located teams. The discipline has grown from a niche practice of open-source communities and multinational corporations into a mainstream organisational capability following the global shift to remote work accelerated by the 2020 pandemic."@en ;
    rdfs:subClassOf ngm:distributed-collaboration ;
    skos:broader ngm:distributed-collaboration ;
