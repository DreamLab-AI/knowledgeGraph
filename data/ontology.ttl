    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:slug "reward-distribution" ;
    vc:sourceDomain "spatial-computing" .

ngm:rgb-protocol a owl:Class ;
    rdfs:label "RGB Protocol"@en ;
    rdfs:comment "RGB Protocol is a client-side validation smart-contract system built on Bitcoin and the Lightning Network that enables issuance, transfer, and programmable logic over tokenised assets (fungible and non-fungible) without placing contract state on the public blockchain. Contract state is stored in off-chain client-held directed acyclic graphs (DAGs), with only cryptographic commitments anchored to Bitcoin UTXOs via single-use seals, inheriting Bitcoin's security and censorship resistance while providing scalability, privacy, and programmability unavailable to purely on-chain designs. The AluVM virtual machine executes contract validation logic deterministically off-chain, and Lightning Network channels enable instant, low-fee RGB asset transfers. Developed by the LNP/BP Association from 2018 onward, RGB reached production stability in 2024 with standardised schemas RGB20 (fungible tokens) and RGB21 (non-fungible tokens)."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:merkle-tree ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:taproot ],
        ngm:blockchain-protocol ;
    vc:bridgesTo ngm:decentralised-finance,
        ngm:digital-asset-management ;
    vc:contrastsWith ngm:ethereum-smart-contract,
        ngm:ordinals-protocol,
        ngm:runes-protocol,
        ngm:taproot-assets ;
    vc:enables ngm:asset-tokenization,
        ngm:layer-2-scaling,
        ngm:non-fungible-token,
        ngm:privacy-preserving-computation,
        ngm:smart-contract ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:implements ngm:client-side-validation,
        ngm:deterministic-bitcoin-commitment ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:coloured-coins,
        ngm:lnp-bp-association,
        ngm:rgb-and-client-side-validation,
        ngm:zero-knowledge-proof ;
    vc:requires ngm:bitcoin-transaction,
        ngm:merkle-tree,
        ngm:taproot ;
    vc:slug "rgb-protocol" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:aluvm,
        ngm:bitcoin-proof-of-work-protocol-network,
        ngm:cryptographic-commitment,
        ngm:lightning-network,
        ngm:single-use-seal,
        ngm:utxo-model .

ngm:risk-assessment-methodology a owl:Class ;
    rdfs:label "Risk Assessment Methodology"@en ;
    rdfs:comment "A Risk Assessment Methodology is a structured, repeatable set of procedures for identifying, analysing, and evaluating potential hazards or threats to an organisation's objectives, assets, or stakeholders, producing a prioritised risk register that informs mitigation decisions. Methodologies range from qualitative (likelihood-impact matrices) to quantitative (Monte Carlo simulation, fault tree analysis) approaches, and are codified in standards such as ISO 31000, NIST SP 800-30, and FAIR for cybersecurity contexts."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
