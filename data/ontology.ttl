    vc:uses ngm:design-systems .

ngm:variational-autoencoder a owl:Class ;
    rdfs:label "Variational Autoencoder"@en ;
    rdfs:comment "A generative model that pairs an encoder mapping inputs to a probability distribution over a latent space with a decoder that reconstructs inputs, trained to maximise a variational lower bound (ELBO) on the data likelihood via the reparameterisation trick."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:neural-network-latent-space ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:reparameterisation-trick ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:variational-inference ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:backpropagation ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:decoder-network ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:encoder ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:kullback-leibler-divergence ],
        ngm:autoencoder ;
    vc:contrastsWith ngm:diffusion-model,
        ngm:generative-adversarial-network,
        ngm:normalising-flow ;
    vc:enables ngm:anomaly-detection,
        ngm:drug-discovery,
        ngm:image-generation,
        ngm:representation-learning ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:decoder-network,
        ngm:encoder,
        ngm:neural-network-latent-space ;
    vc:implements ngm:generative-model,
        ngm:graphical-model ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:deep-learning,
        ngm:unsupervised-learning ;
    vc:requires ngm:backpropagation,
        ngm:kullback-leibler-divergence,
        ngm:reparameterisation-trick,
        ngm:variational-inference ;
    vc:slug "variational-autoencoder" ;
    vc:sourceDomain "machine-learning" ;
    vc:uses ngm:evidence-lower-bound,
        ngm:gaussian-distribution,
        ngm:neural-network .

ngm:ai-risk-management a owl:Class ;
    rdfs:label "AI Risk Management"@en ;
    rdfs:comment "AI Risk Management is the systematic process of identifying, assessing, mitigating, and monitoring risks associated with artificial intelligence systems throughout their lifecycle, integrating AI-specific considerations into broader enterprise risk management frameworks. It encompasses governance structures, assessment methodologies, control mechanisms, and continuous oversight to ensure AI systems operate safely, ethically, and in compliance with applicable regulations."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:audit-trail ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-governance ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:incident-response ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:continuous-monitoring ],
        [ a owl:Restriction ;
