ngm:strike a owl:Class ;
    rdfs:label "Strike"@en ;
    rdfs:comment "Strike is a financial technology company founded by Jack Mallers that uses the Bitcoin Lightning Network as a settlement rail to deliver instant, low-cost global payments and remittances denominated in fiat currencies. It abstracts the technical complexity of Bitcoin and Lightning from end users, converting value at the edges so that senders and recipients may transact in their preferred local currencies without needing to hold cryptocurrency. Strike competes with legacy remittance operators and correspondent banking channels by exploiting Lightning's near-zero fee structure and sub-second finality to offer dramatically lower-cost international money movement."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:lightning-network ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:bitcoin-proof-of-work-protocol ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:payment-channel ],
        ngm:cross-border-payments ;
    vc:bridgesTo ngm:decentralised-finance,
        ngm:open-banking ;
    vc:contrastsWith ngm:correspondent-banking,
        ngm:paypal,
        ngm:swift-network,
        ngm:western-union ;
    vc:dependsOn ngm:bitcoin-blockchain,
        ngm:kyc-aml-compliance,
        ngm:node-operation ;
    vc:enables ngm:instant-settlement,
        ngm:merchant-payments,
        ngm:micropayments,
        ngm:remittance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:cryptocurrency-exchange,
        ngm:digital-dollar,
        ngm:financial-inclusion,
        ngm:open-payments-protocol ;
    vc:requires ngm:bitcoin-proof-of-work-protocol,
        ngm:lightning-network,
        ngm:liquidity-management,
        ngm:payment-channel ;
    vc:slug "strike" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:api-integration,
        ngm:bolt-protocol,
        ngm:fiat-currency,
        ngm:hash-time-locked-contracts .

ngm:strike-payment-infrastructure a skos:Concept ;
    rdfs:label "Strike Payment Infrastructure"@en .

ngm:string-similarity a skos:Concept ;
    rdfs:label "String Similarity"@en .

ngm:stripe a owl:Class ;
    rdfs:label "Stripe"@en ;
    rdfs:comment "Stripe is a financial technology company founded in 2010 that provides programmable payment infrastructure, APIs, and financial services software enabling businesses to accept online and in-person payments, manage subscriptions, issue cards, and access embedded financial tooling. It operates as a payment service provider and merchant acquirer, abstracting the complexity of card networks, banking rails, and compliance into developer-friendly interfaces. Stripe's platform spans payment processing, revenue management, fraud detection, tax computation, and banking-as-a-service, making it a foundational layer of the internet economy. Its products serve businesses ranging from independent developers to large enterprises across more than 135 countries."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:payment-network ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:kyc-aml-compliance ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:fraud-detection ],
        ngm:payment-network ;
    vc:bridgesTo ngm:decentralised-finance,
        ngm:stablecoin ;
    vc:contrastsWith ngm:adyen,
        ngm:paypal,
        ngm:square ;
    vc:enables ngm:e-commerce,
        ngm:embedded-finance,
        ngm:financial-services,
        ngm:marketplace-platform ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:card-issuing,
        ngm:fraud-detection,
        ngm:payment-api,
        ngm:subscription-billing ;
    vc:isPartOf ngm:financial-services ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:merchant-acquiring,
        ngm:payment-gateway,
        ngm:pci-dss ;
    vc:requires ngm:banking-rail,
        ngm:kyc-aml-compliance,
        ngm:payment-network ;
    vc:slug "stripe" ;
    vc:sourceDomain "finance" ;
    vc:supports ngm:open-banking,
        ngm:stablecoin ;
    vc:uses ngm:machine-learning,
        ngm:rest-api,
        ngm:tokenisation,
        ngm:webhook .

