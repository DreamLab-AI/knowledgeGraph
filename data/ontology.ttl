    vc:slug "today-presentation-2" ;
    vc:sourceDomain "infrastructure" .

ngm:token-bonding-curve a owl:Class ;
    rdfs:label "Token Bonding Curve"@en ;
    rdfs:comment "Algorithmic pricing mechanism that defines token value as a mathematical function of circulating supply and reserve balance, providing continuous liquidity through automated market making."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:smart-contract ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:price-oracle ],
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:enables ngm:automated-trading,
        ngm:continuous-liquidity,
        ngm:decentralized-exchange,
        ngm:predictable-pricing ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:liquidity-mechanism,
