ngm:cbeci a owl:Class ;
    rdfs:comment "The Cambridge Bitcoin Electricity Consumption Index (CBECI) is a real-time model produced by the Cambridge Centre for Alternative Finance that estimates the annualised electricity consumption and carbon footprint of the Bitcoin proof-of-work mining network. It aggregates hardware efficiency data from known ASIC models, network hash rate, and electricity price assumptions to produce lower-, central-, and upper-bound estimates."@en ;
    rdfs:label "CBECI"@en ;
    rdfs:subClassOf ngm:benchmark-evaluation ;
    rdfs:subClassOf ngm:electricity-consumption ;
    vc:bridgesTo ngm:governance ;
    vc:bridgesTo ngm:infrastructure ;
    vc:contrastsWith ngm:proof-of-stake ;
    vc:dependsOn ngm:blockchain ;
    vc:dependsOn ngm:proof-of-work ;
    vc:enables ngm:carbon-accounting ;
    vc:enables ngm:renewable-energy-certificates ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:bitcoin-proof-of-work-protocol-environmental-issues ;
    vc:relatedTo ngm:bitcoin-proof-of-work-protocol-mining ;
    vc:relatedTo ngm:cambridge-centre-for-alternative-finance ;
    vc:relatedTo ngm:carbon-footprint ;
    vc:relatedTo ngm:proof-of-work-energy-consumption ;
    vc:relatedTo ngm:sustainable-bitcoin-protocol ;
    vc:slug "cbeci" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:bc-0482-eu-mica-regulation ;
    vc:supports ngm:cryptocurrency-regulation ;
    vc:uses ngm:asic-hardware ;
    vc:uses ngm:cbeci-methodology ;
    vc:uses ngm:difficulty ;
    vc:uses ngm:electricity-consumption ;
    vc:uses ngm:hash-rate ;
    vc:uses ngm:mining-pool .
ngm:cbeci-methodology a owl:Class ;
    rdfs:comment "The CBECI methodology is the estimation framework underlying the Cambridge Bitcoin Electricity Consumption Index, used to model the Bitcoin network's real-time electricity demand. It derives a plausible consumption range by combining network hashrate, a profitability-weighted mix of mining hardware efficiencies, data-centre overheads, and assumptions about miner economics. The methodology matters because it provides the most widely cited, transparent academic estimate of Bitcoin's energy use and the basis for its carbon analysis."@en ;
    rdfs:label "CBECI Methodology"@en ;
    rdfs:subClassOf ngm:blockchain-environmental-impact-assessment ;
    rdfs:subClassOf ngm:evaluation-metric ;
    vc:hasMaturity ngmi:maturity-established ;
