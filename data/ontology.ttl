        ngm:software-development,
        ngm:version-control ;
    vc:slug "agile-software-development" ;
    vc:sourceDomain "distributed-collaboration" ;
    vc:uses ngm:pair-programming .

ngm:bayesian-optimisation a owl:Class ;
    rdfs:label "Bayesian Optimisation"@en ;
    rdfs:comment "Bayesian Optimisation is a sequential, sample-efficient strategy for optimising expensive black-box objective functions by constructing a probabilistic surrogate model — most commonly a Gaussian Process — over the function's input space, then using an acquisition function to select the next evaluation point by trading off exploration of uncertain regions against exploitation of known optima. The method accumulates knowledge about the objective between evaluations, making it uniquely valuable when each function evaluation is computationally or financially costly. It maintains a posterior distribution over the objective that quantifies uncertainty and guides convergence to a global optimum with far fewer evaluations than grid search or random search. Applications span hyperparameter tuning, neural architecture search, drug discovery, materials science, and robotics controller design."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:surrogate-model ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:probabilistic-inference ],
        ngm:optimisation,
        ngm:probabilistic-model ;
    vc:bridgesTo ngm:experimental-design,
        ngm:large-language-model,
        ngm:robotics,
        ngm:self-driving-laboratory ;
    vc:contrastsWith ngm:evolutionary-algorithm,
        ngm:gradient-descent,
        ngm:grid-search,
        ngm:random-search ;
    vc:enables ngm:auto-ml,
        ngm:automated-design,
        ngm:hyperparameter-tuning,
        ngm:multi-objective-optimisation,
        ngm:neural-architecture-search,
        ngm:self-driving-laboratory ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.93"^^xsd:float ;
    vc:relatedTo ngm:active-learning,
        ngm:expected-improvement,
        ngm:exploration-exploitation-trade-off,
        ngm:kriging,
        ngm:reinforcement-learning,
        ngm:transfer-learning,
        ngm:uncertainty-quantification ;
    vc:requires ngm:kernel-function,
        ngm:probabilistic-inference,
        ngm:surrogate-model ;
    vc:slug "bayesian-optimisation" ;
    vc:sourceDomain "machine-learning" ;
    vc:supports ngm:deep-learning,
        ngm:drug-discovery,
        ngm:machine-learning,
        ngm:materials-science,
        ngm:robotics ;
    vc:uses ngm:acquisition-function,
        ngm:bayesian-inference,
        ngm:gaussian-process,
        ngm:kernel-function,
        ngm:probabilistic-model,
        ngm:surrogate-model .

ngm:bitcoin-proof-of-work-protocol-improvement-proposals a owl:Class ;
    rdfs:label "Bitcoin Improvement Proposals"@en ;
    rdfs:comment "Bitcoin Improvement Proposals (BIPs) are the formal design documents through which changes, enhancements, and new features are proposed and ratified for the Bitcoin protocol and its broader ecosystem. First introduced by Amir Taaki in 2011, modelled on Python's PEP and Python Enhancement Proposal process, BIPs serve as the primary coordination mechanism for a decentralised developer community that lacks any central authority. Each BIP progresses through a defined lifecycle — draft, proposed, final, and optionally superseded — and must achieve rough consensus among economic nodes, miners, and users before activation. BIPs are organised into three tracks: Standards Track (protocol-level changes requiring network-wide adoption), Informational (guidelines and best practices), and Process (procedural rules governing the BIP process itself)."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:bip-341 ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:bip-340 ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:rough-consensus ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:peer-review ],
        ngm:blockchain-governance ;
    vc:bridgesTo ngm:cryptographic-protocol,
        ngm:distributed-systems-governance ;
    vc:contrastsWith ngm:ethereum-improvement-proposal,
        ngm:ietf-rfc,
        ngm:w3c-recommendation ;
    vc:dependsOn ngm:bitcoin-proof-of-work-protocol-core,
        ngm:bitcoin-proof-of-work-protocol-network,
        ngm:consensus-rule ;
    vc:enables ngm:bitcoin-proof-of-work-protocol-technical-overview,
        ngm:hard-fork,
        ngm:protocol-upgrades,
        ngm:schnorr-signatures,
        ngm:soft-fork,
        ngm:taproot ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:bip-141,
        ngm:bip-173,
        ngm:bip-32,
        ngm:bip-340,
        ngm:bip-341 ;
    vc:implements ngm:decentralised-governance ;
    vc:isPartOf ngm:open-source-governance ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:digital-signature,
        ngm:hd-wallet,
        ngm:lightning-network,
        ngm:segregated-witness ;
    vc:requires ngm:peer-review,
        ngm:rough-consensus ;
    vc:slug "bitcoin-improvement-proposals" ;
    vc:sourceDomain "blockchain" ;
    vc:standardizedBy ngm:blockchain-protocol ;
    vc:uses ngm:git-hub,
