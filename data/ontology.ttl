ngm:blockchain-energy-consumption a owl:Class ;
    rdfs:label "Blockchain Energy Consumption"@en ;
    rdfs:comment "The electrical power and computational resources consumed by blockchain networks during transaction validation, block creation, and network security operations, varying significantly across consensus mechanisms from energy-intensive Proof-of-Work (Bitcoin: ~140 TWh/year, 0.65% of global electricity) to energy-efficient Proof-of-Stake (Ethereum post-Merge: 99.95% reduction), with ongoing research into sustainable consensus algorithms, renewable energy mining, carbon credit tokenization, and environmental impact measurement frameworks."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:hash-rate ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:e-waste ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:electricity-consumption ],
        ngm:bc-governance-and-regulation ;
    skos:broader ngm:bc-governance-and-regulation ;
    vc:bridgesTo ngm:ai-energy-optimisation,
        ngm:sustainability ;
    vc:contrastsWith ngm:directed-acyclic-graph,
        ngm:proof-of-stake ;
    vc:dependsOn ngm:consensus-mechanism,
        ngm:energy-source,
        ngm:mining-hardware ;
    vc:enables ngm:renewable-energy-certificates ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:e-waste,
        ngm:electricity-consumption,
        ngm:hash-rate ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:bitcoin-mining-council,
        ngm:cambridge-bitcoin-electricity-consumption-index,
        ngm:layer-2-scaling ;
    vc:slug "blockchain-energy-consumption" ;
    vc:sourceDomain "blockchain" ;
    vc:standardizedBy ngm:crypto-climate-accord,
        ngm:greenhouse-gas-protocol,
        ngm:iso-14064 ;
    vc:uses ngm:application-specific-integrated-circuit,
        ngm:proof-of-stake,
        ngm:proof-of-work .

ngm:blockchain-gaming a owl:Class ;
    rdfs:label "Blockchain Gaming"@en ;
    rdfs:comment "A gaming paradigm in which in-game assets, economies, and ownership records are managed on distributed ledgers, enabling players to hold verifiable ownership of digital items as NFTs, participate in play-to-earn economies, and trade assets across compatible platforms without relying on centralised game servers for provenance or scarcity guarantees."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:game-asset-generation ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:play-to-earn-p2-e ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gas-fee ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:crypto-wallet ],
        ngm:decentralised-application ;
    vc:bridgesTo ngm:decentralised-finance,
        ngm:digital-twin,
        ngm:metaverse ;
    vc:contrastsWith ngm:gaming ;
    vc:dependsOn ngm:blockchain-protocol,
        ngm:layer-2-scaling,
        ngm:nft-marketplace ;
    vc:enables ngm:asset-portability,
        ngm:digital-ownership,
