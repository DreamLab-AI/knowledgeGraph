    vc:uses ngm:computer-vision,
        ngm:generative-ai,
        ngm:physically-based-rendering,
        ngm:rendering-technology .

ngm:embeddings a owl:Class ;
    rdfs:label "Embeddings"@en ;
    rdfs:comment "Embeddings are dense, low-dimensional vector representations of discrete objects—words, sentences, images, code, graphs, or arbitrary entities—learned by neural networks such that geometric relationships in the vector space correspond to semantic or functional relationships between the original objects. The core property is that semantically similar inputs map to nearby vectors, enabling tasks like similarity search, clustering, and retrieval to be performed as efficient geometric operations. Embeddings are the foundational representation layer of modern deep learning, underpinning language models, recommendation systems, search engines, and retrieval-augmented generation pipelines. They transform high-dimensional sparse inputs into compact continuous representations that downstream neural architectures—particularly attention-based transformers—can process and reason over."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:neural-network ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:positional-encoding ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:training-data ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:embedding-model ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:token-embedding ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:soft-prompt-embedding ],
        ngm:representation-learning ;
    vc:bridgesTo ngm:knowledge-graph-embedding ;
    vc:contrastsWith ngm:bag-of-words,
        ngm:one-hot-encoding,
        ngm:symbolic-representation ;
    vc:dependsOn ngm:backpropagation,
        ngm:loss-function ;
    vc:enables ngm:anomaly-detection,
        ngm:recommendation-system,
        ngm:retrieval-augmented-generation,
        ngm:semantic-search,
        ngm:vector-database ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:embedding-model,
        ngm:positional-encoding,
        ngm:soft-prompt-embedding,
        ngm:token-embedding ;
    vc:qualityScore "0.76"^^xsd:float ;
    vc:relatedTo ngm:approximate-nearest-neighbour,
        ngm:cosine-similarity,
        ngm:knowledge-graph,
        ngm:multimodal-learning ;
    vc:requires ngm:neural-network,
        ngm:training-data ;
    vc:slug "embeddings" ;
    vc:sourceDomain "machine-learning" ;
    vc:uses ngm:contrastive-learning,
        ngm:dimensionality-reduction,
        ngm:natural-language-processing,
        ngm:transformer .

ngm:embodied-ai a owl:Class ;
    rdfs:label "Embodied AI"@en ;
    rdfs:comment "Embodied AI is a research paradigm holding that intelligence emerges from the continuous sensorimotor interaction of an agent with its physical or simulated environment, rather than from purely symbolic or disembodied language-based reasoning. Embodied agents perceive the world through sensors — cameras, proprioceptive IMUs, force-torque sensors, tactile arrays — and act upon it through actuators, learning to navigate, manipulate objects, and cooperate via reinforcement learning or imitation learning in physics simulators. The field unifies robotics, cognitive science, and deep learning, with applications spanning household manipulation, autonomous navigation, humanoid motor control, and grounded natural language understanding. A central hypothesis is that richer, more transferable representations arise from interactive physical engagement with an environment rather than from passive statistical learning over corpora."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:sensor-fusion ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:reinforcement-learning ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:simulation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:physics-engine ],
        ngm:ai-research-area ;
    skos:broader ngm:ai-research-area ;
    vc:bridgesTo ngm:digital-twin,
        ngm:extended-reality,
        ngm:spatial-computing ;
    vc:contrastsWith ngm:disembodied-language-model,
        ngm:symbolic-ai ;
    vc:dependsOn ngm:computer-vision,
        ngm:deep-learning,
        ngm:imitation-learning ;
    vc:enables ngm:autonomous-navigation,
        ngm:grounded-language-understanding,
        ngm:robot-learning,
        ngm:robotic-manipulation,
        ngm:sim-to-real-transfer ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:affordance-learning,
        ngm:cognitive-science,
        ngm:embodied-ai-simulation,
        ngm:robotics,
        ngm:situated-cognition,
        ngm:world-model ;
    vc:requires ngm:physics-engine,
        ngm:reinforcement-learning,
        ngm:sensor-fusion,
        ngm:simulation ;
    vc:slug "embodied-ai" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:domain-randomisation,
        ngm:large-language-model,
        ngm:transformer-architecture,
        ngm:vision-language-model .

ngm:gas a owl:Class ;
    rdfs:label "Gas"@en ;
    rdfs:comment "Gas is the unit of computational work measurement within EVM-compatible blockchains. Every opcode executed by the Ethereum Virtual Machine consumes a defined gas quantity; users pay gas_price × gas_used to validators, preventing denial-of-service through unbounded computation and creating a market for block space."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:priority-fee ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:gas-price ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:base-fee ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:gas-limit ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:gas-fee-market ],
        ngm:economic-mechanism ;
    vc:bridgesTo ngm:microeconomics,
        ngm:resource-allocation ;
    vc:contrastsWith ngm:feeless-blockchain,
        ngm:utxo-model ;
    vc:dependsOn ngm:proof-of-stake ;
    vc:enables ngm:block-space-market,
        ngm:blockchain-transaction,
        ngm:denial-of-service-prevention,
        ngm:smart-contract-execution ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:base-fee,
        ngm:gas-fee-market,
        ngm:gas-limit,
        ngm:gas-price,
        ngm:priority-fee ;
    vc:implements ngm:eip-1559,
        ngm:yellow-paper-specification ;
    vc:isPartOf ngm:blockchain-consensus-protocol,
        ngm:ethereum-virtual-machine ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:fee-market,
        ngm:tokenomics,
        ngm:transaction-fee ;
    vc:requires ngm:ether,
        ngm:ethereum-account ;
    vc:slug "gas" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:mempool,
        ngm:opcode,
        ngm:smart-contract .

ngm:iec-61508 a owl:Class ;
    rdfs:label "IEC 61508"@en ;
    rdfs:comment "IEC 61508 is the foundational international functional safety standard published by the International Electrotechnical Commission (IEC), specifying systematic requirements for the full safety lifecycle of electrical, electronic, and programmable electronic (E/E/PE) safety-related systems across all industry sectors. It introduces the Safety Integrity Level (SIL 1–4) framework as a quantitative measure of risk reduction, mandating specific probabilistic failure-rate targets and qualitative development-process constraints for each level. The standard governs hardware, software, and system-level requirements from hazard identification and risk assessment through design, validation, operation, and decommissioning. Sector-specific derivative standards—including ISO 26262 (automotive), EN 50128 (rail), IEC 62061 (machinery), and IEC 62443 (industrial cybersecurity)—inherit its SIL concepts and lifecycle structure."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:fault-tree-analysis ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:traceability ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:safety-integrity-level ],
        ngm:functional-safety ;
    vc:bridgesTo ngm:ai-safety,
        ngm:autonomous-vehicle,
        ngm:cybersecurity-standard ;
    vc:contrastsWith ngm:do-178c,
        ngm:iso-25119 ;
    vc:enables ngm:formal-verification,
        ngm:functional-safety,
        ngm:risk-assessment,
        ngm:safety-case ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:failure-mode-and-effects-analysis,
        ngm:fault-tree-analysis,
        ngm:hazard-and-risk-assessment,
        ngm:safety-integrity-level,
        ngm:safety-lifecycle ;
    vc:implements ngm:safety-lifecycle ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:embedded-systems,
        ngm:en-50128,
        ngm:iec-62061,
        ngm:iec-62443,
        ngm:iso-26262,
        ngm:programmable-logic-controller ;
    vc:requires ngm:hazop,
        ngm:independent-safety-assessment,
        ngm:traceability ;
    vc:slug "iec-61508" ;
    vc:sourceDomain "standards" ;
    vc:standardizedBy ngm:international-electrotechnical-commission .

ngm:immutability a owl:Class ;
    rdfs:label "Immutability"@en ;
    rdfs:comment "The tamper-resistant property of blockchain ledgers whereby confirmed records cannot be altered without invalidating the cryptographic chain of hashes, providing verifiable finality, audit-trail integrity, and resistance to retroactive manipulation. Achieved through chained Merkle roots, accumulated proof-of-work, or BFT-based finality."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:consensus-mechanism ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:distributed-ledger-technology ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptographic-commitment ],
        ngm:blockchain-entity ;
    vc:bridgesTo ngm:data-governance,
        ngm:digital-twin-data-integrity,
        ngm:verifiable-credential ;
    vc:contrastsWith ngm:data-deletion,
        ngm:mutability,
