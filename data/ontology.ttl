ngm:gpu-architecture a owl:Class ;
    rdfs:label "GPU Architecture"@en ;
    rdfs:comment "GPU architecture describes the design of graphics processing units as massively parallel processors built around thousands of simple shader cores, wide high-bandwidth memory interfaces, and dedicated fixed-function units for texturing, rasterisation, ray tracing, and tensor computation."@en ;
