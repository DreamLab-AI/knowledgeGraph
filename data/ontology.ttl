ngm:markdown a owl:Class ;
    rdfs:label "Markdown"@en ;
    rdfs:comment "Markdown is a lightweight plain-text markup language that uses simple punctuation conventions to denote formatting such as headings, lists, links, and emphasis. Created by John Gruber in 2004 and later standardised by efforts like CommonMark, it is designed to be readable as source and convertible to HTML and other formats. Its simplicity makes it the dominant format for documentation, notes, and content authoring in developer tooling."@en ;
    rdfs:subClassOf ngm:technical-standard ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:ai-diagram-tools,
        ngm:diagrams-as-code ;
    vc:slug "markdown" ;
    vc:sourceDomain "infrastructure" .

ngm:market-capitalization a owl:Class ;
    rdfs:label "Market Capitalization"@en ;
    rdfs:comment "Market Capitalization in a blockchain context is the aggregate market value of a cryptocurrency or token, computed as the circulating supply multiplied by the current unit price. It serves as a widely used proxy for the relative size, liquidity, and investor confidence of a crypto-economic network, underpinning index construction, risk categorisation, and portfolio weighting decisions by institutional participants. Critically, market capitalisation is a lagging and manipulable metric: thin order books, wash trading, and locked but counted supply can inflate the figure well beyond the value that could be liquidated in practice."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:tokenomics ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:token ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptocurrency ],
        ngm:bc-defi-and-economics,
        ngm:blockchain-entity,
        ngm:economic-mechanism ;
    skos:broader ngm:bc-defi-and-economics ;
    vc:enables ngm:token-weighted-voting,
        ngm:tokenomics-governance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:tokenomics ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:blockchain-economics,
        ngm:liquidity-pool,
        ngm:liquidity-provision,
        ngm:token-economics,
        ngm:tokenization ;
    vc:requires ngm:cryptocurrency,
        ngm:token ;
    vc:slug "market-capitalization" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:cryptocurrency-token .

ngm:market-design a owl:Class ;
    rdfs:label "Market Design"@en ;
    rdfs:comment "Market design is the applied economics discipline concerned with constructing, analysing, and improving the rules, mechanisms, and institutions that govern the exchange of goods, services, and assets in real-world markets. Drawing on game theory, mechanism design, and matching theory, market designers identify failures in existing markets — such as the absence of money in matching markets, thickness problems, or congestion — and engineer interventions that produce efficient, stable, and fair outcomes. Prominent applications include kidney exchange programmes, school choice systems, spectrum auctions, and electricity markets."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:auction-mechanism ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:price-discovery ],
        ngm:governance ;
    vc:bridgesTo ngm:defi,
        ngm:tokenomics ;
    vc:contrastsWith ngm:central-planning ;
    vc:dependsOn ngm:behavioural-economics,
        ngm:information-theory ;
    vc:enables ngm:carbon-market,
        ngm:decentralised-exchange,
        ngm:spectrum-allocation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:auction-mechanism,
        ngm:clearing-mechanism,
        ngm:price-discovery ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:auction-theory,
        ngm:game-theory,
        ngm:matching-theory,
        ngm:mechanism-design ;
    vc:slug "market-design" ;
    vc:sourceDomain "governance" ;
    vc:standardizedBy ngm:standards ;
    vc:supports ngm:platform-economics,
        ngm:regulatory-framework ;
    vc:uses ngm:incentive-alignment,
        ngm:strategyproof-mechanism .

ngm:market-efficiency a owl:Class ;
    rdfs:label "Market Efficiency"@en ;
    rdfs:comment "Market efficiency is the degree to which asset prices fully and rapidly reflect all available information, leaving no systematic opportunity for risk-adjusted excess returns. The efficient-market hypothesis frames it in weak, semi-strong, and strong forms according to the information set incorporated. Higher efficiency implies accurate price signals, lower transaction costs, and effective capital allocation."@en ;
    rdfs:subClassOf ngm:economic-mechanism ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:consumer-protection,
        ngm:price-discovery ;
    vc:slug "market-efficiency" ;
    vc:sourceDomain "blockchain" .

ngm:market-maker a skos:Concept ;
    rdfs:label "Market Maker"@en .

ngm:market-manipulation a owl:Class ;
    rdfs:label "Market Manipulation"@en ;
    rdfs:comment "Market manipulation is the deliberate attempt to interfere with the free and fair operation of a financial market by creating false or misleading appearances of supply, demand or price. It encompasses practices such as spoofing, wash trading, pump-and-dump schemes and the dissemination of false information. As a form of market abuse it is prohibited by securities regulation and undermines price discovery and investor protection."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:market-surveillance ],
        ngm:market-integrity ;
    vc:bridgesTo ngm:investor-protection ;
