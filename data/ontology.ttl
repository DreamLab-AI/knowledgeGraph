    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:constitutional-ai,
        ngm:reinforcement-learning-from-human-feedback ;
    vc:requires ngm:ai-alignment,
        ngm:ai-safety ;
    vc:slug "harmlessness" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:trustworthy-ai,
        ngm:value-alignment .

ngm:high-energy-consumption a owl:Class ;
    rdfs:label "High Energy Consumption"@en ;
    rdfs:comment "High Energy Consumption characterises Proof-of-Work blockchain networks that secure the ledger through computationally intensive mining, requiring significant and ongoing electricity expenditure proportional to network hash rate. This property creates environmental concerns, drives carbon footprint assessments, and motivates regulatory scrutiny of PoW chains, contrasting sharply with the energy profile of stake-based consensus alternatives."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:computational-resources ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:mining ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:mining-reward ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:mining-pool ],
        ngm:bc-governance-and-regulation,
        ngm:blockchain-energy-consumption ;
    skos:broader ngm:bc-governance-and-regulation ;
    vc:contrastsWith ngm:low-energy-consumption,
        ngm:proof-of-stake,
        ngm:proof-of-stake-sustainability ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:mining-pool,
        ngm:mining-reward ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:bitcoin-environmental-issues,
        ngm:blockchain-energy-consumption,
        ngm:carbon-footprint-measurement,
        ngm:environmental-impact-metric,
        ngm:proof-of-work ;
    vc:requires ngm:computational-resources,
        ngm:mining ;
    vc:slug "high-energy-consumption" ;
    vc:sourceDomain "blockchain" .

ngm:hot-stuff-consensus a owl:Class ;
    rdfs:label "HotStuff Consensus"@en ;
    rdfs:comment "A Byzantine fault-tolerant state machine replication protocol that achieves the first simultaneous combination of linear message complexity, optimistic responsiveness, and a simple three-phase voting pipeline. HotStuff replaces PBFT's quadratic message complexity with a leader-based threshold signature aggregation scheme, enabling safe view changes with O(n) messages and forming the foundation for the DiemBFT/LibraBFT and Aptos consensus protocols."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:fault-tolerance ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:distributed-system ],
        ngm:bc-protocol-and-consensus,
        ngm:byzantine-fault-tolerance ;
    skos:broader ngm:bc-protocol-and-consensus ;
    vc:contrastsWith ngm:raft-consensus,
        ngm:tendermint-consensus ;
    vc:enables ngm:blockchain-scalability,
        ngm:finality ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:consensus-algorithm,
        ngm:state-machine-replication ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:distributed-ledger,
        ngm:sybil-resistance ;
    vc:requires ngm:distributed-system,
        ngm:fault-tolerance ;
    vc:slug "hot-stuff-consensus" ;
    vc:sourceDomain "blockchain" .

ngm:human-computer-interface a owl:Class ;
    rdfs:label "Human Computer Interface"@en ;
    rdfs:comment "The set of hardware and software components through which a human user perceives, commands, and receives feedback from a computing system. In spatial computing, human computer interfaces extend beyond screens and keyboards to include gesture input, voice commands, gaze control, haptic feedback, and brain-computer interfaces, fundamentally shaping how users navigate and manipulate virtual environments."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
