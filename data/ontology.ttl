ngm:quadcopter a owl:Class ;
    rdfs:label "Quadcopter"@en ;
    rdfs:comment "A vertical take-off and landing (VTOL) aerial robot with four fixed-pitch rotors arranged symmetrically around a central frame, achieving attitude control and thrust modulation by differentially varying rotor speeds. Quadcopters are mechanically simple (no swashplate), highly manoeuvrable, and statically stable in hover, making them the dominant platform for consumer UAVs, autonomous aerial robotics research, and inspection applications."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:pid-controller ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:inertial-measurement-unit ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:imu ],
        ngm:multirotor-uav,
        ngm:robo-robot-type ;
    skos:broader ngm:robo-robot-type ;
    vc:enables ngm:autonomous-navigation,
        ngm:swarm-robotics ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:imu,
        ngm:inertial-measurement-unit,
        ngm:pid-controller ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:aerial-robot,
        ngm:computer-vision,
        ngm:lidar,
        ngm:slam ;
    vc:slug "quadcopter" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:embedded-systems,
        ngm:sensor-fusion .

