    rdfs:label "Grokking"@en .

ngm:groth-16 a owl:Class ;
    rdfs:label "Groth16"@en ;
    rdfs:comment "A pairing-based zk-SNARK proving system that produces constant-size proofs verifiable with a few elliptic curve pairing operations, at the cost of a per-circuit trusted setup."@en ;
