        <urn:visionflow:linked:refrigeration-technology>,
        <urn:visionflow:linked:sensor-networks>,
        vf:blockchain,
        vf:calibration-standards,
        vf:cloud-computing ;
    vc:slug "cold-chain-monitoring" ;
    vc:sourceDomain "infrastructure" .

