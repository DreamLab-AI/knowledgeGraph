        ngm:privacy-by-design ;
    vc:dependsOn ngm:beneficial-ownership,
        ngm:digital-identity,
        ngm:sanctions-screening ;
    vc:enables ngm:aml-kyc-compliance,
        ngm:anti-money-laundering,
        ngm:financial-inclusion,
        ngm:fraud-prevention ;
