ngm:erc20-standard a owl:Class ;
    rdfs:label "ERC20 Standard"@en ;
    rdfs:comment "Technical standard for fungible tokens on ereum, defining required mods and events for token contracts."@en ;
    rdfs:subClassOf ngm:bc-token-and-asset ;
    skos:broader ngm:bc-token-and-asset ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:blockchain ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:slug "erc20-standard" ;
    vc:sourceDomain "blockchain" .

ngm:erc721-token a owl:Class ;
    rdfs:label "ERC721 Token"@en ;
    rdfs:comment "An ERC721 Token is a non-fungible token (NFT) on the Ethereum blockchain that implements the ERC-721 open standard, which assigns each token a unique integer identifier and tracks ownership via the ownerOf(tokenId) function. Unlike fungible ERC-20 tokens, every ERC-721 token is distinct and non-interchangeable, enabling verifiable digital ownership of unique assets such as digital art, collectibles, in-game items, and real-world asset representations on decentralised marketplaces."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:nft-ownership-proof ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:smart-contract ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:erc721-standard ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:blockchain-transaction ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:digital-ownership ],
        ngm:bc-token-and-asset,
        ngm:non-fungible-token-nft ;
    skos:broader ngm:bc-token-and-asset ;
    vc:contrastsWith ngm:erc-1155,
        ngm:erc-20,
        ngm:erc1155-token ;
    vc:enables ngm:digital-asset-trading,
        ngm:fractionalized-nft,
        ngm:nft-marketplace,
        ngm:nft-minting ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:nft-ownership-proof,
        ngm:smart-contract ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:asset-tokenization,
        ngm:digital-asset,
        ngm:nft,
        ngm:smart-contracts ;
    vc:requires ngm:blockchain-transaction,
        ngm:digital-ownership,
        ngm:erc721-standard ;
    vc:slug "erc721-token" ;
    vc:sourceDomain "blockchain" ;
    vc:standardizedBy ngm:erc721,
        ngm:token-standard .

