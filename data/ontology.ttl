vf:blockchain-oracle a owl:Class ;
    rdfs:label "Blockchain Oracle"@en ;
    rdfs:comment "A decentralized service that bridges blockchain smart contracts with external real-world data, enabling smart contracts to access off-chain information, execute based on real-world events, and interact with traditional systems while maintaining trustless verification and data integrity."@en ;
