    vc:uses ngm:knowledge-graph,
        ngm:ontology .

ngm:vibe-coding a owl:Class ;
    rdfs:label "Vibe Coding"@en ;
    rdfs:comment "Vibe Coding is an AI-assisted software development practice in which developers direct large language models or AI coding tools (such as Cursor, Aider, or Copilot) with high-level intent rather than writing all code manually. The practitioner retains system-level design authority whilst delegating implementation of discrete, scoped tasks to the AI, requiring disciplined use of version control, structured context documents, and iterative refinement cycles."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:software-engineering ],
        ngm:infra-software-engineering,
        ngm:software-engineering ;
    skos:broader ngm:infra-software-engineering ;
    vc:enables ngm:user-experience ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:generative-ai-engineering ;
    vc:requires ngm:software-engineering ;
    vc:slug "vibe-coding" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:generative-ai,
        ngm:machine-learning .

ngm:video-async a owl:Class ;
    rdfs:label "Video Async"@en ;
    rdfs:comment "Asynchronous video communication is a mode of distributed collaboration in which participants record, share, and consume video messages at times of their own choosing rather than in a live session, combining the visual richness and non-verbal expressiveness of video with the time-zone flexibility and cognitive benefits of asynchronous working. Tools such as screen-and-webcam recorders reduce dependence on synchronous meetings, enable clearer knowledge sharing across distributed teams, and produce persistent, referenceable communication artefacts."@en ;
    rdfs:subClassOf ngm:asynchronous-collaboration,
        ngm:dc-communication ;
    skos:broader ngm:dc-communication ;
    vc:contrastsWith ngm:synchronous-collaboration,
        ngm:video-conferencing ;
    vc:enables ngm:distributed-collaboration,
        ngm:knowledge-sharing,
        ngm:remote-collaboration ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:asynchronous-communication,
        ngm:collaboration-platform,
        ngm:digital-workplace-platform ;
    vc:slug "video-async" ;
    vc:sourceDomain "distributed-collaboration" ;
    vc:uses ngm:asynchronous-video,
        ngm:screen-sharing .

ngm:virscapes a owl:Class ;
    rdfs:label "Virscapes"@en ;
    rdfs:comment "Virscapes are AI-generated virtual landscape images produced by training generative adversarial networks (StyleGAN) on a curated dataset of digital game landscapes collected over seven years, exploring latent space to create emotionally resonant synthetic environments. The practice investigates questions of landscape identity, simulacra, and the distinction between human aesthetic curation and algorithmic generation in digital art."@en ;
    rdfs:subClassOf ngm:infra-computing-and-cloud ;
    skos:broader ngm:infra-computing-and-cloud ;
    vc:enables ngm:nft-marketplace ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:procedural-generation,
        ngm:virtual-reality ;
    vc:slug "virscapes" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:generative-ai,
        ngm:machine-learning .

ngm:virtual-city-model a owl:Class ;
    rdfs:label "Virtual City Model"@en ;
    rdfs:comment "A digital representation of an urban environment including buildings, infrastructure, terrain, and dynamic elements, used for urban planning, simulation, gaming, and metaverse world-building based on real or imagined cities. Data standards such as CityGML (OGC), 3D Tiles, and BIM/IFC underpin interoperable city model exchange, while capture techniques including LiDAR scanning and photogrammetry feed real-world geometry into the model."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:real-time-rendering ],
        ngm:digital-twin,
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:enables ngm:digital-twin-technology,
