        ngm:gitcoin-grants,
        ngm:mechanism-design,
        ngm:optimism-collective,
        ngm:quadratic-funding ;
    vc:requires ngm:smart-contract,
        ngm:sybil-resistance ;
    vc:slug "retroactive-public-goods-funding" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:dao,
        ngm:on-chain-governance,
        ngm:quadratic-voting,
        ngm:treasury-management .

ngm:rule-based-systems a owl:Class ;
    rdfs:label "Rule-Based Systems"@en ;
    rdfs:comment "Rule-based systems are a class of knowledge-based AI systems that encode domain expertise as a collection of condition-action rules (IF <conditions> THEN <actions>) stored in a knowledge base, and employ an inference engine to match those rules against a working memory of current facts to derive new facts, trigger actions, or reach conclusions. The inference engine operates through either forward chaining (data-driven, propagating from known facts to goals) or backward chaining (goal-driven, working from desired conclusions back to supporting facts), enabling transparent, explainable reasoning where every inference can be traced to the specific rules that fired. Rule-based systems are the foundational architecture underlying classical expert systems, modern business rules engines, production systems, and many decision-automation pipelines across medicine, finance, manufacturing, and legal compliance. Their central tension lies between the interpretability of explicit symbolic rules and the scalability challenges that arise as rule sets grow large and rule interactions become complex."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:conflict-resolution ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:inference-engine ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:working-memory ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:knowledge-base ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:knowledge-representation ],
        ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:bridgesTo ngm:ontology,
        ngm:regulatory-compliance,
        ngm:smart-contracts ;
    vc:contrastsWith ngm:machine-learning,
        ngm:neural-network ;
    vc:enables ngm:automated-reasoning,
        ngm:business-rules-engine,
        ngm:expert-systems ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:conflict-resolution,
        ngm:inference-engine,
        ngm:knowledge-base,
        ngm:working-memory ;
    vc:implements ngm:symbolic-ai ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:constraint-satisfaction,
        ngm:fuzzy-logic,
        ngm:logic-programming ;
    vc:requires ngm:forward-chaining,
        ngm:knowledge-representation ;
    vc:slug "rule-based-systems" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:decision-support,
        ngm:explainable-ai ;
    vc:uses ngm:backward-chaining,
        ngm:pattern-matching .

ngm:safety-and-alignment a owl:Class ;
    rdfs:label "Safety and alignment"@en ;
    rdfs:comment "AI safety and alignment is the interdisciplinary research programme and engineering practice concerned with ensuring that artificial intelligence systems — particularly large language models and future general AI — behave in accordance with human intentions, values, and oversight mechanisms acros..."@en ;
