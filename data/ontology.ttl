    vc:requires ngm:cryptographic-authentication,
        ngm:digital-wallet,
        ngm:payment-network ;
    vc:slug "micropayment" ;
    vc:sourceDomain "blockchain" .

ngm:mind-map a owl:Class ;
    rdfs:label "Mind Map"@en ;
    rdfs:comment "A mind map is a diagram that organises information hierarchically around a central concept, with branches radiating to related topics and sub-topics. It is used for brainstorming, note-taking, and knowledge organisation, leveraging spatial and associative structure to aid recall and ideation. Digital mind-mapping tools support collaborative editing and links to external resources."@en ;
    rdfs:subClassOf ngm:dc-workspace-tools ;
    skos:broader ngm:dc-workspace-tools ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:collaborative-whiteboard,
        ngm:diagrams-as-code ;
    vc:slug "mind-map" ;
    vc:sourceDomain "infrastructure" .

ngm:mind-uploading a owl:Class ;
    rdfs:label "Mind Uploading"@en ;
    rdfs:comment "Mind uploading is the hypothetical process of scanning a biological brain in sufficient detail to emulate its structure and function on a computational substrate, producing a digital instantiation of an individual's mind. It is a speculative concept central to transhumanist visions of substrate-independent consciousness and digital immortality. No current technology approaches the required resolution or theoretical understanding of consciousness."@en ;
    rdfs:subClassOf ngm:artificial-intelligence ;
    skos:broader ngm:artificial-intelligence ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:singularity ;
    vc:slug "mind-uploading" ;
    vc:sourceDomain "ai" .

ngm:minting a owl:Class ;
    rdfs:label "Minting"@en ;
    rdfs:comment "The protocol-governed creation of new tokens on a blockchain, which may be fungible (ERC-20) or non-fungible (ERC-721), increasing total token supply according to defined issuance rules. Minting may be permissioned (restricted to authorised smart contracts or validators), algorithmic (triggered by staking rewards or proof-of-work block production), or demand-driven (as in NFT drops), and directly determines a token's inflation schedule and economic model."@en ;
    rdfs:subClassOf ngm:bc-token-and-asset,
        ngm:blockchain-entity,
        ngm:economic-mechanism ;
    skos:broader ngm:bc-token-and-asset ;
    vc:contrastsWith ngm:deflationary-token ;
    vc:enables ngm:fungible-token,
        ngm:nft-minting,
        ngm:token-economics ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:inflation,
        ngm:token-standard,
        ngm:tokenomics ;
    vc:slug "minting" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:erc-20,
        ngm:erc-721,
        ngm:smart-contract .

ngm:mixed-reality-mr a owl:Class ;
    rdfs:label "Mixed Reality (MR)"@en ;
    rdfs:comment "Interactive environment where physical and digital elements coexist, interact bidirectionally, and dynamically influence each other in real time with advanced occlusion, lighting, and physics simulation creating seamless blended experiences."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:spatial-mesh ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:occlusion-rendering ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:hand-tracking ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:physics-simulation-engine ],
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:enables ngm:bidirectional-interaction,
        ngm:realistic-occlusion,
        ngm:shared-spatial-anchors,
        ngm:virtual-physical-collision ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:depth-camera,
        ngm:lighting-estimation,
        ngm:occlusion-rendering,
        ngm:physics-simulation-engine,
        ngm:spatial-mesh ;
    vc:isPartOf ngm:extended-reality-xr,
        ngm:spatial-computing ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:environmental-lighting,
        ngm:hand-tracking,
        ngm:object-tracking,
        ngm:real-time-3-d-reconstruction ;
    vc:slug "mixed-reality-mr" ;
    vc:sourceDomain "spatial-computing" .

ngm:mlflow a owl:Class ;
    rdfs:label "MLflow"@en ;
    rdfs:comment "MLflow is an open-source platform for managing the machine learning lifecycle, covering experiment tracking, reproducible runs, model packaging, and a model registry. It records parameters, metrics, code versions, and artefacts including checkpoints, enabling teams to compare experiments and promote models to production. It is framework-agnostic and integrates with most training libraries and serving backends."@en ;
    rdfs:subClassOf ngm:ai-infrastructure ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:checkpoints ;
    vc:slug "mlflow" ;
    vc:sourceDomain "ai" .

ngm:model-cards a owl:Class ;
    rdfs:label "Model Cards"@en ;
    rdfs:comment "Short structured documents that report the intended use, performance, limitations and ethical considerations of a machine learning model to support transparency and responsible deployment."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:transparency ],
        ngm:responsible-ai ;
    vc:enables ngm:accountability ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:transparency ;
    vc:slug "model-cards" ;
    vc:sourceDomain "machine-learning" .

ngm:model-checkpoint a owl:Class ;
    rdfs:label "Model Checkpoint"@en ;
    rdfs:comment "A model checkpoint is a serialised snapshot of a machine learning model's learned parameters (weights), often including optimiser state, captured at a point during or after training. Checkpoints allow training to resume after interruption, enable model sharing and deployment, and support evaluation of intermediate states. They are typically stored in formats such as safetensors, PyTorch .pt, or framework-native files."@en ;
    rdfs:subClassOf ngm:ai-infrastructure ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:comfy-ui-workflows,
        ngm:safetensors ;
    vc:slug "model-checkpoint" ;
    vc:sourceDomain "ai" .

ngm:model-comparison a owl:Class ;
    rdfs:label "Model Comparison"@en ;
    rdfs:comment "Model comparison is the systematic process of evaluating and contrasting multiple machine learning or AI models against a common set of tasks, datasets, and metrics to determine their relative strengths, weaknesses, and suitability for deployment. It encompasses both quantitative benchmarking and qualitative assessment of factors such as computational cost, latency, robustness, and alignment properties. Rigorous model comparison underpins reproducible research and responsible AI deployment decisions. The discipline has grown substantially as the proliferation of foundation models makes vendor-neutral evaluation increasingly critical."@en ;
    rdfs:subClassOf ngm:evaluation-metric ;
    vc:enables ngm:ai-model-card,
        ngm:model-optimisation-and-performance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:fairness-accuracy-tradeoffs,
        ngm:model-evaluation-results,
        ngm:model-performance ;
    vc:slug "model-comparison" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:benchmarks,
        ngm:evaluation-benchmarks-and-leaderboards,
        ngm:machine-learning-model .

ngm:model-depth a owl:Class ;
    rdfs:label "Model Depth"@en ;
    rdfs:comment "The count of stacked transformer layers (encoder, decoder, or both) in a neural network, governing the number of sequential representation transformations. Greater depth enables more abstract hierarchical feature learning but increases training difficulty, requiring residual connections and layer normalisation to stabilise gradient flow."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:layer-normalisation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:residual-connection ],
        ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:contrastsWith ngm:model-width ;
    vc:dependsOn ngm:hyperparameter,
        ngm:transformer ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:deep-learning,
        ngm:parameter-count ;
    vc:requires ngm:layer-normalisation,
        ngm:residual-connection ;
    vc:slug "model-depth" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:model-parameters a owl:Class ;
    rdfs:label "Model Parameters"@en ;
    rdfs:comment "The learnable internal variables — weights and biases — of a neural network that are adjusted during training to minimise a loss function. Parameter count determines model capacity; foundation models commonly operate with billions to trillions of parameters, making parameter-efficient fine-tuning and management a central concern in contemporary AI development."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:neural-network ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:training ],
        ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:artificial-intelligence,
        ngm:natural-language-processing ;
    vc:requires ngm:neural-network,
        ngm:training ;
    vc:slug "model-parameters" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:ai-technique ;
    vc:uses ngm:machine-learning .

ngm:model-registry a owl:Class ;
    rdfs:label "Model Registry"@en ;
    rdfs:comment "A model registry is a system for cataloguing trained machine learning models with their versions, metadata and lifecycle stage. It provides a central record that links a model to its training data, metrics and deployment status."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-versioning ],
        ngm:mlops ;
    vc:enables ngm:model-deployment,
        ngm:model-serving ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:data-versioning ;
    vc:slug "model-registry" ;
    vc:sourceDomain "machine-learning" .

ngm:monitoring a owl:Class ;
    rdfs:label "Monitoring"@en ;
    rdfs:comment "The continuous observation of a system's state and behaviour through collection of metrics, logs, and events to detect problems and assess health. It supports operations, reliability, and performance management."@en ;
    rdfs:subClassOf ngm:reliability-engineering ;
    vc:enables ngm:reliability-engineering ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:slug "monitoring" ;
    vc:sourceDomain "software-engineering" .

ngm:moore-s-law a owl:Class ;
    rdfs:label "Moore's Law"@en ;
    rdfs:comment "Moore's Law is the observation, articulated by Gordon Moore in 1965, that the number of transistors on an integrated circuit doubles roughly every two years, driving exponential gains in computing capability and cost-efficiency. It functioned for decades as a self-fulfilling roadmap for the semiconductor industry. Physical and economic limits have slowed transistor scaling, shifting progress toward specialised architectures and advanced packaging."@en ;
    rdfs:subClassOf ngm:hardware ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:convergence ;
    vc:slug "moore-s-law" ;
    vc:sourceDomain "infrastructure" .

ngm:motion-capture-technology a owl:Class ;
    rdfs:label "Motion Capture Technology"@en ;
    rdfs:comment "Motion Capture Technology refers to systems that record the position and orientation of physical bodies—human performers, objects, or camera rigs—in three-dimensional space, producing skeletal or marker-based data streams used to animate digital avatars, create realistic character performances, and drive real-time spatial computing applications."@en ;
    rdfs:subClassOf ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:enables ngm:animation-technique,
        ngm:avatar ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:relatedTo ngm:animation-retargeting,
        ngm:motion-capture-rig ;
    vc:slug "motion-capture-technology" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:motion-capture,
        ngm:sensor-fusion .

ngm:mu-sig-2 a owl:Class ;
    rdfs:label "MuSig2"@en ;
    rdfs:comment "A two-round multi-signature scheme based on Schnorr signatures that lets several signers produce a single aggregate signature verifiable as one key."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:schnorr-signatures ],
        ngm:multisignature ;
    vc:enables ngm:taproot ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:schnorr-signatures ;
    vc:slug "mu-sig-2" ;
    vc:sourceDomain "cryptographic" .

ngm:multimodal-models a owl:Class ;
    rdfs:label "Multimodal Models"@en ;
    rdfs:comment "Machine learning models that process and relate information from more than one modality, such as text, images, audio or video, within a single model."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:transformer ],
        ngm:multimodal-ai ;
    vc:enables ngm:text-to-image ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:transformer ;
    vc:slug "multimodal-models" ;
    vc:sourceDomain "machine-learning" .

ngm:multiverse a owl:Class ;
    rdfs:label "Multiverse"@en ;
    rdfs:comment "A network of interconnected but distinct metaverses and virtual worlds that enable cross-platform identity, asset portability, and interoperability while maintaining individual world sovereignty and distinct governance models."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:standard-format-support ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:portal-system ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cross-platform-authentication ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:federated-identity ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:identity-federation ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:interoperability-protocol ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
