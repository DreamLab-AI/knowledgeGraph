ngm:token-custody-service a owl:Class ;
    rdfs:label "Token Custody Service"@en ;
    rdfs:comment "A secure infrastructure system for safeguarding digital tokens and cryptographic assets through multi-signature wallets, cold storage, and enterprise-grade custodial services in virtual economy environments."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:security-module ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptographic-key-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:access-control-system ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:multi-signature-wallet ],
        ngm:sc-governance-and-safety ;
    skos:broader ngm:sc-governance-and-safety ;
    vc:enables ngm:asset-recovery,
        ngm:institutional-trading,
        ngm:regulatory-compliance,
        ngm:secure-token-storage ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:audit-trail-system,
        ngm:cold-storage-system,
        ngm:key-management-service,
        ngm:multi-signature-wallet ;
    vc:isPartOf ngm:digital-asset-infrastructure ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:access-control-system,
        ngm:cryptographic-key-management,
        ngm:security-module ;
    vc:slug "token-custody-service" ;
    vc:sourceDomain "spatial-computing" .

