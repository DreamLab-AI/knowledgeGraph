ngm:eu-ai-act-regulatory-instrument a owl:Class ;
    rdfs:label "EU AI Act Regulatory Instrument"@en ;
    rdfs:comment "The EU AI Act (Regulation (EU) 2024/1689) is the European Union's comprehensive, legally binding horizontal regulation for artificial intelligence, establishing a four-tier risk-based classification system that prohibits certain AI practices outright, imposes strict pre-market conformity obligations on high-risk AI systems, mandates transparency duties for limited-risk AI, and introduces a dedicated governance regime for general-purpose AI models. Published in the Official Journal in July 2024 and progressively entering into force through 2025–2027, it represents the world's first binding horizontal AI law and creates a de facto global compliance benchmark through its extraterritorial scope. Enforcement is shared between national market surveillance authorities, the European AI Office, and the European AI Board, with penalties reaching up to €35 million or 7% of global annual turnover."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:technical-documentation ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:ai-office ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:notified-body ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:human-oversight ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:conformity-assessment ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:high-risk-ai-system ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:prohibited-ai-practice ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:risk-assessment ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:general-purpose-ai-model ],
        ngm:ai-regulation ;
    vc:bridgesTo ngm:biometric-identification,
        ngm:foundation-model,
        ngm:large-language-model ;
    vc:contrastsWith ngm:us-ai-executive-order ;
    vc:dependsOn ngm:gdpr ;
    vc:enables ngm:ai-governance-framework,
        ngm:regulatory-compliance,
        ngm:trustworthy-ai ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:ai-office,
        ngm:general-purpose-ai-model,
        ngm:high-risk-ai-system,
        ngm:prohibited-ai-practice ;
    vc:qualityScore "0.76"^^xsd:float ;
    vc:relatedTo ngm:ai-ethics,
        ngm:ai-governance,
        ngm:algorithmic-accountability,
        ngm:brussels-effect ;
    vc:requires ngm:conformity-assessment,
