ngm:iec-61511 a owl:Class ;
    rdfs:label "Iec 61511"@en ;
    rdfs:comment "IEC 61511 is an international standard for the functional safety of safety instrumented systems in the process industry sector. It applies the generic principles of IEC 61508 to end users and integrators, defining a safety lifecycle that spans hazard and risk assessment, allocation of safety functions to protection layers, and verification against target safety integrity levels. It is the dominant reference for emergency shutdown and high-integrity protection systems on process plant."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:risk-assessment ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:hazard-analysis ],
        ngm:functional-safety ;
    vc:contrastsWith ngm:iec-62443,
        ngm:safety-standard ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:standards ;
    vc:qualityScore "0.62"^^xsd:float ;
