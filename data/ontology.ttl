    vc:requires ngm:activation-function,
        ngm:backpropagation ;
    vc:slug "neural-network-layer" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:batch-normalisation .

ngm:public-goods-funding a owl:Class ;
    rdfs:label "Public Goods Funding"@en ;
    rdfs:comment "Public goods funding refers to mechanisms that finance resources which are non-excludable and non-rival — meaning consumption by one party does not diminish availability to others and exclusion is impractical. In decentralised ecosystems, on-chain coordination primitives such as quadratic funding, retroactive grants, and DAO-managed treasuries are used to allocate capital towards open-source software, protocol research, and shared infrastructure. These mechanisms attempt to correct the market failure of under-provision that arises when contributors cannot capture sufficient private value from their public-benefit work."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:retroactive-public-goods-funding ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:quadratic-funding ],
        ngm:bc-defi-and-economics ;
    skos:broader ngm:bc-defi-and-economics ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:quadratic-funding,
        ngm:retroactive-public-goods-funding ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:quadratic-voting,
        ngm:smart-contract ;
    vc:slug "public-goods-funding" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:dao,
        ngm:treasury-management .

ngm:random-number-generation a owl:Class ;
    rdfs:label "Random Number Generation"@en ;
    rdfs:comment "The process of generating unpredictable and statistically random values for cryptographic operations, serving as a critical security primitive for key generation, nonces, and protocol initialization, distinguishing between true randomness from physical entropy sources and pseudo-randomness from d..."@en ;
    rdfs:subClassOf ngm:bc-cryptographic-primitive ;
    skos:broader ngm:bc-cryptographic-primitive ;
