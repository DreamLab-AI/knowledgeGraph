ngm:w-3-c-did-core-1-0 a owl:Class ;
    rdfs:label "W3C DID Core 1.0"@en ;
    rdfs:comment "W3C DID Core 1.0 specifies decentralised identifiers, a type of identifier that enables verifiable, self-sovereign digital identity independent of centralised registries."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:w3-c ],
        ngm:technical-standard ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:w3-c ;
    vc:slug "w-3-c-did-core-1-0" ;
    vc:sourceDomain "standards" .

ngm:w-3-c-standard a owl:Class ;
    rdfs:label "W3C Standard"@en ;
    rdfs:comment "A W3C Standard is a specification published as a Recommendation by the World Wide Web Consortium."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:w3-c ],
        ngm:technical-standard ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:w3-c ;
    vc:slug "w-3-c-standard" ;
    vc:sourceDomain "standards" .

ngm:w-3-c-verifiable-credentials-data-model-v-2-0 a owl:Class ;
    rdfs:label "W3C Verifiable Credentials Data Model v2.0"@en ;
    rdfs:comment "Version 2.0 of the W3C Verifiable Credentials Data Model specifies a data model for cryptographically verifiable claims exchanged between issuers, holders and verifiers."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:w3-c ],
        ngm:technical-standard ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:w3-c ;
    vc:slug "w-3-c-verifiable-credentials-data-model-v-2-0" ;
    vc:sourceDomain "standards" .

ngm:w-3-c-web-xr-device-api a owl:Class ;
    rdfs:label "W3C WebXR Device API"@en ;
    rdfs:comment "The W3C WebXR Device API specifies an interface for accessing virtual reality and augmented reality devices, including sensors and head-mounted displays, in Web applications."@en ;
