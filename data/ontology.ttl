    vcw:owlRole "Concept" .

# Virtual Reality VR
spatial-computing:VirtualRealityVR rdf:type owl:Class ;
    rdfs:subClassOf spatial-computing:ExtendedReality ;
    rdfs:label "Virtual Reality VR"@en ;
    rdfs:comment "An immersive technology that uses head-mounted displays and motion tracking to create fully simulated 3D environments, enabling users to experience and interact with computer-generated worlds through visual, auditory, and haptic feedback while isolated from the physical environment."@en ;
    skos:prefLabel "Virtual Reality VR"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:spatial-computing:virtual-reality-vr" ;
    owl:sameAs <urn:visionclaw:concept:spatial-computing:virtual-reality-vr> ;
