# Membership Inference
artificial-intelligence:MembershipInference rdf:type owl:Class ;
    rdfs:label "Membership Inference"@en ;
    rdfs:comment "A privacy attack that determines whether a specific data point was included in a model's training dataset by analyzing the model's behavior on that input, potentially revealing sensitive information about individuals' participation in datasets."@en ;
    skos:prefLabel "Membership Inference"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:artificial-intelligence:membership-inference" ;
    owl:sameAs <urn:visionclaw:concept:artificial-intelligence:membership-inference> ;
    vcw:contentHash "sha256-12-a356e62c0a54" ;
    vcw:qualityScore "0.5"^^xsd:decimal ;
    vcw:legacyTermId "AI-0087" ;
    vcw:ontologyStatus "draft" ;
    vcw:maturityLevel "draft" ;
    vcw:authorityScore "0.0"^^xsd:decimal ;
    dcterms:identifier "AI-0087" ;
    dcterms:subject "artificial-intelligence" ;
    owl:versionInfo "2.0.0" ;
    dcterms:created "2026-04-26T00:00:00Z"^^xsd:dateTime ;
    dcterms:modified "2026-04-26T13:00:00Z"^^xsd:dateTime ;
    vcw:owlRole "Concept" .

# Backdoor Attack
artificial-intelligence:BackdoorAttack rdf:type owl:Class ;
    rdfs:label "Backdoor Attack"@en ;
    rdfs:comment "A training-time attack that embeds a hidden trigger pattern into an AI model, causing the model to behave normally on standard inputs but produce attacker-chosen outputs when the trigger is present, creating a covert vulnerability exploitable post-deployment."@en ;
    skos:prefLabel "Backdoor Attack"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:artificial-intelligence:backdoor-attack" ;
    owl:sameAs <urn:visionclaw:concept:artificial-intelligence:backdoor-attack> ;
    vcw:contentHash "sha256-12-dcb3ce603842" ;
    vcw:qualityScore "0.5"^^xsd:decimal ;
    vcw:legacyTermId "AI-0088" ;
    vcw:ontologyStatus "draft" ;
    vcw:maturityLevel "draft" ;
    vcw:authorityScore "0.0"^^xsd:decimal ;
    dcterms:identifier "AI-0088" ;
    dcterms:subject "artificial-intelligence" ;
    owl:versionInfo "2.0.0" ;
    dcterms:created "2026-04-26T00:00:00Z"^^xsd:dateTime ;
    dcterms:modified "2026-04-26T13:00:00Z"^^xsd:dateTime ;
    vcw:owlRole "Concept" .

# Trojan Attack
spatial-computing:TrojanAttack rdf:type owl:Class ;
    rdfs:label "Trojan Attack"@en ;
    rdfs:comment "A backdoor attack on AI models, often emphasizing supply chain compromise, where a pre-trained model or training pipeline is maliciously modified to contain hidden triggers that cause specific attacker-defined behaviors when activated, while maintaining normal performance otherwise."@en ;
    skos:prefLabel "Trojan Attack"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:spatial-computing:trojan-attack" ;
    owl:sameAs <urn:visionclaw:concept:spatial-computing:trojan-attack> ;
    vcw:contentHash "sha256-12-d790dc1f6313" ;
    vcw:qualityScore "0.5"^^xsd:decimal ;
    vcw:legacyTermId "AI-0089" ;
    vcw:ontologyStatus "draft" ;
    vcw:maturityLevel "draft" ;
    vcw:authorityScore "0.0"^^xsd:decimal ;
    dcterms:identifier "AI-0089" ;
    dcterms:subject "spatial-computing" ;
    owl:versionInfo "2.0.0" ;
    dcterms:created "2026-04-26T00:00:00Z"^^xsd:dateTime ;
    dcterms:modified "2026-04-26T13:00:00Z"^^xsd:dateTime ;
    vcw:owlRole "Concept" .

# Model Extraction
artificial-intelligence:ModelExtraction rdf:type owl:Class ;
    rdfs:label "Model Extraction"@en ;
    rdfs:comment "An attack where adversaries reconstruct a functionally equivalent or similar machine learning model by systematically querying a target model and training a substitute model on the collected input-output pairs, enabling theft of intellectual property, privacy violations, and subsequent attacks."@en ;
    skos:prefLabel "Model Extraction"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:artificial-intelligence:model-extraction" ;
    owl:sameAs <urn:visionclaw:concept:artificial-intelligence:model-extraction> ;
    vcw:contentHash "sha256-12-bb3a112e1666" ;
    vcw:qualityScore "0.5"^^xsd:decimal ;
    vcw:legacyTermId "AI-0090" ;
    vcw:ontologyStatus "draft" ;
    vcw:maturityLevel "draft" ;
    vcw:authorityScore "0.0"^^xsd:decimal ;
    dcterms:identifier "AI-0090" ;
    dcterms:subject "artificial-intelligence" ;
    owl:versionInfo "2.0.0" ;
    dcterms:created "2026-04-26T00:00:00Z"^^xsd:dateTime ;
    dcterms:modified "2026-04-26T13:00:00Z"^^xsd:dateTime ;
    vcw:owlRole "Concept" .

