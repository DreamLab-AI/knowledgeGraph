ngm:active-learning a owl:Class ;
    rdfs:label "Active Learning"@en ;
    rdfs:comment "Machine learning paradigm where algorithms actively select which unlabeled examples from large data pools to query for human annotation rather than passively accepting randomly labeled datasets, optimizing informativeness through query strategies (uncertainty sampling selecting least-confident pr..."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
