        ngm:de-fi-protocol ;
    skos:broader ngm:bc-network-component ;
    vc:enables ngm:wrapped-token ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:implements ngm:cross-chain-bridge ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires ngm:blockchain-oracle ;
    vc:slug "lock-and-mint-mechanism" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:smart-contract .

ngm:long-range-navigation a owl:Class ;
    rdfs:label "Long-Range Navigation"@en ;
    rdfs:comment "Long-range navigation is the capability of an autonomous agent to plan and execute travel over large distances and extended time horizons, beyond the range of local sensors. It typically fuses global positioning, topological or metric maps, and waypoint planning to maintain a coherent route across kilometre-scale or larger environments. It contrasts with short-range reactive navigation by emphasising global consistency and goal-directed path planning."@en ;
    rdfs:subClassOf ngm:robo-navigation-and-planning ;
    skos:broader ngm:robo-navigation-and-planning ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:gps,
        ngm:topological-map ;
    vc:slug "long-range-navigation" ;
    vc:sourceDomain "robotics" .

ngm:long-short-term-memory a owl:Class ;
    rdfs:label "Long Short Term Memory"@en ;
    rdfs:comment "Long Short-Term Memory (LSTM) is a specialised recurrent neural network architecture introduced by Hochreiter and Schmidhuber (1997) that mitigates the vanishing gradient problem through gating mechanisms—input, forget, and output gates—enabling selective retention or forgetting of information across long sequences. LSTMs underpin sequence modelling tasks in natural language processing, time-series forecasting, and speech recognition, though they have largely been superseded by Transformer architectures for large-scale language tasks."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:backpropagation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:deep-learning ],
        ngm:ai-model-architecture,
        ngm:recurrent-neural-network ;
    skos:broader ngm:ai-model-architecture ;
    vc:contrastsWith ngm:attention,
        ngm:transformer ;
    vc:enables ngm:natural-language-processing ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:ai-model-architecture,
        ngm:recurrent-neural-network ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires ngm:backpropagation,
        ngm:deep-learning ;
    vc:slug "long-short-term-memory" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:longtermism a owl:Class ;
    rdfs:label "Longtermism"@en ;
    rdfs:comment "Longtermism is an ethical position holding that positively influencing the long-term future is a key moral priority of our time, grounded in the claims that future people matter morally, that the future may contain vastly more people than the present, and that present actions can foreseeably shape their welfare. It motivates particular concern for reducing existential and catastrophic risks, safeguarding civilisational trajectory, and preserving option value for future generations. As a strand of effective altruism and applied ethics, longtermism informs governance debates on emerging technologies, biosecurity, and the safe development of advanced artificial intelligence."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:risk-assessment ],
        ngm:ethics ;
    vc:bridgesTo ngm:ai-alignment,
        ngm:global-priorities-research ;
    vc:contrastsWith ngm:person-affecting-view,
        ngm:short-termism ;
    vc:dependsOn ngm:moral-philosophy,
        ngm:utilitarianism ;
    vc:enables ngm:long-term-governance,
        ngm:technology-policy ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:catastrophic-risk,
        ngm:effective-altruism,
        ngm:intergenerational-equity ;
    vc:requires ngm:forecasting,
        ngm:risk-assessment ;
    vc:slug "longtermism" ;
    vc:sourceDomain "governance" ;
    vc:supports ngm:ai-safety,
        ngm:biosecurity,
        ngm:existential-risk .

ngm:lora-fine-tuning a skos:Concept ;
    rdfs:label "Lora Fine Tuning"@en .

ngm:low-energy-consumption a owl:Class ;
    rdfs:label "Low Energy Consumption"@en ;
    rdfs:comment "Low Energy Consumption characterises blockchain consensus mechanisms, particularly Proof-of-Stake and BFT variants, that achieve network security through economic staking rather than computational work, consuming orders of magnitude less electricity than Proof-of-Work systems. This property is a primary driver of blockchain sustainability assessments and ESG compliance, enabling networks to operate at scale without significant environmental impact."@en ;
    rdfs:subClassOf ngm:bc-governance-and-regulation,
        ngm:blockchain-energy-consumption ;
    skos:broader ngm:bc-governance-and-regulation ;
    vc:contrastsWith ngm:high-energy-consumption,
        ngm:mining,
        ngm:proof-of-work ;
    vc:enables ngm:blockchain-sustainability,
        ngm:esg-reporting ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:carbon-footprint-measurement,
        ngm:proof-of-stake,
        ngm:proof-of-stake-sustainability,
        ngm:sustainability ;
    vc:slug "low-energy-consumption" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:esg-investing,
        ngm:renewable-energy-certificates .

ngm:loyalty-token a owl:Class ;
    rdfs:label "Loyalty Token"@en ;
    rdfs:comment "A digital token granting repeat-use or membership rewards within a metaverse ecosystem, enabling customer engagement, brand loyalty programs, and tokenized incentive mechanisms."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
