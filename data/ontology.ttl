    vc:enables ngm:agentic-ai,
        ngm:applied-machine-learning,
        ngm:instruction-tuning ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:fast-ai,
        ngm:fasthtml,
        ngm:fsdp-qlora,
        ngm:solveit ;
    vc:qualityScore "0.82"^^xsd:float ;
