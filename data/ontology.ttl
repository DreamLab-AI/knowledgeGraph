ngm:ai-core-concepts a owl:Class ;
    rdfs:label "ai core concepts"@en ;
    rdfs:comment "Foundational artificial intelligence technologies — including machine learning paradigms (supervised, unsupervised, reinforcement), neural architectures (neural networks, transformers, CNNs), generative models, and classical symbolic reasoning — that collectively enable intelligent system behaviour. In metaverse contexts these concepts drive NPC dialogue, environment perception, procedural content generation, and federated privacy-preserving learning."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:generative-ai ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:machine-learning ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:reinforcement-learning ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:neural-network ],
        ngm:ai-research-area ;
    skos:broader ngm:ai-research-area ;
    vc:enables ngm:computer-vision,
        ngm:inference,
        ngm:natural-language-processing ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:generative-ai,
        ngm:machine-learning,
        ngm:neural-network,
        ngm:reinforcement-learning ;
    vc:qualityScore "0.4"^^xsd:float ;
    vc:slug "ai-core-concepts" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:data-pipeline,
        ngm:federated-learning .

