    vc:relatedTo ngm:semantic-search ;
    vc:slug "query-encoder" ;
    vc:sourceDomain "ai" .
ngm:query-engine a owl:Class ;
    rdfs:comment "A query engine is the software component that parses, plans, optimises, and executes declarative queries against one or more data stores, returning result sets to callers. It transforms a high-level query into an efficient physical execution plan using statistics, indexes, and cost models, and may operate over a single database, a data warehouse, or federated sources, forming the computational core of database and analytics systems."@en ;
    rdfs:label "Query Engine"@en ;
    rdfs:subClassOf ngm:database-system ;
    rdfs:subClassOf _:r17496 ;
