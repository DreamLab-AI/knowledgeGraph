ngm:error-recovery a owl:Class ;
    rdfs:comment "Error recovery is the set of mechanisms by which a system detects that an operation has failed or produced an invalid state and restores correct operation, through techniques such as retries with exponential backoff, checkpointing and rollback, compensating actions, graceful degradation, and escalation to human oversight. In autonomous agent systems it distinguishes robust task execution from brittle scripted automation, and in interaction design it covers helping users notice, diagnose, and undo their own mistakes."@en ;
    rdfs:label "Error Recovery"@en ;
    rdfs:subClassOf ngm:fault-tolerance ;
