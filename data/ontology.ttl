ngm:linear-encoder a owl:Class ;
    rdfs:label "Linear Encoder"@en ;
    rdfs:comment "A Linear Encoder is a position sensing device that measures linear (translational) displacement along a single axis by converting physical motion into an electrical signal — typically a series of digital pulses or an analogue waveform — that a controller can interpret as position, velocity, or acceleration data. Linear encoders may be optical (using a diffraction grating or glass scale), magnetic (using a magnetised tape), or capacitive, with resolution ranging from micrometres to nanometres in precision metrology applications. They are essential feedback elements in CNC machine tools, semiconductor lithography stages, and high-precision robotic manipulators where closed-loop positional accuracy is required."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:feedback-control ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:sensor ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:calibration ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:sensor-technology ],
        ngm:encoder,
        ngm:robo-perception ;
    skos:broader ngm:robo-perception ;
    vc:enables ngm:motion-control,
        ngm:position-control,
        ngm:servo-control ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:sensor,
        ngm:sensor-technology ;
    vc:isPartOf ngm:control-system,
        ngm:robot-hardware ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:industrial-robot,
        ngm:kinematics,
        ngm:robot-joint,
        ngm:robot-sensor,
        ngm:servo-motor ;
    vc:requires ngm:calibration,
        ngm:feedback-control ;
    vc:slug "linear-encoder" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:feedback-loop,
        ngm:feedback-mechanism .

