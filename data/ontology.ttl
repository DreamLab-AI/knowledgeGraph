ngm:distributed-protocol a owl:Class ;
    rdfs:label "Distributed Protocol"@en ;
    rdfs:comment "A Distributed Protocol is a formally specified set of rules, message formats, and procedures governing communication, coordination, and state synchronization among independent nodes in a distributed network without centralized control."@en ;
