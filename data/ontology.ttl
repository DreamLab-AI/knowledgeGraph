        ngm:virtual-museum-tour ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:digital-modeling,
        ngm:simulation-software ;
    vc:slug "virtual-replica" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:3-d-modeling,
        ngm:photogrammetry,
        ngm:simulation .

