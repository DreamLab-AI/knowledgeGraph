ngm:did-document a owl:Class ;
    rdfs:label "DID Document"@en ;
    rdfs:comment "A DID Document is a JSON-LD resource associated with a Decentralised Identifier (DID) that expresses the DID subject's cryptographic public keys, authentication methods, assertion methods, key agreement protocols, and service endpoints. Resolved from a DID via a DID method-specific read operation, a DID Document enables verifiers to discover how to authenticate with, or communicate securely to, the DID subject without relying on a centralised registry. DID Documents are specified by the W3C DID Core standard and are a foundational component of self-sovereign identity and verifiable credential ecosystems."@en ;
    rdfs:subClassOf ngm:bc-cryptographic-primitive ;
    skos:broader ngm:bc-cryptographic-primitive ;
    vc:enables ngm:self-sovereign-identity,
        ngm:verifiable-credentials ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:digital-identity,
        ngm:identity-verification ;
    vc:slug "did-document" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:json-ld,
        ngm:public-key-cryptography .

ngm:edge-ai-system a owl:Class ;
    rdfs:label "Edge AI System"@en ;
    rdfs:comment "An Edge AI System is a distributed computing architecture that deploys trained machine learning models directly onto edge devices, sensors, and gateways at the network periphery, enabling local inference without requiring continuous cloud connectivity. Processing occurs close to the data source, achieving sub-millisecond latency, reduced bandwidth consumption, and enhanced data privacy. Edge AI Systems must fit within the memory, power, and computational constraints of embedded hardware through model compression techniques such as quantisation, pruning, and knowledge distillation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:embedded-systems ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:real-time-inference-at-edge ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:neural-network-quantisation ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:sensor ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:edge-ai-accelerator ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:model-compression-for-edge ],
        ngm:ai-infrastructure ;
    vc:dependsOn ngm:edge-computing-architecture,
        ngm:machine-learning-model ;
    vc:enables ngm:autonomous-system,
        ngm:latency-aware-edge-ai,
        ngm:on-device-learning ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:edge-ai-accelerator,
        ngm:embedded-systems,
        ngm:sensor ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:computer-vision,
        ngm:edge-cloud-collaboration,
        ngm:internet-of-things ;
    vc:requires ngm:model-compression-for-edge,
        ngm:neural-network-quantisation,
        ngm:real-time-inference-at-edge ;
    vc:slug "edge-ai-system" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:embedded-ai-frameworks,
        ngm:federated-edge-learning .

ngm:embodied-ai a owl:Class ;
    rdfs:label "Embodied AI"@en ;
    rdfs:comment "Embodied AI is a research paradigm holding that intelligence emerges from the continuous sensorimotor interaction of an agent with its physical or simulated environment, rather than from purely symbolic or language-based reasoning. Embodied agents perceive the world through sensors (cameras, proprioceptive IMUs, tactile arrays) and act upon it through actuators, learning to navigate, manipulate, and cooperate via reinforcement learning or imitation learning in physics simulators. The field bridges robotics, cognitive science, and deep learning, with applications in household manipulation, autonomous navigation, and grounded language understanding."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:simulation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:reinforcement-learning ],
        ngm:ai-research-area ;
    skos:broader ngm:ai-research-area ;
    vc:enables ngm:robot-learning,
        ngm:sim-to-real-transfer ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:embodied-ai-simulation,
        ngm:robotics ;
    vc:requires ngm:reinforcement-learning,
        ngm:simulation ;
    vc:slug "embodied-ai" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:event-driven-architecture a owl:Class ;
    rdfs:label "Event Driven Architecture"@en ;
    rdfs:comment "A software architecture pattern for metaverse systems built from decoupled services that publish, consume, and route events representing state changes, enabling real-time responsiveness, independent scaling, and resilient distributed systems for immersive virtual experiences."@en ;
    rdfs:subClassOf ngm:sc-platform-and-environment,
