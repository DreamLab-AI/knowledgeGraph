ngm:range-proof a owl:Class ;
    rdfs:label "Range Proof"@en ;
    rdfs:comment "A range proof is a cryptographic zero-knowledge protocol that allows a prover to convince a verifier that a committed secret value lies within a specified numeric interval, without revealing the value itself. It is essential to confidential transaction systems, where amounts are hidden inside commitments yet must be proven non-negative to prevent inflation via negative-value forgery. Modern constructions such as Bulletproofs achieve compact, logarithmic-sized proofs without a trusted setup, making range proofs practical for on-chain privacy."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:pedersen-commitment ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:commitment-scheme ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptography ],
        ngm:zero-knowledge-proof ;
    vc:bridgesTo ngm:privacy ;
    vc:enables ngm:confidential-transactions,
        ngm:privacy ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:bulletproofs ;
    vc:isPartOf ngm:confidential-transactions ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:cryptographic-proof,
        ngm:zero-knowledge-proof ;
    vc:requires ngm:commitment-scheme,
        ngm:cryptography,
        ngm:pedersen-commitment ;
    vc:slug "range-proof" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:liquid-network,
        ngm:monero ;
    vc:uses ngm:cryptographic-primitive,
        ngm:pedersen-commitment .

ngm:raw-data a owl:Class ;
    rdfs:label "Raw Data"@en ;
    rdfs:comment "Raw data is unprocessed information as originally collected from a source, before cleaning, transformation, aggregation or annotation. It may be noisy, inconsistent, redundant or incomplete, and typically lacks the structure and quality guarantees of processed data. Raw data forms the input to data pipelines, where it is ingested, validated and transformed into usable, analysis-ready forms."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-collection ],
        ngm:data ;
    vc:bridgesTo ngm:data-transformation ;
    vc:contrastsWith ngm:metadata ;
    vc:dependsOn ngm:data-collection ;
    vc:enables ngm:data-pipeline,
        ngm:data-processing ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:data-collection ;
    vc:isPartOf ngm:data ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:data-ingestion,
        ngm:data-quality ;
    vc:requires ngm:data-collection ;
    vc:slug "raw-data" ;
    vc:sourceDomain "data" ;
    vc:supports ngm:data-annotation,
        ngm:information-extraction ;
    vc:uses ngm:sensor-data .

ngm:rb-0037-dexterity a owl:Class ;
    rdfs:label "rb 0037 dexterity"@en ;
    rdfs:comment "Dexterity, in robotics, is the ability of a manipulator to achieve a broad range of end-effector orientations and positions within its workspace, particularly in the vicinity of a given point, without encountering kinematic singularities. It is quantified by measures such as the Jacobian condition number, manipulability ellipsoid volume, or isotropy index. High dexterity enables a robot arm to approach objects from many angles, reconfigure during a task, and avoid joint limits — properties critical for assembly, surgery, and unstructured manipulation tasks."@en ;
    rdfs:subClassOf ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:dependsOn ngm:rb-0029-inverse-kinematics,
        ngm:rb-0030-jacobian-matrix ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:rb-0023-degrees-of-freedom,
        ngm:rb-0024-workspace,
        ngm:rb-0031-singularity,
        ngm:rb-0032-manipulability ;
    vc:slug "rb-0037-dexterity" ;
    vc:sourceDomain "robotics" ;
    vc:supports ngm:end-effector,
        ngm:manipulation .

ngm:rb-0038-compliance a owl:Class ;
    rdfs:label "rb 0038 compliance"@en ;
    rdfs:comment "In robotics, compliance is the mechanical property of a robot joint or end-effector describing its tendency to yield under applied forces or torques, quantified as the inverse of stiffness. Compliant behaviour is essential for safe human-robot interaction, allowing robots to absorb contact forces without rigid collision, and is actively exploited in impedance and admittance control strategies to achieve gentle, force-sensitive manipulation."@en ;
    rdfs:subClassOf ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:contrastsWith ngm:rb-0039-stiffness ;
    vc:enables ngm:human-robot-interaction,
        ngm:rb-0053-force-control ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:rb-0026-robot-joint,
        ngm:rb-0041-inertia,
        ngm:rb-0056-impedance-control,
        ngm:rb-0057-admittance-control ;
    vc:slug "rb-0038-compliance" ;
    vc:sourceDomain "robotics" ;
    vc:supports ngm:robot-safety .

ngm:rb-0045-acceleration a owl:Class ;
    rdfs:label "rb 0045 acceleration"@en ;
    rdfs:comment "In robotics, acceleration is the rate of change of velocity with respect to time, expressed for each joint (joint-space acceleration) or for the robot's end-effector (task-space acceleration), measured in rad/s² or m/s² respectively. Acceleration profiles govern the dynamic forces and torques that a manipulator must generate, coupling directly into Newton-Euler equations of motion. Limiting acceleration is central to safety (reducing impact forces) and to trajectory smoothness in collaborative applications."@en ;
    rdfs:subClassOf ngm:newton-euler-dynamics,
        ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:dependsOn ngm:rb-0021-robot-kinematics,
        ngm:rb-0030-jacobian-matrix ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:rb-0022-robot-dynamics,
        ngm:rb-0041-inertia,
        ngm:rb-0043-torque,
        ngm:rb-0044-velocity ;
    vc:slug "rb-0045-acceleration" ;
    vc:sourceDomain "robotics" ;
    vc:supports ngm:rb-0051-trajectory-planning,
        ngm:rb-0094-power-and-force-limiting .

ngm:rb-0060-optimal-control a owl:Class ;
    rdfs:label "rb 0060 optimal control"@en ;
    rdfs:comment "Optimal control is a branch of control theory that computes control inputs minimising (or maximising) a performance criterion — such as energy consumption, time, or tracking error — subject to system dynamics and constraints. In robotics, optimal control underpins trajectory optimisation, model predictive control, and reinforcement learning-based policy synthesis."@en ;
    rdfs:subClassOf ngm:control-theory,
        ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:dependsOn ngm:rb-0064-computed-torque-control ;
    vc:enables ngm:rb-0051-trajectory-planning,
        ngm:trajectory-planning ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:rb-0047-feedback-control,
        ngm:rb-0062-model-predictive-control,
        ngm:reinforcement-learning ;
    vc:slug "rb-0060-optimal-control" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:rb-0022-robot-dynamics,
        ngm:rb-0030-jacobian-matrix .

ngm:rb-0063-sliding-mode-control a owl:Class ;
    rdfs:label "rb 0063 sliding mode control"@en ;
    rdfs:comment "Sliding Mode Control (SMC) is a nonlinear robust control technique that drives system states onto a predefined sliding surface in state space and then maintains them on that surface using discontinuous (switching) control actions. Once on the sliding manifold, the system dynamics become insensitive to matched disturbances and parameter uncertainties, making SMC highly robust for robot manipulators with uncertain dynamics, friction, and external loads. A key challenge is chattering — high-frequency oscillation caused by the switching law — which is addressed through boundary layer methods and higher-order SMC variants."@en ;
    rdfs:subClassOf ngm:control-theory,
        ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:contrastsWith ngm:rb-0062-model-predictive-control ;
    vc:dependsOn ngm:rb-0022-robot-dynamics ;
    vc:enables ngm:rb-0053-force-control,
        ngm:rb-0054-position-control ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:adaptive-control,
        ngm:rb-0048-pid-controller,
        ngm:rb-0061-nonlinear-control,
        ngm:robust-control ;
    vc:slug "rb-0063-sliding-mode-control" ;
    vc:sourceDomain "robotics" .

ngm:rb-0101-performance-level a owl:Class ;
    rdfs:label "rb 0101 performance level"@en ;
    rdfs:comment "Performance Level (PL) is a discrete safety metric defined in ISO 13849-1 that quantifies the ability of a safety-related control system to perform a safety function under foreseeable conditions. Levels range from PLa (lowest) to PLe (highest), each corresponding to a target probability of dangerous failure per hour. PL is determined through risk assessment and verified against the required PL (PLr) derived from the hazard and risk analysis of the application."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:rb-0090-emergency-stop ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:rb-0087-safety-standard ],
        ngm:robo-safety-and-standards ;
    skos:broader ngm:robo-safety-and-standards ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:functional-safety,
        ngm:rb-0089-risk-assessment,
        ngm:rb-0100-safety-integrity-level ;
    vc:requires ngm:rb-0087-safety-standard,
        ngm:rb-0090-emergency-stop ;
    vc:slug "rb-0101-performance-level" ;
    vc:sourceDomain "robotics" ;
    vc:standardizedBy ngm:iec-61508,
        ngm:iso-10218 ;
    vc:supports ngm:rb-0096-safeguarding .

ngm:rb-0104-hand-guiding a owl:Class ;
    rdfs:label "rb 0104 hand guiding"@en ;
    rdfs:comment "Hand guiding is a collaborative robot operation mode in which an operator physically moves the robot arm by direct physical contact, typically through a dedicated hand-guiding device, while the robot's safety systems monitor force, speed, and separation. It is one of four collaborative operation modes defined in ISO/TS 15066 and ISO 10218, enabling intuitive programming-by-demonstration and safe human-robot co-manipulation tasks."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:rb-0067-force-torque-sensor ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:rb-0056-impedance-control ],
        ngm:human-robot-interaction,
        ngm:robo-human-robot-interaction ;
    skos:broader ngm:robo-human-robot-interaction ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:rb-0103-collaborative-operation ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:end-effector,
        ngm:rb-0007-collaborative-robot,
        ngm:rb-0094-power-and-force-limiting,
        ngm:rb-0105-speed-and-separation-monitoring ;
    vc:requires ngm:rb-0056-impedance-control,
        ngm:rb-0067-force-torque-sensor ;
    vc:slug "rb-0104-hand-guiding" ;
    vc:sourceDomain "robotics" ;
    vc:standardizedBy ngm:iso-ts-15066 .

ngm:rdf-store a owl:Class ;
    rdfs:label "RDF Store"@en ;
    rdfs:comment "A database designed to store and query data expressed as Resource Description Framework triples, typically supporting the SPARQL query language. Also called a triplestore, it manages subject-predicate-object statements rather than rows and tables."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:rdf ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:sparql ],
        ngm:rdf ;
    vc:enables ngm:data-integration,
        ngm:knowledge-graph ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:rdf,
        ngm:sparql ;
    vc:slug "rdf-store" ;
    vc:sourceDomain "data" .

ngm:rdf-xml a owl:Class ;
    rdfs:label "Rdf Xml"@en ;
    rdfs:comment "RDF/XML is the original World Wide Web Consortium serialisation format for the Resource Description Framework, expressing RDF triples as XML documents. It encodes subjects, predicates, and objects using XML elements and attributes, making RDF data parseable by generic XML tooling. Although verbose and historically awkward to read, it remains a standardised interchange format alongside more concise alternatives such as Turtle and JSON-LD."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:xml ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:xml ],
        ngm:rdf ;
    vc:bridgesTo ngm:structured-data ;
    vc:contrastsWith ngm:n-triples,
        ngm:turtle ;
    vc:enables ngm:interoperability,
        ngm:linked-data ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:xml ;
    vc:implements ngm:rdf ;
    vc:isPartOf ngm:rdf ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:metadata,
        ngm:ontology,
        ngm:sparql ;
    vc:requires ngm:xml ;
    vc:slug "rdf-xml" ;
    vc:sourceDomain "data" ;
    vc:standardizedBy ngm:standards ;
    vc:supports ngm:knowledge-graph,
        ngm:semantic-web ;
    vc:uses ngm:data-format,
        ngm:xml .

ngm:react-prompting a owl:Class ;
    rdfs:label "React Prompting"@en ;
    rdfs:comment "ReAct prompting is a prompting strategy that interleaves verbal reasoning traces with discrete actions, enabling a language model to think step by step while interacting with external tools or environments. The model alternates between generating a thought, taking an action such as a search or API call, and observing the result, then folding that observation back into subsequent reasoning. This synergy of reasoning and acting reduces hallucination and grounds the model's conclusions in retrieved evidence."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:large-language-model ],
        ngm:prompt-engineering ;
    vc:contrastsWith ngm:chain-of-thought-reasoning ;
    vc:enables ngm:agentic-ai,
        ngm:autonomous-task-execution,
        ngm:tool-use ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:prompt-engineering ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:chain-of-thought-reasoning,
        ngm:few-shot-learning,
        ngm:in-context-learning,
        ngm:reasoning ;
    vc:requires ngm:large-language-model ;
    vc:slug "react-prompting" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:ai-agent ;
    vc:uses ngm:large-language-model,
        ngm:tool-use .

ngm:real-time-character-animation a owl:Class ;
    rdfs:label "Real Time Character Animation"@en ;
    rdfs:comment "The process of generating and rendering character movements instantaneously during gameplay or interactive experiences, utilizing rigging systems, motion capture data, and procedural animation to create lifelike digital characters that respond dynamically to user input and environmental conditions."@en ;
    rdfs:subClassOf ngm:3-d-animation,
        ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:slug "real-time-character-animation" ;
    vc:sourceDomain "spatial-computing" .

ngm:real-time-graphics a owl:Class ;
    rdfs:label "Real Time Graphics"@en ;
    rdfs:comment "Real-time graphics is the field of computer graphics concerned with generating and displaying images fast enough to produce interactive, continuously updating visuals, typically at frame rates of sixty frames per second or higher. It prioritises low and predictable latency over photorealistic fidelity, relying on hardware acceleration and approximate rendering techniques. It is the foundation for games, simulations and immersive spatial computing experiences."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:real-time-rendering ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gpu ],
        ngm:computer-graphics ;
    vc:bridgesTo ngm:spatial-computing ;
    vc:contrastsWith ngm:ray-tracing ;
    vc:dependsOn ngm:latency ;
    vc:enables ngm:augmented-reality,
        ngm:virtual-reality ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:real-time-rendering ;
    vc:implements ngm:rendering ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:graphics-pipeline ;
    vc:requires ngm:gpu ;
    vc:slug "real-time-graphics" ;
    vc:sourceDomain "spatial-computing" ;
    vc:standardizedBy ngm:vulkan ;
    vc:supports ngm:game-engine,
        ngm:interactive-rendering ;
    vc:uses ngm:graphics-processing-unit,
        ngm:rendering-pipeline .

ngm:real-time-rendering-engine a owl:Class ;
    rdfs:label "Real-Time Rendering Engine"@en ;
    rdfs:comment "A real-time rendering engine generates images from 3D scene descriptions fast enough to sustain interactive frame rates, typically 30 to 120+ frames per second. It coordinates GPU rasterisation or ray tracing, shading, lighting, and post-processing within a fixed per-frame time budget. It is the visual core of game engines, virtual production, and immersive metaverse experiences."@en ;
    rdfs:subClassOf ngm:sc-display-and-rendering ;
    skos:broader ngm:sc-display-and-rendering ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:metaverse-content-pipeline,
        ngm:virtual-production-volume ;
    vc:slug "real-time-rendering-engine" ;
    vc:sourceDomain "metaverse" .

ngm:reality-eth-oracle a owl:Class ;
    rdfs:label "Reality ETH Oracle"@en ;
    rdfs:comment "Reality.eth is an Ethereum-based crowdsourced oracle that resolves arbitrary questions by escalating bonds, allowing anyone to post or challenge answers until an economically final result is reached. It feeds resolved outcomes into smart contracts and is widely used to settle governance proposals and prediction-market events. The escalation-game design lets it answer subjective or off-chain questions that price-feed oracles cannot."@en ;
    rdfs:subClassOf ngm:bc-defi-and-economics ;
    skos:broader ngm:bc-defi-and-economics ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:dao-tooling,
        ngm:snapshot-voting ;
    vc:slug "reality-eth-oracle" ;
    vc:sourceDomain "blockchain" .

ngm:reasoning-trace a owl:Class ;
    rdfs:label "Reasoning Trace"@en ;
    rdfs:comment "A reasoning trace is the recorded sequence of intermediate thoughts, tool calls, and decisions a model produces while solving a task, distinct from its final output. It serves as both a working scratchpad that improves accuracy and an audit artefact for inspecting how an agent reached a conclusion. Traces underpin debugging, evaluation, and self-correction in agentic systems."@en ;
    rdfs:subClassOf ngm:ai-agent-system ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:agents,
        ngm:computer-use-and-browser-agents ;
    vc:slug "reasoning-trace" ;
    vc:sourceDomain "ai" .

ngm:rectified-flow a owl:Class ;
    rdfs:label "Rectified Flow"@en ;
    rdfs:comment "Rectified Flow is a generative modelling framework that trains a velocity field to transport samples along straight-line trajectories in the ODE sense between a source noise distribution and a target data distribution. By reflow iterations—repeatedly pairing coupled samples and re-training—the learned trajectories become increasingly linear, minimising the number of function evaluations (NFEs) required at inference time. The approach unifies flow matching and score-based diffusion models, offering competitive image and video generation quality with substantially faster sampling compared to standard diffusion schedules."@en ;
    rdfs:subClassOf ngm:ai-model-architecture ;
    skos:broader ngm:ai-model-architecture ;
    vc:enables ngm:image-generation,
        ngm:sampling ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:diffusion-model,
        ngm:flow-matching ;
    vc:slug "rectified-flow" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:generative-model .

ngm:reference-signal a owl:Class ;
    rdfs:label "Reference Signal"@en ;
    rdfs:comment "A reference signal is the commanded target value, or setpoint trajectory, that a control system attempts to make its output follow over time. The controller computes the error between the reference and the measured output and acts to drive that error to zero. The shape and feasibility of the reference signal directly determine achievable tracking performance."@en ;
    rdfs:subClassOf ngm:control-theory ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:control-theory,
        ngm:feedback-loop ;
    vc:slug "reference-signal" ;
    vc:sourceDomain "robotics" .

ngm:reflection-loop a owl:Class ;
    rdfs:label "Reflection Loop"@en ;
    rdfs:comment "A reflection loop is an agentic control pattern in which a model critiques its own intermediate output, identifies errors or gaps, and revises before continuing or finalising. By iterating between generation and self-evaluation, the agent improves quality on tasks where a single pass is unreliable. It is a building block of self-correcting LLM agents and tool-using workflows."@en ;
    rdfs:subClassOf ngm:ai-agent-system ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:agents,
        ngm:computer-use-and-browser-agents ;
    vc:slug "reflection-loop" ;
    vc:sourceDomain "ai" .

ngm:reflexion a owl:Class ;
    rdfs:label "Reflexion"@en ;
    rdfs:comment "Reflexion is a framework for language-model agents that converts feedback from failed attempts into reflective verbal self-critiques stored in an episodic memory, which condition subsequent attempts. Rather than updating model weights, it reinforces behaviour through natural-language reflections, enabling rapid trial-and-error learning. It improves agent performance on decision-making, reasoning, and coding benchmarks across repeated episodes."@en ;
    rdfs:subClassOf ngm:ai-agent-system ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:agents,
        ngm:computer-use-and-browser-agents ;
    vc:slug "reflexion" ;
    vc:sourceDomain "ai" .

ngm:regenerative-finance a owl:Class ;
    rdfs:label "Regenerative Finance"@en ;
    rdfs:comment "Regenerative finance (ReFi) is a movement that uses blockchain-based financial primitives to fund and incentivise ecological and social regeneration, such as carbon removal, biodiversity, and public goods. It tokenises natural assets and routes capital through mechanisms like retroactive funding and on-chain carbon markets. ReFi reframes DeFi tooling toward restoring rather than merely extracting value."@en ;
    rdfs:subClassOf ngm:bc-defi-and-economics ;
    skos:broader ngm:bc-defi-and-economics ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:green-blockchain-initiatives,
        ngm:sustainability ;
    vc:slug "regenerative-finance" ;
    vc:sourceDomain "blockchain" .

ngm:regulatory-authorisation a owl:Class ;
    rdfs:label "Regulatory Authorisation"@en ;
    rdfs:comment "Regulatory authorisation is the formal permission granted by a competent authority allowing an entity to conduct a regulated activity such as issuing tokens, operating a payment system, or holding client assets. It is obtained through an application demonstrating compliance with capital, governance, and conduct requirements. Without authorisation, issuance and operation of regulated financial instruments are unlawful in most jurisdictions."@en ;
    rdfs:subClassOf ngm:bc-governance-and-regulation ;
    skos:broader ngm:bc-governance-and-regulation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:cbdc-frameworks,
        ngm:enterprise-token-standards ;
    vc:slug "regulatory-authorisation" ;
    vc:sourceDomain "blockchain" .

ngm:regulatory-conformance a owl:Class ;
    rdfs:label "Regulatory Conformance"@en ;
    rdfs:comment "Regulatory conformance is the demonstrable state of an organisation's systems and processes meeting the legal and regulatory requirements applicable to its domain. It is evidenced through controls, documentation, and audits that map obligations to operational practice. For AI and data systems, conformance increasingly covers risk classification, transparency, and accountability mandates."@en ;
    rdfs:subClassOf ngm:regulatory-compliance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:ai-governance,
        ngm:compliance ;
    vc:slug "regulatory-conformance" ;
    vc:sourceDomain "governance" .

ngm:regulatory-licence a owl:Class ;
    rdfs:label "Regulatory Licence"@en ;
    rdfs:comment "A regulatory licence is a specific, often named permission issued by a financial supervisor that authorises an entity to carry out a defined regulated activity such as issuing e-money or operating as a payment institution. It binds the holder to ongoing conditions including capital adequacy, reporting, and conduct rules. For stablecoin issuers, the appropriate licence determines whether the token may legally be offered to the public."@en ;
    rdfs:subClassOf ngm:financial-regulation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:stable-coins,
        ngm:stablecoin-regulation ;
    vc:slug "regulatory-licence" ;
    vc:sourceDomain "blockchain" .

ngm:regulatory-reporting-module a owl:Class ;
    rdfs:label "Regulatory Reporting Module"@en ;
    rdfs:comment "A regulatory reporting module is a self-contained software component that collects, formats, and dispatches the disclosures an entity owes to its regulators. It encapsulates jurisdiction-specific schemas, validation rules, and submission channels so they can be reused across systems. As a discrete subsystem it plugs into compliance-monitoring and tax-compliance pipelines to produce audit-ready outputs."@en ;
    rdfs:subClassOf ngm:regulatory-compliance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:compliance-monitoring,
        ngm:digital-tax-compliance-node ;
    vc:slug "regulatory-reporting-module" ;
    vc:sourceDomain "blockchain" .

ngm:relational-algebra a owl:Class ;
    rdfs:label "Relational Algebra"@en ;
    rdfs:comment "Relational algebra is a formal, procedural query language consisting of operators that take relations as input and produce relations as output. Its core operators — selection, projection, union, set difference, Cartesian product, rename, and derived operators such as join — provide a closed algebra that gives precise semantics to relational queries. It is the theoretical foundation for SQL and for the query optimisation performed by relational database systems."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:set-theory ],
        ngm:relational-database ;
    vc:bridgesTo ngm:relational-calculus ;
    vc:contrastsWith ngm:relational-calculus ;
    vc:dependsOn ngm:relational-database ;
    vc:enables ngm:query-processing,
        ngm:sql ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:join ;
    vc:implements ngm:relational-model ;
    vc:isPartOf ngm:relational-model ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:data-model,
        ngm:database-management-system,
        ngm:query-optimization,
        ngm:relational-database ;
    vc:requires ngm:set-theory ;
    vc:slug "relational-algebra" ;
    vc:sourceDomain "data" ;
    vc:supports ngm:query-optimization,
        ngm:sql ;
    vc:uses ngm:set-theory .

ngm:relationship-edge a owl:Class ;
    rdfs:label "Relationship Edge"@en ;
    rdfs:comment "A relationship edge is a directed or undirected connection in a graph that represents a typed association between two entity nodes, often carrying a label and properties. In knowledge and identity graphs, edges encode facts such as ownership, membership, or similarity that give the graph its semantic structure. Edge type and weight determine how the graph can be queried, traversed, and reasoned over."@en ;
    rdfs:subClassOf ngm:distributed-data-structure ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:identity-graph,
        ngm:knowledge-graph ;
    vc:slug "relationship-edge" ;
    vc:sourceDomain "data" .

ngm:remediation-plan a owl:Class ;
    rdfs:label "Remediation Plan"@en ;
    rdfs:comment "A remediation plan is a structured set of corrective actions, owners, and deadlines drawn up to address identified non-conformities, risks, or harms discovered through audit or monitoring. It links each finding to a specific fix and tracks progress to closure. In compliance and ethical-sourcing contexts it is the mechanism that turns a violation into demonstrable improvement."@en ;
    rdfs:subClassOf ngm:regulatory-compliance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:compliance-control,
        ngm:ethical-sourcing ;
    vc:slug "remediation-plan" ;
    vc:sourceDomain "governance" .

ngm:renderer a owl:Class ;
    rdfs:label "Renderer"@en ;
    rdfs:comment "A renderer is the software or hardware component that converts a scene description, such as geometry, materials, lights, or a markup specification, into a final image or visual output. Renderers range from real-time rasterisers and ray tracers to text-and-diagram engines that draw from declarative source. The choice of renderer determines visual fidelity, performance, and the formats a system can produce."@en ;
    rdfs:subClassOf ngm:sc-display-and-rendering ;
    skos:broader ngm:sc-display-and-rendering ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:diagrams-as-code,
        ngm:universal-scene-description ;
    vc:slug "renderer" ;
    vc:sourceDomain "metaverse" .

ngm:replication-system a owl:Class ;
    rdfs:label "Replication System"@en ;
    rdfs:comment "A replication system maintains synchronised copies of data or state across multiple nodes in a distributed environment, ensuring consistency, availability, and fault tolerance. It coordinates state propagation through protocols such as leader-based or leaderless replication, supporting both synchronous and asynchronous update strategies in blockchain, database, and metaverse infrastructure contexts."@en ;
    rdfs:subClassOf ngm:infra-data-management ;
    skos:broader ngm:infra-data-management ;
    vc:dependsOn ngm:consensus-mechanism,
        ngm:distributed-system ;
    vc:enables ngm:fault-tolerance,
        ngm:high-availability ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:implements ngm:data-replication ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:database-system ;
    vc:slug "replication-system" ;
    vc:sourceDomain "infrastructure" .

ngm:reproducible-builds a owl:Class ;
    rdfs:label "Reproducible Builds"@en ;
    rdfs:comment "Reproducible builds are a software build practice in which compiling the same source code under the same recorded conditions always yields bit-for-bit identical artifacts. By removing sources of non-determinism such as timestamps, build paths, and ordering, independent parties can verify that a published binary corresponds exactly to its claimed source. This independent verifiability strengthens software supply-chain security and trust in distributed binaries."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:version-control ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:reproducibility ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:continuous-integration ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:provenance ],
        ngm:supply-chain-security ;
    vc:bridgesTo ngm:attestation ;
    vc:dependsOn ngm:continuous-integration ;
    vc:enables ngm:attestation,
        ngm:trust,
        ngm:verification ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:provenance,
        ngm:reproducibility ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:caching,
        ngm:provenance,
        ngm:reproducibility ;
    vc:requires ngm:continuous-integration,
        ngm:version-control ;
    vc:slug "reproducible-builds" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:software-supply-chain,
        ngm:supply-chain-security ;
    vc:uses ngm:content-addressed-storage,
        ngm:hash-function .

ngm:rescue-robot a owl:Class ;
    rdfs:label "Rescue Robot"@en ;
    rdfs:comment "A Rescue Robot is a specialised mobile robot engineered to operate in hazardous, unstructured environments—including collapsed structures, disaster zones, and nuclear incidents—where direct human presence is unsafe. Such systems integrate multimodal locomotion (tracked, wheeled, or legged), sensor suites (IR, LIDAR, acoustic, tactile), and teleoperation or autonomous navigation to locate, assess, and extract casualties or gather situational data. Conformance with safety standards such as ISO 8373 and participation in benchmarks such as the RoboCup Rescue Robot League drives continuous capability development."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:autonomous-navigation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:sensor-fusion ],
        ngm:robo-robot-type ;
    skos:broader ngm:robo-robot-type ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:mobile-robot ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:relatedTo ngm:functional-safety ;
    vc:requires ngm:autonomous-navigation,
        ngm:sensor-fusion ;
    vc:slug "rescue-robot" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:human-robot-interaction,
        ngm:path-planning .

ngm:research-dissemination a skos:Concept ;
    rdfs:label "Research Dissemination"@en .

ngm:retrospective a owl:Class ;
    rdfs:label "Retrospective"@en ;
    rdfs:comment "A retrospective is a recurring, facilitated meeting in which a team reflects on a recent period of work to identify what went well, what did not, and concrete improvements to try next. It is a cornerstone agile practice that institutionalises continuous improvement by turning shared experience into actionable changes to process, tooling and collaboration. Retrospectives are increasingly run on collaborative whiteboards so distributed teams can participate equally."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:sticky-notes ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:collaboration ],
        ngm:agile-software-development ;
    vc:bridgesTo ngm:velocity ;
    vc:enables ngm:feedback-loop ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:sticky-notes ;
    vc:isPartOf ngm:agile-software-development ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:distributed-collaboration,
        ngm:distributed-team-collaboration,
        ngm:kanban-board ;
    vc:requires ngm:collaboration ;
    vc:slug "retrospective" ;
    vc:sourceDomain "distributed-collaboration" ;
    vc:supports ngm:project-management,
        ngm:sprint-planning ;
    vc:uses ngm:collaborative-whiteboard,
        ngm:sticky-notes .

ngm:reward-shaping a owl:Class ;
    rdfs:label "Reward Shaping"@en ;
    rdfs:comment "Reward shaping is a reinforcement-learning technique that augments an environment's native reward signal with additional intermediate rewards to guide and accelerate learning. Potential-based reward shaping provides theoretical guarantees that the optimal policy is preserved, avoiding the introduction of unintended behaviours. It is commonly used to address sparse-reward problems where useful feedback is rare."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:reward-function ],
        ngm:reinforcement-learning ;
    vc:contrastsWith ngm:reward-hacking,
        ngm:sparse-reward ;
    vc:enables ngm:agent-training ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:potential-based-reward-shaping ;
    vc:isPartOf ngm:reward-engineering ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:exploration-exploitation,
        ngm:inverse-reinforcement-learning ;
    vc:requires ngm:reward-function ;
    vc:slug "reward-shaping" ;
    vc:sourceDomain "machine-learning" ;
    vc:supports ngm:reinforcement-learning,
        ngm:value-function ;
    vc:uses ngm:markov-decision-process,
        ngm:reward-function .

ngm:rfc-8032 a owl:Class ;
    rdfs:label "Rfc 8032"@en ;
    rdfs:comment "RFC 8032 is the IETF specification that standardises the Edwards-curve Digital Signature Algorithm (EdDSA), defining the Ed25519 and Ed448 signature schemes. It specifies deterministic signature generation, key formats, and verification procedures over twisted Edwards curves, eliminating the dependence on a per-signature random number that has historically led to catastrophic key-recovery failures in other schemes. The standard is widely adopted across TLS, SSH, DNSSEC, and cryptocurrency systems for its strong security, high performance, and resistance to common implementation pitfalls."@en ;
    rdfs:subClassOf ngm:standards ;
    vc:dependsOn ngm:modular-arithmetic ;
    vc:enables ngm:digital-signature,
        ngm:key-generation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:digital-signature,
        ngm:ed25519 ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:post-quantum-cryptography,
        ngm:public-key-cryptography,
        ngm:schnorr-signature ;
    vc:slug "rfc-8032" ;
    vc:sourceDomain "security" ;
    vc:standardizedBy ngm:ietf,
        ngm:internet-engineering-task-force ;
    vc:supports ngm:tls ;
    vc:uses ngm:curve25519,
        ngm:elliptic-curve-cryptography,
        ngm:hash-function .

ngm:risk-assessment-matrix a owl:Class ;
    rdfs:label "Risk Assessment Matrix"@en ;
    rdfs:comment "A risk assessment matrix is a structured grid that ranks risks by cross-tabulating the likelihood of an event against the severity of its impact. Each cell maps to a qualitative or quantitative risk level, allowing teams to prioritise mitigation and allocate resources to the highest-rated risks. It is a standard visual tool in security and safety risk management."@en ;
    rdfs:subClassOf ngm:cybersecurity ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:risk-assessment-methodology,
        ngm:threat-surface-map ;
    vc:slug "risk-assessment-matrix" ;
    vc:sourceDomain "security" .

ngm:robot-locomotion a owl:Class ;
    rdfs:label "Robot Locomotion"@en ;
    rdfs:comment "Robot locomotion is the study and engineering of how robots move through their environment, encompassing legged walking, wheeled rolling, crawling, swimming and flight. It integrates mechanical design, control theory and sensing to generate stable, efficient and adaptive movement over varied terrain. Locomotion distinguishes itself from manipulation by focusing on whole-body displacement and dynamic balance rather than interaction with objects."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:legged-robot ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:actuator ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:robotic-control ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:locomotion ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:motion-planning ],
        ngm:robotics ;
    skos:broader ngm:robotics ;
    vc:bridgesTo ngm:control-theory,
        ngm:feedback-loop ;
    vc:contrastsWith ngm:inverse-kinematics ;
    vc:enables ngm:motion-planning,
        ngm:robotic-control ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:legged-robot,
        ngm:locomotion ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:robotics ;
    vc:requires ngm:actuator,
        ngm:motion-planning,
        ngm:robotic-control ;
    vc:slug "robot-locomotion" ;
    vc:sourceDomain "robotics" ;
    vc:supports ngm:humanoid-robot ;
    vc:uses ngm:inverse-kinematics .

ngm:room-state-tracking a owl:Class ;
    rdfs:label "Room State Tracking"@en ;
    rdfs:comment "Room state tracking is the mechanism in real-time collaboration and conferencing systems that maintains an authoritative, synchronised record of a virtual room's membership, media status, and shared state. It tracks who is present, their roles, mute and stream states, and assignments such as breakout-room placement. Reliable state tracking ensures all participants and the server share a consistent view of the session."@en ;
    rdfs:subClassOf ngm:dc-telepresence ;
    skos:broader ngm:dc-telepresence ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:breakout-room ;
    vc:slug "room-state-tracking" ;
    vc:sourceDomain "metaverse" .

ngm:royalty-mechanism a owl:Class ;
    rdfs:label "Royalty Mechanism"@en ;
    rdfs:comment "Automated process ensuring creators receive compensation when their assets are resold or used in secondary markets."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:blockchain-infrastructure ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:nft-standard ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:smart-contract ],
        ngm:digital-rights-management,
        ngm:sc-governance-and-safety ;
    skos:broader ngm:sc-governance-and-safety ;
    vc:enables ngm:creator-compensation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:smart-contract ;
    vc:isPartOf ngm:digital-rights-management ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:blockchain-infrastructure,
        ngm:nft-standard ;
    vc:slug "royalty-mechanism" ;
    vc:sourceDomain "spatial-computing" .

ngm:rtcp-feedback a owl:Class ;
    rdfs:label "RTCP Feedback"@en ;
    rdfs:comment "RTCP feedback is the control-channel mechanism of the RTP Control Protocol by which receivers report reception quality, such as packet loss, jitter, and round-trip time, back to senders during real-time media streaming. Senders use these reports, along with extensions like NACK, PLI, and REMB, to adapt encoding bitrate and recover from loss. It is the feedback loop that enables congestion-aware, resilient audiovisual transport."@en ;
    rdfs:subClassOf ngm:communication-protocol ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:bandwidth-adaptation ;
    vc:slug "rtcp-feedback" ;
    vc:sourceDomain "infrastructure" .

ngm:runtime-layer a owl:Class ;
    rdfs:label "Runtime Layer"@en ;
    rdfs:comment "The Runtime Layer is the stratum that provides the execution environment in which higher-level code and models actually run. It sits above the Compute Layer that allocates resources and below the application and inference strata it hosts. It contains process and memory management, schedulers, sandboxes, and the libraries that support running programmes."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:compute-layer ],
        ngm:infra-computing-and-cloud ;
    skos:broader ngm:infra-computing-and-cloud ;
    vc:enables ngm:application-layer,
        ngm:inference-layer ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:compute-layer ;
    vc:slug "runtime-layer" ;
    vc:sourceDomain "infrastructure" .

ngm:safe-snap a owl:Class ;
    rdfs:label "SafeSnap"@en ;
    rdfs:comment "SafeSnap is a tool that connects off-chain Snapshot governance votes to on-chain execution through a Gnosis Safe and the Reality.eth oracle. It lets DAOs enact decisions without paying gas to vote."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:reality-eth ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:snapshot ],
        ngm:dao-governance ;
    vc:enables ngm:decentralized-autonomous-organization ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:reality-eth,
        ngm:snapshot ;
    vc:slug "safe-snap" ;
    vc:sourceDomain "blockchain" .

ngm:safety-filter a owl:Class ;
    rdfs:label "Safety Filter"@en ;
    rdfs:comment "A safety filter is a content-moderation component placed around a generative AI model that screens inputs and outputs to block disallowed, harmful, or policy-violating content. It typically combines classifiers, keyword and pattern rules, and policy thresholds to detect unsafe prompts or generations and refuse, redact, or regenerate them. It is a core safeguard in deployed image and conversational AI products."@en ;
    rdfs:subClassOf ngm:ai-safety ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:ai-companions,
        ngm:proprietary-image-generation ;
    vc:slug "safety-filter" ;
    vc:sourceDomain "ai" .

ngm:safety-instrumented-system a skos:Concept ;
    rdfs:label "Safety Instrumented System"@en .

ngm:safety-plc a owl:Class ;
    rdfs:label "Safety PLC"@en ;
    rdfs:comment "A Safety Programmable Logic Controller (Safety PLC) is a specialised industrial controller certified to IEC 61511 or IEC 62061 safety integrity levels, designed to execute safety instrumented functions that bring a process to a safe state upon detecting hazardous conditions. Unlike standard PLCs, Safety PLCs implement redundant processing, self-diagnostics, and rigorous failure-mode analysis to achieve the high diagnostic coverage required for safety-critical robotics and industrial automation."@en ;
    rdfs:subClassOf ngm:robo-safety-and-standards ;
    skos:broader ngm:robo-safety-and-standards ;
    vc:enables ngm:cobot-safety-levels,
        ngm:collaborative-systems-modality-robot ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:implements ngm:functional-safety ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:servo-control ;
    vc:slug "safety-plc" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:control-system,
        ngm:feedback-control .

ngm:sampling-procedure a owl:Class ;
    rdfs:label "Sampling Procedure"@en ;
    rdfs:comment "A sampling procedure is the method by which a generative model draws output samples from its learned probability distribution. It governs how latent or noise variables are mapped to concrete outputs, including techniques such as ancestral sampling, temperature scaling, top-k and nucleus sampling, and iterative denoising in diffusion models. The choice of procedure controls the diversity, fidelity, and computational cost of generation."@en ;
    rdfs:subClassOf ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:generative-adversarial-networks,
        ngm:inpainting ;
    vc:slug "sampling-procedure" ;
    vc:sourceDomain "ai" .

ngm:sanctions-compliance a owl:Class ;
    rdfs:label "Sanctions Compliance"@en ;
    rdfs:comment "Sanctions compliance is the set of controls organisations implement to avoid transacting with individuals, entities, jurisdictions, or assets prohibited by sanctions regimes such as those administered by the US OFAC, the EU, the UK OFSI, and the UN. It involves screening counterparties against sanctions lists, monitoring transactions for prohibited patterns, blocking or freezing prohibited dealings, and maintaining auditable records. In digital-asset markets it extends to wallet-address screening and analysis of fund provenance, posing distinctive challenges for permissionless and privacy-preserving systems."@en ;
    rdfs:subClassOf ngm:regulatory-compliance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:compliance,
        ngm:financial-regulation ;
    vc:slug "sanctions-compliance" ;
    vc:sourceDomain "governance" ;
    vc:supports ngm:risk-assessment ;
    vc:uses ngm:kyc .

ngm:sandboxed-code-execution a skos:Concept ;
    rdfs:label "Sandboxed Code Execution"@en .

ngm:scalable-architecture a owl:Class ;
    rdfs:label "Scalable Architecture"@en ;
    rdfs:comment "System designs that maintain performance and availability as user demand grows, employing horizontal scaling, load balancing, distributed computing, and cloud-native patterns to support expanding metaverse populations and concurrent interactions."@en ;
    rdfs:subClassOf ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:bridgesTo ngm:system-architecture ;
    vc:enables ngm:high-availability ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:slug "scalable-architecture" ;
    vc:sourceDomain "spatial-computing" .

ngm:score-function a owl:Class ;
    rdfs:label "Score Function"@en ;
    rdfs:comment "In score-based generative modelling, the Score Function is the gradient of the log probability density of the data with respect to the input, indicating the direction of increasing data likelihood. Diffusion models learn to estimate this score across noise levels, then use it to iteratively denoise samples drawn from a simple prior. The score function connects diffusion models to Langevin-style sampling and energy-based formulations."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:noise-schedule ],
        ngm:diffusion-model ;
    vc:dependsOn ngm:stochastic-differential-equation ;
    vc:enables ngm:generative-model,
        ngm:sampling ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:noise-schedule ;
    vc:isPartOf ngm:diffusion-model ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:artificial-intelligence ;
    vc:slug "score-function" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:diffusion-model ;
    vc:uses ngm:maximum-likelihood-estimation,
        ngm:probability-distribution .

ngm:scratchpad-reasoning a owl:Class ;
    rdfs:label "Scratchpad Reasoning"@en ;
    rdfs:comment "Scratchpad reasoning is a prompting and inference technique in which a language model generates intermediate working steps into an explicit textual workspace before committing to a final answer. The scratchpad externalises latent computation, letting the model decompose a problem, track partial results, and self-correct, which improves performance on multi-step arithmetic, logic, and code tasks. It is a foundational mechanism behind chain-of-thought and related deliberate-reasoning methods."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:reasoning ],
        ngm:chain-of-thought-reasoning ;
    vc:bridgesTo ngm:tree-of-thoughts ;
    vc:dependsOn ngm:inference ;
    vc:enables ngm:reasoning ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:reasoning ;
    vc:implements ngm:tool-use ;
    vc:isPartOf ngm:chain-of-thought-reasoning ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:in-context-learning,
        ngm:interpretability,
        ngm:self-consistency ;
    vc:slug "scratchpad-reasoning" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:interpretability ;
    vc:uses ngm:large-language-model,
        ngm:prompt-engineering .

ngm:scripting-language a owl:Class ;
    rdfs:label "Scripting Language"@en ;
    rdfs:comment "A scripting language is an interpreted or dynamically compiled programming language used to automate tasks, define interactive behaviours, and extend the capabilities of host applications or game engines without modifying core engine code. In metaverse contexts, scripting languages such as JavaScript, Lua, Python, and C# enable content creators to author custom gameplay mechanics, NPC behaviour, and dynamic environment logic with rapid iteration cycles."@en ;
    rdfs:subClassOf ngm:infra-software-engineering ;
    skos:broader ngm:infra-software-engineering ;
    vc:enables ngm:game-development,
        ngm:virtual-world-creation ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:programming-language ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:software-engineering ;
    vc:slug "scripting-language" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:game-engine .

ngm:sd-jwt-vc a owl:Class ;
    rdfs:label "SD-JWT VC"@en ;
    rdfs:comment "A verifiable credential format that uses Selective Disclosure JSON Web Tokens, allowing a holder to reveal only chosen claims to a verifier. It combines the JWT structure with salted hashes that support selective disclosure."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:json-data-interchange-format-web-token ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:selective-disclosure ],
        ngm:json-data-interchange-format-web-token ;
    vc:enables ngm:digital-identity ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:json-data-interchange-format-web-token,
        ngm:selective-disclosure ;
    vc:slug "sd-jwt-vc" ;
    vc:sourceDomain "security" .

ngm:sdxl a owl:Class ;
    rdfs:label "SDXL"@en ;
    rdfs:comment "SDXL (Stable Diffusion XL) is a large-scale latent diffusion model released by Stability AI in 2023, comprising a 3.5-billion-parameter UNet and an ensemble of two CLIP text encoders that condition image generation at native 1024×1024 resolution. It introduces a two-stage architecture — a base model followed by a refinement model — and supports advanced conditioning mechanisms including aesthetic scoring and crop coordinates."@en ;
    rdfs:subClassOf ngm:latent-diffusion ;
    vc:contrastsWith ngm:stable-diffusion-image-model ;
    vc:enables ngm:image-generation,
        ngm:lo-ra-fine-tuning ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:diffusion-model,
        ngm:hugging-face-diffusers ;
    vc:slug "sdxl" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:classifier-free-guidance,
        ngm:clip-encoder,
        ngm:vae .

ngm:search-space a skos:Concept ;
    rdfs:label "Search Space"@en .

ngm:section-508 a owl:Class ;
    rdfs:label "Section 508"@en ;
    rdfs:comment "Section 508 is an amendment to the US Rehabilitation Act requiring federal agencies to make their electronic and information technology accessible to people with disabilities. Its 2017 refresh harmonised the technical requirements with the WCAG 2.0 Level AA success criteria. It functions as an enforceable procurement and compliance standard for accessibility in US government IT."@en ;
    rdfs:subClassOf ngm:technical-standard ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:accessibility ;
    vc:slug "section-508" ;
    vc:sourceDomain "governance" .

ngm:secure-data-sharing a owl:Class ;
    rdfs:label "Secure Data Sharing"@en ;
    rdfs:comment "Cryptographic and access control mechanisms that enable controlled exchange of sensitive information between parties in metaverse environments while maintaining confidentiality, integrity, and regulatory compliance through encryption and permissioned access."@en ;
    rdfs:subClassOf ngm:infra-security-and-identity ;
    skos:broader ngm:infra-security-and-identity ;
    vc:bridgesTo ngm:data-security ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:slug "secure-data-sharing" ;
    vc:sourceDomain "infrastructure" .

ngm:security-layer a owl:Class ;
    rdfs:label "Security Layer"@en ;
    rdfs:comment "The Security Layer is the implementation-focused abstraction level that encapsulates cryptographic mechanisms, security protocols, threat models, and defensive architectures protecting blockchain and distributed systems from attacks whilst ensuring data integrity, authenticity, and confidentiality. It encompasses concrete implementations such as hash functions, digital signatures, zero-knowledge proofs, access control, and formal verification, distinct from higher-level conceptual security properties."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:hash-function ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:cryptography ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:digital-signature ],
        ngm:infra-security-and-identity ;
    skos:broader ngm:infra-security-and-identity ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:cryptography,
        ngm:digital-signature,
        ngm:hash-function ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:slug "security-layer" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:cryptographic-security,
        ngm:data-security ;
    vc:uses ngm:formal-verification,
        ngm:zero-knowledge-proof .

ngm:security-module a owl:Class ;
    rdfs:label "Security Module"@en ;
    rdfs:comment "A security module is a dedicated hardware or software component that provides cryptographic and protection services such as key generation, secure storage, signing, and access enforcement. Hardware security modules and secure elements isolate sensitive operations from the general computing environment to resist extraction and tampering. Such modules are required wherever keys and credentials must be safeguarded, as in custody and IoT systems."@en ;
    rdfs:subClassOf ngm:infra-security-and-identity ;
    skos:broader ngm:infra-security-and-identity ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:io-t-sensor-network,
        ngm:token-custody-service ;
    vc:slug "security-module" ;
    vc:sourceDomain "security" .

ngm:security-monitoring a owl:Class ;
    rdfs:label "Security Monitoring"@en ;
    rdfs:comment "Security monitoring is the continuous collection, correlation and analysis of telemetry from systems, networks and applications to detect indicators of compromise and policy violations. It feeds detection rules, baselines and analytics that surface suspicious behaviour for investigation and response. As a discipline it spans log aggregation, intrusion detection, threat intelligence enrichment and alerting, and is a core function of a security operations centre."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:metrics-collection ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:observability ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:audit-logging ],
        ngm:threat-detection ;
    vc:contrastsWith ngm:intrusion-detection ;
    vc:enables ngm:incident-response,
        ngm:threat-detection,
        ngm:vulnerability-management ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:alerting,
        ngm:defense-in-depth ;
    vc:requires ngm:audit-logging,
        ngm:metrics-collection,
        ngm:observability ;
    vc:slug "security-monitoring" ;
    vc:sourceDomain "security" ;
    vc:supports ngm:security-operations-centre,
        ngm:threat-intelligence ;
    vc:uses ngm:anomaly-detection,
        ngm:logging,
        ngm:siem .

ngm:security-protocol a owl:Class ;
    rdfs:label "Security Protocol"@en ;
    rdfs:comment "A security protocol is a defined sequence of message exchanges and cryptographic operations that lets parties achieve security goals such as confidentiality, integrity, authentication or key establishment over an untrusted channel. Protocols specify message formats, ordering, cryptographic primitives and state transitions, and are designed to resist defined adversaries. Examples include TLS for transport security and authentication protocols for identity verification."@en ;
    rdfs:subClassOf ngm:standards ;
    vc:bridgesTo ngm:authentication,
        ngm:cryptographic-protocol ;
    vc:enables ngm:single-sign-on ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:implements ngm:authentication ;
    vc:isPartOf ngm:network-security ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:digital-signature,
        ngm:network-security,
        ngm:transport-layer-security ;
    vc:slug "security-protocol" ;
    vc:sourceDomain "standards" ;
    vc:standardizedBy ngm:standards ;
    vc:supports ngm:access-control,
        ngm:identity-federation ;
    vc:uses ngm:digital-signature .

ngm:security-services a owl:Class ;
    rdfs:label "Security Services"@en ;
    rdfs:comment "Security Services are the technical and organisational mechanisms that protect spatial computing platforms from unauthorised access, data breaches, and malicious activity. They encompass authentication, encryption, access control, and identity management components that collectively enforce security policies across metaverse, cloud, and immersive technology deployments."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:authentication ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:encryption ],
        ngm:sc-governance-and-safety ;
    skos:broader ngm:sc-governance-and-safety ;
    vc:enables ngm:access-control,
        ngm:digital-identity ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:authentication,
        ngm:encryption ;
    vc:slug "security-services" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:cybersecurity,
        ngm:data-governance .

ngm:self-service-analytics a owl:Class ;
    rdfs:label "Self Service Analytics"@en ;
    rdfs:comment "Self-service analytics is an approach that empowers business users to explore data, build reports, and answer their own questions through governed, accessible tools without depending on specialist data teams for every request. It combines intuitive interfaces, curated and trustworthy data sources, and embedded governance so that broad access does not compromise consistency or security. The aim is to accelerate decision-making and foster data literacy across an organisation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-quality ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-governance ],
        ngm:data-analytics ;
    vc:bridgesTo ngm:data-governance ;
    vc:dependsOn ngm:data-catalog,
        ngm:data-warehouse ;
    vc:enables ngm:business-intelligence,
        ngm:data-visualisation,
        ngm:decision-support ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:data-analytics ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:data-catalog,
        ngm:metadata-management,
        ngm:olap ;
    vc:requires ngm:data-governance,
        ngm:data-quality ;
    vc:slug "self-service-analytics" ;
    vc:sourceDomain "data" ;
    vc:supports ngm:data-engineering ;
    vc:uses ngm:data-visualisation,
        ngm:sql .

ngm:semantic-network a owl:Class ;
    rdfs:label "Semantic Network"@en ;
    rdfs:comment "A semantic network is a knowledge-representation structure that models concepts as nodes and their relationships as labelled edges. It captures meaning through typed links such as is-a and part-of, supporting inference, inheritance, and associative retrieval. It is a long-standing formalism underlying ontologies, knowledge graphs, and cognitive models of memory."@en ;
    rdfs:subClassOf ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:cognitive-ai,
        ngm:knowledge-representation ;
    vc:slug "semantic-network" ;
    vc:sourceDomain "ai" .

ngm:semantic-reasoning-engine a owl:Class ;
    rdfs:label "Semantic Reasoning Engine"@en ;
    rdfs:comment "Software that derives logically implied facts and checks consistency over a knowledge base expressed in a formal language such as OWL or RDF Schema. It applies inference rules of the underlying logic to make implicit information explicit."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:description-logic ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:owl-2-web-ontology-language ],
        ngm:inference-engine ;
    vc:enables ngm:knowledge-graph ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:description-logic,
        ngm:owl-2-web-ontology-language ;
    vc:slug "semantic-reasoning-engine" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:semi-fungible-token a owl:Class ;
    rdfs:label "Semi-Fungible Token"@en ;
    rdfs:comment "A blockchain token standard that combines fungible and non-fungible properties, typically implemented under ERC-1155. Semi-fungible tokens represent classes of interchangeable assets (e.g. event tickets of the same tier) that may transition to uniquely non-fungible assets upon redemption or use, enabling a single contract to manage both fungible currencies and unique collectibles with reduced gas costs."@en ;
    rdfs:subClassOf ngm:bc-token-and-asset,
        ngm:token ;
    skos:broader ngm:bc-token-and-asset ;
    vc:enables ngm:asset-tokenisation,
        ngm:digital-asset-trading ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:digital-asset,
        ngm:fungible-token,
        ngm:nft-marketplace,
        ngm:non-fungible-token-nft,
        ngm:security-token ;
    vc:slug "semi-fungible-token" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:erc-1155,
        ngm:erc1155-standard,
        ngm:smart-contract .

ngm:sensor-housing a owl:Class ;
    rdfs:label "Sensor Housing"@en ;
    rdfs:comment "A sensor housing is the mechanical enclosure that protects a sensing element from environmental hazards such as moisture, dust, vibration, and electromagnetic interference while maintaining its measurement window. It defines mounting geometry, ingress protection rating, thermal management, and the optical or acoustic path to the sensed medium. It is a structural component of robotic and exteroceptive sensing assemblies."@en ;
    rdfs:subClassOf ngm:hardware ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:exteroceptive-sensor,
        ngm:mechanical-component ;
    vc:slug "sensor-housing" ;
    vc:sourceDomain "robotics" .

ngm:sensor-measurements a owl:Class ;
    rdfs:label "Sensor Measurements"@en ;
    rdfs:comment "Sensor measurements are the time-stamped observations produced by physical or virtual sensors, each carrying a value, a unit, and an associated uncertainty or noise model. In probabilistic robotics they form the observation stream that estimators condition on to infer latent state such as pose or velocity. Their statistical characterisation is essential for filtering, fusion, and localisation."@en ;
    rdfs:subClassOf ngm:robo-perception ;
    skos:broader ngm:robo-perception ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:bayes-filter,
        ngm:monte-carlo-localization ;
    vc:slug "sensor-measurements" ;
    vc:sourceDomain "robotics" .

ngm:sensory-feedback a owl:Class ;
    rdfs:label "Sensory Feedback"@en ;
    rdfs:comment "Sensory feedback is the delivery of stimuli to a user's senses, including visual, auditory, haptic, and proprioceptive channels, in response to their actions within a virtual or mixed environment. Timely and coherent feedback closes the perception-action loop and is a precondition for the user's sense of presence and emotional engagement. It is a core mechanism of immersive interaction design."@en ;
    rdfs:subClassOf ngm:sc-interaction ;
    skos:broader ngm:sc-interaction ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:emotional-immersion,
        ngm:presence ;
    vc:slug "sensory-feedback" ;
    vc:sourceDomain "metaverse" .

ngm:sensory-immersion a owl:Class ;
    rdfs:label "Sensory Immersion"@en ;
    rdfs:comment "Sensory immersion is the dimension of immersion produced by saturating a user's perceptual channels with synthetic stimuli, such that the virtual environment dominates their awareness over the physical surroundings. It is driven by display fidelity, spatial audio, haptics, and wide field of view, and is distinct from narrative or cognitive immersion. It is a constituent component of the broader experience of immersion."@en ;
    rdfs:subClassOf ngm:virtual-environment ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:feedback-mechanism,
        ngm:immersion ;
    vc:slug "sensory-immersion" ;
    vc:sourceDomain "metaverse" .

ngm:sentence-piece a owl:Class ;
    rdfs:label "SentencePiece"@en ;
    rdfs:comment "SentencePiece is a language-independent subword tokenisation library that processes raw Unicode text without language-specific pre-tokenisation, learning vocabulary units via Byte-Pair Encoding or the Unigram Language Model directly from corpora. It produces fully reversible, fixed-vocabulary tokenisations widely used in multilingual large language models such as T5, mT5, and ALBERT, and is particularly valuable for languages lacking explicit word boundaries."@en ;
    rdfs:subClassOf ngm:ai-technique,
        ngm:neural-network-text-tokenisation ;
    skos:broader ngm:ai-technique ;
    vc:contrastsWith ngm:word-piece ;
    vc:enables ngm:large-language-models,
        ngm:natural-language-processing ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:neural-network-text-tokenisation ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:slug "sentence-piece" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:byte-pair-encoding,
        ngm:subword-tokenisation .

ngm:sequence-to-sequence-learning a owl:Class ;
    rdfs:label "Sequence To Sequence Learning"@en ;
    rdfs:comment "Sequence-to-sequence learning is a neural modelling framework that maps an input sequence to an output sequence of possibly different length, using an encoder to compress the input into a context representation and a decoder to generate the output token by token. Originally built on recurrent networks, it now predominantly uses the attention-based transformer architecture. It is the dominant paradigm for machine translation, summarisation and other transduction tasks."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:training-data ],
        ngm:supervised-learning ;
    vc:bridgesTo ngm:transformer ;
    vc:contrastsWith ngm:recurrent-neural-network ;
    vc:dependsOn ngm:lstm,
        ngm:neural-network ;
    vc:enables ngm:machine-translation,
        ngm:natural-language-processing ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:encoder-decoder ;
    vc:implements ngm:encoder-decoder ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:deep-learning,
        ngm:transformer ;
    vc:requires ngm:training-data ;
    vc:slug "sequence-to-sequence-learning" ;
    vc:sourceDomain "machine-learning" ;
    vc:supports ngm:machine-translation ;
    vc:uses ngm:attention-mechanism,
        ngm:recurrent-neural-network .

ngm:servo-drive a owl:Class ;
    rdfs:label "Servo Drive"@en ;
    rdfs:comment "A servo drive is the power-electronic controller that regulates the current, velocity, and position of a servomotor by closing feedback loops on encoder or resolver signals. It converts commanded setpoints from a motion controller into precisely modulated motor currents, enabling high-bandwidth, high-accuracy actuation. It is a core component of industrial robot joints and CNC motion systems."@en ;
    rdfs:subClassOf ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:industrial-robot,
        ngm:motion-control ;
    vc:slug "servo-drive" ;
    vc:sourceDomain "robotics" .

ngm:servo-valve a owl:Class ;
    rdfs:label "Servo Valve"@en ;
    rdfs:comment "A servo valve is an electrohydraulic device that proportionally controls the flow and pressure of hydraulic fluid in response to a low-power electrical command, typically via a torque-motor-driven pilot stage. It provides high-bandwidth, closed-loop modulation of hydraulic actuators, delivering large forces with precise position control. It is a key element of high-power robotic and aerospace actuation systems."@en ;
    rdfs:subClassOf ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:hydraulic-actuator,
        ngm:proportional-valve ;
    vc:slug "servo-valve" ;
    vc:sourceDomain "robotics" .

ngm:session-initiation-protocol a owl:Class ;
    rdfs:label "Session Initiation Protocol"@en ;
    rdfs:comment "The Session Initiation Protocol (SIP) is an application-layer signalling protocol used to establish, modify and terminate real-time communication sessions such as voice and video calls over IP networks. It handles user location, session setup negotiation and call control, delegating the actual media transport to companion protocols. SIP is text-based and request-response oriented, modelled on HTTP, and underpins much of modern internet telephony and unified communications."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:network-protocol ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:network-protocol ],
        ngm:communication-protocol ;
    vc:bridgesTo ngm:real-time-communication ;
    vc:contrastsWith ngm:network-protocol ;
    vc:dependsOn ngm:infrastructure ;
    vc:enables ngm:video-conferencing ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:network-protocol ;
    vc:implements ngm:communication-protocol ;
    vc:isPartOf ngm:real-time-communication ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:communication-protocol,
        ngm:video-conferencing ;
    vc:requires ngm:network-protocol ;
    vc:slug "session-initiation-protocol" ;
    vc:sourceDomain "infrastructure" ;
    vc:standardizedBy ngm:standards ;
    vc:supports ngm:real-time-communication ;
    vc:uses ngm:network-protocol .

ngm:sheffield-advanced-manufacturing a owl:Class ;
    rdfs:label "Sheffield Advanced Manufacturing"@en ;
    rdfs:comment "Sheffield Advanced Manufacturing denotes the cluster of research institutions, industrial facilities, and technology parks centred on the Advanced Manufacturing Park (AMP) in South Yorkshire, UK, specialising in materials science, aerospace engineering, robotics, and Industry 4.0 technologies. Anchored by the University of Sheffield's Advanced Manufacturing Research Centre (AMRC) and hosting global firms including Boeing and Rolls-Royce, the cluster forms the core of the Advanced Manufacturing Innovation District (AMID) — the UK's largest research-led advanced manufacturing ecosystem. It bridges traditional industrial heritage with digital manufacturing, additive processes, and intelligent automation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:robotics ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:industrial-automation ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:north-england-innovation-corridor ],
        ngm:uk-tech-ecosystem ;
    vc:enables ngm:industrial-io-t,
        ngm:robotics-application ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:industrial-automation,
        ngm:north-england-innovation-corridor,
        ngm:robotics ;
    vc:isPartOf ngm:uk-tech-ecosystem ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:newcastle-ai-and-health-innovation,
        ngm:nicve-virtual-reality-research-centre,
        ngm:sustainable-technology ;
    vc:slug "sheffield-advanced-manufacturing" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:digital-twin,
        ngm:industrial-robot,
        ngm:sensor-fusion .

ngm:signal-amplifier a owl:Class ;
    rdfs:label "Signal Amplifier"@en ;
    rdfs:comment "A signal amplifier is an electronic circuit that increases the power, voltage, or current of a weak signal while ideally preserving its waveform. In sensing applications it boosts low-amplitude transducer outputs above the noise floor so they can be digitised, with gain, bandwidth, noise figure, and linearity as key parameters. It is an essential front-end component of sensors and biosignal acquisition systems."@en ;
    rdfs:subClassOf ngm:hardware ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:brain-computer-interfaces,
        ngm:infrared-sensor ;
    vc:slug "signal-amplifier" ;
    vc:sourceDomain "robotics" .

ngm:signal-processing-unit a owl:Class ;
    rdfs:label "Signal Processing Unit"@en ;
    rdfs:comment "A signal processing unit is the hardware or firmware block that filters, transforms, and extracts features from raw sensor or transducer signals, often using DSP cores, FFTs, and digital filtering. In haptic and biosensing devices it converts captured analogue or digital streams into actionable control signals or feature vectors in real time. It is a core processing component of interactive sensing interfaces."@en ;
    rdfs:subClassOf ngm:hardware ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:biosensing-interface,
        ngm:haptics ;
    vc:slug "signal-processing-unit" ;
    vc:sourceDomain "robotics" .

ngm:signature-algorithm a owl:Class ;
    rdfs:label "Signature Algorithm"@en ;
    rdfs:comment "A signature algorithm is a cryptographic scheme comprising key generation, signing, and verification procedures that lets a holder of a private key produce a value provably tied to a message, which anyone with the public key can verify. It provides authenticity, integrity, and non-repudiation, with families including RSA, ECDSA, EdDSA, and Schnorr. It is the cryptographic primitive underpinning digital signatures."@en ;
    rdfs:subClassOf ngm:cryptographic-primitive ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:digital-signature-verification,
        ngm:digital-signatures ;
    vc:slug "signature-algorithm" ;
    vc:sourceDomain "security" .

ngm:signature-scheme a owl:Class ;
    rdfs:label "Signature Scheme"@en ;
    rdfs:comment "A Signature Scheme is a cryptographic primitive that provides a triple of algorithms—key generation, signing, and verification—enabling a party holding a private key to produce an unforgeable authentication tag over arbitrary messages that any holder of the corresponding public key can verify. In blockchain systems, signature schemes authenticate transactions, authorise state transitions, and underpin identity and ownership semantics across the distributed ledger."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:digital-signature ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:elliptic-curve-cryptography ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:hash-function ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:public-key-cryptography ],
        ngm:bc-cryptographic-primitive,
        ngm:blockchain-entity,
        ngm:cryptographic-primitive ;
    skos:broader ngm:bc-cryptographic-primitive ;
    vc:enables ngm:authentication,
        ngm:blockchain-transaction,
        ngm:digital-signature-verification ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:digital-signature,
        ngm:public-key-cryptography ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:distributed-ledger-technology,
        ngm:smart-contract ;
    vc:requires ngm:elliptic-curve-cryptography,
        ngm:hash-function ;
    vc:slug "signature-scheme" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:key-management,
        ngm:public-key-infrastructure .

ngm:simd a skos:Concept ;
    rdfs:label "Simd"@en .

ngm:smart-contract-audit a owl:Class ;
    rdfs:label "Smart Contract Audit"@en ;
    rdfs:comment "A smart contract audit is a structured security review of on-chain contract code that seeks to identify vulnerabilities, logic errors and economic flaws before deployment to an immutable ledger. Auditors combine manual code review with static analysis, automated scanners and, where warranted, formal verification to assess correctness against the intended specification. Because deployed contracts often custody substantial value and cannot easily be patched, auditing is a critical control in the blockchain and decentralised finance lifecycle."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:code-review ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:formal-verification ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:smart-contract ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:static-analysis ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:solidity ],
        ngm:security-audit ;
    vc:bridgesTo ngm:formal-verification,
        ngm:security-audit ;
    vc:dependsOn ngm:smart-contract ;
    vc:enables ngm:blockchain-security,
        ngm:decentralised-finance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:code-review,
        ngm:formal-verification,
        ngm:static-analysis ;
    vc:isPartOf ngm:blockchain-security ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:ethereum,
        ngm:reentrancy-attack,
        ngm:vulnerability ;
    vc:requires ngm:smart-contract,
        ngm:solidity ;
    vc:slug "smart-contract-audit" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:evm ;
    vc:uses ngm:formal-verification,
        ngm:static-analysis .

ngm:smart-contract-security a owl:Class ;
    rdfs:label "Smart Contract Security"@en ;
    rdfs:comment "Smart contract security is the discipline of designing, reviewing, and verifying on-chain programs so they behave correctly and resist exploitation despite handling irreversible value transfers. Because deployed contracts are typically immutable and publicly visible, vulnerabilities such as reentrancy, access-control flaws, and arithmetic errors can lead to permanent loss of funds. The field combines secure coding patterns, automated analysis, formal verification, audits, and economic safeguards."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:evm-compatibility ],
        ngm:security-audit ;
    vc:bridgesTo ngm:security ;
    vc:contrastsWith ngm:gas-optimization ;
    vc:dependsOn ngm:ethereum ;
    vc:enables ngm:liquidity ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:blockchain,
        ngm:oracle,
        ngm:slippage ;
    vc:requires ngm:evm-compatibility ;
    vc:slug "smart-contract-security" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:de-fi,
        ngm:smart-contract ;
    vc:uses ngm:audit,
        ngm:formal-verification .

ngm:smart-home-automation a owl:Class ;
    rdfs:label "Smart Home Automation"@en ;
    rdfs:comment "Smart Home Automation is the networked control and coordination of domestic devices — lighting, heating, security, appliances, and entertainment — so that they can be monitored and operated remotely or triggered automatically by rules, schedules, and sensor input. It builds on Internet of Things connectivity, local hubs, and standard protocols to integrate heterogeneous devices into a single controllable environment. Voice assistants, mobile apps, and rule engines provide the user interface, while local processing increasingly handles latency-sensitive and privacy-sensitive logic. It enables energy management, accessibility, and convenience in residential settings."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:network-infrastructure ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:home-assistant ],
        ngm:internet-of-things ;
    vc:dependsOn ngm:internet-of-things,
        ngm:sensor-networks ;
    vc:enables ngm:energy-management,
        ngm:voice-assistant ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:home-assistant,
        ngm:iot-platform ;
    vc:implements ngm:automation ;
    vc:isPartOf ngm:internet-of-things ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:edge-computing,
        ngm:pervasive-computing ;
    vc:requires ngm:network-infrastructure ;
    vc:slug "smart-home-automation" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:building-automation,
        ngm:smart-grid ;
    vc:uses ngm:matter-protocol,
        ngm:mqtt,
        ngm:thread-protocol,
        ngm:zigbee .

ngm:smart-metering a owl:Class ;
    rdfs:label "Smart Metering"@en ;
    rdfs:comment "Smart Metering is the deployment of digital utility meters that record consumption of electricity, gas, water or heat at fine time resolution and communicate readings automatically to the utility and consumer. It replaces manual periodic readings with two-way communication, enabling near real-time monitoring, remote configuration and dynamic tariffs. Smart meters are a foundational component of advanced metering infrastructure and the broader smart grid."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:internet-of-things ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:sensor-networks ],
        ngm:energy-management ;
    vc:bridgesTo ngm:advanced-metering-infrastructure ;
    vc:dependsOn ngm:sensor-networks ;
    vc:enables ngm:advanced-metering-infrastructure,
        ngm:demand-response ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:demand-response,
        ngm:smart-grid ;
    vc:requires ngm:internet-of-things,
        ngm:sensor-networks ;
    vc:slug "smart-metering" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:energy-management,
        ngm:smart-grid ;
    vc:uses ngm:internet-of-things .

ngm:snapshot-hub a owl:Class ;
    rdfs:label "Snapshot Hub"@en ;
    rdfs:comment "Snapshot Hub is the backend service of the Snapshot off-chain governance platform that stores proposals, collects signed votes, and computes results using token balances read at a chosen block height. Votes are signed messages that incur no gas, while the hub indexes and tallies them according to a configurable voting strategy. It lets DAOs run gasless, verifiable governance while final execution remains optional and off-chain."@en ;
    rdfs:subClassOf ngm:bc-network-component ;
    skos:broader ngm:bc-network-component ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:snapshot-block,
        ngm:snapshot-voting ;
    vc:slug "snapshot-hub" ;
    vc:sourceDomain "blockchain" .

ngm:snapshot-off-chain-voting a owl:Class ;
    rdfs:label "Snapshot Off-Chain Voting"@en ;
    rdfs:comment "A gasless governance platform that records votes off-chain by having participants sign messages, using token balances captured at a chosen block as voting weight. It avoids transaction fees while preserving a verifiable tally tied to on-chain holdings."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:digital-signature ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:token ],
        ngm:decentralized-governance ;
    vc:enables ngm:daogovernance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:digital-signature,
        ngm:token ;
    vc:slug "snapshot-off-chain-voting" ;
    vc:sourceDomain "blockchain" .

ngm:soc-2 a owl:Class ;
    rdfs:label "Soc 2"@en ;
    rdfs:comment "SOC 2 (System and Organisation Controls 2) is an auditing standard developed by the American Institute of Certified Public Accountants (AICPA) that evaluates the controls of service organisations relevant to security, availability, processing integrity, confidentiality, and privacy. A SOC 2 report, issued by an independent CPA, is widely used by cloud service providers and SaaS companies to demonstrate trustworthiness to enterprise customers. Type I reports assess design at a point in time; Type II reports assess operating effectiveness over a period."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:security-audit ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:access-control ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:incident-response ],
        ngm:security ;
    vc:contrastsWith ngm:iso-27001,
        ngm:pci-dss,
        ngm:soc-1 ;
    vc:enables ngm:regulatory-compliance,
        ngm:vendor-trust ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:control-environment,
        ngm:trust-services-criteria ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:cloud-security,
        ngm:data-governance,
        ngm:privacy ;
    vc:requires ngm:access-control,
        ngm:incident-response,
        ngm:security-audit ;
    vc:slug "soc-2" ;
    vc:sourceDomain "security" ;
    vc:standardizedBy ngm:aicpa,
        ngm:trust-services-criteria ;
    vc:supports ngm:enterprise-software,
        ngm:saas .

ngm:social-impact a owl:Class ;
    rdfs:label "Social Impact"@en ;
    rdfs:comment "Social Impact refers to the full spectrum of effects — positive and negative, intended and unintended — that AI systems and digital technologies exert on individuals, communities, and social structures, encompassing changes to employment patterns, educational access, cultural practices, power distributions, social cohesion, and fundamental rights. Assessing social impact requires both quantitative metrics and qualitative analysis across affected stakeholder groups."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ai-impact-assessment ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:social-impact-assessment-sia ],
        ngm:sc-governance-and-safety ;
    skos:broader ngm:sc-governance-and-safety ;
    vc:contrastsWith ngm:digital-society-harms ;
    vc:enables ngm:ai-governance ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:digital-society,
        ngm:social-contract,
        ngm:societal-and-environmental-wellbeing ;
    vc:requires ngm:ai-impact-assessment,
        ngm:social-impact-assessment-sia ;
    vc:slug "social-impact" ;
    vc:sourceDomain "spatial-computing" .

ngm:social-impact-assessment-sia a owl:Class ;
    rdfs:label "Social Impact Assessment (SIA)"@en ;
    rdfs:comment "Systematic eof potential social consequences of metaverse deployment on communities, stakeholder groups, and societal well-being."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:impact-metrics ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-collection ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:risk-assessment ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:stakeholder-analysis ],
        ngm:metaverse-governance-and-safeguarding,
        ngm:sc-governance-and-safety ;
    skos:broader ngm:sc-governance-and-safety ;
    vc:enables ngm:responsible-deployment ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:impact-metrics,
        ngm:risk-assessment,
        ngm:stakeholder-analysis ;
    vc:isPartOf ngm:compliance-management,
        ngm:governance-framework ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:data-collection,
        ngm:stakeholder-mapping ;
    vc:slug "social-impact-assessment-sia" ;
    vc:sourceDomain "spatial-computing" .

ngm:social-system a owl:Class ;
    rdfs:label "Social System"@en ;
    rdfs:comment "A social system, in the context of virtual worlds, is the combination of features and rules that enable users to find, communicate with, and form relationships with one another, including presence, friend graphs, groups, voice and text chat, and reputation. It provides the connective fabric that turns a rendered space into an inhabited community. The design of these systems shapes safety, belonging, and the network effects that sustain a persistent virtual environment."@en ;
    rdfs:subClassOf ngm:sc-interaction ;
    skos:broader ngm:sc-interaction ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:metaverse,
        ngm:virtual-world ;
    vc:slug "social-system" ;
    vc:sourceDomain "metaverse" .

ngm:societal-and-environmental-wellbeing a owl:Class ;
    rdfs:label "Societal and Environmental Wellbeing"@en ;
    rdfs:comment "Societal and Environmental Wellbeing is a trustworthiness dimension ensuring AI systems consider broader impacts on communities, environments, democratic processes, and human flourishing beyond immediate functional objectives. It promotes sustainable development, social cohesion, and alignment with the UN Sustainable Development Goals across the AI lifecycle."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ai-impact-assessment ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:carbon-footprint-assessment ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:responsible-ai ],
        ngm:ai-ethics,
        ngm:ai-governance-and-ethics ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:enables ngm:democratic-participation,
        ngm:digital-rights ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:ai-fairness,
        ngm:ai-governance,
        ngm:algorithmic-accountability,
        ngm:carbon-neutrality-planning,
        ngm:responsible-ai-principles,
        ngm:transparency ;
    vc:requires ngm:ai-impact-assessment,
        ngm:carbon-footprint-assessment,
        ngm:responsible-ai ;
    vc:slug "societal-and-environmental-wellbeing" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:software-engineering-agents a owl:Class ;
    rdfs:label "Software Engineering Agents"@en ;
    rdfs:comment "Software engineering agents are autonomous or semi-autonomous AI systems built on large language models that perform software development tasks — reading and editing codebases, running tests, debugging, and opening pull requests — by planning multi-step actions and invoking developer tools. They operate over real repositories using file navigation, shell execution, and version-control integration, and are evaluated on benchmarks such as SWE-bench that measure the rate at which they resolve genuine GitHub issues. They represent the application of agentic reasoning to the specific domain of writing and maintaining code."@en ;
    rdfs:subClassOf ngm:llm-agents ;
    vc:enables ngm:prompt-engineering ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:llm-application-framework,
        ngm:llm-orchestration ;
    vc:slug "software-engineering-agents" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:chain-of-thought,
        ngm:reasoning .

ngm:software-library a owl:Class ;
    rdfs:label "Software Library"@en ;
    rdfs:comment "A Software Library is a collection of pre-compiled, reusable code modules that expose stable APIs, encapsulating common functionality such as rendering, physics simulation, networking, or cryptography. Libraries accelerate development by abstracting complexity, reducing defect rates, and enabling interoperability between components within a software stack."@en ;
    rdfs:subClassOf ngm:infra-software-engineering ;
    skos:broader ngm:infra-software-engineering ;
    vc:enables ngm:software-development-process ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:relatedTo ngm:software-architecture,
        ngm:version-control ;
    vc:slug "software-library" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:machine-learning-discipline-framework,
        ngm:rendering-engine ;
    vc:uses ngm:api-standard .

ngm:space-robotics a owl:Class ;
    rdfs:label "Space Robotics"@en ;
    rdfs:comment "Space robotics is the engineering discipline concerned with the design, development, and operation of robotic systems that function in the space environment, including planetary rovers, orbital manipulators, free-flying servicer spacecraft, and landers. These systems must contend with extreme thermal cycling, vacuum, radiation, communications latency, and the absence of gravity, requiring high degrees of autonomy, fault tolerance, and dexterous manipulation capability. Space robotics intersects closely with teleoperation research, autonomous navigation, computer vision, and the emerging field of on-orbit servicing and assembly."@en ;
    rdfs:subClassOf ngm:autonomous-robot ;
    vc:enables ngm:autonomous-system,
        ngm:manipulation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:path-planning ;
    vc:slug "space-robotics" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:computer-vision,
        ngm:simultaneous-localisation-and-mapping .

ngm:spaced-repetition a owl:Class ;
    rdfs:label "Spaced Repetition"@en ;
    rdfs:comment "Spaced repetition is a learning technique that schedules reviews of material at increasing intervals timed to occur just before predicted forgetting, exploiting the psychological spacing effect to strengthen long-term retention efficiently. Algorithmic implementations track each item's review history and recall outcomes to compute the optimal next-review date, concentrating study effort on material at risk of being forgotten. It is a core mechanism in flashcard software and the memory-management components of adaptive learning systems."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:educational-technology ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cognitive-science ],
        ngm:adaptive-learning ;
    vc:bridgesTo ngm:artificial-intelligence ;
    vc:contrastsWith ngm:bayesian-knowledge-tracing ;
    vc:enables ngm:personalised-learning ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:adaptive-learning ;
    vc:isPartOf ngm:adaptive-learning,
        ngm:educational-technology ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:bayesian-knowledge-tracing,
        ngm:cognitive-science,
        ngm:item-response-theory ;
    vc:requires ngm:cognitive-science,
        ngm:educational-technology ;
    vc:slug "spaced-repetition" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:intelligent-tutoring-system,
        ngm:personalised-learning ;
    vc:uses ngm:machine-learning .

ngm:speech-act-theory a owl:Class ;
    rdfs:label "Speech Act Theory"@en ;
    rdfs:comment "Speech Act Theory is a framework from the philosophy of language holding that utterances perform actions rather than merely describing states of affairs. In distributed and multi-agent systems it underpins agent communication languages by classifying messages as performatives such as inform, request, commit, and declare, each carrying defined intent and felicity conditions. It distinguishes the locutionary content, illocutionary force, and perlocutionary effect of a communicative act, giving coordinating agents a shared semantics for interaction."@en ;
    rdfs:subClassOf ngm:distributed-systems ;
    vc:bridgesTo ngm:natural-language-understanding ;
    vc:contrastsWith ngm:inference-engine ;
    vc:enables ngm:coordination-protocol,
        ngm:negotiation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:contract-net-protocol ;
    vc:isPartOf ngm:distributed-systems ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:dialogue-system,
        ngm:knowledge-representation,
        ngm:semantic-web ;
    vc:slug "speech-act-theory" ;
    vc:sourceDomain "distributed-systems" ;
    vc:supports ngm:conversational-ai,
        ngm:intent-recognition ;
    vc:uses ngm:dialogue-management,
        ngm:natural-language-understanding .

ngm:splicing a owl:Class ;
    rdfs:label "Splicing"@en ;
    rdfs:comment "Splicing is a Lightning Network operation that resizes an existing payment channel by adding or removing on-chain funds without closing and reopening it, preserving the channel's state and routing history. A splice-in increases capacity by committing additional bitcoin, while a splice-out withdraws funds to an on-chain address, both executed through a single funding transaction. This keeps the channel continuously available and reduces the on-chain cost and downtime of channel management."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:on-chain-transaction ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:bitcoin ],
        ngm:payment-channel ;
    vc:bridgesTo ngm:on-chain-transaction ;
    vc:enables ngm:liquidity ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:implements ngm:payment-channel ;
    vc:isPartOf ngm:lightning-network ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:core-lightning,
        ngm:lightning-network,
        ngm:payment-channel ;
    vc:requires ngm:bitcoin,
        ngm:on-chain-transaction ;
    vc:slug "splicing" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:liquidity,
        ngm:payment-channel ;
    vc:uses ngm:bitcoin,
        ngm:on-chain-transaction .

ngm:sports-analytics a owl:Class ;
    rdfs:label "Sports Analytics"@en ;
    rdfs:comment "Sports analytics is the application of data capture, statistical modelling, and machine learning to athletic performance, tactics, and injury prevention, drawing on tracking data, biomechanics, and event logs. Computer-vision pipelines increasingly supply the underlying movement data by extracting player positions and body pose from video. It informs coaching decisions, talent evaluation, broadcast insight, and load management."@en ;
    rdfs:subClassOf ngm:ai-application ;
    skos:broader ngm:ai-application ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:motion-capture,
        ngm:pose-estimation ;
    vc:slug "sports-analytics" ;
    vc:sourceDomain "ai" .

ngm:standard-prompting a owl:Class ;
    rdfs:label "Standard Prompting"@en ;
    rdfs:comment "Standard prompting is the baseline method of querying a large language model by providing an instruction or question, optionally with input-output examples, and expecting an answer without an elicited reasoning process. It establishes the reference behaviour against which more elaborate strategies such as chain-of-thought, self-consistency and tool-augmented prompting are compared. Standard prompting subsumes zero-shot and few-shot formulations that map directly from prompt to answer."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:zero-shot-prompting ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:large-language-model ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:few-shot-prompting ],
        ngm:prompt-engineering ;
    vc:bridgesTo ngm:in-context-learning ;
    vc:contrastsWith ngm:chain-of-thought-reasoning,
        ngm:direct-answer-prompting ;
    vc:dependsOn ngm:large-language-model ;
    vc:enables ngm:in-context-learning ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:few-shot-prompting,
        ngm:zero-shot-prompting ;
    vc:isPartOf ngm:prompt-engineering ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:in-context-learning,
        ngm:prompt-template ;
    vc:requires ngm:large-language-model ;
    vc:slug "standard-prompting" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:natural-language-processing ;
    vc:uses ngm:large-language-model,
        ngm:prompt-template .

ngm:start-configuration a owl:Class ;
    rdfs:label "Start Configuration"@en ;
    rdfs:comment "A start configuration is the initial pose of a robot or articulated system, expressed as a point in its configuration space, from which a motion or path planner must compute a feasible route to a goal configuration. It encodes the complete set of joint values or positional parameters that fully describe the system's state at the beginning of a planned motion. Together with the goal configuration, it bounds the planning query."@en ;
    rdfs:subClassOf ngm:robo-navigation-and-planning ;
    skos:broader ngm:robo-navigation-and-planning ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:path-planning,
        ngm:trajectory-generation ;
    vc:slug "start-configuration" ;
    vc:sourceDomain "robotics" .

ngm:state-space-control a owl:Class ;
    rdfs:label "State Space Control"@en ;
    rdfs:comment "State Space Control is a modern control theory framework that describes dynamic systems as a set of first-order differential equations over an internal state vector, enabling full-state feedback design via techniques such as pole placement, LQR, and model predictive control. Unlike classical frequency-domain methods, state-space representations directly support multi-input multi-output systems, observer design, and optimal control synthesis, making them foundational for robotic and aerospace applications."@en ;
    rdfs:subClassOf ngm:feedback-control,
        ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:enables ngm:autonomous-robot,
        ngm:motion-planning,
        ngm:multirotor-uav ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:state-space-sequence-models ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:adaptive-control,
        ngm:control-system,
        ngm:control-theory,
        ngm:pid-control ;
    vc:slug "state-space-control" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:kalman-filter,
        ngm:optimal-control .

ngm:state-space-search a skos:Concept ;
    rdfs:label "State Space Search"@en .

ngm:stateless-architecture a owl:Class ;
    rdfs:label "Stateless Architecture"@en ;
    rdfs:comment "Stateless architecture is a design approach in which each request carries all the information needed to process it, and the serving component retains no client session state between requests. By externalising state to caches, databases, or tokens, stateless services can be freely replicated, replaced, and load-balanced, which simplifies horizontal scaling and fault recovery at the cost of pushing state management to dedicated stores."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:load-balancing ],
        ngm:cloud-native ;
    vc:contrastsWith ngm:microservices ;
    vc:dependsOn ngm:scalability ;
    vc:enables ngm:load-balancing,
        ngm:scalability ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:rest-api ;
    vc:isPartOf ngm:cloud-native ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:containerisation,
        ngm:kubernetes ;
    vc:requires ngm:load-balancing ;
    vc:slug "stateless-architecture" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:container-orchestration,
        ngm:microservices ;
    vc:uses ngm:rest-api .

ngm:statistical-process-control a owl:Class ;
    rdfs:label "Statistical Process Control"@en ;
    rdfs:comment "Statistical Process Control (SPC) is a quality-control methodology that applies statistical methods to monitor and control a manufacturing or service process. By tracking process variation over time against statistically derived control limits, SPC distinguishes ordinary common-cause variation from assignable special-cause variation, enabling operators to intervene only when a process is genuinely out of control. It underpins continuous improvement and defect prevention in industrial production."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:monitoring ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:monitoring ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:sensor ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:statistics ],
        ngm:quality-control ;
    vc:bridgesTo ngm:machine-learning ;
    vc:contrastsWith ngm:anomaly-detection ;
    vc:enables ngm:anomaly-detection,
        ngm:industrial-inspection ;
