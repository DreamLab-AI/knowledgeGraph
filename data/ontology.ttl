ngm:secret-sharing a owl:Class ;
    rdfs:label "Secret Sharing"@en ;
    rdfs:comment "Secret sharing is a cryptographic technique that splits a secret into multiple shares distributed among participants such that only an authorised subset, meeting a defined threshold, can reconstruct the secret, while any smaller subset learns nothing about it. The canonical construction, Shamir's secret sharing, uses polynomial interpolation over a finite field. Secret sharing underpins threshold cryptography, distributed key management and secure multi-party computation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:shamir-secret-sharing ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptographic-protocol ],
        ngm:cryptography ;
    vc:dependsOn ngm:encryption ;
    vc:enables ngm:key-management,
        ngm:multi-party-computation,
        ngm:privacy-preserving-computation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:shamir-secret-sharing ;
    vc:implements ngm:threshold-cryptography ;
    vc:isPartOf ngm:cryptography ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:distributed-systems,
        ngm:security ;
    vc:requires ngm:cryptographic-protocol ;
    vc:slug "secret-sharing" ;
    vc:sourceDomain "security" ;
    vc:supports ngm:access-control,
        ngm:custody,
        ngm:multisignature,
        ngm:wallet .

ngm:security-audit a owl:Class ;
    rdfs:label "Security Audit"@en ;
    rdfs:comment "A security audit is a systematic evaluation of a system's controls, configurations, and code against security requirements and threats. It combines techniques such as code review, configuration assessment, penetration testing, and control verification to identify vulnerabilities and compliance gaps. Audits produce evidence and remediation guidance used to reduce risk and demonstrate assurance."@en ;
