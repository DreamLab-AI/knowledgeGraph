    vc:requires ngm:value-alignment ;
    vc:slug "goal" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:governance-structure a owl:Class ;
    rdfs:label "Governance Structure"@en ;
    rdfs:comment "A governance structure is the formal arrangement of authority, accountability, decision-making rights, and control mechanisms within an organisation, system, protocol, or jurisdiction that determines how strategic direction is set, resources are allocated, obligations are enforced, and stakeholde..."@en ;
