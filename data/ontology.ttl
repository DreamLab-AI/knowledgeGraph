ngm:rasterization a owl:Class ;
    rdfs:label "Rasterization"@en ;
    rdfs:comment "The dominant real-time rendering technique that converts 3D geometric primitives — predominantly triangles — into a 2D pixel representation by determining per-pixel coverage, depth, and colour through a GPU-accelerated pipeline of vertex processing, primitive assembly, scan conversion, fragment shading, and output merging. Rasterization trades photorealistic accuracy for deterministic, high-throughput performance suitable for interactive applications."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:graphics-processing-unit ],
        ngm:sc-display-and-rendering ;
    skos:broader ngm:sc-display-and-rendering ;
    vc:bridgesTo ngm:augmented-reality,
        ngm:metaverse ;
    vc:contrastsWith ngm:path-tracing,
        ngm:ray-tracing ;
    vc:enables ngm:real-time-3d-graphics,
        ngm:video-game-rendering,
        ngm:virtual-reality-rendering ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:fragment-shading,
        ngm:output-merger,
        ngm:primitive-assembly,
        ngm:vertex-processing ;
    vc:isPartOf ngm:graphics-pipeline,
        ngm:real-time-rendering ;
    vc:qualityScore "0.68"^^xsd:float ;
    vc:relatedTo ngm:antialiasing,
        ngm:level-of-detail,
        ngm:texture-mapping ;
    vc:requires ngm:depth-buffer,
        ngm:graphics-processing-unit,
        ngm:triangle-mesh ;
    vc:slug "rasterization" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:post-processing,
        ngm:rendering-technique,
        ngm:shadow-mapping ;
    vc:uses ngm:geometry-shader,
        ngm:pixel-shader,
        ngm:vertex-shader,
        ngm:z-buffer .

ngm:rb-0089-risk-assessment a owl:Class ;
    rdfs:label "rb 0089 risk assessment"@en ;
    rdfs:comment "Risk Assessment in robotics is the systematic process of identifying hazards associated with a robot system, estimating the severity and probability of potential harm, and determining whether risks are acceptable or require mitigation. It is mandated by ISO 10218-1/-2 for industrial robots and ISO 13482 for personal care robots, and forms the foundation for selecting appropriate safeguarding measures and collaborative operation modes."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:rb-0087-safety-standard ],
        ngm:robo-safety-and-standards ;
    skos:broader ngm:robo-safety-and-standards ;
    vc:dependsOn ngm:rb-0088-iso-13482-compliance ;
    vc:enables ngm:rb-0096-safeguarding,
        ngm:rb-0103-collaborative-operation ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:functional-safety,
        ngm:rb-0090-emergency-stop,
        ngm:rb-0095-safety-zone,
        ngm:rb-0100-safety-integrity-level,
        ngm:risk-assessment ;
    vc:requires ngm:rb-0087-safety-standard ;
    vc:slug "rb-0089-risk-assessment" ;
    vc:sourceDomain "robotics" .

ngm:real-time-control a owl:Class ;
    rdfs:label "Real-Time Control"@en ;
    rdfs:comment "Real-Time Control is the design and implementation of control systems that must respond to sensor inputs and actuator commands within bounded, deterministic time deadlines, where missing a deadline constitutes system failure. Hard real-time systems—common in aircraft fly-by-wire, automotive ABS, and surgical robotics—require guaranteed worst-case execution times measured in microseconds to milliseconds. Soft real-time systems tolerate occasional deadline misses with degraded performance rather than catastrophic failure. Real-time control relies on real-time operating systems (RTOS), dedicated hardware co-processors, and carefully bounded software to ensure predictable timing under all operating conditions."@en ;
    rdfs:subClassOf ngm:control-system ;
    vc:bridgesTo ngm:digital-twin,
        ngm:edge-computing ;
    vc:contrastsWith ngm:batch-processing ;
    vc:enables ngm:autonomous-systems,
        ngm:closed-loop-control,
        ngm:industrial-automation,
        ngm:motion-control,
        ngm:robot-control ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:control-loop,
        ngm:deadline-scheduling ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:determinism,
        ngm:embedded-systems,
        ngm:feedback-control,
        ngm:interrupt-handling,
        ngm:real-time-operating-system,
        ngm:worst-case-execution-time ;
    vc:requires ngm:deterministic-networking,
        ngm:priority-scheduling,
        ngm:task-scheduling ;
    vc:slug "real-time-control" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:actuator,
        ngm:latency,
        ngm:pid-controller,
        ngm:sensor-fusion,
        ngm:state-estimation .

ngm:regularisation a owl:Class ;
    rdfs:label "Regularisation"@en ;
    rdfs:comment "A family of techniques that constrain or penalise model complexity during training to prevent overfitting and improve generalisation to unseen data. Common methods include L1 (Lasso) and L2 (Ridge) weight penalties, dropout, early stopping, and data augmentation, each discouraging the model from memorising noise at the expense of learning underlying patterns."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:hyperparameter-tuning ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:dropout ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:early-stopping ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:loss-function ],
        ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:bridgesTo ngm:bayesian-inference,
        ngm:explainable-ai ;
    vc:contrastsWith ngm:overfitting,
        ngm:underfitting ;
    vc:dependsOn ngm:cross-validation,
        ngm:gradient-descent ;
    vc:enables ngm:deep-learning,
        ngm:generalisation,
        ngm:model-robustness ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:dropout,
        ngm:early-stopping,
        ngm:elastic-net,
        ngm:l1-regularisation,
        ngm:l2-regularisation ;
    vc:isPartOf ngm:model-training ;
    vc:qualityScore "0.68"^^xsd:float ;
    vc:relatedTo ngm:bias-variance-tradeoff,
        ngm:model-complexity,
        ngm:neural-network-pruning,
        ngm:training ;
    vc:requires ngm:hyperparameter-tuning,
        ngm:loss-function ;
    vc:slug "regularisation" ;
    vc:sourceDomain "machine-learning" ;
    vc:supports ngm:feature-selection,
        ngm:model-training ;
    vc:uses ngm:penalty-term,
        ngm:weight-decay .

ngm:remote-collaboration a owl:Class ;
    rdfs:label "Remote Collaboration"@en ;
    rdfs:comment "Remote Collaboration encompasses the work practices, platforms, and coordination methodologies that enable geographically distributed teams to plan, create, and deliver work without physical co-location. It integrates synchronous channels such as video conferencing, real-time co-editing, and spatial audio with asynchronous mechanisms such as version control, persistent messaging, and project management systems, binding these into coherent workflows that maintain team cohesion and productivity across time zones. The discipline draws on computer-supported cooperative work (CSCW) research, network infrastructure, human-computer interaction, and organisational science to address shared challenges of presence, trust, latency, and equitable participation. Increasingly, AI-powered features such as automatic transcription, meeting summarisation, and action-item extraction, together with immersive spatial interfaces from XR and the metaverse, are extending the fidelity and richness of distributed work."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:identity-and-access-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:encryption ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:video-conferencing ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:network-connectivity ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:virtual-workspace ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:asynchronous-communication ],
        ngm:distributed-collaboration ;
    skos:broader ngm:distributed-collaboration ;
    vc:bridgesTo ngm:immersive-communication,
        ngm:metaverse-workspaces,
        ngm:telecollaboration,
        ngm:virtual-collaboration ;
    vc:contrastsWith ngm:co-located-collaboration,
        ngm:synchronous-communication ;
    vc:dependsOn ngm:cloud-computing,
        ngm:content-delivery-network ;
    vc:enables ngm:distributed-teams,
        ngm:knowledge-sharing,
        ngm:remote-work ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:asynchronous-communication,
        ngm:collaborative-document-editing,
        ngm:video-conferencing,
        ngm:virtual-workspace ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:computer-supported-cooperative-work,
        ngm:digital-workplace,
        ngm:presence-awareness ;
    vc:requires ngm:encryption,
        ngm:identity-and-access-management,
        ngm:network-connectivity ;
    vc:slug "remote-collaboration" ;
    vc:sourceDomain "distributed-collaboration" ;
    vc:supports ngm:agile-development,
        ngm:human-computer-interaction,
        ngm:open-source-development ;
    vc:uses ngm:conflict-free-replicated-data-types,
        ngm:operational-transformation,
        ngm:spatial-audio,
        ngm:version-control .

ngm:stakeholder-engagement a owl:Class ;
    rdfs:label "Stakeholder Engagement"@en ;
    rdfs:comment "Stakeholder Engagement is the structured process through which organisations identify, communicate with, and incorporate the perspectives of individuals and groups who have interests in or are affected by a project, system, or policy. Effective engagement moves along a spectrum from one-way information provision through consultation to active co-design and ongoing collaborative governance. In the context of emerging technologies such as AI, robust stakeholder engagement is recognised as essential for identifying ethical risks, ensuring societal legitimacy, and building the trust necessary for adoption. Regulatory frameworks and voluntary standards increasingly mandate evidence of meaningful stakeholder engagement as a condition of approval or certification."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:transparency ],
        ngm:infra-legal-and-regulatory ;
    skos:broader ngm:infra-legal-and-regulatory ;
    vc:bridgesTo ngm:ai-alignment,
        ngm:distributed-collaboration ;
    vc:enables ngm:ai-governance-framework,
        ngm:change-management,
        ngm:co-design,
        ngm:collaborative-systems-modality-design,
        ngm:legitimacy,
        ngm:trust-building ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:civic-participation,
        ngm:community-governance,
        ngm:deliberative-democracy,
        ngm:democratic-participation,
        ngm:participatory-design,
