        ngm:quality-control ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:computer-vision-system ;
    vc:isPartOf ngm:machine-vision ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:automation,
        ngm:data-analytics ;
    vc:requires ngm:feature-extraction,
