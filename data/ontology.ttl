    a owl:Restriction ;
    owl:onProperty infrastructure:implements ;
    owl:someValuesFrom blockchain:ConsensusProtocol
] .

blockchain:HyperledgerBesu rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty infrastructure:partOf ;
    owl:someValuesFrom blockchain:HyperledgerFoundation
] .

