ngm:threaded-messaging a owl:Class ;
    rdfs:label "Threaded Messaging"@en ;
    rdfs:comment "Threaded Messaging is a structured asynchronous communication pattern in which replies are grouped beneath a parent message, forming discrete conversation threads that preserve context and reduce noise in shared channels. By isolating discussions, it enables parallel workstreams within a single collaboration platform while keeping notification volume manageable for participants. Platforms such as Slack and Discord popularised the pattern, which is now foundational to modern digital workplace communication."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:asynchronous-collaboration ],
        ngm:asynchronous-collaboration,
        ngm:dc-communication ;
    skos:broader ngm:dc-communication ;
    vc:contrastsWith ngm:asynchronous-collaboration ;
    vc:enables ngm:knowledge-management,
        ngm:remote-collaboration ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:collaboration-platform ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:chatbots,
        ngm:knowledge-management-system ;
    vc:requires ngm:asynchronous-collaboration ;
    vc:slug "threaded-messaging" ;
    vc:sourceDomain "distributed-collaboration" ;
    vc:uses ngm:workflow-automation .

