    rdfs:label "Software Engineering Automation"@en .

ngm:source-routing a owl:Class ;
    rdfs:label "Source Routing"@en ;
    rdfs:comment "Source routing is a packet-forwarding technique in which the sender, rather than intermediate routers, specifies all or part of the path a packet must traverse, embedding the route as a list of hops within the packet itself. By moving path selection to the originator it enables explicit path control, multipath delivery, and privacy-preserving forwarding, at the cost of overhead and forwarding-table-bypass security considerations. It underpins onion-routing anonymity networks and payment-channel networks, where the sender constructs and conceals an end-to-end route across an overlay before any hop sees the full path."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:network-protocol ],
        ngm:routing ;
    vc:bridgesTo ngm:overlay-network,
        ngm:tor ;
    vc:contrastsWith ngm:routing-protocol ;
    vc:dependsOn ngm:routing-protocol ;
    vc:enables ngm:onion-routing,
        ngm:overlay-network ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:routing-protocol ;
    vc:isPartOf ngm:network-layer ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:networking,
        ngm:onion-routing,
        ngm:packet-switching ;
    vc:requires ngm:network-protocol ;
    vc:slug "source-routing" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:privacy ;
    vc:uses ngm:network-protocol,
        ngm:packet-switching .

ngm:spam-prevention a owl:Class ;
    rdfs:label "Spam Prevention"@en ;
    rdfs:comment "Spam prevention is the set of mechanisms that deter the flooding of a shared system with low-value or malicious activity. In blockchain networks it most commonly takes the form of transaction fees or proof-of-work requirements that impose a real cost on each submission, making large-scale spamming economically or computationally infeasible. Spam prevention protects scarce resources such as block space, mempool capacity and validator compute from denial-of-service style abuse. It is a key design constraint that interacts with throughput, fee markets and decentralisation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:transaction-fee ],
        ngm:blockchain ;
    skos:broader ngm:blockchain ;
    vc:bridgesTo ngm:sybil-attack ;
    vc:contrastsWith ngm:proof-of-stake ;
    vc:dependsOn ngm:consensus-mechanism ;
    vc:enables ngm:scalability ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:fee-market ;
    vc:isPartOf ngm:network-security ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:fee-market,
        ngm:transaction,
        ngm:validator ;
    vc:requires ngm:transaction-fee ;
    vc:slug "spam-prevention" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:mempool ;
    vc:uses ngm:proof-of-work,
        ngm:transaction-fee .

ngm:sparse-mixture-of-experts a owl:Class ;
    rdfs:label "Sparse Mixture of Experts"@en ;
    rdfs:comment "An MoE variant with a trainable gating network that selects only a sparse combination of experts for each example, dramatically increasing model capacity whilst maintaining computational efficiency. Sparsely-gated MoE enables models with up to 137 billion parameters with manageable inference costs."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:inference ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:attention-mechanism ],
        [ a owl:Restriction ;
