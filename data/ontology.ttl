    vc:sourceDomain "spatial-computing" .

ngm:asset-management-system a owl:Class ;
    rdfs:label "Asset Management System"@en ;
    rdfs:comment "An Asset Management System (AMS) is an integrated software platform that tracks, manages, and optimises the lifecycle of physical, digital, or financial assets across an organisation. It consolidates asset data including acquisition, depreciation, maintenance, and disposal into a single governed repository. Modern AMS platforms enforce audit trails, automate compliance reporting, and feed into enterprise resource planning (ERP) and financial systems. They enable organisations to reduce total cost of ownership, mitigate risk, and demonstrate regulatory compliance."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:monitoring-system ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:digital-asset-management ],
        ngm:asset-management ;
    vc:enables ngm:compliance-audit-trail,
        ngm:compliance-monitoring,
        ngm:quality-assurance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:digital-asset-management,
        ngm:monitoring-system ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:data-governance,
        ngm:digital-twin,
        ngm:supply-chain-management ;
    vc:slug "asset-management-system" ;
    vc:sourceDomain "infrastructure" .

ngm:attention-head a owl:Class ;
    rdfs:label "Attention Head"@en ;
    rdfs:comment "One of multiple parallel scaled dot-product attention mechanisms in a multi-head attention layer, each operating over a distinct linear projection of the input. Individual heads specialise in different linguistic or structural patterns; most learn simple positional relationships and many can be pruned without significant loss, though a subset carry disproportionate representational load."@en ;
    rdfs:subClassOf ngm:ai-model-architecture ;
    skos:broader ngm:ai-model-architecture ;
    vc:enables ngm:transformers ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:attention-mechanism,
        ngm:network-architecture ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:relatedTo ngm:attention,
        ngm:transformer-architecture ;
    vc:slug "attention-head" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:attention-weight .

ngm:automated-reasoning a owl:Class ;
    rdfs:label "Automated Reasoning"@en ;
    rdfs:comment "Automated Reasoning is a subfield of artificial intelligence and computer science concerned with developing algorithms and systems that can perform logical inference, theorem proving, satisfiability checking, and knowledge-based deduction without continuous human guidance. It encompasses formal methods such as first-order logic, propositional calculus, and higher-order logics, implemented in systems ranging from SAT solvers and automated theorem provers to description logic reasoners underpinning knowledge graphs. Automated reasoning forms the rigorous backbone of formal verification, ontology inference, planning, and constraint satisfaction problems."@en ;
    rdfs:subClassOf ngm:reasoning ;
    vc:enables ngm:automated-planning,
        ngm:formal-verification,
        ngm:knowledge-graph ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:knowledge-representation,
        ngm:logic-programming,
        ngm:symbolic-reasoning ;
    vc:slug "automated-reasoning" ;
    vc:sourceDomain "ai" ;
    vc:supports ngm:expert-systems,
        ngm:symbolic-ai .

ngm:avatar-standard a owl:Class ;
    rdfs:label "Avatar Standard"@en ;
    rdfs:comment "Avatar Standard refers to technical specifications defining file formats, data structures, rigging conventions, and metadata schemas for 3D humanoid avatars, particularly the VRM format built on glTF 2.0 that enables cross-platform avatar interoperability in metaverse environments."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:format-compliance ],
        ngm:sc-standards-and-interop,
        ngm:technical-standard ;
    skos:broader ngm:sc-standards-and-interop ;
    vc:enables ngm:avatar-interoperability,
