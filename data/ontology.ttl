ngm:sim-clr a owl:Class ;
    rdfs:label "SimCLR"@en ;
    rdfs:comment "A self-supervised learning framework that learns visual representations through contrastive learning with data augmentation. A linear classifier on SimCLR representations achieves top-1 accuracy, matching supervised ResNet-50 performance."@en ;
    rdfs:subClassOf ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:enables ngm:computer-vision,
        ngm:image-classification,
        ngm:transfer-learning ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:deep-learning,
        ngm:fine-tuning ;
    vc:slug "sim-clr" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:contrastive-learning,
        ngm:data-augmentation-strategies,
        ngm:neural-network-architecture .

