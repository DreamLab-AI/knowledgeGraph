ngm:trezor a owl:Class ;
    rdfs:label "Trezor"@en ;
    rdfs:comment "Trezor is a line of hardware wallets developed by SatoshiLabs that store cryptocurrency private keys in a tamper-resistant, air-gapped physical device, preventing key exposure to internet-connected hosts. Transactions are signed entirely within the secure element of the device, meaning the private key never leaves the hardware even during active use. Trezor devices implement BIP32 hierarchical deterministic (HD) wallet derivation, BIP39 mnemonic seed phrases, and BIP44 multi-account structures, making them a foundational reference implementation for open-source hardware wallet design. As a mature consumer product launched in 2014, Trezor represents the established category of cold-storage self-custody devices that underpin non-custodial asset management in decentralised finance."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:private-key ],
        ngm:cold-storage ;
    vc:bridgesTo ngm:supply-chain-security,
        ngm:trusted-execution-environment ;
    vc:contrastsWith ngm:custodial-wallet,
        ngm:hot-wallet,
        ngm:ledger ;
    vc:dependsOn ngm:elliptic-curve-cryptography,
        ngm:key-derivation ;
    vc:enables ngm:multi-currency-support,
        ngm:passphrase-encryption,
        ngm:self-custody,
        ngm:transaction-signing ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:pin-protection,
        ngm:secure-element,
        ngm:seed-phrase ;
    vc:implements ngm:bip32,
        ngm:bip44,
        ngm:open-source-firmware ;
    vc:isPartOf ngm:hardware-wallet,
        ngm:self-custody ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:cryptographic-signing,
        ngm:key-management,
        ngm:wallet-connect ;
