    vc:relatedTo ngm:ethics-framework,
        ngm:professional-standards,
        ngm:regulatory-framework ;
    vc:requires ngm:accountability,
        ngm:compliance,
        ngm:stakeholder-trust,
        ngm:transparency ;
    vc:slug "self-regulation" ;
    vc:sourceDomain "governance" ;
    vc:supports ngm:regulatory-compliance,
        ngm:risk-management .

ngm:sensor-calibration a owl:Class ;
    rdfs:label "Sensor Calibration"@en ;
    rdfs:comment "Sensor calibration is the process of determining and correcting systematic measurement errors in sensing devices by comparing their outputs against known reference values or through geometric constraint solving, yielding intrinsic parameter models and extrinsic transformation matrices that map raw sensor readings to physically meaningful quantities. It is a prerequisite for sensor fusion, perception pipelines, and any application requiring quantitatively accurate environmental measurements."@en ;
    rdfs:subClassOf ngm:calibration ;
    vc:enables ngm:localization,
        ngm:sensor-fusion,
        ngm:slam ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:camera-calibration,
        ngm:imu,
        ngm:lidar ;
    vc:slug "sensor-calibration" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:calibration-target,
        ngm:camera-intrinsics,
        ngm:coordinate-transformation .

ngm:sensor-input a owl:Class ;
    rdfs:label "Sensor Input"@en ;
    rdfs:comment "Sensor input refers to the raw or pre-processed signals acquired from physical or virtual transducers that convert observable environmental quantities—position, force, temperature, light intensity, pressure, chemical concentration—into electrical or digital representations suitable for computation. It constitutes the primary interface between an autonomous or intelligent system and its environment, providing the perceptual foundation for state estimation, feedback control, and situational awareness. Effective use of sensor input requires calibration, filtering, and often fusion with complementary modalities to produce reliable world-state estimates, and the quality and latency of sensor inputs directly constrain the operational envelope of any system that must perceive and respond to the physical world. Sensor inputs vary by modality, sampling rate, resolution, noise characteristics, and temporal precision, spanning domains from robotics and autonomous vehicles to spatial computing, industrial IoT, and embodied AI."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:signal-conditioning ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:real-time-computation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:digital-signal-processing ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:sensor-calibration ],
        ngm:sensor ;
    vc:bridgesTo ngm:embodied-ai,
        ngm:internet-of-things,
        ngm:spatial-computing ;
    vc:contrastsWith ngm:actuator-output,
        ngm:synthetic-data ;
    vc:dependsOn ngm:embedded-system,
        ngm:transducer ;
    vc:enables ngm:autonomous-navigation,
        ngm:sensor-fusion,
        ngm:state-estimation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:analogue-to-digital-conversion,
        ngm:sensor-calibration,
        ngm:signal-conditioning ;
    vc:isPartOf ngm:perception-system,
        ngm:sensor-system ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:data-acquisition,
        ngm:noise-model,
        ngm:sensor-data ;
    vc:requires ngm:digital-signal-processing,
        ngm:real-time-computation ;
    vc:slug "sensor-input" ;
    vc:sourceDomain "robotics" ;
    vc:supports ngm:autonomous-system,
        ngm:control-system,
        ngm:machine-vision ;
    vc:uses ngm:interrupt-driven-io,
        ngm:kalman-filter .

ngm:service-oriented-architecture a owl:Class ;
    rdfs:label "Service Oriented Architecture"@en ;
    rdfs:comment "An architectural style organizing software as loosely coupled, interoperable services that communicate through standardized interfaces, enabling modular composition of metaverse functionality through reusable components and well-defined contracts."@en ;
    rdfs:subClassOf ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:bridgesTo ngm:software-architecture ;
    vc:enables ngm:system-interoperability ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:slug "service-oriented-architecture" ;
    vc:sourceDomain "spatial-computing" .

ngm:signal-conditioning a owl:Class ;
    rdfs:label "Signal Conditioning"@en ;
    rdfs:comment "Signal conditioning is the ensemble of analogue and digital processing stages applied to raw electrical outputs from physical sensors — including amplification, filtering, analogue-to-digital conversion, isolation, linearisation, and calibration — to produce clean, scaled, noise-reduced representations in engineering units suitable for downstream control, estimation, and machine-learning pipelines. It occupies the critical interface between the physical world and digital computation, and its fidelity directly determines the accuracy of perception, control, and data-acquisition systems built upon it. Standard stages encompass instrumentation amplifiers, anti-aliasing filters, temperature compensation, galvanic isolation, sample-rate conversion, and offset or gain correction applied in hardware, firmware, or software. In robotics, industrial automation, medical devices, and IoT edge nodes, signal conditioning is a prerequisite for reliable sensor fusion, closed-loop control, and anomaly detection."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:sensor ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:calibration ],
        ngm:signal-processing ;
    vc:bridgesTo ngm:digital-twin,
        ngm:edge-inference ;
    vc:contrastsWith ngm:raw-sensor-data ;
    vc:enables ngm:anomaly-detection,
        ngm:closed-loop-control,
        ngm:kalman-filter,
        ngm:sensor-fusion ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:analogue-to-digital-conversion,
        ngm:anti-aliasing-filter,
        ngm:calibration,
        ngm:galvanic-isolation,
        ngm:instrumentation-amplifier ;
    vc:isPartOf ngm:data-acquisition,
        ngm:robo-perception ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:accelerometer,
        ngm:embedded-systems,
        ngm:force-torque-sensor,
        ngm:noise-reduction ;
    vc:requires ngm:analogue-circuit,
        ngm:sensor ;
    vc:slug "signal-conditioning" ;
    vc:sourceDomain "robotics" ;
    vc:supports ngm:predictive-maintenance,
        ngm:robot-operating-system,
        ngm:slam ;
    vc:uses ngm:digital-signal-processing,
        ngm:fir-filter,
        ngm:iir-filter,
        ngm:imu .

ngm:smart-manufacturing a owl:Class ;
    rdfs:label "Smart Manufacturing"@en ;
    rdfs:comment "Smart manufacturing is an integrated approach to industrial production that embeds advanced sensing, connectivity, data analytics, and artificial intelligence throughout the production system to achieve real-time visibility, adaptive control, and continuous optimisation of manufacturing processes. It combines cyber-physical systems, the Industrial Internet of Things, digital twins, machine learning, and cloud and edge computing to create intelligent factories capable of self-monitoring, predictive maintenance, and autonomous quality control. Smart manufacturing extends beyond factory automation to encompass supply chain integration, mass customisation, and sustainability optimisation, representing the operational realisation of the Industry 4.0 paradigm."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:digital-twin ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cyber-physical-systems ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:industrial-io-t ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:edge-computing ],
        ngm:manufacturing-automation ;
    vc:bridgesTo ngm:digital-thread,
        ngm:industrial-metaverse ;
    vc:contrastsWith ngm:traditional-manufacturing ;
    vc:dependsOn ngm:cloud-computing,
        ngm:real-time-data-processing ;
    vc:enables ngm:industrial-automation,
        ngm:mass-customisation,
        ngm:predictive-maintenance,
        ngm:supply-chain-management ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:digital-twin,
        ngm:edge-computing,
        ngm:industrial-control-system,
        ngm:industrial-io-t ;
    vc:implements ngm:industrial-internet-of-things ;
    vc:isPartOf ngm:industry-4-0 ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:augmented-reality,
        ngm:robotics ;
    vc:requires ngm:5g-networks,
        ngm:cyber-physical-systems,
        ngm:industrial-data-platform ;
    vc:slug "smart-manufacturing" ;
    vc:sourceDomain "infrastructure" ;
    vc:standardizedBy ngm:iso-iec-30141,
        ngm:nist-smart-manufacturing-framework ;
    vc:supports ngm:precision-manufacturing,
        ngm:sustainable-manufacturing ;
    vc:uses ngm:computer-vision,
        ngm:machine-learning,
        ngm:opc-ua .

ngm:stochastic-process a owl:Class ;
    rdfs:label "Stochastic Process"@en ;
    rdfs:comment "A stochastic process is a mathematically rigorous framework for describing the probabilistic evolution of a system over time (or another index set), defined formally as a collection of random variables {X_t : t ∈ T} all defined on a common probability space (Ω, ℱ, ℙ) and indexed by a parameter se..."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:sigma-algebra ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:filtration ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:wiener-process ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:measure-theory ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:it-calculus ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:filtration ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:markov-chain ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:stochastic-differential-equation ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:gaussian-process ],
        ngm:ai-technique,
        ngm:dynamical-systems ;
    skos:broader ngm:ai-technique ;
    vc:bridgesTo ngm:infra-data-management ;
    vc:enables ngm:bayesian-optimisation,
        ngm:diffusion-models,
