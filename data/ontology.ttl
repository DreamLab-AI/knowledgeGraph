    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:rasterization ;
    vc:supports ngm:vertex-shader ;
    vc:uses ngm:gpu ;
    vc:uses ngm:rasterization .
ngm:vertex-buffer-object a skos:Concept ;
    rdfs:label "Vertex Buffer Object"@en .
ngm:vertex-processing a owl:Class ;
    rdfs:comment "Vertex processing is the stage of the graphics pipeline that operates on each vertex of geometry, transforming its position from model space through world, view, and clip space, and computing or passing per-vertex attributes such as normals, texture coordinates, and colours. Executed largely by programmable vertex shaders on the GPU, it prepares primitives for clipping, perspective division, and rasterisation, and may feed subsequent geometry, tessellation, and fragment stages. As a foundational step in real-time rendering it determines screen-space placement and the interpolated inputs available to downstream shading."@en ;
    rdfs:label "Vertex Processing"@en ;
    rdfs:subClassOf ngm:graphics-pipeline ;
    rdfs:subClassOf _:r21872 ;
    rdfs:subClassOf _:r21873 ;
