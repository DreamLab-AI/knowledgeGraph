ngm:keccak-256-hashing a owl:Class ;
    rdfs:label "Keccak-256 Hashing"@en ;
    rdfs:comment "Keccak-256 is a cryptographic hash function from the Keccak family, producing a fixed 256-bit digest using a sponge construction. It is the specific variant adopted by Ethereum, distinct from the later NIST-standardised SHA3-256 due to a difference in padding. Keccak-256 provides collision and preimage resistance for addresses, transaction hashes and message commitments in blockchain systems."@en ;
    rdfs:subClassOf ngm:cryptographic-primitive ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
