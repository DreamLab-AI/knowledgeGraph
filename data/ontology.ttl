        ngm:real-time-operating-system,
        ngm:sensor-network ;
    vc:implements ngm:feedback-control,
        ngm:pid-controller ;
    vc:qualityScore "0.73"^^xsd:float ;
    vc:relatedTo ngm:cyber-security,
        ngm:scada ;
    vc:requires ngm:formal-verification,
        ngm:functional-safety,
        ngm:real-time-computing,
        ngm:wireless-communication ;
    vc:slug "cyber-physical-systems" ;
