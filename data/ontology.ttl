ngm:federated-identity a owl:Class ;
    rdfs:label "Federated Identity"@en ;
    rdfs:comment "Federated Identity is an architectural paradigm in which a user authenticates once with a trusted Identity Provider and receives a signed assertion that is accepted by multiple independent relying-party services across organisational or administrative boundaries, eliminating per-service credential stores. The federation relationship is governed by bilateral or multilateral trust agreements and implemented through standard protocols such as SAML 2.0, OpenID Connect, and OAuth 2.0, which define how authentication tokens are issued, transported, and cryptographically verified. Federated identity is foundational to enterprise single sign-on, cross-institutional academic collaboration, and consumer social-login ecosystems, and is actively converging with decentralised-identity models that replace central providers with holder-controlled cryptographic credentials."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:authentication-standards ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:identity-provider ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:trust-framework ],
        ngm:identity-management ;
    vc:bridgesTo ngm:decentralized-identity,
        ngm:self-sovereign-identity,
        ngm:verifiable-credentials ;
    vc:contrastsWith ngm:centralised-identity,
        ngm:siloed-identity ;
    vc:enables ngm:cross-domain-authentication,
        ngm:delegated-authorisation,
        ngm:single-sign-on,
        ngm:zero-trust-architecture ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:identity-provider,
        ngm:security-assertion,
        ngm:service-provider,
        ngm:trust-framework ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:directory-services,
        ngm:privilege-access-management,
        ngm:scim ;
    vc:requires ngm:authentication-standards,
        ngm:digital-certificates,
        ngm:public-key-infrastructure ;
    vc:slug "federated-identity" ;
    vc:sourceDomain "security" ;
    vc:standardizedBy ngm:ietf,
        ngm:oasis-standards,
        ngm:openid-foundation ;
    vc:supports ngm:access-control,
        ngm:multi-factor-authentication,
        ngm:session-management,
        ngm:user-provisioning ;
    vc:uses ngm:cryptographic-signature,
        ngm:json-web-token,
        ngm:oauth-2-0,
        ngm:open-id-connect,
        ngm:saml .

ngm:gpu a owl:Class ;
    rdfs:label "GPU"@en ;
    rdfs:comment "A GPU (Graphics Processing Unit) is a highly parallel processor optimised for the throughput-oriented computation required to render images and to accelerate data-parallel workloads, and increasingly used as the primary compute substrate for deep learning, scientific simulation, and XR rendering."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:shader ],
        ngm:graphics-processing ;
    vc:bridgesTo ngm:blockchain-mining,
