    vc:supports ngm:regulatory-compliance .

ngm:quadratic-funding a owl:Class ;
    rdfs:label "Quadratic Funding"@en ;
    rdfs:comment "Quadratic Funding (QF) is a mechanism-design method for subsidising public goods in which a matching pool is distributed proportionally to the square of the sum of square roots of individual contributions to each project, ensuring that projects with many small donors receive proportionally greater matching than projects with few large donors. Formalised by Vitalik Buterin, Zoe Hitzig, and E. Glen Weyl in the 2018 paper 'Liberal Radicalism', QF is derived from welfare-economics theory as an approximation to the socially optimal provision of public goods under privately observed preferences. It has been deployed on-chain via Gitcoin Grants, where smart contracts automate matching calculations against a community-funded subsidy pool, though it requires robust Sybil resistance mechanisms such as decentralised identity verification to prevent gaming."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:sybil-resistance ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:mechanism-design ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:public-goods-funding ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:smart-contract ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:decentralised-identity ],
        ngm:mechanism-design ;
    vc:bridgesTo ngm:cooperative-game-theory,
        ngm:social-choice-theory,
        ngm:zero-knowledge-proof ;
    vc:contrastsWith ngm:one-person-one-vote,
        ngm:plutocratic-voting,
        ngm:quadratic-voting ;
    vc:enables ngm:dao,
        ngm:dao-governance,
        ngm:decentralised-autonomous-organisation,
        ngm:open-source-sustainability ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:bc-defi-and-economics ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:collective-action,
        ngm:gitcoin-grants,
        ngm:governance-token,
        ngm:liberal-radicalism,
        ngm:public-goods,
        ngm:quadratic-voting ;
    vc:requires ngm:decentralised-identity,
        ngm:mechanism-design,
        ngm:public-goods-funding,
        ngm:smart-contract,
        ngm:sybil-resistance ;
    vc:slug "quadratic-funding" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:matching-funds,
        ngm:on-chain-governance,
        ngm:welfare-economics .

ngm:real-time-monitoring a owl:Class ;
    rdfs:label "Real-Time Monitoring"@en ;
    rdfs:comment "Real-time monitoring is the continuous collection, processing, and presentation of operational telemetry — encompassing metrics, logs, and traces — with sufficiently low latency that resulting insights can drive immediate human decisions or automated responses without batch delay. It integrates instrumentation agents, stream-processing pipelines, and visualisation dashboards to maintain a live, actionable picture of system health across software, hardware, network, and physical domains. The discipline spans IT operations, industrial control, MLOps observability, and smart infrastructure, where the defining criterion is actionability: data must arrive within a window that permits meaningful intervention before a fault, breach, or degradation cascades. Real-time monitoring is architecturally distinct from batch analytics in its emphasis on bounded latency, stateful windowing, and continuous alerting over persistent connections."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-pipeline ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:network-infrastructure ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:time-series-database ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:alerting ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:telemetry ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:monitoring-dashboard ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:observability ],
        ngm:real-time-processing ;
    vc:bridgesTo ngm:cyber-physical-systems,
        ngm:digital-twin,
        ngm:model-drift-detection ;
    vc:contrastsWith ngm:batch-processing,
        ngm:data-analytics ;
    vc:dependsOn ngm:edge-computing,
        ngm:message-broker ;
    vc:enables ngm:ai-monitoring,
        ngm:compliance-monitoring,
        ngm:incident-response,
        ngm:operational-resilience,
        ngm:predictive-maintenance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:alerting,
        ngm:monitoring-dashboard,
        ngm:telemetry,
        ngm:time-series-database ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:distributed-tracing,
        ngm:log-management,
        ngm:performance-metrics,
        ngm:service-level-objective ;
    vc:requires ngm:data-pipeline,
        ngm:network-infrastructure,
        ngm:observability ;
    vc:slug "real-time-monitoring" ;
