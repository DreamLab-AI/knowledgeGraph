    vc:slug "bank-secrecy-act" ;
    vc:sourceDomain "governance" ;
    vc:standardizedBy ngm:fatf .

ngm:banking-system a owl:Class ;
    rdfs:label "Banking System"@en ;
    rdfs:comment "An organised network of financial institutions, regulatory bodies, payment infrastructure, and legal frameworks that collectively facilitate the creation, custody, transfer, and lending of money within an economy. A banking system includes central banks, commercial banks, investment banks, and clearing houses, all operating under a body of prudential regulation. It underpins economic activity by providing mechanisms for capital allocation, risk distribution, and monetary policy transmission. Modern banking systems increasingly integrate digital and real-time payment rails."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:clearing-house ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:financial-regulation ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
