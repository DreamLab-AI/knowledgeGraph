        ngm:world-inequality-database .

ngm:governance-layer a owl:Class ;
    rdfs:label "Governance Layer"@en ;
    rdfs:comment "The Governance Layer is the cross-cutting stratum where human and institutional intent over a system is decided, recorded, and amended. It sits above the Policy Layer, which it parameterises, and draws on identity and economic structures to allocate decision rights. It contains decision processes, voting mechanisms, charters, and the records of who may change what."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:identity-layer ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:policy-layer ],
        ngm:owl-thing ;
    vc:enables ngm:compliance-layer,
        ngm:institutional-layer ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:identity-layer,
        ngm:policy-layer ;
    vc:slug "governance-layer" ;
    vc:sourceDomain "governance" .

ngm:governance-model a owl:Class ;
    rdfs:label "Governance Model"@en ;
    rdfs:comment "Framework of rules and decision-making processes defining authority and accountability within a metaverse ecosystem."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:ethical-framework ],
        [ a owl:Restriction ;
