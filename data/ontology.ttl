ngm:co-training a owl:Class ;
    rdfs:label "Co Training"@en ;
    rdfs:comment "Co-training is a semi-supervised machine learning technique where two or more models trained on complementary feature views iteratively label unlabelled data for each other. Each model labels examples confidently classified under its own view, and these pseudo-labels are added to the other model's training set, bootstrapping performance without requiring large labelled corpora."@en ;
    rdfs:subClassOf ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:enables ngm:generative-ai ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:semi-supervised-learning ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:relatedTo ngm:active-learning,
        ngm:self-training ;
    vc:slug "co-training" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:machine-learning-discipline,
        ngm:machine-learning-discipline-model .

ngm:cognitive-automation-revolution a owl:Class ;
    rdfs:label "Cognitive Automation Revolution"@en ;
    rdfs:comment "The Cognitive Revolution describes the transformative societal shift driven by AI systems automating cognitive and knowledge work at scale, drawing analogy to the Industrial Revolution's mechanisation of physical labour. It encompasses the displacement of routine mental tasks—coding, content creation, data analysis—freeing human effort for higher-order creativity and judgement, whilst raising urgent questions about workforce adaptation and economic equity."@en ;
    rdfs:subClassOf ngm:ai-research-area ;
    skos:broader ngm:ai-research-area ;
    vc:contrastsWith ngm:ai-impact-assessment ;
    vc:enables ngm:workflow-automation,
        ngm:workforce-augmentation ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:ai-adoption,
        ngm:ai-ethics,
        ngm:generative-ai ;
    vc:slug "cognitive-automation-revolution" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:cohere a owl:Class ;
    rdfs:label "Cohere"@en ;
    rdfs:comment "Cohere is a Canadian-American enterprise AI company founded in 2019 by Aidan Gomez, Nick Frosst, and Ivan Zhang — all former Google Brain researchers — that develops and deploys large language models, text embedding models, and reranking models through a cloud API, private cloud, and on-premises deployment model, with a strategic focus on enterprise data security, sovereign AI, and retrieval-augmented generation pipelines. Its model families include the Command series for generative tasks, the Embed series for dense vector representations, the Rerank series for cross-encoder document scoring, and the Aya multilingual research models covering 101 languages. Cohere is distinguished by its early and consistent commitment to private and on-premises deployment options that ensure enterprise data never transits external infrastructure, and by its April 2026 merger with Germany's Aleph Alpha to form a transatlantic sovereign AI entity valued at approximately $20 billion."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:self-supervised-learning ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:embeddings ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:transformer ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:rlhf ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:instruction-tuning ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gpu-compute ],
        ngm:enterprise-ai,
        ngm:large-language-models ;
    vc:contrastsWith ngm:anthropic,
        ngm:google-ai,
        ngm:openai-research ;
    vc:enables ngm:agentic-ai,
        ngm:document-understanding,
        ngm:multilingual-nlp,
        ngm:question-answering,
        ngm:retrieval-augmented-generation,
        ngm:semantic-search,
        ngm:summarisation,
        ngm:text-classification ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:aya-expanse,
        ngm:command-r,
        ngm:embed-v4,
        ngm:model-vault,
        ngm:north-platform,
        ngm:rerank-4 ;
    vc:qualityScore "0.91"^^xsd:float ;
    vc:relatedTo ngm:aleph-alpha,
        ngm:data-privacy,
        ngm:regulatory-compliance,
        ngm:sovereign-ai ;
    vc:requires ngm:embeddings,
        ngm:gpu-compute,
        ngm:instruction-tuning,
        ngm:rlhf,
        ngm:self-supervised-learning,
        ngm:transformer ;
    vc:slug "cohere" ;
    vc:sourceDomain "ai" .

ngm:collaborative-systems-modality-robots a owl:Class ;
    rdfs:label "Collaborative Robots"@en ;
    rdfs:comment "Collaborative robots, or cobots, are robots designed to work safely alongside humans within a shared workspace."@en ;
