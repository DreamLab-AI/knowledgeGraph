ngm:gasper-consensus a owl:Class ;
    rdfs:label "Gasper Consensus"@en ;
    rdfs:comment "Gasper Consensus is Ethereum's Proof-of-Stake consensus protocol, combining Casper FFG (Friendly Finality Gadget) as a finality mechanism with LMD GHOST (Latest Message Driven Greedy Heaviest Observed Subtree) as the fork choice rule. Validators stake ETH directly and attest to blocks in each epoch; Casper FFG provides economic finality by requiring two-thirds supermajority agreement, while LMD GHOST guides validators towards the heaviest chain, resolving short-lived forks without full finalisation delay."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:validator-set ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:fork-choice-rule ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:proof-of-stake ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:finality ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:validator-node ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:consensus-mechanism ],
        ngm:bc-protocol-and-consensus,
        ngm:hybrid-consensus ;
    skos:broader ngm:bc-protocol-and-consensus ;
    vc:enables ngm:blockchain-scalability,
        ngm:finality ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:finality,
        ngm:fork-choice-rule,
        ngm:validator-set ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:blockchain,
        ngm:blockchain-protocol,
        ngm:distributed-ledger ;
    vc:requires ngm:consensus-mechanism,
        ngm:proof-of-stake,
        ngm:validator-node ;
    vc:slug "gasper-consensus" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:consensus-algorithm,
        ngm:consensus-protocol .

ngm:gazebo-simulator a owl:Class ;
    rdfs:label "Gazebo Simulator"@en ;
    rdfs:comment "Gazebo Simulator (now branded Gz Sim following the Open Robotics / Intrinsic rebranding) is an open-source, physics-accurate 3D robotics simulator providing rigid-body dynamics (via ODE, Bullet, DART, or Simbody), sensor simulation (cameras, LiDAR, IMU, GPS), and a plugin architecture for custom ..."@en ;
