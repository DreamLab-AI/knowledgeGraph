    vc:relatedTo ngm:proof-of-stake ;
    vc:relatedTo ngm:proto-danksharding ;
    vc:requires ngm:blob-transaction ;
    vc:requires ngm:kzg-commitment ;
    vc:slug "danksharding" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:validator ;
    vc:uses ngm:polynomial-commitment .
