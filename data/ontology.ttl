ngm:real-esrgan a owl:Class ;
    rdfs:label "Real-ESRGAN"@en ;
    rdfs:comment "Real-ESRGAN is an image super-resolution model that upscales and restores low-quality images, with particular attention to real-world degradations. It extends the ESRGAN architecture using a generative adversarial network trained on synthetic degradation data."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:convolutional-neural-network ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:generative-adversarial-network ],
        ngm:generative-adversarial-network ;
    vc:enables ngm:image-generation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:convolutional-neural-network,
        ngm:generative-adversarial-network ;
    vc:slug "real-esrgan" ;
    vc:sourceDomain "computer-vision" .

