ngm:schema-definition a owl:Class ;
    rdfs:label "Schema Definition"@en ;
    rdfs:comment "A Schema Definition is a formal, machine-readable specification of the structure, data types, constraints, and relationships that govern a dataset, message format, document, or knowledge representation, serving as a contract between data producers and consumers. Schema languages include W3C XML Schema Definition (XSD), JSON Schema (for JSON documents), OWL/RDFS (for ontologies over RDF graphs), SHACL and ShEx (for RDF graph shape constraints), Protocol Buffers and Apache Avro (for binary-serialised messages), OpenAPI (for REST API request/response bodies), and GraphQL SDL (for graph API types). A schema definition enables automated validation, code generation, documentation, and inter-system interoperability; in knowledge-graph contexts, the schema defines classes, properties, cardinality constraints, and axioms that allow OWL-based reasoning over the graph."@en ;
    rdfs:subClassOf ngm:data-format-standard ;
    vc:enables ngm:knowledge-graph,
        ngm:linked-data,
        ngm:semantic-web ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:json-schema,
        ngm:knowledge-representation,
        ngm:ontology ;
    vc:slug "schema-definition" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:data-schema,
        ngm:owl-class-hierarchy ;
    vc:uses ngm:json-ld,
        ngm:rdf,
        ngm:sparql .

ngm:sidechain a owl:Class ;
    rdfs:label "Sidechain"@en ;
    rdfs:comment "Independent blockchain connected to a parent blockchain via a two-way peg mechanism that operates with its own consensus and validation rules while enabling asset transfers between chains, providing scalability and experimental capabilities without impacting the main chain."@en ;
    rdfs:subClassOf ngm:bc-network-component ;
    skos:broader ngm:bc-network-component ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:implements ngm:two-way-peg ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:slug "sidechain" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:cross-chain-bridge .

ngm:storage-layer a owl:Class ;
    rdfs:label "Storage Layer"@en ;
    rdfs:comment "Hardware and software infrastructure responsible for persistent retention, retrieval, and management of data and digital assets across distributed systems."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:database-system ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:file-system ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:network-connectivity ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:storage-hardware ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:object-storage ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:block-storage ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:cache-layer ],
        ngm:infra-data-management,
        ngm:infrastructure-layer ;
    skos:broader ngm:infra-data-management ;
    vc:enables ngm:asset-management,
        ngm:content-delivery,
        ngm:data-persistence ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:block-storage,
        ngm:cache-layer,
        ngm:database-system,
        ngm:object-storage ;
    vc:isPartOf ngm:infrastructure-layer ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:file-system,
        ngm:network-connectivity,
        ngm:storage-hardware ;
    vc:slug "storage-layer" ;
    vc:sourceDomain "infrastructure" .

ngm:surgical-robot a owl:Class ;
    rdfs:label "Surgical Robot"@en ;
    rdfs:comment "A Surgical Robot is a teleoperated or semi-autonomous robotic system designed to assist surgeons in performing minimally invasive procedures with enhanced precision, dexterity, and haptic feedback. Systems such as the da Vinci platform translate the surgeon's hand movements—filtered for tremor—into sub-millimetre instrument motions within the patient's body, enabling laparoscopic, urological, and cardiac procedures through small incisions."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:robot-kinematics ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:sensor-fusion ],
        ngm:robo-robot-type,
        ngm:service-robot ;
    skos:broader ngm:robo-robot-type ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:robotics ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires ngm:robot-kinematics,
        ngm:sensor-fusion ;
    vc:slug "surgical-robot" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:haptic-feedback,
        ngm:motion-planning .

ngm:symbolic-ai a owl:Class ;
    rdfs:label "Symbolic AI"@en ;
    rdfs:comment "Symbolic AI (Good Old-Fashioned AI, GOFAI) is an approach to artificial intelligence based on explicit symbolic representations of knowledge, logical inference rules, and search algorithms. It underpins expert systems, automated planning, knowledge graphs, and formal reasoning systems, and is currently experiencing a renaissance as a complement to neural approaches in neurosymbolic AI."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:knowledge-graph ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:automated-planning ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:symbolic-reasoning ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:reasoning ],
        ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:contrastsWith ngm:deep-learning,
        ngm:machine-learning,
        ngm:neural-network ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:automated-planning,
        ngm:knowledge-graph,
        ngm:reasoning,
        ngm:symbolic-reasoning ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:ai-technique,
        ngm:bayesian-inference,
        ngm:explainable-ai ;
    vc:slug "symbolic-ai" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:system-prompt a owl:Class ;
    rdfs:label "System Prompt"@en ;
    rdfs:comment "A system prompt is a structured instruction block injected into the context window of a large language model at the start of an inference session to establish operational context, persona, tool descriptions, safety constraints, and behavioural guidelines before any user turn is processed. Unlike user messages, system prompts are typically authored by operators rather than end users and govern the model's allowed behaviours, response style, and tool-use policy throughout the session. In multi-agent and agentic AI systems, system prompts serve as the primary mechanism for role specialisation, safety guardrail enforcement, and task decomposition."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:large-language-models ],
        ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:enables ngm:prompt-engineering,
        ngm:reasoning ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:chain-of-thought,
        ngm:prompt-injection,
        ngm:self-consistency ;
    vc:requires ngm:large-language-models ;
    vc:slug "system-prompt" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:threat-model a owl:Class ;
    rdfs:label "Threat Model"@en ;
    rdfs:comment "A threat model is a structured representation of the security properties, assumptions, and adversarial conditions relevant to a system, used to identify potential attack vectors, prioritise mitigations, and reason systematically about security guarantees. It defines who the adversary is (capabilities, motivations, access), what assets are worth protecting, and what attacks — such as those catalogued in STRIDE or MITRE ATT&CK — could compromise confidentiality, integrity, or availability. Threat modelling is applied during system design to surface architectural weaknesses before implementation, and updated continuously as the threat landscape evolves. It is a prerequisite for sound security architecture, cryptographic protocol design, and regulatory compliance."@en ;
    rdfs:subClassOf ngm:security-framework ;
    vc:enables ngm:cybersecurity,
        ngm:risk-mitigation,
        ngm:security-architecture ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:adversarial-robustness,
        ngm:nist-cybersecurity-framework,
        ngm:threat-surface-map ;
    vc:slug "threat-model" ;
    vc:sourceDomain "security" ;
    vc:uses ngm:attack-vector,
        ngm:risk-assessment,
        ngm:vulnerability .

ngm:time-series-forecasting a owl:Class ;
    rdfs:label "Time Series Forecasting"@en ;
    rdfs:comment "Time orecasting (TSF) is the domain of statistical and machine learning mods that predict future values of ordered sequential observations indexed by time, encompassing classical statistical approaches (ARIMA — AutoRegressive Integrated Moving Average — modelling the s a linear combination of its..."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
