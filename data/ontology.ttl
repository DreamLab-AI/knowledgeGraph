ngm:digital-avatar a owl:Class ;
    rdfs:label "Digital Avatar"@en ;
    rdfs:comment "A Digital Avatar is a persistent digital representation of a user or entity within virtual environments, exhibiting embodied presence, visual customisation, and behavioural agency. Digital avatars serve as identity anchors across metaverse platforms and enable social presence, interactive expression, and blockchain-verified ownership of associated assets."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:digital-identity ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:virtual-identity ],
        ngm:sc-content-and-assets,
        ngm:virtual-representation ;
    skos:broader ngm:sc-content-and-assets ;
    vc:enables ngm:avatar-interoperability,
        ngm:social-presence ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.4"^^xsd:float ;
    vc:requires ngm:digital-identity,
        ngm:virtual-identity ;
    vc:slug "digital-avatar" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:avatar-customization,
        ngm:generative-ai,
        ngm:motion-capture .

ngm:digital-humans a owl:Class ;
    rdfs:label "Digital Humans"@en ;
    rdfs:comment "Digital humans are photorealistic, AI-driven virtual beings that replicate human appearance, movement, voice, and conversational behaviour, rendered in 3D and designed for real-time interaction within immersive and spatial computing environments. They integrate natural language processing, motion capture, generative AI, and real-time rendering to simulate lifelike presence, serving roles in customer service, education, healthcare, and entertainment. As an emerging category they represent the convergence of embodied AI with avatar systems and synthetic media."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:avatar-system ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:3-d-animation ],
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:3-d-animation,
        ngm:avatar-system ;
    vc:isPartOf ngm:immersive-technology,
        ngm:spatial-computing ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:digital-avatar,
        ngm:embodied-ai,
        ngm:synthetic-media ;
    vc:slug "digital-humans" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:conversational-ai,
