        ngm:fpga-acceleration,
        ngm:nvidia-corporation-jetson,
        ngm:stm32-microcontroller .

ngm:robot-link a owl:Class ;
    rdfs:label "RobotLink"@en ;
    rdfs:comment "A rigid mechanical structural component in a robotic manipulator or kinematic chain that connects two consecutive joints and transmits motion and forces between them, characterized by fixed geometric and inertial properties including length, mass, center of mass location, and inertia tensor, desc..."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:mounting-interface ],
        ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:enables ngm:force-transmission,
        ngm:kinematic-chain,
        ngm:motion-propagation,
        ngm:payload-support,
        ngm:workspace-reach ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:inertial-frame,
        ngm:link-geometry,
        ngm:mass-properties,
        ngm:material-composition,
        ngm:mounting-interface,
        ngm:surface-finish ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires ngm:dynamic-balancing,
        ngm:material-selection,
        ngm:structural-analysis,
        ngm:thermal-management,
        ngm:vibration-damping ;
    vc:slug "robot-link" ;
    vc:sourceDomain "robotics" .

ngm:robot-motion-planning a skos:Concept ;
    rdfs:label "Robot Motion Planning"@en .

ngm:robust-control a owl:Class ;
    rdfs:label "Robust Control"@en ;
    rdfs:comment "Robust Control is a branch of control theory that designs controllers guaranteeing stable and acceptable performance across a bounded set of model uncertainties and disturbances. It formalises worst-case design requirements through H-infinity and H2 optimisation frameworks, ensuring actuated systems remain within specification even when plant parameters deviate from nominal values."@en ;
    rdfs:subClassOf ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:bridgesTo ngm:control-algorithm ;
    vc:contrastsWith ngm:adaptive-control ;
    vc:enables ngm:motion-control,
        ngm:robot-control ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:slug "robust-control" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:robot-safety,
        ngm:trajectory-control ;
    vc:uses ngm:feedback-control,
        ngm:pid-control .

ngm:ros-navigation-stack a owl:Class ;
    rdfs:label "ROS Navigation Stack"@en ;
    rdfs:comment "The ROS Navigation Stack is a collection of software packages within the Robot Operating System (ROS) framework that provides a robot with the capability to move autonomously through an environment by combining map building, localisation, global path planning, local obstacle avoidance, and motor control into an integrated pipeline. It abstracts sensor inputs (laser scan, odometry, IMU), maintains a 2D occupancy grid map and cost layers, runs AMCL (Adaptive Monte Carlo Localisation) for pose estimation, and uses A* or Dijkstra for global plans combined with DWA (Dynamic Window Approach) or TEB (Timed Elastic Band) for local reactive navigation. The Navigation Stack is the de facto standard for mobile ground-robot navigation in research and production robotics."@en ;
    rdfs:subClassOf ngm:robot-operating-system ;
    vc:enables ngm:autonomous-robot,
        ngm:obstacle-avoidance,
        ngm:path-planning ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:autonomous-navigation,
        ngm:gazebo-simulator,
        ngm:ros-2 ;
    vc:slug "ros-navigation-stack" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:lidar,
        ngm:localisation,
        ngm:sensor-fusion .

ngm:rrt-algorithm a owl:Class ;
    rdfs:label "RRT Algorithm"@en ;
    rdfs:comment "A sampling-based path planning algorithm that incrementally builds a tree of collision-free configurations by randomly sampling the configuration space and connecting samples to the nearest existing tree node. It efficiently explores high-dimensional spaces and is probabilistically complete."@en ;
    rdfs:subClassOf ngm:path-planning,
        ngm:robo-navigation-and-planning ;
    skos:broader ngm:robo-navigation-and-planning ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires ngm:collision-checker,
        ngm:configuration-space ;
    vc:slug "rrt-algorithm" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:collision-detection,
        ngm:nearest-neighbor-search .

ngm:rule-of-law a owl:Class ;
    rdfs:label "Rule of Law"@en ;
    rdfs:comment "The constitutional and institutional principle that all persons, institutions, and entities—including AI systems and their operators—are accountable to laws that are publicly promulgated, equally enforced, independently adjudicated, and consistent with international human rights norms. Applied to AI governance, the rule of law requires legal certainty, non-arbitrary decision-making, procedural fairness, and effective remedies for AI-related harms."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:accountability ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:legal-framework ],
        ngm:infra-legal-and-regulatory,
        ngm:legal-framework ;
    skos:broader ngm:infra-legal-and-regulatory ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:ai-governance,
        ngm:compliance-framework ;
    vc:requires ngm:accountability,
        ngm:legal-framework ;
    vc:slug "rule-of-law" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:ai-ethics,
        ngm:democratic-values,
        ngm:human-rights .

ngm:safety-function a owl:Class ;
    rdfs:label "Safety Function"@en ;
    rdfs:comment "A safety function is a function implemented by a control system or safeguard whose failure results in an immediate increase of risk to people, equipment, or the environment. In robotics and machine safety, examples include emergency stop, speed and separation monitoring, and safe torque off. Safety functions are specified, designed, and validated to meet a required performance level so that residual risk remains tolerable."@en ;
    rdfs:subClassOf ngm:robo-safety-and-standards ;
    skos:broader ngm:robo-safety-and-standards ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:robot-standard,
        ngm:safety-integrity-level ;
    vc:slug "safety-function" ;
    vc:sourceDomain "robotics" .

ngm:safety-system a owl:Class ;
    rdfs:label "Safety System"@en ;
    rdfs:comment "A safety system is an engineered arrangement of hardware, software, and procedural controls designed to prevent, detect, and mitigate hazards in industrial, transport, robotic, or cyber-physical environments, ensuring that a process or machine reaches a safe state when faults or dangerous conditions are detected. Safety systems are defined by their Safety Integrity Level (SIL) or Performance Level (PL) ratings under standards such as IEC 61508 and ISO 26262, which quantify the required probability of failure on demand. They encompass emergency shutdown systems, safety PLCs, watchdog timers, interlocks, redundant sensors, and AI-based anomaly detection."@en ;
    rdfs:subClassOf ngm:control-system ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:functional-safety,
        ngm:iec-61508,
        ngm:iso-26262 ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:autonomous-vehicle,
        ngm:real-time-operating-system,
        ngm:robot-safety,
        ngm:safety-measure ;
    vc:slug "safety-system" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:embedded-systems,
        ngm:monitoring-system,
        ngm:safety-plc .

ngm:satellite-monitoring a owl:Class ;
    rdfs:label "Satellite Monitoring"@en ;
    rdfs:comment "Satellite monitoring is the use of orbital remote-sensing platforms to observe and measure conditions on the Earth's surface over time. In sustainability and supply-chain contexts it supports verification of deforestation, land use, emissions plumes, and facility activity using multispectral, radar, and thermal imagery. The resulting geospatial data feeds carbon accounting, compliance, and ethical-sourcing assessments."@en ;
    rdfs:subClassOf ngm:sustainability ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:carbon-footprint-measurement,
        ngm:ethical-sourcing ;
    vc:slug "satellite-monitoring" ;
    vc:sourceDomain "supply-chain" .

ngm:scara-robot a owl:Class ;
    rdfs:label "SCARA Robot"@en ;
    rdfs:comment "Selective Compliance Articulated Robot Arm — a four-axis industrial robot with two rotary joints in the horizontal plane that give high compliance laterally whilst providing rigid vertical stiffness along the Z-axis. SCARA robots excel at high-speed pick-and-place, assembly, and packaging tasks that require precise horizontal positioning but resist vertical forces."@en ;
    rdfs:subClassOf ngm:industrial-robot,
        ngm:robo-robot-type ;
    skos:broader ngm:robo-robot-type ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:robo-actuation-and-control ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:collaborative-systems-modality-robot,
        ngm:delta-robot,
        ngm:forward-kinematics,
        ngm:inverse-kinematics,
        ngm:motion-control,
        ngm:trajectory-planning ;
    vc:slug "scara-robot" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:encoder,
        ngm:pid-control,
        ngm:servo-motor .

ngm:schnorr-signatures a owl:Class ;
    rdfs:label "Schnorr Signatures"@en ;
    rdfs:comment "A digital signature scheme based on the discrete logarithm problem over elliptic curve groups, producing compact fixed-size signatures with linear aggregation properties that enable efficient multi-signature and threshold constructions."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:random-oracle-model ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:elliptic-curve-cryptography ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:hash-function ],
        ngm:digital-signature ;
    vc:bridgesTo ngm:blockchain,
        ngm:decentralised-identity ;
    vc:contrastsWith ngm:ecdsa,
        ngm:rsa-signature ;
    vc:enables ngm:batch-verification,
        ngm:key-aggregation,
        ngm:mu-sig-2,
        ngm:taproot,
        ngm:threshold-signature ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:bip-340 ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:non-interactive-zero-knowledge,
        ngm:public-key-cryptography,
        ngm:zero-knowledge-proof ;
    vc:requires ngm:discrete-logarithm-problem,
        ngm:elliptic-curve-cryptography,
        ngm:hash-function,
        ngm:random-oracle-model ;
    vc:slug "schnorr-signatures" ;
    vc:sourceDomain "security" ;
    vc:supports ngm:bitcoin,
        ngm:privacy-preserving-protocol ;
    vc:uses ngm:commitment-scheme,
        ngm:secp256k1 .

ngm:scientific-simulation a owl:Class ;
    rdfs:label "Scientific Simulation"@en ;
    rdfs:comment "Scientific simulation is the numerical modelling of physical, chemical, or biological systems to predict behaviour that is impractical to observe directly. It solves governing equations across discretised domains, as in fluid dynamics, molecular dynamics, and climate modelling, typically on high-performance computing infrastructure. Machine learning increasingly augments simulation through learned surrogates and data-driven generation."@en ;
    rdfs:subClassOf ngm:infra-computing-and-cloud ;
    skos:broader ngm:infra-computing-and-cloud ;
