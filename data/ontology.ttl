    vc:slug "networking-layer" ;
    vc:sourceDomain "spatial-computing" .

ngm:newcastle-ai-and-health-innovation a owl:Class ;
    rdfs:label "Newcastle AI & Health Innovation"@en ;
    rdfs:comment "Newcastle AI and Health Innovation is the regional technology ecosystem in North East England centred on the application of artificial intelligence to healthcare, life sciences, and digital health, anchored by Newcastle University, Northumbria University, and innovation institutions including the National Innovation Centre for Data and the National Innovation Centre for Ageing. The ecosystem combines academic research, NHS partnerships, and private sector investment to accelerate AI-driven health technology from discovery through to clinical and commercial deployment."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:healthcare-technology ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:artificial-intelligence ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:healthcare-ai ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:clinical-decision-support ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:healthcare-analytics ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:medical-ai ],
        ngm:ai-application ;
    skos:broader ngm:ai-application ;
    vc:bridgesTo ngm:ai-monitoring ;
    vc:enables ngm:ai-applications,
        ngm:clinical-trials,
        ngm:healthcare-records ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:clinical-decision-support,
        ngm:healthcare-ai,
        ngm:medical-ai ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:ai-governance,
        ngm:north-england-innovation-corridor,
        ngm:uk-tech-ecosystem ;
    vc:requires ngm:artificial-intelligence,
        ngm:healthcare-analytics,
        ngm:healthcare-technology ;
    vc:slug "newcastle-ai-and-health-innovation" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:machine-learning,
        ngm:predictive-analytics .

ngm:newton-euler-dynamics a owl:Class ;
    rdfs:label "Newton-Euler Dynamics"@en ;
    rdfs:comment "Recursive formulation of rigid-body mechanics that applies Newton's second law (F=ma) and Euler's rotation equation (τ=Iα) to each link of a robot chain in outward and inward passes, computing joint torques and reaction forces for dynamics simulation, control, and real-time motion planning."@en ;
    rdfs:subClassOf ngm:robo-actuation-and-control,
        ngm:robot-dynamics ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:enables ngm:control-system,
        ngm:embodied-ai-simulation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:robot-dynamics ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:inertia,
        ngm:inverse-kinematics,
        ngm:kinematics,
        ngm:rigid-body-dynamics,
        ngm:robot-joint,
        ngm:robot-kinematics ;
    vc:slug "newton-euler-dynamics" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:force-torque-sensor,
        ngm:physics-simulation .

ngm:nist-cybersecurity-framework a owl:Class ;
    rdfs:label "NIST Cybersecurity Framework"@en ;
    rdfs:comment "The NIST Cybersecurity Framework (CSF) is a voluntary risk-based framework published by the US National Institute of Standards and Technology that provides organisations with a common taxonomy and structured approach for managing cybersecurity risk. It organises security activities around six core functions—Govern, Identify, Protect, Detect, Respond, and Recover—each decomposed into categories and subcategories aligned to industry standards. Version 2.0, published in 2024, added the Govern function and broadened applicability beyond critical infrastructure to all sectors and organisation sizes globally. The framework is widely adopted as a baseline for cybersecurity programme assessment and communication with leadership."@en ;
    rdfs:subClassOf ngm:security-framework ;
    vc:enables ngm:incident-response,
        ngm:risk-assessment ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:compliance-framework,
        ngm:nist,
        ngm:nist-ai-rmf ;
    vc:slug "nist-cybersecurity-framework" ;
    vc:sourceDomain "security" ;
    vc:standardizedBy ngm:nist ;
    vc:supports ngm:compliance-monitoring,
        ngm:regulatory-compliance .

ngm:noise-function-library a owl:Class ;
    rdfs:label "Noise Function Library"@en ;
    rdfs:comment "A software library providing coherent noise generation algorithms like Perlin, simplex, value, and Voronoi noise for procedural content generation in computer graphics, enabling the creation of natural-looking textures, terrain, and visual effects without manual authoring."@en ;
    rdfs:subClassOf ngm:graphics-library,
        ngm:sc-display-and-rendering ;
    skos:broader ngm:sc-display-and-rendering ;
    vc:enables ngm:procedural-content ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:slug "noise-function-library" ;
    vc:sourceDomain "spatial-computing" .

ngm:notification-system a owl:Class ;
    rdfs:label "Notification System"@en ;
    rdfs:comment "A software component that delivers event-driven alerts, presence indicators, and system messages to users or services in real time. In virtual world and metaverse contexts, notification systems manage social events, user-to-user signals, and platform state changes across distributed infrastructure, typically using push protocols or pub-sub messaging patterns."@en ;
    rdfs:subClassOf ngm:infra-network-and-comms ;
    skos:broader ngm:infra-network-and-comms ;
    vc:enables ngm:event-management,
        ngm:social-presence ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:networking-infrastructure,
        ngm:platform-service ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:slug "notification-system" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:event-driven-architecture,
        ngm:realtime-communication .

ngm:novel-view-synthesis a owl:Class ;
    rdfs:label "Novel View Synthesis"@en ;
    rdfs:comment "Novel view synthesis (NVS) is a computer vision and computer graphics task that involves generating photorealistic images of a scene from camera viewpoints not present in the original set of captured images, given a collection of reference photographs and their corresponding camera poses. The task requires learning an implicit or explicit representation of the scene's geometry and appearance that supports free-viewpoint rendering with high fidelity. It is a foundational capability for immersive media, telepresence, and spatial computing applications, and has been dramatically advanced by neural scene representations such as Neural Radiance Fields and 3D Gaussian Splatting."@en ;
    rdfs:subClassOf ngm:computer-vision-task ;
    vc:enables ngm:virtual-reality-telepresence,
        ngm:volumetric-capture ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:3-d-gaussian-splatting,
        ngm:differentiable-rendering,
        ngm:neural-radiance-field,
        ngm:photogrammetry ;
    vc:slug "novel-view-synthesis" ;
    vc:sourceDomain "graphics" ;
    vc:uses ngm:camera-calibration,
        ngm:depth-estimation,
        ngm:neural-rendering .

ngm:npc-interaction a owl:Class ;
    rdfs:label "NPC Interaction"@en ;
    rdfs:comment "The systems and mechanics enabling player communication and engagement with non-player characters in video games and virtual worlds, increasingly powered by AI and large language models to generate dynamic, unscripted dialogue and contextual responses."@en ;
