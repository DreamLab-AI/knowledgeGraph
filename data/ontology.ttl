    vc:sourceDomain "spatial-computing" ;
    vc:standardizedBy ngm:interoperability-framework .

ngm:environmental-sensing a owl:Class ;
    rdfs:label "Environmental Sensing"@en ;
    rdfs:comment "Environmental sensing is the acquisition of data about physical surroundings, such as temperature, light, humidity, air quality, sound, or proximity, using sensors. It provides the raw perceptual input that systems use to understand and respond to their context. In robotics, IoT, and context-aware applications it is the foundational layer enabling situational awareness and adaptive behaviour."@en ;
    rdfs:subClassOf ngm:robo-perception ;
    skos:broader ngm:robo-perception ;
    vc:hasMaturity ngmi:maturity-established ;
