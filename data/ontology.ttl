ngm:attention-mask a owl:Class ;
    rdfs:label "Attention Mask"@en ;
    rdfs:comment "A mechanism that controls which positions in a sequence can attend to which other positions, typically implemented by adding large negative values before softmax to zero out unwanted attention weights; used for causal masking in autoregressive decoders and padding masking in batched variable-length sequences."@en ;
    rdfs:subClassOf ngm:ai-model-architecture ;
    skos:broader ngm:ai-model-architecture ;
    vc:enables ngm:albert,
        ngm:large-language-models ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:transformer-architecture ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:relatedTo ngm:bart,
        ngm:neural-network-architecture ;
    vc:slug "attention-mask" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:natural-language-processing .

