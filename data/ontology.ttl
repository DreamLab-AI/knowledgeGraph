# Content Addressing
blockchain:ContentAddressing rdf:type owl:Class ;
    rdfs:label "Content Addressing"@en ;
    rdfs:comment "The fundamental principle (R1 in ADR-013) that derives a resource's URI deterministically from its Content Hash (SHA-256), ensuring immutability, tamper-detection, and deduplication, enabling VisionClaw Agentic Container artefacts (credentials, receipts, events, pods, activities) to be referenced by their content rather than by location or opaque identifiers."@en ;
    skos:prefLabel "Content Addressing"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:blockchain:content-addressing" ;
