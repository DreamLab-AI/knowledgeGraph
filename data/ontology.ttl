# Virtual Asset
spatial-computing:VirtualAsset rdf:type owl:Class ;
    rdfs:label "Virtual Asset"@en ;
    rdfs:comment "Virtual assets are digital items with economic value within MetaversePlatforms, spanning NFT representing unique digital collectibles, Avatar and avatar customisations, VirtualRealEstate, and InGameItems with market-tradeable value. Ownership and transfer of virtual assets rely on BlockchainTechnology smart contracts or centralised platform ledgers, with Interoperability enabling asset portability across platforms and markets. Economic significance of virtual assets spans consumer entertainment (gaming, social worlds) to investment speculation, with regulatory frameworks increasingly addressing VirtualAssetTaxation and classification under securities laws."@en ;
    skos:prefLabel "Virtual Asset"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:spatial-computing:virtual-asset" ;
    owl:sameAs <urn:visionclaw:concept:spatial-computing:virtual-asset> ;
    vcw:contentHash "sha256-12-94700a618bcb" ;
    vcw:qualityScore "0.4"^^xsd:decimal ;
    vcw:legacyTermId "MV-3036" ;
    vcw:ontologyStatus "draft" ;
    vcw:maturityLevel "draft" ;
    vcw:authorityScore "0.0"^^xsd:decimal ;
    dcterms:identifier "MV-3036" ;
    dcterms:subject "spatial-computing" ;
    owl:versionInfo "2.0.0" ;
    dcterms:created "2026-04-26T00:00:00Z"^^xsd:dateTime ;
    dcterms:modified "2026-04-26T13:00:00Z"^^xsd:dateTime ;
    vcw:owlRole "Concept" .

# Social VR
spatial-computing:SocialVR rdf:type owl:Class ;
    rdfs:label "Social VR"@en ;
    rdfs:comment "Social VR encompasses immersive virtual reality experiences specifically designed for real-time social interaction and collaboration among multiple users within shared persistent virtual spaces, leveraging avatar-based presence and synchronised communication. Platforms like MetaHorizonWorlds, VRChat, and AltspaceVR enable diverse social activities from casual hangouts and professional meetings to educational workshops and entertainment events, with spatial audio and gesture recognition enhancing social presence. Integration with DecentralizedIdentity, NFT, and VirtualEconomy creates interoperable social metaverses where users maintain control over digital identities and virtual assets across platforms."@en ;
    skos:prefLabel "Social VR"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:spatial-computing:social-vr" ;
    owl:sameAs <urn:visionclaw:concept:spatial-computing:social-vr> ;
    vcw:contentHash "sha256-12-9b24ccd95b52" ;
    vcw:qualityScore "0.4"^^xsd:decimal ;
    vcw:legacyTermId "MV-3037" ;
    vcw:ontologyStatus "draft" ;
