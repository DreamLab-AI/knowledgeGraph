# Binary Buffer
mv:BinaryBuffer a owl:Class ;
    rdfs:subClassOf mv:DataStructure ;
    rdfs:label "Binary Buffer"@en ;
    rdfs:comment "A contiguous region of memory used to temporarily store binary data during transfer, processing, or rendering operations, serving as an intermediary between data sources and destinations in graphics pipelines, network communications, and computational workflows."@en ;
    skos:prefLabel "Binary Buffer"@en ;
    dcterms:identifier "MV-9799" ;
    dcterms:subject "mv" .

