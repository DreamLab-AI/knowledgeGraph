    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:research-and-development ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:academic-research,
        ngm:alan-turing-institute,
        ngm:university-of-edinburgh ;
    vc:requires ngm:research-and-development ;
    vc:slug "uk-research-and-innovation" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:academic-research,
        ngm:artificial-intelligence,
        ngm:university-of-edinburgh ;
    vc:uses ngm:impact-assessment .

ngm:university-of-manchester a owl:Class ;
    rdfs:label "University of Manchester"@en ;
    rdfs:comment "The University of Manchester is a public research university in Manchester, England, formed in 2004 by the merger of the Victoria University of Manchester and UMIST, with institutional roots tracing to 1824. It is a founding member of the Russell Group and a global leader in artificial intelligence, machine learning, materials science, and computer science, housing the Alan Turing Institute affiliate node and the Department of Computer Science where early stored-program computing was pioneered. The university produced the Manchester Baby (1948), the first operational stored-program electronic computer, and its researchers isolated graphene in 2004. It is consistently ranked among the world's top 30 research universities and has produced over 25 Nobel laureates across physics, chemistry, economics, and medicine."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:research-funding ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:high-performance-computing ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:alan-turing-institute ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:computer-science ],
        ngm:ai-research-area ;
    skos:broader ngm:ai-research-area ;
    vc:bridgesTo ngm:blockchain,
        ngm:distributed-systems,
        ngm:spatial-computing ;
    vc:contrastsWith ngm:private-research-institution ;
    vc:enables ngm:knowledge-graph,
        ngm:machine-learning-research,
        ngm:natural-language-processing ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:alan-turing-institute,
        ngm:computer-science ;
    vc:isPartOf ngm:n8-research-partnership,
        ngm:russell-group ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:alan-turing,
        ngm:deep-learning,
        ngm:imperial-college-london,
        ngm:research-university,
        ngm:university-of-cambridge,
        ngm:university-of-edinburgh ;
