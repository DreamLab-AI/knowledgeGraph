ngm:democratic-engagement a owl:Class ;
    rdfs:label "Democratic Engagement"@en ;
    rdfs:comment "Democratic Engagement refers to the mechanisms, platforms, and practices through which citizens and communities participate in governance decisions, policy formation, and collective sense-making, including via digital and virtual channels. In metaverse and telecollaboration contexts, democratic engagement encompasses online deliberation tools, DAO-based governance, participatory spatial environments, and AI-assisted facilititation of broad-based civic participation."@en ;
    rdfs:subClassOf ngm:metaverse-and-telecollaboration,
        ngm:sc-governance-and-safety ;
    skos:broader ngm:sc-governance-and-safety ;
    vc:enables ngm:democratic-governance,
        ngm:democratic-participation ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:platform-governance ;
    vc:slug "democratic-engagement" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:ai-governance,
        ngm:democratic-values ;
    vc:uses ngm:digital-platform,
        ngm:telecollaboration .

