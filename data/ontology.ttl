ngm:etsi-domain-taxonomy a owl:Class ;
    rdfs:label "ETSI Domain Taxonomy"@en ;
    rdfs:comment "The ETSI Domain Taxonomy is a hierarchical classification framework produced by the European Telecommunications Standards Institute for systematically organising AI-related technical specifications, standards, and work items across application domains such as transportation, healthcare, telecommunications, and public safety. It provides a controlled vocabulary and structured ontology enabling consistent referencing of AI standards across ETSI technical committees and supports cross-domain applicability analysis. The taxonomy underpins ETSI's AI standardisation roadmap and aligns with CEN-CENELEC and ISO/IEC JTC 1/SC 42 standardisation activities. As a living classification instrument, it maps broad application sectors down to specific sub-domains, allowing AI systems and standards to receive multiple domain affiliations and enabling gap analysis across the European standardisation ecosystem."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:controlled-vocabulary ],
        ngm:ai-governance-and-ethics ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:bridgesTo ngm:data-governance,
        ngm:machine-learning-operations ;
    vc:contrastsWith ngm:iso-iec-42001,
        ngm:nist-ai-rmf ;
    vc:enables ngm:ai-conformity-assessment,
        ngm:cross-domain-applicability,
        ngm:standards-gap-analysis ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:ai-application-domain,
        ngm:controlled-vocabulary,
        ngm:domain-classification-hierarchy ;
    vc:isPartOf ngm:etsi,
        ngm:european-ai-standards-ecosystem ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:ai-governance-and-ethics,
        ngm:ai-standards-framework,
        ngm:cen-cenelec,
        ngm:etsi-isg-ai,
        ngm:ieee-standards ;
    vc:requires ngm:taxonomy-governance,
        ngm:technical-committee ;
    vc:slug "etsi-domain-taxonomy" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:standardizedBy ngm:etsi,
        ngm:iso-iec-jtc1-sc42 ;
    vc:supports ngm:ai-regulation,
        ngm:eu-ai-act,
        ngm:harmonised-standards,
        ngm:interoperability ;
    vc:uses ngm:knowledge-representation,
        ngm:ontology,
        ngm:semantic-web .

ngm:european-commission a owl:Class ;
    rdfs:label "European Commission"@en ;
    rdfs:comment "The European Commission is the politically independent executive body of the European Union, holding the exclusive right of legislative initiative and responsible for proposing legislation, implementing decisions of the Council of the European Union, managing the EU budget, and upholding EU treaties and law across all 27 member states. In the technology domain it has authored landmark regulatory frameworks including the EU AI Act, the Data Governance Act, the Digital Markets Act, and the Digital Services Act, constituting the most comprehensive digital governance agenda of any jurisdiction. It also directs research funding through Horizon Europe, coordinates AI standardisation mandates to CEN-CENELEC and ETSI, and operates cross-border digital infrastructure such as the European Blockchain Services Infrastructure."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:european-parliament ],
        ngm:infra-legal-and-regulatory ;
    skos:broader ngm:infra-legal-and-regulatory ;
