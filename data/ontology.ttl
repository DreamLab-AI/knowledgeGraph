ngm:serialisation a owl:Class ;
    rdfs:comment "Serialisation is the process of converting in-memory data structures or object graphs into a linear byte sequence or text representation that can be stored, transmitted, and later reconstructed. The inverse operation, deserialisation, rebuilds the original structure from the encoded form. Serialisation underpins persistence, inter-process and network communication, and the interoperability of systems that exchange structured data."@en ;
    rdfs:label "Serialisation"@en ;
    rdfs:subClassOf ngm:data-format-standard ;
