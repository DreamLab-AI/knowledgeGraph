    vc:slug "active-learning" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:asynchronous-collaboration a owl:Class ;
    rdfs:label "Asynchronous Collaboration"@en ;
    rdfs:comment "Time-independent collaboration mode where distributed participants contribute at different times through shared persistent artifacts, enabling flexible schedules, deep work periods, and global accessibility while maintaining coordination through explicit documentation and version control."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:code-review ],
