ngm:ecdsa-cryptography a owl:Class ;
    rdfs:comment "ECDSA (Elliptic Curve Digital Signature Algorithm) is a public-key signature scheme that uses the algebra of elliptic curves over finite fields to produce compact, efficient digital signatures. It provides strong security with much smaller keys than RSA, making it the dominant signing algorithm in blockchains such as Bitcoin and Ethereum. ECDSA enables verifiable authorship and integrity of messages and transactions without revealing the private key."@en ;
    rdfs:label "ECDSA Cryptography"@en ;
    rdfs:subClassOf ngm:cryptographic-primitive ;
