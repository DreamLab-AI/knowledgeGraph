ngm:asset-format-standards a owl:Class ;
    rdfs:label "Asset Format Standards"@en ;
    rdfs:comment "Asset Format Standards are technical specifications defining file formats, data structures, and interchange protocols for 3D models, textures, animations, and scene descriptions, enabling interoperability between content creation tools, game engines, and metaverse platforms through standards like..."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
