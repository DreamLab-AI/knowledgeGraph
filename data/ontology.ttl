    vc:slug "perception-layer" ;
    vc:sourceDomain "spatial-computing" .

ngm:performance-capture a owl:Class ;
    rdfs:label "Performance Capture"@en ;
    rdfs:comment "Performance capture records an actor's full body, facial and sometimes finger movement simultaneously so that a single performance drives a digital character's motion and expression."@en ;
