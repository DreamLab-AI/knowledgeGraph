ngm:ethical-review-process a owl:Class ;
    rdfs:comment "An Ethical Review Process is a structured methodology for evaluating AI systems against ethical frameworks, organisational values, and societal norms, involving expert deliberation, stakeholder consultation, and documented decision-making to ensure responsible AI development and deployment. It applies consequentialist, deontological, and virtue-ethics frameworks to assess fairness, privacy, autonomy, safety, and accountability dimensions, producing approval, conditional approval, deferral, or rejection outcomes with documented rationale."@en ;
    rdfs:label "Ethical Review Process"@en ;
    rdfs:subClassOf ngm:ai-governance-and-ethics ;
