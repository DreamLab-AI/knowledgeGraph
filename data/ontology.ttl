        ngm:reinforcement-learning .

ngm:fault-tolerance a owl:Class ;
    rdfs:label "Fault Tolerance"@en ;
    rdfs:comment "System property denoting the capability of a computing or distributed system to continue providing correct service in the presence of component failures, encompassing the formal failure-model taxonomy enumerated by Cristian (fail-stop, fail-silent, omission, crash-recovery, timing, Byzantine arbi..."@en ;
