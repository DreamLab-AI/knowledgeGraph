    vc:slug "treatment-planning-ai" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:deep-learning,
        ngm:reinforcement-learning .

ngm:trust-architecture a owl:Class ;
    rdfs:label "Trust Architecture"@en ;
    rdfs:comment "The structural framework of protocols, technologies, and governance mechanisms that establish, verify, and maintain trust relationships between users, platforms, and services in decentralized digital environments and metaverse ecosystems. It encompasses identity verification through Decentralised Identifiers (DIDs), cryptographically signed Verifiable Credentials, smart-contract-enforced rules, and consensus mechanisms, supporting both zero-trust security models and reputation-based trust scoring across cross-platform interactions."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:decentralized-identifiers ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:verifiable-credentials ],
        ngm:sc-governance-and-safety,
        ngm:security-architecture ;
    skos:broader ngm:sc-governance-and-safety ;
    vc:enables ngm:cross-platform-identity,
        ngm:decentralized-governance ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:trust-framework,
        ngm:trust-infrastructure ;
    vc:requires ngm:decentralized-identifiers,
        ngm:verifiable-credentials ;
    vc:slug "trust-architecture" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:cryptographic-security,
        ngm:trusted-execution-environment .

ngm:trust-framework-policy a owl:Class ;
    rdfs:label "Trust Framework Policy"@en ;
    rdfs:comment "Set of rules and requirements governing participant behavior, accountability, and interoperability in federated digital identity ecosystems within metaverse environments."@en ;
