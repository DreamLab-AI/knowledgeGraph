ngm:monte-carlo-methods a owl:Class ;
    rdfs:label "Monte Carlo Methods"@en ;
    rdfs:comment "Monte Carlo methods are a broad class of computational algorithms that employ repeated random sampling to approximate numerical quantities that are analytically intractable, including high-dimensional integrals, expectations under complex probability distributions, and optimal policies in stochastic decision processes. The fundamental principle holds that averaging a function over sufficiently many independent samples drawn from an appropriate distribution converges, by the law of large numbers, to the true expected value at a rate of O(1/√N) independent of dimensionality. Monte Carlo methods underpin Bayesian inference, reinforcement learning, sequential Monte Carlo particle filters, and physics simulation, and are foundational to risk analysis, financial modelling, and scientific computing. Variance reduction techniques — including importance sampling, control variates, stratified sampling, and quasi-Monte Carlo sequences — substantially improve practical convergence."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:monte-carlo-tree-search ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:random-number-generation ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:importance-sampling ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:markov-chain-monte-carlo ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:sequential-monte-carlo ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:probability-theory ],
        ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:bridgesTo ngm:drug-discovery,
        ngm:financial-modelling,
        ngm:physics-simulation ;
    vc:contrastsWith ngm:deterministic-algorithms,
        ngm:numerical-quadrature ;
    vc:enables ngm:bayesian-inference,
        ngm:monte-carlo-localization,
        ngm:probabilistic-programming,
        ngm:reinforcement-learning,
        ngm:risk-analysis ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:importance-sampling,
        ngm:markov-chain-monte-carlo,
        ngm:monte-carlo-tree-search,
        ngm:quasi-monte-carlo,
        ngm:sequential-monte-carlo ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:deep-learning,
        ngm:particle-filter,
        ngm:statistical-inference ;
    vc:requires ngm:law-of-large-numbers,
        ngm:probability-theory,
        ngm:random-number-generation ;
    vc:slug "monte-carlo-methods" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:numerical-integration,
        ngm:optimisation,
        ngm:uncertainty-quantification ;
    vc:uses ngm:sampling,
        ngm:stochastic-process,
        ngm:variance-reduction .

ngm:motor-driver a owl:Class ;
    rdfs:label "Motor Driver"@en ;
    rdfs:comment "A Motor Driver is an electronic circuit or integrated circuit module that translates low-power control signals from a microcontroller or digital signal processor into the high-current, high-voltage waveforms required to operate electric motors, including DC brushed motors, brushless DC motors, and stepper motors. Motor drivers implement switching topologies such as H-bridge configurations and PWM (pulse-width modulation) generation to control motor direction, speed, and torque. Protection circuitry for over-current, over-temperature, and back-EMF clamping is typically integrated. Motor drivers are fundamental building blocks of robotic systems, electric vehicles, CNC machinery, and consumer appliances."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:power-supply ],
        ngm:power-electronics ;
    vc:bridgesTo ngm:can-bus,
        ngm:ethercat ;
    vc:contrastsWith ngm:servo-amplifier ;
    vc:dependsOn ngm:embedded-systems,
        ngm:mosfet ;
    vc:enables ngm:actuator,
