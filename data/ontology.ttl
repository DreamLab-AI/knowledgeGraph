ngm:acoustic-model a owl:Class ;
    rdfs:comment "An Acoustic Model is the component of a speech-recognition system that maps audio signal features to the probability of phonetic or sub-word units. It learns the statistical relationship between observed acoustic features and the linguistic sounds that produced them, traditionally using hidden Markov models with Gaussian mixtures and increasingly using deep neural networks. Combined with a language model, it converts spoken audio into the most likely sequence of words."@en ;
    rdfs:label "Acoustic Model"@en ;
    rdfs:subClassOf ngm:sequence-model ;
