# Ethical AI
artificial-intelligence:EthicalAI rdf:type owl:Class ;
    rdfs:label "Ethical AI"@en ;
    rdfs:comment "The development, deployment, and use of artificial intelligence systems in accordance with moral principles and values that respect human dignity, rights, and wellbeing, incorporating considerations of fairness, transparency, accountability, privacy, safety, and beneficence throughout the AI lifecycle, whilst promoting human flourishing, social justice, and the common good through deliberate design choices, governance mechanisms, and operational practices that embed ethical reasoning into AI system functioning and organisational decision-making."@en ;
    skos:prefLabel "Ethical AI"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:artificial-intelligence:ethical-ai" ;
    owl:sameAs <urn:visionclaw:concept:artificial-intelligence:ethical-ai> ;
    vcw:contentHash "sha256-12-9602f835234c" ;
    vcw:qualityScore "0.5"^^xsd:decimal ;
    vcw:legacyTermId "AI-0103" ;
    vcw:ontologyStatus "draft" ;
    vcw:maturityLevel "draft" ;
    vcw:authorityScore "0.0"^^xsd:decimal ;
    dcterms:identifier "AI-0103" ;
    dcterms:subject "artificial-intelligence" ;
    owl:versionInfo "2.0.0" ;
    dcterms:created "2026-04-26T00:00:00Z"^^xsd:dateTime ;
    dcterms:modified "2026-04-26T13:00:00Z"^^xsd:dateTime ;
    vcw:owlRole "Concept" .

artificial-intelligence:EthicalAI rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty infrastructure:requires ;
    owl:someValuesFrom artificial-intelligence:AIGovernance
] .

