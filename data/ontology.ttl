ngm:arc-consistency a owl:Class ;
    rdfs:comment "A local consistency property of binary constraint networks in which, for every value in one variable's domain, each constraint linking it to another variable admits at least one compatible supporting value in that variable's domain. Enforcing it — classically with the AC-3 algorithm — deletes unsupported values until a fixed point, providing the most widely used level of constraint propagation and the pruning backbone of practical constraint solvers."@en ;
    rdfs:label "Arc Consistency"@en ;
    rdfs:subClassOf ngm:constraint-propagation ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:isPartOf ngm:constraint-satisfaction ;
    vc:qualityScore "0.8"^^xsd:float ;
