        ngm:hand-tracking,
        ngm:passthrough-camera .

ngm:xr-meeting-space a owl:Class ;
    rdfs:label "XR Meeting Space"@en ;
    rdfs:comment "Virtual collaboration environments accessed through extended reality devices that enable remote participants to interact as avatars or volumetric representations in shared 3D spaces, supporting meetings, presentations, design reviews, and team collaboration with spatial audio and gesture-based communication. XR meeting spaces extend traditional video conferencing by providing persistent, spatially aware environments where presence, proximity, and embodied interaction improve engagement and coordination."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:spatial-audio ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:virtual-reality-platform ],
        [ a owl:Restriction ;
