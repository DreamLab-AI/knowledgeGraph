ngm:shader a owl:Class ;
    rdfs:label "Shader"@en ;
    rdfs:comment "A programmable GPU program that replaces fixed-function rendering stages, defining how vertices are transformed and how fragments are coloured by executing artist-authored algorithms in parallel across thousands of GPU threads. Shaders encompass vertex, fragment, geometry, and compute variants, collectively controlling every aspect of a rendered image's visual appearance."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:compute-shader ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:vertex-shader ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:pixel-shader ],
        ngm:sc-display-and-rendering ;
    skos:broader ngm:sc-display-and-rendering ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:compute-shader,
        ngm:pixel-shader,
        ngm:vertex-shader ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:relatedTo ngm:shader-language ;
    vc:slug "shader" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:rendering-technique,
        ngm:visual-effects ;
    vc:uses ngm:rasterization .

ngm:version-control a owl:Class ;
    rdfs:label "Version Control"@en ;
    rdfs:comment "Version control is a system for tracking, managing, and auditing changes to files—principally source code—over time, enabling multiple contributors to work in parallel branches and merge changes systematically. Distributed version control systems such as Git maintain a full change history locally on each node, enabling offline operation, branching, rebasing, and cryptographically signed commits. Version control is a prerequisite for reproducible AI training pipelines, dataset lineage tracking, collaborative 3D asset workflows, and Infrastructure-as-Code practices."@en ;
    rdfs:subClassOf ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:enables ngm:code-generation,
        ngm:collaboration ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:data-provenance,
        ngm:knowledge-management ;
    vc:slug "version-control" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:ai-augmented-software-engineering .

ngm:virtual-environment a owl:Class ;
