ngm:production-pipeline a owl:Class ;
    rdfs:label "Production Pipeline"@en ;
    rdfs:comment "The end-to-end sequence of tools, processes, and automated stages that transform raw creative or data assets into finished, deployable outputs. In spatial computing contexts a production pipeline typically spans asset creation, format conversion, quality assurance, rendering, and deployment to target platforms (game engines, XR runtimes, or streaming services)."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:rendering-pipeline ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:digital-asset-workflow ],
        ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:enables ngm:immersive-experience ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:digital-asset-workflow,
        ngm:rendering-pipeline ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:slug "production-pipeline" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:workflow-automation ;
    vc:uses ngm:asset-format-standards,
        ngm:game-engine .

ngm:projects a owl:Class ;
    rdfs:label "Projects"@en ;
    rdfs:comment "Projects is the top-level organisational concept grouping active development initiatives within this knowledge graph. It serves as a Kanban and progress-tracking container for ongoing technical, research, and creative workstreams, linking to child project nodes such as PlayerTwo, BroBots, and Automated Podcast."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:project-bro-bots ],
        [ a owl:Restriction ;
