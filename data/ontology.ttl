ngm:etsi-domain-ai-data-mgmt a owl:Class ;
    rdfs:label "ETSI Domain AI + Data Mgmt"@en ;
    rdfs:comment "Cross-domain marker for metaverse components combining artificial intelligence with data management capabilities including ML pipelines, intelligent data processing, analytics, and AI-driven data governance."@en ;
