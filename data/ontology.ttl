ngm:trustworthy-ai-framework a owl:Class ;
    rdfs:label "Trustworthy AI Framework"@en ;
    rdfs:comment "Comprehensive governance and standards framework establishing principles, requirements, and assessment processes to ensure AI systems are lawful, ethical, and technically robust throughout their lifecycle. Defined by the EU High-Level Expert Group on AI and formalised in the EU AI Act, it implements a risk-based approach with seven trustworthiness dimensions covering human oversight, safety, privacy, transparency, fairness, societal wellbeing, and accountability."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ai-audit ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:conformity-assessment ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:risk-assessment ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:accountability ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:explainability ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:high-risk-ai-system ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:ai-safety ],
        ngm:ai-governance-and-ethics ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:accountability,
        ngm:ai-safety,
        ngm:conformity-assessment,
        ngm:explainability,
        ngm:high-risk-ai-system ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:ai-ethics,
        ngm:ai-governance,
        ngm:ai-governance-framework,
        ngm:ai-regulation,
        ngm:responsible-ai,
        ngm:trustworthy-ai ;
    vc:requires ngm:ai-audit,
        ngm:risk-assessment ;
    vc:slug "trustworthy-ai-framework" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:standardizedBy ngm:ai-governance-principle .

