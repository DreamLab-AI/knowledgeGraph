    vc:slug "environmental-sensing" ;
    vc:sourceDomain "robotics" .

ngm:environmental-trading a owl:Class ;
    rdfs:label "Environmental Trading"@en ;
    rdfs:comment "Environmental Trading encompasses market-based mechanisms for buying and selling environmental assets such as carbon credits, renewable energy certificates, and biodiversity offsets. These mechanisms use blockchain-backed registries and smart contracts to provide transparent, auditable records of environmental value transfers, enabling organisations to meet sustainability obligations through market participation."@en ;
