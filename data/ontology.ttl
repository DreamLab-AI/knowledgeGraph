        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:storage-infrastructure ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:spatial-calibration ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-processing-hardware ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:tracking-system ],
        ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:enables ngm:3-d-model-generation,
        ngm:digital-twin-creation,
        ngm:environment-reconstruction,
        ngm:visual-representation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:3-d-scanner,
