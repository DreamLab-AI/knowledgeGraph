        ngm:risk-assessment,
        ngm:transaction-monitoring ;
    vc:slug "compliance-verification" ;
    vc:sourceDomain "governance" ;
    vc:standardizedBy ngm:financial-action-task-force,
        ngm:transfer-of-funds-regulation ;
    vc:supports ngm:compliance,
        ngm:regtech ;
    vc:uses ngm:decentralised-identity,
        ngm:machine-learning,
        ngm:smart-contracts,
        ngm:zero-knowledge-proof .

ngm:coordinate-system a owl:Class ;
    rdfs:label "Coordinate System"@en ;
    rdfs:comment "A coordinate system is a mathematical framework that assigns a unique ordered tuple of numbers to every point in a geometric space, enabling unambiguous specification of position, orientation, and scale. Coordinate systems establish reference frames — world, camera, object, and sensor frames — that must be composed via rigid-body or affine transforms to map quantities from one frame into another. In spatial computing, robotics, and computer vision, multiple overlapping coordinate frames coexist and their consistent management is essential for rendering, navigation, and perception tasks. The choice of convention (handedness, axis orientation, unit) and the algebraic formalism used (homogeneous matrices, quaternions, dual quaternions, Lie group elements) profoundly affects numerical stability and interoperability across software stacks."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:homogeneous-transformation ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:reference-frames ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:spatial-mapping ],
        ngm:sc-display-and-rendering ;
    skos:broader ngm:sc-display-and-rendering ;
    vc:bridgesTo ngm:sensor-fusion,
        ngm:world-model ;
    vc:dependsOn ngm:linear-algebra ;
    vc:enables ngm:3-d-rendering,
        ngm:augmented-reality,
        ngm:pose-estimation,
        ngm:slam,
        ngm:spatial-anchor ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:reference-frames ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:euclidean-geometry ;
    vc:requires ngm:homogeneous-transformation,
        ngm:spatial-mapping ;
    vc:slug "coordinate-system" ;
    vc:sourceDomain "spatial-computing" ;
    vc:standardizedBy ngm:open-xr ;
    vc:supports ngm:computer-vision,
        ngm:geographic-information-system,
        ngm:robot-kinematics,
        ngm:scene-graph ;
    vc:uses ngm:coordinate-transformation,
        ngm:quaternion-math .

ngm:database-system a owl:Class ;
    rdfs:label "Database System"@en ;
    rdfs:comment "A database system (DBMS - Database Management System) is software that enables users to define, create, maintain, and control access to structured collections of data. It encompasses relational databases using SQL for structured table-based data and NoSQL databases supporting flexible schemas for document, key-value, graph, and wide-column data models, providing mechanisms for concurrent access, data integrity, and persistent storage."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:file-system ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:transaction-manager ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:storage-engine ],
        [ a owl:Restriction ;
