        ngm:iso-iec-42001,
        ngm:nist-ai-rmf ;
    vc:supports ngm:ai-safety,
        ngm:algorithmic-accountability ;
    vc:uses ngm:ai-operator,
        ngm:risk-management .

ngm:private-key a owl:Class ;
    rdfs:label "Private Key"@en ;
    rdfs:comment "A Private Key is a secret scalar value generated through cryptographically secure randomness that serves as the sole proof of ownership within asymmetric cryptographic systems. In blockchain contexts it authorises transaction signing via digital signatures, controls access to associated public addresses and funds, and underpins the non-custodial security model where loss or exposure is irreversible."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:random-number-generator ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:secure-storage ],
        ngm:cryptographic-primitive ;
    vc:bridgesTo ngm:decentralised-identity,
        ngm:self-sovereign-identity ;
    vc:contrastsWith ngm:public-key,
        ngm:symmetric-key ;
    vc:dependsOn ngm:discrete-logarithm-problem ;
    vc:enables ngm:authentication,
        ngm:cryptographic-signature,
        ngm:non-custodial-wallet,
        ngm:transaction-signing ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:asymmetric-cryptography,
        ngm:public-key-infrastructure ;
    vc:isPartOf ngm:asymmetric-key-pair,
        ngm:cryptographic-system ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:cryptographic-key-management,
        ngm:cryptographic-keys,
        ngm:hardware-security-module,
        ngm:hierarchical-deterministic-wallet ;
