    vc:slug "resilience-engineering" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:distributed-systems,
        ngm:site-reliability-engineering ;
    vc:uses ngm:chaos-engineering,
        ngm:redundancy .

ngm:resolution-bucketing a owl:Class ;
    rdfs:label "Resolution Bucketing"@en ;
    rdfs:comment "Resolution bucketing is a training-data preparation technique for diffusion and other image-generation models that groups training images into a fixed set of aspect-ratio and size buckets rather than forcing every image to a single square resolution. Each batch is drawn from a single bucket so images share dimensions, avoiding distortion from cropping or stretching while preserving GPU batching efficiency. It improves fidelity for non-square data and is a standard step in fine-tuning pipelines such as Kohya-based DreamBooth and LoRA training."@en ;
    rdfs:subClassOf ngm:machine-learning-discipline-technique ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:kohya-dreambooth-and-similar ;
    vc:slug "resolution-bucketing" ;
    vc:sourceDomain "ai" .

ngm:resolver a skos:Concept ;
    rdfs:label "Resolver"@en .

ngm:revenue-threshold a owl:Class ;
    rdfs:label "Revenue Threshold"@en ;
    rdfs:comment "A revenue threshold is a regulatory trigger that applies obligations only to entities whose annual revenue exceeds a defined monetary level. In AI legislation such thresholds scope rules to large developers, exempting smaller firms to reduce compliance burden while targeting actors with the greatest capacity and impact. The threshold value is a key parameter determining who falls within a law's reach."@en ;
    rdfs:subClassOf ngm:regulatory-compliance ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:california-ai-bill ;
    vc:slug "revenue-threshold" ;
    vc:sourceDomain "governance" .

ngm:rights-protection a owl:Class ;
    rdfs:label "Rights Protection"@en ;
    rdfs:comment "Rights protection encompasses the institutional, legal, and technical mechanisms through which individual and collective entitlements—civil liberties, digital rights, property rights, privacy rights, and human rights—are identified, defended, and remedied when violated. It spans constitutional and statutory safeguards, judicial and administrative enforcement, technical privacy-by-design measures, and advocacy infrastructure. In digital and AI contexts, rights protection addresses algorithmic discrimination, surveillance overreach, automated decision-making without human review, and the erosion of informational self-determination. Effective rights protection requires both upstream prevention and downstream accountability pathways."@en ;
    rdfs:subClassOf ngm:human-rights ;
    vc:enables ngm:consumer-protection,
        ngm:participant-protection ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:data-protection,
        ngm:digital-rights,
        ngm:privacy-protection ;
    vc:slug "rights-protection" ;
    vc:sourceDomain "governance" ;
    vc:supports ngm:ai-governance,
        ngm:legal-framework ;
    vc:uses ngm:enforcement-mechanism,
        ngm:privacy-by-design .

ngm:risk-assessment-engine a owl:Class ;
    rdfs:label "Risk Assessment Engine"@en ;
    rdfs:comment "A risk assessment engine is a software component that automatically evaluates the risk associated with transactions, shipments, or entities by applying rules, statistical models, or machine learning to available data. In customs and trade systems it scores consignments to prioritise inspection while expediting low-risk flows. It enables consistent, scalable, and auditable risk-based decision making."@en ;
    rdfs:subClassOf ngm:infra-software-engineering ;
    skos:broader ngm:infra-software-engineering ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:customs-trade-facilitation,
        ngm:risk-assessment-methodology ;
    vc:slug "risk-assessment-engine" ;
    vc:sourceDomain "supply-chain" .

ngm:risk-based-regulation a owl:Class ;
    rdfs:label "Risk Based Regulation"@en ;
    rdfs:comment "Risk-Based Regulation is a regulatory methodology that calibrates the intensity of oversight, compliance requirements, and enforcement action to the assessed level of risk posed by regulated entities or activities. Rather than applying uniform rules to all actors, risk-based approaches tier obligations by factors such as likelihood of harm, severity of potential impact, and the capacity of regulated parties to manage risk. It is the foundational approach of the EU AI Act, financial services regulation, and many modern safety frameworks."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:impact-assessment ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:risk-assessment ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:conformity-assessment ],
        ngm:governance ;
    vc:bridgesTo ngm:standards ;
    vc:contrastsWith ngm:prescriptive-regulation,
        ngm:principles-based-regulation ;
    vc:enables ngm:compliance-automation,
        ngm:innovation-policy,
        ngm:responsible-ai ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:conformity-assessment,
        ngm:risk-classification ;
    vc:implements ngm:ai-governance,
        ngm:regulatory-compliance ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:eu-ai-act,
        ngm:policy,
        ngm:proportionality-principle,
        ngm:risk-management ;
    vc:requires ngm:impact-assessment,
        ngm:risk-assessment ;
    vc:slug "risk-based-regulation" ;
    vc:sourceDomain "governance" ;
    vc:standardizedBy ngm:iso-31000 ;
    vc:supports ngm:ai-safety,
        ngm:data-governance .

ngm:risk-classification a skos:Concept ;
    rdfs:label "Risk Classification"@en .

ngm:risk-intensity-heatmap-regression a owl:Class ;
    rdfs:label "Heatmap Regression"@en ;
    rdfs:comment "Heatmap regression is a computer-vision technique for keypoint localisation in which a network predicts a 2D probability map per landmark rather than directly regressing coordinates. The peak of each predicted heatmap indicates the most likely location, and Gaussian-blurred ground-truth targets make training spatially smooth and robust. It is the dominant approach for human pose estimation and facial landmark detection."@en ;
    rdfs:subClassOf ngm:computer-vision ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:pose-estimation ;
    vc:slug "heatmap-regression" ;
    vc:sourceDomain "ai" .

ngm:rmsprop a skos:Concept ;
    rdfs:label "Rmsprop"@en .

ngm:roblox a owl:Class ;
    rdfs:label "Roblox"@en ;
    rdfs:comment "Roblox is an online platform and storefront that lets users create, publish and play user-generated 3D experiences. It combines a game engine, an authoring environment and a social and economic layer, with creators building experiences that other users can enter as customisable avatars. An in-platform virtual currency underpins a creator economy in which developers monetise their experiences. Roblox is frequently cited as a consumer-scale realisation of metaverse concepts, blending gaming, social interaction and user-generated content."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:game-engine ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:game-development ],
        ngm:metaverse-platform ;
    vc:bridgesTo ngm:social-platform ;
    vc:contrastsWith ngm:the-sandbox ;
    vc:enables ngm:virtual-economy ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:game-engine ;
    vc:implements ngm:virtual-world ;
    vc:isPartOf ngm:metaverse ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:gaming,
        ngm:metaverse-platform,
        ngm:virtual-world ;
    vc:requires ngm:game-development ;
    vc:slug "roblox" ;
    vc:sourceDomain "metaverse" ;
    vc:supports ngm:avatar,
        ngm:creator-economy ;
    vc:uses ngm:game-engine .

ngm:robot-navigation a owl:Class ;
    rdfs:label "Robot Navigation"@en ;
    rdfs:comment "Robot navigation is the capability of a mobile robot to determine its position, plan a route, and move safely through an environment toward a goal while avoiding obstacles. It integrates localisation, mapping, path planning, and motion control into a continuous perception-action loop. Robot navigation combines sensor fusion with algorithms such as SLAM to operate in unknown or dynamic surroundings."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:path-planning ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:mapping ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:localization ],
        ngm:robotics ;
    skos:broader ngm:robotics ;
    vc:dependsOn ngm:environmental-mapping,
        ngm:robot-perception ;
    vc:enables ngm:autonomous-navigation,
        ngm:mobile-robot ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:motion-planning ;
    vc:isPartOf ngm:robotics ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:path-planning ;
    vc:requires ngm:localization,
        ngm:mapping,
        ngm:path-planning ;
    vc:slug "robot-navigation" ;
    vc:sourceDomain "robotics" ;
    vc:supports ngm:manipulation,
        ngm:wheeled-mobile-robot ;
    vc:uses ngm:lidar,
        ngm:odometry,
        ngm:sensor-fusion,
        ngm:slam .

ngm:robot-programming a owl:Class ;
    rdfs:label "Robot Programming"@en ;
    rdfs:comment "Robot programming is the discipline of specifying the tasks, motions, and decision logic that a robot executes, ranging from low-level joint commands to high-level behavioural goals. It encompasses textual programming languages, graphical and teach-by-demonstration interfaces, and middleware frameworks that connect perception, planning, and actuation. The aim is to translate human intent into reliable, repeatable robot behaviour while respecting safety, timing, and hardware constraints."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:forward-kinematics ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:robot-control ],
        ngm:robotics ;
    skos:broader ngm:robotics ;
    vc:bridgesTo ngm:autonomous-vehicle ;
    vc:dependsOn ngm:sensor-fusion ;
    vc:enables ngm:industrial-robot,
        ngm:motion-planning,
        ngm:trajectory-planning ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:robotics ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:digital-twin,
        ngm:robot-operating-system,
        ngm:simulation ;
    vc:requires ngm:forward-kinematics,
        ngm:robot-control ;
    vc:slug "robot-programming" ;
    vc:sourceDomain "robotics" ;
    vc:supports ngm:automation,
        ngm:robot-control,
        ngm:robotic-manipulation ;
    vc:uses ngm:programming-language,
        ngm:robot-operating-system .

ngm:robotics-simulation a owl:Class ;
    rdfs:label "Robotics Simulation"@en ;
    rdfs:comment "Robotics simulation is the discipline of creating high-fidelity virtual worlds in which robots and their environments are modelled for development, testing, and synthetic-data generation. It emphasises scene description, physically based rendering, and interoperable asset pipelines so simulated environments transfer faithfully to deployment. Standards such as Universal Scene Description enable shared, composable simulation scenes across tools."@en ;
    rdfs:subClassOf ngm:robotics ;
    skos:broader ngm:robotics ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:procedural-and-hybrid-4-d,
        ngm:universal-scene-description ;
    vc:slug "robotics-simulation" ;
    vc:sourceDomain "robotics" .

ngm:ros-industrial a owl:Class ;
    rdfs:label "ROS-Industrial"@en ;
    rdfs:comment "ROS-Industrial is an open-source project that extends the Robot Operating System with libraries, drivers, and interfaces for industrial manufacturing automation. It provides standardised drivers for industrial robot arms, motion-planning integration, and tools to bring advanced ROS capabilities into factory settings. It bridges research-grade robotics software with production-grade industrial hardware."@en ;
    rdfs:subClassOf ngm:robotics ;
    skos:broader ngm:robotics ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:industrial-robot,
        ngm:robot-standard ;
    vc:slug "ros-industrial" ;
    vc:sourceDomain "robotics" .

ngm:round-trip-time a skos:Concept ;
    rdfs:label "Round Trip Time"@en .

ngm:rsa-algorithm a owl:Class ;
    rdfs:label "Rsa Algorithm"@en ;
    rdfs:comment "The RSA algorithm is a public-key cryptosystem whose security rests on the practical difficulty of factoring the product of two large prime numbers. A public key derived from this product encrypts data or verifies signatures, while the corresponding private key, recoverable only with knowledge of the prime factors, decrypts or signs. RSA was among the first practical asymmetric schemes and remains widely used for key exchange, digital signatures, and certificate-based authentication."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:key-pair ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:key-pair ],
        ngm:public-key-cryptography ;
    vc:bridgesTo ngm:cryptographic-algorithm ;
    vc:contrastsWith ngm:symmetric-encryption ;
    vc:dependsOn ngm:one-way-function,
        ngm:trapdoor-function ;
    vc:enables ngm:digital-signature,
        ngm:key-exchange ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:key-pair ;
    vc:implements ngm:asymmetric-encryption ;
    vc:isPartOf ngm:public-key-cryptography ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:private-key,
        ngm:public-key ;
    vc:requires ngm:key-pair ;
    vc:slug "rsa-algorithm" ;
    vc:sourceDomain "security" ;
    vc:supports ngm:ssl-tls ;
    vc:uses ngm:modular-arithmetic,
        ngm:one-way-function .

ngm:rsa-signature a owl:Class ;
    rdfs:label "RSA Signature"@en ;
    rdfs:comment "An RSA signature is a digital signature scheme built on the RSA public-key cryptosystem, where a message digest is signed with the holder's private exponent and verified with the corresponding public exponent and modulus. Security rests on the difficulty of factoring large composite integers, and practical deployments use padding schemes such as PKCS#1 v1.5 or PSS together with a cryptographic hash function. RSA signatures are widely used for certificate authorities, code signing, and transport-layer authentication, though they produce larger keys and signatures than elliptic-curve alternatives."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptographic-hash-function ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:public-key-cryptography ],
        ngm:digital-signature ;
    vc:bridgesTo ngm:security ;
    vc:contrastsWith ngm:ecdsa,
        ngm:post-quantum-cryptography ;
    vc:enables ngm:code-signing,
        ngm:digital-signature ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:isPartOf ngm:public-key-cryptography ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:cryptographic-signature,
        ngm:key-exchange ;
    vc:requires ngm:cryptographic-hash-function,
        ngm:public-key-cryptography ;
    vc:slug "rsa-signature" ;
    vc:sourceDomain "security" ;
    vc:supports ngm:certificate-authority ;
    vc:uses ngm:cryptographic-hash-function .

