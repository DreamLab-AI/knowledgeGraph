ngm:secure-multi-party-computation a owl:Class ;
    rdfs:label "Secure Multi-Party Computation"@en ;
    rdfs:comment "Secure Multi-Party Computation (MPC) is a cryptographic protocol enabling multiple parties to jointly compute functions over their combined private inputs without revealing individual inputs to other participants or third parties. Only the final output is disclosed; intermediate computations remain confidential. Key implementation techniques include secret sharing (Shamir), garbled circuits (Yao), and oblivious transfer primitives."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptographic-primitive ],
        ngm:cryptography ;
    vc:bridgesTo ngm:decentralised-finance,
        ngm:privacy-preserving-machine-learning ;
    vc:contrastsWith ngm:fully-homomorphic-encryption,
        ngm:trusted-execution-environment ;
    vc:enables ngm:differential-privacy,
        ngm:federated-learning,
        ngm:privacy-preserving-data-sharing,
        ngm:private-set-intersection,
        ngm:secure-aggregation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:garbled-circuit,
        ngm:oblivious-transfer,
        ngm:secret-sharing ;
    vc:isPartOf ngm:privacy-enhancing-computation-pec ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:privacy-enhancing-computation-pec,
        ngm:privacy-preserving-technology,
        ngm:threshold-cryptography ;
    vc:requires ngm:cryptographic-primitive,
        ngm:secure-channel ;
    vc:slug "secure-multi-party-computation" ;
    vc:sourceDomain "security" ;
    vc:uses ngm:cryptographic-protocol,
        ngm:homomorphic-encryption,
        ngm:shamir-secret-sharing,
        ngm:yao-s-garbled-circuits,
        ngm:zero-knowledge-proof .

ngm:distributed-storage a owl:Class ;
    rdfs:label "Distributed Storage"@en ;
    rdfs:comment "Distributed storage is a class of storage system architecture in which data is partitioned, replicated, and managed across multiple physically separate nodes or clusters to achieve scalability, fault tolerance, and high availability beyond the capacity of any single machine. Such systems employ replication protocols, erasure coding, consistent hashing, and distributed consensus algorithms to maintain data integrity and consistency under node failure, network partition, and concurrent access. Examples include object stores such as Amazon S3, distributed file systems such as HDFS and Ceph, and NewSQL databases with sharded storage layers."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:fault-tolerance ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:data-replication ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:storage-layer ],
        ngm:distributed-system ;
    vc:enables ngm:data-management,
        ngm:high-availability,
        ngm:machine-learning-discipline-infrastructure,
        ngm:scalable-architecture ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:data-replication,
        ngm:fault-tolerance,
        ngm:storage-layer ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:cloud-infrastructure,
        ngm:data-storage,
        ngm:distributed-systems ;
    vc:slug "distributed-storage" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:data-lake,
        ngm:data-pipeline,
        ngm:training-data ;
    vc:uses ngm:data-compression,
        ngm:data-integrity,
        ngm:network-infrastructure .

ngm:erc-20 a owl:Class ;
    rdfs:label "ERC-20"@en ;
    rdfs:comment "ERC-20 is the Ethereum Request for Comments token standard that defines a mandatory six-function interface — totalSupply, balanceOf, transfer, transferFrom, approve, and allowance — plus optional name, symbol, and decimals metadata, enabling any conformant fungible token to interoperate seamlessly with wallets, decentralised exchanges, and smart-contract protocols without bespoke integration. Proposed by Fabian Vogelsteller and Vitalik Buterin in November 2015 and formalised as Ethereum Improvement Proposal 20 (EIP-20), it became the foundational primitive of the DeFi ecosystem and the predominant format for utility tokens, governance tokens, stablecoins, and wrapped assets. The standard defines a delegated-transfer pattern via approve and transferFrom that allows smart contracts to spend tokens on a holder's behalf, and it underpins the liquidity infrastructure of all major decentralised exchanges, lending protocols, and yield-aggregators on EVM-compatible networks."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:smart-contract ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:fungible-token ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:solidity ],
        ngm:token-standard ;
    vc:bridgesTo ngm:on-chain-governance,
        ngm:tokenisation ;
    vc:contrastsWith ngm:erc-1155,
        ngm:erc-721,
        ngm:erc-777,
        ngm:spl-token ;
    vc:enables ngm:decentralised-exchange,
        ngm:decentralised-finance,
        ngm:governance-token,
        ngm:liquidity-pool,
        ngm:stablecoin ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:fungible-token,
        ngm:smart-contract ;
    vc:implements ngm:ethereum-improvement-proposal ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:erc-2612,
        ngm:token-approval,
        ngm:wrapped-token ;
    vc:requires ngm:ethereum-virtual-machine,
        ngm:solidity ;
    vc:slug "erc-20" ;
    vc:sourceDomain "blockchain" ;
    vc:standardizedBy ngm:ethereum-foundation ;
    vc:supports ngm:automated-market-maker,
        ngm:token-composability ;
    vc:uses ngm:ethereum,
        ngm:evm-compatible-network .

ngm:graph-database a owl:Class ;
    rdfs:label "Graph Database"@en ;
    rdfs:comment "A Graph Database is a specialised data management system representing data as a network of nodes (vertices) connected by relationships (edges) carrying their own properties and semantics, contrasted with relational databases that scatter relationships across foreign-key joins, organised aroun..."@en ;
