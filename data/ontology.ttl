    vc:implements ngm:byzantine-fault-tolerance,
        ngm:nakamoto-consensus ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:blockchain,
        ngm:distributed-ledger,
        ngm:mining ;
    vc:requires ngm:consensus-protocol,
