    vc:sourceDomain "spatial-computing" .

vf:cyber-security-and-cryptography a owl:Class ;
    rdfs:label "Cyber Security and Cryptography"@en ;
    rdfs:comment "Cyber Security and Cryptography is the integrated discipline governing the confidentiality, integrity, availability, and authenticity of digital information systems through mathematical cryptographic primitives, protocol engineering, and systemic security architecture. The field bifurcates into two tightly coupled branches: **applied cryptography** — providing provably secure mathematical constructions formalised via indistinguishability (IND-CPA, IND-CCA2), existential unforgeability (EUF-CMA), and authenticated key exchange (Bellare-Rogaway model); and **operational cybersecurity** — addressing the adversarial environment in which cryptographic systems are deployed. Symmetric cryptography furnishes the data-plane protection layer: AES-256-GCM (NIST FIPS 197, AEAD, 10-40 Gbps with AES-NI hardware acceleration; ARMv8 Crypto Extension achieving 2-8 Gbps on Cortex-A55/A78 SoC); ChaCha20-Poly1305 (RFC 8439, TLS 1.3 and WireGuard, preferred where AES hardware is absent); AES-256-XTS (IEEE Std 1619-2007, full-disk encryption at 4-7 GB/s inline on NVMe TCG Opal 2.0 drives); BLAKE3 (2020, 14 GB/s x86, tree-structured parallelism)."@en ;
    rdfs:subClassOf <urn:visionflow:linked:applied-mathematics>,
        <urn:visionflow:linked:network-security>,
        <urn:visionflow:linked:systems-engineering>,
        vf:information-security,
        vf:risk-management ;
    vc:authorityScore "0.87"^^xsd:float ;
    vc:enables <urn:visionflow:linked:authentication>,
        <urn:visionflow:linked:data-confidentiality>,
        <urn:visionflow:linked:data-integrity>,
        <urn:visionflow:linked:digital-sovereignty>,
        <urn:visionflow:linked:privacy-engineering>,
        <urn:visionflow:linked:secure-communication>,
        <urn:visionflow:linked:supply-chain-security>,
        vf:non-repudiation,
        vf:regulatory-compliance ;
    vc:hasPart <urn:visionflow:linked:certificate-authority>,
        <urn:visionflow:linked:hardware-security-module>,
        <urn:visionflow:linked:homomorphic-encryption>,
        <urn:visionflow:linked:identity-and-access-management>,
        <urn:visionflow:linked:key-management>,
        <urn:visionflow:linked:secure-enclave>,
        <urn:visionflow:linked:security-operations-centre>,
        <urn:visionflow:linked:threat-intelligence>,
        <urn:visionflow:linked:transport-layer-security>,
        <urn:visionflow:linked:zero-trust-architecture>,
        vf:digital-signature,
        vf:post-quantum-cryptography,
        vf:public-key-infrastructure,
        vf:secure-multi-party-computation ;
    vc:implements <urn:visionflow:linked:aes-gcm>,
        <urn:visionflow:linked:cha-cha20-poly1305>,
        <urn:visionflow:linked:fido2>,
        <urn:visionflow:linked:homomorphic-encryption>,
        <urn:visionflow:linked:signal-protocol>,
        <urn:visionflow:linked:threshold-signatures>,
        <urn:visionflow:linked:tls-1-3>,
        <urn:visionflow:linked:zero-knowledge-proofs>,
        <urn:visionflow:linked:zero-trust-architecture>,
        vf:post-quantum-cryptography,
        vf:secure-multi-party-computation ;
    vc:maturity "production-ready" ;
    vc:qualityScore "0.52"^^xsd:float ;
    vc:requires <urn:visionflow:linked:certificate-authority>,
        <urn:visionflow:linked:cryptographic-primitives>,
        <urn:visionflow:linked:entropy>,
        <urn:visionflow:linked:hardware-security-module>,
        <urn:visionflow:linked:threat-model>,
        <urn:visionflow:linked:trusted-execution-environment>,
        <urn:visionflow:linked:vulnerability-management> ;
    vc:slug "cyber-security-and-cryptography" ;
    vc:sourceDomain "infrastructure" .

vf:cyber-security-and-military a owl:Class ;
    rdfs:label "Cyber Security and Military"@en ;
    rdfs:comment "Cyber Security and Military denotes the doctrinal, organisational, technical and operational fusion of cyberspace as a recognised warfighting domain alongside land, sea, air and space — codified by NATO at the 2016 Warsaw Summit declaration that cyberspace is \"a domain of operations in which NATO must defend itself as effectively as it does in the air, on land, and at sea\" and reaffirmed by the 2022 Strategic Concept and 2023 Vilnius Communiqué endorsement of the Virtual Cyber Incident Support Capability (VCISC) — encompassing the spectrum of state-level activities (defensive cyberspace operations DCO, offensive cyberspace operations OCO, intelligence preparation of the cyber environment, computer network exploitation CNE, information operations IO, electromagnetic spectrum operations) conducted by uniformed military commands (US Cyber Command USCYBERCOM elevated to unified combatant command 2018 with 133-team Cyber Mission Force CMF reaching full operational capability 2018 and authorised end strength ~6,200 personnel growing to 14,000 by 2028 under CYBERCOM 2.0; UK National Cyber Force NCF stood up 2020 as a partnership between GCHQ/MOD/SIS/Dstl with permanent HQ at Samlesbury La"@en ;
    rdfs:subClassOf <urn:visionflow:linked:cyber-operations>,
        <urn:visionflow:linked:defence-capability>,
        <urn:visionflow:linked:national-security-capability>,
        <urn:visionflow:linked:state-sponsored-activity>,
        <urn:visionflow:linked:warfighting-domain> ;
    vc:authorityScore "0.87"^^xsd:float ;
    vc:enables <urn:visionflow:linked:adversary-intelligence-collection>,
        <urn:visionflow:linked:battle-damage-assessment>,
        <urn:visionflow:linked:critical-infrastructure-disruption>,
        <urn:visionflow:linked:cyber-deterrence>,
        <urn:visionflow:linked:hybrid-warfare>,
        <urn:visionflow:linked:joint-all-domain-operations>,
        <urn:visionflow:linked:strategic-coercion> ;
    vc:hasPart <urn:visionflow:linked:computer-network-exploitation>,
        <urn:visionflow:linked:cyber-intelligence>,
        <urn:visionflow:linked:cyber-mission-force>,
        <urn:visionflow:linked:defensive-cyber-operations>,
        <urn:visionflow:linked:electromagnetic-spectrum-operations>,
        <urn:visionflow:linked:information-operations>,
        <urn:visionflow:linked:national-cyber-force>,
        <urn:visionflow:linked:offensive-cyber-operations> ;
    vc:implements <urn:visionflow:linked:computer-network-operations-doctrine>,
        <urn:visionflow:linked:defend-forward>,
        <urn:visionflow:linked:f3-ead-targeting>,
        <urn:visionflow:linked:joint-targeting-cycle>,
        <urn:visionflow:linked:law-of-armed-conflict>,
        <urn:visionflow:linked:persistent-engagement>,
        <urn:visionflow:linked:tallinn-manual-rules> ;
    vc:maturity "production-ready" ;
    vc:qualityScore "0.52"^^xsd:float ;
    vc:requires <urn:visionflow:linked:attribution-capability>,
        <urn:visionflow:linked:classified-compute-infrastructure>,
        <urn:visionflow:linked:cyber-doctrine>,
        <urn:visionflow:linked:signals-intelligence>,
        <urn:visionflow:linked:sovereign-authority>,
        <urn:visionflow:linked:trained-cyber-operators>,
        <urn:visionflow:linked:vulnerability-research> ;
    vc:slug "cyber-security-and-military" ;
    vc:sourceDomain "security" .

vf:cybersecurity-standard a owl:Class ;
    rdfs:label "Cybersecurity Standard"@en ;
    rdfs:comment "Cybersecurity standard addresses digital security threats to robot systems through standardised practices for vulnerability assessment, secure communications, authentication, and incident response. These standards protect robots from remote exploitation, data theft, and malicious control whilst maintaining operational availability in safety-critical deployments."@en ;
    rdfs:subClassOf <urn:visionflow:linked:security-standards>,
        vf:robot-standard ;
    vc:authorityScore "0.95"^^xsd:float ;
    vc:enables <urn:visionflow:linked:compliance-assurance>,
