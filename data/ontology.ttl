ngm:mining a owl:Class ;
    rdfs:label "Mining"@en ;
    rdfs:comment "Mining is the proof-of-work block-creation process in which participating nodes compete to solve a cryptographic hash puzzle, with the winner appending the next block to the chain and receiving a block reward. Mining provides Sybil resistance, ensures probabilistic finality, and anchors chain security to real-world energy expenditure."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:mining-reward ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:block-reward ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:mining-pool ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:bitcoin-mining ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:nonce ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:network-hash-rate ],
        ngm:bc-protocol-and-consensus,
        ngm:blockchain-entity,
        ngm:consensus-protocol ;
    skos:broader ngm:bc-protocol-and-consensus ;
    vc:contrastsWith ngm:proof-of-stake ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:bitcoin-mining,
        ngm:block-reward,
        ngm:mining-pool,
        ngm:mining-reward,
        ngm:network-hash-rate,
        ngm:nonce ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:blockchain-energy-consumption,
        ngm:nakamoto-consensus,
        ngm:probabilistic-finality ;
    vc:slug "mining" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:proof-of-work .

ngm:neural-network-architecture a owl:Class ;
    rdfs:label "Neural Network Architecture"@en ;
    rdfs:comment "Neural network architecture defines the structural organisation of artificial neurons into layers and the connectivity patterns between them, determining how a network processes and transforms input data through weighted connections and activation functions. Different architectural families — feedforward, convolutional, recurrent, and transformer — embody distinct inductive biases suited to different data modalities and task types. Architectural choices govern capacity, training stability, and generalisation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:recurrent-neural-network ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:transformer-architecture ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gradient-descent ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:activation-function ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:dropout ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:backpropagation ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:attention-mechanism ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:loss-function ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:convolutional-neural-network ],
        ngm:ai-model-architecture ;
    skos:broader ngm:ai-model-architecture ;
