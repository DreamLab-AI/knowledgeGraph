ngm:spatial-user-interfaces a owl:Class ;
    rdfs:label "Spatial User Interfaces"@en ;
    rdfs:comment "Three-dimensional interaction systems enabling users to engage with digital content through spatially-aware mods including hand gestures, gaze tracking, and voice commands, designed for natural movement within AR, VR, and mixed reality environments with consideration for user comfort zones and 6D..."@en ;
