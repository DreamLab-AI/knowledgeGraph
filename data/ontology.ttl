ngm:inverse-kinematics a owl:Class ;
    rdfs:label "Inverse Kinematics"@en ;
    rdfs:comment "The process of determining the joint parameters (angles or displacements) required to place a robot's end-effector at a desired position and orientation in Cartesian space. It maps from task space to joint space."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:kinematic-model ],
        ngm:kinematics,
