    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires ngm:risk-assessment,
        ngm:safety-certification ;
    vc:slug "cobot-safety-levels" ;
    vc:sourceDomain "robotics" .

ngm:cognitive-science a owl:Class ;
    rdfs:label "Cognitive Science"@en ;
    rdfs:comment "Cognitive Science is an interdisciplinary field studying the nature of mind, intelligence, and cognition, encompassing perception, memory, language, reasoning, and decision-making through contributions from psychology, neuroscience, linguistics, philosophy, and artificial intelligence. Its models of human cognition directly inform the design of AI systems, user interfaces, and human-computer interaction paradigms."@en ;
    rdfs:subClassOf ngm:infra-software-engineering ;
    skos:broader ngm:infra-software-engineering ;
    vc:enables ngm:cognitive-ai,
        ngm:human-computer-interaction ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:artificial-intelligence,
        ngm:cognitive-architecture ;
    vc:slug "cognitive-science" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:machine-learning .

ngm:conflict-resolution a owl:Class ;
    rdfs:label "Conflict Resolution"@en ;
    rdfs:comment "Conflict Resolution encompasses the structured methods, protocols, and mechanisms used to identify, address, and settle disputes between parties, whether human individuals, organisations, autonomous agents, or distributed systems. In technical contexts, it includes algorithmic approaches for resolving inconsistencies in distributed data systems, consensus protocols that reconcile divergent states, and governance frameworks for mediating disagreements in decentralised organisations. In social and legal contexts it spans negotiation, mediation, arbitration, and adjudication, with increasing automation and AI-assisted facilitation. Across both domains, effective conflict resolution preserves relationships, maintains system integrity, and enables continued collaboration."@en ;
    rdfs:subClassOf ngm:dispute-resolution-mechanism ;
    vc:enables ngm:community-governance-model,
        ngm:decentralized-governance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:arbitration-decision-engine,
        ngm:arbitration-process,
        ngm:consensus-mechanism ;
    vc:slug "conflict-resolution" ;
    vc:sourceDomain "governance" ;
    vc:supports ngm:multi-agent-systems ;
    vc:uses ngm:dao-governance,
        ngm:smart-contract-coordination .

ngm:cross-platform-identity a owl:Class ;
    rdfs:label "Cross-Platform Identity"@en ;
    rdfs:comment "Cross-platform identity refers to the capability of linking and managing a user's electronic identity and attributes across multiple distinct systems, platforms, and organisational boundaries."@en ;
    rdfs:subClassOf ngm:identity-management,
        ngm:infra-security-and-identity ;
