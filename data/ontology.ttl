ngm:model-transparency a owl:Class ;
    rdfs:label "Model Transparency"@en ;
    rdfs:comment "The capability to understand, explain, and interpret the decision-making processes within AI and machine learning models, encompassing explainability, interpretability, and accountability requirements essential for responsible AI deployment."@en ;
