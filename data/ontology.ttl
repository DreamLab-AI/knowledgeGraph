ngm:stakeholder-engagement a owl:Class ;
    rdfs:label "Stakeholder Engagement"@en ;
    rdfs:comment "Stakeholder Engagement is the structured process through which organisations identify, communicate with, and incorporate the perspectives of individuals and groups who have interests in or are affected by a project, system, or policy. Effective engagement moves along a spectrum from one-way information provision through consultation to active co-design and ongoing collaborative governance. In the context of emerging technologies such as AI, robust stakeholder engagement is recognised as essential for identifying ethical risks, ensuring societal legitimacy, and building the trust necessary for adoption. Regulatory frameworks and voluntary standards increasingly mandate evidence of meaningful stakeholder engagement as a condition of approval or certification."@en ;
    rdfs:subClassOf ngm:stakeholder ;
    vc:enables ngm:ai-governance-framework,
        ngm:change-management,
        ngm:collaborative-design ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:civic-participation,
        ngm:community-governance,
        ngm:democratic-participation,
        ngm:stakeholder-engagement-in-ai ;
    vc:slug "stakeholder-engagement" ;
    vc:sourceDomain "governance" ;
    vc:uses ngm:ai-impact-assessment,
        ngm:risk-assessment .

ngm:state-synchronization a owl:Class ;
    rdfs:label "State Synchronization"@en ;
    rdfs:comment "The process of maintaining consistent, coherent representations of virtual world state across distributed clients, servers, and edge nodes through continuous replication, conflict resolution, and consistency protocols."@en ;
    rdfs:subClassOf ngm:distributed-system-architecture,
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
