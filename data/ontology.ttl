        ngm:feature-matching,
        ngm:image-pyramid .

ngm:payment-processor a owl:Class ;
    rdfs:label "Payment Processor"@en ;
    rdfs:comment "A payment processor is a service that handles the transaction lifecycle between a merchant, the customer's payment instrument, and the settlement networks. It authorises, captures, clears, and settles funds while applying fraud checks, currency conversion, and compliance controls. Processors are foundational components of digital payment infrastructure, abstracting card networks, bank rails, and blockchain settlement behind a single integration."@en ;
    rdfs:subClassOf ngm:infra-computing-and-cloud ;
    skos:broader ngm:infra-computing-and-cloud ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:digital-payments,
        ngm:payment-infrastructure ;
    vc:slug "payment-processor" ;
    vc:sourceDomain "infrastructure" .

ngm:pedersen-commitment a owl:Class ;
    rdfs:label "Pedersen Commitment"@en ;
    rdfs:comment "A Pedersen commitment is a cryptographic commitment scheme in which a committer binds to a secret value v by computing C = g^v * h^r, where g and h are independent group generators and r is a random blinding factor. The scheme is computationally binding under the discrete logarithm assumption and unconditionally (information-theoretically) hiding, meaning an adversary with unlimited computation cannot determine the committed value from C alone. Crucially, Pedersen commitments are additively homomorphic: the product of two commitments C(v1, r1) * C(v2, r2) equals C(v1+v2, r1+r2), enabling arithmetic on committed values without revealing them. This property makes Pedersen commitments foundational to confidential transactions, range proofs, and zero-knowledge proof systems."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:elliptic-curve-cryptography ],
        ngm:cryptographic-commitment ;
    vc:bridgesTo ngm:blockchain-privacy,
        ngm:monero ;
    vc:contrastsWith ngm:elgamal-encryption,
        ngm:hash-commitment ;
    vc:enables ngm:bulletproofs,
        ngm:confidential-transaction,
        ngm:range-proof,
        ngm:secure-multiparty-computation,
        ngm:zero-knowledge-proof ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:commitment-scheme,
        ngm:homomorphic-encryption ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:non-interactive-zero-knowledge,
        ngm:schnorr-protocol,
        ngm:sigma-protocol ;
    vc:requires ngm:discrete-logarithm-problem,
        ngm:elliptic-curve-cryptography,
        ngm:random-oracle ;
    vc:slug "pedersen-commitment" ;
    vc:sourceDomain "security" ;
    vc:supports ngm:digital-signature,
        ngm:privacy-preserving-protocol,
        ngm:verifiable-secret-sharing ;
    vc:uses ngm:blinding-factor,
        ngm:elliptic-curve-group,
        ngm:group-generator .

ngm:perception-module a owl:Class ;
    rdfs:label "Perception Module"@en ;
    rdfs:comment "A perception module is the component of an autonomous or cognitive agent that transforms raw sensory input into structured representations of the environment. It performs sensing, filtering, feature extraction, object detection, and state estimation to produce a world model usable by planning and control. As the agent's interface to reality, its accuracy bounds the quality of all downstream decisions."@en ;
    rdfs:subClassOf ngm:ai-infrastructure ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:autonomous-agent,
        ngm:cognitive-ai ;
    vc:slug "perception-module" ;
    vc:sourceDomain "ai" .

ngm:performance-benchmarks a owl:Class ;
    rdfs:label "Performance Benchmarks"@en ;
    rdfs:comment "Performance benchmarks are standardised, reproducible test suites and associated metric sets used to measure, compare, and rank the behavioural characteristics of software systems, hardware platforms, algorithms, or AI models under controlled or representative workload conditions. They quantify dimensions such as latency, throughput, resource utilisation, scalability, accuracy, and energy efficiency, enabling objective evaluation across vendors, versions, and deployment environments. Benchmark suites range from micro-benchmarks targeting isolated components to macro-benchmarks simulating realistic end-to-end workloads. Formal benchmark governance — through bodies such as SPEC, MLCommons, and TPC — establishes methodology rules, disclosure requirements, and result auditing to prevent benchmark gaming."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:observability ],
        ngm:software-testing ;
    vc:bridgesTo ngm:ai-model-evaluation,
        ngm:hardware-acceleration ;
    vc:contrastsWith ngm:stress-testing,
        ngm:unit-testing ;
    vc:dependsOn ngm:metrics-collection,
        ngm:statistical-analysis ;
    vc:enables ngm:capacity-planning,
        ngm:performance-optimization,
        ngm:vendor-evaluation ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:latency-measurement,
        ngm:resource-utilisation,
        ngm:throughput-measurement,
        ngm:workload-profiling ;
    vc:implements ngm:mlperf,
        ngm:spec-benchmarks ;
    vc:isPartOf ngm:quality-assurance,
        ngm:software-testing ;
    vc:qualityScore "0.73"^^xsd:float ;
    vc:relatedTo ngm:continuous-integration,
        ngm:service-level-objectives ;
    vc:requires ngm:load-testing,
        ngm:observability,
        ngm:profiling ;
    vc:slug "performance-benchmarks" ;
    vc:sourceDomain "infrastructure" ;
    vc:standardizedBy ngm:mlcommons,
        ngm:spec,
        ngm:tpc ;
    vc:uses ngm:reproducible-experiments,
        ngm:time-series-data .

ngm:pharmaceutical-supply-chain a owl:Class ;
    rdfs:label "Pharmaceutical Supply Chain"@en ;
    rdfs:comment "The Pharmaceutical Supply Chain encompasses all entities, processes, and systems involved in the production, storage, distribution, and dispensing of medicinal products, from active pharmaceutical ingredient (API) synthesis through to patient delivery. It is subject to stringent regulatory serialisation and traceability requirements designed to prevent counterfeit medicines from entering the legitimate supply chain."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
