ngm:database-system a owl:Class ;
    rdfs:label "Database System"@en ;
    rdfs:comment "A database system (DBMS - Database Management System) is software that enables users to define, create, maintain, and control access to structured collections of data."@en ;
    rdfs:subClassOf ngm:infra-data-management ;
    skos:broader ngm:infra-data-management ;
