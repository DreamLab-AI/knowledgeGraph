    vc:isPartOf ngm:ai-transparency-framework ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:content-authentication,
        ngm:metadata-standards,
        ngm:provenance-tracking ;
    vc:slug "ai-generated-content-disclosure" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:ai-governance-law-and-privacy a owl:Class ;
    rdfs:label "AI Governance Law and Privacy"@en ;
    rdfs:comment "The intersecting domain of political governance, legal frameworks, and individual privacy rights as they apply to AI and digital technologies. This cluster addresses how legislation (e.g., EU AI Act, GDPR), regulatory enforcement, and political economy shape what AI systems are permitted to do, how data about individuals is collected and used, and how citizens can exercise rights against automated decision-making and surveillance."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:digital-rights ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:algorithmic-accountability ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gdpr-compliance ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:data-protection ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:ai-regulation ],
        ngm:infra-legal-and-regulatory ;
    skos:broader ngm:infra-legal-and-regulatory ;
    vc:bridgesTo ngm:education-and-ai,
        ngm:supply-chain-transparency,
        ngm:trust-and-safety ;
    vc:contrastsWith ngm:digital-society-surveillance,
        ngm:surveillance-capitalism ;
    vc:dependsOn ngm:data-sovereignty,
        ngm:rule-of-law ;
    vc:enables ngm:access-to-justice,
        ngm:democratic-oversight-of-ai,
        ngm:trustworthy-ai ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:ai-liability-frameworks,
        ngm:ai-regulation,
        ngm:algorithmic-accountability,
        ngm:biometric-surveillance-regulation,
        ngm:data-protection,
        ngm:digital-rights ;
    vc:implements ngm:eu-ai-act,
        ngm:general-data-protection-regulation ;
    vc:isPartOf ngm:digital-governance ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:data-brokerage,
        ngm:facial-recognition-technology,
        ngm:intellectual-property-rights-framework,
        ngm:open-source-ai ;
    vc:requires ngm:fundamental-rights-impact-assessment,
        ngm:gdpr-compliance,
        ngm:regulatory-impact-assessment ;
    vc:slug "ai-governance-law-and-privacy" ;
    vc:sourceDomain "governance" ;
    vc:standardizedBy ngm:iso-iec-42001,
        ngm:nist-ai-rmf ;
    vc:supports ngm:civil-liberties,
        ngm:human-oversight ;
    vc:uses ngm:conformity-assessment,
        ngm:risk-classification .

ngm:ai-incident a owl:Class ;
    rdfs:label "AI Incident"@en ;
    rdfs:comment "An event in which an AI system causes or has the potential to cause harm to individuals, property, the environment, or fundamental rights, encompassing technical failures, security breaches, bias-driven discrimination, privacy violations, and unintended consequences. Under the EU AI Act Article 72, serious incidents must be reported to national competent authorities within 15 days; structured incident taxonomies and response protocols (detection, containment, investigation, remediation) are codified in ISO/IEC 23894:2023."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:accountability ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ai-risk-management ],
        ngm:ai-governance-and-ethics,
        ngm:ai-risk ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:enables ngm:ai-governance,
        ngm:responsible-ai ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:relatedTo ngm:ai-safety,
        ngm:bias,
        ngm:eu-ai-act-regulatory-instrument ;
    vc:requires ngm:accountability,
        ngm:ai-risk-management ;
    vc:slug "ai-incident" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:ai-model-inference-engine a owl:Class ;
    rdfs:label "AI Model Inference Engine"@en ;
    rdfs:comment "An AI model inference engine is the software runtime that executes a trained model to produce predictions from new inputs. It manages computation graph execution, hardware acceleration and memory to run models efficiently."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gpu ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
