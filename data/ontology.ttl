        ngm:securities-disclosure ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:crypto-assets-and-cyber-unit,
        ngm:division-of-enforcement ;
    vc:implements ngm:regulation-best-interest,
        ngm:securities-act-1933,
        ngm:securities-exchange-act ;
    vc:qualityScore "0.72"^^xsd:float ;
