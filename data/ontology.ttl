            owl:someValuesFrom ngm:real-time-rendering ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:virtual-camera ],
        ngm:production-facility,
        ngm:sc-platform-and-environment ;
