        ngm:cobot-deployment,
        ngm:human-robot-collaboration ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:rb-0091-safety-rated-monitored-stop,
        ngm:rb-0094-power-and-force-limiting,
        ngm:rb-0104-hand-guiding,
        ngm:rb-0105-speed-and-separation-monitoring ;
    vc:isPartOf ngm:iso-10218 ;
    vc:qualityScore "0.73"^^xsd:float ;
    vc:relatedTo ngm:ergonomics,
        ngm:eu-machinery-directive,
        ngm:industrial-automation,
        ngm:robot-safety ;
    vc:requires ngm:risk-assessment ;
    vc:slug "iso-ts-15066" ;
    vc:sourceDomain "robotics" ;
    vc:standardizedBy ngm:collaborative-systems-modality-robot,
        ngm:iso-tc-299 ;
    vc:supports ngm:functional-safety,
