        ngm:data-governance,
        ngm:open-banking ;
    vc:enables ngm:corporate-tax-compliance-framework ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:implements ngm:anti-money-laundering ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:fca,
        ngm:hm-treasury,
        ngm:regulatory-authority ;
    vc:requires ngm:digital-identity,
        ngm:financial-reporting ;
    vc:slug "hmrc" ;
    vc:sourceDomain "governance" ;
    vc:supports ngm:aml-kyc-compliance,
        ngm:financial-regulation .

