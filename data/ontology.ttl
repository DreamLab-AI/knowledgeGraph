    vc:dependsOn ngm:bitcoin-core,
        ngm:cryptographic-hash-function ;
    vc:enables ngm:confidential-transactions,
        ngm:federated-peg,
        ngm:lightning-network,
        ngm:sidechain ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:blockstream-amp,
        ngm:blockstream-satellite,
        ngm:core-lightning,
        ngm:liquid-network ;
    vc:implements ngm:elements-project,
