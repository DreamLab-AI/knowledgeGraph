    rdfs:label "Intelligent Character Recognition"@en .
ngm:intelligent-document-processing a skos:Concept ;
    rdfs:label "Intelligent Document Processing"@en .
ngm:intelligent-environment a owl:Class ;
    rdfs:comment "An intelligent environment is a physical or virtual space embedded with sensing, computation, and adaptive agents that perceive context and respond to occupants without explicit commands. In metaverse and ambient-computing settings it hosts autonomous agents and virtual entities that react to user presence, intent, and environmental state. It blends ubiquitous sensing with embodied AI to deliver context-aware, responsive experiences."@en ;
    rdfs:label "Intelligent Environment"@en ;
    rdfs:subClassOf ngm:virtual-environment ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:autonomous-agent ;
    vc:relatedTo ngm:intelligent-virtual-entity ;
    vc:slug "intelligent-environment" ;
    vc:sourceDomain "metaverse" .
ngm:intelligent-metaverse-systems a skos:Concept ;
    rdfs:label "Intelligent Metaverse Systems"@en .
ngm:intelligent-npc a owl:Class ;
    rdfs:comment "An Intelligent NPC (Non-Player Character) is a virtual agent in a game, simulation, or metaverse environment whose behaviour is driven by AI systems — typically combining perception, reasoning, planning, and natural-language interaction — rather than purely scripted or rule-based finite state machines. Modern intelligent NPCs leverage large language models for open-ended dialogue, reinforcement learning for adaptive combat and movement, and behavioural AI architectures (behaviour trees, goal-oriented action planning) to produce emergent, contextually appropriate responses to player actions and environmental stimuli. They form the interactive population of persistent virtual worlds and are central to immersive narrative experiences."@en ;
    rdfs:label "Intelligent NPC"@en ;
    rdfs:subClassOf ngm:digital-humans ;
