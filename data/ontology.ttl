ngm:image-editing a owl:Class ;
    rdfs:label "Image Editing"@en ;
    rdfs:comment "Image editing is the process of altering or enhancing digital images using software tools, encompassing operations such as colour correction, compositing, retouching, masking, and applying filters or effects. Modern image editing spans a spectrum from manual pixel-level manipulation to AI-driven automated transformations that interpret semantic content to intelligently modify or generate imagery."@en ;
    rdfs:subClassOf ngm:content-creation ;
    vc:enables ngm:content-creation-pipeline,
        ngm:digital-content-creation ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.8"^^xsd:float ;
