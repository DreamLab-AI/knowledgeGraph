    vc:uses ngm:merkle-tree .
ngm:ipfs-content-addressing a owl:Class ;
    rdfs:comment "The addressing scheme used by the InterPlanetary File System, in which content is identified by a cryptographic hash of its data rather than by location. The resulting content identifier changes if the content changes."@en ;
    rdfs:label "IPFS Content Addressing"@en ;
