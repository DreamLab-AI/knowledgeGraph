        ngm:semantic-search ;
    vc:slug "python-sample1" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:knowledge-graph,
        ngm:knowledge-management .

ngm:python-sample2 a owl:Class ;
    rdfs:label "Python Sample2"@en ;
    rdfs:comment "Python Sample2 is a minimal Logseq JavaScript/Pyodide evaluation block used as a stub execution test. It demonstrates the evalblock mechanism that allows inline code execution within the Logseq knowledge graph, serving as a baseline template for more complex Python integrations that interact with the Logseq Plugin API."@en ;
    rdfs:subClassOf ngm:infra-software-engineering ;
