ngm:nvidia-corporation-h-100 a owl:Class ;
    rdfs:label "NVIDIA H100"@en ;
    rdfs:comment "The NVIDIA H100 is a data-centre GPU accelerator built on the Hopper microarchitecture (GH100 die), designed for AI model training, large-scale inference, and high-performance computing workloads. It introduced a dedicated Transformer Engine with FP8 mixed-precision support, fourth-generation NVLink interconnect, and high-bandwidth HBM3 memory, enabling substantially faster training of large language models and other deep-learning workloads compared to its predecessor, the A100. The H100 is manufactured on TSMC N4 process technology and is available in PCIe and SXM5 form factors, the latter optimised for dense multi-GPU server nodes. Its combination of raw compute throughput and high-speed GPU-to-GPU interconnect made it the de-facto standard accelerator for generative AI infrastructure from 2023 onwards."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cuda ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:high-bandwidth-memory ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:nvlink ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:high-bandwidth-memory ],
        ngm:gpu ;
    vc:bridgesTo ngm:data-centre,
        ngm:foundation-model,
        ngm:generative-ai ;
    vc:contrastsWith ngm:tpu ;
    vc:dependsOn ngm:cuda ;
    vc:enables ngm:ai-inference,
        ngm:gpu-computing,
        ngm:high-performance-computing,
        ngm:large-language-model-training ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:high-bandwidth-memory,
        ngm:nvlink ;
    vc:implements ngm:mixed-precision-training,
        ngm:tensor-core ;
    vc:isPartOf ngm:gpu-cluster ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:ai-accelerator,
        ngm:nvidia-corporation ;
    vc:requires ngm:cuda,
        ngm:high-bandwidth-memory ;
    vc:slug "nvidia-h-100" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:infiniband .

