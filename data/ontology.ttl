ngm:fork-choice-rule a owl:Class ;
    rdfs:label "Fork Choice Rule"@en ;
    rdfs:comment "Algorithm by which blockchain nodes select the canonical chain head when multiple competing branches exist, resolving temporary forks deterministically. Bitcoin uses longest-chain (most cumulative proof-of-work) while Ethereum post-Merge uses the LMD-GHOST fork-choice weighted by validator attestation stake, determining network-wide finality."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:peer-discovery ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:block-propagation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:peer-to-peer-network ],
        ngm:bc-protocol-and-consensus ;
    skos:broader ngm:bc-protocol-and-consensus ;
    vc:bridgesTo ngm:distributed-consensus,
        ngm:fault-tolerant-protocol ;
    vc:contrastsWith ngm:lmd-ghost,
        ngm:longest-chain-rule ;
    vc:dependsOn ngm:block-header,
        ngm:chain-weight ;
    vc:enables ngm:blockchain-scalability,
        ngm:double-spend-prevention,
        ngm:finality,
        ngm:immutability ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:consensus-protocol,
        ngm:nakamoto-consensus ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:blockchain-protocol,
        ngm:byzantine-fault-tolerance,
        ngm:censorship-resistance,
        ngm:consensus-rule,
        ngm:network-partition-tolerance,
        ngm:selfish-mining ;
    vc:requires ngm:block-propagation,
        ngm:peer-discovery,
        ngm:peer-to-peer-network ;
    vc:slug "fork-choice-rule" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:consensus-algorithm,
        ngm:consensus-mechanism,
        ngm:proof-of-stake,
        ngm:proof-of-work,
        ngm:validator-attestation .

ngm:http-protocol a owl:Class ;
    rdfs:label "HTTP Protocol"@en ;
    rdfs:comment "The Hypertext Transfer Protocol (HTTP) is a stateless, application-layer request-response protocol that forms the foundation of data communication on the World Wide Web, defining the format and semantics of messages exchanged between clients (browsers, API consumers) and servers (web servers, API gateways) over TCP/IP connections. Each HTTP transaction consists of a request message specifying a method (GET, POST, PUT, DELETE, PATCH, HEAD, OPTIONS), a target URI, headers conveying metadata, and an optional body, followed by a response message containing a status code, headers, and an optional body. HTTP has evolved through versions 1.0, 1.1, 2, and 3, with each version improving multiplexing, compression, and connection management."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:client-server-architecture ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:http ],
        ngm:network-protocol ;
    vc:bridgesTo ngm:ai-agent ;
    vc:contrastsWith ngm:g-rpc ;
    vc:enables ngm:api-gateway,
        ngm:content-delivery-network-cdn,
        ngm:model-context-protocol,
        ngm:rest-api,
        ngm:server-sent-events,
        ngm:web-application,
        ngm:web-socket-protocol ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:http,
        ngm:http-header,
        ngm:http-status-code ;
    vc:implements ngm:request-response-pattern,
        ngm:stateless-protocol ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:caching,
        ngm:graph-ql,
