ngm:stewart-platform a owl:Class ;
    rdfs:label "Stewart Platform"@en ;
    rdfs:comment "A Stewart Platform (also known as a Gough-Stewart platform) is a type of parallel manipulator consisting of six variable-length prismatic actuators (struts) connecting a fixed base plate to a moveable top plate via universal or spherical joints, enabling six degrees of freedom—three translational and three rotational—within a compact, high-stiffness mechanical structure. First described by V.E. Gough in 1954 for tyre testing and later analysed by D. Stewart in 1965 for flight simulation, the architecture is characterised by high load-bearing capacity, positional accuracy, and mechanical rigidity compared to serial manipulators."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:motion-planning ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:kinematics ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:robot-joint ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:actuator ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:robot-dynamics ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:end-effector ],
        ngm:parallel-robot,
        ngm:robo-robot-type ;
    skos:broader ngm:robo-robot-type ;
    vc:contrastsWith ngm:industrial-robot ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:actuator,
        ngm:end-effector,
        ngm:robot-joint ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:haptic-feedback,
        ngm:robot-singularity,
        ngm:surgical-robot ;
    vc:requires ngm:kinematics,
        ngm:motion-planning,
        ngm:robot-dynamics ;
    vc:slug "stewart-platform" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:robot-control,
        ngm:robot-kinematics .

