ngm:real-time-collaboration a owl:Class ;
    rdfs:comment "Real-time collaboration is the practice and technology of multiple users working concurrently on shared content with changes propagated and merged with minimal latency. It relies on synchronisation algorithms that resolve concurrent edits while preserving each participant's intent. It underpins collaborative editors, shared design tools, and multi-user virtual environments."@en ;
    rdfs:label "Real Time Collaboration"@en ;
    rdfs:subClassOf ngm:distributed-collaboration ;
