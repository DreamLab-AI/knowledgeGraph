ngm:event-log a owl:Class ;
    rdfs:comment "An Event Log is an append-only record of discrete events emitted by a system, used to capture state changes for auditing, indexing and downstream processing. On blockchains, smart contracts emit events that are written to transaction receipts and stored in the log structure of each block, where they can be efficiently queried by off-chain services. Event logs provide an immutable, ordered history that decentralised applications use to reconstruct state and trigger reactions."@en ;
    rdfs:label "Event Log"@en ;
    rdfs:subClassOf ngm:append-only-log ;
    rdfs:subClassOf _:r10054 ;
    rdfs:subClassOf _:r10055 ;
