ngm:neural-networking a owl:Class ;
    rdfs:label "Neural Networking"@en ;
    rdfs:comment "The application of artificial neural network architectures — including convolutional, recurrent, and transformer-based models — to optimise network routing, traffic prediction, and resource allocation in communication infrastructure. Neural networking extends classical networking by replacing heuristic control planes with learned, data-driven decision policies."@en ;
    rdfs:subClassOf ngm:ai-model-architecture ;
    skos:broader ngm:ai-model-architecture ;
