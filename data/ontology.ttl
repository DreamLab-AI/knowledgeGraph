    skos:broader ngm:ai-application ;
    vc:enables ngm:depth-controlled-synthesis,
        ngm:edge-guided-generation,
        ngm:identity-preservation,
        ngm:pose-guided-image-generation,
        ngm:structural-layout-control,
        ngm:style-transfer,
        ngm:video-frame-consistency ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:conditioning-preprocessor,
        ngm:control-signal,
        ngm:cross-attention-adapter,
        ngm:encoder-copy,
        ngm:identity-network,
        ngm:skip-connection-injection,
        ngm:zero-convolution-layer ;
    vc:implements ngm:adapter-fine-tuning,
        ngm:cross-attention-injection,
        ngm:feedback-control-architecture,
        ngm:spatial-conditioning,
        ngm:zero-shot-conditioning ;
    vc:qualityScore "0.52"^^xsd:float ;
    vc:relatedTo ngm:depth-estimation,
        ngm:edge-detection,
