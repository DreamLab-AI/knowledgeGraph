ngm:w3-c-did-core a owl:Class ;
    rdfs:label "W3C DID Core"@en ;
    rdfs:comment "W3C DID Core is the World Wide Web Consortium Recommendation (published July 2022) defining Decentralised Identifiers (DIDs) — globally unique, controller-owned URIs of the form did:<method>:<method-specific-id> that are cryptographically verifiable and resolvable without a centralised registration authority. Each DID resolves to a JSON-LD DID Document containing verification methods (public keys), authentication suites, and service endpoints. The specification is method-agnostic, accommodating distributed ledgers, peer-to-peer networks, and web servers as verifiable data registries, and forms the identity layer of the broader Self-Sovereign Identity and Verifiable Credentials ecosystem."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:did-method ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:did-document ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptographic-signature ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:did-resolver ],
        ngm:decentralised-identity ;
    vc:bridgesTo ngm:ai-agent-identity,
        ngm:federated-learning,
        ngm:internet-of-things ;
    vc:contrastsWith ngm:oauth2,
        ngm:openid-connect,
        ngm:x-509-certificate ;
    vc:enables ngm:digital-identity-wallet,
        ngm:self-sovereign-identity,
        ngm:verifiable-credentials,
        ngm:zero-knowledge-proof ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:did-document,
        ngm:did-method,
        ngm:service-endpoint,
        ngm:verification-method ;
    vc:implements ngm:self-sovereign-identity,
        ngm:uri-scheme ;
    vc:qualityScore "0.76"^^xsd:float ;
    vc:relatedTo ngm:linked-data-proofs,
        ngm:sidetree-protocol ;
    vc:requires ngm:cryptographic-signature,
        ngm:did-resolver,
        ngm:public-key-cryptography ;
    vc:slug "w3-c-did-core" ;
    vc:sourceDomain "blockchain" ;
    vc:standardizedBy ngm:world-wide-web-consortium ;
    vc:supports ngm:access-control,
        ngm:credential-exchange,
        ngm:digital-identity ;
    vc:uses ngm:distributed-ledger-technology,
        ngm:elliptic-curve-cryptography,
        ngm:json-ld .

ngm:warehouse-automation a owl:Class ;
    rdfs:label "Warehouse Automation"@en ;
    rdfs:comment "Warehouse automation is the systematic deployment of robotic systems, autonomous mobile robots (AMRs), automated storage and retrieval systems (AS/RS), conveyor networks, and AI-driven software orchestration to execute goods induction, storage, picking, sorting, packing, and despatch with minimal direct human intervention. It integrates perception subsystems for item identification and collision-free navigation, motion-planning algorithms for physical task execution, and warehouse management system (WMS) integration for real-time order orchestration. Modern architectures layer machine learning for demand forecasting, adaptive task scheduling, and anomaly detection on top of heterogeneous robotic fleets, forming closed-loop feedback systems between physical material flow and digital supply-chain signals."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:computer-vision ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:sensor-fusion ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:simultaneous-localisation-and-mapping ],
        ngm:industrial-automation ;
    vc:bridgesTo ngm:demand-forecasting,
        ngm:last-mile-delivery,
        ngm:smart-manufacturing ;
    vc:contrastsWith ngm:human-robot-collaboration,
        ngm:manual-warehousing ;
    vc:dependsOn ngm:edge-computing,
        ngm:enterprise-resource-planning,
        ngm:iot-sensors ;
    vc:enables ngm:inventory-management,
        ngm:logistics-optimization,
        ngm:order-fulfilment ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:automated-storage-and-retrieval-system,
        ngm:autonomous-mobile-robot,
        ngm:conveyor-system,
        ngm:robotic-picking,
        ngm:warehouse-management-system ;
    vc:isPartOf ngm:supply-chain-management ;
    vc:qualityScore "0.76"^^xsd:float ;
    vc:relatedTo ngm:grasp-planning,
        ngm:motion-planning,
        ngm:multi-agent-systems ;
    vc:requires ngm:computer-vision,
        ngm:robot-fleet-management,
        ngm:sensor-fusion,
        ngm:simultaneous-localisation-and-mapping ;
    vc:slug "warehouse-automation" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:autonomous-navigation,
        ngm:digital-twin,
        ngm:machine-learning,
        ngm:mobile-robot .

