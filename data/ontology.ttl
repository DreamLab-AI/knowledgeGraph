    owl:someValuesFrom mv:ImmersiveVR
] .

mv:SpatialTracking rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:relatedTo ;
    owl:someValuesFrom mv:6DoFTracking
] .

mv:SpatialTracking rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:relatedTo ;
    owl:someValuesFrom mv:SLAM
] .

mv:SpatialTracking rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:relatedTo ;
    owl:someValuesFrom mv:InsideOutTracking
] .

# Spatial User Interfaces
mv:SpatialUserInterfaces a owl:Class ;
    rdfs:subClassOf mv:3DUserInterface ;
    rdfs:label "Spatial User Interfaces"@en ;
    rdfs:comment "Three-dimensional interaction systems enabling users to engage with digital content through spatially-aware methods including hand gestures, gaze tracking, and voice commands, designed for natural movement within AR, VR, and mixed reality environments with consideration for user comfort zones and 6DOF input."@en ;
    skos:prefLabel "Spatial User Interfaces"@en ;
    dcterms:identifier "MV-10067" ;
    dcterms:subject "mv" .

mv:SpatialUserInterfaces rdfs:subClassOf [
