ngm:service-level-objective a owl:Class ;
    rdfs:label "Service Level Objective"@en ;
    rdfs:comment "A service level objective (SLO) is a target value or range for a measurable property of a service, such as availability or latency, that defines the acceptable level of reliability over a stated time window. SLOs are expressed against service level indicators and provide the quantitative basis for engineering decisions, error budgets and the contractual commitments of service level agreements. They are a cornerstone practice of site reliability engineering, balancing reliability against the pace of change."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:observability ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:latency ],
        ngm:site-reliability-engineering ;
    vc:bridgesTo ngm:reliability ;
    vc:dependsOn ngm:monitoring,
        ngm:observability ;
    vc:enables ngm:reliability ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:latency ;
    vc:isPartOf ngm:site-reliability-engineering ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:devops,
        ngm:distributed-systems,
        ngm:fault-tolerance ;
    vc:requires ngm:observability ;
    vc:slug "service-level-objective" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:capacity-planning,
        ngm:reliability-engineering ;
    vc:uses ngm:monitoring .

ngm:signal-conditioning a owl:Class ;
    rdfs:label "Signal Conditioning"@en ;
    rdfs:comment "Signal conditioning is the ensemble of analogue and digital processing stages applied to raw electrical outputs from physical sensors — including amplification, filtering, analogue-to-digital conversion, isolation, linearisation, and calibration — to produce clean, scaled, noise-reduced representations in engineering units suitable for downstream control, estimation, and machine-learning pipelines. It occupies the critical interface between the physical world and digital computation, and its fidelity directly determines the accuracy of perception, control, and data-acquisition systems built upon it. Standard stages encompass instrumentation amplifiers, anti-aliasing filters, temperature compensation, galvanic isolation, sample-rate conversion, and offset or gain correction applied in hardware, firmware, or software. In robotics, industrial automation, medical devices, and IoT edge nodes, signal conditioning is a prerequisite for reliable sensor fusion, closed-loop control, and anomaly detection."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:calibration ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:analogue-to-digital-conversion ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:sensor ],
        ngm:signal-processing ;
    vc:bridgesTo ngm:digital-twin,
        ngm:edge-inference ;
    vc:contrastsWith ngm:sensor-data ;
    vc:enables ngm:anomaly-detection,
        ngm:closed-loop-control,
        ngm:kalman-filter,
        ngm:sensor-fusion ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:analogue-to-digital-conversion,
        ngm:calibration ;
    vc:isPartOf ngm:data-acquisition,
        ngm:robo-perception ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:accelerometer,
        ngm:embedded-systems,
        ngm:force-torque-sensor,
        ngm:noise-reduction ;
    vc:requires ngm:sensor ;
    vc:slug "signal-conditioning" ;
    vc:sourceDomain "robotics" ;
    vc:supports ngm:predictive-maintenance,
        ngm:robot-operating-system,
        ngm:slam ;
    vc:uses ngm:digital-signal-processing,
        ngm:imu .

ngm:snapshot a owl:Class ;
    rdfs:label "Snapshot"@en ;
    rdfs:comment "Snapshot is an off-chain governance platform that lets token holders and decentralised autonomous organisations vote on proposals without paying on-chain transaction fees. Votes are signed cryptographically with a wallet and weighted according to token holdings recorded at a chosen block height, then aggregated and stored on the InterPlanetary File System. Because voting is gasless and non-binding at the protocol level, results are typically executed separately by multisignature wallets or on-chain modules."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:voting-systems ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptographic-signature ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:erc-20-token-standard ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ipfs ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:governance-proposal ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ethereum-smart-contract-platform ],
        ngm:decentralised-finance ;
    vc:bridgesTo ngm:decentralised-identity,
        ngm:distributed-storage ;
    vc:contrastsWith ngm:governance,
        ngm:on-chain-voting ;
    vc:dependsOn ngm:blockchain-wallet,
        ngm:smart-contract ;
    vc:enables ngm:decentralised-autonomous-organisation,
        ngm:on-chain-governance,
        ngm:quadratic-voting,
        ngm:token-weighted-voting ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:governance-proposal,
        ngm:voting-systems ;
    vc:isPartOf ngm:governance ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:aragon,
        ngm:tally ;
    vc:requires ngm:cryptographic-signature,
        ngm:erc-20-token-standard,
        ngm:ethereum-smart-contract-platform,
        ngm:ipfs ;
    vc:slug "snapshot" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:decentralised-governance ;
    vc:uses ngm:gnosis-safe,
        ngm:multisignature-wallets .

ngm:social-robotics a owl:Class ;
    rdfs:label "Social Robotics"@en ;
    rdfs:comment "A field of robotics focused on designing robots capable of interacting and communicating with humans and other autonomous agents in a socially acceptable manner, following social rules, norms, and expectations of human interaction."@en ;
