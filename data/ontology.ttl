ngm:chain-of-thought a owl:Class ;
    rdfs:label "Chain of Thought"@en ;
    rdfs:comment "Chain-of-Thought (CoT) prompting is a prompting technique for large language models in which the model is encouraged to produce explicit intermediate reasoning steps prior to its final answer, substantially improving accuracy on arithmetic, symbolic, and commonsense reasoning tasks. The technique exploits the sequential token-generation process of autoregressive transformers: each generated reasoning step conditions all subsequent steps, allowing multi-hop deductions that single-step prompting cannot reliably perform. CoT has given rise to a family of variants including zero-shot CoT, self-consistency CoT, and tree-of-thought search strategies."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:large-language-models ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:prompt-engineering ],
        ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:enables ngm:reasoning ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:chain-of-thought-reasoning,
        ngm:transformer ;
    vc:requires ngm:large-language-models,
        ngm:prompt-engineering ;
    vc:slug "chain-of-thought" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:computing-infrastructure a owl:Class ;
    rdfs:label "Computing Infrastructure"@en ;
    rdfs:comment "Computing infrastructure encompasses the physical and virtual resources required for building, running, and delivering applications and services, including servers, storage systems, networking equipment, power systems, and cooling facilities housed in data centres. It provides the foundational capacity that IT systems require to process, store, and transmit digital data. Modern computing infrastructure increasingly extends from on-premises hardware into cloud-hosted and edge environments, and is a prerequisite for AI workloads, distributed applications, and spatial computing platforms."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:storage-infrastructure ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:gpu-compute ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:network-infrastructure ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:networking-infrastructure ],
        ngm:infra-computing-and-cloud ;
    skos:broader ngm:infra-computing-and-cloud ;
    vc:enables ngm:ai-infrastructure,
        ngm:orchestration ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:gpu-compute,
