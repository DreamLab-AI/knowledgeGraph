    vc:relatedTo ngm:overfitting ;
    vc:requires ngm:ensemble-methods ;
    vc:slug "stacking" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:machine-learning-discipline-model .

