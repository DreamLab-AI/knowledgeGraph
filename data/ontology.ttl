ngm:kinematics-model a owl:Class ;
    rdfs:label "Kinematics Model"@en ;
    rdfs:comment "KinematicsModel is a mathematical representation of the geometric relationships between a robot's joint configuration space and its end-effector pose in Cartesian workspace coordinates, abstracting away forces and inertial effects to describe pure motion geometry."@en ;
    rdfs:subClassOf ngm:geometric-model,
        ngm:mathematical-model ;
    vc:enables ngm:cartesian-impedance-control,
        ngm:force-control,
        ngm:motion-planning,
        ngm:robot-calibration,
        ngm:robot-control,
        ngm:teleoperation,
        ngm:trajectory-generation,
        ngm:visual-servoing ;
    vc:hasPart ngm:cartesian-space,
        ngm:denavit-hartenberg-parameters,
        ngm:forward-kinematics,
        ngm:inverse-kinematics,
        ngm:jacobian-matrix,
        ngm:joint-space,
        ngm:redundancy-resolution,
        ngm:screw-theory,
        ngm:singularity-analysis ;
    vc:implements ngm:closed-form-ik,
        ngm:dh-convention,
        ngm:iterative-jacobian-solver,
        ngm:neural-inverse-kinematics,
        ngm:product-of-exponentials ;
    vc:maturity "established" ;
    vc:qualityScore "0.52"^^xsd:float ;
    vc:relatedTo ngm:calibration,
        ngm:collision-detection,
        ngm:manipulability-ellipsoid,
        ngm:task-space-control,
        ngm:workspace-analysis ;
    vc:requires ngm:homogeneous-transformation,
        ngm:joint-configuration,
        ngm:reference-frames,
        ngm:robot-description-format,
        ngm:se-3-lie-group ;
    vc:slug "kinematics-model" ;
    vc:sourceDomain "robotics" ;
    vc:standardizedBy ngm:ieee-robotics-and-automation-society,
        ngm:ros-industrial-consortium,
        ngm:urdf-specification ;
    vc:supports ngm:autonomous-mobile-robots,
        ngm:exoskeleton-control,
        ngm:industrial-manipulation,
        ngm:legged-locomotion,
        ngm:space-robotics,
        ngm:surgical-robotics ;
    vc:uses ngm:drake,
        ngm:gazebo,
        ngm:mu-jo-co,
        ngm:pinocchio-library,
        ngm:ros,
        ngm:sdf,
        ngm:urdf .

