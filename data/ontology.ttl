ngm:decentralization a owl:Class ;
    rdfs:label "Decentralization"@en ;
    rdfs:comment "The architectural property of distributing control, data storage, and decision-making across many independent network participants rather than concentrating them in a single authority. In blockchain systems, decentralisation is achieved through open participation, distributed consensus, and cryptographic enforcement of rules, providing censorship resistance, fault tolerance, and permissionless access."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:consensus-mechanism ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:node ],
        ngm:bc-network-component,
        ngm:blockchain-entity,
        ngm:distributed-data-structure ;
    skos:broader ngm:bc-network-component ;
    vc:contrastsWith ngm:51-attack ;
    vc:enables ngm:blockchain-governance,
        ngm:decentralised-autonomous-organisation,
        ngm:decentralised-finance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:blockchain-network,
        ngm:blockchain-scalability,
        ngm:decentralization-layer,
        ngm:decentralized-storage,
        ngm:longest-chain-rule ;
    vc:requires ngm:consensus-mechanism,
        ngm:node ;
    vc:slug "decentralization" ;
    vc:sourceDomain "blockchain" .

ngm:decentralized-identity-foundation a owl:Class ;
    rdfs:label "Decentralized Identity Foundation"@en ;
    rdfs:comment "The Decentralized Identity Foundation (DIF) is an open industry consortium that develops interoperable specifications, protocols, and reference implementations for decentralised digital identity systems. It produces work items including the DIF Presentation Exchange specification for credential proof requests, the Decentralized Web Node (DWN) protocol for identity-linked personal data storage, and the Sidetree protocol family for scalable DID method implementations. DIF operates as a complement to W3C standards, producing the lower-level coordination layer that W3C DID and verifiable credential specifications rely on."@en ;
    rdfs:subClassOf ngm:bc-governance-and-regulation ;
    skos:broader ngm:bc-governance-and-regulation ;
    vc:enables ngm:did-document,
        ngm:verifiable-credentials ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:blockchain ;
    vc:slug "decentralized-identity-foundation" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:identity,
        ngm:self-sovereign-identity .

ngm:deep-generative-model a owl:Class ;
    rdfs:label "Deep Generative Model"@en ;
    rdfs:comment "A Deep Generative Model is a neural network architecture trained to learn the underlying probability distribution of a dataset and draw new samples from it. The principal families include Generative Adversarial Networks (GANs), Variational Autoencoders (VAEs), normalising flows, and diffusion models, each offering different trade-offs between sample quality, diversity, training stability, and latent-space interpretability."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:autoencoder ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:diffusion-model ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:generative-adversarial-network ],
        ngm:ai-model-architecture ;
    skos:broader ngm:ai-model-architecture ;
    vc:enables ngm:image-generation,
        ngm:synthetic-data ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:autoencoder,
        ngm:diffusion-model,
        ngm:generative-adversarial-network ;
    vc:isPartOf ngm:generative-ai ;
    vc:qualityScore "0.3"^^xsd:float ;
    vc:slug "deep-generative-model" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:didcomm a owl:Class ;
    rdfs:label "DIDComm"@en ;
    rdfs:comment "DIDComm (Decentralised Identifier Communication) is a secure, private messaging protocol built on top of the W3C Decentralised Identifiers specification, enabling peer-to-peer, end-to-end encrypted communication between parties whose identities are anchored to DIDs. The protocol specifies how messages are packaged, signed, and encrypted using keys derived from DID documents, without reliance on any central server or directory. DIDComm messages are transport-agnostic, operating over HTTP, Bluetooth, NFC, or any delivery mechanism, making the protocol suitable for both online and offline identity interactions. It forms the communication backbone of the self-sovereign identity ecosystem."@en ;
    rdfs:subClassOf ngm:decentralized-identity-did ;
    vc:enables ngm:protocol-layer,
        ngm:verifiable-credential-vc ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:decentralized-identity-foundation,
        ngm:self-sovereign-identity,
        ngm:w3-c-did-core ;
    vc:slug "didcomm" ;
    vc:sourceDomain "security" ;
    vc:uses ngm:did-document,
        ngm:peer-to-peer-network,
        ngm:verifiable-credentials .

