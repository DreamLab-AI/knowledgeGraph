ngm:cpu-architecture a owl:Class ;
    rdfs:comment "CPU architecture is the design of general-purpose central processors optimised for low-latency execution of sequential and branch-heavy code: a small number of powerful cores with deep pipelines, aggressive out-of-order execution, sophisticated branch prediction, and large multi-level caches. It is the deliberate opposite pole to GPU architecture, which trades single-thread latency for massive throughput; CPUs devote silicon to making one instruction stream fast, GPUs to running tens of thousands of streams concurrently."@en ;
    rdfs:label "CPU Architecture"@en ;
    rdfs:subClassOf ngm:computer-hardware ;
    rdfs:subClassOf _:r3788 ;
    vc:contrastsWith ngm:gpu-architecture ;
