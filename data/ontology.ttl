ngm:halving a owl:Class ;
    rdfs:label "Halving"@en ;
    rdfs:comment "A programmatic event in proof-of-work blockchains, most notably Bitcoin, whereby the block reward issued to miners is cut in half at a predetermined block height. Halvings enforce a fixed, disinflationary supply schedule that asymptotically approaches the maximum coin supply. By reducing new coin issuance, halvings create predictable scarcity and are a central component of Bitcoin's monetary policy."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:proof-of-work ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:consensus-rule ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:mining-reward ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:block-reward ],
        ngm:bc-defi-and-economics,
        ngm:blockchain-entity,
        ngm:economic-mechanism ;
    skos:broader ngm:bc-defi-and-economics ;
    vc:enables ngm:deflationary-token,
        ngm:fixed-supply-token,
        ngm:inflation-control ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:block-reward,
        ngm:mining-reward ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:bitcoin-proof-of-work-protocol-mining,
        ngm:bitcoin-proof-of-work-protocol-value-proposition,
        ngm:circulating-supply,
        ngm:difficulty-adjustment,
        ngm:incentive-alignment,
        ngm:monetary-policy-implementation,
        ngm:tokenomics ;
    vc:requires ngm:consensus-rule,
        ngm:proof-of-work ;
    vc:slug "halving" ;
    vc:sourceDomain "blockchain" .

ngm:hardware-layer a owl:Class ;
    rdfs:label "Hardware Layer"@en ;
    rdfs:comment "The Hardware Layer is the lowest stratum of the canonical stack, comprising the physical computing, storage, and signalling devices on which everything above runs. Nothing sits below it; immediately above it is the Network Layer, which connects discrete machines. It contains processors, memory, storage media, accelerators, and the physical transmission media that carry signals."@en ;
    rdfs:subClassOf ngm:infra-computing-and-cloud ;
    skos:broader ngm:infra-computing-and-cloud ;
    vc:enables ngm:compute-layer,
        ngm:network-layer ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:slug "hardware-layer" ;
    vc:sourceDomain "infrastructure" .

ngm:hash-rate a owl:Class ;
    rdfs:label "Hash Rate"@en ;
    rdfs:comment "Hash rate is the aggregate computational throughput of a proof-of-work blockchain network, measured as the number of hash function evaluations performed per unit of time across all participating mining nodes. It serves as the primary quantitative indicator of a network's security: a higher hash rate means an attacker must control and operate more hardware to execute a 51% attack, making double-spend attacks proportionally more expensive. Hash rate is typically expressed in hashes per second (H/s) with SI prefixes (kH/s, MH/s, GH/s, TH/s, PH/s, EH/s) and fluctuates with the entry or exit of miners, hardware efficiency improvements, and changes in mining profitability."@en ;
    rdfs:subClassOf ngm:proof-of-work ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:51-attack,
        ngm:bitcoin-proof-of-work-protocol-mining,
        ngm:difficulty,
        ngm:difficulty-adjustment,
        ngm:mining,
        ngm:mining-pool,
        ngm:network-hash-rate ;
    vc:slug "hash-rate" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:compute-resources,
        ngm:cryptographic-hash-function,
        ngm:hash-function .

ngm:healthcare-technology a owl:Class ;
    rdfs:label "Healthcare Technology"@en ;
    rdfs:comment "Healthcare Technology encompasses the digital tools, software systems, and AI-driven applications deployed in clinical and health management contexts, including medical imaging, electronic health records, clinical decision support, and telemedicine platforms. It bridges spatial computing, data analytics, and AI to improve diagnostic accuracy, treatment outcomes, and health system efficiency."@en ;
