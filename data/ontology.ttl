        ngm:video-streaming ;
    vc:uses ngm:hardware-acceleration,
        ngm:quantisation .

ngm:vision-language-model a owl:Class ;
    rdfs:label "Vision Language Model"@en ;
    rdfs:comment "A Vision Language Model (VLM) is a multimodal neural architecture that jointly processes visual inputs (images or video) and natural language text, learning shared representations that enable cross-modal tasks such as image captioning, visual question answering, visual grounding, and instruction-following based on image context. VLMs typically pair a visual encoder with a large language model backbone connected by a learned projection mechanism."@en ;
    rdfs:subClassOf ngm:multimodal-ai-architecture-models ;
    vc:enables ngm:visual-grounding,
        ngm:visual-question-answering ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.85"^^xsd:float ;
    vc:relatedTo ngm:multimodal-ai-architecture-reasoning ;
    vc:slug "vision-language-model" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:instruction-tuning,
        ngm:large-language-models,
        ngm:visual-representation .

ngm:warehouse-automation a owl:Class ;
    rdfs:label "Warehouse Automation"@en ;
    rdfs:comment "Warehouse automation is the systematic deployment of robotic systems, autonomous mobile robots (AMRs), automated storage and retrieval systems (AS/RS), conveyor networks, and AI-driven software orchestration to execute goods induction, storage, picking, sorting, packing, and despatch with minimal direct human intervention. It integrates perception subsystems for item identification and collision-free navigation, motion-planning algorithms for physical task execution, and warehouse management system (WMS) integration for real-time order orchestration. Modern architectures layer machine learning for demand forecasting, adaptive task scheduling, and anomaly detection on top of heterogeneous robotic fleets, forming closed-loop feedback systems between physical material flow and digital supply-chain signals."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:computer-vision ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:warehouse-management-system ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:sensor-fusion ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:simultaneous-localisation-and-mapping ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:fleet-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:autonomous-mobile-robots ],
        ngm:industrial-automation ;
    vc:bridgesTo ngm:demand-forecasting,
        ngm:last-mile-delivery,
        ngm:smart-manufacturing ;
    vc:contrastsWith ngm:human-robot-collaboration ;
    vc:dependsOn ngm:edge-computing,
        ngm:enterprise-resource-planning,
        ngm:io-t-sensors ;
