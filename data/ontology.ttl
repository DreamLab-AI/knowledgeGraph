        ngm:version-control .

ngm:code-review a owl:Class ;
    rdfs:label "Code Review"@en ;
    rdfs:comment "Code review is the systematic, human-led examination of proposed source code changes by one or more reviewers other than the original author, intended to detect defects, enforce coding standards, and disseminate architectural knowledge across a development team. It is most commonly performed asynchronously via pull requests or merge requests in version-controlled repositories, augmented by automated static analysis, linting, and continuous integration checks. Effective code review functions as both a quality gate and a collaborative learning mechanism, reducing the cost of defects by catching them before integration into the main codebase. It is a foundational practice in professional software engineering, distributed-collaboration workflows, and secure development lifecycles."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:version-control ],
        ngm:software-engineering ;
    vc:bridgesTo ngm:automated-code-review,
        ngm:large-language-model ;
    vc:contrastsWith ngm:formal-inspection,
        ngm:pair-programming ;
    vc:dependsOn ngm:collaborative-workflow,
        ngm:source-code-management ;
    vc:enables ngm:continuous-integration,
        ngm:knowledge-sharing,
        ngm:secure-development-lifecycle,
        ngm:software-quality-assurance ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:isPartOf ngm:devops,
        ngm:software-development ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:agile-development,
        ngm:open-source-development,
        ngm:refactoring ;
    vc:requires ngm:coding-standards,
        ngm:pull-request,
        ngm:version-control ;
    vc:slug "code-review" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:code-maintainability,
        ngm:software-testing,
        ngm:technical-debt-management ;
    vc:uses ngm:diff-algorithm,
        ngm:inline-commenting,
        ngm:static-analysis .

ngm:computer-use-and-browser-agents a owl:Class ;
    rdfs:label "Computer Use and Browser Agents"@en ;
    rdfs:comment "Computer Use and Browser Agents are a class of agentic AI systems that operate graphical user interfaces, web browsers, and operating systems by perceiving the screen through vision-language models (VLMs), planning actions in natural language, and emitting low-level input events (mouse coordinate..."@en ;
