ngm:financial-stability a owl:Class ;
    rdfs:label "Financial Stability"@en ;
    rdfs:comment "Financial stability is the condition in which the financial system — encompassing banks, capital markets, payment infrastructure, insurers, and non-bank intermediaries — can absorb shocks, maintain the orderly allocation of capital, and continue to perform its core functions of credit intermediation, risk transfer, and payment settlement without requiring extraordinary public support. It is a macroprudential objective distinct from the microprudential health of individual institutions, focusing instead on the resilience and interconnectedness of the system as a whole. Threats to financial stability include excessive leverage, maturity mismatches, procyclical asset valuations, contagion through counterparty networks, and confidence crises that trigger self-fulfilling runs. International bodies such as the Financial Stability Board (FSB), the Bank for International Settlements (BIS), the International Monetary Fund (IMF), and national central banks monitor systemic risk indicators and coordinate macroprudential policy responses."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:capital-adequacy ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:compliance-framework ],
        ngm:financial-regulation ;
    vc:bridgesTo ngm:central-bank-digital-currency,
        ngm:crypto-asset-regulation,
        ngm:decentralised-finance ;
    vc:contrastsWith ngm:bank-run,
        ngm:financial-contagion,
        ngm:systemic-risk ;
    vc:dependsOn ngm:central-banking,
        ngm:deposit-insurance,
        ngm:lender-of-last-resort ;
    vc:enables ngm:credit-intermediation,
        ngm:economic-growth,
        ngm:payment-settlement ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:macroprudential-policy,
        ngm:stress-testing,
        ngm:systemic-risk-monitoring ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:anti-money-laundering,
        ngm:financial-regulation,
        ngm:prudential-supervision,
        ngm:stablecoin ;
    vc:requires ngm:capital-adequacy,
        ngm:compliance-framework,
        ngm:liquidity-management ;
    vc:slug "financial-stability" ;
    vc:sourceDomain "finance" ;
    vc:standardizedBy ngm:basel-committee,
        ngm:financial-stability-board,
        ngm:imf-fsap .

ngm:imu a owl:Class ;
    rdfs:label "IMU"@en ;
    rdfs:comment "An Inertial Measurement Unit (IMU) is a self-contained electronic sensor module that integrates tri-axial accelerometers, gyroscopes, and optionally magnetometers to measure a rigid body's specific force, angular rate, and magnetic heading relative to an inertial reference frame without dependence on external infrastructure. MEMS-fabricated IMUs fuse their outputs through Kalman or complementary filter algorithms to yield real-time pose and orientation estimates at high sample rates, feeding inertial navigation, SLAM pipelines, and 6-DoF tracking systems. IMUs span performance grades from low-cost consumer MEMS units (bias instability >1°/hr) to navigation-grade fibre-optic and ring-laser gyro systems used in aerospace and submarine applications. They are integral to XR headsets, autonomous vehicles, UAVs, legged robots, wearables, and surgical instruments wherever low-latency, infrastructure-independent motion awareness is required."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:accelerometer ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:kalman-filter ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:gyroscope ],
        ngm:sensor ;
    vc:bridgesTo ngm:autonomous-vehicle,
        ngm:human-motion-capture,
        ngm:robot-proprioception ;
    vc:contrastsWith ngm:gps,
        ngm:optical-tracking ;
    vc:dependsOn ngm:real-time-operating-system ;
    vc:enables ngm:6dof-tracking,
        ngm:attitude-estimation,
        ngm:dead-reckoning,
        ngm:motion-tracking,
        ngm:sensor-fusion ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:accelerometer,
        ngm:digital-motion-processor,
        ngm:gyroscope,
        ngm:magnetometer ;
    vc:implements ngm:newton-euler-dynamics,
        ngm:strapdown-navigation ;
    vc:isPartOf ngm:flight-controller,
        ngm:inertial-navigation-system,
        ngm:xr-headset ;
    vc:qualityScore "0.76"^^xsd:float ;
    vc:relatedTo ngm:extended-reality,
        ngm:gnss,
        ngm:lidar,
        ngm:motion-sickness ;
    vc:requires ngm:analogue-to-digital-converter,
        ngm:kalman-filter,
        ngm:mems ;
    vc:slug "imu" ;
    vc:sourceDomain "spatial-computing" ;
    vc:standardizedBy ngm:ieee-1559,
        ngm:ieee-952 ;
    vc:supports ngm:gait-analysis,
        ngm:hand-tracking,
        ngm:pose-estimation,
        ngm:slam,
        ngm:visual-inertial-odometry ;
    vc:uses ngm:complementary-filter,
        ngm:euler-angles,
        ngm:quaternion,
        ngm:rotation-matrix .

