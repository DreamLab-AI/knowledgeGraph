ngm:neural-machine-translation a owl:Class ;
    rdfs:label "Neural Machine Translation"@en ;
    rdfs:comment "Neural Machine Translation (NMT) is an approach to automated language translation in which end-to-end neural networks — typically based on encoder-decoder architectures with attention mechanisms — learn to map source-language sequences directly to target-language sequences from parallel corpora. Unlike earlier statistical phrase-based methods, NMT systems capture long-range dependencies and global sentence context, producing more fluent and contextually accurate translations. The Transformer architecture has become the dominant NMT paradigm since its introduction in 2017."@en ;
    rdfs:subClassOf ngm:language-translation ;
    vc:enables ngm:real-time-language-translation,
        ngm:real-time-translation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:deep-learning,
        ngm:language-model,
        ngm:natural-language-processing ;
    vc:slug "neural-machine-translation" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:attention-mechanism,
        ngm:encoder-decoder-architecture,
        ngm:transformer-architecture .

ngm:neural-processing-unit a owl:Class ;
    rdfs:label "Neural Processing Unit"@en ;
    rdfs:comment "A Neural Processing Unit (NPU) is a specialised integrated circuit designed to accelerate neural network inference workloads by providing high-throughput, energy-efficient execution of the matrix multiplication and convolution operations that dominate deep learning computation. NPUs are integrated into mobile SoCs, personal computers, and edge devices to enable on-device AI inference without reliance on cloud compute, targeting performance-per-watt objectives unachievable by general-purpose CPUs or GPUs for these workloads."@en ;
    rdfs:subClassOf ngm:ai-hardware ;
    vc:enables ngm:edge-ai,
        ngm:on-device-inference,
        ngm:real-time-ai-inference ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:gpu-compute,
        ngm:npu,
        ngm:tensor-processing-unit ;
    vc:slug "neural-processing-unit" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:hardware-acceleration,
        ngm:inference-hardware .

ngm:nostr-relay a owl:Class ;
    rdfs:label "Nostr Relay"@en ;
    rdfs:comment "A Nostr Relay is a server that implements the Nostr protocol, accepting signed event objects from clients, storing them, and forwarding them to subscribed clients according to filter criteria. Relays are the infrastructure backbone of the Nostr decentralised social network: because there is no central server or consensus chain, the network's availability and censorship-resistance derive entirely from the federated mesh of independently operated relays. Relays communicate with clients over persistent WebSocket connections using a simple JSON message format."@en ;
    rdfs:subClassOf ngm:nostr-protocol ;
    vc:enables ngm:decentralized-identity,
        ngm:did-nostr-identity ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:federated-identity,
        ngm:nostr,
        ngm:relayer ;
    vc:slug "nostr-relay" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:public-key-cryptography,
        ngm:web-socket-protocol .

ngm:objective a owl:Class ;
    rdfs:label "Objective"@en ;
    rdfs:comment "A formal specification of the goal or criterion that an AI system, optimisation algorithm, or training procedure is designed to satisfy or maximise. In machine learning this is typically expressed as a loss function or reward signal that guides parameter updates; in planning and reinforcement learning it encodes desired agent behaviour through utility or reward functions."@en ;
    rdfs:subClassOf ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:enables ngm:model-optimisation-and-performance ;
    vc:hasMaturity ngmi:maturity-established ;
