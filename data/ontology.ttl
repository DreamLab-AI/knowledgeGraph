    owl:someValuesFrom blockchain:HyperledgerFoundation
] .

# R3 Corda
blockchain:R3Corda rdf:type owl:Class ;
    rdfs:label "R3 Corda"@en ;
    rdfs:comment "Purpose-built financial distributed ledger implementing \"need-to-know\" architecture where transaction data shares only amongst parties with legitimate business interest, eliminating global state replication in favour of individual cryptographically-assured facts with uniqueness consensus via Notary services. Corda models SmartContract as legally enforceable agreements between identified parties, providing privacy guarantees required by regulated financial institutions whilst preventing double-spending without full ledger visibility. Processing £10+ billion in tokenised real-world assets across payments, securities settlement, insurance, and trade finance with deep integration with existing financial infrastructure."@en ;
    skos:prefLabel "R3 Corda"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:blockchain:r3-corda" ;
    owl:sameAs <urn:visionclaw:concept:blockchain:r3-corda> ;
    vcw:contentHash "sha256-12-939fa04ea1be" ;
    vcw:qualityScore "0.4"^^xsd:decimal ;
