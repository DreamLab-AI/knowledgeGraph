    vc:hasPart ngm:user-interface ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:slug "node-based-editor" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:3-d-asset ;
    vc:supports ngm:rendering-engine ;
    vc:uses ngm:game-engine ;
    vc:uses ngm:shader .
ngm:node-based-visual-programming a skos:Concept ;
    rdfs:label "Node Based Visual Programming"@en .
ngm:node-classification a owl:Class ;
    rdfs:comment "Node classification is a graph machine learning task that predicts a categorical label for each vertex in a graph, typically using the graph's structure together with node and edge features. It is commonly solved with graph neural networks, which propagate and aggregate neighbourhood information across message-passing layers to produce per-node predictions. Applications include fraud detection, citation-network labelling and social-network role inference."@en ;
    rdfs:label "Node Classification"@en ;
    rdfs:subClassOf ngm:classification ;
    rdfs:subClassOf _:r15443 ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires ngm:graph-neural-network ;
    vc:slug "node-classification" ;
    vc:sourceDomain "machine-learning" .
ngm:node-embedding a owl:Class ;
    rdfs:comment "Node embedding is a technique that maps each vertex of a graph to a low-dimensional vector such that structural relationships in the graph, such as proximity, connectivity, or community membership, are preserved as geometric relationships in the embedding space. Methods range from random-walk based approaches to graph neural network encoders that aggregate information from a node's neighbourhood. Node embeddings support downstream tasks such as community detection, link prediction, and node classification."@en ;
    rdfs:label "Node Embedding"@en ;
    rdfs:subClassOf ngm:graph-embedding ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:slug "node-embedding" ;
    vc:sourceDomain "machine-learning" .
ngm:node-graph a skos:Concept ;
    rdfs:label "Node Graph"@en .
ngm:node-graph-visual-programming-interface a owl:Class ;
    rdfs:comment "A paradigm of graphical programming in which computational logic is authored by connecting discrete functional nodes via edges rather than writing textual code. Node-based interfaces lower the barrier to complex workflow construction, making them prevalent in AI pipeline tools (e.g., ComfyUI, Flowise), creative software (shader editors, compositing), and knowledge-graph visualisation environments."@en ;
    rdfs:label "Node-Graph Visual Programming Interface"@en ;
    rdfs:subClassOf ngm:software-engineering ;
    vc:bridgesTo ngm:user-interface ;
    vc:enables ngm:knowledge-graph ;
    vc:enables ngm:workflow-automation ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:knowledge-graph-construction ;
    vc:slug "node-graph-visual-programming-interface" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:user-interface-architecture ;
    vc:uses ngm:data-visualisation .
ngm:node-identifier a skos:Concept ;
    rdfs:label "Node Identifier"@en .
ngm:node-independent-validation-pbft a owl:Class ;
    rdfs:comment "Node-Independent Validation PBFT is a variant of Practical Byzantine Fault Tolerance in which each validator independently verifies transaction validity without delegating validation authority to a designated primary node, eliminating the single point of failure inherent in classical PBFT's primary-replica model. By distributing validation responsibility uniformly across all consensus participants, the protocol improves resilience against primary node compromise and reduces the attack surface for Byzantine behaviour in consortium and enterprise blockchain deployments."@en ;
    rdfs:label "Node-Independent Validation PBFT"@en ;
    rdfs:subClassOf ngm:bc-protocol-and-consensus ;
    rdfs:subClassOf ngm:practical-byzantine-fault-tolerance ;
    rdfs:subClassOf _:r15453 ;
    rdfs:subClassOf _:r15454 ;
