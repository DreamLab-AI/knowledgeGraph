    vc:dependsOn ngm:data-catalog,
        ngm:master-data-management ;
    vc:enables ngm:data-consistency,
        ngm:data-interoperability,
        ngm:regulatory-compliance ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:controlled-vocabulary,
        ngm:data-element,
        ngm:metadata-schema ;
    vc:implements ngm:dublin-core,
        ngm:iso-11179 ;
    vc:isPartOf ngm:data-governance,
        ngm:enterprise-architecture ;
    vc:qualityScore "0.68"^^xsd:float ;
    vc:relatedTo ngm:feature-store,
        ngm:model-registry ;
    vc:requires ngm:data-stewardship,
        ngm:identity-management ;
    vc:slug "metadata-registry" ;
    vc:sourceDomain "infrastructure" ;
    vc:standardizedBy ngm:ieee,
        ngm:iso-11179 ;
    vc:supports ngm:audit-trail,
        ngm:data-lineage,
        ngm:data-quality-management ;
    vc:uses ngm:api,
        ngm:ontology,
        ngm:semantic-web-linked-data-standard .

ngm:metaverse-architecture a owl:Class ;
    rdfs:label "Metaverse Architecture"@en ;
    rdfs:comment "The layered technical framework defining metaverse infrastructure, encompassing network connectivity, computing resources, spatial computing, creator tools, interaction protocols, and economic systems that enable persistent virtual worlds."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:5-g-network ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:interoperability ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:edge-computing ],
