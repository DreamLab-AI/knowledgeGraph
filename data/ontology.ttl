        ngm:digital-curation-platform,
        ngm:discovery-layer,
        ngm:personalisation,
        ngm:retrieval-augmented-generation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:collaborative-filtering,
        ngm:content-based-filtering,
        ngm:dense-retrieval,
        ngm:semantic-search ;
    vc:qualityScore "0.9"^^xsd:float ;
    vc:relatedTo ngm:algorithmic-accountability,
