        ngm:machine-learning-discipline,
        ngm:serverless-architecture ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:cloud-storage,
        ngm:tensor-processing-unit,
        ngm:vertex-ai ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:cloud-native,
        ngm:identity-and-access-management ;
    vc:requires ngm:cloud-computing,
        ngm:data-centre,
        ngm:internet-connectivity ;
    vc:slug "google-cloud" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:devops,
        ngm:microservices,
        ngm:mlops ;
    vc:uses ngm:kubernetes,
