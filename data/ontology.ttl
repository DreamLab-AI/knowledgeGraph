        ngm:servo-amplifier ;
    vc:slug "dc-servo-motor" ;
    vc:sourceDomain "robotics" .

ngm:deep-generative-model a owl:Class ;
    rdfs:label "Deep Generative Model"@en ;
    rdfs:comment "A Deep Generative Model is a class of deep neural network trained to learn and approximate the underlying probability distribution of a dataset so that novel, statistically plausible samples can be drawn from it. The principal families — Generative Adversarial Networks (GANs), Variational Autoencoders (VAEs), normalising flows, and diffusion models — differ in how they parameterise and optimise the generative distribution, offering distinct trade-offs among sample fidelity, mode coverage, training stability, and latent-space interpretability. These models underpin modern generative AI capabilities across images, audio, video, text, and structured scientific data such as molecular graphs."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:training-data ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:variational-autoencoder ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:autoregressive-model ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:neural-network ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:probabilistic-inference ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:normalising-flow ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:diffusion-model ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:generative-adversarial-network ],
        ngm:generative-ai ;
    vc:bridgesTo ngm:privacy-preserving-machine-learning,
        ngm:synthetic-media ;
    vc:contrastsWith ngm:classifier,
        ngm:discriminative-model ;
    vc:enables ngm:data-augmentation,
        ngm:drug-discovery,
        ngm:image-generation,
        ngm:synthetic-data,
        ngm:text-to-image ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:autoregressive-model,
        ngm:diffusion-model,
        ngm:generative-adversarial-network,
        ngm:normalising-flow,
        ngm:variational-autoencoder ;
    vc:isPartOf ngm:deep-learning,
        ngm:generative-ai ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:density-estimation,
        ngm:foundation-model,
        ngm:large-language-model,
        ngm:representation-learning,
        ngm:score-matching ;
    vc:requires ngm:latent-space,
        ngm:neural-network,
        ngm:probabilistic-inference,
        ngm:training-data ;
    vc:slug "deep-generative-model" ;
    vc:sourceDomain "machine-learning" ;
    vc:uses ngm:attention-mechanism,
        ngm:backpropagation,
        ngm:encoder-decoder-architecture,
        ngm:stochastic-gradient-descent .

ngm:delivery-versus-payment a owl:Class ;
    rdfs:label "Delivery-Versus-Payment"@en ;
    rdfs:comment "Delivery-Versus-Payment (DvP) is a securities settlement mechanism that links the transfer of a financial instrument to the simultaneous transfer of payment, ensuring that delivery occurs if and only if payment occurs, thereby eliminating principal risk in securities transactions. It is the standard settlement model mandated or strongly encouraged by financial market infrastructures globally."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:financial-infrastructure ],
        ngm:payment-system ;
    vc:enables ngm:custody-infrastructure,
        ngm:digital-asset-trading ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:digital-asset-market ;
    vc:requires ngm:financial-infrastructure ;
    vc:slug "delivery-versus-payment" ;
    vc:sourceDomain "finance" ;
    vc:uses ngm:atomic-swap,
        ngm:digital-asset .

ngm:digital-art a owl:Class ;
    rdfs:label "Digital Art"@en ;
    rdfs:comment "Digital art encompasses visual, interactive, and generative artworks created, stored, and distributed using digital technologies as primary medium or tool. It spans a wide range of practices—from pixel painting and vector illustration to algorithmically generated pieces, interactive installations, and AI-synthesised imagery. The form has been transformed by NFT infrastructure, which introduced scarcity and provenance guarantees to inherently copyable digital objects. Digital art sits at the intersection of technological capability and aesthetic intent, continuously expanding as new computational tools emerge."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:digital-rights-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:rendering-pipeline ],
        ngm:ai-application ;
    skos:broader ngm:ai-application ;
    vc:bridgesTo ngm:augmented-reality,
        ngm:decentralised-finance,
        ngm:virtual-reality ;
    vc:contrastsWith ngm:traditional-art ;
    vc:dependsOn ngm:blockchain,
        ngm:cloud-storage ;
    vc:enables ngm:content-creation,
        ngm:creator-economy,
        ngm:digital-asset,
        ngm:virtual-gallery ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:computational-creativity,
        ngm:digital-art-application,
        ngm:digital-ownership,
        ngm:generative-art,
        ngm:interactive-media,
        ngm:nft ;
    vc:requires ngm:digital-rights-management,
        ngm:rendering-pipeline ;
    vc:slug "digital-art" ;
    vc:sourceDomain "metaverse" ;
    vc:supports ngm:decentralised-creative-metaverse-framework,
        ngm:digital-cultural-heritage ;
    vc:uses ngm:creative-ai,
        ngm:creative-software,
        ngm:diffusion-model,
        ngm:generative-adversarial-network,
        ngm:image-generation,
        ngm:smart-contract .

ngm:digital-content a owl:Class ;
    rdfs:label "Digital Content"@en ;
    rdfs:comment "Digital Content encompasses any information or media encoded in digital form, including text, images, audio, video, 3D models, and interactive experiences. Within spatial computing platforms, digital content is the primary artefact that users create, exchange, and monetise, often represented as NFTs or other digital assets with embedded provenance."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:digital-asset ],
        ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:enables ngm:digital-content-creation ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:digital-asset ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:relatedTo ngm:content-moderation,
        ngm:nft ;
    vc:slug "digital-content" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:digital-asset-management .

ngm:digital-identity-verification a owl:Class ;
    rdfs:label "Digital Identity Verification"@en ;
    rdfs:comment "Digital Identity Verification is the remote, automated process of confirming that a person's claimed identity corresponds to a real individual and that the claimant is who they say they are, typically through document analysis, biometric matching, liveness detection, and database cross-referencing. It underpins Know Your Customer (KYC) compliance, onboarding workflows, and access control in digital services."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:know-your-customer ],
        ngm:digital-identity ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:digital-identity-framework,
        ngm:self-sovereign-identity,
        ngm:verifiable-credentials ;
    vc:requires ngm:know-your-customer ;
    vc:slug "digital-identity-verification" ;
    vc:sourceDomain "security" ;
    vc:uses ngm:biometric-authentication,
        ngm:biometric-verification,
        ngm:facial-recognition .

