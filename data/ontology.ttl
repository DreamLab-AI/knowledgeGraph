            owl:someValuesFrom ngm:control-interface ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-synchronization ],
        ngm:metaverse-application-platform,
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:enables ngm:collaborative-systems-modality-design,
        ngm:predictive-maintenance,
        ngm:smart-manufacturing,
        ngm:virtual-commissioning ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:control-interface,
        ngm:digital-twin,
