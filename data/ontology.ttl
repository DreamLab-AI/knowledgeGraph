        <urn:visionflow:linked:critical-safety-incident-reporting>,
        <urn:visionflow:linked:frontier-ai-framework>,
        <urn:visionflow:linked:frontier-model-division>,
        <urn:visionflow:linked:kill-switch-mandate>,
        <urn:visionflow:linked:sb-1047>,
        <urn:visionflow:linked:sb-53>,
        <urn:visionflow:linked:sb-942>,
        <urn:visionflow:linked:whistleblower-protection> ;
    vc:implements <urn:visionflow:linked:critical-harm-framework>,
