    vc:sourceDomain "infrastructure" .

ngm:privacy-preserving-data-mining a owl:Class ;
    rdfs:label "Privacy Preserving Data Mining"@en ;
    rdfs:comment "Privacy-Preserving Data Mining (PPDM) is a research field and collection of techniques that enable extraction of useful knowledge patterns—including association rules, classifiers, clusters, and outliers—from datasets while preventing disclosure of sensitive individual records. PPDM methods span data perturbation (noise addition, randomisation, synthetic data generation before mining), cryptographic protocols (secure multi-party computation for distributed pattern discovery, homomorphic encryption for encrypted operations), anonymisation transformations (k-anonymity, l-diversity, t-closeness applied before dataset release), and differential-privacy query mechanisms that inject calibrated noise into published pattern outputs. The field navigates an inherent privacy–utility trade-off: stronger privacy guarantees typically reduce pattern accuracy, and compositions of multiple analyses risk cumulative information leakage through inference and re-identification attacks."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:secure-multi-party-computation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:differential-privacy ],
        ngm:ai-governance-and-ethics ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:enables ngm:data-sharing,
        ngm:privacy ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:data-pipeline,
        ngm:membership-inference,
        ngm:model-inversion,
        ngm:pattern-recognition ;
    vc:requires ngm:differential-privacy,
        ngm:secure-multi-party-computation ;
    vc:slug "privacy-preserving-data-mining" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:data-protection,
        ngm:homomorphic-encryption-for-machine-learning ;
    vc:uses ngm:anomaly-detection,
        ngm:federated-learning,
        ngm:synthetic-data .

ngm:privacy-regulation a owl:Class ;
    rdfs:label "Privacy Regulation"@en ;
    rdfs:comment "Privacy regulation refers to the body of laws and rules that govern how organisations collect, process, store, and share personal data, granting individuals rights over information about them. Such regulation establishes lawful bases for processing, mandates transparency and security obligations, and provides for enforcement and penalties for non-compliance. Prominent examples set global benchmarks for data subject rights, consent, and accountability, shaping how digital products handle personal information across jurisdictions."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:consent-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-subject-rights ],
        ngm:data-protection-regulation ;
    vc:bridgesTo ngm:data-governance ;
    vc:contrastsWith ngm:surveillance ;
    vc:dependsOn ngm:regulation ;
    vc:enables ngm:compliance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:data-protection,
        ngm:privacy-by-design ;
    vc:isPartOf ngm:data-protection-regulation,
        ngm:regulatory-compliance ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:ccpa,
        ngm:data-governance,
        ngm:gdpr,
        ngm:privacy ;
    vc:requires ngm:consent-management,
        ngm:data-subject-rights ;
    vc:slug "privacy-regulation" ;
    vc:sourceDomain "data" ;
    vc:supports ngm:data-subject-rights,
        ngm:privacy .

ngm:probabilistic-robotics a owl:Class ;
    rdfs:label "Probabilistic Robotics"@en ;
    rdfs:comment "Probabilistic robotics is an approach to robot perception and control that represents uncertainty explicitly using probability distributions, and reasons about state and action through Bayesian estimation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:uncertainty-quantification ],
        [ a owl:Restriction ;
