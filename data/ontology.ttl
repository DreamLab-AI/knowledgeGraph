        ngm:authorisation,
        ngm:least-privilege ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:separation-of-duties ;
    vc:implements ngm:access-control-policy,
        ngm:ansi-incits-359 ;
    vc:qualityScore "0.72"^^xsd:float ;
