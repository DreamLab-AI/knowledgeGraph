ngm:multi-view-images a owl:Class ;
    rdfs:comment "Multi-View Images are a set of photographs or renders of the same scene or object captured from multiple, known or estimable camera positions, providing the geometric overlap needed to reconstruct three-dimensional structure. They are the primary input to photogrammetry, novel view synthesis, and neural scene representations such as NeRFs and 3D Gaussian splats. Reconstruction accuracy improves with greater viewpoint coverage and more precise camera calibration."@en ;
    rdfs:label "Multi-View Images"@en ;
    rdfs:subClassOf ngm:3-d-reconstruction ;
    vc:hasMaturity ngmi:maturity-established ;
