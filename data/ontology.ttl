ngm:virtual-theater a owl:Class ;
    rdfs:label "Virtual Theater"@en ;
    rdfs:comment "A form of immersive performing arts that uses VR headsets and virtual environments to present theatrical productions, enabling audiences to experience performances as silent observers within the scene, with some productions featuring interactive narratives where story outcomes depend on audience ..."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:virtual-reality ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:immersive-audio-technology ],
        ngm:performing-arts,
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:enables ngm:accessibility,
        ngm:immersive-experience ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:performing-arts ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:requires ngm:immersive-audio-technology,
        ngm:virtual-reality ;
    vc:slug "virtual-theater" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:avatar,
        ngm:rendering-pipeline,
        ngm:spatial-audio .

ngm:virtual-transactions a owl:Class ;
    rdfs:label "Virtual Transactions"@en ;
    rdfs:comment "Virtual transactions are exchanges of value conducted entirely within digital environments, transferring virtual currency, tokens or digital goods between participants. They power in-world economies in games and metaverse platforms and rely on digital payment systems and currencies for settlement. Their integrity depends on secure accounting, fraud prevention and clear ownership semantics."@en ;
    rdfs:subClassOf ngm:virtual-economy ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:digital-currency,
        ngm:digital-payment-system ;
    vc:slug "virtual-transactions" ;
    vc:sourceDomain "metaverse" .

ngm:virtual-try-on a owl:Class ;
    rdfs:label "Virtual Try-On"@en ;
    rdfs:comment "Virtual try-on is a computer vision and graphics technique that overlays clothing, accessories, or cosmetics onto an image or video of a person so they can preview how an item would look."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:computer-vision ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:image-generation ],
        ngm:computer-vision ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:computer-vision,
        ngm:image-generation ;
    vc:slug "virtual-try-on" ;
    vc:sourceDomain "machine-learning" .

ngm:virtual-world-operation a owl:Class ;
    rdfs:label "Virtual World Operation"@en ;
    rdfs:comment "Virtual world operation is the ongoing technical and administrative running of a persistent virtual environment, including server orchestration, state synchronisation, content updates, moderation and economy management. It keeps the world available, consistent and safe for concurrent users across sessions. Operation is the runtime layer that realises the design encoded in a metaverse architecture or stack."@en ;
    rdfs:subClassOf ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:metaverse-architecture,
        ngm:metaverse-stack ;
    vc:slug "virtual-world-operation" ;
    vc:sourceDomain "metaverse" .

ngm:virtual-world-traversal a owl:Class ;
    rdfs:label "Virtual World Traversal"@en ;
    rdfs:comment "Virtual World Traversal is the set of techniques, interfaces, and protocols that enable users and agents to navigate between and within persistent virtual environments in the metaverse — including scene transitions, cross-world identity portability, spatial audio transitions, and continuous presence mechanics."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:virtual-presence ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:navigation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:avatar-system ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:virtual-environment ],
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:metaverse-technology ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:metaverse,
        ngm:open-world,
        ngm:scene-management,
        ngm:spatial-audio,
        ngm:virtual-world,
        ngm:world-building ;
    vc:requires ngm:avatar-system,
        ngm:navigation,
        ngm:virtual-environment,
        ngm:virtual-presence ;
    vc:slug "virtual-world-traversal" ;
    vc:sourceDomain "spatial-computing" .

ngm:vision-claw-agentic-container a owl:Class ;
    rdfs:label "VisionClaw Agentic Container"@en ;
    rdfs:comment "A Sovereign Mesh|sovereign, manifest-driven agentic runtime container that orchestrates DID Nostr Identity|DID Nostr agents across a decentralised Peer-to-Peer Network|peer-to-peer network, enabling autonomous agents to operate with verifiable credentials, pluggable adapters, and cont..."@en ;
