    vc:slug "tc-0002-collaborative-document-editing" ;
    vc:sourceDomain "distributed-collaboration" .

ngm:tendermint-consensus a owl:Class ;
    rdfs:label "Tendermint Consensus"@en ;
    rdfs:comment "Tendermint Consensus is a Byzantine Fault Tolerant consensus engine that combines Practical Byzantine Fault Tolerance (PBFT) with Proof-of-Stake validator sets to achieve immediate block finality and high transaction throughput. It underpins the Cosmos ecosystem and enables inter-blockchain communication by guaranteeing that committed blocks are never reverted, eliminating the probabilistic finality of Proof-of-Work chains."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:proof-of-stake ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:validator-node ],
        ngm:bc-protocol-and-consensus,
        ngm:byzantine-fault-tolerance ;
    skos:broader ngm:bc-protocol-and-consensus ;
    vc:contrastsWith ngm:delegated-proof-of-stake,
        ngm:proof-of-work ;
    vc:enables ngm:blockchain-interoperability,
        ngm:cosmos-ibc ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:blockchain-protocol ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:blockchain-scalability,
        ngm:consensus-mechanism,
        ngm:low-energy-consumption ;
    vc:requires ngm:proof-of-stake,
        ngm:validator-node ;
    vc:slug "tendermint-consensus" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:cryptographic-hash,
        ngm:digital-signature .

ngm:tensor-flow-lite a owl:Class ;
    rdfs:label "TensorFlow Lite"@en ;
    rdfs:comment "TensorFlow Lite (now rebranded as LiteRT) is Google's open-source deep learning inference framework designed for on-device execution of machine learning models on mobile, embedded, and IoT edge hardware. It converts full TensorFlow or ONNX models into a FlatBuffers-based .tflite format and provides a lightweight interpreter that minimises memory footprint and latency without requiring network connectivity. The framework supports post-training optimisation techniques including quantisation, pruning, and weight clustering, and exposes hardware-acceleration delegates for GPUs, DSPs, NPUs, and the Coral Edge TPU. Its sister project TensorFlow Lite Micro (TFLite Micro) extends the same programming model to bare-metal microcontrollers with as little as 256 KB of RAM."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:deep-learning ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:machine-learning-discipline ],
        ngm:machine-learning-discipline-framework ;
    vc:bridgesTo ngm:augmented-reality,
        ngm:internet-of-things ;
    vc:contrastsWith ngm:core-ml,
        ngm:onnx-runtime,
        ngm:pytorch-mobile ;
    vc:dependsOn ngm:edge-computing,
        ngm:mobile-computing ;
    vc:enables ngm:edge-inference,
        ngm:on-device-learning,
        ngm:privacy-preserving-inference,
        ngm:real-time-inference ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:tensorflow-lite-micro ;
    vc:implements ngm:neural-network-inference,
        ngm:onnx ;
    vc:isPartOf ngm:tensor-flow ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:federated-learning,
        ngm:model-compression,
        ngm:transfer-learning ;
    vc:requires ngm:deep-learning,
        ngm:machine-learning-discipline ;
    vc:slug "tensor-flow-lite" ;
    vc:sourceDomain "machine-learning" ;
    vc:supports ngm:android,
        ngm:coral-edge-tpu,
        ngm:ios,
        ngm:microcontroller ;
    vc:uses ngm:hardware-acceleration,
        ngm:neural-network,
        ngm:neural-network-quantisation .

ngm:test-dataset a owl:Class ;
    rdfs:label "Test Dataset"@en ;
    rdfs:comment "A test dataset is a partition of data held out from model training and used exclusively to provide an unbiased estimate of a trained model's performance on unseen examples. Unlike the training and validation sets, it is touched only once final hyperparameters are fixed, preventing the leakage that would inflate reported accuracy. Its disjointness from training data is what makes it a credible measure of generalisation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:model-evaluation ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:supervised-learning ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:machine-learning ],
        ngm:machine-learning ;
    vc:bridgesTo ngm:cross-validation ;
    vc:contrastsWith ngm:training-dataset ;
    vc:dependsOn ngm:training-dataset ;
    vc:enables ngm:model-evaluation,
        ngm:model-performance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:supervised-learning ;
    vc:isPartOf ngm:machine-learning ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:hyperparameter-tuning,
        ngm:overfitting ;
    vc:requires ngm:machine-learning,
        ngm:model-evaluation ;
    vc:slug "test-dataset" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:model-performance ;
    vc:uses ngm:cross-validation .

ngm:testing-process a owl:Class ;
    rdfs:label "Testing Process"@en ;
    rdfs:comment "Systematic execution of verification and validation operations to detect faults, verify functionality, and ensure quality standards in metaverse systems and applications."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:integration-testing ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:unit-testing ],
        [ a owl:Restriction ;
