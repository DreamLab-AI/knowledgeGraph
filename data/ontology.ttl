ngm:ai-alignment a owl:Class ;
    rdfs:label "AI Alignment"@en ;
    rdfs:comment "The process of making AI systems' behaviour and goals consistent with human values, preferences, and intentions. AI alignment encompasses technical mods and research aimed at ensuring AI systems act in accordance with human interests, even as they become more capable."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
