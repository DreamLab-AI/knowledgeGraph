        ngm:iso-12100,
        ngm:robot-safety,
        ngm:safety-case,
        ngm:service-robot ;
    vc:requires ngm:rb-0094-power-and-force-limiting,
        ngm:safety-engineering ;
    vc:slug "iso-13482" ;
    vc:sourceDomain "robotics" ;
    vc:standardizedBy ngm:international-electrotechnical-commission,
        ngm:iso ;
    vc:supports ngm:exoskeleton,
        ngm:rehabilitation-robotics ;
    vc:uses ngm:hazard-analysis,
        ngm:rb-0088-iso-13482-compliance,
        ngm:risk,
        ngm:risk-assessment .

ngm:kademlia-dht a owl:Class ;
    rdfs:label "Kademlia DHT"@en ;
    rdfs:comment "Kademlia DHT is a distributed hash table protocol introduced by Petar Maymounkov and David Mazières in 2002 that organises participating nodes into a structured peer-to-peer overlay network using XOR metric distances between 160-bit node identifiers, enabling efficient O(log n) key-value lookup, storage, and routing with provable convergence guarantees. Each node maintains a routing table of k-buckets covering progressively finer-grained regions of the identifier space, and uses iterative or recursive RPC-based lookups to locate the nodes closest to a target key in at most O(log n) network hops. Kademlia's XOR metric is the defining technical innovation that enables symmetric routing—every lookup converges along the same path regardless of direction—making it the most widely deployed DHT protocol underlying BitTorrent, Ethereum, IPFS, and numerous other decentralised systems."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:routing-table ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:peer-to-peer-network ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:bootstrap-node ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:remote-procedure-call ],
        ngm:distributed-hash-table ;
    vc:bridgesTo ngm:blockchain,
        ngm:distributed-collaboration ;
    vc:dependsOn ngm:cryptographic-hash-function,
        ngm:distributed-hash-table ;
    vc:enables ngm:decentralised-storage,
        ngm:filecoin,
        ngm:ipfs,
        ngm:libp2p,
        ngm:peer-discovery ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:k-bucket,
        ngm:node-identifier,
        ngm:routing-table,
        ngm:xor-metric ;
    vc:implements ngm:distributed-system-protocol,
        ngm:overlay-network ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:distributed-system,
        ngm:eclipse-attack,
        ngm:sybil-attack ;
    vc:requires ngm:bootstrap-node,
        ngm:peer-to-peer-network,
        ngm:remote-procedure-call ;
    vc:slug "kademlia-dht" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:distributed-systems,
        ngm:udp .

ngm:large-language-model-training a owl:Class ;
    rdfs:label "Large Language Model Training"@en ;
    rdfs:comment "Large Language Model Training is the computational process of optimising the parameters of a transformer-based neural network with billions to trillions of weights on web-scale text corpora using autoregressive next-token prediction objectives, followed by instruction tuning and reinforcement learning from human feedback (RLHF) alignment stages. The process requires distributed training across thousands of GPU or TPU accelerators coordinated through data, tensor, and pipeline parallelism, consuming petabytes of training data and megawatt-hours of electrical energy."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gpu-cluster ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:supervised-fine-tuning ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:pre-training ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:alignment ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:mixed-precision-training ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:training-data ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:distributed-training ],
        ngm:pre-training ;
    vc:bridgesTo ngm:data-centre,
        ngm:high-performance-computing ;
    vc:contrastsWith ngm:parameter-efficient-fine-tuning ;
    vc:dependsOn ngm:reward-model,
        ngm:scaling-laws,
        ngm:tokenization ;
    vc:enables ngm:emergent-capabilities,
        ngm:fine-tuning,
        ngm:foundation-model,
        ngm:in-context-learning ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:alignment,
        ngm:pre-training,
        ngm:supervised-fine-tuning ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:mixture-of-experts-architecture,
        ngm:synthetic-data-generation ;
    vc:requires ngm:distributed-training,
        ngm:gpu-cluster,
        ngm:mixed-precision-training,
        ngm:training-data ;
    vc:slug "large-language-model-training" ;
    vc:sourceDomain "machine-learning" ;
    vc:uses ngm:data-parallelism,
        ngm:direct-preference-optimisation,
        ngm:gradient-checkpointing,
        ngm:instruction-tuning,
        ngm:reinforcement-learning-from-human-feedback,
        ngm:stochastic-gradient-descent,
        ngm:transformer .

ngm:large-scale-compute a owl:Class ;
    rdfs:label "Large-Scale Compute"@en ;
    rdfs:comment "Large-scale compute refers to the aggregation of massive computational resources — spanning thousands to hundreds of thousands of processors, accelerators, and memory modules — into coordinated systems capable of executing workloads at magnitudes that are impractical for single machines or small clusters, including the training of frontier AI models, climate simulation, drug discovery, and national security applications. It encompasses the physical infrastructure (data centres, power supply, cooling), interconnect fabrics (InfiniBand, NVLink, custom optical networks), software orchestration layers (job schedulers, distributed training frameworks), and the operational expertise required to sustain utilisation and reliability at exascale levels."@en ;
    rdfs:subClassOf ngm:computational-infrastructure ;
    vc:enables ngm:distributed-training,
        ngm:machine-learning-discipline-infrastructure,
        ngm:model-training ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:distributed-computing,
        ngm:gpu-compute,
        ngm:high-performance-computing ;
    vc:slug "large-scale-compute" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:cloud-computing,
        ngm:gpu-computing,
        ngm:tensor-processing-unit .

ngm:lo-ra-fine-tuning a owl:Class ;
    rdfs:label "LoRA Fine-Tuning"@en ;
    rdfs:comment "LoRA (Low-Rank Adaptation) fine-tuning is a parameter-efficient fine-tuning technique that adapts large pre-trained transformer models by inserting pairs of trainable low-rank matrices (A ∈ ℝ^{d×r} and B ∈ ℝ^{r×d}, where r ≪ d) alongside frozen weight matrices in selected layers, so that the effective weight update ΔW = BA is constrained to a low-dimensional subspace. By training only the injected adapter matrices — typically representing 0.1–1% of the original parameter count — LoRA achieves near full fine-tuning performance at a fraction of the GPU memory and compute cost, enabling adaptation of billion-parameter models on consumer hardware. It is now the dominant technique in the PEFT ecosystem and is implemented in Hugging Face's PEFT library."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:large-language-models ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:pre-training ],
        ngm:ai-technique,
        ngm:parameter-efficient-fine-tuning ;
    skos:broader ngm:ai-technique ;
    vc:enables ngm:domain-adaptation,
        ngm:fine-tuning ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:model-training,
        ngm:quantisation ;
    vc:requires ngm:large-language-models,
        ngm:pre-training ;
    vc:slug "lo-ra-fine-tuning" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:low-latency-networking a owl:Class ;
    rdfs:label "Low-Latency Networking"@en ;
    rdfs:comment "Low-latency networking is the design and operation of network architectures that minimise the round-trip delay between communicating endpoints, typically targeting single-digit or sub-millisecond latencies. It combines edge placement, optimised transport protocols, traffic prioritisation and predictable routing to support interactive and time-critical workloads. In spatial computing it underpins responsive immersive experiences where perceptual lag must remain below human-detectable thresholds."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:quality-of-service ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:network-latency ],
        ngm:network-infrastructure ;
    vc:dependsOn ngm:edge-computing,
        ngm:network-protocol ;
    vc:enables ngm:cloud-gaming,
        ngm:cloud-rendering,
        ngm:metaverse-infrastructure,
        ngm:real-time-rendering,
        ngm:teleoperation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:network-infrastructure ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:latency,
        ngm:network-infrastructure ;
    vc:requires ngm:network-latency,
        ngm:quality-of-service ;
    vc:slug "low-latency-networking" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:spatial-computing ;
    vc:uses ngm:content-delivery-network .

ngm:maker-dao a owl:Class ;
    rdfs:label "MakerDAO"@en ;
    rdfs:comment "MakerDAO is a decentralised autonomous organisation (DAO) on the Ethereum blockchain that governs the Maker Protocol — a system of smart contracts enabling users to generate the DAI stablecoin by locking over-collateralised assets in Vaults (formerly Collateralised Debt Positions). Governance decisions covering collateral onboarding, stability fees, liquidation ratios, and debt ceilings are enacted by MKR token holders through on-chain Executive Votes. As one of the earliest large-scale deployments of DAO governance and algorithmic stablecoin issuance, MakerDAO is a foundational pillar of decentralised finance (DeFi) and continues to evolve through its Endgame restructuring into a constellation of SubDAOs."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:over-collateralisation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:oracle-network ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
