ngm:hash-collision a owl:Class ;
    rdfs:label "Hash Collision"@en ;
    rdfs:comment "A hash collision occurs when two distinct inputs produce the same output from a cryptographic hash function, violating the collision-resistance property that is essential to blockchain data integrity. In blockchain systems, collision resistance ensures that no adversary can craft two different transactions or blocks yielding the same hash digest, making Merkle tree roots and block headers tamper-evident. While collisions are computationally infeasible for production-grade functions such as SHA-256, their theoretical possibility drives ongoing cryptographic research and post-quantum security planning."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptography ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptographic-primitive ],
        ngm:bc-cryptographic-primitive,
        ngm:blockchain-entity,
        ngm:cryptographic-primitive ;
    skos:broader ngm:bc-cryptographic-primitive ;
    vc:contrastsWith ngm:collision-resistance,
        ngm:cryptographic-commitment ;
    vc:enables ngm:adversarial-attack,
        ngm:attack-vector ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:bc-cryptographic-primitive,
        ngm:cryptography-security-and-privacy ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:blockchain-transaction,
        ngm:cryptographic-hash,
        ngm:cryptographic-hash-function,
        ngm:cryptographic-security ;
    vc:requires ngm:cryptographic-primitive,
        ngm:cryptography ;
    vc:slug "hash-collision" ;
    vc:sourceDomain "blockchain" .

ngm:hash-functions a owl:Class ;
    rdfs:label "Hash Functions"@en ;
    rdfs:comment "Hash functions are algorithms that map data of arbitrary size to a fixed-size output, with cryptographic hash functions designed to be one-way and collision resistant. They are central to security and blockchains."@en ;
    rdfs:subClassOf ngm:cryptography ;
    vc:enables ngm:merkle-tree,
        ngm:transaction-validation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:slug "hash-functions" ;
    vc:sourceDomain "security" .

