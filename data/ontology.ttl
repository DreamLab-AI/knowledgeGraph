    vc:slug "direct3d" ;
    vc:sourceDomain "spatial-computing" ;
    vc:standardizedBy ngm:directx ;
    vc:supports ngm:ray-tracing,
        ngm:texture-mapping ;
    vc:uses ngm:gpu,
        ngm:shader .

ngm:display-metrology a owl:Class ;
    rdfs:label "Display Metrology"@en ;
    rdfs:comment "Standardized measurement equipment and instruments for assessing visual performance parameters of XR displays, including colorimeters, photometers, and specialised testing hardware."@en ;
