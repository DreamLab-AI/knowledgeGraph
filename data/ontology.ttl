    skos:broader ngm:infra-computing-and-cloud ;
    vc:enables ngm:ai-infrastructure,
        ngm:orchestration ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:gpu-compute,
        ngm:network-infrastructure,
        ngm:networking-infrastructure,
        ngm:storage-infrastructure ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:cloud-infrastructure,
        ngm:digital-infrastructure,
        ngm:distributed-computing,
        ngm:edge-computing ;
    vc:slug "computing-infrastructure" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:power-management,
        ngm:sustainability .

ngm:cryptographic-key a owl:Class ;
    rdfs:label "Cryptographic Key"@en ;
    rdfs:comment "A piece of secret or public information that parameterises a cryptographic algorithm, determining how data is encrypted, decrypted or signed. Keys are the inputs that make cryptographic operations specific and reversible only to authorised parties."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
