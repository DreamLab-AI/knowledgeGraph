ngm:bitcoin-lightning-network a owl:Class ;
    rdfs:label "Bitcoin Lightning Network"@en ;
    rdfs:comment "The Bitcoin Lightning Network is a layer-two payment protocol built on top of Bitcoin that enables fast, low-cost transactions through bidirectional payment channels. Two parties lock funds in a multisignature channel and exchange signed balance updates off-chain, settling the final state on the Bitcoin blockchain only when the channel closes. Payments can be routed across a network of connected channels, allowing transfers between parties that do not share a direct channel."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:htlc ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:multisignature ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:payment-channel ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:bitcoin ],
        ngm:blockchain-domain ;
    vc:enables ngm:instant-settlement,
        ngm:micropayments ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:htlc,
        ngm:payment-channel ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:bitcoin,
        ngm:multisignature ;
    vc:slug "bitcoin-lightning-network" ;
    vc:sourceDomain "bitcoin-lightning-network" .

ngm:bitcoin-ordinals a owl:Class ;
    rdfs:label "Bitcoin Ordinals"@en ;
    rdfs:comment "Bitcoin Ordinals is a numbering scheme and inscription protocol that assigns a unique serial number to every individual satoshi on the Bitcoin network based on the order of its mining, enabling arbitrary content — text, images, code — to be embedded directly into Bitcoin transactions via the witness data introduced by SegWit and Taproot. Each inscription is permanently stored on-chain without requiring a separate token contract, making it a native non-fungible artefact within the Bitcoin base layer. The protocol was introduced by Casey Rodarmor in January 2023."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:bitcoin-core ],
        ngm:bitcoin-network ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:digital-art,
        ngm:digital-asset,
        ngm:nft ;
    vc:requires ngm:bitcoin-core ;
    vc:slug "bitcoin-ordinals" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:bitcoin-script,
        ngm:blockchain-transaction .

ngm:bitstring-status-list a owl:Class ;
    rdfs:label "Bitstring Status List"@en ;
    rdfs:comment "Bitstring Status List is a W3C specification for expressing the revocation or suspension status of Verifiable Credentials through a compressed, publicly-hosted bitstring in which each credential is assigned a position index; setting that bit to 1 indicates revocation without disclosing which specific credential holder triggered the change. The mechanism is privacy-preserving because verifiers observe only a large compressed list, not individual credential identifiers. It supersedes the earlier Credential Status List 2021 specification and is designed to be bandwidth-efficient and herd-privacy-compatible."@en ;
    rdfs:subClassOf ngm:revocation-mechanism ;
    vc:enables ngm:credential-verification ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:decentralised-identity,
        ngm:revocation-registry ;
    vc:slug "bitstring-status-list" ;
    vc:sourceDomain "governance" ;
    vc:standardizedBy ngm:verifiable-credential-standard ;
    vc:uses ngm:cryptographic-hash,
        ngm:verifiable-credentials .

ngm:blake3 a owl:Class ;
    rdfs:label "BLAKE3"@en ;
    rdfs:comment "BLAKE3 is a cryptographic hash function released in 2020 that achieves exceptional speed through a tree-hashing construction enabling unlimited parallelism across SIMD lanes and CPU cores, while simultaneously functioning as a keyed hash, a key derivation function, and an extendable-output function (XOF). It is derived from the BLAKE2 family, inheriting its ARX (add-rotate-XOR) ChaCha-based compression function, and extends it with a Bao-style binary tree that allows verified streaming and incremental hashing. BLAKE3 produces digests of arbitrary length (defaulting to 256 bits), is formally specified under a Creative Commons public-domain dedication, and is designed to be faster than SHA-256 on modern hardware by factors of five to ten on multi-core systems. Its unified API replaces the need for separate HMAC, HKDF, or KDF constructions."@en ;
    rdfs:subClassOf ngm:cryptographic-hash-function ;
    vc:enables ngm:content-addressing,
        ngm:cryptographic-verification ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:blake2,
        ngm:cryptographic-hash,
        ngm:data-integrity,
        ngm:merkle-tree ;
    vc:slug "blake3" ;
    vc:sourceDomain "security" ;
    vc:uses ngm:cryptographic-primitive,
        ngm:hardware-acceleration .

ngm:bleu-score a owl:Class ;
    rdfs:label "BLEU Score"@en ;
    rdfs:comment "BLEU Score (Bilingual Evaluation Understudy) is an automatic evaluation metric for machine translation and text generation quality that measures the overlap of n-gram sequences between a candidate output and one or more human reference translations, applying a brevity penalty to discourage pathologically short outputs. Scores range from 0 to 1 (or 0 to 100 in percentage form), with higher values indicating closer correspondence to the reference. BLEU correlates moderately with human judgement at the corpus level but is known to be unreliable for single-sentence evaluation and insufficient alone for capturing semantic adequacy."@en ;
    rdfs:subClassOf ngm:evaluation-metric ;
    vc:contrastsWith ngm:evaluation-harness ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:benchmarks,
        ngm:language-model,
        ngm:text-generation ;
    vc:slug "bleu-score" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:machine-translation,
        ngm:natural-language-processing .

ngm:blip-2-captioner a owl:Class ;
    rdfs:label "BLIP-2 Captioner"@en ;
    rdfs:comment "BLIP-2 is a vision-language model that bridges a frozen image encoder and a frozen large language model with a lightweight Querying Transformer (Q-Former), and a BLIP-2 captioner uses this model to generate natural-language descriptions of images. It produces high-quality captions efficiently because only the Q-Former is trained, leaving the heavy backbones fixed. Such captioners are commonly used to auto-label image datasets for training diffusion models and fine-tuning pipelines."@en ;
    rdfs:subClassOf ngm:computer-vision ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:kohya-dreambooth-and-similar ;
    vc:slug "blip-2-captioner" ;
    vc:sourceDomain "ai" .

ngm:block-propagation-time a owl:Class ;
    rdfs:label "Block Propagation Time"@en ;
    rdfs:comment "Block Propagation Time is the latency metric measuring how long it takes for a newly mined or validated block to be disseminated to all (or a target percentage of) nodes in a blockchain peer-to-peer network after its initial announcement. It is a critical determinant of blockchain security and throughput: long propagation times increase the probability of temporary forks (stale/orphan blocks), waste miner effort, and reduce effective network throughput. Bitcoin historically achieved median propagation times of approximately 1–2 seconds to reach 50% of nodes, while Ethereum's uncle mechanism tolerated higher latency by including competing blocks in the canonical chain."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gossip-protocol ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:block-propagation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:peer-to-peer-network ],
        ngm:bc-protocol-and-consensus,
        ngm:blockchain-entity,
        ngm:network-component ;
    skos:broader ngm:bc-protocol-and-consensus ;
    vc:contrastsWith ngm:proof-of-stake ;
    vc:enables ngm:consensus-mechanism,
        ngm:fork-choice-rule ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:block-propagation ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:blockchain-infrastructure,
        ngm:blockchain-network,
        ngm:blockchain-scalability,
        ngm:consensus-algorithm,
        ngm:network-latency,
        ngm:proof-of-work ;
    vc:requires ngm:gossip-protocol,
        ngm:peer-to-peer-network ;
    vc:slug "block-propagation-time" ;
    vc:sourceDomain "blockchain" .

ngm:block-reward-halving a owl:Class ;
    rdfs:label "Block Reward Halving"@en ;
    rdfs:comment "The block reward halving is the protocol rule in Bitcoin and similar proof-of-work chains that cuts the newly minted coin subsidy paid to miners in half at fixed block intervals, roughly every four years for Bitcoin. This geometric reduction enforces a predictable, disinflationary issuance schedule that converges on a fixed total supply of 21 million bitcoin. Halvings are central to Bitcoin's scarcity narrative and have historically been focal points for market and security-budget analysis."@en ;
    rdfs:subClassOf ngm:economic-mechanism ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:bitcoin-value-proposition ;
    vc:slug "block-reward-halving" ;
    vc:sourceDomain "blockchain" .

ngm:bode-plot a owl:Class ;
    rdfs:label "Bode Plot"@en ;
    rdfs:comment "A Bode Plot is a pair of frequency-domain graphs used in control engineering and signal analysis to characterise the frequency response of a linear time-invariant system: one graph plots the magnitude of the system's transfer function in decibels against log-frequency, and the second plots the phase angle in degrees against log-frequency. Together they reveal gain margins, phase margins, bandwidth, and resonant behaviour, making Bode plots the primary graphical tool for assessing open-loop stability and designing compensators."@en ;
    rdfs:subClassOf ngm:control-system ;
    vc:enables ngm:pid-controller,
        ngm:stability-analysis ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:feedback-control,
        ngm:feedback-loop ;
    vc:slug "bode-plot" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:signal-processing,
        ngm:transfer-function .

ngm:bolt-12 a owl:Class ;
    rdfs:label "BOLT12"@en ;
    rdfs:comment "BOLT12 is a Lightning Network specification that defines offers, a reusable payment request format that improves on single-use invoices. It supports recurring and static payment requests."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:bolt ],
        ngm:bolt ;
    vc:enables ngm:phoenix ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:bolt ;
    vc:slug "bolt-12" ;
    vc:sourceDomain "blockchain" .

ngm:bolt12-offers a owl:Class ;
    rdfs:label "BOLT12 Offers"@en ;
    rdfs:comment "BOLT12 Offers is a Lightning Network specification defining reusable, static payment requests called offers, improving on single-use BOLT11 invoices. An offer is a long-lived, shareable code from which payers fetch a fresh invoice on demand via onion messages, enabling recurring payments, refunds, and donation links without a server issuing each invoice. It also improves privacy through blinded paths that hide the recipient's node identity."@en ;
    rdfs:subClassOf ngm:lightning-network ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:lightning-network ;
    vc:slug "bolt12-offers" ;
    vc:sourceDomain "blockchain" .

ngm:boosting a owl:Class ;
    rdfs:label "Boosting"@en ;
    rdfs:comment "A sequential ensemble learning technique that combines multiple weak learners into a strong predictor by iteratively training each new model to correct the errors of its predecessors. Instance weights are adjusted after each round so that misclassified examples receive more attention; the final prediction is a weighted vote across all weak learners. Key algorithms include AdaBoost, Gradient Boosting, XGBoost, LightGBM, and CatBoost."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:machine-learning ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:training-data ],
        ngm:ai-technique,
        ngm:ensemble-methods ;
    skos:broader ngm:ai-technique ;
    vc:contrastsWith ngm:deep-learning ;
    vc:enables ngm:overfitting ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:requires ngm:machine-learning,
        ngm:training-data ;
    vc:slug "boosting" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:gradient-descent,
        ngm:regularisation .

ngm:brc-20 a owl:Class ;
    rdfs:label "BRC-20"@en ;
    rdfs:comment "An experimental token standard on Bitcoin that records fungible token operations as JSON inscriptions using ordinal theory."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ordinals ],
        ngm:token-standard ;
    vc:enables ngm:fungible-token ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:ordinals ;
    vc:slug "brc-20" ;
    vc:sourceDomain "blockchain" .

ngm:brdf a owl:Class ;
    rdfs:label "BRDF"@en ;
    rdfs:comment "A Bidirectional Reflectance Distribution Function (BRDF) is a function that defines how light is reflected at an opaque surface, giving the ratio of reflected radiance to incident irradiance for each pair of incoming and outgoing directions. It encodes material appearance such as diffuse, glossy, and specular behaviour and is the core of physically based shading. Renderers evaluate the BRDF at surface intersections to compute realistic light transport."@en ;
    rdfs:subClassOf ngm:rendering-technique ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:ray-tracing ;
    vc:slug "brdf" ;
    vc:sourceDomain "metaverse" .

ngm:browser-based-screen-capture a owl:Class ;
    rdfs:label "Browser-Based Screen Capture"@en ;
    rdfs:comment "Browser-based screen capture is the in-browser acquisition of screen, window, or tab video using web APIs such as the Screen Capture API (getDisplayMedia), without installing native software. The captured MediaStream can be recorded locally, encoded, or streamed in real time over WebRTC, making it the foundation for web conferencing, asynchronous video messaging, and screen recording tools. It runs under explicit user permission and within the browser's security sandbox."@en ;
    rdfs:subClassOf ngm:dc-telepresence ;
    skos:broader ngm:dc-telepresence ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:asynchronous-video,
        ngm:screen-recording ;
    vc:slug "browser-based-screen-capture" ;
    vc:sourceDomain "infrastructure" .

ngm:building-automation a owl:Class ;
    rdfs:label "Building Automation"@en ;
    rdfs:comment "Building Automation refers to the centralised monitoring and control of a building's mechanical, electrical, and environmental systems — including heating, ventilation, air conditioning, lighting, access control, and fire safety — through networked sensor-actuator architectures and programmable control logic. It aims to optimise occupant comfort, reduce energy consumption, and enable remote facility management via integrated software platforms."@en ;
    rdfs:subClassOf ngm:industrial-automation ;
    vc:enables ngm:digital-twin,
        ngm:energy-management ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:access-control-system ;
    vc:slug "building-automation" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:actuators,
        ngm:embedded-systems,
        ngm:zigbee .

ngm:bullet-physics a owl:Class ;
    rdfs:label "Bullet Physics"@en ;
    rdfs:comment "Bullet Physics is an open-source, real-time physics simulation library that provides collision detection, rigid body dynamics, and soft body simulation for use in games, robotics, visual effects, and scientific computing. Originally developed by Erwin Coumans, it implements discrete and continuous collision detection alongside a constraint solver, enabling physically plausible interactions between complex 3D geometries at interactive frame rates."@en ;
    rdfs:subClassOf ngm:physics-engine ;
    vc:enables ngm:fluid-simulation,
        ngm:rigid-body-dynamics,
        ngm:soft-body-dynamics ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:game-development,
        ngm:game-engine ;
    vc:slug "bullet-physics" ;
    vc:sourceDomain "spatial" ;
    vc:uses ngm:collision-detection,
        ngm:constraint-solver .

ngm:business-logic-layer a owl:Class ;
    rdfs:label "Business Logic Layer"@en ;
    rdfs:comment "The Business Logic Layer (BLL) is the architectural tier in a multi-tier application that encapsulates domain rules, workflows, and computations specific to the problem domain, sitting between the presentation layer and the data access layer. It is responsible for validating inputs, enforcing business constraints, orchestrating data transformations, and coordinating service calls, ensuring that domain invariants are maintained independently of user interface or persistence concerns."@en ;
    rdfs:subClassOf ngm:service-layer ;
    vc:dependsOn ngm:data-layer ;
    vc:enables ngm:workflow-automation ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:microservices-architecture,
        ngm:service-oriented-architecture ;
    vc:slug "business-logic-layer" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:application-layer ;
    vc:uses ngm:middleware .

ngm:cable-drive a owl:Class ;
    rdfs:label "Cable Drive"@en ;
    rdfs:comment "A cable drive (cable-driven transmission) is a mechanical actuation mechanism that transmits force and motion through tensioned cables, tendons, or belts routed over pulleys, rather than through rigid gear trains. It allows actuators to be located remotely from the joint they drive, reducing distal mass and inertia in robotic limbs and surgical instruments. Cable drives matter in robotics because they enable lightweight, compliant, backdrivable joints with low backlash."@en ;
    rdfs:subClassOf ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:mechanical-component ;
    vc:slug "cable-drive" ;
    vc:sourceDomain "robotics" .

ngm:calculation-parameters a owl:Class ;
    rdfs:label "Calculation Parameters"@en ;
    rdfs:comment "Configurable variables and settings that control the behavior, accuracy, and performance of computational simulations and models, including solver options, convergence criteria, time steps, and optimization constraints that fine-tune simulation outputs."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:validation-rules ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:sensitivity-analysis ],
        ngm:configuration-setting,
        ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:enables ngm:model-calibration,
        ngm:performance-tuning,
        ngm:simulation-control ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires ngm:parameter-definition,
        ngm:sensitivity-analysis,
        ngm:validation-rules ;
    vc:slug "calculation-parameters" ;
    vc:sourceDomain "spatial-computing" .

ngm:calibration-equipment a owl:Class ;
    rdfs:label "Calibration Equipment"@en ;
    rdfs:comment "Physical instruments and reference artefacts used to measure, adjust, and verify the accuracy of sensors, displays, and tracking systems in spatial computing deployments. Calibration equipment includes colour reference targets, IMU calibration boards, structured-light patterns, and photometric probes, all of which underpin the geometric and radiometric correctness of XR pipelines."@en ;
    rdfs:subClassOf ngm:sc-display-and-rendering ;
    skos:broader ngm:sc-display-and-rendering ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:relatedTo ngm:display-metrology,
        ngm:photogrammetry ;
    vc:slug "calibration-equipment" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:computer-vision,
        ngm:sensor-fusion ;
    vc:uses ngm:calibration,
        ngm:calibration-target .

ngm:calibration-tools a owl:Class ;
    rdfs:label "Calibration Tools"@en ;
    rdfs:comment "Software and hardware utilities used to align, tune, and verify the accuracy of XR sensors, displays, and tracking systems. Calibration establishes ground-truth references for IMUs, cameras, optical tracking arrays, and display geometry, ensuring that virtual content is correctly registered to the physical world and that tracking data is within acceptable error tolerances."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:rendering-pipeline ],
        ngm:sc-display-and-rendering ;
    skos:broader ngm:sc-display-and-rendering ;
    vc:enables ngm:augmented-reality,
        ngm:mixed-reality ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:requires ngm:rendering-pipeline ;
    vc:slug "calibration-tools" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:environmental-verification,
        ngm:optical-tracking,
        ngm:xr-runtime-environment ;
    vc:uses ngm:imu,
        ngm:photogrammetry .

ngm:carbon-accounting-software a owl:Class ;
    rdfs:label "Carbon Accounting Software"@en ;
    rdfs:comment "Carbon accounting software is a category of enterprise application that automates the collection, calculation, and reporting of an organisation's greenhouse gas (GHG) emissions across Scope 1 (direct), Scope 2 (purchased energy), and Scope 3 (value chain) categories in accordance with established standards such as the GHG Protocol Corporate Standard and ISO 14064. These platforms ingest activity data from financial systems, energy bills, logistics records, and supplier databases; apply emission factors; and produce auditable emissions inventories aligned with regulatory disclosure frameworks including the EU Corporate Sustainability Reporting Directive (CSRD) and the SEC Climate Disclosure Rule."@en ;
    rdfs:subClassOf ngm:carbon-accounting ;
    vc:enables ngm:carbon-neutrality,
        ngm:esg-reporting,
        ngm:sustainability-reporting ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:carbon-footprint-measurement,
        ngm:scope-3-emissions ;
    vc:slug "carbon-accounting-software" ;
    vc:sourceDomain "governance" ;
    vc:uses ngm:emission-factors,
        ngm:ghg-protocol .

ngm:carbon-footprint a owl:Class ;
    rdfs:label "Carbon Footprint"@en ;
    rdfs:comment "A carbon footprint is the total quantity of greenhouse gases, expressed as carbon dioxide equivalent (CO2e), emitted directly and indirectly by an individual, organisation, product, or activity over a defined period. It aggregates scope 1, 2, and 3 emissions to provide a single comparable measure of climate impact. Carbon footprints matter because they are the baseline metric for emissions reduction targets, disclosure, and offsetting strategies."@en ;
    rdfs:subClassOf ngm:sustainability ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:bitcoin-environmental-issues,
        ngm:sustainability-domain ;
    vc:slug "carbon-footprint" ;
    vc:sourceDomain "governance" .

ngm:carbon-footprint-indicator a owl:Class ;
    rdfs:label "Carbon Footprint Indicator"@en ;
    rdfs:comment "A quantitative environmental performance metric that measures and tracks an organization's greenhouse gas emissions in CO2 equivalent units, serving as a key sustainability KPI for monitoring progress toward emission reduction targets and enabling comparative analysis across operations."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:measurement-methodology ],
        ngm:environmental-k-p-i,
        ngm:sc-governance-and-safety ;
    skos:broader ngm:sc-governance-and-safety ;
    vc:enables ngm:benchmarking,
        ngm:performance-monitoring,
        ngm:target-tracking ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:emissions-data,
        ngm:measurement-methodology,
        ngm:reporting-framework ;
    vc:slug "carbon-footprint-indicator" ;
    vc:sourceDomain "spatial-computing" .

ngm:carbon-neutrality-verification a owl:Class ;
    rdfs:label "Carbon Neutrality Verification"@en ;
    rdfs:comment "The independent third-party audit process that validates an organization's carbon neutrality claims by verifying emission calculations, reduction measures, and offset quality against established standards such as ISO 14068-1 and PAS 2060."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:third-party-auditor ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:verification-standard ],
        ngm:environmental-verification,
        ngm:sc-governance-and-safety ;
    skos:broader ngm:sc-governance-and-safety ;
    vc:enables ngm:credibility-assurance,
        ngm:greenwashing-prevention,
        ngm:stakeholder-trust ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:documentation-package,
        ngm:third-party-auditor,
        ngm:verification-standard ;
    vc:slug "carbon-neutrality-verification" ;
    vc:sourceDomain "spatial-computing" .

ngm:carbon-offset-certificate a owl:Class ;
    rdfs:label "Carbon Offset Certificate"@en ;
    rdfs:comment "A verified document representing the reduction or removal of one metric ton of CO2 equivalent emissions, issued by recognized standards bodies after independent validation that confirms the underlying project's additionality, permanence, and measurability."@en ;
    rdfs:subClassOf ngm:environmental-certificate,
        ngm:sc-governance-and-safety ;
    skos:broader ngm:sc-governance-and-safety ;
    vc:enables ngm:carbon-neutrality,
        ngm:climate-investment,
        ngm:emissions-compensation ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires ngm:project-verification,
        ngm:registry-issuance,
        ngm:third-party-validation ;
    vc:slug "carbon-offset-certificate" ;
    vc:sourceDomain "spatial-computing" .

ngm:carbon-offsetting a owl:Class ;
    rdfs:label "Carbon Offsetting"@en ;
    rdfs:comment "The practice of compensating for emissions of carbon dioxide or other greenhouse gases by funding an equivalent reduction or removal of emissions elsewhere."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:carbon-accounting ],
        ngm:sustainability ;
    vc:enables ngm:sustainability ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:carbon-accounting ;
    vc:slug "carbon-offsetting" ;
    vc:sourceDomain "governance" .

ngm:carbon-price-discovery a owl:Class ;
    rdfs:label "Carbon Price Discovery"@en ;
    rdfs:comment "Carbon price discovery is the process by which market participants collectively determine the equilibrium price of carbon emission allowances or credits through the interaction of supply and demand in regulated compliance markets and voluntary carbon markets. It encompasses the mechanisms, venues, and information flows that translate abatement costs, regulatory constraints, and economic activity into observable carbon prices. Transparent price signals are essential for directing investment towards emissions reduction and for evaluating the economic cost of decarbonisation."@en ;
    rdfs:subClassOf ngm:carbon-markets ;
    vc:enables ngm:carbon-offset-trading,
        ngm:environmental-asset-market ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:asset-liquidity,
        ngm:carbon-credits,
        ngm:environmental-trading ;
    vc:slug "carbon-price-discovery" ;
    vc:sourceDomain "finance" ;
    vc:uses ngm:automated-market-maker,
        ngm:decentralized-exchange .

ngm:carbon-standard-certification a owl:Class ;
    rdfs:label "Carbon Standard Certification"@en ;
    rdfs:comment "Carbon standard certification is the process by which carbon-reduction projects and the credits they generate are independently validated and verified against a recognised standard such as Verra VCS, Gold Standard, or the ICVCM framework. Certification confirms that claimed emission reductions are real, additional, permanent, and properly quantified before credits are issued into a registry. It is the trust anchor of voluntary and compliance carbon markets, distinguishing high-integrity credits from low-quality ones."@en ;
    rdfs:subClassOf ngm:technical-standard ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:carbon-credit-tracking,
        ngm:icvcm-core-carbon-principles ;
    vc:slug "carbon-standard-certification" ;
    vc:sourceDomain "governance" .

ngm:causal-language-modelling a owl:Class ;
    rdfs:label "Causal Language Modelling"@en ;
    rdfs:comment "Causal language modelling is a self-supervised pre-training objective in which a neural network learns to predict the next token in a sequence given all preceding tokens, modelling the joint probability of text as an autoregressive product of conditional distributions. The term 'causal' refers to the unidirectional (left-to-right) attention mask that enforces the temporal ordering of tokens, preventing the model from attending to future context. This objective is the foundation of decoder-only transformer architectures such as GPT, LLaMA, and Claude, which power the majority of state-of-the-art large language models."@en ;
    rdfs:subClassOf ngm:large-language-model-training ;
    vc:enables ngm:chain-of-thought-prompting,
        ngm:gpt,
        ngm:large-language-models ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:in-context-learning,
        ngm:instruction-tuning ;
    vc:slug "causal-language-modelling" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:attention-mechanism,
        ngm:causal-attention .

ngm:cbdc-cross-border-settlement a owl:Class ;
    rdfs:label "CBDC Cross-Border Settlement"@en ;
    rdfs:comment "CBDC cross-border settlement refers to the use of central bank digital currencies to settle payments between parties in different jurisdictions. It aims to reduce cost and delay in international transfers."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:settlement ],
        ngm:central-bank-digital-currency ;
    vc:enables ngm:payment-system ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:settlement ;
    vc:slug "cbdc-cross-border-settlement" ;
    vc:sourceDomain "blockchain" .

ngm:cbor a owl:Class ;
    rdfs:label "CBOR"@en ;
    rdfs:comment "Concise Binary Object Representation (CBOR) is a binary data serialisation format specified in RFC 7049 (superseded by RFC 8949) designed to enable extremely compact encoding of structured data with a data model that is a superset of JSON. CBOR encodes values using a type-length-value scheme, eliminating the overhead of textual delimiters and key quotation, which makes it particularly well-suited for constrained environments such as IoT devices, embedded systems, and low-bandwidth protocols where minimising message size and parsing complexity is critical."@en ;
    rdfs:subClassOf ngm:data-serialization ;
    vc:enables ngm:credential-format-standard,
        ngm:embedded-systems ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:data-format-standard,
        ngm:json,
        ngm:protocol-buffer ;
    vc:slug "cbor" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:binary-encoding,
        ngm:internet-of-things .

ngm:ce-marking a owl:Class ;
    rdfs:label "CE Marking"@en ;
    rdfs:comment "CE marking is a mandatory conformity mark indicating that a product placed on the European Economic Area market meets the applicable EU health, safety, and environmental protection requirements. For machinery and robots it signals compliance with directives such as the Machinery Regulation, the EMC Directive, and relevant harmonised standards, often supported by a declaration of conformity and technical file. It matters because it is a legal precondition for market access and embeds robot safety standards into commercial deployment."@en ;
    rdfs:subClassOf ngm:robo-safety-and-standards ;
    skos:broader ngm:robo-safety-and-standards ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:robot-standard ;
    vc:slug "ce-marking" ;
    vc:sourceDomain "robotics" .

ngm:central-bank-digital-currency-cbdc a owl:Class ;
    rdfs:label "Central Bank Digital Currency (CBDC)"@en ;
    rdfs:comment "Sovereign digital currency issued and backed by a central bank for use in retail or wholesale payment systems, functioning as legal tender in digital form."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:central-bank ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:identity-systems ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:digital-wallet ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:regulatory-framework ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:distributed-ledger ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:payment-protocol ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:identity-verification ],
        ngm:infra-computing-and-cloud ;
    skos:broader ngm:infra-computing-and-cloud ;
    vc:enables ngm:digital-payments,
        ngm:financial-inclusion,
        ngm:monetary-policy-implementation,
        ngm:programmable-money ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:digital-currency-ledger,
        ngm:identity-systems,
        ngm:payment-protocol,
        ngm:transaction-validator ;
    vc:implements ngm:payment-system ;
    vc:isPartOf ngm:financial-system,
        ngm:monetary-system,
        ngm:payment-infrastructure ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:central-bank,
        ngm:digital-wallet,
        ngm:distributed-ledger,
        ngm:identity-verification,
        ngm:regulatory-framework ;
    vc:slug "central-bank-digital-currency-cbdc" ;
    vc:sourceDomain "infrastructure" .

ngm:central-bank-infrastructure a owl:Class ;
    rdfs:label "Central Bank Infrastructure"@en ;
    rdfs:comment "Central bank infrastructure encompasses the systems, networks, and institutional arrangements through which a central bank fulfils its core functions: operating real-time gross settlement (RTGS) systems for interbank payments, managing the issuance and lifecycle of physical and digital currency, implementing monetary policy, maintaining financial stability, and serving as lender of last resort. It includes SWIFT connectivity, RTGS platforms (such as CHAPS, Fedwire, TARGET2), central securities depositories, and increasingly the digital and distributed ledger systems under evaluation for CBDC issuance. This infrastructure forms the foundation upon which all commercial banking and payment activity ultimately settles."@en ;
    rdfs:subClassOf ngm:payment-infrastructure ;
    vc:enables ngm:atomic-settlement,
        ngm:cbdc-infrastructure,
        ngm:monetary-policy-implementation ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:central-bank,
        ngm:monetary-policy ;
    vc:slug "central-bank-infrastructure" ;
    vc:sourceDomain "finance" ;
    vc:supports ngm:cross-border-settlement,
        ngm:financial-stability .

ngm:certificate-transparency a owl:Class ;
    rdfs:label "Certificate Transparency"@en ;
    rdfs:comment "Certificate Transparency (CT) is an open framework and internet standard (RFC 6962 and RFC 9162) that creates a publicly auditable, append-only log of all TLS certificates issued by certificate authorities, enabling domain owners, browser vendors, and security researchers to detect misissued or fraudulent certificates rapidly. CT logs use Merkle hash trees to provide cryptographic proofs of inclusion and consistency, guaranteeing that any certificate added to a log cannot be subsequently removed or altered. Major browsers enforce CT by requiring certificates to carry signed certificate timestamps (SCTs) from recognised logs, making unauthorised certificate issuance immediately detectable."@en ;
    rdfs:subClassOf ngm:public-key-infrastructure ;
    vc:enables ngm:audit-trail,
        ngm:certificate-authority ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:public-key-cryptography,
        ngm:tls-1-3 ;
    vc:slug "certificate-transparency" ;
    vc:sourceDomain "security" ;
    vc:uses ngm:audit-log,
        ngm:cryptographic-hash-function,
        ngm:tls .

ngm:chain-reorganization a owl:Class ;
    rdfs:label "Chain Reorganization"@en ;
    rdfs:comment "A Chain Reorganization (reorg) is the replacement of one or more blocks in the canonical blockchain by an alternative chain of equal or greater cumulative proof-of-work, occurring when competing miners produce valid chains of differing lengths and the network converges on the longest-chain rule to select the canonical history. Reorgs invalidate transactions confirmed only in the abandoned chain segment, enabling double-spend attacks when deliberately induced and posing settlement finality risks for exchanges and payment processors."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:proof-of-work ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:longest-chain-rule ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:nakamoto-consensus ],
        ngm:bc-protocol-and-consensus,
        ngm:blockchain-entity,
        ngm:distributed-data-structure ;
    skos:broader ngm:bc-protocol-and-consensus ;
    vc:contrastsWith ngm:byzantine-fault-tolerance ;
    vc:enables ngm:51-attack,
        ngm:double-spending ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:consensus-mechanism ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:blockchain-scalability,
        ngm:finality,
        ngm:fork-choice-rule,
        ngm:selfish-mining,
        ngm:transaction-finality ;
    vc:requires ngm:longest-chain-rule,
        ngm:nakamoto-consensus,
        ngm:proof-of-work ;
    vc:slug "chain-reorganization" ;
    vc:sourceDomain "blockchain" .

ngm:channel-factory a owl:Class ;
    rdfs:label "Channel Factory"@en ;
    rdfs:comment "A channel factory is a Bitcoin Lightning Network scaling construction in which multiple participants share a single on-chain funding transaction (a multiparty channel) from which many off-chain payment channels can be opened, closed, and rebalanced without further on-chain transactions. By amortising one on-chain output across many channels, it reduces the on-chain footprint and cost of channel management. It matters because it improves the capital efficiency and scalability of layer-2 payments."@en ;
    rdfs:subClassOf ngm:lightning-network ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:lightning-network ;
    vc:slug "channel-factory" ;
    vc:sourceDomain "blockchain" .

ngm:character-rigging a owl:Class ;
    rdfs:label "Character Rigging"@en ;
    rdfs:comment "The process of creating a hierarchical skeleton of interconnected bones and joints within a 3D character model, along with control systems and deformation rules, enabling animators to manipulate the mesh through inverse kinematics and forward kinematics for realistic movement."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:character-model ],
        ngm:animation-technique,
        ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:enables ngm:character-animation,
        ngm:motion-capture-retargeting,
        ngm:skeletal-animation ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:character-model,
        ngm:skinning,
        ngm:weight-painting ;
    vc:slug "character-rigging" ;
    vc:sourceDomain "spatial-computing" .

ngm:chatbot a owl:Class ;
    rdfs:label "Chatbot"@en ;
    rdfs:comment "A software application that conducts a conversation with users through text or speech, increasingly built on large language models to generate natural-language responses."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:natural-language-processing ],
        ngm:conversational-ai ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:natural-language-processing ;
    vc:slug "chatbot" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:civic-participation a owl:Class ;
    rdfs:label "Civic Participation"@en ;
    rdfs:comment "The engagement of citizens in democratic processes and public decision-making through digital platforms, virtual environments, and emerging technologies including metaverse spaces, blockchain voting systems, and AI-enhanced deliberation tools that enable new forms of collective governance."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:trust-infrastructure ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:accessibility ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:digital-platform ],
        ngm:democratic-engagement,
        ngm:sc-governance-and-safety ;
    skos:broader ngm:sc-governance-and-safety ;
    vc:enables ngm:collective-governance,
        ngm:digital-democracy,
        ngm:public-deliberation ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:accessibility,
        ngm:digital-platform,
        ngm:trust-infrastructure ;
    vc:slug "civic-participation" ;
    vc:sourceDomain "spatial-computing" .

ngm:climate-change-mitigation a owl:Class ;
    rdfs:label "Climate Change Mitigation"@en ;
    rdfs:comment "Efforts to reduce or prevent the emission of greenhouse gases and to enhance their removal from the atmosphere, with the aim of limiting the extent of climate change. It includes shifting to low-carbon energy and improving efficiency."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:renewable-energy ],
        ngm:sustainability ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:renewable-energy ;
    vc:slug "climate-change-mitigation" ;
    vc:sourceDomain "sustainability" .

ngm:climate-tech a owl:Class ;
    rdfs:label "Climate Tech"@en ;
    rdfs:comment "Climate Tech encompasses the portfolio of technologies, platforms, and business models designed to mitigate greenhouse gas emissions, support climate adaptation, and accelerate the energy transition. It spans renewable energy generation, energy storage, carbon capture and removal, sustainable agriculture, climate risk analytics, and digital tools for emissions measurement and reporting. Climate Tech investment has grown into a distinct venture capital and corporate innovation category, underpinned by regulatory drivers, net-zero commitments, and the rapid cost-reduction curves of clean energy technologies."@en ;
    rdfs:subClassOf ngm:sustainability ;
    vc:enables ngm:carbon-markets,
        ngm:net-zero-targets,
        ngm:renewable-energy ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:carbon-credits,
        ngm:esg-reporting,
        ngm:sustainable-finance ;
    vc:slug "climate-tech" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:environmental-monitoring,
        ngm:machine-learning .

ngm:clip a owl:Class ;
    rdfs:label "CLIP"@en ;
    rdfs:comment "CLIP (Contrastive Language-Image Pre-training) is a dual-encoder neural network architecture in which a vision encoder (ViT or CNN) and a text encoder (Transformer) are jointly trained on large-scale image-text pairs using a contrastive objective that maximises the cosine similarity of matching pairs and minimises it for non-matching pairs. This training procedure produces a shared multimodal embedding space in which semantically related images and text are proximate, enabling zero-shot image classification by comparing image embeddings to textual class descriptions without any task-specific fine-tuning. CLIP embeddings have become a foundational component in text-to-image generation pipelines, image-text retrieval systems, and vision-language models."@en ;
    rdfs:subClassOf ngm:ai-model-architecture ;
    skos:broader ngm:ai-model-architecture ;
    vc:enables ngm:image-classification,
        ngm:text-to-image ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:embedding-model,
        ngm:transfer-learning ;
    vc:slug "clip" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:contrastive-learning,
        ngm:multimodal-ai .

ngm:cloud-native a owl:Class ;
    rdfs:label "Cloud Native"@en ;
    rdfs:comment "Cloud Native is an approach to building and running applications that fully exploits the advantages of cloud computing infrastructure — elastic scaling, managed services, pay-per-use economics, and high availability — by designing for containerisation, dynamic orchestration, microservices decomposition, and declarative APIs. The Cloud Native Computing Foundation (CNCF) defines it as the use of containers, service meshes, microservices, immutable infrastructure, and declarative APIs to build resilient, manageable, and observable systems. Cloud Native architectures enable rapid, reproducible delivery of software at scale across public, private, and hybrid cloud environments."@en ;
    rdfs:subClassOf ngm:cloud-computing ;
    vc:enables ngm:continuous-integration,
        ngm:high-availability,
        ngm:scalability ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:edge-computing,
        ngm:fault-tolerance,
        ngm:microservices-architecture ;
    vc:slug "cloud-native" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:kubernetes,
        ngm:microservices,
        ngm:service-mesh .

ngm:collaborative-simulation a owl:Class ;
    rdfs:label "Collaborative Simulation"@en ;
    rdfs:comment "A computational environment in which multiple participants — human or agent — share, manipulate, and observe a common simulation state in real time. It combines networked synchronisation with physics or behavioural modelling to support joint exploration, training, or design activities across distributed locations."@en ;
    rdfs:subClassOf ngm:collaborative-technology ;
    vc:enables ngm:collaborative-design,
        ngm:digital-twin-collaboration ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:collaborative-learning,
        ngm:extended-reality-xr ;
    vc:slug "collaborative-simulation" ;
    vc:sourceDomain "spatial" ;
    vc:uses ngm:digital-twin,
        ngm:game-engine .

ngm:commit-reveal-scheme a owl:Class ;
    rdfs:label "Commit-Reveal Scheme"@en ;
    rdfs:comment "A commit-reveal scheme is a two-phase cryptographic protocol in which a participant first publishes a binding, hiding commitment to a value (typically a hash of the value plus a nonce) and later reveals the value for verification. The commit phase prevents others from learning or altering the choice, while the reveal phase lets anyone check the value against the earlier commitment. It matters for on-chain voting and auctions because it stops front-running and last-mover advantage by concealing inputs until all parties are bound."@en ;
    rdfs:subClassOf ngm:cryptographic-protocol ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:quadratic-voting ;
    vc:slug "commit-reveal-scheme" ;
    vc:sourceDomain "blockchain" .

ngm:common-sense-reasoning a owl:Class ;
    rdfs:label "Common Sense Reasoning"@en ;
    rdfs:comment "The capacity of an AI system to draw inferences that humans consider obvious from general background knowledge about the physical world, social norms, causality, and everyday object behaviour — without explicit instruction. It encompasses naïve physics, naïve psychology, temporal reasoning, and spatial reasoning grounded in embodied human experience."@en ;
    rdfs:subClassOf ngm:natural-language-understanding ;
    vc:dependsOn ngm:ai-core-concepts ;
    vc:enables ngm:ai-agents,
        ngm:natural-language-understanding ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:ai-alignment,
        ngm:collective-intelligence ;
    vc:slug "common-sense-reasoning" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:natural-language-processing .

ngm:community-decision-making a owl:Class ;
    rdfs:label "Community Decision Making"@en ;
    rdfs:comment "The processes by which a defined community of stakeholders collectively identifies issues, deliberates alternatives, and reaches binding or advisory decisions about matters affecting shared resources, norms, or direction. It encompasses participatory design, public consultation, deliberative democracy mechanisms, and digital governance platforms that translate community preferences into actionable outcomes."@en ;
    rdfs:subClassOf ngm:collective-decision-making ;
    vc:enables ngm:collective-governance,
        ngm:community-governance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:collective-action,
        ngm:conviction-voting,
        ngm:dao-governance ;
    vc:slug "community-decision-making" ;
    vc:sourceDomain "governance" ;
    vc:uses ngm:communication-tools,
        ngm:coordination-mechanisms .

ngm:compliance-management a owl:Class ;
    rdfs:label "Compliance Management"@en ;
    rdfs:comment "Compliance Management is the systematic process by which organisations identify, assess, implement, and monitor adherence to applicable laws, regulations, standards, and internal policies. It encompasses the full lifecycle of obligation tracking, control design, evidence collection, and reporting to demonstrate that operational activities conform to required norms."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:audit-trail ],
        ngm:governance-framework ;
    vc:dependsOn ngm:risk-management ;
    vc:enables ngm:regulatory-compliance ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:data-governance ;
    vc:requires ngm:audit-trail ;
    vc:slug "compliance-management" ;
    vc:sourceDomain "governance" ;
    vc:uses ngm:policy-enforcement .

ngm:compliance-testing a owl:Class ;
    rdfs:label "Compliance Testing"@en ;
    rdfs:comment "Compliance testing is the systematic verification that a product, system, or process conforms to a defined standard, specification, or regulatory requirement. It produces objective, repeatable measurements that are compared against documented acceptance criteria to determine pass or fail status. It is a core component of validation and certification workflows, providing the evidentiary basis for conformity claims."@en ;
    rdfs:subClassOf ngm:regulatory-compliance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:display-metrology,
        ngm:validation-process ;
    vc:slug "compliance-testing" ;
    vc:sourceDomain "governance" .

ngm:compliant-manipulation a owl:Class ;
    rdfs:label "Compliant Manipulation"@en ;
    rdfs:comment "Compliant Manipulation is a branch of robotic manipulation in which the robot's end-effector or structural members intentionally yield to contact forces, using passive mechanical compliance or active force control to safely interact with uncertain, fragile, or human-occupied environments. Unlike rigid position-controlled manipulation, compliant manipulation regulates interaction forces as a first-class control objective."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:actuator ],
        ngm:robot-manipulation ;
    vc:enables ngm:robotic-grasping ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:haptic-feedback,
        ngm:soft-robotics ;
    vc:requires ngm:actuator ;
    vc:slug "compliant-manipulation" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:force-control .

ngm:compression-function a owl:Class ;
    rdfs:label "Compression Function"@en ;
    rdfs:comment "A compression function is a fixed-input-length cryptographic primitive that maps two inputs (a chaining value and a message block) to a single shorter output. It is the core building block of iterated hash functions, where it is applied repeatedly under constructions such as Merkle-Damgard to process arbitrary-length messages. Its collision and preimage resistance directly determine the security of the hash function built on top of it."@en ;
    rdfs:subClassOf ngm:cryptographic-primitive ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:hash-function ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:hash-function ;
    vc:slug "compression-function" ;
    vc:sourceDomain "security" .

ngm:computational-creativity a owl:Class ;
    rdfs:label "Computational Creativity"@en ;
    rdfs:comment "Computational creativity is the subfield of artificial intelligence concerned with building systems that exhibit behaviours regarded as creative, such as generating novel and valuable artefacts in art, music, design, or narrative. It studies both the algorithmic generation of original output and the evaluation of novelty, surprise, and value. The field informs generative models, procedural content systems, and AI-assisted creative tooling."@en ;
    rdfs:subClassOf ngm:ai-research-area ;
    skos:broader ngm:ai-research-area ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:ai-in-games,
        ngm:creative-ai-domain ;
    vc:slug "computational-creativity" ;
    vc:sourceDomain "ai" .

ngm:computational-intelligence a owl:Class ;
    rdfs:label "Computational Intelligence"@en ;
    rdfs:comment "Computational Intelligence (CI) is an umbrella field encompassing bio-inspired and nature-analogous algorithmic paradigms—principally neural networks, fuzzy logic, and evolutionary computation—that equip machines with adaptive, learning, and reasoning capabilities. Unlike classical symbolic AI, CI techniques tolerate imprecision, uncertainty, and partial truth, deriving solutions through iterative adaptation rather than explicit programming."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:neural-network ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:fuzzy-logic ],
        ngm:artificial-intelligence ;
