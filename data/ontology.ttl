ngm:holographic-telepresence a owl:Class ;
    rdfs:comment "Holographic Telepresence is a form of remote presence technology that projects three-dimensional, life-size representations of remote participants into a shared physical or virtual space. It combines light field capture, display, and rendering techniques to create the illusion that a remote person is physically co-located with local participants. This approach enables natural interaction cues such as eye contact, spatial positioning, and gestural communication that are absent in conventional video conferencing."@en ;
    rdfs:label "Holographic Telepresence"@en ;
    rdfs:subClassOf ngm:telepresence ;
    vc:enables ngm:social-presence ;
