ngm:immersive-audio a owl:Class ;
    rdfs:label "Immersive Audio"@en ;
    rdfs:comment "Immersive audio refers to audio reproduction and processing technologies that create a convincing three-dimensional sound field, enveloping the listener in a spatially accurate sonic environment. It encompasses object-based audio formats, binaural rendering, ambisonics, and head-related transfer function (HRTF) personalisation, enabling the perception of sounds positioned above, below, and around the listener rather than confined to a flat stereo plane."@en ;
    rdfs:subClassOf ngm:audio-technology ;
    vc:enables ngm:extended-reality-xr,
        ngm:immersive-experience-pipeline ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:audio-engine,
        ngm:audio-spatialization ;
    vc:slug "immersive-audio" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:audio-processing,
        ngm:binaural-rendering,
        ngm:spatial-audio .

ngm:immersive-collaboration a owl:Class ;
    rdfs:label "Immersive Collaboration"@en ;
    rdfs:comment "Immersive collaboration is the practice of working together within shared spatial virtual or mixed-reality environments where participants, represented by avatars, interact with 3D content and one another in real time. It extends remote teamwork beyond flat video calls by providing spatial audio, embodied presence, and manipulable shared objects. Immersive collaboration is a key application of metaverse and XR technologies for the enterprise."@en ;
    rdfs:subClassOf ngm:dc-telepresence ;
    skos:broader ngm:dc-telepresence ;
    vc:enables ngm:mixed-reality ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:immersive-computing ;
    vc:slug "immersive-collaboration" ;
    vc:sourceDomain "metaverse" .

ngm:inference-compute a owl:Class ;
    rdfs:label "Inference Compute"@en ;
    rdfs:comment "Inference compute is the computational capacity consumed when a trained machine-learning model generates outputs from inputs, as distinct from the compute used during training. For large language models it scales with model size, context length, and the number of generated tokens, and increasingly with test-time reasoning techniques that spend more compute per query to improve answers. It is a primary cost and latency driver for deployed AI systems and agents."@en ;
    rdfs:subClassOf ngm:ai-infrastructure ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:agents,
        ngm:computer-use-and-browser-agents ;
    vc:slug "inference-compute" ;
    vc:sourceDomain "ai" .

ngm:inflation-targeting a owl:Class ;
    rdfs:label "Inflation Targeting"@en ;
    rdfs:comment "Inflation targeting is a monetary-policy framework in which a central bank publicly commits to achieving a specified rate of inflation over the medium term and adjusts its policy instruments to meet that target. By anchoring expectations to a clear, numerical goal, it aims to deliver price stability while preserving transparency and accountability. The framework links interest-rate decisions to forecasts of how inflation will deviate from the announced target."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:interest-rate ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:consumer-price-index ],
        ngm:monetary-policy ;
    vc:dependsOn ngm:central-bank,
        ngm:interest-rate ;
    vc:enables ngm:price-stability ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:forward-guidance,
        ngm:taylor-rule ;
    vc:isPartOf ngm:monetary-policy ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:bank-of-england,
        ngm:inflation,
        ngm:macroeconomics ;
    vc:requires ngm:consumer-price-index,
        ngm:interest-rate ;
    vc:slug "inflation-targeting" ;
    vc:sourceDomain "finance" ;
    vc:supports ngm:price-stability ;
    vc:uses ngm:forward-guidance,
        ngm:interest-rate,
        ngm:quantitative-easing .

ngm:infrared-light-source a owl:Class ;
    rdfs:label "Infrared Light Source"@en ;
    rdfs:comment "Emission devices providing infrared wavelength light for VR/AR tracking applications, encompassing LEDs, illuminators, and integrated headset components that enable eye tracking, position detection, and hand gesture recognition in extended reality systems."@en ;
