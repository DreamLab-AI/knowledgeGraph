    vc:slug "technical-expertise" ;
    vc:sourceDomain "governance" .

ngm:technology-ecosystem a owl:Class ;
    rdfs:label "Technology Ecosystem"@en ;
    rdfs:comment "A Technology Ecosystem is the interconnected network of platforms, developer tools, standards bodies, runtime environments, and community participants that collectively sustain a technology domain. In the metaverse context it encompasses rendering engines, spatial-computing SDKs, open standards (OpenXR, USD, WebXR), cloud infrastructure, hardware manufacturers, and application developers whose interdependencies determine adoption trajectories and competitive dynamics."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:open-standard ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:technology-infrastructure ],
        ngm:infra-computing-and-cloud ;
    skos:broader ngm:infra-computing-and-cloud ;
    vc:enables ngm:adoption-of-convergent-technologies,
        ngm:convergence ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:open-standard,
        ngm:technology-infrastructure ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:metaverse,
        ngm:spatial-computing ;
    vc:slug "technology-ecosystem" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:distributed-system .

ngm:telemetry-and-analytics a owl:Class ;
    rdfs:label "Telemetry & Analytics"@en ;
    rdfs:comment "Systematic collection and analysis of usage and performance data from metaverse applications and platforms to enable monitoring, optimization, and decision-making."@en ;
