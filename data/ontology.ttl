        ngm:procedural-generation,
        ngm:rendering-engine .

ngm:visual-servoing a owl:Class ;
    rdfs:label "VisualServoing"@en ;
    rdfs:comment "Visual servoing is a robot control paradigm in which camera-derived visual measurements are used as feedback signals within a closed-loop control system to guide the motion of a robotic manipulator or mobile platform towards a goal configuration defined in visual terms. Rather than relying on pre-computed geometric trajectories, visual servoing continuously computes control signals from current image features or image-space error signals, making it inherently adaptive to object pose uncertainty and disturbances. The two primary architectures are image-based visual servoing (IBVS), which minimises error in image feature space, and position-based visual servoing (PBVS), which reconstructs 3D pose and minimises Cartesian error. Visual servoing enables tasks such as precise grasping, assembly alignment, and autonomous navigation without requiring exact geometric calibration."@en ;
    rdfs:subClassOf ngm:robot-control ;
    vc:enables ngm:manipulation,
        ngm:motion-control,
        ngm:path-planning ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:camera-calibration,
        ngm:end-effector,
        ngm:feedback-control ;
    vc:slug "visual-servoing" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:camera,
        ngm:closed-loop-control,
        ngm:computer-vision .

ngm:vote-escrow-model a owl:Class ;
    rdfs:label "Vote-Escrow Model"@en ;
    rdfs:comment "The vote-escrow model is a DeFi tokenomics mechanism in which holders of a governance token lock their tokens for a chosen duration — typically up to four years — in exchange for a non-transferable vote-escrow token (such as veCRV in Curve Finance) that grants proportional governance voting power and fee-sharing rights, with voting weight decaying linearly as the lock approaches expiry, aligning token holder incentives with long-term protocol health by penalising short-term speculation. The model was pioneered by Curve Finance and subsequently adopted across dozens of DeFi protocols, spawning meta-governance layers such as Convex Finance that aggregate and direct veToken voting power."@en ;
    rdfs:subClassOf ngm:tokenomics ;
    vc:enables ngm:liquidity-mining,
        ngm:yield-farming ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:convex-finance,
        ngm:token-economics,
        ngm:tokenomics-governance ;
    vc:slug "vote-escrow-model" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:dao-governance,
        ngm:governance-token,
        ngm:on-chain-governance .

ngm:w3-c-did-specification a owl:Class ;
    rdfs:label "W3C DID Specification"@en ;
    rdfs:comment "The W3C Decentralized Identifiers (DIDs) specification is a World Wide Web Consortium recommendation that defines a new type of globally unique, persistent, cryptographically verifiable identifier that does not require a centralised registration authority. A DID resolves to a DID Document containing cryptographic material, service endpoints, and verification methods, enabling the subject to authenticate and authorise interactions without reliance on any single identity provider. The specification defines a generic DID syntax and data model that is method-agnostic, with specific DID methods implementing the create/read/update/deactivate operations on different verifiable data registries including blockchains, distributed ledgers, and peer-to-peer networks. It became a W3C Recommendation in July 2022."@en ;
    rdfs:subClassOf ngm:w3-c-did ;
    vc:enables ngm:decentralized-identity-did,
        ngm:didcomm,
        ngm:verifiable-credentials ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:decentralized-identifiers,
        ngm:did-document,
        ngm:w3-c ;
    vc:slug "w3-c-did-specification" ;
    vc:sourceDomain "web" ;
    vc:standardizedBy ngm:w3-c ;
    vc:uses ngm:digital-identity-standards .

ngm:wearable-device-integration a owl:Class ;
    rdfs:label "Wearable Device Integration"@en ;
    rdfs:comment "The technical processes and protocols for connecting wearable computing devices with metaverse platforms, enterprise systems, and cloud services, enabling seamless data exchange, cross-device synchronisation, and coordinated multi-device experiences."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:sensor-fusion ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:authentication ],
        ngm:sc-interaction,
        ngm:system-integration ;
    skos:broader ngm:sc-interaction ;
    vc:enables ngm:augmented-reality,
        ngm:digital-twin ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:wearable-computing-platform ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires ngm:authentication,
        ngm:sensor-fusion ;
    vc:slug "wearable-device-integration" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:interoperability .

ngm:web-standards a owl:Class ;
    rdfs:label "Web Standards"@en ;
    rdfs:comment "Web Standards is a spatial computing concept."@en ;
    rdfs:subClassOf ngm:sc-standards-and-interop ;
    skos:broader ngm:sc-standards-and-interop ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:implements ngm:spatial-computing ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:slug "web-standards" ;
    vc:sourceDomain "spatial-computing" .

ngm:word-piece a owl:Class ;
    rdfs:label "WordPiece"@en ;
    rdfs:comment "A subword tokenisation algorithm that iteratively merges character sequences by maximising the likelihood of the training corpus under a unigram language model, rather than merging the most frequent pairs. WordPiece is the default tokeniser for BERT, DistilBERT, and ELECTRA, producing vocabularies of approximately 30,000 tokens that handle rare and compound words via subword splitting."@en ;
    rdfs:subClassOf ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:contrastsWith ngm:byte-pair-encoding,
        ngm:sentence-piece ;
    vc:enables ngm:natural-language-processing ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:subword-tokenisation,
        ngm:tokenisation ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:slug "word-piece" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:vocabulary .

ngm:workforce-augmentation a owl:Class ;
    rdfs:label "Workforce Augmentation"@en ;
    rdfs:comment "Workforce Augmentation refers to the use of AI tools, agentic systems, and intelligent automation to extend the cognitive and physical capabilities of human workers rather than replacing them. By offloading repetitive tasks to AI assistants and copilots, organisations can redeploy human attention to higher-value judgement and creative work, improving both productivity and job quality."@en ;
    rdfs:subClassOf ngm:ai-application ;
    skos:broader ngm:ai-application ;
    vc:enables ngm:ai-augmented-software-engineering ;
