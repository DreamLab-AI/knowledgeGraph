    vc:slug "ouroboros" ;
    vc:sourceDomain "blockchain" .

ngm:ouroboros-consensus a owl:Class ;
    rdfs:label "Ouroboros Consensus"@en ;
    rdfs:comment "Ouroboros is a provably secure proof-of-stake consensus protocol developed for the Cardano blockchain, the first PoS protocol to be formally verified with cryptographic security proofs equivalent to those of proof-of-work systems. It divides blockchain time into epochs and slots, using a verifiable random function to elect slot leaders from among stake pools proportionally to their delegated stake, enabling secure, energy-efficient block production without trusted setup."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:consensus-mechanism ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:finality ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:epoch ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptography ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:blockchain-protocol ],
        ngm:bc-protocol-and-consensus,
        ngm:proof-of-stake ;
    skos:broader ngm:bc-protocol-and-consensus ;
    vc:contrastsWith ngm:byzantine-fault-tolerance,
        ngm:delegated-proof-of-stake,
        ngm:liquid-proof-of-stake,
        ngm:nominated-proof-of-stake ;
    vc:enables ngm:blockchain-governance,
        ngm:blockchain-sustainability,
        ngm:probabilistic-finality ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:epoch,
        ngm:finality ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:blockchain-network,
        ngm:blockchain-scalability,
        ngm:consensus-algorithm ;
    vc:requires ngm:blockchain-protocol,
        ngm:consensus-mechanism,
        ngm:cryptography ;
    vc:slug "ouroboros-consensus" ;
    vc:sourceDomain "blockchain" .

ngm:overview-of-machine-learning-techniques a owl:Class ;
    rdfs:label "Overview of Machine Learning Techniques"@en ;
    rdfs:comment "A structured survey of the principal paradigms and architectures in machine learning, spanning supervised methods (SVMs, decision trees, logistic regression), unsupervised clustering (k-means, KNN), and deep learning approaches (neural networks, transformers, diffusion models, GANs). The survey contextualises training paradigms including reinforcement learning from human feedback and direct preference optimisation, and positions large proprietary language models within the broader ML taxonomy."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:transformers ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:diffusion-models ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:direct-preference-optimization ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:reinforcement-learning ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:generative-adversarial-networks ],
        ngm:ai-technique,
        ngm:deep-learning ;
    skos:broader ngm:ai-technique ;
    vc:enables ngm:generative-ai,
        ngm:large-language-models ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:diffusion-models,
        ngm:direct-preference-optimization,
        ngm:generative-adversarial-networks,
        ngm:reinforcement-learning,
        ngm:transformers ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:slug "overview-of-machine-learning-techniques" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:neural-network,
        ngm:optimization-algorithms .

ngm:ownership-and-freedom-distributed a owl:Class ;
    rdfs:label "Ownership and Freedom Distributed"@en ;
    rdfs:comment "The principle of distributing control and governance of digital assets or data across multiple participants rather than concentrating authority in a single entity. This encompasses decentralised identity, cryptographic ownership proofs, peer-to-peer governance mechanisms, and user-controlled data portability as foundational guarantees for sovereignty in metaverse and Web3 ecosystems."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:blockchain ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptography ],
        ngm:metaverse-governance-and-safeguarding,
        ngm:sc-governance-and-safety ;
    skos:broader ngm:sc-governance-and-safety ;
    vc:enables ngm:data-sovereignty,
        ngm:decentralized-governance,
        ngm:self-sovereign-identity ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:decentralized-autonomous-organization,
        ngm:ownership-freedom-distributed ;
    vc:requires ngm:blockchain,
        ngm:cryptography ;
    vc:slug "ownership-and-freedom-distributed" ;
    vc:sourceDomain "spatial-computing" .

