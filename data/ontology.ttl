ngm:rendering-engine a owl:Class ;
    rdfs:label "Rendering Engine"@en ;
    rdfs:comment "A rendering engine is a software system that generates 2D images or animations from 3D scene descriptions through rasterisation, ray tracing, or hybrid pipelines. Modern real-time engines such as Unreal Engine 5 and Unity combine global illumination, virtualised geometry, neural shaders, and AI-driven upscaling to produce cinematic-quality visuals at interactive frame rates. They serve as the foundational compute layer for games, virtual reality, film production, and spatial-computing applications."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:scene-graph ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:shader ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:rendering-pipeline ],
        ngm:computer-graphics,
        ngm:sc-display-and-rendering ;
    skos:broader ngm:sc-display-and-rendering ;
    vc:enables ngm:film-production,
        ngm:immersive-experience,
        ngm:virtual-reality-vr ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:rendering-pipeline,
        ngm:scene-graph,
        ngm:shader ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:game-engine,
        ngm:gaussian-splatting,
        ngm:real-time-rendering,
        ngm:rendering-technique ;
    vc:slug "rendering-engine" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:global-illumination,
        ngm:gpu-compute,
        ngm:graphics-api,
        ngm:ray-tracing .

ngm:vector-database a owl:Class ;
    rdfs:label "Vector Database"@en ;
    rdfs:comment "A vector database is a specialised data storage and retrieval system optimised for indexing and querying high-dimensional dense vectors (embeddings) using approximate nearest-neighbour (ANN) search algorithms such as HNSW, IVF-PQ, and ScaNN. These systems support efficient similarity search over millions to billions of embedding vectors representing text, images, or multimodal content, enabling retrieval-augmented generation, semantic search, and recommendation at scale. Vector databases typically provide filtering on structured metadata in conjunction with vector similarity, persistence, and versioning capabilities beyond what generic ANN libraries offer."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:embedding-model ],
        ngm:ai-infrastructure ;
    vc:enables ngm:retrieval-augmented-generation,
        ngm:semantic-search ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:information-retrieval,
        ngm:nearest-neighbor-search,
        ngm:search-index ;
    vc:requires ngm:embedding-model ;
    vc:slug "vector-database" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:blockchain-infrastructure a owl:Class ;
    rdfs:label "Blockchain Infrastructure"@en ;
    rdfs:comment "The foundational technical components enabling blockchain networks to operate, including nodes, networking protocols, consensus mechanisms, storage systems, and cryptographic primitives that toger provide the physical and logical substrate for distributed ledger operation and decentralized applic..."@en ;
