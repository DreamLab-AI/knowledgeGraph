ngm:user-experience a owl:Class ;
    rdfs:label "User Experience"@en ;
    rdfs:comment "User Experience (UX) is the totality of perceptions, responses, and outcomes that a person encounters before, during, and after interacting with a product, service, or system — encompassing functional usability, aesthetic appeal, emotional resonance, accessibility, and long-term satisfaction. In spatial and immersive computing contexts, UX additionally addresses physical comfort, motion sickness mitigation, spatial audio fidelity, haptic feedback, and the cognitive load imposed by three-dimensional interaction paradigms. UX design is an iterative, evidence-based discipline drawing on human-computer interaction research, cognitive psychology, and ergonomics, and is formalised in ISO 9241-210 as encompassing all perceptions and responses resulting from actual or anticipated use. Empirical evaluation methods — including heuristic analysis, usability testing, eye tracking, and physiological measurement — ground UX practice in observable user behaviour."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:user-research ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:usability ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:usability-testing ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:human-factors ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:interaction-design ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:information-architecture ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:accessibility ],
        ngm:human-computer-interaction ;
    vc:bridgesTo ngm:affective-computing,
        ngm:artificial-intelligence,
        ngm:extended-reality ;
    vc:contrastsWith ngm:customer-experience,
        ngm:usability ;
    vc:dependsOn ngm:affordance,
        ngm:cognitive-load,
        ngm:feedback-loop ;
    vc:enables ngm:digital-accessibility,
        ngm:immersive-experience,
        ngm:user-engagement ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:accessibility,
        ngm:information-architecture,
        ngm:interaction-design,
        ngm:usability,
        ngm:visual-design ;
    vc:isPartOf ngm:human-computer-interaction,
        ngm:product-design ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:design-thinking,
        ngm:ergonomics,
        ngm:service-design ;
    vc:requires ngm:human-factors,
        ngm:prototyping,
        ngm:usability-testing,
        ngm:user-research ;
