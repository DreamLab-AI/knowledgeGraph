ngm:arbitrator-expertise a owl:Class ;
    rdfs:label "Arbitrator Expertise"@en ;
    rdfs:comment "Arbitrator Expertise in blockchain and digital asset contexts refers to the specialized technical knowledge, legal background, and industry experience required by neutral decision-makers to understand distributed ledger technology, smart contracts, tokenomics, and crypto-asset classification for ..."@en ;
