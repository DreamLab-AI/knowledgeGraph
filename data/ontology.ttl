ngm:diffusion-transformer a owl:Class ;
    rdfs:label "Diffusion Transformer"@en ;
    rdfs:comment "A Diffusion Transformer (DiT) is a generative model architecture that replaces the convolutional U-Net backbone traditionally used in diffusion models with a scalable transformer architecture operating in a compressed latent space. DiT conditions the denoising process on class labels or text embeddings injected via adaptive layer normalisation or cross-attention, and processes image or video patches as sequences of tokens, enabling the model to leverage the scaling laws well-established for language transformers. Introduced by Peebles and Xie (2023), DiT demonstrated that transformer-based denoisers match or surpass U-Net performance while scaling predictably with model size and compute, forming the basis for state-of-the-art image and video generation systems including Stable Diffusion 3, FLUX, and OpenAI's Sora."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:denoising-score-matching ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:noise-schedule ],
        ngm:generative-model ;
    vc:bridgesTo ngm:robotics,
        ngm:spatial-computing ;
    vc:contrastsWith ngm:convolutional-neural-network,
        ngm:u-net ;
    vc:dependsOn ngm:deep-learning,
        ngm:neural-network ;
    vc:enables ngm:3-d-content-generation,
        ngm:audio-generation,
        ngm:image-generation,
        ngm:text-to-image,
        ngm:video-generation ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:implements ngm:conditional-generation,
        ngm:scalable-architecture ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:flow-matching,
        ngm:generative-ai,
        ngm:score-based-model ;
    vc:requires ngm:denoising-score-matching,
        ngm:diffusion-process,
        ngm:noise-schedule ;
    vc:slug "diffusion-transformer" ;
    vc:sourceDomain "machine-learning" ;
    vc:uses ngm:adaptive-layer-normalisation,
        ngm:attention-mechanism,
        ngm:latent-diffusion,
        ngm:patch-embedding,
        ngm:self-attention,
        ngm:transformer-architecture,
        ngm:variational-autoencoder .

ngm:digital-archive a owl:Class ;
    rdfs:label "Digital Archive"@en ;
    rdfs:comment "A systematic collection and preservation system for digital assets, cultural artifacts, documents, and media using distributed storage, metadata standards, and immersive access technologies to ensure long-term accessibility and discovery within virtual environments and knowledge management systems."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:storage-infrastructure ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:digital-objects ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:metadata-catalog ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:format-migration ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:metadata-standards ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:access-control ],
        ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:bridgesTo ngm:blockchain,
        ngm:digital-preservation,
        ngm:spatial-computing ;
    vc:contrastsWith ngm:ephemeral-storage ;
    vc:dependsOn ngm:data-governance,
        ngm:infrastructure ;
    vc:enables ngm:historical-research,
        ngm:knowledge-preservation,
        ngm:provenance-tracking ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:digital-objects,
        ngm:metadata-catalog,
        ngm:preservation-policy ;
    vc:isPartOf ngm:knowledge-management-system ;
    vc:qualityScore "0.68"^^xsd:float ;
    vc:relatedTo ngm:records-management,
        ngm:semantic-web-linked-data-standard ;
    vc:requires ngm:access-control,
        ngm:format-migration,
        ngm:integrity-verification,
        ngm:metadata-standards,
        ngm:storage-infrastructure ;
    vc:slug "digital-archive" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:digital-rights-management,
        ngm:open-access ;
    vc:uses ngm:content-addressing,
        ngm:distributed-storage,
        ngm:linked-data .

ngm:digital-divide a owl:Class ;
    rdfs:label "Digital Divide"@en ;
    rdfs:comment "The digital divide describes the structured inequality between individuals, communities, and nations in their ability to access, afford, use, and benefit from information and communication technologies, including broadband connectivity, computing devices, and the digital literacy skills required for effective participation. The divide operates across multiple axes — geographic (urban versus rural), socioeconomic (income and education), demographic (age, gender, disability), and geopolitical (Global North versus Global South) — and is self-reinforcing because limited digital access restricts access to the economic and educational resources needed to close the gap. Policy interventions target three layers: physical infrastructure deployment, affordability of devices and data, and cultivation of digital skills and trust through digital literacy programmes. As digital systems mediate healthcare, education, employment, public services, and civic participation, the digital divide functions as a meta-inequality that amplifies pre-existing social disparities."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:telecommunications ],
        ngm:digital-economy ;
    vc:bridgesTo ngm:ai-fairness,
        ngm:algorithmic-bias,
        ngm:edge-computing,
        ngm:spatial-computing ;
    vc:contrastsWith ngm:connected-society,
        ngm:digital-inclusion ;
    vc:enables ngm:digital-transformation,
        ngm:e-government,
        ngm:online-learning ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:digital-economy,
        ngm:social-inequality ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:accessibility,
        ngm:data-sovereignty,
        ngm:human-rights,
        ngm:internet-governance,
        ngm:privacy,
        ngm:universal-service-obligation ;
    vc:requires ngm:broadband-infrastructure,
        ngm:digital-literacy,
        ngm:telecommunications ;
    vc:slug "digital-divide" ;
    vc:sourceDomain "governance" ;
    vc:standardizedBy ngm:itu,
        ngm:sustainable-development-goals .

ngm:digital-euro a owl:Class ;
    rdfs:label "Digital Euro"@en ;
    rdfs:comment "The digital euro is a prospective retail central bank digital currency (CBDC) to be issued by the European Central Bank, providing eurozone households and businesses with a risk-free digital form of public money usable for everyday payments alongside cash, without requiring a bank account at a commercial institution."@en ;
    rdfs:subClassOf ngm:central-bank-digital-currency ;
    vc:bridgesTo ngm:data-privacy,
        ngm:smart-contract ;
    vc:contrastsWith ngm:commercial-bank-deposit,
        ngm:e-cny,
        ngm:stablecoin ;
    vc:dependsOn ngm:european-central-bank ;
    vc:enables ngm:financial-inclusion,
        ngm:programmable-money ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:implements ngm:ecb-digital-euro-regulation-proposal,
        ngm:monetary-sovereignty ;
    vc:isPartOf ngm:monetary-system ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:cbdc-frameworks ;
    vc:slug "digital-euro" ;
    vc:sourceDomain "finance" ;
    vc:standardizedBy ngm:ecb-digital-euro-regulation,
        ngm:european-parliament ;
    vc:supports ngm:anti-money-laundering,
        ngm:monetary-policy-transmission ;
    vc:uses ngm:settlement .

ngm:digital-humans a owl:Class ;
    rdfs:label "Digital Humans"@en ;
    rdfs:comment "Digital humans are photorealistic, AI-driven virtual beings that replicate human appearance, movement, voice, and conversational behaviour, rendered in 3D and designed for real-time interaction within immersive and spatial computing environments. They integrate natural language processing, motion capture, generative AI, and real-time rendering to simulate lifelike presence, serving roles in customer service, education, healthcare, and entertainment. As an emerging category they represent the convergence of embodied AI with avatar systems and synthetic media."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:avatar-system ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:3-d-animation ],
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:3-d-animation,
        ngm:avatar-system ;
    vc:isPartOf ngm:immersive-technology,
        ngm:spatial-computing ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:digital-avatar,
        ngm:embodied-ai,
        ngm:synthetic-media ;
    vc:slug "digital-humans" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:conversational-ai,
        ngm:motion-capture,
        ngm:natural-language-processing,
        ngm:real-time-rendering,
        ngm:text-to-speech .

ngm:digital-markets-act a owl:Class ;
    rdfs:label "Digital Markets Act"@en ;
    rdfs:comment "The Digital Markets Act (DMA) is a European Union regulation that imposes ex ante obligations and prohibitions on large online platforms designated as gatekeepers to ensure contestable and fair digital markets. Rather than waiting for case-by-case competition enforcement, it sets binding rules on designated core platform services covering interoperability, data use, self-preferencing, default settings, and access for business users. Gatekeepers must comply with a list of do's and don'ts, with the European Commission as sole enforcer empowered to levy substantial fines and structural remedies for non-compliance."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:regulatory-compliance ],
        ngm:regulatory-framework ;
    vc:bridgesTo ngm:digital-services-act ;
    vc:contrastsWith ngm:surveillance-capitalism ;
    vc:dependsOn ngm:regulatory-compliance ;
    vc:enables ngm:interoperability,
        ngm:platform-economy ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:interoperability ;
    vc:isPartOf ngm:regulatory-framework ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:digital-services-act,
        ngm:gdpr,
        ngm:platform-economy ;
    vc:requires ngm:regulatory-compliance ;
    vc:slug "digital-markets-act" ;
    vc:sourceDomain "governance" ;
    vc:standardizedBy ngm:european-union ;
    vc:supports ngm:platform-economy .

ngm:digital-real-estate a owl:Class ;
