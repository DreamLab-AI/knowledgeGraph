    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:attention-mechanism,
        ngm:message-passing ;
    vc:implements ngm:message-passing ;
    vc:isPartOf ngm:graph-neural-network ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:graph-convolutional-network,
        ngm:graph-neural-network,
        ngm:self-attention ;
    vc:requires ngm:deep-learning ;
    vc:slug "graph-attention-network" ;
    vc:sourceDomain "machine-learning" ;
    vc:supports ngm:node-classification ;
    vc:uses ngm:message-passing,
        ngm:self-attention .

ngm:graphql a owl:Class ;
    rdfs:label "Graphql"@en ;
    rdfs:comment "GraphQL is a query language and runtime for APIs in which clients specify exactly the data they need against a strongly typed schema, and the server returns precisely that shape in a single response. A single endpoint exposes a graph of types whose fields are resolved by server-side resolvers, eliminating the over-fetching and under-fetching common to fixed REST endpoints. GraphQL supports queries, mutations and subscriptions, and its self-describing schema enables strong tooling, introspection and client code generation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:schema ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
