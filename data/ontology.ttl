ngm:archival-node a owl:Class ;
    rdfs:label "Archival Node"@en ;
    rdfs:comment "An Archival Node is a blockchain network participant that stores the complete historical state of the ledger—every block, transaction, and state root from genesis to the current tip—without pruning older data. Unlike pruned nodes or light nodes, an archival node can respond to queries about any historical state at any block height, making it essential for block explorers, analytics services, and smart contract developers who need point-in-time state access."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:peer-to-peer-network ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:blockchain-protocol ],
        ngm:bc-network-component,
        ngm:blockchain-entity,
        ngm:network-component ;
    skos:broader ngm:bc-network-component ;
    vc:contrastsWith ngm:light-node,
        ngm:pruned-node ;
    vc:enables ngm:blockchain-compliance,
        ngm:blockchain-transaction,
        ngm:long-term-archival ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:blockchain-infrastructure,
        ngm:blockchain-network,
        ngm:chain-state,
        ngm:full-node ;
    vc:requires ngm:blockchain-protocol,
        ngm:peer-to-peer-network ;
    vc:slug "archival-node" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:state-machine-replication .

ngm:auction-mechanism a owl:Class ;
    rdfs:label "Auction Mechanism"@en ;
    rdfs:comment "An auction mechanism is a structured rule set for allocating goods or resources and determining prices through competitive bidding among participants with private valuations. It specifies how bids are collected, who wins, and what each winner pays, with classic forms including English, Dutch, first-price sealed-bid, and Vickrey (second-price) auctions, each inducing different bidding incentives. Auction mechanisms are central to market design, online advertising, and resource allocation in multi-agent and computational settings."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:incentive-mechanism ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:price-discovery ],
        ngm:mechanism-design ;
    vc:contrastsWith ngm:price-discovery ;
    vc:enables ngm:programmatic-advertising,
        ngm:resource-allocation ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:incentive-mechanism,
        ngm:price-discovery ;
    vc:implements ngm:mechanism-design ;
    vc:isPartOf ngm:economic-mechanism ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:marketplace,
        ngm:resource-management ;
    vc:slug "auction-mechanism" ;
    vc:sourceDomain "data" ;
    vc:supports ngm:multi-agent-coordination,
        ngm:virtual-economy ;
    vc:uses ngm:game-theory .

ngm:audio-spatialization a owl:Class ;
    rdfs:label "Audio Spatialization"@en ;
    rdfs:comment "Audio Spatialization is the technique of positioning sounds in three-dimensional space using Head-Related Transfer Functions (HRTFs), binaural processing, and ambisonics to create realistic 3D audio experiences that respond to listener position and head movement in virtual reality and immersive applications."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
