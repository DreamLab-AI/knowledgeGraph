ngm:dynamic-character-animation a owl:Class ;
    rdfs:label "Dynamic Character Animation"@en ;
    rdfs:comment "Real-time procedural animation techniques that enable 3D avatars and characters to move, express, and respond dynamically to user input and environmental stimuli in metaverse environments, utilising motion capture, rigging systems, and AI-driven motion synthesis."@en ;
