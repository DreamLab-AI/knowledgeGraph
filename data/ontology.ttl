    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:algorithm-implementation,
        ngm:cryptographic-key-management,
        ngm:random-number-generation ;
    vc:slug "post-quantum-cryptography" ;
    vc:sourceDomain "infrastructure" .

ngm:presence a owl:Class ;
