ngm:ieee-7000 a owl:Class ;
    rdfs:label "IEEE 7000"@en ;
    rdfs:comment "IEEE 7000 (formally IEEE Std 7000-2021) is an international standard that defines a process model for embedding ethical considerations into the design and engineering of autonomous and software-intensive systems. It provides a structured methodology — spanning concept exploration, value elicitation, ethical risk analysis, and requirements specification — enabling engineers and organisations to systematically address value conflicts during the systems development life cycle. Grounded in value-sensitive design theory, the standard bridges engineering practice with stakeholder ethics, offering normative guidance on transparency, accountability, and harm avoidance in technology development."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:stakeholder-analysis ],
        ngm:technical-standard ;
    vc:bridgesTo ngm:explainable-ai,
        ngm:machine-learning-fairness ;
    vc:contrastsWith ngm:gdpr,
        ngm:iso-26000 ;
    vc:enables ngm:algorithmic-accountability,
        ngm:ethical-system-design,
        ngm:responsible-ai ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:requirements-engineering,
        ngm:systems-engineering ;
    vc:isPartOf ngm:ieee-7000-series ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:eu-ai-act,
        ngm:ieee-ethically-aligned-design,
        ngm:iso-iec-42001,
        ngm:nist-ai-rmf ;
    vc:requires ngm:ethical-risk-assessment,
        ngm:stakeholder-analysis,
        ngm:value-sensitive-design ;
    vc:slug "ieee-7000" ;
    vc:sourceDomain "governance" ;
    vc:standardizedBy ngm:ieee ;
    vc:supports ngm:ai-governance,
        ngm:digital-ethics,
        ngm:trustworthy-ai ;
    vc:uses ngm:concept-of-operations,
        ngm:ethical-value-register,
        ngm:value-elicitation .

