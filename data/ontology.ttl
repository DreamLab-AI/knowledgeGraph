ngm:carbon-offset-programme a owl:Class ;
    rdfs:label "Carbon Offset Programme"@en ;
    rdfs:comment "A carbon offset programme is a structured scheme that generates, certifies, issues, and retires carbon credits representing greenhouse gas emissions reductions or removals achieved by specific projects or activities, providing a mechanism by which organisations or individuals can compensate for their own emissions by financing equivalent climate action elsewhere. Programmes operate under standards bodies — including the Verified Carbon Standard (Verra), Gold Standard, American Carbon Registry (ACR), and Climate Action Reserve — that define methodologies for quantifying emissions impacts, require independent verification, and maintain public registries to prevent double-counting of credits. Projects include avoided deforestation (REDD+), renewable energy, methane capture, reforestation, and engineered carbon removal."@en ;
    rdfs:subClassOf ngm:carbon-offset-trading ;
    vc:enables ngm:carbon-neutrality,
        ngm:voluntary-carbon-market ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:environmental-certificate,
        ngm:esg-reporting ;
    vc:slug "carbon-offset-programme" ;
    vc:sourceDomain "governance" ;
    vc:uses ngm:carbon-credits,
        ngm:carbon-offset-certificate,
        ngm:carbon-registry .

ngm:cbeci a owl:Class ;
    rdfs:label "CBECI"@en ;
    rdfs:comment "The Cambridge Bitcoin Electricity Consumption Index (CBECI) is a real-time model produced by the Cambridge Centre for Alternative Finance that estimates the annualised electricity consumption and carbon footprint of the Bitcoin proof-of-work mining network. It aggregates hardware efficiency data from known ASIC models, network hash rate, and electricity price assumptions to produce lower-, central-, and upper-bound estimates."@en ;
    rdfs:subClassOf ngm:benchmark-evaluation ;
    vc:bridgesTo ngm:governance,
        ngm:infrastructure ;
    vc:contrastsWith ngm:proof-of-stake ;
    vc:dependsOn ngm:blockchain,
        ngm:proof-of-work ;
    vc:enables ngm:carbon-accounting,
        ngm:renewable-energy-certificates ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:bitcoin-proof-of-work-protocol-environmental-issues,
        ngm:bitcoin-proof-of-work-protocol-mining,
        ngm:cambridge-centre-for-alternative-finance,
        ngm:carbon-footprint,
        ngm:proof-of-work-energy-consumption,
        ngm:sustainable-bitcoin-protocol ;
    vc:slug "cbeci" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:bc-0482-eu-mica-regulation,
        ngm:cryptocurrency-regulation ;
    vc:uses ngm:asic-hardware,
        ngm:cbeci-methodology,
        ngm:difficulty,
        ngm:electricity-consumption,
        ngm:hash-rate,
        ngm:mining-pool .

ngm:central-bank-digital-currency-cbdc a owl:Class ;
    rdfs:label "Central Bank Digital Currency (CBDC)"@en ;
