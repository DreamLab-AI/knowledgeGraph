ngm:mixup a owl:Class ;
    rdfs:label "Mixup"@en ;
    rdfs:comment "A data augmentation technique that creates virtual training samples by computing convex linear combinations of input pairs and their corresponding labels, parameterised by a mixing coefficient drawn from a Beta distribution. Mixup reduces overfitting, improves calibration, and promotes smoother decision boundaries across supervised and semi-supervised learning tasks."@en ;
    rdfs:subClassOf ngm:ai-technique,
