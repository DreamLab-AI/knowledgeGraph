ngm:envoy-proxy a owl:Class ;
    rdfs:label "Envoy Proxy"@en ;
    rdfs:comment "Envoy is a high-performance, open-source edge and service proxy designed for cloud-native applications, originally built at Lyft and graduated under the CNCF. It provides L3/L4 and L7 traffic management, dynamic configuration via the xDS APIs, observability, and resilience features such as retries, circuit breaking, and rate limiting. Envoy is the default data plane for many service meshes, where it runs as a sidecar alongside each workload."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:circuit-breaker ],
        [ a owl:Restriction ;
