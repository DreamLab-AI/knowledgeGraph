ngm:automated-reasoning a owl:Class ;
    rdfs:label "Automated Reasoning"@en ;
    rdfs:comment "Automated Reasoning is a subfield of artificial intelligence and computer science concerned with developing algorithms and systems that can perform logical inference, theorem proving, satisfiability checking, and knowledge-based deduction without continuous human guidance. It encompasses formal methods such as first-order logic, propositional calculus, and higher-order logics, implemented in systems ranging from SAT solvers and automated theorem provers to description logic reasoners underpinning knowledge graphs. Automated reasoning forms the rigorous backbone of formal verification, ontology inference, planning, and constraint satisfaction problems."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:knowledge-representation ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:theorem-proving ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:formal-logic ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:sat-solving ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:model-checking ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:description-logic ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:inference-engine ],
        ngm:reasoning ;
    vc:bridgesTo ngm:formal-methods ;
    vc:contrastsWith ngm:deep-learning,
        ngm:probabilistic-reasoning ;
    vc:enables ngm:automated-planning,
        ngm:formal-verification,
        ngm:knowledge-graph,
        ngm:program-synthesis ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:description-logic,
        ngm:model-checking,
        ngm:sat-solving,
        ngm:theorem-proving ;
    vc:qualityScore "0.91"^^xsd:float ;
    vc:relatedTo ngm:logic-programming,
        ngm:neuro-symbolic-ai,
        ngm:symbolic-reasoning ;
    vc:requires ngm:formal-logic,
        ngm:inference-engine,
        ngm:knowledge-representation ;
    vc:slug "automated-reasoning" ;
    vc:sourceDomain "ai" ;
    vc:supports ngm:ai-alignment,
        ngm:expert-systems,
        ngm:symbolic-ai ;
    vc:uses ngm:constraint-satisfaction,
        ngm:first-order-logic .

ngm:capital-adequacy a owl:Class ;
    rdfs:label "Capital Adequacy"@en ;
    rdfs:comment "Capital adequacy is the regulatory and risk management requirement that financial institutions maintain a minimum level of capital relative to their risk-weighted assets, ensuring they can absorb losses without becoming insolvent and thereby protecting depositors, counterparties, and the broader financial system. The Basel Committee on Banking Supervision (BCBS) has codified capital adequacy requirements through successive accords — Basel I (1988), Basel II (2004), Basel III (2010, phased through 2028) — specifying the composition of qualifying capital (Common Equity Tier 1, Additional Tier 1, Tier 2) and the risk-weighting methodologies for credit, market, and operational risk exposures."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:stress-testing ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:risk-weighted-assets ],
        ngm:compliance-framework ;
    vc:bridgesTo ngm:climate-financial-risk ;
    vc:dependsOn ngm:credit-risk,
        ngm:market-risk,
        ngm:operational-risk ;
    vc:enables ngm:compliance-monitoring,
        ngm:financial-stability,
        ngm:systemic-risk ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:capital-conservation-buffer,
        ngm:common-equity-tier-1,
        ngm:countercyclical-capital-buffer ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:compliance,
        ngm:liquidity-coverage-ratio,
        ngm:risk-management ;
    vc:requires ngm:risk-weighted-assets,
        ngm:stress-testing ;
    vc:slug "capital-adequacy" ;
    vc:sourceDomain "finance" ;
    vc:standardizedBy ngm:basel-committee-on-banking-supervision,
        ngm:basel-iii,
        ngm:prudential-regulation ;
    vc:supports ngm:systemic-risk ;
    vc:uses ngm:risk-assessment .

ngm:censorship-resistance a owl:Class ;
    rdfs:label "Censorship Resistance"@en ;
    rdfs:comment "Property of blockchain networks guaranteeing that any valid transaction submitted by any participant will eventually be included in the canonical chain, preventing miners, validators, or any coordinated group from systematically excluding transactions. Achieved through decentralised consensus, permissionless participation, and economic incentive alignment."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
