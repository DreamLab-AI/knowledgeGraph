        ngm:impedance-control,
        ngm:optimal-control,
        ngm:torque-control,
        ngm:visual-servoing ;
    vc:requires ngm:actuator,
        ngm:robot-dynamics,
        ngm:robot-kinematics,
        ngm:sensor-fusion ;
    vc:slug "robotic-control" ;
    vc:sourceDomain "robotics" ;
    vc:supports ngm:human-robot-interaction,
        ngm:robotics ;
    vc:uses ngm:force-control,
        ngm:inverse-kinematics,
        ngm:kalman-filter,
        ngm:model-predictive-control,
        ngm:motion-control,
        ngm:pid-control .

ngm:rule-of-law a owl:Class ;
    rdfs:label "Rule of Law"@en ;
    rdfs:comment "The constitutional and institutional principle that all persons, institutions, and entities—including AI systems and their operators—are accountable to laws that are publicly promulgated, equally enforced, independently adjudicated, and consistent with international human rights norms. Applied to AI governance, the rule of law requires legal certainty, non-arbitrary decision-making, procedural fairness, and effective remedies for AI-related harms."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:legal-framework ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:accountability ],
        ngm:infra-legal-and-regulatory,
        ngm:legal-framework ;
    skos:broader ngm:infra-legal-and-regulatory ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:ai-governance,
        ngm:compliance-framework ;
    vc:requires ngm:accountability,
        ngm:legal-framework ;
    vc:slug "rule-of-law" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:ai-ethics,
        ngm:democratic-values,
        ngm:human-rights .

ngm:scheduler a owl:Class ;
    rdfs:label "Scheduler"@en ;
    rdfs:comment "A scheduler is a system component that decides which units of work run, where they run and in what order, allocating finite computing resources among competing tasks over time. Schedulers exist at many layers, from operating-system process and thread scheduling to cluster and container orchestration that places workloads across machines. Their policies trade off throughput, latency, fairness and resource utilisation according to the goals of the platform."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:resource-allocation ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:priority-queue ],
        ngm:resource-management ;
    vc:enables ngm:autoscaling,
        ngm:throughput ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:priority-queue ;
    vc:implements ngm:kubernetes ;
    vc:isPartOf ngm:operating-system,
        ngm:resource-management ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:latency,
        ngm:orchestration,
        ngm:real-time-operating-system ;
    vc:requires ngm:resource-allocation ;
    vc:slug "scheduler" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:batch-processing,
        ngm:concurrency,
        ngm:container-orchestration ;
    vc:uses ngm:load-balancing,
