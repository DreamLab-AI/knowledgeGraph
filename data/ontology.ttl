    vc:slug "search-algorithm" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:graph-search,
        ngm:heuristic-methods .

ngm:semantic-interoperability a owl:Class ;
    rdfs:label "Semantic Interoperability"@en ;
    rdfs:comment "Semantic interoperability is the capability of disparate systems to exchange data with shared, unambiguous meaning by aligning data models, ontologies, and controlled vocabularies. Unlike syntactic interoperability, which concerns data format agreement, semantic interoperability requires that the interpretation of data values is consistent across system boundaries, typically enforced through shared ontologies, RDF triplestores, or standardised schema mappings. It underpins federated knowledge graphs, cross-platform data sharing, and machine-readable regulatory compliance."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-standards ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ontology ],
        ngm:sc-standards-and-interop ;
    skos:broader ngm:sc-standards-and-interop ;
    vc:enables ngm:data-interoperability,
        ngm:knowledge-graph ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:interoperability-standard,
        ngm:linked-data ;
    vc:requires ngm:data-standards,
        ngm:ontology ;
    vc:slug "semantic-interoperability" ;
    vc:sourceDomain "spatial-computing" .

ngm:simulation-engine a owl:Class ;
    rdfs:label "Simulation Engine"@en ;
    rdfs:comment "The computational core that manages state updates, inter-object interactions, deterministic execution, and data instrumentation within a simulation. Specialised engines include physics engines (PhysX, Bullet), behaviour-simulation engines, and AI training frameworks that expose parametric control, checkpointing, and massive parallelisation for large-scale experimental runs."@en ;
    rdfs:subClassOf ngm:infra-computing-and-cloud ;
    skos:broader ngm:infra-computing-and-cloud ;
    vc:enables ngm:digital-twin,
