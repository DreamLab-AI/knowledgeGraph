ngm:financial-sovereignty a owl:Class ;
    rdfs:label "Financial Sovereignty"@en ;
    rdfs:comment "Financial Sovereignty is the capacity of an individual, community, or nation to exercise autonomous control over their financial resources, transactions, and monetary decisions without dependence on or interference from external authorities, intermediaries, or censorship mechanisms. At the individual level it encompasses self-custody of assets, privacy in transactions, and access to financial services irrespective of geographic or political constraints; at the national level it encompasses independent monetary policy and control over reserve currencies."@en ;
    rdfs:subClassOf ngm:monetary-sovereignty ;
    vc:contrastsWith ngm:central-bank-digital-currency-cbdc ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:censorship-resistance,
        ngm:financial-inclusion,
        ngm:self-custody ;
    vc:slug "financial-sovereignty" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:cryptocurrency,
        ngm:self-sovereign-identity .

ngm:finite-element-analysis a skos:Concept ;
    rdfs:label "Finite Element Analysis"@en .

ngm:flow-matching a owl:Class ;
    rdfs:label "Flow Matching"@en ;
    rdfs:comment "Flow Matching is a generative modelling framework that trains a neural network to parameterise the vector field of a continuous normalising flow by directly regressing on analytically tractable target vector fields defined along conditional flow paths between a source distribution (typically Gaussian noise) and a data distribution. Unlike score-based diffusion models, which require simulating a stochastic differential equation during training, flow matching uses deterministic conditional flow paths that can be computed in closed form via Conditional Flow Matching (CFM), yielding stable and efficient training without ODE simulation at training time. At inference the learned vector field is integrated with an ODE solver to transport samples from noise to data, enabling high-quality generation with fewer neural function evaluations than diffusion alternatives. The framework unifies and generalises prior work on continuous normalising flows, score matching, and diffusion probabilistic models under a single regression objective."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:neural-network ],
        ngm:generative-model ;
    vc:bridgesTo ngm:computational-biology,
        ngm:drug-discovery ;
    vc:contrastsWith ngm:diffusion-model,
        ngm:generative-adversarial-network,
        ngm:normalising-flow,
        ngm:variational-autoencoder ;
    vc:enables ngm:audio-generation,
        ngm:image-synthesis,
        ngm:molecular-generation,
        ngm:protein-structure-prediction ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:conditional-flow-matching,
        ngm:ode-solver,
        ngm:vector-field ;
    vc:isPartOf ngm:continuous-normalising-flow ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:denoising-diffusion-probabilistic-model,
        ngm:latent-diffusion-model,
        ngm:rectified-flow,
        ngm:score-based-generative-model ;
    vc:requires ngm:neural-network,
        ngm:ordinary-differential-equation,
        ngm:probability-distribution ;
    vc:slug "flow-matching" ;
    vc:sourceDomain "machine-learning" ;
    vc:uses ngm:deep-learning,
        ngm:optimal-transport,
        ngm:score-matching,
        ngm:stochastic-interpolant .

ngm:geospatial-technology a owl:Class ;
    rdfs:label "Geospatial Technology"@en ;
    rdfs:comment "Geospatial Technology encompasses the integrated suite of tools, systems, and methodologies used to acquire, store, process, analyse, and visualise data that is referenced to locations on or near the Earth's surface. It combines hardware systems such as GPS receivers, LiDAR scanners, and remote sensing satellites with software platforms including Geographic Information Systems (GIS), geospatial databases, and mapping engines to produce authoritative spatial representations. In spatial computing and immersive environments, geospatial technology provides the world-scale coordinate infrastructure required for digital twin construction, precise AR/VR anchoring, autonomous navigation, and location-aware services. The discipline spans geodesy, photogrammetry, cartography, and real-time positioning, forming a foundational layer beneath smart city infrastructure, environmental monitoring, and logistics optimisation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:geospatial-information ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:remote-sensing ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:lidar ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:gps ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:spatial-database ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:photogrammetry ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:sensor-fusion ],
        ngm:spatial-computing ;
    skos:broader ngm:spatial-computing ;
    vc:bridgesTo ngm:artificial-intelligence,
        ngm:blockchain,
        ngm:internet-of-things ;
    vc:contrastsWith ngm:indoor-positioning-system ;
    vc:enables ngm:augmented-reality,
        ngm:autonomous-navigation,
        ngm:digital-twin,
        ngm:smart-city,
        ngm:venue-tethered-immersive-experience ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:geographic-information-system,
        ngm:geospatial-information,
        ngm:gps,
        ngm:lidar,
        ngm:photogrammetry,
        ngm:remote-sensing ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:cartography,
        ngm:geodesy,
        ngm:spatial-data-infrastructure ;
    vc:requires ngm:sensor-fusion,
        ngm:spatial-database ;
    vc:slug "geospatial-technology" ;
    vc:sourceDomain "spatial-computing" ;
    vc:standardizedBy ngm:iso-tc211,
        ngm:open-geospatial-consortium ;
    vc:supports ngm:disaster-response,
        ngm:environmental-monitoring,
        ngm:supply-chain-management ;
    vc:uses ngm:cloud-computing,
