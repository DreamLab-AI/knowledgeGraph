ngm:knowledge-artefact-update-cycle a owl:Class ;
    rdfs:label "Knowledge Artefact Update Cycle"@en ;
    rdfs:comment "A Knowledge Artefact Update Cycle is a structured, recurring process through which knowledge assets — including ontology classes, documentation nodes, linked data graphs, and curated references — are reviewed, validated, corrected, and re-published to maintain epistemic accuracy and semantic coherence. The cycle defines per-artefact cadences calibrated to the rate of change of underlying domains, balancing maintenance cost against information decay. It sits at the intersection of knowledge lifecycle management, data stewardship, and continuous integration practices applied to semantic knowledge bases. Effective update cycles incorporate provenance tracking, diff-based change detection, and staleness thresholds to trigger targeted refresh actions without wholesale reconstruction of the knowledge graph."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:version-control ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:provenance-tracking ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-quality-management ],
