ngm:digital-signal-processing a owl:Class ;
    rdfs:label "Digital Signal Processing"@en ;
    rdfs:comment "The mathematical and computational techniques for representing, transforming, and manipulating signals in digital form, including filtering, spectral analysis, compression, and enhancement — enabling real-time audio processing, video analysis, spatial audio for VR/AR, and sensor data interpretation critical for immersive and intelligent systems."@en ;
