# Reputation System
infrastructure:ReputationSystem rdf:type owl:Class ;
    rdfs:subClassOf infrastructure:SocialTrustMechanism ;
    rdfs:subClassOf infrastructure:FeedbackSystem ;
    rdfs:subClassOf infrastructure:DecentralisedGovernance ;
    rdfs:label "Reputation System"@en ;
    rdfs:comment "A Reputation System is a decentralised mechanism aggregating verified feedback about participant behaviour into quantified trust scores, enabling social coordination in trustless Blockchain environments where past transaction history and community validation predict future reliability and quality of interactions."@en ;
    skos:prefLabel "Reputation System"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:infrastructure:reputation-system" ;
    owl:sameAs <urn:visionclaw:concept:infrastructure:reputation-system> ;
    vcw:contentHash "sha256-stub-012" ;
    vcw:qualityScore "0.35"^^xsd:decimal ;
    vcw:legacyTermId "NGM-reputation-system" ;
    vcw:ontologyStatus "stub" ;
    vcw:maturityLevel "emerging" ;
    vcw:authorityScore "0.6"^^xsd:decimal ;
    dcterms:identifier "NGM-reputation-system" ;
    dcterms:subject "infrastructure" ;
    owl:versionInfo "1.0.0" ;
    dcterms:created "2026-04-26T00:00:00Z"^^xsd:dateTime ;
    dcterms:modified "2026-04-26T00:00:00Z"^^xsd:dateTime ;
    vcw:owlRole "Object" .

infrastructure:ReputationSystem rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty infrastructure:requires ;
    owl:someValuesFrom infrastructure:TransactionHistory
] .

infrastructure:ReputationSystem rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty infrastructure:requires ;
    owl:someValuesFrom infrastructure:CryptographicProof
] .

infrastructure:ReputationSystem rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty infrastructure:requires ;
    owl:someValuesFrom infrastructure:AggregationAlgorithm
] .

infrastructure:ReputationSystem rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty infrastructure:enables ;
    owl:someValuesFrom infrastructure:TrustNetworks
] .

infrastructure:ReputationSystem rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty infrastructure:enables ;
    owl:someValuesFrom infrastructure:RiskAssessment
] .

infrastructure:ReputationSystem rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty infrastructure:enables ;
    owl:someValuesFrom infrastructure:PeerSelection
] .

infrastructure:ReputationSystem vcw:bridgesTo infrastructure:TraditionalRatingSystems .

infrastructure:ReputationSystem vcw:bridgesTo infrastructure:CreditScoring .

