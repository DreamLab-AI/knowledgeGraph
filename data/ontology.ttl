ngm:operational-resilience a owl:Class ;
    rdfs:label "Operational Resilience"@en ;
    rdfs:comment "Operational Resilience is the organisational and technical capacity to anticipate, prepare for, withstand, recover from, and adapt to disruptions—whether caused by cyber-attacks, infrastructure failures, natural disasters, or human error—in a manner that maintains continuity of critical business services. It extends traditional business continuity and disaster recovery concepts by placing emphasis on setting impact tolerances for important business services and testing end-to-end resilience under realistic disruption scenarios. Operational resilience is increasingly mandated by financial regulators and embedded in frameworks such as the Bank of England's SS1/21 and the EU's Digital Operational Resilience Act (DORA)."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:high-availability ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:fault-tolerance ],
        ngm:infra-computing-and-cloud ;
    skos:broader ngm:infra-computing-and-cloud ;
    vc:enables ngm:resilience ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:compliance-framework,
        ngm:monitoring-dashboard,
        ngm:risk-assessment ;
    vc:requires ngm:fault-tolerance,
        ngm:high-availability ;
    vc:slug "operational-resilience" ;
    vc:sourceDomain "infrastructure" .

ngm:order-book a owl:Class ;
    rdfs:label "Order Book"@en ;
    rdfs:comment "A continuously updated record of outstanding buy and sell orders for an asset, organised by price level, against which incoming orders are matched."@en ;
