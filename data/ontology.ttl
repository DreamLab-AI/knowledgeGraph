ngm:ieee-802-15-4 a owl:Class ;
    rdfs:label "IEEE 802.15.4"@en ;
    rdfs:comment "IEEE 802.15.4 is a low-rate wireless personal area network (LR-WPAN) standard that specifies the physical layer (PHY) and medium access control (MAC) sublayer for short-range, low-power, low-data-rate wireless communication, operating primarily in the 2.4 GHz ISM band at up to 250 kbps. It serves as the foundational radio layer for higher-level IoT protocols including Zigbee, Thread, WirelessHART, and 6LoWPAN, enabling battery-powered sensor and actuator networks with multi-year device lifetimes."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:ultra-wideband ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:physical-layer ],
        ngm:ieee-802-x ;
    vc:bridgesTo ngm:precision-agriculture,
        ngm:smart-building ;
    vc:contrastsWith ngm:bluetooth-mesh,
        ngm:ieee-802-11 ;
    vc:enables ngm:internet-of-things,
        ngm:io-t-sensor-network,
        ngm:mesh-networking ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:csma-ca,
        ngm:physical-layer,
        ngm:ultra-wideband ;
    vc:implements ngm:6lowpan,
        ngm:thread-protocol,
        ngm:wireless-hart,
        ngm:zigbee ;
    vc:isPartOf ngm:ieee-802-x ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:lpwan,
        ngm:matter-protocol,
        ngm:thread-protocol,
        ngm:wireless-hart,
        ngm:zigbee ;
    vc:requires ngm:ism-band ;
    vc:slug "ieee-802-15-4" ;
    vc:sourceDomain "infrastructure" ;
    vc:standardizedBy ngm:ieee ;
    vc:supports ngm:industrial-automation,
        ngm:matter-protocol,
        ngm:smart-metering .

ngm:initial-coin-offering a owl:Class ;
    rdfs:label "Initial Coin Offering"@en ;
    rdfs:comment "An initial coin offering (ICO) is a blockchain-based fundraising mechanism in which a project issues and sells newly created cryptographic tokens to early backers, typically in exchange for established cryptocurrencies such as Bitcoin or Ether. Tokens are usually distributed via smart contracts and may grant utility within a planned protocol, governance rights, or speculative value. Pioneered around 2013–2017, ICOs enabled permissionless global capital formation but attracted intense regulatory scrutiny over investor protection and securities classification, prompting more structured successors such as security token offerings and initial exchange offerings."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:token-sale ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptocurrency-wallet ],
        ngm:cryptocurrency-token ;
    vc:bridgesTo ngm:initial-dex-offering,
        ngm:initial-exchange-offering ;
    vc:contrastsWith ngm:initial-public-offering,
        ngm:security-token-offering ;
    vc:dependsOn ngm:ethereum ;
    vc:enables ngm:capital-formation,
        ngm:decentralised-fundraising ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:token-sale,
        ngm:whitepaper ;
    vc:isPartOf ngm:token-economics ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:crowdfunding,
        ngm:securities-regulation ;
    vc:requires ngm:cryptocurrency-wallet ;
    vc:slug "initial-coin-offering" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:protocol-bootstrapping,
        ngm:utility-token ;
    vc:uses ngm:erc-20,
        ngm:smart-contract .

ngm:innovation a owl:Class ;
    rdfs:label "Innovation"@en ;
    rdfs:comment "Innovation is the process of creating and successfully introducing new or significantly improved products, services, processes or business models that deliver value. It spans the journey from invention and creative ideation through development, adoption and diffusion across markets and organisations. Innovation is a primary driver of economic growth, competitiveness and societal change, and is closely linked to research, knowledge transfer and entrepreneurship."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:knowledge-transfer ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:collaboration ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:knowledge-transfer ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:technology-transfer ],
