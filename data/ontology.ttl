ngm:transfer-function a owl:Class ;
    rdfs:label "Transfer Function"@en ;
    rdfs:comment "A transfer function is the Laplace-domain (continuous-time) or Z-domain (discrete-time) ratio of output to input for a linear time-invariant (LTI) system with zero initial conditions, expressed as a ratio of polynomials whose roots yield the poles and zeros that determine the system's frequency response, stability, and transient behaviour. Transfer functions provide a frequency-domain characterisation of systems ranging from electronic filters and mechanical actuators to feedback control loops."@en ;
    rdfs:subClassOf ngm:control-theory ;
    vc:contrastsWith ngm:state-estimation ;
    vc:enables ngm:feedback-control,
        ngm:optimal-control ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:bode-plot,
        ngm:control-system,
        ngm:kalman-filter ;
    vc:slug "transfer-function" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:digital-signal-processing,
        ngm:signal-processing .

ngm:transfer-of-funds-regulation a skos:Concept ;
    rdfs:label "Transfer Of Funds Regulation"@en .

ngm:transmission-network a owl:Class ;
    rdfs:label "Transmission Network"@en ;
    rdfs:comment "A transmission network is the high-voltage infrastructure that carries bulk electrical power over long distances from generation sites to distribution substations near consumers. Comprising transmission lines, transformers, and switching stations, it minimises resistive losses through high voltages and is operated as a synchronised grid balancing supply and demand in real time."@en ;
    rdfs:subClassOf ngm:digital-infrastructure ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:energy-and-power ;
    vc:slug "transmission-network" ;
    vc:sourceDomain "infrastructure" .

ngm:transparency-and-explainability a owl:Class ;
    rdfs:label "Transparency and Explainability"@en ;
    rdfs:comment "Transparency and Explainability is a core AI trustworthiness dimension requiring that AI systems disclose sufficient information about their operation, decision logic, data provenance, and limitations to enable appropriate understanding and oversight by developers, deployers, and affected users. It encompasses traceability (audit trails, dataset documentation), explainability (global and local model explanations, counterfactuals), and communication transparency (disclosing AI involvement and system boundaries). Regulatory frameworks such as the EU AI Act Article 13 mandate transparency obligations for high-risk AI systems, driving demand for methods such as SHAP, LIME, and AI model cards."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ai-audit ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:audit-trail ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:explainability ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:ai-model-card ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:interpretability ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:explainable-ai ],
        ngm:ai-governance-and-ethics ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:contrastsWith ngm:intrinsic-interpretability ;
    vc:enables ngm:accountability,
        ngm:ai-trustworthiness,
        ngm:algorithmic-accountability ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:ai-model-card,
        ngm:audit-trail,
        ngm:explainability,
        ngm:interpretability ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:ai-governance-framework,
        ngm:ai-regulation,
        ngm:decision-transparency,
        ngm:feature-importance,
        ngm:post-hoc-explanation ;
    vc:requires ngm:ai-audit,
        ngm:explainable-ai ;
    vc:slug "transparency-and-explainability" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:transparency-obligation a owl:Class ;
    rdfs:label "Transparency Obligation"@en ;
    rdfs:comment "A transparency obligation is a regulatory duty to disclose how a system works or that it is in use, such as informing people when they interact with an AI system or with generated content."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
