    vc:bridgesTo ngm:ai-governance-and-ethics,
        ngm:autonomous-systems,
        ngm:cognitive-science ;
    vc:contrastsWith ngm:ai-capabilities-research ;
    vc:enables ngm:ai-alignment,
        ngm:ai-safety,
        ngm:corrigibility,
        ngm:responsible-ai,
        ngm:trustworthy-ai ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.88"^^xsd:float ;
    vc:relatedTo ngm:ai-risk,
        ngm:existential-risk,
        ngm:fairness-in-machine-learning,
        ngm:prompt-injection,
        ngm:reward-hacking,
        ngm:scalable-oversight,
        ngm:specification-gaming ;
    vc:requires ngm:decision-theory,
