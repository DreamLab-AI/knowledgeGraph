        ngm:rendering-pipeline ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:3-d-content-generation ;
    vc:slug "3-d-content-pipeline" ;
    vc:sourceDomain "infrastructure" .

ngm:accessibility-standards a owl:Class ;
    rdfs:label "Accessibility Standards"@en ;
    rdfs:comment "Accessibility Standards for the metaverse and extended reality (XR) encompass guidelines, technical specifications, and design principles that ensure virtual environments, interfaces, and interactions are usable by people with diverse disabilities including visual, auditory, physical, cognitive, ..."@en ;
