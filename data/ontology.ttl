    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:consensus-protocol,
        ngm:distributed-nodes,
        ngm:load-balancing,
        ngm:network-topology,
        ngm:replication-strategy,
        ngm:state-synchronization ;
    vc:isPartOf ngm:reference-architecture,
        ngm:system-architecture ;
    vc:qualityScore "0.35"^^xsd:float ;
