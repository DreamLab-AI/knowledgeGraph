    vc:sourceDomain "general" .

ngm:goal a owl:Class ;
    rdfs:label "Goal"@en ;
    rdfs:comment "A desired future state that an agent aims to realise through planned action sequences. Goals are declarative, future-oriented, and action-guiding; they encompass achievement, maintenance, optimisation, and avoidance types, and are managed in hierarchies that decompose complex objectives into sub-goals. In AI systems, goal specification is central to alignment: misspecified goals produce unintended consequences regardless of capability."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:value-alignment ],
        ngm:ai-technique,
        ngm:objective ;
    skos:broader ngm:ai-technique ;
    vc:enables ngm:agentic-ai,
        ngm:ai-agent-system ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:bdi-model ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:agent,
        ngm:autonomy-level,
        ngm:bdi-model ;
    vc:requires ngm:value-alignment ;
    vc:slug "goal" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:gpu-architecture a owl:Class ;
    rdfs:label "GPU Architecture"@en ;
    rdfs:comment "GPU architecture describes the design of graphics processing units as massively parallel processors built around many simple cores, wide memory interfaces and hardware for graphics-specific tasks."@en ;
