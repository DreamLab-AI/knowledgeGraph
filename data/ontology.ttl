    vc:slug "civic-participation" ;
    vc:sourceDomain "spatial-computing" .

ngm:class-imbalance a owl:Class ;
    rdfs:label "Class Imbalance"@en ;
    rdfs:comment "Class imbalance is the condition in a classification dataset where the number of examples in one class greatly exceeds that of another, causing learning algorithms to favour the majority class. It is common in problems such as fraud detection, medical diagnosis, and anomaly detection, where the events of interest are rare. Class imbalance undermines naive accuracy as an evaluation metric and motivates remedies such as resampling, cost-sensitive learning, and the use of precision-recall-oriented metrics."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:evaluation-metric ],
        ngm:classification ;
    vc:contrastsWith ngm:overfitting ;
    vc:dependsOn ngm:data-preprocessing ;
    vc:enables ngm:anomaly-detection,
        ngm:fraud-detection ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:classification,
        ngm:machine-learning ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:confusion-matrix,
        ngm:f1-score,
        ngm:precision-recall-curve,
        ngm:recall,
        ngm:roc-curve ;
    vc:requires ngm:evaluation-metric ;
    vc:slug "class-imbalance" ;
    vc:sourceDomain "machine-learning" ;
    vc:supports ngm:model-performance ;
    vc:uses ngm:feature-engineering,
        ngm:resampling .

ngm:classification-rules a owl:Class ;
    rdfs:label "Classification Rules"@en ;
    rdfs:comment "Classification Rules are explicit logical statements, typically in an if-then form, that assign instances or entities to predefined categories based on the values of their attributes or the satisfaction of specified conditions. Derived from rule-learning algorithms, expert elicitation, or ontology reasoning, classification rules provide interpretable, auditable decision logic for categorising data points in machine learning, knowledge engineering, and regulatory compliance contexts. They contrast with black-box classifiers by exposing their decision rationale directly as symbolic propositions."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:formal-logic ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:production-rules ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:inference-engine ],
        ngm:inference-engine ;
    vc:contrastsWith ngm:ensemble-methods,
        ngm:large-language-models,
        ngm:neural-network ;
    vc:dependsOn ngm:knowledge-base,
        ngm:supervised-learning ;
    vc:enables ngm:clinical-decision-support,
        ngm:expert-systems,
        ngm:explainability,
        ngm:interpretability,
        ngm:machine-learning-discipline ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:backward-chaining,
        ngm:forward-chaining,
        ngm:production-rules ;
    vc:qualityScore "0.92"^^xsd:float ;
    vc:relatedTo ngm:decision-tree,
        ngm:knowledge-base,
        ngm:large-language-models,
        ngm:owl,
        ngm:rdf ;
    vc:requires ngm:formal-logic,
        ngm:inference-engine ;
    vc:slug "classification-rules" ;
    vc:sourceDomain "ai" ;
    vc:supports ngm:business-rules-engine,
        ngm:natural-language-processing,
        ngm:neurosymbolic-ai ;
    vc:uses ngm:description-logic,
        ngm:formal-logic,
        ngm:knowledge-graph,
        ngm:logic-programming,
        ngm:ontology .

ngm:climate-tech a owl:Class ;
    rdfs:label "Climate Tech"@en ;
    rdfs:comment "Climate Tech encompasses the portfolio of technologies, platforms, and business models designed to mitigate greenhouse gas emissions, support climate adaptation, and accelerate the energy transition. It spans renewable energy generation, energy storage, carbon capture and removal, sustainable agriculture, climate risk analytics, and digital tools for emissions measurement and reporting. Climate Tech investment has grown into a distinct venture capital and corporate innovation category, underpinned by regulatory drivers, net-zero commitments, and the rapid cost-reduction curves of clean energy technologies."@en ;
    rdfs:subClassOf ngm:sustainability ;
    vc:enables ngm:carbon-markets,
        ngm:net-zero-targets,
        ngm:renewable-energy ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:carbon-credits,
        ngm:esg-reporting,
        ngm:sustainable-finance ;
    vc:slug "climate-tech" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:environmental-monitoring,
        ngm:machine-learning-discipline .

ngm:clock-recovery a owl:Class ;
    rdfs:label "Clock Recovery"@en ;
    rdfs:comment "Clock recovery (clock and data recovery, CDR) is the physical-layer process by which a receiver extracts a synchronised timing reference from an incoming data stream that carries no separate clock signal. It uses phase-locked loops or oversampling to align sampling instants with the centre of each symbol, compensating for jitter and frequency offset between transmitter and receiver. It matters because correct sampling timing is essential for reliable symbol detection in serial communication links."@en ;
    rdfs:subClassOf ngm:infra-network-and-comms ;
    skos:broader ngm:infra-network-and-comms ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:physical-layer ;
    vc:slug "clock-recovery" ;
    vc:sourceDomain "infrastructure" .

ngm:cloud-storage-infrastructure a owl:Class ;
    rdfs:label "Cloud Storage Infrastructure"@en ;
    rdfs:comment "Cloud storage infrastructure is the distributed system of servers, object and block stores, replication, and access APIs that lets applications persist and retrieve data on demand over a network. It provides durability through redundancy, elastic capacity, and tiered performance classes ranging from hot object storage to cold archives. It matters because it is the foundation for storing large media assets, such as meeting recordings, at scale with high availability and pay-as-you-go economics."@en ;
    rdfs:subClassOf ngm:infra-computing-and-cloud ;
    skos:broader ngm:infra-computing-and-cloud ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:meeting-recording ;
    vc:slug "cloud-storage-infrastructure" ;
    vc:sourceDomain "infrastructure" .

ngm:co-regulation a owl:Class ;
    rdfs:label "Co Regulation"@en ;
    rdfs:comment "Co-regulation is a governance model in which statutory authorities and industry actors jointly develop and enforce rules, blending the legitimacy and backstop powers of the state with the technical expertise and agility of the regulated sector. It sits between command-and-control regulation and pure self-regulation: codes of practice drafted by industry are approved and overseen by a public regulator that retains enforcement powers. The approach is common in online safety, broadcasting and data protection."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:compliance ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:accountability ],
        ngm:regulatory-framework ;
    vc:contrastsWith ngm:centralised-finance,
        ngm:self-regulation ;
    vc:enables ngm:data-governance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:policy-framework,
        ngm:regulation ;
    vc:isPartOf ngm:regulatory-framework ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:content-moderation,
        ngm:ofcom,
        ngm:uk-online-safety-act ;
    vc:requires ngm:accountability,
        ngm:compliance ;
    vc:slug "co-regulation" ;
    vc:sourceDomain "governance" ;
    vc:supports ngm:governance,
        ngm:platform-governance ;
    vc:uses ngm:audit,
        ngm:transparency-reporting .

ngm:cognitive-load-metric a owl:Class ;
    rdfs:label "Cognitive Load Metric"@en ;
