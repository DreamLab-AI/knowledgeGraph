ngm:food-safety-blockchain a owl:Class ;
    rdfs:label "Food Safety Blockchain"@en ;
    rdfs:comment "Food Safety Blockchain is the application of distributed ledger technology to establish immutable, multi-party farm-to-fork audit trails that enable near-instantaneous contamination source identification and surgical product recalls. By recording each Critical Tracking Event—harvest, cooling, packing, shipment, receipt—as a cryptographically linked on-chain entry, the approach reduces trace-back from days to seconds, minimises the volume of food unnecessarily recalled, and provides regulators and consumers with verifiable provenance data."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:consortium-blockchain ],
        ngm:blockchain-application ;
