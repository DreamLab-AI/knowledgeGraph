    vc:sourceDomain "spatial-computing" ;
    vc:standardizedBy ngm:etsi-domain-immersive ;
    vc:uses ngm:etsi-metaverse-domain-model .

ngm:metaverse-navigation-systems a owl:Class ;
    rdfs:label "Metaverse Navigation Systems"@en ;
    rdfs:comment "Metaverse navigation systems are spatially-embedded interaction mechanisms that enable users to traverse, orient, and coordinate within persistent three-dimensional virtual environments through modalities such as gaze-based controls, hand-tracking, locomotion techniques (joystick, teleportation, redirected walking), and spatial overlays including mini-maps and AR wayfinding cues. These systems integrate environmental awareness, social presence, and user experience design to maintain spatial cognition across interconnected virtual worlds. They form a critical infrastructure layer for usable, inclusive metaverse participation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:virtual-reality ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:extended-reality ],
        ngm:metaverse-and-telecollaboration,
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:metaverse,
        ngm:spatial-computing ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:augmented-reality,
        ngm:social-vr,
        ngm:telecollaboration,
        ngm:virtual-environment ;
    vc:requires ngm:extended-reality,
        ngm:virtual-reality ;
    vc:slug "metaverse-navigation-systems" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:avatar-system,
        ngm:presence,
        ngm:spatial-audio .

ngm:metaverse-standards-forum a owl:Class ;
    rdfs:label "Metaverse Standards Forum"@en ;
    rdfs:comment "The Metaverse Standards Forum is an industry consortium, hosted by the Khronos Group, that fosters interoperability standards for the metaverse and spatial computing by coordinating the work of existing standards bodies rather than authoring competing specifications itself. Founded in 2022 with members including Meta, Microsoft, NVIDIA, Sony, and the W3C, it convenes working groups on topics such as 3D asset interoperability, digital identity, and interoperable scene description, aiming to prevent the fragmentation that would result from proprietary, siloed virtual worlds."@en ;
    rdfs:subClassOf ngm:standards-body ;
    vc:enables ngm:interoperability,
        ngm:open-standard ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:technical-standard,
        ngm:web-standard ;
    vc:slug "metaverse-standards-forum" ;
    vc:sourceDomain "governance" .

ngm:methane-mitigation-mining a owl:Class ;
    rdfs:label "Methane Mitigation Mining"@en ;
    rdfs:comment "Methane mitigation mining is the practice of siting Bitcoin mining hardware at sources of vented or flared methane, such as oil wellheads and landfills, to combust the gas in generators that power the miners. The mining load creates a continuous, location-flexible demand for energy that would otherwise be wasted, converting a potent greenhouse gas into electricity and revenue. It is promoted as a way to reduce net emissions while monetising stranded hydrocarbons."@en ;
    rdfs:subClassOf ngm:sustainability ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:bitcoin-environmental-issues,
        ngm:stranded-energy-monetisation ;
    vc:slug "methane-mitigation-mining" ;
    vc:sourceDomain "blockchain" .

ngm:micropayment a owl:Class ;
    rdfs:label "Micropayment"@en ;
    rdfs:comment "Very small electronic payment processed automatically within digital environments for low-value transactions."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:transaction-validation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:digital-wallet ],
        [ a owl:Restriction ;
