ngm:employment-social-contract-under-automation a owl:Class ;
    rdfs:label "Employment Social Contract Under Automation"@en ;
    rdfs:comment "The evolving set of expectations, obligations and entitlements linking workers, employers and the state around employment, income security and social protection, examined specifically under conditions of technological displacement driven by automation, robotics and artificial intelligence. The concept encompasses both descriptive analysis of how existing labour-market settlements are stressed by AI-driven task substitution and normative debates about how governments, firms and civil society should renegotiate the terms of work, welfare and the distribution of productivity gains. It spans labour economics, political philosophy and public policy, treating technological change as a structural challenge to long-standing institutions such as collective bargaining, unemployment insurance and occupational licensing."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:governance ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ai-regulation ],
        ngm:ai-governance-and-ethics ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:bridgesTo ngm:ai-adoption,
        ngm:artificial-intelligence,
        ngm:robotics ;
    vc:contrastsWith ngm:gig-economy ;
    vc:enables ngm:just-transition ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:ai-driven-workforce-displacement-registry,
        ngm:future-of-work,
        ngm:income-inequality,
        ngm:platform-economy,
        ngm:universal-basic-income ;
    vc:requires ngm:ai-regulation,
        ngm:governance ;
    vc:slug "employment-social-contract-under-automation" ;
    vc:sourceDomain "governance" ;
    vc:supports ngm:democratic-governance .

