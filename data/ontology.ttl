ngm:ico-ai-guidance a owl:Class ;
    rdfs:label "ICO AI Guidance"@en ;
    rdfs:comment "The ICO AI Guidance is the body of guidance issued by the UK Information Commissioner's Office on applying data-protection law to artificial-intelligence systems. It covers lawful basis, fairness, transparency, automated decision-making, and the trade-offs between accuracy and privacy when processing personal data in AI. The guidance helps organisations demonstrate accountability and conduct data-protection impact assessments for AI deployments."@en ;
    rdfs:subClassOf ngm:ai-governance-framework ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:ai-search,
        ngm:hyper-personalisation ;
    vc:slug "ico-ai-guidance" ;
    vc:sourceDomain "governance" .

ngm:identity-portability a owl:Class ;
    rdfs:label "Identity Portability"@en ;
    rdfs:comment "Identity portability is the capacity for a user to move their digital identity, credentials, and associated reputation across platforms, services, or virtual worlds without re-establishing them from scratch. It relies on interoperable identity standards and user-controlled wallets so that authentication and verified attributes remain valid across boundaries. Portability is a cornerstone of self-sovereign identity and an open metaverse."@en ;
    rdfs:subClassOf ngm:digital-identity ;
    vc:enables ngm:avatar-interoperability ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:credential-format-standard ;
    vc:slug "identity-portability" ;
    vc:sourceDomain "infrastructure" .

ngm:identity-service a owl:Class ;
    rdfs:label "Identity Service"@en ;
    rdfs:comment "An identity service is a system component that manages the lifecycle of digital identities, providing authentication, authorisation, and identity data to other services within a platform architecture. It centralises functions such as user registration, credential issuance, session management, and federation so that applications can delegate trust decisions. Identity services are typically exposed via standard protocols such as OAuth 2.0, OpenID Connect, and SAML."@en ;
    rdfs:subClassOf ngm:identity-management ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:service-layer ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:platform-layer ;
    vc:slug "identity-service" ;
    vc:sourceDomain "security" .

ngm:ieee-1451 a owl:Class ;
    rdfs:label "IEEE 1451"@en ;
    rdfs:comment "An IEEE standard family defining interfaces for smart transducers, including transducer electronic data sheets (TEDS). It supports interoperability between sensors, actuators and networks."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ieee ],
        ngm:technical-standard ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:ieee ;
    vc:slug "ieee-1451" ;
    vc:sourceDomain "standards" .

ngm:ieee-7000 a owl:Class ;
    rdfs:label "IEEE 7000"@en ;
    rdfs:comment "IEEE 7000 (formally IEEE Std 7000-2021) is an international standard that defines a process model for embedding ethical considerations into the design and engineering of autonomous and software-intensive systems. It provides a structured methodology — spanning concept exploration, value elicitation, ethical risk analysis, and requirements specification — enabling engineers and organisations to systematically address value conflicts during the systems development life cycle. Grounded in value-sensitive design theory, the standard bridges engineering practice with stakeholder ethics, offering normative guidance on transparency, accountability, and harm avoidance in technology development."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:risk-assessment ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:stakeholder-analysis ],
        ngm:technical-standard ;
    vc:bridgesTo ngm:explainable-ai,
        ngm:machine-learning-fairness ;
    vc:contrastsWith ngm:gdpr,
        ngm:iso-26000 ;
    vc:enables ngm:algorithmic-accountability,
        ngm:responsible-ai ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:requirements-engineering,
        ngm:systems-engineering ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:eu-ai-act-regulatory-instrument,
        ngm:ieee,
        ngm:iso-iec-42001,
        ngm:nist-ai-rmf ;
    vc:requires ngm:risk-assessment,
        ngm:stakeholder-analysis,
        ngm:value-sensitive-design ;
    vc:slug "ieee-7000" ;
    vc:sourceDomain "governance" ;
    vc:standardizedBy ngm:ieee ;
    vc:supports ngm:ai-governance,
        ngm:digital-ethics,
        ngm:trustworthy-ai .

ngm:ifac a owl:Class ;
    rdfs:label "IFAC"@en ;
    rdfs:comment "The International Federation of Automatic Control (IFAC) is the world's primary international organisation for the science and engineering of automatic control, founded in 1957 and comprising national member organisations from over fifty countries. IFAC coordinates research, education, and standards activity across all aspects of control theory and its applications, including process control, robotics, mechatronics, aerospace, and intelligent transportation. It convenes the triennial IFAC World Congress and sponsors over forty technical committees covering specialised control domains. IFAC's publications and conference proceedings constitute a core reference body for the global control engineering community."@en ;
    rdfs:subClassOf ngm:control-system ;
    vc:enables ngm:adaptive-control,
        ngm:feedback-control,
        ngm:real-time-control ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:control-theory,
        ngm:ieee-control-systems-society,
        ngm:industrial-automation,
        ngm:pid-controller,
        ngm:safety-plc ;
    vc:slug "ifac" ;
    vc:sourceDomain "robotics" ;
    vc:standardizedBy ngm:iec-61131-3 .

ngm:ifrs-s1 a owl:Class ;
    rdfs:label "IFRS S1"@en ;
    rdfs:comment "IFRS S1 is the inaugural sustainability-disclosure standard issued by the International Sustainability Standards Board, setting general requirements for disclosing sustainability-related financial information. It requires entities to report material risks and opportunities across governance, strategy, risk management, and metrics that could affect their prospects. IFRS S1 establishes the common baseline on which topic-specific standards such as IFRS S2 build."@en ;
    rdfs:subClassOf ngm:technical-standard ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:ifrs-s2 ;
    vc:slug "ifrs-s1" ;
    vc:sourceDomain "governance" ;
    vc:supports ngm:esg-reporting .

ngm:image-processing-software a owl:Class ;
    rdfs:label "Image Processing Software"@en ;
    rdfs:comment "Software systems that acquire, process, analyse, and visualise digital images for metaverse applications, employing computer vision algorithms for user tracking, environment creation, gesture recognition, 3D reconstruction, and real-time visual enhancement in virtual and augmented reality environ..."@en ;
    rdfs:subClassOf ngm:computer-vision-system,
        ngm:sc-display-and-rendering ;
    skos:broader ngm:sc-display-and-rendering ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:slug "image-processing-software" ;
    vc:sourceDomain "spatial-computing" .

ngm:imaging-parameters a owl:Class ;
    rdfs:label "Imaging Parameters"@en ;
    rdfs:comment "Imaging Parameters are the configurable settings—such as exposure time, aperture, ISO, focal length, white balance, and sensor gain—that govern how a camera or depth sensor captures light and produces a digital image. In spatial computing pipelines, correct imaging parameter calibration is essential for photogrammetric reconstruction, volumetric capture, and computer-vision model accuracy across varying lighting conditions."@en ;
    rdfs:subClassOf ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:enables ngm:image-classification,
        ngm:real-time-rendering ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:camera ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:relatedTo ngm:camera-parameters,
        ngm:photogrammetry ;
    vc:slug "imaging-parameters" ;
    vc:sourceDomain "spatial-computing" .

ngm:immutable-storage a owl:Class ;
    rdfs:label "Immutable Storage"@en ;
    rdfs:comment "Immutable storage is a data persistence model in which written records cannot be modified or deleted for a defined period, preserving their integrity against tampering and accidental loss. It is realised through write-once-read-many policies, append-only logs, content addressing, and cryptographic hashing, and underpins audit trails, regulatory retention, and ransomware resilience. Immutability provides verifiable evidence that data has not changed since it was committed."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptographic-hash ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:append-only-log ],
        ngm:data-storage ;
    vc:contrastsWith ngm:object-storage ;
    vc:enables ngm:audit-trail,
        ngm:compliance-audit-trail ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:append-only-log ;
    vc:isPartOf ngm:data-storage ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:blockchain,
        ngm:data-integrity,
        ngm:ipfs,
        ngm:object-storage ;
    vc:requires ngm:append-only-log,
        ngm:cryptographic-hash ;
    vc:slug "immutable-storage" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:backup-and-recovery,
        ngm:data-integrity,
        ngm:regulatory-compliance ;
    vc:uses ngm:cryptographic-hash,
        ngm:object-storage .

ngm:impact-metrics a owl:Class ;
    rdfs:label "Impact Metrics"@en ;
    rdfs:comment "Impact metrics are quantitative and qualitative indicators used to measure the social, environmental, or economic outcomes produced by an intervention, project, or organisation. They translate a theory of change into measurable outputs, outcomes, and longer-term impacts, enabling comparison, accountability, and decision-making. Standardised metric catalogues such as IRIS+ promote comparability across programmes."@en ;
    rdfs:subClassOf ngm:evaluation-metric ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:social-impact-assessment-sia ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:climate-action-dao ;
    vc:slug "impact-metrics" ;
    vc:sourceDomain "governance" .

ngm:inclusive-xr-experience a owl:Class ;
    rdfs:label "Inclusive Xr Experience"@en ;
    rdfs:comment "Extended reality applications and environments designed to provide equitable, accessible experiences for users of all abilities, incorporating assistive technologies, alternative interaction modalities, and adaptive features that ensure meaningful participation in VR, AR, and metaverse spaces."@en ;
    rdfs:subClassOf ngm:accessible-experience,
        ngm:sc-governance-and-safety ;
    skos:broader ngm:sc-governance-and-safety ;
    vc:enables ngm:equitable-access ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:slug "inclusive-xr-experience" ;
    vc:sourceDomain "spatial-computing" .

ngm:industrial-manipulation a owl:Class ;
    rdfs:label "Industrial Manipulation"@en ;
    rdfs:comment "Industrial Manipulation refers to the robotic discipline and practice of using articulated robot arms and end-effectors to physically interact with objects in manufacturing, assembly, logistics, and processing environments, performing tasks such as pick-and-place, assembly, welding, painting, and material handling at production scale with repeatability and precision exceeding human capability. It encompasses the full kinematic and dynamic modelling of robot mechanisms, trajectory planning, force and torque control, and the integration of sensing for adaptive behaviour in structured industrial settings. Industrial manipulation robots are among the most economically significant deployed robotics systems, forming the backbone of automotive, electronics, and consumer goods production worldwide."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:actuator ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:end-effector ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:kinematics ],
        ngm:manipulation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:actuator,
        ngm:end-effector,
        ngm:kinematics ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:industrial-robot,
        ngm:manufacturing-automation ;
    vc:slug "industrial-manipulation" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:force-control,
        ngm:inverse-kinematics,
        ngm:motion-planning .

ngm:industrial-metaverse a owl:Class ;
    rdfs:label "Industrial Metaverse"@en ;
    rdfs:comment "A virtual platform integrating digital twin technology, simulation environments, and collaborative workspaces for manufacturing operations, supply chain management, remote equipment control, and industrial training across geographically distributed facilities."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:predictive-analytics ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:digital-twin ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:io-t-sensor-network ],
