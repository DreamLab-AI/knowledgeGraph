        ngm:machine-learning-discipline-pipeline ;
    vc:contrastsWith ngm:file-system ;
    vc:enables ngm:access-control,
        ngm:data-analytics,
        ngm:data-persistence,
        ngm:query-processing,
        ngm:transaction-manager ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:query-engine,
        ngm:storage-engine,
        ngm:transaction-manager ;
    vc:implements ngm:acid-properties,
        ngm:cap-theorem ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:data-warehouse,
        ngm:distributed-databases ;
    vc:requires ngm:file-system,
        ngm:operating-system ;
    vc:slug "database-system" ;
    vc:sourceDomain "infrastructure" ;
    vc:standardizedBy ngm:iso-iec-9075 ;
    vc:supports ngm:data-replication,
        ngm:role-based-access-control ;
    vc:uses ngm:structured-query-language,
        ngm:write-ahead-logging .

ngm:decentralised-application a owl:Class ;
    rdfs:label "Decentralised Application"@en ;
    rdfs:comment "A decentralised application (dApp) is software whose backend logic runs on a decentralised peer-to-peer network, typically as smart contracts on a blockchain, rather than on centrally controlled servers. It combines on-chain contracts for trustless state and logic with off-chain front ends and storage. dApps are a defining component of Web3, enabling permissionless, censorship-resistant services such as exchanges, lending and marketplaces."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:wallet ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:blockchain ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptocurrency-wallet ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:smart-contract ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:consensus-mechanism ],
        ngm:distributed-system ;
    vc:bridgesTo ngm:digital-governance,
        ngm:distributed-systems ;
    vc:dependsOn ngm:decentralised-storage,
        ngm:peer-to-peer-network,
        ngm:token-standard ;
    vc:enables ngm:decentralised-autonomous-organisation,
        ngm:decentralised-finance,
        ngm:non-fungible-token ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:smart-contract,
        ngm:wallet ;
    vc:implements ngm:open-source-software,
        ngm:web3 ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:censorship-resistance,
        ngm:token-economy,
        ngm:web3 ;
    vc:requires ngm:blockchain,
        ngm:consensus-mechanism,
        ngm:cryptocurrency-wallet ;
    vc:slug "decentralised-application" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:ethereum,
        ngm:ipfs,
        ngm:oracle .

ngm:fiat-currency a owl:Class ;
    rdfs:label "Fiat Currency"@en ;
    rdfs:comment "Fiat currency is money issued and declared legal tender by a sovereign government or central bank, whose value derives from state authority, institutional trust, and collective public acceptance rather than from any intrinsic commodity backing. Unlike commodity money, fiat currency is not convertible into a fixed quantity of gold, silver, or other physical assets at a legally guaranteed rate. Its purchasing power is maintained through monetary policy instruments — interest rates, reserve requirements, open-market operations — and is subject to inflation, deflation, and exchange-rate dynamics driven by macroeconomic conditions. Fiat currency forms the foundational settlement layer for modern banking systems, international trade, and the reserve benchmarks against which digital assets are priced."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:central-bank ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:monetary-policy ],
        ngm:money ;
    vc:bridgesTo ngm:decentralised-finance,
        ngm:stablecoin,
        ngm:tokenization ;
    vc:contrastsWith ngm:commodity-money,
        ngm:cryptocurrency,
        ngm:gold-standard ;
    vc:dependsOn ngm:government-authority,
        ngm:institutional-trust ;
    vc:enables ngm:central-bank-digital-currency,
        ngm:fractional-reserve-banking,
        ngm:international-trade,
        ngm:stablecoin ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:banknote,
        ngm:reserve-currency ;
    vc:isPartOf ngm:monetary-system ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:exchange-rate,
        ngm:foreign-exchange-market,
        ngm:inflation,
        ngm:usd ;
    vc:requires ngm:central-bank,
        ngm:legal-tender,
        ngm:monetary-policy ;
    vc:slug "fiat-currency" ;
    vc:sourceDomain "finance" ;
    vc:uses ngm:real-time-gross-settlement,
        ngm:swift .

ngm:logic a owl:Class ;
    rdfs:label "Logic"@en ;
    rdfs:comment "Logic is the systematic study of valid inference, formal reasoning, and the structural principles that distinguish correct arguments from fallacious ones. It provides the mathematical and philosophical foundation for deduction, proof theory, and formal systems, encompassing propositional logic, first-order predicate logic, modal logic, and higher-order logics. In computational contexts, logic underpins programming language semantics, automated theorem proving, knowledge representation, and the design of intelligent reasoning systems. It forms a bedrock discipline across mathematics, philosophy, linguistics, and artificial intelligence."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:temporal-logic ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:description-logic ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:propositional-logic ],
        [ a owl:Restriction ;
