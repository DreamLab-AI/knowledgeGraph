    vcw:owlRole "Concept" .

# Portability
spatial-computing:Portability rdf:type owl:Class ;
    rdfs:label "Portability"@en ;
    rdfs:comment "The capability for seamless migration of digital assets, identities, and experiences across heterogeneous virtual platforms through standardised formats (glTF, USD), metadata schemas, and blockchain bridges—enabling users to transfer avatars, digital goods, and social connections without vendor lock-in, exemplified by Ready Player Me cross-platform avatars and Decentraland NFT portability."@en ;
    skos:prefLabel "Portability"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:spatial-computing:portability" ;
    owl:sameAs <urn:visionclaw:concept:spatial-computing:portability> ;
    vcw:contentHash "sha256-12-512956eb2c93" ;
    vcw:qualityScore "0.4"^^xsd:decimal ;
    vcw:legacyTermId "MV-3009" ;
    vcw:ontologyStatus "draft" ;
    vcw:maturityLevel "draft" ;
    vcw:authorityScore "0.0"^^xsd:decimal ;
    dcterms:identifier "MV-3009" ;
    dcterms:subject "spatial-computing" ;
    owl:versionInfo "2.0.0" ;
    dcterms:created "2026-04-26T00:00:00Z"^^xsd:dateTime ;
    dcterms:modified "2026-04-26T13:00:00Z"^^xsd:dateTime ;
    vcw:owlRole "Concept" .

# AISystem
artificial-intelligence:AISystem rdf:type owl:Class ;
    rdfs:label "AISystem"@en ;
    rdfs:comment "A comprehensive system architecture comprising machine learning models, data pipelines, inference engines, and deployment infrastructure that enables intelligent decision-making and automation. AI Systems integrate Neural Networks, training frameworks, and monitoring components to operate within Organisational Contexts."@en ;
    skos:prefLabel "AISystem"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:artificial-intelligence:aisystem" ;
    owl:sameAs <urn:visionclaw:concept:artificial-intelligence:aisystem> ;
    vcw:contentHash "sha256-12-6a3da7ec4db2" ;
    vcw:qualityScore "0.4"^^xsd:decimal ;
    vcw:legacyTermId "MV-3010" ;
