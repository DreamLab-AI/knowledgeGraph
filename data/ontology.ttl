ngm:tendermint a owl:Class ;
    rdfs:label "Tendermint"@en ;
    rdfs:comment "Tendermint is a Byzantine fault-tolerant (BFT) consensus engine that implements a partially synchronous, round-based, leader-elected protocol providing deterministic finality on each block. It separates the consensus layer from the application layer via the Application BlockChain Interface (ABCI), allowing any deterministic state machine to be driven by its consensus guarantees. Tendermint is the consensus core of the Cosmos SDK and underpins a large family of interoperable application-specific blockchains, offering safety guarantees so long as fewer than one-third of validator voting power is Byzantine. Its design derives from Practical Byzantine Fault Tolerance (PBFT) but introduces pragmatic modifications — rotating proposers, weighted voting, and a three-phase commit protocol — optimised for open, permissionless validator sets."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:partial-synchrony ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:digital-signature ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:validator-set ],
        ngm:bc-protocol-and-consensus ;
    skos:broader ngm:bc-protocol-and-consensus ;
    vc:bridgesTo ngm:decentralised-ai,
        ngm:federated-learning ;
    vc:contrastsWith ngm:hot-stuff,
        ngm:nakamoto-consensus,
        ngm:proof-of-work ;
    vc:dependsOn ngm:practical-byzantine-fault-tolerance ;
    vc:enables ngm:application-specific-blockchain,
        ngm:cosmos-ibc,
        ngm:cross-chain-communication ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:byzantine-fault-tolerance,
        ngm:deterministic-finality,
        ngm:proof-of-stake,
        ngm:state-machine-replication ;
    vc:isPartOf ngm:cosmos ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:cap-theorem,
        ngm:distributed-ledger-technology,
        ngm:smart-contract-platform ;
    vc:requires ngm:digital-signature,
        ngm:partial-synchrony,
        ngm:validator-set ;
    vc:slug "tendermint" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:abci,
        ngm:cosmos-sdk,
        ngm:gossip-protocol .

ngm:threshold-cryptography a owl:Class ;
    rdfs:label "Threshold Cryptography"@en ;
    rdfs:comment "Threshold cryptography is a branch of cryptography in which a secret — such as a private key, decryption key, or signing capability — is distributed among a set of n parties such that any qualifying subset of at least t parties can jointly perform the cryptographic operation, while no coalition of fewer than t parties can do so alone. The t-of-n structure provides both redundancy and distributed access control: no single party holds complete key material, eliminating single points of compromise from theft, coercion, or insider malfeasance. The three primary primitives are threshold signatures, threshold decryption, and distributed key generation (DKG), with applications spanning cryptocurrency custody, distributed certificate authorities, multi-party computation protocols, and confidential smart contract execution. Modern protocols such as CGGMP21, GG20, and FROST have brought threshold operations to practical round counts suitable for production deployment."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:secure-multi-party-computation ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:distributed-key-generation ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:secret-sharing ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:byzantine-fault-tolerance ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:threshold-signature-scheme ],
        ngm:cryptographic-primitive ;
    vc:bridgesTo ngm:differential-privacy,
