ngm:digital-constitution a owl:Class ;
    rdfs:label "Digital Constitution"@en ;
    rdfs:comment "Digital Constitution is a type of Virtual Society in the spatial computing domain."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:legal-framework ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:smart-contract ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:enforcement-mechanism ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:separation-of-powers ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:blockchain-infrastructure ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:identity-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:digital-citizenship ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:governance-structure ],
        ngm:sc-governance-and-safety,
        ngm:virtual-society ;
    skos:broader ngm:sc-governance-and-safety ;
    vc:enables ngm:democratic-governance,
        ngm:legitimate-authority,
        ngm:rights-protection,
        ngm:rule-of-law,
        ngm:social-contract ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:amendment-procedure,
        ngm:bill-of-rights,
        ngm:checks-and-balances,
        ngm:constitutional-rights,
        ngm:digital-citizenship,
        ngm:enforcement-mechanism,
        ngm:governance-structure,
        ngm:judicial-system,
        ngm:separation-of-powers ;
    vc:isPartOf ngm:decentralized-autonomous-organization,
        ngm:metaverse-platform,
        ngm:virtual-society ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:blockchain-infrastructure,
        ngm:identity-management,
        ngm:legal-framework,
        ngm:smart-contract ;
    vc:slug "digital-constitution" ;
    vc:sourceDomain "spatial-computing" .

ngm:digital-content-layer a owl:Class ;
    rdfs:label "Digital Content Layer"@en ;
    rdfs:comment "An architectural abstraction within metaverse and spatial computing systems that organizes and manages digital assets, 3D objects, interactive media, and user-generated content as discrete layers that can be rendered, composed, and manipulated independently within virtual environments."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:asset-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:rendering-engine ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:spatial-mapping ],
        ngm:metaverse-architecture,
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:enables ngm:content-composition,
        ngm:dynamic-rendering,
        ngm:layer-management ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires ngm:asset-management,
        ngm:rendering-engine,
        ngm:spatial-mapping ;
    vc:slug "digital-content-layer" ;
    vc:sourceDomain "spatial-computing" .

