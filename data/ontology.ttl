ngm:on-device-learning a owl:Class ;
    rdfs:label "On-Device Learning"@en ;
    rdfs:comment "Machine learning model training and adaptation occurring directly on end-user devices using only local data, without transmitting raw data to cloud servers. Enables personalised model adaptation, privacy preservation, and offline functionality while addressing challenges of limited compute, memory, and energy. Implemented through transfer learning, few-shot adaptation, and continual learning techniques on mobile and embedded platforms."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:model-compression-for-edge ],
        ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:enables ngm:ai-deployment,
        ngm:edge-ai-system ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:differential-privacy,
        ngm:edge-computing,
        ngm:internet-of-things,
        ngm:knowledge-distillation-for-edge,
        ngm:tiny-ml ;
    vc:requires ngm:model-compression-for-edge ;
    vc:slug "on-device-learning" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:federated-learning,
        ngm:machine-learning-discipline-framework,
        ngm:transfer-learning .

ngm:online-safety-act-2023 a owl:Class ;
    rdfs:label "Online Safety Act 2023"@en ;
    rdfs:comment "The Online Safety Act 2023 is a landmark piece of UK primary legislation that received Royal Assent on 26 October 2023, establishing a comprehensive duty-of-care framework for online platforms and search services operating in or targeting users in the United Kingdom. It imposes tiered obligations proportionate to service size and risk profile: all in-scope providers must conduct risk assessments and remove illegal content swiftly; larger or higher-risk services face additional requirements covering child safety, user empowerment tools, and transparency reporting. Ofcom is designated as the statutory regulator with powers to audit compliance, issue fines of up to 10% of global annual turnover, and ultimately block non-compliant services from reaching UK users. The Act also introduces personal criminal liability for senior managers of companies that wilfully fail to protect children from serious online harms."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:age-verification ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:transparency-reporting ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:age-verification ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:regulatory-compliance ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:content-moderation ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:risk-assessment ],
        ngm:digital-regulation ;
    vc:bridgesTo ngm:client-side-scanning,
        ngm:privacy-enhancing-technologies ;
    vc:contrastsWith ngm:digital-services-act ;
    vc:dependsOn ngm:codes-of-practice,
        ngm:ofcom ;
    vc:enables ngm:child-online-protection,
        ngm:platform-accountability,
        ngm:trust-and-safety ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:age-verification,
        ngm:duty-of-care,
        ngm:risk-assessment,
        ngm:transparency-reporting ;
    vc:implements ngm:platform-governance ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:csam-detection,
        ngm:digital-safety,
        ngm:end-to-end-encryption ;
    vc:requires ngm:age-verification,
        ngm:content-moderation,
        ngm:regulatory-compliance ;
    vc:slug "online-safety-act-2023" ;
    vc:sourceDomain "governance" ;
    vc:standardizedBy ngm:ofcom,
        ngm:regulatory-framework .

ngm:ontology-structure a owl:Class ;
    rdfs:label "Ontology Structure"@en ;
    rdfs:comment "The formal organisation of an ontology into classes, properties, axioms, and inter-concept relationships expressed in a logic-based language such as OWL or RDFS. Ontology Structure defines the hierarchy and constraint patterns that make machine-readable knowledge graphs queryable, inferable, and interoperable across domains."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
