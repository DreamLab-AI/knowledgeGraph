ngm:verifiable-inference a owl:Class ;
    rdfs:label "Verifiable Inference"@en ;
    rdfs:comment "Verifiable inference is the capability to cryptographically prove that a specific machine-learning model produced a given output for a given input without requiring trust in the compute provider. Techniques include zero-knowledge proofs of model execution (zkML), trusted execution environments and optimistic verification, which let third parties audit results. It is essential for decentralised and trust-minimised AI compute markets where inference is outsourced."@en ;
    rdfs:subClassOf ngm:ai-infrastructure ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:prime-intellect ;
    vc:slug "verifiable-inference" ;
    vc:sourceDomain "ai" .

ngm:verification-standard a owl:Class ;
