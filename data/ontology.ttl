        ngm:network-protocol,
        ngm:trust-model ;
    vc:slug "payment-network" ;
    vc:sourceDomain "finance" ;
    vc:standardizedBy ngm:iso-20022,
        ngm:payment-card-industry-standard ;
    vc:uses ngm:blockchain,
