# Virtual Securities Offering VSO
spatial-computing:VirtualSecuritiesOfferingVSO rdf:type owl:Class ;
    rdfs:subClassOf spatial-computing:SecurityTokenOffering ;
    rdfs:label "Virtual Securities Offering VSO"@en ;
    rdfs:comment "A type of security token offering that issues blockchain-based tokens representing ownership of virtual assets, metaverse properties, or digital rights within virtual environments, combining traditional securities regulation compliance with tokenization technology to enable fractional ownership and trading of virtual world assets."@en ;
    skos:prefLabel "Virtual Securities Offering VSO"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:spatial-computing:virtual-securities-offering-vso" ;
    owl:sameAs <urn:visionclaw:concept:spatial-computing:virtual-securities-offering-vso> ;
