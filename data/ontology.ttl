ngm:pseudonymisation a owl:Class ;
    rdfs:label "Pseudonymisation"@en ;
    rdfs:comment "Pseudonymisation is a data de-identification technique, defined in GDPR Article 4(5), that processes personal data such that it can no longer be attributed to a specific data subject without additional information held separately under technical and organisational safeguards. It replaces direct identifiers—names, national identification numbers, email addresses—with pseudonyms such as tokens, encrypted identifiers, or keyed hashes, preserving data utility for analytics and machine learning while reducing but not eliminating re-identification risk. Unlike full anonymisation, pseudonymisation is reversible by an authorised party holding the supplementary mapping or key material."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptographic-hash-function ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptographic-key-management ],
        ngm:ai-governance-and-ethics ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:enables ngm:data-minimisation,
        ngm:privacy-preserving-data-mining ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:data-protection,
        ngm:differential-privacy,
        ngm:gdpr-compliance,
        ngm:k-anonymity-in-datasets,
        ngm:privacy-by-design ;
    vc:requires ngm:cryptographic-hash-function,
        ngm:cryptographic-key-management ;
    vc:slug "pseudonymisation" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:ai-fairness,
        ngm:ai-governance-and-ethics .

ngm:pseudonymity a owl:Class ;
    rdfs:label "Pseudonymity"@en ;
    rdfs:comment "Pseudonymity is the property of operating under a persistent, stable identifier that is not directly linked to a participant's real-world legal identity, enabling consistent reputation and accountability without exposing personal information. Unlike full anonymity — where individual actions cannot be attributed to any consistent actor — pseudonymity preserves linkability across interactions under the chosen identifier while severing the mapping to biological or legal selfhood. The pseudonymous identifier may be a username, cryptographic public key, or blockchain address; its strength depends on the isolation of contextual signals that could enable de-anonymisation. Pseudonymity is foundational to privacy-preserving communication, decentralised identity systems, and selective-disclosure credential architectures."@en ;
    rdfs:subClassOf ngm:privacy ;
    vc:bridgesTo ngm:blockchain,
        ngm:self-sovereign-identity,
        ngm:tor-network ;
    vc:contrastsWith ngm:anonymity,
        ngm:identity-disclosure,
        ngm:real-name-policy ;
    vc:enables ngm:censorship-resistance,
        ngm:reputation-system,
        ngm:selective-disclosure,
        ngm:whistleblowing ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:decentralized-identifier,
        ngm:verifiable-credential ;
    vc:qualityScore "0.73"^^xsd:float ;
    vc:relatedTo ngm:contextual-integrity,
        ngm:data-minimisation,
        ngm:deanonymisation,
        ngm:identity-management,
        ngm:unlinkability ;
    vc:requires ngm:identifier,
        ngm:key-pair ;
    vc:slug "pseudonymity" ;
    vc:sourceDomain "security" ;
    vc:standardizedBy ngm:gdpr,
        ngm:w3c-did-core ;
    vc:uses ngm:hash-function,
        ngm:public-key-cryptography,
        ngm:ring-signature,
        ngm:zero-knowledge-proof .

ngm:qlo-ra a owl:Class ;
    rdfs:label "QLoRA"@en ;
    rdfs:comment "An extension of LoRA (Low-Rank Adaptation) that combines 4-bit NormalFloat quantisation of frozen base model weights with full-precision trainable low-rank adapter matrices. QLoRA additionally employs double quantisation and paged optimisers to achieve extreme memory efficiency, enabling fine-tuning of 65B-parameter models on a single 48GB GPU without significant performance degradation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:neural-network-quantisation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:quantisation ],
        ngm:ai-technique,
        ngm:parameter-efficient-fine-tuning ;
    skos:broader ngm:ai-technique ;
    vc:enables ngm:domain-adaptation,
        ngm:federated-learning ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:knowledge-distillation ;
    vc:requires ngm:neural-network-quantisation,
        ngm:quantisation ;
    vc:slug "qlo-ra" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:fine-tuning,
        ngm:large-language-models .

ngm:qr-code a skos:Concept ;
    rdfs:label "Qr Code"@en .

ngm:quic a owl:Class ;
    rdfs:label "QUIC"@en ;
    rdfs:comment "QUIC is a general-purpose transport layer protocol standardised as RFC 9000 by the IETF, running atop UDP rather than TCP in order to eliminate head-of-line blocking inherent in byte-stream semantics. It integrates TLS 1.3 cryptographic handshaking into the connection establishment phase, reducing round-trip latency to as little as zero additional RTT for resumed sessions, and multiplexes independent byte-streams so that packet loss on one stream does not stall others. Developed initially at Google and later standardised as the foundation for HTTP/3 (RFC 9114), QUIC also supports seamless connection migration across changing IP addresses, making it particularly suited to mobile and lossy network environments."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:tls ],
        ngm:communication-protocol ;
    vc:bridgesTo ngm:distributed-systems,
        ngm:real-time-communication ;
    vc:contrastsWith ngm:http2,
        ngm:sctp,
        ngm:tcp ;
    vc:dependsOn ngm:congestion-control,
        ngm:network-architecture ;
    vc:enables ngm:connection-migration,
        ngm:http3,
        ngm:low-latency-networking,
        ngm:scalability ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:connection-migration,
        ngm:flow-control,
        ngm:stream-multiplexing ;
    vc:implements ngm:encryption,
        ngm:transport-layer ;
    vc:isPartOf ngm:internet-protocol-suite ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:content-delivery-network,
        ngm:edge-computing,
        ngm:webrtc ;
    vc:requires ngm:tls,
        ngm:udp ;
    vc:slug "quic" ;
    vc:sourceDomain "distributed-systems" ;
    vc:standardizedBy ngm:ietf ;
    vc:supports ngm:mobile-networking,
        ngm:zero-rtt-resumption ;
    vc:uses ngm:packet-acknowledgement,
        ngm:tls,
        ngm:udp .

ngm:radiology-ai a owl:Class ;
    rdfs:label "Radiology AI"@en ;
    rdfs:comment "Radiology AI comprises artificial intelligence systems designed for automated interpretation and quantitative analysis of radiological imaging modalities — X-ray, CT, MRI, and ultrasound. These systems perform lesion detection, organ segmentation, and structured reporting at radiologist-level accuracy, integrating with PACS workflows and validated through prospective clinical trials."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
