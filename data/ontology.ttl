ngm:cryptographic-privacy-activist a owl:Class ;
    rdfs:label "Cryptographic Privacy Activist"@en ;
    rdfs:comment "A cypherpunk is an activist who advocates for the widespread use of strong cryptography and privacy-enhancing technologies as tools for social and political change. Emerging from mailing list culture in the early 1990s, cypherpunks believe that individual privacy can only be guaranteed through cryptographic means rather than through legal or institutional protections. Their ethos—'cypherpunks write code'—produced foundational technologies including public-key cryptography applications, anonymous remailers, digital cash, and the conceptual groundwork for Bitcoin and decentralised systems."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptography ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptographic-protocol ],
        ngm:bc-governance-and-regulation ;
    skos:broader ngm:bc-governance-and-regulation ;
    vc:contrastsWith ngm:digital-society-surveillance ;
    vc:enables ngm:decentralization,
        ngm:digital-signature,
        ngm:peer-to-peer-network ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:data-protection,
        ngm:digital-rights,
        ngm:open-source-software ;
    vc:requires ngm:cryptographic-protocol,
        ngm:cryptography ;
    vc:slug "cryptographic-privacy-activist" ;
    vc:sourceDomain "blockchain" .

