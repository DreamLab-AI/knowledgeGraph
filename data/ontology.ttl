        ngm:know-your-customer ;
    vc:requires ngm:aml-kyc-compliance,
        ngm:customer-due-diligence,
        ngm:financial-intelligence-unit,
        ngm:risk-assessment ;
    vc:slug "transaction-monitoring" ;
