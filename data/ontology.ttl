ngm:multi-viewpoint-immersive-research-platform a owl:Class ;
    rdfs:label "Multi-Viewpoint Immersive Research Platform"@en ;
    rdfs:comment "A proposed multi-viewpoint immersive AI research platform enabling multiple domain experts to collaborate simultaneously in a shared stereoscopic environment, each maintaining their own spatial perspective. Real-time AI observes all communication channels—verbal, gestural, spatial, and conceptual—building a living ontology from emergent expert consensus, with applications in high-stakes planning such as nuclear decommissioning."@en ;
    rdfs:subClassOf ngm:infra-software-engineering ;
    skos:broader ngm:infra-software-engineering ;
    vc:enables ngm:agentic-ai,
        ngm:ontology ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:digital-twin,
        ngm:extended-reality ;
    vc:slug "multi-viewpoint-immersive-research-platform" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:immersive-technology,
        ngm:knowledge-graph .

ngm:mycelium-driven-generative-choreography-system a owl:Class ;
    rdfs:label "Mycelium-Driven Generative Choreography System"@en ;
    rdfs:comment "An experimental creative AI project exploring the intersection of hip-hop dance, mycelium network datasets, and machine learning to generate emergent movement vocabularies. GOLM investigates whether biological network topologies—particularly fungal mycelium growth patterns—can be used to train generative models that produce novel choreographic sequences and spatial interaction grammars."@en ;
    rdfs:subClassOf ngm:infra-computing-and-cloud ;
    skos:broader ngm:infra-computing-and-cloud ;
    vc:enables ngm:immersive-experience ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:agentic-ai,
        ngm:digital-performance-capture ;
    vc:slug "mycelium-driven-generative-choreography-system" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:machine-learning-discipline,
        ngm:motion-capture .

