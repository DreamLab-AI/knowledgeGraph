ngm:concurrency a owl:Class ;
    rdfs:comment "Concurrency is the composition of independently executing computations that make progress within overlapping time periods, whether or not they run simultaneously on separate processors. It is a way of structuring a program so that multiple tasks can be in flight at once, coordinating access to shared state through synchronisation primitives. Concurrency is distinct from parallelism: it concerns the dealing with many things at once, while parallelism concerns the doing of many things at once."@en ;
    rdfs:label "Concurrency"@en ;
    rdfs:subClassOf ngm:infrastructure ;
    rdfs:subClassOf ngm:software-engineering ;
    rdfs:subClassOf _:r5276 ;
