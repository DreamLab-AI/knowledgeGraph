    vc:slug "compliance-dashboard" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:compound-governor-bravo a owl:Class ;
    rdfs:label "Compound Governor Bravo"@en ;
    rdfs:comment "Compound Governor Bravo is the second-generation on-chain governance smart contract deployed by the Compound protocol, superseding Governor Alpha with configurable parameters and a clean separation between governance voting logic and the Timelock executor contract. It enables COMP token holders to create, vote on, and enqueue governance proposals that modify protocol parameters — including interest rate models, collateral factors, reserve factors, and supported asset listings — without requiring contract redeployment to adjust governance thresholds. Governor Bravo introduced an abstraction layer allowing the proposal threshold, voting delay, voting period, and quorum to be updated through the same governance process they govern, substantially reducing upgrade friction. The contract has become a widely forked reference implementation across decentralised finance, with derivatives adopted by Uniswap, Indexed Finance, and many other protocols seeking battle-tested on-chain governance infrastructure."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:vote-delegation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:timelock ],
        ngm:on-chain-governance ;
    vc:bridgesTo ngm:decentralised-autonomous-organisation,
        ngm:smart-contract-security ;
    vc:contrastsWith ngm:compound-governor-alpha,
        ngm:openzeppelin-governor,
        ngm:snapshot-governance ;
    vc:dependsOn ngm:ethereum,
        ngm:governance-token ;
    vc:enables ngm:dao,
        ngm:decentralised-finance,
        ngm:protocol-parameter-management ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:proposal-lifecycle,
        ngm:quorum-mechanism,
        ngm:token-weighted-voting ;
    vc:isPartOf ngm:compound,
        ngm:defi-governance-framework ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:dao-analytics,
        ngm:defi-protocol,
        ngm:governance-attack ;
    vc:requires ngm:comp-token,
        ngm:ethereum-smart-contract,
        ngm:timelock,
        ngm:vote-delegation ;
    vc:slug "compound-governor-bravo" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:blockchain-governance,
        ngm:dao-governance ;
    vc:uses ngm:calldata-execution,
        ngm:proposal-system,
        ngm:voting-mechanism .

ngm:computational-infrastructure a owl:Class ;
    rdfs:label "Computational Infrastructure"@en ;
    rdfs:comment "Computational infrastructure refers to the ensemble of physical and virtualised hardware resources, networking fabric, storage systems, and supporting services that provide the computational substrate upon which software workloads execute. It encompasses data centres, server clusters, GPUs, networking interconnects, and the orchestration layers that manage resource allocation, scheduling, and fault tolerance. In the context of AI and large-scale distributed systems, computational infrastructure determines the ceiling on model scale, training throughput, and inference latency, making it a strategic bottleneck as much as a technical one."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:cloud-infrastructure ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:storage-infrastructure ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:gpu-computing ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:compute-resources ],
        ngm:digital-infrastructure ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:cloud-infrastructure,
        ngm:compute-resources,
        ngm:gpu-computing,
        ngm:storage-infrastructure ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:compute-layer,
        ngm:computing-infrastructure ;
    vc:slug "computational-infrastructure" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:ai-infrastructure,
        ngm:blockchain-infrastructure .

ngm:computer-hardware a owl:Class ;
    rdfs:label "Computer Hardware"@en ;
    rdfs:comment "Physical computing components optimised for artificial intelligence and spatial computing workloads, encompassing GPUs, TPUs, FPGAs, ASICs, and neuromorphic chips. Modern AI hardware emphasises parallel matrix processing, high-bandwidth memory, mixed-precision arithmetic, and energy-efficient inference at scale, enabling both large-model training and real-time rendering in immersive applications."@en ;
    rdfs:subClassOf ngm:ai-infrastructure ;
    vc:enables ngm:deep-learning,
        ngm:gpu-compute ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:distributed-computing,
        ngm:training ;
    vc:slug "computer-hardware" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:autonomous-robot,
        ngm:digital-twin ;
    vc:uses ngm:hardware-acceleration .

ngm:concentrated-liquidity a owl:Class ;
    rdfs:label "Concentrated Liquidity"@en ;
    rdfs:comment "Concentrated liquidity is a capital efficiency mechanism for automated market makers (AMMs) in which liquidity providers deposit assets within user-specified price ranges rather than uniformly across the full price curve from zero to infinity. Within an active price range, the capital deployed behaves equivalently to a much larger position in a constant-product AMM, dramatically increasing fee revenue per unit of capital while simultaneously reducing the price impact of trades of a given size. This design was pioneered by Uniswap v3 and has since been widely adopted across decentralised exchanges."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:price-oracle ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:fee-tier ],
        ngm:liquidity-provision ;
    vc:bridgesTo ngm:financial-derivatives,
        ngm:market-microstructure ;
    vc:contrastsWith ngm:constant-product-amm,
        ngm:order-book-exchange ;
    vc:dependsOn ngm:blockchain,
        ngm:impermanent-loss ;
    vc:enables ngm:active-liquidity-management,
        ngm:capital-efficiency,
        ngm:decentralized-exchange,
        ngm:token-economics,
        ngm:yield-farming ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:liquidity-position,
        ngm:tick-range ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:de-fi,
        ngm:perpetual-futures,
        ngm:protocol-owned-liquidity,
        ngm:uniswap ;
    vc:requires ngm:fee-tier,
        ngm:price-oracle ;
    vc:slug "concentrated-liquidity" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:automated-market-maker,
        ngm:liquidity-pool,
        ngm:non-fungible-token,
        ngm:price-tick,
        ngm:smart-contract .

ngm:content-authentication a owl:Class ;
    rdfs:label "Content Authentication"@en ;
    rdfs:comment "Content Authentication is the process of verifying the origin, integrity, and provenance of digital content through cryptographic techniques such as digital signatures, watermarking, and blockchain-anchored certificates. It enables consumers and platforms to distinguish authentic content from synthetically generated or tampered media, particularly critical as generative AI proliferates."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptographic-verification ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:digital-signature ],
        ngm:infra-security-and-identity ;
    skos:broader ngm:infra-security-and-identity ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:relatedTo ngm:cryptographic-hash-function,
        ngm:digital-rights-management ;
    vc:requires ngm:cryptographic-verification,
        ngm:digital-signature ;
    vc:slug "content-authentication" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:blockchain,
        ngm:digital-content-provenance-marking .

ngm:context-engineering a owl:Class ;
    rdfs:label "Context Engineering"@en ;
    rdfs:comment "Context Engineering is the systems-level discipline of designing, curating, compressing, and orchestrating the information delivered into a Large Language Model's context window across a multi-step agentic loop, popularised between mid-2024 and mid-2025 by Walden Yan (Cognition AI's \"Don't Build ..."@en ;
