ngm:user-agreement-compliance a owl:Class ;
    rdfs:label "User Agreement Compliance"@en ;
    rdfs:comment "Process ensuring user actions within a metaverse platform adhere to declared policies, terms of service, and acceptable use guidelines."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:policy-enforcement ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:monitoring-system ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:audit-trail ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:enforcement-mechanism ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:user-monitoring ],
        ngm:ai-governance-and-ethics ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:enables ngm:platform-safety,
        ngm:policy-adherence,
        ngm:risk-mitigation,
        ngm:user-accountability ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:policy-enforcement,
        ngm:remediation-process,
        ngm:user-monitoring,
        ngm:violation-detection ;
    vc:isPartOf ngm:governance-framework,
        ngm:platform-management ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:audit-trail,
        ngm:enforcement-mechanism,
        ngm:monitoring-system,
        ngm:user-agreement ;
    vc:slug "user-agreement-compliance" ;
    vc:sourceDomain "artificial-intelligence" .

