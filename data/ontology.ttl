    vc:slug "computing-platform" ;
    vc:sourceDomain "infrastructure" .

ngm:configuration a owl:Class ;
    rdfs:label "Configuration"@en ;
    rdfs:comment "Configuration is the set of parameters, settings, and environment variables that determine the runtime behaviour of a spatial computing platform, application, or pipeline component. Proper configuration governs interoperability between subsystems, controls feature flags, and defines integration points between platform services, hardware abstraction layers, and content pipelines."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:hardware-abstraction ],
        ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:bridgesTo ngm:computer-vision ;
    vc:enables ngm:platform-service ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:relatedTo ngm:configuration-setting,
        ngm:platform-engineering ;
    vc:requires ngm:hardware-abstraction ;
    vc:slug "configuration" ;
    vc:sourceDomain "spatial-computing" .

ngm:confusion-matrix a owl:Class ;
    rdfs:label "Confusion Matrix"@en ;
    rdfs:comment "A tabular visualisation and analytical tool summarising the performance of a classification model by displaying the counts or proportions of predictions cross-tabulated against actual class labels, typically organised with predicted classes as columns and actual classes as rows (or vice versa), e..."@en ;
    rdfs:subClassOf ngm:evaluation-metric,
        ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
