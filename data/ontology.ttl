ngm:costmap a owl:Class ;
    rdfs:label "Costmap"@en ;
    rdfs:comment "A costmap is a grid-based spatial data structure used in robot navigation that assigns a traversal cost to each cell of the environment, encoding obstacles, inflation zones, and free space. Local and global costmaps fuse sensor data and static maps so that planners can compute collision-free, low-cost paths. It is a core component of navigation stacks such as Nav2, where it underpins both global path planning and local trajectory control."@en ;
    rdfs:subClassOf ngm:robo-navigation-and-planning ;
    skos:broader ngm:robo-navigation-and-planning ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:nav2,
        ngm:navigation ;
    vc:slug "costmap" ;
    vc:sourceDomain "robotics" .

ngm:cradle-to-cradle-design a owl:Class ;
    rdfs:label "Cradle-to-Cradle Design"@en ;
    rdfs:comment "Cradle-to-Cradle design is a sustainability framework in which products are conceived so that all materials become safe nutrients for biological or technical cycles, eliminating the concept of waste. It emphasises material health, reuse, renewable energy, and closed-loop recovery rather than the linear take-make-dispose model. It is a foundational design philosophy within the circular economy."@en ;
    rdfs:subClassOf ngm:sustainability ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:circular-economy ;
    vc:slug "cradle-to-cradle-design" ;
    vc:sourceDomain "supply-chain" .

ngm:creative-software a owl:Class ;
    rdfs:label "Creative Software"@en ;
    rdfs:comment "Application software designed to support artistic, design, and content production workflows, including 3D modelling, animation, compositing, generative art, and interactive experience authoring. In spatial computing contexts, creative software bridges concept and deployment by enabling artists to produce assets compatible with real-time rendering engines and metaverse platforms."@en ;
