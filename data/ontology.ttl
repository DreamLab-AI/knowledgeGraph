ngm:graphics-pipeline a owl:Class ;
    rdfs:label "Graphics Pipeline"@en ;
    rdfs:comment "The graphics pipeline is the ordered sequence of stages that transforms a 3D scene description into a 2D raster image, encompassing vertex processing, primitive assembly, rasterisation, fragment shading, and output merging, executed on programmable GPU hardware and exposed through graphics APIs."@en ;
