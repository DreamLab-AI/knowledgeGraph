ngm:ownership-and-freedom-distributed a owl:Class ;
    rdfs:label "Ownership and Freedom Distributed"@en ;
    rdfs:comment "The principle of distributing control and governance of digital assets or data across multiple participants rather than concentrating authority in a single entity. This encompasses decentralised identity, cryptographic ownership proofs, peer-to-peer governance mechanisms, and user-controlled data portability as foundational guarantees for sovereignty in metaverse and Web3 ecosystems."@en ;
