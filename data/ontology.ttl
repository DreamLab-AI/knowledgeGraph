ngm:anonymisation a owl:Class ;
    rdfs:label "Anonymisation"@en ;
    rdfs:comment "Anonymisation is the process of transforming data so that individuals can no longer be identified, directly or by inference, while preserving enough utility for analysis. Techniques include suppression, generalization, pseudonymisation, k-anonymity, differential privacy, and the blurring or synthetic replacement of faces and identifiers in media. Effective anonymisation must resist re-identification through linkage with auxiliary data."@en ;
    rdfs:subClassOf ngm:infra-security-and-identity ;
    skos:broader ngm:infra-security-and-identity ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
