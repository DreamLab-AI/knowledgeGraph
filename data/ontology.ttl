ngm:data-serialization a owl:Class ;
    rdfs:label "Data Serialization"@en ;
    rdfs:comment "Data Serialization is the process of converting structured in-memory data objects — including primitive types, collections, and complex graphs — into a byte-sequence or character-stream representation that can be stored persistently, transmitted across a network boundary, or reconstructed (deserialised) into an equivalent in-memory representation on a different machine or at a different time, potentially running different software. Serialization formats vary along axes of human readability (JSON, YAML, XML versus binary), schema enforcement (Protocol Buffers, Apache Avro with mandatory schemas versus schemaless JSON), compactness, and cross-language support, making format selection a critical engineering decision that affects system interoperability, performance, and evolvability."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:backward-compatibility ],
        ngm:data-format ;
    vc:bridgesTo ngm:distributed-systems,
        ngm:machine-learning ;
    vc:enables ngm:data-pipeline,
        ngm:interoperability-protocol,
        ngm:message-passing,
        ngm:remote-procedure-call ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:apache-avro,
        ngm:binary-encoding,
        ngm:data-format-standard,
        ngm:json-data-interchange-format,
        ngm:messagepack,
        ngm:protocol-buffer,
        ngm:schema-registry,
        ngm:xml,
        ngm:yaml ;
    vc:requires ngm:backward-compatibility,
        ngm:schema-evolution ;
    vc:slug "data-serialization" ;
    vc:sourceDomain "infrastructure" ;
    vc:standardizedBy ngm:internet-engineering-task-force,
        ngm:w3-c ;
    vc:supports ngm:data-storage,
        ngm:event-streaming,
        ngm:network-communication ;
    vc:uses ngm:data-schema,
        ngm:type-system .

ngm:decentralized-identifier a owl:Class ;
    rdfs:label "Decentralized Identifier"@en ;
    rdfs:comment "A Decentralised Identifier (DID) is a globally unique, persistent, cryptographically verifiable identifier that a subject creates and controls without reliance on any centralised registry, authority, or intermediary. Defined by the W3C DID Core specification, a DID is a URI of the form did:method:identifier that resolves to a DID Document containing public keys, authentication mechanisms, and service endpoints. DIDs enable self-sovereign identity by decoupling identifier ownership from third-party identity providers, allowing verifiable credential exchange and privacy-preserving authentication across heterogeneous systems."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:did-resolution ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:public-key-cryptography ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:did-document ],
        ngm:digital-identity ;
    vc:bridgesTo ngm:blockchain,
        ngm:distributed-ledger-technology,
        ngm:smart-contract ;
    vc:contrastsWith ngm:centralized-identity-provider,
        ngm:oauth ;
    vc:enables ngm:decentralized-authentication,
        ngm:identity-management,
        ngm:self-sovereign-identity,
        ngm:verifiable-credential-vc ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:uri,
        ngm:w3-c-did-core ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:access-control,
        ngm:public-key-infrastructure,
        ngm:verifiable-data-registry ;
    vc:requires ngm:did-document,
        ngm:did-resolution,
        ngm:public-key-cryptography ;
    vc:slug "decentralized-identifier" ;
    vc:sourceDomain "security" ;
    vc:standardizedBy ngm:w3-c ;
    vc:supports ngm:privacy-preserving-authentication,
        ngm:zero-knowledge-proof ;
    vc:uses ngm:cryptographic-key-pair,
        ngm:did-method,
        ngm:digital-signature .

ngm:eventual-consistency a owl:Class ;
    rdfs:label "Eventual Consistency"@en ;
    rdfs:comment "Eventual consistency is a consistency model for distributed data stores that guarantees that, in the absence of new updates, all replicas of a given data item will eventually converge to the same value. The model deliberately relaxes the requirement for immediate, global agreement in favour of higher availability and tolerance of network partitions, as described by the CAP theorem. Reads may transiently return stale data, and divergent replicas are reconciled through background propagation, gossip protocols, or explicit conflict resolution strategies such as last-write-wins or multi-version concurrency control. It is foundational to the design of large-scale internet-facing systems including DNS, distributed caches, and wide-area NoSQL databases."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:distributed-computing ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-replication ],
        ngm:infra-computing-and-cloud ;
    skos:broader ngm:infra-computing-and-cloud ;
    vc:bridgesTo ngm:blockchain-consensus,
        ngm:federated-learning ;
    vc:contrastsWith ngm:acid-properties,
        ngm:linearizability,
        ngm:strong-consistency ;
    vc:enables ngm:distributed-storage,
        ngm:high-availability,
        ngm:horizontal-scalability ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:isPartOf ngm:base-properties,
        ngm:cap-theorem ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:consistency-model,
        ngm:crdt,
        ngm:nosql-database,
        ngm:partition-tolerance,
        ngm:quorum-consensus ;
    vc:requires ngm:data-replication,
        ngm:distributed-computing ;
    vc:slug "eventual-consistency" ;
    vc:sourceDomain "distributed-systems" ;
    vc:uses ngm:conflict-resolution,
        ngm:gossip-protocol,
        ngm:merkle-tree,
        ngm:vector-clocks,
        ngm:version-control .

ngm:image-processing a owl:Class ;
    rdfs:label "Image Processing"@en ;
    rdfs:comment "Image Processing is the computational manipulation of digital images using mathematical operations—including spatial filtering, morphological transforms, frequency-domain analysis, and learned convolutional operations—to enhance visual quality, extract structured information, or transform image representations for downstream tasks. It encompasses both classical signal processing techniques (Fourier and wavelet transforms, histogram equalisation, edge detection via Sobel or Canny operators, morphological erosion and dilation) and modern deep-learning approaches implemented through convolutional neural networks, vision transformers, and diffusion models. Image processing forms the foundational preprocessing and analysis layer for computer vision pipelines, medical imaging workflows, remote sensing, autonomous navigation, and industrial quality inspection, operating on discrete pixel grids to produce processed images or structured semantic outputs. The field bridges raw sensor data acquisition and higher-level scene understanding, with applications spanning from embedded real-time systems to large-scale cloud inference infrastructure."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:linear-algebra ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:fourier-transform ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:feature-extraction ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:digital-signal-processing ],
        ngm:signal-processing ;
    vc:bridgesTo ngm:robotics,
        ngm:spatial-computing ;
    vc:contrastsWith ngm:point-cloud-processing,
        ngm:video-processing ;
    vc:enables ngm:image-classification,
        ngm:medical-imaging,
        ngm:object-detection,
        ngm:remote-sensing ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:feature-extraction,
        ngm:morphological-operations ;
    vc:isPartOf ngm:computer-vision,
        ngm:machine-learning-discipline-pipeline ;
    vc:qualityScore "0.78"^^xsd:float ;
    vc:relatedTo ngm:colour-science,
        ngm:image-compression,
        ngm:open-cv ;
    vc:requires ngm:digital-signal-processing,
        ngm:fourier-transform,
        ngm:linear-algebra ;
    vc:slug "image-processing" ;
    vc:sourceDomain "ai" ;
    vc:standardizedBy ngm:ieee-signal-processing-society,
        ngm:iso-iec-jtc1-sc29 ;
    vc:uses ngm:convolutional-neural-network,
        ngm:deep-learning,
        ngm:diffusion-model,
        ngm:vision-transformer .

ngm:multi-factor-authentication a owl:Class ;
    rdfs:label "Multi-Factor Authentication"@en ;
    rdfs:comment "Multi-Factor Authentication (MFA) is a security mechanism that requires a claimant to present two or more independent verification factors drawn from distinct categories — something known (a password or PIN), something possessed (a hardware token or mobile device), and something inherent (a biometric characteristic) — before access is granted to a system or resource. By requiring multiple independent proofs, MFA ensures that compromise of a single credential is insufficient for an attacker to gain access, substantially raising the cost and complexity of successful attacks. It is widely mandated by regulatory frameworks, cybersecurity standards, and national policy as a baseline control for protecting sensitive systems, privileged accounts, and personal data. Modern deployments increasingly employ adaptive or risk-based MFA, invoking stronger authentication only when contextual risk signals exceed a configurable threshold."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:identity-verification ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:hardware-security-key ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:one-time-password ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:biometric-authentication ],
        ngm:authentication-mechanism ;
    vc:bridgesTo ngm:decentralised-identity,
        ngm:self-sovereign-identity ;
    vc:contrastsWith ngm:password-authentication ;
    vc:dependsOn ngm:cryptographic-keys,
        ngm:public-key-infrastructure,
        ngm:secure-channel ;
    vc:enables ngm:access-control,
        ngm:digital-identity-management,
        ngm:privileged-access-management,
        ngm:zero-trust-architecture ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:biometric-authentication,
        ngm:hardware-security-key,
        ngm:one-time-password ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:adaptive-authentication,
        ngm:authentication,
        ngm:cybersecurity-standard,
        ngm:identity-and-access-management,
        ngm:phishing-resistance ;
    vc:requires ngm:identity-verification ;
    vc:slug "multi-factor-authentication" ;
    vc:sourceDomain "security" ;
    vc:standardizedBy ngm:authentication-standards,
        ngm:fido-alliance,
        ngm:nist-sp-800-63 ;
    vc:supports ngm:data-security,
        ngm:regulatory-compliance,
        ngm:risk-management ;
    vc:uses ngm:biometric-binding-mechanism,
        ngm:fido2 .

ngm:open-id-connect a owl:Class ;
    rdfs:label "OpenID Connect"@en ;
    rdfs:comment "OpenID Connect (OIDC) is a federated identity and authentication protocol standardised by the OpenID Foundation that adds an authentication layer on top of the OAuth 2.0 authorisation framework. Upon successful authentication, an OIDC-compliant identity provider issues a signed JSON Web Token (ID Token) containing identity claims — such as subject identifier, email, and session expiry — which the relying party verifies cryptographically using the provider's published JSON Web Key Set without querying the provider again. OIDC defines standard flows (authorisation code, implicit, hybrid, and device code), a discovery endpoint, and a UserInfo endpoint, enabling single sign-on across web and mobile applications and serving as the identity spine for enterprise federation, consumer social logins, open banking APIs, and decentralised identity wallets."@en ;
    rdfs:subClassOf ngm:identity-federation ;
    vc:bridgesTo ngm:digital-identity-wallet,
        ngm:self-sovereign-identity,
        ngm:verifiable-credentials ;
    vc:contrastsWith ngm:kerberos,
        ngm:ldap,
        ngm:saml ;
    vc:dependsOn ngm:json-data-interchange-format-web-token,
        ngm:json-web-key-set,
        ngm:oauth-2-0,
        ngm:transport-layer-security ;
    vc:enables ngm:api-security,
        ngm:decentralised-identity,
        ngm:zero-trust-architecture ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:identity-provider,
        ngm:relying-party ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:access-control,
        ngm:digital-identity,
        ngm:financial-grade-api,
        ngm:public-key-infrastructure ;
    vc:slug "open-id-connect" ;
    vc:sourceDomain "infrastructure" ;
    vc:standardizedBy ngm:internet-engineering-task-force,
        ngm:open-id-foundation ;
    vc:supports ngm:authentication,
        ngm:federated-identity,
        ngm:multi-factor-authentication,
        ngm:single-sign-on .

