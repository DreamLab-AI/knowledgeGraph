ngm:ai-risk-register a owl:Class ;
    rdfs:label "AI Risk Register"@en ;
    rdfs:comment "An AI Risk Register is a structured artefact that systematically documents, tracks, and manages identified risks associated with AI systems throughout their lifecycle. Each entry records a risk identifier, description, affected systems and stakeholders, likelihood and consequence ratings, overall risk level, assigned owner, current mitigation controls, residual risk, and review history. The register supports risk-based governance by enabling prioritisation of mitigation efforts, regulatory compliance demonstration, and continuous monitoring across technical, ethical, legal, operational, security, and societal risk categories."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:audit-trail ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-governance ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:impact-assessment ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:threat-modelling ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ai-governance ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:accountability ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:compliance-framework ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:risk-assessment ],
        ngm:ai-governance-and-ethics,
        ngm:ai-risk-management ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:enables ngm:ai-safety,
        ngm:compliance-monitoring,
        ngm:responsible-ai,
        ngm:transparency,
        ngm:trustworthy-ai ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:audit-trail,
        ngm:impact-assessment,
        ngm:risk-appetite,
        ngm:risk-assessment ;
    vc:implements ngm:iso-31000,
        ngm:iso-iec-23894,
        ngm:nist-ai-risk-management-framework ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:bias,
        ngm:enterprise-risk-management,
        ngm:eu-ai-act,
        ngm:explainability,
        ngm:fairness,
        ngm:model-drift,
        ngm:risk-management ;
    vc:requires ngm:accountability,
        ngm:ai-governance,
        ngm:compliance-framework,
        ngm:data-governance,
        ngm:threat-modelling ;
    vc:slug "ai-risk-register" ;
    vc:sourceDomain "artificial-intelligence" ;
