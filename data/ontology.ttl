ngm:metaverse-as-markets a owl:Class ;
    rdfs:label "Metaverse as Markets"@en ;
    rdfs:comment "A conceptual framing of metaverse platforms as economic ecosystems in which virtual goods, services, experiences, and digital assets are produced, traded, and consumed. This view foregrounds creator economies, digital ownership, interoperable asset standards, and market dynamics including adoption curves, pricing models, and regulatory challenges specific to virtual worlds."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:digital-identity ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:creator-economy ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:interoperability ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:digital-goods ],
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:dependsOn ngm:metaverse-platform ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:creator-economy,
        ngm:digital-goods ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:blockchain,
        ngm:digital-economy ;
    vc:requires ngm:digital-identity,
        ngm:interoperability ;
    vc:slug "metaverse-as-markets" ;
    vc:sourceDomain "spatial-computing" .

ngm:metaverse-commerce a skos:Concept ;
    rdfs:label "Metaverse Commerce"@en .

ngm:metaverse-core-concepts a owl:Class ;
    rdfs:label "metaverse core concepts"@en ;
    rdfs:comment "Metaverse core concepts is an index class grouping the foundational building blocks of persistent shared virtual spaces: immersive rendering technologies (Augmented Reality, Spatial Computing, Haptic Feedback), virtual environments (Virtual World, Social VR, Digital Twin), digital identity and economic primitives (Digital Avatar, Virtual Asset, Virtual Economy), and cross-platform integration enablers (Interoperability). Together these concepts define the design space for metaverse platforms and standards such as those developed by the Metaverse Standards Forum."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:spatial-computing ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:digital-avatar ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:interoperability ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:digital-twin ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:virtual-economy ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:virtual-world ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:haptic-feedback ],
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:digital-avatar,
        ngm:digital-twin,
        ngm:haptic-feedback,
        ngm:virtual-economy,
        ngm:virtual-world ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:extended-reality,
        ngm:social-vr,
        ngm:virtual-asset ;
    vc:requires ngm:interoperability,
        ngm:spatial-computing ;
    vc:slug "metaverse-core-concepts" ;
    vc:sourceDomain "spatial-computing" .

