ngm:enterprise-workflow a owl:Class ;
    rdfs:label "Enterprise Workflow"@en ;
    rdfs:comment "An enterprise workflow is a defined sequence of tasks and approvals that an organisation uses to carry out a business process. Software systems coordinate and automate these workflows."@en ;
