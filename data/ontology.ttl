ngm:torque-control a owl:Class ;
    rdfs:comment "A low-level actuation strategy that directly commands the output torque of joints or motors rather than position or velocity, enabling compliant, force-sensitive interaction between a robot and its environment. Torque control is essential for safe human-robot collaboration and dexterous manipulation tasks."@en ;
    rdfs:label "Torque Control"@en ;
