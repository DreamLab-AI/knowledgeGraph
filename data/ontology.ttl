ngm:training a owl:Class ;
    rdfs:label "Training"@en ;
    rdfs:comment "Training is the supervised or self-supervised process of iteratively adjusting the parameters of a machine learning model to minimise a loss function over a labelled or unlabelled dataset. It encompasses forward passes, backpropagation, gradient descent optimisation, and regularisation techniques such as dropout and weight decay. The output of training is a fitted model whose learned weights encode patterns from the training data, ready for inference on unseen inputs."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:hyperparameter-tuning ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:training-data ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:loss-function ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gradient-descent ],
        ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:bridgesTo ngm:federated-learning,
        ngm:reinforcement-learning ;
    vc:contrastsWith ngm:inference,
        ngm:overfitting ;
    vc:dependsOn ngm:neural-network-architecture,
        ngm:optimiser ;
    vc:enables ngm:fine-tuning,
        ngm:inference,
        ngm:machine-learning-model,
        ngm:transfer-learning ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:backward-pass,
        ngm:forward-pass,
        ngm:hyperparameter-tuning,
        ngm:validation ;
    vc:qualityScore "0.68"^^xsd:float ;
    vc:requires ngm:compute-resource,
        ngm:gradient-descent,
        ngm:labelled-dataset,
        ngm:loss-function,
        ngm:training-data ;
    vc:slug "training" ;
    vc:sourceDomain "machine-learning" ;
    vc:standardizedBy ngm:iso-iec-22989,
        ngm:nist-ai-rmf ;
    vc:uses ngm:backpropagation,
        ngm:batch-normalisation,
        ngm:dropout,
        ngm:regularisation,
        ngm:stochastic-gradient-descent .

ngm:training-dataset a owl:Class ;
    rdfs:label "Training Dataset"@en ;
    rdfs:comment "A Training Dataset is a curated collection of labelled or unlabelled data used to fit the parameters of a machine learning model, establishing the empirical foundation from which the model generalises to unseen inputs. Its composition—size, diversity, label quality, representational balance, and provenance—fundamentally determines the capabilities and failure modes of the resulting model. Training datasets range from manually annotated corpora (ImageNet, SQuAD) to web-scraped large-scale collections (Common Crawl, LAION-5B) and synthetically generated data. Questions of copyright, consent, bias, and traceability in training datasets have become central to AI governance and legal disputes."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-governance ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:training-dataset-metadata ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-preprocessing ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:data-annotation ],
        ngm:training-data ;
    vc:bridgesTo ngm:algorithmic-bias,
        ngm:data-privacy,
        ngm:intellectual-property ;
    vc:contrastsWith ngm:test-dataset,
        ngm:validation-dataset ;
    vc:dependsOn ngm:data-collection,
        ngm:training-data-repository ;
    vc:enables ngm:evaluation-benchmarks-and-leaderboards,
        ngm:foundation-model,
        ngm:machine-learning-discipline-model,
        ngm:model-training,
        ngm:transfer-learning ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:data-annotation,
