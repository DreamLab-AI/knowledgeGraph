    skos:broader ngm:sc-content-and-assets ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires ngm:monitoring,
        ngm:testing,
        ngm:validation-ai-0095 ;
    vc:slug "reliability" ;
    vc:sourceDomain "spatial-computing" .

ngm:resource-management a owl:Class ;
    rdfs:label "Resource Management"@en ;
    rdfs:comment "Resource Management is the systematic discipline of allocating, scheduling, monitoring, and optimising computational and physical resources — including CPU, GPU, memory, storage, and network bandwidth — across applications, services, and infrastructure to ensure efficient utilisation, quality-of-service guarantees, and graceful degradation under load. It encompasses the full asset lifecycle from provisioning and pooling through dynamic scaling to decommissioning, balancing competing workload demands against capacity constraints. In distributed and cloud-native environments, resource management extends to orchestration of containerised workloads, quota enforcement, cost attribution, and autoscaling policies that respond to real-time demand signals. Effective resource management is a foundational prerequisite for reliable, cost-efficient, and performant infrastructure at scale."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:monitoring ],
        ngm:computing-infrastructure ;
    vc:bridgesTo ngm:federated-learning,
        ngm:mlops ;
    vc:contrastsWith ngm:over-provisioning ;
    vc:dependsOn ngm:containerisation,
        ngm:virtualisation ;
    vc:enables ngm:fault-tolerance,
        ngm:high-availability,
        ngm:metaverse-infrastructure ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:autoscaling,
        ngm:quota-management,
        ngm:resource-pool,
        ngm:scheduler ;
    vc:implements ngm:quality-of-service,
        ngm:service-level-agreement ;
    vc:isPartOf ngm:cloud-computing,
        ngm:computing-infrastructure ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:content-delivery-network,
        ngm:cost-optimisation,
        ngm:devops ;
    vc:requires ngm:monitoring,
        ngm:telemetry ;
    vc:slug "resource-management" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:distributed-system,
        ngm:microservices ;
    vc:uses ngm:edge-computing,
        ngm:kubernetes,
        ngm:load-balancing .

ngm:reward-modelling a owl:Class ;
    rdfs:label "Reward Modelling"@en ;
    rdfs:comment "Reward modelling is a machine-learning technique that trains a separate model to predict human preferences and use its scores as a reward signal for optimising another agent. It underpins reinforcement learning from human feedback, where the reward model ranks candidate outputs so a policy can be tuned toward preferred behaviour. It is central to aligning large language models with human values and intent."@en ;
    rdfs:subClassOf ngm:machine-learning-discipline-technique ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:ai-safety,
        ngm:safety-and-alignment ;
    vc:slug "reward-modelling" ;
    vc:sourceDomain "ai" .

ngm:risk-mitigation a owl:Class ;
    rdfs:label "Risk Mitigation"@en ;
    rdfs:comment "Actions taken to reduce the likelihood or impact of identified AI risks through technical, organizational, or procedural controls, implemented throughout the AI lifecycle to achieve acceptable risk levels."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
