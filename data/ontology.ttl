    vc:slug "privacy-impact-assessment" ;
    vc:sourceDomain "governance" ;
    vc:standardizedBy ngm:nist-privacy-framework .

ngm:representation-learning a owl:Class ;
    rdfs:label "Representation Learning"@en ;
    rdfs:comment "Representation learning is a subfield of machine learning concerned with automatically discovering the data transformations and feature spaces — representations — that make subsequent learning tasks easier, more accurate, or more data-efficient. Rather than relying on hand-crafted features, representation learning systems learn to encode raw inputs such as images, text, or sensor readings into dense, structured latent vectors that capture semantically meaningful variation. Deep neural networks, particularly transformers and convolutional architectures, have made learned representations ubiquitous across computer vision, natural language processing, and multi-modal AI. The quality of learned representations directly determines the performance ceiling of downstream models trained on top of them."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:training-data ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:neural-network ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:embedding-model ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:encoder ],
        ngm:machine-learning-discipline-technique ;
    vc:bridgesTo ngm:knowledge-graph,
        ngm:semantic-search ;
    vc:contrastsWith ngm:feature-engineering,
        ngm:symbolic-ai ;
    vc:enables ngm:contrastive-learning,
        ngm:few-shot-learning,
        ngm:foundation-model,
        ngm:self-supervised-learning,
        ngm:transfer-learning,
        ngm:zero-shot-learning ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:embedding-model,
        ngm:encoder ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:dimensionality-reduction,
        ngm:feature-extraction,
        ngm:multimodal-learning,
        ngm:word-embedding ;
    vc:requires ngm:neural-network,
        ngm:training-data ;
    vc:slug "representation-learning" ;
    vc:sourceDomain "machine-learning" ;
    vc:uses ngm:autoencoder,
        ngm:convolutional-neural-network,
        ngm:deep-learning,
        ngm:embeddings,
        ngm:neural-network-latent-space,
        ngm:transformer-architecture .

ngm:reputation-system a owl:Class ;
