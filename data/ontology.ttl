ngm:sustainability-reporting a owl:Class ;
    rdfs:label "SustainabilityReporting"@en ;
    rdfs:comment "Sustainability reporting is the structured, standardised practice through which organisations disclose their environmental, social, and governance (ESG) performance to investors, regulators, and other stakeholders. It encompasses the measurement, aggregation, and public presentation of data covering greenhouse gas emissions (Scope 1, 2, and 3), resource use, labour practices, board diversity, and supply chain impacts in conformance with frameworks such as GRI, ISSB IFRS S1/S2, TCFD, and the EU Corporate Sustainability Reporting Directive (CSRD). The discipline bridges quantitative carbon accounting, qualitative narrative disclosure, and third-party assurance to enable comparable, decision-useful ESG information. Emerging technologies including AI-assisted data collection, blockchain-based provenance, and real-time sensor integration are reshaping how organisations assemble and verify material sustainability data."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:carbon-accounting ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-governance ],
        ngm:corporate-governance ;
    vc:bridgesTo ngm:ai-for-sustainability,
        ngm:blockchain-sustainability,
        ngm:digital-twin ;
    vc:contrastsWith ngm:greenwashing,
        ngm:voluntary-disclosure ;
    vc:dependsOn ngm:emission-factor-databases,
        ngm:scope-3-emissions ;
    vc:enables ngm:esg-investment,
        ngm:regulatory-compliance,
        ngm:stakeholder-engagement,
        ngm:transparency ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:csrd,
        ngm:esg-framework,
        ngm:global-reporting-initiative,
        ngm:tcfd ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:carbon-credits,
        ngm:climate-risk,
        ngm:double-materiality,
        ngm:net-zero ;
    vc:requires ngm:audit-and-assurance,
        ngm:carbon-accounting,
        ngm:data-governance,
        ngm:materiality-assessment ;
    vc:slug "sustainability-reporting" ;
    vc:sourceDomain "governance" ;
    vc:standardizedBy ngm:european-sustainability-reporting-standards,
        ngm:global-reporting-initiative,
        ngm:ifrs-s2,
        ngm:issb ;
    vc:uses ngm:carbon-footprint-measurement,
        ngm:data-quality-management,
        ngm:life-cycle-assessment,
        ngm:supply-chain-transparency .

