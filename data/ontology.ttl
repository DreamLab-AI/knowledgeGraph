ngm:post-training-quantisation a owl:Class ;
    rdfs:comment "Post-training quantisation (PTQ) converts a trained full-precision neural network to a lower-precision representation, typically 8-bit integers, without re-running the original training loop. A small calibration dataset is used to estimate the dynamic range of activations so that scale and zero-point parameters can be chosen. PTQ trades a small, usually recoverable, drop in accuracy for substantial reductions in model size and inference cost."@en ;
    rdfs:label "Post Training Quantisation"@en ;
    rdfs:subClassOf ngm:quantisation ;
    rdfs:subClassOf _:r16644 ;
