    vc:relatedTo ngm:deep-learning,
        ngm:latent-space ;
    vc:requires ngm:bayesian-inference ;
    vc:slug "variational-inference" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:visual-effects a owl:Class ;
    rdfs:label "Visual Effects"@en ;
    rdfs:comment "Visual Effects (VFX) in spatial and real-time contexts encompasses the computational techniques applied after or during scene rendering to enhance visual fidelity. These include particle systems for fire and smoke simulation, post-processing stacks (bloom, depth-of-field, ambient occlusion), procedural shader effects, and screen-space reflections. Real-time VFX are increasingly GPU-accelerated via compute shaders and physically-based rendering pipelines."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gpu-compute ],
