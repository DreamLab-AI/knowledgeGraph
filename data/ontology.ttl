    vc:slug "synthetic-media" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:diffusion-model,
        ngm:generative-ai,
        ngm:video-generation .

ngm:technical-standard a owl:Class ;
    rdfs:label "Technical Standard"@en ;
    rdfs:comment "A technical standard is a formal document that establishes uniform engineering or technical criteria, mods, processes, and practices to ensure that products, services, and systems are safe, reliable, interoperable, and consistently perform as intended."@en ;
