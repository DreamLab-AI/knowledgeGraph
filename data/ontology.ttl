    vc:slug "sigma-algebra" ;
    vc:sourceDomain "data" .

ngm:signal-protocol a owl:Class ;
    rdfs:label "Signal Protocol"@en ;
    rdfs:comment "Signal Protocol is an open-source cryptographic messaging protocol that provides end-to-end encryption for instant messaging applications, combining the Double Ratchet Algorithm with the X3DH (Extended Triple Diffie-Hellman) key agreement protocol. It achieves forward secrecy and break-in recovery (future secrecy) by continuously rotating encryption keys after each message exchange."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:public-key-infrastructure ],
        ngm:secure-messaging ;
    vc:bridgesTo ngm:decentralised-identity ;
    vc:contrastsWith ngm:transport-layer-security ;
    vc:dependsOn ngm:cryptography,
        ngm:public-key-cryptography ;
    vc:enables ngm:asynchronous-communication,
        ngm:secure-messaging ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:forward-secrecy ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:noise-protocol ;
    vc:requires ngm:public-key-infrastructure ;
    vc:slug "signal-protocol" ;
    vc:sourceDomain "security" ;
    vc:uses ngm:aes-gcm,
        ngm:diffie-hellman-key-exchange,
        ngm:elliptic-curve-cryptography,
        ngm:end-to-end-encryption,
        ngm:key-exchange .

