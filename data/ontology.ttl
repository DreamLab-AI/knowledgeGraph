ngm:luma-ai a owl:Class ;
    rdfs:label "Luma AI"@en ;
    rdfs:comment "Luma AI is a company developing generative tools for 3D capture and video generation. Its products include neural reconstruction of scenes from photographs and a text-to-video model."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:video-generation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:neural-network ],
        ngm:generative-ai ;
    vc:enables ngm:3-d-asset,
        ngm:3-d-generation ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:neural-network,
        ngm:video-generation ;
    vc:slug "luma-ai" ;
    vc:sourceDomain "ai" .

