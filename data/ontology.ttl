            owl:someValuesFrom ngm:retrieval-augmented-generation ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:agent-memory ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:large-language-models ],
        ngm:agent-harness ;
    vc:contrastsWith ngm:internal-ai-harness ;
    vc:enables ngm:agentic-rag,
        ngm:agentic-workflow,
        ngm:autonomous-coding,
        ngm:multi-agent-systems ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:agent-memory,
        ngm:retrieval-augmented-generation,
        ngm:tool-call-loop ;
    vc:implements ngm:model-context-protocol,
        ngm:re-act-pattern ;
    vc:qualityScore "0.9"^^xsd:float ;
