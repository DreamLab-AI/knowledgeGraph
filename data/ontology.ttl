        ngm:system-architecture ;
    vc:slug "architectural-layer" ;
    vc:sourceDomain "infrastructure" .

ngm:arp4754-a a owl:Class ;
    rdfs:label "ARP4754A"@en ;
    rdfs:comment "ARP4754A is an aerospace recommended practice published by SAE International in 2010, titled 'Guidelines for Development of Civil Aircraft and Systems,' which provides a structured framework for the development and safety assessment of complex aircraft systems and functions. It establishes processes for identifying and mitigating failure conditions across the full aircraft system lifecycle, defining Development Assurance Levels (DAL A through E) that calibrate the rigour of development and verification activities to the severity of the failure conditions a system can contribute to. ARP4754A works in conjunction with related standards including ARP4761 for safety assessment and DO-178C for software development."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:hazard-analysis ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:safety-assessment ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:verification ],
        ngm:safety-standard ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.8"^^xsd:float ;
