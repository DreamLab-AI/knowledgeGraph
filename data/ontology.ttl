ngm:payment-system a owl:Class ;
    rdfs:label "Payment System"@en ;
    rdfs:comment "A Payment System is an infrastructure layer enabling secure and auditable exchange of value between parties, encompassing fiat payment gateways, blockchain-native token transfers, and hybrid settlement mechanisms. Within virtual economies and metaverse platforms, payment systems must handle high-frequency microtransactions, cross-currency conversion, smart-contract-mediated escrow, and compliance with AML/KYC regulations while preserving user privacy and minimising settlement latency."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:blockchain-transaction ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:smart-contract ],
        ngm:bc-defi-and-economics ;
    skos:broader ngm:bc-defi-and-economics ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:relatedTo ngm:nft,
        ngm:tokenomics ;
    vc:requires ngm:blockchain-transaction,
        ngm:smart-contract ;
    vc:slug "payment-system" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:cryptographic-security,
        ngm:lightning-network .

ngm:real-time-processing a owl:Class ;
    rdfs:label "Real-time Processing"@en ;
    rdfs:comment "Real-time Processing is a computational model where data is processed immediately upon arrival or generation, with minimal latency between input and output."@en ;
    rdfs:subClassOf ngm:ai-infrastructure,
        ngm:data-processing ;
    vc:enables ngm:anomaly-detection,
        ngm:predictive-maintenance ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:slug "real-time-processing" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:rlhf a owl:Class ;
    rdfs:label "RLHF"@en ;
    rdfs:comment "Reinforcement Learning from Human Feedback (RLHF) is a training methodology that aligns large language models with human preferences by first training a reward model on human comparison judgements, then optimising the language model policy against that reward model using reinforcement learning — typically Proximal Policy Optimisation. RLHF enables models to be steered towards outputs that human annotators prefer for helpfulness, harmlessness, and honesty, going beyond what is achievable with supervised fine-tuning on static demonstration data alone. Variants including Direct Preference Optimisation (DPO) and Constitutional AI extend or simplify the original three-stage pipeline."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:reward-model ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:human-feedback ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:reinforcement-learning ],
        ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:enables ngm:ai-alignment ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:constitutional-ai,
        ngm:direct-preference-optimisation ;
    vc:requires ngm:human-feedback,
        ngm:reinforcement-learning,
        ngm:reward-model ;
    vc:slug "rlhf" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:robot-control a owl:Class ;
    rdfs:label "Robot Control"@en ;
    rdfs:comment "Robot Control encompasses the systems, algorithms, and methodologies that enable robots to execute tasks autonomously or semi-autonomously through sensing, decision-making, and actuation. It integrates perception, planning, and actuation into closed-loop systems operating in dynamic environments."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:trajectory-control ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:feedback-control ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:kinematics ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:sensor-fusion ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:autonomous-navigation ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:pid-control ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:motion-planning ],
        ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:autonomous-navigation,
        ngm:feedback-control,
        ngm:kinematics,
        ngm:motion-planning,
        ngm:pid-control,
        ngm:sensor-fusion,
        ngm:trajectory-control ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:robo-human-robot-interaction,
        ngm:robo-navigation-and-planning,
        ngm:robo-perception ;
    vc:slug "robot-control" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:control-theory,
        ngm:deep-learning,
        ngm:reinforcement-learning .

ngm:schnorr-signature a owl:Class ;
    rdfs:label "Schnorr Signature"@en ;
    rdfs:comment "A provably secure digital signature scheme based on the discrete logarithm problem over elliptic curves, offering linearity properties that enable key and signature aggregation. Within blockchain systems Schnorr signatures underpin features such as Taproot, MuSig multi-signature protocols, and threshold signing, providing smaller signature sizes and stronger privacy compared to ECDSA."@en ;
    rdfs:subClassOf ngm:bc-cryptographic-primitive,
        ngm:blockchain-entity,
        ngm:cryptographic-primitive ;
    skos:broader ngm:bc-cryptographic-primitive ;
    vc:enables ngm:digital-signature-verification,
        ngm:merkle-tree ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:digital-signature,
        ngm:ecdsa,
        ngm:elliptic-curve-cryptography,
        ngm:signature-scheme,
        ngm:taproot-assets ;
    vc:slug "schnorr-signature" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:cryptographic-hash-function,
        ngm:secp256k1 .

ngm:sentiment-analysis a owl:Class ;
    rdfs:label "Sentiment Analysis"@en ;
    rdfs:comment "Sentiment Analysis is the NLP task of determining the emotional tone, attitude, or opinion expressed in text, classifying content as positive, negative, or neutral, and extracting fine-grained emotional attributes."@en ;
    rdfs:subClassOf ngm:ai-application,
        ngm:natural-language-processing ;
    skos:broader ngm:ai-application ;
    vc:enables ngm:information-retrieval ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:relatedTo ngm:named-entity-recognition,
        ngm:speech-recognition ;
    vc:slug "sentiment-analysis" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:large-language-models,
        ngm:transformer .

ngm:smart-contract-platform a owl:Class ;
    rdfs:label "Smart Contract Platform"@en ;
    rdfs:comment "A Smart Contract Platform is a blockchain infrastructure that provides an execution environment for programmable self-executing agreements, enabling decentralised application development through virtual machine runtimes, developer toolchains, and gas metering. Platforms such as Ethereum (EVM), Solana (Sealevel), and Cardano (Plutus) each offer distinct performance, security, and programmability trade-offs."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:blockchain ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:smart-contract ],
        ngm:bc-network-component ;
    skos:broader ngm:bc-network-component ;
    vc:enables ngm:dao,
        ngm:decentralized-finance-de-fi ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:smart-contract ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:relatedTo ngm:blockchain-interoperability ;
    vc:requires ngm:blockchain ;
    vc:slug "smart-contract-platform" ;
    vc:sourceDomain "blockchain" .

ngm:workflow-automation a owl:Class ;
    rdfs:label "Workflow Automation"@en ;
    rdfs:comment "Workflow automation is the systematic encoding of business processes, data-transformation pipelines, or task sequences into software so that they execute reliably and repeatedly with minimal human intervention, using rule-based triggers, conditional branching, and, increasingly, AI-driven orchestration of tool-using agents. It spans a spectrum from deterministic robotic process automation (RPA), which replicates human UI interactions, to agentic AI systems where large language models plan and execute multi-step tasks by calling APIs, running code, and delegating sub-tasks. Workflow automation reduces operational latency, enforces process compliance, and enables organisations to scale knowledge-work capacity."@en ;
    rdfs:subClassOf ngm:ai-application ;
    skos:broader ngm:ai-application ;
    vc:enables ngm:function-calling,
        ngm:multi-agent-systems ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:planning-and-scheduling ;
    vc:slug "workflow-automation" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:agentic-ai,
        ngm:orchestration .

ngm:zero-trust-architecture a owl:Class ;
    rdfs:label "Zero Trust Architecture"@en ;
    rdfs:comment "Zero Trust Architecture (ZTA) is a cybersecurity paradigm that abandons the notion of a trusted network perimeter and instead requires explicit, continuous verification of every principal (user, device, service) and every request, regardless of its network origin. Grounded in the principle of least-privilege access, ZTA evaluates contextual signals — identity, device health posture, location, and behavioural risk — at each access decision point, enforced by policy engines and micro-segmentation. The model was formalised in NIST SP 800-207 and is increasingly mandated by government and enterprise security frameworks as a response to lateral movement threats and cloud-native architectures that dissolve traditional perimeter boundaries."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:authentication ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:identity-and-access-management ],
        ngm:infra-security-and-identity ;
    skos:broader ngm:infra-security-and-identity ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:confidential-computing ;
    vc:requires ngm:authentication,
        ngm:identity-and-access-management ;
    vc:slug "zero-trust-architecture" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:access-control,
        ngm:policy-engine .

