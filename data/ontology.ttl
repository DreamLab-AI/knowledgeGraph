        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:image-synthesis ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:vae ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:training-data ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:neural-network-latent-space ],
        ngm:creative-ai,
        ngm:generative-ai ;
    vc:enables ngm:content-creation,
        ngm:creative-expression,
        ngm:synthetic-media,
        ngm:video-generation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:diffusion-model,
        ngm:gan,
        ngm:image-editing,
        ngm:image-synthesis,
        ngm:style-transfer,
        ngm:vae ;
    vc:qualityScore "0.89"^^xsd:float ;
    vc:relatedTo ngm:generative-model,
        ngm:kohya-dreambooth-and-similar,
        ngm:multimodal-ai ;
    vc:requires ngm:gpu-compute,
        ngm:neural-network-latent-space,
        ngm:training-data ;
    vc:slug "ai-art-generation" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:clip,
        ngm:natural-language-processing,
        ngm:transformer,
