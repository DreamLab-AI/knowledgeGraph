ngm:cloud-computing a owl:Class ;
    rdfs:label "Cloud Computing"@en ;
    rdfs:comment "Cloud computing is the on-demand delivery of computing resources — servers, storage, databases, networking, software, analytics, and AI accelerators — over the internet via provider-managed data centres, abstracting physical infrastructure into programmable APIs with pay-per-use economics. Service models (IaaS, PaaS, SaaS) and deployment models (public, private, hybrid, multi-cloud) define the boundary of managed responsibility between provider and consumer. Hyperscale providers such as AWS, Microsoft Azure, and Google Cloud Platform underpin modern AI training, inference serving, and distributed application deployment at global scale. The paradigm enables elastic provisioning — scaling from zero to thousands of compute nodes in seconds — transforming both software engineering and machine learning operations."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:platform-as-a-service ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:serverless-architecture ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:infrastructure-as-a-service ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-centre ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:virtualisation ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:software-as-a-service ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:network-infrastructure ],
        ngm:distributed-systems ;
    vc:bridgesTo ngm:digital-twin,
        ngm:federated-learning,
        ngm:spatial-computing ;
    vc:dependsOn ngm:distributed-computing,
        ngm:high-availability ;
    vc:enables ngm:ai-infrastructure,
        ngm:big-data,
        ngm:devops,
        ngm:distributed-training,
        ngm:inference,
        ngm:mlops ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:infrastructure-as-a-service,
        ngm:platform-as-a-service,
        ngm:serverless-architecture,
        ngm:software-as-a-service ;
    vc:isPartOf ngm:internet-infrastructure ;
    vc:qualityScore "0.76"^^xsd:float ;
    vc:relatedTo ngm:cloud-security,
        ngm:cost-optimisation,
        ngm:multi-cloud ;
    vc:requires ngm:data-centre,
        ngm:network-infrastructure,
        ngm:virtualisation ;
    vc:slug "cloud-computing" ;
    vc:sourceDomain "infrastructure" ;
    vc:standardizedBy ngm:iso-iec-17788,
