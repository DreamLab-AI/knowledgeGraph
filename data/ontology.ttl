            owl:someValuesFrom ngm:container ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:message-broker ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:distributed-tracing ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:api-gateway ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:continuous-integration ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:service-mesh ],
        ngm:system-architecture ;
    vc:bridgesTo ngm:edge-computing,
        ngm:serverless-architecture ;
    vc:contrastsWith ngm:monolithic-architecture,
        ngm:service-oriented-architecture ;
    vc:dependsOn ngm:docker-containerisation-platform,
        ngm:kubernetes ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:api-gateway,
        ngm:container,
