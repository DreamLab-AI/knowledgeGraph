        ngm:experience-layer,
        ngm:physics-engine,
        ngm:rendering-engine,
        ngm:simulation-engine ;
    vc:isPartOf ngm:metaverse-architecture-stack,
        ngm:metaverse-stack ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:data-storage-layer,
        ngm:gpu-resources,
        ngm:network-infrastructure,
        ngm:processing-hardware ;
    vc:slug "compute-layer" ;
    vc:sourceDomain "infrastructure" .

ngm:confidential-transactions a owl:Class ;
    rdfs:label "Confidential Transactions"@en ;
    rdfs:comment "Confidential Transactions (CT) is a cryptographic protocol for distributed ledgers, designed by Gregory Maxwell in 2015, that conceals the amounts transferred in financial transactions whilst preserving the ability for validators to verify that no value is created or destroyed. It employs Pedersen commitments—homomorphic elliptic-curve constructs—to encode transaction values in a form that is computationally hiding yet perfectly binding, combined with range proofs (typically Bulletproofs) to ensure committed values are non-negative and thus prevent inflation attacks. CT has been deployed in the Liquid Network sidechain, Monero's RingCT, and the MimbleWimble protocol family, and underpins much of the contemporary research into privacy-preserving decentralised finance."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:range-proof ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:discrete-logarithm-problem ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptographic-hash-function ],
        ngm:blockchain-transaction ;
    vc:bridgesTo ngm:financial-privacy,
        ngm:regulatory-compliance,
        ngm:secure-multi-party-computation ;
    vc:contrastsWith ngm:blockchain,
        ngm:zk-snark ;
    vc:dependsOn ngm:cryptographic-algorithm,
        ngm:utxo-model ;
    vc:enables ngm:privacy-preserving-blockchain,
        ngm:selective-disclosure ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:confidential-computing,
        ngm:liquid-network,
        ngm:monero ;
    vc:requires ngm:cryptographic-hash-function,
        ngm:discrete-logarithm-problem,
        ngm:range-proof ;
    vc:slug "confidential-transactions" ;
    vc:sourceDomain "blockchain" ;
    vc:standardizedBy ngm:bitcoin-proof-of-work-protocol-improvement-proposals,
        ngm:elements-project ;
    vc:uses ngm:bulletproofs,
        ngm:elliptic-curve-cryptography,
        ngm:homomorphic-encryption,
        ngm:pedersen-commitment,
        ngm:zero-knowledge-proof .

ngm:congestion-control a owl:Class ;
    rdfs:label "Congestion Control"@en ;
    rdfs:comment "Congestion Control is the set of mechanisms and algorithms that regulate the rate of data transmission across a network to prevent any sender, link, or node from being overwhelmed by more traffic than it can handle, thereby maintaining overall network stability and fairness. Operating primarily at the transport layer, congestion control algorithms infer network capacity from signals such as packet loss, explicit congestion notification, and round-trip time variations, adjusting sender rates accordingly. Classical implementations include TCP Tahoe, Reno, CUBIC, and BBR; modern variants extend to QUIC, WebRTC, and multipath scenarios where joint path management adds additional complexity."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:packet-loss-recovery ],
        ngm:network-protocol ;
    vc:bridgesTo ngm:content-delivery-network,
        ngm:reinforcement-learning ;
    vc:contrastsWith ngm:flow-control,
        ngm:traffic-shaping ;
    vc:dependsOn ngm:internet-protocol,
        ngm:transport-layer ;
    vc:enables ngm:fairness,
        ngm:latency-management-protocol,
        ngm:peer-to-peer-network ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:active-queue-management ;
    vc:implements ngm:bbr-algorithm,
        ngm:quic,
        ngm:tcp-cubic ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:bandwidth-adaptation,
        ngm:network-latency,
        ngm:quality-of-service ;
    vc:requires ngm:packet-loss-recovery,
        ngm:round-trip-time-measurement ;
    vc:slug "congestion-control" ;
    vc:sourceDomain "infrastructure" ;
    vc:standardizedBy ngm:ietf ;
    vc:supports ngm:distributed-computing,
        ngm:networking-infrastructure,
        ngm:real-time-communication ;
    vc:uses ngm:sliding-window-protocol .

ngm:constraint-solver a owl:Class ;
    rdfs:label "Constraint Solver"@en ;
    rdfs:comment "A constraint solver is a computational engine that finds assignments of values to variables such that all specified constraints — mathematical relationships, logical predicates, or physical laws — are simultaneously satisfied, drawing on techniques from constraint programming, SAT/SMT solving, linear programming, and numerical methods. Solvers operate by propagating constraint implications to prune the search space, applying backtracking or branch-and-bound search, and invoking domain-specific inference procedures that make the infeasibility of partial assignments detectable early. They are applied across planning and scheduling, combinatorial optimisation, formal verification, physics simulation, computer-aided design, and robotic motion planning."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:propositional-logic ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:search-algorithm ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:constraint-satisfaction ],
        ngm:inference-engine,
        ngm:optimization-algorithm ;
    vc:bridgesTo ngm:operations-research,
        ngm:robotics,
        ngm:spatial-computing ;
    vc:contrastsWith ngm:heuristic-search,
        ngm:local-search,
        ngm:neural-network ;
    vc:enables ngm:automated-planning,
        ngm:combinatorial-optimisation,
        ngm:formal-verification,
        ngm:motion-planning,
        ngm:physics-simulation,
        ngm:planning-and-scheduling,
        ngm:supply-chain-optimisation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:arc-consistency,
        ngm:backtracking-search,
        ngm:branch-and-bound,
        ngm:constraint-propagation,
        ngm:local-search,
        ngm:variable-ordering-heuristic ;
    vc:qualityScore "0.9"^^xsd:float ;
    vc:relatedTo ngm:constraint-based-design,
        ngm:gpu-computing,
        ngm:graph-neural-network,
        ngm:mixed-integer-programming,
        ngm:neuro-symbolic-ai,
        ngm:quantum-computing,
        ngm:trajectory-planning ;
    vc:requires ngm:constraint-satisfaction,
        ngm:propositional-logic,
        ngm:search-algorithm ;
    vc:slug "constraint-solver" ;
    vc:sourceDomain "ai" ;
    vc:supports ngm:computer-aided-design,
        ngm:constraint-based-design,
        ngm:decision-making,
        ngm:knowledge-representation,
        ngm:physics-simulation ;
    vc:uses ngm:heuristic-search,
        ngm:interval-arithmetic,
        ngm:linear-programming,
        ngm:logic-programming,
        ngm:satisfiability,
        ngm:smt-solving .

ngm:convex-optimisation a owl:Class ;
    rdfs:label "Convex Optimisation"@en ;
    rdfs:comment "Convex optimisation is the mathematical discipline concerned with minimising convex objective functions over convex feasible sets, exploiting the fundamental property that every local minimum is also a global minimum. This structural guarantee enables the design of polynomial-time algorithms — such as interior-point methods, subgradient descent, and proximal methods — that reliably find exact or near-exact solutions. The field is grounded in convex analysis and duality theory (Lagrangian and Fenchel duality), and underpins a vast range of applications spanning machine learning, signal processing, control systems, finance, and operations research. Canonical problem classes include linear programming, quadratic programming, second-order cone programming, and semidefinite programming."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:linear-programming ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:calculus ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:quadratic-programming ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:linear-algebra ],
        ngm:optimisation ;
    vc:bridgesTo ngm:deep-learning,
        ngm:reinforcement-learning,
        ngm:signal-processing ;
    vc:contrastsWith ngm:combinatorial-optimisation,
        ngm:non-convex-optimisation ;
    vc:dependsOn ngm:duality-theory,
        ngm:numerical-methods ;
    vc:enables ngm:compressed-sensing,
        ngm:lasso-regression,
        ngm:optimal-control,
        ngm:portfolio-optimisation,
        ngm:support-vector-machine ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:linear-programming,
        ngm:quadratic-programming,
        ngm:second-order-cone-programming,
        ngm:semidefinite-programming ;
    vc:implements ngm:gradient-descent,
        ngm:interior-point-method,
        ngm:proximal-gradient-method ;
    vc:isPartOf ngm:optimisation ;
    vc:qualityScore "0.9"^^xsd:float ;
    vc:relatedTo ngm:functional-analysis,
        ngm:operations-research,
        ngm:stochastic-optimisation ;
    vc:requires ngm:calculus,
        ngm:convex-analysis,
        ngm:linear-algebra ;
    vc:slug "convex-optimisation" ;
    vc:sourceDomain "machine-learning" ;
    vc:uses ngm:kkt-conditions,
        ngm:lagrange-multipliers .

ngm:cross-chain-messaging a owl:Class ;
    rdfs:label "Cross-Chain Messaging"@en ;
