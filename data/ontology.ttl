ngm:arithmetic-circuit a owl:Class ;
    rdfs:label "Arithmetic Circuit"@en ;
    rdfs:comment "A directed acyclic graph (DAG) of addition and multiplication gates over a field, used to represent polynomial computations in a form amenable to cryptographic proof systems. Arithmetic circuits are the canonical intermediate representation for zero-knowledge proof schemes such as zk-SNARKs and STARKs: a computation is first expressed as an arithmetic circuit, then compiled into a system of polynomial constraints (R1CS or Plonkish), and finally proved using a cryptographic proving system. The complexity of a circuit is characterised by its depth (for parallelism) and size (gate count)."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:polynomial-commitment ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:finite-field-arithmetic ],
        ngm:security ;
    vc:bridgesTo ngm:blockchain ;
    vc:contrastsWith ngm:boolean-circuit ;
    vc:dependsOn ngm:elliptic-curve-cryptography ;
    vc:enables ngm:verifiable-computation,
        ngm:zk-snark,
        ngm:zk-stark ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:logic-gate ;
    vc:implements ngm:cryptographic-protocol ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:boolean-circuit,
        ngm:homomorphic-encryption,
        ngm:secure-multi-party-computation ;
    vc:requires ngm:finite-field-arithmetic,
        ngm:polynomial-commitment ;
    vc:slug "arithmetic-circuit" ;
    vc:sourceDomain "security" ;
    vc:supports ngm:privacy-preserving-computation ;
    vc:uses ngm:constraint-system,
        ngm:zero-knowledge-proof .

ngm:asic-hardware a owl:Class ;
    rdfs:label "ASIC Hardware"@en ;
    rdfs:comment "Application-Specific Integrated Circuits (ASICs) are custom silicon chips designed and manufactured to perform a fixed, narrowly defined computational task with maximum efficiency. Unlike general-purpose processors, ASIC hardware sacrifices programmability for dramatically superior performance-per-watt ratios in its target workload, making it the dominant substrate for high-throughput, power-sensitive deployments."@en ;
    rdfs:subClassOf ngm:computer-hardware ;
    vc:contrastsWith ngm:fpga ;
    vc:enables ngm:digital-signal-processing,
        ngm:neural-processing-unit,
        ngm:parallel-processing ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:embedded-systems ;
    vc:slug "asic-hardware" ;
    vc:sourceDomain "infrastructure" .

ngm:asyncapi a owl:Class ;
    rdfs:label "Asyncapi"@en ;
    rdfs:comment "AsyncAPI is an open specification for describing event-driven and message-based APIs in a machine-readable document, analogous to how OpenAPI describes request-response REST APIs. It defines channels, messages, payloads and the protocols and brokers used to exchange them, enabling documentation, code generation, validation and tooling for asynchronous systems. AsyncAPI standardises contracts for publish-subscribe and streaming architectures."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:message-broker ],
        ngm:api-specification ;
    vc:bridgesTo ngm:api-gateway ;
    vc:contrastsWith ngm:openapi,
        ngm:rest-api ;
    vc:dependsOn ngm:json-schema ;
    vc:enables ngm:event-driven-architecture,
        ngm:streaming-data ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:event-driven-architecture,
        ngm:openapi ;
    vc:requires ngm:message-broker ;
    vc:slug "asyncapi" ;
    vc:sourceDomain "infrastructure" ;
    vc:standardizedBy ngm:interoperability-standard ;
    vc:supports ngm:asynchronous-messaging,
        ngm:event-driven-architecture ;
    vc:uses ngm:json-schema,
        ngm:schema-validation .

ngm:asynchronous-coordination a owl:Class ;
    rdfs:label "Asynchronous Coordination"@en ;
    rdfs:comment "Asynchronous Coordination is the alignment of distributed agents or processes that act without a shared global clock or blocking synchronization, communicating through messages, shared state, or eventual-consistency mechanisms. It tolerates network delay and partial failure by letting participants make progress independently and reconcile state later. This model underpins resilient distributed systems and decentralized multi-agent and swarm control."@en ;
    rdfs:subClassOf ngm:distributed-systems ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:decentralised-coordination,
        ngm:decentralized-swarm-control ;
    vc:slug "asynchronous-coordination" ;
    vc:sourceDomain "infrastructure" .

ngm:audience-engagement a owl:Class ;
    rdfs:label "Audience Engagement"@en ;
    rdfs:comment "Audience engagement is the set of strategies and interactive mechanisms by which creators and platforms capture, sustain and deepen the attention and participation of viewers. It spans techniques such as live polls, question-and-answer sessions, gamification, reactions and personalised content, measured through metrics like watch time, interaction rate and retention. Strong audience engagement drives community growth, loyalty and monetisation across live and on-demand media."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
