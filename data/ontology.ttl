    vc:slug "technology-adoption" ;
    vc:sourceDomain "distributed-collaboration" .

ngm:telecommunications-infrastructure a owl:Class ;
    rdfs:label "Telecommunications Infrastructure"@en ;
    rdfs:comment "Telecommunications Infrastructure comprises the physical and logical systems — including fibre-optic networks, cellular base stations, satellite links, exchange points, and backbone routers — that carry digital communications at scale. It underpins latency-sensitive applications such as real-time rendering, telecollaboration, and edge AI by providing the transport layer on which higher-level protocols operate."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:network-protocol ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:bandwidth-adaptation ],
        ngm:infra-network-and-comms ;
    skos:broader ngm:infra-network-and-comms ;
    vc:enables ngm:remote-communication,
        ngm:telecollaboration,
        ngm:video-conferencing ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:bandwidth-adaptation,
        ngm:network-protocol ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:slug "telecommunications-infrastructure" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:content-delivery-network,
        ngm:latency-management-protocol .

ngm:testing-infrastructure a owl:Class ;
    rdfs:label "Testing Infrastructure"@en ;
    rdfs:comment "The ensemble of tools, environments, frameworks, and automated pipelines used to validate software correctness, performance, and reliability across development and deployment stages. Testing infrastructure encompasses unit, integration, and end-to-end test runners, continuous integration services, containerised test environments, and monitoring dashboards that together ensure software meets quality standards before release."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:software-testing ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:monitoring-dashboard ],
        ngm:infra-software-engineering,
        ngm:quality-assurance ;
    skos:broader ngm:infra-software-engineering ;
    vc:enables ngm:testing-process ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:monitoring-dashboard,
        ngm:software-testing ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:relatedTo ngm:data-security ;
    vc:slug "testing-infrastructure" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:quality-assurance .

ngm:threat-actor a owl:Class ;
    rdfs:label "Threat Actor"@en ;
    rdfs:comment "A Threat Actor is an individual, organised group, or nation-state entity that possesses the intent, capability, and opportunity to exploit vulnerabilities in digital systems. Actors are classified by motivation (financial, ideological, strategic, personal) and sophistication tier (opportunistic script-kiddies through state-sponsored APTs), with attribution performed via TTPs, infrastructure patterns, and targeting behaviour."@en ;
    rdfs:subClassOf ngm:attack-vector,
        ngm:bc-protocol-and-consensus ;
    skos:broader ngm:bc-protocol-and-consensus ;
    vc:contrastsWith ngm:resilience,
        ngm:security ;
    vc:enables ngm:security-framework,
        ngm:zero-trust-architecture ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:cybersecurity,
        ngm:risk ;
    vc:slug "threat-actor" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:attack-vector,
        ngm:vulnerability .

ngm:threat-detection a owl:Class ;
    rdfs:label "Threat Detection"@en ;
    rdfs:comment "Threat detection is the cybersecurity discipline concerned with identifying malicious or anomalous activity within a system or network in time to enable an effective defensive response, distinguishing genuine threats from benign anomalies across high-volume, noisy telemetry. It encompasses signature-based detection of known attack patterns, behavioural analytics for novel threats, and machine learning models that model normal system baselines and flag statistical deviations. Effective threat detection must balance sensitivity (catching real attacks) against specificity (avoiding alert fatigue from false positives)."@en ;
    rdfs:subClassOf ngm:cybersecurity ;
    vc:enables ngm:incident-response,
        ngm:threat-surface-map ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:anomaly-detection,
        ngm:attack-vector,
        ngm:threat-actor,
        ngm:threat-model ;
    vc:slug "threat-detection" ;
    vc:sourceDomain "security" ;
    vc:supports ngm:information-security,
        ngm:network-security ;
    vc:uses ngm:ai-security .

ngm:timelock-controller a owl:Class ;
    rdfs:label "Timelock Controller"@en ;
    rdfs:comment "A timelock controller is a smart contract governance primitive that enforces a mandatory waiting period — the timelock delay — between the scheduling of an on-chain operation (such as a protocol upgrade, parameter change, or treasury disbursement) and its execution, giving token holders, security researchers, and affected parties an opportunity to review, object to, or exit before the change takes effect. Operations must be queued with their full parameters, remain in the queue for the configured delay, and then be explicitly executed; they may also be cancelled by authorised roles during the waiting period. Timelock controllers are a fundamental safety mechanism in DeFi and DAO governance, protecting against malicious or erroneous governance proposals."@en ;
    rdfs:subClassOf ngm:on-chain-governance ;
    vc:enables ngm:blockchain-governance,
        ngm:dao-governance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:access-control,
        ngm:hash-time-locked-contract,
        ngm:open-zeppelin-governor,
        ngm:smart-contract ;
    vc:slug "timelock-controller" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:proposal-system,
        ngm:voting-mechanism .

ngm:total-supply a owl:Class ;
    rdfs:label "Total Supply"@en ;
    rdfs:comment "Total Supply is the count of all tokens that have ever been created on a blockchain network, encompassing circulating tokens, locked or vested tokens, tokens held in treasury reserves, and any tokens that have been minted but not yet distributed—but excluding permanently destroyed (burned) tokens. It differs from the maximum supply (the hard cap set by the protocol) and from circulating supply (tokens freely tradeable on secondary markets). Total supply is a fundamental parameter in tokenomics analysis used to assess inflation, dilution, and long-term value dynamics."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:circulating-supply ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:supply-cap ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:emission-schedule ],
        ngm:bc-defi-and-economics,
        ngm:blockchain-entity,
        ngm:economic-mechanism ;
    skos:broader ngm:bc-defi-and-economics ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:circulating-supply ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:deflationary-token,
        ngm:halving,
        ngm:inflation,
        ngm:inflationary-token,
        ngm:market-capitalization,
        ngm:tokenomics,
        ngm:treasury-management ;
    vc:requires ngm:emission-schedule,
        ngm:supply-cap ;
    vc:slug "total-supply" ;
    vc:sourceDomain "blockchain" .

ngm:trade-finance-automation a owl:Class ;
    rdfs:label "Trade Finance Automation"@en ;
    rdfs:comment "Trade Finance Automation is the application of digital technologies—including blockchain-based smart contracts, AI-driven document processing, and electronic data interchange—to streamline and accelerate the complex financial instruments and workflows that facilitate international commerce. Traditional trade finance relies on paper-intensive instruments such as letters of credit, bills of lading, and documentary collections, which are slow, error-prone, and costly to process. Automation replaces manual document verification with machine-readable structured data, triggers payment obligations automatically upon verified delivery conditions, and reduces counterparty risk through distributed ledger transparency. The result is faster settlement, lower operational costs, and improved access to working capital for exporters and importers globally."@en ;
    rdfs:subClassOf ngm:trade-finance ;
    vc:enables ngm:cross-border-payments,
        ngm:logistics-optimization,
        ngm:supply-chain-management ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:blockchain-compliance,
        ngm:customs-trade-facilitation,
        ngm:financial-instruments,
        ngm:supply-chain-blockchain ;
    vc:slug "trade-finance-automation" ;
    vc:sourceDomain "finance" ;
    vc:uses ngm:blockchain,
        ngm:enterprise-smart-contracts,
        ngm:smart-contract,
        ngm:supply-chain-traceability .

ngm:transaction-history a owl:Class ;
    rdfs:label "Transaction History"@en ;
    rdfs:comment "Transaction history is the ordered, append-only record of all value transfers, state changes, or operations executed within a financial or data system, providing a tamper-evident chronological account of who transacted what, with whom, and when. In blockchain systems, transaction history is the fundamental data structure underpinning the distributed ledger — every confirmed block links to its predecessor through cryptographic hashing, making retroactive alteration of any transaction computationally prohibitive. Transaction history serves audit, compliance, forensic, tax, and portfolio analytics functions across both traditional and decentralised financial systems."@en ;
    rdfs:subClassOf ngm:blockchain-transaction ;
    vc:enables ngm:blockchain-analytics,
        ngm:blockchain-compliance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:audit-log,
        ngm:financial-transactions,
        ngm:on-chain-governance ;
    vc:slug "transaction-history" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:audit-trail,
        ngm:blockchain,
        ngm:distributed-ledger .

ngm:uncertainty-quantification a owl:Class ;
    rdfs:label "Uncertainty Quantification"@en ;
    rdfs:comment "Uncertainty Quantification (UQ) is a discipline concerned with characterising, propagating, and communicating the uncertainties inherent in computational models, predictions, and measurements. It distinguishes between aleatoric uncertainty (irreducible randomness in the data or system) and epistemic uncertainty (reducible uncertainty arising from limited knowledge or data), providing principled methods — including Bayesian inference, Monte Carlo sampling, conformal prediction, and ensemble methods — for producing calibrated probability estimates rather than point predictions. UQ is foundational to trustworthy AI, safety-critical systems engineering, and scientific computing."@en ;
    rdfs:subClassOf ngm:probabilistic-model ;
    vc:contrastsWith ngm:adversarial-robustness ;
    vc:dependsOn ngm:machine-learning ;
    vc:enables ngm:model-robustness,
        ngm:risk-assessment,
        ngm:trustworthy-ai ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:bayesian-inference,
        ngm:ensemble-methods,
        ngm:monte-carlo-methods,
        ngm:probabilistic-model ;
    vc:slug "uncertainty-quantification" ;
    vc:sourceDomain "ai" ;
    vc:supports ngm:ai-safety,
        ngm:interpretability,
        ngm:model-evaluation-results ;
    vc:uses ngm:calibration .

ngm:universal-scene-description a owl:Class ;
    rdfs:label "Universal Scene Description"@en ;
    rdfs:comment "Universal Scene Description is an open-source, extensible framework originally developed by Pixar Animation Studios and released as open source under the Modified Apache 2.0 licence, providing a unified file format family and programmatic scene-graph API for describing, composing, simulating, and..."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:asset-pipeline ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:schema-registry ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:scene-graph ],
        ngm:3-d-file-format,
        ngm:asset-pipeline,
        ngm:sc-standards-and-interop ;
    skos:broader ngm:sc-standards-and-interop ;
    vc:enables ngm:collaborative-scene-assembly,
        ngm:cross-dcc-interoperability,
        ngm:digital-twin,
        ngm:non-destructive-editing,
        ngm:real-time-rendering,
        ngm:spatial-computing,
        ngm:virtual-production ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:composition-arcs,
        ngm:crate-format,
        ngm:hydra,
        ngm:layer-stack,
        ngm:material-x,
        ngm:open-subdiv,
        ngm:usd-skel,
        ngm:usdz,
        ngm:variant-sets ;
    vc:implements ngm:hydra-scene-delegate,
        ngm:livrps-composition,
        ngm:material-x-shading,
        ngm:open-pbr-material-model,
        ngm:open-subdiv-refinement,
        ngm:variant-selection ;
    vc:qualityScore "0.52"^^xsd:float ;
    vc:relatedTo ngm:aousd,
        ngm:apple-vision-pro,
        ngm:autodesk-maya,
        ngm:houdini,
        ngmi:blender,
        ngmi:nvidia-omniverse,
        ngmi:unreal-engine ;
    vc:requires ngm:asset-pipeline,
        ngm:layer-resolution,
        ngm:renderer,
        ngm:scene-graph,
        ngm:schema-registry ;
    vc:slug "universal-scene-description" ;
    vc:sourceDomain "spatial-computing" ;
