# Soft Robotics
robotics:SoftRobotics rdf:type owl:Class ;
    rdfs:label "Soft Robotics"@en ;
    rdfs:comment "Robotics discipline employing compliant, flexible materials enabling safe human interaction and adaptation to unstructured environments, with applications across surgical robotics, food handling automation, wearable assistive devices, and collaborative manufacturing—advancing through bio-inspired design, soft actuation, and machine learning control."@en ;
    skos:prefLabel "Soft Robotics"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:robotics:soft-robotics" ;
    owl:sameAs <urn:visionclaw:concept:robotics:soft-robotics> ;
