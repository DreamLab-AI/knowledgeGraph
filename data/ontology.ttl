ngm:fatf-40-recommendations a owl:Class ;
    rdfs:label "FATF 40 Recommendations"@en ;
    rdfs:comment "The FATF 40 Recommendations are the international standards on combating money laundering, terrorist financing, and proliferation financing issued by the Financial Action Task Force. They define a comprehensive framework covering customer due diligence, beneficial-ownership transparency, suspicious-transaction reporting, supervision, and international cooperation. National regimes implement them to achieve compliance assessed through FATF mutual evaluations."@en ;
    rdfs:subClassOf ngm:financial-regulation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:aml-kyc-compliance,
        ngm:regulatory-compliance ;
    vc:slug "fatf-40-recommendations" ;
    vc:sourceDomain "blockchain" .

ngm:fatf-guidance-on-virtual-assets a owl:Class ;
    rdfs:label "FATF Guidance on Virtual Assets"@en ;
    rdfs:comment "The FATF Guidance on Virtual Assets is the Financial Action Task Force's risk-based interpretation of how its anti-money-laundering standards apply to virtual assets and virtual-asset service providers (VASPs). It defines key terms, requires VASP licensing or registration and supervision, and introduces the 'travel rule' obliging the transfer of originator and beneficiary information with transactions. The guidance shapes how exchanges, custodians, and DeFi arrangements are regulated worldwide."@en ;
    rdfs:subClassOf ngm:financial-regulation ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:cbdcs,
        ngm:decentralized-finance-de-fi ;
    vc:slug "fatf-guidance-on-virtual-assets" ;
    vc:sourceDomain "blockchain" .

