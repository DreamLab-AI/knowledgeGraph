ngm:automatic-speech-recognition a owl:Class ;
    rdfs:label "Automatic Speech Recognition"@en ;
    rdfs:comment "Automatic Speech Recognition (ASR) is the technology that converts spoken language into written text by jointly modelling acoustic signals — frame-level spectral features derived from raw audio waveforms — and linguistic context, using neural sequence-to-sequence architectures trained on large corpora of paired audio and transcripts. Modern ASR systems built on transformer and conformer encoder-decoder designs achieve near-human word error rates on clean speech benchmarks and have been extended to multilingual and low-resource settings through large-scale self-supervised pre-training on unlabelled audio. ASR serves as a foundational component for voice assistants, real-time transcription services, accessibility tooling, and spoken language understanding pipelines, and underpins multimodal AI systems that must bridge the speech and text modalities."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:training-data ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:language-model ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:feature-extraction ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:audio-signal-processing ],
        ngm:speech-processing ;
    vc:bridgesTo ngm:distributed-collaboration,
        ngm:spatial-audio ;
    vc:contrastsWith ngm:keyword-spotting,
        ngm:text-to-speech ;
    vc:enables ngm:machine-translation,
        ngm:natural-language-processing,
        ngm:real-time-captioning,
        ngm:spoken-language-understanding,
        ngm:voice-interaction ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:acoustic-model,
        ngm:feature-extraction,
        ngm:language-model ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:language-modeling,
        ngm:speaker-diarisation,
        ngm:speaker-recognition,
        ngm:word-error-rate ;
    vc:requires ngm:audio-signal-processing,
        ngm:training-data ;
    vc:slug "automatic-speech-recognition" ;
    vc:sourceDomain "ai" ;
    vc:supports ngm:accessibility,
        ngm:human-computer-interaction,
        ngm:multimodal-ai ;
    vc:uses ngm:connectionist-temporal-classification,
        ngm:deep-learning,
        ngm:recurrent-neural-network,
        ngm:self-supervised-learning,
        ngm:transformer-architecture .

