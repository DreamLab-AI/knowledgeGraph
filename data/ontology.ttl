    rdfs:label "Groth16"@en ;
    rdfs:comment "A pairing-based zk-SNARK proving system that produces constant-size proofs verifiable with a few elliptic curve pairing operations, at the cost of a per-circuit trusted setup."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:elliptic-curve-cryptography ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:zk-snark ],
        ngm:zk-snark ;
    vc:enables ngm:zero-knowledge-proof ;
    vc:hasMaturity ngmi:maturity-established ;
