ngm:cross-border-payments a owl:Class ;
    rdfs:label "Cross-Border Payments"@en ;
    rdfs:comment "Cross-Border Payments are financial transactions that originate in one country and are settled in another, requiring currency conversion, multi-jurisdiction regulatory compliance, and interoperability between disparate payment systems. Traditional correspondent banking networks rely on SWIFT messaging and chains of intermediary banks, incurring multi-day settlement cycles, layered fees, and significant opacity. Blockchain-based payment rails—including stablecoins, payment channels, and Central Bank Digital Currencies—compress settlement latency and reduce intermediary costs by enabling atomic finality and programmable escrow. The domain sits at the intersection of monetary policy, AML/KYC regulation, ISO 20022 standardisation, and distributed-ledger technology."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:aml-kyc-compliance ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:correspondent-banking ],
        ngm:financial-services ;
    vc:bridgesTo ngm:blockchain,
        ngm:consensus-mechanism,
        ngm:tokenization ;
    vc:contrastsWith ngm:correspondent-banking ;
    vc:dependsOn ngm:interoperability,
        ngm:payment-infrastructure,
        ngm:regulatory-compliance ;
    vc:enables ngm:financial-inclusion,
        ngm:remittances,
        ngm:trade-finance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:central-bank-digital-currency,
        ngm:decentralised-finance,
        ngm:fatf-travel-rule,
        ngm:forex ;
    vc:requires ngm:aml-kyc-compliance,
        ngm:correspondent-banking ;
    vc:slug "cross-border-payments" ;
    vc:sourceDomain "finance" ;
    vc:standardizedBy ngm:bis-cpmi,
        ngm:financial-stability-board ;
    vc:uses ngm:iso-20022,
        ngm:lightning-network,
        ngm:smart-contract,
        ngm:stablecoin,
        ngm:swift-messaging .

ngm:decentralized-identity a owl:Class ;
    rdfs:label "Decentralized Identity"@en ;
    rdfs:comment "Decentralized Identity is an approach to digital identity management in which individuals, organisations, and devices hold cryptographic control over their own identifiers and credentials without dependence on any centralised identity provider. Built upon the W3C Decentralized Identifiers (DID) v1.0 Recommendation and the W3C Verifiable Credentials Data Model, it establishes a tripartite trust triangle of issuers, holders, and verifiers where credential authenticity is established through public-key cryptography anchored to a verifiable data registry — such as a distributed ledger or DNS — rather than through a privileged intermediary. This architecture realises self-sovereign identity principles: the subject generates and controls their key material, selectively discloses attributes using mechanisms such as BBS+ signatures or SD-JWT, and satisfies verifiers without exposing credentials to central surveillance or requiring real-time queries to the issuer."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:verifiable-data-registry ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:didcomm ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptographic-signature ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:verifiable-credential-vc ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:credential-verification ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:digital-identity-wallet ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:did-document ],
        ngm:digital-identity ;
    vc:bridgesTo ngm:smart-contract,
        ngm:web3 ;
    vc:contrastsWith ngm:centralized-identity-provider,
        ngm:federated-identity,
        ngm:oauth ;
    vc:enables ngm:cross-border-authentication,
        ngm:privacy-by-design,
        ngm:selective-disclosure,
        ngm:self-sovereign-identity ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:credential-verification,
        ngm:did-document,
        ngm:didcomm,
        ngm:digital-identity-wallet,
        ngm:verifiable-credential-vc ;
    vc:implements ngm:w-3-c-verifiable-credentials-data-model,
        ngm:w3-c-did-specification ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:access-control,
        ngm:data-sovereignty,
        ngm:trust-framework ;
    vc:requires ngm:cryptographic-signature,
        ngm:verifiable-data-registry ;
    vc:slug "decentralized-identity" ;
    vc:sourceDomain "security" ;
    vc:standardizedBy ngm:decentralized-identity-foundation,
        ngm:open-id-foundation,
        ngm:w3-c ;
    vc:uses ngm:blockchain,
        ngm:cryptographic-keys,
        ngm:distributed-ledger-technology,
        ngm:public-key-infrastructure,
        ngm:zero-knowledge-proof .

ngm:erc-20 a owl:Class ;
    rdfs:label "ERC-20"@en ;
    rdfs:comment "ERC-20 is the Ethereum Request for Comments token standard that defines a mandatory six-function interface — totalSupply, balanceOf, transfer, transferFrom, approve, and allowance — plus optional name, symbol, and decimals metadata, enabling any conformant fungible token to interoperate seamlessly with wallets, decentralised exchanges, and smart-contract protocols without bespoke integration. Proposed by Fabian Vogelsteller and Vitalik Buterin in November 2015 and formalised as Ethereum Improvement Proposal 20 (EIP-20), it became the foundational primitive of the DeFi ecosystem and the predominant format for utility tokens, governance tokens, stablecoins, and wrapped assets. The standard defines a delegated-transfer pattern via approve and transferFrom that allows smart contracts to spend tokens on a holder's behalf, and it underpins the liquidity infrastructure of all major decentralised exchanges, lending protocols, and yield-aggregators on EVM-compatible networks."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:fungible-token ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:smart-contract ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:solidity ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ethereum-smart-contract-platform-virtual-machine ],
        ngm:token-standard ;
    vc:bridgesTo ngm:on-chain-governance,
        ngm:tokenization ;
    vc:contrastsWith ngm:erc-1155,
        ngm:erc-721,
        ngm:erc-777,
        ngm:spl-token ;
    vc:enables ngm:decentralised-exchange,
        ngm:decentralised-finance,
        ngm:governance-token,
        ngm:liquidity-pool,
        ngm:stablecoin ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:fungible-token,
        ngm:smart-contract ;
    vc:implements ngm:ethereum-improvement-proposal ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:erc-2612-permit,
        ngm:wrapped-token ;
    vc:requires ngm:ethereum-smart-contract-platform-virtual-machine,
        ngm:solidity ;
    vc:slug "erc-20" ;
    vc:sourceDomain "blockchain" ;
    vc:standardizedBy ngm:ethereum-smart-contract-platform-foundation ;
    vc:supports ngm:automated-market-maker,
        ngm:token-composability ;
    vc:uses ngm:ethereum .

ngm:ethereum-smart-contract-platform-virtual-machine a owl:Class ;
    rdfs:label "Ethereum Virtual Machine"@en ;
    rdfs:comment "The Ethereum Virtual Machine (EVM) is a deterministic, quasi-Turing-complete, stack-based virtual machine that serves as the sandboxed runtime environment for executing compiled smart contract bytecode on the Ethereum blockchain. Every full node in the network independently executes the same sequence of EVM opcodes and must converge to an identical post-execution world state, enforcing global consensus over account balances, contract storage, and transaction receipts. Execution is metered by a resource-accounting unit called Gas, which prevents denial-of-service attacks and prices computational work proportionally to its cost. The EVM's instruction set and state transition function have become a de-facto industry standard, with dozens of EVM-compatible chains and Layer 2 networks implementing the same specification to enable cross-chain portability of smart contracts."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:merkle-patricia-trie ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ethereum-account ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gas ],
        ngm:virtual-machine ;
    vc:bridgesTo ngm:formal-verification,
        ngm:zero-knowledge-proof ;
    vc:contrastsWith ngm:move-virtual-machine,
        ngm:web-assembly ;
    vc:dependsOn ngm:ethereum-consensus,
        ngm:proof-of-stake ;
    vc:enables ngm:decentralised-application,
        ngm:decentralised-finance,
        ngm:ethereum-smart-contract-platform-smart-contracts,
        ngm:non-fungible-token ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:evm-memory,
        ngm:evm-stack ;
    vc:implements ngm:ethereum-yellow-paper,
        ngm:smart-contract-platform ;
    vc:qualityScore "0.76"^^xsd:float ;
    vc:relatedTo ngm:evm-compatible-blockchain,
        ngm:layer-2-scaling ;
    vc:requires ngm:ethereum-account,
        ngm:gas,
        ngm:merkle-patricia-trie ;
    vc:slug "ethereum-virtual-machine" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:keccak-256,
        ngm:solidity .

ngm:finance a owl:Class ;
    rdfs:label "Finance"@en ;
    rdfs:comment "Finance is the discipline concerned with the management, creation, and study of money, investments, and other financial instruments across individuals, organisations, and markets. It encompasses how capital is raised, allocated, priced, and risk-managed over time, spanning corporate finance, public finance, and personal finance. In the context of distributed systems, finance increasingly intersects with blockchain-based instruments and decentralised protocols that reimagine settlement, custody, and intermediation."@en ;
