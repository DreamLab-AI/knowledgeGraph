# Verifiable Credential Standard
spatial-computing:VerifiableCredentialStandard rdf:type owl:Class ;
    rdfs:subClassOf spatial-computing:Standards ;
    rdfs:label "Verifiable Credential Standard"@en ;
    rdfs:comment "The W3C specification that defines a standard data model and format for expressing cryptographically verifiable claims about subjects, enabling portable, privacy-preserving digital credentials for identity and attribute verification."@en ;
