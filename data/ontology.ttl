ngm:re-lu-activation a owl:Class ;
    rdfs:label "ReLU Activation"@en ;
    rdfs:comment "The Rectified Linear Unit (ReLU) is a nonlinear activation function defined as f(x) = max(0, x), outputting the input directly when positive and zero otherwise. Its simplicity, sparse activation, and non-saturating gradient for positive inputs make it the default activation in most deep neural networks, mitigating the vanishing-gradient problem. Variants such as Leaky ReLU and GELU address its dead-neuron limitation."@en ;
    rdfs:subClassOf ngm:neural-network ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:fast-ai,
        ngm:generative-adversarial-networks ;
    vc:slug "re-lu-activation" ;
    vc:sourceDomain "ai" .

