ngm:competency-based-education a owl:Class ;
    rdfs:label "Competency Based Education"@en ;
    rdfs:comment "Competency-Based Education is an instructional model that grants progression and credentials based on demonstrated mastery of defined competencies rather than time spent in instruction. Learners advance when they can prove they have met explicit, measurable outcomes, often supported by personalised pacing and frequent assessment. The approach relies on learning analytics and educational technology to track and verify competency attainment."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:formative-assessment ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:learning-analytics ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:learning-management-system ],
        ngm:education-technology,
        ngm:mastery-learning ;
    vc:contrastsWith ngm:apprenticeship,
        ngm:time-based-education ;
    vc:dependsOn ngm:feedback-loop,
        ngm:learning-management-system ;
    vc:enables ngm:adaptive-learning,
        ngm:lifelong-learning,
        ngm:personalised-learning,
        ngm:workforce-development ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:competency-framework,
        ngm:formative-assessment,
        ngm:learner-model,
        ngm:rubric-based-assessment,
        ngm:summative-assessment ;
    vc:implements ngm:bloom-taxonomy,
