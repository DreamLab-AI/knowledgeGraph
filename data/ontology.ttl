    vc:standardizedBy ngm:xml-schema ;
    vc:supports ngm:data-management ;
    vc:uses ngm:structured-data .

ngm:software-testing a owl:Class ;
    rdfs:label "Software Testing"@en ;
    rdfs:comment "Software Testing is the systematic discipline of evaluating software systems and components by executing them under controlled conditions, observing emergent behaviour, and verifying conformance to specified requirements, design intent, and quality attributes. It encompasses a hierarchy of test granularity — from unit and integration tests that validate individual components to system, end-to-end, and acceptance tests that assess the complete product — as well as specialised dimensions such as performance, security, accessibility, regression, and exploratory testing. Testing is an integral quality assurance mechanism embedded throughout the software development lifecycle, supporting early defect detection, risk mitigation, and continuous delivery. Alongside static analysis and formal verification, it constitutes the primary empirical evidence base for software correctness and reliability."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:unit-testing ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:integration-testing ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:test-automation ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:regression-testing ],
        ngm:infra-software-engineering ;
    skos:broader ngm:infra-software-engineering ;
    vc:bridgesTo ngm:digital-twin,
        ngm:simulation ;
    vc:contrastsWith ngm:formal-verification,
        ngm:static-analysis ;
    vc:dependsOn ngm:requirements-engineering,
        ngm:version-control ;
    vc:enables ngm:continuous-delivery,
        ngm:defect-detection,
        ngm:reliability ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:integration-testing,
        ngm:performance-testing,
        ngm:regression-testing,
        ngm:unit-testing ;
    vc:isPartOf ngm:continuous-integration,
        ngm:software-development-lifecycle ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:agile-software-development,
        ngm:devops ;
    vc:requires ngm:test-automation,
        ngm:test-data-management ;
    vc:slug "software-testing" ;
    vc:sourceDomain "infrastructure" ;
    vc:standardizedBy ngm:ieee-829 ;
    vc:supports ngm:robustness,
        ngm:safety ;
    vc:uses ngm:test-driven-development .

ngm:solidity a owl:Class ;
    rdfs:label "Solidity"@en ;
    rdfs:comment "Solidity is a statically-typed, curly-brace, contract-oriented programming language designed for writing smart contracts that execute on the Ethereum Virtual Machine (EVM) and EVM-compatible blockchain platforms. Released in 2014 by the Ethereum Foundation, it compiles to EVM bytecode and provides constructs including inheritance, interfaces, libraries, events, function modifiers, and custom error types. The language's semantics are shaped by on-chain execution constraints: every opcode costs gas, state is globally persistent, and deployed code is immutable absent explicit upgrade patterns. Solidity is the dominant language for decentralised finance, non-fungible tokens, and decentralised autonomous organisations, and its security vulnerability surface has driven a parallel industry of formal verification, auditing frameworks, and defensive programming libraries."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gas ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:compiler ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:blockchain ],
        ngm:programming-language ;
    vc:bridgesTo ngm:oracle,
        ngm:zero-knowledge-proof ;
    vc:contrastsWith ngm:rust-systems-programming-language,
        ngm:vulnerability,
        ngm:vyper ;
    vc:dependsOn ngm:cryptographic-hash-function,
        ngm:evm ;
    vc:enables ngm:dao,
        ngm:decentralised-finance,
        ngm:nft,
        ngm:smart-contract,
        ngm:token ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:erc-1155,
        ngm:erc-20,
        ngm:erc-721,
        ngm:ethereum-smart-contract-platform-virtual-machine ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:access-control,
        ngm:proxy-pattern,
        ngm:reentrancy-attack ;
    vc:requires ngm:blockchain,
        ngm:compiler,
        ngm:gas ;
    vc:slug "solidity" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:formal-verification,
        ngm:security-audit,
        ngm:unit-testing ;
    vc:uses ngm:ethereum-smart-contract-platform,
        ngm:opcodes .

ngm:taproot a owl:Class ;
    rdfs:label "Taproot"@en ;
    rdfs:comment "Taproot is a soft-fork upgrade to the Bitcoin protocol, activated at block 709,632 in November 2021, comprising BIPs 340, 341, and 342. It introduces Schnorr signatures (BIP 340), Pay-to-Taproot (P2TR) outputs with Merkelised Abstract Syntax Tree (MAST) spending-condition commitments (BIP 341), and Tapscript — an updated Bitcoin Script dialect (BIP 342). Together these improvements enhance transaction privacy by making complex multi-condition spends indistinguishable from simple key-path spends, improve efficiency via Schnorr signature aggregation, and expand smart-contract expressiveness on Bitcoin's base layer."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:elliptic-curve-cryptography ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:merkle-tree ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:bip-342-tapscript ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:schnorr-signatures ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:soft-fork ],
        ngm:bc-protocol-and-consensus ;
    skos:broader ngm:bc-protocol-and-consensus ;
    vc:bridgesTo ngm:decentralised-finance,
        ngm:zero-knowledge-proof ;
    vc:contrastsWith ngm:ecdsa,
        ngm:pay-to-script-hash,
        ngm:segregated-witness ;
    vc:enables ngm:bit-vm,
        ngm:mu-sig-2,
        ngm:point-time-locked-contracts,
        ngm:taproot-assets ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:bip-342-tapscript,
        ngm:merkelised-abstract-syntax-tree,
        ngm:pay-to-taproot,
        ngm:schnorr-signatures ;
    vc:implements ngm:bitcoin-proof-of-work-protocol-improvement-proposals ;
    vc:isPartOf ngm:bitcoin-proof-of-work-protocol-technical-overview ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:bitcoin-proof-of-work-protocol,
        ngm:bitcoin-proof-of-work-protocol-network,
        ngm:bitcoin-script,
        ngm:multi-signature,
        ngm:smart-contracts ;
    vc:requires ngm:elliptic-curve-cryptography,
        ngm:merkle-tree,
        ngm:soft-fork ;
    vc:slug "taproot" ;
    vc:sourceDomain "blockchain" ;
    vc:standardizedBy ngm:bitcoin-proof-of-work-protocol-improvement-proposals ;
    vc:supports ngm:lightning-network,
        ngm:signature-aggregation,
        ngm:transaction-privacy ;
    vc:uses ngm:cryptographic-primitive,
        ngm:cryptographic-signature,
        ngm:hash-function,
        ngm:secp256k1 .

ngm:yield-farming a owl:Class ;
    rdfs:label "Yield Farming"@en ;
    rdfs:comment "Yield farming is the practice of actively deploying digital assets into decentralised finance protocols—including liquidity pools, lending markets, and staking contracts—to earn token rewards, trading fees, or interest income, and optimising risk-adjusted returns by dynamically reallocating capital across multiple protocols. Participants typically receive liquidity provider (LP) tokens representing their proportional pool share, which can themselves be staked or deposited into yield aggregator contracts to compound rewards, creating layered risk and return exposure. The practice emerged prominently during the 2020 DeFi Summer as protocols adopted token-emission incentive models to bootstrap liquidity and governance participation. Yield farming strategies are sensitive to smart contract risk, impermanent loss, reward token price volatility, oracle manipulation, and evolving regulatory classification of token distributions."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:liquidity-provision ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:staking ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:liquidity-pool ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:smart-contract ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptocurrency-wallet ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:liquidity-mining ],
        ngm:decentralised-finance ;
    vc:bridgesTo ngm:algorithmic-trading,
        ngm:risk-management ;
    vc:contrastsWith ngm:centralised-finance,
        ngm:mining ;
    vc:dependsOn ngm:decentralised-exchange,
        ngm:lending-protocol,
        ngm:oracle ;
    vc:enables ngm:passive-income,
        ngm:protocol-governance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:liquidity-mining,
        ngm:liquidity-provision,
        ngm:staking ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:annual-percentage-yield,
        ngm:flash-loan,
        ngm:impermanent-loss,
        ngm:total-value-locked ;
    vc:requires ngm:cryptocurrency-wallet,
        ngm:liquidity-pool,
        ngm:smart-contract ;
    vc:slug "yield-farming" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:automated-market-maker,
        ngm:governance-token,
        ngm:token-emission,
        ngm:yield-aggregator .

