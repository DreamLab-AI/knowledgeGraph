    vc:slug "virtual-reality-applications" ;
    vc:sourceDomain "spatial-computing" .

ngm:virtual-reality-vr a owl:Class ;
    rdfs:label "Virtual Reality (VR)"@en ;
    rdfs:comment "Immersive technology system that combines physical head-mounted display hardware with virtual computer-generated 3D environments to create fully encompassing sensory experiences that replace user perception of the physical world."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:vr-controllers ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:head-mounted-display ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:vr-rendering-engine ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:6-do-f-tracking ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:spatial-audio-system ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:spatial-computing ],
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:enables ngm:immersive-gaming,
        ngm:virtual-presence,
        ngm:virtual-tourism,
        ngm:virtual-training ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:head-mounted-display,
        ngm:spatial-audio-system,
        ngm:tracking-sensors,
