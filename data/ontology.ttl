ngm:sub-millisecond-latency a owl:Class ;
    rdfs:label "Sub-Millisecond Latency"@en ;
    rdfs:comment "Sub-Millisecond Latency is a network performance characteristic in which end-to-end transaction confirmation or consensus completion occurs in under one millisecond, enabling near-real-time settlement on blockchain networks. It depends on highly optimised peer-to-peer propagation, deterministic finality mechanisms, and minimal block time, distinguishing high-performance chains from conventional systems with multi-second confirmation times."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:deterministic-finality ],
        [ a owl:Restriction ;
