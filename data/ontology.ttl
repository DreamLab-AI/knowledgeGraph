        ngm:ai-agent-system,
        ngm:llm-application-framework ;
    vc:bridgesTo ngm:ai-infrastructure ;
    vc:enables ngm:multi-step-reasoning,
        ngm:retrieval-augmented-generation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:lang-graph ;
    vc:implements ngm:model-context-protocol,
