        ngm:distributed-ledger-technology,
        ngm:knowledge-graph .

ngm:cap-theorem a owl:Class ;
    rdfs:label "CAP Theorem"@en ;
    rdfs:comment "The CAP Theorem states that a distributed data store cannot simultaneously guarantee all three of consistency, availability and partition tolerance. When a network partition occurs and messages between nodes are lost or delayed, a system must choose between remaining available, by serving possibly stale data, and remaining consistent, by refusing requests it cannot safely satisfy. Formulated by Eric Brewer and later proved formally by Gilbert and Lynch, it frames a fundamental trade-off in distributed systems design."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:network-partition ],
        ngm:infra-computing-and-cloud ;
    skos:broader ngm:infra-computing-and-cloud ;
    vc:bridgesTo ngm:blockchain-consensus,
        ngm:federated-learning ;
    vc:contrastsWith ngm:acid-properties,
        ngm:base-properties ;
    vc:dependsOn ngm:consensus,
        ngm:replication ;
    vc:enables ngm:fault-tolerance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:partition-tolerance ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:eventual-consistency,
        ngm:linearizability,
        ngm:nosql-database,
        ngm:paxos,
        ngm:raft-consensus,
        ngm:strong-consistency,
        ngm:two-phase-commit ;
    vc:requires ngm:network-partition ;
    vc:slug "cap-theorem" ;
    vc:sourceDomain "distributed-systems" .

ngm:collision-avoidance a owl:Class ;
    rdfs:label "Collision Avoidance"@en ;
    rdfs:comment "Collision Avoidance - An active safety mechanism using Sensors (lidar, ultrasonic, vision) and path planning algorithms to detect obstacles and dynamically modify Robot Trajectories to prevent unintended contact with people, equipment, or structures."@en ;
