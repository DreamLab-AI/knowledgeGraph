    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:slug "knowledge-sharing" ;
    vc:sourceDomain "spatial-computing" .

ngm:label-smoothing a owl:Class ;
    rdfs:label "Label Smoothing"@en ;
    rdfs:comment "A regularisation technique that replaces hard one-hot labels with soft targets by allocating small probability mass to incorrect classes. Label smoothing prevents overconfident predictions and improves model calibration and generalisation."@en ;
    rdfs:subClassOf ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:contrastsWith ngm:overfitting ;
    vc:enables ngm:regularisation ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:relatedTo ngm:deep-learning ;
    vc:slug "label-smoothing" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:loss-function,
        ngm:training .

ngm:land-parcel a owl:Class ;
    rdfs:label "Land Parcel"@en ;
    rdfs:comment "Discrete units of virtual real estate within metaverse platforms, represented as NFTs that provide proof of ownership for programmable digital spaces where users can build, socialise, host events, and conduct commercial activities."@en ;
    rdfs:subClassOf ngm:sc-platform-and-environment,
        ngm:virtual-asset ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:enables ngm:metaverse-development ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:slug "land-parcel" ;
    vc:sourceDomain "spatial-computing" .

ngm:laser-scanner a owl:Class ;
    rdfs:label "Laser Scanner"@en ;
    rdfs:comment "A Laser Scanner is a sensor that emits laser pulses and measures the time-of-flight or phase-shift of the returned signal to compute precise distance measurements across a scene, generating dense point clouds. In robotics and spatial computing, laser scanners serve as primary perception instruments for environment mapping, obstacle detection, and the construction of digital twins via LiDAR-based SLAM pipelines."@en ;
    rdfs:subClassOf ngm:robo-perception ;
    skos:broader ngm:robo-perception ;
    vc:enables ngm:point-cloud,
        ngm:slam,
        ngm:spatial-mapping ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:relatedTo ngm:photogrammetry,
        ngm:sensor-fusion ;
    vc:slug "laser-scanner" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:lidar .

ngm:learning-algorithm a owl:Class ;
    rdfs:label "Learning Algorithm"@en ;
    rdfs:comment "LearningAlgorithm is a computational procedure that enables a model or agent to improve task performance through exposure to data or environmental interaction, encompassing the full spectrum of paradigms — supervised learning unsupervised learning (discovering latent structure in unlabelled data ..."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
