    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:slug "packet-compression" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:latency ;
    vc:uses ngm:data-compression,
        ngm:network-protocol .

