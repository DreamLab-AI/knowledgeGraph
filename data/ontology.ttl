ngm:image-segmentation a owl:Class ;
    rdfs:label "Image Segmentation"@en ;
    rdfs:comment "Image Segmentation is a foundational computer vision task that partitions a digital image into multiple discrete, semantically meaningful regions or segments, assigning each pixel (or group of pixels) a label that represents its category, instance identity, or both, enabling downstream systems to..."@en ;
    rdfs:subClassOf ngm:dense-prediction,
        ngm:structured-prediction ;
    vc:enables ngm:augmented-reality,
        ngm:autonomous-vehicles,
        ngm:medical-imaging,
        ngm:robotics,
        ngm:satellite-imagery-analysis,
        ngm:video-object-segmentation ;
    vc:hasPart ngm:atrous-convolution,
        ngm:attention-mechanism,
        ngm:encoder-decoder-architecture,
        ngm:feature-pyramid-network,
        ngm:mask-head,
        ngm:pixel-classifier,
        ngm:skip-connections ;
    vc:implements ngm:instance-segmentation,
        ngm:interactive-segmentation,
        ngm:panoptic-segmentation,
        ngm:semantic-segmentation,
        ngm:zero-shot-segmentation ;
    vc:maturity "established" ;
    vc:qualityScore "0.52"^^xsd:float ;
    vc:relatedTo ngm:3-d-reconstruction,
        ngm:foundation-models,
        ngm:keypoint-detection,
        ngm:multi-modal-learning,
        ngm:optical-flow ;
    vc:requires ngm:convolutional-neural-networks,
        ngm:evaluation-metrics,
        ngm:gpu-compute,
        ngm:labelled-training-data,
        ngm:loss-functions ;
    vc:slug "image-segmentation" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:standardizedBy ngm:ade20-k,
        ngm:cityscapes-dataset,
        ngm:coco-dataset,
        ngm:image-net,
        ngm:pascal-voc ;
    vc:supports ngm:autonomous-driving,
        ngm:background-removal,
        ngm:cancer-detection,
        ngm:remote-sensing,
        ngm:surgical-robotics ;
    vc:uses ngm:average-precision,
        ngm:cross-entropy-loss,
        ngm:dice-coefficient,
        ngm:mean-intersection-over-union,
        ngm:panoptic-quality .

