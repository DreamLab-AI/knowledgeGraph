        ngm:ip-adapter,
        ngm:style-transfer ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:generative-model,
        ngm:image-generation,
        ngm:inpainting,
        ngm:latent-diffusion,
        ngm:text-to-image ;
    vc:slug "stable-diffusion" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:attention-mechanism,
        ngm:cross-attention,
        ngm:transformer .

