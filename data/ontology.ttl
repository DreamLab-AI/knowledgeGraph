        ngm:rfc-8949 ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:asn1,
        ngm:data-format-standard,
        ngm:json-data-interchange-format,
        ngm:messagepack,
        ngm:protocol-buffer ;
    vc:requires ngm:internet-of-things,
        ngm:low-power-wide-area-network ;
    vc:slug "cbor" ;
    vc:sourceDomain "infrastructure" ;
