ngm:home-assistant a owl:Class ;
    rdfs:label "Home Assistant"@en ;
    rdfs:comment "Home Assistant is a free and open-source home automation platform written in Python (backend) and TypeScript (frontend), enabling local-first integration and control of heterogeneous smart-home devices and services across protocols including Zigbee Protocol, Z-Wave Protocol,"@en ;
