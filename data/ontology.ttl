ngm:contrastive-learning a owl:Class ;
    rdfs:label "Contrastive Learning"@en ;
    rdfs:comment "A self-supervised representation learning approach that trains models by comparing positive pairs (semantically similar samples) against negative pairs (dissimilar samples), pushing similar embeddings closer and dissimilar ones apart in latent space, enabling powerful feature learning without explicit labels."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-augmentation ],
        ngm:self-supervised-learning ;
    vc:bridgesTo ngm:multimodal-foundation-model,
        ngm:spatial-computing ;
    vc:contrastsWith ngm:curriculum-learning,
        ngm:generative-adversarial-network,
        ngm:supervised-learning ;
    vc:enables ngm:embedding-model,
        ngm:feature-extraction,
        ngm:few-shot-learning,
        ngm:multimodal-ai-architecture-ai,
        ngm:transfer-learning,
        ngm:zero-shot-learning ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:infonce-loss,
        ngm:negative-pair,
        ngm:positive-pair,
        ngm:projection-head ;
    vc:implements ngm:clip,
        ngm:momentum-contrast,
        ngm:simclr ;
    vc:isPartOf ngm:representation-learning,
        ngm:self-supervised-learning ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:computer-vision,
        ngm:knowledge-distillation,
        ngm:natural-language-processing ;
    vc:requires ngm:data-augmentation,
        ngm:embedding-space,
        ngm:encoder-network ;
    vc:slug "contrastive-learning" ;
    vc:sourceDomain "machine-learning" ;
    vc:uses ngm:deep-learning,
        ngm:neural-network .

ngm:did-method a owl:Class ;
    rdfs:label "DID Method"@en ;
    rdfs:comment "A DID Method is a specification that defines how a particular type of Decentralised Identifier (DID) is created, resolved, updated, and deactivated, encoding the syntax rules and CRUD semantics for identifiers anchored to a specific verifiable data registry, ledger, or peer-to-peer network. Each method is identified by a unique method name embedded in the DID string (e.g. did:web, did:key, did:ion), and must provide a compliant DID Resolver that retrieves the corresponding DID Document containing public keys and service endpoints. DID Methods are standardised through the W3C DID Core specification and registered in the DIF DID Method Registry, enabling interoperable self-sovereign identity across heterogeneous systems. The diversity of methods reflects trade-offs between decentralisation guarantees, key management complexity, ledger dependency, and resolver performance."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:decentralized-identifier ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:did-document ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:verifiable-data-registry ],
        ngm:decentralized-identity ;
    vc:bridgesTo ngm:ipfs,
        ngm:smart-contract ;
    vc:contrastsWith ngm:centralised-identity-provider,
        ngm:oauth,
        ngm:x-509-certificate ;
    vc:enables ngm:decentralised-authentication,
        ngm:digital-identity,
        ngm:self-sovereign-identity,
        ngm:verifiable-credentials ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:did-resolution-protocol,
        ngm:w3c-did-core ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:decentralized-identity,
        ngm:did-resolver,
        ngm:identity-wallet,
        ngm:zero-knowledge-proof ;
    vc:requires ngm:decentralized-identifier,
        ngm:did-document,
        ngm:public-key-infrastructure,
        ngm:verifiable-data-registry ;
    vc:slug "did-method" ;
    vc:sourceDomain "security" ;
    vc:standardizedBy ngm:decentralized-identity-foundation,
        ngm:w3c ;
    vc:uses ngm:content-addressing,
        ngm:cryptographic-key-pair,
        ngm:distributed-ledger-technology .

ngm:differentiable-rendering a owl:Class ;
    rdfs:label "Differentiable Rendering"@en ;
    rdfs:comment "Differentiable rendering is a class of algorithms that reformulate the image-formation pipeline so that pixel values are differentiable with respect to scene parameters — including geometry, surface materials, lighting, and camera pose. By enabling backpropagation through the rendering process, these methods support gradient-based optimisation for inverse rendering, scene reconstruction from 2D observations, and end-to-end training of 3D-aware neural models. The field bridges classical computer graphics with deep learning, treating rendering as a learnable, differentiable module within a larger neural architecture."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:deep-learning-framework ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:automatic-differentiation ],
        ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:bridgesTo ngm:augmented-reality,
        ngm:autonomous-driving,
        ngm:digital-twin ;
    vc:contrastsWith ngm:classical-rendering,
        ngm:non-differentiable-simulation ;
    vc:enables ngm:3-d-generative-model,
        ngm:3-d-reconstruction,
        ngm:inverse-rendering,
        ngm:neural-radiance-field,
        ngm:object-pose-estimation ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:implements ngm:physically-based-rendering,
        ngm:volumetric-rendering ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:bidirectional-reflectance-distribution-function,
        ngm:computer-vision,
        ngm:gaussian-splatting,
        ngm:implicit-neural-representation,
        ngm:neural-scene-representation ;
    vc:requires ngm:automatic-differentiation,
        ngm:deep-learning-framework ;
    vc:slug "differentiable-rendering" ;
    vc:sourceDomain "machine-learning" ;
    vc:uses ngm:backpropagation,
        ngm:gradient-descent,
        ngm:monte-carlo-integration,
        ngm:rasterisation,
        ngm:ray-tracing .

ngm:digital-content-creation a owl:Class ;
    rdfs:label "Digital Content Creation"@en ;
    rdfs:comment "The process of authoring, editing, and producing digital assets—including 3D models, textures, audio, video, and interactive experiences—using software toolchains. In spatial computing and metaverse contexts, digital content creation encompasses generative AI assistance, physically-based material authoring, and export pipelines targeting real-time rendering engines."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:digital-asset-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:content-delivery-network ],
