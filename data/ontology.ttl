ngm:etsi-domain-ai a owl:Class ;
    rdfs:label "ETSI Domain AI"@en ;
    rdfs:comment "Domain marker concept for categorising metaverse components related to artificial intelligence, machine learning, and computational intelligence capabilities."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:etsi-domain-ai-creative-media ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:etsi-domain-ai-data-mgmt ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:etsi-domain-ai-human-interface ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:etsi-domain-ai-governance ],
        ngm:ai-research-area ;
    skos:broader ngm:ai-research-area ;
    vc:enables ngm:ai-service-classification,
        ngm:intelligence-layer-categorization ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:etsi-domain-ai-creative-media,
        ngm:etsi-domain-ai-data-mgmt,
        ngm:etsi-domain-ai-governance,
        ngm:etsi-domain-ai-human-interface ;
    vc:isPartOf ngm:etsi-domain-taxonomy ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:slug "etsi-domain-ai" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:etsi-domain-application-health a owl:Class ;
    rdfs:label "ETSI Domain Application + Health"@en ;
    rdfs:comment "Cross-domain marker for metaverse application components focused on healthcare and wellness including telemedicine platforms, medical training simulations, therapeutic VR applications, and health monitoring systems."@en ;
    rdfs:subClassOf ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:enables ngm:healthcare-application-classification,
        ngm:medical-platform-categorization ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:etsi-domain-taxonomy ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:slug "etsi-domain-application-health" ;
    vc:sourceDomain "spatial-computing" .

ngm:etsi-domain-application-tourism a owl:Class ;
    rdfs:label "ETSI Domain Application + Tourism"@en ;
    rdfs:comment "Cross-domain marker for metaverse application components focused on tourism and hospitality including virtual tours, destination previews, cultural heritage experiences, and travel planning platforms in immersive environments."@en ;
    rdfs:subClassOf ngm:etsi-metaverse-domain-taxonomy,
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:enables ngm:cultural-experience-categorization,
        ngm:tourism-application-classification ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:etsi-domain-taxonomy ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:slug "etsi-domain-application-tourism" ;
    vc:sourceDomain "spatial-computing" .

ngm:etsi-domain-data-management-cultural-heritage a owl:Class ;
    rdfs:label "ETSI Domain: Data Management + Cultural Heritage"@en ;
    rdfs:comment "Crossover domain for ETSI metaverse categorisation addressing data preservation and management systems for cultural heritage digitisation, archival, and accessibility."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:access-control ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:digital-archive ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-management ],
        ngm:infra-data-management ;
    skos:broader ngm:infra-data-management ;
    vc:enables ngm:educational-outreach,
        ngm:knowledge-graph-publication-classifier-access,
        ngm:long-term-preservation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:access-control,
        ngm:digital-archive,
        ngm:heritage-database,
        ngm:preservation-system ;
    vc:isPartOf ngm:etsi-metaverse-domain-taxonomy ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:cultural-heritage-digitization,
        ngm:data-management ;
    vc:slug "etsi-domain-data-management-cultural-heritage" ;
    vc:sourceDomain "infrastructure" .

ngm:etsi-domain-ethics-and-law a owl:Class ;
    rdfs:label "ETSI Domain: Ethics & Law"@en ;
    rdfs:comment "Domain marker for ETSI metaverse categorisation covering ical frameworks, legal compliance, regulatory requirements, and responsible governance structures for virtual environments."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:ethical-framework ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:policy-enforcement ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:compliance-monitoring ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:legal-compliance ],
        ngm:ai-governance-and-ethics ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:enables ngm:legal-accountability,
        ngm:responsible-ai,
        ngm:user-protection ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:ethical-framework,
        ngm:legal-compliance,
        ngm:regulatory-systems,
        ngm:rights-management ;
    vc:isPartOf ngm:etsi-metaverse-domain-taxonomy ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:compliance-monitoring,
        ngm:policy-enforcement ;
    vc:slug "etsi-domain-ethics-and-law" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:etsi-domain-human-interface a owl:Class ;
    rdfs:label "ETSI_Domain_Human_Interface"@en ;
    rdfs:comment "An ETSI governance domain addressing user interaction design, accessibility, and human-computer interfaces within virtual environments. It defines standards for gesture, voice, gaze, and biometric input modalities, ensuring metaverse platforms prioritise usable and accessible experiences through alignment with ISO 9241 ergonomics standards, ETSI GR ARF 007/010, and inclusive design principles."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:virtual-environment ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:telecollaboration ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:accessibility-standards ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:etsi-domain-human-interface-ux ],
        ngm:sc-interaction ;
    skos:broader ngm:sc-interaction ;
    vc:enables ngm:accessibility,
        ngm:immersive-interface ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:accessibility-standards,
        ngm:etsi-domain-human-interface-ux ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:etsidomain-classification ;
    vc:requires ngm:telecollaboration,
        ngm:virtual-environment ;
    vc:slug "etsi-domain-human-interface" ;
    vc:sourceDomain "spatial-computing" .

ngm:etsi-domain-immersive-experiences a owl:Class ;
    rdfs:label "ETSI_Domain_Immersive_Experiences"@en ;
    rdfs:comment "An ETSI standardisation domain encompassing technologies, frameworks, and practices for creating immersive digital experiences including Virtual Reality, Augmented Reality, Extended Reality, and Spatial Computing. Governed by ETSI GR CIM 052 and GR ARF 020, this domain addresses content rendering, real-time interaction, sensory feedback, and environmental simulation to deliver seamless, engaging immersive experiences across heterogeneous hardware from HMDs to mobile AR."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:spatial-computing ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:augmented-reality ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:virtual-reality ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:mixed-reality ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:real-time-rendering ],
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:augmented-reality,
        ngm:mixed-reality,
        ngm:virtual-reality ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:simulation ;
    vc:requires ngm:real-time-rendering,
        ngm:spatial-computing ;
    vc:slug "etsi-domain-immersive-experiences" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:computer-vision .

ngm:etsi-domain-immersive-reality-capture-crossover a owl:Class ;
    rdfs:label "ETSI Domain Immersive + Reality Capture Crossover"@en ;
    rdfs:comment "Domain categorization marker indicating metaverse systems operating at the intersection of immersive interaction capabilities and reality capture technologies for photorealistic virtual environment creation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:etsi-domain-immersive ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:etsi-domain-reality-capture ],
        ngm:etsi-metaverse-domain-model,
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:enables ngm:photorealistic-immersion,
        ngm:spatial-interaction,
        ngm:volumetric-capture ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:etsi-metaverse-domain-model ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:etsi-domain-immersive,
        ngm:etsi-domain-reality-capture ;
    vc:slug "etsi-domain-immersive-reality-capture-crossover" ;
    vc:sourceDomain "spatial-computing" .

ngm:etsi-domain-infrastructure-data a owl:Class ;
    rdfs:label "ETSI_Domain_Infrastructure_Data"@en ;
    rdfs:comment "The ETSI Infrastructure Data domain is the foundational technical and architectural framework enabling trustworthy, sovereign data exchange within metaverse and digital ecosystems through decentralised data spaces, spatial intelligence integration, and policy-driven governance standards. It operationalises Trustworthy Data Spaces via NGSI-LD APIs, Federated Catalogs, Policy Enforcement Points, and F5G backbone connectivity to address data sovereignty, security, and real-to-virtual integration across distributed networks."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:data-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-governance ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:storage-layer ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:verifiable-credentials ],
        ngm:infra-data-management ;
    skos:broader ngm:infra-data-management ;
    vc:enables ngm:distributed-ledger-technology-dlt,
        ngm:edge-computing ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:data-management,
        ngm:storage-layer ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:etsi-domain-data-management,
        ngm:etsi-domain-infrastructure ;
    vc:requires ngm:data-governance,
        ngm:verifiable-credentials ;
    vc:slug "etsi-domain-infrastructure-data" ;
    vc:sourceDomain "infrastructure" .

ngm:etsi-domain-interoperability a owl:Class ;
    rdfs:label "ETSI_Domain_Interoperability"@en ;
    rdfs:comment "ETSI domain consolidating standards enabling different systems and organisations to work together effectively through technical and semantic data exchange mechanisms, shared vocabularies such as NGSI-LD and SAREF, and standardised protocols. It covers avatar interoperability, digital twin synchronisation, state synchronisation, and portability of digital assets across metaverse platforms."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:portability ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:state-synchronization ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:digital-twin-interop-protocol ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:avatar-interoperability ],
        ngm:infra-network-and-comms ;
    skos:broader ngm:infra-network-and-comms ;
    vc:enables ngm:discovery-layer,
        ngm:interoperability ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:avatar-interoperability,
        ngm:digital-twin-interop-protocol,
        ngm:portability,
        ngm:state-synchronization ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:slug "etsi-domain-interoperability" ;
    vc:sourceDomain "infrastructure" ;
    vc:standardizedBy ngm:api-standard,
        ngm:interoperability-framework .

