        ngm:system-architecture ;
    vc:slug "user-interface-architecture" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:immersive-experience,
        ngm:metaverse ;
    vc:uses ngm:eye-tracking,
        ngm:hand-tracking,
        ngm:haptic-feedback .

ngm:user-navigation a owl:Class ;
    rdfs:label "User Navigation"@en ;
    rdfs:comment "User navigation is the set of interaction techniques and interface affordances that let people move through and orient themselves within a digital or spatial environment, from menus and links to locomotion in 3D space. In immersive contexts it covers teleportation, smooth locomotion and wayfinding cues, while in 2D it covers information architecture and discovery flows. Effective navigation reduces cognitive load and supports search and content discovery."@en ;
    rdfs:subClassOf ngm:sc-interaction ;
    skos:broader ngm:sc-interaction ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:3-d-user-interface,
        ngm:search-discovery ;
    vc:slug "user-navigation" ;
    vc:sourceDomain "metaverse" .

ngm:user-trust a owl:Class ;
    rdfs:label "User Trust"@en ;
    rdfs:comment "User trust is the confidence individuals place in a system to handle their data, decisions and interactions reliably, securely and in their interests. It is built through transparency, predictable behaviour, privacy safeguards and demonstrable accountability, and is a key outcome of privacy and data-protection practices. Eroded trust undermines adoption, while sustained trust is a competitive and ethical asset."@en ;
    rdfs:subClassOf ngm:ai-governance-and-ethics ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:data-protection,
        ngm:privacy-impact-assessment-pia ;
    vc:slug "user-trust" ;
    vc:sourceDomain "governance" .

ngm:value a owl:Class ;
    rdfs:label "Value"@en ;
    rdfs:comment "In the AI domain, a principle, preference, or objective that guides the behaviour and optimisation targets of an intelligent system. Values encode what outcomes a system should pursue or avoid, underpinning alignment research, reward function design, and ethical AI. They range from measurable utility metrics to abstract normative principles such as fairness, human dignity, and autonomy."@en ;
    rdfs:subClassOf ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:enables ngm:ai-fairness,
        ngm:ai-governance,
        ngm:ai-safety ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:ai-alignment,
        ngm:ai-ethics,
        ngm:democratic-values,
        ngm:human-centred-values,
        ngm:value-alignment ;
    vc:slug "value" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:human-preference,
        ngm:preference-learning,
        ngm:reward-function .

ngm:variable-impedance-control a owl:Class ;
    rdfs:label "Variable Impedance Control"@en ;
    rdfs:comment "Variable Impedance Control is a robot control strategy that modulates stiffness, damping, and inertia parameters online during task execution, adapting mechanical impedance in response to sensed interaction forces, task phase, or environmental uncertainty rather than maintaining fixed impedance. This contrasts with conventional impedance control, which prescribes constant mechanical properties, by enabling robots to behave compliantly during contact-rich or uncertain phases and rigidly during free-space precision movements. Key implementations include learning-based approaches that infer optimal impedance trajectories from demonstrations, model predictive formulations that optimise impedance over a receding horizon, and biomimetic strategies that replicate the variable stiffness observed in human neuromuscular systems to achieve safe, dexterous physical interaction."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:sensor ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:force-control ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:torque ],
        ngm:impedance-control,
        ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:enables ngm:collaborative-robot,
        ngm:human-robot-interaction,
        ngm:safety ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:control-theory,
        ngm:embodied-ai,
        ngm:lower-limb-exoskeleton,
        ngm:motion-planning ;
    vc:requires ngm:force-control,
        ngm:sensor,
        ngm:torque ;
    vc:slug "variable-impedance-control" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:adaptive-control,
        ngm:model-predictive-control,
        ngm:reinforcement-learning .

ngm:variable-stiffness-actuator a owl:Class ;
    rdfs:label "Variable Stiffness Actuator"@en ;
    rdfs:comment "A variable stiffness actuator (VSA) is a compliant robotic actuator whose mechanical stiffness can be adjusted independently of its position, typically using antagonistic springs or adjustable elastic elements. This adjustable compliance lets robots store and release energy, absorb impacts and interact safely with humans and uncertain environments. VSAs are central to safe, energy-efficient force control in physical human-robot interaction."@en ;
    rdfs:subClassOf ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:force-control,
        ngm:pneumatic-actuator ;
    vc:slug "variable-stiffness-actuator" ;
    vc:sourceDomain "robotics" .

ngm:variational-autoencoder a owl:Class ;
    rdfs:label "Variational Autoencoder"@en ;
    rdfs:comment "A generative model that pairs an encoder mapping inputs to a probability distribution over a latent space with a decoder that reconstructs inputs, trained to maximise a variational lower bound on the data likelihood."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:backpropagation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:variational-inference ],
        ngm:autoencoder ;
    vc:enables ngm:image-generation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:backpropagation,
        ngm:variational-inference ;
    vc:slug "variational-autoencoder" ;
    vc:sourceDomain "deep-learning" .

ngm:ve-chain a owl:Class ;
    rdfs:label "VeChain"@en ;
    rdfs:comment "VeChain is a public blockchain platform oriented toward supply-chain management and enterprise applications. It uses a proof-of-authority consensus model in which a limited set of authorised validators produce blocks, prioritising throughput and predictability for business use. The platform employs a dual-token design, separating the asset used to hold value from the token used to pay for transaction costs."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:proof-of-authority ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:smart-contract ],
        ngm:blockchain-domain ;
    vc:enables ngm:product-provenance,
        ngm:supply-chain-tracking ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:proof-of-authority,
        ngm:smart-contract ;
    vc:slug "ve-chain" ;
    vc:sourceDomain "vechain" .

ngm:verra-vcs-methodology a owl:Class ;
    rdfs:label "Verra VCS Methodology"@en ;
    rdfs:comment "A Verra VCS methodology is an approved technical protocol under Verra's Verified Carbon Standard that specifies how a particular project type must quantify, monitor and report greenhouse-gas emission reductions or removals. Each methodology defines baselines, additionality tests, measurement procedures and monitoring requirements so that issued Verified Carbon Units are credible and comparable. It is the rule set against which carbon-credit projects are validated and verified."@en ;
    rdfs:subClassOf ngm:technical-standard ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:carbon-credit-tracking,
        ngm:green-blockchain-initiatives ;
    vc:slug "verra-vcs-methodology" ;
    vc:sourceDomain "governance" .

ngm:video-production-pipeline a owl:Class ;
    rdfs:label "Video Production Pipeline"@en ;
    rdfs:comment "A video production pipeline is the end-to-end sequence of stages through which video content moves from capture or generation through editing, effects, colour, restoration and final delivery. Increasingly it incorporates AI stages such as upscaling, denoising and restoration alongside traditional editorial and compositing steps. The pipeline coordinates assets, tools and review across teams to produce polished output efficiently."@en ;
    rdfs:subClassOf ngm:ai-application ;
    skos:broader ngm:ai-application ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:content-creation-pipeline,
        ngm:image-and-video-restoration ;
    vc:slug "video-production-pipeline" ;
    vc:sourceDomain "ai" .

ngm:virtual-asset-trading a owl:Class ;
    rdfs:label "Virtual Asset Trading"@en ;
    rdfs:comment "The exchange, purchase, and sale of digital assets — including cryptocurrencies, NFTs, virtual land parcels, in-game items, and other tokenised value — through centralised exchanges, decentralised exchanges (DEXs), NFT marketplaces, and peer-to-peer transactions. Trading is governed by AML/KYC requirements, FATF Travel Rule obligations, and emerging securities classification frameworks that vary by jurisdiction."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:blockchain ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:smart-contract ],
        ngm:sc-platform-and-environment,
        ngm:virtual-economy ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:dependsOn ngm:aml-kyc-compliance,
        ngm:digital-asset ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:virtual-economy-infrastructure ;
    vc:requires ngm:blockchain,
        ngm:smart-contract ;
    vc:slug "virtual-asset-trading" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:decentralized-exchange,
        ngm:nft,
        ngm:nft-marketplace .

ngm:virtual-commissioning a owl:Class ;
    rdfs:label "Virtual Commissioning"@en ;
    rdfs:comment "The simulation and testing of manufacturing systems in a virtual environment before physical implementation, using digital twins and real-time simulation to validate control algorithms, robot motion, and process sequences, reducing commissioning time and costs during development."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:digital-twin ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:simulation ],
        ngm:digital-twin,
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:enables ngm:cyber-physical-systems,
        ngm:industrial-automation ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:relatedTo ngm:embedded-systems ;
    vc:requires ngm:digital-twin,
        ngm:simulation ;
    vc:slug "virtual-commissioning" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:control-system,
        ngm:simulation-software .

ngm:virtual-economy-domain a owl:Class ;
    rdfs:label "Virtual Economy Domain"@en ;
    rdfs:comment "The conceptual and technical framework encompassing all economic activities within metaverse environments, including NFT marketplaces, virtual real estate trading, digital goods commerce, cryptocurrency transactions, and tokenised asset exchanges that operate through blockchain-verified ownership and smart contract automation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:nft-marketplace ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:creator-economy ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:smart-contract ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:blockchain ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:virtual-currency ],
        ngm:digital-economy,
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:enables ngm:digital-marketplace,
        ngm:play-to-earn-p2-e ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:creator-economy,
        ngm:nft-marketplace,
        ngm:virtual-currency ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires ngm:blockchain,
        ngm:smart-contract ;
    vc:slug "virtual-economy-domain" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:cryptocurrency,
        ngm:tokenization .

ngm:virtual-environment-specification a owl:Class ;
    rdfs:label "Virtual Environment Specification"@en ;
    rdfs:comment "Technical standards and requirements documents that define the parameters, capabilities, and constraints of virtual environments, including rendering requirements, interaction models, physics simulation rules, and interoperability protocols."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:interoperability ],
        ngm:sc-platform-and-environment,
        ngm:technical-standards ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:enables ngm:asset-portability,
        ngm:metaverse ;
    vc:hasMaturity ngmi:maturity-emerging ;
