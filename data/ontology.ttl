# Real Time Digital Twin Synchronization
mv:RealTimeDigitalTwinSynchronization a owl:Class ;
    rdfs:subClassOf mv:DigitalTwinTechnology ;
    rdfs:label "Real Time Digital Twin Synchronization"@en ;
