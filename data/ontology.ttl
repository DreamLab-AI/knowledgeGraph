        ngm:f1-score ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:ai-monitoring,
        ngm:fairness,
        ngm:robustness ;
    vc:requires ngm:benchmark-standard,
        ngm:model-training ;
    vc:slug "model-performance" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:motion-tracking a owl:Class ;
    rdfs:label "Motion Tracking"@en ;
    rdfs:comment "Motion tracking is a technology that captures and records the movement of objects, bodies, or body parts in physical space, translating this data into digital representations for use in VR/AR systems, animation, and metaverse applications."@en ;
    rdfs:subClassOf ngm:robo-perception,
        ngm:xr-input-technologies ;
