vf:accessible-design a owl:Class ;
    rdfs:label "Accessible Design"@en ;
    rdfs:comment "Accessible Design is the practice of creating virtual environments and interactions usable by people with diverse disabilities, incorporating universal design principles from conception through implementation. It integrates [[Accessibility Standard]]s, [[Accessible Experience]] philosophy, and inclusive [[3D User Interface]] design ensuring equitable [[Metaverse]] participation across visual, auditory, motor, and cognitive access dimensions."@en ;
    rdfs:subClassOf <urn:visionflow:linked:inclusive-design>,
        <urn:visionflow:linked:universal-design> ;
    vc:authorityScore "0.0"^^xsd:float ;
    vc:enables <urn:visionflow:linked:broader-user-base>,
        <urn:visionflow:linked:inclusive-participation>,
        vf:regulatory-compliance ;
    vc:maturity "draft" ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires <urn:visionflow:linked:assistive-technology-integration>,
