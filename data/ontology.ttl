# Electric Motor
robotics:ElectricMotor rdf:type owl:Class ;
    rdfs:subClassOf robotics:ElectricActuator ;
    rdfs:subClassOf robotics:RotatingMachinery ;
    rdfs:label "Electric Motor"@en ;
    rdfs:comment "Electric motor converts electrical energy into rotational mechanical power through electromagnetic forces, forming the most widespread actuation technology in modern robotics. Motors operate across a spectrum of designs—from simple brush DC motors to complex brushless variants and AC induction motors—each offering different efficiency, control characteristics, and power-to-weight performance trade-offs suitable for varied robotic applications."@en ;
    skos:prefLabel "Electric Motor"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:robotics:electric-motor" ;
    owl:sameAs <urn:visionclaw:concept:robotics:electric-motor> ;
