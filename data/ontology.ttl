ngm:tensor-flow-lite a owl:Class ;
    rdfs:label "TensorFlow Lite"@en ;
    rdfs:comment "TensorFlow Lite (now rebranded as LiteRT) is Google's open-source deep learning inference framework designed for on-device execution of machine learning models on mobile, embedded, and IoT edge hardware. It converts full TensorFlow or ONNX models into a FlatBuffers-based .tflite format and provides a lightweight interpreter that minimises memory footprint and latency without requiring network connectivity. The framework supports post-training optimisation techniques including quantisation, pruning, and weight clustering, and exposes hardware-acceleration delegates for GPUs, DSPs, NPUs, and the Coral Edge TPU. Its sister project TensorFlow Lite Micro (TFLite Micro) extends the same programming model to bare-metal microcontrollers with as little as 256 KB of RAM."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:deep-learning ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:machine-learning-discipline ],
        ngm:machine-learning-discipline-framework ;
    vc:bridgesTo ngm:augmented-reality,
        ngm:internet-of-things ;
    vc:contrastsWith ngm:core-ml,
        ngm:ncnn,
        ngm:onnx-runtime,
        ngm:pytorch-mobile ;
    vc:dependsOn ngm:edge-computing,
        ngm:mobile-computing ;
    vc:enables ngm:edge-inference,
        ngm:on-device-machine-learning,
        ngm:privacy-preserving-inference,
        ngm:real-time-inference ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:tensorflow-lite-micro,
        ngm:tflite-converter,
        ngm:tflite-interpreter ;
    vc:implements ngm:neural-network-inference,
        ngm:onnx ;
    vc:isPartOf ngm:tensorflow ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:federated-learning,
        ngm:model-compression,
        ngm:transfer-learning ;
    vc:requires ngm:deep-learning,
        ngm:machine-learning-discipline ;
