    vc:enables ngm:cross-chain-dex-aggregation,
        ngm:cross-chain-governance,
        ngm:cross-chain-messaging,
        ngm:omnichain-application ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:axl-token,
        ngm:gateway-smart-contract,
        ngm:interchain-token-service,
        ngm:squid-router ;
    vc:isPartOf ngm:cosmos-ecosystem ;
    vc:qualityScore "0.72"^^xsd:float ;
