ngm:autoregressive-decoding a owl:Class ;
    rdfs:label "Autoregressive Decoding"@en ;
    rdfs:comment "Autoregressive decoding is the process by which a sequence model, such as a transformer language model, generates output one token at a time, conditioning each new token on all previously generated tokens. At every step the model produces a probability distribution over the vocabulary, a token is selected by a chosen strategy, and the token is appended and fed back as input for the next step. It is the dominant generation paradigm for large language models and is the primary target of inference optimisations such as caching and speculative methods."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:sampling ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:transformer ],
        ngm:large-language-model ;
    vc:bridgesTo ngm:model-serving ;
    vc:contrastsWith ngm:beam-search ;
    vc:dependsOn ngm:attention-mechanism ;
    vc:enables ngm:large-language-model ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:sampling ;
    vc:implements ngm:sampling ;
    vc:isPartOf ngm:large-language-model ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:beam-search,
        ngm:speculative-decoding ;
    vc:requires ngm:transformer ;
    vc:slug "autoregressive-decoding" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:standardizedBy ngm:transformer ;
    vc:supports ngm:model-serving ;
    vc:uses ngm:kv-cache .

ngm:autoregressive-generation a owl:Class ;
    rdfs:label "Autoregressive Generation"@en ;
    rdfs:comment "Autoregressive generation is a sequence-modelling approach in which each output element is produced conditioned on all previously generated elements, factorising the joint probability of a sequence into a product of conditional next-element distributions. In language models it manifests as repeated next-token prediction, where the model samples or selects a token, appends it to the context, and repeats. This left-to-right dependency is the dominant decoding paradigm for large language models and underlies generative text, code, and other ordered outputs."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:decoder ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:token ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:inference ],
        ngm:generative-ai ;
    vc:bridgesTo ngm:attention-mechanism ;
    vc:dependsOn ngm:language-model ;
    vc:enables ngm:large-language-model ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:decoder,
        ngm:token ;
    vc:implements ngm:generative-ai ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:inference,
        ngm:large-language-model ;
    vc:requires ngm:inference ;
    vc:slug "autoregressive-generation" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:natural-language-generation,
        ngm:text-generation ;
    vc:uses ngm:beam-search,
        ngm:sampling,
        ngm:transformer .

ngm:av1-codec a owl:Class ;
    rdfs:label "AV1 Codec"@en ;
    rdfs:comment "AV1 is a royalty-free video coding format developed by the Alliance for Open Media to deliver high compression efficiency for streaming and real-time video. It typically achieves around 30 percent better compression than HEVC/VP9 at equivalent quality, making it well suited to bandwidth-constrained applications such as screen sharing and live video. Being open and licence-free, it is widely adopted across browsers, hardware decoders, and conferencing platforms."@en ;
    rdfs:subClassOf ngm:technical-standard ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:screen-sharing ;
    vc:slug "av1-codec" ;
    vc:sourceDomain "infrastructure" .

ngm:backdoor-attack a owl:Class ;
    rdfs:label "Backdoor Attack"@en ;
    rdfs:comment "A training-time adversarial attack that embeds a hidden trigger pattern into an AI model via data poisoning, causing the model to behave normally on standard inputs but produce attacker-chosen outputs when the trigger is present, creating a covert vulnerability that survives fine-tuning and is exploitable post-deployment."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ai-safety ],
        ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:contrastsWith ngm:adversarial-attack,
        ngm:adversarial-robustness ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:relatedTo ngm:model-robustness,
        ngm:privacy ;
    vc:requires ngm:ai-safety ;
    vc:slug "backdoor-attack" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:data-poisoning,
        ngm:machine-learning-discipline-model .

ngm:bayes-theorem a owl:Class ;
    rdfs:label "Bayes Theorem"@en ;
    rdfs:comment "Bayes' theorem is a fundamental result in probability theory that describes how to update the probability of a hypothesis in light of new evidence. It expresses the posterior probability as proportional to the product of the prior probability and the likelihood of the evidence, normalised by the total probability of the evidence. The theorem is the mathematical foundation of Bayesian inference and probabilistic reasoning in artificial intelligence."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:posterior-distribution ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:prior-distribution ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:likelihood-function ],
        ngm:probability-theory ;
    vc:bridgesTo ngm:bayesian-deep-learning,
        ngm:machine-learning,
        ngm:natural-language-processing ;
    vc:contrastsWith ngm:frequentist-statistics,
        ngm:maximum-likelihood-estimation ;
    vc:dependsOn ngm:conditional-probability,
        ngm:probabilistic-model,
        ngm:probability-theory ;
    vc:enables ngm:active-learning,
        ngm:bayesian-inference,
        ngm:bayesian-network,
        ngm:bayesian-optimisation,
        ngm:model-selection,
        ngm:naive-bayes-classifier,
        ngm:statistical-inference,
        ngm:uncertainty-quantification ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:likelihood-function,
        ngm:marginal-likelihood,
        ngm:posterior-distribution,
        ngm:prior-distribution ;
    vc:implements ngm:bayesian-inference ;
    vc:isPartOf ngm:probability-theory ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:artificial-intelligence,
        ngm:expectation-maximisation,
        ngm:markov-chain-monte-carlo,
        ngm:maximum-likelihood-estimation,
        ngm:statistical-inference,
        ngm:variational-inference ;
    vc:slug "bayes-theorem" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:decision-theory,
        ngm:inference,
        ngm:machine-learning,
        ngm:reasoning ;
    vc:uses ngm:conjugate-prior,
        ngm:probabilistic-model .

ngm:bbs-signature a owl:Class ;
    rdfs:label "BBS+ Signature"@en ;
    rdfs:comment "BBS+ Signature is a pairing-based digital signature scheme that signs a vector of messages simultaneously and supports the generation of zero-knowledge proofs that reveal only a chosen subset of those messages — a property known as selective disclosure — without revealing the full signed message set or enabling linkage of multiple presentations to the same credential. It is a cornerstone primitive for privacy-preserving verifiable credentials."@en ;
    rdfs:subClassOf ngm:cryptographic-signature ;
    vc:enables ngm:privacy-preserving-identity,
        ngm:selective-disclosure,
        ngm:verifiable-credentials ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:bls-signature,
        ngm:decentralized-identifiers ;
    vc:slug "bbs-signature" ;
    vc:sourceDomain "security" ;
    vc:uses ngm:cryptographic-primitive,
        ngm:cryptographic-proof .

ngm:bdi-model a owl:Class ;
    rdfs:label "BDI Model"@en ;
    rdfs:comment "A deliberative agent architecture grounded in Bratman's theory of practical reasoning, structuring agent cognition around Beliefs (knowledge about the world), Desires (motivational goals), and Intentions (committed plans), with a reasoning cycle of belief revision, deliberation, means-end reasoning, and intention reconsideration."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:goal ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
