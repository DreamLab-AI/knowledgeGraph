    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:robotics ;
    vc:uses ngm:decision-making,
        ngm:graph-search .

ngm:human-evaluation a owl:Class ;
    rdfs:label "Human Evaluation"@en ;
    rdfs:comment "Human evaluation is the assessment of machine-learning system outputs by human judges against quality criteria such as relevance, fluency, helpfulness, factuality, or preference between alternatives. It complements automatic metrics by capturing nuanced, subjective, and context-dependent judgements that proxy measures miss, and is central to evaluating generative and conversational models. It contrasts with automatic evaluation in cost, latency, and the need to manage rater agreement and bias."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:benchmarks ],
