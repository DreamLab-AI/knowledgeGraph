ngm:message-reactions a owl:Class ;
    rdfs:label "Message Reactions"@en ;
    rdfs:comment "Message reactions are lightweight emoji or icon-based acknowledgements that participants attach to individual messages without composing a reply. They convey sentiment, agreement, or status in a low-friction manner that reduces notification noise. In distributed teams, reactions serve as asynchronous micro-feedback signals that keep conversation threads concise."@en ;
