        ngm:smart-contract,
        ngm:snapshot,
        ngm:vote-delegation ;
    vc:slug "proposal-system" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:community-participation ;
    vc:uses ngm:multisig-wallet,
