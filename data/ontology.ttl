    vc:slug "system-architecture" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:trajectory-planning a owl:Class ;
    rdfs:label "Trajectory Planning"@en ;
    rdfs:comment "The process of computing a time-parameterised path for a robot or autonomous system that satisfies kinematic constraints, avoids obstacles, and achieves a target configuration smoothly and efficiently. Trajectory planning bridges high-level path planning with low-level motion control, incorporating velocity and acceleration profiles, inverse kinematics, and real-time replanning for dynamic environments."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:kinematics ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:inverse-kinematics ],
        ngm:robo-navigation-and-planning ;
    skos:broader ngm:robo-navigation-and-planning ;
    vc:dependsOn ngm:obstacle-avoidance ;
    vc:enables ngm:collision-avoidance,
        ngm:motion-control ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:requires ngm:inverse-kinematics,
        ngm:kinematics ;
    vc:slug "trajectory-planning" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:motion-planning,
        ngm:sensor-fusion .

ngm:transaction-finality a owl:Class ;
    rdfs:label "Transaction Finality"@en ;
    rdfs:comment "The point at which a blockchain transaction becomes irreversible and cannot be altered or removed, providing settlement certainty for participants. Finality types include probabilistic (increasing confidence with confirmations), deterministic (explicit protocol guarantee), and economic (cost to revert exceeds benefit)."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:probabilistic-finality ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:consensus-mechanism ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:deterministic-finality ],
        ngm:bc-protocol-and-consensus ;
    skos:broader ngm:bc-protocol-and-consensus ;
    vc:enables ngm:decentralized-finance-de-fi,
        ngm:smart-contract ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:deterministic-finality,
        ngm:probabilistic-finality ;
    vc:isPartOf ngm:blockchain ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:requires ngm:consensus-mechanism ;
    vc:slug "transaction-finality" ;
    vc:sourceDomain "blockchain" .

ngm:trusted-execution-environment a owl:Class ;
    rdfs:label "Trusted Execution Environment"@en ;
    rdfs:comment "A Trusted Execution Environment (TEE) is a hardware-enforced, isolated processing domain within a processor that guarantees confidentiality and integrity of code and data even if the host operating system or hypervisor is compromised. TEEs are instantiated via technologies such as Intel SGX, AMD SEV, and Arm TrustZone, each providing mechanisms for remote attestation so that a relying party can cryptographically verify the identity and integrity of the enclave before exchanging sensitive material. TEEs underpin confidential computing workloads including private AI inference, secure key management, and privacy-preserving data collaboration."@en ;
    rdfs:subClassOf ngm:infra-security-and-identity ;
    skos:broader ngm:infra-security-and-identity ;
    vc:enables ngm:cryptographic-key-management,
        ngm:privacy-enhancing-computation-pec ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:confidential-computing,
        ngm:secure-enclave ;
    vc:slug "trusted-execution-environment" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:hardware-security-module .

ngm:vulnerability a owl:Class ;
    rdfs:label "Vulnerability"@en ;
    rdfs:comment "A Vulnerability is a weakness, flaw, or inadequacy in a system's design, implementation, or configuration that can be exploited to violate security policies or compromise integrity. Vulnerabilities are classified by origin (design flaw, implementation bug, configuration error), severity (CVSS score), and CIA impact (confidentiality, integrity, availability), and are managed through scanning, patching, and compensating controls."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:risk-assessment ],
        ngm:bc-protocol-and-consensus ;
    skos:broader ngm:bc-protocol-and-consensus ;
    vc:contrastsWith ngm:security ;
    vc:dependsOn ngm:risk ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:relatedTo ngm:attack-vector,
        ngm:resilience,
        ngm:threat-actor ;
    vc:requires ngm:risk-assessment ;
    vc:slug "vulnerability" ;
    vc:sourceDomain "blockchain" .

ngm:automatic-speech-recognition a owl:Class ;
    rdfs:label "Automatic Speech Recognition"@en ;
    rdfs:comment "Automatic Speech Recognition (ASR) is the technology that transcribes spoken language into text by jointly modelling the acoustic signal — frame-level spectral features derived from the raw audio waveform — and linguistic context, using neural sequence-to-sequence models trained on large corpora of paired audio and transcripts. Modern ASR systems based on transformer and conformer architectures achieve near-human word error rates on clean speech, and have expanded to multilingual and low-resource settings through large-scale self-supervised pre-training on unlabelled audio. ASR is a foundational component of voice assistants, transcription services, accessibility tools, and spoken language understanding pipelines."@en ;
    rdfs:subClassOf ngm:dc-communication ;
    skos:broader ngm:dc-communication ;
    vc:enables ngm:natural-language-processing,
        ngm:voice-interaction ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:speaker-diarisation ;
    vc:slug "automatic-speech-recognition" ;
    vc:sourceDomain "distributed-collaboration" ;
    vc:uses ngm:deep-learning,
        ngm:language-modeling .

ngm:bias a owl:Class ;
    rdfs:label "Bias"@en ;
    rdfs:comment "Systematic deviation from fairness, objectivity, or expected outcomes in an AI system that leads to prejudiced results favouring or disfavouring particular groups, individuals, or outcomes, arising from data, algorithms, or deployment contexts."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:bias-detection-methods ],
        ngm:ai-governance-and-ethics ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:contrastsWith ngm:ai-fairness ;
    vc:enables ngm:bias-mitigation-techniques ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:accountability,
        ngm:ai-risks,
        ngm:bias-in-large-language-models,
        ngm:transparency ;
    vc:requires ngm:bias-detection-methods ;
    vc:slug "bias" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:bias-mitigation-techniques a owl:Class ;
    rdfs:label "Bias Mitigation Techniques"@en ;
    rdfs:comment "Methods and interventions designed to reduce algorithmic bias and improve fairness in AI systems through modifications at pre-processing (data reweighting, resampling), in-processing (fairness constraints, adversarial debiasing), and post-processing (threshold optimisation) stages of the machine learning pipeline. Each approach involves tradeoffs between fairness improvement and predictive accuracy."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-governance ],
        ngm:ai-governance-and-ethics ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:enables ngm:fairness-auditing-tools ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:ai-ethics,
        ngm:algorithmic-bias,
        ngm:fairness-accuracy-tradeoffs,
        ngm:fairness-constraints,
        ngm:fairness-metrics,
        ngm:responsible-ai ;
    vc:requires ngm:data-governance ;
    vc:slug "bias-mitigation-techniques" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:feature-engineering,
        ngm:machine-learning-pipeline .

ngm:cloud-native-applications a owl:Class ;
    rdfs:label "Cloud-Native Applications"@en ;
    rdfs:comment "Cloud-native applications are software systems specifically designed and architected to exploit the capabilities of cloud computing environments, built from loosely coupled microservices deployed via containers and orchestrated across private, public, or hybrid cloud infrastructure. They prioritise scalability, resilience, observability, and automated lifecycle management over the characteristics of traditional monolithic systems. The paradigm is distinguished not by where an application runs but by how it is constructed, operated, and evolved."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:api-gateway ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:microservices-architecture ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:serverless-architecture ],
        ngm:infra-computing-and-cloud ;
    skos:broader ngm:infra-computing-and-cloud ;
    vc:enables ngm:industry-cloud-platforms,
        ngm:platform-service ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:api-gateway,
        ngm:microservices-architecture,
        ngm:serverless-architecture ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:distributed-systems,
        ngm:infrastructure-architecture ;
    vc:slug "cloud-native-applications" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:cloud-infrastructure,
        ngm:edge-cloud-collaboration,
        ngm:platform-engineering .

ngm:collision-detection a owl:Class ;
    rdfs:label "Collision Detection"@en ;
    rdfs:comment "Collision Detection is the computational discipline of determining when two or more geometric primitives, rigid bodies, deformable meshes, articulated kinematic chains, or volumetric fields occupy overlapping regions of a shared spatial domain, decomposed canonically into a broad phase that rapid..."@en ;
