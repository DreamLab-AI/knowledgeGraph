ngm:hidden-hand a owl:Class ;
    rdfs:label "Hidden Hand"@en ;
    rdfs:comment "Hidden Hand is a governance incentive marketplace operated by Redacted Cartel that lets protocols offer rewards to direct gauge votes across multiple DeFi systems. It generalises the bribery market model beyond a single protocol."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
