@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

dc1:creator a owl:AnnotationProperty .

skos:broader a owl:AnnotationProperty .

ngm:1-inch a owl:Class ;
    rdfs:label "1inch"@en ;
    rdfs:comment "A decentralised exchange aggregator that routes trades across multiple liquidity sources to find favourable execution prices on Ethereum and other chains."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ethereum-smart-contract-platform ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:smart-contract ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:automated-market-maker ],
        ngm:decentralized-exchange ;
    vc:enables ngm:liquidity-pool ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:automated-market-maker,
        ngm:ethereum-smart-contract-platform,
        ngm:smart-contract ;
    vc:slug "1-inch" ;
    vc:sourceDomain "blockchain" .

ngm:3-d-and-4-d a owl:Class ;
    rdfs:label "3D and 4D"@en ;
    rdfs:comment "The domain of three-dimensional and four-dimensional content creation, covering tools, techniques, and AI-powered pipelines for generating, editing, and rendering 3D assets and temporally dynamic (4D) representations. Encompasses text-to-3D systems (NVIDIA Edify, Luma Genie, Point-E), neural radiance fields, Gaussian splatting, and diffusion-based mesh generation, as well as 6D pose estimation, scene-scale generation, and integration with AR/VR workflows."@en ;
    rdfs:subClassOf ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:enables ngm:3-d-asset,
        ngm:augmented-reality,
        ngm:pose-estimation ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:relatedTo ngm:computer-vision,
        ngm:machine-learning-discipline ;
    vc:slug "3-d-and-4-d" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:deep-learning,
        ngm:diffusion-model,
        ngm:generative-ai,
        ngm:neural-radiance-field .

ngm:aave-companies a owl:Class ;
    rdfs:label "Aave Companies"@en ;
    rdfs:comment "Aave Companies is the development company, founded by Stani Kulechov, behind the Aave decentralised lending protocol and related products. It was formerly known as ETHLend."@en ;
    rdfs:subClassOf ngm:aave ;
    vc:enables ngm:lending-protocol ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:slug "aave-companies" ;
    vc:sourceDomain "blockchain" .

ngm:access-controls a owl:Class ;
    rdfs:label "Access Controls"@en ;
    rdfs:comment "Access controls are mechanisms that govern which subjects may perform which operations on resources, enforcing authorisation policies."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:authentication ],
        ngm:authorisation ;
    vc:enables ngm:information-security ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:authentication ;
    vc:slug "access-controls" ;
    vc:sourceDomain "distributed-systems" .

ngm:accountable-party a owl:Class ;
    rdfs:label "Accountable Party"@en ;
    rdfs:comment "An Accountable Party is an individual, organisation, or role that bears defined responsibility for specific aspects of an AI system's development, deployment, operation, or outcomes, with corresponding obligations to ensure compliance with governance principles, regulatory requirements, and ethical standards. Accountability addresses the foundational question of who bears responsibility when AI systems cause harm or produce unfair outcomes, requiring that identifiable parties possess the authority, resources, and monitoring capacity commensurate with their obligations. Accountable parties span the AI value chain—from data providers and model developers to deploying organisations, system operators, and governance bodies—each with lifecycle-specific duties enforced through formal reporting structures and consequence mechanisms."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:compliance-framework ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:human-oversight ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:accountability ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:ai-ethics-board ],
        ngm:ai-governance-and-ethics,
        ngm:ai-governance-principle ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:enables ngm:ai-governance,
        ngm:compliance-monitoring,
        ngm:transparency ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:ai-ethics-board ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:ai-regulation,
        ngm:audit-trail,
        ngm:compliance-control,
        ngm:risk-assessment ;
    vc:requires ngm:accountability,
        ngm:compliance-framework,
        ngm:human-oversight ;
    vc:slug "accountable-party" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:standardizedBy ngm:ai-governance-framework ;
    vc:supports ngm:ai-governance-and-ethics,
        ngm:governance-framework .

ngm:active-r-d-funding-opportunities-register a owl:Class ;
    rdfs:label "Active R&D Funding Opportunities Register"@en ;
    rdfs:comment "A curated register of active and accessible funding opportunities for immersive technology, AI, and creative industries R&D, encompassing Innovate UK grants, UKRI programmes, ARIA challenges, Web3 venture capital, and academic grant schemes. The register tracks application status, eligibility constraints, match-funding requirements, and strategic alignment to accelerate project funding decisions."@en ;
    rdfs:subClassOf ngm:infra-software-engineering,
        ngm:resource-management ;
    skos:broader ngm:infra-software-engineering ;
    vc:enables ngm:ai-agent-system,
        ngm:immersive-technology ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:extended-reality,
        ngm:resource-management ;
    vc:slug "active-r-d-funding-opportunities-register" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:agentic-ai,
        ngm:knowledge-graph .

ngm:adr-008 a owl:Class ;
    rdfs:label "ADR-008"@en ;
    rdfs:comment "An architecture decision record numbered 008, documenting a specific architectural choice within a project together with its context, options considered, and consequences. ADRs form a chronological log of design decisions."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:software-architecture ],
        ngm:software-architecture ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:software-architecture ;
    vc:slug "adr-008" ;
    vc:sourceDomain "infrastructure" .

ngm:adr-012 a owl:Class ;
    rdfs:label "ADR-012"@en ;
    rdfs:comment "An architecture decision record numbered 012, capturing a particular architectural decision within a project alongside its context and consequences. It is part of a numbered sequence of design records."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:software-architecture ],
        ngm:software-architecture ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:software-architecture ;
    vc:slug "adr-012" ;
    vc:sourceDomain "infrastructure" .

ngm:agentic-ai-practitioner-training-programme a owl:Class ;
    rdfs:label "Agentic AI Practitioner Training Programme"@en ;
    rdfs:comment "A structured training programme introducing practitioners to agentic AI systems, covering context engineering, memory management, agent orchestration tools (such as Roo Code), and practical case studies in project management, data visualisation, and academic research through phased, multi-session instruction."@en ;
    rdfs:subClassOf ngm:ai-application ;
    skos:broader ngm:ai-application ;
    vc:enables ngm:agentic-ai,
        ngm:generative-ai ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:relatedTo ngm:agent-frameworks,
        ngm:generative-ai-development-methodology ;
    vc:slug "agentic-ai-practitioner-training-programme" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:ai-governance-and-ethics ;
    vc:uses ngm:ai-agent-system,
        ngm:large-language-models .

ngm:aggelos-kiayias a owl:Class ;
    rdfs:label "Aggelos Kiayias"@en ;
    rdfs:comment "A computer scientist and cryptographer known for research in cryptography and blockchain protocols, including provably secure proof-of-stake consensus."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptography ],
        ngm:cryptography ;
    vc:enables ngm:proof-of-stake ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:cryptography ;
    vc:slug "aggelos-kiayias" ;
    vc:sourceDomain "security" .

ngm:agreement-protocol a owl:Class ;
    rdfs:label "Agreement Protocol"@en ;
    rdfs:comment "An Agreement Protocol is a distributed protocol specifically designed to enable multiple independent nodes to reach consensus on a single value, decision, or sequence of events despite the presence of failures, network asynchrony, and potentially malicious participants. Agreement protocols must satisfy safety (all honest nodes agree on the same value), liveness (the protocol eventually terminates), and validity (the agreed value was proposed by some participant), and their design space is constrained by impossibility results such as the FLP theorem and Byzantine Agreement bounds."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:fault-tolerance ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:byzantine-fault-tolerance ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:consensus-mechanism ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:consensus-algorithm ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:distributed-systems ],
        ngm:bc-protocol-and-consensus,
        ngm:distributed-protocol ;
    skos:broader ngm:bc-protocol-and-consensus ;
    vc:enables ngm:blockchain-governance,
        ngm:blockchain-protocol,
        ngm:finality ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:consensus-algorithm,
        ngm:consensus-mechanism ;
    vc:implements ngm:nakamoto-consensus ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:blockchain-network,
        ngm:blockchain-scalability,
        ngm:node,
        ngm:validator-node ;
    vc:requires ngm:byzantine-fault-tolerance,
        ngm:distributed-systems,
        ngm:fault-tolerance ;
    vc:slug "agreement-protocol" ;
    vc:sourceDomain "blockchain" .

ngm:agricultural-robot a owl:Class ;
    rdfs:label "Agricultural Robot"@en ;
    rdfs:comment "Agricultural Robot - A semi-autonomous or fully autonomous platform equipped with Precision Agriculture Sensors, Manipulation Modules, and Crop Analysis Systems for performing field operations including planting, selective weeding, harvesting, and health monitoring whilst minimising s..."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:computer-vision ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:soft-robotics ],
        ngm:mobile-robot,
        ngm:robo-robot-type ;
    skos:broader ngm:robo-robot-type ;
    vc:enables ngm:crop-quality-improvement,
        ngm:environmental-sustainability,
        ngm:labour-cost-reduction ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:isPartOf ngm:precision-agriculture-system,
        ngm:sustainable-farming ;
    vc:qualityScore "0.53"^^xsd:float ;
    vc:requires ngm:computer-vision,
        ngm:environmental-sensors,
        ngm:soft-robotics,
        ngm:terrain-navigation ;
    vc:slug "agricultural-robot" ;
    vc:sourceDomain "robotics" .

ngm:ai-assisted-development-practice a owl:Class ;
    rdfs:label "AI-Assisted Development Practice"@en ;
    rdfs:comment "Vibe Coding is an AI-assisted software development practice in which developers direct large language models or AI coding tools (such as Cursor, Aider, or Copilot) with high-level intent rather than writing all code manually. The practitioner retains system-level design authority whilst delegating implementation of discrete, scoped tasks to the AI, requiring disciplined use of version control, structured context documents, and iterative refinement cycles."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:software-engineering ],
        ngm:infra-software-engineering,
        ngm:software-engineering ;
    skos:broader ngm:infra-software-engineering ;
    vc:enables ngm:user-experience ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:generative-ai-engineering ;
    vc:requires ngm:software-engineering ;
    vc:slug "ai-assisted-development-practice" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:generative-ai,
        ngm:machine-learning-discipline .

ngm:ai-benchmark-epistemological-critique a owl:Class ;
    rdfs:label "AI Benchmark Epistemological Critique"@en ;
    rdfs:comment "A critical epistemological lens applied to AI benchmark claims, model capability assessments, and statistical presentations that may mislead through selective metrics, dataset contamination, cherry-picked results, or hallucination. The page collects resources and reasoning for evaluating AI performance claims with rigour, highlighting how large language models can generate plausible but false outputs that resemble statistical truth."@en ;
    rdfs:subClassOf ngm:infra-software-engineering ;
    skos:broader ngm:infra-software-engineering ;
    vc:contrastsWith ngm:natural-language-processing ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:relatedTo ngm:ai-ethics,
        ngm:bias,
        ngm:large-language-models ;
    vc:slug "ai-benchmark-epistemological-critique" ;
    vc:sourceDomain "infrastructure" .

ngm:ai-capability-discontinuity-model a owl:Class ;
    rdfs:label "AI Capability Discontinuity Model"@en ;
    rdfs:comment "A conceptual framework positing that AI capability does not progress linearly but instead exhibits discontinuous threshold transitions—analogous to the mathematical step function—where accumulated incremental improvements trigger rapid, self-reinforcing shifts in capability order, akin to historical inflection points such as the Cambrian explosion or the printing press. The framework draws on self-organisation theory and feedback-loop dynamics to argue that AI represents the next major complexity transition in evolutionary and technological history."@en ;
    rdfs:subClassOf ngm:ai-research-area ;
    skos:broader ngm:ai-research-area ;
    vc:enables ngm:ai-safety,
        ngm:responsible-ai ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:relatedTo ngm:ai-alignment,
        ngm:artificial-intelligence,
        ngm:generative-ai ;
    vc:slug "ai-capability-discontinuity-model" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:ai-concept .

ngm:ai-capability-evidence-compendium a owl:Class ;
    rdfs:label "AI Capability Evidence Compendium"@en ;
    rdfs:comment "A curated reference document compiling empirical evidence countering common objections to AI capability and originality claims, aggregating benchmarks, research findings, and expert commentary demonstrating that large language models exhibit reasoning, world-model construction, and generalisation beyond stochastic pattern matching. Serves as an evidence base for constructive discourse on AI capabilities and their societal implications."@en ;
    rdfs:subClassOf ngm:ai-governance-and-ethics ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:enables ngm:ai-ethics,
        ngm:explainability ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:relatedTo ngm:ai-alignment,
        ngm:generative-ai,
        ngm:large-language-models ;
    vc:slug "ai-capability-evidence-compendium" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:ai-safety,
        ngm:responsible-ai .

ngm:ai-documentation-standards a owl:Class ;
    rdfs:label "AI Documentation Standards"@en ;
    rdfs:comment "AI Documentation Standards are structured frameworks and templates for comprehensively documenting AI systems, datasets, and models to ensure transparency, accountability, reproducibility, and informed stakeholder decision-making throughout the AI lifecycle."@en ;
    rdfs:subClassOf ngm:ai-governance-and-ethics ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:ai-governance ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:slug "ai-documentation-standards" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:ai-existential-risk-probability-estimate a owl:Class ;
    rdfs:label "AI Existential Risk Probability Estimate"@en ;
    rdfs:comment "p(doom) is an informal probabilistic estimate, expressed as a value between 0 and 1, of the likelihood that advanced AI development leads to an existential catastrophe for humanity—typically through loss of control over a misaligned superintelligent system. The metric is widely discussed in AI safety research communities as a shorthand for aggregating personal credences about existential risk, and is distinct from rigorous formal risk models, serving primarily as a rhetorical and community-calibration tool."@en ;
    rdfs:subClassOf ngm:infra-software-engineering ;
    skos:broader ngm:infra-software-engineering ;
    vc:bridgesTo ngm:ai-alignment,
        ngm:history-and-path-to-agi,
        ngm:uk-ai-safety-institute ;
    vc:contrastsWith ngm:value-alignment ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:ai-risk,
        ngm:ai-safety,
        ngm:artificial-superintelligence-theory,
        ngm:safety-and-alignment ;
    vc:slug "ai-existential-risk-probability-estimate" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:bayesian-inference .

ngm:ai-literacy-training-for-designers a owl:Class ;
    rdfs:label "AI Literacy Training for Designers"@en ;
    rdfs:comment "Training for Design Practitioners covers structured programmes and self-directed learning pathways that equip designers—particularly in landscape, product, and spatial disciplines—with practical AI literacy, covering generative image tools, RAG-based knowledge management, client communication automation, and AI-assisted rendering workflows for immediate professional application."@en ;
    rdfs:subClassOf ngm:infra-software-engineering ;
    skos:broader ngm:infra-software-engineering ;
    vc:enables ngm:knowledge-graphing,
        ngm:sme-ai-productivity-toolkit ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:slug "ai-literacy-training-for-designers" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:generative-design-tool ;
    vc:uses ngm:image-generation,
        ngm:prompt-engineering,
        ngm:retrieval-augmented-generation-rag .

ngm:ai-metadata a owl:Class ;
    rdfs:label "AI Metadata"@en ;
    rdfs:comment "Descriptive information, provenance data, and contextual attributes associated with AI models, datasets, and computational artefacts. Includes model cards documenting architecture, training procedures, performance metrics, intended use, and known limitations; dataset metadata capturing collection methods, labelling procedures, and potential biases; and lineage records enabling reproducibility, regulatory compliance, and responsible deployment throughout the machine learning lifecycle."@en ;
    rdfs:subClassOf ngm:ai-infrastructure ;
    vc:enables ngm:ai-governance,
        ngm:data-provenance,
        ngm:transparency-oecd ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:slug "ai-metadata" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:ai-audit,
        ngm:data-governance ;
    vc:uses ngm:ai-model-card,
        ngm:training-dataset-metadata .

ngm:ai-product-and-risk-framework a owl:Class ;
    rdfs:label "AI Product and Risk Framework"@en ;
    rdfs:comment "A framework mapping the scientific method onto lean product development, guiding AI product decisions through vision setting, market analysis, and strategic planning. It addresses SWOT evaluation, moat assessment, and risk mitigation for AI products—particularly the legal, privacy, and safety risks introduced by generative AI and the EU regulatory landscape."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:safety-and-alignment ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:product-design ],
        ngm:infra-software-engineering ;
    skos:broader ngm:infra-software-engineering ;
    vc:contrastsWith ngm:ai-risk ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:relatedTo ngm:ai-governance-law-and-privacy,
        ngm:ai-risk-management ;
    vc:requires ngm:product-design,
        ngm:safety-and-alignment ;
    vc:slug "ai-product-and-risk-framework" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:ai-governance .

ngm:ai-surveillance-deployment-case-study a owl:Class ;
    rdfs:label "AI Surveillance Deployment Case Study"@en ;
    rdfs:comment "A case study examining the deployment of AI-based surveillance systems at the Paris 2024 Olympic Games, involving real-time video analytics, geolocation tracking, behavioural pattern analysis, and predictive event detection contracted to vendors including Viet, Orange Business, Chaps Vision, and Windex. The deployment required French legislative modifications expanding surveillance powers and raised significant GDPR compliance questions regarding continuous monitoring, data retention, algorithmic bias, and the post-event normalisation of pervasive AI surveillance infrastructure."@en ;
    rdfs:subClassOf ngm:ai-governance-and-ethics ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:contrastsWith ngm:ai-ethics,
        ngm:responsible-ai ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:relatedTo ngm:bias,
        ngm:cryptography,
        ngm:fairness,
        ngm:privacy-by-design ;
    vc:slug "ai-surveillance-deployment-case-study" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:computer-vision,
        ngm:object-detection-and-tracking .

ngm:ai-tri-sm a owl:Class ;
    rdfs:label "AI TRiSM"@en ;
    rdfs:comment "AI TRiSM (Artificial Intelligence Trust, Risk, and Security Management) is a Gartner-coined framework that integrates technical, organisational, and regulatory controls to ensure AI systems are trustworthy, fair, reliable, and secure throughout their lifecycle. It addresses algorithmic bias, model opacity, data privacy, adversarial vulnerabilities, and compliance with regulations such as the EU AI Act, structured around three pillars: Trust, Risk, and Security."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:ai-risk-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:model-robustness ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:ai-trustworthiness ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:algorithmic-bias ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:explainable-ai ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:ai-audit ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:ai-security ],
        ngm:ai-governance-and-ethics ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:enables ngm:ai-governance,
        ngm:responsible-ai ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:ai-audit,
        ngm:ai-risk-management,
        ngm:ai-security,
        ngm:ai-trustworthiness ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:ai-ethics,
        ngm:ai-lifecycle,
        ngm:ai-regulation,
        ngm:ai-safety,
        ngm:red-teaming ;
    vc:requires ngm:algorithmic-bias,
        ngm:explainable-ai,
        ngm:model-robustness ;
    vc:slug "ai-tri-sm" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:aiapplications a owl:Class ;
    rdfs:label "AIApplications"@en ;
    rdfs:comment "A domain classification encompassing the practical deployment and use cases of artificial intelligence systems across industries, including autonomous systems, decision support, content generation, predictive analytics, and intelligent automation."@en ;
    rdfs:subClassOf ngm:ai-application ;
    skos:broader ngm:ai-application ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:ai-capability ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:slug "aiapplications" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:aicafev6 a owl:Class ;
    rdfs:label "AICafev6"@en ;
    rdfs:comment "AICafev6 is the sixth iteration of the AI Cafe demonstration platform, an open-source immersive knowledge development environment built on VisionFlow that integrates multi-modal AI, GPU-accelerated analytics, and agentic workflows for collaborative knowledge creation and presentation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:large-language-models ],
        ngm:infra-computing-and-cloud ;
    skos:broader ngm:infra-computing-and-cloud ;
    vc:enables ngm:agentic-ai,
        ngm:natural-language-processing ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:large-language-models ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:relatedTo ngm:computer-vision ;
    vc:slug "aicafev6" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:ai-agent-system,
        ngm:generative-ai .

ngm:algorithmic-layer a owl:Class ;
    rdfs:label "Algorithmic Layer"@en ;
    rdfs:comment "The Algorithmic Layer is the stratum that holds the step-by-step procedures a system uses to transform inputs into outputs. In the canonical stack it corresponds to the Algorithm Layer, sitting above the Compute Layer and below the Model strata that compose its primitives. It contains algorithms, data structures, and their complexity characteristics."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:compute-layer ],
        ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:enables ngm:model-architecture-layer,
        ngm:model-layer ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:compute-layer ;
    vc:slug "algorithmic-layer" ;
    vc:sourceDomain "machine-learning" .

ngm:altspace-vr a owl:Class ;
    rdfs:label "AltspaceVR"@en ;
    rdfs:comment "AltspaceVR was a social virtual reality platform offering avatar-based gatherings, events and shared spaces, later acquired by Microsoft and eventually shut down."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:avatar-system ],
        ngm:metaverse ;
    vc:enables ngm:virtual-world ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:avatar-system ;
    vc:slug "altspace-vr" ;
    vc:sourceDomain "metaverse" .

ngm:aml a owl:Class ;
    rdfs:label "AML"@en ;
    rdfs:comment "Anti-Money Laundering (AML) is the body of laws, regulations, policies, and operational controls that obligate financial institutions to detect, prevent, and report the process by which criminals disguise proceeds of illegal activity as legitimate income. AML frameworks encompass Know Your Customer (KYC) identity verification, ongoing transaction monitoring, suspicious activity reporting (SAR), and risk-based compliance programmes overseen by regulators such as the Financial Action Task Force (FATF), FinCEN, and national supervisory authorities. Machine learning and network analytics have become central to modern AML systems, enabling real-time anomaly detection and entity-resolution across large transaction graphs. Regulated entities that fail to meet AML obligations face substantial financial penalties, licence revocations, and criminal liability."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:classification ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:transaction-monitoring ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:kyc ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:identity-verification ],
        ngm:financial-services ;
    vc:bridgesTo ngm:blockchain,
        ngm:federated-learning ;
    vc:contrastsWith ngm:fraud-detection,
        ngm:sanctions-screening ;
    vc:enables ngm:financial-crime-prevention,
        ngm:regulatory-compliance ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:customer-due-diligence,
        ngm:kyc,
        ngm:suspicious-activity-reporting,
        ngm:transaction-monitoring ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:data-governance,
        ngm:explainability,
        ngm:financial-regulation ;
    vc:requires ngm:classification,
        ngm:identity-verification,
        ngm:risk-scoring ;
    vc:slug "aml" ;
    vc:sourceDomain "finance" ;
    vc:standardizedBy ngm:basel-iii,
        ngm:fatf ;
    vc:uses ngm:anomaly-detection,
        ngm:graph-analytics,
        ngm:machine-learning,
        ngm:natural-language-processing .

ngm:anoma a owl:Class ;
    rdfs:label "Anoma"@en ;
    rdfs:comment "Anoma is a protocol and architecture for intent-centric and privacy-preserving decentralised applications. It allows users to express desired outcomes that the network matches and settles."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptography ],
        ngm:distributed-systems ;
    vc:enables ngm:de-fi ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:cryptography ;
    vc:slug "anoma" ;
    vc:sourceDomain "blockchain" .

ngm:apple-inc-technology-corporation-mixed-reality-headset a owl:Class ;
    rdfs:label "Apple Mixed Reality Headset"@en ;
    rdfs:comment "A mixed reality headset developed by Apple, announced in 2023 and released in 2024. It blends digital content with the user's surroundings using high-resolution displays and eye, hand, and voice input."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:spatial-computing ],
        ngm:mixed-reality ;
    vc:enables ngm:augmented-reality ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:spatial-computing ;
    vc:slug "apple-mixed-reality-headset" ;
    vc:sourceDomain "metaverse" .

ngm:apple-mixed-reality-headsetcessing a owl:Class ;
    rdfs:label "Vision Processing"@en ;
    rdfs:comment "Vision processing is the computational transformation of raw image and video data into structured representations and decisions, spanning low-level operations such as filtering and feature extraction through high-level recognition and interpretation. It is the algorithmic core of computer-vision systems and specialised applications such as medical imaging. Efficient vision processing increasingly runs on dedicated accelerators to meet real-time demands."@en ;
    rdfs:subClassOf ngm:computer-vision ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:image-segmentation,
        ngm:medical-imaging-ai ;
    vc:slug "vision-processing" ;
    vc:sourceDomain "ai" .

ngm:aptos a owl:Class ;
    rdfs:label "Aptos"@en ;
    rdfs:comment "Aptos is a Layer 1 proof-of-stake blockchain platform founded in 2022 by former Diem (Meta) engineers, designed for safety, scalability, and high throughput. It employs the Move programming language — a resource-oriented, formally verifiable language originally created for the Diem project — to express accounts, digital assets, and smart contracts. Its primary performance innovation is Block-STM (Software Transactional Memory), a parallel transaction execution engine that speculatively executes transactions and resolves conflicts at runtime, enabling high concurrent throughput without requiring developers to pre-declare access sets. The network uses a Byzantine Fault Tolerant consensus mechanism (AptosBFT, derived from HotStuff) to reach finality with low latency."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:validator-node ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:proof-of-stake ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:byzantine-fault-tolerance ],
        ngm:blockchain-network ;
    vc:bridgesTo ngm:formal-verification,
        ngm:software-transactional-memory ;
    vc:contrastsWith ngm:ethereum,
        ngm:solana,
        ngm:sui ;
    vc:enables ngm:decentralised-finance,
        ngm:digital-asset,
        ngm:non-fungible-token,
        ngm:smart-contract ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:layer-1,
        ngm:parallel-execution,
        ngm:resource-oriented-programming ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:consensus-mechanism,
        ngm:cryptographic-proof,
        ngm:diem,
        ngm:tokenomics ;
    vc:requires ngm:byzantine-fault-tolerance,
        ngm:proof-of-stake,
        ngm:validator-node ;
    vc:slug "aptos" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:aptosbft,
        ngm:block-stm,
        ngm:merkle-tree,
        ngm:move-programming-language .

ngm:ar-experiences a owl:Class ;
    rdfs:label "Ar Experiences"@en ;
    rdfs:comment "AR Experiences are interactive augmented reality applications that overlay digital content onto the physical world in real-time through smartphones, tablets, or AR headsets, enabling enhanced visualization, contextual information display, and immersive interaction with virtual objects anchored in..."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ar-display-device ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:spatial-mapping ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:computer-vision ],
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:enables ngm:contextual-information,
