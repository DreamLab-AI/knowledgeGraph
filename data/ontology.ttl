ngm:model-architecture-layer a owl:Class ;
    rdfs:label "Model Architecture Layer"@en ;
    rdfs:comment "The Model Architecture Layer is the stratum that specifies the structural design of a machine learning model: its operators, connectivity, and parameterisation. It sits above the Algorithm Layer, which supplies the primitives it composes, and below the Model Layer, which holds trained instances of these architectures. It contains layer definitions, network topologies, and architectural hyperparameters."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:algorithm-layer ],
        ngm:ai-model-architecture ;
    skos:broader ngm:ai-model-architecture ;
    vc:enables ngm:model-layer,
        ngm:training-layer ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:algorithm-layer ;
    vc:slug "model-architecture-layer" ;
    vc:sourceDomain "ai" .

ngm:model-card a skos:Concept ;
    rdfs:label "Model Card"@en .

ngm:model-debugging a owl:Class ;
    rdfs:label "Model Debugging"@en ;
    rdfs:comment "Model debugging is the systematic process of diagnosing, isolating and correcting faults in the behaviour of a machine-learning model, such as poor accuracy, biased predictions, brittleness to distribution shift, or unexpected outputs on specific inputs. Unlike conventional software debugging, it must reason about statistical behaviour, training data, feature representations and learned parameters rather than deterministic control flow. Practitioners combine error analysis, interpretability tooling, slice-based evaluation and counterfactual probing to trace failures back to data, model architecture or the training procedure."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:model-evaluation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:model-monitoring ],
        ngm:model-evaluation ;
    vc:contrastsWith ngm:debugging ;
    vc:dependsOn ngm:data-drift,
        ngm:data-quality ;
    vc:enables ngm:model-quality,
        ngm:model-validation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:machine-learning-operations ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:observability,
        ngm:testing ;
    vc:requires ngm:error-analysis,
        ngm:model-evaluation,
        ngm:model-monitoring ;
    vc:slug "model-debugging" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:machine-learning-model,
        ngm:mlops ;
    vc:uses ngm:explainable-ai,
        ngm:logging,
        ngm:model-interpretability,
        ngm:root-cause-analysis .

ngm:model-extraction a owl:Class ;
    rdfs:label "Model Extraction"@en ;
    rdfs:comment "An attack where adversaries reconstruct a functionally equivalent or similar machine learning model by systematically querying a target model and training a substitute model on the collected input-output pairs, enabling theft of intellectual property, privacy violations, and subsequent attacks."@en ;
    rdfs:subClassOf ngm:adversarial-attacks,
        ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:enables ngm:adversarial-attacks,
        ngm:membership-inference,
        ngm:model-inversion ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:slug "model-extraction" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:model-parameters a owl:Class ;
    rdfs:label "Model Parameters"@en ;
    rdfs:comment "The learnable internal variables — weights and biases — of a neural network that are adjusted during training to minimise a loss function. Parameter count determines model capacity; foundation models commonly operate with billions to trillions of parameters, making parameter-efficient fine-tuning and management a central concern in contemporary AI development."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:neural-network ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:training ],
        ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:artificial-intelligence,
        ngm:natural-language-processing ;
    vc:requires ngm:neural-network,
        ngm:training ;
    vc:slug "model-parameters" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:ai-technique ;
    vc:uses ngm:machine-learning-discipline .

ngm:model-serialisation a owl:Class ;
    rdfs:label "Model Serialisation"@en ;
    rdfs:comment "Model serialisation is the process of converting a trained machine learning model — including its architecture definition, learned weights, and associated metadata — into a persistent, portable file format that can be stored, transferred, and subsequently loaded to restore the model to an operational state. Serialisation enables reproducibility, deployment across different environments, and sharing of pre-trained models through repositories. Common formats include ONNX for cross-framework portability, SafeTensors for security, PyTorch checkpoint files, and framework-native formats such as TensorFlow SavedModel."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:model-architecture ],
        ngm:artificial-intelligence ;
