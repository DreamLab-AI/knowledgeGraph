ngm:character-relationship-graph a owl:Class ;
    rdfs:label "Character Relationship Graph"@en ;
    rdfs:comment "A network data structure representing narrative characters as vertices and their interactions or relationships as edges, used to model social dynamics, drive procedural story generation, and analyze narrative structure through graph theory and social network analysis."@en ;
    rdfs:subClassOf ngm:social-network-graph ;
    vc:enables ngm:character-ai,
        ngm:narrative-generation,
        ngm:story-analysis ;
    vc:maturity "draft" ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:character-attributes,
