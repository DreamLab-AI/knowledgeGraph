        ngm:smart-contract ;
    vc:slug "trustless-coordination" ;
    vc:sourceDomain "blockchain" .

ngm:unit-testing a skos:Concept ;
    rdfs:label "Unit Testing"@en .

ngm:urdf a owl:Class ;
    rdfs:label "URDF"@en ;
    rdfs:comment "Unified Robot Description Format (URDF) is an XML-based schema used within the Robot Operating System (ROS) ecosystem to fully specify a robot's physical structure, including its kinematic chain of links and joints, collision geometries, inertial properties, and sensor placements. URDF files serve as the authoritative model consumed by simulation environments such as Gazebo, motion planners, and visualisation tools like RViz, enabling consistent robot representation across software components. Each joint element declares its type (fixed, revolute, prismatic, continuous) along with axis, limits, and damping parameters, while link elements reference mesh geometry and material definitions."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:robot-joint ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:robot-link ],
        ngm:robo-navigation-and-planning ;
    skos:broader ngm:robo-navigation-and-planning ;
    vc:enables ngm:gazebo-simulator,
        ngm:physics-simulation ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:robot-joint,
        ngm:robot-link ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:slug "urdf" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:robot-kinematics,
        ngm:robot-operating-system .

ngm:usability a owl:Class ;
    rdfs:label "Usability"@en ;
    rdfs:comment "Usability is the extent to which a product, system, or service can be used by specified users to achieve specified goals with effectiveness, efficiency, and satisfaction in a specified context of use, as defined by ISO 9241-11. It is a core quality attribute in human-computer interaction and user-centred design that encompasses learnability, memorability, error prevention, and user satisfaction. Usability is measured empirically through user testing, heuristic evaluation, and cognitive walkthroughs, and is distinct from—yet prerequisite to—broader user experience concerns. Poor usability results in task failure, user frustration, abandonment, and safety risks in safety-critical systems."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:user-research ],
        ngm:user-experience ;
    vc:bridgesTo ngm:explainability,
        ngm:human-robot-interaction,
        ngm:spatial-user-interface ;
    vc:contrastsWith ngm:aesthetics,
        ngm:functionality ;
    vc:dependsOn ngm:information-architecture,
        ngm:interaction-design ;
    vc:enables ngm:accessibility,
        ngm:task-completion,
        ngm:user-adoption ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:efficiency,
        ngm:error-prevention,
        ngm:learnability,
        ngm:memorability,
        ngm:user-satisfaction ;
    vc:implements ngm:heuristic-evaluation,
        ngm:user-centred-design ;
    vc:isPartOf ngm:human-computer-interaction,
        ngm:user-experience ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:affordance,
        ngm:feedback-loop,
        ngm:mental-model ;
    vc:requires ngm:task-analysis,
        ngm:user-research,
        ngm:user-testing ;
    vc:slug "usability" ;
    vc:sourceDomain "infrastructure" ;
    vc:standardizedBy ngm:iso-9241,
        ngm:wcag ;
    vc:supports ngm:human-robot-interaction,
        ngm:interface-design ;
    vc:uses ngm:cognitive-walkthrough,
        ngm:eye-tracking,
        ngm:think-aloud-protocol .

ngm:user-engagement a owl:Class ;
    rdfs:label "User Engagement"@en ;
    rdfs:comment "User Engagement is the set of qualitative and quantitative dimensions that characterise the depth, frequency, and quality of a person's interaction with a digital product, service, or community. High engagement reflects meaningful value exchange: users return voluntarily, invest attention and effort, and develop lasting behaviours around the product. Engagement metrics—session duration, interaction depth, return rate, and social sharing—serve as proxies for value delivered and are key inputs to product development prioritisation and business model viability. Ethical engagement design balances compelling interaction patterns against the risk of exploiting psychological vulnerabilities through addictive mechanics or manipulative nudging."@en ;
    rdfs:subClassOf ngm:user-experience ;
    vc:enables ngm:hyper-personalisation,
        ngm:loyalty-programs,
        ngm:recommendation-systems ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:content-creation,
        ngm:creator-economy,
        ngm:social-platform,
        ngm:user-interface ;
    vc:slug "user-engagement" ;
    vc:sourceDomain "metaverse" ;
    vc:uses ngm:digital-content,
        ngm:natural-interaction,
        ngm:reward-function .

ngm:vae a owl:Class ;
    rdfs:label "VAE"@en ;
    rdfs:comment "A Variational Autoencoder (VAE) is a deep generative model that learns a probabilistic, continuous latent-space representation of data by jointly optimising a reconstruction loss and a Kullback-Leibler divergence regularisation term, using amortised variational inference to make the intractable posterior distribution tractable. The encoder network (recognition model) maps input data to the parameters of a Gaussian posterior over latent codes, while the decoder network maps samples drawn from that posterior back to the data space; the reparameterisation trick renders the sampling step differentiable, enabling end-to-end gradient-based learning. VAEs underpin latent diffusion models, representation learning, disentanglement research, and multimodal generative systems, and have been extended by hierarchical, vector-quantised, and conditional variants that dramatically improve fidelity and controllability."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:autoencoder ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:backpropagation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:variational-inference ],
        ngm:deep-generative-model ;
    vc:bridgesTo ngm:multimodal-learning,
        ngm:stable-diffusion ;
    vc:contrastsWith ngm:diffusion-model,
        ngm:flow-based-model,
        ngm:generative-adversarial-network ;
    vc:enables ngm:data-augmentation,
        ngm:disentangled-representation,
        ngm:image-generation,
        ngm:latent-diffusion,
        ngm:representation-learning ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:decoder-network,
        ngm:encoder-network,
        ngm:latent-space ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:beta-vae,
        ngm:hierarchical-vae,
        ngm:vq-vae ;
    vc:requires ngm:autoencoder,
        ngm:backpropagation,
        ngm:kl-divergence,
        ngm:reparameterisation-trick,
        ngm:variational-inference ;
    vc:slug "vae" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:evidence-lower-bound,
        ngm:gaussian-distribution,
        ngm:neural-network .

ngm:validator-economics a owl:Class ;
    rdfs:label "Validator Economics"@en ;
    rdfs:comment "Validator economics describes the incentive structures, cost-reward equilibria, and rational behaviour models governing participants who operate validator nodes in proof-of-stake and delegated consensus blockchain networks. It encompasses staking rewards (block rewards, transaction fees, MEV capture), slashing penalties for Byzantine behaviour (double-signing, downtime), the competitive market for delegated stake, operational costs (hardware, bandwidth, maintenance), and the resulting equilibrium between security budget, validator profitability, and network decentralisation. Well-designed validator economics align individual rational self-interest with network security and liveness."@en ;
    rdfs:subClassOf ngm:blockchain-economics ;
    vc:enables ngm:decentralized-governance,
        ngm:finality ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:delegated-proof-of-stake,
        ngm:incentive-alignment,
        ngm:token-economics,
        ngm:validator-node,
        ngm:validator-set ;
    vc:slug "validator-economics" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:block-reward,
        ngm:consensus-mechanism,
        ngm:proof-of-stake,
        ngm:tokenomics .

ngm:value-transfer a owl:Class ;
    rdfs:label "Value Transfer"@en ;
    rdfs:comment "The mechanism and process by which economic value, rights, or utility are exchanged between parties across physical, digital, and virtual domains, encompassing monetary systems, token-based systems, resource allocation, and rights transfer protocols."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
