        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:token ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:barter-system ],
        ngm:bc-defi-and-economics,
        ngm:cryptocurrency ;
    skos:broader ngm:bc-defi-and-economics ;
    vc:enables ngm:commerce,
