ngm:cloud-storage a owl:Class ;
    rdfs:label "Cloud Storage"@en ;
    rdfs:comment "Cloud storage is a model of data persistence in which digital data is held on remote servers operated by a cloud service provider, accessed over a network (typically the internet) via well-defined APIs rather than on locally attached hardware. Providers maintain geographically distributed, redundant infrastructure implementing erasure coding or multi-region replication to guarantee high durability and availability, typically billing clients on capacity consumed and egress data transfer. The paradigm encompasses object storage, cloud file systems, and block storage volumes, and underpins virtually every modern cloud-native application architecture by decoupling storage from compute. Major implementations include Amazon S3, Google Cloud Storage, Azure Blob Storage, and S3-compatible open-source systems such as MinIO."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:block-storage ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:network-infrastructure ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:object-storage ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:identity-and-access-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cloud-computing ],
        ngm:data-storage ;
    vc:bridgesTo ngm:decentralized-storage,
        ngm:hybrid-cloud ;
    vc:contrastsWith ngm:content-addressed-storage,
        ngm:distributed-storage,
        ngm:on-premises-storage ;
    vc:enables ngm:backup-and-recovery,
        ngm:cloud-native-application,
        ngm:data-lake ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:block-storage,
        ngm:cloud-file-system,
        ngm:object-storage ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:cloud-infrastructure,
        ngm:cloud-platform,
        ngm:data-sovereignty ;
    vc:requires ngm:cloud-computing,
        ngm:identity-and-access-management,
        ngm:network-infrastructure ;
    vc:slug "cloud-storage" ;
    vc:sourceDomain "infrastructure" ;
    vc:standardizedBy ngm:rest-api,
        ngm:s3-api ;
    vc:supports ngm:data-management,
        ngm:machine-learning,
        ngm:vector-database ;
    vc:uses ngm:content-delivery-network,
        ngm:encryption,
        ngm:erasure-coding .

ngm:fairness-metrics a owl:Class ;
    rdfs:label "Fairness Metrics"@en ;
    rdfs:comment "Quantitative measures and mathematical frameworks used to evaluate whether an AI system produces equitable outcomes across demographic groups. Core metrics include demographic parity, equalized odds, equal opportunity, and predictive parity; selection among them depends on context and regulatory requirements, as metrics can conflict and no single criterion satisfies all fairness definitions simultaneously."@en ;
