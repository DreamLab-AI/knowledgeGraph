    vc:enables ngm:compliance-control,
        ngm:force-feedback,
        ngm:impedance-control,
        ngm:robotic-grasping ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:strain-gauge ;
    vc:isPartOf ngm:haptic-feedback-system,
        ngm:robotic-arm ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:requires ngm:analog-to-digital-converter,
        ngm:calibration,
        ngm:data-processing ;
    vc:slug "force-torque-sensor" ;
    vc:sourceDomain "robotics" ;
