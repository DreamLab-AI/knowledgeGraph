    vc:requires ngm:bip-340-schnorr-keypair,
        ngm:message-signing,
        ngm:network-connectivity,
        ngm:nostr-protocol ;
    vc:slug "sovereign-mesh" ;
    vc:sourceDomain "blockchain" .

