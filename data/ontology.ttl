    vc:requires ngm:w3-c ;
    vc:slug "w-3-c-vocabulary" ;
    vc:sourceDomain "standards" .

ngm:wallet-address a owl:Class ;
    rdfs:label "Wallet Address"@en ;
    rdfs:comment "A wallet address is a public, shareable identifier on a blockchain network to which assets can be sent and from which ownership is asserted. It is typically derived deterministically from a public key by hashing and encoding, allowing anyone to send funds to it while only the holder of the corresponding private key can authorise outgoing transactions. Addresses are network-specific in format and serve as the destination in transactions and the anchor for on-chain balance accounting."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:public-key-cryptography ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:hash-function ],
        ngm:blockchain ;
    skos:broader ngm:blockchain ;
    vc:bridgesTo ngm:digital-signature ;
    vc:contrastsWith ngm:private-key ;
