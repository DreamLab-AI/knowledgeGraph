ngm:rdf-triple-store a owl:Class ;
    rdfs:label "RDF Triple Store"@en ;
    rdfs:comment "An RDF triple store is a purpose-built database for storing and querying data as subject-predicate-object triples following the Resource Description Framework model. It supports the SPARQL query language and often provides reasoning over ontologies to infer implicit facts. Triple stores are the backbone of semantic-web, knowledge-graph, and linked-data applications."@en ;
    rdfs:subClassOf ngm:data-management ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:graph-database,
        ngm:metaverse-ontology-schema ;
    vc:slug "rdf-triple-store" ;
    vc:sourceDomain "data" .

ngm:real-time-analytics a owl:Class ;
    rdfs:label "Real-Time Analytics"@en ;
    rdfs:comment "Real-time analytics is the processing and analysis of data immediately as it is generated, producing insights and triggering actions with sub-second to low-second latency. It relies on stream-processing engines, in-memory computation, and windowed aggregation rather than batch ETL. It enables responsive dashboards, anomaly detection, and adaptive systems that act on fresh data."@en ;
    rdfs:subClassOf ngm:data-management ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:adaptive-virtual-experience,
        ngm:edge-computing-node ;
    vc:slug "real-time-analytics" ;
    vc:sourceDomain "data" .

ngm:real-time-inference-engine a owl:Class ;
    rdfs:label "Real-Time Inference Engine"@en ;
    rdfs:comment "A real-time inference engine is an optimised runtime that executes trained machine-learning models with low, predictable latency to serve predictions within interactive or streaming time budgets. It applies techniques such as operator fusion, quantisation, batching, and hardware acceleration to meet throughput and latency targets. It is the serving layer that turns offline-trained models into responsive online services."@en ;
    rdfs:subClassOf ngm:ai-infrastructure ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:hyper-personalisation,
        ngm:onnx-runtime ;
    vc:slug "real-time-inference-engine" ;
    vc:sourceDomain "ai" .

ngm:reality-eth a owl:Class ;
    rdfs:label "Reality.eth"@en ;
    rdfs:comment "Reality.eth is an Ethereum-based oracle that answers questions by crowdsourcing responses with an escalating bond mechanism, allowing economic dispute resolution. It is used to bring real-world facts on chain."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ethereum ],
