    vc:requires ngm:certificate-authority,
        ngm:cryptography,
        ngm:transparency ;
    vc:slug "digital-trust" ;
    vc:sourceDomain "governance" ;
    vc:supports ngm:digital-governance,
        ngm:reputation-system ;
    vc:uses ngm:encryption,
        ngm:verifiable-credentials .

ngm:digital-twin-creation a owl:Class ;
    rdfs:label "Digital Twin Creation"@en ;
    rdfs:comment "The process of constructing virtual replicas of physical entities that dynamically reflect real-time conditions through continuous bidirectional data linkage, enabling simulation, monitoring, and optimisation across an asset's entire lifecycle from design through decommissioning."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
