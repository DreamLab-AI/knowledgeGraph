        ngm:xr-runtime ;
    vc:slug "open-xr" ;
    vc:sourceDomain "spatial-computing" .

ngm:rb-0087-safety-standard a owl:Class ;
    rdfs:label "rb 0087 safety standard"@en ;
    rdfs:comment "A safety standard in robotics is a normative document, published by a recognised standards body, that specifies requirements and guidelines to achieve acceptable levels of safety for robot systems, their components, and their operating environments. Key robotics safety standards include ISO 10218-1/2 for industrial robots, ISO/TS 15066 for collaborative operation, and ISO 13482 for personal care robots. Such standards define hazard categories, risk assessment methodology, required safety functions, performance levels, and verification procedures that manufacturers and system integrators must satisfy before deployment."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:rb-0089-risk-assessment ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:rb-0088-iso-13482-compliance ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:rb-0101-performance-level ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:rb-0100-safety-integrity-level ],
        ngm:robo-safety-and-standards,
        ngm:robot-standard ;
    skos:broader ngm:robo-safety-and-standards ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:rb-0088-iso-13482-compliance,
        ngm:rb-0100-safety-integrity-level,
        ngm:rb-0101-performance-level ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:iec-61508,
        ngm:iso-10218,
        ngm:iso-ts-15066 ;
    vc:requires ngm:rb-0089-risk-assessment ;
    vc:slug "rb-0087-safety-standard" ;
    vc:sourceDomain "robotics" ;
    vc:supports ngm:functional-safety,
        ngm:robot-safety .

ngm:real-time-computing a owl:Class ;
    rdfs:label "Real-Time Computing"@en ;
    rdfs:comment "Real-time computing is a computational paradigm in which the correctness of a system depends not only on producing logically correct results but also on producing them within specified timing constraints. Systems are classified as hard real-time (where a missed deadline constitutes a system failure, e.g. aircraft fly-by-wire), firm real-time (where late results are useless but non-catastrophic), or soft real-time (where occasional deadline misses degrade quality rather than cause failure, e.g. multimedia streaming). Achieving real-time guarantees requires deterministic scheduling, bounded interrupt latency, and careful resource management throughout the entire software stack."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:real-time-operating-system ],
        ngm:distributed-systems ;
    vc:bridgesTo ngm:digital-twin,
        ngm:machine-learning-inference ;
    vc:contrastsWith ngm:batch-processing,
        ngm:time-sharing ;
    vc:dependsOn ngm:clock-synchronisation,
        ngm:latency ;
    vc:enables ngm:autonomous-vehicles,
        ngm:embedded-systems,
        ngm:flight-control-systems,
        ngm:industrial-automation ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:deadline-scheduling,
        ngm:hard-real-time,
        ngm:soft-real-time ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:concurrency,
        ngm:fault-tolerance ;
    vc:requires ngm:deterministic-scheduling,
        ngm:interrupt-handling,
        ngm:real-time-operating-system ;
    vc:slug "real-time-computing" ;
    vc:sourceDomain "infrastructure" ;
    vc:standardizedBy ngm:iso-26262,
        ngm:posix ;
    vc:supports ngm:cyber-physical-systems,
        ngm:edge-computing,
        ngm:robotics ;
    vc:uses ngm:memory-management,
        ngm:priority-scheduling,
        ngm:watchdog-timer .

ngm:recommendation-systems a owl:Class ;
    rdfs:label "Recommendation Systems"@en ;
    rdfs:comment "Recommendation Systems are information filtering systems that predict a user's preference for items—products, content, services—and surface the most relevant items from a large catalogue. They are categorised into collaborative filtering (leveraging the behaviour of similar users), content-based filtering (matching item attributes to user profiles), and hybrid approaches that combine both. Modern large-scale recommendation systems employ deep learning architectures, embedding models, and two-tower neural networks trained on implicit feedback signals such as clicks, watch-time, and purchases. Recommendation systems are among the highest-impact machine learning applications in commercial technology, driving substantial fractions of revenue at platforms such as Netflix, Amazon, YouTube, and Spotify, while also raising significant concerns about filter bubbles, engagement maximisation harms, and algorithmic amplification of misinformation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:feature-engineering ],
        ngm:machine-learning-discipline ;
    vc:bridgesTo ngm:ai-governance-and-ethics,
        ngm:digital-services-act ;
    vc:contrastsWith ngm:information-retrieval,
        ngm:search-engine ;
    vc:dependsOn ngm:deep-learning,
        ngm:vector-database ;
    vc:enables ngm:content-discovery,
        ngm:hyper-personalisation,
        ngm:predictive-personalization ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:candidate-generation,
        ngm:collaborative-filtering,
        ngm:content-based-filtering,
        ngm:retrieval-ranking-pipeline ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:algorithmic-amplification,
        ngm:filter-bubble,
        ngm:machine-learning-discipline-model,
        ngm:recommendation-engine ;
    vc:requires ngm:feature-engineering,
        ngm:implicit-feedback,
        ngm:user-item-interaction-data ;
    vc:slug "recommendation-systems" ;
    vc:sourceDomain "machine-learning" ;
    vc:uses ngm:approximate-nearest-neighbour-search,
        ngm:embedding-model,
        ngm:graph-neural-network,
        ngm:machine-learning-discipline-pipeline,
        ngm:matrix-factorisation,
        ngm:two-tower-neural-network .

ngm:regulatory-technology a owl:Class ;
    rdfs:label "Regulatory Technology"@en ;
    rdfs:comment "Regulatory Technology (RegTech) is the application of digital tools—encompassing artificial intelligence, machine learning, natural language processing, distributed ledger technology, and cloud computing—to automate, streamline, and improve the accuracy of regulatory compliance processes across financial services and adjacent sectors. Core functions include know-your-customer (KYC) and anti-money-laundering (AML) screening, real-time transaction monitoring, regulatory reporting, risk management, and consent lifecycle management. RegTech reduces the cost and latency of compliance obligations while providing regulators with higher-quality, machine-readable data through standardised reporting formats such as XBRL and ISO 20022. It operates at the intersection of legal obligation, data governance, and algorithmic automation, and is increasingly deployed in decentralised finance, open banking, and AI governance contexts."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:audit-trail ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:know-your-customer ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:anti-money-laundering ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:risk-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:regulatory-reporting ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:identity-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-governance ],
        ngm:compliance-framework ;
