        ngm:nvidia-omniverse,
        ngm:opc-ua,
        ngm:siemens-xcelerator .

ngm:programming-language a owl:Class ;
    rdfs:label "Programming Language"@en ;
    rdfs:comment "A formal notation system used to specify algorithms, data structures, and computational models for AI and software applications, characterised by defined syntax and semantics; prominent examples include Python for machine-learning ecosystems, Julia for high-performance numerical computing, and domain-specific languages embedded in ML frameworks."@en ;
    rdfs:subClassOf ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:enables ngm:deep-learning,
        ngm:natural-language-processing ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:ai-model-architecture,
        ngm:software-development-process,
        ngm:transformer-architecture ;
    vc:slug "programming-language" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:open-source-framework .

ngm:question-answering a owl:Class ;
    rdfs:label "Question Answering"@en ;
    rdfs:comment "Question Answering (QA) is the NLP task of automatically generating accurate answers to natural language questions posed by users, either by extracting answers from text passages (extractive QA) or generating free-form responses (generative QA)."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:natural-language-processing ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:information-retrieval ],
        ngm:ai-application,
        ngm:machine-learning ;
    skos:broader ngm:ai-application ;
    vc:enables ngm:dialogue-system,
        ngm:retrieval-augmented-generation ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires ngm:information-retrieval,
        ngm:natural-language-processing ;
    vc:slug "question-answering" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:knowledge-graph,
        ngm:transformer .

ngm:rb-0021-robot-kinematics a owl:Class ;
    rdfs:label "rb 0021 robot kinematics"@en ;
    rdfs:comment "Robot kinematics is the study of the geometry and motion of robot mechanisms — particularly manipulator arms — without regard to the forces or torques that cause motion. It encompasses forward kinematics (computing end-effector pose from joint configurations), inverse kinematics (computing joint configurations for a desired end-effector pose), Jacobian analysis relating joint velocities to Cartesian velocities, and singularity analysis. Kinematic models are foundational inputs to motion planning, trajectory generation, and control law design."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:forward-kinematics ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:rb-0030-jacobian-matrix ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:inverse-kinematics ],
        ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:enables ngm:rb-0049-motion-planning,
        ngm:rb-0064-computed-torque-control ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:forward-kinematics,
        ngm:inverse-kinematics,
        ngm:rb-0030-jacobian-matrix ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:rb-0022-robot-dynamics,
        ngm:rb-0023-degrees-of-freedom,
        ngm:rb-0031-singularity ;
    vc:slug "rb-0021-robot-kinematics" ;
    vc:sourceDomain "robotics" .

ngm:remote-collaboration a owl:Class ;
    rdfs:label "Remote Collaboration"@en ;
    rdfs:comment "Work practices, tools, and methodologies enabling geographically distributed teams to coordinate effectively without physical co-location, combining synchronous channels (video conferencing, real-time co-editing, spatial audio) with asynchronous coordination (version control, project management, persistent chat) to maintain team cohesion and productivity across time zones."@en ;
    rdfs:subClassOf ngm:infra-network-and-comms ;
    skos:broader ngm:infra-network-and-comms ;
    vc:bridgesTo ngm:telecollaboration,
        ngm:virtual-collaboration ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:relatedTo ngm:immersive-communication,
        ngm:virtual-workspace ;
    vc:slug "remote-collaboration" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:encryption,
        ngm:spatial-audio .

ngm:robot-safety a owl:Class ;
    rdfs:label "Robot Safety"@en ;
    rdfs:comment "Robot Safety encompasses the engineering principles, risk assessment methods, and regulatory standards that ensure robotic systems operate without causing harm to humans, other machines, or the environment. It includes functional safety standards (ISO 10218, ISO 13849), collaborative robot (cobot) application requirements, dynamic risk assessment, and the emerging challenges of AI-integrated and autonomous robot deployment in shared workspaces."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:collision-avoidance ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:sensor-fusion ],
        ngm:robo-safety-and-standards ;
    skos:broader ngm:robo-safety-and-standards ;
    vc:enables ngm:human-robot-interaction,
        ngm:robotics ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:relatedTo ngm:robot-dynamics,
        ngm:state-estimation ;
    vc:requires ngm:collision-avoidance,
        ngm:sensor-fusion ;
    vc:slug "robot-safety" ;
    vc:sourceDomain "robotics" .

ngm:system-architecture a owl:Class ;
    rdfs:label "System Architecture"@en ;
    rdfs:comment "System Architecture in AI defines the holistic structure integrating hardware, software, data infrastructure, and operational components to deliver intelligent capabilities at scale."@en ;
