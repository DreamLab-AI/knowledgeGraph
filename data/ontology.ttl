ngm:agentic-ai-systems a owl:Class ;
    rdfs:comment "Agentic AI systems are AI systems that autonomously plan and execute multi-step tasks by invoking tools, calling external APIs, and adapting their strategy based on intermediate results, rather than producing a single response to a single prompt. They combine a reasoning model with memory, tool use, and control loops that allow sustained operation toward a goal with limited human intervention. Agentic AI systems are a major focus of frontier AI development and a key axis of competition among AI labs."@en ;
    rdfs:label "Agentic AI Systems"@en ;
    rdfs:subClassOf ngm:ai-system ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.55"^^xsd:float ;
