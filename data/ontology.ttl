ngm:avalanche a owl:Class ;
    rdfs:label "Avalanche"@en ;
    rdfs:comment "Avalanche is a high-throughput, low-latency layer-1 blockchain platform that uses a novel family of consensus protocols — collectively called Avalanche consensus — based on repeated sub-sampled voting to achieve probabilistic finality in under two seconds. It supports heterogeneous sub-networks (subnets) and three built-in blockchains: the Exchange Chain (X-Chain), Platform Chain (P-Chain), and Contract Chain (C-Chain)."@en ;
