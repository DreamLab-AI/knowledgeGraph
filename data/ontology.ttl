ngm:node-based-editor a owl:Class ;
    rdfs:label "Node Based Editor"@en ;
    rdfs:comment "A visual authoring tool that represents computational logic, material properties, or content workflows as directed graphs of interconnected nodes and edges, enabling non-linear dataflow programming. Node-based editors are widely used in game engines, VFX pipelines, and spatial computing tools for shader authoring, procedural geometry generation, and real-time behaviour scripting."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:user-interface ],
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:enables ngm:procedural-generation,
        ngm:world-building ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:user-interface ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:slug "node-based-editor" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:3-d-asset,
        ngm:rendering-engine ;
    vc:uses ngm:game-engine,
        ngm:shader .

