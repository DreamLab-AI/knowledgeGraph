ngm:dao-treasury a owl:Class ;
    rdfs:comment "A DAO treasury is the pool of on-chain assets collectively owned and governed by a decentralised autonomous organisation, typically held in smart contracts and controlled through member governance. It funds operations, grants and incentives, with disbursements authorised by token-weighted votes and executed by multisignature or programmatic controls. Treasury management balances runway, diversification and accountability without a central custodian."@en ;
    rdfs:label "Dao Treasury"@en ;
    rdfs:subClassOf ngm:dao ;
    rdfs:subClassOf _:r6739 ;
    rdfs:subClassOf _:r6740 ;
    rdfs:subClassOf _:r6741 ;
