    vc:slug "collaborative-technology" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:distributed-collaboration ;
    vc:uses ngm:communication-protocol,
        ngm:network-protocol .

ngm:colmap a owl:Class ;
    rdfs:label "COLMAP"@en ;
    rdfs:comment "COLMAP is an open-source general-purpose Structure-from-Motion and multi-view stereo pipeline used to reconstruct three-dimensional scenes from unordered collections of photographs. It performs feature extraction, image matching, incremental camera pose estimation, triangulation, and dense point-cloud generation. COLMAP is widely used as a preprocessing step for neural radiance fields and 3D Gaussian Splatting pipelines. Its modular architecture supports both GPU-accelerated and CPU-only execution, making it accessible across a range of hardware configurations."@en ;
    rdfs:subClassOf ngm:structure-from-motion ;
    vc:enables ngm:3-d-gaussian-splatting,
        ngm:gaussian-splatting ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:depth-estimation,
        ngm:photogrammetry,
        ngm:point-cloud,
        ngm:spatial-mapping ;
    vc:slug "colmap" ;
    vc:sourceDomain "metaverse" ;
    vc:uses ngm:computer-vision,
        ngm:gpu-computing .

ngm:colour-management a owl:Class ;
    rdfs:label "Colour Management"@en ;
    rdfs:comment "Colour management is the controlled conversion of colour representations between the characteristics of different devices and media so that colours appear consistent across capture, display and output. It relies on device profiles that describe how a given device reproduces colour and a profile connection space to translate between them. In spatial computing and real-time rendering, colour management ensures perceptually accurate imagery across cameras, displays and headsets."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:display-calibration ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:display-calibration ],
        ngm:display-technology ;
    vc:bridgesTo ngm:augmented-reality ;
    vc:contrastsWith ngm:rendering ;
    vc:dependsOn ngm:display-technology ;
    vc:enables ngm:physically-based-rendering,
        ngm:rendering-pipeline ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:display-calibration ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:computer-graphics,
        ngm:design-software,
        ngm:texture-mapping ;
    vc:requires ngm:display-calibration ;
    vc:slug "colour-management" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:real-time-rendering,
        ngm:virtual-production ;
    vc:uses ngm:shader .

ngm:comet-metric a owl:Class ;
    rdfs:label "COMET Metric"@en ;
    rdfs:comment "A family of learned, reference-based and reference-free evaluation metrics for machine translation that use pre-trained multilingual language model representations to predict human-quality assessments of translation output. COMET models correlate more strongly with human judgements than n-gram-overlap metrics such as BLEU by capturing semantic and contextual similarity rather than surface string matching."@en ;
    rdfs:subClassOf ngm:evaluation-metric ;
    vc:contrastsWith ngm:bleu-score,
        ngm:bleurt,
        ngm:chrf,
        ngm:ter ;
    vc:dependsOn ngm:direct-assessment,
        ngm:multidimensional-quality-metrics ;
    vc:enables ngm:human-evaluation,
        ngm:quality-estimation,
        ngm:translation-quality-assurance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:ranking-model,
        ngm:regression-model ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:natural-language-understanding,
        ngm:neural-machine-translation,
        ngm:post-editing,
        ngm:wmt-shared-task,
        ngm:xcomet ;
    vc:requires ngm:human-annotation,
        ngm:multilingual-language-model ;
    vc:slug "comet-metric" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:machine-translation,
        ngm:natural-language-processing,
        ngm:transfer-learning,
        ngm:xlm-roberta .

ngm:commit-reveal-scheme a owl:Class ;
    rdfs:label "Commit-Reveal Scheme"@en ;
    rdfs:comment "A commit-reveal scheme is a two-phase cryptographic protocol in which a participant first publishes a binding, hiding commitment to a value (typically a hash of the value plus a nonce) and later reveals the value for verification. The commit phase prevents others from learning or altering the choice, while the reveal phase lets anyone check the value against the earlier commitment. It matters for on-chain voting and auctions because it stops front-running and last-mover advantage by concealing inputs until all parties are bound."@en ;
    rdfs:subClassOf ngm:cryptographic-protocol ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:quadratic-voting ;
    vc:slug "commit-reveal-scheme" ;
    vc:sourceDomain "blockchain" .

ngm:commodity-money a owl:Class ;
    rdfs:label "Commodity Money"@en ;
    rdfs:comment "Commodity money is a form of money whose value derives from the intrinsic worth of the physical commodity from which it is made, such as gold, silver, salt or grain. Because the medium of exchange is itself a useful or scarce good, its monetary value is anchored to its commodity value rather than to government decree. Commodity money predates and contrasts with fiat currency, where value rests on trust in an issuing authority."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:value ],
        ngm:money ;
    vc:contrastsWith ngm:cryptocurrency,
        ngm:fiat-currency ;
    vc:enables ngm:store-of-value ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:hard-money ;
    vc:isPartOf ngm:monetary-system ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:bitcoin,
        ngm:finance,
        ngm:inflation,
        ngm:monetary-policy,
        ngm:money ;
    vc:requires ngm:value ;
    vc:slug "commodity-money" ;
    vc:sourceDomain "finance" ;
    vc:supports ngm:gold-standard ;
    vc:uses ngm:gold .

ngm:communication-network a owl:Class ;
    rdfs:label "Communication Network"@en ;
    rdfs:comment "A communication network is an interconnected collection of nodes and links that transports information between endpoints according to shared protocols. Networks are characterised by their topology, switching method, transmission media, and the protocol stack that governs addressing, routing, and error control. They span scales from local wireless links to global packet-switched internetworks, and they provide the substrate on which distributed systems, decentralised ledgers, and immersive media depend. Performance is described by metrics including bandwidth, latency, jitter, and reliability."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:transport-layer ],
        ngm:communication-infrastructure ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:transport-layer ;
    vc:qualityScore "0.76"^^xsd:float ;
    vc:relatedTo ngm:network-performance-metrics ;
    vc:slug "communication-network" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:communication-protocol .

ngm:community a owl:Class ;
    rdfs:label "community"@en ;
    rdfs:comment "A community is a group of people who interact around a shared interest, project, or platform, contributing to its development, governance, or use."@en ;
