ngm:blob-transaction a owl:Class ;
    rdfs:comment "A blob transaction is an Ethereum transaction type introduced by EIP-4844 (Proto-Danksharding) that carries a large binary payload of 'blob' data alongside the standard transaction fields, priced separately from calldata gas. Blobs are stored by consensus nodes for a limited retention window rather than persisted in perpetuity by the EVM, which keeps the cost of posting rollup data far lower than embedding it as ordinary calldata. Blob transactions are the mechanism by which layer-2 rollups post the data needed for fraud or validity proofs back to layer 1."@en ;
    rdfs:label "Blob Transaction"@en ;
    rdfs:subClassOf ngm:transaction ;
    rdfs:subClassOf _:r3286 ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:danksharding ;
    vc:qualityScore "0.65"^^xsd:float ;
    vc:requires ngm:transaction ;
    vc:slug "blob-transaction" ;
    vc:sourceDomain "blockchain" .
ngm:block a owl:Class ;
    rdfs:comment "The fundamental unit of a blockchain: a cryptographically linked, immutable data container that batches a set of transactions together with a block header containing the Merkle root of those transactions, a timestamp, the previous block's hash, and consensus-specific fields such as a nonce or validator signature. Sequential blocks form the chain that provides an append-only audit trail."@en ;
    rdfs:label "Block"@en ;
    rdfs:subClassOf ngm:blockchain-entity ;
    rdfs:subClassOf ngm:distributed-data-structure ;
    rdfs:subClassOf _:r3328 ;
    rdfs:subClassOf _:r3329 ;
