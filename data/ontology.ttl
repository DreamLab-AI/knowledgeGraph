    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:data-pipeline,
        ngm:edge-computing,
        ngm:gpu-compute,
        ngm:mlops,
        ngm:model-serving,
        ngm:vector-database ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:cloud-infrastructure,
        ngm:empirical-experimental-design-tracking,
        ngm:model-registry ;
    vc:requires ngm:distributed-storage,
