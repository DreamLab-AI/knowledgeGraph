        ngm:spatial-audio,
        ngm:video-conferencing,
        ngm:volumetric-capture ;
    vc:isPartOf ngm:distributed-collaboration,
        ngm:extended-reality ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:holographic-display,
