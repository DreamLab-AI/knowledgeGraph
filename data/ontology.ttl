# Centralized Swarm Control
robotics:CentralizedSwarmControl rdf:type owl:Class ;
    rdfs:subClassOf robotics:SwarmControl ;
    rdfs:subClassOf robotics:Robotics ;
    rdfs:subClassOf robotics:CentralizedControlArchitecture ;
    rdfs:label "Centralized Swarm Control"@en ;
    rdfs:comment "Swarm robotics control architecture where a central controller coordinates all robot agents, providing global optimisation but creating a single point of failure. In this model, the central controller maintains a complete model of swarm state, computes optimal commands for each Robot Agent, and broadcasts directives, contrasting with Decentralized Swarm Control approaches where autonomy is distributed."@en ;
    skos:prefLabel "Centralized Swarm Control"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:robotics:centralized-swarm-control" ;
    owl:sameAs <urn:visionclaw:concept:robotics:centralized-swarm-control> ;
    vcw:contentHash "sha256-12-709af1f01894" ;
    vcw:qualityScore "0.5"^^xsd:decimal ;
    vcw:legacyTermId "RB-9003" ;
    vcw:ontologyStatus "draft" ;
    vcw:maturityLevel "mature" ;
    vcw:authorityScore "0.0"^^xsd:decimal ;
    dcterms:identifier "RB-9003" ;
    dcterms:subject "robotics" ;
    owl:versionInfo "2.0.0" ;
    dcterms:created "2026-04-26T00:00:00Z"^^xsd:dateTime ;
    dcterms:modified "2026-04-26T00:00:00Z"^^xsd:dateTime ;
    vcw:owlRole "Process" .

robotics:CentralizedSwarmControl rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty infrastructure:hasPart ;
    owl:someValuesFrom robotics:CentralController
] .

