    skos:broader ngm:sc-content-and-assets ;
    vc:enables ngm:immersive-experience ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:archival-standards,
        ngm:cultural-heritage-xr-experience ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:relatedTo ngm:nft ;
    vc:slug "digital-heritage" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:3-d-reconstruction,
        ngm:digital-preservation .

ngm:digital-objects a owl:Class ;
    rdfs:label "Digital Objects"@en ;
    rdfs:comment "Digital Objects is an umbrella ontology concept covering three closely-related but historically distinct senses of \"an addressable, transferable, identifiable unit of digital content\": (1) Digital Object Architecture (DOA), the formal information-infrastructure paradigm proposed by Robert E."@en ;
