ngm:few-shot-learning a owl:Class ;
    rdfs:label "Few-Shot Learning"@en ;
    rdfs:comment "A learning setting in which a model is required to generalise to a new task or class from only a small number of labelled examples, typically by leveraging prior knowledge or inductive biases learned across many related tasks."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
