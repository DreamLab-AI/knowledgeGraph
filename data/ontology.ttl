        ngm:deep-generative-model,
        ngm:differential-privacy,
        ngm:transfer-learning ;
    vc:requires ngm:seed-dataset,
        ngm:statistical-modelling ;
    vc:slug "synthetic-data-generation" ;
    vc:sourceDomain "ai" ;
    vc:supports ngm:ai-safety,
        ngm:rare-event-modelling,
        ngm:regulatory-compliance ;
    vc:uses ngm:data-pipeline,
        ngm:diffusion-model,
        ngm:generative-adversarial-network,
        ngm:generative-model,
        ngm:simulation,
        ngm:variational-autoencoder .

ngm:threat-model a owl:Class ;
    rdfs:label "Threat Model"@en ;
    rdfs:comment "A threat model is a structured representation of the security properties, assumptions, and adversarial conditions relevant to a system, used to identify potential attack vectors, prioritise mitigations, and reason systematically about security guarantees. It defines who the adversary is (capabilities, motivations, access), what assets are worth protecting, and what attacks — such as those catalogued in STRIDE or MITRE ATT&CK — could compromise confidentiality, integrity, or availability. Threat modelling is applied during system design to surface architectural weaknesses before implementation, and updated continuously as the threat landscape evolves. It is a prerequisite for sound security architecture, cryptographic protocol design, and regulatory compliance."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:threat-surface-map ],
        ngm:security-framework ;
    vc:bridgesTo ngm:adversarial-robustness,
        ngm:ai-risk-management,
        ngm:formal-verification ;
    vc:contrastsWith ngm:penetration-testing,
        ngm:security-audit ;
    vc:dependsOn ngm:adversary-model,
        ngm:system-decomposition ;
    vc:enables ngm:cybersecurity,
        ngm:risk-mitigation,
        ngm:security-architecture,
        ngm:security-by-design ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:adversary-profile,
        ngm:threat-surface-map,
        ngm:trust-boundary ;
    vc:implements ngm:dolev-yao-model ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:cryptographic-protocol,
        ngm:regulatory-compliance,
        ngm:threat-surface-map ;
    vc:requires ngm:asset-inventory,
        ngm:data-flow-diagram ;
    vc:slug "threat-model" ;
    vc:sourceDomain "security" ;
    vc:standardizedBy ngm:mitre-attck,
        ngm:nist-cybersecurity-framework ;
    vc:uses ngm:attack-vector,
        ngm:cvss,
        ngm:risk-assessment,
        ngm:stride-framework,
        ngm:vulnerability .

ngm:threat-modelling a owl:Class ;
    rdfs:label "Threat Modelling"@en ;
    rdfs:comment "Threat modelling is a structured security engineering process that identifies, enumerates, and prioritises potential threats to a system by reasoning systematically about adversaries, attack vectors, and mitigations before or during design. It produces an explicit model of what can go wrong, enabling security controls to be allocated proportionally to risk, and is applied across software, hardware, and AI systems throughout the development lifecycle."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:system-architecture ],
        ngm:risk-assessment ;
    vc:bridgesTo ngm:ai-safety,
        ngm:supply-chain-risk-management ;
    vc:contrastsWith ngm:reactive-security,
        ngm:vulnerability-analysis ;
    vc:enables ngm:risk-mitigation,
        ngm:security-by-design,
        ngm:vulnerability-management ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:attack-surface-analysis,
        ngm:threat-enumeration,
        ngm:trust-boundary ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:penetration-testing,
        ngm:security-risk-management,
        ngm:vulnerability-assessment ;
    vc:requires ngm:adversary-model,
        ngm:system-architecture ;
    vc:slug "threat-modelling" ;
    vc:sourceDomain "security" ;
    vc:standardizedBy ngm:iso-27001,
        ngm:nist-sp-800-30 ;
    vc:supports ngm:secure-software-development-lifecycle,
        ngm:security-controls ;
    vc:uses ngm:attack-tree,
        ngm:attack-vector,
        ngm:cvss,
        ngm:data-flow-diagram,
        ngm:stride,
        ngm:threat-model .

ngm:threshold-cryptography a owl:Class ;
    rdfs:label "Threshold Cryptography"@en ;
    rdfs:comment "Threshold cryptography is a branch of cryptography in which a secret — such as a private key, decryption key, or signing capability — is distributed among a set of n parties such that any qualifying subset of at least t parties can jointly perform the cryptographic operation, while no coalition of fewer than t parties can do so alone. The t-of-n structure provides both redundancy and distributed access control: no single party holds complete key material, eliminating single points of compromise from theft, coercion, or insider malfeasance. The three primary primitives are threshold signatures, threshold decryption, and distributed key generation (DKG), with applications spanning cryptocurrency custody, distributed certificate authorities, multi-party computation protocols, and confidential smart contract execution. Modern protocols such as CGGMP21, GG20, and FROST have brought threshold operations to practical round counts suitable for production deployment."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:secure-multi-party-computation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:byzantine-fault-tolerance ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:threshold-signature-scheme ],
        ngm:cryptographic-primitive ;
    vc:bridgesTo ngm:differential-privacy,
        ngm:federated-learning ;
    vc:contrastsWith ngm:hardware-security-module,
        ngm:multi-sig-governance ;
    vc:dependsOn ngm:cryptographic-key-management,
        ngm:public-key-infrastructure ;
    vc:enables ngm:cryptocurrency-storage,
        ngm:decentralised-identity,
        ngm:distributed-validator-technology,
        ngm:privacy-preserving-technology ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:distributed-key-generation,
        ngm:secret-sharing,
        ngm:threshold-signature-scheme ;
    vc:implements ngm:access-control,
        ngm:fault-tolerance ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:federated-learning,
        ngm:homomorphic-encryption ;
    vc:requires ngm:byzantine-fault-tolerance,
        ngm:secure-multi-party-computation ;
    vc:slug "threshold-cryptography" ;
    vc:sourceDomain "security" ;
    vc:supports ngm:blockchain-consensus,
        ngm:smart-contract ;
    vc:uses ngm:elliptic-curve-cryptography,
        ngm:homomorphic-encryption,
        ngm:shamir-secret-sharing,
        ngm:zero-knowledge-proof .

