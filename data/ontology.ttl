    vc:dependsOn ngm:blockchain,
        ngm:public-key-infrastructure ;
    vc:enables ngm:dividend-distribution,
        ngm:fractional-ownership,
        ngm:on-chain-cap-table ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:investor-whitelist,
        ngm:security-token-offering,
        ngm:transfer-restriction ;
    vc:isPartOf ngm:digital-asset-trading,
        ngm:tokenised-capital-market ;
    vc:qualityScore "0.75"^^xsd:float ;
