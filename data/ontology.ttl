        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptographic-protocol ],
        ngm:cybersecurity ;
    vc:bridgesTo ngm:ai-security,
        ngm:post-quantum-cryptography ;
    vc:contrastsWith ngm:51-attack,
        ngm:double-spending,
        ngm:reentrancy-attack,
        ngm:sybil-attack ;
    vc:enables ngm:decentralised-finance,
