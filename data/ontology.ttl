        ngm:design-database,
        ngm:machine-learning-discipline-infrastructure ;
    vc:slug "generative-design-tool" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:generator-network a owl:Class ;
    rdfs:label "Generator Network"@en ;
    rdfs:comment "A generator network is the synthesis component of a generative deep learning architecture — most prominently within Generative Adversarial Networks (GANs) — that learns to map samples from a low-dimensional latent space into high-dimensional data outputs (images, audio, video, 3D shapes) whose statistical distribution matches that of a training dataset. The generator is trained in adversarial competition with a discriminator network, receiving gradient signal not from direct comparison with target samples but from the discriminator's attempt to distinguish generated from real samples, forcing the generator to produce increasingly realistic outputs. Generator networks are the conceptual precursors to the decoder components of VAEs and the denoising networks of diffusion models."@en ;
    rdfs:subClassOf ngm:generative-model ;
    vc:enables ngm:image-generation,
        ngm:style-transfer,
        ngm:synthetic-data-generator ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:deep-generative-model,
        ngm:variational-autoencoders ;
    vc:slug "generator-network" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:generative-adversarial-network,
        ngm:neural-network-architecture,
        ngm:neural-network-latent-space .

ngm:gold-standard a owl:Class ;
    rdfs:label "Gold Standard"@en ;
    rdfs:comment "A monetary system in which a currency's value is legally fixed to and redeemable in a defined quantity of gold, constraining the total money supply to the size of gold reserves held by the issuing authority. Under this regime, exchange rates between participating countries are effectively fixed because each currency is independently pegged to gold at a known rate, enabling automatic balance-of-payments adjustment through the price-specie-flow mechanism. The classical gold standard operated broadly from the 1870s until the outbreak of World War I in 1914, was briefly restored in modified forms during the interwar period, and gave way to the Bretton Woods system of dollar-gold convertibility in 1944, which itself ended in 1971 when the United States suspended gold convertibility."@en ;
    rdfs:subClassOf ngm:monetary-system ;
    vc:bridgesTo ngm:blockchain,
        ngm:cryptocurrency ;
    vc:contrastsWith ngm:fiat-currency,
        ngm:floating-exchange-rate,
        ngm:quantitative-easing ;
    vc:dependsOn ngm:central-bank,
        ngm:monetary-policy ;
    vc:enables ngm:balance-of-payments,
        ngm:international-trade,
        ngm:price-stability ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:isPartOf ngm:international-monetary-system,
        ngm:monetary-system ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:bretton-woods-system,
        ngm:commodity-money,
        ngm:currency-peg,
        ngm:deflation,
        ngm:inflation,
        ngm:reserve-currency,
        ngm:specie-flow-mechanism ;
    vc:requires ngm:currency-convertibility,
        ngm:fixed-exchange-rate,
        ngm:gold-reserve ;
    vc:slug "gold-standard" ;
    vc:sourceDomain "finance" .

ngm:human-ai-collaboration a skos:Concept ;
    rdfs:label "Human AI Collaboration"@en .

ngm:hyperledger-foundation a owl:Class ;
    rdfs:label "Hyperledger Foundation"@en ;
    rdfs:comment "The Hyperledger Foundation is an open-source collaborative initiative hosted by the Linux Foundation, founded in December 2015, that stewards a portfolio of enterprise-grade distributed ledger frameworks, identity toolkits, and interoperability libraries. Its flagship projects include Hyperledger Fabric (a modular permissioned DLT with pluggable consensus and chaincode-based smart contracts), Hyperledger Besu (an Ethereum-compatible client for public and private enterprise networks), Hyperledger Aries (a decentralised identity and verifiable credentials stack), and Hyperledger Cacti (a cross-ledger interoperability framework). The Foundation operates under an open-governance model with a Technical Steering Committee, project lifecycle governance (Incubation, Graduated, Dormant), and membership tiers spanning major technology vendors, financial institutions, and government bodies worldwide."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:hyperledger-aries ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:hyperledger-fabric ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:hyperledger-besu ],
        ngm:bc-governance-and-regulation ;
    skos:broader ngm:bc-governance-and-regulation ;
    vc:bridgesTo ngm:decentralised-ai,
        ngm:digital-identity,
        ngm:supply-chain-management ;
    vc:contrastsWith ngm:ethereum,
        ngm:quorum,
        ngm:r3-corda ;
    vc:enables ngm:enterprise-blockchain,
        ngm:permissioned-blockchain,
        ngm:self-sovereign-identity ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:hyperledger-aries,
        ngm:hyperledger-besu,
        ngm:hyperledger-cacti,
        ngm:hyperledger-fabric ;
    vc:implements ngm:distributed-ledger-technology,
        ngm:smart-contracts ;
    vc:isPartOf ngm:linux-foundation ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:blockchain-governance,
        ngm:consensus-mechanism,
        ngm:open-source-foundation,
        ngm:open-source-software ;
    vc:slug "hyperledger-foundation" ;
    vc:sourceDomain "blockchain" ;
    vc:standardizedBy ngm:linux-foundation,
        ngm:w3c ;
    vc:supports ngm:decentralised-identity,
        ngm:supply-chain-blockchain,
        ngm:verifiable-credentials ;
    vc:uses ngm:byzantine-fault-tolerance,
        ngm:open-governance .

ngm:industry-4-0 a owl:Class ;
    rdfs:label "Industry 4.0"@en ;
    rdfs:comment "Industry 4.0 denotes the fourth industrial revolution, characterised by the integration of cyber-physical systems, industrial Internet of Things, cloud computing, advanced robotics, and artificial intelligence into manufacturing and supply chain operations to create smart, autonomous, and highly flexible production environments. Originating from a German government initiative, it represents a strategic framework for digitalising industrial production through real-time data exchange, machine intelligence, and networked automation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:smart-manufacturing ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:predictive-maintenance ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:human-robot-collaboration ],
        ngm:industrial-automation ;
    vc:bridgesTo ngm:industrial-metaverse,
        ngm:supply-chain-management ;
    vc:contrastsWith ngm:industry-5-0 ;
    vc:dependsOn ngm:industrial-cybersecurity,
        ngm:it-ot-convergence ;
    vc:enables ngm:autonomous-manufacturing,
        ngm:mass-customisation,
        ngm:smart-city ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:human-robot-collaboration,
        ngm:predictive-maintenance,
        ngm:smart-manufacturing ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:additive-manufacturing,
        ngm:advanced-robotics ;
    vc:requires ngm:industrial-network,
        ngm:operational-technology ;
    vc:slug "industry-4-0" ;
    vc:sourceDomain "infrastructure" ;
    vc:standardizedBy ngm:opc-ua,
        ngm:rami-4-0 ;
    vc:uses ngm:cloud-computing,
