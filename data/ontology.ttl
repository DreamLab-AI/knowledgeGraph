    rdfs:label "Real World Assets"@en .

ngm:real-world-data a skos:Concept ;
    rdfs:label "Real World Data"@en .

ngm:reality-capture-workflow a owl:Class ;
    rdfs:label "Reality Capture Workflow"@en ;
    rdfs:comment "A reality capture workflow is the end-to-end pipeline that converts real-world objects, people, or environments into digital 3D assets through sensing, alignment, reconstruction, and optimisation stages. It typically chains scanning techniques such as photogrammetry, LiDAR, or volumetric capture with mesh generation, texturing, and retopology steps. The workflow matters because asset fidelity and downstream usability depend on disciplined sequencing of capture, processing, and cleanup."@en ;
    rdfs:subClassOf ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:digital-performance-capture,
        ngm:photogrammetry ;
    vc:slug "reality-capture-workflow" ;
    vc:sourceDomain "metaverse" .

ngm:reality-eth-oracle a owl:Class ;
    rdfs:label "Reality ETH Oracle"@en ;
    rdfs:comment "Reality.eth is an Ethereum-based crowdsourced oracle that resolves arbitrary questions by escalating bonds, allowing anyone to post or challenge answers until an economically final result is reached. It feeds resolved outcomes into smart contracts and is widely used to settle governance proposals and prediction-market events. The escalation-game design lets it answer subjective or off-chain questions that price-feed oracles cannot."@en ;
    rdfs:subClassOf ngm:bc-defi-and-economics ;
    skos:broader ngm:bc-defi-and-economics ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:dao-tooling,
        ngm:snapshot-voting ;
    vc:slug "reality-eth-oracle" ;
    vc:sourceDomain "blockchain" .

ngm:realitykit a skos:Concept ;
    rdfs:label "Realitykit"@en .

ngm:reasoning-models a owl:Class ;
    rdfs:label "Reasoning Models"@en ;
    rdfs:comment "Reasoning models are large language models trained or post-trained to generate extended intermediate chains of thought before producing a final answer, trading inference-time compute for higher accuracy on complex tasks. They are typically optimised with reinforcement learning on verifiable problems in mathematics, coding, and logic. By spending more tokens deliberating, they outperform standard models on multi-step problems where single-pass generation fails."@en ;
    rdfs:subClassOf ngm:large-language-models ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:frontier-models,
        ngm:prime-intellect ;
    vc:slug "reasoning-models" ;
    vc:sourceDomain "ai" .

ngm:receding-horizon a skos:Concept ;
    rdfs:label "Receding Horizon"@en .

ngm:record-keeping-system a owl:Class ;
    rdfs:label "Record Keeping System"@en ;
    rdfs:comment "A Record Keeping System, in the blockchain domain, is an immutable, append-only ledger in which transactions or state changes are cryptographically hashed, linked via Merkle trees, and validated by a consensus mechanism to provide a tamper-evident audit trail. It replaces or augments traditional centralised databases in applications requiring transparent provenance, non-repudiation, and multi-party data integrity—including asset registries, supply-chain tracking, and compliance logging."@en ;
    rdfs:subClassOf ngm:bc-network-component ;
    skos:broader ngm:bc-network-component ;
    vc:enables ngm:audit-trail,
        ngm:data-integrity,
        ngm:data-provenance ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:data-governance,
        ngm:smart-contract ;
    vc:slug "record-keeping-system" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:consensus-mechanism,
        ngm:cryptographic-hash,
        ngm:distributed-ledger,
        ngm:merkle-tree .

