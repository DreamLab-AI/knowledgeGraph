            owl:someValuesFrom ngm:dynamic-batching ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:container-orchestration ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:autoscaling ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:load-balancer ],
        ngm:model-serving ;
    vc:bridgesTo ngm:api-gateway,
        ngm:edge-computing ;
    vc:contrastsWith ngm:model-training,
        ngm:offline-batch-processing ;
    vc:dependsOn ngm:distributed-computing,
        ngm:model-registry ;
    vc:enables ngm:batch-inference,
        ngm:llm-deployment,
        ngm:real-time-inference ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:autoscaling,
        ngm:dynamic-batching,
        ngm:model-runtime,
        ngm:observability,
        ngm:request-queue ;
    vc:isPartOf ngm:ai-infrastructure,
        ngm:mlops ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:latency,
        ngm:service-level-objective,
        ngm:throughput,
        ngm:triton-inference-server ;
    vc:requires ngm:ai-model-inference-engine,
        ngm:container-orchestration,
        ngm:gpu,
        ngm:load-balancer ;
    vc:slug "inference-serving" ;
    vc:sourceDomain "machine-learning" ;
    vc:uses ngm:kv-cache,
        ngm:neural-network-quantisation,
        ngm:tensor-parallelism .

ngm:knowledge-transfer a owl:Class ;
    rdfs:label "Knowledge Transfer"@en ;
    rdfs:comment "Knowledge transfer is the movement of expertise, skills and understanding from one person, team or system to another. In collaborative work it occurs through mentoring, shared practice and direct interaction, allowing tacit know-how to spread across an organisation. It is a key outcome of practices such as remote pair programming."@en ;
