    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:conversational-ai,
        ngm:large-language-model ;
    vc:requires ngm:benchmarks ;
    vc:slug "human-evaluation" ;
    vc:sourceDomain "ai" ;
    vc:supports ngm:model-comparison,
        ngm:preference-learning ;
    vc:uses ngm:a-b-testing,
        ngm:crowdsourcing,
        ngm:inter-annotator-agreement .

ngm:human-pose-slam-capture-system a owl:Class ;
    rdfs:label "Human Pose SLAM Capture System"@en ;
    rdfs:comment "A Human Pose SLAM Capture System is an integrated sensing and computation pipeline that simultaneously localises a device within an unknown environment (SLAM) while continuously tracking the full-body skeletal pose of one or more human occupants in real time. It fuses data from depth cameras, inertial measurement units, and RGB imagery through probabilistic state estimation — typically particle filters or factor-graph optimisers — to produce a joint world model of both the static scene geometry and dynamic human kinematics. The output drives applications including markerless motion capture, avatar animation in extended reality, safety-aware robot navigation around people, and persistent spatial AI anchoring. The discipline sits at the intersection of computer vision, human-computer interaction, and spatial computing, with maturing industrial deployments in XR headsets, telepresence rigs, and autonomous vehicle pedestrian tracking."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:loop-closure-detection ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:real-time-processing ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:sensor-fusion ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:computer-vision ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:3-d-scene-reconstruction ],
        ngm:simultaneous-localisation-and-mapping ;
    vc:bridgesTo ngm:autonomous-navigation ;
    vc:dependsOn ngm:neural-network-inference,
        ngm:point-cloud-processing ;
    vc:enables ngm:avatar-animation,
        ngm:extended-reality,
        ngm:human-robot-interaction,
        ngm:motion-capture,
        ngm:spatial-mapping ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:3-d-scene-reconstruction,
        ngm:loop-closure-detection ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:digital-twin,
        ngm:spatial-anchoring ;
    vc:requires ngm:computer-vision,
        ngm:real-time-processing,
        ngm:sensor-fusion ;
    vc:slug "human-pose-slam-capture-system" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:depth-sensing,
        ngm:factor-graph-optimisation,
        ngm:inertial-measurement-unit,
        ngm:pose-estimation,
        ngm:rgb-d-camera,
        ngm:slam .

ngm:hydraulic-cylinder a owl:Class ;
    rdfs:label "Hydraulic Cylinder"@en ;
    rdfs:comment "A hydraulic cylinder is a mechanical actuator that converts hydraulic pressure and fluid flow into unidirectional linear force and motion. It consists of a cylindrical barrel, piston, piston rod, end caps, and seals; pressurised fluid acts on the piston face to extend or retract the rod, generating forces from tens of newtons to several meganewtons depending on bore diameter and system pressure. Hydraulic cylinders are foundational components in industrial robots, heavy machinery, manufacturing automation, and construction equipment where high force density and precise position control are required."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:hydraulic-motor ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:feedback-control ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:pressure-sensor ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:chinese-seal-art-ai-classification-pipeline ],
        ngm:hydraulic-actuator,
        ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:contrastsWith ngm:pneumatic-cylinder,
        ngm:servo-motor ;
    vc:enables ngm:force-control,
        ngm:industrial-robot,
        ngm:motion-control ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:chinese-seal-art-ai-classification-pipeline,
        ngm:pressure-sensor ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:industrial-automation,
        ngm:robot-joint ;
    vc:requires ngm:feedback-control,
        ngm:hydraulic-motor ;
    vc:slug "hydraulic-cylinder" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:pid-control,
        ngm:position-control .

ngm:hyperbitcoinization a owl:Class ;
    rdfs:label "Hyperbitcoinization"@en ;
    rdfs:comment "Hyperbitcoinization is a theoretical macroeconomic scenario, first articulated by Daniel Krawisz in 2014, in which Bitcoin undergoes a self-reinforcing demonetisation of fiat currencies and becomes the dominant global monetary unit. The process is modelled as a currency substitution accelerated by the Cantillon effect: as fiat monetary expansion erodes purchasing power, rational economic actors progressively shift savings and transactional balances into Bitcoin, increasing its adoption and liquidity, which in turn makes it more attractive as a medium of exchange. Unlike hyperinflation, which is an involuntary collapse of a fiat currency, hyperbitcoinization is theorised as a voluntary migration driven by Bitcoin's superior monetary properties — fixed supply, self-custody, and censorship resistance — ultimately displacing state-issued money."@en ;
    rdfs:subClassOf ngm:bitcoin-proof-of-work-protocol-value-proposition ;
    vc:contrastsWith ngm:central-bank-digital-currency,
        ngm:monetary-sovereignty ;
    vc:enables ngm:bitcoin-proof-of-work-protocol-distribution ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:bitcoin-proof-of-work-protocol-as-money,
        ngm:bitcoin-proof-of-work-protocol-standard,
        ngm:inflation,
        ngm:sound-money ;
    vc:slug "hyperbitcoinization" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:bitcoin-proof-of-work-protocol-network,
        ngm:lightning-network .

ngm:hyperledger-aries a owl:Class ;
    rdfs:label "Hyperledger Aries"@en ;
    rdfs:comment "Hyperledger Aries is an open-source toolkit providing the infrastructure for peer-to-peer interactions, secure messaging, and the exchange of verifiable credentials between decentralised identity agents. It implements DIDComm messaging and credential protocols, sitting above the ledger layer so that agents can issue, hold, and verify credentials independently of any specific blockchain. Aries is commonly paired with Hyperledger Indy as its verifiable-data registry."@en ;
    rdfs:subClassOf ngm:digital-identity ;
    vc:dependsOn ngm:hyperledger-indy ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:hyperledger-indy ;
    vc:slug "hyperledger-aries" ;
    vc:sourceDomain "infrastructure" .

ngm:image-captioning a owl:Class ;
    rdfs:label "Image Captioning"@en ;
    rdfs:comment "Image captioning is the artificial-intelligence task of generating a natural-language description of the content of an image. It sits at the intersection of computer vision and natural-language generation, typically pairing a visual encoder that extracts image features with a language decoder that produces a fluent sentence. Modern systems use attention mechanisms and large vision-language models to ground the generated text in salient regions of the image."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:natural-language-processing ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:computer-vision ],
        ngm:computer-vision ;
    vc:bridgesTo ngm:generative-ai ;
    vc:contrastsWith ngm:object-detection ;
    vc:dependsOn ngm:deep-learning ;
    vc:enables ngm:accessibility,
        ngm:scene-understanding ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:natural-language-processing ;
    vc:isPartOf ngm:computer-vision ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:computer-vision,
        ngm:generative-ai,
        ngm:object-detection,
        ngm:scene-understanding ;
    vc:requires ngm:computer-vision,
        ngm:natural-language-processing ;
    vc:slug "image-captioning" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:object-detection ;
    vc:uses ngm:attention-mechanism,
        ngm:deep-learning,
        ngm:transformer .

ngm:image-to-image a owl:Class ;
    rdfs:label "Image-to-Image"@en ;
    rdfs:comment "Image-to-image is a class of generative tasks where a model transforms an input image into an output image, conditioned on the input and often a text prompt. Examples include style transfer, editing and translation between domains."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:diffusion-model ],
        ngm:image-generation ;
    vc:enables ngm:inpainting ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:diffusion-model ;
    vc:slug "image-to-image" ;
    vc:sourceDomain "ai" .

ngm:image-to-image-translation a owl:Class ;
    rdfs:label "Image to Image Translation"@en ;
    rdfs:comment "Image-to-Image Translation transforms images from one visual domain to another whilst preserving content structure, converting between image modalities such as sketch-to-photo, day-to-night, satellite-to-map, or style transfer between artistic styles."@en ;
    rdfs:subClassOf ngm:sc-display-and-rendering ;
    skos:broader ngm:sc-display-and-rendering ;
    vc:dependsOn ngm:computer-vision,
        ngm:convolutional-neural-network ;
    vc:enables ngm:image-generation,
        ngm:style-transfer ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:slug "image-to-image-translation" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:diffusion-model,
        ngm:generative-adversarial-network .

ngm:immersive-interface a owl:Class ;
    rdfs:label "Immersive Interface"@en ;
    rdfs:comment "User interaction systems for VR, AR, and metaverse applications encompassing spatial user interfaces, haptic feedback devices, gesture recognition, voice control, and multimodal input mods that enable natural, intuitive engagement with virtual environments."@en ;
    rdfs:subClassOf ngm:human-computer-interface,
        ngm:sc-interaction ;
    skos:broader ngm:sc-interaction ;
    vc:enables ngm:natural-interaction ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:slug "immersive-interface" ;
    vc:sourceDomain "spatial-computing" .

ngm:immutable-infrastructure a owl:Class ;
    rdfs:label "Immutable Infrastructure"@en ;
    rdfs:comment "Immutable infrastructure is an operational model in which servers and components are never modified after deployment; instead, any change is delivered by building a new versioned artefact (image or container) and replacing the running instance. This eliminates configuration drift, makes deployments reproducible and rollbacks trivial, and pairs naturally with infrastructure-as-code and automated pipelines. It contrasts with mutable, in-place patching of long-lived servers."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:configuration-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cloud-computing ],
        ngm:infrastructure ;
    skos:broader ngm:infrastructure ;
    vc:bridgesTo ngm:cloud-computing ;
    vc:dependsOn ngm:infrastructure-as-code ;
    vc:enables ngm:continuous-deployment ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:continuous-deployment,
        ngm:infrastructure-as-code ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:cloud-native,
        ngm:devops ;
    vc:requires ngm:cloud-computing,
        ngm:configuration-management ;
    vc:slug "immutable-infrastructure" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:cloud-native,
        ngm:devops ;
    vc:uses ngm:kubernetes .

ngm:imperial-college-london a owl:Class ;
    rdfs:label "Imperial College London"@en ;
    rdfs:comment "Imperial College London is a public research university in South Kensington, London, specialising in science, engineering, medicine, and business, founded in 1907 through the merger of the Royal College of Science, the Royal School of Mines, and the City and Guilds College. It gained full independence from the University of London on its centenary in 2007, and is consistently ranked among the world's top universities for STEM disciplines. The college is internationally recognised for research across artificial intelligence, machine learning, bioengineering, robotics, quantum computing, climate science, and computational biology. As a founding member of the Russell Group and a partner in numerous global research consortia, Imperial serves as a key node in the United Kingdom's knowledge and innovation infrastructure."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:high-performance-computing ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:research-funding ],
        ngm:ai-research-area ;
    skos:broader ngm:ai-research-area ;
    vc:bridgesTo ngm:digital-twin,
        ngm:spatial-computing ;
    vc:enables ngm:open-science,
        ngm:technology-transfer ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:russell-group ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:alan-turing-institute,
        ngm:research-institution,
        ngm:ukri,
        ngm:university-of-cambridge,
        ngm:university-of-edinburgh,
        ngm:university-of-oxford ;
    vc:requires ngm:high-performance-computing,
        ngm:research-funding ;
    vc:slug "imperial-college-london" ;
    vc:sourceDomain "ai" ;
    vc:supports ngm:artificial-intelligence-research,
        ngm:open-source-software ;
    vc:uses ngm:deep-learning,
        ngm:machine-learning,
        ngm:natural-language-processing,
        ngm:robotics .

ngm:in-memory-computing a owl:Class ;
    rdfs:label "In-Memory Computing"@en ;
    rdfs:comment "In-memory computing is an architectural approach that holds working data sets in a system's main memory (RAM) rather than on disk, eliminating storage-layer I/O from the critical path of data access and processing. By keeping data resident in fast volatile memory, it delivers order-of-magnitude reductions in latency and supports high-throughput analytics, transaction processing, and real-time decisioning. It typically pairs with techniques such as columnar layouts, distributed caching, and durability mechanisms (logging, replication, persistence) to combine speed with resilience."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:high-performance-computing ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:persistent-storage ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:memory-hierarchy ],
        ngm:infrastructure ;
    skos:broader ngm:infrastructure ;
    vc:contrastsWith ngm:persistent-storage ;
    vc:dependsOn ngm:database ;
    vc:enables ngm:real-time-processing,
        ngm:stream-processing ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:memory-hierarchy,
        ngm:persistent-storage ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:data-storage,
        ngm:latency,
        ngm:real-time-processing ;
    vc:requires ngm:high-performance-computing ;
    vc:slug "in-memory-computing" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:data-storage ;
    vc:uses ngm:hardware-acceleration,
        ngm:memory-hierarchy .

ngm:inference-optimisation a owl:Class ;
    rdfs:label "Inference Optimisation"@en ;
    rdfs:comment "Inference Optimisation encompasses techniques and processes for reducing the computational cost, latency, and memory footprint of deploying trained machine learning models at runtime. Methods include quantisation, pruning, knowledge distillation, and hardware-specific kernel fusion. The goal is to make model inference faster and more efficient without significantly degrading predictive accuracy."@en ;
    rdfs:subClassOf ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:model-compression ;
    vc:slug "inference-optimisation" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:inflationary-token a owl:Class ;
    rdfs:label "Inflationary Token"@en ;
    rdfs:comment "An Inflationary Token is a blockchain token whose total circulating supply increases over time through a programmatic emission schedule, typically as a mechanism to reward network participants—validators, miners, stakers, or liquidity providers—and incentivise ongoing network participation. Unlike fixed-supply or deflationary tokens, inflationary tokens accept dilution of existing holders as the cost of sustaining economic participation incentives. Inflation rates can be fixed (constant annual issuance), variable (decreasing block rewards as in Bitcoin's halving), or algorithmically adjusted in response to network conditions such as staking participation rates. Design of the emission schedule is a critical tokenomics decision balancing security, participation, and value preservation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:consensus-mechanism ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:blockchain ],
        ngm:bc-token-and-asset,
        ngm:blockchain-entity,
        ngm:economic-mechanism ;
    skos:broader ngm:bc-token-and-asset ;
    vc:contrastsWith ngm:deflationary-token,
        ngm:stablecoin-token ;
    vc:enables ngm:governance-token,
        ngm:mining ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:miner,
        ngm:proof-of-stake,
        ngm:proof-of-work,
        ngm:token,
        ngm:yield-farming ;
    vc:requires ngm:blockchain,
        ngm:consensus-mechanism ;
    vc:slug "inflationary-token" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:token-economics,
        ngm:tokenomics .

ngm:informed-search a owl:Class ;
    rdfs:label "Informed Search"@en ;
    rdfs:comment "A class of search algorithms in artificial intelligence that use domain-specific heuristic knowledge to guide exploration of the search space, reducing computational cost compared to uninformed search. Canonical examples include A* and greedy best-first search, which evaluate states using an estimate of the remaining cost to a goal."@en ;
    rdfs:subClassOf ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:enables ngm:autonomous-navigation,
        ngm:autonomous-system ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:machine-learning-discipline ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:active-learning,
        ngm:reinforcement-learning ;
    vc:slug "informed-search" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:machine-learning-discipline-technique .

ngm:institutional-trust a owl:Class ;
    rdfs:label "Institutional Trust"@en ;
    rdfs:comment "Institutional trust is the confidence that individuals and organisations place in formal institutions, such as central banks, regulators, courts, and clearing infrastructures, to act competently, fairly, and predictably in accordance with their stated mandates. Unlike interpersonal trust, it is impersonal and systemic: it rests on transparency, accountability, the rule of law, and a credible track record rather than personal acquaintance. Institutional trust underpins the functioning of fiat currency, financial markets, and governance, and its erosion is a primary driver of demand for trust-minimising alternatives such as blockchain systems."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:governance ],
        ngm:trust ;
    vc:bridgesTo ngm:cryptoasset-regulation ;
    vc:contrastsWith ngm:blockchain ;
    vc:dependsOn ngm:accountability,
        ngm:legitimacy,
        ngm:transparency ;
    vc:enables ngm:fiat-currency,
        ngm:financial-stability ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:regulation,
        ngm:risk-management ;
    vc:requires ngm:governance,
        ngm:reputation ;
    vc:slug "institutional-trust" ;
    vc:sourceDomain "finance" ;
    vc:supports ngm:central-bank,
        ngm:monetary-policy ;
    vc:uses ngm:social-capital .

ngm:instruction-set-architecture a owl:Class ;
    rdfs:label "Instruction Set Architecture"@en ;
    rdfs:comment "An Instruction Set Architecture (ISA) is the abstract contract between hardware and software that defines the instructions a processor can execute, its registers, data types, addressing modes and memory model. It is the stable interface that allows compilers and operating systems to target a processor family without knowing its microarchitectural implementation. Examples include x86, ARM and the open RISC-V ISA, each balancing complexity, power efficiency and ecosystem support."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:compiler ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:compiler ],
        ngm:cpu ;
    vc:bridgesTo ngm:compiler ;
    vc:contrastsWith ngm:virtual-machine ;
    vc:dependsOn ngm:cpu ;
    vc:enables ngm:compiler,
        ngm:operating-system,
        ngm:virtual-machine ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:compiler ;
    vc:implements ngm:cpu ;
    vc:isPartOf ngm:cpu ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:compiler,
        ngm:operating-system,
        ngm:virtual-machine ;
    vc:requires ngm:compiler ;
    vc:slug "instruction-set-architecture" ;
    vc:sourceDomain "infrastructure" ;
    vc:standardizedBy ngm:open-source ;
    vc:supports ngm:operating-system,
        ngm:parallel-computing ;
    vc:uses ngm:cpu .

ngm:integration-layer a owl:Class ;
    rdfs:label "Integration Layer"@en ;
    rdfs:comment "The Integration Layer is the cross-cutting stratum that connects otherwise independent systems so they can exchange data and invoke each other's functions. It sits above transport and protocol concerns and below the applications that orchestrate combined behaviour. It contains adapters, connectors, message translation, and the routing that mediates between heterogeneous endpoints."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:transport-layer ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:apilayer ],
        ngm:infra-software-engineering ;
    skos:broader ngm:infra-software-engineering ;
    vc:enables ngm:application-layer,
        ngm:coordination-layer ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:apilayer,
        ngm:transport-layer ;
    vc:slug "integration-layer" ;
    vc:sourceDomain "infrastructure" .

ngm:intel-sgx a owl:Class ;
    rdfs:label "Intel SGX"@en ;
    rdfs:comment "Intel SGX (Software Guard Extensions) is a set of Intel processor instructions that create hardware-isolated memory regions called enclaves, protecting sensitive code and data from the operating system, hypervisor, and other privileged software on the same system, with remote attestation enabling third-party verification of enclave integrity."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:intel ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:remote-attestation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:encryption ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:hardware ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:secure-enclave ],
        ngm:trusted-execution-environment ;
    vc:bridgesTo ngm:blockchain,
        ngm:distributed-collaboration,
        ngm:machine-learning ;
    vc:contrastsWith ngm:amd-sev,
        ngm:arm-trust-zone ;
    vc:dependsOn ngm:encryption,
        ngm:hardware,
        ngm:key-management ;
    vc:enables ngm:confidential-computing,
        ngm:information-security,
        ngm:secure-multi-party-computation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:remote-attestation,
        ngm:secure-enclave ;
    vc:implements ngm:hardware-security-module,
        ngm:trusted-execution-environment ;
    vc:isPartOf ngm:confidential-computing,
        ngm:intel ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:hypervisor,
        ngm:side-channel-attack ;
    vc:requires ngm:encryption,
        ngm:hardware,
        ngm:intel ;
    vc:slug "intel-sgx" ;
    vc:sourceDomain "security" ;
    vc:supports ngm:secure-multi-party-computation,
        ngm:zero-knowledge-proof ;
    vc:uses ngm:aes-encryption,
        ngm:public-key-infrastructure .

ngm:interface-design a owl:Class ;
    rdfs:label "Interface Design"@en ;
    rdfs:comment "Interface design is the discipline of defining the boundaries, contracts, and points of interaction between components, systems, or between a system and its users. In software it encompasses both human-facing user interface design and machine-facing application programming interface design, focusing on clarity, consistency, and ease of correct use. Good interface design minimises coupling, communicates intent, and shapes how reliably and pleasantly the parts of a system can be combined or operated."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:api-design ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:usability ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:interaction-design ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:information-architecture ],
        ngm:infrastructure ;
    skos:broader ngm:infrastructure ;
    vc:enables ngm:usability ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:api-design,
        ngm:interaction-design ;
    vc:implements ngm:interaction-design ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:accessibility,
