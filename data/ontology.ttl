    vc:requires ngm:convolution,
        ngm:discrete-cosine-transform ;
    vc:slug "video-codec" ;
    vc:sourceDomain "infrastructure" ;
    vc:standardizedBy ngm:compliance-standards,
        ngm:open-media-alliance ;
    vc:supports ngm:cdn,
