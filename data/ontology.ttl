    vc:uses ngm:robot-control .
ngm:autonomous-manufacturing a owl:Class ;
    rdfs:comment "Autonomous manufacturing is a production model in which robotic systems and automated machinery execute manufacturing tasks — assembly, inspection, material handling, and quality control — with minimal or no direct human intervention, coordinated by software that senses conditions and adapts in real time. It extends manufacturing automation by incorporating perception, planning, and decision-making capabilities that let equipment respond to variation on the production line rather than following fixed, pre-programmed sequences. Autonomous manufacturing is a core pillar of Industry 4.0 initiatives that seek to combine robotics, sensing, and data analytics across the factory floor."@en ;
    rdfs:label "Autonomous Manufacturing"@en ;
    rdfs:subClassOf ngm:manufacturing-automation ;
    rdfs:subClassOf _:r2444 ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires ngm:industry-4-0 ;
    vc:slug "autonomous-manufacturing" ;
    vc:sourceDomain "robotics" .
