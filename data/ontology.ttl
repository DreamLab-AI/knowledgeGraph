        ngm:ros .

ngm:service-discovery a owl:Class ;
    rdfs:label "Service Discovery"@en ;
    rdfs:comment "Service discovery is the runtime mechanism by which distributed applications automatically locate the network endpoints of services they depend on, without relying on hardcoded addresses or manual configuration. It operates through a service registry that maintains a dynamic catalogue of available service instances alongside their health status, enabling clients to resolve service names to live endpoints at query time. Discovery patterns divide into client-side discovery, where the consumer queries the registry directly and selects from returned healthy instances, and server-side discovery, where a load balancer or API gateway mediates resolution transparently. It is a foundational pattern in microservices and cloud-native architectures, enabling dynamic scaling, zero-downtime rolling updates, and fault-tolerant inter-service communication."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:service-registry ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:health-check ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:service-registry ],
        ngm:distributed-system-architecture ;
    vc:bridgesTo ngm:ai-agent,
        ngm:tool-use ;
    vc:contrastsWith ngm:configuration,
        ngm:monolithic-architecture ;
    vc:dependsOn ngm:consensus-algorithm,
        ngm:dns,
        ngm:load-balancing ;
    vc:enables ngm:fault-tolerance,
        ngm:horizontal-scalability,
        ngm:operational-resilience,
        ngm:zero-downtime-deployment ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:health-check,
        ngm:service-registry ;
    vc:isPartOf ngm:cloud-native,
        ngm:microservices-architecture ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:circuit-breaker,
        ngm:configuration-management,
        ngm:distributed-systems,
        ngm:orchestration,
        ngm:sidecar-proxy ;
    vc:requires ngm:network-addressing,
        ngm:service-registry ;
    vc:slug "service-discovery" ;
    vc:sourceDomain "distributed-systems" ;
    vc:supports ngm:container-orchestration,
        ngm:distributed-system,
        ngm:microservices ;
    vc:uses ngm:api-gateway,
        ngm:kubernetes,
        ngm:service-mesh .

ngm:smart-contract-platform a owl:Class ;
    rdfs:label "Smart Contract Platform"@en ;
    rdfs:comment "A Smart Contract Platform is a blockchain-based infrastructure layer that provides a deterministic execution environment for self-executing programmable agreements, enabling decentralised application (dApp) development through virtual machine runtimes, developer toolchains, consensus-enforced state transitions, and economic incentive mechanisms such as gas metering. These platforms extend base-layer blockchains with Turing-complete or domain-specific scripting capabilities, allowing arbitrary business logic to be encoded and trustlessly enforced on a shared public ledger. Prominent examples include Ethereum and its EVM-compatible derivatives, Solana with its Sealevel parallel runtime, Cardano with its Plutus/eUTXO model, and Polkadot with its ink! WebAssembly runtime. Each platform makes distinct design trade-offs across the performance-security-decentralisation trilemma and imposes its own programming model, fee structure, and upgrade governance."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:virtual-machine ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:gas-metering ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:distributed-ledger ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:consensus-mechanism ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:blockchain ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:smart-contract ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptographic-hash-function ],
        ngm:blockchain ;
    skos:broader ngm:blockchain ;
    vc:bridgesTo ngm:decentralised-identity,
        ngm:multi-party-computation,
        ngm:supply-chain-traceability ;
    vc:contrastsWith ngm:traditional-contract ;
    vc:dependsOn ngm:merkle-tree,
        ngm:peer-to-peer-network,
        ngm:public-key-cryptography ;
    vc:enables ngm:dao,
        ngm:decentralised-application,
        ngm:decentralized-finance-de-fi,
        ngm:non-fungible-token,
        ngm:token-standard ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:consensus-mechanism,
        ngm:gas-metering,
        ngm:smart-contract,
        ngm:virtual-machine ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:blockchain-interoperability,
        ngm:formal-verification,
        ngm:oracle-network,
        ngm:tokenomics ;
    vc:requires ngm:blockchain,
        ngm:cryptographic-hash-function,
        ngm:distributed-ledger ;
    vc:slug "smart-contract-platform" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:account-abstraction,
        ngm:layer-2-scaling,
        ngm:zero-knowledge-proof .

ngm:smart-grid a owl:Class ;
    rdfs:label "Smart Grid"@en ;
    rdfs:comment "A smart grid is a modernised electricity distribution and transmission network that integrates digital communication, real-time sensing, automated control, and distributed intelligence to improve efficiency, reliability, resilience, and sustainability relative to the traditional centralised grid. It enables bidirectional power and information flows, accommodating distributed generation from renewable sources, battery energy storage systems, demand-side flexibility, and vehicle-to-grid interactions. Advanced metering infrastructure, distribution automation, phasor measurement units, and AI-driven optimisation allow operators to balance supply and demand dynamically across thousands of grid-edge resources. Smart grids are a foundational component of low-carbon energy infrastructure and are governed by a set of interoperability standards spanning communications, cybersecurity, and market protocols."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:energy-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:edge-computing ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:interoperability ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cybersecurity ],
        ngm:cyber-physical-systems ;
    vc:bridgesTo ngm:federated-learning,
        ngm:reinforcement-learning ;
    vc:dependsOn ngm:power-management,
        ngm:telecommunications-infrastructure ;
    vc:enables ngm:energy-and-power,
        ngm:peer-to-peer-energy-trading,
        ngm:renewable-energy-certificates,
        ngm:vehicle-to-grid ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:advanced-metering-infrastructure,
        ngm:energy-management ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:anomaly-detection,
