ngm:virtual-background a owl:Class ;
    rdfs:label "Virtual Background"@en ;
    rdfs:comment "A Virtual Background is a real-time image or video composited behind a video-call participant using chroma-key or AI-based background segmentation, replacing the physical environment visible to the camera. It allows remote workers to project a professional or branded appearance regardless of their physical location, protecting privacy and maintaining visual consistency across distributed teams. Virtual backgrounds are natively supported in Zoom, Microsoft Teams, and Google Meet."@en ;
    rdfs:subClassOf ngm:dc-workspace-tools ;
    skos:broader ngm:dc-workspace-tools ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:zoom-meetings ;
    vc:slug "virtual-background" ;
    vc:sourceDomain "distributed-collaboration" .

ngm:virtual-economy-market-framing a owl:Class ;
    rdfs:label "Virtual Economy Market Framing"@en ;
    rdfs:comment "A conceptual framing of metaverse platforms as economic ecosystems in which virtual goods, services, experiences, and digital assets are produced, traded, and consumed. This view foregrounds creator economies, digital ownership, interoperable asset standards, and market dynamics including adoption curves, pricing models, and regulatory challenges specific to virtual worlds."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:digital-goods ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:creator-economy ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:interoperability ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:digital-identity ],
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:dependsOn ngm:metaverse-platform ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:creator-economy,
        ngm:digital-goods ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:blockchain,
        ngm:digital-economy ;
    vc:requires ngm:digital-identity,
        ngm:interoperability ;
    vc:slug "virtual-economy-market-framing" ;
    vc:sourceDomain "spatial-computing" .

ngm:virtual-labor a owl:Class ;
    rdfs:label "Virtual Labor"@en ;
    rdfs:comment "Work performed in virtual environments that generates economic value, spanning content creation, service provision, virtual construction, platform governance, and social labour. Virtual labour is often platform-dependent, contract-based, and remunerated via virtual currency or revenue-sharing models, raising significant questions around labour rights, taxation of cross-border virtual income, and platform exploitation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:metaverse ],
        ngm:metaverse,
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:virtual-economy ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:governance-framework,
        ngm:land-economics ;
    vc:requires ngm:metaverse ;
    vc:slug "virtual-labor" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:digital-asset,
        ngm:virtual-currency .

