ngm:hardware-security-module a owl:Class ;
    rdfs:label "Hardware Security Module"@en ;
    rdfs:comment "A Hardware Security Module (HSM) is a dedicated, tamper-evident and tamper-resistant hardware appliance that generates, stores, and manages cryptographic keys in a physically protected environment, performing sensitive cryptographic operations—such as digital signing, bulk encryption, key derivation, and random-number generation—entirely within its secure boundary so that plaintext key material is never exposed to the host system. HSMs are validated against formal security standards including FIPS 140-2/140-3 (Levels 1–4) and Common Criteria EAL4+, and are mandated by payment card schemes (PCI-DSS, PCI-P2PE), certificate authority trust frameworks, and government PKI and national-security infrastructures. They are available as PCIe cards, rack-mounted network appliances, USB tokens, and cloud-hosted dedicated services, all exposing a standardised PKCS#11 (Cryptoki) API. Unlike software keystores or Trusted Execution Environments, HSMs respond to physical tamper events by irreversibly zeroing all stored key material, making them the highest-assurance key-custody mechanism in mainstream deployment."@en ;
    rdfs:subClassOf ngm:infra-security-and-identity ;
    skos:broader ngm:infra-security-and-identity ;
    vc:bridgesTo ngm:blockchain-key-custody,
        ngm:confidential-computing ;
    vc:contrastsWith ngm:secure-enclave,
        ngm:software-keystore,
        ngm:trusted-execution-environment,
        ngm:trusted-platform-module ;
    vc:enables ngm:certificate-authority,
        ngm:code-signing,
        ngm:key-management,
        ngm:payment-security,
        ngm:public-key-infrastructure,
        ngm:secure-boot ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.76"^^xsd:float ;
    vc:relatedTo ngm:cloud-key-management-service,
        ngm:cryptographic-hardware,
        ngm:cryptography,
        ngm:secure-element,
        ngm:zero-trust-architecture ;
    vc:requires ngm:hardware-root-of-trust,
        ngm:tamper-resistance ;
    vc:slug "hardware-security-module" ;
    vc:sourceDomain "security" ;
    vc:standardizedBy ngm:common-criteria,
        ngm:fips-140,
        ngm:pci-dss ;
    vc:uses ngm:asymmetric-key-cryptography,
        ngm:cryptographic-key-management,
        ngm:digital-signature,
        ngm:encryption,
        ngm:pkcs11,
        ngm:random-number-generation,
        ngm:symmetric-key-cryptography .

ngm:key-management a owl:Class ;
    rdfs:label "Key Management"@en ;
    rdfs:comment "Key management is the discipline governing the complete lifecycle of cryptographic keys, encompassing their generation using cryptographically secure random number generators and key derivation functions, secure distribution, protected storage in hardware security modules or key management services, scheduled rotation to limit exposure windows, and timely revocation upon compromise or expiry. It is a foundational control domain for all systems relying on confidentiality, integrity, and authentication guarantees, since even mathematically strong algorithms are rendered ineffective by weak key custody practices. Key management is mandated by security standards including NIST SP 800-57 and ISO/IEC 27001 Annex A.10, and underpins PKI, envelope encryption architectures, blockchain self-custody, and zero-trust identity frameworks."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:identity-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:random-number-generation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:access-control ],
        ngm:infra-security-and-identity ;
    skos:broader ngm:infra-security-and-identity ;
    vc:bridgesTo ngm:blockchain,
        ngm:decentralised-identity ;
    vc:contrastsWith ngm:password-management,
        ngm:secrets-management ;
    vc:enables ngm:digital-signature,
        ngm:encryption,
        ngm:secure-communication,
        ngm:zero-trust-architecture ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:certificate-lifecycle-management,
        ngm:key-generation,
        ngm:key-revocation,
        ngm:key-rotation ;
    vc:implements ngm:envelope-encryption,
        ngm:key-hierarchy ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:multi-party-computation,
        ngm:threshold-cryptography,
        ngm:tls ;
    vc:requires ngm:access-control,
        ngm:identity-management,
        ngm:random-number-generation ;
    vc:slug "key-management" ;
    vc:sourceDomain "security" ;
    vc:standardizedBy ngm:iso-iec-27001,
        ngm:nist-sp-800-57 ;
    vc:uses ngm:cryptography,
        ngm:hardware-security-module,
        ngm:key-derivation-function,
        ngm:public-key-infrastructure .

ngm:nist-ai-rmf a owl:Class ;
    rdfs:label "NIST AI RMF"@en ;
    rdfs:comment "The NIST AI Risk Management Framework (AI RMF) is a voluntary, technology-agnostic guidance document published by the National Institute of Standards and Technology in January 2023 that helps organisations identify, assess, and manage risks arising from the design, development, deployment, and operation of AI systems. It structures AI risk management practice through four core functions — Govern, Map, Measure, and Manage — forming a continuous lifecycle cycle applicable across sectors and organisational sizes. The framework explicitly promotes seven trustworthy-AI characteristics (accountable, explainable, fair, privacy-enhanced, reliable, resilient, and secure) as unifying goals, and is supported by a companion Playbook and a growing library of sector-specific profiles, including one for generative AI."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:stakeholder-engagement ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:risk-assessment ],
        ngm:ai-governance-framework ;
    vc:bridgesTo ngm:ai-risk,
        ngm:machine-learning-operations,
        ngm:responsible-ai ;
    vc:contrastsWith ngm:eu-ai-act,
        ngm:iso-42001 ;
    vc:enables ngm:accountability,
        ngm:ai-governance-maturity-model,
        ngm:ai-risk-management,
        ngm:trustworthy-ai ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:ai-rmf-govern-function,
        ngm:ai-rmf-manage-function,
        ngm:ai-rmf-map-function,
        ngm:ai-rmf-measure-function,
        ngm:ai-rmf-playbook ;
    vc:isPartOf ngm:us-ai-policy ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:ai-governance,
        ngm:algorithmic-impact-assessment,
        ngm:cybersecurity-framework,
        ngm:risk-management ;
    vc:requires ngm:organisational-governance,
        ngm:risk-assessment,
        ngm:stakeholder-engagement ;
    vc:slug "nist-ai-rmf" ;
    vc:sourceDomain "governance" ;
    vc:standardizedBy ngm:nist ;
    vc:supports ngm:ai-explainability,
        ngm:ai-safety,
        ngm:fairness,
        ngm:privacy,
        ngm:reliability,
        ngm:transparency .

ngm:physics-simulation a owl:Class ;
    rdfs:label "Physics Simulation"@en ;
    rdfs:comment "Physics Simulation is the computational modelling of physical phenomena — encompassing rigid-body dynamics, soft-body deformation, fluid behaviour, cloth simulation, collision detection, and constraint solving — to produce physically plausible behaviour in real-time or offline virtual environments. It applies classical mechanics, continuum mechanics, and numerical integration methods to generate deterministic or probabilistic trajectories of simulated objects and agents. Physics simulation is foundational to interactive 3D applications, robotics training, digital-twin fidelity, and scientific computation, enabling rapid exploration of scenarios that would be costly or dangerous in the physical world. Modern implementations exploit GPU parallelism, hierarchical spatial data structures, and position-based dynamics to meet real-time performance budgets across heterogeneous hardware."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:collision-detection ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:constraint-solver ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:fluid-simulation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:spatial-data-structure ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gpu-compute ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:rigid-body-dynamics ],
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:bridgesTo ngm:neural-physics,
        ngm:sim-to-real-transfer ;
    vc:contrastsWith ngm:kinematic-animation ;
    vc:enables ngm:augmented-reality,
        ngm:autonomous-vehicle,
        ngm:robotics,
        ngm:virtual-reality ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:collision-detection,
        ngm:constraint-solver,
        ngm:fluid-simulation,
        ngm:rigid-body-dynamics,
        ngm:soft-body-physics ;
    vc:isPartOf ngm:digital-twin,
        ngm:game-engine ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:3d-rendering,
        ngm:animation,
        ngm:real-time-systems,
        ngm:scientific-computing ;
    vc:requires ngm:gpu-compute,
        ngm:numerical-integration,
        ngm:spatial-data-structure ;
    vc:slug "physics-simulation" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:reinforcement-learning,
        ngm:robot-learning ;
    vc:uses ngm:finite-element-method,
        ngm:smoothed-particle-hydrodynamics .

ngm:w3-c a owl:Class ;
    rdfs:label "W3C"@en ;
    rdfs:comment "The World Wide Web Consortium (W3C) is the principal international standards organisation for the World Wide Web, founded by Tim Berners-Lee in 1994 and operating through a global membership model to develop open, interoperable web standards. W3C produces technical specifications, guidelines, and software that define the core technologies of the web including HTML, CSS, SVG, XML, RDF, and the semantic web stack. Its standards process emphasises consensus, royalty-free licensing, and broad implementability across browsers and platforms."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
