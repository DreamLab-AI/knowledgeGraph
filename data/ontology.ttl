        ngm:machine-learning,
        ngm:statistical-mechanics ;
    vc:contrastsWith ngm:chaos-theory,
        ngm:deterministic-systems ;
    vc:dependsOn ngm:filtration,
        ngm:sigma-algebra ;
    vc:enables ngm:bayesian-inference,
        ngm:quantitative-finance,
        ngm:queueing-theory,
        ngm:reinforcement-learning,
        ngm:stochastic-calculus ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:brownian-motion,
        ngm:markov-chain,
        ngm:martingale,
        ngm:poisson-process,
        ngm:random-walk ;
    vc:qualityScore "0.72"^^xsd:float ;
