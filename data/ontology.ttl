        ngm:generative-ai,
        ngm:ip-adapter,
        ngm:stable-diffusion-image-model ;
    vc:requires ngm:comfy-ui,
        ngm:git,
        ngm:python-package-management ;
    vc:slug "comfy-ui-manager" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:control-net,
        ngm:face-restoration,
        ngm:image-generation,
        ngm:image-upscaling,
        ngm:inpainting,
        ngm:ip-adapter,
