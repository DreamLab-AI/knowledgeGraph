    dcterms:subject "spatial-computing" ;
    owl:versionInfo "2.0.0" ;
    dcterms:created "2026-04-26T00:00:00Z"^^xsd:dateTime ;
    dcterms:modified "2026-04-26T13:00:00Z"^^xsd:dateTime ;
    vcw:owlRole "Concept" .

# Sentiment Analysis
spatial-computing:SentimentAnalysis rdf:type owl:Class ;
    rdfs:label "Sentiment Analysis"@en ;
    rdfs:comment "Sentiment Analysis is the NLP task of determining the emotional tone, attitude, or opinion expressed in text, classifying content as positive, negative, or neutral, and extracting fine-grained emotional attributes. Sentiment analysis employs transformer-based classifiers to enable applications in social media monitoring, customer feedback analysis, market research, and brand reputation management."@en ;
    skos:prefLabel "Sentiment Analysis"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:spatial-computing:sentiment-analysis" ;
    owl:sameAs <urn:visionclaw:concept:spatial-computing:sentiment-analysis> ;
    vcw:contentHash "sha256-12-6b0e8b7f19f2" ;
    vcw:qualityScore "0.5"^^xsd:decimal ;
    vcw:legacyTermId "AI-0369" ;
    vcw:ontologyStatus "draft" ;
    vcw:maturityLevel "draft" ;
    vcw:authorityScore "0.0"^^xsd:decimal ;
    dcterms:identifier "AI-0369" ;
