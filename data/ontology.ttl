ngm:lending-protocol a owl:Class ;
    rdfs:label "Lending Protocol"@en ;
    rdfs:comment "A smart-contract system that lets users supply assets to earn interest and borrow against deposited collateral, with interest rates and liquidations governed by on-chain code rather than intermediaries."@en ;
