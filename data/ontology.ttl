ngm:output a owl:Class ;
    rdfs:label "Output"@en ;
    rdfs:comment "An Output is a component of a blockchain transaction that specifies a recipient address and an amount of value to be transferred, forming the fundamental unit through which cryptocurrency is allocated and ownership is recorded on a distributed ledger. In UTXO-based systems such as Bitcoin, unspent outputs serve as inputs to subsequent transactions, creating a directed graph of value flows secured by digital signatures."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:digital-signature ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:address ],
        ngm:bc-protocol-and-consensus,
        ngm:blockchain-entity,
        ngm:distributed-data-structure ;
    skos:broader ngm:bc-protocol-and-consensus ;
    vc:enables ngm:smart-contract,
        ngm:token-economics ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:block,
        ngm:blockchain-transaction ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:audit-trail,
        ngm:blockchain-scalability,
        ngm:distributed-ledger-technology ;
    vc:requires ngm:address,
        ngm:digital-signature ;
    vc:slug "output" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:cryptographic-hash,
        ngm:script .

