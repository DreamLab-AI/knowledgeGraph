        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:peer-to-peer-network ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:proof-of-work ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptographic-hash-function ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:difficulty-adjustment ],
        ngm:consensus-protocol ;
    vc:bridgesTo ngm:distributed-systems,
        ngm:game-theory,
        ngm:mechanism-design ;
    vc:contrastsWith ngm:delegated-proof-of-stake,
        ngm:practical-byzantine-fault-tolerance,
        ngm:proof-of-stake ;
    vc:enables ngm:block-reward,
        ngm:decentralized-ledger,
        ngm:mining,
        ngm:permissionless-participation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:block-header,
        ngm:difficulty-adjustment,
        ngm:longest-chain-rule,
        ngm:nonce ;
    vc:isPartOf ngm:bitcoin-protocol,
        ngm:blockchain-network ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:51-percent-attack,
        ngm:byzantine-fault-tolerance,
