        ngm:transaction-confirmation ;
    vc:dependsOn ngm:blockchain-transaction,
        ngm:transaction-propagation,
        ngm:utxo ;
    vc:enables ngm:51-attack,
        ngm:attack-vector ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:blockchain-security,
        ngm:cybersecurity ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:block-confirmation,
        ngm:cryptographic-signature,
        ngm:eclipse-attack,
        ngm:payment-channel,
        ngm:proof-of-stake,
        ngm:proof-of-work,
        ngm:selfish-mining,
        ngm:sybil-attack ;
    vc:requires ngm:consensus-mechanism,
        ngm:distributed-ledger,
        ngm:peer-to-peer-network,
        ngm:transaction-finality ;
    vc:slug "double-spending" ;
    vc:sourceDomain "blockchain" .

ngm:g-rpc a owl:Class ;
    rdfs:label "gRPC"@en ;
    rdfs:comment "gRPC (gRPC Remote Procedure Call) is an open-source, high-performance remote procedure call framework developed by Google and released in 2015, built on HTTP/2 transport and Protocol Buffers as the interface definition language and serialisation format. It supports four communication patterns—unary, server-streaming, client-streaming, and bidirectional streaming—enabling efficient, strongly typed, low-latency communication between services in polyglot distributed systems. gRPC generates client and server stubs in over a dozen programming languages from a single .proto service definition, making it the dominant choice for internal microservices communication in cloud-native architectures. Its binary encoding and multiplexed HTTP/2 connections deliver significantly lower overhead than REST/JSON at high throughput."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:http2 ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:tls ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:protocol-buffer ],
        ngm:communication-protocol ;
    vc:bridgesTo ngm:internet-of-things,
        ngm:mobile-computing ;
    vc:contrastsWith ngm:graph-ql,
        ngm:rest-api,
        ngm:websocket ;
    vc:enables ngm:distributed-system,
        ngm:microservices,
        ngm:realtime-communication,
        ngm:service-mesh ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:remote-procedure-call ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:api-gateway,
        ngm:api-standard,
        ngm:microservices-architecture,
        ngm:mutual-tls ;
    vc:requires ngm:http2,
        ngm:protocol-buffer,
        ngm:tls ;
    vc:slug "g-rpc" ;
    vc:sourceDomain "infrastructure" ;
    vc:standardizedBy ngm:cloud-native-computing-foundation ;
    vc:supports ngm:load-balancing ;
    vc:uses ngm:cloud-native-applications,
        ngm:envoy-proxy,
        ngm:kubernetes .

