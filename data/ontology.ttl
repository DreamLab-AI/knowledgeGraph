ngm:backpropagation a owl:Class ;
    rdfs:label "Backpropagation"@en ;
    rdfs:comment "Backpropagation is the algorithm for computing gradients of the loss function with respect to each weight in a neural network by applying the chain rule of calculus in reverse through the computation graph. It enables efficient gradient calculation across all layers in a single backward pass, making large-scale neural network training computationally feasible."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:forward-pass ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:computation-graph ],
        ngm:optimization-algorithm ;
    vc:bridgesTo ngm:federated-learning,
        ngm:neuromorphic-computing ;
    vc:contrastsWith ngm:forward-mode-differentiation,
        ngm:genetic-algorithm ;
    vc:dependsOn ngm:activation-function,
        ngm:loss-function ;
    vc:enables ngm:deep-learning,
        ngm:gradient-descent,
        ngm:model-training,
        ngm:weight-update ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:backward-pass,
        ngm:chain-rule,
        ngm:forward-pass ;
    vc:isPartOf ngm:neural-network-training ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:batch-normalisation,
        ngm:dropout,
        ngm:recurrent-neural-network,
        ngm:vanishing-gradient-problem ;
    vc:requires ngm:computation-graph,
        ngm:differentiable-function ;
    vc:slug "backpropagation" ;
    vc:sourceDomain "machine-learning" ;
    vc:uses ngm:automatic-differentiation,
        ngm:neural-network,
        ngm:stochastic-gradient-descent .

ngm:virtual-reality a owl:Class ;
    rdfs:label "Virtual Reality"@en ;
    rdfs:comment "Virtual Reality (VR) is a fully immersive, computer-generated simulation technology that replaces the user's physical environment with an interactive three-dimensional world, experienced through head-mounted displays that deliver stereoscopic rendering, spatial audio, and six-degrees-of-freedom motion tracking. VR systems generate a sense of presence by maintaining sub-20 ms motion-to-photon latency, high-refresh-rate displays, and positional tracking of the user's head and hands. As a foundational modality within Extended Reality (XR), VR is architecturally distinguished from Augmented Reality by occluding the real world entirely rather than overlaying digital content upon it. Applications span entertainment, professional training, tele-presence collaboration, clinical therapy, and spatial computing platforms."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:haptic-feedback ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:spatial-audio ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:motion-tracking ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:real-time-rendering ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:six-degrees-of-freedom ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:foveated-rendering ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:physics-simulation ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:head-mounted-display ],
        ngm:extended-reality-xr ;
    vc:bridgesTo ngm:digital-twin,
        ngm:neural-rendering ;
    vc:contrastsWith ngm:augmented-reality,
        ngm:mixed-reality ;
    vc:enables ngm:immersive-collaboration,
        ngm:spatial-computing,
        ngm:virtual-training ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:foveated-rendering,
        ngm:haptic-feedback,
        ngm:head-mounted-display,
        ngm:motion-tracking,
        ngm:spatial-audio ;
    vc:isPartOf ngm:extended-reality-xr,
        ngm:metaverse ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:computer-graphics,
        ngm:human-computer-interaction,
        ngm:telepresence ;
    vc:requires ngm:physics-simulation,
