        ngm:scalable-smart-contracts ;
    vc:uses ngm:bitcoin-utxo,
        ngm:cryptographic-commitment,
        ngm:cryptographic-proof,
        ngm:json-data-interchange-format-schema .

ngm:collective-decision-making a owl:Class ;
    rdfs:label "Collective Decision Making"@en ;
    rdfs:comment "Collective decision making is the social and technical process by which a group of agents — human, algorithmic, or hybrid — aggregate individual preferences, information, or votes to arrive at a binding or advisory choice on behalf of the group. It encompasses the design and analysis of voting systems, preference aggregation mechanisms, deliberation protocols, and incentive structures that determine how group choices are reached and enforced. In digital and distributed contexts, collective decision making is formalised through on-chain governance mechanisms, decentralised autonomous organisations, and algorithmic consensus protocols that encode group agency in smart contract logic. The field draws on social choice theory, mechanism design, game theory, and organisational science to evaluate fairness, efficiency, and manipulation-resistance of alternative procedures."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:identity-verification ],
        ngm:social-choice-theory ;
    vc:bridgesTo ngm:consensus-algorithm,
        ngm:federated-learning,
        ngm:multi-agent-system ;
    vc:contrastsWith ngm:autocratic-governance,
        ngm:centralised-authority ;
    vc:dependsOn ngm:game-theory,
        ngm:mechanism-design ;
    vc:enables ngm:community-governance,
        ngm:dao-governance,
        ngm:on-chain-governance,
        ngm:participatory-democracy,
        ngm:protocol-upgrade ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:proposal-process,
        ngm:quorum-requirement ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:arrow-impossibility-theorem,
        ngm:collective-intelligence-system,
        ngm:consent-mechanism,
        ngm:deliberative-democracy,
        ngm:governance-token ;
    vc:requires ngm:deliberation-protocol,
        ngm:identity-verification,
        ngm:preference-aggregation ;
    vc:slug "collective-decision-making" ;
    vc:sourceDomain "governance" ;
    vc:uses ngm:conviction-voting,
        ngm:liquid-democracy,
        ngm:quadratic-voting,
        ngm:ranked-choice-voting,
        ngm:token-weighted-voting,
        ngm:voting-mechanism .

ngm:data-portability a owl:Class ;
    rdfs:label "Data Portability"@en ;
    rdfs:comment "Data portability is the ability for users to obtain, move and reuse their personal or application data across services in a structured, machine-readable format without lock-in. It is both a legal right under regimes such as GDPR and a technical property enabled by open formats and interoperable storage. In decentralised-web designs it lets individuals carry data between providers, shifting control from platforms to users."@en ;
    rdfs:subClassOf ngm:infra-data-management ;
    skos:broader ngm:infra-data-management ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:decentralised-web,
        ngm:solid ;
    vc:slug "data-portability" ;
    vc:sourceDomain "data" .

