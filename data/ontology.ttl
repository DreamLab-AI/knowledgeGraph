        ngm:retrieval-augmented-generation ;
    vc:contrastsWith ngm:batch-data-migration,
        ngm:static-documentation ;
    vc:dependsOn ngm:change-detection,
        ngm:metadata-management ;
    vc:enables ngm:information-freshness,
        ngm:knowledge-graph-maintenance,
        ngm:semantic-consistency ;
    vc:hasMaturity ngmi:maturity-emerging ;
