ngm:vendor-lock-in a owl:Class ;
    rdfs:comment "Vendor lock-in is a situation in which a customer becomes dependent on a particular supplier's products or services and cannot switch to an alternative without substantial cost, effort or disruption. It arises from proprietary formats, non-portable data, integration dependencies and incompatible interfaces that raise switching costs. Open standards, data portability and interoperability are the principal countermeasures that preserve customer choice."@en ;
    rdfs:label "Vendor Lock-in"@en ;
    rdfs:subClassOf ngm:infra-network-and-comms ;
