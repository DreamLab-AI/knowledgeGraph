    vc:sourceDomain "metaverse" .

ngm:tele-102-codec-avatars a owl:Class ;
    rdfs:label "TELE-102-codec-avatars"@en ;
    rdfs:comment "Codec Avatars are a research effort by Meta to produce photorealistic, real-time avatars of people that are learned from capture data and driven by sensors to reproduce expression and appearance."@en ;
