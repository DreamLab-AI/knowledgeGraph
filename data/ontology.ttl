ngm:catastrophic-risk-reduction a owl:Class ;
    rdfs:comment "Catastrophic risk reduction is the set of interventions, controls, and governance measures aimed at lowering the probability or severity of large-scale harms, particularly those posed by advanced AI systems. It spans technical safeguards such as alignment and capability control, organisational measures such as staged deployment and incident response, and policy measures such as compute governance. It is a core goal of AI safety and alignment work because it targets the tail risks that could threaten societal stability or human survival."@en ;
    rdfs:label "Catastrophic Risk Reduction"@en ;
    rdfs:subClassOf ngm:ai-safety ;
    rdfs:subClassOf ngm:global-catastrophic-risk ;
    rdfs:subClassOf ngm:risk-management ;
