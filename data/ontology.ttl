    vc:implements ngm:synchronous-communication ;
    vc:isPartOf ngm:distributed-systems ;
    vc:isPartOf ngm:networking ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:api ;
    vc:relatedTo ngm:distributed-protocol ;
    vc:requires ngm:protocol ;
    vc:requires ngm:service-discovery ;
