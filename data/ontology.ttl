ngm:post-quantum-cryptography a owl:Class ;
    rdfs:label "Post-Quantum Cryptography"@en ;
    rdfs:comment "Cryptographic algorithms and protocols designed to be resistant to attacks from both classical and quantum computers, protecting secure communications in the post-quantum era."@en ;
