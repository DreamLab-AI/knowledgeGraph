    vc:sourceDomain "robotics" .

ngm:robot-sensor a owl:Class ;
    rdfs:label "Robot Sensor"@en ;
    rdfs:comment "A Robot Sensor is a transducer or measurement device integrated into a robotic system to acquire data about the robot's internal state (proprioception: joint angles, torques, currents) or external environment (exteroception: proximity, force, vision, lidar). Sensor data drives closed-loop control, obstacle avoidance, and higher-level perception pipelines."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:signal-conditioning ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:sensor ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:sensor-calibration ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:analog-to-digital-converter ],
        ngm:robo-perception ;
    skos:broader ngm:robo-perception ;
    vc:bridgesTo ngm:digital-twin,
        ngm:machine-learning ;
    vc:contrastsWith ngm:robot-actuator ;
    vc:dependsOn ngm:embedded-systems,
        ngm:robot-operating-system ;
    vc:enables ngm:closed-loop-control,
        ngm:obstacle-avoidance,
        ngm:sensor-fusion,
        ngm:slam ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:analog-to-digital-converter,
        ngm:sensor ;
    vc:isPartOf ngm:robotic-system,
        ngm:robotics ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:control-system,
        ngm:force-torque-sensor,
        ngm:inertial-measurement-unit,
        ngm:lidar ;
    vc:requires ngm:sensor-calibration,
        ngm:signal-conditioning ;
    vc:slug "robot-sensor" ;
    vc:sourceDomain "robotics" ;
    vc:standardizedBy ngm:iec-61508,
        ngm:iso-8373 ;
    vc:supports ngm:autonomous-navigation,
        ngm:human-robot-interaction ;
    vc:uses ngm:kalman-filter,
        ngm:signal-processing .

ngm:safety-integrity-level a owl:Class ;
    rdfs:label "Safety Integrity Level"@en ;
    rdfs:comment "Safety Integrity Level (SIL) is a discrete measure of the risk-reduction provided by a safety function, defined by the IEC 61508 family of standards on four levels (SIL 1 to SIL 4). Each level corresponds to a target probability of dangerous failure on demand or per hour. SIL is used to specify, design, and verify that safety-related control systems achieve a tolerable level of risk."@en ;
    rdfs:subClassOf ngm:robo-safety-and-standards ;
    skos:broader ngm:robo-safety-and-standards ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:robot-standard,
        ngm:safety-function ;
    vc:slug "safety-integrity-level" ;
    vc:sourceDomain "robotics" .

ngm:scalable-oversight a owl:Class ;
    rdfs:label "Scalable Oversight"@en ;
    rdfs:comment "Scalable oversight is the AI-safety research problem of reliably supervising, evaluating, and steering AI systems whose capabilities approach or exceed human ability on the tasks being judged. It seeks mechanisms that let limited human supervisors provide accurate training signal and verification even when they cannot directly check a model's outputs. Approaches decompose hard judgements, amplify human judgement with AI assistance, and use adversarial or recursive structures to surface errors."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:human-in-the-loop ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:task-decomposition ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:interpretability ],
        ngm:ai-alignment ;
    vc:enables ngm:quality-assurance,
        ngm:value-alignment ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:human-in-the-loop,
        ngm:task-decomposition ;
    vc:isPartOf ngm:ai-alignment ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:agentic-ai,
        ngm:ai-governance,
        ngm:superintelligence ;
    vc:requires ngm:interpretability ;
    vc:slug "scalable-oversight" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:ai-safety ;
    vc:uses ngm:human-feedback,
        ngm:red-teaming,
        ngm:reinforcement-learning-from-human-feedback .

ngm:security-information-and-event-management a owl:Class ;
    rdfs:label "Security Information and Event Management"@en ;
    rdfs:comment "Security Information and Event Management (SIEM) is a security discipline and platform category that aggregates, normalises and correlates log and event data from across an estate to detect, investigate and respond to threats. It combines real-time monitoring and alerting with longer-term storage for forensics and compliance reporting. SIEM is the analytical core of most security operations, turning raw telemetry into actionable detections."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:audit-logging ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:threat-detection ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:observability ],
        ngm:network-security ;
    vc:bridgesTo ngm:observability ;
    vc:dependsOn ngm:audit-logging ;
    vc:enables ngm:incident-response,
        ngm:threat-detection ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:audit-logging,
        ngm:threat-detection ;
    vc:implements ngm:threat-detection ;
    vc:isPartOf ngm:cybersecurity ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:data-loss-prevention,
        ngm:vulnerability-management ;
    vc:requires ngm:observability ;
    vc:slug "security-information-and-event-management" ;
    vc:sourceDomain "security" ;
    vc:standardizedBy ngm:cybersecurity ;
    vc:supports ngm:compliance-monitoring,
        ngm:incident-response ;
    vc:uses ngm:anomaly-detection,
        ngm:threat-intelligence .

ngm:seed-phrase a owl:Class ;
    rdfs:label "Seed Phrase"@en ;
    rdfs:comment "A seed phrase, also called a recovery or mnemonic phrase, is an ordered list of words, typically twelve or twenty-four, that encodes the master secret from which a cryptocurrency wallet derives all of its private keys. Generated from random entropy and mapped to words via a standard wordlist, it provides a human-readable backup that can fully restore a wallet on any compatible device. Because anyone holding the phrase controls the funds, its secrecy and secure storage are paramount to self-custody."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cold-storage ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:entropy ],
        ngm:digital-wallet ;
    vc:dependsOn ngm:key-management ;
    vc:enables ngm:hierarchical-deterministic-wallet,
        ngm:self-custody ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:entropy ;
    vc:isPartOf ngm:digital-wallet ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:blockchain,
        ngm:security ;
    vc:requires ngm:cold-storage ;
    vc:slug "seed-phrase" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:cryptocurrency-wallet,
        ngm:private-key ;
    vc:uses ngm:cryptographic-key .

ngm:self-consistency a owl:Class ;
    rdfs:label "Self-Consistency"@en ;
    rdfs:comment "Self-consistency is a decoding and prompting strategy for large language models in which multiple independent reasoning chains are sampled stochastically for a given problem and the final answer is selected by majority vote across those chains. The technique exploits the observation that correct reasoning paths, although varied in surface form, converge on the same answer whilst incorrect paths remain scattered across the answer space. Originally introduced alongside chain-of-thought prompting, self-consistency substantially improves accuracy on arithmetic, commonsense, and multi-step logical reasoning tasks without requiring additional model training or fine-tuning."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:chain-of-thought ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:large-language-models ],
        ngm:prompt-engineering ;
    vc:bridgesTo ngm:bayesian-inference,
        ngm:collective-intelligence ;
    vc:contrastsWith ngm:beam-search,
        ngm:greedy-decoding ;
    vc:dependsOn ngm:inference-compute,
        ngm:token-generation ;
    vc:enables ngm:error-correction,
        ngm:reasoning,
        ngm:reliability,
        ngm:robustness ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:test-time-compute ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:process-reward-model,
        ngm:prompt-engineering,
        ngm:tree-of-thoughts ;
    vc:requires ngm:chain-of-thought,
        ngm:large-language-models ;
    vc:slug "self-consistency" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:code-generation,
        ngm:commonsense-reasoning,
        ngm:mathematical-reasoning ;
    vc:uses ngm:ensemble-methods,
        ngm:majority-voting .

ngm:sensor-input a owl:Class ;
    rdfs:label "Sensor Input"@en ;
    rdfs:comment "Sensor input refers to the raw or pre-processed signals acquired from physical or virtual transducers that convert observable environmental quantities—position, force, temperature, light intensity, pressure, chemical concentration—into electrical or digital representations suitable for computation. It constitutes the primary interface between an autonomous or intelligent system and its environment, providing the perceptual foundation for state estimation, feedback control, and situational awareness. Effective use of sensor input requires calibration, filtering, and often fusion with complementary modalities to produce reliable world-state estimates, and the quality and latency of sensor inputs directly constrain the operational envelope of any system that must perceive and respond to the physical world. Sensor inputs vary by modality, sampling rate, resolution, noise characteristics, and temporal precision, spanning domains from robotics and autonomous vehicles to spatial computing, industrial IoT, and embodied AI."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:real-time-computation ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:sensor-calibration ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:signal-conditioning ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:digital-signal-processing ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:analogue-to-digital-conversion ],
        ngm:sensor ;
    vc:bridgesTo ngm:embodied-ai,
        ngm:internet-of-things,
        ngm:spatial-computing ;
    vc:contrastsWith ngm:actuator,
        ngm:synthetic-data ;
    vc:dependsOn ngm:embedded-systems,
        ngm:transducer ;
    vc:enables ngm:autonomous-navigation,
        ngm:sensor-fusion,
        ngm:state-estimation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:analogue-to-digital-conversion,
        ngm:sensor-calibration,
        ngm:signal-conditioning ;
    vc:isPartOf ngm:perception-system,
        ngm:sensor-system ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:data-acquisition,
        ngm:sensor-data ;
    vc:requires ngm:digital-signal-processing,
        ngm:real-time-computation ;
    vc:slug "sensor-input" ;
    vc:sourceDomain "robotics" ;
    vc:supports ngm:autonomous-system,
        ngm:control-system,
        ngm:machine-vision ;
    vc:uses ngm:kalman-filter .

ngm:server-sent-events a owl:Class ;
    rdfs:label "Server-Sent Events"@en ;
    rdfs:comment "Server-Sent Events (SSE) is a W3C and WHATWG-standardised unidirectional server-to-client push protocol layered atop HTTP/1.1 and HTTP/2, enabling servers to emit a continuous stream of newline-delimited text events to browser or API clients over a single persistent connection. Each event record may carry optional 'id', 'event', 'data', and 'retry' fields; clients reconnect automatically using the last-received event id as a cursor. SSE is consumed via the browser's EventSource API and is the dominant transport for streaming large-language-model inference outputs in APIs such as OpenAI and Anthropic, as well as in the Model Context Protocol (MCP) transport layer."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:http ],
        ngm:infra-network-and-comms ;
    skos:broader ngm:infra-network-and-comms ;
    vc:bridgesTo ngm:agentic-ai,
        ngm:retrieval-augmented-generation ;
    vc:contrastsWith ngm:long-polling,
        ngm:websocket ;
    vc:enables ngm:mentions-and-notifications,
        ngm:real-time-streaming,
        ngm:server-push ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:event-driven-architecture,
        ngm:publish-subscribe-pattern ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:api-gateway,
        ngm:reverse-proxy ;
    vc:requires ngm:http ;
    vc:slug "server-sent-events" ;
    vc:sourceDomain "infrastructure" ;
    vc:standardizedBy ngm:w3-c ;
    vc:supports ngm:llm-inference-api,
        ngm:model-context-protocol ;
    vc:uses ngm:http2 .

ngm:spatial-index a owl:Class ;
    rdfs:label "Spatial Index"@en ;
    rdfs:comment "Data structure optimized for efficient storage, retrieval, and querying of 3D spatial objects within virtual worlds using hierarchical geometric partitioning."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:octree-spatial-index ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:distance-metric ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:bounding-volume-hierarchy ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:coordinate-system ],
        ngm:sc-display-and-rendering ;
    skos:broader ngm:sc-display-and-rendering ;
    vc:bridgesTo ngm:spatial-data-structure ;
    vc:enables ngm:collision-detection,
        ngm:fast-spatial-queries,
