ngm:record-keeping a owl:Class ;
    rdfs:label "Record Keeping"@en ;
    rdfs:comment "Record keeping is the systematic retention of transaction, customer, and decision records so that activities can be reconstructed and verified by auditors or regulators. In financial compliance it mandates preserving identity documentation, transaction details, and risk assessments for prescribed periods. Robust record keeping is a precondition for meeting anti-money-laundering and travel-rule obligations."@en ;
    rdfs:subClassOf ngm:regulatory-compliance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:aml-kyc-compliance,
        ngm:travel-rule ;
    vc:slug "record-keeping" ;
    vc:sourceDomain "governance" .

ngm:redress-mechanism a owl:Class ;
    rdfs:label "Redress Mechanism"@en ;
    rdfs:comment "A redress mechanism is a structured process that lets individuals affected by an automated or algorithmic decision contest it, seek an explanation, and obtain correction or remedy when harm or error has occurred. It operationalises accountability in AI governance by combining channels for complaint, human review of contested outcomes, and remediation such as reversal, compensation, or model adjustment. Effective redress requires transparency about how decisions are made, due process for the affected person, and feedback loops that surface systemic problems for harm mitigation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:fairness ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:human-oversight ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:explainability ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:transparency ],
        ngm:accountability ;
    vc:dependsOn ngm:transparency ;
    vc:enables ngm:accountability,
        ngm:algorithmic-accountability ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:human-oversight,
        ngm:transparency ;
    vc:isPartOf ngm:ai-governance ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:fairness ;
    vc:requires ngm:explainability,
        ngm:fairness ;
    vc:slug "redress-mechanism" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:regulatory-compliance,
        ngm:responsible-ai .

ngm:refresh-token a owl:Class ;
    rdfs:label "Refresh Token"@en ;
    rdfs:comment "A refresh token is a long-lived credential issued alongside a short-lived access token, used to obtain new access tokens without prompting the user to re-authenticate. By keeping access tokens short-lived and exchanging the refresh token at the authorisation server, systems limit the damage of a leaked access token while preserving a smooth user session. Refresh tokens are sensitive and typically bound, rotated, and revocable."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:authentication ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:token ],
        ngm:oauth-2-0 ;
    vc:bridgesTo ngm:identity-provider ;
    vc:contrastsWith ngm:bearer-token ;
    vc:dependsOn ngm:oauth ;
    vc:enables ngm:session-management ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:token ;
    vc:implements ngm:authorization ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:authentication,
        ngm:oauth,
        ngm:session-management,
        ngm:token ;
    vc:requires ngm:authentication ;
    vc:slug "refresh-token" ;
    vc:sourceDomain "security" ;
    vc:standardizedBy ngm:standards ;
    vc:supports ngm:single-sign-on ;
    vc:uses ngm:oauth-2-0 .

ngm:regulatory-sandbox a owl:Class ;
    rdfs:label "Regulatory Sandbox"@en ;
    rdfs:comment "A regulatory sandbox is a supervised testing environment in which firms can trial innovative products, services, or business models with real customers under temporary regulatory relief and close oversight. It lets regulators observe emerging technology and firms validate compliance before full-scale launch. Sandboxes are a common policy tool for fintech, blockchain, and other convergent technologies."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:risk-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:consumer-protection ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:regulatory-approval ],
        ngm:financial-regulation ;
    vc:bridgesTo ngm:artificial-intelligence,
        ngm:blockchain,
