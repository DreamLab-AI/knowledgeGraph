    vcw:owlRole "Concept" .

# Virtual Objects
spatial-computing:VirtualObjects rdf:type owl:Class ;
    rdfs:subClassOf spatial-computing:DigitalAsset ;
    rdfs:label "Virtual Objects"@en ;
    rdfs:comment "Digital 3D assets existing within virtual environments that users can interact with, own, trade, and customize, including avatars, wearables, furniture, vehicles, and environmental elements, often represented as NFTs for verifiable ownership in blockchain-based metaverses."@en ;
    skos:prefLabel "Virtual Objects"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:spatial-computing:virtual-objects" ;
    owl:sameAs <urn:visionclaw:concept:spatial-computing:virtual-objects> ;
    vcw:contentHash "sha256-12-1c0a5cddd691" ;
    vcw:qualityScore "0.5"^^xsd:decimal ;
    vcw:legacyTermId "MV-10135" ;
