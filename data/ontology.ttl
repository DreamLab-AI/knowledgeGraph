    rdfs:label "Automated Podcasting"@en ;
    rdfs:comment "Automated Podcasting is the application of artificial intelligence, machine learning, and generative systems to partially or fully automate the end-to-end podcast production pipeline—spanning script generation, synthetic voice synthesis, AI-driven audio editing, automated transcription, show-note..."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:natural-language-processing ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:voice-cloning ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:audio-signal-processing ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:large-language-models ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:neural-audio-enhancement ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:text-to-speech ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:speech-recognition ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:speaker-diarisation ],
        ngm:ai-application ;
    skos:broader ngm:ai-application ;
    vc:enables ngm:accessible-media,
        ngm:creator-economy,
        ngm:low-cost-podcast-creation,
        ngm:multilingual-podcasting,
        ngm:personalised-audio-summaries,
        ngm:real-time-content-conversion,
        ngm:scalable-audio-content-production ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:ai-audio-editing,
        ngm:ai-script-generation,
        ngm:automated-transcription,
        ngm:neural-audio-enhancement,
        ngm:podcast-distribution-automation,
        ngm:show-notes-generation,
        ngm:speaker-diarisation,
        ngm:text-to-speech,
        ngm:voice-cloning ;
    vc:implements ngm:automatic-speech-recognition,
        ngm:dynamic-ad-insertion,
        ngm:neural-audio-enhancement,
        ngm:retrieval-augmented-generation,
        ngm:speaker-embedding,
        ngm:transformer-based-tts,
        ngm:voice-cloning ;
    vc:qualityScore "0.52"^^xsd:float ;
    vc:relatedTo ngm:ai-adoption,
        ngm:ai-companies,
        ngm:ai-video,
        ngm:constitutional-ai-training-methodology-language-model-family,
        ngm:generative-ai,
        ngm:instruction-following-conversational-ai-system,
        ngm:natural-language-processing,
        ngm:speech-and-voice ;
    vc:requires ngm:audio-signal-processing,
        ngm:cloud-computing-infrastructure,
        ngm:large-language-models,
        ngm:natural-language-processing,
        ngm:neural-text-to-speech,
        ngm:speech-recognition ;
    vc:slug "automated-podcasting" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:standardizedBy ngm:c2-pa-content-credentials,
        ngm:eu-ai-act-regulatory-instrument-article-50,
        ngm:ftc-endorsement-guidelines,
        ngm:ofcom-broadcasting-code ;
    vc:supports ngm:ai-companions,
        ngm:ai-search,
        ngm:ai-video,
        ngm:creator-economy,
        ngm:media-accessibility,
        ngm:podcast-distribution,
        ngm:seo-optimisation ;
    vc:uses ngm:adobe-podcast,
        ngm:assembly-ai,
        ngm:descript,
        ngm:eleven-labs,
        ngm:notebook-lm,
        ngm:openai-research-organisation-whisper,
        ngm:otter-ai,
        ngm:retrieval-augmented-generation .

