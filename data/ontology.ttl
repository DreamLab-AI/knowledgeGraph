ngm:proteus-effect a owl:Class ;
    rdfs:label "Proteus Effect"@en ;
    rdfs:comment "The Proteus Effect is the phenomenon whereby the visual characteristics of a user's digital avatar unconsciously shape that user's own behaviour, attitudes, and self-perception within virtual environments. Named after the shape-shifting Greek deity, it was empirically demonstrated by Yee and Bailenson (2007): users assigned taller or more attractive avatars exhibited corresponding shifts in confidence and social openness, while users embodying outgroup avatars showed reduced implicit bias. The effect arises through the intersection of self-perception theory, stereotype activation, and embodied cognition, and has direct implications for therapeutic applications, metaverse platform design, and ethical avatar-assignment practices."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:virtual-environment ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:avatar ],
        ngm:metaverse,
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:enables ngm:behavioral-modeling,
        ngm:immersive-experience ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:avatar-customization,
        ngm:embodied-ai,
        ngm:social-presence,
        ngm:vr-psychology ;
    vc:requires ngm:avatar,
        ngm:virtual-environment ;
    vc:slug "proteus-effect" ;
    vc:sourceDomain "spatial-computing" .

ngm:protobuf a owl:Class ;
    rdfs:label "Protobuf"@en ;
    rdfs:comment "Protocol Buffers (Protobuf) is a language-neutral, platform-neutral mechanism for serialising structured data using a compact binary wire format defined by an interface description in a .proto schema. A code generator produces typed accessors in many languages from that schema, enabling efficient, forwards- and backwards-compatible message exchange. It is the default payload format for gRPC and is widely used for high-throughput inter-service communication and storage."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:schema ],
        ngm:data-format ;
    vc:bridgesTo ngm:serialisation ;
    vc:contrastsWith ngm:xml ;
    vc:dependsOn ngm:schema,
        ngm:schema-registry ;
    vc:enables ngm:remote-procedure-call ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:data-serialization ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:data-format,
        ngm:data-serialization,
        ngm:schema-registry,
        ngm:xml ;
    vc:requires ngm:schema ;
    vc:slug "protobuf" ;
    vc:sourceDomain "infrastructure" ;
    vc:standardizedBy ngm:standards ;
    vc:supports ngm:message-passing ;
    vc:uses ngm:data-model .

ngm:protocol-governance a owl:Class ;
    rdfs:label "Protocol Governance"@en ;
    rdfs:comment "Protocol Governance encompasses the processes, structures, and decision-making mechanisms by which changes to communication or consensus protocols are proposed, evaluated, ratified, and implemented across a decentralised participant base. Unlike traditional software governance, protocol governance must achieve coordination among parties with heterogeneous interests and no central authority, often relying on off-chain social processes (improvement proposals, mailing lists, developer calls) and on-chain voting mechanisms (token-weighted ballots, validator multisig). The choice of governance model has direct consequences for protocol security, decentralisation, upgrade velocity, and stakeholder alignment."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:governance-token ],
        ngm:governance ;
    vc:bridgesTo ngm:internet-governance,
        ngm:standards ;
    vc:contrastsWith ngm:corporate-governance,
        ngm:regulatory-compliance ;
    vc:dependsOn ngm:decentralisation,
        ngm:transparency ;
    vc:enables ngm:decentralised-governance,
        ngm:protocol-upgrade,
        ngm:stakeholder-coordination ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:bitcoin-improvement-proposal,
        ngm:ethereum-improvement-proposal,
        ngm:fork,
        ngm:token-voting ;
    vc:requires ngm:governance-token,
        ngm:social-consensus ;
    vc:slug "protocol-governance" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:consensus-mechanism,
        ngm:decentralised-autonomous-organisation,
        ngm:on-chain-governance ;
    vc:uses ngm:smart-contract .

