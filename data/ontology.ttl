        ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:contrastsWith ngm:adversarial-robustness ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:data-augmentation-strategies,
        ngm:federated-learning,
        ngm:machine-learning-discipline ;
    vc:requires ngm:model-training,
        ngm:training-data ;
    vc:slug "data-poisoning" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:data-serialization a owl:Class ;
    rdfs:label "Data Serialization"@en ;
    rdfs:comment "Data Serialization is the process of converting structured in-memory data objects — including primitive types, collections, and complex graphs — into a byte-sequence or character-stream representation that can be stored persistently, transmitted across a network boundary, or reconstructed (deserialised) into an equivalent in-memory representation on a different machine or at a different time, potentially running different software. Serialization formats vary along axes of human readability (JSON, YAML, XML versus binary), schema enforcement (Protocol Buffers, Apache Avro with mandatory schemas versus schemaless JSON), compactness, and cross-language support, making format selection a critical engineering decision that affects system interoperability, performance, and evolvability."@en ;
    rdfs:subClassOf ngm:data-format ;
    vc:enables ngm:data-pipeline,
        ngm:interoperability-protocol ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:binary-encoding,
        ngm:data-format-standard,
        ngm:json-data-interchange-format,
        ngm:protocol-buffer,
        ngm:schema-registry ;
    vc:slug "data-serialization" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:data-storage ;
    vc:uses ngm:data-schema .

ngm:data-visualisation a owl:Class ;
    rdfs:label "Data Visualisation"@en ;
    rdfs:comment "Data Visualisation is the systematic practice of encoding data attributes into perceptual channels — position, colour, size, shape, and motion — to enable rapid human comprehension of patterns, trends, anomalies, and relational structures within datasets. It encompasses both static and interactive representations, spanning two-dimensional charts, network graphs, geospatial maps, and immersive three-dimensional scenes rendered in augmented or virtual reality environments. Effective data visualisation integrates principles from information design, cognitive psychology, and computer graphics, requiring rendering infrastructure, data pipelines, and interaction paradigms suited to the display medium. In the context of real-time analytics and spatial computing, visualisation systems must handle streaming data, high-dimensionality reduction, and multi-user collaborative viewing at interactive frame rates."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-access-interface ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:rendering-engine ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-pipeline ],
        ngm:infra-data-management ;
    skos:broader ngm:infra-data-management ;
    vc:bridgesTo ngm:explainable-ai,
        ngm:machine-learning,
        ngm:spatial-computing ;
    vc:contrastsWith ngm:data-table,
        ngm:text-report ;
    vc:dependsOn ngm:data-model,
        ngm:graphics-processing-unit ;
    vc:enables ngm:decision-support-system,
        ngm:digital-twin,
        ngm:exploratory-data-analysis ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:chart,
        ngm:dashboard,
        ngm:geospatial-map,
        ngm:network-graph ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:information-design,
        ngm:scientific-visualisation,
        ngm:visual-analytics ;
    vc:requires ngm:data-access-interface,
        ngm:data-pipeline,
        ngm:rendering-engine ;
    vc:slug "data-visualisation" ;
    vc:sourceDomain "data" ;
    vc:supports ngm:augmented-reality,
        ngm:business-intelligence,
        ngm:telecollaboration ;
    vc:uses ngm:colour-theory,
        ngm:computer-vision,
        ngm:dimensionality-reduction,
        ngm:human-computer-interaction .

ngm:decentralised-identifiers a owl:Class ;
    rdfs:label "Decentralised Identifiers"@en ;
    rdfs:comment "A W3C standard for globally unique identifiers that are created, owned and controlled by their subject without reliance on a central registration authority, enabling verifiable, self-sovereign digital identity."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
