    vc:slug "uk-gdpr" ;
    vc:sourceDomain "governance" ;
    vc:supports ngm:information-security,
        ngm:regulatory-compliance .

ngm:university-of-edinburgh a owl:Class ;
    rdfs:label "University of Edinburgh"@en ;
    rdfs:comment "The University of Edinburgh is a public research university in Edinburgh, Scotland, founded by royal charter in 1582, making it one of the oldest universities in the English-speaking world and the sixth-oldest in the United Kingdom. It is a member of the Russell Group and is internationally recognised for research in informatics, artificial intelligence, machine learning, natural language processing, medicine, and the humanities. Its School of Informatics is among the largest and most influential computer science and AI research centres in Europe, with foundational contributions to neural networks, probabilistic programming, and language modelling. The university's research ecosystem spans industry partnerships, spin-out companies, and national research institutes including the Alan Turing Institute."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:research-funding ],
        ngm:ai-research-area ;
    skos:broader ngm:ai-research-area ;
    vc:bridgesTo ngm:ai-ethics,
        ngm:technology-transfer ;
    vc:dependsOn ngm:alan-turing-institute,
        ngm:uk-research-and-innovation ;
    vc:enables ngm:machine-learning,
        ngm:natural-language-processing,
        ngm:probabilistic-programming,
        ngm:robotics ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:russell-group ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:imperial-college-london,
