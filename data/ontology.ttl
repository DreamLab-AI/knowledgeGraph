    vc:slug "membership-inference" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:message-authentication a owl:Class ;
    rdfs:label "Message Authentication"@en ;
    rdfs:comment "Message authentication is the cryptographic property that guarantees a received message originated from a claimed sender and has not been altered in transit. It is achieved through message authentication codes (MACs), digital signatures, or authenticated encryption schemes, each binding message content to a key or key pair that only the legitimate sender possesses."@en ;
    rdfs:subClassOf ngm:authentication ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:authentication-mechanism,
        ngm:authentication-protocol ;
    vc:slug "message-authentication" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:authentication-standards,
        ngm:bbs-plus-signatures ;
    vc:uses ngm:asymmetric-cryptography,
        ngm:message-authentication-code .

ngm:message-authentication-code a owl:Class ;
    rdfs:label "Message Authentication Code"@en ;
    rdfs:comment "A Message Authentication Code (MAC) is a fixed-size cryptographic tag generated from an arbitrary-length message and a shared secret key using a keyed hash or block-cipher-based algorithm, providing simultaneous data integrity verification and authentication of the sender to any party holding the same secret key. Unlike digital signatures, MACs are symmetric and do not provide non-repudiation."@en ;
    rdfs:subClassOf ngm:cryptography ;
    vc:contrastsWith ngm:digital-signatures ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:authentication,
        ngm:digital-signature,
        ngm:message-authentication ;
    vc:slug "message-authentication-code" ;
    vc:sourceDomain "security" ;
    vc:uses ngm:hash-function,
        ngm:symmetric-encryption .

ngm:metaverse-application-platform a owl:Class ;
    rdfs:label "Metaverse Application Platform"@en ;
    rdfs:comment "Development environments and SDKs built on engines like Unity and Unreal that provide tools, APIs, and frameworks for creating immersive 3D applications, virtual worlds, and blockchain-integrated experiences for the metaverse."@en ;
    rdfs:subClassOf ngm:development-platform,
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:enables ngm:metaverse-content-creation ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:slug "metaverse-application-platform" ;
    vc:sourceDomain "spatial-computing" .

ngm:metaverse-venue a owl:Class ;
    rdfs:label "Metaverse Venue"@en ;
    rdfs:comment "Virtual 3D spaces within metaverse platforms designed to host events, conferences, exhibitions, and social gatherings, enabling global participation through customisable avatars and interactive environments that transcend physical location constraints."@en ;
    rdfs:subClassOf ngm:sc-platform-and-environment,
        ngm:virtual-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:enables ngm:global-virtual-gatherings ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:slug "metaverse-venue" ;
    vc:sourceDomain "spatial-computing" .

ngm:model-optimization a owl:Class ;
    rdfs:label "Model Optimization"@en ;
    rdfs:comment "Model optimisation is the set of techniques that reduce the size or computational cost of a trained model while preserving accuracy. It includes quantisation, pruning and distillation to make deployment more efficient."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:knowledge-distillation ],
        ngm:model-deployment ;
    vc:enables ngm:inference-serving,
        ngm:model-serving ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:knowledge-distillation ;
    vc:slug "model-optimization" ;
    vc:sourceDomain "machine-learning" .

ngm:modular-arithmetic a owl:Class ;
    rdfs:label "Modular Arithmetic"@en ;
    rdfs:comment "Modular arithmetic performs integer arithmetic that wraps around a fixed modulus, so numbers are treated as equivalent if they differ by a multiple of that modulus."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:number-theory ],
        ngm:cryptography-domain ;
    vc:enables ngm:cryptographic-hash-function ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:number-theory ;
    vc:slug "modular-arithmetic" ;
    vc:sourceDomain "metaverse" .

ngm:monte-carlo-integration a owl:Class ;
    rdfs:label "Monte Carlo Integration"@en ;
    rdfs:comment "Monte Carlo integration estimates the value of an integral by averaging the integrand over randomly sampled points, with error that decreases with the square root of the sample count regardless of dimension."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:random-number-generation ],
        ngm:numerical-methods ;
    vc:enables ngm:volume-rendering ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:random-number-generation ;
    vc:slug "monte-carlo-integration" ;
    vc:sourceDomain "metaverse" .

ngm:multi-agent-orchestration a owl:Class ;
    rdfs:label "Multi-Agent Orchestration"@en ;
    rdfs:comment "Multi-agent orchestration is the coordination and management of multiple autonomous AI agents — each capable of perceiving, reasoning, and acting — such that their collective behaviour accomplishes complex tasks beyond the capacity of any single agent. Orchestration encompasses task decomposition, agent assignment, inter-agent communication, state sharing, conflict resolution, and result aggregation, typically mediated by an orchestrator layer or emergent via peer protocols."@en ;
    rdfs:subClassOf ngm:orchestration ;
    vc:enables ngm:agentic-workflow,
        ngm:autonomous-ai-agents ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:agent-frameworks,
        ngm:agent-runtime,
        ngm:orchestration-layer ;
    vc:slug "multi-agent-orchestration" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:agent-communication-protocol,
        ngm:agent-orchestrator,
        ngm:large-language-models .

ngm:multi-robot-systems a owl:Class ;
    rdfs:label "Multi-Robot Systems"@en ;
    rdfs:comment "Multi-robot systems (MRS) are coordinated ensembles of two or more robotic agents that collaborate to accomplish tasks beyond the reach of a single robot, using communication, task allocation, and shared world models. They span architectures from tightly coupled homogeneous fleets to loosely coupled heterogeneous teams where robots with different capabilities complement each other. Key research challenges include task and motion planning, collision avoidance, fault tolerance, and communication bandwidth constraints in dynamic environments. MRS find application in search and rescue, warehouse automation, precision agriculture, and planetary exploration."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:swarm-robot ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:collaborative-robot ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:autonomous-robot ],
        ngm:autonomous-system ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:autonomous-robot,
        ngm:collaborative-robot,
        ngm:swarm-robot ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:autonomous-navigation,
        ngm:fleet-management,
        ngm:swarm-robotics ;
    vc:slug "multi-robot-systems" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:consensus-algorithm,
        ngm:robot-operating-system,
        ngm:robotic-control .

ngm:multihash a owl:Class ;
    rdfs:label "Multihash"@en ;
    rdfs:comment "Multihash is a self-describing hash format developed by Protocol Labs in which the hash digest is prefixed with a varint-encoded function code and digest length, enabling consumers to identify the hash algorithm without out-of-band knowledge. It is a foundational component of the IPFS content-addressing stack and the Multiformat suite, providing algorithm agility so that systems can upgrade from SHA-256 to SHA3 or BLAKE3 without breaking existing identifiers. Any hash function can be registered in the Multihash table and the format is codec-neutral."@en ;
    rdfs:subClassOf ngm:cryptographic-hash ;
    vc:enables ngm:content-addressed-storage,
        ngm:ipfs ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:content-addressing,
        ngm:cryptographic-hash-function,
        ngm:merkle-tree ;
    vc:slug "multihash" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:cryptographic-verification ;
    vc:uses ngm:binary-encoding .

ngm:near-field-communication a owl:Class ;
    rdfs:label "Near Field Communication"@en ;
    rdfs:comment "Near Field Communication (NFC) is a short-range wireless communication technology operating at 13.56 MHz that enables contactless data exchange between devices within approximately 4 centimetres. Based on inductive coupling and derived from RFID standards, NFC supports three operating modes: card emulation (device acts as a smart card), reader/writer (device reads or writes NFC tags), and peer-to-peer (two active devices exchange data). It underpins contactless payments, identity verification, and rapid device pairing."@en ;
    rdfs:subClassOf ngm:communication-protocol ;
    vc:enables ngm:access-control-system,
        ngm:digital-payment-system,
        ngm:digital-payments ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:communication-interface,
        ngm:embedded-systems,
        ngm:io-t-sensor-network ;
    vc:slug "near-field-communication" ;
    vc:sourceDomain "hardware" ;
    vc:uses ngm:hardware-security-module .

ngm:networking-layer a owl:Class ;
    rdfs:label "Networking Layer"@en ;
    rdfs:comment "Communication systems that connect components and users across distributed metaverse environments through network protocols and software."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:physical-network-hardware ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:communication-protocol ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:network-standards ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:network-protocol ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:communication-software ],
        ngm:infrastructure-architecture,
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:enables ngm:cross-platform-connectivity,
        ngm:distributed-computing,
        ngm:low-latency-interaction,
        ngm:real-time-communication ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:communication-software,
        ngm:data-transmission-service,
        ngm:network-protocol,
        ngm:routing-infrastructure ;
    vc:isPartOf ngm:infrastructure-architecture ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:communication-protocol,
        ngm:network-standards,
        ngm:physical-network-hardware ;
    vc:slug "networking-layer" ;
    vc:sourceDomain "spatial-computing" .

ngm:networking-technology a owl:Class ;
    rdfs:label "Networking Technology"@en ;
    rdfs:comment "The protocols, hardware, and software frameworks that enable real-time data transmission, synchronisation, and communication between distributed participants. In spatial computing contexts this encompasses WebRTC, QUIC, UDP/TCP stacks, adaptive bitrate streaming, and delta-compression techniques that support low-latency avatar synchronisation and shared world-state updates."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:network-quality-metric ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:open-standard ],
        ngm:infra-network-and-comms ;
    skos:broader ngm:infra-network-and-comms ;
    vc:enables ngm:multi-user-systems,
        ngm:real-time ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:network-quality-metric,
        ngm:open-standard ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:slug "networking-technology" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:edge-computing,
        ngm:spatial-computing ;
    vc:uses ngm:distributed-system .

ngm:non-fungible-token a owl:Class ;
    rdfs:label "Non-Fungible Token"@en ;
    rdfs:comment "A token standard in which each unit is distinct and not interchangeable, used to represent ownership of a specific digital or referenced physical item on a ledger."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:erc-721 ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:smart-contract ],
        ngm:token ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:erc-721,
        ngm:smart-contract ;
    vc:slug "non-fungible-token" ;
    vc:sourceDomain "blockchain" .

ngm:nostr a owl:Class ;
    rdfs:label "Nostr"@en ;
    rdfs:comment "Nostr (Notes and Other Stuff Transmitted by Relays) is an open, censorship-resistant social-messaging protocol built around a minimal event model in which users identify themselves by a secp256k1 cryptographic key pair and publish signed JSON events to one or more relay servers over WebSocket connections. The protocol has no central server: identity is purely the public key, and relays are interchangeable infrastructure that store and forward events without requiring accounts or trust; clients subscribe to relays using filter objects and receive matching events. Nostr Improvement Proposals (NIPs) extend the core event kind system to cover short-form notes, long-form articles, direct messages (encrypted with NIP-04/NIP-44), zap payments (Lightning Network), community moderation, and identity verification. Its radical simplicity and cryptographic self-sovereignty have made Nostr the primary decentralised social-layer for the Bitcoin and Lightning ecosystem."@en ;
    rdfs:subClassOf ngm:nostr-protocol ;
    vc:enables ngm:decentralised-identity,
        ngm:decentralised-web,
        ngm:social-network-graph ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:censorship-resistance,
        ngm:did-nostr-identity,
        ngm:self-sovereign-identity ;
    vc:slug "nostr" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:public-key,
        ngm:public-key-cryptography,
        ngm:web-socket .

ngm:notified-body a owl:Class ;
    rdfs:label "Notified Body"@en ;
    rdfs:comment "An independent third-party conformity assessment organisation formally designated by a national notifying authority under the EU AI Act (Articles 29–39) to audit and certify high-risk AI systems — particularly biometric identification and product-safety-component systems — against technical documentation, quality management, and harmonised standards requirements."@en ;
    rdfs:subClassOf ngm:infra-legal-and-regulatory,
        ngm:regulatory-framework ;
    skos:broader ngm:infra-legal-and-regulatory ;
    vc:dependsOn ngm:accountability,
        ngm:transparency ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:implements ngm:conformity-assessment ;
    vc:isPartOf ngm:regulatory-framework ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:slug "notified-body" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:ai-governance,
        ngm:national-competent-authority .

ngm:object-recognition a owl:Class ;
    rdfs:label "Object Recognition"@en ;
    rdfs:comment "Object recognition is a computer vision task that involves identifying and localising instances of predefined object categories within images or video streams, producing class labels, bounding boxes, segmentation masks, or pose estimates depending on the task variant. It subsumes tasks including image classification, object detection, semantic segmentation, and instance segmentation, and has become a core capability of autonomous systems, augmented reality, and content understanding pipelines. Modern approaches are dominated by deep convolutional and transformer-based architectures trained on large annotated datasets."@en ;
    rdfs:subClassOf ngm:computer-vision-task ;
    vc:enables ngm:augmented-reality,
        ngm:autonomous-driving,
        ngm:robotics ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:image-classification,
        ngm:image-segmentation,
        ngm:object-detection,
        ngm:pattern-recognition ;
    vc:slug "object-recognition" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:convolutional-neural-network,
        ngm:deep-learning,
        ngm:feature-extraction .

ngm:object-storage a owl:Class ;
    rdfs:label "Object Storage"@en ;
    rdfs:comment "Object storage is a data storage architecture that manages data as discrete objects — each comprising an opaque payload, a globally unique identifier, and extensible metadata — accessed via a flat namespace through RESTful HTTP APIs rather than a file hierarchy or block device. It is designed for massive horizontal scalability, high durability, and cost-effective storage of unstructured data such as media files, backups, and machine-learning datasets. Amazon S3 established the de facto API standard, now implemented by numerous compatible services."@en ;
    rdfs:subClassOf ngm:data-storage ;
    vc:enables ngm:content-addressed-storage,
        ngm:data-lake,
        ngm:distributed-storage ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:block-storage,
        ngm:cloud-storage ;
    vc:slug "object-storage" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:http-protocol,
        ngm:rest-api .

ngm:on-device-learning a owl:Class ;
    rdfs:label "On-Device Learning"@en ;
    rdfs:comment "Machine learning model training and adaptation occurring directly on end-user devices using only local data, without transmitting raw data to cloud servers. Enables personalised model adaptation, privacy preservation, and offline functionality while addressing challenges of limited compute, memory, and energy. Implemented through transfer learning, few-shot adaptation, and continual learning techniques on mobile and embedded platforms."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:model-compression-for-edge ],
        ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:enables ngm:ai-deployment,
        ngm:edge-ai-system ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:differential-privacy,
        ngm:edge-computing,
        ngm:internet-of-things,
        ngm:knowledge-distillation-for-edge,
        ngm:tiny-ml ;
    vc:requires ngm:model-compression-for-edge ;
    vc:slug "on-device-learning" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:federated-learning,
        ngm:machine-learning-framework,
        ngm:transfer-learning .

ngm:opc-ua a owl:Class ;
    rdfs:label "OPC UA"@en ;
    rdfs:comment "OPC Unified Architecture (OPC UA) is an open, platform-independent, service-oriented communication standard developed by the OPC Foundation for secure and reliable data exchange in industrial automation and the Industrial Internet of Things. It provides a unified information model that merges process data, alarms, historical data, and device metadata into a single addressable namespace accessible via TCP binary or HTTPS transport, replacing the earlier COM/DCOM-based OPC Classic specifications with a cross-platform, scalable architecture."@en ;
    rdfs:subClassOf ngm:interoperability-standard ;
    vc:enables ngm:digital-twin,
        ngm:industrial-automation,
        ngm:industrial-io-t,
        ngm:real-time-monitoring ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:control-system,
        ngm:sensor ;
    vc:slug "opc-ua" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:mqtt,
        ngm:open-standard,
        ngm:semantic-interoperability .

ngm:open-ai-whisper a owl:Class ;
    rdfs:label "Open AI Whisper"@en ;
    rdfs:comment "OpenAI Whisper is an open-source automatic speech recognition (ASR) system released by OpenAI in September 2022, trained on approximately 680,000 hours of multilingual and multitask supervised audio data sourced from the internet. It employs a Transformer encoder-decoder architecture that jointly learns transcription, translation, and language identification from weakly supervised training data, achieving near-human accuracy across a broad range of accents, recording conditions, and languages. Whisper is released as open weights in multiple sizes (tiny, base, small, medium, large, and subsequent variants), enabling local deployment without API dependency. Its robustness to background noise, accented speech, and domain-specific vocabulary—combined with zero-shot multilingual performance—has made it the de facto baseline for ASR research and a widely deployed component in transcription pipelines, voice interfaces, and accessibility applications."@en ;
    rdfs:subClassOf ngm:automatic-speech-recognition ;
    vc:enables ngm:meeting-transcription,
        ngm:real-time-transcription ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:natural-language-processing,
        ngm:open-ai,
        ngm:speech-recognition,
        ngm:transformer-architecture ;
    vc:slug "open-ai-whisper" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:audio-processing-system,
        ngm:speech-and-voice .

ngm:open-cv a owl:Class ;
    rdfs:label "OpenCV"@en ;
    rdfs:comment "OpenCV (Open Source Computer Vision Library) is a BSD-licensed open-source library providing over 2,500 optimised algorithms for real-time computer vision, image processing, and machine learning, originally developed by Intel and now maintained by the OpenCV Foundation. It supports C++, Python, Java, and JavaScript bindings and runs on Linux, Windows, macOS, iOS, and Android. The library encompasses classical algorithms for feature detection, camera calibration, stereo vision, optical flow, and object tracking, as well as deep learning inference through the DNN module, which supports models from TensorFlow, PyTorch, and ONNX. OpenCV is the de facto standard toolkit for robotics perception pipelines, augmented reality applications, and embedded vision systems."@en ;
    rdfs:subClassOf ngm:computer-vision-system ;
    vc:enables ngm:camera-calibration,
        ngm:depth-estimation,
        ngm:object-detection-and-tracking ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:computer-vision,
        ngm:image-processing-software,
        ngm:object-detection ;
    vc:slug "open-cv" ;
    vc:sourceDomain "ai" ;
    vc:supports ngm:augmented-reality,
        ngm:perception-system ;
    vc:uses ngm:feature-extraction,
        ngm:image-segmentation .

ngm:open-id4-vci a owl:Class ;
    rdfs:label "OpenID4VCI"@en ;
    rdfs:comment "OpenID for Verifiable Credential Issuance (OpenID4VCI) is an OpenID Foundation protocol specification that defines a standard API by which an Issuer can deliver W3C Verifiable Credentials to a Holder's digital wallet using OAuth 2.0 and OpenID Connect as the underlying authorisation and identity layer. The protocol specifies credential offer flows, authorisation code and pre-authorised code grant types, credential endpoint interactions, and metadata discovery, enabling interoperable credential issuance across identity wallet implementations and issuing authority systems. It is designed to complement OpenID4VP (Verifiable Presentations) to form a complete self-sovereign identity exchange ecosystem."@en ;
    rdfs:subClassOf ngm:credential-issuance ;
    vc:enables ngm:decentralized-identity,
        ngm:digital-identity-wallet ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:credential-format-standard,
        ngm:open-id4-vp,
        ngm:sd-jwt ;
    vc:slug "open-id4-vci" ;
    vc:sourceDomain "governance" ;
    vc:uses ngm:oauth-2-0,
        ngm:open-id-connect,
        ngm:verifiable-credentials .

ngm:open-source-framework a owl:Class ;
    rdfs:label "Open Source Framework"@en ;
    rdfs:comment "A publicly licensed software framework whose source code is freely available for inspection, modification, and redistribution under an approved open-source licence. Open source frameworks provide reusable architectural scaffolding—APIs, libraries, conventions, and tooling—that accelerate development whilst enabling community-driven quality assurance, security auditing, and interoperability across vendor boundaries."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:api-standard ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:open-source-software ],
        ngm:infra-software-engineering ;
    skos:broader ngm:infra-software-engineering ;
    vc:enables ngm:interoperability,
        ngm:machine-learning-framework ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:api-standard,
        ngm:open-source-software ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:game-engine,
        ngm:robot-operating-system ;
    vc:slug "open-source-framework" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:open-source-ai .

ngm:open-world a owl:Class ;
    rdfs:label "Open World"@en ;
    rdfs:comment "A game design paradigm featuring large-scale virtual environments with non-linear progression, extensive player freedom, emergent gameplay, and exploratory mechanics that allow users to interact with the world in diverse ways beyond predetermined narrative paths."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:procedural-generation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:state-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:emergent-gameplay ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:virtual-environment ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:non-linear-narrative ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ai-system ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:game-engine ],
        [ a owl:Restriction ;
