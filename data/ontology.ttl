ngm:collision-resistance a owl:Class ;
    rdfs:label "Collision Resistance"@en ;
    rdfs:comment "A security property of a cryptographic hash function asserting that it is computationally infeasible to find two distinct inputs that produce the same output digest. Collision resistance underpins the integrity guarantees of Merkle trees, digital signatures, and proof-of-work puzzles, and its absence would allow adversaries to forge blocks or certificates."@en ;
    rdfs:subClassOf ngm:bc-cryptographic-primitive,
        ngm:blockchain-entity ;
    skos:broader ngm:bc-cryptographic-primitive ;
    vc:enables ngm:digital-signature,
        ngm:merkle-tree,
        ngm:proof-of-work ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:bc-cryptographic-primitive ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:cryptographic-hash-function,
        ngm:hash-function,
        ngm:keccak-256,
        ngm:preimage-resistance,
        ngm:sha-256 ;
    vc:slug "collision-resistance" ;
    vc:sourceDomain "blockchain" .

ngm:conflict-resolution a owl:Class ;
    rdfs:label "Conflict Resolution"@en ;
    rdfs:comment "Conflict Resolution encompasses the structured methods, protocols, and mechanisms used to identify, address, and settle disputes between parties, whether human individuals, organisations, autonomous agents, or distributed systems. In technical contexts, it includes algorithmic approaches for resolving inconsistencies in distributed data systems, consensus protocols that reconcile divergent states, and governance frameworks for mediating disagreements in decentralised organisations. In social and legal contexts it spans negotiation, mediation, arbitration, and adjudication, with increasing automation and AI-assisted facilitation. Across both domains, effective conflict resolution preserves relationships, maintains system integrity, and enables continued collaboration."@en ;
    rdfs:subClassOf ngm:dispute-resolution-mechanism ;
    vc:enables ngm:community-governance-model,
        ngm:decentralized-governance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:arbitration-decision-engine,
        ngm:arbitration-process,
        ngm:consensus-mechanism ;
    vc:slug "conflict-resolution" ;
    vc:sourceDomain "governance" ;
    vc:supports ngm:multi-agent-systems ;
    vc:uses ngm:dao-governance,
        ngm:smart-contract-coordination .

ngm:consensus-rule a owl:Class ;
    rdfs:label "Consensus Rule"@en ;
    rdfs:comment "A Consensus Rule is a protocol-level validation requirement that every fully-validating node in a blockchain network must enforce uniformly to reach and maintain agreement on the canonical chain state. Consensus rules define which blocks and transactions are valid, covering aspects such as block structure, cryptographic proofs, transaction format, gas limits, and state-transition logic. Deviation from consensus rules — whether accidental or deliberate — results in a fork, splitting the network into incompatible chains."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:fork-choice-rule ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:blockchain-network ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:consensus-mechanism ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:distributed-ledger ],
        ngm:bc-protocol-and-consensus,
        ngm:blockchain-entity,
        ngm:consensus-protocol ;
    skos:broader ngm:bc-protocol-and-consensus ;
    vc:contrastsWith ngm:governance-model ;
    vc:enables ngm:blockchain-governance,
        ngm:finality,
        ngm:smart-contract ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:fork-choice-rule ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:51-attack,
        ngm:blockchain,
        ngm:byzantine-fault-tolerance,
        ngm:proof-of-stake,
        ngm:proof-of-work,
        ngm:validator-set ;
    vc:requires ngm:blockchain-network,
