ngm:task-planning a owl:Class ;
    rdfs:label "Task Planning"@en ;
    rdfs:comment "Task Planning is the computational sub-field of artificial intelligence and robotics concerned with automatically synthesising finite sequences of discrete actions — called plans — that transform a given initial world state into a state satisfying a specified goal condition, subject to action pre..."@en ;
