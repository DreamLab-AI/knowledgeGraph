ngm:client-side-validation-theory a owl:Class ;
    rdfs:label "Client-Side Validation Theory"@en ;
    rdfs:comment "Client-side validation theory is the conceptual framework in which the validity of state transitions is verified by the affected parties themselves rather than by every node of a global consensus layer, with the blockchain used only to commit to and order single-use seals. Data and proofs are kept off-chain and shared peer-to-peer, so the base chain provides ordering and double-spend prevention without learning transaction contents. It matters because it underpins scalable, private smart-contract systems such as RGB that inherit Bitcoin's security without bloating its chain."@en ;
    rdfs:subClassOf ngm:bc-protocol-and-consensus ;
    skos:broader ngm:bc-protocol-and-consensus ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:rgb-and-client-side-validation ;
    vc:slug "client-side-validation-theory" ;
    vc:sourceDomain "blockchain" .

