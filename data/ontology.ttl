ngm:vp-robotics-project a owl:Class ;
    rdfs:label "VP robotics project"@en ;
    rdfs:comment "The VP Robotics Project (VisionFlow) is a feasibility study investigating the integration of robotic camera control with machine learning and virtual production workflows. It inverts conventional pre-visualisation pipelines by deriving scene-driven camera motion from AI-generated content, combining open-source robotics software with parallax-plates-as-a-service delivery for the film and television industry."@en ;
    rdfs:subClassOf ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:enables ngm:virtual-production,
        ngm:virtual-set-design ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:motion-capture,
        ngm:robotics-control ;
    vc:slug "vp-robotics-project" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:machine-learning,
        ngm:robotics .

ngm:vrchat a owl:Class ;
    rdfs:label "VRChat"@en ;
    rdfs:comment "VRChat is a social virtual reality platform where users interact as custom avatars in user-created 3D worlds, with support for both VR headsets and desktop access."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:avatar-system ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:virtual-reality ],
        ngm:metaverse-platform ;
    vc:enables ngm:avatar-customization,
        ngm:social-vr ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:avatar-system,
        ngm:virtual-reality ;
    vc:slug "vrchat" ;
    vc:sourceDomain "metaverse" .

ngm:w-3-c-2022-did-core-1-0-recommendation a owl:Class ;
    rdfs:label "W3C 2022 DID Core 1.0 Recommendation"@en ;
    rdfs:comment "The W3C Recommendation for Decentralized Identifiers (DIDs) version 1.0, published in 2022, defining the core DID data model, syntax and resolution architecture. It establishes DIDs as a standard type of verifiable identifier."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:w3-c ],
        ngm:technical-standard ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:w3-c ;
    vc:slug "w-3-c-2022-did-core-1-0-recommendation" ;
    vc:sourceDomain "standards" .

ngm:w-3-c-cognitive-ai-community-group a owl:Class ;
    rdfs:label "W3C Cognitive AI Community Group"@en ;
    rdfs:comment "The W3C Cognitive AI Community Group is a W3C community group that explores approaches to cognitive artificial intelligence and related Web technologies."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:w3-c ],
        ngm:technical-standard ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:w3-c ;
    vc:slug "w-3-c-cognitive-ai-community-group" ;
    vc:sourceDomain "standards" .

ngm:w-3-c-did-core-specification a owl:Class ;
    rdfs:label "W3C DID Core Specification"@en ;
    rdfs:comment "A W3C specification defining decentralised identifiers (DIDs), a type of identifier that enables verifiable, self-sovereign digital identity independent of any centralised registry. It defines the DID data model and syntax."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:w3-c ],
        ngm:technical-standard ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:w3-c ;
    vc:slug "w-3-c-did-core-specification" ;
    vc:sourceDomain "standards" .

ngm:w-3-c-prov-o a owl:Class ;
    rdfs:label "W3C PROV-O"@en ;
    rdfs:comment "A W3C Recommendation defining the PROV Ontology, an OWL ontology for expressing provenance information using the PROV data model. It represents entities, activities and agents involved in producing data."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:w3-c ],
        ngm:technical-standard ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:w3-c ;
    vc:slug "w-3-c-prov-o" ;
    vc:sourceDomain "standards" .

ngm:w-3-c-standards a owl:Class ;
    rdfs:label "W3C Standards"@en ;
    rdfs:comment "A general reference to standards published by the World Wide Web Consortium (W3C). No specific standard is identified by this label alone."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:w3-c ],
        ngm:technical-standard ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:w3-c ;
    vc:slug "w-3-c-standards" ;
    vc:sourceDomain "standards" .

ngm:w-3-c-verifiable-credentials-data-model-2-0 a owl:Class ;
    rdfs:label "W3C Verifiable Credentials Data Model 2.0"@en ;
    rdfs:comment "A W3C specification, version 2.0, defining a data model for verifiable credentials that can be cryptographically verified. It describes the structure of credentials, claims and presentations."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:w3-c ],
        ngm:technical-standard ;
