ngm:empirical-experimental-design-tracking a owl:Class ;
    rdfs:label "Experiment Tracking"@en ;
    rdfs:comment "Experiment tracking is the practice of recording the configuration, code, data, and results of machine learning experiments so they can be compared and reproduced, enabling teams to audit, iterate, and roll back to prior model states. It is a core discipline within MLOps."@en ;
