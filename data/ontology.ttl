# XLNet
spatial-computing:XLNet rdf:type owl:Class ;
    rdfs:label "XLNet"@en ;
    rdfs:comment "A generalised autoregressive pre-training method that learns bidirectional contexts by maximising expected likelihood over all permutations of the factorisation order, overcoming limitations of BERT's masked language modelling."@en ;
