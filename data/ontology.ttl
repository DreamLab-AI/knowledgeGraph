        ngm:ai-governance-and-ethics ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:bridgesTo ngm:data-analysis,
        ngm:privacy-enhancing-technologies ;
    vc:enables ngm:gdpr-compliance,
        ngm:privacy-by-design,
        ngm:regulatory-safe-harbour ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:differential-privacy,
        ngm:federated-learning,
