    vc:qualityScore "0.35"^^xsd:float ;
    vc:slug "protocol-layer" ;
    vc:sourceDomain "infrastructure" .

ngm:proxemics a owl:Class ;
    rdfs:label "Proxemics"@en ;
    rdfs:comment "The study and application of interpersonal and human-robot spatial relationships — including intimate, personal, social, and public distance zones — to design robotic systems that behave in spatially appropriate ways. Proxemics-aware robots adjust their approach trajectories, velocities, and stopping distances in response to detected human zones, improving perceived safety, comfort, and social acceptability in shared environments."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:motion-planning ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:proximity-detection ],
        ngm:robo-human-robot-interaction ;
    skos:broader ngm:robo-human-robot-interaction ;
    vc:enables ngm:collision-avoidance,
        ngm:embodied-ai ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:human-robot-interaction,
        ngm:social-robotics ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:attention-aware-interaction,
        ngm:emotion-aware-interaction,
        ngm:human-computer-interaction ;
    vc:requires ngm:motion-planning,
        ngm:proximity-detection ;
    vc:slug "proxemics" ;
    vc:sourceDomain "robotics" .

ngm:rb-0028-forward-kinematics a owl:Class ;
    rdfs:label "rb 0028 forward kinematics"@en ;
    rdfs:comment "Forward kinematics (FK) is the mathematical process of computing the position and orientation of a robot's end effector in Cartesian space given a known set of joint angles or displacements. Using a chain of homogeneous transformation matrices (typically expressed using Denavit-Hartenberg parameters), FK provides a unique, computationally deterministic mapping from joint space to task space. It is used in motion planning, visualisation, and safety monitoring to determine where the robot tool tip is at any instant, and underpins workspace analysis, collision checking, and trajectory verification."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:rb-0072-encoder ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:rb-0026-robot-joint ],
        ngm:kinematics,
        ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:contrastsWith ngm:rb-0029-inverse-kinematics ;
    vc:enables ngm:rb-0049-motion-planning,
        ngm:rb-0052-collision-avoidance ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:rb-0021-robot-kinematics,
        ngm:rb-0024-workspace,
        ngm:rb-0030-jacobian-matrix,
        ngm:rb-0031-singularity ;
    vc:requires ngm:rb-0026-robot-joint,
        ngm:rb-0072-encoder ;
    vc:slug "rb-0028-forward-kinematics" ;
    vc:sourceDomain "robotics" .

ngm:rb-0036-resolution a owl:Class ;
    rdfs:label "rb 0036 resolution"@en ;
    rdfs:comment "Resolution, as defined by ISO 8373, is the smallest increment of motion or measurement that a robot system can distinguish or command. For manipulators it typically refers to the minimum step size achievable in Cartesian or joint space; for sensors it denotes the smallest detectable change in the measured quantity. Resolution is distinct from accuracy and repeatability, and it places a fundamental lower bound on the precision of both positioning and perception tasks."@en ;
    rdfs:subClassOf ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:dependsOn ngm:rb-0026-robot-joint,
        ngm:rb-0040-backlash ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:rb-0023-degrees-of-freedom,
        ngm:rb-0034-repeatability,
        ngm:rb-0035-accuracy,
        ngm:rb-0072-encoder ;
    vc:slug "rb-0036-resolution" ;
    vc:sourceDomain "robotics" ;
    vc:supports ngm:rb-0032-manipulability,
        ngm:rb-0054-position-control .

ngm:rb-0044-velocity a owl:Class ;
    rdfs:label "rb 0044 velocity"@en ;
    rdfs:comment "In robotics, velocity refers to the time-derivative of position, encompassing both linear velocity (metres per second) at the end-effector or a body-frame point, and angular velocity (radians per second) describing rotational rate. Velocity is the central quantity in differential kinematics: the Jacobian matrix maps joint-space velocity vectors to Cartesian task-space velocities. Velocity limits are safety-critical parameters in collaborative robot standards (ISO/TS 15066) where end-effector speed directly determines permissible human contact force."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:rb-0021-robot-kinematics ],
        ngm:robo-actuation-and-control,
        ngm:robot-kinematics ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:enables ngm:rb-0049-motion-planning,
        ngm:rb-0055-velocity-control ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:differential-kinematics,
        ngm:rb-0030-jacobian-matrix,
        ngm:rb-0043-torque,
        ngm:rb-0045-acceleration ;
    vc:requires ngm:rb-0021-robot-kinematics ;
    vc:slug "rb-0044-velocity" ;
    vc:sourceDomain "robotics" ;
    vc:standardizedBy ngm:rb-0093-speed-limitation .

ngm:rb-0061-nonlinear-control a owl:Class ;
    rdfs:label "rb 0061 nonlinear control"@en ;
    rdfs:comment "Nonlinear control encompasses control strategies designed for systems whose dynamics cannot be adequately described by linear differential equations. In robotics, virtually all manipulators and mobile platforms exhibit nonlinear behaviour due to inertia coupling, Coriolis terms, gravity loading, and joint friction. Nonlinear control techniques—including computed-torque control, sliding-mode control, feedback linearisation, Lyapunov-based methods, and model predictive control—explicitly account for these nonlinearities to achieve stable, high-performance trajectory tracking across the full operating envelope."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:rb-0064-computed-torque-control ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:rb-0022-robot-dynamics ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:rb-0063-sliding-mode-control ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:rb-0062-model-predictive-control ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:rb-0021-robot-kinematics ],
        ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:contrastsWith ngm:rb-0048-pid-controller ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:rb-0062-model-predictive-control,
        ngm:rb-0063-sliding-mode-control,
        ngm:rb-0064-computed-torque-control ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:adaptive-control,
        ngm:rb-0047-feedback-control,
        ngm:rb-0060-optimal-control ;
    vc:requires ngm:rb-0021-robot-kinematics,
        ngm:rb-0022-robot-dynamics ;
    vc:slug "rb-0061-nonlinear-control" ;
    vc:sourceDomain "robotics" .

ngm:rb-1007-trajectory-generation a owl:Class ;
    rdfs:label "RB-1007-trajectory-generation"@en ;
    rdfs:comment "RB-1007 Trajectory Generation is a robotics knowledge-base entry cataloguing the algorithms, mathematical representations, and computational methods used to synthesise smooth, dynamically feasible motion trajectories for robotic systems, specifying how a robot must move through configuration space or task space from an initial to a goal state while satisfying kinematic, dynamic, and environmental constraints. It covers polynomial spline interpolation, time-optimal trajectory planning, jerk-limited profiles, and learned trajectory generation approaches, forming the bridge between high-level task planning and low-level joint control execution."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:inverse-kinematics ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:kinematics ],
        ngm:trajectory-generation ;
    vc:enables ngm:autonomous-navigation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:rb-0051-trajectory-planning,
        ngm:trajectory-control,
        ngm:trajectory-planning ;
    vc:requires ngm:inverse-kinematics,
        ngm:kinematics ;
    vc:slug "rb-1007-trajectory-generation" ;
    vc:sourceDomain "robotics" ;
    vc:supports ngm:motion-control,
        ngm:motion-planning .

ngm:rb-1008-odometry a owl:Class ;
    rdfs:label "RB-1008-odometry"@en ;
    rdfs:comment "RB-1008-odometry refers to the odometric positioning subsystem of the RB-1008 wheeled mobile robot platform, encompassing the encoder-based wheel odometry algorithms, sensor fusion pipelines, and ROS navigation stack integration used to estimate the robot's pose (position and orientation) relative to a starting frame. The system computes incremental displacement from differential or omnidirectional wheel encoders, corrects for wheel slip and encoder quantisation errors, and fuses encoder data with inertial measurement unit (IMU) readings to produce a continuous odometric estimate used as the prior for simultaneous localisation and mapping (SLAM) and autonomous navigation. Accurate odometry is essential for maintaining coherent map frames and for the navigation stack's local cost-map updates between LIDAR scan matches."@en ;
    rdfs:subClassOf ngm:odometry ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:mobile-robot-platform,
        ngm:wheeled-mobile-robot ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:autonomous-navigation,
        ngm:localization,
        ngm:visual-odometry ;
    vc:slug "rb-1008-odometry" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:ros-navigation-stack,
        ngm:sensor-fusion,
        ngm:slam .

