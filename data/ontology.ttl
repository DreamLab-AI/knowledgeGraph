        ngm:social-choice-theory,
        ngm:sybil-resistance ;
    vc:contrastsWith ngm:conviction-voting,
        ngm:one-person-one-vote,
        ngm:quadratic-voting ;
    vc:dependsOn ngm:blockchain,
        ngm:token-economics ;
    vc:enables ngm:decentralised-decision-making,
        ngm:parameter-governance,
        ngm:protocol-upgrades,
        ngm:treasury-management ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:dao-governance,
        ngm:on-chain-governance ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:dao-governance,
        ngm:defi-protocol,
        ngm:governance-attack,
        ngm:plutocracy,
        ngm:snapshot-voting ;
    vc:requires ngm:erc-20-tokens,
        ngm:quorum-threshold ;
    vc:slug "token-weighted-voting" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:governance-token,
        ngm:liquid-democracy,
        ngm:on-chain-voting,
        ngm:smart-contract,
        ngm:vote-escrow .

ngm:web-xr a owl:Class ;
    rdfs:label "WebXR"@en ;
    rdfs:comment "WebXR is a W3C web standard and browser API that enables access to virtual reality and augmented reality hardware, exposing device pose tracking, controller input, reference spaces, and an XR-integrated render loop so that immersive spatial experiences can be delivered through ordinary URLs without native installation."@en ;
