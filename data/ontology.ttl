ngm:amd-sev a owl:Class ;
    rdfs:label "Amd Sev"@en ;
    rdfs:comment "AMD SEV (Secure Encrypted Virtualisation) is a hardware security technology that encrypts the memory of individual virtual machines using per-VM keys managed by an on-chip security processor, isolating guest memory from the hypervisor and other VMs. Extensions add register-state encryption and integrity protection with attestation, enabling confidential virtual machines whose contents are protected even from a privileged host. It is a leading approach to confidential computing in cloud environments."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:hardware-security ],
        ngm:confidential-computing ;
    vc:contrastsWith ngm:intel-sgx,
        ngm:trusted-execution-environment ;
    vc:dependsOn ngm:hardware-security,
        ngm:memory-encryption ;
    vc:enables ngm:cloud-security ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:trusted-execution-environment ;
    vc:isPartOf ngm:confidential-computing ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:attestation,
        ngm:cloud-security,
        ngm:secure-enclave ;
    vc:requires ngm:hardware-security ;
    vc:slug "amd-sev" ;
    vc:sourceDomain "security" ;
    vc:supports ngm:hypervisor ;
    vc:uses ngm:attestation,
        ngm:memory-encryption,
        ngm:virtualisation .

ngm:anti-counterfeiting a owl:Class ;
    rdfs:label "Anti Counterfeiting"@en ;
    rdfs:comment "Blockchain-based systems employing cryptographic verification, immutable ledgers, and physical-digital integration technologies (NFC tags, QR codes, RFID) to authenticate products, prevent counterfeiting, and establish verifiable supply chain provenance across pharmaceuticals, luxury goods, electronics, and consumer products."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
