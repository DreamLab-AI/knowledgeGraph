ngm:identity-attestation a owl:Class ;
    rdfs:comment "Identity attestation is a cryptographically signed claim, issued by a trusted party, that vouches for an attribute or fact about a digital identity, such as personhood, credential possession or eligibility. It is verified through digital-signature verification against the issuer's public key, allowing a relying party to trust the claim without contacting the issuer directly. Attestation schemes are used in decentralised identity systems and in platforms such as Gitcoin to establish sybil-resistant, verifiable identity without revealing underlying personal data."@en ;
    rdfs:label "Identity Attestation"@en ;
    rdfs:subClassOf ngm:digital-identity ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.55"^^xsd:float ;
    vc:slug "identity-attestation" ;
    vc:sourceDomain "security" .
