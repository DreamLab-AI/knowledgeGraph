ngm:etsi-domain-data-management-ai a owl:Class ;
    rdfs:label "ETSI Domain: Data Management + AI"@en ;
    rdfs:comment "Crossover domain for ETSI metaverse categorisation addressing data infrastructure supporting AI/ML workflows, training data management, model versioning, and inference serving."@en ;
    rdfs:subClassOf ngm:etsi-domain-ai-data-mgmt ;
    vc:enables ngm:data-versioning,
        ngm:ml-operations,
        ngm:model-deployment ;
    vc:hasPart ngm:experiment-tracking,
        ngm:feature-store,
        ngm:model-registry,
        ngm:training-data-repository ;
    vc:isPartOf ngm:etsi-metaverse-domain-taxonomy ;
    vc:maturity "established" ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:ai-and-machine-learning,
        ngm:data-management ;
    vc:slug "etsi-domain-data-management-ai" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:etsi-domain-data-management-ethics a owl:Class ;
    rdfs:label "ETSI Domain: Data Management + Ethics"@en ;
    rdfs:comment "Crossover domain for ETSI metaverse categorisation addressing ical data handling, privacy-preserving storage, consent management, and responsible data governance."@en ;
    rdfs:subClassOf ngm:artificial-intelligence ;
    vc:enables ngm:compliance-verification,
        ngm:privacy-preserving-analytics,
        ngm:user-control ;
    vc:hasPart ngm:anonymization,
        ngm:audit-logging,
        ngm:consent-management,
        ngm:privacy-controls ;
    vc:isPartOf ngm:etsi-metaverse-domain-taxonomy ;
    vc:maturity "established" ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:data-management,
        ngm:ethics-and-law ;
    vc:slug "etsi-domain-data-management-ethics" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:etsi-domain-immersive a owl:Class ;
    rdfs:label "Etsi Domain Immersive"@en ;
    rdfs:comment "The ETSI technical domain addressing standardisation of immersive technologies including virtual reality, augmented reality, and mixed reality systems, encompassing network requirements, quality of experience metrics, and interoperability specifications for XR applications."@en ;
    rdfs:subClassOf ngm:etsi-standards ;
    vc:maturity "draft" ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:slug "etsi-domain-immersive" ;
    vc:sourceDomain "spatial-computing" .

ngm:etsi-domain-immersive-reality-capture-crossover a owl:Class ;
    rdfs:label "ETSI Domain Immersive + Reality Capture Crossover"@en ;
    rdfs:comment "Domain categorization marker indicating metaverse systems operating at the intersection of immersive interaction capabilities and reality capture technologies for photorealistic virtual environment creation."@en ;
    rdfs:subClassOf ngm:etsi-metaverse-domain-model ;
    vc:enables ngm:photorealistic-immersion,
        ngm:spatial-interaction,
        ngm:volumetric-capture ;
    vc:isPartOf ngm:etsi-metaverse-domain-model ;
    vc:maturity "established" ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:etsi-domain-immersive,
        ngm:etsi-domain-reality-capture ;
    vc:slug "etsi-domain-immersive-reality-capture-crossover" ;
    vc:sourceDomain "spatial-computing" .

ngm:etsi-domain-reality-capture a owl:Class ;
    rdfs:label "ETSI_Domain_Reality_Capture"@en ;
    rdfs:comment "ETSI technical framework enabling digital reconstruction of physical environments and objects through 3D scanning, photogrammetry, sensor fusion, and motion capture to create semantic [[DigitalTwin|digital twins]] for metaverse and immersive environments."@en ;
    rdfs:subClassOf ngm:spatial-computing ;
    vc:maturity "draft" ;
    vc:qualityScore "0.4"^^xsd:float ;
    vc:slug "etsi-domain-reality-capture" ;
    vc:sourceDomain "spatial-computing" .

