    vc:supports ngm:robotics ;
    vc:uses ngm:communication-protocol ;
    vc:uses ngm:knowledge-representation .
ngm:complete-ontology-index a owl:Class ;
    rdfs:comment "A comprehensive reference catalogue documenting and interconnecting all ontology terms, semantic classifications, and knowledge relationships across multiple domains and knowledge graphs. This index enables discovery, navigation, and semantic reasoning across the entire knowledge base, serving as the master pointer for all class hierarchies and inter-domain relations."@en ;
    rdfs:label "COMPLETE ONTOLOGY INDEX"@en ;
