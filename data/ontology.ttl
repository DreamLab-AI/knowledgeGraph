vf:delta-robot a owl:Class ;
    rdfs:label "Delta Robot"@en ;
    rdfs:comment "Delta robot employs parallel kinematics where three or more kinematic chains connect actuators to an end-effector platform, constraining motion through parallelogram linkages to pure translation. This architecture enables extremely high speed and acceleration, positioning delta robots as the preferred design for [[Pick and Place]] operations and applications demanding rapid, precise point-to-point motion."@en ;
    rdfs:subClassOf <urn:visionflow:linked:parallel-robots>,
        vf:industrial-robot ;
    vc:authorityScore "0.95"^^xsd:float ;
    vc:enables <urn:visionflow:linked:high-speed-picking>,
        <urn:visionflow:linked:rapid-sorting>,
        <urn:visionflow:linked:ultra-fast-placement>,
        vf:parallel-processing ;
    vc:hasPart <urn:visionflow:linked:actuator-motors>,
        <urn:visionflow:linked:end-effector-platform>,
        <urn:visionflow:linked:kinematic-chains>,
        <urn:visionflow:linked:parallelogram-linkages> ;
    vc:maturity "established" ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires <urn:visionflow:linked:coordinated-control>,
        <urn:visionflow:linked:high-performance-actuators>,
        <urn:visionflow:linked:stiff-support-structure>,
        <urn:visionflow:linked:synchronisation> ;
    vc:slug "delta-robot" ;
    vc:sourceDomain "robotics" .

vf:democratic-values a owl:Class ;
    rdfs:label "Democratic Values"@en ;
    rdfs:comment "Principles and practices of democratic governance including pluralism, participatory decision-making, transparent governance, electoral integrity, free formation of political will and protection of civic space, which AI systems should respect and strengthen rather than undermine. bridges-to:: [[Telecollaboration]]"@en ;
    rdfs:subClassOf vf:policy-enforcement ;
    vc:authorityScore "0.0"^^xsd:float ;
    vc:maturity "draft" ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:slug "democratic-values" ;
    vc:sourceDomain "infrastructure" .

vf:deployer a owl:Class ;
    rdfs:label "Deployer"@en ;
    rdfs:comment "A natural or legal person, public authority, agency or other body using an AI system under its authority except where the AI system is used in the course of a personal non-professional activity. bridges-to:: [[Autonomous Robot]]"@en ;
    rdfs:subClassOf vf:digital-infrastructure ;
    vc:authorityScore "0.0"^^xsd:float ;
    vc:maturity "draft" ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:slug "deployer" ;
    vc:sourceDomain "infrastructure" .

vf:derivative-control a owl:Class ;
    rdfs:label "Derivative Control"@en ;
    rdfs:comment "Derivative control responds to the rate of change of system error, providing damping that opposes oscillations and improves transient response. When combined with [[Proportional Control]] and [[Integral Control]] in [[PID Control]], the derivative term enhances stability and enables faster, less overshoot-prone convergence to setpoints in robotic [[Control Systems]]."@en ;
    rdfs:subClassOf <urn:visionflow:linked:control-actions>,
        <urn:visionflow:linked:pid-control-component>,
        vf:feedback-control ;
    vc:authorityScore "0.95"^^xsd:float ;
    vc:enables <urn:visionflow:linked:faster-convergence>,
        <urn:visionflow:linked:oscillation-damping>,
        <urn:visionflow:linked:reduced-overshoot>,
        <urn:visionflow:linked:stability-improvement> ;
    vc:hasPart <urn:visionflow:linked:damping-action>,
        <urn:visionflow:linked:derivative-gain>,
        <urn:visionflow:linked:error-rate-measurement> ;
    vc:maturity "established" ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires <urn:visionflow:linked:error-signal>,
        <urn:visionflow:linked:gain-tuning>,
        <urn:visionflow:linked:low-pass-filtering>,
        <urn:visionflow:linked:time-derivative> ;
    vc:slug "derivative-control" ;
    vc:sourceDomain "robotics" .

vf:deterministic-finality a owl:Class ;
    rdfs:label "Deterministic Finality"@en ;
    rdfs:comment "Transaction finality achieved through explicit protocol mechanisms in BFT-based consensus systems, providing absolute mathematical guarantee that finalized blocks cannot be reverted. Requires supermajority validator agreement (typically 2/3+) and delivers instant certainty without probabilistic confirmation waiting."@en ;
    rdfs:subClassOf vf:blockchain ;
    vc:authorityScore "0.0"^^xsd:float ;
    vc:maturity "draft" ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires <urn:visionflow:linked:validator-set> ;
    vc:slug "deterministic-finality" ;
    vc:sourceDomain "blockchain" .

vf:devpod a owl:Class ;
    rdfs:label "devpod"@en ;
    rdfs:comment "devpod is a concept within the ngm domain."@en ;
    rdfs:subClassOf vf:infrastructure ;
    vc:authorityScore "0.0"^^xsd:float ;
    vc:maturity "draft" ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:slug "devpod" ;
    vc:sourceDomain "infrastructure" .

vf:diagrams-as-code a owl:Class ;
    rdfs:label "Diagrams as Code"@en ;
    rdfs:comment "Diagrams as Code (DaC) is a software-engineering discipline and tooling category in which technical diagrams (architecture, sequence, state, deployment, entity-relationship, Gantt, wireframe, timing, dataflow) are authored as plain-text source artefacts in a constrained, machine-readable grammar rather than drawn in a graphical [[WYSIWYG]] editor, are stored alongside application code in [[Version Control]] systems such as [[Git]] under the same review and CI workflows ([[Pull Request|pull-request]] diffs, blame history, branch protection, automated linting via [[Pre-commit Hooks]]), and are rendered to images (SVG, PNG, PDF) at build time, in the browser, or by a server (Kroki, Mermaid Live Editor, PlantUML server) so the rendered artefact is treated as a derived output rather than the source of truth; the canonical grammars include [[Mermaid]] (created by Knut Sveidqvist 2014 at Qlik Sweden, 70K+ GitHub stars January 2026, 12.5M weekly npm downloads, governed by the Mermaid Open-Source Project, native rendering in [[GitHub]] Markdown since February 2022 and [[GitLab]] Markdown 2020, also rendered natively by [[ChatGPT]] canvas and [[Anthropic Claude]] artifacts since 2024), [[Pla"@en ;
    rdfs:subClassOf <urn:visionflow:linked:declarative-specification>,
        <urn:visionflow:linked:documentation-as-code>,
        <urn:visionflow:linked:domain-specific-language>,
        <urn:visionflow:linked:text-based-authoring>,
        <urn:visionflow:linked:version-controlled-artefact> ;
    vc:authorityScore "0.87"^^xsd:float ;
    vc:enables <urn:visionflow:linked:architectural-decision-records>,
        <urn:visionflow:linked:c4-model>,
        <urn:visionflow:linked:continuous-integration>,
        <urn:visionflow:linked:living-documentation>,
        <urn:visionflow:linked:pull-request-review>,
        <urn:visionflow:linked:refactor-time-consistency>,
        <urn:visionflow:linked:runbook> ;
    vc:hasPart <urn:visionflow:linked:build-pipeline>,
        <urn:visionflow:linked:diagram-grammar>,
        <urn:visionflow:linked:icon-library>,
        <urn:visionflow:linked:layout-engine>,
        <urn:visionflow:linked:preview-plugin>,
        <urn:visionflow:linked:renderer>,
        <urn:visionflow:linked:source-file>,
        <urn:visionflow:linked:theme> ;
    vc:implements <urn:visionflow:linked:d2>,
        <urn:visionflow:linked:graphviz-dot>,
        <urn:visionflow:linked:penrose>,
        <urn:visionflow:linked:pikchr>,
        <urn:visionflow:linked:plant-uml>,
        <urn:visionflow:linked:structurizr-dsl>,
        <urn:visionflow:linked:tik-z>,
        <urn:visionflow:linked:vega-lite>,
        <urn:visionflow:linked:wavedrom>,
        vf:mermaid ;
    vc:maturity "production-ready" ;
    vc:qualityScore "0.52"^^xsd:float ;
    vc:requires <urn:visionflow:linked:layout-algorithm>,
        <urn:visionflow:linked:markdown>,
        <urn:visionflow:linked:render-toolchain>,
        <urn:visionflow:linked:text-editor>,
        <urn:visionflow:linked:version-control> ;
    vc:slug "diagrams-as-code" ;
    vc:sourceDomain "infrastructure" .

vf:differential-drive-robot a owl:Class ;
    rdfs:label "Differential Drive Robot"@en ;
    rdfs:comment "Differential drive robot uses two independently controlled wheels on opposite sides to enable both forward/backward locomotion and in-place rotation, forming the most widely deployed [[Mobile Robot]] architecture. By differentially controlling wheel velocities, the robot achieves holonomic-like manoeuvring from non-holonomic kinematics, making differential drives ubiquitous in research platforms, [[Autonomous Vehicles]], and [[Mobile Manipulation]] systems."@en ;
    rdfs:subClassOf <urn:visionflow:linked:nonholonomic-robot>,
        vf:wheeled-robot ;
    vc:authorityScore "0.95"^^xsd:float ;
    vc:enables <urn:visionflow:linked:arc-trajectory-following>,
        <urn:visionflow:linked:forward-locomotion>,
        <urn:visionflow:linked:in-place-rotation>,
        <urn:visionflow:linked:point-turning> ;
    vc:hasPart <urn:visionflow:linked:caster-wheel>,
        <urn:visionflow:linked:differential-drive-controller>,
        <urn:visionflow:linked:left-drive-motor>,
        <urn:visionflow:linked:right-drive-motor>,
        <urn:visionflow:linked:wheel> ;
    vc:maturity "established" ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires <urn:visionflow:linked:independent-wheel-motors>,
        <urn:visionflow:linked:motor-drivers>,
        <urn:visionflow:linked:odometry-sensors>,
        <urn:visionflow:linked:power-battery> ;
    vc:slug "differential-drive-robot" ;
    vc:sourceDomain "robotics" .

vf:differential-kinematics a owl:Class ;
    rdfs:label "Differential Kinematics"@en ;
    rdfs:comment "Differential kinematics maps velocities between [[Robot Joint]] space and task-space (Cartesian) coordinates using the Jacobian matrix, enabling velocity-level analysis and control of robot manipulators. The Jacobian provides the linear relationship between joint angular velocities and end-effector Cartesian velocities, forming the foundation for [[VelocityControl]], [[Singularity Analysis]], and [[Numerical Inverse Kinematics]] algorithms."@en ;
    rdfs:subClassOf <urn:visionflow:linked:motion-mathematics>,
        vf:robot-kinematics ;
    vc:authorityScore "0.95"^^xsd:float ;
    vc:enables <urn:visionflow:linked:end-effector-velocity-control>,
        <urn:visionflow:linked:force-torque-transformation>,
        <urn:visionflow:linked:singularity-detection>,
        vf:inverse-kinematics ;
    vc:hasPart <urn:visionflow:linked:jacobian-matrix>,
        <urn:visionflow:linked:singularity-condition>,
        <urn:visionflow:linked:velocity-transformation> ;
    vc:maturity "established" ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires <urn:visionflow:linked:joint-configuration>,
        <urn:visionflow:linked:position-kinematics>,
        <urn:visionflow:linked:velocity-inputs> ;
    vc:slug "differential-kinematics" ;
    vc:sourceDomain "robotics" .

