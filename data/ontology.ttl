    vc:requires ngm:bim-software,
        ngm:standards ;
    vc:slug "bim-virtual-model" ;
    vc:sourceDomain "spatial-computing" .

ngm:bitcoin-proof-of-work-protocol-halving a owl:Class ;
    rdfs:label "Bitcoin Halving"@en ;
    rdfs:comment "The Bitcoin halving is a protocol-enforced event, occurring approximately every 210,000 blocks (roughly four years), at which the block subsidy paid to miners is cut in half. It implements Bitcoin's disinflationary monetary policy, capping total supply at 21 million coins and progressively reducing new issuance until it reaches zero around the year 2140. Halvings have historically preceded major shifts in mining economics and market price, and they are central to Bitcoin's narrative as a scarce, predictably issued digital asset."@en ;
    rdfs:subClassOf ngm:mechanism-design ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:bitcoin-proof-of-work-protocol,
        ngm:mining-pool,
        ngm:proof-of-work ;
    vc:slug "bitcoin-halving" ;
    vc:sourceDomain "blockchain" .

ngm:bitcoin-proof-of-work-protocol-layer-2 a owl:Class ;
    rdfs:label "Bitcoin Layer 2"@en ;
    rdfs:comment "Bitcoin Layer 2 refers to protocols built on top of the Bitcoin base chain that increase transaction throughput, reduce fees, or add functionality while inheriting Bitcoin's security. Examples include the Lightning Network for fast payments and federated systems such as Fedimint and Cashu for custodial and ecash-style scaling. These layers settle to the base chain periodically, trading some on-chain finality for speed and cost efficiency."@en ;
    rdfs:subClassOf ngm:bc-protocol-and-consensus ;
    skos:broader ngm:bc-protocol-and-consensus ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:cashu,
        ngm:fedimint ;
    vc:slug "bitcoin-layer-2" ;
    vc:sourceDomain "blockchain" .

ngm:bletchley-declaration a owl:Class ;
    rdfs:label "Bletchley Declaration"@en ;
    rdfs:comment "The Bletchley Declaration is a multilateral political agreement signed in November 2023 by 28 nations and the European Union at the inaugural AI Safety Summit at Bletchley Park, UK, establishing the first intergovernmental consensus on the risks of frontier AI models. Signatories committed to international cooperation on safety evaluation, information sharing among national AI safety institutes, and the development of governance frameworks to address potentially catastrophic risks from highly capable foundation models. The declaration catalysed the formation of AI safety institutes in the UK, United States, and other signatory nations, and set the precedent for government-coordinated pre-deployment evaluations of frontier AI systems. It was followed by the Seoul AI Safety Summit in 2024, which extended commitments toward operational safety testing requirements for frontier model developers."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:frontier-ai ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:foundation-model ],
        ngm:ai-governance-and-ethics ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:bridgesTo ngm:capability-evaluation,
        ngm:interpretability,
        ngm:model-evaluation ;
    vc:contrastsWith ngm:eu-ai-act-regulatory-instrument ;
    vc:enables ngm:ai-safety-institute,
        ngm:pre-deployment-evaluation,
        ngm:red-teaming,
        ngm:risk-assessment ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:ai-regulation,
        ngm:ai-risk-management,
        ngm:biosecurity,
        ngm:cybersecurity,
        ngm:existential-risk ;
    vc:requires ngm:foundation-model,
        ngm:frontier-ai ;
    vc:slug "bletchley-declaration" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:ai-governance,
        ngm:ai-safety-research,
        ngm:international-cooperation,
        ngm:responsible-ai .

ngm:bleu-score a owl:Class ;
    rdfs:label "BLEU Score"@en ;
    rdfs:comment "BLEU Score (Bilingual Evaluation Understudy) is an automatic evaluation metric for machine translation and text generation quality that measures the overlap of n-gram sequences between a candidate output and one or more human reference translations, applying a brevity penalty to discourage pathologically short outputs. Scores range from 0 to 1 (or 0 to 100 in percentage form), with higher values indicating closer correspondence to the reference. BLEU correlates moderately with human judgement at the corpus level but is known to be unreliable for single-sentence evaluation and insufficient alone for capturing semantic adequacy."@en ;
    rdfs:subClassOf ngm:evaluation-metric ;
    vc:contrastsWith ngm:bert-score,
        ngm:comet-metric,
        ngm:evaluation-harness,
        ngm:human-evaluation,
        ngm:meteor-metric ;
    vc:enables ngm:automated-evaluation,
        ngm:model-comparison,
        ngm:regression-testing ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:benchmarks,
        ngm:bert-score,
        ngm:comet-metric,
        ngm:language-model,
        ngm:meteor-metric,
        ngm:rouge-metric,
        ngm:sacrebleu,
        ngm:text-generation,
        ngm:wmt-benchmark ;
    vc:requires ngm:reference-translation,
        ngm:tokenisation ;
    vc:slug "bleu-score" ;
    vc:sourceDomain "ai" ;
    vc:supports ngm:benchmark-evaluation,
        ngm:machine-translation,
        ngm:text-summarisation ;
    vc:uses ngm:geometric-mean,
        ngm:machine-translation,
        ngm:n-gram-overlap,
        ngm:natural-language-processing .

ngm:block-proposal a owl:Class ;
    rdfs:label "Block Proposal"@en ;
    rdfs:comment "Block proposal is the step in a blockchain consensus protocol where a designated participant assembles a candidate block of ordered transactions and broadcasts it to the network for validation and agreement. The proposer selects transactions from the mempool, constructs the block header referencing the prior block, and signs the proposal so peers can verify its authorship. In proof-of-stake systems the proposer is chosen by a leader-election procedure for each slot, after which validators attest to the proposed block."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:block ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:mempool ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:validator ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:leader-election ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:cryptographic-signature ],
        ngm:consensus-mechanism ;
    vc:contrastsWith ngm:attestation ;
    vc:dependsOn ngm:fork-choice-rule,
        ngm:proof-of-stake ;
    vc:enables ngm:attestation,
        ngm:finality-gadget ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:block,
        ngm:cryptographic-signature ;
    vc:isPartOf ngm:consensus-mechanism ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:blockchain,
        ngm:slashing ;
    vc:requires ngm:leader-election,
        ngm:mempool,
        ngm:validator ;
    vc:slug "block-proposal" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:digital-signature .

ngm:block-structure a owl:Class ;
    rdfs:label "Block Structure"@en ;
    rdfs:comment "Block structure is the internal data layout of a block in a blockchain or distributed ledger, specifying the fields, encoding formats, and cryptographic commitments that constitute a valid unit of the chain. A block consists of a header containing metadata — including the parent block hash, timestamp, nonce, and Merkle root of the transaction set — and a body containing the ordered list of transactions or state transitions. The specific fields, size limits, and serialisation rules of the block structure are defined by the network's consensus protocol and directly govern the chain's security properties, throughput, and upgrade path."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:block-header ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:nonce ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:merkle-root ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:transaction ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:merkle-tree ],
        ngm:block ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:block-header,
        ngm:merkle-root,
        ngm:merkle-tree,
        ngm:nonce,
        ngm:transaction ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:block-size,
        ngm:block-time,
        ngm:blockchain ;
    vc:slug "block-structure" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:cryptographic-hash .

ngm:blockchain-anchoring a owl:Class ;
    rdfs:label "Blockchain Anchoring"@en ;
    rdfs:comment "Blockchain Anchoring is a technique for binding external data or documents to a blockchain by embedding a cryptographic hash of that data in a blockchain transaction, thereby creating a tamper-evident, timestamped proof of existence and integrity that can be independently verified by any party with access to the document and the chain. The blockchain's immutability and distributed consensus guarantee that the anchoring transaction cannot be altered retroactively, providing a trust anchor without requiring the document itself to be stored on-chain. Applications span document notarisation, supply chain provenance, audit logs, and verifiable credential revocation."@en ;
    rdfs:subClassOf ngm:blockchain-infrastructure ;
    vc:enables ngm:audit-trail,
        ngm:data-integrity,
        ngm:immutable-record ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:cryptographic-proof,
        ngm:timestamp ;
    vc:slug "blockchain-anchoring" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:blockchain-transaction,
        ngm:cryptographic-hash-function,
        ngm:merkle-tree .

ngm:blockchain-data a owl:Class ;
    rdfs:label "Blockchain Data"@en ;
    rdfs:comment "Blockchain Data refers to the structured information stored on a distributed ledger, comprising transaction records, state data, smart contract bytecode, event logs, and cryptographic proofs organised into immutable, hash-linked blocks. It is characterised by append-only semantics, cryptographic integrity, and public verifiability. The data model differs fundamentally from traditional databases in that history cannot be altered without recomputing the entire subsequent chain."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:transaction ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:distributed-ledger ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptographic-hash ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:merkle-tree ],
        ngm:blockchain ;
    skos:broader ngm:blockchain ;
    vc:bridgesTo ngm:data-analytics ;
    vc:contrastsWith ngm:centralised-database ;
    vc:dependsOn ngm:peer-to-peer-network ;
    vc:enables ngm:audit-trail,
        ngm:tokenisation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:merkle-tree,
        ngm:transaction ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:consensus-mechanism,
        ngm:data,
        ngm:immutability ;
    vc:requires ngm:cryptographic-hash,
        ngm:distributed-ledger ;
    vc:slug "blockchain-data" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:data-provenance,
        ngm:decentralised-application,
        ngm:smart-contract .

ngm:blockstream a owl:Class ;
    rdfs:label "Blockstream"@en ;
    rdfs:comment "Blockstream is a Bitcoin-focused technology company founded in 2014 that develops open-source infrastructure and commercial products for the Bitcoin ecosystem, including the Liquid Network federated sidechain, c-lightning (now Core Lightning), and satellite-based blockchain distribution via Blockstream Satellite. The company is led by co-founders including Adam Back (inventor of Hashcash) and is a major contributor to Bitcoin Core protocol development. Blockstream's work spans cryptographic research, Layer 2 payment channels, hardware security modules, and institutional-grade Bitcoin financial products such as Blockstream AMP (Asset Management Platform)."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:core-lightning ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:bitcoin ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:liquid-network ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:proof-of-work ],
        ngm:blockchain-infrastructure ;
    vc:bridgesTo ngm:decentralised-finance,
        ngm:digital-asset-custody ;
    vc:contrastsWith ngm:ethereum,
        ngm:ethereum-smart-contract-platform-virtual-machine ;
    vc:dependsOn ngm:bitcoin-proof-of-work-protocol-core,
        ngm:cryptographic-hash-function ;
    vc:enables ngm:confidential-transactions,
        ngm:lightning-network,
        ngm:sidechain ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:core-lightning,
        ngm:liquid-network ;
    vc:implements ngm:elements-project,
        ngm:schnorr-signature,
        ngm:taproot ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:layer-2-scaling,
        ngm:multisig,
        ngm:payment-channel-network ;
    vc:requires ngm:bitcoin,
        ngm:proof-of-work ;
    vc:slug "blockstream" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:bitcoin-proof-of-work-protocol-core,
        ngm:open-source-development ;
    vc:uses ngm:hardware-security-module,
        ngm:hashcash,
        ngm:satellite-communication .

ngm:bloom-filter a owl:Class ;
    rdfs:label "Bloom Filter"@en ;
    rdfs:comment "A Bloom Filter is a space-efficient probabilistic data structure that tests whether an element is a member of a set, accepting a controllable false-positive rate while guaranteeing zero false negatives. Invented by Burton Howard Bloom in 1970, the structure uses multiple hash functions to map elements to bit positions within a fixed-size bit array. Membership queries are answered in constant time regardless of set size, making Bloom Filters indispensable in high-throughput systems where exact lookup is prohibitively expensive. They are widely deployed in databases, networking, distributed caches, and blockchain nodes."@en ;
    rdfs:subClassOf ngm:data-structure ;
    vc:contrastsWith ngm:spatial-data-structure ;
    vc:enables ngm:latency,
        ngm:membership-inference,
        ngm:privacy-filter ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:distributed-data-structure,
        ngm:hash-function,
        ngm:probabilistic-model ;
    vc:slug "bloom-filter" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:cryptographic-hash-function,
        ngm:hash-collision .

ngm:bluetooth-le a owl:Class ;
    rdfs:label "Bluetooth LE"@en ;
    rdfs:comment "Bluetooth LE (Low Energy), also known as Bluetooth Smart, is a short-range wireless communication protocol introduced in Bluetooth 4.0 (2010) and standardised by the Bluetooth SIG, designed to transmit small amounts of data at low duty cycles while consuming a fraction of the power of Classic Bluetooth. It operates in the 2.4 GHz ISM band with 40 channels, using frequency-hopping spread spectrum, and is optimised for battery-constrained devices that need to remain active for months or years on a coin cell."@en ;
    rdfs:subClassOf ngm:bluetooth-low-energy ;
    vc:enables ngm:internet-of-things,
        ngm:proximity-detection ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:embedded-systems,
        ngm:near-field-communication,
        ngm:zigbee ;
    vc:slug "bluetooth-le" ;
    vc:sourceDomain "infrastructure" ;
    vc:standardizedBy ngm:bluetooth-sig ;
    vc:uses ngm:low-energy-consumption .

ngm:camera-tracking a owl:Class ;
    rdfs:label "Camera Tracking"@en ;
    rdfs:comment "Camera Tracking is the process of continuously estimating the position and orientation (pose) of a camera in 3D space relative to a fixed reference frame or scene, typically using image feature analysis, optical flow, or fiducial marker detection. It underpins augmented reality, visual effects compositing, robotic navigation, and autonomous vehicle perception by enabling virtual or computed elements to be correctly registered to the physical world as the camera moves."@en ;
    rdfs:subClassOf ngm:motion-tracking ;
    vc:enables ngm:augmented-reality,
        ngm:slam,
        ngm:visual-odometry ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:epipolar-geometry,
        ngm:pose-estimation ;
    vc:slug "camera-tracking" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:feature-detection,
        ngm:marker-based-tracking,
        ngm:optical-flow .

ngm:canary-deployment a owl:Class ;
    rdfs:label "Canary Deployment"@en ;
    rdfs:comment "Canary deployment is a progressive release strategy in which a new version of a service or model is exposed to a small subset of traffic before being rolled out more widely. Operators monitor health, performance and quality metrics on the canary cohort, promoting the release only if it behaves acceptably and otherwise rolling back. It limits the blast radius of a faulty change and is widely used in continuous delivery pipelines and in serving machine-learning models."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:continuous-integration ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:observability ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:a-b-testing ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:observability ],
        ngm:continuous-deployment ;
    vc:contrastsWith ngm:a-b-testing ;
    vc:dependsOn ngm:ci-cd ;
    vc:enables ngm:continuous-deployment ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:a-b-testing,
        ngm:observability ;
    vc:implements ngm:continuous-deployment ;
    vc:isPartOf ngm:ci-cd,
        ngm:continuous-deployment ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:a-b-testing,
        ngm:devops,
        ngm:kubernetes ;
    vc:requires ngm:continuous-integration,
        ngm:observability ;
    vc:slug "canary-deployment" ;
    vc:sourceDomain "machine-learning" ;
    vc:supports ngm:devops,
        ngm:site-reliability-engineering ;
    vc:uses ngm:kubernetes,
        ngm:observability .

ngm:carbon-offset-trading a owl:Class ;
    rdfs:label "Carbon Offset Trading"@en ;
    rdfs:comment "The buying and selling of verified carbon credits on voluntary and compliance markets through exchanges and over-the-counter transactions, enabling price discovery, liquidity provision, and efficient allocation of climate finance to emission reduction projects."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:carbon-registry ],
        ngm:environmental-trading,
        ngm:sc-governance-and-safety ;
    skos:broader ngm:sc-governance-and-safety ;
    vc:enables ngm:carbon-price-discovery,
        ngm:climate-finance ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:carbon-registry,
        ngm:market-infrastructure ;
    vc:slug "carbon-offset-trading" ;
    vc:sourceDomain "spatial-computing" .

ngm:cellular-network a owl:Class ;
    rdfs:label "Cellular Network"@en ;
    rdfs:comment "A cellular network is a wireless communication system in which a geographic area is divided into cells, each served by a base station, enabling mobile devices to connect and maintain service while moving. Frequency reuse across cells and handover between base stations allow large numbers of users to share limited radio spectrum. Successive generations such as 4G LTE and 5G have progressively increased capacity, throughput and latency performance."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:network-protocol ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:wireless-communication ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:radio-access-network ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:radio-transceiver ],
        ngm:telecommunications-infrastructure ;
    vc:contrastsWith ngm:mesh-networking,
        ngm:wireless-connectivity ;
    vc:enables ngm:internet-of-things ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:network-protocol,
        ngm:radio-transceiver ;
    vc:isPartOf ngm:telecommunications,
        ngm:telecommunications-infrastructure ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:networking-infrastructure ;
    vc:requires ngm:radio-access-network,
        ngm:wireless-communication ;
    vc:slug "cellular-network" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:low-latency-networking,
        ngm:mobile-device ;
    vc:uses ngm:network-transport,
        ngm:wireless-radio .

ngm:chainlink-ccip a owl:Class ;
    rdfs:label "Chainlink CCIP"@en ;
    rdfs:comment "Chainlink Cross-Chain Interoperability Protocol (CCIP) is a cross-chain messaging and token transfer standard developed by Chainlink Labs that enables smart contracts on different blockchain networks to securely send messages and transfer assets across chain boundaries, backed by a decentralised oracle network providing an independent risk management layer that monitors and validates cross-chain transactions. CCIP introduces a programmable token transfer abstraction allowing arbitrary data payloads to accompany token movements, enabling complex cross-chain application logic."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:evm-compatible-blockchain ],
        ngm:cross-chain-interoperability ;
