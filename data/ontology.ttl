ngm:carbon-neutrality-planning a owl:Class ;
    rdfs:label "Carbon Neutrality Planning"@en ;
    rdfs:comment "The strategic process of developing a comprehensive roadmap to achieve net-zero greenhouse gas emissions, encompassing emission measurement, science-based reduction targets, interim milestones, decarbonization actions, and residual emission neutralization through permanent carbon removal."@en ;
    rdfs:subClassOf ngm:strategic-planning ;
    vc:enables ngm:climate-action,
        ngm:decarbonization,
        ngm:net-zero-achievement ;
    vc:maturity "draft" ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires ngm:ghg-baseline,
        ngm:implementation-strategy,
        ngm:reduction-targets ;
    vc:slug "carbon-neutrality-planning" ;
    vc:sourceDomain "spatial-computing" .

ngm:carbon-neutrality-verification a owl:Class ;
    rdfs:label "Carbon Neutrality Verification"@en ;
    rdfs:comment "The independent third-party audit process that validates an organization's carbon neutrality claims by verifying emission calculations, reduction measures, and offset quality against established standards such as ISO 14068-1 and PAS 2060."@en ;
    rdfs:subClassOf ngm:environmental-verification ;
    vc:enables ngm:credibility-assurance,
        ngm:greenwashing-prevention,
        ngm:stakeholder-trust ;
    vc:maturity "draft" ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:documentation-package,
        ngm:third-party-auditor,
        ngm:verification-standard ;
    vc:slug "carbon-neutrality-verification" ;
    vc:sourceDomain "spatial-computing" .

