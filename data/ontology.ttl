vf:digital-society-surveillance a owl:Class ;
    rdfs:label "Digital Society Surveillance"@en ;
    rdfs:comment "Digital Society Surveillance is the systematic observation, collection, processing, and analysis of personal data, communications, movements, and behavioural signals generated by individuals participating in digital infrastructure — encompassing state mass-surveillance programmes, commercial surveillance capitalism, biometric tracking, automated licence-plate recognition (ALPR) networks, smart-city sensor grids, workplace monitoring (bossware), school surveillance technology, and algorithmic social-scoring systems — constituting an interconnected ontological domain at the intersection of political power, capital accumulation, privacy rights, and civil-liberties jurisprudence that has fundamentally restructured the relationship between citizens, corporations, and governments in the twenty-first century."@en ;
    rdfs:subClassOf <urn:visionflow:linked:civil-liberties>,
        <urn:visionflow:linked:data-ethics>,
        <urn:visionflow:linked:political-economy>,
        vf:digital-rights,
        vf:human-rights,
        vf:privacy ;
    vc:authorityScore "0.87"^^xsd:float ;
    vc:enables <urn:visionflow:linked:algorithmic-governance>,
