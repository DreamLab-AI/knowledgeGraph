ngm:feedforward-neural-network a owl:Class ;
    rdfs:label "Feedforward Neural Network"@en ;
    rdfs:comment "A neural network architecture in which connections between nodes do not form cycles, with information flowing unidirectionally from input through hidden layers to output. The simplest and most foundational artificial neural network type, trained via backpropagation with gradient descent, and proven by the universal approximation theorem to model arbitrary continuous functions given sufficient width."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:backpropagation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:activation-function ],
        ngm:ai-model-architecture,
        ngm:network-architecture ;
    skos:broader ngm:ai-model-architecture ;
    vc:contrastsWith ngm:recurrent-neural-network,
        ngm:transformer-architecture ;
    vc:enables ngm:deep-learning,
        ngm:machine-learning ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:convolutional-neural-network ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:requires ngm:activation-function,
        ngm:backpropagation ;
    vc:slug "feedforward-neural-network" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:financialised-agentic-memetics a owl:Class ;
    rdfs:label "Financialised Agentic Memetics"@en ;
    rdfs:comment "The phenomenon in which AI agents and autonomous social actors propagate memetic content—ideas, tokens, political positions—tied to speculative financial instruments (memecoins, programmatically-aligned tokens) that derive value from attention and community adoption rather than underlying utility. This creates feedback loops between AI terminal outputs, social media virality, and tokenised capital allocation with tangible real-world effects."@en ;
    rdfs:subClassOf ngm:ai-application ;
    skos:broader ngm:ai-application ;
    vc:dependsOn ngm:blockchain ;
