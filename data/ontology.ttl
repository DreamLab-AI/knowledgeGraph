ngm:internal-ai-harness a owl:Class ;
    rdfs:label "Internal AI Harness"@en ;
    rdfs:comment "An internal AI harness is an in-process execution framework that embeds AI model inference directly within an application's runtime, enabling tight coupling between the host system and AI capabilities for low-latency, high-throughput inference with direct memory access and minimal serialisation overhead, while simultaneously managing the tool-call loop, context selection, task state, approval gates, and observability traces that govern agent behaviour within a single address space."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:inference-runtime ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:agent-runtime ],
