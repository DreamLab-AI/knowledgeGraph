        ngm:sim-to-real-transfer ;
    vc:contrastsWith ngm:unity-platform,
        ngm:unreal-engine ;
    vc:enables ngm:collaborative-design,
        ngm:digital-twin,
        ngm:embodied-ai-simulation,
        ngm:photorealistic-rendering,
        ngm:robot-learning,
        ngm:synthetic-data-generation ;
    vc:hasMaturity ngmi:maturity-established ;
