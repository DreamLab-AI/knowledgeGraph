    vc:slug "inclusive-xr-design" ;
    vc:sourceDomain "spatial-computing" .

ngm:indoor-navigation a owl:Class ;
    rdfs:label "Indoor Navigation"@en ;
    rdfs:comment "Indoor Navigation encompasses the technologies and systems that provide wayfinding, positioning, and routing guidance within enclosed spaces where satellite-based positioning (GPS) is unavailable or unreliable. It relies on alternative positioning signals such as Wi-Fi fingerprinting, Bluetooth beacons, Ultra-Wideband (UWB) ranging, visual markers, inertial sensors, and lidar-based spatial maps. Indoor navigation is critical for large venues such as airports, hospitals, shopping centres, factories, and warehouses where occupant or asset routing improves operational efficiency and user experience."@en ;
    rdfs:subClassOf ngm:spatial-computing ;
    skos:broader ngm:spatial-computing ;
    vc:bridgesTo ngm:digital-twin ;
    vc:contrastsWith ngm:gps ;
    vc:dependsOn ngm:map-data,
        ngm:sensor-fusion ;
    vc:enables ngm:asset-tracking,
        ngm:augmented-reality,
        ngm:wayfinding ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:gps,
        ngm:location-services,
        ngm:simultaneous-localisation-and-mapping ;
    vc:slug "indoor-navigation" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:robotics,
        ngm:smart-building ;
    vc:uses ngm:bluetooth-low-energy,
        ngm:lidar,
        ngm:spatial-mapping,
        ngm:ultra-wideband,
        ngm:wifi .

