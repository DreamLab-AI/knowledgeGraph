ngm:privacy-preserving-data-sharing a owl:Class ;
    rdfs:label "Privacy Preserving Data Sharing"@en ;
    rdfs:comment "Technologies and protocols enabling secure exchange of data between parties while protecting sensitive information through techniques such as differential privacy, secure multi-party computation, federated learning, and synthetic data generation."@en ;
