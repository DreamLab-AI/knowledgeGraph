ngm:hl7-fhir a owl:Class ;
    rdfs:comment "HL7 FHIR (Fast Healthcare Interoperability Resources) is a standard developed by Health Level Seven International for the electronic exchange of healthcare information. It models clinical and administrative data as modular Resources accessed through a RESTful API using JSON or XML representations, combining a defined data model with web-native interaction. It has become the dominant modern standard for healthcare interoperability, enabling exchange between electronic health records, apps and analytics systems."@en ;
    rdfs:label "HL7 FHIR"@en ;
    rdfs:subClassOf ngm:interoperability ;
