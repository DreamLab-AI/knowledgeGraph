ngm:industrial-io-t a owl:Class ;
    rdfs:label "Industrial IoT"@en ;
    rdfs:comment "Industrial IoT (IIoT) is the extension of Internet of Things technologies into industrial operational environments, connecting sensors, actuators, controllers, and edge gateways to cloud analytics and control systems in order to enable real-time operational visibility, process optimisation, predictive maintenance, and remote asset management. IIoT integrates historically isolated operational technology (OT) networks—such as SCADA systems and programmable logic controllers (PLCs)—with IT infrastructure, requiring careful management of the resulting cyber-physical attack surface. Key communication standards include OPC UA, MQTT, and AMQP."@en ;
    rdfs:subClassOf ngm:infra-network-and-comms ;
    skos:broader ngm:infra-network-and-comms ;
    vc:enables ngm:digital-twin,
        ngm:predictive-maintenance ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:cyber-physical-systems,
        ngm:industrial-automation ;
    vc:slug "industrial-io-t" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:edge-computing,
        ngm:sensor .

ngm:instruction-tuning a owl:Class ;
    rdfs:label "Instruction Tuning"@en ;
    rdfs:comment "A fine-tuning technique that trains language models to follow natural language instructions by training on diverse instruction-response pairs. Instruction tuning enables models to generalise to new tasks described through instructions without task-specific training data."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:fine-tuning ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:supervised-learning ],
        ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:enables ngm:generative-ai ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:relatedTo ngm:prompt-engineering,
        ngm:rlhf,
        ngm:transfer-learning ;
    vc:requires ngm:fine-tuning,
        ngm:supervised-learning ;
    vc:slug "instruction-tuning" ;
    vc:sourceDomain "spatial-computing" .

ngm:metadata-schema a owl:Class ;
    rdfs:label "Metadata Schema"@en ;
    rdfs:comment "A structured specification defining metadata elements, their semantics, syntax, and relationships for describing and managing information resources."@en ;
    rdfs:subClassOf ngm:data-standards,
