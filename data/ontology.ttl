        ngm:bias-variance-tradeoff,
        ngm:gradient-descent ;
    vc:enables ngm:anomaly-detection,
        ngm:demand-forecasting,
        ngm:logistics-optimisation,
        ngm:recommendation-system ;
    vc:hasMaturity ngmi:maturity-established ;
