    vc:sourceDomain "spatial-computing" .

ngm:etsi-domain-infrastructure-data a owl:Class ;
    rdfs:label "ETSI_Domain_Infrastructure_Data"@en ;
    rdfs:comment "The ETSI Infrastructure Data domain is the foundational technical and architectural framework enabling trustworthy, sovereign data exchange within metaverse and digital ecosystems through decentralised data spaces, spatial intelligence integration, and policy-driven governance standards. It operationalises Trustworthy Data Spaces via NGSI-LD APIs, Federated Catalogs, Policy Enforcement Points, and F5G backbone connectivity to address data sovereignty, security, and real-to-virtual integration across distributed networks."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-governance ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:verifiable-credentials ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:storage-layer ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:data-management ],
        ngm:infra-data-management ;
    skos:broader ngm:infra-data-management ;
    vc:enables ngm:distributed-ledger-technology-dlt,
        ngm:edge-computing ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:data-management,
        ngm:storage-layer ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:etsi-domain-data-management,
        ngm:etsi-domain-infrastructure ;
    vc:requires ngm:data-governance,
        ngm:verifiable-credentials ;
    vc:slug "etsi-domain-infrastructure-data" ;
    vc:sourceDomain "infrastructure" .

ngm:etsi-domain-interoperability a owl:Class ;
    rdfs:label "ETSI_Domain_Interoperability"@en ;
    rdfs:comment "ETSI domain consolidating standards enabling different systems and organisations to work together effectively through technical and semantic data exchange mechanisms, shared vocabularies such as NGSI-LD and SAREF, and standardised protocols. It covers avatar interoperability, digital twin synchronisation, state synchronisation, and portability of digital assets across metaverse platforms."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:portability ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:avatar-interoperability ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:digital-twin-interop-protocol ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:state-synchronization ],
        ngm:infra-network-and-comms ;
    skos:broader ngm:infra-network-and-comms ;
    vc:enables ngm:discovery-layer,
        ngm:interoperability ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:avatar-interoperability,
        ngm:digital-twin-interop-protocol,
        ngm:portability,
        ngm:state-synchronization ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:slug "etsi-domain-interoperability" ;
    vc:sourceDomain "infrastructure" ;
    vc:standardizedBy ngm:api-standard,
        ngm:interoperability-framework .

ngm:etsi-gr-mec-032 a owl:Class ;
    rdfs:label "ETSI GR MEC 032"@en ;
    rdfs:comment "ETSI GR MEC 032 is a Group Report published by the ETSI Industry Specification Group for Multi-access Edge Computing (ISG MEC) that addresses network slicing support and integration with MEC systems, defining how MEC platform capabilities can be exposed and leveraged across sliced 5G network infrastructure. The report analyses the relationship between Multi-access Edge Computing and Network Slicing, identifying reference architectures, use cases, and the interplay between MEC management entities and network slice management functions. It provides normative guidance for operators and vendors integrating edge computing workloads with 5G core network slicing mechanisms, covering aspects such as slice selection for MEC application placement, resource isolation guarantees, and inter-slice MEC service continuity."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:etsi-mec ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:network-function-virtualization ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:network-slicing ],
        ngm:multi-access-edge-computing ;
    vc:bridgesTo ngm:edge-ai,
        ngm:federated-learning ;
    vc:contrastsWith ngm:cloud-computing,
        ngm:etsi-gs-mec-003 ;
    vc:dependsOn ngm:etsi ;
    vc:enables ngm:edge-computing ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:mec-network-slicing-reference-architecture ;
    vc:implements ngm:reference-architecture,
        ngm:technical-standard ;
    vc:isPartOf ngm:etsi,
        ngm:etsi-mec ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:mobile-edge-computing,
        ngm:network-slicing ;
    vc:requires ngm:etsi-mec,
        ngm:network-function-virtualization,
        ngm:network-slicing ;
    vc:slug "etsi-gr-mec-032" ;
    vc:sourceDomain "infrastructure" ;
    vc:standardizedBy ngm:etsi-mec ;
    vc:supports ngm:augmented-reality,
        ngm:industrial-io-t,
        ngm:v2x-communication .

ngm:etsi-gs-mec-003 a owl:Class ;
    rdfs:label "ETSI GS MEC 003"@en ;
    rdfs:comment "An ETSI Group Specification within the Multi-access Edge Computing (MEC) series defining the framework and reference architecture for MEC. It describes functional elements and reference points of an edge computing platform."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
