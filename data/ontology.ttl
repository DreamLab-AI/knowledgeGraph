ngm:a-star-algorithm a owl:Class ;
    rdfs:label "A-Star Algorithm"@en ;
    rdfs:comment "A best-first informed search algorithm developed by Peter Hart, Nils Nilsson, and Bertram Raphael that finds the optimal path between nodes in a weighted graph by combining actual accumulated cost from the start node (g-score representing precise path cost traversed thus far) with admissible heur..."@en ;
    rdfs:subClassOf ngm:search-algorithms ;
    vc:enables ngm:goal-directed-search,
        ngm:motion-planning,
        ngm:navigation,
        ngm:optimal-path-discovery,
        ngm:pathfinding,
        ngm:route-planning ;
    vc:hasPart ngm:closed-set,
        ngm:cost-function,
        ngm:evaluation-function,
        ngm:heuristic-function,
        ngm:open-set,
        ngm:path-reconstruction,
        ngm:priority-queue ;
    vc:implements ngm:best-first-search,
        ngm:heuristic-evaluation,
        ngm:informed-search-strategy,
        ngm:optimal-pathfinding ;
    vc:maturity "established" ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires ngm:admissible-heuristic,
        ngm:distance-metric,
        ngm:graph-representation,
        ngm:node-expansion,
        ngm:priority-queue-data-structure ;
    vc:slug "a-star-algorithm" ;
    vc:sourceDomain "artificial-intelligence" .

