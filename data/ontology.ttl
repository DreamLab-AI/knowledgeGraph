        ngm:deep-learning,
        ngm:foundation-model,
        ngm:image-recognition ;
    vc:requires ngm:attention-mechanism,
        ngm:large-scale-pretraining,
        ngm:positional-encoding,
        ngm:transformer ;
    vc:slug "vision-transformers" ;
    vc:sourceDomain "machine-learning" ;
    vc:uses ngm:layer-normalisation,
        ngm:self-supervised-learning,
        ngm:transfer-learning .

