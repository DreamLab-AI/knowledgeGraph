ngm:lightning-and-similar-l2 a owl:Class ;
    rdfs:label "Lightning and Similar L2"@en ;
    rdfs:comment "Off-chain payment channel networks and related Layer-2 scaling protocols built atop base-layer blockchains, enabling high-throughput, low-latency micropayments without recording every transaction on-chain. The Lightning Network, state channels, and analogous protocols (Ark, Liquid, Fedimint, Cashu) route value through cryptographically secured payment channels, dramatically improving transaction throughput and cost-efficiency for Bitcoin and similar networks."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:consensus-mechanism ],
        [ a owl:Restriction ;
