        ngm:machine-learning ;
    vc:contrastsWith ngm:annotated-training-data,
        ngm:synthetic-data ;
    vc:dependsOn ngm:embedded-systems,
        ngm:real-time-operating-system ;
    vc:enables ngm:object-detection,
        ngm:sensor-fusion,
        ngm:slam,
        ngm:spatial-mapping,
        ngm:state-estimation ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:camera,
        ngm:depth-map,
        ngm:imu,
        ngm:lidar,
        ngm:point-cloud ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:data-compression,
        ngm:multimodal-perception,
        ngm:signal-processing ;
    vc:requires ngm:data-acquisition,
