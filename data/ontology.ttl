ngm:io-t a owl:Class ;
    rdfs:label "IoT"@en ;
    rdfs:comment "The Internet of Things (IoT) is a networked ecosystem of physical devices — sensors, actuators, microcontrollers, and embedded processors — connected via IP-based communication protocols to collect, exchange, and act upon data with minimal direct human intervention. IoT extends digital connectivity into the physical world by binding heterogeneous hardware through standardised messaging protocols such as MQTT and CoAP, gateway middleware for local aggregation, and cloud or on-premises analytics platforms. It spans consumer, industrial, agricultural, and healthcare domains, each imposing distinct constraints on power, latency, security, and regulatory compliance. The discipline integrates edge computing, machine learning inference, and digital twin modelling to close feedback loops between the physical and digital realms."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:actuator ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:sensor ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:network-protocol ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:embedded-systems ],
        ngm:distributed-systems ;
    vc:bridgesTo ngm:blockchain,
        ngm:digital-twin,
        ngm:machine-learning,
        ngm:spatial-computing ;
    vc:contrastsWith ngm:cloud-computing ;
    vc:dependsOn ngm:cloud-computing,
        ngm:wireless-communication ;
    vc:enables ngm:digital-twin,
        ngm:industrial-automation,
        ngm:precision-agriculture,
        ngm:smart-city,
        ngm:supply-chain-management ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:actuator,
        ngm:embedded-systems,
        ngm:iot-gateway,
        ngm:sensor ;
    vc:qualityScore "0.76"^^xsd:float ;
    vc:relatedTo ngm:predictive-maintenance,
        ngm:sensor-fusion,
        ngm:time-series-data ;
    vc:requires ngm:device-identity,
        ngm:network-protocol ;
    vc:slug "io-t" ;
    vc:sourceDomain "infrastructure" ;
    vc:standardizedBy ngm:ieee-802-15-4,
        ngm:matter-protocol,
        ngm:oneM2M ;
    vc:uses ngm:co-ap,
        ngm:edge-computing,
        ngm:lpwan,
        ngm:mqtt .

ngm:io-t-sensors a owl:Class ;
    rdfs:label "Io T Sensors"@en ;
    rdfs:comment "IoT Sensors are networked sensing devices that collect physical and environmental data (temperature, pressure, motion, humidity, vibration, etc.) and transmit it via internet protocols to edge or cloud systems for processing and analysis."@en ;
    rdfs:subClassOf ngm:robo-perception ;
    skos:broader ngm:robo-perception ;
    vc:bridgesTo ngm:internet-of-things ;
    vc:enables ngm:predictive-maintenance,
        ngm:smart-manufacturing ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:slug "io-t-sensors" ;
    vc:sourceDomain "robotics" .

ngm:legged-locomotion a owl:Class ;
    rdfs:label "Legged Locomotion"@en ;
    rdfs:comment "Legged locomotion is the study and engineering of motion through articulated limb contacts with the environment, enabling traversal of unstructured, discontinuous, and vertically challenging terrain inaccessible to wheeled or tracked platforms. It requires coordinated management of contact scheduling, ground reaction forces, centre-of-mass dynamics, gait sequencing, and reactive balance control across walking, running, climbing, jumping, and stair-negotiation tasks. Modern legged locomotion controllers integrate whole-body control (WBC), model predictive control (MPC), and reinforcement learning — frequently trained in simulation with domain randomisation and transferred to hardware — to achieve robust performance on irregular natural and urban terrain. The field draws on classical rigid-body mechanics, optimisation theory, machine learning, and biomechanics to produce systems that rival biological locomotion efficiency and versatility."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:rigid-body-dynamics ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:robot-dynamics ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:contact-mechanics ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:state-estimation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:motion-control ],
        ngm:robo-navigation-and-planning ;
    skos:broader ngm:robo-navigation-and-planning ;
    vc:bridgesTo ngm:digital-twin,
        ngm:robot-simulation ;
    vc:contrastsWith ngm:aerial-robotics ;
    vc:enables ngm:autonomous-navigation,
        ngm:motion-planning,
        ngm:search-and-rescue-robotics ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:balance-control ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:biomechanics,
        ngm:quadruped-robot,
        ngm:reinforcement-learning,
        ngm:sim-to-real-transfer ;
    vc:requires ngm:contact-mechanics,
        ngm:motion-control,
        ngm:rigid-body-dynamics,
        ngm:robot-dynamics,
        ngm:state-estimation ;
    vc:slug "legged-locomotion" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:inertial-measurement-unit,
        ngm:lidar,
        ngm:model-predictive-control,
        ngm:quadratic-programming,
        ngm:whole-body-control .

ngm:macroeconomics a owl:Class ;
    rdfs:label "Macroeconomics"@en ;
    rdfs:comment "Macroeconomics is the branch of economics that studies the behaviour and performance of an economy as a whole, examining aggregate phenomena such as gross domestic product, price levels, unemployment, business cycles, and long-run growth. It analyses how monetary and fiscal policy shape inflation, output, and employment, and how international trade and capital flows interconnect national economies. The discipline develops formal models — from Keynesian demand frameworks to DSGE models — that link household, firm, and government behaviour to economy-wide outcomes. It contrasts with microeconomics by focusing on aggregate rather than individual-agent variables."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:international-trade ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:monetary-policy ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:fiscal-policy ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:econometrics ],
        ngm:economics ;
    vc:bridgesTo ngm:data-analytics,
        ngm:financial-market ;
    vc:contrastsWith ngm:microeconomics ;
    vc:enables ngm:central-banking,
        ngm:inflation-hedge ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:fiscal-policy,
        ngm:international-trade,
        ngm:monetary-policy,
        ngm:national-income-accounting ;
    vc:isPartOf ngm:economics ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:balance-of-payments,
        ngm:economic-growth,
        ngm:exchange-rate,
        ngm:inflation ;
    vc:requires ngm:econometrics,
        ngm:national-income-accounting ;
    vc:slug "macroeconomics" ;
    vc:sourceDomain "finance" ;
    vc:uses ngm:consumer-price-index,
        ngm:gross-domestic-product,
        ngm:interest-rate .

ngm:manipulator a owl:Class ;
    rdfs:label "Manipulator"@en ;
    rdfs:comment "A manipulator is a mechanically programmable device comprising a series of rigid links connected by actuated joints arranged in a serial or parallel kinematic chain, capable of displacing objects or tools through a defined workspace. The distal end carries an end-effector that interfaces directly with the task environment, enabling grasping, welding, assembly, or other physical interactions. Manipulators are parameterised by their degrees of freedom, workspace geometry, payload capacity, and control architecture, and are the foundational actuator subsystem in industrial, collaborative, and service robots. The ISO 8373:2021 standard defines a manipulator as the machine mechanism of a robot."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:robot-controller ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:robot-link ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:robot-joint ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:kinematic-model ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:actuator ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:end-effector ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:trajectory-planning ],
        ngm:robot ;
    vc:bridgesTo ngm:digital-twin,
        ngm:reinforcement-learning ;
    vc:contrastsWith ngm:mobile-manipulator,
        ngm:mobile-robot ;
    vc:dependsOn ngm:forward-kinematics,
        ngm:inverse-kinematics,
        ngm:motion-planning ;
    vc:enables ngm:assembly-automation,
        ngm:pick-and-place,
        ngm:teleoperation ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:actuator,
        ngm:end-effector,
        ngm:robot-joint,
        ngm:robot-link ;
    vc:implements ngm:denavit-hartenberg-parameters,
        ngm:iso-8373-2021 ;
    vc:isPartOf ngm:robot,
        ngm:robotic-system ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:collaborative-systems-modality-robot,
        ngm:parallel-robot ;
    vc:requires ngm:kinematic-model,
        ngm:robot-controller,
        ngm:trajectory-planning ;
    vc:slug "manipulator" ;
    vc:sourceDomain "robotics" ;
    vc:supports ngm:flexible-manufacturing,
        ngm:human-robot-collaboration ;
    vc:uses ngm:force-torque-sensor,
        ngm:sensor-fusion,
        ngm:servo-motor .

ngm:model-monitoring a owl:Class ;
    rdfs:label "Model Monitoring"@en ;
    rdfs:comment "Model monitoring is the continuous observation of a deployed machine learning model's inputs, outputs, and performance in production to detect degradation, data drift, concept drift, and operational issues. It tracks predictive quality, latency, and input distributions against baselines and triggers alerts or retraining when thresholds are breached. As a core MLOps practice, it closes the loop between deployment and maintenance, sustaining model reliability over time."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:model-inference ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:model-deployment ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:anomaly-detection ],
        ngm:mlops ;
    vc:contrastsWith ngm:model-evaluation ;
    vc:dependsOn ngm:data-quality ;
    vc:enables ngm:feedback-loop,
        ngm:model-evaluation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:anomaly-detection ;
    vc:isPartOf ngm:mlops ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:machine-learning,
        ngm:model-serving,
        ngm:observability ;
    vc:requires ngm:model-deployment,
        ngm:model-inference ;
    vc:slug "model-monitoring" ;
    vc:sourceDomain "machine-learning" ;
    vc:supports ngm:model-registry,
        ngm:model-training ;
    vc:uses ngm:anomaly-detection,
        ngm:observability .

ngm:model-optimisation-and-performance a owl:Class ;
    rdfs:label "Model Optimisation and Performance"@en ;
    rdfs:comment "Model Optimisation and Performance is the body of post-training techniques, inference-time systems, and hardware-aware transformations that reduce the computational cost, memory footprint, and latency of neural networks—particularly large language models (LLMs)—without unacceptable degradation of..."@en ;
