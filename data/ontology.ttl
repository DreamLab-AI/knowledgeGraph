ngm:safe-human-robot-interaction a owl:Class ;
    rdfs:label "Safe Human-Robot Interaction"@en ;
    rdfs:comment "Safe human-robot interaction is the body of methods and controls that allow robots to operate in close proximity to people without causing harm. It combines compliant control, force and contact limiting, collision avoidance, and speed-and-separation monitoring so that physical contact, when it occurs, stays within safe limits. It is essential for collaborative robots that share workspaces with humans."@en ;
    rdfs:subClassOf ngm:robo-human-robot-interaction ;
    skos:broader ngm:robo-human-robot-interaction ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:admittance-control,
        ngm:force-control ;
    vc:slug "safe-human-robot-interaction" ;
    vc:sourceDomain "robotics" .

ngm:safetensors-format a owl:Class ;
    rdfs:label "Safetensors Format"@en ;
    rdfs:comment "Safetensors is a file format for storing tensors — the weight matrices of machine-learning models — designed to be safe, fast, and simple. Unlike Python pickle-based formats, safetensors stores only raw tensor data and a JSON header describing shapes, dtypes, and offsets, so loading a file cannot execute arbitrary code. The layout supports zero-copy and memory-mapped loading, enabling rapid model initialisation and lazy access to individual tensors. Developed by Hugging Face, it has become a de facto standard for distributing open model weights."@en ;
    rdfs:subClassOf ngm:data-format ;
    vc:enables ngm:model-deployment ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.78"^^xsd:float ;
    vc:relatedTo ngm:data-serialization,
        ngm:safetensors ;
    vc:slug "safetensors-format" ;
    vc:sourceDomain "ai" .

ngm:safety-assurance a owl:Class ;
    rdfs:label "Safety Assurance"@en ;
    rdfs:comment "Safety assurance is the systematic process of building and demonstrating justified confidence that a system will operate safely throughout its lifecycle. It draws on hazard analysis, structured safety cases, verification evidence, and continuous monitoring to argue that residual risk is acceptable. For autonomous and industrial systems it provides the evidentiary basis for deployment and regulatory acceptance."@en ;
    rdfs:subClassOf ngm:robo-safety-and-standards ;
    skos:broader ngm:robo-safety-and-standards ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:predictive-maintenance,
        ngm:robo-navigation-and-planning ;
    vc:slug "safety-assurance" ;
    vc:sourceDomain "robotics" .

ngm:safety-case a skos:Concept ;
    rdfs:label "Safety Case"@en .

ngm:safety-certification a owl:Class ;
    rdfs:label "Safety Certification"@en ;
    rdfs:comment "Safety certification is the formal attestation by an accredited body that a product, system, or process conforms to applicable safety standards and regulations. It involves assessment, testing, and audit against criteria such as functional-safety integrity levels, after which a mark or certificate authorises deployment. For robots it verifies that protective measures like collision detection meet required safety levels."@en ;
    rdfs:subClassOf ngm:robo-safety-and-standards ;
    skos:broader ngm:robo-safety-and-standards ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:cobot-safety-levels,
        ngm:collision-detection ;
    vc:slug "safety-certification" ;
    vc:sourceDomain "robotics" .

ngm:safety-lifecycle a skos:Concept ;
