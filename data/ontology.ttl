        ngm:security-architecture ;
    skos:broader ngm:sc-governance-and-safety ;
    vc:enables ngm:breach-containment,
        ngm:dynamic-access-control,
        ngm:insider-threat-mitigation,
        ngm:microsegmentation,
        ngm:threat-detection ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:continuous-verification,
        ngm:least-privilege-access-control,
        ngm:policy-decision-point,
        ngm:policy-enforcement-point,
        ngm:policy-engine ;
