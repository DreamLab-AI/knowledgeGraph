    a owl:Restriction ;
    owl:onProperty infrastructure:requires ;
    owl:someValuesFrom spatial-computing:HazardAnalysis
] .

# Security
spatial-computing:Security rdf:type owl:Class ;
    rdfs:label "Security"@en ;
    rdfs:comment "The protection of AI systems and their components against unauthorized access, manipulation, disruption, or exploitation, encompassing confidentiality, integrity, and availability of data, models, and infrastructure throughout the AI lifecycle."@en ;
    skos:prefLabel "Security"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:spatial-computing:security" ;
    owl:sameAs <urn:visionclaw:concept:spatial-computing:security> ;
