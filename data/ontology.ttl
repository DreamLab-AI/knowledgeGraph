# Horizon Workrooms
distributed-collaboration:HorizonWorkrooms rdf:type owl:Class ;
    rdfs:subClassOf distributed-collaboration:TELE020virtualrealitytelepresence ;
    rdfs:label "Horizon Workrooms"@en ;
    rdfs:comment "\"Meta's enterprise virtual reality telepresence application for Quest headsets, providing immersive meeting rooms where distributed teams collaborate as avatars around virtual conference tables with spatial audio, shared whiteboards, screen sharing, and keyboard passthrough, representing mainstream commercialisation of VR-based remote collaboration.\""@en ;
    skos:prefLabel "Horizon Workrooms"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:distributed-collaboration:horizon-workrooms" ;
    owl:sameAs <urn:visionclaw:concept:distributed-collaboration:horizon-workrooms> ;
    vcw:contentHash "sha256-12-74d2303fd035" ;
    vcw:qualityScore "0.5"^^xsd:decimal ;
    vcw:legacyTermId "TC-0028" ;
    vcw:ontologyStatus "active" ;
    vcw:maturityLevel "developing" ;
    vcw:authorityScore "0.0"^^xsd:decimal ;
    dcterms:identifier "TC-0028" ;
    dcterms:subject "distributed-collaboration" ;
    owl:versionInfo "2.0.0" ;
    dcterms:created "2026-04-26T00:00:00Z"^^xsd:dateTime ;
    dcterms:modified "2026-04-26T13:00:00Z"^^xsd:dateTime ;
    vcw:owlRole "Object" .

distributed-collaboration:HorizonWorkrooms rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty infrastructure:requires ;
    owl:someValuesFrom distributed-collaboration:TELE100aiavatars
] .

distributed-collaboration:HorizonWorkrooms rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty infrastructure:enables ;
    owl:someValuesFrom distributed-collaboration:VirtualWhiteboarding
] .

# 3D Gaussian Splatting
distributed-collaboration:ThreeDGaussianSplatting rdf:type owl:Class ;
    rdfs:subClassOf distributed-collaboration:TELE050neuralrenderingtelepresence ;
    rdfs:label "3D Gaussian Splatting"@en ;
    rdfs:comment "\"A neural rendering technique that represents 3D scenes as collections of millions of 3D Gaussian primitives with learnable positions, colours, opacities, and covariances, enabling photorealistic real-time rendering at 100+ frames per second through GPU-accelerated rasterisation, revolutionising telepresence and immersive collaboration with unprecedented visual fidelity.\""@en ;
    skos:prefLabel "3D Gaussian Splatting"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:distributed-collaboration:3d-gaussian-splatting" ;
    owl:sameAs <urn:visionclaw:concept:distributed-collaboration:3d-gaussian-splatting> ;
    vcw:contentHash "sha256-12-961d0e7e912b" ;
    vcw:qualityScore "0.5"^^xsd:decimal ;
    vcw:legacyTermId "TC-0051" ;
    vcw:ontologyStatus "active" ;
    vcw:maturityLevel "developing" ;
    vcw:authorityScore "0.0"^^xsd:decimal ;
    dcterms:identifier "TC-0051" ;
    dcterms:subject "distributed-collaboration" ;
    owl:versionInfo "2.0.0" ;
    dcterms:created "2026-04-26T00:00:00Z"^^xsd:dateTime ;
    dcterms:modified "2026-04-26T13:00:00Z"^^xsd:dateTime ;
    vcw:owlRole "Process" .

distributed-collaboration:ThreeDGaussianSplatting rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty infrastructure:requires ;
    owl:someValuesFrom distributed-collaboration:DifferentiableRendering
] .

distributed-collaboration:ThreeDGaussianSplatting rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty infrastructure:enables ;
    owl:someValuesFrom distributed-collaboration:PhotorealisticTelepresence
] .

# Neural Radiance Fields
distributed-collaboration:NeuralRadianceFields rdf:type owl:Class ;
    rdfs:subClassOf distributed-collaboration:RealTimeRenderingPipeline ;
    rdfs:label "Neural Radiance Fields"@en ;
    rdfs:comment "\"A neural rendering technique representing 3D scenes as continuous volumetric functions encoded by multilayer perceptrons, mapping 5D coordinates (3D position + 2D viewing direction) to colour and density, enabling photorealistic novel view synthesis from sparse input photographs through volumetric ray marching and gradient-based optimisation.\""@en ;
    skos:prefLabel "Neural Radiance Fields"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:distributed-collaboration:neural-radiance-fields" ;
    owl:sameAs <urn:visionclaw:concept:distributed-collaboration:neural-radiance-fields> ;
    vcw:contentHash "sha256-12-f3826273dd2c" ;
    vcw:qualityScore "0.35"^^xsd:decimal ;
    vcw:legacyTermId "TC-0052" ;
    vcw:ontologyStatus "active" ;
    vcw:maturityLevel "developing" ;
    vcw:authorityScore "0.0"^^xsd:decimal ;
    dcterms:identifier "TC-0052" ;
    dcterms:subject "distributed-collaboration" ;
    owl:versionInfo "2.0.0" ;
    dcterms:created "2026-04-26T00:00:00Z"^^xsd:dateTime ;
    dcterms:modified "2026-04-26T13:00:00Z"^^xsd:dateTime ;
    vcw:owlRole "Process" .

# AI Avatars
distributed-collaboration:AIAvatars rdf:type owl:Class ;
    rdfs:subClassOf distributed-collaboration:ArtificialIntelligence ;
    rdfs:label "AI Avatars"@en ;
    rdfs:comment "\"Virtual representations of human users generated and animated by artificial intelligence systems, employing machine learning models to synthesise photorealistic appearance, facial expressions, body movements, and speech from sensor inputs or user intentions, enabling realistic telepresence without explicit keyframe animation.\""@en ;
    skos:prefLabel "AI Avatars"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:distributed-collaboration:ai-avatars" ;
    owl:sameAs <urn:visionclaw:concept:distributed-collaboration:ai-avatars> ;
    vcw:contentHash "sha256-12-325181ccb7d7" ;
    vcw:qualityScore "0.5"^^xsd:decimal ;
    vcw:legacyTermId "TC-0100" ;
    vcw:ontologyStatus "active" ;
    vcw:maturityLevel "developing" ;
    vcw:authorityScore "0.0"^^xsd:decimal ;
    dcterms:identifier "TC-0100" ;
    dcterms:subject "distributed-collaboration" ;
    owl:versionInfo "2.0.0" ;
    dcterms:created "2026-04-26T00:00:00Z"^^xsd:dateTime ;
    dcterms:modified "2026-04-26T17:00:00Z"^^xsd:dateTime ;
    vcw:owlRole "Agent" .

distributed-collaboration:AIAvatars rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty infrastructure:requires ;
    owl:someValuesFrom distributed-collaboration:SpeechSynthesis
] .

distributed-collaboration:AIAvatars rdfs:subClassOf [
    a owl:Restriction ;
