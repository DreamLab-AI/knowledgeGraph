        ngm:data-governance,
        ngm:data-management,
        ngm:data-pipeline ;
    vc:uses ngm:data-schema,
        ngm:verification .

ngm:embodied-ai a owl:Class ;
    rdfs:label "Embodied AI"@en ;
    rdfs:comment "Embodied AI is a research paradigm holding that intelligence emerges from the continuous sensorimotor interaction of an agent with its physical or simulated environment, rather than from purely symbolic or disembodied language-based reasoning. Embodied agents perceive the world through sensors — cameras, proprioceptive IMUs, force-torque sensors, tactile arrays — and act upon it through actuators, learning to navigate, manipulate objects, and cooperate via reinforcement learning or imitation learning in physics simulators. The field unifies robotics, cognitive science, and deep learning, with applications spanning household manipulation, autonomous navigation, humanoid motor control, and grounded natural language understanding. A central hypothesis is that richer, more transferable representations arise from interactive physical engagement with an environment rather than from passive statistical learning over corpora."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:reinforcement-learning ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:sensor-fusion ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:physics-engine ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:simulation ],
        ngm:ai-research-area ;
    skos:broader ngm:ai-research-area ;
    vc:bridgesTo ngm:digital-twin,
        ngm:extended-reality,
        ngm:spatial-computing ;
    vc:contrastsWith ngm:symbolic-ai ;
    vc:dependsOn ngm:computer-vision,
        ngm:deep-learning,
        ngm:imitation-learning ;
    vc:enables ngm:autonomous-navigation,
        ngm:grounded-language-understanding,
        ngm:robot-learning,
        ngm:robotic-manipulation,
        ngm:sim-to-real-transfer ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:cognitive-science,
        ngm:embodied-ai-simulation,
        ngm:robotics,
        ngm:situated-cognition,
        ngm:world-model ;
    vc:requires ngm:physics-engine,
        ngm:reinforcement-learning,
        ngm:sensor-fusion,
        ngm:simulation ;
    vc:slug "embodied-ai" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:domain-randomisation,
        ngm:large-language-model,
        ngm:transformer-architecture,
        ngm:vision-language-model .

ngm:fpga a owl:Class ;
    rdfs:label "FPGA"@en ;
    rdfs:comment "A Field-Programmable Gate Array (FPGA) is a reconfigurable integrated circuit that can be configured after manufacturing to implement custom digital logic, offering a middle ground between flexible general-purpose processors and fixed-function ASICs. FPGAs are widely used for low-latency AI inference acceleration, edge computing, real-time signal processing, and hardware prototyping due to their reconfigurable architecture, energy efficiency, and deterministic execution."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:hardware-description-language ],
        ngm:inference-hardware ;
    vc:bridgesTo ngm:5-g-network,
        ngm:high-frequency-trading ;
    vc:contrastsWith ngm:asic,
        ngm:central-processing-unit,
        ngm:graphics-processing-unit ;
    vc:enables ngm:low-latency-inference,
        ngm:neural-network-quantisation,
        ngm:real-time-signal-processing ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:implements ngm:convolutional-neural-network,
        ngm:hardware-accelerator ;
    vc:isPartOf ngm:ai-accelerator,
        ngm:edge-computing ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:system-on-chip ;
    vc:requires ngm:hardware-description-language ;
    vc:slug "fpga" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:autonomous-robot,
        ngm:digital-twin,
        ngm:edge-ai .

ngm:fraud-proof a owl:Class ;
    rdfs:label "Fraud Proof"@en ;
    rdfs:comment "A fraud proof is a cryptographic mechanism that allows any observer (a challenger) to demonstrate on-chain that a previously published off-chain state transition is invalid. It is the primary dispute mechanism for optimistic rollups, where sequencers post state roots optimistically and a challenge window allows watchers to submit a fraud proof if they detect an incorrect computation. Upon successful verification of a fraud proof by the base layer, the invalid state root is reverted and the sequencer's bonded stake is slashed as a penalty."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-availability ],
        ngm:cryptographic-proof ;
    vc:bridgesTo ngm:formal-verification,
        ngm:game-theory ;
    vc:contrastsWith ngm:validity-proof ;
    vc:dependsOn ngm:merkle-proof,
        ngm:sequencer ;
    vc:enables ngm:scalability,
        ngm:trustless-bridge ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:optimistic-rollup ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:layer-2-networks,
        ngm:rollup,
        ngm:slashing,
        ngm:state-channel ;
    vc:requires ngm:data-availability ;
    vc:slug "fraud-proof" ;
    vc:sourceDomain "blockchain" .

ngm:ground-truth-labels a owl:Class ;
    rdfs:label "Ground Truth Labels"@en ;
    rdfs:comment "Ground truth labels are the authoritative, human-verified or empirically observed target values assigned to data instances, used to train and evaluate supervised machine-learning models. They represent the correct answer against which model predictions are compared, forming the basis for loss computation during training and accuracy measurement during evaluation. The quality, consistency, and coverage of ground truth labels directly bound the performance a learned model can achieve."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-annotation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
