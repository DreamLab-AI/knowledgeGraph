    vc:slug "physics-simulation-engine" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:autonomous-agent,
        ngm:reinforcement-learning ;
    vc:uses ngm:finite-element-analysis,
        ngm:spatial-partitioning .

ngm:planning-module a owl:Class ;
    rdfs:label "Planning Module"@en ;
    rdfs:comment "A planning module is a software component within an autonomous system or AI agent responsible for generating sequences of actions to achieve specified goals, given a model of the current world state, available actions, and constraints. It translates high-level objectives into concrete executable task sequences, integrating deliberative reasoning, motion planning, and contingency handling. Planning modules appear in robotic architectures, autonomous vehicles, and large-language-model-based agent systems as a dedicated decision-making subsystem."@en ;
    rdfs:subClassOf ngm:ai-system-component ;
    vc:enables ngm:agentic-workflow,
        ngm:autonomous-system ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:autonomous-behavior,
        ngm:path-planning ;
    vc:slug "planning-module" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:automated-reasoning,
        ngm:large-language-models,
        ngm:motion-planning .

ngm:policy-as-code a owl:Class ;
    rdfs:label "Policy As Code"@en ;
    rdfs:comment "Policy as code is the practice of expressing governance, security, and compliance rules in a machine-readable, version-controlled language so that they can be automatically evaluated and enforced. By treating policy as a software artefact, organisations gain testability, auditability, and consistent enforcement across infrastructure, data, and application pipelines. Decisions are computed by policy engines at admission or runtime, replacing manual review with deterministic, repeatable checks."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:infrastructure-as-code ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:version-control ],
        ngm:data-governance ;
    vc:enables ngm:access-control,
        ngm:compliance-automation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:governance-framework,
        ngm:regulatory-compliance ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:access-control,
        ngm:devops,
        ngm:governance-framework ;
    vc:requires ngm:infrastructure-as-code,
        ngm:version-control ;
    vc:slug "policy-as-code" ;
    vc:sourceDomain "data" ;
    vc:supports ngm:audit,
        ngm:data-governance ;
    vc:uses ngm:open-policy-agent,
        ngm:policy-engine .

ngm:policy-information-point a owl:Class ;
    rdfs:label "Policy Information Point"@en ;
    rdfs:comment "A Policy Information Point (PIP) is the component in a policy-based access control architecture that retrieves and supplies attribute values needed by a Policy Decision Point to evaluate access requests against policies. The PIP acts as an attribute authority, querying identity stores, databases, and external services to resolve subject attributes, resource properties, and environmental conditions at decision time. It decouples the decision logic from the data sources that inform it."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:data-schema ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:digital-identity ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:biometric-data ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:personal-data ],
        ngm:access-control ;
    vc:bridgesTo ngm:distributed-ledger ;
    vc:contrastsWith ngm:session-key ;
    vc:dependsOn ngm:data-management,
        ngm:encryption ;
    vc:enables ngm:access-control,
        ngm:governance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:data-schema,
        ngm:personal-data ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:policy-administration-point,
        ngm:security ;
    vc:requires ngm:biometric-data,
        ngm:digital-identity ;
    vc:slug "policy-information-point" ;
    vc:sourceDomain "security" ;
    vc:supports ngm:privacy,
        ngm:session-management ;
    vc:uses ngm:session-key .

ngm:predicate-logic a owl:Class ;
    rdfs:label "Predicate Logic"@en ;
    rdfs:comment "Predicate logic, also called first-order predicate calculus, is a formal system that extends propositional logic with quantifiers and predicates over individual variables, allowing statements about the properties of and relations between objects in a domain of discourse. It introduces the universal and existential quantifiers, enabling expressions such as 'for all x, P(x)' and 'there exists an x such that P(x)'. Predicate logic provides the semantic and syntactic backbone for much of automated reasoning, formal specification, and knowledge representation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:propositional-logic ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:propositional-logic ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:formal-language ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:logical-inference ],
        ngm:logic ;
    vc:bridgesTo ngm:knowledge-graph ;
    vc:contrastsWith ngm:propositional-logic ;
    vc:enables ngm:automated-reasoning,
        ngm:knowledge-representation,
        ngm:theorem-proving ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:logical-inference,
        ngm:propositional-logic ;
    vc:implements ngm:first-order-logic ;
    vc:isPartOf ngm:logic ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:constraint-satisfaction,
        ngm:reasoning ;
    vc:requires ngm:formal-language,
        ngm:propositional-logic ;
    vc:slug "predicate-logic" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:standardizedBy ngm:formal-verification ;
    vc:supports ngm:ontology,
        ngm:semantic-reasoning ;
    vc:uses ngm:logical-inference .

ngm:presentation-layer a owl:Class ;
    rdfs:label "Presentation Layer"@en ;
    rdfs:comment "The Presentation Layer is the topmost stratum of the canonical stack, responsible for rendering application state into a form humans can perceive and act on. It sits directly above the Application Layer and has nothing above it in the stack. It contains user interface components, rendering pipelines, formatting, and interaction handling."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:application-layer ],
        ngm:infra-software-engineering ;
