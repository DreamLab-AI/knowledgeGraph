ngm:agentic-workflow a owl:Class ;
    rdfs:label "Agentic Workflow"@en ;
    rdfs:comment "An agentic workflow is a structured pattern of autonomous agent behaviour in which an AI model iteratively plans, executes tool calls, observes results, and revises its approach until a goal is achieved or a stopping condition is met. Unlike single-pass inference, agentic workflows employ loops, branching logic, memory, and multi-step reasoning that may span seconds to hours and involve multiple specialised sub-agents. The pattern emerged from large language model capabilities (tool use, function calling, long context) and underlies systems such as AutoGPT, LangGraph, Claude's computer use, and OpenAI's Agents SDK."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:large-language-models ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:context-window ],
        ngm:workflow-automation ;
    vc:enables ngm:ai-agent-system,
        ngm:retrieval-augmented-generation,
        ngm:task-planning ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:agent-frameworks,
        ngm:agentic-ai,
        ngm:multi-agent-systems,
        ngm:orchestration,
        ngm:planning-and-scheduling ;
    vc:requires ngm:context-window,
        ngm:large-language-models ;
    vc:slug "agentic-workflow" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:chain-of-thought,
        ngm:function-calling,
        ngm:prompt-engineering,
        ngm:reasoning,
        ngm:tool-use .

ngm:anomaly-detection a owl:Class ;
    rdfs:label "Anomaly Detection"@en ;
    rdfs:comment "Anomaly detection is a machine learning and statistical discipline concerned with identifying observations, sequences, or structural patterns that deviate significantly from a learned or assumed norm, signalling potential faults, threats, or novel phenomena. It operates in three modes: point anomaly detection (a single observation is outlying), contextual anomaly detection (an observation is anomalous given its context, e.g. a transaction at an unusual time), and collective anomaly detection (a group of observations is anomalous relative to each other). Applications span fraud detection, network intrusion detection, industrial fault monitoring, and medical diagnostics."@en ;
    rdfs:subClassOf ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:enables ngm:cybersecurity,
        ngm:fraud-detection ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:time-series-forecasting ;
    vc:slug "anomaly-detection" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:machine-learning,
        ngm:pattern-recognition .

ngm:anthropic-claude a owl:Class ;
    rdfs:label "Anthropic Claude"@en ;
    rdfs:comment "Anthropic Claude is a family of large language models developed by Anthropic PBC, designed around Constitutional AI principles that prioritise safety, helpfulness, and honesty. The model series spans Claude Instant, Claude 2, Claude 3 (Haiku, Sonnet, Opus), and Claude 3.5, with each generation advancing reasoning, coding, and multilingual capabilities. Claude is distinguished by its long context windows (up to 200k tokens in Claude 3) and its training methodology that emphasises harmlessness through RLHF and Constitutional AI feedback loops."@en ;
    rdfs:subClassOf ngm:proprietary-large-language-models ;
    vc:contrastsWith ngm:chat-gpt,
        ngm:gemini ;
    vc:dependsOn ngm:deep-learning,
        ngm:model-training ;
    vc:enables ngm:ai-alignment,
        ngm:conversational-ai ;
