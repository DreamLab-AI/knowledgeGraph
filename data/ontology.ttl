ngm:biosensing-interface a owl:Class ;
    rdfs:label "Biosensing Interface"@en ;
    rdfs:comment "Physical sensor hardware system that detects physiological signals such as heart rate, electroencephalography (EEG), galvanic skin response (GSR), and electromyography (EMG) to enable real-time adaptation of virtual interaction and user experience."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:power-supply ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:signal-processing-unit ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:analog-to-digital-converter ],
        ngm:robo-human-robot-interaction ;
    skos:broader ngm:robo-human-robot-interaction ;
    vc:bridgesTo ngm:sensor-system ;
    vc:enables ngm:adaptive-virtual-experience,
        ngm:biofeedback-systems,
        ngm:emotional-state-detection,
        ngm:stress-monitoring ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:electrocardiogram-sensor,
        ngm:electroencephalography-sensor,
        ngm:galvanic-skin-response-sensor,
        ngm:pulse-oximeter,
        ngm:signal-processing-unit ;
    vc:isPartOf ngm:affective-computing-framework,
        ngm:physiological-computing-system ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires ngm:analog-to-digital-converter,
        ngm:power-supply,
        ngm:skin-contact-electrodes,
        ngm:wireless-communication-module ;
    vc:slug "biosensing-interface" ;
    vc:sourceDomain "robotics" .

