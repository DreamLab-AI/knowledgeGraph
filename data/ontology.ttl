ngm:adr-012 a owl:Class ;
    rdfs:label "ADR-012"@en ;
    rdfs:comment "An architecture decision record numbered 012, capturing a particular architectural decision within a project alongside its context and consequences. It is part of a numbered sequence of design records."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:software-architecture ],
