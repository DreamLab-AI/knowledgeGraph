    vc:slug "microservices-architecture" ;
    vc:sourceDomain "infrastructure" .

ngm:path-planning a owl:Class ;
    rdfs:label "Path Planning"@en ;
    rdfs:comment "The computational process of finding a feasible path for a robot to move from a start configuration to a goal configuration while avoiding obstacles and satisfying constraints. It determines a sequence of configurations connecting start to goal in the robot's configuration space."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:rb-1013-localization ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:mapping ],
        ngm:motion-planning,
        ngm:robo-navigation-and-planning ;
    skos:broader ngm:robo-navigation-and-planning ;
    vc:enables ngm:navigation,
        ngm:rb-1007-trajectory-generation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires ngm:environment-model,
        ngm:goal-configuration,
        ngm:mapping,
        ngm:rb-1013-localization,
        ngm:start-configuration ;
    vc:slug "path-planning" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:rb-1017-rrt-algorithm,
        ngm:rb-1018-dijkstra-algorithm .

ngm:autonomous-vehicle a owl:Class ;
    rdfs:label "Autonomous Vehicle"@en ;
    rdfs:comment "An Autonomous Vehicle is a self-driving vehicle capable of navigating and operating without human intervention, employing artificial intelligence for perception, localisation, path planning, motion control, and decision-making."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:sensor-fusion ],
