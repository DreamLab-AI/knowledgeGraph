    vc:slug "ai-user" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:algorithmic-complexity a owl:Class ;
    rdfs:label "Algorithmic Complexity"@en ;
    rdfs:comment "Algorithmic complexity is the study of how the computational resources required by an algorithm, principally time and memory, grow as a function of input size. It is expressed using asymptotic notation that abstracts away constant factors to characterise scaling behaviour. In machine learning it governs the feasibility of training and inference, shaping choices of model architecture, optimisation and data structures."@en ;
    rdfs:subClassOf ngm:statistical-learning-theory ;
    vc:bridgesTo ngm:scalability ;
    vc:contrastsWith ngm:sample-complexity ;
    vc:dependsOn ngm:parallel-computing ;
    vc:enables ngm:scalability ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:statistical-learning-theory ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:generalisation,
        ngm:model-capacity,
        ngm:sample-complexity,
        ngm:vc-dimension ;
    vc:requires ngm:learning-theory ;
    vc:slug "algorithmic-complexity" ;
    vc:sourceDomain "machine-learning" ;
    vc:supports ngm:inference-optimisation ;
    vc:uses ngm:latency .

ngm:algorithmic-framework a owl:Class ;
    rdfs:label "Algorithmic Framework"@en ;
    rdfs:comment "An Algorithmic Framework is a structured collection of algorithms, data structures, and design principles that together provide a reusable computational scaffold for solving a class of related problems. It abstracts common patterns of search, optimisation, inference, and decision-making into composable building blocks that can be instantiated and extended for specific applications. Algorithmic frameworks underpin fields such as machine learning, procedural content generation, automated planning, and symbolic reasoning by providing principled, reproducible computational architectures."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:data-structure ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:optimization-algorithm ],
