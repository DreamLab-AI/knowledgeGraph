    vc:slug "mining-pool" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:consensus-mechanism,
        ngm:hash-function,
        ngm:peer-to-peer-network,
        ngm:stratum-protocol .

ngm:multi-agent-system a owl:Class ;
    rdfs:label "Multi-Agent System"@en ;
    rdfs:comment "A Multi-Agent System (MAS) is a computational architecture in which multiple autonomous agents — each equipped with local perception, internal state, and independent decision-making capability — interact within a shared environment to accomplish individual or collective objectives. Coordination emerges from direct communication, environmental signalling, stigmergy, or market-like auction mechanisms, without requiring any single agent to hold global knowledge or exert centralised control. MAS formalises distributed problem-solving by composing heterogeneous or homogeneous agent populations whose aggregate behaviour frequently exhibits emergence — properties absent in any individual agent. The paradigm spans robotics swarms, AI orchestration pipelines, financial market simulation, smart-grid balancing, and autonomous software engineering."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:inter-agent-communication ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:coordination-protocol ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:autonomous-agent ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ontology ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:message-passing ],
        ngm:ai-research-area ;
    skos:broader ngm:ai-research-area ;
    vc:bridgesTo ngm:decentralised-autonomous-organisation,
        ngm:peer-to-peer-network ;
    vc:contrastsWith ngm:centralised-ai,
        ngm:monolithic-agent ;
    vc:dependsOn ngm:concurrency,
        ngm:distributed-systems ;
    vc:enables ngm:autonomous-software-engineering,
        ngm:collective-decision-making,
        ngm:emergent-behaviour,
        ngm:swarm-robotics ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:agent-environment,
        ngm:autonomous-agent,
        ngm:coordination-protocol,
        ngm:inter-agent-communication ;
    vc:implements ngm:contract-net-protocol,
        ngm:fipa-acl ;
    vc:qualityScore "0.76"^^xsd:float ;
    vc:relatedTo ngm:agent-based-modelling,
        ngm:emergence,
        ngm:swarm-intelligence ;
    vc:requires ngm:agent-communication-language,
        ngm:message-passing,
        ngm:ontology ;
    vc:slug "multi-agent-system" ;
    vc:sourceDomain "ai" ;
    vc:standardizedBy ngm:fipa ;
    vc:supports ngm:algorithmic-trading,
