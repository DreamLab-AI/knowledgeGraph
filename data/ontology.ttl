ngm:robotics-process a owl:Class ;
    rdfs:label "Robotics Process"@en ;
    rdfs:comment "A Robotics Process encompasses the systematic procedures, methodologies, and workflows for robot development, deployment, operation, and maintenance, spanning requirements engineering, system design, hardware-software integration, verification and validation, commissioning, and lifecycle management. Agile and iterative development methods accommodate uncertainty and enable rapid prototyping; simulation-driven approaches using digital twins support virtual commissioning. Compliance with process standards such as ISO 9001 and IEC 61508 is required for safety-critical robotic applications."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:functional-safety ],
        ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:enables ngm:autonomous-robot,
        ngm:robot-component ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:relatedTo ngm:systems-engineering ;
    vc:requires ngm:functional-safety ;
    vc:slug "robotics-process" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:digital-twin,
        ngm:formal-verification .

