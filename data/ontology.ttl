    vc:enables ngm:agent-personalisation,
        ngm:data-sovereignty,
        ngm:decentralised-identity,
        ngm:interoperable-personal-data ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:acp-access-control-policy,
        ngm:ldp-container,
        ngm:rdf-resource,
        ngm:wac-access-control-list,
        ngm:web-id-profile ;
    vc:implements ngm:w3-c-linked-data-platform,
        ngm:w3-c-solid-protocol,
        ngm:w3-c-web-access-control ;
    vc:isPartOf ngm:decentralised-web-stack,
