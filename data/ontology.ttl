        ngm:erc-721,
        ngm:smart-contract ;
    vc:slug "non-fungible-token" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:decentralised-finance,
        ngm:nft-marketplace ;
    vc:uses ngm:ipfs,
        ngm:metadata,
        ngm:public-key-cryptography .

ngm:sustainability a owl:Class ;
    rdfs:label "Sustainability"@en ;
    rdfs:comment "Sustainability is the capacity of systems — technological, social, economic, and environmental — to meet present needs without compromising the ability of future generations to meet their own. In digital and infrastructure contexts, it encompasses energy-efficient design, responsible resource consumption, equitable access, and long-term economic viability. Sustainability integrates environmental stewardship (carbon reduction, circular material flows), social equity (accessibility, labour fairness), and economic resilience (viable creator economies, non-exploitative business models). It provides the normative and operational framework within which infrastructure systems must be planned, governed, and evolved."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:environmental-sustainability ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:life-cycle-assessment ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:esg-reporting ],
        [ a owl:Restriction ;
