        ngm:robotics ;
    vc:uses ngm:bfloat16,
        ngm:onnx,
        ngm:tensor-core .

ngm:model-optimization a owl:Class ;
    rdfs:label "Model Optimization"@en ;
    rdfs:comment "Model optimisation is the set of techniques that reduce the size or computational cost of a trained model while preserving accuracy. It includes quantisation, pruning and distillation to make deployment more efficient."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:knowledge-distillation ],
        ngm:model-deployment ;
    vc:enables ngm:inference-serving,
        ngm:model-serving ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:knowledge-distillation ;
    vc:slug "model-optimization" ;
    vc:sourceDomain "machine-learning" .

ngm:net-zero a owl:Class ;
    rdfs:label "Net Zero"@en ;
    rdfs:comment "Net zero is the state in which the greenhouse gases added to the atmosphere by human activity are balanced by an equivalent amount removed, so that net emissions over a given scope and timeframe are zero. Achieving it combines deep decarbonisation across energy, industry, transport, and land use with carbon removal to neutralise residual emissions that cannot yet be eliminated. Net zero is the central organising target of contemporary climate policy, codified in commitments such as the Paris Agreement, and is operationalised by governments and organisations through science-based pathways and reporting."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:carbon-offset ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:decarbonisation ],
        ngm:sustainability ;
    vc:dependsOn ngm:climate-change ;
    vc:enables ngm:circular-economy ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:sustainability ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:carbon-offset,
        ngm:circular-economy,
        ngm:climate-change,
        ngm:decarbonisation,
        ngm:renewable-energy ;
    vc:requires ngm:carbon-offset,
        ngm:decarbonisation ;
    vc:slug "net-zero" ;
    vc:sourceDomain "governance" ;
    vc:standardizedBy ngm:sustainability-reporting ;
    vc:supports ngm:esg,
        ngm:paris-agreement ;
    vc:uses ngm:renewable-energy .

ngm:neuromorphic-computing a owl:Class ;
    rdfs:label "Neuromorphic Computing"@en ;
    rdfs:comment "A computational paradigm that designs hardware and software systems to mirror the structure and function of biological neural networks, integrating memory and processing units to enable parallel, event-driven information processing inspired by how neurons communicate through electrical spikes. Unlike conventional von Neumann architectures, neuromorphic systems perform computation asynchronously at the location of data, enabling orders-of-magnitude improvements in energy efficiency for AI inference at the edge."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ai-hardware ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:neuromorphic-chips ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:neuromorphic-chip ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:inference-hardware ],
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:bridgesTo ngm:artificial-general-intelligence,
        ngm:cognitive-architecture ;
    vc:enables ngm:autonomous-system,
        ngm:edge-ai-accelerator,
        ngm:edge-ai-system,
        ngm:robotics ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:neuromorphic-chip,
        ngm:neuromorphic-chips ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:deep-learning,
        ngm:edge-computing,
        ngm:event-driven-architecture,
        ngm:hardware-acceleration,
        ngm:parallel-processing ;
    vc:requires ngm:ai-hardware,
        ngm:inference-hardware ;
    vc:slug "neuromorphic-computing" ;
    vc:sourceDomain "spatial-computing" .

ngm:node-based-diffusion-pipeline-interface a owl:Class ;
    rdfs:label "Node-Based Diffusion Pipeline Interface"@en ;
    rdfs:comment "A node-based diffusion pipeline interface is a visual programming environment that models a generative diffusion inference graph as a directed acyclic graph of interconnected functional nodes, where each node encapsulates a discrete operation such as model loading, text conditioning, latent sampling, or image decoding, and edges carry tensor data between nodes. This paradigm exposes the full computational structure of a diffusion pipeline as an inspectable, composable, and reproducible artefact rather than a hidden implementation detail. Tools such as ComfyUI exemplify this pattern: workflows are serialised as JSON graphs that can be version-controlled, shared, and deployed as production automation. The approach bridges visual dataflow programming traditions with modern deep-learning inference, enabling practitioners to compose multi-model, multi-stage generation pipelines without writing procedural code."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:vae ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:deep-learning-framework ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:python-pytorch-deep-learning-stack ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:node-based-editor ],
        ngm:ai-application ;
    skos:broader ngm:ai-application ;
    vc:bridgesTo ngm:generative-ai-api,
        ngm:node-graph-visual-programming-interface ;
    vc:enables ngm:generative-ai,
        ngm:image-generation,
        ngm:image-upscaling,
        ngm:inpainting,
        ngm:text-to-image,
        ngm:video-generation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:node-based-editor ;
    vc:implements ngm:directed-acyclic-graph,
        ngm:execution-model ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:ip-adapter,
        ngm:machine-learning-discipline-pipeline,
        ngm:node-based-editor,
        ngm:node-graph-visual-programming-interface,
        ngm:open-source-software ;
    vc:requires ngm:deep-learning-framework,
        ngm:python-pytorch-deep-learning-stack,
        ngm:vae ;
    vc:slug "node-based-diffusion-pipeline-interface" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:control-net,
        ngm:diffusion-model,
        ngm:gpu-compute,
        ngm:latent-diffusion,
