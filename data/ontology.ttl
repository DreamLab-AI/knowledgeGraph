    dcterms:subject "spatial-computing" ;
    owl:versionInfo "2.0.0" ;
    dcterms:created "2026-04-26T00:00:00Z"^^xsd:dateTime ;
    dcterms:modified "2026-04-26T13:00:00Z"^^xsd:dateTime ;
    vcw:owlRole "Concept" .

# Accountability (OECD)
artificial-intelligence:AccountabilityOECD rdf:type owl:Class ;
    rdfs:label "Accountability (OECD)"@en ;
    rdfs:comment "Organisations and individuals developing, deploying or operating AI systems should be accountable for their proper functioning in accordance with OECD AI Principles and applicable legal frameworks, based on their roles, context and ability to act."@en ;
    skos:prefLabel "Accountability (OECD)"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:artificial-intelligence:accountability-oecd" ;
    owl:sameAs <urn:visionclaw:concept:artificial-intelligence:accountability-oecd> ;
    vcw:contentHash "sha256-12-b910017e0bee" ;
    vcw:qualityScore "0.5"^^xsd:decimal ;
