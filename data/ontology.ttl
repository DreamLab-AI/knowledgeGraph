ngm:net-zero-transition a owl:Class ;
    rdfs:comment "The net zero transition is the structural shift of economies and financial portfolios toward balancing residual greenhouse-gas emissions with removals, in line with limiting global warming. It mobilises capital toward low-carbon technologies, retires or retrofits high-emitting assets, and aligns corporate strategy and disclosure with decarbonisation pathways. Transition finance provides the funding and instruments that allow hard-to-abate sectors to decarbonise credibly over time."@en ;
    rdfs:label "Net Zero Transition"@en ;
    rdfs:subClassOf ngm:climate-finance ;
