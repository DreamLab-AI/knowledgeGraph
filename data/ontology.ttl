ngm:adversarial-robustness a owl:Class ;
    rdfs:label "Adversarial Robustness"@en ;
    rdfs:comment "The capability of an AI system to maintain correct and consistent behavior when subjected to adversarial examples—inputs intentionally crafted with small, often imperceptible perturbations designed to cause misclassification or incorrect outputs."@en ;
    rdfs:subClassOf ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:slug "adversarial-robustness" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:adversarial-testing a owl:Class ;
    rdfs:label "Adversarial Testing"@en ;
    rdfs:comment "Testing modology that deliberately attempts to cause AI system failures through adversarial inputs, edge cases, and challenging scenarios. Adversarial testing helps identify robustness issues, safety vulnerabilities, and alignment failures before deployment."@en ;
    rdfs:subClassOf ngm:ai-governance-and-ethics,
        ngm:ai-safety ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:slug "adversarial-testing" ;
    vc:sourceDomain "artificial-intelligence" .

