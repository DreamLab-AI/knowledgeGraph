ngm:model-debugging a owl:Class ;
    rdfs:comment "Model debugging is the systematic process of diagnosing, isolating and correcting faults in the behaviour of a machine-learning model, such as poor accuracy, biased predictions, brittleness to distribution shift, or unexpected outputs on specific inputs. Unlike conventional software debugging, it must reason about statistical behaviour, training data, feature representations and learned parameters rather than deterministic control flow. Practitioners combine error analysis, interpretability tooling, slice-based evaluation and counterfactual probing to trace failures back to data, model architecture or the training procedure."@en ;
    rdfs:label "Model Debugging"@en ;
    rdfs:subClassOf ngm:ai-infrastructure ;
    rdfs:subClassOf ngm:model-evaluation ;
