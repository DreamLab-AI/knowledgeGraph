ngm:evidence-collection a owl:Class ;
    rdfs:label "Evidence Collection"@en ;
    rdfs:comment "Evidence collection is the systematic process of identifying, preserving, and documenting artefacts — digital or physical — in a manner that maintains their integrity and admissibility for legal, regulatory, or investigative proceedings. In digital contexts it encompasses forensic acquisition of disk images, memory dumps, network captures, and log files while maintaining strict chain-of-custody documentation."@en ;
    rdfs:subClassOf ngm:digital-forensics ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:compliance-evidence,
        ngm:incident-response ;
    vc:slug "evidence-collection" ;
    vc:sourceDomain "governance" ;
    vc:supports ngm:legal-evidence ;
    vc:uses ngm:audit-log,
        ngm:chain-of-custody .

ngm:existential-risk a owl:Class ;
    rdfs:label "Existential Risk"@en ;
    rdfs:comment "An existential risk is any risk that could permanently and drastically curtail humanity's long-run potential — including human extinction, irreversible civilisational collapse, or permanent totalitarian lock-in — as distinct from severe but recoverable catastrophes. The concept grounds a research agenda that prioritises preventing outcomes from which recovery is impossible, because their badness is unbounded by the loss of all future generations."@en ;
    rdfs:subClassOf ngm:catastrophic-risk-assessment ;
    vc:enables ngm:catastrophic-risk-reduction ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.85"^^xsd:float ;
    vc:relatedTo ngm:biosecurity,
        ngm:future-of-humanity-institute ;
    vc:slug "existential-risk" ;
    vc:sourceDomain "governance" .

ngm:fairness-accuracy-tradeoffs a owl:Class ;
    rdfs:label "Fairness Accuracy Tradeoffs"@en ;
    rdfs:comment "The fundamental tension in supervised machine learning between maximising predictive accuracy and satisfying fairness constraints, characterised by the Pareto frontier of achievable (accuracy, fairness) pairs. Imposing fairness constraints restricts the hypothesis space, excluding models that achieve accuracy through reliance on protected-attribute correlations. The magnitude of the accuracy cost depends on the chosen fairness criterion (demographic parity, equalised odds, calibration), the base rate differences between groups, and the flexibility of the model class."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:algorithmic-bias ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:machine-learning-model ],
        ngm:ai-governance-and-ethics ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:contrastsWith ngm:algorithmic-bias-and-variance ;
    vc:dependsOn ngm:ai-fairness,
        ngm:bias-mitigation-techniques ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:accountability,
        ngm:ai-ethics,
        ngm:explainable-ai,
        ngm:responsible-ai ;
    vc:requires ngm:algorithmic-bias,
        ngm:machine-learning-model ;
    vc:slug "fairness-accuracy-tradeoffs" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:responsible-ai-principles .

ngm:fairness-auditing-tools a owl:Class ;
    rdfs:label "Fairness Auditing Tools"@en ;
    rdfs:comment "Fairness Auditing Tools are software libraries, platforms, and frameworks designed to detect, measure, and mitigate algorithmic bias in AI systems through automated analysis, visualisation, and intervention capabilities. They operationalise fairness metrics—such as demographic parity, equalised odds, and predictive parity—across protected attribute groups, supporting both pre-deployment model assessments and continuous production monitoring."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:machine-learning-model ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:bias-mitigation-techniques ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:fairness-metrics ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:training-data ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:bias-detection-methods ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:algorithmic-bias ],
        ngm:ai-governance-and-ethics ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:enables ngm:ai-governance,
        ngm:explainability,
        ngm:responsible-ai ;
    vc:hasMaturity ngmi:maturity-established ;
