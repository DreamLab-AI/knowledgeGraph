ngm:cylindrical-robot a owl:Class ;
    rdfs:label "Cylindrical Robot"@en ;
    rdfs:comment "Cylindrical robot employs one rotary joint (azimuth) and two prismatic joints (radial and vertical) that produce a cylindrical workspace, enabling efficient reach over rectangular work envelopes."@en ;
    rdfs:subClassOf ngm:robo-actuation-and-control,
        ngm:robo-robot-type ;
    skos:broader ngm:robo-actuation-and-control,
        ngm:robo-robot-type ;
    vc:enables ngm:component-assembly,
        ngm:depalletising,
        ngm:palletising,
        ngm:pick-and-place ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:azimuth-drive,
        ngm:end-effector-mount,
        ngm:radial-actuator,
        ngm:vertical-actuator ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires ngm:base-support,
        ngm:prismatic-actuators,
        ngm:rotary-joint ;
    vc:slug "cylindrical-robot" ;
    vc:sourceDomain "robotics" .

ngm:data-anonymisation a skos:Concept ;
    rdfs:label "Data Anonymisation"@en .

ngm:data-breach a owl:Class ;
    rdfs:label "Data Breach"@en ;
    rdfs:comment "A Data Breach is a security incident in which sensitive, protected, or confidential data is accessed, disclosed, copied, transmitted, or destroyed by an unauthorised actor, whether through external attack, insider threat, or accidental exposure. In AI contexts, data breaches can compromise training datasets, model weights, inference outputs, or user interaction logs, triggering GDPR notification obligations (within 72 hours to supervisory authorities), regulatory penalties, and reputational damage. AI systems increase both the attack surface (by aggregating and processing large personal-data collections) and the potential for novel breach vectors such as model-inversion attacks and membership-inference attacks that reconstruct or identify individuals from model outputs without direct database access."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:security ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:vulnerability ],
        ngm:ai-governance-and-ethics,
        ngm:risk ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:enables ngm:privacy ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:access-control,
        ngm:audit-trail,
        ngm:cybersecurity,
        ngm:data-protection,
        ngm:privacy-preserving-data-mining,
        ngm:regulatory-compliance ;
    vc:requires ngm:security,
        ngm:vulnerability ;
    vc:slug "data-breach" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:risk-assessment,
        ngm:risk-management ;
    vc:uses ngm:membership-inference,
        ngm:model-inversion .

ngm:data-loss-prevention a owl:Class ;
    rdfs:label "Data Loss Prevention"@en ;
    rdfs:comment "Data loss prevention (DLP) is a set of security controls and technologies that detect and block the unauthorised exfiltration, leakage or misuse of sensitive data. DLP systems classify content, monitor data in use, in motion and at rest, and enforce policies at endpoints, networks and cloud services. It is a core data-protection capability supporting compliance with privacy and confidentiality requirements."@en ;
    rdfs:subClassOf ngm:infra-security-and-identity ;
    skos:broader ngm:infra-security-and-identity ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:compliance-control,
        ngm:data-protection ;
    vc:slug "data-loss-prevention" ;
    vc:sourceDomain "security" .

ngm:data-protection-impact-assessment a skos:Concept ;
    rdfs:label "Data Protection Impact Assessment"@en .

ngm:data-protection-officer a skos:Concept ;
    rdfs:label "Data Protection Officer"@en .

ngm:data-validation a skos:Concept ;
    rdfs:label "Data Validation"@en .

ngm:data-warehousing a skos:Concept ;
    rdfs:label "Data Warehousing"@en .

ngm:dead-reckoning a skos:Concept ;
    rdfs:label "Dead Reckoning"@en .

ngm:decision-making a owl:Class ;
    rdfs:label "Decision Making"@en ;
    rdfs:comment "Decision making is the cognitive and computational process of selecting a course of action from a set of available alternatives by evaluating options against objectives, constraints, and uncertainty. It spans normative models of rational choice (expected utility, Bayesian reasoning), descriptive behavioural accounts that document systematic biases, and computational frameworks such as Markov Decision Processes and reinforcement learning that formalise sequential choice under uncertainty. In artificial intelligence, decision making underpins agent planning, autonomous systems, and large-scale optimisation, bridging probability theory, control theory, and game theory into operational policies."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:bayesian-inference ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:knowledge-representation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:uncertainty-quantification ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:markov-decision-process ],
        ngm:ai-research-area ;
    skos:broader ngm:ai-research-area ;
    vc:bridgesTo ngm:ai-ethics,
        ngm:governance,
        ngm:supply-chain-management ;
    vc:contrastsWith ngm:behavioural-economics,
        ngm:bounded-rationality ;
    vc:dependsOn ngm:game-theory,
        ngm:optimisation,
        ngm:probability-theory ;
    vc:enables ngm:autonomous-agent,
        ngm:planning,
        ngm:policy-optimisation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:bayesian-inference,
        ngm:markov-decision-process,
        ngm:multi-criteria-decision-analysis,
        ngm:utility-theory ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:cognitive-process,
        ngm:cognitive-science,
        ngm:control-theory,
        ngm:risk-assessment ;
    vc:requires ngm:knowledge-representation,
        ngm:objective-function,
        ngm:uncertainty-quantification ;
    vc:slug "decision-making" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:heuristics,
        ngm:machine-learning,
        ngm:reinforcement-learning .

ngm:deep-neural-network a skos:Concept ;
    rdfs:label "Deep Neural Network"@en .

ngm:deep-speed a owl:Class ;
    rdfs:label "DeepSpeed"@en ;
    rdfs:comment "DeepSpeed is an open-source deep learning optimisation library developed by Microsoft Research that enables training and inference of extremely large neural network models through ZeRO (Zero Redundancy Optimizer) memory partitioning, pipeline parallelism, and mixed-precision arithmetic. It reduces the per-device memory footprint of model states by partitioning optimiser states, gradients, and parameters across data-parallel devices."@en ;
    rdfs:subClassOf ngm:distributed-training ;
    vc:enables ngm:large-language-model-training,
        ngm:model-parallelism ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:hugging-face-accelerate,
        ngm:pipeline-parallelism ;
    vc:slug "deep-speed" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:gradient-checkpointing,
        ngm:mixed-precision-training .

ngm:dense-passage-retrieval a owl:Class ;
    rdfs:label "Dense Passage Retrieval"@en ;
    rdfs:comment "Dense Passage Retrieval (DPR) is an information retrieval approach in which both queries and document passages are encoded into dense continuous vector representations using dual-encoder neural networks, enabling similarity search via dot-product or cosine distance rather than sparse lexical matching. It substantially outperforms traditional BM25 retrieval on semantic matching tasks and forms the retriever component of open-domain question-answering and retrieval-augmented generation systems."@en ;
    rdfs:subClassOf ngm:information-retrieval ;
    vc:enables ngm:question-answering,
        ngm:retrieval-augmented-generation,
        ngm:semantic-search ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:slug "dense-passage-retrieval" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:embedding,
        ngm:transformer,
        ngm:vector-database .

ngm:development-platform a owl:Class ;
    rdfs:label "Development Platform"@en ;
    rdfs:comment "A Development Platform is an integrated suite of tools, APIs, runtimes, and infrastructure services that enables engineers and creators to build, test, and deploy applications. In spatial computing contexts, development platforms provide SDKs for XR hardware, scene-graph editors, physics engines, and asset pipelines supporting OpenXR and Universal Scene Description (USD). They abstract hardware heterogeneity and supply governance tooling for collaborative multi-stakeholder development."@en ;
    rdfs:subClassOf ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:dependsOn ngm:digital-infrastructure ;
    vc:enables ngm:digital-twin,
        ngm:spatial-computing ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:slug "development-platform" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:collaboration,
        ngm:digital-fabrication ;
    vc:uses ngm:computer-vision,
        ngm:open-xr .

ngm:digital-asset-infrastructure a owl:Class ;
    rdfs:label "Digital Asset Infrastructure"@en ;
    rdfs:comment "The foundational technology stack comprising blockchain networks, node infrastructure, custody systems, key management solutions, and integration APIs that enable secure creation, storage, transfer, and management of digital assets across institutional and retail applications."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptographic-system ],
