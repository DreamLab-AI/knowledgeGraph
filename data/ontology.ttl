    vc:slug "bolt" ;
    vc:sourceDomain "blockchain" .

ngm:bridge-contract a owl:Class ;
    rdfs:label "Bridge Contract"@en ;
    rdfs:comment "A Bridge Contract is a smart contract deployed on one or more blockchain networks that facilitates the transfer of tokens, messages, or state between two separate chains by locking or burning assets on the source chain and minting or releasing equivalent assets on the destination chain. Bridge contracts are the on-chain components of cross-chain bridge protocols, enforcing custody, verifying cryptographic proofs of source-chain events, and coordinating with off-chain relayers or decentralised oracle networks."@en ;
    rdfs:subClassOf ngm:smart-contract ;
    vc:enables ngm:cross-chain-asset-transfer,
        ngm:cross-chain-bridge,
        ngm:wrapped-token ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:cross-chain-interoperability,
        ngm:layer-2-scaling,
        ngm:sidechain ;
    vc:slug "bridge-contract" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:cryptographic-hash,
        ngm:relayer .

ngm:burning-mechanism a owl:Class ;
    rdfs:label "Burning Mechanism"@en ;
    rdfs:comment "A Burning Mechanism is an economic design pattern in tokenised blockchain systems whereby tokens are permanently removed from circulating supply by sending them to an unspendable address (a null or black-hole address) or by protocol-enforced destruction, permanently contracting the total token supply. Token burning is deployed as a deflationary monetary policy tool to counteract inflationary issuance, to create token scarcity as a value-accrual mechanism, to implement fee markets (as in Ethereum's EIP-1559 base fee burn), and to regulate supply in algorithmic stablecoins and tokenomics models. The economic effect depends critically on the rate and predictability of burning relative to issuance."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:smart-contract ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:base-fee ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:blockchain-transaction ],
        ngm:bc-defi-and-economics,
        ngm:blockchain-entity,
        ngm:economic-mechanism ;
    skos:broader ngm:bc-defi-and-economics ;
    vc:contrastsWith ngm:block-reward,
        ngm:inflationary-token ;
    vc:dependsOn ngm:eip-1559,
        ngm:token-economics ;
    vc:enables ngm:deflationary-token,
        ngm:inflation-control,
        ngm:tokenomics ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:base-fee ;
    vc:isPartOf ngm:tokenomics-governance ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:blockchain-economics,
        ngm:fee-market,
        ngm:market-capitalization,
        ngm:virtual-economy ;
    vc:requires ngm:blockchain-transaction,
        ngm:smart-contract ;
    vc:slug "burning-mechanism" ;
    vc:sourceDomain "blockchain" .

ngm:carbon-neutrality a owl:Class ;
    rdfs:label "Carbon Neutrality"@en ;
    rdfs:comment "Carbon neutrality is a state in which an entity — an organisation, product, event, or country — achieves a net-zero balance between its greenhouse gas emissions and the carbon dioxide it removes or offsets, such that its net contribution to atmospheric CO₂ concentration is zero over a defined accounting period. It is typically achieved through a combination of direct emissions reductions, procurement of renewable energy, and the purchase and retirement of independently verified carbon credits representing emissions avoided or removed elsewhere. Carbon neutrality is distinct from net-zero emissions, which generally requires deeper reductions and limits the role of offsets, and from climate positivity, which requires net negative emissions."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:carbon-neutrality-verification ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:carbon-footprint-measurement ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:carbon-neutrality-planning ],
        ngm:climate-policy ;
    vc:bridgesTo ngm:corporate-sustainability-reporting,
        ngm:supply-chain-decarbonisation ;
    vc:contrastsWith ngm:climate-positivity,
        ngm:net-zero-emissions ;
    vc:dependsOn ngm:science-based-targets,
        ngm:voluntary-carbon-market ;
    vc:enables ngm:esg-reporting,
        ngm:green-claims-compliance,
        ngm:net-zero-targets ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:carbon-footprint-measurement,
        ngm:carbon-neutrality-planning,
        ngm:carbon-neutrality-verification ;
    vc:qualityScore "0.72"^^xsd:float ;
