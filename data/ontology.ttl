ngm:robotics-platform a owl:Class ;
    rdfs:label "Robotics Platform"@en ;
    rdfs:comment "RoboticsPlatform is an integrated hardware–software–middleware ecosystem providing standardised communication layers, hardware abstraction, simulation environments, motion-planning stacks, real-time control loops, and cloud-edge orchestration that collectively reduce engineering effort for robot ..."@en ;
    rdfs:subClassOf ngm:embedded-system,
        ngm:simulation-environment ;
    vc:enables ngm:autonomous-navigation,
        ngm:digital-twin,
        ngm:fleet-management,
        ngm:human-robot-interaction,
        ngm:robot-manipulation,
        ngm:sim-to-real-transfer,
        ngm:task-planning,
        ngm:teleoperation ;
    vc:hasPart ngm:dds-middleware,
        ngm:gripper-control,
        ngm:hardware-abstraction-layer,
        ngm:localisation,
        ngm:motion-planning,
        ngm:path-planning,
        ngm:physics-simulation,
        ngm:real-time-control,
        ngm:robot-operating-system,
        ngm:sensor-fusion ;
    vc:implements ngm:behaviour-tree,
        ngm:imitation-learning,
        ngm:micro-ros,
        ngm:move-it-2,
        ngm:nav2,
        ngm:reinforcement-learning,
        ngm:ros-2,
        ngm:ros2-control,
        ngm:slam,
        ngm:urdf ;
    vc:maturity "established" ;
    vc:qualityScore "0.52"^^xsd:float ;
    vc:relatedTo ngm:5-g,
        ngm:autonomous-vehicles,
        ngm:computer-vision,
        ngm:digital-manufacturing,
        ngm:edge-computing,
        ngm:internet-of-things,
        ngm:machine-learning ;
    vc:requires ngm:dds,
        ngm:ethernet,
        ngm:force-torque-sensor,
        ngm:gpu-compute,
        ngm:inertial-measurement-unit,
        ngm:lidar,
        ngm:real-time-operating-system,
        ngm:rgb-d-camera ;
    vc:slug "robotics-platform" ;
    vc:sourceDomain "robotics" ;
    vc:standardizedBy ngm:iec-61508,
        ngm:ieee-1872,
        ngm:iso-10218,
        ngm:iso-9283,
        ngm:omg-dds-standard,
        ngm:ros-rep,
        ngm:vda-5050 ;
    vc:supports ngm:agricultural-robotics,
        ngm:assistive-robotics,
        ngm:field-robotics,
        ngm:industrial-automation,
        ngm:space-robotics,
        ngm:surgical-robotics,
        ngm:warehouse-robotics ;
    vc:uses ngm:c,
        ngm:eigen,
        ngm:open-ai-gym,
        ngm:open-cv,
        ngm:pcl,
        ngm:python,
        ngm:rust,
        ngm:sdf,
        ngm:urdf,
        ngm:usd .

