        <urn:visionflow:linked:vector-index> ;
    vc:implements <urn:visionflow:linked:bi-encoder-architecture>,
        <urn:visionflow:linked:bm25>,
        <urn:visionflow:linked:col-bert-late-interaction>,
        <urn:visionflow:linked:cross-encoder-reranking>,
        <urn:visionflow:linked:dense-retrieval>,
        <urn:visionflow:linked:hnsw-index>,
        <urn:visionflow:linked:reciprocal-rank-fusion> ;
    vc:maturity "production-ready" ;
    vc:qualityScore "0.52"^^xsd:float ;
    vc:requires <urn:visionflow:linked:evaluation-benchmark>,
