# Friction
robotics:Friction rdf:type owl:Class ;
    rdfs:subClassOf robotics:RobotDynamics ;
    rdfs:subClassOf robotics:PhysicsModelling ;
    rdfs:label "Friction"@en ;
    rdfs:comment "**Friction** - The resistive force generated when surfaces slide or attempt to slide relative to one another, characterised by Coulomb friction (kinetic and static coefficients) and viscous damping, significantly impacting Joint Efficiency, Motor Performance, and Motion Accuracy in robotic systems."@en ;
    skos:prefLabel "Friction"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:robotics:friction" ;
    owl:sameAs <urn:visionclaw:concept:robotics:friction> ;
    vcw:contentHash "sha256-12-ebfda2a81646" ;
