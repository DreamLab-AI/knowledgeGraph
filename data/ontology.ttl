ngm:carbon-credit-token a owl:Class ;
    rdfs:label "Carbon Credit Token"@en ;
    rdfs:comment "Digital token representing verified carbon-offset value tradeable across platforms for emissions reduction and environmental sustainability."@en ;
    rdfs:subClassOf ngm:virtual-economy ;
    vc:enables ngm:carbon-offset-trading,
        ngm:emissions-trading,
        ngm:environmental-compliance,
        ngm:sustainability-reporting ;
    vc:hasPart ngm:blockchain-record,
        ngm:carbon-offset-certificate,
        ngm:token-smart-contract,
        ngm:verification-metadata ;
    vc:isPartOf ngm:environmental-asset-market,
        ngm:sustainability-framework,
        ngm:virtual-economy ;
    vc:maturity "established" ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires ngm:blockchain,
        ngm:digital-wallet,
        ngm:smart-contract,
        ngm:verification-authority ;
    vc:slug "carbon-credit-token" ;
    vc:sourceDomain "blockchain" .

