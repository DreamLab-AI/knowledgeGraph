    vc:requires ngm:game-engine,
        ngm:sensor-fusion ;
    vc:slug "virtual-reality-platform" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:haptics,
        ngm:spatial-audio .

