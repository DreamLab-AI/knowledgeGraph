        ngm:drone-navigation,
        ngm:geofencing ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:gnss-receiver,
        ngm:satellite-signal ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:dead-reckoning,
        ngm:gnss,
        ngm:real-time-kinematic ;
    vc:requires ngm:atomic-clock,
        ngm:satellite-communication,
        ngm:spectrum-allocation ;
    vc:slug "gps-navigation" ;
    vc:sourceDomain "robotics" ;
    vc:supports ngm:fleet-management,
        ngm:robot-localisation ;
    vc:uses ngm:kalman-filter,
        ngm:sensor-fusion,
        ngm:trilateration .

ngm:gradient-accumulation a owl:Class ;
    rdfs:label "Gradient Accumulation"@en ;
    rdfs:comment "Gradient accumulation is a training technique that sums the gradients computed over several consecutive mini-batches before performing a single parameter update, thereby simulating a larger effective batch size than fits in device memory. It allows training of large models on limited hardware by trading additional forward and backward passes for reduced peak memory usage. The optimiser step and gradient reset occur only after the configured number of accumulation steps has been reached."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:mini-batch ],
        ngm:model-training ;
    vc:bridgesTo ngm:deep-learning ;
    vc:contrastsWith ngm:data-parallelism ;
    vc:dependsOn ngm:batch-size ;
    vc:enables ngm:distributed-training ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:optimization-algorithm ;
    vc:isPartOf ngm:model-training ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:learning-rate,
        ngm:pipeline-parallelism ;
    vc:requires ngm:mini-batch ;
    vc:slug "gradient-accumulation" ;
    vc:sourceDomain "machine-learning" ;
    vc:supports ngm:gradient-descent,
        ngm:stochastic-gradient-descent ;
    vc:uses ngm:backpropagation,
        ngm:gradient .

ngm:gradient-aggregation a owl:Class ;
    rdfs:label "Gradient Aggregation"@en ;
    rdfs:comment "Gradient aggregation is the step in distributed machine learning where gradients computed independently on different workers or data shards are combined into a single update for the shared model. Typically realised by summing or averaging local gradients, it lets parallel workers train a consistent global model despite operating on disjoint data. The aggregation strategy and its communication pattern strongly influence training throughput, convergence and, in federated settings, privacy."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:collective-communication ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:collective-communication ],
        ngm:distributed-training ;
    vc:bridgesTo ngm:gradient-compression ;
    vc:contrastsWith ngm:model-parallelism ;
    vc:dependsOn ngm:parameter-server ;
    vc:enables ngm:federated-learning ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:all-reduce,
        ngm:collective-communication ;
    vc:implements ngm:data-parallelism ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:backpropagation,
        ngm:data-parallelism ;
    vc:requires ngm:collective-communication ;
    vc:slug "gradient-aggregation" ;
    vc:sourceDomain "machine-learning" ;
    vc:supports ngm:distributed-training ;
    vc:uses ngm:gradient-descent,
        ngm:stochastic-gradient-descent .

ngm:gradient-boosted-trees a owl:Class ;
    rdfs:label "Gradient Boosted Trees"@en ;
    rdfs:comment "Gradient boosted trees are an ensemble learning method that builds a strong predictor by sequentially adding shallow decision trees, each fitted to the negative gradient of a differentiable loss with respect to the current model's predictions. By combining many weak learners in an additive, stage-wise manner, the method achieves high accuracy on structured and tabular data while controlling overfitting through regularisation, shrinkage and subsampling. It is among the most effective approaches for supervised regression and classification on heterogeneous features."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:decision-tree ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:supervised-learning ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:loss-function ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:loss-function ],
        ngm:boosting ;
    vc:contrastsWith ngm:random-forest ;
    vc:enables ngm:classification,
        ngm:regression ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:decision-tree,
        ngm:loss-function ;
    vc:implements ngm:boosting,
        ngm:supervised-learning ;
    vc:isPartOf ngm:machine-learning ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:boosting,
        ngm:feature-importance,
        ngm:machine-learning ;
    vc:requires ngm:loss-function,
        ngm:supervised-learning ;
    vc:slug "gradient-boosted-trees" ;
    vc:sourceDomain "ai" ;
    vc:supports ngm:feature-importance ;
    vc:uses ngm:decision-tree,
        ngm:gradient-descent .

ngm:graph-databases a owl:Class ;
    rdfs:label "Graph Databases"@en ;
    rdfs:comment "Graph databases are database management systems that represent and store data as a network of nodes (entities) and edges (relationships), with both capable of carrying named property sets. Unlike relational models that encode relationships through foreign-key joins, graph databases make adjacency a first-class storage primitive, enabling traversal-based queries that navigate multi-hop paths in near-constant time per hop. They implement the property-graph or RDF triple-store data models, and are queried via languages such as Cypher, Gremlin, or SPARQL. Their native graph storage and index-free adjacency make them especially suited to domains where relationships are as semantically rich as the entities themselves."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:graph-algorithms ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:graph-query-language ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:rdf-triple-store ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:graph-data-model ],
        ngm:database-systems ;
    vc:bridgesTo ngm:graph-neural-networks,
        ngm:knowledge-representation,
        ngm:ontology-engineering ;
    vc:contrastsWith ngm:relational-database ;
    vc:enables ngm:fraud-detection,
        ngm:knowledge-graphs,
        ngm:network-analysis,
        ngm:recommendation-systems,
        ngm:semantic-search ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:graph-query-language,
        ngm:index-free-adjacency,
        ngm:property-graph-model,
        ngm:rdf-triple-store ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:linked-data,
        ngm:nosql-database,
        ngm:social-network-analysis ;
    vc:requires ngm:graph-algorithms,
        ngm:graph-data-model ;
    vc:slug "graph-databases" ;
    vc:sourceDomain "data" ;
    vc:uses ngm:cypher-query-language,
        ngm:sparql .

ngm:graph-neural-networks a owl:Class ;
    rdfs:label "Graph Neural Networks"@en ;
    rdfs:comment "A family of neural network architectures that operate directly on graph-structured data, computing node, edge or graph representations by iteratively exchanging information along edges through message-passing schemes."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:message-passing ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:graph-theory ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:adjacency-matrix ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:graph-attention-network ],
        ngm:neural-network ;
    vc:bridgesTo ngm:drug-discovery,
        ngm:social-network-analysis,
        ngm:supply-chain-optimisation ;
    vc:contrastsWith ngm:convolutional-neural-network,
        ngm:recurrent-neural-network,
        ngm:transformer ;
    vc:dependsOn ngm:embedding,
        ngm:graph-structured-data ;
    vc:enables ngm:graph-classification,
        ngm:knowledge-graph,
        ngm:link-prediction,
        ngm:node-classification,
        ngm:recommendation-systems ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:graph-attention-network,
        ngm:graph-convolutional-network ;
    vc:isPartOf ngm:deep-learning ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:knowledge-graph-embedding,
        ngm:semi-supervised-learning ;
    vc:requires ngm:adjacency-matrix,
        ngm:graph-theory,
        ngm:message-passing ;
    vc:slug "graph-neural-networks" ;
    vc:sourceDomain "machine-learning" ;
    vc:uses ngm:backpropagation .

ngm:graph-query-language a owl:Class ;
    rdfs:label "Graph Query Language"@en ;
    rdfs:comment "A graph query language is a declarative language for expressing queries, traversals, and pattern matches over graph-structured data composed of nodes and edges. Rather than joining tables, it lets users describe paths and subgraph patterns directly, making relationship-centric questions concise. Examples include Cypher and Gremlin, with GQL emerging as an ISO standard that unifies property-graph querying alongside the W3C SPARQL language for RDF."@en ;
    rdfs:subClassOf ngm:graph-database ;
    vc:bridgesTo ngm:sparql ;
    vc:contrastsWith ngm:sparql,
        ngm:sql ;
    vc:dependsOn ngm:graph-database ;
    vc:enables ngm:knowledge-graph ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:data-model,
        ngm:graphql,
        ngm:knowledge-graph,
        ngm:sql ;
    vc:slug "graph-query-language" ;
    vc:sourceDomain "data" ;
    vc:standardizedBy ngm:iso,
        ngm:standards ;
    vc:supports ngm:graph-database ;
    vc:uses ngm:data-model .

ngm:graph-rag a owl:Class ;
    rdfs:label "GraphRAG"@en ;
    rdfs:comment "GraphRAG (Graph Retrieval-Augmented Generation) is an architecture that extends standard retrieval-augmented generation by structuring the indexed knowledge corpus as a knowledge graph of entities and relationships rather than as a flat collection of text chunks, enabling the retrieval system to answer questions that require multi-hop reasoning over connected facts — such as 'what do entities A and B have in common' — which naive vector similarity search over disconnected chunks cannot reliably resolve. Microsoft Research's GraphRAG implementation, open-sourced in 2024, uses an LLM to extract entity-relationship triples from a document corpus, builds a community-detected hierarchical graph, generates community summaries at multiple granularities, and retrieves relevant subgraphs and summaries at query time to ground the LLM's response in structured relational context."@en ;
    rdfs:subClassOf ngm:retrieval-augmented-generation ;
    vc:enables ngm:ontology-in-llm-operations ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:graph-database,
        ngm:graph-neural-network,
        ngm:knowledge-graph,
        ngm:knowledge-graph-construction,
        ngm:ontology ;
    vc:slug "graph-rag" ;
    vc:sourceDomain "ai" ;
    vc:supports ngm:semantic-web-linked-data-standard ;
    vc:uses ngm:knowledge-base,
        ngm:large-language-models .

ngm:gross-domestic-product a owl:Class ;
    rdfs:label "Gross Domestic Product"@en ;
    rdfs:comment "Gross domestic product (GDP) is the total monetary value of all final goods and services produced within a country's borders over a given period. It is the principal aggregate measure of economic activity, computed via the production, income, or expenditure approaches, and is reported in nominal and real (inflation-adjusted) terms. GDP underpins growth measurement, fiscal and monetary policy, and cross-country comparison."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:inflation ],
        ngm:macroeconomics ;
    vc:contrastsWith ngm:balance-of-payments ;
    vc:dependsOn ngm:national-income ;
    vc:enables ngm:economic-growth ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:isPartOf ngm:macroeconomics ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:economic-growth,
        ngm:inflation,
        ngm:macroeconomics ;
    vc:requires ngm:inflation ;
    vc:slug "gross-domestic-product" ;
    vc:sourceDomain "finance" ;
    vc:standardizedBy ngm:national-income ;
    vc:supports ngm:fiscal-policy,
        ngm:monetary-policy ;
    vc:uses ngm:national-income .

ngm:ground-truth a skos:Concept ;
    rdfs:label "Ground Truth"@en .

ngm:group-vs-individual-fairness a owl:Class ;
    rdfs:label "Group vs Individual Fairness"@en ;
    rdfs:comment "Group vs Individual Fairness denotes two competing paradigms for defining and enforcing algorithmic fairness: group fairness requires statistical parity of outcomes or error rates across protected demographic cohorts, while individual fairness requires that similar individuals receive similar predictions regardless of group membership. The two paradigms are formally incompatible in general — satisfying demographic parity does not guarantee individual fairness and vice versa — representing a fundamental tension in fair machine learning that practitioners must resolve through context-specific policy choices. This distinction shapes the selection of fairness metrics, audit methodologies, and bias mitigation interventions in AI system design."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:fairness-metrics ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:fairness-constraints ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:fairness-auditing-tools ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:bias-detection-methods ],
        ngm:ai-ethics,
        ngm:ai-governance-and-ethics ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:contrastsWith ngm:fairness-accuracy-tradeoffs ;
    vc:enables ngm:algorithmic-accountability,
        ngm:bias-mitigation-techniques ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:fairness-constraints,
        ngm:fairness-metrics ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:algorithmic-bias,
        ngm:digital-technology-access-equity,
        ngm:disparate-impact,
        ngm:fairness,
        ngm:fairness-oecd ;
    vc:requires ngm:bias-detection-methods,
        ngm:fairness-auditing-tools ;
    vc:slug "group-vs-individual-fairness" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:explainability,
        ngm:machine-learning-discipline-model .

ngm:guaranteed-bandwidth a owl:Class ;
    rdfs:label "Guaranteed Bandwidth"@en ;
    rdfs:comment "Guaranteed Bandwidth is a network quality commitment that ensures a minimum throughput level is reserved for a specific application or user session, regardless of concurrent network load. In spatial computing and XR contexts, it is a prerequisite for low-latency immersive streaming, enabling consistent frame delivery without compression artefacts or stutter that would degrade presence. It is typically enforced through Quality of Service mechanisms, traffic prioritisation, or network slicing in 5G infrastructure."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:telecommunications-infrastructure ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:quality-of-service ],
        ngm:network-quality-metric ;
    vc:enables ngm:immersive-communication,
        ngm:real-time-processing,
        ngm:spatial-computing ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:network-infrastructure,
        ngm:network-quality-metric ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:bandwidth-adaptation,
        ngm:edge-computing,
        ngm:latency,
        ngm:latency-management-protocol ;
    vc:requires ngm:quality-of-service,
        ngm:telecommunications-infrastructure ;
    vc:slug "guaranteed-bandwidth" ;
    vc:sourceDomain "spatial-computing" .

ngm:hamiltonian-monte-carlo a owl:Class ;
    rdfs:label "Hamiltonian Monte Carlo"@en ;
    rdfs:comment "Hamiltonian Monte Carlo (HMC) is a Markov chain Monte Carlo sampling algorithm that uses Hamiltonian dynamics to generate distant, low-autocorrelation proposals in high-dimensional parameter spaces. By treating the negative log-posterior as a potential energy and augmenting with auxiliary momentum variables, HMC can traverse the posterior landscape far more efficiently than random-walk Metropolis methods."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:automatic-differentiation ],
        ngm:bayesian-inference ;
    vc:bridgesTo ngm:molecular-dynamics ;
    vc:contrastsWith ngm:gibbs-sampling,
        ngm:variational-inference ;
    vc:enables ngm:bayesian-optimisation,
        ngm:posterior-inference,
        ngm:uncertainty-quantification ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:metropolis-hastings,
        ngm:no-u-turn-sampler ;
    vc:implements ngm:bayesian-inference,
        ngm:detailed-balance ;
    vc:isPartOf ngm:markov-chain-monte-carlo,
        ngm:probabilistic-programming ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:bayesian-deep-learning,
        ngm:gaussian-process,
        ngm:inference-algorithm,
        ngm:normalising-flow ;
    vc:requires ngm:automatic-differentiation,
        ngm:gradient-computation ;
    vc:slug "hamiltonian-monte-carlo" ;
    vc:sourceDomain "machine-learning" ;
    vc:uses ngm:gaussian-distribution,
        ngm:hamiltonian-dynamics,
        ngm:phase-space .

ngm:hardware-description-language a owl:Class ;
    rdfs:label "Hardware Description Language"@en ;
    rdfs:comment "A hardware description language (HDL) is a specialised programming language used to describe the structure, behaviour and timing of digital electronic circuits at varying levels of abstraction. HDLs allow engineers to specify logic at the register-transfer level, which synthesis tools then translate into gate-level netlists for fabrication or for configuring reconfigurable devices such as FPGAs. The two dominant HDLs are Verilog and VHDL, complemented by higher-level and verification-oriented variants. By capturing concurrency and precise timing semantics, HDLs make digital designs simulatable, verifiable and reproducible before any silicon is committed."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:embedded-systems ],
        ngm:infrastructure ;
    skos:broader ngm:infrastructure ;
    vc:bridgesTo ngm:embedded-systems ;
    vc:contrastsWith ngm:gpu ;
    vc:enables ngm:asic,
        ngm:fpga,
        ngm:system-on-chip ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:infrastructure ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:gpu,
        ngm:hardware-accelerator,
        ngm:inference-hardware ;
    vc:requires ngm:embedded-systems ;
    vc:slug "hardware-description-language" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:embedded-systems,
        ngm:hardware-accelerator ;
    vc:uses ngm:digital-logic .

ngm:hardware-security-key a owl:Class ;
    rdfs:label "Hardware Security Key"@en ;
    rdfs:comment "A hardware security key is a dedicated physical authenticator — typically a USB, NFC, or Bluetooth device — that stores cryptographic keys and performs origin-bound public-key challenge responses to prove possession of a second factor. By keeping private keys in tamper-resistant hardware and signing only challenges scoped to the legitimate web origin, it provides strong resistance to phishing, credential replay, and man-in-the-middle attacks that defeat one-time-password methods. Hardware keys implement open standards such as FIDO2 and U2F and are a core enabler of passwordless and passkey-based authentication."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:authentication ],
        ngm:multi-factor-authentication ;
    vc:contrastsWith ngm:biometric-authentication,
        ngm:password ;
    vc:enables ngm:passkey,
        ngm:phishing-resistance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:yubikey ;
    vc:implements ngm:fido2,
        ngm:u2f,
        ngm:web-authn ;
    vc:isPartOf ngm:multi-factor-authentication ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:requires ngm:authentication ;
    vc:slug "hardware-security-key" ;
    vc:sourceDomain "security" ;
    vc:uses ngm:public-key-cryptography,
        ngm:security-token .

ngm:harmful-bias a owl:Class ;
    rdfs:label "Harmful Bias"@en ;
    rdfs:comment "Systematic and unjust discrimination in AI system outcomes that disadvantages individuals or groups based on protected characteristics (race, gender, age, disability, religion, etc.) or other sensitive attributes, resulting in material harm, dignity violations, or perpetuation of societal inequal..."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:bias-mitigation-techniques ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:bias-detection-methods ],
        ngm:ai-governance-and-ethics ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:contrastsWith ngm:fairness,
        ngm:fairness-metrics ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:ai-ethics,
        ngm:ai-risk ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:accountability,
        ngm:training-data ;
    vc:requires ngm:bias-detection-methods,
        ngm:bias-mitigation-techniques ;
    vc:slug "harmful-bias" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:hateoas a owl:Class ;
    rdfs:label "Hateoas"@en ;
    rdfs:comment "HATEOAS, hypermedia as the engine of application state, is the REST constraint requiring that a client interact with an application entirely through hypermedia links and controls supplied dynamically by the server in its responses. Rather than hard-coding endpoint structures, the client discovers available actions and transitions at runtime by following links the server provides, mirroring how a browser navigates the web. This constraint decouples clients from fixed URI schemes and is the distinguishing feature of a fully RESTful, self-describing API."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:client-server-architecture ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:http ],
        ngm:rest ;
    vc:bridgesTo ngm:client-server-architecture ;
    vc:dependsOn ngm:web-standards ;
    vc:enables ngm:interoperability ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:http ;
    vc:implements ngm:rest ;
    vc:isPartOf ngm:rest ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:api-design,
        ngm:http,
        ngm:web-standards ;
    vc:requires ngm:client-server-architecture ;
    vc:slug "hateoas" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:api-design,
        ngm:interoperability ;
    vc:uses ngm:http .

ngm:hazard-identification a owl:Class ;
    rdfs:label "Hazard Identification"@en ;
    rdfs:comment "Hazard identification is the systematic process of recognising and cataloguing sources of potential harm within a system, task, or environment before they cause injury, damage, or loss. It is the first and enabling stage of risk assessment, producing the list of hazards that downstream analysis, evaluation, and mitigation depend on. In robotics it underpins functional-safety compliance by exposing mechanical, electrical, control, and human-interaction hazards."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:safety-engineering ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:hazard-analysis ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:fmea ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:fault-tree-analysis ],
        ngm:risk-assessment ;
    vc:enables ngm:risk-mitigation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:fault-tree-analysis,
        ngm:fmea,
        ngm:hazard-analysis ;
    vc:isPartOf ngm:risk-assessment ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:reliability,
        ngm:risk-management,
        ngm:safety ;
    vc:requires ngm:safety-engineering ;
    vc:slug "hazard-identification" ;
    vc:sourceDomain "robotics" ;
    vc:standardizedBy ngm:iso-13482 ;
    vc:supports ngm:functional-safety,
        ngm:safety-case ;
    vc:uses ngm:collision-avoidance .

ngm:hevc a owl:Class ;
    rdfs:label "HEVC"@en ;
    rdfs:comment "HEVC (High Efficiency Video Coding), also known as H.265, is a video compression standard that roughly doubles the data compression ratio of its predecessor H.264 at the same visual quality. It introduces larger, flexible coding tree units and improved prediction and entropy coding to support 4K and 8K video. As a proprietary, patent-encumbered codec it carries licensing obligations that motivate royalty-free alternatives."@en ;
    rdfs:subClassOf ngm:technical-standard ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:proprietary-video ;
    vc:slug "hevc" ;
    vc:sourceDomain "metaverse" .

ngm:hidden-state a owl:Class ;
    rdfs:label "Hidden State"@en ;
    rdfs:comment "The vector representation of a token or sequence at any layer in a neural network, encoding contextualised information learned by the model. Hidden states are progressively refined through self-attention and feed-forward transformations, with deeper layers capturing increasingly abstract semantic features used in downstream tasks."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:token-embedding ],
        ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:enables ngm:language-modeling,
        ngm:transfer-learning ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:neural-network,
        ngm:transformer ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:attention-mechanism ;
    vc:requires ngm:token-embedding ;
    vc:slug "hidden-state" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:high-bandwidth-interconnect a owl:Class ;
    rdfs:label "High Bandwidth Interconnect"@en ;
    rdfs:comment "A high-bandwidth interconnect is a communication link or fabric engineered to move very large volumes of data between processors, accelerators, or nodes with minimal latency, enabling tightly-coupled parallel computation. In machine learning it is the substrate over which gradients, activations, and parameters are exchanged during distributed training, directly bounding how efficiently models scale across many devices. Technologies such as NVLink, InfiniBand, and RDMA fabrics provide the throughput that large-scale training demands."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:compute-infrastructure ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-centre ],
        ngm:machine-learning ;
    vc:bridgesTo ngm:high-performance-computing ;
    vc:dependsOn ngm:memory-bandwidth,
        ngm:network-fabric ;
    vc:enables ngm:data-parallelism,
        ngm:distributed-training,
        ngm:model-parallelism ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:gpu,
        ngm:latency,
        ngm:throughput ;
    vc:requires ngm:compute-infrastructure,
        ngm:data-centre ;
    vc:slug "high-bandwidth-interconnect" ;
    vc:sourceDomain "machine-learning" ;
    vc:supports ngm:checkpoints,
        ngm:collective-communication,
        ngm:parallel-processing ;
    vc:uses ngm:infiniband,
        ngm:nvlink,
        ngm:rdma .

