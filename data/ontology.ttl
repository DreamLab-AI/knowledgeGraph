    vc:qualityScore "0.35"^^xsd:float ;
    vc:slug "identity-systems" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:authentication,
        ngm:digital-identity .

ngm:iec a owl:Class ;
    rdfs:label "IEC"@en ;
    rdfs:comment "The International Electrotechnical Commission (IEC) is the leading global standards organisation that prepares and publishes international standards for all electrical, electronic and related technologies, collectively known as electrotechnology. Its standards cover areas such as industrial automation, machinery safety, programmable controllers and functional safety, and are frequently adopted jointly with ISO. IEC standards are widely referenced in robotics and industrial systems to ensure interoperability, safety and regulatory compliance."@en ;
    rdfs:subClassOf ngm:standards-organization ;
    vc:bridgesTo ngm:iso ;
    vc:contrastsWith ngm:standards-body ;
    vc:enables ngm:compliance,
        ngm:interoperability ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:interoperability,
        ngm:iso,
        ngm:robot-safety,
        ngm:safety-standard,
        ngm:standards-body ;
    vc:slug "iec" ;
    vc:sourceDomain "robotics" ;
    vc:standardizedBy ngm:standards-organization ;
    vc:supports ngm:compliance,
        ngm:industrial-automation,
        ngm:safety-standard .

ngm:iec-62443 a owl:Class ;
    rdfs:label "IEC 62443"@en ;
    rdfs:comment "IEC 62443 is a multi-part international standards series developed by IEC Technical Committee 65 (in collaboration with ISA99) that defines requirements, policies, and lifecycle processes for securing Industrial Automation and Control Systems (IACS) against cyber threats. It establishes a risk-based framework covering security management systems, security policies and procedures, system and component requirements, and security levels (SL 1–4) that grade protection against progressively sophisticated threat actors. The standard addresses all stakeholders in the IACS lifecycle — asset owners, system integrators, and product suppliers — assigning distinct roles, responsibilities, and conformance obligations to each. IEC 62443 is widely adopted in sectors such as energy, water, chemicals, manufacturing, and critical national infrastructure as the authoritative basis for operational technology (OT) cybersecurity governance."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:patch-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:vulnerability-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:risk-assessment ],
        ngm:technical-standard ;
    vc:bridgesTo ngm:digital-twin,
        ngm:security ;
    vc:contrastsWith ngm:iso-iec-27001,
        ngm:nist-sp-800-82 ;
    vc:dependsOn ngm:access-control,
        ngm:defense-in-depth,
        ngm:network-segmentation ;
    vc:enables ngm:critical-infrastructure-protection,
        ngm:industrial-cybersecurity,
        ngm:supply-chain-security ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:conduit ;
    vc:isPartOf ngm:ot-cybersecurity-framework ;
    vc:qualityScore "0.73"^^xsd:float ;
    vc:relatedTo ngm:functional-safety,
        ngm:iec-61511,
        ngm:nerc-cip,
        ngm:nis2-directive ;
    vc:requires ngm:patch-management,
        ngm:risk-assessment,
        ngm:vulnerability-management ;
    vc:slug "iec-62443" ;
    vc:sourceDomain "security" ;
    vc:standardizedBy ngm:iec ;
    vc:supports ngm:control-system,
        ngm:operational-technology,
        ngm:scada-security .

ngm:ieee-802-x a owl:Class ;
    rdfs:label "IEEE 802-X"@en ;
    rdfs:comment "IEEE 802 is the family of IEEE standards governing local area, metropolitan area, and personal area networks, defining the physical and data-link layers for technologies such as Ethernet (802.3), Wi-Fi (802.11), and low-rate wireless PANs (802.15.4). The suite standardises framing, medium access control, and addressing so that heterogeneous equipment can interoperate. It forms the backbone of most wired and wireless networking in use today."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:ieee-802-15-4 ],
        ngm:technical-standard ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:ieee-802-15-4 ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:ieee-802-15-4 ;
    vc:slug "ieee-802-x" ;
    vc:sourceDomain "infrastructure" .

ngm:image-synthesis a owl:Class ;
    rdfs:label "Image Synthesis"@en ;
    rdfs:comment "The generation of images from models or descriptions rather than direct capture, including rendering from scene data and machine learning models that produce images from learned distributions. Encompasses classical computer graphics rendering, generative adversarial networks, diffusion models, and other learned generative approaches conditioned on text, semantic maps, or latent codes."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:text-to-image-generation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
