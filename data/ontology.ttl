ngm:feature-engineering a owl:Class ;
    rdfs:comment "The process of using domain knowledge and statistical transformations to construct, select, and encode input variables from raw data so that they better represent the underlying predictive signal for machine learning models. Techniques include polynomial expansion, normalisation, temporal feature extraction, embedding of categorical variables, and dimensionality reduction via PCA or autoencoders."@en ;
    rdfs:label "Feature Engineering"@en ;
    rdfs:subClassOf ngm:data-preprocessing ;
