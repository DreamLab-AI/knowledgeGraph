    vc:slug "image-to-image" ;
    vc:sourceDomain "ai" .

ngm:imaging-parameters a owl:Class ;
    rdfs:label "Imaging Parameters"@en ;
    rdfs:comment "Imaging Parameters are the configurable settings—such as exposure time, aperture, ISO, focal length, white balance, and sensor gain—that govern how a camera or depth sensor captures light and produces a digital image. In spatial computing pipelines, correct imaging parameter calibration is essential for photogrammetric reconstruction, volumetric capture, and computer-vision model accuracy across varying lighting conditions."@en ;
    rdfs:subClassOf ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:enables ngm:image-classification,
        ngm:real-time-rendering ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:camera ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:relatedTo ngm:camera-parameters,
        ngm:photogrammetry ;
    vc:slug "imaging-parameters" ;
    vc:sourceDomain "spatial-computing" .

ngm:impact-metrics a owl:Class ;
    rdfs:label "Impact Metrics"@en ;
    rdfs:comment "Impact metrics are quantitative and qualitative indicators used to measure the social, environmental, or economic outcomes produced by an intervention, project, or organisation. They translate a theory of change into measurable outputs, outcomes, and longer-term impacts, enabling comparison, accountability, and decision-making. Standardised metric catalogues such as IRIS+ promote comparability across programmes."@en ;
    rdfs:subClassOf ngm:evaluation-metric ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:social-impact-assessment-sia ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:climate-action-dao ;
    vc:slug "impact-metrics" ;
    vc:sourceDomain "governance" .

