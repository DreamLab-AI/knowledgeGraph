            owl:someValuesFrom ngm:data-pipeline ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:training-data ],
        ngm:sociotechnical-system ;
    vc:bridgesTo ngm:digital-infrastructure,
        ngm:regulatory-compliance ;
    vc:contrastsWith ngm:rule-based-systems ;
    vc:dependsOn ngm:data-governance,
