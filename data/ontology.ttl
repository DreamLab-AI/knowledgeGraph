    vc:slug "arbitrator-expertise" ;
    vc:sourceDomain "spatial-computing" .

ngm:arbitrum-dao a owl:Class ;
    rdfs:label "Arbitrum DAO"@en ;
    rdfs:comment "Arbitrum DAO is the decentralised autonomous organisation that governs the Arbitrum One and Arbitrum Nova Layer 2 blockchain networks, operating through the ARB governance token launched by Offchain Labs in March 2023. Token holders propose and vote on protocol upgrades, treasury allocations, and parameter changes via on-chain governance contracts, making Arbitrum DAO one of the largest DAOs by treasury value in the Ethereum ecosystem. Governance decisions are executed through a Security Council with emergency intervention powers and a broader Arbitrum Improvement Proposal (AIP) process for standard changes."@en ;
    rdfs:subClassOf ngm:dao ;
    vc:enables ngm:dao-governance,
        ngm:on-chain-governance ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:ethereum,
        ngm:on-chain-voting ;
    vc:slug "arbitrum-dao" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:governance-token,
        ngm:layer-2-scaling,
        ngm:smart-contract .

ngm:arc-agi a owl:Class ;
    rdfs:label "ARC-AGI"@en ;
    rdfs:comment "ARC-AGI (Abstraction and Reasoning Corpus for Artificial General Intelligence) is a benchmark designed by François Chollet and published in 2019 to measure general fluid intelligence in AI systems through abstract visual pattern completion tasks that require novel rule induction rather than pattern recall from training data. Each task presents a small number of input-output grid transformation examples from which the solver must infer the underlying rule and apply it to a new input, using only core knowledge priors available to young children. The benchmark explicitly resists solution by memorisation, making it a proxy test for human-like generalisation ability."@en ;
    rdfs:subClassOf ngm:benchmarks ;
    vc:enables ngm:pattern-recognition,
        ngm:reasoning ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:ai-safety-research,
        ngm:artificial-general-intelligence,
        ngm:benchmark-standard ;
    vc:slug "arc-agi" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:cognitive-science,
        ngm:machine-learning .

ngm:archaeological-site-reconstruction a owl:Class ;
    rdfs:label "Archaeological Site Reconstruction"@en ;
    rdfs:comment "Archaeological Site Reconstruction refers to the use of 3D modeling, photogrammetry, LiDAR, and virtual reality technologies to create accurate digital representations of ancient sites, enabling study, documentation, preservation, and immersive public access to cultural heritage through realistic..."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
