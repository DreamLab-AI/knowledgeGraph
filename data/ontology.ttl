ngm:speculative-memetic-token-propagation a owl:Class ;
    rdfs:label "Speculative Memetic Token Propagation"@en ;
    rdfs:comment "The phenomenon in which AI agents and autonomous social actors propagate memetic content—ideas, tokens, political positions—tied to speculative financial instruments (memecoins, programmatically-aligned tokens) that derive value from attention and community adoption rather than underlying utility. This creates feedback loops between AI terminal outputs, social media virality, and tokenised capital allocation with tangible real-world effects."@en ;
    rdfs:subClassOf ngm:ai-application ;
    skos:broader ngm:ai-application ;
    vc:dependsOn ngm:blockchain ;
