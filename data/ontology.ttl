    vc:uses ngm:rb-0068-vision-system ;
    vc:uses ngm:rb-0069-lidar ;
    vc:uses ngm:rb-0078-infrared-sensor .
ngm:rb-0019-exoskeleton-robot a owl:Class ;
    rdfs:comment "An exoskeleton robot is a wearable robotic device that attaches to the human body and augments, supports, or replaces the wearer's physical capabilities. Exoskeletons may be powered (actuated) or passive (spring-and-damper based), and are used for physical rehabilitation after stroke or spinal cord injury, industrial worker fatigue reduction, and military load-carrying augmentation. Safety is paramount because the robot shares the mechanical structure with a human; ISO 13482 governs safety requirements for personal care robots including exoskeletons."@en ;
    rdfs:label "rb 0019 exoskeleton robot"@en ;
    rdfs:subClassOf ngm:exoskeleton-robot ;
    rdfs:subClassOf ngm:robo-robot-type ;
    rdfs:subClassOf _:r22917 ;
    rdfs:subClassOf _:r22918 ;
