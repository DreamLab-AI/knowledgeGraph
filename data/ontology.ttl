ngm:algorithmic-auditing a owl:Class ;
    rdfs:label "Algorithmic Auditing"@en ;
    rdfs:comment "Algorithmic auditing is the systematic evaluation of automated decision-making systems to assess their fairness, accuracy, transparency, and compliance with ethical and legal standards. It involves independent or internal review of training data, model architectures, outputs, and operational impacts. The discipline has emerged as a response to concerns about bias, discrimination, and opacity in AI-driven systems. Audits may be prospective, examining systems before deployment, or retrospective, investigating outcomes in production. Results are used to inform regulation, remediation, and public accountability."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:audit-trail ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:transparency ],
        ngm:ai-governance ;
    vc:bridgesTo ngm:data-governance,
        ngm:financial-audit,
        ngm:security-audit ;
    vc:contrastsWith ngm:black-box-ai,
        ngm:self-certification ;
    vc:enables ngm:public-accountability,
        ngm:regulatory-compliance,
        ngm:responsible-ai,
        ngm:trustworthy-ai ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:eu-ai-act,
        ngm:nist-ai-rmf ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:ai-ethics,
        ngm:ai-fairness,
        ngm:algorithmic-accountability,
        ngm:algorithmic-bias ;
    vc:requires ngm:audit-trail,
        ngm:data-access,
        ngm:transparency ;
    vc:slug "algorithmic-auditing" ;
    vc:sourceDomain "governance" ;
    vc:standardizedBy ngm:iso-iec-42001 ;
    vc:supports ngm:accountability,
        ngm:ai-governance-framework,
        ngm:ai-regulation ;
    vc:uses ngm:bias-detection-methods,
        ngm:counterfactual-analysis,
        ngm:explainable-ai,
        ngm:statistical-testing .

ngm:audio-processing a owl:Class ;
    rdfs:label "Audio Processing"@en ;
    rdfs:comment "Audio processing is the computational manipulation of digital audio signals to transform, analyse, enhance, or synthesise sound, encompassing operations such as filtering, compression, equalisation, spatialisation, and feature extraction. It operates on discrete-time representations of acoustic waveforms using algorithms drawn from digital signal processing theory, spanning both time-domain and frequency-domain approaches. Applications range from consumer media playback and telecommunications to professional studio production, speech recognition pipelines, neural audio codecs, and immersive spatial audio for extended reality environments. Machine learning has significantly expanded the discipline, enabling source separation, generative synthesis, and zero-shot audio enhancement that were previously intractable."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:digital-signal-processing ],
        ngm:signal-processing ;
    vc:bridgesTo ngm:audio-spatialization,
        ngm:extended-reality,
        ngm:spatial-audio ;
    vc:contrastsWith ngm:analogue-signal-processing,
        ngm:image-processing ;
    vc:dependsOn ngm:digital-signal-processing,
        ngm:fourier-analysis ;
    vc:enables ngm:immersive-audio-system,
        ngm:music-generation,
        ngm:spatial-audio-system,
        ngm:speech-recognition,
        ngm:text-to-speech,
        ngm:voice-activity-detection ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:audio-codec,
        ngm:audio-feature-extraction,
        ngm:digital-signal-processing,
        ngm:noise-cancellation ;
    vc:isPartOf ngm:multimedia-processing ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:audio-processing-system,
