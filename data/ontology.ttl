ngm:swarm-robot a owl:Class ;
    rdfs:comment "A Swarm Robot is a member of a multi-agent robotic system in which large numbers of simple, decentralised agents coordinate through local interactions to achieve complex collective behaviours without centralised control. Drawing from biological models such as ant colonies and flocking birds, swarm robotics enables robustness through redundancy, scalability, and emergent task execution across domains including environmental monitoring, logistics, and disaster response."@en ;
    rdfs:label "Swarm Robot"@en ;
    rdfs:subClassOf ngm:autonomous-robot ;
