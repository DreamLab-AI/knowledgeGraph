        ngm:soulbound-token .

ngm:proposal-system a owl:Class ;
    rdfs:label "Proposal System"@en ;
    rdfs:comment "Multi-stage governance workflow mechanism enabling DAO community members to initiate, discuss, deliberate, vote upon, and execute protocol changes through structured processes that combine off-chain deliberation (forums, governance calls), cryptographic signalling via off-chain snapshot votes, and binding on-chain execution through smart contracts, with threshold requirements (token holdings, quorum) balancing permissionless participation against governance efficiency."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
