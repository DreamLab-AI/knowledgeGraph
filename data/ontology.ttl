        ngm:peer-learning ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:access-control,
        ngm:comments,
        ngm:version-history ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:slug "tc-0002-collaborative-document-editing" ;
    vc:sourceDomain "distributed-collaboration" .

ngm:tc-0003-telepresence-robot a owl:Class ;
    rdfs:label "tc 0003 telepresence robot"@en ;
    rdfs:comment "Telepresence Robot - Mobile robotic platform with audio-visual and manipulation capabilities enabling a remote operator to have a physical embodied presence, interact with environments, and perform tasks at a distance while maintaining situational awareness through real-time sensory feedback."@en ;
    rdfs:subClassOf ngm:dc-telepresence,
        ngm:mobile-robot,
        ngm:telepresence-technology ;
    skos:broader ngm:dc-telepresence ;
