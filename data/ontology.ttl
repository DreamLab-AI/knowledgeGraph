    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires <urn:visionflow:linked:proximity-sensors>,
        vf:real-time-processing ;
    vc:slug "obstacle-avoidance" ;
    vc:sourceDomain "robotics" .

