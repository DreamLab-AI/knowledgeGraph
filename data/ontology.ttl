ngm:bitcoin-proof-of-work-protocol-whitepaper a owl:Class ;
    rdfs:label "Bitcoin Whitepaper"@en ;
    rdfs:comment "The October 2008 technical paper by pseudonymous author Satoshi Nakamoto, titled 'Bitcoin: A Peer-to-Peer Electronic Cash System', which introduced the design of a decentralised digital currency that eliminates reliance on trusted third parties. It proposed a chain of cryptographically linked blocks secured by proof-of-work consensus to prevent double-spending without a central authority. The paper synthesised prior work on digital cash, cryptographic hash functions, and distributed timestamps into a coherent, deployable protocol that was subsequently realised in the January 2009 Bitcoin genesis block launch."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptographic-hash-function ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:hashcash ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:merkle-tree ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:digital-signature ],
        ngm:bc-protocol-and-consensus ;
    skos:broader ngm:bc-protocol-and-consensus ;
    vc:bridgesTo ngm:decentralised-autonomous-organisation,
        ngm:smart-contract,
        ngm:zero-knowledge-proof ;
    vc:contrastsWith ngm:centralised-payment-system,
        ngm:proof-of-stake ;
    vc:enables ngm:bitcoin-proof-of-work-protocol,
        ngm:blockchain-technology,
        ngm:cryptocurrency,
        ngm:decentralised-finance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:distributed-ledger,
        ngm:peer-to-peer-network,
        ngm:proof-of-work ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:byzantine-fault-tolerance,
        ngm:cryptocurrency-technical-specification,
        ngm:cypherpunk-movement,
        ngm:double-spend-problem,
        ngm:genesis-block,
        ngm:lightning-network,
        ngm:satoshi-nakamoto ;
    vc:requires ngm:cryptographic-hash-function,
        ngm:digital-signature,
        ngm:hashcash,
        ngm:merkle-tree ;
    vc:slug "bitcoin-whitepaper" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:elliptic-curve-cryptography,
        ngm:sha-256,
        ngm:unspent-transaction-output .

