ngm:fasb-asu-2023-08 a owl:Class ;
    rdfs:label "FASB ASU 2023-08"@en ;
    rdfs:comment "FASB Accounting Standards Update 2023-08 is a US accounting standard issued by the Financial Accounting Standards Board that requires public companies to measure certain cryptocurrency assets at fair value and recognise gains and losses in net income each reporting period. The standard applies to fungible crypto assets listed on active markets, effective for fiscal years beginning after 15 December 2024. It represents a significant departure from the previous indefinite-lived intangible asset treatment that suppressed recognised gains."@en ;
    rdfs:subClassOf ngm:compliance-standards ;
    vc:contrastsWith ngm:mi-ca-regulation ;
    vc:enables ngm:compliance-monitoring,
        ngm:regulatory-reporting ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:cryptocurrency,
        ngm:digital-asset,
        ngm:digital-asset-standards,
        ngm:financial-regulation ;
    vc:slug "fasb-asu-2023-08" ;
    vc:sourceDomain "governance" ;
    vc:supports ngm:digital-asset-market,
        ngm:financial-services,
        ngm:financial-stability .

ngm:federated-edge-learning a owl:Class ;
    rdfs:label "Federated Edge Learning"@en ;
    rdfs:comment "Federated Edge Learning combines distributed machine learning with edge computing, enabling collaborative model training across decentralised edge devices while keeping training data locally on-device. Participants train local models on their private datasets and securely aggregate only model updates—rather than raw data—into a shared global model, preserving data sovereignty whilst enabling collective intelligence."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:model-training ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:federated-learning ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:edge-computing ],
        ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:enables ngm:differential-privacy,
        ngm:privacy-preserving-analytics ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:autonomous-robot,
        ngm:distributed-computing,
        ngm:machine-learning,
        ngm:privacy-utility-tradeoffs ;
    vc:requires ngm:edge-computing,
        ngm:federated-learning,
        ngm:model-training ;
    vc:slug "federated-edge-learning" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:edge-computing-node,
        ngm:gradient-descent,
        ngm:neural-network .

ngm:filecoin a owl:Class ;
    rdfs:label "Filecoin"@en ;
    rdfs:comment "Filecoin is a decentralised storage network and blockchain protocol developed by Protocol Labs that creates a peer-to-peer marketplace for file storage and retrieval, using cryptographic proofs—Proof of Replication (PoRep) and Proof of Spacetime (PoSt)—to verifiably demonstrate that storage providers are dedicating physical disk space to client data over time. Storage providers earn FIL tokens by fulfilling storage deals and continuously proving their commitments on-chain, while clients pay FIL to store data with economic guarantees backed by the provider's staked collateral. Filecoin is built on top of IPFS (InterPlanetary File System) for content-addressed data retrieval and represents the economic incentive layer designed to make decentralised storage commercially viable."@en ;
    rdfs:subClassOf ngm:decentralized-storage ;
    vc:enables ngm:decentralized-application ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:distributed-storage,
        ngm:peer-to-peer-network,
        ngm:token-economics ;
    vc:slug "filecoin" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:content-addressed-storage,
        ngm:ipfs,
        ngm:libp2p .

ngm:finality-gadget a owl:Class ;
    rdfs:label "Finality Gadget"@en ;
    rdfs:comment "A Finality Gadget is a protocol component layered onto a block-producing (typically probabilistically-final) blockchain to provide periodic deterministic finality for checkpointed epochs, operating as a BFT overlay that requires a supermajority of validator stake to attest to a canonical chain prefix before that prefix is considered irreversible. The archetypal finality gadget is Casper the Friendly Finality Gadget (Casper FFG), which Ethereum uses in its Gasper consensus construction alongside LMD-GHOST fork-choice to combine liveness (blocks always added) with periodic safety (epochs finalised every ~12.8 minutes). Finality gadgets decouple the latency-optimised block-production layer from the safety-optimised finality layer, allowing chains to maintain high throughput while providing applications with a provable point after which reorganisation is cryptoeconomically infeasible."@en ;
    rdfs:subClassOf ngm:consensus-mechanism ;
    vc:enables ngm:blockchain-security,
        ngm:transaction-finality ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:checkpoints,
        ngm:deterministic-finality,
        ngm:epoch,
        ngm:finality,
        ngm:gasper-consensus ;
    vc:slug "finality-gadget" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:probabilistic-finality,
        ngm:validator-node,
        ngm:validator-set .

ngm:flow-matching a owl:Class ;
    rdfs:label "Flow Matching"@en ;
    rdfs:comment "Flow Matching is a generative modelling framework that trains a neural network to parameterise the vector field of a continuous normalising flow by directly regressing on analytically tractable target vector fields defined along flow paths between a source distribution (typically Gaussian noise) and a data distribution. Unlike score-based diffusion models, which require simulating a stochastic differential equation during training, flow matching uses deterministic conditional flow paths that can be computed in closed form, yielding stable and efficient training. At inference, the learned vector field is integrated with an ODE solver to transport samples from noise to data."@en ;
    rdfs:subClassOf ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:contrastsWith ngm:generative-adversarial-network ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:diffusion-model,
        ngm:generative-model ;
    vc:slug "flow-matching" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:deep-learning,
        ngm:neural-network .

ngm:force-feedback a owl:Class ;
    rdfs:label "Force Feedback"@en ;
    rdfs:comment "Force feedback is a class of haptic technology that renders mechanical forces — including resistance, weight, texture, and impact — directly to a user's body through a controlled actuator system, enabling the sense of touch and proprioception to convey information about virtual or remote physical environments. Distinguished from simpler vibrotactile feedback by its ability to generate directional, grounded forces (requiring a mechanical linkage to the user), force feedback systems are used in surgical simulators, teleoperation of remote robots, vehicle simulation, and advanced XR interfaces. The fidelity of the rendered force field is constrained by the bandwidth, peak force, backdrivability, and transparency of the underlying actuator mechanism."@en ;
    rdfs:subClassOf ngm:haptics ;
    vc:enables ngm:haptic-feedback-telepresence,
        ngm:physics-simulation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:haptic-feedback,
        ngm:haptic-feedback-system,
        ngm:tactile-sensing ;
    vc:slug "force-feedback" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:actuator,
        ngm:motion-control,
        ngm:series-elastic-actuator .

ngm:gas-limit a owl:Class ;
    rdfs:label "Gas Limit"@en ;
    rdfs:comment "A Gas Limit is the maximum amount of gas — the unit measuring computational effort — that a sender authorises for a blockchain transaction or that a block may contain in aggregate. It serves as a hard cap preventing unbounded resource consumption, protecting network nodes from denial-of-service attacks and ensuring predictable block processing times. On Ethereum, each transaction carries a user-set gas limit and each block carries a protocol-enforced block gas limit that validators adjust over time."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:blockchain-transaction ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:consensus-mechanism ],
        ngm:bc-protocol-and-consensus,
        ngm:blockchain-entity,
        ngm:economic-mechanism ;
    skos:broader ngm:bc-protocol-and-consensus ;
    vc:contrastsWith ngm:proof-of-stake,
        ngm:proof-of-work ;
    vc:dependsOn ngm:base-fee,
        ngm:fee-market ;
    vc:enables ngm:blockchain-scalability,
        ngm:smart-contract-execution ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:block-size,
        ngm:blockchain-economics,
        ngm:gas-price,
        ngm:mempool,
        ngm:mev,
        ngm:transaction-fee,
        ngm:validator-node ;
    vc:requires ngm:blockchain-transaction,
        ngm:consensus-mechanism ;
    vc:slug "gas-limit" ;
    vc:sourceDomain "blockchain" .

ngm:generative-content a owl:Class ;
    rdfs:label "Generative Content"@en ;
    rdfs:comment "Generative Content is digital media — text, imagery, audio, 3D assets, or code — produced by generative AI models rather than human authors. It encompasses outputs of large language models, diffusion models, GANs, and neural synthesis systems, and raises distinct questions of provenance, copyright, and quality assurance in metaverse and spatial computing pipelines."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:generative-ai ],
        ngm:ai-application ;
    skos:broader ngm:ai-application ;
    vc:enables ngm:metaverse-content-pipeline ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:3-d-asset,
        ngm:educational-methodology ;
    vc:requires ngm:generative-ai ;
    vc:slug "generative-content" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:large-language-models .

ngm:generator-network a owl:Class ;
    rdfs:label "Generator Network"@en ;
    rdfs:comment "A generator network is the synthesis component of a generative deep learning architecture — most prominently within Generative Adversarial Networks (GANs) — that learns to map samples from a low-dimensional latent space into high-dimensional data outputs (images, audio, video, 3D shapes) whose statistical distribution matches that of a training dataset. The generator is trained in adversarial competition with a discriminator network, receiving gradient signal not from direct comparison with target samples but from the discriminator's attempt to distinguish generated from real samples, forcing the generator to produce increasingly realistic outputs. Generator networks are the conceptual precursors to the decoder components of VAEs and the denoising networks of diffusion models."@en ;
    rdfs:subClassOf ngm:generative-model ;
    vc:enables ngm:image-generation,
        ngm:style-transfer,
        ngm:synthetic-data-generator ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:deep-generative-model,
        ngm:variational-autoencoders ;
    vc:slug "generator-network" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:generative-adversarial-network,
        ngm:latent-space,
        ngm:neural-network-architecture .

ngm:gitcoin a owl:Class ;
    rdfs:label "Gitcoin"@en ;
    rdfs:comment "Gitcoin is a blockchain-based platform founded in 2017 that funds open-source software development and public goods through decentralised grant programmes, bounties, and quadratic funding rounds. It popularised the application of quadratic funding mechanisms to allocate matching pools democratically, amplifying contributions from a broad base of small donors relative to large single donors. Gitcoin has distributed tens of millions of dollars to Ethereum ecosystem developers and has expanded into identity and Sybil resistance through the Gitcoin Passport credential system."@en ;
    rdfs:subClassOf ngm:public-goods-funding ;
    vc:enables ngm:grant-programs,
        ngm:retroactive-public-goods-funding ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:dao,
        ngm:open-source-software,
        ngm:quadratic-funding ;
    vc:slug "gitcoin" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:decentralised-autonomous-organisation ;
    vc:uses ngm:gitcoin-passport,
        ngm:sybil-resistance .

ngm:gps a owl:Class ;
    rdfs:label "Gps"@en ;
    rdfs:comment "GPS (Global Positioning System) - A satellite-based Navigation System that determines the absolute geographical location of a robot, providing latitude, longitude, and altitude data for large-scale autonomous navigation, outdoor delivery, and trajectory planning with typical accuracy of 5-15 ..."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:signal-processing ],
        ngm:navigation-system,
        ngm:robo-navigation-and-planning ;
    skos:broader ngm:robo-navigation-and-planning ;
    vc:enables ngm:geofencing,
        ngm:long-range-navigation,
        ngm:multi-robot-coordination ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:isPartOf ngm:global-localisation,
        ngm:mission-planning ;
    vc:qualityScore "0.51"^^xsd:float ;
    vc:requires ngm:antenna-array,
        ngm:map-integration,
        ngm:signal-processing ;
    vc:slug "gps" ;
    vc:sourceDomain "robotics" .

ngm:haptic-feedback-system a owl:Class ;
    rdfs:label "Haptic Feedback System"@en ;
    rdfs:comment "A Haptic Feedback System is a hardware-software assembly that generates controlled tactile and kinaesthetic sensations in response to digital events, using actuator arrays (vibrotactile motors, piezoelectric patches, pneumatic bladders, or shape-memory alloys), real-time rendering engines, and closed-loop sensorimotor control loops to simulate textures, resistances, impacts, and spatial forces for users of VR/AR headsets, surgical simulators, teleoperation systems, and mobile devices. The system comprises transducers that convert electrical signals into mechanical motion, driver electronics that modulate waveform parameters (frequency, amplitude, duration), rendering middleware that maps virtual-world physics to actuator commands, and perceptual models calibrated to human mechanoreceptor response characteristics."@en ;
    rdfs:subClassOf ngm:haptic-feedback ;
    vc:enables ngm:extended-reality,
        ngm:human-robot-interaction,
        ngm:immersive-experience ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:force-feedback,
        ngm:haptic-feedback-telepresence,
        ngm:haptics,
        ngm:sensor-fusion ;
    vc:slug "haptic-feedback-system" ;
    vc:sourceDomain "graphics" ;
    vc:uses ngm:actuator,
        ngm:force-control,
        ngm:tactile-sensor .

ngm:haptic-feedback-telepresence a owl:Class ;
    rdfs:label "Haptic Feedback Telepresence"@en ;
    rdfs:comment "Haptic Feedback Telepresence is the integration of tactile and kinesthetic feedback devices — such as force-feedback gloves, exoskeletons, and haptic controllers — into telepresence systems, enabling bidirectional touch sensation between a remote operator and a distant physical or virtual environment. It closes the sensorimotor loop beyond visual and auditory channels, allowing operators to feel forces, textures, weight, and vibration, which significantly enhances manipulation precision and immersive presence in teleoperation, surgical robotics, and VR collaboration contexts."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:guaranteed-bandwidth ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:teleoperation ],
        ngm:dc-telepresence,
        ngm:haptic-feedback ;
    skos:broader ngm:dc-telepresence ;
    vc:enables ngm:immersive-communication,
        ngm:robotic-telepresence ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:telecollaboration-and-telepresence,
        ngm:telepresence ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:human-computer-interaction,
        ngm:tele-001-telepresence,
        ngm:virtual-environment ;
    vc:requires ngm:guaranteed-bandwidth,
        ngm:teleoperation ;
    vc:slug "haptic-feedback-telepresence" ;
    vc:sourceDomain "distributed-collaboration" ;
    vc:uses ngm:exoskeleton-robot,
        ngm:haptics,
        ngm:sensor-fusion,
        ngm:tactile-sensor .

ngm:head-mounted-display a owl:Class ;
    rdfs:label "Head-Mounted Display"@en ;
    rdfs:comment "A head-mounted display (HMD) is a wearable visual output device worn on the head that positions one or more display panels or optical projectors in front of the user's eyes, delivering immersive visual content for virtual reality, augmented reality, or mixed reality experiences. HMDs incorporate optics to focus near-focal-plane displays at a comfortable viewing distance, tracking systems to measure head orientation and position, and increasingly passthrough cameras for environment sensing. The design space spans sealed VR devices that occlude the real world, optical see-through AR waveguide systems, and video passthrough mixed reality headsets."@en ;
    rdfs:subClassOf ngm:display-hardware ;
    vc:enables ngm:augmented-reality,
        ngm:mixed-reality,
        ngm:virtual-reality ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:display-technology,
        ngm:extended-reality-xr,
        ngm:xr-headset ;
    vc:slug "head-mounted-display" ;
    vc:sourceDomain "hardware" ;
    vc:uses ngm:eye-tracking,
        ngm:foveated-rendering,
        ngm:haptic-feedback .

ngm:healthcare-analytics a owl:Class ;
    rdfs:label "Healthcare Analytics"@en ;
    rdfs:comment "The application of artificial intelligence and data science to healthcare data for population health management, operational efficiency optimisation, clinical outcome prediction, resource allocation, and healthcare policy decision-making. Healthcare analytics systems analyse electronic health records, claims data, public health datasets, and operational metrics to derive actionable insights for clinical and administrative improvement."@en ;
    rdfs:subClassOf ngm:ai-application,
        ngm:machine-learning ;
    skos:broader ngm:ai-application ;
    vc:enables ngm:healthcare-technology,
        ngm:medical-ai ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:medical-imaging-ai,
        ngm:pathology-ai,
        ngm:privacy-preserving-analytics ;
    vc:slug "healthcare-analytics" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:data-analytics,
        ngm:machine-learning .

ngm:http-protocol a owl:Class ;
    rdfs:label "HTTP Protocol"@en ;
    rdfs:comment "The Hypertext Transfer Protocol (HTTP) is a stateless, application-layer request-response protocol that forms the foundation of data communication on the World Wide Web, defining the format and semantics of messages exchanged between clients (browsers, API consumers) and servers (web servers, API gateways) over TCP/IP connections. Each HTTP transaction consists of a request message specifying a method (GET, POST, PUT, DELETE, PATCH, HEAD, OPTIONS), a target URI, headers conveying metadata, and an optional body, followed by a response message containing a status code, headers, and an optional body. HTTP has evolved through versions 1.0, 1.1, 2, and 3, with each version improving multiplexing, compression, and connection management."@en ;
    rdfs:subClassOf ngm:network-protocol ;
    vc:enables ngm:api-gateway,
        ngm:content-delivery-network-cdn,
        ngm:rest-api,
        ngm:web-socket-protocol ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:graph-ql,
        ngm:open-api-specification ;
    vc:slug "http-protocol" ;
    vc:sourceDomain "web" ;
    vc:uses ngm:communication-protocol,
        ngm:tls .

ngm:humanoid-robotics a owl:Class ;
    rdfs:label "Humanoid Robotics"@en ;
    rdfs:comment "Humanoid robotics is the subfield of robotics concerned with the design, construction, and control of robots that exhibit a human-like morphology, typically including a bipedal lower body and articulated upper limbs. Such robots are engineered to operate in environments built for humans, using the same tools, furniture, and physical interfaces. Key technical challenges include stable bipedal locomotion across uneven terrain, dexterous manipulation of varied objects, real-time perception and planning under uncertainty, and safe physical interaction with humans. Advances in machine learning and actuator technology have accelerated commercial deployments in manufacturing, logistics, and care."@en ;
    rdfs:subClassOf ngm:humanoid-robot ;
    vc:enables ngm:assistive-robotics,
        ngm:collaborative-robot ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:embodied-ai,
        ngm:human-robot-interaction,
        ngm:legged-locomotion,
        ngm:manipulation ;
    vc:slug "humanoid-robotics" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:motion-planning,
        ngm:sensor-fusion .

ngm:hyperledger-besu a owl:Class ;
    rdfs:label "Hyperledger Besu"@en ;
    rdfs:comment "Enterprise-grade ereum client developed by Hyperledger Foundation supporting both public and private blockchain deployments with multiple consensus mechanisms—ProofOfWork, ProofOfAuthority, Practical Byzantine Fault Tolerance|PBFT."@en ;
    rdfs:subClassOf ngm:bc-network-component ;
    skos:broader ngm:bc-network-component ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:implements ngm:consensus-protocol ;
    vc:qualityScore "0.4"^^xsd:float ;
    vc:slug "hyperledger-besu" ;
    vc:sourceDomain "blockchain" .

ngm:ieee-control-systems-society a owl:Class ;
    rdfs:label "IEEE Control Systems Society"@en ;
    rdfs:comment "The IEEE Control Systems Society (CSS) is a professional technical organisation within the Institute of Electrical and Electronics Engineers dedicated to advancing the theory, design, and application of control systems across engineering disciplines. It publishes flagship journals including IEEE Transactions on Automatic Control and the IEEE Control Systems Magazine, and organises premier conferences such as the Conference on Decision and Control (CDC). The Society bridges classical control theory with modern machine learning and autonomous systems research, promoting standards, educational resources, and an international community of practitioners. Its technical committees address domains ranging from robotics and aerospace to networked systems and intelligent transportation."@en ;
    rdfs:subClassOf ngm:control-system ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:deep-learning,
        ngm:embedded-systems,
        ngm:infra-software-engineering,
        ngm:machine-learning,
        ngm:model-based-control ;
    vc:slug "ieee-control-systems-society" ;
    vc:sourceDomain "robotics" ;
    vc:standardizedBy ngm:control-theory ;
    vc:supports ngm:autonomous-robot,
        ngm:autonomous-system,
        ngm:autonomous-vehicle,
        ngm:robotics .

ngm:immersive-interface a owl:Class ;
    rdfs:label "Immersive Interface"@en ;
    rdfs:comment "User interaction systems for VR, AR, and metaverse applications encompassing spatial user interfaces, haptic feedback devices, gesture recognition, voice control, and multimodal input mods that enable natural, intuitive engagement with virtual environments."@en ;
    rdfs:subClassOf ngm:human-computer-interface,
        ngm:sc-interaction ;
    skos:broader ngm:sc-interaction ;
    vc:enables ngm:natural-vr-interaction ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:slug "immersive-interface" ;
    vc:sourceDomain "spatial-computing" .

ngm:inclusive-design a owl:Class ;
    rdfs:label "Inclusive Design"@en ;
    rdfs:comment "Inclusive design is a design methodology and philosophy that creates products, services, environments, and digital experiences to be usable by the widest possible range of people across diverse abilities, ages, languages, cultures, and contexts, without requiring specialised adaptations or separate versions for different user groups. It treats human diversity as a design resource rather than a problem to be accommodated, recognising that designing for people with disabilities, situational impairments, or non-standard use contexts typically produces solutions that benefit all users. The approach is distinct from universal design in emphasising process — including people with diverse characteristics as active co-designers throughout — rather than solely optimising for a single configuration serving all."@en ;
    rdfs:subClassOf ngm:universal-design ;
    vc:enables ngm:inclusive-participation,
        ngm:inclusive-xr-design,
        ngm:user-experience ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:accessibility-standard,
        ngm:equity ;
    vc:slug "inclusive-design" ;
    vc:sourceDomain "web" ;
    vc:uses ngm:accessibility,
        ngm:human-computer-interaction,
        ngm:interaction-design .

ngm:information-architecture a owl:Class ;
    rdfs:label "Information Architecture"@en ;
    rdfs:comment "Information Architecture is the structural design of shared information environments — organising, labelling, and navigating content so that users and systems can find and understand data efficiently. In spatial computing and metaverse contexts it governs how virtual worlds expose content hierarchies, semantic namespaces, and navigation schemas that enable interoperability across heterogeneous platforms. Effective information architecture draws on ontologies, controlled vocabularies, and metadata standards to ensure content remains discoverable, reusable, and machine-interpretable."@en ;
    rdfs:subClassOf ngm:sc-standards-and-interop ;
    skos:broader ngm:sc-standards-and-interop ;
    vc:enables ngm:information-retrieval,
        ngm:semantic-interoperability ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:relatedTo ngm:knowledge-organization-system ;
    vc:slug "information-architecture" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:controlled-vocabulary,
        ngm:metadata-standard,
        ngm:ontology .

ngm:informed-decision-making a owl:Class ;
    rdfs:label "Informed decision-making"@en ;
    rdfs:comment "Informed decision-making is a cognitive and organisational process in which choices are grounded in accurate, relevant, and timely evidence rather than intuition, habit, or incomplete information. It encompasses the collection, analysis, and interpretation of data, the surfacing of relevant context through knowledge management systems, and the mitigation of cognitive biases that distort judgement. In digital and AI-augmented environments, informed decision-making is increasingly supported by decision support tools, predictive analytics, and transparent reasoning systems that make the basis of recommendations auditable."@en ;
    rdfs:subClassOf ngm:decision-support ;
    vc:enables ngm:distributed-decision-making,
        ngm:risk-assessment ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:data-analytics,
        ngm:knowledge-management,
        ngm:transparent-decision-making ;
    vc:slug "informed-decision-making" ;
    vc:sourceDomain "ai" ;
    vc:supports ngm:transparency ;
    vc:uses ngm:knowledge-graph,
        ngm:predictive-analytics .

ngm:infrared-led-illuminator a owl:Class ;
    rdfs:label "Infrared Led Illuminator"@en ;
    rdfs:comment "LED-based infrared light sources integrated into or used alongside VR/AR headsets to provide illumination for tracking systems, featuring compact form factors, low power consumption, and wavelengths optimised for camera sensor detection."@en ;
    rdfs:subClassOf ngm:infrared-illuminator,
        ngm:sc-interaction ;
    skos:broader ngm:sc-interaction ;
    vc:enables ngm:hand-tracking-enhancement ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:slug "infrared-led-illuminator" ;
    vc:sourceDomain "spatial-computing" .

ngm:infrared-light-source a owl:Class ;
    rdfs:label "Infrared Light Source"@en ;
    rdfs:comment "Emission devices providing infrared wavelength light for VR/AR tracking applications, encompassing LEDs, illuminators, and integrated headset components that enable eye tracking, position detection, and hand gesture recognition in extended reality systems."@en ;
    rdfs:subClassOf ngm:sc-interaction,
        ngm:tracking-hardware ;
    skos:broader ngm:sc-interaction ;
    vc:enables ngm:foveated-rendering ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:slug "infrared-light-source" ;
    vc:sourceDomain "spatial-computing" .

ngm:inspection-robot a owl:Class ;
    rdfs:label "Inspection Robot"@en ;
    rdfs:comment "A specialised robotic system designed to autonomously examine physical structures, components, or manufactured products for defects, faults, or deviations from specification. Inspection robots combine computer vision, sensor fusion, and AI-driven anomaly detection to replace or augment manual quality-assurance processes in hazardous or high-throughput environments."@en ;
    rdfs:subClassOf ngm:robo-robot-type ;
    skos:broader ngm:robo-robot-type ;
    vc:enables ngm:quality-assurance ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:robotics ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:autonomous-robot,
        ngm:collaborative-robot,
        ngm:mobile-robot ;
    vc:slug "inspection-robot" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:computer-vision,
        ngm:sensor-fusion .

ngm:interaction-design a owl:Class ;
    rdfs:label "Interaction Design"@en ;
    rdfs:comment "Interaction design is the practice of defining and shaping the behaviour of interactive systems — how they respond to user inputs, how they communicate state, and how they guide users through tasks — with the goal of creating products that are usable, efficient, and satisfying. It encompasses the design of interaction flows, feedback mechanisms, affordances, timing, and error recovery patterns across digital and physical interfaces. Interaction design is distinguished from graphic or visual design by its focus on dynamic behaviour over time rather than static visual composition, and from software engineering by its concern for the human experience of system use rather than the technical implementation of system function."@en ;
    rdfs:subClassOf ngm:human-computer-interaction ;
    vc:enables ngm:accessible-design,
        ngm:inclusive-design,
        ngm:product-design ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:accessibility,
        ngm:usability-testing,
        ngm:user-experience,
        ngm:user-interface ;
    vc:slug "interaction-design" ;
    vc:sourceDomain "web" ;
    vc:uses ngm:cognitive-science,
        ngm:feedback-mechanism,
        ngm:information-architecture .

ngm:io-t-ai-integration a owl:Class ;
    rdfs:label "IoT AI Integration"@en ;
    rdfs:comment "IoT AI Integration is the convergence of Internet of Things sensor networks with embedded machine learning models, enabling intelligent, autonomous decision-making directly on constrained IoT devices without requiring centralised cloud processing. The integration addresses fundamental IoT challenges — network latency, bandwidth limitations, power budgets, and privacy concerns — by deploying quantised and pruned inference models onto microcontroller-class hardware, transforming passive sensor networks into active edge intelligence systems."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:io-t-sensor-network ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:mqtt ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:edge-ai-system ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:machine-learning ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:internet-of-things ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:io-t-sensors ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:embedded-systems ],
        ngm:ai-infrastructure ;
    vc:enables ngm:anomaly-detection,
        ngm:edge-ai-for-smart-cities,
        ngm:industrial-io-t ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:edge-ai-system,
        ngm:io-t-sensor-network,
        ngm:io-t-sensors ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:edge-cloud-collaboration,
        ngm:latency-aware-edge-ai ;
    vc:requires ngm:embedded-systems,
        ngm:internet-of-things,
        ngm:machine-learning,
        ngm:mqtt ;
    vc:slug "io-t-ai-integration" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:predictive-analytics ;
    vc:uses ngm:edge-ai-accelerator,
        ngm:embedded-ai-frameworks,
        ngm:federated-learning .

ngm:io-t-infrastructure a owl:Class ;
    rdfs:label "IoT Infrastructure"@en ;
    rdfs:comment "IoT infrastructure is the integrated stack of hardware, networking, middleware, and cloud or edge platforms that enables the deployment, connectivity, management, and data processing of Internet of Things device fleets at scale. It encompasses device provisioning and lifecycle management, low-power wide-area or local-area communication protocols, edge gateways that aggregate and pre-process sensor data, secure device identity and over-the-air update mechanisms, and cloud or fog computing backends that host the data pipelines, analytics, and control planes for IoT applications across industrial, urban, consumer, and agricultural domains."@en ;
    rdfs:subClassOf ngm:digital-infrastructure ;
    vc:enables ngm:digital-twin,
        ngm:io-t-ai-integration,
        ngm:real-time-monitoring ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:industrial-io-t,
        ngm:internet-of-things,
        ngm:io-t-sensor-network ;
    vc:slug "io-t-infrastructure" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:edge-computing,
        ngm:embedded-systems,
        ngm:mqtt .

ngm:iso a owl:Class ;
    rdfs:label "ISO"@en ;
    rdfs:comment "The International Organisation for Standardisation (ISO) is an independent, non-governmental international body comprising the national standards institutes of 167 countries, responsible for developing and publishing voluntary international standards across virtually every sector of industry, technology, and commerce. ISO standards are produced by technical committees composed of experts nominated by member bodies and are adopted through a consensus-based process requiring defined levels of national body approval. ISO standards span quality management, environmental management, information security, robotics, artificial intelligence, financial services, and hundreds of other domains. Published standards carry normative authority in many regulatory and procurement frameworks worldwide."@en ;
    rdfs:subClassOf ngm:standards-body ;
    vc:enables ngm:compliance-framework,
        ngm:conformity-assessment,
        ngm:interoperability-standard ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:iso-iec,
        ngm:iso-standards,
        ngm:technical-standard ;
    vc:slug "iso" ;
    vc:sourceDomain "governance" ;
    vc:uses ngm:iso-iec-27001,
        ngm:iso-iec-42001,
        ngm:technical-standards .

ngm:iso-26262 a owl:Class ;
    rdfs:label "ISO 26262"@en ;
    rdfs:comment "ISO 26262 is the international functional safety standard for electrical and electronic systems in road vehicles, published in 2011 and revised in 2018 to cover motorcycles and semi-conductors. It defines an Automotive Safety Integrity Level (ASIL) classification system (A through D, with D being most critical) that governs the rigour of safety lifecycle activities—hazard analysis, safety requirements, design, implementation, testing, and validation—required for each item. Compliance provides the framework for demonstrating that vehicle systems and software achieve an acceptable residual risk of hazardous failure."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:formal-verification ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:software-testing ],
        ngm:safety-standard ;
    vc:enables ngm:adas,
        ngm:autonomous-vehicle,
        ngm:self-driving-car ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:do-178-c,
        ngm:functional-safety,
        ngm:iec-61508 ;
    vc:requires ngm:formal-verification,
        ngm:software-testing ;
    vc:slug "iso-26262" ;
    vc:sourceDomain "infrastructure" .

ngm:khronos-group a owl:Class ;
    rdfs:label "Khronos Group"@en ;
    rdfs:comment "The Khronos Group is an open, member-driven industry consortium that creates and maintains royalty-free standards for graphics, compute, and media APIs across a wide range of platforms and devices. Founded in 2000, its portfolio includes OpenGL, Vulkan, OpenCL, OpenXR, glTF, and NNEF, among others. Khronos standards form the foundational layer for GPU-accelerated rendering, XR runtimes, and portable neural network deployment across the technology industry."@en ;
    rdfs:subClassOf ngm:standardization-bodies ;
    vc:enables ngm:3-d-graphics-standard,
        ngm:gpu-compute,
        ngm:graphics-api,
        ngm:spatial-computing ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:3-d-file-format,
        ngm:interoperability-standard,
        ngm:open-standard,
        ngm:rendering-technology,
        ngm:technical-standard ;
    vc:slug "khronos-group" ;
    vc:sourceDomain "governance" ;
    vc:supports ngm:augmented-reality,
        ngm:machine-learning-framework,
        ngm:mixed-reality,
        ngm:virtual-reality .

ngm:kv-cache a owl:Class ;
    rdfs:label "KV Cache"@en ;
    rdfs:comment "A KV Cache (Key-Value Cache) in transformer-based language models is a memory structure that stores the computed key and value projection tensors from the multi-head self-attention mechanism for all previously processed tokens in a sequence, allowing autoregressive decoding to reuse these intermediate results rather than recomputing them at every generation step, thereby reducing the per-token computational cost from O(N²) to O(N) in generation. Each decoder layer maintains its own KV cache, which grows linearly with sequence length and model width, making memory bandwidth and GPU HBM capacity the primary constraints on inference throughput for long-context models. KV cache management strategies — including paged allocation (PagedAttention), prefix sharing, quantisation, and off-loading — are critical determinants of serving efficiency and cost."@en ;
    rdfs:subClassOf ngm:inference-engine ;
    vc:enables ngm:inference,
        ngm:large-language-models,
        ngm:speculative-decoding ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:attention-mechanism,
        ngm:context-window,
        ngm:query-key-value,
        ngm:self-attention ;
    vc:slug "kv-cache" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:flash-attention,
        ngm:gpu-compute,
        ngm:hardware-acceleration .

ngm:leader-election a owl:Class ;
    rdfs:label "Leader Election"@en ;
    rdfs:comment "Leader election is a fundamental coordination primitive in distributed computing that enables a cluster of peer nodes to agree on a single node — the leader — that assumes special coordination responsibilities such as sequencing writes, directing consensus rounds, or managing resource allocation on behalf of the group. In the presence of node failures, network partitions, or leader crashes, the leader election protocol must reliably select a new leader from the surviving nodes while ensuring safety (at most one leader at a time) and liveness (a leader is eventually elected) properties hold."@en ;
    rdfs:subClassOf ngm:distributed-consensus ;
    vc:enables ngm:consensus-protocol,
        ngm:distributed-system,
        ngm:service-discovery ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:byzantine-fault-tolerance,
        ngm:participant-coordination ;
    vc:slug "leader-election" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:consensus-algorithm,
        ngm:fault-tolerance,
        ngm:paxos,
        ngm:raft .

ngm:learning-module a owl:Class ;
    rdfs:label "Learning Module"@en ;
    rdfs:comment "Self-contained educational units within VR and metaverse training systems that provide structured learning experiences, including interactive simulations, assessments, and collaborative activities designed for specific skill development objectives."@en ;
    rdfs:subClassOf ngm:educational-technology,
        ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:enables ngm:structured-training ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:slug "learning-module" ;
    vc:sourceDomain "spatial-computing" .

ngm:lens-and-camera-calibration a owl:Class ;
    rdfs:label "Lens and Camera Calibration"@en ;
    rdfs:comment "Lens and Camera Calibration is the systematic metrology process of estimating the full set of geometric and photometric parameters that govern image formation in a camera-lens system, enabling precise bidirectional mapping between three-dimensional world coordinates and two-dimensional image pixe..."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:bundle-adjustment ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:calibration-target ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:pose-estimation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:calibration-target ],
        ngm:ai-technique,
        ngm:geometric-camera-models,
        ngm:sensor-calibration ;
    skos:broader ngm:ai-technique ;
    vc:enables ngm:3-d-reconstruction,
        ngm:augmented-reality,
        ngm:autonomous-driving-perception,
        ngm:metric-reconstruction,
        ngm:robotic-grasping,
        ngm:slam,
        ngm:stereo-depth-estimation,
        ngm:structure-from-motion,
        ngm:visual-odometry ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:april-tag,
        ngm:bundle-adjustment,
        ngm:calibration-target,
        ngm:camera-intrinsics,
        ngm:ch-ar-uco-board,
        ngm:extrinsic-parameters,
        ngm:homography,
        ngm:lens-distortion-model,
        ngm:pinhole-camera-model,
        ngm:reprojection-error ;
    vc:implements ngm:brown-conrady-distortion-model,
        ngm:direct-linear-transform,
        ngm:dual-quaternion-hand-eye-calibration,
        ngm:kannala-brandt-fisheye-model,
        ngm:levenberg-marquardt-optimisation,
        ngm:zhang-calibration-method ;
    vc:qualityScore "0.52"^^xsd:float ;
    vc:relatedTo ngm:bundle-adjustment,
        ngm:depth-estimation,
        ngm:imu-preintegration,
        ngm:lidar-calibration,
        ngm:photometric-calibration,
        ngm:stereo-matching,
        ngm:structure-from-motion,
        ngm:visual-odometry ;
    vc:requires ngm:calibration-target,
        ngm:feature-detection,
        ngm:linear-algebra,
        ngm:nonlinear-optimisation,
        ngm:pose-estimation,
        ngm:projective-geometry,
        ngm:stereo-vision ;
    vc:slug "lens-and-camera-calibration" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:standardizedBy ngm:ieee-transactions-on-pattern-analysis-and-machine-intelligence,
        ngm:iso-10110-optics-standards,
        ngm:iso-tc172-optics-standardisation,
        ngm:open-cv-documentation ;
    vc:supports ngm:augmented-reality,
        ngm:autonomous-vehicle,
        ngm:drone-photogrammetry,
        ngm:industrial-machine-vision,
        ngm:medical-imaging,
        ngm:satellite-imagery,
        ngm:surgical-robotics ;
    vc:uses ngm:april-tag,
        ngm:ar-uco,
        ngm:colmap,
        ngm:deep-learning,
        ngm:fiducial-markers,
        ngm:imu-sensors,
        ngm:kalibr,
        ngm:open-cv,
        ngm:point-cloud-processing .

ngm:lo-ra-fine-tuning a owl:Class ;
    rdfs:label "LoRA Fine-Tuning"@en ;
    rdfs:comment "LoRA (Low-Rank Adaptation) fine-tuning is a parameter-efficient fine-tuning technique that adapts large pre-trained transformer models by inserting pairs of trainable low-rank matrices (A ∈ ℝ^{d×r} and B ∈ ℝ^{r×d}, where r ≪ d) alongside frozen weight matrices in selected layers, so that the effective weight update ΔW = BA is constrained to a low-dimensional subspace. By training only the injected adapter matrices — typically representing 0.1–1% of the original parameter count — LoRA achieves near full fine-tuning performance at a fraction of the GPU memory and compute cost, enabling adaptation of billion-parameter models on consumer hardware. It is now the dominant technique in the PEFT ecosystem and is implemented in Hugging Face's PEFT library."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:pre-training ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:large-language-models ],
        ngm:ai-technique,
        ngm:parameter-efficient-fine-tuning ;
    skos:broader ngm:ai-technique ;
    vc:enables ngm:domain-adaptation,
        ngm:fine-tuning ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:model-training,
        ngm:quantisation ;
    vc:requires ngm:large-language-models,
        ngm:pre-training ;
    vc:slug "lo-ra-fine-tuning" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:machine-to-machine-payments a owl:Class ;
    rdfs:label "Machine to Machine Payments"@en ;
    rdfs:comment "Machine to Machine Payments (M2M Payments) refers to automated financial transactions initiated and settled between autonomous devices, software agents, or AI systems without direct human involvement in each individual transaction. These payments enable IoT devices, autonomous vehicles, robots, and AI agents to pay for resources, services, or data on a per-use or streaming basis, forming the economic layer of the machine economy. M2M payments typically require programmable money, low transaction fees, high throughput, and reliable settlement guarantees, properties that have driven interest in blockchain-based payment channels, stablecoins, and central bank digital currencies as settlement rails."@en ;
    rdfs:subClassOf ngm:digital-payment-system ;
    vc:enables ngm:decentralised-finance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:agentic-finance,
        ngm:agentic-internet,
        ngm:autonomous-agent ;
    vc:slug "machine-to-machine-payments" ;
    vc:sourceDomain "finance" ;
    vc:supports ngm:digital-payments ;
    vc:uses ngm:lightning-network,
        ngm:micropayments,
        ngm:smart-contract .

ngm:mapping a owl:Class ;
    rdfs:label "Mapping"@en ;
    rdfs:comment "Mapping is the process of creating structured correspondences between two or more domains, spaces, or data representations — including cartographic, semantic, and data-schema contexts. In spatial computing it denotes the construction of environment models; in knowledge engineering it describes the alignment of ontologies, schemas, or concept hierarchies; in AI it encompasses learned transformations between input and output spaces. Mapping is foundational to navigation, data integration, and cross-domain reasoning."@en ;
    rdfs:subClassOf ngm:knowledge-graph ;
    vc:enables ngm:autonomous-navigation,
        ngm:data-integration,
        ngm:knowledge-graph-construction ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:geospatial-technology,
        ngm:simultaneous-localisation-and-mapping,
        ngm:spatial-mapping ;
    vc:slug "mapping" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:localization,
        ngm:slam .

ngm:material-definition a owl:Class ;
    rdfs:label "Material Definition"@en ;
    rdfs:comment "A material definition is a structured data specification that describes how a surface or volume should appear under lighting, encoding properties such as base colour, roughness, metalness, emissivity, and transparency in a renderer-agnostic format. It underpins physically based rendering (PBR) pipelines by separating the description of physical surface behaviour from the rendering algorithm that evaluates it. Material definitions may be authored in formats such as MaterialX, glTF materials, or OpenUSD surface shading networks, enabling interchange across tools and engines. They are fundamental to achieving photorealistic and stylised visuals in real-time and offline 3D workflows."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:vertex-shader ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:compute-shader ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:pixel-shader ],
        ngm:rendering-technique ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:compute-shader,
        ngm:pixel-shader,
        ngm:vertex-shader ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:3-d-rendering,
        ngm:gltf-standard,
        ngm:open-usd,
        ngm:render-pipeline ;
    vc:slug "material-definition" ;
    vc:sourceDomain "graphics" ;
    vc:uses ngm:physically-based-rendering,
        ngm:shader,
        ngm:texture-mapping .

ngm:mathematical-reasoning a owl:Class ;
    rdfs:label "Mathematical Reasoning"@en ;
    rdfs:comment "Mathematical reasoning is the capacity of an AI system to perform multi-step symbolic manipulation, formal proof construction, and quantitative inference over structured mathematical problems including arithmetic, algebra, geometry, and theorem proving. It is considered a rigorous benchmark for general intelligence because correct solutions require compositional reasoning without shortcut pattern matching. Contemporary large language models exhibit emergent mathematical reasoning capabilities when combined with chain-of-thought prompting and tool use (e.g., code interpreters), though formal verification of proofs remains an open research challenge."@en ;
    rdfs:subClassOf ngm:ai-research-area ;
    skos:broader ngm:ai-research-area ;
    vc:dependsOn ngm:large-language-models ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:code-generation,
        ngm:formal-verification,
        ngm:reasoning ;
    vc:slug "mathematical-reasoning" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:chain-of-thought-reasoning,
        ngm:symbolic-ai .

ngm:mesh-data a owl:Class ;
    rdfs:label "Mesh Data"@en ;
    rdfs:comment "Mesh data is a structured representation of a three-dimensional surface or volume as a collection of vertices, edges, and polygonal faces — most commonly triangles or quads — that together define the geometry of a shape. It encodes both topological connectivity (which vertices form which faces) and geometric attributes (positions, normals, UV coordinates, vertex colours) required for rendering, simulation, and analysis. Mesh data serves as the primary interchange format between 3D modelling software, real-time engines, and spatial computing pipelines. It is produced by processes such as photogrammetry, structured-light scanning, LiDAR capture, and procedural generation."@en ;
    rdfs:subClassOf ngm:spatial-mesh ;
    vc:enables ngm:3-d-reconstruction,
        ngm:3-d-rendering,
        ngm:differentiable-rendering ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:computer-graphics,
        ngm:point-cloud,
        ngm:three-dimensional-graphics ;
    vc:slug "mesh-data" ;
    vc:sourceDomain "graphics" ;
    vc:uses ngm:photogrammetry,
        ngm:vertex-shader .

ngm:metadata-repository a owl:Class ;
    rdfs:label "Metadata Repository"@en ;
    rdfs:comment "Storage systems that centralise metadata from diverse data sources, providing unified access to technical, business, and operational metadata for data discovery, cataloguing, lineage tracking, and governance across enterprise environments."@en ;
    rdfs:subClassOf ngm:data-management,
        ngm:sc-standards-and-interop ;
    skos:broader ngm:sc-standards-and-interop ;
    vc:enables ngm:data-discovery ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:slug "metadata-repository" ;
    vc:sourceDomain "spatial-computing" .

ngm:metaverse-and-spatial-risks a owl:Class ;
    rdfs:label "Metaverse and Spatial Risks"@en ;
    rdfs:comment "Metaverse and Spatial Risks encompass the range of harms and hazards that arise specifically from spatially embodied, real-time virtual interactions — including harassment and abuse that mimics physical-world dynamics, miscommunication amplified by latency and avatar fidelity limitations, digital addiction, physical health impacts from prolonged immersive use, privacy violations through biometric data collection, and regulatory gaps as legislation lags behind technology deployment. These risks require multi-layered mitigation combining technical safeguards, governance frameworks, and international regulatory coordination."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:content-moderation ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:privacy ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:regulatory-framework ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:user-safety ],
        ngm:metaverse-governance-and-safeguarding,
        ngm:sc-governance-and-safety ;
    skos:broader ngm:sc-governance-and-safety ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:privacy,
        ngm:user-safety ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:relatedTo ngm:metaverse-liability-model,
        ngm:risk-management ;
    vc:requires ngm:content-moderation,
        ngm:regulatory-framework ;
    vc:slug "metaverse-and-spatial-risks" ;
    vc:sourceDomain "spatial-computing" .

ngm:metaverse-application a owl:Class ;
    rdfs:label "Metaverse Application"@en ;
    rdfs:comment "A software application designed to operate within or alongside a metaverse platform, providing users with persistent virtual experiences including social interaction, commerce, entertainment, education, and collaboration. Metaverse applications leverage real-time 3D rendering, avatar systems, spatial audio, and interoperability standards to deliver presence-rich, cross-platform functionality within shared virtual environments."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:metaverse-platform ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:avatar ],
        ngm:dc-telepresence ;
    skos:broader ngm:dc-telepresence ;
    vc:enables ngm:distributed-collaboration,
        ngm:virtual-collaboration ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:interoperability,
        ngm:metaverse-architecture ;
    vc:requires ngm:avatar,
        ngm:metaverse-platform ;
    vc:slug "metaverse-application" ;
    vc:sourceDomain "distributed-collaboration" ;
    vc:uses ngm:game-engine,
        ngm:spatial-audio .

ngm:middleware-layer a owl:Class ;
    rdfs:label "Middleware Layer"@en ;
    rdfs:comment "The MiddlewareLayer represents the abstraction level of integration components, orchestration systems, abstraction layers, API implementations, and coordination services that bridge between different system layers, domains, or components in blockchain and distributed systems."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
