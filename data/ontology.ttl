ngm:v-llm a owl:Class ;
    rdfs:label "vLLM"@en ;
    rdfs:comment "vLLM is an open-source library for high-throughput serving of large language models. It introduced paged attention, a memory management technique that reduces waste in the key-value cache during generation by managing attention KV cache in fixed-size blocks analogous to virtual memory paging."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gpu ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:kv-cache ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:large-language-models ],
        ngm:inference-serving ;
    vc:bridgesTo ngm:distributed-systems,
        ngm:infrastructure ;
    vc:contrastsWith ngm:triton-inference-server ;
    vc:dependsOn ngm:memory-management,
        ngm:transformer-architecture ;
    vc:enables ngm:continuous-batching,
        ngm:inference-serving,
        ngm:model-serving ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:openai-research-organisation-api,
        ngm:paged-attention ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:latency,
        ngm:natural-language-processing,
        ngm:quantisation,
        ngm:throughput ;
    vc:requires ngm:gpu,
        ngm:kv-cache,
        ngm:large-language-models ;
    vc:slug "v-llm" ;
    vc:sourceDomain "machine-learning" ;
    vc:supports ngm:speculative-decoding ;
    vc:uses ngm:cuda,
        ngm:python,
        ngm:tensor-parallelism .

