        ngm:ontology-engineering ;
    vc:requires ngm:data-quality-management,
        ngm:ontology-versioning,
        ngm:version-control ;
    vc:slug "knowledge-artefact-update-cycle" ;
    vc:sourceDomain "infrastructure" ;
