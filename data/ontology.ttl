ngm:protocol-stack a owl:Class ;
    rdfs:comment "A protocol stack is the layered set of network protocols that cooperate to provide communication services, where each layer offers services to the layer above and uses services of the layer below. Canonical examples are the OSI seven-layer model and the TCP/IP suite. Layering isolates concerns such as physical transmission, routing, transport reliability, and application semantics, enabling modular interoperable networking."@en ;
    rdfs:label "Protocol Stack"@en ;
    rdfs:subClassOf ngm:network-protocol ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:network-communication ;
    vc:relatedTo ngm:network-layer ;
    vc:slug "protocol-stack" ;
    vc:sourceDomain "infrastructure" .
ngm:protocol-standard a skos:Concept ;
    rdfs:label "Protocol Standard"@en .
ngm:protocol-sustainability a owl:Class ;
    rdfs:comment "Protocol sustainability is the capacity of a blockchain or DeFi protocol to remain economically viable, secure, and well-governed over the long term without relying on unsustainable token emissions or external subsidies. It depends on durable revenue, balanced tokenomics, treasury resilience, and active governance that can fund maintenance and development. It contrasts with growth models that depend on continuous inflationary incentives."@en ;
    rdfs:label "Protocol Sustainability"@en ;
    rdfs:subClassOf ngm:bc-defi-and-economics ;
    skos:broader ngm:bc-defi-and-economics ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:tokenomics-governance ;
    vc:relatedTo ngm:treasury-management ;
    vc:slug "protocol-sustainability" ;
    vc:sourceDomain "blockchain" .
