        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:congestion-control ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:network-protocol ],
        ngm:transport-layer ;
    vc:dependsOn ngm:packet-switching ;
    vc:enables ngm:communication-protocol,
        ngm:publish-subscribe-pattern,
        ngm:websocket ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:congestion-control,
        ngm:flow-control ;
    vc:implements ngm:transport-layer ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:networking ;
    vc:requires ngm:internet-protocol,
        ngm:network-protocol ;
    vc:slug "network-transport" ;
    vc:sourceDomain "distributed-systems" ;
