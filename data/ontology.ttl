    rdfs:comment "A body designated by an EU Member State under the AI Act — encompassing market surveillance authorities, notifying authorities, and data protection authorities — responsible for supervising provider and deployer compliance with the Act's requirements, enforcing penalties, and coordinating with the AI Office on cross-border and GPAI model matters."@en ;
    rdfs:subClassOf ngm:infra-legal-and-regulatory,
        ngm:regulatory-framework ;
    skos:broader ngm:infra-legal-and-regulatory ;
    vc:dependsOn ngm:accountability,
        ngm:transparency ;
