    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:gpu-compute,
        ngm:real-time-processing .

ngm:supply-chain-blockchain a owl:Class ;
    rdfs:label "Supply Chain Blockchain"@en ;
    rdfs:comment "Supply chain blockchain refers to the application of distributed ledger technology to track, trace, and verify the provenance of goods as they move through supply chain networks from raw materials to end consumers."@en ;
