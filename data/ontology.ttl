    a owl:Restriction ;
    owl:onProperty ngm:requires ;
    owl:someValuesFrom mv:TraversalAlgorithm
] .

mv:BoundingVolumeHierarchy rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:enables ;
    owl:someValuesFrom mv:RayTracing
] .

mv:BoundingVolumeHierarchy rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:enables ;
    owl:someValuesFrom mv:CollisionDetection
] .

mv:BoundingVolumeHierarchy rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:enables ;
    owl:someValuesFrom mv:FrustumCulling
] .

mv:BoundingVolumeHierarchy rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:relatedTo ;
    owl:someValuesFrom mv:KdTree
] .

mv:BoundingVolumeHierarchy rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:relatedTo ;
    owl:someValuesFrom mv:Octree
] .

