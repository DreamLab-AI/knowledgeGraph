    vc:uses ngm:figma,
        ngm:prototyping .

ngm:international-monetary-fund a owl:Class ;
    rdfs:label "International Monetary Fund"@en ;
    rdfs:comment "The International Monetary Fund (IMF) is an international financial institution, established at the 1944 Bretton Woods conference, whose mandate is to promote global monetary cooperation, exchange-rate stability, balanced trade and financial stability among its member countries. It provides macroeconomic surveillance, technical assistance and conditional lending to members facing balance-of-payments difficulties, and manages the Special Drawing Rights reserve asset. As a central pillar of the international monetary system, the IMF shapes monetary policy advice and crisis response worldwide."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:monetary-policy ],
        ngm:finance ;
    vc:bridgesTo ngm:governance ;
    vc:contrastsWith ngm:decentralized-finance ;
    vc:enables ngm:financial-stability ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:central-bank,
        ngm:fiat-currency,
        ngm:financial-stability ;
    vc:requires ngm:monetary-policy ;
    vc:slug "international-monetary-fund" ;
    vc:sourceDomain "finance" ;
    vc:standardizedBy ngm:monetary-policy ;
    vc:supports ngm:central-bank,
        ngm:fiat-currency ;
    vc:uses ngm:monetary-policy .

ngm:internet-connectivity a owl:Class ;
    rdfs:label "Internet Connectivity"@en ;
    rdfs:comment "Internet connectivity is the capability of a device or network to exchange data with the global Internet, established through physical or wireless access links and the protocol stack that routes packets between endpoints. It depends on addressing, name resolution, and routing infrastructure provided by access and transit providers. Connectivity is characterised by attributes such as bandwidth, latency, reliability, and reachability, all of which shape the performance of applications that rely on it."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:bandwidth ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:network-protocol ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:latency ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:tcp-ip ],
        ngm:network-connectivity ;
    vc:bridgesTo ngm:network-infrastructure ;
    vc:dependsOn ngm:dns,
        ngm:network-infrastructure ;
    vc:enables ngm:edge-computing ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:bandwidth,
        ngm:latency ;
    vc:implements ngm:network-protocol ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:bandwidth,
        ngm:dns,
        ngm:latency ;
    vc:requires ngm:network-protocol,
        ngm:tcp-ip ;
    vc:slug "internet-connectivity" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:edge-computing ;
    vc:uses ngm:tcp-ip .

ngm:intrinsic-interpretability a owl:Class ;
    rdfs:label "Intrinsic Interpretability"@en ;
    rdfs:comment "The inherent transparency and understandability of a machine learning model's architecture and decision-making process, achieved through model design rather than external explanation techniques, enabling direct human comprehension without additional interpretability methods."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:feature-engineering ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:regression ],
        [ a owl:Restriction ;
