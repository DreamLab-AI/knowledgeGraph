] .

mv:SpatialAnchors rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:relatedTo ;
    owl:someValuesFrom mv:AugmentedReality
] .

mv:SpatialAnchors rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:relatedTo ;
    owl:someValuesFrom mv:LocationBasedServices
] .

mv:SpatialAnchors rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:relatedTo ;
    owl:someValuesFrom mv:SLAM
] .

# Spatial Audio Processor
mv:SpatialAudioProcessor a owl:Class ;
    rdfs:subClassOf mv:AudioProcessingSystem ;
    rdfs:label "Spatial Audio Processor"@en ;
    rdfs:comment "Hardware or software component that renders three-dimensional sound using Head-Related Transfer Functions (HRTFs) and binaural synthesis, processing audio signals to simulate directional sound sources at specific positions in virtual space with real-time head tracking integration for immersive audio experiences."@en ;
    skos:prefLabel "Spatial Audio Processor"@en ;
    dcterms:identifier "MV-10052" ;
    dcterms:subject "mv" .

