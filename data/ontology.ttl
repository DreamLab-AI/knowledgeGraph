            owl:someValuesFrom ngm:smart-manufacturing ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:operational-technology ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:predictive-maintenance ],
        ngm:industrial-automation ;
    vc:bridgesTo ngm:industrial-metaverse,
        ngm:supply-chain-management ;
