    vc:requires ngm:actuators,
        ngm:sensors ;
    vc:slug "collaborative-robots" ;
    vc:sourceDomain "robotics" .

ngm:common-crawl a owl:Class ;
    rdfs:label "Common Crawl"@en ;
    rdfs:comment "Common Crawl is a non-profit organisation that maintains a large, freely available archive of web page data collected by crawling the internet. The data is widely used to train language models."@en ;
