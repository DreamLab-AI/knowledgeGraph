ngm:multithreading a owl:Class ;
    rdfs:label "Multithreading"@en ;
    rdfs:comment "Multithreading is a programming and execution model in which a single process contains multiple threads of execution that share the process's memory and resources while running concurrently. It enables responsiveness and parallel use of multiple CPU cores, but introduces the need for synchronisation to avoid race conditions and deadlocks. The operating system scheduler interleaves or parallelises threads, and shared mutable state must be coordinated with locks or other primitives."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:scheduler ],
        ngm:concurrency ;
    vc:contrastsWith ngm:message-passing ;
    vc:dependsOn ngm:concurrency,
        ngm:operating-system ;
    vc:enables ngm:parallel-computing,
        ngm:throughput ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:implements ngm:concurrency ;
    vc:isPartOf ngm:operating-system ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:latency,
        ngm:process,
        ngm:shared-memory ;
    vc:requires ngm:scheduler ;
    vc:slug "multithreading" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:parallel-computing,
        ngm:throughput ;
    vc:uses ngm:concurrency,
        ngm:operating-system,
        ngm:scheduler .

ngm:nat-traversal a owl:Class ;
    rdfs:label "NAT Traversal"@en ;
    rdfs:comment "NAT traversal is the set of techniques that let two devices behind Network Address Translation establish a direct connection despite the address rewriting and connection-tracking that NAT imposes. Methods such as hole punching, relaying and the coordination protocols STUN, TURN and ICE allow peers to discover routable endpoints and open paths through restrictive routers. NAT traversal is essential to peer-to-peer and decentralised networks where nodes behind home or corporate routers must reach one another without a central server."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:network-protocol ],
        ngm:peer-to-peer-network ;
    vc:dependsOn ngm:node ;
    vc:enables ngm:peer-to-peer-network,
        ngm:real-time-communication ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:distributed-systems ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:blockchain,
        ngm:full-node,
        ngm:network-protocol ;
    vc:requires ngm:network-protocol ;
    vc:slug "nat-traversal" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:blockchain-network,
        ngm:decentralization ;
    vc:uses ngm:gossip-protocol,
        ngm:overlay-network .

ngm:national-ai-strategy a owl:Class ;
    rdfs:label "National Ai Strategy"@en ;
    rdfs:comment "A national AI strategy is a government-led policy framework setting a country's vision, priorities and coordinated actions for developing, adopting and governing artificial intelligence. It typically addresses research and innovation funding, talent and skills, data and compute infrastructure, ethical and regulatory guardrails, public-sector adoption and economic competitiveness. Such strategies align ministries, industry and academia around shared objectives and measurable outcomes."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:regulation ],
        ngm:ai-policy ;
    vc:bridgesTo ngm:economic-development ;
    vc:dependsOn ngm:research-and-development ;
    vc:enables ngm:digital-transformation,
        ngm:economic-development ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:ai-policy ;
    vc:isPartOf ngm:digital-policy,
        ngm:public-policy ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:ai-governance,
        ngm:ai-regulation,
        ngm:data-sovereignty ;
    vc:requires ngm:regulation,
        ngm:technological-sovereignty ;
    vc:slug "national-ai-strategy" ;
    vc:sourceDomain "governance" ;
    vc:supports ngm:ai-governance,
        ngm:research-and-development .

ngm:ne-rf a owl:Class ;
    rdfs:label "NeRF"@en ;
    rdfs:comment "Neural Radiance Field (NeRF) is a neural scene representation technique that encodes a continuous volumetric scene as a multi-layer perceptron mapping 3D coordinates and viewing directions to colour and density values, enabling photorealistic novel view synthesis from a sparse set of calibrated input images. Introduced by Mildenhall et al. at ECCV 2020, NeRF employs volumetric ray marching and differentiable rendering to optimise network weights via photometric loss against held-out views, without requiring explicit mesh or voxel geometry. The technique catalysed a broad family of neural rendering methods spanning real-time variants, dynamic scenes, large-scale outdoor capture, and hybrid neural-explicit representations such as 3D Gaussian Splatting."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:multi-view-stereo ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:camera-calibration ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gpu-compute ],
        ngm:sc-display-and-rendering ;
    skos:broader ngm:sc-display-and-rendering ;
    vc:bridgesTo ngm:augmented-reality,
        ngm:diffusion-model,
        ngm:metaverse,
        ngm:navigation ;
    vc:contrastsWith ngm:3-d-gaussian-splatting,
        ngm:photogrammetry,
        ngm:point-cloud,
        ngm:polygon-mesh ;
    vc:enables ngm:3-d-reconstruction,
        ngm:digital-twin,
        ngm:novel-view-synthesis,
        ngm:photorealistic-rendering,
        ngm:scene-understanding ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:neural-rendering,
        ngm:structure-from-motion,
        ngm:volumetric-capture ;
    vc:requires ngm:camera-calibration,
        ngm:gpu-compute,
        ngm:multi-view-stereo ;
    vc:slug "ne-rf" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:deep-learning,
        ngm:differentiable-rendering,
        ngm:multilayer-perceptron,
        ngm:positional-encoding,
        ngm:ray-marching .

ngm:near-field-communication a owl:Class ;
    rdfs:label "Near Field Communication"@en ;
    rdfs:comment "Near Field Communication (NFC) is a short-range wireless communication technology operating at 13.56 MHz that enables contactless data exchange between devices within approximately 4 centimetres. Based on inductive coupling and derived from RFID standards, NFC supports three operating modes: card emulation (device acts as a smart card), reader/writer (device reads or writes NFC tags), and peer-to-peer (two active devices exchange data). It underpins contactless payments, identity verification, and rapid device pairing."@en ;
    rdfs:subClassOf ngm:communication-protocol ;
    vc:enables ngm:access-control-system,
        ngm:digital-payment-system,
        ngm:digital-payments ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:communication-interface,
        ngm:embedded-systems,
        ngm:io-t-sensor-network ;
    vc:slug "near-field-communication" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:hardware-security-module .

ngm:network-interface-card a owl:Class ;
    rdfs:label "Network Interface Card"@en ;
    rdfs:comment "A network interface card (NIC) is the hardware component that connects a computing device to a network and implements the physical and data-link layer functions for sending and receiving frames. It encodes outgoing data onto the transmission medium, decodes incoming signals, and carries a unique MAC address for link-layer addressing. Modern NICs often offload checksum, segmentation, and encryption work from the CPU."@en ;
    rdfs:subClassOf ngm:network-component ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:physical-layer ;
    vc:slug "network-interface-card" ;
    vc:sourceDomain "infrastructure" .

ngm:neuroscience a owl:Class ;
    rdfs:label "Neuroscience"@en ;
    rdfs:comment "Neuroscience is the scientific study of the nervous system, spanning the molecular, cellular, circuit, systems, and behavioural levels of how brains process information and generate behaviour. It investigates how neurons compute, communicate, and adapt, providing biological grounding for theories of cognition and learning. Neuroscience has a deep, bidirectional relationship with artificial intelligence, both inspiring computational models and using them to interpret neural data."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:perception ],
        ngm:cognitive-science ;
    vc:bridgesTo ngm:artificial-intelligence,
