    vc:slug "group-chat-channel" ;
    vc:sourceDomain "distributed-collaboration" .

ngm:hallucination-reduction a owl:Class ;
    rdfs:label "Hallucination Reduction"@en ;
    rdfs:comment "Hallucination reduction is the set of techniques used to decrease the rate at which large language models generate fluent but factually incorrect or unsupported output. Approaches include grounding generation in retrieved evidence, fact-checking against trusted sources, calibrated abstention, and fine-tuning for faithfulness. It is central to deploying generative AI in high-stakes domains where accuracy is critical."@en ;
    rdfs:subClassOf ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:ai-technique,
        ngm:retrieval-augmented-generation-rag ;
    vc:slug "hallucination-reduction" ;
    vc:sourceDomain "ai" .

ngm:hardware-design a skos:Concept ;
    rdfs:label "Hardware Design"@en .

ngm:harm-taxonomy a owl:Class ;
    rdfs:label "Harm Taxonomy"@en ;
    rdfs:comment "A harm taxonomy is a structured classification of the potential negative impacts arising from a technology, used to organise risk assessment and mitigation. In AI it categorises harms such as misinformation, discrimination, privacy violation, manipulation, and physical or economic damage. A clear taxonomy enables systematic red-teaming, policy mapping, and accountability for deployed systems."@en ;
    rdfs:subClassOf ngm:ai-governance-and-ethics ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
