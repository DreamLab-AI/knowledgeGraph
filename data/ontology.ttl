    vc:sourceDomain "governance" .

ngm:geographic-distribution a owl:Class ;
    rdfs:label "Geographic Distribution"@en ;
    rdfs:comment "Geographic distribution is the placement of computing resources, data, or services across physically separate locations and regions. In distributed systems it reduces latency for global users, improves fault tolerance against regional outages, and helps satisfy data-residency requirements. It introduces trade-offs around consistency, replication, and inter-region network costs."@en ;
    rdfs:subClassOf ngm:distributed-computing ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:distributed-architecture,
        ngm:geospatial-data ;
    vc:slug "geographic-distribution" ;
    vc:sourceDomain "infrastructure" .

ngm:geopolitics a owl:Class ;
    rdfs:label "Geopolitics"@en ;
    rdfs:comment "Geopolitics is the study and practice of how geography, resources, and national power shape relations and competition among states. In technology it frames how control over compute, semiconductors, data, and AI capability translates into strategic advantage and influences export controls, alliances, and standards-setting. It is a core lens for understanding international competition in AI."@en ;
    rdfs:subClassOf ngm:governance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:competition-in-ai ;
    vc:slug "geopolitics" ;
    vc:sourceDomain "governance" .

ngm:gfpgan a owl:Class ;
    rdfs:label "GFPGAN"@en ;
    rdfs:comment "GFPGAN (Generative Facial Prior GAN) is a practical deep-learning model for blind face restoration that leverages the rich facial priors encoded in a pretrained StyleGAN to recover realistic detail from degraded portraits. It restores resolution, removes artefacts, and reconstructs plausible facial features in a single forward pass. It is widely used in photo restoration and as a face-enhancement component in image and video pipelines."@en ;
    rdfs:subClassOf ngm:generative-model ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:face-swap,
        ngm:image-and-video-restoration ;
    vc:slug "gfpgan" ;
    vc:sourceDomain "ai" .

ngm:git-hub a owl:Class ;
    rdfs:label "GitHub"@en ;
    rdfs:comment "GitHub is a web platform for hosting Git repositories, providing version control, code review, issue tracking, and collaboration features. It is owned by Microsoft."@en ;
