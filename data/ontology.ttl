ngm:greedy-decoding a owl:Class ;
    rdfs:label "Greedy Decoding"@en ;
    rdfs:comment "Greedy Decoding is a sequence generation strategy that, at each step of an autoregressive model, selects the single token with the highest predicted probability. It is the simplest decoding method, fully deterministic and computationally cheap, but it can be myopic and miss globally higher-probability sequences. It serves as the baseline against which beam search and sampling-based strategies are compared."@en ;
    rdfs:subClassOf ngm:text-generation ;
    vc:bridgesTo ngm:text-generation ;
    vc:contrastsWith ngm:beam-search,
