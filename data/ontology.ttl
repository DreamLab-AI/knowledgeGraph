ngm:knowledge-graph a owl:Class ;
    rdfs:label "Knowledge Graph"@en ;
    rdfs:comment "A semantic knowledge network that represents entities, relationships, and attributes as an interconnected graph structure, enabling advanced reasoning, inference, and knowledge discovery across metaverse systems."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:graph-database ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:inference-engine ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ontology ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:triple-store ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:relationship-edge ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:schema-definition ],
        ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:enables ngm:knowledge-discovery,
        ngm:question-answering,
        ngm:reasoning,
        ngm:recommendation-system,
        ngm:semantic-search ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:inference-engine,
        ngm:relationship-edge ;
    vc:isPartOf ngm:knowledge-management-system,
        ngm:semantic-web-linked-data-standard-infrastructure ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:graph-database,
        ngm:ontology,
        ngm:schema-definition,
        ngm:triple-store ;
    vc:slug "knowledge-graph" ;
    vc:sourceDomain "spatial-computing" .

ngm:network-protocol a owl:Class ;
    rdfs:label "Network Protocol"@en ;
    rdfs:comment "A network protocol is a set of established rules that specify how to format, send, and receive data between networked devices, enabling diverse communication systems to interact using standard procedures. Protocols are organized into layered architectures (OSI, TCP/IP) and govern addressing, routing, error detection, session management, and application-layer services."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:protocol-stack ],
        ngm:infra-network-and-comms ;
    skos:broader ngm:infra-network-and-comms ;
    vc:bridgesTo ngm:cryptographic-protocol,
        ngm:distributed-collaboration ;
    vc:contrastsWith ngm:proprietary-protocol ;
    vc:dependsOn ngm:network-infrastructure,
        ngm:physical-layer ;
    vc:enables ngm:distributed-computing,
        ngm:internet-connectivity,
        ngm:interoperability,
        ngm:network-communication ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:protocol-stack ;
    vc:implements ngm:osi-model,
        ngm:tcp-ip-model ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:bandwidth,
        ngm:latency ;
    vc:requires ngm:network-addressing ;
    vc:slug "network-protocol" ;
    vc:sourceDomain "infrastructure" ;
    vc:standardizedBy ngm:ieee,
        ngm:ietf,
        ngm:iso ;
    vc:supports ngm:network-security,
        ngm:quality-of-service ;
    vc:uses ngm:flow-control,
        ngm:packet-switching,
        ngm:routing-algorithm .

ngm:ai-governance a owl:Class ;
    rdfs:label "AI Governance"@en ;
    rdfs:comment "AI Governance encompasses the policies, frameworks, standards, and institutional mechanisms for overseeing the responsible development, deployment, and use of artificial intelligence technologies, including regulatory compliance, organisational accountability structures, risk-based assessment, algorithmic transparency requirements, and stakeholder engagement processes that balance innovation with societal protection."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:regulatory-compliance ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:human-oversight ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:ai-ethics-board ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:algorithmic-accountability ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:ai-audit ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:transparency ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:ai-impact-assessment ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ai-ethics ],
        ngm:governance-framework ;
    vc:bridgesTo ngm:decentralised-autonomous-organisation,
        ngm:smart-contract ;
    vc:dependsOn ngm:data-governance,
        ngm:risk-management ;
    vc:enables ngm:responsible-ai,
        ngm:trustworthy-ai ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:ai-audit,
        ngm:ai-ethics-board,
        ngm:ai-impact-assessment,
        ngm:algorithmic-accountability ;
    vc:implements ngm:eu-ai-act-regulatory-instrument,
        ngm:nist-ai-rmf ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:bias-mitigation-techniques,
        ngm:explainable-ai,
        ngm:gdpr ;
    vc:requires ngm:ai-ethics,
        ngm:human-oversight,
        ngm:regulatory-compliance,
        ngm:transparency ;
    vc:slug "ai-governance" ;
    vc:sourceDomain "governance" ;
    vc:standardizedBy ngm:iso-iec-42001,
        ngm:oecd-ai-principles ;
    vc:supports ngm:ai-alignment,
        ngm:ai-safety,
        ngm:digital-rights .

