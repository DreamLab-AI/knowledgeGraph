ngm:block-validation a owl:Class ;
    rdfs:label "Block Validation"@en ;
    rdfs:comment "Block Validation is the process by which a blockchain node verifies that a candidate block satisfies all protocol rules before accepting it into the chain. It checks the proof-of-work or consensus proof, the block header structure, the Merkle root, and the validity of every contained transaction including signatures, double-spend constraints, and balances. Successful validation is the precondition for extending the canonical chain and is central to trustless consensus."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:proof-of-work ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:block-header ],
        ngm:consensus-mechanism ;
    vc:bridgesTo ngm:distributed-ledger ;
    vc:dependsOn ngm:consensus-mechanism ;
    vc:enables ngm:consensus-mechanism,
        ngm:transaction-validation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:blockchain ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:byzantine-fault-tolerance,
        ngm:full-node,
        ngm:transaction-validation ;
    vc:requires ngm:block-header,
        ngm:proof-of-work ;
    vc:slug "block-validation" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:full-node ;
    vc:uses ngm:digital-signature,
        ngm:hash-function,
        ngm:merkle-tree .

ngm:board-level-oversight a owl:Class ;
    rdfs:label "Board-Level Oversight"@en ;
    rdfs:comment "Board-Level Oversight refers to the governance responsibility of a corporate or institutional board of directors to monitor, evaluate, and guide the organisation's strategic direction, risk appetite, executive conduct, and compliance posture. It encompasses the board's duty to act as an informed check on executive management, reviewing material risks—including operational, financial, legal, reputational, and increasingly technology risks such as AI adoption—on behalf of shareholders and other stakeholders."@en ;
    rdfs:subClassOf ngm:governance ;
    vc:enables ngm:accountability,
        ngm:transparency ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:boardroom,
        ngm:compliance,
        ngm:governance-framework ;
    vc:slug "board-level-oversight" ;
    vc:sourceDomain "governance" ;
    vc:uses ngm:audit,
        ngm:risk-management .

ngm:bridge a owl:Class ;
    rdfs:label "Bridge"@en ;
    rdfs:comment "A protocol that transfers assets or messages between separate ledgers by locking, burning, or attesting value on one chain and reproducing a representation on another."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:lock-and-mint-mechanism ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:validator-set ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:relayer ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:smart-contract ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:oracle ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptographic-proof ],
        ngm:blockchain-interoperability ;
    vc:bridgesTo ngm:cross-chain-bridge,
        ngm:interoperability-protocol ;
    vc:contrastsWith ngm:atomic-swap,
        ngm:rollup ;
    vc:dependsOn ngm:consensus-mechanism,
        ngm:finality ;
    vc:enables ngm:cross-chain-asset-transfer,
        ngm:cross-chain-messaging,
        ngm:decentralised-finance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:lock-and-mint-mechanism,
        ngm:relayer ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:trusted-bridge,
        ngm:trustless-bridge ;
    vc:requires ngm:cryptographic-proof,
        ngm:oracle,
        ngm:smart-contract,
        ngm:validator-set ;
    vc:slug "bridge" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:decentralised-exchange,
        ngm:liquidity-pool ;
    vc:uses ngm:hash-time-locked-contract,
        ngm:multi-signature,
        ngm:zero-knowledge-proof .

ngm:broadband-connectivity a owl:Class ;
    rdfs:label "Broadband Connectivity"@en ;
    rdfs:comment "Broadband Connectivity is high-capacity, always-on access to the internet delivered over fixed or wireless infrastructure such as fibre, cable, DSL, or cellular networks, characterised by data rates substantially higher than legacy dial-up. It provides the underlying transport for digital services, remote work, streaming, cloud applications, and the Internet of Things. Universal broadband is treated as essential infrastructure, and disparities in its availability constitute the digital divide. Its delivery depends on telecommunications infrastructure, network protocols, and last-mile access technologies."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:network-protocol ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:routing-protocol ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:ip-addressing ],
        ngm:network-infrastructure ;
    vc:contrastsWith ngm:digital-divide ;
    vc:dependsOn ngm:network-infrastructure,
        ngm:telecommunications ;
    vc:enables ngm:edge-computing,
        ngm:internet-of-things,
        ngm:smart-city ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:ip-addressing,
        ngm:routing-protocol ;
    vc:isPartOf ngm:network-infrastructure ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:dns ;
    vc:requires ngm:network-protocol ;
    vc:slug "broadband-connectivity" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:digital-infrastructure,
        ngm:urban-computing ;
    vc:uses ngm:internet-protocol,
        ngm:packet-switching,
        ngm:tcp-ip .

ngm:business-logic-layer a owl:Class ;
    rdfs:label "Business Logic Layer"@en ;
    rdfs:comment "The Business Logic Layer (BLL) is the architectural tier in a multi-tier application that encapsulates domain rules, workflows, and computations specific to the problem domain, sitting between the presentation layer and the data access layer. It is responsible for validating inputs, enforcing business constraints, orchestrating data transformations, and coordinating service calls, ensuring that domain invariants are maintained independently of user interface or persistence concerns."@en ;
    rdfs:subClassOf ngm:service-layer ;
    vc:dependsOn ngm:data-layer ;
    vc:enables ngm:workflow-automation ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:microservices-architecture,
        ngm:service-oriented-architecture ;
    vc:slug "business-logic-layer" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:application-layer ;
    vc:uses ngm:middleware .

ngm:business-rules-engine a owl:Class ;
    rdfs:label "Business Rules Engine"@en ;
    rdfs:comment "A Business Rules Engine (BRE) is a software component that externalises and executes business logic as declarative rules separate from application code. Rules are authored by domain experts in natural-language-like syntax and evaluated against facts at runtime using algorithms such as the Rete network. BREs enable non-technical stakeholders to modify organisational policies without redeploying software, making them a key enabler of agile governance and compliance automation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:inference-engine ],
        ngm:governance ;
    vc:bridgesTo ngm:ai-decision-system ;
    vc:contrastsWith ngm:hardcoded-logic,
        ngm:machine-learning ;
    vc:dependsOn ngm:knowledge-representation,
        ngm:reasoning-engine ;
    vc:enables ngm:compliance-automation,
        ngm:decision-management,
        ngm:policy-enforcement ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:fact-model,
        ngm:inference-engine,
        ngm:rule-repository ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:ai-governance,
        ngm:smart-contract,
        ngm:workflow-automation ;
    vc:slug "business-rules-engine" ;
    vc:sourceDomain "governance" ;
    vc:standardizedBy ngm:dmn,
        ngm:drools ;
    vc:supports ngm:regulatory-compliance,
        ngm:risk-management ;
    vc:uses ngm:decision-table,
        ngm:rete-algorithm .

ngm:c4-model a owl:Class ;
    rdfs:label "C4 Model"@en ;
    rdfs:comment "The C4 Model is a hierarchical software architecture notation system developed by Simon Brown that uses four abstraction levels — Context, Containers, Components, and Code — to describe and communicate the structure of a software system at progressively increasing levels of technical detail. Each level targets a different audience, from non-technical stakeholders at the Context level to developers at the Code level, using a minimal, tool-agnostic set of diagram elements that are easy to reason about and keep up to date."@en ;
    rdfs:subClassOf ngm:software-architecture ;
    vc:enables ngm:documentation-generation,
        ngm:documentation-standards ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:enterprise-architecture ;
    vc:slug "c4-model" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:diagrams-as-code,
        ngm:structurizr-dsl .

ngm:calibration-standards a owl:Class ;
    rdfs:label "Calibration Standards"@en ;
    rdfs:comment "Documented specifications and reference materials that establish measurement accuracy requirements, traceability to national standards, and systematic procedures for aligning sensors, displays, and imaging systems to known reference values in XR and computer vision applications."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:traceability ],
        ngm:sc-standards-and-interop ;
    skos:broader ngm:sc-standards-and-interop ;
    vc:bridgesTo ngm:technical-standard ;
    vc:enables ngm:accuracy,
        ngm:quality-assurance ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires ngm:traceability ;
    vc:slug "calibration-standards" ;
    vc:sourceDomain "spatial-computing" .

ngm:camera-model a owl:Class ;
    rdfs:label "Camera Model"@en ;
    rdfs:comment "A camera model is a mathematical description that maps three-dimensional scene points to two-dimensional image coordinates, capturing the geometry of how a camera projects the world. It encodes intrinsic parameters such as focal length and principal point alongside extrinsic parameters describing pose, and may model lens distortion. Camera models underpin calibration, reconstruction and pose estimation in computer vision and spatial computing."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:camera-calibration ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:linear-algebra ],
        ngm:computer-vision ;
    vc:dependsOn ngm:linear-algebra ;
    vc:enables ngm:depth-estimation,
        ngm:pose-estimation,
        ngm:structure-from-motion ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:computer-vision ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:computer-vision,
        ngm:photogrammetry,
        ngm:stereo-vision ;
    vc:requires ngm:camera-calibration,
        ngm:linear-algebra ;
    vc:slug "camera-model" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:augmented-reality,
        ngm:slam ;
    vc:uses ngm:photogrammetry .

ngm:camera-sensor a owl:Class ;
    rdfs:label "Camera Sensor"@en ;
    rdfs:comment "A camera sensor is the photosensitive component, typically a CMOS or CCD array, that converts incident light focused by the optics into an electrical signal forming an image. Its characteristics, including resolution, pixel size, dynamic range, noise and frame rate, determine the quality of the captured imagery and shutter behaviour. It is the primary exteroceptive vision input for robots, autonomous vehicles and immersive devices, and is frequently fused with complementary sensors such as lidar."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:image-sensor ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:camera-calibration ],
        ngm:sensor ;
    vc:bridgesTo ngm:sensor-fusion ;
    vc:contrastsWith ngm:lidar ;
    vc:enables ngm:computer-vision,
        ngm:perception,
        ngm:visual-perception ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:camera ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:sensor,
        ngm:stereo-camera ;
    vc:requires ngm:camera-calibration,
        ngm:image-sensor ;
    vc:slug "camera-sensor" ;
    vc:sourceDomain "robotics" ;
    vc:supports ngm:hand-tracking,
        ngm:object-detection ;
    vc:uses ngm:image-processing .

ngm:capability-advertisement a skos:Concept ;
    rdfs:label "Capability Advertisement"@en .

ngm:capability-elicitation a owl:Class ;
    rdfs:label "Capability Elicitation"@en ;
    rdfs:comment "Capability elicitation is the systematic process of designing prompts, scaffolding, and evaluation protocols to uncover the true maximum performance of an AI model on a given task or domain, distinguishing what a model is genuinely capable of from what it demonstrates under default conditions. It is a central concern in AI safety research and frontier model evaluation because models may possess latent capabilities — such as the ability to reason about dangerous knowledge, produce deceptive outputs, or autonomously pursue goals — that are not revealed by standard benchmarks but can be surfaced through carefully constructed elicitation methods including chain-of-thought prompting, multi-step scaffolding, and adversarial jailbreaking."@en ;
    rdfs:subClassOf ngm:model-evaluation ;
    vc:enables ngm:model-evaluation-results,
        ngm:safety-assessment ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:ai-safety,
        ngm:alignment,
        ngm:safety-evaluation ;
    vc:slug "capability-elicitation" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:red-teaming .

ngm:capital-efficiency a owl:Class ;
    rdfs:label "Capital Efficiency"@en ;
    rdfs:comment "Capital efficiency is the degree to which deployed capital is put to productive use to generate returns or provide a service, maximising output per unit of locked or committed funds. In decentralised finance it describes designs such as concentrated liquidity and over-collateralisation tuning that let liquidity providers and protocols achieve more depth or yield from less capital. Higher capital efficiency reduces idle assets and lowers the cost of providing liquidity and credit."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:liquidity ],
        ngm:decentralised-finance ;
    vc:bridgesTo ngm:market-microstructure ;
    vc:contrastsWith ngm:risk-management ;
    vc:dependsOn ngm:liquidity-pool ;
    vc:enables ngm:liquidity,
        ngm:liquidity-pool ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:decentralised-finance ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:collateral,
        ngm:decentralised-finance,
        ngm:liquidity,
        ngm:risk-management ;
    vc:requires ngm:collateral,
        ngm:liquidity ;
    vc:slug "capital-efficiency" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:market-maker,
        ngm:trade-execution ;
    vc:uses ngm:decentralized-exchange .

ngm:cbor a owl:Class ;
    rdfs:label "CBOR"@en ;
    rdfs:comment "Concise Binary Object Representation (CBOR) is a binary data serialisation format specified in RFC 7049 (superseded by RFC 8949) designed to enable extremely compact encoding of structured data with a data model that is a superset of JSON. CBOR encodes values using a type-length-value scheme, eliminating the overhead of textual delimiters and key quotation, which makes it particularly well-suited for constrained environments such as IoT devices, embedded systems, and low-bandwidth protocols where minimising message size and parsing complexity is critical."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:internet-of-things ],
        ngm:data-serialization ;
    vc:bridgesTo ngm:hardware-security-module,
        ngm:linked-data ;
    vc:enables ngm:credential-format-standard,
        ngm:embedded-systems,
        ngm:remote-attestation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:cose,
        ngm:deterministic-encoding ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:data-format-standard,
        ngm:json-data-interchange-format,
        ngm:messagepack,
        ngm:protocol-buffer ;
    vc:requires ngm:internet-of-things ;
    vc:slug "cbor" ;
    vc:sourceDomain "infrastructure" ;
    vc:standardizedBy ngm:internet-engineering-task-force,
        ngm:iso-iec-18013-5-m-dl ;
    vc:supports ngm:decentralised-identity,
        ngm:verifiable-credentials ;
    vc:uses ngm:binary-encoding .

ngm:celestia a owl:Class ;
    rdfs:label "Celestia"@en ;
    rdfs:comment "Celestia is a modular blockchain network that decouples data availability from execution and consensus, functioning as a dedicated data availability layer that rollups and sovereign chains can use to publish and order transaction data without requiring a monolithic execution environment. It employs data availability sampling (DAS) via erasure coding so that light nodes can probabilistically verify that block data has been published without downloading it in full, enabling Celestia nodes to scale with the number of light clients rather than validators. Celestia introduced the concept of sovereign rollups, in which chains publish data to Celestia for ordering and availability whilst handling their own execution and settlement independently."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:byzantine-fault-tolerance ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:light-node ],
        ngm:data-availability ;
    vc:bridgesTo ngm:distributed-systems,
        ngm:peer-to-peer-network ;
    vc:contrastsWith ngm:ethereum,
        ngm:monolithic-blockchain ;
    vc:enables ngm:blockchain-scalability,
        ngm:layer-2-scaling,
        ngm:modular-blockchain ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:implements ngm:blob-transaction,
        ngm:data-availability-sampling ;
    vc:isPartOf ngm:cosmos ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:avail,
        ngm:cosmos,
        ngm:danksharding,
        ngm:proto-danksharding ;
    vc:requires ngm:byzantine-fault-tolerance,
        ngm:light-node ;
    vc:slug "celestia" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:consensus-mechanism,
        ngm:erasure-coding,
        ngm:inter-blockchain-communication,
        ngm:reed-solomon-erasure-coding,
        ngm:tendermint-consensus .

ngm:change-data-capture a owl:Class ;
    rdfs:label "Change Data Capture"@en ;
    rdfs:comment "Change data capture is a set of techniques for identifying and propagating row-level changes — inserts, updates, and deletes — from a source database to downstream systems in near real time. The most robust approach reads the database transaction log, turning committed mutations into an ordered stream of change events without burdening the source with polling. It underpins data replication, event streaming, and incremental data integration, keeping analytical stores, caches, and microservices consistent with operational systems."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:event-streaming ],
        ngm:data-integration ;
    vc:bridgesTo ngm:stream-processing ;
    vc:dependsOn ngm:database ;
    vc:enables ngm:data-replication,
        ngm:event-sourcing,
        ngm:stream-processing ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:event-streaming ;
    vc:isPartOf ngm:data-integration ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:data-lake,
        ngm:data-warehouse ;
    vc:slug "change-data-capture" ;
    vc:sourceDomain "data" ;
    vc:supports ngm:data-pipeline,
        ngm:microservices ;
    vc:uses ngm:apache-kafka,
        ngm:database,
        ngm:event-streaming .

ngm:classical-planning a owl:Class ;
    rdfs:label "Classical Planning"@en ;
    rdfs:comment "Classical planning is a branch of automated planning that computes a sequence of deterministic actions transforming a fully observable initial state into a state satisfying a goal condition. It assumes a single agent, discrete states, instantaneous actions with deterministic effects, and complete knowledge of the world. Problems are typically expressed in formalisms such as STRIPS or PDDL and solved by heuristic state-space search."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:heuristic-search ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:constraint-satisfaction ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:search-algorithm ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:strips ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:pddl ],
        ngm:automated-planning ;
    vc:contrastsWith ngm:markov-decision-process,
        ngm:reactive-planning,
        ngm:reinforcement-learning ;
    vc:enables ngm:agent,
        ngm:autonomous-system,
        ngm:multi-agent-coordination,
        ngm:robotics,
        ngm:task-automation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:heuristic-search,
        ngm:pddl,
        ngm:state-space-search,
        ngm:strips ;
    vc:isPartOf ngm:artificial-intelligence,
        ngm:automated-planning ;
    vc:qualityScore "0.92"^^xsd:float ;
    vc:relatedTo ngm:artificial-intelligence,
        ngm:hierarchical-task-network,
        ngm:large-language-models,
        ngm:optimisation,
        ngm:pathfinding,
        ngm:temporal-planning ;
    vc:requires ngm:constraint-satisfaction,
        ngm:search-algorithm ;
    vc:slug "classical-planning" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:game-playing,
        ngm:logistics-optimisation,
        ngm:motion-planning ;
    vc:uses ngm:formal-logic,
        ngm:graph-search,
        ngm:knowledge-representation,
        ngm:sat-solving .

ngm:climate-scenario-analysis a skos:Concept ;
    rdfs:label "Climate Scenario Analysis"@en .

ngm:cloth-simulation a owl:Class ;
    rdfs:label "Cloth Simulation"@en ;
    rdfs:comment "Cloth Simulation is the computational modelling of textile deformation and dynamics, representing fabric as a mesh of particles connected by spring constraints (stretch, shear, and bend) or by a continuum-mechanics model, and integrating the equations of motion to produce plausible cloth behaviour under gravity, wind, collision, and user interaction. The particle-spring model, popularised by Provot (1995), remains prevalent in real-time applications; more accurate results for offline rendering use finite-element or position-based dynamics (PBD) methods. Collision detection and response against rigid bodies and self-collision are the principal computational bottlenecks, requiring spatial acceleration structures such as bounding volume hierarchies. Cloth simulation is a sub-discipline of physically based animation used in character clothing, flag animation, curtains, and virtual fashion design within game engines, VFX pipelines, and metaverse avatar systems."@en ;
    rdfs:subClassOf ngm:physics-simulation ;
    vc:enables ngm:dynamic-character-animation,
        ngm:real-time-rendering ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:particle-system,
        ngm:rigid-body,
        ngm:soft-body-dynamics ;
    vc:slug "cloth-simulation" ;
    vc:sourceDomain "metaverse" ;
    vc:supports ngm:game-development,
        ngm:simulation-software ;
    vc:uses ngm:animation-technique,
        ngm:physics-engine .

ngm:cognitive-psychology a owl:Class ;
    rdfs:label "Cognitive Psychology"@en ;
    rdfs:comment "Cognitive psychology is the scientific discipline that investigates the internal mental processes underlying intelligent behaviour, including perception, attention, memory, language, problem-solving, reasoning, and decision-making, treating the mind as an information-processing system and using controlled experiments, computational models, and neuroimaging to reveal its representations and operations."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:perception ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:computational-modelling ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:attention-mechanism ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:neuroscience ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:working-memory ],
        ngm:cognitive-science,
        ngm:psychology ;
    vc:contrastsWith ngm:behaviourism,
        ngm:connectionism,
        ngm:psychoanalysis ;
    vc:enables ngm:behavioural-economics,
        ngm:explainable-ai,
        ngm:human-computer-interaction,
        ngm:intelligent-tutoring-system,
        ngm:user-experience-design ;
    vc:hasMaturity ngmi:maturity-established ;
