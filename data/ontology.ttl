ngm:state-space-control a owl:Class ;
    rdfs:label "State Space Control"@en ;
    rdfs:comment "State Space Control is a modern control theory framework that describes dynamic systems as a set of first-order differential equations over an internal state vector, enabling full-state feedback design via techniques such as pole placement, LQR, and model predictive control. Unlike classical frequency-domain methods, state-space representations directly support multi-input multi-output systems, observer design, and optimal control synthesis, making them foundational for robotic and aerospace applications."@en ;
    rdfs:subClassOf ngm:feedback-control,
        ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:enables ngm:autonomous-robot,
        ngm:motion-planning,
        ngm:multirotor-uav ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:state-space-sequence-models ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:adaptive-control,
        ngm:control-system,
        ngm:control-theory,
        ngm:pid-control ;
    vc:slug "state-space-control" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:kalman-filter,
        ngm:optimal-control .

ngm:state-space-models a owl:Class ;
    rdfs:label "State Space Models"@en ;
    rdfs:comment "State space models are sequence models that maintain a hidden state evolving over time according to linear dynamics, used as an alternative to attention for long sequences. Recent deep learning variants make the dynamics input-dependent to capture context."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:neural-network ],
        ngm:state-space-model ;
