        ngm:tamper-evidence ;
    vc:requires ngm:consensus-mechanism,
        ngm:cryptographic-commitment,
        ngm:distributed-ledger-technology ;
    vc:slug "immutability" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:regulatory-compliance,
        ngm:supply-chain-integrity ;
    vc:uses ngm:byzantine-fault-tolerance,
        ngm:cryptographic-hash-function,
        ngm:digital-signature,
        ngm:merkle-tree .

ngm:inference-hardware a owl:Class ;
    rdfs:label "Inference Hardware"@en ;
    rdfs:comment "Specialized processors, accelerators, and system-on-chip designs optimized for running trained machine learning models in production, prioritizing low latency, energy efficiency, high throughput, and cost-effectiveness across data centers, edge devices, and embedded systems."@en ;
