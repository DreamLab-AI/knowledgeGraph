    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:alerting,
        ngm:distributed-tracing,
        ngm:log-management,
        ngm:metrics-collection ;
    vc:isPartOf ngm:observability ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:chaos-engineering,
        ngm:kubernetes,
        ngm:service-mesh ;
    vc:requires ngm:instrumentation,
        ngm:time-series-database ;
    vc:slug "monitoring" ;
    vc:sourceDomain "infrastructure" ;
    vc:standardizedBy ngm:cloud-native-computing-foundation,
