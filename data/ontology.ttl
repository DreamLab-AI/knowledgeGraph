        ngm:immersive-experience ;
    vc:slug "sc-content-and-assets" ;
    vc:sourceDomain "spatial-computing" .

ngm:digital-twin a owl:Class ;
    rdfs:label "Digital Twin"@en ;
    rdfs:comment "Digital Twin is a spatial computing concept and a type of Digital Twin Technology. that enables Collaborative Design, Process Optimisation. comprising Control Interface, IoT Sensor Data."@en ;
