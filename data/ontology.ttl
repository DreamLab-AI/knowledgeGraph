ngm:nvidia-corporation-isaac-sim a owl:Class ;
    rdfs:label "NVIDIA Isaac Sim"@en ;
    rdfs:comment "NVIDIA Isaac Sim is a robotics simulation application built on the Omniverse platform for designing, testing, and training robots in virtual environments. It is developed by NVIDIA."@en ;
