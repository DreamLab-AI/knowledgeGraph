    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:information-extraction,
        ngm:knowledge-base-completion ;
    vc:requires ngm:data-integration,
        ngm:schema-mapping ;
    vc:slug "knowledge-graph-construction" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:standardizedBy ngm:owl,
        ngm:rdf ;
