    vc:dependsOn ngm:dotnet,
        ngm:mono ;
    vc:enables ngm:augmented-reality,
        ngm:interactive-simulation,
        ngm:mixed-reality,
        ngm:virtual-reality ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:animation-system,
        ngm:asset-store,
