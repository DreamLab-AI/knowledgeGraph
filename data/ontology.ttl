ngm:ethereum-smart-contract-platform-name-service a owl:Class ;
    rdfs:label "Ethereum Name Service"@en ;
    rdfs:comment "The Ethereum Name Service (ENS) is a decentralised, open-source naming protocol deployed on Ethereum that maps human-readable names (e.g. 'alice.eth') to machine-readable identifiers including wallet addresses, content hashes, and arbitrary metadata stored on-chain. It operates through a hierarchy of smart contracts — a central registry recording ownership and resolver assignments, and resolver contracts that translate names to resources according to standardised ERC specifications. ENS names are minted as ERC-721 non-fungible tokens, granting cryptographic ownership without reliance on a centralised registrar, and extending DNS-compatible reverse resolution so on-chain addresses can be presented as readable identities. The protocol has become the dominant blockchain naming infrastructure on Ethereum, with millions of registered names and integrations across wallets, browsers, and decentralised applications."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:smart-contract ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ethereum ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:non-fungible-token ],
        ngm:bc-network-component ;
    skos:broader ngm:bc-network-component ;
    vc:bridgesTo ngm:self-sovereign-identity,
        ngm:verifiable-credential-vc ;
    vc:contrastsWith ngm:domain-name-system,
        ngm:unstoppable-domains ;
    vc:enables ngm:decentralised-application,
        ngm:decentralised-identity,
        ngm:web3-wallet ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:erc-137,
        ngm:erc-721 ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:decentralised-autonomous-organisation,
        ngm:decentralised-identifier,
        ngm:ethereum-improvement-proposal,
        ngm:ipfs ;
    vc:requires ngm:ethereum,
        ngm:non-fungible-token,
        ngm:smart-contract ;
    vc:slug "ethereum-name-service" ;
    vc:sourceDomain "blockchain" ;
    vc:standardizedBy ngm:ethereum-smart-contract-platform-foundation ;
    vc:uses ngm:public-key-cryptography .

