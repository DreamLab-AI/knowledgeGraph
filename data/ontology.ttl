    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:artificial-intelligence,
        ngm:cognitive-architecture ;
    vc:slug "cognitive-science" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:machine-learning .

ngm:coinbase-transaction a owl:Class ;
    rdfs:label "Coinbase Transaction"@en ;
    rdfs:comment "The first transaction in every blockchain block, created by the miner or block producer, that contains no inputs and issues the block reward plus accumulated transaction fees to the miner's address. Unlike regular transactions, the coinbase transaction has no sender; it creates new coins from protocol-defined issuance rules and serves as the primary mechanism by which new cryptocurrency enters circulation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:consensus-mechanism ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:transaction-fee ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:mining ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:block-reward ],
        ngm:bc-protocol-and-consensus,
        ngm:blockchain-entity,
        ngm:consensus-protocol ;
    skos:broader ngm:bc-protocol-and-consensus ;
    vc:enables ngm:cryptocurrency,
        ngm:mining-reward ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:block-reward,
        ngm:transaction-fee ;
    vc:isPartOf ngm:blockchain-network,
        ngm:blockchain-transaction ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:blockchain-protocol,
        ngm:proof-of-work ;
    vc:requires ngm:consensus-mechanism,
        ngm:mining ;
    vc:slug "coinbase-transaction" ;
    vc:sourceDomain "blockchain" .

ngm:collective-decision-making a owl:Class ;
    rdfs:label "Collective Decision Making"@en ;
    rdfs:comment "Collective decision making is the social and technical process by which a group of agents — human, algorithmic, or hybrid — aggregate individual preferences, information, or votes to arrive at a binding or advisory choice on behalf of the group. It encompasses the design and analysis of voting systems, preference aggregation mechanisms, deliberation protocols, and incentive structures that determine how group choices are reached and enforced. In digital and blockchain contexts, collective decision making is formalised through on-chain governance mechanisms, decentralised autonomous organisations, and algorithmic voting schemes that encode group agency in smart contract logic."@en ;
    rdfs:subClassOf ngm:decentralised-decision-making ;
    vc:enables ngm:community-governance,
        ngm:dao-governance,
        ngm:on-chain-governance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:collective-intelligence-system,
        ngm:governance-token ;
    vc:slug "collective-decision-making" ;
    vc:sourceDomain "governance" ;
    vc:uses ngm:conviction-voting,
        ngm:quadratic-voting,
        ngm:token-weighted-voting,
        ngm:voting-mechanism .

