ngm:native-token a owl:Class ;
    rdfs:label "Native Token"@en ;
    rdfs:comment "A Native Token is the primary cryptocurrency issued and managed directly by a blockchain protocol, used to pay transaction fees, reward validators or miners, and serve as the base unit of value within the network's economic system. Unlike tokens created via smart contracts, native tokens are settled at the protocol layer and are intrinsic to chain operation."@en ;
    rdfs:subClassOf ngm:bc-token-and-asset,
        ngm:blockchain-entity,
        ngm:economic-mechanism ;
    skos:broader ngm:bc-token-and-asset ;
    vc:contrastsWith ngm:erc20-token ;
    vc:enables ngm:mining-reward,
        ngm:tokenomics,
        ngm:transaction-fee ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:blockchain ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:deflationary-token,
        ngm:governance-token,
        ngm:inflationary-token,
        ngm:supply-cap,
        ngm:token-economics ;
    vc:slug "native-token" ;
    vc:sourceDomain "blockchain" .

ngm:network-synchronization a owl:Class ;
    rdfs:label "Network Synchronization"@en ;
    rdfs:comment "Network Synchronization is the process by which blockchain nodes align their local chain state with the canonical ledger through block propagation, header-first sync, and fork resolution protocols. It governs initial block download, peer discovery, and the ongoing receipt of new blocks and transactions via gossip, ensuring all honest participants converge on an identical view of the distributed ledger despite network partitions and latency."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gossip-protocol ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:peer-to-peer-network ],
        ngm:bc-protocol-and-consensus,
        ngm:blockchain-entity,
        ngm:consensus-protocol ;
    skos:broader ngm:bc-protocol-and-consensus ;
    vc:enables ngm:byzantine-fault-tolerance,
        ngm:consensus-mechanism ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:block-propagation,
        ngm:distributed-data-structure,
        ngm:eclipse-attack,
        ngm:network-topology,
        ngm:transaction-pool ;
    vc:requires ngm:gossip-protocol,
        ngm:peer-to-peer-network ;
    vc:slug "network-synchronization" ;
    vc:sourceDomain "blockchain" .

ngm:nft-ownership-proof a owl:Class ;
    rdfs:label "NFT Ownership Proof"@en ;
    rdfs:comment "Cryptographic mechanism by which blockchain state verifiably establishes that a specific wallet address holds title to a non-fungible token, enabling trustless transfer of digital asset ownership without intermediaries, underpinning digital rights management, access control, and provenance verification in NFT ecosystems."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:blockchain ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:consensus-mechanism ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:token-standard ],
        ngm:bc-token-and-asset ;
    skos:broader ngm:bc-token-and-asset ;
    vc:bridgesTo ngm:digital-identity,
        ngm:metaverse ;
    vc:contrastsWith ngm:fungible-token ;
    vc:dependsOn ngm:distributed-ledger,
        ngm:public-key-infrastructure ;
    vc:enables ngm:access-control,
        ngm:digital-asset,
        ngm:provenance-tracking ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:erc-1155,
        ngm:erc-721 ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:digital-rights-management,
        ngm:nft-marketplace,
        ngm:non-fungible-token-nft,
        ngm:royalty-distribution ;
    vc:requires ngm:blockchain,
        ngm:consensus-mechanism,
        ngm:token-standard ;
    vc:slug "nft-ownership-proof" ;
    vc:sourceDomain "blockchain" ;
    vc:standardizedBy ngm:ethereum-improvement-proposal ;
    vc:uses ngm:cryptographic-verification,
        ngm:digital-signature,
        ngm:merkle-tree,
        ngm:public-key,
        ngm:smart-contract,
        ngm:wallet-address .

ngm:nft-standard a owl:Class ;
    rdfs:label "NFT Standard"@en ;
    rdfs:comment "An NFT Standard is a formally specified interface and data schema that defines how non-fungible tokens are created, transferred, and queried on a blockchain network, ensuring interoperability across wallets, marketplaces, and decentralised applications. Dominant examples include ERC-721 (Ethereum, unique single tokens), ERC-1155 (multi-token standard combining fungible and non-fungible types in one contract), and EIP-2981 (royalty standard). These specifications are ratified through Ethereum Improvement Proposals or analogous governance processes on other chains, and they collectively establish the canonical interface any compliant smart contract must expose."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:token-metadata ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:blockchain ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:eip-2981 ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:decentralised-storage ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:erc-721 ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:erc-1155 ],
        ngm:bc-token-and-asset ;
    skos:broader ngm:bc-token-and-asset ;
    vc:bridgesTo ngm:digital-twin,
        ngm:metaverse,
        ngm:provenance-tracking ;
    vc:contrastsWith ngm:erc-20,
        ngm:fungible-token ;
    vc:dependsOn ngm:ethereum,
        ngm:ipfs,
        ngm:solidity ;
    vc:enables ngm:digital-ownership,
        ngm:nft-marketplace,
        ngm:non-fungible-token ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:eip-2981,
        ngm:erc-1155,
        ngm:erc-721,
        ngm:token-metadata ;
    vc:implements ngm:ethereum-improvement-proposal,
        ngm:smart-contract ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:decentralised-finance,
        ngm:token-standard,
        ngm:web3 ;
    vc:requires ngm:blockchain,
        ngm:decentralised-storage ;
    vc:slug "nft-standard" ;
    vc:sourceDomain "blockchain" ;
    vc:standardizedBy ngm:ethereum-smart-contract-platform-foundation ;
    vc:supports ngm:digital-art,
        ngm:tokenised-real-world-assets .

ngm:non-fungible-token-nft a owl:Class ;
    rdfs:label "Non-Fungible Token (NFT)"@en ;
    rdfs:comment "A digital asset recorded on a distributed ledger that is uniquely identifiable and non-interchangeable, representing ownership or rights to specific digital or physical items."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
