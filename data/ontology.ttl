ngm:flp-impossibility a owl:Class ;
    rdfs:label "FLP Impossibility"@en ;
    rdfs:comment "The FLP Impossibility (Fischer, Lynch, Paterson 1985) is a foundational theorem in distributed computing proving that no deterministic protocol can solve the [[Consensus]] problem in a fully asynchronous message-passing system if even one process may crash. The result arises because message delays are unbounded, making it impossible to distinguish a crashed process from a slow one, so any protocol that always terminates can be manipulated into a state of permanent indecision. Consequently, every practical [[Consensus Algorithm]] must relax at least one of the FLP assumptions — typically by introducing partial synchrony, randomisation, or probabilistic termination."@en ;
    rdfs:subClassOf ngm:distributed-consensus ;
    vc:bridgesTo ngm:blockchain-consensus,
        ngm:smart-contract-execution ;
    vc:contrastsWith ngm:cap-theorem ;
    vc:enables ngm:partial-synchrony ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:isPartOf ngm:computability-theory,
        ngm:distributed-systems-theory ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:byzantine-fault-tolerance,
        ngm:distributed-ledger,
        ngm:paxos,
        ngm:raft-consensus,
        ngm:state-machine-replication,
        ngm:two-phase-commit ;
    vc:slug "flp-impossibility" ;
    vc:sourceDomain "distributed-systems" ;
    vc:uses ngm:formal-proof .

ngm:fluid-power-device a owl:Class ;
    rdfs:label "Fluid Power Device"@en ;
    rdfs:comment "A fluid power device is a component that transmits or controls power through a pressurised fluid, either an incompressible liquid (hydraulic) or a compressible gas (pneumatic). Such devices convert fluid pressure and flow into mechanical motion and force, or regulate that flow, and include actuators, valves, pumps, and compressors. They are valued in robotics and industrial automation for high force-to-weight ratios and robust operation."@en ;
    rdfs:subClassOf ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:pneumatic-actuator,
        ngm:proportional-valve ;
    vc:slug "fluid-power-device" ;
    vc:sourceDomain "robotics" .

