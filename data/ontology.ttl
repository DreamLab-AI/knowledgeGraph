        ngm:storage-infrastructure ;
    vc:slug "reality-capture-system" ;
    vc:sourceDomain "spatial-computing" .

ngm:realtime-collaboration a owl:Class ;
    rdfs:label "Realtime Collaboration"@en ;
    rdfs:comment "Realtime Collaboration is the capability for multiple geographically distributed users to co-create, co-edit, and synchronise shared digital artefacts—documents, 3D scenes, code, or virtual environments—with sub-second latency, such that all participants observe consistent state simultaneously. Technically, it requires low-latency networking, conflict-resolution mechanisms such as CRDTs or operational transforms, and state-synchronisation protocols to reconcile concurrent edits without data loss."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:multi-user-systems ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:crdt ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:network-latency ],
        ngm:infra-network-and-comms ;
    skos:broader ngm:infra-network-and-comms ;
    vc:enables ngm:distributed-collaboration,
        ngm:immersive-workspaces,
        ngm:virtual-meeting ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:metaverse-and-telecollaboration,
        ngm:social-presence ;
    vc:requires ngm:crdt,
        ngm:multi-user-systems,
        ngm:network-latency ;
    vc:slug "realtime-collaboration" ;
    vc:sourceDomain "infrastructure" .

ngm:reference-architecture a owl:Class ;
    rdfs:label "Reference Architecture"@en ;
    rdfs:comment "A standardized architectural template that provides proven structural frameworks and design patterns for building scalable, resilient enterprise applications, establishing shared vocabulary and best practices across development teams."@en ;
    rdfs:subClassOf ngm:sc-platform-and-environment,
        ngm:software-architecture ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:enables ngm:scalable-systems ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:slug "reference-architecture" ;
    vc:sourceDomain "spatial-computing" .

ngm:regulatory-requirements a owl:Class ;
    rdfs:label "Regulatory Requirements"@en ;
    rdfs:comment "Regulatory requirements are the obligations imposed on entities by laws, regulations and supervisory rules that they must meet to operate lawfully."@en ;
    rdfs:subClassOf ngm:regulation ;
    vc:enables ngm:compliance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:slug "regulatory-requirements" ;
    vc:sourceDomain "governance" .

ngm:regulatory-standards a owl:Class ;
    rdfs:label "Regulatory Standards"@en ;
    rdfs:comment "Legal and compliance frameworks governing metaverse and extended reality platforms, including data protection (GDPR), artificial intelligence (EU AI Act), digital services (DSA), and accessibility requirements that ensure user rights protection in immersive environments."@en ;
    rdfs:subClassOf ngm:sc-standards-and-interop ;
    skos:broader ngm:sc-standards-and-interop ;
    vc:enables ngm:user-protection ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:implements ngm:compliance-framework ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:slug "regulatory-standards" ;
    vc:sourceDomain "spatial-computing" .

ngm:research-methods a owl:Class ;
    rdfs:label "Research Methods"@en ;
    rdfs:comment "Research Methods are the systematic procedures and techniques used to collect, analyse, and interpret data in order to generate reliable knowledge. They encompass qualitative approaches (interviews, ethnography), quantitative approaches (controlled experiments, statistical analysis), and mixed-methods designs, with evaluation benchmarks and user studies being particularly relevant to AI and spatial computing research."@en ;
    rdfs:subClassOf ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:enables ngm:evaluation-benchmarks-and-leaderboards ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:relatedTo ngm:ai-research-area,
        ngm:clinical-trials,
        ngm:data-augmentation-strategies ;
    vc:slug "research-methods" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:user-research .

ngm:responsible-scaling-policy a owl:Class ;
    rdfs:label "Responsible Scaling Policy"@en ;
    rdfs:comment "A Responsible Scaling Policy (RSP) is a voluntary safety commitment by frontier AI developers that specifies: the capability thresholds at which enhanced safety evaluations must be conducted before further scaling or deployment; the specific risk criteria (particularly around biological, chemical, nuclear, and cyberweapon uplift) that would trigger deployment restrictions; and the technical and organisational safeguards required at each capability level. RSPs translate high-level safety intentions into concrete, falsifiable commitments, creating accountability mechanisms analogous to a self-imposed regulatory framework operating ahead of formal government regulation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:risk-assessment ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:red-teaming ],
        ngm:ai-governance-and-ethics ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:ai-governance-framework,
        ngm:ai-safety,
        ngm:frontier-model-forum ;
    vc:requires ngm:red-teaming,
        ngm:risk-assessment ;
    vc:slug "responsible-scaling-policy" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:ai-alignment .

ngm:revocation-mechanism a owl:Class ;
    rdfs:label "Revocation Mechanism"@en ;
    rdfs:comment "A revocation mechanism is a cryptographic or registry-based procedure for invalidating a previously issued credential, certificate, or access token before its natural expiry, allowing issuers to withdraw trust following compromise, policy change, or holder misconduct. In digital identity systems, revocation mechanisms range from Certificate Revocation Lists and OCSP for X.509 certificates to Bitstring Status Lists and cryptographic accumulators for verifiable credentials. The privacy characteristics and scalability of each approach differ substantially, making mechanism selection a critical design decision."@en ;
    rdfs:subClassOf ngm:cryptographic-infrastructure ;
    vc:enables ngm:decentralized-identity-did,
        ngm:self-sovereign-identity-ssi ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:certificate-authority,
        ngm:credential-definition ;
    vc:slug "revocation-mechanism" ;
    vc:sourceDomain "security" ;
    vc:uses ngm:bitstring-status-list,
        ngm:cryptographic-accumulator,
        ngm:verifiable-credentials .

ngm:robot-hardware a owl:Class ;
    rdfs:label "Robot Hardware"@en ;
    rdfs:comment "RobotHardware is the integrated electromechanical substrate of robotic systems encompassing all physical components required for autonomous or semi-autonomous operation: compute platforms (NVIDIA Jetson Orin NX/AGX, Raspberry Pi 5, BeagleBone AI-64), real-time microcontrollers (STM32H7, Teensy 4...."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:actuator ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:real-time-operating-system ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:motor-driver ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:battery-management-system ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:sensor-suite ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ros-2 ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ether-cat ],
        ngm:mobile-robot-platform,
        ngm:robo-actuation-and-control,
        ngm:robotics-platform ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:enables ngm:autonomous-operation,
        ngm:kinematics-model,
        ngm:motion-control,
        ngm:navigation,
        ngm:proprioceptive-sensor,
        ngm:robot-perception,
        ngm:teleoperation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:actuator,
        ngm:battery-management-system,
        ngm:communication-bus,
        ngm:embedded-controller,
        ngm:motor-driver,
        ngm:power-distribution-board,
        ngm:sensor-suite,
        ngm:wiring-harness ;
    vc:implements ngm:can-fd-protocol,
        ngm:dds-middleware,
        ngm:ether-cat-protocol,
        ngm:micro-ros,
        ngm:ros2-control-framework,
        ngm:urdf-hardware-description ;
    vc:qualityScore "0.52"^^xsd:float ;
    vc:relatedTo ngm:edge-computing,
        ngm:hardware-and-edge,
        ngm:model-based-control,
        ngm:nvidia-omniverse,
        ngm:predictive-maintenance ;
    vc:requires ngm:can-fd-bus,
        ngm:ether-cat,
        ngm:imu-sensor,
        ngm:li-po-battery,
        ngm:motor-encoder,
        ngm:real-time-operating-system,
        ngm:ros-2 ;
    vc:slug "robot-hardware" ;
    vc:sourceDomain "robotics" ;
    vc:standardizedBy ngm:ci-a-301-canopen-standard,
        ngm:ether-cat-technology-group,
        ngm:iec-61800-drives-standard,
        ngm:iso-10218-robot-safety,
        ngm:ros-2-reps ;
    vc:supports ngm:exoskeleton,
        ngm:ground-robot,
        ngm:hydraulic-actuator,
        ngm:industrial-robot,
        ngm:mobile-robot-platform,
        ngm:surgical-robot ;
    vc:uses ngm:arm-cortex-m,
        ngm:ethernet-switch,
        ngm:fpga-acceleration,
        ngm:nvidia-jetson,
        ngm:stm32-microcontroller .

ngm:robot-link a owl:Class ;
    rdfs:label "RobotLink"@en ;
    rdfs:comment "A rigid mechanical structural component in a robotic manipulator or kinematic chain that connects two consecutive joints and transmits motion and forces between them, characterized by fixed geometric and inertial properties including length, mass, center of mass location, and inertia tensor, desc..."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:mounting-interface ],
        ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:enables ngm:force-transmission,
        ngm:kinematic-chain,
        ngm:motion-propagation,
        ngm:payload-support,
        ngm:workspace-reach ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:inertial-frame,
        ngm:link-geometry,
        ngm:mass-properties,
        ngm:material-composition,
        ngm:mounting-interface,
        ngm:surface-finish ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires ngm:dynamic-balancing,
        ngm:material-selection,
        ngm:structural-analysis,
        ngm:thermal-management,
        ngm:vibration-damping ;
    vc:slug "robot-link" ;
    vc:sourceDomain "robotics" .

ngm:robot-perception a owl:Class ;
    rdfs:label "Robot Perception"@en ;
    rdfs:comment "Robot perception is the process by which a robot interprets sensor data to build an understanding of its environment and state."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:sensors ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:sensor-fusion ],
        ngm:robotics ;
    skos:broader ngm:robotics ;
    vc:enables ngm:slam ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:sensor-fusion,
        ngm:sensors ;
    vc:slug "robot-perception" ;
    vc:sourceDomain "robotics" .

ngm:ros-navigation-stack a owl:Class ;
    rdfs:label "ROS Navigation Stack"@en ;
    rdfs:comment "The ROS Navigation Stack is a collection of software packages within the Robot Operating System (ROS) framework that provides a robot with the capability to move autonomously through an environment by combining map building, localisation, global path planning, local obstacle avoidance, and motor control into an integrated pipeline. It abstracts sensor inputs (laser scan, odometry, IMU), maintains a 2D occupancy grid map and cost layers, runs AMCL (Adaptive Monte Carlo Localisation) for pose estimation, and uses A* or Dijkstra for global plans combined with DWA (Dynamic Window Approach) or TEB (Timed Elastic Band) for local reactive navigation. The Navigation Stack is the de facto standard for mobile ground-robot navigation in research and production robotics."@en ;
    rdfs:subClassOf ngm:robot-operating-system ;
    vc:enables ngm:autonomous-robot,
        ngm:obstacle-avoidance,
        ngm:path-planning ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:autonomous-navigation,
        ngm:gazebo-simulator,
        ngm:ros-2 ;
    vc:slug "ros-navigation-stack" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:lidar,
        ngm:localisation,
        ngm:sensor-fusion .

ngm:safety-function a owl:Class ;
    rdfs:label "Safety Function"@en ;
    rdfs:comment "A safety function is a function implemented by a control system or safeguard whose failure results in an immediate increase of risk to people, equipment, or the environment. In robotics and machine safety, examples include emergency stop, speed and separation monitoring, and safe torque off. Safety functions are specified, designed, and validated to meet a required performance level so that residual risk remains tolerable."@en ;
    rdfs:subClassOf ngm:robo-safety-and-standards ;
    skos:broader ngm:robo-safety-and-standards ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:robot-standard,
        ngm:safety-integrity-level ;
    vc:slug "safety-function" ;
    vc:sourceDomain "robotics" .

ngm:safety-system a owl:Class ;
    rdfs:label "Safety System"@en ;
    rdfs:comment "A safety system is an engineered arrangement of hardware, software, and procedural controls designed to prevent, detect, and mitigate hazards in industrial, transport, robotic, or cyber-physical environments, ensuring that a process or machine reaches a safe state when faults or dangerous conditions are detected. Safety systems are defined by their Safety Integrity Level (SIL) or Performance Level (PL) ratings under standards such as IEC 61508 and ISO 26262, which quantify the required probability of failure on demand. They encompass emergency shutdown systems, safety PLCs, watchdog timers, interlocks, redundant sensors, and AI-based anomaly detection."@en ;
    rdfs:subClassOf ngm:control-system ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:functional-safety,
        ngm:iec-61508,
        ngm:iso-26262 ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:autonomous-vehicle,
        ngm:real-time-operating-system,
        ngm:robot-safety,
        ngm:safety-measure ;
    vc:slug "safety-system" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:embedded-systems,
        ngm:monitoring-system,
        ngm:safety-plc .

ngm:scara-robot a owl:Class ;
    rdfs:label "SCARA Robot"@en ;
    rdfs:comment "Selective Compliance Articulated Robot Arm — a four-axis industrial robot with two rotary joints in the horizontal plane that give high compliance laterally whilst providing rigid vertical stiffness along the Z-axis. SCARA robots excel at high-speed pick-and-place, assembly, and packaging tasks that require precise horizontal positioning but resist vertical forces."@en ;
    rdfs:subClassOf ngm:industrial-robot,
        ngm:robo-robot-type ;
    skos:broader ngm:robo-robot-type ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:robo-actuation-and-control ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:collaborative-robot,
        ngm:delta-robot,
        ngm:forward-kinematics,
        ngm:inverse-kinematics,
        ngm:motion-control,
        ngm:trajectory-planning ;
    vc:slug "scara-robot" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:encoder,
        ngm:pid-control,
        ngm:servo-motor .

ngm:schema-org a owl:Class ;
    rdfs:label "Schema.org"@en ;
    rdfs:comment "Schema.org is a collaborative, community-maintained vocabulary project founded in 2011 by Google, Microsoft, Yahoo, and Yandex to define a shared set of structured data markup schemas for web pages, enabling search engines and other consumers to understand the semantic content of web resources. The vocabulary defines types and properties for entities such as persons, organisations, events, products, reviews, and creative works, expressed using JSON-LD, Microdata, or RDFa. Schema.org markup embedded in web pages allows search engines to generate rich snippets, knowledge panels, and structured results. The vocabulary is extensible and hosted at schema.org, with governance managed by a W3C community group."@en ;
    rdfs:subClassOf ngm:linked-data ;
    vc:enables ngm:knowledge-graph,
        ngm:semantic-web ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:data-annotation,
        ngm:ontology,
        ngm:search-engine ;
    vc:slug "schema-org" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:controlled-vocabulary,
        ngm:json-ld,
        ngm:rdf .

ngm:scientific-computing a owl:Class ;
    rdfs:label "Scientific Computing"@en ;
    rdfs:comment "Scientific computing is the discipline concerned with the development and application of computational methods and software to solve mathematical and scientific problems that are analytically intractable or whose scale demands automation. It encompasses numerical analysis, algorithm design, software engineering for high-performance systems, and the management of large-scale simulation workflows. Key application domains include climate modelling, computational fluid dynamics, molecular dynamics, finite element analysis, and astronomical simulation. Scientific computing increasingly overlaps with machine learning as data-driven models augment or replace first-principles simulations."@en ;
    rdfs:subClassOf ngm:high-performance-computing ;
    vc:enables ngm:fluid-simulation,
        ngm:physics-simulation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:computational-resources,
        ngm:distributed-computing,
        ngm:gpu-computing,
        ngm:simulation ;
    vc:slug "scientific-computing" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:cuda,
        ngm:simulation-engine .

ngm:script a owl:Class ;
    rdfs:label "Script"@en ;
    rdfs:comment "Bitcoin's stack-based, non-Turing-complete scripting language used to encode spending conditions on transaction outputs and to provide the corresponding unlocking data in transaction inputs. Script programs define locking and unlocking conditions—such as pay-to-public-key-hash—that a validator executes to authorise fund transfer, making transaction validation a programmable process without full smart-contract complexity."@en ;
    rdfs:subClassOf ngm:bc-protocol-and-consensus,
        ngm:blockchain-entity ;
    skos:broader ngm:bc-protocol-and-consensus ;
    vc:enables ngm:smart-contract,
        ngm:transaction-processing ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:blockchain-transaction,
        ngm:digital-signature,
        ngm:transaction-fee,
        ngm:transaction-pool ;
    vc:slug "script" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:opcodes,
        ngm:transaction,
        ngm:utxo-model .

ngm:sd-jwt a owl:Class ;
    rdfs:label "SD-JWT"@en ;
    rdfs:comment "SD-JWT (Selective Disclosure JSON Web Token) is an IETF-specified extension to the JSON Web Token standard that allows an Issuer to create a signed token containing hashed claim values, from which the Holder can selectively reveal only the specific claims needed for a given presentation — without exposing other claims or enabling correlation across presentations. The mechanism uses SHA-256 salted disclosure objects appended to the base JWT; verifiers can validate revealed disclosures against the issuer signature whilst remaining blind to undisclosed claims. SD-JWT forms the primary credential format for the European Union's eIDAS 2.0 digital identity wallet system."@en ;
    rdfs:subClassOf ngm:selective-disclosure ;
    vc:enables ngm:credential-verification,
        ngm:privacy-preserving-identity ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:credential-format-standard,
        ngm:open-id4-vci,
        ngm:zero-knowledge-proof ;
    vc:slug "sd-jwt" ;
    vc:sourceDomain "governance" ;
    vc:uses ngm:cryptographic-proof,
        ngm:json-web-token,
        ngm:verifiable-credentials .

ngm:secure-communication a owl:Class ;
    rdfs:label "Secure Communication"@en ;
    rdfs:comment "Secure communication is the practice and set of technologies that protect the confidentiality, integrity, and authenticity of information exchanged between parties over potentially adversarial networks, ensuring that eavesdroppers cannot read message content, tamperers cannot alter it undetected, and impersonators cannot forge the identity of legitimate participants. The discipline encompasses transport-layer security protocols (TLS, DTLS, QUIC with TLS), end-to-end encryption protocols (Signal Protocol, MLS, Matrix), secure messaging standards (S/MIME, PGP), VPN tunnelling (IPsec, WireGuard), and the cryptographic primitives—asymmetric key exchange, symmetric cipher suites, authenticated encryption, and digital signatures—that underpin them. Security properties are formally analysed through cryptographic protocol proofs and verified implementations."@en ;
    rdfs:subClassOf ngm:cryptographic-protocol ;
    vc:enables ngm:confidential-computing,
        ngm:privacy ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:cryptographic-security,
        ngm:network-security,
        ngm:tls-encryption ;
    vc:slug "secure-communication" ;
    vc:sourceDomain "security" ;
    vc:uses ngm:cryptographic-key-management,
        ngm:digital-signature,
        ngm:encryption,
        ngm:tls .

ngm:securities-settlement a owl:Class ;
    rdfs:label "Securities Settlement"@en ;
    rdfs:comment "Securities settlement is the process by which the buyer of a security receives the asset and the seller receives payment, completing a trade through the final transfer of legal ownership and funds between counterparties, typically via a central securities depository (CSD) or clearing house. Traditional settlement occurs on a T+1 or T+2 basis after trade execution, involves complex chains of custodians, CSDs, and central counterparty clearing houses (CCPs), and carries counterparty risk during the settlement window. Distributed ledger technology and tokenised securities are driving a shift toward atomic and real-time settlement."@en ;
    rdfs:subClassOf ngm:financial-system ;
    vc:enables ngm:digital-asset-trading,
        ngm:trustless-settlement ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:atomic-settlement,
        ngm:instant-value-settlement,
        ngm:securities-regulation ;
    vc:slug "securities-settlement" ;
    vc:sourceDomain "finance" ;
    vc:uses ngm:digital-asset-infrastructure,
        ngm:financial-infrastructure .

ngm:seg-wit a owl:Class ;
    rdfs:label "SegWit"@en ;
    rdfs:comment "Segregated Witness is a Bitcoin protocol upgrade that moves signature data into a separate witness structure, fixing transaction malleability and increasing block capacity."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:bitcoin-script ],
        ngm:bitcoin-protocol ;
    vc:enables ngm:lightning-network,
        ngm:taproot ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:bitcoin-script ;
    vc:slug "seg-wit" ;
    vc:sourceDomain "blockchain" .

ngm:sensor-calibration a owl:Class ;
    rdfs:label "Sensor Calibration"@en ;
    rdfs:comment "Sensor calibration is the process of determining and correcting systematic measurement errors in sensing devices by comparing their outputs against known reference values or through geometric constraint solving, yielding intrinsic parameter models and extrinsic transformation matrices that map raw sensor readings to physically meaningful quantities. It is a prerequisite for sensor fusion, perception pipelines, and any application requiring quantitatively accurate environmental measurements."@en ;
    rdfs:subClassOf ngm:calibration ;
    vc:enables ngm:localization,
        ngm:sensor-fusion,
        ngm:slam ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:camera-calibration,
        ngm:imu,
        ngm:lidar ;
    vc:slug "sensor-calibration" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:calibration-target,
        ngm:camera-intrinsics,
        ngm:coordinate-transformation .

ngm:sensors a owl:Class ;
    rdfs:label "Sensors"@en ;
    rdfs:comment "Sensors are devices that measure physical quantities and convert them into signals a robot or system can process, providing the perceptual input for estimation, control and decision making."@en ;
    rdfs:subClassOf ngm:robotics-domain ;
    vc:enables ngm:perception-system,
        ngm:sensor-fusion ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:slug "sensors" ;
    vc:sourceDomain "robotics" .

ngm:series-elastic-actuator a owl:Class ;
    rdfs:label "Series Elastic Actuator"@en ;
    rdfs:comment "A Series Elastic Actuator (SEA) is a robotic joint mechanism that interposes a compliant spring element in series between the gearbox output and the load, deliberately introducing controlled elasticity into the drivetrain. By measuring the spring deflection with a position sensor, the SEA provides accurate, low-noise torque measurement without a dedicated force-torque sensor, while simultaneously providing passive mechanical compliance that absorbs impact energy and reduces stiffness at the point of contact. This architecture enables safe, backdrivable interactions between robots and humans or unstructured environments."@en ;
    rdfs:subClassOf ngm:robot-actuator ;
    vc:enables ngm:human-robot-interaction,
        ngm:soft-robotics ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:force-control,
        ngm:impedance-control,
        ngm:series-elastic-actuation,
        ngm:variable-impedance-control ;
    vc:slug "series-elastic-actuator" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:position-sensor,
        ngm:torque-control .

ngm:service-mesh a owl:Class ;
    rdfs:label "Service Mesh"@en ;
    rdfs:comment "A service mesh is a dedicated infrastructure layer for managing service-to-service communication within a microservices architecture, providing traffic management, mutual TLS encryption, observability, and policy enforcement transparently to application code through sidecar proxies or eBPF-based data planes. It decouples operational concerns—load balancing, retries, circuit breaking, telemetry—from business logic, enabling consistent reliability and security across heterogeneous services."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:service-discovery ],
        ngm:microservices-architecture ;
    vc:enables ngm:observability ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
