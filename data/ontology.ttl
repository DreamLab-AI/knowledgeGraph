ngm:fieldbus a owl:Class ;
    rdfs:comment "Fieldbus is the family of digital, serial, multi-drop communication protocols — standardised in IEC 61158 and including PROFIBUS, FOUNDATION Fieldbus, Modbus, CAN-based networks, and DeviceNet — that connect field devices such as sensors, actuators, and drives to programmable logic controllers and distributed control systems. Introduced from the mid-1980s to replace point-to-point 4–20 mA and RS-232 wiring, a single shared cable carries deterministic cyclic process data and device diagnostics, cutting cabling cost and enabling intelligent field instruments."@en ;
    rdfs:label "Fieldbus"@en ;
    rdfs:subClassOf ngm:communication-protocol ;
