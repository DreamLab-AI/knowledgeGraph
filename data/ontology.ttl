    vc:relatedTo ngm:computational-holography,
        ngm:holography,
        ngm:integral-imaging,
        ngm:neural-radiance-fields,
        ngm:plenoptic-camera,
        ngm:spatial-computing ;
    vc:requires ngm:camera-calibration,
        ngm:gpu-compute,
        ngm:lens-and-camera-calibration,
        ngm:multi-view-geometry,
        ngm:ray-parameterisation,
        ngm:sampling-theory ;
    vc:slug "light-field" ;
    vc:sourceDomain "spatial-computing" ;
    vc:standardizedBy ngm:acm-tog,
        ngm:cvpr,
        ngm:iccv,
        ngm:ieee-tvcg,
        ngm:siggraph ;
