ngm:sanctions-enforcement a owl:Class ;
    rdfs:label "Sanctions Enforcement"@en ;
    rdfs:comment "Sanctions enforcement is the regulatory and operational process by which financial institutions, governments, and technology platforms identify, screen, and block transactions, assets, and relationships involving sanctioned individuals, entities, or jurisdictions as designated by authorities such as OFAC, the UN Security Council, the European Union, or HM Treasury. It encompasses real-time screening of payment flows against consolidated sanctions lists, asset-freezing procedures, reporting obligations, and the maintenance of audit trails demonstrating compliance. In digital asset and blockchain contexts, sanctions enforcement extends to on-chain transaction monitoring and the blocking of wallet addresses associated with designated parties."@en ;
    rdfs:subClassOf ngm:compliance-framework ;
    vc:enables ngm:aml-kyc-compliance,
        ngm:compliance-audit-trail ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:anti-money-laundering,
        ngm:fatf,
        ngm:sanctions-screening ;
    vc:slug "sanctions-enforcement" ;
    vc:sourceDomain "governance" ;
    vc:supports ngm:financial-regulation ;
    vc:uses ngm:blockchain-analytics,
        ngm:regulatory-reporting .

ngm:scene-management a owl:Class ;
    rdfs:label "Scene Management"@en ;
    rdfs:comment "Scene Management encompasses the runtime systems and data structures responsible for organising, loading, and unloading 3D scene content in real-time environments. It coordinates scene graph traversal, hierarchical object relationships, asset streaming, and spatial partitioning to ensure that only geometrically and logically relevant content is active at any moment, enabling scalable and performant virtual worlds."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:ar-scene-graph ],
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:enables ngm:occlusion-culling,
        ngm:scene-optimization ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:ar-scene-graph ;
    vc:isPartOf ngm:render-pipeline ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:slug "scene-management" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:asset-management,
        ngm:level-of-detail .

ngm:scope-1-emissions a owl:Class ;
    rdfs:label "Scope 1 Emissions"@en ;
    rdfs:comment "Scope 1 emissions are direct greenhouse gas (GHG) emissions from sources that are owned or controlled by a reporting organisation, as defined by the GHG Protocol Corporate Standard. They include combustion of fuels in owned vehicles, boilers, and furnaces; process emissions from chemical or physical reactions in production; and fugitive emissions from refrigerant leaks, methane from waste operations, and similar inadvertent releases. Scope 1 emissions are denominated in CO2-equivalent (CO2e) tonnes and represent the most controllable category of an organisation's carbon footprint."@en ;
    rdfs:subClassOf ngm:carbon-accounting ;
    vc:enables ngm:carbon-neutrality-planning,
        ngm:esg-reporting,
        ngm:sustainability-reporting ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:emission-factors,
        ngm:ghg-protocol,
        ngm:scope-2-emissions,
        ngm:scope-3-emissions ;
    vc:slug "scope-1-emissions" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:carbon-footprint-measurement,
        ngm:environmental-accounting .

ngm:scope-3-emissions a owl:Class ;
    rdfs:label "Scope 3 Emissions"@en ;
    rdfs:comment "Scope 3 emissions are the indirect greenhouse gas (GHG) emissions that occur across an organisation's value chain as a consequence of its activities but outside its operational boundary, encompassing both upstream sources such as purchased goods and services, capital goods, and business travel, and downstream sources such as the use and end-of-life treatment of sold products. Defined under Category 3 of the GHG Protocol Corporate Standard, Scope 3 emissions typically constitute the largest share of a company's total carbon footprint — often exceeding 70 percent — making their measurement, reporting, and reduction critical to credible corporate climate strategies. Accurate Scope 3 accounting requires collaboration across supply chains and the use of spend-based, activity-based, or supplier-specific emission factors."@en ;
    rdfs:subClassOf ngm:carbon-accounting ;
    vc:enables ngm:esg-reporting,
        ngm:sustainability-reporting ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:ghg-protocol,
        ngm:scope-1-emissions,
        ngm:scope-2-emissions,
        ngm:supply-chain ;
    vc:slug "scope-3-emissions" ;
    vc:sourceDomain "science" ;
    vc:uses ngm:emission-factors,
        ngm:environmental-accounting .

ngm:search-algorithm a owl:Class ;
    rdfs:label "Search Algorithm"@en ;
    rdfs:comment "Search Algorithms in AI systematically explore solution spaces to find optimal or satisfactory solutions to problems. Classical algorithms include uninformed search (breadth-first, depth-first, uniform-cost) and informed search (A*, greedy best-first, beam search)."@en ;
    rdfs:subClassOf ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
