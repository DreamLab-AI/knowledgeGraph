ngm:in-context-learning a owl:Class ;
    rdfs:label "In-Context Learning"@en ;
    rdfs:comment "In-Context Learning (ICL) is the capability of large language models to adapt their output distribution to a novel task at inference time by conditioning on a small number of labelled input-output demonstrations embedded directly within the prompt, without any gradient-based parameter updates. The model implicitly extracts task structure and decision boundaries from the provided examples and applies that inferred structure to unseen queries, enabling rapid generalisation across domains. ICL is an emergent phenomenon that scales with model size and training-data diversity, and is theoretically framed as implicit Bayesian inference over a latent space of task hypotheses. It underpins the practical utility of modern large language models by eliminating the need for task-specific fine-tuning pipelines."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:transformer-architecture ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:attention-mechanism ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:large-language-model ],
        ngm:meta-learning ;
    vc:bridgesTo ngm:agent-reasoning,
        ngm:knowledge-graph ;
    vc:contrastsWith ngm:fine-tuning,
        ngm:parameter-efficient-fine-tuning,
        ngm:supervised-learning,
        ngm:zero-shot-prompting ;
    vc:enables ngm:few-shot-prompting,
        ngm:prompt-engineering,
        ngm:retrieval-augmented-generation,
        ngm:task-adaptation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:foundation-model ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:context-window,
        ngm:emergent-capabilities,
        ngm:few-shot-learning,
        ngm:instruction-tuning,
        ngm:mechanistic-interpretability ;
    vc:requires ngm:attention-mechanism,
        ngm:large-language-model,
        ngm:transformer-architecture ;
    vc:slug "in-context-learning" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:chain-of-thought-prompting,
        ngm:demonstration-selection,
        ngm:natural-language-processing .

ngm:iso-20022 a owl:Class ;
    rdfs:label "ISO 20022"@en ;
    rdfs:comment "ISO 20022 is the international standard for financial services messaging, providing a universal methodology that decouples business concepts from syntax through a central repository of business components, message definitions, and multi-syntax encoding rules covering XML, ASN.1, and JSON. Published by the International Organisation for Standardisation and maintained by ISO Technical Committee 68, the standard spans payments (credit transfers, direct debits), securities settlement and clearing, trade finance, and foreign exchange, replacing legacy formats such as SWIFT MT and CHIPS. Its rich, structured data model carries full remittance information, Legal Entity Identifiers, purpose codes, and beneficiary details that legacy formats cannot accommodate, enabling straight-through processing, automated reconciliation, and enhanced regulatory reporting. Major financial market infrastructures worldwide — including TARGET2, CHAPS, Fedwire, and the SWIFT network — have migrated or are actively migrating to ISO 20022, making it the convergence standard for the global payments landscape."@en ;
    rdfs:subClassOf ngm:interoperability-standard ;
    vc:bridgesTo ngm:api-economy,
        ngm:distributed-ledger-technology,
        ngm:open-banking ;
    vc:contrastsWith ngm:fixed-length-financial-message,
        ngm:swift-mt ;
    vc:enables ngm:automated-reconciliation,
        ngm:central-bank-digital-currency,
        ngm:cross-border-payments,
        ngm:regulatory-reporting,
        ngm:straight-through-processing ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:business-process-model,
        ngm:data-model ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:data-standards,
        ngm:financial-messaging,
        ngm:financial-system,
        ngm:legal-entity-identifier,
        ngm:payment-system,
        ngm:xml ;
    vc:requires ngm:data-mapping,
        ngm:message-schema-validation ;
    vc:slug "iso-20022" ;
    vc:sourceDomain "finance" ;
    vc:standardizedBy ngm:iso,
        ngm:swift ;
    vc:supports ngm:digital-payment-system,
        ngm:financial-infrastructure,
        ngm:instant-payments,
        ngm:securities-settlement .

