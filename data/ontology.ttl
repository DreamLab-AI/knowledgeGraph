        ngm:third-party-application ;
    vc:uses ngm:bearer-token,
        ngm:json-web-token,
        ngm:pkce .

ngm:onnx-runtime a owl:Class ;
    rdfs:label "ONNX Runtime"@en ;
    rdfs:comment "ONNX Runtime is an open-source, cross-platform inference and training acceleration engine developed by Microsoft that executes models represented in the Open Neural Network Exchange (ONNX) format. It applies a multi-pass graph optimisation pipeline—including operator fusion, constant folding, and common subexpression elimination—before routing computation through hardware-specific execution providers such as CUDA, TensorRT, DirectML, OpenVINO, CoreML, and QNN to maximise throughput and minimise latency. The runtime decouples training-time framework choice from deployment-time execution environment, allowing models trained in PyTorch, TensorFlow, or scikit-learn to be deployed with a single, vendor-neutral API. In 2024–2025 it extended into large language model inference via the onnxruntime-genai extensions, adding KV-cache management and autoregressive decoding primitives."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:onnx ],
        ngm:inference-engine ;
    vc:bridgesTo ngm:mobile-machine-learning,
        ngm:windows-copilot-plus ;
    vc:contrastsWith ngm:llama-cpp,
        ngm:openvino,
        ngm:tensorrt,
        ngm:tensorrt-llm,
        ngm:vllm ;
    vc:dependsOn ngm:cuda,
        ngm:directml ;
    vc:enables ngm:edge-inference,
        ngm:large-language-model-inference,
        ngm:mixed-precision-inference,
        ngm:model-deployment,
        ngm:real-time-inference ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:onnx-operator-set,
        ngm:onnx-standard ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:mlops,
        ngm:model-optimisation,
        ngm:neural-network-compilation ;
    vc:requires ngm:onnx,
        ngm:onnx-model-format ;
    vc:slug "onnx-runtime" ;
    vc:sourceDomain "ai" ;
    vc:standardizedBy ngm:onnx-community ;
    vc:supports ngm:hugging-face-transformers,
        ngm:pytorch,
        ngm:scikit-learn,
        ngm:tensorflow ;
    vc:uses ngm:execution-provider,
        ngm:graph-optimisation,
        ngm:kv-cache,
        ngm:model-quantisation,
        ngm:operator-fusion .

ngm:optimiser a owl:Class ;
    rdfs:label "Optimiser"@en ;
    rdfs:comment "An Optimiser is an algorithm that adjusts model parameters during training to minimise a loss function, guiding convergence towards an optimal solution. Modern optimisers such as Adam, RMSProp, and AdaGrad extend stochastic gradient descent with adaptive learning rates, momentum accumulation, and second-moment estimates, enabling faster and more stable training of deep neural networks across diverse tasks."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:loss-function ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gradient-descent ],
        ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:enables ngm:deep-learning,
        ngm:model-training ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:relatedTo ngm:backpropagation,
        ngm:hyperparameter,
        ngm:stochastic-gradient-descent ;
    vc:requires ngm:gradient-descent,
        ngm:loss-function ;
    vc:slug "optimiser" ;
    vc:sourceDomain "spatial-computing" .

ngm:payment-gateway a owl:Class ;
    rdfs:label "Payment Gateway"@en ;
    rdfs:comment "A Payment Gateway is a technology service that authorises, processes, and routes financial transactions between buyers and merchants, acting as the intermediary between a merchant's point-of-sale or e-commerce system and the acquiring bank or payment network. It encrypts sensitive payment credentials, communicates with card networks and issuing banks to obtain authorisation, and returns the result to the merchant in real time. Modern payment gateways provide APIs, SDKs, fraud detection, currency conversion, and compliance tooling, and increasingly support cryptocurrency payments and programmable settlement rails alongside traditional card and bank transfer methods. Payment gateways are foundational infrastructure for e-commerce and digital commerce ecosystems."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:fraud-detection ],
        ngm:payment-system ;
    vc:bridgesTo ngm:lightning-network,
        ngm:smart-contract ;
    vc:contrastsWith ngm:payment-processor ;
    vc:dependsOn ngm:card-network,
        ngm:iso-8583,
