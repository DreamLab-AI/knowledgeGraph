ngm:cross-entropy-loss a owl:Class ;
    rdfs:label "Cross-Entropy Loss"@en ;
    rdfs:comment "Cross-entropy loss is a differentiable scalar objective function that measures the dissimilarity between a model's predicted probability distribution and the true label distribution, computed as the negative log-likelihood of the correct class under the model's output. It is the canonical training objective for classification tasks and language modelling, directly optimising the model to assign maximum probability mass to correct outputs. Minimising cross-entropy is equivalent to maximising the likelihood of the training data under the model's parameterised distribution."@en ;
    rdfs:subClassOf ngm:loss-function ;
    vc:enables ngm:language-modeling,
        ngm:model-training,
        ngm:supervised-learning ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:large-language-models,
        ngm:transformer ;
    vc:slug "cross-entropy-loss" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:backpropagation,
        ngm:gradient-descent .

ngm:cross-platform-compatibility a owl:Class ;
    rdfs:label "Cross-Platform Compatibility"@en ;
    rdfs:comment "Cross-platform compatibility is the property of a software system, application, or digital asset that allows it to function correctly and consistently across multiple operating systems, hardware architectures, runtime environments, or device categories without requiring separate implementations. Achieving this property typically involves adherence to open standards, abstraction layers, and rigorous testing regimes that surface divergent behaviour across target environments. In immersive and extended-reality contexts it extends to ensuring that 3D content, avatars, and application logic behave equivalently across headsets, smartphones, and desktop viewers."@en ;
    rdfs:subClassOf ngm:interoperability ;
    vc:enables ngm:cross-platform-identity,
        ngm:portability ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:compatibility-standards,
        ngm:cross-platform-interoperability,
        ngm:interoperability-standard ;
    vc:slug "cross-platform-compatibility" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:accessibility ;
    vc:uses ngm:compatibility-process,
        ngm:open-standard .

ngm:current-sensor a owl:Class ;
    rdfs:label "Current Sensor"@en ;
    rdfs:comment "Current Sensor - An electrical measurement device (Hall effect, fluxgate, or shunt-based) that detects current flow in motor circuits and power systems, enabling Motor Torque Estimation, Fault Detection, and Energy Monitoring in autonomous robots."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:signal-conditioning ],
        ngm:robo-perception,
        ngm:sensor ;
    skos:broader ngm:robo-perception ;
    vc:enables ngm:efficiency-monitoring,
        ngm:overload-protection,
        ngm:predictive-maintenance ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:isPartOf ngm:motor-control-system,
        ngm:power-management ;
    vc:qualityScore "0.52"^^xsd:float ;
    vc:requires ngm:analogue-to-digital-conversion,
        ngm:signal-conditioning ;
    vc:slug "current-sensor" ;
    vc:sourceDomain "robotics" .

ngm:customer-support a owl:Class ;
    rdfs:label "Customer Support"@en ;
    rdfs:comment "Customer Support is the organisational function and set of processes by which a company provides assistance, guidance, and resolution of problems to its customers before, during, and after the purchase or use of a product or service. It encompasses multiple channels—telephone, email, live chat, self-service portals, and increasingly AI-powered interfaces—and spans activities from answering product questions and processing returns to resolving technical failures and managing complaints. Modern customer support operations integrate customer relationship management systems, knowledge bases, ticketing workflows, and sentiment analytics to optimise resolution efficiency and customer satisfaction."@en ;
    rdfs:subClassOf ngm:customer-service-automation ;
    vc:enables ngm:question-answering,
        ngm:workflow-automation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:conversational-ai,
        ngm:natural-language-processing,
        ngm:sentiment-analysis ;
    vc:slug "customer-support" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:chatbots,
        ngm:dialogue-system,
        ngm:information-retrieval .

ngm:cylindrical-robot a owl:Class ;
    rdfs:label "Cylindrical Robot"@en ;
    rdfs:comment "Cylindrical robot employs one rotary joint (azimuth) and two prismatic joints (radial and vertical) that produce a cylindrical workspace, enabling efficient reach over rectangular work envelopes."@en ;
    rdfs:subClassOf ngm:coordinate-robots,
        ngm:fixed-base-manipulator,
        ngm:robo-robot-type ;
    skos:broader ngm:robo-robot-type ;
    vc:enables ngm:component-assembly,
        ngm:depalletising,
        ngm:palletising,
        ngm:pick-and-place ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:azimuth-drive,
        ngm:end-effector-mount,
        ngm:radial-actuator,
        ngm:vertical-actuator ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires ngm:base-support,
        ngm:prismatic-actuators,
        ngm:rotary-joint ;
    vc:slug "cylindrical-robot" ;
    vc:sourceDomain "robotics" .

ngm:data-visualisation a owl:Class ;
    rdfs:label "Data Visualisation"@en ;
    rdfs:comment "Data Visualisation is the practice of encoding data attributes into perceptual channels—position, colour, size, shape—to enable rapid human comprehension of patterns, anomalies, and relationships. In spatial computing and metaverse contexts, visualisation extends into three-dimensional and immersive modalities including volumetric renders, augmented reality overlays, and real-time analytics dashboards embedded in XR environments. Effective visualisation depends on computer vision pipelines and rendering infrastructure."@en ;
    rdfs:subClassOf ngm:sc-display-and-rendering ;
    skos:broader ngm:sc-display-and-rendering ;
    vc:dependsOn ngm:data-access-interface ;
    vc:enables ngm:digital-twin ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:slug "data-visualisation" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:augmented-reality,
        ngm:telecollaboration ;
    vc:uses ngm:computer-vision,
        ngm:spatial-computing .

ngm:deep-dao a owl:Class ;
    rdfs:label "DeepDAO"@en ;
    rdfs:comment "DeepDAO is a leading analytics and data aggregation platform dedicated to tracking and measuring the organisational health, financial activity, governance participation, and membership dynamics of decentralised autonomous organisations across multiple blockchain networks. It provides standardised metrics — total assets under management, number of token holders, proposal counts, voter participation rates, and delegate rankings — that enable comparative analysis of DAO ecosystems and inform investment, research, and governance design decisions."@en ;
    rdfs:subClassOf ngm:dao-analytics ;
    vc:enables ngm:dao-governance,
        ngm:decentralized-governance,
        ngm:decision-transparency ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:dao,
        ngm:dao-tooling ;
    vc:slug "deep-dao" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:blockchain-analytics,
        ngm:governance-token,
        ngm:on-chain-governance .

ngm:democratic-participation a owl:Class ;
    rdfs:label "Democratic Participation"@en ;
    rdfs:comment "The mechanisms and systems enabling citizens to engage in collective decision-making processes within virtual environments, digital governance platforms, and metaverse communities, encompassing voting, deliberation, and civic engagement through immersive technologies and decentralized governance ..."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:governance-framework ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:voting-systems ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:identity-verification ],
        ngm:digital-governance,
        ngm:sc-governance-and-safety ;
    skos:broader ngm:sc-governance-and-safety ;
    vc:enables ngm:civic-engagement,
        ngm:community-decision-making,
        ngm:virtual-voting ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires ngm:governance-framework,
        ngm:identity-verification,
        ngm:voting-systems ;
    vc:slug "democratic-participation" ;
    vc:sourceDomain "spatial-computing" .

ngm:digital-art a owl:Class ;
    rdfs:label "Digital Art"@en ;
    rdfs:comment "Digital art encompasses visual, interactive, and generative artworks created, stored, and distributed using digital technologies as primary medium or tool. It spans a wide range of practices—from pixel painting and vector illustration to algorithmically generated pieces, interactive installations, and AI-synthesised imagery. The form has been transformed by NFT infrastructure, which introduced scarcity and provenance guarantees to inherently copyable digital objects. Digital art sits at the intersection of technological capability and aesthetic intent, continuously expanding as new computational tools emerge."@en ;
    rdfs:subClassOf ngm:creative-media-domain ;
    vc:enables ngm:content-creation,
        ngm:digital-asset ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:digital-art-application,
        ngm:digital-ownership,
        ngm:nft ;
    vc:slug "digital-art" ;
    vc:sourceDomain "metaverse" ;
    vc:supports ngm:agentic-metaverse-for-global-creatives ;
    vc:uses ngm:creative-ai,
        ngm:creative-software,
        ngm:image-generation .

ngm:digital-commerce a owl:Class ;
    rdfs:label "Digital Commerce"@en ;
    rdfs:comment "Digital Commerce encompasses the exchange of goods, services, and digital assets through internet-connected and virtual platforms, including metaverse storefronts, NFT marketplaces, and cryptocurrency-denominated payment rails. It extends conventional e-commerce by incorporating programmable smart contracts for trustless settlement, tokenised ownership of virtual goods, and AI-mediated personalisation. In metaverse contexts, digital commerce enables low-friction cross-border value transfer without leaving the virtual environment."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:digital-identity ],
        ngm:digital-asset-ecosystem,
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:enables ngm:cross-metaverse-commerce,
        ngm:digital-asset-management ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:requires ngm:digital-identity ;
    vc:slug "digital-commerce" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:metaverse ;
    vc:uses ngm:blockchain,
        ngm:smart-contract .

ngm:digital-human-technology a owl:Class ;
    rdfs:label "Digital Human Technology"@en ;
    rdfs:comment "A class of technologies for creating photorealistic or stylised computer-generated human representations, encompassing 3D body and face modelling, motion capture-driven animation, procedural skin and cloth simulation, and real-time rendering pipelines. Digital human technology enables believable avatars, virtual actors, and AI-driven conversational agents in spatial computing, entertainment, and training applications."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:rendering-engine ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:motion-capture ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:digital-humans ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:animation-software ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:computer-graphics ],
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:animation-software,
        ngm:digital-humans,
        ngm:motion-capture ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:requires ngm:computer-graphics,
        ngm:rendering-engine ;
    vc:slug "digital-human-technology" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:avatar-creation,
        ngm:character-model .

ngm:digital-identity-framework a owl:Class ;
    rdfs:label "Digital Identity Framework"@en ;
    rdfs:comment "Digital Identity Framework is a type of Infrastructure in the infrastructure domain."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:standardization-bodies ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptographic-system ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:privacy-controls ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
