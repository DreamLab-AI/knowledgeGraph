ngm:macroeconomics a owl:Class ;
    rdfs:label "Macroeconomics"@en ;
    rdfs:comment "Macroeconomics is the branch of economics that studies the behaviour and performance of an economy as a whole, examining aggregate phenomena such as gross domestic product, price levels, unemployment, business cycles, and long-run growth. It analyses how monetary and fiscal policy shape inflation, output, and employment, and how international trade and capital flows interconnect national economies. The discipline develops formal models — from Keynesian demand frameworks to DSGE models — that link household, firm, and government behaviour to economy-wide outcomes. It contrasts with microeconomics by focusing on aggregate rather than individual-agent variables."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:monetary-policy ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:econometrics ],
        ngm:economics ;
    vc:bridgesTo ngm:data-analytics,
        ngm:financial-market ;
    vc:contrastsWith ngm:microeconomics ;
    vc:dependsOn ngm:aggregate-demand,
        ngm:aggregate-supply ;
    vc:enables ngm:central-banking,
        ngm:economic-forecasting,
        ngm:inflation-hedge ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:business-cycle,
        ngm:fiscal-policy,
        ngm:international-trade,
        ngm:monetary-policy,
        ngm:national-income-accounting ;
    vc:isPartOf ngm:economics ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:balance-of-payments,
        ngm:economic-growth,
        ngm:exchange-rate,
        ngm:inflation,
        ngm:public-debt,
        ngm:unemployment ;
    vc:requires ngm:econometrics,
        ngm:national-income-accounting ;
    vc:slug "macroeconomics" ;
    vc:sourceDomain "finance" ;
    vc:uses ngm:consumer-price-index,
        ngm:gross-domestic-product,
        ngm:interest-rate .

ngm:macroprudential-policy a skos:Concept ;
    rdfs:label "Macroprudential Policy"@en .

ngm:market-access a skos:Concept ;
    rdfs:label "Market Access"@en .

ngm:market-capitalization a owl:Class ;
    rdfs:label "Market Capitalization"@en ;
    rdfs:comment "Market Capitalization in a blockchain context is the aggregate market value of a cryptocurrency or token, computed as the circulating supply multiplied by the current unit price. It serves as a widely used proxy for the relative size, liquidity, and investor confidence of a crypto-economic network, underpinning index construction, risk categorisation, and portfolio weighting decisions by institutional participants. Critically, market capitalisation is a lagging and manipulable metric: thin order books, wash trading, and locked but counted supply can inflate the figure well beyond the value that could be liquidated in practice."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptocurrency ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:token ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:tokenomics ],
        ngm:bc-defi-and-economics,
        ngm:blockchain-entity,
        ngm:economic-mechanism ;
    skos:broader ngm:bc-defi-and-economics ;
    vc:enables ngm:token-weighted-voting,
        ngm:tokenomics-governance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:tokenomics ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:blockchain-economics,
        ngm:liquidity-pool,
        ngm:liquidity-provision,
        ngm:token-economics,
        ngm:tokenization ;
    vc:requires ngm:cryptocurrency,
        ngm:token ;
    vc:slug "market-capitalization" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:cryptocurrency-token .

ngm:market-liquidity a skos:Concept ;
    rdfs:label "Market Liquidity"@en .

ngm:materiality-assessment a skos:Concept ;
    rdfs:label "Materiality Assessment"@en .

ngm:mathematical-logic a skos:Concept ;
    rdfs:label "Mathematical Logic"@en .

ngm:measurement-methodology a owl:Class ;
    rdfs:label "Measurement Methodology"@en ;
    rdfs:comment "A measurement methodology is a defined, repeatable procedure for quantifying a property or performance characteristic, specifying scope, units, data sources, and calculation rules. It ensures that results are consistent, comparable, and auditable across observers and over time. Rigorous methodology is the precondition for trustworthy indicators, benchmarks, and standards-based reporting."@en ;
    rdfs:subClassOf ngm:evaluation-metric ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:benchmark-standard,
        ngm:carbon-footprint-indicator ;
    vc:slug "measurement-methodology" ;
    vc:sourceDomain "governance" .

ngm:mechanical-interface a owl:Class ;
    rdfs:label "Mechanical Interface"@en ;
    rdfs:comment "A mechanical interface is the standardised physical coupling between two components that defines their geometric fit, fastening, and load transfer. In robotics it specifies how an end-effector or tool attaches to a robot wrist or actuator, governing alignment, rigidity, and quick-change capability. Well-defined mechanical interfaces enable modularity and interchangeability of subsystems."@en ;
    rdfs:subClassOf ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:electric-actuator,
        ngm:end-effector ;
    vc:slug "mechanical-interface" ;
    vc:sourceDomain "robotics" .

ngm:mechanical-load a owl:Class ;
    rdfs:label "Mechanical Load"@en ;
    rdfs:comment "A mechanical load is the external force, torque, or resistance that a motor, actuator, or structure must work against during operation. Characterised by inertia, friction, gravity, and process forces, it determines the torque-speed demand placed on a drive system. Accurate load characterisation is essential for sizing motors, selecting gearing, and designing stable control."@en ;
    rdfs:subClassOf ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:dc-servo-motor,
        ngm:electric-motor ;
    vc:slug "mechanical-load" ;
    vc:sourceDomain "robotics" .

ngm:megatron-lm a skos:Concept ;
    rdfs:label "Megatron Lm"@en .

ngm:memory-encryption a skos:Concept ;
    rdfs:label "Memory Encryption"@en .

ngm:memory-hierarchy a owl:Class ;
    rdfs:label "Memory Hierarchy"@en ;
    rdfs:comment "A memory hierarchy organises storage into layers of differing speed, size and cost so that frequently accessed data sits in fast caches close to the processor and bulk data resides in slower, larger memory."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:computer-hardware ],
        ngm:computer-hardware ;
    vc:enables ngm:gpu-architecture,
        ngm:real-time-rendering ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:computer-hardware ;
    vc:slug "memory-hierarchy" ;
    vc:sourceDomain "metaverse" .

ngm:memory-store a owl:Class ;
    rdfs:label "Memory Store"@en ;
    rdfs:comment "A memory store is the persistence layer in an AI agent system that retains information across turns and sessions for later retrieval. It typically holds conversation history, facts, and learned context, often as embeddings in a vector database to enable semantic recall. The memory store is what allows agents to maintain continuity, personalise responses, and accumulate knowledge beyond a single context window."@en ;
    rdfs:subClassOf ngm:ai-agent-system ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:agent-frameworks,
        ngm:context-engineering ;
    vc:slug "memory-store" ;
    vc:sourceDomain "ai" .

ngm:merkle-patricia-trie a skos:Concept ;
    rdfs:label "Merkle Patricia Trie"@en .

ngm:message-signing a owl:Class ;
    rdfs:label "Message Signing"@en ;
    rdfs:comment "Message signing is a cryptographic operation whereby a private key is used to generate a digital signature over a message or data payload, enabling any holder of the corresponding public key to verify the authenticity and integrity of the message. It provides non-repudiation guarantees, ensuring that the signer cannot plausibly deny having produced the signature. Message signing is foundational to authentication protocols, blockchain transactions, and secure communication systems."@en ;
    rdfs:subClassOf ngm:cryptographic-protocol ;
    vc:enables ngm:authentication,
        ngm:cryptographic-verification ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:cryptographic-hash-function,
        ngm:knowledge-graph-publication-classifier-key-infrastructure,
        ngm:secp256k1 ;
    vc:slug "message-signing" ;
    vc:sourceDomain "security" ;
    vc:uses ngm:digital-signature,
        ngm:ecdsa,
        ngm:knowledge-graph-publication-classifier-key-cryptography,
        ngm:private-key .

ngm:meta-llama-model-family a owl:Class ;
    rdfs:label "Meta Llama Model Family"@en ;
    rdfs:comment "Llama is a family of large language models developed by Meta and released, in large part, with open weights for research and commercial use. First introduced in 2023 with LLaMA, followed by Llama 2, Llama 3 and later versions, the models are transformer-based and trained on large text corpora. By releasing model weights under permissive terms, Meta enabled a wide range of independent fine-tuning and deployment, making Llama a common base for open models. The family spans several parameter sizes to suit different compute and latency requirements."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:large-language-model ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:reinforcement-learning-from-human-feedback ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:transformer ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gpu-compute ],
        ngm:large-language-model ;
    vc:bridgesTo ngm:microsoft-copilot,
        ngm:spatial-ai-inference ;
    vc:contrastsWith ngm:gemini-model-family,
        ngm:gpt-4,
        ngm:mistral-model-family ;
    vc:enables ngm:fine-tuning,
        ngm:on-device-inference,
        ngm:retrieval-augmented-generation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:llama-1,
        ngm:llama-2,
        ngm:llama-3,
        ngm:llama-guard ;
    vc:implements ngm:decoder-only-transformer-architecture,
        ngm:grouped-query-attention,
        ngm:rotary-position-embedding ;
    vc:isPartOf ngm:open-source-ai-ecosystem ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:open-weights-model,
        ngm:parameter-efficient-fine-tuning,
        ngm:quantization ;
    vc:requires ngm:gpu-compute,
        ngm:large-language-model,
        ngm:reinforcement-learning-from-human-feedback,
        ngm:transformer ;
    vc:slug "meta-llama-model-family" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:byte-pair-encoding,
        ngm:instruction-tuning .

ngm:meta-llama-model-family-3 a owl:Class ;
    rdfs:label "Llama 3"@en ;
    rdfs:comment "Llama 3 is a family of open-weight large language models developed and released by Meta AI in April 2024, spanning 8 billion and 70 billion parameter base and instruction-tuned variants, with a 405 billion parameter model subsequently released in July 2024. Llama 3 models are trained on approximately 15 trillion tokens from a curated multilingual corpus, use a 128,000-token vocabulary with a custom BPE tokeniser, incorporate grouped-query attention for inference efficiency, and are post-trained with supervised fine-tuning and reinforcement learning from human feedback. The models are released under a custom Meta Llama 3 Community License that permits commercial use for most organisations while imposing restrictions on deployments exceeding 700 million monthly active users."@en ;
    rdfs:subClassOf ngm:large-language-models ;
    vc:enables ngm:fine-tuning,
        ngm:inference-engine,
        ngm:open-source-ai ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:benchmarks,
        ngm:meta-ai,
        ngm:model-weights,
        ngm:safety-and-alignment ;
    vc:slug "llama-3" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:instruction-tuning,
        ngm:rlhf,
        ngm:transformer-architecture .

ngm:metaverse-interoperability a skos:Concept ;
    rdfs:label "Metaverse Interoperability"@en .

ngm:metaverse-stack a owl:Class ;
    rdfs:label "Metaverse Stack"@en ;
    rdfs:comment "The comprehensive layered technology framework encompassing hardware, network infrastructure, spatial computing, decentralisation, creator economy, discovery, and experience layers that toger enable the creation and operation of persistent virtual world environments."@en ;
    rdfs:subClassOf ngm:sc-platform-and-environment,
        ngm:technology-stack ;
    skos:broader ngm:sc-platform-and-environment ;
