ngm:ownership-freedom-distributed a owl:Class ;
    rdfs:label "Ownership Freedom distributed"@en ;
    rdfs:comment "A socio-technical paradigm establishing user sovereignty through decentralized control mechanisms, cryptographic ownership proofs, and distributed governance models."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptography ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:smart-contract ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:decentralized-identifiers ],
        ngm:metaverse-governance-and-safeguarding,
        ngm:sc-governance-and-safety ;
    skos:broader ngm:sc-governance-and-safety ;
    vc:enables ngm:data-sovereignty,
        ngm:decentralized-governance,
        ngm:self-sovereign-identity ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:requires ngm:cryptography,
        ngm:decentralized-identifiers,
        ngm:smart-contract ;
    vc:slug "ownership-freedom-distributed" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:governance-framework,
        ngm:nft-ownership-proof .

