    vc:slug "erc-1400" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:kyc-aml,
        ngm:regulatory-compliance,
        ngm:securities-law ;
    vc:uses ngm:on-chain-document-management,
