ngm:feature-pyramid-network a owl:Class ;
    rdfs:label "Feature Pyramid Network"@en ;
    rdfs:comment "A Feature Pyramid Network (FPN) is a convolutional neural-network architecture that builds a multi-scale feature hierarchy with strong semantics at all levels by combining a bottom-up pathway with a top-down pathway and lateral connections. This design lets detectors and segmenters recognise objects across a wide range of sizes using features that are simultaneously high-resolution and semantically rich. FPN is a standard backbone component in modern object-detection and instance-segmentation pipelines."@en ;
    rdfs:subClassOf ngm:neural-network ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:image-segmentation,
        ngm:segmentation-and-identification ;
    vc:slug "feature-pyramid-network" ;
    vc:sourceDomain "ai" .

ngm:few-shot-prompting a owl:Class ;
    rdfs:label "Few-Shot Prompting"@en ;
    rdfs:comment "Few-shot prompting is a prompt engineering technique in which a small number of input-output demonstration examples are included directly in the context provided to a large language model, guiding the model to produce outputs conforming to the demonstrated pattern without any parameter updates. The approach exploits the in-context learning capability of transformer-based models, allowing task specification through examples rather than task-specific fine-tuning."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:context-window ],
        ngm:prompt-engineering ;
    vc:bridgesTo ngm:artificial-intelligence,
        ngm:natural-language-processing ;
    vc:contrastsWith ngm:few-shot-learning,
        ngm:fine-tuning,
        ngm:zero-shot-prompting ;
    vc:dependsOn ngm:attention-mechanism,
        ngm:foundation-model ;
    vc:enables ngm:information-extraction,
        ngm:structured-output,
        ngm:task-adaptation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:prompt-engineering ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:chain-of-thought-prompting,
        ngm:instruction-tuning,
        ngm:meta-learning,
        ngm:retrieval-augmented-generation,
        ngm:zero-shot-prompting ;
    vc:requires ngm:context-window ;
    vc:slug "few-shot-prompting" ;
    vc:sourceDomain "machine-learning" ;
    vc:uses ngm:few-shot-examples,
        ngm:in-context-learning,
        ngm:large-language-model,
        ngm:transformer .

ngm:fiduciary-duty a owl:Class ;
    rdfs:label "Fiduciary Duty"@en ;
    rdfs:comment "A fiduciary duty is a legal and ethical obligation requiring one party, the fiduciary, to act in the best interests of another, the beneficiary, with loyalty, prudence, and good faith. It typically encompasses a duty of loyalty that prohibits self-dealing and conflicts of interest, and a duty of care that demands competent, diligent management of the beneficiary's affairs. Fiduciary duties arise in relationships such as those between directors and shareholders, trustees and beneficiaries, and asset managers and clients."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:trust ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:accountability ],
        ngm:corporate-governance ;
    vc:bridgesTo ngm:regulatory-compliance ;
    vc:dependsOn ngm:legal-framework ;
    vc:enables ngm:investor-protection ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:implements ngm:ethics ;
    vc:isPartOf ngm:corporate-governance ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:asset-management,
        ngm:ethics,
        ngm:governance ;
    vc:requires ngm:accountability,
        ngm:trust ;
    vc:slug "fiduciary-duty" ;
    vc:sourceDomain "governance" ;
    vc:supports ngm:corporate-governance ;
    vc:uses ngm:compliance .

ngm:financial-action-task-force a owl:Class ;
    rdfs:label "Financial Action Task Force"@en ;
    rdfs:comment "The Financial Action Task Force (FATF) is an intergovernmental body that sets international standards to combat money laundering, terrorist financing and proliferation financing. It issues the FATF Recommendations, conducts mutual evaluations of member jurisdictions, and maintains lists of high-risk and non-cooperative jurisdictions. Its guidance — including the Travel Rule for virtual assets — strongly shapes national anti-money-laundering and know-your-customer regimes worldwide."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:know-your-customer ],
        ngm:standards-body ;
    vc:bridgesTo ngm:governance ;
    vc:dependsOn ngm:regulatory-framework ;
    vc:enables ngm:compliance,
        ngm:know-your-customer ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:anti-money-laundering,
        ngm:travel-rule ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:anti-money-laundering,
        ngm:compliance,
        ngm:travel-rule ;
    vc:requires ngm:know-your-customer ;
    vc:slug "financial-action-task-force" ;
    vc:sourceDomain "finance" ;
    vc:standardizedBy ngm:regulatory-framework ;
    vc:supports ngm:anti-money-laundering,
        ngm:financial-regulation .

ngm:force-feedback a owl:Class ;
    rdfs:label "Force Feedback"@en ;
    rdfs:comment "Force feedback is a class of haptic technology that renders mechanical forces — including resistance, weight, texture, and impact — directly to a user's body through a controlled actuator system, enabling the sense of touch and proprioception to convey information about virtual or remote physical environments. Distinguished from simpler vibrotactile feedback by its ability to generate directional, grounded forces (requiring a mechanical linkage to the user), force feedback systems are used in surgical simulators, teleoperation of remote robots, vehicle simulation, and advanced XR interfaces. The fidelity of the rendered force field is constrained by the bandwidth, peak force, backdrivability, and transparency of the underlying actuator mechanism."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:real-time-control ],
        ngm:haptics ;
    vc:bridgesTo ngm:extended-reality,
        ngm:spatial-computing ;
    vc:contrastsWith ngm:visual-feedback ;
    vc:enables ngm:dexterous-manipulation,
        ngm:haptic-feedback-telepresence,
        ngm:physics-simulation,
        ngm:surgical-simulation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:human-robot-interaction,
        ngm:teleoperation ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:haptic-feedback,
        ngm:haptic-feedback-system,
        ngm:proprioception,
        ngm:tactile-sensing,
        ngm:teleoperation ;
    vc:requires ngm:real-time-control ;
    vc:slug "force-feedback" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:actuator,
        ngm:impedance-control,
        ngm:motion-control,
        ngm:pid-controller,
        ngm:series-elastic-actuator .

ngm:forward-error-correction a owl:Class ;
    rdfs:label "Forward Error Correction"@en ;
    rdfs:comment "Forward error correction (FEC) is a channel-coding technique in which redundant information is added to a transmitted data stream so that the receiver can detect and correct errors introduced by the channel without requesting retransmission. FEC codes trade bandwidth or storage overhead for improved reliability over noisy or lossy channels, eliminating the round-trip latency penalty of automatic repeat request (ARQ) schemes."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:reed-solomon-codes ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:ldpc-codes ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-redundancy ],
        ngm:channel-coding ;
    vc:bridgesTo ngm:quantum-error-correction ;
    vc:dependsOn ngm:information-theory ;
    vc:enables ngm:packet-loss-recovery,
        ngm:real-time-streaming ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:hamming-codes,
        ngm:ldpc-codes,
        ngm:reed-solomon-codes ;
    vc:implements ngm:error-correction ;
    vc:qualityScore "0.85"^^xsd:float ;
    vc:relatedTo ngm:erasure-coding ;
    vc:requires ngm:channel-capacity,
        ngm:data-redundancy ;
    vc:slug "forward-error-correction" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:satellite-communications,
        ngm:telecommunications ;
    vc:uses ngm:belief-propagation .

ngm:generalisation a owl:Class ;
    rdfs:label "Generalisation"@en ;
    rdfs:comment "Generalisation is the capacity of a machine-learning model to perform accurately on previously unseen data drawn from the same distribution as its training set, rather than merely memorising training examples. It is the central objective of supervised learning and is quantified by the gap between training and held-out performance. Good generalisation reflects a model that has captured the underlying regularities of a task instead of spurious correlations."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:regularisation ],
        ngm:machine-learning ;
    vc:bridgesTo ngm:transfer-learning ;
    vc:contrastsWith ngm:overfitting ;
    vc:dependsOn ngm:inductive-bias,
        ngm:training-data ;
    vc:enables ngm:transfer-learning ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:machine-learning-model,
        ngm:model-performance ;
    vc:requires ngm:regularisation ;
    vc:slug "generalisation" ;
    vc:sourceDomain "machine-learning" ;
    vc:supports ngm:model-evaluation ;
    vc:uses ngm:cross-validation .

ngm:ground-robot a owl:Class ;
    rdfs:label "Ground Robot"@en ;
    rdfs:comment "Ground robot is a mobile robotic platform that operates on terrestrial surfaces using wheeled, tracked, legged, or hybrid locomotion systems to navigate structured and unstructured environments while executing purposeful tasks — including material transport, environmental inspection, search and r..."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
