    vc:slug "finality" ;
    vc:sourceDomain "blockchain" .

ngm:language-model a owl:Class ;
    rdfs:label "Language Model"@en ;
    rdfs:comment "A language model is a probabilistic model of natural language that assigns a probability distribution over sequences of tokens — words, subwords, or characters — enabling both likelihood estimation of observed text and generation of new text via sampling from learned conditional distributions. Modern large language models are deep neural networks based on the transformer architecture, trained on vast corpora through a self-supervised next-token prediction objective. They acquire implicit representations of syntax, semantics, world knowledge, and reasoning patterns entirely from this training signal, and can be adapted to downstream tasks through fine-tuning, instruction tuning, or prompt engineering. The paradigm has displaced earlier n-gram and recurrent neural network approaches, becoming the dominant framework for natural language processing across virtually all applied domains."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:pretraining ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:feed-forward-network ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:attention-mechanism ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:positional-encoding ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:training-data ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:compute-infrastructure ],
        ngm:generative-model ;
    vc:bridgesTo ngm:ai-agent,
        ngm:knowledge-graph ;
    vc:contrastsWith ngm:recurrent-neural-network ;
    vc:enables ngm:code-generation,
        ngm:machine-translation,
        ngm:natural-language-processing,
        ngm:natural-language-understanding,
        ngm:question-answering,
        ngm:retrieval-augmented-generation,
        ngm:text-generation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:attention-mechanism,
        ngm:feed-forward-network,
        ngm:positional-encoding ;
    vc:qualityScore "0.74"^^xsd:float ;
