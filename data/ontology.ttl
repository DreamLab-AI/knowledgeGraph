ngm:voting-mechanism a owl:Class ;
    rdfs:label "Voting Mechanism"@en ;
    rdfs:comment "A voting mechanism is a formalised procedure by which token holders or other stakeholders express preferences or binding decisions on protocol upgrades, parameter changes, treasury allocation, or dispute resolution in a decentralised network. The design of a voting mechanism determines the balance between participation breadth, sybil resistance, plutocracy risk, and voter apathy; common variants include token-weighted voting, quadratic voting, conviction voting, and delegated representation through liquid democracy. The mechanism's properties directly shape the security and legitimacy of on-chain governance outcomes."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:token-weighted-voting ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:on-chain-voting ],
        ngm:bc-governance-and-regulation ;
    skos:broader ngm:bc-governance-and-regulation ;
    vc:enables ngm:on-chain-governance ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:on-chain-voting,
        ngm:token-weighted-voting ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:dao-governance,
        ngm:governance-token,
        ngm:quadratic-voting ;
    vc:slug "voting-mechanism" ;
    vc:sourceDomain "blockchain" .

ngmi:bitcoin a owl:NamedIndividual,
        ngm:cryptocurrency ;
    rdfs:label "Bitcoin"@en ;
    rdfs:comment "Bitcoin is the first decentralised peer-to-peer electronic cash system, introduced by the pseudonymous Satoshi Nakamoto in a 2008 white paper and launched in January 2009. It operates on a public, permissionless blockchain secured by proof-of-work consensus, with a fixed supply cap of 21 million BTC enforced by its protocol. Bitcoin is simultaneously a payment network, a monetary asset, and the foundational reference implementation for the broader cryptocurrency and blockchain industry."@en ;
    vc:contrastsWith ngm:51-attack,
        ngm:bitcoin-centralisation-risks ;
    vc:enables ngm:bitcoin-as-money,
