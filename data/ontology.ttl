    vc:supports ngm:user-interface-architecture ;
    vc:uses ngm:data-visualisation .

ngm:non-linear-storytelling a owl:Class ;
    rdfs:label "Non Linear Storytelling"@en ;
    rdfs:comment "The craft and practice of creating narratives where story events can be experienced in multiple sequences through branching paths, player choices, or temporal manipulation, commonly used in video games, interactive fiction, and immersive experiences."@en ;
