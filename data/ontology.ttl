        ngm:user-representation ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:3-d-rendering-engine,
        ngm:animation-controller,
        ngm:input-processing ;
    vc:slug "avatar-system" ;
    vc:sourceDomain "spatial-computing" .

ngm:decentralised-identity a owl:Class ;
    rdfs:label "Decentralised Identity"@en ;
    rdfs:comment "Decentralised Identity (DID) is a model for digital identity management in which individuals, organisations, and devices create, own, and control their own cryptographic identifiers and verifiable credentials without dependence on centralised identity providers or registries. Identifiers are anchored to a verifiable data registry — typically a blockchain or distributed ledger — as Decentralised Identifiers (DIDs) standardised by the W3C DID specification. Credentials attesting to attributes of the DID subject are issued by trusted parties as W3C Verifiable Credentials, stored in a user-controlled digital wallet, and selectively disclosed to verifiers using zero-knowledge proofs or selective disclosure mechanisms."@en ;
    rdfs:subClassOf ngm:bc-network-component ;
    skos:broader ngm:bc-network-component ;
    vc:enables ngm:self-sovereign-identity ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:credential-schema ;
    vc:slug "decentralised-identity" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:did-document,
        ngm:digital-identity-wallet,
        ngm:verifiable-credentials .

ngm:elliptic-curve-cryptography a owl:Class ;
    rdfs:label "Elliptic Curve Cryptography"@en ;
    rdfs:comment "A public-key cryptographic system based on the algebraic structure of elliptic curves over finite fields, providing strong security guarantees with shorter key lengths than RSA. ECC underpins digital signatures (ECDSA), key agreement (ECDH), and identity operations throughout blockchain infrastructure."@en ;
    rdfs:subClassOf ngm:bc-cryptographic-primitive,
        ngm:blockchain-entity,
        ngm:cryptographic-primitive ;
    skos:broader ngm:bc-cryptographic-primitive ;
    vc:enables ngm:cryptographic-key-management,
        ngm:digital-signature ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:blockchain ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:cryptographic-protocol,
        ngm:cryptographic-security,
        ngm:cryptographic-signature,
        ngm:decentralization ;
    vc:slug "elliptic-curve-cryptography" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:cryptographic-hash-function,
        ngm:private-key .

ngm:feedback-control a owl:Class ;
    rdfs:label "Feedback Control"@en ;
    rdfs:comment "Feedback Control - A closed-loop control mechanism in which Sensor measurements of actual system state are continuously compared against desired Setpoints, and control actions are adjusted in real time to minimise error and maintain stable, accurate Robot Behaviour."@en ;
