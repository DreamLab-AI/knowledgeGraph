    rdfs:label "Content Negotiation"@en .

ngm:content-protection a owl:Class ;
    rdfs:label "Content Protection"@en ;
    rdfs:comment "Content Protection comprises technical and legal mechanisms that prevent unauthorised reproduction, distribution, or alteration of digital creative works. It includes digital rights management (DRM), encryption, access control, and blockchain-based provenance systems applied to media, software, and metaverse assets."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:digital-rights ],
        ngm:sc-governance-and-safety ;
    skos:broader ngm:sc-governance-and-safety ;
    vc:enables ngm:digital-ownership ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:relatedTo ngm:intellectual-property-rights-framework ;
    vc:requires ngm:digital-rights ;
    vc:slug "content-protection" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:access-control,
        ngm:digital-rights-management,
        ngm:encryption .

