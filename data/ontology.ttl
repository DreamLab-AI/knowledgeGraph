        ngm:sensor-data ;
    vc:slug "feedback-mechanism" ;
    vc:sourceDomain "spatial-computing" .

ngm:film-vfx a owl:Class ;
    rdfs:label "Film VFX"@en ;
    rdfs:comment "Film VFX (Visual Effects) encompasses the full suite of techniques used to create, augment, or manipulate imagery in cinematic productions that cannot be practically achieved through conventional photography, including computer-generated imagery (CGI), digital compositing, motion capture-driven character animation, photorealistic simulation of natural phenomena, and digital environment creation. Modern film VFX pipelines integrate real-time rendering engines, deep learning-based tools for rotoscoping, denoising, and face replacement, and virtual production stages using LED volume displays to blend physical and digital environments in-camera rather than in post-production. VFX is distinct from practical effects (pyrotechnics, prosthetics) and from colour grading, though all three coexist within the broader post-production discipline."@en ;
    rdfs:subClassOf ngm:visual-effects ;
    vc:enables ngm:generative-content ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:film-production,
        ngm:motion-capture,
        ngm:neural-rendering,
        ngm:photorealistic-rendering,
        ngm:vfx-tools ;
    vc:slug "film-vfx" ;
    vc:sourceDomain "graphics" ;
    vc:uses ngm:diffusion-model,
        ngm:real-time-rendering,
        ngm:virtual-production .

ngm:financial-privacy a owl:Class ;
    rdfs:label "Financial Privacy"@en ;
    rdfs:comment "Financial Privacy refers to the rights, mechanisms, and technical controls that protect individuals and organisations from unwanted disclosure of their financial transactions, holdings, and economic behaviour. It encompasses both legal frameworks—such as bank secrecy laws and GDPR financial data provisions—and cryptographic techniques such as zero-knowledge proofs, stealth addresses, and confidential transactions. The tension between financial privacy and regulatory transparency requirements (AML, KYC) is a defining challenge of the digital payments era, particularly as public blockchain ledgers make transaction histories permanently visible. Financial privacy is increasingly recognised as a precondition for personal autonomy, political freedom, and protection against targeted financial censorship."@en ;
    rdfs:subClassOf ngm:cryptography-security-and-privacy ;
    vc:contrastsWith ngm:blockchain-analytics,
        ngm:compliance-framework ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:aml-kyc-compliance,
        ngm:differential-privacy,
        ngm:zero-knowledge-proof ;
    vc:slug "financial-privacy" ;
    vc:sourceDomain "finance" ;
    vc:uses ngm:confidential-computing,
        ngm:homomorphic-encryption,
        ngm:zero-knowledge .

ngm:financial-transactions a owl:Class ;
    rdfs:label "Financial Transactions"@en ;
    rdfs:comment "Financial Transactions are records of the transfer of monetary value or digital assets between parties, executed through centralised payment systems, blockchain networks, or Layer-2 protocols such as the Lightning Network. Within spatial computing and metaverse contexts, financial transactions underpin virtual economies, in-world purchases, NFT trades, and cross-platform value exchange, requiring robust settlement, fraud detection, and regulatory compliance mechanisms."@en ;
    rdfs:subClassOf ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:enables ngm:de-fi-services,
        ngm:digital-asset-trading ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:financial-services,
        ngm:lightning-network ;
    vc:slug "financial-transactions" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:blockchain,
        ngm:cryptocurrency,
        ngm:smart-contract .

ngm:frontier-ai a owl:Class ;
    rdfs:label "Frontier AI"@en ;
    rdfs:comment "Frontier AI refers to the most capable and computationally intensive artificial intelligence systems at the leading edge of current technical progress, typically characterised by unprecedentedly large training compute budgets, novel emergent capabilities, and performance that approaches or exceeds human expert level across diverse cognitive tasks. These systems, predominantly large language models and multimodal foundation models, exhibit qualitatively new behaviours not present in smaller predecessors, including in-context learning, chain-of-thought reasoning, and cross-domain generalisation. Their development is concentrated among a small number of resource-rich organisations and raises distinct safety, governance, and geopolitical considerations absent from earlier AI generations."@en ;
    rdfs:subClassOf ngmi:foundation-models ;
    vc:enables ngm:gpt,
        ngm:history-and-path-to-agi,
        ngm:transformers ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:frontier-model-forum,
        ngm:generative-ai,
        ngm:large-language-models ;
    vc:slug "frontier-ai" ;
    vc:sourceDomain "ai" ;
    vc:supports ngm:ai-governance,
        ngm:ai-safety ;
    vc:uses ngm:model-evaluation-results,
        ngm:red-teaming .

ngm:frontier-model-forum a owl:Class ;
    rdfs:label "Frontier Model Forum"@en ;
    rdfs:comment "The Frontier Model Forum is an industry body founded in 2023 by leading AI development organisations to advance AI safety research, share knowledge on safety best practices, and promote responsible development and deployment of frontier AI models. It provides a venue for cross-company collaboration on technical safety, evaluation methodologies, and engagement with governments and civil society. The Forum focuses specifically on the most capable general-purpose AI models and the risks that may arise from their development and deployment."@en ;
    rdfs:subClassOf ngm:ai-governance-and-ethics ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:ai-alignment,
        ngm:ai-regulation,
        ngm:red-teaming ;
    vc:slug "frontier-model-forum" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:ai-safety,
        ngm:responsible-ai .

ngm:game-mechanics a owl:Class ;
    rdfs:label "Game Mechanics"@en ;
    rdfs:comment "The rules, systems, and interaction patterns that define player agency and emergent behaviour within a game or virtual environment. Game mechanics encompass reward loops, progression systems, physics constraints, NPC behaviours, and economic structures that govern how participants interact with a metaverse platform, and are increasingly encoded in smart contracts for transparent, programmable enforcement."@en ;
    rdfs:subClassOf ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:enables ngm:play-to-earn-p2-e,
        ngm:virtual-economy ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:digital-goods,
        ngm:immersive-experience ;
    vc:slug "game-mechanics" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:economic-parameters,
        ngm:smart-contract .

ngm:game-narratives a owl:Class ;
    rdfs:label "Game Narratives"@en ;
    rdfs:comment "Interactive storytelling frameworks within metaverse gaming environments featuring branching storylines, player-driven plot progression, and adaptive narratives that evolve based on collective player decisions, creating dynamic and personalised gaming experiences."@en ;
    rdfs:subClassOf ngm:interactive-storytelling,
        ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:enables ngm:immersive-gaming-experiences ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:slug "game-narratives" ;
    vc:sourceDomain "spatial-computing" .

ngm:general-purpose-ai-model a owl:Class ;
    rdfs:label "General Purpose AI Model"@en ;
    rdfs:comment "An AI model that displays significant generality and is capable of competently performing a wide range of distinct tasks regardless of the way the model is placed on the market, as defined by EU AI Act Article 3(63). GPAI models face specific transparency and documentation obligations, with enhanced requirements for those meeting systemic risk thresholds based on training compute or high-impact capability benchmarks."@en ;
    rdfs:subClassOf ngm:ai-model-architecture ;
    skos:broader ngm:ai-model-architecture ;
    vc:dependsOn ngm:ai-governance,
        ngm:ai-regulation ;
    vc:enables ngm:large-language-models ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:ai-governance-framework ;
    vc:slug "general-purpose-ai-model" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:fine-tuning,
        ngm:pre-training,
        ngm:transformer-architecture .

ngm:geospatial-engine a owl:Class ;
    rdfs:label "Geospatial Engine"@en ;
    rdfs:comment "Software platforms that stream, render, and process large volumes of geographic and 3D spatial data in real-time for metaverse applications, enabling digital twins of real-world locations, location-based experiences, and integration between physical geography and virtual environments."@en ;
    rdfs:subClassOf ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:enables ngm:geospatially-accurate-metaverse ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:slug "geospatial-engine" ;
    vc:sourceDomain "spatial-computing" .

ngm:geospatial-information a owl:Class ;
    rdfs:label "Geospatial Information"@en ;
    rdfs:comment "Geospatial Information is data that describes objects, events, or phenomena with reference to a location on or near the Earth's surface. It integrates coordinate systems, geographic data layers, and spatial analytics to support location-aware applications including digital twins, augmented reality overlays, and urban simulation."@en ;
    rdfs:subClassOf ngm:sc-standards-and-interop ;
    skos:broader ngm:sc-standards-and-interop ;
    vc:enables ngm:geospatial-engine,
        ngm:location-based-experience ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:relatedTo ngm:geospatial-technology,
        ngm:spatial-data-structure ;
    vc:slug "geospatial-information" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:coordinate-system,
        ngm:lidar,
        ngm:point-cloud .

ngm:geospatial-technology a owl:Class ;
    rdfs:label "Geospatial Technology"@en ;
    rdfs:comment "Geospatial Technology encompasses the tools, systems, and methods used to acquire, process, analyse, and visualise spatially referenced data about the Earth's surface and built environment. In spatial computing and metaverse contexts, it underpins world-scale anchoring, location-based experiences, digital twin construction of urban environments, and precise coordinate registration between physical and virtual spaces."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:geospatial-information ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:gps ],
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:enables ngm:digital-twin,
        ngm:location-based-experience ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:geospatial-information,
        ngm:gps ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:spatial-computing ;
    vc:slug "geospatial-technology" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:geospatial-engine,
        ngm:lidar .

ngm:global-explanation a owl:Class ;
    rdfs:label "Global Explanation"@en ;
    rdfs:comment "Interpretability techniques that characterise the overall behaviour, decision-making patterns, and feature importance of a machine learning model across its entire input space, rather than explaining individual predictions. Global explanations—such as feature importance rankings, partial dependence plots, and surrogate model trees—reveal systematic model tendencies and support auditing, debugging, and regulatory compliance."@en ;
    rdfs:subClassOf ngm:ai-technique,
        ngm:explainability ;
    skos:broader ngm:ai-technique ;
    vc:contrastsWith ngm:local-explanation ;
    vc:enables ngm:fairness,
        ngm:model-transparency ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:explainable-ai ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:slug "global-explanation" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:feature-importance,
        ngm:model-interpretability .

ngm:global-inequality a owl:Class ;
    rdfs:label "Global Inequality"@en ;
    rdfs:comment "Global Inequality is the systematic, multi-dimensional divergence in life chances, material resources, political power, and technological access experienced by individuals, households, communities, and nations across the world economic order — encompassing income inequality (the Gini coefficient ..."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:gini-coefficient ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:financial-inclusion ],
        ngm:ai-governance-and-ethics,
        ngm:development-economics,
        ngm:distributive-justice ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:enables ngm:digital-infrastructure-investment,
        ngm:policy-design,
        ngm:progressive-wealth-tax,
        ngm:redistributive-taxation,
        ngm:social-protection,
        ngm:universal-basic-income ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:compute-divide,
        ngm:digital-divide,
        ngm:financial-inclusion,
        ngm:gender-pay-gap,
        ngm:gini-coefficient,
        ngm:income-inequality,
        ngm:intergenerational-mobility,
        ngm:labour-income-share,
        ngm:wealth-inequality ;
    vc:implements ngm:atkinson-index,
        ngm:gini-coefficient,
        ngm:human-development-index,
        ngm:palma-ratio,
        ngm:s80-s20-ratio,
        ngm:top-income-shares ;
    vc:qualityScore "0.52"^^xsd:float ;
    vc:relatedTo ngm:ai-labour-displacement,
        ngm:austerity,
        ngm:cbdcs,
        ngm:climate-change,
        ngm:financial-technology,
        ngm:financialisation,
        ngm:human-development-index,
        ngm:migration,
        ngm:poverty,
        ngm:social-mobility,
        ngm:universal-basic-income ;
    vc:requires ngm:distributional-data,
        ngm:household-survey-data,
        ngm:national-accounts,
        ngm:tax-record-microdata,
        ngm:world-inequality-database ;
    vc:slug "global-inequality" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:standardizedBy ngm:ilo-decent-work-agenda,
        ngm:oecd-guidelines-on-measuring-inequality,
        ngm:united-nations-sustainable-development-goals,
