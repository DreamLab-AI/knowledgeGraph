ngm:propagation-delay a owl:Class ;
    rdfs:label "Propagation Delay"@en ;
    rdfs:comment "Propagation delay is the time a signal takes to travel from sender to receiver across a transmission medium, determined by the physical distance divided by the signal's propagation speed. Bounded by the speed of light and reduced in copper or fibre by the medium's refractive properties, it sets a hard floor on network latency that no amount of bandwidth can remove. Propagation delay is one of several additive components of end-to-end latency, alongside transmission, queuing, and processing delays."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:network-topology ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:latency ],
        ngm:network-latency ;
    vc:bridgesTo ngm:infrastructure ;
    vc:contrastsWith ngm:bandwidth,
        ngm:transmission-delay ;
    vc:dependsOn ngm:network-topology,
        ngm:packet-switching ;
    vc:enables ngm:round-trip-time ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:latency ;
    vc:isPartOf ngm:network-latency ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:bandwidth,
        ngm:jitter,
        ngm:transmission-delay ;
    vc:requires ngm:network-topology ;
    vc:slug "propagation-delay" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:low-latency .

ngm:proposal-distribution a owl:Class ;
    rdfs:label "Proposal Distribution"@en ;
    rdfs:comment "A proposal distribution is an auxiliary distribution used in Monte Carlo methods to generate candidate samples when sampling directly from a target distribution is infeasible. In importance sampling, Metropolis-Hastings, and particle filters it determines where samples are drawn, and its closeness to the target governs efficiency and variance. A poorly chosen proposal causes sample degeneracy or slow mixing."@en ;
    rdfs:subClassOf ngm:machine-learning-discipline ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:particle-filter,
        ngm:sampling ;
    vc:slug "proposal-distribution" ;
    vc:sourceDomain "ai" .

ngm:proprietary-protocol a owl:Class ;
    rdfs:label "Proprietary Protocol"@en ;
    rdfs:comment "A proprietary protocol is a communication or data-exchange protocol owned and controlled by a single organisation, whose specification is closed, licensed, or undocumented rather than openly published. Such protocols can enable tight vendor integration and rapid iteration but tend to inhibit interoperability and create dependence on the controlling vendor. They contrast with open standards, which are publicly specified and freely implementable to promote cross-vendor compatibility."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:api ],
        ngm:communication-protocol ;
    vc:contrastsWith ngm:network-protocol,
        ngm:open-standard ;
    vc:dependsOn ngm:standards ;
    vc:enables ngm:interoperability ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:standards ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:interoperability,
        ngm:network-protocol,
        ngm:open-standard,
        ngm:standards ;
    vc:requires ngm:api ;
    vc:slug "proprietary-protocol" ;
    vc:sourceDomain "standards" ;
    vc:supports ngm:communication-protocol ;
    vc:uses ngm:api .

ngm:proprioceptive-sensing a owl:Class ;
    rdfs:label "Proprioceptive Sensing"@en ;
    rdfs:comment "Proprioceptive sensing is a robot's perception of its own internal state, such as joint angles, motor torques, link velocities, and body orientation, as distinct from exteroceptive sensing of the external environment. It relies on encoders, force/torque sensors, and inertial measurement units. It is essential for balance, whole-body control, and safe interaction, especially in legged and humanoid robots."@en ;
    rdfs:subClassOf ngm:robo-perception ;
    skos:broader ngm:robo-perception ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:humanoid-robot,
        ngm:mechanical-component ;
    vc:slug "proprioceptive-sensing" ;
    vc:sourceDomain "robotics" .

ngm:proto-danksharding a owl:Class ;
    rdfs:label "Proto-Danksharding"@en ;
    rdfs:comment "Proto-danksharding is an Ethereum scaling upgrade, specified in EIP-4844, that introduces blob-carrying transactions to provide cheap, temporary data availability for layer-2 rollups. It adds a new transaction type carrying large binary data blobs that are not accessible to the Ethereum Virtual Machine and are pruned after a short retention period, with KZG commitments proving their contents. It is an incremental step towards the full danksharding design."@en ;
    rdfs:subClassOf ngm:data-availability ;
    vc:bridgesTo ngm:danksharding,
        ngm:sharding ;
    vc:enables ngm:data-availability,
        ngm:scalability ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:implements ngm:blob-transaction,
        ngm:eip-4844 ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:ethereum,
        ngm:layer-2-scaling,
        ngm:optimistic-rollup,
        ngm:rollup,
        ngm:zk-rollup ;
    vc:slug "proto-danksharding" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:layer-2-scaling,
        ngm:rollup ;
    vc:uses ngm:blob-transaction,
        ngm:kzg-commitment .

ngm:protocol-design a skos:Concept ;
    rdfs:label "Protocol Design"@en .

ngm:proximity-detection a owl:Class ;
    rdfs:label "Proximity Detection"@en ;
    rdfs:comment "Proximity Detection is the computational process of determining the spatial distance and relative position between entities—users, objects, or agents—within a virtual or physical environment in real time. In metaverse and robotics contexts it underpins social-distance awareness, collision avoidance, interaction triggering, and context-sensitive content delivery. Implementations range from bounding-volume overlap tests and signed-distance fields in 3D engines to sensor-fusion pipelines combining lidar, ultrasound, and camera inputs in robotic systems."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:collision-detection ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:sensor-fusion ],
        ngm:infra-computing-and-cloud ;
    skos:broader ngm:infra-computing-and-cloud ;
    vc:enables ngm:collision-avoidance,
        ngm:presence-detection ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:social-presence ;
    vc:requires ngm:collision-detection,
        ngm:sensor-fusion ;
    vc:slug "proximity-detection" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:lidar,
        ngm:point-cloud .

ngm:python-3 a owl:Class ;
    rdfs:label "Python 3"@en ;
    rdfs:comment "Python 3 is the current major series of the Python programming language, a high-level, dynamically typed, interpreted language emphasising readability and a large standard library. It is the dominant language for machine learning, data science, automation, and robotics scripting, supported by an extensive ecosystem of scientific and AI packages. Python 3 introduced Unicode-by-default strings and other breaking changes relative to the discontinued Python 2 series."@en ;
    rdfs:subClassOf ngm:programming-language ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:lang-chain,
        ngm:robot-operating-system ;
    vc:slug "python-3" ;
    vc:sourceDomain "infrastructure" .

ngm:qlo-ra a owl:Class ;
    rdfs:label "QLoRA"@en ;
    rdfs:comment "An extension of LoRA (Low-Rank Adaptation) that combines 4-bit NormalFloat quantisation of frozen base model weights with full-precision trainable low-rank adapter matrices. QLoRA additionally employs double quantisation and paged optimisers to achieve extreme memory efficiency, enabling fine-tuning of 65B-parameter models on a single 48GB GPU without significant performance degradation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:quantisation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:neural-network-quantisation ],
        ngm:ai-technique,
        ngm:parameter-efficient-fine-tuning ;
    skos:broader ngm:ai-technique ;
    vc:enables ngm:domain-adaptation,
        ngm:federated-learning ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:knowledge-distillation ;
    vc:requires ngm:neural-network-quantisation,
        ngm:quantisation ;
    vc:slug "qlo-ra" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:fine-tuning,
        ngm:large-language-models .

ngm:qualified-custodian a owl:Class ;
    rdfs:label "Qualified Custodian"@en ;
    rdfs:comment "A qualified custodian is a regulated financial institution authorised to hold client assets, including digital assets, under fiduciary and supervisory standards set by securities regulators. It provides segregated accounts, independent audit and statutory protections that distinguish it from informal custody arrangements. For institutional investors, using a qualified custodian is often a regulatory precondition for holding crypto assets."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:know-your-customer ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:regulatory-compliance ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:securities-regulation ],
        ngm:digital-asset-custody ;
    vc:contrastsWith ngm:custodial-wallet,
        ngm:self-custody ;
    vc:dependsOn ngm:compliance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:audit-trail ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:custodial-exchange,
        ngm:digital-asset-custody ;
    vc:requires ngm:know-your-customer,
        ngm:regulatory-compliance,
        ngm:securities-regulation ;
    vc:slug "qualified-custodian" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:asset-management,
        ngm:custody ;
    vc:uses ngm:cold-storage,
        ngm:proof-of-reserve .

ngm:quantum-key-distribution a owl:Class ;
    rdfs:label "Quantum Key Distribution"@en ;
    rdfs:comment "A method of securely sharing cryptographic keys using the principles of quantum mechanics, such that any eavesdropping disturbs the transmission and can be detected. It provides key exchange whose security rests on physics rather than computational hardness."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:quantum-computation-paradigm ],
        ngm:quantum-computation-paradigm ;
    vc:enables ngm:post-quantum-cryptography ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:quantum-computation-paradigm ;
    vc:slug "quantum-key-distribution" ;
    vc:sourceDomain "security" .

ngm:radio-transceiver a owl:Class ;
    rdfs:label "Radio Transceiver"@en ;
    rdfs:comment "A radio transceiver is a hardware device that combines a transmitter and receiver in a single unit to send and receive radio-frequency signals over a shared channel. It performs modulation, demodulation, amplification, and frequency conversion, forming the physical link layer of wireless devices. Transceivers underpin IoT nodes, mobile devices, and short-range wireless links."@en ;
    rdfs:subClassOf ngm:hardware ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:io-t-sensor-network,
        ngm:wireless-radio ;
    vc:slug "radio-transceiver" ;
    vc:sourceDomain "infrastructure" .

ngm:radiology-ai a owl:Class ;
    rdfs:label "Radiology AI"@en ;
    rdfs:comment "Radiology AI comprises artificial intelligence systems designed for automated interpretation and quantitative analysis of radiological imaging modalities — X-ray, CT, MRI, and ultrasound. These systems perform lesion detection, organ segmentation, and structured reporting at radiologist-level accuracy, integrating with PACS workflows and validated through prospective clinical trials."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:medical-imaging ],
        ngm:ai-application,
        ngm:medical-imaging-ai ;
    skos:broader ngm:ai-application ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:computer-vision,
        ngm:object-detection ;
    vc:requires ngm:medical-imaging ;
    vc:slug "radiology-ai" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:convolutional-neural-network,
        ngm:image-segmentation .

ngm:rb-0024-workspace a owl:Class ;
    rdfs:label "rb 0024 workspace"@en ;
    rdfs:comment "The workspace of a robot manipulator is the total volume of space that the end-effector can reach, given the joint range limits of all links. The reachable workspace encompasses every point the tool-centre-point (TCP) can attain in at least one orientation, while the dexterous workspace is the subset reachable in all possible orientations. Workspace volume, shape, and dexterity distribution are primary design criteria for robot selection and cell layout, and must account for self-collisions, payload, and safety exclusion zones."@en ;
    rdfs:subClassOf ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:dependsOn ngm:rb-0021-robot-kinematics,
        ngm:rb-0026-robot-joint ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:manipulator-arm,
        ngm:rb-0023-degrees-of-freedom,
        ngm:rb-0031-singularity,
        ngm:rb-0033-payload,
        ngm:rb-0037-dexterity,
        ngm:rb-0095-safety-zone ;
    vc:slug "rb-0024-workspace" ;
    vc:sourceDomain "robotics" .

ngm:rb-0039-stiffness a owl:Class ;
    rdfs:label "rb 0039 stiffness"@en ;
    rdfs:comment "Stiffness, in robotics, is the ratio of applied force (or torque) to the resulting displacement (or angular deflection) of a robot link, joint, or end-effector. High stiffness yields precise positioning at the cost of storing large elastic energy that can be hazardous in contact; low stiffness (compliance) absorbs impact and is preferred in human-robot collaboration. Variable-stiffness actuation and impedance control allow robots to modulate stiffness dynamically, trading accuracy against safety depending on task context."@en ;
    rdfs:subClassOf ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:contrastsWith ngm:rb-0027-robot-link ;
    vc:enables ngm:force-control,
        ngm:soft-robotics ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:compliance-control,
        ngm:impedance-control,
        ngm:inertia,
        ngm:rigid-body-dynamics,
        ngm:robot-dynamics ;
    vc:slug "rb-0039-stiffness" ;
    vc:sourceDomain "robotics" .

ngm:rb-0055-velocity-control a owl:Class ;
    rdfs:label "rb 0055 velocity control"@en ;
    rdfs:comment "Velocity control is a robot control strategy in which joint or Cartesian velocities are the primary commanded quantities, with a feedback controller (typically PID-based) continuously correcting deviations between desired and measured velocities. It is used for smooth trajectory following, compliant interaction with soft contacts, and speed-and-separation monitoring safety functions that require real-time speed capping. Velocity control is distinct from position control — it does not inherently resist positional drift — and from torque control, which acts at the force level."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:feedback-control ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:encoder ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:pid-controller ],
        ngm:motion-control,
        ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:enables ngm:rb-0092-protective-stop,
        ngm:trajectory-planning ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:position-control,
        ngm:torque-control,
        ngm:velocity,
        ngm:velocity-control ;
    vc:requires ngm:encoder,
        ngm:feedback-control,
        ngm:pid-controller ;
    vc:slug "rb-0055-velocity-control" ;
    vc:sourceDomain "robotics" .

ngm:rb-0057-admittance-control a owl:Class ;
    rdfs:label "rb 0057 admittance control"@en ;
    rdfs:comment "Admittance control is an interaction-control strategy in which a robot measures contact forces and torques and converts them into corresponding desired motion (position or velocity) using a virtual mass-spring-damper model. It is the dual of impedance control: the robot senses force input and renders motion output, enabling compliant, safe physical human-robot interaction in collaborative tasks."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:force-control ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:rb-0067-force-torque-sensor ],
        ngm:interaction-control,
        ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:contrastsWith ngm:impedance-control ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:compliance-control,
        ngm:rb-0041-inertia,
        ngm:rb-0053-force-control,
        ngm:rb-0056-impedance-control ;
    vc:requires ngm:force-control,
        ngm:rb-0067-force-torque-sensor ;
    vc:slug "rb-0057-admittance-control" ;
    vc:sourceDomain "robotics" ;
    vc:supports ngm:human-robot-interaction,
        ngm:rb-0094-power-and-force-limiting .

ngm:rb-0068-vision-system a owl:Class ;
    rdfs:label "rb 0068 vision system"@en ;
    rdfs:comment "A robotic vision system is an integrated sensor subsystem that captures and processes visual data—using cameras, depth sensors, or LiDAR—to provide a robot with spatial awareness, object recognition, and scene understanding capabilities. Vision systems underpin tasks including visual servoing, part inspection, SLAM-based localisation, and human-robot interaction, and conform to ISO 8373:2021 perception-system definitions."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:rb-0077-depth-camera ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:rb-0066-robot-sensor ],
        ngm:robo-perception ;
    skos:broader ngm:robo-perception ;
    vc:enables ngm:human-robot-interaction,
        ngm:rb-0065-visual-servoing ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:rb-0066-robot-sensor,
        ngm:rb-0077-depth-camera ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:perception-system,
        ngm:rb-0069-lidar ;
    vc:slug "rb-0068-vision-system" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:computer-vision,
        ngm:object-detection,
        ngm:point-cloud,
        ngm:slam .

ngm:rdf-triple-store a owl:Class ;
    rdfs:label "RDF Triple Store"@en ;
    rdfs:comment "An RDF triple store is a purpose-built database for storing and querying data as subject-predicate-object triples following the Resource Description Framework model. It supports the SPARQL query language and often provides reasoning over ontologies to infer implicit facts. Triple stores are the backbone of semantic-web, knowledge-graph, and linked-data applications."@en ;
    rdfs:subClassOf ngm:data-management ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:graph-database,
        ngm:metaverse-ontology-schema ;
    vc:slug "rdf-triple-store" ;
    vc:sourceDomain "data" .

ngm:real-time-collaborative-editing a owl:Class ;
    rdfs:label "Real-Time Collaborative Editing"@en ;
    rdfs:comment "Real-time collaborative editing is the capability for multiple users to concurrently modify a shared document or data structure and see each other's changes near-instantaneously with automatic conflict resolution. It depends on synchronisation algorithms such as operational transformation or conflict-free replicated data types to maintain a consistent merged state across replicas. It underpins shared documents, whiteboards, and collaborative virtual workspaces."@en ;
    rdfs:subClassOf ngm:distributed-systems ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:crdt ;
    vc:slug "real-time-collaborative-editing" ;
    vc:sourceDomain "infrastructure" .

ngm:real-time-messaging a owl:Class ;
    rdfs:label "Real Time Messaging"@en ;
    rdfs:comment "Real-time messaging is the exchange of messages between participants with sub-second latency, so that communication feels instantaneous and conversational. It relies on persistent, bidirectional transport such as WebSockets and on patterns like publish-subscribe to fan out events to many recipients. Real-time messaging underpins chat, presence, notifications and live collaboration across distributed systems."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:notification-system ],
        ngm:real-time-communication ;
    vc:dependsOn ngm:event-streaming ;
    vc:enables ngm:event-driven-architecture ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:notification-system,
        ngm:presence-awareness ;
    vc:implements ngm:event-streaming,
        ngm:instant-messaging ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:message-queue,
        ngm:notification-system,
        ngm:real-time-communication ;
    vc:slug "real-time-messaging" ;
    vc:sourceDomain "distributed-collaboration" ;
    vc:supports ngm:slack ;
    vc:uses ngm:message-queue,
        ngm:websocket .

ngm:real-world-asset a owl:Class ;
    rdfs:label "Real World Asset"@en ;
    rdfs:comment "A real-world asset (RWA) is a tangible or off-chain financial asset, such as real estate, commodities, invoices, bonds or equities, whose ownership or economic rights are represented on a blockchain as a token. Tokenisation links the on-chain representation to legal claims and custody arrangements in the physical or traditional financial world. RWAs bridge decentralised finance with regulated, conventional asset markets."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:identity-verification ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:custody ],
        ngm:digital-asset ;
    vc:bridgesTo ngm:asset-management,
        ngm:de-fi ;
    vc:contrastsWith ngm:cryptocurrency ;
    vc:dependsOn ngm:settlement ;
    vc:enables ngm:fractional-ownership,
        ngm:liquidity-pool ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:implements ngm:asset-tokenization,
        ngm:real-world-asset-tokenisation ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:cryptocurrency,
        ngm:stablecoin ;
    vc:requires ngm:custody,
        ngm:identity-verification ;
    vc:slug "real-world-asset" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:securitization ;
    vc:uses ngm:smart-contract,
        ngm:tokenization .

ngm:reality-capture a owl:Class ;
    rdfs:label "Reality Capture"@en ;
    rdfs:comment "Reality capture is the process of digitising the physical world into accurate, measurable 3D representations using sensors such as LiDAR scanners, photogrammetric camera arrays, and depth cameras, producing point clouds, textured meshes, or digital twin models. It encompasses the full workflow from on-site data acquisition to processing, georeferencing, and delivery of survey-grade or visualisation-grade 3D assets. Reality capture is foundational to construction, heritage preservation, urban digital twins, and spatial computing content pipelines."@en ;
    rdfs:subClassOf ngm:etsi-domain-reality-capture ;
    vc:enables ngm:environmental-mapping,
        ngm:point-cloud-processing ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:3-d-scanning,
        ngm:geospatial-technology ;
    vc:slug "reality-capture" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:laser-scanner,
        ngm:lidar-scanning,
        ngm:multi-view-stereo,
        ngm:photogrammetry .

ngm:reality-capture-system a owl:Class ;
    rdfs:label "Reality Capture System"@en ;
    rdfs:comment "Physical hardware system comprising 3D scanners, LIDAR sensors, photogrammetry cameras, and associated equipment for acquiring spatial and visual data from real-world environments to create digital representations."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:motion-capture-rig ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:lidar-sensor ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:spatial-calibration ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-processing-hardware ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:tracking-system ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:depth-sensor ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:point-cloud-processing ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:storage-infrastructure ],
        ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:enables ngm:3-d-generation,
        ngm:digital-twin-creation,
        ngm:visual-representation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:depth-sensor,
        ngm:lidar-sensor,
        ngm:motion-capture-rig,
        ngm:point-cloud-processing,
        ngm:tracking-system ;
    vc:isPartOf ngm:digital-twin-creation-pipeline,
        ngm:virtual-production-workflow ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:data-processing-hardware,
        ngm:spatial-calibration,
        ngm:storage-infrastructure ;
    vc:slug "reality-capture-system" ;
    vc:sourceDomain "spatial-computing" .

ngm:realtime-collaboration a owl:Class ;
    rdfs:label "Realtime Collaboration"@en ;
    rdfs:comment "Realtime Collaboration is the capability for multiple geographically distributed users to co-create, co-edit, and synchronise shared digital artefacts—documents, 3D scenes, code, or virtual environments—with sub-second latency, such that all participants observe consistent state simultaneously. Technically, it requires low-latency networking, conflict-resolution mechanisms such as CRDTs or operational transforms, and state-synchronisation protocols to reconcile concurrent edits without data loss."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:crdt ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:multi-user-systems ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:network-latency ],
        ngm:infra-network-and-comms ;
    skos:broader ngm:infra-network-and-comms ;
    vc:enables ngm:distributed-collaboration,
        ngm:immersive-workspaces,
        ngm:virtual-meeting ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:metaverse-and-telecollaboration,
        ngm:social-presence ;
    vc:requires ngm:crdt,
        ngm:multi-user-systems,
        ngm:network-latency ;
    vc:slug "realtime-collaboration" ;
    vc:sourceDomain "infrastructure" .

ngm:reciprocal-rank-fusion a owl:Class ;
    rdfs:label "Reciprocal Rank Fusion"@en ;
    rdfs:comment "Reciprocal Rank Fusion (RRF) is a rank-aggregation method that combines multiple ranked result lists by summing the reciprocal of each document's rank across lists, weighted by a small smoothing constant. It requires no score calibration between systems, making it ideal for merging lexical and vector retrieval results in hybrid search. Its robustness and parameter simplicity have made it a default fusion technique in modern retrieval pipelines."@en ;
    rdfs:subClassOf ngm:information-retrieval ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:ai-search,
        ngm:semantic-search ;
    vc:slug "reciprocal-rank-fusion" ;
    vc:sourceDomain "ai" .

ngm:reentrancy-attack a owl:Class ;
    rdfs:label "Reentrancy Attack"@en ;
    rdfs:comment "A reentrancy attack is a smart-contract exploit in which a malicious contract repeatedly re-enters a vulnerable function before its state is updated, draining funds or corrupting state. It arises when a contract makes an external call before completing its own bookkeeping, allowing the callee to recursively invoke the caller. The class of bug was made notorious by the DAO incident and is mitigated by the checks-effects-interactions pattern and reentrancy guards."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:smart-contract ],
        ngm:blockchain-security ;
    vc:bridgesTo ngm:security-audit ;
    vc:contrastsWith ngm:security-audit ;
    vc:dependsOn ngm:solidity ;
    vc:enables ngm:vulnerability ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:attack-vector ;
    vc:isPartOf ngm:blockchain-security ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:ethereum,
        ngm:gas,
        ngm:solidity,
        ngm:state-change ;
    vc:requires ngm:smart-contract ;
    vc:slug "reentrancy-attack" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:vulnerability ;
    vc:uses ngm:state-change .

ngm:reference-frames a owl:Class ;
    rdfs:label "Reference Frames"@en ;
    rdfs:comment "A reference frame is a coordinate system, anchored to a chosen origin and orientation, against which positions, velocities, and orientations are measured. In robotics each link, sensor, and the world itself has its own frame, and motion is described by transformations between them. Correct frame definitions are essential for sensor fusion, kinematics, and consistent spatial reasoning."@en ;
    rdfs:subClassOf ngm:robo-navigation-and-planning ;
    skos:broader ngm:robo-navigation-and-planning ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:coordinate-transformation,
        ngm:kinematics-model ;
    vc:slug "reference-frames" ;
    vc:sourceDomain "robotics" .

ngm:reference-standard a owl:Class ;
    rdfs:label "Reference Standard"@en ;
    rdfs:comment "Reference Standard is a technology infrastructure concept and a type of infrastructure."@en ;
    rdfs:subClassOf ngm:infra-legal-and-regulatory ;
    skos:broader ngm:infra-legal-and-regulatory ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:implements ngm:technology-infrastructure ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:slug "reference-standard" ;
    vc:sourceDomain "infrastructure" .

ngm:regulatory-clarity a owl:Class ;
    rdfs:label "Regulatory Clarity"@en ;
    rdfs:comment "The condition in which the rules applying to an activity or product are sufficiently clear and predictable for participants to assess their legal obligations with confidence."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:transparency ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:rule-of-law ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:regulatory-framework ],
        ngm:regulatory-framework ;
    vc:bridgesTo ngm:artificial-intelligence,
        ngm:blockchain,
        ngm:digital-asset ;
    vc:dependsOn ngm:regulatory-guidance ;
    vc:enables ngm:compliance,
        ngm:market-confidence,
        ngm:regulatory-compliance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:financial-regulation,
        ngm:governance,
        ngm:jurisdiction,
        ngm:policy ;
    vc:requires ngm:regulatory-framework,
        ngm:rule-of-law,
        ngm:transparency ;
    vc:slug "regulatory-clarity" ;
    vc:sourceDomain "governance" ;
    vc:supports ngm:consumer-protection,
        ngm:innovation .

ngm:regulatory-enforcement a owl:Class ;
    rdfs:label "Regulatory Enforcement"@en ;
    rdfs:comment "Regulatory enforcement is the set of actions through which a competent authority compels compliance with laws and rules and sanctions those who breach them. It encompasses investigation, supervision, market surveillance, and the imposition of remedies such as fines, restitution, licence revocation or criminal referral. In financial markets it deters misconduct, protects consumers and investors, and sustains confidence in the integrity of the system."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:audit ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:regulation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:market-surveillance ],
        ngm:regulation ;
    vc:enables ngm:compliance,
        ngm:consumer-protection ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:financial-regulation,
        ngm:securities-regulation ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:financial-conduct-authority,
        ngm:self-regulation ;
    vc:requires ngm:audit,
        ngm:market-surveillance,
        ngm:regulation ;
    vc:slug "regulatory-enforcement" ;
    vc:sourceDomain "governance" ;
    vc:standardizedBy ngm:iosco ;
    vc:supports ngm:regulatory-compliance,
        ngm:rule-of-law ;
    vc:uses ngm:market-surveillance .

ngm:regulatory-standards a owl:Class ;
    rdfs:label "Regulatory Standards"@en ;
    rdfs:comment "Legal and compliance frameworks governing metaverse and extended reality platforms, including data protection (GDPR), artificial intelligence (EU AI Act), digital services (DSA), and accessibility requirements that ensure user rights protection in immersive environments."@en ;
    rdfs:subClassOf ngm:sc-standards-and-interop ;
    skos:broader ngm:sc-standards-and-interop ;
    vc:enables ngm:user-protection ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:implements ngm:compliance-framework ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:slug "regulatory-standards" ;
    vc:sourceDomain "spatial-computing" .

ngm:relay-network a owl:Class ;
    rdfs:label "Relay Network"@en ;
    rdfs:comment "A Relay Network is a set of intermediary nodes that forward messages, transactions, or data between participants who are not directly connected, improving reach, latency, privacy, or censorship-resistance. Relays do not necessarily originate or consume the content they pass on; they propagate it across the topology so that information reaches its destination efficiently. In blockchain systems, relay networks accelerate block and transaction propagation and connect cross-chain messaging; in privacy systems such as Tor and Nostr, relays forward traffic to obscure origin or to disseminate events. Relay networks depend on robust routing, redundancy, and incentive or trust assumptions."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:network-topology ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:overlay-network ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:routing-protocol ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:peer-to-peer-network ],
        ngm:overlay-network ;
    vc:contrastsWith ngm:mesh-network ;
    vc:dependsOn ngm:network-infrastructure,
        ngm:node ;
    vc:enables ngm:anonymity,
        ngm:cross-chain-messaging ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:overlay-network,
        ngm:peer-to-peer-network ;
    vc:implements ngm:onion-routing ;
    vc:isPartOf ngm:overlay-network ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:cross-chain-bridge,
        ngm:latency ;
    vc:requires ngm:network-topology,
        ngm:routing-protocol ;
    vc:slug "relay-network" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:nostr,
        ngm:tor ;
    vc:uses ngm:gossip-protocol,
        ngm:message-passing .

ngm:request-response-pattern a owl:Class ;
    rdfs:label "Request-Response Pattern"@en ;
    rdfs:comment "The request-response pattern is a synchronous message-exchange model in which a client sends a request to a server and blocks, or awaits, until a corresponding response is returned. It establishes a one-to-one, correlated interaction where each request expects exactly one reply, forming the basis of most client-server communication. The pattern contrasts with asynchronous, event-driven, and publish-subscribe styles where senders do not wait for an immediate reply."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:network-protocol ],
        ngm:infrastructure ;
    skos:broader ngm:infrastructure ;
    vc:bridgesTo ngm:microservices-architecture ;
    vc:contrastsWith ngm:event-driven-architecture,
        ngm:message-queue,
        ngm:webhook ;
    vc:dependsOn ngm:distributed-systems ;
    vc:enables ngm:api,
        ngm:microservices ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:http,
        ngm:remote-procedure-call ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:http-protocol,
        ngm:idempotency,
        ngm:latency ;
    vc:requires ngm:network-protocol ;
    vc:slug "request-response-pattern" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:rest,
        ngm:service-mesh ;
    vc:uses ngm:network-protocol,
        ngm:rest-api .

ngm:restful-api a owl:Class ;
    rdfs:label "RESTful API"@en ;
    rdfs:comment "A RESTful API is a web application programming interface that follows the Representational State Transfer architectural style, exposing resources identified by URIs and manipulated through a uniform set of HTTP methods. It is stateless, treats responses as representations of resource state, and uses standard status codes and media types so clients and servers can evolve independently. RESTful design favours predictable, cacheable, hypermedia-driven interactions over the web."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:stateless-protocol ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:hateoas ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:http ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:http ],
        ngm:web-api ;
    vc:bridgesTo ngm:api-gateway ;
    vc:contrastsWith ngm:graphql,
        ngm:soap ;
    vc:enables ngm:api-management,
        ngm:web-services ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:hateoas,
        ngm:http ;
    vc:implements ngm:idempotency,
        ngm:rest-api ;
    vc:isPartOf ngm:api-design,
        ngm:web-api ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:hateoas,
        ngm:rest-api ;
    vc:requires ngm:http,
        ngm:stateless-protocol ;
    vc:slug "restful-api" ;
    vc:sourceDomain "infrastructure" ;
    vc:standardizedBy ngm:openapi ;
    vc:supports ngm:api-design,
        ngm:microservices ;
    vc:uses ngm:caching,
        ngm:http .

ngm:retail-cbdc a owl:Class ;
    rdfs:label "Retail CBDC"@en ;
    rdfs:comment "A retail central bank digital currency (CBDC) is a digital form of sovereign money issued directly by a central bank for use by the general public in everyday payments. Unlike wholesale CBDCs, which serve interbank settlement, retail CBDCs target consumers and merchants and may use account-based or token-based designs over distributed or centralised ledgers. They aim to provide a public digital payment instrument with central-bank credit safety."@en ;
    rdfs:subClassOf ngm:bc-token-and-asset ;
    skos:broader ngm:bc-token-and-asset ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:cbdcs,
        ngm:distributed-ledger ;
    vc:slug "retail-cbdc" ;
    vc:sourceDomain "blockchain" .

ngm:revenue-distribution a owl:Class ;
    rdfs:label "Revenue Distribution"@en ;
    rdfs:comment "Revenue Distribution is the mechanism by which income generated by a platform, protocol, or creative ecosystem is allocated among contributors, token holders, and operational costs. In Web3 and spatial computing contexts, it is commonly encoded in smart contracts via tokenomics rules, protocol fee splits, and DAO-governed treasury allocations."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:tokenomics ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:smart-contract ],
        ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:economic-systems ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:relatedTo ngm:dao-governance,
        ngm:treasury-management ;
    vc:requires ngm:smart-contract,
        ngm:tokenomics ;
    vc:slug "revenue-distribution" ;
    vc:sourceDomain "spatial-computing" .

ngm:rgb-d-camera a owl:Class ;
    rdfs:label "RGB-D Camera"@en ;
    rdfs:comment "An RGB-D camera is a sensor that captures both colour (RGB) imagery and per-pixel depth (D) information in a single aligned frame. Depth is typically derived from structured light, time-of-flight, or stereo techniques, yielding a dense 3D representation of the scene. RGB-D cameras are widely used in robotics for perception, mapping, and manipulation because they combine appearance and geometry cheaply."@en ;
    rdfs:subClassOf ngm:sensor ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:depth-estimation,
        ngm:robotics-platform ;
    vc:slug "rgb-d-camera" ;
    vc:sourceDomain "robotics" .

ngm:right-to-erasure a owl:Class ;
    rdfs:label "Right To Erasure"@en ;
    rdfs:comment "The right to erasure, also known as the right to be forgotten, is a data-subject right under the UK GDPR and EU GDPR that allows individuals to require a controller to delete their personal data in defined circumstances. It applies where data is no longer necessary, consent is withdrawn, processing is unlawful, or the data subject objects without overriding legitimate grounds. The right is qualified by exemptions such as freedom of expression, legal obligations, and the public interest."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:consent-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:consent-management ],
        ngm:data-subject-rights ;
    vc:bridgesTo ngm:privacy-by-design ;
    vc:contrastsWith ngm:distributed-ledger ;
    vc:dependsOn ngm:gdpr,
        ngm:uk-gdpr ;
    vc:enables ngm:data-protection,
        ngm:privacy-by-design ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:consent-management ;
    vc:isPartOf ngm:uk-gdpr ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:data-subject-rights,
        ngm:gdpr,
        ngm:right-to-be-forgotten ;
    vc:requires ngm:consent-management ;
    vc:slug "right-to-erasure" ;
    vc:sourceDomain "governance" ;
    vc:supports ngm:data-protection,
        ngm:governance .

ngm:rigid-body a owl:Class ;
    rdfs:label "Rigid Body"@en ;
    rdfs:comment "A Rigid Body is an idealised mechanical object whose internal distances between all constituent points remain constant regardless of applied forces, making it the foundational abstraction for classical mechanics, robotic kinematics, and physics simulation. In robotics, links of a kinematic chain are modelled as rigid bodies connected by joints; their mass, centre of gravity, and inertia tensor parameterise the dynamics equations used for motion planning, control, and simulation. Rigid body assumptions break down for flexible or soft-robotic systems."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:kinematics ],
        ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:enables ngm:control-system ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:kinematics ;
    vc:isPartOf ngm:robot-component ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:slug "rigid-body" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:forward-kinematics,
        ngm:inverse-kinematics .

ngm:robot-hardware a owl:Class ;
    rdfs:label "Robot Hardware"@en ;
    rdfs:comment "RobotHardware is the integrated electromechanical substrate of robotic systems encompassing all physical components required for autonomous or semi-autonomous operation: compute platforms (NVIDIA Jetson Orin NX/AGX, Raspberry Pi 5, BeagleBone AI-64), real-time microcontrollers (STM32H7, Teensy 4...."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:actuator ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:motor-driver ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:real-time-operating-system ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:controller ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ether-cat ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:sensor-suite ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:imu ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:battery-management-system ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ros-2 ],
        ngm:mobile-robot-platform,
        ngm:robo-actuation-and-control,
        ngm:robotics-platform ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:enables ngm:autonomous-operation,
        ngm:kinematics-model,
        ngm:motion-control,
        ngm:navigation,
        ngm:proprioceptive-sensor,
        ngm:robot-perception,
        ngm:teleoperation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:actuator,
        ngm:battery-management-system,
        ngm:controller,
        ngm:motor-driver,
        ngm:sensor-suite ;
    vc:implements ngm:can-fd-protocol,
        ngm:dds-middleware,
        ngm:ether-cat,
        ngm:micro-ros,
        ngm:ros2-control-framework,
        ngm:urdf ;
    vc:qualityScore "0.52"^^xsd:float ;
    vc:relatedTo ngm:edge-computing,
        ngm:hardware-and-edge,
        ngm:model-based-control,
        ngm:nvidia-corporation-omniverse-platform,
        ngm:predictive-maintenance ;
    vc:requires ngm:can-fd-bus,
        ngm:ether-cat,
        ngm:imu,
        ngm:motor-encoder,
        ngm:real-time-operating-system,
        ngm:ros-2 ;
    vc:slug "robot-hardware" ;
    vc:sourceDomain "robotics" ;
    vc:standardizedBy ngm:ether-cat,
        ngm:iec-61800-adjustable-speed-electrical-power-drive-systems,
        ngm:iso-10218-robot-safety,
        ngm:ros-rep ;
    vc:supports ngm:exoskeleton,
        ngm:ground-robot,
        ngm:hydraulic-actuator,
        ngm:industrial-robot,
        ngm:mobile-robot-platform,
        ngm:surgical-robot ;
    vc:uses ngm:fpga,
        ngm:nvidia-corporation-jetson .

ngm:robot-localisation a owl:Class ;
    rdfs:label "Robot Localisation"@en ;
    rdfs:comment "Robot localisation is the problem of estimating a robot's pose, its position and orientation, within a known map from noisy sensor measurements and motion commands. It is typically solved with probabilistic filters that maintain a belief over possible poses and update it as new observations arrive. Accurate localisation is a prerequisite for reliable navigation and planning."@en ;
    rdfs:subClassOf ngm:robo-navigation-and-planning ;
    skos:broader ngm:robo-navigation-and-planning ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:bayes-filter,
        ngm:particle-filter ;
    vc:slug "robot-localisation" ;
    vc:sourceDomain "robotics" .

ngm:ros-rep a owl:Class ;
    rdfs:label "ROS REP"@en ;
    rdfs:comment "A ROS Enhancement Proposal (REP) is a design document that defines conventions and standards for the Robot Operating System ecosystem, analogous to internet RFCs or Python PEPs. REPs codify agreements such as coordinate-frame conventions, units, naming, and message interfaces so that independently developed robotics components interoperate. They provide the normative reference that aligns platforms and libraries."@en ;
    rdfs:subClassOf ngm:technical-standard ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:collision-detection,
        ngm:robotics-platform ;
    vc:slug "ros-rep" ;
    vc:sourceDomain "robotics" .

ngm:rotary-position-embedding a owl:Class ;
    rdfs:label "Rotary Position Embedding"@en ;
    rdfs:comment "Rotary Position Embedding (RoPE) is a method for injecting positional information into transformer attention by rotating the query and key vectors by an angle proportional to each token's absolute position, so that their dot product depends only on relative position. Because the rotation is applied multiplicatively in feature pairs rather than added to the embeddings, RoPE unifies absolute and relative positional encoding while preserving the inner-product structure that attention relies on. It is the dominant positional scheme in modern large language models such as Llama, and its frequency basis can be rescaled to extrapolate context windows far beyond the training length."@en ;
    rdfs:subClassOf ngm:positional-encoding ;
    vc:contrastsWith ngm:absolute-positional-encoding ;
    vc:enables ngm:context-length,
        ngm:extrapolation,
        ngm:long-context-modelling ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:relative-positional-encoding ;
    vc:implements ngm:absolute-positional-encoding,
        ngm:relative-positional-encoding ;
    vc:isPartOf ngm:transformer-architecture ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:alibi,
        ngm:sinusoidal-positional-encoding ;
    vc:slug "rotary-position-embedding" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:large-language-models,
        ngm:llama ;
    vc:uses ngm:attention-mechanism,
        ngm:self-attention .

ngm:rotation-matrix a owl:Class ;
    rdfs:label "Rotation Matrix"@en ;
    rdfs:comment "A rotation matrix is a square orthogonal matrix with determinant one that represents a rigid rotation of vectors in Euclidean space about a fixed origin. In robotics and computer graphics it encodes the orientation of one coordinate frame relative to another, mapping direction vectors from one frame into another without altering their length. Rotation matrices compose by matrix multiplication, enabling chains of rotations to be combined into a single transformation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:coordinate-system ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:linear-algebra ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:matrix-multiplication ],
        ngm:linear-algebra ;
    vc:bridgesTo ngm:computer-graphics ;
    vc:contrastsWith ngm:homogeneous-transformation ;
    vc:enables ngm:forward-kinematics,
        ngm:photorealistic-rendering,
        ngm:pose-estimation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:coordinate-system ;
    vc:isPartOf ngm:homogeneous-transformation,
        ngm:kinematics ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:computer-vision,
        ngm:inverse-kinematics,
        ngm:robotic-manipulation ;
    vc:requires ngm:linear-algebra,
        ngm:matrix-multiplication ;
    vc:slug "rotation-matrix" ;
    vc:sourceDomain "robotics" ;
    vc:supports ngm:motion-planning,
        ngm:trajectory-planning ;
    vc:uses ngm:coordinate-system,
        ngm:matrix-multiplication .

ngm:routing a owl:Class ;
    rdfs:label "Routing"@en ;
    rdfs:comment "Routing is the process of selecting paths in a network along which data packets or messages are forwarded from source to destination. Routing algorithms and protocols such as BGP, OSPF, and segment routing determine optimal or policy-compliant paths based on metrics including latency, bandwidth, and cost. It is a foundational function of IP networks, software-defined networking, and overlay networks."@en ;
    rdfs:subClassOf ngm:infra-network-and-comms ;
    skos:broader ngm:infra-network-and-comms ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:network-protocol ;
    vc:slug "routing" ;
    vc:sourceDomain "infrastructure" .

ngm:runes-protocol a owl:Class ;
    rdfs:label "Runes Protocol"@en ;
    rdfs:comment "Runes Protocol is a fungible token standard for the Bitcoin blockchain, introduced by Casey Rodarmor in 2024, that encodes token creation and transfer instructions directly into transaction outputs using the UTXO model. Unlike account-based token systems, Runes attaches a OP_RETURN-stored protocol message (a Runestone) to each transaction, assigning token balances to specific outputs so that ownership is tracked through spendable transaction outputs rather than a separate ledger. The protocol is designed to be more on-chain efficient than earlier Bitcoin-native token conventions such as BRC-20 and Ordinals-based token schemes, minimising UTXO proliferation while remaining fully compatible with the base-layer Bitcoin settlement mechanism. It reached significant ecosystem traction following its mainnet launch at the Bitcoin halving block in April 2024."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:bitcoin-transaction ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:utxo ],
        ngm:token-standard ;
    vc:bridgesTo ngm:decentralised-finance,
        ngm:smart-contract ;
    vc:contrastsWith ngm:brc-20,
        ngm:erc-20,
        ngm:ordinals ;
    vc:enables ngm:decentralised-exchange,
        ngm:fungible-token,
        ngm:minting ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:implements ngm:token-standard ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:bitcoin-script,
        ngm:digital-asset,
        ngm:non-fungible-token,
        ngm:proof-of-work,
        ngm:tokenization ;
    vc:requires ngm:bitcoin-transaction,
        ngm:utxo ;
    vc:slug "runes-protocol" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:bitcoin-proof-of-work-protocol,
        ngm:blockchain-transaction .

ngm:sae-j-3016 a owl:Class ;
    rdfs:label "SAE J3016"@en ;
    rdfs:comment "SAE J3016 is a foundational technical standard published by SAE International that defines a six-level taxonomy of driving automation, ranging from Level 0 (no automation) through Level 5 (full automation), by specifying the allocation of the dynamic driving task between the human driver and the automated driving system. First issued in 2014 and subsequently revised in 2016, 2018, and 2021, the standard establishes precise vocabulary — including terms such as dynamic driving task, operational design domain, and minimal risk condition — that underpins regulatory frameworks, vehicle development programmes, and public communication about autonomous and semi-autonomous vehicles worldwide. The taxonomy distinguishes Levels 1–2, where a human driver must supervise and remain ready to intervene, from Levels 3–5, where the automated system assumes full authority over the driving task within a defined operational design domain."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:sensor-fusion ],
        ngm:technical-standard ;
    vc:bridgesTo ngm:artificial-intelligence,
        ngm:machine-learning ;
    vc:contrastsWith ngm:bast-automation-levels ;
    vc:enables ngm:autonomous-vehicle,
        ngm:self-driving-car,
        ngm:vehicle-certification ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:dynamic-driving-task,
        ngm:minimal-risk-condition,
        ngm:operational-design-domain ;
    vc:implements ngm:driving-automation-taxonomy ;
    vc:isPartOf ngm:autonomous-vehicle-regulation ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:computer-vision,
        ngm:functional-safety,
        ngm:lidar,
        ngm:vehicle-safety ;
    vc:requires ngm:advanced-driver-assistance-system,
        ngm:sensor-fusion ;
    vc:slug "sae-j-3016" ;
    vc:sourceDomain "standards" ;
    vc:standardizedBy ngm:sae-international ;
    vc:supports ngm:automotive-safety-standard,
        ngm:iso-26262,
        ngm:unece-regulation ;
    vc:uses ngm:human-computer-interface,
        ngm:object-and-event-detection-and-response .

ngm:safety-certification a owl:Class ;
    rdfs:label "Safety Certification"@en ;
    rdfs:comment "Safety certification is the formal attestation by an accredited body that a product, system, or process conforms to applicable safety standards and regulations. It involves assessment, testing, and audit against criteria such as functional-safety integrity levels, after which a mark or certificate authorises deployment. For robots it verifies that protective measures like collision detection meet required safety levels."@en ;
    rdfs:subClassOf ngm:robo-safety-and-standards ;
    skos:broader ngm:robo-safety-and-standards ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:cobot-safety-levels,
        ngm:collision-detection ;
    vc:slug "safety-certification" ;
    vc:sourceDomain "robotics" .

ngm:safety-function a owl:Class ;
    rdfs:label "Safety Function"@en ;
    rdfs:comment "A safety function is a function implemented by a control system or safeguard whose failure results in an immediate increase of risk to people, equipment, or the environment. In robotics and machine safety, examples include emergency stop, speed and separation monitoring, and safe torque off. Safety functions are specified, designed, and validated to meet a required performance level so that residual risk remains tolerable."@en ;
    rdfs:subClassOf ngm:robo-safety-and-standards ;
    skos:broader ngm:robo-safety-and-standards ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:robot-standard,
        ngm:safety-integrity-level ;
    vc:slug "safety-function" ;
    vc:sourceDomain "robotics" .

ngm:safety-measure a owl:Class ;
    rdfs:label "Safety Measure"@en ;
    rdfs:comment "A Safety Measure is a technical, procedural, or organisational control applied to an AI system to prevent, detect, or mitigate harm arising from system failures, misuse, or unintended behaviour. Safety measures span the full AI lifecycle—from architecture choices that constrain dangerous capabilities, to testing regimes that surface failure modes, to runtime guardrails and human oversight mechanisms that limit impact when systems operate outside intended boundaries. Effective safety measures are proportionate to the risk profile of the system and are validated against adversarial conditions."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:formal-verification ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:risk-assessment ],
        ngm:ai-governance-and-ethics ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:bridgesTo ngm:ai-governance ;
    vc:enables ngm:ai-safety,
        ngm:fault-tolerance,
        ngm:functional-safety ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:ai-governance-principle,
        ngm:risk-management,
        ngm:transparency ;
    vc:requires ngm:formal-verification,
        ngm:risk-assessment ;
    vc:slug "safety-measure" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:ai-alignment,
        ngm:compliance-framework ;
    vc:uses ngm:adversarial-testing,
        ngm:red-teaming .

ngm:salt a owl:Class ;
    rdfs:label "Salt"@en ;
    rdfs:comment "A Salt is a randomly generated value appended or prepended to input data before it is processed by a cryptographic hash function, ensuring that two identical inputs produce distinct hash outputs. Salts defeat precomputed dictionary and rainbow-table attacks on hashed credentials and commitments by making each hash unique even when the underlying plaintext is shared. In blockchain contexts, salts appear in commitment schemes, zero-knowledge proofs, and password-based key derivation functions, where they guarantee that a hash reveals no information about the original value to an observer who does not know the salt."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptographic-hash-function ],
        ngm:cryptographic-primitive ;
    vc:enables ngm:cryptographic-verification,
        ngm:differential-privacy ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:cryptography ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:cryptographic-commitment,
        ngm:cryptographic-keys,
        ngm:cryptographic-security,
        ngm:nonce ;
    vc:requires ngm:cryptographic-hash-function ;
    vc:slug "salt" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:cryptographic-protocol .

ngm:saml-assertion a owl:Class ;
    rdfs:label "Saml Assertion"@en ;
    rdfs:comment "A SAML assertion is an XML-based security token, issued by an identity provider, that conveys statements about an authenticated subject to a relying service provider. Assertions carry authentication, attribute and authorisation-decision statements, are bound to a subject and validity window, and are protected by XML digital signatures to ensure integrity and origin. They are the core data structure exchanged in SAML single sign-on and federated identity."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:identity-provider ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:xml ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:digital-signature ],
        ngm:saml ;
    vc:contrastsWith ngm:oauth ;
    vc:enables ngm:single-sign-on ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:digital-signature,
        ngm:xml ;
    vc:implements ngm:authentication,
        ngm:authorization ;
