ngm:compliant-manipulation a owl:Class ;
    rdfs:comment "Compliant Manipulation is a branch of robotic manipulation in which the robot's end-effector or structural members intentionally yield to contact forces, using passive mechanical compliance or active force control to safely interact with uncertain, fragile, or human-occupied environments. Unlike rigid position-controlled manipulation, compliant manipulation regulates interaction forces as a first-class control objective."@en ;
    rdfs:label "Compliant Manipulation"@en ;
    rdfs:subClassOf ngm:robot-manipulation ;
    rdfs:subClassOf _:r4998 ;
    vc:enables ngm:robotic-grasping ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:haptic-feedback ;
    vc:relatedTo ngm:soft-robotics ;
    vc:requires ngm:actuator ;
    vc:slug "compliant-manipulation" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:force-control .
ngm:compliant-mechanism a skos:Concept ;
    rdfs:label "Compliant Mechanism"@en .
ngm:compliant-motion a owl:Class ;
    rdfs:comment "Compliant motion is robot motion that yields to external contact forces rather than rigidly tracking a predefined trajectory, allowing a manipulator to accommodate unexpected contact, surface irregularities or misalignment. It is achieved through admittance or impedance control, which regulate the relationship between measured force and commanded motion. It is essential for tasks involving physical contact with uncertain environments, such as assembly, polishing and human-robot interaction."@en ;
    rdfs:label "Compliant Motion"@en ;
    rdfs:subClassOf ngm:force-control ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.55"^^xsd:float ;
    vc:slug "compliant-motion" ;
    vc:sourceDomain "robotics" .
ngm:compliant-motion-control a skos:Concept ;
    rdfs:label "Compliant Motion Control"@en .
