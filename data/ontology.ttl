ngm:stablecoin-token a owl:Class ;
    rdfs:comment "A Stablecoin Token is a blockchain-native fungible token engineered to maintain a stable value, typically pegged to a fiat currency, commodity, or basket of assets, through one of three principal mechanisms: fiat-collateralised reserves held by a custodian (e.g. USDC, USDT), crypto-collateralised over-collateralisation enforced by smart contracts (e.g. DAI), or algorithmic supply adjustment that mints and burns tokens to defend the peg without direct collateral. Stablecoins serve as the primary medium of exchange, unit of account, and store of value within decentralised finance ecosystems, enabling lending, borrowing, and trading without exposure to cryptocurrency price volatility."@en ;
    rdfs:label "Stablecoin Token"@en ;
    rdfs:subClassOf ngm:bc-token-and-asset ;
    rdfs:subClassOf ngm:fungible-token ;
    rdfs:subClassOf _:r19878 ;
    rdfs:subClassOf _:r19879 ;
    skos:broader ngm:bc-token-and-asset ;
    vc:contrastsWith ngm:deflationary-token ;
    vc:contrastsWith ngm:inflationary-token ;
    vc:enables ngm:interoperability ;
    vc:enables ngm:transaction ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:central-bank-digital-currency-cbdc ;
    vc:relatedTo ngm:cryptocurrency ;
    vc:relatedTo ngm:digital-currency ;
    vc:relatedTo ngm:erc20-token ;
    vc:relatedTo ngm:token-economics ;
    vc:requires ngm:blockchain ;
    vc:requires ngm:smart-contract ;
    vc:slug "stablecoin-token" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:price-oracle ;
    vc:uses ngm:tokenomics .
ngm:stablecoins-on-bitcoin a owl:Class ;
    rdfs:comment "Stablecoins on Bitcoin are price-stable tokens issued and transferred on Bitcoin-based protocols such as Taproot Assets, Liquid, or RGB, rather than on smart-contract chains like Ethereum. They aim to bring dollar-denominated value transfer to the Bitcoin ecosystem, leveraging Bitcoin's settlement security and, where combined with the Lightning Network, near-instant low-cost payments. They extend Bitcoin's utility from a single monetary asset toward a broader settlement layer for fiat-pegged value."@en ;
    rdfs:label "Stablecoins on Bitcoin"@en ;
    rdfs:subClassOf ngm:digital-asset ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:btc-layer-3 ;
    vc:relatedTo ngm:taproot-assets ;
    vc:slug "stablecoins-on-bitcoin" ;
    vc:sourceDomain "blockchain" .
