    vc:uses ngm:ambisonics,
        ngm:head-related-transfer-function,
        ngm:signal-processing,
        ngm:speech-recognition .

ngm:auditability a owl:Class ;
    rdfs:label "Auditability"@en ;
    rdfs:comment "Auditability is the property of a system, process, or record that allows an independent party to examine and verify its actions, decisions, and state against expected behaviour or policy. It depends on complete, tamper-evident records — logs, audit trails, and provenance — that establish who did what, when, and why, enabling accountability and compliance review. Auditability is a foundational governance requirement for trustworthy financial, blockchain, and AI systems."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:provenance ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:transparency ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:traceability ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:audit-trail ],
        ngm:governance ;
    vc:contrastsWith ngm:model-transparency ;
    vc:enables ngm:accountability,
        ngm:compliance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:audit-trail,
        ngm:provenance ;
    vc:isPartOf ngm:governance ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:access-control,
        ngm:conformity-assessment,
        ngm:permissioned-blockchain ;
    vc:requires ngm:traceability,
