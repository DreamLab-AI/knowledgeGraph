ngm:level-of-detail a owl:Class ;
    rdfs:label "Level of Detail"@en ;
    rdfs:comment "Level of Detail (LOD) is a rendering optimisation technique that dynamically adjusts the geometric complexity, texture resolution, and shader fidelity of 3D objects based on viewing distance or screen-space coverage, trading visual precision for computational efficiency. LOD is essential for maintaining real-time frame rates in large-scale metaverse and spatial computing scenes."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:3-d-asset ],
        ngm:metaverse,
        ngm:sc-display-and-rendering ;
    skos:broader ngm:sc-display-and-rendering ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:occlusion-culling,
        ngm:rendering-pipeline ;
    vc:requires ngm:3-d-asset ;
    vc:slug "level-of-detail" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:performance-optimization ;
    vc:uses ngm:rasterization,
        ngm:shader .

ngm:liquidity-mining a owl:Class ;
    rdfs:label "Liquidity Mining"@en ;
    rdfs:comment "Liquidity mining is a decentralised finance incentive mechanism in which participants deposit token pairs into automated market maker pools or lending protocols and receive protocol-issued tokens as rewards proportional to their share of pooled liquidity. The reward tokens often confer governance rights and a share of trading fee revenue, creating compounding yield incentives. Liquidity mining bootstraps network liquidity for nascent protocols but introduces impermanent loss risk and token inflation dynamics that require careful mechanism design."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:automated-market-maker ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:liquidity-pool ],
        ngm:bc-defi-and-economics ;
    skos:broader ngm:bc-defi-and-economics ;
    vc:enables ngm:decentralized-exchange,
        ngm:yield-farming ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:governance-token,
        ngm:token-economics ;
    vc:requires ngm:automated-market-maker,
        ngm:liquidity-pool ;
    vc:slug "liquidity-mining" ;
    vc:sourceDomain "blockchain" .

ngm:manipulator-arm a owl:Class ;
    rdfs:label "Manipulator Arm"@en ;
    rdfs:comment "A multi-jointed mechanical or virtual robotic arm integrated with avatars or immersive systems to enable precise object manipulation and physical interaction within virtual or mixed reality environments through control systems, haptic feedback, and inverse kinematics algorithms."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
