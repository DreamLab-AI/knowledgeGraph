    vc:sourceDomain "infrastructure" .

ngm:provider a owl:Class ;
    rdfs:label "Provider"@en ;
    rdfs:comment "A natural or legal person, public authority, agency or other body that develops an AI system or a general-purpose AI model, or that has an AI system or a general-purpose AI model developed, and places it on the market or puts the AI system into service under its own name or trademark, whether for payment or free of charge."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:conformity-assessment ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:risk-management ],
        ngm:sc-governance-and-safety ;
    skos:broader ngm:sc-governance-and-safety ;
    vc:dependsOn ngm:ai-regulation ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:deployer,
        ngm:market-surveillance-authority,
        ngm:notified-body ;
    vc:requires ngm:conformity-assessment,
        ngm:risk-management ;
    vc:slug "provider" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:high-risk-ai-system .

ngm:proxemics a owl:Class ;
    rdfs:label "Proxemics"@en ;
    rdfs:comment "The study and application of interpersonal and human-robot spatial relationships — including intimate, personal, social, and public distance zones — to design robotic systems that behave in spatially appropriate ways. Proxemics-aware robots adjust their approach trajectories, velocities, and stopping distances in response to detected human zones, improving perceived safety, comfort, and social acceptability in shared environments."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:motion-planning ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:proximity-detection ],
        ngm:robo-human-robot-interaction ;
    skos:broader ngm:robo-human-robot-interaction ;
    vc:enables ngm:collision-avoidance,
        ngm:embodied-ai ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:human-robot-interaction,
        ngm:social-robotics ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:attention-aware-interaction,
        ngm:emotion-aware-interaction,
        ngm:human-computer-interaction ;
    vc:requires ngm:motion-planning,
        ngm:proximity-detection ;
    vc:slug "proxemics" ;
    vc:sourceDomain "robotics" .

ngm:pull-request a owl:Class ;
    rdfs:label "Pull Request"@en ;
    rdfs:comment "A pull request is a proposal to merge a set of changes from one branch into another, packaged so that collaborators can review, discuss, and verify the work before it is integrated. It bundles a diff, a description, and a thread of review comments, and typically triggers automated checks that must pass before merge. Pull requests are the central unit of collaboration in distributed version control workflows, making change proposals visible, reviewable, and auditable."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:git ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:peer-review ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:version-control ],
        ngm:code-review ;
    vc:enables ngm:collaboration,
        ngm:quality-assurance ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:commit,
        ngm:peer-review ;
    vc:isPartOf ngm:software-development ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:continuous-integration,
        ngm:git,
        ngm:peer-review ;
    vc:requires ngm:git,
        ngm:version-control ;
    vc:slug "pull-request" ;
    vc:sourceDomain "distributed-collaboration" ;
    vc:supports ngm:audit,
        ngm:workflow-automation ;
    vc:uses ngm:code-review,
        ngm:continuous-integration .

ngm:query-processor a owl:Class ;
    rdfs:label "Query Processor"@en ;
    rdfs:comment "A system component responsible for parsing, optimising, and executing queries against a data store or knowledge base, including spatial queries in 3D environments. Query processors translate declarative query expressions into efficient execution plans, leveraging indexing structures such as octrees, k-d trees, R-trees, and scene graph hierarchies to minimise retrieval latency."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:database-query ],
        ngm:infra-data-management ;
    skos:broader ngm:infra-data-management ;
    vc:enables ngm:information-retrieval,
        ngm:semantic-search ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:database-query ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:knowledge-graph,
        ngm:vector-database ;
    vc:slug "query-processor" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:database-system,
        ngm:scene-graph .

ngm:quorum-threshold a owl:Class ;
    rdfs:label "Quorum Threshold"@en ;
    rdfs:comment "A quorum threshold is the minimum number or fraction of participants (nodes, validators, signatories, or voters) that must agree or respond for a distributed system or governance process to reach a valid decision. It is a foundational parameter in consensus protocols, distributed databases, and blockchain governance, balancing liveness (the system can make progress) against safety (decisions reflect genuine majority will)."@en ;
    rdfs:subClassOf ngm:consensus-mechanism ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:byzantine-fault-tolerance,
        ngm:distributed-consensus ;
    vc:slug "quorum-threshold" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:fault-tolerance ;
    vc:uses ngm:paxos,
        ngm:raft .

ngm:rb-0031-singularity a owl:Class ;
    rdfs:label "rb 0031 singularity"@en ;
    rdfs:comment "A kinematic singularity is a robot configuration in which the Jacobian matrix loses rank, causing the manipulator to lose one or more degrees of freedom in Cartesian space. At a singularity, certain end-effector motions become unachievable regardless of joint velocity magnitudes, and inverse kinematics solutions either vanish or require unbounded joint speeds. Singularity avoidance and singularity-robust inverse kinematics (via damped least-squares) are critical for safe, continuous robot motion, particularly near workspace boundaries and for wrist configurations of six-axis arms."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:rb-0030-jacobian-matrix ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:rb-0021-robot-kinematics ],
        ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:contrastsWith ngm:rb-0037-dexterity ;
    vc:dependsOn ngm:differential-kinematics,
        ngm:rb-0029-inverse-kinematics ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:rb-0023-degrees-of-freedom,
        ngm:rb-0024-workspace,
        ngm:rb-0032-manipulability,
        ngm:robot-singularity ;
    vc:requires ngm:rb-0021-robot-kinematics,
        ngm:rb-0030-jacobian-matrix ;
    vc:slug "rb-0031-singularity" ;
    vc:sourceDomain "robotics" .

ngm:rb-0041-inertia a owl:Class ;
    rdfs:label "rb 0041 inertia"@en ;
    rdfs:comment "In robotics, inertia refers to the resistance of a robot's links and payload to changes in motion, quantified by the inertia tensor for rotational dynamics and mass for translational dynamics. Accurate inertia modelling is essential for dynamic control, trajectory planning, and compliance with power-and-force-limiting safety requirements, because high inertia directly increases the impact forces during unintended contact."@en ;
    rdfs:subClassOf ngm:newton-euler-dynamics,
        ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:dependsOn ngm:rb-0033-payload ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:rb-0022-robot-dynamics,
        ngm:rb-0043-torque,
        ngm:rb-0045-acceleration,
        ngm:rigid-body-dynamics,
        ngm:robot-dynamics ;
    vc:slug "rb-0041-inertia" ;
    vc:sourceDomain "robotics" ;
    vc:supports ngm:rb-0064-computed-torque-control,
        ngm:rb-0094-power-and-force-limiting .

ngm:rb-0043-torque a owl:Class ;
    rdfs:label "rb 0043 torque"@en ;
    rdfs:comment "Torque is the rotational force applied about a joint axis, expressed in Newton-metres (N·m). In robot dynamics, joint torques are the primary control inputs that drive links through desired trajectories; torque limits constrain the feasible workspace and influence payload capacity, and torque sensing enables compliant and force-controlled interaction."@en ;
    rdfs:subClassOf ngm:robo-actuation-and-control,
        ngm:robot-dynamics ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:dependsOn ngm:rb-0022-robot-dynamics,
        ngm:rb-0064-computed-torque-control ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:rb-0041-inertia,
        ngm:rb-0044-velocity,
        ngm:rb-0045-acceleration,
        ngm:rb-0067-force-torque-sensor ;
    vc:slug "rb-0043-torque" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:actuator,
        ngm:servo-motor .

ngm:rb-0064-computed-torque-control a owl:Class ;
    rdfs:label "rb 0064 computed torque control"@en ;
    rdfs:comment "Computed torque control (CTC) is a model-based robot control strategy that uses the full inverse dynamics model of a manipulator to compute the joint torques required to follow a desired trajectory. By cancelling the nonlinear dynamics — including Coriolis, centripetal, and gravitational terms — CTC transforms the closed-loop system into a set of independent linear double-integrators, enabling simple PD outer-loop controllers to achieve high-accuracy tracking. Its effectiveness depends on the fidelity of the dynamic model and is sensitive to parameter uncertainty."@en ;
    rdfs:subClassOf ngm:model-based-control,
        ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:dependsOn ngm:rb-0021-robot-kinematics,
        ngm:rb-0022-robot-dynamics ;
    vc:enables ngm:rb-0051-trajectory-planning ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:rb-0056-impedance-control,
        ngm:rb-0061-nonlinear-control,
        ngm:rb-0062-model-predictive-control ;
    vc:slug "rb-0064-computed-torque-control" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:rb-0043-torque,
        ngm:rb-0048-pid-controller .

ngm:rb-0096-safeguarding a owl:Class ;
    rdfs:label "rb 0096 safeguarding"@en ;
    rdfs:comment "Safeguarding, in the context of collaborative and industrial robotics, refers to the ensemble of physical barriers, electronic devices, and procedural controls deployed to prevent hazardous contact between robots and humans. Safeguarding measures include hard guards, light curtains, safety zones, and monitored-stop functions, and are mandated by standards such as ISO 10218 and ISO/TS 15066. Effective safeguarding is complementary to inherent safe design: it mitigates residual risks that cannot be eliminated through power-and-force limiting or speed reduction alone."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:rb-0089-risk-assessment ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:rb-0087-safety-standard ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:rb-0090-emergency-stop ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:light-curtain ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:rb-0095-safety-zone ],
        ngm:robo-safety-and-standards,
        ngm:robot-safety ;
    skos:broader ngm:robo-safety-and-standards ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:light-curtain,
        ngm:rb-0090-emergency-stop,
        ngm:rb-0095-safety-zone ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:rb-0091-safety-rated-monitored-stop,
        ngm:rb-0093-speed-limitation,
        ngm:rb-0094-power-and-force-limiting ;
    vc:requires ngm:rb-0087-safety-standard,
        ngm:rb-0089-risk-assessment ;
    vc:slug "rb-0096-safeguarding" ;
    vc:sourceDomain "robotics" ;
    vc:standardizedBy ngm:iso-10218,
        ngm:iso-ts-15066 .

ngm:real-time-inference-at-edge a owl:Class ;
    rdfs:label "Real-Time Inference at Edge"@en ;
    rdfs:comment "The execution of machine learning inference on edge devices under deterministic latency constraints, typically P99 latency below 10–100 ms, to support safety-critical and time-sensitive applications. Achieves real-time performance through hardware accelerators (NPUs, FPGAs, ASICs), model compression, and priority scheduling without reliance on cloud round-trips."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:embedded-systems ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:model-compression-for-edge ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:edge-computing ],
        ngm:ai-infrastructure ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:edge-ai-system,
        ngm:knowledge-distillation-for-edge,
        ngm:model-pruning-for-edge-deployment ;
    vc:requires ngm:edge-computing,
        ngm:embedded-systems,
        ngm:model-compression-for-edge ;
    vc:slug "real-time-inference-at-edge" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:edge-ai-accelerator,
        ngm:fpga,
        ngm:latency-aware-edge-ai,
        ngm:npu .

ngm:real-time-synchronisation a owl:Class ;
    rdfs:label "Real-Time Synchronisation"@en ;
    rdfs:comment "Real-time synchronisation is the continuous propagation of state changes across distributed participants so that all observers converge on a consistent, up-to-date view with minimal delay. It combines low-latency transport, conflict resolution, and clock or causal ordering to keep replicas aligned. It is essential for collaborative tools, multiplayer environments, and digital-twin mirroring."@en ;
    rdfs:subClassOf ngm:distributed-systems ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:digital-twin,
        ngm:distributed-collaboration ;
    vc:slug "real-time-synchronisation" ;
    vc:sourceDomain "infrastructure" .

ngm:recursive-self-improvement a owl:Class ;
    rdfs:label "Recursive Self-Improvement"@en ;
    rdfs:comment "Recursive self-improvement (RSI) is a theoretical AI capability in which a system autonomously identifies and implements modifications to its own architecture, training procedure, or objective function that result in increased performance or capability, such that each improvement cycle enables further improvements in a self-amplifying feedback loop. This process is conjectured to be a pathway to artificial superintelligence if left unconstrained, as successive capability doublings could occur faster than human oversight can track. RSI is a central concern in AI safety research because systems capable of recursive self-improvement may rapidly violate designers' assumptions about capability bounds and alignment properties."@en ;
    rdfs:subClassOf ngm:ai-governance-and-ethics ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:contrastsWith ngm:ai-safety-research ;
    vc:enables ngm:self-improvement ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:ai-alignment,
        ngm:ai-safety,
        ngm:value-alignment ;
    vc:slug "recursive-self-improvement" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:relevance-ranking a owl:Class ;
    rdfs:label "Relevance Ranking"@en ;
    rdfs:comment "Relevance Ranking is the process of ordering a set of candidate documents, passages or items by their estimated usefulness to a given query or context. It combines lexical, semantic and behavioural signals into a score that determines the sequence in which results are presented. Ranking quality directly governs the perceived effectiveness of search, recommendation and retrieval-augmented generation systems."@en ;
    rdfs:subClassOf ngm:information-retrieval ;
    vc:bridgesTo ngm:discovery-layer ;
    vc:contrastsWith ngm:beam-search ;
    vc:dependsOn ngm:embedding ;
    vc:enables ngm:recommendation-systems,
        ngm:search-engine ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:information-retrieval ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:context-engineering,
        ngm:recommendation-systems,
        ngm:reranker ;
    vc:slug "relevance-ranking" ;
    vc:sourceDomain "ai" ;
    vc:supports ngm:retrieval-augmented-generation,
        ngm:semantic-search ;
    vc:uses ngm:cosine-similarity,
        ngm:dense-retrieval,
        ngm:vector-search .

ngm:renewable-energy-integration a owl:Class ;
    rdfs:label "Renewable Energy Integration"@en ;
    rdfs:comment "Renewable energy integration is the practice of powering computational or industrial loads with solar, wind, hydro, and other low-carbon sources, often using flexible demand to absorb intermittent or otherwise curtailed generation. In blockchain it refers to siting mining near renewable supply to lower emissions and monetise stranded energy. Effective integration reduces carbon intensity and can improve grid economics."@en ;
    rdfs:subClassOf ngm:sustainability ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:bitcoin-proof-of-work-protocol-environmental-issues,
        ngm:carbon-neutral-blockchain ;
    vc:slug "renewable-energy-integration" ;
    vc:sourceDomain "blockchain" .

ngm:reproducible-research a owl:Class ;
    rdfs:label "Reproducible Research"@en ;
    rdfs:comment "Reproducible research is the practice of conducting and reporting scientific work so that an independent party can obtain the same results from the same data and code. It encompasses sharing datasets, source code, computational environments, and detailed methodology alongside published findings. In machine learning it is the discipline of making experiments verifiable through fixed seeds, versioned artefacts, recorded hyperparameters, and documented hardware, distinguishing genuine effects from artefacts of a particular run."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:container ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:version-control ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-provenance ],
        ngm:artificial-intelligence ;
    skos:broader ngm:artificial-intelligence ;
    vc:dependsOn ngm:reproducibility ;
    vc:enables ngm:open-science,
        ngm:peer-review ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:open-science ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:open-source-software,
        ngm:scientific-computing ;
    vc:requires ngm:container,
        ngm:data-provenance,
        ngm:version-control ;
    vc:slug "reproducible-research" ;
    vc:sourceDomain "ai" ;
    vc:supports ngm:open-data,
        ngm:open-source ;
    vc:uses ngm:jupyter-notebook,
        ngm:model-comparison,
        ngm:workflow-orchestration .

ngm:resampling a owl:Class ;
    rdfs:label "Resampling"@en ;
    rdfs:comment "Resampling is a family of statistical and machine-learning techniques that repeatedly draw samples from observed data to estimate the variability of a statistic, validate a model, or rebalance a dataset. It includes methods such as bootstrapping, cross-validation, permutation testing, and over- and under-sampling for class imbalance. By substituting computation for restrictive distributional assumptions, resampling provides robust estimates of error, confidence and generalisation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:cross-validation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:statistical-inference ],
        ngm:statistical-inference ;
    vc:bridgesTo ngm:machine-learning ;
    vc:enables ngm:cross-validation,
        ngm:model-evaluation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:cross-validation ;
    vc:isPartOf ngm:statistical-inference ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:bagging,
        ngm:cross-validation,
        ngm:model-evaluation,
        ngm:overfitting ;
    vc:requires ngm:statistical-inference ;
    vc:slug "resampling" ;
    vc:sourceDomain "machine-learning" ;
    vc:supports ngm:bagging,
        ngm:model-evaluation ;
    vc:uses ngm:bagging,
        ngm:cross-validation .

ngm:ro-berta a owl:Class ;
    rdfs:label "RoBERTa"@en ;
    rdfs:comment "RoBERTa (Robustly Optimised BERT Pretraining Approach) is a transformer-based language model that refines BERT by removing the next-sentence-prediction objective, adopting dynamic masking, training on substantially larger corpora (160 GB vs 16 GB), and using larger batch sizes. These training-procedure improvements yield consistent performance gains on NLP benchmarks without altering the underlying transformer encoder architecture."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:transformer-architecture ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:language-modeling ],
        ngm:ai-model-architecture ;
    skos:broader ngm:ai-model-architecture ;
    vc:bridgesTo ngm:artificial-intelligence ;
    vc:contrastsWith ngm:albert,
        ngm:distilbert,
        ngm:xlnet ;
    vc:dependsOn ngm:attention-mechanism,
        ngm:bert ;
    vc:enables ngm:named-entity-recognition,
        ngm:question-answering,
        ngm:sentiment-analysis,
        ngm:text-classification ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:implements ngm:pretraining,
        ngm:self-supervised-learning ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:pre-trained-language-model ;
    vc:requires ngm:language-modeling,
        ngm:large-scale-corpus,
        ngm:masked-language-model,
        ngm:transformer-architecture ;
    vc:slug "ro-berta" ;
    vc:sourceDomain "machine-learning" ;
    vc:supports ngm:glue-benchmark,
        ngm:natural-language-processing ;
    vc:uses ngm:byte-pair-encoding,
        ngm:fine-tuning,
        ngm:transfer-learning .

ngm:robotic-grasping a owl:Class ;
    rdfs:label "Robotic Grasping"@en ;
    rdfs:comment "Robotic Grasping is the subfield of robotics concerned with planning and executing stable, task-appropriate physical contact between a robotic end-effector and a target object. It integrates perception, grasp quality estimation, motion planning, and control to enable reliable object acquisition across varied geometries, materials, and environmental conditions."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:robot-perception ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:end-effector ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:grasp-planning ],
        ngm:manipulation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.85"^^xsd:float ;
    vc:relatedTo ngm:dexterous-manipulation ;
    vc:requires ngm:end-effector,
        ngm:grasp-planning,
        ngm:robot-perception ;
    vc:slug "robotic-grasping" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:point-cloud,
        ngm:tactile-sensing .

ngm:robotics-systems a owl:Class ;
    rdfs:label "Robotics Systems"@en ;
    rdfs:comment "The foundational technology domain encompassing autonomous and semi-autonomous mechanical systems, including manipulators, mobile robots, humanoids, and collaborative robots (cobots), along with their control systems, sensors, actuators, kinematics, and the integration of perception, planning, and action for physical world interaction."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:humanoid-robot ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:manipulator ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:robot-sensor ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:robot-control ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:mobile-robot ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:collaborative-systems-modality-robot ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:swarm-robotics ],
        ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:bridgesTo ngm:infrastructure ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:collaborative-systems-modality-robot,
        ngm:humanoid-robot,
        ngm:manipulator,
        ngm:mobile-robot,
        ngm:robot-control,
        ngm:robot-sensor,
        ngm:swarm-robotics ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:artificial-intelligence,
        ngm:human-robot-interaction,
        ngm:motion-planning,
        ngm:robot-kinematics ;
    vc:slug "robotics-systems" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:actuator,
        ngm:robo-perception .

ngm:safe-human-robot-interaction a owl:Class ;
    rdfs:label "Safe Human-Robot Interaction"@en ;
    rdfs:comment "Safe human-robot interaction is the body of methods and controls that allow robots to operate in close proximity to people without causing harm. It combines compliant control, force and contact limiting, collision avoidance, and speed-and-separation monitoring so that physical contact, when it occurs, stays within safe limits. It is essential for collaborative robots that share workspaces with humans."@en ;
    rdfs:subClassOf ngm:robo-human-robot-interaction ;
    skos:broader ngm:robo-human-robot-interaction ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:admittance-control,
        ngm:force-control ;
    vc:slug "safe-human-robot-interaction" ;
    vc:sourceDomain "robotics" .

ngm:safetensors a owl:Class ;
    rdfs:label "Safetensors"@en ;
    rdfs:comment "Safetensors is a secure, simple, and fast file format for storing and loading neural network tensor weights, developed by Hugging Face as a safe alternative to Python's pickle-based serialisation. The format stores tensor metadata in a JSON header followed by raw binary data, enabling zero-copy memory-mapped loading without executing arbitrary code during deserialisation."@en ;
    rdfs:subClassOf ngm:data-serialization ;
    vc:enables ngm:ai-model-inference-engine,
        ngm:model-checkpoint ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:hugging-face-model-hub,
        ngm:safetensors-format ;
    vc:slug "safetensors" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:hugging-face,
        ngm:model-weights .

ngm:safety-case a owl:Class ;
    rdfs:label "Safety Case"@en ;
    rdfs:comment "A safety case is a structured, evidence-backed argument that a system is acceptably safe to operate in a defined context and operational environment. It comprises explicit safety claims, the reasoning that connects them, and the supporting evidence drawn from hazard analysis, design measures, verification, and operational data. Commonly documented using notations such as the Goal Structuring Notation or Claims-Arguments-Evidence, the safety case is reviewed by stakeholders and regulators and maintained throughout the system lifecycle. It is the central assurance artefact in safety-critical and autonomous-systems engineering."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:risk-assessment ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:hazard-analysis ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:fault-tree-analysis ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:hazard-analysis ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:risk-assessment ],
        ngm:functional-safety ;
    vc:enables ngm:certification,
        ngm:regulatory-approval ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:fault-tree-analysis,
        ngm:hazard-analysis,
        ngm:risk-assessment ;
    vc:isPartOf ngm:functional-safety ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:risk-mitigation,
        ngm:safety ;
    vc:requires ngm:hazard-analysis,
        ngm:risk-assessment ;
    vc:slug "safety-case" ;
    vc:sourceDomain "robotics" ;
    vc:standardizedBy ngm:iso-13482,
        ngm:iso-26262 ;
    vc:supports ngm:autonomous-system .

ngm:satellite-communication a owl:Class ;
    rdfs:label "Satellite Communication"@en ;
    rdfs:comment "Satellite communication is the use of artificial Earth-orbiting satellites as relay stations to transmit signals — including voice, data, video, and telemetry — between ground terminals separated by large distances or challenging terrain. Signals are uplinked from a ground station to a satellite transponder, which amplifies and retransmits them on a different frequency to one or more receiving terminals. Different orbital regimes (GEO, MEO, LEO) offer distinct trade-offs between coverage footprint, latency, and capacity."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:spectrum-allocation ],
        ngm:infrastructure ;
    skos:broader ngm:infrastructure ;
    vc:contrastsWith ngm:fibre-optic-network ;
    vc:dependsOn ngm:network-infrastructure,
        ngm:standards ;
    vc:enables ngm:broadcasting,
        ngm:global-connectivity,
        ngm:gps-navigation,
        ngm:remote-sensing ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:ground-station,
        ngm:satellite-link,
        ngm:transponder ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:geostationary-orbit,
        ngm:low-earth-orbit ;
    vc:requires ngm:launch-vehicle,
        ngm:spectrum-allocation ;
    vc:slug "satellite-communication" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:disaster-response,
        ngm:telecommunications ;
    vc:uses ngm:frequency-band,
        ngm:orbital-mechanics,
        ngm:spectrum-allocation .

ngm:scientific-discovery a owl:Class ;
    rdfs:label "Scientific Discovery"@en ;
    rdfs:comment "Scientific discovery in AI refers to the application of machine learning, knowledge-graph reasoning, and autonomous experimentation systems to accelerate the identification of novel scientific findings, generate and test hypotheses, and interpret complex experimental data at scales beyond human cognitive capacity. It encompasses AI-driven approaches across domains including drug discovery, materials science, genomics, and climate modelling, where the goal is to augment or automate stages of the scientific method from hypothesis generation through experimental design to result interpretation."@en ;
    rdfs:subClassOf ngm:ai-research-area ;
    skos:broader ngm:ai-research-area ;
    vc:enables ngm:drug-discovery,
        ngm:knowledge-graph ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:drug-discovery-ai ;
    vc:slug "scientific-discovery" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:generative-model,
        ngm:machine-learning-discipline .

ngm:search-and-rescue-robotics a owl:Class ;
    rdfs:label "Search and Rescue Robotics"@en ;
    rdfs:comment "Search and rescue robotics is the application of robotic systems to locate, assess and assist victims in disaster and emergency environments that are dangerous or inaccessible to human responders. These robots traverse rubble, water and confined spaces, carrying sensors to detect survivors and relay situational awareness to rescue teams. By extending responders' reach into hazardous zones, they reduce risk to human life while accelerating victim location."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:sensor-fusion ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:path-planning ],
        ngm:robotics ;
    skos:broader ngm:robotics ;
    vc:bridgesTo ngm:computer-vision ;
    vc:dependsOn ngm:localization,
        ngm:mapping ;
    vc:enables ngm:situational-awareness ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:implements ngm:mobile-robotics ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:robotics,
        ngm:slam ;
    vc:requires ngm:path-planning,
        ngm:sensor-fusion ;
    vc:slug "search-and-rescue-robotics" ;
    vc:sourceDomain "robotics" ;
    vc:supports ngm:human-robot-interaction,
        ngm:navigation ;
    vc:uses ngm:rescue-robot,
        ngm:teleoperation .

ngm:search-engine-optimisation a owl:Class ;
    rdfs:label "Search Engine Optimisation"@en ;
    rdfs:comment "Search engine optimisation (SEO) is the discipline of improving a website's visibility and ranking in organic search results. It combines technical optimisation, content relevance, structured data, and authority signals to align pages with how search engines crawl, index, and rank content. SEO bridges marketing intent with the indexing and ranking machinery of search engines to attract qualified, unpaid traffic."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:indexing ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:content-creation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:behavioural-analytics ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:metadata ],
        ngm:digital-marketing ;
    vc:bridgesTo ngm:knowledge-graph,
        ngm:semantic-web ;
    vc:enables ngm:personalisation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:indexing,
        ngm:metadata ;
    vc:implements ngm:a-b-testing ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:audience-segmentation,
        ngm:programmatic-advertising,
        ngm:search-engine ;
    vc:requires ngm:behavioural-analytics,
        ngm:content-creation ;
    vc:slug "search-engine-optimisation" ;
    vc:sourceDomain "data" ;
    vc:supports ngm:conversion-rate-optimisation,
        ngm:user-engagement ;
    vc:uses ngm:semantic-search,
        ngm:web-crawler .

ngm:security-policy a owl:Class ;
    rdfs:label "Security Policy"@en ;
    rdfs:comment "A security policy is a formalised set of rules, principles, and procedures that govern how an organisation protects its information assets, systems, and personnel. It defines acceptable use, access control objectives, incident response obligations, and compliance requirements. Security policies serve as the authoritative reference for all subordinate security controls, technical configurations, and procedural guidelines within an enterprise."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:audit-logging ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:identity-and-access-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:access-control-policy ],
        ngm:security ;
    vc:dependsOn ngm:governance,
        ngm:risk-assessment ;
    vc:enables ngm:regulatory-compliance,
        ngm:zero-trust-architecture ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:acceptable-use-policy,
        ngm:access-control-policy,
        ngm:incident-response-plan ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:data-protection,
        ngm:network-security,
        ngm:threat-model ;
    vc:requires ngm:audit-logging,
        ngm:identity-and-access-management ;
    vc:slug "security-policy" ;
    vc:sourceDomain "security" ;
    vc:standardizedBy ngm:iso-iec-27001,
        ngm:nist-cybersecurity-framework ;
    vc:supports ngm:cyber-resilience ;
    vc:uses ngm:compliance,
        ngm:risk-management .

ngm:sensor-model a owl:Class ;
    rdfs:label "Sensor Model"@en ;
    rdfs:comment "A sensor model, also called an observation or measurement model, is a probabilistic description of how a robot's sensor readings relate to the underlying state of the world, expressing the likelihood of an observation given a hypothesised state. It captures sensor characteristics such as noise, resolution, range limits, and failure modes, allowing a robot to weight evidence appropriately when fusing measurements. Sensor models are central to Bayesian state estimation, where they form the update step that corrects predictions using incoming data."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:observation-model ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:camera ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:lidar ],
        ngm:probabilistic-robotics ;
    vc:contrastsWith ngm:motion-model ;
    vc:enables ngm:localization,
        ngm:slam ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:observation-model ;
    vc:isPartOf ngm:sensor-fusion,
        ngm:state-estimation ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:mapping,
        ngm:robot-perception,
        ngm:sensor-fusion ;
    vc:requires ngm:camera,
        ngm:lidar ;
    vc:slug "sensor-model" ;
    vc:sourceDomain "robotics" ;
    vc:supports ngm:kalman-filter,
        ngm:particle-filter ;
    vc:uses ngm:observation-model .

ngm:sensor-suite a owl:Class ;
    rdfs:label "Sensor Suite"@en ;
    rdfs:comment "A sensor suite is the integrated collection of complementary sensors mounted on a robotic platform, such as cameras, LiDAR, radar, IMUs, and encoders, chosen to provide redundant and complementary perception. The combination supports sensor fusion that compensates for the failure modes and blind spots of any single modality. It is a defining hardware subsystem of autonomous mobile robots."@en ;
    rdfs:subClassOf ngm:robo-perception ;
    skos:broader ngm:robo-perception ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:mobile-robot-platform,
        ngm:robot-hardware ;
    vc:slug "sensor-suite" ;
    vc:sourceDomain "robotics" .

ngm:session-manager a owl:Class ;
    rdfs:label "Session Manager"@en ;
    rdfs:comment "A Session Manager is a software component responsible for creating, maintaining, tracking, and terminating user or application sessions within a computing system, ensuring that stateful context is preserved across multiple interactions or network requests. It issues session tokens or identifiers, enforces timeout and expiry policies, replicates session state for high-availability scenarios, and integrates with authentication services to verify that sessions remain bound to authenticated principals. Session managers are critical security components: misconfigurations can lead to session fixation, hijacking, or replay attacks. In distributed architectures they must handle session affinity, cross-node replication, and graceful failover without exposing stale state."@en ;
    rdfs:subClassOf ngm:middleware ;
    vc:enables ngm:api-gateway,
        ngm:user-experience ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:cloud-computing,
        ngm:data-persistence,
        ngm:distributed-system,
        ngm:middleware-layer,
        ngm:state-machine ;
    vc:slug "session-manager" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:authentication,
        ngm:authentication-service,
        ngm:state-management,
        ngm:web-socket-protocol .

ngm:shacl a owl:Class ;
    rdfs:label "SHACL"@en ;
    rdfs:comment "SHACL (Shapes Constraint Language) is a W3C standard for validating RDF graphs against a set of declarative conditions expressed as shapes. It defines constraints on the structure, datatypes, cardinality and value ranges that nodes in a graph must satisfy, and reports conformance results identifying any violations. SHACL enables data quality assurance and interface contracts for linked data, complementing OWL by focusing on validation rather than inference."@en ;
    rdfs:subClassOf ngm:knowledge-representation ;
    vc:contrastsWith ngm:owl ;
    vc:dependsOn ngm:rdf ;
    vc:enables ngm:knowledge-graph ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:knowledge-representation ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:linked-data,
        ngm:owl,
        ngm:sparql ;
    vc:slug "shacl" ;
    vc:sourceDomain "data" ;
    vc:standardizedBy ngm:knowledge-representation ;
    vc:supports ngm:data-governance,
        ngm:data-quality ;
    vc:uses ngm:rdf,
        ngm:turtle .

ngm:shader-compiler a owl:Class ;
    rdfs:label "Shader Compiler"@en ;
    rdfs:comment "A shader compiler is the toolchain component that translates high-level shading-language source code, such as GLSL or HLSL, into an intermediate representation or the native instruction set executed by a GPU. It performs parsing, optimisation, register allocation, and code generation so that programmable graphics and compute stages run efficiently on diverse hardware. Shader compilation may occur ahead of time or just in time, and its results are frequently cached to avoid costly recompilation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:compiler ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:shader ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:spir-v ],
        ngm:compiler ;
    vc:dependsOn ngm:gpu,
        ngm:graphics-api ;
    vc:enables ngm:compute-shader,
        ngm:gpu-compute ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:spir-v ;
    vc:isPartOf ngm:graphics-api,
        ngm:graphics-pipeline ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:rendering-pipeline,
        ngm:vulkan ;
    vc:requires ngm:compiler,
        ngm:shader ;
    vc:slug "shader-compiler" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:gpu-rendering,
        ngm:real-time-rendering ;
    vc:uses ngm:glsl,
        ngm:hlsl,
        ngm:spir-v .

ngm:side-channel-attack a owl:Class ;
    rdfs:label "Side-Channel Attack"@en ;
    rdfs:comment "A side-channel attack recovers secret information by observing physical or behavioural artefacts of a cryptographic implementation rather than breaking its underlying mathematics. Exploitable channels include timing variation, power consumption, electromagnetic emissions, cache access patterns, and acoustic emanations. It is a critical implementation-level threat that motivates constant-time code and masking countermeasures."@en ;
    rdfs:subClassOf ngm:cybersecurity ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:cryptography-security-and-privacy,
        ngm:hash-function ;
    vc:slug "side-channel-attack" ;
    vc:sourceDomain "security" .

ngm:signed-distance-function a owl:Class ;
    rdfs:label "Signed Distance Function"@en ;
    rdfs:comment "A signed distance function (SDF) is a scalar field that returns, for any point in space, the distance to the nearest surface of a shape, with the sign indicating whether the point is inside (negative) or outside (positive). The surface itself is the zero level set where the function equals zero. SDFs provide a compact implicit representation of geometry that supports efficient ray marching, smooth shape blending, and analytic normals, and they underpin procedural rendering, collision queries, and learned 3D reconstruction in neural networks."@en ;
    rdfs:subClassOf ngm:computer-graphics ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:gpu,
        ngm:rendering-pipeline ;
    vc:slug "signed-distance-function" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:neural-rendering,
        ngm:real-time-rendering .

ngm:soft-body-dynamics a owl:Class ;
    rdfs:label "Soft Body Dynamics"@en ;
    rdfs:comment "Soft Body Dynamics is the branch of physics simulation concerned with deformable objects — including cloth, flesh, elastic materials, vegetation, and fluids — that change shape in response to forces, collisions, and internal stresses. Unlike rigid body simulation, soft body methods must track per-vertex or per-element deformation states, typically using mass-spring networks, finite element methods (FEM), or position-based dynamics (PBD). It is essential for visual fidelity in real-time virtual environments, character animation, and embodied AI simulations."@en ;
    rdfs:subClassOf ngm:metaverse,
        ngm:sc-display-and-rendering ;
    skos:broader ngm:sc-display-and-rendering ;
    vc:enables ngm:3-d-animation,
        ngm:embodied-ai-simulation,
        ngm:game-engine ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:physics-simulation ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:collision-detection,
        ngm:dynamic-character-animation,
        ngm:fluid-simulation,
        ngm:real-time-rendering,
        ngm:rigid-body-dynamics ;
    vc:slug "soft-body-dynamics" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:compute-shader,
        ngm:gpu-compute,
        ngm:physics-engine .

ngm:software-bill-of-materials a owl:Class ;
    rdfs:label "Software Bill of Materials"@en ;
    rdfs:comment "A software bill of materials is a formal, machine-readable inventory of the components, libraries and dependencies that make up a software artefact, together with their versions, suppliers and relationships. It provides transparency into what a piece of software actually contains, enabling vulnerability tracking, licence auditing and provenance verification across the supply chain. Standard formats such as SPDX and CycloneDX let an SBOM be generated, exchanged and consumed automatically by tooling."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:provenance ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:vulnerability ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:continuous-integration ],
        ngm:supply-chain-security ;
    vc:bridgesTo ngm:supply-chain-security ;
    vc:enables ngm:transparency,
        ngm:vulnerability-management ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:provenance,
        ngm:vulnerability ;
    vc:isPartOf ngm:supply-chain-security ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:dev-sec-ops,
        ngm:open-source,
        ngm:vulnerability ;
    vc:requires ngm:continuous-integration ;
    vc:slug "software-bill-of-materials" ;
    vc:sourceDomain "distributed-collaboration" ;
    vc:supports ngm:dev-sec-ops,
        ngm:transparency,
        ngm:vulnerability-management ;
    vc:uses ngm:continuous-integration,
        ngm:provenance .

ngm:spatial-anchoring a owl:Class ;
    rdfs:label "Spatial Anchoring"@en ;
    rdfs:comment "Spatial anchoring is the process of binding virtual or digital content to a precise, persistent location in physical space so that the content maintains a consistent position and orientation relative to the real world across multiple sessions, devices, and users. It relies on environmental mapping techniques such as Simultaneous Localisation and Mapping (SLAM), feature descriptor extraction, and cloud-synchronised anchor databases to re-localise digital objects reliably when the same physical environment is revisited. Anchors encode both geometric and semantic information about a surface or landmark, enabling persistent mixed-reality experiences, shared multi-user overlays, and location-aware services. The technology underpins applications ranging from indoor navigation and industrial training overlays to collaborative augmented reality workspaces and location-based gaming."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:slam ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:localisation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:environment-mapping ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:pose-estimation ],
        ngm:augmented-reality ;
    vc:bridgesTo ngm:distributed-systems ;
    vc:contrastsWith ngm:world-locking ;
    vc:dependsOn ngm:depth-sensing,
        ngm:inertial-measurement-unit ;
    vc:enables ngm:indoor-navigation,
        ngm:location-based-ar,
        ngm:persistent-ar-placement,
        ngm:shared-ar-experiences ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:anchor-persistence,
        ngm:localisation ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:computer-vision,
        ngm:coordinate-system,
        ngm:spatial-computing ;
    vc:requires ngm:environment-mapping,
        ngm:pose-estimation,
        ngm:slam ;
    vc:slug "spatial-anchoring" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:digital-twin,
        ngm:metaverse,
        ngm:mixed-reality ;
    vc:uses ngm:cloud-storage,
        ngm:coordinate-frame,
        ngm:feature-extraction,
        ngm:point-cloud .

ngm:spatial-audio-system a owl:Class ;
    rdfs:label "Spatial Audio System"@en ;
    rdfs:comment "An integrated audio technology framework creating three-dimensional soundscapes for VR, AR, and metaverse applications by simulating sound direction, distance, and environmental acoustics, enabling realistic audio experiences that respond dynamically to user movement and head orientation."@en ;
    rdfs:subClassOf ngm:immersive-audio-technology,
        ngm:sc-display-and-rendering ;
    skos:broader ngm:sc-display-and-rendering ;
    vc:enables ngm:immersive-sound-experience ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:slug "spatial-audio-system" ;
    vc:sourceDomain "spatial-computing" .

ngm:spatial-presence a owl:Class ;
    rdfs:label "Spatial Presence"@en ;
    rdfs:comment "The psychological state of feeling physically located within a virtual environment, experiencing the sense of \"being there\" despite technological mediation, influenced by place illusion (perceived location), plausibility illusion (believable events), and temporal presence (immediacy of experience)."@en ;
    rdfs:subClassOf ngm:sc-platform-and-environment,
        ngm:vr-psychology ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:enables ngm:immersive-experience ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:slug "spatial-presence" ;
    vc:sourceDomain "spatial-computing" .

ngm:speech-processing a owl:Class ;
    rdfs:label "Speech Processing"@en ;
    rdfs:comment "The field concerned with the analysis, recognition, synthesis and transformation of human speech signals by computational systems."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:audio-processing ],
