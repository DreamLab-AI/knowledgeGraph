ngm:graph-search a owl:Class ;
    rdfs:label "Graph Search"@en ;
    rdfs:comment "Algorithms that systematically explore graph-structured state spaces to find optimal or feasible paths between configurations, forming the computational foundation for robot motion planning, task planning, and navigation. Classical methods (BFS, Dijkstra, A*) guarantee completeness or optimality on discrete graphs; sampling-based variants (RRT, PRM) address high-dimensional continuous configuration spaces."@en ;
    rdfs:subClassOf ngm:infra-data-management ;
    skos:broader ngm:infra-data-management ;
    vc:enables ngm:motion-planning,
        ngm:navigation ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:relatedTo ngm:graph-neural-network,
        ngm:knowledge-graph ;
    vc:slug "graph-search" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:graph-algorithms,
        ngm:knowledge-representation .

ngm:halving a owl:Class ;
    rdfs:label "Halving"@en ;
    rdfs:comment "A programmatic event in proof-of-work blockchains, most notably Bitcoin, whereby the block reward issued to miners is cut in half at a predetermined block height. Halvings enforce a fixed, disinflationary supply schedule that asymptotically approaches the maximum coin supply. By reducing new coin issuance, halvings create predictable scarcity and are a central component of Bitcoin's monetary policy."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:block-reward ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:consensus-rule ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:proof-of-work ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:mining-reward ],
        ngm:bc-defi-and-economics,
        ngm:blockchain-entity,
        ngm:economic-mechanism ;
    skos:broader ngm:bc-defi-and-economics ;
    vc:enables ngm:deflationary-token,
        ngm:fixed-supply-token,
        ngm:inflation-control ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:block-reward,
        ngm:mining-reward ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:bitcoin-mining,
        ngm:bitcoin-value-proposition,
        ngm:circulating-supply,
        ngm:difficulty-adjustment,
        ngm:incentive-alignment,
        ngm:monetary-policy-implementation,
        ngm:tokenomics ;
    vc:requires ngm:consensus-rule,
        ngm:proof-of-work ;
    vc:slug "halving" ;
    vc:sourceDomain "blockchain" .

ngm:hardware-abstraction-layer a owl:Class ;
    rdfs:label "Hardware Abstraction Layer"@en ;
    rdfs:comment "A Hardware Abstraction Layer (HAL) is a software layer that presents a uniform, hardware-independent interface to upper software layers — operating systems, middleware, or application code — while encapsulating the vendor-specific, register-level details of physical devices in the implementation beneath it. By isolating hardware dependencies behind a stable API, the HAL enables the same kernel or application binary to run on different processor architectures, microcontroller families, or peripheral configurations without source-code changes. HALs appear throughout the software stack: in embedded microcontroller SDKs (STM32 HAL, Arduino abstraction), in operating-system kernels (Windows HAL.dll), in robotic middleware (ROS Hardware Interface), and in graphics stacks (Vulkan's hardware abstraction over GPU vendors). The HAL pattern is a foundational principle of portable, maintainable system software."@en ;
    rdfs:subClassOf ngm:hardware-abstraction ;
    vc:enables ngm:cross-platform-interoperability,
        ngm:operating-system ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:driver-software,
        ngm:embedded-systems,
        ngm:middleware ;
    vc:slug "hardware-abstraction-layer" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:gpu-compute,
        ngm:real-time-operating-system,
        ngm:robot-operating-system ;
    vc:uses ngm:middleware-layer,
        ngm:system-software .

ngm:hugging-face-hub a owl:Class ;
    rdfs:label "HuggingFace Hub"@en ;
    rdfs:comment "Hugging Face Hub is a centralised, version-controlled platform for hosting, discovering, and sharing machine learning models, datasets, and interactive Spaces under a collaborative open-source ecosystem. It provides Git-LFS-backed repositories for large artefact storage, model cards for documentation and responsible AI metadata, and a Python SDK (huggingface_hub) for programmatic access. The Hub functions as the de-facto registry for open-weight foundation models, transformer checkpoints, and diffusion model pipelines, serving millions of downloads daily across research and production workflows."@en ;
    rdfs:subClassOf ngm:ai-infrastructure ;
    vc:enables ngm:fine-tuning,
        ngm:inference,
        ngm:open-source-ai ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:generative-ai,
        ngm:hugging-face-diffusers ;
    vc:slug "hugging-face-hub" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:model-training .

ngm:human-tracking-and-slam-capture a owl:Class ;
    rdfs:label "Human tracking and SLAM capture"@en ;
    rdfs:comment "Human tracking and SLAM (Simultaneous Localisation and Mapping) capture is the combined process of localising and mapping an environment while concurrently tracking human body pose, motion, and spatial position. Applied in XR headsets, autonomous robots, and motion capture rigs, it fuses depth sensing, inertial data, and computer vision to produce real-time skeletal and spatial models used for avatar animation, scene reconstruction, and safety-aware robot navigation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:computer-vision ],
        ngm:robo-perception,
        ngm:sensor-technology ;
    skos:broader ngm:robo-perception ;
    vc:enables ngm:motion-capture,
        ngm:spatial-mapping ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:computer-vision ;
    vc:slug "human-tracking-and-slam-capture" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:depth-sensing,
        ngm:pose-estimation,
        ngm:slam .

ngm:hyperbitcoinization a owl:Class ;
    rdfs:label "Hyperbitcoinization"@en ;
    rdfs:comment "Hyperbitcoinization is a theoretical macroeconomic scenario, first articulated by Daniel Krawisz in 2014, in which Bitcoin undergoes a self-reinforcing demonetisation of fiat currencies and becomes the dominant global monetary unit. The process is modelled as a currency substitution accelerated by the Cantillon effect: as fiat monetary expansion erodes purchasing power, rational economic actors progressively shift savings and transactional balances into Bitcoin, increasing its adoption and liquidity, which in turn makes it more attractive as a medium of exchange. Unlike hyperinflation, which is an involuntary collapse of a fiat currency, hyperbitcoinization is theorised as a voluntary migration driven by Bitcoin's superior monetary properties — fixed supply, self-custody, and censorship resistance — ultimately displacing state-issued money."@en ;
    rdfs:subClassOf ngm:bitcoin-value-proposition ;
    vc:contrastsWith ngm:central-bank-digital-currency,
        ngm:monetary-sovereignty ;
    vc:enables ngm:bitcoin-distribution ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:bitcoin-as-money,
        ngm:bitcoin-standard,
        ngm:inflation,
        ngm:sound-money ;
    vc:slug "hyperbitcoinization" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:bitcoin-network,
        ngm:lightning-network .

ngm:hyperledger-foundation a owl:Class ;
    rdfs:label "Hyperledger Foundation"@en ;
    rdfs:comment "The Hyperledger Foundation is an open-source collaborative initiative hosted by the Linux Foundation that develops and maintains enterprise-grade, permissioned distributed ledger frameworks and supporting toolkits. Its portfolio includes Hyperledger Fabric (a modular, pluggable DLT framework for enterprise supply-chain and financial applications), Hyperledger Besu (an Ethereum-compatible client for public and private networks), Hyperledger Aries (a toolkit for decentralised identity and verifiable credentials), and Hyperledger Cacti (an interoperability framework). The Foundation operates under an open-governance model with technical steering committees and a diverse membership spanning technology companies, financial institutions, and governments."@en ;
    rdfs:subClassOf ngm:bc-governance-and-regulation ;
    skos:broader ngm:bc-governance-and-regulation ;
    vc:enables ngm:enterprise-blockchain,
        ngm:permissioned-blockchain,
        ngm:self-sovereign-identity ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:distributed-ledger-technology ;
    vc:slug "hyperledger-foundation" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:hyperledger-fabric,
        ngm:supply-chain-blockchain .

ngm:image-processing a owl:Class ;
    rdfs:label "Image Processing"@en ;
    rdfs:comment "Image Processing is the computational manipulation of digital images using mathematical operations to enhance visual quality, extract information, or transform image representations for downstream analysis or display. It encompasses classical signal processing operations—filtering, convolution, histogram equalisation, morphological operations, and frequency-domain transforms—as well as learned operations implemented through convolutional neural networks and vision transformers. Image processing is a prerequisite step in computer vision pipelines, medical imaging workflows, satellite remote sensing, and industrial quality inspection systems, operating on pixel grids to produce processed images or structured outputs."@en ;
    rdfs:subClassOf ngm:signal-processing ;
    vc:enables ngm:feature-extraction,
        ngm:image-classification,
        ngm:image-segmentation,
        ngm:object-detection ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:computer-vision,
        ngm:digital-signal-processing,
        ngm:image-processing-software,
        ngm:open-cv ;
    vc:slug "image-processing" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:convolutional-neural-network,
        ngm:deep-learning .

ngm:inflationary-token a owl:Class ;
    rdfs:label "Inflationary Token"@en ;
    rdfs:comment "An Inflationary Token is a blockchain token whose total circulating supply increases over time through a programmatic emission schedule, typically as a mechanism to reward network participants—validators, miners, stakers, or liquidity providers—and incentivise ongoing network participation. Unlike fixed-supply or deflationary tokens, inflationary tokens accept dilution of existing holders as the cost of sustaining economic participation incentives. Inflation rates can be fixed (constant annual issuance), variable (decreasing block rewards as in Bitcoin's halving), or algorithmically adjusted in response to network conditions such as staking participation rates. Design of the emission schedule is a critical tokenomics decision balancing security, participation, and value preservation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:consensus-mechanism ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:blockchain ],
        ngm:bc-token-and-asset,
        ngm:blockchain-entity,
        ngm:economic-mechanism ;
    skos:broader ngm:bc-token-and-asset ;
    vc:contrastsWith ngm:deflationary-token,
        ngm:stablecoin-token ;
    vc:enables ngm:governance-token,
        ngm:mining ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:miner,
        ngm:proof-of-stake,
        ngm:proof-of-work,
        ngm:token,
        ngm:yield-farming ;
    vc:requires ngm:blockchain,
        ngm:consensus-mechanism ;
    vc:slug "inflationary-token" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:token-economics,
        ngm:tokenomics .

ngm:infrastructure-layer a owl:Class ;
