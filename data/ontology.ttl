    vc:slug "spatial-audio-system" ;
    vc:sourceDomain "spatial-computing" .

ngm:specificity a owl:Class ;
    rdfs:label "Specificity"@en ;
    rdfs:comment "Specificity (also called the True Negative Rate or TNR) is the proportion of actual negative instances that a binary classifier or diagnostic test correctly identifies as negative, computed as TN / (TN + FP). It quantifies a model's ability to avoid false positives, complementing sensitivity (recall) in characterising the full operating behaviour of a classifier. Together with sensitivity, specificity defines the two axes of the Receiver Operating Characteristic (ROC) curve, enabling principled threshold selection across tasks ranging from medical diagnostics to spam filtering and anomaly detection."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:confusion-matrix ],
        ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:bridgesTo ngm:fraud-detection,
        ngm:medical-diagnostics ;
    vc:contrastsWith ngm:false-positive-rate,
        ngm:precision,
        ngm:sensitivity ;
    vc:enables ngm:anomaly-detection,
        ngm:roc-curve,
        ngm:threshold-selection ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:classifier-evaluation,
        ngm:model-evaluation ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:auc-roc,
        ngm:classification-metric,
        ngm:f1-score,
        ngm:likelihood-ratio,
        ngm:negative-predictive-value,
        ngm:recall,
        ngm:roc-curve,
        ngm:youden-index ;
    vc:requires ngm:binary-classification,
        ngm:confusion-matrix ;
    vc:slug "specificity" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:false-positive,
        ngm:true-negative .

ngm:spherical-harmonics a owl:Class ;
    rdfs:label "Spherical Harmonics"@en ;
    rdfs:comment "Spherical harmonics are a complete set of orthogonal basis functions defined on the surface of a sphere, used to represent functions of direction compactly as a weighted sum of coefficients. Analogous to a Fourier series on the sphere, they allow smooth angular functions — such as incoming light or a directional colour — to be approximated with a small number of low-order coefficients. In computer graphics they underpin precomputed radiance transfer, irradiance environment lighting, and, more recently, view-dependent colour in Gaussian splatting and neural rendering."@en ;
    rdfs:subClassOf ngm:computer-graphics ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:gaussian-splatting,
        ngm:rendering-pipeline ;
    vc:slug "spherical-harmonics" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:neural-rendering,
        ngm:real-time-rendering .

ngm:spot-bitcoin-etf a owl:Class ;
    rdfs:label "Spot Bitcoin ETF"@en ;
    rdfs:comment "A spot Bitcoin ETF is an exchange-traded fund that holds actual bitcoin and tracks its price directly, allowing investors to gain exposure through ordinary brokerage accounts without holding the asset or managing private keys. Approved by the US SEC in January 2024 after years of rejection, spot Bitcoin ETFs differ from earlier futures-based products by holding the underlying coin in regulated custody. They have channelled substantial institutional and retail capital into bitcoin and are widely regarded as a milestone in the asset's mainstream financial integration."@en ;
    rdfs:subClassOf ngm:exchange-traded-fund ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:bitcoin-proof-of-work-protocol,
        ngm:financial-regulation,
        ngm:securities-regulation ;
    vc:slug "spot-bitcoin-etf" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:institutional-investment .

ngm:standards-conformance-testing a owl:Class ;
    rdfs:label "Standards Conformance Testing"@en ;
    rdfs:comment "Testing or verification activities that determine whether a process, product, or service complies with the requirements of a specification, technical standard, contract, or regulation. Conformance testing verifies that implementations faithfully meet specified requirements through structured test suites, automated harnesses, and formal certification regimes — and is distinct from functional testing in that it judges compliance against an external normative reference rather than internal design intent."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:standards ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:software-testing ],
        ngm:sc-standards-and-interop,
        ngm:standards ;
    skos:broader ngm:sc-standards-and-interop ;
    vc:enables ngm:interoperability,
        ngm:standards-compliance ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:software-development-process,
        ngm:standards-validation ;
    vc:requires ngm:software-testing,
        ngm:standards ;
    vc:slug "standards-conformance-testing" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:accountability,
        ngm:interoperability-standard .

ngm:standards-validation a owl:Class ;
    rdfs:label "Standards Validation"@en ;
    rdfs:comment "Standards validation is the process of confirming that a development product satisfies its intended use and stakeholder requirements—distinct from verification, which checks only internal specification conformance. It employs testing, formal review, and compliance checks against published standards such as IEEE 1012 and FDA Computer Software Assurance to ensure the correct artefact was built."@en ;
    rdfs:subClassOf ngm:sc-standards-and-interop,
        ngm:standards ;
    skos:broader ngm:sc-standards-and-interop ;
    vc:hasMaturity ngmi:maturity-emerging ;
