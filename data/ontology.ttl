ngm:ipfs a owl:Class ;
    rdfs:label "IPFS"@en ;
    rdfs:comment "The InterPlanetary File System (IPFS) is a peer-to-peer, content-addressed hypermedia protocol and distributed file system in which each piece of content is identified by a Content Identifier (CID) — a self-describing cryptographic hash derived from the content itself — rather than by its network location. Nodes exchange data blocks via Bitswap and route lookups through a Kademlia-based Distributed Hash Table implemented in libp2p, while the underlying data model (IPLD) structures blocks as a Merkle DAG enabling deduplication and efficient versioning. IPFS operates as the primary off-chain storage layer for Web3 applications, decentralised websites, NFT metadata, and distributed knowledge repositories, complemented by Filecoin's incentive layer for long-term data persistence."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:ipld ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:content-identifier ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:multicodec ],
        ngm:peer-to-peer-network ;
    vc:bridgesTo ngm:blockchain,
        ngm:decentralised-autonomous-organisation,
        ngm:smart-contract ;
    vc:contrastsWith ngm:cloud-storage,
        ngm:hypertext-transfer-protocol ;
    vc:dependsOn ngm:kademlia-dht,
        ngm:multihash ;
    vc:enables ngm:decentralised-file-storage,
        ngm:decentralised-web,
        ngm:nft,
        ngm:web3 ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:ipld,
        ngm:multicodec ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:bittorrent,
        ngm:ens,
        ngm:filecoin,
        ngm:git ;
    vc:requires ngm:content-identifier,
        ngm:pinning-service ;
    vc:slug "ipfs" ;
    vc:sourceDomain "distributed-systems" ;
    vc:uses ngm:content-addressing,
        ngm:cryptographic-hash,
        ngm:distributed-hash-table,
        ngm:libp2p,
        ngm:merkle-dag,
        ngm:merkle-tree .

ngm:transaction a owl:Class ;
    rdfs:label "Transaction"@en ;
    rdfs:comment "State-changing operation on blockchain within blockchain systems, providing essential functionality for distributed ledger technology operations and properties."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
