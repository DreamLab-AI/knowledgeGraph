ngm:mining-node a owl:Class ;
    rdfs:label "Mining Node"@en ;
    rdfs:comment "A mining node is a blockchain participant that not only validates and relays transactions but also competes to produce new blocks by performing proof-of-work computation. It assembles pending transactions into candidate blocks and searches for a valid solution that allows the block to be added to the chain. Mining nodes secure proof-of-work networks and are rewarded for the blocks they successfully add."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:full-node ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:hash-function ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:proof-of-work ],
        ngm:full-node ;
