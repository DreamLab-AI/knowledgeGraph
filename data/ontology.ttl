ngm:deterministic-serialisation a owl:Class ;
    rdfs:label "Deterministic Serialisation"@en ;
    rdfs:comment "Deterministic serialisation is the encoding of structured data into bytes such that semantically identical inputs always yield exactly the same byte sequence. It fixes ambiguities like map-key ordering, number formatting, and whitespace so that the output is canonical and reproducible. This property is essential for hashing, digital signatures, and content addressing, where any byte difference changes the resulting digest."@en ;
    rdfs:subClassOf ngm:data-management ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:content-addressing,
        ngm:uri-canonicaliser ;
    vc:slug "deterministic-serialisation" ;
    vc:sourceDomain "data" .

