        ngm:data-governance,
        ngm:taxonomy ;
    vc:slug "knowledge-management-system" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:collaborative-authoring,
        ngm:content-management-system ;
    vc:uses ngm:information-retrieval,
        ngm:knowledge-graph,
        ngm:metadata-management,
        ngm:natural-language-processing .

ngm:lo-ra a owl:Class ;
    rdfs:label "Lo RA"@en ;
    rdfs:comment "A parameter-efficient fine-tuning mod that freezes pre-trained weights and injects trainable low-rank decomposition matrices into each layer of the transformer, dramatically reducing trainable parameters whilst maintaining performance."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:transformer-architecture ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:large-language-models ],
        ngm:ai-technique,
        ngm:parameter-efficient-fine-tuning ;
    skos:broader ngm:ai-technique ;
    vc:contrastsWith ngm:knowledge-distillation ;
    vc:enables ngm:fine-tuning,
        ngm:instruction-tuning ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:parameter-efficient-fine-tuning ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires ngm:large-language-models,
        ngm:transformer-architecture ;
    vc:slug "lo-ra" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:logic-programming a owl:Class ;
    rdfs:label "Logic Programming"@en ;
    rdfs:comment "Logic Programming is a programming paradigm in which computation is expressed as logical inference over a set of facts and rules written in formal logic. Programs describe what is true rather than how to compute, and an inference engine derives answers by applying resolution and unification. Prolog is the canonical language; descendant systems include Datalog, Answer Set Programming, and constraint logic programming."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:knowledge-representation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:reasoning ],
        ngm:ai-technique,
        ngm:programming-paradigm ;
    skos:broader ngm:ai-technique ;
    vc:enables ngm:expert-systems,
        ngm:formal-verification,
        ngm:knowledge-graph ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:artificial-intelligence,
        ngm:knowledge-base,
        ngm:natural-language-processing,
        ngm:semantic-web-linked-data-standard,
        ngm:software-engineering,
        ngm:symbolic-ai ;
    vc:requires ngm:knowledge-representation,
        ngm:reasoning ;
    vc:slug "logic-programming" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:database-query .

ngm:markov-chain a owl:Class ;
    rdfs:label "Markov Chain"@en ;
    rdfs:comment "A stochastic process in which the probability of each future state depends only on the current state and not on the sequence of preceding states."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:probability-theory ],
        ngm:stochastic-process ;
    vc:enables ngm:markov-chain-monte-carlo,
        ngm:markov-decision-process ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:probability-theory ;
    vc:slug "markov-chain" ;
    vc:sourceDomain "machine-learning" .

ngm:material-definition a owl:Class ;
    rdfs:label "Material Definition"@en ;
    rdfs:comment "A material definition is a structured data specification that describes how a surface or volume should appear under lighting, encoding properties such as base colour, roughness, metalness, emissivity, and transparency in a renderer-agnostic format. It underpins physically based rendering (PBR) pipelines by separating the description of physical surface behaviour from the rendering algorithm that evaluates it. Material definitions may be authored in formats such as MaterialX, glTF materials, or OpenUSD surface shading networks, enabling interchange across tools and engines. They are fundamental to achieving photorealistic and stylised visuals in real-time and offline 3D workflows."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:compute-shader ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:pixel-shader ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:vertex-shader ],
        ngm:rendering-technique ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:compute-shader,
        ngm:pixel-shader,
        ngm:vertex-shader ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:3-d-rendering,
        ngm:gltf-standard,
        ngm:open-usd,
        ngm:render-pipeline ;
    vc:slug "material-definition" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:physically-based-rendering,
        ngm:shader,
        ngm:texture-mapping .

ngm:mathematical-reasoning a owl:Class ;
    rdfs:label "Mathematical Reasoning"@en ;
    rdfs:comment "Mathematical reasoning is the faculty — in humans or artificial systems — to perform rigorous multi-step inference over mathematical structures, including arithmetic computation, algebraic manipulation, geometric reasoning, combinatorics, and formal proof construction. It demands compositional symbol manipulation, logical deduction, and the ability to track intermediate state across reasoning chains without shortcut pattern-matching. In artificial intelligence, mathematical reasoning serves as a canonical benchmark for general problem-solving capability because correct solutions are verifiable against ground truth. Contemporary approaches combine neural language models, chain-of-thought prompting, external symbolic solvers, and automated theorem provers to extend the scope of machine-tractable mathematical problems."@en ;
    rdfs:subClassOf ngm:reasoning ;
    vc:bridgesTo ngm:cryptographic-proof,
        ngm:formal-verification ;
    vc:contrastsWith ngm:commonsense-reasoning,
        ngm:probabilistic-reasoning ;
    vc:dependsOn ngm:chain-of-thought-reasoning,
        ngm:large-language-models ;
    vc:enables ngm:automated-theorem-proving,
        ngm:code-verification,
        ngm:scientific-reasoning ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:arithmetic-reasoning,
        ngm:proof-search,
        ngm:symbolic-computation,
        ngm:theorem-proving ;
    vc:isPartOf ngm:ai-research-area ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:benchmark-evaluation,
        ngm:formal-verification,
        ngm:logic-programming,
        ngm:neuro-symbolic-ai ;
    vc:requires ngm:compositional-reasoning,
        ngm:formal-logic ;
    vc:slug "mathematical-reasoning" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:code-generation,
        ngm:neural-network,
        ngm:reinforcement-learning,
        ngm:symbolic-ai .

ngm:metadata a owl:Class ;
    rdfs:label "Metadata"@en ;
    rdfs:comment "Metadata is structured information that describes, contextualises, or categorises other data, enabling its discovery, management, interpretation, and interoperability. Metadata encompasses descriptive attributes (title, author, date), structural information (format, schema, relationships), administrative records (access rights, provenance, lifecycle), and technical parameters (resolution, encoding, checksum) attached to or associated with a primary data object."@en ;
    rdfs:subClassOf ngm:data-schema ;
    vc:enables ngm:data-provenance,
