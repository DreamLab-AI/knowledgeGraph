ngm:scroll a owl:Class ;
    rdfs:label "Scroll"@en ;
    rdfs:comment "Scroll is an Ethereum layer-two network that uses zero-knowledge rollup technology to scale transactions while remaining compatible with the Ethereum Virtual Machine. It posts validity proofs to Ethereum."@en ;
