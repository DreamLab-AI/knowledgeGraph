ngm:5-g-network a owl:Class ;
    rdfs:label "5G Network"@en ;
    rdfs:comment "A 5G Network is the end-to-end fifth-generation mobile telecommunications system comprising a 5G New Radio (NR) radio access network built around gNB base stations, a cloud-native 5G Core implementing a service-based architecture with independently deployable network functions (AMF, SMF, UPF, PCF, NRF, AUSF), and the transport infrastructure interconnecting them. The architecture fundamentally separates the control plane from the user plane, enables network slicing to provision multiple virtualised logical networks on shared physical resources, and integrates multi-access edge computing nodes for deterministic low-latency application hosting. Defined across 3GPP Release 15 (frozen 2018) through Release 18 (5G-Advanced), 5G networks support three canonical service classes: enhanced Mobile Broadband (eMBB), Ultra-Reliable Low-Latency Communications (URLLC), and massive Machine-Type Communications (mMTC), making them the foundational connectivity layer for industrial IoT, autonomous systems, extended reality, and private campus networks."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:network-slicing ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:multi-access-edge-computing ],
        ngm:telecommunications-infrastructure ;
    vc:bridgesTo ngm:6-g-network-slice,
        ngm:artificial-intelligence-operations,
        ngm:digital-twin ;
    vc:contrastsWith ngm:4-g-lte,
        ngm:wi-fi ;
    vc:enables ngm:5-g-connectivity,
        ngm:autonomous-vehicles,
        ngm:extended-reality,
        ngm:io-t-infrastructure,
        ngm:private-5-g ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:5-g-core,
        ngm:5-g-nr,
        ngm:multi-access-edge-computing,
        ngm:network-slicing ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:mobile-edge-computing,
        ngm:network-infrastructure,
        ngm:open-ran ;
    vc:requires ngm:cloud-native-architecture,
        ngm:spectrum-allocation,
        ngm:transport-network ;
    vc:slug "5-g-network" ;
    vc:sourceDomain "infrastructure" ;
    vc:standardizedBy ngm:3-gpp,
        ngm:etsi,
        ngm:o-ran-alliance ;
    vc:uses ngm:edge-computing,
        ngm:massive-mimo,
        ngm:millimeter-wave,
        ngm:network-function-virtualization,
        ngm:software-defined-networking .

ngm:adam-optimiser a owl:Class ;
    rdfs:label "Adam Optimiser"@en ;
    rdfs:comment "The Adam optimiser (Adaptive Moment Estimation) is a first-order gradient-based optimisation algorithm that computes per-parameter adaptive learning rates by maintaining exponentially decaying moving averages of past gradients (first moment) and past squared gradients (second moment), with bias correction applied in early iterations. It synthesises the momentum-tracking behaviour of gradient descent with momentum and the per-parameter scaling of RMSProp, making it robust to sparse gradients, non-stationary objectives, and high-dimensional parameter spaces. Introduced by Kingma and Ba (2014), Adam has become the de-facto default optimiser for training transformer-based large language models, diffusion models, and deep neural networks across most domains. Key variants including AdamW, Adan, and AdaFactor extend it with decoupled weight decay, Nesterov momentum, and memory-efficient factorisation respectively."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:learning-rate-schedule ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:backpropagation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:loss-function ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:stochastic-gradient-descent ],
        ngm:gradient-descent ;
    vc:bridgesTo ngm:federated-learning,
        ngm:reinforcement-learning ;
    vc:contrastsWith ngm:adagrad,
        ngm:lion-optimiser,
        ngm:rmsprop,
        ngm:sgd-with-momentum ;
    vc:enables ngm:deep-learning,
        ngm:fine-tuning,
        ngm:hyperparameter-optimisation,
        ngm:model-training,
        ngm:transfer-learning ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:bias-correction,
        ngm:first-moment-estimate,
        ngm:learning-rate-schedule,
        ngm:second-moment-estimate ;
    vc:implements ngm:adaptive-learning-rate,
        ngm:momentum-optimisation ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:adafactor,
        ngm:adamw,
        ngm:gradient-clipping,
        ngm:neural-network,
        ngm:transformer-architecture,
        ngm:weight-decay ;
    vc:requires ngm:backpropagation,
        ngm:loss-function,
        ngm:stochastic-gradient-descent ;
    vc:slug "adam-optimiser" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:exponential-moving-average,
        ngm:mini-batch-gradient .

ngm:age-verification a owl:Class ;
    rdfs:label "Age Verification"@en ;
    rdfs:comment "Age verification is a set of technical and procedural mechanisms used to confirm that a user meets a minimum age threshold before accessing restricted digital content or services. It encompasses document-based checks, biometric estimation, and privacy-preserving cryptographic proofs. Regulatory frameworks such as the UK Online Safety Act mandate age verification for platforms hosting harmful content. The field balances effective enforcement against privacy risks and the potential exclusion of legitimate users."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:consent-management ],
