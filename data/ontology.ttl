    vc:slug "climate-commitments" ;
    vc:sourceDomain "governance" .

ngm:climate-finance a owl:Class ;
    rdfs:label "Climate Finance"@en ;
    rdfs:comment "Climate finance refers to funding directed towards activities that reduce greenhouse gas emissions or help adaptation to climate change. It includes public and private investment."@en ;
