ngm:error-correction a owl:Class ;
    rdfs:label "Error Correction"@en ;
    rdfs:comment "Error correction is the set of techniques and mathematical frameworks that detect and rectify errors introduced into data during transmission, storage, or computation, by adding structured redundancy that allows a decoder to infer and restore the original information even when some fraction of the data has been corrupted or lost. Unlike error detection alone, error correction codes (ECCs) carry sufficient redundancy to reconstruct the original codeword without retransmission, at the cost of additional bandwidth or storage overhead. Applications range from deep-space communication and data storage to quantum computing, where error correction is essential to suppress decoherence and enable fault-tolerant operation."@en ;
    rdfs:subClassOf ngm:fault-tolerance ;
    vc:enables ngm:distributed-storage,
        ngm:fault-tolerance-system,
        ngm:quantum-computing ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:data-integrity,
        ngm:reed-solomon-codes,
        ngm:reliability ;
    vc:slug "error-correction" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:cryptographic-hash,
        ngm:data-compression .

ngm:ethical-framework a owl:Class ;
    rdfs:label "Ethical Framework"@en ;
    rdfs:comment "A structured set of moral principles, values, and reasoning methods that guide the development, deployment, and use of AI systems to ensure they respect human dignity, promote well-being, and avoid harm. Ethical frameworks draw from consequentialism, deontology, virtue ethics, and care ethics to address AI-specific dilemmas around fairness, transparency, accountability, and privacy."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
