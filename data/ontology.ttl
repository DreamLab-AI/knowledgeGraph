    vc:slug "type-script" ;
    vc:sourceDomain "general" .

ngm:u-net a owl:Class ;
    rdfs:label "U-Net"@en ;
    rdfs:comment "A convolutional neural network architecture with a symmetric encoder-decoder structure and skip connections, originally designed for biomedical image segmentation."@en ;
