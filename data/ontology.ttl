ngm:embodied-minds a owl:Class ;
    rdfs:label "Embodied Minds"@en ;
    rdfs:comment "Embodied Minds denotes the theoretical and engineering position that genuine cognition, intelligence and meaning-making cannot be reduced to disembodied symbol manipulation or text-token prediction but instead arises from the dynamic, sensorimotor coupling of a physical body with a structured env..."@en ;
