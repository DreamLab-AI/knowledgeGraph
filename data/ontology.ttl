ngm:aes-encryption a owl:Class ;
    rdfs:comment "AES encryption is the Advanced Encryption Standard, a symmetric block cipher adopted as a US federal standard that operates on fixed-size blocks using a shared secret key for both encryption and decryption. It is the most widely deployed symmetric cipher, used by hardware security features such as Intel SGX for memory encryption and by low-power wireless protocols such as Zigbee for link-layer security. It supports 128, 192 and 256-bit key lengths, with 128-bit remaining secure against all known practical attacks."@en ;
    rdfs:label "AES Encryption"@en ;
    rdfs:subClassOf ngm:symmetric-encryption ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:slug "aes-encryption" ;
    vc:sourceDomain "security" .
ngm:aes-gcm a owl:Class ;
    rdfs:comment "AES-GCM (Advanced Encryption Standard – Galois/Counter Mode) is an authenticated encryption with associated data (AEAD) cipher mode that combines the AES block cipher operating in Counter Mode with the Galois Message Authentication Code. It provides both confidentiality and data integrity in a single pass, making it the dominant symmetric encryption scheme in modern secure communications."@en ;
    rdfs:label "AES-GCM"@en ;
    rdfs:subClassOf ngm:symmetric-encryption ;
    vc:enables ngm:end-to-end-encryption ;
