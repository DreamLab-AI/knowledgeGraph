ngm:intersectional-fairness a owl:Class ;
    rdfs:label "Intersectional Fairness"@en ;
    rdfs:comment "Intersectional Fairness is an approach to algorithmic fairness that evaluates bias and discrimination across subgroups defined by combinations of multiple protected attributes—such as race, gender, age, and disability—recognising that individuals with intersecting marginalised identities may experience unique harms not captured by single-attribute analysis. Rooted in Crenshaw's (1989) intersectionality theory, it requires auditing model performance across all cross-attribute subgroup combinations, demanding both statistical rigour and sufficient sample sizes for rare intersectional groups."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:bias-detection-methods ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:fairness-metrics ],
        ngm:ai-governance-and-ethics ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:enables ngm:fairness-accuracy-tradeoffs ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:algorithmic-bias,
        ngm:bias-mitigation-techniques,
        ngm:disparate-impact,
        ngm:explainability,
        ngm:responsible-ai ;
    vc:requires ngm:bias-detection-methods,
        ngm:fairness-metrics ;
    vc:slug "intersectional-fairness" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:ai-ethics,
        ngm:ai-governance ;
    vc:uses ngm:fairness-auditing-tools,
        ngm:fairness-constraints .

ngm:land-economics a owl:Class ;
    rdfs:label "Land Economics"@en ;
    rdfs:comment "Land Economics is the economic framework governing virtual land ownership, valuation, development, and transaction within metaverse environments, characterised by artificial scarcity, spatial positioning premiums, and speculative markets. It encompasses primary sales, secondary peer-to-peer trading, rental systems, platform taxation models, and zoning policies that together determine how virtual parcels accumulate and lose value."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:smart-contract ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:digital-ownership ],
        ngm:metaverse,
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:metaverse,
        ngm:virtual-economy ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:relatedTo ngm:digital-asset,
        ngm:virtual-labor ;
    vc:requires ngm:digital-ownership,
        ngm:smart-contract ;
    vc:slug "land-economics" ;
    vc:sourceDomain "spatial-computing" .

ngm:landscape a owl:Class ;
    rdfs:label "Landscape"@en ;
    rdfs:comment "A Landscape, in the context of this knowledge graph, is a structured market-analysis overview of the current state of an AI or technology sector, mapping key players, technology stacks, investment flows, and emerging patterns. Landscape analyses such as those from a16z or Cowboy Ventures provide practitioners with orientation in rapidly shifting fields and inform infrastructure strategy."@en ;
    rdfs:subClassOf ngm:infra-computing-and-cloud ;
    skos:broader ngm:infra-computing-and-cloud ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:infra-computing-and-cloud ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:relatedTo ngm:generative-ai,
        ngm:large-language-models ;
    vc:slug "landscape" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:machine-learning .

ngm:layer-0 a owl:Class ;
    rdfs:label "Layer 0"@en ;
    rdfs:comment "Foundation blockchain infrastructure layer providing cross-chain communication protocols, shared security mechanisms, and modular consensus abstraction to enable interoperability between multiple Layer 1 blockchains."@en ;
    rdfs:subClassOf ngm:bc-network-component ;
    skos:broader ngm:bc-network-component ;
    vc:enables ngm:cross-chain-bridge ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:implements ngm:consensus-mechanism ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:slug "layer-0" ;
    vc:sourceDomain "blockchain" .

ngm:layoff-tracker-and-threatened-roles a owl:Class ;
    rdfs:label "Layoff tracker and threatened roles"@en ;
    rdfs:comment "A curated record of mass layoffs in the technology sector from 2023 onwards, cataloguing headcount reductions at major firms alongside UK government estimates that AI automation may displace 10–30% of existing jobs. The tracker contextualises how AI adoption—particularly large language models and agentic AI—is accelerating workforce restructuring across white-collar roles."@en ;
    rdfs:subClassOf ngm:infra-software-engineering ;
    skos:broader ngm:infra-software-engineering ;
    vc:dependsOn ngm:generative-ai,
        ngm:large-language-models ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:relatedTo ngm:agentic-ai,
        ngm:artificial-intelligence,
        ngm:economics ;
    vc:slug "layoff-tracker-and-threatened-roles" ;
    vc:sourceDomain "infrastructure" .

ngm:learning-platform-categorization a owl:Class ;
    rdfs:label "Learning Platform Categorization"@en ;
    rdfs:comment "A taxonomy of platforms and environments used to deliver educational experiences, spanning traditional learning management systems, online learning portals, virtual classrooms, immersive XR-based environments, and metaverse-native learning spaces. The categorization framework identifies dimensions such as modality (synchronous/asynchronous), immersion level, social presence, and assessment integration, enabling educators and institutions to select or compare platforms for pedagogical fit. In the spatial computing context, the taxonomy extends to cover platforms that leverage augmented reality, virtual reality, and simulated environments to enable experiential, collaborative, and gamified learning at scale."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:immersive-learning ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:virtual-classroom ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:learning-management-system ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:online-learning ],
        ngm:metaverse-classification,
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:immersive-learning,
        ngm:learning-management-system,
        ngm:online-learning,
        ngm:virtual-classroom ;
    vc:isPartOf ngm:educational-technology,
        ngm:metaverse-classification ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:augmented-reality,
        ngm:collaborative-learning,
        ngm:extended-reality,
        ngm:metaverse,
        ngm:simulation,
        ngm:virtual-reality ;
    vc:slug "learning-platform-categorization" ;
    vc:sourceDomain "spatial-computing" .

ngm:legacy-media a owl:Class ;
    rdfs:label "legacy media"@en ;
    rdfs:comment "Legacy media refers to established, traditional forms of mass communication — including print, broadcast television, and radio — that preceded the digital internet era. These institutions hold significant cultural authority and are undergoing structural disruption as AI-driven platforms alter content distribution and audience economics."@en ;
    rdfs:subClassOf ngm:infra-software-engineering ;
    skos:broader ngm:infra-software-engineering ;
    vc:bridgesTo ngm:digital-transformation ;
    vc:contrastsWith ngm:social-media ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:relatedTo ngm:digital-content-creation,
        ngm:media-richness-theory,
        ngm:media-theory ;
    vc:slug "legacy-media" ;
    vc:sourceDomain "infrastructure" .

ngm:linear-encoder a owl:Class ;
    rdfs:label "Linear Encoder"@en ;
    rdfs:comment "A Linear Encoder is a position sensing device that measures linear (translational) displacement along a single axis by converting physical motion into an electrical signal — typically a series of digital pulses or an analogue waveform — that a controller can interpret as position, velocity, or acceleration data. Linear encoders may be optical (using a diffraction grating or glass scale), magnetic (using a magnetised tape), or capacitive, with resolution ranging from micrometres to nanometres in precision metrology applications. They are essential feedback elements in CNC machine tools, semiconductor lithography stages, and high-precision robotic manipulators where closed-loop positional accuracy is required."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:sensor-technology ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:sensor ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:feedback-control ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:calibration ],
        ngm:encoder,
        ngm:robo-perception ;
    skos:broader ngm:robo-perception ;
    vc:enables ngm:motion-control,
        ngm:position-control,
        ngm:servo-control ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:sensor,
        ngm:sensor-technology ;
    vc:isPartOf ngm:control-system,
        ngm:robot-hardware ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:industrial-robot,
        ngm:kinematics,
        ngm:robot-joint,
        ngm:robot-sensor,
        ngm:servo-motor ;
    vc:requires ngm:calibration,
        ngm:feedback-control ;
    vc:slug "linear-encoder" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:feedback-loop,
        ngm:feedback-mechanism .

ngm:lognet a owl:Class ;
    rdfs:label "lognet"@en ;
    rdfs:comment "LogNet is a networked knowledge-management infrastructure layer that interconnects Logseq graph nodes, enabling cross-graph querying, link resolution, and distributed publishing of structured ontology pages. It provides the network substrate over which linked-data references between pages are resolved and semantic annotations are aggregated, acting as the connective tissue between individual Logseq knowledge graphs and wider ontology repositories."@en ;
    rdfs:subClassOf ngm:infra-network-and-comms ;
    skos:broader ngm:infra-network-and-comms ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:digital-ontology-repository,
        ngm:graph-database,
        ngm:network-topology ;
    vc:slug "lognet" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:dr-o-hare-writing-for-log-seq,
        ngm:knowledge-graph,
        ngm:knowledge-graph-construction ;
    vc:uses ngm:linked-data,
        ngm:network-infrastructure .

ngm:luxury-goods-authentication a owl:Class ;
    rdfs:label "Luxury Goods Authentication"@en ;
    rdfs:comment "Luxury Goods Authentication is the application of blockchain technology to combat counterfeit luxury goods through immutable digital certificates of authenticity, NFC-enabled provenance records, and cryptographic verification that cannot be physically replicated. Implementations such as the LVMH Aura Blockchain Consortium register millions of luxury products with unique digital identities linked to manufacturing details, ownership history, and authentication credentials, enabling both primary-market consumer confidence and secondary-market resale verification."@en ;
    rdfs:subClassOf ngm:bc-network-component,
        ngm:provenance-tracking ;
    skos:broader ngm:bc-network-component ;
    vc:enables ngm:nft-ownership-proof,
        ngm:supply-chain-traceability ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:blockchain-application,
        ngm:consortium-blockchain,
        ngm:data-provenance,
        ngm:supply-chain-blockchain ;
    vc:slug "luxury-goods-authentication" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:cryptographic-verification,
        ngm:digital-certificate,
        ngm:non-fungible-token-nft,
        ngm:permissioned-blockchain,
        ngm:smart-contract .

ngm:m-bert a owl:Class ;
    rdfs:label "mBERT"@en ;
    rdfs:comment "Multilingual BERT (mBERT) is a variant of the BERT encoder pre-trained jointly on Wikipedia text in 104 languages using masked language modelling and next-sentence prediction objectives. By sharing a single vocabulary and model weights across all languages, mBERT learns cross-lingually aligned representations that support zero-shot cross-lingual transfer: a model fine-tuned for a task in one language can be applied directly to another language without that language's labelled data. mBERT is the foundational benchmark for evaluating multilingual language understanding and cross-lingual transfer learning."@en ;
    rdfs:subClassOf ngm:ai-model-architecture ;
    skos:broader ngm:ai-model-architecture ;
    vc:dependsOn ngm:fine-tuning,
        ngm:pre-training ;
    vc:enables ngm:named-entity-recognition,
        ngm:transfer-learning ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:albert,
        ngm:embedding-model,
        ngm:natural-language-processing,
        ngm:transformer-architecture ;
    vc:slug "m-bert" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:attention-mechanism,
        ngm:tokenisation .

ngm:manipulator-robot a owl:Class ;
    rdfs:label "Manipulator Robot"@en ;
    rdfs:comment "A robot consisting of a kinematic chain of rigid links connected by actuated joints, terminating in an end-effector, designed to position and orient objects or tools in a workspace. Manipulator robots include serial open-chain designs (articulated, SCARA, cylindrical, Cartesian) and parallel closed-chain designs, and are the dominant platform for industrial assembly, welding, pick-and-place, and collaborative tasks."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:scara-robot ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:cylindrical-robot ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:end-effector ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:parallel-robot ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:manipulator-arm ],
        ngm:robo-robot-type,
        ngm:robot ;
    skos:broader ngm:robo-robot-type ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:cylindrical-robot,
        ngm:end-effector,
        ngm:manipulator-arm,
        ngm:parallel-robot,
        ngm:scara-robot ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:collaborative-robot,
        ngm:human-robot-interaction,
        ngm:industrial-robot,
        ngm:robot-kinematics ;
    vc:slug "manipulator-robot" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:inverse-kinematics,
        ngm:motion-planning,
        ngm:robot-joint .

ngm:mathematical-hard-problems a owl:Class ;
    rdfs:label "Mathematical Hard Problems"@en ;
    rdfs:comment "Computationally intractable mathematical problems that form the security foundation of cryptographic systems, including integer factorisation, discrete logarithm, lattice problems, and other NP-hard challenges used in blockchain and digital security."@en ;
    rdfs:subClassOf ngm:cryptographic-security,
        ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:enables ngm:secure-digital-systems ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:slug "mathematical-hard-problems" ;
    vc:sourceDomain "spatial-computing" .

ngm:mathematical-science a owl:Class ;
    rdfs:label "Mathematical Science"@en ;
    rdfs:comment "Mathematical Science encompasses the formal disciplines—including probability theory, linear algebra, calculus, graph theory, and cryptography—that underpin machine learning model design, algorithm analysis, and blockchain cryptographic security. It provides the theoretical substrate for understanding optimisation landscapes, neural network convergence, and information-theoretic limits of AI systems."@en ;
    rdfs:subClassOf ngm:ai-research-area,
        ngm:machine-learning ;
    skos:broader ngm:ai-research-area ;
    vc:enables ngm:machine-learning,
        ngm:neural-network ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:slug "mathematical-science" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:algorithm,
        ngm:cryptography .

ngm:mecanum-wheel-robot a owl:Class ;
    rdfs:label "Mecanum Wheel Robot"@en ;
    rdfs:comment "A Mecanum Wheel Robot is a wheeled mobile robot platform that achieves true omnidirectional movement by mounting four independently driven mecanum wheels—each fitted with a ring of passive rollers oriented at 45 degrees to the wheel's rotation axis. By differentially controlling the speeds and directions of the four wheels, the platform can translate in any horizontal direction, rotate in place, or combine translation and rotation simultaneously without requiring steering joints or changing wheel orientation. Invented by Bengt Ilon at Mecanum AB in 1972, the design is widely used in warehousing, logistics, and research platforms where unrestricted planar mobility is required in confined spaces."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:robot-control ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:kinematics ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:robot-component ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:actuator ],
        ngm:omnidirectional-robot,
        ngm:robo-robot-type ;
    skos:broader ngm:robo-robot-type ;
    vc:contrastsWith ngm:differential-drive-robot,
        ngm:wheeled-robot ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:actuator,
        ngm:robot-component ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:mobile-robot,
        ngm:robot-dynamics,
        ngm:wheeled-mobile-robot ;
    vc:requires ngm:kinematics,
        ngm:robot-control ;
    vc:slug "mecanum-wheel-robot" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:motion-planning,
        ngm:robotics-control .

ngm:media-theory a owl:Class ;
    rdfs:label "Media Theory"@en ;
    rdfs:comment "An interdisciplinary field examining how communication media shape human perception, social interaction, and cultural meaning, encompassing frameworks such as media richness theory, social presence theory, and Marshall McLuhan's medium-as-message thesis. Media theory informs the design of telecollaboration and immersive systems by analysing how channel properties affect communication fidelity and presence."@en ;
    rdfs:subClassOf ngm:dc-communication ;
    skos:broader ngm:dc-communication ;
    vc:enables ngm:social-presence,
        ngm:telecollaboration ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:communication-theory,
        ngm:media-richness-theory,
        ngm:social-presence-theory ;
    vc:slug "media-theory" ;
    vc:sourceDomain "distributed-collaboration" ;
    vc:supports ngm:immersive-experience .

ngm:medical-robot a owl:Class ;
    rdfs:label "Medical Robot"@en ;
    rdfs:comment "A Medical Robot is a robotic system designed for use in clinical and healthcare settings, encompassing surgical assistants, rehabilitation exoskeletons, and diagnostic platforms. Medical robots operate under strict safety standards (ISO 13482) and integrate sensing, actuation, and AI to augment human clinical capability."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:human-robot-interaction ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:functional-safety ],
        ngm:robo-robot-type,
        ngm:service-robot ;
    skos:broader ngm:robo-robot-type ;
    vc:enables ngm:medical-imaging ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires ngm:functional-safety,
        ngm:human-robot-interaction ;
    vc:slug "medical-robot" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:computer-vision-system,
        ngm:haptic-feedback,
        ngm:medical-ai .

ngm:mermaid a owl:Class ;
    rdfs:label "mermaid"@en ;
    rdfs:comment "A JavaScript-based diagramming-as-code tool that renders flowcharts, sequence diagrams, Gantt charts, entity-relationship diagrams, and other diagram types from plain-text markup embedded in Markdown documents. Mermaid is widely adopted in developer documentation workflows, enabling version-controllable, maintainable diagrams without external tooling. It integrates natively with platforms such as GitHub, GitLab, Notion, and Logseq."@en ;
    rdfs:subClassOf ngm:infra-software-engineering ;
    skos:broader ngm:infra-software-engineering ;
    vc:enables ngm:knowledge-graph,
        ngm:ontology ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:relatedTo ngm:knowledge-representation ;
    vc:slug "mermaid" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:diagrams-as-code,
        ngm:software-engineering .

ngm:metaverse-as-markets a owl:Class ;
    rdfs:label "Metaverse as Markets"@en ;
    rdfs:comment "A conceptual framing of metaverse platforms as economic ecosystems in which virtual goods, services, experiences, and digital assets are produced, traded, and consumed. This view foregrounds creator economies, digital ownership, interoperable asset standards, and market dynamics including adoption curves, pricing models, and regulatory challenges specific to virtual worlds."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:digital-identity ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:interoperability ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:creator-economy ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:digital-goods ],
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:dependsOn ngm:metaverse-platform ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:creator-economy,
        ngm:digital-goods ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:blockchain,
        ngm:digital-economy ;
    vc:requires ngm:digital-identity,
        ngm:interoperability ;
    vc:slug "metaverse-as-markets" ;
    vc:sourceDomain "spatial-computing" .

ngm:metaverse-core-concepts a owl:Class ;
    rdfs:label "metaverse core concepts"@en ;
    rdfs:comment "Metaverse core concepts is an index class grouping the foundational building blocks of persistent shared virtual spaces: immersive rendering technologies (Augmented Reality, Spatial Computing, Haptic Feedback), virtual environments (Virtual World, Social VR, Digital Twin), digital identity and economic primitives (Digital Avatar, Virtual Asset, Virtual Economy), and cross-platform integration enablers (Interoperability). Together these concepts define the design space for metaverse platforms and standards such as those developed by the Metaverse Standards Forum."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:virtual-world ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:spatial-computing ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:haptic-feedback ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:digital-avatar ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:digital-twin ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:virtual-economy ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:interoperability ],
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:digital-avatar,
        ngm:digital-twin,
        ngm:haptic-feedback,
        ngm:virtual-economy,
        ngm:virtual-world ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:extended-reality,
        ngm:social-vr,
        ngm:virtual-asset ;
    vc:requires ngm:interoperability,
        ngm:spatial-computing ;
    vc:slug "metaverse-core-concepts" ;
    vc:sourceDomain "spatial-computing" .

ngm:metaverse-liability-model a owl:Class ;
    rdfs:label "Metaverse Liability Model"@en ;
    rdfs:comment "A comprehensive legal responsibility framework for virtual worlds that defines liability attribution, responsibility allocation, and harm redress mechanisms across platforms, users, AI agents, and content creators in metaverse environments."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:dispute-resolution ],
        ngm:metaverse-governance-and-safeguarding,
        ngm:sc-governance-and-safety ;
    skos:broader ngm:sc-governance-and-safety ;
    vc:enables ngm:harm-compensation,
        ngm:legal-accountability,
        ngm:platform-protection,
        ngm:risk-management,
        ngm:user-protection ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:ai-agent-liability,
        ngm:content-creator-liability,
        ngm:harm-redress-mechanism,
        ngm:insurance-integration,
        ngm:platform-liability-framework,
        ngm:user-liability-rules ;
    vc:isPartOf ngm:legal-governance-framework,
        ngm:virtual-society-regulations ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:dispute-resolution,
        ngm:evidence-collection,
        ngm:harm-classification-system,
        ngm:jurisdiction-mapping,
        ngm:liability-attribution-engine ;
    vc:slug "metaverse-liability-model" ;
    vc:sourceDomain "spatial-computing" .

ngm:metaverse-safety-protocol a owl:Class ;
    rdfs:label "Metaverse Safety Protocol"@en ;
    rdfs:comment "Procedures and safeguards ensuring physical and psychological safety of users during immersive metaverse experiences."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:content-moderation ],
        ngm:sc-governance-and-safety ;
    skos:broader ngm:sc-governance-and-safety ;
    vc:enables ngm:risk-mitigation,
        ngm:safe-immersive-experience,
        ngm:user-well-being ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:incident-response-protocol,
