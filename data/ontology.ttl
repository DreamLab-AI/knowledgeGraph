    vc:sourceDomain "infrastructure" .

ngm:llm-orchestration a owl:Class ;
    rdfs:label "LLM Orchestration"@en ;
    rdfs:comment "The coordination of multiple calls to one or more large language models, together with tools, retrieval and control logic, to accomplish a task that a single prompt cannot reliably handle."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
