ngm:logseq a owl:Class ;
    rdfs:label "Logseq"@en ;
    rdfs:comment "Logseq is a privacy-first, open-source, local-first personal knowledge management (PKM) platform built on a block-based outliner architecture, implemented primarily in ClojureScript with a DataScript in-memory Datalog query engine, providing bidirectional linking, hierarchical namespaces, propert..."@en ;
    rdfs:subClassOf ngm:local-first-software,
        ngm:note-taking-application ;
    vc:enables ngm:bidirectional-linking,
        ngm:block-transclusion,
        ngm:knowledge-graph-construction,
        ngm:ontology-authoring,
        ngm:pdf-annotation,
        ngm:real-time-collaboration,
        ngm:second-brain,
        ngm:spaced-repetition,
        ngm:task-management,
        ngm:zettelkasten ;
    vc:hasPart ngm:block,
        ngm:block-embed,
        ngm:block-reference,
        ngm:datalog-query,
        ngm:flashcard,
        ngm:graph-view,
        ngm:journal,
        ngm:namespace,
        ngm:page,
        ngm:pdf-annotation,
        ngm:plugin-api,
        ngm:property,
        ngm:whiteboard ;
    vc:implements ngm:block-reference,
        ngm:crdt,
        ngm:datalog,
        ngm:local-first-software,
        ngm:markdown,
        ngm:org-mode,
        ngm:property-graph,
        ngm:real-time-collaboration ;
    vc:maturity "established" ;
    vc:qualityScore "0.52"^^xsd:float ;
    vc:relatedTo ngm:getting-things-done,
        ngm:knowledge-graph,
        ngm:linked-data,
        ngm:networked-thought,
        ngm:owl,
        ngm:personal-knowledge-management,
        ngm:rdf,
        ngm:second-brain,
        ngm:semantic-web,
        ngm:zettelkasten ;
    vc:requires ngm:clojure-script,
        ngm:data-script,
        ngm:datalog,
        ngm:electron,
        ngm:markdown,
        ngm:react,
        ngm:rum,
        ngm:shadow-cljs,
        ngm:sqlite ;
    vc:slug "logseq" ;
    vc:sourceDomain "infrastructure" ;
    vc:standardizedBy ngm:clojure-script-specification,
        ngm:common-mark,
        ngm:datalog-specification,
        ngm:markdown-specification,
        ngm:org-mode-specification ;
    vc:supports ngm:academic-research,
        ngm:getting-things-done,
        ngm:literature-review,
        ngm:ontology-engineering,
        ngm:research-knowledge-base,
        ngm:second-brain,
        ngm:spaced-repetition-learning,
        ngm:zettelkasten ;
    vc:uses ngm:capacitor,
        ngm:data-script,
        ngm:electron,
        ngm:gulp,
        ngm:rum,
        ngm:shadow-cljs,
        ngm:sqlite,
        ngm:wasm .

