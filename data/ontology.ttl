# ETSI_Domain_Reality_Capture
spatial-computing:ETSI_Domain_Reality_Capture rdf:type owl:Class ;
    rdfs:label "ETSI_Domain_Reality_Capture"@en ;
    rdfs:comment "ETSI technical framework enabling digital reconstruction of physical environments and objects through 3D scanning, photogrammetry, sensor fusion, and motion capture to create semantic DigitalTwin for metaverse and immersive environments. Reality capture integrates real-time mesh generation, semantic labelling of captured objects, and Human Capture & Recognition systems enabling accurate representation of physical spaces with precise geometric, textural, and dynamic properties. Technical capabilities span volumetric video coding standards (ISO V3C/V-PCC, V3C/MIV), immersive audio (MPEG-H 3D), and spatial data intelligence enabling seamless physical-to-virtual integration for virtual collaboration, digital preservation, and immersive training across academic and commercial applications."@en ;
    skos:prefLabel "ETSI_Domain_Reality_Capture"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:spatial-computing:etsidomainrealitycapture" ;
    owl:sameAs <urn:visionclaw:concept:spatial-computing:etsidomainrealitycapture> ;
    vcw:contentHash "sha256-12-88b418de9818" ;
    vcw:qualityScore "0.4"^^xsd:decimal ;
    vcw:legacyTermId "MV-2018" ;
    vcw:ontologyStatus "draft" ;
    vcw:maturityLevel "draft" ;
    vcw:authorityScore "0.0"^^xsd:decimal ;
    dcterms:identifier "MV-2018" ;
    dcterms:subject "spatial-computing" ;
    owl:versionInfo "2.0.0" ;
    dcterms:created "2026-04-26T00:00:00Z"^^xsd:dateTime ;
    dcterms:modified "2026-04-26T13:00:00Z"^^xsd:dateTime ;
    vcw:owlRole "Concept" .

