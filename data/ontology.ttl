ngm:web-assembly a owl:Class ;
    rdfs:label "WebAssembly"@en ;
    rdfs:comment "WebAssembly (Wasm) is a binary instruction format for a stack-based virtual machine, standardised by the W3C, that provides a portable compilation target for high-level languages such as C, C++, Rust, and Go, enabling near-native execution speed inside Web Browser sandboxes and server-side ru..."@en ;
    rdfs:subClassOf ngm:infra-computing-and-cloud ;
    skos:broader ngm:infra-computing-and-cloud ;
