        ngm:utxo-model ;
    vc:enables ngm:atomic-swap,
        ngm:instant-settlement,
        ngm:micropayments,
        ngm:streaming-payments ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:channel-factory,
        ngm:htlc,
        ngm:onion-routing,
        ngm:payment-channel ;
    vc:implements ngm:bolt-specifications,
