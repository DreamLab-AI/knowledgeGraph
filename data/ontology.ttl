ngm:moderation-tools a owl:Class ;
    rdfs:label "Moderation Tools"@en ;
    rdfs:comment "Moderation tools are software systems that detect, review, and act on user-generated content or behaviour that violates platform policies, combining automated classifiers, reporting queues, and human-review workflows. They enforce community standards by flagging, filtering, age-gating, or removing content and sanctioning accounts. In immersive and social platforms they increasingly cover real-time voice, spatial, and behavioural moderation."@en ;
    rdfs:subClassOf ngm:metaverse-governance-and-safeguarding ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:community-standards,
        ngm:content-moderation-standards ;
    vc:slug "moderation-tools" ;
    vc:sourceDomain "governance" .

ngm:momentum a owl:Class ;
    rdfs:label "Momentum"@en ;
    rdfs:comment "Momentum is an optimisation technique that accelerates gradient descent by accumulating an exponentially weighted moving average of past gradients and using it to update parameters. By carrying velocity from prior steps, it damps oscillations across steep directions and speeds progress along consistent ones, improving convergence on ill-conditioned loss surfaces. Momentum underlies many modern optimisers, with Nesterov's variant and adaptive methods such as Adam building directly on its formulation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gradient-descent ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:loss-function ],
        ngm:optimization-algorithm ;
    vc:bridgesTo ngm:machine-learning ;
    vc:contrastsWith ngm:gradient-descent ;
    vc:enables ngm:convergence,
        ngm:neural-network-training ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:gradient ;
    vc:isPartOf ngm:optimization-algorithm ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:adam-optimiser,
        ngm:backpropagation,
        ngm:weight-decay ;
    vc:requires ngm:gradient-descent,
        ngm:loss-function ;
    vc:slug "momentum" ;
    vc:sourceDomain "machine-learning" ;
    vc:supports ngm:stochastic-gradient-descent ;
    vc:uses ngm:gradient,
        ngm:learning-rate .

ngm:moore-s-law a owl:Class ;
    rdfs:label "Moore's Law"@en ;
    rdfs:comment "Moore's Law is the observation, articulated by Gordon Moore in 1965, that the number of transistors on an integrated circuit doubles roughly every two years, driving exponential gains in computing capability and cost-efficiency. It functioned for decades as a self-fulfilling roadmap for the semiconductor industry. Physical and economic limits have slowed transistor scaling, shifting progress toward specialised architectures and advanced packaging."@en ;
    rdfs:subClassOf ngm:hardware ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:convergence ;
    vc:slug "moore-s-law" ;
    vc:sourceDomain "infrastructure" .

ngm:motor-controller a owl:Class ;
    rdfs:label "Motor Controller"@en ;
    rdfs:comment "A motor controller is an electronic device that regulates the speed, torque, direction, and position of an electric motor by modulating the power delivered to it, typically via pulse-width modulation and closed-loop feedback. In robotics it interprets high-level velocity or position commands and drives motors accordingly, often integrating current sensing and encoder feedback. It is a core actuation component bridging control software and mechanical motion."@en ;
    rdfs:subClassOf ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:mobile-robot-platform,
        ngm:tc-0003-telepresence-robot ;
    vc:slug "motor-controller" ;
    vc:sourceDomain "robotics" .

ngm:mounting-interface a owl:Class ;
    rdfs:label "Mounting Interface"@en ;
    rdfs:comment "A mounting interface is the standardised mechanical feature set, such as bolt patterns, flanges, and alignment pins, that defines how one component is rigidly attached to another in a mechanical or robotic assembly. It ensures repeatable positioning, load transfer, and interchangeability of links, end-effectors, sensors, and payloads. Standardised interfaces (e.g. ISO tool flanges) enable modular, reconfigurable robots."@en ;
    rdfs:subClassOf ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:mechanical-component,
        ngm:robot-link ;
    vc:slug "mounting-interface" ;
    vc:sourceDomain "robotics" .

ngm:mpc-wallet a owl:Class ;
    rdfs:label "Mpc Wallet"@en ;
    rdfs:comment "An MPC wallet is a digital wallet whose private key is split into shares held by independent parties and never reconstructed in one place, so transactions are authorised through a multi-party computation protocol that jointly produces a signature. By distributing trust across devices or institutions, it removes the single seed phrase as a single point of failure while preserving a single on-chain address. MPC wallets contrast with traditional self-custody seed wallets and with on-chain multisignature schemes by keeping the threshold logic off-chain and chain-agnostic."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:threshold-cryptography ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:key-management ],
        ngm:digital-wallet ;
    vc:bridgesTo ngm:account-abstraction,
        ngm:blockchain ;
    vc:contrastsWith ngm:hardware-security-module,
        ngm:multi-signature-wallet ;
    vc:enables ngm:multi-sig-governance,
        ngm:self-custody ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:distributed-key-generation,
        ngm:multi-party-computation,
        ngm:threshold-signature-scheme ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:digital-wallet ;
    vc:requires ngm:key-management,
        ngm:threshold-cryptography ;
    vc:slug "mpc-wallet" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:decentralized-exchange ;
    vc:uses ngm:private-key,
        ngm:secret-sharing .

ngm:mu-jo-co a owl:Class ;
    rdfs:label "MuJoCo"@en ;
    rdfs:comment "MuJoCo (Multi-Joint dynamics with Contact) is a high-speed, high-fidelity physics simulation engine designed for modelling articulated rigid-body systems with complex contact dynamics, widely used in robotics research and reinforcement learning. Developed by Emo Todorov at the University of Washington and commercialised by Roboti LLC, it was acquired by Google DeepMind in 2021 and made freely available as open-source software in 2022. MuJoCo excels at simulating musculoskeletal models, legged locomotion, dexterous manipulation, and other contact-rich robotic tasks that require accurate Lagrangian dynamics and constraint solvers. Its adoption as the standard benchmark environment for reinforcement learning algorithms—via OpenAI Gym and later Gymnasium wrappers—has made it the de facto substrate for sim-to-real transfer research in robotics."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:constraint-solver ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:rigid-body-dynamics ],
        ngm:physics-simulation ;
    vc:bridgesTo ngm:artificial-intelligence,
        ngm:machine-learning ;
    vc:contrastsWith ngm:gazebo-simulator ;
    vc:dependsOn ngm:open-source-software,
        ngm:openai-gym ;
    vc:enables ngm:dexterous-manipulation,
        ngm:domain-randomisation,
        ngm:humanoid-robotics,
        ngm:legged-locomotion,
        ngm:policy-gradient-methods ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:contact-dynamics-model ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:biomechanics,
        ngm:computational-neuroscience,
        ngm:continuous-control,
        ngm:embodied-ai-simulation,
        ngm:physics-engine,
        ngm:reinforcement-learning,
        ngm:robot-learning,
        ngm:sim-to-real-transfer ;
    vc:requires ngm:constraint-solver,
        ngm:rigid-body-dynamics ;
    vc:slug "mu-jo-co" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:convex-optimisation,
        ngm:lagrangian-dynamics,
        ngm:proximal-policy-optimisation,
        ngm:reinforcement-learning-algorithm,
        ngm:xml-model-definition .

