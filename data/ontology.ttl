    vc:slug "liverpool-smart-cities" ;
    vc:sourceDomain "infrastructure" .

ngm:lo-ra-wan a owl:Class ;
    rdfs:label "LoRaWAN"@en ;
    rdfs:comment "LoRaWAN is a media-access-control protocol and network architecture for low-power wide-area networks, built on the LoRa physical layer's chirp spread-spectrum modulation. It connects battery-powered devices to gateways over distances of several kilometres at low data rates, with end-to-end encryption and adaptive data-rate management. LoRaWAN is widely used for long-range, low-throughput IoT telemetry such as cold-chain and environmental monitoring."@en ;
    rdfs:subClassOf ngm:communication-protocol ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:cold-chain-monitoring,
        ngm:io-t-sensor-network ;
    vc:slug "lo-ra-wan" ;
    vc:sourceDomain "infrastructure" .

ngm:lock-and-mint-bridge a owl:Class ;
    rdfs:label "Lock-and-Mint Bridge"@en ;
    rdfs:comment "A lock-and-mint bridge is a cross-chain interoperability mechanism that transfers asset value between blockchains by locking the original asset in a custodial smart contract on the source chain and minting an equivalent synthetic (wrapped) representation on the destination chain, with the peg maintained by a network of validators or relayers who attest to the lock event."@en ;
    rdfs:subClassOf ngm:cross-chain-bridge ;
    vc:enables ngm:cross-chain-asset-transfer,
        ngm:cross-chain-interoperability ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:blockchain-security ;
    vc:slug "lock-and-mint-bridge" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:bridge-contract,
        ngm:smart-contract,
        ngm:wrapped-token .

ngm:lock-and-mint-mechanism a owl:Class ;
    rdfs:label "Lock and Mint Mechanism"@en ;
    rdfs:comment "Cross-chain asset transfer protocol where tokens are locked in a smart contract on the source chain and equivalent wrapped tokens are minted on the destination chain, maintaining a 1:1 backing ratio."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:blockchain-oracle ],
        ngm:bc-network-component,
        ngm:de-fi-protocol ;
    skos:broader ngm:bc-network-component ;
    vc:enables ngm:wrapped-token ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:implements ngm:cross-chain-bridge ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires ngm:blockchain-oracle ;
    vc:slug "lock-and-mint-mechanism" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:smart-contract .

ngm:locomotion a owl:Class ;
    rdfs:label "Locomotion"@en ;
    rdfs:comment "Locomotion is the capability of a robot or embodied agent to move its body through an environment by coordinating actuators against ground or fluid reaction forces. It encompasses gait generation, balance control, and trajectory execution across modalities such as legged walking, wheeled rolling, and aerial or aquatic propulsion. Robust locomotion is fundamental to autonomous mobility and physical task execution."@en ;
    rdfs:subClassOf ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:control-system,
        ngm:mobile-robot ;
    vc:slug "locomotion" ;
    vc:sourceDomain "robotics" .

