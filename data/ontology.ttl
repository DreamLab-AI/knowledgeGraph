ngm:semantic-web a owl:Class ;
    rdfs:label "Semantic Web"@en ;
    rdfs:comment "Semantic Web extends the World Wide Web with machine-readable metadata, ontologies, and linked data to enable intelligent information discovery, integration, and reasoning."@en ;
    rdfs:subClassOf ngm:ai-research-area ;
    skos:broader ngm:ai-research-area ;
    vc:enables ngm:knowledge-graph,
        ngm:knowledge-representation ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:relatedTo ngm:linked-data,
        ngm:semantic-web-standards ;
    vc:slug "semantic-web" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:rdf,
        ngm:sparql .

ngm:content-delivery-network a owl:Class ;
    rdfs:label "Content Delivery Network"@en ;
    rdfs:comment "A Content Delivery Network (CDN) is a geographically distributed system of edge servers and Points of Presence (PoPs) that cache, replicate, and serve web assets — static files, media streams, and increasingly dynamic API responses — from locations physically near end users, thereby reducing round-trip latency and offloading origin infrastructure. CDNs employ anycast routing and DNS-based request steering to direct clients to the nearest healthy PoP. Beyond caching, modern CDNs provide TLS termination, DDoS mitigation, Web Application Firewall (WAF) services, and edge compute runtimes."@en ;
    rdfs:subClassOf ngm:infra-network-and-comms ;
    skos:broader ngm:infra-network-and-comms ;
    vc:enables ngm:edge-computing,
        ngm:latency ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:slug "content-delivery-network" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:cloud-infrastructure,
        ngm:scalability-pattern ;
    vc:uses ngm:encryption,
        ngm:network-infrastructure .

ngm:payment-system a owl:Class ;
    rdfs:label "Payment System"@en ;
    rdfs:comment "A Payment System is an infrastructure layer enabling secure and auditable exchange of value between parties, encompassing fiat payment gateways, blockchain-native token transfers, and hybrid settlement mechanisms. Within virtual economies and metaverse platforms, payment systems must handle high-frequency microtransactions, cross-currency conversion, smart-contract-mediated escrow, and compliance with AML/KYC regulations while preserving user privacy and minimising settlement latency."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:smart-contract ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:blockchain-transaction ],
        ngm:bc-defi-and-economics ;
    skos:broader ngm:bc-defi-and-economics ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:relatedTo ngm:nft,
        ngm:tokenomics ;
    vc:requires ngm:blockchain-transaction,
        ngm:smart-contract ;
    vc:slug "payment-system" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:cryptographic-security,
        ngm:lightning-network .

ngm:agentic-ai a owl:Class ;
    rdfs:label "Agentic AI"@en ;
    rdfs:comment "Agentic AI refers to AI systems characterised by autonomy, goal-directedness, and the capacity to take sustained sequences of actions — including calling tools, spawning sub-agents, and modifying their own environment — in pursuit of high-level objectives specified by a user or orchestrator. Agentic systems differ from conversational AI in that they operate over extended time horizons, maintain state across steps, and may take consequential irreversible actions. The term is used both to describe individual agents and multi-agent architectures in which agentic components collaborate."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:large-language-models ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:tool-use ],
        ngm:ai-application ;
    skos:broader ngm:ai-application ;
    vc:enables ngm:autonomous-agent ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:ai-agents,
        ngm:orchestration ;
    vc:requires ngm:large-language-models,
        ngm:tool-use ;
    vc:slug "agentic-ai" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:autonomous-system a owl:Class ;
    rdfs:label "Autonomous System"@en ;
    rdfs:comment "An Autonomous System is a robotic or computational entity capable of perceiving its environment through sensors, making decisions based on that perception, and executing actions to achieve goals without continuous human intervention. Autonomous systems span platforms from autonomous vehicles and industrial robots to unmanned aerial vehicles and intelligent software agents, unified by their capacity for closed-loop perception-action cycles."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:sensor ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:motion-planning ],
        ngm:robo-robot-type ;
    skos:broader ngm:robo-robot-type ;
    vc:enables ngm:autonomous-robot,
        ngm:autonomous-vehicle ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.3"^^xsd:float ;
    vc:relatedTo ngm:robot-safety ;
    vc:requires ngm:motion-planning,
        ngm:sensor ;
    vc:slug "autonomous-system" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:reinforcement-learning .

ngm:end-effector a owl:Class ;
    rdfs:label "End Effector"@en ;
    rdfs:comment "End Effector - A task-specific tool or manipulator mounted at the Robot Wrist that physically interacts with the environment (gripper, welder, drill, camera), translating robotic control commands into productive work through mechanical, electrical, or pneumatic actuation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:control-interface ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:force-feedback ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:mechanical-interface ],
        ngm:mechanical-component,
        ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:enables ngm:assembly-operations,
        ngm:material-handling,
        ngm:precision-manufacturing ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:isPartOf ngm:manipulation-system,
        ngm:robot-arm ;
    vc:qualityScore "0.59"^^xsd:float ;
    vc:requires ngm:control-interface,
        ngm:force-feedback,
        ngm:mechanical-interface ;
    vc:slug "end-effector" ;
    vc:sourceDomain "robotics" .

ngm:explainable-ai a owl:Class ;
    rdfs:label "Explainable AI"@en ;
    rdfs:comment "AI systems designed to provide clear, understandable explanations of their decision-making processes, enabling stakeholders to comprehend how and why specific outputs are generated."@en ;
    rdfs:subClassOf ngm:ai-governance-and-ethics ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:enables ngm:ai-governance,
        ngm:bias-detection-methods ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:relatedTo ngm:ai-safety,
        ngm:model-interpretability ;
    vc:slug "explainable-ai" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:ai-governance-framework,
        ngm:regulatory-compliance .

ngm:foundation-models a owl:Class ;
    rdfs:label "Foundation Models"@en ;
    rdfs:comment "Foundation models are large-scale neural networks trained on broad, diverse datasets via self-supervised learning that acquire general-purpose representations transferable to a wide range of downstream tasks. They are characterised by massive parameter counts, emergent capabilities not explicitly trained for, and the ability to be fine-tuned or prompted for specialised applications. Prominent examples include GPT-4, BERT, CLIP, and Stable Diffusion, spanning language, vision, and multimodal domains. Their scale and generality make them qualitatively distinct from narrow task-specific models."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:training-data ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gpu-compute ],
        ngm:machine-learning-model ;
    vc:enables ngm:fine-tuning,
        ngm:image-generation,
        ngm:multimodal-ai,
        ngm:transfer-learning,
        ngm:video-generation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:deep-learning,
        ngm:generative-model,
        ngm:large-language-models ;
    vc:requires ngm:gpu-compute,
        ngm:training-data ;
    vc:slug "foundation-models" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:attention-mechanism,
        ngm:parameter-count,
        ngm:scaling-laws .

ngm:ipfs a owl:Class ;
    rdfs:label "IPFS"@en ;
    rdfs:comment "The InterPlanetary File System (IPFS) is a peer-to-peer, content-addressed hypermedia protocol and distributed file system in which each piece of content is identified by a Content Identifier (CID) — a self-describing cryptographic hash — rather than by its network location. Nodes participating in the IPFS network store and serve blocks of data identified by their CIDs, enabling resilient, censorship-resistant content distribution without a single point of failure. IPFS underpins decentralised application storage for NFT metadata, Web3 front-ends, and distributed knowledge repositories."@en ;
    rdfs:subClassOf ngm:bc-network-component,
        ngm:decentralised-file-storage ;
    skos:broader ngm:bc-network-component ;
    vc:enables ngm:decentralised-web,
        ngm:nft ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
