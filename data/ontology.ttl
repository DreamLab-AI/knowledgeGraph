artificial-intelligence:ArtificialIntelligenceDomain rdf:type owl:Class ;
    rdfs:subClassOf artificial-intelligence:TechnologyDomain ;
    rdfs:label "Artificial Intelligence Domain"@en ;
    rdfs:comment "The top-level ontological domain classification encompassing all concepts related to artificial intelligence, including research methodologies, system architectures, learning paradigms, application domains, and governance frameworks for intelligent computational systems."@en ;
    skos:prefLabel "Artificial Intelligence Domain"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:artificial-intelligence:artificial-intelligence-domain" ;
