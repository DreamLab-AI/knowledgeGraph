    vc:slug "lending-protocol" ;
    vc:sourceDomain "blockchain" .

ngm:lightning a owl:Class ;
    rdfs:label "Lightning"@en ;
    rdfs:comment "Lightning is a layer-two payment protocol built on Bitcoin that uses payment channels to enable fast, low-cost transactions off the main chain. It settles to the Bitcoin blockchain."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
