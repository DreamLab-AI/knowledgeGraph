ngm:bert a owl:Class ;
    rdfs:label "BERT"@en ;
    rdfs:comment "BERT (Bidirectional Encoder Representations from Transformers) is a pre-trained deep language representation model developed by Google AI Language, published in 2018, which applies a bidirectional Transformer encoder trained with masked language modelling (MLM) and next sentence prediction (NSP) objectives on large text corpora to produce contextualised word embeddings. Unlike prior unidirectional models, BERT conditions each token on its full left and right context simultaneously, enabling a richer semantic representation that generalises across diverse NLP tasks via fine-tuning. It established the pre-train-then-fine-tune paradigm for natural language processing, achieving state-of-the-art performance across eleven NLP benchmarks upon release, including GLUE and SQuAD. Its architecture directly underpins a large family of subsequent encoder models including RoBERTa, ALBERT, DistilBERT, and multilingual mBERT."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:pre-training ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:transfer-learning ],
        ngm:language-model ;
    vc:bridgesTo ngm:knowledge-graph-embedding,
        ngm:retrieval-augmented-generation ;
    vc:contrastsWith ngm:autoregressive-language-model,
        ngm:gpt ;
    vc:enables ngm:dense-retrieval,
        ngm:fine-tuning,
        ngm:named-entity-recognition,
        ngm:natural-language-understanding,
        ngm:question-answering,
        ngm:semantic-search,
        ngm:sentiment-analysis ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:cls-token,
        ngm:sep-token ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:albert,
        ngm:distil-bert,
        ngm:glue-benchmark,
        ngm:gpt,
        ngm:m-bert,
        ngm:natural-language-processing,
        ngm:ro-berta,
        ngm:squad,
        ngm:t5 ;
    vc:requires ngm:large-scale-corpus,
        ngm:pre-training,
        ngm:transfer-learning ;
    vc:slug "bert" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:attention-mechanism,
        ngm:embeddings,
        ngm:masked-language-modelling,
        ngm:next-sentence-prediction,
        ngm:self-attention,
        ngm:transformer-architecture,
        ngm:wordpiece-tokenisation .

ngm:biometric-verification a owl:Class ;
    rdfs:label "Biometric Verification"@en ;
    rdfs:comment "Biometric verification is the one-to-one matching process in which a live biometric sample presented by a claimant is compared against a single pre-enrolled template associated with the claimed identity, producing an accept or reject decision based on a similarity threshold. It is distinct from biometric identification, which performs a one-to-many search across an entire database, making verification faster and more privacy-preserving for authentication use cases."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-protection ],
        ngm:identity-verification ;
    vc:enables ngm:biometric-authentication,
        ngm:know-your-customer ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:aml-kyc-compliance,
        ngm:digital-identity-verification ;
    vc:requires ngm:data-protection ;
    vc:slug "biometric-verification" ;
    vc:sourceDomain "security" ;
    vc:uses ngm:biometric-binding-mechanism .

ngm:bip-340 a owl:Class ;
    rdfs:label "BIP-340"@en ;
    rdfs:comment "BIP-340 is the Bitcoin Improvement Proposal that standardises Schnorr signatures for use on the Bitcoin network using the secp256k1 elliptic curve, defining a deterministic 64-byte signature scheme that is provably secure in the random oracle model. It introduces x-only 32-byte public key encoding, a tagged hash nonce-generation procedure, and rigorous test vectors to guarantee cross-implementation compatibility. BIP-340 is a strict prerequisite for Taproot (BIP-341) and Tapscript (BIP-342), enabling key aggregation via MuSig2 and linear signature composition that makes multisignature spends indistinguishable on-chain from single-key spends. The proposal represents the most significant cryptographic upgrade to Bitcoin since its inception, substantially improving privacy, efficiency, and the expressiveness of multi-party signing protocols."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:elliptic-curve-cryptography ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:secp256k1 ],
        ngm:cryptographic-protocol ;
    vc:bridgesTo ngm:secure-multi-party-computation,
        ngm:zero-knowledge-proof ;
    vc:contrastsWith ngm:ecdsa,
        ngm:ed25519 ;
    vc:enables ngm:bip-341,
        ngm:bip-342,
        ngm:musig2,
        ngm:point-time-locked-contract,
        ngm:taproot,
        ngm:taproot-assets,
        ngm:threshold-signature ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:schnorr-signature,
        ngm:x-only-public-key ;
    vc:isPartOf ngm:taproot-soft-fork ;
    vc:qualityScore "0.78"^^xsd:float ;
    vc:relatedTo ngm:cryptographic-signature,
        ngm:digital-signature,
        ngm:elliptic-curve-cryptography,
        ngm:random-oracle-model,
        ngm:schnorr-signature,
        ngm:secp256k1 ;
    vc:requires ngm:elliptic-curve-cryptography,
        ngm:secp256k1,
        ngm:tagged-hash ;
    vc:slug "bip-340" ;
    vc:sourceDomain "blockchain" ;
    vc:standardizedBy ngm:bitcoin-core ;
    vc:supports ngm:bitcoin-privacy,
        ngm:lightning-network,
        ngm:multi-signature ;
    vc:uses ngm:bip32-hierarchical-deterministic-wallets,
        ngm:bitcoin-improvement-proposals,
        ngm:sha256 .

ngm:bitcoin-proof-of-work-protocol-core a owl:Class ;
    rdfs:label "Bitcoin Core"@en ;
    rdfs:comment "Bitcoin Core is the canonical, open-source reference implementation of the Bitcoin protocol, written primarily in C++, which full nodes run to independently validate transactions, enforce consensus rules, and maintain a complete local copy of the blockchain. Originally released by Satoshi Nakamoto in January 2009 and subsequently maintained by a global community of contributors, it establishes the authoritative behaviour of the Bitcoin network through its codebase. The software bundles a peer-to-peer networking layer, a UTXO-based scripting engine, a deterministic wallet, a mining interface, and a JSON-RPC API for integration with higher-level applications. Protocol changes are introduced exclusively via Bitcoin Improvement Proposals, requiring broad community review and backward-compatible soft-fork activation to preserve network cohesion."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:full-node ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:distributed-ledger ],
        ngm:blockchain-protocol ;
    vc:bridgesTo ngm:cryptography,
        ngm:distributed-systems ;
    vc:contrastsWith ngm:ethereum,
        ngm:proof-of-stake ;
    vc:dependsOn ngm:bitcoin-proof-of-work-protocol-network,
        ngm:open-source-software ;
    vc:enables ngm:decentralised-finance,
        ngm:digital-asset-custody,
        ngm:lightning-network ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:bitcoin-scripting-language,
        ngm:bitcoin-wallet,
        ngm:json-rpc-interface ;
    vc:implements ngm:consensus-mechanism,
        ngm:nakamoto-consensus,
        ngm:proof-of-work,
        ngm:utxo-model ;
    vc:qualityScore "0.74"^^xsd:float ;
