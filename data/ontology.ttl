ngm:ice-protocol a owl:Class ;
    rdfs:label "ICE Protocol"@en ;
    rdfs:comment "Interactive Connectivity Establishment (ICE) is an IETF framework that enables two peers behind network address translators (NATs) or firewalls to discover and negotiate the best path for direct media and data connections. It gathers candidate transport addresses via STUN and TURN servers, then performs connectivity checks to select a working candidate pair. ICE is a foundational component of real-time peer-to-peer communication."@en ;
    rdfs:subClassOf ngm:network-protocol ;
    vc:enables ngm:web-rtc ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:web-rtc ;
    vc:slug "ice-protocol" ;
    vc:sourceDomain "infrastructure" .

ngm:ico a owl:Class ;
    rdfs:label "ICO"@en ;
    rdfs:comment "An Initial Coin Offering (ICO) is a blockchain-based fundraising mechanism in which a project or organisation sells newly issued cryptographic tokens to investors in exchange for established cryptocurrencies (typically ETH or BTC) or fiat currency, with the tokens granting access to a future service, governance rights, or speculative value appreciation. ICOs gained widespread use in 2017–2018 as an alternative to traditional venture capital and IPO processes, raising billions of dollars before facing significant regulatory scrutiny from securities authorities worldwide. They differ from traditional securities offerings in being permissionless, globally accessible, and typically not subject to investor accreditation requirements."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:erc-20 ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:tokenomics ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:smart-contracts ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:kyc-aml ],
        ngm:crypto-token ;
    vc:bridgesTo ngm:crowdfunding,
        ngm:securities-law ;
    vc:contrastsWith ngm:initial-public-offering,
        ngm:mi-ca-regulation,
        ngm:venture-capital ;
    vc:dependsOn ngm:ethereum,
        ngm:investor-trust ;
    vc:enables ngm:decentralised-project-funding,
        ngm:token-distribution ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:token-sale,
        ngm:tokenomics,
        ngm:whitepaper ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:blockchain-economics,
        ngm:financial-regulation,
        ngm:initial-dex-offering,
        ngm:initial-exchange-offering,
        ngm:security-token-offering ;
    vc:requires ngm:erc-20,
        ngm:kyc-aml,
        ngm:smart-contracts ;
    vc:slug "ico" ;
    vc:sourceDomain "blockchain" ;
    vc:standardizedBy ngm:financial-conduct-authority,
        ngm:securities-and-exchange-commission ;
    vc:uses ngm:blockchain,
        ngm:cryptocurrency,
        ngm:multi-signature-wallet,
        ngm:smart-contracts .

ngm:identity-service a owl:Class ;
    rdfs:label "Identity Service"@en ;
    rdfs:comment "An identity service is a system component that manages the lifecycle of digital identities, providing authentication, authorisation, and identity data to other services within a platform architecture. It centralises functions such as user registration, credential issuance, session management, and federation so that applications can delegate trust decisions. Identity services are typically exposed via standard protocols such as OAuth 2.0, OpenID Connect, and SAML."@en ;
    rdfs:subClassOf ngm:identity-management ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:service-layer ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:platform-layer ;
    vc:slug "identity-service" ;
    vc:sourceDomain "security" .

