        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:activation-function ],
        ngm:ai-model-architecture ;
    skos:broader ngm:ai-model-architecture ;
    vc:bridgesTo ngm:distributed-training,
        ngm:hardware-accelerator ;
    vc:contrastsWith ngm:symbolic-ai ;
    vc:dependsOn ngm:backpropagation,
        ngm:gradient-descent ;
    vc:enables ngm:deep-learning,
        ngm:model-inference,
        ngm:transfer-learning ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:activation-function,
        ngm:attention-mechanism,
        ngm:neural-network-layer,
        ngm:normalisation-layer,
        ngm:residual-connection ;
    vc:implements ngm:convolutional-neural-network,
        ngm:graph-neural-network,
        ngm:neural-network,
        ngm:recurrent-neural-network,
        ngm:transformers ;
    vc:isPartOf ngm:deep-learning ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:regularisation ;
    vc:requires ngm:hyperparameter-tuning,
        ngm:training-data ;
    vc:slug "network-architecture" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:model-compression,
        ngm:neural-architecture-search ;
    vc:uses ngm:loss-function,
        ngm:model-weights .

ngm:policy a owl:Class ;
    rdfs:label "Policy"@en ;
    rdfs:comment "A policy is an explicit, authoritative statement of intent that guides decisions and prescribes acceptable behaviour or actions within an organisation or system. Policies translate high-level goals into rules, principles and constraints that can be applied consistently and enforced. In computing the term also denotes machine-readable rule sets, such as access-control policies, while in reinforcement learning a policy is a mapping from states to actions."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:compliance ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:decision-making ],
        ngm:governance-framework ;
    vc:enables ngm:regulatory-compliance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:regulation ;
    vc:isPartOf ngm:governance-framework ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:markov-decision-process,
        ngm:regulatory-framework,
        ngm:reinforcement-learning ;
    vc:requires ngm:compliance,
        ngm:decision-making ;
    vc:slug "policy" ;
    vc:sourceDomain "governance" ;
    vc:supports ngm:access-control,
        ngm:authorization .

ngm:programmable-money a owl:Class ;
    rdfs:label "Programmable Money"@en ;
    rdfs:comment "Programmable Money is a form of digital currency in which the conditions governing the creation, transfer, and use of monetary units are encoded as executable logic—typically within smart contracts on a public or permissioned blockchain—and enforced autonomously without requiring trusted intermediaries. This enables payment instruments that can embed compliance rules, spending constraints, vesting schedules, or multi-party approval workflows directly into the currency itself, transforming money from a passive bearer instrument into an active, self-enforcing contractual construct. Central bank digital currencies (CBDCs), tokenised commercial bank deposits, DeFi stablecoins, and protocol-native assets are all instances of programmable money at different points on the decentralisation and trust spectrum. The paradigm extends the concept of money from a static store of value and medium of exchange into a substrate for encoding and automating financial relationships."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:consensus-mechanism ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:cbdcs ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:tokenization ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:stablecoin ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:smart-contract ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:blockchain ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:token-standard ],
        ngm:digital-currency ;
    vc:bridgesTo ngm:algorithmic-governance,
        ngm:machine-economy,
        ngm:multi-agent-systems ;
    vc:contrastsWith ngm:commodity-money,
        ngm:fiat-currency,
        ngm:money ;
    vc:dependsOn ngm:cryptographic-hash-function,
        ngm:digital-identity,
        ngm:distributed-ledger-technology ;
    vc:enables ngm:atomic-swap,
        ngm:automated-market-maker,
        ngm:decentralized-finance-de-fi,
        ngm:delivery-versus-payment,
        ngm:payment-system ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:cbdcs,
        ngm:stablecoin,
        ngm:token-standard ;
    vc:qualityScore "0.73"^^xsd:float ;
    vc:relatedTo ngm:decentralized-autonomous-organization,
        ngm:financial-regulation,
        ngm:liquidity,
        ngm:monetary-policy ;
    vc:requires ngm:blockchain,
        ngm:consensus-mechanism,
        ngm:smart-contract,
        ngm:tokenization ;
    vc:slug "programmable-money" ;
    vc:sourceDomain "blockchain" .

ngm:redundancy a owl:Class ;
    rdfs:label "Redundancy"@en ;
    rdfs:comment "Redundancy is the deliberate duplication of components, data, or pathways in a system so that the failure of any single element does not cause overall failure. It is a foundational technique for fault tolerance, implemented through replicas, standby nodes, mirrored storage, and multiple network routes. By eliminating single points of failure, redundancy raises availability at the cost of additional resources."@en ;
    rdfs:subClassOf ngm:system-architecture ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:fault-tolerance,
        ngm:reliability-engineering ;
    vc:slug "redundancy" ;
    vc:sourceDomain "infrastructure" .

ngm:regression a owl:Class ;
    rdfs:label "Regression"@en ;
    rdfs:comment "Regression is a class of statistical and machine learning methods that model the relationship between input variables and a continuous output. It is used for prediction and for estimating effects."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:statistics ],
        ngm:supervised-learning ;
    vc:enables ngm:machine-learning-discipline ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:statistics ;
    vc:slug "regression" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:remote-collaboration a owl:Class ;
    rdfs:label "Remote Collaboration"@en ;
    rdfs:comment "Remote Collaboration encompasses the work practices, platforms, and coordination methodologies that enable geographically distributed teams to plan, create, and deliver work without physical co-location. It integrates synchronous channels such as video conferencing, real-time co-editing, and spatial audio with asynchronous mechanisms such as version control, persistent messaging, and project management systems, binding these into coherent workflows that maintain team cohesion and productivity across time zones. The discipline draws on computer-supported cooperative work (CSCW) research, network infrastructure, human-computer interaction, and organisational science to address shared challenges of presence, trust, latency, and equitable participation. Increasingly, AI-powered features such as automatic transcription, meeting summarisation, and action-item extraction, together with immersive spatial interfaces from XR and the metaverse, are extending the fidelity and richness of distributed work."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:identity-and-access-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:encryption ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:tc-0002-collaborative-document-editing ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:asynchronous-communication ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:video-conferencing ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:network-connectivity ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:virtual-workspace ],
        ngm:distributed-collaboration ;
    skos:broader ngm:distributed-collaboration ;
    vc:bridgesTo ngm:immersive-communication,
        ngm:telecollaboration,
        ngm:virtual-collaboration ;
    vc:contrastsWith ngm:co-located-collaboration,
        ngm:synchronous-communication ;
    vc:dependsOn ngm:cloud-computing,
        ngm:content-delivery-network ;
    vc:enables ngm:distributed-teams,
        ngm:knowledge-sharing,
        ngm:remote-work ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:asynchronous-communication,
        ngm:tc-0002-collaborative-document-editing,
        ngm:video-conferencing,
        ngm:virtual-workspace ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:computer-supported-cooperative-work,
        ngm:presence-awareness ;
    vc:requires ngm:encryption,
        ngm:identity-and-access-management,
        ngm:network-connectivity ;
    vc:slug "remote-collaboration" ;
    vc:sourceDomain "distributed-collaboration" ;
    vc:supports ngm:agile-software-development,
        ngm:human-computer-interaction,
        ngm:open-source-development ;
    vc:uses ngm:operational-transformation,
        ngm:spatial-audio,
        ngm:version-control .

ngm:resource-management a owl:Class ;
    rdfs:label "Resource Management"@en ;
    rdfs:comment "Resource Management is the systematic discipline of allocating, scheduling, monitoring, and optimising computational and physical resources — including CPU, GPU, memory, storage, and network bandwidth — across applications, services, and infrastructure to ensure efficient utilisation, quality-of-service guarantees, and graceful degradation under load. It encompasses the full asset lifecycle from provisioning and pooling through dynamic scaling to decommissioning, balancing competing workload demands against capacity constraints. In distributed and cloud-native environments, resource management extends to orchestration of containerised workloads, quota enforcement, cost attribution, and autoscaling policies that respond to real-time demand signals. Effective resource management is a foundational prerequisite for reliable, cost-efficient, and performant infrastructure at scale."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:monitoring ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:telemetry ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:scheduler ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:autoscaling ],
        ngm:computing-infrastructure ;
    vc:bridgesTo ngm:federated-learning,
        ngm:mlops ;
    vc:dependsOn ngm:containerisation,
        ngm:virtualisation ;
    vc:enables ngm:fault-tolerance,
        ngm:high-availability,
        ngm:metaverse-infrastructure ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:autoscaling,
        ngm:scheduler ;
    vc:implements ngm:quality-of-service,
        ngm:service-level-agreement ;
    vc:isPartOf ngm:cloud-computing,
        ngm:computing-infrastructure ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:content-delivery-network,
        ngm:cost-optimisation,
        ngm:devops ;
    vc:requires ngm:monitoring,
        ngm:telemetry ;
    vc:slug "resource-management" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:distributed-system,
        ngm:microservices ;
    vc:uses ngm:edge-computing,
        ngm:kubernetes,
        ngm:load-balancing .

ngm:schema-registry a owl:Class ;
    rdfs:label "Schema Registry"@en ;
    rdfs:comment "A centralized service that stores, validates, and manages data schemas for event streaming and API contracts, ensuring compatibility and controlled evolution of data formats across distributed microservices and event-driven architectures."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:serialisation-format ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
