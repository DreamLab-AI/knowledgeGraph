ngm:metal-api a owl:Class ;
    rdfs:comment "Metal is Apple's low-level graphics and compute application programming interface that provides near-direct access to the GPU on Apple platforms. It minimises driver overhead, exposes explicit command-buffer and resource management, and unifies rendering and general-purpose compute under one programming model. Metal is the platform-native alternative to cross-vendor APIs such as Vulkan and the legacy OpenGL on Apple hardware."@en ;
    rdfs:label "Metal Api"@en ;
    rdfs:subClassOf ngm:graphics-api ;
    rdfs:subClassOf _:r14168 ;
