    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:data-structure ;
    vc:slug "computational-geometry" ;
    vc:sourceDomain "general" .

ngm:compute-governance a owl:Class ;
    rdfs:label "Compute Governance"@en ;
    rdfs:comment "Compute governance is the set of policies, controls, and oversight mechanisms applied to the large-scale computing hardware used to train and deploy advanced AI systems. Because frontier AI capability is tightly coupled to access to specialised accelerators, governing compute offers a measurable, supply-chain-anchored lever for AI policy. Mechanisms include export controls, usage reporting thresholds, and on-chip verification of training runs."@en ;
    rdfs:subClassOf ngm:ai-governance ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:ai-risks,
        ngm:competition-in-ai ;
    vc:slug "compute-governance" ;
    vc:sourceDomain "ai" .

ngm:computed-torque-control a owl:Class ;
    rdfs:label "Computed Torque Control"@en ;
    rdfs:comment "Computed torque control is a model-based robot control method that uses the inverse dynamics of the manipulator to cancel nonlinear coupling and gravity terms, linearising the closed-loop behaviour. The controller computes the joint torques required to achieve a desired acceleration, then adds a linear feedback term to correct tracking error. It enables high-accuracy trajectory following at the cost of requiring an accurate dynamic model."@en ;
    rdfs:subClassOf ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:force-control,
        ngm:motion-control ;
    vc:slug "computed-torque-control" ;
    vc:sourceDomain "robotics" .

ngm:computer-science a owl:Class ;
    rdfs:label "Computer Science"@en ;
    rdfs:comment "Computer science is the study of computation, algorithms, data structures, and the design of computing systems and software."@en ;
    rdfs:subClassOf ngm:owl-thing ;
    vc:enables ngm:software-engineering ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:slug "computer-science" ;
    vc:sourceDomain "computer-science" .

ngm:concept-art a owl:Class ;
    rdfs:label "Concept Art"@en ;
    rdfs:comment "Concept art is a form of visual development used to explore and communicate the look, mood, and design of characters, environments, and objects before production. It serves as a pre-production reference that aligns creative direction across games, film, and animation teams. Generative image models have become a common tool for rapidly iterating concept art ideation."@en ;
    rdfs:subClassOf ngm:ai-application ;
    skos:broader ngm:ai-application ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:midjourney,
        ngm:proprietary-image-generation ;
    vc:slug "concept-art" ;
    vc:sourceDomain "ai" .

ngm:configuration-setting a owl:Class ;
    rdfs:label "Configuration Setting"@en ;
    rdfs:comment "A Configuration Setting is a named parameter or preference value that governs the runtime behaviour of a spatial computing application, platform, or XR experience. Configuration settings control rendering quality, user accessibility options, privacy preferences, and network parameters, and are typically persisted across sessions to maintain consistent user experiences within metaverse and immersive environments."@en ;
    rdfs:subClassOf ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:enables ngm:real-time-rendering,
        ngm:simulation ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:spatial-computing ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:computer-vision,
        ngm:privacy ;
    vc:slug "configuration-setting" ;
    vc:sourceDomain "spatial-computing" .

ngm:confluence a owl:Class ;
    rdfs:label "Confluence"@en ;
    rdfs:comment "Confluence is a team workspace and wiki product developed by Atlassian for collaborative documentation, knowledge management, and project information sharing. It organises content into spaces and pages with rich editing, versioning, and tight integration with issue-tracking tools such as Jira. It is widely deployed as a digital-workplace platform for enterprise knowledge capture."@en ;
    rdfs:subClassOf ngm:dc-workspace-tools ;
    skos:broader ngm:dc-workspace-tools ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:collaborative-whiteboard,
        ngm:digital-workplace-platform ;
    vc:slug "confluence" ;
    vc:sourceDomain "infrastructure" .

ngm:conformal-prediction a owl:Class ;
    rdfs:label "Conformal Prediction"@en ;
    rdfs:comment "Conformal prediction is a distribution-free framework for quantifying predictive uncertainty by producing prediction sets that contain the true outcome with a user-specified probability. Using a held-out calibration set and a nonconformity score, it provides finite-sample, model-agnostic coverage guarantees under the exchangeability assumption. It wraps around any underlying point predictor to deliver statistically valid confidence regions."@en ;
    rdfs:subClassOf ngm:machine-learning-technique ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:probabilistic-model ;
    vc:slug "conformal-prediction" ;
    vc:sourceDomain "ai" .

ngm:consensus-domain a owl:Class ;
    rdfs:label "Consensus Domain"@en ;
    rdfs:comment "The Consensus Domain is a specialised sub-domain of blockchain technology encompassing all consensus mechanisms, distributed agreement protocols, and coordination systems that enable decentralised networks to achieve consistent state without trusted central authorities. It covers Proof-of-Work, Proof-of-Stake, Byzantine Fault Tolerance variants, finality concepts, and consensus security analysis."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:byzantine-fault-tolerant-system ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:consensus-mechanism ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:consensus-algorithm ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:consensus-protocol ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:bc-cryptographic-primitive ],
        ngm:bc-protocol-and-consensus ;
    skos:broader ngm:bc-protocol-and-consensus ;
    vc:enables ngm:blockchain-network ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:consensus-algorithm,
        ngm:consensus-mechanism,
        ngm:consensus-protocol ;
    vc:isPartOf ngm:blockchain-domain ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires ngm:bc-cryptographic-primitive,
        ngm:byzantine-fault-tolerant-system ;
    vc:slug "consensus-domain" ;
    vc:sourceDomain "blockchain" .

ngm:consortium-governance a owl:Class ;
    rdfs:label "Consortium Governance"@en ;
    rdfs:comment "Consortium governance is the model by which a defined group of organisations jointly operates and controls a permissioned blockchain or shared infrastructure. Membership, validator rights, and decision-making authority are restricted to vetted participants who agree to a governing charter. It balances the decentralisation benefits of distributed ledgers with the accountability and access control enterprises require."@en ;
    rdfs:subClassOf ngm:bc-governance-and-regulation ;
    skos:broader ngm:bc-governance-and-regulation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:blockchain-as-a-service,
        ngm:enterprise-smart-contracts ;
    vc:slug "consortium-governance" ;
    vc:sourceDomain "blockchain" .

ngm:constraint-satisfaction a owl:Class ;
    rdfs:label "Constraint Satisfaction"@en ;
    rdfs:comment "A problem class in which the goal is to assign values to variables subject to constraints that restrict the allowable combinations, and the methods used to find such assignments."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:search-algorithm ],
        ngm:artificial-intelligence ;
    skos:broader ngm:artificial-intelligence ;
    vc:enables ngm:automated-planning ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:search-algorithm ;
    vc:slug "constraint-satisfaction" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:consumer-trust a owl:Class ;
    rdfs:label "Consumer Trust"@en ;
    rdfs:comment "Consumer trust is the confidence buyers place in a brand, product, or supply chain to behave reliably, safely, and ethically. It is built through verifiable provenance, transparent practices, consistent quality, and accountable handling of grievances. In supply-chain contexts it is increasingly underpinned by traceability data and ethical-sourcing attestations."@en ;
    rdfs:subClassOf ngm:governance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:consumer-protection,
        ngm:ethical-sourcing ;
    vc:slug "consumer-trust" ;
    vc:sourceDomain "supply-chain" .

ngm:content-creation-tool a owl:Class ;
    rdfs:label "Content Creation Tool"@en ;
    rdfs:comment "A content creation tool is software that enables users to author, edit, and produce digital media such as text, images, audio, 3D assets, or video. It provides the interfaces and primitives needed to turn creative intent into finished, exportable artefacts. Generative AI has expanded this category to include tools that synthesise content from prompts and steer it within a production pipeline."@en ;
    rdfs:subClassOf ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:content-creation-pipeline,
        ngm:generative-design-tool ;
    vc:slug "content-creation-tool" ;
    vc:sourceDomain "metaverse" .

ngm:content-generation a owl:Class ;
    rdfs:label "Content Generation"@en ;
    rdfs:comment "Content generation is the use of generative models to automatically produce media such as text, images, code, audio, or video from prompts or structured inputs. It relies on models that learn the distribution of training data and sample novel, coherent outputs from it. It is a core application domain of generative AI across publishing, marketing, software, and entertainment."@en ;
    rdfs:subClassOf ngm:generative-ai ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:ai-machine-learning,
        ngm:generative-ai-domain ;
    vc:slug "content-generation" ;
    vc:sourceDomain "ai" .

ngm:content-interoperability a owl:Class ;
    rdfs:label "Content Interoperability"@en ;
    rdfs:comment "Content interoperability is the ability of digital assets to be created, exchanged, and rendered consistently across different platforms, engines, and tools without loss of fidelity. It depends on shared open formats, agreed schemas, and conformant import/export behaviour. In the metaverse it is the precondition for portable 3D assets, avatars, and scenes that work across virtual worlds."@en ;
    rdfs:subClassOf ngm:sc-standards-and-interop ;
    skos:broader ngm:sc-standards-and-interop ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:gl-tf-3-d-file-format,
        ngm:metaverse-content-pipeline ;
    vc:slug "content-interoperability" ;
    vc:sourceDomain "metaverse" .

ngm:content-portability a owl:Class ;
    rdfs:label "Content Portability"@en ;
    rdfs:comment "Content portability is the property that allows users to move their digital content and the associated rights between services, platforms, or virtual environments. It depends on standardised data formats and export mechanisms so that assets retain structure and meaning after transfer. It supports user ownership, reduces vendor lock-in, and is a stated goal of open data and open metaverse initiatives."@en ;
    rdfs:subClassOf ngm:sc-standards-and-interop ;
    skos:broader ngm:sc-standards-and-interop ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:asset-format-standards,
        ngm:data-format-standard ;
    vc:slug "content-portability" ;
    vc:sourceDomain "metaverse" .

ngm:context-aware-response a owl:Class ;
    rdfs:label "Context Aware Response"@en ;
    rdfs:comment "An AI-driven capability in metaverse and virtual environments that enables systems to generate dynamic, personalized responses based on real-time understanding of user context, including location, activity, preferences, social environment, and interaction history, utilizing large language models ..."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:context-awareness-system ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:natural-language-processing ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:machine-learning ],
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:enables ngm:adaptive-ux,
        ngm:dynamic-content,
        ngm:personalized-interaction ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires ngm:context-awareness-system,
        ngm:machine-learning,
        ngm:natural-language-processing ;
    vc:slug "context-aware-response" ;
    vc:sourceDomain "spatial-computing" .

ngm:continual-learning a owl:Class ;
    rdfs:label "Continual Learning"@en ;
    rdfs:comment "A learning paradigm in which a model learns from a stream of tasks or data over time while retaining performance on previously learned tasks."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:online-learning ],
        ngm:machine-learning ;
    vc:enables ngm:transfer-learning ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:online-learning ;
    vc:slug "continual-learning" ;
    vc:sourceDomain "machine-learning" .

ngm:control-net-conditioning a owl:Class ;
    rdfs:label "ControlNet Conditioning"@en ;
    rdfs:comment "ControlNet conditioning is a technique that augments a pretrained diffusion model with an auxiliary network so generation can be steered by spatial control signals such as edge maps, depth, pose, or segmentation. The ControlNet branch copies the encoder of the base model and injects conditioning through zero-initialised connections, preserving the original weights while adding controllability. It gives image-generation pipelines precise structural control without retraining the base model."@en ;
    rdfs:subClassOf ngm:generative-model ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:comfy-ui-workflows,
        ngm:fooocus ;
    vc:slug "control-net-conditioning" ;
    vc:sourceDomain "ai" .

ngm:controlled-vocabularies a owl:Class ;
    rdfs:label "Controlled Vocabularies"@en ;
    rdfs:comment "Standardized sets of terms, phrases, and hierarchical relationships used to describe and organize information within knowledge management systems, databases, and metadata schemas, ensuring consistent indexing, retrieval, and interoperability across digital platforms and virtual environments."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:metadata-standards ],
        ngm:knowledge-organization,
        ngm:sc-standards-and-interop ;
    skos:broader ngm:sc-standards-and-interop ;
    vc:enables ngm:consistent-indexing,
        ngm:information-retrieval,
        ngm:semantic-interoperability ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires ngm:governance-process,
        ngm:metadata-standards,
        ngm:taxonomy-development ;
    vc:slug "controlled-vocabularies" ;
    vc:sourceDomain "spatial-computing" .

ngm:convex-optimisation a owl:Class ;
    rdfs:label "Convex Optimisation"@en ;
    rdfs:comment "Convex optimisation is the study of minimising convex functions over convex sets, a class of problems for which any local minimum is global and efficient algorithms exist. It is widely applied in machine learning, control and finance."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:optimisation ],
        ngm:optimisation ;
    vc:enables ngm:machine-learning ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:optimisation ;
    vc:slug "convex-optimisation" ;
    vc:sourceDomain "mathematics" .

ngm:corporate-governance a owl:Class ;
    rdfs:label "Corporate Governance"@en ;
    rdfs:comment "The system of rules, practices and processes by which a company is directed and controlled, balancing the interests of shareholders, management and other stakeholders."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:transparency ],
        [ a owl:Restriction ;
