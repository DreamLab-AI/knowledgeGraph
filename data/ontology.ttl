ngm:decentralised-network a owl:Class ;
    rdfs:comment "A Decentralised Network is a network architecture in which control, data and decision-making are distributed across many independent nodes rather than concentrated in a central authority or server. Nodes communicate peer-to-peer, share responsibility for routing, storage and consensus, and the network continues to operate even when individual nodes fail or leave. This topology improves resilience, censorship resistance and fault tolerance at the cost of greater coordination complexity."@en ;
    rdfs:label "Decentralised Network"@en ;
    rdfs:subClassOf ngm:distributed-systems ;
    rdfs:subClassOf _:r7296 ;
    rdfs:subClassOf _:r7297 ;
