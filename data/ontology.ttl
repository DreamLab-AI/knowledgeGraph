ngm:safety-oecd a owl:Class ;
    rdfs:label "Safety (OECD)"@en ;
    rdfs:comment "Under the OECD AI Principles (Principle 1.4, updated 2024), AI systems must operate without posing unacceptable risks of physical, psychological, or environmental harm. This requires lifecycle-spanning hazard analysis, fail-safe design, continuous monitoring, and incident response mechanisms, with responsibilities shared between providers who design safety in and deployers who maintain operational safety."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:functional-safety ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:risk-management ],
        ngm:sc-governance-and-safety ;
    skos:broader ngm:sc-governance-and-safety ;
    vc:contrastsWith ngm:robustness-oecd ;
    vc:enables ngm:ai-governance,
