        ngm:transfer-function .

ngm:cross-platform-interoperability a owl:Class ;
    rdfs:label "Cross-Platform Interoperability"@en ;
    rdfs:comment "The capability for heterogeneous blockchain networks, software platforms, and distributed systems to communicate, exchange data, and transfer value seamlessly without centralized intermediaries."@en ;
