    vc:slug "security-architecture" ;
    vc:sourceDomain "spatial-computing" .

ngm:security-token a owl:Class ;
    rdfs:label "Security Token"@en ;
    rdfs:comment "A blockchain-based token representing complete or fractional ownership interests in real-world assets or entities, subject to securities regulations that may restrict transfer based on investor identity, jurisdiction, or asset category. Security tokens provide holders with entitlements such as dividends, profit-sharing, or voting rights, and are typically issued through security token offerings (STOs) under regulatory compliance frameworks."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
