ngm:bip-327 a owl:Class ;
    rdfs:label "BIP-327"@en ;
    rdfs:comment "BIP-327 is a Bitcoin Improvement Proposal that specifies MuSig2, a two-round multi-party Schnorr signature protocol that enables a group of n signers to collaboratively produce a single aggregated Schnorr signature indistinguishable from a single-party signature. BIP-327 provides a cryptographically secure specification for key aggregation and signature combination compatible with BIP-340 Schnorr signatures and the Taproot upgrade, enabling private and efficient threshold custody and collaborative signing workflows on Bitcoin."@en ;
    rdfs:subClassOf ngm:bitcoin-proof-of-work-protocol-improvement-proposals ;
    vc:enables ngm:multisignature,
        ngm:multisignature-wallets ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:bip-340-schnorr-keypair,
        ngm:bip-342 ;
    vc:slug "bip-327" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:schnorr-signature,
        ngm:taproot .

ngm:bitcoin-proof-of-work-protocol-halving a owl:Class ;
    rdfs:label "Bitcoin Halving"@en ;
    rdfs:comment "The Bitcoin halving is a protocol-enforced event, occurring approximately every 210,000 blocks (roughly four years), at which the block subsidy paid to miners is cut in half. It implements Bitcoin's disinflationary monetary policy, capping total supply at 21 million coins and progressively reducing new issuance until it reaches zero around the year 2140. Halvings have historically preceded major shifts in mining economics and market price, and they are central to Bitcoin's narrative as a scarce, predictably issued digital asset."@en ;
    rdfs:subClassOf ngm:mechanism-design ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:bitcoin-proof-of-work-protocol,
        ngm:mining-pool,
        ngm:proof-of-work ;
    vc:slug "bitcoin-halving" ;
    vc:sourceDomain "blockchain" .

ngm:black-box-model a skos:Concept ;
    rdfs:label "Black Box Model"@en .

ngm:bletchley-declaration a owl:Class ;
    rdfs:label "Bletchley Declaration"@en ;
    rdfs:comment "The Bletchley Declaration is a multilateral political agreement signed in November 2023 by 28 nations and the European Union at the inaugural AI Safety Summit at Bletchley Park, UK, establishing the first intergovernmental consensus on the risks of frontier AI models. Signatories committed to international cooperation on safety evaluation, information sharing among national AI safety institutes, and the development of governance frameworks to address potentially catastrophic risks from highly capable foundation models. The declaration catalysed the formation of AI safety institutes in the UK, United States, and other signatory nations, and set the precedent for government-coordinated pre-deployment evaluations of frontier AI systems. It was followed by the Seoul AI Safety Summit in 2024, which extended commitments toward operational safety testing requirements for frontier model developers."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:frontier-ai ],
        ngm:ai-governance-and-ethics ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:bridgesTo ngm:capability-evaluation,
        ngm:interpretability,
        ngm:model-evaluation ;
    vc:contrastsWith ngm:binding-regulation,
        ngm:eu-ai-act ;
    vc:enables ngm:ai-safety-institute,
        ngm:pre-deployment-evaluation,
        ngm:red-teaming,
        ngm:risk-assessment ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:implements ngm:multilateral-governance,
        ngm:soft-law ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:ai-regulation,
        ngm:ai-risk-management,
        ngm:biosecurity,
        ngm:cybersecurity,
        ngm:dual-use-technology,
        ngm:existential-risk ;
    vc:requires ngm:foundation-models,
        ngm:frontier-ai ;
    vc:slug "bletchley-declaration" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:ai-governance,
        ngm:ai-safety-research,
        ngm:international-cooperation,
        ngm:responsible-ai .

ngm:block-height a owl:Class ;
    rdfs:label "Block Height"@en ;
    rdfs:comment "Block Height is a monotonically increasing integer representing the position of a specific block in a blockchain, defined as the count of confirmed blocks preceding it in the canonical chain (the genesis block has height 0). Block height serves as the primary temporal reference for blockchain state: smart contracts use it for time-locked operations, miners use it to calculate block rewards and halving events, and consensus rules use it to enforce protocol upgrade activation thresholds. In the presence of forks, two competing chains may share block height values; the canonical chain is determined by the fork choice rule applied at the point of divergence."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:block ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:genesis-block ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:consensus-mechanism ],
        ngm:bc-protocol-and-consensus,
        ngm:blockchain-entity,
        ngm:distributed-data-structure ;
    skos:broader ngm:bc-protocol-and-consensus ;
    vc:dependsOn ngm:proof-of-work ;
    vc:enables ngm:blockchain-governance,
        ngm:fork-choice-rule,
        ngm:smart-contract ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:block,
        ngm:genesis-block ;
    vc:isPartOf ngm:blockchain,
        ngm:blockchain-protocol ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:block-reward,
        ngm:block-time,
        ngm:chain-reorganization,
        ngm:mining-reward ;
    vc:requires ngm:consensus-mechanism ;
    vc:slug "block-height" ;
    vc:sourceDomain "blockchain" .

ngm:block-structure a owl:Class ;
    rdfs:label "Block Structure"@en ;
    rdfs:comment "Block structure is the internal data layout of a block in a blockchain or distributed ledger, specifying the fields, encoding formats, and cryptographic commitments that constitute a valid unit of the chain. A block consists of a header containing metadata — including the parent block hash, timestamp, nonce, and Merkle root of the transaction set — and a body containing the ordered list of transactions or state transitions. The specific fields, size limits, and serialisation rules of the block structure are defined by the network's consensus protocol and directly govern the chain's security properties, throughput, and upgrade path."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:nonce ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:transaction ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:merkle-root ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:block-header ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:merkle-tree ],
        ngm:block ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:block-header,
        ngm:merkle-root,
        ngm:merkle-tree,
        ngm:nonce,
        ngm:transaction ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:block-size,
        ngm:block-time,
        ngm:blockchain ;
    vc:slug "block-structure" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:cryptographic-hash .

ngm:blockchain-analysis a owl:Class ;
    rdfs:label "Blockchain Analysis"@en ;
    rdfs:comment "Blockchain analysis is the systematic examination of distributed ledger transaction data to identify patterns, trace fund flows, attribute addresses to entities, and detect illicit activity. It applies graph analytics, heuristic clustering, and machine-learning techniques to publicly available on-chain records to support compliance, law enforcement, and financial intelligence functions."@en ;
    rdfs:subClassOf ngm:digital-forensics ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:blockchain-analytics-platform ;
    vc:slug "blockchain-analysis" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:aml-kyc-compliance,
        ngm:kyc-aml ;
    vc:uses ngm:blockchain-analytics,
        ngm:heuristic-methods .

ngm:bluetooth-le a owl:Class ;
    rdfs:label "Bluetooth LE"@en ;
    rdfs:comment "Bluetooth LE (Low Energy), also known as Bluetooth Smart, is a short-range wireless communication protocol introduced in Bluetooth 4.0 (2010) and standardised by the Bluetooth SIG, designed to transmit small amounts of data at low duty cycles while consuming a fraction of the power of Classic Bluetooth. It operates in the 2.4 GHz ISM band with 40 channels, using frequency-hopping spread spectrum, and is optimised for battery-constrained devices that need to remain active for months or years on a coin cell."@en ;
    rdfs:subClassOf ngm:bluetooth-low-energy ;
    vc:enables ngm:internet-of-things,
        ngm:proximity-detection ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:embedded-systems,
        ngm:near-field-communication,
        ngm:zigbee ;
    vc:slug "bluetooth-le" ;
    vc:sourceDomain "infrastructure" ;
    vc:standardizedBy ngm:bluetooth-sig ;
    vc:uses ngm:low-energy-consumption .

ngm:bluetooth-low-energy a owl:Class ;
    rdfs:label "Bluetooth Low Energy"@en ;
    rdfs:comment "Bluetooth Low Energy (BLE) is the formal designation of the low-power wireless communication mode introduced in the Bluetooth 4.0 Core Specification (2010), standardised by the Bluetooth SIG, enabling battery-constrained devices to communicate over short ranges (typically 10–100 m) using duty-cycled radio bursts with peak currents measured in milliamps. It defines a complete protocol stack from physical layer through application profiles, and has become the dominant short-range radio for wearable, medical, industrial, and IoT devices."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:bluetooth-le ],
        ngm:internet-of-things ;
    vc:enables ngm:sensor-technology,
        ngm:service-discovery ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:bluetooth-le ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:near-field-communication,
        ngm:thread-protocol,
        ngm:zigbee ;
    vc:slug "bluetooth-low-energy" ;
    vc:sourceDomain "infrastructure" ;
    vc:standardizedBy ngm:bluetooth-sig ;
    vc:uses ngm:embedded-systems .

ngm:bolt-specification a skos:Concept ;
    rdfs:label "Bolt Specification"@en .

ngm:bounding-volume a owl:Class ;
    rdfs:label "Bounding Volume"@en ;
    rdfs:comment "A Bounding Volume is a simple geometric shape—typically a sphere, axis-aligned bounding box (AABB), oriented bounding box (OBB), or convex hull—that encloses a more complex geometric object or set of objects. By testing intersections or containment against the bounding volume rather than the full geometry, real-time rendering engines, physics simulators, and spatial query systems achieve orders-of-magnitude speedups during broad-phase culling and collision detection."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:bounding-volume-hierarchy ],
        ngm:spatial-data-structure ;
    vc:enables ngm:collision-detection,
        ngm:frustum-culling,
        ngm:occlusion-culling ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:bounding-volume-hierarchy ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:scene-graph,
        ngm:spatial-index ;
    vc:slug "bounding-volume" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:physics-simulation,
        ngm:real-time-rendering .

ngm:c2-pa-content-credentials a owl:Class ;
    rdfs:label "C2PA Content Credentials"@en ;
    rdfs:comment "C2PA Content Credentials are cryptographically signed metadata manifests, defined by the Coalition for Content Provenance and Authenticity (C2PA) technical specification, that are embedded in or bound to digital media assets to record their origin, capture conditions, AI generation provenance, and editing history in a tamper-evident chain. Each Content Credential is a JUMBF-structured (JPEG Universal Metadata Box Format) assertion set signed using the COSE (CBOR Object Signing and Encryption) standard, anchored to the asset via a cryptographic hash binding that detects post-signing modifications. Verifiers — including browser extensions, social media platforms, AI disclosure tools, and editing software — can retrieve and display the full credential chain, enabling transparent and auditable provenance for photographs, video, audio, documents, and AI-generated synthetic content. The mechanism serves as the primary interoperability layer between hardware capture devices, editing software, AI generation systems, and distribution platforms participating in the broader content authenticity ecosystem."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:hardware-security-module ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:certificate-authority ],
        ngm:infra-security-and-identity ;
    skos:broader ngm:infra-security-and-identity ;
    vc:bridgesTo ngm:ai-regulation,
        ngm:generative-ai ;
    vc:contrastsWith ngm:ai-watermarking,
        ngm:deepfakes,
        ngm:steganography ;
    vc:enables ngm:ai-transparency,
        ngm:content-supply-chain-integrity,
        ngm:creator-attribution ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:implements ngm:c2-pa-standard,
        ngm:cose-signing,
        ngm:jumbf-container-format ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:digital-provenance,
        ngm:exif-metadata,
        ngm:iptc-photo-metadata,
        ngm:open-content-authenticity-initiative,
        ngm:w3c-verifiable-credentials ;
    vc:requires ngm:certificate-authority,
        ngm:hardware-security-module ;
    vc:slug "c2-pa-content-credentials" ;
    vc:sourceDomain "security" ;
    vc:supports ngm:ai-generated-content-disclosure,
        ngm:disinformation-countermeasures,
        ngm:media-authenticity,
        ngm:provenance-verification,
        ngm:trust-and-safety ;
    vc:uses ngm:cryptographic-hash,
        ngm:digital-signature,
        ngm:provenance-tracking,
        ngm:public-key-infrastructure,
        ngm:x-509-certificate .

ngm:cache-layer a owl:Class ;
    rdfs:label "Cache Layer"@en ;
    rdfs:comment "A cache layer is an intermediate storage tier interposed between a data consumer and an authoritative data source, holding frequently or recently accessed data in faster storage to reduce latency, decrease load on origin systems, and improve overall system throughput. Cache layers operate at multiple levels of a computing stack—CPU caches, in-process memory caches, distributed shared caches, and edge CDN caches—each exploiting temporal or spatial locality of access patterns. Correctness requires coherence protocols or explicit invalidation strategies to prevent stale data from being served."@en ;
    rdfs:subClassOf ngm:storage-layer ;
    vc:enables ngm:performance-optimization,
        ngm:scalability ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:content-delivery-network-cdn,
        ngm:database-system,
        ngm:latency ;
    vc:slug "cache-layer" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:data-storage,
        ngm:kv-cache .

ngm:calculus a skos:Concept ;
    rdfs:label "Calculus"@en .

ngm:camera-tracking a owl:Class ;
    rdfs:label "Camera Tracking"@en ;
    rdfs:comment "Camera Tracking is the process of continuously estimating the position and orientation (pose) of a camera in 3D space relative to a fixed reference frame or scene, typically using image feature analysis, optical flow, or fiducial marker detection. It underpins augmented reality, visual effects compositing, robotic navigation, and autonomous vehicle perception by enabling virtual or computed elements to be correctly registered to the physical world as the camera moves."@en ;
    rdfs:subClassOf ngm:motion-tracking ;
    vc:enables ngm:augmented-reality,
        ngm:slam,
        ngm:visual-odometry ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:epipolar-geometry,
        ngm:pose-estimation ;
    vc:slug "camera-tracking" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:feature-detection,
        ngm:marker-based-tracking,
        ngm:optical-flow .

ngm:carbon-offsetting a owl:Class ;
    rdfs:label "Carbon Offsetting"@en ;
    rdfs:comment "Carbon offsetting is the practice whereby an entity compensates for its greenhouse gas emissions by financing or undertaking activities that achieve an equivalent reduction or removal of carbon dioxide equivalent (CO2e) elsewhere in the global economy. Offsets are quantified in standardised units — typically one tonne of CO2e per credit — and must satisfy criteria of additionality, permanence, measurability, and independent verification to be considered credible. The mechanism operates across compliance markets (e.g. the EU Emissions Trading System) and voluntary markets (e.g. Gold Standard, Verra VCS), and spans project types including afforestation, improved cookstoves, methane capture, and direct air capture. Controversy around offset quality, permanence risks, and potential for greenwashing has driven increasing scrutiny from regulators, standards bodies, and civil society."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:carbon-registry ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:carbon-credits ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:carbon-accounting ],
        ngm:sustainability ;
    vc:bridgesTo ngm:blockchain,
        ngm:smart-contracts ;
    vc:contrastsWith ngm:carbon-reduction,
        ngm:greenwashing ;
    vc:enables ngm:carbon-neutrality,
        ngm:climate-finance,
        ngm:net-zero ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:carbon-credits,
        ngm:carbon-registry,
        ngm:offset-project ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:climate-change,
        ngm:esg,
        ngm:paris-agreement,
        ngm:scope-3-emissions ;
    vc:requires ngm:additionality,
        ngm:carbon-accounting,
        ngm:measurement-reporting-and-verification ;
    vc:slug "carbon-offsetting" ;
    vc:sourceDomain "governance" ;
    vc:standardizedBy ngm:gold-standard,
        ngm:iso-14064,
        ngm:verified-carbon-standard ;
    vc:uses ngm:emissions-trading-scheme,
        ngm:life-cycle-assessment,
        ngm:voluntary-carbon-market .

ngm:ccpa a owl:Class ;
    rdfs:label "CCPA"@en ;
    rdfs:comment "The California Consumer Privacy Act (CCPA), a California state statute enacted in 2018 that grants California residents rights over the personal information that businesses collect about them, including the right to know, the right to delete, the right to opt out of sale, and the right to non-discrimination."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
