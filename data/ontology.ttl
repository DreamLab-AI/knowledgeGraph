    vc:contrastsWith ngm:just-in-time-manufacturing ;
    vc:enables ngm:provenance-tracking,
        ngm:sustainability-reporting,
        ngm:trade-finance ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:demand-forecasting,
        ngm:inventory-management,
        ngm:logistics-optimization,
        ngm:procurement ;
    vc:qualityScore "0.72"^^xsd:float ;
