ngm:bitcoin-halving a owl:Class ;
    rdfs:label "Bitcoin Halving"@en ;
    rdfs:comment "The Bitcoin halving is a protocol-enforced event, occurring approximately every 210,000 blocks (roughly four years), at which the block subsidy paid to miners is cut in half. It implements Bitcoin's disinflationary monetary policy, capping total supply at 21 million coins and progressively reducing new issuance until it reaches zero around the year 2140. Halvings have historically preceded major shifts in mining economics and market price, and they are central to Bitcoin's narrative as a scarce, predictably issued digital asset."@en ;
    rdfs:subClassOf ngm:mechanism-design ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:bitcoin,
        ngm:mining-pool,
        ngm:proof-of-work ;
    vc:slug "bitcoin-halving" ;
    vc:sourceDomain "blockchain" .

ngm:bletchley-declaration a owl:Class ;
    rdfs:label "Bletchley Declaration"@en ;
    rdfs:comment "The Bletchley Declaration is a joint statement signed in November 2023 by 28 nations and the European Union at the inaugural AI Safety Summit held at Bletchley Park, UK, in which signatories acknowledged the serious risks posed by frontier AI models and committed to international cooperation on safety evaluation, information sharing, and the development of national and international governance frameworks. It represents the first multilateral political commitment specifically addressing the risks of highly capable foundation models and established the precedent for government-led AI safety institutes conducting pre-deployment evaluations."@en ;
    rdfs:subClassOf ngm:ai-governance-and-ethics ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:enables ngm:risk-assessment ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:ai-regulation,
        ngm:responsible-ai ;
    vc:slug "bletchley-declaration" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:ai-governance,
        ngm:ai-safety-research .

ngm:blind-signatures a owl:Class ;
    rdfs:label "Blind Signatures"@en ;
    rdfs:comment "Blind Signatures are a cryptographic primitive invented by David Chaum in 1982 that allow a signer to sign a message without being able to see its content, enabling the message author to later unblind the signature and present a valid signature from the signer without the signer being able to link the signing event to the subsequent presentation. The scheme preserves the unlinkability property — the signer cannot correlate a signing request with a later use of that signature — making it foundational for privacy-preserving payment systems and anonymous credential issuance."@en ;
    rdfs:subClassOf ngm:cryptographic-primitive ;
    vc:enables ngm:ecash,
        ngm:privacy-enhancing-technologies ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:verifiable-credentials,
        ngm:zero-knowledge-proof ;
    vc:slug "blind-signatures" ;
    vc:sourceDomain "security" ;
    vc:uses ngm:cryptographic-algorithm,
        ngm:digital-signature .

ngm:block-explorer a owl:Class ;
    rdfs:label "Block Explorer"@en ;
    rdfs:comment "A Block Explorer is a web-based or API-accessible tool that indexes and presents the contents of a blockchain in human-readable form, enabling users to search, inspect, and verify blocks, transactions, addresses, smart contracts, and network statistics without operating a full node locally. Block explorers ingest raw node data, parse it according to the chain's consensus rules, and expose it through search interfaces and REST or GraphQL APIs. They are the primary transparency and audit interface for blockchain networks."@en ;
    rdfs:subClassOf ngm:blockchain-analytics ;
    vc:enables ngm:audit-trail,
        ngm:transparency ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:blockchain-network,
        ngm:mempool ;
    vc:slug "block-explorer" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:blockchain-transaction,
        ngm:data-visualisation,
        ngm:full-node .

ngm:block-snapshot a owl:Class ;
    rdfs:label "Block Snapshot"@en ;
    rdfs:comment "A block snapshot is a record of on-chain state, typically token balances or governance weights, captured at a specific block height. In decentralised governance it freezes voting power at a chosen block so that token holdings used to weight votes cannot be manipulated by transfers during the voting window. Snapshots underpin gasless off-chain voting systems and fair airdrop distributions by providing a tamper-evident, reproducible baseline state."@en ;
    rdfs:subClassOf ngm:bc-governance-and-regulation ;
    skos:broader ngm:bc-governance-and-regulation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:on-chain-voting ;
    vc:slug "block-snapshot" ;
    vc:sourceDomain "blockchain" .

ngm:blockchain-collaboration a owl:Class ;
    rdfs:label "Blockchain Collaboration"@en ;
    rdfs:comment "\"The use of blockchain distributed ledger technology, smart contracts, and cryptocurrency systems to coordinate, govern, and compensate geographically distributed teams, enabling trustless collaboration through cryptographic verification, automated enforcement of agreements, and transparent recor..."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:consensus-protocol ],
        ngm:dc-protocol-and-infra,
        ngm:telecollaboration-domain ;
    skos:broader ngm:dc-protocol-and-infra ;
    vc:enables ngm:transparent-decision-making ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires ngm:consensus-protocol ;
    vc:slug "blockchain-collaboration" ;
    vc:sourceDomain "distributed-collaboration" .

ngm:blockchain-technology a owl:Class ;
    rdfs:label "Blockchain Technology"@en ;
    rdfs:comment "Blockchain Technology is a class of distributed ledger systems in which transactions are grouped into cryptographically linked blocks, forming an append-only chain maintained by a peer-to-peer network through a consensus mechanism. The design ensures that altering any historical record would require re-doing proof-of-work or obtaining supermajority stake, making fraudulent revision computationally or economically prohibitive."@en ;
    rdfs:subClassOf ngm:distributed-ledger-technology ;
    vc:enables ngm:blockchain-provenance,
        ngm:decentralised-finance,
        ngm:smart-contract ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:digital-signature,
        ngm:immutability ;
    vc:slug "blockchain-technology" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:consensus-mechanism,
        ngm:cryptographic-hash,
        ngm:merkle-tree .

ngm:bls-signature a owl:Class ;
    rdfs:label "BLS Signature"@en ;
    rdfs:comment "A BLS Signature (Boneh–Lynn–Shacham signature) is a cryptographic signature scheme built on bilinear pairings over elliptic curves that permits multiple individual signatures to be aggregated into a single constant-size signature, which can be verified against the aggregate of the corresponding public keys in a single pairing operation. This aggregation property drastically reduces bandwidth and verification cost when many parties must co-sign a message or attest to a block."@en ;
    rdfs:subClassOf ngm:digital-signature ;
    vc:enables ngm:consensus-mechanism,
        ngm:threshold-signature-scheme ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:key-management,
        ngm:zero-knowledge-proof ;
    vc:slug "bls-signature" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:elliptic-curve-cryptography,
        ngm:public-key-cryptography .

ngm:bluetooth-sig a owl:Class ;
    rdfs:label "Bluetooth SIG"@en ;
    rdfs:comment "The Bluetooth Special Interest Group (Bluetooth SIG) is the non-profit trade association responsible for developing, maintaining, and licensing the Bluetooth wireless communication standard. Founded in 1998 by Ericsson, IBM, Intel, Nokia, and Toshiba, it governs the Bluetooth Core Specification and the library of Bluetooth profiles, managing qualification and branding programmes that ensure interoperability among the over 50,000 member companies worldwide."@en ;
    rdfs:subClassOf ngm:standards-body ;
    vc:enables ngm:bluetooth-le,
        ngm:bluetooth-low-energy,
        ngm:interoperability ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:embedded-systems,
        ngm:internet-of-things ;
    vc:slug "bluetooth-sig" ;
    vc:sourceDomain "infrastructure" ;
    vc:standardizedBy ngm:ieee-standards-association .

ngm:boardroom a owl:Class ;
    rdfs:label "Boardroom"@en ;
    rdfs:comment "The Boardroom is the physical or virtual environment in which a company's board of directors convenes to exercise its governance responsibilities, encompassing both the formal meeting space and the institutional setting—including procedures, information flows, and power dynamics—that shape board decision-making. As a governance construct, it represents the apex deliberative forum where strategy, risk, and oversight responsibilities are discharged."@en ;
    rdfs:subClassOf ngm:governance ;
    vc:enables ngm:accountability,
        ngm:board-level-oversight ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:compliance,
        ngm:stakeholder,
        ngm:transparency ;
    vc:slug "boardroom" ;
    vc:sourceDomain "governance" ;
    vc:uses ngm:governance-framework,
        ngm:risk-management .

ngm:bounding-volume a owl:Class ;
    rdfs:label "Bounding Volume"@en ;
    rdfs:comment "A Bounding Volume is a simple geometric shape—typically a sphere, axis-aligned bounding box (AABB), oriented bounding box (OBB), or convex hull—that encloses a more complex geometric object or set of objects. By testing intersections or containment against the bounding volume rather than the full geometry, real-time rendering engines, physics simulators, and spatial query systems achieve orders-of-magnitude speedups during broad-phase culling and collision detection."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:bounding-volume-hierarchy ],
        ngm:spatial-data-structure ;
    vc:enables ngm:collision-detection,
        ngm:frustum-culling,
        ngm:occlusion-culling ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:bounding-volume-hierarchy ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:scene-graph,
        ngm:spatial-index ;
    vc:slug "bounding-volume" ;
    vc:sourceDomain "spatial" ;
    vc:uses ngm:physics-simulation,
        ngm:real-time-rendering .

ngm:bulletproofs a owl:Class ;
    rdfs:label "Bulletproofs"@en ;
    rdfs:comment "Bulletproofs are a class of short, non-interactive zero-knowledge proof system that enables efficient range proofs and arbitrary arithmetic circuit satisfiability without a trusted setup. Based on the discrete logarithm assumption over elliptic curves, they produce logarithmically-sized proofs that can be aggregated and batched, making them particularly well-suited to confidential transaction systems in public blockchains where proof size and verification cost are critical constraints."@en ;
    rdfs:subClassOf ngm:zero-knowledge-proof ;
    vc:enables ngm:confidential-transactions,
        ngm:cryptographic-proof ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:privacy-preserving-blockchain ;
    vc:slug "bulletproofs" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:commitment-scheme,
        ngm:elliptic-curve-cryptography,
        ngm:schnorr-signature .

ngm:business-process-automation a owl:Class ;
    rdfs:label "Business Process Automation"@en ;
    rdfs:comment "The use of technology to automate complex, multi-step business processes beyond individual tasks, integrating systems and people to streamline operations. It targets end-to-end workflows rather than isolated actions."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:workflow-automation ],
        ngm:process-automation ;
    vc:enables ngm:automation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:workflow-automation ;
    vc:slug "business-process-automation" ;
    vc:sourceDomain "automation" .

ngm:bvh-acceleration-structure a owl:Class ;
    rdfs:label "BVH Acceleration Structure"@en ;
    rdfs:comment "A bounding volume hierarchy (BVH) is a tree-based spatial data structure that recursively partitions scene geometry into nested bounding volumes to accelerate ray-geometry intersection queries. By testing rays against coarse parent volumes before descending into child nodes, a BVH reduces intersection complexity from linear in primitive count to roughly logarithmic. It is the dominant acceleration structure in modern ray tracing because it supports fast rebuilds for dynamic scenes and maps efficiently to GPU hardware."@en ;
    rdfs:subClassOf ngm:rendering-technique ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:ray-tracing ;
    vc:slug "bvh-acceleration-structure" ;
    vc:sourceDomain "metaverse" .

ngm:c4-model a owl:Class ;
    rdfs:label "C4 Model"@en ;
    rdfs:comment "The C4 Model is a hierarchical software architecture notation system developed by Simon Brown that uses four abstraction levels — Context, Containers, Components, and Code — to describe and communicate the structure of a software system at progressively increasing levels of technical detail. Each level targets a different audience, from non-technical stakeholders at the Context level to developers at the Code level, using a minimal, tool-agnostic set of diagram elements that are easy to reason about and keep up to date."@en ;
    rdfs:subClassOf ngm:software-architecture ;
    vc:enables ngm:documentation-generation,
        ngm:documentation-standards ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:enterprise-architecture ;
    vc:slug "c4-model" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:diagrams-as-code,
        ngm:structurizr-dsl .

ngm:calibration-system a owl:Class ;
    rdfs:label "Calibration System"@en ;
    rdfs:comment "A Calibration System is an integrated assembly of hardware targets, measurement instruments, algorithms, and software workflows used to determine and correct systematic errors in sensors, cameras, and measurement devices, establishing a known and traceable relationship between a sensor's raw outputs and the physical quantities they represent. Calibration systems are essential preconditions for accurate spatial measurement, computer vision, robotics, and extended reality applications."@en ;
    rdfs:subClassOf ngm:calibration-equipment ;
    vc:enables ngm:computer-vision,
        ngm:photogrammetry,
        ngm:sensor-fusion ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:slam ;
    vc:slug "calibration-system" ;
    vc:sourceDomain "spatial" ;
    vc:uses ngm:imu,
        ngm:optical-calibration-target,
        ngm:sensor-calibration .

ngm:camera-tracking-system a owl:Class ;
    rdfs:label "Camera Tracking System"@en ;
    rdfs:comment "A camera tracking system is a hardware and software assembly that continuously records the position, orientation, and lens parameters of a physical camera in three-dimensional space, transmitting this data in real time to rendering or compositing engines so that computer-generated imagery can be seamlessly integrated with live-action footage. Such systems underpin virtual production stages, augmented reality overlays, broadcast graphics, and visual effects pipelines. Tracking technologies include optical encoder arrays, inertial measurement units, infrared LED constellations, machine vision fiducial markers, and LiDAR-based spatial mapping."@en ;
    rdfs:subClassOf ngm:camera-tracking ;
    vc:enables ngm:augmented-reality,
        ngm:spatial-anchoring ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:camera-parameters ;
    vc:slug "camera-tracking-system" ;
    vc:sourceDomain "spatial" ;
    vc:uses ngm:camera-calibration,
        ngm:camera-intrinsics,
        ngm:motion-capture .

ngm:canonical-json a owl:Class ;
    rdfs:label "Canonical JSON"@en ;
    rdfs:comment "Canonical JSON is a normalised serialisation form of JSON that specifies a unique, deterministic byte-level representation for any given JSON value, enabling reliable hashing, digital signatures, and binary equality comparisons over JSON documents. Because RFC 8259 JSON permits equivalent representations that differ in whitespace, key ordering, and number formatting, canonical forms such as JCS (JSON Canonicalization Scheme, RFC 8785) and earlier proposals impose rules including lexicographic key sorting, no insignificant whitespace, and IEEE 754 double-precision serialisation for numbers. This determinism is essential in cryptographic contexts where the same logical object must produce the same digest regardless of which implementation serialised it."@en ;
    rdfs:subClassOf ngm:data-format ;
    vc:enables ngm:interoperability ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:data-format-standard,
        ngm:interoperability-standard ;
    vc:slug "canonical-json" ;
    vc:sourceDomain "web" ;
    vc:standardizedBy ngm:standards-body ;
    vc:uses ngm:cryptography,
        ngm:hash-function .

ngm:cbdc-infrastructure a owl:Class ;
    rdfs:label "CBDC Infrastructure"@en ;
    rdfs:comment "CBDC infrastructure refers to the technical systems, protocols, and institutional arrangements that underpin the issuance, distribution, settlement, and management of central bank digital currencies. It encompasses the ledger technology (centralised, distributed, or hybrid), API layers enabling interoperability with commercial banks and payment service providers, offline payment capability, and the privacy-preserving and security mechanisms required for sovereign digital money at scale. CBDC infrastructure must satisfy central bank requirements for finality, programmability, resilience, and monetary policy control that differ fundamentally from commercial digital payment systems."@en ;
    rdfs:subClassOf ngm:payment-infrastructure ;
    vc:enables ngm:central-bank-digital-currency,
        ngm:cross-border-payments,
        ngm:digital-payments ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:cbdc-frameworks,
        ngm:monetary-policy-implementation ;
    vc:slug "cbdc-infrastructure" ;
    vc:sourceDomain "finance" ;
    vc:uses ngm:atomic-settlement,
        ngm:cryptographic-infrastructure .

ngm:chainlink a owl:Class ;
    rdfs:label "Chainlink"@en ;
    rdfs:comment "Chainlink is a decentralised oracle network that enables smart contracts on any blockchain to securely access off-chain data, computation, and cross-chain interoperability services. Founded by Sergey Nazarov and Steve Ellis, it operates a network of independent node operators that retrieve, aggregate, and deliver external data — price feeds, weather data, randomness, event outcomes — to on-chain smart contracts, bridging the oracle problem that prevents blockchains from natively accessing real-world information. Chainlink's native token (LINK) incentivises node operators and is staked as collateral to provide cryptoeconomic guarantees of data accuracy."@en ;
    rdfs:subClassOf ngm:blockchain-oracle ;
    vc:enables ngm:chainlink-ccip,
        ngm:cross-chain-interoperability,
        ngm:enterprise-smart-contracts ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:blockchain-interoperability,
        ngm:cross-chain-messaging ;
    vc:slug "chainlink" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:chainlink-oracles,
        ngm:decentralized-finance-de-fi,
        ngm:smart-contract .

ngm:chainlink-oracles a owl:Class ;
    rdfs:label "Chainlink Oracles"@en ;
    rdfs:comment "Chainlink Oracles are decentralised oracle networks operated by the Chainlink protocol that securely fetch, validate, and deliver off-chain data to on-chain smart contracts. They aggregate inputs from multiple independent node operators using cryptographic proofs and reputation systems to ensure tamper-resistant data feeds. Widely deployed for price feeds, verifiable randomness, and cross-chain communication, they form critical infrastructure for decentralised finance and Web3 applications."@en ;
    rdfs:subClassOf ngm:oracle-network ;
    vc:enables ngm:cross-chain-interoperability,
        ngm:decentralized-finance-de-fi,
        ngm:smart-contract ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:chainlink,
        ngm:chainlink-ccip,
        ngm:price-oracle ;
    vc:slug "chainlink-oracles" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:cryptographic-proof,
        ngm:verifiable-random-function .

ngm:ci-cd-automation a owl:Class ;
    rdfs:label "CI-CD Automation"@en ;
    rdfs:comment "Continuous integration and continuous delivery (CI/CD) automation is the practice of automatically building, testing, and deploying software changes through a defined pipeline triggered by source-control events. Continuous integration merges and validates changes frequently to detect defects early; continuous delivery extends this to produce always-deployable artefacts, while continuous deployment automates release to production. CI/CD automation reduces integration risk, shortens feedback loops, and makes deployments repeatable and auditable. It is implemented through pipeline-as-code definitions executed by orchestrators such as GitHub Actions, GitLab CI, and Jenkins."@en ;
    rdfs:subClassOf ngm:automation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.78"^^xsd:float ;
    vc:relatedTo ngm:model-deployment,
        ngm:software-engineering ;
    vc:slug "ci-cd-automation" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:data-pipeline .

ngm:civitai a owl:Class ;
    rdfs:label "Civitai"@en ;
    rdfs:comment "Civitai is a community-driven online platform for sharing, discovering, and downloading fine-tuned generative AI image models, primarily Stable Diffusion checkpoints, LoRA adaptors, embeddings, and VAEs, enabling practitioners and artists to distribute specialised model weights trained on specific styles, characters, or concepts without requiring the infrastructure overhead of operating their own model registry. It functions as both a social network for AI artists and a technical marketplace for model artefacts."@en ;
    rdfs:subClassOf ngm:generative-ai ;
    vc:enables ngm:creative-ai,
        ngm:text-to-image ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:content-moderation,
        ngm:generative-model,
        ngm:open-source-ai ;
    vc:slug "civitai" ;
    vc:sourceDomain "media" ;
    vc:uses ngm:diffusion-model,
        ngm:fine-tuning,
        ngm:image-generation .

ngm:classification-rules a owl:Class ;
    rdfs:label "Classification Rules"@en ;
    rdfs:comment "Classification Rules are explicit logical statements, typically in an if-then form, that assign instances or entities to predefined categories based on the values of their attributes or the satisfaction of specified conditions. Derived from rule-learning algorithms, expert elicitation, or ontology reasoning, classification rules provide interpretable, auditable decision logic for categorising data points in machine learning, knowledge engineering, and regulatory compliance contexts. They contrast with black-box classifiers by exposing their decision rationale directly as symbolic propositions."@en ;
    rdfs:subClassOf ngm:inference-engine ;
    vc:enables ngm:expert-systems,
        ngm:machine-learning ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:knowledge-base,
        ngm:owl,
        ngm:rdf ;
    vc:slug "classification-rules" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:knowledge-graph,
        ngm:logic-programming,
        ngm:ontology .

ngm:claude a owl:Class ;
    rdfs:label "Claude"@en ;
    rdfs:comment "Claude is a family of large language model AI assistants developed by Anthropic, designed with safety and harmlessness as first-order design objectives alongside capability. Claude models are trained using Constitutional AI and reinforcement learning from human feedback to be helpful, harmless, and honest, embodying Anthropic's research programme on aligning advanced AI systems with human values. The Claude model family spans Haiku, Sonnet, and Opus tiers offering cost-performance trade-offs, and supports extended context windows, tool use, agentic workflows, and multimodal inputs. Claude has been widely adopted in enterprise API integrations, developer tooling, and consumer applications."@en ;
    rdfs:subClassOf ngm:proprietary-large-language-models ;
    vc:enables ngm:conversational-ai,
        ngm:function-calling,
        ngm:tool-use ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:anthropic,
        ngm:anthropic-claude,
        ngm:large-language-models ;
    vc:slug "claude" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:agentic-workflow,
        ngm:constitutional-ai,
        ngm:rlhf .

ngm:client-side-validation a owl:Class ;
    rdfs:label "Client-Side Validation"@en ;
    rdfs:comment "Client-Side Validation is the process of verifying user-supplied data within the browser or client application before that data is transmitted to a server, providing immediate feedback to users and reducing unnecessary network requests. In the context of Bitcoin and RGB Protocol, it refers to a distinct validation paradigm where the full state of off-chain assets is verified locally by the recipient rather than by all network nodes, enabling scalable, private asset transfers. The two usages share the principle of local verification but differ fundamentally in their security models and scope."@en ;
    rdfs:subClassOf ngm:data-integrity ;
    vc:enables ngm:rgb-protocol,
        ngm:zero-knowledge-proof ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:bitcoin-network,
        ngm:layer-2-solutions,
        ngm:zero-knowledge ;
    vc:slug "client-side-validation" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:cryptographic-proof,
        ngm:json-schema .

ngm:clinical-trials a owl:Class ;
    rdfs:label "Clinical Trials"@en ;
    rdfs:comment "Blockchain-based clinical trial management systems employ immutable audit trails, smart contracts for protocol compliance, and cryptographic verification to ensure data integrity, prevent fraud, and provide FDA 21 CFR Part 11 compliant tamper-proof records whilst reducing monitoring costs. These systems address pharmaceutical development challenges including data falsification, patient recruitment inefficiency, and multi-site coordination failures."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-integrity ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:blockchain-compliance ],
        ngm:bc-network-component ;
    skos:broader ngm:bc-network-component ;
    vc:dependsOn ngm:compliance-framework ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:requires ngm:blockchain-compliance,
        ngm:data-integrity ;
    vc:slug "clinical-trials" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:drug-discovery,
        ngm:healthcare-records ;
    vc:uses ngm:audit-trail,
        ngm:hyperledger-fabric,
        ngm:smart-contract .

ngm:clip-encoder a owl:Class ;
    rdfs:label "CLIP Encoder"@en ;
    rdfs:comment "A CLIP Encoder is either of the two paired neural network encoders — an image encoder and a text encoder — within the Contrastive Language-Image Pre-training (CLIP) framework developed by OpenAI. Each encoder maps its respective modality into a shared high-dimensional embedding space where semantically related image-text pairs are placed in proximity, enabling zero-shot image classification, cross-modal retrieval, and semantic image search without task-specific fine-tuning. CLIP Encoders serve as foundational components in multimodal AI pipelines, diffusion model conditioning, and vision-language models."@en ;
    rdfs:subClassOf ngm:encoder ;
    vc:enables ngm:diffusion-model,
        ngm:image-classification,
        ngm:multimodal-learning ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:clip,
        ngm:computer-vision,
        ngm:embedding ;
    vc:slug "clip-encoder" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:contrastive-learning,
        ngm:transformer,
        ngm:vision-transformer .

ngm:clock-recovery a owl:Class ;
    rdfs:label "Clock Recovery"@en ;
    rdfs:comment "Clock recovery (clock and data recovery, CDR) is the physical-layer process by which a receiver extracts a synchronised timing reference from an incoming data stream that carries no separate clock signal. It uses phase-locked loops or oversampling to align sampling instants with the centre of each symbol, compensating for jitter and frequency offset between transmitter and receiver. It matters because correct sampling timing is essential for reliable symbol detection in serial communication links."@en ;
    rdfs:subClassOf ngm:infra-network-and-comms ;
    skos:broader ngm:infra-network-and-comms ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:physical-layer ;
    vc:slug "clock-recovery" ;
    vc:sourceDomain "infrastructure" .

ngm:cloud-storage-infrastructure a owl:Class ;
    rdfs:label "Cloud Storage Infrastructure"@en ;
    rdfs:comment "Cloud storage infrastructure is the distributed system of servers, object and block stores, replication, and access APIs that lets applications persist and retrieve data on demand over a network. It provides durability through redundancy, elastic capacity, and tiered performance classes ranging from hot object storage to cold archives. It matters because it is the foundation for storing large media assets, such as meeting recordings, at scale with high availability and pay-as-you-go economics."@en ;
    rdfs:subClassOf ngm:infra-computing-and-cloud ;
    skos:broader ngm:infra-computing-and-cloud ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:meeting-recording ;
    vc:slug "cloud-storage-infrastructure" ;
    vc:sourceDomain "infrastructure" .

ngm:co-ap a owl:Class ;
    rdfs:label "CoAP"@en ;
    rdfs:comment "The Constrained Application Protocol (CoAP) is a specialised web transfer protocol defined in RFC 7252 (IETF, 2014) designed for use with constrained nodes and networks in the Internet of Things ecosystem. Modelled on HTTP's request-response semantics and RESTful resource model but optimised for low-power, lossy networks, CoAP uses UDP as its transport layer, features a compact binary header, supports observe (pub/sub) extensions, and includes built-in mechanisms for reliability, multicast, and asynchronous communication. CoAP is a cornerstone protocol for IoT device management and machine-to-machine communication."@en ;
    rdfs:subClassOf ngm:network-protocol ;
    vc:contrastsWith ngm:http-protocol,
        ngm:mqtt ;
    vc:enables ngm:building-automation,
        ngm:edge-computing,
        ngm:internet-of-things ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:slug "co-ap" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:embedded-systems,
        ngm:rest-api .

ngm:coco-dataset a owl:Class ;
    rdfs:label "COCO Dataset"@en ;
    rdfs:comment "The COCO Dataset (Common Objects in Context) is a large-scale benchmark dataset for computer vision research comprising over 330,000 images with dense per-instance annotations covering object detection, instance segmentation, panoptic segmentation, keypoint estimation, and image captioning across 80 object categories in natural everyday scenes. Released in 2014 by Microsoft Research, it became the de-facto standard evaluation corpus for detection and segmentation models because its annotations capture objects in realistic, cluttered contexts rather than artificially isolated settings. COCO metrics—specifically Average Precision (AP) averaged across IoU thresholds—are the primary performance currency for reporting state-of-the-art results in visual perception research."@en ;
    rdfs:subClassOf ngm:benchmarks ;
    vc:enables ngm:instance-segmentation,
        ngm:object-detection,
        ngm:panoptic-segmentation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:image-segmentation,
        ngm:machine-learning-model,
        ngm:object-recognition ;
    vc:slug "coco-dataset" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:computer-vision,
        ngm:data-annotation .

ngm:collaborative-technology a owl:Class ;
    rdfs:label "Collaborative Technology"@en ;
    rdfs:comment "Collaborative Technology encompasses the hardware, software, protocols, and infrastructure components that enable distributed teams to work together effectively across time and space. This includes real-time media processing, synchronisation protocols, edge computing for latency reduction, and zero-trust security models forming the technological substrate of telecollaboration."@en ;
    rdfs:subClassOf ngm:infra-computing-and-cloud ;
    skos:broader ngm:infra-computing-and-cloud ;
    vc:dependsOn ngm:networking-infrastructure ;
    vc:enables ngm:telecollaboration,
        ngm:video-conferencing ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:slug "collaborative-technology" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:distributed-collaboration ;
    vc:uses ngm:communication-protocol,
        ngm:network-protocol .

ngm:collision-detection-system a owl:Class ;
    rdfs:label "Collision Detection System"@en ;
    rdfs:comment "A computational subsystem that continuously tests whether geometric objects in a simulation or physical environment intersect or are about to intersect, enabling physics engines, robotics planners, and interactive applications to respond to contact events. It combines spatial partitioning structures with narrow-phase geometry tests to balance accuracy against performance."@en ;
    rdfs:subClassOf ngm:collision-detection ;
    vc:enables ngm:collision-avoidance,
        ngm:haptic-feedback ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:cloth-simulation,
        ngm:collaborative-simulation ;
    vc:slug "collision-detection-system" ;
    vc:sourceDomain "spatial" ;
    vc:uses ngm:bullet-physics,
        ngm:game-engine .

ngm:communication-network a owl:Class ;
    rdfs:label "Communication Network"@en ;
    rdfs:comment "A communication network is an interconnected collection of nodes and links that transports information between endpoints according to shared protocols. Networks are characterised by their topology, switching method, transmission media, and the protocol stack that governs addressing, routing, and error control. They span scales from local wireless links to global packet-switched internetworks, and they provide the substrate on which distributed systems, decentralised ledgers, and immersive media depend. Performance is described by metrics including bandwidth, latency, jitter, and reliability."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:transport-layer ],
        ngm:communication-infrastructure ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:transport-layer ;
    vc:qualityScore "0.76"^^xsd:float ;
    vc:relatedTo ngm:network-performance-metrics ;
    vc:slug "communication-network" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:communication-protocol .

ngm:communication-protocols a owl:Class ;
    rdfs:label "Communication Protocols"@en ;
    rdfs:comment "Formal rules and conventions that govern how data is formatted, transmitted, received and acknowledged between communicating systems."@en ;
    rdfs:subClassOf ngm:network-protocol ;
    vc:enables ngm:interoperability ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:slug "communication-protocols" ;
    vc:sourceDomain "general" .

ngm:communication-theory a owl:Class ;
    rdfs:label "Communication Theory"@en ;
    rdfs:comment "Communication Theory provides the theoretical foundations for understanding how information, meaning, and social presence are transmitted and perceived in mediated communication contexts. Key frameworks include media richness theory, social presence theory, and theories of computer-mediated communication that directly inform the design of telecollaboration systems and collaborative technology."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:media-richness-theory ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:social-presence-theory ],
        ngm:dc-communication,
        ngm:telecollaboration ;
    skos:broader ngm:dc-communication ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:media-richness-theory,
        ngm:social-presence-theory ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:relatedTo ngm:social-presence,
        ngm:video-conferencing ;
    vc:slug "communication-theory" ;
    vc:sourceDomain "distributed-collaboration" ;
    vc:supports ngm:collaborative-technology,
        ngm:telecollaboration .

ngm:compatibility-process a owl:Class ;
    rdfs:label "Compatibility Process"@en ;
    rdfs:comment "Systematic procedure for ensuring that digital assets, applications, and systems conform to common standards, protocols, and specifications to enable seamless exchange, integration, and interoperability across metaverse platforms."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:standards-conformance-testing ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:integration-testing ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:compatibility-standards ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:validation-tools ],
        ngm:compatibility-standards,
        ngm:sc-standards-and-interop ;
    skos:broader ngm:sc-standards-and-interop ;
    vc:enables ngm:asset-portability,
        ngm:cross-platform-interoperability,
        ngm:ecosystem-connectivity,
        ngm:standards-compliance,
        ngm:system-integration ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:cross-platform-testing,
        ngm:format-validation,
        ngm:integration-testing,
        ngm:interoperability-verification,
        ngm:protocol-compatibility-checks,
        ngm:standards-conformance-testing ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:compatibility-standards,
        ngm:conformance-criteria,
        ngm:reference-implementations,
        ngm:test-specifications,
        ngm:validation-tools ;
    vc:slug "compatibility-process" ;
    vc:sourceDomain "spatial-computing" .

ngm:compatibility-standards a owl:Class ;
    rdfs:label "Compatibility Standards"@en ;
    rdfs:comment "Technical specifications and protocols that enable interoperability between different metaverse platforms, virtual environments, and digital systems, including asset formats, communication protocols, and interface standards that allow seamless user experiences across multiple platforms without ve..."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:standards-body ],
        ngm:sc-standards-and-interop,
        ngm:technical-standards ;
    skos:broader ngm:sc-standards-and-interop ;
    vc:enables ngm:asset-portability,
        ngm:cross-platform-experience,
        ngm:interoperability ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires ngm:industry-collaboration,
        ngm:protocol-development,
        ngm:standards-body ;
    vc:slug "compatibility-standards" ;
    vc:sourceDomain "spatial-computing" .

ngm:complaint-infrastructure a owl:Class ;
    rdfs:label "Complaint Infrastructure"@en ;
    rdfs:comment "Complaint infrastructure is the organisational and technical system through which consumers can submit, track, escalate, and resolve grievances against providers, and through which regulators monitor systemic harms. It comprises intake channels, case-management workflows, redress mechanisms, and reporting that feed enforcement and policy. It matters because accessible, auditable complaint handling is a structural requirement of consumer-protection regimes, turning individual grievances into actionable signals and remedies."@en ;
    rdfs:subClassOf ngm:regulatory-compliance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:consumer-protection ;
    vc:slug "complaint-infrastructure" ;
    vc:sourceDomain "governance" .

ngm:compliance-layer a owl:Class ;
    rdfs:label "Compliance Layer"@en ;
    rdfs:comment "The Compliance Layer is the cross-cutting stratum that checks system behaviour against external obligations such as law, regulation, and contractual terms. It sits above the Policy Layer, consuming its enforcement records, and reports to the Regulatory and Governance Layers. It contains controls, evidence collection, audit trails, and conformance assessments rather than the operations being assessed."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:governance-layer ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:policy-layer ],
        ngm:owl-thing ;
    vc:enables ngm:institutional-layer,
        ngm:regulatory-layer ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:governance-layer,
        ngm:policy-layer ;
    vc:slug "compliance-layer" ;
    vc:sourceDomain "compliance" .

ngm:compliance-systems a owl:Class ;
    rdfs:label "Compliance Systems"@en ;
    rdfs:comment "Compliance systems are the integrated software and process frameworks organisations use to enforce, monitor, and report adherence to laws, regulations, and internal policies. They encompass policy management, control automation, monitoring and alerting, audit-trail capture, and regulatory reporting workflows. They matter because they operationalise obligations such as content-moderation duties under the Digital Services Act or custody and reporting rules for digital assets, turning legal requirements into continuously enforced controls."@en ;
    rdfs:subClassOf ngm:regulatory-compliance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:digital-asset-management,
        ngm:digital-services-act ;
    vc:slug "compliance-systems" ;
    vc:sourceDomain "governance" .

ngm:component a owl:Class ;
    rdfs:label "Component"@en ;
    rdfs:comment "A discrete, modular unit within an AI system or infrastructure that provides a specific capability, can be developed and tested independently, and interacts with other components through defined interfaces. Components include hardware accelerators, software modules, model artefacts, data pipelines, and monitoring subsystems."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:neural-network-layer ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:neural-network-component ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:ai-system-component ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:hardware-component ],
        ngm:ai-infrastructure ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:ai-system-component,
        ngm:hardware-component,
        ngm:neural-network-component,
        ngm:neural-network-layer ;
    vc:isPartOf ngm:ai-system-eu-definition ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:ai-framework,
        ngm:ai-infrastructure,
        ngm:embedded-systems,
        ngm:machine-learning-framework,
        ngm:machine-learning-pipeline ;
    vc:slug "component" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:computational-hardness-assumption a owl:Class ;
    rdfs:label "Computational Hardness Assumption"@en ;
    rdfs:comment "A computational hardness assumption is a conjecture that a particular mathematical problem cannot be solved efficiently by any probabilistic polynomial-time algorithm. Such assumptions, including integer factorisation, the discrete logarithm, and learning-with-errors, are the foundations on which provable security of cryptographic schemes is reduced. If an assumption is broken, every construction whose security reduces to it is compromised."@en ;
    rdfs:subClassOf ngm:cryptographic-primitive ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:cryptography,
        ngm:digital-signature ;
    vc:slug "computational-hardness-assumption" ;
    vc:sourceDomain "security" .

ngm:computer-graphics-domain a owl:Class ;
    rdfs:label "Computer Graphics Domain"@en ;
    rdfs:comment "The Computer Graphics Domain covers the synthesis and manipulation of visual content through computation. Its scope includes rendering, geometric modelling, animation and real-time visualisation. It is a top-level subject classification concerned with the generation of imagery. The boundary is the inverse of computer vision, since it produces images from models rather than inferring models from images."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:real-time-rendering ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:compute-layer ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:animation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:linear-algebra ],
        ngm:owl-thing ;
    vc:enables ngm:digital-content-creation,
        ngm:virtual-environment,
        ngm:visualisation ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:animation,
        ngm:geometric-modelling,
        ngm:real-time-rendering,
        ngm:rendering,
        ngm:shading ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:compute-layer,
        ngm:geometry,
        ngm:linear-algebra ;
    vc:slug "computer-graphics-domain" ;
    vc:sourceDomain "computer-graphics" .

ngm:computer-use a owl:Class ;
    rdfs:label "Computer Use"@en ;
    rdfs:comment "Computer Use is an AI capability that enables multimodal models to perceive, navigate, and interact with graphical user interfaces, desktop applications, and operating system environments to autonomously complete multi-step tasks. The model receives screenshot observations of the screen and emits mouse-click, keyboard, and scroll actions, effectively operating software as a human operator would. It extends conventional tool-use paradigms by treating the entire GUI surface as an action space rather than a structured API."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:tool-use ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:multimodal ],
        ngm:ai-application ;
    skos:broader ngm:ai-application ;
    vc:enables ngm:autonomous-agent,
        ngm:workflow-automation ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:interface ;
    vc:requires ngm:multimodal,
        ngm:tool-use ;
    vc:slug "computer-use" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:computer-vision-domain a owl:Class ;
    rdfs:label "Computer Vision Domain"@en ;
    rdfs:comment "The Computer Vision Domain covers the extraction of structured information from images, video and other visual signals. Its scope includes image formation, feature detection, recognition, segmentation and three-dimensional scene understanding. It is an application sub-area of the Artificial Intelligence Domain and relies heavily on the methods of the Machine Learning Domain. The boundary excludes the generation of imagery for display purposes, which belongs to the Computer Graphics Domain."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:image-classification ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:optical-flow ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:image-segmentation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:signal-processing ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:linear-algebra ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:machine-learning-domain ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:object-detection ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:3-d-reconstruction ],
        ngm:artificial-intelligence-domain ;
    vc:enables ngm:augmented-reality,
        ngm:autonomous-navigation,
        ngm:visual-inspection ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:3-d-reconstruction,
        ngm:image-classification,
        ngm:image-segmentation,
        ngm:object-detection,
        ngm:optical-flow ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:linear-algebra,
        ngm:machine-learning-domain,
        ngm:signal-processing ;
    vc:slug "computer-vision-domain" ;
    vc:sourceDomain "computer-vision" .

ngm:confidential-transactions a owl:Class ;
    rdfs:label "Confidential Transactions"@en ;
    rdfs:comment "Confidential Transactions (CT) is a cryptographic protocol for distributed ledgers that conceals the amounts transferred in financial transactions whilst preserving the ability for validators to verify that no value is created or destroyed. It employs Pedersen commitments and range proofs—typically Bulletproofs—to encode transaction values in a form that is computationally hiding yet binding."@en ;
    rdfs:subClassOf ngm:blockchain-transaction ;
    vc:dependsOn ngm:cryptographic-algorithm ;
    vc:enables ngm:privacy-preserving-blockchain ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:confidential-computing ;
    vc:slug "confidential-transactions" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:encryption,
        ngm:zero-knowledge-proof .

ngm:conformity-assessment-body a owl:Class ;
    rdfs:label "Conformity Assessment Body"@en ;
    rdfs:comment "A conformity assessment body is an accredited organisation authorised to evaluate whether products, processes, or services meet specified standards or regulatory requirements. It performs testing, inspection, and certification activities and issues the formal attestations that allow goods to be placed on a market. Such bodies are themselves accredited by national accreditation authorities to ensure impartiality and competence."@en ;
    rdfs:subClassOf ngm:standards-body ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:robot-standard,
        ngm:trust-framework ;
    vc:slug "conformity-assessment-body" ;
    vc:sourceDomain "governance" .

ngm:connector-standards a owl:Class ;
    rdfs:label "Connector Standards"@en ;
    rdfs:comment "Connector standards are specifications that define the mechanical form factor, pin assignment, and electrical signalling of the physical interfaces used to join cables and devices. They guarantee interoperability across vendors at the physical layer, covering examples such as USB-C, RJ45, and HDMI. Standardised connectors reduce fragmentation and enable plug-and-play interconnection."@en ;
    rdfs:subClassOf ngm:technical-standard ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:physical-layer ;
    vc:slug "connector-standards" ;
    vc:sourceDomain "infrastructure" .

ngm:consent-registry a owl:Class ;
    rdfs:label "Consent Registry"@en ;
    rdfs:comment "A consent registry is a system of record that stores, versions, and serves the consent decisions data subjects have granted or withdrawn for processing their personal data. It provides an auditable, queryable source of truth that data controllers and processors consult before performing a processing activity. It is a central component of privacy-compliance and consent-management architectures."@en ;
    rdfs:subClassOf ngm:identity-management ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:consent-management,
        ngm:user-consent-token ;
    vc:slug "consent-registry" ;
    vc:sourceDomain "security" .

ngm:constraint-specification a owl:Class ;
    rdfs:label "Constraint Specification"@en ;
    rdfs:comment "A constraint specification is a formal statement of the limits and conditions a control system or plan must satisfy, such as joint limits, actuator bounds, obstacle avoidance, and safety envelopes. It is supplied to control and optimisation algorithms so that generated commands remain feasible and safe. Precise constraint specification is essential for model-based and optimisation-based control design."@en ;
    rdfs:subClassOf ngm:control-theory ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:control-algorithm,
        ngm:model-based-control ;
    vc:slug "constraint-specification" ;
    vc:sourceDomain "robotics" .

ngm:content-discovery a owl:Class ;
    rdfs:label "Content Discovery"@en ;
    rdfs:comment "Content Discovery encompasses the mechanisms, algorithms, and systems by which users or automated agents locate, surface, and retrieve relevant digital content from large-scale repositories or networks. It spans search-engine indexing, recommendation algorithms, semantic retrieval, and social curation, and is increasingly driven by machine learning models that personalise results to individual preference signals. Effective content discovery is foundational to user experience across the web, streaming platforms, knowledge graphs, and decentralised content networks. It sits at the intersection of information retrieval theory, personalisation engineering, and data governance."@en ;
    rdfs:subClassOf ngm:information-retrieval ;
    vc:enables ngm:digital-curation-platform,
        ngm:discovery-layer ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:algorithmic-bias,
        ngm:search-engine,
        ngm:semantic-search ;
    vc:slug "content-discovery" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:machine-learning,
        ngm:natural-language-processing,
        ngm:recommendation-systems .

ngm:content-provenance a owl:Class ;
    rdfs:label "Content Provenance"@en ;
    rdfs:comment "Content provenance is the recorded history of the origin, authorship, and edits of a piece of digital media, used to establish whether content is authentic or has been altered."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptography ],
        ngm:provenance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:cryptography ;
    vc:slug "content-provenance" ;
    vc:sourceDomain "digital-media" .

ngm:context-awareness-system a owl:Class ;
    rdfs:label "Context Awareness System"@en ;
    rdfs:comment "A technology framework that captures, processes, and interprets contextual information about users and their environments using IoT sensors, location tracking, and AI analytics to enable adaptive services, personalized experiences, and intelligent decision-making in virtual and physical spaces."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:io-t-sensors ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-analytics ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:network-infrastructure ],
        ngm:intelligent-systems,
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:enables ngm:adaptive-services,
        ngm:location-based-services,
        ngm:situational-awareness ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires ngm:data-analytics,
        ngm:io-t-sensors,
        ngm:network-infrastructure ;
    vc:slug "context-awareness-system" ;
    vc:sourceDomain "spatial-computing" .

ngm:contract-code a owl:Class ;
    rdfs:label "Contract Code"@en ;
    rdfs:comment "Contract code is the executable program logic that defines the rules, state, and behaviour of a smart contract deployed on a distributed ledger. It is typically written in a high-level language such as Solidity or Kotlin and compiled to bytecode that nodes execute deterministically. Because it is immutable once deployed and controls value, contract code is a primary target for auditing and formal verification."@en ;
    rdfs:subClassOf ngm:smart-contract ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:smart-contract ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:r3-corda ;
    vc:slug "contract-code" ;
    vc:sourceDomain "blockchain" .

ngm:control-framework a owl:Class ;
    rdfs:label "Control Framework"@en ;
    rdfs:comment "A control framework is a structured set of governance, risk, and compliance controls that an organisation adopts to manage risk and demonstrate conformance to regulatory or industry requirements. Examples include NIST CSF, COBIT, ISO 27001, and SOC 2, each mapping objectives to specific control activities and evidence. It provides a common reference for designing, operating, and auditing controls consistently."@en ;
    rdfs:subClassOf ngm:governance-framework ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:compliance-domain,
        ngm:regulatory-compliance-domain ;
    vc:slug "control-framework" ;
    vc:sourceDomain "governance" .

ngm:control-interface a owl:Class ;
    rdfs:label "Control Interface"@en ;
    rdfs:comment "A control interface is the defined boundary through which commands and feedback are exchanged between a controller and a controlled device such as an actuator, end-effector, or robot subsystem. It specifies the signals, protocols, data rates, and timing required for deterministic command of the hardware. A well-defined control interface is what allows higher-level planners and digital twins to actuate physical systems reliably."@en ;
    rdfs:subClassOf ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:digital-twin,
        ngm:end-effector ;
    vc:slug "control-interface" ;
    vc:sourceDomain "robotics" .

ngm:control-law a owl:Class ;
    rdfs:label "Control Law"@en ;
    rdfs:comment "A control law is the mathematical rule that maps measured system state and reference signals to the control inputs applied to a plant. It is the algorithmic core of a feedback controller, expressed as functions such as PID, state feedback, or impedance laws. The choice of control law determines stability, tracking accuracy, and disturbance rejection of the closed-loop system."@en ;
    rdfs:subClassOf ngm:control-theory ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:force-control,
        ngm:position-control ;
    vc:slug "control-law" ;
    vc:sourceDomain "robotics" .

ngm:control-signal a owl:Class ;
    rdfs:label "Control Signal"@en ;
    rdfs:comment "A control signal is the command output computed by a controller and applied to actuate or steer a system toward a desired state. In robotics and electromechanical contexts it is the voltage, current, or set-point delivered to an actuator; in generative pipelines it is the spatial conditioning input that guides synthesis. In both senses it is the carrier of intent between a decision process and the system it drives."@en ;
    rdfs:subClassOf ngm:control-system ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:control-net-and-similar-spatial-conditioning-systems,
        ngm:electric-actuator ;
    vc:slug "control-signal" ;
    vc:sourceDomain "robotics" .

ngm:control-theory-domain a owl:Class ;
    rdfs:label "Control Theory Domain"@en ;
    rdfs:comment "The Control Theory Domain covers the mathematical analysis and design of systems that regulate their own behaviour through feedback. Its scope includes feedback control, state estimation, stability analysis and optimal control. It is a sub-area of the Robotics Domain that governs how machines maintain desired states. The boundary excludes the high-level task planning of agents, which belongs to the Agentic Systems Domain."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:optimal-control ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:feedback-control ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:differential-equations ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:linear-algebra ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:dynamical-systems ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:stability-analysis ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:pid-controller ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:state-estimation ],
        ngm:robotics-domain ;
    vc:enables ngm:autonomous-stabilisation,
        ngm:motion-control,
        ngm:process-regulation ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:feedback-control,
        ngm:optimal-control,
        ngm:pid-controller,
        ngm:stability-analysis,
        ngm:state-estimation ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:differential-equations,
        ngm:dynamical-systems,
        ngm:linear-algebra ;
    vc:slug "control-theory-domain" ;
    vc:sourceDomain "control-theory" .

ngm:coordinate-frame a owl:Class ;
    rdfs:label "Coordinate Frame"@en ;
    rdfs:comment "A coordinate frame is a reference system defined by an origin and a set of axes against which positions, orientations, and motions are measured. In robotics and perception, multiple frames (world, base, sensor, tool) are related by rigid-body transforms so that data from different sources can be expressed consistently. Correct frame management is essential for sensor fusion, motion planning, and collision checking."@en ;
    rdfs:subClassOf ngm:robo-navigation-and-planning ;
    skos:broader ngm:robo-navigation-and-planning ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:collision-detection,
        ngm:exteroceptive-sensor ;
    vc:slug "coordinate-frame" ;
    vc:sourceDomain "robotics" .

ngm:cor-dapp a owl:Class ;
    rdfs:label "CorDapp"@en ;
    rdfs:comment "A CorDapp (Corda Distributed Application) is a distributed application built to run on the R3 Corda enterprise blockchain platform. It bundles the contracts, states, and flows that define shared business logic and the point-to-point messaging that coordinates transactions between participating nodes. CorDapps are the unit of deployment by which enterprises implement permissioned, privacy-preserving workflows on Corda."@en ;
    rdfs:subClassOf ngm:smart-contract ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:enterprise-smart-contracts,
        ngm:r3-corda ;
    vc:slug "cor-dapp" ;
    vc:sourceDomain "blockchain" .

ngm:correspondent-banking a owl:Class ;
    rdfs:label "Correspondent Banking"@en ;
    rdfs:comment "An arrangement in which one bank provides services, particularly cross-border payments and settlement, on behalf of another bank that lacks a direct presence in a given market or currency."@en ;
    rdfs:subClassOf ngm:cross-border-payments ;
    vc:enables ngm:cross-border-payments ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:slug "correspondent-banking" ;
    vc:sourceDomain "general" .

ngm:cosine-similarity a owl:Class ;
    rdfs:label "Cosine Similarity"@en ;
    rdfs:comment "Cosine Similarity is a metric that measures the cosine of the angle between two non-zero vectors in an inner product space, yielding a value in [−1, 1] that quantifies directional similarity independently of vector magnitude. It is the dominant similarity measure for comparing high-dimensional sparse and dense vector representations of text, images, and other data in information retrieval and machine learning systems."@en ;
    rdfs:subClassOf ngm:information-retrieval ;
    vc:enables ngm:semantic-search ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:cross-encoder-reranking,
        ngm:embedding-search ;
    vc:slug "cosine-similarity" ;
    vc:sourceDomain "ai" ;
    vc:supports ngm:vector-database ;
    vc:uses ngm:embedding .

ngm:creator-royalties a owl:Class ;
    rdfs:label "Creator Royalties"@en ;
    rdfs:comment "Creator royalties are payments made to the original creator of a digital asset, such as an NFT, on subsequent resales of that asset."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:smart-contract ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:nft ],
        ngm:nft ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:nft,
        ngm:smart-contract ;
    vc:slug "creator-royalties" ;
    vc:sourceDomain "blockchain" .

ngm:credential-storage a owl:Class ;
    rdfs:label "Credential Storage"@en ;
    rdfs:comment "Credential storage is the secure persistence of authentication secrets and verifiable credentials—such as passwords, keys, tokens, and signed attestations—so they can be protected at rest and retrieved for verification. It employs encryption, hardware-backed enclaves, and access controls to resist theft and tampering. It is a required capability of any digital identity management system."@en ;
    rdfs:subClassOf ngm:infra-security-and-identity ;
    skos:broader ngm:infra-security-and-identity ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:digital-identity,
        ngm:digital-identity-management ;
    vc:slug "credential-storage" ;
    vc:sourceDomain "security" .

ngm:credential-store a owl:Class ;
    rdfs:label "Credential Store"@en ;
    rdfs:comment "A credential store is the component within an identity system that holds user identifiers, secrets, and account attributes used during authentication. Implemented as a directory, database, or secrets vault, it is queried by an identity provider to validate sign-in attempts and issue tokens. Its integrity and confidentiality are critical to the security of the surrounding identity infrastructure."@en ;
    rdfs:subClassOf ngm:infra-security-and-identity ;
    skos:broader ngm:infra-security-and-identity ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:authentication,
        ngm:identity-provider ;
    vc:slug "credential-store" ;
    vc:sourceDomain "security" .

ngm:crm-integration a owl:Class ;
    rdfs:label "CRM Integration"@en ;
    rdfs:comment "CRM integration is the connection of customer-relationship-management software with other business systems—such as telephony, email, marketing, and AI assistants—so that customer data and interactions flow automatically across tools. It typically uses APIs, webhooks, and event syncs to keep contact records, activity logs, and pipelines consistent. It is essential for unified customer views and automated sales and support workflows."@en ;
    rdfs:subClassOf ngm:system-architecture ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:call-centres,
        ngm:crm ;
    vc:slug "crm-integration" ;
    vc:sourceDomain "infrastructure" .

ngm:cross-entropy-loss a owl:Class ;
    rdfs:label "Cross-Entropy Loss"@en ;
    rdfs:comment "Cross-entropy loss is a differentiable scalar objective function that measures the dissimilarity between a model's predicted probability distribution and the true label distribution, computed as the negative log-likelihood of the correct class under the model's output. It is the canonical training objective for classification tasks and language modelling, directly optimising the model to assign maximum probability mass to correct outputs. Minimising cross-entropy is equivalent to maximising the likelihood of the training data under the model's parameterised distribution."@en ;
    rdfs:subClassOf ngm:loss-function ;
    vc:enables ngm:language-modeling,
        ngm:model-training,
        ngm:supervised-learning ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:large-language-models,
        ngm:transformer ;
    vc:slug "cross-entropy-loss" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:backpropagation,
        ngm:gradient-descent .

ngm:cross-platform-authentication a owl:Class ;
    rdfs:label "Cross-Platform Authentication"@en ;
    rdfs:comment "Cross-platform authentication is the verification of a user's identity in a way that is valid across multiple platforms, devices, or virtual worlds without re-registration. It uses federated identity, single sign-on, and portable credentials so that one verified identity unlocks access everywhere. It is a foundational requirement for interoperable avatars and multiverse experiences."@en ;
    rdfs:subClassOf ngm:authentication ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:avatar-interoperability,
        ngm:multiverse ;
    vc:slug "cross-platform-authentication" ;
    vc:sourceDomain "security" .

ngm:crypto-wallet a owl:Class ;
    rdfs:label "Crypto Wallet"@en ;
    rdfs:comment "A crypto wallet is software or hardware that manages the private keys controlling blockchain assets and enables users to sign transactions, hold tokens, and interact with decentralised applications. Wallets may be custodial or non-custodial, hot or cold, and increasingly serve as the identity and access layer for Web3. They do not store assets themselves but the cryptographic keys that authorise control over on-chain balances."@en ;
    rdfs:subClassOf ngm:bc-network-component ;
    skos:broader ngm:bc-network-component ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:web-3-domain,
        ngm:web3 ;
    vc:slug "crypto-wallet" ;
    vc:sourceDomain "blockchain" .

ngm:cryptographic-accumulator a owl:Class ;
    rdfs:label "Cryptographic Accumulator"@en ;
    rdfs:comment "A cryptographic accumulator is a primitive that compresses a large set of elements into a single short value while still permitting compact proofs that a given element is (or is not) a member of the set. Constructions based on RSA groups, bilinear pairings, or Merkle trees allow membership witnesses whose size is independent of the set's cardinality, and dynamic accumulators support efficient addition and removal of elements. Accumulators underpin scalable membership proofs in anonymous credentials, certificate revocation, and stateless blockchain clients."@en ;
    rdfs:subClassOf ngm:cryptographic-primitive ;
    vc:enables ngm:zero-knowledge-proof ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:digital-signature,
        ngm:merkle-tree ;
    vc:slug "cryptographic-accumulator" ;
    vc:sourceDomain "security" ;
    vc:uses ngm:hash-function .

ngm:cryptography-domain a owl:Class ;
    rdfs:label "Cryptography Domain"@en ;
    rdfs:comment "The Cryptography Domain classifies concepts concerned with the mathematical and computational techniques that secure information and authenticate parties. It covers primitives (encryption, hashing, signatures), protocols built from those primitives, and the assumptions that underpin their security. As a subject classification under the Cryptographic Domain, it scopes the theory and algorithms rather than the wider security operations or governance that consume them."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:public-key-cryptography ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:hash-function ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:random-number-generation ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:symmetric-encryption ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:digital-signature ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptographic-primitive ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:zero-knowledge-proof ],
        ngm:cryptographic-domain ;
    vc:enables ngm:authentication,
        ngm:data-confidentiality,
        ngm:verifiable-computation ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:digital-signature,
        ngm:hash-function,
        ngm:public-key-cryptography,
        ngm:symmetric-encryption,
        ngm:zero-knowledge-proof ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:cryptographic-primitive,
        ngm:random-number-generation ;
    vc:slug "cryptography-domain" ;
    vc:sourceDomain "cryptography" .

ngm:current-sensor a owl:Class ;
    rdfs:label "Current Sensor"@en ;
    rdfs:comment "Current Sensor - An electrical measurement device (Hall effect, fluxgate, or shunt-based) that detects current flow in motor circuits and power systems, enabling Motor Torque Estimation, Fault Detection, and Energy Monitoring in autonomous robots."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:signal-conditioning ],
        ngm:robo-perception,
        ngm:sensor ;
    skos:broader ngm:robo-perception ;
    vc:enables ngm:efficiency-monitoring,
        ngm:overload-protection,
        ngm:predictive-maintenance ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:isPartOf ngm:motor-control-system,
        ngm:power-management ;
    vc:qualityScore "0.52"^^xsd:float ;
    vc:requires ngm:analogue-to-digital-conversion,
        ngm:signal-conditioning ;
    vc:slug "current-sensor" ;
    vc:sourceDomain "robotics" .

ngm:customer-support a owl:Class ;
    rdfs:label "Customer Support"@en ;
    rdfs:comment "Customer Support is the organisational function and set of processes by which a company provides assistance, guidance, and resolution of problems to its customers before, during, and after the purchase or use of a product or service. It encompasses multiple channels—telephone, email, live chat, self-service portals, and increasingly AI-powered interfaces—and spans activities from answering product questions and processing returns to resolving technical failures and managing complaints. Modern customer support operations integrate customer relationship management systems, knowledge bases, ticketing workflows, and sentiment analytics to optimise resolution efficiency and customer satisfaction."@en ;
    rdfs:subClassOf ngm:customer-service-automation ;
    vc:enables ngm:question-answering,
        ngm:workflow-automation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:conversational-ai,
        ngm:natural-language-processing,
        ngm:sentiment-analysis ;
    vc:slug "customer-support" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:chatbots,
        ngm:dialogue-system,
        ngm:information-retrieval .

ngm:customer-support-automation a owl:Class ;
    rdfs:label "Customer Support Automation"@en ;
    rdfs:comment "Customer support automation is the use of software, including chatbots and virtual agents, to handle customer enquiries with reduced human intervention. It aims to resolve common requests quickly and at scale."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:dialogue-systems ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:chatbot ],
        ngm:conversational-ai ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:chatbot,
        ngm:dialogue-systems ;
    vc:slug "customer-support-automation" ;
    vc:sourceDomain "nlp" .

ngm:cybernetics a owl:Class ;
    rdfs:label "Cybernetics"@en ;
    rdfs:comment "Cybernetics is the transdisciplinary science of regulatory systems, feedback mechanisms, and goal-directed behaviour in animals, machines, and organisations, founded by Norbert Wiener in 1948 to provide a unified framework for understanding how systems use information to maintain stability and achieve purposes across biological, mechanical, and social domains. It centres on the study of circular causal processes — feedback loops — through which a system compares its actual state against a desired state and acts to reduce the discrepancy, extending naturally to concepts of information, communication, control, and self-organisation. Second-order cybernetics extends this to include the observer as a participant in the system being observed, influencing systems theory, cognitive science, constructivism, and AI."@en ;
    rdfs:subClassOf ngm:control-theory ;
    vc:enables ngm:adaptive-control,
        ngm:brain-computer-interfaces,
        ngm:human-robot-interaction ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:cognitive-science,
        ngm:emergence ;
    vc:slug "cybernetics" ;
    vc:sourceDomain "science" ;
    vc:uses ngm:feedback-control,
        ngm:feedback-loop,
        ngm:signal-processing .

ngm:dao-legal-structures a owl:Class ;
    rdfs:label "DAO Legal Structures"@en ;
    rdfs:comment "DAO Legal Structures are the corpus of statutory wrappers, jurisdictional incorporation regimes, and bespoke entity forms — spanning US state limited-liability companies, US state unincorporated nonprofit associations, offshore foundation companies, Swiss associations and foundations, Liechtenste..."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
