    vc:slug "u-net" ;
    vc:sourceDomain "computer-vision" .

ngm:uk-ai-opportunities-action-plan a owl:Class ;
    rdfs:label "UK AI Opportunities Action Plan"@en ;
    rdfs:comment "The UK AI Opportunities Action Plan is a 2025 UK Government strategy setting out recommendations to accelerate national adoption of artificial intelligence across the public and private sectors. It covers building sovereign compute and data infrastructure, expanding AI skills, establishing AI Growth Zones, and embedding AI in public services to drive productivity and economic growth."@en ;
    rdfs:subClassOf ngm:ai-governance-framework ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:adoption-of-convergent-technologies,
        ngm:ai-adoption ;
    vc:slug "uk-ai-opportunities-action-plan" ;
    vc:sourceDomain "governance" .

ngm:uk-data-protection-act-2018 a owl:Class ;
    rdfs:label "UK Data Protection Act 2018"@en ;
    rdfs:comment "The UK Data Protection Act 2018 is the primary UK legislation governing the processing of personal data, implementing and supplementing the UK GDPR and providing the legal framework for data subjects' rights and controllers' obligations. It sets lawful bases for processing, principles such as data minimisation and purpose limitation, and is enforced by the Information Commissioner's Office."@en ;
    rdfs:subClassOf ngm:regulatory-compliance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:digital-society-surveillance,
        ngm:meeting-ai-assistant ;
    vc:slug "uk-data-protection-act-2018" ;
    vc:sourceDomain "governance" .

ngm:uk-diatf a owl:Class ;
    rdfs:label "UK DIATF"@en ;
    rdfs:comment "The UK Digital Identity and Attributes Trust Framework (DIATF) is a government-published set of rules and standards that digital-identity providers must meet to be certified as trustworthy. It defines requirements for security, privacy, fraud management, and inclusion so that certified identity and attribute services can be relied upon across public and private sectors."@en ;
    rdfs:subClassOf ngm:digital-identity ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:digital-identity-wallet,
        ngm:identity-verification ;
    vc:slug "uk-diatf" ;
    vc:sourceDomain "security" .

ngm:uk-mlr-2017 a owl:Class ;
    rdfs:label "UK MLR 2017"@en ;
    rdfs:comment "The UK Money Laundering Regulations 2017 (MLR 2017) are the principal UK regulations transposing anti-money-laundering and counter-terrorist-financing requirements onto regulated firms, including financial institutions and crypto-asset businesses. They mandate customer due diligence, risk assessment, record-keeping, and reporting obligations, and bring virtual-asset service providers under supervision by the FCA."@en ;
    rdfs:subClassOf ngm:financial-regulation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:aml-kyc-compliance ;
    vc:slug "uk-mlr-2017" ;
    vc:sourceDomain "blockchain" .

ngm:ultrasonic-sensor a owl:Class ;
    rdfs:label "Ultrasonic Sensor"@en ;
