# Nostr Protocol
blockchain:NostrProtocol rdf:type owl:Class ;
    rdfs:subClassOf blockchain:DecentralisedCommunicationProtocol ;
    rdfs:subClassOf blockchain:CryptographicIdentitySystem ;
    rdfs:label "Nostr Protocol"@en ;
    rdfs:comment "Nostr (Notes and Other Stuff Transmitted by Relays) is a minimalist open protocol for censorship-resistant, decentralised messaging and identity, in which clients sign events with Schnorr Signatures over the secp256k1 elliptic curve and broadcast them to any number of stateless relay servers, so that no single entity can deplatform a user without their private key being lost; the protocol's NIP (Nostr Implementation Possibility) architecture allows feature extension whilst preserving a small, auditable core that integrates natively with Bitcoin Lightning Network payments and serves as a decentralised identity and communication layer for VisionClaw Agentic Container agent-to-agent messaging and DID Nostr Identity resolution."@en ;
    skos:prefLabel "Nostr Protocol"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:blockchain:nostr-protocol" ;
    owl:sameAs <urn:visionclaw:concept:blockchain:nostr-protocol> ;
    vcw:contentHash "sha256-12-7d3e9f2a1b8c" ;
    vcw:qualityScore "0.7"^^xsd:decimal ;
    vcw:legacyTermId "BC-nostr-protocol" ;
    vcw:ontologyStatus "complete" ;
    vcw:maturityLevel "established" ;
    vcw:authorityScore "0.8"^^xsd:decimal ;
    dcterms:identifier "BC-nostr-protocol" ;
    dcterms:subject "blockchain" ;
    owl:versionInfo "1.0.0" ;
    dcterms:created "2026-04-26T00:00:00Z"^^xsd:dateTime ;
    dcterms:modified "2026-04-26T00:00:00Z"^^xsd:dateTime ;
    vcw:owlRole "Process" .

