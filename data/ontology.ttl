ngm:blockchain-core a owl:Class ;
    rdfs:label "Blockchain Core"@en ;
    rdfs:comment "Blockchain core denotes the foundational base-layer components of a blockchain system: the consensus protocol, the append-only ledger data structure, the peer-to-peer network, and the validation rules that together produce a shared, tamper-resistant state. It is the substrate on which higher-level constructs such as tokens, wallets, and smart contracts are built. As the trust anchor of a chain, its design dictates the network's security, decentralisation, and throughput."@en ;
    rdfs:subClassOf ngm:blockchain ;
    skos:broader ngm:blockchain ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
