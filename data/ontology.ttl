ngm:hardware-component a owl:Class ;
    rdfs:label "Hardware Component"@en ;
    rdfs:comment "A Hardware Component is a discrete physical element—such as a processor, display panel, sensor, or communication module—that forms part of a spatial-computing or XR system. These components collectively determine the perceptual fidelity, latency, power budget, and interaction modalities of devices ranging from head-mounted displays to robotic end-effectors and IoT edge nodes."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:sensor ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:gpu-compute ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:display-hardware ],
        ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:enables ngm:haptic-feedback,
        ngm:spatial-computing ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:display-hardware,
        ngm:gpu-compute,
        ngm:sensor ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:slug "hardware-component" ;
    vc:sourceDomain "spatial-computing" .

ngm:humanoid-robot a owl:Class ;
    rdfs:label "Humanoid Robot"@en ;
    rdfs:comment "A humanoid robot is an autonomous or semi-autonomous mechanical system whose overall morphology, kinematic chain, and sensorimotor organisation deliberately mirrors the human body plan: a vertical torso supported on two bipedal legs, bilateral upper limbs terminating in multi-fingered end-effecto..."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:whole-body-control ],
        [ a owl:Restriction ;
