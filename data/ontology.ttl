ngm:blockchain-scalability a owl:Class ;
    rdfs:label "Blockchain Scalability"@en ;
    rdfs:comment "Blockchain Scalability encompasses the technical solutions and architectural approaches designed to increase the transaction throughput, reduce latency, and improve the efficiency of blockchain networks while maintaining security and decentralisation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
