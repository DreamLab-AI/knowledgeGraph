    vc:slug "npc-interaction" ;
    vc:sourceDomain "spatial-computing" .

ngm:numpy a owl:Class ;
    rdfs:label "Numpy"@en ;
    rdfs:comment "NumPy (Numerical Python) is the foundational library for numerical and scientific computing in Python, providing the N-dimensional array (ndarray) object together with a comprehensive suite of vectorised mathematical, logical, linear algebra, Fourier transform, and random number operations. Its contiguous, typed memory layout and broadcasting semantics enable concise, high-performance array programming by delegating element-wise loops to compiled C and Fortran routines. NumPy underpins almost the entire Python data and machine learning ecosystem, serving as the in-memory array substrate that libraries such as pandas, SciPy, scikit-learn, and the deep learning frameworks build upon or interoperate with."@en ;
    rdfs:subClassOf ngm:scientific-computing ;
    vc:bridgesTo ngm:data-science,
        ngm:deep-learning ;
    vc:contrastsWith ngm:cupy,
        ngm:py-torch ;
    vc:enables ngm:matplotlib,
        ngm:pandas,
        ngm:scikit-learn,
        ngm:scipy ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:broadcasting,
        ngm:ndarray,
        ngm:vectorisation ;
    vc:isPartOf ngm:python-ecosystem,
        ngm:scientific-computing ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:open-cv,
        ngm:python ;
    vc:slug "numpy" ;
    vc:sourceDomain "machine-learning" ;
    vc:supports ngm:linear-algebra,
        ngm:tensor ;
    vc:uses ngm:blas,
        ngm:lapack,
