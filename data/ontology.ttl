        ngm:gradescope,
        ngm:khanmigo,
        ngm:magic-school,
        ngm:squirrel-ai,
        ngm:synthesis-tutor,
        ngm:tassomai,
        ngm:turnitin-ai-detection ;
    vc:uses ngm:khan-academy,
        ngm:microsoft-immersive-reader,
        ngm:perplexity,
        ngmi:claude,
        ngmi:gemini,
        ngmi:gpt-4 .

ngm:education-technology a owl:Class ;
    rdfs:label "Education Technology"@en ;
    rdfs:comment "Education Technology (EdTech) is the application of digital tools, AI-driven systems, and immersive platforms to enhance teaching, personalise learning pathways, and streamline educational administration. Modern EdTech leverages adaptive learning algorithms that adjust content difficulty and pacing to individual learner performance, natural language processing for automated essay scoring and tutoring dialogue, and XR environments that create immersive simulations for fields such as medicine, engineering, and history. It spans formal K-12 and higher education, professional development, and informal self-directed learning."@en ;
    rdfs:subClassOf ngm:ai-application ;
    skos:broader ngm:ai-application ;
    vc:enables ngm:augmented-reality,
        ngm:virtual-reality ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:natural-language-processing ;
    vc:slug "education-technology" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:immersive-learning,
        ngm:learning-management-system .

ngm:embedded-ai-frameworks a owl:Class ;
    rdfs:label "Embedded AI Frameworks"@en ;
    rdfs:comment "Software infrastructure and tooling optimised for deploying and running machine learning models on resource-constrained embedded systems and edge devices, with footprints of 100 KB to 10 MB, supporting INT8/FP16 quantisation, NPU/FPGA/DSP hardware acceleration abstraction, and streamlined memory allocation to avoid heap fragmentation on microcontrollers."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:model-compression-for-edge ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:edge-ai-accelerator ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:tiny-ml ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:model-pruning-for-edge-deployment ],
        ngm:ai-infrastructure ;
    vc:enables ngm:autonomous-robot,
        ngm:edge-ai-system,
        ngm:latency-aware-edge-ai,
        ngm:real-time-inference-at-edge ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:edge-ai-accelerator,
        ngm:model-compression-for-edge,
        ngm:model-pruning-for-edge-deployment,
        ngm:tiny-ml ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:edge-computing,
        ngm:io-t-ai-integration ;
    vc:slug "embedded-ai-frameworks" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:embedded-systems,
        ngm:fpga,
        ngm:hardware-acceleration,
        ngm:inference .

ngm:embeddings a owl:Class ;
    rdfs:label "Embeddings"@en ;
    rdfs:comment "Embeddings are dense, low-dimensional vector representations of discrete objects—words, sentences, images, code, graphs, or arbitrary entities—learned by neural networks such that geometric relationships in the vector space correspond to semantic or functional relationships between the original objects. The core property is that semantically similar inputs map to nearby vectors, enabling tasks like similarity search, clustering, and retrieval to be performed as efficient geometric operations. Embeddings are the foundational representation layer of modern deep learning, underpinning language models, recommendation systems, search engines, and retrieval-augmented generation pipelines."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:token-embedding ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:embedding-model ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:soft-prompt-embedding ],
        ngm:machine-learning-technique ;
    vc:enables ngm:retrieval-augmented-generation,
        ngm:semantic-search,
        ngm:vector-database ;
    vc:hasMaturity ngmi:maturity-established ;
