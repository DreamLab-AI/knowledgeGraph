ngm:optimal-control a owl:Class ;
    rdfs:label "Optimal Control"@en ;
    rdfs:comment "A control strategy that determines control inputs to minimize or maximize a performance criterion (cost function) while satisfying system dynamics and constraints. It seeks the best possible control policy according to specified objectives, using mathematical frameworks such as dynamic programming, the Hamilton-Jacobi-Bellman equation, and Pontryagin's Maximum Principle."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:optimization-algorithm ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cost-function ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:state-space-representation ],
        ngm:closed-loop-control ;
    vc:bridgesTo ngm:machine-learning,
        ngm:reinforcement-learning ;
    vc:contrastsWith ngm:pid-controller ;
    vc:dependsOn ngm:control-theory,
        ngm:optimization-theory ;
    vc:enables ngm:autonomous-vehicle-control,
        ngm:motion-planning,
        ngm:trajectory-generation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.68"^^xsd:float ;
    vc:relatedTo ngm:numerical-optimization,
        ngm:robust-control ;
    vc:requires ngm:cost-function,
        ngm:optimization-algorithm,
        ngm:state-space-representation ;
    vc:slug "optimal-control" ;
    vc:sourceDomain "robotics" ;
    vc:supports ngm:adaptive-control ;
    vc:uses ngm:dynamic-programming,
        ngm:linear-quadratic-regulator,
        ngm:model-predictive-control .

ngm:paris-agreement a owl:Class ;
    rdfs:label "Paris Agreement"@en ;
    rdfs:comment "The Paris Agreement is a legally binding international treaty on climate change, adopted under the United Nations Framework Convention on Climate Change (UNFCCC) at COP21 in December 2015 and entering into force in November 2016. It establishes a long-term global temperature goal, requiring parties to limit the increase in global average temperature to well below 2 degrees Celsius above pre-industrial levels while pursuing efforts to limit warming to 1.5 degrees Celsius. Each signatory submits Nationally Determined Contributions (NDCs) — self-defined emissions-reduction pledges — subject to a five-year review and ratchet mechanism designed to progressively strengthen ambition. The treaty also creates a transparency framework for monitoring, reporting, and verification, and provisions for climate finance, technology transfer, and capacity building to support developing nations."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:carbon-accounting ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:climate-finance ],
        ngm:infra-legal-and-regulatory ;
    skos:broader ngm:infra-legal-and-regulatory ;
    vc:bridgesTo ngm:esg-reporting,
        ngm:supply-chain-decarbonisation ;
    vc:contrastsWith ngm:kyoto-protocol ;
    vc:enables ngm:carbon-credits,
        ngm:carbon-offsetting,
        ngm:net-zero-targets,
        ngm:voluntary-carbon-market ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:nationally-determined-contribution ;
    vc:implements ngm:climate-governance,
        ngm:sustainability ;
    vc:isPartOf ngm:unfccc ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:ipcc,
        ngm:just-transition,
        ngm:sustainable-development-goals ;
    vc:requires ngm:carbon-accounting,
        ngm:climate-finance ;
    vc:slug "paris-agreement" ;
    vc:sourceDomain "governance" ;
    vc:standardizedBy ngm:conference-of-parties,
        ngm:unfccc .

ngm:policy-engine a owl:Class ;
    rdfs:label "Policy Engine"@en ;
    rdfs:comment "A Policy Engine is an automated software component that evaluates, enforces, and logs governance, access-control, and behavioural rules within a metaverse or spatial computing system. It interprets declarative policy specifications (e.g., XACML, OPA Rego, or bespoke ontology-derived rules) and applies them at runtime to user actions, asset transactions, and inter-platform communications, enabling consistent compliance across distributed, multi-stakeholder virtual environments."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:identity-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:authentication ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:technical-standards ],
        ngm:sc-governance-and-safety ;
    skos:broader ngm:sc-governance-and-safety ;
    vc:bridgesTo ngm:decentralised-autonomous-organisation,
        ngm:smart-contract ;
    vc:enables ngm:data-sovereignty,
