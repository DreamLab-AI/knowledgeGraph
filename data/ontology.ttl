ngm:pathfinding a owl:Class ;
    rdfs:label "Pathfinding"@en ;
    rdfs:comment "Pathfinding is the computation of a route between two points in a graph or space, often the shortest or lowest-cost route. It is widely used in games, robotics, and navigation."@en ;
