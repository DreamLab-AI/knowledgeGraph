ngm:placing-on-the-market a owl:Class ;
    rdfs:label "Placing on the Market"@en ;
    rdfs:comment "The first making available of an AI system or general-purpose AI model on the EU Union market, as defined in EU AI Act Article 3(12). This act triggers the full set of provider obligations under the Act, including risk management, technical documentation, conformity assessment, CE marking, and post-market monitoring, and applies regardless of whether the system is offered for payment or free of charge."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:compliance-framework ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:risk-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:conformity-assessment ],
        ngm:sc-governance-and-safety ;
    skos:broader ngm:sc-governance-and-safety ;
    vc:enables ngm:deployer,
        ngm:market-surveillance-authority ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:high-risk-ai-system,
        ngm:importer,
        ngm:provider ;
    vc:requires ngm:compliance-framework,
        ngm:conformity-assessment,
        ngm:risk-management ;
    vc:slug "placing-on-the-market" ;
    vc:sourceDomain "spatial-computing" .

