        ngm:sensor-fusion ;
    vc:slug "temperature-sensor" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:sensor-technology .

ngm:templates a owl:Class ;
    rdfs:label "Templates"@en ;
    rdfs:comment "Templates are reusable structural scaffolds in software engineering and knowledge management that define a fixed format or pattern into which variable content is inserted. They reduce repetition, enforce consistency, and accelerate authoring across code generation, documentation, and prompt engineering workflows."@en ;
    rdfs:subClassOf ngm:infra-software-engineering ;
    skos:broader ngm:infra-software-engineering ;
    vc:enables ngm:code-generation,
        ngm:documentation-generation ;
    vc:hasMaturity ngmi:maturity-emerging ;
