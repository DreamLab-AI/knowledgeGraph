    vc:slug "eye-tracking" ;
    vc:sourceDomain "spatial-computing" .

ngm:formal-verification a owl:Class ;
    rdfs:label "Formal Verification"@en ;
    rdfs:comment "Formal verification is the use of mathematical proof techniques — including model checking, theorem proving, and abstract interpretation — to rigorously establish that a system, algorithm, or smart contract satisfies a specified set of correctness or safety properties under all possible inputs and executions. In software and hardware, formal verification provides guarantees beyond testing by exhaustively exploring the state space or constructing machine-checkable proofs. In the context of AI governance and smart contracts, formal verification is increasingly applied to verify safety invariants, access controls, and protocol correctness in blockchain systems and, experimentally, in neural network components."@en ;
    rdfs:subClassOf ngm:ai-governance-and-ethics ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:enables ngm:transparency ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:ai-risk-management,
        ngm:audit-trail,
        ngm:interpretability ;
    vc:slug "formal-verification" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:ai-safety,
        ngm:smart-contract .

ngm:homomorphic-encryption a owl:Class ;
    rdfs:label "Homomorphic Encryption"@en ;
    rdfs:comment "Homomorphic encryption is a cryptographic scheme that allows arithmetic and logical operations to be performed directly on ciphertext, producing an encrypted result that decrypts to the same value as if the operations had been applied to the plaintext. Fully homomorphic encryption (FHE) supports arbitrary computation over encrypted data, enabling cloud services to process sensitive inputs without ever decrypting them. It sits at the intersection of cryptography and privacy-preserving technology, with practical schemes including BGV, BFV, CKKS, and TFHE."@en ;
    rdfs:subClassOf ngm:cryptography,
        ngm:infra-security-and-identity ;
    skos:broader ngm:infra-security-and-identity ;
    vc:contrastsWith ngm:differential-privacy ;
    vc:enables ngm:federated-learning,
        ngm:privacy-preserving-technology ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:homomorphic-encryption-for-machine-learning,
        ngm:zero-knowledge-proof ;
    vc:slug "homomorphic-encryption" ;
    vc:sourceDomain "infrastructure" .

