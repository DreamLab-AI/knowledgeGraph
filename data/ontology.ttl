ngm:compliance-systems a owl:Class ;
    rdfs:comment "Compliance systems are the integrated software and process frameworks organisations use to enforce, monitor, and report adherence to laws, regulations, and internal policies. They encompass policy management, control automation, monitoring and alerting, audit-trail capture, and regulatory reporting workflows. They matter because they operationalise obligations such as content-moderation duties under the Digital Services Act or custody and reporting rules for digital assets, turning legal requirements into continuously enforced controls."@en ;
    rdfs:label "Compliance Systems"@en ;
    rdfs:subClassOf ngm:regulatory-compliance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:digital-asset-management ;
    vc:relatedTo ngm:digital-services-act ;
    vc:slug "compliance-systems" ;
    vc:sourceDomain "governance" .
ngm:compliance-testing a owl:Class ;
    rdfs:comment "Compliance testing is the systematic verification that a product, system, or process conforms to a defined standard, specification, or regulatory requirement. It produces objective, repeatable measurements that are compared against documented acceptance criteria to determine pass or fail status. It is a core component of validation and certification workflows, providing the evidentiary basis for conformity claims."@en ;
    rdfs:label "Compliance Testing"@en ;
    rdfs:subClassOf ngm:regulatory-compliance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:display-metrology ;
    vc:relatedTo ngm:validation-process ;
    vc:slug "compliance-testing" ;
    vc:sourceDomain "governance" .
ngm:compliance-validation-engine a skos:Concept ;
    rdfs:label "Compliance Validation Engine"@en .
ngm:compliance-verification a owl:Class ;
    rdfs:comment "Compliance verification in blockchain contexts encompasses the automated and manual processes for ensuring that cryptoasset transactions, service providers, and participants adhere to regulatory requirements including Know Your Customer (KYC), Anti-Money Laundering (AML), sanctions screening, and transaction monitoring obligations. Blockchain-based compliance systems leverage immutable ledgers, smart contracts, and AI-driven analytics to maintain tamper-proof records and detect suspicious activities in real-time."@en ;
    rdfs:label "Compliance Verification"@en ;
    rdfs:subClassOf ngm:compliance-monitoring ;
