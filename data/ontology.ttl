    rdfs:label "Fault Tolerant Computing"@en .
ngm:fault-tolerant-control a owl:Class ;
    rdfs:comment "Fault-tolerant control is a control-system design approach that maintains acceptable performance, or degrades gracefully, in the presence of sensor, actuator or component failures. It combines fault detection and isolation with reconfiguration mechanisms, such as switching to redundant actuators or re-tuning controller gains, so that a system continues operating safely rather than failing outright. It is widely applied in autonomous robots, aircraft and industrial process control where uninterrupted operation is safety-critical."@en ;
    rdfs:label "Fault-Tolerant Control"@en ;
    rdfs:subClassOf ngm:control-algorithm ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.55"^^xsd:float ;
    vc:slug "fault-tolerant-control" ;
    vc:sourceDomain "robotics" .
ngm:fault-tolerant-protocol a skos:Concept ;
    rdfs:label "Fault Tolerant Protocol"@en .
ngm:fault-tree-analysis a owl:Class ;
    rdfs:comment "Fault Tree Analysis (FTA) is a top-down, deductive reliability and safety method that models how combinations of component failures and events can lead to a defined undesired top-level event. Using Boolean logic gates to connect basic events, it identifies minimal cut sets — the smallest combinations of failures sufficient to cause the top event — and can be evaluated qualitatively or quantitatively with probabilities. Originating in aerospace and nuclear engineering, FTA is a cornerstone of system safety, risk assessment, and certification across safety-critical industries."@en ;
    rdfs:label "Fault Tree Analysis"@en ;
    rdfs:subClassOf ngm:risk-assessment ;
