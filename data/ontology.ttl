        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:collision-detection-system ],
        ngm:industrial-robot ;
    vc:bridgesTo ngm:artificial-intelligence,
        ngm:digital-twin,
        ngm:telecollaboration ;
    vc:contrastsWith ngm:autonomous-mobile-robots,
        ngm:industrial-robot ;
    vc:enables ngm:human-robot-collaboration ;
    vc:hasMaturity ngmi:maturity-draft ;
