ngm:gltf-standard a owl:Class ;
    rdfs:label "Gltf Standard"@en ;
    rdfs:comment "Graphics Library Transmission Format (glTF) is a royalty-free, open interoperable 3D asset format developed by Khronos Group, designed for efficient runtime transmission and loading of 3D scenes across native and web-based engines, serving as a foundational standard for metaverse asset interoperability. Standardised as ISO/IEC 12113:2022, glTF 2.0 supports geometry, PBR materials, skeletal animation, morph targets, and a modular extension system enabling progressive capability extension."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:json-data-interchange-format-serialisation ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:skeletal-animation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:web-gl ],
        ngm:sc-standards-and-interop ;
    skos:broader ngm:sc-standards-and-interop ;
    vc:bridgesTo ngm:3-d-asset-standard,
        ngm:gaussian-splatting,
        ngm:neural-radiance-fields ;
    vc:contrastsWith ngm:fbx,
        ngm:obj-format,
        ngm:universal-scene-description ;
    vc:dependsOn ngm:open-standard,
        ngm:royalty-free-licensing ;
    vc:enables ngm:cross-platform-content,
        ngm:digital-twin,
        ngm:real-time-rendering ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:pbr-materials,
        ngm:skeletal-animation ;
    vc:implements ngm:3-d-asset-standard ;
    vc:isPartOf ngm:metaverse-standards-forum ;
    vc:qualityScore "0.72"^^xsd:float ;
