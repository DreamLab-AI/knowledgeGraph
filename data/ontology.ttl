    vc:relatedTo ngm:certificate-authority ;
    vc:relatedTo ngm:credential-definition ;
    vc:slug "revocation-mechanism" ;
    vc:sourceDomain "security" ;
    vc:uses ngm:bitstring-status-list ;
    vc:uses ngm:cryptographic-accumulator ;
    vc:uses ngm:verifiable-credentials .
ngm:revocation-registry a owl:Class ;
    rdfs:comment "A revocation registry is a data structure or service that maintains the validity status of issued verifiable credentials or digital certificates, allowing verifiers to check whether a credential has been revoked by its issuer before accepting a presentation. In traditional PKI systems this role is fulfilled by Certificate Revocation Lists (CRLs) and OCSP responders; in self-sovereign identity ecosystems, revocation registries are implemented as privacy-preserving mechanisms including W3C Status List 2021 (bitstring-based), Hyperledger AnonCreds revocation with cryptographic accumulators, and on-chain smart contract registries. A well-designed revocation registry balances timely status updates, verifier privacy (preventing issuers from tracking when credentials are checked), and scalability to large credential populations."@en ;
    rdfs:label "Revocation Registry"@en ;
    rdfs:subClassOf ngm:credential-verification ;
    rdfs:subClassOf _:r18213 ;
    rdfs:subClassOf _:r18214 ;
