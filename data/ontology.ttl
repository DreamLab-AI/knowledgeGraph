        ngm:learning-management-system ;
    vc:requires ngm:access-control,
        ngm:corporate-tax-compliance-frameworkonomy,
        ngm:data-governance ;
    vc:slug "knowledge-management-system" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:content-management-system ;
    vc:uses ngm:information-retrieval,
        ngm:knowledge-graph,
        ngm:metadata-management,
        ngm:natural-language-processing .

ngm:kzg-commitment a owl:Class ;
    rdfs:label "KZG Commitment"@en ;
    rdfs:comment "A KZG commitment is a polynomial commitment scheme, named after Kate, Zaverucha and Goldberg, that lets a prover commit to a polynomial with a single constant-size group element and later open it at any point with a constant-size proof. Its security rests on elliptic-curve pairings and a structured reference string produced by a trusted setup. It is central to modern data-availability and scaling designs on Ethereum, including proto-danksharding and danksharding."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:elliptic-curve-cryptography ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:cryptographic-commitment ],
        ngm:polynomial-commitment ;
    vc:bridgesTo ngm:danksharding ;
    vc:enables ngm:danksharding,
        ngm:data-availability,
        ngm:data-availability-sampling ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:cryptographic-commitment ;
    vc:implements ngm:polynomial-commitment ;
    vc:isPartOf ngm:danksharding,
        ngm:polynomial-commitment ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:data-availability,
        ngm:ethereum,
        ngm:merkle-tree ;
    vc:requires ngm:elliptic-curve-cryptography ;
    vc:slug "kzg-commitment" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:rollup,
        ngm:zero-knowledge-proof ;
    vc:uses ngm:cryptographic-commitment,
        ngm:elliptic-curve-cryptography .

ngm:layer-2-solutions a owl:Class ;
    rdfs:label "Layer 2 Solutions"@en ;
    rdfs:comment "Layer 2 solutions are protocols and systems built atop a base blockchain (layer 1) that handle transactions off the main chain to increase throughput, reduce latency, and lower transaction costs, while periodically settling finality back to the underlying layer 1 for security. The principal layer 2 paradigms include optimistic rollups, zero-knowledge rollups, state channels, and sidechains, each offering distinct trust and performance tradeoffs."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:payment-channel ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:layer-1-blockchain ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:state-channel ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:optimistic-rollup ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:zk-rollup ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:sidechain ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-availability ],
        ngm:blockchain-scalability ;
    vc:bridgesTo ngm:cross-chain-interoperability ;
    vc:contrastsWith ngm:sharding ;
    vc:dependsOn ngm:consensus-mechanism,
        ngm:cryptographic-commitment ;
    vc:enables ngm:blockchain-transaction,
        ngm:decentralised-finance,
        ngm:micropayment,
        ngm:scalability ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:optimistic-rollup,
        ngm:payment-channel,
        ngm:sidechain,
        ngm:state-channel,
        ngm:zk-rollup ;
    vc:isPartOf ngm:blockchain-scalability ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:gas-fee-market,
        ngm:layer-2-scaling,
        ngm:lightning-network,
        ngm:proto-danksharding ;
    vc:requires ngm:data-availability,
        ngm:layer-1-blockchain ;
    vc:slug "layer-2-solutions" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:fraud-proof,
        ngm:sequencer,
        ngm:smart-contract,
        ngm:zero-knowledge-proof .

ngm:lifecycle-management a owl:Class ;
    rdfs:label "Lifecycle Management"@en ;
    rdfs:comment "Lifecycle management is the disciplined coordination of an asset, product, or system across all phases of its existence, from creation and deployment through operation, maintenance, and decommissioning. It defines processes, versioning, and governance that keep the entity consistent and accountable over time. For digital twins it ensures the virtual model stays synchronised with the physical asset throughout its operational life."@en ;
    rdfs:subClassOf ngm:infra-software-engineering ;
    skos:broader ngm:infra-software-engineering ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:construction-digital-twin,
        ngm:digital-twin-creation ;
    vc:slug "lifecycle-management" ;
    vc:sourceDomain "infrastructure" .

ngm:link-prediction a owl:Class ;
    rdfs:label "Link Prediction"@en ;
    rdfs:comment "Link prediction is the machine-learning task of inferring missing or future edges in a graph from its observed structure and node attributes. Techniques range from similarity heuristics and matrix factorisation to graph neural networks and knowledge-graph embeddings. It underpins recommendation, knowledge-graph completion, and social-network analysis."@en ;
    rdfs:subClassOf ngm:machine-learning-discipline-technique ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:graph-analytics,
        ngm:knowledge-graphing ;
    vc:slug "link-prediction" ;
    vc:sourceDomain "ai" .

ngm:lo-ra-do-ra-etc a owl:Class ;
    rdfs:label "LoRA DoRA etc"@en ;
    rdfs:comment "Parameter-Efficient Fine-Tuning (PEFT) is a family of machine learning techniques enabling adaptation of large pre-trained neural networks — particularly Large Language Models and diffusion models — to downstream tasks by updating only a small fraction (0.01–) of total model parameters rather..."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
