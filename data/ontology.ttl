    vc:slug "digital-twin-interop-protocol" ;
    vc:sourceDomain "spatial-computing" .

ngm:dijkstra-algorithm a owl:Class ;
    rdfs:label "Dijkstra Algorithm"@en ;
    rdfs:comment "A graph search algorithm that finds the shortest path from a source node to all other nodes in a weighted graph with non-negative edge weights. It systematically explores nodes in order of increasing distance from the source, guaranteeing optimal solutions."@en ;
    rdfs:subClassOf ngm:graph-search,
        ngm:path-planning,
        ngm:robo-navigation-and-planning ;
    skos:broader ngm:robo-navigation-and-planning ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires ngm:non-negative-weights,
        ngm:weighted-graph ;
    vc:slug "dijkstra-algorithm" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:graph-representation,
        ngm:priority-queue .

ngm:display-calibration a owl:Class ;
    rdfs:label "Display Calibration"@en ;
    rdfs:comment "Display calibration is the process of measuring and adjusting a display device's photometric and colorimetric characteristics—luminance, white point, gamma or EOTF, and colour gamut—to conform to a defined target standard or ICC colour profile. It employs colorimetric measurement instruments (colorimeters, spectrophotometers) to sample the display output and generates correction data (LUTs or ICC profiles) applied by the operating system or display hardware to compensate for manufacturing variation and age-related drift. Calibration is mandatory in colour-critical workflows including digital cinema (DCI-P3), broadcast (Rec. 709, Rec. 2020), medical imaging, and visual effects production."@en ;
    rdfs:subClassOf ngm:calibration ;
    vc:enables ngm:photorealistic-rendering,
        ngm:quality-assurance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:display-hardware,
        ngm:display-technology,
        ngm:physically-based-rendering ;
    vc:slug "display-calibration" ;
    vc:sourceDomain "graphics" ;
    vc:uses ngm:calibration-equipment,
        ngm:calibration-standards,
        ngm:display-metrology,
        ngm:optical-calibration-target .

ngm:display-metrology a owl:Class ;
    rdfs:label "Display Metrology"@en ;
    rdfs:comment "Standardized measurement equipment and instruments for assessing visual performance parameters of XR displays, including colorimeters, photometers, and specialised testing hardware."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:calibration-standards ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:resolution-test-chart ],
        ngm:sc-display-and-rendering,
        ngm:xr-testing-infrastructure ;
    skos:broader ngm:sc-display-and-rendering ;
    vc:enables ngm:compliance-testing,
        ngm:display-calibration,
        ngm:performance-validation,
        ngm:visual-quality-assessment ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:colorimeter,
        ngm:contrast-ratio-meter,
        ngm:luminance-meter,
        ngm:photometer,
        ngm:resolution-test-chart ;
    vc:isPartOf ngm:xr-testing-infrastructure ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:calibration-standards,
        ngm:environmental-control,
        ngm:measurement-protocols ;
    vc:slug "display-metrology" ;
    vc:sourceDomain "spatial-computing" .

ngm:do-178-c a owl:Class ;
    rdfs:label "DO-178C"@en ;
    rdfs:comment "DO-178C (Software Considerations in Airborne Systems and Equipment Certification) is the primary international standard governing the development and certification of airborne software, published by RTCA in 2011 as the successor to DO-178B. It defines five software levels (A through E) based on failure severity, each requiring progressively more rigorous development assurance activities including requirements traceability, structural coverage testing, and independence in reviews. Compliance with DO-178C is required by aviation regulatory authorities (FAA, EASA) for software installed in certified aircraft."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:formal-verification ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:software-testing ],
        ngm:safety-standard ;
    vc:enables ngm:embedded-systems,
        ngm:quality-assurance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:functional-safety,
        ngm:iec-61508,
        ngm:iso-26262 ;
    vc:requires ngm:formal-verification,
        ngm:software-testing ;
    vc:slug "do-178-c" ;
    vc:sourceDomain "infrastructure" .

ngm:driver-software a owl:Class ;
    rdfs:label "Driver Software"@en ;
    rdfs:comment "System-level software components that enable communication between operating systems and extended reality (XR) hardware devices, translating high-level application commands into hardware-specific instructions for VR headsets, AR glasses, haptic controllers, and spatial computing peripherals."@en ;
    rdfs:subClassOf ngm:sc-platform-and-environment,
        ngm:system-software ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:enables ngm:extended-reality-xr ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:slug "driver-software" ;
    vc:sourceDomain "spatial-computing" .

ngm:dynamic-character-animation a owl:Class ;
    rdfs:label "Dynamic Character Animation"@en ;
    rdfs:comment "Real-time procedural animation techniques that enable 3D avatars and characters to move, express, and respond dynamically to user input and environmental stimuli in metaverse environments, utilising motion capture, rigging systems, and AI-driven motion synthesis."@en ;
    rdfs:subClassOf ngm:3-d-animation,
        ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:enables ngm:immersive-experiences ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:slug "dynamic-character-animation" ;
    vc:sourceDomain "spatial-computing" .

ngm:e-idas-2-0 a owl:Class ;
    rdfs:label "eIDAS 2.0"@en ;
    rdfs:comment "eIDAS 2.0 is the revised EU regulation on electronic identification, authentication, and trust services, adopted in 2024 as an amendment to the original eIDAS regulation of 2014. Its central innovation is the European Digital Identity Wallet (EUDIW), a mandatory infrastructure obligation requiring EU member states to provide citizens and businesses with a personal digital wallet capable of storing verifiable credentials, qualified electronic signatures, and attribute attestations. The regulation mandates that large online platforms accept the wallet for authentication, directly challenging private identity providers and establishing a public-interest counterweight to platform data concentration. eIDAS 2.0 aligns with W3C Verifiable Credentials and Decentralised Identifiers standards, embedding open interoperability requirements into binding EU law."@en ;
    rdfs:subClassOf ngm:digital-identity-framework ;
    vc:enables ngm:authentication-standards,
        ngm:digital-identity-management ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:digital-identity-standards,
        ngm:digital-identity-wallet,
        ngm:self-sovereign-identity,
        ngm:verifiable-credentials ;
    vc:slug "e-idas-2-0" ;
    vc:sourceDomain "governance" ;
    vc:supports ngm:data-protection-regulation,
        ngm:digital-regulation .

ngm:eba a owl:Class ;
    rdfs:label "EBA"@en ;
    rdfs:comment "The European Banking Authority (EBA) is an independent EU regulatory agency established in 2011 to ensure consistent prudential regulation and supervision across the European banking sector. It develops binding technical standards and guidelines that national supervisors must implement, conducts EU-wide stress tests to assess banking system resilience, and plays a central role in developing anti-money laundering supervisory frameworks. The EBA's remit has expanded into digital finance, including technical standards for crypto-asset service providers under the MiCA Regulation and guidelines on ICT risk management."@en ;
    rdfs:subClassOf ngm:financial-regulation ;
    vc:enables ngm:aml-kyc-compliance,
        ngm:regulatory-compliance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:mi-ca-regulation ;
    vc:slug "eba" ;
    vc:sourceDomain "governance" ;
    vc:supports ngm:financial-stability,
        ngm:systemic-risk .

ngm:eccv a owl:Class ;
    rdfs:label "ECCV"@en ;
    rdfs:comment "ECCV, the European Conference on Computer Vision, is a biennial premier venue for research in computer vision and pattern recognition, held in alternating years with ICCV to provide the community with annual high-quality publication opportunities. Founded in 1990, it attracts thousands of submissions covering topics from low-level image processing and 3D reconstruction to high-level scene understanding and video analysis. ECCV proceedings published through Springer LNCS constitute one of the most-cited bodies of literature in artificial intelligence. Acceptance at ECCV carries high prestige, signalling rigorous peer review and methodological significance."@en ;
    rdfs:subClassOf ngm:computer-vision ;
    vc:enables ngm:benchmarks,
        ngm:model-evaluation-results ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:cvpr,
        ngm:iccv,
        ngm:iclr ;
    vc:slug "eccv" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:convolutional-neural-network,
        ngm:deep-learning,
        ngm:object-detection,
        ngm:semantic-segmentation .

ngm:economic-layer a owl:Class ;
    rdfs:label "Economic Layer"@en ;
    rdfs:comment "The Economic Layer is the abstraction level at which concrete economic mechanisms are implemented in blockchain and distributed systems, encompassing fee markets, reward distribution formulae, automated market makers, staking yield calculations, and game-theoretic incentive structures. It is distinct from conceptual economic theory in that it specifies exact parameters, formulas, and on-chain behaviours."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:governance-token ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:governance-model ],
        ngm:infra-computing-and-cloud ;
    skos:broader ngm:infra-computing-and-cloud ;
    vc:enables ngm:metaverse-as-markets ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:governance-model,
        ngm:governance-token ;
