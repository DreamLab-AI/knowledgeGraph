            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:know-your-customer ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:capital-adequacy ],
        ngm:governance ;
