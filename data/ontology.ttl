ngm:customer-experience-management a owl:Class ;
    rdfs:label "Customer Experience Management"@en ;
    rdfs:comment "Customer experience management is the practice of designing and coordinating customer interactions across channels to improve satisfaction and retention."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:crm ],
        ngm:crm ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:crm ;
    vc:slug "customer-experience-management" ;
    vc:sourceDomain "business" .

ngm:cycloidal-drive a owl:Class ;
    rdfs:label "Cycloidal Drive"@en ;
    rdfs:comment "A cycloidal drive is a mechanical speed-reduction gearbox in which an eccentrically mounted cycloidal disc engages a ring of pins to transmit motion at a high reduction ratio. It offers low backlash, high torque density and good shock resistance, making it a favoured actuator component in robot joints and precision positioning systems. Compared with planetary gearing it tolerates impact loads and distributes force across many contact points."@en ;
    rdfs:subClassOf ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:mechanical-component ;
    vc:slug "cycloidal-drive" ;
    vc:sourceDomain "robotics" .

ngm:d-yd-x a owl:Class ;
    rdfs:label "dYdX"@en ;
    rdfs:comment "dYdX is a decentralised exchange focused on perpetual-futures trading, allowing users to take leveraged long and short positions on cryptocurrencies. Earlier versions operated on Ethereum using a layer-two scaling solution with an off-chain order book and on-chain settlement, while a later version migrated to a purpose-built application-specific blockchain in the Cosmos ecosystem. It combines the order-book trading experience of centralised venues with non-custodial settlement."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:smart-contract ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
