    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:relatedTo ngm:cobot-safety-levels ;
    vc:requires ngm:functional-safety ;
    vc:slug "light-curtain" ;
    vc:sourceDomain "robotics" ;
    vc:standardizedBy ngm:iso-10218 ;
    vc:supports ngm:human-robot-interaction .

ngm:light-field a owl:Class ;
    rdfs:label "Light field"@en ;
    rdfs:comment "Light field is a foundational concept in computational optics and computer graphics describing the complete distribution of light rays travelling through free space in all directions at all points, formalised by Adelson and Bergen (1991) as the 7-dimensional plenoptic function P(Vx, Vy, Vz, θ, φ,..."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:camera-calibration ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:light-field-display ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gpu-compute ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:lens-and-camera-calibration ],
        ngm:sc-display-and-rendering ;
    skos:broader ngm:sc-display-and-rendering ;
    vc:bridgesTo ngm:computer-vision ;
    vc:enables ngm:6-do-f-vr,
        ngm:depth-estimation,
        ngm:holographic-display,
        ngm:novel-view-synthesis,
        ngm:parallax-rendering,
        ngm:refocusing-post-capture,
        ngm:spatial-computing ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:epipolar-plane-image,
        ngm:hogel,
        ngm:light-field-camera,
        ngm:light-field-display,
        ngm:microlens-array,
        ngm:plenoptic-function,
        ngm:sub-aperture-image ;
    vc:implements ngm:4-d-parameterisation,
        ngm:epipolar-geometry,
        ngm:fourier-slice-theorem,
        ngm:microlens-multiplexing,
        ngm:neural-radiance-fields,
        ngm:ray-plane-intersection ;
    vc:qualityScore "0.52"^^xsd:float ;
    vc:relatedTo ngm:computational-holography,
        ngm:holography,
        ngm:integral-imaging,
        ngm:neural-radiance-fields,
        ngm:plenoptic-camera,
        ngm:spatial-computing ;
    vc:requires ngm:camera-calibration,
        ngm:gpu-compute,
        ngm:lens-and-camera-calibration,
        ngm:multi-view-geometry,
        ngm:ray-parameterisation,
        ngm:sampling-theory ;
    vc:slug "light-field" ;
    vc:sourceDomain "spatial-computing" ;
    vc:standardizedBy ngm:acm-tog,
