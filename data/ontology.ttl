ngm:decentralization-layer a owl:Class ;
    rdfs:label "Decentralization Layer"@en ;
    rdfs:comment "Structural layer that distributes data and control across nodes to reduce central dependence and increase trust through P2P networking, blockchain, and distributed consensus mechanisms."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:consensus-protocol ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:blockchain ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:distributed-storage ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:network-infrastructure ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:distributed-hash-table ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptographic-primitive ],
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:enables ngm:censorship-resistance,
        ngm:data-sovereignty,
        ngm:fault-tolerance,
        ngm:trust-distribution ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:blockchain,
        ngm:consensus-protocol,
        ngm:distributed-hash-table,
        ngm:p2-p-network ;
    vc:isPartOf ngm:middleware-layer ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:cryptographic-primitive,
        ngm:distributed-storage,
        ngm:network-infrastructure ;
    vc:slug "decentralization-layer" ;
    vc:sourceDomain "spatial-computing" .

