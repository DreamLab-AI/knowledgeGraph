ngm:arc-face a owl:Class ;
    rdfs:label "ArcFace"@en ;
    rdfs:comment "ArcFace is a deep learning loss function and associated training methodology for facial recognition, introduced by Deng et al. at Imperial College London in 2019, that improves discriminative feature learning by adding an additive angular margin penalty to the softmax loss function. By penalising the angle between a sample embedding and its class centre in hyperspherical feature space, ArcFace forces the model to learn more compact intra-class and more separable inter-class feature embeddings than standard softmax or earlier margin-based losses. It has achieved state-of-the-art performance on numerous facial recognition benchmarks and is widely adopted in production identity verification systems."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:hyperparameter-tuning ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:embedding ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:cross-entropy-loss ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
