    vc:bridgesTo ngm:inclusive-design,
        ngm:universal-design ;
    vc:enables ngm:broader-user-base,
        ngm:inclusive-participation,
        ngm:regulatory-compliance ;
    vc:hasMaturity ngmi:maturity-draft ;
