ngm:eip-1559 a owl:Class ;
    rdfs:label "EIP-1559"@en ;
    rdfs:comment "EIP-1559 is an Ethereum Improvement Proposal implemented in the London hard fork that fundamentally reformed Ethereum's transaction fee market. It replaced the simple first-price auction mechanism with a protocol-determined base fee that automatically adjusts each block based on demand relative to a target block gas usage. The base fee is burned rather than paid to validators, creating a deflationary pressure on ether supply. Users optionally add a priority fee (tip) to incentivise timely inclusion. The mechanism improves fee predictability for users and reduces the miner extractable value (MEV) captured through fee sniping."@en ;
    rdfs:subClassOf ngm:bc-protocol-and-consensus ;
    skos:broader ngm:bc-protocol-and-consensus ;
    vc:contrastsWith ngm:proof-of-work ;
    vc:enables ngm:blockchain-transaction ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:blockchain-economics,
        ngm:gas-fee-market,
        ngm:transaction-fee ;
    vc:slug "eip-1559" ;
    vc:sourceDomain "blockchain" .

