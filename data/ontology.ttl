        ngm:rdf-schema,
        ngm:schema-org ;
    vc:slug "dublin-core" ;
    vc:sourceDomain "data" ;
    vc:standardizedBy ngm:interoperability-standard ;
    vc:supports ngm:institutional-repository,
        ngm:open-data ;
    vc:uses ngm:json-data-interchange-format-ld .

ngm:e-idas-2-0 a owl:Class ;
    rdfs:label "eIDAS 2.0"@en ;
    rdfs:comment "eIDAS 2.0 (Regulation EU 2024/1183) is the amended EU framework for electronic identification, authentication, and trust services, entered into force in May 2024 as a successor to the original eIDAS Regulation (EU 910/2014). Its cornerstone is the European Digital Identity Wallet (EUDIW), a mandatory public-infrastructure obligation requiring each EU member state to offer citizens, residents, and businesses a certified wallet for storing qualified electronic attestations of attributes, verifiable credentials, and qualified electronic signatures. The regulation obliges online platforms with more than 45 million EU users to accept the wallet as an authentication mechanism, dismantling private-sector identity lock-in and creating a public-interest counterweight to data concentration. eIDAS 2.0 aligns with W3C Verifiable Credentials, Decentralised Identifiers, OpenID for Verifiable Credential Issuance (OID4VCI), and OpenID for Verifiable Presentations (OID4VP), embedding open interoperability requirements and selective-disclosure privacy protections into binding EU law."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:selective-disclosure ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:qualified-electronic-signature ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:public-key-infrastructure ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:standards-conformance-testing ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:digital-identity-wallet ],
        ngm:digital-identity-framework ;
    vc:bridgesTo ngm:decentralised-finance ;
    vc:contrastsWith ngm:centralized-identity-provider,
        ngm:federated-identity,
        ngm:social-login ;
    vc:dependsOn ngm:digital-infrastructure,
        ngm:trust-service-provider ;
    vc:enables ngm:attribute-based-access-control,
        ngm:cross-border-authentication,
        ngm:digital-identity-management,
        ngm:self-sovereign-identity ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:digital-identity-wallet,
        ngm:qualified-electronic-signature ;
    vc:implements ngm:decentralised-identifiers,
        ngm:open-id-connect,
        ngm:verifiable-credentials ;
    vc:isPartOf ngm:digital-regulation,
        ngm:eu-digital-single-market ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:authentication-standards,
        ngm:digital-identity-standards,
        ngm:digital-identity-wallet,
        ngm:nis2-directive ;
    vc:requires ngm:public-key-infrastructure,
