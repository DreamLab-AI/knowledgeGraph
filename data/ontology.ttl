ngm:shap a owl:Class ;
    rdfs:label "SHAP"@en ;
    rdfs:comment "SHAP, short for SHapley Additive exPlanations, is a method for explaining the output of machine-learning models by attributing each prediction to its input features. It is grounded in Shapley values from cooperative game theory, which fairly distribute a payoff among contributors, treating each feature as a player and the prediction as the payoff. SHAP provides locally accurate, consistent feature attributions and unifies several earlier explanation techniques under a common framework."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:machine-learning-discipline-model ],
        ngm:explainable-ai ;
    vc:bridgesTo ngm:data-governance,
        ngm:fairness-in-machine-learning ;
    vc:contrastsWith ngm:integrated-gradients,
        ngm:lime,
        ngm:permutation-feature-importance ;
    vc:enables ngm:algorithmic-bias-auditing,
        ngm:feature-attribution,
        ngm:global-feature-importance,
        ngm:model-debugging,
        ngm:model-interpretability ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:additive-feature-attribution,
        ngm:consistency-property,
        ngm:local-accuracy-property ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:feature-importance,
        ngm:gradient-boosted-trees ;
    vc:requires ngm:baseline-expectation,
        ngm:cooperative-game-theory,
        ngm:machine-learning-discipline-model,
        ngm:shapley-value ;
    vc:slug "shap" ;
    vc:sourceDomain "ai" ;
    vc:supports ngm:human-in-the-loop,
        ngm:regulatory-ai-compliance,
        ngm:responsible-ai ;
    vc:uses ngm:deep-neural-network,
        ngm:kernel-shap,
        ngm:tree-ensemble .

