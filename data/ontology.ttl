    vc:requires ngm:dns-service,
        ngm:network-infrastructure,
        ngm:storage-systems ;
    vc:slug "content-delivery-network-cdn" ;
    vc:sourceDomain "infrastructure" .

ngm:control-layer a owl:Class ;
    rdfs:label "Control Layer"@en ;
    rdfs:comment "The Control Layer is the stratum that issues commands to actuators or subsystems to drive a system toward desired states. It sits above the Perception Layer, on whose estimates it acts, and below planning and agent strata that set goals. It contains controllers, feedback loops, set-point logic, and the actuation interfaces that effect change."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:perception-layer ],
        ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:enables ngm:agent-layer,
        ngm:coordination-layer ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:perception-layer ;
    vc:slug "control-layer" ;
    vc:sourceDomain "robotics" .

ngm:coordinate-transformation a owl:Class ;
    rdfs:label "Coordinate Transformation"@en ;
    rdfs:comment "A coordinate transformation is a mathematical mapping that converts the representation of a point, vector, or geometric object from one coordinate system or reference frame to another, preserving geometric relationships while expressing them in a new basis. In robotics and computer graphics, transformations are represented as homogeneous matrices, quaternions, or dual quaternions encoding rotation, translation, and scaling operations."@en ;
    rdfs:subClassOf ngm:coordinate-system ;
    vc:enables ngm:sensor-fusion ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:kinematics,
        ngm:reference-frames,
        ngm:rigid-body-dynamics ;
    vc:slug "coordinate-transformation" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:quaternion-math .

ngm:counter-terrorist-financing a owl:Class ;
    rdfs:label "Counter-Terrorist Financing"@en ;
    rdfs:comment "Counter-Terrorist Financing (CTF or CFT) is a set of legal, regulatory, and operational measures designed to detect, prevent, and disrupt the funding of terrorist activities. It complements anti-money-laundering regimes and is enforced through obligations such as customer due diligence, transaction monitoring, and reporting of suspicious activity. In digital assets, CTF underpins requirements like the FATF Travel Rule that mandate originator and beneficiary information for transfers."@en ;
    rdfs:subClassOf ngm:financial-regulation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:travel-rule ;
    vc:slug "counter-terrorist-financing" ;
    vc:sourceDomain "blockchain" .

ngm:creator-royalty-token a owl:Class ;
    rdfs:label "Creator Royalty Token"@en ;
    rdfs:comment "Token granting its holder a share of ongoing from creative works, enabling automated royalty distribution and fractional ownership of intellectual property income streams."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:blockchain ],
