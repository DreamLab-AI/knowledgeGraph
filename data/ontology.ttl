ngm:content-addressed-storage a owl:Class ;
    rdfs:label "Content-Addressed Storage"@en ;
    rdfs:comment "Content-addressed storage (CAS) is a data storage paradigm in which each piece of data is identified and retrieved by a cryptographic hash of its content rather than by its location or a human-assigned name. Because the identifier is derived deterministically from the data itself, identical content always maps to the same address, enabling automatic deduplication and verifiable integrity without requiring trust in the storage provider. Content-addressed storage forms the basis of distributed systems such as IPFS, Git, and Arweave, and underlies the content-integrity mechanisms of blockchain data layers. It is fundamentally different from location-addressed storage, where the same content can exist at multiple addresses or the same address can point to different content over time."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:content-identifier ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:hash-function ],
        ngm:data-storage ;
    vc:bridgesTo ngm:data-layer,
        ngm:data-versioning,
        ngm:model-registry ;
    vc:contrastsWith ngm:object-storage ;
    vc:enables ngm:cryptographic-verification,
        ngm:data-availability,
        ngm:data-deduplication,
        ngm:provenance,
        ngm:reproducible-builds,
        ngm:tamper-evidence ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:arweave,
        ngm:filecoin,
        ngm:git,
        ngm:ipfs ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:data-integrity,
        ngm:zero-knowledge-proof ;
    vc:requires ngm:content-identifier,
        ngm:hash-function ;
    vc:slug "content-addressed-storage" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:decentralized-storage,
        ngm:distributed-storage,
        ngm:peer-to-peer-network,
        ngm:version-control ;
    vc:uses ngm:content-addressing,
        ngm:cryptographic-hash,
        ngm:distributed-hash-table,
        ngm:kzg-commitment,
        ngm:merkle-tree .

