        ngm:rest-api .

ngm:api-key-authentication a owl:Class ;
    rdfs:label "Api Key Authentication"@en ;
    rdfs:comment "API key authentication is a simple scheme in which a client includes a static, secret key with each request to identify and authenticate itself to an API. The server checks the key against issued keys to grant or deny access and to attribute usage and rate limits. Although easy to adopt, it offers coarse-grained control and weaker security than token-based or signature-based schemes because the long-lived key alone confers access."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:encryption ],
        ngm:authentication ;
    vc:bridgesTo ngm:identity-provider ;
