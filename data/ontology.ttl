        ngm:text-to-speech,
        ngm:transformer-architecture .

ngm:data-format-standard a owl:Class ;
    rdfs:label "Data Format Standard"@en ;
    rdfs:comment "Technical specifications defining how data is structured, encoded, and exchanged across metaverse platforms and 3D applications, including standards like glTF for efficient 3D asset transmission and Universal Scene Description (USD) for complex scene composition and collaboration."@en ;
