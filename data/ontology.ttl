ngm:iso-23257 a owl:Class ;
    rdfs:label "ISO 23257"@en ;
    rdfs:comment "ISO/IEC 23257 is an international standard published jointly by ISO and IEC that defines a reference architecture for blockchain and distributed ledger technology (DLT) systems, providing a common vocabulary, conceptual model, and set of architectural views covering nodes, networks, consensus mechanisms, and system roles. It establishes a vendor-neutral framework that enables interoperability assessments, system design, and procurement across heterogeneous DLT ecosystems. The standard complements the broader ISO/TC 307 series on blockchain and DLT, serving as the architectural foundation upon which specific technology standards, conformance frameworks, and security profiles are built."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:peer-to-peer-network ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:distributed-ledger-technology ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:consensus-mechanism ],
        ngm:technical-standard ;
    vc:bridgesTo ngm:data-governance,
        ngm:zero-knowledge-proof ;
    vc:contrastsWith ngm:iso-22739,
        ngm:nist-blockchain-framework ;
    vc:enables ngm:blockchain-interoperability,
        ngm:system-conformance,
        ngm:vendor-neutral-procurement ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:blockchain-reference-architecture,
        ngm:consensus-mechanism,
        ngm:dlt-node ;
    vc:implements ngm:reference-architecture ;
    vc:isPartOf ngm:blockchain-standards,
        ngm:iso-tc-307 ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:distributed-systems,
        ngm:iso-24643,
        ngm:w3c-did ;
    vc:requires ngm:distributed-ledger-technology,
        ngm:peer-to-peer-network ;
    vc:slug "iso-23257" ;
    vc:sourceDomain "blockchain" ;
    vc:standardizedBy ngm:iec,
        ngm:iso ;
    vc:supports ngm:digital-identity,
        ngm:enterprise-blockchain,
        ngm:supply-chain-traceability ;
    vc:uses ngm:blockchain,
        ngm:cryptographic-hash,
        ngm:smart-contract .

