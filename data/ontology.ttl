# Sensor
rb:Sensor a owl:Class ;
    rdfs:subClassOf rb:RoboticsSystems ;
    rdfs:label "Sensor"@en ;
    rdfs:comment "Sensors are devices and systems that enable robots to perceive and measure their environment through the detection of physical phenomena. In robotics, sensors include LiDAR for spatial mapping, cameras for visual perception, IMUs for motion sensing, force-torque sensors for manipulation, and encoders for position feedback."@en ;
    skos:prefLabel "Sensor"@en ;
    dcterms:identifier "RB-0601" ;
    dcterms:subject "rb" .

rb:Sensor rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:isParentOf ;
    owl:someValuesFrom rb:LiDAR
] .

rb:Sensor rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:isParentOf ;
    owl:someValuesFrom rb:Camera
] .

rb:Sensor rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:isParentOf ;
    owl:someValuesFrom rb:IMU
] .

rb:Sensor rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:isParentOf ;
    owl:someValuesFrom rb:ForceTorqueSensor
] .

rb:Sensor rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:relatedTo ;
    owl:someValuesFrom rb:SensorFusion
] .

# Manipulation
rb:Manipulation a owl:Class ;
    rdfs:subClassOf rb:RoboticsSystems ;
    rdfs:label "Manipulation"@en ;
    rdfs:comment "Manipulation in robotics refers to the ability of robotic systems to physically interact with and control objects in their environment. This encompasses grasping, object handling, dexterous manipulation, and the end effectors and planning algorithms that enable robots to perform precise physical tasks."@en ;
    skos:prefLabel "Manipulation"@en ;
    dcterms:identifier "RB-0602" ;
    dcterms:subject "rb" .

rb:Manipulation rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:isParentOf ;
    owl:someValuesFrom rb:Gripper
] .

rb:Manipulation rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:isParentOf ;
    owl:someValuesFrom rb:EndEffector
] .

rb:Manipulation rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:isParentOf ;
    owl:someValuesFrom rb:GraspPlanning
] .

rb:Manipulation rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:relatedTo ;
    owl:someValuesFrom rb:MotionPlanning
] .

rb:Manipulation rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:relatedTo ;
    owl:someValuesFrom rb:RobotKinematics
] .

# State Estimation
rb:StateEstimation a owl:Class ;
    rdfs:subClassOf rb:RoboticsSystems ;
    rdfs:label "State Estimation"@en ;
    rdfs:comment "State Estimation encompasses the algorithms and techniques used to infer the internal state of a robotic system from noisy sensor measurements. Key approaches include Kalman filtering, particle filters, and Bayesian estimation methods that enable robots to maintain accurate representations of position, velocity, and other dynamic state variables."@en ;
    skos:prefLabel "State Estimation"@en ;
    dcterms:identifier "RB-0604" ;
    dcterms:subject "rb" .

rb:StateEstimation rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:isParentOf ;
    owl:someValuesFrom rb:KalmanFilter
] .

rb:StateEstimation rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:isParentOf ;
    owl:someValuesFrom rb:ParticleFilter
] .

rb:StateEstimation rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:isParentOf ;
    owl:someValuesFrom rb:BayesFilter
] .

rb:StateEstimation rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:relatedTo ;
    owl:someValuesFrom rb:Localization
] .

rb:StateEstimation rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:relatedTo ;
    owl:someValuesFrom rb:SensorFusion
] .

