ngm:ieee-p-7003-2021 a owl:Class ;
    rdfs:label "IEEE P7003-2021"@en ;
    rdfs:comment "IEEE P7003-2021 is a technical standard developed under the IEEE P7000 series on ethically aligned AI, specifically addressing algorithmic bias considerations in autonomous and intelligent systems. It provides a structured methodology for identifying, characterising, and mitigating unintended bias in algorithmic decision-making systems, covering the full development lifecycle from requirements elicitation through deployment and monitoring. The standard establishes processes for bias impact assessment, stakeholder engagement, and documentation requirements so that developers and organisations can systematically evaluate whether their AI systems produce discriminatory or inequitable outcomes across protected characteristics. It is complementary to IEEE P7001 (Transparency), IEEE P7002 (Data Privacy), and other standards in the IEEE 7000 series that collectively operationalise responsible AI development."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:stakeholder-engagement ],
        ngm:technical-standard ;
    vc:bridgesTo ngm:data-governance,
        ngm:human-rights-law ;
    vc:contrastsWith ngm:iso-iec-42001,
        ngm:nist-ai-rmf ;
    vc:enables ngm:ai-risk-management,
        ngm:algorithmic-fairness,
        ngm:responsible-ai ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:bias-mitigation,
        ngm:fairness-by-design ;
    vc:isPartOf ngm:ieee-7000-series,
        ngm:responsible-ai-standards ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:algorithmic-bias,
        ngm:ieee-p7001-2021,
        ngm:ieee-p7002-2022,
        ngm:machine-learning-fairness ;
    vc:requires ngm:algorithmic-fairness-metrics,
        ngm:bias-impact-assessment,
        ngm:stakeholder-engagement ;
    vc:slug "ieee-p-7003-2021" ;
    vc:sourceDomain "governance" ;
    vc:standardizedBy ngm:ieee ;
    vc:supports ngm:ai-governance,
        ngm:algorithmic-accountability,
        ngm:eu-ai-act ;
    vc:uses ngm:model-documentation,
        ngm:protected-characteristics,
        ngm:statistical-fairness-criteria .

