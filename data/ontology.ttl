    vc:sourceDomain "security" ;
    vc:standardizedBy ngm:nist ;
    vc:supports ngm:consensus-mechanism,
        ngm:nonce,
        ngm:private-key-generation ;
    vc:uses ngm:hash-function,
        ngm:stream-cipher .

