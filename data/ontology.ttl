    vcw:maturityLevel "draft" ;
    vcw:authorityScore "0.0"^^xsd:decimal ;
    dcterms:identifier "BC-0458" ;
    dcterms:subject "blockchain" ;
    owl:versionInfo "2.0.0" ;
    dcterms:created "2026-04-26T00:00:00Z"^^xsd:dateTime ;
    dcterms:modified "2026-04-26T13:00:00Z"^^xsd:dateTime ;
    vcw:owlRole "Concept" .

# Digital Identity Wallet
blockchain:DigitalIdentityWallet rdf:type owl:Class ;
    rdfs:label "Digital Identity Wallet"@en ;
    rdfs:comment "A cryptographically secured application enabling individuals and organisations to receive, store, manage, and selectively disclose Verifiable Credentials whilst maintaining sovereign control over Decentralized Identifiers and personal data through edge (device-based), cloud, or hybrid architectures. Digital identity wallets implement selective disclosure, biometric protection, and privacy-preserving presentation protocols to enable Self-Sovereign Identity ecosystems, exemplified by the European Digital Identity Wallet (EUDI) mandated for all EU member states by November 2026, Microsoft Authenticator's verifiable credentials capability, and open-source implementations on Hyperledger Aries supporting credential issuance, presentation, and revocation across 350+ organisations."@en ;
    skos:prefLabel "Digital Identity Wallet"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:blockchain:digital-identity-wallet" ;
    owl:sameAs <urn:visionclaw:concept:blockchain:digital-identity-wallet> ;
    vcw:contentHash "sha256-12-1a311c1b7483" ;
    vcw:qualityScore "0.4"^^xsd:decimal ;
    vcw:legacyTermId "BC-0459" ;
    vcw:ontologyStatus "stub-needs-content" ;
    vcw:maturityLevel "draft" ;
    vcw:authorityScore "0.0"^^xsd:decimal ;
    dcterms:identifier "BC-0459" ;
    dcterms:subject "blockchain" ;
    owl:versionInfo "2.0.0" ;
    dcterms:created "2026-04-26T00:00:00Z"^^xsd:dateTime ;
    dcterms:modified "2026-04-26T13:00:00Z"^^xsd:dateTime ;
    vcw:owlRole "Concept" .

blockchain:DigitalIdentityWallet vcw:bridgesTo blockchain:AIAgentSystem .

# Identity Verification
blockchain:IdentityVerification rdf:type owl:Class ;
    rdfs:label "Identity Verification"@en ;
    rdfs:comment "Critical process confirming identity through multi-factor evidence—document verification, biometric matching, knowledge-based challenges, database cross-references—establishing binding between real-world identity and digital credentials under defined assurance levels (NIST IAL1-3 or eIDAS low/substantial/high). Identity verification initialises VerifiableCredential systems by performing rigorous proofing once, enabling credentials to support multiple relying parties without redundant verification, reducing friction for users and costs for organisations. Know Your Customer and Anti-Money Laundering regulations mandate verification for financial institutions, whilst continuous authentication and risk-based adaptation adjust verification rigour to transaction risk."@en ;
    skos:prefLabel "Identity Verification"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:blockchain:identity-verification-bc-0460" ;
    owl:sameAs <urn:visionclaw:concept:blockchain:identity-verification-bc-0460> ;
    vcw:contentHash "sha256-12-af88e1052086" ;
    vcw:qualityScore "0.4"^^xsd:decimal ;
    vcw:legacyTermId "BC-0460" ;
    vcw:ontologyStatus "stub-needs-content" ;
    vcw:maturityLevel "draft" ;
    vcw:authorityScore "0.0"^^xsd:decimal ;
    dcterms:identifier "BC-0460" ;
    dcterms:subject "blockchain" ;
    owl:versionInfo "2.0.0" ;
    dcterms:created "2026-04-26T00:00:00Z"^^xsd:dateTime ;
    dcterms:modified "2026-04-26T13:00:00Z"^^xsd:dateTime ;
    vcw:owlRole "Concept" .

blockchain:IdentityVerification rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty infrastructure:requires ;
    owl:someValuesFrom blockchain:KnowYourCustomer
] .

blockchain:IdentityVerification rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty infrastructure:enables ;
    owl:someValuesFrom blockchain:VerifiableCredential
] .

# Decentralized Autonomous Organization
blockchain:DecentralizedAutonomousOrganization rdf:type owl:Class ;
    rdfs:label "Decentralized Autonomous Organization"@en ;
    rdfs:comment "An organisational entity operating through Smart Contracts, Distributed Governance, and community voting mechanisms without centralised authority or hierarchical control. Decentralised Autonomous Organisations enable transparent resource allocation, democratic decision-making, and distributed treasury management at global scale."@en ;
    skos:prefLabel "Decentralized Autonomous Organization"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:blockchain:decentralized-autonomous-organization" ;
    owl:sameAs <urn:visionclaw:concept:blockchain:decentralized-autonomous-organization> ;
