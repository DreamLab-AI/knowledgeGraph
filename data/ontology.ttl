    vc:slug "incident-reporting" ;
    vc:sourceDomain "governance" ;
    vc:supports ngm:data-breach,
        ngm:vulnerability ;
    vc:uses ngm:ai-monitoring,
        ngm:compliance-audit-trail .

ngm:iso-14064 a owl:Class ;
    rdfs:label "ISO 14064"@en ;
    rdfs:comment "ISO 14064 is a three-part international standard series specifying principles and requirements for the quantification, monitoring, reporting, and independent verification of greenhouse gas (GHG) emissions and removals at organisational level (Part 1), at project level (Part 2), and for validation and verification bodies (Part 3). The standard provides a framework for organisations to account for their Scope 1, 2, and 3 emissions in a manner that is auditable by third-party verification bodies, and it underpins voluntary carbon markets, corporate sustainability reporting obligations, and blockchain-based carbon credit tokenisation schemes."@en ;
    rdfs:subClassOf ngm:bc-governance-and-regulation ;
    skos:broader ngm:bc-governance-and-regulation ;
    vc:enables ngm:carbon-accounting,
        ngm:carbon-credits,
