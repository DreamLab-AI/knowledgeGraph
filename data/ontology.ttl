ngm:synthetic-data-generation a owl:Class ;
    rdfs:label "Synthetic Data Generation"@en ;
    rdfs:comment "Synthetic Data Generation is the process of algorithmically producing artificial datasets that statistically mirror real-world distributions without exposing sensitive personal information. Techniques include generative adversarial networks, diffusion models, physics simulation, and rule-based sampling, enabling model training where real data is scarce, private, or costly to label."@en ;
    rdfs:subClassOf ngm:ai-application ;
    skos:broader ngm:ai-application ;
