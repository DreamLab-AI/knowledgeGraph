ngm:reverse-logistics a owl:Class ;
    rdfs:label "Reverse Logistics"@en ;
    rdfs:comment "Reverse logistics encompasses all operations related to the reuse, processing, and management of products and materials flowing backward through the supply chain from the consumer or end-of-life point toward the manufacturer or recycler. It includes product returns, refurbishment, remanufacturing, recycling, and responsible disposal, and is a key operational component of circular economy strategies."@en ;
    rdfs:subClassOf ngm:logistics ;
    vc:enables ngm:deposit-return-scheme,
        ngm:waste-management ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:circular-economy,
        ngm:supply-chain ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:e-waste,
        ngm:logistics-management ;
    vc:slug "reverse-logistics" ;
    vc:sourceDomain "infrastructure" .

ngm:revocation-mechanism a owl:Class ;
    rdfs:label "Revocation Mechanism"@en ;
    rdfs:comment "A revocation mechanism is a cryptographic or registry-based procedure for invalidating a previously issued credential, certificate, or access token before its natural expiry, allowing issuers to withdraw trust following compromise, policy change, or holder misconduct. In digital identity systems, revocation mechanisms range from Certificate Revocation Lists and OCSP for X.509 certificates to Bitstring Status Lists and cryptographic accumulators for verifiable credentials. The privacy characteristics and scalability of each approach differ substantially, making mechanism selection a critical design decision."@en ;
    rdfs:subClassOf ngm:cryptographic-infrastructure ;
    vc:enables ngm:decentralized-identity-did,
        ngm:self-sovereign-identity-ssi ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:certificate-authority,
        ngm:credential-definition ;
    vc:slug "revocation-mechanism" ;
    vc:sourceDomain "security" ;
    vc:uses ngm:bitstring-status-list,
        ngm:cryptographic-accumulator,
        ngm:verifiable-credentials .

ngm:risk-management-framework a owl:Class ;
    rdfs:label "Risk Management Framework"@en ;
    rdfs:comment "A Risk Management Framework is a structured methodology for identifying, assessing, treating, and monitoring risks to an organisation's objectives, assets, or systems. It provides a repeatable process and governance structure that links risk appetite, control selection, and assurance activities into a coherent programme aligned with recognised standards such as ISO 31000, NIST RMF, or the NIST AI RMF."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:risk-mitigation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:risk-assessment ],
        ngm:risk-management ;
    vc:bridgesTo ngm:ai-governance,
        ngm:supply-chain-risk-management ;
    vc:enables ngm:audit,
        ngm:compliance,
        ngm:residual-risk-acceptance ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:continuous-monitoring,
        ngm:control-catalogue,
        ngm:risk-appetite-statement,
        ngm:risk-register ;
    vc:implements ngm:iso-31000,
        ngm:nist-ai-rmf,
        ngm:nist-cybersecurity-framework ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:business-continuity-planning,
        ngm:information-security-management-system ;
    vc:requires ngm:risk-assessment,
        ngm:risk-identification,
        ngm:risk-mitigation ;
    vc:slug "risk-management-framework" ;
    vc:sourceDomain "governance" ;
    vc:supports ngm:governance-framework,
        ngm:organisational-resilience ;
    vc:uses ngm:grc-platform,
        ngm:nist,
        ngm:security-framework,
        ngm:threat-modelling .

ngm:robotic-arm a skos:Concept ;
    rdfs:label "Robotic Arm"@en .

ngm:robotic-control a owl:Class ;
    rdfs:label "Robotic Control"@en ;
    rdfs:comment "Robotic control is the discipline of designing algorithms and hardware that regulate the motion, force, and behaviour of robotic systems to achieve desired trajectories or task objectives in the presence of dynamic uncertainty, environmental disturbances, and physical constraints. It spans classical feedback control strategies such as PID, computed-torque, and impedance control, through to model-predictive and learning-based controllers that adapt online. Robotic control integrates kinematics, dynamics, estimation, and optimisation to translate high-level task plans into actuator commands. It is a foundational competency enabling manipulation, locomotion, and human-robot interaction across industrial and service robot applications."@en ;
    rdfs:subClassOf ngm:control-system ;
    vc:enables ngm:autonomous-robot,
        ngm:collaborative-systems-modality-robot,
        ngm:multi-robot-systems ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:adaptive-control,
        ngm:control-theory,
        ngm:optimal-control,
        ngm:torque-control ;
    vc:slug "robotic-control" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:force-control,
        ngm:inverse-kinematics,
        ngm:motion-control,
        ngm:pid-control .

ngm:safety-assessment a owl:Class ;
    rdfs:label "Safety Assessment"@en ;
    rdfs:comment "Safety assessment is a systematic analytical process that identifies, evaluates, and mitigates hazards associated with a system, product, or operational process to demonstrate that residual risk is tolerable within accepted standards and regulatory frameworks. It encompasses methods such as Failure Modes and Effects Analysis (FMEA), Fault Tree Analysis (FTA), Hazard and Operability Studies (HAZOP), and probabilistic safety analysis, applied across domains including aerospace, automotive, nuclear, medical devices, and increasingly AI systems. Safety assessments form the evidentiary basis for certification against safety standards such as IEC 61508 and ISO 26262."@en ;
    rdfs:subClassOf ngm:risk-assessment ;
    vc:enables ngm:ai-risk-assessment,
        ngm:safety-critical-systems ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:iec-61508,
        ngm:iso-26262,
        ngm:safety-standard ;
    vc:slug "safety-assessment" ;
    vc:sourceDomain "governance" ;
    vc:uses ngm:functional-safety,
        ngm:hazard-analysis,
        ngm:risk-assessment-methodology .

ngm:safety-evaluation a owl:Class ;
    rdfs:label "Safety Evaluation"@en ;
    rdfs:comment "Safety evaluation is the systematic assessment of whether an AI system behaves acceptably under a defined threat and risk model, measuring propensities for harmful outputs, susceptibility to misuse, robustness under adversarial pressure, and the presence of dangerous capabilities. It combines automated benchmarks, red-teaming, and structured human review to produce evidence used in deployment decisions and governance reporting. Distinct from capability evaluation, safety evaluation asks not only what a model can do but how reliably it refrains from causing harm."@en ;
    rdfs:subClassOf ngm:model-evaluation ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:risk-assessment ;
    vc:slug "safety-evaluation" ;
    vc:sourceDomain "ai" ;
    vc:supports ngm:ai-alignment,
        ngm:ai-safety ;
    vc:uses ngm:red-teaming .

ngm:safety-fine-tuning a owl:Class ;
    rdfs:label "Safety Fine Tuning"@en ;
    rdfs:comment "Safety Fine Tuning is a specialised training stage applied after general capability training to reduce harmful outputs and align model behaviour with safety principles. It employs safety-curated datasets, RLHF, and constitutional AI objectives to harden models against adversarial misuse and emergent misalignment."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:training-data ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:reinforcement-learning-from-human-feedback ],
        ngm:ai-alignment,
        ngm:ai-governance-and-ethics ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:contrastsWith ngm:adversarial-attack ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:robustness ;
    vc:requires ngm:reinforcement-learning-from-human-feedback,
        ngm:training-data ;
    vc:slug "safety-fine-tuning" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:ai-safety,
        ngm:value-alignment .

ngm:sanctions-enforcement a owl:Class ;
    rdfs:label "Sanctions Enforcement"@en ;
    rdfs:comment "Sanctions enforcement is the regulatory and operational process by which financial institutions, governments, and technology platforms identify, screen, and block transactions, assets, and relationships involving sanctioned individuals, entities, or jurisdictions as designated by authorities such as OFAC, the UN Security Council, the European Union, or HM Treasury. It encompasses real-time screening of payment flows against consolidated sanctions lists, asset-freezing procedures, reporting obligations, and the maintenance of audit trails demonstrating compliance. In digital asset and blockchain contexts, sanctions enforcement extends to on-chain transaction monitoring and the blocking of wallet addresses associated with designated parties."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:entity-resolution ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:compliance-audit-trail ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:sanctions-screening ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:know-your-customer ],
        ngm:compliance-framework ;
    vc:bridgesTo ngm:decentralised-finance,
        ngm:smart-contract-compliance ;
    vc:contrastsWith ngm:anti-money-laundering,
        ngm:counter-terrorism-financing ;
    vc:enables ngm:aml-kyc-compliance,
        ngm:regulatory-reporting,
        ngm:transaction-blocking ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:asset-freezing,
        ngm:compliance-audit-trail,
        ngm:sanctions-screening ;
    vc:isPartOf ngm:aml-cft-regime,
        ngm:financial-regulation ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:foreign-policy-instrument,
        ngm:secondary-sanctions-liability ;
    vc:requires ngm:entity-resolution,
        ngm:know-your-customer,
        ngm:watchlist-management ;
    vc:slug "sanctions-enforcement" ;
    vc:sourceDomain "governance" ;
    vc:standardizedBy ngm:fatf,
        ngm:ofac,
        ngm:un-security-council-sanctions ;
    vc:uses ngm:blockchain-analytics,
        ngm:fuzzy-name-matching,
        ngm:machine-learning-classifier .

ngm:scene-management a owl:Class ;
    rdfs:label "Scene Management"@en ;
    rdfs:comment "Scene Management encompasses the runtime systems and data structures responsible for organising, loading, and unloading 3D scene content in real-time environments. It coordinates scene graph traversal, hierarchical object relationships, asset streaming, and spatial partitioning to ensure that only geometrically and logically relevant content is active at any moment, enabling scalable and performant virtual worlds."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:ar-scene-graph ],
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:enables ngm:occlusion-culling,
        ngm:scene-optimization ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:ar-scene-graph ;
    vc:isPartOf ngm:render-pipeline ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:slug "scene-management" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:asset-management,
        ngm:level-of-detail .

ngm:search-algorithms a owl:Class ;
    rdfs:label "Search Algorithms"@en ;
    rdfs:comment "Search Algorithms is a artificial intelligence concept and a type of Artificial Intelligence. that enables Pathfinding, Planning and Scheduling."@en ;
    rdfs:subClassOf ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
