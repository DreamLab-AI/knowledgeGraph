    vc:slug "network-topology" ;
    vc:sourceDomain "blockchain" .

ngm:open-source-software a owl:Class ;
    rdfs:label "Open Source Software"@en ;
    rdfs:comment "Open Source Software is software whose source code is made publicly available under a licence that permits inspection, modification, and redistribution. In the AI and metaverse infrastructure ecosystem, open-source projects provide the foundational frameworks — including deep learning libraries, rendering engines, and interoperability toolkits — that accelerate innovation, reduce vendor lock-in, and enable community-driven governance. Licences such as MIT, Apache 2.0, and GPL govern the permissibility of commercial reuse and derivative works."@en ;
    rdfs:subClassOf ngm:infra-software-engineering ;
    skos:broader ngm:infra-software-engineering ;
    vc:enables ngm:collaboration,
        ngm:open-source-ai ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.3"^^xsd:float ;
    vc:relatedTo ngm:open-source-framework,
        ngm:software-library ;
    vc:slug "open-source-software" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:license,
        ngm:version-control .

ngm:price-oracle a owl:Class ;
    rdfs:label "Price Oracle"@en ;
    rdfs:comment "A price oracle is an on-chain or hybrid data feed that supplies decentralised protocols with reliable, manipulation-resistant market prices for tokens, synthetic assets, and other financial instruments. On-chain price oracles—such as time-weighted average price (TWAP) feeds derived from automated market maker pool reserves—are fully decentralised but lag real-time prices. Off-chain oracle networks aggregate prices from multiple centralised and decentralised exchanges before committing them on-chain, offering fresher data at the cost of additional trust assumptions on node operators. Price oracles are foundational to DeFi lending protocols (collateral valuation), synthetic asset minting, perpetual futures settlement, and insurance claim adjudication."@en ;
    rdfs:subClassOf ngm:bc-defi-and-economics ;
    skos:broader ngm:bc-defi-and-economics ;
    vc:dependsOn ngm:oracle-network ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:automated-market-maker,
        ngm:blockchain-oracle ;
    vc:slug "price-oracle" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:decentralised-finance,
        ngm:liquidity-pool .

ngm:supply-chain-management a owl:Class ;
    rdfs:label "Supply Chain Management"@en ;
    rdfs:comment "Supply Chain Management in blockchain contexts refers to the application of distributed ledger technology for tracking, verifying, and managing the flow of goods, services, and information across supply networks."@en ;
    rdfs:subClassOf ngm:bc-network-component,
        ngm:blockchain-entity ;
    skos:broader ngm:bc-network-component ;
    vc:enables ngm:provenance-tracking,
        ngm:provenance-verification ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:relatedTo ngm:digital-twin,
        ngm:logistics-optimization ;
    vc:slug "supply-chain-management" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:blockchain,
        ngm:smart-contract .

ngm:sybil-resistance a owl:Class ;
    rdfs:label "Sybil Resistance"@en ;
    rdfs:comment "Sybil resistance is the property of a distributed network that limits the influence any single adversary can exert by creating multiple pseudonymous or fake identities. It is a foundational security requirement for decentralised systems where participation rights, voting power, or reputation depend on identity uniqueness. Mechanisms achieving sybil resistance include proof-of-work, proof-of-stake, and humanity attestation schemes such as biometric or social vouching protocols."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:identity-verification ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:consensus-mechanism ],
        ngm:bc-protocol-and-consensus ;
    skos:broader ngm:bc-protocol-and-consensus ;
    vc:contrastsWith ngm:sybil-attack ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:humanity-attestation,
        ngm:proof-of-stake,
        ngm:reputation-system ;
    vc:requires ngm:consensus-mechanism,
        ngm:identity-verification ;
    vc:slug "sybil-resistance" ;
