    vc:slug "hipaa" ;
    vc:sourceDomain "governance" .

ngm:holographic-display a owl:Class ;
    rdfs:label "Holographic Display"@en ;
    rdfs:comment "A holographic display is a display system that reconstructs the full optical wavefront of a three-dimensional scene, enabling viewers to perceive genuine depth cues — including motion parallax, focus accommodation, and binocular disparity — without wearing specialised eyewear. It achieves this by encoding scenes as holograms (interference fringe patterns) and illuminating them with coherent or structured light to recreate the original light field. Unlike stereoscopic or autostereoscopic displays, holographic displays avoid the vergence-accommodation conflict because the eye can naturally refocus at different depths within the reconstructed scene. Practical implementations typically use spatial light modulators, diffractive optical elements, or photopolymer recording media to shape wavefronts, placing extreme demands on computational throughput and optical bandwidth."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:holography ],
        ngm:display-technology ;
    vc:bridgesTo ngm:digital-twin,
        ngm:extended-reality,
        ngm:metaverse ;
    vc:contrastsWith ngm:flat-panel-display,
        ngm:stereoscopic-display ;
    vc:dependsOn ngm:photonics,
        ngm:real-time-rendering ;
    vc:enables ngm:augmented-reality,
        ngm:spatial-computing,
        ngm:telepresence ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:head-mounted-display,
        ngm:mixed-reality ;
    vc:requires ngm:holography ;
    vc:slug "holographic-display" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:gpu-compute,
        ngm:light-field .

ngm:homogeneous-transformation a owl:Class ;
    rdfs:label "Homogeneous Transformation"@en ;
    rdfs:comment "A homogeneous transformation is a 4x4 matrix that compactly represents both rotation and translation of a rigid body in three-dimensional space using homogeneous coordinates. By embedding rotation and translation into a single matrix, transformations can be composed through matrix multiplication, making them the standard tool for relating coordinate frames in robotics and graphics. Homogeneous transformations underpin forward and inverse kinematics, pose representation and frame chaining along kinematic links."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:translation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:linear-algebra ],
        ngm:coordinate-transformation ;
    vc:bridgesTo ngm:pose-estimation ;
    vc:dependsOn ngm:coordinate-transformation ;
    vc:enables ngm:forward-kinematics,
        ngm:inverse-kinematics ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:translation ;
    vc:implements ngm:coordinate-transformation ;
    vc:isPartOf ngm:kinematics ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:coordinate-transformation,
        ngm:pose-estimation ;
    vc:requires ngm:linear-algebra ;
    vc:slug "homogeneous-transformation" ;
    vc:sourceDomain "robotics" ;
    vc:supports ngm:kinematics-model,
        ngm:robot-control ;
    vc:uses ngm:linear-algebra .

ngm:homography a owl:Class ;
    rdfs:label "Homography"@en ;
    rdfs:comment "A homography is a projective transformation, represented by a 3x3 matrix, that maps points from one plane to another in homogeneous coordinates, preserving straight lines but not parallelism or angles. In computer vision it relates two images of the same planar surface or two views taken from the same camera centre, enabling tasks such as image rectification, perspective correction, and mosaicking. Homographies are estimated from corresponding feature points, often robustly via methods that reject outlier matches."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:feature-matching ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:feature-matching ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:camera-calibration ],
        ngm:projective-geometry ;
    vc:bridgesTo ngm:epipolar-geometry ;
    vc:enables ngm:augmented-reality ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:feature-matching ;
    vc:isPartOf ngm:projective-geometry ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:camera-calibration,
        ngm:computer-vision,
        ngm:epipolar-geometry,
        ngm:slam ;
    vc:requires ngm:camera-calibration,
        ngm:feature-matching ;
    vc:slug "homography" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:augmented-reality,
        ngm:structure-from-motion ;
    vc:uses ngm:feature-matching,
        ngm:ransac .

ngm:htlc a owl:Class ;
    rdfs:label "HTLC"@en ;
    rdfs:comment "A Hashed Time-Locked Contract is a conditional payment construct that releases funds when a preimage is revealed before a deadline, otherwise refunding the sender. It combines a cryptographic hash commitment with an on-chain timeout to achieve trustless conditional transfer across untrusted intermediaries."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:timelock ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:digital-signature ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:hash-function ],
        ngm:smart-contract ;
    vc:bridgesTo ngm:cryptographic-commitment,
        ngm:decentralised-finance ;
    vc:contrastsWith ngm:escrow-system ;
    vc:dependsOn ngm:blockchain,
        ngm:utxo-model ;
    vc:enables ngm:atomic-swap,
        ngm:cross-chain-bridge,
        ngm:lightning-network,
        ngm:payment-channel ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:conditional-payment,
        ngm:trustless-escrow ;
    vc:isPartOf ngm:layer-2-protocol,
        ngm:payment-channel-network ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:payment-network,
        ngm:state-channel ;
    vc:requires ngm:digital-signature,
        ngm:hash-function,
        ngm:preimage,
        ngm:timelock ;
    vc:slug "htlc" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:onion-routing,
        ngm:payment-routing ;
    vc:uses ngm:bitcoin-script,
        ngm:merkle-tree,
        ngm:sha-256 .

ngm:icvcm-core-carbon-principles a owl:Class ;
    rdfs:label "ICVCM Core Carbon Principles"@en ;
    rdfs:comment "The ICVCM Core Carbon Principles (CCPs) are a set of ten threshold standards established by the Integrity Council for the Voluntary Carbon Market to define what constitutes a high-quality carbon credit. They cover governance, emissions impact, and sustainable development dimensions, requiring that credits be real, additional, quantified, permanent, independently verified, and contribute positively to sustainable development goals without causing harm to local communities or ecosystems."@en ;
    rdfs:subClassOf ngm:icvcm-framework ;
    vc:enables ngm:carbon-credit-retirement,
        ngm:voluntary-carbon-market ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:carbon-standard-certification,
        ngm:verra-vcs-standard ;
    vc:slug "icvcm-core-carbon-principles" ;
    vc:sourceDomain "governance" ;
    vc:standardizedBy ngm:integrity-council-for-the-voluntary-carbon-market ;
    vc:supports ngm:carbon-markets .

ngm:identity-layer a owl:Class ;
    rdfs:label "Identity Layer"@en ;
    rdfs:comment "The Identity Layer is the cross-cutting stratum that establishes, represents, and verifies the identities of participants and resources. It sits above the Cryptographic Layer, on which its proofs rest, and below access, policy, and governance strata that reason about who is acting. It contains identifiers, credentials, authentication mechanisms, and the bindings between them."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptographic-layer ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:identifier-layer ],
        ngm:infra-security-and-identity ;
    skos:broader ngm:infra-security-and-identity ;
    vc:enables ngm:custody-layer,
        ngm:policy-layer ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:cryptographic-layer,
        ngm:identifier-layer ;
    vc:slug "identity-layer" ;
    vc:sourceDomain "security" .

ngm:identity-verification-system a owl:Class ;
    rdfs:label "Identity Verification System"@en ;
    rdfs:comment "An Identity Verification System (IVS) is an integrated set of processes, technologies, and controls that establish with high assurance that a person presenting a claimed identity is genuinely that individual. It typically orchestrates document authentication, biometric matching with liveness detection, and cross-referential data validation against authoritative databases to produce a risk-scored trust signal. IVSs operate across regulated sectors — financial services, healthcare, government, and telecommunications — where Know Your Customer (KYC) and Anti-Money Laundering (AML) obligations mandate identity proofing at onboarding and at trust-elevation events. Modern IVSs increasingly integrate machine-learning fraud-detection models, cryptographic document signatures, and decentralised identity standards to resist synthetic-identity fraud and deepfake attacks."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:optical-character-recognition ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:risk-scoring ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:liveness-detection ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:biometric-authentication ],
        ngm:identity-management ;
    vc:bridgesTo ngm:decentralised-identity,
        ngm:verifiable-credential-vc ;
    vc:contrastsWith ngm:authentication,
        ngm:authorisation ;
    vc:dependsOn ngm:machine-learning,
        ngm:public-key-infrastructure ;
    vc:enables ngm:access-control,
        ngm:anti-money-laundering,
        ngm:digital-onboarding,
        ngm:know-your-customer ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:document-authentication,
        ngm:liveness-detection,
        ngm:risk-scoring ;
    vc:implements ngm:identity-proofing ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:privacy-preserving-computation,
        ngm:synthetic-identity-fraud ;
    vc:requires ngm:biometric-authentication,
        ngm:optical-character-recognition ;
    vc:slug "identity-verification-system" ;
    vc:sourceDomain "security" ;
    vc:standardizedBy ngm:eidas-regulation,
        ngm:iso-iec,
        ngm:nist-sp-800-63 ;
    vc:supports ngm:fraud-detection,
        ngm:regulatory-compliance ;
    vc:uses ngm:cryptographic-signature,
        ngm:facial-recognition,
        ngm:natural-language-processing .

ngm:ieee-802-11 a owl:Class ;
    rdfs:label "IEEE 802.11"@en ;
    rdfs:comment "IEEE 802.11 specifies the medium access control and physical layer protocols for wireless local area networks, commonly known as Wi-Fi."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ieee ],
