    vc:enables ngm:machine-learning-infrastructure ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:data-pipeline ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:relatedTo ngm:microservices-architecture,
        ngm:model-architecture ;
    vc:requires ngm:distributed-systems,
        ngm:edge-computing ;
    vc:slug "system-architecture" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:transformers a owl:Class ;
