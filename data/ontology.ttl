ngm:raw-data a owl:Class ;
    rdfs:comment "Raw data is unprocessed information as originally collected from a source, before cleaning, transformation, aggregation or annotation. It may be noisy, inconsistent, redundant or incomplete, and typically lacks the structure and quality guarantees of processed data. Raw data forms the input to data pipelines, where it is ingested, validated and transformed into usable, analysis-ready forms."@en ;
    rdfs:label "Raw Data"@en ;
    rdfs:subClassOf ngm:data ;
    rdfs:subClassOf _:r17659 ;
