ngm:json-data-interchange-format-ld a owl:Class ;
    rdfs:label "JSON-LD"@en ;
    rdfs:comment "JSON-LD (JSON for Linking Data) is a W3C Recommendation (first published 2014, revised 1.1 in 2020) that defines a lightweight Linked Data serialisation syntax layered on top of JSON. A @context document maps compact JSON keys to full RDF IRIs, enabling any conformant JSON document to be interpreted as an RDF graph without abandoning existing JSON tooling. JSON-LD is the canonical syntax for W3C Verifiable Credentials, Schema.org structured data embedded in HTML, and the ActivityPub social protocol, making it the most widely deployed Linked Data technology on the open web."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:iri ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:json-data-interchange-format ],
        ngm:linked-data ;
    vc:bridgesTo ngm:decentralised-identity,
        ngm:search-engine-optimisation ;
    vc:contrastsWith ngm:json-data-interchange-format-schema,
        ngm:rdf-xml,
        ngm:turtle ;
    vc:enables ngm:data-integrity,
        ngm:knowledge-graph,
        ngm:ontology,
        ngm:structured-data,
        ngm:verifiable-credentials ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:implements ngm:linked-data,
        ngm:rdf,
        ngm:semantic-web-linked-data-standard ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:activity-pub,
        ngm:owl,
        ngm:shacl,
        ngm:sparql ;
    vc:requires ngm:iri,
        ngm:json-data-interchange-format ;
    vc:slug "json-ld" ;
    vc:sourceDomain "data" ;
    vc:standardizedBy ngm:w3-c ;
    vc:uses ngm:n-quads,
        ngm:schema-org .

ngm:multimodal-ai-architecture-ai a owl:Class ;
    rdfs:label "Multimodal AI"@en ;
    rdfs:comment "Multimodal AI refers to machine learning systems that process and integrate information from multiple data modalities — including text, images, audio, and video — simultaneously to produce contextually richer outputs than single-modality systems. These architectures employ specialised neural network fusion techniques to replicate the human brain's capacity to synthesise diverse sensory inputs, enabling applications in healthcare diagnostics, human-computer interaction, and cross-modal content generation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:computer-vision ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:multimodal-ai-architecture-understanding ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:speech-recognition ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:natural-language-processing ],
        ngm:ai-research-area ;
    skos:broader ngm:ai-research-area ;
    vc:enables ngm:generative-ai,
        ngm:image-generation,
        ngm:text-to-image ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:computer-vision,
        ngm:multimodal-ai-architecture-understanding,
        ngm:natural-language-processing,
        ngm:speech-recognition ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:large-language-models,
        ngm:sensor-fusion ;
    vc:slug "multimodal-ai" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:deep-learning,
        ngm:feature-extraction,
        ngm:neural-network,
        ngm:transformer-architecture .

ngm:named-entity-recognition a owl:Class ;
    rdfs:label "Named Entity Recognition"@en ;
    rdfs:comment "Named Entity Recognition (NER) is the NLP task of identifying and classifying named entities (persons, organisations, locations, dates, quantities) within unstructured text into predefined categories. NER systems employ transformer-based models (BERT, RoBERTa) with sequence labelling architectures (CRF, BiLSTM-CRF) to extract structured information from documents."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:sequence-labelling ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:word-embedding ],
        ngm:natural-language-processing ;
    vc:bridgesTo ngm:knowledge-graph ;
    vc:contrastsWith ngm:coreference-resolution,
        ngm:text-classification ;
    vc:dependsOn ngm:part-of-speech-tagging,
        ngm:tokenization ;
    vc:enables ngm:event-extraction,
        ngm:information-retrieval,
        ngm:knowledge-graph-construction,
        ngm:question-answering,
        ngm:relation-extraction,
        ngm:semantic-search ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:information-extraction,
        ngm:natural-language-processing ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:entity-linking,
        ngm:knowledge-base ;
    vc:requires ngm:sequence-labelling,
        ngm:word-embedding ;
    vc:slug "named-entity-recognition" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:bert,
        ngm:conditional-random-field,
        ngm:encoder,
        ngm:ro-berta,
        ngm:transformer-architecture .

ngm:quorum a owl:Class ;
    rdfs:label "Quorum"@en ;
    rdfs:comment "A quorum is the minimum number or proportion of participants—nodes, validators, voters, or signers—that must concur or be present for a decision, transaction, or consensus round to be considered valid in a distributed system or governance process. In distributed computing, quorum systems are collections of node subsets with the intersection property: any two quorums share at least one member, preventing contradictory decisions across network partitions. In blockchain and DAO governance, quorum thresholds set the participation floor required before a vote or proposal carries binding weight, balancing decision liveness against resistance to minority capture. Threshold signature schemes and multi-signature wallets operationalise quorum as an m-of-n approval requirement that eliminates single points of failure in key custody."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:validator-set ],
        ngm:consensus-mechanism ;
    vc:bridgesTo ngm:distributed-ai-training,
        ngm:federated-learning ;
    vc:contrastsWith ngm:longest-chain-rule,
        ngm:proof-of-work ;
    vc:enables ngm:decentralised-decision-making,
        ngm:fault-tolerance,
        ngm:linearisability,
        ngm:on-chain-governance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:paxos,
        ngm:raft,
        ngm:tendermint ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:byzantine-fault-tolerance,
        ngm:consensus-algorithm,
        ngm:distributed-system,
        ngm:liveness,
        ngm:network-partition,
        ngm:safety ;
    vc:requires ngm:validator-set ;
    vc:slug "quorum" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:blockchain-governance,
        ngm:dao-governance,
        ngm:multi-signature-wallet,
        ngm:treasury-management ;
    vc:uses ngm:consensus-protocol,
        ngm:threshold-signature-scheme,
        ngm:token-weighted-voting,
        ngm:voting-mechanism .

ngm:stakeholder-engagement a owl:Class ;
    rdfs:label "Stakeholder Engagement"@en ;
    rdfs:comment "Stakeholder Engagement is the structured process through which organisations identify, communicate with, and incorporate the perspectives of individuals and groups who have interests in or are affected by a project, system, or policy. Effective engagement moves along a spectrum from one-way information provision through consultation to active co-design and ongoing collaborative governance. In the context of emerging technologies such as AI, robust stakeholder engagement is recognised as essential for identifying ethical risks, ensuring societal legitimacy, and building the trust necessary for adoption. Regulatory frameworks and voluntary standards increasingly mandate evidence of meaningful stakeholder engagement as a condition of approval or certification."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:transparency ],
        ngm:infra-legal-and-regulatory ;
    skos:broader ngm:infra-legal-and-regulatory ;
    vc:bridgesTo ngm:ai-alignment,
        ngm:distributed-collaboration ;
    vc:enables ngm:ai-governance-framework,
        ngm:change-management,
        ngm:co-design,
        ngm:collaborative-systems-modality-design,
        ngm:legitimacy,
        ngm:trust-building ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:civic-participation,
        ngm:community-governance,
        ngm:deliberative-democracy,
        ngm:democratic-participation,
        ngm:participatory-design,
        ngm:stakeholder-engagement-in-ai ;
    vc:requires ngm:stakeholder-mapping,
        ngm:transparency ;
    vc:slug "stakeholder-engagement" ;
    vc:sourceDomain "governance" ;
    vc:standardizedBy ngm:oecd-ai-principles ;
    vc:supports ngm:ethical-ai,
        ngm:human-rights-impact-assessment ;
    vc:uses ngm:ai-impact-assessment,
        ngm:digital-citizens-assembly,
        ngm:risk-assessment .

ngm:biometric-authentication a owl:Class ;
    rdfs:label "Biometric Authentication"@en ;
    rdfs:comment "Biometric authentication is an identity verification method that uses measurable, unique physiological or behavioural characteristics of an individual — such as fingerprints, facial geometry, iris patterns, voice, or behavioural signals like keystroke dynamics — to confirm the claimed identity of a subject. Unlike password-based or token-based mechanisms, biometric credentials are inherent to the individual and cannot be forgotten, shared, or easily replicated, though they introduce irreversibility concerns because compromised biometric data cannot be reset. A complete system comprises enrolment, secure template storage (typically on-device in a secure enclave), a matching engine evaluated by false acceptance rate and false rejection rate, and presentation attack detection to counter spoofing. Biometric authentication underpins modern identity assurance frameworks such as FIDO2/WebAuthn, eIDAS 2.0 digital identity wallets, and biometric border control systems worldwide."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-protection ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:privacy-by-design ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:hardware-security-module ],
        ngm:authentication ;
    vc:bridgesTo ngm:machine-learning,
        ngm:on-device-inference ;
    vc:contrastsWith ngm:password-authentication ;
    vc:enables ngm:continuous-authentication,
        ngm:digital-identity-verification,
        ngm:multi-factor-authentication,
        ngm:passwordless-authentication,
        ngm:zero-trust-architecture ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:fido2,
        ngm:web-authn ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:facial-recognition,
        ngm:gdpr,
        ngm:identity-management,
        ngm:self-sovereign-identity ;
    vc:requires ngm:data-protection,
        ngm:hardware-security-module,
        ngm:privacy-by-design ;
    vc:slug "biometric-authentication" ;
    vc:sourceDomain "security" ;
    vc:uses ngm:biometric-binding-mechanism,
        ngm:biometric-verification,
        ngm:feature-extraction,
        ngm:presentation-attack-detection,
        ngm:secure-enclave .

ngm:camera a owl:Class ;
    rdfs:label "Camera"@en ;
    rdfs:comment "An imaging sensor device that captures visual information in robotics and spatial-computing systems, enabling computer vision applications including object detection, SLAM, 3D reconstruction, visual servoing, and semantic scene understanding through various modalities (RGB, depth, thermal, event-based) and sensor technologies (CCD, CMOS, ToF, structured light)."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:image-sensor ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:camera-calibration ],
        ngm:sensor ;
    vc:bridgesTo ngm:augmented-reality,
        ngm:digital-twin,
        ngm:spatial-computing ;
    vc:contrastsWith ngm:lidar,
        ngm:radar ;
    vc:dependsOn ngm:computer-vision ;
    vc:enables ngm:3-d-reconstruction,
        ngm:depth-estimation,
        ngm:object-detection,
        ngm:semantic-segmentation,
        ngm:slam,
        ngm:visual-odometry,
        ngm:visual-servoing ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:camera-calibration,
        ngm:image-sensor,
        ngm:lens ;
    vc:implements ngm:visual-perception ;
    vc:isPartOf ngm:robot-perception ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:neural-radiance-field,
        ngm:structure-from-motion ;
    vc:requires ngm:optics ;
    vc:slug "camera" ;
    vc:sourceDomain "robotics" ;
    vc:standardizedBy ngm:ieee,
        ngm:iso-iec ;
    vc:uses ngm:convolutional-neural-network .

ngm:carbon-credits a owl:Class ;
    rdfs:label "Carbon Credits"@en ;
    rdfs:comment "Carbon credits are tradeable instruments, each representing the verified reduction or removal of one tonne of carbon dioxide equivalent (tCO₂e) from the atmosphere, used in both compliance and voluntary markets to incentivise greenhouse gas mitigation. In compliance cap-and-trade systems, regulators issue a capped total of allowances and require regulated emitters to surrender one allowance per tonne emitted, creating a price signal for abatement. Voluntary carbon markets allow organisations to purchase credits from validated offset projects — such as reforestation, renewable energy deployment, or methane capture — to offset residual emissions. Market integrity depends on independently certified additionality, permanence, and measurability, overseen by standards bodies such as Verra, Gold Standard, and the American Carbon Registry."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:carbon-registry ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:additionality ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:carbon-offset ],
        ngm:infra-legal-and-regulatory ;
    skos:broader ngm:infra-legal-and-regulatory ;
    vc:bridgesTo ngm:blockchain-tokenisation,
        ngm:decentralised-finance,
        ngm:smart-contract ;
    vc:contrastsWith ngm:carbon-tax,
        ngm:direct-air-capture ;
    vc:dependsOn ngm:greenhouse-gas-protocol,
        ngm:third-party-verification ;
    vc:enables ngm:carbon-accounting,
        ngm:carbon-credit-token,
        ngm:net-zero-targets,
        ngm:scope-3-emissions ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:carbon-allowance,
        ngm:carbon-offset,
        ngm:verified-emission-reduction ;
    vc:isPartOf ngm:carbon-markets,
        ngm:emissions-trading-scheme ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:carbon-offset-trading,
        ngm:esg-investing ;
    vc:requires ngm:additionality,
        ngm:carbon-registry,
        ngm:measurement-reporting-verification ;
    vc:slug "carbon-credits" ;
    vc:sourceDomain "finance" ;
    vc:standardizedBy ngm:gold-standard,
        ngm:paris-agreement-article-6,
        ngm:verified-carbon-standard ;
    vc:supports ngm:corporate-sustainability-reporting,
        ngm:environmental-accounting,
        ngm:paris-agreement ;
    vc:uses ngm:io-t-sensors,
        ngm:remote-sensing,
        ngm:satellite-monitoring .

ngm:compiler a owl:Class ;
    rdfs:label "Compiler"@en ;
    rdfs:comment "A software system that translates source code written in a high-level programming language into a lower-level representation — typically machine code, bytecode, or an intermediate representation — performing lexical analysis, syntactic parsing, semantic checking, optimisation, and code emission in a structured pipeline. Compilers are foundational to software development, enabling human-readable programs to run efficiently on hardware."@en ;
    rdfs:subClassOf ngm:software-development ;
    vc:enables ngm:code-generation,
        ngm:runtime-environment ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:onnx-runtime,
        ngm:opcodes ;
    vc:slug "compiler" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:ai-augmented-software-engineering ;
    vc:uses ngm:programming-language .

ngm:cross-validation a owl:Class ;
    rdfs:label "Cross-Validation"@en ;
    rdfs:comment "Cross-validation is a statistical resampling technique for evaluating machine learning model performance by partitioning available data into complementary training and validation subsets, training the model on each partition in turn, and averaging the resulting error estimates. It provides a less optimistic and more generalisable estimate of out-of-sample predictive performance than a single train–test split."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:resampling ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:labelled-dataset ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:sampling ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:performance-metrics ],
        ngm:model-evaluation ;
    vc:bridgesTo ngm:data-governance,
        ngm:statistical-inference ;
    vc:contrastsWith ngm:annotated-training-data,
        ngm:holdout-validation ;
    vc:dependsOn ngm:statistical-estimation,
        ngm:statistical-learning-theory ;
    vc:enables ngm:bias-variance-tradeoff,
        ngm:feature-selection,
        ngm:hyperparameter-tuning,
        ngm:model-comparison ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:k-fold,
        ngm:leave-one-out,
        ngm:nested-cv,
        ngm:sampling ;
    vc:isPartOf ngm:applied-machine-learning,
        ngm:model-selection ;
    vc:qualityScore "0.9"^^xsd:float ;
    vc:relatedTo ngm:bayesian-optimisation,
        ngm:benign-overfitting,
        ngm:data-augmentation,
        ngm:ensemble-methods,
        ngm:regularisation ;
    vc:requires ngm:labelled-dataset,
        ngm:performance-metrics,
        ngm:resampling ;
    vc:slug "cross-validation" ;
    vc:sourceDomain "machine-learning" ;
    vc:supports ngm:applied-machine-learning,
        ngm:automl,
        ngm:model-comparison,
        ngm:overfitting-prevention ;
    vc:uses ngm:loss-function,
        ngm:performance-metrics .

ngm:decision-making a owl:Class ;
    rdfs:label "Decision Making"@en ;
    rdfs:comment "Decision making is the cognitive and computational process of selecting a course of action from a set of available alternatives by evaluating options against objectives, constraints, and uncertainty. It spans normative models of rational choice (expected utility, Bayesian reasoning), descriptive behavioural accounts that document systematic biases, and computational frameworks such as Markov Decision Processes and reinforcement learning that formalise sequential choice under uncertainty. In artificial intelligence, decision making underpins agent planning, autonomous systems, and large-scale optimisation, bridging probability theory, control theory, and game theory into operational policies."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:value-function ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:markov-decision-process ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:bayesian-inference ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:objective-function ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:knowledge-representation ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:utility-theory ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:probability-theory ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:uncertainty-quantification ],
        ngm:ai-research-area ;
    skos:broader ngm:ai-research-area ;
    vc:bridgesTo ngm:risk-management,
        ngm:supply-chain-management ;
    vc:contrastsWith ngm:behavioural-economics,
        ngm:bounded-rationality ;
    vc:dependsOn ngm:decision-theory,
        ngm:game-theory,
        ngm:optimisation,
        ngm:probability-theory ;
    vc:enables ngm:autonomous-agent,
        ngm:governance,
        ngm:planning,
        ngm:policy-optimisation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:bayesian-inference,
        ngm:heuristics,
        ngm:markov-decision-process,
        ngm:multi-criteria-decision-analysis,
        ngm:utility-theory,
        ngm:value-function ;
    vc:qualityScore "0.9"^^xsd:float ;
    vc:relatedTo ngm:cognitive-science,
        ngm:control-theory,
        ngm:natural-language-processing,
        ngm:operations-research,
        ngm:spatial-computing ;
    vc:requires ngm:knowledge-representation,
        ngm:objective-function,
        ngm:probability-theory,
        ngm:uncertainty-quantification ;
    vc:slug "decision-making" ;
    vc:sourceDomain "ai" ;
    vc:supports ngm:ai-ethics,
        ngm:ai-safety-research,
        ngm:risk-assessment ;
    vc:uses ngm:deep-learning,
        ngm:machine-learning,
        ngm:neural-network,
        ngm:reinforcement-learning .

ngm:federated-identity a owl:Class ;
    rdfs:label "Federated Identity"@en ;
    rdfs:comment "Federated Identity is an architectural paradigm in which a user authenticates once with a trusted Identity Provider and receives a signed assertion that is accepted by multiple independent relying-party services across organisational or administrative boundaries, eliminating per-service credential stores. The federation relationship is governed by bilateral or multilateral trust agreements and implemented through standard protocols such as SAML 2.0, OpenID Connect, and OAuth 2.0, which define how authentication tokens are issued, transported, and cryptographically verified. Federated identity is foundational to enterprise single sign-on, cross-institutional academic collaboration, and consumer social-login ecosystems, and is actively converging with decentralised-identity models that replace central providers with holder-controlled cryptographic credentials."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:identity-provider ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:authentication-standards ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:trust-framework ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:digital-certificate ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:public-key-infrastructure ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:provider ],
        ngm:identity-management ;
    vc:bridgesTo ngm:decentralized-identity,
        ngm:self-sovereign-identity,
        ngm:verifiable-credentials ;
    vc:contrastsWith ngm:centralised-identity,
        ngm:siloed-identity ;
    vc:enables ngm:cross-domain-authentication,
        ngm:delegated-authorisation,
        ngm:single-sign-on,
        ngm:zero-trust-architecture ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:identity-provider,
        ngm:provider,
        ngm:trust-framework ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:directory-service,
        ngm:privileged-access-management,
        ngm:scim ;
    vc:requires ngm:authentication-standards,
        ngm:digital-certificate,
        ngm:public-key-infrastructure ;
    vc:slug "federated-identity" ;
    vc:sourceDomain "security" ;
    vc:standardizedBy ngm:ietf,
        ngm:oasis-standards,
        ngm:open-id-foundation ;
    vc:supports ngm:access-control,
        ngm:multi-factor-authentication,
        ngm:session-management,
        ngm:user-provisioning ;
    vc:uses ngm:cryptographic-signature,
        ngm:json-data-interchange-format-web-token,
        ngm:oauth-2-0,
        ngm:open-id-connect,
        ngm:saml .

