ngm:ssl-termination a owl:Class ;
    rdfs:label "Ssl Termination"@en ;
    rdfs:comment "SSL termination is the practice of decrypting inbound TLS-encrypted traffic at a dedicated network endpoint, typically a reverse proxy or load balancer, before forwarding the now-plaintext requests to backend servers. By centralising the cryptographic handshake and certificate management at the edge, it offloads CPU-intensive encryption work from application servers and simplifies certificate lifecycle administration. The terminating node holds the private keys and performs the handshake, then routes traffic over the internal network. It is a foundational pattern in modern web infrastructure, often paired with re-encryption to backends for end-to-end security."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:tls ],
        ngm:reverse-proxy ;
    vc:enables ngm:http ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:tls ;
    vc:implements ngm:network-security ;
    vc:isPartOf ngm:load-balancer,
        ngm:reverse-proxy ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:caching,
        ngm:content-delivery-network,
        ngm:edge-computing,
        ngm:http,
        ngm:load-balancer ;
    vc:slug "ssl-termination" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:infrastructure ;
    vc:uses ngm:cryptography,
        ngm:tls,
        ngm:transport-layer-security .

ngm:stability a owl:Class ;
    rdfs:label "Stability"@en ;
    rdfs:comment "Stability is the property of a dynamical or control system whereby its state remains bounded and returns toward an equilibrium following a disturbance, rather than diverging. Formalised through notions such as Lyapunov stability and bounded-input bounded-output stability, it is a primary design objective for any feedback controller. Ensuring stability is prerequisite to performance, since an unstable system cannot be made to track references reliably."@en ;
    rdfs:subClassOf ngm:control-theory ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:feedback-loop,
        ngm:robo-actuation-and-control ;
    vc:slug "stability" ;
    vc:sourceDomain "robotics" .

ngm:stable-diffusion a skos:Concept ;
    rdfs:label "Stable Diffusion"@en .

ngm:stack-machine a owl:Class ;
    rdfs:label "Stack Machine"@en ;
    rdfs:comment "A stack machine is an execution model in which operands and intermediate results are held on a last-in-first-out stack rather than in named registers, with instructions implicitly consuming their inputs from the top of the stack and pushing their outputs back onto it. The model yields compact, position-independent bytecode and a simple deterministic evaluator, which is why it underpins many scripting languages and blockchain virtual machines such as Bitcoin Script and the Ethereum Virtual Machine."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:bytecode ],
        ngm:execution-model ;
    vc:bridgesTo ngm:virtual-machine ;
    vc:contrastsWith ngm:virtual-machine ;
    vc:dependsOn ngm:execution-model ;
    vc:enables ngm:bitcoin-script,
        ngm:ethereum-virtual-machine ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:execution-model ;
    vc:isPartOf ngm:virtual-machine ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:bitcoin,
        ngm:taproot ;
    vc:requires ngm:bytecode ;
    vc:slug "stack-machine" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:script ;
    vc:uses ngm:bytecode .

ngm:stacks a owl:Class ;
    rdfs:label "Stacks"@en ;
    rdfs:comment "A Bitcoin Layer that enables smart contracts and applications whose state is anchored to the Bitcoin blockchain through its proof-of-transfer consensus."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
