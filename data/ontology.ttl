ngm:node-based-editor a owl:Class ;
    rdfs:label "Node Based Editor"@en ;
    rdfs:comment "A visual authoring tool that represents computational logic, material properties, or content workflows as directed graphs of interconnected nodes and edges, enabling non-linear dataflow programming. Node-based editors are widely used in game engines, VFX pipelines, and spatial computing tools for shader authoring, procedural geometry generation, and real-time behaviour scripting."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:user-interface ],
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:enables ngm:procedural-generation,
        ngm:world-building ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:user-interface ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:slug "node-based-editor" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:3-d-asset,
        ngm:rendering-engine ;
    vc:uses ngm:game-engine,
        ngm:shader .

ngm:node-based-interface a skos:Concept ;
    rdfs:label "Node Based Interface"@en .

ngm:node-based-visual-interfaces a owl:Class ;
    rdfs:label "Node based visual interfaces"@en ;
    rdfs:comment "A paradigm of graphical programming in which computational logic is authored by connecting discrete functional nodes via edges rather than writing textual code. Node-based interfaces lower the barrier to complex workflow construction, making them prevalent in AI pipeline tools (e.g., ComfyUI, Flowise), creative software (shader editors, compositing), and knowledge-graph visualisation environments."@en ;
    rdfs:subClassOf ngm:infra-software-engineering,
        ngm:user-interface ;
    skos:broader ngm:infra-software-engineering ;
    vc:enables ngm:knowledge-graph,
        ngm:workflow-automation ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:knowledge-graph-construction ;
    vc:slug "node-based-visual-interfaces" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:user-interface-architecture ;
    vc:uses ngm:data-visualisation .

