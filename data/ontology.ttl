    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:ethereum-smart-contract-platform ;
    vc:slug "erc-20-votes" ;
    vc:sourceDomain "standards" .

ngm:erc-3643 a owl:Class ;
    rdfs:label "ERC-3643"@en ;
    rdfs:comment "ERC-3643 is an Ethereum token standard, also known as T-REX (Token for Regulated EXchanges), that enables the issuance and management of permissioned security tokens on public blockchain infrastructure. It embeds on-chain identity verification and compliance rule enforcement into the token transfer logic, ensuring that only verified, eligible investors can hold and transfer regulated digital assets. The standard extends ERC-20 with an identity registry, modular compliance modules, and claim-based permissioning, making it suitable for tokenised securities, real-world assets, and other regulated financial instruments. ERC-3643 was standardised through the Ethereum Improvement Proposal process and has been adopted by multiple institutional asset tokenisation platforms."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:decentralised-identity ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:kyc ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ethereum ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:smart-contract ],
        ngm:token-standard ;
    vc:bridgesTo ngm:financial-regulation,
        ngm:self-sovereign-identity ;
    vc:contrastsWith ngm:erc-1400,
        ngm:erc-20 ;
    vc:enables ngm:asset-tokenisation,
        ngm:regulatory-compliance,
        ngm:security-token ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:erc-20,
        ngm:erc-735 ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:aml-kyc-compliance,
        ngm:decentralised-finance,
        ngm:digital-securities,
        ngm:real-world-asset-tokenisation ;
    vc:requires ngm:decentralised-identity,
        ngm:ethereum,
        ngm:kyc,
        ngm:smart-contract ;
    vc:slug "erc-3643" ;
    vc:sourceDomain "blockchain" ;
    vc:standardizedBy ngm:ethereum-improvement-proposal ;
    vc:uses ngm:compliance,
        ngm:identity-registry,
        ngm:on-chain-identity .

ngm:erc1155-standard a owl:Class ;
    rdfs:label "ERC1155 Standard"@en ;
    rdfs:comment "Multi-token standard supporting both fungible and non-fungible tokens in a single contract."@en ;
    rdfs:subClassOf ngm:bc-token-and-asset ;
    skos:broader ngm:bc-token-and-asset ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:smart-contract-platform ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:slug "erc1155-standard" ;
    vc:sourceDomain "blockchain" .

ngm:erc20-votes-standard a owl:Class ;
    rdfs:label "ERC20Votes Standard"@en ;
    rdfs:comment "ERC20Votes is an extension of the ERC-20 fungible-token standard that adds on-chain governance capabilities by tracking historical voting power through checkpointed balances and supporting delegation of votes. It records a snapshot of each account's balance at every block where it changes, so a governance contract can query voting weight at a specific past block, preventing double-voting and flash-loan manipulation. Implemented in widely audited libraries, it is the dominant pattern for token-based voting in decentralised autonomous organisations."@en ;
    rdfs:subClassOf ngm:erc20-standard ;
    vc:enables ngm:dao ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:erc-20-votes,
        ngm:ethereum-smart-contract-platform ;
    vc:slug "erc20-votes-standard" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:smart-contract .

ngm:error-handling a owl:Class ;
    rdfs:label "Error Handling"@en ;
    rdfs:comment "Error Handling is the set of mechanisms, patterns, and strategies in software and systems design for detecting, reporting, and recovering from anomalous conditions that deviate from expected operation. It encompasses exception mechanisms, error codes, retry logic, circuit breakers, fallback strategies, and graceful degradation. Robust error handling is essential to system reliability, security, and maintainability, and is a prerequisite for fault-tolerant distributed systems."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:observability ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:circuit-breaker ],
        ngm:infrastructure ;
    skos:broader ngm:infrastructure ;
    vc:bridgesTo ngm:distributed-systems ;
    vc:contrastsWith ngm:happy-path ;
    vc:dependsOn ngm:programming-language ;
    vc:enables ngm:graceful-degradation,
        ngm:resilience ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:circuit-breaker,
        ngm:exception-handling,
        ngm:retry-logic ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:debugging,
        ngm:software-engineering,
        ngm:testing ;
    vc:requires ngm:logging,
        ngm:observability ;
    vc:slug "error-handling" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:fault-tolerance,
        ngm:reliability,
        ngm:security .

ngm:ethereum-account a owl:Class ;
    rdfs:label "Ethereum Account"@en ;
    rdfs:comment "An Ethereum account is a state entity on the Ethereum blockchain identified by a 20-byte address and holding a balance, nonce, and optionally code and storage. There are two kinds: externally owned accounts controlled by a private key, and contract accounts controlled by their deployed smart-contract code. Accounts are the unit against which transactions are debited, gas is charged, and state transitions are applied."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:private-key ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gas ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:nonce ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:address ],
        ngm:ethereum ;
    vc:bridgesTo ngm:account-abstraction ;
    vc:dependsOn ngm:blockchain ;
    vc:enables ngm:smart-contract,
        ngm:transaction ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:nonce ;
    vc:isPartOf ngm:ethereum,
        ngm:ledger ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:cryptocurrency,
        ngm:proof-of-stake,
        ngm:wallet ;
    vc:requires ngm:address,
        ngm:gas,
        ngm:private-key ;
    vc:slug "ethereum-account" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:ecdsa,
        ngm:key-management .

ngm:etsi-domain-security-and-privacy a owl:Class ;
    rdfs:label "ETSI Domain Security and Privacy"@en ;
    rdfs:comment "The ETSI Domain Security and Privacy is a governance framework protecting metaverse ecosystems through comprehensive controls spanning cryptography, access management, data governance, and compliance measures. It addresses threat surface mapping, post-quantum cryptographic resilience, privacy-enhancing computation, digital evidence chain of custody, and psychological profiling safeguards for users of immersive environments."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:zero-trust-architecture-zta ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:post-quantum-cryptography ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:privacy-impact-assessment ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:threat-surface-map ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:privacy-enhancing-computation-pec ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:security-layer ],
        ngm:metaverse-governance-and-safeguarding,
        ngm:sc-governance-and-safety ;
    skos:broader ngm:sc-governance-and-safety ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:post-quantum-cryptography,
        ngm:privacy-impact-assessment,
        ngm:security-layer,
        ngm:threat-surface-map ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:digital-evidence-chain-of-custody,
        ngm:etsi-domain-identity-and-trust ;
    vc:requires ngm:privacy-enhancing-computation-pec,
        ngm:zero-trust-architecture-zta ;
    vc:slug "etsi-domain-security-and-privacy" ;
    vc:sourceDomain "spatial-computing" .

ngm:european-parliament a owl:Class ;
    rdfs:label "European Parliament"@en ;
    rdfs:comment "The European Parliament is the directly elected legislative body of the European Union, sharing law-making and budgetary authority with the Council of the EU. It debates, amends, and adopts EU legislation across domains including financial regulation, data protection, AI, and digital-currency policy. As a co-legislator it is a primary source of the binding rules that shape technology governance across member states."@en ;
    rdfs:subClassOf ngm:standards-body ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:compliance-control,
        ngm:digital-euro ;
    vc:slug "european-parliament" ;
    vc:sourceDomain "governance" .

ngm:event-management a owl:Class ;
    rdfs:label "Event Management"@en ;
    rdfs:comment "The planning, coordination, technical orchestration, and delivery of virtual or hybrid events within spatial computing and metaverse platforms, encompassing scheduling, access control, audience management, live streaming, and post-event analytics for concerts, conferences, and social gatherings."@en ;
    rdfs:subClassOf ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:enables ngm:virtual-concerts,
        ngm:virtual-event ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:access-control,
        ngm:metaverse-venue,
        ngm:virtual-location ;
    vc:slug "event-management" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:virtual-community-platform,
        ngm:virtual-event-platform .

ngm:evidence-lower-bound a owl:Class ;
    rdfs:label "Evidence Lower Bound"@en ;
    rdfs:comment "The evidence lower bound (ELBO) is a tractable lower bound on the log marginal likelihood of observed data under a probabilistic model with latent variables. Maximising the ELBO is equivalent to minimising the divergence between an approximate posterior and the true posterior, making intractable inference tractable. It is the training objective of variational autoencoders and a cornerstone of variational inference."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:probabilistic-model ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:objective-function ],
        ngm:variational-inference ;
    vc:bridgesTo ngm:bayesian-inference ;
    vc:contrastsWith ngm:expectation-maximisation ;
    vc:enables ngm:variational-autoencoder ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:variational-inference ;
    vc:isPartOf ngm:variational-inference ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:gradient-descent,
        ngm:loss-function,
        ngm:stochastic-gradient-descent ;
    vc:requires ngm:objective-function,
        ngm:probabilistic-model ;
    vc:slug "evidence-lower-bound" ;
    vc:sourceDomain "machine-learning" ;
    vc:supports ngm:variational-autoencoder ;
    vc:uses ngm:bayesian-inference,
        ngm:posterior-distribution .

ngm:exchange-traded-fund a owl:Class ;
    rdfs:label "Exchange-Traded Fund"@en ;
    rdfs:comment "An exchange-traded fund (ETF) is a pooled investment vehicle whose shares trade on a stock exchange throughout the day at market prices. It typically tracks an index, asset, or basket of assets and uses a create-redeem mechanism with authorised participants to keep its price close to net asset value. ETFs combine the diversification of funds with the intraday liquidity and accessibility of listed securities."@en ;
    rdfs:subClassOf ngm:digital-asset ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:bitcoin-proof-of-work-protocol-etf,
        ngm:spot-bitcoin-etf ;
    vc:slug "exchange-traded-fund" ;
    vc:sourceDomain "blockchain" .

ngm:executive-sponsorship a owl:Class ;
    rdfs:label "Executive Sponsorship"@en ;
    rdfs:comment "Executive sponsorship is the active, visible backing of a major initiative by a senior leader who secures funding, removes organisational obstacles, and aligns the effort with strategy. It is widely identified as a critical success factor in technology adoption and transformation programmes because it confers authority, accountability, and resource commitment. Without credible executive sponsorship, large-scale initiatives commonly stall amid competing priorities."@en ;
    rdfs:subClassOf ngm:governance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:adoption-of-convergent-technologies,
        ngm:ai-adoption ;
    vc:slug "executive-sponsorship" ;
    vc:sourceDomain "governance" .

ngm:exploration-exploitation-tradeoff a owl:Class ;
    rdfs:label "Exploration Exploitation Tradeoff"@en ;
    rdfs:comment "The exploration-exploitation tradeoff is the fundamental dilemma faced by a learning agent that must choose between exploiting known rewarding actions and exploring uncertain actions that may yield greater long-term return. Over-exploitation locks the agent into suboptimal behaviour, while over-exploration squanders opportunity on unrewarding choices. Balancing the two is central to reinforcement learning, multi-armed bandit problems and sequential decision making, with strategies ranging from epsilon-greedy selection to upper confidence bounds and posterior sampling."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:markov-decision-process ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:reward-function ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:active-learning ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:value-function ],
        ngm:decision-making,
        ngm:reinforcement-learning ;
    vc:contrastsWith ngm:greedy-algorithm,
        ngm:supervised-learning ;
    vc:enables ngm:autonomous-navigation,
        ngm:decision-making,
        ngm:recommendation-system,
        ngm:regret-minimisation,
        ngm:robotic-control ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:active-learning,
        ngm:curiosity-driven-exploration,
        ngm:epsilon-greedy,
        ngm:intrinsic-motivation,
        ngm:thompson-sampling,
        ngm:upper-confidence-bound ;
    vc:implements ngm:bayesian-optimisation,
        ngm:monte-carlo-tree-search,
        ngm:policy-gradient-methods,
        ngm:q-learning ;
    vc:isPartOf ngm:decision-making,
        ngm:machine-learning,
        ngm:reinforcement-learning ;
    vc:qualityScore "0.9"^^xsd:float ;
    vc:relatedTo ngm:artificial-intelligence,
        ngm:machine-learning,
        ngm:stochastic-gradient-descent ;
    vc:requires ngm:markov-decision-process,
        ngm:reward-function,
        ngm:value-function ;
    vc:slug "exploration-exploitation-tradeoff" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:deep-reinforcement-learning,
        ngm:large-language-models,
        ngm:multi-armed-bandit,
        ngm:reinforcement-learning ;
    vc:uses ngm:bellman-equation,
        ngm:information-theory,
        ngm:neural-network,
        ngm:temporal-difference-learning .

ngm:exponential-moving-average a owl:Class ;
    rdfs:label "Exponential Moving Average"@en ;
    rdfs:comment "An exponential moving average (EMA) is a weighted moving average that applies exponentially decreasing weights to successive observations in a time series, giving greater significance to recent data than to older data. It is computed recursively as a convex combination of the current observation and the previous EMA value, governed by a smoothing factor derived from a chosen window length. In blockchain and decentralised finance contexts the EMA is widely used to smooth on-chain price feeds, dampen oracle noise, and drive technical-analysis signals and adaptive parameters in automated trading and risk systems."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:statistical-analysis ],
        ngm:statistical-analysis ;
    vc:bridgesTo ngm:oracle ;
    vc:dependsOn ngm:time-series ;
    vc:enables ngm:algorithmic-trading,
        ngm:quantitative-finance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:time-series ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:algorithmic-trading,
        ngm:quantitative-finance,
        ngm:signal-processing ;
    vc:requires ngm:statistical-analysis ;
    vc:slug "exponential-moving-average" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:oracle,
        ngm:risk-management ;
    vc:uses ngm:signal-processing,
        ngm:time-series .

ngm:externally-owned-account a owl:Class ;
    rdfs:label "Externally Owned Account"@en ;
    rdfs:comment "An Externally Owned Account (EOA) is a type of Ethereum account controlled by a private key held outside the blockchain — typically by an end user via a wallet — as opposed to a contract account controlled by smart contract code. EOAs can initiate transactions, sign messages, and hold ether and tokens; they have no associated code. Every Ethereum transaction must originate from an EOA, making them the fundamental actor type in the Ethereum account model."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:encryption ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:public-key-cryptography ],
        ngm:blockchain-wallet ;
    vc:bridgesTo ngm:governance ;
    vc:contrastsWith ngm:blockchain-identity,
        ngm:smart-contract ;
    vc:dependsOn ngm:cryptography,
        ngm:security ;
    vc:enables ngm:finance,
        ngm:off-chain-governance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:blockchain-wallet ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:digital-identity,
        ngm:distributed-ledger ;
    vc:requires ngm:encryption,
        ngm:public-key-cryptography ;
    vc:slug "externally-owned-account" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:data-management ;
    vc:uses ngm:blockchain-identity,
        ngm:session-key .

ngm:facial-action-coding-system a owl:Class ;
    rdfs:label "Facial Action Coding System"@en ;
    rdfs:comment "The Facial Action Coding System (FACS) is a comprehensive, anatomically grounded taxonomy for objectively describing and encoding visible facial movements by decomposing expressions into discrete Action Units (AUs), each corresponding to the contraction of one or more specific facial muscles. Developed originally by Swedish anatomist Carl-Herman Hjortsjö and systematised by psychologists Paul Ekman and Wallace V. Friesen in 1978, FACS provides a muscle-based, observer-independent vocabulary for facial behaviour that separates objective biomechanical measurement from subjective emotional interpretation. It is the foundational measurement framework for automated Emotion Recognition, avatar facial animation, clinical pain and depression assessment, and affective computing research."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:face-recognition ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:feature-extraction ],
        ngm:affective-computing,
        ngm:computer-vision ;
    vc:contrastsWith ngm:categorical-emotion-model,
        ngm:dimensional-emotion-model ;
    vc:dependsOn ngm:annotated-dataset,
        ngm:face-recognition ;
    vc:enables ngm:affective-computing,
        ngm:avatar-animation,
        ngm:emotion-recognition,
        ngm:empathetic-ai,
        ngm:mental-health-monitoring,
        ngm:pain-assessment ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:action-unit,
        ngm:au-intensity-coding,
        ngm:au-occurrence-detection,
        ngm:facial-landmark-detection,
        ngm:facs-annotated-dataset ;
    vc:implements ngm:action-recognition,
        ngm:convolutional-neural-network,
        ngm:deep-learning ;
    vc:qualityScore "0.92"^^xsd:float ;
    vc:relatedTo ngm:cognitive-science,
        ngm:computer-vision,
        ngm:emotion-recognition,
        ngm:empathetic-ai,
        ngm:multimodal-ai,
        ngm:transfer-learning ;
    vc:requires ngm:annotated-dataset,
        ngm:face-recognition,
        ngm:facial-landmark-detection,
        ngm:feature-extraction ;
    vc:slug "facial-action-coding-system" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:driver-monitoring-system,
        ngm:human-computer-interaction,
        ngm:intelligent-tutoring-system,
        ngm:social-robotics .

ngm:failure-mode-and-effects-analysis a owl:Class ;
    rdfs:label "Failure Mode And Effects Analysis"@en ;
    rdfs:comment "Failure Mode and Effects Analysis (FMEA) is a systematic, bottom-up technique for identifying potential failure modes of a system, product, or process, assessing their causes and effects, and prioritising corrective action. Each failure mode is rated for severity, occurrence, and detectability, often combined into a risk priority number that ranks issues for mitigation. FMEA is widely used in safety, reliability, and quality engineering, and is a core analysis within functional-safety lifecycles defined by standards such as IEC 61508 and ISO 26262."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:risk-assessment ],
        ngm:reliability-engineering ;
    vc:contrastsWith ngm:fault-tree-analysis ;
    vc:dependsOn ngm:hazard-analysis,
        ngm:reliability-engineering ;
    vc:enables ngm:reliability-engineering ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:risk-assessment ;
    vc:isPartOf ngm:reliability-engineering ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:functional-safety,
        ngm:hazop,
        ngm:safety-instrumented-system ;
    vc:slug "failure-mode-and-effects-analysis" ;
    vc:sourceDomain "standards" ;
    vc:standardizedBy ngm:iec-61508,
        ngm:iso-26262 ;
    vc:supports ngm:functional-safety,
        ngm:safety-integrity-level,
        ngm:safety-lifecycle ;
    vc:uses ngm:risk-assessment .

ngm:fairness-oecd a owl:Class ;
    rdfs:label "Fairness (OECD)"@en ;
    rdfs:comment "The OECD AI Principle (1.2) requiring that AI systems do not create or reinforce unfair bias, discrimination, or disparate impacts on individuals or groups based on protected characteristics. Fairness mandates proactive safeguards—pre-processing reweighting, in-processing constraints, post-processing calibration—ensuring equitable treatment whilst respecting legitimate, evidence-based differentiation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ai-regulation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-governance ],
        ngm:ai-governance-and-ethics ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:contrastsWith ngm:ai-ethics ;
    vc:enables ngm:human-centred-values ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:accountability-oecd,
        ngm:digital-technology-access-equity,
        ngm:explainability-oecd ;
    vc:requires ngm:ai-regulation,
        ngm:data-governance ;
    vc:slug "fairness-oecd" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:fasb-asu-2023-08 a owl:Class ;
    rdfs:label "FASB ASU 2023-08"@en ;
    rdfs:comment "FASB Accounting Standards Update 2023-08 is a US accounting standard issued by the Financial Accounting Standards Board that requires public companies to measure certain cryptocurrency assets at fair value and recognise gains and losses in net income each reporting period. The standard applies to fungible crypto assets listed on active markets, effective for fiscal years beginning after 15 December 2024. It represents a significant departure from the previous indefinite-lived intangible asset treatment that suppressed recognised gains."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:fungible-token ],
        ngm:compliance-standards ;
    vc:bridgesTo ngm:blockchain,
        ngm:governance ;
    vc:contrastsWith ngm:mi-ca-regulation ;
    vc:enables ngm:compliance-monitoring,
        ngm:decision-making,
        ngm:financial-transparency,
        ngm:regulatory-reporting ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:bitcoin,
        ngm:cryptocurrency,
        ngm:digital-asset,
        ngm:digital-asset-standards,
        ngm:financial-regulation ;
    vc:requires ngm:fungible-token ;
    vc:slug "fasb-asu-2023-08" ;
    vc:sourceDomain "finance" ;
    vc:supports ngm:digital-asset-market,
        ngm:financial-services,
        ngm:financial-stability,
        ngm:institutional-adoption .

ngm:federated-edge-learning a owl:Class ;
    rdfs:label "Federated Edge Learning"@en ;
    rdfs:comment "Federated Edge Learning combines distributed machine learning with edge computing, enabling collaborative model training across decentralised edge devices while keeping training data locally on-device. Participants train local models on their private datasets and securely aggregate only model updates—rather than raw data—into a shared global model, preserving data sovereignty whilst enabling collective intelligence."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:federated-learning ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:model-training ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:edge-computing ],
        ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:enables ngm:differential-privacy,
        ngm:privacy-preserving-analytics ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:autonomous-robot,
        ngm:distributed-computing,
        ngm:machine-learning-discipline,
        ngm:privacy-utility-tradeoffs ;
    vc:requires ngm:edge-computing,
        ngm:federated-learning,
        ngm:model-training ;
    vc:slug "federated-edge-learning" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:edge-computing-node,
        ngm:gradient-descent,
        ngm:neural-network .

ngm:fee-tier a owl:Class ;
    rdfs:label "Fee Tier"@en ;
    rdfs:comment "A fee tier is a discrete level of trading or swap fee applied to a market or liquidity pool, allowing different markets to charge fees commensurate with their volatility and liquidity risk. On automated-market-maker decentralized exchanges, each pool is created under a chosen fee tier (for example 0.05%, 0.30%, or 1.00%), and the collected fees accrue to liquidity providers. Tiering lets stable pairs use low fees while volatile or exotic pairs use higher fees to compensate providers."@en ;
    rdfs:subClassOf ngm:bc-defi-and-economics ;
    skos:broader ngm:bc-defi-and-economics ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:decentralized-exchange,
        ngm:liquidity-provision ;
    vc:slug "fee-tier" ;
    vc:sourceDomain "blockchain" .

ngm:feedforward-control a owl:Class ;
    rdfs:label "Feedforward Control"@en ;
    rdfs:comment "Feedforward control is a control strategy in which the controller acts on a reference command or a measured disturbance before it affects the output, rather than reacting to output error after the fact. Because it does not rely on output measurement, pure feedforward cannot correct for unmodelled effects and is therefore usually paired with feedback. It is widely used in motion and process control to improve command tracking and pre-empt known disturbances."@en ;
    rdfs:subClassOf ngm:control-system ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:motion-control,
        ngm:velocity-control ;
    vc:slug "feedforward-control" ;
    vc:sourceDomain "robotics" .

ngm:feedforward-neural-network a owl:Class ;
    rdfs:label "Feedforward Neural Network"@en ;
    rdfs:comment "A neural network architecture in which connections between nodes do not form cycles, with information flowing unidirectionally from input through hidden layers to output. The simplest and most foundational artificial neural network type, trained via backpropagation with gradient descent, and proven by the universal approximation theorem to model arbitrary continuous functions given sufficient width."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:activation-function ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:backpropagation ],
        ngm:ai-model-architecture,
        ngm:network-architecture ;
    skos:broader ngm:ai-model-architecture ;
    vc:contrastsWith ngm:recurrent-neural-network,
        ngm:transformer-architecture ;
    vc:enables ngm:deep-learning,
        ngm:machine-learning-discipline ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:convolutional-neural-network ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:requires ngm:activation-function,
        ngm:backpropagation ;
    vc:slug "feedforward-neural-network" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:file-storage a owl:Class ;
    rdfs:label "File Storage"@en ;
    rdfs:comment "File storage is a storage model that organises data as named files within a hierarchical directory tree, accessed through file-system semantics such as open, read, write and seek. It presents a familiar path-based namespace and is typically shared over network protocols for concurrent access. File storage contrasts with block storage, which exposes raw volumes, and object storage, which uses a flat namespace of objects addressed by key."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:data-storage-layer ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:file-system ],
        ngm:storage-infrastructure ;
    vc:contrastsWith ngm:block-storage,
        ngm:object-storage ;
    vc:dependsOn ngm:data-storage-layer ;
    vc:enables ngm:backup ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:data-storage-layer,
        ngm:file-system ;
    vc:isPartOf ngm:storage-infrastructure ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:block-storage,
        ngm:cloud-storage,
        ngm:object-storage ;
    vc:slug "file-storage" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:cloud-storage,
        ngm:data-persistence ;
    vc:uses ngm:distributed-storage,
        ngm:file-system .

ngm:film-vfx a owl:Class ;
    rdfs:label "Film VFX"@en ;
    rdfs:comment "Film VFX (Visual Effects) encompasses the full suite of techniques used to create, augment, or manipulate imagery in cinematic productions that cannot be practically achieved through conventional photography, including computer-generated imagery (CGI), digital compositing, motion capture-driven character animation, photorealistic simulation of natural phenomena, and digital environment creation. Modern film VFX pipelines integrate real-time rendering engines, deep learning-based tools for rotoscoping, denoising, and face replacement, and virtual production stages using LED volume displays to blend physical and digital environments in-camera rather than in post-production. VFX is distinct from practical effects (pyrotechnics, prosthetics) and from colour grading, though all three coexist within the broader post-production discipline."@en ;
    rdfs:subClassOf ngm:visual-effects ;
    vc:enables ngm:generative-content ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:film-production,
        ngm:motion-capture,
        ngm:neural-rendering,
        ngm:photorealistic-rendering,
        ngm:vfx-tools ;
    vc:slug "film-vfx" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:diffusion-model,
        ngm:real-time-rendering,
        ngm:virtual-production .

ngm:financial-crime-detection a owl:Class ;
    rdfs:label "Financial Crime Detection"@en ;
    rdfs:comment "Financial crime detection is the application of data analysis, machine learning, and rule-based systems to identify patterns indicative of money laundering, fraud, terrorist financing, bribery, market manipulation, and related illicit activities within financial transaction data. It operates at the intersection of compliance obligation and risk management, producing alerts that human investigators triage and escalate to regulatory or law-enforcement bodies."@en ;
    rdfs:subClassOf ngm:fraud-detection ;
    vc:enables ngm:anti-money-laundering,
        ngm:compliance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:aml-kyc-compliance,
        ngm:know-your-customer ;
    vc:slug "financial-crime-detection" ;
    vc:sourceDomain "finance" ;
    vc:supports ngm:blockchain-analytics ;
    vc:uses ngm:machine-learning-discipline,
        ngm:transaction-monitoring .

ngm:financial-crime-prevention a owl:Class ;
    rdfs:label "Financial Crime Prevention"@en ;
    rdfs:comment "Financial Crime Prevention is the set of controls, processes and technologies that detect, deter and disrupt illicit financial activity such as money laundering, fraud, terrorist financing and sanctions evasion. It combines customer due diligence, transaction monitoring, screening and reporting obligations to satisfy regulatory expectations and protect the integrity of the financial system. The field draws on analytics and risk-based methodologies to focus scarce investigative resources on the highest-risk activity."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:anti-money-laundering ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:transaction-monitoring ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:audit-trail ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:transaction-monitoring ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:sanctions-screening ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:know-your-customer ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:know-your-customer ],
        ngm:regulatory-compliance ;
    vc:bridgesTo ngm:cybersecurity ;
    vc:enables ngm:financial-services,
        ngm:regulatory-compliance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:anti-money-laundering,
        ngm:know-your-customer,
        ngm:sanctions-screening,
        ngm:transaction-monitoring ;
    vc:isPartOf ngm:regulatory-compliance ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:anti-money-laundering,
        ngm:compliance,
        ngm:fraud-detection ;
    vc:requires ngm:audit-trail,
        ngm:know-your-customer,
        ngm:transaction-monitoring ;
    vc:slug "financial-crime-prevention" ;
    vc:sourceDomain "finance" ;
    vc:standardizedBy ngm:fatf ;
    vc:supports ngm:financial-regulation,
        ngm:financial-system ;
    vc:uses ngm:data-analytics,
        ngm:fraud-detection,
        ngm:transaction-monitoring .

ngm:finite-field a owl:Class ;
    rdfs:label "Finite Field"@en ;
    rdfs:comment "A finite field, also called a Galois field, is an algebraic structure containing a finite number of elements on which addition, subtraction, multiplication, and division (excluding by zero) are defined and obey the field axioms. Every finite field has a number of elements equal to a prime power, and fields of a given size are unique up to isomorphism. Finite fields are central to cryptography, error-correcting codes, and many computational algorithms because they support exact arithmetic over bounded sets."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:modular-arithmetic ],
        ngm:modular-arithmetic ;
    vc:bridgesTo ngm:cryptography ;
    vc:dependsOn ngm:number-theory ;
    vc:enables ngm:elliptic-curve-cryptography,
        ngm:zero-knowledge-proof ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:implements ngm:modular-arithmetic ;
    vc:isPartOf ngm:number-theory ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:cryptography,
        ngm:elliptic-curve-cryptography,
        ngm:zero-knowledge-proof ;
    vc:requires ngm:modular-arithmetic ;
    vc:slug "finite-field" ;
    vc:sourceDomain "security" ;
    vc:supports ngm:cryptography ;
    vc:uses ngm:number-theory .

ngm:fipa a owl:Class ;
    rdfs:label "FIPA"@en ;
    rdfs:comment "FIPA, the Foundation for Intelligent Physical Agents, is a standards body — now an IEEE Computer Society standards committee — that produced specifications for interoperable software agents and multi-agent systems. Its best-known output is FIPA-ACL, an agent communication language with formally defined performatives and interaction protocols. FIPA standards enable heterogeneous agents from different developers to discover, communicate, and coordinate with one another."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:fipa-acl ],
        ngm:standards ;
    vc:enables ngm:multi-agent-systems ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:fipa-acl,
        ngm:interaction-protocol ;
    vc:implements ngm:agent-communication-language,
        ngm:coordination-protocol ;
    vc:isPartOf ngm:multi-agent-systems,
        ngm:standards ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:agent-communication-language,
        ngm:kqml,
        ngm:software-agent ;
    vc:slug "fipa" ;
    vc:sourceDomain "infrastructure" ;
    vc:standardizedBy ngm:ieee ;
    vc:supports ngm:multi-agent-systems ;
    vc:uses ngm:ontology .

ngm:flexible-manufacturing a owl:Class ;
    rdfs:label "Flexible Manufacturing"@en ;
    rdfs:comment "Flexible manufacturing is a production approach in which automated, reconfigurable equipment and material-handling systems can adapt rapidly to changes in product mix and volume with minimal downtime. It combines computer numerical control machines, robots, and automated transport under coordinated supervisory control so that the same line can produce varied parts on demand. The approach targets responsiveness and customisation while retaining the efficiency of automation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:sensor ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:robot ],
        ngm:industrial-automation ;
    vc:bridgesTo ngm:supply-chain ;
    vc:contrastsWith ngm:industrial-automation ;
    vc:dependsOn ngm:automation ;
    vc:enables ngm:automation,
        ngm:robotics ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:robot ;
    vc:implements ngm:automation ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:industrial-automation,
        ngm:robot,
        ngm:robotics,
        ngm:scada ;
    vc:requires ngm:sensor ;
    vc:slug "flexible-manufacturing" ;
    vc:sourceDomain "robotics" ;
    vc:supports ngm:scada ;
    vc:uses ngm:actuator,
        ngm:robot .

ngm:force-sensor a owl:Class ;
    rdfs:label "Force Sensor"@en ;
    rdfs:comment "A force sensor is a transducer that measures the magnitude (and sometimes direction) of an applied mechanical force or torque, typically by converting strain in an elastic element into an electrical signal. Single-axis load cells and multi-axis force-torque sensors give robots haptic awareness of contact and interaction forces. Such measurements are essential for compliant manipulation, assembly, and safe physical human-robot interaction."@en ;
    rdfs:subClassOf ngm:sensor ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:admittance-control,
        ngm:hydraulic-actuator ;
    vc:slug "force-sensor" ;
    vc:sourceDomain "robotics" .

ngm:formal-specification a owl:Class ;
    rdfs:label "Formal Specification"@en ;
    rdfs:comment "A formal specification is a precise, mathematically grounded description of the intended behaviour or structure of a system, written in a language with well-defined syntax and semantics. It allows properties of the system to be stated unambiguously and reasoned about or verified mechanically. Formal specifications underpin formal methods, model checking, and the construction of provably correct software and ontologies."@en ;
    rdfs:subClassOf ngm:infra-software-engineering ;
    skos:broader ngm:infra-software-engineering ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:ai-research-area,
        ngm:domain-ontology ;
    vc:slug "formal-specification" ;
    vc:sourceDomain "infrastructure" .

ngm:format-migration a owl:Class ;
    rdfs:label "Format Migration"@en ;
    rdfs:comment "Format migration is the process of converting data or digital assets from one file format to another while preserving meaning, structure, and fidelity. It is central to digital preservation, where obsolete formats are migrated to current ones to keep content accessible over time. Migration must manage information loss, metadata mapping, and validation of the converted output."@en ;
    rdfs:subClassOf ngm:data-management ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:archival-standards,
        ngm:conversion-pipeline ;
    vc:slug "format-migration" ;
    vc:sourceDomain "data" .

ngm:formative-assessment a owl:Class ;
    rdfs:label "Formative Assessment"@en ;
    rdfs:comment "Formative assessment is an ongoing, low-stakes evaluation practice used by educators and learners to monitor understanding and progress during the learning process rather than at its conclusion, with the explicit purpose of informing instructional adjustments and learner self-regulation. Unlike summative assessment, formative assessment results are used to guide immediate pedagogical decisions — providing feedback, identifying misconceptions, and adapting content difficulty — rather than to assign grades or certifications. In spatial computing and XR learning environments, formative assessment can be embedded invisibly in simulation tasks, analysing performance traces in real time."@en ;
    rdfs:subClassOf ngm:spatial-computing ;
    skos:broader ngm:spatial-computing ;
    vc:contrastsWith ngm:summative-assessment ;
    vc:dependsOn ngm:data-analytics,
        ngm:learning-management-system ;
    vc:enables ngm:adaptive-learning,
        ngm:feedback-loop,
        ngm:learning-analytics,
        ngm:personalised-education ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:diagnostic-feedback,
        ngm:learning-objective,
        ngm:performance-trace ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:augmented-reality,
        ngm:educational-technology,
        ngm:simulation-based-learning ;
    vc:slug "formative-assessment" ;
    vc:sourceDomain "spatial-computing" ;
    vc:standardizedBy ngm:xapi ;
    vc:supports ngm:competency-based-education,
        ngm:intelligent-tutoring-system,
        ngm:xr-training ;
    vc:uses ngm:knowledge-tracing,
        ngm:learner-model,
        ngm:xapi .

ngm:fourier-analysis a owl:Class ;
    rdfs:label "Fourier Analysis"@en ;
    rdfs:comment "Fourier analysis is the branch of mathematics that decomposes functions or signals into sums of sinusoidal components, representing them in terms of frequency rather than time or space. Its central tool, the Fourier transform, maps a signal to its spectrum, revealing periodicities and enabling operations such as filtering and convolution to be performed efficiently in the frequency domain. It is foundational to signal processing, communications, and many numerical and learning methods."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:fast-fourier-transform ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:linear-algebra ],
        ngm:signal-processing ;
    vc:bridgesTo ngm:feature-extraction ;
    vc:dependsOn ngm:linear-algebra ;
    vc:enables ngm:convolution,
