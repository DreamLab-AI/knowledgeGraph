ngm:hardware-security a owl:Class ;
    rdfs:comment "Hardware security protects systems by building trust and isolation into physical components, using features such as secure enclaves, key storage and tamper resistance to defend against attacks software alone cannot stop."@en ;
    rdfs:label "Hardware Security"@en ;
    rdfs:subClassOf ngm:computer-hardware ;
    rdfs:subClassOf _:r11507 ;
