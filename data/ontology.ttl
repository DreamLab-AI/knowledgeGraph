ngm:access-token a owl:Class ;
    rdfs:comment "An access token is a credential that a client presents to a resource server to access protected resources within a granted scope and lifetime. Typically short-lived and often a bearer token, it carries or references the authorisation decision so the resource server need not re-check with the authorisation server on every request. Access tokens are the workhorse credential of OAuth 2.0 and API authorisation."@en ;
    rdfs:label "Access Token"@en ;
    rdfs:subClassOf ngm:oauth-2-0 ;
    rdfs:subClassOf _:r957 ;
    rdfs:subClassOf _:r958 ;
