        ngm:smart-contract .

ngm:retroactive-public-goods-funding a owl:Class ;
    rdfs:label "Retroactive Public Goods Funding"@en ;
    rdfs:comment "Retroactive Public Goods Funding (RetroPGF) is a capital allocation mechanism that rewards contributors to open-source software, protocol infrastructure, or public-benefit projects after they have demonstrably created value, rather than distributing speculative upfront grants based on predicted future impact. By funding proven outcomes rather than promises, RetroPGF reduces misallocation risk and aligns incentives so that contributors can invest effort in public goods with confidence that eventual recognition is possible. Evaluation is typically performed by a trusted body — such as a DAO committee, a citizen house of badge holders, or an expert panel — who assess demonstrated impact and distribute treasury funds accordingly. The mechanism was pioneered by Vitalik Buterin and operationalised at scale by the Optimism Collective, making it one of the most influential experiments in decentralised public goods economics."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:sybil-resistance ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:smart-contract ],
        ngm:bc-defi-and-economics ;
    skos:broader ngm:bc-defi-and-economics ;
    vc:bridgesTo ngm:commons-governance,
        ngm:impact-investing,
        ngm:open-source-software ;
    vc:contrastsWith ngm:quadratic-funding ;
    vc:enables ngm:incentive-alignment,
        ngm:open-source-sustainability,
        ngm:revenue-distribution ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:decentralised-governance,
        ngm:public-goods-funding ;
    vc:qualityScore "0.72"^^xsd:float ;
