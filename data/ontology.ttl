vf:io-t-sensors a owl:Class ;
    rdfs:label "Io T Sensors"@en ;
    rdfs:comment "IoT Sensors are networked sensing devices that collect physical and environmental data (temperature, pressure, motion, humidity, vibration, etc.) and transmit it via internet protocols to edge or cloud systems for processing and analysis. Modern IoT sensors increasingly incorporate on-device AI/ML accelerators enabling local inference, predictive analytics, and autonomous decision-making without cloud dependency."@en ;
    rdfs:subClassOf <urn:visionflow:linked:internet-of-things> ;
    vc:authorityScore "0.0"^^xsd:float ;
