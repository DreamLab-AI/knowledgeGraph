ngm:position-sensor a owl:Class ;
    rdfs:label "Position Sensor"@en ;
    rdfs:comment "A position sensor is a transducer that measures the displacement, angle, or spatial location of an object or joint relative to a reference frame, converting mechanical position into an electrical signal suitable for control system feedback. Position sensors are fundamental to closed-loop robotic and mechatronic systems, enabling precise joint control, end-effector placement, and localisation. They span a wide range of physical measurement principles including optical encoding, magnetic hall-effect sensing, capacitive displacement, and inductive resolver techniques."@en ;
    rdfs:subClassOf ngm:sensor ;
    vc:enables ngm:localization,
        ngm:robot-manipulation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:encoder,
        ngm:imu,
        ngm:linear-encoder,
        ngm:proprioceptive-sensor,
        ngm:rotary-encoder ;
    vc:slug "position-sensor" ;
    vc:sourceDomain "robotics" ;
    vc:supports ngm:robot-kinematics,
        ngm:robotic-control .

ngm:precision-manufacturing a owl:Class ;
    rdfs:label "Precision Manufacturing"@en ;
    rdfs:comment "Precision manufacturing is a set of industrial processes and quality systems that produce mechanical components and assemblies within extremely tight dimensional tolerances — typically sub-micrometre to nanometre scale — using advanced machining, metrology, and process control techniques. It encompasses CNC machining, ultra-precision grinding, electrical discharge machining (EDM), and micro-fabrication, combined with in-process measurement and statistical process control to ensure conformance to specification. Precision manufacturing is fundamental to the production of optical systems, semiconductor equipment, aerospace components, medical implants, and scientific instruments where dimensional accuracy directly determines system performance."@en ;
    rdfs:subClassOf ngm:manufacturing-automation ;
    vc:enables ngm:digital-twin,
        ngm:industrial-robot ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:digital-fabrication,
        ngm:display-metrology,
        ngm:industrial-automation,
        ngm:quality-assurance ;
    vc:slug "precision-manufacturing" ;
    vc:sourceDomain "hardware" ;
    vc:uses ngm:industrial-inspection,
        ngm:smart-manufacturing .

ngm:predictive-personalization a owl:Class ;
    rdfs:label "Predictive Personalization"@en ;
    rdfs:comment "The use of machine learning models to anticipate individual user preferences and dynamically tailor content, recommendations, interfaces, and experiences before an explicit request is made. Systems combine behavioural analytics, user profiling, and predictive models to deliver contextually relevant personalisation at scale."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-governance ],
        ngm:ai-application ;
    skos:broader ngm:ai-application ;
    vc:enables ngm:user-experience ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:natural-language-processing,
        ngm:predictive-analytics,
        ngm:recommendation-engine,
        ngm:user-experience ;
    vc:requires ngm:data-governance ;
    vc:slug "predictive-personalization" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:behavioral-analytics,
        ngm:machine-learning,
        ngm:machine-learning-model .

ngm:prefix-tuning a owl:Class ;
    rdfs:label "Prefix Tuning"@en ;
    rdfs:comment "A parameter-efficient fine-tuning technique that prepends trainable continuous vectors (prefixes) to the key and value matrices at each transformer layer, whilst keeping the pre-trained model parameters frozen. Unlike prompt tuning, which operates only on input embeddings, prefix tuning influences the attention mechanism at every layer, achieving stronger task-specific adaptation with roughly 0.1% of model parameters."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:fine-tuning ],
        ngm:parameter-efficient-fine-tuning ;
    vc:contrastsWith ngm:adapter-modules,
        ngm:prompt-tuning ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:parameter-efficient-fine-tuning ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires ngm:fine-tuning ;
    vc:slug "prefix-tuning" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:attention-mechanism,
        ngm:transfer-learning .

ngm:pressure-sensor a owl:Class ;
    rdfs:label "Pressure Sensor"@en ;
    rdfs:comment "Pressure Sensor is a robotics and autonomous systems concept and a type of robotics."@en ;
    rdfs:subClassOf ngm:robo-perception,
        ngm:sensor ;
    skos:broader ngm:robo-perception ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:slug "pressure-sensor" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:robotics .

ngm:programming-language a owl:Class ;
    rdfs:label "Programming Language"@en ;
    rdfs:comment "A formal notation system used to specify algorithms, data structures, and computational models for AI and software applications, characterised by defined syntax and semantics; prominent examples include Python for machine-learning ecosystems, Julia for high-performance numerical computing, and domain-specific languages embedded in ML frameworks."@en ;
    rdfs:subClassOf ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:enables ngm:deep-learning,
        ngm:natural-language-processing ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:ai-model-architecture,
        ngm:software-development-process,
        ngm:transformer-architecture ;
    vc:slug "programming-language" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:open-source-framework .

ngm:proof-of-authority a owl:Class ;
    rdfs:label "Proof of Authority"@en ;
    rdfs:comment "A permissioned blockchain consensus mechanism in which a fixed set of pre-approved validators with verified real-world identities are authorised to produce and validate blocks. PoA sacrifices decentralisation for high throughput and fast finality, making it suitable for enterprise and consortium blockchains where participant trust can be established off-chain."@en ;
    rdfs:subClassOf ngm:bc-protocol-and-consensus,
        ngm:proof-based-consensus ;
    skos:broader ngm:bc-protocol-and-consensus ;
    vc:contrastsWith ngm:proof-of-stake,
        ngm:proof-of-work ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:consensus-algorithm,
        ngm:consensus-mechanism,
        ngm:consortium-blockchain,
        ngm:finality ;
    vc:slug "proof-of-authority" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:blockchain-governance .

ngm:property-rights a owl:Class ;
    rdfs:label "Property Rights"@en ;
    rdfs:comment "The legal and technical frameworks that establish, verify, and enforce ownership of digital assets, virtual land, and intellectual creations within metaverse environments. Property rights in spatial computing contexts rely on blockchain-based ownership records, NFT standards, and smart contracts to grant creators and users enforceable claims over their digital goods."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:smart-contract ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:digital-ownership ],
        ngm:sc-governance-and-safety ;
    skos:broader ngm:sc-governance-and-safety ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:relatedTo ngm:copyright,
        ngm:tokenization ;
    vc:requires ngm:digital-ownership,
        ngm:smart-contract ;
    vc:slug "property-rights" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:blockchain,
        ngm:nft .

ngm:pure-proof-of-stake a owl:Class ;
    rdfs:label "Pure Proof of Stake"@en ;
    rdfs:comment "A proof-of-stake consensus variant, exemplified by Algorand, that randomly selects block proposers and committee members from all token holders proportional to their stake weight using cryptographic sortition, without delegation mechanisms, enabling high decentralisation and Byzantine fault tolerance with immediate finality."@en ;
    rdfs:subClassOf ngm:bc-protocol-and-consensus,
        ngm:proof-of-stake ;
    skos:broader ngm:bc-protocol-and-consensus ;
    vc:contrastsWith ngm:proof-of-work ;
    vc:enables ngm:deterministic-finality,
        ngm:proof-of-stake-sustainability,
        ngm:validator-node ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:bc-protocol-and-consensus ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:byzantine-fault-tolerance,
        ngm:consensus-mechanism,
        ngm:delegated-proof-of-stake,
        ngm:liquid-proof-of-stake,
        ngm:nominated-proof-of-stake ;
    vc:slug "pure-proof-of-stake" ;
    vc:sourceDomain "blockchain" .

ngm:query-key-value a owl:Class ;
    rdfs:label "Query Key Value"@en ;
    rdfs:comment "The three fundamental components of the attention mechanism introduced by Vaswani et al. (2017): a Query vector representing the current information need, Key vectors representing available information descriptors, and Value vectors containing the content to retrieve. Attention weights are computed via scaled dot-product similarity between queries and keys, then applied to values to produce context-aware output representations."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:machine-learning ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:neural-network ],
        ngm:ai-model-architecture,
        ngm:attention-mechanism ;
    skos:broader ngm:ai-model-architecture ;
    vc:enables ngm:deep-learning,
        ngm:large-language-models ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:attention-mechanism ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:model-capacity,
        ngm:neural-network-architecture ;
    vc:requires ngm:machine-learning,
        ngm:neural-network ;
    vc:slug "query-key-value" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:query-processor a owl:Class ;
    rdfs:label "Query Processor"@en ;
    rdfs:comment "A system component responsible for parsing, optimising, and executing queries against a data store or knowledge base, including spatial queries in 3D environments. Query processors translate declarative query expressions into efficient execution plans, leveraging indexing structures such as octrees, k-d trees, R-trees, and scene graph hierarchies to minimise retrieval latency."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:database-query ],
        ngm:infra-data-management ;
    skos:broader ngm:infra-data-management ;
    vc:enables ngm:information-retrieval,
        ngm:semantic-search ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:database-query ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:knowledge-graph,
        ngm:vector-database ;
    vc:slug "query-processor" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:database-system,
        ngm:scene-graph .

ngm:quorum a owl:Class ;
    rdfs:label "Quorum"@en ;
    rdfs:comment "Quorum refers to the minimum number or proportion of participants—nodes, voters, or validators—that must agree or be present for a decision, transaction, or consensus round to be considered valid in a distributed system or governance process. In blockchain contexts, quorum thresholds determine the minimum fraction of stake, tokens, or nodes required to reach consensus or pass a governance proposal. In distributed database and consensus algorithm contexts, quorum overlap guarantees are what ensure linearisability in systems like Paxos and Raft. In DAO governance, quorum requirements prevent low-participation attacks where a small minority can pass proposals without broader community engagement. Setting appropriate quorum thresholds balances liveness (ability to make decisions) against safety (resistance to minority capture)."@en ;
    rdfs:subClassOf ngm:consensus-mechanism ;
    vc:enables ngm:fault-tolerance,
        ngm:on-chain-governance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:byzantine-fault-tolerance,
        ngm:consensus-algorithm,
        ngm:distributed-system ;
    vc:slug "quorum" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:blockchain-governance,
        ngm:dao-governance ;
    vc:uses ngm:consensus-protocol,
        ngm:voting-mechanism .

ngm:rb-0029-inverse-kinematics a owl:Class ;
    rdfs:label "rb 0029 inverse kinematics"@en ;
    rdfs:comment "Inverse kinematics (IK) is the computational process of determining the joint angles or actuator lengths required to place a robot's end-effector at a desired position and orientation in task space. Unlike forward kinematics, IK is typically under-determined or over-determined and requires iterative numerical solvers, analytical solutions, or Jacobian-based methods; it is a foundational component of motion planning, manipulation, and trajectory execution in robotic systems."@en ;
    rdfs:subClassOf ngm:kinematics,
        ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:contrastsWith ngm:rb-0028-forward-kinematics ;
    vc:enables ngm:motion-planning,
        ngm:rb-0051-trajectory-planning ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:end-effector,
        ngm:manipulator-arm,
        ngm:rb-0021-robot-kinematics,
        ngm:rb-0023-degrees-of-freedom ;
    vc:slug "rb-0029-inverse-kinematics" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:rb-0030-jacobian-matrix,
        ngm:rb-0031-singularity .

ngm:rb-0048-pid-controller a owl:Class ;
    rdfs:label "rb 0048 pid controller"@en ;
    rdfs:comment "A PID (Proportional-Integral-Derivative) controller is the most widely deployed feedback control algorithm in robotics and industrial automation. It computes a control output as the weighted sum of three terms: the proportional term (reacts to the current error magnitude), the integral term (eliminates steady-state error by accumulating past errors), and the derivative term (anticipates future error by responding to the rate of change). PID controllers are used in robot joint position and velocity loops, temperature regulation, and process control, often augmented with feed-forward terms to improve performance under known dynamics."@en ;
    rdfs:subClassOf ngm:control-theory,
        ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:contrastsWith ngm:rb-0062-model-predictive-control ;
    vc:dependsOn ngm:rb-0072-encoder ;
    vc:enables ngm:rb-0054-position-control,
        ngm:rb-0055-velocity-control ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:feedback-control,
        ngm:rb-0047-feedback-control,
        ngm:rb-0060-optimal-control,
        ngm:rb-0063-sliding-mode-control ;
    vc:slug "rb-0048-pid-controller" ;
    vc:sourceDomain "robotics" .

ngm:rb-0052-collision-avoidance a owl:Class ;
    rdfs:label "rb 0052 collision avoidance"@en ;
    rdfs:comment "Collision avoidance in robotics is the capability of a robot system to detect and react to obstacles — including other robots, infrastructure, and human operators — so as to prevent physical contact that could cause damage or injury. It encompasses both reactive techniques (e.g. potential field methods, velocity obstacles) and proactive planning approaches that embed free-space constraints into the trajectory from the outset. It is a prerequisite for safe autonomous navigation and collaborative operation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:rb-0066-robot-sensor ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:rb-0049-motion-planning ],
        ngm:motion-planning,
        ngm:robo-navigation-and-planning ;
    skos:broader ngm:robo-navigation-and-planning ;
    vc:dependsOn ngm:rb-0051-trajectory-planning ;
    vc:enables ngm:rb-0103-collaborative-operation ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:obstacle-avoidance,
        ngm:rb-0092-protective-stop,
        ngm:rb-0095-safety-zone,
        ngm:rb-0105-speed-and-separation-monitoring ;
    vc:requires ngm:rb-0049-motion-planning,
        ngm:rb-0066-robot-sensor ;
    vc:slug "rb-0052-collision-avoidance" ;
    vc:sourceDomain "robotics" .

ngm:rb-0053-force-control a owl:Class ;
    rdfs:label "rb 0053 force control"@en ;
    rdfs:comment "Force control is a robot control paradigm in which the controller regulates the interaction force between the end-effector and its environment, rather than purely tracking a desired position trajectory. By closing the loop on measured contact forces from a force-torque sensor, the robot can perform compliant tasks such as surface grinding, peg-in-hole insertion, and human-robot handover without requiring precise environmental models. The main architectures are impedance control, admittance control, and hybrid position/force control, each suited to different environment stiffness regimes."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:rb-0047-feedback-control ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:rb-0067-force-torque-sensor ],
        ngm:control-system,
        ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:contrastsWith ngm:rb-0054-position-control ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:rb-0038-compliance,
        ngm:rb-0056-impedance-control,
        ngm:rb-0057-admittance-control,
        ngm:rb-0094-power-and-force-limiting ;
    vc:requires ngm:rb-0047-feedback-control,
        ngm:rb-0067-force-torque-sensor ;
    vc:slug "rb-0053-force-control" ;
    vc:sourceDomain "robotics" .

ngm:rb-0103-collaborative-operation a owl:Class ;
    rdfs:label "rb 0103 collaborative operation"@en ;
    rdfs:comment "Collaborative operation is a mode of robotic system use in which a robot and one or more human operators work together within a shared workspace, as defined in ISO/TS 15066 and ISO 10218. It encompasses the specific operating conditions, safety functions, and interaction patterns that govern the coexistence of humans and robots without a fixed separating safeguard. The concept underpins cobot deployment strategies including hand guiding, speed and separation monitoring, power and force limiting, and safety-rated monitored stop."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:rb-0089-risk-assessment ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:rb-0104-hand-guiding ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:rb-0091-safety-rated-monitored-stop ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:rb-0094-power-and-force-limiting ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:rb-0105-speed-and-separation-monitoring ],
        ngm:collaborative-operation,
        ngm:robo-human-robot-interaction ;
    skos:broader ngm:robo-human-robot-interaction ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:rb-0104-hand-guiding,
        ngm:rb-0105-speed-and-separation-monitoring ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:cobot-safety-levels,
        ngm:rb-0007-collaborative-robot ;
    vc:requires ngm:rb-0089-risk-assessment,
        ngm:rb-0091-safety-rated-monitored-stop,
        ngm:rb-0094-power-and-force-limiting ;
    vc:slug "rb-0103-collaborative-operation" ;
    vc:sourceDomain "robotics" ;
    vc:standardizedBy ngm:iso-10218,
        ngm:iso-ts-15066 .

ngm:rb-0105-speed-and-separation-monitoring a owl:Class ;
    rdfs:label "rb 0105 speed and separation monitoring"@en ;
    rdfs:comment "Speed and Separation Monitoring (SSM) is a collaborative robot safety function in which the speed of the robot is continuously regulated based on the measured distance between the robot and any human operator in the shared workspace. When the separation distance decreases below defined thresholds the robot slows or stops, and it resumes normal speed once sufficient separation is restored. SSM is standardised under ISO/TS 15066 as one of the four permitted collaborative operation modes."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:rb-0066-robot-sensor ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:rb-0095-safety-zone ],
        ngm:light-curtain,
        ngm:robo-safety-and-standards ;
    skos:broader ngm:robo-safety-and-standards ;
    vc:dependsOn ngm:rb-0069-lidar,
        ngm:rb-0093-speed-limitation ;
    vc:enables ngm:rb-0103-collaborative-operation ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:rb-0089-risk-assessment,
        ngm:rb-0092-protective-stop,
        ngm:rb-0094-power-and-force-limiting ;
    vc:requires ngm:rb-0066-robot-sensor,
        ngm:rb-0095-safety-zone ;
    vc:slug "rb-0105-speed-and-separation-monitoring" ;
    vc:sourceDomain "robotics" ;
    vc:standardizedBy ngm:rb-0087-safety-standard .

ngm:real-time-inference-at-edge a owl:Class ;
    rdfs:label "Real-Time Inference at Edge"@en ;
    rdfs:comment "The execution of machine learning inference on edge devices under deterministic latency constraints, typically P99 latency below 10–100 ms, to support safety-critical and time-sensitive applications. Achieves real-time performance through hardware accelerators (NPUs, FPGAs, ASICs), model compression, and priority scheduling without reliance on cloud round-trips."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:model-compression-for-edge ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:embedded-systems ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:edge-computing ],
        ngm:ai-infrastructure ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:edge-ai-system,
        ngm:knowledge-distillation-for-edge,
        ngm:model-pruning-for-edge-deployment ;
    vc:requires ngm:edge-computing,
        ngm:embedded-systems,
        ngm:model-compression-for-edge ;
    vc:slug "real-time-inference-at-edge" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:edge-ai-accelerator,
        ngm:fpga,
        ngm:latency-aware-edge-ai,
        ngm:npu .

ngm:realtime-communication a owl:Class ;
    rdfs:label "Realtime Communication"@en ;
    rdfs:comment "Infrastructure and protocols enabling low-latency, synchronous exchange of audio, video, text, and data between participants. Realtime communication encompasses voice-over-IP, video conferencing, instant messaging, and presence systems that require end-to-end latency below perceptual thresholds (typically under 150 ms) to support coherent social interaction in both physical and virtual environments."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:latency ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:network-protocol ],
        ngm:infra-network-and-comms ;
    skos:broader ngm:infra-network-and-comms ;
    vc:enables ngm:immersive-communication,
        ngm:realtime-collaboration ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:requires ngm:latency,
        ngm:network-protocol ;
    vc:slug "realtime-communication" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:metaverse-and-telecollaboration ;
    vc:uses ngm:network-synchronization .

ngm:relayer a owl:Class ;
    rdfs:label "Relayer"@en ;
    rdfs:comment "Infrastructure operator that facilitates cross-chain message passing by monitoring source chains for events, generating cryptographic proofs of state, and submitting verified transactions to destination chains."@en ;
    rdfs:subClassOf ngm:bc-network-component,
        ngm:blockchain-interoperability ;
    skos:broader ngm:bc-network-component ;
    vc:enables ngm:cross-chain-bridge ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:implements ngm:message-passing ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:slug "relayer" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:light-client .

ngm:reliability a owl:Class ;
    rdfs:label "Reliability"@en ;
    rdfs:comment "The degree to which an AI system performs its intended function consistently and accurately over time and across repeated operations, producing predictable and dependable results under specified conditions."@en ;
    rdfs:subClassOf ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires ngm:monitoring,
