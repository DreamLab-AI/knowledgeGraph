ngm:ofdm a owl:Class ;
    rdfs:comment "OFDM (Orthogonal Frequency-Division Multiplexing) is a digital modulation scheme that transmits data in parallel over many closely spaced, mutually orthogonal subcarriers. Splitting a high-rate stream into many low-rate subcarriers makes the signal robust to multipath fading and allows simple frequency-domain equalisation. It is the physical-layer foundation of Wi-Fi, LTE, 5G, DVB, and many other modern broadband systems."@en ;
    rdfs:label "OFDM"@en ;
    rdfs:subClassOf ngm:infra-network-and-comms ;
    skos:broader ngm:infra-network-and-comms ;
