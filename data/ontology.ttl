# Permissioned Blockchain
blockchain:PermissionedBlockchain rdf:type owl:Class ;
    rdfs:label "Permissioned Blockchain"@en ;
    rdfs:comment "A restricted-access distributed ledger controlled by known participants using predefined permissions and pluggable Consensus Mechanism, enabling organisations to leverage blockchain technology's immutability, transparency, and smart contract capabilities whilst maintaining regulatory compliance and business confidentiality. Permissioned blockchains implement access control at multiple layers—node permissioning restricting which organisations participate, account permissioning controlling transaction submission, and PrivateChannels enabling confidential subsets of participants to conduct transactions invisibly to others—deployed extensively in enterprise contexts including Hyperledger Fabric, Quorum Blockchain, and R3 Corda supporting supply chain, trade finance, healthcare, and financial services applications."@en ;
    skos:prefLabel "Permissioned Blockchain"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:blockchain:permissioned-blockchain" ;
    owl:sameAs <urn:visionclaw:concept:blockchain:permissioned-blockchain> ;
    vcw:contentHash "sha256-12-fa86429b8c81" ;
    vcw:qualityScore "0.4"^^xsd:decimal ;
    vcw:legacyTermId "BC-0429" ;
    vcw:ontologyStatus "draft" ;
    vcw:maturityLevel "draft" ;
    vcw:authorityScore "0.0"^^xsd:decimal ;
    dcterms:identifier "BC-0429" ;
    dcterms:subject "blockchain" ;
    owl:versionInfo "2.0.0" ;
    dcterms:created "2026-04-26T00:00:00Z"^^xsd:dateTime ;
    dcterms:modified "2026-04-26T13:00:00Z"^^xsd:dateTime ;
    vcw:owlRole "Concept" .

blockchain:PermissionedBlockchain rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty infrastructure:requires ;
    owl:someValuesFrom blockchain:BC0120consensusmechanism
] .

# Private Channels
blockchain:PrivateChannels rdf:type owl:Class ;
    rdfs:label "Private Channels"@en ;
    rdfs:comment "Confidential transaction subsets in PermissionedBlockchain where designated participants conduct transactions invisibly to other network members, implementing Encryption and AccessControl to segregate sensitive business data whilst maintaining Immutability and SmartContract functionality. Private channels enable consortia members to conduct confidential transactions on shared infrastructure without exposing proprietary information, deployed extensively in HyperledgerFabric for trade finance, supply chain, and healthcare where some parties require visibility exclusion. Channels combine cryptographic isolation with shared ledger infrastructure enabling efficient ConsensusProtocol and settlement."@en ;
    skos:prefLabel "Private Channels"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:blockchain:private-channels" ;
    owl:sameAs <urn:visionclaw:concept:blockchain:private-channels> ;
    vcw:contentHash "sha256-12-31018df3538e" ;
    vcw:qualityScore "0.4"^^xsd:decimal ;
    vcw:legacyTermId "BC-0430" ;
    vcw:ontologyStatus "draft" ;
    vcw:maturityLevel "draft" ;
    vcw:authorityScore "0.0"^^xsd:decimal ;
    dcterms:identifier "BC-0430" ;
    dcterms:subject "blockchain" ;
    owl:versionInfo "2.0.0" ;
    dcterms:created "2026-04-26T00:00:00Z"^^xsd:dateTime ;
    dcterms:modified "2026-04-26T13:00:00Z"^^xsd:dateTime ;
    vcw:owlRole "Concept" .

blockchain:PrivateChannels rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty infrastructure:implementedIn ;
    owl:someValuesFrom blockchain:HyperledgerFabric
] .

blockchain:PrivateChannels rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty infrastructure:uses ;
    owl:someValuesFrom blockchain:Encryption
] .

# Privacy Preserving Blockchain
blockchain:PrivacyPreservingBlockchain rdf:type owl:Class ;
    rdfs:label "Privacy Preserving Blockchain"@en ;
    rdfs:comment "Blockchain systems employing ZeroKnowledgeProof, RingSignature, StealthAddress, and HomomorphicEncryption to obscure transaction details—sender/receiver identities, amounts, smart contract states—whilst maintaining verifiability and immutability. Privacy-preserving blockchains address regulatory requirements (GDPR, HIPAA, Anti-Money Laundering) demanding confidentiality in healthcare, finance, and enterprise applications incompatible with public ledger transparency. Deployments span monero (privacy currency), Zcash (shielded transactions), MakerDAO (confidential transactions), and enterprise permissioned networks (HyperledgerFabric)."@en ;
    skos:prefLabel "Privacy Preserving Blockchain"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:blockchain:privacy-preserving-blockchain" ;
    owl:sameAs <urn:visionclaw:concept:blockchain:privacy-preserving-blockchain> ;
    vcw:contentHash "sha256-12-7cec4f156421" ;
    vcw:qualityScore "0.4"^^xsd:decimal ;
    vcw:legacyTermId "BC-0431" ;
    vcw:ontologyStatus "stub-needs-content" ;
    vcw:maturityLevel "draft" ;
    vcw:authorityScore "0.0"^^xsd:decimal ;
    dcterms:identifier "BC-0431" ;
    dcterms:subject "blockchain" ;
    owl:versionInfo "2.0.0" ;
    dcterms:created "2026-04-26T00:00:00Z"^^xsd:dateTime ;
    dcterms:modified "2026-04-26T13:00:00Z"^^xsd:dateTime ;
    vcw:owlRole "Concept" .

blockchain:PrivacyPreservingBlockchain rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty infrastructure:enables ;
    owl:someValuesFrom blockchain:RegulatoryCompliance
] .

blockchain:PrivacyPreservingBlockchain rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty infrastructure:uses ;
    owl:someValuesFrom blockchain:ZeroKnowledgeProof
] .

# Consortium Blockchain
blockchain:ConsortiumBlockchain rdf:type owl:Class ;
    rdfs:label "Consortium Blockchain"@en ;
    rdfs:comment "Permissioned distributed ledger where multiple pre-approved organisations collectively control network governance, block validation, and access permissions. Consortium Networks balance Decentralisation benefits with Privacy Protection and Regulatory Compliance requirements for Enterprise Deployment."@en ;
    skos:prefLabel "Consortium Blockchain"@en ;
