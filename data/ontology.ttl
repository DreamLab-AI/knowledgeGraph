ngm:model-parallelism a owl:Class ;
    rdfs:label "Model Parallelism"@en ;
    rdfs:comment "Model parallelism is a distributed training strategy that splits a single neural network's parameters and computation across multiple accelerators when the model is too large to fit in one device's memory. Variants include tensor parallelism (splitting within layers) and pipeline parallelism (splitting across layers into stages). It is essential for training large language models and is often combined with data parallelism."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:tensor-parallelism ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:high-bandwidth-interconnect ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:collective-communication ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:expert-parallelism ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:pipeline-parallelism ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gpu-cluster ],
        ngm:distributed-training ;
    vc:bridgesTo ngm:distributed-systems,
        ngm:hardware-accelerator ;
    vc:contrastsWith ngm:data-parallelism ;
    vc:dependsOn ngm:compute-infrastructure,
        ngm:nvlink,
        ngm:rdma ;
    vc:enables ngm:foundation-model,
        ngm:large-language-model-training,
        ngm:mixture-of-experts-architecture ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:expert-parallelism,
        ngm:pipeline-parallelism,
        ngm:tensor-parallelism ;
    vc:implements ngm:deep-speed,
        ngm:fsdp,
        ngm:megatron-lm ;
    vc:isPartOf ngm:3d-parallelism,
        ngm:distributed-training ;
    vc:qualityScore "0.73"^^xsd:float ;
    vc:relatedTo ngm:gradient-checkpointing,
        ngm:micro-batch-scheduling ;
    vc:requires ngm:collective-communication,
        ngm:gpu-cluster,
        ngm:high-bandwidth-interconnect ;
    vc:slug "model-parallelism" ;
    vc:sourceDomain "machine-learning" .

ngm:model-selection a owl:Class ;
    rdfs:label "Model Selection"@en ;
    rdfs:comment "Model selection is the process of choosing the most appropriate machine learning model, algorithm family, or configuration for a given task from a set of candidates. It balances predictive performance against constraints such as interpretability, inference cost, and generalisation, typically using validation data and metrics rather than the training error. Techniques include cross-validation, information criteria, and held-out benchmarking, with the goal of selecting the model expected to perform best on unseen data."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cross-validation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:benchmarking ],
        ngm:model-evaluation ;
    vc:dependsOn ngm:generalisation,
        ngm:model-performance ;
    vc:enables ngm:model-comparison,
        ngm:model-deployment ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:machine-learning,
        ngm:model-evaluation ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:deep-learning,
        ngm:overfitting ;
    vc:requires ngm:benchmarking,
        ngm:cross-validation ;
    vc:slug "model-selection" ;
    vc:sourceDomain "machine-learning" ;
