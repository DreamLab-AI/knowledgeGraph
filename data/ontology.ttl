    vc:bridgesTo ngm:ai-infrastructure ;
    vc:enables ngm:fine-tuning-dataset-assembly,
        ngm:foundation-model-pre-training,
        ngm:knowledge-graph-extraction,
        ngm:retrieval-augmented-generation,
        ngm:search-index-construction,
        ngm:synthetic-data-curation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:content-extraction-pipeline,
        ngm:crawl-frontier,
        ngm:deduplication-filter,
        ngm:ip-range-manifest,
        ngm:politeness-policy,
