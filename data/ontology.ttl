# AI Trustworthiness
mv:AITrustworthiness a owl:Class ;
    rdfs:label "AI Trustworthiness"@en ;
    rdfs:comment "The degree to which an AI system demonstrates characteristics that warrant confidence and reliance, encompassing transparency, explainability, fairness, accountability, robustness, reliability, safety, security, and privacy throughout its lifecycle."@en ;
    skos:prefLabel "AI Trustworthiness"@en ;
    dcterms:identifier "AI-0061" ;
    dcterms:subject "mv" ;
    dcterms:type "draft" ;
    rdf:type owl:ConceptClass .

mv:AITrustworthiness rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:requires ;
    owl:someValuesFrom mv:RiskManagementAI0062
] .

mv:AITrustworthiness rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:requires ;
    owl:someValuesFrom mv:GovernanceFrameworkAI0035
] .

mv:AITrustworthiness rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:enables ;
    owl:someValuesFrom mv:ResponsibleAIAI0033
] .

mv:AITrustworthiness rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:enables ;
    owl:someValuesFrom mv:AIAssuranceAI0102
] .

# Transparency
mv:Transparency a owl:Class ;
    rdfs:label "Transparency"@en ;
    rdfs:comment "The property of an AI system whereby relevant information about the system's design, operation, capabilities, limitations, and decision-making processes is accessible and understandable to appropriate stakeholders."@en ;
    skos:prefLabel "Transparency"@en ;
    dcterms:identifier "AI-0062" ;
    dcterms:subject "mv" ;
    dcterms:type "draft" ;
    rdf:type owl:ConceptClass .

mv:Transparency rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:enables ;
    owl:someValuesFrom mv:ExplainabilityAI0064
] .

mv:Transparency rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:enables ;
    owl:someValuesFrom mv:AccountabilityAI0068
] .

mv:Transparency rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:isEnabledBy ;
    owl:someValuesFrom mv:AIImpactAssessment
] .

mv:Transparency rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:isEnabledBy ;
    owl:someValuesFrom mv:ConsentManagement
] .

# Explainability
mv:Explainability a owl:Class ;
    rdfs:label "Explainability"@en ;
    rdfs:comment "The extent to which an AI system's decision-making processes, outputs, and behaviors can be understood and articulated in human-comprehensible terms, enabling stakeholders to grasp how and why specific outcomes were produced."@en ;
    skos:prefLabel "Explainability"@en ;
    dcterms:identifier "AI-0063" ;
    dcterms:subject "mv" ;
    dcterms:type "draft" ;
    rdf:type owl:ConceptClass .

mv:Explainability rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:enables ;
    owl:someValuesFrom mv:AccountabilityAI0068
] .

mv:Explainability rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:enables ;
    owl:someValuesFrom mv:ContestabilityAI0043
] .

# Interpretability
mv:Interpretability a owl:Class ;
    rdfs:label "Interpretability"@en ;
    rdfs:comment "The degree to which a human can understand the internal mechanics, decision-making processes, and cause-effect relationships within an AI system, independent of external explanation tools."@en ;
    skos:prefLabel "Interpretability"@en ;
    dcterms:identifier "AI-0064" ;
    dcterms:subject "mv" ;
    dcterms:type "draft" ;
    rdf:type owl:ConceptClass .

mv:Interpretability rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:enables ;
    owl:someValuesFrom mv:ModelValidation
] .

mv:Interpretability rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:enables ;
    owl:someValuesFrom mv:Debugging
] .

mv:Interpretability rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:enables ;
    owl:someValuesFrom mv:Trust
] .

# Fairness
mv:Fairness a owl:Class ;
    rdfs:label "Fairness"@en ;
    rdfs:comment "The property of an AI system whereby it produces equitable outcomes and avoids creating or reinforcing unjustifiable disparities across different demographic groups or individuals, measured through various mathematical definitions and ethical principles."@en ;
    skos:prefLabel "Fairness"@en ;
    dcterms:identifier "AI-0065" ;
    dcterms:subject "mv" ;
    dcterms:type "draft" ;
    rdf:type owl:ConceptClass .

mv:Fairness rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:requires ;
    owl:someValuesFrom mv:BiasDetection
] .

mv:Fairness rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:requires ;
    owl:someValuesFrom mv:BiasMitigation
] .

mv:Fairness rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:enables ;
    owl:someValuesFrom mv:Nondiscrimination
] .

mv:Fairness rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:enables ;
    owl:someValuesFrom mv:EqualTreatment
] .

# Bias
ai:Bias a owl:Class ;
    rdfs:label "Bias"@en ;
    rdfs:comment "Systematic deviation from fairness, objectivity, or expected outcomes in an AI system that leads to prejudiced results favouring or disfavouring particular groups, individuals, or outcomes, arising from data, algorithms, or deployment contexts."@en ;
    skos:prefLabel "Bias"@en ;
    dcterms:identifier "AI-0066" ;
    dcterms:subject "ai" ;
    dcterms:type "draft" ;
    rdf:type owl:ConceptClass .

# Accountability
mv:Accountability a owl:Class ;
    rdfs:label "Accountability"@en ;
    rdfs:comment "The assignment of clear responsibilities for AI system development, deployment, and outcomes, coupled with mechanisms for oversight, redress, and remediation, ensuring that actors can be held answerable for system impacts and failures."@en ;
    skos:prefLabel "Accountability"@en ;
    dcterms:identifier "AI-0067" ;
    dcterms:subject "mv" ;
    dcterms:type "draft" ;
    rdf:type owl:ConceptClass .

mv:Accountability rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:requires ;
    owl:someValuesFrom mv:TransparencyAI0062
] .

mv:Accountability rdfs:subClassOf [
    a owl:Restriction ;
