    a owl:Restriction ;
    owl:onProperty ngm:relatedTo ;
    owl:someValuesFrom mv:RealTimeRendering
] .

mv:VirtualProductionPipeline rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:relatedTo ;
    owl:someValuesFrom mv:MotionCapture
] .

# Virtual Production VP
mv:VirtualProductionVP a owl:Class ;
    rdfs:subClassOf mv:FilmProduction ;
    rdfs:label "Virtual Production VP"@en ;
    rdfs:comment "A modern filmmaking methodology that combines traditional production techniques with real-time computer graphics, LED volumes, game engines, and motion capture technology to create in-camera visual effects, replacing traditional green screen compositing with immersive digital environments displayed on large LED walls during live production."@en ;
    skos:prefLabel "Virtual Production VP"@en ;
    dcterms:identifier "MV-10139" ;
    dcterms:subject "mv" .

mv:VirtualProductionVP rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:relatedTo ;
    owl:someValuesFrom mv:LEDVolume
] .

mv:VirtualProductionVP rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:relatedTo ;
    owl:someValuesFrom mv:RealTimeRendering
] .

mv:VirtualProductionVP rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:relatedTo ;
    owl:someValuesFrom mv:UnrealEngine
] .

# Virtual Production Workflow
mv:VirtualProductionWorkflow a owl:Class ;
    rdfs:subClassOf mv:ProductionPipeline ;
    rdfs:label "Virtual Production Workflow"@en ;
    rdfs:comment "The end-to-end process for creating film and television content using virtual production techniques, integrating pre-visualization, virtual art department asset creation, real-time game engine rendering, LED volume shooting, and post-production refinement in a non-linear pipeline where VFX work begins in pre-production rather than post-production."@en ;
    skos:prefLabel "Virtual Production Workflow"@en ;
    dcterms:identifier "MV-10140" ;
    dcterms:subject "mv" .

mv:VirtualProductionWorkflow rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:relatedTo ;
    owl:someValuesFrom mv:VirtualProductionVP
] .

