        ngm:algorithmic-accountability,
        ngm:compute-governance,
        ngm:conformity-assessment ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.93"^^xsd:float ;
    vc:relatedTo ngm:ai-ethics,
