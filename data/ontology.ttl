ngm:display-technology a owl:Class ;
    rdfs:label "Display Technology"@en ;
    rdfs:comment "Display Technology encompasses the hardware substrates, optical systems, and electronic driving circuits used to present visual information to human observers across form factors ranging from flat panels and projection systems to head-mounted microdisplays and retinal projectors. Core substrate families include LCD with quantum dot backlights, OLED, microLED, and laser scanning systems, each offering distinct trade-offs in brightness, contrast ratio, colour gamut, refresh rate, and power consumption. For spatial computing and extended reality applications, display technology must additionally address field of view, vergence-accommodation conflict, waveguide efficiency, and eye-box uniformity. Advances in microdisplay resolution, diffractive waveguide engineering, and foveated rendering pipelines are critical enablers of lightweight, socially acceptable XR headsets and the broader convergence of physical and digital environments."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:waveguide-optics ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:display-metrology ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:optical-calibration-target ],
        ngm:display-hardware ;
    vc:bridgesTo ngm:computer-vision,
        ngm:neural-rendering ;
    vc:contrastsWith ngm:audio-technology,
        ngm:haptic-feedback ;
    vc:dependsOn ngm:photonics,
        ngm:semiconductor-manufacturing ;
    vc:enables ngm:augmented-reality,
        ngm:foveated-rendering,
        ngm:mixed-reality,
        ngm:spatial-computing,
        ngm:virtual-reality ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:display-driver-ic,
        ngm:microdisplay,
        ngm:waveguide-optics ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:extended-reality,
        ngm:retinal-display ;
    vc:requires ngm:colour-management,
        ngm:display-metrology,
        ngm:optical-calibration-target ;
    vc:slug "display-technology" ;
    vc:sourceDomain "spatial-computing" ;
    vc:standardizedBy ngm:display-industry-standards ;
    vc:supports ngm:ar-display-device,
        ngm:human-computer-interaction,
        ngm:xr-device ;
    vc:uses ngm:eye-tracking,
        ngm:light-field-display,
        ngm:photorealistic-rendering .

ngm:dropout a owl:Class ;
    rdfs:label "Dropout"@en ;
    rdfs:comment "Dropout is a regularisation technique for neural network training in which a randomly selected fraction of neuron activations is set to zero during each forward pass, preventing neurons from co-adapting and forcing the network to learn redundant representations. By randomly deactivating 20–50% of units per training step, dropout acts as an ensemble method — each mini-batch trains a slightly different network architecture — significantly reducing overfitting on limited training datasets. At inference time, all neurons are active but their outputs are scaled by the retention probability."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:neural-network ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:training ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:stochastic-gradient-descent ],
        ngm:regularisation ;
    vc:bridgesTo ngm:bayesian-deep-learning,
        ngm:uncertainty-quantification ;
    vc:contrastsWith ngm:batch-normalisation,
        ngm:overfitting,
        ngm:weight-decay ;
    vc:enables ngm:deep-learning,
        ngm:generalisation,
        ngm:model-robustness ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:implements ngm:ensemble-learning,
        ngm:variational-inference ;
    vc:isPartOf ngm:model-training-pipeline,
        ngm:regularisation ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:convolutional-neural-network,
        ngm:data-augmentation,
        ngm:hyperparameter-tuning,
        ngm:recurrent-neural-network,
        ngm:transformer ;
    vc:requires ngm:forward-pass,
        ngm:neural-network,
        ngm:stochastic-gradient-descent,
        ngm:training ;
    vc:slug "dropout" ;
    vc:sourceDomain "machine-learning" ;
    vc:standardizedBy ngm:iso-iec-22989-2022,
        ngm:nist-ai-rmf ;
    vc:uses ngm:bernoulli-distribution,
        ngm:monte-carlo-approximation,
        ngm:random-masking .

ngm:educational-technology a owl:Class ;
    rdfs:label "Educational Technology"@en ;
    rdfs:comment "Educational Technology (EdTech) is the systematic application of digital tools, platforms, pedagogical frameworks, and immersive media to the design, delivery, and assessment of learning experiences. In spatial-computing and metaverse contexts, it encompasses virtual classrooms, simulation-based training, adaptive learning systems, and collaborative virtual environments that extend education beyond physical and temporal constraints. The field draws on learning science, human-computer interaction, artificial intelligence, and networked infrastructure to personalise instruction and reduce barriers to access. Mature EdTech deployments span K-12, higher education, corporate training, and professional development, increasingly leveraging extended reality modalities and AI-driven tutoring systems."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:learning-analytics ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:virtual-classroom ],
        [ a owl:Restriction ;
