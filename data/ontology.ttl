    vc:sourceDomain "artificial-intelligence" .

ngm:etsi-domain-infrastructure-immersive a owl:Class ;
    rdfs:label "ETSI_Domain_Infrastructure___Immersive"@en ;
    rdfs:comment "A functional domain classification within the European Telecommunications Standards Institute (ETSI) metaverse technical architecture framework (GS MEC 003, GS ARF 003) that encompasses the foundational technological infrastructure required to deliver immersive experiences including extended real..."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:content-delivery-network ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:rendering-pipeline ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:game-engine ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:edge-computing-node ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:network-slicing ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:compute-infrastructure ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:multi-access-edge-computing ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:distributed-storage ],
        ngm:infra-computing-and-cloud ;
    skos:broader ngm:infra-computing-and-cloud ;
    vc:enables ngm:extended-reality,
        ngm:immersive-experience,
        ngm:real-time-synchronization,
        ngm:spatial-computing ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:content-delivery-network,
        ngm:distributed-storage,
        ngm:edge-computing-node,
        ngm:game-engine,
        ngm:network-slicing,
        ngm:rendering-pipeline ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires ngm:compute-infrastructure,
        ngm:multi-access-edge-computing ;
    vc:slug "etsi-domain-infrastructure-immersive" ;
    vc:sourceDomain "infrastructure" .

ngm:etsi-domain-infrastructure-interop a owl:Class ;
    rdfs:label "ETSI_Domain_Infrastructure___Interop"@en ;
    rdfs:comment "ETSI infrastructure interoperability domain providing standardised frameworks enabling disparate systems, services, and domains to exchange data and operate cohesively across organisational boundaries. It underpins cross-domain data integration through NGSI-LD interfaces, intent-based network management, spectrum sharing frameworks, and EU Data Act Article 35 mandates for centralised interoperability standards repositories."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:linked-data ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:interoperability-framework ],
        ngm:infra-network-and-comms ;
    skos:broader ngm:infra-network-and-comms ;
    vc:enables ngm:digital-twin-interop-protocol,
        ngm:interoperability ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:data-governance,
        ngm:etsi-domain-interoperability ;
    vc:requires ngm:interoperability-framework,
        ngm:linked-data ;
    vc:slug "etsi-domain-infrastructure-interop" ;
    vc:sourceDomain "infrastructure" ;
    vc:standardizedBy ngm:api-standard .

ngm:etsi-domain-infrastructure-security a owl:Class ;
    rdfs:label "ETSI_Domain_Infrastructure___Security"@en ;
    rdfs:comment "ETSI infrastructure security domain safeguarding metaverse and edge computing environments through NFV architectural frameworks, cross-domain authentication standards, and decentralised identity systems. It addresses multi-party trust models, privacy-preserving mechanisms, and security lifecycle management coordinated with 3GPP and ITU-T for ultra-edge and terminal-edge deployments."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:identity-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptographic-protocol ],
        ngm:infra-security-and-identity ;
    skos:broader ngm:infra-security-and-identity ;
    vc:enables ngm:decentralized-identity-did,
        ngm:quantum-network-node ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:data-governance,
        ngm:privacy-preserving-technology ;
    vc:requires ngm:cryptographic-protocol,
        ngm:identity-management ;
    vc:slug "etsi-domain-infrastructure-security" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:security-framework .

ngm:etsi-domain-interoperability-creative a owl:Class ;
    rdfs:label "ETSI_Domain_Interoperability___Creative"@en ;
    rdfs:comment "The ETSI Domain Interoperability/Creative is a functional domain classification defined by the European Telecommunications Standards Institute that addresses the intersection of technical interoperability standards and creative content workflows within metaverse and extended reality ecosystems. It encompasses the standards, protocols, and toolchains—including glTF 2.0, USD, WebXR, OpenXR, and MPEG-I Scene Description—that enable digital creative assets such as three-dimensional models, animations, and immersive environments to be authored once and deployed across heterogeneous platforms without proprietary lock-in or fidelity degradation. The domain integrates digital rights management frameworks and semantic metadata schemas to preserve creator attribution, licensing terms, and provenance across cross-platform distribution pipelines."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:gltf-standard ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:interoperability-standard ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:metaverse-content-pipeline ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:interoperability-framework ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:3-d-asset-standard ],
        ngm:infra-network-and-comms ;
    skos:broader ngm:infra-network-and-comms ;
    vc:enables ngm:3-d-animation,
        ngm:digital-rights-management,
        ngm:extended-reality ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:3-d-asset-standard,
        ngm:gltf-standard,
        ngm:metaverse-content-pipeline ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:3-d-asset,
        ngm:extended-reality-xr,
        ngm:open-standard ;
    vc:requires ngm:interoperability-framework,
        ngm:interoperability-standard ;
    vc:slug "etsi-domain-interoperability-creative" ;
    vc:sourceDomain "infrastructure" ;
    vc:standardizedBy ngm:interoperability-standard .

ngm:etsi-domain-reality-capture-creative a owl:Class ;
    rdfs:label "ETSI_Domain_Reality_Capture___Creative"@en ;
    rdfs:comment "ETSI domain addressing real-time digital performance capture and creative content generation for immersive experiences. It integrates motion capture, facial expression tracking, gesture recognition, and AI-enhanced animation synthesis to transform physical performances into high-fidelity digital representations for metaverse avatars, virtual events, and interactive entertainment applications."@en ;
    rdfs:subClassOf ngm:digital-performance-capture,
        ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:enables ngm:avatar-interoperability,
        ngm:immersive-experience ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:augmented-reality,
        ngm:digital-twin,
        ngm:extended-reality ;
    vc:slug "etsi-domain-reality-capture-creative" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:3-d-asset,
        ngm:motion-capture .

ngm:etsi-domain-virtual-economy a owl:Class ;
    rdfs:label "ETSI_Domain_Virtual_Economy"@en ;
    rdfs:comment "ETSI domain encompassing economic systems, digital assets, and financial mechanisms enabling value exchange within metaverse and virtual environments through crypto tokens, cryptocurrencies, CBDCs, NFTs, and virtual assets. It coordinates decentralised exchanges, creator economy mechanisms, creator royalty tokens, carbon credit tokenisation, and standards development integrating virtual economies with traditional finance and regulatory compliance frameworks."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:creator-economy ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:non-fungible-token-nft ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:virtual-economy ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:smart-contract ],
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:enables ngm:marketplace,
        ngm:play-to-earn-p2-e ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:creator-economy,
        ngm:non-fungible-token-nft,
        ngm:smart-contract,
        ngm:virtual-economy ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:slug "etsi-domain-virtual-economy" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:blockchain,
        ngm:tokenization .

ngm:etsi-domain-virtual-society a owl:Class ;
    rdfs:label "ETSI_Domain_Virtual_Society"@en ;
    rdfs:comment "ETSI_Domain_Virtual_Society is a standardisation domain within the European Telecommunications Standards Institute (ETSI) that addresses the technical foundations and interoperability requirements of virtual society infrastructures, including metaverse ecosystems, Extended Reality (XR) environments, decentralised digital identity, virtual economies, and interoperable virtual worlds. It produces technical reports and specifications that coordinate standardisation work across ETSI technical bodies, liaising with ISO/IEC, ITU-T, 3GPP, W3C, and the Metaverse Standards Forum to ensure coherent standards coverage. The domain spans immersive media, avatar portability, blockchain-based identity and ownership, privacy-preserving authentication, and the governance frameworks required for responsible virtual society deployment."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:extended-reality-xr ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:virtual-world ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:digital-identity ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:avatar-interoperability ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:avatar ],
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:enables ngm:immersive-experience,
        ngm:social-vr,
        ngm:virtual-society ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:avatar,
        ngm:digital-identity,
        ngm:virtual-world ;
    vc:isPartOf ngm:etsi-domain-taxonomy ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:decentralized-identity-did,
        ngm:digital-citizenship,
        ngm:metaverse-platform,
        ngm:nft ;
    vc:requires ngm:avatar-interoperability,
        ngm:extended-reality-xr ;
    vc:slug "etsi-domain-virtual-society" ;
    vc:sourceDomain "spatial-computing" ;
    vc:standardizedBy ngm:etsi-domain-identity-and-trust,
        ngm:etsi-domain-security-and-privacy ;
    vc:uses ngm:decentralized-governance,
        ngm:smart-contract .

ngm:etsi-gr-arf-007 a owl:Class ;
    rdfs:label "ETSI GR ARF 007"@en ;
    rdfs:comment "ETSI GR ARF 007 is a group report from the ETSI Augmented Reality Framework activity addressing aspects of AR interoperability and architecture."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:etsi ],
        ngm:technical-standard ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:etsi ;
    vc:slug "etsi-gr-arf-007" ;
    vc:sourceDomain "standards" .

ngm:etsi-gr-arf-010 a owl:Class ;
    rdfs:label "ETSI GR ARF 010"@en ;
    rdfs:comment "ETSI GR ARF 010 is a Group Report produced by the ETSI Industry Specification Group on Augmented Reality Framework (ISG ARF), defining architectural concepts, terminology, and interoperability requirements for augmented reality systems. It specifies a reference architecture that decouples AR content pipelines, tracking subsystems, and rendering layers to enable multi-vendor interoperability. The report addresses how AR devices, services, and platforms should communicate using standardised interfaces covering world anchoring, coordinate systems, and content delivery. It serves as a foundational normative reference for the broader ARF specification suite, informing subsequent standards such as ETSI GS ARF 003."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:spatial-tracking ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:reference-architecture ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:coordinate-reference-system ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:pose-estimation ],
        ngm:technical-standard ;
    vc:bridgesTo ngm:digital-twin,
        ngm:edge-computing,
        ngm:network-slicing ;
    vc:contrastsWith ngm:arcore,
        ngm:arkit,
        ngm:open-xr ;
    vc:enables ngm:ar-interoperability ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:coordinate-reference-system,
        ngm:reference-architecture,
        ngm:world-anchor ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:3-gpp,
        ngm:open-xr,
        ngm:spatial-web ;
    vc:requires ngm:pose-estimation,
        ngm:spatial-tracking ;
    vc:slug "etsi-gr-arf-010" ;
    vc:sourceDomain "spatial-computing" ;
    vc:standardizedBy ngm:etsi,
        ngm:etsi-isg-arf .

ngm:everledger a owl:Class ;
    rdfs:label "Everledger"@en ;
    rdfs:comment "A technology company that built a blockchain-based registry for tracking the provenance of high-value physical assets such as diamonds and gemstones. The registry links a unique digital record to each physical item to support authenticity and ownership claims."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:distributed-ledger-technology ],
        ngm:supply-chain ;
    vc:enables ngm:provenance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:distributed-ledger-technology ;
    vc:slug "everledger" ;
    vc:sourceDomain "blockchain" .

ngm:explanation a owl:Class ;
    rdfs:label "Explanation"@en ;
    rdfs:comment "An Explanation in the context of AI systems is a human-interpretable account of why a model produced a particular output, which features influenced the prediction, and how the system would behave differently under alternative inputs. Explanations may be global (describing overall model behaviour across the input space), local (accounting for a single prediction), or contrastive (answering why outcome A rather than outcome B). They are the primary instrument through which AI Transparency and Explainability is operationalised for stakeholders including regulators, domain experts, and affected individuals."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:feature-importance ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:post-hoc-explanation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:explainable-ai ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:model-interpretability ],
        ngm:ai-governance-and-ethics ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:contrastsWith ngm:intrinsic-interpretability ;
    vc:enables ngm:algorithmic-accountability,
        ngm:decision-transparency,
        ngm:transparency-and-explainability ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:feature-importance,
        ngm:post-hoc-explanation ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:ai-trustworthiness,
        ngm:blockchain,
        ngm:digital-twin,
        ngm:explainability,
        ngm:interpretability ;
    vc:requires ngm:explainable-ai,
        ngm:model-interpretability ;
    vc:slug "explanation" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:exploratory-concepts-seed-space a owl:Class ;
    rdfs:label "Exploratory Concepts Seed Space"@en ;
    rdfs:comment "A collection of exploratory concepts and prototype application sketches within the AI and metaverse infrastructure domain, serving as a seed space for tooling, workflows, and agentic system designs that may be formalised into distinct ontology nodes."@en ;
    rdfs:subClassOf ngm:infra-software-engineering ;
    skos:broader ngm:infra-software-engineering ;
    vc:bridgesTo ngm:ai-technique,
        ngm:machine-learning-discipline ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:agents,
        ngm:large-language-models ;
    vc:slug "exploratory-concepts-seed-space" ;
    vc:sourceDomain "infrastructure" .

ngm:external-ai-harness a owl:Class ;
    rdfs:label "External AI Harness"@en ;
    rdfs:comment "An external AI harness is an out-of-process orchestration framework that manages AI model inference via network APIs, message queues, or service meshes, providing process-boundary isolation, horizontal scalability, multi-model routing, fault tolerance, and multi-tenant governance at the cost of additional serialisation latency and inter-process communication overhead, making it the preferred architecture for enterprise-scale agentic deployments requiring auditability, model versioning, and independent component scaling."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:tool-registry ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:model-serving ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:load-balancing ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:distributed-systems ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:autoscaling ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:observability ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:model-serving ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:api-gateway ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:api-gateway ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:inference-serving ],
        ngm:agent-harness,
        ngm:evaluation-harness ;
    vc:enables ngm:ai-agent-coordination,
        ngm:autonomous-agents,
        ngm:canary-deployment,
        ngm:fault-tolerance,
        ngm:model-versioning,
        ngm:multi-agent-orchestration ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:api-gateway,
        ngm:approval-gate,
        ngm:autoscaling,
        ngm:inference-serving,
        ngm:load-balancing,
        ngm:model-serving,
        ngm:observability,
        ngm:tool-registry ;
    vc:implements ngm:agent-to-agent-protocol,
        ngm:llm-orchestration,
        ngm:microservices-architecture,
        ngm:model-context-protocol ;
    vc:qualityScore "0.9"^^xsd:float ;
    vc:relatedTo ngm:agent-execution-sandboxes,
        ngm:agent-frameworks,
        ngm:agentic-ai,
        ngm:ai-inference,
        ngm:ai-infrastructure,
        ngm:retrieval-augmented-generation ;
    vc:requires ngm:api-gateway,
        ngm:distributed-systems,
        ngm:model-serving,
        ngm:process-isolation ;
    vc:slug "external-ai-harness" ;
    vc:sourceDomain "ai" ;
    vc:supports ngm:ai-safety,
        ngm:cost-management,
        ngm:human-oversight,
        ngm:mlops,
        ngm:security ;
    vc:uses ngm:api-gateway,
        ngm:container-orchestration,
        ngm:grpc,
        ngm:kubernetes,
        ngm:message-queue,
        ngm:model-serving,
        ngm:rest-api,
        ngm:service-mesh .

ngm:f-2-pool a owl:Class ;
    rdfs:label "F2Pool"@en ;
    rdfs:comment "F2Pool is one of the oldest Bitcoin mining pools, allowing miners to combine hash power and share block rewards. It also supports mining for other cryptocurrencies."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:bitcoin-proof-of-work-protocol-mining ],
        ngm:mining-pool ;
