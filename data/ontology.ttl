ngm:audit-mechanism a owl:Class ;
    rdfs:comment "The specific technical or procedural instrument used to capture, preserve, and retrieve evidence of system events, user actions, or organisational activities for auditing purposes. Audit mechanisms range from low-level kernel event hooks and cryptographic tamper-evident logs to high-level workflow checkpoints and policy-enforcement records."@en ;
    rdfs:label "Audit Mechanism"@en ;
