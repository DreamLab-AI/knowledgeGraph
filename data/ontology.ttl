        ngm:predictive-analytics,
        ngm:stream-processing .

ngm:nonce a owl:Class ;
    rdfs:label "Nonce"@en ;
    rdfs:comment "A Nonce (Number used ONCE) is an arbitrary value included in a cryptographic computation to prevent replay attacks or to satisfy a target condition. In proof-of-work blockchains, miners increment a 32-bit nonce in the block header repeatedly until the SHA-256 hash of the header falls below the current difficulty target, thereby expending computational work proportional to the difficulty. In communications protocols, nonces ensure that each session or message produces a unique ciphertext, preventing an attacker from replaying a previously captured message."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:random-number-generator ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:proof-of-work ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptographic-hash-function ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:block-header ],
        ngm:cryptographic-primitive ;
    vc:bridgesTo ngm:oauth-state-parameter,
        ngm:tls-handshake ;
    vc:contrastsWith ngm:initialization-vector,
        ngm:salt,
        ngm:timestamp ;
    vc:dependsOn ngm:difficulty-target,
        ngm:merkle-root ;
    vc:enables ngm:authenticated-encryption,
        ngm:bitcoin-proof-of-work-protocol-mining,
        ngm:challenge-response-authentication,
        ngm:cryptographic-verification,
        ngm:replay-attack-prevention ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:block-header,
        ngm:extranonce ;
    vc:implements ngm:freshness-guarantee,
        ngm:uniqueness-constraint ;
    vc:isPartOf ngm:block-header,
        ngm:cryptography ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:block,
        ngm:block-header,
        ngm:cryptographic-security,
        ngm:message-authentication-code,
        ngm:mining,
        ngm:salt,
        ngm:session-token ;
    vc:requires ngm:cryptographic-hash-function,
        ngm:entropy-source,
        ngm:proof-of-work,
        ngm:random-number-generator ;
    vc:slug "nonce" ;
    vc:sourceDomain "security" ;
    vc:uses ngm:aes-gcm,
        ngm:counter-mode,
        ngm:sha-256 .

ngm:optimization-algorithm a owl:Class ;
    rdfs:label "Optimization Algorithm"@en ;
    rdfs:comment "A procedure that iteratively adjusts model parameters to minimise or maximise an objective function. In machine learning, optimisation algorithms govern the training dynamics of neural networks by computing gradient-based parameter updates; prominent instances include stochastic gradient descent, Adam, and their adaptive variants, each balancing convergence speed, memory cost, and generalisation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:weight-decay ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:loss-function ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:gradient-descent ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:stochastic-gradient-descent ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:learning-rate-schedule ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:backpropagation ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:adam-optimiser ],
        ngm:algorithm ;
    vc:bridgesTo ngm:numerical-methods,
        ngm:operations-research ;
    vc:contrastsWith ngm:bayesian-optimisation,
        ngm:evolutionary-algorithm ;
    vc:dependsOn ngm:automatic-differentiation,
        ngm:gradient ;
    vc:enables ngm:machine-learning-discipline-model,
        ngm:model-training,
        ngm:neural-network-architecture,
        ngm:reinforcement-learning ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:adam-optimiser,
        ngm:gradient-descent,
        ngm:learning-rate-schedule,
        ngm:momentum,
        ngm:stochastic-gradient-descent,
        ngm:weight-decay ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:convergence,
        ngm:generalisation,
        ngm:hyperparameter,
        ngm:overfitting ;
    vc:requires ngm:backpropagation,
        ngm:loss-function,
        ngm:objective-function ;
    vc:slug "optimization-algorithm" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:mini-batch,
        ngm:regularisation .

ngm:order-book a owl:Class ;
    rdfs:label "Order Book"@en ;
    rdfs:comment "An order book is a real-time, continuously updated electronic ledger that aggregates all outstanding limit buy orders (bids) and limit sell orders (asks) for a tradeable asset, organised by price level and, within each level, by time of arrival. A matching engine processes incoming market and limit orders against the resting book using price-time priority, generating trades whenever a bid price meets or exceeds an ask price. The visible depth of resting orders at each price level constitutes the liquidity profile of the market, and the gap between the best bid and best ask defines the bid-ask spread. Order books underpin both centralised exchanges and, increasingly, on-chain decentralised venues constrained by ledger throughput and gas costs."@en ;
    rdfs:subClassOf ngm:exchange-mechanism ;
    vc:bridgesTo ngm:decentralised-exchange,
        ngm:on-chain-order-book ;
    vc:contrastsWith ngm:automated-market-maker,
        ngm:dark-pool,
        ngm:request-for-quote ;
    vc:dependsOn ngm:clearing-and-settlement ;
    vc:enables ngm:liquidity-provision,
        ngm:market-making,
        ngm:price-discovery,
        ngm:trade-execution ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:ask-side,
        ngm:bid-ask-spread,
        ngm:bid-side,
        ngm:matching-engine ;
    vc:isPartOf ngm:trading-venue ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:algorithmic-trading,
        ngm:high-frequency-trading,
        ngm:market-microstructure ;
    vc:requires ngm:limit-order,
        ngm:price-time-priority ;
    vc:slug "order-book" ;
    vc:sourceDomain "finance" ;
    vc:uses ngm:depth-of-market,
        ngm:market-order .

ngm:pid-control a owl:Class ;
    rdfs:label "PID Control"@en ;
    rdfs:comment "PID (Proportional–Integral–Derivative) control is a closed-loop feedback control algorithm that computes a corrective output by summing three terms derived from the error signal: a proportional term that scales the instantaneous error, an integral term that accumulates past error to eliminate steady-state offset, and a derivative term that reacts to the rate of change of error to anticipate and damp future deviations. The control law u(t) = Kp·e(t) + Ki·∫e(τ)dτ + Kd·(de/dt) is parameterised by three tunable gains and applies universally to any plant where a measurable output can be compared against a desired setpoint. Originating in the 1940s through work by Minorsky, Ziegler, and Nichols, PID remains the dominant feedback controller in industrial automation, robotics, aerospace, and embedded systems due to its conceptual simplicity, zero requirement for an explicit plant model, and extensive supporting theory for stability analysis and gain tuning."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:derivative-control ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:proportional-control ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:sensor ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:feedback-loop ],
        ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:bridgesTo ngm:neural-network,
        ngm:reinforcement-learning ;
    vc:contrastsWith ngm:impedance-control,
        ngm:model-predictive-control,
        ngm:open-loop-control,
        ngm:sliding-mode-control ;
    vc:dependsOn ngm:control-theory,
        ngm:stability-analysis ;
    vc:enables ngm:force-control,
        ngm:motion-control,
        ngm:robot-control,
        ngm:temperature-regulation ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:derivative-control,
        ngm:integral-control,
        ngm:proportional-control ;
    vc:implements ngm:closed-loop-control ;
    vc:qualityScore "0.76"^^xsd:float ;
    vc:relatedTo ngm:adaptive-control,
        ngm:anti-windup,
        ngm:bode-plot,
        ngm:cascade-control,
        ngm:ziegler-nichols-method ;
    vc:requires ngm:feedback-loop,
        ngm:sensor,
        ngm:setpoint ;
    vc:slug "pid-control" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:actuator,
        ngm:error-signal,
        ngm:gain-tuning .

ngm:quality-of-service a owl:Class ;
    rdfs:label "Quality Of Service"@en ;
    rdfs:comment "Quality of Service (QoS) is a set of network management techniques, policies, and protocols that prioritise, shape, and guarantee specified performance characteristics—including latency, jitter, throughput, and packet loss—for distinct traffic classes traversing shared network infrastructure. QoS mechanisms operate at multiple OSI layers, using traffic classification, queuing disciplines, scheduling algorithms, and admission control to meet differentiated service-level objectives. In real-time systems such as XR, telepresence, and cloud-native distributed applications, QoS is essential for maintaining acceptable user experience under variable load. Standardised frameworks including IntServ, DiffServ, and IEEE 802.1p provide interoperable models for end-to-end QoS across heterogeneous networks."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:network-protocol ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:network-infrastructure ],
        ngm:network-infrastructure ;
    vc:bridgesTo ngm:edge-computing,
        ngm:extended-reality ;
    vc:contrastsWith ngm:best-effort-delivery ;
    vc:dependsOn ngm:packet-switching,
        ngm:routing ;
    vc:enables ngm:low-latency-networking,
        ngm:real-time,
        ngm:service-level-agreement,
        ngm:telecollaboration ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:implements ngm:differentiated-services,
        ngm:integrated-services ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:bandwidth-adaptation,
        ngm:jitter,
        ngm:latency,
        ngm:network-congestion ;
    vc:requires ngm:network-infrastructure,
        ngm:network-protocol,
        ngm:traffic-classification ;
    vc:slug "quality-of-service" ;
    vc:sourceDomain "infrastructure" ;
    vc:standardizedBy ngm:ieee-802-1,
        ngm:ietf ;
    vc:supports ngm:cloud-computing,
        ngm:video-streaming,
        ngm:voice-over-ip ;
    vc:uses ngm:admission-control,
        ngm:queuing-discipline,
        ngm:traffic-shaping .

ngm:recommendation-system a owl:Class ;
    rdfs:label "Recommendation System"@en ;
    rdfs:comment "A recommendation system is an information filtering infrastructure that predicts and surfaces items, content, or actions likely to be of interest to a specific user, based on behavioural history, explicit preferences, item features, or combinations thereof. It encompasses collaborative filtering approaches that exploit user-item interaction patterns, content-based methods that match item attributes to user profiles, and hybrid models that combine multiple signals. Modern recommendation systems employ deep learning, graph neural networks, and large language models to capture complex preference patterns at scale. They are commercially critical infrastructure in e-commerce, streaming media, social networks, and digital advertising."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:feature-engineering ],
        ngm:machine-learning-discipline-technique ;
    vc:bridgesTo ngm:knowledge-graph,
        ngm:large-language-model ;
    vc:contrastsWith ngm:search-engine ;
    vc:dependsOn ngm:data-pipeline,
