        vf:depth-estimation,
        vf:feature-extraction,
        vf:human-tracking-and-slam-capture,
        vf:image-classification,
        vf:point-cloud ;
    vc:maturity "production-ready" ;
    vc:qualityScore "0.52"^^xsd:float ;
    vc:requires vf:camera-parameters,
        vf:digital-signal-processing,
        vf:edge-computing,
        vf:fpga,
        vf:infrared-led-illuminator,
