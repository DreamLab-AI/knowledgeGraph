ngm:price-discovery a owl:Class ;
    rdfs:label "Price Discovery"@en ;
    rdfs:comment "Price discovery is the market mechanism through which asset prices are determined via the continuous interaction of buyers and sellers, incorporating supply/demand dynamics, order flow analysis, bid-ask spread formation, and arbitrage across venues to establish fair market value in real-time."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:liquidity ],
        [ a owl:Restriction ;
