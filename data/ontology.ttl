    vc:sourceDomain "spatial-computing" .

ngm:interaction-domain a owl:Class ;
    rdfs:label "Interaction Domain"@en ;
    rdfs:comment "The Interaction Domain is the ontological framework that structures all human-computer interaction (HCI) phenomena, covering interactive systems, user interfaces, input modalities, and the cognitive and physical processes by which users engage with digital environments. It provides formal representation of user-experience elements, adaptive interface patterns, and multi-modal interaction channels including voice, gesture, haptics, and natural language. As spatial computing matures, the domain expands to encompass embodied interaction within augmented and virtual spaces."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:human-computer-interaction ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
