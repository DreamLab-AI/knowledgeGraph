    skos:broader ngm:sc-platform-and-environment ;
    vc:bridgesTo ngm:enterprise-architecture ;
    vc:enables ngm:scalable-deployment,
        ngm:standards-compliance,
        ngm:system-interoperability ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires ngm:data-models,
        ngm:reference-architecture ;
    vc:slug "digital-twin-framework" ;
