vf:deepfakes a owl:Class ;
    rdfs:label "Deepfakes"@en ;
    rdfs:comment "AI-generated or manipulated synthetic media content that convincingly alters a person's appearance, voice, or actions using deep learning techniques such as GANs, autoencoders, and voice synthesis models."@en ;
