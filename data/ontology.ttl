ngm:jing a owl:Class ;
    rdfs:label "jing"@en ;
    rdfs:comment "Jing is a multi-agent AI framework designed to minimise hallucination in Chinese-English bilingual retrieval-augmented generation (RAG) pipelines, specifically applied to emotional-support chatbots for end-of-life counselling and palliative care. The system combines multiple large language models with open-source text-to-speech engines and real-time 3D avatars to deliver culturally sensitive, affectively aware conversational companions, initially targeting Japanese VR screen deployment contexts. Its multi-agent architecture distributes validation, retrieval, and generation tasks across specialised model instances to improve factual grounding and reduce hallucinated responses in high-stakes care settings."@en ;
    rdfs:subClassOf ngm:infra-software-engineering ;
    skos:broader ngm:infra-software-engineering ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:digital-avatar,
        ngm:emotional-intelligence,
        ngm:healthcare-ai ;
    vc:slug "jing" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:virtual-reality-applications ;
    vc:uses ngm:large-language-models,
        ngm:multi-agent-systems,
        ngm:retrieval-augmented-generation,
        ngm:text-to-speech .

