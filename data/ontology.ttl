ngm:mentions-and-notifications a owl:Class ;
    rdfs:label "Mentions and Notifications"@en ;
    rdfs:comment "Mentions and notifications are mechanisms that direct a participant's attention to specific messages, tasks, or events by referencing their identity with an @-symbol or equivalent trigger. They bridge asynchronous communication gaps by alerting individuals even when they are not actively monitoring a channel. Effective notification design balances urgency with focus protection to avoid alert fatigue in distributed teams."@en ;
    rdfs:subClassOf ngm:dc-communication ;
    skos:broader ngm:dc-communication ;
    vc:enables ngm:attention ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:group-chat-channel,
        ngm:instant-messaging ;
    vc:slug "mentions-and-notifications" ;
    vc:sourceDomain "distributed-collaboration" .

ngm:message-passing-interface a owl:Class ;
    rdfs:label "Message Passing Interface"@en ;
    rdfs:comment "Message Passing Interface (MPI) is a standardised communication protocol and application programming interface for parallel and distributed computing. It defines primitives for point-to-point and collective communication between processes running across multiple compute nodes, enabling tightly coupled high-performance computing workloads. MPI is the de facto standard for scientific computing, numerical simulations, and distributed AI training at supercomputer scale."@en ;
    rdfs:subClassOf ngm:infrastructure ;
    skos:broader ngm:infrastructure ;
    vc:contrastsWith ngm:shared-memory-model ;
    vc:dependsOn ngm:cluster-computing,
        ngm:high-performance-computing ;
    vc:enables ngm:distributed-training,
        ngm:numerical-simulation ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:implements ngm:collective-communication,
        ngm:distributed-computing ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:cuda,
        ngm:openmp,
        ngm:remote-direct-memory-access,
        ngm:supercomputing ;
    vc:slug "message-passing-interface" ;
    vc:sourceDomain "infrastructure" ;
    vc:standardizedBy ngm:mpi-forum ;
    vc:supports ngm:data-parallelism,
        ngm:machine-learning ;
    vc:uses ngm:infiniband,
        ngm:network-fabric,
        ngm:parallel-computing .

ngm:messagepack a owl:Class ;
    rdfs:label "Messagepack"@en ;
    rdfs:comment "MessagePack is a binary data serialisation format that encodes structured data compactly while preserving a data model compatible with JSON, allowing maps, arrays, strings, integers, and floats to be transmitted in far fewer bytes than their textual equivalents. It uses a type-prefixed encoding that minimises overhead, making it well-suited to high-throughput messaging, caching, and inter-service communication. MessagePack trades human readability for speed and compactness, sitting between verbose JSON and schema-bound formats like Protocol Buffers."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:binary-encoding ],
        ngm:data-serialization ;
    vc:bridgesTo ngm:infrastructure ;
    vc:contrastsWith ngm:json-data-interchange-format,
        ngm:protocol-buffer ;
    vc:enables ngm:embedded-systems,
        ngm:message-queue ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:data-serialization ;
    vc:isPartOf ngm:data-serialization ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:cbor,
        ngm:json-data-interchange-format,
        ngm:protocol-buffer ;
    vc:requires ngm:binary-encoding ;
    vc:slug "messagepack" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:internet-of-things ;
    vc:uses ngm:binary-encoding .

ngm:meta-llama-model-family-index a owl:Class ;
    rdfs:label "LlamaIndex"@en ;
    rdfs:comment "LlamaIndex (formerly GPT Index) is an open-source data framework and Python library that provides the abstractions and tooling needed to connect large language models with external data sources through structured indexing, retrieval, and query pipelines, primarily enabling production-grade retrieval-augmented generation (RAG) applications. It handles the full pipeline from document ingestion and chunking, through embedding and vector storage, to query decomposition, retrieval, reranking, and response synthesis, providing high-level abstractions over underlying LLMs, embedding models, and vector databases. LlamaIndex is positioned as the data orchestration complement to LangChain's agent orchestration focus, with particular strength in structured data retrieval and multi-document reasoning."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:text-embeddings ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:chunking ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:python ],
        ngm:agent-frameworks ;
    vc:bridgesTo ngm:data,
        ngm:infrastructure ;
    vc:contrastsWith ngm:lang-chain ;
    vc:enables ngm:knowledge-graph-construction,
        ngm:multi-agent-systems,
        ngm:question-answering,
        ngm:retrieval-augmented-generation,
        ngm:semantic-search ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:data-connectors,
        ngm:reranking ;
    vc:implements ngm:agentic-workflow,
        ngm:rag-pipeline ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:fine-tuning,
        ngm:information-retrieval,
        ngm:prompt-engineering ;
    vc:requires ngm:chunking,
        ngm:python,
        ngm:text-embeddings ;
    vc:slug "llama-index" ;
    vc:sourceDomain "ai" ;
    vc:supports ngm:enterprise-ai,
        ngm:natural-language-processing ;
    vc:uses ngm:embeddings,
        ngm:large-language-models,
        ngm:nearest-neighbor-search,
        ngm:transformer,
        ngm:vector-database .

ngm:metal-api a owl:Class ;
    rdfs:label "Metal Api"@en ;
    rdfs:comment "Metal is Apple's low-level graphics and compute application programming interface that provides near-direct access to the GPU on Apple platforms. It minimises driver overhead, exposes explicit command-buffer and resource management, and unifies rendering and general-purpose compute under one programming model. Metal is the platform-native alternative to cross-vendor APIs such as Vulkan and the legacy OpenGL on Apple hardware."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:graphics-api ],
        ngm:graphics-api ;
