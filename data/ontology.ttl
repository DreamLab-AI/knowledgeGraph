    vc:requires ngm:key-management ;
    vc:requires ngm:threshold-cryptography ;
    vc:slug "mpc-wallet" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:decentralized-exchange ;
    vc:uses ngm:private-key ;
