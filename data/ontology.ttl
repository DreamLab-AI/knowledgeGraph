ngm:torque-control a owl:Class ;
    rdfs:label "Torque Control"@en ;
    rdfs:comment "A low-level actuation strategy that directly commands the output torque of joints or motors rather than position or velocity, enabling compliant, force-sensitive interaction between a robot and its environment. Torque control is essential for safe human-robot collaboration and dexterous manipulation tasks."@en ;
    rdfs:subClassOf ngm:motion-control,
        ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:enables ngm:collaborative-systems-modality-robot,
        ngm:human-robot-interaction ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:feedback-control,
        ngm:inverse-kinematics,
        ngm:pid-control,
        ngm:robot-kinematics,
        ngm:servo-control ;
    vc:slug "torque-control" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:actuator,
        ngm:robot-actuator .

ngm:uniswap a owl:Class ;
    rdfs:label "Uniswap"@en ;
    rdfs:comment "Uniswap is a decentralised exchange (DEX) protocol deployed on Ethereum and EVM-compatible blockchains that enables permissionless, non-custodial token swaps through an Automated Market Maker (AMM) mechanism. Rather than maintaining an order book, it uses liquidity pools governed by the constant-product invariant (x × y = k), where liquidity providers deposit token pairs and earn fees proportional to their pool share. Successive protocol versions have introduced concentrated liquidity (v3), multiple fee tiers, multi-hop routing, and hook-based extensibility (v4), making Uniswap a foundational primitive of decentralised finance. Governance is managed by holders of the UNI governance token through on-chain voting."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:liquidity-provider ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:liquidity-pool ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ethereum ],
        ngm:bc-defi-and-economics ;
    skos:broader ngm:bc-defi-and-economics ;
    vc:bridgesTo ngm:decentralised-autonomous-organisation,
        ngm:layer-2-scaling ;
    vc:contrastsWith ngm:centralised-exchange,
        ngm:order-book-exchange ;
    vc:dependsOn ngm:on-chain-governance,
        ngm:price-oracle,
        ngm:token-economics ;
    vc:enables ngm:decentralised-finance,
        ngm:permissionless-token-listing,
        ngm:token-swap,
        ngm:yield-farming ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:factory-contract,
        ngm:liquidity-pool,
        ngm:router-contract,
        ngm:uni-governance-token ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:curve-finance,
        ngm:flash-loan,
        ngm:impermanent-loss,
        ngm:mev,
        ngm:sushiswap ;
    vc:requires ngm:ethereum,
        ngm:liquidity-provider,
        ngm:web3-wallet ;
    vc:slug "uniswap" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:automated-market-maker,
        ngm:erc-20,
        ngm:ethereum-virtual-machine,
        ngm:smart-contract .

ngm:user-safety a owl:Class ;
    rdfs:label "User Safety"@en ;
    rdfs:comment "User Safety encompasses the technical, design, policy, and governance measures deployed by platforms and application developers to protect users from harm across digital and immersive environments, including harassment, predatory behaviour, unwanted exposure to harmful content, physical discomfort from extended use, and violations of privacy or consent. In spatially embodied contexts such as extended reality and the metaverse, abusive interactions carry heightened psychological impact because spatial audio, avatar proximity, and embodied presence amplify the subjective experience of harm beyond that typical of text-based social media. Effective user safety frameworks integrate proactive content moderation, privacy-preserving reporting, age-appropriate design, graduated enforcement mechanisms, and platform governance structures accountable to regulators and communities alike. The discipline draws on human factors research, risk management, digital rights law, and AI-driven trust-and-safety tooling to balance protection against harm with preservation of free expression and user autonomy."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:age-verification ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:consent-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:content-moderation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:privacy ],
        ngm:governance-framework ;
    vc:bridgesTo ngm:ai-ethics,
        ngm:regulatory-compliance ;
    vc:contrastsWith ngm:censorship,
