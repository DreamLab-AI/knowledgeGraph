ngm:participant-coordination a owl:Class ;
    rdfs:label "Participant Coordination"@en ;
    rdfs:comment "The synchronization and management of multiple users interacting within shared virtual environments, requiring real-time pose tracking, coordinate system alignment, and collaborative state management to enable seamless multi-user experiences."@en ;
    rdfs:subClassOf ngm:multi-user-systems ;
    vc:enables ngm:shared-virtual-experiences ;
    vc:maturity "draft" ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:slug "participant-coordination" ;
    vc:sourceDomain "spatial-computing" .

ngm:participant-management-system a owl:Class ;
    rdfs:label "Participant Management System"@en ;
    rdfs:comment "A platform for organizing event attendees through registration, invitation management, check-in tracking, and real-time attendance monitoring, providing tools for ticketing, payment processing, and post-event analytics."@en ;
    rdfs:subClassOf ngm:event-management ;
    vc:enables ngm:event-analytics ;
    vc:maturity "draft" ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:slug "participant-management-system" ;
    vc:sourceDomain "spatial-computing" .

