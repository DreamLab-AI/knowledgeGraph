    vc:enables ngm:shader ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:interpolation ;
    vc:implements ngm:gpu-computing ;
    vc:isPartOf ngm:spatial-computing ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:gpu-computing ;
    vc:relatedTo ngm:interpolation ;
    vc:relatedTo ngm:shader ;
    vc:slug "noise-function" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:procedural-generation ;
    vc:uses ngm:interpolation ;
    vc:uses ngm:random-number-generation .
ngm:noise-function-library a owl:Class ;
    rdfs:comment "A software library providing coherent noise generation algorithms like Perlin, simplex, value, and Voronoi noise for procedural content generation in computer graphics, enabling the creation of natural-looking textures, terrain, and visual effects without manual authoring."@en ;
    rdfs:label "Noise Function Library"@en ;
    rdfs:subClassOf ngm:graphics-library ;
    rdfs:subClassOf ngm:sc-display-and-rendering ;
    skos:broader ngm:sc-display-and-rendering ;
    vc:enables ngm:procedural-content ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:slug "noise-function-library" ;
    vc:sourceDomain "spatial-computing" .
ngm:noise-injection a owl:Class ;
    rdfs:comment "Noise injection is the deliberate addition of random perturbations — Gaussian noise, dropout-style masking, token swaps or signal distortions — to inputs, hidden activations, weights or gradients during training or data generation. As a data augmentation and regularisation technique it discourages over-fitting and improves robustness to distribution shift; in generative adversarial networks it supplies the stochastic latent input that drives sample diversity, and in differential privacy calibrated noise provides formal privacy guarantees."@en ;
    rdfs:label "Noise Injection"@en ;
    rdfs:subClassOf ngm:data-augmentation ;
    vc:enables ngm:robustness ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:back-translation ;
    vc:isPartOf ngm:data-augmentation ;
