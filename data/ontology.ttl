        ngm:natural-language-processing,
        ngm:open-source-ai ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:hugging-face-diffusers,
        ngm:hugging-face-hub,
        ngm:parameter-efficient-fine-tuning,
        ngm:transformers-library ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:bert,
        ngm:hugging-face-model-hub,
        ngm:low-rank-adaptation,
        ngm:responsible-ai ;
    vc:requires ngm:deep-learning,
        ngm:gpu-computing ;
    vc:slug "hugging-face" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:large-language-models,
