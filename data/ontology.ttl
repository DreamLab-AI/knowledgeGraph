        ngm:sensor-fusion .

ngm:light-field-display a owl:Class ;
    rdfs:label "Light Field Display"@en ;
    rdfs:comment "A Light Field Display is an output device that reproduces the full four-dimensional light field of a scene, emitting rays of light in directions that recreate the optical properties of real objects without requiring the viewer to wear special glasses. Unlike conventional stereoscopic displays, light field displays support motion parallax, correct focus cues, and multiple simultaneous viewer perspectives. They are a key enabling technology for glasses-free holographic telepresence and high-fidelity volumetric visualisation in collaborative settings."@en ;
    rdfs:subClassOf ngm:dc-telepresence ;
    skos:broader ngm:dc-telepresence ;
    vc:enables ngm:holographic-telepresence ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:photorealistic-telepresence,
        ngm:volumetric-video ;
    vc:slug "light-field-display" ;
    vc:sourceDomain "distributed-collaboration" .

ngm:linked-data-encoder a owl:Class ;
    rdfs:label "Linked Data Encoder"@en ;
    rdfs:comment "A semantic encoding pipeline that transforms agent state, credentials, events, and metadata into JSON-LD 1.1 format using pinned, versioned JSON-LD Context|W3C JSON-LD contexts, enabling standardised Federation Surface|federation surfaces (S1–S11) that are queryable, linkable, and mac..."@en ;
