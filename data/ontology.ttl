    vc:slug "data-virtualization" ;
    vc:sourceDomain "infrastructure" .

ngm:de-fi-services a owl:Class ;
    rdfs:label "De Fi Services"@en ;
    rdfs:comment "Decentralised Finance (DeFi) Services are financial products and protocols—including lending, borrowing, automated market-making, and derivatives—implemented as smart contracts on programmable blockchains without centralised intermediaries. DeFi Services enable permissionless, non-custodial access to financial primitives and are a key component of virtual economies within metaverse and spatial computing platforms."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
