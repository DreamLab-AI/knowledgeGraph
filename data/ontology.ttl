    vc:contrastsWith ngm:deregulation ;
    vc:dependsOn ngm:rule-of-law ;
    vc:enables ngm:data-sovereignty,
        ngm:digital-trust,
        ngm:open-government ;
    vc:hasMaturity ngmi:maturity-established ;
