ngm:model-collapse a owl:Class ;
    rdfs:label "Model Collapse"@en ;
    rdfs:comment "Model collapse is a degenerative process in which generative models trained recursively on their own (or other models') synthetic outputs progressively lose information about the true data distribution. Tails of the distribution disappear first, leading to reduced diversity, amplified biases, and eventual convergence on degenerate outputs. It is a key risk as AI-generated content increasingly contaminates web-scale training corpora."@en ;
    rdfs:subClassOf ngm:ai-safety ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:death-of-the-internet,
        ngm:feedback-loop ;
    vc:slug "model-collapse" ;
    vc:sourceDomain "ai" .

ngm:model-depth a owl:Class ;
    rdfs:label "Model Depth"@en ;
    rdfs:comment "The count of stacked transformer layers (encoder, decoder, or both) in a neural network, governing the number of sequential representation transformations. Greater depth enables more abstract hierarchical feature learning but increases training difficulty, requiring residual connections and layer normalisation to stabilise gradient flow."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:residual-connection ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:layer-normalisation ],
        ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:contrastsWith ngm:model-width ;
    vc:dependsOn ngm:hyperparameter,
        ngm:transformer ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:deep-learning,
        ngm:parameter-count ;
    vc:requires ngm:layer-normalisation,
        ngm:residual-connection ;
    vc:slug "model-depth" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:monocular-depth-estimation a owl:Class ;
    rdfs:label "Monocular Depth Estimation"@en ;
    rdfs:comment "Monocular depth estimation is the task of inferring the distance of scene points from a single image, recovering a depth map without the explicit stereo disparity available from multiple cameras. Because depth from one view is inherently ambiguous, modern approaches learn statistical and contextual cues such as texture gradients, object size, and perspective, typically using deep convolutional or transformer networks trained on labelled or self-supervised data. It contrasts with stereo and active depth sensing while offering a low-cost route to three-dimensional perception."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:convolutional-neural-network ],
        ngm:depth-estimation ;
    vc:bridgesTo ngm:augmented-reality ;
    vc:contrastsWith ngm:lidar,
        ngm:stereo-vision ;
    vc:enables ngm:scene-understanding ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:computer-vision,
        ngm:depth-estimation ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:depth-sensing,
        ngm:point-cloud,
        ngm:slam,
        ngm:structure-from-motion ;
    vc:requires ngm:convolutional-neural-network ;
    vc:slug "monocular-depth-estimation" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:augmented-reality,
        ngm:scene-understanding ;
    vc:uses ngm:convolutional-neural-network,
        ngm:self-supervised-learning .

ngm:monolithic-ai a owl:Class ;
    rdfs:label "Monolithic Ai"@en ;
    rdfs:comment "Monolithic AI refers to a design paradigm in which a single, large, undivided model or system handles all tasks within an AI application, as opposed to decomposed or modular architectures. The term is most often used to contrast with multi-agent, mixture-of-experts, or microservice-based AI designs. Monolithic AI systems are simpler to deploy but harder to update, scale selectively, or audit at component level."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:neural-network ],
        ngm:artificial-intelligence ;
    skos:broader ngm:artificial-intelligence ;
    vc:bridgesTo ngm:distributed-ai ;
    vc:contrastsWith ngm:agentic-ai,
        ngm:microservice,
        ngm:mixture-of-experts,
        ngm:modular-ai,
        ngm:multi-agent-system ;
    vc:dependsOn ngm:inference-engine,
        ngm:training-pipeline ;
    vc:enables ngm:end-to-end-learning,
        ngm:model-deployment ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:neural-network ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:foundation-model,
        ngm:large-language-model,
        ngm:neural-network ;
    vc:slug "monolithic-ai" ;
    vc:sourceDomain "ai" ;
    vc:supports ngm:model-serving .

ngm:motion-capture-technology a owl:Class ;
    rdfs:label "Motion Capture Technology"@en ;
    rdfs:comment "Motion Capture Technology refers to systems that record the position and orientation of physical bodies—human performers, objects, or camera rigs—in three-dimensional space, producing skeletal or marker-based data streams used to animate digital avatars, create realistic character performances, and drive real-time spatial computing applications."@en ;
