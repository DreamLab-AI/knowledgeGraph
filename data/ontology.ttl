ngm:proprioceptive-sensing a owl:Class ;
    rdfs:label "Proprioceptive Sensing"@en ;
    rdfs:comment "Proprioceptive sensing is a robot's perception of its own internal state, such as joint angles, motor torques, link velocities, and body orientation, as distinct from exteroceptive sensing of the external environment. It relies on encoders, force/torque sensors, and inertial measurement units. It is essential for balance, whole-body control, and safe interaction, especially in legged and humanoid robots."@en ;
    rdfs:subClassOf ngm:robo-perception ;
    skos:broader ngm:robo-perception ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:humanoid-robot,
        ngm:mechanical-component ;
    vc:slug "proprioceptive-sensing" ;
    vc:sourceDomain "robotics" .

ngm:proteus-effect a owl:Class ;
    rdfs:label "Proteus Effect"@en ;
    rdfs:comment "The Proteus Effect is the phenomenon whereby the visual characteristics of a user's digital avatar unconsciously shape that user's own behaviour, attitudes, and self-perception within virtual environments. Named after the shape-shifting Greek deity, it was empirically demonstrated by Yee and Bailenson (2007): users assigned taller or more attractive avatars exhibited corresponding shifts in confidence and social openness, while users embodying outgroup avatars showed reduced implicit bias. The effect arises through the intersection of self-perception theory, stereotype activation, and embodied cognition, and has direct implications for therapeutic applications, metaverse platform design, and ethical avatar-assignment practices."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:virtual-environment ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:avatar ],
        ngm:metaverse,
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:enables ngm:behavioral-modeling,
        ngm:immersive-experience ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:avatar-customization,
        ngm:embodied-ai,
        ngm:social-presence,
        ngm:vr-psychology ;
    vc:requires ngm:avatar,
        ngm:virtual-environment ;
    vc:slug "proteus-effect" ;
    vc:sourceDomain "spatial-computing" .

ngm:protocol-owned-liquidity a owl:Class ;
    rdfs:label "Protocol-Owned Liquidity"@en ;
    rdfs:comment "Protocol-owned liquidity (POL) is a DeFi treasury strategy in which a protocol acquires and holds its own trading-pair liquidity rather than renting it from third-party liquidity providers through mercenary incentives. By owning the liquidity, the protocol earns trading fees, gains durable market depth, and reduces dependence on emissions that can trigger capital flight. It was popularised by bonding mechanisms in OlympusDAO-style designs."@en ;
    rdfs:subClassOf ngm:bc-defi-and-economics ;
    skos:broader ngm:bc-defi-and-economics ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:treasury-management ;
    vc:slug "protocol-owned-liquidity" ;
    vc:sourceDomain "blockchain" .

ngm:proxemics a owl:Class ;
    rdfs:label "Proxemics"@en ;
    rdfs:comment "The study and application of interpersonal and human-robot spatial relationships — including intimate, personal, social, and public distance zones — to design robotic systems that behave in spatially appropriate ways. Proxemics-aware robots adjust their approach trajectories, velocities, and stopping distances in response to detected human zones, improving perceived safety, comfort, and social acceptability in shared environments."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:proximity-detection ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:motion-planning ],
        ngm:robo-human-robot-interaction ;
    skos:broader ngm:robo-human-robot-interaction ;
    vc:enables ngm:collision-avoidance,
        ngm:embodied-ai ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:human-robot-interaction,
        ngm:social-robotics ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:attention-aware-interaction,
        ngm:emotion-aware-interaction,
        ngm:human-computer-interaction ;
    vc:requires ngm:motion-planning,
        ngm:proximity-detection ;
    vc:slug "proxemics" ;
    vc:sourceDomain "robotics" .

ngm:push-notification a owl:Class ;
    rdfs:label "Push Notification"@en ;
    rdfs:comment "A push notification is a server-initiated message delivered to a client device or application without an explicit client request, enabling real-time alerts about events, state changes, or incoming communications. It relies on persistent connections or platform push services that maintain a delivery channel even when the application is backgrounded. It is a foundational primitive for presence, messaging, and event-driven user engagement."@en ;
    rdfs:subClassOf ngm:communication-protocol ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:identity-provider,
        ngm:presence-indicator ;
    vc:slug "push-notification" ;
    vc:sourceDomain "infrastructure" .

ngm:qt-framework a owl:Class ;
    rdfs:label "Qt Framework"@en ;
    rdfs:comment "Qt is a cross-platform C++ application and UI framework providing widgets, a declarative QML language, signals-and-slots event handling, and abstractions for graphics, networking, and threading. It enables a single codebase to target desktop, mobile, and embedded platforms with native look and feel. It is widely used to build performant desktop clients and 3D-capable interfaces."@en ;
    rdfs:subClassOf ngm:software-development ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:vircadia ;
    vc:slug "qt-framework" ;
    vc:sourceDomain "infrastructure" .

ngm:quality-control a owl:Class ;
    rdfs:label "Quality Control"@en ;
    rdfs:comment "Quality control is the operational process of inspecting, testing, and verifying products or outputs against defined specifications to detect and remove defects before delivery. In manufacturing it spans dimensional inspection, surface-defect detection, and statistical process control, increasingly automated through machine vision. It reduces scrap, ensures conformance, and provides feedback for process improvement."@en ;
    rdfs:subClassOf ngm:computer-vision ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:computer-vision,
        ngm:manufacturing-domain ;
    vc:slug "quality-control" ;
    vc:sourceDomain "ai" .

ngm:quantum-network-node a owl:Class ;
    rdfs:label "Quantum Network Node"@en ;
    rdfs:comment "Physical device utilizing quantum mechanics principles to enable quantum key distribution (QKD) or entanglement transmission for ultra-secure communication channels."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
