ngm:ai-safety-institute a owl:Class ;
    rdfs:label "AI Safety Institute"@en ;
    rdfs:comment "An AI Safety Institute (AISI) is a state-backed organisation established to evaluate, test, and research the capabilities and safety risks of advanced AI systems, particularly frontier models. Such bodies conduct pre-deployment and post-deployment evaluations, develop standardised benchmarks for dangerous capability elicitation, and advise governments on AI risk policy. The UK established the world's first AISI in November 2023 at the Bletchley Park AI Safety Summit; the US, Japan, Canada, and other nations subsequently established counterpart bodies. The UK later renamed its institute the AI Security Institute (DSIT) to reflect an expanded emphasis on national-security-relevant AI risks."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:frontier-ai ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ai-evaluation ],
        ngm:ai-safety ;
    vc:bridgesTo ngm:national-security,
        ngm:standards-body ;
    vc:contrastsWith ngm:ai-ethics-board ;
    vc:enables ngm:ai-alignment,
        ngm:ai-policy ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:ai-governance,
        ngm:ai-policy ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:ai-safety-summit,
        ngm:bletchley-declaration,
        ngm:existential-ai-risk,
        ngm:large-language-model ;
    vc:requires ngm:ai-evaluation,
        ngm:frontier-ai ;
    vc:slug "ai-safety-institute" ;
    vc:sourceDomain "governance" ;
    vc:supports ngm:ai-regulation,
        ngm:ai-risk-assessment,
        ngm:responsible-ai ;
    vc:uses ngm:benchmarking,
        ngm:capability-evaluation,
        ngm:interpretability,
        ngm:red-teaming .

ngm:ai-system-component a owl:Class ;
    rdfs:label "AI System Component"@en ;
    rdfs:comment "Modular functional units constituting a complete artificial intelligence system, including data ingestion pipelines, feature engineering modules, model training infrastructure, inference engines, monitoring dashboards, and user interfaces. Modern AI systems adopt microservices architectures enabling independent scaling, version control, and A/B testing per component, with observability integrated at each layer for production reliability."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:data-pipeline ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:machine-learning-discipline-pipeline ],
        ngm:ai-infrastructure ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:data-pipeline,
        ngm:machine-learning-discipline-pipeline ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:slug "ai-system-component" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:ai-infrastructure,
        ngm:ai-lifecycle ;
    vc:uses ngm:machine-learning-discipline-model,
        ngm:microservices-architecture .

ngm:ai-talent a owl:Class ;
    rdfs:label "AI Talent"@en ;
    rdfs:comment "The human capital pool comprising individuals with specialised skills in machine learning research, AI engineering, data science, and related disciplines who design, build, evaluate, and govern artificial intelligence systems. AI talent is a scarce and strategically contested resource, with demand from frontier laboratories, technology companies, and public-sector institutions consistently outpacing the supply produced by academic programmes. The composition of the talent pool—including its geographic distribution, diversity, and specialisation—directly shapes the pace and direction of AI progress."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:ai-safety-research ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:data-science ],
        ngm:human-capital,
        ngm:workforce-development ;
    vc:dependsOn ngm:ai-investment,
        ngm:compute-infrastructure,
        ngm:education-and-ai ;
    vc:enables ngm:ai-model-development,
        ngm:ai-safety-research,
        ngm:frontier-ai,
        ngm:technological-leadership ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:ai-research-talent,
        ngm:ai-safety-research,
        ngm:alignment-research,
        ngm:data-science,
        ngm:ml-engineering ;
    vc:qualityScore "0.88"^^xsd:float ;
    vc:relatedTo ngm:ai-talent-war,
        ngm:education-and-ai,
        ngm:talent-concentration ;
    vc:slug "ai-talent" ;
    vc:sourceDomain "ai" ;
    vc:supports ngm:ai-governance-framework,
        ngm:economic-competitiveness,
        ngm:innovation-ecosystems .

ngm:algorithmic-impact-assessment a owl:Class ;
    rdfs:label "Algorithmic Impact Assessment"@en ;
    rdfs:comment "An algorithmic impact assessment is a structured governance process for evaluating the potential effects of an automated decision-making or artificial-intelligence system on individuals, groups and society before and during its deployment. It documents the system's purpose, data, risks to fairness, privacy and safety, and the mitigations and oversight controls in place, producing an auditable record for accountability. Modelled on data-protection and environmental impact assessments, it is increasingly mandated by AI regulation and procurement frameworks to ensure responsible and transparent use of algorithms."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:transparency ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:stakeholder-engagement ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:human-oversight ],
        ngm:ai-governance ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:implements ngm:accountability,
        ngm:algorithmic-accountability,
        ngm:responsible-ai ;
    vc:isPartOf ngm:ai-governance ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:ai-ethics,
        ngm:ai-impact-assessment,
        ngm:compliance-framework,
        ngm:data-protection-impact-assessment,
        ngm:gdpr,
        ngm:impact-assessment,
        ngm:model-governance,
        ngm:privacy-impact-assessment ;
    vc:requires ngm:human-oversight,
        ngm:stakeholder-engagement,
        ngm:transparency ;
    vc:slug "algorithmic-impact-assessment" ;
    vc:sourceDomain "governance" ;
    vc:supports ngm:ai-regulation,
        ngm:fairness,
        ngm:regulatory-compliance ;
    vc:uses ngm:algorithmic-bias,
        ngm:bias,
        ngm:explainability,
        ngm:risk-assessment .

ngm:algorithmic-transparency-index a owl:Class ;
    rdfs:label "Algorithmic Transparency Index"@en ;
    rdfs:comment "A structured metrics framework for measuring and evaluating the explainability, documentation, and disclosure levels of AI algorithms and automated decision-making systems across multiple transparency dimensions."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
