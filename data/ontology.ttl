    vc:contrastsWith ngm:centralised-identity,
        ngm:federated-identity ;
    vc:dependsOn ngm:decentralized-identity,
        ngm:digital-identity-wallet ;
    vc:enables ngm:age-verification,
        ngm:anonymous-credential,
        ngm:identity-verification,
