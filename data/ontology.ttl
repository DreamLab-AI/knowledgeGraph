ngm:iso-28000 a owl:Class ;
    rdfs:label "ISO 28000"@en ;
    rdfs:comment "An ISO standard specifying requirements for a security management system, including aspects relevant to supply chain security. It can be used as a basis for assessing and certifying an organisation's security management."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
