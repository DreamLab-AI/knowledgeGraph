ngm:impact-investing a owl:Class ;
    rdfs:label "Impact Investing"@en ;
    rdfs:comment "Impact investing is an investment approach that intentionally seeks to generate measurable positive social or environmental outcomes alongside a financial return. It is distinguished from conventional investing by the explicit intent to create impact and by the commitment to measure and report that impact against defined indicators. Impact investing spans asset classes and is a core practice within sustainable finance."@en ;
    rdfs:subClassOf ngm:economic-mechanism ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:sustainable-finance ;
    vc:slug "impact-investing" ;
    vc:sourceDomain "governance" ;
    vc:supports ngm:carbon-neutral-blockchain .

ngm:incident-reporting a owl:Class ;
    rdfs:label "Incident Reporting"@en ;
    rdfs:comment "Incident Reporting is a systematic process by which organisations detect, document, classify, and communicate adverse events, near-misses, or anomalous system behaviours to relevant stakeholders, regulatory bodies, and affected parties. In AI and digital systems contexts, it covers cybersecurity breaches, AI system failures, algorithmic harms, and data protection violations. Effective incident reporting is foundational to organisational learning, regulatory compliance, and public accountability, enabling causal analysis that drives systemic improvement. Mandatory disclosure obligations are increasingly codified in sector-specific legislation including NIS2, the EU AI Act, and financial services regulations."@en ;
    rdfs:subClassOf ngm:compliance-framework ;
    vc:enables ngm:algorithmic-transparency-reports,
        ngm:compliance-monitoring,
        ngm:esg-reporting ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:ai-incident,
        ngm:audit-trail,
        ngm:incident-response ;
    vc:slug "incident-reporting" ;
    vc:sourceDomain "governance" ;
    vc:supports ngm:data-breach,
        ngm:vulnerability ;
    vc:uses ngm:ai-monitoring,
        ngm:compliance-audit-trail .

ngm:institutional-layer a owl:Class ;
    rdfs:label "Institutional Layer"@en ;
    rdfs:comment "The Institutional Layer is the cross-cutting stratum that represents the organisations, roles, and durable arrangements through which a system operates in the wider world. It sits above the Governance Layer, embodying its decisions in standing bodies, and depends on regulatory and compliance structures. It contains organisational entities, mandates, and the relationships between them."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:regulatory-layer ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:governance-layer ],
        ngm:infra-legal-and-regulatory ;
    skos:broader ngm:infra-legal-and-regulatory ;
    vc:enables ngm:organisational-layer,
        ngm:social-layer ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:governance-layer,
        ngm:regulatory-layer ;
    vc:slug "institutional-layer" ;
    vc:sourceDomain "finance" .

ngm:investor-protection a owl:Class ;
    rdfs:label "Investor Protection"@en ;
    rdfs:comment "Investor protection comprises the rules and mechanisms designed to safeguard investors from unfair, abusive or fraudulent practices in financial markets."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:regulatory-requirements ],
        ngm:financial-regulation ;
    vc:enables ngm:market-integrity ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:regulatory-requirements ;
    vc:slug "investor-protection" ;
    vc:sourceDomain "governance" .

ngm:io-t-infrastructure a owl:Class ;
    rdfs:label "IoT Infrastructure"@en ;
    rdfs:comment "IoT infrastructure is the integrated stack of hardware, networking, middleware, and cloud or edge platforms that enables the deployment, connectivity, management, and data processing of Internet of Things device fleets at scale. It encompasses device provisioning and lifecycle management, low-power wide-area or local-area communication protocols, edge gateways that aggregate and pre-process sensor data, secure device identity and over-the-air update mechanisms, and cloud or fog computing backends that host the data pipelines, analytics, and control planes for IoT applications across industrial, urban, consumer, and agricultural domains."@en ;
    rdfs:subClassOf ngm:digital-infrastructure ;
    vc:enables ngm:digital-twin,
        ngm:io-t-ai-integration,
        ngm:real-time-monitoring ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:industrial-io-t,
        ngm:internet-of-things,
        ngm:io-t-sensor-network ;
    vc:slug "io-t-infrastructure" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:edge-computing,
        ngm:embedded-systems,
        ngm:mqtt .

ngm:ipld a owl:Class ;
    rdfs:label "IPLD"@en ;
    rdfs:comment "IPLD (InterPlanetary Linked Data) is a data model and set of specifications for building content-addressed, hash-linked data structures that interoperate across distributed systems. It defines how to represent linked data as directed acyclic graphs whose edges are content identifiers (CIDs), allowing any hash-linked structure — Git commits, blockchain blocks, IPFS files — to be traversed through a common addressing scheme. IPLD provides the data layer beneath IPFS and Filecoin, decoupling the logical structure of data from the protocol used to store or transport it."@en ;
    rdfs:subClassOf ngm:content-addressing ;
    vc:enables ngm:data-availability ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:ipfs,
        ngm:linked-data ;
    vc:slug "ipld" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:merkle-dag,
        ngm:merkle-tree .

ngm:iso-8373 a owl:Class ;
    rdfs:label "ISO 8373"@en ;
    rdfs:comment "An ISO standard defining terms and vocabulary for robots and robotic devices. It establishes standardised terminology used across robotics standards."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
