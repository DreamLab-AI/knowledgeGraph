    vc:supports ngm:automated-reasoning,
        ngm:knowledge-representation,
        ngm:ontology-reasoning .

ngm:computational-component a owl:Class ;
    rdfs:label "Computational Component"@en ;
    rdfs:comment "A Computational Component is a modular, well-defined unit of an AI or software system that encapsulates specific processing logic — such as a neural network layer, a feature extraction module, or an inference engine — and interacts with other components through defined interfaces. Computational components abstract implementation details from consumers, enabling composition into larger pipelines and substitution of equivalent implementations without modifying the surrounding system. They are the primary unit of reuse, testing, and deployment in AI infrastructure, ranging from low-level hardware accelerator kernels to high-level model serving endpoints."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:computational-resources ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:algorithm ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:neural-network-layer ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:interface ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:module ],
        ngm:ai-infrastructure,
        ngm:component ;
    vc:enables ngm:inference,
        ngm:model-training ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:algorithm,
        ngm:module,
        ngm:neural-network-layer ;
    vc:isPartOf ngm:ai-system-component,
        ngm:machine-learning-discipline-pipeline ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:middleware,
        ngm:model-architecture,
        ngm:neural-network-component,
        ngm:software-architecture ;
    vc:requires ngm:computational-resources,
        ngm:interface ;
    vc:slug "computational-component" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:compute-infrastructure,
        ngm:gpu-compute,
        ngm:hardware-acceleration .

ngm:computational-image-relighting-technique a owl:Class ;
    rdfs:label "Computational Image Relighting Technique"@en ;
    rdfs:comment "Relighting is a computer graphics and generative AI technique that computationally alters the illumination of an existing image or video, repositioning or replacing light sources to produce a different lighting environment without re-capturing the scene. Modern approaches use neural rendering models trained on diverse lighting conditions, enabling portrait relighting, object relighting, and scene relighting from a single input image. Open-source workflows in tools such as ComfyUI implement IC-Light and similar diffusion-based pipelines that rival or exceed proprietary solutions."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:node-based-diffusion-pipeline-interface-workflows ],
        ngm:infra-computing-and-cloud ;
    skos:broader ngm:infra-computing-and-cloud ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:ai-video,
        ngm:control-net,
        ngm:differentiable-rendering,
        ngm:inpainting ;
    vc:requires ngm:node-based-diffusion-pipeline-interface-workflows ;
    vc:slug "computational-image-relighting-technique" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:diffusion-model,
        ngm:neural-rendering,
        ngm:physically-based-rendering .

ngm:conceptual-hierarchy a owl:Class ;
    rdfs:label "Conceptual Hierarchy"@en ;
    rdfs:comment "A Conceptual Hierarchy is a structured taxonomic organisation of domain concepts into subsumption (is-a) and composition (part-of) relationships, enabling systematic knowledge representation, inheritance of properties, and semantic interoperability across robotic and autonomous systems. It supports automated reasoning, modular system design, and classification of new entities within standardised ontological frameworks."@en ;
    rdfs:subClassOf ngm:infra-software-engineering ;
    skos:broader ngm:infra-software-engineering ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:relatedTo ngm:owl-class-hierarchy,
        ngm:rdf ;
    vc:slug "conceptual-hierarchy" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:knowledge-graph,
        ngm:robotics ;
    vc:uses ngm:knowledge-representation,
        ngm:ontology .

ngm:conceptual-layer a owl:Class ;
    rdfs:label "Conceptual Layer"@en ;
    rdfs:comment "The Conceptual Layer represents the highest abstraction level in an ontological classification system, encompassing pure concepts, theoretical models, design principles, and logical frameworks that are independent of specific technical implementations. Concepts at this layer can be realised through multiple concrete approaches while retaining their essential semantic properties."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:ontology-structure ],
        ngm:infra-software-engineering ;
    skos:broader ngm:infra-software-engineering ;
