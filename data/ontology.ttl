ngm:contract-code a owl:Class ;
    rdfs:label "Contract Code"@en ;
    rdfs:comment "Contract code is the executable program logic that defines the rules, state, and behaviour of a smart contract deployed on a distributed ledger. It is typically written in a high-level language such as Solidity or Kotlin and compiled to bytecode that nodes execute deterministically. Because it is immutable once deployed and controls value, contract code is a primary target for auditing and formal verification."@en ;
    rdfs:subClassOf ngm:smart-contract ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:smart-contract ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:r3-corda ;
    vc:slug "contract-code" ;
    vc:sourceDomain "blockchain" .

ngm:control-signal a owl:Class ;
    rdfs:label "Control Signal"@en ;
    rdfs:comment "A control signal is the command output computed by a controller and applied to actuate or steer a system toward a desired state. In robotics and electromechanical contexts it is the voltage, current, or set-point delivered to an actuator; in generative pipelines it is the spatial conditioning input that guides synthesis. In both senses it is the carrier of intent between a decision process and the system it drives."@en ;
    rdfs:subClassOf ngm:control-system ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:control-net-and-similar-spatial-conditioning-systems,
        ngm:electric-actuator ;
    vc:slug "control-signal" ;
    vc:sourceDomain "robotics" .

ngm:controlnet a skos:Concept ;
    rdfs:label "Controlnet"@en .

ngm:conversion-rate-optimisation a skos:Concept ;
    rdfs:label "Conversion Rate Optimisation"@en .

ngm:cor-dapp a owl:Class ;
    rdfs:label "CorDapp"@en ;
    rdfs:comment "A CorDapp (Corda Distributed Application) is a distributed application built to run on the R3 Corda enterprise blockchain platform. It bundles the contracts, states, and flows that define shared business logic and the point-to-point messaging that coordinates transactions between participating nodes. CorDapps are the unit of deployment by which enterprises implement permissioned, privacy-preserving workflows on Corda."@en ;
    rdfs:subClassOf ngm:smart-contract ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:enterprise-smart-contracts,
        ngm:r3-corda ;
    vc:slug "cor-dapp" ;
    vc:sourceDomain "blockchain" .

ngm:corporate-sustainability-reporting-directive a owl:Class ;
    rdfs:label "Corporate Sustainability Reporting Directive"@en ;
    rdfs:comment "The Corporate Sustainability Reporting Directive (CSRD) is a European Union law that expands and standardises the sustainability information companies must disclose, replacing the earlier Non-Financial Reporting Directive. It mandates reporting against the European Sustainability Reporting Standards, applies a double-materiality lens and requires assurance of the disclosed data. It substantially widens the scope of in-scope undertakings and the depth of environmental, social and governance disclosure."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:scope-3-emissions ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:carbon-accounting ],
        ngm:esg-reporting ;
    vc:bridgesTo ngm:esg-reporting ;
    vc:dependsOn ngm:double-materiality ;
    vc:enables ngm:compliance,
        ngm:sustainability ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:disclosure,
        ngm:double-materiality ;
    vc:isPartOf ngm:esg-reporting,
        ngm:regulation ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:carbon-accounting,
        ngm:esg,
        ngm:regulatory-compliance ;
    vc:requires ngm:carbon-accounting,
        ngm:disclosure,
        ngm:scope-3-emissions ;
    vc:slug "corporate-sustainability-reporting-directive" ;
    vc:sourceDomain "governance" ;
    vc:standardizedBy ngm:regulation ;
    vc:supports ngm:esg,
        ngm:sustainability .

ngm:cost-optimisation a owl:Class ;
    rdfs:label "Cost Optimisation"@en ;
    rdfs:comment "Cost optimisation is the discipline of minimising the financial cost of computing infrastructure while preserving required performance, reliability and capacity. It combines right-sizing of resources, elimination of waste, demand-aligned scaling and commercial levers such as committed-use and spot pricing. In cloud environments it is operationalised through continuous measurement, allocation of spend to teams, and feedback loops that align consumption with actual need."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:monitoring ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:observability ],
        ngm:resource-management ;
    vc:bridgesTo ngm:cloud-native,
        ngm:devops ;
    vc:enables ngm:capacity-planning ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:resource-management ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:capacity-planning,
        ngm:cloud-computing,
        ngm:cloud-infrastructure ;
    vc:requires ngm:monitoring,
        ngm:observability ;
    vc:slug "cost-optimisation" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:energy-efficiency,
        ngm:performance-optimization ;
    vc:uses ngm:autoscaling,
        ngm:resource-allocation .

ngm:counterparty-risk a owl:Class ;
    rdfs:label "Counterparty Risk"@en ;
    rdfs:comment "Counterparty Risk is the risk that the other party to a financial transaction or contract will fail to meet its obligations before settlement, causing loss to the non-defaulting party. It is central to derivatives, lending and securities trading, and is managed through collateral, netting and central clearing. Blockchain settlement and atomic swaps aim to reduce counterparty risk by removing reliance on trusted intermediaries."@en ;
    rdfs:subClassOf ngm:risk-management ;
    vc:contrastsWith ngm:systemic-risk ;
    vc:dependsOn ngm:verification ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:isPartOf ngm:risk-management ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:decentralized-finance,
        ngm:finance ;
    vc:slug "counterparty-risk" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:blockchain ;
    vc:uses ngm:clearing-house .

ngm:creative-expression a owl:Class ;
    rdfs:label "Creative Expression"@en ;
    rdfs:comment "Creative expression is the human activity of producing original artistic, narrative, or aesthetic artefacts to communicate ideas, emotions, or identity. In virtual and open-world environments it manifests as user-generated content, world-building, avatar customisation, and emergent play. It is a primary driver of engagement and value in persistent metaverse spaces."@en ;
    rdfs:subClassOf ngm:sc-interaction ;
    skos:broader ngm:sc-interaction ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:open-world,
        ngm:virtual-world ;
    vc:slug "creative-expression" ;
    vc:sourceDomain "metaverse" .

ngm:creator-compensation a owl:Class ;
    rdfs:label "Creator Compensation"@en ;
    rdfs:comment "Creator compensation refers to the economic mechanisms by which content creators are paid for their work, including royalties, revenue sharing, tipping, and tokenised ownership rights. In blockchain contexts it is often automated through smart contracts that distribute proceeds on primary sale and secondary resale. It is central to sustainable creator economies and to debates over fair value capture on digital platforms."@en ;
    rdfs:subClassOf ngm:economic-mechanism ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:creator-royalty-token,
        ngm:royalty-mechanism ;
    vc:slug "creator-compensation" ;
    vc:sourceDomain "blockchain" .

ngm:credential-storage a owl:Class ;
    rdfs:label "Credential Storage"@en ;
    rdfs:comment "Credential storage is the secure persistence of authentication secrets and verifiable credentials—such as passwords, keys, tokens, and signed attestations—so they can be protected at rest and retrieved for verification. It employs encryption, hardware-backed enclaves, and access controls to resist theft and tampering. It is a required capability of any digital identity management system."@en ;
    rdfs:subClassOf ngm:infra-security-and-identity ;
    skos:broader ngm:infra-security-and-identity ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:digital-identity,
        ngm:digital-identity-management ;
    vc:slug "credential-storage" ;
    vc:sourceDomain "security" .

ngm:cross-border-authentication a owl:Class ;
    rdfs:label "Cross Border Authentication"@en ;
    rdfs:comment "Cross border authentication is the verification of a person or entity's identity across national or jurisdictional boundaries, so that credentials issued in one country are trusted and accepted in another. It depends on interoperable identity schemes, mutual-recognition agreements and trust frameworks that reconcile differing legal and technical regimes. The capability enables seamless access to services, regulated transactions and travel without re-establishing identity from scratch in each jurisdiction."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:identity-verification ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:trust-framework ],
        ngm:authentication ;
    vc:bridgesTo ngm:self-sovereign-identity ;
    vc:dependsOn ngm:digital-trust ;
    vc:enables ngm:financial-inclusion,
        ngm:interoperability ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:implements ngm:authentication-protocol ;
    vc:isPartOf ngm:identity-management ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:digital-identity,
        ngm:regulatory-compliance,
        ngm:single-sign-on ;
    vc:requires ngm:identity-verification,
        ngm:trust-framework ;
    vc:slug "cross-border-authentication" ;
    vc:sourceDomain "governance" ;
    vc:supports ngm:decentralized-identity ;
    vc:uses ngm:federated-identity,
        ngm:verifiable-credentials .

ngm:cross-chain-liquidity a owl:Class ;
    rdfs:label "Cross Chain Liquidity"@en ;
    rdfs:comment "Cross-chain liquidity refers to the availability and free movement of tradable assets across multiple, otherwise isolated blockchain networks. It is achieved through bridges, relayers, liquidity pools and atomic swaps that let value flow between chains without a single custodian. Robust cross-chain liquidity reduces fragmentation, tightens spreads and enables composable decentralised finance across heterogeneous ecosystems."@en ;
    rdfs:subClassOf ngm:cross-chain-interoperability ;
    vc:contrastsWith ngm:centralised-finance ;
    vc:dependsOn ngm:consensus-mechanism,
        ngm:liquidity ;
    vc:enables ngm:cross-chain-asset-transfer,
        ngm:interoperability ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:cross-chain-interoperability ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:decentralised-exchange,
        ngm:stablecoin,
        ngm:tokenomics ;
    vc:slug "cross-chain-liquidity" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:decentralised-finance,
        ngm:dex ;
    vc:uses ngm:atomic-swap,
        ngm:cross-chain-bridge,
        ngm:liquidity-pool,
        ngm:relayer .

ngm:cross-domain-authentication a owl:Class ;
    rdfs:label "Cross Domain Authentication"@en ;
    rdfs:comment "Cross-domain authentication is the capability for a principal authenticated in one security or administrative domain to prove its identity to services in another domain without re-enrolling separate credentials. It relies on federated trust relationships and standard token exchanges so that an identity provider in one realm is accepted by relying parties in another. This underpins single sign-on across organisations and is essential to federated and distributed systems."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:trust-anchor ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:authentication ],
        ngm:authentication ;
    vc:bridgesTo ngm:security ;
    vc:enables ngm:federated-identity,
        ngm:single-sign-on ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:identity-federation ;
    vc:isPartOf ngm:authentication ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:federated-identity,
        ngm:identity-federation ;
    vc:requires ngm:authentication,
        ngm:trust-anchor ;
    vc:slug "cross-domain-authentication" ;
    vc:sourceDomain "security" ;
    vc:supports ngm:access-control ;
    vc:uses ngm:kerberos,
        ngm:oauth,
        ngm:saml .

ngm:cryptoeconomics a owl:Class ;
    rdfs:label "Cryptoeconomics"@en ;
    rdfs:comment "Cryptoeconomics is the discipline that combines cryptography with economic incentives to design and secure decentralised systems whose participants are assumed to act in their own self-interest. It uses mechanism design and game theory to make honest behaviour the rational choice, so that protocols remain secure and live without a trusted central authority. The field underpins consensus mechanisms, token economies, and the incentive structures of blockchain networks."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:mechanism-design ],
        ngm:blockchain-economics ;
    vc:bridgesTo ngm:economic-security,
        ngm:game-theory ;
    vc:dependsOn ngm:cryptography,
        ngm:game-theory,
        ngm:mechanism-design ;
    vc:enables ngm:consensus-mechanism,
        ngm:proof-of-stake,
        ngm:sybil-resistance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:blockchain ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:dao,
        ngm:smart-contract,
        ngm:staking ;
    vc:requires ngm:mechanism-design ;
    vc:slug "cryptoeconomics" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:blockchain-governance,
        ngm:decentralised-finance ;
    vc:uses ngm:token-economics,
        ngm:tokenomics .

ngm:cryptographic-identity a owl:Class ;
    rdfs:label "Cryptographic Identity"@en ;
    rdfs:comment "Cryptographic identity is an identity model in which an actor is represented and authenticated through possession of a private key rather than through a centrally issued credential. Control of the corresponding public key — or an identifier derived from it — proves the actor's identity by producing verifiable digital signatures. This model underpins blockchain accounts, decentralized identifiers and self-sovereign identity, removing the need for a trusted registry to vouch for who someone is."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:digital-signature ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:public-key-cryptography ],
        ngm:decentralized-identity ;
    vc:bridgesTo ngm:digital-identity ;
    vc:contrastsWith ngm:identity-verification ;
    vc:dependsOn ngm:key-management,
        ngm:public-key-cryptography ;
    vc:enables ngm:authentication,
        ngm:decentralized-identifier ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:implements ngm:authentication ;
    vc:isPartOf ngm:decentralized-identity,
        ngm:digital-identity ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:decentralized-identifier,
        ngm:trust ;
    vc:requires ngm:digital-signature,
        ngm:public-key-cryptography ;
    vc:slug "cryptographic-identity" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:identity-verification,
        ngm:wallet ;
    vc:uses ngm:digital-signature,
        ngm:hash-function .

ngm:cryptographic-key-pair a owl:Class ;
    rdfs:label "Cryptographic Key Pair"@en ;
    rdfs:comment "A cryptographic key pair is a mathematically linked pair of keys, a public key and a private key, used in asymmetric cryptography. The private key is kept secret by its owner while the public key may be distributed openly, and operations performed with one key can only be reversed or verified with the other. Key pairs underpin encryption to a recipient, digital signatures that prove authorship, and key agreement, making them foundational to secure communication, authentication and decentralised identity."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:private-key ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:key-management ],
        ngm:public-key-cryptography ;
    vc:bridgesTo ngm:did-method ;
    vc:dependsOn ngm:asymmetric-cryptography,
        ngm:key-management ;
    vc:enables ngm:digital-signature,
        ngm:encryption ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:private-key ;
    vc:implements ngm:public-key-cryptography ;
    vc:isPartOf ngm:public-key-cryptography ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:cryptography,
        ngm:encryption,
        ngm:private-key ;
    vc:requires ngm:key-management ;
    vc:slug "cryptographic-key-pair" ;
    vc:sourceDomain "security" ;
    vc:supports ngm:did-method,
        ngm:digital-signature ;
    vc:uses ngm:asymmetric-cryptography .

ngm:curve-wars a owl:Class ;
    rdfs:label "Curve Wars"@en ;
    rdfs:comment "The Curve Wars refers to the competitive dynamic among decentralised finance protocols to accumulate vote-escrowed CRV (veCRV) governance power over Curve Finance, thereby gaining the ability to direct CRV token emissions (gauges) toward liquidity pools in which the protocol has a stake. By controlling gauge weights, protocols attract liquidity providers to their pools by offering higher yields, creating a recursive incentive structure. The conflict intensified with the emergence of vote-aggregation intermediaries such as Convex Finance, which pooled user CRV into a dominant veCRV position and issued its own liquid derivative tokens (cvxCRV, vlCVX) to further abstract the underlying governance asset."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:governance-token ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:gauge-voting ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:vote-escrow-model ],
        ngm:decentralised-finance ;
    vc:bridgesTo ngm:game-theory,
        ngm:mechanism-design ;
    vc:contrastsWith ngm:market-making,
        ngm:proof-of-work ;
    vc:dependsOn ngm:curve-finance,
        ngm:decentralised-autonomous-organisation,
        ngm:ethereum ;
    vc:enables ngm:liquidity-provision,
        ngm:yield-optimisation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:gauge-voting ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:convex-finance,
        ngm:liquid-staking,
        ngm:miner-extractable-value,
        ngm:protocol-owned-liquidity,
        ngm:tokenomics ;
    vc:requires ngm:governance-token,
        ngm:vote-escrow-model ;
    vc:slug "curve-wars" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:automated-market-maker,
        ngm:liquidity-pool,
        ngm:smart-contract,
        ngm:token-emission .

ngm:customer-retention a owl:Class ;
    rdfs:label "Customer Retention"@en ;
    rdfs:comment "Customer retention is the set of strategies and mechanisms a business uses to keep existing customers engaged and transacting over time, reducing churn. It commonly relies on loyalty and rewards schemes, personalised omnichannel experiences, and data-driven engagement to maximise customer lifetime value. As an economic mechanism it is typically cheaper than acquisition and central to sustainable revenue."@en ;
    rdfs:subClassOf ngm:economic-mechanism ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:customer-rewards,
        ngm:omnichannel ;
    vc:slug "customer-retention" ;
    vc:sourceDomain "governance" .

ngm:cvss a owl:Class ;
    rdfs:label "Cvss"@en ;
    rdfs:comment "The Common Vulnerability Scoring System (CVSS) is an open, standardised framework for rating the severity of software vulnerabilities on a 0-10 scale. It decomposes severity into Base, Temporal and Environmental metric groups capturing intrinsic exploitability, real-world threat conditions and organisation-specific impact. CVSS provides a vendor-neutral common language so defenders can compare and prioritise remediation consistently across heterogeneous products."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:vulnerability ],
        ngm:vulnerability-management ;
    vc:bridgesTo ngm:cybersecurity ;
    vc:contrastsWith ngm:threat-intelligence ;
    vc:dependsOn ngm:vulnerability ;
    vc:enables ngm:risk-assessment,
        ngm:vulnerability-management ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:isPartOf ngm:vulnerability-management ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:asset-inventory,
        ngm:risk-assessment,
        ngm:threat-intelligence ;
    vc:requires ngm:vulnerability ;
    vc:slug "cvss" ;
    vc:sourceDomain "security" ;
    vc:standardizedBy ngm:cybersecurity ;
    vc:supports ngm:incident-response,
        ngm:threat-model ;
    vc:uses ngm:vulnerability .

ngm:cybersecurity-risk-management a owl:Class ;
    rdfs:label "Cybersecurity Risk Management"@en ;
    rdfs:comment "A structured discipline for identifying, assessing, prioritising, and treating risks to information systems, data assets, and digital infrastructure arising from threats such as malicious actors, system vulnerabilities, and operational failures. Cybersecurity risk management integrates threat modelling, vulnerability assessment, control selection, and residual risk acceptance into a repeatable governance cycle aligned with organisational risk appetite. Frameworks such as NIST CSF, ISO 27005, and FAIR provide structured methodologies. It bridges technical security practice with executive governance and regulatory compliance."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:vulnerability-assessment ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:threat-modelling ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:continuous-monitoring ],
        ngm:artificial-intelligence ;
    skos:broader ngm:artificial-intelligence ;
    vc:bridgesTo ngm:governance,
        ngm:security ;
    vc:dependsOn ngm:security-operations,
        ngm:security-operations-centre,
        ngm:threat-detection ;
    vc:enables ngm:compliance-monitoring,
        ngm:cyber-resilience,
        ngm:incident-response,
        ngm:operational-resilience ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:information-security-management,
        ngm:risk-management ;
    vc:qualityScore "0.9"^^xsd:float ;
    vc:relatedTo ngm:ai-governance,
        ngm:ai-risk-management,
        ngm:ai-safety,
        ngm:penetration-testing,
        ngm:supply-chain-security ;
    vc:requires ngm:continuous-monitoring,
        ngm:threat-modelling,
        ngm:vulnerability-assessment ;
    vc:slug "cybersecurity-risk-management" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:standardizedBy ngm:iso-27001,
        ngm:nist-cybersecurity-framework ;
    vc:supports ngm:accountability,
        ngm:resilience ;
    vc:uses ngm:risk-assessment,
        ngm:risk-register,
        ngm:security-framework,
        ngm:siem,
        ngm:soar,
        ngm:zero-trust-architecture .

ngm:d-yd-x a owl:Class ;
    rdfs:label "dYdX"@en ;
    rdfs:comment "dYdX is a decentralised exchange focused on perpetual-futures trading, allowing users to take leveraged long and short positions on cryptocurrencies. Earlier versions operated on Ethereum using a layer-two scaling solution with an off-chain order book and on-chain settlement, while a later version migrated to a purpose-built application-specific blockchain in the Cosmos ecosystem. It combines the order-book trading experience of centralised venues with non-custodial settlement."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:smart-contract ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:order-book ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:liquidation-engine ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:collateral-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:order-book ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:validator-set ],
        ngm:decentralised-finance ;
    vc:bridgesTo ngm:cosmos,
        ngm:derivatives-trading,
        ngm:layer-2-scaling ;
    vc:contrastsWith ngm:automated-market-maker,
        ngm:centralised-exchange,
        ngm:gmx ;
    vc:dependsOn ngm:cosmos,
        ngm:tendermint-consensus,
        ngm:zero-knowledge-rollup ;
    vc:enables ngm:leveraged-trading,
        ngm:perpetual-futures ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:liquidation-engine,
        ngm:order-book ;
    vc:implements ngm:application-specific-blockchain,
        ngm:order-book ;
    vc:isPartOf ngm:decentralised-finance ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:decentralised-exchange,
        ngm:ethereum ;
    vc:requires ngm:collateral-management,
        ngm:order-book,
        ngm:smart-contract,
        ngm:validator-set ;
    vc:slug "d-yd-x" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:governance-token,
        ngm:on-chain-settlement .

ngm:dama-dmbok a owl:Class ;
    rdfs:label "Dama Dmbok"@en ;
    rdfs:comment "The DAMA Data Management Body of Knowledge (DAMA-DMBOK) is a reference framework published by DAMA International that codifies the principles, functions, and best practices of enterprise data management. It organises the discipline into knowledge areas such as data governance, data quality, metadata, master data, and data architecture, arranged around a central data governance function. DAMA-DMBOK provides a common vocabulary and standard structure for establishing and assessing data management programmes."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:data-quality ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:data-governance ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:metadata-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:governance-framework ],
        ngm:data-management ;
    vc:bridgesTo ngm:data-security ;
    vc:enables ngm:compliance,
        ngm:data-architecture ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:data-governance,
        ngm:data-quality,
        ngm:metadata-management ;
    vc:implements ngm:knowledge-management ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:data-infrastructure,
        ngm:regulatory-compliance ;
    vc:requires ngm:governance-framework ;
    vc:slug "dama-dmbok" ;
    vc:sourceDomain "data" ;
    vc:standardizedBy ngm:best-practice ;
    vc:supports ngm:data-stewardship,
        ngm:master-data-management ;
    vc:uses ngm:data-catalog,
        ngm:data-lineage .

ngm:data-breach-notification a owl:Class ;
    rdfs:label "Data Breach Notification"@en ;
    rdfs:comment "Data breach notification is the legal and operational obligation to inform supervisory authorities and, where there is a high risk, affected individuals after a breach of personal data. Frameworks such as the UK and EU GDPR require controllers to report qualifying breaches to the regulator without undue delay, typically within seventy-two hours of becoming aware, and to document the breach regardless of whether it is reportable. The duty turns an internal security incident into a regulated disclosure event, with timing, content and assessment of risk all prescribed by law."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:audit-trail ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:incident-response ],
        ngm:data-protection-law ;
    vc:bridgesTo ngm:cybersecurity ;
    vc:dependsOn ngm:supervisory-authority ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:regulatory-compliance ;
    vc:isPartOf ngm:data-protection-law,
        ngm:regulatory-compliance ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:cybersecurity,
        ngm:gdpr,
        ngm:privacy ;
    vc:requires ngm:audit-trail,
        ngm:incident-response ;
    vc:slug "data-breach-notification" ;
    vc:sourceDomain "governance" ;
    vc:standardizedBy ngm:gdpr ;
    vc:supports ngm:data-protection,
        ngm:privacy ;
    vc:uses ngm:audit-trail,
        ngm:incident-response .

ngm:data-dictionary a owl:Class ;
    rdfs:label "Data Dictionary"@en ;
    rdfs:comment "A data dictionary is a centralised, structured repository that describes the data elements of an information system, recording each element's name, definition, data type, format, allowable values, relationships and ownership. It serves as an authoritative reference for the meaning and structure of data, distinct from the data itself, enabling consistent understanding across teams and systems. Data dictionaries underpin data governance, integration and quality assurance by making the semantics of stored data explicit."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:schema ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:metadata-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:metadata ],
        ngm:metadata-management ;
    vc:bridgesTo ngm:data-governance ;
    vc:contrastsWith ngm:data-catalogue,
        ngm:data-lineage ;
    vc:enables ngm:data-quality ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:metadata,
        ngm:schema ;
    vc:isPartOf ngm:data-governance,
        ngm:data-management ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:data-catalogue,
        ngm:data-lineage,
        ngm:data-quality ;
    vc:requires ngm:metadata-management ;
    vc:slug "data-dictionary" ;
    vc:sourceDomain "data" ;
    vc:supports ngm:data-governance,
        ngm:data-quality ;
    vc:uses ngm:metadata,
        ngm:schema .

ngm:data-distribution-service a owl:Class ;
    rdfs:label "Data Distribution Service"@en ;
    rdfs:comment "The Data Distribution Service is a middleware standard for real-time, data-centric publish-subscribe communication between distributed system components. It defines a global data space in which publishers and subscribers exchange typed data samples without direct knowledge of one another, governed by configurable quality-of-service policies for reliability, latency, and durability. It is widely used in robotics, autonomous vehicles, and other systems requiring deterministic machine-to-machine messaging."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:real-time-systems ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:quality-of-service ],
        ngm:middleware ;
    vc:bridgesTo ngm:robotics ;
    vc:enables ngm:autonomous-vehicle,
        ngm:distributed-systems ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:middleware ;
    vc:isPartOf ngm:distributed-systems ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:robot-control,
        ngm:ros,
        ngm:sensor-fusion ;
    vc:requires ngm:quality-of-service,
        ngm:real-time-systems ;
    vc:slug "data-distribution-service" ;
    vc:sourceDomain "robotics" ;
    vc:supports ngm:interoperability,
        ngm:real-time-communication,
        ngm:robot-operating-system ;
    vc:uses ngm:message-broker,
        ngm:quality-of-service .

ngm:data-efficient-learning a owl:Class ;
    rdfs:label "Data Efficient Learning"@en ;
    rdfs:comment "Data Efficient Learning encompasses machine learning techniques that achieve strong generalisation from limited labelled training examples, including transfer learning, few-shot learning, semi-supervised learning, data augmentation, and self-supervised pretraining. These methods address real-world constraints where large annotated datasets are impractical to obtain, making AI deployable in specialised or resource-constrained domains."@en ;
    rdfs:subClassOf ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:enables ngm:active-learning,
        ngm:federated-learning ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:relatedTo ngm:contrastive-learning,
        ngm:curriculum-learning ;
    vc:slug "data-efficient-learning" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:synthetic-data,
        ngm:transfer-learning .

ngm:data-fabric a owl:Class ;
    rdfs:label "Data Fabric"@en ;
    rdfs:comment "A data fabric is an architectural approach that provides a unified, metadata-driven layer for accessing, integrating and governing data across heterogeneous and distributed sources. It uses active metadata, knowledge graphs and automation to connect data without forcing physical consolidation. By abstracting underlying systems it delivers consistent discovery, access and governance, reducing the friction of fragmented data estates."@en ;
    rdfs:subClassOf ngm:infra-data-management ;
    skos:broader ngm:infra-data-management ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:metadata-management ;
    vc:slug "data-fabric" ;
    vc:sourceDomain "data" .

ngm:data-fabric-architecture a owl:Class ;
    rdfs:label "Data Fabric Architecture"@en ;
    rdfs:comment "An integrated data-management architecture that provides unified access, governance, security, and orchestration across distributed and heterogeneous data sources through active metadata management, automated data integration, and policy-driven controls."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:access-control ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:metadata-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:identity-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:api-gateway ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:governance-framework ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:distributed-storage ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:metadata-repository ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:data-integration ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:data-virtualization ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:data-catalog ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-schema ],
        ngm:data-management,
        ngm:infra-data-management ;
    skos:broader ngm:infra-data-management ;
    vc:enables ngm:cross-domain-governance,
        ngm:data-lineage-tracking,
