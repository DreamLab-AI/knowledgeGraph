ngm:real-time-settlement a owl:Class ;
    rdfs:comment "Real-time settlement is the immediate, final transfer of value between parties at the moment of transaction, eliminating the delay and counterparty risk of deferred net settlement cycles. In payments and securities it collapses the gap between trade and final exchange of funds. Distributed ledgers and central bank digital currencies enable atomic, near-instant settlement around the clock."@en ;
    rdfs:label "Real-Time Settlement"@en ;
    rdfs:subClassOf ngm:financial-services ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:cbdcs ;
    vc:relatedTo ngm:financial-infrastructure ;
    vc:slug "real-time-settlement" ;
    vc:sourceDomain "infrastructure" .
ngm:real-time-signal-processing a owl:Class ;
    rdfs:comment "Real-time signal processing is the analysis and transformation of a continuous or sampled signal within strict timing constraints, so that output is produced before the deadline required by the consuming system. It is implemented on dedicated hardware such as FPGAs and DSPs, which offer deterministic, low-latency execution unattainable on general-purpose operating systems. It is a prerequisite for haptic feedback and other interactive systems where perceptible delay between input and response degrades usability."@en ;
    rdfs:label "Real-Time Signal Processing"@en ;
    rdfs:subClassOf ngm:signal-processing ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.55"^^xsd:float ;
    vc:slug "real-time-signal-processing" ;
    vc:sourceDomain "spatial-computing" .
ngm:real-time-solver a skos:Concept ;
    rdfs:label "Real Time Solver"@en .
ngm:real-time-state-sync a skos:Concept ;
    rdfs:label "Real Time State Sync"@en .
ngm:real-time-streaming a owl:Class ;
    rdfs:comment "Real-time streaming is the continuous delivery of data, audio, or video as an ongoing flow consumed incrementally with minimal latency rather than downloaded in full beforehand. It uses low-latency transport protocols and buffering strategies to balance smoothness against delay. It underpins live media, event streams, and interactive low-latency experiences."@en ;
    rdfs:label "Real-Time Streaming"@en ;
    rdfs:subClassOf ngm:network-protocol ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:agent-event-stream ;
    vc:relatedTo ngm:virtual-performance-space ;
    vc:slug "real-time-streaming" ;
    vc:sourceDomain "infrastructure" .
ngm:real-time-synchronisation a owl:Class ;
    rdfs:comment "Real-time synchronisation is the continuous propagation of state changes across distributed participants so that all observers converge on a consistent, up-to-date view with minimal delay. It combines low-latency transport, conflict resolution, and clock or causal ordering to keep replicas aligned. It is essential for collaborative tools, multiplayer environments, and digital-twin mirroring."@en ;
    rdfs:label "Real-Time Synchronisation"@en ;
    rdfs:subClassOf ngm:distributed-systems ;
    vc:enables ngm:multi-user-systems ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
