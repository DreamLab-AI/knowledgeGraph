    vc:slug "common-crawl" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:communication-layer a owl:Class ;
    rdfs:label "Communication Layer"@en ;
    rdfs:comment "The Communication Layer is the stratum that governs the exchange of messages between components or participants. It sits above the Transport Layer that delivers bytes and below the coordination and application strata that rely on conversation. It contains messaging patterns, encoding, addressing, and delivery semantics."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:transport-layer ],
        ngm:infra-network-and-comms ;
    skos:broader ngm:infra-network-and-comms ;
    vc:enables ngm:coordination-layer,
        ngm:integration-layer ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:transport-layer ;
    vc:slug "communication-layer" ;
    vc:sourceDomain "infrastructure" .

ngm:complete-hri-terms-reference a owl:Class ;
    rdfs:label "COMPLETE_HRI_TERMS_REFERENCE"@en ;
    rdfs:comment "A structured terminology reference documenting standardised vocabulary for Human-Robot Interaction (HRI), encompassing communication protocols, behavioural patterns, and engagement modalities. It enables consistent annotation and semantic understanding of interaction contexts across robotic and autonomous systems, aligned with IEEE and ISO standards."@en ;
