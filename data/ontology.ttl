    vc:enables ngm:ai-governance ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:ai-incident,
        ngm:high-risk-ai-system,
        ngm:safety-oecd ;
    vc:requires ngm:market-surveillance-authority ;
    vc:slug "serious-incident" ;
    vc:sourceDomain "spatial-computing" .

