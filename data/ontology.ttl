        ngm:risk-management ;
    vc:slug "market-surveillance-authority" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:high-risk-ai-system .

ngm:mastery-learning a skos:Concept ;
    rdfs:label "Mastery Learning"@en .

ngm:material-flow-analysis a owl:Class ;
    rdfs:label "Material Flow Analysis"@en ;
    rdfs:comment "Material flow analysis (MFA) is a systematic accounting of the flows and stocks of materials within a defined system in space and time, grounded in the principle of mass conservation. It quantifies inputs, outputs, and accumulations to reveal resource use, losses, and recycling potential across an economy, industry, or region. MFA is a foundational method for industrial ecology, circular-economy design, and sustainability assessment."@en ;
    rdfs:subClassOf ngm:sustainability ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:circular-economy,
        ngm:industrial-symbiosis ;
    vc:slug "material-flow-analysis" ;
    vc:sourceDomain "supply-chain" .

ngm:mathematical-optimisation a owl:Class ;
    rdfs:label "Mathematical Optimisation"@en ;
    rdfs:comment "Mathematical Optimisation is the branch of mathematics and computer science concerned with selecting the best element from a set of feasible solutions according to a defined objective function. It encompasses convex and non-convex programming, combinatorial optimisation, gradient-based methods, and evolutionary algorithms. Mathematical optimisation underpins machine learning training, operations research, and engineering design."@en ;
    rdfs:subClassOf ngm:ai-research-area ;
    skos:broader ngm:ai-research-area ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:gradient-descent ;
    vc:slug "mathematical-optimisation" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:mcp-server a owl:Class ;
    rdfs:label "MCP Server"@en ;
    rdfs:comment "An MCP server is a program that exposes tools, resources, and prompts to AI applications through the Model Context Protocol. It advertises its capabilities during connection negotiation and executes requests forwarded by an MCP client, returning structured results for the model to consume. Servers encapsulate access to external systems such as databases, APIs, file systems, and developer tooling."@en ;
    rdfs:subClassOf ngm:ai-agent-system ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:mcp-client,
        ngm:model-context-protocol ;
    vc:slug "mcp-server" ;
    vc:sourceDomain "ai" .

ngm:meeting-transcription a owl:Class ;
    rdfs:label "Meeting Transcription"@en ;
    rdfs:comment "The automated conversion of spoken dialogue in synchronous or asynchronous meetings into structured text, combining automatic speech recognition with speaker diarisation, punctuation restoration, and optionally action-item extraction. AI-powered meeting transcription systems enable searchable records, accessibility, and downstream summarisation workflows."@en ;
    rdfs:subClassOf ngm:ai-application,
        ngm:speech-recognition ;
    skos:broader ngm:ai-application ;
    vc:enables ngm:documentation-generation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:audio-processing-system,
        ngm:audio-technology,
        ngm:speech-recognition ;
    vc:slug "meeting-transcription" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:automatic-speech-recognition,
        ngm:large-language-models,
        ngm:natural-language-processing .

ngm:megatron-lm a owl:Class ;
    rdfs:label "Megatron-LM"@en ;
    rdfs:comment "Megatron-LM is an open-source framework developed by NVIDIA for training very large transformer language models efficiently across many GPUs. It pioneered intra-layer tensor model parallelism, splitting individual weight matrices and attention heads across devices, and combines this with pipeline and data parallelism to scale to models with hundreds of billions of parameters. The framework provides optimised kernels and communication patterns that minimise the overhead of synchronising gradients and activations between accelerators."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gpu-computing ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gradient-accumulation ],
        ngm:distributed-training ;
    vc:contrastsWith ngm:deep-speed ;
    vc:dependsOn ngm:transformer-architecture ;
    vc:enables ngm:large-language-model ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:model-parallelism,
        ngm:tensor-parallelism ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:distributed-training,
        ngm:parallel-computing ;
    vc:requires ngm:gpu-computing,
        ngm:gradient-accumulation ;
    vc:slug "megatron-lm" ;
    vc:sourceDomain "machine-learning" ;
    vc:supports ngm:mixed-precision-training ;
    vc:uses ngm:cuda,
        ngm:flash-attention,
        ngm:nvidia-gpu,
        ngm:pipeline-parallelism .

ngm:memory a skos:Concept ;
    rdfs:label "Memory"@en .

ngm:merkle-patricia-trie a owl:Class ;
    rdfs:label "Merkle Patricia Trie"@en ;
    rdfs:comment "A Merkle Patricia Trie is a cryptographically authenticated key-value data structure that combines a Patricia (radix) trie for compact prefix-keyed storage with Merkle hashing for tamper-evident integrity. Each node is referenced by the hash of its contents, so a single root hash commits to the entire dataset and any change propagates to the root. It is the data structure Ethereum uses to store account state, transactions, and receipts, enabling compact Merkle proofs of inclusion."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:cryptographic-hash-function ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:merkle-proof ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptographic-hash-function ],
        ngm:merkle-tree ;
    vc:contrastsWith ngm:merkle-dag ;
    vc:dependsOn ngm:cryptographic-hash-function ;
    vc:enables ngm:merkle-proof,
        ngm:verification ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:cryptographic-hash-function,
        ngm:merkle-proof ;
    vc:implements ngm:account-model ;
    vc:isPartOf ngm:ethereum ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:nonce,
        ngm:smart-contract ;
    vc:requires ngm:cryptographic-hash-function ;
    vc:slug "merkle-patricia-trie" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:ethereum,
        ngm:evm ;
    vc:uses ngm:data-structure,
        ngm:persistence .

ngm:mesh-generation a owl:Class ;
    rdfs:label "Mesh Generation"@en ;
    rdfs:comment "Mesh generation is the process of constructing a discrete representation of a geometric domain as a network of vertices, edges and faces - typically triangles or tetrahedra - suitable for rendering, simulation or analysis. It transforms continuous shapes, point clouds or implicit surfaces into well-formed polygonal or volumetric meshes that meet quality, density and topology constraints. Mesh generation underpins computer graphics, 3D reconstruction and numerical simulation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:point-cloud ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:point-cloud ],
        ngm:computer-graphics ;
    vc:bridgesTo ngm:point-cloud-generation ;
    vc:dependsOn ngm:computer-graphics ;
    vc:enables ngm:simulation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:point-cloud ;
    vc:isPartOf ngm:computer-graphics ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:neural-radiance-field,
        ngm:point-cloud-generation,
        ngm:signed-distance-function ;
    vc:requires ngm:point-cloud ;
    vc:slug "mesh-generation" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:simulation,
        ngm:spatial-computing ;
    vc:uses ngm:point-cloud,
        ngm:signed-distance-function .

ngm:metaverse-application-platform a owl:Class ;
    rdfs:label "Metaverse Application Platform"@en ;
    rdfs:comment "Development environments and SDKs built on engines like Unity and Unreal that provide tools, APIs, and frameworks for creating immersive 3D applications, virtual worlds, and blockchain-integrated experiences for the metaverse."@en ;
