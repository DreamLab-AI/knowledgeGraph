# Virtual Production Pipeline
spatial-computing:VirtualProductionPipeline rdf:type owl:Class ;
    rdfs:subClassOf spatial-computing:VirtualProduction ;
    rdfs:label "Virtual Production Pipeline"@en ;
    rdfs:comment "The end-to-end workflow for creating film and television content using real-time rendering, LED volumes, motion capture, and game engine technology, integrating pre-visualization, on-set virtual environments, and in-camera visual effects to replace traditional post-production VFX processes."@en ;
    skos:prefLabel "Virtual Production Pipeline"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:spatial-computing:virtual-production-pipeline" ;
    owl:sameAs <urn:visionclaw:concept:spatial-computing:virtual-production-pipeline> ;
    vcw:contentHash "sha256-12-897a5aa3fa17" ;
    vcw:qualityScore "0.35"^^xsd:decimal ;
    vcw:legacyTermId "MV-10138" ;
    vcw:ontologyStatus "active" ;
    vcw:maturityLevel "draft" ;
    vcw:authorityScore "0.0"^^xsd:decimal ;
