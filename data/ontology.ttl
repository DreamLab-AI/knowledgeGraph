    vc:slug "unique-content-variation" ;
    vc:sourceDomain "spatial-computing" ;
    vc:standardizedBy ngm:erc-721 ;
    vc:uses ngm:nft-minting,
        ngm:procedural-generation .

ngm:user-awareness a owl:Class ;
    rdfs:label "User Awareness"@en ;
    rdfs:comment "The level of understanding and knowledge that users possess about digital systems, privacy practices, security risks, and their rights when interacting with metaverse platforms and virtual environments. Effective user awareness encompasses privacy literacy, recognition of security threats, platform policy comprehension, and knowledge of available remedies, forming a prerequisite for informed consent and safe participation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:privacy ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:user-education ],
        ngm:sc-governance-and-safety,
        ngm:user-education ;
    skos:broader ngm:sc-governance-and-safety ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:ai-ethics,
        ngm:cybersecurity,
        ngm:privacy-by-design ;
    vc:requires ngm:privacy,
        ngm:user-education ;
    vc:slug "user-awareness" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:accountability,
        ngm:user-safety .

ngm:user-privacy-control a owl:Class ;
    rdfs:label "User Privacy Control"@en ;
    rdfs:comment "User privacy controls are interface and systemic mechanisms that allow individuals to view, modify, restrict, or delete their personal data held by an AI or data-driven system. They operationalise data subject rights such as the right to be forgotten, consent withdrawal, and data portability mandated by regulations like GDPR. Effective privacy controls combine technical enforcement — such as deletion pipelines and audit trails — with accessible user interfaces."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:consent-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:access-control ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gdpr-compliance ],
        ngm:ai-governance-and-ethics,
        ngm:privacy-mechanism ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:enables ngm:data-minimisation,
        ngm:right-to-be-forgotten,
        ngm:transparency ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:privacy-by-design,
        ngm:privacy-framework ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:algorithmic-accountability,
        ngm:data-protection,
        ngm:privacy-impact-assessment,
        ngm:user-interface ;
    vc:requires ngm:access-control,
        ngm:consent-management,
        ngm:gdpr-compliance ;
    vc:slug "user-privacy-control" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:personal-data-store .

ngm:value-vector a owl:Class ;
    rdfs:label "Value Vector"@en ;
    rdfs:comment "A Value Vector is a structured numerical representation that encodes the relative importance or utility of different outcomes, objectives, or features within an AI system, enabling multi-objective optimisation and preference-guided decision-making. It aggregates scalar values across dimensions such as safety, performance, cost, and alignment to express composite desiderata, and is foundational to reward modelling, preference learning, and value alignment research."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:loss-function ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:reward-function ],
        ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:enables ngm:reinforcement-learning,
        ngm:value-alignment ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:ai-research-area ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:deep-learning,
        ngm:machine-learning,
        ngm:reinforcement-learning-from-human-feedback,
        ngm:reward-model ;
    vc:requires ngm:loss-function,
        ngm:reward-function ;
    vc:slug "value-vector" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:optimization-technique,
        ngm:preference-learning .

ngm:velocity a owl:Class ;
    rdfs:label "Velocity"@en ;
    rdfs:comment "Velocity is the vector quantity expressing rate of change of position with respect to time, formally defined as v = dx/dt. In robotics and autonomous systems, it is a fundamental parameter governing motion planning, collision avoidance, and control, with algorithms such as Velocity Obstacle (VO) and Reciprocal Velocity Obstacle (RVO) built directly upon it."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:control-system ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:sensor-fusion ],
        ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:enables ngm:collision-avoidance,
        ngm:motion-planning ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:robotics-control ;
    vc:requires ngm:control-system,
        ngm:sensor-fusion ;
    vc:slug "velocity" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:physics-simulation .

ngm:verification a owl:Class ;
    rdfs:label "VERIFICATION"@en ;
    rdfs:comment "Verification is the process of confirming that information, claims, and digital artefacts meet specified standards for accuracy, completeness, and compliance with constraints through cryptographic proofs, rule-based validation, consensus mechanisms, and user acceptance testing. Within metaverse and blockchain contexts it encompasses transaction authenticity, smart contract correctness, ontology schema conformance, and digital asset provenance, establishing trust between stakeholders in decentralised systems."@en ;
    rdfs:subClassOf ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:enables ngm:compliance-framework,
        ngm:identity-verification ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:authentication,
        ngm:standards-validation ;
    vc:slug "verification" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:cryptography,
        ngm:digital-signature .

ngm:virtual-labor a owl:Class ;
    rdfs:label "Virtual Labor"@en ;
    rdfs:comment "Work performed in virtual environments that generates economic value, spanning content creation, service provision, virtual construction, platform governance, and social labour. Virtual labour is often platform-dependent, contract-based, and remunerated via virtual currency or revenue-sharing models, raising significant questions around labour rights, taxation of cross-border virtual income, and platform exploitation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:metaverse ],
        ngm:metaverse,
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:virtual-economy ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:governance-framework,
        ngm:land-economics ;
    vc:requires ngm:metaverse ;
    vc:slug "virtual-labor" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:digital-asset,
        ngm:virtual-currency .

ngm:virtual-nation-state a owl:Class ;
    rdfs:label "Virtual Nation State"@en ;
    rdfs:comment "A digital sovereign entity existing within metaverse platforms that offers forms of virtual citizenship, governance structures, economic systems, and legal frameworks, potentially providing e-residency, digital identity, and participation in virtual economies independent of geographic territory."@en ;
    rdfs:subClassOf ngm:digital-governance,
        ngm:sc-governance-and-safety ;
    skos:broader ngm:sc-governance-and-safety ;
    vc:enables ngm:digital-identity,
        ngm:governance-model ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:relatedTo ngm:identity-management,
        ngm:metaverse ;
    vc:slug "virtual-nation-state" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:dao,
        ngm:decentralised-identity,
        ngm:smart-contract .

ngm:virtual-object-pose a owl:Class ;
    rdfs:label "Virtual Object Pose"@en ;
    rdfs:comment "The position, orientation, and scale of a 3D object within a virtual environment, represented as a combined transform: translation (X, Y, Z world coordinates), rotation (quaternion or Euler angles), and scale factors. Accurate pose determination underpins AR object anchoring, motion capture replay, physics simulation, and hand-object interaction in XR systems."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:sensor-fusion ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:slam ],
        ngm:physics-simulation,
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:enables ngm:augmented-reality,
        ngm:motion-capture ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:physics-simulation ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:requires ngm:sensor-fusion,
        ngm:slam ;
    vc:slug "virtual-object-pose" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:computer-vision .

ngm:virtual-physical-collision a owl:Class ;
    rdfs:label "Virtual Physical Collision"@en ;
    rdfs:comment "The detection and simulation of contact events between virtual objects and real-world physical elements in mixed and augmented reality environments. Virtual-physical collision systems generate haptic alerts, visual boundary warnings, and passthrough camera activations to prevent user injury and to produce physically plausible interactions between digital content and the real world."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:haptic-feedback ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:room-scale ],
        ngm:physics-simulation,
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:enables ngm:mixed-reality ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:augmented-reality,
        ngm:user-safety ;
    vc:requires ngm:haptic-feedback,
        ngm:room-scale ;
    vc:slug "virtual-physical-collision" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:physics-engine,
        ngm:spatial-tracking-technology .

ngm:virtual-reality-telepresence a owl:Class ;
    rdfs:label "Virtual Reality Telepresence"@en ;
    rdfs:comment "\"The use of virtual reality head-mounted displays and immersive 3D environments to enable remote participants to experience shared virtual spaces with stereoscopic vision, spatial audio, head tracking, and avatar embodiment, creating a subjective sense of co-location despite geographical separati..."@en ;
    rdfs:subClassOf ngm:dc-telepresence,
        ngm:tele-001-telepresence ;
    skos:broader ngm:dc-telepresence ;
    vc:enables ngm:remote-design-review ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires ngm:tele-110-spatial-audio-processing ;
    vc:slug "virtual-reality-telepresence" ;
    vc:sourceDomain "distributed-collaboration" .

ngm:virtual-set-design a owl:Class ;
    rdfs:label "Virtual Set Design"@en ;
    rdfs:comment "The creation of digital environments and backgrounds for film, television, and broadcast production using 3D modelling, game engines, and LED volume wall technology, enabling dynamic digital sets modifiable in real time during filming. Virtual sets replace or augment physical construction, with camera tracking systems providing perspective-correct parallax so actors interact believably with the rendered environment."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:real-time-rendering ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:game-engine ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:motion-capture ],
        ngm:production-design,
        ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:enables ngm:virtual-production ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:production-design ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:requires ngm:game-engine,
        ngm:motion-capture,
        ngm:real-time-rendering ;
    vc:slug "virtual-set-design" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:computer-vision,
        ngm:virtual-production-volume .

ngm:virtual-society-regulations a owl:Class ;
    rdfs:label "Virtual Society Regulations"@en ;
    rdfs:comment "The legal frameworks, governance structures, and policy mechanisms designed to regulate behaviour, protect rights, and ensure safety within metaverse platforms and virtual world environments, encompassing intellectual property, data privacy, content moderation, and cross-jurisdictional enforcement challenges. The EU regulatory suite — GDPR, Digital Services Act, Digital Markets Act, and AI Act — forms the most comprehensive current framework, with international coordination emerging through the Global Digital Compact adopted in September 2024."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:content-moderation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:platform-governance ],
        ngm:ai-governance-and-ethics,
        ngm:digital-governance ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:enables ngm:cross-border-compliance,
        ngm:digital-rights ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:metaverse-governance-and-safeguarding,
        ngm:virtual-society ;
    vc:requires ngm:content-moderation,
        ngm:platform-governance ;
    vc:slug "virtual-society-regulations" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:compliance-framework,
        ngm:gdpr-compliance .

ngm:virtual-wedding a owl:Class ;
    rdfs:label "Virtual Wedding"@en ;
    rdfs:comment "A marriage ceremony conducted within a metaverse or virtual reality platform in which participants are represented by digital avatars, enabling global attendance without physical travel. Virtual weddings may incorporate NFT wedding gifts, custom virtual venues, and live-streamed officiants, but typically require separate legal proceedings for official recognition under applicable jurisdictional law."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:avatar-system ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:virtual-reality-platform ],
        ngm:sc-platform-and-environment,
        ngm:virtual-event ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:metaverse-application ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:legal-framework,
        ngm:social-platform ;
    vc:requires ngm:avatar-system,
        ngm:virtual-reality-platform ;
    vc:slug "virtual-wedding" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:avatar,
        ngm:metaverse-venue,
        ngm:nft .

ngm:vocabulary-governance a owl:Class ;
    rdfs:label "Vocabulary Governance"@en ;
    rdfs:comment "The policies, processes, and organizational structures for managing controlled vocabularies, taxonomies, thesauri, and ontologies throughout their lifecycle, including version control, role-based access permissions, quality assurance, and collaborative maintenance to ensure terminology consistenc..."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:knowledge-management ],
        ngm:ai-governance-and-ethics ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:knowledge-management ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:slug "vocabulary-governance" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:watermarks a owl:Class ;
    rdfs:label "Watermarks"@en ;
    rdfs:comment "Techniques for embedding imperceptible or visible signals into digital content—such as text, images, audio, or AI-generated outputs—to assert provenance, ownership, or authenticity. AI watermarking approaches include statistical token-distribution biasing (for large language models) and frequency-domain embedding (for images), enabling detection of machine-generated content and supporting intellectual property protection and content provenance verification."@en ;
    rdfs:subClassOf ngm:infra-security-and-identity ;
    skos:broader ngm:infra-security-and-identity ;
    vc:enables ngm:accountability,
        ngm:data-provenance ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:slug "watermarks" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:ai-governance,
        ngm:transparency-oecd ;
    vc:uses ngm:cryptography,
        ngm:generative-ai .

ngm:web-dev-and-consumer-tooling a owl:Class ;
    rdfs:label "Web Dev and Consumer Tooling"@en ;
    rdfs:comment "The ecosystem of frameworks, deployment platforms, low-code builders, and developer utilities used to construct and ship web applications and AI-assisted consumer products. Encompasses front-end frameworks (React Three Fiber, Streamlit, FastHTML), deployment pipelines (Vercel), and no-code/low-code AI builders enabling rapid product prototyping."@en ;
    rdfs:subClassOf ngm:infra-software-engineering ;
    skos:broader ngm:infra-software-engineering ;
    vc:enables ngm:code-generation,
        ngm:image-generation ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:software-engineering ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:slug "web-dev-and-consumer-tooling" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:prompt-engineering,
        ngm:web-technology .

ngm:well-being a owl:Class ;
    rdfs:label "Well Being"@en ;
    rdfs:comment "AI should enhance human and societal well-being by augmenting human capabilities, enriching quality of life, supporting physical and mental health, enabling meaningful work, strengthening social connections, and contributing to flourishing individuals and communities."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:human-centred-values ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ai-governance ],
        ngm:sc-governance-and-safety ;
    skos:broader ngm:sc-governance-and-safety ;
    vc:contrastsWith ngm:digital-well-being-index ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:inclusive-growth,
        ngm:social-impact,
        ngm:sustainable-development ;
    vc:requires ngm:ai-governance,
        ngm:human-centred-values ;
    vc:slug "well-being" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:accessibility .

ngm:x402-and-l402-payment-protocols a owl:Class ;
    rdfs:label "x402 and l402 payment protocols"@en ;
    rdfs:comment "x402 and l402 payment protocols is a blockchain and distributed systems concept and a type of blockchain."@en ;
    rdfs:subClassOf ngm:bc-defi-and-economics ;
    skos:broader ngm:bc-defi-and-economics ;
    vc:hasMaturity ngmi:maturity-draft ;
