    dcterms:modified "2026-04-26T13:00:00Z"^^xsd:dateTime ;
    vcw:owlRole "Process" .

# Cryptocurrency Remuneration
distributed-collaboration:CryptocurrencyRemuneration rdf:type owl:Class ;
    rdfs:subClassOf distributed-collaboration:Cryptocurrency ;
    rdfs:label "Cryptocurrency Remuneration"@en ;
    rdfs:comment "\"The payment of remote workers, freelancers, or distributed team members in cryptocurrency (Bitcoin, Ethereum, stablecoins) rather than traditional fiat currency, enabling borderless, instant, low-fee transactions that bypass traditional banking systems whilst providing financial inclusion for unbanked populations and facilitating blockchain-based collaboration.\""@en ;
    skos:prefLabel "Cryptocurrency Remuneration"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:distributed-collaboration:cryptocurrency-remuneration" ;
    owl:sameAs <urn:visionclaw:concept:distributed-collaboration:cryptocurrency-remuneration> ;
    vcw:contentHash "sha256-12-147724fb1283" ;
    vcw:qualityScore "0.5"^^xsd:decimal ;
    vcw:legacyTermId "TC-0253" ;
    vcw:ontologyStatus "active" ;
    vcw:maturityLevel "developing" ;
    vcw:authorityScore "0.0"^^xsd:decimal ;
    dcterms:identifier "TC-0253" ;
    dcterms:subject "distributed-collaboration" ;
