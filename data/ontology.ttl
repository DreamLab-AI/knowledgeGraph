ngm:pneumatic-actuator a owl:Class ;
    rdfs:label "Pneumatic Actuator"@en ;
    rdfs:comment "PneumaticActuator is a mechanical device that converts compressed-air energy into controlled mechanical motion — linear (cylinders, bellows), rotary (vane motors, semi-rotary actuators), or contractile (McKibben muscles, fibre-reinforced elastomers, Festo fluidic muscles) — and serves as the prim..."@en ;
