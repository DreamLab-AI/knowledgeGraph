ngm:calibration-target a owl:Class ;
    rdfs:label "Calibration Target"@en ;
    rdfs:comment "A physical or displayed reference pattern with precisely known geometric, photometric, or colorimetric properties used to determine camera intrinsic and extrinsic parameters, enabling accurate lens distortion correction, spatial measurement, and color reproduction in imaging systems."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:checkerboard-pattern ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:fiducial-marker ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:precision-manufacturing ],
        ngm:sc-standards-and-interop ;
    skos:broader ngm:sc-standards-and-interop ;
    vc:bridgesTo ngm:machine-learning,
        ngm:reference-standard,
        ngm:robotics ;
    vc:contrastsWith ngm:scene-geometry ;
    vc:enables ngm:3-d-reconstruction,
        ngm:camera-calibration,
        ngm:color-accuracy,
        ngm:lens-distortion-correction,
        ngm:pose-estimation ;
