    vc:enables ngm:audit-trail ;
    vc:enables ngm:certificate-authority ;
    vc:enables ngm:security-monitoring ;
    vc:enables ngm:threat-intelligence ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:public-key-cryptography ;
    vc:relatedTo ngm:tls-1-3 ;
    vc:requires ngm:append-only-log ;
    vc:requires ngm:cryptographic-infrastructure ;
    vc:slug "certificate-transparency" ;
