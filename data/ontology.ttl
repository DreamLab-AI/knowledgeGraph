ngm:privacy-regulation a owl:Class ;
    rdfs:comment "Privacy regulation refers to the body of laws and rules that govern how organisations collect, process, store, and share personal data, granting individuals rights over information about them. Such regulation establishes lawful bases for processing, mandates transparency and security obligations, and provides for enforcement and penalties for non-compliance. Prominent examples set global benchmarks for data subject rights, consent, and accountability, shaping how digital products handle personal information across jurisdictions."@en ;
    rdfs:label "Privacy Regulation"@en ;
    rdfs:subClassOf ngm:data-protection-regulation ;
    rdfs:subClassOf _:r16904 ;
