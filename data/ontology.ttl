ngm:vector-databases a owl:Class ;
    rdfs:label "Vector Databases"@en ;
    rdfs:comment "Database systems specialised for storing high-dimensional vector embeddings and performing similarity search over them, typically using approximate nearest neighbour indexing algorithms such as HNSW and IVF."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:vector-index ],
