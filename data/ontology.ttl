ngm:sha-256 a owl:Class ;
    rdfs:label "SHA-256"@en ;
    rdfs:comment "Secure Hash Algorithm producing a deterministic 256-bit digest from arbitrary input, forming the cryptographic foundation of Bitcoin's proof-of-work, Merkle tree construction, block header chaining, and address derivation in most major blockchain systems. Produces avalanche-effect collision resistance with 2^128 preimage security. Standardised in FIPS 180-4 by NIST as part of the SHA-2 family."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:compression-function ],
        ngm:cryptographic-primitive ;
    vc:bridgesTo ngm:blockchain,
        ngm:public-key-infrastructure,
        ngm:supply-chain-provenance ;
    vc:contrastsWith ngm:sha-1,
        ngm:sha-3 ;
    vc:enables ngm:block-header,
        ngm:data-integrity-verification,
        ngm:immutability,
        ngm:merkle-tree,
        ngm:proof-of-work ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:collision-resistance,
        ngm:cryptographic-hash,
        ngm:digital-signature,
        ngm:hash-function,
        ngm:hmac,
        ngm:merkle-proof,
        ngm:preimage-resistance,
        ngm:public-key ;
    vc:requires ngm:compression-function ;
    vc:slug "sha-256" ;
    vc:sourceDomain "security" ;
    vc:standardizedBy ngm:nist ;
    vc:uses ngm:cryptographic-hash-function,
        ngm:merkle-damgard-construction .

ngm:single-sign-on a owl:Class ;
    rdfs:label "Single Sign-On"@en ;
    rdfs:comment "Single Sign-On (SSO) is an authentication architecture in which a user authenticates once to a central Identity Provider (IdP) and receives a cryptographically signed assertion or token that grants access to multiple independent service providers without re-entering credentials. Dominant protocol implementations include SAML 2.0 (XML-based assertions), OpenID Connect layered over OAuth 2.0 (JSON Web Token–based), and Kerberos (ticket-granting ticket mechanism in Windows/Active Directory environments). SSO reduces credential exposure and attack surface by centralising authentication at a hardened IdP, simplifies user lifecycle management across enterprise systems, and is the cornerstone of modern Identity and Access Management platforms encompassing provisioning, deprovisioning, and audit."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:trust-framework ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:public-key-infrastructure ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:digital-certificate ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:identity-provider ],
        ngm:authentication ;
    vc:bridgesTo ngm:self-sovereign-identity,
        ngm:verifiable-credentials ;
    vc:contrastsWith ngm:decentralised-identity ;
    vc:enables ngm:access-control,
        ngm:digital-identity-management,
        ngm:federated-identity,
        ngm:zero-trust-architecture ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:implements ngm:kerberos,
        ngm:oauth-2-0,
        ngm:open-id-connect,
        ngm:saml ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:authentication-standards,
        ngm:directory-service,
        ngm:federated-credential-exchange,
        ngm:identity-and-access-management ;
    vc:requires ngm:digital-certificate,
        ngm:identity-provider,
        ngm:public-key-infrastructure,
        ngm:trust-framework ;
    vc:slug "single-sign-on" ;
    vc:sourceDomain "security" ;
    vc:supports ngm:audit-logging,
        ngm:role-based-access-control,
        ngm:user-provisioning ;
    vc:uses ngm:json-data-interchange-format-web-token,
        ngm:multi-factor-authentication,
        ngm:session-management .

ngm:telemetry a owl:Class ;
    rdfs:label "Telemetry"@en ;
    rdfs:comment "Telemetry is the automated collection, transmission and aggregation of measurements and signals from remote or distributed systems to a central point for monitoring and analysis. In software and infrastructure it commonly refers to the emission of metrics, logs, traces and events that describe a system's behaviour and health. Telemetry data is the raw substrate on which observability, alerting and performance analysis are built."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:instrumentation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:instrumentation ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:time-series-data ],
