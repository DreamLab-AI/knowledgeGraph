# Privacy Filter
infrastructure:PrivacyFilter rdf:type owl:Class ;
    rdfs:label "Privacy Filter"@en ;
    rdfs:comment "A sidecar service (ADR-008) that sanitises agent outputs before emission to Nostr Relay or Federation Surface, redacting personally identifiable information (PII), secrets, and regulated data, whilst maintaining data utility for downstream consumers and leaving a tamper-evident audit trail of redactions."@en ;
    skos:prefLabel "Privacy Filter"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:infrastructure:privacy-filter" ;
    owl:sameAs <urn:visionclaw:concept:infrastructure:privacy-filter> ;
