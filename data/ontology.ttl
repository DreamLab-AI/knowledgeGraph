ngm:virtual-society-regulations a owl:Class ;
    rdfs:label "Virtual Society Regulations"@en ;
    rdfs:comment "The legal frameworks, governance structures, and policy mechanisms designed to regulate behaviour, protect rights, and ensure safety within metaverse platforms and virtual world environments, encompassing intellectual property, data privacy, content moderation, and cross-jurisdictional enforcement challenges. The EU regulatory suite — GDPR, Digital Services Act, Digital Markets Act, and AI Act — forms the most comprehensive current framework, with international coordination emerging through the Global Digital Compact adopted in September 2024."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:content-moderation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:platform-governance ],
        ngm:ai-governance-and-ethics,
        ngm:digital-governance ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:enables ngm:cross-border-compliance,
        ngm:digital-rights ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:metaverse-governance-and-safeguarding,
        ngm:virtual-society ;
    vc:requires ngm:content-moderation,
        ngm:platform-governance ;
    vc:slug "virtual-society-regulations" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:compliance-framework,
        ngm:gdpr-compliance .

ngm:virtual-voting a skos:Concept ;
