ngm:message-broker a owl:Class ;
    rdfs:comment "A message broker is an intermediary software component that translates messages between disparate messaging protocols and routes them between producers and consumers, decoupling the two sides of a communication so that neither needs direct knowledge of the other. It typically provides guaranteed delivery, message queuing, routing rules, protocol translation, and persistence semantics."@en ;
    rdfs:label "Message Broker"@en ;
    rdfs:subClassOf ngm:middleware ;
