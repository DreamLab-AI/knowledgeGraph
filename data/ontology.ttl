    vc:uses ngm:abci ;
    vc:uses ngm:cosmos-sdk ;
    vc:uses ngm:gossip-protocol .
ngm:tendermint-consensus a owl:Class ;
    rdfs:comment "Tendermint Consensus is a Byzantine Fault Tolerant consensus engine that combines Practical Byzantine Fault Tolerance (PBFT) with Proof-of-Stake validator sets to achieve immediate block finality and high transaction throughput. It underpins the Cosmos ecosystem and enables inter-blockchain communication by guaranteeing that committed blocks are never reverted, eliminating the probabilistic finality of Proof-of-Work chains."@en ;
    rdfs:label "Tendermint Consensus"@en ;
    rdfs:subClassOf ngm:bc-protocol-and-consensus ;
    rdfs:subClassOf ngm:byzantine-fault-tolerance ;
