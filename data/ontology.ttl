            owl:someValuesFrom ngm:governance-token ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:snapshot ],
        ngm:bc-governance-and-regulation ;
    skos:broader ngm:bc-governance-and-regulation ;
    vc:bridgesTo ngm:collective-decision-making,
        ngm:digital-democracy ;
    vc:contrastsWith ngm:corporate-governance ;
    vc:dependsOn ngm:blockchain-network,
        ngm:eip-712,
        ngm:ipfs ;
    vc:enables ngm:on-chain-voting,
        ngm:protocol-upgrades,
        ngm:treasury-management ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:proposal-lifecycle,
        ngm:quorum-requirement,
        ngm:timelock ;
    vc:implements ngm:compound-governor-bravo,
        ngm:decentralized-governance ;
    vc:isPartOf ngm:dao-governance,
        ngm:decentralized-autonomous-organization ;
    vc:qualityScore "0.72"^^xsd:float ;
