ngm:finite-state-machine a owl:Class ;
    rdfs:comment "A finite state machine (FSM) is an abstract computational model consisting of a finite set of states, a set of input events, and a transition function that maps a current state and input to a next state. At any moment the machine occupies exactly one state, and its behaviour is fully determined by its current state and the inputs it receives. FSMs are widely used to specify control logic, protocol behaviour, and reactive systems."@en ;
    rdfs:label "Finite State Machine"@en ;
    rdfs:subClassOf ngm:state-machine ;
    rdfs:subClassOf _:r10605 ;
    rdfs:subClassOf _:r10606 ;
