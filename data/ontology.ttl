ngm:virtual-factory a owl:Class ;
    rdfs:label "Virtual Factory"@en ;
    rdfs:comment "A physically accurate digital twin representation of a manufacturing facility that enables modelling, simulation, analysis, and optimisation of production processes, resources, and operations without physical prototypes or pilot plants. It integrates IoT sensor data, AI-driven analytics, and real-time bidirectional synchronisation; platforms such as NVIDIA Omniverse (OpenUSD) and Siemens Tecnomatix are primary implementation environments. Virtual factories are a core Industry 4.0 concept supporting predictive maintenance, layout optimisation, and safe robotics training."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:digital-twin-technology ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:simulation-engine ],
        ngm:digital-twin,
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:enables ngm:digital-twin-collaboration,
        ngm:virtual-training ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:cross-platform-digital-twins,
        ngm:virtual-replica ;
    vc:requires ngm:digital-twin-technology,
        ngm:simulation-engine ;
    vc:slug "virtual-factory" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:digital-twin-infrastructure,
        ngm:simulation .

ngm:virtual-location a owl:Class ;
    rdfs:label "Virtual Location"@en ;
    rdfs:comment "A defined spatial coordinate or addressable place within a virtual environment, representing specific positions, areas, or destinations that users can navigate to, reference, and interact with in metaverse platforms."@en ;
    rdfs:subClassOf ngm:sc-platform-and-environment,
        ngm:virtual-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:virtual-world ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:virtual-identity,
        ngm:virtual-land-rights ;
    vc:slug "virtual-location" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:metaverse-navigation-systems,
        ngm:portal-system .

ngm:virtual-network a owl:Class ;
    rdfs:label "Virtual Network"@en ;
    rdfs:comment "A software-defined network infrastructure that creates logical network segments over physical hardware, enabling isolated, configurable communication channels for metaverse platforms, cloud services, and distributed applications through technologies such as VLANs, VPNs, Software Defined Networking (SDN), and 5G network slicing. Virtual networks provide Quality of Service guarantees, traffic isolation, and bandwidth allocation essential for latency-sensitive XR workloads."@en ;
    rdfs:subClassOf ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:enables ngm:edge-computing,
        ngm:metaverse-platform ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:network-infrastructure ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:slug "virtual-network" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:spatial-computing ;
    vc:uses ngm:encryption .

ngm:virtual-office-spaces a owl:Class ;
    rdfs:label "Virtual Office Spaces"@en ;
    rdfs:comment "Virtual office spaces are persistent 3D environments hosted on VR or metaverse platforms where distributed teams gather as avatars to collaborate, attend meetings, use shared whiteboards, and navigate spatial office layouts, replicating physical workplace social dynamics whilst enabling global remote participation through immersive telepresence. Unlike transient video calls, these environments preserve spatial context across sessions — desks remain assigned, whiteboards retain content, and colleagues can be discovered by proximity cues. Leading implementations include Microsoft Mesh, Meta Horizon Workrooms, and Spatial."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:extended-reality ],
        ngm:dc-workspace-tools ;
    skos:broader ngm:dc-workspace-tools ;
    vc:bridgesTo ngm:virtual-environment ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:distributed-collaboration,
        ngm:telecollaboration ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:digital-twin,
        ngm:mixed-reality,
        ngm:remote-collaboration,
        ngm:social-vr ;
    vc:requires ngm:extended-reality ;
    vc:slug "virtual-office-spaces" ;
    vc:sourceDomain "distributed-collaboration" ;
    vc:uses ngm:avatar-system,
        ngm:presence,
        ngm:spatial-audio,
        ngm:virtual-reality .

ngm:virtual-reality-applications a owl:Class ;
    rdfs:label "Virtual Reality Applications"@en ;
    rdfs:comment "Software programmes and use-case deployments that leverage virtual reality technology to deliver immersive, interactive experiences for domains including healthcare, education, enterprise training, entertainment, and social interaction, running on dedicated VR hardware or spatial computing platforms."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:virtual-reality-platform ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:virtual-world-infrastructure ],
        ngm:sc-platform-and-environment,
        ngm:virtual-reality ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:enables ngm:virtual-clinic,
        ngm:virtual-experience ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:education-metaverse,
        ngm:extended-reality,
        ngm:immersive-experience ;
    vc:requires ngm:virtual-reality-platform,
        ngm:virtual-world-infrastructure ;
    vc:slug "virtual-reality-applications" ;
    vc:sourceDomain "spatial-computing" .

ngm:virtual-replica a owl:Class ;
    rdfs:label "Virtual Replica"@en ;
    rdfs:comment "A digital representation of a physical object, system, or environment created through 3D modelling, photogrammetry, or LiDAR scanning, serving as a static or dynamic copy for visualisation, simulation, analysis, and testing without the real-time bidirectional data connectivity that distinguishes a full digital twin. Virtual replicas are typically point-in-time snapshots; they support heritage preservation, product safety testing, urban planning, and manufacturing visualisation workflows."@en ;
    rdfs:subClassOf ngm:digital-model,
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:contrastsWith ngm:digital-twin ;
    vc:enables ngm:virtual-factory,
        ngm:virtual-museum-tour ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:digital-modeling,
        ngm:simulation-software ;
    vc:slug "virtual-replica" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:3-d-modeling,
        ngm:photogrammetry,
        ngm:simulation .

ngm:virtual-world-building a owl:Class ;
    rdfs:label "Virtual World Building"@en ;
    rdfs:comment "The process of creating 3D virtual environments for metaverse platforms, games, and simulations using tools ranging from no-code drag-and-drop builders to professional game engines, enabling the construction of immersive digital spaces with customisable assets, terrain, physics, and interactive elements. Generative AI is rapidly lowering barriers through voice and text-prompt environment generation, while Unity and Unreal Engine remain the professional standard for complex, large-scale world creation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:real-time-rendering ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:game-engine ],
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:bridgesTo ngm:3-d-design ;
    vc:enables ngm:virtual-destination,
        ngm:virtual-environment-creation,
        ngm:virtual-world-platform ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:virtual-world-creation ;
    vc:requires ngm:game-engine,
        ngm:real-time-rendering ;
    vc:slug "virtual-world-building" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:3-d-modeling,
        ngm:immersive-experience .

ngm:visual-servoing a owl:Class ;
    rdfs:label "VisualServoing"@en ;
    rdfs:comment "Visual servoing is a robot control paradigm in which camera-derived visual measurements are used as feedback signals within a closed-loop control system to guide the motion of a robotic manipulator or mobile platform towards a goal configuration defined in visual terms. Rather than relying on pre-computed geometric trajectories, visual servoing continuously computes control signals from current image features or image-space error signals, making it inherently adaptive to object pose uncertainty and disturbances. The two primary architectures are image-based visual servoing (IBVS), which minimises error in image feature space, and position-based visual servoing (PBVS), which reconstructs 3D pose and minimises Cartesian error. Visual servoing enables tasks such as precise grasping, assembly alignment, and autonomous navigation without requiring exact geometric calibration."@en ;
    rdfs:subClassOf ngm:robot-control ;
    vc:enables ngm:manipulation,
        ngm:motion-control,
        ngm:path-planning ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:camera-calibration,
        ngm:end-effector,
        ngm:feedback-control ;
    vc:slug "visual-servoing" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:camera,
        ngm:closed-loop-control,
        ngm:computer-vision .

ngm:voting a skos:Concept ;
    rdfs:label "Voting"@en .

ngm:vr-psychology a owl:Class ;
    rdfs:label "VR Psychology"@en ;
    rdfs:comment "VR Psychology is the scientific study of how virtual reality environments affect human cognition, perception, emotion, behaviour, and wellbeing. It encompasses research into presence, embodiment, cybersickness, avatar effects, and therapeutic applications of immersive virtual environments, informing the design of XR systems that are psychologically safe and effective."@en ;
    rdfs:subClassOf ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:relatedTo ngm:cognitive-science,
        ngm:haptic-feedback,
        ngm:presence,
        ngm:user-experience ;
    vc:slug "vr-psychology" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:immersion,
        ngm:virtual-reality .

ngm:w-3-c-owl-2 a owl:Class ;
    rdfs:label "W3C OWL 2"@en ;
    rdfs:comment "W3C OWL 2 is the Web Ontology Language, a knowledge representation language for authoring ontologies that describe classes, properties and individuals on the Web."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
