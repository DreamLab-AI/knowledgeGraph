ngm:inter-agent-communication a owl:Class ;
    rdfs:label "Inter-Agent Communication"@en ;
    rdfs:comment "Inter-Agent Communication is the set of protocols, message formats, and transport mechanisms through which autonomous software agents exchange information, coordinate tasks, delegate subtasks, share observations, and negotiate commitments in multi-agent systems (MAS), spanning both classical symbolic AI frameworks (FIPA ACL, KQML) and contemporary LLM-based architectures (Model Context Protocol, Agent2Agent Protocol, tool-calling schemas). Effective inter-agent communication defines the content language (what is expressed), the interaction protocol (how exchanges are sequenced), and the transport layer (how messages are delivered), enabling heterogeneous agents built on different underlying models to collaborate without shared internal state. The discipline encompasses message authentication, semantic interoperability, context propagation, and trust boundaries between agents of differing capability and provenance."@en ;
    rdfs:subClassOf ngm:multi-agent-system ;
    vc:enables ngm:agentic-ai,
        ngm:agentic-workflow,
        ngm:orchestration ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:agent2-agent-protocol,
        ngm:mas,
        ngm:message-passing,
        ngm:multi-agent-systems ;
    vc:slug "inter-agent-communication" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:function-calling,
        ngm:model-context-protocol,
        ngm:rest-api,
        ngm:tool-use .

ngm:knowledge-representation-domain a owl:Class ;
    rdfs:label "Knowledge Representation Domain"@en ;
    rdfs:comment "The Knowledge Representation Domain covers the formal encoding of facts, concepts and relationships so that machines can reason over them. Its scope includes ontologies, knowledge graphs, description logics and rule systems. It is a sub-area of the Artificial Intelligence Domain that provides the symbolic counterpart to statistical learning. The boundary excludes the learning of representations from raw data, which belongs to the Machine Learning Domain."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:ontology ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:semantic-network ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:knowledge-graph ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:description-logic ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:rule-based-systems ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:logic ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:formal-methods-domain ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:set-theory ],
        ngm:artificial-intelligence-domain ;
    vc:enables ngm:automated-reasoning,
