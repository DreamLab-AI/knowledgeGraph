ngm:permissionless-innovation a owl:Class ;
    rdfs:comment "A policy stance holding that new technologies and business models should generally be allowed to develop without prior approval, with regulation applied only to address demonstrated harms. It is often discussed in the context of the internet and digital finance."@en ;
    rdfs:label "Permissionless Innovation"@en ;
    rdfs:subClassOf ngm:governance ;
