        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:utxo ],
        ngm:bitcoin-proof-of-work-protocol ;
    vc:bridgesTo ngm:decentralised-finance,
        ngm:digital-currency ;
    vc:contrastsWith ngm:ethereum-protocol,
        ngm:proof-of-stake ;
    vc:enables ngm:bitcoin-proof-of-work-protocol-script,
        ngm:lightning-network,
