    vc:sourceDomain "infrastructure" .

ngm:selective-disclosure a owl:Class ;
    rdfs:label "Selective Disclosure"@en ;
    rdfs:comment "Selective disclosure is a cryptographic capability that allows the holder of a verifiable credential to present only a chosen subset of the credential's claims to a verifier, without revealing the undisclosed fields or requiring re-issuance by the issuer. It is implemented through specialised signature schemes such as BBS+ signatures and SD-JWT, as well as zero-knowledge proof systems, enabling fine-grained data minimisation in decentralised identity architectures. As a core privacy-engineering primitive, selective disclosure satisfies regulatory requirements such as GDPR's data minimisation principle and supports the eIDAS 2.0 digital wallet framework. The concept bridges cryptographic credential security with practical privacy-preserving authentication across identity, finance, and access-control domains."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:verifiable-credentials ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:zero-knowledge-proof ],
        ngm:privacy-preserving-technology ;
    vc:bridgesTo ngm:differential-privacy,
        ngm:federated-learning ;
    vc:contrastsWith ngm:bearer-token,
        ngm:full-credential-presentation ;
    vc:enables ngm:attribute-based-access-control,
        ngm:data-minimisation,
        ngm:decentralised-identity,
        ngm:privacy-preserving-authentication ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:implements ngm:bbs-plus-signatures,
        ngm:sd-jwt,
        ngm:zk-snarks ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:credential-format-standard,
        ngm:decentralised-identifier,
        ngm:digital-identity-wallet ;
    vc:requires ngm:cryptographic-commitment-scheme,
        ngm:verifiable-credentials,
        ngm:zero-knowledge-proof ;
    vc:slug "selective-disclosure" ;
    vc:sourceDomain "security" ;
    vc:standardizedBy ngm:decentralised-identity-foundation,
        ngm:ietf-sd-jwt,
        ngm:w3c-verifiable-credentials-data-model ;
    vc:supports ngm:eidas-2,
        ngm:gdpr-compliance,
        ngm:self-sovereign-identity ;
    vc:uses ngm:digital-signature,
        ngm:elliptic-curve-cryptography,
        ngm:hash-function,
        ngm:merkle-tree .

ngm:context-window a owl:Class ;
    rdfs:label "Context Window"@en ;
    rdfs:comment "The maximum sequence length that a language model can process in a single forward pass, measured in tokens; it determines how much prior context the model can attend to during generation or understanding tasks and directly bounds memory, coherence, and long-range reasoning capabilities."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
