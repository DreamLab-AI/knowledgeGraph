ngm:few-shot-prompting a owl:Class ;
    rdfs:label "Few-Shot Prompting"@en ;
    rdfs:comment "Few-shot prompting is a prompt engineering technique in which a small number of input-output demonstration examples are included directly in the context provided to a large language model, guiding the model to produce outputs conforming to the demonstrated pattern without any parameter updates. The approach exploits the in-context learning capability of transformer-based models, allowing task specification through examples rather than task-specific fine-tuning."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:context-window ],
        ngm:prompt-engineering ;
    vc:contrastsWith ngm:few-shot-learning ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:chain-of-thought-prompting,
        ngm:zero-shot-prompting ;
    vc:requires ngm:context-window ;
    vc:slug "few-shot-prompting" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:few-shot-examples,
        ngm:in-context-learning .

ngm:film-production a owl:Class ;
    rdfs:label "Film Production"@en ;
    rdfs:comment "The end-to-end creative and technical process of making motion picture content, encompassing development, pre-production, principal photography, visual effects, post-production, and distribution. Modern film production increasingly integrates spatial computing technologies such as virtual production workflows, LED volume stages, real-time game engine rendering, and AI-assisted tools that compress timelines and reduce location dependency."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
