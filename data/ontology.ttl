ngm:voice-of-customer a owl:Class ;
    rdfs:comment "Voice of Customer (VoC) is the systematic capture and analysis of customer feedback, from surveys, support transcripts, reviews and social channels, to surface expressed needs, preferences and pain points that inform product and service decisions. Modern VoC programmes increasingly use natural language processing to extract sentiment and themes from unstructured feedback at scale. It is a core input to customer experience management processes."@en ;
    rdfs:label "Voice of Customer"@en ;
    rdfs:subClassOf ngm:customer-experience ;
    rdfs:subClassOf _:r22251 ;
