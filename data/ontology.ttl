ngm:fin-cen a owl:Class ;
    rdfs:label "FinCEN"@en ;
    rdfs:comment "The Financial Crimes Enforcement Network (FinCEN) is a bureau of the US Department of the Treasury established in 1990 that serves as the primary US financial intelligence unit (FIU). FinCEN administers the Bank Secrecy Act (BSA), collects financial transaction reports from financial institutions (SARs, CTRs), analyses this data for patterns of money laundering, terrorist financing, and financial fraud, and shares intelligence with law enforcement and foreign FIUs through the Egmont Group. FinCEN also issues regulatory guidance and rulemaking for digital asset service providers including money service businesses (MSBs) and, since 2019, cryptocurrency exchanges."@en ;
    rdfs:subClassOf ngm:regulatory-framework ;
    vc:enables ngm:aml-kyc-compliance,
        ngm:anti-money-laundering,
        ngm:sanctions-enforcement ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:blockchain-compliance,
        ngm:financial-regulation,
        ngm:sanctions-screening,
        ngm:us-regulatory-framework ;
    vc:slug "fin-cen" ;
    vc:sourceDomain "finance" ;
    vc:uses ngm:compliance-audit-trail,
        ngm:compliance-framework .

ngm:fixed-supply-token a owl:Class ;
    rdfs:label "Fixed Supply Token"@en ;
    rdfs:comment "A Fixed Supply Token is a fungible blockchain token whose total issuance is capped at a hard-coded maximum that the protocol cannot exceed, regardless of future governance decisions. Distribution of the supply over time is governed by a predetermined emission schedule, and no additional tokens can be minted once the cap is reached, conferring deflationary scarcity properties analogous to precious metals."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:emission-schedule ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:total-supply ],
        ngm:bc-token-and-asset,
        ngm:fungible-token ;
    skos:broader ngm:bc-token-and-asset ;
    vc:contrastsWith ngm:deflationary-token,
        ngm:inflationary-token ;
    vc:enables ngm:burning-mechanism ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:emission-schedule,
        ngm:total-supply ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:circulating-supply,
        ngm:halving,
        ngm:market-capitalization,
        ngm:token-economics,
        ngm:tokenomics ;
    vc:slug "fixed-supply-token" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:blockchain-protocol .

ngm:flash-loan a owl:Class ;
    rdfs:label "Flash Loan"@en ;
    rdfs:comment "A flash loan is an uncollateralised loan mechanism in decentralised finance that exists entirely within a single blockchain transaction: the borrower receives an arbitrary amount of an asset, executes arbitrary on-chain operations with it, and repays the loan plus a fee within the same atomic transaction, with the entire sequence reverting if repayment fails. Because atomicity guarantees that funds never leave the lending pool without being returned, no collateral is needed; default is technically impossible since a failed repayment causes the transaction to revert as if the loan never occurred. Flash loans enable capital-efficient arbitrage, liquidation, collateral swaps, and self-liquidation operations that would otherwise require significant upfront capital."@en ;
    rdfs:subClassOf ngm:de-fi ;
    vc:enables ngm:digital-asset-lending,
        ngm:liquidity-provision,
        ngm:mev ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:decentralised-finance,
        ngm:decentralized-exchange,
        ngm:transaction ;
    vc:slug "flash-loan" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:atomic-settlement,
        ngm:liquidity-pool,
        ngm:smart-contract,
        ngm:smart-contract-execution .

ngm:food-safety-blockchain a owl:Class ;
    rdfs:label "Food Safety Blockchain"@en ;
    rdfs:comment "Food Safety Blockchain is the application of distributed ledger technology to establish immutable, multi-party farm-to-fork audit trails that enable near-instantaneous contamination source identification and surgical product recalls. By recording each Critical Tracking Event—harvest, cooling, packing, shipment, receipt—as a cryptographically linked on-chain entry, the approach reduces trace-back from days to seconds, minimises the volume of food unnecessarily recalled, and provides regulators and consumers with verifiable provenance data."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:consortium-blockchain ],
        ngm:blockchain-application ;
    vc:enables ngm:audit-trail,
        ngm:provenance-tracking,
        ngm:supply-chain-traceability ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:blockchain-compliance,
        ngm:data-provenance,
        ngm:pharmaceutical-traceability,
        ngm:supply-chain-blockchain ;
    vc:requires ngm:consortium-blockchain ;
    vc:slug "food-safety-blockchain" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:hyperledger-fabric,
        ngm:internet-of-things,
        ngm:permissioned-blockchain,
        ngm:smart-contracts .

ngm:fractionalized-nft a owl:Class ;
    rdfs:label "Fractionalized NFT"@en ;
    rdfs:comment "A non-fungible token whose ownership has been divided into multiple fungible token shares, enabling collective ownership and enhanced liquidity of high-value unique digital assets."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
