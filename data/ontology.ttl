ngm:nft-swapping a owl:Class ;
    rdfs:label "NFT Swapping"@en ;
    rdfs:comment "Process of executing mutual exchange of non-fungible tokens between participants using atomic smart contract transactions that ensure simultaneous bilateral asset transfer."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:blockchain-network ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:verification ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:smart-contract ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:transaction ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:nft-ownership-proof ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gas-fee ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:digital-signature ],
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:bridgesTo ngm:virtual-economy ;
    vc:enables ngm:asset-liquidity,
        ngm:peer-to-peer-trading ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:smart-contract,
        ngm:transaction,
        ngm:verification ;
    vc:isPartOf ngm:decentralized-exchange,
        ngm:nft-marketplace ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:blockchain-network,
        ngm:digital-signature,
        ngm:gas-fee,
        ngm:nft-ownership-proof ;
    vc:slug "nft-swapping" ;
    vc:sourceDomain "spatial-computing" .

