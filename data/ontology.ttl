    a owl:Restriction ;
    owl:onProperty infrastructure:enables ;
    owl:someValuesFrom artificial-intelligence:Compliance
] .

artificial-intelligence:Accountability rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty infrastructure:enables ;
    owl:someValuesFrom artificial-intelligence:RiskManagementAI0078
] .

