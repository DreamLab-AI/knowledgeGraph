    vc:implements ngm:workflow-orchestration ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:consensus-mechanism ;
    vc:relatedTo ngm:git ;
    vc:relatedTo ngm:merkle-dag ;
    vc:slug "directed-acyclic-graph" ;
    vc:sourceDomain "distributed-collaboration" ;
    vc:supports ngm:distributed-systems ;
    vc:uses ngm:graph-theory .
ngm:directed-acyclic-graph-execution a owl:Class ;
    rdfs:comment "Directed acyclic graph (DAG) execution is a computation model in which tasks are nodes connected by directed dependency edges that contain no cycles, so the graph defines a partial order of operations. An execution engine performs a topological sort and runs nodes as soon as their inputs are ready, enabling parallelism, caching of unchanged subgraphs, and deterministic recomputation. It is the scheduling backbone of workflow engines and node-based authoring tools."@en ;
    rdfs:label "Directed Acyclic Graph Execution"@en ;
    rdfs:subClassOf ngm:software-architecture ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
