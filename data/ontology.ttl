    vc:slug "user-context-awareness" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:preference-learning .

ngm:user-privacy a owl:Class ;
    rdfs:label "User Privacy"@en ;
    rdfs:comment "User Privacy encompasses the rights, technical mechanisms, and regulatory obligations protecting individuals from unwanted disclosure of their identity, transactions, and behavioural patterns within digital and blockchain systems. Protections span cryptographic techniques (zero-knowledge proofs, ring signatures, confidential transactions), network-layer obfuscation (Dandelion++, Tor), and compliance frameworks (GDPR, data minimisation principles)."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gdpr-compliance ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-protection ],
        ngm:infra-legal-and-regulatory,
        ngm:privacy-framework ;
    skos:broader ngm:infra-legal-and-regulatory ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:cryptography-security-and-privacy,
        ngm:privacy-by-design ;
    vc:requires ngm:data-protection,
        ngm:gdpr-compliance ;
    vc:slug "user-privacy" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:differential-privacy,
        ngm:encryption,
        ngm:zero-knowledge-proof .

ngm:validation-report a owl:Class ;
    rdfs:label "VALIDATION_REPORT"@en ;
    rdfs:comment "A Validation Report is a systematic assessment document verifying ontology compliance, data quality, and structural integrity across knowledge graphs and semantic systems. It checks that class hierarchies, relation targets, definition coverage, and maturity fields meet specified quality thresholds, producing actionable findings for enrichment pipelines."@en ;
