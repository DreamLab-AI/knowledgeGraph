ngm:inflation-control a owl:Class ;
    rdfs:label "Inflation Control"@en ;
    rdfs:comment "Inflation Control encompasses the mechanisms, policies, and economic design patterns used within virtual and metaverse economies to regulate the creation, circulation, and destruction of virtual currency and digital assets. These controls prevent hyperinflation and value collapse by balancing supply-side minting with demand-side sinks. Effective inflation control underpins the long-term viability of play-to-earn ecosystems, NFT markets, and decentralised finance platforms built on virtual worlds."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:tokenomics ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:burning-mechanism ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:circulating-supply ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:minting ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:virtual-currency ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:sink-mechanism ],
        ngm:metaverse,
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:enables ngm:creator-economy,
        ngm:digital-economy,
        ngm:play-to-earn-p2-e ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:burning-mechanism,
        ngm:circulating-supply,
        ngm:minting,
