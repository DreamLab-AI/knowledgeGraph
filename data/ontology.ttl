        ngm:vulnerability ;
    vc:slug "third-party-auditor" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:blockchain,
        ngm:risk-assessment .

ngm:tls-encryption a owl:Class ;
    rdfs:label "TLS Encryption"@en ;
    rdfs:comment "TLS (Transport Layer Security) encryption is the cryptographic protocol layer that provides confidentiality, integrity, and server authentication for communications over TCP/IP networks, most visibly as the foundation of HTTPS. It operates through a handshake that negotiates cipher suites, authenticates servers (and optionally clients) via X.509 certificates, establishes ephemeral session keys using asymmetric key exchange (ECDHE), and then encrypts all subsequent data using symmetric ciphers (AES-GCM). TLS 1.3 (RFC 8446, 2018) is the current standard, eliminating obsolete constructs and reducing handshake latency to one round trip."@en ;
    rdfs:subClassOf ngm:cryptographic-protocol ;
    vc:enables ngm:network-security,
        ngm:secure-communication ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:cryptographic-key-management,
        ngm:key-derivation-function,
        ngm:tls ;
    vc:slug "tls-encryption" ;
    vc:sourceDomain "security" ;
    vc:uses ngm:asymmetric-encryption,
        ngm:certificate-authority,
        ngm:digital-certificate,
        ngm:knowledge-graph-publication-classifier-key-infrastructure,
        ngm:symmetric-encryption .

ngm:token-economy a owl:Class ;
    rdfs:label "Token Economy"@en ;
    rdfs:comment "A token economy is an economic system in which digital tokens — cryptographic representations of value, rights, or access — serve as the primary medium of exchange, incentive, and governance within a defined platform or protocol. Token economies leverage blockchain infrastructure to create programmable, permissionless economic systems where tokens encode ownership (utility tokens, security tokens, governance tokens, NFTs), align participant incentives through staking and reward mechanisms, and enable decentralised governance. The concept spans DeFi protocols, Web3 platforms, creator economies, and emerging AI agent economies."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:incentive-alignment ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:mechanism-design ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:reward-distribution ],
        ngm:blockchain-economics ;
    vc:dependsOn ngm:blockchain-protocol,
        ngm:smart-contracts ;
    vc:enables ngm:creator-economy,
        ngm:dao-governance,
        ngm:decentralized-finance-de-fi ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:incentive-alignment,
        ngm:mechanism-design,
        ngm:reward-distribution ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:crypto-token,
        ngm:governance-token,
        ngm:tokenomics,
        ngm:utility-token ;
    vc:slug "token-economy" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:nft,
        ngm:social-token-economy .

ngm:tool-definition a owl:Class ;
    rdfs:label "Tool Definition"@en ;
    rdfs:comment "A Tool Definition is a structured specification that describes a capability that an AI language model or agent can invoke at runtime, including the tool's name, a natural language description of its purpose, and a formal schema defining its input parameters and expected output format. Tool definitions are the primary mechanism through which AI systems access external functionality, enabling them to call APIs, query databases, execute code, retrieve documents, or perform actions in the world beyond text generation. The format of tool definitions is standardised by providers such as Anthropic, OpenAI, and Google, typically using JSON Schema to describe parameters, and the quality of a tool definition's description and schema directly determines how reliably an AI model selects and invokes it."@en ;
    rdfs:subClassOf ngm:tool-schema ;
    vc:enables ngm:agentic-workflow,
        ngm:autonomous-agent ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:function-calling,
        ngm:json-data-interchange-format-schema,
        ngm:tool-use ;
    vc:slug "tool-definition" ;
    vc:sourceDomain "ai" ;
    vc:supports ngm:multi-agent-systems ;
    vc:uses ngm:function-calling,
        ngm:schema-definition .

ngm:trajectory-control a owl:Class ;
    rdfs:label "Trajectory Control"@en ;
    rdfs:comment "Trajectory Control is a robotics control methodology that tracks desired time-varying position, velocity, and acceleration profiles along planned paths. It coordinates joint-space and task-space motion to ensure smooth, precise end-effector movement while respecting dynamic and kinematic constraints."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:inverse-kinematics ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:trajectory-generation ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:velocity-control ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:trajectory-planning ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:kinematics ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:position-control ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:feedback-control ],
        ngm:motion-control,
        ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:position-control,
        ngm:trajectory-generation,
        ngm:trajectory-planning,
        ngm:velocity-control ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:collision-avoidance,
        ngm:motion-planning,
        ngm:path-planning,
        ngm:robot-control ;
    vc:requires ngm:feedback-control,
        ngm:inverse-kinematics,
        ngm:kinematics ;
    vc:slug "trajectory-control" ;
    vc:sourceDomain "robotics" .

ngm:trajectory-tracking a owl:Class ;
    rdfs:label "Trajectory Tracking"@en ;
    rdfs:comment "Trajectory tracking is the control problem of causing a dynamical system—typically a robot, vehicle, or aerial platform—to follow a prescribed time-parameterised path through configuration space with minimal deviation. It couples a reference trajectory generated by a planner with a feedback controller that corrects errors arising from disturbances, model mismatch, and actuation limits. Trajectory tracking controllers range from classical PID and linear quadratic regulators to model predictive controllers and learning-based approaches. It is a central capability in mobile robotics, autonomous driving, drone flight, and industrial manipulator control."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:feedforward-control ],
        ngm:trajectory-control ;
    vc:bridgesTo ngm:imitation-learning,
        ngm:reinforcement-learning ;
    vc:contrastsWith ngm:path-following-control,
        ngm:setpoint-regulation ;
    vc:dependsOn ngm:sensor-fusion,
        ngm:state-estimation,
        ngm:system-identification,
        ngm:trajectory-planning ;
    vc:enables ngm:autonomous-driving,
        ngm:autonomous-navigation,
        ngm:drone-flight-control,
        ngm:motion-control ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:feedforward-control,
        ngm:tracking-error-metric ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:path-planning,
        ngm:robust-control,
        ngm:trajectory-generation,
        ngm:whole-body-control ;
    vc:requires ngm:error-dynamics,
        ngm:reference-trajectory ;
    vc:slug "trajectory-tracking" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:differential-flatness,
        ngm:feedback-control,
        ngm:linear-quadratic-regulator,
        ngm:model-predictive-control,
        ngm:motion-model,
        ngm:pid-controller .

ngm:transaction-processing a owl:Class ;
    rdfs:label "Transaction Processing"@en ;
    rdfs:comment "Transaction Processing encompasses the end-to-end lifecycle of blockchain transactions — from cryptographic signing and mempool propagation through validation, deterministic state execution, and finality confirmation. It includes parallelisation strategies, layer-2 scaling (state channels, rollups), and cross-chain atomic operations, with MEV mitigation and encrypted mempools addressing ordering fairness."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:smart-contract ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:consensus-mechanism ],
        ngm:infra-computing-and-cloud ;
    skos:broader ngm:infra-computing-and-cloud ;
    vc:bridgesTo ngm:blockchain-transaction ;
    vc:enables ngm:decentralised-finance,
        ngm:payment-system,
        ngm:transaction-finality ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:requires ngm:consensus-mechanism,
        ngm:smart-contract ;
    vc:slug "transaction-processing" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:stablecoin,
        ngm:transaction-fee,
