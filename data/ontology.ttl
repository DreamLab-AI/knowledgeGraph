ngm:batch-size a owl:Class ;
    rdfs:label "Batch Size"@en ;
    rdfs:comment "Batch Size is the number of training examples processed together in a single forward and backward pass before model parameters are updated. It is a critical hyperparameter governing the trade-off between training speed, memory usage, gradient noise, and convergence stability—small batches introduce regularising noise via stochastic gradient estimates, whilst large batches enable faster hardware utilisation but may generalise less well."@en ;
    rdfs:subClassOf ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:contrastsWith ngm:overfitting ;
    vc:dependsOn ngm:deep-learning ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:gradient-descent ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:epoch,
        ngm:hyperparameter ;
    vc:slug "batch-size" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:battery-management-system a owl:Class ;
    rdfs:label "Battery Management System"@en ;
    rdfs:comment "A Battery Management System (BMS) is an embedded electronic system that monitors, protects, and optimises the operation of a rechargeable battery pack by continuously measuring cell voltages, currents, and temperatures, then enforcing safety limits and balancing cell state-of-charge to extend pack lifetime. It provides the digital intelligence layer between raw electrochemical energy storage and the broader power electronics or vehicle system, communicating pack status via standardised interfaces such as CAN bus. Accurate state-of-charge and state-of-health estimation algorithms are the defining computational challenge of modern BMS design."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:temperature-sensor ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:monitoring-system ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:firmware ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:current-sensor ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:can-bus ],
        ngm:embedded-systems ;
    vc:bridgesTo ngm:artificial-intelligence,
        ngm:cloud-computing,
        ngm:machine-learning ;
    vc:enables ngm:power-supply,
        ngm:predictive-maintenance,
        ngm:thermal-management ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:current-sensor,
        ngm:monitoring-system,
        ngm:temperature-sensor ;
    vc:isPartOf ngm:electric-vehicle ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:energy-and-power,
        ngm:energy-management,
        ngm:hardware-component ;
    vc:requires ngm:can-bus,
        ngm:firmware ;
    vc:slug "battery-management-system" ;
    vc:sourceDomain "infrastructure" ;
    vc:standardizedBy ngm:iso-26262 ;
    vc:supports ngm:fleet-management,
        ngm:functional-safety ;
    vc:uses ngm:control-system,
        ngm:kalman-filter,
        ngm:power-management .

ngm:bip-341 a owl:Class ;
    rdfs:label "BIP-341"@en ;
    rdfs:comment "BIP-341 is the Bitcoin Improvement Proposal that specifies the Taproot upgrade, introducing Pay-to-Taproot (P2TR) as a native SegWit version 1 output type that unifies key-path and script-path spending under a single Schnorr-based commitment. It integrates Merklised Alternative Script Trees (MAST) so that only the executed spending branch is revealed on-chain, preserving the privacy of unexplored script conditions. BIP-341 activated on the Bitcoin mainnet at block 709,632 in November 2021 via the Speedy Trial soft-fork mechanism, requiring 90% miner signalling. It forms part of the Taproot bundle alongside BIP-340 (Schnorr signatures for Bitcoin) and BIP-342 (Tapscript), collectively the largest upgrade to Bitcoin's scripting system since SegWit."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:bip-340 ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:bip-342 ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:seg-wit ],
        ngm:bc-protocol-and-consensus ;
    skos:broader ngm:bc-protocol-and-consensus ;
    vc:bridgesTo ngm:smart-contract,
        ngm:zero-knowledge-proof ;
    vc:contrastsWith ngm:ecdsa,
        ngm:pay-to-script-hash ;
    vc:dependsOn ngm:utxo-model ;
    vc:enables ngm:bitcoin-script,
        ngm:lightning-network,
        ngm:multisignature,
        ngm:taproot-assets ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:pay-to-taproot ;
    vc:isPartOf ngm:taproot ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:bitcoin-proof-of-work-protocol-core,
        ngm:bitcoin-proof-of-work-protocol-network ;
    vc:requires ngm:bip-340,
        ngm:bip-342,
        ngm:seg-wit ;
    vc:slug "bip-341" ;
    vc:sourceDomain "blockchain" ;
    vc:standardizedBy ngm:bitcoin-proof-of-work-protocol-improvement-proposals ;
    vc:uses ngm:cryptographic-commitment,
        ngm:elliptic-curve-cryptography,
        ngm:merkle-tree,
        ngm:schnorr-signature,
        ngm:tagged-hash .

ngm:bis a owl:Class ;
    rdfs:label "BIS"@en ;
    rdfs:comment "The Bank for International Settlements (BIS) is an international financial institution owned by 63 member central banks, founded in 1930 and headquartered in Basel, Switzerland. It acts as banker to central banks, providing settlement, custody, and asset management services while fostering monetary and financial cooperation through research, policy forums, and standard-setting committees. The BIS hosts the Basel Committee on Banking Supervision, the Financial Stability Board secretariat, and the Committee on Payments and Market Infrastructures, which together produce globally binding prudential and operational standards such as the Basel Accords and CPMI principles. Through the BIS Innovation Hub it actively researches central bank digital currencies, tokenisation of financial assets, and cyber resilience for financial market infrastructures."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:basel-committee-on-banking-supervision ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:financial-stability-board ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:bis-innovation-hub ],
        ngm:infra-legal-and-regulatory ;
    skos:broader ngm:infra-legal-and-regulatory ;
    vc:bridgesTo ngm:blockchain,
        ngm:cyber-resilience,
        ngm:regtech ;
    vc:contrastsWith ngm:commercial-bank ;
    vc:enables ngm:cross-border-payments,
        ngm:financial-stability,
        ngm:monetary-policy-implementation,
        ngm:prudential-regulation ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:basel-committee-on-banking-supervision,
        ngm:bis-innovation-hub,
        ngm:financial-stability-board ;
    vc:implements ngm:basel-accords,
        ngm:capital-adequacy ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:central-bank-digital-currency,
        ngm:financial-regulation,
        ngm:financial-technology,
        ngm:international-monetary-fund,
        ngm:payment-system ;
    vc:slug "bis" ;
    vc:sourceDomain "finance" ;
    vc:supports ngm:central-bank,
        ngm:financial-infrastructure,
        ngm:financial-system,
        ngm:systemic-risk-management ;
    vc:uses ngm:distributed-ledger-technology,
        ngm:tokenization .

ngm:block-production a owl:Class ;
    rdfs:label "Block Production"@en ;
    rdfs:comment "Block production is the process by which a blockchain network assembles pending transactions into a new block, orders them, and proposes that block for inclusion in the canonical chain. In proof-of-stake and similar systems, validators are selected to produce blocks for given slots or epochs, executing the consensus protocol that determines who may extend the chain and when. Block production is the heartbeat of a blockchain, governing throughput, latency and the fair ordering of transactions."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:validator ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:consensus ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:staking ],
        ngm:blockchain-consensus ;
    vc:dependsOn ngm:proof-of-work ;
    vc:enables ngm:block-reward,
        ngm:finality,
        ngm:throughput ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:blockchain-consensus ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:block,
        ngm:blockchain,
        ngm:epoch,
        ngm:ethereum,
        ngm:gas-fee,
        ngm:ledger,
        ngm:mev,
        ngm:solana ;
    vc:requires ngm:consensus,
        ngm:staking,
        ngm:validator ;
    vc:slug "block-production" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:fork-choice-rule,
        ngm:mempool,
        ngm:transaction .

