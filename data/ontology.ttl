    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:asset-translation-layer,
        ngm:cross-chain-bridge,
        ngm:federated-identity,
        ngm:interoperability-protocol,
        ngm:metaverse,
        ngm:multi-world-governance,
        ngm:portal-system,
        ngm:universal-inventory ;
    vc:isPartOf ngm:spatial-web ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:asset-bridging,
        ngm:cross-platform-authentication,
