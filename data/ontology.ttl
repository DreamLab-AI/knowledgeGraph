    rdfs:label "Policy Gradient"@en .

ngm:policy-gradient-methods a skos:Concept ;
    rdfs:label "Policy Gradient Methods"@en .

ngm:polkadot-parachains a owl:Class ;
    rdfs:label "Polkadot Parachains"@en ;
    rdfs:comment "Application-specific sovereign blockchains that lease a slot on the Polkadot Relay Chain, inheriting its shared security model and cross-chain messaging infrastructure. Parachains can have custom runtime logic, consensus rules, and token economics whilst relying on the relay chain's validator set for finalisation, enabling heterogeneous specialised chains to interoperate without sacrificing security or decentralisation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:nominated-proof-of-stake ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:consensus-mechanism ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:web-assembly ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:validator-node ],
        ngm:bc-network-component ;
    skos:broader ngm:bc-network-component ;
    vc:enables ngm:blockchain-interoperability,
        ngm:blockchain-scalability,
        ngm:cross-chain-messaging ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:blockchain,
        ngm:blockchain-network ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:blockchain-governance,
        ngm:blockchain-protocol,
        ngm:cross-chain-bridge,
        ngm:proof-of-stake,
        ngm:smart-contract ;
    vc:requires ngm:consensus-mechanism,
        ngm:nominated-proof-of-stake,
        ngm:validator-node,
        ngm:web-assembly ;
    vc:slug "polkadot-parachains" ;
    vc:sourceDomain "blockchain" .

ngm:portable-identity a owl:Class ;
    rdfs:label "Portable Identity"@en ;
    rdfs:comment "Portable identity is the property of a digital identity that allows it to be carried by its owner across services, platforms, and trust domains without being locked to any single provider. It relies on user-held credentials and identifiers that any relying party can verify cryptographically. Portability is a core goal of decentralised and self-sovereign identity systems."@en ;
    rdfs:subClassOf ngm:digital-identity ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:decentralized-identifiers,
        ngm:self-sovereign-identity ;
    vc:slug "portable-identity" ;
    vc:sourceDomain "security" .

ngm:portal-system a owl:Class ;
    rdfs:label "Portal System"@en ;
    rdfs:comment "A spatial computing mechanism that enables instantaneous traversal between distinct virtual locations, worlds, or platform environments, rendering a visual aperture through which users can see and enter the destination, thereby facilitating cross-world navigation and interoperability in metaverse platforms."@en ;
    rdfs:subClassOf ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:enables ngm:cross-platform-interoperability,
        ngm:virtual-world-traversal ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:metaverse-navigation-systems,
        ngm:virtual-environment ;
    vc:slug "portal-system" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:real-time-rendering,
        ngm:virtual-location .

ngm:pose-graph a owl:Class ;
    rdfs:label "Pose Graph"@en ;
    rdfs:comment "A pose graph is a graph representation used in robotics where nodes are robot poses (positions and orientations) and edges encode relative spatial constraints derived from odometry or sensor measurements. Pose-graph optimisation finds the configuration of poses that best satisfies all constraints, correcting accumulated drift. It is the backbone of modern graph-based SLAM systems."@en ;
    rdfs:subClassOf ngm:robo-navigation-and-planning ;
    skos:broader ngm:robo-navigation-and-planning ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:topological-map ;
    vc:slug "pose-graph" ;
    vc:sourceDomain "robotics" .

ngm:pose-tracking a owl:Class ;
    rdfs:label "Pose Tracking"@en ;
    rdfs:comment "Pose tracking is the continuous estimation of the position and orientation (6-DoF pose) of a device, user, or body over time. In spatial computing it underpins head, hand, and controller tracking for AR and VR, fusing camera, IMU, and depth data at low latency. Accurate, drift-free pose tracking is essential for stable, comfortable immersive experiences."@en ;
    rdfs:subClassOf ngm:computer-vision ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:ar-display-device,
        ngm:spatial-computing ;
    vc:slug "pose-tracking" ;
    vc:sourceDomain "metaverse" .

ngm:postgre-sql a owl:Class ;
    rdfs:label "PostgreSQL"@en ;
    rdfs:comment "PostgreSQL is an open-source, ACID-compliant object-relational database management system (ORDBMS) that extends the SQL standard with features such as table inheritance, function overloading, and a rich type system including arrays, JSON, and user-defined types. It supports both relational and document storage paradigms, advanced indexing strategies including GIN, GiST, BRIN, and B-tree, and full-text search, making it a versatile choice for analytical and transactional workloads. Developed from the POSTGRES project at UC Berkeley (1986), it has been maintained as free software since 1996 and is widely regarded as the most standards-compliant open-source relational database."@en ;
    rdfs:subClassOf ngm:database-system ;
    vc:enables ngm:data-governance,
        ngm:machine-learning-discipline-infrastructure ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:data-storage,
        ngm:graph-database,
        ngm:query-processor ;
    vc:slug "postgre-sql" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:database-query,
        ngm:spatial-database,
        ngm:vector-database .

