    vc:uses ngm:optimal-control,
        ngm:reinforcement-learning,
        ngm:state-space-representation .

ngm:imf a owl:Class ;
    rdfs:label "IMF"@en ;
    rdfs:comment "The International Monetary Fund (IMF) is an intergovernmental organisation of 190 member countries, established in 1944 under the Bretton Woods Agreement, whose core mandate is to foster global monetary cooperation, secure exchange rate stability, facilitate balanced international trade, and provide financial assistance and policy advice to members experiencing balance-of-payments difficulties. The Fund operates as the world's primary multilateral lender of last resort for sovereign balance-of-payments crises, deploying conditional lending programmes backed by Special Drawing Rights (SDR) quotas contributed by members. Beyond crisis finance, the IMF conducts macroeconomic surveillance through bilateral Article IV consultations, publishes the World Economic Outlook and Global Financial Stability Report, and delivers technical assistance in fiscal, monetary, and financial-sector policy domains. Since 2017 the IMF has expanded into digital asset governance, publishing classification frameworks for crypto assets, CBDC design handbooks, and a Finternet unified-ledger vision that positions it as a de-facto norm-setter for sovereign digital money."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:imf-crypto-asset-classification-framework ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:imf-cbdc-framework ],
        ngm:infra-legal-and-regulatory ;
    skos:broader ngm:infra-legal-and-regulatory ;
    vc:bridgesTo ngm:digital-currency-multilateral-platform,
        ngm:finternet,
        ngm:tokenised-central-bank-money ;
    vc:contrastsWith ngm:brics-payment-system,
        ngm:world-bank ;
    vc:enables ngm:balance-of-payments-financing,
        ngm:exchange-rate-stability,
        ngm:sovereign-debt-restructuring ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:article-iv-consultation,
        ngm:imf-cbdc-framework,
        ngm:imf-crypto-asset-classification-framework,
        ngm:special-drawing-rights ;
    vc:isPartOf ngm:bretton-woods-system,
        ngm:international-financial-architecture ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:bis,
        ngm:fsb,
        ngm:g20,
        ngm:global-financial-stability-report,
        ngm:intergovernmental-organisation,
        ngm:world-economic-outlook,
        ngm:world-trade-organization ;
    vc:requires ngm:conditionality,
        ngm:quota-system ;
    vc:slug "imf" ;
    vc:sourceDomain "governance" ;
    vc:standardizedBy ngm:articles-of-agreement ;
    vc:supports ngm:cbdc-cross-border-settlement,
        ngm:central-bank-digital-currency-cbdc,
        ngm:financial-inclusion,
        ngm:macroprudential-policy .

ngm:immersive-collaboration a owl:Class ;
    rdfs:label "Immersive Collaboration"@en ;
    rdfs:comment "Immersive collaboration is the practice of working together within shared spatial virtual or mixed-reality environments where participants, represented by avatars, interact with 3D content and one another in real time. It extends remote teamwork beyond flat video calls by providing spatial audio, embodied presence, and manipulable shared objects. Immersive collaboration is a key application of metaverse and XR technologies for the enterprise."@en ;
    rdfs:subClassOf ngm:dc-telepresence ;
    skos:broader ngm:dc-telepresence ;
    vc:enables ngm:mixed-reality ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:immersive-computing ;
    vc:slug "immersive-collaboration" ;
    vc:sourceDomain "metaverse" .

ngm:immersive-entertainment a owl:Class ;
    rdfs:label "Immersive Entertainment"@en ;
    rdfs:comment "Entertainment experiences leveraging VR, AR, and mixed reality technologies to create interactive, participatory content that transforms audiences from passive spectators into active participants within gaming, theme parks, live events, and digital experiences."@en ;
    rdfs:subClassOf ngm:digital-entertainment,
