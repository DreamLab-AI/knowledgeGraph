ngm:real-time-rendering-engine a owl:Class ;
    rdfs:label "Real-Time Rendering Engine"@en ;
    rdfs:comment "A real-time rendering engine generates images from 3D scene descriptions fast enough to sustain interactive frame rates, typically 30 to 120+ frames per second. It coordinates GPU rasterisation or ray tracing, shading, lighting, and post-processing within a fixed per-frame time budget. It is the visual core of game engines, virtual production, and immersive metaverse experiences."@en ;
    rdfs:subClassOf ngm:sc-display-and-rendering ;
    skos:broader ngm:sc-display-and-rendering ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:metaverse-content-pipeline,
        ngm:virtual-production-volume ;
    vc:slug "real-time-rendering-engine" ;
    vc:sourceDomain "metaverse" .

ngm:real-time-streaming a owl:Class ;
    rdfs:label "Real-Time Streaming"@en ;
    rdfs:comment "Real-time streaming is the continuous delivery of data, audio, or video as an ongoing flow consumed incrementally with minimal latency rather than downloaded in full beforehand. It uses low-latency transport protocols and buffering strategies to balance smoothness against delay. It underpins live media, event streams, and interactive low-latency experiences."@en ;
    rdfs:subClassOf ngm:network-protocol ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:agent-event-stream,
        ngm:virtual-performance-space ;
    vc:slug "real-time-streaming" ;
    vc:sourceDomain "infrastructure" .

ngm:real-time-systems a skos:Concept ;
    rdfs:label "Real Time Systems"@en .

ngm:real-world-asset-tokenization a skos:Concept ;
    rdfs:label "Real World Asset Tokenization"@en .

ngm:reality-capture a owl:Class ;
    rdfs:label "Reality Capture"@en ;
    rdfs:comment "Reality capture is the process of digitising the physical world into accurate, measurable 3D representations using sensors such as LiDAR scanners, photogrammetric camera arrays, and depth cameras, producing point clouds, textured meshes, or digital twin models. It encompasses the full workflow from on-site data acquisition to processing, georeferencing, and delivery of survey-grade or visualisation-grade 3D assets. Reality capture is foundational to construction, heritage preservation, urban digital twins, and spatial computing content pipelines."@en ;
    rdfs:subClassOf ngm:etsi-domain-reality-capture ;
    vc:enables ngm:environmental-mapping,
        ngm:point-cloud-processing ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:3-d-scanning,
        ngm:geospatial-technology ;
    vc:slug "reality-capture" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:laser-scanner,
        ngm:lidar-scanning,
        ngm:multi-view-stereo,
        ngm:photogrammetry .

ngm:reasoning-trace a owl:Class ;
    rdfs:label "Reasoning Trace"@en ;
    rdfs:comment "A reasoning trace is the recorded sequence of intermediate thoughts, tool calls, and decisions a model produces while solving a task, distinct from its final output. It serves as both a working scratchpad that improves accuracy and an audit artefact for inspecting how an agent reached a conclusion. Traces underpin debugging, evaluation, and self-correction in agentic systems."@en ;
    rdfs:subClassOf ngm:ai-agent-system ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:agents,
        ngm:computer-use-and-browser-agents ;
    vc:slug "reasoning-trace" ;
    vc:sourceDomain "ai" .

ngm:reentrancy-attack a skos:Concept ;
    rdfs:label "Reentrancy Attack"@en .

ngm:reference-implementation a skos:Concept ;
    rdfs:label "Reference Implementation"@en .

ngm:reference-model a owl:Class ;
    rdfs:label "Reference Model"@en ;
    rdfs:comment "A reference model is an abstract, authoritative description of the desired behaviour or structure of a system, used as the standard against which an actual implementation is measured or controlled. In control theory it specifies the ideal closed-loop response that a model-reference adaptive controller drives the plant to follow. In evaluation it serves as the baseline whose outputs define the expected target."@en ;
    rdfs:subClassOf ngm:control-system ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:control-algorithm,
        ngm:evaluation-benchmarks-and-leaderboards ;
    vc:slug "reference-model" ;
    vc:sourceDomain "robotics" .

ngm:reference-signal a owl:Class ;
    rdfs:label "Reference Signal"@en ;
    rdfs:comment "A reference signal is the commanded target value, or setpoint trajectory, that a control system attempts to make its output follow over time. The controller computes the error between the reference and the measured output and acts to drive that error to zero. The shape and feasibility of the reference signal directly determine achievable tracking performance."@en ;
    rdfs:subClassOf ngm:control-theory ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:control-theory,
        ngm:feedback-loop ;
    vc:slug "reference-signal" ;
    vc:sourceDomain "robotics" .

ngm:reflection-loop a owl:Class ;
    rdfs:label "Reflection Loop"@en ;
    rdfs:comment "A reflection loop is an agentic control pattern in which a model critiques its own intermediate output, identifies errors or gaps, and revises before continuing or finalising. By iterating between generation and self-evaluation, the agent improves quality on tasks where a single pass is unreliable. It is a building block of self-correcting LLM agents and tool-using workflows."@en ;
    rdfs:subClassOf ngm:ai-agent-system ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:agents,
        ngm:computer-use-and-browser-agents ;
    vc:slug "reflection-loop" ;
    vc:sourceDomain "ai" .

ngm:regenerative-finance a owl:Class ;
    rdfs:label "Regenerative Finance"@en ;
    rdfs:comment "Regenerative finance (ReFi) is a movement that uses blockchain-based financial primitives to fund and incentivise ecological and social regeneration, such as carbon removal, biodiversity, and public goods. It tokenises natural assets and routes capital through mechanisms like retroactive funding and on-chain carbon markets. ReFi reframes DeFi tooling toward restoring rather than merely extracting value."@en ;
    rdfs:subClassOf ngm:bc-defi-and-economics ;
    skos:broader ngm:bc-defi-and-economics ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:green-blockchain-initiatives,
        ngm:sustainability ;
    vc:slug "regenerative-finance" ;
    vc:sourceDomain "blockchain" .

ngm:regulatory-authorisation a owl:Class ;
    rdfs:label "Regulatory Authorisation"@en ;
    rdfs:comment "Regulatory authorisation is the formal permission granted by a competent authority allowing an entity to conduct a regulated activity such as issuing tokens, operating a payment system, or holding client assets. It is obtained through an application demonstrating compliance with capital, governance, and conduct requirements. Without authorisation, issuance and operation of regulated financial instruments are unlawful in most jurisdictions."@en ;
    rdfs:subClassOf ngm:bc-governance-and-regulation ;
    skos:broader ngm:bc-governance-and-regulation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:cbdc-frameworks,
        ngm:enterprise-token-standards ;
    vc:slug "regulatory-authorisation" ;
    vc:sourceDomain "blockchain" .

ngm:regulatory-enforcement a skos:Concept ;
    rdfs:label "Regulatory Enforcement"@en .

ngm:regulatory-licence a owl:Class ;
    rdfs:label "Regulatory Licence"@en ;
    rdfs:comment "A regulatory licence is a specific, often named permission issued by a financial supervisor that authorises an entity to carry out a defined regulated activity such as issuing e-money or operating as a payment institution. It binds the holder to ongoing conditions including capital adequacy, reporting, and conduct rules. For stablecoin issuers, the appropriate licence determines whether the token may legally be offered to the public."@en ;
    rdfs:subClassOf ngm:financial-regulation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:stable-coins,
        ngm:stablecoin-regulation ;
    vc:slug "regulatory-licence" ;
    vc:sourceDomain "blockchain" .

ngm:regulatory-reporting-module a owl:Class ;
    rdfs:label "Regulatory Reporting Module"@en ;
    rdfs:comment "A regulatory reporting module is a self-contained software component that collects, formats, and dispatches the disclosures an entity owes to its regulators. It encapsulates jurisdiction-specific schemas, validation rules, and submission channels so they can be reused across systems. As a discrete subsystem it plugs into compliance-monitoring and tax-compliance pipelines to produce audit-ready outputs."@en ;
    rdfs:subClassOf ngm:regulatory-compliance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:compliance-monitoring,
        ngm:digital-tax-compliance-node ;
    vc:slug "regulatory-reporting-module" ;
    vc:sourceDomain "blockchain" .

ngm:rehabilitation-robotics a owl:Class ;
    rdfs:label "Rehabilitation Robotics"@en ;
    rdfs:comment "Rehabilitation robotics is the field of robotic devices that assist therapy and recovery of motor function, including exoskeletons, end-effector trainers, and assistive manipulators. These systems deliver repeatable, intensity-controlled movement while measuring patient progress, and rely on compliant, force-controlled actuation to interact safely with the body. They aim to improve outcomes and scale access to physical therapy."@en ;
    rdfs:subClassOf ngm:robo-robot-type ;
    skos:broader ngm:robo-robot-type ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:force-control,
        ngm:pneumatic-actuator ;
    vc:slug "rehabilitation-robotics" ;
    vc:sourceDomain "robotics" .

ngm:rejection-sampling a skos:Concept ;
    rdfs:label "Rejection Sampling"@en .

ngm:relationship-edge a owl:Class ;
    rdfs:label "Relationship Edge"@en ;
    rdfs:comment "A relationship edge is a directed or undirected connection in a graph that represents a typed association between two entity nodes, often carrying a label and properties. In knowledge and identity graphs, edges encode facts such as ownership, membership, or similarity that give the graph its semantic structure. Edge type and weight determine how the graph can be queried, traversed, and reasoned over."@en ;
    rdfs:subClassOf ngm:distributed-data-structure ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:identity-graph,
        ngm:knowledge-graph ;
    vc:slug "relationship-edge" ;
    vc:sourceDomain "data" .

