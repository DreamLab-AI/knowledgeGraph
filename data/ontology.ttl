ngm:trust-management a owl:Class ;
    rdfs:comment "Trust Management is the systematic process of establishing, evaluating, and maintaining trust relationships between autonomous agents, services, or identities within a distributed system. It encompasses credential issuance, reputation scoring, revocation, and policy enforcement that let participants decide whether to rely on another party's claims or actions. In multi-agent and decentralised-identity systems it underpins authorisation decisions without requiring a central authority."@en ;
    rdfs:label "Trust Management"@en ;
    rdfs:subClassOf ngm:trust-framework ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.55"^^xsd:float ;
    vc:slug "trust-management" ;
    vc:sourceDomain "security" .
ngm:trust-mark a skos:Concept ;
    rdfs:label "Trust Mark"@en .
ngm:trust-mechanism a owl:Class ;
    rdfs:comment "A trust mechanism is a system, protocol, or institution that allows parties who lack prior knowledge of one another to transact or cooperate with reasonable assurance of honest behaviour. Such mechanisms range from intermediaries and reputation systems to cryptographic and consensus protocols that replace interpersonal trust with verifiable, incentive-aligned guarantees."@en ;
    rdfs:label "Trust Mechanism"@en ;
    rdfs:subClassOf ngm:economic-mechanism ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:barter-system ;
    vc:relatedTo ngm:value-transfer ;
    vc:slug "trust-mechanism" ;
    vc:sourceDomain "blockchain" .
ngm:trust-metrics a skos:Concept ;
    rdfs:label "Trust Metrics"@en .
ngm:trust-minimisation a owl:Class ;
    rdfs:comment "Trust minimisation is a design principle for distributed and decentralised systems that aims to reduce the degree to which participants must rely on any single party's honesty or competence for the system to function correctly. It is typically achieved through cryptographic proofs that let one party verify a claim without trusting the claimant, and through decentralised architectures that remove single points of control. It is a foundational goal of blockchain and decentralised web design."@en ;
    rdfs:label "Trust Minimisation"@en ;
    rdfs:subClassOf ngm:decentralisation ;
    rdfs:subClassOf _:r21365 ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires ngm:cryptographic-proofs ;
    vc:slug "trust-minimisation" ;
    vc:sourceDomain "distributed-systems" .
ngm:trust-minimized-transfer a skos:Concept ;
    rdfs:label "Trust Minimized Transfer"@en .
ngm:trust-model a owl:Class ;
    rdfs:comment "A trust model is a formal description of which entities are trusted, for what, and on what basis within a security or identity system. It defines the roots of trust, the relationships through which trust is delegated or transitively established, and the assumptions an adversary cannot violate. Trust models range from centralised certificate hierarchies to decentralised webs of trust and zero-trust architectures, and they directly shape how authentication and authorisation are designed."@en ;
    rdfs:label "Trust Model"@en ;
    rdfs:subClassOf ngm:security ;
    rdfs:subClassOf _:r21366 ;
    rdfs:subClassOf _:r21367 ;
    rdfs:subClassOf _:r21368 ;
