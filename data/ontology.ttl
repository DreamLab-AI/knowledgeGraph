ngm:user-protection a owl:Class ;
    rdfs:label "User Protection"@en ;
    rdfs:comment "User Protection encompasses the legal frameworks, platform policies, and technical mechanisms designed to safeguard individuals from harm when using digital services and online platforms. It spans data protection rights, content moderation obligations, anti-manipulation requirements, and consumer protection rules applicable to platform operators. Regulation such as the UK Online Safety Act and the EU Digital Services Act impose positive duties on platforms to assess and mitigate risks to users, particularly minors and vulnerable populations. Technical controls include content filtering, safety settings, transparency mechanisms, and redress systems that give users agency over their online experience."@en ;
    rdfs:subClassOf ngm:consumer-protection ;
    vc:enables ngm:gdpr-compliance,
        ngm:user-safety ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:content-moderation-standards,
        ngm:data-protection,
        ngm:digital-well-being-index,
        ngm:online-safety-act-2023,
        ngm:uk-online-safety-act ;
    vc:slug "user-protection" ;
    vc:sourceDomain "governance" ;
    vc:uses ngm:consent-management,
        ngm:content-moderation,
        ngm:digital-rights .

ngm:validation-tools a owl:Class ;
    rdfs:label "Validation Tools"@en ;
    rdfs:comment "Validation tools are software utilities that verify whether data, documents or implementations conform to a defined specification, schema or interoperability profile. They automate conformance checking, report violations, and support certification and compatibility testing across standards-based ecosystems. By catching errors early they reduce integration risk and ensure data and formats interoperate as intended."@en ;
    rdfs:subClassOf ngm:software-development ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:compatibility-process,
        ngm:data-format-standard ;
    vc:slug "validation-tools" ;
    vc:sourceDomain "infrastructure" .

ngm:validity-proof a owl:Class ;
    rdfs:label "Validity Proof"@en ;
    rdfs:comment "A validity proof is a cryptographic proof, typically a succinct zero-knowledge proof, that attests that a batch of state transitions was computed correctly according to the rules of a system. In layer-2 rollups it allows a base chain to accept a compressed state update after verifying a single proof, without re-executing the underlying transactions. Validity proofs give immediate, trustless finality in contrast to optimistic schemes that rely on fraud challenges."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:zk-snark ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:zk-starks ],
        ngm:cryptographic-proof-system ;
    vc:bridgesTo ngm:zk-rollup ;
    vc:contrastsWith ngm:fraud-proof ;
    vc:enables ngm:scalability,
        ngm:zk-rollup ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:zk-snark,
        ngm:zk-starks ;
    vc:implements ngm:zero-knowledge-proof ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:blockchain,
        ngm:zk-sync ;
    vc:slug "validity-proof" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:layer-2-scaling ;
    vc:uses ngm:zero-knowledge-proof .

ngm:verra-vcs-standard a owl:Class ;
    rdfs:label "Verra VCS Standard"@en ;
    rdfs:comment "The Verra Verified Carbon Standard is a widely used programme for certifying voluntary carbon credits, setting rules for quantifying, verifying and issuing emission reductions and removals."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:carbon-markets ],
