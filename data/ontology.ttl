ngm:arbitration-decision-engine a owl:Class ;
    rdfs:label "Arbitration Decision Engine"@en ;
    rdfs:comment "Arbitration Decision Engine is an AI-powered or smart contract-based automated system that evaluates evidence, applies predetermined rules, and renders decisions in dispute resolution processes, functioning as an oracle that can trigger smart contract modifications and enable self-enforcing arbit..."@en ;
