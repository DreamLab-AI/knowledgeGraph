            owl:someValuesFrom ngm:identity-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:metadata-schema ],
        ngm:infra-data-management ;
    skos:broader ngm:infra-data-management ;
    vc:bridgesTo ngm:artificial-intelligence,
        ngm:data-governance,
        ngm:knowledge-graph ;
    vc:contrastsWith ngm:data-dictionary,
