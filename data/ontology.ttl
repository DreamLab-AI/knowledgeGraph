# WebAssembly
infrastructure:WebAssembly rdf:type owl:Class ;
    rdfs:subClassOf infrastructure:BinaryInstructionFormat ;
    rdfs:subClassOf infrastructure:PortableExecutionEnvironment ;
    rdfs:label "WebAssembly"@en ;
    rdfs:comment "WebAssembly (Wasm) is a binary instruction format for a stack-based virtual machine, standardised by the W3C, that provides a portable compilation target for high-level languages such as C, C++, Rust, and Go, enabling near-native execution speed inside Web Browser sandboxes and server-side runtimes such as WASI (WebAssembly System Interface). It is the primary runtime substrate for VisionClaw Agentic Container agent modules, allowing deterministic, sandboxed, language-agnostic execution of untrusted code across heterogeneous deployment environments including edge nodes, browsers, and embedded hardware."@en ;
    skos:prefLabel "WebAssembly"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:infrastructure:webassembly" ;
    owl:sameAs <urn:visionclaw:concept:infrastructure:webassembly> ;
    vcw:contentHash "sha256-12-3f7a1c8d2e94" ;
    vcw:qualityScore "0.7"^^xsd:decimal ;
    vcw:legacyTermId "NGM-webassembly" ;
    vcw:ontologyStatus "complete" ;
    vcw:maturityLevel "established" ;
    vcw:authorityScore "0.82"^^xsd:decimal ;
    dcterms:identifier "NGM-webassembly" ;
    dcterms:subject "infrastructure" ;
    owl:versionInfo "1.0.0" ;
    dcterms:created "2026-04-26T00:00:00Z"^^xsd:dateTime ;
    dcterms:modified "2026-04-26T00:00:00Z"^^xsd:dateTime ;
    vcw:owlRole "Process" .

