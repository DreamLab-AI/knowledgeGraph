ngm:interaction-domain a owl:Class ;
    rdfs:label "Interaction Domain"@en ;
    rdfs:comment "The Interaction Domain is the ontological framework that structures all human-computer interaction (HCI) phenomena, covering interactive systems, user interfaces, input modalities, and the cognitive and physical processes by which users engage with digital environments. It provides formal representation of user-experience elements, adaptive interface patterns, and multi-modal interaction channels including voice, gesture, haptics, and natural language. As spatial computing matures, the domain expands to encompass embodied interaction within augmented and virtual spaces."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:haptic-feedback ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:human-computer-interaction ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:user-experience ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:voice-interaction ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:accessibility ],
        ngm:sc-interaction ;
    skos:broader ngm:sc-interaction ;
    vc:enables ngm:immersive-experience,
        ngm:immersive-interface ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:accessibility,
        ngm:haptic-feedback,
        ngm:human-computer-interaction,
        ngm:user-experience,
        ngm:voice-interaction ;
    vc:isPartOf ngm:spatial-computing ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:augmented-reality,
        ngm:metaverse-domain,
        ngm:natural-language-processing ;
    vc:slug "interaction-domain" ;
    vc:sourceDomain "spatial-computing" .

ngm:interaction-manager a owl:Class ;
    rdfs:label "Interaction Manager"@en ;
    rdfs:comment "An interaction manager is the software component that coordinates the flow of communication between a user and an intelligent virtual entity, governing turn-taking, context tracking, and the selection of responses or behaviours. It mediates between perception, dialogue state, and action so that an agent's experience layer feels coherent and responsive. It is the control hub that converts understood input into appropriately timed and styled output."@en ;
    rdfs:subClassOf ngm:sc-interaction ;
    skos:broader ngm:sc-interaction ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:experience-layer,
        ngm:intelligent-virtual-entity ;
    vc:slug "interaction-manager" ;
    vc:sourceDomain "metaverse" .

ngm:interactive-storytelling a owl:Class ;
    rdfs:label "Interactive Storytelling"@en ;
    rdfs:comment "Interactive Storytelling is a narrative form in which user choices, actions, or presence dynamically shape the progression, branching structure, or emotional arc of a story. In spatial computing contexts, it encompasses XR experiences, virtual worlds, and location-based entertainment where embodied interaction and spatial presence deepen narrative immersion beyond passive media consumption."@en ;
    rdfs:subClassOf ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:enables ngm:immersive-experience,
        ngm:virtual-world ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:relatedTo ngm:avatar,
        ngm:generative-ai,
        ngm:social-vr ;
    vc:slug "interactive-storytelling" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:dialogue-system,
        ngm:game-engine .

ngm:inverted-index a owl:Class ;
    rdfs:label "Inverted Index"@en ;
    rdfs:comment "An inverted index is a data structure that maps each term to the list of documents (and often positions) in which it appears, enabling fast full-text retrieval over large corpora. It inverts the natural document-to-terms relationship so that a query term immediately yields its posting list, which can then be intersected or scored. It is the foundational index behind search engines and lexical information retrieval."@en ;
    rdfs:subClassOf ngm:information-retrieval ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:information-retrieval-domain,
        ngm:semantic-search ;
    vc:slug "inverted-index" ;
    vc:sourceDomain "data" .

ngm:iso-20022 a owl:Class ;
    rdfs:label "ISO 20022"@en ;
    rdfs:comment "ISO 20022 is the international standard for financial messaging that provides a common platform for the development of messages in the financial services industry, using a methodology that decouples business concepts from syntax through a central repository of business components, message definitions, and XML/ASN.1/JSON encoding rules. Published by the International Organisation for Standardisation, the standard covers payments (credit transfers, direct debits), securities (settlement, clearing), trade finance, and foreign exchange, replacing legacy formats such as SWIFT MT and CHIPS. Its rich data model carries structured remittance information, legal entity identifiers, and purpose codes that older formats cannot accommodate, enabling straight-through processing, improved fraud detection, and regulatory reporting automation. Major financial market infrastructures worldwide — TARGET2, CHAPS, the US Fedwire and CHIPS — are migrating to ISO 20022 between 2023 and 2025."@en ;
    rdfs:subClassOf ngm:interoperability-standard ;
    vc:enables ngm:central-bank-digital-currency,
        ngm:cross-border-payments,
        ngm:regulatory-reporting ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:data-standards,
        ngm:financial-system,
        ngm:payment-system ;
    vc:slug "iso-20022" ;
    vc:sourceDomain "finance" ;
    vc:standardizedBy ngm:iso ;
    vc:supports ngm:digital-payment-system,
        ngm:financial-infrastructure .

ngm:iso-27001 a owl:Class ;
    rdfs:label "ISO 27001"@en ;
    rdfs:comment "ISO/IEC 27001 is the internationally recognised standard specifying requirements for establishing, implementing, maintaining, and continually improving an Information Security Management System (ISMS). Published jointly by the International Organisation for Standardisation (ISO) and the International Electrotechnical Commission (IEC), the standard takes a risk-based approach to information security governance, requiring organisations to systematically identify information assets, assess threats and vulnerabilities, select appropriate controls from the accompanying Annex A catalogue, and demonstrate conformance through a formal audit and certification process."@en ;
    rdfs:subClassOf ngm:cybersecurity-standard ;
    vc:enables ngm:compliance-audit-trail,
        ngm:data-security,
        ngm:privacy-by-design ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:gdpr-compliance,
        ngm:iso-iec-27001,
        ngm:iso-iec-42001 ;
    vc:slug "iso-27001" ;
    vc:sourceDomain "security" ;
    vc:uses ngm:compliance-framework,
        ngm:information-security,
        ngm:risk-management .

ngm:iso-9283 a owl:Class ;
    rdfs:label "ISO 9283"@en ;
    rdfs:comment "ISO 9283 is an international standard that defines performance criteria and test methods for manipulating industrial robots, specifying how to measure and report pose accuracy, pose repeatability, path accuracy, and path velocity characteristics under controlled conditions. The standard provides a common vocabulary and methodology enabling manufacturers, integrators, and end users to make meaningful, reproducible comparisons of robot performance across different systems and vendors. It covers both Cartesian-space and joint-space metrics and prescribes the environmental and loading conditions under which measurements are to be taken. ISO 9283 is maintained by ISO/TC 299 and is complemented by related standards covering safety, collaborative operation, and application-specific performance."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:manipulator ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:benchmarks ],
        ngm:robot-standard ;
    vc:enables ngm:rb-0034-repeatability,
        ngm:rb-0035-accuracy ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:industrial-robot,
        ngm:iso-10218,
        ngm:iso-ts-15066,
        ngm:performance-benchmarks ;
    vc:requires ngm:benchmarks,
        ngm:manipulator ;
    vc:slug "iso-9283" ;
    vc:sourceDomain "robotics" ;
    vc:standardizedBy ngm:iso .

ngm:iso-iec-jtc-1-sc-42 a owl:Class ;
    rdfs:label "ISO/IEC JTC 1/SC 42"@en ;
    rdfs:comment "ISO/IEC JTC 1/SC 42 (Artificial Intelligence) is the international standardisation subcommittee within the ISO/IEC Joint Technical Committee 1 responsible for developing and maintaining global standards for artificial intelligence. Established in 2017, it coordinates with national bodies across more than 40 participating countries to produce standards covering AI terminology, foundational concepts, trustworthiness, bias, risk management, data lifecycle, governance frameworks, and AI system evaluation. Its publications inform regulatory frameworks worldwide, including the EU AI Act, and provide the shared vocabulary necessary for interoperability of AI governance instruments across jurisdictions."@en ;
    rdfs:subClassOf ngm:ai-regulation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:ai-governance,
        ngm:ai-governance-framework,
        ngm:eu-ai-act,
        ngm:nist-ai-rmf ;
    vc:slug "iso-iec-jtc-1-sc-42" ;
    vc:sourceDomain "governance" ;
    vc:standardizedBy ngm:ai-accountability,
        ngm:ai-trustworthiness ;
    vc:supports ngm:ai-ethics,
        ngm:ai-fairness,
        ngm:responsible-ai .

ngm:it-calculus a owl:Class ;
    rdfs:label "Itô Calculus"@en ;
    rdfs:comment "Itô calculus is a branch of mathematical analysis that extends the methods of calculus to stochastic processes such as Brownian motion. Its central result, Itô's lemma, provides the chain rule for functions of stochastic integrals, accounting for the non-zero quadratic variation of random paths. It is the foundational toolkit for stochastic differential equations and continuous-time probabilistic modelling."@en ;
    rdfs:subClassOf ngm:machine-learning-technique ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:stochastic-differential-equation,
        ngm:stochastic-process ;
    vc:slug "it-calculus" ;
    vc:sourceDomain "ai" .

ngm:jailbreaking a owl:Class ;
    rdfs:label "Jailbreaking"@en ;
    rdfs:comment "Jailbreaking of large language models (LLMs) is the practice of crafting inputs—prompts, instruction sequences, encoded payloads, or multi-turn conversational strategies—that cause a model to produce outputs that circumvent its safety training, content policies, or alignment objectives."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
