            owl:someValuesFrom ngm:relayer ],
        ngm:cross-chain-bridge ;
    vc:bridgesTo ngm:distributed-collaboration,
        ngm:distributed-systems ;
    vc:contrastsWith ngm:layer-2-scaling,
        ngm:sidechain ;
    vc:enables ngm:atomic-swap,
        ngm:blockchain-interoperability,
        ngm:decentralized-finance,
        ngm:multi-chain-application ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:light-client-verification,
        ngm:merkle-proof,
        ngm:relayer ;
    vc:implements ngm:cosmos-ibc,
        ngm:polkadot-xcm ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:blockchain-interoperability,
        ngm:cosmos-ibc,
        ngm:message-passing,
        ngm:token-bridge,
        ngm:wrapped-token ;
