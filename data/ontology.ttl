ngm:paxos a owl:Class ;
    rdfs:label "Paxos"@en ;
    rdfs:comment "Paxos is a family of fault-tolerant distributed consensus algorithms first formally described by Leslie Lamport in 1989 and published in 1998, designed to allow a cluster of processes to agree on a single value or sequence of values despite the failure of a minority of participants. The algorithm proceeds through prepare and accept phases orchestrated by a proposer, with acceptors voting to commit proposed values and learners observing the final agreement. Multi-Paxos extends the basic protocol to achieve consensus on a log of commands efficiently, forming the algorithmic foundation of replicated state machines. Paxos and its derivatives, including Raft and HotStuff, underpin virtually every strongly consistent distributed database and coordination service in production use today."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:message-passing ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:quorum ],
        ngm:consensus-algorithm ;
    vc:bridgesTo ngm:blockchain-consensus ;
    vc:contrastsWith ngm:byzantine-fault-tolerance,
        ngm:hot-stuff-consensus,
        ngm:nakamoto-consensus,
        ngm:raft-consensus ;
    vc:dependsOn ngm:crash-fault-tolerance,
        ngm:network-partition ;
    vc:enables ngm:consensus-protocol,
        ngm:distributed-computing,
        ngm:distributed-ledger,
        ngm:fault-tolerance-system,
        ngm:state-machine-replication ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:consensus-mechanism,
        ngm:leader-election,
        ngm:state-machine-replication,
        ngm:two-phase-commit ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:cap-theorem,
        ngm:distributed-protocol,
        ngm:total-order-broadcast,
        ngm:zookeeper ;
    vc:requires ngm:majority-voting,
        ngm:message-passing,
        ngm:quorum ;
    vc:slug "paxos" ;
    vc:sourceDomain "distributed-systems" .

ngm:performance-optimization a owl:Class ;
    rdfs:label "Performance Optimization"@en ;
    rdfs:comment "Performance optimization is the systematic process of enhancing the efficiency, speed, and effectiveness of software systems by tuning code, algorithms, and resource utilization to minimize response time and maximize throughput. It encompasses profiling to identify bottlenecks, algorithmic improvements, caching strategies, parallel processing, and compiler optimizations to meet defined performance targets."@en ;
