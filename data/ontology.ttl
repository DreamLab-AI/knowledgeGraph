        ngm:supervised-learning ;
    vc:slug "instruction-tuning" ;
    vc:sourceDomain "machine-learning" ;
    vc:uses ngm:chain-of-thought-prompting,
        ngm:parameter-efficient-fine-tuning .

ngm:internet-protocol a owl:Class ;
    rdfs:label "Internet Protocol"@en ;
    rdfs:comment "The Internet Protocol (IP) is the principal network-layer protocol of the Internet protocol suite, responsible for addressing hosts and routing packets of data from a source to a destination across interconnected networks. It defines a best-effort, connectionless delivery service in which each datagram is forwarded independently using hierarchical addresses. IP provides the universal addressing and packet format on which higher-layer transport and application protocols depend."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:dns ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:routing-protocol ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:ipv6 ],
        ngm:infrastructure ;
    skos:broader ngm:infrastructure ;
    vc:dependsOn ngm:packet-switching ;
    vc:enables ngm:tcp,
        ngm:tcp-ip,
        ngm:udp ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:dns,
        ngm:ipv6 ;
    vc:implements ngm:network-layer,
        ngm:packet-switching ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:communication-protocol,
        ngm:network-protocol ;
    vc:requires ngm:routing-protocol ;
    vc:slug "internet-protocol" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:networking,
        ngm:transport-layer ;
    vc:uses ngm:osi-model .

ngm:neural-radiance-field a owl:Class ;
    rdfs:label "Neural Radiance Field"@en ;
    rdfs:comment "A continuous volumetric scene representation that uses a multilayer perceptron to map 5D coordinates (3D position plus 2D viewing direction) to colour and volume density, enabling novel view synthesis via differentiable ray marching. NeRF achieves photo-realistic rendering of complex scenes from a sparse set of calibrated images and has spawned instant variants, Gaussian Splatting successors, and robotics perception applications."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:differentiable-rendering ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:structure-from-motion ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:camera-calibration ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:positional-encoding ],
        ngm:ai-model-architecture ;
    skos:broader ngm:ai-model-architecture ;
    vc:bridgesTo ngm:digital-twin,
        ngm:spatial-computing ;
    vc:contrastsWith ngm:3-d-gaussian-splatting,
        ngm:gaussian-splatting,
        ngm:point-cloud ;
    vc:dependsOn ngm:implicit-neural-representation,
        ngm:neural-network ;
    vc:enables ngm:3-d-scene-reconstruction,
        ngm:autonomous-robot,
        ngm:novel-view-synthesis,
        ngm:virtual-reality ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:multilayer-perceptron,
        ngm:positional-encoding ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:computer-vision,
        ngm:depth-estimation,
        ngm:tele-060-instant-ngp ;
    vc:requires ngm:camera-calibration,
        ngm:differentiable-rendering,
        ngm:structure-from-motion ;
    vc:slug "neural-radiance-field" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:gradient-descent,
        ngm:ray-marching,
        ngm:volume-rendering .

ngm:obstacle-avoidance a owl:Class ;
    rdfs:label "Obstacle Avoidance"@en ;
    rdfs:comment "The capability of a mobile robot or autonomous system to detect and avoid collisions with obstacles in its environment in real-time using sensors and reactive control strategies. It enables safe navigation without requiring complete prior knowledge of the environment."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:real-time-processing ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:proximity-sensor ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:sensor-fusion ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:localization ],
        ngm:reactive-control ;
    vc:bridgesTo ngm:computer-vision,
        ngm:reinforcement-learning ;
    vc:contrastsWith ngm:planning ;
    vc:dependsOn ngm:path-planning,
        ngm:trajectory-generation ;
    vc:enables ngm:autonomous-vehicle,
        ngm:navigation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:autonomous-navigation,
        ngm:mobile-robotics ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:cobot-safety-levels,
        ngm:mobile-robot ;
    vc:requires ngm:localization,
        ngm:proximity-sensor,
        ngm:real-time-processing,
        ngm:sensor-fusion ;
    vc:slug "obstacle-avoidance" ;
