    vcw:owlRole "Concept" .

# INDEX
spatial-computing:INDEX rdf:type owl:Class ;
    rdfs:label "INDEX"@en ;
    rdfs:comment "A structured reference document providing searchable, hierarchically organised access to concepts, terminology, and resources within a knowledge graph or ontology system. Indices enable rapid discovery, cross-referencing, and navigation of complex semantic relationships and concept relationships."@en ;
