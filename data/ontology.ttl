ngm:gpu-resources a owl:Class ;
    rdfs:label "GPU Resources"@en ;
    rdfs:comment "GPU resources refer to the pool of graphics processing unit capacity — including VRAM, streaming multiprocessors, tensor cores, and associated interconnect bandwidth — that is provisioned, allocated, and managed as a computational resource for parallel workloads such as AI model training and inference, scientific simulation, computer graphics rendering, and high-performance computing. In cloud and data centre contexts, GPU resources are typically accessed through virtualisation or direct hardware passthrough, managed by schedulers that partition capacity across competing workloads and billed on per-hour or per-token consumption models."@en ;
    rdfs:subClassOf ngm:compute-resources ;
    vc:enables ngm:computer-graphics,
        ngm:gpu-computing,
        ngm:large-scale-compute ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:compute-infrastructure,
        ngm:edge-ai-accelerator,
        ngm:gpu-compute,
        ngm:inference-hardware ;
    vc:slug "gpu-resources" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:compute-shader,
        ngm:cuda,
        ngm:hardware-acceleration .

ngm:graph-search a owl:Class ;
    rdfs:label "Graph Search"@en ;
    rdfs:comment "Graph search encompasses algorithms that systematically traverse graph-structured state spaces — sets of nodes (states) connected by edges (transitions) — to discover paths, optimal solutions, or reachable configurations satisfying given criteria. Classical uninformed methods (Breadth-First Search, Depth-First Search, Dijkstra) provide completeness and optimality guarantees on finite discrete graphs; informed heuristic methods (A*, IDA*, weighted A*) accelerate search using problem-specific cost estimates; sampling-based planners (RRT, PRM, RRT*) extend graph search to high-dimensional continuous configuration spaces by building implicit graphs from random samples. Graph search is the algorithmic backbone of robot motion planning, AI planning, knowledge graph querying, route navigation, and game-tree evaluation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:dijkstra-algorithm ],
        ngm:graph-algorithms ;
    vc:bridgesTo ngm:graph-neural-network,
        ngm:spatial-indexing ;
    vc:contrastsWith ngm:evolutionary-algorithm,
        ngm:reinforcement-learning ;
    vc:dependsOn ngm:data-structures,
        ngm:knowledge-representation ;
    vc:enables ngm:game-tree-search,
        ngm:motion-planning,
        ngm:navigation,
        ngm:route-planning ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:a-star-search,
        ngm:breadth-first-search,
        ngm:depth-first-search,
        ngm:dijkstra-algorithm ;
    vc:isPartOf ngm:combinatorial-optimisation,
        ngm:graph-algorithms ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:monte-carlo-tree-search,
        ngm:satisfiability ;
    vc:requires ngm:graph-data-structure,
        ngm:heuristic-function ;
    vc:slug "graph-search" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:automated-planning,
        ngm:constraint-satisfaction,
        ngm:knowledge-graph ;
    vc:uses ngm:dynamic-programming,
        ngm:heuristic-function,
        ngm:priority-queue .

ngm:haptic-feedback-telepresence a owl:Class ;
    rdfs:label "Haptic Feedback Telepresence"@en ;
    rdfs:comment "Haptic Feedback Telepresence is the integration of tactile and kinesthetic feedback devices — such as force-feedback gloves, exoskeletons, and haptic controllers — into telepresence systems, enabling bidirectional touch sensation between a remote operator and a distant physical or virtual environment. It closes the sensorimotor loop beyond visual and auditory channels, allowing operators to feel forces, textures, weight, and vibration, which significantly enhances manipulation precision and immersive presence in teleoperation, surgical robotics, and VR collaboration contexts."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:teleoperation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:guaranteed-bandwidth ],
        ngm:dc-telepresence ;
    skos:broader ngm:dc-telepresence ;
    vc:bridgesTo ngm:haptic-feedback ;
    vc:enables ngm:immersive-communication,
        ngm:robotic-telepresence ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:telecollaboration-and-telepresence,
        ngm:telepresence ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:human-computer-interaction,
        ngm:tele-001-telepresence,
        ngm:virtual-environment ;
    vc:requires ngm:guaranteed-bandwidth,
        ngm:teleoperation ;
    vc:slug "haptic-feedback-telepresence" ;
    vc:sourceDomain "distributed-collaboration" ;
    vc:uses ngm:exoskeleton-robot,
        ngm:haptics,
        ngm:sensor-fusion,
        ngm:tactile-sensor .

ngm:hardware-wallet a owl:Class ;
    rdfs:label "Hardware Wallet"@en ;
    rdfs:comment "A hardware wallet is a dedicated physical device that stores cryptocurrency private keys in a secure element and signs transactions internally, so the keys never leave the device or touch an internet-connected computer. It protects against malware and remote key theft by isolating signing operations behind on-device confirmation. Hardware wallets are a foundational tool for self-custody of digital assets."@en ;
    rdfs:subClassOf ngm:infra-security-and-identity ;
    skos:broader ngm:infra-security-and-identity ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:multi-sig-governance ;
    vc:slug "hardware-wallet" ;
    vc:sourceDomain "blockchain" .

ngm:healthcare-analytics a owl:Class ;
    rdfs:label "Healthcare Analytics"@en ;
    rdfs:comment "The application of artificial intelligence and data science to healthcare data for population health management, operational efficiency optimisation, clinical outcome prediction, resource allocation, and healthcare policy decision-making. Healthcare analytics systems analyse electronic health records, claims data, public health datasets, and operational metrics to derive actionable insights for clinical and administrative improvement."@en ;
    rdfs:subClassOf ngm:ai-application,
        ngm:machine-learning-discipline ;
    skos:broader ngm:ai-application ;
    vc:enables ngm:healthcare-technology,
