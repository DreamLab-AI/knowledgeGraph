ngm:continuous-training a owl:Class ;
    rdfs:comment "Continuous training is an MLOps practice in which machine-learning models are automatically retrained on fresh data on a recurring or event-driven basis to maintain predictive accuracy over time. It extends continuous integration and delivery to the model lifecycle, triggering retraining when new data arrives or when monitoring detects data or model drift. The retrained model is validated and promoted through automated pipelines before deployment."@en ;
    rdfs:label "Continuous Training"@en ;
