ngm:blockchain-security a owl:Class ;
    rdfs:label "Blockchain Security"@en ;
    rdfs:comment "Blockchain security is the multidisciplinary field concerned with protecting distributed ledger systems against attacks on their consensus mechanisms, smart contract logic, cryptographic primitives, and network topology, while preserving the properties of immutability, censorship resistance, and trustless operation. It encompasses threat modelling, formal verification of on-chain code, cryptographic auditing, and economic game-theory analysis to prevent incentive manipulation. The discipline extends across permissionless and permissioned blockchain architectures, addressing layer-specific attack surfaces from peer-to-peer networking through execution environments to cross-chain interoperability bridges."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptographic-protocol ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:formal-verification ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:consensus-mechanism ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:cryptographic-key-management ],
        ngm:cybersecurity ;
    vc:bridgesTo ngm:ai-security,
        ngm:post-quantum-cryptography ;
    vc:contrastsWith ngm:51-attack,
        ngm:double-spending,
        ngm:reentrancy-attack,
        ngm:sybil-attack ;
    vc:enables ngm:decentralised-finance,
        ngm:immutability,
        ngm:trustless-system ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:consensus-security,
        ngm:cryptographic-key-management,
        ngm:smart-contract-audit ;
    vc:isPartOf ngm:cybersecurity,
        ngm:distributed-systems-security ;
    vc:qualityScore "0.76"^^xsd:float ;
    vc:relatedTo ngm:blockchain,
        ngm:cryptographic-security,
        ngm:miner-extractable-value,
        ngm:smart-contract ;
    vc:requires ngm:consensus-mechanism,
        ngm:cryptographic-protocol,
        ngm:formal-verification ;
    vc:slug "blockchain-security" ;
    vc:sourceDomain "blockchain" ;
    vc:standardizedBy ngm:nist-cybersecurity-framework ;
    vc:uses ngm:multi-signature-scheme,
        ngm:oracle-network,
        ngm:zero-knowledge-proof .

ngm:carbon-markets a owl:Class ;
    rdfs:label "Carbon Markets"@en ;
    rdfs:comment "Carbon markets are regulated or voluntary trading systems in which carbon credits or allowances — each representing one metric tonne of CO₂ equivalent avoided, reduced, or removed — are issued, bought, sold, and retired to place a price on greenhouse gas emissions and channel investment towards least-cost mitigation activities. Compliance markets operate under mandatory emissions-trading schemes (ETS) such as the EU ETS, California Cap-and-Trade, and the Article 6 mechanisms of the Paris Agreement, where regulated emitters must surrender allowances matching verified output. Voluntary carbon markets (VCMs) allow organisations and individuals outside regulatory caps to purchase independently verified credits from projects ranging from avoided deforestation to direct air capture, enabling net-zero and carbon-neutrality claims. Market integrity depends on robust project standards, third-party verification, transparent registry infrastructure, and governance frameworks to prevent double counting and ensure additionality."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:voluntary-carbon-market ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:carbon-accounting ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:carbon-price-discovery ],
        ngm:environmental-asset-market ;
    vc:bridgesTo ngm:carbon-credit-token,
        ngm:distributed-ledger-technology,
        ngm:iot-environmental-monitoring ;
    vc:enables ngm:carbon-neutrality,
        ngm:carbon-offset-trading,
        ngm:emissions-reduction,
        ngm:net-zero-targets ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:carbon-price-discovery,
        ngm:compliance-carbon-market,
        ngm:voluntary-carbon-market ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:carbon-tax,
        ngm:climate-finance,
        ngm:emissions-trading-scheme,
        ngm:paris-agreement ;
    vc:requires ngm:additionality-assessment,
        ngm:carbon-accounting,
        ngm:third-party-verification ;
    vc:slug "carbon-markets" ;
    vc:sourceDomain "finance" ;
    vc:standardizedBy ngm:core-carbon-principles,
        ngm:gold-standard,
        ngm:verified-carbon-standard ;
    vc:uses ngm:carbon-credits,
        ngm:carbon-offset,
        ngm:carbon-registry,
        ngm:emissions-allowance .

