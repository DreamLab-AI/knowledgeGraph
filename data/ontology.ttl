    vc:hasPart ngm:rb-0068-vision-system ;
    vc:hasPart ngm:rb-0069-lidar ;
    vc:hasPart ngm:rb-0072-encoder ;
    vc:hasPart ngm:rb-0073-imu ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:sensor-fusion ;
    vc:slug "rb-0066-robot-sensor" ;
    vc:sourceDomain "robotics" .
ngm:rb-0067-force-torque-sensor a owl:Class ;
    rdfs:comment "A force-torque sensor (FT sensor) is a transducer mounted at a robot's wrist or tool centre point that simultaneously measures all six components of mechanical load: three orthogonal forces (Fx, Fy, Fz) and three orthogonal torques (Tx, Ty, Tz). These measurements enable the robot controller to monitor contact forces in real time, supporting force-controlled assembly, surface-following tasks, human-robot contact detection, and safety-critical power-and-force limiting under ISO/TS 15066. FT sensors are the primary feedback device for impedance and admittance control strategies."@en ;
    rdfs:label "rb 0067 force torque sensor"@en ;
    rdfs:subClassOf ngm:robo-perception ;
    skos:broader ngm:robo-perception ;
    vc:bridgesTo ngm:force-torque-sensor ;
    vc:enables ngm:rb-0053-force-control ;
    vc:enables ngm:rb-0056-impedance-control ;
    vc:enables ngm:rb-0057-admittance-control ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:haptic-feedback ;
    vc:relatedTo ngm:rb-0070-tactile-sensing ;
    vc:relatedTo ngm:rb-0094-power-and-force-limiting ;
    vc:slug "rb-0067-force-torque-sensor" ;
    vc:sourceDomain "robotics" ;
    vc:supports ngm:cobot-safety-levels ;
    vc:supports ngm:rb-0066-robot-sensor .
ngm:rb-0068-vision-system a owl:Class ;
    rdfs:comment "A robotic vision system is an integrated sensor subsystem that captures and processes visual data—using cameras, depth sensors, or LiDAR—to provide a robot with spatial awareness, object recognition, and scene understanding capabilities. Vision systems underpin tasks including visual servoing, part inspection, SLAM-based localisation, and human-robot interaction, and conform to ISO 8373:2021 perception-system definitions."@en ;
    rdfs:label "rb 0068 vision system"@en ;
    rdfs:subClassOf ngm:robo-perception ;
    rdfs:subClassOf _:r22966 ;
    rdfs:subClassOf _:r22967 ;
    skos:broader ngm:robo-perception ;
    vc:enables ngm:human-robot-interaction ;
    vc:enables ngm:rb-0065-visual-servoing ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:rb-0066-robot-sensor ;
    vc:hasPart ngm:rb-0077-depth-camera ;
    vc:qualityScore "0.7"^^xsd:float ;
