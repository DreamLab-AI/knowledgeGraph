    vc:slug "storytelling-structure" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:character-model,
        ngm:game-mechanics .

ngm:stranded-energy a owl:Class ;
    rdfs:label "Stranded Energy"@en ;
    rdfs:comment "Stranded energy is generated power that cannot be economically transmitted to demand centres because it is produced in remote locations, lacks grid connection, or is curtailed when supply exceeds local demand. Examples include flared associated gas at oil wells, over-built hydro and wind capacity, and geothermal sites far from population. Because it would otherwise be wasted, stranded energy can be monetised by co-locating energy-intensive computation such as Bitcoin mining at the source."@en ;
    rdfs:subClassOf ngm:sustainability ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:bitcoin-environmental-issues,
        ngm:stranded-energy-monetisation ;
    vc:slug "stranded-energy" ;
    vc:sourceDomain "blockchain" .

ngm:strategic-bitcoin-reserve a owl:Class ;
    rdfs:label "Strategic Bitcoin Reserve"@en ;
    rdfs:comment "A strategic Bitcoin reserve is a holding of bitcoin maintained by a state, corporation, or institution as a long-term store of value and hedge against fiat debasement, analogous to gold or foreign-currency reserves. Proponents argue that bitcoin's fixed supply and censorship resistance make it a credible reserve asset, while critics cite volatility and custody risk. The concept gained prominence as governments and large treasuries began formal accumulation programmes."@en ;
    rdfs:subClassOf ngm:digital-asset ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:bitcoin-distribution,
        ngm:bitcoin-value-proposition ;
    vc:slug "strategic-bitcoin-reserve" ;
    vc:sourceDomain "blockchain" .

ngm:strips a owl:Class ;
    rdfs:label "STRIPS"@en ;
    rdfs:comment "STRIPS (Stanford Research Institute Problem Solver) is a classical automated planning formalism that represents world states as conjunctions of propositions and defines actions via precondition, add-list, and delete-list operators. It introduced the core abstraction underlying modern planning languages such as PDDL and remains foundational to symbolic AI planning."@en ;
    rdfs:subClassOf ngm:ai-technique,
        ngm:knowledge-representation ;
    skos:broader ngm:ai-technique ;
    vc:bridgesTo ngm:path-planning ;
    vc:enables ngm:automated-planning ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:reinforcement-learning ;
    vc:slug "strips" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:knowledge-representation .

ngm:sub-millisecond-latency a owl:Class ;
    rdfs:label "Sub-Millisecond Latency"@en ;
    rdfs:comment "Sub-Millisecond Latency is a network performance characteristic in which end-to-end transaction confirmation or consensus completion occurs in under one millisecond, enabling near-real-time settlement on blockchain networks. It depends on highly optimised peer-to-peer propagation, deterministic finality mechanisms, and minimal block time, distinguishing high-performance chains from conventional systems with multi-second confirmation times."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:deterministic-finality ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:consensus-mechanism ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:peer-to-peer-network ],
        ngm:bc-network-component,
        ngm:transaction-confirmation ;
    skos:broader ngm:bc-network-component ;
    vc:contrastsWith ngm:probabilistic-finality ;
    vc:enables ngm:transaction-finality,
        ngm:transaction-processing ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:block-time,
        ngm:blockchain-scalability,
        ngm:latency,
        ngm:network-latency ;
    vc:requires ngm:consensus-mechanism,
        ngm:deterministic-finality,
        ngm:peer-to-peer-network ;
    vc:slug "sub-millisecond-latency" ;
    vc:sourceDomain "blockchain" .

ngm:subsumption-architecture a owl:Class ;
    rdfs:label "Subsumption Architecture"@en ;
    rdfs:comment "Subsumption architecture is a layered control method for autonomous agents in which simple reactive behaviours are stacked, with higher layers able to suppress or override lower ones to produce competent behaviour without a central world model."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:autonomous-agent ],
        ngm:robotics-domain ;
    vc:enables ngm:swarm-intelligence ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:autonomous-agent ;
    vc:slug "subsumption-architecture" ;
    vc:sourceDomain "metaverse" .

ngm:supply-chain-tracking a owl:Class ;
    rdfs:label "Supply Chain Tracking"@en ;
    rdfs:comment "Supply chain tracking is the end-to-end recording of a product's movement, custody, and condition as it passes through producers, logistics, and retailers. Blockchain-based approaches anchor these events to an immutable, shared ledger so that participants can verify provenance and detect tampering without trusting a single intermediary. It enables traceability for food safety, anti-counterfeiting, and regulatory compliance."@en ;
    rdfs:subClassOf ngm:blockchain ;
    skos:broader ngm:blockchain ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:asset-registry,
        ngm:ve-chain ;
    vc:slug "supply-chain-tracking" ;
    vc:sourceDomain "blockchain" .

ngm:sustainable-bitcoin-certificates a owl:Class ;
    rdfs:label "Sustainable Bitcoin Certificates"@en ;
    rdfs:comment "Sustainable Bitcoin certificates are tradable attestations that a defined quantity of bitcoin mining was powered by clean or low-carbon energy, allowing holders to claim the environmental attributes of that hashrate. They function analogously to renewable energy certificates, decoupling the green-energy claim from the mined coins so it can be sold to ESG-conscious buyers. The mechanism aims to channel capital toward decarbonising proof-of-work mining."@en ;
    rdfs:subClassOf ngm:digital-asset ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:bitcoin-environmental-issues,
        ngm:sustainable-bitcoin-protocol ;
    vc:slug "sustainable-bitcoin-certificates" ;
    vc:sourceDomain "blockchain" .

ngm:swi-glu a owl:Class ;
    rdfs:label "SwiGLU"@en ;
    rdfs:comment "SwiGLU is a gated activation function for neural networks that combines the Swish (SiLU) nonlinearity with a Gated Linear Unit, computing the element-wise product of a Swish-activated projection and a linear gate projection. It is widely used in the feed-forward sublayers of modern transformer models because it empirically improves quality over ReLU or GELU at comparable cost. Its gating mechanism gives the network a learnable, input-dependent pathway through each feed-forward block."@en ;
    rdfs:subClassOf ngm:neural-network ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:feed-forward-network,
        ngm:transformers ;
    vc:slug "swi-glu" ;
    vc:sourceDomain "ai" .

ngm:symbolic-object-library a owl:Class ;
    rdfs:label "Symbolic Object Library"@en ;
    rdfs:comment "A collection or repository of standardized 3D digital objects, assets, and components designed for use across metaverse platforms, including models, textures, animations, and interactive elements that can be shared and reused in virtual environments."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
