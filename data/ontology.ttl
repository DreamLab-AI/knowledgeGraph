ngm:gdpr-compliance a owl:Class ;
    rdfs:label "GDPR Compliance"@en ;
    rdfs:comment "GDPR Compliance is the totality of organisational, technical, and procedural measures an entity must implement to satisfy obligations under the EU General Data Protection Regulation (Regulation 2016/679), including identifying a lawful basis for each processing activity, fulfilling data subject rights, performing Data Protection Impact Assessments for high-risk processing, notifying supervisory authorities of breaches within 72 hours, and appointing a Data Protection Officer where required. The regulation applies extraterritorially to any organisation processing personal data of EU data subjects regardless of where processing occurs. Compliance programmes encompass privacy-by-design architecture, data minimisation, consent lifecycle management, Records of Processing Activities, demonstrable accountability mechanisms, and contractual safeguards for cross-border data transfers."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:privacy-by-design ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:consent-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-protection ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-protection-impact-assessment ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-minimisation ],
        ngm:data-governance ;
    vc:bridgesTo ngm:eu-ai-act-regulatory-instrument,
        ngm:privacy-enhancing-technologies ;
    vc:contrastsWith ngm:ccpa,
        ngm:hipaa ;
    vc:dependsOn ngm:data-protection-officer,
        ngm:supervisory-authority ;
    vc:enables ngm:accountability-framework,
        ngm:cross-border-data-transfer,
        ngm:data-subject-rights ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:data-protection-regulation,
        ngm:privacy-law ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:ai-governance,
        ngm:data-breach-notification,
        ngm:differential-privacy,
        ngm:federated-learning ;
    vc:requires ngm:consent-management,
        ngm:data-minimisation,
        ngm:data-protection,
        ngm:data-protection-impact-assessment,
        ngm:privacy-by-design ;
    vc:slug "gdpr-compliance" ;
    vc:sourceDomain "governance" ;
    vc:supports ngm:data-governance,
        ngm:information-security,
        ngm:trust-and-safety .

ngm:hyperparameter-tuning a owl:Class ;
    rdfs:label "Hyperparameter Tuning"@en ;
    rdfs:comment "Hyperparameter tuning is the systematic process of searching over the configuration space of parameters that govern the training process of a machine learning model — distinct from the learnable parameters updated during training itself. Common hyperparameters include learning rate, batch size, network depth and width, regularisation coefficients, dropout rate, optimiser choice, and architectural decisions such as kernel size or number of attention heads. The tuning process employs search strategies — including grid search, random search, Bayesian optimisation, population-based methods, and evolutionary algorithms — to identify configurations that maximise model performance on a held-out validation set while controlling for overfitting. Efficient hyperparameter optimisation is critical to practical machine learning deployment because model generalisation is often highly sensitive to these configuration choices, and naive exhaustive search is computationally intractable in high-dimensional spaces."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:validation-set ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cross-validation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:model-evaluation ],
        ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:bridgesTo ngm:cloud-computing,
        ngm:mlops ;
    vc:contrastsWith ngm:feature-engineering,
        ngm:overfitting ;
    vc:dependsOn ngm:early-stopping,
        ngm:objective-function,
        ngm:regularisation ;
    vc:enables ngm:deep-learning,
        ngm:model-generalisation,
        ngm:neural-architecture-search ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:auto-ml,
        ngm:machine-learning-discipline-pipeline ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:distributed-training,
        ngm:empirical-experimental-design-tracking,
        ngm:meta-learning,
        ngm:transfer-learning ;
    vc:requires ngm:cross-validation,
        ngm:model-evaluation,
        ngm:validation-set ;
    vc:slug "hyperparameter-tuning" ;
    vc:sourceDomain "machine-learning" ;
    vc:uses ngm:bayesian-optimisation,
        ngm:evolutionary-algorithm,
        ngm:gaussian-process,
        ngm:grid-search,
        ngm:random-search .

ngm:knowledge-distillation a owl:Class ;
    rdfs:label "Knowledge Distillation"@en ;
    rdfs:comment "A model compression technique where a smaller \"student\" model is trained to mimic the behaviour of a larger \"teacher\" model, transferring knowledge through soft targets. The student learns from the teacher's output probability distributions (soft targets) rather than ground-truth hard labels, enabling competitive performance at a fraction of the computational cost."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:training-data ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:teacher-student-training ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:neural-network ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:large-language-models ],
        ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:bridgesTo ngm:federated-learning ;
    vc:contrastsWith ngm:model-pruning,
        ngm:parameter-efficient-fine-tuning,
        ngm:quantisation ;
    vc:enables ngm:ai-inference,
        ngm:edge-computing,
        ngm:model-compression-for-edge,
        ngm:on-device-inference ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:teacher-student-training ;
    vc:isPartOf ngm:model-compression,
        ngm:neural-network ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:distilbert,
