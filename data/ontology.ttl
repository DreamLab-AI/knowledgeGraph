ngm:acid-transactions a skos:Concept ;
    rdfs:label "Acid Transactions"@en .

ngm:action-recognition a owl:Class ;
    rdfs:label "Action Recognition"@en ;
    rdfs:comment "Action Recognition is a computer-vision task that classifies the activity being performed by one or more agents from video or motion-sequence data. Models ingest spatiotemporal features, often built on detected body keypoints or 3D convolutions and transformers, to label actions such as walking, waving, or falling. It underpins applications in surveillance, sports analytics, human-robot interaction, and assistive monitoring."@en ;
    rdfs:subClassOf ngm:computer-vision ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:pose-estimation ;
    vc:slug "action-recognition" ;
    vc:sourceDomain "ai" .

ngm:adaptive-interfaces a owl:Class ;
    rdfs:label "Adaptive Interfaces"@en ;
    rdfs:comment "Adaptive interfaces are user interface systems that dynamically reconfigure their layout, content, modality, or interaction style in response to the current user's context, behaviour, preferences, or inferred cognitive state. They employ user modelling, machine learning, and context-aware computing to personalise the interaction layer without requiring manual configuration. The goal is to optimise usability, accessibility, and task performance across diverse user populations and situational conditions."@en ;
    rdfs:subClassOf ngm:human-computer-interaction ;
    vc:enables ngm:accessible-experience,
        ngm:personalised-learning ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:attention-aware-interaction,
        ngm:hyper-personalisation ;
    vc:slug "adaptive-interfaces" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:context-awareness,
        ngm:recommendation-system .

ngm:adas a owl:Class ;
    rdfs:label "ADAS"@en ;
    rdfs:comment "Advanced Driver Assistance Systems (ADAS) are electronic systems that assist vehicle operators with driving and parking functions through automated technologies including adaptive cruise control, lane keeping assist, automatic emergency braking, blind spot detection, and parking assistance. ADAS operates at SAE Level 1–2 automation, augmenting rather than replacing the driver, and relies on sensor fusion across cameras, radar, and ultrasonic systems to perceive the vehicle's environment."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:sensor-fusion ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:perception-system ],
        ngm:autonomous-vehicle,
        ngm:robo-robot-type ;
    skos:broader ngm:robo-robot-type ;
    vc:contrastsWith ngm:autonomous-vehicle ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:risk ;
    vc:requires ngm:perception-system,
        ngm:sensor-fusion ;
    vc:slug "adas" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:camera,
        ngm:computer-vision,
        ngm:lidar .

ngm:additionality a skos:Concept ;
