    vc:slug "learning-module" ;
    vc:sourceDomain "spatial-computing" .

ngm:lens-distortion-correction a owl:Class ;
    rdfs:label "Lens Distortion Correction"@en ;
    rdfs:comment "Lens distortion correction is the process of removing geometric aberrations introduced by camera optics so that straight lines in the world appear straight in the image. It estimates distortion coefficients, typically radial and tangential terms, from calibration data and remaps pixels to an undistorted, rectilinear projection. The correction is a prerequisite for accurate measurement, pose estimation, and image rectification in computer-vision pipelines."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:checkerboard-pattern ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:camera-intrinsics ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:optical-calibration-target ],
        ngm:camera-calibration ;
    vc:bridgesTo ngm:spatial-computing ;
    vc:dependsOn ngm:camera-calibration ;
    vc:enables ngm:augmented-reality,
        ngm:photogrammetry,
        ngm:pose-estimation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:camera-calibration ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:fiducial-marker,
        ngm:homography ;
    vc:requires ngm:camera-intrinsics,
        ngm:checkerboard-pattern,
        ngm:optical-calibration-target ;
    vc:slug "lens-distortion-correction" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:camera-calibration ;
    vc:uses ngm:computer-vision,
        ngm:feature-detection .

ngm:leveraged-trading a owl:Class ;
    rdfs:label "Leveraged Trading"@en ;
    rdfs:comment "Leveraged trading is the practice of opening market positions whose notional size exceeds the trader's posted collateral by borrowing capital or using derivatives such as perpetual futures. It amplifies both gains and losses and exposes positions to liquidation when collateral falls below maintenance margin. In DeFi it is implemented by perpetual and margin protocols that enforce margin rules through smart contracts and on-chain oracles."@en ;
    rdfs:subClassOf ngm:bc-defi-and-economics ;
    skos:broader ngm:bc-defi-and-economics ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:d-yd-x,
        ngm:gmx ;
    vc:slug "leveraged-trading" ;
    vc:sourceDomain "blockchain" .

ngm:light-client-verification a owl:Class ;
    rdfs:label "Light Client Verification"@en ;
    rdfs:comment "Light client verification is the technique by which a resource-constrained client confirms facts about a blockchain without downloading or executing its full history. By tracking block headers and validating compact cryptographic proofs against committed state roots, a light client can verify transaction inclusion and consensus with minimal data and computation. It is foundational to mobile wallets, embedded clients, and trust-minimised cross-chain bridges."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:consensus-mechanism ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:finality ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:block-header ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:merkle-proof ],
        ngm:light-client ;
    vc:bridgesTo ngm:zero-knowledge-proof ;
    vc:dependsOn ngm:data-availability,
        ngm:full-node ;
    vc:enables ngm:blockchain-scalability,
        ngm:decentralisation ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:block-header,
        ngm:merkle-proof ;
    vc:implements ngm:cryptographic-proof,
        ngm:state-proof ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:ibc,
        ngm:rollup ;
    vc:requires ngm:consensus-mechanism,
        ngm:finality ;
    vc:slug "light-client-verification" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:blockchain-interoperability,
        ngm:cross-chain-bridge ;
    vc:uses ngm:merkle-root,
        ngm:merkle-tree .

ngm:light-field a owl:Class ;
    rdfs:label "Light field"@en ;
    rdfs:comment "Light field is a foundational concept in computational optics and computer graphics describing the complete distribution of light rays travelling through free space in all directions at all points, formalised by Adelson and Bergen (1991) as the 7-dimensional plenoptic function P(Vx, Vy, Vz, θ, φ,..."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:sampling-theory ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gpu-compute ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:lens-and-camera-calibration ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:light-field-display ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:camera-calibration ],
        ngm:sc-display-and-rendering ;
    skos:broader ngm:sc-display-and-rendering ;
    vc:bridgesTo ngm:computer-vision ;
    vc:enables ngm:depth-estimation,
        ngm:holographic-display,
        ngm:novel-view-synthesis,
        ngm:spatial-computing ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:light-field-display ;
    vc:implements ngm:epipolar-geometry,
        ngm:neural-radiance-fields ;
    vc:qualityScore "0.52"^^xsd:float ;
    vc:relatedTo ngm:holography,
        ngm:neural-radiance-fields,
        ngm:spatial-computing ;
    vc:requires ngm:camera-calibration,
        ngm:gpu-compute,
        ngm:lens-and-camera-calibration,
        ngm:sampling-theory ;
    vc:slug "light-field" ;
    vc:sourceDomain "spatial-computing" ;
    vc:standardizedBy ngm:cvpr,
        ngm:iccv,
        ngm:siggraph ;
    vc:supports ngm:augmented-reality,
        ngm:broadcast-production,
        ngm:medical-imaging,
        ngm:virtual-reality ;
    vc:uses ngm:convolutional-neural-network,
        ngm:gaussian-splatting,
        ngm:structured-light,
        ngm:volume-rendering .

ngm:lightning-network-specification a owl:Class ;
    rdfs:label "Lightning Network Specification"@en ;
    rdfs:comment "The Lightning Network Specification, known as BOLT (Basis of Lightning Technology), is the set of documents defining the peer-to-peer protocol for Bitcoin's Lightning payment-channel network. It standardises channel establishment, commitment transactions, HTLC-based routing, onion message encryption, and gossip propagation so that independent implementations interoperate. The specification is the canonical reference enabling trust-minimised off-chain Bitcoin payments."@en ;
    rdfs:subClassOf ngm:technical-standard ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:btc-layer-3,
        ngm:taproot-assets ;
    vc:slug "lightning-network-specification" ;
    vc:sourceDomain "blockchain" .

ngm:liquidation-engine a owl:Class ;
    rdfs:label "Liquidation Engine"@en ;
    rdfs:comment "A liquidation engine is the component of a decentralised lending or derivatives protocol that detects under-collateralised positions and forcibly closes or partially repays them to keep the system solvent. It continuously evaluates position health against collateral values supplied by price oracles, and when a position breaches its maintenance threshold it triggers liquidation, typically auctioning or selling collateral and rewarding external liquidators or keepers who execute the transaction. By enforcing collateralisation guarantees on-chain, the liquidation engine is central to risk management in DeFi lending, perpetual-futures, and collateralised-debt systems."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:oracle ],
        ngm:lending-protocol ;
    vc:bridgesTo ngm:automated-market-maker,
        ngm:perpetual-futures ;
    vc:dependsOn ngm:oracle ;
    vc:enables ngm:lending-protocol ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:collateral ;
    vc:implements ngm:risk-management ;
    vc:isPartOf ngm:decentralized-finance ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:de-fi,
        ngm:risk-management,
        ngm:smart-contract ;
    vc:requires ngm:collateral,
        ngm:oracle ;
    vc:slug "liquidation-engine" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:perpetual-futures ;
    vc:uses ngm:oracle,
        ngm:smart-contract .

ngm:llm-application-framework a owl:Class ;
    rdfs:label "LLM Application Framework"@en ;
    rdfs:comment "A software library that provides abstractions for building applications on top of large language models, including prompt management, tool integration, retrieval and chaining of model calls."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:large-language-models ],
        ngm:large-language-models ;
    vc:enables ngm:retrieval-augmented-generation ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:large-language-models ;
    vc:slug "llm-application-framework" ;
    vc:sourceDomain "ai" .

ngm:local-explanation a owl:Class ;
    rdfs:label "Local Explanation"@en ;
    rdfs:comment "Interpretability techniques that explain individual model predictions for specific instances, providing insight into why a particular input produced a given output without necessarily characterising the model's global behaviour. Methods such as LIME and SHAP generate feature-attribution scores scoped to the neighbourhood of a single query point."@en ;
    rdfs:subClassOf ngm:model-interpretability ;
    vc:bridgesTo ngm:sc-content-and-assets ;
    vc:contrastsWith ngm:global-explanation ;
    vc:enables ngm:accountability,
        ngm:fairness ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:explainable-ai ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:slug "local-explanation" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:feature-importance .

ngm:local-first-software a owl:Class ;
    rdfs:label "Local-First Software"@en ;
    rdfs:comment "Local-first software is a design philosophy in which the primary copy of a user's data lives on their own device, with the network used for optional synchronisation rather than as a dependency. It prioritises offline availability, low latency, data ownership, and longevity while still supporting real-time collaboration via conflict-free merging. The approach typically relies on CRDTs to reconcile concurrent edits across devices without a central authority."@en ;
    rdfs:subClassOf ngm:software-architecture ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:crdt,
        ngm:distributed-systems ;
    vc:slug "local-first-software" ;
    vc:sourceDomain "infrastructure" .

ngm:local-search a skos:Concept ;
    rdfs:label "Local Search"@en .

ngm:locking-script a owl:Class ;
    rdfs:label "Locking Script"@en ;
    rdfs:comment "A locking script (also called scriptPubKey or an output script) is the predicate attached to a transaction output in UTXO-based blockchains that specifies the conditions under which that output may later be spent. To redeem the output, a spending transaction must supply an unlocking script whose combination with the locking script evaluates to true. Locking scripts encode spending policies ranging from a single signature to multi-signature, time locks and arbitrary smart-contract logic."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:hash-function ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:public-key-cryptography ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:digital-signature ],
        ngm:utxo-model ;
    vc:contrastsWith ngm:smart-contract ;
    vc:dependsOn ngm:public-key-cryptography ;
    vc:enables ngm:smart-contract,
        ngm:transaction-validation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:hash-function ;
    vc:implements ngm:access-control ;
    vc:isPartOf ngm:transaction-validation,
        ngm:utxo-model ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:key-management,
        ngm:wallet ;
    vc:requires ngm:digital-signature,
        ngm:public-key-cryptography ;
    vc:slug "locking-script" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:transaction-validation ;
    vc:uses ngm:bitcoin-script,
        ngm:digital-signature .

ngm:low-code-platform a owl:Class ;
    rdfs:label "Low Code Platform"@en ;
    rdfs:comment "A low-code platform is a software development environment that lets users build applications primarily through visual, model-driven interfaces such as drag-and-drop component composition, declarative configuration, and pre-built connectors, while still permitting hand-written code for custom logic. It abstracts away much boilerplate of conventional programming, accelerating delivery and broadening who can build software to include semi-technical citizen developers. Modern platforms increasingly embed AI assistance for component suggestion, data-model inference, and automated workflow generation, positioning them as a core layer in enterprise hyperautomation strategies."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:platform-engineering ],
        ngm:application-development ;
    vc:bridgesTo ngm:hyperautomation,
        ngm:robotic-process-automation ;
    vc:contrastsWith ngm:software-engineering ;
    vc:dependsOn ngm:software-engineering ;
    vc:enables ngm:application-development,
        ngm:hyperautomation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:workflow-automation ;
    vc:isPartOf ngm:software-development ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:business-process-automation,
        ngm:platform-engineering ;
    vc:requires ngm:platform-engineering ;
    vc:slug "low-code-platform" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:robotic-process-automation ;
    vc:uses ngm:business-process-automation,
        ngm:workflow-automation .

ngm:low-latency-computing a owl:Class ;
    rdfs:label "Low-Latency Computing"@en ;
    rdfs:comment "Low-latency computing is an architectural discipline concerned with minimising the end-to-end delay between a request and its response, typically targeting sub-millisecond to single-digit-millisecond budgets. It combines hardware proximity, kernel-bypass networking, lock-free data structures, cache-aware memory layouts, and predictable scheduling to eliminate sources of jitter. Application domains include high-frequency trading, real-time multiplayer rendering, industrial control, telecommunications signalling, and interactive AI inference, where tail latency rather than average throughput is the governing performance metric."@en ;
    rdfs:subClassOf ngm:distributed-computing ;
    vc:enables ngm:real-time-rendering ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:cloud-computing,
        ngm:network-protocol ;
    vc:slug "low-latency-computing" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:edge-computing .

ngm:markdown-diagramming-as-code-tool a owl:Class ;
    rdfs:label "Markdown Diagramming As Code Tool"@en ;
    rdfs:comment "A JavaScript-based diagramming-as-code tool that renders flowcharts, sequence diagrams, Gantt charts, entity-relationship diagrams, and other diagram types from plain-text markup embedded in Markdown documents. Mermaid is widely adopted in developer documentation workflows, enabling version-controllable, maintainable diagrams without external tooling. It integrates natively with platforms such as GitHub, GitLab, Notion, and Logseq."@en ;
    rdfs:subClassOf ngm:infra-software-engineering ;
    skos:broader ngm:infra-software-engineering ;
    vc:enables ngm:knowledge-graph,
        ngm:ontology ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:relatedTo ngm:knowledge-representation ;
    vc:slug "markdown-diagramming-as-code-tool" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:diagrams-as-code,
        ngm:software-engineering .

ngm:masked-language-modelling a owl:Class ;
    rdfs:label "Masked Language Modelling"@en ;
    rdfs:comment "Masked language modelling is a self-supervised pre-training objective in which random tokens of an input sequence are hidden and the model learns to predict them from the surrounding bidirectional context. By conditioning on both left and right context, it produces deep contextual representations of language. It is the objective popularised by BERT and underpins many encoder-based transformer models."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:cross-entropy-loss ],
        ngm:pre-training ;
    vc:bridgesTo ngm:language-model ;
    vc:contrastsWith ngm:autoregressive-model,
        ngm:next-token-prediction ;
    vc:dependsOn ngm:transformer ;
    vc:enables ngm:fine-tuning,
        ngm:representation-learning ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:cross-entropy-loss ;
    vc:implements ngm:self-supervised-learning ;
    vc:isPartOf ngm:pre-training ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:loss-function,
        ngm:representation-learning,
        ngm:word-embedding ;
    vc:requires ngm:contextual-embedding ;
    vc:slug "masked-language-modelling" ;
    vc:sourceDomain "machine-learning" ;
    vc:supports ngm:bert ;
    vc:uses ngm:self-supervised-learning,
        ngm:transformer .

ngm:material-science a owl:Class ;
    rdfs:label "Material Science"@en ;
    rdfs:comment "Material Science is the interdisciplinary field that studies the structure, properties, processing, and performance of matter across all classes — metals, ceramics, polymers, semiconductors, and composites — connecting atomic-scale arrangement to macroscopic behaviour. It integrates principles from physics, chemistry, and engineering to enable the rational design of materials with tailored properties. Computational methods including density functional theory, molecular dynamics simulation, and machine-learning-driven property prediction increasingly complement experimental synthesis and characterisation. The field underpins virtually every technology sector, from microelectronics and energy storage to biomedical implants and advanced manufacturing."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:thermodynamics ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:thermodynamics ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:quantum-mechanics ],
        ngm:infra-software-engineering ;
    skos:broader ngm:infra-software-engineering ;
    vc:bridgesTo ngm:artificial-intelligence,
        ngm:quantum-computation-paradigm,
        ngm:supply-chain ;
    vc:dependsOn ngm:chemistry ;
    vc:enables ngm:additive-manufacturing,
        ngm:material-system,
        ngm:nanotechnology,
        ngm:semiconductor-manufacturing ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:crystallography,
        ngm:thermodynamics ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:condensed-matter-physics,
        ngm:nanoscience ;
    vc:requires ngm:computational-chemistry,
        ngm:quantum-mechanics,
        ngm:thermodynamics ;
    vc:slug "material-science" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:machine-learning,
        ngm:simulation .

ngm:mean-squared-error a owl:Class ;
    rdfs:label "Mean Squared Error"@en ;
    rdfs:comment "A measure of the average squared difference between predicted values and observed values, widely used to quantify estimation and prediction error in regression and statistical learning."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:bias-variance-tradeoff ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:statistics ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:probability-theory ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:regression ],
        ngm:loss-function ;
    vc:bridgesTo ngm:data,
        ngm:signal-processing ;
    vc:contrastsWith ngm:cross-entropy-loss,
        ngm:loss-function,
        ngm:mean-absolute-error ;
    vc:dependsOn ngm:backpropagation,
        ngm:gradient-descent ;
    vc:enables ngm:hyperparameter-tuning,
        ngm:model-training,
        ngm:supervised-learning ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:bias-variance-tradeoff ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:neural-network,
        ngm:overfitting,
        ngm:regularisation,
        ngm:root-mean-square-error ;
    vc:requires ngm:probability-theory,
        ngm:regression,
        ngm:statistics ;
    vc:slug "mean-squared-error" ;
    vc:sourceDomain "machine-learning" .

ngm:measurement-methodology a owl:Class ;
    rdfs:label "Measurement Methodology"@en ;
    rdfs:comment "A measurement methodology is a defined, repeatable procedure for quantifying a property or performance characteristic, specifying scope, units, data sources, and calculation rules. It ensures that results are consistent, comparable, and auditable across observers and over time. Rigorous methodology is the precondition for trustworthy indicators, benchmarks, and standards-based reporting."@en ;
    rdfs:subClassOf ngm:evaluation-metric ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:benchmark-standard,
        ngm:carbon-footprint-indicator ;
    vc:slug "measurement-methodology" ;
    vc:sourceDomain "governance" .

ngm:media-production a owl:Class ;
    rdfs:label "Media Production"@en ;
    rdfs:comment "Media production is the end-to-end process of creating audiovisual content, spanning pre-production planning, capture, editing, and post-production finishing. It increasingly integrates generative AI, virtual production, and automated voice and speech tools to accelerate and personalise output. As a workflow it coordinates creative, technical, and asset-management activities across a content pipeline."@en ;
    rdfs:subClassOf ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:content-creation-pipeline,
        ngm:speech-and-voice ;
    vc:slug "media-production" ;
    vc:sourceDomain "metaverse" .

ngm:media-richness-theory a owl:Class ;
    rdfs:label "Media Richness Theory"@en ;
    rdfs:comment "\"A theoretical framework positing that communication media vary in their capacity to convey rich information through multiple cues, immediate feedback, language variety, and personal focus, predicting that richer media enable more effective communication of complex, ambiguous information whilst l..."@en ;
    rdfs:subClassOf ngm:dc-communication ;
    skos:broader ngm:dc-communication ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:slug "media-richness-theory" ;
    vc:sourceDomain "distributed-collaboration" .

ngm:membership-service-provider a owl:Class ;
    rdfs:label "Membership Service Provider"@en ;
    rdfs:comment "A Membership Service Provider (MSP) is the component of a permissioned blockchain that abstracts the cryptographic identity material and rules used to authenticate and authorise participants. It defines which certificate authorities are trusted, which roles members hold, and how digital certificates map to organisational identities used in endorsement and access policies. The MSP turns raw public-key infrastructure into the network's notion of who is allowed to act and in what capacity."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:digital-certificate ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:certificate-authority ],
        ngm:identity-management ;
    vc:bridgesTo ngm:trust-infrastructure ;
    vc:contrastsWith ngm:authentication ;
    vc:dependsOn ngm:certificate-authority ;
    vc:enables ngm:permissioned-blockchain ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:digital-certificate ;
    vc:implements ngm:identity-management ;
    vc:isPartOf ngm:permissioned-blockchain ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:authentication,
        ngm:consensus-mechanism ;
    vc:requires ngm:certificate-authority ;
    vc:slug "membership-service-provider" ;
    vc:sourceDomain "blockchain" ;
    vc:standardizedBy ngm:hyperledger-fabric ;
    vc:supports ngm:hyperledger-fabric ;
    vc:uses ngm:cryptography .

ngm:mental-model a owl:Class ;
    rdfs:label "Mental Model"@en ;
    rdfs:comment "A mental model is an internal cognitive representation that a person holds of how a system, interface, or environment works and behaves. In interaction design it explains how users predict outcomes, form expectations, and interpret feedback, so designs that match users' existing mental models are easier to learn and less error-prone. Mismatches between the designer's conceptual model and the user's mental model are a primary source of usability problems."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:perception ],
        ngm:human-computer-interaction ;
    vc:bridgesTo ngm:human-computer-interaction ;
    vc:contrastsWith ngm:world-model ;
    vc:dependsOn ngm:cognitive-science ;
    vc:enables ngm:interaction-design,
        ngm:usability ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:cognitive-science,
        ngm:perception,
        ngm:usability,
        ngm:world-model ;
    vc:requires ngm:perception ;
    vc:slug "mental-model" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:user-experience ;
    vc:uses ngm:affordance,
        ngm:perception .

ngm:meta-llama-model-family-3 a owl:Class ;
    rdfs:label "Llama 3"@en ;
    rdfs:comment "Llama 3 is a family of open-weight large language models developed and released by Meta AI in April 2024, spanning 8 billion and 70 billion parameter base and instruction-tuned variants, with a 405 billion parameter model subsequently released in July 2024. Llama 3 models are trained on approximately 15 trillion tokens from a curated multilingual corpus, use a 128,000-token vocabulary with a custom BPE tokeniser, incorporate grouped-query attention for inference efficiency, and are post-trained with supervised fine-tuning and reinforcement learning from human feedback. The models are released under a custom Meta Llama 3 Community License that permits commercial use for most organisations while imposing restrictions on deployments exceeding 700 million monthly active users."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gpu-cluster ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:distributed-training ],
        ngm:large-language-models ;
    vc:bridgesTo ngm:edge-computing,
        ngm:enterprise-ai ;
    vc:contrastsWith ngm:claude,
        ngm:gpt-4,
        ngm:mistral ;
    vc:enables ngm:fine-tuning,
        ngm:inference-engine,
        ngm:on-device-inference,
        ngm:open-source-ai,
        ngm:retrieval-augmented-generation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:supervised-fine-tuning ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:benchmarks,
        ngm:hugging-face,
        ngm:meta-ai,
        ngm:model-weights,
        ngm:multimodal-ai-architecture-models,
        ngm:safety-and-alignment ;
    vc:requires ngm:distributed-training,
        ngm:gpu-cluster ;
    vc:slug "llama-3" ;
    vc:sourceDomain "machine-learning" ;
    vc:uses ngm:byte-pair-encoding,
        ngm:grouped-query-attention,
        ngm:instruction-tuning,
        ngm:positional-encoding,
        ngm:rlhf,
        ngm:transformer-architecture .

ngm:metadata-catalog a owl:Class ;
    rdfs:label "Metadata Catalog"@en ;
    rdfs:comment "A metadata catalog is a centralised, searchable inventory of an organisation's data assets and their descriptive, technical, operational, and business metadata. It records schemas, locations, ownership, lineage, classifications, and usage, enabling users to discover, understand, trust, and govern data. By unifying metadata across heterogeneous stores, it underpins data discovery, governance, and self-service analytics."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:metadata-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-governance ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:schema-registry ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:data-lineage ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:metadata-management ],
        ngm:data-catalog ;
    vc:bridgesTo ngm:data-lake,
        ngm:data-warehouse ;
    vc:dependsOn ngm:metadata-management ;
    vc:enables ngm:data-discovery,
        ngm:data-governance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:data-lineage,
        ngm:metadata-management,
        ngm:schema-registry ;
    vc:isPartOf ngm:data-catalog ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:data-discovery,
        ngm:data-quality,
        ngm:master-data-management ;
    vc:requires ngm:data-governance,
        ngm:metadata-management ;
    vc:slug "metadata-catalog" ;
    vc:sourceDomain "data" ;
    vc:supports ngm:data-management,
        ngm:data-quality ;
    vc:uses ngm:data-lineage,
        ngm:schema-registry .

ngm:metaverse-application a owl:Class ;
    rdfs:label "Metaverse Application"@en ;
    rdfs:comment "A software application designed to operate within or alongside a metaverse platform, providing users with persistent virtual experiences including social interaction, commerce, entertainment, education, and collaboration. Metaverse applications leverage real-time 3D rendering, avatar systems, spatial audio, and interoperability standards to deliver presence-rich, cross-platform functionality within shared virtual environments."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:avatar ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:metaverse-platform ],
        ngm:dc-telepresence ;
    skos:broader ngm:dc-telepresence ;
    vc:enables ngm:distributed-collaboration,
        ngm:virtual-collaboration ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:interoperability,
        ngm:metaverse-architecture ;
    vc:requires ngm:avatar,
        ngm:metaverse-platform ;
    vc:slug "metaverse-application" ;
    vc:sourceDomain "distributed-collaboration" ;
    vc:uses ngm:game-engine,
        ngm:spatial-audio .

ngm:metaverse-ontology-schema a owl:Class ;
    rdfs:label "Metaverse Ontology Schema"@en ;
    rdfs:comment "A formal OWL 2 ontology framework defining the complete taxonomic structure, semantic relationships, axioms, and reasoning rules for metaverse concepts, enabling automated classification, consistency validation, and interoperability across virtual world implementations."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:rdf-triple-store ],
        [ a owl:Restriction ;
