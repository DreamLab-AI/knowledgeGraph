ngm:knowledge-base a owl:Class ;
    rdfs:label "Knowledge Base"@en ;
    rdfs:comment "A knowledge base is a structured, machine-readable repository of domain-specific information, factual assertions, and inference rules that software systems—including expert systems, question-answering engines, and AI agents—can query, reason over, and update. Knowledge bases range from relational tables and document stores to formal ontologies expressed in OWL/RDF and property graphs, each offering different trade-offs between expressiveness, scalability, and reasoning complexity. They function as the long-term declarative memory layer in AI architectures, enabling systems to retrieve, validate, and integrate facts without embedding all knowledge in model parameters. In contemporary retrieval-augmented generation pipelines a knowledge base serves as the authoritative external store from which a retriever selects grounding context for a large language model."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:production-rules ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:inference-engine ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:triple-store ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:ontology ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-schema ],
        ngm:knowledge-representation ;
    vc:bridgesTo ngm:digital-twin ;
    vc:contrastsWith ngm:database,
        ngm:large-language-model,
        ngm:vector-database ;
    vc:dependsOn ngm:data-model,
        ngm:ontology ;
    vc:enables ngm:automated-reasoning,
        ngm:expert-systems,
        ngm:question-answering,
        ngm:retrieval-augmented-generation,
        ngm:semantic-search ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:inference-engine,
        ngm:ontology,
        ngm:production-rules,
        ngm:triple-store ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:knowledge-graph,
        ngm:natural-language-processing,
        ngm:semantic-web-linked-data-standard ;
    vc:requires ngm:data-schema ;
    vc:slug "knowledge-base" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:description-logic,
        ngm:knowledge-representation,
        ngm:rdf,
        ngm:sparql .

ngm:machine-learning-discipline-pipeline a owl:Class ;
    rdfs:label "Machine Learning Pipeline"@en ;
    rdfs:comment "A Machine Learning Pipeline is the end-to-end automated workflow for developing, training, validating, deploying, and monitoring ML models. It encompasses data ingestion, preprocessing, feature engineering, model selection, hyperparameter tuning, training, evaluation, deployment, and continuous monitoring, and typically adopts MLOps practices with automated orchestration, versioning, and experiment tracking to ensure reproducibility, scalability, and maintainability of ML systems in production environments."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:model-monitoring ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:data-preprocessing ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:feature-engineering ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:model-evaluation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:compute-infrastructure ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:hyperparameter-tuning ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-versioning ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:data-pipeline ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:model-deployment ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:training-data ],
        ngm:ai-infrastructure ;
    vc:bridgesTo ngm:data-engineering,
        ngm:software-engineering ;
    vc:contrastsWith ngm:ad-hoc-experimentation ;
    vc:dependsOn ngm:empirical-experimental-design-tracking,
        ngm:workflow-orchestration ;
    vc:enables ngm:continuous-training,
        ngm:inference,
        ngm:model-training,
        ngm:reproducibility ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:data-pipeline,
        ngm:data-preprocessing,
        ngm:feature-engineering,
        ngm:hyperparameter-tuning,
        ngm:model-deployment,
        ngm:model-evaluation,
        ngm:model-monitoring ;
    vc:implements ngm:continuous-integration,
        ngm:mlops ;
    vc:qualityScore "0.68"^^xsd:float ;
