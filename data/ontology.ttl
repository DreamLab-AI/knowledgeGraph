        ngm:energy-source,
        ngm:mining-hardware,
        ngm:network-size ;
    vc:enables ngm:carbon-credit-tokenization,
        ngm:renewable-energy-certificate ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:carbon-emissions,
