ngm:continued-pre-training a owl:Class ;
    rdfs:label "Continued Pre Training"@en ;
    rdfs:comment "An intermediate training phase in which a pre-trained foundation model undergoes additional unsupervised pre-training on domain-specific or task-relevant corpora before supervised fine-tuning. Continued pre-training bridges general-purpose representations and domain expertise, using the same self-supervised objectives as initial pre-training whilst employing reduced learning rates and selective data to mitigate catastrophic forgetting of general capabilities."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:deep-learning ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:large-language-models ],
        ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:contrastsWith ngm:full-fine-tuning ;
    vc:enables ngm:domain-adaptation,
        ngm:fine-tuning ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:overfitting,
        ngm:transfer-learning ;
    vc:requires ngm:deep-learning,
        ngm:large-language-models ;
    vc:slug "continued-pre-training" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:contractum-language a owl:Class ;
    rdfs:label "Contractum Language"@en ;
    rdfs:comment "Contractum is a high-level smart-contract programming language designed for the RGB protocol, which performs client-side validation of state transitions anchored to Bitcoin. It compiles to AluVM bytecode and lets developers express RGB schemas and contract logic in a readable, declarative form. It is central to authoring confidential, scalable contracts that settle off-chain while inheriting Bitcoin's security."@en ;
    rdfs:subClassOf ngm:programming-language ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:rgb-and-client-side-validation ;
    vc:slug "contractum-language" ;
    vc:sourceDomain "blockchain" .

ngm:control-framework a owl:Class ;
    rdfs:label "Control Framework"@en ;
    rdfs:comment "A control framework is a structured set of governance, risk, and compliance controls that an organisation adopts to manage risk and demonstrate conformance to regulatory or industry requirements. Examples include NIST CSF, COBIT, ISO 27001, and SOC 2, each mapping objectives to specific control activities and evidence. It provides a common reference for designing, operating, and auditing controls consistently."@en ;
    rdfs:subClassOf ngm:governance-framework ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:compliance,
        ngm:regulatory-compliance ;
    vc:slug "control-framework" ;
    vc:sourceDomain "governance" .

ngm:control-net-conditioning a owl:Class ;
    rdfs:label "ControlNet Conditioning"@en ;
    rdfs:comment "ControlNet conditioning is a technique that augments a pretrained diffusion model with an auxiliary network so generation can be steered by spatial control signals such as edge maps, depth, pose, or segmentation. The ControlNet branch copies the encoder of the base model and injects conditioning through zero-initialised connections, preserving the original weights while adding controllability. It gives image-generation pipelines precise structural control without retraining the base model."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:diffusion-model ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:backpropagation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gpu-compute ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:training-data ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:neural-network-architecture ],
        ngm:adapter-tuning,
        ngm:ai-technique,
        ngm:generative-model ;
    skos:broader ngm:ai-technique ;
    vc:contrastsWith ngm:ip-adapter,
        ngm:lora,
        ngm:t2i-adapter,
        ngm:textual-inversion ;
    vc:enables ngm:conditional-image-generation,
        ngm:image-generation,
        ngm:inpainting,
        ngm:pose-guided-image-generation,
        ngm:text-to-image,
        ngm:video-generation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:conditioning-signal,
        ngm:skip-connection-injection,
        ngm:u-net-encoder-copy,
        ngm:zero-convolution ;
    vc:implements ngm:adapter-tuning,
        ngm:spatial-conditioning,
        ngm:transfer-learning ;
    vc:qualityScore "0.9"^^xsd:float ;
    vc:relatedTo ngm:animatediff,
        ngm:control-net,
        ngm:control-net-and-similar-spatial-conditioning-systems,
        ngm:controlnet-plus-plus,
        ngm:controlnet-xs,
        ngm:depth-estimation,
        ngm:edge-detection,
        ngm:flux-1,
        ngm:pose-estimation,
        ngm:semantic-segmentation ;
    vc:requires ngm:backpropagation,
        ngm:diffusion-model,
        ngm:gpu-compute,
        ngm:neural-network-architecture,
        ngm:training-data ;
    vc:slug "control-net-conditioning" ;
    vc:sourceDomain "ai" ;
