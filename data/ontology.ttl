    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:bip-327,
        ngm:bip-340-schnorr-keypair ;
    vc:requires ngm:bip-340-schnorr-keypair,
        ngm:bip-341 ;
    vc:slug "bip-342" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:discreet-log-contracts,
        ngm:lightning-network,
        ngm:time-lock ;
    vc:uses ngm:bitcoin-script,
        ngm:merkle-tree,
        ngm:schnorr-signature,
        ngm:stack-machine .

