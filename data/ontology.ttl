# AR Registration
spatial-computing:ARRegistration rdf:type owl:Class ;
    rdfs:subClassOf spatial-computing:SpatialTracking ;
    rdfs:subClassOf spatial-computing:ComputerVision ;
    rdfs:label "AR Registration"@en ;
    rdfs:comment "AR Registration is the spatial alignment process that anchors virtual content to real-world coordinates through Computer Vision, Sensor Input, and tracking algorithms. Successful registration maintains persistent, geometrically accurate overlay of digital objects on physical environments, critical for functional AR applications spanning AR Technology, industrial guidance, and 3D User Interface interaction."@en ;
    skos:prefLabel "AR Registration"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:spatial-computing:ar-registration" ;
    owl:sameAs <urn:visionclaw:concept:spatial-computing:ar-registration> ;
