    vc:uses ngm:liquidity-pool,
        ngm:smart-contract .

ngm:assistive-technology-integration a owl:Class ;
    rdfs:label "Assistive Technology Integration"@en ;
    rdfs:comment "Assistive Technology Integration is the practice of embedding tools, software, and hardware designed to support people with disabilities into digital systems, applications, and physical environments so that those individuals can access and interact with technology equitably. It encompasses screen readers, alternative input devices, augmentative communication systems, and adaptive interfaces, requiring compliance with accessibility standards and universal design principles. Effective integration ensures that assistive technologies interoperate seamlessly with underlying platforms rather than operating as bolt-on afterthoughts. The discipline spans hardware-software co-design, API compatibility, and user-centred testing with disabled communities."@en ;
    rdfs:subClassOf ngm:accessibility ;
    vc:enables ngm:accessible-experience,
        ngm:inclusive-xr-experience ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:accessibility-standard,
        ngm:human-computer-interaction,
        ngm:universal-design ;
    vc:slug "assistive-technology-integration" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:accessibility-audit-tool,
        ngm:gesture-recognition,
        ngm:haptic-feedback .

ngm:attention-weight a owl:Class ;
    rdfs:label "Attention Weight"@en ;
    rdfs:comment "A scalar coefficient produced by an attention mechanism that quantifies the relevance of one position (key/value) to another (query) in a sequence or across modalities. Attention weights are computed via a softmax over scaled dot-products of query and key vectors, and govern how much each value contributes to the output representation. They are the core computational primitive of Transformer-based models."@en ;
    rdfs:subClassOf ngm:ai-model-architecture ;
    skos:broader ngm:ai-model-architecture ;
    vc:enables ngm:large-language-models ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:attention-mechanism,
        ngm:transformer-architecture ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:cross-attention,
        ngm:multi-head-attention,
        ngm:positional-encoding,
        ngm:query-key-value,
        ngm:self-attention ;
    vc:slug "attention-weight" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:transformer .

ngm:audio-processing a owl:Class ;
    rdfs:label "Audio Processing"@en ;
    rdfs:comment "Audio processing is the computational manipulation of digital audio signals to transform, analyse, enhance, or synthesise sound, encompassing operations such as filtering, compression, equalization, spatialization, and feature extraction. It operates on discrete-time representations of acoustic waveforms using algorithms drawn from digital signal processing theory. Applications range from consumer media playback to professional studio production, speech recognition pipelines, and immersive spatial audio for extended reality environments."@en ;
    rdfs:subClassOf ngm:signal-processing ;
    vc:enables ngm:immersive-audio-system,
        ngm:spatial-audio-system,
        ngm:speech-recognition ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:audio-spatialization,
        ngm:digital-signal-processing,
        ngm:spatial-audio ;
    vc:slug "audio-processing" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:audio-parameters,
        ngm:audio-processing-system .

ngm:audio-technology a owl:Class ;
    rdfs:label "Audio Technology"@en ;
    rdfs:comment "The hardware, software, and signal-processing techniques used to capture, synthesise, spatialise, and reproduce sound within spatial computing and metaverse environments. Audio technology in immersive contexts encompasses spatial audio rendering, binaural processing, voice interaction, and real-time acoustic simulation to enhance presence and communication fidelity."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:immersive-audio-technology ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:spatial-audio ],
        ngm:sc-display-and-rendering ;
    skos:broader ngm:sc-display-and-rendering ;
    vc:bridgesTo ngm:telepresence ;
    vc:enables ngm:virtual-presence,
        ngm:voice-interaction ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:immersive-audio-technology,
        ngm:spatial-audio ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:slug "audio-technology" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:audio-processing-system .

ngm:augmented-connected-workforce a owl:Class ;
    rdfs:label "Augmented Connected Workforce"@en ;
    rdfs:comment "The Augmented Connected Workforce (ACW) is a digitally enhanced work paradigm in which human capabilities are amplified through the seamless integration of AI, augmented reality, virtual reality, and IoT technologies, enabling immersive spatial interactions and real-time connectivity across distributed teams. ACW systems overlay contextual digital information onto physical workspaces and connect workers to shared virtual environments, boosting safety, training efficacy, and operational coordination. It is recognised by Gartner as a strategic technology trend reshaping how organisations design, operate, and evolve their human workforce."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:immersive-technology ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:extended-reality ],
        ngm:metaverse-and-telecollaboration,
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:collaboration-platform,
        ngm:digital-workplace-platform,
        ngm:immersive-workspaces,
        ngm:telecollaboration ;
    vc:requires ngm:extended-reality,
        ngm:immersive-technology ;
    vc:slug "augmented-connected-workforce" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:augmented-reality,
        ngm:internet-of-things,
        ngm:virtual-reality,
        ngm:wearable-computing-platform .

ngm:austrian-economics a owl:Class ;
    rdfs:label "Austrian Economics"@en ;
    rdfs:comment "Austrian Economics is a heterodox school of economic thought originating in late 19th-century Vienna, most associated with Carl Menger, Ludwig von Mises, and Friedrich Hayek. It emphasises methodological individualism, the subjective theory of value, and the role of entrepreneurship in coordinating dispersed knowledge through price signals. The school critiques central planning and Keynesian intervention on the grounds that spontaneous market order cannot be replicated by any central authority, and that artificial credit expansion inevitably produces malinvestment and business cycles. Austrian insights have strongly influenced Bitcoin monetary theory, particularly the argument that hard-capped supply reproduces the properties of sound, commodity-backed money."@en ;
    rdfs:subClassOf ngm:economics ;
    vc:contrastsWith ngm:inflation-control,
        ngm:monetary-sovereignty ;
    vc:enables ngm:bitcoin-value-proposition,
        ngm:hyperbitcoinization ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:inflation,
        ngm:monetary-policy-implementation,
        ngm:sound-money ;
    vc:slug "austrian-economics" ;
    vc:sourceDomain "finance" ;
    vc:supports ngm:bitcoin-standard,
        ngm:decentralisation .

ngm:authentication-system a owl:Class ;
    rdfs:label "Authentication System"@en ;
    rdfs:comment "An authentication system is an infrastructure component responsible for verifying the claimed identity of users, devices, or services before granting access to protected resources. It integrates credential management, identity verification workflows, session management, and integration with downstream access control mechanisms to enforce the principle that only legitimate principals can initiate authenticated sessions. Authentication systems range from simple password databases to federated multi-factor frameworks spanning organisational boundaries."@en ;
    rdfs:subClassOf ngm:authentication ;
    vc:enables ngm:access-control,
        ngm:zero-trust-architecture ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:authentication-standards,
        ngm:decentralised-identity,
        ngm:identity-provider ;
    vc:slug "authentication-system" ;
    vc:sourceDomain "security" ;
    vc:uses ngm:cryptographic-signature,
        ngm:multi-factor-authentication,
        ngm:oauth-2-0,
        ngm:open-id-connect .

ngm:automated-reasoning a owl:Class ;
    rdfs:label "Automated Reasoning"@en ;
    rdfs:comment "Automated Reasoning is a subfield of artificial intelligence and computer science concerned with developing algorithms and systems that can perform logical inference, theorem proving, satisfiability checking, and knowledge-based deduction without continuous human guidance. It encompasses formal methods such as first-order logic, propositional calculus, and higher-order logics, implemented in systems ranging from SAT solvers and automated theorem provers to description logic reasoners underpinning knowledge graphs. Automated reasoning forms the rigorous backbone of formal verification, ontology inference, planning, and constraint satisfaction problems."@en ;
    rdfs:subClassOf ngm:reasoning ;
    vc:enables ngm:automated-planning,
        ngm:formal-verification,
