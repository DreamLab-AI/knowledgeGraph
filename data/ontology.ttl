ngm:causal-inference a owl:Class ;
    rdfs:label "Causal Inference"@en ;
    rdfs:comment "Causal inference is the scientific and statistical discipline concerned with drawing conclusions about cause-and-effect relationships from data, distinguishing genuine causal mechanisms from mere statistical association. It employs frameworks such as potential outcomes (Rubin causal model), structural causal models (Pearl's do-calculus), and graphical models (directed acyclic graphs) to formalise interventions and reason about counterfactuals. Applications span medicine, economics, social science, and AI alignment, wherever understanding the effect of an action — not merely its correlation with outcomes — is required."@en ;
    rdfs:subClassOf ngm:bayesian-inference ;
    vc:bridgesTo ngm:econometrics,
        ngm:epidemiology ;
    vc:contrastsWith ngm:correlation-analysis,
        ngm:statistical-association ;
    vc:enables ngm:algorithmic-fairness,
        ngm:causal-language-modelling,
        ngm:chain-of-thought-reasoning,
        ngm:counterfactual-reasoning,
        ngm:heterogeneous-treatment-effect-estimation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:back-door-criterion,
        ngm:do-calculus ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:inference,
        ngm:mathematical-reasoning,
        ngm:randomised-controlled-trial,
        ngm:reinforcement-learning ;
    vc:requires ngm:confounding-variable,
        ngm:observational-data,
        ngm:structural-causal-model ;
    vc:slug "causal-inference" ;
    vc:sourceDomain "machine-learning" ;
    vc:uses ngm:automated-reasoning,
        ngm:bayesian-optimisation,
        ngm:directed-acyclic-graph,
        ngm:instrumental-variables,
        ngm:potential-outcomes-framework,
        ngm:propensity-score-matching .

ngm:chain-of-thought-reasoning a owl:Class ;
    rdfs:label "Chain-of-Thought Reasoning"@en ;
    rdfs:comment "Chain-of-Thought Reasoning is the capacity of large language models to generate coherent sequences of intermediate logical, mathematical, or factual steps as part of producing a final answer, treating each intermediate token as an active computational resource that reshapes residual stream activations for subsequent Transformer layers. Unlike the surface prompting technique that elicits it, CoT Reasoning denotes an emergent model capability — present above certain parameter-scale thresholds — whereby the model decomposes complex problems into verifiable sub-steps rather than collapsing directly to a final token. This capability underpins inference-time compute scaling strategies including self-consistency sampling, process reward models, step-level verifiers, and tree-of-thought search, and connects neural language modelling to classical AI paradigms of deductive planning and symbolic reasoning."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:large-language-models ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:in-context-learning ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:transformer ],
        ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:bridgesTo ngm:automated-theorem-proving,
        ngm:formal-verification ;
    vc:contrastsWith ngm:direct-answer-prompting,
        ngm:standard-prompting,
        ngm:symbolic-ai ;
    vc:dependsOn ngm:attention-mechanism,
        ngm:model-scaling ;
    vc:enables ngm:autonomous-agents,
        ngm:mathematical-reasoning,
        ngm:multi-step-reasoning,
        ngm:process-reward-models,
        ngm:self-consistency ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:scratchpad-reasoning,
        ngm:self-refinement,
        ngm:tree-of-thought ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:inference-time-compute,
        ngm:mechanistic-interpretability,
        ngm:natural-language-processing,
        ngm:reasoning ;
    vc:requires ngm:in-context-learning,
        ngm:large-language-models,
        ngm:transformer ;
    vc:slug "chain-of-thought-reasoning" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:few-shot-learning,
        ngm:prompt-engineering,
        ngm:reinforcement-learning-from-human-feedback,
        ngm:zero-shot-prompting .

ngm:client-side-validation a owl:Class ;
    rdfs:label "Client-Side Validation"@en ;
    rdfs:comment "Client-Side Validation is the process of verifying user-supplied data within the browser or client application before that data is transmitted to a server, providing immediate feedback to users and reducing unnecessary network requests. In the context of Bitcoin and RGB Protocol, it refers to a distinct validation paradigm where the full state of off-chain assets is verified locally by the recipient rather than by all network nodes, enabling scalable, private asset transfers. The two usages share the principle of local verification but differ fundamentally in their security models and scope."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:single-use-seals ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:proof-of-publication ],
        ngm:data-integrity ;
    vc:bridgesTo ngm:constraint-validation-api,
        ngm:form-validation ;
    vc:contrastsWith ngm:ethereum-smart-contracts,
        ngm:global-state-validation,
        ngm:server-side-validation ;
    vc:dependsOn ngm:bitcoin-proof-of-work-protocol-network,
        ngm:utxo-model ;
    vc:enables ngm:block-trails,
        ngm:rgb-protocol,
        ngm:web-contracts,
        ngm:zero-knowledge-proof ;
    vc:hasMaturity ngmi:maturity-established ;
