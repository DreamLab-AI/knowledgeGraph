ngm:blockchain a owl:Class,
        skos:Concept ;
    rdfs:label "Blockchain"@en ;
    rdfs:comment "A blockchain is a distributed, cryptographically-secured data structure consisting of an ordered chain of blocks, where each block contains a cryptographic hash of the previous block, a timestamp, and transaction data, maintained through a consensus mechanism across a peer-to-peer network without..."@en ;
