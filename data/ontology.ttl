ngm:anthropic a owl:Class ;
    rdfs:label "Anthropic"@en ;
    rdfs:comment "Anthropic is an AI safety company founded in 2021 that develops large language models under the Claude family brand, with research programmes centred on constitutional AI, mechanistic interpretability, and scalable oversight. The company occupies the position of a safety-focused frontier AI laboratory, publishing research on alignment and interpretability while deploying Claude models commercially via API and consumer products. Anthropic's Constitutional AI (CAI) approach trains models to follow a set of principles using AI feedback rather than solely human labelling, aiming to reduce harmful outputs systematically."@en ;
    rdfs:subClassOf ngm:ai-governance-and-ethics ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:interpretability ;
    vc:slug "anthropic" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:ai-safety-research,
        ngm:constitutional-ai ;
    vc:uses ngm:large-language-models,
        ngm:rlhf .

ngm:arweave a owl:Class ;
    rdfs:label "Arweave"@en ;
    rdfs:comment "Arweave is a decentralised, blockchain-like storage network that enables permanent, censorship-resistant archival of data through a novel proof-of-access consensus mechanism. It introduces the concept of the 'permaweb', a permanent layer of the web where data is stored indefinitely via a one-time payment model. The network is sustained by an endowment-based token economics model that ensures miners are incentivised to serve content far into the future. Arweave underpins a range of Web3 storage use cases, from NFT metadata permanence to decentralised application state."@en ;
    rdfs:subClassOf ngm:decentralized-storage ;
    vc:enables ngm:data-persistence,
        ngm:digital-archive ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:content-addressing,
        ngm:distributed-storage,
        ngm:ipfs ;
    vc:slug "arweave" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:cryptographic-hash-function,
        ngm:proof-of-work,
        ngm:token-economics .

ngm:asset-pipeline a owl:Class ;
    rdfs:label "Asset Pipeline"@en ;
    rdfs:comment "An asset pipeline is an automated, staged workflow that ingests raw digital content—such as meshes, textures, audio, and animations—and transforms it through processing, optimisation, and packaging steps into runtime-ready formats. It enforces consistency, enables version control, and reduces manual labour in content production. Asset pipelines are foundational to game development, visual effects, and metaverse platform engineering. They increasingly incorporate AI-assisted compression and level-of-detail generation to scale content delivery."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:asset-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:render-pipeline ],
        ngm:3-d-content-pipeline ;
    vc:enables ngm:digital-twin-creation,
        ngm:game-engine ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:asset-management,
        ngm:render-pipeline ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:asset-format-standards,
        ngm:vfx-tools ;
    vc:slug "asset-pipeline" ;
    vc:sourceDomain "metaverse" ;
    vc:uses ngm:3-d-asset,
        ngm:3-d-file-format,
        ngm:data-compression,
        ngm:shader .

ngm:asset-portability a owl:Class ;
    rdfs:label "Asset Portability"@en ;
    rdfs:comment "Asset portability in spatial computing refers to the technical and standards-based capability to transfer, import, and faithfully render digital assets — including 3D models, textures, avatars, animations, and environments — across different rendering engines, platforms, and virtual world applications without loss of fidelity or functionality. Portability depends on common open file formats, agreed semantic conventions for material properties and skeletal rigs, and runtime interoperability layers. It is a prerequisite for the open metaverse vision of user-owned, platform-neutral digital property."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:3-d-file-format ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:interoperability ],
        ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:enables ngm:avatar-portability,
        ngm:cross-platform-interoperability ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:3-d-asset-standard ;
    vc:requires ngm:3-d-file-format,
        ngm:interoperability ;
    vc:slug "asset-portability" ;
    vc:sourceDomain "spatial-computing" .

ngm:assistive-robotics a owl:Class ;
    rdfs:label "Assistive Robotics"@en ;
    rdfs:comment "Assistive Robotics is a branch of robotics focused on designing and deploying robotic systems that support or augment human physical and cognitive capabilities for individuals with disabilities, age-related decline, or rehabilitation needs. These systems range from powered exoskeletons and mobility aids to companion robots that provide social and emotional support. They operate in close physical proximity to humans and must meet stringent safety, usability, and ethical standards. Integration with sensors, AI, and adaptive interfaces enables them to respond intelligently to user intent and changing physiological states."@en ;
    rdfs:subClassOf ngm:robotic-system ;
    vc:enables ngm:accessibility,
        ngm:ai-companions,
        ngm:social-interaction ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:exoskeleton-robot,
        ngm:human-robot-interaction,
        ngm:social-robotics ;
    vc:slug "assistive-robotics" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:actuator,
        ngm:embedded-systems,
        ngm:lower-limb-exoskeleton .

ngm:audio-system a owl:Class ;
    rdfs:label "Audio System"@en ;
    rdfs:comment "An Audio System in spatial computing manages the capture, processing, and playback of sound within immersive environments, encompassing spatial audio rendering, voice communication, and environmental sound simulation. It coordinates audio hardware and software to deliver positional audio that reinforces presence and enables natural verbal interaction in virtual and mixed-reality contexts."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:audio-spatialization ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:spatial-audio ],
        ngm:sc-display-and-rendering ;
    skos:broader ngm:sc-display-and-rendering ;
    vc:enables ngm:speech-recognition,
        ngm:telecollaboration ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:audio-spatialization,
        ngm:spatial-audio ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:relatedTo ngm:audio-processing-system ;
    vc:slug "audio-system" ;
    vc:sourceDomain "spatial-computing" .

ngm:auto-ml a owl:Class ;
    rdfs:label "AutoML"@en ;
    rdfs:comment "Automated Machine Learning (AutoML) is the discipline and associated tooling that automates the end-to-end pipeline of applying machine learning to real-world problems — encompassing automated data pre-processing, feature engineering, algorithm selection, Neural Architecture Search (NAS), hyp..."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
