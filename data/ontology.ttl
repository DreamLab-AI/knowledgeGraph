        ngm:model-serving ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:gpu,
        ngm:model-optimization ;
    vc:slug "ai-model-inference-engine" ;
    vc:sourceDomain "machine-learning" .

ngm:ai-provider a owl:Class ;
    rdfs:label "AI Provider"@en ;
    rdfs:comment "An individual, organisation, or legal entity that develops, produces, or supplies an AI system, assuming primary accountability for design decisions, training processes, capabilities, documentation, and regulatory compliance. Under the EU AI Act a provider places a system on the market under their own name, substantially modifies an existing system, or makes it available for use, thereby triggering obligations including conformity assessment, technical documentation, quality management, human oversight design, and post-market monitoring."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ai-lifecycle ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ai-impact-assessment ],
        ngm:ai-governance-and-ethics ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:implements ngm:ai-governance-framework,
        ngm:eu-ai-act-regulatory-instrument ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:relatedTo ngm:accountability,
        ngm:ai-operator,
        ngm:ai-user,
        ngm:risk-management ;
    vc:requires ngm:ai-impact-assessment,
        ngm:ai-lifecycle ;
    vc:slug "ai-provider" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:ai-safety-institute a owl:Class ;
    rdfs:label "AI Safety Institute"@en ;
    rdfs:comment "An AI Safety Institute (AISI) is a state-backed organisation established to evaluate, test, and research the capabilities and safety risks of advanced AI systems, particularly frontier models. Such bodies conduct pre-deployment and post-deployment evaluations, develop standardised benchmarks for dangerous capability elicitation, and advise governments on AI risk policy. The UK established the world's first AISI in November 2023 at the Bletchley Park AI Safety Summit; the US, Japan, Canada, and other nations subsequently established counterpart bodies. The UK later renamed its institute the AI Security Institute (DSIT) to reflect an expanded emphasis on national-security-relevant AI risks."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:frontier-ai ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ai-evaluation ],
        ngm:ai-safety ;
    vc:bridgesTo ngm:national-security,
        ngm:standards-body ;
    vc:contrastsWith ngm:ai-ethics-board ;
    vc:enables ngm:ai-alignment,
        ngm:ai-policy,
        ngm:international-ai-coordination ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:ai-governance,
        ngm:government-ai-policy ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:ai-safety-summit,
        ngm:bletchley-declaration,
        ngm:existential-ai-risk,
        ngm:large-language-model ;
    vc:requires ngm:ai-evaluation,
        ngm:frontier-ai ;
    vc:slug "ai-safety-institute" ;
    vc:sourceDomain "governance" ;
    vc:supports ngm:ai-regulation,
        ngm:ai-risk-assessment,
        ngm:responsible-ai ;
    vc:uses ngm:benchmarking,
        ngm:capability-evaluation,
        ngm:interpretability,
        ngm:red-teaming .

ngm:ai-scrapers a owl:Class ;
    rdfs:label "AI Scrapers"@en ;
    rdfs:comment "AI Scrapers are automated software agents (web crawlers, retrieval bots, and content-fetching pipelines) operated by foundation-model laboratories, AI search vendors, retrieval-augmented-generation services, dataset aggregators, and synthetic-media producers for the purpose of harvesting publicly..."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
