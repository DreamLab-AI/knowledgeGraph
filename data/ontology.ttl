    vc:relatedTo ngm:bitrate ;
    vc:relatedTo ngm:sample-rate ;
    vc:requires ngm:data-compression ;
    vc:requires ngm:digital-signal-processing ;
    vc:slug "audio-codec" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:voice-over-ip ;
    vc:uses ngm:lossless-compression ;
    vc:uses ngm:signal-processing .
ngm:audio-compression a owl:Class ;
    rdfs:comment "Audio Compression is the process of reducing the storage size or bandwidth required for audio data, using lossy codecs that discard perceptually less-important information or lossless codecs that preserve the exact waveform. It underlies streaming, spatial audio delivery, and real-time voice communication, balancing fidelity against transmission constraints. Common lossy approaches use psychoacoustic models to remove sound outside human hearing thresholds."@en ;
    rdfs:label "Audio Compression"@en ;
    rdfs:subClassOf ngm:data-compression ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.55"^^xsd:float ;
    vc:slug "audio-compression" ;
    vc:sourceDomain "data" .
