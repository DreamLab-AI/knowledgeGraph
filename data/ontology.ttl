ngm:training-dataset-metadata a owl:Class ;
    rdfs:label "Training Dataset Metadata"@en ;
    rdfs:comment "Training dataset metadata is structured descriptive information about the data used to train a machine learning model, including its provenance, size, collection method, class distribution, known biases, and licensing terms. This metadata is a core component of AI model cards and datasheets, enabling reproducibility, fairness auditing, and regulatory accountability. Thorough dataset metadata underpins model transparency and responsible AI governance."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-governance ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:metadata-schema ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:training-data ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:provenance-tracking ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-pipeline ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:data-versioning ],
        ngm:ai-infrastructure ;
    vc:enables ngm:ai-fairness,
        ngm:model-evaluation-results,
        ngm:model-transparency ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:data-versioning,
        ngm:metadata-schema,
        ngm:provenance-tracking ;
    vc:isPartOf ngm:ai-model-card ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:fairness-metrics,
        ngm:model-performance,
        ngm:provenance-standard ;
    vc:requires ngm:data-governance,
        ngm:data-pipeline,
        ngm:training-data ;
    vc:slug "training-dataset-metadata" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:transaction-ledger a owl:Class ;
    rdfs:label "Transaction Ledger"@en ;
    rdfs:comment "A transaction ledger is an ordered, append-only record of value transfers or state changes that serves as the authoritative history of activity within a financial or blockchain system. Each entry captures the parties, amounts, and timing of a transaction, and in distributed settings the ledger is cryptographically chained and replicated to guarantee integrity and auditability."@en ;
    rdfs:subClassOf ngm:distributed-data-structure ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:digital-tax-compliance-node,
        ngm:transaction-standard ;
    vc:slug "transaction-ledger" ;
    vc:sourceDomain "blockchain" .

ngm:transaction-manager a owl:Class ;
    rdfs:label "Transaction Manager"@en ;
    rdfs:comment "A transaction manager is a software component that coordinates the atomic execution of operations against a database or distributed system, enforcing the ACID properties of atomicity, consistency, isolation, and durability. It governs commit and rollback, manages concurrency control and locking, and in distributed settings orchestrates multi-resource protocols such as two-phase commit."@en ;
    rdfs:subClassOf ngm:data-management ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:data-layer,
        ngm:graph-database ;
    vc:slug "transaction-manager" ;
    vc:sourceDomain "data" .

ngm:transaction-standard a owl:Class ;
    rdfs:label "Transaction Standard"@en ;
    rdfs:comment "A protocol defining secure exchange of digital assets and services within virtual economies, specifying message formats, authentication mechanisms, settlement procedures, and integrity guarantees."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptographic-key-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-persistence ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:message-format ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:digital-identity ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:transaction-ledger ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:authentication-mechanism ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:network-protocol ],
        ngm:sc-standards-and-interop ;
    skos:broader ngm:sc-standards-and-interop ;
    vc:enables ngm:atomic-swap,
        ngm:economic-interoperability,
        ngm:multi-party-transactions,
        ngm:secure-asset-transfer,
        ngm:transaction-auditability ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:authentication-mechanism,
        ngm:integrity-verification,
        ngm:message-format,
        ngm:settlement-protocol,
        ngm:transaction-ledger ;
