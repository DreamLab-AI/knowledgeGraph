ngm:double-materiality a owl:Class ;
    rdfs:comment "A principle of sustainability reporting under which a topic must be disclosed if it is material from either of two perspectives: financial materiality, where sustainability matters create risks or opportunities that affect the company's cash flows and enterprise value, and impact materiality, where the company's own activities and value chain materially affect people or the environment. Adopted as the mandatory lens of the EU Corporate Sustainability Reporting Directive and its ESRS standards, it determines the scope of every disclosure."@en ;
    rdfs:label "Double Materiality"@en ;
    rdfs:subClassOf ngm:materiality-assessment ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:corporate-sustainability-reporting ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:corporate-sustainability-reporting-directive ;
    vc:relatedTo ngm:esg-reporting ;
    vc:slug "double-materiality" ;
    vc:sourceDomain "governance" .
ngm:double-materiality-assessment a skos:Concept ;
    rdfs:label "Double Materiality Assessment"@en .
ngm:double-spend-prevention a owl:Class ;
    rdfs:comment "Double-spend prevention refers to the set of cryptographic, consensus-based, and protocol-level mechanisms that ensure a given unit of digital value cannot be spent more than once within a payment or transaction system. This problem is fundamental to digital money because, unlike physical currency, digital data can be trivially copied; preventing double-spending without a trusted central authority was the key unsolved challenge that Satoshi Nakamoto's Bitcoin whitepaper addressed through the combination of a public transaction ledger and proof-of-work consensus."@en ;
    rdfs:label "Double-Spend Prevention"@en ;
    rdfs:subClassOf ngm:blockchain-security ;
    vc:contrastsWith ngm:double-spending ;
    vc:enables ngm:distributed-consensus ;
    vc:enables ngm:finality ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:byzantine-fault-tolerance ;
    vc:relatedTo ngm:nakamoto-consensus ;
    vc:slug "double-spend-prevention" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:consensus-mechanism ;
    vc:uses ngm:cryptographic-hash ;
    vc:uses ngm:proof-of-stake ;
    vc:uses ngm:proof-of-work .
ngm:double-spending a owl:Class ;
    rdfs:comment "Double spending is the fraudulent attempt to spend the same digital asset more than once by broadcasting conflicting transactions to different parts of a blockchain network before they are confirmed. It represents the fundamental security problem that consensus mechanisms are designed to prevent in distributed ledger systems."@en ;
    rdfs:label "Double Spending"@en ;
    rdfs:subClassOf ngm:bc-protocol-and-consensus ;
