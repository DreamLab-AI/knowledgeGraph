    vc:requires ngm:content-delivery-network,
        ngm:edge-computing ;
    vc:slug "tele-154-edge-computing-telepresence" ;
    vc:sourceDomain "metaverse" .

ngm:tele-157-predictive-tracking a owl:Class ;
    rdfs:label "TELE-157-predictive-tracking"@en ;
    rdfs:comment "Predictive tracking is the estimation of a user's future head or body pose from recent motion so that rendering can be aligned to where the user will be, reducing perceived latency."@en ;
