        ngm:intelligent-tutoring-system ;
    vc:requires ngm:educational-technology ;
    vc:slug "item-response-theory" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:personalised-learning ;
    vc:uses ngm:machine-learning .

ngm:json-data-interchange-format-serialisation a owl:Class ;
    rdfs:label "JSON Serialisation"@en ;
    rdfs:comment "JSON serialisation is the process of encoding in-memory data structures into JavaScript Object Notation text and decoding that text back into structured values. It provides a human-readable, language-independent representation for objects, arrays, numbers, strings and booleans. JSON serialisation is the default interchange format for web APIs, configuration files and message-passing between heterogeneous systems."@en ;
    rdfs:subClassOf ngm:data-management ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:node-based-diffusion-pipeline-interface-workflows,
        ngm:nostr-protocol ;
    vc:slug "json-serialisation" ;
    vc:sourceDomain "data" .

ngm:keypoint-detection a owl:Class ;
    rdfs:label "Keypoint Detection"@en ;
    rdfs:comment "Keypoint detection is a computer vision task that locates salient, semantically meaningful points in an image, such as body joints, facial landmarks or object corners. It outputs spatial coordinates, often with confidence scores, that can be tracked across frames or matched between views. Keypoint detection is a building block for pose estimation, image registration and structure-from-motion."@en ;
    rdfs:subClassOf ngm:computer-vision ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:image-segmentation,
        ngm:pose-estimation ;
    vc:slug "keypoint-detection" ;
    vc:sourceDomain "ai" .

ngm:kinematic-chain a owl:Class ;
    rdfs:label "Kinematic Chain"@en ;
    rdfs:comment "A kinematic chain is an assembly of rigid bodies (links) connected by joints that constrain their relative motion, forming the structural and mathematical basis for analysing and controlling the motion of mechanisms and robots. Open kinematic chains (serial manipulators) have one free end and exhibit simple forward kinematics but complex inverse kinematics; closed kinematic chains (parallel manipulators) have all links connected in loops, offering higher stiffness and load capacity. The Denavit-Hartenberg convention provides the canonical parameterisation for representing joint geometry and computing transformations along the chain, underpinning all modern robot programming and simulation systems."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:kinematic-element ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:end-effector ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:actuator ],
        ngm:kinematics ;
    vc:enables ngm:forward-kinematics,
        ngm:inverse-kinematics,
        ngm:motion-planning,
        ngm:trajectory-planning ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:actuator,
        ngm:end-effector,
        ngm:kinematic-element ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:differential-kinematics,
        ngm:manipulator-arm,
        ngm:robot-kinematics ;
    vc:slug "kinematic-chain" ;
    vc:sourceDomain "robotics" .

ngm:knowledge-retrieval a owl:Class ;
    rdfs:label "Knowledge Retrieval"@en ;
    rdfs:comment "Knowledge retrieval is the process of locating and returning relevant information from a knowledge source in response to a query or information need. It extends classical information retrieval by operating over structured knowledge, semantic representations and contextual relevance rather than keyword matching alone. It is a foundational capability for question answering, retrieval-augmented generation and conversational agents."@en ;
    rdfs:subClassOf ngm:information-retrieval ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:chatbots,
        ngm:semantic-search ;
    vc:slug "knowledge-retrieval" ;
    vc:sourceDomain "ai" .

ngm:kotlin a owl:Class ;
    rdfs:label "Kotlin"@en ;
    rdfs:comment "Kotlin is a statically-typed, cross-platform programming language developed by JetBrains that compiles to JVM bytecode, JavaScript, and native binaries via LLVM. It offers concise syntax, null safety enforced at the type level, first-class coroutine support, and seamless interoperability with Java, making it the preferred language for Android development and increasingly for server-side and multiplatform applications."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:jvm-runtime ],
        ngm:programming-language ;
    vc:bridgesTo ngm:distributed-collaboration,
        ngm:machine-learning ;
    vc:contrastsWith ngm:java,
        ngm:swift ;
    vc:enables ngm:cross-platform-compatibility ;
    vc:hasMaturity ngmi:maturity-established ;
