ngm:balancer a owl:Class ;
    rdfs:comment "Balancer is a decentralised automated market maker (AMM) protocol on Ethereum and compatible EVM chains that generalises the constant-product AMM model to support weighted multi-asset pools, where pool weights can be set arbitrarily (e.g., 80/20 or 60/20/20 distributions) rather than the 50/50 split of Uniswap. It functions simultaneously as a self-rebalancing portfolio manager, a liquidity provider, and a price sensor."@en ;
    rdfs:label "Balancer"@en ;
    rdfs:subClassOf ngm:automated-market-maker ;
