ngm:web-contracts a owl:Class ;
    rdfs:label "Web Contracts"@en ;
    rdfs:comment "Web Contracts is a transport-agnostic smart-contract system that runs verifiable agreements over plain web files instead of a global blockchain. It separates concerns into four layers: an immutable contract.json (rules in any language), a mutable state.json (a JCS-canonicalised, SHA-256 hash-chained sequence of states), a ledger.json (multi-currency balances), and a Trail that anchors the hash chain to Bitcoin via Block Trails for tamper evidence. Contracts declare effects (credit/debit/transfer) that an executor applies atomically; any verifier can replay the state chain from genesis, check the hashes, and confirm the Bitcoin anchoring, so cheating breaks the chain detectably. Identity is did:nostr and authentication is NIP-98 signed HTTP, which lets both humans (via NIP-07) and autonomous agents participate without global consensus or gas."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:ledger ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:state-machine-replication ],
        ngm:smart-contract ;
    vc:bridgesTo ngm:ai-agent,
        ngm:nostr,
        ngm:solid ;
    vc:contrastsWith ngm:ethereum,
        ngm:smart-contract-execution ;
    vc:dependsOn ngm:proof-of-publication,
        ngm:single-use-seals ;
    vc:enables ngm:automated-market-maker,
        ngm:escrow,
        ngm:micropayment ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:ledger,
        ngm:state-machine-replication ;
    vc:implements ngm:client-side-validation ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:l402-protocol,
        ngm:web-assembly ;
    vc:slug "web-contracts" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:block-trails,
        ngm:did-nostr,
        ngm:json-data-interchange-format,
        ngm:json-schema,
        ngm:sha-256 .

ngm:web-technology a owl:Class ;
    rdfs:label "Web Technology"@en ;
    rdfs:comment "Web Technology encompasses the protocols, standards, frameworks, and distributed infrastructure that enable the authoring, delivery, and interaction of resources on the World Wide Web and its decentralised successors. It spans the foundational internet protocols (HTTP/HTTPS, DNS, TLS), client-side and server-side execution environments (browsers, JavaScript runtimes, WebAssembly), and the emerging Web3 stack (content-addressed storage, blockchain naming, decentralised identity) that shifts data sovereignty from centralised operators to individual users. Together these layers define how information is addressed, transmitted, rendered, and secured across heterogeneous networked devices at planetary scale."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:dns ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:http ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:ens ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:ipfs ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:web3 ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:tls ],
        ngm:infra-computing-and-cloud ;
    skos:broader ngm:infra-computing-and-cloud ;
    vc:bridgesTo ngm:blockchain,
        ngm:machine-learning,
        ngm:spatial-computing ;
    vc:contrastsWith ngm:centralized-cloud,
        ngm:native-application ;
    vc:enables ngm:content-addressing,
        ngm:decentralised-identity,
        ngm:progressive-web-app,
        ngm:real-time-communication ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:css,
        ngm:ens,
        ngm:html,
        ngm:http,
        ngm:ipfs,
        ngm:javascript,
        ngm:web3,
        ngm:webassembly ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:content-delivery-network,
        ngm:web-browser,
        ngm:web-server ;
    vc:requires ngm:dns,
        ngm:tcp-ip,
        ngm:tls ;
    vc:slug "web-technology" ;
    vc:sourceDomain "infrastructure" ;
    vc:standardizedBy ngm:ietf,
        ngm:w3c,
        ngm:whatwg ;
    vc:uses ngm:decentralized-storage,
        ngm:graphql,
        ngm:rest-api,
        ngm:smart-contract .

ngm:web-xr a owl:Class ;
    rdfs:label "WebXR"@en ;
    rdfs:comment "WebXR is a W3C web standard and browser API that enables access to virtual reality and augmented reality hardware, exposing device pose tracking, controller input, reference spaces, and an XR-integrated render loop so that immersive spatial experiences can be delivered through ordinary URLs without native installation."@en ;
