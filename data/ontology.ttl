ngm:continuous-delivery a owl:Class ;
    rdfs:label "Continuous Delivery"@en ;
    rdfs:comment "Continuous Delivery is a software engineering discipline in which code changes are automatically built, tested and prepared for release to production so that the software is always in a deployable state. It extends continuous integration by adding automated release pipelines, environment promotion and deployment gates, allowing teams to ship changes rapidly, reliably and with low risk. Releases become routine, low-ceremony events rather than infrequent high-stakes operations."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:version-control ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:continuous-integration ],
        ngm:devops ;
    vc:dependsOn ngm:monitoring,
        ngm:testing ;
    vc:enables ngm:cloud-native,
        ngm:microservices ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:devops ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:infrastructure,
        ngm:software-engineering ;
    vc:requires ngm:continuous-integration,
        ngm:version-control ;
    vc:slug "continuous-delivery" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:observability,
        ngm:reliability-engineering,
        ngm:site-reliability-engineering ;
    vc:uses ngm:automation,
        ngm:git,
        ngm:kubernetes .

ngm:correspondent-banking a owl:Class ;
    rdfs:label "Correspondent Banking"@en ;
    rdfs:comment "Correspondent banking is an arrangement in which one bank (the correspondent) holds accounts and provides payment, settlement, trade finance, and liquidity services on behalf of another bank (the respondent) that lacks a direct presence or licence in a given jurisdiction or currency. The respondent bank maintains a nostro account at the correspondent and an equivalent vostro account on its own books, enabling cross-border value transfer without requiring every institution to maintain a full global branch network. This intermediated model underpins a substantial share of international wire transfers and documentary trade, but introduces multi-hop settlement chains, foreign-exchange conversion costs, and heightened anti-money-laundering compliance obligations, motivating ongoing efforts to reform or replace the model through ISO 20022, CBDC corridors, and distributed ledger payment rails."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:liquidity-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:know-your-customer ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:anti-money-laundering ],
        ngm:infra-network-and-comms ;
    skos:broader ngm:infra-network-and-comms ;
    vc:bridgesTo ngm:blockchain,
        ngm:distributed-ledger-technology ;
    vc:contrastsWith ngm:central-bank-digital-currency ;
    vc:enables ngm:cross-border-payments,
        ngm:foreign-exchange,
        ngm:trade-finance ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:financial-inclusion ;
    vc:requires ngm:anti-money-laundering,
        ngm:know-your-customer,
        ngm:liquidity-management ;
    vc:slug "correspondent-banking" ;
    vc:sourceDomain "finance" ;
    vc:standardizedBy ngm:basel-committee,
        ngm:financial-action-task-force ;
    vc:uses ngm:iso-20022,
        ngm:real-time-gross-settlement,
        ngm:swift .

ngm:data-science a owl:Class ;
    rdfs:label "Data Science"@en ;
    rdfs:comment "Data science is an interdisciplinary field that combines statistics, programming, and domain knowledge to extract insight and build predictive models from data. It spans the full lifecycle from data acquisition and cleaning through exploratory analysis, modelling, and communication of results. Data science underpins evidence-based decision-making and supplies the analytical foundation for applied machine learning."@en ;
