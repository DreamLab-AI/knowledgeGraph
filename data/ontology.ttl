ngm:blockchain-security a owl:Class ;
    rdfs:comment "Blockchain security is the multidisciplinary field concerned with protecting distributed ledger systems against attacks on their consensus mechanisms, smart contract logic, cryptographic primitives, and network topology, while preserving the properties of immutability, censorship resistance, and trustless operation. It encompasses threat modelling, formal verification of on-chain code, cryptographic auditing, and economic game-theory analysis to prevent incentive manipulation. The discipline extends across permissionless and permissioned blockchain architectures, addressing layer-specific attack surfaces from peer-to-peer networking through execution environments to cross-chain interoperability bridges."@en ;
    rdfs:label "Blockchain Security"@en ;
    rdfs:subClassOf ngm:cybersecurity ;
    rdfs:subClassOf _:r3523 ;
    rdfs:subClassOf _:r3524 ;
