    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:slug "model-transparency" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:monolithic-architecture a skos:Concept ;
    rdfs:label "Monolithic Architecture"@en .

ngm:multi-access-edge-computing a owl:Class ;
    rdfs:label "MultiAccessEdgeComputing"@en ;
    rdfs:comment "Multi-Access Edge Computing (MEC) is an ETSI-standardised architecture that places cloud-like compute and storage resources at the radio access network edge, enabling low-latency application hosting within milliseconds of end-user devices. It decouples latency-sensitive processing from centralised cloud data centres by co-locating compute with base stations and other network nodes."@en ;
    rdfs:subClassOf ngm:edge-computing ;
    vc:enables ngm:edge-ai,
        ngm:latency-aware-edge-ai ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:cloud-computing,
        ngm:fog-computing,
        ngm:latency ;
    vc:slug "multi-access-edge-computing" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:compute-resources,
        ngm:edge-orchestration .

ngm:network-analysis a owl:Class ;
    rdfs:label "Network Analysis"@en ;
    rdfs:comment "Network Analysis is the systematic study of complex systems modelled as graphs of nodes and edges, applying mathematical, statistical, and computational techniques to characterise topology, detect communities, identify influential vertices, and model dynamic processes such as information diffusion, contagion, and resilience. Rooted in graph theory, sociology, and statistical physics, it encompasses structural metrics including degree distribution, betweenness centrality, clustering coefficients, and average path length. Machine learning on graphs — principally through graph neural networks — has substantially extended the field beyond classical descriptive statistics toward predictive and generative capabilities. Applications span social network mapping, cybersecurity threat detection, supply chain vulnerability assessment, biological pathway modelling, and knowledge graph quality evaluation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:graph-database ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:link-prediction ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:community-detection ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-pipeline ],
        ngm:graph-theory ;
    vc:bridgesTo ngm:cybersecurity,
        ngm:epidemiological-modelling,
        ngm:supply-chain-resilience ;
    vc:dependsOn ngm:graph-theory,
        ngm:linear-algebra ;
    vc:enables ngm:anomaly-detection,
        ngm:influence-maximisation,
        ngm:knowledge-graph-construction,
        ngm:recommendation-system ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:centrality-measure,
        ngm:community-detection,
        ngm:graph-embedding,
        ngm:link-prediction ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:complex-systems,
        ngm:distributed-system,
        ngm:knowledge-management,
        ngm:linked-data,
        ngm:machine-learning ;
    vc:requires ngm:data-pipeline,
        ngm:graph-database ;
    vc:slug "network-analysis" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:graph-neural-network,
        ngm:knowledge-representation,
        ngm:matrix-factorisation,
        ngm:pagerank,
        ngm:social-network-graph .

ngm:network-communication a owl:Class ;
    rdfs:label "Network Communication"@en ;
    rdfs:comment "Network Communication is the transmission of data between computing nodes via shared or dedicated media, governed by layered protocol stacks that abstract physical signal propagation into reliable, addressable data exchange. It encompasses all paradigms of machine-to-machine data transfer including wired, wireless, and optical mediums organised according to reference models such as the OSI seven-layer model and TCP/IP suite."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:protocol-stack ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:network-layer ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:physical-layer ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:transport-layer ],
        ngm:communication-network ;
    vc:bridgesTo ngm:decentralised-network,
        ngm:edge-computing ;
    vc:contrastsWith ngm:circuit-switching ;
    vc:dependsOn ngm:network-infrastructure,
        ngm:transmission-medium ;
    vc:enables ngm:cloud-computing,
        ngm:distributed-computing,
        ngm:internet-of-things ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:data-link-layer,
        ngm:network-layer,
        ngm:physical-layer,
        ngm:protocol-stack,
        ngm:transport-layer ;
    vc:implements ngm:osi-model,
        ngm:tcp-ip-suite ;
    vc:qualityScore "0.85"^^xsd:float ;
    vc:relatedTo ngm:latency,
        ngm:network-architecture,
        ngm:network-protocol ;
    vc:requires ngm:ip-addressing,
        ngm:routing ;
    vc:slug "network-communication" ;
    vc:sourceDomain "infrastructure" ;
    vc:standardizedBy ngm:ieee-standards,
        ngm:ietf-rfc ;
    vc:supports ngm:network-security,
        ngm:quality-of-service ;
    vc:uses ngm:packet-switching,
        ngm:tls-encryption .

ngm:network-effects a owl:Class ;
    rdfs:label "Network Effects"@en ;
    rdfs:comment "Network effects describe the phenomenon whereby a product or service gains additional value for each existing user as the number of participants increases, creating a self-reinforcing growth dynamic. Direct network effects arise when users directly benefit from others on the same platform; indirect effects emerge when complementary products or services multiply with scale, creating cross-side externalities."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:interoperability ],
        ngm:positive-feedback ;
    vc:bridgesTo ngm:ai-data-accumulation,
        ngm:antitrust-regulation,
        ngm:blockchain-protocol ;
    vc:contrastsWith ngm:congestion-effects,
        ngm:diseconomies-of-scale ;
    vc:dependsOn ngm:platform-participation,
        ngm:switching-costs ;
    vc:enables ngm:data-flywheel,
        ngm:market-dominance,
        ngm:startup-ecosystem,
        ngm:technology-ecosystem ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:critical-mass,
        ngm:ecosystem-connectivity,
        ngm:mass-adoption,
        ngm:metcalfes-law,
        ngm:platform-economy,
        ngm:technology-adoption,
        ngm:winner-take-all ;
    vc:requires ngm:interoperability,
        ngm:user-base ;
    vc:slug "network-effects" ;
    vc:sourceDomain "finance" ;
    vc:supports ngm:lock-in,
        ngm:path-dependence .

ngm:network-synchronization a owl:Class ;
    rdfs:label "Network Synchronization"@en ;
    rdfs:comment "Network Synchronization is the process by which blockchain nodes align their local chain state with the canonical ledger through block propagation, header-first sync, and fork resolution protocols. It governs initial block download, peer discovery, and the ongoing receipt of new blocks and transactions via gossip, ensuring all honest participants converge on an identical view of the distributed ledger despite network partitions and latency."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:peer-to-peer-network ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gossip-protocol ],
        ngm:bc-protocol-and-consensus,
        ngm:blockchain-entity,
        ngm:consensus-protocol ;
    skos:broader ngm:bc-protocol-and-consensus ;
    vc:enables ngm:byzantine-fault-tolerance,
        ngm:consensus-mechanism ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:block-propagation,
        ngm:distributed-data-structure,
        ngm:eclipse-attack,
        ngm:network-topology,
        ngm:transaction-pool ;
    vc:requires ngm:gossip-protocol,
        ngm:peer-to-peer-network ;
    vc:slug "network-synchronization" ;
    vc:sourceDomain "blockchain" .

ngm:nft-ownership-proof a owl:Class ;
    rdfs:label "NFT Ownership Proof"@en ;
    rdfs:comment "Cryptographic mechanism by which blockchain state verifiably establishes that a specific wallet address holds title to a non-fungible token, enabling trustless transfer of digital asset ownership without intermediaries, underpinning digital rights management, access control, and provenance verification in NFT ecosystems."@en ;
    rdfs:subClassOf ngm:bc-token-and-asset ;
    skos:broader ngm:bc-token-and-asset ;
    vc:enables ngm:digital-asset ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:digital-rights-management,
        ngm:erc-721,
        ngm:nft,
        ngm:nft-marketplace,
        ngm:non-fungible-token-nft,
        ngm:royalty-distribution ;
    vc:slug "nft-ownership-proof" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:cryptographic-verification,
        ngm:digital-signature,
        ngm:knowledge-graph-publication-classifier-key,
        ngm:smart-contract .

ngm:nist-ai-risk-management-framework a owl:Class ;
    rdfs:label "NIST AI Risk Management Framework"@en ;
    rdfs:comment "The NIST AI Risk Management Framework (AI RMF 1.0), published by the National Institute of Standards and Technology in January 2023, is a voluntary, use-case-agnostic guidance document that helps organisations design, develop, deploy, and evaluate AI systems in a manner that is trustworthy and risk-informed. It organises AI risk management activities into four core functions — GOVERN, MAP, MEASURE, and MANAGE — and supports cross-functional integration of safety, reliability, fairness, privacy, and accountability considerations throughout the AI lifecycle. The framework is accompanied by a Playbook of suggested actions and is intended to complement existing risk management practices rather than replace sector-specific regulations or standards."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:stakeholder-engagement ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ai-risk-assessment ],
        ngm:ai-governance-framework ;
    vc:bridgesTo ngm:data-governance,
        ngm:machine-learning-operations ;
    vc:contrastsWith ngm:eu-ai-act,
        ngm:iso-iec-42001 ;
    vc:enables ngm:ai-transparency,
        ngm:algorithmic-accountability,
        ngm:responsible-ai,
        ngm:trustworthy-ai ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:ai-rmf-playbook,
        ngm:govern-function,
        ngm:manage-function,
        ngm:map-function,
        ngm:measure-function ;
    vc:implements ngm:ai-safety,
        ngm:risk-management ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:ai-incident-reporting,
        ngm:model-cards,
        ngm:nist-cybersecurity-framework ;
    vc:requires ngm:ai-lifecycle-management,
        ngm:ai-risk-assessment,
        ngm:stakeholder-engagement ;
    vc:slug "nist-ai-risk-management-framework" ;
    vc:sourceDomain "governance" ;
    vc:standardizedBy ngm:nist ;
    vc:supports ngm:ai-ethics,
        ngm:ai-fairness,
        ngm:explainable-ai,
        ngm:privacy-preserving-ai .

ngm:nominated-proof-of-stake a owl:Class ;
    rdfs:label "Nominated Proof of Stake"@en ;
    rdfs:comment "Nominated Proof of Stake (NPoS) is a consensus mechanism variant in which token holders nominate a set of validator candidates; an election algorithm selects the active validator set to maximise stake distribution while satisfying security constraints. Elected validators produce and finalise blocks, while nominators share both block rewards and slashing penalties, aligning incentives across the broader token holder community."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:validator-set ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:consensus-mechanism ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:validator-node ],
        ngm:bc-protocol-and-consensus,
        ngm:proof-of-stake ;
    skos:broader ngm:bc-protocol-and-consensus ;
    vc:contrastsWith ngm:pure-proof-of-stake ;
    vc:enables ngm:block-reward,
        ngm:blockchain-governance,
        ngm:deterministic-finality ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:blockchain-protocol,
        ngm:delegated-proof-of-stake,
        ngm:liquid-proof-of-stake,
        ngm:polkadot-parachains ;
    vc:requires ngm:consensus-mechanism,
        ngm:validator-node,
        ngm:validator-set ;
    vc:slug "nominated-proof-of-stake" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:consensus-algorithm .

ngm:npu a owl:Class ;
    rdfs:label "NPU"@en ;
    rdfs:comment "A Neural Processing Unit (NPU) is a dedicated silicon accelerator architected to execute artificial neural network operations — principally matrix multiplications and activation functions — with far greater energy efficiency and throughput than general-purpose CPUs or GPUs. NPUs are integrated into mobile SoCs, edge devices, and data-centre accelerator cards to enable low-latency AI inference on-device. They are increasingly central to deploying large language models, computer vision pipelines, and speech recognition at the edge without relying on cloud round-trips."@en ;
    rdfs:subClassOf ngm:ai-hardware,
        ngm:ai-infrastructure ;
    vc:enables ngm:deep-learning,
        ngm:edge-computing,
        ngm:inference ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:ai-hardware,
        ngm:ai-infrastructure ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:fpga,
        ngm:hardware-acceleration,
        ngm:tpu ;
    vc:slug "npu" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:computer-vision,
        ngm:natural-language-processing,
        ngm:speech-recognition ;
    vc:uses ngm:neural-network .

ngm:occlusion-culling a owl:Class ;
    rdfs:label "Occlusion Culling"@en ;
    rdfs:comment "Occlusion culling is a real-time rendering optimisation technique that determines which scene objects are hidden (occluded) by other geometry from the viewer's current viewpoint and discards them before issuing GPU draw calls. By preventing invisible geometry from traversing the vertex, rasterisation, and fragment shader stages, occlusion culling reduces overdraw and GPU workload, enabling complex scenes with high polygon counts to maintain interactive frame rates. It is a complementary technique to frustum culling, level-of-detail selection, and back-face culling within the broader visibility determination subsystem of a render pipeline. Implementations range from CPU-driven portal and cell systems, to hardware occlusion queries, to GPU-driven indirect rendering with hierarchical Z-buffer occlusion."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:scene-graph ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:bounding-volume-hierarchy ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:spatial-data-structure ],
        ngm:real-time-rendering ;
    vc:bridgesTo ngm:metaverse-infrastructure,
        ngm:spatial-computing ;
    vc:contrastsWith ngm:back-face-culling,
        ngm:frustum-culling,
        ngm:level-of-detail ;
    vc:dependsOn ngm:gpu-compute,
        ngm:rasterisation ;
    vc:enables ngm:digital-twin,
        ngm:extended-reality,
        ngm:open-world-game,
        ngm:virtual-environment ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:bounding-volume-hierarchy,
        ngm:hierarchical-z-buffer,
        ngm:occlusion-query,
        ngm:portal-culling ;
    vc:isPartOf ngm:render-pipeline,
        ngm:visibility-determination ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:collision-detection,
        ngm:draw-call-batching,
        ngm:indirect-rendering,
        ngm:spatial-partitioning ;
    vc:requires ngm:depth-buffer,
        ngm:scene-graph,
        ngm:spatial-data-structure ;
    vc:slug "occlusion-culling" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:bounding-volume,
        ngm:frustum-culling,
        ngm:potential-visibility-set .

ngm:on-device-inference a owl:Class ;
    rdfs:label "On-Device Inference"@en ;
    rdfs:comment "On-device inference is the execution of machine learning model forward passes entirely on the end-user's hardware — such as a smartphone, wearable, embedded controller, or edge server — without transmitting input data to a remote cloud backend. It requires models to be compressed, quantised, or distilled to fit within tight memory, compute, and power budgets while maintaining acceptable accuracy."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:hardware-acceleration ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:model-compression-for-edge ],
        ngm:edge-inference ;
    vc:bridgesTo ngm:augmented-reality,
        ngm:autonomous-vehicles,
        ngm:federated-learning ;
    vc:contrastsWith ngm:cloud-inference,
        ngm:server-side-inference ;
    vc:dependsOn ngm:knowledge-distillation-for-edge,
        ngm:mobile-gpu,
        ngm:npu ;
    vc:enables ngm:low-latency-ml,
        ngm:offline-ai,
        ngm:privacy-preserving-ai,
        ngm:real-time-inference ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:mlir,
        ngm:onnx ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:mlperf-mobile,
        ngm:speculative-decoding,
        ngm:tinyml ;
    vc:requires ngm:hardware-acceleration,
        ngm:model-compression-for-edge,
        ngm:post-training-quantisation,
        ngm:weight-pruning ;
    vc:slug "on-device-inference" ;
    vc:sourceDomain "machine-learning" ;
    vc:uses ngm:coreml,
        ngm:executorch,
        ngm:onnx-runtime,
        ngm:tensorflow-lite .

ngm:open-world-assumption a skos:Concept ;
    rdfs:label "Open World Assumption"@en .

ngm:openai-research-organisation a owl:Class ;
    rdfs:label "OpenAI Research Organisation"@en ;
    rdfs:comment "OpenAI is an American artificial intelligence research and deployment organisation founded in December 2015 with the stated mission of ensuring that artificial general intelligence (AGI) benefits all of humanity. Originally incorporated as a non-profit, it restructured into a capped-profit hybrid in 2019 to attract large-scale investment while retaining mission-oriented governance. OpenAI is responsible for the GPT series of large language models, the DALL-E image generation systems, the Codex code-generation model, the Whisper speech-recognition model, the Sora video-generation model, and the ChatGPT conversational interface, as well as foundational research in reinforcement learning from human feedback (RLHF) and AI alignment. Through its API platform and strategic partnership with Microsoft, it has become a central commercial and research force in the global AI industry."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:whisper ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:gpt ],
        ngm:ai-research-area ;
    skos:broader ngm:ai-research-area ;
    vc:bridgesTo ngm:ai-regulation,
        ngm:developer-ecosystem ;
    vc:contrastsWith ngm:anthropic,
        ngm:deepmind,
        ngm:meta-ai-research ;
    vc:dependsOn ngm:compute-infrastructure,
        ngm:large-scale-pretrained-foundation-model,
        ngm:microsoft-azure ;
    vc:enables ngm:ai-alignment,
        ngm:generative-ai,
        ngm:large-language-models,
        ngm:model-context-protocol ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:chatgpt,
        ngm:codex,
        ngm:dall-e,
        ngm:gpt,
        ngm:sora,
        ngm:whisper ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:ai-ethics,
        ngm:ai-research-organisation,
        ngm:open-source-ai,
        ngm:responsible-ai ;
    vc:slug "openai-research-organisation" ;
    vc:sourceDomain "ai" ;
    vc:supports ngm:ai-governance,
        ngm:ai-safety-research,
        ngm:model-evaluation-results ;
    vc:uses ngm:deep-learning,
        ngm:reinforcement-learning-from-human-feedback,
        ngm:training-hardware,
        ngm:transformer .

ngm:passwordless-authentication a owl:Class ;
    rdfs:label "Passwordless Authentication"@en ;
    rdfs:comment "Passwordless Authentication encompasses identity verification mechanisms that prove user identity without requiring the user to memorise or enter a shared-secret password. Instead, authentication relies on possession of a hardware token or platform authenticator, biometric characteristics, cryptographic key pairs, or one-time codes delivered through a trusted out-of-band channel. The FIDO2 standard — comprising the W3C WebAuthn specification and the FIDO Alliance CTAP protocol — provides the primary open standard for passkey-based passwordless authentication, binding credentials to device hardware and enabling phishing-resistant login flows. By eliminating the shared secret as an authentication factor, passwordless schemes structurally defeat credential-stuffing, password-spray, and phishing attack classes."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:secure-enclave ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:identity-proofing ],
        ngm:authentication-mechanism ;
    vc:bridgesTo ngm:decentralised-identity,
        ngm:verifiable-credentials ;
    vc:contrastsWith ngm:knowledge-based-authentication,
        ngm:password-based-authentication ;
    vc:enables ngm:digital-identity-management,
        ngm:phishing-resistant-authentication,
        ngm:zero-trust-architecture ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:digital-identity-wallet,
        ngm:multi-factor-authentication,
        ngm:oauth-2-0,
        ngm:openid-connect,
        ngm:single-sign-on ;
    vc:requires ngm:identity-proofing,
        ngm:secure-enclave,
        ngm:trusted-platform-module ;
    vc:slug "passwordless-authentication" ;
    vc:sourceDomain "security" ;
    vc:standardizedBy ngm:fido-alliance,
        ngm:fido2,
        ngm:webauthn ;
    vc:supports ngm:access-control,
        ngm:identity-federation ;
    vc:uses ngm:biometric-authentication,
        ngm:challenge-response-protocol,
        ngm:digital-signature,
        ngm:hardware-security-key,
        ngm:public-key-cryptography .

ngm:payment-infrastructure a owl:Class ;
    rdfs:label "Payment Infrastructure"@en ;
    rdfs:comment "Payment infrastructure is the aggregate of networks, protocols, clearing houses, settlement systems, and regulatory frameworks that enable the transfer of monetary value between parties. It spans card networks, interbank messaging (SWIFT, ISO 20022), real-time gross settlement (RTGS) systems, and emerging digital-asset rails including stablecoins and central bank digital currencies. The infrastructure defines latency, finality, cost, and access characteristics that shape the global economy."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:payment-channel-network ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:payment-processor ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:payment-system ],
        ngm:financial-infrastructure ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:payment-channel-network,
        ngm:payment-processor,
        ngm:payment-system ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:cbdc-infrastructure,
        ngm:lightning-network,
        ngm:stablecoin ;
    vc:slug "payment-infrastructure" ;
    vc:sourceDomain "blockchain" .

ngm:personal-data-store a owl:Class ;
    rdfs:label "Personal Data Store"@en ;
    rdfs:comment "A Personal Data Store (PDS) is a user-controlled software system or vault that aggregates, stores, and selectively discloses an individual's personal data — including identity attributes, health records, behavioural logs, and transaction histories — under the direct control of the data subject. It enforces consent-based access through verifiable credentials and cryptographic authorisation mechanisms, enabling fine-grained, revocable sharing with third-party services. PDSs embody the principles of data sovereignty and privacy-by-design, decoupling data custody from service providers and restoring ownership to individuals. They serve as a foundational layer for interoperable digital identity ecosystems, federated personal AI assistants, and regulatory compliance with frameworks such as GDPR and CCPA."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:authorisation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-portability ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:authentication ],
        ngm:data-management ;
    vc:bridgesTo ngm:decentralised-autonomous-organisation,
        ngm:federated-machine-learning ;
    vc:contrastsWith ngm:centralised-data-silo,
        ngm:data-broker ;
    vc:enables ngm:data-marketplace,
        ngm:federated-identity,
        ngm:personal-ai-assistant,
        ngm:selective-disclosure ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:data-governance,
        ngm:digital-identity,
        ngm:personal-data,
        ngm:zero-knowledge-proof ;
    vc:requires ngm:authentication,
        ngm:authorisation,
        ngm:data-portability ;
    vc:slug "personal-data-store" ;
    vc:sourceDomain "data" ;
    vc:standardizedBy ngm:gdpr,
        ngm:w3c-did-core,
        ngm:w3c-solid ;
    vc:supports ngm:consent-management,
        ngm:data-sovereignty,
        ngm:privacy-by-design,
        ngm:self-sovereign-identity ;
    vc:uses ngm:access-control,
        ngm:decentralized-identifiers,
        ngm:end-to-end-encryption,
        ngm:linked-data,
        ngm:verifiable-credentials .

ngm:platform-service a owl:Class ;
    rdfs:label "Platform Service"@en ;
    rdfs:comment "A managed, API-exposed capability unit delivered by a cloud or middleware platform that provides reusable building blocks—such as authentication, storage, messaging, compute, or rendering—to applications built atop that platform. Platform services abstract the operational complexity of underlying infrastructure by encapsulating it behind stable, versioned contracts, enabling developers to compose higher-order application features without provisioning or administering raw resources. They are the foundational unit of Platform-as-a-Service (PaaS) and are central to cloud-native, microservices, and distributed systems architectures. At scale, platform services enforce tenancy boundaries, SLA guarantees, and metered billing, transforming infrastructure capabilities into economically composable software products."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:notification-system ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:authentication-service ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:object-storage ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:api-gateway ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:message-queue ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:service-mesh ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:identity-and-access-management ],
        ngm:infra-computing-and-cloud ;
    skos:broader ngm:infra-computing-and-cloud ;
    vc:bridgesTo ngm:ai-inference-service,
        ngm:spatial-computing ;
    vc:contrastsWith ngm:infrastructure-as-a-service,
        ngm:software-as-a-service ;
    vc:dependsOn ngm:container-orchestration,
        ngm:infrastructure-as-code ;
    vc:enables ngm:cloud-native-applications,
        ngm:digital-twin,
        ngm:metaverse-platform,
        ngm:multi-tenant-architecture ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:api-gateway,
        ngm:authentication-service,
        ngm:message-queue,
        ngm:notification-system,
        ngm:object-storage,
        ngm:service-mesh ;
    vc:implements ngm:event-driven-architecture,
        ngm:microservices-architecture ;
    vc:isPartOf ngm:cloud-computing,
        ngm:platform-as-a-service ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:edge-computing,
        ngm:serverless-computing ;
    vc:requires ngm:api-design,
        ngm:identity-and-access-management,
        ngm:service-level-agreement ;
    vc:slug "platform-service" ;
    vc:sourceDomain "infrastructure" ;
    vc:standardizedBy ngm:cloud-native-computing-foundation,
        ngm:openapi-specification ;
    vc:supports ngm:horizontal-scaling,
        ngm:observability ;
    vc:uses ngm:grpc,
        ngm:oauth2,
        ngm:restful-api .

ngm:policy-decision-point a owl:Class ;
    rdfs:label "Policy Decision Point"@en ;
    rdfs:comment "A Policy Decision Point (PDP) is the logical component in an attribute-based or policy-based access control architecture that evaluates access requests against a set of authorisation policies and returns a permit, deny, or indeterminate decision. The PDP receives a request context—including subject attributes, resource attributes, action, and environment conditions—from a Policy Enforcement Point (PEP), retrieves applicable policies from a Policy Information Point (PIP) or Policy Administration Point (PAP), and applies the XACML combining algorithms or equivalent logic to reach a binding decision. PDPs are the computational core of fine-grained, dynamic authorisation systems used in zero-trust security architectures, identity federation, API gateways, and cloud IAM platforms."@en ;
    rdfs:subClassOf ngm:access-control-system ;
    vc:dependsOn ngm:authentication,
        ngm:cryptographic-verification ;
    vc:enables ngm:policy-framework,
        ngm:zero-trust-architecture ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:access-control,
        ngm:policy-enforcement,
        ngm:policy-enforcement-point,
        ngm:policy-engine ;
    vc:slug "policy-decision-point" ;
    vc:sourceDomain "security" .

ngm:policy-framework a owl:Class ;
    rdfs:label "Policy Framework"@en ;
    rdfs:comment "A policy framework is a structured set of principles, rules, standards, and processes established by a government body, standards organisation, or institution to guide decision-making, regulate behaviour, and ensure accountability within a defined domain. It translates high-level objectives — such as safety, fairness, or interoperability — into operational requirements and compliance mechanisms. Policy frameworks provide the normative scaffolding that enables coordinated action across organisations and jurisdictions."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:conformity-assessment ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:enforcement-mechanism ],
        ngm:compliance-framework ;
    vc:bridgesTo ngm:ai-safety,
        ngm:interoperability-standard ;
    vc:contrastsWith ngm:co-regulation,
        ngm:self-regulation ;
    vc:enables ngm:ai-accountability,
        ngm:human-oversight,
        ngm:regulatory-compliance,
        ngm:regulatory-equivalence,
        ngm:responsible-ai ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:codes-of-practice,
        ngm:conformity-assessment,
        ngm:enforcement-mechanism,
        ngm:risk-classification ;
    vc:implements ngm:ai-governance-framework,
        ngm:data-governance,
        ngm:trust-framework ;
    vc:isPartOf ngm:governance-ecosystem,
        ngm:regulatory-regime ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:algorithmic-accountability,
        ngm:eu-ai-act-regulatory-instrument,
        ngm:gdpr,
        ngm:nist-ai-rmf ;
    vc:requires ngm:impact-assessment,
        ngm:stakeholder-consultation ;
    vc:slug "policy-framework" ;
    vc:sourceDomain "governance" ;
    vc:standardizedBy ngm:iso-iec-jtc1-sc42,
        ngm:iso-standards,
        ngm:nist .

ngm:privacy-controls a owl:Class ;
    rdfs:label "Privacy Controls"@en ;
    rdfs:comment "Privacy Controls are the technical, organisational, and procedural mechanisms that organisations deploy to protect individuals' personal data from unauthorised access, misuse, or disclosure, and to provide data subjects with meaningful agency over how their information is collected and used. They encompass access restrictions, anonymisation and pseudonymisation techniques, consent management interfaces, data minimisation policies, encryption, and privacy impact assessment processes. Effective privacy controls implement privacy by design principles, embedding data protection into systems from inception rather than applying it retrospectively. Regulatory frameworks such as GDPR mandate specific control categories and assign accountability for their implementation."@en ;
    rdfs:subClassOf ngm:privacy ;
    vc:enables ngm:compliance-framework,
        ngm:privacy-architecture,
        ngm:privacy-impact-assessment ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:consent-management,
        ngm:data-protection,
        ngm:gdpr,
        ngm:privacy-by-design ;
    vc:slug "privacy-controls" ;
    vc:sourceDomain "security" ;
    vc:uses ngm:data-minimisation,
        ngm:differential-privacy,
        ngm:encryption .

ngm:privacy-preserving-data-sharing a owl:Class ;
    rdfs:label "Privacy Preserving Data Sharing"@en ;
    rdfs:comment "Privacy Preserving Data Sharing (PPDS) encompasses the set of cryptographic, statistical, and algorithmic techniques that allow multiple parties to exchange, query, or jointly analyse data without disclosing raw sensitive records. Core mechanisms include differential privacy, secure multi-party computation, homomorphic encryption, federated learning, and synthetic data generation, each providing formal or empirical guarantees that individual-level information cannot be inferred. PPDS enables collaborative analytics, AI model training, and regulatory reporting across organisational and jurisdictional boundaries while satisfying privacy regulations such as GDPR and HIPAA. It is a foundational discipline at the intersection of cryptography, distributed systems, and machine learning, increasingly deployed in healthcare, finance, and cross-industry data-sharing consortia."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:homomorphic-encryption ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:federated-learning ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:synthetic-data-generation ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:secure-multi-party-computation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptographic-protocols ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:differential-privacy ],
        ngm:data-sharing ;
    vc:bridgesTo ngm:blockchain-data-sharing,
        ngm:federated-machine-learning ;
    vc:contrastsWith ngm:data-anonymisation,
        ngm:data-masking ;
    vc:dependsOn ngm:trusted-execution-environments,
        ngm:zero-knowledge-proofs ;
    vc:enables ngm:collaborative-analytics,
        ngm:cross-organisational-ai-training,
        ngm:data-clean-rooms ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:differential-privacy,
        ngm:federated-learning,
        ngm:homomorphic-encryption,
        ngm:secure-multi-party-computation,
        ngm:synthetic-data-generation ;
    vc:implements ngm:gdpr,
        ngm:hipaa ;
    vc:isPartOf ngm:data-governance ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:consent-management,
        ngm:data-minimisation,
        ngm:information-security ;
    vc:requires ngm:cryptographic-protocols,
        ngm:trust-models ;
    vc:slug "privacy-preserving-data-sharing" ;
    vc:sourceDomain "data" ;
    vc:supports ngm:data-monetisation,
        ngm:regulatory-compliance ;
    vc:uses ngm:access-control,
        ngm:noise-mechanisms .

ngm:privileged-access-management a owl:Class ;
    rdfs:label "Privileged Access Management"@en ;
    rdfs:comment "Privileged Access Management (PAM) is a cybersecurity discipline and category of technology solutions that controls, monitors, and audits the access rights of users, accounts, and systems with elevated permissions in IT environments. PAM encompasses vaulting of privileged credentials, just-in-time access provisioning, session recording, and anomaly detection for privileged sessions. It addresses the risk that compromised administrator accounts represent the most damaging attack vector in enterprise breaches. PAM solutions enforce the principle of least privilege and provide forensic audit trails required by compliance frameworks such as ISO/IEC 27001 and SOX."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:digital-certificate ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:role-based-access-control ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:multi-factor-authentication ],
        ngm:identity-and-access-management ;
    vc:bridgesTo ngm:cloud-identity-and-access-management,
        ngm:devops-secrets-management ;
    vc:contrastsWith ngm:discretionary-access-control,
        ngm:shared-account ;
    vc:dependsOn ngm:access-control,
        ngm:identity-management,
        ngm:public-key-infrastructure ;
    vc:enables ngm:compliance-audit-trail,
        ngm:forensic-audit,
        ngm:least-privilege-principle ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:credential-vault,
        ngm:just-in-time-access,
        ngm:session-recording ;
    vc:isPartOf ngm:identity-and-access-management,
        ngm:information-security ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:endpoint-detection-and-response,
        ngm:network-access-control ;
    vc:requires ngm:digital-certificate,
        ngm:multi-factor-authentication,
        ngm:role-based-access-control ;
    vc:slug "privileged-access-management" ;
    vc:sourceDomain "security" ;
    vc:supports ngm:iso-iec-27001,
        ngm:sox-compliance,
        ngm:zero-trust-architecture ;
    vc:uses ngm:behavioural-analytics,
        ngm:security-information-and-event-management,
        ngm:session-management .

ngm:probabilistic-inference a owl:Class ;
    rdfs:label "Probabilistic Inference"@en ;
    rdfs:comment "Probabilistic inference is the computation of the probability of unknown quantities given observed evidence within a probabilistic model. It produces posterior distributions used for prediction and decision making under uncertainty."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:variational-inference ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:likelihood-function ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:prior-distribution ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:probabilistic-model ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:markov-chain-monte-carlo ],
        ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:bridgesTo ngm:causal-inference,
        ngm:knowledge-representation ;
    vc:contrastsWith ngm:frequentist-inference,
        ngm:point-estimation ;
    vc:dependsOn ngm:bayes-theorem,
        ngm:graphical-model,
        ngm:probability-theory ;
    vc:enables ngm:bayesian-decision-theory,
        ngm:predictive-modelling,
        ngm:uncertainty-quantification ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:belief-propagation,
        ngm:expectation-propagation,
        ngm:markov-chain-monte-carlo,
        ngm:variational-inference ;
    vc:implements ngm:bayesian-inference,
        ngm:maximum-a-posteriori-estimation ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:information-theory,
        ngm:latent-variable-model ;
    vc:requires ngm:likelihood-function,
        ngm:prior-distribution,
        ngm:probabilistic-model ;
    vc:slug "probabilistic-inference" ;
    vc:sourceDomain "machine-learning" ;
    vc:supports ngm:anomaly-detection,
        ngm:bayesian-deep-learning,
        ngm:reinforcement-learning ;
    vc:uses ngm:marginalisation,
        ngm:monte-carlo-methods,
        ngm:posterior-distribution .

ngm:procedural-animation a owl:Class ;
    rdfs:label "Procedural Animation"@en ;
    rdfs:comment "Procedural Animation is a computational technique in which character and object motion is synthesised algorithmically at runtime — through rules, mathematical functions, and physical simulation — rather than played back from pre-authored keyframe sequences. It encompasses inverse kinematics solvers, physics-based secondary motion, constraint-driven posing, and behaviour-tree-driven locomotion, allowing virtual agents to adapt dynamically to unpredictable environments. Widely used in games, virtual reality, robotics control, and digital twins, procedural animation replaces or augments traditional hand-keyed or motion-captured data with generative motion pipelines. The approach scales cheaply across large numbers of unique characters and environmental configurations that would be prohibitively expensive to author by hand."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:scene-graph ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:collision-detection ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:forward-kinematics ],
        ngm:animation-technique ;
    vc:bridgesTo ngm:reinforcement-learning,
        ngm:robot-locomotion ;
    vc:contrastsWith ngm:keyframe-animation,
        ngm:motion-capture ;
    vc:enables ngm:avatar-behavior,
        ngm:crowd-simulation,
        ngm:digital-twin,
        ngm:non-player-character,
        ngm:real-time-rendering ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:animation-retargeting,
        ngm:motion-matching,
        ngm:ragdoll-physics,
        ngm:secondary-motion ;
    vc:requires ngm:collision-detection,
        ngm:forward-kinematics,
        ngm:scene-graph ;
    vc:slug "procedural-animation" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:behaviour-tree,
        ngm:inverse-kinematics,
        ngm:noise-function,
        ngm:physics-engine,
        ngm:physics-simulation,
        ngm:skeletal-mesh .

ngm:prompt-template a owl:Class ;
    rdfs:label "Prompt Template"@en ;
    rdfs:comment "A Prompt Template is a reusable, parameterised text structure that combines static instructional scaffolding with dynamic variable slots to produce consistent, well-formed inputs for large language models. Templates encode best-practice prompt engineering patterns — role declarations, task specifications, output format constraints, and chain-of-thought scaffolding — in a form that can be instantiated with runtime values such as user queries, document snippets, or API responses. They are the primary unit of composition in LLM orchestration frameworks such as LangChain, LlamaIndex, and DSPy, and they serve as version-controlled artefacts that enable systematic A/B testing of prompt variations. Effective prompt templates balance specificity (providing enough context to constrain model behaviour) with generality (accommodating the full range of valid inputs)."@en ;
    rdfs:subClassOf ngm:prompt-engineering ;
    vc:contrastsWith ngm:soft-prompt-embedding ;
    vc:enables ngm:agentic-workflow,
        ngm:retrieval-augmented-generation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:chain-of-thought,
        ngm:instruction-tuning,
        ngm:large-language-models,
        ngm:system-prompt ;
    vc:slug "prompt-template" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:context-window,
        ngm:instruction-following .

ngm:prompt-tuning a owl:Class ;
    rdfs:label "Prompt Tuning"@en ;
    rdfs:comment "Prompt Tuning is a parameter-efficient fine-tuning method that learns continuous soft prompt embeddings prepended to the input sequence, whilst keeping all pre-trained model weights frozen. It optimises task-specific prompts in the embedding space using gradient descent, requiring as little as 0.01% of model parameters and enabling efficient multi-task deployment from a single frozen backbone."@en ;
    rdfs:subClassOf ngm:parameter-efficient-fine-tuning ;
    vc:bridgesTo ngm:in-context-learning,
        ngm:prompt-engineering ;
    vc:contrastsWith ngm:adapter-modules,
        ngm:full-fine-tuning,
        ngm:lora,
        ngm:prefix-tuning ;
    vc:dependsOn ngm:embedding-space,
        ngm:transformer-architecture ;
    vc:enables ngm:few-shot-learning,
        ngm:multi-task-model-deployment ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:gradient-descent-optimisation,
        ngm:soft-prompt-embeddings ;
    vc:isPartOf ngm:parameter-efficient-fine-tuning,
        ngm:transfer-learning ;
    vc:qualityScore "0.68"^^xsd:float ;
    vc:relatedTo ngm:chain-of-thought-prompting,
        ngm:fine-tuning,
        ngm:foundation-models ;
    vc:requires ngm:pre-trained-language-model,
        ngm:task-specific-labelled-dataset ;
    vc:slug "prompt-tuning" ;
    vc:sourceDomain "machine-learning" ;
    vc:supports ngm:instruction-tuning,
        ngm:retrieval-augmented-generation ;
    vc:uses ngm:backpropagation,
        ngm:language-modeling,
        ngm:natural-language-processing .

ngm:python-runtime a owl:Class ;
    rdfs:label "Python Runtime"@en ;
    rdfs:comment "The Python runtime is the interpreter process and associated standard library environment responsible for compiling Python source to bytecode, executing that bytecode in a virtual machine, managing heap memory through reference-counting combined with a cyclic garbage collector, and resolving module imports via the package search path. CPython—the canonical C-language reference implementation—uses a Global Interpreter Lock (GIL) that serialises bytecode execution across threads, making multi-processing the preferred concurrency model for CPU-bound workloads. The Python runtime underpins the dominant AI/ML toolchain including PyTorch, TensorFlow, and the Hugging Face ecosystem, making its performance characteristics, extension mechanisms, and packaging conventions central concerns for AI infrastructure engineering."@en ;
    rdfs:subClassOf ngm:ai-infrastructure ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:runtime-environment ;
    vc:slug "python-runtime" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:large-language-models,
        ngm:model-training ;
    vc:uses ngm:machine-learning-discipline-framework,
        ngm:python .

ngm:random-number-generator a owl:Class ;
    rdfs:label "Random Number Generator"@en ;
    rdfs:comment "A random number generator (RNG) produces sequences of numbers that lack predictable pattern, either through deterministic algorithms seeded from an initial state (pseudo-random) or from physical entropy sources (true random). RNGs are essential to stochastic sampling, Monte Carlo methods, simulation, and cryptographic key generation. Quality is judged by statistical uniformity, period length, and, for security uses, unpredictability."@en ;
    rdfs:subClassOf ngm:software-development ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:particle-filter,
        ngm:sampling ;
    vc:slug "random-number-generator" ;
    vc:sourceDomain "infrastructure" .

ngm:rasterisation a skos:Concept ;
    rdfs:label "Rasterisation"@en .

ngm:rb-0049-motion-planning a owl:Class ;
    rdfs:label "rb 0049 motion planning"@en ;
    rdfs:comment "Motion planning is the computational process of determining a sequence of valid robot configurations or control inputs that moves a robot from an initial state to a goal state while satisfying constraints such as obstacle avoidance, joint limits, and dynamic feasibility. It bridges high-level task specification and low-level actuation, encompassing path planning, trajectory optimisation, and task-and-motion planning (TAMP). Sampling-based methods (RRT, PRM) and optimisation-based approaches are the dominant paradigms, increasingly augmented by learning-based techniques for dynamic and uncertain environments."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:rb-0051-trajectory-planning ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:rb-0052-collision-avoidance ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:path-planning ],
        ngm:robo-navigation-and-planning ;
    skos:broader ngm:robo-navigation-and-planning ;
    vc:enables ngm:rb-0103-collaborative-operation ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:path-planning,
        ngm:rb-0051-trajectory-planning,
        ngm:rb-0052-collision-avoidance ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:autonomous-navigation,
        ngm:obstacle-avoidance,
        ngm:task-planning ;
    vc:slug "rb-0049-motion-planning" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:rb-0021-robot-kinematics,
        ngm:rrt-algorithm .

ngm:rb-0069-lidar a owl:Class ;
    rdfs:label "rb 0069 lidar"@en ;
    rdfs:comment "A remote sensing technology that measures distances by emitting laser pulses and calculating time-of-flight to generate precise three-dimensional point clouds of the surrounding environment, enabling robots and autonomous vehicles to perceive and navigate physical space with centimetre-level accu..."@en ;
    rdfs:subClassOf ngm:robo-perception ;
    skos:broader ngm:robo-perception ;
    vc:bridgesTo ngm:lidar ;
    vc:enables ngm:3-d-mapping,
        ngm:obstacle-detection,
        ngm:simultaneous-localisation-and-mapping ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:relatedTo ngm:autonomous-navigation,
        ngm:point-cloud,
        ngm:sensor-fusion,
        ngm:slam ;
    vc:slug "rb-0069-lidar" ;
    vc:sourceDomain "robotics" .

ngm:rb-0092-protective-stop a owl:Class ;
    rdfs:label "rb 0092 protective stop"@en ;
    rdfs:comment "A protective stop is a safety-initiated cessation of robot motion that halts all hazardous movement when a safety function is triggered, without necessarily cutting power to the drive system. Unlike an emergency stop, a protective stop permits automatic restart once the triggering condition is resolved, making it a standard mechanism in collaborative robot cells operating under ISO 10218 and ISO/TS 15066. It is fundamental to speed-and-separation monitoring and power-and-force-limiting safety strategies."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:risk-assessment ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:functional-safety ],
        ngm:robo-safety-and-standards,
        ngm:robot-safety ;
    skos:broader ngm:robo-safety-and-standards ;
    vc:enables ngm:collaborative-systems-modality-operation,
        ngm:human-robot-interaction ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:collaborative-systems-modality-robot,
        ngm:robot-safety ;
    vc:requires ngm:functional-safety,
        ngm:risk-assessment ;
    vc:slug "rb-0092-protective-stop" ;
    vc:sourceDomain "robotics" ;
    vc:standardizedBy ngm:iso-10218,
        ngm:iso-ts-15066 .

ngm:rb-0095-safety-zone a owl:Class ;
    rdfs:label "rb 0095 safety zone"@en ;
    rdfs:comment "A safety zone is a defined spatial region around a robot or autonomous system within which human presence or other objects trigger protective actions such as speed reduction, monitored stops, or full emergency stops. Safety zones are configured and monitored via safeguarding devices and are a central mechanism for achieving collaborative and safe robot operation in accordance with ISO 10218 and ISO/TS 15066."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:rb-0087-safety-standard ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:rb-0089-risk-assessment ],
        ngm:robo-safety-and-standards,
        ngm:robot-safety ;
    skos:broader ngm:robo-safety-and-standards ;
    vc:dependsOn ngm:functional-safety,
        ngm:rb-0075-range-finder ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:rb-0091-safety-rated-monitored-stop,
        ngm:rb-0092-protective-stop,
        ngm:rb-0093-speed-limitation,
        ngm:rb-0096-safeguarding ;
    vc:requires ngm:rb-0087-safety-standard,
        ngm:rb-0089-risk-assessment ;
    vc:slug "rb-0095-safety-zone" ;
    vc:sourceDomain "robotics" .

