ngm:back-translation a owl:Class ;
    rdfs:label "Back-Translation"@en ;
    rdfs:comment "Back-translation is a data augmentation and quality-assurance technique in machine translation where text translated into a target language is translated back into the source language. As an augmentation method, monolingual target-language data is translated into the source language to create synthetic parallel pairs that improve translation models. As a QA method, the round-trip output is compared with the original to detect meaning drift."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:sequence-to-sequence-model ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:parallel-corpus ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:beam-search ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:neural-machine-translation ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:synthetic-data ],
        ngm:data-augmentation,
        ngm:natural-language-processing ;
    vc:contrastsWith ngm:forward-translation,
        ngm:knowledge-distillation,
        ngm:round-trip-translation ;
    vc:dependsOn ngm:attention-mechanism,
        ngm:encoder-decoder-architecture,
        ngm:neural-machine-translation,
        ngm:transformer-architecture ;
    vc:enables ngm:domain-adaptation,
        ngm:low-resource-language,
        ngm:multilingual-model,
        ngm:semi-supervised-learning,
        ngm:translation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:iterative-training,
        ngm:monolingual-data,
        ngm:noise-injection,
        ngm:parallel-corpus,
        ngm:quality-estimation,
        ngm:synthetic-data ;
    vc:implements ngm:data-augmentation,
        ngm:self-training,
        ngm:semi-supervised-learning ;
    vc:qualityScore "0.92"^^xsd:float ;
    vc:relatedTo ngm:data-augmentation-strategies,
        ngm:multilingual-model,
        ngm:parallel-corpus,
        ngm:text-generation ;
    vc:requires ngm:beam-search,
        ngm:monolingual-data,
        ngm:neural-machine-translation,
        ngm:sequence-to-sequence-model ;
    vc:slug "back-translation" ;
    vc:sourceDomain "ai" ;
    vc:standardizedBy ngm:wmt-benchmark ;
    vc:supports ngm:curriculum-learning,
        ngm:machine-translation,
