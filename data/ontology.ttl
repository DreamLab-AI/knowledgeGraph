# Virtual Economy Domain
spatial-computing:VirtualEconomyDomain rdf:type owl:Class ;
    rdfs:subClassOf spatial-computing:DigitalEconomy ;
    rdfs:label "Virtual Economy Domain"@en ;
    rdfs:comment "The conceptual and technical framework encompassing all economic activities within metaverse environments, including NFT marketplaces, virtual real estate trading, digital goods commerce, cryptocurrency transactions, and tokenized asset exchanges that operate through blockchain-verified ownership and smart contract automation."@en ;
    skos:prefLabel "Virtual Economy Domain"@en ;
