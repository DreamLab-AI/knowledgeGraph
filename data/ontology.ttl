        ngm:signal-processing-unit ;
    vc:slug "haptics" ;
    vc:sourceDomain "spatial-computing" .

ngm:healthcare-ai a owl:Class ;
    rdfs:label "Healthcare AI"@en ;
    rdfs:comment "Healthcare AI is the systematic application of machine learning, natural language processing, computer vision, and large language models to clinical and operational problems in healthcare—including diagnostic imaging analysis, clinical decision support, drug discovery, genomic interpretation, and patient outcome prediction. The field operates under stringent regulatory oversight (FDA, MHRA, MDR) requiring prospective clinical validation, post-market surveillance, and clear human-AI workflow integration to ensure patient safety. Fairness, explainability, and bias auditing are central concerns given the high-stakes nature of clinical decisions."@en ;
    rdfs:subClassOf ngm:ai-application ;
    skos:broader ngm:ai-application ;
    vc:enables ngm:clinical-decision-support,
        ngm:drug-discovery ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:pathology-ai,
        ngm:radiology-ai ;
    vc:slug "healthcare-ai" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:deep-learning,
        ngm:medical-imaging .

ngm:high-performance-computing a owl:Class ;
    rdfs:label "High-Performance Computing"@en ;
    rdfs:comment "High-Performance Computing (HPC) refers to the use of aggregated computational resources — clusters, supercomputers, and massively parallel systems — to solve problems requiring sustained compute throughput, memory bandwidth, or I/O rates far beyond those achievable on commodity servers. HPC systems combine specialised processors (CPUs, GPUs, FPGAs, TPUs), high-speed interconnects (InfiniBand, NVLink), parallel file systems, and workload-management software to execute scientific simulations, large-scale machine learning training, genomics, climate modelling, and computational fluid dynamics at peta- or exascale performance."@en ;
    rdfs:subClassOf ngm:computing-infrastructure ;
    vc:dependsOn ngm:compute-infrastructure,
        ngm:computing-hardware ;
    vc:enables ngm:blockchain-analytics,
        ngm:deep-learning,
        ngm:machine-learning-infrastructure,
        ngm:neur-ips ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:ai-hardware,
        ngm:ai-infrastructure,
        ngm:cloud-infrastructure,
        ngm:distributed-computing,
        ngm:edge-computing ;
    vc:slug "high-performance-computing" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:batch-processing,
        ngm:cuda,
        ngm:fpga,
        ngm:gpu-compute,
        ngm:parallel-processing,
        ngm:tpu .

ngm:human-feedback a owl:Class ;
    rdfs:label "Human Feedback"@en ;
    rdfs:comment "Information provided by human evaluators about model outputs, typically in the form of rankings, ratings, demonstrations, or corrections."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:supervised-fine-tuning ],
        ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:enables ngm:ai-alignment,
        ngm:reinforcement-learning-from-human-feedback,
        ngm:reward-model ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:model-performance ;
    vc:requires ngm:supervised-fine-tuning ;
    vc:slug "human-feedback" ;
    vc:sourceDomain "spatial-computing" .

ngm:hyperparameter a owl:Class ;
    rdfs:label "Hyperparameter"@en ;
    rdfs:comment "A configuration variable set before training that controls the learning process but is not learned from data. Examples include learning rate, batch size, number of layers, dropout rate, and regularisation coefficients. Hyperparameter selection directly determines model capacity, convergence speed, and generalisation, making their tuning a critical step in building effective machine learning systems."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:batch-size ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:dropout ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:learning-rate-schedule ],
        ngm:ai-technique,
        ngm:machine-learning ;
    skos:broader ngm:ai-technique ;
    vc:enables ngm:model-training,
        ngm:neural-network-architecture ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:batch-size,
        ngm:dropout,
        ngm:learning-rate-schedule ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:auto-ml,
        ngm:deep-learning,
        ngm:gradient-descent,
        ngm:overfitting ;
    vc:slug "hyperparameter" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:stochastic-gradient-descent .

ngm:immutability a owl:Class ;
    rdfs:label "Immutability"@en ;
    rdfs:comment "The tamper-resistant property of blockchain ledgers whereby confirmed records cannot be altered without invalidating the cryptographic chain of hashes, providing verifiable finality, audit-trail integrity, and resistance to retroactive manipulation. Achieved through chained Merkle roots, accumulated proof-of-work, or BFT-based finality."@en ;
    rdfs:subClassOf ngm:bc-network-component,
        ngm:blockchain-entity ;
    skos:broader ngm:bc-network-component ;
    vc:enables ngm:audit-trail,
        ngm:data-integrity,
        ngm:pharmaceutical-traceability,
        ngm:provenance-tracking ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:bc-protocol-and-consensus ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:cryptographic-commitment,
        ngm:distributed-ledger-technology,
        ngm:finality ;
    vc:slug "immutability" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:cryptographic-hash-function,
        ngm:digital-signature,
        ngm:merkle-tree .

ngm:inertial-measurement-unit a owl:Class ;
    rdfs:label "Inertial Measurement Unit"@en ;
    rdfs:comment "An Inertial Measurement Unit (IMU) is an electronic device incorporating tri-axial accelerometers and gyroscopes — and optionally tri-axial magnetometers — that measures a rigid body's specific force, angular velocity, and magnetic field strength to compute estimates of linear acceleration, angular rate, and orientation relative to an inertial reference frame. IMUs are classified by grade (consumer MEMS, tactical, navigation, strategic) according to drift, noise, and bias stability specifications. In robotics and spatial computing, IMUs provide the high-frequency proprioceptive backbone for state estimation, sensor-fusion pipelines, and attitude control loops."@en ;
    rdfs:subClassOf ngm:robo-perception,
        ngm:robot-sensor ;
    skos:broader ngm:robo-perception ;
    vc:enables ngm:odometry,
        ngm:sensor-fusion ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:robot-hardware ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:pose-estimation,
        ngm:slam ;
    vc:slug "inertial-measurement-unit" ;
    vc:sourceDomain "robotics" .

ngm:localization a owl:Class ;
    rdfs:label "Localization"@en ;
    rdfs:comment "The process of determining a mobile robot's position and orientation (pose) within a known or unknown environment using sensor measurements and a map or environmental model. It answers the question \"Where am I?\""@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:sensor-system ],
        ngm:robo-navigation-and-planning,
        ngm:state-estimation ;
    skos:broader ngm:robo-navigation-and-planning ;
    vc:enables ngm:navigation,
        ngm:path-planning ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires ngm:sensor-system ;
    vc:slug "localization" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:probabilistic-methods,
        ngm:rb-1008-odometry,
        ngm:rb-1014-monte-carlo-localization,
        ngm:rb-1015-kalman-filter .

ngm:medical-imaging a owl:Class ;
    rdfs:label "Medical Imaging"@en ;
    rdfs:comment "Medical imaging encompasses the acquisition, processing, and AI-assisted analysis of visual representations of the human body—including X-ray, CT, MRI, ultrasound, PET, and histopathology slides—for clinical diagnosis, treatment planning, and disease monitoring. Deep learning models, particularly convolutional neural networks and vision transformers, have achieved clinician-level performance on specific image classification and segmentation tasks. The field is governed by standards such as DICOM for data interchange and requires regulatory clearance (e.g., FDA 510(k) or CE marking) for clinical-decision software."@en ;
    rdfs:subClassOf ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:enables ngm:clinical-decision-support,
        ngm:radiology-ai ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:healthcare-ai ;
    vc:slug "medical-imaging" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:computer-vision,
        ngm:deep-learning,
        ngm:image-segmentation .

ngm:mining-reward a owl:Class ;
    rdfs:label "Mining Reward"@en ;
    rdfs:comment "A Mining Reward is the economic incentive awarded to the miner who successfully produces a valid block and appends it to the canonical blockchain, comprising a block subsidy of newly minted cryptocurrency plus the aggregate transaction fees of all transactions included in that block. The subsidy follows a pre-programmed halving schedule—in Bitcoin, halving every 210,000 blocks—gradually reducing issuance until the subsidy approaches zero and transaction fees become the sole miner compensation, aligning long-term network security incentives with user demand for block space."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:consensus-mechanism ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:mining ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:proof-of-work ],
        ngm:blockchain-entity ;
    vc:enables ngm:bitcoin-mining,
        ngm:blockchain-network ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:blockchain-entity ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:block-reward,
        ngm:blockchain-economics,
        ngm:high-energy-consumption,
        ngm:miner,
        ngm:mining-pool,
        ngm:transaction-fee ;
    vc:requires ngm:consensus-mechanism,
        ngm:mining,
        ngm:proof-of-work ;
    vc:slug "mining-reward" ;
    vc:sourceDomain "blockchain" .

ngm:neural-radiance-field a owl:Class ;
    rdfs:label "Neural Radiance Field"@en ;
    rdfs:comment "A continuous volumetric scene representation that uses a multilayer perceptron to map 5D coordinates (3D position plus 2D viewing direction) to colour and volume density, enabling novel view synthesis via differentiable ray marching. NeRF achieves photo-realistic rendering of complex scenes from a sparse set of calibrated images and has spawned instant variants, Gaussian Splatting successors, and robotics perception applications."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:neural-radiance-fields ],
        ngm:ai-model-architecture ;
    skos:broader ngm:ai-model-architecture ;
    vc:enables ngm:autonomous-robot ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:neural-radiance-fields ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:3-d-gaussian-splatting,
        ngm:depth-estimation,
        ngm:gaussian-splatting,
        ngm:point-cloud ;
    vc:slug "neural-radiance-field" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:ray-marching .

ngm:nist a owl:Class ;
    rdfs:label "NIST"@en ;
    rdfs:comment "The National Institute of Standards and Technology (NIST) is a US federal agency within the Department of Commerce responsible for developing measurement standards, metrology, and technology guidelines. NIST produces widely adopted frameworks for cybersecurity, risk management, and artificial intelligence that are referenced by industry, academia, and regulators worldwide. Its outputs include voluntary standards, special publications, and the NIST AI Risk Management Framework."@en ;
    rdfs:subClassOf ngm:standardization-bodies ;
    vc:enables ngm:cybersecurity-standard,
        ngm:nist-ai-rmf,
        ngm:risk-management ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:ai-governance,
        ngm:ai-risk-management,
        ngm:compliance-framework,
        ngm:technical-standard ;
    vc:slug "nist" ;
    vc:sourceDomain "governance" ;
    vc:supports ngm:ai-safety,
        ngm:information-security,
        ngm:regulatory-compliance .

ngm:node a owl:Class ;
    rdfs:label "Node"@en ;
    rdfs:comment "A network participant computer within a blockchain system that stores, validates, and relays transactions and blocks. Nodes enforce consensus rules, maintain copies of the distributed ledger, and collectively provide the decentralised security guarantees that distinguish blockchain from centralised databases."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptographic-protocol ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:bootstrap-node ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:full-node ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:archival-node ],
        ngm:bc-network-component,
        ngm:blockchain-entity,
        ngm:network-component ;
    skos:broader ngm:bc-network-component ;
    vc:enables ngm:blockchain-governance,
        ngm:blockchain-transaction ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:archival-node,
        ngm:bootstrap-node,
        ngm:full-node ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:blockchain-infrastructure,
        ngm:blockchain-network,
        ngm:consensus-mechanism,
        ngm:decentralization ;
    vc:requires ngm:cryptographic-protocol ;
    vc:slug "node" ;
    vc:sourceDomain "blockchain" .

ngm:peer-discovery a owl:Class ;
    rdfs:label "Peer Discovery"@en ;
    rdfs:comment "Protocol mechanism by which blockchain nodes locate and connect to other network participants without central coordination, using bootstrap nodes, DNS seeds, gossip-based address propagation, and distributed hash table lookups to establish and maintain a resilient peer-to-peer overlay network."@en ;
    rdfs:subClassOf ngm:bc-network-component,
        ngm:blockchain-entity,
        ngm:network-component ;
    skos:broader ngm:bc-network-component ;
    vc:enables ngm:censorship-resistance,
        ngm:peer-to-peer-network ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:blockchain-network,
        ngm:blockchain-protocol,
        ngm:fork-choice-rule,
        ngm:network-topology,
        ngm:sybil-attack,
        ngm:sybil-resistance ;
    vc:slug "peer-discovery" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:bootstrap-node,
        ngm:gossip-protocol .

ngm:photorealistic-rendering a owl:Class ;
    rdfs:label "Photorealistic Rendering"@en ;
    rdfs:comment "Photorealistic Rendering is the process of generating images from 3D scene descriptions that are visually indistinguishable from photographs, achieved through physically accurate simulation of light transport, material properties, and camera optics. Techniques include ray tracing, path tracing, and physically-based rendering (PBR) pipelines that compute global illumination, reflections, shadows, and subsurface scattering. Photorealistic output is increasingly demanded in spatial computing environments for digital-twin fidelity and immersive XR experiences."@en ;
    rdfs:subClassOf ngm:sc-display-and-rendering ;
    skos:broader ngm:sc-display-and-rendering ;
    vc:enables ngm:3-d-gaussian-splatting,
        ngm:real-time-rendering ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:relatedTo ngm:3-d-rendering-engine,
        ngm:global-illumination ;
    vc:slug "photorealistic-rendering" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:physically-based-rendering,
        ngm:ray-tracing,
        ngm:shader .

ngm:proposal-system a owl:Class ;
    rdfs:label "Proposal System"@en ;
    rdfs:comment "Multi-stage governance workflows enabling DAO community members to initiate, discuss, deliberate, vote upon, and execute protocol changes through structured processes combining off-chain deliberation (forums, governance calls), Snapshot signalling, and binding"@en ;
    rdfs:subClassOf ngm:bc-governance-and-regulation ;
    skos:broader ngm:bc-governance-and-regulation ;
    vc:enables ngm:on-chain-voting ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.4"^^xsd:float ;
    vc:requires ngm:snapshot ;
    vc:slug "proposal-system" ;
    vc:sourceDomain "blockchain" .

ngm:public-key a owl:Class ;
    rdfs:label "Public Key"@en ;
    rdfs:comment "The publicly shareable component of an asymmetric key pair, derived from the private key via elliptic curve or RSA mathematics, used in blockchain systems to derive wallet addresses, verify digital signatures, and enable encrypted communication without transmitting secret material."@en ;
    rdfs:subClassOf ngm:bc-cryptographic-primitive,
        ngm:blockchain-entity,
        ngm:cryptographic-primitive ;
    skos:broader ngm:bc-cryptographic-primitive ;
    vc:enables ngm:cryptographic-verification,
        ngm:digital-signature-verification,
        ngm:nft-ownership-proof ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:cryptographic-keys,
        ngm:digital-signature,
        ngm:private-key,
        ngm:public-key-infrastructure,
        ngm:sha-256 ;
    vc:slug "public-key" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:asymmetric-encryption,
        ngm:elliptic-curve-cryptography .

ngm:standards-body a owl:Class ;
    rdfs:label "Standards Body"@en ;
    rdfs:comment "Standards Body is a technology infrastructure concept and a type of infrastructure."@en ;
    rdfs:subClassOf ngm:infra-legal-and-regulatory ;
    skos:broader ngm:infra-legal-and-regulatory ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:implements ngm:infrastructure ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:slug "standards-body" ;
    vc:sourceDomain "infrastructure" .

ngm:transaction-pool a owl:Class ;
    rdfs:label "Transaction Pool"@en ;
    rdfs:comment "The Transaction Pool (mempool) is the in-memory distributed data structure held by each full node that stores validated but as-yet-unconfirmed transactions awaiting inclusion in a block. Nodes propagate transactions through the pool via gossip, miners and validators select transactions (typically by fee priority), and the pool is cleared as blocks confirm or transactions expire. Pool size, fee dynamics, and congestion directly determine user-experienced confirmation latency and cost."@en ;
    rdfs:subClassOf ngm:bc-network-component,
        ngm:blockchain-entity,
        ngm:distributed-data-structure ;
    skos:broader ngm:bc-network-component ;
    vc:enables ngm:fee-market,
        ngm:miner ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:blockchain-network ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:block-propagation,
        ngm:double-spending,
        ngm:mempool,
        ngm:network-synchronization ;
    vc:slug "transaction-pool" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:blockchain-transaction,
        ngm:gossip-protocol .

ngm:vertex-shader a owl:Class ;
    rdfs:label "Vertex Shader"@en ;
    rdfs:comment "A mandatory, programmable GPU stage that processes individual vertices within the graphics pipeline, transforming 3D coordinates through model, view, and projection matrices into clip space whilst computing per-vertex attributes such as normals, texture coordinates, and lighting terms that are subsequently interpolated across primitives for the fragment shader."@en ;
    rdfs:subClassOf ngm:metaverse,
        ngm:sc-display-and-rendering ;
    skos:broader ngm:sc-display-and-rendering ;
    vc:enables ngm:pixel-shader ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:shader ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:relatedTo ngm:compute-shader,
        ngm:visual-effects ;
    vc:slug "vertex-shader" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:rasterization .

ngm:xr-hardware a owl:Class ;
    rdfs:label "XR Hardware"@en ;
    rdfs:comment "XR Hardware encompasses the physical devices — head-mounted displays, spatial computing headsets, hand-tracking controllers, and wearable sensors — that enable augmented, mixed, and virtual reality experiences. These devices integrate display optics, inertial measurement units, inside-out tracking cameras, and wireless connectivity to render immersive spatial content with minimal latency."@en ;
    rdfs:subClassOf ngm:sc-display-and-rendering ;
    skos:broader ngm:sc-display-and-rendering ;
    vc:enables ngm:augmented-reality,
        ngm:mixed-reality,
        ngm:virtual-reality ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:relatedTo ngm:haptic-feedback ;
    vc:slug "xr-hardware" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:eye-tracking,
        ngm:spatial-computing .

ngm:adversarial-attack a owl:Class ;
    rdfs:label "Adversarial Attack"@en ;
    rdfs:comment "An Adversarial Attack is a deliberate attempt to manipulate an AI system by crafting malicious inputs or exploiting model vulnerabilities to cause misclassification, extract confidential information, degrade performance, or subvert intended behaviour. Attack classes include evasion, poisoning, model extraction, inversion, and backdoor, across white-box, black-box, and grey-box threat models."@en ;
    rdfs:subClassOf ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:contrastsWith ngm:robustness,
        ngm:safety-fine-tuning ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:ai-safety,
        ngm:computer-vision ;
    vc:slug "adversarial-attack" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:deep-learning .

ngm:ai-trustworthiness a owl:Class ;
    rdfs:label "AI Trustworthiness"@en ;
    rdfs:comment "The degree to which an AI system demonstrates characteristics that warrant confidence and reliance, encompassing transparency, explainability, fairness, accountability, robustness, reliability, safety, security, and privacy throughout its lifecycle."@en ;
    rdfs:subClassOf ngm:ai-governance-and-ethics ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:enables ngm:ai-assurance-ai-0102,
        ngm:responsible-ai-ai-0033 ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires ngm:governance-framework-ai-0035,
        ngm:risk-management-ai-0062 ;
    vc:slug "ai-trustworthiness" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:algorithm a owl:Class ;
    rdfs:label "Algorithm"@en ;
    rdfs:comment "A finite, deterministic sequence of instructions or rules that solves a computational problem or performs a transformation on data. In AI and blockchain contexts algorithms encompass learning procedures, consensus rules, cryptographic primitives, and optimisation methods that underpin intelligent systems and distributed ledgers."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:consensus-algorithm ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:backpropagation ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:hash-function ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:gradient-descent ],
        ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:enables ngm:blockchain,
        ngm:machine-learning-model ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:backpropagation,
        ngm:consensus-algorithm,
        ngm:gradient-descent,
        ngm:hash-function ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:algorithmic-bias,
        ngm:algorithmic-framework,
        ngm:machine-learning ;
    vc:slug "algorithm" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:inference .

ngm:asset-tokenization a owl:Class ;
    rdfs:label "Asset Tokenization"@en ;
    rdfs:comment "Asset Tokenization is the process of representing ownership rights to real-world or digital assets as blockchain-based tokens. It enables fractional ownership, programmatic transfer via smart contracts, and transparent provenance tracking on distributed ledgers. Tokenization applies to financial instruments, real estate, intellectual property, and virtual goods in metaverse environments."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:smart-contract ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:blockchain ],
        ngm:ai-application ;
    skos:broader ngm:ai-application ;
    vc:enables ngm:digital-asset,
        ngm:nft ;
    vc:hasMaturity ngmi:maturity-emerging ;
