    vc:slug "regulatory-framework" ;
    vc:sourceDomain "infrastructure" .

ngm:simulation a owl:Class ;
    rdfs:label "Simulation"@en ;
    rdfs:comment "Simulation creates computational models that replicate the behaviour of real-world systems, processes, or phenomena for training, experimentation, prediction, or entertainment. In metaverse and spatial computing contexts, simulations leverage physics engines, rendering pipelines, and AI-driven procedural content generation to produce interactive virtual environments that improve learning transfer, enable safe rehearsal of dangerous scenarios, and support distributed collaboration across geographies."@en ;
    rdfs:subClassOf ngm:infra-computing-and-cloud ;
    skos:broader ngm:infra-computing-and-cloud ;
    vc:enables ngm:immersive-experience,
        ngm:reinforcement-learning ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:relatedTo ngm:virtual-reality ;
    vc:slug "simulation" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:digital-twin,
        ngm:physics-engine,
        ngm:render-pipeline .

ngm:path-planning a owl:Class ;
    rdfs:label "Path Planning"@en ;
    rdfs:comment "The computational process of finding a feasible path for a robot to move from a start configuration to a goal configuration while avoiding obstacles and satisfying constraints. It determines a sequence of configurations connecting start to goal in the robot's configuration space."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:mapping ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:start-configuration ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:rb-1013-localization ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:environment-model ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:goal-configuration ],
        ngm:motion-planning,
        ngm:robo-navigation-and-planning ;
    skos:broader ngm:robo-navigation-and-planning ;
    vc:enables ngm:navigation,
        ngm:rb-1007-trajectory-generation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires ngm:environment-model,
        ngm:goal-configuration,
        ngm:mapping,
        ngm:rb-1013-localization,
        ngm:start-configuration ;
    vc:slug "path-planning" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:dijkstra-algorithm,
        ngm:rrt-algorithm .

ngm:self-sovereign-identity a owl:Class ;
    rdfs:label "Self Sovereign Identity"@en ;
    rdfs:comment "Self-Sovereign Identity (SSI) is an identity management paradigm — first articulated as a systematic framework by Christopher Allen in \"The Path to Self-Sovereign Identity\" (April 2016) — where individuals hold and control cryptographically verifiable credentials in their own Digital Wallet r..."@en ;
