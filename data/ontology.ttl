ngm:sparql-examples a owl:Class ;
    rdfs:label "SPARQL EXAMPLES"@en ;
    rdfs:comment "SPARQL (SPARQL Protocol and RDF Query Language) is the W3C-standardised query language for RDF-based knowledge graphs and linked data endpoints, supporting SELECT, CONSTRUCT, ASK, and DESCRIBE query forms, as well as federated queries across distributed SPARQL endpoints and SPARQL Update for graph mutation. SPARQL 1.1 (2013) added aggregates, subqueries, and property paths; SPARQL 1.2 (2023) further refined the protocol and service description vocabulary. It is the primary access interface for semantic knowledge graph exploration, ontology navigation, and cross-domain data integration."@en ;
    rdfs:subClassOf ngm:sc-standards-and-interop,
        ngm:semantic-web-standards ;
    skos:broader ngm:sc-standards-and-interop ;
    vc:enables ngm:knowledge-graph,
        ngm:knowledge-representation ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.4"^^xsd:float ;
    vc:relatedTo ngm:domain-ontology,
        ngm:knowledge-graph-construction ;
    vc:slug "sparql-examples" ;
    vc:sourceDomain "spatial-computing" ;
    vc:standardizedBy ngm:interoperability-standard ;
    vc:uses ngm:linked-data,
        ngm:ontology .

