    vc:sourceDomain "spatial-computing" .

ngm:lo-ra a owl:Class ;
    rdfs:label "Lo RA"@en ;
    rdfs:comment "A parameter-efficient fine-tuning mod that freezes pre-trained weights and injects trainable low-rank decomposition matrices into each layer of the transformer, dramatically reducing trainable parameters whilst maintaining performance."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:large-language-models ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:transformer-architecture ],
        ngm:ai-technique,
        ngm:parameter-efficient-fine-tuning ;
    skos:broader ngm:ai-technique ;
    vc:contrastsWith ngm:knowledge-distillation ;
    vc:enables ngm:fine-tuning,
        ngm:instruction-tuning ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:parameter-efficient-fine-tuning ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires ngm:large-language-models,
        ngm:transformer-architecture ;
    vc:slug "lo-ra" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:machine-translation a owl:Class ;
    rdfs:label "Machine Translation"@en ;
    rdfs:comment "Machine Translation is the automated translation of text or speech from one natural language to another using neural network models, particularly transformer-based sequence-to-sequence architectures. Modern neural MT systems achieve near-human quality through pre-training on massive multilingual corpora, cross-lingual transfer learning, and attention mechanisms that model long-range linguistic dependencies."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:training-data ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:language-modeling ],
        ngm:ai-application,
        ngm:natural-language-processing ;
    skos:broader ngm:ai-application ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:relatedTo ngm:language-translation,
        ngm:transfer-learning ;
    vc:requires ngm:language-modeling,
        ngm:training-data ;
    vc:slug "machine-translation" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:attention-mechanism,
        ngm:encoder-decoder-architecture .

ngm:message-passing a owl:Class ;
    rdfs:label "Message Passing"@en ;
    rdfs:comment "Message passing is a paradigm for inter-process and inter-component communication in which discrete, self-contained messages are sent between processes, objects, or distributed nodes rather than using shared memory. It underlies actor-model concurrency, microservice architectures, and distributed systems, providing loose coupling, location transparency, and inherent support for asynchronous execution. Messages can be delivered synchronously (blocking) or asynchronously (non-blocking), and may traverse in-process channels, message queues, or network transports."@en ;
    rdfs:subClassOf ngm:communication-protocol ;
    vc:enables ngm:distributed-computing,
        ngm:distributed-system ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:asynchronous-communication,
        ngm:event-driven-architecture,
        ngm:inter-agent-communication ;
    vc:slug "message-passing" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:distributed-architecture ;
    vc:uses ngm:message-queue,
        ngm:middleware .

ngm:metaverse-architecture a owl:Class ;
    rdfs:label "Metaverse Architecture"@en ;
    rdfs:comment "The layered technical framework defining metaverse infrastructure, encompassing network connectivity, computing resources, spatial computing, creator tools, interaction protocols, and economic systems that enable persistent virtual worlds."@en ;
    rdfs:subClassOf ngm:sc-platform-and-environment,
        ngm:system-architecture ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:enables ngm:virtual-world-operation ;
    vc:hasMaturity ngmi:maturity-draft ;
