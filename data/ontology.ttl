ngm:precision a owl:Class ;
    rdfs:label "Precision"@en ;
    rdfs:comment "A classification performance metric representing the proportion of positive predictions made by an artificial intelligence model that are actually correct, calculated as the ratio of true positives to all positive predictions (true positives plus false positives), measuring the model's ability to..."@en ;
