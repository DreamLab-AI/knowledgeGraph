    vc:qualityScore "0.0"^^xsd:float ;
    vc:slug "non-player-character" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:conversational-ai,
        ngm:state-machine .

ngm:northern-powerhouse a owl:Class ;
    rdfs:label "Northern Powerhouse"@en ;
    rdfs:comment "A United Kingdom government policy initiative aimed at boosting economic growth across the cities and regions of northern England."@en ;
