artificial-intelligence:AIOffice rdf:type owl:Class ;
    rdfs:label "AI Office"@en ;
    rdfs:comment "Commission body established as the centre of AI expertise forming the foundation for a single European AI governance system, with primary responsibility for supervising general-purpose AI models and coordinating market surveillance."@en ;
