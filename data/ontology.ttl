ngm:erc-1400 a owl:Class ;
    rdfs:label "ERC-1400"@en ;
    rdfs:comment "ERC-1400 is a composite Ethereum token standard that defines a framework for security tokens representing regulated financial instruments such as equities, bonds, and real estate on-chain. It extends the ERC-20 fungible token model with partition-based token tranches, on-chain transfer restrictions enforced via controller logic, document attachment for prospectuses and legal agreements, and forced transfer capabilities required for regulatory compliance. The standard is designed to satisfy securities law requirements across multiple jurisdictions by embedding compliance logic directly into the smart contract layer."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:smart-contract ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ethereum ],
        ngm:token-standard ;
    vc:bridgesTo ngm:capital-markets,
        ngm:digital-securities,
        ngm:financial-regulation ;
    vc:contrastsWith ngm:erc-20,
        ngm:erc-721,
        ngm:st-20 ;
    vc:enables ngm:asset-tokenisation,
        ngm:compliant-transfer,
        ngm:security-token,
        ngm:token-partition ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:erc-1410,
        ngm:erc-1594,
        ngm:erc-1643,
        ngm:erc-1644,
        ngm:erc-20 ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:decentralised-finance,
        ngm:ethereum-improvement-proposal,
        ngm:real-world-assets,
        ngm:tokenised-securities ;
    vc:requires ngm:ethereum,
