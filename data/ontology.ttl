ngm:topology a owl:Class ;
    rdfs:label "Topology"@en ;
    rdfs:comment "Topology is the mathematical study of properties of spaces that are preserved under continuous deformation, such as connectivity, continuity and the presence of holes. It provides the formal language for reasoning about shape independent of exact distances or coordinates, underpinning fields from network analysis to topological data analysis. In machine learning it informs how the structure of data and networks can be characterised and exploited."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:persistence ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:graph-theory ],
        ngm:graph-theory ;
    vc:bridgesTo ngm:network-topology ;
    vc:contrastsWith ngm:graph-theory ;
    vc:enables ngm:dimensionality-reduction ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:persistence ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:data-structure,
        ngm:graph-theory,
        ngm:network-topology ;
    vc:requires ngm:graph-theory ;
    vc:slug "topology" ;
    vc:sourceDomain "machine-learning" ;
    vc:supports ngm:point-cloud ;
    vc:uses ngm:data-structure .

ngm:torque a owl:Class ;
    rdfs:label "Torque"@en ;
    rdfs:comment "Torque is the rotational analogue of force, defined as the cross product of the moment arm and the applied force vector (τ = r × F), measured in newton-metres. In robotics it governs joint actuation, grip force, and dynamic loading across mechanical transmissions, and is the primary physical quantity managed by torque-controlled servos and force-torque sensors during manipulation tasks."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:actuator ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:force-torque-sensor ],
        ngm:robo-actuation-and-control,
        ngm:robot-dynamics ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:enables ngm:force-control,
        ngm:haptic-feedback,
        ngm:motion-control ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:robot-joint,
        ngm:robot-kinematics ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:requires ngm:actuator,
        ngm:force-torque-sensor ;
    vc:slug "torque" ;
    vc:sourceDomain "robotics" .

ngm:tpu a owl:Class ;
    rdfs:label "TPU"@en ;
    rdfs:comment "Tensor Processing Unit — Google's custom ASIC optimised for the dense matrix multiplications that dominate neural network training and inference. TPUs use systolic arrays to achieve high throughput on 8-bit and 16-bit arithmetic at significantly lower energy per FLOP than general-purpose GPUs, and are available via Google Cloud as Cloud TPUs for large-scale model training."@en ;
    rdfs:subClassOf ngm:ai-hardware,
        ngm:ai-infrastructure ;
    vc:enables ngm:distributed-training,
        ngm:large-language-models ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:edge-ai-accelerator,
        ngm:fpga,
        ngm:gpu-compute,
        ngm:hardware-acceleration,
        ngm:npu ;
    vc:slug "tpu" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:deep-learning,
        ngm:model-training .

ngm:trade-execution a owl:Class ;
    rdfs:label "Trade Execution"@en ;
    rdfs:comment "Trade execution is the process of converting an investment decision into a completed transaction in a market, encompassing how, when, and where an order is routed and filled. It seeks the best achievable outcome for the trader by managing factors such as price, speed, market impact, and slippage against the order book. Execution quality is a core determinant of realised returns and is governed by best-execution obligations in many jurisdictions."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:latency ],
        ngm:market-microstructure ;
    vc:bridgesTo ngm:regulatory-compliance ;
    vc:contrastsWith ngm:high-frequency-trading ;
    vc:dependsOn ngm:liquidity ;
    vc:enables ngm:liquidity,
        ngm:settlement ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:finance,
        ngm:payment-system,
        ngm:slippage ;
    vc:requires ngm:latency ;
    vc:slug "trade-execution" ;
    vc:sourceDomain "finance" ;
    vc:supports ngm:clearing ;
    vc:uses ngm:market-maker,
        ngm:order-book .

ngm:transaction-manager a owl:Class ;
    rdfs:label "Transaction Manager"@en ;
    rdfs:comment "A transaction manager is a software component that coordinates the atomic execution of operations against a database or distributed system, enforcing the ACID properties of atomicity, consistency, isolation, and durability. It governs commit and rollback, manages concurrency control and locking, and in distributed settings orchestrates multi-resource protocols such as two-phase commit."@en ;
    rdfs:subClassOf ngm:data-management ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:data-layer,
        ngm:graph-database ;
    vc:slug "transaction-manager" ;
    vc:sourceDomain "data" .

ngm:transport-protocol a owl:Class ;
    rdfs:label "Transport Protocol"@en ;
    rdfs:comment "A transport protocol is a network-layer specification that governs end-to-end delivery of data between processes, handling concerns such as multiplexing, reliability, ordering, and flow and congestion control. Examples including TCP, UDP, and QUIC sit above the network layer and provide the communication substrate over which higher-level application and agent protocols operate."@en ;
    rdfs:subClassOf ngm:network-protocol ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:infra-network-and-comms,
        ngm:model-control-protocols-like-mcp ;
    vc:slug "transport-protocol" ;
    vc:sourceDomain "infrastructure" .

ngm:unreal-engine a owl:Class ;
    rdfs:label "Unreal Engine"@en ;
    rdfs:comment "Unreal Engine is a real-time three-dimensional creation tool and game engine developed by Epic Games. It provides rendering, physics, animation, audio and scripting systems used to build games, virtual production environments, architectural visualisations and simulations. The engine is widely adopted for its high-fidelity rendering, its visual scripting system Blueprints, and its use in film and television virtual production with LED volume stages."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gpu-rendering ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:real-time-rendering ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:lumen ],
        ngm:game-engine ;
    vc:bridgesTo ngm:3-d-reconstruction,
        ngm:computer-vision,
        ngm:simulation ;
    vc:contrastsWith ngm:unity ;
    vc:enables ngm:architectural-visualisation,
        ngm:digital-twin,
        ngm:metaverse,
        ngm:virtual-production,
        ngm:xr-applications ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:lumen ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:requires ngm:gpu-rendering,
        ngm:real-time-rendering ;
    vc:slug "unreal-engine" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:augmented-reality,
        ngm:virtual-reality ;
    vc:uses ngm:level-of-detail,
        ngm:physically-based-rendering,
        ngm:ray-tracing .

ngm:virtual-currency a owl:Class ;
    rdfs:label "Virtual Currency"@en ;
    rdfs:comment "A digital representation of value issued and controlled by platform developers, used and accepted electronically within a specific virtual community. Virtual currencies include closed in-game currencies (e.g., World of Warcraft gold), hybrid purchasable tokens (e.g., Robux), and convertible currencies exchangeable for fiat money, each with distinct regulatory and economic implications."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:payment-system ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:digital-wallet ],
        ngm:digital-asset ;
    vc:bridgesTo ngm:blockchain,
        ngm:digital-asset,
        ngm:metaverse ;
    vc:contrastsWith ngm:central-bank-digital-currency,
        ngm:cryptocurrency,
        ngm:fiat-currency,
        ngm:stablecoin ;
    vc:dependsOn ngm:monetary-policy,
        ngm:platform-governance ;
    vc:enables ngm:cross-metaverse-commerce,
        ngm:play-to-earn-p2-e ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:financial-system,
        ngm:virtual-economy ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:anti-money-laundering,
        ngm:financial-regulation,
        ngm:know-your-customer ;
    vc:requires ngm:digital-wallet,
        ngm:payment-system ;
    vc:slug "virtual-currency" ;
    vc:sourceDomain "finance" ;
    vc:supports ngm:digital-commerce ;
    vc:uses ngm:payment-system,
        ngm:token-economics .

ngm:voice-assistant a owl:Class ;
    rdfs:label "Voice Assistant"@en ;
    rdfs:comment "A voice assistant is a software agent that responds to spoken commands and questions using speech recognition and natural language processing. Examples include assistants built into phones and smart speakers."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:natural-language-processing ],
        [ a owl:Restriction ;
