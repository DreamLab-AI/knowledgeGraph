ngm:data-integration-interface a owl:Class ;
    rdfs:label "Data Integration Interface"@en ;
    rdfs:comment "A standardized set of protocols, rules, and formats for unifying and mediating data flows across heterogeneous platforms, enabling seamless data exchange and interoperability."@en ;
