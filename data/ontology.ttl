ngm:agi-timelines a owl:Class ;
    rdfs:label "AGI Timelines"@en ;
    rdfs:comment "AGI timelines are structured probabilistic forecasts estimating when artificial general intelligence — AI matching or exceeding human cognitive ability across most economically valuable tasks — might be achieved. Such forecasts aggregate expert surveys (AI Impacts ESPAI 2022/2023), compute-scaling extrapolations (biological anchors model, Cotra 2020/2022), benchmark-progress curves (Metaculus, Manifold Markets), and Bayesian models of research milestones to produce probability distributions over future dates. As of mid-2026, median estimates cluster in the 2030–2047 range depending on methodology. Timelines are inherently uncertain and contested, and they materially influence AI safety research prioritisation, alignment investment, compute governance thresholds, and public policy."@en ;
    rdfs:subClassOf ngm:capability-forecasting,
        ngm:time-series-forecasting ;
    vc:enables ngm:ai-governance,
        ngm:ai-policy,
        ngm:alignment-research ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.88"^^xsd:float ;
    vc:relatedTo ngm:ai-safety,
        ngm:alignment,
        ngm:artificial-general-intelligence,
        ngm:compute-governance,
        ngm:existential-risk,
        ngm:gartner-prediction ;
    vc:slug "agi-timelines" ;
    vc:sourceDomain "ai" ;
    vc:supports ngm:ai-safety-research,
        ngm:compute-governance ;
    vc:uses ngm:bayesian-inference,
        ngm:expert-elicitation,
        ngm:performance-benchmarks,
        ngm:prediction-markets,
        ngm:scaling-laws .

ngm:ai-agent-coordination a owl:Class ;
    rdfs:label "AI Agent Coordination"@en ;
    rdfs:comment "AI Agent Coordination is the set of mechanisms by which multiple autonomous AI agents align their actions, share state, allocate tasks, and resolve conflicts to achieve goals that exceed any single agent's capability. It covers communication protocols, role assignment, consensus, and negotiation, and may be centralized through an orchestrator or fully decentralized. Effective coordination is essential for multi-agent systems operating over shared resources or distributed ledgers."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:contract-net-protocol ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:interoperability ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:leader-election ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:message-passing ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:consensus-mechanism ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:communication-protocol ],
        ngm:ai-agent-system ;
    vc:enables ngm:agentic-system,
        ngm:autonomous-ai-agents,
        ngm:emergent-behaviour,
        ngm:knowledge-sharing,
        ngm:load-balancing ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:blackboard-system,
        ngm:contract-net-protocol,
        ngm:leader-election,
        ngm:message-passing,
        ngm:negotiation-protocol,
        ngm:role-assignment,
        ngm:task-allocation ;
    vc:implements ngm:agent-to-agent-protocol,
        ngm:distributed-constraint-optimisation,
        ngm:mechanism-design,
        ngm:model-context-protocol,
        ngm:swarm-intelligence ;
    vc:qualityScore "0.85"^^xsd:float ;
    vc:relatedTo ngm:dao-governance,
        ngm:deadlock-prevention,
        ngm:decentralised-coordination,
        ngm:game-theory,
        ngm:rgb-and-client-side-validation ;
