ngm:interfaces a owl:Class ;
    rdfs:label "Interfaces"@en ;
    rdfs:comment "The set of software boundaries, interaction surfaces, and protocol contracts through which humans, AI agents, and system components communicate. In the context of LLMs and spatial computing, interfaces include node-based visual editors, chat frontends, API gateways, and multimodal input layers that mediate access to underlying AI or infrastructure capabilities."@en ;
    rdfs:subClassOf ngm:infra-computing-and-cloud,
        ngm:user-interface ;
