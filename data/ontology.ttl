ngm:collaborative-systems-modality a owl:Class ;
    rdfs:label "Collaborative Systems Modality"@en ;
    rdfs:comment "Collaborative describes systems, processes, or modalities in which multiple agents—human or robotic—work together toward shared goals, actively coordinating actions, sharing information, and adapting to one another's contributions. In robotics, 'collaborative' is most precisely applied to human–robot collaboration (HRC) per ISO/TS 15066, where robot and human share a workspace without fixed barriers. In knowledge work and software, it describes tools and practices enabling co-creation, distributed editing, and collective decision-making across asynchronous or real-time channels."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:collaborative-systems-modality-learning ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:collaborative-systems-modality-operation ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:asynchronous-collaboration ],
        ngm:infra-computing-and-cloud ;
    skos:broader ngm:infra-computing-and-cloud ;
    vc:bridgesTo ngm:collaboration ;
    vc:enables ngm:collective-intelligence-system,
        ngm:realtime-collaboration ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:asynchronous-collaboration,
        ngm:collaborative-systems-modality-learning,
        ngm:collaborative-systems-modality-operation ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:collaborative-systems-modality-robot,
        ngm:distributed-collaboration,
        ngm:human-robot-interaction,
        ngm:multi-agent-systems ;
    vc:slug "collaborative-systems-modality" ;
    vc:sourceDomain "infrastructure" .

ngm:collaborative-systems-modality-robots a owl:Class ;
    rdfs:label "Collaborative Robots"@en ;
    rdfs:comment "Collaborative robots, or cobots, are robots designed to work safely alongside humans within a shared workspace."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
