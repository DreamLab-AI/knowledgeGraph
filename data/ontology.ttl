ngm:knowledge-management-system a owl:Class ;
    rdfs:label "Knowledge Management System"@en ;
    rdfs:comment "A Knowledge Management System (KMS) is a platform that captures, organises, retrieves, and shares structured and unstructured knowledge across an organisation or community. In spatial computing contexts, a KMS may underpin documentation of 3D assets, ontologies, and procedural content, integrating knowledge graphs, semantic search, and metadata management to make information discoverable and actionable."@en ;
    rdfs:subClassOf ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:enables ngm:information-retrieval,
        ngm:knowledge-representation ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:relatedTo ngm:knowledge-base,
        ngm:metadata-management ;
    vc:slug "knowledge-management-system" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:knowledge-graph,
        ngm:ontology .

ngm:language-model a owl:Class ;
    rdfs:label "Language Model"@en ;
    rdfs:comment "A language model is a probabilistic model of natural language that assigns probability distributions over sequences of tokens — words, subwords, or characters — and can be used to compute the likelihood of observed text, generate new text, or predict the next token given a preceding context. Modern large language models are deep neural networks, typically based on the transformer architecture, trained on vast corpora of text through a self-supervised next-token prediction objective. They acquire implicit representations of syntax, semantics, factual knowledge, and reasoning patterns from this training signal, and can be adapted to specific tasks through fine-tuning, prompt engineering, or instruction tuning."@en ;
    rdfs:subClassOf ngm:generative-model ;
    vc:enables ngm:natural-language-processing,
        ngm:natural-language-understanding,
        ngm:text-generation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:fine-tuning,
        ngm:inference,
        ngm:language-modeling,
        ngm:large-language-models ;
    vc:slug "language-model" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:attention-mechanism,
        ngm:context-window,
        ngm:embeddings,
        ngm:transformer-architecture .

ngm:layer-2-scaling a owl:Class ;
    rdfs:label "Layer 2 Scaling"@en ;
    rdfs:comment "Layer 2 scaling refers to a category of protocols and systems built atop an existing blockchain (the Layer 1) that increase transaction throughput and reduce fees by processing the majority of transaction computation and data storage off the main chain while inheriting the security guarantees of the underlying Layer 1 through cryptographic proofs, fraud-proof mechanisms, or periodic state commitments. The Layer 2 anchors itself to the Layer 1 by periodically publishing compressed state roots or validity proofs, allowing the Layer 1 to serve as the ultimate settlement and security layer while the Layer 2 handles high-volume transaction processing."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:zero-knowledge-proof ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:sidechain ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:state-channel ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:lightning-network ],
        ngm:blockchain-scalability ;
    vc:enables ngm:blockchain-interoperability,
        ngm:cross-chain-asset-transfer,
        ngm:de-fi ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:lightning-network,
        ngm:sidechain,
        ngm:state-channel,
        ngm:zero-knowledge-proof ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:gas-optimization,
        ngm:layer2-scaling,
        ngm:lightning-and-similar-l2 ;
    vc:slug "layer-2-scaling" ;
    vc:sourceDomain "blockchain" .

ngm:legged-locomotion a owl:Class ;
    rdfs:label "Legged Locomotion"@en ;
    rdfs:comment "Legged locomotion is the study and engineering of robot motion through articulated limb contacts with the environment, enabling traversal of unstructured terrain that is inaccessible to wheeled or tracked platforms. It requires coordinated management of contact forces, centre-of-mass dynamics, gait sequencing, and reactive balance control across walking, running, climbing, and stair-negotiation tasks. Modern legged locomotion controllers combine whole-body control, model predictive control (MPC), and reinforcement learning — often trained in simulation and transferred to hardware — to achieve robust performance on irregular natural and urban terrain."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:motion-control ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:robot-dynamics ],
        ngm:robo-navigation-and-planning ;
    skos:broader ngm:robo-navigation-and-planning ;
    vc:enables ngm:motion-planning ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:quadruped-robot,
        ngm:reinforcement-learning,
        ngm:sim-to-real-transfer ;
    vc:requires ngm:motion-control,
        ngm:robot-dynamics ;
    vc:slug "legged-locomotion" ;
    vc:sourceDomain "robotics" .

ngm:manufacturing-automation a owl:Class ;
    rdfs:label "Manufacturing Automation"@en ;
    rdfs:comment "Manufacturing automation is the application of control technologies, robotics, sensors, and software to perform production tasks with minimal human intervention, spanning discrete, process, and hybrid manufacturing environments. It encompasses programmable logic controllers (PLCs), industrial robots, computer numerical control (CNC) machines, and integrated supervisory systems that coordinate material flow, quality inspection, and assembly operations. Modern implementations leverage machine vision, AI-driven process optimisation, and digital twin synchronisation to achieve adaptive, self-correcting production lines. The discipline aims to increase throughput, improve consistency, reduce cycle times, and enhance worker safety by removing operators from hazardous or repetitive tasks."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:sensor-fusion ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:control-system ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:industrial-robot ],
        ngm:industrial-automation ;
    vc:enables ngm:cyber-physical-systems,
        ngm:supply-chain ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:control-system,
        ngm:industrial-robot,
        ngm:sensor-fusion ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:digital-twin,
        ngm:industrial-io-t,
        ngm:precision-manufacturing,
        ngm:smart-manufacturing ;
    vc:slug "manufacturing-automation" ;
    vc:sourceDomain "robotics" .

ngm:metadata-registry a owl:Class ;
    rdfs:label "Metadata Registry"@en ;
    rdfs:comment "Centralised systems for managing metadata according to standards like ISO/IEC 11179, providing authoritative definitions, usage rules, and data element descriptions to ensure consistency, interoperability, and governance across enterprise data systems."@en ;
    rdfs:subClassOf ngm:data-governance,
        ngm:infra-data-management ;
    skos:broader ngm:infra-data-management ;
    vc:enables ngm:enterprise-data-consistency ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:slug "metadata-registry" ;
    vc:sourceDomain "infrastructure" .

ngm:mev a owl:Class ;
    rdfs:label "MEV"@en ;
    rdfs:comment "Maximal Extractable Value (MEV) represents the profit that block producers can extract through strategic transaction ordering, inclusion, or exclusion within blocks, arising from their privileged position to control execution sequencing in blockchain networks."@en ;
    rdfs:subClassOf ngm:bc-defi-and-economics ;
    skos:broader ngm:bc-defi-and-economics ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:slug "mev" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:front-running .

ngm:miner a owl:Class ;
    rdfs:label "Miner"@en ;
    rdfs:comment "A Miner is a network participant in a proof-of-work blockchain who dedicates computational resources to solving cryptographic hash puzzles, competing to produce valid blocks that extend the canonical chain in exchange for a block reward (newly issued coins plus transaction fees). Miners collectively provide the computational security of the network: the cost of mounting a 51% attack is proportional to the total hash rate, which represents real-world energy and hardware expenditure. Mining can be performed individually or cooperatively within mining pools that aggregate hash power and share rewards proportionally."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:mining-pool ],
        ngm:bc-protocol-and-consensus,
        ngm:blockchain-entity,
        ngm:consensus-protocol ;
    skos:broader ngm:bc-protocol-and-consensus ;
    vc:contrastsWith ngm:validator-node ;
    vc:dependsOn ngm:blockchain-network ;
    vc:enables ngm:block-propagation,
        ngm:consensus-mechanism ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:mining-pool ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:block-reward,
        ngm:fee-market,
        ngm:mempool,
        ngm:mining-reward ;
    vc:slug "miner" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:cryptographic-hash-function,
        ngm:proof-of-work .

ngm:monetary-system a owl:Class ;
    rdfs:label "Monetary System"@en ;
    rdfs:comment "The comprehensive framework of institutions, regulations, and mechanisms governing money creation, distribution, and management within an economy, now evolving to incorporate digital currencies, CBDCs, and blockchain-based financial systems."@en ;
    rdfs:subClassOf ngm:financial-system,
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:enables ngm:economic-exchange ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:slug "monetary-system" ;
    vc:sourceDomain "spatial-computing" .

ngm:motion-model a owl:Class ;
    rdfs:label "Motion Model"@en ;
    rdfs:comment "A motion model is a mathematical or learned representation that describes how the state of a moving entity—a robot, vehicle, or articulated body—evolves over time given control inputs and noise. In probabilistic robotics it forms the prediction step of filters such as Kalman and particle filters, characterising uncertainty in state transitions. Motion models range from simple kinematic approximations (constant velocity, unicycle) to full rigid-body dynamic equations and learned neural representations derived from data. Accuracy of the motion model directly determines the quality of localisation, planning, and control outcomes."@en ;
    rdfs:subClassOf ngm:kinematics-model ;
    vc:enables ngm:motion-planning,
        ngm:state-estimation,
        ngm:trajectory-tracking ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:motion-control,
        ngm:newton-euler-dynamics,
        ngm:robot-dynamics ;
    vc:slug "motion-model" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:kinematics,
        ngm:probabilistic-model,
        ngm:rigid-body-dynamics .

ngm:motor-driver a owl:Class ;
    rdfs:label "Motor Driver"@en ;
    rdfs:comment "A Motor Driver is an electronic circuit or integrated circuit module that translates low-power control signals from a microcontroller or digital signal processor into the high-current, high-voltage waveforms required to operate electric motors, including DC brushed motors, brushless DC motors, and stepper motors. Motor drivers implement switching topologies such as H-bridge configurations and PWM (pulse-width modulation) generation to control motor direction, speed, and torque. Protection circuitry for over-current, over-temperature, and back-EMF clamping is typically integrated. Motor drivers are fundamental building blocks of robotic systems, electric vehicles, CNC machinery, and consumer appliances."@en ;
    rdfs:subClassOf ngm:embedded-systems ;
    vc:enables ngm:actuator,
        ngm:robot-control,
        ngm:servo-control ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:electric-motor,
        ngm:servo-motor,
        ngm:stepper-motor ;
    vc:slug "motor-driver" ;
    vc:sourceDomain "robotics" ;
    vc:supports ngm:robotic-system ;
    vc:uses ngm:dc-servo-motor,
        ngm:real-time-control .

ngm:networking-infrastructure a owl:Class ;
    rdfs:label "Networking Infrastructure"@en ;
    rdfs:comment "The physical and logical systems—including routers, CDNs, edge nodes, and communication protocols—that underpin connectivity for distributed applications. For spatial computing and metaverse contexts, networking infrastructure must deliver sub-20ms latency, support massive concurrent connections, and enable geographically distributed state synchronisation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:content-delivery-network ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:edge-computing ],
        ngm:infra-network-and-comms ;
    skos:broader ngm:infra-network-and-comms ;
    vc:dependsOn ngm:bandwidth-adaptation,
        ngm:latency ;
    vc:enables ngm:metaverse-infrastructure,
        ngm:realtime-communication ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:content-delivery-network,
        ngm:edge-computing ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:slug "networking-infrastructure" ;
    vc:sourceDomain "infrastructure" .

ngm:neural-network-component a owl:Class ;
    rdfs:label "Neural Network Component"@en ;
    rdfs:comment "A discrete structural or functional building block within a neural network model, including layers, activation functions, normalisation mechanisms, attention heads, and connection schemes. These components are composed to form complete neural network architectures and directly determine model capacity, training dynamics, and inference behaviour."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:attention-mechanism ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:decoder ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:attention-head ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:neural-network-layer ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:residual-connection ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:batch-normalisation ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:positional-encoding ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:encoder ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:activation-function ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:dropout ],
        ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:activation-function,
        ngm:attention-head,
        ngm:attention-mechanism,
        ngm:batch-normalisation,
        ngm:decoder,
        ngm:dropout,
        ngm:encoder,
        ngm:neural-network-layer,
        ngm:positional-encoding,
        ngm:residual-connection ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:deep-learning,
        ngm:neural-network-architecture ;
    vc:slug "neural-network-component" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:nft-standard a owl:Class ;
