ngm:continuous-delivery a owl:Class ;
    rdfs:comment "Continuous Delivery is a software engineering discipline in which code changes are automatically built, tested and prepared for release to production so that the software is always in a deployable state. It extends continuous integration by adding automated release pipelines, environment promotion and deployment gates, allowing teams to ship changes rapidly, reliably and with low risk. Releases become routine, low-ceremony events rather than infrequent high-stakes operations."@en ;
    rdfs:label "Continuous Delivery"@en ;
    rdfs:subClassOf ngm:devops ;
    rdfs:subClassOf _:r5655 ;
    rdfs:subClassOf _:r5656 ;
