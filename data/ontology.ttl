    vc:sourceDomain "blockchain" .

ngm:linked-data-encoder a owl:Class ;
    rdfs:label "Linked Data Encoder"@en ;
    rdfs:comment "A semantic encoding pipeline that transforms agent state, credentials, events, and metadata into JSON-LD 1.1 format using pinned, versioned JSON-LD Context|W3C JSON-LD contexts, enabling standardised Federation Surface|federation surfaces (S1–S11) that are queryable, linkable, and mac..."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:json-ld-context ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:json-ld-1-1-standard ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:canonical-json ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:w-3-c-vocabulary ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:uri-canonicaliser ],
        ngm:data-layer,
        ngm:infra-data-management ;
    skos:broader ngm:infra-data-management ;
    vc:enables ngm:cross-system-querying,
        ngm:knowledge-graph-integration,
        ngm:linked-data-consumption,
        ngm:semantic-federation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:context-pinning,
        ngm:json-ld-context,
        ngm:semantic-mapping,
        ngm:uri-resolution ;
    vc:implements ngm:json-ld-1-1,
        ngm:rdf-semantics,
        ngm:w3-c-linked-data ;
    vc:qualityScore "0.87"^^xsd:float ;
    vc:requires ngm:canonical-json,
        ngm:json-ld-1-1-standard,
        ngm:uri-canonicaliser,
        ngm:w-3-c-vocabulary ;
    vc:slug "linked-data-encoder" ;
    vc:sourceDomain "infrastructure" .

ngm:liquid-democracy a owl:Class ;
    rdfs:label "Liquid Democracy"@en ;
    rdfs:comment "Liquid democracy is a hybrid governance model that combines direct and representative democracy by allowing participants to vote on proposals themselves or transitively delegate their voting power to a trusted proxy, who may further re-delegate to another delegate, forming an arbitrarily deep delegation chain. Delegations are revocable at any time, allowing voters to reclaim their votes before a proposal closes. In blockchain governance contexts, liquid democracy is implemented via governance token delegation mechanisms, enabling token holders to assign their on-chain voting weight to domain experts while retaining the right to override delegated votes on individual proposals."@en ;
    rdfs:subClassOf ngm:bc-governance-and-regulation ;
    skos:broader ngm:bc-governance-and-regulation ;
    vc:contrastsWith ngm:quadratic-voting ;
    vc:enables ngm:dao-governance,
        ngm:on-chain-governance ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:slug "liquid-democracy" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:governance-token,
        ngm:voting-mechanism .

ngm:lo-ra-fine-tuning a owl:Class ;
    rdfs:label "LoRA Fine-Tuning"@en ;
    rdfs:comment "LoRA (Low-Rank Adaptation) fine-tuning is a parameter-efficient fine-tuning technique that adapts large pre-trained transformer models by inserting pairs of trainable low-rank matrices (A ∈ ℝ^{d×r} and B ∈ ℝ^{r×d}, where r ≪ d) alongside frozen weight matrices in selected layers, so that the effective weight update ΔW = BA is constrained to a low-dimensional subspace. By training only the injected adapter matrices — typically representing 0.1–1% of the original parameter count — LoRA achieves near full fine-tuning performance at a fraction of the GPU memory and compute cost, enabling adaptation of billion-parameter models on consumer hardware. It is now the dominant technique in the PEFT ecosystem and is implemented in Hugging Face's PEFT library."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:pre-training ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:large-language-models ],
        ngm:ai-technique,
        ngm:parameter-efficient-fine-tuning ;
    skos:broader ngm:ai-technique ;
    vc:enables ngm:domain-adaptation,
        ngm:fine-tuning ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:model-training,
        ngm:quantisation ;
    vc:requires ngm:large-language-models,
        ngm:pre-training ;
    vc:slug "lo-ra-fine-tuning" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:market-surveillance-authority a owl:Class ;
    rdfs:label "Market Surveillance Authority"@en ;
    rdfs:comment "National authority responsible for carrying out market surveillance activities on AI systems, including inspections, testing, enforcement, and ensuring compliance with EU AI Act requirements within a Member State."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
