    vc:sourceDomain "governance" .

ngm:item-response-theory a owl:Class ;
    rdfs:label "Item Response Theory"@en ;
    rdfs:comment "Item Response Theory (IRT) is a family of psychometric models that relate the probability of a correct response to a test item to a latent trait of the respondent, such as ability, and to properties of the item, such as difficulty and discrimination. Unlike classical test theory, IRT places examinees and items on a common scale, enabling adaptive testing, equating across forms, and fine-grained measurement of ability. It is widely used in assessment, educational technology, and the adaptive components of intelligent learning systems."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:educational-technology ],
        ngm:adaptive-learning ;
    vc:bridgesTo ngm:artificial-intelligence ;
    vc:contrastsWith ngm:bayesian-knowledge-tracing ;
    vc:enables ngm:intelligent-tutoring-system,
        ngm:personalised-learning ;
    vc:hasMaturity ngmi:maturity-established ;
