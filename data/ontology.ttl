ngm:verifiable-credentials a owl:Class ;
    rdfs:label "Verifiable Credentials"@en ;
    rdfs:comment "Cryptographically secured, tamper-evident digital credentials standardised by the W3C Verifiable Credentials Data Model v2.0 (May 2025 REC) that encode machine-verifiable claims about subjects — enabling a holder/issuer/verifier triangle in which issuers sign claims with DIDs, holders selectively..."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:digital-signature ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:verifiable-credentials ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:decentralized-identifiers ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptography-security-and-privacy ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
