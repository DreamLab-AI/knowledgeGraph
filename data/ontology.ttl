ngm:monetary-policy a owl:Class ;
    rdfs:label "Monetary Policy"@en ;
    rdfs:comment "Monetary policy is the set of decisions made by a monetary authority — traditionally a central bank — to manage the supply of money, credit conditions, and interest rates in order to achieve macroeconomic objectives such as price stability, full employment, and sustainable growth. In traditional finance it encompasses tools such as open market operations, reserve requirements, and benchmark interest-rate setting. In decentralised systems and blockchain protocols, monetary policy is often encoded algorithmically into protocol rules that govern token emission schedules, inflation rates, halving events, and burn mechanisms, removing discretionary human intervention."@en ;
    rdfs:subClassOf ngm:economic-governance ;
    vc:enables ngm:central-bank-digital-currency,
        ngm:stablecoin ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:central-bank,
        ngm:economics,
        ngm:inflation-control ;
    vc:slug "monetary-policy" ;
    vc:sourceDomain "finance" ;
    vc:supports ngm:monetary-policy-transmission ;
    vc:uses ngm:economic-mechanism,
        ngm:tokenomics .

ngm:monetary-policy-implementation a owl:Class ;
    rdfs:label "Monetary Policy Implementation"@en ;
    rdfs:comment "Monetary Policy Implementation encompasses the operational processes, tools, and institutional mechanisms through which central banks and monetary authorities translate policy decisions—such as interest rate targets or quantitative measures—into observable effects on the financial system. In digital and metaverse economic contexts it extends to the programmatic enforcement of monetary parameters via Central Bank Digital Currencies (CBDCs), smart contracts, and programmable money frameworks. Effective implementation requires coordination between inflation control targets, payment system design, financial stability oversight, and regulatory compliance."@en ;
    rdfs:subClassOf ngm:economic-mechanism,
        ngm:sc-governance-and-safety ;
    skos:broader ngm:sc-governance-and-safety ;
    vc:enables ngm:central-bank-digital-currency-cbdc,
        ngm:financial-stability,
        ngm:programmable-money ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:economic-governance,
        ngm:financial-regulation,
        ngm:inflation-control,
        ngm:monetary-sovereignty ;
    vc:slug "monetary-policy-implementation" ;
    vc:sourceDomain "economics" ;
    vc:uses ngm:cbdc-frameworks,
        ngm:payment-system,
        ngm:stablecoin .

ngm:neural-network-quantisation a owl:Class ;
    rdfs:label "Neural Network Quantisation"@en ;
    rdfs:comment "A model compression technique that reduces the numerical precision of neural network weights and activations from floating-point (FP32, FP16) to lower-bit integer representations (INT8, INT4, binary), decreasing memory footprint and improving inference speed on hardware with integer arithmetic units. Approaches include post-training quantisation and quantisation-aware training."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:quantisation ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:mixed-precision-training ],
        ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:enables ngm:inference-hardware ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:mixed-precision-training,
        ngm:quantisation ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:knowledge-distillation,
        ngm:knowledge-distillation-for-edge,
        ngm:model-compression-for-edge,
        ngm:model-pruning-for-edge-deployment ;
    vc:slug "neural-network-quantisation" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:machine-learning-model,
        ngm:pretrained-model .

