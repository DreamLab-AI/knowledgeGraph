        ngm:motion-planning ;
    vc:slug "manipulation" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:end-effector,
        ngm:force-control .

ngm:medical-ai a owl:Class ;
    rdfs:label "Medical AI"@en ;
    rdfs:comment "Medical AI encompasses artificial intelligence and machine learning applications in healthcare for disease detection, diagnosis, treatment planning, and clinical decision support."@en ;
