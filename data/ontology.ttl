ngm:digital-identity-verification a owl:Class ;
    rdfs:label "Digital Identity Verification"@en ;
    rdfs:comment "Digital Identity Verification is the remote, automated process of confirming that a person's claimed identity corresponds to a real individual and that the claimant is who they say they are, typically through document analysis, biometric matching, liveness detection, and database cross-referencing. It underpins Know Your Customer (KYC) compliance, onboarding workflows, and access control in digital services."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:public-key-infrastructure ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:know-your-customer ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptographic-hash-function ],
        ngm:digital-identity ;
    vc:bridgesTo ngm:artificial-intelligence,
        ngm:blockchain ;
    vc:contrastsWith ngm:knowledge-based-authentication,
        ngm:password-authentication ;
    vc:enables ngm:access-control,
        ngm:anti-money-laundering,
        ngm:digital-onboarding ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:decentralized-identifier,
        ngm:digital-identity-framework,
        ngm:self-sovereign-identity,
        ngm:verifiable-credentials ;
    vc:requires ngm:cryptographic-hash-function,
        ngm:know-your-customer,
        ngm:public-key-infrastructure ;
