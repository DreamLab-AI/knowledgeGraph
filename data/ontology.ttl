        ngm:open-source-software .

ngm:user-identity-management a owl:Class ;
    rdfs:label "User Identity Management"@en ;
    rdfs:comment "User identity management is the set of processes and systems that create, maintain, authenticate and deprovision the digital identities of users across a platform's lifecycle. It governs how users register, prove who they are, manage profiles and link accounts, and is foundational to access control and personalised experiences. In collaborative and metaverse platforms it also coordinates presence, avatars and cross-session continuity."@en ;
    rdfs:subClassOf ngm:identity-management ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:breakout-room,
        ngm:platform-layer ;
    vc:slug "user-identity-management" ;
    vc:sourceDomain "security" .

ngm:user-profiling a owl:Class ;
    rdfs:label "User Profiling"@en ;
    rdfs:comment "User profiling is the construction of a structured model of an individual or segment from observed attributes, behaviours and interaction history, used to predict preferences, intent or risk. Profiles aggregate explicit data such as stated preferences with implicit signals such as clicks, dwell time and purchases, and may be updated continuously as new behaviour is observed. Because profiles concern people, their construction raises consent, fairness and privacy obligations that constrain what may be collected and inferred."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:behavioural-analytics ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:recommendation-system ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-preprocessing ],
        ngm:behavioural-analytics ;
    vc:bridgesTo ngm:recommendation-system ;
    vc:enables ngm:personalisation,
        ngm:recommendation-system ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:recommendation-system ;
    vc:isPartOf ngm:behavioural-analytics ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:personalisation,
        ngm:predictive-personalization ;
    vc:requires ngm:behavioural-analytics,
        ngm:data-preprocessing ;
    vc:slug "user-profiling" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:predictive-personalization ;
    vc:uses ngm:behavioural-analytics,
        ngm:data-preprocessing .

ngm:utility-function a skos:Concept ;
    rdfs:label "Utility Function"@en .

ngm:validation-set a owl:Class ;
    rdfs:label "Validation Set"@en ;
    rdfs:comment "A Validation Set is a held-out partition of data, distinct from the training and test sets, used to tune hyperparameters and make model-selection decisions during machine learning development. By evaluating candidate models on data not used for fitting, it provides an unbiased signal for choices such as architecture, regularisation strength and early stopping. The test set is reserved for a final, untouched estimate of generalisation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:training-data ],
        ngm:model-evaluation ;
    vc:contrastsWith ngm:cross-validation ;
    vc:enables ngm:early-stopping,
        ngm:hyperparameter-tuning,
        ngm:model-selection ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:isPartOf ngm:model-evaluation ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:data,
        ngm:overfitting ;
    vc:requires ngm:training-data ;
    vc:slug "validation-set" ;
    vc:sourceDomain "machine-learning" ;
    vc:supports ngm:bias-variance-tradeoff,
        ngm:model-training ;
    vc:uses ngm:accuracy,
        ngm:loss-function .

ngm:validator-economics a owl:Class ;
    rdfs:label "Validator Economics"@en ;
    rdfs:comment "Validator economics describes the incentive structures, cost-reward equilibria, and rational behaviour models governing participants who operate validator nodes in proof-of-stake and delegated consensus blockchain networks. It encompasses staking rewards (block rewards, transaction fees, MEV capture), slashing penalties for Byzantine behaviour (double-signing, downtime), the competitive market for delegated stake, operational costs (hardware, bandwidth, maintenance), and the resulting equilibrium between security budget, validator profitability, and network decentralisation. Well-designed validator economics align individual rational self-interest with network security and liveness."@en ;
    rdfs:subClassOf ngm:blockchain-economics ;
    vc:enables ngm:decentralized-governance,
        ngm:finality ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:delegated-proof-of-stake,
        ngm:incentive-alignment,
        ngm:token-economics,
        ngm:validator-node,
        ngm:validator-set ;
    vc:slug "validator-economics" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:block-reward,
        ngm:consensus-mechanism,
        ngm:proof-of-stake,
        ngm:tokenomics .

ngm:variable-stiffness-actuator a owl:Class ;
    rdfs:label "Variable Stiffness Actuator"@en ;
    rdfs:comment "A variable stiffness actuator (VSA) is a compliant robotic actuator whose mechanical stiffness can be adjusted independently of its position, typically using antagonistic springs or adjustable elastic elements. This adjustable compliance lets robots store and release energy, absorb impacts and interact safely with humans and uncertain environments. VSAs are central to safe, energy-efficient force control in physical human-robot interaction."@en ;
    rdfs:subClassOf ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:force-control,
        ngm:pneumatic-actuator ;
    vc:slug "variable-stiffness-actuator" ;
    vc:sourceDomain "robotics" .

ngm:vector-clocks a owl:Class ;
    rdfs:label "Vector Clocks"@en ;
    rdfs:comment "A mechanism for ordering events in a distributed system by assigning each process a vector of counters. Comparing vectors determines whether one event causally precedes another or whether they are concurrent."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:distributed-computing ],
        ngm:clock-synchronization ;
    vc:enables ngm:eventual-consistency ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:distributed-computing ;
    vc:slug "vector-clocks" ;
    vc:sourceDomain "distributed-systems" .

ngm:venue-tethered-immersive-experience a owl:Class ;
    rdfs:label "Venue-Tethered Immersive Experience"@en ;
    rdfs:comment "An immersive or interactive experience tied to a specific physical venue or geographic location, combining real-world presence with digital or spatial computing overlays. Location-based experiences leverage spatial mapping, real-time content delivery, and user proximity to deliver contextually relevant narrative or interactive content that cannot be replicated remotely."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:spatial-mapping ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gps ],
        ngm:immersive-experience,
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:enables ngm:performing-arts,
        ngm:virtual-production ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:metaverse-venue ;
    vc:requires ngm:gps,
        ngm:spatial-mapping ;
    vc:slug "venue-tethered-immersive-experience" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:content-delivery-network,
        ngm:extended-reality .

ngm:virtual-camera a owl:Class ;
    rdfs:label "Virtual Camera"@en ;
    rdfs:comment "A simulated camera system in virtual production environments that captures real-time virtual scenes, enabling filmmakers to visualise and shoot CG environments as though using a physical camera with real-world lens characteristics — including focal length, aperture, and depth-of-field — and six-DoF movement tracking. It integrates with motion capture rigs, LED volume stages, and game engines to deliver live compositing preview and Genlock-synchronised output."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:real-time-rendering ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:motion-capture ],
        ngm:sc-display-and-rendering,
        ngm:virtual-production ;
    skos:broader ngm:sc-display-and-rendering ;
    vc:enables ngm:virtual-production-pipeline,
        ngm:virtual-scouting ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:virtual-stage ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:requires ngm:motion-capture,
        ngm:real-time-rendering ;
    vc:slug "virtual-camera" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:game-engine,
        ngm:virtual-production-volume .

ngm:virtual-community-platform a owl:Class ;
    rdfs:label "Virtual Community Platform"@en ;
    rdfs:comment "Spatial computing platforms that enable users to create and interact within immersive 3D virtual environments as digital avatars, supporting social interaction, community building, collaborative activities, and shared experiences across geographic boundaries."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:avatar-system ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:virtual-world-infrastructure ],
        ngm:metaverse,
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:enables ngm:social-vr,
        ngm:virtual-concerts ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:metaverse-platform,
        ngm:virtual-community-practice ;
    vc:requires ngm:avatar-system,
        ngm:virtual-world-infrastructure ;
    vc:slug "virtual-community-platform" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:content-moderation,
        ngm:virtual-identity .

ngm:virtual-event-platform a owl:Class ;
    rdfs:label "Virtual Event Platform"@en ;
    rdfs:comment "Software platforms that enable hosting digital events in metaverse environments, supporting conferences, exhibitions, concerts, and networking through immersive 3D spaces with avatar-based attendance, interactive features, and real-time collaboration tools."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:event-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:collaboration-platform ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:virtual-event ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:avatar ],
        ngm:metaverse,
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:enables ngm:immersive-experience ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:event-management,
        ngm:virtual-event ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires ngm:avatar,
        ngm:collaboration-platform ;
    vc:slug "virtual-event-platform" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:metaverse-platform,
        ngm:social-vr .

ngm:virtual-identity a owl:Class ;
    rdfs:label "Virtual Identity"@en ;
    rdfs:comment "A digital representation encompassing behaviours, preferences, movements, actions, and decisions made in digital spaces, extending beyond 3D avatars to include representation, data, and identification across AR, VR, MR, and web platforms using decentralized identity technologies."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:personal-data-store ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:authentication ],
        ngm:digital-identity,
        ngm:infra-security-and-identity ;
    skos:broader ngm:infra-security-and-identity ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:digital-identity-management,
        ngm:privacy ;
    vc:requires ngm:authentication,
        ngm:personal-data-store ;
    vc:slug "virtual-identity" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:avatar-portability,
        ngm:avatar-system,
        ngm:decentralized-identifiers .

ngm:virtual-private-network a owl:Class ;
    rdfs:label "Virtual Private Network"@en ;
    rdfs:comment "A virtual private network (VPN) is a technology that establishes an encrypted tunnel over a shared or public network, allowing devices to communicate as if they were directly connected to a private network. It authenticates endpoints, encrypts traffic in transit, and encapsulates packets so that data confidentiality and integrity are preserved across untrusted links. VPNs are used for secure remote access to corporate resources, site-to-site connectivity, and privacy-preserving internet use. Common implementations rely on protocols such as IPsec, TLS, and WireGuard, though zero-trust architectures increasingly complement or supersede perimeter VPN models."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:authentication ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptography ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:encryption ],
        ngm:network-security ;
    vc:contrastsWith ngm:zero-trust ;
    vc:enables ngm:privacy,
        ngm:remote-access ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:encryption,
        ngm:tunneling ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:access-control,
        ngm:firewall ;
    vc:requires ngm:authentication,
        ngm:cryptography ;
    vc:slug "virtual-private-network" ;
    vc:sourceDomain "security" ;
    vc:supports ngm:security ;
    vc:uses ngm:authentication,
        ngm:encryption,
        ngm:ipsec,
        ngm:tls .

ngm:virtual-stage a owl:Class ;
    rdfs:label "Virtual Stage"@en ;
    rdfs:comment "A production environment surrounded by curved LED walls and floors displaying real-time computer-generated imagery, enabling in-camera visual effects (ICVFX) for film, television, and broadcast production. Digital backgrounds rendered by a game engine react dynamically to tracked camera movement, capturing realistic lighting and reflections directly on-sensor. Epic Games' StageCraft system and Unreal Engine power the majority of commercial installations, with facilities now exceeding 1,700 m² of LED surface area."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:virtual-camera ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:vr-rendering-engine ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:real-time-rendering ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:virtual-production-volume ],
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:bridgesTo ngm:production-facility ;
    vc:enables ngm:virtual-production,
        ngm:virtual-production-pipeline ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:virtual-camera,
        ngm:virtual-production-volume ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:requires ngm:real-time-rendering,
        ngm:vr-rendering-engine ;
    vc:slug "virtual-stage" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:game-engine,
        ngm:motion-capture .

ngm:virtual-training a owl:Class ;
    rdfs:label "Virtual Training"@en ;
    rdfs:comment "The use of VR, AR, and simulation technologies to create immersive learning experiences for workforce development, enabling employees to practise skills, rehearse high-stakes scenarios, and learn procedures in safe, repeatable virtual environments with measurable outcomes. Empirical evidence — including Walmart's programme covering over one million employees — demonstrates 75% material retention and up to 4x focus improvement over e-learning. The global market was valued at USD 380 billion in 2024 and is projected to reach USD 1.42 trillion by 2034."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:simulation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:immersive-technology ],
        ngm:ai-application ;
    skos:broader ngm:ai-application ;
    vc:bridgesTo ngm:workforce-development ;
    vc:enables ngm:augmented-connected-workforce,
        ngm:immersive-experience ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:virtual-factory ;
    vc:requires ngm:immersive-technology,
        ngm:simulation ;
    vc:slug "virtual-training" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:immersive-learning,
        ngm:simulation-engine,
        ngm:virtual-environment .

ngm:vision-language-action-models a owl:Class ;
    rdfs:label "Vision-Language-Action Models"@en ;
    rdfs:comment "Vision-language-action (VLA) models are foundation models that jointly process visual observations and natural-language instructions to produce executable action sequences for embodied agents such as robots. Extending vision-language models with an action-generation head, VLAs are trained on large datasets pairing perception and instructions with demonstrated behaviour, enabling generalisation across tasks, objects, and embodiments. They represent a convergence of multimodal learning and robotics, aiming for generalist policies that follow open-ended commands rather than executing narrowly scripted skills."@en ;
    rdfs:subClassOf ngm:vision-language-model ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:embodied-ai,
        ngm:robot-learning ;
    vc:slug "vision-language-action-models" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:imitation-learning,
        ngm:multimodal-ai-architecture-learning .

ngm:voice-input a owl:Class ;
    rdfs:label "Voice Input"@en ;
    rdfs:comment "Voice input is an interaction modality in which spoken language is captured, recognised, and interpreted as commands or content, allowing users to control systems and enter data hands-free. It combines microphone capture, speech recognition, and natural-language understanding to map utterances onto actions or text. In spatial computing, voice input is a primary modality for immersive and accessible interfaces where conventional keyboards and pointers are impractical."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:speech-recognition ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:perception-system ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:speech-recognition ],
        ngm:multimodal-interaction ;
    vc:bridgesTo ngm:spatial-computing ;
    vc:contrastsWith ngm:hand-tracking ;
    vc:enables ngm:accessibility,
        ngm:voice-user-interface ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:speech-recognition ;
    vc:implements ngm:user-interface ;
    vc:isPartOf ngm:human-computer-interaction,
        ngm:multimodal-interaction ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:gaze-tracking,
        ngm:gesture-recognition,
        ngm:virtual-reality ;
    vc:requires ngm:perception-system,
        ngm:speech-recognition ;
    vc:slug "voice-input" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:immersive-interface,
        ngm:spatial-interaction ;
    vc:uses ngm:machine-learning,
        ngm:speech-recognition .

ngm:voronoi-diagram a owl:Class ;
    rdfs:label "Voronoi Diagram"@en ;
    rdfs:comment "A Voronoi diagram is a partition of a plane (or higher-dimensional space) into regions based on proximity to a set of seed points, where each region contains all locations closer to its seed than to any other. It is a foundational structure in computational geometry, dual to the Delaunay triangulation, and supports nearest-neighbour queries, spatial interpolation and procedural generation. Voronoi tessellations appear across spatial analysis, graphics and natural sciences."@en ;
    rdfs:subClassOf ngm:computational-geometry ;
    vc:contrastsWith ngm:delaunay-triangulation ;
    vc:enables ngm:nearest-neighbour-search,
        ngm:procedural-generation,
        ngm:spatial-analysis ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:nearest-neighbour,
        ngm:tessellation ;
    vc:implements ngm:spatial-partitioning ;
    vc:isPartOf ngm:computational-geometry ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:spatial-data-structure,
        ngm:spatial-index ;
    vc:slug "voronoi-diagram" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:geographic-information-system,
        ngm:pathfinding ;
    vc:uses ngm:geometry .

ngm:vr-controllers a owl:Class ;
    rdfs:label "VR Controllers"@en ;
    rdfs:comment "Handheld input devices designed for virtual reality systems that enable users to interact with virtual environments through motion tracking, buttons, triggers, and haptic feedback, providing intuitive manipulation of virtual objects and navigation through immersive spaces."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:motion-tracking ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:haptic-feedback ],
        ngm:sc-interaction,
        ngm:xr-hardware ;
    skos:broader ngm:sc-interaction ;
    vc:enables ngm:hand-tracking,
        ngm:immersive-experience ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:haptic-feedback,
        ngm:motion-tracking ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:human-computer-interaction ;
    vc:slug "vr-controllers" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:virtual-reality-vr .

ngm:vrm-format a owl:Class ;
    rdfs:label "VRM Format"@en ;
    rdfs:comment "An open file format standard for 3D humanoid avatars built on glTF, designed for cross-platform interoperability in VR, AR, and metaverse applications. It incorporates standardised humanoid rigging, facial blend-shape expressions, first-person gaze controls, and embedded licensing metadata, enabling seamless avatar portability across different virtual environments. In 2024 the VRM Consortium began collaboration with the Khronos Group to advance VRM specifications as official glTF extensions for international standardisation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gltf-standard ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:3-d-file-format ],
        ngm:sc-standards-and-interop ;
    skos:broader ngm:sc-standards-and-interop ;
    vc:enables ngm:avatar-interoperability,
        ngm:avatar-portability ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:requires ngm:3-d-file-format,
        ngm:gltf-standard ;
    vc:slug "vrm-format" ;
    vc:sourceDomain "spatial-computing" ;
    vc:standardizedBy ngm:interoperability-standard,
        ngm:open-standard ;
    vc:uses ngm:3-d-model,
        ngm:avatar-standard .

ngm:vulnerability-scanner a owl:Class ;
    rdfs:label "Vulnerability Scanner"@en ;
    rdfs:comment "A vulnerability scanner is a tool that inspects systems, networks or applications to identify known security weaknesses. It compares discovered software and configurations against databases of disclosed vulnerabilities."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:vulnerability ],
        ngm:vulnerability ;
    vc:enables ngm:penetration-testing ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:vulnerability ;
    vc:slug "vulnerability-scanner" ;
    vc:sourceDomain "security" .

ngm:vyper a owl:Class ;
    rdfs:label "Vyper"@en ;
    rdfs:comment "Vyper is a contract-oriented, statically typed programming language for the Ethereum Virtual Machine (EVM) that prioritises security, simplicity, and auditability over expressive power. Inspired by Python syntax, it deliberately omits class inheritance, function overloading, recursive calling, and inline assembly to eliminate entire categories of smart-contract vulnerabilities. The language enforces bounds checking, explicit integer overflow handling, and strong typing so that the compiled EVM bytecode is tractable for formal verification and manual code review. Vyper was initially specified by Vitalik Buterin and the Ethereum Foundation team as a safer companion language to Solidity."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ethereum ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ethereum-smart-contract-platform-virtual-machine ],
        ngm:programming-language ;
    vc:bridgesTo ngm:formal-methods,
        ngm:program-analysis ;
    vc:contrastsWith ngm:solidity,
        ngm:yul ;
    vc:enables ngm:decentralised-finance,
        ngm:formal-verification,
        ngm:smart-contract ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:erc-20,
        ngm:erc-721 ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:compound,
        ngm:curve-finance,
        ngm:open-source-software ;
    vc:requires ngm:ethereum,
        ngm:ethereum-smart-contract-platform-virtual-machine ;
    vc:slug "vyper" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:decentralised-autonomous-organisation,
        ngm:security-audit ;
    vc:uses ngm:abi-encoding,
        ngm:evm,
        ngm:static-typing .

ngm:wavelet-transform a owl:Class ;
    rdfs:label "Wavelet Transform"@en ;
    rdfs:comment "The wavelet transform is a signal-processing technique that represents a signal as a sum of scaled and translated copies of a localised oscillating basis function called a wavelet. Unlike the Fourier transform, which trades all time resolution for frequency resolution, the wavelet transform provides simultaneous time and frequency localisation through multiresolution analysis. It is widely used for compression, denoising and feature extraction in machine-learning pipelines."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:convolution ],
        ngm:signal-processing ;
    vc:bridgesTo ngm:anomaly-detection,
        ngm:computer-vision ;
    vc:contrastsWith ngm:convolution ;
    vc:dependsOn ngm:signal-processing ;
    vc:enables ngm:data-compression,
        ngm:feature-extraction ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:convolution ;
    vc:implements ngm:signal-processing ;
    vc:isPartOf ngm:signal-processing ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:image-processing,
        ngm:pattern-recognition ;
    vc:slug "wavelet-transform" ;
    vc:sourceDomain "machine-learning" ;
    vc:supports ngm:dimensionality-reduction,
        ngm:feature-extraction ;
    vc:uses ngm:convolution .

ngm:web-contracts a owl:Class ;
    rdfs:label "Web Contracts"@en ;
    rdfs:comment "Web Contracts is a transport-agnostic smart-contract system that runs verifiable agreements over plain web files instead of a global blockchain. It separates concerns into four layers: an immutable contract.json (rules in any language), a mutable state.json (a JCS-canonicalised, SHA-256 hash-chained sequence of states), a ledger.json (multi-currency balances), and a Trail that anchors the hash chain to Bitcoin via Block Trails for tamper evidence. Contracts declare effects (credit/debit/transfer) that an executor applies atomically; any verifier can replay the state chain from genesis, check the hashes, and confirm the Bitcoin anchoring, so cheating breaks the chain detectably. Identity is did:nostr and authentication is NIP-98 signed HTTP, which lets both humans (via NIP-07) and autonomous agents participate without global consensus or gas."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:state-machine-replication ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:ledger ],
        ngm:smart-contract ;
    vc:bridgesTo ngm:ai-agent,
        ngm:nostr,
        ngm:solid ;
    vc:contrastsWith ngm:ethereum,
        ngm:smart-contract-execution ;
    vc:dependsOn ngm:proof-of-publication,
        ngm:single-use-seals ;
    vc:enables ngm:automated-market-maker,
        ngm:escrow-system,
        ngm:micropayment ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:ledger,
        ngm:state-machine-replication ;
    vc:implements ngm:client-side-validation ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:web-assembly,
        ngm:x402-and-l402-payment-protocols ;
    vc:slug "web-contracts" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:block-trails,
        ngm:did-nostr,
        ngm:json-data-interchange-format,
        ngm:json-data-interchange-format-schema,
        ngm:sha-256 .

ngm:weight-sharing a owl:Class ;
    rdfs:label "Weight Sharing"@en ;
    rdfs:comment "Weight sharing is a neural-network design technique in which the same set of learnable parameters is reused across multiple positions, time steps, or model components rather than learning independent parameters for each. By tying parameters together it dramatically reduces model size, encodes structural priors such as translation invariance, and improves data efficiency and generalisation. It is the defining mechanism of convolutional layers, which apply one filter across all spatial locations, and of recurrent networks, which reuse the same transition weights across every time step. Weight sharing also appears in Siamese architectures, in neural architecture search, and in parameter-efficient model designs."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:convolution ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:parameter ],
        ngm:neural-network ;
    vc:contrastsWith ngm:overfitting ;
    vc:dependsOn ngm:neural-network ;
    vc:enables ngm:convolutional-neural-network,
        ngm:transfer-learning ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:convolution,
        ngm:parameter ;
    vc:implements ngm:model-architecture ;
    vc:isPartOf ngm:neural-architecture-search ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:attention-mechanism,
        ngm:convolutional-neural-network,
        ngm:recurrent-neural-network,
        ngm:transformer ;
    vc:slug "weight-sharing" ;
    vc:sourceDomain "machine-learning" ;
    vc:supports ngm:deep-learning ;
    vc:uses ngm:convolution,
        ngm:parameter .

ngm:wheel-odometry a owl:Class ;
    rdfs:label "Wheel Odometry"@en ;
    rdfs:comment "Wheel odometry is a method of estimating a mobile robot's change in position and orientation by counting wheel rotations measured with encoders and applying a kinematic motion model. As an instance of dead reckoning, it integrates incremental wheel displacement over time to track pose relative to a starting point. It is simple and low-cost but accumulates drift from wheel slip, uneven terrain and calibration error, so it is typically fused with other sensors."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:calibration ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:motion-model ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:encoder ],
        ngm:odometry ;
    vc:contrastsWith ngm:visual-odometry ;
    vc:dependsOn ngm:mobile-robot ;
    vc:enables ngm:localization,
        ngm:navigation,
        ngm:pose-estimation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:encoder ;
    vc:implements ngm:dead-reckoning ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:inertial-measurement-unit,
        ngm:odometry ;
    vc:requires ngm:calibration,
        ngm:motion-model ;
    vc:slug "wheel-odometry" ;
    vc:sourceDomain "robotics" ;
    vc:supports ngm:sensor-fusion,
        ngm:slam ;
    vc:uses ngm:encoder,
        ngm:kinematics .

ngm:wheeled-robot a owl:Class ;
    rdfs:label "Wheeled Robot"@en ;
    rdfs:comment "A Wheeled Robot is a mobile robot platform that uses wheels as its primary locomotion mechanism. Wheeled robots offer high energy efficiency and speed on flat terrain, making them dominant in warehouse automation, last-mile delivery, and research platforms. Differential drive, omnidirectional, and car-like Ackermann steering configurations each present distinct kinematic constraints that influence navigation algorithm design."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:odometry ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:navigation ],
        ngm:robo-robot-type ;
    skos:broader ngm:robo-robot-type ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:mobile-robot ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:navigation,
        ngm:odometry ;
    vc:slug "wheeled-robot" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:robot-operating-system,
        ngm:slam .

ngm:whisper a owl:Class ;
    rdfs:label "Whisper"@en ;
    rdfs:comment "Whisper is an automatic speech recognition model from OpenAI trained on a large multilingual dataset. It transcribes and translates speech across many languages and is released as open source."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:attention-mechanism ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:transformer ],
        ngm:automatic-speech-recognition ;
    vc:enables ngm:speech-recognition,
        ngm:translation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:attention-mechanism,
        ngm:transformer ;
    vc:slug "whisper" ;
    vc:sourceDomain "ai" .

ngm:wiener-process a owl:Class ;
    rdfs:label "Wiener Process"@en ;
    rdfs:comment "The Wiener process, also called standard Brownian motion, is a continuous-time stochastic process characterised by independent, stationary, normally distributed increments starting at zero, with continuous but nowhere-differentiable sample paths. It is the canonical mathematical model of random continuous motion and the foundational driver of stochastic calculus and diffusion equations. The Wiener process underpins models in finance, physics, and the noise schedules of diffusion generative models."@en ;
    rdfs:subClassOf ngm:optimisation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:generative-model,
        ngm:stochastic-process ;
    vc:slug "wiener-process" ;
    vc:sourceDomain "data" .

ngm:word-embeddings a owl:Class ;
    rdfs:label "Word Embeddings"@en ;
    rdfs:comment "Word embeddings are dense, real-valued vector representations of words learned so that semantic and syntactic relationships are reflected as geometric relationships in a continuous vector space. Words with similar meanings map to nearby points, and linear offsets often capture analogical structure. They are learned from large text corpora by predicting words from their contexts, and replaced sparse one-hot encodings as the default input representation for natural language processing. Word embeddings underpin downstream tasks from classification to machine translation and serve as the conceptual precursor to contextual representations produced by transformer models."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:embedding ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:tokenization ],
        ngm:representation-learning ;
    vc:bridgesTo ngm:transformer ;
    vc:contrastsWith ngm:bert ;
    vc:dependsOn ngm:neural-network,
        ngm:representation-learning ;
    vc:enables ngm:language-model,
        ngm:natural-language-processing ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:embedding ;
    vc:implements ngm:embedding ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:cosine-similarity,
        ngm:dimensionality-reduction,
        ngm:language-model ;
    vc:requires ngm:tokenization ;
    vc:slug "word-embeddings" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:natural-language-processing ;
    vc:uses ngm:neural-network,
        ngm:tokenization .

ngm:workspace-analysis a owl:Class ;
    rdfs:label "Workspace Analysis"@en ;
    rdfs:comment "Workspace analysis determines the set of poses a robot's end-effector can reach, characterising the reachable and dexterous workspaces of a manipulator. It uses forward kinematics and joint-limit constraints to map the volume and shape of attainable positions and orientations. Workspace analysis guides robot selection, cell layout, task placement and reachability assessment for a given manipulator."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:kinematics-model ],
        ngm:kinematics ;
    vc:bridgesTo ngm:end-effector ;
    vc:contrastsWith ngm:singularity-analysis ;
    vc:dependsOn ngm:forward-kinematics ;
    vc:enables ngm:motion-planning,
        ngm:trajectory-planning ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:kinematics ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:forward-kinematics,
        ngm:singularity-analysis ;
    vc:requires ngm:kinematics-model ;
    vc:slug "workspace-analysis" ;
    vc:sourceDomain "robotics" ;
    vc:supports ngm:manipulator,
        ngm:robot-control ;
    vc:uses ngm:forward-kinematics,
        ngm:kinematics-model .

ngm:wormhole a owl:Class ;
    rdfs:label "Wormhole"@en ;
    rdfs:comment "Wormhole is a decentralised, generic cross-chain messaging and asset-transfer protocol that connects heterogeneous blockchain networks by relying on a permissioned guardian network whose supermajority attestations produce signed Verified Action Approval (VAA) messages. On-chain core contracts on each supported network verify VAAs to lock, mint, or burn assets and to route arbitrary data payloads, making Wormhole a general-purpose interoperability layer rather than a simple token bridge. Originally launched in 2020 as a Solana–Ethereum wrapped-asset bridge by Certus One, it has expanded to support over 30 layer-1 and layer-2 ecosystems under stewardship of the independent Wormhole Foundation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:event-log ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:validator-node ],
        ngm:cross-chain-bridge ;
    vc:bridgesTo ngm:intent-based-bridging,
        ngm:zero-knowledge-proof ;
    vc:contrastsWith ngm:axelar,
        ngm:ibc,
        ngm:layer-zero,
        ngm:light-client ;
    vc:enables ngm:cross-chain-asset-transfer,
        ngm:cross-chain-messaging,
        ngm:nft-bridging,
        ngm:token-bridging ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:multichain-ecosystem ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:blockchain-interoperability,
        ngm:cross-chain-interoperability,
        ngm:decentralised-finance,
        ngm:governance-token,
        ngm:oracle-network ;
    vc:requires ngm:event-log,
        ngm:quorum-consensus,
        ngm:validator-node ;
    vc:slug "wormhole" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:lock-and-mint-mechanism,
        ngm:multisignature,
        ngm:smart-contract .

ngm:x402-and-l402-payment-protocols a owl:Class ;
    rdfs:label "x402 and l402 payment protocols"@en ;
    rdfs:comment "x402 and l402 payment protocols is a blockchain and distributed systems concept and a type of blockchain."@en ;
    rdfs:subClassOf ngm:bc-defi-and-economics ;
    skos:broader ngm:bc-defi-and-economics ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:implements ngm:blockchain ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:slug "x402-and-l402-payment-protocols" ;
    vc:sourceDomain "blockchain" .

ngm:xapi a owl:Class ;
    rdfs:label "Xapi"@en ;
    rdfs:comment "xAPI (the Experience API, also known as Tin Can API) is an e-learning interoperability specification that captures learning experiences as actor-verb-object statements sent to a Learning Record Store. Unlike SCORM, it records learning that occurs outside a single course or platform, including informal, mobile and simulation-based activity. xAPI underpins rich learning analytics by providing a flexible, standardised data model."@en ;
    rdfs:subClassOf ngm:education-technology ;
    vc:contrastsWith ngm:learning-management-system ;
    vc:enables ngm:learning-analytics ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:data-interoperability,
        ngm:metadata ;
    vc:isPartOf ngm:education-technology ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:adaptive-learning ;
    vc:slug "xapi" ;
    vc:sourceDomain "spatial-computing" ;
    vc:standardizedBy ngm:interoperability,
        ngm:standards ;
    vc:uses ngm:metadata .

ngm:xr-accessibility-guideline a owl:Class ;
    rdfs:label "XR Accessibility Guideline"@en ;
    rdfs:comment "Design recommendations and best practices ensuring XR applications and immersive experiences are usable by people with diverse abilities and disabilities."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:user-research ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
