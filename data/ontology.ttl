    vc:relatedTo ngm:metaverse-content-pipeline ;
    vc:relatedTo ngm:virtual-production-volume ;
    vc:slug "real-time-rendering-engine" ;
    vc:sourceDomain "metaverse" .
ngm:real-time-rendering-pipeline a owl:Class ;
    rdfs:comment "Sequence of GPU processes converting 3D scene data into visual frames at interactive rates (typically 30-120+ FPS)."@en ;
    rdfs:label "Real-Time Rendering Pipeline"@en ;
    rdfs:subClassOf ngm:render-pipeline ;
    rdfs:subClassOf ngm:sc-display-and-rendering ;
