        ngm:presence-detection ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:social-presence ;
    vc:requires ngm:collision-detection,
        ngm:sensor-fusion ;
    vc:slug "proximity-detection" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:lidar,
        ngm:point-cloud .

ngm:prudential-regulation-authority a skos:Concept ;
