ngm:telemetry-and-analytics a owl:Class ;
    rdfs:label "Telemetry & Analytics"@en ;
    rdfs:comment "Systematic collection and analysis of usage and performance data from metaverse applications and platforms to enable monitoring, optimization, and decision-making."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
