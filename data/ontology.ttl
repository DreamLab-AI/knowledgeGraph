ngm:granular-consent-control a owl:Class ;
    rdfs:label "Granular Consent Control"@en ;
    rdfs:comment "Privacy management mechanisms enabling users to selectively authorise specific types of data collection and processing within metaverse environments, allowing separate consent decisions for analytics, advertising, cross-device tracking, and data transfers while maintaining GDPR compliance and use..."@en ;
