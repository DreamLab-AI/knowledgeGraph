ngm:convolutional-neural-network a owl:Class ;
    rdfs:label "Convolutional Neural Network"@en ;
    rdfs:comment "A Convolutional Neural Network (CNN) is a feed-forward deep learning architecture that applies learned convolutional filters across spatial dimensions of input data, enabling hierarchical feature extraction from images and other grid-structured inputs. Weight sharing and local receptive fields make CNNs highly parameter-efficient for visual recognition tasks including image classification, object detection, and semantic segmentation."@en ;
    rdfs:subClassOf ngm:ai-model-architecture ;
    skos:broader ngm:ai-model-architecture ;
    vc:contrastsWith ngm:recurrent-neural-network ;
    vc:enables ngm:image-classification,
        ngm:object-detection ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:slug "convolutional-neural-network" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:computer-vision ;
    vc:uses ngm:backpropagation,
        ngm:training-data .

ngm:gdpr-compliance a owl:Class ;
    rdfs:label "GDPR Compliance"@en ;
    rdfs:comment "GDPR Compliance refers to the totality of organisational, technical, and procedural measures an entity must implement to satisfy obligations under the EU General Data Protection Regulation (Regulation 2016/679), including lawful bases for processing, data subject rights fulfilment, data-breach notification, and appointment of a Data Protection Officer where required. The regulation applies extraterritorially to any organisation processing personal data of EU data subjects, regardless of where processing occurs. Compliance programmes span privacy-by-design principles, data minimisation, consent management, audit trails, and demonstrable accountability to supervisory authorities."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:privacy-by-design ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:consent-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-protection ],
        ngm:infra-legal-and-regulatory ;
    skos:broader ngm:infra-legal-and-regulatory ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:ai-governance,
        ngm:data-governance,
        ngm:data-minimisation ;
    vc:requires ngm:consent-management,
        ngm:data-protection,
        ngm:privacy-by-design ;
    vc:slug "gdpr-compliance" ;
    vc:sourceDomain "infrastructure" .

ngm:latency a owl:Class ;
    rdfs:label "Latency"@en ;
    rdfs:comment "Virtual performance metric representing the time delay between a user action and corresponding system response within networked immersive environments."@en ;
