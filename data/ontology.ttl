ngm:display-capture a owl:Class ;
    rdfs:label "Display Capture"@en ;
    rdfs:comment "Display capture is the acquisition of the live pixel contents of a screen, window, or application surface as a video stream for recording or transmission. On the web it is exposed through the Screen Capture API's getDisplayMedia method, which prompts the user to choose a surface and returns a media stream subject to permission. It is the foundational capability behind screen recording and real-time screen sharing."@en ;
    rdfs:subClassOf ngm:dc-telepresence ;
    skos:broader ngm:dc-telepresence ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:screen-recording,
        ngm:screen-sharing ;
    vc:slug "display-capture" ;
    vc:sourceDomain "infrastructure" .

ngm:distributed-systems-security a owl:Class ;
    rdfs:label "Distributed Systems Security"@en ;
    rdfs:comment "Distributed systems security is the discipline of protecting confidentiality, integrity and availability across systems whose components run on separate machines and communicate over untrusted networks. It addresses threats unique to distribution, including partial failure, Byzantine participants, replay and partition attacks, and the absence of a single trusted authority. Techniques span authenticated and encrypted channels, fault-tolerant consensus, access control and threat modelling tailored to the multi-node setting."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:access-control ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptography ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:authentication ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:consensus-algorithm ],
        ngm:security ;
    vc:bridgesTo ngm:blockchain-security,
        ngm:distributed-systems ;
    vc:dependsOn ngm:cryptography,
        ngm:threat-model ;
    vc:enables ngm:fault-tolerance,
        ngm:zero-trust-architecture ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:access-control,
        ngm:authentication ;
    vc:isPartOf ngm:distributed-systems ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:network-security ;
    vc:requires ngm:consensus-algorithm,
        ngm:cryptography ;
    vc:slug "distributed-systems-security" ;
    vc:sourceDomain "security" ;
    vc:supports ngm:intrusion-detection,
        ngm:replication ;
    vc:uses ngm:byzantine-fault-tolerance,
        ngm:network-security .

ngm:distributed-teamwork a owl:Class ;
    rdfs:label "Distributed Teamwork"@en ;
    rdfs:comment "Distributed teamwork is the coordinated effort of team members who are geographically dispersed and collaborate primarily through digital and immersive tools rather than co-located presence. It addresses the challenges of time-zone separation, reduced informal contact, and asynchronous decision-making by combining shared artefacts, communication norms, and presence technologies. In spatial computing, distributed teamwork increasingly leverages virtual environments that recreate co-presence and shared spatial context for remote collaborators."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:knowledge-sharing ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:virtual-meeting ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:asynchronous-communication ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:collaboration ],
        ngm:distributed-collaboration ;
    skos:broader ngm:distributed-collaboration ;
    vc:bridgesTo ngm:spatial-computing,
        ngm:virtual-collaboration ;
    vc:enables ngm:remote-work,
        ngm:virtual-collaboration ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:knowledge-sharing,
        ngm:virtual-meeting ;
    vc:isPartOf ngm:distributed-collaboration ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:distributed-collaboration,
        ngm:remote-work ;
    vc:requires ngm:asynchronous-communication,
        ngm:collaboration ;
    vc:slug "distributed-teamwork" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:co-presence,
        ngm:knowledge-sharing ;
    vc:uses ngm:immersive-communication,
        ngm:telepresence,
        ngm:virtual-meeting .

ngm:distributed-transaction a owl:Class ;
    rdfs:label "Distributed Transaction"@en ;
    rdfs:comment "A distributed transaction is a unit of work whose operations span two or more independent data stores, services or network nodes, yet must complete with all-or-nothing atomicity across every participant. Coordinating such a transaction requires protocols that agree on a single outcome despite partial failures, network partitions and concurrent activity at each site. Classical coordination uses atomic commit protocols, while modern systems often relax strict atomicity for availability using compensating workflows."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:two-phase-commit ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:consensus ],
        ngm:transaction-processing ;
    vc:bridgesTo ngm:saga-pattern,
        ngm:two-phase-commit ;
    vc:dependsOn ngm:consensus ;
    vc:enables ngm:atomic-settlement ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:saga-pattern ;
    vc:isPartOf ngm:transaction-processing ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:atomic-settlement,
        ngm:transaction-processing ;
    vc:requires ngm:consensus,
        ngm:two-phase-commit ;
    vc:slug "distributed-transaction" ;
    vc:sourceDomain "distributed-systems" ;
    vc:supports ngm:atomic-settlement ;
    vc:uses ngm:consensus .

ngm:dlss a owl:Class ;
    rdfs:label "DLSS"@en ;
    rdfs:comment "DLSS (Deep Learning Super Sampling) is NVIDIA's family of AI-based rendering techniques that use neural networks running on dedicated tensor hardware to reconstruct high-resolution, high-frame-rate images from lower-resolution rendered inputs. By upscaling, accumulating temporal information, and generating intermediate frames, DLSS delivers image quality approaching or exceeding native rendering at a fraction of the GPU cost, enabling demanding effects such as real-time ray tracing to run smoothly. It exemplifies the integration of learned models into the real-time graphics pipeline."@en ;
    rdfs:subClassOf ngm:rendering-technology ;
    vc:enables ngm:real-time-rendering ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:neural-rendering,
        ngm:rendering-pipeline ;
    vc:slug "dlss" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:deep-learning,
        ngm:gpu .

ngm:dlt a owl:Class ;
    rdfs:label "DLT"@en ;
    rdfs:comment "Distributed Ledger Technology (DLT) is a class of systems in which transaction records are replicated, shared, and synchronised across multiple nodes without a single central authority. Blockchains are one form of DLT, but the term also covers directed-acyclic-graph and other non-chained ledger structures. DLT underpins many digital-asset and central-bank-digital-currency designs because it provides tamper-evidence, auditability, and resilience."@en ;
    rdfs:subClassOf ngm:distributed-data-structure ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:cbdc-frameworks,
        ngm:cbdcs ;
    vc:slug "dlt" ;
    vc:sourceDomain "blockchain" .

ngm:document-comments a owl:Class ;
    rdfs:label "Document Comments"@en ;
    rdfs:comment "Document Comments are annotations anchored to specific sections of a shared document that allow collaborators to ask questions, suggest changes, or provide feedback without altering the primary content. They support threaded replies, @mentions, and resolution states so discussions are traceable and actionable. This asynchronous feedback mechanism is essential for distributed review workflows across time zones."@en ;
    rdfs:subClassOf ngm:dc-workspace-tools ;
    skos:broader ngm:dc-workspace-tools ;
    vc:enables ngm:asynchronous-collaboration,
        ngm:peer-review ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:live-co-authoring ;
    vc:slug "document-comments" ;
    vc:sourceDomain "distributed-collaboration" .

ngm:document-processing a skos:Concept ;
    rdfs:label "Document Processing"@en .

ngm:domain-access-control a owl:Class ;
    rdfs:label "Domain Access Control"@en ;
    rdfs:comment "Domain Access Control is the set of mechanisms that govern which users, avatars, or services may enter, view, or modify resources within a bounded virtual-world domain or server cluster. In metaverse platforms it enforces ownership and permission boundaries at the level of a hosted domain, mediating connection requests and content rights. It is foundational to multi-tenant virtual environments where independent operators host interoperable spaces."@en ;
    rdfs:subClassOf ngm:sc-governance-and-safety ;
    skos:broader ngm:sc-governance-and-safety ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:vircadia ;
    vc:slug "domain-access-control" ;
    vc:sourceDomain "metaverse" .

ngm:drake a owl:Class ;
    rdfs:label "Drake"@en ;
    rdfs:comment "Drake is an open-source C++/Python toolbox for model-based design and verification of robotics systems, originally developed at MIT and maintained by the Toyota Research Institute. It provides rigorous multibody dynamics, kinematics, and optimisation tooling, including analytical gradients, contact modelling, and trajectory optimisation. Drake is widely used for simulating manipulators and mobile robots and for solving collision-detection and motion-planning problems."@en ;
    rdfs:subClassOf ngm:robo-navigation-and-planning ;
    skos:broader ngm:robo-navigation-and-planning ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:collision-detection,
        ngm:kinematics-model ;
    vc:slug "drake" ;
    vc:sourceDomain "robotics" .

ngm:dreamlab-creative-technology-collective a owl:Class ;
    rdfs:label "DreamLab Creative Technology Collective"@en ;
    rdfs:comment "Dreamlab is a UK-based creative technologist collective offering multidisciplinary services spanning AI and machine learning, virtual production, immersive XR experiences, generative media, spatial computing, and strategic R&D partnerships. It operates at the intersection of advanced AI infrastructure, real-time rendering, and immersive storytelling for creative and enterprise clients."@en ;
