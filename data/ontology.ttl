ngm:navigation-mesh a owl:Class ;
    rdfs:label "Navigation Mesh"@en ;
    rdfs:comment "A navigation mesh (navmesh) is a data structure that decomposes the traversable area of a virtual environment into a set of convex polygons over which an agent can move freely. By abstracting walkable space into connected regions, it enables efficient pathfinding without searching a dense uniform grid. Navmeshes are the standard representation for movement and obstacle avoidance in game AI and simulated 3D worlds."@en ;
    rdfs:subClassOf ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:ai-game-agent,
        ngm:ai-in-games ;
    vc:slug "navigation-mesh" ;
    vc:sourceDomain "ai" .

ngm:navigation-system a owl:Class ;
    rdfs:label "Navigation System"@en ;
    rdfs:comment "An integrated set of hardware and software components that enables a robot or autonomous agent to determine its position, plan collision-free paths, and execute motion towards a goal. Navigation systems typically combine localisation, mapping, path planning, and obstacle avoidance modules, often relying on sensor fusion from LiDAR, cameras, and IMUs."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:slam ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:obstacle-avoidance ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:localization ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:sensor ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:path-planning ],
        ngm:robo-navigation-and-planning ;
    skos:broader ngm:robo-navigation-and-planning ;
    vc:enables ngm:autonomous-vehicle,
        ngm:mobile-robot ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:localization,
        ngm:obstacle-avoidance,
        ngm:path-planning ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:requires ngm:sensor,
        ngm:slam ;
    vc:slug "navigation-system" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:lidar,
        ngm:motion-planning .

ngm:nearest-neighbor-search a owl:Class ;
    rdfs:label "Nearest Neighbor Search"@en ;
    rdfs:comment "Nearest Neighbor Search (NNS) is an algorithmic problem and family of techniques for finding the point(s) in a dataset most similar to a given query point, as measured by a distance or similarity metric such as Euclidean distance, cosine similarity, or inner product. Exact NNS guarantees retrieval of the true closest point but scales poorly in high dimensions, while Approximate Nearest Neighbor (ANN) methods trade a bounded loss in recall for dramatically faster query latency and memory efficiency. Foundational index structures — including KD-Trees, Ball Trees, Locality-Sensitive Hashing, Inverted File Indexes, and Hierarchical Navigable Small World graphs — each make different trade-offs between construction cost, query speed, recall, and support for dynamic updates. NNS is a core primitive of modern machine learning pipelines, powering vector database retrieval, recommendation systems, semantic search, image recognition, and retrieval-augmented generation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:locality-sensitive-hashing ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:vector-embedding ],
        ngm:search-algorithm ;
    vc:bridgesTo ngm:knowledge-graph-embedding,
        ngm:spatial-indexing ;
    vc:contrastsWith ngm:exact-search,
        ngm:keyword-search ;
    vc:dependsOn ngm:embedding-model,
        ngm:vector-database ;
    vc:enables ngm:image-retrieval,
        ngm:recommendation-system,
        ngm:retrieval-augmented-generation,
        ngm:semantic-search ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:approximate-nearest-neighbor,
        ngm:hnsw,
        ngm:inverted-file-index,
        ngm:locality-sensitive-hashing ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:dimensionality-reduction,
        ngm:faiss,
        ngm:quantisation ;
    vc:requires ngm:distance-metric,
        ngm:vector-embedding ;
    vc:slug "nearest-neighbor-search" ;
    vc:sourceDomain "machine-learning" ;
    vc:uses ngm:cosine-similarity,
        ngm:euclidean-distance,
        ngm:kd-tree .

