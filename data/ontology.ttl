ngm:multimodal-ai-architecture a owl:Class ;
    rdfs:label "Multimodal AI Architecture"@en ;
    rdfs:comment "Multimodal AI refers to artificial intelligence systems that process, fuse, and generate content across multiple data modalities—including text, images, audio, video, and 3D—within a unified model architecture. Multimodal systems learn cross-modal alignments through joint embedding spaces, enabling capabilities such as image captioning, visual question answering, text-to-image synthesis, and real-time audio-visual understanding that single-modality models cannot achieve."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:computer-vision ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:large-language-models ],
        ngm:ai-model-architecture,
        ngm:ai-research-area ;
    skos:broader ngm:ai-model-architecture,
        ngm:ai-research-area ;
    vc:enables ngm:image-generation,
        ngm:text-to-speech ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:relatedTo ngm:diffusion-models,
        ngm:multimodal-ai-architecture-ai,
        ngm:speech-recognition ;
    vc:requires ngm:computer-vision,
        ngm:large-language-models ;
    vc:slug "multimodal-ai-architecture" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:mutual-tls a owl:Class ;
    rdfs:label "Mutual TLS"@en ;
    rdfs:comment "Mutual TLS is a configuration of the Transport Layer Security protocol in which both the client and the server present and verify X.509 certificates, establishing bidirectional authentication rather than authenticating only the server. Each party proves possession of the private key corresponding to its certificate, which a trusted certificate authority has signed. It is widely used to secure service-to-service communication in zero-trust architectures and microservice meshes. By binding identity to the transport channel, it prevents impersonation and unauthorised connections."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:x-509-certificate ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:certificate-authority ],
        ngm:transport-layer-security ;
    vc:contrastsWith ngm:server-side-tls ;
    vc:dependsOn ngm:encryption,
        ngm:public-key-infrastructure ;
    vc:enables ngm:authentication,
        ngm:zero-trust-architecture ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:mutual-authentication ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:access-control,
        ngm:identity-management ;
    vc:requires ngm:certificate-authority,
        ngm:x-509-certificate ;
    vc:slug "mutual-tls" ;
    vc:sourceDomain "security" ;
    vc:supports ngm:microservices,
        ngm:service-mesh ;
    vc:uses ngm:asymmetric-cryptography,
        ngm:tls-handshake .

ngm:net-zero-targets a owl:Class ;
    rdfs:label "Net Zero Targets"@en ;
    rdfs:comment "Net Zero Targets are formal, time-bound commitments made by governments, corporations, subnational jurisdictions, or other entities to reduce gross greenhouse gas emissions as deeply as feasible and to balance any residual emissions with equivalent, verified carbon removals, thereby reaching a net-zero contribution to atmospheric greenhouse gas concentrations by a specified date. They typically distinguish near-term absolute reduction milestones across Scope 1, 2, and 3 emissions from longer-term residual-offset strategies, and are calibrated against the IPCC's 1.5 °C-consistent pathways. Credible targets are characterised by transparent interim milestones, independent third-party verification, and a clear accounting boundary that separates genuine emission reductions from carbon offsetting."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:third-party-verification ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:carbon-accounting ],
        ngm:climate-commitments ;
    vc:bridgesTo ngm:climate-risk-disclosure,
        ngm:esg-reporting ;
    vc:contrastsWith ngm:carbon-neutrality,
        ngm:climate-commitments ;
    vc:dependsOn ngm:energy-efficiency,
        ngm:renewable-energy,
        ngm:voluntary-carbon-market ;
    vc:enables ngm:climate-change-mitigation,
        ngm:green-finance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:climate-policy,
        ngm:sustainable-development ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:greenwashing,
