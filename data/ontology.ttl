    vc:slug "narrative-structure" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:character-model .

ngm:narrative-theme a owl:Class ;
    rdfs:label "Narrative Theme"@en ;
    rdfs:comment "The underlying message, central idea, or motif that pervades a story and shapes public perception, constructed through selective framing, language choices, and emphasis on particular details to guide audience interpretation of events, characters, and meaning."@en ;
    rdfs:subClassOf ngm:narrative-structure,
