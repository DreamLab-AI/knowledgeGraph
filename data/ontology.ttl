        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:entropy-source ],
        ngm:cryptographic-primitive ;
    vc:bridgesTo ngm:blockchain,
        ngm:hardware-security-module,
        ngm:trusted-platform-module ;
    vc:contrastsWith ngm:random-number-generator ;
    vc:enables ngm:asymmetric-encryption,
