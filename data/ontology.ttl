ngm:compliance-layer a owl:Class ;
    rdfs:label "Compliance Layer"@en ;
    rdfs:comment "The Compliance Layer is the cross-cutting stratum that checks system behaviour against external obligations such as law, regulation, and contractual terms. It sits above the Policy Layer, consuming its enforcement records, and reports to the Regulatory and Governance Layers. It contains controls, evidence collection, audit trails, and conformance assessments rather than the operations being assessed."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:governance-layer ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:policy-layer ],
        ngm:infra-legal-and-regulatory ;
    skos:broader ngm:infra-legal-and-regulatory ;
    vc:enables ngm:institutional-layer,
        ngm:regulatory-layer ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:governance-layer,
        ngm:policy-layer ;
    vc:slug "compliance-layer" ;
    vc:sourceDomain "governance" .

ngm:compliance-testing a owl:Class ;
    rdfs:label "Compliance Testing"@en ;
    rdfs:comment "Compliance testing is the systematic verification that a product, system, or process conforms to a defined standard, specification, or regulatory requirement. It produces objective, repeatable measurements that are compared against documented acceptance criteria to determine pass or fail status. It is a core component of validation and certification workflows, providing the evidentiary basis for conformity claims."@en ;
    rdfs:subClassOf ngm:regulatory-compliance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:display-metrology,
        ngm:validation-process ;
    vc:slug "compliance-testing" ;
    vc:sourceDomain "governance" .

ngm:compression-function a owl:Class ;
    rdfs:label "Compression Function"@en ;
    rdfs:comment "A compression function is a fixed-input-length cryptographic primitive that maps two inputs (a chaining value and a message block) to a single shorter output. It is the core building block of iterated hash functions, where it is applied repeatedly under constructions such as Merkle-Damgard to process arbitrary-length messages. Its collision and preimage resistance directly determine the security of the hash function built on top of it."@en ;
    rdfs:subClassOf ngm:cryptographic-primitive ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:hash-function ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:hash-function ;
    vc:slug "compression-function" ;
    vc:sourceDomain "security" .

ngm:computational-graph a owl:Class ;
    rdfs:label "Computational Graph"@en ;
    rdfs:comment "A computational graph is a directed acyclic graph in which nodes represent mathematical operations or variables and edges represent the flow of data (tensors) between them. It provides the structural backbone for evaluating composite functions and for computing gradients through automatic differentiation. Deep learning frameworks construct such graphs either statically ahead of execution or dynamically during the forward pass, then traverse them in reverse to propagate derivatives."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:tensor ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:loss-function ],
        ngm:automatic-differentiation ;
    vc:bridgesTo ngm:deep-learning ;
    vc:contrastsWith ngm:optimization-algorithm ;
    vc:dependsOn ngm:automatic-differentiation ;
    vc:enables ngm:automatic-differentiation,
        ngm:backpropagation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:loss-function ;
    vc:implements ngm:deep-learning-framework ;
    vc:isPartOf ngm:deep-learning-framework ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:gradient,
        ngm:neural-network ;
    vc:requires ngm:tensor ;
    vc:slug "computational-graph" ;
    vc:sourceDomain "machine-learning" ;
    vc:supports ngm:gradient-descent,
        ngm:stochastic-gradient-descent ;
    vc:uses ngm:tensor .

ngm:compute-cluster a owl:Class ;
    rdfs:label "Compute Cluster"@en ;
    rdfs:comment "A compute cluster is a collection of interconnected computers that work together as a single system to execute large or parallel workloads. Nodes are coordinated by a scheduler that allocates jobs across processors, accelerators, and memory, sharing high-speed networking and often a common storage fabric. Clusters underpin large-scale model training, simulation, and data processing where a single machine cannot supply enough compute."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:scheduler ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:resource-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gpu ],
        ngm:high-performance-computing ;
    vc:dependsOn ngm:cloud-computing,
        ngm:data-center ;
    vc:enables ngm:distributed-training,
        ngm:model-training ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:isPartOf ngm:high-performance-computing ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:data-center,
        ngm:deep-learning,
        ngm:distributed-computing ;
    vc:requires ngm:gpu,
        ngm:resource-management,
        ngm:scheduler ;
    vc:slug "compute-cluster" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:batch-processing,
        ngm:mlops ;
    vc:uses ngm:kubernetes,
        ngm:parallel-computing .

ngm:computer-use a owl:Class ;
    rdfs:label "Computer Use"@en ;
    rdfs:comment "Computer Use is an AI capability that enables multimodal models to perceive, navigate, and interact with graphical user interfaces, desktop applications, and operating system environments to autonomously complete multi-step tasks. The model receives screenshot observations of the screen and emits mouse-click, keyboard, and scroll actions, effectively operating software as a human operator would. It extends conventional tool-use paradigms by treating the entire GUI surface as an action space rather than a structured API."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:multimodal-ai-architecture ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:tool-use ],
        ngm:ai-application ;
    skos:broader ngm:ai-application ;
    vc:enables ngm:autonomous-agent,
        ngm:workflow-automation ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:interface ;
    vc:requires ngm:multimodal-ai-architecture,
        ngm:tool-use ;
    vc:slug "computer-use" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:connectionist-temporal-classification a owl:Class ;
    rdfs:label "Connectionist Temporal Classification"@en ;
    rdfs:comment "Connectionist Temporal Classification (CTC) is a sequence-modelling loss function and decoding scheme that trains neural networks to map unsegmented input sequences to output label sequences without requiring pre-aligned data. It introduces a blank symbol and marginalises over all valid alignments, allowing a network to learn the alignment implicitly during training. CTC is widely used in speech recognition and handwriting recognition where input and output lengths differ and frame-level labels are unavailable."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:recurrent-neural-network ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:loss-function ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:neural-network ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:alignment ],
        ngm:speech-recognition ;
    vc:contrastsWith ngm:attention-mechanism,
        ngm:transformer ;
    vc:dependsOn ngm:deep-learning,
        ngm:machine-learning ;
    vc:enables ngm:automatic-speech-recognition,
        ngm:real-time-translation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:alignment,
        ngm:loss-function ;
    vc:implements ngm:sequence-to-sequence,
        ngm:speech-to-text ;
    vc:isPartOf ngm:speech-recognition ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:acoustic-model,
        ngm:language-model ;
    vc:requires ngm:neural-network,
        ngm:recurrent-neural-network ;
    vc:slug "connectionist-temporal-classification" ;
    vc:sourceDomain "distributed-collaboration" ;
    vc:uses ngm:beam-search,
        ngm:loss-function,
        ngm:lstm .

ngm:consumer-price-index a owl:Class ;
    rdfs:label "Consumer Price Index"@en ;
    rdfs:comment "The Consumer Price Index (CPI) is a statistical measure that tracks the average change over time in the prices paid by households for a representative basket of consumer goods and services. It is the principal indicator used to quantify inflation, adjust wages and benefits, and inform monetary policy. The index is computed by weighting price observations according to typical household expenditure patterns and rebasing them against a reference period."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:statistics ],
        ngm:macroeconomics ;
    vc:bridgesTo ngm:inflation-targeting,
        ngm:price-stability ;
    vc:contrastsWith ngm:economic-growth ;
    vc:enables ngm:central-bank ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:inflation-targeting ;
    vc:isPartOf ngm:macroeconomics ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:central-bank,
        ngm:economic-growth,
        ngm:economics,
        ngm:inflation ;
    vc:requires ngm:statistics ;
    vc:slug "consumer-price-index" ;
    vc:sourceDomain "finance" ;
    vc:supports ngm:fiscal-policy,
        ngm:monetary-policy ;
    vc:uses ngm:price-stability,
        ngm:statistics .

ngm:contact-mechanics a owl:Class ;
    rdfs:label "Contact Mechanics"@en ;
    rdfs:comment "Contact mechanics is the study of the forces, deformations, and motions that arise when solid bodies touch and interact at their surfaces. It models phenomena such as normal contact forces, friction, adhesion, and local deformation, and provides the constitutive laws that govern how bodies push against, stick to, and slide over one another. In robotics it is essential for grasping, manipulation, locomotion, and physical simulation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:rigid-body-dynamics ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:friction ],
        ngm:physics-simulation ;
    vc:contrastsWith ngm:rigid-body-dynamics ;
    vc:dependsOn ngm:collision-detection,
        ngm:physics-simulation ;
    vc:enables ngm:dexterous-manipulation,
        ngm:grasping ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:physics-simulation ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:friction,
        ngm:rigid-body-dynamics,
        ngm:tactile-sensing ;
    vc:requires ngm:friction,
        ngm:rigid-body-dynamics ;
    vc:slug "contact-mechanics" ;
    vc:sourceDomain "robotics" ;
    vc:supports ngm:dexterous-manipulation,
        ngm:soft-robotics ;
    vc:uses ngm:collision-detection,
        ngm:physics-engine .

ngm:content-management-system a owl:Class ;
    rdfs:label "Content Management System"@en ;
    rdfs:comment "A Content Management System (CMS) is software that lets users create, store, organise, edit and publish digital content without requiring direct manipulation of underlying code. It separates content from presentation, providing authoring interfaces, versioning, access control and workflow so that non-technical contributors can manage websites and applications. Modern variants include headless systems that expose content through APIs for delivery across many front ends, including spatial and immersive interfaces."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:database ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:user-interface ],
        ngm:digital-asset-management ;
    vc:bridgesTo ngm:content-delivery-network ;
    vc:contrastsWith ngm:digital-asset-management ;
    vc:dependsOn ngm:database ;
    vc:enables ngm:content-delivery-network ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:isPartOf ngm:digital-asset-management ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:digital-asset-management,
        ngm:metadata,
        ngm:search-engine ;
    vc:requires ngm:database,
        ngm:user-interface ;
    vc:slug "content-management-system" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:metadata,
        ngm:version-control ;
    vc:uses ngm:api,
        ngm:rest-api .

ngm:content-monetisation a owl:Class ;
    rdfs:label "Content Monetisation"@en ;
    rdfs:comment "Content monetisation is the set of mechanisms by which creators and rights-holders earn revenue from digital media, including advertising, subscriptions, micropayments, licensing and royalty distribution. Governance of these mechanisms covers rights attribution, usage tracking and the fair allocation of proceeds among contributors. Emerging models use programmable payments and on-chain royalties to automate compensation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:content-authentication ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:intellectual-property-rights-framework ],
        ngm:governance ;
    vc:bridgesTo ngm:micropayment ;
    vc:dependsOn ngm:digital-rights-management ;
    vc:enables ngm:creator-economy,
        ngm:creator-monetization ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:royalty-distribution ;
    vc:isPartOf ngm:creator-economy ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:nft-marketplace,
        ngm:x402-and-l402-payment-protocols ;
    vc:requires ngm:content-authentication,
        ngm:intellectual-property-rights-framework ;
    vc:slug "content-monetisation" ;
    vc:sourceDomain "governance" ;
    vc:supports ngm:creator-royalties,
        ngm:royalty-distribution ;
    vc:uses ngm:digital-rights-management,
        ngm:micropayment .

ngm:control-interface a owl:Class ;
    rdfs:label "Control Interface"@en ;
    rdfs:comment "A control interface is the defined boundary through which commands and feedback are exchanged between a controller and a controlled device such as an actuator, end-effector, or robot subsystem. It specifies the signals, protocols, data rates, and timing required for deterministic command of the hardware. A well-defined control interface is what allows higher-level planners and digital twins to actuate physical systems reliably."@en ;
    rdfs:subClassOf ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:digital-twin,
        ngm:end-effector ;
    vc:slug "control-interface" ;
    vc:sourceDomain "robotics" .

ngm:costmap a owl:Class ;
    rdfs:label "Costmap"@en ;
    rdfs:comment "A costmap is a grid-based spatial data structure used in robot navigation that assigns a traversal cost to each cell of the environment, encoding obstacles, inflation zones, and free space. Local and global costmaps fuse sensor data and static maps so that planners can compute collision-free, low-cost paths. It is a core component of navigation stacks such as Nav2, where it underpins both global path planning and local trajectory control."@en ;
    rdfs:subClassOf ngm:robo-navigation-and-planning ;
    skos:broader ngm:robo-navigation-and-planning ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:nav2,
        ngm:navigation ;
    vc:slug "costmap" ;
    vc:sourceDomain "robotics" .

ngm:covariance-matrix a owl:Class ;
    rdfs:label "Covariance Matrix"@en ;
    rdfs:comment "A covariance matrix is a square symmetric positive semi-definite matrix whose (i,j) entry is the covariance between the i-th and j-th components of a multivariate random variable, with variances on the main diagonal. It completely characterises the second-order statistics and linear dependence structure of a multivariate distribution, and — together with the mean vector — fully specifies a multivariate Gaussian. The covariance matrix is central to multivariate statistics, machine learning, state estimation, signal processing, and finance, serving as the fundamental data structure for representing and propagating uncertainty in high-dimensional systems."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:probability-theory ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:linear-algebra ],
        ngm:linear-algebra,
        ngm:multivariate-statistics ;
    vc:contrastsWith ngm:correlation-matrix,
        ngm:precision-matrix ;
    vc:dependsOn ngm:gaussian-distribution,
        ngm:random-variable ;
    vc:enables ngm:dimensionality-reduction,
        ngm:factor-analysis,
        ngm:mahalanobis-distance,
        ngm:portfolio-optimisation,
        ngm:principal-component-analysis,
        ngm:whitening ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:correlation-matrix,
        ngm:eigendecomposition,
        ngm:variance ;
    vc:isPartOf ngm:gaussian-distribution,
        ngm:probability-distribution ;
    vc:qualityScore "0.9"^^xsd:float ;
    vc:relatedTo ngm:cost-function,
        ngm:feature-extraction,
        ngm:gaussian-distribution,
        ngm:probability-distribution,
        ngm:random-matrix-theory,
        ngm:regularisation ;
    vc:requires ngm:linear-algebra,
        ngm:multivariate-data,
        ngm:probability-theory ;
    vc:slug "covariance-matrix" ;
    vc:sourceDomain "machine-learning" ;
    vc:supports ngm:anomaly-detection,
        ngm:bayesian-inference,
        ngm:gaussian-process,
        ngm:kalman-filter,
        ngm:sensor-fusion,
        ngm:state-estimation ;
    vc:uses ngm:eigendecomposition,
        ngm:feature-extraction,
        ngm:singular-value-decomposition .

ngm:crm-integration a owl:Class ;
    rdfs:label "CRM Integration"@en ;
    rdfs:comment "CRM integration is the connection of customer-relationship-management software with other business systems—such as telephony, email, marketing, and AI assistants—so that customer data and interactions flow automatically across tools. It typically uses APIs, webhooks, and event syncs to keep contact records, activity logs, and pipelines consistent. It is essential for unified customer views and automated sales and support workflows."@en ;
    rdfs:subClassOf ngm:system-architecture ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:call-centres,
        ngm:crm ;
    vc:slug "crm-integration" ;
    vc:sourceDomain "infrastructure" .

ngm:cross-modal-retrieval a owl:Class ;
    rdfs:label "Cross Modal Retrieval"@en ;
    rdfs:comment "Cross-modal retrieval is the task of retrieving items in one modality (such as images) using a query expressed in a different modality (such as text), and vice versa. It relies on learning a shared embedding space in which semantically corresponding items across modalities lie close together, so that similarity search can bridge the modality gap. Contrastive vision-language models are the dominant approach, enabling text-to-image search, image captioning retrieval and multimodal recommendation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:representation-learning ],
        ngm:information-retrieval ;
    vc:bridgesTo ngm:clip ;
    vc:contrastsWith ngm:semantic-search ;
    vc:dependsOn ngm:embedding ;
    vc:enables ngm:semantic-search,
        ngm:text-to-image ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:information-retrieval ;
    vc:isPartOf ngm:information-retrieval ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:clip,
        ngm:vector-search,
        ngm:vision-language-model ;
    vc:requires ngm:representation-learning ;
    vc:slug "cross-modal-retrieval" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:vision-language-model ;
    vc:uses ngm:contrastive-learning,
        ngm:embedding,
        ngm:vector-search .

ngm:cross-platform-authentication a owl:Class ;
    rdfs:label "Cross-Platform Authentication"@en ;
    rdfs:comment "Cross-platform authentication is the verification of a user's identity in a way that is valid across multiple platforms, devices, or virtual worlds without re-registration. It uses federated identity, single sign-on, and portable credentials so that one verified identity unlocks access everywhere. It is a foundational requirement for interoperable avatars and multiverse experiences."@en ;
    rdfs:subClassOf ngm:authentication ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:avatar-interoperability,
        ngm:multiverse ;
    vc:slug "cross-platform-authentication" ;
    vc:sourceDomain "security" .

ngm:cryptographic-layer a owl:Class ;
    rdfs:label "Cryptographic Layer"@en ;
    rdfs:comment "The Cryptographic Layer is the stratum that provides confidentiality, integrity, and authenticity primitives to the layers above. It sits above the Hardware Layer, which supplies entropy and acceleration, and below identity, consensus, and security strata that depend on its guarantees. It contains ciphers, hash functions, signature schemes, and key management."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:hardware-layer ],
        ngm:infra-security-and-identity ;
    skos:broader ngm:infra-security-and-identity ;
    vc:enables ngm:consensus-layer,
        ngm:identity-layer ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:hardware-layer ;
    vc:slug "cryptographic-layer" ;
    vc:sourceDomain "security" .

ngm:cryptographic-system a owl:Class ;
    rdfs:label "Cryptographic System"@en ;
    rdfs:comment "An integrated framework of mathematical algorithms, protocols, and mechanisms designed to provide information security properties including confidentiality, integrity, authentication, and non-repudiation in adversarial environments. Blockchain cryptographic systems enable trustless operation through mathematical guarantees rather than trusted intermediaries."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:encryption ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:cryptographic-hash-function ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:zero-knowledge-proof ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:digital-signature ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:public-key-cryptography ],
        ngm:bc-cryptographic-primitive,
        ngm:blockchain-entity ;
    skos:broader ngm:bc-cryptographic-primitive ;
    vc:enables ngm:blockchain-network,
        ngm:cryptographic-verification ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:cryptographic-hash-function,
        ngm:digital-signature,
        ngm:encryption,
        ngm:public-key-cryptography,
        ngm:zero-knowledge-proof ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:cryptographic-key-management,
        ngm:cryptographic-protocol,
        ngm:cryptographic-security,
        ngm:merkle-tree,
        ngm:post-quantum-cryptography ;
    vc:slug "cryptographic-system" ;
    vc:sourceDomain "blockchain" .

ngm:cultural-heritage-xr-experience a owl:Class ;
    rdfs:label "Cultural Heritage XR Experience"@en ;
    rdfs:comment "An immersive extended reality application designed to preserve, present, and educate users about cultural heritage through interactive 3D reconstructions, AR overlays, and virtual museum experiences."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:spatial-audio-system ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:xr-runtime-environment ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:3-d-rendering-engine ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:3-d-reconstruction ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:ar-overlay ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:educational-narrative ],
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:enables ngm:archaeological-site-reconstruction,
        ngm:virtual-museum-tour ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:3-d-reconstruction,
        ngm:ar-overlay,
        ngm:educational-narrative ;
    vc:isPartOf ngm:cultural-heritage-preservation ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:3-d-rendering-engine,
        ngm:spatial-audio-system,
        ngm:xr-runtime-environment ;
    vc:slug "cultural-heritage-xr-experience" ;
    vc:sourceDomain "spatial-computing" .

ngm:current-sensor a owl:Class ;
    rdfs:label "Current Sensor"@en ;
    rdfs:comment "Current Sensor - An electrical measurement device (Hall effect, fluxgate, or shunt-based) that detects current flow in motor circuits and power systems, enabling Motor Torque Estimation, Fault Detection, and Energy Monitoring in autonomous robots."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:analogue-to-digital-conversion ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:signal-conditioning ],
        ngm:robo-perception ;
    skos:broader ngm:robo-perception ;
    vc:bridgesTo ngm:sensor ;
    vc:enables ngm:monitoring,
        ngm:predictive-maintenance ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:isPartOf ngm:motor-control-system,
        ngm:power-management ;
    vc:qualityScore "0.52"^^xsd:float ;
    vc:requires ngm:analogue-to-digital-conversion,
        ngm:signal-conditioning ;
    vc:slug "current-sensor" ;
    vc:sourceDomain "robotics" .

ngm:curve25519 a owl:Class ;
    rdfs:label "Curve25519"@en ;
    rdfs:comment "Curve25519 is a Montgomery-form elliptic curve designed for fast, secure elliptic-curve Diffie-Hellman key exchange at a 128-bit security level. It was engineered to avoid common implementation pitfalls by enabling constant-time, branch-free arithmetic and to sidestep concerns about opaque parameter selection through rigid, transparent design choices. It underpins the X25519 key-agreement function and is widely deployed in modern secure-transport and messaging protocols."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptography ],
        ngm:elliptic-curve-cryptography ;
    vc:contrastsWith ngm:ed25519 ;
    vc:enables ngm:ed25519,
        ngm:forward-secrecy ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:implements ngm:key-exchange ;
    vc:isPartOf ngm:cryptographic-primitive ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:digital-signature,
        ngm:ed25519,
        ngm:key-exchange ;
    vc:requires ngm:cryptography ;
    vc:slug "curve25519" ;
    vc:sourceDomain "security" ;
    vc:standardizedBy ngm:nist ;
    vc:supports ngm:signal-protocol,
        ngm:tls ;
    vc:uses ngm:elliptic-curve-cryptography .

ngm:customer-support a owl:Class ;
    rdfs:label "Customer Support"@en ;
    rdfs:comment "Customer Support is the structured operational function and set of AI-augmented processes through which organisations resolve customer queries, technical faults, billing disputes, and product complaints across telephone, email, live chat, self-service portals, and social messaging channels, increasingly powered by Large Language Models, Retrieval-Augmented Generation architectures, and autonomous Agentic Workflow systems that automate first-contact resolution while escalating complex edge cases to human agents with full conversational context."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:knowledge-retrieval ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:crm-integration ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:dialogue-management ],
        ngm:customer-service-automation,
        ngm:enterprise-workflow ;
    vc:enables ngm:agentic-workflow,
        ngm:question-answering,
        ngm:workflow-automation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.9"^^xsd:float ;
    vc:relatedTo ngm:conversational-ai,
        ngm:explainable-ai,
        ngm:human-computer-interaction,
        ngm:natural-language-processing,
        ngm:sentiment-analysis ;
    vc:requires ngm:crm-integration,
        ngm:dialogue-management,
        ngm:knowledge-retrieval ;
    vc:slug "customer-support" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:chatbots,
        ngm:crm,
        ngm:dialogue-system,
        ngm:information-retrieval,
        ngm:intent-recognition,
        ngm:large-language-models,
        ngm:retrieval-augmented-generation,
        ngm:speech-recognition .

ngm:cybernetics a owl:Class ;
    rdfs:label "Cybernetics"@en ;
    rdfs:comment "Cybernetics is the transdisciplinary science of regulatory systems, feedback mechanisms, and goal-directed behaviour in animals, machines, and organisations, founded by Norbert Wiener in 1948 to provide a unified framework for understanding how systems use information to maintain stability and achieve purposes across biological, mechanical, and social domains. It centres on the study of circular causal processes — feedback loops — through which a system compares its actual state against a desired state and acts to reduce the discrepancy, extending naturally to concepts of information, communication, control, and self-organisation. Second-order cybernetics extends this to include the observer as a participant in the system being observed, influencing systems theory, cognitive science, constructivism, and AI."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:systems-theory ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:information-theory ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:homeostasis ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:positive-feedback ],
        ngm:control-theory,
        ngm:systems-theory ;
    vc:contrastsWith ngm:open-loop-control ;
    vc:enables ngm:adaptive-control,
        ngm:ai-alignment,
        ngm:brain-computer-interfaces,
        ngm:human-robot-interaction,
        ngm:reinforcement-learning,
        ngm:self-organisation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:homeostasis,
        ngm:negative-feedback,
        ngm:positive-feedback ;
    vc:qualityScore "0.9"^^xsd:float ;
    vc:relatedTo ngm:cognitive-science,
        ngm:complex-adaptive-systems,
        ngm:emergence,
        ngm:machine-learning ;
    vc:requires ngm:information-theory,
        ngm:systems-theory ;
    vc:slug "cybernetics" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:ai-alignment,
        ngm:autonomous-systems,
        ngm:robotics ;
    vc:uses ngm:feedback-control,
        ngm:feedback-loop,
        ngm:information-theory,
        ngm:signal-processing .

ngm:cybersecurity-policy a owl:Class ;
    rdfs:label "Cybersecurity Policy"@en ;
    rdfs:comment "A cybersecurity policy is a formal set of rules, roles, and expectations that govern how an organisation or jurisdiction protects information systems, data, and networks from threats. It translates risk appetite and legal obligations into actionable standards covering access, incident handling, data protection, and acceptable use. Cybersecurity policy operates at organisational level as internal governance and at national level as regulation and strategy."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:threat-modelling ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:security-policy ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:risk-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:access-control ],
        ngm:policy ;
    vc:bridgesTo ngm:digital-governance,
        ngm:regulation ;
    vc:dependsOn ngm:cybersecurity ;
    vc:enables ngm:compliance,
        ngm:regulatory-compliance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:access-control,
        ngm:security-policy ;
    vc:implements ngm:governance-framework ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:national-security,
        ngm:network-security,
        ngm:privacy ;
    vc:requires ngm:risk-management,
        ngm:threat-modelling ;
    vc:slug "cybersecurity-policy" ;
    vc:sourceDomain "governance" ;
    vc:supports ngm:incident-response,
        ngm:vulnerability-management ;
    vc:uses ngm:encryption .

ngm:dai a owl:Class ;
    rdfs:label "DAI"@en ;
    rdfs:comment "DAI is a decentralised stablecoin issued by the MakerDAO protocol on Ethereum that aims to hold a value close to one US dollar through collateral backing."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:smart-contract ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:maker-dao ],
        ngm:stablecoin ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:maker-dao,
        ngm:smart-contract ;
    vc:slug "dai" ;
    vc:sourceDomain "blockchain" .

ngm:data-access-interface a owl:Class ;
    rdfs:label "Data Access Interface"@en ;
    rdfs:comment "A Data Access Interface is a formalised contract—such as a REST API, GraphQL endpoint, or SPARQL query service—that mediates structured access to data stores, registries, or knowledge graphs. It enforces authentication, authorisation, and schema validation, decoupling data consumers from underlying storage implementations. In metaverse and spatial computing contexts, data access interfaces expose asset repositories, user identity records, and scene graphs to applications and AI agents."@en ;
    rdfs:subClassOf ngm:infra-data-management ;
    skos:broader ngm:infra-data-management ;
    vc:enables ngm:data-governance,
        ngm:data-interoperability ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:digital-infrastructure ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:slug "data-access-interface" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:ai-agent-system,
        ngm:data-registry ;
    vc:uses ngm:digital-identity .

ngm:data-anonymization-pipeline a owl:Class ;
    rdfs:label "Data Anonymization Pipeline"@en ;
    rdfs:comment "An automated, multi-stage process that systematically removes, masks, or generalizes personally identifiable information (PII) from datasets to protect individual privacy while preserving data utility for analysis."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:privacy-policy ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-classification ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:risk-assessment ],
        ngm:data-protection,
        ngm:sc-governance-and-safety ;
    skos:broader ngm:sc-governance-and-safety ;
    vc:enables ngm:differential-privacy,
        ngm:gdpr-compliance,
        ngm:privacy-preserving-analytics,
        ngm:secure-data-sharing ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:compliance-framework,
        ngm:data-governance,
        ngm:privacy-engineering ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:data-classification,
        ngm:privacy-policy,
        ngm:risk-assessment ;
    vc:slug "data-anonymization-pipeline" ;
    vc:sourceDomain "spatial-computing" .

ngm:data-contracts a owl:Class ;
    rdfs:label "Data Contracts"@en ;
    rdfs:comment "A data contract is a formal, versioned agreement between data producers and consumers that specifies the schema, semantics, quality guarantees and service-level expectations of a dataset or stream. It makes data interfaces explicit and enforceable, enabling automated validation and breaking-change detection in data pipelines. Data contracts are a metadata-management practice that improves reliability and trust across decentralised data ownership."@en ;
    rdfs:subClassOf ngm:infra-data-management ;
    skos:broader ngm:infra-data-management ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:metadata-management ;
    vc:slug "data-contracts" ;
    vc:sourceDomain "data" .

ngm:data-deduplication a owl:Class ;
    rdfs:label "Data Deduplication"@en ;
    rdfs:comment "Data deduplication is the process of detecting and eliminating redundant copies of data so that only unique instances are retained or referenced. In storage it reduces capacity and bandwidth needs through chunk- or block-level matching, while in data preparation it removes duplicate records to improve quality. It is foundational for clean training data and for identity resolution where records must be matched and merged."@en ;
    rdfs:subClassOf ngm:data-management ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:identity-resolution,
        ngm:training-data ;
    vc:slug "data-deduplication" ;
    vc:sourceDomain "data" .

ngm:data-localisation a owl:Class ;
    rdfs:label "Data Localisation"@en ;
    rdfs:comment "Data localisation is the legal or regulatory requirement that certain categories of data be stored, processed, or retained within the geographic borders of a particular country or jurisdiction. Governments impose such rules to assert data sovereignty, protect citizens' personal information, support law-enforcement access, or shield strategic sectors, and the requirements range from mandating in-country copies to outright bans on cross-border transfer. Compliance forces organisations to architect regional data residency, partition storage, and reconcile conflicting national regimes, materially shaping cloud architecture and international data flows."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:regulatory-compliance ],
        ngm:data-governance ;
    vc:dependsOn ngm:privacy-regulation ;
    vc:enables ngm:data-sovereignty ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:data-governance,
        ngm:data-protection ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:data-protection,
        ngm:interoperability ;
    vc:requires ngm:data-residency,
        ngm:regulatory-compliance ;
    vc:slug "data-localisation" ;
    vc:sourceDomain "governance" ;
    vc:standardizedBy ngm:gdpr .

ngm:data-synchronization a owl:Class ;
    rdfs:label "Data Synchronization"@en ;
    rdfs:comment "Data synchronization is the process of keeping data consistent across multiple devices, replicas or systems by propagating changes and reconciling conflicts. It may be one-way or bidirectional, real-time or batch, and relies on change tracking, versioning and conflict-resolution strategies. It is essential wherever distributed copies of data must converge, from device sync to collective-intelligence systems aggregating many participants."@en ;
    rdfs:subClassOf ngm:distributed-systems ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:collective-intelligence-system,
        ngm:etsi-domain-data-management ;
    vc:slug "data-synchronization" ;
    vc:sourceDomain "infrastructure" .

ngm:data-warehousing a owl:Class ;
    rdfs:label "Data Warehousing"@en ;
    rdfs:comment "Data warehousing is the practice of consolidating data from multiple operational and external sources into a central, integrated, subject-oriented repository optimised for query and analysis rather than transaction processing. A data warehouse stores historical, cleansed and conformed data structured for reporting and decision support, typically populated through extract-transform-load pipelines and queried using online analytical processing. It provides the persistent analytical substrate on which business intelligence, dashboards and downstream analytics are built."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-governance ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:data-pipeline ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:data-integration ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-quality ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:master-data-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:data-warehouse ],
        ngm:data-engineering ;
    vc:contrastsWith ngm:data-lake ;
    vc:enables ngm:business-intelligence,
        ngm:predictive-analytics ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:data-integration,
        ngm:data-pipeline,
        ngm:data-warehouse ;
    vc:isPartOf ngm:data-engineering ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:data-management,
        ngm:metadata ;
    vc:requires ngm:data-governance,
        ngm:data-quality,
        ngm:master-data-management ;
    vc:slug "data-warehousing" ;
    vc:sourceDomain "data" ;
    vc:supports ngm:data-catalog ;
    vc:uses ngm:relational-database,
        ngm:sql .

ngm:dds a owl:Class ;
    rdfs:label "DDS"@en ;
    rdfs:comment "DDS, the Data Distribution Service, is an Object Management Group standard for a publish-subscribe middleware that distributes real-time data between distributed system components."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:network-protocol ],
        ngm:middleware ;
    vc:enables ngm:robot-operating-system ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:network-protocol ;
    vc:slug "dds" ;
    vc:sourceDomain "infrastructure" .

ngm:deduplication a owl:Class ;
    rdfs:label "Deduplication"@en ;
    rdfs:comment "Deduplication is a data-management technique that eliminates redundant copies of identical data by storing a single instance and referencing it wherever the same content recurs. Implementations typically hash data chunks and compare digests, so identical blocks resolve to the same stored object. It reduces storage footprint, backup windows, and network transfer in content-addressed and backup systems."@en ;
    rdfs:subClassOf ngm:data-management ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:content-addressing,
        ngm:hash-function ;
    vc:slug "deduplication" ;
    vc:sourceDomain "data" .

ngm:denoising-score-matching a owl:Class ;
    rdfs:label "Denoising Score Matching"@en ;
    rdfs:comment "Denoising score matching is a training objective for learning the score function, the gradient of the log probability density, of a data distribution. Rather than estimating the score directly, it perturbs data with known Gaussian noise and trains a model to predict the noise, which is equivalent to estimating the score of the noise-perturbed distribution. This objective avoids the intractable normalising constant of energy-based models and underpins score-based generative models and diffusion models, where the learned score guides iterative sampling from noise back to data."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:stochastic-process ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:probability-distribution ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:sampling ],
        ngm:generative-model ;
    vc:bridgesTo ngm:deep-learning ;
    vc:contrastsWith ngm:vae ;
    vc:dependsOn ngm:stochastic-differential-equation ;
    vc:enables ngm:diffusion-model ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:sampling ;
    vc:implements ngm:generative-model ;
    vc:isPartOf ngm:diffusion-model ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:diffusion-model,
        ngm:markov-chain,
        ngm:probabilistic-model ;
    vc:requires ngm:probability-distribution,
        ngm:stochastic-process ;
    vc:slug "denoising-score-matching" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:deep-learning ;
    vc:uses ngm:gradient-descent,
        ngm:neural-network .

ngm:deterministic-execution a owl:Class ;
    rdfs:label "Deterministic Execution"@en ;
    rdfs:comment "Deterministic Execution guarantees that a computation produces identical outputs and state transitions whenever it is run on the same inputs in the same order, irrespective of host, timing, or scheduling. It is a prerequisite for state machine replication and blockchain smart contracts, where independent nodes must reach byte-identical results to agree on shared state. Achieving it demands eliminating sources of nondeterminism such as wall-clock time, unordered concurrency, and floating-point divergence."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:state-machine-replication ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:reproducibility ],
        ngm:state-machine-replication ;
    vc:bridgesTo ngm:smart-contract ;
    vc:contrastsWith ngm:concurrency ;
    vc:enables ngm:byzantine-fault-tolerance,
        ngm:consensus-mechanism ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:idempotency ;
    vc:isPartOf ngm:infrastructure ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:blockchain,
        ngm:fault-tolerance,
        ngm:reproducibility ;
    vc:requires ngm:reproducibility,
        ngm:state-machine-replication ;
    vc:slug "deterministic-execution" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:replication,
        ngm:smart-contract ;
    vc:uses ngm:virtual-machine .

ngm:dex a owl:Class ;
    rdfs:label "DEX"@en ;
    rdfs:comment "The common abbreviation for a decentralised exchange, a smart-contract trading venue where users swap assets without surrendering custody to a central operator."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:liquidity-pool ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:smart-contract ],
        ngm:decentralised-exchange ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:liquidity-pool,
        ngm:smart-contract ;
    vc:slug "dex" ;
    vc:sourceDomain "blockchain" .

ngm:digital-asset-standards a owl:Class ;
    rdfs:label "Digital Asset Standards"@en ;
    rdfs:comment "Digital Asset Standards is a spatial computing concept."@en ;
    rdfs:subClassOf ngm:sc-standards-and-interop ;
    skos:broader ngm:sc-standards-and-interop ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:implements ngm:spatial-computing ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:slug "digital-asset-standards" ;
    vc:sourceDomain "spatial-computing" .

ngm:digital-asset-workflow a owl:Class ;
    rdfs:label "Digital Asset Workflow"@en ;
    rdfs:comment "Digital Asset Workflow is a type of Spatial Computing in the spatial computing domain."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:version-control ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:metadata-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:content-creation-pipeline ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:asset-archive ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:digital-rights-management ],
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:enables ngm:content-distribution,
        ngm:digital-goods,
        ngm:nft-minting ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:asset-archive,
        ngm:content-creation-pipeline ;
    vc:isPartOf ngm:creator-economy ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:digital-rights-management,
        ngm:metadata-management,
        ngm:version-control ;
    vc:slug "digital-asset-workflow" ;
    vc:sourceDomain "spatial-computing" .

ngm:digital-commerce a owl:Class ;
    rdfs:label "Digital Commerce"@en ;
    rdfs:comment "Digital Commerce encompasses the exchange of goods, services, and digital assets through internet-connected and virtual platforms, including metaverse storefronts, NFT marketplaces, and cryptocurrency-denominated payment rails. It extends conventional e-commerce by incorporating programmable smart contracts for trustless settlement, tokenised ownership of virtual goods, and AI-mediated personalisation. In metaverse contexts, digital commerce enables low-friction cross-border value transfer without leaving the virtual environment."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:digital-identity ],
        ngm:digital-asset-ecosystem,
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:enables ngm:cross-metaverse-commerce,
        ngm:digital-asset-management ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:requires ngm:digital-identity ;
    vc:slug "digital-commerce" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:metaverse ;
    vc:uses ngm:blockchain,
        ngm:smart-contract .

ngm:digital-democracy a owl:Class ;
    rdfs:label "Digital Democracy"@en ;
    rdfs:comment "Digital democracy is the use of digital technologies to broaden and deepen citizen participation in political decision-making, including online deliberation, e-petitions, participatory budgeting, and novel voting mechanisms. It seeks to make governance more transparent, inclusive, and responsive by lowering the barriers to engagement. It encompasses both incremental e-government tools and experimental collective-choice systems such as quadratic voting."@en ;
    rdfs:subClassOf ngm:governance ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:civic-participation,
        ngm:quadratic-voting ;
    vc:slug "digital-democracy" ;
    vc:sourceDomain "governance" .

ngm:digital-inclusion a owl:Class ;
    rdfs:label "Digital Inclusion"@en ;
    rdfs:comment "Digital Inclusion is the set of policies and practices that ensure all individuals and communities, especially the disadvantaged, have meaningful access to and the ability to use digital technologies. It addresses affordable connectivity, accessible devices and services, relevant skills and trustworthy content so that no group is left behind as services move online. Digital Inclusion is the constructive response to the digital divide and a precondition for equitable participation in modern civic and economic life."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:assistive-technology ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:accessibility ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:universal-access ],
        ngm:governance ;
    vc:bridgesTo ngm:accessibility ;
    vc:contrastsWith ngm:digital-divide ;
    vc:dependsOn ngm:universal-access ;
    vc:enables ngm:accessibility,
        ngm:universal-access ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:governance ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:digital-divide,
        ngm:policy,
        ngm:universal-access ;
    vc:requires ngm:accessibility,
        ngm:assistive-technology,
        ngm:universal-access ;
    vc:slug "digital-inclusion" ;
    vc:sourceDomain "governance" ;
    vc:supports ngm:accessibility,
        ngm:governance,
        ngm:policy ;
    vc:uses ngm:assistive-technology .

ngm:digital-safety a owl:Class ;
    rdfs:label "Digital Safety"@en ;
    rdfs:comment "Digital Safety encompasses the policies, technical controls, and design practices that protect individuals from harm in digital and spatial computing environments, including cybersecurity threats, privacy violations, online harassment, and misuse of immersive technologies. It applies governance frameworks, access controls, and content moderation mechanisms to ensure safe participation across metaverse, VR, and telecollaboration platforms."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:authentication ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cybersecurity ],
        ngm:sc-governance-and-safety ;
    skos:broader ngm:sc-governance-and-safety ;
    vc:enables ngm:content-moderation,
        ngm:privacy ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:relatedTo ngm:data-governance,
        ngm:digital-rights ;
    vc:requires ngm:authentication,
        ngm:cybersecurity ;
    vc:slug "digital-safety" ;
    vc:sourceDomain "spatial-computing" .

ngm:digital-twin-framework a owl:Class ;
    rdfs:label "Digital Twin Framework"@en ;
    rdfs:comment "The architectural blueprint and standards-based modology for implementing digital twins within enterprise and industrial contexts, defining the layered structure from IoT foundation through application layer, and ensuring interoperability across cyber-physical systems and industrial metaverse pla..."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
