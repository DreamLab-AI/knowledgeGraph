    vc:relatedTo ngm:knowledge-management,
        ngm:knowledge-management-system ;
    vc:slug "templates" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:prompt-engineering .

ngm:tensor-rt a owl:Class ;
    rdfs:label "TensorRT"@en ;
    rdfs:comment "A software development kit from NVIDIA for optimising and running deep learning inference on NVIDIA GPUs, performing graph optimisations, precision calibration and kernel selection."@en ;
