        ngm:digital-twin-framework,
        ngm:machine-learning-framework,
        ngm:optimization-technique ;
    vc:slug "algorithmic-framework" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:anon-creds a owl:Class ;
    rdfs:label "AnonCreds"@en ;
    rdfs:comment "AnonCreds (Anonymous Credentials) is a verifiable credential format and specification originally developed by the Hyperledger Indy project that enables privacy-preserving identity verification. The scheme allows holders to prove possession of credentials without revealing the credential itself or the issuer's signature, using zero-knowledge proofs. AnonCreds supports selective disclosure, letting a holder share only specific attributes, and predicates that prove a claim (e.g. age over 18) without revealing the underlying value. The specification has been standardised via the AnonCreds Working Group under the Decentralized Identity Foundation."@en ;
    rdfs:subClassOf ngm:credential-format-standard ;
    vc:enables ngm:differential-privacy,
        ngm:privacy-preserving-technology ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:credential-schema,
        ngm:decentralised-identity,
        ngm:digital-identity-wallet ;
    vc:slug "anon-creds" ;
    vc:sourceDomain "security" ;
    vc:supports ngm:authentication ;
    vc:uses ngm:selective-disclosure,
        ngm:zero-knowledge-proof .

ngm:ar-display-device a owl:Class ;
    rdfs:label "Ar Display Device"@en ;
    rdfs:comment "AR Display Device encompasses hardware systems including smart glasses, headsets, and head-mounted displays that superimpose computer-generated imagery onto the user's view of the real world through optical technologies such as waveguides, birdbath optics, holographic displays, and metasurfaces."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:display-technology ],
