    vc:uses ngm:5-g-network,
        ngm:bluetooth-low-energy,
        ngm:edge-computing,
        ngm:embedded-systems,
        ngm:mqtt .

ngm:iso-tc-307 a owl:Class ;
    rdfs:label "ISO TC 307"@en ;
    rdfs:comment "ISO/TC 307 is the ISO Technical Committee established in 2016 with Australia as secretariat, mandated to develop international standards for blockchain and distributed ledger technologies (DLT). Its normative outputs span terminology (ISO 22739), reference architecture, security and privacy frameworks, smart contract interaction models, digital identity standards, and governance structures for decentralised systems. The committee coordinates with ISO/TC 68 (Financial Services), ISO/IEC JTC 1/SC 27 (Cryptographic Security), W3C, ITU-T SG17, and IEEE to ensure interoperability standards and shared vocabulary underpin regulatory, procurement, and legislative language across jurisdictions. It operates through specialised working groups covering foundations, security, smart contracts, data governance, DLT governance, and interoperability."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:security-framework ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:blockchain-governance ],
        ngm:standards-body ;
    vc:bridgesTo ngm:data-governance,
        ngm:regulatory-compliance,
        ngm:supply-chain-traceability ;
    vc:enables ngm:blockchain-interoperability,
        ngm:cross-chain-communication,
        ngm:digital-identity-standards,
        ngm:distributed-ledger-technology ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:blockchain-governance,
        ngm:security-framework ;
    vc:implements ngm:blockchain-governance,
        ngm:consensus-mechanism,
        ngm:decentralised-governance ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:blockchain,
        ngm:cryptographic-security,
        ngm:decentralised-identifier,
        ngm:hyperledger-fabric ;
    vc:slug "iso-tc-307" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:central-bank-digital-currency,
        ngm:permissioned-blockchain,
        ngm:smart-contract .

ngm:itu a owl:Class ;
    rdfs:label "ITU"@en ;
    rdfs:comment "The International Telecommunication Union (ITU) is the United Nations specialised agency responsible for information and communication technologies, coordinating global use of the radio spectrum and satellite orbits, developing technical standards and working to expand connectivity worldwide. Through its sectors for radiocommunication, standardization and development it produces recommendations that underpin interoperable telecommunications infrastructure. It is one of the principal international bodies governing the global telecommunications system."@en ;
    rdfs:subClassOf ngm:standards-body ;
    vc:enables ngm:satellite-communication,
        ngm:spectrum-allocation ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:isPartOf ngm:standards-body ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:ieee,
        ngm:ietf,
        ngm:internet-of-things,
        ngm:iso,
        ngm:network-protocol ;
    vc:slug "itu" ;
    vc:sourceDomain "infrastructure" ;
    vc:standardizedBy ngm:standards-body ;
    vc:supports ngm:telecommunications,
        ngm:wireless-connectivity ;
    vc:uses ngm:network-infrastructure .

ngm:kerberos a owl:Class ;
    rdfs:label "Kerberos"@en ;
    rdfs:comment "Kerberos is a network authentication protocol that uses tickets and symmetric key cryptography to allow nodes to prove their identity over an untrusted network, relying on a trusted Key Distribution Centre to issue time-limited session tickets without transmitting long-term credentials."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:symmetric-encryption ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:trusted-third-party ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:encryption ],
        ngm:authentication ;
    vc:bridgesTo ngm:distributed-collaboration,
        ngm:infrastructure ;
    vc:contrastsWith ngm:oauth,
        ngm:saml ;
    vc:enables ngm:access-control,
        ngm:mutual-authentication,
        ngm:single-sign-on ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:cryptographic-protocols ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:directory-service,
        ngm:identity-and-access-management,
        ngm:zero-trust-architecture ;
    vc:requires ngm:encryption,
        ngm:symmetric-encryption,
        ngm:trusted-third-party ;
    vc:slug "kerberos" ;
    vc:sourceDomain "security" ;
    vc:standardizedBy ngm:ietf ;
    vc:supports ngm:active-directory,
        ngm:ldap,
        ngm:network-security ;
    vc:uses ngm:aes,
        ngm:public-key-infrastructure .

ngm:key-management-system a owl:Class ;
    rdfs:label "Key Management System"@en ;
    rdfs:comment "A key management system (KMS) is a service or appliance that generates, stores, rotates, distributes and revokes cryptographic keys over their full lifecycle. It enforces access policies and isolates key material, often backed by hardware security modules, so that applications can perform cryptographic operations without directly handling private keys. A KMS is foundational to secure identity, encryption and digital-asset custody."@en ;
    rdfs:subClassOf ngm:infra-security-and-identity ;
    skos:broader ngm:infra-security-and-identity ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:custody-infrastructure,
        ngm:decentralized-identifiers ;
    vc:slug "key-management-system" ;
    vc:sourceDomain "security" .

ngm:key-pair a owl:Class ;
    rdfs:label "Key Pair"@en ;
    rdfs:comment "A Key Pair is the matched set of a public key and a corresponding private key used in asymmetric cryptography, where the two keys are mathematically related such that data encrypted or signed with one can only be processed with the other. The private key is kept secret by its owner, while the public key may be distributed openly, enabling encryption, digital signatures, and authentication without sharing a secret in advance. Key pairs underpin public-key infrastructure, blockchain wallets, secure messaging, and identity systems. Their security rests on the computational hardness of deriving the private key from the public key."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:key-generation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:elliptic-curve-cryptography ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:public-key ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:private-key ],
        ngm:asymmetric-cryptography ;
    vc:dependsOn ngm:key-management ;
    vc:enables ngm:authentication,
        ngm:digital-signature,
        ngm:encryption ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:private-key,
        ngm:public-key ;
    vc:implements ngm:asymmetric-cryptography ;
    vc:isPartOf ngm:public-key-cryptography ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:hardware-security-module,
        ngm:seed-phrase ;
    vc:requires ngm:elliptic-curve-cryptography,
        ngm:key-generation ;
    vc:slug "key-pair" ;
    vc:sourceDomain "security" ;
    vc:supports ngm:digital-wallet,
        ngm:identity ;
    vc:uses ngm:cryptographic-key,
        ngm:public-key-cryptography .

ngm:keyframe-animation a owl:Class ;
    rdfs:label "Keyframe Animation"@en ;
    rdfs:comment "Keyframe animation is a technique in which an animator specifies an object's properties at a set of significant frames, called keyframes, and the system interpolates the in-between frames automatically. Property values such as position, rotation, and scale are stored on timed curves whose interpolation and easing control the motion between keys. It is a foundational method for authoring deterministic, repeatable motion in computer graphics and real-time engines."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:interpolation ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:interpolation ],
        ngm:animation ;
    vc:bridgesTo ngm:skeletal-animation ;
    vc:contrastsWith ngm:motion-capture,
        ngm:procedural-generation ;
    vc:enables ngm:skeletal-animation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:interpolation ;
    vc:implements ngm:animation ;
    vc:isPartOf ngm:animation ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:motion-capture,
        ngm:spatial-computing,
        ngm:usd ;
    vc:requires ngm:interpolation ;
    vc:slug "keyframe-animation" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:computer-graphics,
        ngm:rendering ;
    vc:uses ngm:interpolation .

ngm:large-scale-datasets a owl:Class ;
    rdfs:label "Large-Scale Datasets"@en ;
    rdfs:comment "Large-scale datasets are very large collections of data, often spanning billions of examples and many terabytes, assembled to train modern machine learning models. They are typically aggregated from web crawls, public corpora and curated sources, then filtered, deduplicated and tokenised. Their scale, diversity and quality are primary determinants of the capabilities of large language and generative models."@en ;
    rdfs:subClassOf ngm:ai-infrastructure ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:generative-ai,
        ngm:large-language-models ;
    vc:slug "large-scale-datasets" ;
    vc:sourceDomain "ai" .

ngm:large-scale-pretraining a owl:Class ;
    rdfs:label "Large-Scale Pretraining"@en ;
    rdfs:comment "Large-scale pretraining is the training of a high-capacity neural network on a very large, broad corpus using a self-supervised objective, producing a general-purpose foundation model before any task-specific adaptation. It typically optimises an objective such as next-token prediction over web-scale text or paired multimodal data, learning transferable representations. The resulting model is later fine-tuned or prompted for downstream tasks."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gpu ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:compute-cluster ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:dataset ],
        ngm:neural-network-training ;
    vc:bridgesTo ngm:fine-tuning ;
    vc:dependsOn ngm:scaling-laws ;
    vc:enables ngm:fine-tuning,
        ngm:foundation-model ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:neural-network-training ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:emergent-capabilities,
        ngm:generalisation ;
    vc:requires ngm:compute-cluster,
        ngm:dataset,
        ngm:gpu ;
    vc:slug "large-scale-pretraining" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:transfer-learning ;
    vc:uses ngm:self-supervised-learning,
        ngm:transformer-architecture .

ngm:latency-aware-edge-ai a owl:Class ;
    rdfs:label "Latency-Aware Edge AI"@en ;
    rdfs:comment "Latency-Aware Edge AI is a design paradigm for machine learning systems deployed at the network edge that dynamically adapts inference strategies, model selection, and compute offloading decisions to satisfy hard or soft real-time response-time deadlines. Such systems continuously monitor available time budgets, device load, and network conditions, trading accuracy for speed when necessary to maintain service-level objectives. Applications span autonomous vehicles, mobile augmented reality, and industrial robotics, where missed deadlines carry safety or quality consequences."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:edge-computing ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:inference-hardware ],
        ngm:ai-infrastructure ;
    vc:contrastsWith ngm:gpu-compute ;
    vc:enables ngm:augmented-reality,
        ngm:autonomous-vehicle ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:bandwidth-adaptation,
        ngm:computer-vision,
        ngm:edge-ai-system ;
    vc:requires ngm:edge-computing,
        ngm:inference-hardware ;
    vc:slug "latency-aware-edge-ai" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:deep-learning,
        ngm:edge-ai-accelerators,
        ngm:inference .

ngm:likelihood-function a owl:Class ;
    rdfs:label "Likelihood Function"@en ;
    rdfs:comment "A likelihood function expresses the probability of observed data as a function of the parameters of a statistical model, treating the data as fixed and the parameters as variable. It is the central object in maximum-likelihood estimation and Bayesian inference, where it weights how well candidate parameter values explain the evidence. In sequential filtering it scores how consistent each hypothesis is with a new measurement."@en ;
    rdfs:subClassOf ngm:machine-learning-discipline ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:particle-filter,
        ngm:probabilistic-model ;
    vc:slug "likelihood-function" ;
    vc:sourceDomain "ai" .

ngm:liquid-cooling a owl:Class ;
    rdfs:label "Liquid Cooling"@en ;
    rdfs:comment "Liquid cooling is a thermal-management technique that removes heat from compute hardware using a circulating liquid coolant, which has far higher heat capacity than air. Implementations include direct-to-chip cold plates and full immersion in dielectric fluid, both enabling higher power densities and lower energy overhead. It is increasingly essential for cooling dense GPU clusters used in AI training and high-performance computing."@en ;
    rdfs:subClassOf ngm:infra-computing-and-cloud ;
    skos:broader ngm:infra-computing-and-cloud ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:compute-infrastructure,
        ngm:sustainability ;
    vc:slug "liquid-cooling" ;
    vc:sourceDomain "infrastructure" .

ngm:liquid-staking a owl:Class ;
    rdfs:label "Liquid Staking"@en ;
    rdfs:comment "Liquid staking is a mechanism that allows holders of proof-of-stake assets to stake their tokens while receiving a transferable derivative token representing the staked position and its accruing rewards. This derivative can be traded, lent or used as collateral in decentralised finance, unlocking liquidity that traditional staking locks up. It thereby lets participants earn staking rewards without sacrificing the capital efficiency of liquid assets."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:proof-of-stake ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:validator-node ],
        ngm:staking ;
    vc:contrastsWith ngm:slashing ;
    vc:dependsOn ngm:blockchain-network,
        ngm:defi-protocol ;
    vc:enables ngm:liquidity-pool,
        ngm:yield-generation ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:implements ngm:governance-token ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:ethereum,
        ngm:lido ;
    vc:requires ngm:proof-of-stake,
        ngm:validator-node ;
    vc:slug "liquid-staking" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:decentralized-finance,
        ngm:tokenization ;
    vc:uses ngm:smart-contract,
        ngm:staking .

ngm:local-llm-runtime-platform a owl:Class ;
    rdfs:label "Local LLM Runtime Platform"@en ;
    rdfs:comment "An open-source runtime and model management platform that allows users to download, serve, and interact with large language models locally on macOS, Windows, and Linux. Ollama provides an OpenAI-compatible REST API, enabling integration with tools such as Open WebUI, ComfyUI, and agent frameworks, making local LLM inference accessible without cloud dependencies."@en ;
    rdfs:subClassOf ngm:ai-infrastructure ;
    vc:enables ngm:function-calling,
        ngm:open-webui-and-pipelines,
        ngm:prompt-engineering ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:knowledge-graphing ;
    vc:slug "local-llm-runtime-platform" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:large-language-models .

ngm:log-management a owl:Class ;
    rdfs:label "Log Management"@en ;
    rdfs:comment "Log management is the discipline of collecting, aggregating, storing, indexing and analysing the event records emitted by applications, services and infrastructure. It provides a centralised, searchable record of system behaviour that underpins debugging, performance analysis, security investigation and compliance auditing. Pipelines typically ingest structured and unstructured logs, normalise them, enforce retention policies and expose them through query and alerting interfaces."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:audit-log ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:alerting ],
        ngm:observability ;
    vc:dependsOn ngm:infrastructure ;
    vc:enables ngm:incident-response,
        ngm:observability,
        ngm:root-cause-analysis ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:alerting,
        ngm:audit-log ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:security-information-and-event-management,
        ngm:siem,
        ngm:telemetry ;
    vc:requires ngm:data ;
    vc:slug "log-management" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:monitoring,
        ngm:real-time-monitoring ;
    vc:uses ngm:distributed-tracing .

ngm:logical-inference a owl:Class ;
    rdfs:label "Logical Inference"@en ;
    rdfs:comment "Logical inference is the process of deriving new statements (conclusions) from existing ones (premises) according to rules that preserve truth, such that whenever the premises are true the conclusion must also be true. It encompasses deductive mechanisms like modus ponens, resolution, and unification, and is the operational core of automated reasoning systems. Logical inference connects formal logics to practical computation by turning syntactic manipulation of formulae into sound derivations of consequences."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:formal-language ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:logic ],
        ngm:reasoning ;
    vc:bridgesTo ngm:knowledge-graph ;
    vc:contrastsWith ngm:constraint-satisfaction ;
    vc:dependsOn ngm:logic ;
    vc:enables ngm:automated-reasoning,
        ngm:semantic-reasoning,
        ngm:theorem-proving ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:implements ngm:reasoning ;
    vc:isPartOf ngm:reasoning ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:constraint-satisfaction,
        ngm:formal-verification ;
    vc:requires ngm:formal-language,
        ngm:logic ;
    vc:slug "logical-inference" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:first-order-logic,
        ngm:knowledge-representation ;
    vc:uses ngm:predicate-logic,
        ngm:propositional-logic .

ngm:low-rank-adaptation a owl:Class ;
    rdfs:label "Low-Rank Adaptation"@en ;
    rdfs:comment "Low-Rank Adaptation (LoRA) is a parameter-efficient fine-tuning method that injects trainable low-rank decomposition matrices into the weight matrices of a frozen pre-trained model, enabling task adaptation with a fraction of the trainable parameters required by full fine-tuning."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:pre-trained-model ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:matrix-factorisation ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:adapter-modules ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:neural-network ],
        ngm:parameter-efficient-fine-tuning ;
    vc:bridgesTo ngm:federated-learning,
        ngm:robotics,
        ngm:spatial-computing ;
    vc:contrastsWith ngm:full-fine-tuning,
        ngm:prefix-tuning,
        ngm:prompt-tuning ;
    vc:dependsOn ngm:transformer-architecture,
        ngm:weight-matrix ;
    vc:enables ngm:fine-tuning,
        ngm:multi-task-learning,
        ngm:transfer-learning ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:adapter-modules ;
    vc:implements ngm:parameter-efficient-fine-tuning ;
    vc:isPartOf ngm:model-adaptation,
        ngm:parameter-efficient-fine-tuning ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:knowledge-distillation,
        ngm:model-compression,
        ngm:quantisation ;
    vc:requires ngm:matrix-factorisation,
        ngm:neural-network,
        ngm:pre-trained-model ;
    vc:slug "low-rank-adaptation" ;
    vc:sourceDomain "machine-learning" ;
    vc:supports ngm:large-language-model,
        ngm:on-device-ai ;
    vc:uses ngm:attention-mechanism,
        ngm:gradient-descent,
        ngm:singular-value-decomposition .

ngm:macroprudential-policy a owl:Class ;
    rdfs:label "Macroprudential Policy"@en ;
    rdfs:comment "Macroprudential policy is a regulatory approach aimed at safeguarding the stability of the financial system as a whole rather than the soundness of individual institutions, addressing systemic risk that arises from interconnections, common exposures, and procyclical behaviour. It deploys instruments such as countercyclical capital buffers, leverage limits, and stress testing to limit the build-up of vulnerabilities and to enhance resilience to shocks. It complements microprudential supervision and monetary policy in promoting financial stability."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:capital-adequacy ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:systemic-risk ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:stress-testing ],
        ngm:financial-regulation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:capital-adequacy,
        ngm:stress-testing ;
    vc:implements ngm:basel-iii,
        ngm:financial-regulation,
        ngm:prudential-regulation ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:financial-stability,
        ngm:monetary-policy ;
    vc:requires ngm:systemic-risk ;
    vc:slug "macroprudential-policy" ;
    vc:sourceDomain "finance" ;
    vc:standardizedBy ngm:fsb,
        ngm:g20 ;
    vc:supports ngm:financial-stability,
        ngm:risk-management .

ngm:material-system a owl:Class ;
    rdfs:label "Material System"@en ;
    rdfs:comment "A Material System is an engineered assembly of two or more distinct materials — together with their interfaces, interphases, and boundary conditions — designed and optimised as a coherent unit to deliver a specified combination of mechanical, thermal, electrical, optical, or biological properties. The system perspective shifts analysis from isolated constituent properties to emergent behaviour arising from interactions between phases, microstructures, and interfaces under operational loading conditions. Material systems are specified through hierarchical design parameters spanning macro-, meso-, micro-, and nano-scales, and their performance is evaluated via multi-scale modelling, physical testing, and lifecycle assessment. Representative examples include continuous-fibre polymer matrix composites, thermal barrier coating systems, multi-layer semiconductor packages, gradient functional materials, and bioresorbable scaffold-tissue constructs."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:interface ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:material-science ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:manufacturing-process ],
        ngm:material-science ;
    vc:bridgesTo ngm:complex-systems,
        ngm:digital-twin,
        ngm:machine-learning ;
    vc:contrastsWith ngm:bulk-material,
        ngm:monolithic-material ;
    vc:dependsOn ngm:mechanics-of-materials,
        ngm:thermodynamics ;
    vc:enables ngm:lifecycle-assessment,
        ngm:simulation,
        ngm:structural-optimisation ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:coating,
        ngm:composite-material,
        ngm:interface,
        ngm:microstructure ;
    vc:isPartOf ngm:engineering-design,
        ngm:systems-engineering ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:functional-gradient-material,
        ngm:metamaterial,
        ngm:smart-material ;
    vc:requires ngm:characterisation,
        ngm:manufacturing-process,
        ngm:material-science ;
    vc:slug "material-system" ;
    vc:sourceDomain "infrastructure" ;
    vc:standardizedBy ngm:astm-international,
        ngm:iso-standards ;
    vc:supports ngm:aerospace-engineering,
        ngm:biomedical-engineering,
        ngm:energy-storage ;
    vc:uses ngm:finite-element-analysis,
        ngm:multi-scale-modelling,
        ngm:phase-field-model .

ngm:medical-imaging-ai a owl:Class ;
    rdfs:label "Medical Imaging AI"@en ;
    rdfs:comment "Medical Imaging AI encompasses artificial intelligence systems designed to analyse, interpret, and enhance medical images including radiological scans, pathology slides, and other diagnostic imaging modalities. These systems employ deep learning architectures, particularly convolutional neural networks, to perform lesion detection, disease classification, anatomical segmentation, and quantitative image analysis whilst meeting clinical validation standards and regulatory requirements."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:annotated-training-data ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:image-segmentation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gpu-computing ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:dicom ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:radiology-ai ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:pathology-ai ],
        ngm:medical-ai ;
    vc:bridgesTo ngm:digital-twin,
        ngm:federated-learning ;
    vc:contrastsWith ngm:traditional-radiological-review ;
    vc:enables ngm:automated-lesion-detection,
        ngm:clinical-decision-support,
        ngm:treatment-planning ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:computer-aided-diagnosis,
        ngm:image-segmentation,
        ngm:pathology-ai,
        ngm:radiology-ai ;
    vc:isPartOf ngm:healthcare-ai,
        ngm:medical-ai ;
    vc:qualityScore "0.68"^^xsd:float ;
    vc:relatedTo ngm:data-augmentation,
        ngm:explainable-ai ;
    vc:requires ngm:annotated-training-data,
        ngm:dicom,
        ngm:gpu-computing ;
    vc:slug "medical-imaging-ai" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:standardizedBy ngm:fda-510k,
        ngm:hl7-fhir ;
    vc:uses ngm:computer-vision,
        ngm:convolutional-neural-network,
        ngm:deep-learning,
        ngm:transfer-learning,
        ngm:transformer .

ngm:memory-encryption a owl:Class ;
    rdfs:label "Memory Encryption"@en ;
    rdfs:comment "Memory encryption is the protection of data held in a system's volatile memory (RAM) by encrypting it transparently between the processor and the memory controller. It defends against physical attacks such as cold-boot extraction and bus snooping, and underpins confidential computing by keeping a workload's working set unreadable to other tenants, the hypervisor, or anyone with physical access. Modern implementations apply per-page or per-VM keys managed within the CPU package so that plaintext never leaves the trust boundary of the silicon."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:key-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptography ],
        ngm:encryption ;
    vc:bridgesTo ngm:trusted-execution-environment ;
    vc:contrastsWith ngm:homomorphic-encryption ;
    vc:dependsOn ngm:trusted-execution-environment ;
    vc:enables ngm:data-protection ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:encryption ;
    vc:isPartOf ngm:confidential-computing ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:cryptography,
        ngm:security,
        ngm:side-channel-attack ;
    vc:requires ngm:cryptography,
        ngm:key-management ;
    vc:slug "memory-encryption" ;
    vc:sourceDomain "security" ;
    vc:supports ngm:secure-enclave ;
    vc:uses ngm:hardware-security-module .

ngm:memory-hierarchy a owl:Class ;
    rdfs:label "Memory Hierarchy"@en ;
    rdfs:comment "A memory hierarchy organises storage into layers of differing speed, size and cost so that frequently accessed data sits in fast caches close to the processor and bulk data resides in slower, larger memory."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:computer-hardware ],
        ngm:computer-hardware ;
    vc:enables ngm:gpu-architecture,
        ngm:real-time-rendering ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:computer-hardware ;
    vc:slug "memory-hierarchy" ;
    vc:sourceDomain "metaverse" .

ngm:mesh-data a owl:Class ;
    rdfs:label "Mesh Data"@en ;
    rdfs:comment "Mesh data is a structured representation of a three-dimensional surface or volume as a collection of vertices, edges, and polygonal faces — most commonly triangles or quads — that together define the geometry of a shape. It encodes both topological connectivity (which vertices form which faces) and geometric attributes (positions, normals, UV coordinates, vertex colours) required for rendering, simulation, and analysis. Mesh data serves as the primary interchange format between 3D modelling software, real-time engines, and spatial computing pipelines. It is produced by processes such as photogrammetry, structured-light scanning, LiDAR capture, and procedural generation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:coordinate-system ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:topology ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:vertex-buffer ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:surface-normal ],
        ngm:spatial-mesh ;
    vc:bridgesTo ngm:machine-learning,
        ngm:robotics ;
    vc:contrastsWith ngm:implicit-surface,
        ngm:neural-radiance-field,
        ngm:voxel-grid ;
    vc:enables ngm:3-d-reconstruction,
        ngm:3-d-rendering,
        ngm:collision-detection,
        ngm:differentiable-rendering,
        ngm:finite-element-analysis,
        ngm:level-of-detail ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:index-buffer,
        ngm:surface-normal,
        ngm:vertex-buffer ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:computer-graphics,
        ngm:gaussian-splatting,
        ngm:point-cloud,
        ngm:texture-mapping,
        ngm:three-dimensional-graphics ;
    vc:requires ngm:coordinate-system,
        ngm:topology ;
    vc:slug "mesh-data" ;
    vc:sourceDomain "spatial-computing" ;
    vc:standardizedBy ngm:khronos-group,
        ngm:universal-scene-description ;
    vc:uses ngm:lidar,
        ngm:photogrammetry,
        ngm:vertex-shader .

ngm:meta-llama-model-family a owl:Class ;
    rdfs:label "Meta Llama Model Family"@en ;
    rdfs:comment "Llama is a family of large language models developed by Meta and released, in large part, with open weights for research and commercial use. First introduced in 2023 with LLaMA, followed by Llama 2, Llama 3 and later versions, the models are transformer-based and trained on large text corpora. By releasing model weights under permissive terms, Meta enabled a wide range of independent fine-tuning and deployment, making Llama a common base for open models. The family spans several parameter sizes to suit different compute and latency requirements."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:meta-llama-model-family-3 ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:large-language-model ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:reinforcement-learning-from-human-feedback ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gpu-compute ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:transformer ],
        ngm:large-language-model ;
    vc:bridgesTo ngm:microsoft-copilot ;
    vc:contrastsWith ngm:google-ai-technology-corporation-gemini,
        ngm:gpt-4,
        ngm:mistral-ai-open-weight-model-family ;
    vc:enables ngm:fine-tuning,
        ngm:on-device-inference,
        ngm:retrieval-augmented-generation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:meta-llama-model-family-3 ;
    vc:implements ngm:grouped-query-attention,
        ngm:rotary-position-embedding ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:parameter-efficient-fine-tuning,
        ngm:quantisation ;
    vc:requires ngm:gpu-compute,
        ngm:large-language-model,
        ngm:reinforcement-learning-from-human-feedback,
        ngm:transformer ;
    vc:slug "meta-llama-model-family" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:byte-pair-encoding,
        ngm:instruction-tuning .

ngm:metadata-registry a owl:Class ;
    rdfs:label "Metadata Registry"@en ;
    rdfs:comment "Centralised systems for managing metadata according to standards like ISO/IEC 11179, providing authoritative definitions, usage rules, and data element descriptions to ensure consistency, interoperability, and governance across enterprise data systems."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-stewardship ],
        [ a owl:Restriction ;
