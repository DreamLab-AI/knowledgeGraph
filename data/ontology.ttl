ngm:convolution a owl:Class ;
    rdfs:label "Convolution"@en ;
    rdfs:comment "Convolution is a mathematical operation that combines two functions by sliding one (the kernel or filter) over another (the input signal or image) and computing a weighted sum of overlapping values at each position, producing a third function that expresses how the shape of one modifies the other. In deep learning and signal processing it provides a translation-equivariant mechanism for local feature extraction with shared parameter weights."@en ;
    rdfs:subClassOf ngm:signal-processing ;
    vc:enables ngm:convolutional-neural-network ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:image-processing ;
    vc:slug "convolution" ;
    vc:sourceDomain "ai" ;
    vc:supports ngm:deep-learning ;
    vc:uses ngm:feature-extraction .

ngm:cosmos-ibc a owl:Class ;
