    vc:sourceDomain "robotics" .

ngm:f1-score a owl:Class ;
    rdfs:label "F1 Score"@en ;
    rdfs:comment "A classification performance metric representing the harmonic mean of precision and recall, providing a single score that balances a model's ability to avoid false positives (precision) with its ability to avoid false negatives (recall), calculated to give equal weight to both metrics whilst pena..."@en ;
