ngm:cognitive-feedback-interface a owl:Class ;
    rdfs:label "Cognitive Feedback Interface"@en ;
    rdfs:comment "Adaptive interface system that dynamically adjusts information flow and interaction modalities based on real-time assessment of user cognitive state, attention levels, and mental workload."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:eye-tracking ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:machine-learning-discipline ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:brain-computer-interfaces ],
        ngm:sc-interaction ;
    skos:broader ngm:sc-interaction ;
    vc:enables ngm:adaptive-information-display,
        ngm:attention-aware-interaction,
        ngm:cognitive-load-management,
        ngm:personalized-ux ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:adaptive-ui-controller,
        ngm:attention-tracker,
        ngm:cognitive-state-monitor,
        ngm:workload-analyzer ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:brain-computer-interfaces,
        ngm:cognitive-model,
        ngm:eye-tracking,
        ngm:machine-learning-discipline ;
    vc:slug "cognitive-feedback-interface" ;
    vc:sourceDomain "spatial-computing" .

