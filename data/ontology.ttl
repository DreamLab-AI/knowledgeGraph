        ngm:interpretability,
        ngm:static-analysis ;
    vc:requires ngm:formal-specification,
        ngm:temporal-logic ;
    vc:slug "formal-verification" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:ai-risk-management,
        ngm:cryptographic-protocol,
        ngm:hardware-design,
        ngm:smart-contract .

ngm:microservices a owl:Class ;
    rdfs:label "Microservices"@en ;
    rdfs:comment "Microservices is an architectural style in which a large application is decomposed into a suite of small, independently deployable services, each responsible for a distinct bounded business capability and communicating through well-defined lightweight APIs or message channels. Each service runs in its own process, manages its own data store, and can be developed, deployed, scaled, and retired independently of other services. The pattern contrasts with monolithic architectures by enabling polyglot development, fine-grained fault isolation, and organisational alignment of teams with service ownership, at the cost of increased operational and distributed-systems complexity."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:container-orchestration ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:service-mesh ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:service-discovery ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:continuous-delivery ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:api-gateway ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:circuit-breaker ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:observability ],
        ngm:software-architecture ;
    vc:bridgesTo ngm:serverless-architecture ;
    vc:contrastsWith ngm:monolithic-architecture,
        ngm:service-oriented-architecture ;
    vc:enables ngm:devops,
        ngm:fault-tolerance,
        ngm:persistence,
        ngm:scalability ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:api-gateway,
        ngm:circuit-breaker,
        ngm:service-discovery,
        ngm:service-mesh ;
    vc:isPartOf ngm:cloud-native-applications,
        ngm:distributed-systems ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:domain-driven-design,
        ngm:event-driven-architecture,
        ngm:twelve-factor-app ;
    vc:requires ngm:container-orchestration,
        ngm:continuous-delivery,
        ngm:observability ;
    vc:slug "microservices" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:docker-containerisation-platform,
        ngm:g-rpc,
        ngm:kubernetes,
