ngm:el-salvador a owl:Class ;
    rdfs:label "El Salvador"@en ;
    rdfs:comment "El Salvador is a Central American nation-state that in September 2021 became the first country in the world to adopt Bitcoin as legal tender alongside the United States dollar, enacting the Bitcoin Law (Ley Bitcoin). The policy required all businesses capable of providing the technology to accept Bitcoin for goods and services, deployed the government-issued Chivo Wallet to facilitate adoption, and established the Lightning Network as the primary payment rail for low-value retail transactions. El Salvador serves in this knowledge graph as a primary real-world case study for sovereign-level cryptocurrency adoption, digital-currency monetary policy, and the intersection of blockchain infrastructure with national governance."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:public-key-cryptography ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:internet-connectivity ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:blockchain ],
        ngm:bc-governance-and-regulation ;
    skos:broader ngm:bc-governance-and-regulation ;
    vc:bridgesTo ngm:decentralised-finance,
        ngm:digital-identity,
        ngm:smart-contract ;
    vc:contrastsWith ngm:central-bank-digital-currency,
        ngm:fiat-currency ;
    vc:enables ngm:cryptocurrency,
        ngm:financial-inclusion,
        ngm:peer-to-peer-payment ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:bitcoin ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:central-bank-digital-currency,
        ngm:crypto-regulation,
        ngm:dollarisation,
        ngm:international-monetary-fund,
        ngm:monetary-policy,
        ngm:remittances ;
    vc:requires ngm:blockchain,
        ngm:internet-connectivity,
        ngm:public-key-cryptography ;
    vc:slug "el-salvador" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:bitcoin-proof-of-work-protocol-mining ;
    vc:uses ngm:chivo-wallet,
        ngm:digital-wallet,
        ngm:lightning-network,
        ngm:proof-of-work .

