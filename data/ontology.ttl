ngm:model-ops a owl:Class ;
    rdfs:label "ModelOps"@en ;
    rdfs:comment "ModelOps is the discipline of industrialising the end-to-end governance and operational lifecycle of AI and machine learning models, encompassing the processes, tooling, and organisational practices required to reliably build, validate, deploy, monitor, and retire models in production environments. It extends MLOps beyond technical pipeline automation to include regulatory compliance, risk management, model lineage tracking, and cross-functional accountability."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:machine-learning-pipeline ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ai-governance ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-governance ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:model-training ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:model-evaluation-results ],
        ngm:ai-infrastructure,
        ngm:gartner-prediction ;
    vc:enables ngm:explainability,
        ngm:responsible-ai ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:machine-learning-pipeline,
        ngm:model-evaluation-results,
        ngm:model-training ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:ai-governance-framework,
        ngm:ai-infrastructure,
        ngm:machine-learning ;
    vc:requires ngm:ai-governance,
        ngm:data-governance ;
    vc:slug "model-ops" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:ai-risk-management ;
    vc:uses ngm:feature-store,
        ngm:machine-learning-framework .

