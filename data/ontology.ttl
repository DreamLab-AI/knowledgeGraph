    vc:uses ngm:optical-flow,
        ngm:signal-processing .

ngm:mu-sig-2 a owl:Class ;
    rdfs:label "MuSig2"@en ;
    rdfs:comment "MuSig2 is a two-round multi-signature protocol for the Schnorr signature scheme, enabling a group of signers to collaboratively produce a single aggregate signature and a single aggregate public key that are indistinguishable on-chain from a standard single-signer Schnorr signature. It improves upon the original MuSig (three-round) by eliminating one communication round without sacrificing security, using a technique of committing to multiple nonces per signer and computing a linear combination of those nonces after seeing all co-signers' commitments. The scheme is proven secure in the random oracle model under the discrete logarithm assumption and is resistant to the rogue-key and Wagner attacks that affect naive key-aggregation approaches."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:schnorr-signatures ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:key-aggregation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:elliptic-curve-cryptography ],
        ngm:multisignature ;
    vc:bridgesTo ngm:decentralised-autonomous-organisation,
        ngm:secure-multi-party-computation ;
    vc:contrastsWith ngm:shamir-secret-sharing ;
    vc:enables ngm:custody,
        ngm:privacy-preserving,
        ngm:taproot,
        ngm:threshold-signature-scheme ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:bip-327 ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:digital-signature,
        ngm:proof-of-work ;
    vc:requires ngm:elliptic-curve-cryptography,
        ngm:key-aggregation,
        ngm:schnorr-signatures ;
    vc:slug "mu-sig-2" ;
    vc:sourceDomain "security" ;
    vc:standardizedBy ngm:bitcoin-proof-of-work-protocol-improvement-proposals ;
    vc:supports ngm:bitcoin,
        ngm:hardware-wallet,
        ngm:lightning-network ;
    vc:uses ngm:hash-function,
        ngm:random-oracle-model,
        ngm:secp256k1 .

ngm:multi-agent-orchestration-frameworks a owl:Class ;
    rdfs:label "Multi-Agent Orchestration Frameworks"@en ;
    rdfs:comment "Frameworks enabling multiple AI agents to collaborate on complex tasks through role assignment, structured conversations, handoffs, and coordinated workflows — includes openai-agents-python, crewAI, autogen, MetaGPT, ChatDev, PraisonAI, and agent-squad."@en ;
