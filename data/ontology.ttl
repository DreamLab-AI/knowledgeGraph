        ngm:convolutional-neural-network,
        ngm:transformer-architecture .

ngm:immersive-audio a owl:Class ;
    rdfs:label "Immersive Audio"@en ;
    rdfs:comment "Immersive audio refers to audio reproduction and processing technologies that create a convincing three-dimensional sound field, enveloping the listener in a spatially accurate sonic environment. It encompasses object-based audio formats, binaural rendering, ambisonics, and head-related transfer function (HRTF) personalisation, enabling the perception of sounds positioned above, below, and around the listener rather than confined to a flat stereo plane."@en ;
    rdfs:subClassOf ngm:audio-technology ;
    vc:enables ngm:extended-reality-xr,
        ngm:immersive-experience-pipeline ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:audio-engine,
        ngm:audio-spatialization ;
    vc:slug "immersive-audio" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:audio-processing,
        ngm:binaural-rendering,
        ngm:spatial-audio .

ngm:immersive-audio-technology a owl:Class ;
    rdfs:label "Immersive Audio Technology"@en ;
    rdfs:comment "Technologies and techniques for rendering spatially accurate, three-dimensional soundscapes within virtual and augmented reality environments. Encompasses binaural rendering, ambisonics, head-related transfer function (HRTF) personalisation, and real-time positional audio to create convincing auditory presence that reinforces visual immersion."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:xr-runtime-environment ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:rendering-pipeline ],
        ngm:sc-display-and-rendering ;
    skos:broader ngm:sc-display-and-rendering ;
    vc:enables ngm:immersive-experience,
        ngm:virtual-theater ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:requires ngm:rendering-pipeline,
        ngm:xr-runtime-environment ;
    vc:slug "immersive-audio-technology" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:augmented-reality,
        ngm:virtual-reality ;
    vc:uses ngm:signal-processing,
        ngm:spatial-audio .

ngm:immersive-computing a owl:Class ;
    rdfs:label "Immersive Computing"@en ;
    rdfs:comment "Immersive computing is the broad discipline of designing and operating computing systems that surround users with synthetic or blended sensory environments — encompassing virtual reality, augmented reality, and mixed reality — to create a subjective sense of presence within a digitally mediated space. It integrates real-time 3D rendering, spatial tracking, haptic feedback, and multi-modal interaction to replace or augment the user's natural perceptual field."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:immersive-experience ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:augmented-reality ],
        ngm:extended-reality ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:augmented-reality,
        ngm:immersive-experience ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:immersive-collaboration,
        ngm:spatial-computing ;
    vc:slug "immersive-computing" ;
    vc:sourceDomain "metaverse" ;
    vc:uses ngm:3-d-rendering .

ngm:immersive-interface a owl:Class ;
    rdfs:label "Immersive Interface"@en ;
    rdfs:comment "User interaction systems for VR, AR, and metaverse applications encompassing spatial user interfaces, haptic feedback devices, gesture recognition, voice control, and multimodal input mods that enable natural, intuitive engagement with virtual environments."@en ;
    rdfs:subClassOf ngm:human-computer-interface,
        ngm:sc-interaction ;
    skos:broader ngm:sc-interaction ;
    vc:enables ngm:natural-vr-interaction ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:slug "immersive-interface" ;
    vc:sourceDomain "spatial-computing" .

ngm:immersive-workspaces a owl:Class ;
    rdfs:label "Immersive Workspaces"@en ;
    rdfs:comment "Immersive workspaces are physical or virtual environments enhanced with spatial and extended-reality technologies—including AR, VR, and mixed reality—that allow users to interact intuitively with digital content and collaborators in three-dimensional space, fostering a strong sense of presence and engagement. They integrate spatial computing principles to support real-time manipulation of data, collaborative visualisation, immersive training, and seamless transitions between physical and digital environments. Immersive workspaces are increasingly deployed across corporate, industrial, and educational settings to support hybrid and remote collaboration at scale."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:spatial-audio ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:augmented-reality ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:virtual-reality ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:haptic-feedback ],
        ngm:metaverse-and-telecollaboration,
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:enables ngm:immersive-learning,
        ngm:remote-collaboration,
        ngm:telepresence ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:augmented-reality,
        ngm:haptic-feedback,
        ngm:spatial-audio,
        ngm:virtual-reality ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:immersive-experience,
        ngm:spatial-computing ;
    vc:slug "immersive-workspaces" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:digital-twin,
        ngm:extended-reality-xr,
        ngm:xr-device .

ngm:immutable-record a owl:Class ;
    rdfs:label "Immutable Record"@en ;
    rdfs:comment "An immutable record is a data entry that, once written, cannot be altered or deleted without cryptographic or consensus-based detection of tampering. Immutability is enforced through hash chaining, Merkle trees, distributed ledger consensus mechanisms, or append-only data structures, making immutable records foundational to audit trails, provenance tracking, and trustworthy data archiving."@en ;
    rdfs:subClassOf ngm:distributed-ledger ;
    vc:enables ngm:audit-log,
        ngm:data-provenance,
        ngm:provenance-tracking ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:data-integrity,
        ngm:trusted-timestamping ;
    vc:slug "immutable-record" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:blockchain-ledger,
        ngm:cryptographic-signature,
        ngm:merkle-tree .

ngm:incentive-mechanism a skos:Concept ;
    rdfs:label "Incentive Mechanism"@en .

ngm:inclusive-participation a owl:Class ;
    rdfs:label "Inclusive Participation"@en ;
    rdfs:comment "Inclusive participation is the design principle and operational practice of structuring technologies, platforms, and governance processes to enable full and meaningful engagement by individuals of diverse abilities, economic circumstances, cultural backgrounds, and technical literacy levels, removing barriers that would otherwise exclude underrepresented or marginalised populations. In technology contexts, inclusive participation encompasses accessible user interface design, multilingual support, low-bandwidth alternatives, assistive technology compatibility, and governance mechanisms that distribute decision-making power beyond technically or economically privileged groups. It is a cross-cutting concern in XR platform design, DAO governance, metaverse standards development, and public goods infrastructure."@en ;
    rdfs:subClassOf ngm:participation-framework ;
    vc:enables ngm:community-governance,
        ngm:digital-technology-access-equity,
        ngm:inclusive-design ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:diversity-non-discrimination-and-fairness,
        ngm:governance-framework,
        ngm:social-impact,
        ngm:xr-accessibility-standards ;
    vc:slug "inclusive-participation" ;
    vc:sourceDomain "governance" ;
    vc:uses ngm:accessibility,
        ngm:localization,
        ngm:universal-design .

