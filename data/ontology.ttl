        ngm:platform-engineering ;
    vc:requires ngm:hardware-abstraction ;
    vc:slug "configuration" ;
    vc:sourceDomain "spatial-computing" .

ngm:consensus a owl:Class ;
    rdfs:label "Consensus"@en ;
    rdfs:comment "The general problem of getting distributed processes to agree on a common value or decision despite failures, communication delays or adversarial behaviour."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
