ngm:sidetree-protocol a owl:Class ;
    rdfs:comment "The Sidetree Protocol is a layer-two protocol for operating scalable decentralised identifier networks on top of any existing decentralised ledger without requiring trusted intermediaries or special-purpose consensus. It batches large numbers of DID create, update, recover, and deactivate operations, anchors a single compact commitment to the underlying chain, and stores the operation data in content-addressed storage so that any node can deterministically replay the operation log to compute current DID states. This separation of anchoring from data lets identifier throughput scale far beyond the base chain's transaction capacity."@en ;
    rdfs:label "Sidetree Protocol"@en ;
    rdfs:subClassOf ngm:did-method ;
    rdfs:subClassOf _:r19332 ;
