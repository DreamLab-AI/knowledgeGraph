ngm:metrics a owl:Class ;
    rdfs:comment "Metrics are numeric, time-series measurements that quantify the state and behaviour of systems, services and infrastructure over time. As one of the three pillars of observability alongside logs and traces, they are typically aggregated counters, gauges and histograms scraped or pushed at regular intervals. Metrics enable efficient trend analysis, alerting and capacity planning at scale because they compress system behaviour into compact, queryable numeric series."@en ;
    rdfs:label "Metrics"@en ;
    rdfs:subClassOf ngm:observability ;
    rdfs:subClassOf _:r14288 ;
