ngm:fundamental-rights-impact-assessment a owl:Class ;
    rdfs:label "Fundamental Rights Impact Assessment"@en ;
    rdfs:comment "A fundamental rights impact assessment is a structured process for evaluating, before and during deployment, how a system, policy, or AI application may affect people's fundamental rights such as dignity, non-discrimination, privacy, and freedom of expression. It documents the context of use, identifies affected groups and potential harms, assesses risks, and defines mitigation and oversight measures. It has become a governance instrument for high-risk AI, complementing data protection impact assessments and broader risk assessment."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:stakeholder-engagement ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:transparency ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:risk-assessment ],
        ngm:impact-assessment ;
    vc:bridgesTo ngm:data-protection-impact-assessment,
        ngm:human-rights ;
    vc:dependsOn ngm:governance ;
    vc:enables ngm:accountability,
        ngm:human-oversight ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:ai-governance,
        ngm:impact-assessment ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:ethics,
        ngm:governance-framework,
        ngm:privacy ;
    vc:requires ngm:risk-assessment,
        ngm:stakeholder-engagement,
        ngm:transparency ;
    vc:slug "fundamental-rights-impact-assessment" ;
    vc:sourceDomain "governance" ;
    vc:supports ngm:algorithmic-accountability,
