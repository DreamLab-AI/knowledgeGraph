    vc:slug "permissionless-lending" ;
    vc:sourceDomain "blockchain" .

ngm:persistent-ar-placement a owl:Class ;
    rdfs:label "Persistent AR Placement"@en ;
    rdfs:comment "The capability to anchor augmented reality content at specific real-world locations that persists across sessions and devices, using cloud-stored spatial anchors and environmental mapping to enable shared, location-based AR experiences."@en ;
    rdfs:subClassOf ngm:augmented-reality,
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:enables ngm:shared-ar-experiences ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:slug "persistent-ar-placement" ;
    vc:sourceDomain "spatial-computing" .

ngm:persistent-content-anchoring a owl:Class ;
    rdfs:label "Persistent Content Anchoring"@en ;
    rdfs:comment "Persistent content anchoring is the augmented-reality capability of fixing virtual content to a precise real-world location so that it reappears in the same place across sessions, devices, and users. It relies on saving spatial-anchor data, typically derived from visual feature maps, and relocalising against that map on subsequent visits. The technique is essential for shared and durable AR experiences tied to physical space."@en ;
    rdfs:subClassOf ngm:sc-display-and-rendering ;
    skos:broader ngm:sc-display-and-rendering ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:ar-frame,
        ngm:ar-registration ;
    vc:slug "persistent-content-anchoring" ;
    vc:sourceDomain "metaverse" .

ngm:personal-assistance a owl:Class ;
    rdfs:label "Personal Assistance"@en ;
    rdfs:comment "Personal assistance is an AI application class in which an agent helps an individual accomplish everyday tasks such as scheduling, information lookup, communication, and device or browser control. It combines natural-language understanding with tool use and memory to act on the user's behalf within their personal context. Modern personal assistants increasingly automate multi-step workflows rather than only answering questions."@en ;
