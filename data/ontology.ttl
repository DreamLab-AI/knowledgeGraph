    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:access-control,
        ngm:identity-management,
        ngm:legal-framework ;
    vc:slug "governance-model" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:gpu-resources a owl:Class ;
    rdfs:label "GPU Resources"@en ;
    rdfs:comment "GPU resources refer to the pool of graphics processing unit capacity — including VRAM, streaming multiprocessors, tensor cores, and associated interconnect bandwidth — that is provisioned, allocated, and managed as a computational resource for parallel workloads such as AI model training and inference, scientific simulation, computer graphics rendering, and high-performance computing. In cloud and data centre contexts, GPU resources are typically accessed through virtualisation or direct hardware passthrough, managed by schedulers that partition capacity across competing workloads and billed on per-hour or per-token consumption models."@en ;
    rdfs:subClassOf ngm:compute-resources ;
    vc:enables ngm:computer-graphics,
        ngm:gpu-computing,
        ngm:large-scale-compute ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:compute-infrastructure,
        ngm:edge-ai-accelerator,
        ngm:gpu-compute,
        ngm:inference-hardware ;
    vc:slug "gpu-resources" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:compute-shader,
        ngm:cuda,
        ngm:hardware-acceleration .

ngm:haptic-feedback-telepresence a owl:Class ;
    rdfs:label "Haptic Feedback Telepresence"@en ;
    rdfs:comment "Haptic Feedback Telepresence is the integration of tactile and kinesthetic feedback devices — such as force-feedback gloves, exoskeletons, and haptic controllers — into telepresence systems, enabling bidirectional touch sensation between a remote operator and a distant physical or virtual environment. It closes the sensorimotor loop beyond visual and auditory channels, allowing operators to feel forces, textures, weight, and vibration, which significantly enhances manipulation precision and immersive presence in teleoperation, surgical robotics, and VR collaboration contexts."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:teleoperation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:guaranteed-bandwidth ],
        ngm:dc-telepresence,
        ngm:haptic-feedback ;
    skos:broader ngm:dc-telepresence ;
    vc:enables ngm:immersive-communication,
        ngm:robotic-telepresence ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:telecollaboration-and-telepresence,
        ngm:telepresence ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:human-computer-interaction,
        ngm:tele-001-telepresence,
        ngm:virtual-environment ;
    vc:requires ngm:guaranteed-bandwidth,
        ngm:teleoperation ;
    vc:slug "haptic-feedback-telepresence" ;
    vc:sourceDomain "distributed-collaboration" ;
    vc:uses ngm:exoskeleton-robot,
        ngm:haptics,
        ngm:sensor-fusion,
        ngm:tactile-sensor .

ngm:healthcare-records a owl:Class ;
    rdfs:label "Healthcare Records"@en ;
    rdfs:comment "Blockchain-based electronic health record systems that employ immutable distributed ledgers, smart contracts for consent management, and cryptographic security to enable secure patient data sharing across healthcare providers. These systems give patients controlled access to their own records whilst maintaining HIPAA and GDPR compliance through hybrid on-chain/off-chain architectures integrating HL7 FHIR standards."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:smart-contract ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:access-control ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:distributed-ledger ],
        ngm:bc-network-component ;
    skos:broader ngm:bc-network-component ;
    vc:enables ngm:interoperability ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:self-sovereign-identity ;
    vc:requires ngm:access-control,
        ngm:distributed-ledger,
        ngm:smart-contract ;
    vc:slug "healthcare-records" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:encryption,
        ngm:privacy-by-design,
        ngm:verifiable-credentials .

ngm:heuristic-methods a owl:Class ;
    rdfs:label "Heuristic Methods"@en ;
    rdfs:comment "Heuristic methods in AI are problem-solving approaches that employ practical, experience-based techniques to find satisfactory solutions when optimal solutions are computationally infeasible. They include search heuristics such as A* and hill climbing, rule-of-thumb strategies, and metaheuristics such as genetic algorithms and simulated annealing, trading completeness for efficiency in combinatorial optimisation and planning tasks."@en ;
    rdfs:subClassOf ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:dependsOn ngm:search-algorithm ;
    vc:enables ngm:automated-planning,
        ngm:pathfinding-algorithm ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:planning-and-scheduling ;
    vc:slug "heuristic-methods" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:optimization-algorithm,
        ngm:search-algorithms .

ngm:http-protocol a owl:Class ;
    rdfs:label "HTTP Protocol"@en ;
    rdfs:comment "The Hypertext Transfer Protocol (HTTP) is a stateless, application-layer request-response protocol that forms the foundation of data communication on the World Wide Web, defining the format and semantics of messages exchanged between clients (browsers, API consumers) and servers (web servers, API gateways) over TCP/IP connections. Each HTTP transaction consists of a request message specifying a method (GET, POST, PUT, DELETE, PATCH, HEAD, OPTIONS), a target URI, headers conveying metadata, and an optional body, followed by a response message containing a status code, headers, and an optional body. HTTP has evolved through versions 1.0, 1.1, 2, and 3, with each version improving multiplexing, compression, and connection management."@en ;
    rdfs:subClassOf ngm:network-protocol ;
    vc:enables ngm:api-gateway,
        ngm:content-delivery-network-cdn,
        ngm:rest-api,
        ngm:web-socket-protocol ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:graph-ql,
        ngm:open-api-specification ;
    vc:slug "http-protocol" ;
    vc:sourceDomain "web" ;
    vc:uses ngm:communication-protocol,
        ngm:tls .

ngm:human-rights a owl:Class ;
    rdfs:label "Human Rights"@en ;
    rdfs:comment "Fundamental rights and freedoms inherent to all human beings as recognised in international instruments including the Universal Declaration of Human Rights, which AI systems must respect and protect throughout their lifecycle."@en ;
    rdfs:subClassOf ngm:sc-governance-and-safety ;
    skos:broader ngm:sc-governance-and-safety ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.95"^^xsd:float ;
    vc:relatedTo ngm:ai-ethics,
        ngm:blockchain-technology,
        ngm:digital-rights,
        ngm:privacy-rights ;
    vc:slug "human-rights" ;
    vc:sourceDomain "spatial-computing" .

ngm:identity-layer a owl:Class ;
    rdfs:label "Identity Layer"@en ;
    rdfs:comment "The Identity Layer is the cross-cutting stratum that establishes, represents, and verifies the identities of participants and resources. It sits above the Cryptographic Layer, on which its proofs rest, and below access, policy, and governance strata that reason about who is acting. It contains identifiers, credentials, authentication mechanisms, and the bindings between them."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:identifier-layer ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptographic-layer ],
        ngm:owl-thing ;
    vc:enables ngm:custody-layer,
        ngm:policy-layer ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:cryptographic-layer,
        ngm:identifier-layer ;
    vc:slug "identity-layer" ;
    vc:sourceDomain "identity" .

ngm:identity-verification-system a owl:Class ;
    rdfs:label "Identity Verification System"@en ;
    rdfs:comment "An identity verification system is a set of processes and technologies that confirm a person is who they claim to be, often during onboarding. It typically combines document checks, biometrics and data validation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:biometric-authentication ],
        ngm:identity-management ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:biometric-authentication ;
    vc:slug "identity-verification-system" ;
    vc:sourceDomain "identity" .

ngm:ieee-control-systems-society a owl:Class ;
    rdfs:label "IEEE Control Systems Society"@en ;
    rdfs:comment "The IEEE Control Systems Society (CSS) is a professional technical organisation within the Institute of Electrical and Electronics Engineers dedicated to advancing the theory, design, and application of control systems across engineering disciplines. It publishes flagship journals including IEEE Transactions on Automatic Control and the IEEE Control Systems Magazine, and organises premier conferences such as the Conference on Decision and Control (CDC). The Society bridges classical control theory with modern machine learning and autonomous systems research, promoting standards, educational resources, and an international community of practitioners. Its technical committees address domains ranging from robotics and aerospace to networked systems and intelligent transportation."@en ;
    rdfs:subClassOf ngm:control-system ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:deep-learning,
        ngm:embedded-systems,
        ngm:infra-software-engineering,
        ngm:machine-learning,
        ngm:model-based-control ;
    vc:slug "ieee-control-systems-society" ;
    vc:sourceDomain "robotics" ;
    vc:standardizedBy ngm:control-theory ;
    vc:supports ngm:autonomous-robot,
        ngm:autonomous-system,
        ngm:autonomous-vehicle,
        ngm:robotics .

ngm:immersive-entertainment a owl:Class ;
    rdfs:label "Immersive Entertainment"@en ;
    rdfs:comment "Entertainment experiences leveraging VR, AR, and mixed reality technologies to create interactive, participatory content that transforms audiences from passive spectators into active participants within gaming, theme parks, live events, and digital experiences."@en ;
    rdfs:subClassOf ngm:digital-entertainment,
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:enables ngm:interactive-storytelling ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:slug "immersive-entertainment" ;
    vc:sourceDomain "spatial-computing" .

ngm:immersive-experiences a owl:Class ;
    rdfs:label "Immersive Experiences"@en ;
    rdfs:comment "Digital interactions utilising VR, AR, and mixed reality technologies to create engaging, interactive environments that generate a sense of presence and participation, spanning gaming, education, enterprise collaboration, and consumer applications within metaverse platforms."@en ;
    rdfs:subClassOf ngm:digital-experience,
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:enables ngm:virtual-presence ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:slug "immersive-experiences" ;
    vc:sourceDomain "spatial-computing" .

ngm:incident-reporting a owl:Class ;
    rdfs:label "Incident Reporting"@en ;
    rdfs:comment "Incident Reporting is a systematic process by which organisations detect, document, classify, and communicate adverse events, near-misses, or anomalous system behaviours to relevant stakeholders, regulatory bodies, and affected parties. In AI and digital systems contexts, it covers cybersecurity breaches, AI system failures, algorithmic harms, and data protection violations. Effective incident reporting is foundational to organisational learning, regulatory compliance, and public accountability, enabling causal analysis that drives systemic improvement. Mandatory disclosure obligations are increasingly codified in sector-specific legislation including NIS2, the EU AI Act, and financial services regulations."@en ;
    rdfs:subClassOf ngm:compliance-framework ;
    vc:enables ngm:algorithmic-transparency-reports,
        ngm:compliance-monitoring,
        ngm:esg-reporting ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:ai-incident,
        ngm:audit-trail,
        ngm:incident-response ;
    vc:slug "incident-reporting" ;
    vc:sourceDomain "governance" ;
    vc:supports ngm:data-breach,
        ngm:vulnerability ;
    vc:uses ngm:ai-monitoring,
        ngm:compliance-audit-trail .

ngm:inference-serving a owl:Class ;
    rdfs:label "Inference Serving"@en ;
    rdfs:comment "Inference serving is the operation of running trained models in production to answer prediction requests at scale. It combines an inference engine with infrastructure for batching, scaling and monitoring."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:model-serving ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ai-model-inference-engine ],
        ngm:model-serving ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:ai-model-inference-engine,
        ngm:model-serving ;
    vc:slug "inference-serving" ;
    vc:sourceDomain "machine-learning" .

ngm:information-architecture a owl:Class ;
    rdfs:label "Information Architecture"@en ;
    rdfs:comment "Information Architecture is the structural design of shared information environments — organising, labelling, and navigating content so that users and systems can find and understand data efficiently. In spatial computing and metaverse contexts it governs how virtual worlds expose content hierarchies, semantic namespaces, and navigation schemas that enable interoperability across heterogeneous platforms. Effective information architecture draws on ontologies, controlled vocabularies, and metadata standards to ensure content remains discoverable, reusable, and machine-interpretable."@en ;
    rdfs:subClassOf ngm:sc-standards-and-interop ;
    skos:broader ngm:sc-standards-and-interop ;
    vc:enables ngm:information-retrieval,
        ngm:semantic-interoperability ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:relatedTo ngm:knowledge-organization-system ;
    vc:slug "information-architecture" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:controlled-vocabulary,
        ngm:metadata-standard,
        ngm:ontology .

ngm:institutional-custody a owl:Class ;
    rdfs:label "Institutional Custody"@en ;
    rdfs:comment "Institutional custody is the regulated safekeeping of digital assets on behalf of organisations such as funds, exchanges, and corporations, combining cryptographic key-management infrastructure with legal, operational, and insurance controls that meet fiduciary standards. Providers use cold storage, multi-signature and multi-party-computation schemes, hardware security modules, and segregated accounts to protect client assets against theft, loss, and insider risk while supporting auditability and regulatory reporting. It is a precondition for large-scale institutional participation in crypto markets."@en ;
    rdfs:subClassOf ngm:custody ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:digital-asset-custody,
        ngm:financial-regulation ;
    vc:slug "institutional-custody" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:institutional-investment ;
    vc:uses ngm:cold-storage,
        ngm:multi-signature-wallet .

ngm:institutional-layer a owl:Class ;
    rdfs:label "Institutional Layer"@en ;
    rdfs:comment "The Institutional Layer is the cross-cutting stratum that represents the organisations, roles, and durable arrangements through which a system operates in the wider world. It sits above the Governance Layer, embodying its decisions in standing bodies, and depends on regulatory and compliance structures. It contains organisational entities, mandates, and the relationships between them."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:governance-layer ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:regulatory-layer ],
        ngm:owl-thing ;
    vc:enables ngm:organisational-layer,
        ngm:social-layer ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:governance-layer,
        ngm:regulatory-layer ;
    vc:slug "institutional-layer" ;
    vc:sourceDomain "institutional" .

ngm:intent-classification a owl:Class ;
    rdfs:label "Intent Classification"@en ;
    rdfs:comment "Intent classification is a natural language processing task that assigns a user utterance to one or more predefined intent categories, enabling a system to determine the semantic goal behind an input. It forms the core routing component of conversational AI systems, mapping raw text to structured action labels such as 'book_flight', 'check_balance', or 'cancel_order'."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:natural-language-understanding ],
        ngm:nlptask ;
    vc:enables ngm:conversational-ai,
        ngm:dialogue-system ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:intent-recognition,
        ngm:named-entity-recognition ;
    vc:requires ngm:natural-language-understanding ;
    vc:slug "intent-classification" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:natural-language-processing .

ngm:interaction-design a owl:Class ;
    rdfs:label "Interaction Design"@en ;
    rdfs:comment "Interaction design is the practice of defining and shaping the behaviour of interactive systems — how they respond to user inputs, how they communicate state, and how they guide users through tasks — with the goal of creating products that are usable, efficient, and satisfying. It encompasses the design of interaction flows, feedback mechanisms, affordances, timing, and error recovery patterns across digital and physical interfaces. Interaction design is distinguished from graphic or visual design by its focus on dynamic behaviour over time rather than static visual composition, and from software engineering by its concern for the human experience of system use rather than the technical implementation of system function."@en ;
    rdfs:subClassOf ngm:human-computer-interaction ;
    vc:enables ngm:accessible-design,
        ngm:inclusive-design,
        ngm:product-design ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:accessibility,
        ngm:usability-testing,
        ngm:user-experience,
        ngm:user-interface ;
    vc:slug "interaction-design" ;
    vc:sourceDomain "web" ;
    vc:uses ngm:cognitive-science,
        ngm:feedback-mechanism,
        ngm:information-architecture .

ngm:io-t-infrastructure a owl:Class ;
    rdfs:label "IoT Infrastructure"@en ;
    rdfs:comment "IoT infrastructure is the integrated stack of hardware, networking, middleware, and cloud or edge platforms that enables the deployment, connectivity, management, and data processing of Internet of Things device fleets at scale. It encompasses device provisioning and lifecycle management, low-power wide-area or local-area communication protocols, edge gateways that aggregate and pre-process sensor data, secure device identity and over-the-air update mechanisms, and cloud or fog computing backends that host the data pipelines, analytics, and control planes for IoT applications across industrial, urban, consumer, and agricultural domains."@en ;
    rdfs:subClassOf ngm:digital-infrastructure ;
    vc:enables ngm:digital-twin,
        ngm:io-t-ai-integration,
        ngm:real-time-monitoring ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:industrial-io-t,
        ngm:internet-of-things,
        ngm:io-t-sensor-network ;
    vc:slug "io-t-infrastructure" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:edge-computing,
        ngm:embedded-systems,
        ngm:mqtt .

ngm:iso-14064 a owl:Class ;
    rdfs:label "ISO 14064"@en ;
    rdfs:comment "ISO 14064 is a three-part international standard series specifying principles and requirements for the quantification, monitoring, reporting, and independent verification of greenhouse gas (GHG) emissions and removals at organisational level (Part 1), at project level (Part 2), and for validation and verification bodies (Part 3). The standard provides a framework for organisations to account for their Scope 1, 2, and 3 emissions in a manner that is auditable by third-party verification bodies, and it underpins voluntary carbon markets, corporate sustainability reporting obligations, and blockchain-based carbon credit tokenisation schemes."@en ;
    rdfs:subClassOf ngm:bc-governance-and-regulation ;
    skos:broader ngm:bc-governance-and-regulation ;
    vc:enables ngm:carbon-accounting,
        ngm:carbon-credits,
        ngm:esg-reporting ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:ghg-protocol,
        ngm:third-party-auditor ;
    vc:slug "iso-14064" ;
    vc:sourceDomain "blockchain" ;
    vc:standardizedBy ngm:environmental-standards .

ngm:iso-26262 a owl:Class ;
    rdfs:label "ISO 26262"@en ;
    rdfs:comment "ISO 26262 is the international functional safety standard for electrical and electronic systems in road vehicles, published in 2011 and revised in 2018 to cover motorcycles and semi-conductors. It defines an Automotive Safety Integrity Level (ASIL) classification system (A through D, with D being most critical) that governs the rigour of safety lifecycle activities—hazard analysis, safety requirements, design, implementation, testing, and validation—required for each item. Compliance provides the framework for demonstrating that vehicle systems and software achieve an acceptable residual risk of hazardous failure."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:formal-verification ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:software-testing ],
        ngm:safety-standard ;
    vc:enables ngm:adas,
        ngm:autonomous-vehicle,
        ngm:self-driving-car ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:do-178-c,
        ngm:functional-safety,
        ngm:iec-61508 ;
    vc:requires ngm:formal-verification,
        ngm:software-testing ;
    vc:slug "iso-26262" ;
    vc:sourceDomain "infrastructure" .

ngm:iso-standards a owl:Class ;
    rdfs:label "Iso Standards"@en ;
    rdfs:comment "International Organization for Standardization specifications applicable to metaverse, VR, and AR technologies, including health and safety guidelines, 3D representation standards, avatar specifications, and mixed reality frameworks."@en ;
    rdfs:subClassOf ngm:sc-standards-and-interop,
        ngm:technical-standard ;
    skos:broader ngm:sc-standards-and-interop ;
    vc:enables ngm:regulatory-compliance ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:slug "iso-standards" ;
    vc:sourceDomain "spatial-computing" .

ngm:json-ld-context a owl:Class ;
    rdfs:label "JSON-LD Context"@en ;
    rdfs:comment "A JSON-LD Context is the machine-readable document or inline object that maps the shorthand terms and prefixes used in a JSON-LD document to their fully qualified IRIs in a target vocabulary or ontology. It serves as the bridge between the compact, human-readable JSON representation and the globally unambiguous RDF data model, enabling semantic interoperability across disparate systems. Contexts may be embedded inline within a document, referenced by URL, or composed from multiple context documents. The JSON-LD 1.1 specification extends context capabilities with scoped contexts, type-scoped and property-scoped contexts, and protected terms that resist accidental overriding. Correct context design is foundational to knowledge graph compilation and Linked Data publication."@en ;
    rdfs:subClassOf ngm:json-ld ;
    vc:enables ngm:knowledge-graph,
        ngm:semantic-interoperability ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:knowledge-representation,
        ngm:linked-data,
        ngm:rdf,
        ngm:semantic-web ;
    vc:slug "json-ld-context" ;
    vc:sourceDomain "ai" ;
    vc:supports ngm:ontology,
        ngm:schema-registry ;
    vc:uses ngm:json-ld-1-1,
        ngm:sparql .

ngm:key-derivation-function a owl:Class ;
    rdfs:label "Key Derivation Function"@en ;
    rdfs:comment "A cryptographic algorithm that derives one or more secret keys from a master secret using a pseudo-random function, transforming human-readable passwords or seed phrases into cryptographically secure key material while enabling hierarchical key generation and deterministic wallet recovery in bloc..."@en ;
    rdfs:subClassOf ngm:bc-cryptographic-primitive ;
    skos:broader ngm:bc-cryptographic-primitive ;
    vc:enables ngm:asymmetric-encryption ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:implements ngm:password-hashing ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:slug "key-derivation-function" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:hash-function .

ngm:kv-cache a owl:Class ;
    rdfs:label "KV Cache"@en ;
    rdfs:comment "A KV Cache (Key-Value Cache) in transformer-based language models is a memory structure that stores the computed key and value projection tensors from the multi-head self-attention mechanism for all previously processed tokens in a sequence, allowing autoregressive decoding to reuse these intermediate results rather than recomputing them at every generation step, thereby reducing the per-token computational cost from O(N²) to O(N) in generation. Each decoder layer maintains its own KV cache, which grows linearly with sequence length and model width, making memory bandwidth and GPU HBM capacity the primary constraints on inference throughput for long-context models. KV cache management strategies — including paged allocation (PagedAttention), prefix sharing, quantisation, and off-loading — are critical determinants of serving efficiency and cost."@en ;
    rdfs:subClassOf ngm:inference-engine ;
    vc:enables ngm:inference,
        ngm:large-language-models,
        ngm:speculative-decoding ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:attention-mechanism,
        ngm:context-window,
        ngm:query-key-value,
        ngm:self-attention ;
    vc:slug "kv-cache" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:flash-attention,
        ngm:gpu-compute,
        ngm:hardware-acceleration .

ngm:layer-2-solutions a owl:Class ;
    rdfs:label "Layer 2 Solutions"@en ;
    rdfs:comment "Layer 2 solutions are protocols and systems built atop a base blockchain (layer 1) that handle transactions off the main chain to increase throughput, reduce latency, and lower transaction costs, while periodically settling finality back to the underlying layer 1 for security. The principal layer 2 paradigms include optimistic rollups, zero-knowledge rollups, state channels, and sidechains, each offering distinct trust and performance tradeoffs."@en ;
    rdfs:subClassOf ngm:blockchain-scalability ;
    vc:enables ngm:blockchain-transaction,
        ngm:scalability ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:gas-fee-market,
        ngm:layer-2-scaling,
        ngm:payment-channel ;
    vc:slug "layer-2-solutions" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:sidechain,
        ngm:state-channel,
        ngm:zero-knowledge-proof .

ngm:lens-and-camera-calibration a owl:Class ;
    rdfs:label "Lens and Camera Calibration"@en ;
    rdfs:comment "Lens and Camera Calibration is the systematic metrology process of estimating the full set of geometric and photometric parameters that govern image formation in a camera-lens system, enabling precise bidirectional mapping between three-dimensional world coordinates and two-dimensional image pixe..."@en ;
