            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:network-protocol ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:sensor ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:real-time-monitoring ],
        ngm:industrial-automation ;
    vc:enables ngm:building-automation ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:actuator,
        ngm:data-serialization,
        ngm:real-time-monitoring,
        ngm:sensor ;
    vc:qualityScore "0.62"^^xsd:float ;
