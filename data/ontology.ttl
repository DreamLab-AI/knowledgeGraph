    vc:slug "verra-vcs-standard" ;
    vc:sourceDomain "metaverse" .

ngm:versioning-system a owl:Class ;
    rdfs:label "Versioning System"@en ;
    rdfs:comment "A versioning system is a mechanism that tracks, identifies and manages successive states of an artefact such as code, data, documents or taxonomy entries over time. It records changes, supports retrieval of historical versions, and resolves concurrent edits, enabling reproducibility, auditability and rollback. In curation and registry contexts it ensures controlled evolution of records while preserving provenance."@en ;
    rdfs:subClassOf ngm:data-management ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:digital-curation-platform,
        ngm:digital-taxonomy-registry ;
    vc:slug "versioning-system" ;
    vc:sourceDomain "infrastructure" .

ngm:vertex-processing a owl:Class ;
    rdfs:label "Vertex Processing"@en ;
    rdfs:comment "Vertex processing is the stage of the graphics pipeline that operates on each vertex of geometry, transforming its position from model space through world, view, and clip space, and computing or passing per-vertex attributes such as normals, texture coordinates, and colours. Executed largely by programmable vertex shaders on the GPU, it prepares primitives for clipping, perspective division, and rasterisation, and may feed subsequent geometry, tessellation, and fragment stages. As a foundational step in real-time rendering it determines screen-space placement and the interpolated inputs available to downstream shading."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:vertex-shader ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gpu ],
        ngm:graphics-pipeline ;
    vc:bridgesTo ngm:gpu-pipeline,
        ngm:rasterization ;
    vc:dependsOn ngm:shader ;
    vc:enables ngm:fragment-shading,
        ngm:rasterization ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:vertex-shader ;
    vc:implements ngm:geometry-processing ;
    vc:isPartOf ngm:rendering-pipeline ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:fragment-shading,
        ngm:geometry-processing,
        ngm:real-time-rendering-pipeline ;
    vc:requires ngm:gpu ;
    vc:slug "vertex-processing" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:real-time-rendering-pipeline ;
    vc:uses ngm:gpu,
        ngm:vertex-shader .

ngm:video-understanding a owl:Class ;
    rdfs:label "Video Understanding"@en ;
    rdfs:comment "Video understanding is the field of artificial intelligence concerned with extracting semantic meaning from video, including recognising objects, actions, events, and their temporal relationships across frames. Unlike single-image analysis, it must model motion, temporal context, and long-range dependencies to interpret what is happening over time. Modern approaches combine spatial feature extraction with temporal modelling using recurrent, 3D-convolutional, and transformer-based architectures, increasingly fused with language for captioning, retrieval, and question answering."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:scene-understanding ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:object-detection ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:action-recognition ],
        ngm:computer-vision ;
    vc:dependsOn ngm:deep-learning,
        ngm:feature-extraction ;
    vc:enables ngm:video-generation ;
