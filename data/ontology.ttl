    vc:sourceDomain "blockchain" ;
    vc:uses ngm:blockchain,
        ngm:blockchain-transaction,
        ngm:erc-20,
        ngm:smart-contract .

ngm:video-streaming a owl:Class ;
    rdfs:label "Video Streaming"@en ;
    rdfs:comment "Video Streaming is the continuous, real-time transmission of encoded video data over a network to a client device that decodes and renders the content progressively, without requiring the complete file to be downloaded before playback begins. It relies on transport protocols such as RTMP, HLS, DASH, and WebRTC, combined with adaptive bitrate (ABR) algorithms that dynamically adjust resolution and compression to match available network conditions. Modern deployments encompass live streaming, video-on-demand (VoD), 360-degree video, volumetric video, and cloud-rendered remote-display streaming, each with distinct latency, bandwidth, and codec trade-offs. Content delivery networks (CDNs), edge computing nodes, and specialised video codecs such as H.264, H.265/HEVC, AV1, and VP9 are the principal technical pillars enabling scalable, low-latency distribution at global scale."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:network-infrastructure ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:adaptive-bitrate-streaming ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:volumetric-video ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:video-codec ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:edge-computing ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:live-streaming ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:content-delivery-network ],
        ngm:network-infrastructure ;
    vc:bridgesTo ngm:inference,
        ngm:spatial-computing ;
    vc:contrastsWith ngm:broadcast-television ;
    vc:dependsOn ngm:bandwidth,
        ngm:latency-optimisation ;
    vc:enables ngm:cloud-gaming,
        ngm:metaverse-platform,
        ngm:remote-rendering,
        ngm:virtual-production ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:adaptive-bitrate-streaming,
        ngm:live-streaming,
        ngm:volumetric-video ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:bandwidth-adaptation,
        ngm:digital-rights-management,
        ngm:quality-of-service ;
    vc:requires ngm:content-delivery-network,
        ngm:edge-computing,
        ngm:network-infrastructure,
        ngm:video-codec ;
    vc:slug "video-streaming" ;
    vc:sourceDomain "infrastructure" ;
    vc:standardizedBy ngm:mpeg-dash,
        ngm:web-rtc ;
    vc:supports ngm:360-degree-video,
        ngm:extended-reality,
        ngm:social-vr ;
    vc:uses ngm:data-compression,
        ngm:real-time-rendering,
        ngm:web-rtc .

ngm:virtual-collaboration a owl:Class ;
    rdfs:label "Virtual Collaboration"@en ;
    rdfs:comment "A 3D immersive environment enabling geographically distributed teams to interact via avatar identities, perform work tasks in real time, and access shared artefacts through metaverse-enabled workspaces. Capabilities include interactive whiteboards, document co-editing, spatial audio, and persistent virtual rooms accessible via desktop, mobile, and VR/AR devices."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:network-infrastructure ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:spatial-audio ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:avatar ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:identity-management ],
        ngm:virtual-workspace ;
    vc:bridgesTo ngm:computer-supported-cooperative-work,
        ngm:distributed-collaboration ;
    vc:contrastsWith ngm:in-person-collaboration,
        ngm:video-conferencing ;
    vc:dependsOn ngm:real-time-communication,
        ngm:xr-hardware ;
    vc:enables ngm:cross-functional-collaboration,
        ngm:remote-team-meeting,
        ngm:virtual-onboarding ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:avatar,
        ngm:document-co-editing,
        ngm:interactive-whiteboard,
        ngm:virtual-meeting-room ;
    vc:isPartOf ngm:distributed-work,
        ngm:metaverse ;
    vc:qualityScore "0.68"^^xsd:float ;
    vc:relatedTo ngm:digital-twin,
        ngm:immersive-communication,
        ngm:social-vr ;
    vc:requires ngm:identity-management,
        ngm:network-infrastructure,
        ngm:spatial-audio ;
    vc:slug "virtual-collaboration" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:distributed-teams,
        ngm:knowledge-sharing ;
    vc:uses ngm:metaverse,
        ngm:presence-technology,
        ngm:web-xr .

ngm:web-authn a owl:Class ;
    rdfs:label "WebAuthn"@en ;
    rdfs:comment "WebAuthn (Web Authentication) is a W3C and FIDO Alliance standard that enables web applications to authenticate users using public-key cryptography rather than passwords, through hardware or software authenticators such as security keys, platform biometrics, and passkeys. The browser exposes the navigator.credentials API, which delegates cryptographic operations to a CTAP-compliant authenticator; the authenticator generates a key pair, stores the private key in a secure enclave, and signs authentication challenges that the relying party verifies using the registered public key. WebAuthn eliminates shared secrets from the authentication path, making phishing, credential stuffing, and replay attacks fundamentally impossible by design. It is the technical foundation of the passkey ecosystem deployed by Apple, Google, and Microsoft."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:relying-party ],
        ngm:authentication-mechanism ;
    vc:bridgesTo ngm:decentralised-identity,
        ngm:verifiable-credential-vc ;
    vc:contrastsWith ngm:one-time-password,
        ngm:password-authentication ;
    vc:enables ngm:multi-factor-authentication,
        ngm:passkey,
        ngm:passwordless-authentication,
        ngm:phishing-resistant-authentication,
        ngm:privacy-preserving-authentication ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:w3c-recommendation ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:biometric-authentication,
        ngm:credential-verification,
        ngm:digital-identity,
        ngm:security-key,
        ngm:web-standard ;
    vc:requires ngm:relying-party ;
    vc:slug "web-authn" ;
    vc:sourceDomain "security" ;
    vc:standardizedBy ngm:fido-alliance,
        ngm:w3-c ;
    vc:uses ngm:asymmetric-encryption,
        ngm:challenge-response-authentication,
        ngm:digital-signature,
        ngm:fido2,
        ngm:public-key-cryptography,
        ngm:secure-enclave .

ngm:web-socket a owl:Class ;
    rdfs:label "WebSocket"@en ;
    rdfs:comment "WebSocket is an application-layer communication protocol defined in RFC 6455 that establishes a persistent, full-duplex channel over a single TCP connection, initiated via an HTTP/1.1 upgrade handshake. Unlike the request-response model of HTTP, WebSocket permits the server and client to send data frames independently at any time after connection establishment, enabling low-latency bidirectional communication. The protocol specifies a lightweight framing mechanism with opcodes for text, binary, ping/pong keepalives, and graceful connection close, and is extended by RFC 7692 for per-message DEFLATE compression. It is the de facto standard transport for real-time web applications including collaborative editing, live dashboards, chat systems, and streaming LLM token output."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:hypertext-transfer-protocol ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:transmission-control-protocol ],
        ngm:network-protocol ;
    vc:bridgesTo ngm:inference-serving,
        ngm:large-language-model ;
    vc:contrastsWith ngm:long-polling,
        ngm:rest-api,
        ngm:server-sent-events,
        ngm:web-rtc ;
    vc:dependsOn ngm:load-balancer,
        ngm:publish-subscribe-pattern ;
    vc:enables ngm:collaborative-editing,
        ngm:event-driven-architecture,
        ngm:real-time-processing,
        ngm:server-sent-events ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:implements ngm:full-duplex-communication,
        ngm:rfc-6455 ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:g-rpc,
        ngm:latency ;
    vc:requires ngm:hypertext-transfer-protocol,
        ngm:transmission-control-protocol ;
