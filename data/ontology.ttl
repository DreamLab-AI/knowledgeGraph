# Carbon Footprint Measurement
blockchain:CarbonFootprintMeasurement rdf:type owl:Class ;
    rdfs:label "Carbon Footprint Measurement"@en ;
    rdfs:comment "Systematic quantification methodology for calculating total greenhouse gas emissions across organisational operations including energy consumption, supply chains, and waste. Measurement Frameworks utilise Emission Factors, Lifecycle Assessment, and Scope Classification to enable Carbon Accounting."@en ;
    skos:prefLabel "Carbon Footprint Measurement"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:blockchain:carbon-footprint-measurement" ;
