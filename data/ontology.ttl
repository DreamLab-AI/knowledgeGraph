    vc:uses ngm:cryptographic-hash-function,
        ngm:gossip-protocol .

ngm:dns a owl:Class ;
    rdfs:label "DNS"@en ;
    rdfs:comment "The Domain Name System (DNS) is a hierarchical, distributed naming system and directory service that translates human-readable domain names into IP addresses and other resource records required for locating internet services. Operating as a global, federated database partitioned into zones, DNS uses a delegation tree rooted at thirteen authoritative root-server clusters and propagates queries recursively through top-level domain, second-level domain, and sub-domain name servers. It is defined in RFC 1034 and RFC 1035 and extended by DNSSEC (RFC 4033-4035) to provide cryptographic integrity verification of responses, mitigating cache poisoning, spoofing, and man-in-the-middle attacks against the resolution chain."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:network-protocol ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:udp ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ip-addressing ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:tcp ],
        ngm:application-layer ;
    vc:bridgesTo ngm:distributed-systems,
        ngm:zero-knowledge-proof ;
    vc:enables ngm:content-delivery-network,
        ngm:http,
        ngm:service-discovery,
        ngm:tls ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:dns-resolver ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:anycast-routing,
        ngm:caching,
        ngm:load-balancing,
        ngm:network-security ;
    vc:requires ngm:ip-addressing,
        ngm:network-protocol,
        ngm:tcp,
        ngm:udp ;
    vc:slug "dns" ;
    vc:sourceDomain "infrastructure" ;
    vc:standardizedBy ngm:ietf .

ngm:energy-efficiency a owl:Class ;
    rdfs:label "Energy Efficiency"@en ;
    rdfs:comment "Energy efficiency is the property of a system that achieves a given output or function while consuming the least possible energy. In computing, robotics, and control systems it is measured as useful work per unit of energy, and is improved through better algorithms, hardware, scheduling, and motion optimisation. It is a core sustainability objective because reductions in energy draw lower operating cost and carbon footprint without sacrificing performance."@en ;
    rdfs:subClassOf ngm:sustainability ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:sustainability,
        ngm:velocity-control ;
    vc:slug "energy-efficiency" ;
    vc:sourceDomain "infrastructure" .

ngm:esg a owl:Class ;
    rdfs:label "ESG"@en ;
    rdfs:comment "Environmental, social and governance criteria used to evaluate the sustainability and ethical impact of an organisation's operations and investments."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:corporate-governance ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:sustainability ],
        ngm:sustainability ;
    vc:enables ngm:accountability,
        ngm:transparency ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:corporate-governance,
        ngm:sustainability ;
    vc:slug "esg" ;
    vc:sourceDomain "governance" .

ngm:evm a owl:Class ;
    rdfs:label "EVM"@en ;
    rdfs:comment "The Ethereum Virtual Machine (EVM) is a stack-based, sandboxed, quasi-Turing-complete virtual machine that executes smart contract bytecode on the Ethereum network and EVM-compatible blockchains. It defines a deterministic computation environment in which all nodes independently execute the same transactions to reach identical state transitions, using a gas metering system to bound computation and prevent denial-of-service attacks. The EVM specification encompasses opcodes, memory model, call semantics, and the gas cost schedule governing the economic cost of each computational step. As an open industry standard maintained by the Enterprise Ethereum Alliance, the EVM has been adopted by hundreds of alternative blockchain networks, establishing it as the dominant cross-chain execution environment."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:consensus-mechanism ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:gas-metering ],
        ngm:virtual-machine ;
    vc:bridgesTo ngm:formal-verification,
        ngm:zero-knowledge-proof ;
    vc:contrastsWith ngm:bitcoin-script ;
    vc:enables ngm:decentralised-finance,
        ngm:nft,
        ngm:smart-contract,
        ngm:smart-contract-execution,
        ngm:smart-contract-platform ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:evm-memory,
        ngm:evm-stack,
        ngm:gas-metering ;
    vc:implements ngm:eip,
        ngm:ethereum-yellow-paper ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:gas-optimization,
        ngm:vyper ;
    vc:requires ngm:consensus-mechanism,
        ngm:ethereum-node ;
    vc:slug "evm" ;
    vc:sourceDomain "blockchain" ;
    vc:standardizedBy ngm:enterprise-ethereum-alliance ;
    vc:supports ngm:optimistic-rollup,
        ngm:rollup,
        ngm:zk-rollup ;
    vc:uses ngm:bytecode,
        ngm:gas,
        ngm:merkle-patricia-trie,
        ngm:opcodes,
        ngm:solidity .

ngm:fairness-metrics a owl:Class ;
    rdfs:label "Fairness Metrics"@en ;
    rdfs:comment "Quantitative measures and mathematical frameworks used to evaluate whether an AI system produces equitable outcomes across demographic groups. Core metrics include demographic parity, equalized odds, equal opportunity, and predictive parity; selection among them depends on context and regulatory requirements, as metrics can conflict and no single criterion satisfies all fairness definitions simultaneously."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:demographic-parity ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:statistical-testing ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:group-vs-individual-fairness ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:confusion-matrix ],
        ngm:ai-governance-and-ethics ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:bridgesTo ngm:data-governance,
        ngm:regulatory-compliance ;
    vc:contrastsWith ngm:algorithmic-bias,
        ngm:disparate-impact ;
    vc:enables ngm:ai-audit,
        ngm:algorithmic-accountability,
        ngm:bias-mitigation-techniques ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:demographic-parity,
        ngm:equalized-odds,
        ngm:group-vs-individual-fairness ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:accountability,
        ngm:ai-fairness ;
    vc:requires ngm:confusion-matrix,
        ngm:protected-attributes,
        ngm:statistical-testing ;
    vc:slug "fairness-metrics" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:standardizedBy ngm:ieee-p-7003-2021,
        ngm:iso-iec-tr-24027,
        ngm:nist-ai-rmf ;
    vc:supports ngm:ai-governance,
        ngm:diversity-non-discrimination-and-fairness,
        ngm:responsible-ai ;
    vc:uses ngm:bias-detection-methods,
        ngm:model-evaluation .

ngm:file-system a owl:Class ;
    rdfs:label "File System"@en ;
    rdfs:comment "A file system is the data structure and associated management software that an operating system uses to organise, store, retrieve, and manage data on storage media. It defines how data is logically partitioned into named files and directories, governs access permissions, maintains metadata such as timestamps and ownership, and translates logical file operations into physical block I/O against underlying storage hardware. File systems range from local single-disk formats (NTFS, ext4, APFS) to distributed and network-attached systems (NFS, HDFS, GFS) that span many physical storage nodes."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:storage-hardware ],
        ngm:operating-system ;
    vc:bridgesTo ngm:distributed-storage,
        ngm:ipfs ;
    vc:contrastsWith ngm:database,
        ngm:object-storage ;
    vc:dependsOn ngm:device-drivers ;
    vc:enables ngm:access-control,
