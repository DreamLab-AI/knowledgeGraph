ngm:distributed-storage a owl:Class ;
    rdfs:label "Distributed Storage"@en ;
    rdfs:comment "Distributed storage is a class of storage system architecture in which data is partitioned, replicated, and managed across multiple physically separate nodes or clusters to achieve scalability, fault tolerance, and high availability beyond the capacity of any single machine. Such systems employ replication protocols, erasure coding, consistent hashing, and distributed consensus algorithms to maintain data integrity and consistency under node failure, network partition, and concurrent access. Examples include object stores such as Amazon S3, distributed file systems such as HDFS and Ceph, and NewSQL databases with sharded storage layers."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:fault-tolerance ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:data-replication ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:storage-layer ],
        ngm:distributed-system ;
    vc:enables ngm:data-management,
        ngm:high-availability,
        ngm:machine-learning-infrastructure,
        ngm:scalable-architecture ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:data-replication,
        ngm:fault-tolerance,
        ngm:storage-layer ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:cloud-infrastructure,
        ngm:data-storage,
        ngm:distributed-systems ;
    vc:slug "distributed-storage" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:data-lake,
        ngm:data-pipeline,
        ngm:training-data ;
    vc:uses ngm:data-compression,
        ngm:data-integrity,
        ngm:network-infrastructure .

ngm:erc-721 a owl:Class ;
    rdfs:label "ERC-721"@en ;
    rdfs:comment "ERC-721 is the Ethereum token standard that defines the interface for non-fungible tokens (NFTs), where each token is uniquely identified by a uint256 token ID and an associated owner address recorded on-chain. Unlike ERC-20 fungible tokens, which are interchangeable, each ERC-721 token is distinct and cannot be exchanged equivalently for another. The standard defines a minimal interface including ownership transfer, approval delegation, and balance queries, plus an optional metadata extension that associates each token with a URI resolving to off-chain JSON metadata including name, description, and image. ERC-721 is the foundational standard for digital art, collectibles, gaming items, and tokenised real-world assets on Ethereum."@en ;
    rdfs:subClassOf ngm:bc-token-and-asset ;
    skos:broader ngm:bc-token-and-asset ;
    vc:enables ngm:nft-marketplace,
        ngm:nft-minting ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:erc-20,
        ngm:nft,
        ngm:token-standard ;
    vc:slug "erc-721" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:smart-contract .

ngm:event-driven-architecture a owl:Class ;
    rdfs:label "Event Driven Architecture"@en ;
    rdfs:comment "A software architecture pattern for metaverse systems built from decoupled services that publish, consume, and route events representing state changes, enabling real-time responsiveness, independent scaling, and resilient distributed systems for immersive virtual experiences."@en ;
    rdfs:subClassOf ngm:sc-platform-and-environment,
        ngm:system-architecture ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:enables ngm:scalable-metaverse-infrastructure ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:slug "event-driven-architecture" ;
    vc:sourceDomain "spatial-computing" .

ngm:full-node a owl:Class ;
    rdfs:label "Full Node"@en ;
    rdfs:comment "A blockchain node that independently downloads, validates, and stores the complete transaction history of the chain from the genesis block, enforcing all consensus rules without trusting external parties. Full nodes are the gold standard for trustless participation and are the backbone of decentralisation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:blockchain ],
        ngm:bc-network-component,
        ngm:blockchain-entity,
        ngm:network-component ;
    skos:broader ngm:bc-network-component ;
    vc:enables ngm:blockchain-transaction,
        ngm:cryptographic-verification ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:blockchain-network,
        ngm:node ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:archival-node,
        ngm:blockchain-infrastructure,
        ngm:consensus-rule,
        ngm:decentralization ;
    vc:requires ngm:blockchain ;
    vc:slug "full-node" ;
    vc:sourceDomain "blockchain" .

ngm:generative-adversarial-network a owl:Class ;
    rdfs:label "Generative Adversarial Network"@en ;
    rdfs:comment "A Generative Adversarial Network (GAN) is a deep learning architecture in which a generator network and a discriminator network are trained simultaneously in an adversarial min-max game: the generator learns to produce synthetic samples indistinguishable from real data, while the discriminator learns to detect fakes. GANs underpin high-fidelity image synthesis, video generation, data augmentation, and synthetic data creation across domains including healthcare, finance, and computer vision."@en ;
    rdfs:subClassOf ngm:ai-model-architecture ;
    skos:broader ngm:ai-model-architecture ;
    vc:contrastsWith ngm:autoencoder,
        ngm:diffusion-model ;
    vc:enables ngm:image-generation,
        ngm:synthetic-data,
        ngm:synthetic-media ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:generative-ai ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:slug "generative-adversarial-network" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:industrial-io-t a owl:Class ;
    rdfs:label "Industrial IoT"@en ;
    rdfs:comment "Industrial IoT (IIoT) is the extension of Internet of Things technologies into industrial operational environments, connecting sensors, actuators, controllers, and edge gateways to cloud analytics and control systems in order to enable real-time operational visibility, process optimisation, predictive maintenance, and remote asset management. IIoT integrates historically isolated operational technology (OT) networks—such as SCADA systems and programmable logic controllers (PLCs)—with IT infrastructure, requiring careful management of the resulting cyber-physical attack surface. Key communication standards include OPC UA, MQTT, and AMQP."@en ;
    rdfs:subClassOf ngm:infra-network-and-comms ;
    skos:broader ngm:infra-network-and-comms ;
    vc:enables ngm:digital-twin,
        ngm:predictive-maintenance ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:cyber-physical-systems,
        ngm:industrial-automation ;
    vc:slug "industrial-io-t" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:edge-computing,
        ngm:sensor .

ngm:iso-ts-15066 a owl:Class ;
    rdfs:label "ISO TS 15066"@en ;
    rdfs:comment "ISO/TS 15066:2016 is an ISO Technical Specification that supplements ISO 10218-1 and ISO 10218-2 by providing detailed guidance and biomechanical data for the safety of collaborative robot applications in which industrial robots and human workers share a common workspace without a physical separating guard. It defines four collaboration modes — safety-rated monitored stop, hand guiding, speed and separation monitoring, and power and force limiting — along with body-part-specific pain thresholds that govern permissible contact forces and pressures. The specification is a foundational reference for cobot risk assessment and CE marking under the EU Machinery Directive."@en ;
    rdfs:subClassOf ngm:robo-safety-and-standards,
        ngm:robot-standard ;
    skos:broader ngm:robo-safety-and-standards ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:iso-10218,
        ngm:robot-safety ;
    vc:slug "iso-ts-15066" ;
    vc:sourceDomain "robotics" ;
    vc:standardizedBy ngm:collaborative-robot ;
    vc:supports ngm:force-control,
        ngm:human-robot-interaction .

