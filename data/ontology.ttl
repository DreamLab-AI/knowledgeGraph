    vc:slug "nist-ai-rmf" ;
    vc:sourceDomain "governance" ;
    vc:standardizedBy ngm:standards-organization ;
    vc:supports ngm:ai-safety,
        ngm:fairness,
        ngm:reliability,
        ngm:transparency .

ngm:oauth-2-0 a owl:Class ;
    rdfs:label "OAuth 2.0"@en ;
    rdfs:comment "OAuth 2.0 is an open authorisation framework (RFC 6749) that allows resource owners to grant third-party clients scoped, time-limited access to their resources hosted on a resource server, without sharing credentials. The framework defines four grant types—authorisation code, implicit (deprecated), resource owner password credentials, and client credentials—each suited to different client trust levels and deployment contexts. OAuth 2.0 is the foundation on which OpenID Connect (OIDC) builds to add federated identity and authentication capabilities."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:authentication ],
        ngm:infra-security-and-identity ;
    skos:broader ngm:infra-security-and-identity ;
    vc:enables ngm:identity-federation,
        ngm:single-sign-on ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:identity-and-access-management,
        ngm:zero-trust-architecture ;
    vc:requires ngm:authentication ;
    vc:slug "oauth-2-0" ;
    vc:sourceDomain "infrastructure" .

ngm:obstacle-avoidance a owl:Class ;
    rdfs:label "Obstacle Avoidance"@en ;
    rdfs:comment "The capability of a mobile robot or autonomous system to detect and avoid collisions with obstacles in its environment in real-time using sensors and reactive control strategies. It enables safe navigation without requiring complete prior knowledge of the environment."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:proximity-sensor ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:real-time-processing ],
        ngm:reactive-control,
        ngm:robo-navigation-and-planning ;
    skos:broader ngm:robo-navigation-and-planning ;
    vc:enables ngm:collision-free-motion,
        ngm:safe-navigation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires ngm:proximity-sensor,
        ngm:real-time-processing ;
    vc:slug "obstacle-avoidance" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:camera,
        ngm:lidar,
        ngm:radar,
        ngm:ultrasonic-sensor .

ngm:operating-system a owl:Class ;
    rdfs:label "Operating System"@en ;
    rdfs:comment "An Operating System (OS) is the foundational software layer that manages hardware resources — CPU scheduling, memory allocation, file systems, device drivers, and process isolation — and provides a stable interface for application software. In spatial computing and XR contexts, OS-level capabilities such as real-time scheduling, GPU access, and sensor integration are critical; specialised spatial OSes must coordinate head-tracking, display refresh, and input fusion at sub-millisecond latencies."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:resource-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:virtual-machine ],
        ngm:infra-computing-and-cloud ;
    skos:broader ngm:infra-computing-and-cloud ;
    vc:enables ngm:edge-computing,
        ngm:embedded-systems ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:resource-management,
        ngm:virtual-machine ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:relatedTo ngm:hardware ;
    vc:slug "operating-system" ;
    vc:sourceDomain "infrastructure" .

ngm:pid-control a owl:Class ;
    rdfs:label "PID Control"@en ;
    rdfs:comment "PID (Proportional–Integral–Derivative) control is a classical closed-loop feedback algorithm that continuously computes a corrective control output by summing three terms derived from the error signal: the proportional term which scales the current error, the integral term which accumulates past error to eliminate steady-state offset, and the derivative term which anticipates future error trends by reacting to the rate of change. Due to its simplicity, interpretability, and tuning maturity, PID remains the most widely deployed controller in industrial automation and robotics for joint position and velocity regulation, motor speed control, and thermal management. Modern variants include anti-windup mechanisms, filtered derivative terms, and gain-scheduling to handle nonlinear plant dynamics."@en ;
    rdfs:subClassOf ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:contrastsWith ngm:impedance-control ;
    vc:enables ngm:force-control,
        ngm:robot-control ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:slug "pid-control" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:actuator,
        ngm:sensor .

ngm:policy-engine a owl:Class ;
    rdfs:label "Policy Engine"@en ;
    rdfs:comment "A Policy Engine is an automated software component that evaluates, enforces, and logs governance, access-control, and behavioural rules within a metaverse or spatial computing system. It interprets declarative policy specifications (e.g., XACML, OPA Rego, or bespoke ontology-derived rules) and applies them at runtime to user actions, asset transactions, and inter-platform communications, enabling consistent compliance across distributed, multi-stakeholder virtual environments."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:technical-standards ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:authentication ],
        ngm:metaverse-governance-and-safeguarding,
        ngm:sc-governance-and-safety ;
    skos:broader ngm:sc-governance-and-safety ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:implements ngm:access-control,
        ngm:policy-enforcement ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:authentication,
        ngm:technical-standards ;
    vc:slug "policy-engine" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:compliance-framework,
        ngm:metaverse-governance-and-safeguarding .

ngm:predictive-maintenance a owl:Class ;
    rdfs:label "Predictive Maintenance"@en ;
    rdfs:comment "Predictive Maintenance (PdM) is a condition-based maintenance strategy that uses continuous or periodic monitoring of physical asset health signals—vibration, temperature, acoustic emission, current draw, oil particle count, ultrasound, and corrosion metrics—combined with machine learning inf..."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:time-series-analysis ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:training-data ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:anomaly-detection ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-pipeline ],
