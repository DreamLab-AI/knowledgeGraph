            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:storage-infrastructure ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:digital-asset-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:search-interface ],
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:bridgesTo ngm:digital-asset-management ;
    vc:enables ngm:content-discovery,
        ngm:cultural-heritage-preservation,
        ngm:long-term-archival,
        ngm:public-access ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:access-control,
        ngm:content-repository,
        ngm:search-interface,
        ngm:versioning-system ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:authentication-service,
        ngm:digital-asset-management,
        ngm:metadata-standards,
        ngm:preservation-policy,
        ngm:storage-infrastructure ;
    vc:slug "digital-curation-platform" ;
    vc:sourceDomain "spatial-computing" .

ngm:digital-gold a owl:Class ;
    rdfs:label "Digital Gold"@en ;
    rdfs:comment "Digital Gold is a conceptual and investment category that characterises a cryptocurrency—most commonly Bitcoin—as a bearer instrument that performs the monetary functions traditionally attributed to gold: a scarce, durable, fungible, portable, and divisible store of value that preserves purchasing power across time and political regimes without dependence on any issuing authority. The analogy rests on Bitcoin's algorithmically enforced supply cap of 21 million coins, its proof-of-work scarcity mechanism, and its censorship resistance, which proponents argue replicate or improve upon gold's monetary properties in a digital-native form. The digital gold thesis underpins institutional Bitcoin investment strategies and shapes regulatory and macroeconomic discourse about the role of cryptographic assets in global monetary systems."@en ;
    rdfs:subClassOf ngm:cryptocurrency ;
    vc:contrastsWith ngm:central-bank-digital-currency,
        ngm:digital-currency ;
    vc:enables ngm:bitcoin-proof-of-work-protocol-etf ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:bitcoin-proof-of-work-protocol-as-money,
        ngm:bitcoin-proof-of-work-protocol-standard,
        ngm:monetary-policy,
        ngm:sound-money ;
    vc:slug "digital-gold" ;
    vc:sourceDomain "blockchain" .

ngm:digital-modeling a owl:Class ;
    rdfs:label "Digital Modeling"@en ;
    rdfs:comment "Digital Modelling is the process of creating mathematical or geometric representations of physical objects, environments, or systems in a computer, encompassing polygonal mesh construction, NURBS surfaces, procedural generation, and scan-based reconstruction. Digital models serve as the foundation for real-time rendering, simulation, digital twin creation, and asset delivery in spatial computing platforms."@en ;
    rdfs:subClassOf ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:bridgesTo ngm:computer-vision ;
    vc:enables ngm:digital-twin,
        ngm:rendering-engine ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:relatedTo ngm:procedural-content-generation ;
    vc:slug "digital-modeling" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:photogrammetry,
        ngm:point-cloud .

ngm:digital-money a owl:Class ;
    rdfs:label "Digital Money"@en ;
    rdfs:comment "Any form of monetary value existing purely in electronic format, encompassing e-money, central bank digital currencies, cryptocurrencies, and stablecoins, that can be stored, transferred, and transacted electronically across payment networks, metaverse economies, and blockchain systems."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:digital-wallet ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:payment-network ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:security-infrastructure ],
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:bridgesTo ngm:financial-instruments ;
    vc:enables ngm:instant-settlement,
        ngm:programmable-money ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires ngm:digital-wallet,
        ngm:payment-network,
        ngm:security-infrastructure ;
    vc:slug "digital-money" ;
    vc:sourceDomain "spatial-computing" .

ngm:digital-property-rights a owl:Class ;
    rdfs:label "Digital Property Rights"@en ;
    rdfs:comment "Digital Property Rights are the legally and technically enforceable claims governing ownership, transfer, and use of digital assets and virtual content. They encompass intellectual property protections, on-chain ownership assertions via non-fungible tokens, licensing frameworks, and governance rules that determine who can access, modify, or commercialise digital objects within virtual and mixed-reality environments."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:blockchain ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:digital-governance ],
        ngm:sc-governance-and-safety ;
    skos:broader ngm:sc-governance-and-safety ;
    vc:enables ngm:digital-asset-management,
        ngm:digital-ownership ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:regulatory-compliance ;
    vc:requires ngm:blockchain,
        ngm:digital-governance ;
    vc:slug "digital-property-rights" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:nft,
        ngm:smart-contract .

ngm:digital-public-goods a skos:Concept ;
    rdfs:label "Digital Public Goods"@en .

ngm:digital-securities a skos:Concept ;
    rdfs:label "Digital Securities"@en .

ngm:digital-security a owl:Class ;
    rdfs:label "Digital Security"@en ;
    rdfs:comment "Digital Security encompasses the technical controls, protocols, and governance frameworks protecting digital systems, data, and identities from unauthorised access, tampering, and exploitation. It integrates cryptographic mechanisms, access management policies, threat detection, and incident response to ensure confidentiality, integrity, and availability of digital assets and infrastructure across networked environments."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cybersecurity ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptographic-security ],
        ngm:sc-governance-and-safety ;
    skos:broader ngm:sc-governance-and-safety ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:ai-security ;
    vc:requires ngm:cryptographic-security,
        ngm:cybersecurity ;
    vc:slug "digital-security" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:data-security,
        ngm:digital-identity ;
    vc:uses ngm:post-quantum-cryptography,
        ngm:zero-trust-architecture .

ngm:digital-twin-collaboration a owl:Class ;
    rdfs:label "Digital Twin Collaboration"@en ;
    rdfs:comment "\"The use of shared virtual replicas of physical assets, processes, or environments as collaborative workspaces where geographically distributed teams simultaneously inspect, analyse, simulate, and modify digital representations synchronised with real-world counterparts through sensor data streams..."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cloud-computing ],
        ngm:dc-telepresence,
        ngm:telecollaboration ;
    skos:broader ngm:dc-telepresence ;
    vc:enables ngm:collaborative-systems-modality-simulation ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires ngm:cloud-computing ;
    vc:slug "digital-twin-collaboration" ;
    vc:sourceDomain "distributed-collaboration" .

ngm:digital-twin-generation a owl:Class ;
    rdfs:label "Digital Twin Generation"@en ;
    rdfs:comment "The automated or semi-automated process of creating digital twin models using AI, machine learning, and advanced 3D capture technologies, enabling rapid production of virtual replicas with reduced manual effort and accelerated deployment timelines for industrial and enterprise applications."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:machine-learning-discipline ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:generative-ai ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:3-d-reconstruction ],
        ngm:automated-modeling,
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:enables ngm:asset-digitization,
        ngm:rapid-prototyping,
        ngm:training ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:3-d-reconstruction,
        ngm:generative-ai,
        ngm:machine-learning-discipline ;
    vc:slug "digital-twin-generation" ;
    vc:sourceDomain "spatial-computing" .

ngm:digital-well-being-index a owl:Class ;
    rdfs:label "Digital Well-Being Index"@en ;
    rdfs:comment "Composite indicator assessing psychological, social, physical, and temporal impacts of extended virtual engagement, providing quantitative measures of healthy metaverse usage patterns."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-integration ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:cognitive-load-metric ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:behavioral-analytics ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:usage-analytics ],
        ngm:metaverse-governance-and-safeguarding,
        ngm:sc-governance-and-safety ;
    skos:broader ngm:sc-governance-and-safety ;
    vc:enables ngm:parental-controls,
        ngm:regulatory-compliance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:cognitive-load-metric ;
    vc:isPartOf ngm:monitoring-system,
        ngm:platform-governance ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:behavioral-analytics,
        ngm:data-integration,
        ngm:usage-analytics ;
    vc:slug "digital-well-being-index" ;
    vc:sourceDomain "spatial-computing" .

ngm:direct-air-capture a owl:Class ;
    rdfs:label "Direct Air Capture"@en ;
    rdfs:comment "Direct Air Capture (DAC) is a class of carbon-dioxide-removal technologies that chemically extract CO2 directly from ambient air, rather than from a concentrated flue-gas stream. Captured CO2 is then either permanently stored underground or used as a feedstock, producing measurable negative emissions. DAC is energy-intensive because atmospheric CO2 is highly dilute, so its viability depends on low-carbon energy and durable storage or carbon-market incentives."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:renewable-energy ],
        ngm:climate-policy ;
    vc:bridgesTo ngm:carbon-pricing ;
    vc:contrastsWith ngm:carbon-offsetting,
        ngm:emissions-trading-scheme ;
    vc:dependsOn ngm:carbon-pricing,
        ngm:renewable-energy ;
    vc:enables ngm:carbon-offsetting ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:net-zero ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:emissions-trading-scheme,
        ngm:esg,
        ngm:sustainability ;
    vc:requires ngm:renewable-energy ;
    vc:slug "direct-air-capture" ;
    vc:sourceDomain "governance" ;
    vc:standardizedBy ngm:esg ;
    vc:supports ngm:climate-policy,
        ngm:net-zero ;
    vc:uses ngm:carbon-sequestration .

ngm:directed-acyclic-graph-execution a owl:Class ;
    rdfs:label "Directed Acyclic Graph Execution"@en ;
    rdfs:comment "Directed acyclic graph (DAG) execution is a computation model in which tasks are nodes connected by directed dependency edges that contain no cycles, so the graph defines a partial order of operations. An execution engine performs a topological sort and runs nodes as soon as their inputs are ready, enabling parallelism, caching of unchanged subgraphs, and deterministic recomputation. It is the scheduling backbone of workflow engines and node-based authoring tools."@en ;
    rdfs:subClassOf ngm:software-architecture ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:node-based-diffusion-pipeline-interface-client,
        ngm:node-based-diffusion-pipeline-interface-workflows ;
    vc:slug "directed-acyclic-graph-execution" ;
    vc:sourceDomain "infrastructure" .

ngm:discovery-layer a owl:Class ;
    rdfs:label "Discovery Layer"@en ;
    rdfs:comment "Functional layer responsible for search, navigation, and exposure of metaverse experiences and assets through indexing, search engines, and recommendation systems."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-storage ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:metadata-registry ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:metadata-schema ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:recommendation-system ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:search-engine ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:query-interface ],
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:enables ngm:content-discovery,
        ngm:navigation,
        ngm:personalized-recommendations ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:metadata-registry,
        ngm:recommendation-system,
        ngm:search-engine ;
    vc:isPartOf ngm:data-layer ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:data-storage,
        ngm:metadata-schema,
        ngm:query-interface ;
    vc:slug "discovery-layer" ;
    vc:sourceDomain "spatial-computing" .

ngm:discreet-log-contracts a owl:Class ;
    rdfs:label "Discreet Log Contracts"@en ;
    rdfs:comment "A scheme for executing conditional Bitcoin payments based on signed outcomes from external oracles, where the contract logic stays off-chain and only the settled transaction is broadcast."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptographic-proof ],
