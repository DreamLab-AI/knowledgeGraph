    vc:sourceDomain "spatial-computing" .

ngm:double-spending a owl:Class ;
    rdfs:label "Double Spending"@en ;
    rdfs:comment "Double spending is the fraudulent attempt to spend the same digital asset more than once by broadcasting conflicting transactions to different parts of a blockchain network before they are confirmed. It represents the fundamental security problem that consensus mechanisms are designed to prevent in distributed ledger systems."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:transaction-finality ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:consensus-mechanism ],
        ngm:bc-protocol-and-consensus,
        ngm:blockchain-entity,
        ngm:network-component ;
    skos:broader ngm:bc-protocol-and-consensus ;
    vc:contrastsWith ngm:finality,
        ngm:transaction-confirmation ;
    vc:enables ngm:attack-vector ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:cybersecurity ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:blockchain-transaction,
        ngm:cryptographic-signature,
        ngm:eclipse-attack,
        ngm:selfish-mining,
        ngm:sybil-attack ;
    vc:requires ngm:consensus-mechanism,
        ngm:transaction-finality ;
    vc:slug "double-spending" ;
    vc:sourceDomain "blockchain" .

ngm:drug-discovery a owl:Class ;
    rdfs:label "Drug Discovery"@en ;
    rdfs:comment "AI-assisted drug discovery is the application of machine learning, deep learning, and generative modelling to accelerate and improve the identification, screening, and optimisation of candidate therapeutic compounds. Machine learning models predict molecular properties such as binding affinity, ADMET profiles (absorption, distribution, metabolism, excretion, toxicity), and off-target interactions from molecular structure representations. Generative models and graph neural networks are used to propose novel molecular scaffolds with desired properties. The field intersects cheminformatics, structural biology, and clinical informatics, and has seen significant acceleration from protein structure prediction tools such as AlphaFold."@en ;
    rdfs:subClassOf ngm:ai-application ;
    skos:broader ngm:ai-application ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:active-learning,
        ngm:clinical-trials,
        ngm:simulation ;
    vc:slug "drug-discovery" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:generative-model,
        ngm:graph-neural-network .

ngm:ecdsa a owl:Class ;
    rdfs:label "ECDSA"@en ;
    rdfs:comment "Elliptic Curve Digital Signature Algorithm (ECDSA) is a cryptographic primitive that uses elliptic curve mathematics to generate and verify digital signatures, underpinning transaction authentication in Bitcoin, Ethereum, and most public blockchain networks. ECDSA provides non-repudiation, integrity verification, and ownership proof with compact key sizes relative to RSA equivalents."@en ;
    rdfs:subClassOf ngm:bc-cryptographic-primitive,
        ngm:cryptographic-primitive ;
    skos:broader ngm:bc-cryptographic-primitive ;
    vc:enables ngm:authentication,
        ngm:cryptographic-verification,
        ngm:digital-signature ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:cryptographic-key-management,
        ngm:cryptographic-protocol,
        ngm:public-key-cryptography ;
    vc:slug "ecdsa" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:cryptographic-hash-function,
        ngm:elliptic-curve-cryptography,
        ngm:private-key,
        ngm:public-key .

ngm:encoder-decoder-architecture a owl:Class ;
    rdfs:label "Encoder Decoder Architecture"@en ;
    rdfs:comment "A neural network design pattern comprising an encoder that compresses an input sequence into a latent representation and a decoder that generates an output sequence from that representation, enabling sequence-to-sequence mappings for tasks such as machine translation, summarisation, and image captioning. The architecture underpins the original Transformer (Vaswani et al., 2017) and models such as T5 and BART."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:token-embedding ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:cross-attention ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:self-attention ],
        ngm:ai-model-architecture ;
    skos:broader ngm:ai-model-architecture ;
    vc:contrastsWith ngm:model-architecture ;
    vc:enables ngm:natural-language-processing ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:cross-attention,
        ngm:self-attention,
        ngm:token-embedding ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:slug "encoder-decoder-architecture" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:transformer .

ngm:esg-investing a owl:Class ;
    rdfs:label "ESG Investing"@en ;
    rdfs:comment "ESG Investing is an investment methodology that systematically integrates Environmental, Social, and Governance criteria into the analysis, selection, and management of investment portfolios, with the aim of assessing sustainability risks and ethical impact alongside conventional financial returns. Environmental factors include carbon emissions, resource usage, and climate exposure; social factors cover labour practices, supply-chain conditions, and community impact; governance factors assess board composition, executive remuneration, and shareholder rights. Blockchain-based tokenisation is increasingly used to provide transparent, immutable ESG data trails and enable fractional ownership of impact-linked assets."@en ;
    rdfs:subClassOf ngm:bc-governance-and-regulation ;
    skos:broader ngm:bc-governance-and-regulation ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:green-finance,
        ngm:sustainability,
        ngm:tokenization ;
    vc:slug "esg-investing" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:governance ;
    vc:uses ngm:token .

ngm:fork-choice-rule a owl:Class ;
    rdfs:label "Fork Choice Rule"@en ;
    rdfs:comment "Algorithm by which blockchain nodes select the canonical chain head when multiple competing branches exist, resolving temporary forks deterministically. Bitcoin uses longest-chain (most cumulative proof-of-work) while Ethereum post-Merge uses the LMD-GHOST fork-choice weighted by validator attestation stake, determining network-wide finality."@en ;
    rdfs:subClassOf ngm:bc-protocol-and-consensus,
        ngm:blockchain-entity,
        ngm:consensus-protocol ;
    skos:broader ngm:bc-protocol-and-consensus ;
    vc:dependsOn ngm:peer-discovery ;
    vc:enables ngm:blockchain-scalability,
        ngm:immutability ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:blockchain-protocol,
        ngm:byzantine-fault-tolerance,
        ngm:censorship-resistance,
        ngm:consensus-rule,
        ngm:proof-of-work ;
    vc:slug "fork-choice-rule" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:consensus-algorithm,
        ngm:consensus-mechanism .

ngm:forward-kinematics a owl:Class ;
    rdfs:label "Forward Kinematics"@en ;
    rdfs:comment "The process of determining the position and orientation of a robot's end-effector in Cartesian space given the joint parameters (angles or displacements). It maps from joint space to task space using geometric and trigonometric relationships."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:kinematic-model ],
        ngm:kinematics,
        ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:enables ngm:motion-visualization,
        ngm:robot-simulation ;
    vc:hasMaturity ngmi:maturity-established ;
