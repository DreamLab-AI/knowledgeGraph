    vc:uses ngm:computer-vision,
        ngm:deep-learning,
        ngm:imitation-learning,
        ngm:kinematics,
        ngm:pid-controller,
        ngm:reinforcement-learning .

ngm:scientific-method a owl:Class ;
    rdfs:label "Scientific Method"@en ;
    rdfs:comment "The scientific method is a systematic process for acquiring knowledge through observation, formulation of testable hypotheses, controlled experimentation, and analysis of results, with conclusions subject to revision in light of new evidence. It emphasises empirical testing, reproducibility, and peer scrutiny to distinguish well-supported claims from conjecture. In artificial intelligence it underpins rigorous experimentation, benchmarking, and the validation of models and theories."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-collection ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:statistical-testing ],
        ngm:artificial-intelligence ;
    skos:broader ngm:artificial-intelligence ;
    vc:enables ngm:open-science,
        ngm:peer-review,
        ngm:reproducibility ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:implements ngm:inference,
        ngm:logic ;
    vc:isPartOf ngm:knowledge-discovery ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:knowledge-discovery,
        ngm:peer-review,
        ngm:reproducibility ;
    vc:requires ngm:data-collection,
        ngm:statistical-testing ;
    vc:slug "scientific-method" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:model ;
    vc:uses ngm:data-analysis,
        ngm:statistical-analysis .

ngm:scope-1-emissions a owl:Class ;
    rdfs:label "Scope 1 Emissions"@en ;
    rdfs:comment "Scope 1 emissions are direct greenhouse gas (GHG) emissions from sources that are owned or controlled by a reporting organisation, as defined by the GHG Protocol Corporate Standard. They include combustion of fuels in owned vehicles, boilers, and furnaces; process emissions from chemical or physical reactions in production; and fugitive emissions from refrigerant leaks, methane from waste operations, and similar inadvertent releases. Scope 1 emissions are denominated in CO2-equivalent (CO2e) tonnes and represent the most controllable category of an organisation's carbon footprint."@en ;
    rdfs:subClassOf ngm:carbon-accounting ;
    vc:bridgesTo ngm:supply-chain-decarbonisation ;
    vc:contrastsWith ngm:scope-2-emissions,
        ngm:scope-3-emissions ;
    vc:enables ngm:carbon-neutrality-planning,
        ngm:carbon-offset-trading,
        ngm:esg-reporting,
        ngm:net-zero-target-setting,
        ngm:sustainability-reporting ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:carbon-footprint,
        ngm:ghg-inventory ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:carbon-border-adjustment-mechanism,
        ngm:emission-factors,
        ngm:ghg-protocol,
        ngm:kyoto-protocol,
        ngm:scope-2-emissions,
        ngm:scope-3-emissions ;
    vc:requires ngm:third-party-assurance ;
    vc:slug "scope-1-emissions" ;
    vc:sourceDomain "governance" ;
    vc:standardizedBy ngm:corporate-sustainability-reporting-directive,
        ngm:ifrs-s2,
        ngm:iso-14064 ;
    vc:uses ngm:activity-data,
        ngm:carbon-footprint-measurement,
        ngm:environmental-accounting .

ngm:script a owl:Class ;
    rdfs:label "Script"@en ;
    rdfs:comment "Bitcoin's stack-based, non-Turing-complete scripting language used to encode spending conditions on transaction outputs and to provide the corresponding unlocking data in transaction inputs. Script programs define locking and unlocking conditions—such as pay-to-public-key-hash—that a validator executes to authorise fund transfer, making transaction validation a programmable process without full smart-contract complexity."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:digital-signature ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:public-key-cryptography ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:locking-script ],
        ngm:bc-protocol-and-consensus,
        ngm:blockchain-entity ;
    skos:broader ngm:bc-protocol-and-consensus ;
    vc:bridgesTo ngm:distributed-systems,
        ngm:security ;
    vc:contrastsWith ngm:ethereum-smart-contract-platform-virtual-machine,
        ngm:turing-complete-language ;
    vc:enables ngm:multisignature,
        ngm:payment-channel,
        ngm:smart-contract,
        ngm:time-locked-transaction,
        ngm:transaction-processing ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:locking-script,
        ngm:unlocking-script ;
    vc:implements ngm:pay-to-public-key-hash ;
    vc:isPartOf ngm:bitcoin-protocol,
        ngm:blockchain ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:blockchain-transaction,
        ngm:consensus-mechanism,
        ngm:transaction-fee,
        ngm:transaction-pool ;
    vc:requires ngm:digital-signature,
        ngm:public-key-cryptography ;
    vc:slug "script" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:cryptographic-hash,
        ngm:opcodes,
        ngm:stack-machine,
        ngm:transaction,
        ngm:utxo-model .

ngm:security-token-offering a owl:Class ;
    rdfs:label "Security Token Offering"@en ;
    rdfs:comment "A Security Token Offering (STO) is a regulated capital-raising mechanism in which blockchain-based digital tokens representing ownership rights, equity interests, debt obligations, revenue participation, or other financial entitlements are issued and sold to investors in compliance with applicable securities law. STOs require issuers to satisfy jurisdictional regulatory frameworks — such as the SEC's Regulation D or Regulation S exemptions in the United States, or MiFID II and EU prospectus rules in Europe — including investor accreditation verification, Know Your Customer and Anti-Money Laundering checks, and mandatory disclosure obligations. Unlike Initial Coin Offerings, which frequently issued utility tokens, STOs embed compliance logic directly into programmable smart contracts on distributed ledger platforms, automating transfer restrictions, cap-table management, and dividend or interest distributions. The STO model bridges traditional capital markets infrastructure with blockchain-based asset tokenisation, enabling fractional ownership of previously illiquid assets such as real estate, private equity, and infrastructure funds."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:know-your-customer ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:regulatory-compliance ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:financial-regulation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:identity-verification ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:anti-money-laundering ],
        ngm:bc-token-and-asset ;
    skos:broader ngm:bc-token-and-asset ;
    vc:bridgesTo ngm:blockchain,
        ngm:decentralized-autonomous-organization ;
    vc:contrastsWith ngm:initial-coin-offering,
        ngm:initial-dex-offering,
        ngm:initial-public-offering ;
    vc:enables ngm:asset-tokenization,
        ngm:fractional-ownership,
        ngm:programmable-compliance,
        ngm:secondary-market-integration ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:capital-markets,
        ngm:decentralized-finance,
        ngm:digital-asset,
        ngm:tokenomics ;
    vc:requires ngm:anti-money-laundering,
        ngm:financial-regulation,
        ngm:identity-verification,
        ngm:investor-accreditation,
        ngm:know-your-customer,
        ngm:regulatory-compliance ;
    vc:slug "security-token-offering" ;
    vc:sourceDomain "finance" ;
    vc:standardizedBy ngm:erc-1400,
        ngm:erc-3643 ;
    vc:uses ngm:digital-wallet,
        ngm:distributed-ledger-technology,
        ngm:security-token,
        ngm:smart-contract .

ngm:sensors a owl:Class ;
    rdfs:label "Sensors"@en ;
    rdfs:comment "Sensors are devices that transduce physical quantities—distance, force, temperature, orientation, light, electromagnetic fields—into electrical or digital signals that a robot or computational system can process, providing the perceptual input for state estimation, control, and decision making."@en ;
