ngm:ai-model-development a owl:Class ;
    rdfs:label "AI Model Development"@en ;
    rdfs:comment "The end-to-end engineering discipline of designing, training, evaluating, and deploying machine learning models, encompassing dataset curation, architecture selection, optimisation, and lifecycle management. It integrates software engineering, statistical modelling, and domain expertise to produce AI systems capable of performing specified tasks at scale. The discipline spans research prototyping through production deployment and ongoing maintenance."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-pipeline ],
        [ a owl:Restriction ;
