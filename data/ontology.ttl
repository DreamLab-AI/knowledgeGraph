        ngm:open-weight-model,
        ngm:zero-shot-learning ;
    vc:requires ngm:distributed-training,
        ngm:gpu-cluster ;
    vc:slug "meta-ai" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:computer-vision,
        ngm:natural-language-processing,
