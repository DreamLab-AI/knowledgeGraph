    vc:enables ngm:gaming,
        ngm:therapeutic-vr ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires ngm:machine-learning-discipline,
        ngm:real-time-analytics ;
    vc:slug "adaptive-virtual-experience" ;
    vc:sourceDomain "spatial-computing" .

ngm:adas a owl:Class ;
    rdfs:label "ADAS"@en ;
    rdfs:comment "Advanced Driver Assistance Systems (ADAS) are electronic systems that assist vehicle operators with driving and parking functions through automated technologies including adaptive cruise control, lane keeping assist, automatic emergency braking, blind spot detection, and parking assistance. ADAS operates at SAE Level 1–2 automation, augmenting rather than replacing the driver, and relies on sensor fusion across cameras, radar, and ultrasonic systems to perceive the vehicle's environment."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:sensor-fusion ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:perception-system ],
        ngm:autonomous-vehicle,
        ngm:robo-robot-type ;
    skos:broader ngm:robo-robot-type ;
    vc:contrastsWith ngm:autonomous-vehicle ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:risk ;
    vc:requires ngm:perception-system,
        ngm:sensor-fusion ;
    vc:slug "adas" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:camera,
        ngm:computer-vision,
        ngm:lidar .

ngm:adobe-creative-cloud a owl:Class ;
    rdfs:label "Adobe Creative Cloud"@en ;
    rdfs:comment "Adobe Creative Cloud is a subscription-based software platform operated by Adobe Inc. that delivers a suite of professional creative applications—including Photoshop, Illustrator, Premiere Pro, After Effects, and InDesign—alongside cloud storage, collaboration services, and asset management infrastructure. Launched in 2013 as the successor to Adobe Creative Suite, it transitioned the industry from perpetual licence software to a continuous-update, cloud-connected model. The platform is the dominant industry standard for graphic design, photography, video production, motion graphics, and digital publishing workflows."@en ;
    rdfs:subClassOf ngm:creative-tools ;
    vc:enables ngm:content-creation,
