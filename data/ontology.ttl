    vc:slug "predictive-personalization" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:digital-marketing,
        ngm:e-commerce ;
    vc:uses ngm:behavioral-analytics,
        ngm:collaborative-systems-modality-filtering,
