    vc:enables ngm:metaverse-infrastructure ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:slug "distributed-system-architecture" ;
    vc:sourceDomain "spatial-computing" .

ngm:distributed-team-collaboration a owl:Class ;
    rdfs:label "Distributed Team Collaboration"@en ;
    rdfs:comment "Distributed team collaboration encompasses the practices, tools, and organisational patterns that enable geographically dispersed individuals working across multiple time zones to coordinate effectively on shared goals without co-location. It integrates asynchronous communication protocols, synchronous video conferencing, shared digital workspaces, version-controlled artefacts, and social norms around documentation and decision-making transparency to replicate — and often surpass — the coordination bandwidth of co-located teams. The discipline has grown from a niche practice of open-source communities and multinational corporations into a mainstream organisational capability following the global shift to remote work accelerated by the 2020 pandemic."@en ;
    rdfs:subClassOf ngm:distributed-collaboration ;
    skos:broader ngm:distributed-collaboration ;
    vc:enables ngm:synchronous-collaboration,
        ngm:telecollaboration ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:asynchronous-collaboration,
        ngm:remote-collaboration,
        ngm:remote-work ;
    vc:slug "distributed-team-collaboration" ;
    vc:sourceDomain "governance" ;
    vc:uses ngm:asynchronous-communication,
        ngm:collaboration-platform,
        ngm:realtime-communication .

ngm:distributed-work a owl:Class ;
    rdfs:label "Distributed Work"@en ;
    rdfs:comment "Organisational models, practices, and enabling technologies that allow geographically dispersed teams to collaborate effectively whilst maintaining productivity, cohesion, and wellbeing. Distributed work encompasses remote, hybrid, and globally distributed team configurations, supported by asynchronous communication norms, shared documentation practices, and virtual presence technologies ranging from video conferencing to XR meeting spaces."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:collaboration-platform ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:asynchronous-collaboration ],
        ngm:infra-software-engineering ;
    skos:broader ngm:infra-software-engineering ;
    vc:enables ngm:distributed-collaboration ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:blockchain,
        ngm:virtual-collaboration ;
    vc:requires ngm:asynchronous-collaboration,
        ngm:collaboration-platform ;
    vc:slug "distributed-work" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:digital-twin,
        ngm:xr-meeting-space .

ngm:domain-driven-design a skos:Concept ;
    rdfs:label "Domain Driven Design"@en .

ngm:domain-randomisation a skos:Concept ;
    rdfs:label "Domain Randomisation"@en .

ngm:early-stopping a owl:Class ;
    rdfs:label "Early Stopping"@en ;
    rdfs:comment "A regularisation technique that terminates model training when validation performance ceases to improve for a configurable number of epochs (the patience parameter), preventing overfitting by restoring the best checkpoint before performance degraded. Early stopping balances training progress against generalisation to unseen data and is most effective when combined with other regularisation techniques such as dropout and weight decay."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:regularisation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:epoch ],
        ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:contrastsWith ngm:overfitting ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:deep-learning ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:batch-size,
        ngm:hyperparameter ;
    vc:requires ngm:epoch,
        ngm:regularisation ;
    vc:slug "early-stopping" ;
    vc:sourceDomain "spatial-computing" .

ngm:embedded-system a skos:Concept ;
    rdfs:label "Embedded System"@en .

ngm:emergent-behaviour a skos:Concept ;
    rdfs:label "Emergent Behaviour"@en .

ngm:energy-consumption a owl:Class ;
    rdfs:label "Energy Consumption"@en ;
    rdfs:comment "Energy consumption is the total quantity of energy drawn by a system, process, or device over a defined time period, typically expressed in kilowatt-hours (kWh) or joules. In computing and digital infrastructure contexts it encompasses the electrical power used by processors, memory, networking equipment, and cooling systems. It is a foundational metric in evaluating the environmental footprint, operational cost, and sustainability compliance of data centres, blockchain networks, AI training pipelines, and distributed systems. Minimising energy consumption without sacrificing throughput or reliability is a core design constraint across hardware architecture, consensus mechanisms, and large-scale deployment."@en ;
    rdfs:subClassOf ngm:sustainability ;
    vc:bridgesTo ngm:ai-model-training,
        ngm:distributed-ledger-technology,
        ngm:edge-computing ;
    vc:contrastsWith ngm:energy-efficiency,
        ngm:proof-of-work ;
    vc:dependsOn ngm:hardware-architecture,
        ngm:workload-scheduling ;
    vc:enables ngm:carbon-accounting,
        ngm:green-computing ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:idle-power-consumption,
        ngm:power-usage-effectiveness,
        ngm:thermal-design-power ;
    vc:isPartOf ngm:carbon-footprint,
        ngm:operational-cost ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:computational-complexity,
        ngm:data-centre,
        ngm:proof-of-stake,
        ngm:renewable-energy ;
    vc:requires ngm:cooling-systems,
        ngm:power-infrastructure ;
    vc:slug "energy-consumption" ;
    vc:sourceDomain "infrastructure" .

ngm:erc-20-token a skos:Concept ;
    rdfs:label "ERC 20 Token"@en .

ngm:error-signal a owl:Class ;
    rdfs:label "Error Signal"@en ;
    rdfs:comment "An error signal is the quantity in a feedback control system representing the instantaneous difference between the reference setpoint and the actual measured output. It is the driving input to the controller, which acts to reduce it toward zero. The error signal's magnitude, rate of change, and accumulated value are processed by proportional, derivative, and integral control terms respectively."@en ;
    rdfs:subClassOf ngm:control-system ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:derivative-control,
        ngm:feedback-loop ;
    vc:slug "error-signal" ;
    vc:sourceDomain "robotics" .

ngm:ether-cat a owl:Class ;
    rdfs:label "EtherCAT"@en ;
    rdfs:comment "EtherCAT (Ethernet for Control Automation Technology) is an open, IEC 61158-standardised real-time Ethernet fieldbus protocol developed by Beckhoff Automation, enabling deterministic, high-bandwidth communication between industrial master controllers and distributed slave devices such as servo drives, I/O modules, and encoders. Its on-the-fly processing architecture allows each slave node to extract addressed data from and insert its response into a propagating Ethernet frame, achieving sub-microsecond synchronisation across large distributed networks. Governed by the EtherCAT Technology Group (ETG), the standard is widely deployed in industrial robotics, CNC machining, semiconductor manufacturing, and laboratory automation, with the Safety over EtherCAT (FSoE) extension providing IEC 61784-3-compliant functional safety over the same physical layer."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ethernet ],
        ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:bridgesTo ngm:industrial-internet-of-things,
        ngm:time-sensitive-networking ;
