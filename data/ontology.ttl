    vc:slug "transparency-obligation" ;
    vc:sourceDomain "metaverse" .

ngm:transparent-decision-making a owl:Class ;
    rdfs:label "Transparent Decision Making"@en ;
    rdfs:comment "Governance processes where decisions, their rationale, and the factors influencing outcomes are openly visible and accessible to stakeholders, often implemented through on-chain voting, public proposals, and documented deliberations in DAOs and digital platforms."@en ;
