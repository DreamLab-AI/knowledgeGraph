ngm:continuous-ai-strategy a owl:Class ;
    rdfs:comment "An iterative approach to AI planning where strategies and recommendations are dynamically updated in response to evolving capabilities and market conditions."@en ;
    rdfs:label "Continuous AI Strategy"@en ;
