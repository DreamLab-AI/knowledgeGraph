ngm:visual-odometry a owl:Class ;
    rdfs:label "Visual Odometry"@en ;
    rdfs:comment "Visual odometry (VO) is a technique for incrementally estimating the six-degree-of-freedom pose (position and orientation) of a camera-equipped agent by detecting and tracking salient features across consecutive image frames and computing the relative camera motion between them via geometric constraints such as the essential or fundamental matrix. It provides ego-motion estimation without relying on GPS, wheel encoders, or external beacons, making it applicable in GPS-denied environments such as indoor spaces, underground tunnels, and planetary surfaces. Scale ambiguity in monocular configurations is resolved by stereo baselines or depth cameras; drift is bounded by fusing inertial measurements (visual-inertial odometry) or by applying loop-closure detection within a full SLAM pipeline."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:image-processing ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:camera-calibration ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:epipolar-geometry ],
        ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:bridgesTo ngm:autonomous-vehicles,
        ngm:mixed-reality,
        ngm:spatial-computing ;
    vc:contrastsWith ngm:gps-localisation,
        ngm:lidar-odometry,
        ngm:wheel-odometry ;
    vc:dependsOn ngm:depth-sensing,
        ngm:inertial-measurement-unit ;
    vc:enables ngm:3d-reconstruction,
        ngm:augmented-reality,
        ngm:autonomous-navigation,
        ngm:pose-estimation,
        ngm:robot-localisation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:simultaneous-localisation-and-mapping,
        ngm:visual-slam ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:ego-motion-estimation,
        ngm:factor-graph-optimisation,
        ngm:loop-closure-detection,
        ngm:place-recognition,
        ngm:point-cloud-processing ;
    vc:requires ngm:camera-calibration,
        ngm:epipolar-geometry,
        ngm:image-processing ;
    vc:slug "visual-odometry" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:bundle-adjustment,
        ngm:computer-vision,
        ngm:feature-extraction,
        ngm:feature-matching,
        ngm:kalman-filter,
        ngm:ransac .

ngm:wallet a owl:Class ;
    rdfs:label "Wallet"@en ;
    rdfs:comment "A software or hardware interface that stores cryptographic private keys and enables users to manage cryptocurrency assets, sign transactions, and interact with blockchain networks securely. Wallets range from hot custodial services to air-gapped hardware devices, and manage key derivation, address generation, UTXO selection, and transaction broadcasting."@en ;
