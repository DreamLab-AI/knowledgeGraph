ngm:ai-video a owl:Class ;
    rdfs:label "AI Video"@en ;
    rdfs:comment "AI Video, alternatively termed generative video, neural video synthesis, text-to-video (T2V), and image-to-video (I2V), denotes the class of deep generative models and engineering systems that synthesise temporally-coherent moving imagery conditioned on natural-language prompts, reference images,..."@en ;
