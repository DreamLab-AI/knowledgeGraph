        ngm:multilingual-communication,
        ngm:real-time-interpretation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:attention-mechanism,
        ngm:beam-search,
        ngm:bpe-vocabulary,
        ngm:decoder,
