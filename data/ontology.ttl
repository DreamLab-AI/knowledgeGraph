    vc:uses ngm:diagrams-as-code,
        ngm:open-source-software .

ngm:exchange-custody a owl:Class ;
    rdfs:label "Exchange Custody"@en ;
    rdfs:comment "Exchange custody is the model in which a cryptocurrency exchange or platform holds and controls the private keys to users' digital assets on their behalf, rather than users self-custodying their own keys. The custodian operates wallets, manages security and reconciles internal ledgers crediting customers' balances. This arrangement simplifies user experience and trading but concentrates risk, since users rely on the exchange's solvency, controls and honesty rather than holding their keys directly."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:key-management ],
        ngm:institutional-custody ;
    vc:bridgesTo ngm:multi-signature-wallet ;
    vc:contrastsWith ngm:self-custody ;
    vc:dependsOn ngm:key-management ;
    vc:enables ngm:digital-asset ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:institutional-custody ;
    vc:isPartOf ngm:cryptocurrency-exchange ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:cryptocurrency-exchange,
        ngm:digital-asset,
        ngm:institutional-custody ;
    vc:requires ngm:key-management ;
    vc:slug "exchange-custody" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:cryptocurrency-exchange ;
    vc:uses ngm:cold-storage,
        ngm:hot-wallet,
        ngm:multi-signature-wallet .

ngm:exchange-rate a owl:Class ;
    rdfs:label "Exchange Rate"@en ;
    rdfs:comment "An exchange rate is the price of one currency expressed in terms of another, determining how much of one monetary unit is required to purchase a unit of the other. Exchange rates are set in foreign-exchange markets through supply and demand, influenced by interest rates, inflation, trade balances, and central-bank policy, and may float freely, be pegged, or be managed. In crypto and stablecoin contexts the same concept governs the peg between a token and a fiat reference. Exchange rates are fundamental to international trade, monetary policy transmission, and cross-border value transfer."@en ;
    rdfs:subClassOf ngm:finance ;
    vc:bridgesTo ngm:macroeconomics ;
    vc:contrastsWith ngm:peg-mechanism ;
    vc:dependsOn ngm:monetary-policy,
        ngm:supply-and-demand ;
    vc:enables ngm:international-trade ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:isPartOf ngm:finance ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:fiat-currency,
        ngm:foreign-exchange,
        ngm:forex ;
    vc:slug "exchange-rate" ;
    vc:sourceDomain "finance" ;
    vc:supports ngm:derivatives-trading,
        ngm:hedging ;
    vc:uses ngm:central-bank .

