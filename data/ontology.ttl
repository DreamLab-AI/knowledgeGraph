ngm:energy-attribute-certificates a owl:Class ;
    rdfs:label "Energy Attribute Certificates"@en ;
    rdfs:comment "Energy Attribute Certificates (EACs) are tradable instruments that each represent proof that one megawatt-hour of electricity was generated from a specific source, typically renewable. They decouple the environmental attributes of energy from the underlying physical electricity, allowing those attributes to be sold, retired, or tracked independently. In blockchain contexts they are increasingly tokenised to provide auditable, fraud-resistant accounting of clean-energy consumption and to offset network energy use."@en ;
    rdfs:subClassOf ngm:economic-mechanism ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:green-blockchain-initiatives,
        ngm:sustainability ;
    vc:slug "energy-attribute-certificates" ;
    vc:sourceDomain "blockchain" .

ngm:enterprise-ethereum-alliance a owl:Class ;
    rdfs:label "Enterprise Ethereum Alliance"@en ;
    rdfs:comment "The Enterprise Ethereum Alliance (EEA) is an industry consortium founded in February 2017 that develops open, blockchain-based specifications for enterprise deployments of Ethereum technology. It standardises the interfaces between private, consortium, and public Ethereum networks, enabling organisations to build interoperable enterprise applications that can bridge permissioned and permissionless environments. The EEA's Client Specification defines conformance requirements for enterprise Ethereum clients, covering private transaction management, permissioning, token standards, and off-chain compute. Membership spans over two hundred organisations including JP Morgan, Microsoft, Accenture, Intel, and ConsenSys, making it one of the largest blockchain standards bodies in the world."@en ;
    rdfs:subClassOf ngm:bc-governance-and-regulation ;
    skos:broader ngm:bc-governance-and-regulation ;
    vc:bridgesTo ngm:decentralized-finance,
        ngm:supply-chain-management ;
    vc:contrastsWith ngm:hyperledger-fabric,
        ngm:r3-corda ;
    vc:dependsOn ngm:ethereum,
        ngm:smart-contract ;
    vc:enables ngm:blockchain-interoperability,
        ngm:central-bank-digital-currency,
        ngm:enterprise-blockchain-architecture ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:enterprise-token-standards,
        ngm:interoperability-standard ;
    vc:isPartOf ngm:ethereum ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:enterprise-blockchain,
        ngm:hyperledger-besu ;
    vc:slug "enterprise-ethereum-alliance" ;
    vc:sourceDomain "blockchain" ;
    vc:standardizedBy ngm:api-standard ;
    vc:supports ngm:enterprise-smart-contracts,
        ngm:regulatory-compliance,
        ngm:smart-contract-platform ;
    vc:uses ngm:byzantine-fault-tolerance .

ngm:enterprise-service-bus a owl:Class ;
    rdfs:label "Enterprise Service Bus"@en ;
    rdfs:comment "An enterprise service bus is a middleware backbone that connects disparate applications by mediating, routing and transforming messages between them through a common integration layer. It centralises concerns such as protocol bridging, data transformation, message routing and orchestration so that services need not know about each other directly. The pattern is associated with service-oriented architecture and contrasts with lighter, decentralised integration styles."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:message-broker ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:data-transformation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:middleware ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:message-broker ],
        ngm:middleware ;
    vc:bridgesTo ngm:soap ;
    vc:contrastsWith ngm:api-gateway,
        ngm:microservices ;
    vc:enables ngm:enterprise-integration,
        ngm:service-oriented-architecture ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:data-transformation,
        ngm:message-broker ;
    vc:isPartOf ngm:enterprise-integration,
        ngm:service-oriented-architecture ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:event-driven-architecture,
        ngm:message-broker ;
    vc:requires ngm:message-broker,
        ngm:middleware ;
    vc:slug "enterprise-service-bus" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:api-management,
        ngm:event-driven-architecture ;
    vc:uses ngm:data-transformation,
        ngm:message-queue .

ngm:enterprise-software-platform a owl:Class ;
    rdfs:label "Enterprise Software Platform"@en ;
    rdfs:comment "An enterprise software platform is an integrated software environment that provides shared services, data, and tooling on which an organisation's business applications are built and run. Examples include ERP, CRM, and blockchain-as-a-service platforms that offer multi-tenant infrastructure, security, integration, and extensibility. The platform model lets enterprises consolidate capabilities and accelerate delivery of line-of-business applications."@en ;
    rdfs:subClassOf ngm:infra-software-engineering ;
    skos:broader ngm:infra-software-engineering ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:blockchain-as-a-service,
        ngm:crm ;
    vc:slug "enterprise-software-platform" ;
    vc:sourceDomain "infrastructure" .

ngm:environmental-sensor a owl:Class ;
    rdfs:label "Environmental Sensor"@en ;
    rdfs:comment "An environmental sensor is a device that measures ambient physical conditions of its surroundings, such as temperature, humidity, pressure, light level, air quality, or sound. As an exteroceptive sensor it perceives the external world rather than a system's internal state. These sensors supply the contextual data used by robots, augmented-reality systems, and smart-environment applications to adapt their behaviour."@en ;
    rdfs:subClassOf ngm:sensor ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:augmented-reality-ar,
        ngm:exteroceptive-sensor ;
    vc:slug "environmental-sensor" ;
    vc:sourceDomain "robotics" .

ngm:environmental-standards a owl:Class ;
    rdfs:label "Environmental Standards"@en ;
    rdfs:comment "Regulatory frameworks and technical specifications governing the environmental sustainability of metaverse infrastructure, including energy efficiency requirements for data centres, carbon footprint disclosure mandates, and e-waste management guidelines for XR hardware."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
