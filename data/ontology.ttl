            owl:someValuesFrom ngm:knowledge-graph ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:ontology ],
        ngm:infra-data-management ;
    skos:broader ngm:infra-data-management ;
    vc:bridgesTo ngm:record-keeping-system ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:knowledge-graph,
        ngm:ontology ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:data-management,
        ngm:knowledge-management ;
    vc:slug "ontology-technical-details" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:data-structure,
        ngm:distributed-ledger .

ngm:open-graph-link-preview-protocol a owl:Class ;
    rdfs:label "Open Graph Link Preview Protocol"@en ;
    rdfs:comment "Link Preview is a web infrastructure technique that fetches and parses Open Graph metadata, title, description, and thumbnail from a target URL to generate a rich card preview for display in social feeds, chat applications, or note-taking tools. APIs and Python libraries such as linkpreview and URLMeta automate this extraction, enabling knowledge graphs and collaborative platforms to surface contextual summaries alongside raw hyperlinks."@en ;
    rdfs:subClassOf ngm:infra-computing-and-cloud ;
    skos:broader ngm:infra-computing-and-cloud ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:relatedTo ngm:knowledge-graph,
        ngm:social-media-platform-infrastructure,
        ngm:user-interface ;
    vc:slug "open-graph-link-preview-protocol" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:semantic-web-linked-data-standard .

ngm:open-sea a owl:Class ;
    rdfs:label "OpenSea"@en ;
    rdfs:comment "OpenSea is a peer-to-peer decentralised marketplace for non-fungible tokens (NFTs), enabling users to mint, list, auction, and trade digital assets on multiple blockchain networks including Ethereum, Polygon, Solana, and others. Founded in 2017, it operates through integration with self-custodial crypto wallets and on-chain smart contracts that escrow assets and execute transfers atomically upon payment settlement. OpenSea pioneered the concept of a permissionless NFT trading platform, supporting diverse token standards such as ERC-721 and ERC-1155, and providing creator royalty enforcement mechanisms at the contract level."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:nft ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:smart-contract ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:crypto-wallet ],
        ngm:nft-marketplace ;
    vc:bridgesTo ngm:digital-art,
        ngm:metaverse,
        ngm:virtual-real-estate ;
    vc:contrastsWith ngm:blur,
        ngm:foundation,
        ngm:rarible ;
    vc:dependsOn ngm:blockchain,
        ngm:decentralised-finance ;
    vc:enables ngm:creator-royalties,
        ngm:digital-asset,
        ngm:nft-minting,
        ngm:peer-to-peer-trading ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:digital-ownership,
        ngm:gas-fee,
        ngm:provenance-tracking,
        ngm:token-standard ;
    vc:requires ngm:crypto-wallet,
        ngm:nft,
        ngm:smart-contract ;
    vc:slug "open-sea" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:erc-1155,
        ngm:erc-721,
        ngm:ethereum,
        ngm:ipfs,
        ngm:polygon .

ngm:open-source-digital-painting-application a owl:Class ;
    rdfs:label "Open Source Digital Painting Application"@en ;
    rdfs:comment "Krita is a free, open-source professional digital painting and raster graphics application developed by the KDE community. It supports illustration, concept art, texture painting, and AI-assisted image synthesis via plugins such as krita-ai-diffusion, which integrates Stable Diffusion through a ComfyUI backend on a local or remote inference server."@en ;
    rdfs:subClassOf ngm:infra-software-engineering ;
    skos:broader ngm:infra-software-engineering ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:creative-tools,
