ngm:multirotor-uav a owl:Class ;
    rdfs:label "Multirotor UAV"@en ;
    rdfs:comment "A Multirotor UAV is an unmanned aerial vehicle that achieves lift and attitude control through three or more independently driven rotors. Differential rotor speed adjustment enables hover, translation, yaw, and agile manoeuvring without mechanical pitch or collective mechanisms, making multirotors highly manoeuvrable platforms suited to inspection, aerial photography, payload delivery, and search-and-rescue operations."@en ;
    rdfs:subClassOf ngm:aerial-robot,
        ngm:robo-robot-type ;
    skos:broader ngm:robo-robot-type ;
    vc:enables ngm:autonomous-navigation,
        ngm:motion-planning ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:odometry,
        ngm:path-planning,
        ngm:swarm-robotics ;
    vc:slug "multirotor-uav" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:3-d-li-dar,
        ngm:kalman-filter,
        ngm:pid-controller,
        ngm:sensor-fusion,
        ngm:state-space-control .

ngm:narrative-arc a owl:Class ;
    rdfs:label "Narrative Arc"@en ;
    rdfs:comment "The structural framework of a story that charts the progression through exposition, rising action, climax, falling action, and resolution, creating peaks and plateaus of dramatic tension that engage audiences and shape their emotional journey through the narrative."@en ;
    rdfs:subClassOf ngm:sc-content-and-assets,
        ngm:storytelling-structure ;
    skos:broader ngm:sc-content-and-assets ;
    vc:enables ngm:non-linear-narrative ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:slug "narrative-arc" ;
    vc:sourceDomain "spatial-computing" .

ngm:narrative-structure a owl:Class ;
    rdfs:label "Narrative Structure"@en ;
    rdfs:comment "The organisational framework governing how a story's events, character arcs, and thematic elements are arranged across time to produce meaning and audience engagement. In spatial and interactive contexts, narrative structure governs branching paths, player agency, and the sequencing of immersive experiences within virtual worlds and game environments."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:game-narratives ],
        ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:enables ngm:immersive-entertainment,
        ngm:virtual-world ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:game-narratives ;
