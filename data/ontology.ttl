ngm:reactive-control a owl:Class ;
    rdfs:label "Reactive Control"@en ;
    rdfs:comment "Reactive Control is a paradigm of robot control architecture in which sensor inputs are mapped directly to actuator outputs through fast, pre-compiled stimulus-response rules, without constructing an explicit world model. Associated with Brooks's subsumption architecture and behaviour-based robotics, it enables low-latency responses to environmental perturbations and is typically combined with deliberative or hybrid planners in practical autonomous systems."@en ;
    rdfs:subClassOf ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:contrastsWith ngm:closed-loop-control ;
    vc:enables ngm:autonomous-robot,
        ngm:obstacle-avoidance ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:force-control,
        ngm:manipulation,
        ngm:motion-control ;
    vc:slug "reactive-control" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:feedback-control,
        ngm:sensor-fusion .

