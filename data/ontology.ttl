    vc:requires <urn:visionflow:linked:binaural-rendering>,
        <urn:visionflow:linked:head-tracking>,
        <urn:visionflow:linked:hrtf-filters> ;
    vc:slug "audio-spatialization" ;
    vc:sourceDomain "spatial-computing" .

