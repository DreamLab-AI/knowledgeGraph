ngm:banking a owl:Class ;
    rdfs:label "Banking"@en ;
    rdfs:comment "Banking is the system of financial intermediation through which licensed institutions accept deposits, extend credit, and provide payment and related services to individuals, businesses, and governments. Banks transform short-term deposits into longer-term loans, manage liquidity and risk, and operate the payment rails that move money through the economy. As a regulated, systemically important sector, banking sits at the centre of monetary policy transmission and financial stability."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:clearing ],
