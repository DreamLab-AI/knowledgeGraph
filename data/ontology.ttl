    vc:slug "physics-based-animation" ;
    vc:sourceDomain "spatial-computing" .

ngm:physics-simulation-engine a owl:Class ;
    rdfs:label "Physics Simulation Engine"@en ;
    rdfs:comment "A physics simulation engine is software that numerically integrates equations of motion over time to compute the movement, collision, and interaction of objects according to physical laws such as Newtonian mechanics, rigid-body dynamics, and contact resolution. It is used in real-time applications (games, XR), offline engineering simulation, and robotics training environments."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:soft-body-dynamics ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:constraint-solver ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:fluid-simulation ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:collision-detection ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:numerical-integration ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:rigid-body-dynamics ],
        ngm:simulation ;
    vc:bridgesTo ngm:digital-twin,
        ngm:machine-learning,
        ngm:robotics ;
    vc:dependsOn ngm:gpu-acceleration,
        ngm:scene-graph ;
    vc:enables ngm:digital-twin,
        ngm:extended-reality,
        ngm:simulation-environment ;
