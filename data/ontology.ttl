    vc:relatedTo ngm:model-compression-for-edge ;
    vc:slug "real-time-ai-inference" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:gpu-acceleration ;
    vc:uses ngm:inference-engine ;
    vc:uses ngm:npu ;
    vc:uses ngm:onnx-runtime .
ngm:real-time-analytics a owl:Class ;
    rdfs:comment "Real-time analytics is the processing and analysis of data immediately as it is generated, producing insights and triggering actions with sub-second to low-second latency. It relies on stream-processing engines, in-memory computation, and windowed aggregation rather than batch ETL. It enables responsive dashboards, anomaly detection, and adaptive systems that act on fresh data."@en ;
    rdfs:label "Real-Time Analytics"@en ;
    rdfs:subClassOf ngm:data-management ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:adaptive-virtual-experience ;
    vc:relatedTo ngm:edge-computing-node ;
    vc:slug "real-time-analytics" ;
    vc:sourceDomain "data" .
ngm:real-time-animation a owl:Class ;
    rdfs:comment "Real-time animation is the generation or playback of character and object motion at interactive frame rates, computed live rather than pre-rendered, so that the animation can respond immediately to input or simulation state. It relies on techniques such as animation retargeting to map captured or authored motion onto different skeletons on the fly, and on motion capture as a common source of the underlying motion data. It is a core requirement for games, virtual avatars and interactive XR experiences."@en ;
    rdfs:label "Real-Time Animation"@en ;
    rdfs:subClassOf ngm:animation ;
    rdfs:subClassOf _:r17710 ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires ngm:motion-capture ;
    vc:slug "real-time-animation" ;
    vc:sourceDomain "spatial-computing" .
ngm:real-time-avatar a skos:Concept ;
    rdfs:label "Real Time Avatar"@en .
ngm:real-time-captioning a owl:Class ;
    rdfs:comment "Real-time captioning is the continuous generation of synchronised text captions from live audio using streaming automatic speech recognition, with latency low enough that captions appear as speech occurs. It is used for live broadcasts, video conferencing, and accessibility services for deaf and hard-of-hearing users. It requires low-latency acoustic and language models tuned to trade a small amount of accuracy for responsiveness."@en ;
    rdfs:label "Real-Time Captioning"@en ;
    rdfs:subClassOf ngm:automatic-speech-recognition ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:automatic-speech-recognition ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:slug "real-time-captioning" ;
    vc:sourceDomain "ai" .
ngm:real-time-carbon-offsetting a skos:Concept ;
    rdfs:label "Real Time Carbon Offsetting"@en .
ngm:real-time-character-animation a owl:Class ;
    rdfs:comment "The process of generating and rendering character movements instantaneously during gameplay or interactive experiences, utilizing rigging systems, motion capture data, and procedural animation to create lifelike digital characters that respond dynamically to user input and environmental conditions."@en ;
    rdfs:label "Real Time Character Animation"@en ;
    rdfs:subClassOf ngm:3-d-animation ;
