    vc:enables ngm:immersive-experience ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:event-management,
        ngm:virtual-event ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires ngm:avatar,
        ngm:collaboration-platform ;
    vc:slug "virtual-event-platform" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:metaverse-platform,
        ngm:social-vr .

ngm:virtual-experience a owl:Class ;
    rdfs:label "Virtual Experience"@en ;
    rdfs:comment "A user-facing encounter or activity delivered within a virtual environment, encompassing immersive simulations, interactive narratives, social engagements, and entertainment events that are accessed through XR devices, gaming platforms, or web-based spatial interfaces."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:virtual-world-infrastructure ],
        [ a owl:Restriction ;
