ngm:bitcoin-improvement-proposals a owl:Class ;
    rdfs:label "Bitcoin Improvement Proposals"@en ;
    rdfs:comment "Bitcoin Improvement Proposals (BIPs) are the formal design documents through which changes, enhancements, and new features are proposed and ratified for the Bitcoin protocol and its ecosystem. First introduced by Amir Taaki in 2011, modelled on Python's PEP process, BIPs serve as the primary coordination mechanism for a decentralised developer community lacking any central authority. Each BIP progresses through a lifecycle of draft, proposed, final, and superseded states, and must achieve rough consensus among node operators and miners to be activated. BIPs cover protocol rules, informational standards, and process definitions for the broader Bitcoin network."@en ;
    rdfs:subClassOf ngm:blockchain-governance ;
    vc:enables ngm:bip-340,
        ngm:bip-341,
        ngm:bitcoin-technical-overview ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:bitcoin-core,
        ngm:bitcoin-network,
        ngm:consensus-rule ;
    vc:slug "bitcoin-improvement-proposals" ;
    vc:sourceDomain "blockchain" ;
    vc:standardizedBy ngm:blockchain-protocol .

ngm:block-size a owl:Class ;
    rdfs:label "Block Size"@en ;
    rdfs:comment "Block Size is the maximum data capacity—measured in bytes or weight units—that a single block in a blockchain may contain, governing how many transactions can be confirmed per block and therefore setting a fundamental upper bound on network throughput. Larger blocks increase per-block transaction capacity but raise propagation latency, orphan-block rates, and hardware requirements for full nodes, while smaller blocks favour decentralisation and faster propagation at the cost of throughput and higher fee markets when demand exceeds capacity. The Bitcoin block-size debate (resulting in the SegWit upgrade and eventual Bitcoin Cash fork) made block size one of the most consequential and politically contentious protocol parameters in blockchain history."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:blockchain ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:block ],
        ngm:bc-protocol-and-consensus,
        ngm:blockchain-entity,
        ngm:distributed-data-structure ;
    skos:broader ngm:bc-protocol-and-consensus ;
    vc:enables ngm:finality,
        ngm:transaction ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:block-time,
        ngm:distributed-ledger,
        ngm:gas,
        ngm:latency,
        ngm:network-protocol,
        ngm:sidechain ;
    vc:requires ngm:block,
        ngm:blockchain ;
    vc:slug "block-size" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:consensus-mechanism,
        ngm:merkle-tree,
        ngm:node .

ngm:blockchain-gaming a owl:Class ;
    rdfs:label "Blockchain Gaming"@en ;
    rdfs:comment "A gaming paradigm in which in-game assets, economies, and ownership records are managed on distributed ledgers, enabling players to hold verifiable ownership of digital items as NFTs, participate in play-to-earn economies, and trade assets across compatible platforms without relying on centralised game servers for provenance or scarcity guarantees."@en ;
    rdfs:subClassOf ngm:infra-computing-and-cloud ;
    skos:broader ngm:infra-computing-and-cloud ;
    vc:dependsOn ngm:blockchain-protocol,
        ngm:nft-marketplace ;
    vc:enables ngm:digital-ownership,
        ngm:virtual-currency,
        ngm:virtual-economy ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:tokenization ;
    vc:slug "blockchain-gaming" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:blockchain,
        ngm:nft,
        ngm:smart-contract .

ngm:blockchain-security a owl:Class ;
    rdfs:label "Blockchain Security"@en ;
    rdfs:comment "Blockchain security is the multidisciplinary field concerned with protecting distributed ledger systems against attacks on their consensus mechanisms, smart contract logic, cryptographic primitives, and network topology, while preserving the properties of immutability, censorship resistance, and trustless operation. It encompasses threat modelling, formal verification of on-chain code, cryptographic auditing, economic game-theory analysis to prevent incentive manipulation, and incident response for decentralised protocols. The discipline is complicated by the public, permissionless nature of most blockchains, where adversaries can observe and interact with the system before attacking."@en ;
    rdfs:subClassOf ngm:cybersecurity ;
    vc:contrastsWith ngm:51-attack,
        ngm:double-spending,
        ngm:sybil-attack ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
