        ngm:iso-639-language-codes,
        ngm:itu-t,
        ngm:w3-c-web-speech-api ;
    vc:supports ngm:customer-support,
        ngm:distributed-teams,
        ngm:education-technology,
        ngm:legal-proceedings,
        ngm:telemedicine,
        ngm:video-conferencing ;
    vc:uses ngm:benchmark-evaluation,
