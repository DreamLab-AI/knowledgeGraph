        ngm:network-analysis,
        ngm:scaling-laws .

ngm:enterprise-resource-planning a owl:Class ;
    rdfs:label "Enterprise Resource Planning"@en ;
    rdfs:comment "Enterprise resource planning (ERP) is an integrated category of business software that unifies core organisational processes - finance, procurement, manufacturing, inventory, human resources and sales - around a shared data model and central database. By recording transactions once and propagating them across modules, ERP systems eliminate data silos and give a consistent, real-time view of operations. Modern ERP is frequently delivered as a cloud service and extended with analytics and supply-chain capabilities."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:master-data-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-integration ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:centralised-database ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:supply-chain-management ],
        ngm:business-process-management ;
    vc:bridgesTo ngm:crm ;
    vc:contrastsWith ngm:supply-chain-management ;
    vc:dependsOn ngm:relational-database ;
    vc:enables ngm:business-intelligence ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:master-data-management,
        ngm:supply-chain-management ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:cloud-computing,
        ngm:data-integration ;
    vc:requires ngm:centralised-database,
        ngm:data-integration ;
    vc:slug "enterprise-resource-planning" ;
    vc:sourceDomain "data" ;
    vc:supports ngm:data-governance,
        ngm:data-management ;
    vc:uses ngm:data-model .

ngm:enterprise-search a owl:Class ;
    rdfs:label "Enterprise Search"@en ;
    rdfs:comment "Enterprise Search is the organisational capability to retrieve relevant information from heterogeneous internal data sources—documents, databases, emails, intranets, wikis, and code repositories—through a single unified query interface with access-control enforcement. Modern systems combine full-text inverted-index retrieval with dense vector embeddings and semantic search to surface contextually relevant results beyond simple keyword matching. The discipline integrates information retrieval, knowledge management, and applied AI, requiring content connectors, identity-aware access control, relevance tuning, and low-latency indexing pipelines at organisational scale. Retrieval-Augmented Generation (RAG) architectures have become a dominant deployment pattern, passing retrieved document chunks to large language models to synthesise grounded, cited answers."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:information-retrieval ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:relevance-ranking ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:inverted-index ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:identity-provider ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:access-control ],
        ngm:information-retrieval ;
    vc:bridgesTo ngm:conversational-ai,
        ngm:large-language-model ;
    vc:contrastsWith ngm:database-query,
        ngm:web-search ;
    vc:dependsOn ngm:data-ingestion,
        ngm:document-processing ;
    vc:enables ngm:decision-support,
        ngm:knowledge-discovery,
        ngm:retrieval-augmented-generation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:inverted-index,
        ngm:query-understanding,
        ngm:relevance-ranking ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:document-management-system,
        ngm:knowledge-graph,
        ngm:knowledge-management ;
    vc:requires ngm:access-control,
        ngm:identity-provider,
        ngm:information-retrieval ;
    vc:slug "enterprise-search" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:bm25,
        ngm:natural-language-processing,
        ngm:semantic-search,
        ngm:text-embeddings,
        ngm:vector-database .

ngm:epipolar-geometry a owl:Class ;
    rdfs:label "Epipolar Geometry"@en ;
    rdfs:comment "Epipolar Geometry is the projective geometry of stereo vision, describing the geometric relationship between two camera views of the same 3D scene. It is encapsulated in the Fundamental Matrix (uncalibrated cameras) and Essential Matrix (calibrated cameras), which constrain the search for correspondences between images to one-dimensional epipolar lines rather than the full 2D image plane."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:feature-matching ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:projective-geometry ],
        ngm:computer-vision ;
    vc:bridgesTo ngm:augmented-reality,
        ngm:autonomous-driving ;
    vc:contrastsWith ngm:monocular-depth-estimation ;
    vc:dependsOn ngm:camera-calibration,
        ngm:ransac ;
    vc:enables ngm:3-d-reconstruction,
        ngm:depth-estimation,
        ngm:stereo-rectification,
        ngm:stereo-vision,
        ngm:structure-from-motion ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:bundle-adjustment,
        ngm:point-cloud ;
    vc:requires ngm:feature-matching,
        ngm:projective-geometry ;
    vc:slug "epipolar-geometry" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:novel-view-synthesis,
        ngm:slam,
        ngm:visual-odometry ;
    vc:uses ngm:camera-intrinsics,
        ngm:homography,
        ngm:triangulation .

ngm:epoch a owl:Class ;
    rdfs:label "Epoch"@en ;
    rdfs:comment "In machine learning, an Epoch is one complete pass through the entire training dataset, during which model parameters are updated after each constituent batch. The number of epochs is a primary training hyperparameter: too few yield underfitting, whilst too many risk overfitting—a trade-off managed by techniques such as early stopping and learning-rate scheduling. More broadly, an epoch denotes a fixed reference point or interval in time, as used in astronomical coordinate systems (e.g., J2000.0) and geological stratigraphy."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:loss-function ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:batch-size ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:mini-batch ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:training-dataset ],
        ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:bridgesTo ngm:autonomous-robot,
        ngm:blockchain ;
    vc:contrastsWith ngm:online-learning,
        ngm:overfitting ;
    vc:dependsOn ngm:backpropagation,
        ngm:deep-learning,
        ngm:early-stopping ;
    vc:enables ngm:convergence,
        ngm:weight-update ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:batch-size,
        ngm:mini-batch ;
    vc:isPartOf ngm:model-training,
        ngm:training-loop ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:gradient-descent,
        ngm:hyperparameter,
        ngm:learning-rate,
        ngm:learning-rate-schedule,
        ngm:underfitting,
        ngm:validation-set ;
    vc:requires ngm:loss-function,
        ngm:training-dataset ;
    vc:slug "epoch" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:existential-risk a owl:Class ;
    rdfs:label "Existential Risk"@en ;
    rdfs:comment "An existential risk is any risk that could permanently and drastically curtail humanity's long-run potential — including human extinction, irreversible civilisational collapse, or permanent totalitarian lock-in — as distinct from severe but recoverable catastrophes. The concept grounds a research agenda that prioritises preventing outcomes from which recovery is impossible, because their badness is unbounded by the loss of all future generations."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:existential-ai-risk ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:biosecurity ],
        ngm:catastrophic-risk-assessment ;
    vc:bridgesTo ngm:ai-alignment,
        ngm:climate-risk,
        ngm:future-of-humanity-institute ;
    vc:dependsOn ngm:longtermism ;
    vc:enables ngm:ai-policy,
        ngm:catastrophic-risk-reduction,
        ngm:pandemic-preparedness ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:biosecurity,
        ngm:engineered-pathogen-risk,
        ngm:existential-ai-risk,
        ngm:nuclear-risk,
        ngm:pandemic-risk ;
    vc:isPartOf ngm:global-catastrophic-risk,
        ngm:risk-analysis ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:biosecurity,
        ngm:centre-for-the-study-of-existential-risk,
        ngm:future-of-humanity-institute,
        ngm:longtermism ;
    vc:requires ngm:moral-philosophy,
        ngm:probability-estimation ;
    vc:slug "existential-risk" ;
    vc:sourceDomain "governance" ;
    vc:supports ngm:ai-governance,
        ngm:regulation .

ngm:f1-score a owl:Class ;
    rdfs:label "F1 Score"@en ;
    rdfs:comment "A classification performance metric representing the harmonic mean of precision and recall, providing a single score that balances a model's ability to avoid false positives (precision) with its ability to avoid false negatives (recall), calculated to give equal weight to both metrics whilst penalising extreme imbalances, particularly useful for comparing models or setting decision thresholds when both prediction reliability and completeness are important and when class distributions are imbalanced."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:true-positive ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:classification ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:recall ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:confusion-matrix ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:precision ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:false-positive ],
        ngm:evaluation-metric ;
    vc:bridgesTo ngm:evaluation-metric,
        ngm:information-retrieval ;
    vc:contrastsWith ngm:accuracy,
        ngm:auc,
        ngm:matthews-correlation-coefficient ;
    vc:dependsOn ngm:supervised-learning ;
    vc:enables ngm:model-selection,
        ngm:threshold-optimisation ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:false-positive,
        ngm:precision,
        ngm:recall,
        ngm:true-positive ;
    vc:isPartOf ngm:classification-evaluation,
        ngm:model-performance ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:algorithmic-fairness,
        ngm:mlops,
        ngm:model-governance ;
    vc:requires ngm:classification,
        ngm:confusion-matrix ;
    vc:slug "f1-score" ;
    vc:sourceDomain "machine-learning" ;
    vc:uses ngm:precision-recall-curve .

ngm:firewall a owl:Class ;
    rdfs:label "Firewall"@en ;
    rdfs:comment "A firewall is a network security control that monitors and filters incoming and outgoing traffic according to a defined rule set, allowing or blocking packets and connections to enforce a security boundary. Firewalls range from stateless packet filters to stateful inspection devices and next-generation appliances that perform deep packet inspection and application awareness. They are a foundational component for segmenting trusted and untrusted networks."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:access-control ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:access-control ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:tcp-ip ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:network-segmentation ],
        ngm:network-security ;
    vc:bridgesTo ngm:web-application-firewall ;
    vc:contrastsWith ngm:intrusion-detection-system ;
