# Sustainable Consensus
blockchain:SustainableConsensus rdf:type owl:Class ;
    rdfs:label "Sustainable Consensus"@en ;
    rdfs:comment "Sustainable consensus mechanisms prioritise environmental efficiency and ecological impact reduction in BlockchainTechnology systems, contrasting with energy-intensive ProofOfWork approaches through alternatives like ProofOfStake, DelegatedProofOfStake, and ProofOfAuthority. These mechanisms achieve distributed agreement and security whilst consuming orders of magnitude less electricity, addressing climate concerns that have restricted cryptocurrency adoption and institutional investment. Major BlockchainPlatforms including Ethereum, Cardano, and Solana have transitioned to sustainable consensus models or launched with efficient designs, balancing decentralisation, security, and environmental responsibility."@en ;
    skos:prefLabel "Sustainable Consensus"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:blockchain:sustainable-consensus" ;
    owl:sameAs <urn:visionclaw:concept:blockchain:sustainable-consensus> ;
    vcw:contentHash "sha256-12-5c8a29732c6f" ;
    vcw:qualityScore "0.4"^^xsd:decimal ;
    vcw:legacyTermId "BC-0503" ;
    vcw:ontologyStatus "stub-needs-content" ;
    vcw:maturityLevel "draft" ;
    vcw:authorityScore "0.0"^^xsd:decimal ;
    dcterms:identifier "BC-0503" ;
    dcterms:subject "blockchain" ;
    owl:versionInfo "2.0.0" ;
    dcterms:created "2026-04-26T00:00:00Z"^^xsd:dateTime ;
    dcterms:modified "2026-04-26T13:00:00Z"^^xsd:dateTime ;
    vcw:owlRole "Concept" .

# Blockchain Environmental Impact Assessment
blockchain:BlockchainEnvironmentalImpactAssessment rdf:type owl:Class ;
    rdfs:subClassOf blockchain:EnvironmentalAssessment ;
    rdfs:subClassOf blockchain:SustainabilityMetric ;
    rdfs:subClassOf blockchain:BlockchainGovernance ;
    rdfs:subClassOf blockchain:LifeCycleAssessment ;
    rdfs:label "Blockchain Environmental Impact Assessment"@en ;
    rdfs:comment "A systematic evaluation methodology for measuring, analyzing, and reporting the environmental consequences of blockchain network operations, encompassing energy consumption measurement (electricity usage per transaction, annual network consumption), carbon emissions calculation (CO₂e from electricity generation mix), e-waste generation (hardware lifecycle and disposal), water consumption (data center cooling), and broader ecological impacts, with standardized frameworks including Life Cycle Assessment (ISO 14040/14044), Cambridge Centre for Alternative Finance methodologies, and blockchain-specific metrics for comparing consensus mechanisms (Proof-of-Work vs Proof-of-Stake environmental profiles)."@en ;
    skos:prefLabel "Blockchain Environmental Impact Assessment"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:blockchain:blockchain-environmental-impact-assessment" ;
    owl:sameAs <urn:visionclaw:concept:blockchain:blockchain-environmental-impact-assessment> ;
    vcw:contentHash "sha256-12-02e21a4bbf64" ;
    vcw:qualityScore "0.5"^^xsd:decimal ;
    vcw:legacyTermId "BC-0504" ;
    vcw:ontologyStatus "mature" ;
    vcw:maturityLevel "production-ready" ;
    vcw:authorityScore "0.89"^^xsd:decimal ;
    dcterms:identifier "BC-0504" ;
    dcterms:subject "blockchain" ;
    owl:versionInfo "2.0.0" ;
    dcterms:created "2026-04-26T00:00:00Z"^^xsd:dateTime ;
    dcterms:modified "2026-04-26T13:00:00Z"^^xsd:dateTime ;
    vcw:owlRole "AssessmentFramework" .

