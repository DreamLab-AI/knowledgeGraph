        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gpu ],
        ngm:sc-display-and-rendering ;
    skos:broader ngm:sc-display-and-rendering ;
    vc:bridgesTo ngm:xr-rendering ;
    vc:contrastsWith ngm:compute-shader,
        ngm:geometry-shader ;
    vc:enables ngm:ambient-occlusion,
