ngm:light-client a owl:Class ;
    rdfs:label "Light Client"@en ;
    rdfs:comment "Resource-efficient blockchain client that validates block headers and uses cryptographic proofs (Merkle proofs, state proofs) to verify transaction inclusion without downloading full blockchain state. Light clients enable trustless interaction from mobile devices, browsers, and IoT systems while requiring only megabytes of storage versus gigabytes for full nodes."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:block-header ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:peer-to-peer-network ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:merkle-proof ],
        ngm:node ;
    vc:bridgesTo ngm:edge-computing,
        ngm:iot-device ;
    vc:contrastsWith ngm:archive-node,
        ngm:full-node ;
    vc:dependsOn ngm:consensus-mechanism,
        ngm:cryptographic-hash-function ;
    vc:enables ngm:cross-chain-bridge,
        ngm:mobile-wallet,
        ngm:trustless-verification ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:header-chain,
        ngm:merkle-proof ;
    vc:implements ngm:spv-simplified-payment-verification,
        ngm:state-proof ;
    vc:isPartOf ngm:blockchain-network,
        ngm:interoperability-protocol ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:fraud-proof,
        ngm:verkle-tree ;
    vc:requires ngm:block-header,
        ngm:peer-to-peer-network ;
    vc:slug "light-client" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:decentralised-application,
        ngm:relayer ;
    vc:uses ngm:bls-signature,
        ngm:merkle-tree,
        ngm:zero-knowledge-proof .

ngm:message-authentication-code a owl:Class ;
    rdfs:label "Message Authentication Code"@en ;
    rdfs:comment "A Message Authentication Code (MAC) is a fixed-size cryptographic tag generated from an arbitrary-length message and a shared secret key using a keyed hash or block-cipher-based algorithm, providing simultaneous data integrity verification and authentication of the sender to any party holding the same secret key. Unlike digital signatures, MACs are symmetric and do not provide non-repudiation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:key-management ],
        ngm:cryptography ;
    vc:bridgesTo ngm:distributed-systems-security,
        ngm:iot-security ;
    vc:contrastsWith ngm:digital-signature,
        ngm:non-repudiation ;
    vc:enables ngm:authenticated-encryption,
        ngm:data-integrity,
        ngm:message-authentication ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:implements ngm:cmac,
        ngm:hmac,
        ngm:poly1305 ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:authentication,
        ngm:cryptographic-protocol,
        ngm:post-quantum-cryptography ;
    vc:requires ngm:key-management,
        ngm:symmetric-key ;
    vc:slug "message-authentication-code" ;
    vc:sourceDomain "security" ;
    vc:standardizedBy ngm:ietf,
        ngm:nist ;
    vc:supports ngm:api-authentication,
        ngm:ipsec,
        ngm:tls ;
    vc:uses ngm:block-cipher,
        ngm:hash-function,
        ngm:pseudorandom-function,
        ngm:shared-secret-key,
        ngm:symmetric-encryption .

ngm:mi-ca-regulation a owl:Class ;
    rdfs:label "MiCA Regulation"@en ;
    rdfs:comment "The Markets in Crypto-Assets (MiCA) Regulation (EU 2023/1114) is the European Union's comprehensive legislative framework governing the issuance, offering, and trading of crypto-assets, including asset-referenced tokens, e-money tokens, and utility tokens. Adopted in June 2023 and phasing in through December 2024, MiCA establishes authorisation requirements for crypto-asset service providers (CASPs), disclosure obligations analogous to prospectus rules, and prudential standards for stablecoin issuers, creating the world's first complete statutory crypto-asset regime across a major economic bloc."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:aml-kyc-compliance ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:regulatory-compliance ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:compliance-framework ],
        ngm:financial-regulation ;
