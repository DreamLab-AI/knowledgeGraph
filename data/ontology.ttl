    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:digital-trust,
        ngm:federated-identity ;
    vc:requires ngm:identity-provider,
        ngm:trust-framework ;
    vc:slug "relying-party" ;
    vc:sourceDomain "security" ;
    vc:supports ngm:single-sign-on ;
    vc:uses ngm:oauth,
        ngm:saml .

ngm:remote-pair-programming a owl:Class ;
    rdfs:label "Remote Pair Programming"@en ;
    rdfs:comment "Remote Pair Programming is a synchronous collaborative software-development practice in which two developers—one acting as driver (typing) and one as navigator (reviewing, guiding, strategising)—share a single logical programming environment across geographically separated workstations, communica..."@en ;
