    vc:slug "hugging-face-accelerate" ;
    vc:sourceDomain "ai" .

ngm:hugging-face-model-hub a owl:Class ;
    rdfs:label "Hugging Face Model Hub"@en ;
    rdfs:comment "The Hugging Face Model Hub is a public repository and platform for sharing, discovering, and versioning machine-learning models, datasets, and demo spaces. Built on Git and Git-LFS, it hosts hundreds of thousands of pretrained models with standardised model cards, metadata, and direct integration into the Transformers ecosystem. It functions as the central distribution layer for open machine-learning artefacts."@en ;
