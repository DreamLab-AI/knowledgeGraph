ngm:instant-id a owl:Class ;
    rdfs:comment "InstantID is a diffusion-model technique for identity-preserving image generation that synthesises new images of a specific person from a single reference photograph, without per-subject fine-tuning. It combines a face encoder with an IdentityNet adapter that injects facial identity and spatial landmarks into a text-to-image diffusion backbone. While powerful for personalised avatars and stylisation, its zero-shot fidelity also raises misuse concerns around impersonation and synthetic media."@en ;
    rdfs:label "InstantID"@en ;
    rdfs:subClassOf ngm:diffusion-models ;
    rdfs:subClassOf ngm:generative-model ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:control-net-and-similar-spatial-conditioning-systems ;
    vc:relatedTo ngm:deepfakes-and-fraudulent-content ;
    vc:slug "instant-id" ;
    vc:sourceDomain "ai" .
ngm:instant-messaging a owl:Class ;
    rdfs:comment "Instant messaging is a form of real-time, text-based direct communication between two or more participants over a network. Messages are delivered with minimal latency, enabling synchronous or near-synchronous conversation without the formality of email. It serves as a foundational channel for informal coordination and rapid decision-making in distributed teams."@en ;
    rdfs:label "Instant Messaging"@en ;
    rdfs:subClassOf ngm:dc-communication ;
    skos:broader ngm:dc-communication ;
    vc:enables ngm:real-time-communication ;
