ngm:rb-0089-risk-assessment a owl:Class ;
    rdfs:label "rb 0089 risk assessment"@en ;
    rdfs:comment "Risk Assessment in robotics is the systematic process of identifying hazards associated with a robot system, estimating the severity and probability of potential harm, and determining whether risks are acceptable or require mitigation. It is mandated by ISO 10218-1/-2 for industrial robots and ISO 13482 for personal care robots, and forms the foundation for selecting appropriate safeguarding measures and collaborative operation modes."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:rb-0087-safety-standard ],
        ngm:robo-safety-and-standards ;
    skos:broader ngm:robo-safety-and-standards ;
    vc:dependsOn ngm:rb-0088-iso-13482-compliance ;
    vc:enables ngm:rb-0096-safeguarding,
        ngm:rb-0103-collaborative-operation ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:functional-safety,
        ngm:rb-0090-emergency-stop,
        ngm:rb-0095-safety-zone,
        ngm:rb-0100-safety-integrity-level,
        ngm:risk-assessment ;
    vc:requires ngm:rb-0087-safety-standard ;
    vc:slug "rb-0089-risk-assessment" ;
    vc:sourceDomain "robotics" .

ngm:selective-disclosure a owl:Class ;
    rdfs:label "Selective Disclosure"@en ;
    rdfs:comment "Selective disclosure is a cryptographic capability that allows the holder of a verifiable credential to present only a chosen subset of the credential's claims to a verifier, without the verifier being able to learn anything about the undisclosed fields and without requiring re-issuance of a new credential by the issuer. It is implemented through cryptographic mechanisms such as BBS+ signatures, SD-JWT, and zero-knowledge proofs, and is a core design goal of the W3C Verifiable Credentials standard and decentralised identity architectures that aim to minimise unnecessary personal data exposure."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:verifiable-credentials ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:zero-knowledge-proof ],
        ngm:bc-cryptographic-primitive ;
    skos:broader ngm:bc-cryptographic-primitive ;
    vc:enables ngm:decentralised-identity,
        ngm:privacy-preserving-technology ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:credential-format-standard ;
    vc:requires ngm:verifiable-credentials,
        ngm:zero-knowledge-proof ;
    vc:slug "selective-disclosure" ;
    vc:sourceDomain "blockchain" .

ngm:semantic-segmentation a owl:Class ;
    rdfs:label "Semantic Segmentation"@en ;
    rdfs:comment "Semantic Segmentation is the computer vision task of assigning a class label to every pixel in an image, partitioning the image into semantically meaningful regions without distinguishing between individual object instances."@en ;
    rdfs:subClassOf ngm:ai-technique,
