ngm:matrix-multiplication a owl:Class ;
    rdfs:label "Matrix Multiplication"@en ;
    rdfs:comment "Matrix multiplication is the binary operation that combines two matrices to produce a third, where each entry of the result is the dot product of a row of the first matrix with a column of the second. It is the fundamental computational primitive of linear algebra and the dominant operation in deep learning, where dense layers, attention and convolutions all reduce to large matrix or tensor products executed on parallel hardware such as GPUs and TPUs."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:hardware-acceleration ],
        ngm:linear-algebra ;
    vc:dependsOn ngm:gpu-acceleration ;
    vc:enables ngm:backpropagation,
        ngm:deep-learning,
        ngm:neural-network,
        ngm:transformer ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:implements ngm:convolution,
        ngm:multi-head-attention,
        ngm:self-attention ;
    vc:isPartOf ngm:linear-algebra ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:requires ngm:hardware-acceleration ;
    vc:slug "matrix-multiplication" ;
    vc:sourceDomain "machine-learning" ;
    vc:supports ngm:embedding,
        ngm:machine-learning ;
    vc:uses ngm:gpu,
        ngm:tensor-processing-unit,
        ngm:tpu .

ngm:mixed-precision-training a owl:Class ;
    rdfs:label "Mixed Precision Training"@en ;
    rdfs:comment "A training technique that uses lower precision (FP16 or BF16) for most computations whilst maintaining higher precision (FP32) for numerically critical operations, reducing memory usage and increasing training speed without sacrificing model quality. Relies on loss scaling to prevent gradient underflow and leverages hardware tensor cores for throughput gains."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gpu-compute ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:hardware-acceleration ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:tensor-core ],
        ngm:neural-network-training ;
    vc:bridgesTo ngm:hardware-software-co-design ;
    vc:contrastsWith ngm:neural-network-quantisation ;
    vc:dependsOn ngm:automatic-differentiation,
        ngm:floating-point-arithmetic,
