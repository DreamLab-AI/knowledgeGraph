ngm:decision-theory a owl:Class ;
    rdfs:label "Decision Theory"@en ;
    rdfs:comment "Decision theory is the formal study of how a rational agent should choose among actions whose outcomes are uncertain, combining probabilities over states of the world with utilities over outcomes to select actions that maximise expected utility. Its normative branch prescribes optimal choice under axioms of rationality, while its descriptive branch studies how agents actually decide. It provides the foundational framework for rational action in artificial intelligence, economics, and operations research."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:utility-theory ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:uncertainty-quantification ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:probability-theory ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:markov-decision-process ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:bayesian-inference ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:value-function ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:objective-function ],
        ngm:artificial-intelligence ;
    skos:broader ngm:artificial-intelligence ;
    vc:bridgesTo ngm:cognitive-science,
        ngm:game-theory,
        ngm:operations-research ;
    vc:contrastsWith ngm:behavioural-economics,
        ngm:bounded-rationality,
        ngm:game-theory ;
    vc:enables ngm:decision-making,
        ngm:markov-decision-process,
        ngm:planning,
        ngm:policy-optimisation,
        ngm:rational-agent ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:bayesian-inference,
        ngm:heuristics,
        ngm:markov-decision-process,
        ngm:utility-theory,
        ngm:value-function ;
    vc:qualityScore "0.9"^^xsd:float ;
    vc:relatedTo ngm:autonomous-agent,
        ngm:bayesian-inference,
        ngm:control-theory,
        ngm:knowledge-representation,
        ngm:large-language-models,
        ngm:operations-research ;
    vc:requires ngm:objective-function,
        ngm:probability-theory,
        ngm:uncertainty-quantification ;
    vc:slug "decision-theory" ;
    vc:sourceDomain "artificial-intelligence" ;
