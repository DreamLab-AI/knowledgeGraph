    owl:someValuesFrom mv:DataPrivacy
] .

mv:PrivacyArchitecture rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:relatedTo ;
    owl:someValuesFrom mv:DataProtection
] .

mv:PrivacyArchitecture rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:relatedTo ;
