    vc:supports ngm:governance,
        ngm:quality-assurance ;
    vc:uses ngm:documentation-standards .

ngm:composite-ai a owl:Class ;
    rdfs:label "Composite AI"@en ;
    rdfs:comment "Composite AI is an architectural paradigm that integrates multiple distinct AI techniques — such as machine learning, symbolic reasoning, natural language processing, computer vision, and knowledge graphs — into a unified hierarchical system to solve complex real-world problems that no single technique alone can address adequately. By orchestrating complementary AI capabilities, composite AI achieves higher contextual understanding, adaptability, and decision-making precision than monolithic approaches. It is increasingly the default pattern in enterprise intelligent automation, autonomous systems, and multimodal applications."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:machine-learning-discipline ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:computer-vision ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:natural-language-processing ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:symbolic-reasoning ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:knowledge-graph ],
        ngm:ai-research-area ;
    skos:broader ngm:ai-research-area ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:computer-vision,
        ngm:knowledge-graph,
        ngm:machine-learning-discipline,
        ngm:natural-language-processing,
        ngm:symbolic-reasoning ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:deep-learning,
        ngm:ensemble-methods,
        ngm:explainable-ai,
        ngm:generative-ai,
        ngm:multimodal-ai-architecture,
        ngm:reinforcement-learning ;
    vc:slug "composite-ai" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:computational-component a owl:Class ;
    rdfs:label "Computational Component"@en ;
    rdfs:comment "A Computational Component is a modular, well-defined unit of an AI or software system that encapsulates specific processing logic — such as a neural network layer, a feature extraction module, or an inference engine — and interacts with other components through defined interfaces. Computational components abstract implementation details from consumers, enabling composition into larger pipelines and substitution of equivalent implementations without modifying the surrounding system. They are the primary unit of reuse, testing, and deployment in AI infrastructure, ranging from low-level hardware accelerator kernels to high-level model serving endpoints."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:interface ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:module ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:computational-resources ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:neural-network-layer ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:algorithm ],
        ngm:ai-infrastructure,
        ngm:component ;
    vc:enables ngm:inference,
        ngm:model-training ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:algorithm,
        ngm:module,
        ngm:neural-network-layer ;
    vc:isPartOf ngm:ai-system-component,
        ngm:machine-learning-discipline-pipeline ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:middleware,
        ngm:model-architecture,
        ngm:neural-network-component,
        ngm:software-architecture ;
    vc:requires ngm:computational-resources,
        ngm:interface ;
    vc:slug "computational-component" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:compute-infrastructure,
        ngm:gpu-compute,
        ngm:hardware-acceleration .

ngm:computational-image-relighting-technique a owl:Class ;
    rdfs:label "Computational Image Relighting Technique"@en ;
    rdfs:comment "Relighting is a computer graphics and generative AI technique that computationally alters the illumination of an existing image or video, repositioning or replacing light sources to produce a different lighting environment without re-capturing the scene. Modern approaches use neural rendering models trained on diverse lighting conditions, enabling portrait relighting, object relighting, and scene relighting from a single input image. Open-source workflows in tools such as ComfyUI implement IC-Light and similar diffusion-based pipelines that rival or exceed proprietary solutions."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:node-based-diffusion-pipeline-interface-workflows ],
        ngm:infra-computing-and-cloud ;
    skos:broader ngm:infra-computing-and-cloud ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:ai-video,
        ngm:control-net,
        ngm:differentiable-rendering,
        ngm:inpainting ;
    vc:requires ngm:node-based-diffusion-pipeline-interface-workflows ;
    vc:slug "computational-image-relighting-technique" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:diffusion-model,
        ngm:neural-rendering,
        ngm:physically-based-rendering .

ngm:conceptual-hierarchy a owl:Class ;
    rdfs:label "Conceptual Hierarchy"@en ;
    rdfs:comment "A Conceptual Hierarchy is a structured taxonomic organisation of domain concepts into subsumption (is-a) and composition (part-of) relationships, enabling systematic knowledge representation, inheritance of properties, and semantic interoperability across robotic and autonomous systems. It supports automated reasoning, modular system design, and classification of new entities within standardised ontological frameworks."@en ;
    rdfs:subClassOf ngm:infra-software-engineering ;
    skos:broader ngm:infra-software-engineering ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:relatedTo ngm:owl-class-hierarchy,
        ngm:rdf ;
    vc:slug "conceptual-hierarchy" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:knowledge-graph,
        ngm:robotics ;
    vc:uses ngm:knowledge-representation,
        ngm:ontology .

ngm:conceptual-layer a owl:Class ;
    rdfs:label "Conceptual Layer"@en ;
    rdfs:comment "The Conceptual Layer represents the highest abstraction level in an ontological classification system, encompassing pure concepts, theoretical models, design principles, and logical frameworks that are independent of specific technical implementations. Concepts at this layer can be realised through multiple concrete approaches while retaining their essential semantic properties."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:ontology-structure ],
        ngm:infra-software-engineering ;
    skos:broader ngm:infra-software-engineering ;
    vc:contrastsWith ngm:protocol-layer ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:ontology-structure ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:relatedTo ngm:software-architecture,
        ngm:system-architecture ;
    vc:slug "conceptual-layer" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:knowledge-representation,
        ngm:ontology .

ngm:conspiratorial-thinking-in-technology-communities a owl:Class ;
    rdfs:label "Conspiratorial Thinking in Technology Communities"@en ;
    rdfs:comment "Conspiracies, in the context of technology communities, refers to the recurring pattern of conspiratorial thinking that attaches to emerging technologies such as cryptocurrency and AI. Often rooted in legitimate governance concerns, such thinking can escalate into disinformation ecosystems, creating tensions within technology policy, AI safety debates, and open-source governance."@en ;
    rdfs:subClassOf ngm:infra-software-engineering ;
    skos:broader ngm:infra-software-engineering ;
    vc:bridgesTo ngm:california-ai-bill,
        ngm:open-source-ai ;
    vc:contrastsWith ngm:ai-governance,
        ngm:safety-and-alignment ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:relatedTo ngm:ai-governance-law-and-privacy,
        ngm:blockchain ;
    vc:slug "conspiratorial-thinking-in-technology-communities" ;
    vc:sourceDomain "infrastructure" .

ngm:constitutional-principle a owl:Class ;
    rdfs:label "Constitutional Principle"@en ;
    rdfs:comment "A Constitutional Principle in AI alignment is a natural-language rule or norm—derived from human rights frameworks, professional codes, or organisational policies—that is embedded into an AI system's training or inference process to constrain its behaviour across diverse contexts. Constitutional AI, introduced by Anthropic, uses a curated list of such principles as a self-critique scaffold during reinforcement learning from AI feedback (RLAIF), enabling large language models to evaluate and revise their own outputs against explicit normative standards without requiring a human rater for every example. Constitutional Principles serve as the value-bearing component of this approach, operationalising abstract ethical commitments into verifiable behavioural constraints."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:value-alignment ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:reinforcement-learning ],
        ngm:ai-governance-and-ethics ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:enables ngm:ai-alignment,
        ngm:ai-safety,
        ngm:human-agency-and-oversight ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:constitutional-ai-training-methodology ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:accountability,
        ngm:ai-ethics,
        ngm:ai-governance-principle,
        ngm:ai-regulation,
        ngm:fairness ;
    vc:requires ngm:reinforcement-learning,
        ngm:value-alignment ;
    vc:slug "constitutional-principle" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:ai-governance-framework .

ngm:convergence-concept a owl:Class ;
    rdfs:label "Convergence Concept"@en ;
    rdfs:comment "Convergence Concept describes the synthesis of previously distinct technologies, domains, and paradigms into unified systems. In telecollaboration and spatial computing, convergence encompasses XR integration, AI-human collaboration, physical-digital fusion via digital twins, and platform unification over shared protocols such as WebXR and OpenXR. The convergence of edge and cloud computing creates hybrid architectures that optimise latency and scalability for real-time collaborative experiences."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:open-xr ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:interoperability ],
        ngm:infra-computing-and-cloud ;
    skos:broader ngm:infra-computing-and-cloud ;
    vc:bridgesTo ngm:collaboration ;
    vc:dependsOn ngm:spatial-computing ;
    vc:enables ngm:digital-twin,
        ngm:telecollaboration ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:cross-domain-bridge ;
    vc:requires ngm:interoperability,
        ngm:open-xr ;
    vc:slug "convergence-concept" ;
    vc:sourceDomain "infrastructure" .

