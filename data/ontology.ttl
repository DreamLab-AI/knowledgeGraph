ngm:custodian a owl:Class ;
    rdfs:label "Custodian"@en ;
    rdfs:comment "A custodian is an entity entrusted with safeguarding assets on behalf of others, holding and securing them while the legal or beneficial owner retains a claim. In digital-asset markets a custodian secures cryptographic keys and underlying holdings for clients and, in the case of fiat-backed stablecoins, holds the reserves that back issued tokens. Custodianship concentrates security and introduces counterparty risk, which is mitigated through controls such as segregation, audits, and proof of reserves."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:cold-storage ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:kyc ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:trust ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:multisig ],
        ngm:custody ;
    vc:bridgesTo ngm:counterparty-risk ;
    vc:contrastsWith ngm:self-custody ;
    vc:dependsOn ngm:trust ;
    vc:enables ngm:asset-management,
        ngm:proof-of-reserves ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:cold-storage,
        ngm:multisig ;
    vc:implements ngm:institutional-custody ;
    vc:isPartOf ngm:custody,
        ngm:digital-asset-custody ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:aml,
        ngm:audit,
        ngm:transparency ;
    vc:requires ngm:kyc,
        ngm:trust ;
    vc:slug "custodian" ;
    vc:sourceDomain "blockchain" ;
    vc:standardizedBy ngm:regulation ;
    vc:supports ngm:centralized-exchange,
        ngm:stablecoin,
        ngm:tether ;
    vc:uses ngm:cold-storage,
        ngm:hot-wallet,
        ngm:multisig .

ngm:customs-trade-facilitation a owl:Class ;
