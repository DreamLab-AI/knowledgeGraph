    vc:standardizedBy ngm:european-commission .

ngm:diffusion-model a owl:Class ;
    rdfs:label "Diffusion Model"@en ;
    rdfs:comment "A Diffusion Model is a class of generative model that learns to synthesise data by reversing a gradual noising process. During training the model observes how data is progressively corrupted by Gaussian noise; at inference time it iteratively denoises a random sample, guided by a learned score function, to produce high-fidelity outputs such as images, audio, or video. Diffusion models underpin systems like Stable Diffusion and DALL-E 3."@en ;
    rdfs:subClassOf ngm:ai-model-architecture ;
    skos:broader ngm:ai-model-architecture ;
    vc:contrastsWith ngm:generative-adversarial-network ;
