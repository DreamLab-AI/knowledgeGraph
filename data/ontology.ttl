ngm:legal-entity-identifier a owl:Class ;
    rdfs:label "Legal Entity Identifier"@en ;
    rdfs:comment "A Legal Entity Identifier (LEI) is a 20-character alphanumeric code, standardised as ISO 17442, that uniquely identifies a legally distinct entity participating in financial transactions. It is issued by accredited Local Operating Units under the Global LEI System and carries reference data on the entity's ownership and registration. LEIs enable counterparty transparency and are increasingly required for regulatory and trade reporting."@en ;
    rdfs:subClassOf ngm:infra-legal-and-regulatory ;
    skos:broader ngm:infra-legal-and-regulatory ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:regulatory-reporting,
        ngm:travel-rule ;
    vc:slug "legal-entity-identifier" ;
    vc:sourceDomain "governance" .

ngm:legged-robot a owl:Class ;
    rdfs:label "Legged Robot"@en ;
    rdfs:comment "A Legged Robot is a mobile robotic system that achieves locomotion via articulated limbs rather than wheels or tracks, drawing on bio-inspired design and gait control algorithms to navigate complex, unstructured terrain. Contemporary platforms combine reinforcement learning, sensor fusion, and compliant actuators to achieve robust autonomous operation across search-and-rescue, logistics, and infrastructure inspection scenarios."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:control-system ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:actuator ],
        ngm:robo-robot-type ;
    skos:broader ngm:robo-robot-type ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:actuator,
