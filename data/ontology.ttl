ngm:dimensionality-reduction a owl:Class ;
    rdfs:label "Dimensionality Reduction"@en ;
    rdfs:comment "Dimensionality Reduction is the process of transforming high-dimensional data into a lower-dimensional representation while preserving important structural properties and relationships. It addresses the curse of dimensionality, reduces computational costs, enables visualization, removes noise, and improves model performance by eliminating redundant or irrelevant features."@en ;
