ngm:model-context-protocol a owl:Class ;
    rdfs:label "Model Context Protocol"@en ;
    rdfs:comment "The Model Context Protocol (MCP) is an open standard published by Anthropic in November 2024 that defines a JSON-RPC 2.0-based client–server protocol for connecting Large Language Model inference hosts (MCP clients) to external capability providers (MCP servers), exposing tools, resources, an..."@en ;
