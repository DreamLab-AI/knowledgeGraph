ngm:social-platform a owl:Class ;
    rdfs:label "Social Platform"@en ;
    rdfs:comment "A Social Platform is a networked software environment that mediates human connection, identity expression, content sharing, and community formation. It combines identity management, real-time communication, moderation tooling, and reputation mechanisms to sustain persistent social graphs, supporting both synchronous interaction (voice, video) and asynchronous content exchange across devices."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
