    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:industrial-robot,
        ngm:iso-10218,
        ngm:iso-ts-15066,
        ngm:performance-benchmarks ;
    vc:requires ngm:benchmarks,
        ngm:manipulator ;
    vc:slug "iso-9283" ;
    vc:sourceDomain "robotics" ;
    vc:standardizedBy ngm:iso .

ngm:jailbreaking a owl:Class ;
    rdfs:label "Jailbreaking"@en ;
    rdfs:comment "Jailbreaking of large language models (LLMs) is the practice of crafting inputs—prompts, instruction sequences, encoded payloads, or multi-turn conversational strategies—that cause a model to produce outputs that circumvent its safety training, content policies, or alignment objectives."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
