ngm:passkey a owl:Class ;
    rdfs:comment "A passkey is a phishing-resistant, passwordless credential built on WebAuthn and FIDO2 public-key cryptography, stored on a device or synced across a user's devices via a platform cloud account. Authentication proceeds by the device signing a server-issued challenge with a private key that never leaves secure hardware, eliminating shared secrets that can be phished, leaked, or reused. Passkeys are backed by biometric or PIN unlock at the device level and are promoted jointly by Apple, Google, and Microsoft as a replacement for passwords. They require a compatible authenticator and relying-party support to function."@en ;
    rdfs:label "Passkey"@en ;
    rdfs:subClassOf ngm:authentication-mechanism ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:slug "passkey" ;
    vc:sourceDomain "security" .
