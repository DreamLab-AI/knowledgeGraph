        ngm:decentralised-finance,
        ngm:distributed-ledger-technology ;
    vc:contrastsWith ngm:legal-technology,
        ngm:manual-compliance ;
    vc:dependsOn ngm:application-programming-interface,
        ngm:data-standardisation ;
    vc:enables ngm:automated-compliance,
        ngm:regulatory-sandbox,
        ngm:suptech ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:anti-money-laundering,
