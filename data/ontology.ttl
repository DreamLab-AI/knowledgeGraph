        ngm:information-theory,
        ngm:quantum-computing ;
    vc:dependsOn ngm:abstract-algebra ;
    vc:enables ngm:computer-vision,
        ngm:dimensionality-reduction,
        ngm:least-squares-regression,
        ngm:machine-learning-discipline,
        ngm:neural-network,
        ngm:principal-component-analysis ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:determinant,
        ngm:eigenvalue,
        ngm:matrix,
        ngm:singular-value-decomposition,
        ngm:tensor,
        ngm:vector-space ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:probability-theory,
        ngm:statistics ;
    vc:requires ngm:calculus,
        ngm:set-theory ;
    vc:slug "linear-algebra" ;
    vc:sourceDomain "machine-learning" ;
    vc:supports ngm:numerical-methods,
        ngm:optimization,
        ngm:signal-processing ;
    vc:uses ngm:gaussian-elimination,
        ngm:matrix-factorization .

ngm:multi-agent-systems a owl:Class ;
    rdfs:label "Multi-Agent Systems"@en ;
    rdfs:comment "Multi-agent systems (MAS) are computational architectures in which multiple autonomous agents—each with their own perception, memory, reasoning, and action capabilities—interact within a shared environment to accomplish tasks that benefit from parallelisation, specialisation, or distributed coordination. Each agent operates according to local decision logic (reactive, deliberative, or hybrid) while collectively producing emergent global behaviour through communication, negotiation, and coordination protocols. In contemporary AI, MAS are realised through networks of LLM-backed agents orchestrated by frameworks that manage inter-agent messaging, tool invocation, and task decomposition. Mechanism-design principles, game theory, and classical distributed-AI theory inform how modern agentic systems handle conflict, incentive alignment, and safety in open-ended agent populations."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:distributed-computing ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:coordination-protocol ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:autonomous-agent ],
        ngm:distributed-systems ;
    vc:bridgesTo ngm:decentralised-autonomous-organisations,
        ngm:digital-twins,
        ngm:iot-networks ;
    vc:contrastsWith ngm:monolithic-ai,
        ngm:single-agent-systems ;
    vc:dependsOn ngm:game-theory,
        ngm:mechanism-design ;
    vc:enables ngm:agentic-ai,
        ngm:collective-intelligence,
        ngm:emergent-behaviour,
        ngm:task-planning ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:agent-communication-language,
        ngm:autonomous-agent,
        ngm:coordination-protocol ;
    vc:implements ngm:belief-desire-intention,
        ngm:reactive-agents ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:ai-safety,
        ngm:explainability ;
    vc:requires ngm:concurrency,
        ngm:distributed-computing ;
    vc:slug "multi-agent-systems" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:standardizedBy ngm:fipa ;
    vc:supports ngm:reinforcement-learning,
        ngm:robotics,
        ngm:swarm-intelligence ;
    vc:uses ngm:agent-frameworks,
        ngm:large-language-models,
        ngm:message-passing,
        ngm:orchestration .

ngm:open-source-software a owl:Class ;
    rdfs:label "Open Source Software"@en ;
    rdfs:comment "Open Source Software (OSS) is software distributed with source code made publicly available under a licence that grants users the rights to inspect, modify, and redistribute the software and its derivatives. OSS development follows collaborative models coordinated through version-controlled repositories, issue trackers, and community governance structures, enabling distributed contribution at global scale. Canonical licence categories range from permissive instruments (MIT, Apache 2.0, BSD) to copyleft instruments (GPL, LGPL, AGPL) that impose viral redistribution obligations. In the AI, spatial-computing, and broader technology infrastructure landscape, OSS underpins foundational frameworks — including deep learning toolkits, container runtimes, distributed databases, and interoperability specifications — reducing vendor lock-in and accelerating innovation through transparent, auditable codebases."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:intellectual-property-licence-instrument ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:version-control ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:community-governance ],
        ngm:software-engineering ;
    vc:bridgesTo ngm:digital-twin,
        ngm:federated-learning,
        ngm:smart-contract ;
    vc:contrastsWith ngm:closed-source-software,
        ngm:proprietary-software ;
    vc:enables ngm:community-driven-innovation,
        ngm:distributed-collaboration,
        ngm:open-source-ai,
        ngm:reproducible-research,
        ngm:software-supply-chain ;
