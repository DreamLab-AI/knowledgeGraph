        ngm:variational-autoencoders .

ngm:disaster-recovery a owl:Class ;
    rdfs:label "Disaster Recovery"@en ;
    rdfs:comment "Disaster recovery (DR) is the set of policies, tools, and procedures enabling an organisation to restore its IT systems, data, and operations following a disruptive event such as hardware failure, cyberattack, natural disaster, or human error. It is quantified by Recovery Time Objective (RTO) and Recovery Point Objective (RPO), and encompasses backup strategies, replication architectures, and tested failover procedures."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:backup-and-recovery ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:replication ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-centre ],
        ngm:resilience ;
    vc:bridgesTo ngm:governance,
        ngm:security ;
    vc:contrastsWith ngm:high-availability ;
    vc:dependsOn ngm:redundancy,
        ngm:replication ;
    vc:enables ngm:business-continuity,
        ngm:fault-tolerance,
        ngm:high-availability ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:failover,
        ngm:recovery-point-objective,
        ngm:recovery-time-objective ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:incident-response,
        ngm:ransomware,
        ngm:resilience-metric ;
    vc:requires ngm:backup-and-recovery,
        ngm:data-centre,
