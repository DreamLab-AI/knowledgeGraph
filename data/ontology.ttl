            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:haptics ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:eye-tracking ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:hand-tracking ],
        ngm:spatial-computing ;
    skos:broader ngm:spatial-computing ;
    vc:enables ngm:augmented-reality-collaboration,
        ngm:immersive-experience ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:3-d-user-interface,
        ngm:eye-tracking,
        ngm:gaze-control,
        ngm:hand-tracking,
        ngm:haptic-feedback,
        ngm:haptics,
        ngm:voice-interaction,
        ngm:vr-controllers ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:immersive-interface,
        ngm:sc-display-and-rendering,
        ngm:sc-platform-and-environment ;
    vc:slug "sc-interaction" ;
    vc:sourceDomain "spatial-computing" .

ngm:merkle-tree a owl:Class ;
    rdfs:label "Merkle Tree"@en ;
    rdfs:comment "A binary tree of cryptographic hashes in which each leaf node contains the hash of a data block and each non-leaf node contains the hash of its children. Merkle trees enable efficient and tamper-evident verification of large data sets; in blockchain systems they allow nodes to confirm individual transaction inclusion without downloading an entire block."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:merkle-root ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:merkle-proof ],
        ngm:cryptographic-primitive ;
    vc:bridgesTo ngm:content-addressable-storage,
        ngm:distributed-file-system,
