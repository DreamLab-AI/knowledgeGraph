ngm:nakamoto-coefficient a owl:Class ;
    rdfs:label "Nakamoto Coefficient"@en ;
    rdfs:comment "The Nakamoto Coefficient is a quantitative metric for blockchain decentralisation, defined as the minimum number of independent entities in a given subsystem (such as mining pool concentration, validator set, or client software diversity) whose collusion or failure would be sufficient to compromise network security, liveness, or integrity. A higher Nakamoto Coefficient indicates a more resilient, decentralised network; a coefficient of one denotes a single point of failure. The metric is applicable across multiple dimensions of a network simultaneously, yielding a multi-dimensional decentralisation profile rather than a single scalar."@en ;
    rdfs:subClassOf ngm:bc-governance-and-regulation ;
    skos:broader ngm:bc-governance-and-regulation ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:51-attack,
        ngm:blockchain-governance,
        ngm:sybil-resistance ;
    vc:slug "nakamoto-coefficient" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:proof-of-stake,
        ngm:validator-set .

ngm:native-token a owl:Class ;
    rdfs:label "Native Token"@en ;
    rdfs:comment "A Native Token is the primary cryptocurrency issued and managed directly by a blockchain protocol, used to pay transaction fees, reward validators or miners, and serve as the base unit of value within the network's economic system. Unlike tokens created via smart contracts, native tokens are settled at the protocol layer and are intrinsic to chain operation."@en ;
    rdfs:subClassOf ngm:bc-token-and-asset,
        ngm:blockchain-entity,
        ngm:economic-mechanism ;
    skos:broader ngm:bc-token-and-asset ;
    vc:contrastsWith ngm:erc20-token ;
    vc:enables ngm:mining-reward,
        ngm:tokenomics,
        ngm:transaction-fee ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:blockchain ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:deflationary-token,
        ngm:governance-token,
        ngm:inflationary-token,
        ngm:supply-cap,
        ngm:token-economics ;
    vc:slug "native-token" ;
    vc:sourceDomain "blockchain" .

ngm:nav2 a owl:Class ;
    rdfs:label "Nav2"@en ;
    rdfs:comment "Nav2 (Navigation2) is the production-ready autonomous navigation framework for ROS 2, providing a composable, lifecycle-managed stack of planners, controllers, costmap layers, and behaviour-tree-based task orchestration. It enables mobile robots to safely compute and execute collision-free paths in structured and semi-structured environments."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ros-2 ],
        ngm:navigation-stack ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:autonomous-mobile-robots,
        ngm:autonomous-navigation ;
    vc:requires ngm:ros-2 ;
    vc:slug "nav2" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:behavior-tree,
        ngm:costmap .

ngm:net-zero-targets a owl:Class ;
    rdfs:label "Net Zero Targets"@en ;
    rdfs:comment "Net Zero Targets are formal, time-bound commitments made by governments, corporations, subnational jurisdictions, or other entities to reduce gross greenhouse gas emissions as deeply as feasible and to balance any residual emissions with equivalent, verified carbon removals, thereby reaching a net-zero contribution to atmospheric greenhouse gas concentrations by a specified date. They typically distinguish near-term absolute reduction milestones across Scope 1, 2, and 3 emissions from longer-term residual-offset strategies, and are calibrated against the IPCC's 1.5 °C-consistent pathways. Credible targets are characterised by transparent interim milestones, independent third-party verification, and a clear accounting boundary that separates genuine emission reductions from carbon offsetting."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:carbon-accounting ],
        ngm:climate-commitments ;
    vc:bridgesTo ngm:climate-risk-disclosure,
        ngm:esg-reporting ;
    vc:contrastsWith ngm:carbon-neutrality,
        ngm:climate-pledges ;
    vc:dependsOn ngm:energy-efficiency,
        ngm:renewable-energy,
        ngm:voluntary-carbon-market ;
    vc:enables ngm:climate-change-mitigation,
        ngm:green-finance,
        ngm:low-carbon-transition ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:climate-policy,
        ngm:sustainable-development ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:greenwashing,
        ngm:just-transition,
        ngm:nationally-determined-contributions,
        ngm:scope-3-emissions ;
    vc:requires ngm:carbon-accounting,
        ngm:greenhouse-gas-emissions,
        ngm:third-party-verification ;
    vc:slug "net-zero-targets" ;
    vc:sourceDomain "governance" ;
    vc:standardizedBy ngm:ifrs-sustainability-standards,
        ngm:paris-agreement,
        ngm:science-based-targets-initiative ;
    vc:uses ngm:carbon-offsetting,
        ngm:carbon-removal,
        ngm:science-based-targets .

ngm:network-function-virtualization a owl:Class ;
    rdfs:label "Network Function Virtualization"@en ;
    rdfs:comment "Network Function Virtualization (NFV) is an architectural paradigm that decouples network functions — such as firewalls, load balancers, intrusion detection systems, and routers — from dedicated proprietary hardware appliances and implements them as software running on commercial off-the-shelf (COTS) servers, switches, and storage. Standardised by ETSI's NFV Industry Specification Group, NFV introduces a three-layer model comprising the NFV Infrastructure (NFVI), Virtual Network Functions (VNFs), and the NFV Management and Orchestration (MANO) framework. By enabling elastic provisioning, rapid deployment, and lifecycle automation of network services, NFV reduces capital and operational expenditure while providing the flexibility required for 5G, edge computing, and cloud-native telecom architectures. It is closely related to and operationally complementary with Software-Defined Networking (SDN), which separates the network control plane from the data plane."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cloud-computing ],
        ngm:network-architecture ;
    vc:bridgesTo ngm:distributed-systems,
        ngm:edge-ai ;
    vc:contrastsWith ngm:network-appliance,
        ngm:proprietary-hardware ;
    vc:dependsOn ngm:commercial-off-the-shelf-hardware,
        ngm:software-defined-networking ;
    vc:enables ngm:edge-computing,
        ngm:network-scalability,
        ngm:network-slicing,
        ngm:service-function-chaining ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:nfv-infrastructure,
        ngm:nfv-mano,
        ngm:virtual-network-function ;
    vc:implements ngm:etsi-nfv-standard ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:cloud-native-network-function,
        ngm:software-defined-networking ;
    vc:requires ngm:cloud-computing,
        ngm:hypervisor,
        ngm:virtualisation ;
    vc:slug "network-function-virtualization" ;
    vc:sourceDomain "infrastructure" ;
    vc:standardizedBy ngm:etsi,
        ngm:ietf ;
    vc:supports ngm:5g-networks,
        ngm:telecom-cloud ;
    vc:uses ngm:container-orchestration,
        ngm:microservices-architecture,
        ngm:open-stack .

ngm:networking-infrastructure a owl:Class ;
    rdfs:label "Networking Infrastructure"@en ;
    rdfs:comment "Networking infrastructure comprises the integrated ensemble of physical hardware, logical protocols, and software-defined systems—including routers, switches, fibre optic links, wireless access points, content delivery networks (CDNs), edge nodes, load balancers, and DNS services—that collectively enable communication between computing systems across local, metropolitan, and wide-area scales. It forms the foundational substrate upon which distributed applications, cloud services, and real-time collaborative platforms depend, governing end-to-end latency, throughput, reliability, and security. Modern networking infrastructure increasingly incorporates software-defined networking (SDN), network function virtualisation (NFV), and programmable data planes that decouple control logic from physical forwarding hardware. For latency-sensitive domains such as spatial computing, extended reality, and distributed AI inference, infrastructure design must additionally satisfy stringent quality-of-service guarantees through traffic engineering, edge offloading, and geographically distributed state synchronisation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:quality-of-service ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:content-delivery-network ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:load-balancer ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:network-security ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:edge-computing ],
        ngm:infra-network-and-comms ;
    skos:broader ngm:infra-network-and-comms ;
    vc:bridgesTo ngm:ai-inference-infrastructure,
        ngm:decentralised-network ;
    vc:contrastsWith ngm:compute-infrastructure,
        ngm:storage-infrastructure ;
    vc:dependsOn ngm:bandwidth-adaptation,
        ngm:latency,
        ngm:network-protocol,
        ngm:optical-fibre ;
    vc:enables ngm:cloud-computing,
        ngm:distributed-systems,
        ngm:federated-learning,
        ngm:metaverse-infrastructure,
        ngm:realtime-communication ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:content-delivery-network,
        ngm:domain-name-system,
        ngm:edge-computing,
        ngm:load-balancer,
        ngm:network-function-virtualisation,
        ngm:software-defined-networking ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:5g-networks,
        ngm:network-topology ;
    vc:requires ngm:network-security,
        ngm:quality-of-service,
        ngm:traffic-engineering ;
    vc:slug "networking-infrastructure" ;
    vc:sourceDomain "infrastructure" ;
    vc:standardizedBy ngm:3gpp,
        ngm:ieee-802,
        ngm:ietf ;
    vc:supports ngm:autonomous-systems,
        ngm:internet-of-things,
        ngm:spatial-computing .

ngm:neural-network-component a owl:Class ;
    rdfs:label "Neural Network Component"@en ;
    rdfs:comment "A discrete structural or functional building block within a neural network model, including layers, activation functions, normalisation mechanisms, attention heads, and connection schemes. These components are composed to form complete neural network architectures and directly determine model capacity, training dynamics, and inference behaviour."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:positional-encoding ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:neural-network-layer ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:activation-function ],
