ngm:vision-transformer a owl:Class ;
    rdfs:label "Vision Transformer"@en ;
    rdfs:comment "The Vision Transformer (ViT) is a neural network architecture that applies the transformer self-attention mechanism directly to sequences of fixed-size image patches, treating each patch embedding as a token analogous to a word in natural-language processing. Introduced by Dosovitskiy et al. (2020), ViT demonstrated that pure attention-based models can match or exceed convolutional networks on image classification benchmarks when pre-trained on sufficiently large datasets."@en ;
    rdfs:subClassOf ngm:computer-vision ;
    vc:enables ngm:multimodal-learning ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.85"^^xsd:float ;
    vc:relatedTo ngm:contrastive-learning,
        ngm:convolutional-neural-network,
        ngm:diffusion-transformer ;
    vc:slug "vision-transformer" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:attention-mechanism .

ngm:visual-inertial-odometry a owl:Class ;
    rdfs:label "Visual-Inertial Odometry"@en ;
    rdfs:comment "Visual-inertial odometry (VIO) is a technique that estimates a device's six-degree-of-freedom motion and pose by fusing camera imagery with inertial measurement unit data. The complementary fusion compensates for the drift of inertial sensors and the scale ambiguity of monocular vision, yielding robust, low-latency tracking. VIO underpins inside-out tracking for mixed-reality headsets, drones and mobile robots."@en ;
    rdfs:subClassOf ngm:robo-navigation-and-planning ;
    skos:broader ngm:robo-navigation-and-planning ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:mixed-reality ;
    vc:slug "visual-inertial-odometry" ;
    vc:sourceDomain "robotics" .

ngm:visual-place-recognition a owl:Class ;
    rdfs:label "Visual Place Recognition"@en ;
    rdfs:comment "Visual place recognition (VPR) is the task of identifying whether a currently observed scene corresponds to a previously visited location by matching image content against a database of geotagged or topologically indexed images. It underpins loop closure in SLAM and global re-localisation for autonomous systems, relying on appearance- and condition-invariant descriptors. Robustness to viewpoint, illumination, and seasonal change is the central research challenge."@en ;
    rdfs:subClassOf ngm:robo-perception ;
    skos:broader ngm:robo-perception ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:topological-map,
        ngm:visual-slam ;
    vc:slug "visual-place-recognition" ;
    vc:sourceDomain "robotics" .

ngm:vocabulary a owl:Class ;
    rdfs:label "Vocabulary"@en ;
    rdfs:comment "The complete set of unique tokens in a language model's tokenisation scheme, typically ranging from 32,000 to 128,000 entries in modern architectures. Vocabulary size directly governs embedding matrix dimensions, output layer size, and token-level granularity, with larger vocabularies improving expressiveness and training efficiency at the cost of increased memory during inference."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:tokenisation ],
        ngm:sc-standards-and-interop ;
    skos:broader ngm:sc-standards-and-interop ;
    vc:enables ngm:inference,
        ngm:natural-language-processing ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:transformer ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires ngm:tokenisation ;
    vc:slug "vocabulary" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:byte-pair-encoding,
        ngm:subword-tokenisation,
        ngm:word-piece .

ngm:vote-escrow a owl:Class ;
    rdfs:label "Vote Escrow"@en ;
    rdfs:comment "Vote escrow (ve) is a tokenomics mechanism in which holders lock governance tokens for a chosen duration in exchange for non-transferable, time-decaying voting power and often boosted protocol rewards. Popularised by Curve's veCRV model, it aligns voter incentives with long-term protocol health by rewarding commitment over short-term speculation. Locked positions decay linearly to zero at unlock, requiring periodic re-locking to maintain influence."@en ;
    rdfs:subClassOf ngm:bc-defi-and-economics ;
    skos:broader ngm:bc-defi-and-economics ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:on-chain-voting,
        ngm:tokenomics-governance ;
    vc:slug "vote-escrow" ;
    vc:sourceDomain "blockchain" .

ngm:voting-round a owl:Class ;
    rdfs:label "Voting Round"@en ;
    rdfs:comment "A voting round is a discrete phase within a Byzantine fault-tolerant consensus protocol during which participating nodes exchange and tally votes on a proposed value or block. Multi-round protocols such as PBFT and Tendermint progress through prepare, pre-commit, and commit rounds to achieve agreement despite faulty or malicious participants. The round abstraction provides liveness via view changes and safety via supermajority thresholds."@en ;
    rdfs:subClassOf ngm:consensus-protocol ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:byzantine-fault-tolerance,
        ngm:consensus-mechanism ;
    vc:slug "voting-round" ;
    vc:sourceDomain "blockchain" .

ngm:vr-psychology a owl:Class ;
    rdfs:label "VR Psychology"@en ;
    rdfs:comment "VR Psychology is the scientific study of how virtual reality environments affect human cognition, perception, emotion, behaviour, and wellbeing. It encompasses research into presence, embodiment, cybersickness, avatar effects, and therapeutic applications of immersive virtual environments, informing the design of XR systems that are psychologically safe and effective."@en ;
    rdfs:subClassOf ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:relatedTo ngm:cognitive-science,
        ngm:haptic-feedback,
        ngm:presence,
        ngm:user-experience ;
    vc:slug "vr-psychology" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:immersion,
        ngm:virtual-reality .

ngm:vulkan a owl:Class ;
    rdfs:label "Vulkan"@en ;
    rdfs:comment "Vulkan is a low-overhead, cross-platform graphics and compute API developed by the Khronos Group and released in 2016 as the successor to OpenGL, designed to give developers explicit control over GPU resources including memory allocation, synchronisation, command buffer submission, and render pass configuration in order to minimise CPU overhead and achieve predictable, high-performance rendering across diverse hardware. Vulkan operates closer to metal than its predecessor: applications manage their own memory pools, pipeline state objects, descriptor sets, and queue families, while the driver's role is reduced to translating API calls into hardware commands with minimal hidden magic. Vulkan shaders are compiled to SPIR-V, a portable intermediate representation, enabling shader code authored in GLSL or HLSL to execute on any conforming GPU without driver-side shader compilation."@en ;
    rdfs:subClassOf ngm:graphics-api ;
    vc:enables ngm:gpu-compute,
        ngm:real-time-rendering,
        ngm:real-time-rendering-pipeline ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:compute-shader,
        ngm:open-xr,
        ngm:rendering-pipeline,
        ngm:shader ;
    vc:slug "vulkan" ;
    vc:sourceDomain "graphics" ;
    vc:uses ngm:gpu-computing,
        ngm:shader-language .

ngm:w-3-c-vocabulary a owl:Class ;
    rdfs:label "W3C Vocabulary"@en ;
    rdfs:comment "A vocabulary published by the World Wide Web Consortium (W3C). The specific vocabulary is not determined from the identifier alone."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:w3-c ],
        ngm:technical-standard ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:w3-c ;
    vc:slug "w-3-c-vocabulary" ;
    vc:sourceDomain "standards" .

ngm:w3-c-did a owl:Class ;
    rdfs:label "W3C DID"@en ;
    rdfs:comment "W3C DID (Decentralised Identifier) is a W3C Recommendation standard (published July 2022) that defines a new type of globally unique, persistent, and cryptographically verifiable identifier that does not require a centralised registration authority. A DID resolves to a DID Document — a JSON-LD data structure containing public keys, authentication mechanisms, and service endpoints — enabling the DID subject to prove control and establish secure communication without depending on a third-party identity provider. DIDs are the foundational primitive for self-sovereign identity systems."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:did-document ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:decentralized-identifiers ],
        ngm:w3-c-did-core ;
    vc:enables ngm:authentication,
        ngm:decentralised-trust,
        ngm:digital-identity-management ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:decentralized-identifiers,
        ngm:did-document ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:decentralized-identity,
        ngm:public-key-infrastructure,
        ngm:trust-over-ip-stack,
        ngm:w3-c-verifiable-credentials ;
    vc:slug "w3-c-did" ;
    vc:sourceDomain "governance" .

ngm:web-authn a owl:Class ;
    rdfs:label "WebAuthn"@en ;
    rdfs:comment "WebAuthn (Web Authentication) is a W3C and FIDO Alliance standard that enables web applications to authenticate users using public-key cryptography rather than passwords, through hardware or software authenticators such as security keys, platform biometrics, and passkeys. The browser exposes the navigator.credentials API, which delegates cryptographic operations to a CTAP-compliant authenticator; the authenticator generates a key pair, stores the private key in a secure enclave, and signs authentication challenges that the relying party verifies using the registered public key. WebAuthn eliminates shared secrets from the authentication path, making phishing, credential stuffing, and replay attacks fundamentally impossible by design. It is the technical foundation of the passkey ecosystem deployed by Apple, Google, and Microsoft."@en ;
    rdfs:subClassOf ngm:authentication-mechanism ;
    vc:enables ngm:multi-factor-authentication,
        ngm:passwordless-authentication,
        ngm:privacy-preserving-authentication ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:credential-verification,
        ngm:digital-identity,
        ngm:w3-c,
        ngm:web-standard ;
    vc:slug "web-authn" ;
    vc:sourceDomain "security" ;
    vc:uses ngm:asymmetric-encryption,
        ngm:fido2,
        ngm:public-key-cryptography .

ngm:web-standards a owl:Class ;
    rdfs:label "Web Standards"@en ;
    rdfs:comment "Web Standards is a spatial computing concept."@en ;
    rdfs:subClassOf ngm:sc-standards-and-interop ;
    skos:broader ngm:sc-standards-and-interop ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:implements ngm:spatial-computing ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:slug "web-standards" ;
    vc:sourceDomain "spatial-computing" .

ngm:web-xr-api a owl:Class ;
    rdfs:label "WebXR API"@en ;
    rdfs:comment "A W3C web standard providing browser-native interfaces for rendering stereoscopic 3D content and handling spatial input from XR headsets and controllers, enabling AR/VR experiences without native application installation. WebXR supersedes the earlier WebVR specification and is implemented across Chromium-based browsers and Firefox."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:xr-hardware ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:xr-headset ],
        ngm:sc-standards-and-interop ;
    skos:broader ngm:sc-standards-and-interop ;
    vc:enables ngm:augmented-reality,
        ngm:spatial-computing,
        ngm:virtual-reality ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:interoperability ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:xr-hardware,
        ngm:xr-headset ;
    vc:slug "web-xr-api" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:web-technology .

ngm:wikidata a owl:Class ;
    rdfs:label "Wikidata"@en ;
    rdfs:comment "Wikidata is a free, collaboratively edited knowledge base operated by the Wikimedia Foundation that stores structured data as machine-readable items and statements, serving as a central data repository for Wikipedia and the broader web. Each item has a stable identifier and is described by property-value statements with references and qualifiers, exported as linked data and queryable via SPARQL. Multilingual by design and released under a public-domain licence, Wikidata is one of the largest open knowledge graphs and a key hub in the linked-data web."@en ;
    rdfs:subClassOf ngm:knowledge-graph ;
    vc:enables ngm:semantic-web ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:ontology,
        ngm:semantic-search ;
    vc:slug "wikidata" ;
    vc:sourceDomain "knowledge" ;
    vc:uses ngm:linked-data,
        ngm:rdf .

ngm:wireless-connectivity a owl:Class ;
    rdfs:label "Wireless Connectivity"@en ;
    rdfs:comment "Wireless connectivity is the transmission of data between devices over radio frequencies without physical cabling. It spans short-range links such as Wi-Fi and Bluetooth and wide-area mobile networks such as 5G."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:communication-protocol ],
        ngm:communication-protocol ;
    vc:enables ngm:internet-of-things,
        ngm:real-time-communication ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:communication-protocol ;
    vc:slug "wireless-connectivity" ;
    vc:sourceDomain "networking" .

ngm:workforce-development a owl:Class ;
    rdfs:label "Workforce Development"@en ;
    rdfs:comment "Workforce development encompasses structured programmes, training environments, and skills-acquisition systems that equip individuals and organisations with the competencies required by evolving labour markets. In spatial computing contexts, it leverages immersive learning, simulation, and augmented connected workforce platforms to deliver scalable, experiential upskilling."@en ;
    rdfs:subClassOf ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:dependsOn ngm:education-technology,
        ngm:virtual-reality ;
    vc:enables ngm:augmented-connected-workforce,
        ngm:education-metaverse ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:slug "workforce-development" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:immersive-learning,
        ngm:simulation .

ngm:yield-generation a owl:Class ;
    rdfs:label "Yield Generation"@en ;
    rdfs:comment "Yield generation in the context of decentralised finance (DeFi) refers to the set of mechanisms by which cryptocurrency holders earn returns on their assets by deploying them into productive on-chain activities — including liquidity provision to automated market makers, lending on money market protocols, staking in proof-of-stake consensus, and participating in yield optimisation vaults — thereby converting idle digital assets into income-generating positions. Yield is typically expressed as an annualised percentage rate (APR) or annual percentage yield (APY) and derives from trading fees, interest payments from borrowers, block rewards, and protocol token emissions. Yield generation is a core economic primitive of DeFi, enabling capital efficiency but also introducing smart contract, liquidation, and impermanent loss risks."@en ;
    rdfs:subClassOf ngm:de-fi ;
    vc:enables ngm:decentralized-finance-de-fi,
        ngm:liquidity-mining ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:digital-asset-lending,
        ngm:liquidity-pool,
        ngm:liquidity-provision,
        ngm:yield-farming ;
    vc:slug "yield-generation" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:automated-market-maker,
        ngm:proof-of-stake,
        ngm:smart-contract .

ngm:zero-shot-prompting a owl:Class ;
    rdfs:label "Zero-Shot Prompting"@en ;
    rdfs:comment "Zero-shot prompting is the technique of instructing a language model to perform a task using only a description, without providing worked examples. It relies on knowledge the model acquired during pretraining."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:language-model ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:prompt-engineering ],
        ngm:prompt-engineering ;
    vc:enables ngm:in-context-learning ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:language-model,
        ngm:prompt-engineering ;
    vc:slug "zero-shot-prompting" ;
    vc:sourceDomain "natural-language-processing" .

ngm:zk-snark a owl:Class ;
    rdfs:label "ZK-SNARK"@en ;
    rdfs:comment "A Zero-Knowledge Succinct Non-Interactive Argument of Knowledge is a proof that a statement is true while revealing nothing else, producing a small proof that is fast to verify."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:elliptic-curve-cryptography ],
        ngm:zero-knowledge-proof ;
    vc:enables ngm:groth-16 ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:elliptic-curve-cryptography ;
    vc:slug "zk-snark" ;
    vc:sourceDomain "cryptographic" .

ngm:3-d-modeling-software a owl:Class ;
    rdfs:label "3D Modeling Software"@en ;
    rdfs:comment "3D Modeling Software is a category of applications that provide tools for constructing, editing, and organising three-dimensional geometric representations of objects and scenes, typically via polygon mesh editing, subdivision surfaces, NURBS curves, sculpting, or parametric operations. These applications underpin virtually all digital content creation workflows for games, film, architecture, product design, and XR environments. They commonly integrate texturing, rigging, animation, and basic rendering capabilities alongside the core modelling toolkit."@en ;
    rdfs:subClassOf ngm:3-d-modeling ;
    vc:enables ngm:3-d-asset,
        ngm:3-d-content-creation,
        ngm:animation-rig ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:bim-software,
        ngm:cad-software,
        ngm:game-engine ;
    vc:slug "3-d-modeling-software" ;
    vc:sourceDomain "spatial" ;
    vc:uses ngm:3-d-file-format,
        ngm:physically-based-rendering,
        ngm:shader .

ngm:3-d-perception a owl:Class ;
    rdfs:label "3D Perception"@en ;
    rdfs:comment "3D Perception is the computational capability to interpret sensor data — from cameras, LiDAR, radar, and depth sensors — and derive accurate three-dimensional understanding of the surrounding environment, including object detection, pose estimation, scene structure, and semantic labelling. It forms a foundational layer for autonomous systems, robotic manipulation, augmented reality registration, and spatial computing. The discipline draws on computer vision, geometry, and deep learning to transform raw observations into actionable 3D representations."@en ;
    rdfs:subClassOf ngm:computer-vision ;
    vc:enables ngm:6-do-f-tracking,
        ngm:object-detection,
        ngm:simultaneous-localisation-and-mapping ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:3-d-scanning,
        ngm:pose-estimation,
        ngm:semantic-segmentation ;
    vc:slug "3-d-perception" ;
    vc:sourceDomain "spatial" ;
    vc:uses ngm:depth-sensing,
        ngm:point-cloud,
        ngm:sensor-fusion .

ngm:3-d-scene-reconstruction a owl:Class ;
    rdfs:label "3D Scene Reconstruction"@en ;
    rdfs:comment "3D Scene Reconstruction is the computational process of recovering a complete, coherent three-dimensional model of an environment or scene from sensor observations such as images, depth maps, or LiDAR returns, integrating multiple viewpoints and modalities into a unified representation. Methods include volumetric fusion, truncated signed distance function (TSDF) integration, neural implicit representations, and Gaussian splatting, each offering different trade-offs between completeness, accuracy, and real-time capability. The output is used in robotics, autonomous driving, spatial computing, and cultural heritage documentation."@en ;
    rdfs:subClassOf ngm:3-d-reconstruction ;
    vc:enables ngm:3-d-perception,
        ngm:ar-registration,
        ngm:digital-twin-creation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:3-d-scanning,
        ngm:gaussian-splatting,
        ngm:ne-rf ;
    vc:slug "3-d-scene-reconstruction" ;
    vc:sourceDomain "spatial" ;
    vc:uses ngm:multi-view-stereo,
        ngm:simultaneous-localisation-and-mapping,
        ngm:structure-from-motion .

ngm:3-d-user-interface a owl:Class ;
    rdfs:label "3D User Interface"@en ;
    rdfs:comment "A 3D User Interface (3DUI) is an interactive control system within three-dimensional virtual environments enabling users to manipulate objects, navigate spaces, and access functionality through spatial gestures, hand tracking, gaze-based selection, and voice commands."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:haptic-feedback ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:hand-tracking ],
        ngm:interaction-design,
        ngm:sc-interaction,
        ngm:user-interface ;
    skos:broader ngm:sc-interaction ;
    vc:enables ngm:accessible-immersion,
        ngm:intuitive-interaction,
        ngm:user-navigation ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires ngm:gaze-tracking,
        ngm:hand-tracking,
        ngm:haptic-feedback,
        ngm:voice-input ;
    vc:slug "3-d-user-interface" ;
    vc:sourceDomain "spatial-computing" .

ngm:3-gpp a owl:Class ;
    rdfs:label "3GPP"@en ;
    rdfs:comment "The 3rd Generation Partnership Project (3GPP) is a global consortium of telecommunications standards bodies that develops and maintains the technical specifications governing mobile communication systems, from UMTS (3G) through LTE (4G) to NR (5G) and the emerging 6G framework. It operates through working groups that produce versioned Releases, each introducing new capabilities and radio access technologies. 3GPP specifications are the foundational technical substrate for the global cellular infrastructure used by billions of devices."@en ;
    rdfs:subClassOf ngm:standards-body ;
    vc:enables ngm:internet-of-things,
        ngm:multi-access-edge-computing,
        ngm:network-function-virtualization ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:etsi,
        ngm:network-architecture,
        ngm:telecommunications ;
    vc:slug "3-gpp" ;
    vc:sourceDomain "infrastructure" ;
    vc:standardizedBy ngm:5-g-connectivity,
        ngm:5-g-network .

ngm:6-do-f-tracking a owl:Class ;
    rdfs:label "6DoF Tracking"@en ;
    rdfs:comment "6DoF (Six Degrees of Freedom) Tracking is the measurement and continuous estimation of an object's complete rigid-body pose in three-dimensional space, encompassing three translational components (x, y, z position) and three rotational components (pitch, yaw, roll orientation). It is the foundational capability for XR headsets, controllers, and spatial computing devices to understand and respond to the user's physical motion with sub-millimetre accuracy and minimal latency. 6DoF tracking is achieved through sensor fusion of inertial measurement units, camera-based visual odometry, and optionally external beacons or reference markers."@en ;
    rdfs:subClassOf ngm:simultaneous-localisation-and-mapping ;
    vc:enables ngm:3-d-perception,
        ngm:ar-registration,
        ngm:xr-applications ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:camera-tracking,
        ngm:depth-sensing,
        ngm:pose-estimation ;
    vc:slug "6-do-f-tracking" ;
    vc:sourceDomain "spatial" ;
    vc:uses ngm:imu,
        ngm:sensor-fusion,
        ngm:simultaneous-localisation-and-mapping .

ngm:accessible-experience a owl:Class ;
    rdfs:label "Accessible Experience"@en ;
    rdfs:comment "An Accessible Experience is a virtual environment or application delivering equivalent functionality and engagement to users with disabilities through multimodal access pathways, assistive technology integration, and Accessible Design principles."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:assistive-technology-support ],
        ngm:sc-governance-and-safety,
        ngm:sc-interaction,
        ngm:user-experience ;
    skos:broader ngm:sc-governance-and-safety,
        ngm:sc-interaction ;
    vc:enables ngm:equitable-engagement,
        ngm:inclusive-participation,
        ngm:universal-access ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires ngm:alternative-input-methods,
        ngm:assistive-technology-support,
        ngm:multimodal-interfaces ;
    vc:slug "accessible-experience" ;
    vc:sourceDomain "spatial-computing" .

ngm:account-model a owl:Class ;
    rdfs:label "Account Model"@en ;
    rdfs:comment "The Account Model is a balance-based ledger paradigm in which each address maintains a persistent balance that is updated in-place when transactions execute. Unlike the UTXO model, accounts hold state across transactions, simplifying smart contract programming while introducing challenges around replay protection and nonce management."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:wallet ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:transaction ],
        ngm:bc-protocol-and-consensus,
        ngm:blockchain-entity,
        ngm:distributed-data-structure ;
    skos:broader ngm:bc-protocol-and-consensus ;
    vc:contrastsWith ngm:utxo-model ;
    vc:enables ngm:smart-contract,
        ngm:transaction-processing ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:blockchain ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:blockchain-network,
        ngm:blockchain-transaction,
        ngm:cryptographic-keys,
        ngm:double-spending,
        ngm:transaction-fee ;
    vc:requires ngm:transaction,
        ngm:wallet ;
    vc:slug "account-model" ;
    vc:sourceDomain "blockchain" .

ngm:accountability-framework a owl:Class ;
    rdfs:label "Accountability Framework"@en ;
    rdfs:comment "An accountability framework is a structured set of principles, roles, processes, and controls that together define how responsibility for outcomes is assigned, tracked, and enforced within an organisation or system. It specifies who is answerable for decisions and actions, what evidence of responsible conduct must be maintained, and what redress or corrective measures apply when obligations are unmet. Accountability frameworks appear across governance, AI ethics, financial regulation, and public sector administration."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:audit ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:transparency ],
        ngm:governance-framework ;
    vc:enables ngm:accountability-mechanism,
        ngm:compliance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:accountability,
        ngm:regulatory-framework ;
    vc:requires ngm:audit,
        ngm:transparency ;
    vc:slug "accountability-framework" ;
    vc:sourceDomain "governance" .

ngm:action-space a owl:Class ;
    rdfs:label "Action Space"@en ;
    rdfs:comment "The action space in reinforcement learning and control theory is the complete set of actions available to an agent at any given decision step, defining the boundaries of what the agent may do when interacting with its environment. It may be discrete—a finite enumeration of choices—or continuous—a real-valued manifold such as joint torques or steering angles—and its structure fundamentally determines which learning algorithms are applicable and how efficiently a policy can be discovered."@en ;
    rdfs:subClassOf ngm:state-space ;
    vc:dependsOn ngm:environment-model ;
    vc:enables ngm:policy-optimisation,
        ngm:reinforcement-learning-algorithm ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:reinforcement-learning,
        ngm:reward-function ;
    vc:slug "action-space" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:reinforcement-learning-for-robotics .

ngm:admittance-control a owl:Class ;
    rdfs:label "Admittance Control"@en ;
    rdfs:comment "Force control strategy where robotic systems respond to external forces by producing proportional motion governed by virtual admittance parameters (mass, damping, stiffness), enabling compliant physical interaction with uncertain or variable environments by regulating position/velocity trajectori..."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:kinematic-model ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:dynamic-model ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:real-time-control-loop ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:force-torque-sensor ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:inverse-kinematics ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:force-sensor ],
        ngm:compliance-control,
        ngm:force-control,
        ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:enables ngm:adaptive-manipulation,
        ngm:compliant-motion,
        ngm:contact-based-assembly,
        ngm:delicate-handling,
        ngm:force-limited-operation,
        ngm:safe-human-robot-interaction ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:admittance-transfer-function,
        ngm:force-sensor,
        ngm:inverse-kinematics,
        ngm:parameter-tuning,
        ngm:position-controller,
        ngm:virtual-mechanical-system ;
    vc:implements ngm:compliant-trajectory-generation,
        ngm:force-to-motion-mapping,
        ngm:second-order-mechanical-system,
        ngm:virtual-damper-spring-mass ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires ngm:dynamic-model,
        ngm:force-torque-sensor,
        ngm:kinematic-model,
        ngm:position-controlled-robot,
        ngm:real-time-control-loop ;
    vc:slug "admittance-control" ;
    vc:sourceDomain "robotics" .

ngm:advertising-and-marketing a owl:Class ;
    rdfs:label "Advertising and Marketing"@en ;
    rdfs:comment "Advertising and marketing is the combined domain of commercial practices concerned with identifying customer needs, developing products and services to meet them, communicating value propositions to target audiences through paid and unpaid channels, and building lasting brand relationships. Marketing encompasses the strategic disciplines of market research, product development, pricing, distribution, and communications, while advertising is the paid communications subset of the marketing mix. Together they constitute the primary commercial mechanism by which organisations acquire customers and generate revenue in market economies."@en ;
    rdfs:subClassOf ngm:digital-marketing ;
    vc:enables ngm:advertising,
        ngm:programmatic-advertising ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:customer-experience,
        ngm:data-privacy ;
    vc:slug "advertising-and-marketing" ;
    vc:sourceDomain "media" ;
    vc:uses ngm:behavioral-analytics,
        ngm:predictive-analytics,
        ngm:recommendation-engine .

ngm:affective-computing a owl:Class ;
    rdfs:label "Affective Computing"@en ;
    rdfs:comment "Affective computing is a branch of artificial intelligence and human-computer interaction concerned with systems that can recognise, interpret, process, and simulate human emotions and affective states. It draws on psychology, cognitive science, and machine learning to endow machines with emotional intelligence, enabling them to adapt their behaviour in response to detected user affect. The field encompasses technologies for emotion detection from facial expressions, speech, physiological signals, and body language, as well as methods for generating emotionally congruent responses."@en ;
    rdfs:subClassOf ngm:human-computer-interaction ;
    vc:enables ngm:cognitive-feedback-interface,
        ngm:emotion-aware-interaction,
        ngm:emotional-analytics-engine ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:cognitive-science,
        ngm:emotional-intelligence ;
    vc:slug "affective-computing" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:computer-vision,
        ngm:deep-learning,
        ngm:natural-language-processing,
        ngm:sentiment-analysis .

ngm:agent-based-modelling a owl:Class ;
    rdfs:label "Agent-Based Modelling"@en ;
    rdfs:comment "Agent-based modelling is a simulation method in which many autonomous agents follow local rules and their interactions produce system-level behaviour. It is used to study emergent phenomena that are hard to capture with aggregate equations."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:simulation ],
        ngm:simulation ;
    vc:enables ngm:innovation-diffusion ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:simulation ;
    vc:slug "agent-based-modelling" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:agent-to-agent-protocol a owl:Class ;
    rdfs:label "Agent-to-Agent Protocol"@en ;
    rdfs:comment "Agent-to-Agent Protocol is a class of communication specifications that define how autonomous AI agents discover one another, advertise capabilities, delegate tasks, and exchange results directly — without requiring a centralised broker — enabling peer-to-peer coordination between agents built by different organisations or on different frameworks. These protocols treat agents as first-class addressable entities with discoverable skill sets and negotiable service contracts."@en ;
    rdfs:subClassOf ngm:agent-communication-protocol ;
    vc:enables ngm:agentic-workflow,
        ngm:inter-agent-communication ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:agent2-agent-protocol-google-2025,
        ngm:model-context-protocol ;
    vc:slug "agent-to-agent-protocol" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:message-passing,
        ngm:service-discovery .

ngm:agent2-agent-protocol a owl:Class ;
    rdfs:label "Agent2Agent Protocol"@en ;
    rdfs:comment "Agent2Agent Protocol (A2A) is an open specification developed by Google and partner organisations that enables heterogeneous AI agents to discover, communicate, and collaborate across organisational and platform boundaries. It defines a standardised messaging envelope, capability advertisement mechanism, and task-delegation schema so that agents built on different frameworks — such as LangChain, CrewAI, or custom enterprise systems — can interoperate without bespoke integration code. The protocol operates over HTTPS with JSON-RPC 2.0 and supports both synchronous request-response and asynchronous streaming via Server-Sent Events. Agent capability cards, analogous to service discovery manifests, allow an agent to advertise its skills so that orchestrating agents can route work appropriately."@en ;
    rdfs:subClassOf ngm:communication-protocol ;
    vc:bridgesTo ngm:interoperability-protocol ;
    vc:enables ngm:agentic-workflow,
        ngm:orchestration ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:agent-event-stream,
        ngm:multi-agent-systems,
        ngm:server-sent-events ;
    vc:slug "agent2-agent-protocol" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:model-context-protocol,
        ngm:rest-api .

ngm:agricultural-robotics a owl:Class ;
    rdfs:label "Agricultural Robotics"@en ;
    rdfs:comment "Agricultural robotics is the application of autonomous and semi-autonomous robotic systems to farming operations including soil preparation, precision planting, selective harvesting, crop health monitoring, and livestock management. Agricultural robots leverage computer vision, GPS positioning, and machine learning to operate in unstructured outdoor environments, adapting to variable terrain, crop geometry, and weather conditions. The field addresses labour shortages, resource efficiency, and the precision-agriculture imperative to reduce agrochemical inputs while maintaining or improving yields."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:object-detection ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:autonomous-navigation ],
        ngm:robo-robot-type ;
    skos:broader ngm:robo-robot-type ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:autonomous-robot ;
    vc:requires ngm:autonomous-navigation,
        ngm:object-detection ;
    vc:slug "agricultural-robotics" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:computer-vision,
        ngm:gps .

ngm:ai-accountability a owl:Class ;
    rdfs:label "AI Accountability"@en ;
    rdfs:comment "AI Accountability is the set of mechanisms, obligations, and institutional structures that ensure developers, deployers, and operators of AI systems can be held responsible for the outcomes those systems produce. It encompasses technical auditability, legal liability, organisational governance, and redress pathways for harms caused by algorithmic decisions. Accountability frameworks bind technical transparency measures to enforceable consequences, distinguishing it from voluntary explainability efforts. Effective AI accountability requires clear assignment of responsibility across the AI value chain—from data collection through deployment and monitoring."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:explainability ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
