ngm:nlptask a owl:Class ;
    rdfs:label "NLPTask"@en ;
    rdfs:comment "NLP tasks are the canonical computational problems that define the scope of natural language processing: text classification, sentiment analysis, named entity recognition, machine translation, text summarisation, and question answering. Each task specifies an input-output contract over human language and serves as a benchmark for evaluating model capability. Transformer-based architectures such as BERT and GPT have become the dominant approach across nearly all NLP tasks, replacing earlier feature-engineering and statistical methods with pre-trained, fine-tunable representations."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:question-answering ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:named-entity-recognition ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:sentiment-analysis ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:machine-translation ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:text-generation ],
        ngm:infra-computing-and-cloud ;
    skos:broader ngm:infra-computing-and-cloud ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:machine-translation,
        ngm:named-entity-recognition,
        ngm:question-answering,
        ngm:sentiment-analysis,
        ngm:text-generation ;
    vc:isPartOf ngm:natural-language-processing ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:fine-tuning,
        ngm:gpt,
        ngm:machine-learning-discipline,
        ngm:transfer-learning ;
    vc:slug "nlptask" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:attention-mechanism,
        ngm:deep-learning,
        ngm:tokenization,
        ngm:transformer .

