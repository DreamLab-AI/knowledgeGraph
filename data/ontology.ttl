ngm:local-rag-corpus-ingestion-pipeline a owl:Class ;
    rdfs:comment "Push To Local RAG is a data-pipeline operation that extracts, cleans, and concatenates Logseq markdown pages—filtering out short or low-quality documents—then writes the result to a single corpus file consumed by a local Retrieval-Augmented Generation system. The process involves URL stripping, special-character normalisation, whitespace normalisation, and a minimum byte-length threshold, producing a curated text corpus that improves retrieval precision for local LLM inference without sending data to external services."@en ;
    rdfs:label "Local RAG Corpus Ingestion Pipeline"@en ;
    rdfs:subClassOf ngm:ai-application ;
    skos:broader ngm:ai-application ;
