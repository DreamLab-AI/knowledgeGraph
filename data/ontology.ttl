        ngm:scope-2-emissions,
        ngm:scope-3-emissions ;
    vc:implements ngm:corporate-sustainability-reporting ;
    vc:isPartOf ngm:carbon-accounting ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:cdp-reporting,
        ngm:eu-csrd,
        ngm:net-zero-transition,
        ngm:tcfd ;
    vc:requires ngm:emissions-factor,
        ngm:greenhouse-gas-inventory ;
