ngm:data-acquisition a skos:Concept ;
    rdfs:label "Data Acquisition"@en .

ngm:data-broker a skos:Concept ;
    rdfs:label "Data Broker"@en .

ngm:data-brokers a owl:Class ;
    rdfs:label "Data Brokers"@en ;
    rdfs:comment "Data brokers are firms that collect, aggregate, enrich and resell personal and behavioural data about individuals, typically without a direct relationship with those individuals. They assemble profiles from public records, online tracking and commercial sources for marketing, scoring and risk uses. They are a focal point of privacy regulation and surveillance concern because their trade can enable pervasive monitoring and profiling."@en ;
    rdfs:subClassOf ngm:data-management ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:digital-society-surveillance ;
    vc:slug "data-brokers" ;
    vc:sourceDomain "governance" .

ngm:data-catalogue a skos:Concept ;
    rdfs:label "Data Catalogue"@en .

ngm:data-centre-infrastructure a skos:Concept ;
    rdfs:label "Data Centre Infrastructure"@en .

ngm:data-confidentiality a owl:Class ;
    rdfs:label "Data Confidentiality"@en ;
    rdfs:comment "The property that data is accessible only to those authorised to view it, protecting information from disclosure to unauthorised parties. It is one of the core objectives of information security."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptography ],
        ngm:information-security ;
    vc:enables ngm:privacy ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:cryptography ;
    vc:slug "data-confidentiality" ;
    vc:sourceDomain "security" .

ngm:data-consistency a owl:Class ;
    rdfs:label "Data Consistency"@en ;
    rdfs:comment "Data consistency is the guarantee that data remains valid, coherent and in agreement across copies, transactions and nodes of a system. In distributed systems it spans a spectrum from strong consistency, where all readers observe the latest write, to eventual consistency, where replicas converge over time. It is a core correctness property traded off against availability and latency, and it underpins fault-tolerant data layers."@en ;
    rdfs:subClassOf ngm:distributed-systems ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:data-layer,
        ngm:fault-tolerance ;
    vc:slug "data-consistency" ;
    vc:sourceDomain "infrastructure" .

ngm:data-drift a skos:Concept ;
    rdfs:label "Data Drift"@en .

ngm:data-fabric-architecture a owl:Class ;
    rdfs:label "Data Fabric Architecture"@en ;
    rdfs:comment "An integrated data-management architecture that provides unified access, governance, security, and orchestration across distributed and heterogeneous data sources through active metadata management, automated data integration, and policy-driven controls."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
