    vc:qualityScore "0.5"^^xsd:float ;
    vc:relatedTo ngm:robot-dynamics,
        ngm:state-estimation ;
    vc:requires ngm:collision-avoidance,
        ngm:sensor-fusion ;
    vc:slug "robot-safety" ;
    vc:sourceDomain "robotics" .

ngm:selective-disclosure a owl:Class ;
    rdfs:label "Selective Disclosure"@en ;
    rdfs:comment "Selective disclosure is a cryptographic capability that allows the holder of a verifiable credential to present only a chosen subset of the credential's claims to a verifier, without the verifier being able to learn anything about the undisclosed fields and without requiring re-issuance of a new credential by the issuer. It is implemented through cryptographic mechanisms such as BBS+ signatures, SD-JWT, and zero-knowledge proofs, and is a core design goal of the W3C Verifiable Credentials standard and decentralised identity architectures that aim to minimise unnecessary personal data exposure."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:verifiable-credentials ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:zero-knowledge-proof ],
        ngm:bc-cryptographic-primitive ;
    skos:broader ngm:bc-cryptographic-primitive ;
    vc:enables ngm:decentralised-identity,
        ngm:privacy-preserving-technology ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:credential-format-standard ;
    vc:requires ngm:verifiable-credentials,
        ngm:zero-knowledge-proof ;
    vc:slug "selective-disclosure" ;
    vc:sourceDomain "blockchain" .

ngm:smart-contract-execution a owl:Class ;
    rdfs:label "Smart Contract Execution"@en ;
    rdfs:comment "Smart contract execution is the deterministic, on-chain processing of immutable bytecode deployed at a blockchain address, triggered by an inbound transaction and evaluated by every validating node in the network. Execution occurs inside a sandboxed virtual machine—such as the Ethereum Virtual Machine (EVM)—which enforces gas metering to bound computation costs, ensures state isolation, and guarantees identical outputs across all nodes given the same inputs. Because execution is transparent and auditable, smart contracts can automate trustless multi-party agreements including token transfers, DeFi protocol logic, decentralised governance, and RWA settlement without relying on a central intermediary."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gas ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:consensus-mechanism ],
        ngm:bc-protocol-and-consensus ;
    skos:broader ngm:bc-protocol-and-consensus ;
    vc:enables ngm:decentralised-finance ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:requires ngm:consensus-mechanism,
        ngm:gas ;
    vc:slug "smart-contract-execution" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:blockchain-transaction,
        ngm:smart-contract .

ngm:software-architecture a owl:Class ;
    rdfs:label "Software Architecture"@en ;
    rdfs:comment "Software Architecture for AI systems defines high-level structural patterns, component interactions, and design principles for building scalable, maintainable, and robust artificial intelligence applications."@en ;
