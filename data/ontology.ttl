ngm:vulnerability a owl:Class ;
    rdfs:label "Vulnerability"@en ;
    rdfs:comment "A Vulnerability is a weakness, flaw, or inadequacy in a system's design, implementation, or configuration that can be exploited to violate security policies or compromise integrity. Vulnerabilities are classified by origin (design flaw, implementation bug, configuration error), severity (CVSS score), and CIA impact (confidentiality, integrity, availability), and are managed through scanning, patching, and compensating controls."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:risk-assessment ],
        ngm:risk ;
    vc:bridgesTo ngm:adversarial-robustness,
        ngm:smart-contract-security,
        ngm:supply-chain-risk ;
    vc:contrastsWith ngm:resilience,
        ngm:security ;
    vc:dependsOn ngm:risk,
        ngm:threat-model ;
    vc:enables ngm:cyber-attack,
        ngm:exploit,
        ngm:privilege-escalation ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:cve,
        ngm:cvss-score,
        ngm:cwe ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:attack-vector,
        ngm:disclosure-policy,
        ngm:penetration-testing,
        ngm:threat-actor,
        ngm:zero-day ;
    vc:requires ngm:patch-management,
        ngm:risk-assessment,
        ngm:vulnerability-scanning ;
    vc:slug "vulnerability" ;
    vc:sourceDomain "security" ;
    vc:standardizedBy ngm:nist-nvd,
        ngm:owasp .

ngm:vulnerability-management a owl:Class ;
    rdfs:label "Vulnerability Management"@en ;
    rdfs:comment "The continuous process of identifying, assessing, prioritising and remediating security weaknesses across systems and software to reduce the risk of exploitation, integrating asset discovery, severity scoring, threat intelligence and remediation tracking."@en ;
