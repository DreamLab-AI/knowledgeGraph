ngm:causal-language-modelling a owl:Class ;
    rdfs:label "Causal Language Modelling"@en ;
    rdfs:comment "Causal language modelling is a self-supervised pre-training objective in which a neural network learns to predict the next token in a sequence given all preceding tokens, modelling the joint probability of text as an autoregressive product of conditional distributions. The term 'causal' refers to the unidirectional (left-to-right) attention mask that enforces the temporal ordering of tokens, preventing the model from attending to future context. This objective is the foundation of decoder-only transformer architectures such as GPT, LLaMA, and Claude, which power the majority of state-of-the-art large language models."@en ;
    rdfs:subClassOf ngm:large-language-model-training ;
    vc:enables ngm:chain-of-thought-prompting,
        ngm:gpt,
        ngm:large-language-models ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:in-context-learning,
        ngm:instruction-tuning ;
    vc:slug "causal-language-modelling" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:attention-mechanism,
        ngm:causal-attention .

ngm:cbdc-infrastructure a owl:Class ;
    rdfs:label "CBDC Infrastructure"@en ;
    rdfs:comment "CBDC infrastructure refers to the technical systems, protocols, and institutional arrangements that underpin the issuance, distribution, settlement, and management of central bank digital currencies. It encompasses the ledger technology (centralised, distributed, or hybrid), API layers enabling interoperability with commercial banks and payment service providers, offline payment capability, and the privacy-preserving and security mechanisms required for sovereign digital money at scale. CBDC infrastructure must satisfy central bank requirements for finality, programmability, resilience, and monetary policy control that differ fundamentally from commercial digital payment systems."@en ;
    rdfs:subClassOf ngm:payment-infrastructure ;
    vc:enables ngm:central-bank-digital-currency,
