ngm:corda a owl:Class ;
    rdfs:label "Corda"@en ;
    rdfs:comment "Corda is an open-source permissioned distributed ledger platform developed by R3 and purpose-built for regulated industries, where transaction data is shared exclusively between the counterparties involved rather than broadcast to all network participants. Unlike public blockchains, Corda structures its ledger as a directed acyclic graph of Unspent Transaction Outputs (UTXOs) called states, which are consumed and produced by atomic transactions validated by both smart contract code and legal prose. A notary cluster provides consensus on transaction uniqueness, preventing double-spend without revealing transaction details to uninvolved parties, making Corda particularly suited to financial services, trade finance, and healthcare interoperability scenarios."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:notary-service ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:public-key-infrastructure ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:distributed-ledger ],
        ngm:permissioned-blockchain ;
    vc:bridgesTo ngm:central-bank-digital-currency,
        ngm:de-fi ;
    vc:contrastsWith ngm:ethereum,
        ngm:hyperledger-fabric,
        ngm:public-blockchain ;
    vc:dependsOn ngm:identity-management,
        ngm:network-map ;
    vc:enables ngm:atomic-swap,
        ngm:digital-asset,
        ngm:smart-contract,
        ngm:trade-finance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:byzantine-fault-tolerance,
