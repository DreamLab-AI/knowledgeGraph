            owl:someValuesFrom ngm:evidence-collection ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:legal-framework ],
        ngm:dispute-resolution-mechanism ;
    vc:bridgesTo ngm:artificial-intelligence,
        ngm:blockchain,
        ngm:distributed-collaboration ;
    vc:dependsOn ngm:cryptoeconomic-incentive,
        ngm:escrow-system ;
    vc:enables ngm:contract-enforcement,
        ngm:dao-governance,
        ngm:e-contract-arbitration ;
    vc:hasMaturity ngmi:maturity-established ;
