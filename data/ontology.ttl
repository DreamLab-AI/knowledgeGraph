        ngm:llvm-compiler-infrastructure,
        ngm:unified-memory-architecture .

ngm:apple-inc-technology-corporation-vision-pro a owl:Class ;
    rdfs:label "Apple Vision Pro"@en ;
    rdfs:comment "Apple Vision Pro is a spatial computing head-mounted display developed by Apple, announced in June 2023 and released in the United States in February 2024, running the visionOS operating system. It combines ultra-high-resolution micro-OLED displays, a custom R1 chip for sensor processing, and an M2 chip for compute, enabling a fully immersive or passthrough-composited mixed reality experience. The device employs eye-tracking, hand-tracking, and voice input as its primary interaction modalities, replacing the traditional touchscreen paradigm with gaze-and-pinch gesture control."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:computer-vision ],
