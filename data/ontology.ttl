        ngm:user-testing ;
    vc:slug "usability" ;
    vc:sourceDomain "infrastructure" ;
    vc:standardizedBy ngm:iso-9241,
        ngm:wcag-2-2 ;
    vc:supports ngm:human-robot-interaction,
        ngm:interface-design ;
    vc:uses ngm:cognitive-walkthrough,
        ngm:eye-tracking,
        ngm:think-aloud-protocol .

ngm:utxo a owl:Class ;
    rdfs:label "UTXO"@en ;
    rdfs:comment "UTXO (Unspent Transaction Output) is an accounting model used by Bitcoin and several other blockchains in which the ledger state consists of discrete unspent outputs rather than account balances. Each transaction consumes one or more existing unspent outputs as inputs and creates new outputs, and a coin is simply an output that has not yet been spent. Ownership is established by satisfying the locking script attached to an output, typically by providing a valid signature. The model contrasts with the account-based approach used by Ethereum and supports straightforward parallel validation and privacy techniques."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:locking-script ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:transaction-output ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:digital-signature ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptographic-hash-function ],
        ngm:blockchain ;
    skos:broader ngm:blockchain ;
    vc:bridgesTo ngm:lightning-network,
        ngm:utxo-model ;
    vc:contrastsWith ngm:account-model,
        ngm:ethereum ;
    vc:enables ngm:bitcoin-proof-of-work-protocol,
        ngm:coin-selection,
        ngm:payment-channel,
        ngm:transaction-validation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:change-output,
        ngm:transaction-output,
        ngm:unlocking-script ;
    vc:implements ngm:utxo-model ;
    vc:isPartOf ngm:bitcoin-transaction,
        ngm:blockchain-ledger ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:cardano,
        ngm:proof-of-work,
        ngm:wallet ;
    vc:requires ngm:cryptographic-hash-function,
        ngm:digital-signature,
        ngm:locking-script,
        ngm:transaction-input ;
    vc:slug "utxo" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:light-client-verification,
        ngm:privacy,
        ngm:stateless-validation ;
    vc:uses ngm:merkle-tree,
        ngm:script .

ngm:visual-effects a owl:Class ;
    rdfs:label "Visual Effects"@en ;
    rdfs:comment "Visual Effects (VFX) are the computational and compositing techniques used to create, simulate, or augment imagery that cannot be practically captured in-camera, spanning both offline film/broadcast pipelines and real-time interactive applications. In offline production, VFX encompasses computer-generated imagery (CGI), digital compositing, matte painting, motion capture integration, and physically accurate simulation of fluids, cloth, destruction, and crowds. In real-time and spatial-computing contexts, VFX includes particle systems, post-processing stacks (bloom, depth-of-field, ambient occlusion, screen-space reflections), procedural shaders, and GPU-accelerated simulation executed within physically-based rendering pipelines at interactive frame rates."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:physically-based-rendering ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:fluid-simulation ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:volumetric-rendering ],
