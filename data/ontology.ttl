ngm:rb-0026-robot-joint a owl:Class ;
    rdfs:label "rb 0026 robot joint"@en ;
    rdfs:comment "A robot joint is a mechanical articulation connecting two adjacent robot links that permits one or more degrees of relative motion—translational (prismatic) or rotational (revolute). Robot joints are the fundamental kinematic elements that determine a manipulator's workspace and degrees of freedom; their dynamic properties, including inertia, backlash, and compliance, critically influence both control precision and safe interaction with the environment."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:robot-actuator ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:rb-0072-encoder ],
        ngm:robo-actuation-and-control,
        ngm:robot ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:enables ngm:rb-0021-robot-kinematics,
        ngm:rb-0054-position-control ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:rb-0072-encoder,
        ngm:robot-actuator ;
    vc:isPartOf ngm:rb-0027-robot-link ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:rb-0038-compliance,
        ngm:rb-0039-stiffness,
        ngm:rb-0040-backlash,
        ngm:rb-0041-inertia ;
    vc:slug "rb-0026-robot-joint" ;
    vc:sourceDomain "robotics" .

ngm:rb-0054-position-control a owl:Class ;
    rdfs:label "rb 0054 position control"@en ;
    rdfs:comment "Position control is a robot control strategy in which the primary objective is to drive each joint or end-effector to a desired spatial configuration, using closed-loop feedback from encoders or resolvers to minimise position error. It forms the foundation for precise manipulation tasks and is typically implemented via PID controllers, and may be combined with force or impedance control for compliant operation in contact-rich environments."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:rb-0051-trajectory-planning ],
        ngm:motion-control,
        ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:rb-0053-force-control,
        ngm:rb-0055-velocity-control,
        ngm:rb-0056-impedance-control ;
    vc:requires ngm:rb-0051-trajectory-planning ;
    vc:slug "rb-0054-position-control" ;
    vc:sourceDomain "robotics" ;
    vc:supports ngm:rb-0091-safety-rated-monitored-stop ;
    vc:uses ngm:rb-0047-feedback-control,
        ngm:rb-0048-pid-controller,
        ngm:rb-0072-encoder .

ngm:rb-0090-emergency-stop a owl:Class ;
    rdfs:label "rb 0090 emergency stop"@en ;
    rdfs:comment "An Emergency Stop (E-stop) is a safety function that immediately removes power or halts the motion of a robot system upon activation, bringing the robot to a controlled or uncontrolled halt to prevent injury or damage. Defined under ISO 10218 and IEC 60204-1, it is a hardwired, independently monitored stop category (typically Stop Category 0 or 1) that takes priority over all other controls. E-stops must be clearly marked, accessible, and self-latching so that the robot cannot restart until the stop is deliberately reset."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:rb-0089-risk-assessment ],
        ngm:robo-safety-and-standards,
        ngm:robot-safety ;
    skos:broader ngm:robo-safety-and-standards ;
    vc:contrastsWith ngm:rb-0093-speed-limitation ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:rb-0091-safety-rated-monitored-stop,
        ngm:rb-0092-protective-stop,
        ngm:rb-0095-safety-zone,
        ngm:rb-0096-safeguarding ;
    vc:requires ngm:rb-0089-risk-assessment ;
    vc:slug "rb-0090-emergency-stop" ;
    vc:sourceDomain "robotics" ;
    vc:standardizedBy ngm:functional-safety,
        ngm:iso-10218 .

ngm:rb-0091-safety-rated-monitored-stop a owl:Class ;
    rdfs:label "rb 0091 safety rated monitored stop"@en ;
    rdfs:comment "A safety-rated monitored stop (SRMS) is a robot stopping function in which the robot halts motion while the control system continuously monitors joint positions to verify the robot remains stationary, without removing power to the actuators. Unlike an emergency stop, SRMS allows rapid resumption of operation when the hazardous condition clears, and is central to collaborative robot (cobot) safety architectures defined in ISO 10218 and ISO/TS 15066."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:rb-0054-position-control ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:rb-0089-risk-assessment ],
        ngm:robo-safety-and-standards,
        ngm:robot-safety ;
    skos:broader ngm:robo-safety-and-standards ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:rb-0090-emergency-stop,
        ngm:rb-0092-protective-stop,
        ngm:rb-0093-speed-limitation ;
    vc:requires ngm:rb-0054-position-control,
        ngm:rb-0089-risk-assessment ;
    vc:slug "rb-0091-safety-rated-monitored-stop" ;
    vc:sourceDomain "robotics" ;
    vc:standardizedBy ngm:iso-10218,
        ngm:iso-ts-15066 ;
    vc:supports ngm:human-robot-interaction,
        ngm:rb-0096-safeguarding .

ngm:rb-0093-speed-limitation a owl:Class ;
    rdfs:label "rb 0093 speed limitation"@en ;
    rdfs:comment "Speed limitation is a collaborative robotics safety function that restricts the maximum velocity of robot joints or the tool centre point to a defined safe threshold, as specified by ISO/TS 15066 and ISO 10218. It is a key mechanism for enabling safe human-robot collaboration in shared workspaces by ensuring robot motion cannot exceed speeds that would cause unacceptable injury risk upon contact. Speed limitation operates continuously or is activated when a human is detected within a monitored zone."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:rb-0072-encoder ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:rb-0055-velocity-control ],
        ngm:robo-safety-and-standards,
        ngm:robot-safety ;
    skos:broader ngm:robo-safety-and-standards ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:rb-0092-protective-stop,
        ngm:rb-0094-power-and-force-limiting,
        ngm:rb-0103-collaborative-operation,
        ngm:rb-0105-speed-and-separation-monitoring ;
    vc:requires ngm:rb-0055-velocity-control,
        ngm:rb-0072-encoder ;
    vc:slug "rb-0093-speed-limitation" ;
    vc:sourceDomain "robotics" ;
    vc:standardizedBy ngm:iso-ts-15066,
        ngm:rb-0087-safety-standard ;
    vc:supports ngm:rb-0007-collaborative-robot .

ngm:re-act a owl:Class ;
    rdfs:label "ReAct"@en ;
    rdfs:comment "ReAct (Reasoning and Acting) is a prompting paradigm for large language models that interleaves free-form reasoning traces (Thought steps) with structured external action calls in a single output sequence, enabling models to dynamically plan multi-step tasks, observe the results of tool invocations, and revise their reasoning accordingly. The framework produces an alternating Thought–Action–Observation loop that grounds model inference in real-world feedback, contrasting with pure chain-of-thought prompting (reasoning without action) and pure action-only agents (action without transparent reasoning). Originally demonstrated by Yao et al. (2022) on knowledge-intensive QA and interactive decision benchmarks, ReAct has become the foundational interaction primitive underpinning modern agentic AI systems, tool-augmented LLMs, and multi-agent orchestration frameworks."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:prompt-engineering ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:large-language-model ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:tool-use ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:chain-of-thought ],
        ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:bridgesTo ngm:knowledge-graph,
        ngm:robotic-process-automation ;
    vc:contrastsWith ngm:act-only-agent,
        ngm:chain-of-thought,
        ngm:reflexion,
        ngm:tree-of-thoughts ;
    vc:dependsOn ngm:external-knowledge-retrieval,
        ngm:function-calling ;
    vc:enables ngm:agentic-ai,
        ngm:autonomous-agent,
        ngm:human-in-the-loop,
        ngm:interpretable-ai,
        ngm:tool-augmented-language-model ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:agent-loop,
        ngm:grounded-reasoning ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:multi-agent-system,
        ngm:planning-and-scheduling,
        ngm:prompting-technique,
        ngm:reasoning,
        ngm:reinforcement-learning ;
    vc:requires ngm:chain-of-thought,
        ngm:large-language-model,
        ngm:prompt-engineering,
        ngm:tool-use ;
    vc:slug "re-act" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:in-context-learning,
        ngm:retrieval-augmented-generation,
        ngm:scratchpad-reasoning .

ngm:real-time-computation a owl:Class ;
    rdfs:label "Real-Time Computation"@en ;
    rdfs:comment "Real-time computation refers to computational processes that must produce correct outputs within specified, externally imposed time constraints—where the correctness of a result depends not only on its logical accuracy but on its delivery before a deadline. Hard real-time systems guarantee deadline satisfaction under all conditions, soft real-time systems tolerate occasional deadline misses, and firm real-time systems discard late results as worthless. Applications span industrial control, autonomous vehicles, robotics, financial trading, and interactive media. Real-time computation requires deterministic execution paths, bounded memory allocation, and often specialised hardware or operating system schedulers."@en ;
    rdfs:subClassOf ngm:real-time ;
    vc:enables ngm:control-system,
        ngm:sensor-fusion ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:embedded-systems,
        ngm:latency,
        ngm:real-time-ai ;
    vc:slug "real-time-computation" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:autonomous-system,
        ngm:digital-signal-processing ;
    vc:uses ngm:edge-computing,
        ngm:parallel-processing .

ngm:reference-architecture a owl:Class ;
    rdfs:label "Reference Architecture"@en ;
    rdfs:comment "A standardized architectural template that provides proven structural frameworks and design patterns for building scalable, resilient enterprise applications, establishing shared vocabulary and best practices across development teams."@en ;
    rdfs:subClassOf ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:bridgesTo ngm:software-architecture ;
    vc:enables ngm:scalable-systems ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:slug "reference-architecture" ;
    vc:sourceDomain "spatial-computing" .

ngm:regulatory-authority a owl:Class ;
    rdfs:label "Regulatory Authority"@en ;
    rdfs:comment "A regulatory authority is a government body, statutory agency, or delegated entity empowered by legislation to create, enforce, and adjudicate rules governing a specific industry, market, or domain of public concern. Such bodies possess the legal power to issue binding standards, licenses, and penalties; conduct inspections and investigations; and compel disclosures, all with the aim of protecting consumers, ensuring market integrity, managing systemic risk, or advancing public policy objectives. Regulatory authorities operate at national, supranational, and sub-national levels and are increasingly engaged with digital markets, artificial intelligence, financial technology, and emerging technology sectors."@en ;
    rdfs:subClassOf ngm:governance ;
    vc:enables ngm:regulatory-reporting,
        ngm:regulatory-standards ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:compliance-framework,
        ngm:financial-regulation,
        ngm:regulatory-compliance,
        ngm:regulatory-framework ;
    vc:slug "regulatory-authority" ;
    vc:sourceDomain "governance" ;
    vc:uses ngm:compliance-monitoring,
        ngm:regulatory-technology .

ngm:remote-sensing a owl:Class ;
    rdfs:label "Remote Sensing"@en ;
    rdfs:comment "Remote sensing is the acquisition of information about physical objects or phenomena from a distance, typically using sensors mounted on satellites, aircraft, drones, or ground-based platforms, without direct physical contact with the subject. It encompasses passive sensing (measuring reflected or emitted electromagnetic radiation across optical, infrared, and microwave bands) and active sensing (radar and LiDAR, which emit and measure return signals). Remote sensing data underpins earth observation, environmental monitoring, precision agriculture, disaster response, urban planning, and military reconnaissance."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:sensor-calibration ],
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:bridgesTo ngm:autonomous-vehicle,
        ngm:digital-twin,
        ngm:perception-system ;
    vc:dependsOn ngm:geospatial-information,
        ngm:sensor-fusion ;
    vc:enables ngm:disaster-response,
        ngm:environmental-assessment,
        ngm:land-cover-classification,
        ngm:mapping,
        ngm:object-recognition,
        ngm:precision-agriculture ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:hyperspectral-imaging,
        ngm:multispectral-sensor,
        ngm:synthetic-aperture-radar,
        ngm:thermal-infrared-sensing ;
    vc:isPartOf ngm:earth-observation,
        ngm:geospatial-technology ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:geographic-information-system,
        ngm:photogrammetry ;
    vc:requires ngm:satellite-platform,
