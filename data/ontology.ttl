ngm:shared-spatial-anchors a owl:Class ;
    rdfs:label "Shared Spatial Anchors"@en ;
    rdfs:comment "Cloud-based reference points that lock virtual objects to specific physical locations, enabling multiple users across different devices to perceive digital content in the same position and orientation relative to the real-world environment for collaborative mixed reality experiences."@en ;
