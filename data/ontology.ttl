    vc:requires ngm:autonomous-navigation-support ;
    vc:slug "tc-0003-telepresence-robot" ;
    vc:sourceDomain "distributed-collaboration" ;
    vc:uses ngm:5-g-low-latency-networks .

ngm:teacher-student-training a owl:Class ;
    rdfs:label "Teacher Student Training"@en ;
    rdfs:comment "Teacher-Student Training is a machine learning paradigm in which a larger, higher-capacity teacher model supervises the training of a smaller student model, transferring knowledge through soft probability distributions (dark knowledge), intermediate feature representations, or attention maps rather than hard labels alone. The approach underpins knowledge distillation for model compression and is widely used to deploy efficient models on edge hardware without sacrificing task performance."@en ;
    rdfs:subClassOf ngm:ai-technique,
        ngm:training-method ;
    skos:broader ngm:ai-technique ;
    vc:enables ngm:knowledge-distillation-for-edge,
        ngm:model-compression-for-edge ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:implements ngm:knowledge-distillation,
        ngm:transfer-learning ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:computer-vision ;
    vc:slug "teacher-student-training" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:deep-learning,
        ngm:machine-learning .

ngm:technical-history-extended-cv a owl:Class ;
    rdfs:label "Technical History (extended CV)"@en ;
    rdfs:comment "Technical History (extended CV) is the knowledge-graph representation of the author's professional research trajectory, spanning 15+ years leading immersive technology laboratories, securing multi-million-pound grant funding, and developing open-source metaverse and AI systems. It contextualises published research, institutional roles, and ongoing projects — including Knowhere, Flossverse, and FutureFleet — within the graph's broader topics of spatial computing, AI, and decentralised systems."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:knowhere ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:dreamlab ],
        ngm:infra-software-engineering ;
    skos:broader ngm:infra-software-engineering ;
    vc:bridgesTo ngm:location-based-experience,
        ngm:trust-and-safety ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:dreamlab,
        ngm:knowhere ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:metaverse-and-telecollaboration,
        ngm:mixed-reality,
        ngm:national-industrial-centre-for-virtual-environments ;
    vc:slug "technical-history-extended-cv" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:hyper-personalisation,
        ngm:proprietary-large-language-models .

ngm:technical-robustness-and-safety a owl:Class ;
    rdfs:label "Technical Robustness and Safety"@en ;
    rdfs:comment "Technical Robustness and Safety is a core AI trustworthiness dimension that requires AI systems to perform reliably under varied and adversarial conditions, implement fallback mechanisms for graceful degradation, and maintain operational safety throughout their lifecycle. It encompasses resilience to adversarial attacks, accurate uncertainty quantification, comprehensive risk assessment, and incident response protocols mandated by frameworks such as the EU AI Act Article 15 and NIST AI RMF."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cybersecurity ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:adversarial-attack ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:risk-assessment ],
        ngm:ai-governance-and-ethics,
        ngm:ai-trustworthiness-dimensions ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:enables ngm:ai-safety,
        ngm:model-robustness,
        ngm:responsible-ai ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:ai-ethics,
        ngm:machine-learning ;
    vc:requires ngm:adversarial-attack,
        ngm:cybersecurity,
        ngm:risk-assessment ;
    vc:slug "technical-robustness-and-safety" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:ai-alignment,
        ngm:ai-regulation ;
    vc:uses ngm:data-poisoning,
        ngm:red-teaming .

ngm:technique a owl:Class ;
    rdfs:label "Technique"@en ;
    rdfs:comment "A Technique is a specific, repeatable method or procedure applied within a domain to achieve a defined outcome, distinguishing it from broader algorithms or frameworks by its focus on concrete application steps. In artificial intelligence, techniques encompass approaches such as supervised learning, fine-tuning, and prompt engineering that are composed into pipelines and evaluated against benchmarks. Techniques may be realised by models or algorithms, and their effectiveness is assessed through empirical evaluation on datasets."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:algorithm ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:training-data ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:model-training ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:machine-learning-technique ],
        ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:contrastsWith ngm:architecture ;
    vc:enables ngm:inference,
        ngm:model-performance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:algorithm,
        ngm:machine-learning-technique ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:algorithmic-framework,
        ngm:machine-learning,
        ngm:model ;
    vc:requires ngm:model-training,
        ngm:training-data ;
    vc:slug "technique" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:deep-learning,
        ngm:neural-network .

ngm:telecollaboration-and-telepresence-domain a owl:Class ;
    rdfs:label "Telecollaboration and Telepresence Domain"@en ;
    rdfs:comment "Telecollaboration and Telepresence Domain is a distributed collaboration concept and a type of Telecollaboration. that enables DistributedWork."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:immersive-technology ],
        ngm:dc-telepresence,
        ngm:telecollaboration ;
    skos:broader ngm:dc-telepresence ;
    vc:enables ngm:distributed-work ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires ngm:immersive-technology ;
    vc:slug "telecollaboration-and-telepresence-domain" ;
    vc:sourceDomain "distributed-collaboration" .

ngm:teleoperated-robot a owl:Class ;
    rdfs:label "Teleoperated Robot"@en ;
    rdfs:comment "A Teleoperated Robot is a robotic system remotely controlled by a human operator via a communication link, combining human-level judgement with robotic precision and reach in environments inaccessible or hazardous to people. Key technical dimensions include haptic feedback, anthropomorphic dexterity, immersive operator interfaces (including VR headsets), latency management, and AI-assisted control to reduce operator cognitive load; applications span surgery, nuclear decommissioning, disaster response, and construction."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:robo-perception ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:human-robot-interaction ],
        ngm:robo-human-robot-interaction ;
    skos:broader ngm:robo-human-robot-interaction ;
    vc:bridgesTo ngm:dc-telepresence ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:robo-safety-and-standards,
        ngm:robotic-telepresence ;
    vc:requires ngm:human-robot-interaction,
        ngm:robo-perception ;
    vc:slug "teleoperated-robot" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:haptic-feedback,
        ngm:immersive-interface .

ngm:telethrone a owl:Class ;
    rdfs:label "Telethrone"@en ;
    rdfs:comment "Telethrone is a research concept for a hyper-personal display and telepresence installation that resolves the challenge of rendering a spatially aware, photorealistic metahuman avatar for a single collocated viewer. It combines personalised 3D reconstruction from 2D imagery, gaze-contingent rendering, and situated display technology to achieve high-fidelity presence without requiring the viewer to wear head-mounted displays."@en ;
    rdfs:subClassOf ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:enables ngm:immersive-experience ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:avatar,
        ngm:tele-050-neuralrenderingtelepresence,
        ngm:tele020virtualrealitytelepresence ;
    vc:slug "telethrone" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:display-hardware,
        ngm:hyper-personalisation,
        ngm:neural-rendering .

ngm:temperature-sensor a owl:Class ;
    rdfs:label "Temperature Sensor"@en ;
    rdfs:comment "A temperature sensor is a transducer that converts thermal energy into an electrical signal, enabling robotic and autonomous systems to monitor ambient, surface, or internal temperatures. Common types include thermocouples, RTDs, and infrared sensors, each suited to different accuracy, range, and response-time requirements in industrial, healthcare, and field robotics."@en ;
    rdfs:subClassOf ngm:robo-perception ;
    skos:broader ngm:robo-perception ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:robo-perception,
        ngm:robotic-system ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:sensor,
        ngm:sensor-data,
        ngm:sensor-fusion ;
    vc:slug "temperature-sensor" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:sensor-technology .

ngm:templates a owl:Class ;
    rdfs:label "Templates"@en ;
    rdfs:comment "Templates are reusable structural scaffolds in software engineering and knowledge management that define a fixed format or pattern into which variable content is inserted. They reduce repetition, enforce consistency, and accelerate authoring across code generation, documentation, and prompt engineering workflows."@en ;
    rdfs:subClassOf ngm:infra-software-engineering ;
    skos:broader ngm:infra-software-engineering ;
    vc:enables ngm:code-generation,
        ngm:documentation-generation ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:knowledge-management,
        ngm:knowledge-management-system ;
    vc:slug "templates" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:prompt-engineering .

ngm:term-index a owl:Class ;
    rdfs:label "TERM INDEX"@en ;
    rdfs:comment "A Term Index is a comprehensive reference catalogue mapping domain terminology, identifiers, and conceptual relationships within ontologies, enabling discovery and navigation of complex knowledge spaces across metaverse, blockchain, and robotics ecosystems. Well-structured indices provide hierarchical classification, cross-references, and semantic linking that facilitate knowledge retrieval, API design, and knowledge-graph integration, serving both user-facing navigation and machine-readable specifications supporting automated reasoning and SPARQL query optimisation."@en ;
