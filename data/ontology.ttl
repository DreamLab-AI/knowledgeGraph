        ngm:machine-learning,
        ngm:natural-language-processing ;
    vc:slug "computation-and-intelligence-domain" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:computational-complexity-theory a owl:Class ;
    rdfs:label "Computational Complexity Theory"@en ;
    rdfs:comment "The study of the resources, principally time and memory, required to solve computational problems, and the classification of problems into complexity classes."@en ;
