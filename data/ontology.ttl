        ngm:iclr,
        ngm:neurips ;
    vc:enables ngm:benchmark-standard,
        ngm:federated-learning,
        ngm:machine-learning-research,
        ngm:peer-review,
        ngm:transfer-learning ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:paper-submission,
        ngm:tutorial,
        ngm:workshop ;
    vc:isPartOf ngm:machine-learning-community,
        ngm:proceedings-of-machine-learning-research ;
    vc:qualityScore "0.73"^^xsd:float ;
    vc:relatedTo ngm:academic-conference,
        ngm:ai-safety-research,
        ngm:deep-learning,
        ngm:generative-ai,
        ngm:iclr,
        ngm:machine-learning,
