ngm:grouped-query-attention a owl:Class ;
    rdfs:comment "Grouped Query Attention (GQA) is a transformer attention variant that partitions the set of query heads into G groups, each group sharing a single pair of key and value heads, thereby interpolating between Multi-Head Attention (MHA, where each query head has its own KV head) and Multi-Query Attention (MQA, where all query heads share one KV head). GQA reduces the key-value cache memory footprint during autoregressive inference—proportionally to the number of groups—while preserving model quality closer to MHA than MQA. It has been adopted in production LLMs including Llama 2, Mistral, and Gemma."@en ;
    rdfs:label "Grouped Query Attention"@en ;
    rdfs:subClassOf ngm:ai-model-architecture ;
    skos:broader ngm:ai-model-architecture ;
    vc:contrastsWith ngm:flash-attention ;
    vc:contrastsWith ngm:multi-head-attention ;
    vc:enables ngm:inference ;
    vc:enables ngm:speculative-decoding ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:slug "grouped-query-attention" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:attention-mechanism ;
    vc:uses ngm:transformer-architecture .
