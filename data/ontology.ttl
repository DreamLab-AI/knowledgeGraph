ngm:digital-actor-creation a owl:Class ;
    rdfs:label "Digital Actor Creation"@en ;
    rdfs:comment "The process of designing and generating photorealistic or stylized virtual human characters using 3D modeling, motion capture, AI synthesis, and deep learning techniques for use in entertainment, virtual production, metaverse experiences, and interactive media applications."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:3-d-modeling ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:motion-capture ],
        ngm:ai-application ;
    skos:broader ngm:ai-application ;
    vc:bridgesTo ngm:digital-human-technology ;
    vc:enables ngm:digital-twin,
        ngm:synthetic-media,
        ngm:virtual-performances ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires ngm:3-d-modeling,
        ngm:ai-synthesis,
        ngm:motion-capture ;
    vc:slug "digital-actor-creation" ;
    vc:sourceDomain "artificial-intelligence" .

