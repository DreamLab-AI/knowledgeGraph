vf:dao-legal-structures a owl:Class ;
    rdfs:label "DAO Legal Structures"@en ;
    rdfs:comment "**DAO Legal Structures** are the corpus of statutory wrappers, jurisdictional incorporation regimes, and bespoke entity forms — spanning US state limited-liability companies, US state unincorporated nonprofit associations, offshore foundation companies, Swiss associations and foundations, Liechtenstein TVTG-registered entities, BVI limited companies, Marshall Islands DAO LLCs, Singapore Variable Capital Companies, Panama private interest foundations and Delaware statutory trusts — that confer **legal personality, limited liability, tax classification, contractual capacity, and regulatory recognition** on [[Decentralised Autonomous Organisations]] which would otherwise default to a stateless **general partnership** under common law (in which every token holder bears joint-and-several liability for the collective's debts, torts, and regulatory penalties, as the September 2022 **CFTC v. Ooki DAO** default judgment chillingly demonstrated when a US district court entered $643,542 in penalties and a permanent injunction against an unincorporated DAO and its token-holder members, expressly finding the Ooki DAO to be an unincorporated association subject to service via help-chat and a for"@en ;
    rdfs:subClassOf <urn:visionflow:linked:corporate-forms>,
        <urn:visionflow:linked:governance-structures>,
        <urn:visionflow:linked:legal-entity-wrappers>,
        <urn:visionflow:linked:liability-shield-mechanisms>,
        <urn:visionflow:linked:regulatory-compliance-frameworks> ;
    vc:authorityScore "0.87"^^xsd:float ;
    vc:enables <urn:visionflow:linked:bank-account-access>,
        <urn:visionflow:linked:contractual-capacity>,
        <urn:visionflow:linked:dispute-resolution-forum>,
        <urn:visionflow:linked:intellectual-property-ownership>,
        <urn:visionflow:linked:legal-personality>,
        <urn:visionflow:linked:liability-protection>,
        <urn:visionflow:linked:regulatory-engagement>,
        <urn:visionflow:linked:tax-treatment-clarity> ;
    vc:hasPart <urn:visionflow:linked:bvi-limited-company>,
        <urn:visionflow:linked:cayman-foundation-company>,
        <urn:visionflow:linked:delaware-statutory-trust>,
        <urn:visionflow:linked:liechtenstein-tvtg-entity>,
        <urn:visionflow:linked:marshall-islands-dao-llc>,
        <urn:visionflow:linked:panama-private-interest-foundation>,
        <urn:visionflow:linked:singapore-variable-capital-company>,
        <urn:visionflow:linked:swiss-stiftung>,
        <urn:visionflow:linked:swiss-verein>,
        <urn:visionflow:linked:tennessee-do>,
        <urn:visionflow:linked:utah-dao-llc>,
        <urn:visionflow:linked:vermont-bbllc>,
        <urn:visionflow:linked:wyoming-dao-llc>,
        <urn:visionflow:linked:wyoming-duna> ;
    vc:implements <urn:visionflow:linked:algorithmic-management-doctrine>,
        <urn:visionflow:linked:dual-entity-structure>,
        <urn:visionflow:linked:foundation-plus-subsidiary-pattern>,
        <urn:visionflow:linked:legal-wrapping-pattern>,
        <urn:visionflow:linked:operating-agreement-supremacy> ;
    vc:maturity "production-ready" ;
    vc:qualityScore "0.52"^^xsd:float ;
    vc:requires <urn:visionflow:linked:anti-money-laundering-compliance>,
        <urn:visionflow:linked:articles-of-organization>,
        <urn:visionflow:linked:beneficial-ownership-disclosure>,
        <urn:visionflow:linked:bylaws>,
        <urn:visionflow:linked:operating-agreement>,
        <urn:visionflow:linked:registered-agent>,
        <urn:visionflow:linked:tax-identification-number> ;
    vc:slug "dao-legal-structures" ;
    vc:sourceDomain "blockchain" .

vf:dao-tooling a owl:Class ;
    rdfs:label "DAO Tooling"@en ;
    rdfs:comment "DAO Tooling is the integrated software stack of governance platforms, treasury custodians, execution oracles, deliberation forums, identity primitives, analytics layers, and compensation rails that operationalises decentralised autonomous organisations as functioning socio-technical institutions managing capital, coordinating contributors, and binding off-chain deliberation to on-chain execution. The stack comprises governance front-ends ([[Snapshot]] gasless off-chain voting across 20,000+ spaces and 22M+ votes by 2025, [[Tally]] on-chain Governor UI for 100+ protocols, [[Aragon]] OSx modular plugin framework, [[DAOhaus]] Moloch deployments, [[Boardroom]] aggregating governance across 200+ protocols, [[Commonwealth]] discussion+vote unified surface), treasury custody dominated by [[Safe]] (formerly [[Gnosis Safe]]) securing approximately $100B+ of digital assets across 250,000+ deployments and >50% of all DAO treasuries by value circa 2024-2025, with operational layers from [[Den]] (formerly [[Multis]]), [[Coinshift]], [[Karpatkey]] (€500M+ AUM across [[Gnosis DAO]], [[Balancer]], [[ENS]], [[CoW DAO]]), [[Llama]] / [[LlamaRisk]] (~$1B+ advised across [[Aave]], [[Gitcoin]], [[PoolT"@en ;
    rdfs:subClassOf <urn:visionflow:linked:coordination-technology>,
        <urn:visionflow:linked:governance-infrastructure>,
        <urn:visionflow:linked:organisational-software>,
        <urn:visionflow:linked:web3-stack>,
        vf:blockchain-infrastructure ;
    vc:authorityScore "0.87"^^xsd:float ;
    vc:enables <urn:visionflow:linked:decentralised-autonomous-organisation>,
        <urn:visionflow:linked:on-chain-governance>,
        <urn:visionflow:linked:optimistic-execution>,
        <urn:visionflow:linked:permissionless-coordination>,
        <urn:visionflow:linked:programmable-treasury>,
        <urn:visionflow:linked:quadratic-funding>,
        <urn:visionflow:linked:retroactive-public-goods-funding>,
        <urn:visionflow:linked:token-weighted-voting> ;
    vc:hasPart <urn:visionflow:linked:analytics-dashboard>,
        <urn:visionflow:linked:compensation-system>,
        <urn:visionflow:linked:deliberation-forum>,
        <urn:visionflow:linked:execution-oracle>,
        <urn:visionflow:linked:funding-platform>,
        <urn:visionflow:linked:governance-platform>,
        <urn:visionflow:linked:identity-primitive>,
        <urn:visionflow:linked:legal-wrapper>,
        <urn:visionflow:linked:treasury-management-system>,
        <urn:visionflow:linked:voting-mechanism> ;
    vc:implements <urn:visionflow:linked:erc-20-votes>,
        <urn:visionflow:linked:futarchy>,
        <urn:visionflow:linked:governor-bravo>,
        <urn:visionflow:linked:open-zeppelin-governor>,
        <urn:visionflow:linked:reality-eth-oracle>,
        <urn:visionflow:linked:safe-multi-sig>,
        <urn:visionflow:linked:snapshot-off-chain-voting>,
        vf:conviction-voting,
        vf:quadratic-voting ;
    vc:maturity "production-ready" ;
    vc:qualityScore "0.52"^^xsd:float ;
    vc:requires <urn:visionflow:linked:cryptographic-signature>,
        <urn:visionflow:linked:decentralised-storage>,
        <urn:visionflow:linked:multi-signature-wallet>,
        <urn:visionflow:linked:oracle-network>,
        vf:blockchain-network,
        vf:smart-contract,
        vf:token-standard ;
    vc:slug "dao-tooling" ;
    vc:sourceDomain "blockchain" .

