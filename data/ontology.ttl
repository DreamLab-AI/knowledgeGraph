        ngm:natural-language-understanding,
        ngm:transformer-architecture ;
    vc:slug "automated-summarization" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:information-retrieval,
        ngm:retrieval-augmented-generation .

ngm:automatic-1111-web-ui a owl:Class ;
    rdfs:label "AUTOMATIC1111 WebUI"@en ;
    rdfs:comment "AUTOMATIC1111 WebUI (also referred to as sd-webui or A1111) is an open-source, community-maintained browser-based graphical interface for running Stable Diffusion latent diffusion models locally on consumer and professional GPU hardware. Built in Python with a Gradio front end, it wraps the core Stable Diffusion inference pipeline in an accessible point-and-click UI that exposes text-to-image generation, image-to-image transformation, inpainting, outpainting, upscaling, model training tabs, and an extensible plugin architecture. Since its first public release in August 2022, it has accumulated over 160,000 GitHub stars, making it one of the most-starred open-source AI repositories in history and the dominant entry point for local Stable Diffusion experimentation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:stable-diffusion-image-model ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:python ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gpu-compute ],
        ngm:image-generation,
        ngm:open-generative-ai-tools ;
    vc:contrastsWith ngm:comfy-ui,
        ngm:invoke-ai ;
    vc:enables ngm:dreambooth,
        ngm:image-to-image,
        ngm:inpainting,
        ngm:outpainting,
        ngm:text-to-image,
        ngm:upscaling ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.85"^^xsd:float ;
    vc:relatedTo ngm:civitai,
        ngm:diffusion-model,
        ngm:hugging-face,
        ngm:stable-diffusion-xl ;
    vc:requires ngm:gpu-compute,
        ngm:gradio,
        ngm:python,
        ngm:stable-diffusion-image-model ;
    vc:slug "automatic-1111-web-ui" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:classifier-free-guidance,
        ngm:clip,
        ngm:control-net,
        ngm:lora,
        ngm:textual-inversion,
        ngm:variational-autoencoder .

ngm:autonomous-agent-framework-catalogue a owl:Class ;
    rdfs:label "Autonomous Agent Framework Catalogue"@en ;
    rdfs:comment "A curated catalogue of open-source and commercial autonomous agent frameworks and projects, spanning general-purpose agents (AutoGPT, BabyAGI, CAMEL), coding agents (GPT Engineer, SWE-Agent), productivity agents, research agents, and DIY framework scaffolds (CrewAI, MetaGPT, AutoGen). The list provides practitioners with an entry point into the rapidly expanding agentic AI ecosystem."@en ;
