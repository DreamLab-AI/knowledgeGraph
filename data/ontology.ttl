    vc:slug "edge-layer" ;
    vc:sourceDomain "infrastructure" .

ngm:electra a owl:Class ;
    rdfs:label "ELECTRA"@en ;
    rdfs:comment "ELECTRA (Efficiently Learning an Encoder that Classifies Token Replacements Accurately) is a transformer pre-training method that trains a discriminator to detect replaced tokens rather than reconstructing masked inputs, using a generator-discriminator architecture. This replaced token detection task utilises all positions in a sequence, yielding substantially greater sample efficiency than masked language modelling with less than one quarter of the compute required by comparable models."@en ;
    rdfs:subClassOf ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:contrastsWith ngm:albert,
        ngm:ro-berta ;
    vc:enables ngm:machine-learning-discipline-model,
        ngm:natural-language-processing ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:large-language-models ;
    vc:slug "electra" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:language-modeling,
        ngm:transformer,
        ngm:transformer-architecture .

ngm:email-corpus-retrieval-architecture a owl:Class ;
    rdfs:label "Email Corpus Retrieval Architecture"@en ;
    rdfs:comment "Email search refers to the set of techniques, architectures, and tooling used to index, query, and retrieve relevant messages from large email corpora. Modern self-hosted email search stacks combine traditional full-text indexing (BM25-based engines such as Tantivy or Xapian) with dense vector embeddings and hybrid retrieval strategies to support semantic and keyword queries at scale. LLM-based reranking and optional graph-database layers for entity-relationship queries extend precision and recall beyond keyword matching, enabling systems to handle corpora of hundreds of thousands of messages with sub-second latency."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:search-index ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:information-retrieval ],
        ngm:search-engine ;
    vc:dependsOn ngm:data-pipeline ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:information-retrieval,
        ngm:search-index ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:graph-database,
        ngm:knowledge-base,
        ngm:retrieval-augmented-generation-rag ;
    vc:slug "email-corpus-retrieval-architecture" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:embedding-model,
        ngm:semantic-search,
        ngm:vector-database .

ngm:emc-standard a owl:Class ;
    rdfs:label "EMC Standard"@en ;
    rdfs:comment "EMC standard ensures robots neither emit electromagnetic interference that disrupts other equipment nor experience susceptibility to external electromagnetic noise that degrades performance."@en ;
