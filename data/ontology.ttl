ngm:fundamental-rights a owl:Class ;
    rdfs:comment "The basic rights and freedoms guaranteed to individuals by constitutional orders and supranational charters — dignity, privacy, freedom of expression, equality, non-discrimination, and effective remedy among them — which bind public authorities and increasingly shape technology governance, serving as the normative benchmark for instruments such as the EU Charter of Fundamental Rights, the GDPR, and the EU AI Act."@en ;
    rdfs:label "Fundamental Rights"@en ;
    rdfs:subClassOf ngm:human-rights ;
    rdfs:subClassOf _:r10794 ;
