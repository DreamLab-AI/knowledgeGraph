ngm:ci-cd a owl:Class ;
    rdfs:comment "CI/CD (continuous integration and continuous delivery/deployment) is the software engineering practice of automatically building, testing and releasing every code change through a versioned pipeline. Continuous integration merges work into a shared trunk many times a day behind automated test gates; continuous delivery keeps the mainline permanently releasable; continuous deployment pushes each passing change to production automatically. Together they shrink feedback loops, reduce integration risk and enable progressive release strategies such as canary and zero-downtime deployments."@en ;
    rdfs:label "CI/CD"@en ;
    rdfs:subClassOf ngm:devops ;
    rdfs:subClassOf _:r3742 ;
    rdfs:subClassOf _:r3743 ;
    vc:enables ngm:canary-deployment ;
    vc:enables ngm:zero-downtime-deployment ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:continuous-deployment ;
    vc:hasPart ngm:continuous-integration ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:infrastructure-as-code ;
    vc:relatedTo ngm:software-engineering ;
    vc:slug "ci-cd" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:automated-testing ;
    vc:uses ngm:container ;
    vc:uses ngm:version-control .
ngm:ci-cd-automation a owl:Class ;
    rdfs:comment "Continuous integration and continuous delivery (CI/CD) automation is the practice of automatically building, testing, and deploying software changes through a defined pipeline triggered by source-control events. Continuous integration merges and validates changes frequently to detect defects early; continuous delivery extends this to produce always-deployable artefacts, while continuous deployment automates release to production. CI/CD automation reduces integration risk, shortens feedback loops, and makes deployments repeatable and auditable. It is implemented through pipeline-as-code definitions executed by orchestrators such as GitHub Actions, GitLab CI, and Jenkins."@en ;
    rdfs:label "CI-CD Automation"@en ;
    rdfs:subClassOf ngm:automation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.78"^^xsd:float ;
    vc:relatedTo ngm:model-deployment ;
    vc:relatedTo ngm:software-engineering ;
    vc:slug "ci-cd-automation" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:data-pipeline .
ngm:ci-cd-pipeline a skos:Concept ;
    rdfs:label "Ci Cd Pipeline"@en .
ngm:cia-301-canopen-standard a skos:Concept ;
    rdfs:label "Cia 301 Canopen Standard"@en .
ngm:cid a owl:Class ;
    rdfs:comment "A Content Identifier (CID) is a self-describing, cryptographic label used in the InterPlanetary File System (IPFS) and related protocols to uniquely and permanently address a piece of content based on its cryptographic hash rather than its location. CIDs encode the hash function used, the hash digest, and the codec describing the data format, enabling content-addressed storage where identical content always produces the same identifier regardless of where it is stored. CIDs are the primary addressing primitive of the IPLD (InterPlanetary Linked Data) ecosystem."@en ;
    rdfs:label "CID"@en ;
    rdfs:subClassOf ngm:content-identifier ;
    vc:enables ngm:content-addressing ;
    vc:enables ngm:decentralized-storage ;
    vc:enables ngm:ipfs ;
