ngm:matching-algorithm a owl:Class ;
    rdfs:comment "A matching algorithm is a computational procedure that identifies correspondences between two sets of entities — such as records, participants or resources — according to a similarity or compatibility criterion, ranging from exact-key joins to probabilistic and graph-based matching. In master data management it links duplicate or related records referring to the same real-world entity across data sources; in resource-allocation contexts, such as barter or exchange systems, it pairs supply with demand to satisfy mutual constraints. Matching algorithms vary widely in complexity, from simple rule-based comparisons to optimisation-based approaches such as the stable-marriage and bipartite-matching algorithms."@en ;
    rdfs:label "Matching Algorithm"@en ;
    rdfs:subClassOf ngm:algorithm ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:algorithm ;
    vc:qualityScore "0.55"^^xsd:float ;
