# State Space Control
robotics:StateSpaceControl rdf:type owl:Class ;
    rdfs:subClassOf robotics:FeedbackControl ;
    rdfs:label "State Space Control"@en ;
    rdfs:comment "State space control uses modern control theory with state feedback."@en ;
    skos:prefLabel "State Space Control"@en ;
