ngm:zk-sync a owl:Class ;
    rdfs:label "zkSync"@en ;
    rdfs:comment "zkSync is an Ethereum layer-2 scaling network developed by Matter Labs that uses zero-knowledge rollup technology to settle transactions on Ethereum with validity proofs. Its main network, zkSync Era, is a zk-rollup with an EVM-compatible execution environment, allowing many Ethereum smart contracts and tools to be used with minimal changes. By posting succinct proofs that each batch of transactions is valid, the network achieves Ethereum-level settlement security without an optimistic challenge period. zkSync is part of a broader effort to scale Ethereum through zero-knowledge cryptography."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ethereum-smart-contract-platform ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-availability ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:zero-knowledge-proof ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:rollup ],
        ngm:bc-network-component ;
    skos:broader ngm:bc-network-component ;
    vc:bridgesTo ngm:finance,
        ngm:security ;
    vc:contrastsWith ngm:arbitrum,
        ngm:optimism,
        ngm:optimistic-rollup,
        ngm:starknet ;
    vc:dependsOn ngm:cryptographic-hash-function,
        ngm:ethereum-mainnet,
        ngm:merkle-tree ;
    vc:enables ngm:cross-chain-bridging,
        ngm:decentralised-finance,
        ngm:low-cost-blockchain-transaction ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:validity-proof,
        ngm:zk-stack,
        ngm:zk-sync-era,
        ngm:zk-sync-lite ;
    vc:implements ngm:evm-compatibility,
        ngm:zk-rollup ;
    vc:isPartOf ngm:ethereum-ecosystem,
        ngm:layer-2-scaling-ecosystem ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:layer-2-network,
        ngm:polygon,
        ngm:polygon-zkevm ;
    vc:requires ngm:data-availability,
        ngm:ethereum-smart-contract-platform,
        ngm:rollup,
        ngm:zero-knowledge-proof,
        ngm:zk-prover ;
    vc:slug "zk-sync" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:erc-20-token,
        ngm:non-fungible-token,
        ngm:smart-contract ;
    vc:uses ngm:solidity,
        ngm:zk-snark,
        ngm:zk-stark .

ngm:3-d-li-dar a owl:Class ;
    rdfs:label "3D LiDAR"@en ;
    rdfs:comment "3D LiDAR is a active ranging sensor that emits pulsed laser light across multiple vertical channels to capture dense three-dimensional point clouds of the surrounding environment. Spinning or solid-state variants measure range and intensity for hundreds of thousands of points per second, enabling robots and autonomous vehicles to perform obstacle detection, SLAM, and high-fidelity scene reconstruction in real time."@en ;
    rdfs:subClassOf ngm:robo-perception ;
    skos:broader ngm:robo-perception ;
    vc:bridgesTo ngm:lidar ;
    vc:enables ngm:autonomous-navigation,
        ngm:point-cloud,
        ngm:simultaneous-localisation-and-mapping,
        ngm:slam ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:2-d-li-dar,
        ngm:lidar-scanning,
        ngm:multirotor-uav,
        ngm:stereo-camera ;
    vc:slug "3-d-li-dar" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:perception-system,
        ngm:sensor-fusion .

ngm:3-d-scene-reconstruction a owl:Class ;
    rdfs:label "3D Scene Reconstruction"@en ;
    rdfs:comment "3D Scene Reconstruction is the computational process of recovering a complete, coherent three-dimensional model of an environment or scene from sensor observations such as images, depth maps, or LiDAR returns, integrating multiple viewpoints and modalities into a unified representation. Methods include volumetric fusion, truncated signed distance function (TSDF) integration, neural implicit representations, and Gaussian splatting, each offering different trade-offs between completeness, accuracy, and real-time capability. The output is used in robotics, autonomous driving, spatial computing, and cultural heritage documentation."@en ;
    rdfs:subClassOf ngm:3-d-reconstruction ;
    vc:enables ngm:3-d-perception,
        ngm:ar-registration,
        ngm:digital-twin-creation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:3-d-scanning,
        ngm:gaussian-splatting,
        ngm:ne-rf ;
    vc:slug "3-d-scene-reconstruction" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:multi-view-stereo,
        ngm:simultaneous-localisation-and-mapping,
        ngm:structure-from-motion .

ngm:3-d-user-interface a owl:Class ;
    rdfs:label "3D User Interface"@en ;
    rdfs:comment "A 3D User Interface (3DUI) is an interactive control system within three-dimensional virtual environments enabling users to manipulate objects, navigate spaces, and access functionality through spatial gestures, hand tracking, gaze-based selection, and voice commands."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:hand-tracking ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:haptic-feedback ],
        ngm:sc-interaction ;
    skos:broader ngm:sc-interaction ;
    vc:bridgesTo ngm:interaction-design,
        ngm:user-interface ;
    vc:enables ngm:accessible-immersion,
        ngm:intuitive-interaction,
        ngm:user-navigation ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires ngm:gaze-tracking,
        ngm:hand-tracking,
        ngm:haptic-feedback,
        ngm:voice-input ;
    vc:slug "3-d-user-interface" ;
    vc:sourceDomain "spatial-computing" .

ngm:3d-reconstruction a skos:Concept ;
    rdfs:label "3d Reconstruction"@en .

ngm:5-g-connectivity a owl:Class ;
    rdfs:label "5G Connectivity"@en ;
    rdfs:comment "5G Connectivity is the set of radio access and core network capabilities delivered by a 5G NR network that provides devices and applications with wireless communication services characterised by high throughput, ultra-low latency, and high device density. It encompasses the radio link between user equipment and the gNB base station, quality-of-service mechanisms, network slicing for application-specific service guarantees, and the APIs through which applications access network capabilities. 5G Connectivity is a critical enabler for cloud XR, autonomous systems, and real-time industrial applications."@en ;
    rdfs:subClassOf ngm:5-g ;
    vc:enables ngm:io-t-infrastructure,
        ngm:low-latency,
        ngm:xr-applications ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:3-gpp,
        ngm:guaranteed-bandwidth,
        ngm:latency ;
    vc:slug "5-g-connectivity" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:5-g-network,
        ngm:multi-access-edge-computing,
        ngm:network-function-virtualization .

ngm:MaturityLevel a owl:Class ;
    rdfs:label "Maturity Level"@en .

ngm:access-control-policy a owl:Class ;
    rdfs:label "Access Control Policy"@en ;
    rdfs:comment "An Access Control Policy is a machine-readable specification of the rules that determine which agents may read, write, or append to a given resource. In decentralized web-data systems such as Solid, policies are expressed as RDF documents (e.g. WAC or ACP) attached to resources, granting or denying modes of access to identified WebID principals or groups. The policy is the declarative source of truth that an authorization engine evaluates on each request."@en ;
    rdfs:subClassOf ngm:infra-security-and-identity ;
    skos:broader ngm:infra-security-and-identity ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:identity-management,
        ngm:solid ;
    vc:slug "access-control-policy" ;
    vc:sourceDomain "security" .

ngm:accountability-framework a owl:Class ;
    rdfs:label "Accountability Framework"@en ;
    rdfs:comment "An accountability framework is a structured set of principles, roles, processes, and controls that together define how responsibility for outcomes is assigned, tracked, and enforced within an organisation or system. It specifies who is answerable for decisions and actions, what evidence of responsible conduct must be maintained, and what redress or corrective measures apply when obligations are unmet. Accountability frameworks appear across governance, AI ethics, financial regulation, and public sector administration."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:audit ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:transparency ],
        ngm:governance-framework ;
    vc:enables ngm:accountability-mechanism,
        ngm:compliance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:accountability,
        ngm:regulatory-framework ;
    vc:requires ngm:audit,
        ngm:transparency ;
    vc:slug "accountability-framework" ;
    vc:sourceDomain "governance" .

ngm:additive-manufacturing a owl:Class ;
    rdfs:label "Additive Manufacturing"@en ;
    rdfs:comment "Additive manufacturing (AM) is a family of processes that construct three-dimensional objects by depositing, sintering, or photopolymerising material layer by layer from a digital design file, in contrast to subtractive methods that remove material from a solid block. Processes include fused deposition modelling, selective laser sintering, stereolithography, binder jetting, and directed energy deposition, each suited to particular materials and resolution requirements. AM enables on-demand production of complex geometries, personalised products, and distributed manufacturing without the tooling investment of conventional production."@en ;
    rdfs:subClassOf ngm:digital-fabrication ;
    vc:contrastsWith ngm:collaborative-systems-modality-robotics ;
    vc:enables ngm:digital-fabrication ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:computer-vision-system,
        ngm:digital-twin-creation ;
    vc:slug "additive-manufacturing" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:cad-software,
        ngm:digital-twin .

ngm:adobe-firefly a owl:Class ;
    rdfs:label "Adobe Firefly"@en ;
    rdfs:comment "Adobe Firefly is Adobe's family of proprietary generative AI models designed for commercial creative applications, offering text-to-image generation, generative fill, vector recolouring, and text-effect capabilities trained exclusively on licensed Adobe Stock imagery, openly licensed content, and public domain material. Launched in March 2023, Firefly is embedded across Adobe Creative Cloud applications and is positioned as an enterprise-safe generative AI tool that provides intellectual property indemnification for commercial outputs. It represents Adobe's strategy to integrate generative AI natively into professional creative workflows."@en ;
    rdfs:subClassOf ngm:generative-ai ;
    vc:enables ngm:image-editing,
        ngm:image-generation ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:adobe-creative-cloud,
        ngm:content-licensing,
        ngm:digital-content-provenance-marking ;
    vc:slug "adobe-firefly" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:diffusion-model,
        ngm:text-to-image .

ngm:agent-memory a owl:Class ;
    rdfs:label "Agent Memory"@en ;
    rdfs:comment "Agent memory is the mechanism by which an autonomous agent stores and retrieves information across steps and sessions. It allows an agent to recall past observations, decisions and facts beyond the immediate context window."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:embeddings ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:vector-database ],
        ngm:ai-agent ;
    vc:enables ngm:agentic-workflow ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:embeddings,
        ngm:vector-database ;
    vc:slug "agent-memory" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:agent-orchestrator a owl:Class ;
    rdfs:label "Agent Orchestrator"@en ;
    rdfs:comment "An Agent Orchestrator is a control component within a multi-agent system responsible for decomposing high-level goals into sub-tasks, assigning those tasks to appropriate specialised agents, monitoring execution progress, handling failures and retries, and assembling partial results into coherent outputs. It acts as the coordination hub that transforms a pool of individual autonomous agents into a collaborative system capable of accomplishing complex, multi-step objectives."@en ;
    rdfs:subClassOf ngm:ai-agent-system ;
    vc:enables ngm:agentic-workflow,
        ngm:autonomous-task-execution ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:coordination-mechanisms ;
    vc:slug "agent-orchestrator" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:agent-communication-protocol,
        ngm:agent-runtime,
        ngm:task-planning .

ngm:agent-runtime a owl:Class ;
    rdfs:label "Agent Runtime"@en ;
    rdfs:comment "An Agent Runtime is the execution environment that manages the lifecycle, resource allocation, tool access, memory state, and communication channels of one or more autonomous AI agents. It provides the foundational services — process isolation, context persistence, tool-call dispatch, and inter-agent messaging — upon which agent application logic is built, analogous to how an operating system runtime supports application processes."@en ;
    rdfs:subClassOf ngm:ai-agent-system ;
    vc:enables ngm:autonomous-task-execution ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:execution-model ;
    vc:slug "agent-runtime" ;
    vc:sourceDomain "ai" ;
    vc:supports ngm:agent-orchestrator,
        ngm:agentic-workflow ;
    vc:uses ngm:model-context-protocol,
        ngm:tool-use .

ngm:agile-development a skos:Concept ;
    rdfs:label "Agile Development"@en .

ngm:agile-software-development a owl:Class ;
    rdfs:label "Agile Software Development"@en ;
    rdfs:comment "Agile Software Development is a family of iterative, incremental approaches to building software that prioritise working product increments, continuous stakeholder collaboration, and rapid adaptation to changing requirements over rigid up-front planning. Rooted in the 2001 Agile Manifesto, it encompasses frameworks such as Scrum, Kanban, Extreme Programming, and SAFe, each operationalising core values through time-boxed iterations, cross-functional teams, and frequent feedback loops. Agile practices shorten the feedback cycle between developers and end users, reduce the cost of change, and improve delivery predictability by surfacing risk early. It has become the dominant paradigm for professional software delivery and is increasingly applied to hardware, policy, and organisational transformation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:continuous-integration ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:software-development ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:extreme-programming ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:version-control ],
        ngm:software-engineering ;
    vc:bridgesTo ngm:distributed-systems,
        ngm:mlops,
        ngm:organisational-learning ;
    vc:contrastsWith ngm:big-design-up-front,
        ngm:waterfall-model ;
    vc:enables ngm:continuous-delivery,
        ngm:devops,
        ngm:lean-software-development,
        ngm:test-driven-development ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:extreme-programming,
        ngm:kanban,
        ngm:retrospective,
        ngm:scrum,
        ngm:sprint ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:distributed-teams,
        ngm:project-management,
        ngm:software-architecture ;
    vc:requires ngm:continuous-integration,
        ngm:software-development,
        ngm:version-control ;
    vc:slug "agile-software-development" ;
    vc:sourceDomain "distributed-collaboration" ;
    vc:standardizedBy ngm:agile-manifesto,
        ngm:scaled-agile-framework ;
    vc:uses ngm:pair-programming,
        ngm:product-backlog,
        ngm:user-story .

ngm:ai-avatars a owl:Class ;
    rdfs:label "AI Avatars"@en ;
    rdfs:comment "\"Virtual representations of human users generated and animated by artificial intelligence systems, employing machine learning models to synthesise photorealistic appearance, facial expressions, body movements, and speech from sensor inputs or user intentions, enabling realistic telepresence witho..."@en ;
