        ngm:collaborative-systems-modality-robotics,
        ngm:human-robot-interaction ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:functional-safety,
        ngm:risk-assessment,
        ngm:safety-monitoring ;
    vc:implements ngm:iec-62061,
        ngm:iso-10218,
        ngm:iso-13849 ;
    vc:isPartOf ngm:industrial-automation,
        ngm:robotics ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:human-factors,
        ngm:safety-integrity-level ;
    vc:requires ngm:collision-avoidance,
        ngm:force-torque-sensor,
        ngm:real-time-systems,
        ngm:sensor-fusion ;
    vc:slug "robot-safety" ;
