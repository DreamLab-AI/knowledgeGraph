ngm:ieee-control-systems-society a owl:Class ;
    rdfs:label "IEEE Control Systems Society"@en ;
    rdfs:comment "The IEEE Control Systems Society (CSS) is a professional technical organisation within the Institute of Electrical and Electronics Engineers dedicated to advancing the theory, design, and application of control systems across engineering disciplines. It publishes flagship journals including IEEE Transactions on Automatic Control and the IEEE Control Systems Magazine, and organises premier conferences such as the Conference on Decision and Control (CDC). The Society bridges classical control theory with modern machine learning and autonomous systems research, promoting standards, educational resources, and an international community of practitioners. Its technical committees address domains ranging from robotics and aerospace to networked systems and intelligent transportation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:feedback-control ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:control-theory ],
        ngm:control-system ;
    vc:bridgesTo ngm:artificial-intelligence,
        ngm:deep-learning,
        ngm:machine-learning-discipline ;
    vc:enables ngm:autonomous-system,
        ngm:cyber-physical-systems,
        ngm:model-predictive-control ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:ieee ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:embedded-systems,
        ngm:model-based-control,
        ngm:safety-critical-systems ;
    vc:requires ngm:control-theory,
        ngm:feedback-control ;
    vc:slug "ieee-control-systems-society" ;
    vc:sourceDomain "robotics" ;
    vc:standardizedBy ngm:control-theory,
        ngm:ieee-standards ;
    vc:supports ngm:autonomous-robot,
        ngm:autonomous-system,
        ngm:autonomous-vehicle,
        ngm:multi-agent-system,
        ngm:robotics ;
    vc:uses ngm:optimal-control,
        ngm:reinforcement-learning,
        ngm:state-space-representation .

ngm:ifrs-s2 a owl:Class ;
    rdfs:label "IFRS S2"@en ;
    rdfs:comment "IFRS S2 is the climate-related disclosure standard issued by the International Sustainability Standards Board, specifying how entities report climate-related risks and opportunities. Building on the TCFD recommendations, it requires disclosure of physical and transition risks, greenhouse-gas emissions across Scopes 1 to 3, and climate-resilience analysis. IFRS S2 operates alongside the general IFRS S1 baseline."@en ;
    rdfs:subClassOf ngm:technical-standard ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:ifrs-s1 ;
    vc:slug "ifrs-s2" ;
    vc:sourceDomain "governance" ;
    vc:supports ngm:esg-reporting .

ngm:image-editing a owl:Class ;
    rdfs:label "Image Editing"@en ;
    rdfs:comment "Image editing is the process of altering or enhancing digital images using software tools, encompassing operations such as colour correction, compositing, retouching, masking, and applying filters or effects. Modern image editing spans a spectrum from manual pixel-level manipulation to AI-driven automated transformations that interpret semantic content to intelligently modify or generate imagery."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:super-resolution ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:image-segmentation ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:inpainting ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:colour-grading ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:graphics-processing-unit ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:image-processing ],
        ngm:content-creation ;
    vc:bridgesTo ngm:digital-watermarking,
        ngm:spatial-computing ;
    vc:contrastsWith ngm:3d-modelling,
        ngm:image-generation ;
    vc:dependsOn ngm:machine-learning,
        ngm:neural-network ;
    vc:enables ngm:content-creation-pipeline,
        ngm:content-provenance,
        ngm:digital-content-creation,
        ngm:visual-effects ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:colour-grading,
        ngm:image-segmentation,
        ngm:inpainting,
        ngm:super-resolution ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:creative-tools,
        ngm:media-authenticity,
        ngm:style-transfer ;
    vc:requires ngm:graphics-processing-unit,
        ngm:image-processing ;
    vc:slug "image-editing" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:colour-management,
