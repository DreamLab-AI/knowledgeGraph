ngm:eip-4844 a owl:Class ;
    rdfs:label "EIP-4844"@en ;
    rdfs:comment "EIP-4844, known as Proto-Danksharding or 'Shard Blob Transactions', is an Ethereum Improvement Proposal activated on the Ethereum mainnet in March 2024 that introduces a new transaction type carrying temporary binary large objects (blobs) of data. Each blob is approximately 128 KB, persists for a short window (roughly two weeks) rather than being stored permanently in Ethereum state, and is made accessible to smart contracts only via a cryptographic commitment. The proposal dramatically reduces the data posting costs for Layer-2 rollups by creating a dedicated, cheap data-availability lane, providing a foundation for full Danksharding without requiring immediate shard implementation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ethereum ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:proof-of-stake ],
        ngm:bc-protocol-and-consensus ;
    skos:broader ngm:bc-protocol-and-consensus ;
    vc:bridgesTo ngm:decentralised-storage ;
    vc:contrastsWith ngm:calldata,
        ngm:full-danksharding ;
    vc:enables ngm:danksharding,
        ngm:data-availability-sampling,
        ngm:layer-2-scaling ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:ethereum-cancun-upgrade ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:data-availability,
        ngm:eip-1559,
        ngm:ethereum-improvement-proposal,
        ngm:gas-fee-mechanism ;
    vc:requires ngm:ethereum,
        ngm:kzg-commitment,
        ngm:proof-of-stake ;
    vc:slug "eip-4844" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:ethereum-scalability,
        ngm:optimistic-rollup,
        ngm:zk-rollup ;
    vc:uses ngm:beacon-chain,
        ngm:blob-transaction,
        ngm:elliptic-curve-cryptography,
        ngm:polynomial-commitment .

ngm:emergent-gameplay a owl:Class ;
    rdfs:label "Emergent Gameplay"@en ;
    rdfs:comment "Emergent Gameplay refers to complex, often unanticipated play behaviours, strategies, and narratives that arise spontaneously from the interaction of relatively simple, well-defined game rules, systems, and player agency, rather than being explicitly scripted or designed by the game's creators. It occurs when the combinatorial space of game mechanics, physics simulations, AI agent behaviours, and player decisions produces outcomes that exceed the designers' explicit intentions, creating novel experiences from the bottom up. Emergent gameplay is a hallmark of open-world, sandbox, and simulation genres, and is increasingly studied in the context of AI game agents and procedural content generation."@en ;
    rdfs:subClassOf ngm:game-mechanics ;
    vc:enables ngm:game-development ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:ai-game-agent,
        ngm:open-world,
        ngm:procedural-content-generation,
        ngm:procedural-generation,
        ngm:simulation ;
    vc:slug "emergent-gameplay" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:game-engine,
        ngm:physics-simulation .

