    vc:implements ngm:data-minimisation,
        ngm:privacy-by-design ;
    vc:isPartOf ngm:governance,
        ngm:regulatory-compliance ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:data-portability,
