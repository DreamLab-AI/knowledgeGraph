ngm:standardized-asset-classification a owl:Class ;
    rdfs:comment "Systematic taxonomies and frameworks for categorizing digital assets including cryptocurrencies, NFTs, and metaverse tokens based on characteristics such as issuance mod, value mechanism, rights conferred, fungibility, and redemption properties."@en ;
    rdfs:label "Standardized Asset Classification"@en ;
