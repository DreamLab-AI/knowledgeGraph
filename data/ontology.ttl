ngm:decision-support-system a skos:Concept ;
    rdfs:label "Decision Support System"@en .

ngm:decision-transparency a owl:Class ;
    rdfs:label "Decision Transparency"@en ;
    rdfs:comment "Decision transparency is the property of an AI system whereby the basis, logic, and contributing factors of its outputs are made accessible and comprehensible to relevant stakeholders. It requires that decision processes be traceable — from input data through model architecture to final output — and that explanations be appropriate to the audience, whether technical developers, domain experts, or affected individuals. Decision transparency is a foundational prerequisite for meaningful accountability, contestability, and regulatory compliance in AI deployments."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:interpretability ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:explainable-ai ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:audit-trail ],
        ngm:ai-governance-and-ethics ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:enables ngm:accountability,
        ngm:ai-trustworthiness,
        ngm:algorithmic-accountability ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:ai-ethics,
        ngm:ai-fairness,
        ngm:ai-model-card,
        ngm:algorithmic-transparency-index,
        ngm:human-oversight,
        ngm:model-interpretability,
        ngm:stakeholder-engagement-in-ai ;
    vc:requires ngm:audit-trail,
        ngm:explainable-ai,
        ngm:interpretability ;
    vc:slug "decision-transparency" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:ai-governance,
        ngm:regulatory-compliance,
        ngm:responsible-ai .

ngm:deepfake-detection a owl:Class ;
    rdfs:label "Deepfake Detection"@en ;
    rdfs:comment "Deepfake detection is the application of machine learning and signal processing techniques to identify synthetic or manipulated media—including face-swapped video, voice-cloned audio, and AI-generated images—by analysing artefacts, inconsistencies, and statistical signatures that distinguish fabricated from authentic content. It operates as a countermeasure to generative adversarial networks and related synthesis methods."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:training-dataset ],
        ngm:computer-vision ;
    vc:bridgesTo ngm:ai-regulation,
        ngm:c2pa ;
    vc:contrastsWith ngm:deepfakes,
        ngm:generative-adversarial-network,
        ngm:synthetic-media ;
    vc:dependsOn ngm:deep-learning,
        ngm:signal-processing ;
    vc:enables ngm:content-authentication,
        ngm:content-authenticity,
        ngm:disinformation-mitigation,
        ngm:media-forensics ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:audio-forensics,
        ngm:diffusion-model,
        ngm:generative-ai ;
    vc:requires ngm:training-dataset,
        ngm:video-analysis ;
    vc:slug "deepfake-detection" ;
    vc:sourceDomain "ai" ;
    vc:supports ngm:content-provenance,
        ngm:platform-trust-and-safety ;
    vc:uses ngm:convolutional-neural-network,
        ngm:face-recognition,
        ngm:frequency-domain-analysis,
        ngm:machine-learning-discipline,
        ngm:neural-network,
        ngm:vision-transformer .

ngm:delta-robot a owl:Class ;
    rdfs:label "Delta Robot"@en ;
    rdfs:comment "Delta robot employs parallel kinematics where three or more kinematic chains connect actuators to an end-effector platform, constraining motion through parallelogram linkages to pure translation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:kinematic-chain ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:synchronisation ],
        ngm:industrial-robot,
        ngm:parallel-robot,
        ngm:robo-robot-type ;
    skos:broader ngm:robo-robot-type ;
    vc:enables ngm:high-speed-picking,
        ngm:parallel-processing,
        ngm:rapid-sorting,
        ngm:ultra-fast-placement ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:actuator-motors,
        ngm:end-effector-platform,
        ngm:kinematic-chain,
        ngm:parallelogram-linkages ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires ngm:coordinated-control,
        ngm:high-performance-actuators,
        ngm:stiff-support-structure,
        ngm:synchronisation ;
    vc:slug "delta-robot" ;
    vc:sourceDomain "robotics" .

ngm:democratic-governance a owl:Class ;
    rdfs:label "Democratic Governance"@en ;
    rdfs:comment "Democratic Governance is an infrastructure concept."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:regulatory-framework ],
        ngm:infra-legal-and-regulatory ;
    skos:broader ngm:infra-legal-and-regulatory ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:regulatory-framework ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:slug "democratic-governance" ;
    vc:sourceDomain "infrastructure" .

ngm:determinism a owl:Class ;
    rdfs:label "Determinism"@en ;
    rdfs:comment "Determinism, in computing and distributed systems, is the property by which a computational process produces identical outputs given identical inputs and initial state, regardless of when, where, or how many times it is executed. Deterministic systems are essential for reproducibility of scientific experiments, predictability of embedded and safety-critical control systems, and correctness of distributed consensus protocols where all participating nodes must reach the same conclusion from the same inputs. In the context of blockchain and smart contracts, determinism is a hard requirement because non-deterministic execution would cause different nodes to compute different state transitions, breaking consensus."@en ;
    rdfs:subClassOf ngm:consensus-mechanism ;
    vc:contrastsWith ngm:probabilistic-model,
        ngm:stochastic-process ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:consensus-algorithm,
        ngm:formal-verification,
        ngm:random-number-generation,
        ngm:state-machine-replication ;
    vc:slug "determinism" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:automated-reasoning,
        ngm:blockchain,
        ngm:cyber-physical-systems .

ngm:dexterous-manipulation a owl:Class ;
    rdfs:label "Dexterous Manipulation"@en ;
    rdfs:comment "Dexterous manipulation is the capability of robotic systems to grasp, reorient, assemble, and interact with objects using multi-fingered hands or compliant end-effectors in ways that require fine motor control, contact-rich reasoning, and real-time adaptation to object geometry and physical properties. It encompasses grasp planning, in-hand manipulation, and tactile feedback integration to replicate or exceed human-hand dexterity in unstructured environments."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:end-effector ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:kinematics ],
