    vcw:owlRole "Concept" .

# US Regulatory Framework
blockchain:USRegulatoryFramework rdf:type owl:Class ;
    rdfs:label "US Regulatory Framework"@en ;
    rdfs:comment "US cryptocurrency regulation operates through a fragmented multi-agency framework where SEC applies securities law to tokens, FinCEN supervises money transmission and AMLKYCCompliance, the OCC addresses banking relationships, and the CFTC regulates cryptocurrency derivatives. This jurisdictional overlap creates compliance complexity, with inconsistent agency positions leading to regulatory uncertainty regarding token classification and exchange registration requirements, prompting Congressional proposals for comprehensive legislation establishing tailored digital asset frameworks. State-level MoneyTransmitterLicenses, banking charters, and inconsistent interpretations of existing laws further fragment the regulatory landscape, with major protocols and exchanges navigating dozens of jurisdiction-specific compliance requirements."@en ;
    skos:prefLabel "US Regulatory Framework"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:blockchain:us-regulatory-framework" ;
    owl:sameAs <urn:visionclaw:concept:blockchain:us-regulatory-framework> ;
    vcw:contentHash "sha256-12-8822fe34d5fd" ;
    vcw:qualityScore "0.4"^^xsd:decimal ;
    vcw:legacyTermId "BC-0483" ;
    vcw:ontologyStatus "stub-needs-content" ;
    vcw:maturityLevel "draft" ;
    vcw:authorityScore "0.0"^^xsd:decimal ;
    dcterms:identifier "BC-0483" ;
    dcterms:subject "blockchain" ;
    owl:versionInfo "2.0.0" ;
    dcterms:created "2026-04-26T00:00:00Z"^^xsd:dateTime ;
    dcterms:modified "2026-04-26T13:00:00Z"^^xsd:dateTime ;
    vcw:owlRole "Concept" .

