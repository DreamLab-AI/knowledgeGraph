        ngm:validation-data ;
    vc:requires ngm:model-capacity,
        ngm:model-training,
        ngm:training-data ;
    vc:slug "overfitting" ;
    vc:sourceDomain "machine-learning" ;
    vc:uses ngm:empirical-risk-minimisation,
        ngm:loss-function .

ngm:perception-system a owl:Class ;
    rdfs:label "Perception System"@en ;
    rdfs:comment "A Perception System is the sensor processing and environmental understanding component of Autonomous Systems that interprets raw Sensor Data to build a coherent representation of the surrounding environment, including Object Detection, Classification, Tracking, Localization, and Scene Understanding. Perception systems fuse data from multiple Sensor Modalities (Camera, LiDAR, Radar, Ultrasonic Sensors) to create robust environmental models for Autonomous Decision-Making."@en ;
