    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:ietf,
        ngm:linked-data,
        ngm:semantic-web,
        ngm:web-standard,
        ngm:web-standards ;
    vc:slug "w3-c" ;
    vc:sourceDomain "governance" ;
    vc:standardizedBy ngm:open-standard ;
