ngm:pathology-ai a owl:Class ;
    rdfs:label "Pathology AI"@en ;
    rdfs:comment "Artificial intelligence systems for automated analysis of histopathology slides, cytology specimens, and other pathological images. Pathology AI performs tasks including cancer detection and grading, biomarker quantification, and morphological analysis using whole-slide imaging pipelines and deep learning architectures tailored for gigapixel images at multi-scale resolution."@en ;
