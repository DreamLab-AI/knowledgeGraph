    rdfs:label "Graph Colouring"@en .
ngm:graph-convolutional-network a owl:Class ;
    rdfs:comment "A graph neural network architecture that generalises convolution to graph-structured data: each layer updates every node's feature vector by aggregating the degree-normalised features of its neighbours and transforming them with a shared learned weight matrix, so stacked layers propagate information across progressively larger neighbourhoods; formalised by Kipf and Welling in 2017 as a first-order approximation of spectral graph convolution, the GCN is the canonical baseline for node classification, link prediction, and graph-level learning."@en ;
    rdfs:label "Graph Convolutional Network"@en ;
    rdfs:subClassOf ngm:graph-neural-network ;
