        ngm:convex-optimisation,
        ngm:optimisation,
        ngm:stochastic-gradient-descent ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:information-theory,
        ngm:statistics ;
    vc:requires ngm:linear-algebra ;
    vc:slug "calculus" ;
    vc:sourceDomain "machine-learning" ;
    vc:supports ngm:deep-learning,
        ngm:machine-learning,
        ngm:neural-network ;
    vc:uses ngm:numerical-methods .

