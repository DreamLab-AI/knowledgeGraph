        ngm:data-governance ;
    vc:enables ngm:ai-deployment,
        ngm:continuous-training,
        ngm:inference,
        ngm:model-monitoring,
        ngm:model-training ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:experiment-tracking,
        ngm:feature-store,
        ngm:machine-learning-pipeline,
        ngm:model-registry ;
    vc:isPartOf ngm:ai-lifecycle ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:ab-testing,
        ngm:data-drift,
        ngm:model-serving ;
    vc:requires ngm:data-pipeline,
