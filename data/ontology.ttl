    vc:requires ngm:data-governance,
        ngm:data-integration,
        ngm:data-quality-management ;
    vc:slug "data-analytics" ;
    vc:sourceDomain "data" ;
    vc:uses ngm:data-lake,
        ngm:data-pipeline,
        ngm:data-visualisation,
        ngm:data-warehouse,
        ngm:machine-learning,
        ngm:statistical-modelling .

ngm:did-document a owl:Class ;
    rdfs:label "DID Document"@en ;
    rdfs:comment "A DID Document is a JSON-LD resource resolved from a Decentralised Identifier (DID) that expresses the DID subject's cryptographic public keys, authentication methods, assertion methods, key agreement protocols, capability delegation mechanisms, and service endpoints. Defined by the W3C DID Core specification, a DID Document is the machine-readable artefact that enables any verifier to discover how to authenticate with or communicate securely to a DID subject without relying on a centralised identity authority. DID Documents are anchored to a Verifiable Data Registry — such as a distributed ledger, blockchain, or peer-to-peer network — via a DID method-specific read operation, making them a foundational component of self-sovereign identity and verifiable credential ecosystems."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:did-method ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:verifiable-data-registry ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:did-resolver ],
        ngm:decentralised-identifier ;
    vc:bridgesTo ngm:agent-identity,
        ngm:zero-knowledge-proof ;
    vc:contrastsWith ngm:centralised-identity-provider,
        ngm:x-509-certificate ;
    vc:enables ngm:decentralised-authentication,
        ngm:key-agreement-protocol,
        ngm:verifiable-credentials ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:service-endpoint,
        ngm:verification-method,
        ngm:verification-relationship ;
    vc:isPartOf ngm:decentralised-identifier,
        ngm:self-sovereign-identity ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:did-resolution,
        ngm:did-url,
        ngm:digital-identity,
        ngm:identity-verification ;
    vc:requires ngm:did-method,
        ngm:did-resolver,
        ngm:verifiable-data-registry ;
    vc:slug "did-document" ;
    vc:sourceDomain "blockchain" ;
    vc:standardizedBy ngm:w3c,
        ngm:w3c-did-core ;
    vc:uses ngm:digital-signature,
        ngm:json-ld,
        ngm:linked-data,
        ngm:public-key-cryptography .

ngm:event-driven-architecture a owl:Class ;
    rdfs:label "Event Driven Architecture"@en ;
    rdfs:comment "A software architecture pattern built from decoupled services that publish, consume, and route events representing state changes, enabling real-time responsiveness, independent scaling, and resilient distributed systems."@en ;
