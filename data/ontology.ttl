ngm:optimism a owl:Class ;
    rdfs:label "Optimism"@en ;
    rdfs:comment "Optimism is an Ethereum layer-2 scaling network that uses optimistic rollup technology to process transactions off the main chain while inheriting Ethereum security. Launched on mainnet in late 2021 by OP Labs, it batches transactions and posts compressed data and state commitments to Ethereum, assuming validity unless challenged within a dispute window. It is closely associated with the OP Stack, a modular open-source framework for building rollup chains, and the broader Superchain concept that links such chains. The OP token governs the Optimism Collective and funds public-goods initiatives through retroactive funding rounds."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ethereum-smart-contract-platform ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:fraud-proof ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:rollup ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:optimism-collective ],
        ngm:blockchain ;
    skos:broader ngm:blockchain ;
    vc:bridgesTo ngm:decentralised-governance,
        ngm:retroactive-public-goods-funding ;
    vc:contrastsWith ngm:arbitrum,
        ngm:polygon,
        ngm:zero-knowledge-rollup,
        ngm:zk-sync ;
    vc:dependsOn ngm:eip-4844 ;
    vc:enables ngm:decentralised-finance,
        ngm:layer-2-scaling,
        ngm:public-goods-funding,
        ngm:superchain ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:op-stack,
        ngm:op-token,
        ngm:optimism-collective ;
    vc:implements ngm:evm-equivalence,
        ngm:optimistic-rollup ;
    vc:isPartOf ngm:ethereum-ecosystem,
        ngm:superchain ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:base-chain,
        ngm:cross-chain-interoperability ;
    vc:requires ngm:dispute-game,
        ngm:ethereum-smart-contract-platform,
        ngm:fraud-proof,
        ngm:rollup,
        ngm:sequencer ;
    vc:slug "optimism" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:state-commitment .

ngm:penetration-testing a owl:Class ;
    rdfs:label "Penetration Testing"@en ;
    rdfs:comment "Penetration testing is an authorised, structured simulation of real-world adversarial attacks against computing systems, networks, or applications, conducted to identify exploitable vulnerabilities before malicious actors can leverage them. Skilled practitioners — called penetration testers or ethical hackers — follow an agreed scope and rules of engagement, systematically applying the same techniques, tools, and thought processes used by genuine threat actors. Findings are documented with severity ratings, proof-of-concept evidence, and remediation guidance, directly informing an organisation's risk management and security improvement programme. The discipline bridges theoretical vulnerability knowledge with practical risk quantification, distinguishing it from automated scanning or passive audit activities."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:threat-modelling ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:vulnerability-management ],
        ngm:cybersecurity ;
    vc:bridgesTo ngm:ai-security,
        ngm:software-testing ;
    vc:contrastsWith ngm:bug-bounty-programme,
        ngm:security-audit,
        ngm:vulnerability-scanning ;
    vc:enables ngm:information-security,
        ngm:risk-management,
        ngm:security-hardening ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:exploit-development,
        ngm:post-exploitation,
        ngm:reconnaissance,
        ngm:vulnerability-scanning ;
    vc:isPartOf ngm:red-teaming,
        ngm:security-assessment ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:ethical-hacking,
        ngm:incident-response,
        ngm:threat-intelligence,
        ngm:zero-day-vulnerability ;
    vc:requires ngm:rules-of-engagement,
        ngm:threat-modelling,
        ngm:vulnerability-management ;
    vc:slug "penetration-testing" ;
    vc:sourceDomain "security" ;
    vc:standardizedBy ngm:nist-sp-800-115,
        ngm:owasp,
        ngm:ptes ;
    vc:uses ngm:exploit-framework,
        ngm:network-protocol-analysis,
        ngm:social-engineering .

ngm:perception a owl:Class ;
    rdfs:label "Perception"@en ;
    rdfs:comment "Perception is the computational process by which an intelligent system acquires, processes, and interprets sensory signals — such as visual, auditory, tactile, or LiDAR data — to construct an internal, structured representation of the external world. It forms the foundational input stage of the sense–plan–act loop that underpins autonomous agents and robotics, translating high-dimensional raw sensor streams into semantically meaningful features, objects, or scene graphs. Modern AI perception leverages deep neural architectures — including convolutional networks, vision transformers, and multimodal encoders — to achieve robust generalisation across varied environments. It is distinct from raw data acquisition (sensing) and from higher-order cognitive reasoning, occupying the middle layer that makes physical-world understanding tractable for downstream decision systems."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:sensor ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:object-detection ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
