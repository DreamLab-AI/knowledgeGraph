    vc:requires ngm:vulnerability ;
    vc:slug "exploit" ;
    vc:sourceDomain "security" ;
    vc:standardizedBy ngm:standards ;
    vc:supports ngm:penetration-testing ;
    vc:uses ngm:attack-vector .

ngm:farcaster a owl:Class ;
    rdfs:label "Farcaster"@en ;
    rdfs:comment "Farcaster is a sufficiently decentralised social networking protocol built on Ethereum and Optimism that anchors user identity and account data on-chain while storing social graph content and messages off-chain across a peer-to-peer network of Hubs. It separates identity (Farcaster ID, FID) from the client application layer, enabling permissionless third-party clients such as Warpcast to build on shared social data without platform lock-in. The protocol specifies message encoding via a data availability layer called Hubs and enforces message ordering through a CRDT-based conflict resolution mechanism, making it a credibly neutral substrate for decentralised social applications."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ethereum ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:optimism ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:decentralised-identity ],
        ngm:bc-network-component ;
    skos:broader ngm:bc-network-component ;
    vc:bridgesTo ngm:ai-agent,
        ngm:decentralised-autonomous-organisation ;
    vc:contrastsWith ngm:activity-pub,
        ngm:bluesky-at-protocol,
        ngm:nostr ;
    vc:dependsOn ngm:crdt,
        ngm:peer-to-peer-network,
        ngm:smart-contract ;
    vc:enables ngm:portable-identity,
        ngm:social-network-graph,
        ngm:web3 ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:open-protocol ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:data-availability,
        ngm:decentralised-identifier,
        ngm:lens-protocol ;
    vc:requires ngm:decentralised-identity,
        ngm:ethereum,
        ngm:optimism ;
    vc:slug "farcaster" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:content-addressing,
        ngm:ethereum-smart-contract-platform-name-service,
        ngm:proof-of-work .

ngm:fatf-guidance-on-virtual-assets a owl:Class ;
    rdfs:label "FATF Guidance on Virtual Assets"@en ;
    rdfs:comment "The FATF Guidance on Virtual Assets is the Financial Action Task Force's risk-based interpretation of how its anti-money-laundering standards apply to virtual assets and virtual-asset service providers (VASPs). It defines key terms, requires VASP licensing or registration and supervision, and introduces the 'travel rule' obliging the transfer of originator and beneficiary information with transactions. The guidance shapes how exchanges, custodians, and DeFi arrangements are regulated worldwide."@en ;
    rdfs:subClassOf ngm:financial-regulation ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:cbdcs,
        ngm:decentralized-finance-de-fi ;
    vc:slug "fatf-guidance-on-virtual-assets" ;
    vc:sourceDomain "blockchain" .

ngm:fault-tolerant-control a skos:Concept ;
    rdfs:label "Fault Tolerant Control"@en .

ngm:federated-byzantine-fault-tolerance a owl:Class ;
    rdfs:label "Federated Byzantine Fault Tolerance"@en ;
    rdfs:comment "Federated Byzantine Fault Tolerance (FBFT) is a consensus mechanism in which each node independently selects a trusted subset of peers—its quorum slice—forming overlapping quorums that propagate agreement without requiring global participation or expensive proof-of-work computation. Unlike classic BFT protocols that demand a fixed, known validator set, FBFT allows open membership: any node may join by declaring its quorum slices, and safety is guaranteed as long as quorum intersections contain at least one correct node. FBFT underpins the Stellar Consensus Protocol (SCP), enabling low-latency, high-throughput cross-border payment settlement with safety and liveness properties derived from quorum-intersection analysis."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:distributed-ledger ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gossip-protocol ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:node ],
        ngm:bc-protocol-and-consensus,
        ngm:byzantine-fault-tolerance ;
    skos:broader ngm:bc-protocol-and-consensus ;
    vc:contrastsWith ngm:proof-of-stake,
        ngm:proof-of-work ;
    vc:enables ngm:finality,
        ngm:interoperability,
        ngm:transaction ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:block,
        ngm:blockchain,
        ngm:distributed-system,
        ngm:security ;
    vc:requires ngm:distributed-ledger,
        ngm:gossip-protocol,
        ngm:node ;
    vc:slug "federated-byzantine-fault-tolerance" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:consensus-mechanism,
        ngm:network-protocol .

ngm:federated-credential-exchange a owl:Class ;
    rdfs:label "Federated Credential Exchange"@en ;
    rdfs:comment "A cross-platform workflow process that enables secure sharing and translation of identity credentials between different identity providers using standardized protocols, attribute mapping, and user consent mechanisms."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptographic-keys ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:federation-protocol ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:consent-management ],
        ngm:infra-security-and-identity ;
    skos:broader ngm:infra-security-and-identity ;
    vc:bridgesTo ngm:attribute-sharing ;
    vc:enables ngm:attribute-sharing,
        ngm:cross-platform-identity,
        ngm:privacy-preserving-authentication,
        ngm:single-sign-on ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:attribute-translation,
        ngm:consent-verification,
        ngm:credential-request,
        ngm:secure-exchange-protocol ;
    vc:isPartOf ngm:federated-identity-system,
        ngm:trust-framework ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:attribute-schema,
        ngm:consent-management,
        ngm:cryptographic-keys,
        ngm:federation-protocol ;
    vc:slug "federated-credential-exchange" ;
    vc:sourceDomain "infrastructure" .

ngm:federated-identity-system a owl:Class ;
    rdfs:label "Federated Identity System"@en ;
    rdfs:comment "A federated identity system enables a user's digital identity and authentication to be recognised across multiple independent organisations or domains without each maintaining separate credentials. It relies on trust relationships between identity providers and relying parties, exchanging assertions via protocols such as SAML, OpenID Connect, and OAuth. Federation underpins single sign-on, cross-organisation access, and trust-framework governance."@en ;
    rdfs:subClassOf ngm:identity-management ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:federated-credential-exchange,
        ngm:trust-framework-policy ;
    vc:slug "federated-identity-system" ;
    vc:sourceDomain "security" .

ngm:feeless-blockchain a owl:Class ;
    rdfs:label "Feeless Blockchain"@en ;
    rdfs:comment "A feeless blockchain is a distributed ledger that allows transactions to be submitted without an explicit per-transaction fee paid to validators. Such designs replace fee-based economics with alternative mechanisms — for example directed acyclic graph structures where each sender contributes a small proof-of-work to confirm prior transactions, or networks where validators are compensated through other means. Feeless models aim to enable micropayments and machine-to-machine value transfer that fee-bearing chains render uneconomic. They must still solve spam prevention and resource accounting without using fees as the deterrent."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:consensus-mechanism ],
        ngm:blockchain ;
    skos:broader ngm:blockchain ;
    vc:bridgesTo ngm:scalability ;
    vc:contrastsWith ngm:gas-fee,
        ngm:transaction-fee ;
    vc:dependsOn ngm:consensus ;
    vc:enables ngm:micropayment ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:implements ngm:proof-of-history ;
    vc:isPartOf ngm:blockchain ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:directed-acyclic-graph,
        ngm:sybil-attack,
        ngm:validator ;
    vc:requires ngm:consensus-mechanism ;
    vc:slug "feeless-blockchain" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:energy-efficiency ;
    vc:uses ngm:directed-acyclic-graph,
        ngm:proof-of-work .

ngm:few-shot-examples a owl:Class ;
    rdfs:label "Few-Shot Examples"@en ;
    rdfs:comment "Few-shot examples are a small set of input-output demonstrations placed within a language model's prompt to illustrate the desired task, format, or reasoning pattern. By conditioning on these in-context examples, the model can perform the task without weight updates, leveraging in-context learning. The number, quality, ordering, and representativeness of the examples strongly influence output accuracy and consistency."@en ;
    rdfs:subClassOf ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:context-engineering,
        ngm:few-shot-prompting ;
    vc:slug "few-shot-examples" ;
    vc:sourceDomain "ai" .

