    vc:isPartOf ngm:russell-group ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:alan-turing-institute,
        ngm:imperial-college-london,
        ngm:research-institution,
        ngm:university-of-edinburgh,
        ngm:university-of-manchester,
        ngm:university-of-oxford ;
    vc:slug "university-of-cambridge" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:ai-safety,
        ngm:open-source-software,
        ngm:technology-transfer .

ngm:urban-computing a owl:Class ;
    rdfs:label "Urban Computing"@en ;
    rdfs:comment "Urban Computing is the acquisition, integration, and analysis of large, heterogeneous data generated by sensors, devices, vehicles, and people in cities to understand and improve urban systems. It applies data analytics, machine learning, and pervasive sensing to problems such as traffic management, energy use, environmental monitoring, and public services. Drawing on Internet of Things infrastructure and geospatial data, urban computing closes the loop between sensing the city and acting on it. It is closely related to the smart cities agenda and to ubiquitous and pervasive computing."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:ubiquitous-computing ],
        ngm:ubiquitous-computing ;
    vc:bridgesTo ngm:infrastructure ;
    vc:dependsOn ngm:edge-computing,
        ngm:sensor-networks ;
    vc:enables ngm:energy-management,
        ngm:traffic-management ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:ubiquitous-computing ;
    vc:implements ngm:data-pipeline ;
    vc:isPartOf ngm:ubiquitous-computing ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:pervasive-computing,
        ngm:smart-cities,
        ngm:smart-city ;
    vc:slug "urban-computing" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:smart-grid ;
    vc:uses ngm:data-analytics,
        ngm:geospatial-data,
        ngm:gis,
        ngm:internet-of-things .

