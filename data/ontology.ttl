ngm:vyper a owl:Class ;
    rdfs:label "Vyper"@en ;
    rdfs:comment "Vyper is a contract-oriented, statically typed programming language for the Ethereum Virtual Machine (EVM) that prioritises security, simplicity, and auditability over expressive power. Inspired by Python syntax, it deliberately omits class inheritance, function overloading, recursive calling, and inline assembly to eliminate entire categories of smart-contract vulnerabilities. The language enforces bounds checking, explicit integer overflow handling, and strong typing so that the compiled EVM bytecode is tractable for formal verification and manual code review. Vyper was initially specified by Vitalik Buterin and the Ethereum Foundation team as a safer companion language to Solidity."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ethereum ],
        ngm:programming-language ;
    vc:bridgesTo ngm:formal-methods,
        ngm:program-analysis ;
    vc:contrastsWith ngm:fe-language,
        ngm:solidity,
        ngm:yul ;
    vc:enables ngm:decentralised-finance,
        ngm:formal-verification,
        ngm:smart-contract ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:erc-20,
        ngm:erc-721 ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:compound-protocol,
        ngm:curve-finance,
        ngm:open-source-software ;
    vc:requires ngm:ethereum,
        ngm:ethereum-virtual-machine ;
    vc:slug "vyper" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:decentralised-autonomous-organisation,
        ngm:security-audit ;
    vc:uses ngm:abi-encoding,
        ngm:evm-bytecode,
        ngm:static-typing .

ngm:w-3-c-vocabulary a owl:Class ;
    rdfs:label "W3C Vocabulary"@en ;
    rdfs:comment "A vocabulary published by the World Wide Web Consortium (W3C). The specific vocabulary is not determined from the identifier alone."@en ;
