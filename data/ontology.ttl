ngm:broadcast-television a owl:Class ;
    rdfs:label "Broadcast Television"@en ;
    rdfs:comment "Broadcast television is the distribution of moving-image and audio content to a general audience over terrestrial, satellite, or cable channels, in which a single signal is transmitted simultaneously to many passive receivers. It evolved from analogue standards such as PAL and NTSC to digital systems like DVB and ATSC that carry compressed video over the same spectrum. As a one-to-many medium with scheduled programming, it contrasts with on-demand internet streaming."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:video-codec ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:video-compression ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:signal-processing ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:infrastructure ],
        ngm:infrastructure ;
    skos:broader ngm:infrastructure ;
    vc:bridgesTo ngm:entropy-coding ;
