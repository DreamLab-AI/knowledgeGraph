ngm:machine-unlearning a owl:Class ;
    rdfs:comment "A family of techniques for removing the influence of specific training examples from an already-trained machine learning model without retraining it from scratch, so that the resulting model behaves as if the deleted data had never been seen; motivated by privacy law (the right to erasure), copyright disputes, data poisoning remediation, and the removal of hazardous capabilities from foundation models."@en ;
    rdfs:label "Machine Unlearning"@en ;
    rdfs:subClassOf ngm:machine-learning-discipline ;
    vc:enables ngm:data-privacy ;
