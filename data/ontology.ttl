ngm:information-architecture a owl:Class ;
    rdfs:label "Information Architecture"@en ;
    rdfs:comment "Information Architecture (IA) is the discipline of structuring, organising, labelling, and navigating shared information environments so that users and automated systems can find, understand, and act on content efficiently. It encompasses the design of taxonomies, controlled vocabularies, navigation schemas, metadata frameworks, and search systems that govern how information is classified and retrieved across digital products, knowledge bases, and interconnected platforms. IA bridges human cognitive models and machine-interpretable representations, drawing on ontologies, thesauri, and faceted classification to ensure content remains discoverable, reusable, and interoperable. In distributed and spatial contexts it extends to the semantic namespacing of assets, entities, and services that underpin cross-platform data exchange."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:controlled-vocabulary ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:metadata-standard ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:user-research ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:corporate-tax-compliance-frameworkonomy ],
        ngm:knowledge-organization-system ;
    vc:bridgesTo ngm:knowledge-graph,
        ngm:spatial-computing ;
    vc:contrastsWith ngm:data-architecture,
        ngm:software-architecture ;
    vc:dependsOn ngm:data-modelling,
        ngm:metadata-management ;
    vc:enables ngm:information-retrieval,
        ngm:knowledge-discovery,
        ngm:semantic-interoperability,
        ngm:user-experience-design ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:controlled-vocabulary,
        ngm:corporate-tax-compliance-frameworkonomy,
        ngm:metadata-standard ;
    vc:qualityScore "0.73"^^xsd:float ;
    vc:relatedTo ngm:content-management-system,
        ngm:human-computer-interaction ;
    vc:requires ngm:content-strategy,
        ngm:user-research ;
    vc:slug "information-architecture" ;
    vc:sourceDomain "data" ;
    vc:standardizedBy ngm:dublin-core,
        ngm:iso-25964 ;
    vc:uses ngm:faceted-classification,
        ngm:ontology,
        ngm:semantic-web-linked-data-standard,
        ngm:thesaurus .

ngm:iso-26262 a owl:Class ;
    rdfs:label "ISO 26262"@en ;
    rdfs:comment "ISO 26262 is the international functional safety standard for electrical and electronic (E/E) systems in road vehicles, first published in 2011 by ISO Technical Committee 22 and revised in a second edition in 2018 to extend coverage to motorcycles (Part 12) and semiconductor components (Part 11). The standard introduces the Automotive Safety Integrity Level (ASIL) classification system, ranging from ASIL A (lowest rigour) to ASIL D (highest rigour), derived from a Hazard Analysis and Risk Assessment (HARA) process that combines Severity, Exposure, and Controllability parameters for each hazardous event. Compliance requires evidence of a structured safety lifecycle encompassing concept phase, system design, hardware, software, production, and operation, providing automotive OEMs, Tier 1 suppliers, and semiconductor manufacturers with a shared framework for demonstrating that residual risk of hazardous E/E failure is acceptably low. The standard is widely mandated for ADAS, powertrain control, braking, and steering systems globally, and is increasingly complemented by SOTIF (ISO 21448) and the cybersecurity standard ISO/SAE 21434 for AI-enabled autonomous driving systems."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:safety-case ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:traceability ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:functional-safety ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:software-testing ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:formal-verification ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:hazard-analysis ],
        ngm:safety-standard ;
    vc:bridgesTo ngm:automotive-cybersecurity,
        ngm:iso-pas-8800,
        ngm:machine-learning-safety ;
    vc:contrastsWith ngm:do-254,
        ngm:en-50128 ;
    vc:enables ngm:adas,
        ngm:autonomous-vehicle,
        ngm:embedded-systems,
        ngm:self-driving-car ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:functional-safety,
        ngm:safety-case ;
    vc:qualityScore "0.76"^^xsd:float ;
    vc:relatedTo ngm:do-178-c,
        ngm:functional-safety,
        ngm:iec-61508,
        ngm:iso-21448,
        ngm:iso-sae-21434 ;
    vc:requires ngm:formal-verification,
        ngm:hazard-analysis,
        ngm:software-testing,
        ngm:traceability ;
    vc:slug "iso-26262" ;
    vc:sourceDomain "standards" ;
    vc:uses ngm:fmea,
        ngm:misra-c .

ngm:iso-iec-27001 a owl:Class ;
    rdfs:label "ISO/IEC 27001"@en ;
    rdfs:comment "ISO/IEC 27001 is an internationally recognised standard that specifies the requirements for establishing, implementing, maintaining, and continually improving an Information Security Management System (ISMS) within the context of an organisation's overall business risks. It adopts a risk-based approach, requiring organisations to systematically identify information security risks and apply appropriate controls drawn from Annex A. Certification against ISO/IEC 27001 provides third-party assurance of an organisation's commitment to protecting the confidentiality, integrity, and availability of information assets."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:information-security ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:risk-assessment ],
        ngm:infra-legal-and-regulatory ;
    skos:broader ngm:infra-legal-and-regulatory ;
    vc:enables ngm:audit-trail,
        ngm:compliance-framework ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:cybersecurity,
        ngm:gdpr-compliance ;
    vc:requires ngm:information-security,
        ngm:risk-assessment ;
    vc:slug "iso-iec-27001" ;
    vc:sourceDomain "infrastructure" .

ngm:kyc-aml-compliance a owl:Class ;
    rdfs:label "KYC/AML Compliance"@en ;
    rdfs:comment "KYC/AML compliance is the operational implementation of Know Your Customer and Anti-Money Laundering obligations within a product or platform, embedding identity verification, screening and monitoring into business processes. It encompasses the controls, workflows and audit evidence needed to demonstrate adherence to regulators. In tokenised systems it is increasingly encoded into smart contracts and asset standards."@en ;
    rdfs:subClassOf ngm:regulatory-compliance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:carbon-credit-tracking,
        ngm:enterprise-token-standards ;
    vc:slug "kyc-aml-compliance" ;
    vc:sourceDomain "governance" .

ngm:logistics a owl:Class ;
    rdfs:label "Logistics"@en ;
    rdfs:comment "Logistics is the planning, execution, and control of the efficient movement and storage of goods, services, and related information between points of origin and consumption. It encompasses transportation, warehousing, inventory management, order fulfilment, and reverse flows, with the objective of meeting demand at the required service level and lowest total cost. Logistics is a constituent function of supply-chain management and is increasingly mediated by sensor data, real-time tracking, and optimisation algorithms that coordinate multimodal networks under uncertainty."@en ;
    rdfs:subClassOf ngm:process ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:supply-chain-management ;
    vc:qualityScore "0.78"^^xsd:float ;
    vc:relatedTo ngm:logistics-optimization,
        ngm:reverse-logistics ;
    vc:slug "logistics" ;
    vc:sourceDomain "supply-chain" .

ngm:markov-chain a owl:Class ;
    rdfs:label "Markov Chain"@en ;
    rdfs:comment "A stochastic process in which the probability of each future state depends only on the current state and not on the sequence of preceding states (the Markov property), enabling tractable analysis of steady-state distributions, mixing times, and long-run behaviour."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:probability-theory ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:linear-algebra ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:state-space ],
        ngm:stochastic-process ;
    vc:bridgesTo ngm:artificial-intelligence,
        ngm:distributed-systems ;
    vc:enables ngm:hidden-markov-model,
        ngm:markov-chain-monte-carlo,
        ngm:markov-decision-process,
        ngm:pagerank ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:state-space ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:bayesian-inference,
        ngm:dynamical-systems-theory,
        ngm:graph-theory,
        ngm:reinforcement-learning ;
    vc:requires ngm:linear-algebra,
        ngm:probability-theory ;
    vc:slug "markov-chain" ;
    vc:sourceDomain "machine-learning" ;
    vc:uses ngm:ergodicity,
        ngm:random-walk .

ngm:mev a owl:Class ;
    rdfs:label "MEV"@en ;
    rdfs:comment "Maximal Extractable Value (MEV) represents the profit that block producers can extract through strategic transaction ordering, inclusion, or exclusion within blocks, arising from their privileged position to control execution sequencing in blockchain networks."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:block-production ],
