    dcterms:modified "2026-04-26T13:00:00Z"^^xsd:dateTime ;
    vcw:owlRole "Concept" .

# ETSI_Domain_Virtual_Economy
spatial-computing:ETSI_Domain_Virtual_Economy rdf:type owl:Class ;
    rdfs:label "ETSI_Domain_Virtual_Economy"@en ;
    rdfs:comment "ETSI domain encompassing economic systems, digital assets, and financial mechanisms enabling value exchange within metaverse and virtual environments through CryptoToken, Cryptocurrency, CentralBankDigitalCurrency, and DigitalAsset including DigitalGoods, NFT, and VirtualAsset. Virtual economy infrastructure coordinates DecentralizedExchange, CreatorEconomy mechanisms enabling direct creator-audience relationships, CreatorRoyaltyToken automating compensation, and emerging CarbonCreditToken for environmental accounting. Standards development addresses VirtualEconomy integration with traditional finance, regulatory compliance for tokenised assets, taxation frameworks for cross-border virtual transactions, and mechanisms ensuring sustainable economic value creation within persistent virtual worlds."@en ;
    skos:prefLabel "ETSI_Domain_Virtual_Economy"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:spatial-computing:etsidomainvirtualeconomy" ;
    owl:sameAs <urn:visionclaw:concept:spatial-computing:etsidomainvirtualeconomy> ;
    vcw:contentHash "sha256-12-fbbb5fdd5a77" ;
    vcw:qualityScore "0.4"^^xsd:decimal ;
    vcw:legacyTermId "MV-2004" ;
