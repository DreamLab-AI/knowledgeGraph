ngm:nakamoto-2008-bitcoin-whitepaper a owl:Class ;
    rdfs:label "Nakamoto 2008 Bitcoin Whitepaper"@en ;
    rdfs:comment "The Nakamoto 2008 Bitcoin Whitepaper, titled Bitcoin: A Peer-to-Peer Electronic Cash System, is the founding document of Bitcoin, published in October 2008 under the pseudonym Satoshi Nakamoto. It describes a system for electronic payments that allows two parties to transact directly without a trusted intermediary, solving the double-spending problem through a proof-of-work timestamp server. The paper introduces a public chain of blocks secured by computational work, where the longest valid chain represents the agreed transaction history. It established the conceptual basis for cryptocurrencies and decentralised consensus."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:proof-of-work ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:merkle-tree ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:utxo ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:digital-signature ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:peer-to-peer-network ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptographic-hash-function ],
        ngm:blockchain ;
    skos:broader ngm:blockchain ;
    vc:bridgesTo ngm:cryptography,
        ngm:distributed-systems,
        ngm:game-theory ;
    vc:contrastsWith ngm:centralised-payment-system,
        ngm:trusted-third-party ;
    vc:enables ngm:bitcoin-proof-of-work-protocol,
        ngm:cryptocurrency,
        ngm:decentralised-consensus,
        ngm:trustless-transaction ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:merkle-tree,
        ngm:proof-of-work,
        ngm:timestamp-server,
        ngm:utxo ;
    vc:implements ngm:longest-chain-rule,
        ngm:nakamoto-consensus ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:51-percent-attack,
        ngm:double-spending-problem,
        ngm:mining-incentive ;
    vc:requires ngm:cryptographic-hash-function,
        ngm:digital-signature,
        ngm:peer-to-peer-network ;
    vc:slug "nakamoto-2008-bitcoin-whitepaper" ;
    vc:sourceDomain "blockchain" .

