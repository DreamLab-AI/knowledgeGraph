] .

# Spatial Database
infrastructure:SpatialDatabase rdf:type owl:Class ;
    rdfs:subClassOf infrastructure:DatabaseSystem ;
    rdfs:label "Spatial Database"@en ;
    rdfs:comment "A database system optimized for storing, indexing, and querying georeferenced data and geometric objects, supporting spatial data types (points, lines, polygons) and spatial operations (intersection, containment, proximity) per OGC Simple Features specification for GIS and metaverse applications."@en ;
    skos:prefLabel "Spatial Database"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:infrastructure:spatial-database" ;
    owl:sameAs <urn:visionclaw:concept:infrastructure:spatial-database> ;
