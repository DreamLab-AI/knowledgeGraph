ngm:destination-marketing a owl:Class ;
    rdfs:label "Destination Marketing"@en ;
    rdfs:comment "The strategic promotion of physical or virtual locations using immersive technologies, AR/VR experiences, and digital twin representations to attract visitors, investors, and residents by showcasing destinations through interactive 3D visualizations and metaverse presence."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:digital-twin ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:3-d-content-creation ],
        ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:bridgesTo ngm:digital-marketing ;
    vc:enables ngm:immersive-advertising,
        ngm:location-promotion,
        ngm:virtual-tourism ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires ngm:3-d-content-creation,
        ngm:digital-twin,
        ngm:vr-experiences ;
    vc:slug "destination-marketing" ;
    vc:sourceDomain "spatial-computing" .

