# Hyperledger Iroha
blockchain:HyperledgerIroha rdf:type owl:Class ;
    rdfs:label "Hyperledger Iroha"@en ;
    rdfs:comment "Lightweight enterprise blockchain framework optimised for mobile and IoT applications using domain-driven C++ design and ByzantineFaultTolerance (YAC consensus), enabling resource-constrained devices to participate in permissioned networks. Iroha emphasises simplicity, developer experience, and straightforward deployment whilst supporting multi-signature transactions, atomic operations, and role-based access control suitable for DigitalIdentity systems and AssetManagement. Particularly deployed in Asia-Pacific for CBDCs and credential ecosystems requiring low-latency, efficient consensus."@en ;
    skos:prefLabel "Hyperledger Iroha"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:blockchain:hyperledger-iroha" ;
    owl:sameAs <urn:visionclaw:concept:blockchain:hyperledger-iroha> ;
