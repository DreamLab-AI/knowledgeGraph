ngm:gl-tf a owl:Class ;
    rdfs:label "glTF"@en ;
    rdfs:comment "glTF (GL Transmission Format) is an open royalty-free standard from the Khronos Group for the efficient transmission and loading of 3D scenes and models, defining geometry, materials, animation and scene structure in a compact runtime format."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:3-d-model ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:material-definition ],
        ngm:3-d-file-format ;
    vc:enables ngm:asset-interoperability,
        ngm:real-time-rendering ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:3-d-model,
        ngm:material-definition ;
    vc:slug "gl-tf" ;
    vc:sourceDomain "metaverse" .

