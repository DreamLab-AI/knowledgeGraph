ngm:digital-currency a owl:Class ;
    rdfs:label "Digital Currency"@en ;
    rdfs:comment "Any form of monetary value that exists purely in electronic format, encompassing central bank digital currencies, cryptocurrencies, stablecoins, and virtual currencies used within metaverse economies for transactions, payments, and value exchange without physical representation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
