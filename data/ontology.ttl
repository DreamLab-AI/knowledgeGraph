ngm:ietf a owl:Class ;
    rdfs:label "IETF"@en ;
    rdfs:comment "The Internet Engineering Task Force (IETF) is the principal international standards body responsible for developing and promoting voluntary Internet standards, particularly those comprising the Internet protocol suite (TCP/IP). It operates through working groups organised into areas and publishes specifications as Requests for Comments (RFCs), which become the canonical technical definitions of protocols such as HTTP, TLS, SMTP, and DNS. The IETF is a bottom-up, consensus-driven body with no formal membership; participation is open to any interested individual."@en ;
    rdfs:subClassOf ngm:web-standards ;
    vc:enables ngm:api-standard,
        ngm:communication-protocol,
        ngm:interoperability ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:interoperability-standard,
        ngm:network-protocol,
        ngm:network-standards,
        ngm:semantic-web-standards,
        ngm:web-standard ;
    vc:slug "ietf" ;
    vc:sourceDomain "governance" ;
    vc:standardizedBy ngm:oauth-2-0 ;
    vc:supports ngm:ai-governance,
        ngm:authentication-standards .

ngm:kalman-filter a owl:Class ;
    rdfs:label "Kalman Filter"@en ;
    rdfs:comment "An optimal recursive Bayesian filter that estimates the state of a linear dynamic system from a series of noisy measurements. It minimizes the mean squared error of the estimated state by combining predictions with measurements using weighted averaging based on uncertainty."@en ;
    rdfs:subClassOf ngm:bayes-filter,
        ngm:robo-navigation-and-planning,
        ngm:state-estimation ;
    skos:broader ngm:robo-navigation-and-planning ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires ngm:gaussian-noise-assumption,
        ngm:linear-system-model ;
    vc:slug "kalman-filter" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:rb-1008-odometry,
        ngm:sensor-fusion .

ngm:kubernetes a owl:Class ;
    rdfs:label "Kubernetes"@en ;
    rdfs:comment "Kubernetes (K8s) is an open-source container orchestration platform originally developed by Google and donated to the Cloud Native Computing Foundation (CNCF) in 2014. It automates the deployment, scaling, scheduling, and lifecycle management of containerised workloads across clusters of physical or virtual machines. Kubernetes abstracts infrastructure resources into declarative objects—Pods, Deployments, Services, and Namespaces—that describe desired state, with a control plane continuously reconciling actual state to match the specification."@en ;
    rdfs:subClassOf ngm:orchestration ;
    vc:dependsOn ngm:distributed-systems,
        ngm:software-infrastructure ;
    vc:enables ngm:cloud-infrastructure,
        ngm:distributed-computing,
        ngm:machine-learning-infrastructure,
        ngm:platform-engineering,
        ngm:resource-management ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:cloud-native-applications,
        ngm:distributed-system,
        ngm:infrastructure,
        ngm:microservices-architecture,
        ngm:software-platform ;
    vc:slug "kubernetes" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:cloud-computing,
        ngm:distributed-training ;
    vc:uses ngm:api-gateway,
        ngm:event-driven-architecture .

ngm:latent-space a owl:Class ;
    rdfs:label "latent space"@en ;
    rdfs:comment "A latent space is a compressed, high-dimensional mathematical representation learned by a neural network that encodes the underlying structure of training data. Generative models such as variational autoencoders and diffusion models use latent spaces to interpolate between data points and sample novel outputs. The geometry of the latent space reflects semantic relationships: nearby points correspond to perceptually or semantically similar entities, enabling controlled generation through vector arithmetic."@en ;
    rdfs:subClassOf ngm:ai-technique,
        ngm:generative-model ;
    skos:broader ngm:ai-technique ;
    vc:enables ngm:generative-ai,
        ngm:variational-autoencoders ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:relatedTo ngm:diffusion-model ;
    vc:slug "latent-space" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:embedding-model,
        ngm:encoder-decoder-architecture .

ngm:merkle-proof a owl:Class ;
    rdfs:label "Merkle Proof"@en ;
    rdfs:comment "A cryptographic proof of inclusion or exclusion that demonstrates whether a specific data element is part of a Merkle tree, requiring only O(log n) sibling hashes rather than the full data set. Merkle proofs underpin light-client verification in blockchain systems and enable simplified payment verification (SPV) without downloading the entire chain."@en ;
    rdfs:subClassOf ngm:bc-cryptographic-primitive,
        ngm:blockchain-entity,
        ngm:cryptographic-primitive ;
    skos:broader ngm:bc-cryptographic-primitive ;
    vc:enables ngm:blockchain-scalability,
        ngm:cryptographic-security ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:block-header,
        ngm:blockchain-transaction,
        ngm:cryptographic-commitment ;
    vc:slug "merkle-proof" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:cryptographic-hash-function,
        ngm:merkle-root,
        ngm:merkle-tree .

ngm:metadata-standards a owl:Class ;
    rdfs:label "Metadata Standards"@en ;
    rdfs:comment "Established frameworks and specifications such as Dublin Core, IPTC, and XMP that define how descriptive information about digital assets should be structured, enabling interoperability, discoverability, and consistent management across systems."@en ;
    rdfs:subClassOf ngm:data-standards,
