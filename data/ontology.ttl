        ngm:spatial-mapping ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:relatedTo ngm:photogrammetry,
        ngm:sensor-fusion,
        ngm:slam ;
    vc:requires ngm:depth-sensing ;
    vc:slug "point-cloud" ;
    vc:sourceDomain "spatial-computing" .

