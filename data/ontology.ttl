ngm:participation-framework a owl:Class ;
    rdfs:label "Participation Framework"@en ;
    rdfs:comment "A structured approach to designing stakeholder engagement processes that establish goals, principles, mods, and mechanisms for involving citizens, communities, or users in decision-making, governance, and collaborative activities."@en ;
