ngm:lidar a owl:Class ;
    rdfs:label "Lidar"@en ;
    rdfs:comment "Lidar (Light Detection and Ranging) is an active remote-sensing technology that emits pulsed laser light and measures the time-of-flight of returning reflections to compute precise three-dimensional point-cloud representations of the surrounding environment. Operating across wavelengths from near-infrared to ultraviolet, it achieves centimetre-scale spatial accuracy and is robust to many lighting conditions where camera-based systems degrade. Lidar is a foundational sensor modality in autonomous vehicles, aerial surveying, robotics, and spatial-computing applications, commonly fused with IMU, camera, and GNSS data to enable localisation, mapping, and obstacle detection."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:signal-processing ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:point-cloud-processing ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:time-of-flight-sensor ],
        ngm:sensor ;
    vc:bridgesTo ngm:3d-mapping,
        ngm:geospatial-data,
        ngm:spatial-computing ;
    vc:contrastsWith ngm:camera-sensor,
        ngm:radar,
        ngm:ultrasonic-sensor ;
    vc:dependsOn ngm:laser-pulse-technology,
        ngm:time-of-flight-measurement ;
    vc:enables ngm:3d-scene-reconstruction,
        ngm:autonomous-navigation,
        ngm:obstacle-detection,
        ngm:simultaneous-localisation-and-mapping ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:laser-emitter,
        ngm:photodetector,
        ngm:rotating-mirror,
        ngm:time-of-flight-sensor ;
    vc:isPartOf ngm:autonomous-vehicle-sensor-suite,
        ngm:robotic-perception-system ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:autonomous-driving,
        ngm:gnss,
        ngm:inertial-measurement-unit,
        ngm:slam ;
    vc:requires ngm:point-cloud-processing,
        ngm:signal-processing ;
    vc:slug "lidar" ;
    vc:sourceDomain "robotics" ;
    vc:supports ngm:digital-twin,
        ngm:environment-mapping,
        ngm:sensor-fusion ;
    vc:uses ngm:avalanche-photodiode,
        ngm:infrared-laser .

ngm:ethereum a owl:Class ;
    rdfs:label "Ethereum"@en ;
    rdfs:comment "Ethereum is an open-source, decentralised layer-1 blockchain platform conceived by Vitalik Buterin and launched in 2015, distinguished from Bitcoin by its general-purpose programmability via the Ethereum Virtual Machine (EVM), which executes Turing-complete smart contracts deployed on a shared global state. It transitioned from Proof of Work to Proof of Stake in September 2022 (the Merge), dramatically reducing energy consumption while preserving consensus security through a validator set staking Ether (ETH). Ethereum serves as the foundational settlement layer for the majority of decentralised finance (DeFi) protocols, NFT standards, DAOs, and Layer-2 rollup networks, with its fee market governed by EIP-1559's base-fee-burn mechanism."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:consensus-mechanism ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:peer-to-peer-network ],
        [ a owl:Restriction ;
