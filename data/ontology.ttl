    vc:isPartOf ngm:compliance-management-system ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:access-control,
        ngm:cryptographic-hash,
        ngm:immutable-storage,
        ngm:policy-engine ;
    vc:slug "compliance-audit-trail" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:cross-border-payments a owl:Class ;
    rdfs:label "Cross-Border Payments"@en ;
    rdfs:comment "Cross-Border Payments are financial transactions that originate in one country and are settled in another, requiring currency conversion and multi-jurisdiction clearing. Traditional correspondent banking routes incur multi-day settlement cycles and layered fees; blockchain-based rails—including stablecoins, payment channels, and CBDCs—reduce settlement to minutes and lower intermediary costs. They sit at the intersection of monetary policy, regulatory compliance, and distributed-ledger technology."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:smart-contract ],
        ngm:bc-defi-and-economics ;
    skos:broader ngm:bc-defi-and-economics ;
    vc:dependsOn ngm:consensus-mechanism ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:decentralised-finance ;
    vc:requires ngm:smart-contract ;
    vc:slug "cross-border-payments" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:lightning-network,
        ngm:stablecoin .

ngm:dc-workspace-tools a owl:Class,
        skos:Concept ;
    rdfs:label "Workspace Tools"@en ;
    rdfs:comment "Workspace Tools is the distributed-collaboration taxonomy hub for software and platform technologies that support remote and hybrid team productivity — including collaboration platforms, shared whiteboards, asynchronous video, meeting AI assistants, and immersive workspaces. It is a peer category to Telepresence and Communication Technology within the distributed collaboration domain."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:collaborative-whiteboard ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:synchronous-collaboration ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:virtual-office-spaces ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:immersive-workspaces ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:asynchronous-collaboration ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:collaboration-platform ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:meeting-ai-assistant ],
        ngm:distributed-collaboration ;
    skos:broader ngm:distributed-collaboration ;
    vc:enables ngm:distributed-collaboration ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:asynchronous-collaboration,
