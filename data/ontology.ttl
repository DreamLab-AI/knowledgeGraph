        ngm:digital-twin ;
    vc:contrastsWith ngm:reinforcement-learning ;
    vc:enables ngm:autonomous-system,
        ngm:counterfactual-reasoning,
        ngm:model-based-control,
        ngm:planning-and-scheduling ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:neural-network-latent-space,
        ngm:reward-model ;
    vc:implements ngm:model-based-reinforcement-learning,
