    owl:someValuesFrom blockchain:DecentralizedApplication
] .

# Asymmetric Encryption
blockchain:AsymmetricEncryption rdf:type owl:Class ;
    rdfs:subClassOf blockchain:Blockchain ;
    rdfs:label "Asymmetric Encryption"@en ;
    rdfs:comment "A cryptographic system using mathematically related public-private key pairs where the public key encrypts data that only the corresponding private key can decrypt. Asymmetric encryption provides the foundational cryptographic primitive for blockchain identity, digital signatures, and secure communication, enabling trustless verification without pre-shared secrets."@en ;
    skos:prefLabel "Asymmetric Encryption"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:blockchain:asymmetric-encryption" ;
    owl:sameAs <urn:visionclaw:concept:blockchain:asymmetric-encryption> ;
    vcw:contentHash "sha256-12-173aec5ae04e" ;
    vcw:qualityScore "0.5"^^xsd:decimal ;
    vcw:legacyTermId "BC-8001" ;
    vcw:ontologyStatus "active" ;
    vcw:maturityLevel "reviewed" ;
    vcw:authorityScore "0.0"^^xsd:decimal ;
    dcterms:identifier "BC-8001" ;
    dcterms:subject "blockchain" ;
    owl:versionInfo "2.0.0" ;
    dcterms:created "2026-04-26T00:00:00Z"^^xsd:dateTime ;
    dcterms:modified "2026-04-26T13:00:00Z"^^xsd:dateTime ;
    vcw:owlRole "Concept" .

blockchain:AsymmetricEncryption rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty infrastructure:enables ;
    owl:someValuesFrom blockchain:DigitalSignature
] .

