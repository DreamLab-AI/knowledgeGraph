    vc:uses ngm:cryptographic-protocol,
        ngm:data-compression .

ngm:telecommunications-infrastructure a owl:Class ;
    rdfs:label "Telecommunications Infrastructure"@en ;
    rdfs:comment "Telecommunications Infrastructure encompasses the physical and logical systems — including fibre-optic cable networks, cellular radio access networks, satellite constellations, submarine cables, internet exchange points, and backbone routers — that transport digital signals across local, regional, and global scales. It forms the foundational transport layer upon which internet protocols, mobile broadband, and converged communications services operate. As a critical national and commercial resource, it is subject to regulatory oversight, spectrum management, and increasingly stringent security requirements. Modern deployments integrate software-defined networking and network-function virtualisation to increase flexibility and reduce capital expenditure."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:network-security ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:bandwidth-adaptation ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:network-protocol ],
        ngm:infra-network-and-comms ;
    skos:broader ngm:infra-network-and-comms ;
    vc:bridgesTo ngm:edge-ai,
        ngm:spatial-computing ;
    vc:contrastsWith ngm:terrestrial-broadcast ;
    vc:dependsOn ngm:power-grid-infrastructure,
        ngm:software-defined-networking ;
    vc:enables ngm:edge-computing,
        ngm:internet-of-things,
        ngm:remote-communication,
        ngm:telecollaboration,
        ngm:video-conferencing ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:bandwidth-adaptation,
        ngm:cellular-network,
        ngm:fibre-optic-network,
        ngm:internet-exchange-point,
        ngm:network-protocol,
        ngm:satellite-communication ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:network-function-virtualisation,
