    vc:slug "film-production" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:design-software,
        ngm:game-engine,
        ngm:virtual-production-workflow .

ngm:generative-design-tool a owl:Class ;
    rdfs:label "Generative Design Tool"@en ;
    rdfs:comment "AI-assisted software application that produces optimized 3D designs from functional constraints using machine learning and computational algorithms."@en ;
