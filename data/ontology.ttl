ngm:ethereum-smart-contract-platform a owl:Class ;
    rdfs:comment "Ethereum is a decentralised, open-source blockchain platform that introduced Turing-complete smart contracts, enabling programmable, self-executing agreements without trusted intermediaries. Launched in 2015 by Vitalik Buterin and co-founders, it underpins the largest ecosystem of decentralised applications (dApps), decentralised finance (DeFi), and NFT markets. Its transition to proof-of-stake consensus via The Merge in September 2022 dramatically reduced its energy footprint while preserving security."@en ;
    rdfs:label "Ethereum Smart Contract Platform"@en ;
    rdfs:subClassOf ngm:blockchain-network ;
