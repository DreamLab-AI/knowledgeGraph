ngm:ai-infrastructure a owl:Class ;
    rdfs:label "AI Infrastructure"@en ;
    rdfs:comment "AI Infrastructure is the integrated ensemble of hardware, software, data systems, and operational tooling required to develop, train, deploy, monitor, and govern artificial intelligence and machine learning workloads at scale. It spans physical compute resources such as GPU and TPU clusters, networking fabrics, and storage systems through to cloud-managed AI platforms, model-serving runtimes, data pipelines, and MLOps toolchains. Unlike general-purpose computing infrastructure, AI Infrastructure is specifically optimised for tensor operations, distributed parallel training, high-throughput vector data ingestion, and low-latency inference serving. It constitutes the production backbone that determines the cost, velocity, reliability, and scalability of AI system development cycles."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:high-performance-computing ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:model-serving ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:vector-database ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:data-pipeline ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:mlops ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:distributed-storage ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:edge-computing ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:gpu-compute ],
        ngm:digital-infrastructure ;
    vc:bridgesTo ngm:decentralised-ai,
        ngm:spatial-computing ;
    vc:contrastsWith ngm:general-purpose-computing ;
    vc:dependsOn ngm:cloud-computing,
        ngm:data-centre ;
    vc:enables ngm:federated-learning,
        ngm:large-language-model,
        ngm:real-time-inference ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:data-pipeline,
        ngm:edge-computing,
        ngm:gpu-compute,
        ngm:mlops,
        ngm:model-serving,
        ngm:vector-database ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:cloud-infrastructure,
        ngm:experiment-tracking,
        ngm:model-registry ;
    vc:requires ngm:distributed-storage,
        ngm:high-performance-computing,
        ngm:networking-fabric ;
    vc:slug "ai-infrastructure" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:artificial-intelligence,
        ngm:deep-learning,
        ngm:machine-learning-discipline ;
    vc:uses ngm:accelerated-computing,
        ngm:containerisation,
        ngm:kubernetes .

ngm:byzantine-fault-tolerance a owl:Class ;
    rdfs:label "Byzantine Fault Tolerance"@en ;
    rdfs:comment "The feature of a distributed network to reach consensus on the same value even when some nodes fail to respond or respond with incorrect information. Enables networks to function correctly despite malicious or faulty nodes comprising less than one-third of the network. Derived from the Byzantine Generals Problem; the fundamental theorem states consensus is achievable if and only if more than two-thirds of participants are honest."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:voting-round ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:quorum ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptographic-signature ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:message-authentication ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:leader-election ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:finality-gadget ],
        ngm:consensus-mechanism ;
    vc:bridgesTo ngm:ai-energy-optimisation,
        ngm:multi-agent-systems ;
    vc:contrastsWith ngm:crash-fault-tolerance,
        ngm:proof-of-work ;
    vc:dependsOn ngm:network-synchrony,
        ngm:public-key-cryptography ;
    vc:enables ngm:consensus-safety,
        ngm:deterministic-finality,
        ngm:fault-tolerance,
        ngm:malicious-node-handling,
        ngm:state-machine-replication ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:finality-gadget,
        ngm:leader-election,
        ngm:prepare-phase,
        ngm:voting-round ;
    vc:implements ngm:hotstuff-protocol,
        ngm:practical-byzantine-fault-tolerance ;
    vc:isPartOf ngm:blockchain,
        ngm:distributed-systems ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:casper-ffg,
        ngm:proof-of-stake,
        ngm:validator-set ;
    vc:requires ngm:cryptographic-signature,
        ngm:distributed-agreement,
        ngm:message-authentication,
        ngm:quorum ;
    vc:slug "byzantine-fault-tolerance" ;
    vc:sourceDomain "distributed-systems" .

ngm:accountability a owl:Class ;
    rdfs:label "Accountability"@en ;
    rdfs:comment "The assignment of clear responsibilities for AI system development, deployment, and outcomes, coupled with mechanisms for oversight, redress, and remediation, ensuring that actors can be held answerable for system impacts and failures."@en ;
