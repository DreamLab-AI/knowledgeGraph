ngm:interoperability-protocol a owl:Class ;
    rdfs:label "Interoperability Protocol"@en ;
    rdfs:comment "An interoperability protocol is a formally specified set of rules, message formats, sequencing constraints, and coordination mechanisms that enable independently implemented systems, networks, or platforms to exchange information and invoke services without requiring shared internal architecture or governance. Such protocols define both syntactic structure and semantic contracts so that heterogeneous participants can interact predictably and verifiably. Interoperability protocols range from low-level wire formats to high-level semantic agreements, and form the foundational connective tissue of distributed computing ecosystems including blockchain networks, spatial computing platforms, AI service meshes, and cross-organisational data exchanges. Their design and governance determine whether digital infrastructure remains open and composable or becomes fragmented and extractive."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:schema-definition ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:protocol-specification ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:open-standard ],
        ngm:network-protocol ;
    vc:bridgesTo ngm:agent-communication-language,
        ngm:open-xr ;
    vc:contrastsWith ngm:api,
        ngm:vendor-lock-in ;
    vc:enables ngm:blockchain-interoperability,
        ngm:cross-platform-interoperability,
        ngm:federated-identity,
        ngm:interoperability,
        ngm:multi-agent-system ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:data-exchange-format,
        ngm:interoperability-standard ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:communication-protocol,
        ngm:decentralised-identifier,
        ngm:interoperability-framework,
        ngm:semantic-web-linked-data-standard,
        ngm:verifiable-credential-vc ;
    vc:requires ngm:open-standard,
        ngm:protocol-specification,
        ngm:schema-definition ;
    vc:slug "interoperability-protocol" ;
    vc:sourceDomain "infrastructure" ;
    vc:standardizedBy ngm:ieee,
        ngm:ietf,
        ngm:khronos-group,
        ngm:w3-c ;
    vc:supports ngm:cross-chain-messaging,
        ngm:decentralised-autonomous-organisation,
        ngm:digital-asset-ecosystem,
        ngm:spatial-computing ;
    vc:uses ngm:api-standard,
        ngm:cryptographic-proof,
        ngm:message-format .

ngm:json-data-interchange-format a owl:Class ;
    rdfs:label "JSON Data Interchange Format"@en ;
    rdfs:comment "JSON (JavaScript Object Notation) is a lightweight, human-readable, language-agnostic data-interchange format standardised as ECMA-404 and RFC 8259, built on two universal data structures: a collection of name/value pairs (objects) and an ordered list of values (arrays). Originally derived from JavaScript object-literal syntax by Douglas Crockford in the early 2000s, JSON has become the dominant wire format for REST APIs, configuration files, inter-service messaging, and AI pipeline payloads due to its minimal syntactic overhead, broad parser availability across every major programming language, and native mapping to in-memory data structures. Its strict subset relationship to JavaScript and its legibility to both humans and machines distinguishes it from predecessor formats such as XML while enabling seamless extension into semantic-web formats such as JSON-LD."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:json-data-interchange-format-schema ],
        ngm:infra-data-management ;
    skos:broader ngm:infra-data-management ;
    vc:bridgesTo ngm:linked-data,
        ngm:ontology,
        ngm:rdf,
        ngm:semantic-web-linked-data-standard ;
    vc:contrastsWith ngm:messagepack,
        ngm:protocol-buffer,
        ngm:xml,
        ngm:yaml ;
    vc:enables ngm:json-data-interchange-format-ld,
        ngm:knowledge-graph,
        ngm:rest-api,
        ngm:web-api ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:json-data-interchange-format-schema ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:data-format,
        ngm:java-script,
        ngm:serialisation,
        ngm:serialisation-format ;
    vc:slug "json-data-interchange-format" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:api-standard,
        ngm:configuration-management,
        ngm:microservices-architecture ;
    vc:uses ngm:unicode .

ngm:key-derivation-function a owl:Class ;
    rdfs:label "Key Derivation Function"@en ;
    rdfs:comment "A cryptographic algorithm that derives one or more secret keys from a master secret using a pseudo-random function, transforming human-readable passwords or seed phrases into cryptographically secure key material while enabling hierarchical key generation, deterministic wallet recovery, and password-based encryption in security and blockchain systems."@en ;
