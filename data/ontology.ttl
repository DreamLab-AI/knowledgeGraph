ngm:digital-performance-capture a owl:Class ;
    rdfs:label "Digital Performance Capture"@en ;
    rdfs:comment "Digital Performance Capture is a type of Creative Media Domain in the spatial computing domain."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
