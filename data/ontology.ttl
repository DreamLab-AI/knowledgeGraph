ngm:algorithmic-framework a owl:Class ;
    rdfs:label "Algorithmic Framework"@en ;
    rdfs:comment "An Algorithmic Framework is a structured collection of algorithms, data structures, and design principles that together provide a reusable computational scaffold for solving a class of related problems. It abstracts common patterns of search, optimisation, inference, and decision-making into composable building blocks that can be instantiated and extended for specific applications. Algorithmic frameworks underpin fields such as machine learning, procedural content generation, automated planning, and symbolic reasoning by providing principled, reproducible computational architectures."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:algorithm ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:graph-algorithms ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:learning-algorithm ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:optimization-algorithm ],
        ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:bridgesTo ngm:ai-framework,
        ngm:digital-twin ;
    vc:enables ngm:automated-planning,
        ngm:inference,
        ngm:procedural-content-generation ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:algorithm,
        ngm:graph-algorithms,
        ngm:learning-algorithm,
        ngm:optimization-algorithm ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:bayesian-inference,
        ngm:digital-twin-framework,
        ngm:machine-learning-discipline-framework,
        ngm:optimization-technique ;
    vc:slug "algorithmic-framework" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:algorithmic-governance a owl:Class ;
    rdfs:label "Algorithmic Governance"@en ;
    rdfs:comment "Algorithmic Governance is the use of automated decision systems, models, and rule engines to make or enforce governance choices that were traditionally human and discretionary, such as moderation, resource allocation, or compliance enforcement. It can increase consistency, speed, and scale, but raises concerns about transparency, accountability, bias, and contestability of automated decisions. The concept spans platform moderation, public-sector automation, and on-chain rule enforcement."@en ;
    rdfs:subClassOf ngm:governance ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:decentralised-coordination,
        ngm:digital-society-surveillance ;
    vc:slug "algorithmic-governance" ;
    vc:sourceDomain "governance" .

ngm:algorithmic-stablecoin a skos:Concept ;
    rdfs:label "Algorithmic Stablecoin"@en .

ngm:alu-vm a owl:Class ;
    rdfs:label "AluVM"@en ;
    rdfs:comment "A purely functional, register-based virtual machine designed for deterministic execution of smart-contract validation logic within client-side validated Bitcoin protocol layers, notably the RGB Protocol. AluVM operates without mutable global state, using a RISC-like instruction set that guarantees bounded execution time and reproducible results across heterogeneous computing environments. Its architecture is specifically optimised for the constraints of client-side validation, where contract logic must execute identically across all validating parties without access to a shared blockchain state machine."@en ;
    rdfs:subClassOf ngm:virtual-machine ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:implements ngm:rgb-protocol ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:layer-2-solutions,
        ngm:rgb-and-client-side-validation ;
    vc:slug "alu-vm" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:bitcoin-proof-of-work-protocol-script,
        ngm:taproot .

