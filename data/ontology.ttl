ngm:continuous-integration a owl:Class ;
    rdfs:label "Continuous Integration"@en ;
    rdfs:comment "Continuous Integration (CI) is a software engineering practice in which developers frequently merge code changes into a shared repository — typically multiple times per day — triggering automated build and test pipelines that provide rapid feedback on integration correctness. CI reduces the cost and risk of integration by detecting conflicts, regressions, and build failures early, and serves as the foundation of broader continuous delivery and DevOps workflows. Originating in Extreme Programming, the practice has become a cornerstone of modern software delivery, enabling teams to maintain a consistently releasable main branch through disciplined automation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:automated-testing ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:version-control ],
        ngm:software-engineering ;
    vc:bridgesTo ngm:mlops,
        ngm:model-evaluation ;
    vc:contrastsWith ngm:big-bang-integration,
        ngm:waterfall-development ;
    vc:dependsOn ngm:containerisation,
        ngm:git,
        ngm:test-driven-development ;
    vc:enables ngm:code-review,
        ngm:continuous-delivery,
        ngm:continuous-deployment,
        ngm:trunk-based-development ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:automated-testing,
        ngm:build-automation,
        ngm:pipeline-as-code,
        ngm:static-code-analysis ;
    vc:implements ngm:infrastructure-as-code,
        ngm:shift-left-testing ;
    vc:isPartOf ngm:devops,
        ngm:software-delivery-lifecycle ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:ci-cd-automation,
        ngm:feature-flags,
