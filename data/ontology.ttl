ngm:climate-modelling a owl:Class ;
    rdfs:label "Climate Modelling"@en ;
    rdfs:comment "Climate Modelling is the scientific discipline of constructing mathematical and computational representations of Earth's climate system to simulate past, present, and future climate states. Models range from simple energy-balance equations to high-resolution coupled atmosphere-ocean-land-ice systems running on supercomputing infrastructure. They underpin global projections published by the Intergovernmental Panel on Climate Change and inform policy decisions on emissions reduction and adaptation. Machine learning is increasingly integrated to accelerate parameterisation and downscaling. Outputs feed directly into carbon accounting, sustainability planning, and digital twin applications."@en ;
    rdfs:subClassOf ngm:digital-twin ;
    vc:enables ngm:carbon-footprint-measurement,
        ngm:carbon-neutrality-planning,
        ngm:sustainability-reporting ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:digital-twin-of-society-dto-s,
        ngm:environmental-sustainability,
        ngm:iso-14064 ;
    vc:slug "climate-modelling" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:high-performance-computing,
        ngm:machine-learning,
        ngm:time-series-forecasting .

ngm:clinical-trials a owl:Class ;
    rdfs:label "Clinical Trials"@en ;
    rdfs:comment "Blockchain-based clinical trial management systems employ immutable audit trails, smart contracts for protocol compliance, and cryptographic verification to ensure data integrity, prevent fraud, and provide FDA 21 CFR Part 11 compliant tamper-proof records whilst reducing monitoring costs. These systems address pharmaceutical development challenges including data falsification, patient recruitment inefficiency, and multi-site coordination failures."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:blockchain-compliance ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-integrity ],
        ngm:bc-network-component ;
    skos:broader ngm:bc-network-component ;
    vc:dependsOn ngm:compliance-framework ;
