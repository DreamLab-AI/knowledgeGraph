    vc:slug "wi-fi" ;
    vc:sourceDomain "infrastructure" .

ngm:wireless-hart a owl:Class ;
    rdfs:label "WirelessHART"@en ;
    rdfs:comment "WirelessHART is an open wireless communication standard for industrial process automation, built on the IEEE 802.15.4 physical layer and using time-synchronised, self-organising mesh networking with channel hopping for reliability. It extends the HART field-device protocol to wireless sensor networks in plants, providing deterministic, secure, low-power monitoring and control. Centrally managed by a network manager, it prioritises robustness against interference in harsh RF environments."@en ;
    rdfs:subClassOf ngm:communication-protocol ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:ieee-802-15-4,
        ngm:io-t-sensor-network ;
    vc:slug "wireless-hart" ;
    vc:sourceDomain "infrastructure" .

ngm:wireless-telemetry-module a owl:Class ;
    rdfs:label "Wireless Telemetry Module"@en ;
    rdfs:comment "A wireless telemetry module is an embedded hardware subsystem that acquires sensor measurements and transmits them over a radio link to a remote receiver without a wired connection. It combines signal conditioning, analogue-to-digital conversion, a microcontroller, and a low-power radio, and is used where wired tethering is impractical, such as implanted devices or remote field sensors. Power efficiency, antenna design, and link reliability are its central engineering constraints."@en ;
    rdfs:subClassOf ngm:sensor ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:brain-computer-interfaces,
        ngm:environmental-monitoring ;
    vc:slug "wireless-telemetry-module" ;
    vc:sourceDomain "infrastructure" .

ngm:word-piece a owl:Class ;
    rdfs:label "WordPiece"@en ;
    rdfs:comment "A subword tokenisation algorithm that iteratively merges character sequences by maximising the likelihood of the training corpus under a unigram language model, rather than merging the most frequent pairs. WordPiece is the default tokeniser for BERT, DistilBERT, and ELECTRA, producing vocabularies of approximately 30,000 tokens that handle rare and compound words via subword splitting."@en ;
    rdfs:subClassOf ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:contrastsWith ngm:byte-pair-encoding,
        ngm:sentence-piece ;
    vc:enables ngm:natural-language-processing ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:neural-network-text-tokenisation,
        ngm:subword-tokenisation ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:slug "word-piece" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:vocabulary .

ngm:workforce-augmentation a owl:Class ;
    rdfs:label "Workforce Augmentation"@en ;
    rdfs:comment "Workforce Augmentation refers to the use of AI tools, agentic systems, and intelligent automation to extend the cognitive and physical capabilities of human workers rather than replacing them. By offloading repetitive tasks to AI assistants and copilots, organisations can redeploy human attention to higher-value judgement and creative work, improving both productivity and job quality."@en ;
    rdfs:subClassOf ngm:ai-application ;
    skos:broader ngm:ai-application ;
    vc:enables ngm:ai-augmented-software-engineering ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:ai-application ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:ai-agents,
        ngm:collaborative-systems-modality-robot,
        ngm:human-robot-interaction,
        ngm:meeting-ai-assistant ;
    vc:slug "workforce-augmentation" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:agentic-ai,
        ngm:human-in-the-loop,
        ngm:workflow-automation .

