    vc:slug "human-agency-and-oversight" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:ai-governance-framework,
        ngm:ai-regulation .

ngm:hyperledger-iroha a owl:Class ;
    rdfs:label "Hyperledger Iroha"@en ;
    rdfs:comment "Hyperledger Iroha is a general-purpose permissioned Byzantine-fault-tolerant Distributed Ledger framework originally designed by Soramitsu (Tokyo, Japan) in collaboration with Hitachi, NTT Data and Colu, contributed to the Hyperledger Foundation (now Linux Foundation Decentralised Trust) ..."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
