        ngm:project-bro-bots ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:relatedTo ngm:agentic-alliance ;
    vc:slug "projects" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:automated-planning .

ngm:proof-based-consensus a owl:Class ;
    rdfs:label "Proof-Based Consensus"@en ;
    rdfs:comment "Proof-Based Consensus is the family of blockchain consensus mechanisms in which participants must provide a verifiable cryptographic or computational proof to earn the right to propose or validate blocks. This family includes proof-of-work (computational puzzle), proof-of-stake (economic stake), delegated proof-of-stake, proof-of-authority, proof-of-history, and related variants."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:proof-of-history ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:proof-of-authority ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:delegated-proof-of-stake ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:nominated-proof-of-stake ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:liquid-proof-of-stake ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:pure-proof-of-stake ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:proof-of-stake ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:proof-of-work ],
        ngm:bc-protocol-and-consensus,
        ngm:consensus-mechanism ;
    skos:broader ngm:bc-protocol-and-consensus ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:delegated-proof-of-stake,
        ngm:liquid-proof-of-stake,
        ngm:nominated-proof-of-stake,
        ngm:proof-of-authority,
        ngm:proof-of-history,
        ngm:proof-of-stake,
        ngm:proof-of-work,
        ngm:pure-proof-of-stake ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:byzantine-fault-tolerance,
        ngm:deterministic-finality,
        ngm:finality,
        ngm:nakamoto-consensus ;
    vc:slug "proof-based-consensus" ;
    vc:sourceDomain "blockchain" .

ngm:protocol-buffer a owl:Class ;
    rdfs:label "Protocol Buffer"@en ;
    rdfs:comment "Protocol Buffer is a technology infrastructure concept and a type of Data Format."@en ;
    rdfs:subClassOf ngm:infra-network-and-comms ;
    skos:broader ngm:infra-network-and-comms ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:implements ngm:data-format ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:slug "protocol-buffer" ;
    vc:sourceDomain "infrastructure" .

ngm:proximal-policy-optimisation a owl:Class ;
    rdfs:label "Proximal Policy Optimisation"@en ;
    rdfs:comment "A reinforcement learning algorithm that updates policies through incremental steps whilst constraining how much the policy can change via a clipped surrogate objective, preventing destabilising updates. PPO is the dominant RL algorithm used in reinforcement learning from human feedback (RLHF) for fine-tuning language models to align with human preferences."@en ;
    rdfs:subClassOf ngm:ai-technique,
        ngm:reinforcement-learning ;
    skos:broader ngm:ai-technique ;
    vc:dependsOn ngm:reinforcement-learning-algorithm ;
    vc:enables ngm:fine-tuning,
        ngm:large-language-models ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:reinforcement-learning-from-human-feedback ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:slug "proximal-policy-optimisation" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:human-feedback,
        ngm:reward-model .

ngm:proximity-detection a owl:Class ;
    rdfs:label "Proximity Detection"@en ;
    rdfs:comment "Proximity Detection is the computational process of determining the spatial distance and relative position between entities—users, objects, or agents—within a virtual or physical environment in real time. In metaverse and robotics contexts it underpins social-distance awareness, collision avoidance, interaction triggering, and context-sensitive content delivery. Implementations range from bounding-volume overlap tests and signed-distance fields in 3D engines to sensor-fusion pipelines combining lidar, ultrasound, and camera inputs in robotic systems."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:collision-detection ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:sensor-fusion ],
        ngm:infra-computing-and-cloud ;
    skos:broader ngm:infra-computing-and-cloud ;
    vc:enables ngm:collision-avoidance,
        ngm:presence-detection ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:social-presence ;
    vc:requires ngm:collision-detection,
        ngm:sensor-fusion ;
    vc:slug "proximity-detection" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:lidar,
        ngm:point-cloud .

ngm:public-blockchain a owl:Class ;
    rdfs:label "Public Blockchain"@en ;
    rdfs:comment "A permissionless, decentralised distributed ledger network in which any party may participate, validate transactions, and inspect the chain state without requiring authorisation. Public blockchains such as Bitcoin and Ethereum achieve censorship resistance and immutability through global state replication and open consensus mechanisms, at the cost of reduced transaction throughput and higher energy consumption relative to permissioned alternatives."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:consensus-mechanism ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:smart-contract ],
        ngm:infra-computing-and-cloud ;
    skos:broader ngm:infra-computing-and-cloud ;
    vc:contrastsWith ngm:permissioned-blockchain ;
    vc:enables ngm:censorship-resistance,
        ngm:cryptocurrency,
        ngm:immutability ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:consensus-mechanism,
        ngm:smart-contract ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:blockchain-governance,
        ngm:distributed-ledger-technology ;
    vc:slug "public-blockchain" ;
    vc:sourceDomain "infrastructure" .

ngm:qlo-ra a owl:Class ;
    rdfs:label "QLoRA"@en ;
    rdfs:comment "An extension of LoRA (Low-Rank Adaptation) that combines 4-bit NormalFloat quantisation of frozen base model weights with full-precision trainable low-rank adapter matrices. QLoRA additionally employs double quantisation and paged optimisers to achieve extreme memory efficiency, enabling fine-tuning of 65B-parameter models on a single 48GB GPU without significant performance degradation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:quantisation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:neural-network-quantisation ],
        ngm:ai-technique,
        ngm:parameter-efficient-fine-tuning ;
    skos:broader ngm:ai-technique ;
    vc:enables ngm:domain-adaptation,
        ngm:federated-learning ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:knowledge-distillation ;
    vc:requires ngm:neural-network-quantisation,
        ngm:quantisation ;
    vc:slug "qlo-ra" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:fine-tuning,
        ngm:large-language-models .

ngm:quorum-threshold a owl:Class ;
    rdfs:label "Quorum Threshold"@en ;
    rdfs:comment "A quorum threshold is the minimum number or fraction of participants (nodes, validators, signatories, or voters) that must agree or respond for a distributed system or governance process to reach a valid decision. It is a foundational parameter in consensus protocols, distributed databases, and blockchain governance, balancing liveness (the system can make progress) against safety (decisions reflect genuine majority will)."@en ;
    rdfs:subClassOf ngm:consensus-mechanism ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:byzantine-fault-tolerance,
        ngm:distributed-consensus ;
    vc:slug "quorum-threshold" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:fault-tolerance ;
    vc:uses ngm:paxos,
        ngm:raft .

ngm:radiology-ai a owl:Class ;
    rdfs:label "Radiology AI"@en ;
    rdfs:comment "Radiology AI comprises artificial intelligence systems designed for automated interpretation and quantitative analysis of radiological imaging modalities — X-ray, CT, MRI, and ultrasound. These systems perform lesion detection, organ segmentation, and structured reporting at radiologist-level accuracy, integrating with PACS workflows and validated through prospective clinical trials."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:medical-imaging ],
        ngm:ai-application,
        ngm:medical-imaging-ai ;
    skos:broader ngm:ai-application ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:computer-vision,
        ngm:object-detection ;
    vc:requires ngm:medical-imaging ;
    vc:slug "radiology-ai" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:convolutional-neural-network,
        ngm:image-segmentation .

ngm:rb-0024-workspace a owl:Class ;
    rdfs:label "rb 0024 workspace"@en ;
    rdfs:comment "The workspace of a robot manipulator is the total volume of space that the end-effector can reach, given the joint range limits of all links. The reachable workspace encompasses every point the tool-centre-point (TCP) can attain in at least one orientation, while the dexterous workspace is the subset reachable in all possible orientations. Workspace volume, shape, and dexterity distribution are primary design criteria for robot selection and cell layout, and must account for self-collisions, payload, and safety exclusion zones."@en ;
    rdfs:subClassOf ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:dependsOn ngm:rb-0021-robot-kinematics,
        ngm:rb-0026-robot-joint ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:manipulator-arm,
        ngm:rb-0023-degrees-of-freedom,
        ngm:rb-0031-singularity,
        ngm:rb-0033-payload,
        ngm:rb-0037-dexterity,
        ngm:rb-0095-safety-zone ;
    vc:slug "rb-0024-workspace" ;
    vc:sourceDomain "robotics" .

ngm:rb-0039-stiffness a owl:Class ;
    rdfs:label "rb 0039 stiffness"@en ;
    rdfs:comment "Stiffness, in robotics, is the ratio of applied force (or torque) to the resulting displacement (or angular deflection) of a robot link, joint, or end-effector. High stiffness yields precise positioning at the cost of storing large elastic energy that can be hazardous in contact; low stiffness (compliance) absorbs impact and is preferred in human-robot collaboration. Variable-stiffness actuation and impedance control allow robots to modulate stiffness dynamically, trading accuracy against safety depending on task context."@en ;
    rdfs:subClassOf ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:contrastsWith ngm:rb-0027-robot-link ;
    vc:enables ngm:force-control,
        ngm:soft-robotics ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:compliance-control,
        ngm:impedance-control,
        ngm:inertia,
        ngm:rigid-body-dynamics,
        ngm:robot-dynamics ;
    vc:slug "rb-0039-stiffness" ;
    vc:sourceDomain "robotics" .

ngm:rb-0055-velocity-control a owl:Class ;
    rdfs:label "rb 0055 velocity control"@en ;
    rdfs:comment "Velocity control is a robot control strategy in which joint or Cartesian velocities are the primary commanded quantities, with a feedback controller (typically PID-based) continuously correcting deviations between desired and measured velocities. It is used for smooth trajectory following, compliant interaction with soft contacts, and speed-and-separation monitoring safety functions that require real-time speed capping. Velocity control is distinct from position control — it does not inherently resist positional drift — and from torque control, which acts at the force level."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:encoder ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:pid-controller ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:feedback-control ],
        ngm:motion-control,
        ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:enables ngm:rb-0092-protective-stop,
        ngm:trajectory-planning ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:position-control,
        ngm:torque-control,
        ngm:velocity,
        ngm:velocity-control ;
    vc:requires ngm:encoder,
        ngm:feedback-control,
        ngm:pid-controller ;
    vc:slug "rb-0055-velocity-control" ;
    vc:sourceDomain "robotics" .

ngm:rb-0057-admittance-control a owl:Class ;
    rdfs:label "rb 0057 admittance control"@en ;
    rdfs:comment "Admittance control is an interaction-control strategy in which a robot measures contact forces and torques and converts them into corresponding desired motion (position or velocity) using a virtual mass-spring-damper model. It is the dual of impedance control: the robot senses force input and renders motion output, enabling compliant, safe physical human-robot interaction in collaborative tasks."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:rb-0067-force-torque-sensor ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:force-control ],
        ngm:interaction-control,
        ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:contrastsWith ngm:impedance-control ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:compliance-control,
        ngm:rb-0041-inertia,
        ngm:rb-0053-force-control,
        ngm:rb-0056-impedance-control ;
    vc:requires ngm:force-control,
        ngm:rb-0067-force-torque-sensor ;
    vc:slug "rb-0057-admittance-control" ;
    vc:sourceDomain "robotics" ;
    vc:supports ngm:human-robot-interaction,
        ngm:rb-0094-power-and-force-limiting .

ngm:rb-0068-vision-system a owl:Class ;
    rdfs:label "rb 0068 vision system"@en ;
    rdfs:comment "A robotic vision system is an integrated sensor subsystem that captures and processes visual data—using cameras, depth sensors, or LiDAR—to provide a robot with spatial awareness, object recognition, and scene understanding capabilities. Vision systems underpin tasks including visual servoing, part inspection, SLAM-based localisation, and human-robot interaction, and conform to ISO 8373:2021 perception-system definitions."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:rb-0077-depth-camera ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:rb-0066-robot-sensor ],
        ngm:robo-perception ;
    skos:broader ngm:robo-perception ;
    vc:enables ngm:human-robot-interaction,
        ngm:rb-0065-visual-servoing ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:rb-0066-robot-sensor,
        ngm:rb-0077-depth-camera ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:perception-system,
        ngm:rb-0069-lidar ;
    vc:slug "rb-0068-vision-system" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:computer-vision,
        ngm:object-detection,
        ngm:point-cloud,
        ngm:slam .

ngm:rb-1013-localization a owl:Class ;
    rdfs:label "RB 1013 localization"@en ;
    rdfs:comment "RB 1013 localization is a robotics navigation concept addressing the problem of a mobile robot determining its pose within a known or partially known environment. It encompasses probabilistic state estimation techniques such as particle filters, extended Kalman filters, and scan-matching algorithms applied to sensor data from LiDAR, wheel odometry, and IMUs to produce continuous pose estimates suitable for autonomous navigation."@en ;
    rdfs:subClassOf ngm:robo-navigation-and-planning ;
    skos:broader ngm:robo-navigation-and-planning ;
    vc:enables ngm:autonomous-navigation ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:relatedTo ngm:localization,
        ngm:slam,
        ngm:visual-odometry ;
    vc:slug "rb-1013-localization" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:lidar,
        ngm:particle-filter .

ngm:real-time-ai-inference a owl:Class ;
    rdfs:label "Real-Time AI Inference"@en ;
    rdfs:comment "Real-time AI inference is the execution of trained machine learning model forward passes within latency bounds tight enough to support interactive or time-critical applications, typically measured in milliseconds to tens of milliseconds. It requires co-optimisation of model architecture, runtime software, and hardware accelerators — including GPUs, NPUs, and dedicated AI ASICs — to meet throughput and latency targets whilst maintaining acceptable accuracy. Applications include autonomous vehicles, real-time video analysis, voice assistants, and spatial computing overlays."@en ;
    rdfs:subClassOf ngm:ai-inference ;
    vc:enables ngm:edge-ai-system,
        ngm:latency-aware-edge-ai ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:low-latency-computing,
        ngm:model-compression-for-edge ;
    vc:slug "real-time-ai-inference" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:gpu-acceleration,
        ngm:inference-engine,
        ngm:npu,
        ngm:onnx-runtime .

ngm:real-time-communication a owl:Class ;
    rdfs:label "Real-Time Communication"@en ;
    rdfs:comment "Real-time communication is the exchange of audio, video or data between parties with minimal delay, supporting interactive use such as calls and conferencing. Web-based real-time communication is commonly built on WebRTC."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:video-compression ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:web-rtc ],
        ngm:communication-protocol ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:video-compression,
        ngm:web-rtc ;
    vc:slug "real-time-communication" ;
    vc:sourceDomain "networking" .

ngm:reality-capture-system a owl:Class ;
    rdfs:label "Reality Capture System"@en ;
    rdfs:comment "Physical hardware system comprising 3D scanners, LIDAR sensors, photogrammetry cameras, and associated equipment for acquiring spatial and visual data from real-world environments to create digital representations."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:depth-sensor ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:motion-capture-rig ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:spatial-calibration ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-processing-hardware ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:lidar-sensor ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:tracking-system ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:storage-infrastructure ],
        ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:enables ngm:3-d-model-generation,
        ngm:digital-twin-creation,
        ngm:environment-reconstruction,
        ngm:visual-representation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:3-d-scanner,
        ngm:depth-sensor,
        ngm:lidar-sensor,
        ngm:motion-capture-rig,
        ngm:photogrammetry-camera,
        ngm:point-cloud-processor,
        ngm:tracking-system ;
    vc:isPartOf ngm:digital-twin-creation-pipeline,
        ngm:virtual-production-workflow ;
    vc:qualityScore "0.35"^^xsd:float ;
