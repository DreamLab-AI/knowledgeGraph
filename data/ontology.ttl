    vc:slug "inference-runtime" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:model-deployment,
        ngm:model-serving ;
    vc:uses ngm:container,
        ngm:onnx .

ngm:intelligent-automation a owl:Class ;
    rdfs:label "Intelligent Automation"@en ;
    rdfs:comment "Intelligent automation is the combination of process automation with artificial intelligence so that workflows can handle unstructured inputs, make context-dependent decisions, and adapt over time. It extends rule-based robotic process automation with machine learning, natural language processing, and computer vision to automate tasks that previously required human judgement. It is widely applied to back-office operations, customer service, and document-intensive processes."@en ;
    rdfs:subClassOf ngm:ai-application ;
    skos:broader ngm:ai-application ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:artificial-intelligence,
        ngm:robotic-process-automation ;
    vc:slug "intelligent-automation" ;
    vc:sourceDomain "ai" .

ngm:iot-sensor a owl:Class ;
    rdfs:label "IoT Sensor"@en ;
    rdfs:comment "An IoT sensor is a networked device that measures physical or environmental conditions — such as temperature, humidity, location, vibration or light — and transmits the resulting data over a communications network to back-end systems for monitoring and analysis. By embedding sensing and connectivity into assets and environments, IoT sensors provide continuous, real-time visibility that supports automation and data-driven decisions. In supply chains they are central to cold-chain monitoring, asset tracking and condition-based maintenance."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:edge-computing ],
        ngm:sensor ;
    vc:bridgesTo ngm:oracle,
        ngm:supply-chain ;
    vc:dependsOn ngm:edge-computing ;
    vc:enables ngm:asset-management-system,
        ngm:provenance-tracking,
        ngm:traceability ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:supply-chain-management ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:asset-management-system,
        ngm:supply-chain-management ;
    vc:requires ngm:edge-computing ;
    vc:slug "iot-sensor" ;
    vc:sourceDomain "supply-chain" ;
    vc:supports ngm:digital-product-passport,
        ngm:food-safety ;
    vc:uses ngm:sensor,
        ngm:sensor-fusion .

ngm:ipld a owl:Class ;
    rdfs:label "IPLD"@en ;
    rdfs:comment "IPLD (InterPlanetary Linked Data) is a data model and set of specifications for building content-addressed, hash-linked data structures that interoperate across distributed systems. It defines how to represent linked data as directed acyclic graphs whose edges are content identifiers (CIDs), allowing any hash-linked structure — Git commits, blockchain blocks, IPFS files — to be traversed through a common addressing scheme. IPLD provides the data layer beneath IPFS and Filecoin, decoupling the logical structure of data from the protocol used to store or transport it."@en ;
    rdfs:subClassOf ngm:content-addressing ;
    vc:enables ngm:data-availability ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:ipfs,
        ngm:linked-data ;
    vc:slug "ipld" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:merkle-dag,
        ngm:merkle-tree .

ngm:itu-t a owl:Class ;
    rdfs:label "ITU-T"@en ;
    rdfs:comment "ITU-T is the Telecommunication Standardization Sector of the International Telecommunication Union, a United Nations agency that develops international standards (Recommendations) for telecommunications and information technology. Its work spans video and audio coding, network protocols, public-key infrastructure and digital signatures. ITU-T Recommendations such as the H-series video codecs and X.509 are foundational to global communications interoperability."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:h-264 ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:x-509-certificate ],
        ngm:standards-body ;
    vc:bridgesTo ngm:infrastructure,
        ngm:security ;
    vc:contrastsWith ngm:ietf,
        ngm:iso-iec ;
    vc:enables ngm:public-key-infrastructure,
        ngm:video-compression ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:g-711,
        ngm:h-264,
        ngm:h-265,
        ngm:x-509-certificate ;
    vc:implements ngm:network-protocol ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:cybersecurity-standard,
        ngm:digital-signature,
        ngm:proprietary-video ;
    vc:slug "itu-t" ;
    vc:sourceDomain "standards" ;
    vc:standardizedBy ngm:international-telecommunication-union ;
    vc:supports ngm:broadband-network,
        ngm:digital-signature,
        ngm:iptv .

ngm:java-script a owl:Class ;
    rdfs:label "JavaScript"@en ;
    rdfs:comment "JavaScript is a high-level, dynamically typed, interpreted programming language standardised as ECMAScript by ECMA International, originally designed by Brendan Eich at Netscape in 1995 to add interactivity to web pages. It features first-class functions, prototype-based object orientation, event-driven and asynchronous programming via the event loop, and runs natively in all major web browsers as the sole client-side scripting language. Beyond browsers, server-side runtimes such as Node.js and Deno have extended JavaScript into backend services, command-line tooling, and cloud functions, making it one of the most widely deployed programming languages across the full web stack."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:web-assembly ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:type-script ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:node-js ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:event-loop ],
        ngm:programming-language ;
