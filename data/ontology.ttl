ngm:performance-optimization a owl:Class ;
    rdfs:label "Performance Optimization"@en ;
    rdfs:comment "Performance optimization is the systematic process of enhancing the efficiency, speed, and effectiveness of software systems by tuning code, algorithms, and resource utilization to minimize response time and maximize throughput."@en ;
    rdfs:subClassOf ngm:infra-software-engineering,
        ngm:optimization-technique ;
    skos:broader ngm:infra-software-engineering ;
    vc:enables ngm:resource-efficiency,
        ngm:system-scalability,
        ngm:user-experience ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:slug "performance-optimization" ;
    vc:sourceDomain "infrastructure" .

ngm:pixel-shader a owl:Class ;
    rdfs:label "Pixel Shader"@en ;
    rdfs:comment "A programmable GPU stage that executes once per rasterised fragment, determining each pixel's final colour and depth by sampling textures, computing lighting models, and applying material properties. Pixel shaders operate in a massively parallel fashion and are the primary site for physically-based rendering calculations in real-time graphics pipelines."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:vertex-shader ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:rendering-pipeline ],
        ngm:metaverse,
        ngm:sc-display-and-rendering ;
    skos:broader ngm:sc-display-and-rendering ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:implements ngm:physically-based-rendering ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:relatedTo ngm:compute-shader,
        ngm:shader ;
    vc:requires ngm:rendering-pipeline,
        ngm:vertex-shader ;
    vc:slug "pixel-shader" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:gpu-compute,
        ngm:texture-mapping .

ngm:platform-governance a owl:Class ;
    rdfs:label "Platform Governance"@en ;
    rdfs:comment "Platform governance encompasses the formal and informal rules, decision-making processes, and control mechanisms that determine how blockchain and decentralised platforms operate, evolve, and distribute power among stakeholders."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
