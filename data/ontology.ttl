    owl:onProperty ngm:isEnabledBy ;
    owl:someValuesFrom mv:HumanintheLoop
] .

mv:Accountability rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:isEnabledBy ;
    owl:someValuesFrom mv:AIImpactAssessment
] .

mv:Accountability rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:isEnabledBy ;
    owl:someValuesFrom mv:ComplianceAuditTrail
