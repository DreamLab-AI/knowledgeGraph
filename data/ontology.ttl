vf:robot-operating-system a owl:Class ;
    rdfs:label "Robot Operating System"@en ;
    rdfs:comment "The Robot Operating System (ROS / ROS 2) is an open-source middleware framework providing a structured communication layer, tool ecosystem, and package repository for robotic software development, enabling modular composition of perception, planning, and actuation subsystems through a publish-subscribe and service-call graph. ROS 2, built on the [[Data Distribution Service]] (DDS) transport, adds real-time guarantees, multi-platform support, and security (SROS2) absent from the original ROS 1, making it the de-facto integration substrate for both research robots and production autonomous systems, and a bridging target for [[VisionClaw Agentic Container]] agent skills interacting with physical hardware."@en ;
    rdfs:subClassOf <urn:visionflow:linked:publish-subscribe-framework>,
        <urn:visionflow:linked:robotic-middleware> ;
    vc:authorityScore "0.85"^^xsd:float ;
    vc:enables <urn:visionflow:linked:robot-simulation>,
        vf:autonomous-navigation,
        vf:hardware-abstraction,
        vf:motion-planning,
        vf:sensor-fusion ;
    vc:hasPart <urn:visionflow:linked:colcon-build-system>,
        <urn:visionflow:linked:ros-action>,
        <urn:visionflow:linked:ros-node>,
        <urn:visionflow:linked:ros-package>,
        <urn:visionflow:linked:ros-service>,
        <urn:visionflow:linked:ros-topic>,
        <urn:visionflow:linked:urdf-robot-model> ;
    vc:implements <urn:visionflow:linked:dds-rtps-protocol>,
        <urn:visionflow:linked:rep-standards>,
        <urn:visionflow:linked:sros2-security> ;
    vc:maturity "established" ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:requires <urn:visionflow:linked:cmake-build-system>,
        <urn:visionflow:linked:data-distribution-service>,
        <urn:visionflow:linked:python-3> ;
    vc:slug "robot-operating-system" ;
    vc:sourceDomain "robotics" .

