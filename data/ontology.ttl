        ngm:explainability,
        ngm:transparency ;
    vc:slug "oecd-ai-principles" ;
    vc:sourceDomain "governance" ;
    vc:standardizedBy ngm:g20,
        ngm:oecd ;
    vc:supports ngm:accountability,
        ngm:fairness,
        ngm:human-rights,
        ngm:sustainable-development .

ngm:point-cloud-processing a owl:Class ;
    rdfs:label "Point Cloud Processing"@en ;
    rdfs:comment "Point cloud processing is the body of computational algorithms and end-to-end pipelines that transform raw collections of georeferenced 3D coordinate samples — produced by LiDAR scanners, depth cameras, structured-light systems, or photogrammetric reconstruction — into structured, semantically meaningful representations suitable for downstream applications such as autonomous navigation, digital twin construction, heritage documentation, and environmental monitoring. Core operations include noise filtering, voxel downsampling, multi-scan registration via Iterative Closest Point (ICP) and feature-based variants, normal estimation, segmentation, surface reconstruction, and compression. These operations are increasingly augmented by deep learning models operating directly on unordered point sets (PointNet family, sparse 3D CNNs), often executed on GPU-accelerated or specialised embedded hardware to meet real-time constraints. The field bridges classical computational geometry with modern neural scene representations such as NeRF and 3D Gaussian Splatting."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gpu-computing ],
        ngm:point-cloud ;
    vc:bridgesTo ngm:machine-learning,
        ngm:robotics-perception ;
    vc:dependsOn ngm:lidar-scanning,
        ngm:photogrammetry ;
    vc:enables ngm:3-d-gaussian-splatting,
        ngm:autonomous-driving-perception,
        ngm:digital-twin,
        ngm:ne-rf,
        ngm:simultaneous-localisation-and-mapping,
        ngm:spatial-computing ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:point-cloud-registration,
        ngm:point-cloud-segmentation ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:building-information-modelling,
        ngm:geospatial-data ;
    vc:requires ngm:gpu-computing ;
    vc:slug "point-cloud-processing" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:depth-sensing,
        ngm:lidar,
        ngm:octree-spatial-index,
        ngm:spatial-data-structure,
        ngm:voxel-grid .

ngm:position-control a owl:Class ;
    rdfs:label "PositionControl"@en ;
    rdfs:comment "A closed-loop feedback control modology that commands a robotic manipulator, actuator, or motion platform to achieve and maintain a desired spatial position or angular orientation by continuously measuring the actual position via encoders, resolvers, or external sensing systems (vision, LIDAR), c..."@en ;
