ngm:browser-automation a owl:Class ;
    rdfs:label "Browser Automation"@en ;
    rdfs:comment "Browser Automation is the programmatic control of web browsers to execute tasks—navigation, form submission, data extraction, and UI interaction—without direct human input. It spans a spectrum from low-level Chrome DevTools Protocol (CDP) scripting and WebDriver-based frameworks to high-level tools such as Playwright and Puppeteer, as well as AI-driven computer-use agents that perceive and act upon rendered page content. Browser automation underpins modern software testing pipelines, robotic process automation, and agentic AI workflows that must interact with web-based services. The field has evolved rapidly with the emergence of large language model agents capable of interpreting visual page state and generating action sequences autonomously."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:network-protocol ],
        ngm:workflow-automation ;
    vc:bridgesTo ngm:artificial-intelligence,
        ngm:security ;
    vc:dependsOn ngm:infrastructure ;
    vc:enables ngm:continuous-integration,
        ngm:customer-service-automation,
        ngm:data-pipeline,
        ngm:testing-infrastructure ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:computer-use-and-browser-agents,
        ngm:headless-browser,
        ngm:robotic-process-automation,
        ngm:software-testing,
        ngm:web-scraping ;
    vc:requires ngm:network-protocol,
        ngm:web-browser ;
    vc:slug "browser-automation" ;
    vc:sourceDomain "ai" ;
    vc:supports ngm:accessibility-audit-tool,
        ngm:adversarial-testing,
        ngm:industrial-automation,
        ngm:regression-testing ;
    vc:uses ngm:java-script,
        ngm:testing-process .

ngm:carbon-offsetting a owl:Class ;
    rdfs:label "Carbon Offsetting"@en ;
    rdfs:comment "Carbon offsetting is the practice whereby an entity compensates for its greenhouse gas emissions by financing or undertaking activities that achieve an equivalent reduction or removal of carbon dioxide equivalent (CO2e) elsewhere in the global economy. Offsets are quantified in standardised units — typically one tonne of CO2e per credit — and must satisfy criteria of additionality, permanence, measurability, and independent verification to be considered credible. The mechanism operates across compliance markets (e.g. the EU Emissions Trading System) and voluntary markets (e.g. Gold Standard, Verra VCS), and spans project types including afforestation, improved cookstoves, methane capture, and direct air capture. Controversy around offset quality, permanence risks, and potential for greenwashing has driven increasing scrutiny from regulators, standards bodies, and civil society."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:carbon-registry ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:carbon-offset ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:carbon-credits ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:carbon-accounting ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:additionality ],
        ngm:sustainability ;
    vc:bridgesTo ngm:blockchain,
        ngm:smart-contracts ;
    vc:contrastsWith ngm:greenwashing ;
    vc:enables ngm:carbon-neutrality,
        ngm:climate-finance,
        ngm:net-zero ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:carbon-credits,
        ngm:carbon-offset,
        ngm:carbon-registry ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:climate-change,
        ngm:esg,
        ngm:paris-agreement,
        ngm:scope-3-emissions ;
    vc:requires ngm:additionality,
        ngm:carbon-accounting,
        ngm:measurement-reporting-and-verification ;
    vc:slug "carbon-offsetting" ;
    vc:sourceDomain "governance" ;
    vc:standardizedBy ngm:gold-standard,
        ngm:iso-14064,
        ngm:verified-carbon-standard ;
    vc:uses ngm:emissions-trading-scheme,
        ngm:life-cycle-assessment,
        ngm:voluntary-carbon-market .

ngm:central-banking a skos:Concept ;
    rdfs:label "Central Banking"@en .

ngm:centralized-exchange a owl:Class ;
    rdfs:label "Centralized Exchange"@en ;
    rdfs:comment "A centralized exchange (CEX) is a digital-asset trading venue operated by a single company that custodies user funds, matches orders through an internal order book, and acts as an intermediary for every trade. Users deposit assets into accounts controlled by the operator, who maintains liquidity, settlement, and the matching engine off-chain. CEXs offer high throughput and familiar interfaces but require trust in the operator and typically enforce identity-verification and anti-money-laundering controls."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:liquidity ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:order-book ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:custody ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:know-your-customer ],
        ngm:blockchain ;
    skos:broader ngm:blockchain ;
    vc:bridgesTo ngm:order-book ;
    vc:contrastsWith ngm:decentralized-exchange,
        ngm:self-custody ;
    vc:dependsOn ngm:custody ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:binance,
        ngm:coinbase,
        ngm:decentralized-finance ;
    vc:requires ngm:custody,
        ngm:know-your-customer,
        ngm:liquidity,
        ngm:order-book ;
    vc:slug "centralized-exchange" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:liquidity,
        ngm:stablecoin ;
    vc:uses ngm:aml,
        ngm:custodial-wallet .

ngm:certificate-revocation a owl:Class ;
    rdfs:label "Certificate Revocation"@en ;
    rdfs:comment "Certificate Revocation is the process by which a Certificate Authority (CA) invalidates a previously issued digital certificate before its natural expiry, typically due to key compromise, CA compromise, or change in the certificate holder's status. Revocation information is distributed via Certificate Revocation Lists (CRLs) or the Online Certificate Status Protocol (OCSP). It is a critical component of public key infrastructure (PKI) lifecycle management."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:certificate-authority ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:ocsp ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:certificate-revocation-list ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptographic-protocol ],
        ngm:security ;
    vc:contrastsWith ngm:certificate-transparency,
        ngm:short-lived-certificate ;
    vc:enables ngm:identity-management,
        ngm:zero-trust-architecture ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:certificate-revocation-list,
        ngm:ocsp ;
    vc:implements ngm:pki,
        ngm:trust-management ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:certificate-authority,
        ngm:digital-certificate,
        ngm:public-key-infrastructure ;
    vc:requires ngm:certificate-authority,
        ngm:cryptographic-protocol ;
    vc:slug "certificate-revocation" ;
    vc:sourceDomain "security" ;
    vc:standardizedBy ngm:rfc-5280,
        ngm:x509 ;
    vc:supports ngm:https,
        ngm:tls .

ngm:client-side-validation a owl:Class ;
    rdfs:label "Client-Side Validation"@en ;
    rdfs:comment "Client-Side Validation is the process of verifying user-supplied data within the browser or client application before that data is transmitted to a server, providing immediate feedback to users and reducing unnecessary network requests. In the context of Bitcoin and RGB Protocol, it refers to a distinct validation paradigm where the full state of off-chain assets is verified locally by the recipient rather than by all network nodes, enabling scalable, private asset transfers. The two usages share the principle of local verification but differ fundamentally in their security models and scope."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:state-transition-function ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:single-use-seals ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:proof-of-publication ],
        ngm:data-integrity ;
    vc:contrastsWith ngm:ethereum-smart-contract-platform-smart-contracts ;
    vc:dependsOn ngm:bitcoin-proof-of-work-protocol-network,
        ngm:utxo-model ;
    vc:enables ngm:block-trails,
        ngm:rgb-protocol,
        ngm:web-contracts,
        ngm:zero-knowledge-proof ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:proof-of-publication,
        ngm:single-use-seals,
        ngm:state-transition-function ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:layer-2-solutions,
        ngm:taproot-assets,
        ngm:zero-knowledge ;
    vc:slug "client-side-validation" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:privacy-preserving-computation ;
    vc:uses ngm:cryptographic-commitment,
        ngm:cryptographic-proof,
        ngm:json-data-interchange-format-schema,
        ngm:utxo .

ngm:cognitive-load a owl:Class ;
    rdfs:label "Cognitive Load"@en ;
    rdfs:comment "Cognitive load is the total amount of working-memory resource demanded by a task, interface, or learning activity at a given moment. It is commonly decomposed into intrinsic load (inherent task difficulty), extraneous load (imposed by poor presentation), and germane load (effort devoted to building durable mental schemas). Managing cognitive load is a central goal of user-experience and interaction design, since exceeding a user's capacity degrades comprehension, accuracy, and satisfaction."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:attention ],
        ngm:user-experience ;
    vc:bridgesTo ngm:ergonomics ;
    vc:contrastsWith ngm:affordance ;
    vc:dependsOn ngm:attention,
        ngm:working-memory ;
    vc:enables ngm:user-research ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:user-experience ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:human-computer-interaction,
        ngm:mental-model,
        ngm:usability ;
    vc:requires ngm:attention ;
    vc:slug "cognitive-load" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:usability ;
    vc:uses ngm:mental-model .

ngm:collaborative-systems-modality a owl:Class ;
    rdfs:label "Collaborative Systems Modality"@en ;
    rdfs:comment "Collaborative describes systems, processes, or modalities in which multiple agents—human or robotic—work together toward shared goals, actively coordinating actions, sharing information, and adapting to one another's contributions. In robotics, 'collaborative' is most precisely applied to human–robot collaboration (HRC) per ISO/TS 15066, where robot and human share a workspace without fixed barriers. In knowledge work and software, it describes tools and practices enabling co-creation, distributed editing, and collective decision-making across asynchronous or real-time channels."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:collaborative-systems-modality-operation ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:collaborative-systems-modality-learning ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:asynchronous-collaboration ],
        ngm:infra-computing-and-cloud ;
    skos:broader ngm:infra-computing-and-cloud ;
    vc:bridgesTo ngm:collaboration ;
    vc:enables ngm:collective-intelligence-system,
        ngm:realtime-collaboration ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:asynchronous-collaboration,
        ngm:collaborative-systems-modality-learning,
        ngm:collaborative-systems-modality-operation ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:collaborative-systems-modality-robot,
        ngm:distributed-collaboration,
        ngm:human-robot-interaction,
        ngm:multi-agent-systems ;
    vc:slug "collaborative-systems-modality" ;
    vc:sourceDomain "infrastructure" .

ngm:communication-infrastructure a owl:Class ;
    rdfs:label "Communication Infrastructure"@en ;
    rdfs:comment "The physical and logical substrate — including fibre, wireless networks, data centres, protocols, and switching equipment — that enables the transmission of information between nodes in a networked system. It underpins digital services by providing reliable, low-latency, and high-bandwidth connectivity at scale, from local area networks to global internet backbones."@en ;
    rdfs:subClassOf ngm:ai-infrastructure ;
    vc:enables ngm:cloud-computing,
        ngm:communication-tools,
        ngm:immersive-communication ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:bandwidth-optimization,
        ngm:network-communication ;
    vc:slug "communication-infrastructure" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:5-g-network,
        ngm:communication-protocol .

ngm:communication-protocols a owl:Class ;
    rdfs:label "Communication Protocols"@en ;
    rdfs:comment "Communication protocols are formal sets of rules, conventions, and standards that specify how data is formatted, transmitted, received, and acknowledged between two or more communicating entities, including computers, devices, and software systems. They define the syntax and semantics of messages, error detection and correction mechanisms, flow control, session management, and the sequencing of exchanges required to achieve reliable information transfer. Protocols operate across layered architectural models such as the OSI Reference Model and the TCP/IP suite, where each layer provides well-defined services to the layer above it while abstracting the implementation details below. Together, these layered agreements enable heterogeneous systems from different vendors and organisations to interoperate reliably across diverse network topologies."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:network-infrastructure ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:session-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:application-layer ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:data-link-layer ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:transport-layer ],
        ngm:network-protocol ;
    vc:bridgesTo ngm:agent-communication-language,
        ngm:consensus-mechanism,
        ngm:spatial-computing ;
    vc:contrastsWith ngm:proprietary-interface ;
    vc:enables ngm:distributed-systems,
        ngm:interoperability,
        ngm:real-time-communication ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:application-layer,
        ngm:data-link-layer,
        ngm:session-management,
        ngm:transport-layer ;
    vc:implements ngm:osi-model,
        ngm:tcp-ip ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:g-rpc,
        ngm:http,
        ngm:message-queue,
        ngm:mqtt,
        ngm:websocket ;
    vc:requires ngm:network-infrastructure ;
    vc:slug "communication-protocols" ;
    vc:sourceDomain "infrastructure" ;
    vc:standardizedBy ngm:ieee,
        ngm:ietf,
        ngm:iso ;
    vc:supports ngm:cloud-computing,
        ngm:edge-computing,
        ngm:internet-of-things ;
    vc:uses ngm:error-correction,
        ngm:flow-control .

ngm:community-detection a owl:Class ;
    rdfs:label "Community Detection"@en ;
    rdfs:comment "Community detection is the computational task of identifying cohesive subgroups, or communities, within a network graph, where nodes within each group are more densely interconnected than they are with nodes in other groups. Algorithms such as the Louvain and Leiden methods optimise a modularity objective to partition the graph, whilst spectral clustering, label propagation, and stochastic block models offer alternative formulations. The problem is formally NP-hard in its general form, making approximation and heuristic approaches the practical norm. Applications span social-network analysis, bioinformatics, knowledge-graph organisation, recommendation systems, and cybersecurity anomaly detection."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:linear-algebra ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:graph-theory ],
        ngm:network-analysis ;
    vc:bridgesTo ngm:blockchain-governance,
        ngm:distributed-systems ;
    vc:contrastsWith ngm:graph-partitioning,
        ngm:hierarchical-clustering ;
    vc:dependsOn ngm:graph-theory,
        ngm:machine-learning ;
    vc:enables ngm:anomaly-detection,
        ngm:bioinformatics,
        ngm:data-aggregation,
        ngm:fraud-detection,
        ngm:knowledge-graph-embedding,
        ngm:recommendation-systems ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:label-propagation,
        ngm:leiden-algorithm,
        ngm:louvain-algorithm,
        ngm:modularity-optimisation,
        ngm:spectral-clustering,
        ngm:stochastic-block-model ;
    vc:qualityScore "0.9"^^xsd:float ;
    vc:relatedTo ngm:clustering,
        ngm:deep-learning,
        ngm:link-prediction,
        ngm:network-topology,
        ngm:self-supervised-learning,
        ngm:social-network-analysis ;
    vc:requires ngm:graph-theory,
        ngm:linear-algebra ;
    vc:slug "community-detection" ;
    vc:sourceDomain "machine-learning" ;
    vc:supports ngm:knowledge-graph,
        ngm:linked-data ;
    vc:uses ngm:graph-neural-networks,
        ngm:information-theory,
        ngm:matrix-factorisation,
        ngm:node-embedding,
        ngm:random-walks .

ngm:content-delivery a owl:Class ;
    rdfs:label "Content Delivery"@en ;
    rdfs:comment "Content delivery is the distribution of digital media such as web pages, video and software to end users, typically optimised for speed and reliability. It is commonly accelerated by content delivery networks."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:video-compression ],
        ngm:infra-network-and-comms ;
    skos:broader ngm:infra-network-and-comms ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:video-compression ;
    vc:slug "content-delivery" ;
    vc:sourceDomain "infrastructure" .

ngm:content-distribution a owl:Class ;
    rdfs:label "Content Distribution"@en ;
    rdfs:comment "Content Distribution encompasses the technical and logistical systems that deliver digital media—web pages, video, software, and other assets—from origin servers to end users at scale, minimising latency and maximising availability by replicating and caching content geographically close to consumers. It is realised primarily through Content Delivery Networks (CDNs) that operate distributed edge node infrastructure, but also includes peer-to-peer protocols, adaptive bitrate streaming, and decentralised storage networks as alternative or complementary mechanisms. Effective content distribution is the foundational infrastructure of the commercial internet, underpinning e-commerce, streaming media, and cloud-native application delivery."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:edge-computing ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:content-delivery-network-cdn ],
        ngm:digital-infrastructure ;
    vc:enables ngm:cloud-native-applications,
        ngm:video-streaming ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:content-delivery-network-cdn,
        ngm:edge-computing ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:cloud-infrastructure,
        ngm:decentralized-storage,
        ngm:peer-to-peer-network ;
    vc:slug "content-distribution" ;
    vc:sourceDomain "infrastructure" .

ngm:continuous-batching a owl:Class ;
    rdfs:label "Continuous Batching"@en ;
    rdfs:comment "Continuous batching is a large language model serving technique in which the inference scheduler admits and evicts requests at the granularity of individual decoding steps rather than running a whole batch to completion before starting the next. As soon as any sequence in the batch finishes generating, its slot is freed and a queued request takes its place, keeping the GPU saturated and dramatically improving throughput and latency under heterogeneous request lengths. It is a defining feature of modern inference engines such as vLLM and is typically combined with paged attention and a shared key-value cache."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:kv-cache ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gpu-compute ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:transformer-architecture ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gpu-memory ],
        ngm:inference-optimisation ;
    vc:contrastsWith ngm:batch-processing,
        ngm:static-batching,
        ngm:triton-inference-server ;
    vc:dependsOn ngm:attention-mechanism,
        ngm:autoregressive-decoding,
        ngm:paged-attention ;
    vc:enables ngm:gpu-utilisation,
        ngm:large-language-models,
        ngm:multi-tenant-inference,
        ngm:throughput ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:chunked-prefill,
        ngm:kv-cache,
        ngm:request-scheduling,
        ngm:slot-management ;
    vc:isPartOf ngm:inference-serving,
        ngm:model-serving ;
    vc:qualityScore "0.91"^^xsd:float ;
    vc:relatedTo ngm:flash-attention,
        ngm:prefill-decode-disaggregation,
        ngm:quantisation,
        ngm:retrieval-augmented-generation,
        ngm:speculative-decoding,
        ngm:tensor-parallelism ;
    vc:requires ngm:gpu-compute,
        ngm:gpu-memory,
        ngm:transformer-architecture ;
    vc:slug "continuous-batching" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:sglang,
        ngm:tensorrt-llm,
        ngm:token-generation,
        ngm:v-llm ;
    vc:uses ngm:autoregressive-decoding,
        ngm:gpu,
        ngm:kv-cache,
        ngm:memory-management,
        ngm:paged-attention .

ngm:continuous-monitoring a owl:Class ;
    rdfs:label "Continuous Monitoring"@en ;
    rdfs:comment "An ongoing, automated process of collecting, analysing, and reporting metrics, logs, and events from systems, processes, or environments in near-real time to detect anomalies, ensure compliance, and support rapid response. Continuous monitoring operationalises oversight by replacing periodic audits with persistent telemetry streams fed into dashboards, alert rules, and automated remediation workflows. It is fundamental to DevSecOps, regulatory compliance programmes, and risk management frameworks that require timely evidence of control effectiveness."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:log-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:alerting ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:observability ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-pipeline ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:metrics-collection ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:telemetry ],
        ngm:governance ;
    vc:contrastsWith ngm:periodic-audit ;
    vc:dependsOn ngm:infrastructure ;
    vc:enables ngm:anomaly-detection,
        ngm:compliance-monitoring,
        ngm:incident-response ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:alerting,
        ngm:log-management,
        ngm:metrics-collection,
        ngm:telemetry ;
    vc:implements ngm:risk-management,
        ngm:security-operations ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:audit-trail,
        ngm:devsecops,
        ngm:security-information-and-event-management ;
    vc:requires ngm:data-pipeline,
        ngm:observability ;
    vc:slug "continuous-monitoring" ;
    vc:sourceDomain "governance" ;
    vc:supports ngm:accountability,
        ngm:transparency .

ngm:cosmos-sdk a owl:Class ;
    rdfs:label "Cosmos SDK"@en ;
    rdfs:comment "The Cosmos SDK is an open-source modular framework for building application-specific blockchains in the Cosmos ecosystem. It provides composable modules for accounts, staking, governance, and token management, and integrates with the Tendermint BFT consensus engine to enable sovereign, interoperable chains connected via the Inter-Blockchain Communication protocol."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:tendermint ],
        ngm:cosmos ;
    vc:bridgesTo ngm:decentralized-finance,
        ngm:distributed-systems ;
    vc:contrastsWith ngm:ethereum-smart-contract-platform-virtual-machine ;
    vc:dependsOn ngm:cosmos ;
    vc:enables ngm:application-specific-blockchain,
        ngm:delegated-proof-of-stake,
        ngm:ibc,
        ngm:on-chain-governance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:abci ;
    vc:implements ngm:byzantine-fault-tolerance,
        ngm:proof-of-stake ;
    vc:isPartOf ngm:blockchain,
        ngm:cosmos ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:requires ngm:tendermint ;
    vc:slug "cosmos-sdk" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:blockchain-interoperability,
        ngm:smart-contract,
        ngm:token-economics ;
    vc:uses ngm:protobuf .

ngm:crypto-regulation a owl:Class ;
    rdfs:label "Crypto Regulation"@en ;
    rdfs:comment "Crypto regulation is the body of laws and supervisory rules governing the issuance, trading, custody and use of crypto-assets, including authorisation of service providers, disclosure requirements, market conduct rules, client-asset custody standards, and anti-money-laundering obligations."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
