# Travel Rule
blockchain:TravelRule rdf:type owl:Class ;
    rdfs:label "Travel Rule"@en ;
    rdfs:comment "The Travel Rule is a regulatory requirement mandating that cryptocurrency exchanges and custodial services collect and transmit KYCCompliance information (originator and beneficiary details) with transactions above specified thresholds (typically $3,000 USD), mirroring traditional wire transfer reporting obligations. Originating from FinCEN guidance and extended by regulators globally including the FATF, the Travel Rule seeks to enable law enforcement tracking of CryptoTransaction and detection of sanctions violations and MoneyLaundering activities. Implementation challenges include developing interoperable technical standards for PrivacyPreservingIdentification, determining application to DecentralizedFinance, and balancing compliance with user privacy rights under GDPR and similar regulations."@en ;
    skos:prefLabel "Travel Rule"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:blockchain:travel-rule" ;
    owl:sameAs <urn:visionclaw:concept:blockchain:travel-rule> ;
    vcw:contentHash "sha256-12-f661b9281e25" ;
    vcw:qualityScore "0.4"^^xsd:decimal ;
    vcw:legacyTermId "BC-0477" ;
    vcw:ontologyStatus "stub-needs-content" ;
    vcw:maturityLevel "draft" ;
    vcw:authorityScore "0.0"^^xsd:decimal ;
    dcterms:identifier "BC-0477" ;
    dcterms:subject "blockchain" ;
    owl:versionInfo "2.0.0" ;
    dcterms:created "2026-04-26T00:00:00Z"^^xsd:dateTime ;
    dcterms:modified "2026-04-26T13:00:00Z"^^xsd:dateTime ;
    vcw:owlRole "Concept" .

# Securities Regulation
blockchain:SecuritiesRegulation rdf:type owl:Class ;
    rdfs:label "Securities Regulation"@en ;
    rdfs:comment "The legal and regulatory frameworks determining whether digital assets qualify as securities requiring registration and disclosure obligations, with fundamental implications for cryptocurrency token classification, distribution mechanisms, and compliance across jurisdictions including the SEC Howey Test, EU MiCA, and FCA principles-based approaches."@en ;
    skos:prefLabel "Securities Regulation"@en ;
