    vc:slug "remote-communication" ;
    vc:sourceDomain "distributed-collaboration" .

ngm:remote-rendering a owl:Class ;
    rdfs:label "Remote Rendering"@en ;
    rdfs:comment "Remote Rendering offloads GPU-intensive 3D scene computation to a server or cloud node, streaming compressed video frames to a thin client such as an XR headset or mobile device. This approach decouples visual fidelity from device hardware constraints, enabling photorealistic graphics on low-power endpoints while centralising GPU resources. Latency and bandwidth are critical quality-of-service parameters; edge computing deployments minimise round-trip delay to support interactive frame rates."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:edge-computing ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gpu-compute ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:latency ],
        ngm:infra-computing-and-cloud ;
    skos:broader ngm:infra-computing-and-cloud ;
    vc:enables ngm:photorealistic-rendering ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:edge-computing,
        ngm:gpu-compute,
        ngm:latency ;
    vc:slug "remote-rendering" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:cloud-infrastructure,
        ngm:content-delivery-network .

ngm:remote-surgery a skos:Concept ;
