            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:self-attention ],
        ngm:natural-language-processing ;
    vc:bridgesTo ngm:knowledge-graphing,
        ngm:multimodal-ai-architecture-ai ;
    vc:contrastsWith ngm:diffusion-models,
        ngm:state-space-models ;
    vc:enables ngm:code-generation,
        ngm:dialogue-systems,
