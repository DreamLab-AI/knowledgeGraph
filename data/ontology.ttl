] .

mv:StandardFormatSupport rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:relatedTo ;
    owl:someValuesFrom mv:UniversalSceneDescription
] .

mv:StandardFormatSupport rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:relatedTo ;
    owl:someValuesFrom mv:MetaverseStandardsForum
] .

# Standardization Bodies
mv:StandardizationBodies a owl:Class ;
    rdfs:subClassOf mv:StandardsOrganization ;
    rdfs:label "Standardization Bodies"@en ;
    rdfs:comment "Organizations developing technical standards for metaverse technologies, including IEEE (Metaverse Standards Committee), W3C (Immersive Web Working Group), ISO/IEC (3D formats), ITU (telecommunications), and the Metaverse Standards Forum coordinating 1,800 member organizations for interoperability."@en ;
