    vc:requires ngm:function-calling,
        ngm:tool-use ;
    vc:slug "action-executor" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:orchestration,
        ngm:runtime-environment .

ngm:aerial-robot a owl:Class ;
    rdfs:label "Aerial Robot"@en ;
    rdfs:comment "Aerial Robot - An autonomous or remotely operated aircraft equipped with Sensors, Actuators, and Navigation Systems for performing surveillance, inspection, delivery, and environmental monitoring tasks in three-dimensional airspace with minimal human intervention."@en ;
