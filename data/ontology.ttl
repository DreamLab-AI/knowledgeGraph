    vc:slug "json-serialisation" ;
    vc:sourceDomain "data" .

ngm:jvm-runtime a owl:Class ;
    rdfs:label "JVM Runtime"@en ;
    rdfs:comment "The JVM runtime is the execution environment provided by the Java Virtual Machine, which loads, verifies and runs platform-independent bytecode. It supplies just-in-time compilation, automatic garbage collection, threading and a security model that isolates executing code. The JVM hosts many languages beyond Java, including Kotlin and Scala, and underpins several enterprise blockchain platforms."@en ;
    rdfs:subClassOf ngm:computing-infrastructure ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:kotlin,
