ngm:hyperparameter-tuning a owl:Class ;
    rdfs:label "Hyperparameter Tuning"@en ;
    rdfs:comment "Hyperparameter tuning is the process of searching for the optimal configuration of parameters that govern the training process of a machine learning model, as distinct from the model parameters learned during training itself. Hyperparameters include learning rate, batch size, network depth, regularisation coefficients, optimiser choice, and architectural choices such as kernel size or number of attention heads. The tuning process employs search strategies—grid search, random search, Bayesian optimisation, or evolutionary algorithms—to identify configurations that maximise model performance on a held-out validation set. Efficient hyperparameter tuning is critical to practical machine learning deployment, as model performance is often highly sensitive to these configuration choices."@en ;
    rdfs:subClassOf ngm:machine-learning ;
    vc:enables ngm:deep-learning,
        ngm:machine-learning-model ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:auto-ml,
        ngm:bayesian-inference,
        ngm:overfitting ;
    vc:slug "hyperparameter-tuning" ;
    vc:sourceDomain "ai" ;
    vc:supports ngm:model-evaluation-results ;
    vc:uses ngm:feature-engineering,
        ngm:gradient-descent,
        ngm:machine-learning-pipeline .

ngm:icml a owl:Class ;
    rdfs:label "ICML"@en ;
    rdfs:comment "The International Conference on Machine Learning (ICML) is the premier annual academic conference for machine learning research, organised by the International Machine Learning Society (IMLS) since 1980. ICML serves as the primary venue for disseminating foundational and applied advances across supervised learning, unsupervised learning, reinforcement learning, deep learning, optimisation, and the theory of machine learning. Acceptance rates have fallen to roughly 26% as submission volumes have grown into the thousands annually, making it one of the most selective and impactful venues in AI research."@en ;
    rdfs:subClassOf ngm:research-methods ;
    vc:enables ngm:benchmark-standard,
        ngm:federated-learning,
        ngm:machine-learning-technique,
        ngm:transfer-learning ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:ai-safety-research,
        ngm:deep-learning,
        ngm:generative-ai,
        ngm:machine-learning,
        ngm:neural-network,
        ngm:reinforcement-learning ;
    vc:slug "icml" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:machine-learning-model,
        ngm:optimization-algorithm .

ngm:identity-systems a owl:Class ;
    rdfs:label "Identity Systems"@en ;
    rdfs:comment "Identity Systems are the technical and organisational frameworks that establish, manage, verify, and revoke digital identities for users, devices, and services. They encompass authentication mechanisms, credential issuance, public-key infrastructure, and decentralised identity models (self-sovereign identity, DIDs) that enable secure, interoperable identification across platforms and jurisdictions."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:self-sovereign-identity ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:public-key-infrastructure ],
        ngm:infra-security-and-identity ;
    skos:broader ngm:infra-security-and-identity ;
    vc:enables ngm:access-control ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:public-key-infrastructure,
        ngm:self-sovereign-identity ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:slug "identity-systems" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:authentication,
        ngm:digital-identity .

ngm:incentive-alignment a owl:Class ;
    rdfs:label "Incentive Alignment"@en ;
    rdfs:comment "Incentive Alignment is the design principle by which blockchain protocols structure economic rewards and penalties such that individual rational behaviour converges with the collective goals of the network. When correctly engineered, participants who act in their own self-interest—validators confirming blocks, miners extending chains, token holders participating in governance—simultaneously reinforce system security, liveness, and integrity. Misaligned incentives produce attack vectors such as selfish mining, validator collusion, or governance capture."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:consensus-mechanism ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:reward-distribution ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:mechanism-design ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:block-reward ],
        ngm:bc-defi-and-economics,
        ngm:blockchain-entity,
        ngm:economic-mechanism ;
    skos:broader ngm:bc-defi-and-economics ;
    vc:contrastsWith ngm:51-attack,
        ngm:selfish-mining ;
    vc:enables ngm:tokenomics,
        ngm:validator-node ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:block-reward,
        ngm:reward-distribution ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:dao-governance,
        ngm:emission-schedule,
        ngm:governance-token,
        ngm:proof-of-stake ;
    vc:requires ngm:consensus-mechanism,
        ngm:mechanism-design ;
    vc:slug "incentive-alignment" ;
    vc:sourceDomain "blockchain" .

ngm:interoperability-framework a owl:Class ;
    rdfs:label "Interoperability Framework"@en ;
    rdfs:comment "Coordinated set of standards and specifications enabling interaction between heterogeneous systems in metaverse environments."@en ;
