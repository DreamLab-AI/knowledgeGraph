ngm:mcp-client a owl:Class ;
    rdfs:label "MCP Client"@en ;
    rdfs:comment "An MCP client is the component within an AI host application that establishes and maintains a connection to one or more Model Context Protocol servers. It negotiates capabilities, forwards tool, resource, and prompt requests from the language model, and relays results back into the model's context. Each client maintains a one-to-one session with a server, mediating the model's access to external systems."@en ;
    rdfs:subClassOf ngm:ai-agent-system ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:mcp-server,
        ngm:model-context-protocol ;
    vc:slug "mcp-client" ;
    vc:sourceDomain "ai" .

ngm:mcp-server a owl:Class ;
    rdfs:label "MCP Server"@en ;
    rdfs:comment "An MCP server is a program that exposes tools, resources, and prompts to AI applications through the Model Context Protocol. It advertises its capabilities during connection negotiation and executes requests forwarded by an MCP client, returning structured results for the model to consume. Servers encapsulate access to external systems such as databases, APIs, file systems, and developer tooling."@en ;
    rdfs:subClassOf ngm:ai-agent-system ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:mcp-client,
        ngm:model-context-protocol ;
    vc:slug "mcp-server" ;
    vc:sourceDomain "ai" .

