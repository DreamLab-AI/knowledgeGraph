# Blockchain
blockchain:Blockchain rdf:type owl:Class ;
    rdfs:subClassOf blockchain:DistributedDataStructure ;
    rdfs:subClassOf blockchain:DistributedLedger ;
    rdfs:subClassOf blockchain:CryptographicSystem ;
    rdfs:label "Blockchain"@en ;
    rdfs:comment "A blockchain is a distributed, cryptographically-secured data structure consisting of an ordered chain of blocks, where each block contains a cryptographic hash of the previous block, a timestamp, and transaction data, maintained through a consensus mechanism across a peer-to-peer network without requiring a trusted central authority."@en ;
    skos:prefLabel "Blockchain"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:blockchain:blockchain" ;
    owl:sameAs <urn:visionclaw:concept:blockchain:blockchain> ;
    vcw:contentHash "sha256-12-7eff95984f87" ;
    vcw:qualityScore "0.5"^^xsd:decimal ;
    vcw:legacyTermId "BC-0001" ;
    vcw:ontologyStatus "complete" ;
    vcw:maturityLevel "mature" ;
    vcw:authorityScore "1.0"^^xsd:decimal ;
