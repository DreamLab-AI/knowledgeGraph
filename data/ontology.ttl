ngm:stable-diffusion a owl:Class ;
    rdfs:comment "An open-weights family of latent diffusion models for text-to-image generation, first released by Stability AI, CompVis, and Runway in August 2022, which performs iterative denoising in a compressed VAE latent space conditioned on CLIP text embeddings, making photorealistic and stylised image synthesis feasible on consumer GPUs and seeding a vast open ecosystem of fine-tunes, LoRAs, and tooling."@en ;
    rdfs:label "Stable Diffusion"@en ;
    rdfs:subClassOf ngm:diffusion-model ;
