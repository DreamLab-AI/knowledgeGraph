        ngm:zero-knowledge-proof .

ngm:visual-odometry a owl:Class ;
    rdfs:label "Visual Odometry"@en ;
    rdfs:comment "Visual odometry (VO) is a technique for incrementally estimating the six-degree-of-freedom pose (position and orientation) of a camera-equipped agent by detecting and tracking salient features across consecutive image frames and computing the relative camera motion between them via geometric constraints such as the essential or fundamental matrix. It provides ego-motion estimation without relying on GPS, wheel encoders, or external beacons, making it applicable in GPS-denied environments such as indoor spaces, underground tunnels, and planetary surfaces. Scale ambiguity in monocular configurations is resolved by stereo baselines or depth cameras; drift is bounded by fusing inertial measurements (visual-inertial odometry) or by applying loop-closure detection within a full SLAM pipeline."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:epipolar-geometry ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:camera-calibration ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:image-processing ],
        ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:bridgesTo ngm:autonomous-vehicle,
        ngm:mixed-reality,
        ngm:spatial-computing ;
    vc:contrastsWith ngm:localisation,
        ngm:odometry,
        ngm:wheel-odometry ;
    vc:dependsOn ngm:depth-sensing,
        ngm:inertial-measurement-unit ;
    vc:enables ngm:3-d-reconstruction,
        ngm:augmented-reality,
        ngm:autonomous-navigation,
        ngm:pose-estimation,
        ngm:robot-localisation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:simultaneous-localisation-and-mapping,
        ngm:visual-slam ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:ego-motion-estimation,
        ngm:factor-graph-optimisation,
        ngm:loop-closure-detection,
        ngm:point-cloud-processing,
        ngm:visual-place-recognition ;
    vc:requires ngm:camera-calibration,
        ngm:epipolar-geometry,
        ngm:image-processing ;
    vc:slug "visual-odometry" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:bundle-adjustment,
        ngm:computer-vision,
        ngm:feature-extraction,
        ngm:feature-matching,
        ngm:kalman-filter,
        ngm:ransac .

ngm:adaptive-control a owl:Class ;
    rdfs:label "Adaptive Control"@en ;
    rdfs:comment "A control strategy that automatically adjusts its parameters in real-time to maintain desired performance as system dynamics change or uncertainties are encountered. The controller learns and adapts to variations in the system or environment, using mechanisms such as system identification, parameter estimation, and online learning to compensate for model uncertainty and external disturbances."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:planning-and-scheduling ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:system-identification ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:stability-analysis ],
        ngm:closed-loop-control ;
    vc:bridgesTo ngm:ai-agent-system,
        ngm:machine-learning,
        ngm:reinforcement-learning ;
    vc:contrastsWith ngm:pid-control,
        ngm:robust-control ;
    vc:dependsOn ngm:feedback-control,
        ngm:state-estimation ;
    vc:enables ngm:autonomous-system,
        ngm:fault-tolerant-control,
        ngm:robust-control ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:planning-and-scheduling ;
    vc:implements ngm:online-learning,
        ngm:optimal-control ;
    vc:isPartOf ngm:control-theory ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:adaptive-systems ;
    vc:requires ngm:stability-analysis,
        ngm:system-identification ;
    vc:slug "adaptive-control" ;
    vc:sourceDomain "robotics" ;
    vc:supports ngm:robotics ;
    vc:uses ngm:parameter-estimation .

ngm:ai-trustworthiness a owl:Class ;
    rdfs:label "AI Trustworthiness"@en ;
    rdfs:comment "The degree to which an AI system demonstrates characteristics that warrant confidence and reliance, encompassing transparency, explainability, fairness, accountability, robustness, reliability, safety, security, and privacy throughout its lifecycle."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
