        ngm:permissioned-network ;
    vc:slug "private-blockchain" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:byzantine-fault-tolerance,
        ngm:hyperledger-besu,
        ngm:hyperledger-fabric .

ngm:probabilistic-risk-assessment a owl:Class ;
    rdfs:label "Probabilistic Risk Assessment"@en ;
    rdfs:comment "Probabilistic Risk Assessment (PRA) is a systematic methodology for quantifying the likelihood and consequences of adverse events in complex engineered systems. It enumerates accident scenarios, estimates the probability of each contributing failure and combines them to produce numeric risk measures and confidence bounds. PRA underpins safety-critical decision-making in domains such as nuclear, aerospace and critical infrastructure where rare, high-consequence failures must be rigorously characterised."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:fault-tree-analysis ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:statistics ],
        ngm:risk-assessment ;
    vc:bridgesTo ngm:reliability-engineering ;
    vc:contrastsWith ngm:hazard-analysis ;
    vc:dependsOn ngm:statistics ;
    vc:enables ngm:reliability-engineering,
        ngm:risk-assessment ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:uncertainty-quantification ;
    vc:isPartOf ngm:risk-assessment ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:fault-tolerance,
        ngm:reliability-engineering,
        ngm:safety-engineering ;
    vc:requires ngm:fault-tree-analysis,
        ngm:statistics ;
    vc:slug "probabilistic-risk-assessment" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:reliability-engineering,
        ngm:safety-engineering ;
    vc:uses ngm:fault-tree-analysis,
        ngm:hazard-analysis,
        ngm:uncertainty-quantification .

