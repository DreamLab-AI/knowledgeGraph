ngm:platform-service a owl:Class ;
    rdfs:label "Platform Service"@en ;
    rdfs:comment "A managed, API-exposed capability unit delivered by a cloud or middleware platform that provides reusable building blocks—such as authentication, storage, messaging, compute, or rendering—to applications built atop that platform. Platform services abstract the operational complexity of underlying infrastructure by encapsulating it behind stable, versioned contracts, enabling developers to compose higher-order application features without provisioning or administering raw resources. They are the foundational unit of Platform-as-a-Service (PaaS) and are central to cloud-native, microservices, and distributed systems architectures. At scale, platform services enforce tenancy boundaries, SLA guarantees, and metered billing, transforming infrastructure capabilities into economically composable software products."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:identity-and-access-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:notification-system ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:service-mesh ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:authentication-service ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:message-queue ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:api-design ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:service-level-agreement ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:api-gateway ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:object-storage ],
        ngm:infra-computing-and-cloud ;
    skos:broader ngm:infra-computing-and-cloud ;
    vc:bridgesTo ngm:ai-inference,
        ngm:spatial-computing ;
    vc:contrastsWith ngm:infrastructure-as-a-service,
        ngm:software-as-a-service ;
    vc:dependsOn ngm:container-orchestration,
        ngm:infrastructure-as-code ;
    vc:enables ngm:cloud-native-applications,
        ngm:digital-twin,
        ngm:metaverse-platform ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:api-gateway,
        ngm:authentication-service,
        ngm:message-queue,
        ngm:notification-system,
        ngm:object-storage,
        ngm:service-mesh ;
    vc:implements ngm:event-driven-architecture,
        ngm:microservices-architecture ;
    vc:isPartOf ngm:cloud-computing,
        ngm:platform-as-a-service ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:edge-computing,
        ngm:serverless-architecture ;
    vc:requires ngm:api-design,
        ngm:identity-and-access-management,
        ngm:service-level-agreement ;
    vc:slug "platform-service" ;
    vc:sourceDomain "infrastructure" ;
    vc:standardizedBy ngm:cloud-native-computing-foundation,
        ngm:open-api-specification ;
    vc:supports ngm:horizontal-scalability,
        ngm:observability ;
    vc:uses ngm:g-rpc,
        ngm:oauth-2-0,
        ngm:restful-api .

ngm:point-cloud-generation a owl:Class ;
    rdfs:label "Point Cloud Generation"@en ;
    rdfs:comment "Point Cloud Generation is the process of producing a set of discrete three-dimensional coordinate samples (points), each representing a position on the surface or within the volume of a physical object or environment, typically augmented with attributes such as colour (RGB), intensity, or surface normals. Generation methods include active sensing (LiDAR, structured light, time-of-flight cameras) and passive photogrammetric reconstruction from overlapping images, producing the fundamental geometric representation used in autonomous navigation, digital twins, and 3D content creation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:coordinate-system ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:sensor-fusion ],
        ngm:point-cloud ;
    vc:bridgesTo ngm:machine-learning,
        ngm:robotics ;
    vc:contrastsWith ngm:3-d-gaussian-splatting ;
    vc:dependsOn ngm:calibration ;
    vc:enables ngm:3-d-scanning,
        ngm:autonomous-navigation,
        ngm:digital-twin,
        ngm:object-detection,
        ngm:simultaneous-localisation-and-mapping ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:point-cloud-registration ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:3-d-reconstruction,
        ngm:geospatial-data,
        ngm:mesh-generation,
        ngm:structure-from-motion ;
    vc:requires ngm:coordinate-system,
        ngm:sensor-fusion ;
    vc:slug "point-cloud-generation" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:depth-sensing,
        ngm:lidar,
        ngm:photogrammetry,
        ngm:stereo-vision,
        ngm:structured-light,
        ngm:time-of-flight-sensor .

ngm:polycentric-governance a owl:Class ;
    rdfs:label "Polycentric Governance"@en ;
    rdfs:comment "Polycentric governance is a theory and practice of institutional arrangement in which authority over a shared domain is distributed across multiple overlapping, semi-autonomous decision-making centres rather than concentrated in a single hierarchy. Developed by Vincent and Elinor Ostrom through empirical study of common-pool resource management, the framework holds that complex social-ecological and sociotechnical systems benefit from diverse, redundant governance layers that can adapt, experiment, and mutually check one another. Each governance unit retains meaningful autonomy while engaging with others through negotiation, conflict-resolution mechanisms, and shared rules. Polycentric governance is increasingly applied to internet regulation, AI governance, and decentralised protocol design."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:meta-governance ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:conflict-resolution ],
        ngm:governance ;
    vc:bridgesTo ngm:blockchain,
        ngm:distributed-collaboration,
        ngm:federated-system ;
    vc:contrastsWith ngm:governance-architecture ;
    vc:enables ngm:dao-governance,
        ngm:multi-stakeholder-governance,
        ngm:participatory-policy-making ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:meta-governance ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:collective-action,
        ngm:common-pool-resources,
        ngm:community-governance,
        ngm:decentralized-governance,
        ngm:democratic-governance,
        ngm:institutional-design ;
    vc:requires ngm:conflict-resolution ;
    vc:slug "polycentric-governance" ;
    vc:sourceDomain "governance" ;
    vc:supports ngm:ai-governance,
        ngm:climate-governance,
        ngm:data-governance,
        ngm:internet-governance,
        ngm:platform-governance .

ngm:precision-recall-curve a owl:Class ;
    rdfs:label "Precision-Recall Curve"@en ;
    rdfs:comment "A diagnostic plot that traces the trade-off between precision and recall across the decision thresholds of a binary classifier, most informative under class imbalance where it focuses performance assessment on the minority positive class."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:recall ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:classification ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:precision ],
        ngm:confusion-matrix ;
    vc:bridgesTo ngm:anomaly-detection,
        ngm:medical-diagnosis-ai ;
    vc:contrastsWith ngm:accuracy,
        ngm:roc-curve ;
    vc:dependsOn ngm:class-imbalance,
        ngm:confusion-matrix ;
    vc:enables ngm:model-comparison,
        ngm:threshold-selection ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:area-under-the-curve,
        ngm:decision-threshold ;
    vc:isPartOf ngm:model-evaluation ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:average-precision,
        ngm:information-retrieval,
        ngm:object-detection,
        ngm:supervised-learning ;
    vc:requires ngm:classification,
        ngm:precision,
        ngm:recall ;
    vc:slug "precision-recall-curve" ;
    vc:sourceDomain "machine-learning" ;
    vc:uses ngm:f1-score,
        ngm:positive-predictive-value,
        ngm:true-positive-rate .

ngm:prefix-tuning a owl:Class ;
    rdfs:label "Prefix Tuning"@en ;
    rdfs:comment "A parameter-efficient fine-tuning technique that prepends trainable continuous vectors (prefixes) to the key and value matrices at each transformer layer, whilst keeping the pre-trained model parameters frozen. Unlike prompt tuning, which operates only on input embeddings, prefix tuning influences the attention mechanism at every layer, achieving stronger task-specific adaptation with roughly 0.1% of model parameters."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:fine-tuning ],
        ngm:parameter-efficient-fine-tuning ;
    vc:contrastsWith ngm:adapter-modules,
        ngm:prompt-tuning ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:parameter-efficient-fine-tuning ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires ngm:fine-tuning ;
    vc:slug "prefix-tuning" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:attention-mechanism,
        ngm:transfer-learning .

ngm:preimage-resistance a owl:Class ;
    rdfs:label "Preimage Resistance"@en ;
    rdfs:comment "Preimage Resistance is a security property of a cryptographic hash function requiring that, given a hash output h, it is computationally infeasible to find any input m such that H(m) = h. This one-way property is foundational for password hashing, proof-of-work puzzles, and blockchain address derivation, ensuring that knowledge of a public address does not reveal the corresponding private key."@en ;
    rdfs:subClassOf ngm:bc-cryptographic-primitive,
        ngm:blockchain-entity,
        ngm:cryptographic-primitive ;
    skos:broader ngm:bc-cryptographic-primitive ;
    vc:enables ngm:cryptographic-security,
        ngm:merkle-proof ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:cryptographic-hash-function,
        ngm:hash-function ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:blake2,
        ngm:collision-resistance,
        ngm:keccak-256,
        ngm:private-key,
        ngm:proof-of-work,
        ngm:sha-256 ;
    vc:slug "preimage-resistance" ;
    vc:sourceDomain "blockchain" .

ngm:privacy-controls a owl:Class ;
    rdfs:label "Privacy Controls"@en ;
    rdfs:comment "Privacy Controls are the technical, organisational, and procedural mechanisms that organisations deploy to protect individuals' personal data from unauthorised access, misuse, or disclosure, and to provide data subjects with meaningful agency over how their information is collected and used. They encompass access restrictions, anonymisation and pseudonymisation techniques, consent management interfaces, data minimisation policies, encryption, and privacy impact assessment processes. Effective privacy controls implement privacy by design principles, embedding data protection into systems from inception rather than applying it retrospectively. Regulatory frameworks such as GDPR mandate specific control categories and assign accountability for their implementation."@en ;
    rdfs:subClassOf ngm:privacy ;
    vc:enables ngm:compliance-framework,
        ngm:privacy-architecture,
        ngm:privacy-impact-assessment ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:consent-management,
        ngm:data-protection,
        ngm:gdpr,
        ngm:privacy-by-design ;
    vc:slug "privacy-controls" ;
    vc:sourceDomain "security" ;
    vc:uses ngm:data-minimisation,
        ngm:differential-privacy,
        ngm:encryption .

ngm:privacy-preserving a owl:Class ;
    rdfs:label "Privacy-Preserving"@en ;
    rdfs:comment "Privacy-preserving describes methods and systems designed to perform useful computation or data analysis while limiting exposure of the underlying personal or sensitive data."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptography ],
        ngm:cryptography ;
    vc:enables ngm:privacy-preserving-ai ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:cryptography ;
    vc:slug "privacy-preserving" ;
    vc:sourceDomain "security" .

ngm:privacy-preserving-data-sharing a owl:Class ;
    rdfs:label "Privacy Preserving Data Sharing"@en ;
    rdfs:comment "Privacy Preserving Data Sharing (PPDS) encompasses the set of cryptographic, statistical, and algorithmic techniques that allow multiple parties to exchange, query, or jointly analyse data without disclosing raw sensitive records. Core mechanisms include differential privacy, secure multi-party computation, homomorphic encryption, federated learning, and synthetic data generation, each providing formal or empirical guarantees that individual-level information cannot be inferred. PPDS enables collaborative analytics, AI model training, and regulatory reporting across organisational and jurisdictional boundaries while satisfying privacy regulations such as GDPR and HIPAA. It is a foundational discipline at the intersection of cryptography, distributed systems, and machine learning, increasingly deployed in healthcare, finance, and cross-industry data-sharing consortia."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:synthetic-data-generation ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:federated-learning ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:secure-multi-party-computation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptographic-protocols ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:homomorphic-encryption ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:differential-privacy ],
        ngm:data-sharing ;
    vc:bridgesTo ngm:federated-learning ;
    vc:contrastsWith ngm:anonymisation,
        ngm:data-masking ;
    vc:dependsOn ngm:trusted-execution-environments,
        ngm:zero-knowledge-proof ;
    vc:enables ngm:distributed-ai-training ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:differential-privacy,
        ngm:federated-learning,
        ngm:homomorphic-encryption,
        ngm:secure-multi-party-computation,
        ngm:synthetic-data-generation ;
    vc:implements ngm:gdpr,
        ngm:hipaa ;
    vc:isPartOf ngm:data-governance ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:consent-management,
        ngm:data-minimisation,
        ngm:information-security ;
    vc:requires ngm:cryptographic-protocols ;
    vc:slug "privacy-preserving-data-sharing" ;
    vc:sourceDomain "data" ;
    vc:supports ngm:data-monetisation,
        ngm:regulatory-compliance ;
    vc:uses ngm:access-control,
        ngm:noise-mechanisms .

ngm:production-rules a owl:Class ;
    rdfs:label "Production Rules"@en ;
    rdfs:comment "Production rules are condition-action statements of the form 'if antecedent then consequent' that encode procedural and declarative knowledge in symbolic artificial-intelligence systems. A collection of such rules forms a production system whose inference engine repeatedly matches rule conditions against a working memory of facts, selects which eligible rule to apply, and fires it to assert new facts or perform actions. They are the principal knowledge-representation formalism of classical expert systems and rule-based reasoning, valued for transparency and modular editing. Production rules underpin forward- and backward-chaining inference and remain widely used in business rule engines and policy automation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:knowledge-base ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:inference-engine ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:inference-engine ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:conflict-resolution ],
        ngm:knowledge-representation ;
    vc:enables ngm:expert-systems ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:conflict-resolution,
        ngm:inference-engine ;
    vc:implements ngm:knowledge-representation ;
    vc:isPartOf ngm:expert-systems ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:inference-engine,
        ngm:knowledge-base,
        ngm:symbolic-ai ;
    vc:requires ngm:inference-engine,
        ngm:knowledge-base ;
    vc:slug "production-rules" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:symbolic-ai ;
    vc:uses ngm:conflict-resolution,
        ngm:knowledge-base .

ngm:proof-of-reserve a owl:Class ;
    rdfs:label "Proof Of Reserve"@en ;
    rdfs:comment "Proof of reserve is a verification practice in which a custodian or exchange demonstrates that it holds assets sufficient to cover its customer liabilities. It typically combines an on-chain attestation of owned assets with a Merkle-tree commitment to the liability set, allowing users to verify inclusion of their balance without revealing others. Robust schemes also prove liabilities to establish solvency, often with auditor or zero-knowledge support."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:attestation ],
        ngm:blockchain ;
    skos:broader ngm:blockchain ;
    vc:bridgesTo ngm:zero-knowledge-proof ;
    vc:dependsOn ngm:merkle-tree ;
    vc:enables ngm:transparency ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:implements ngm:cryptographic-proof ;
    vc:isPartOf ngm:audit ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:audit,
        ngm:custodian ;
    vc:requires ngm:attestation ;
    vc:slug "proof-of-reserve" ;
    vc:sourceDomain "blockchain" ;
    vc:standardizedBy ngm:merkle-tree ;
    vc:supports ngm:centralised-exchange ;
    vc:uses ngm:attestation,
        ngm:cryptographic-proof .

ngm:public-goods a owl:Class ;
    rdfs:label "Public Goods"@en ;
    rdfs:comment "Public goods are goods or services that are non-excludable and non-rival in consumption, meaning that no one can be effectively prevented from using them and one person's use does not diminish availability to others. Because individuals cannot be charged directly, public goods are prone to under-provision through the free-rider problem and typically require collective or government funding. Examples include clean air, national defence, public knowledge, and open-source software."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:welfare-economics ],
        ngm:economics ;
    vc:bridgesTo ngm:quadratic-funding ;
    vc:dependsOn ngm:economics ;
    vc:enables ngm:collective-action ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:economics,
        ngm:welfare-economics ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:collective-action,
        ngm:digital-commons,
        ngm:governance,
        ngm:stakeholder ;
    vc:requires ngm:welfare-economics ;
    vc:slug "public-goods" ;
    vc:sourceDomain "governance" ;
    vc:supports ngm:digital-commons,
        ngm:governance ;
    vc:uses ngm:quadratic-funding .

ngm:query-processing a owl:Class ;
    rdfs:label "Query Processing"@en ;
    rdfs:comment "Query processing is the set of activities a database system performs to translate a declarative query into an efficient execution that returns the requested data. It spans parsing and semantic analysis, logical and physical query optimisation, plan selection, and execution against stored data and indexes. Effective query processing is central to database performance, determining how quickly results are produced and how system resources are used."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:indexing ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:relational-database ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:indexing ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:sql ],
        ngm:database-system ;
    vc:bridgesTo ngm:infrastructure ;
    vc:dependsOn ngm:indexing ;
    vc:enables ngm:data-warehouse,
        ngm:transaction-processing ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:indexing,
        ngm:relational-database ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:database-system,
        ngm:relational-database ;
    vc:requires ngm:indexing,
        ngm:sql ;
    vc:slug "query-processing" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:transaction-processing ;
    vc:uses ngm:sql .

ngm:radio-access-network a owl:Class ;
    rdfs:label "Radio Access Network"@en ;
    rdfs:comment "A radio access network (RAN) is the part of a mobile telecommunications system that connects user devices to the core network over the air interface via base stations and antennas. It manages radio resource allocation, modulation, and handover across cells. Modern architectures such as Open RAN disaggregate hardware and software to enable multi-vendor, virtualised deployments."@en ;
    rdfs:subClassOf ngm:network-infrastructure ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:physical-layer,
        ngm:wireless-radio ;
    vc:slug "radio-access-network" ;
    vc:sourceDomain "infrastructure" .

ngm:rag-pipeline a owl:Class ;
    rdfs:label "RAG Pipeline"@en ;
    rdfs:comment "A RAG pipeline is the end-to-end software architecture that implements retrieval-augmented generation, encompassing document ingestion and chunking, embedding generation, vector store indexing, query-time retrieval, context assembly, and language model generation to produce grounded, verifiable responses from external knowledge sources. It operationalises the RAG paradigm as a deployable, maintainable system with distinct stages, each subject to independent optimisation."@en ;
    rdfs:subClassOf ngm:retrieval-augmented-generation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:agentic-rag,
        ngm:knowledge-graph ;
    vc:slug "rag-pipeline" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:chunking,
        ngm:embedding-search,
        ngm:vector-store .

ngm:rb-0049-motion-planning a owl:Class ;
    rdfs:label "rb 0049 motion planning"@en ;
    rdfs:comment "Motion planning is the computational process of determining a sequence of valid robot configurations or control inputs that moves a robot from an initial state to a goal state while satisfying constraints such as obstacle avoidance, joint limits, and dynamic feasibility. It bridges high-level task specification and low-level actuation, encompassing path planning, trajectory optimisation, and task-and-motion planning (TAMP). Sampling-based methods (RRT, PRM) and optimisation-based approaches are the dominant paradigms, increasingly augmented by learning-based techniques for dynamic and uncertain environments."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:rb-0051-trajectory-planning ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:rb-0052-collision-avoidance ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:path-planning ],
        ngm:robo-navigation-and-planning ;
    skos:broader ngm:robo-navigation-and-planning ;
    vc:enables ngm:rb-0103-collaborative-operation ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:path-planning,
        ngm:rb-0051-trajectory-planning,
        ngm:rb-0052-collision-avoidance ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:autonomous-navigation,
        ngm:obstacle-avoidance,
        ngm:task-planning ;
    vc:slug "rb-0049-motion-planning" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:rb-0021-robot-kinematics,
        ngm:rrt-algorithm .

ngm:rb-0069-lidar a owl:Class ;
    rdfs:label "rb 0069 lidar"@en ;
    rdfs:comment "A remote sensing technology that measures distances by emitting laser pulses and calculating time-of-flight to generate precise three-dimensional point clouds of the surrounding environment, enabling robots and autonomous vehicles to perceive and navigate physical space with centimetre-level accu..."@en ;
    rdfs:subClassOf ngm:robo-perception ;
    skos:broader ngm:robo-perception ;
    vc:bridgesTo ngm:lidar ;
    vc:enables ngm:mapping,
        ngm:obstacle-detection,
        ngm:simultaneous-localisation-and-mapping ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:relatedTo ngm:autonomous-navigation,
        ngm:point-cloud,
        ngm:sensor-fusion,
        ngm:slam ;
    vc:slug "rb-0069-lidar" ;
    vc:sourceDomain "robotics" .

ngm:rb-0091-safety-rated-monitored-stop a owl:Class ;
    rdfs:label "rb 0091 safety rated monitored stop"@en ;
    rdfs:comment "A safety-rated monitored stop (SRMS) is a robot stopping function in which the robot halts motion while the control system continuously monitors joint positions to verify the robot remains stationary, without removing power to the actuators. Unlike an emergency stop, SRMS allows rapid resumption of operation when the hazardous condition clears, and is central to collaborative robot (cobot) safety architectures defined in ISO 10218 and ISO/TS 15066."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:rb-0089-risk-assessment ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:rb-0054-position-control ],
        ngm:robo-safety-and-standards,
        ngm:robot-safety ;
    skos:broader ngm:robo-safety-and-standards ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:rb-0090-emergency-stop,
        ngm:rb-0092-protective-stop,
        ngm:rb-0093-speed-limitation ;
    vc:requires ngm:rb-0054-position-control,
        ngm:rb-0089-risk-assessment ;
    vc:slug "rb-0091-safety-rated-monitored-stop" ;
    vc:sourceDomain "robotics" ;
    vc:standardizedBy ngm:iso-10218,
        ngm:iso-ts-15066 ;
    vc:supports ngm:human-robot-interaction,
        ngm:rb-0096-safeguarding .

ngm:rb-0092-protective-stop a owl:Class ;
    rdfs:label "rb 0092 protective stop"@en ;
    rdfs:comment "A protective stop is a safety-initiated cessation of robot motion that halts all hazardous movement when a safety function is triggered, without necessarily cutting power to the drive system. Unlike an emergency stop, a protective stop permits automatic restart once the triggering condition is resolved, making it a standard mechanism in collaborative robot cells operating under ISO 10218 and ISO/TS 15066. It is fundamental to speed-and-separation monitoring and power-and-force-limiting safety strategies."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:functional-safety ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:risk-assessment ],
        ngm:robo-safety-and-standards,
        ngm:robot-safety ;
    skos:broader ngm:robo-safety-and-standards ;
    vc:enables ngm:collaborative-systems-modality-operation,
        ngm:human-robot-interaction ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:collaborative-systems-modality-robot,
        ngm:robot-safety ;
    vc:requires ngm:functional-safety,
        ngm:risk-assessment ;
    vc:slug "rb-0092-protective-stop" ;
    vc:sourceDomain "robotics" ;
    vc:standardizedBy ngm:iso-10218,
        ngm:iso-ts-15066 .

ngm:rb-0095-safety-zone a owl:Class ;
    rdfs:label "rb 0095 safety zone"@en ;
    rdfs:comment "A safety zone is a defined spatial region around a robot or autonomous system within which human presence or other objects trigger protective actions such as speed reduction, monitored stops, or full emergency stops. Safety zones are configured and monitored via safeguarding devices and are a central mechanism for achieving collaborative and safe robot operation in accordance with ISO 10218 and ISO/TS 15066."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:rb-0087-safety-standard ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:rb-0089-risk-assessment ],
        ngm:robo-safety-and-standards,
        ngm:robot-safety ;
    skos:broader ngm:robo-safety-and-standards ;
    vc:dependsOn ngm:functional-safety,
        ngm:rb-0075-range-finder ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:rb-0091-safety-rated-monitored-stop,
        ngm:rb-0092-protective-stop,
        ngm:rb-0093-speed-limitation,
        ngm:rb-0096-safeguarding ;
    vc:requires ngm:rb-0087-safety-standard,
        ngm:rb-0089-risk-assessment ;
    vc:slug "rb-0095-safety-zone" ;
    vc:sourceDomain "robotics" .

ngm:real-time-streaming a owl:Class ;
    rdfs:label "Real-Time Streaming"@en ;
    rdfs:comment "Real-time streaming is the continuous delivery of data, audio, or video as an ongoing flow consumed incrementally with minimal latency rather than downloaded in full beforehand. It uses low-latency transport protocols and buffering strategies to balance smoothness against delay. It underpins live media, event streams, and interactive low-latency experiences."@en ;
    rdfs:subClassOf ngm:network-protocol ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:agent-event-stream,
        ngm:virtual-performance-space ;
    vc:slug "real-time-streaming" ;
    vc:sourceDomain "infrastructure" .

ngm:real-time-systems a owl:Class ;
    rdfs:label "Real Time Systems"@en ;
    rdfs:comment "Real-time systems are computing systems whose correctness depends not only on logical results but also on the time at which those results are produced. They must respond to events within defined timing constraints, classified as hard, firm or soft depending on the consequences of a missed deadline. Such systems are central to control, robotics, simulation and immersive applications where late results are useless or dangerous."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:real-time-operating-system ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:determinism ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:latency ],
        ngm:embedded-system ;
    vc:bridgesTo ngm:robotics,
        ngm:spatial-computing ;
    vc:dependsOn ngm:determinism,
        ngm:real-time-operating-system ;
    vc:enables ngm:autonomous-vehicle,
        ngm:real-time-rendering ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:control-system,
        ngm:embedded-system ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:edge-computing,
        ngm:latency,
        ngm:real-time-rendering ;
    vc:requires ngm:determinism,
        ngm:latency,
        ngm:real-time-operating-system ;
    vc:slug "real-time-systems" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:control-system,
        ngm:physics-simulation,
        ngm:robotics ;
    vc:uses ngm:sensor-fusion .

ngm:rehabilitation-robotics a owl:Class ;
    rdfs:label "Rehabilitation Robotics"@en ;
    rdfs:comment "Rehabilitation robotics is the field of robotic devices that assist therapy and recovery of motor function, including exoskeletons, end-effector trainers, and assistive manipulators. These systems deliver repeatable, intensity-controlled movement while measuring patient progress, and rely on compliant, force-controlled actuation to interact safely with the body. They aim to improve outcomes and scale access to physical therapy."@en ;
    rdfs:subClassOf ngm:robo-robot-type ;
    skos:broader ngm:robo-robot-type ;
