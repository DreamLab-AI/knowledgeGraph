ngm:price-oracle a owl:Class ;
    rdfs:label "Price Oracle"@en ;
    rdfs:comment "A price oracle is an on-chain or hybrid data feed that supplies decentralised protocols with reliable, manipulation-resistant market prices for tokens, synthetic assets, and other financial instruments. On-chain price oracles — such as time-weighted average price (TWAP) feeds derived from automated market maker pool reserves — are fully decentralised but lag real-time prices. Off-chain oracle networks aggregate prices from multiple centralised and decentralised exchanges before committing them on-chain, offering fresher data at the cost of additional trust assumptions on node operators. Price oracles are foundational to DeFi lending protocols, synthetic asset minting, perpetual futures settlement, and insurance claim adjudication."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptographic-signature ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-aggregation ],
        ngm:blockchain-oracle ;
    vc:bridgesTo ngm:financial-data-api,
        ngm:trusted-execution-environment ;
    vc:contrastsWith ngm:centralised-exchange-feed,
        ngm:spot-price ;
    vc:dependsOn ngm:automated-market-maker,
        ngm:cryptoeconomic-staking,
        ngm:decentralised-exchange,
        ngm:oracle-network ;
    vc:enables ngm:collateralised-lending,
        ngm:liquidation-mechanism,
        ngm:perpetual-futures,
        ngm:real-world-asset-tokenisation,
        ngm:synthetic-asset ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:aggregator-feed,
        ngm:twap-oracle ;
    vc:isPartOf ngm:decentralised-finance,
        ngm:defi-infrastructure ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:flash-loan,
        ngm:mev-manipulation,
        ngm:proof-of-reserve ;
    vc:requires ngm:cryptographic-signature,
        ngm:data-aggregation ;
    vc:slug "price-oracle" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:defi-protocol,
        ngm:liquidity-pool,
        ngm:smart-contract .

ngm:random-number-generation a owl:Class ;
    rdfs:label "Random Number Generation"@en ;
    rdfs:comment "The process of generating unpredictable and statistically random values for cryptographic operations, serving as a critical security primitive for key generation, nonces, and protocol initialization; distinguishes between true randomness from physical entropy sources (TRNG) and pseudo-randomness from deterministic algorithms seeded with entropy (CSPRNG)."@en ;
    rdfs:subClassOf ngm:cryptographic-primitive ;
    vc:bridgesTo ngm:blockchain,
        ngm:hardware-security-module,
        ngm:trusted-platform-module ;
