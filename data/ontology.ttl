ngm:fast-ai a owl:Class ;
    rdfs:label "fast.ai"@en ;
    rdfs:comment "fast.ai is a research lab, online course series, and open-source Python deep learning library founded by Jeremy Howard (former president and chief scientist of Kaggle, founder of FastMail and Optimal Decisions Group) and Rachel Thomas (UCSF / University of San Francisco data ics researcher), buil..."@en ;
