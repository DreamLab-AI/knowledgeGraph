    rdfs:label "One Useful Thing Newsletter"@en .
ngm:one-way-function a owl:Class ;
    rdfs:comment "A one-way function is a function that is easy to compute on any input but computationally infeasible to invert, meaning that recovering the input from a typical output is practically impossible with available resources. One-way functions are a foundational primitive of modern cryptography, underpinning hashing, password storage, and the trapdoor constructions used in public-key schemes. Their existence is conjectured rather than proven, and it is closely tied to open questions in computational complexity."@en ;
    rdfs:label "One Way Function"@en ;
    rdfs:subClassOf ngm:cryptography ;
    rdfs:subClassOf _:r15729 ;
    vc:bridgesTo ngm:cryptographic-algorithm ;
