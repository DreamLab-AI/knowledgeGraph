vf:consensus-mechanism a owl:Class ;
    rdfs:label "Consensus Mechanism"@en ;
    rdfs:comment "A [[Consensus Mechanism]] is a [[Distributed Algorithm]] enabling a population of independent, potentially adversarial nodes communicating over an unreliable network to agree on a single, totally-ordered sequence of state transitions (a replicated log) such that all honest participants eventually converge on the same value (agreement / safety), every honest proposal is eventually decided (termination / liveness), and the decided value was proposed by at least one participant (validity / integrity), formalised within the Fischer-Lynch-Paterson (FLP) impossibility result establishing that no deterministic asynchronous protocol can guarantee all three properties simultaneously with even one faulty process, navigated in practice by relaxing one assumption — partial synchrony (Dwork-Lynch-Stockmeyer 1988) used by [[PBFT]] (Castro-Liskov 1999), [[Tendermint]] (Buchman 2016), [[HotStuff]] (Yin et al. 2018), [[Narwhal]]-[[Bullshark]] (Spiegelman et al. 2022) and [[Mysticeti]] (Sui 2024); randomisation under asynchrony used by [[Algorand]] (Chen-Micali 2016) verifiable random function (VRF) committee lottery and [[Avalanche]] (Rocket et al. 2018) repeated subsampling; or eventual probabilis"@en ;
    rdfs:subClassOf <urn:visionflow:linked:atomic-broadcast>,
        <urn:visionflow:linked:coordination-protocol>,
        <urn:visionflow:linked:distributed-algorithm>,
        vf:byzantine-fault-tolerance,
        vf:state-machine-replication ;
    vc:authorityScore "0.87"^^xsd:float ;
    vc:enables <urn:visionflow:linked:blockchain-security>,
        <urn:visionflow:linked:double-spend-prevention>,
        <urn:visionflow:linked:permissionless-participation>,
        <urn:visionflow:linked:state-synchronisation>,
        <urn:visionflow:linked:sybil-resistance>,
        <urn:visionflow:linked:trustless-settlement>,
        vf:censorship-resistance ;
    vc:hasPart <urn:visionflow:linked:block-proposal>,
        <urn:visionflow:linked:cryptographic-signature>,
        <urn:visionflow:linked:finality-gadget>,
        <urn:visionflow:linked:leader-election>,
        <urn:visionflow:linked:quorum-certificate>,
        <urn:visionflow:linked:slashing-condition>,
        <urn:visionflow:linked:validator-set>,
        <urn:visionflow:linked:view-change>,
        <urn:visionflow:linked:voting-round>,
        vf:fork-choice-rule ;
    vc:implements <urn:visionflow:linked:avalanche>,
        <urn:visionflow:linked:hashgraph>,
        <urn:visionflow:linked:hot-stuff>,
        <urn:visionflow:linked:paxos>,
        <urn:visionflow:linked:raft>,
        <urn:visionflow:linked:tendermint>,
        vf:nakamoto-consensus,
        vf:practical-byzantine-fault-tolerance,
        vf:proof-of-authority,
        vf:proof-of-history,
        vf:proof-of-stake,
        vf:proof-of-work ;
    vc:maturity "production-ready" ;
    vc:qualityScore "0.52"^^xsd:float ;
