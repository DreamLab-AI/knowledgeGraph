ngm:model-weights a owl:Class ;
    rdfs:label "Model Weights"@en ;
    rdfs:comment "The learnable numerical parameters in a neural network that encode the connection strengths adjusted during training via backpropagation to minimise loss. Model weights constitute the primary artefact of training and are the target of fine-tuning, quantisation, pruning, and transfer learning; their distribution and magnitude critically determine model capability and safety."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:backpropagation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:training ],
        ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:enables ngm:fine-tuning,
        ngm:transfer-learning ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:neural-network ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:relatedTo ngm:ai-safety,
        ngm:network-architecture ;
    vc:requires ngm:backpropagation,
        ngm:training ;
    vc:slug "model-weights" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:monte-carlo-tree-search a owl:Class ;
    rdfs:label "Monte Carlo Tree Search"@en ;
    rdfs:comment "Monte Carlo Tree Search (MCTS) is a heuristic search algorithm for sequential decision-making that builds a game tree incrementally through random simulations, balancing exploration and exploitation via the Upper Confidence Bound (UCB) formula. It enables strong play in games with large branching factors and generalises to planning under uncertainty."@en ;
    rdfs:subClassOf ngm:search-algorithms ;
    vc:bridgesTo ngm:deep-neural-network,
        ngm:reinforcement-learning ;
    vc:contrastsWith ngm:alpha-beta-pruning,
        ngm:dynamic-programming,
        ngm:minimax-search ;
    vc:dependsOn ngm:random-number-generation,
        ngm:tree-data-structure ;
    vc:enables ngm:game-playing-ai,
        ngm:general-game-playing,
        ngm:planning-under-uncertainty ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:backpropagation-update,
        ngm:node-expansion,
        ngm:rollout-simulation,
        ngm:tree-selection-policy ;
    vc:implements ngm:anytime-algorithm,
        ngm:bandit-algorithm ;
    vc:isPartOf ngm:game-tree-search ;
    vc:qualityScore "0.65"^^xsd:float ;
    vc:relatedTo ngm:beam-search,
        ngm:uct-algorithm ;
    vc:requires ngm:stochastic-simulation,
        ngm:upper-confidence-bound ;
    vc:slug "monte-carlo-tree-search" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:alphago,
        ngm:alphazero ;
    vc:uses ngm:exploration-exploitation-tradeoff,
        ngm:ucb1-formula .

ngm:neural-network-training a owl:Class ;
    rdfs:label "Neural Network Training"@en ;
    rdfs:comment "Neural network training is the process of iteratively adjusting a model's weights to minimise a loss function over a dataset, typically using gradient descent with backpropagation. Each step computes the gradient of the loss with respect to parameters and updates them via an optimiser, repeating across many batches and epochs. Training quality depends on data, objective design, regularisation, and substantial parallel compute."@en ;
    rdfs:subClassOf ngm:machine-learning-discipline-technique ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:generative-ai,
        ngm:training-hardware ;
    vc:slug "neural-network-training" ;
    vc:sourceDomain "ai" .

ngm:paxos a owl:Class ;
    rdfs:label "Paxos"@en ;
    rdfs:comment "Paxos is a family of fault-tolerant distributed consensus algorithms first formally described by Leslie Lamport in 1989 and published in 1998, designed to allow a cluster of processes to agree on a single value or sequence of values despite the failure of a minority of participants. The algorithm proceeds through prepare and accept phases orchestrated by a proposer, with acceptors voting to commit proposed values and learners observing the final agreement. Multi-Paxos extends the basic protocol to achieve consensus on a log of commands efficiently, forming the algorithmic foundation of replicated state machines. Paxos and its derivatives, including Raft and HotStuff, underpin virtually every strongly consistent distributed database and coordination service in production use today."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:message-passing ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:quorum ],
        ngm:consensus-algorithm ;
    vc:bridgesTo ngm:blockchain-consensus ;
    vc:contrastsWith ngm:byzantine-fault-tolerance,
        ngm:hot-stuff-consensus,
        ngm:nakamoto-consensus,
        ngm:raft-consensus ;
    vc:dependsOn ngm:crash-fault-tolerance,
        ngm:network-partition ;
    vc:enables ngm:consensus-protocol,
        ngm:distributed-computing,
        ngm:distributed-ledger,
        ngm:fault-tolerant-system,
        ngm:replicated-state-machine ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:consensus-mechanism,
        ngm:leader-election,
        ngm:state-machine-replication,
        ngm:two-phase-commit ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:cap-theorem,
        ngm:chubby-lock-service,
        ngm:distributed-protocol,
        ngm:total-order-broadcast,
        ngm:zookeeper ;
    vc:requires ngm:majority-voting,
        ngm:message-passing,
        ngm:quorum ;
    vc:slug "paxos" ;
    vc:sourceDomain "distributed-systems" .

ngm:precision a owl:Class ;
    rdfs:label "Precision"@en ;
    rdfs:comment "A classification performance metric representing the proportion of positive predictions made by an artificial intelligence model that are actually correct, calculated as the ratio of true positives to all positive predictions (true positives plus false positives), measuring the model's ability to avoid false alarms and providing critical insight into prediction reliability, particularly important in applications where the cost or consequence of false positive errors is significant."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:confusion-matrix ],
        ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:bridgesTo ngm:evaluation-metric,
        ngm:f1-score,
        ngm:information-retrieval ;
    vc:contrastsWith ngm:accuracy,
        ngm:recall,
        ngm:specificity ;
    vc:dependsOn ngm:classification-threshold ;
    vc:enables ngm:false-positive-minimisation,
        ngm:threshold-optimisation ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:false-positive,
        ngm:true-positive ;
    vc:implements ngm:performance-measurement ;
    vc:isPartOf ngm:model-evaluation,
        ngm:model-performance ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:class-imbalance,
        ngm:classification-metric,
        ngm:model-card,
        ngm:model-performance ;
    vc:requires ngm:binary-classification,
        ngm:confusion-matrix ;
    vc:slug "precision" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:standardizedBy ngm:iso-iec-25059,
        ngm:nist-ai-rmf ;
    vc:supports ngm:fairness-assessment,
        ngm:model-selection,
        ngm:responsible-ai ;
    vc:uses ngm:precision-recall-curve .

ngm:privacy-preserving-computation a owl:Class ;
    rdfs:label "Privacy-Preserving Computation"@en ;
    rdfs:comment "Privacy-preserving computation is a family of techniques that allow data to be processed or analysed without exposing the underlying plaintext to the computing party. It includes homomorphic encryption, secure multiparty computation, trusted execution environments, federated learning, and differential privacy. These methods enable collaboration and analytics over sensitive data while maintaining confidentiality."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:key-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:homomorphic-encryption ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptography ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:differential-privacy ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:trusted-execution-environment ],
        ngm:cryptography ;
    vc:bridgesTo ngm:blockchain,
        ngm:edge-computing,
        ngm:federated-learning ;
    vc:contrastsWith ngm:centralised-data-processing,
        ngm:plaintext-computation ;
    vc:dependsOn ngm:public-key-infrastructure,
        ngm:zero-knowledge-proof ;
    vc:enables ngm:confidential-computing,
        ngm:data-collaboration,
        ngm:federated-learning ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:differential-privacy,
        ngm:homomorphic-encryption,
        ngm:secure-multiparty-computation,
        ngm:trusted-execution-environment ;
    vc:implements ngm:data-minimisation,
        ngm:privacy-by-design ;
    vc:qualityScore "0.73"^^xsd:float ;
    vc:relatedTo ngm:cryptography-security-and-privacy,
        ngm:edge-computing ;
    vc:requires ngm:cryptography,
        ngm:key-management ;
    vc:slug "privacy-preserving-computation" ;
    vc:sourceDomain "security" ;
    vc:supports ngm:data-sovereignty,
        ngm:gdpr-compliance .

ngm:proof-of-authority a owl:Class ;
    rdfs:label "Proof of Authority"@en ;
    rdfs:comment "A permissioned blockchain consensus mechanism in which a fixed set of pre-approved validators with verified real-world identities are authorised to produce and validate blocks. PoA sacrifices decentralisation for high throughput and fast finality, making it suitable for enterprise and consortium blockchains where participant trust can be established off-chain."@en ;
    rdfs:subClassOf ngm:bc-protocol-and-consensus,
        ngm:proof-based-consensus ;
    skos:broader ngm:bc-protocol-and-consensus ;
    vc:contrastsWith ngm:proof-of-stake,
        ngm:proof-of-work ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:consensus-algorithm,
        ngm:consensus-mechanism,
        ngm:consortium-blockchain,
        ngm:finality ;
    vc:slug "proof-of-authority" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:blockchain-governance .

ngm:real-time-monitoring a owl:Class ;
    rdfs:label "Real-Time Monitoring"@en ;
    rdfs:comment "Real-time monitoring is the continuous collection, processing, and presentation of operational telemetry — encompassing metrics, logs, and traces — with sufficiently low latency that resulting insights can drive immediate human decisions or automated responses without batch delay. It integrates instrumentation agents, stream-processing pipelines, and visualisation dashboards to maintain a live, actionable picture of system health across software, hardware, network, and physical domains. The discipline spans IT operations, industrial control, MLOps observability, and smart infrastructure, where the defining criterion is actionability: data must arrive within a window that permits meaningful intervention before a fault, breach, or degradation cascades. Real-time monitoring is architecturally distinct from batch analytics in its emphasis on bounded latency, stateful windowing, and continuous alerting over persistent connections."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-pipeline ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:network-infrastructure ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:observability ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:monitoring-dashboard ],
        ngm:real-time-processing ;
    vc:bridgesTo ngm:cyber-physical-systems,
        ngm:digital-twin,
        ngm:model-drift-detection ;
    vc:contrastsWith ngm:batch-processing,
        ngm:historical-analytics ;
    vc:dependsOn ngm:edge-computing,
        ngm:message-broker ;
    vc:enables ngm:ai-monitoring,
        ngm:compliance-monitoring,
        ngm:incident-response,
        ngm:operational-resilience,
        ngm:predictive-maintenance ;
