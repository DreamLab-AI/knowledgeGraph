ngm:state-machine-replication a owl:Class ;
    rdfs:label "State Machine Replication"@en ;
    rdfs:comment "State Machine Replication (SMR) is a fault-tolerance technique in which multiple server replicas each maintain an identical copy of a deterministic state machine, processing the same ordered sequence of client requests to achieve consistency. It underpins the correctness guarantees of distributed consensus protocols and forms the theoretical foundation of blockchain ledger replication."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:consensus-mechanism ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:fault-tolerance ],
        ngm:bc-protocol-and-consensus ;
    skos:broader ngm:bc-protocol-and-consensus ;
    vc:enables ngm:blockchain,
        ngm:distributed-systems ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:relatedTo ngm:state-machine ;
    vc:requires ngm:consensus-mechanism,
        ngm:fault-tolerance ;
    vc:slug "state-machine-replication" ;
    vc:sourceDomain "blockchain" .

ngm:supervised-fine-tuning a owl:Class ;
    rdfs:label "Supervised Fine Tuning"@en ;
    rdfs:comment "A fine-tuning approach that uses labelled training data to adapt a pre-trained model to specific tasks, optimising performance through supervised learning on input-output pairs. Supervised fine-tuning (SFT) represents the most direct path from general pre-training to task-specific capability."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:model-training ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:human-feedback ],
        ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:enables ngm:reinforcement-learning,
        ngm:reward-model ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:fine-tuning,
        ngm:transfer-learning ;
    vc:requires ngm:human-feedback,
        ngm:model-training ;
    vc:slug "supervised-fine-tuning" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:token-embedding a owl:Class ;
    rdfs:label "Token Embedding"@en ;
    rdfs:comment "A learnable lookup table that maps each discrete token in a vocabulary to a dense continuous vector, providing the initial semantic encoding fed into transformer model layers. Embeddings are trained end-to-end and combined with positional encodings; they may be tied with the output un-embedding matrix to reduce parameter count and improve training stability."@en ;
    rdfs:subClassOf ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:enables ngm:natural-language-processing ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:encoder-decoder-architecture,
        ngm:transformer ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:relatedTo ngm:neural-network-layer,
        ngm:self-attention ;
    vc:slug "token-embedding" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:deep-learning .

ngm:tool-schema a owl:Class ;
    rdfs:label "Tool Schema"@en ;
    rdfs:comment "A tool schema is a structured, machine-readable specification — typically expressed in JSON Schema format — that formally describes a function or external capability callable by an AI agent: its name, natural-language description, parameter names and types, constraints, and which parameters are required. Tool schemas are provided to large language models at inference time as part of the system or user context, enabling the model to reason about which tools are available and to emit syntactically correct structured function-call outputs that an orchestration layer can execute. They are the core interface contract between AI models and the external systems they interact with."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:json-schema ],
        ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:enables ngm:function-calling,
        ngm:tool-use ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:agentic-ai,
        ngm:model-context-protocol,
        ngm:schema-registry ;
    vc:requires ngm:json-schema ;
    vc:slug "tool-schema" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:verifiable-data-registry a owl:Class ;
    rdfs:label "Verifiable Data Registry"@en ;
    rdfs:comment "A system that mediates the creation, verification, and resolution of decentralized identifiers and verifiable credentials, typically implemented as a blockchain, distributed ledger, or decentralized network for storing public key and revocation information."@en ;
    rdfs:subClassOf ngm:data-registry,
