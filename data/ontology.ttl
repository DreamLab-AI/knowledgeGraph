ngm:token-weighted-voting a owl:Class ;
    rdfs:label "Token-Weighted Voting"@en ;
    rdfs:comment "Token-weighted voting is an on-chain governance mechanism in which each participant's voting power is directly proportional to the quantity of governance tokens they hold, lock, or stake. It is the dominant decision-making primitive in decentralised autonomous organisations and DeFi protocols, enabling transparent, programmable, and censorship-resistant governance of parameter changes, treasury allocations, and protocol upgrades. The mechanism exhibits plutocratic tendencies in which large token holders disproportionately control outcomes, motivating research into alternative weighting schemes such as quadratic voting, conviction voting, and vote-escrow models. Implementations range from fully on-chain execution via Governor Bravo and OpenZeppelin Governor to off-chain gasless signalling via platforms such as Snapshot."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:quorum-threshold ],
        ngm:bc-governance-and-regulation ;
    skos:broader ngm:bc-governance-and-regulation ;
    vc:bridgesTo ngm:mechanism-design,
        ngm:social-choice-theory,
        ngm:sybil-resistance ;
    vc:contrastsWith ngm:conviction-voting,
        ngm:one-person-one-vote,
        ngm:quadratic-voting,
        ngm:reputation-based-voting ;
    vc:dependsOn ngm:blockchain,
        ngm:token-economics ;
    vc:enables ngm:decentralised-decision-making,
        ngm:parameter-governance,
        ngm:protocol-upgrade,
        ngm:treasury-management ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:dao-governance,
        ngm:on-chain-governance ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:dao-governance,
        ngm:defi-protocol,
        ngm:governance-attack,
        ngm:plutocracy,
        ngm:snapshot-voting,
        ngm:voter-turnout ;
    vc:requires ngm:erc-20-token,
        ngm:proposal-mechanism,
        ngm:quorum-threshold ;
    vc:slug "token-weighted-voting" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:governance-token,
        ngm:liquid-democracy,
        ngm:on-chain-voting,
        ngm:smart-contract,
        ngm:vote-escrow .

ngm:transport-layer a owl:Class ;
    rdfs:label "Transport Layer"@en ;
    rdfs:comment "The Transport Layer is the stratum that provides end-to-end delivery of data between endpoints over a network. It sits above the Network Layer that routes packets and below the protocol and integration strata that rely on reliable channels. It contains segmentation, flow and congestion control, and connection management."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:congestion-control ],
        [ a owl:Restriction ;
