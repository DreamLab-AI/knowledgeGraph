ngm:cryptographic-proof a owl:Class ;
    rdfs:label "Cryptographic Proof"@en ;
    rdfs:comment "A cryptographic proof is a mathematical construction that enables one party to demonstrate the truth of a statement or possession of secret knowledge to a verifying party in a computationally sound and tamper-evident manner, without necessarily revealing the underlying information itself. Rooted in complexity theory and interactive proof systems, cryptographic proofs provide infeasibility guarantees: a computationally bounded adversary cannot forge a valid proof for a false statement. The field spans classical constructions such as hash-based commitments and digital signatures, through to advanced non-interactive arguments including zk-SNARKs and STARKs, and underpins security across blockchain, identity, and privacy-preserving computation domains."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:elliptic-curve-cryptography ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:zero-knowledge-proof ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:hash-function ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:commitment-scheme ],
        ngm:cryptography ;
    vc:bridgesTo ngm:ai-model-attestation,
        ngm:decentralised-identity,
        ngm:verifiable-credential ;
    vc:contrastsWith ngm:multi-party-computation,
        ngm:trusted-execution-environment ;
    vc:enables ngm:digital-identity,
        ngm:privacy-preserving-blockchain,
        ngm:proof-of-stake,
        ngm:proof-of-work,
        ngm:verifiable-computation,
        ngm:zk-rollup ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:commitment-scheme,
        ngm:interactive-proof-system,
        ngm:non-interactive-proof,
        ngm:zero-knowledge-proof ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:blockchain-protocol,
        ngm:consensus-mechanism,
        ngm:homomorphic-encryption,
        ngm:secure-multi-party-computation ;
    vc:requires ngm:elliptic-curve-cryptography,
        ngm:hash-function,
        ngm:public-key-cryptography ;
    vc:slug "cryptographic-proof" ;
    vc:sourceDomain "security" ;
    vc:supports ngm:authentication,
        ngm:data-integrity,
        ngm:non-repudiation,
        ngm:verification ;
    vc:uses ngm:digital-signature,
        ngm:elliptic-curve-cryptography,
        ngm:merkle-tree .

ngm:data-integrity a owl:Class ;
    rdfs:label "Data Integrity"@en ;
    rdfs:comment "Data integrity is the property guaranteeing that data remains accurate, complete, consistent, and unaltered throughout its entire lifecycle—spanning creation, storage, transmission, and processing—except through authorised operations. It is enforced through a layered combination of technical controls including cryptographic hash functions, digital signatures, Merkle trees, access control mechanisms, and ACID-compliant transactions, as well as procedural controls such as change-control workflows, audit trails, and immutable logging. Violations—whether from storage errors, transmission corruption, software bugs, or deliberate tampering—can propagate silently and have cascading consequences in any system relying on the data for decision-making or compliance."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:encryption ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:access-control ],
        ngm:data-quality ;
    vc:bridgesTo ngm:blockchain,
        ngm:smart-contract,
        ngm:supply-chain-provenance ;
    vc:contrastsWith ngm:data-corruption,
        ngm:eventual-consistency ;
    vc:dependsOn ngm:acid-transactions,
        ngm:erasure-coding,
        ngm:fault-tolerance ;
    vc:enables ngm:audit-trail,
        ngm:data-provenance,
        ngm:immutability,
        ngm:regulatory-compliance ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:data-governance,
        ngm:data-lineage,
        ngm:distributed-ledger,
        ngm:information-security,
        ngm:referential-integrity ;
    vc:requires ngm:access-control,
        ngm:encryption,
        ngm:write-ahead-logging ;
    vc:slug "data-integrity" ;
    vc:sourceDomain "data" ;
    vc:standardizedBy ngm:iso-27001,
        ngm:nist-cybersecurity-framework ;
    vc:uses ngm:access-control,
        ngm:checksum,
        ngm:digital-signature,
        ngm:hash-function,
        ngm:merkle-tree .

