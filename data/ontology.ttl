        ngm:stakeholder,
        ngm:transparency ;
    vc:slug "boardroom" ;
    vc:sourceDomain "governance" ;
    vc:uses ngm:governance-framework,
        ngm:risk-management .

ngm:bode-plot a owl:Class ;
    rdfs:label "Bode Plot"@en ;
    rdfs:comment "A Bode Plot is a pair of frequency-domain graphs used in control engineering and signal analysis to characterise the frequency response of a linear time-invariant system: one graph plots the magnitude of the system's transfer function in decibels against log-frequency, and the second plots the phase angle in degrees against log-frequency. Together they reveal gain margins, phase margins, bandwidth, and resonant behaviour, making Bode plots the primary graphical tool for assessing open-loop stability and designing compensators."@en ;
    rdfs:subClassOf ngm:control-system ;
    vc:enables ngm:pid-controller,
        ngm:stability-analysis ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:feedback-control,
        ngm:feedback-loop ;
    vc:slug "bode-plot" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:signal-processing,
        ngm:transfer-function .

ngm:bolt-12 a owl:Class ;
