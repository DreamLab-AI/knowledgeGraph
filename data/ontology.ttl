    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:configuration-management,
        ngm:network-security,
        ngm:vulnerability ;
    vc:requires ngm:configuration-management,
        ngm:monitoring ;
    vc:slug "asset-inventory" ;
    vc:sourceDomain "security" ;
    vc:supports ngm:cybersecurity,
        ngm:threat-model ;
    vc:uses ngm:monitoring .

ngm:asset-tracking a owl:Class ;
    rdfs:label "Asset Tracking"@en ;
    rdfs:comment "Asset tracking is the continuous identification and localisation of physical objects, such as inventory, equipment, and vehicles, across their lifecycle and movement. It combines identification technologies like RFID and BLE beacons with positioning systems and connectivity to give organisations real-time visibility of where assets are and in what condition. Asset tracking underpins supply-chain transparency, loss prevention, and operational efficiency."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:rfid ],
