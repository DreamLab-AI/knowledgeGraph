ngm:fairness a owl:Class ;
    rdfs:label "Fairness"@en ;
    rdfs:comment "The property of an AI system whereby it produces equitable outcomes and avoids creating or reinforcing unjustifiable disparities across different demographic groups or individuals, measured through various mathematical definitions and ical principles."@en ;
