    rdfs:label "Cross Border Transactions"@en .
ngm:cross-border-transfer a owl:Class ;
    rdfs:comment "A cross-border transfer is the movement of value or funds between parties located in different countries, settled across distinct currency and regulatory regimes. It encompasses bank wires, card networks, money-transfer operators, and increasingly digital-payment and cryptocurrency rails. Speed, cost, foreign-exchange handling, and compliance with multiple jurisdictions are its defining constraints."@en ;
    rdfs:label "Cross-Border Transfer"@en ;
    rdfs:subClassOf ngm:financial-services ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:cryptocurrency ;
    vc:relatedTo ngm:digital-payments ;
    vc:slug "cross-border-transfer" ;
    vc:sourceDomain "blockchain" .
ngm:cross-border-treasury-operations a skos:Concept ;
    rdfs:label "Cross Border Treasury Operations"@en .
ngm:cross-chain-asset-transfer a owl:Class ;
    rdfs:comment "Cross-chain asset transfer is the cryptographic and protocol-level process of moving digital assets — cryptocurrencies, fungible tokens, or non-fungible tokens — from one blockchain network to a distinct, independent blockchain network while preserving the asset's economic properties and enforcing integrity guarantees across the transfer. Because independent blockchains maintain no shared global state, protocols must ensure that an asset locked or burned on the source chain is atomically minted or released on the destination chain, preventing double-spend and maintaining supply conservation. Implementations range from hash time-locked contracts (HTLCs) and lock-and-mint bridge contracts overseen by validator committees to native inter-blockchain communication protocols (IBC) and zero-knowledge proof-based verification bridges that eliminate trusted attestors entirely."@en ;
    rdfs:label "Cross Chain Asset Transfer"@en ;
    rdfs:subClassOf ngm:cross-chain-interoperability ;
    rdfs:subClassOf _:r6029 ;
    rdfs:subClassOf _:r6030 ;
