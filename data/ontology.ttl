        ngm:hash-function .

ngm:attack-vector a owl:Class ;
    rdfs:label "Attack Vector"@en ;
    rdfs:comment "A specific path, method, or mechanism that a threat actor uses to gain unauthorised access, exploit vulnerabilities, or cause damage to a system, network, or organisation. Attack vectors span network-based exploitation, social engineering, supply-chain compromise, and AI-specific techniques such as prompt injection or model poisoning, and are categorised by access method, target layer, and sophistication."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:vulnerability ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:threat-actor ],
        ngm:ai-governance-and-ethics ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:contrastsWith ngm:resilience,
        ngm:security ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:adversarial-robustness,
        ngm:risk ;
    vc:requires ngm:threat-actor,
        ngm:vulnerability ;
    vc:slug "attack-vector" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:authentication-mechanism a owl:Class ;
    rdfs:label "Authentication Mechanism"@en ;
    rdfs:comment "An authentication mechanism is a technical procedure or protocol that verifies the claimed identity of a user, device, or system before granting access to protected resources. Such mechanisms range from simple password checks to sophisticated cryptographic challenges and biometric verification. They form the foundational layer of access control systems, ensuring that only authorised principals can interact with sensitive data or services. The strength and appropriateness of a chosen mechanism directly influences the overall security posture of a system."@en ;
    rdfs:subClassOf ngm:authentication ;
    vc:enables ngm:authorisation,
        ngm:multi-factor-authentication ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:access-control,
        ngm:cryptographic-protocol,
        ngm:digital-identity ;
    vc:slug "authentication-mechanism" ;
    vc:sourceDomain "security" ;
    vc:supports ngm:cybersecurity ;
    vc:uses ngm:authentication-standards,
        ngm:cryptographic-keys .

ngm:benchmark-standard a owl:Class ;
    rdfs:label "Benchmark Standard"@en ;
    rdfs:comment "A vendor-agnostic reference specification for evaluating and comparing system performance, establishing standardized metrics and modologies that enable fair, repeatable, and meaningful comparisons across computing systems, processes, or technologies."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:validation-process ],
        ngm:ai-technique,
        ngm:technical-standard ;
    skos:broader ngm:ai-technique ;
    vc:enables ngm:performance-comparison,
        ngm:quality-assurance,
        ngm:system-evaluation ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires ngm:measurement-methodology,
        ngm:reference-implementation,
        ngm:validation-process ;
    vc:slug "benchmark-standard" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:bitcoin-standard a owl:Class ;
    rdfs:label "Bitcoin Standard"@en ;
    rdfs:comment "The Bitcoin Standard is an economic and monetary thesis proposing that Bitcoin's fixed supply cap of 21 million units, its decentralised consensus via Proof of Work, and its censorship-resistant issuance schedule make it a superior store of value and a viable basis for a new international monetary order, analogous to the historical gold standard. Proponents argue that Bitcoin's predictable, algorithmically enforced monetary policy immunises it against political inflation, contrasting with fiat currencies subject to central bank intervention. The thesis draws on Austrian economics, particularly the concept of sound money."@en ;
    rdfs:subClassOf ngm:bc-token-and-asset ;
    skos:broader ngm:bc-token-and-asset ;
    vc:contrastsWith ngm:inflation ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:bitcoin-as-money,
        ngm:bitcoin-value-proposition,
        ngm:monetary-system ;
    vc:slug "bitcoin-standard" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:cryptocurrency,
        ngm:proof-of-work .

ngm:block-propagation a owl:Class ;
    rdfs:label "Block Propagation"@en ;
    rdfs:comment "Block Propagation is the process by which a newly mined or validated block is broadcast across a blockchain peer-to-peer network so that all full nodes can update their local copy of the chain. Propagation latency directly influences the orphan/stale block rate, security against selfish mining, and the degree of centralisation pressure towards large, well-connected mining pools. Techniques such as Compact Block Relay (Bitcoin BIP 152) and Graphene reduce bandwidth requirements by sending block sketches rather than full transaction lists, exploiting the fact that recipient nodes already hold most transactions in their mempools."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:block-propagation-time ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:full-node ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:blockchain-network ],
        ngm:bc-protocol-and-consensus,
        ngm:blockchain-entity,
        ngm:consensus-protocol ;
    skos:broader ngm:bc-protocol-and-consensus ;
    vc:contrastsWith ngm:light-node ;
    vc:dependsOn ngm:blockchain-protocol ;
    vc:enables ngm:blockchain-scalability,
        ngm:consensus-mechanism ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:block-propagation-time ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:block-size,
        ngm:block-time,
        ngm:mempool,
        ngm:miner ;
    vc:requires ngm:blockchain-network,
        ngm:full-node ;
    vc:slug "block-propagation" ;
    vc:sourceDomain "blockchain" .

ngm:block-time a owl:Class ;
    rdfs:label "Block Time"@en ;
    rdfs:comment "Block Time is the average elapsed time between the creation of consecutive blocks on a blockchain, governed by the network's consensus mechanism and difficulty adjustment algorithm. Shorter block times increase transaction throughput and reduce confirmation latency but raise the risk of forks due to block propagation delays, creating a fundamental tradeoff between speed and chain security."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:consensus-mechanism ],
