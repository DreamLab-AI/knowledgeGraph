ngm:extended-kalman-filter a owl:Class ;
    rdfs:label "Extended Kalman Filter"@en ;
    rdfs:comment "The Extended Kalman Filter is a recursive state estimator that applies the Kalman filter to non-linear systems by linearising the process and measurement models about the current estimate using first-order Taylor expansion via Jacobian matrices."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:bayesian-inference ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:jacobian-matrix ],
