    vc:implements ngm:eip-4844 ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:ethereum ;
    vc:relatedTo ngm:layer-2-scaling ;
    vc:relatedTo ngm:optimistic-rollup ;
    vc:relatedTo ngm:rollup ;
    vc:relatedTo ngm:zk-rollup ;
    vc:slug "proto-danksharding" ;
