    vc:isPartOf ngm:layer-2-scaling ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:polygon,
        ngm:scalability ;
    vc:slug "polygon-zkevm" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:decentralised-finance,
        ngm:smart-contract ;
    vc:uses ngm:cryptography,
