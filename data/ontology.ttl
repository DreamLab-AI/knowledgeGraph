    skos:broader ngm:sc-interaction ;
    vc:enables ngm:accessibility,
        ngm:natural-interaction,
        ngm:voice-assistant ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:natural-language-understanding,
        ngm:speech-recognition,
        ngm:text-to-speech ;
    vc:isPartOf ngm:multimodal-ai-architecture ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:audio-processing,
        ngm:language-model,
        ngm:microphone,
        ngm:speech-synthesis ;
    vc:slug "voice-interaction" ;
    vc:sourceDomain "spatial-computing" .

ngm:w3-c-did-specification a owl:Class ;
    rdfs:label "W3C DID Specification"@en ;
    rdfs:comment "The W3C Decentralized Identifiers (DIDs) specification is a World Wide Web Consortium recommendation that defines a new type of globally unique, persistent, cryptographically verifiable identifier that does not require a centralised registration authority. A DID resolves to a DID Document containing cryptographic material, service endpoints, and verification methods, enabling the subject to authenticate and authorise interactions without reliance on any single identity provider. The specification defines a generic DID syntax and data model that is method-agnostic, with specific DID methods implementing the create/read/update/deactivate operations on different verifiable data registries including blockchains, distributed ledgers, and peer-to-peer networks. It became a W3C Recommendation in July 2022."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:verification-method ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:service-endpoint ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:did-document ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:verifiable-data-registry ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:did-method ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:did-resolver ],
        ngm:w3-c-did ;
    vc:bridgesTo ngm:blockchain,
        ngm:e-idas-2-0,
        ngm:open-id-connect ;
    vc:contrastsWith ngm:oauth-2-0,
        ngm:x-509-certificate ;
    vc:enables ngm:decentralized-identity-did,
        ngm:didcomm,
        ngm:eudi-wallet,
        ngm:verifiable-credentials,
        ngm:zero-trust-architecture ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:did-document,
        ngm:service-endpoint,
        ngm:verification-method ;
    vc:implements ngm:decentralised-identifier ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:decentralized-identifiers,
        ngm:did-document,
        ngm:digital-identity-standards,
        ngm:self-sovereign-identity,
        ngm:w3-c ;
    vc:requires ngm:did-method,
        ngm:did-resolver,
        ngm:verifiable-data-registry ;
    vc:slug "w3-c-did-specification" ;
    vc:sourceDomain "security" ;
    vc:standardizedBy ngm:w3-c ;
    vc:uses ngm:json-data-interchange-format-ld,
        ngm:public-key-cryptography,
        ngm:uri-scheme .

ngm:wcag-2-2 a owl:Class ;
    rdfs:label "WCAG 2.2"@en ;
    rdfs:comment "WCAG 2.2 is the October 2023 release of the Web Content Accessibility Guidelines published by the W3C Web Accessibility Initiative, introducing nine new success criteria that extend the 2.1 standard with stronger provisions for keyboard navigation, focus appearance, and accessible authentication. It remains structured around four principles — Perceivable, Operable, Understandable, and Robust — with conformance levels A, AA, and AAA. The release removes the Parsing criterion (4.1.1) while tightening requirements for pointer gestures, dragging movements, and redundant input."@en ;
    rdfs:subClassOf ngm:accessibility-standard ;
    vc:enables ngm:accessibility,
        ngm:standards-conformance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:accessibility-audit-tool,
        ngm:accessibility-standards,
        ngm:user-interface-standard ;
    vc:slug "wcag-2-2" ;
    vc:sourceDomain "infrastructure" ;
    vc:standardizedBy ngm:standards-body .

ngm:web-socket-protocol a owl:Class ;
    rdfs:label "WebSocket Protocol"@en ;
    rdfs:comment "The WebSocket Protocol is a standardised full-duplex communication protocol defined in RFC 6455 (2011) that provides a persistent, low-latency bidirectional channel between a client and a server over a single TCP connection. It was designed to overcome the limitations of HTTP polling and long-polling by upgrading an initial HTTP handshake to a persistent framed message channel, enabling servers to push data to clients without client-initiated requests. WebSocket frames carry minimal overhead — a 2-byte header for small messages — making the protocol suitable for high-frequency data streams such as financial tickers, collaborative editing, gaming, and real-time AI agent communications. It is supported natively in all major browsers and server-side runtimes, and forms the transport layer for many higher-level protocols including STOMP, MQTT-over-WebSocket, and the OpenAI Realtime API."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:hypertext-transfer-protocol ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:transport-layer-security ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:transmission-control-protocol ],
        ngm:network-protocol ;
    vc:bridgesTo ngm:large-language-model,
        ngm:multi-agent-system ;
    vc:contrastsWith ngm:g-rpc,
        ngm:http,
        ngm:server-sent-events,
        ngm:web-rtc ;
    vc:enables ngm:agent-event-stream,
        ngm:real-time-streaming,
        ngm:realtime-collaboration,
        ngm:server-push ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:full-duplex-communication,
        ngm:rfc-6455 ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:http,
        ngm:mqtt,
        ngm:realtime-communication,
        ngm:web-socket ;
    vc:requires ngm:hypertext-transfer-protocol,
        ngm:transmission-control-protocol,
        ngm:transport-layer-security ;
    vc:slug "web-socket-protocol" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:asynchronous-communication,
        ngm:event-driven-architecture,
        ngm:publish-subscribe-pattern ;
    vc:uses ngm:networking-infrastructure .

ngm:zero-shot-learning a owl:Class ;
    rdfs:label "Zero Shot Learning"@en ;
    rdfs:comment "Zero-shot learning is a machine-learning setting in which a model performs a task on classes or instances it has never seen during training, generalising from auxiliary information such as semantic attributes, natural-language descriptions or a shared embedding space. Modern instances exploit large pre-trained language and vision-language models that align inputs and labels in a common representation, enabling prediction by similarity rather than by fitting task-specific examples. It contrasts with few-shot and supervised learning by requiring no labelled examples of the target classes."@en ;
    rdfs:subClassOf ngm:transfer-learning ;
    vc:bridgesTo ngm:machine-learning ;
    vc:contrastsWith ngm:few-shot-learning,
        ngm:supervised-learning ;
    vc:dependsOn ngm:transfer-learning ;
    vc:enables ngm:classification,
        ngm:image-classification,
        ngm:natural-language-processing ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:knowledge-transfer,
        ngm:meta-learning,
        ngm:representation-learning ;
    vc:slug "zero-shot-learning" ;
    vc:sourceDomain "machine-learning" ;
    vc:supports ngm:domain-adaptation ;
    vc:uses ngm:clip,
        ngm:embedding,
        ngm:large-language-model,
        ngm:representation-learning .

ngm:zk-snarks a owl:Class ;
    rdfs:label "ZK-SNARKs"@en ;
    rdfs:comment "Zero-Knowledge Succinct Non-Interactive Arguments of Knowledge - a cryptographic proof system enabling one party to prove possession of information without revealing the information itself, characterized by small proof sizes, fast verification, and no interaction required between prover and verif..."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptography ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:elliptic-curve-cryptography ],
        ngm:sc-governance-and-safety ;
    skos:broader ngm:sc-governance-and-safety ;
    vc:bridgesTo ngm:zero-knowledge-proof ;
    vc:enables ngm:confidential-computing,
        ngm:privacy ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:relatedTo ngm:blockchain,
        ngm:homomorphic-encryption,
        ngm:identity ;
    vc:requires ngm:cryptography,
        ngm:elliptic-curve-cryptography ;
    vc:slug "zk-snarks" ;
    vc:sourceDomain "spatial-computing" .

ngm:3-d-asset-standard a owl:Class ;
    rdfs:label "3D Asset Standard"@en ;
    rdfs:comment "A 3D Asset Standard is a formal specification defining the file formats, metadata schemas, coordinate systems, material models, animation encodings, and interoperability protocols required for consistent creation, exchange, and real-time rendering of three-dimensional digital content across diverse software platforms and runtime environments. Such standards normalise vertex data structures, physically based rendering (PBR) material pipelines, level-of-detail hierarchies, skeletal animation rigs, and compression algorithms so that assets created in one authoring tool function correctly in another without manual conversion or data loss. Prominent examples include the Khronos Group glTF 2.0 specification for web and mobile 3D delivery, Pixar's Universal Scene Description (USD/USDZ) for complex scene composition, and the Metaverse Standards Forum interoperability profiles. These specifications underpin spatial computing, extended reality, game engines, digital-twin platforms, and emerging metaverse ecosystems by ensuring deterministic visual fidelity and semantic asset identity across the entire content pipeline."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:level-of-detail ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:universal-scene-description ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:coordinate-system ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:gltf-standard ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:physically-based-rendering ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:texture-atlas ],
        ngm:interoperability-standard ;
    vc:bridgesTo ngm:non-fungible-token,
        ngm:semantic-web-linked-data-standard ;
    vc:contrastsWith ngm:fbx ;
    vc:enables ngm:asset-interoperability,
        ngm:digital-twin,
        ngm:extended-reality,
        ngm:real-time-rendering ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:gltf-standard,
        ngm:level-of-detail,
        ngm:physically-based-rendering,
        ngm:universal-scene-description ;
    vc:implements ngm:iso-iec-14496-16,
        ngm:open-standard ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:digital-content-creation,
        ngm:iso-iec-14496-16,
        ngm:spatial-web ;
    vc:requires ngm:coordinate-system,
        ngm:mesh-compression,
        ngm:texture-atlas ;
    vc:slug "3-d-asset-standard" ;
    vc:sourceDomain "spatial-computing" ;
    vc:standardizedBy ngm:academy-software-foundation,
        ngm:khronos-group,
        ngm:metaverse-standards-forum ;
    vc:supports ngm:augmented-reality,
        ngm:game-engine,
        ngm:metaverse-platform ;
    vc:uses ngm:material-x,
        ngm:scene-graph,
        ngm:skeletal-animation .

ngm:3-d-scene-reconstruction a owl:Class ;
    rdfs:label "3D Scene Reconstruction"@en ;
    rdfs:comment "3D Scene Reconstruction is the computational process of recovering a complete, coherent three-dimensional model of an environment or scene from sensor observations such as images, depth maps, or LiDAR returns, integrating multiple viewpoints and modalities into a unified representation. Methods include volumetric fusion, truncated signed distance function (TSDF) integration, neural implicit representations, and Gaussian splatting, each offering different trade-offs between completeness, accuracy, and real-time capability. The output is used in robotics, autonomous driving, spatial computing, and cultural heritage documentation."@en ;
    rdfs:subClassOf ngm:3-d-reconstruction ;
    vc:enables ngm:3-d-perception,
        ngm:ar-registration,
        ngm:digital-twin-creation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:3-d-scanning,
        ngm:gaussian-splatting,
        ngm:ne-rf ;
    vc:slug "3-d-scene-reconstruction" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:multi-view-stereo,
        ngm:simultaneous-localisation-and-mapping,
        ngm:structure-from-motion .

ngm:adapter-modules a owl:Class ;
    rdfs:label "Adapter Modules"@en ;
    rdfs:comment "Adapter Modules are compact bottleneck neural network sub-networks inserted between frozen transformer layers, trained exclusively on task-specific data whilst leaving the base model unchanged. They typically comprise a down-projection, a non-linearity, and an up-projection with a residual connection, constituting under 1% of model parameters and enabling efficient multi-task deployment from a single frozen base model."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:transformer-architecture ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:fine-tuning ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:residual-connection ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:pre-trained-model ],
        ngm:parameter-efficient-fine-tuning ;
    vc:bridgesTo ngm:computer-vision,
        ngm:multimodal-ai-architecture-learning ;
    vc:contrastsWith ngm:full-fine-tuning,
        ngm:lora,
        ngm:prefix-tuning,
        ngm:prompt-tuning ;
    vc:dependsOn ngm:attention-mechanism,
        ngm:large-language-model ;
    vc:enables ngm:continual-learning,
        ngm:domain-adaptation,
        ngm:multi-task-learning ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:residual-connection ;
    vc:implements ngm:neural-network,
        ngm:transfer-learning ;
    vc:isPartOf ngm:parameter-efficient-fine-tuning ;
    vc:qualityScore "0.65"^^xsd:float ;
    vc:relatedTo ngm:natural-language-processing ;
    vc:requires ngm:fine-tuning,
        ngm:pre-trained-model,
        ngm:transformer-architecture ;
    vc:slug "adapter-modules" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:model-compression ;
    vc:uses ngm:neural-network-layer,
        ngm:transfer-learning .

ngm:ai-agents a owl:Class ;
    rdfs:label "AI Agents"@en ;
    rdfs:comment "AI Agents are software entities that combine a reasoning core (typically a large language model) with tool-use capabilities, memory, and a perception-action loop to autonomously pursue user-specified goals across multiple steps. They differ from single-shot inference systems by operating in iterative observe-think-act cycles, invoking external APIs, executing code, browsing the web, or delegating sub-tasks to specialised agents. The architecture integrates classical notions of rational agency with modern deep learning, spanning planning, grounding, and self-correction mechanisms. Safety, controllability, and alignment are first-class concerns because agents can initiate irreversible real-world side-effects."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:perception ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:reasoning ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:tool-use ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:large-language-models ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:planning-and-scheduling ],
        ngm:ai-application ;
    skos:broader ngm:ai-application ;
    vc:bridgesTo ngm:robotic-system,
        ngm:smart-contracts ;
    vc:contrastsWith ngm:chatbots,
        ngm:robotic-process-automation ;
    vc:dependsOn ngm:cognitive-architecture,
        ngm:function-calling,
        ngm:vector-databases ;
    vc:enables ngm:autonomous-decision-making,
        ngm:multi-agent-systems,
        ngm:workflow-automation ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:perception,
        ngm:planning-and-scheduling ;
    vc:implements ngm:plan-and-execute ;
    vc:qualityScore "0.91"^^xsd:float ;
    vc:relatedTo ngm:ai-safety,
        ngm:human-in-the-loop,
        ngm:prompt-injection,
        ngm:reinforcement-learning ;
    vc:requires ngm:large-language-models,
        ngm:memory,
        ngm:reasoning,
