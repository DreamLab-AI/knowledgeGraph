    vc:relatedTo ngm:corner-detection,
        ngm:edge-detection,
        ngm:feature-extraction,
        ngm:machine-learning-discipline,
        ngm:neural-network,
        ngm:point-cloud ;
    vc:requires ngm:sensor-data ;
    vc:slug "feature-detection" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:computer-vision-system,
        ngm:simultaneous-localisation-and-mapping,
        ngm:web-xr ;
    vc:uses ngm:convolutional-neural-network,
        ngm:image-processing,
        ngm:runtime-environment .

ngm:feature-selection a owl:Class ;
    rdfs:label "Feature Selection"@en ;
    rdfs:comment "Feature selection is the process of identifying and retaining the subset of input variables most relevant to a predictive task while discarding redundant or uninformative ones. By reducing dimensionality it can improve model generalisation, lower computational cost, and enhance interpretability without altering the underlying feature values. Methods range from filter approaches based on statistical relevance, through wrapper approaches that evaluate subsets via model performance, to embedded approaches integrated into model training."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-quality ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:data-preprocessing ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:training-data ],
        ngm:feature-engineering ;
