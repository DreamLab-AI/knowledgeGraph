    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:governance-framework ;
    vc:requires ngm:consent-management,
        ngm:privacy ;
    vc:slug "virtual-interaction-logging" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:encryption .

ngm:virtual-lighting-model a owl:Class ;
