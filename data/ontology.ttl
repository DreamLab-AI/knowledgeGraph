ngm:directx a owl:Class ;
    rdfs:label "DirectX"@en ;
    rdfs:comment "DirectX is a collection of application programming interfaces developed by Microsoft for handling multimedia tasks, especially graphics and gaming, on Windows and Xbox platforms. Its Direct3D component provides low-level access to graphics hardware for real-time rendering, while related APIs cover input, audio and compute. By abstracting diverse hardware behind a common interface, it lets developers target a wide range of GPUs through a single programming model."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:graphics-processing-unit ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:rendering-pipeline ],
        ngm:graphics-api ;
    vc:contrastsWith ngm:vulkan ;
    vc:enables ngm:game-development,
        ngm:real-time-rendering ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:rendering-pipeline ;
    vc:implements ngm:graphics-api ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:gaming,
        ngm:microsoft,
        ngm:visual-effects ;
    vc:requires ngm:graphics-processing-unit ;
    vc:slug "directx" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:graphics-pipeline,
        ngm:rendering-engine ;
    vc:uses ngm:gpu-computing,
        ngm:hlsl .

ngm:discriminator-network a owl:Class ;
    rdfs:label "Discriminator Network"@en ;
    rdfs:comment "A discriminator network is the adversarial component of a generative adversarial network that learns to distinguish real data samples from those synthesised by the generator. Trained as a binary classifier, it outputs a probability that a given input is genuine, and its gradients provide the learning signal that pushes the generator toward producing more realistic outputs. The discriminator and generator are locked in a minimax game whose equilibrium yields a generator whose samples are indistinguishable from real data."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:loss-function ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:convolutional-neural-network ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:adversarial-training ],
        ngm:generative-adversarial-networks ;
    vc:bridgesTo ngm:generator-network ;
    vc:contrastsWith ngm:generator-network ;
    vc:dependsOn ngm:loss-function ;
    vc:enables ngm:image-generation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:convolutional-neural-network ;
    vc:isPartOf ngm:generative-adversarial-networks ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:deep-learning,
        ngm:gan ;
    vc:requires ngm:adversarial-training,
        ngm:loss-function ;
    vc:slug "discriminator-network" ;
    vc:sourceDomain "machine-learning" ;
    vc:supports ngm:adversarial-training ;
    vc:uses ngm:backpropagation,
        ngm:neural-network .

ngm:domain-driven-design a owl:Class ;
    rdfs:label "Domain-Driven Design"@en ;
    rdfs:comment "Domain-driven design (DDD) is an approach to software development that centres the design on a deep, shared model of the business domain, expressed in a ubiquitous language common to engineers and domain experts. It provides strategic patterns for partitioning large systems into bounded contexts and tactical patterns such as aggregates, entities and value objects for structuring the model within each context. DDD aims to keep complex software aligned with the evolving realities of the business it serves."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:entity ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:domain-model ],
        ngm:software-architecture ;
    vc:bridgesTo ngm:microservices-architecture ;
    vc:contrastsWith ngm:domain-model ;
    vc:enables ngm:cqrs,
        ngm:event-sourcing ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:entity ;
    vc:implements ngm:domain-model ;
    vc:isPartOf ngm:software-architecture ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:cqrs,
        ngm:event-sourcing,
        ngm:software-architecture ;
    vc:requires ngm:domain-model ;
    vc:slug "domain-driven-design" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:microservices,
        ngm:microservices-architecture ;
    vc:uses ngm:entity .

ngm:domain-model a owl:Class ;
    rdfs:label "Domain Model"@en ;
    rdfs:comment "A Domain Model is a conceptual representation of the entities, attributes, relationships, and rules of a particular problem domain, independent of any specific software implementation. It captures the shared vocabulary and structural constraints that stakeholders agree describe the domain, serving as a blueprint for data schemas, APIs, and system behaviour. Standardised domain models enable interoperability by giving distinct systems a common semantic reference."@en ;
    rdfs:subClassOf ngm:software-architecture ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:data-layer,
        ngm:etsi-metaverse-domain-model ;
    vc:slug "domain-model" ;
    vc:sourceDomain "data" .

ngm:dynamical-systems a owl:Class ;
    rdfs:label "Dynamical Systems"@en ;
    rdfs:comment "Dynamical systems is the mathematical study of how the state of a system evolves over time according to fixed rules. It applies to physics, biology, engineering, and control."@en ;
    rdfs:subClassOf ngm:ai-research-area ;
    skos:broader ngm:ai-research-area ;
    vc:enables ngm:control-theory ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:slug "dynamical-systems" ;
    vc:sourceDomain "machine-learning" .

ngm:economic-finality a owl:Class ;
    rdfs:label "Economic Finality"@en ;
    rdfs:comment "Economic finality is a guarantee in proof-of-stake blockchains that reverting a finalised block would require an attacker to forfeit an economically prohibitive amount of staked capital through slashing. Rather than relying on probabilistic confirmation depth, it makes reversal irrational by binding the cost of an attack to a large, destroyable bond. A block is economically final once enough validators have attested to it that any conflicting chain would entail penalising at least a quantified fraction of the total stake. It is the cryptoeconomic foundation of settlement assurance in modern staking-based consensus."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:staking ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:validator ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:staking ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:slashing ],
        ngm:finality ;
    vc:dependsOn ngm:proof-of-stake,
        ngm:slashing ;
    vc:enables ngm:economic-security,
        ngm:settlement-finality ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:slashing,
        ngm:staking ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:consensus,
        ngm:cryptoeconomics,
        ngm:validator ;
    vc:requires ngm:staking,
        ngm:validator ;
    vc:slug "economic-finality" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:blockchain ;
    vc:uses ngm:cryptographic-proof .

