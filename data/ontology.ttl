            owl:someValuesFrom ngm:data-governance ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:synthetic-data ],
        ngm:ai-infrastructure,
        ngm:data-management ;
    vc:enables ngm:federated-learning,
        ngm:machine-learning-pipeline,
        ngm:model-training ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:data-versioning,
        ngm:synthetic-data,
        ngm:training-data ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:requires ngm:data-governance,
