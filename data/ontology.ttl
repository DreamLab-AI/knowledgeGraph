        ngm:soft-contact-tasks ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:isPartOf ngm:compliant-motion-control,
        ngm:force-regulation ;
    vc:qualityScore "0.66"^^xsd:float ;
    vc:requires ngm:damping-control,
        ngm:stiffness-modulation,
        ngm:virtual-dynamics-model ;
    vc:slug "impedance-control" ;
    vc:sourceDomain "robotics" .

ngm:instruction-tuning a owl:Class ;
    rdfs:label "Instruction Tuning"@en ;
    rdfs:comment "A fine-tuning technique that trains language models to follow natural language instructions by training on diverse instruction-response pairs. Instruction tuning enables models to generalise to new tasks described through instructions without task-specific training data."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:fine-tuning ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:supervised-learning ],
        ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:enables ngm:generative-ai ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:relatedTo ngm:prompt-engineering,
        ngm:rlhf,
        ngm:transfer-learning ;
    vc:requires ngm:fine-tuning,
        ngm:supervised-learning ;
    vc:slug "instruction-tuning" ;
    vc:sourceDomain "spatial-computing" .

ngm:machine-learning-framework a owl:Class ;
    rdfs:label "Machine Learning Framework"@en ;
    rdfs:comment "Software libraries and development environments such as TensorFlow and PyTorch that provide tools, APIs, and abstractions for building, training, and deploying machine learning models used in metaverse AI applications."@en ;
    rdfs:subClassOf ngm:ai-development-tools,
        ngm:ai-infrastructure ;
    vc:enables ngm:ai-model-development ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:slug "machine-learning-framework" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:mechanism-design a owl:Class ;
    rdfs:label "Mechanism Design"@en ;
    rdfs:comment "Mechanism design, sometimes called reverse game theory, is a branch of economics and game theory concerned with constructing the rules and incentive structures of strategic interactions so that self-interested participants produce collectively desirable outcomes. Rather than analysing a given game, mechanism design starts from a desired social choice function and works backwards to identify what game structure (mechanisms) would implement it as an equilibrium strategy for rational agents. In blockchain and decentralised finance contexts, mechanism design governs tokenomics, automated market maker formulas, auction protocols, validator incentive structures, and governance voting systems."@en ;
    rdfs:subClassOf ngm:bc-defi-and-economics ;
    skos:broader ngm:bc-defi-and-economics ;
    vc:enables ngm:incentive-alignment,
        ngm:tokenomics ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:on-chain-governance,
        ngm:token-economics,
        ngm:voting-mechanism ;
    vc:slug "mechanism-design" ;
    vc:sourceDomain "blockchain" .

ngm:merkle-root a owl:Class ;
    rdfs:label "Merkle Root"@en ;
    rdfs:comment "A Merkle Root is the single cryptographic hash at the apex of a Merkle tree, computed by recursively hashing pairs of child hashes until a single digest remains, such that the root encodes the integrity of every transaction or data element in the tree. In blockchain systems, each block header contains the Merkle root of all transactions in that block, enabling lightweight clients to verify transaction inclusion via a logarithmic-length Merkle proof without downloading the full block. This compact commitment property makes the Merkle root fundamental to blockchain scalability, security, and efficient synchronisation protocols."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:merkle-tree ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:hash-function ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptographic-hash-function ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:cryptographic-hash ],
        ngm:bc-cryptographic-primitive,
        ngm:blockchain-entity,
        ngm:cryptographic-primitive ;
    skos:broader ngm:bc-cryptographic-primitive ;
    vc:enables ngm:blockchain-scalability,
        ngm:blockchain-transaction ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:cryptographic-hash,
        ngm:merkle-tree ;
    vc:isPartOf ngm:block,
        ngm:block-header ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:blockchain-entity,
        ngm:digital-signature,
        ngm:nonce,
        ngm:proof-of-work ;
    vc:requires ngm:cryptographic-hash-function,
        ngm:hash-function ;
    vc:slug "merkle-root" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:blockchain-infrastructure .

ngm:mi-ca-regulation a owl:Class ;
    rdfs:label "MiCA Regulation"@en ;
    rdfs:comment "The Markets in Crypto-Assets (MiCA) Regulation (EU 2023/1114) is the European Union's comprehensive legislative framework governing the issuance, offering, and trading of crypto-assets, including asset-referenced tokens, e-money tokens, and utility tokens. Adopted in June 2023 and phasing in through December 2024, MiCA establishes authorisation requirements for crypto-asset service providers (CASPs), disclosure obligations analogous to prospectus rules, and prudential standards for stablecoin issuers, creating the world's first complete statutory crypto-asset regime across a major economic bloc."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:aml-kyc-compliance ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:compliance-framework ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:regulatory-compliance ],
        ngm:financial-regulation ;
    vc:contrastsWith ngm:digital-regulation,
        ngm:securities-regulation ;
    vc:enables ngm:digital-asset-market,
        ngm:financial-stability ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:blockchain-analytics,
        ngm:blockchain-compliance,
        ngm:cryptocurrency,
        ngm:digital-asset,
        ngm:stablecoin-regulation,
        ngmi:ethereum ;
    vc:requires ngm:aml-kyc-compliance,
        ngm:compliance-framework,
        ngm:regulatory-compliance ;
    vc:slug "mi-ca-regulation" ;
    vc:sourceDomain "governance" ;
    vc:standardizedBy ngm:european-commission,
        ngm:regulatory-framework .

ngm:neural-network-layer a owl:Class ;
    rdfs:label "Neural Network Layer"@en ;
    rdfs:comment "A Neural Network Layer is a discrete computational stage in a neural network that applies a parameterised transformation to its input tensor, including operations such as linear projection, convolution, normalisation, or attention. Layers are composed sequentially or in parallel to form a complete neural network architecture."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:activation-function ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:backpropagation ],
        ngm:ai-technique,
        ngm:neural-network-component ;
    skos:broader ngm:ai-technique ;
    vc:enables ngm:deep-learning ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:neural-network,
        ngm:neural-network-architecture ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:activation-function,
        ngm:backpropagation ;
    vc:slug "neural-network-layer" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:batch-normalisation .

ngm:orchestration a owl:Class ;
    rdfs:label "Orchestration"@en ;
    rdfs:comment "The automated coordination, scheduling, and lifecycle management of containerised workloads, microservices, and distributed agents across heterogeneous infrastructure. In the context of metaverse and telecollaboration systems, orchestration—exemplified by Kubernetes—ensures that compute-intensive rendering, AI inference, and real-time communication services scale elastically and recover automatically from failures."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:digital-infrastructure ],
        ngm:infra-computing-and-cloud ;
    skos:broader ngm:infra-computing-and-cloud ;
    vc:enables ngm:distributed-systems,
        ngm:microservices-architecture ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:requires ngm:digital-infrastructure ;
    vc:slug "orchestration" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:edge-computing,
        ngm:latency .

ngm:pre-training a owl:Class ;
    rdfs:label "Pre Training"@en ;
    rdfs:comment "The initial training phase where a model learns general representations from large amounts of unlabelled or weakly labelled data before being adapted to specific tasks. Pre-training establishes foundational knowledge that can be transferred across multiple downstream applications."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:model-training ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:training-data ],
        ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:contrastsWith ngm:contrastive-learning ;
    vc:enables ngm:fine-tuning,
        ngm:large-language-models,
        ngm:transfer-learning ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires ngm:model-training,
        ngm:training-data ;
    vc:slug "pre-training" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:predictive-maintenance a owl:Class ;
    rdfs:label "Predictive Maintenance"@en ;
    rdfs:comment "Predictive Maintenance (PdM) is a condition-based maintenance strategy that uses continuous or periodic monitoring of physical asset health signals—vibration, temperature, acoustic emission, current draw, oil particle count, ultrasound, and corrosion metrics—combined with machine learning inf..."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
