        ngm:tele-050-neural-rendering-telepresence,
        ngm:webxr ;
    vc:contrastsWith ngm:instant-ngp,
        ngm:mesh-based-rendering,
        ngm:neural-radiance-fields ;
    vc:dependsOn ngm:adam-optimiser,
        ngm:multi-view-photography,
        ngm:point-cloud ;
    vc:enables ngm:photorealistic-avatar,
        ngm:photorealistic-telepresence,
        ngm:real-time-novel-view-synthesis,
        ngm:volumetric-video-conferencing ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:adaptive-density-control,
        ngm:gaussian-primitive,
        ngm:spherical-harmonics ;
    vc:implements ngm:alpha-blending,
        ngm:painters-algorithm ;
    vc:isPartOf ngm:novel-view-synthesis ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:scene-reconstruction,
        ngm:virtual-reality-telepresence ;
    vc:requires ngm:differentiable-rendering,
        ngm:gpu-rasterisation,
        ngm:structure-from-motion ;
    vc:slug "3-d-gaussian-splatting" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:ssim-loss,
        ngm:stochastic-gradient-descent .

ngm:51-attack a owl:Class ;
    rdfs:label "51% Attack"@en ;
    rdfs:comment "A 51% Attack is a consensus-layer attack on a Proof-of-Work blockchain in which a single entity or coalition controls more than half of the network's hash rate, enabling double-spending, transaction censorship, and chain reorganisation. The attack exploits the longest-chain rule: the attacker mines a private fork containing fraudulent transactions and, once it exceeds the honest chain in cumulative work, broadcasts it to override confirmed history."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:hash-rate ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:proof-of-work ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:mining ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:mining-pool ],
        ngm:bc-protocol-and-consensus ;
    skos:broader ngm:bc-protocol-and-consensus ;
    vc:bridgesTo ngm:ai-energy-optimisation,
        ngm:game-theory,
        ngm:network-security ;
    vc:contrastsWith ngm:byzantine-fault-tolerance,
        ngm:proof-of-stake ;
    vc:dependsOn ngm:blockchain,
        ngm:cryptocurrency,
        ngm:mining-hardware ;
    vc:enables ngm:blockchain-reorganization,
        ngm:double-spending,
        ngm:transaction-censorship ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:blockchain-security,
        ngm:consensus-attack ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:bitcoin-gold,
        ngm:ethereum-classic,
        ngm:finality,
        ngm:selfish-mining,
        ngm:transaction ;
    vc:requires ngm:hash-rate,
        ngm:mining,
        ngm:mining-pool,
        ngm:proof-of-work ;
    vc:slug "51-attack" ;
    vc:sourceDomain "blockchain" .

ngm:account-abstraction a owl:Class ;
    rdfs:label "Account Abstraction"@en ;
    rdfs:comment "A paradigm shift in ereum account architecture standardized through ERC-4337 (March 2023) enabling smart contract wallets with programmable transaction validation logic, decoupled gas payment mechanisms, and flexible account recovery, eliminating the distinction between externally owned accounts ..."@en ;
