ngm:data-aggregation a owl:Class ;
    rdfs:label "Data Aggregation"@en ;
    rdfs:comment "Data aggregation is the systematic process of collecting, combining, and summarising records from multiple heterogeneous sources into a unified, reduced representation suitable for analysis, reporting, or further processing. It encompasses both batch and streaming paradigms, applying operations such as grouping, counting, summing, averaging, and deduplication to transform raw, high-volume data into structured, lower-dimensionality outputs. Aggregation underpins analytical workflows from simple dashboards to complex federated query engines, acting as a bridge between raw data capture and actionable intelligence. It is distinct from raw data replication in that it deliberately reduces detail while preserving statistically significant structure."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:stream-processing ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-pipeline ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:batch-processing ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-integration ],
        ngm:data-integration ;
    vc:bridgesTo ngm:differential-privacy,
        ngm:federated-learning,
        ngm:semantic-web ;
    vc:contrastsWith ngm:data-disaggregation,
        ngm:data-replication ;
    vc:dependsOn ngm:data-quality,
        ngm:metadata-management ;
    vc:enables ngm:anomaly-detection,
        ngm:business-intelligence,
        ngm:community-detection,
        ngm:data-warehouse,
        ngm:olap ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:batch-processing,
        ngm:etl,
        ngm:stream-processing ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:data-lake,
        ngm:event-sourcing ;
    vc:requires ngm:data-integration,
        ngm:data-pipeline,
        ngm:schema-mapping ;
    vc:slug "data-aggregation" ;
    vc:sourceDomain "data" ;
    vc:supports ngm:federated-learning,
        ngm:knowledge-graph,
        ngm:machine-learning ;
    vc:uses ngm:apache-spark,
        ngm:map-reduce,
        ngm:message-queue,
        ngm:sql .

ngm:data-format a owl:Class ;
    rdfs:label "Data Format"@en ;
    rdfs:comment "A Data Format is a formal structural and encoding specification that governs how raw bytes are organised, typed, and interpreted when data is stored, transmitted, or exchanged between computational systems. Formats encode decisions about byte ordering, field delimitation, schema evolution, compression, and type systems, ranging from binary serialisation protocols (Protocol Buffers, Apache Avro, MessagePack) to human-readable interchange formats (JSON, XML, YAML, TOML) and domain-specific schemas (DICOM for medical imaging, glTF for 3D assets, FITS for astronomical data). The choice of data format critically determines interoperability scope, parsing overhead, storage efficiency, schema evolution capability, and compatibility with downstream processing pipelines and analytics engines."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:schema-registry ],
        ngm:data-management ;
    vc:bridgesTo ngm:knowledge-graph,
        ngm:linked-data ;
    vc:contrastsWith ngm:binary-format,
        ngm:text-format ;
    vc:dependsOn ngm:character-encoding,
        ngm:type-system ;
    vc:enables ngm:api-design,
