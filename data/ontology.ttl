    vc:isPartOf ngm:model-training-pipeline ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:ai-alignment,
        ngm:knowledge-distillation,
        ngm:overfitting ;
    vc:requires ngm:gpu-compute,
        ngm:task-specific-dataset ;
    vc:slug "fine-tuning" ;
    vc:sourceDomain "machine-learning" ;
    vc:uses ngm:backpropagation,
        ngm:gradient-descent,
        ngm:learning-rate-schedule,
        ngm:low-rank-adaptation .

ngm:ontology a owl:Class ;
    rdfs:label "Ontology"@en ;
    rdfs:comment "In computer science and knowledge engineering, an ontology is a formal, machine-readable specification of a shared conceptualisation within a domain: it explicitly defines the classes of entities that exist, the properties and attributes of those entities, the relationships (object properties) that may hold between them, and the logical axioms that constrain valid world states. Ontologies are expressed using languages such as OWL 2 (Web Ontology Language) built atop RDF, enabling automated reasoning engines to infer implicit knowledge and detect logical inconsistencies. They underpin knowledge graphs, linked data systems, semantic interoperability frameworks, and AI knowledge representation across scientific, industrial, and Web domains. Rooted in philosophical ontology (the study of being and categories of existence), the computational form translates that tradition into machine-processable schemas governed by Description Logics with decidable inference."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:owl-class-hierarchy ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:formal-language ],
        ngm:knowledge-representation ;
    vc:bridgesTo ngm:digital-twin,
        ngm:retrieval-augmented-generation ;
    vc:contrastsWith ngm:corporate-tax-compliance-frameworkonomy,
        ngm:database-schema ;
    vc:enables ngm:automated-reasoning,
        ngm:knowledge-graph,
        ngm:linked-open-data,
        ngm:semantic-interoperability,
        ngm:semantic-search ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:data-property,
        ngm:object-property,
        ngm:owl-class-hierarchy ;
    vc:isPartOf ngm:semantic-web-linked-data-standard ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:knowledge-representation,
        ngm:linked-data,
        ngm:upper-ontology ;
    vc:requires ngm:formal-language ;
    vc:slug "ontology" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:description-logic,
        ngm:owl-class-hierarchy,
        ngm:rdf,
        ngm:sparql .

ngm:version-control a owl:Class ;
    rdfs:label "Version Control"@en ;
    rdfs:comment "Version control is a methodology and toolset for systematically tracking, managing, and auditing changes to files and artefacts over time, enabling multiple contributors to develop concurrently on isolated branches and integrate their work through well-defined merge strategies. Distributed version control systems such as Git maintain a full directed-acyclic-graph (DAG) history locally on every node, supporting offline operation, cryptographically signed commits, and fine-grained blame and bisect operations. Version control underpins modern software delivery practices including continuous integration, infrastructure-as-code, dataset lineage, and MLOps pipelines by providing immutable, content-addressed snapshots of any evolving asset."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptographic-hash-function ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:git ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:distributed-systems ],
        ngm:software-engineering ;
    vc:bridgesTo ngm:blockchain,
        ngm:data-lineage ;
    vc:dependsOn ngm:file-system,
        ngm:network-protocol ;
    vc:enables ngm:code-review,
        ngm:collaboration,
        ngm:continuous-integration,
        ngm:infrastructure-as-code ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:commit,
        ngm:git ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:audit-trail,
        ngm:code-generation,
        ngm:data-provenance,
        ngm:data-versioning,
        ngm:knowledge-management ;
    vc:requires ngm:cryptographic-hash-function,
        ngm:distributed-systems ;
    vc:slug "version-control" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:ai-augmented-software-engineering,
        ngm:devops,
        ngm:mlops .

ngm:observability a owl:Class ;
    rdfs:label "Observability"@en ;
    rdfs:comment "Observability is the capability of a system that allows engineers to infer its internal state and behaviour solely from externally observable outputs — primarily logs, metrics, and distributed traces. Derived from control-systems theory, it answers whether the complete internal state can be reconstructed from a sequence of outputs. In modern software engineering, observability enables debugging, performance tuning, incident response, and proactive reliability assurance across complex distributed architectures where direct inspection is impractical."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-collection ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:telemetry ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:distributed-tracing ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:alerting ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:audit-logging ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:instrumentation ],
        ngm:reliability-engineering ;
    vc:bridgesTo ngm:anomaly-detection,
        ngm:machine-learning-operations ;
    vc:contrastsWith ngm:debugging,
        ngm:monitoring ;
    vc:dependsOn ngm:distributed-systems,
        ngm:microservices ;
    vc:enables ngm:capacity-planning,
        ngm:chaos-engineering,
        ngm:incident-response,
        ngm:site-reliability-engineering ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:alerting,
        ngm:audit-logging,
        ngm:distributed-tracing ;
    vc:implements ngm:open-telemetry ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:fault-tolerance,
        ngm:performance,
        ngm:service-level-objective ;
    vc:requires ngm:data-collection,
        ngm:instrumentation,
        ngm:telemetry ;
    vc:slug "observability" ;
    vc:sourceDomain "infrastructure" ;
    vc:standardizedBy ngm:cloud-native-computing-foundation,
        ngm:open-telemetry ;
    vc:supports ngm:continuous-delivery,
        ngm:devops ;
    vc:uses ngm:log-aggregation,
        ngm:service-mesh,
        ngm:time-series-database .

ngm:slam a owl:Class ;
    rdfs:label "SLAM"@en ;
    rdfs:comment "Simultaneous Localization and Mapping (SLAM) is a robotics and computer vision technique enabling devices to build maps of unknown environments whilst simultaneously tracking their own position within those environments, combining localisation and map construction in real-time using probabilistic state estimation and sensor fusion."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:sensor-fusion ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:occupancy-grid ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:state-estimation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:loop-closure-detection ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:localization ],
        ngm:spatial-mapping ;
    vc:bridgesTo ngm:metaverse,
        ngm:virtual-environment ;
    vc:contrastsWith ngm:gps-navigation ;
    vc:dependsOn ngm:inertial-measurement-unit,
        ngm:point-cloud-processing ;
    vc:enables ngm:augmented-reality,
        ngm:autonomous-navigation,
        ngm:autonomous-robot,
        ngm:digital-twin ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:localization,
        ngm:occupancy-grid ;
    vc:isPartOf ngm:spatial-computing ;
    vc:qualityScore "0.65"^^xsd:float ;
    vc:relatedTo ngm:computer-vision ;
    vc:requires ngm:loop-closure-detection,
        ngm:sensor-fusion,
        ngm:state-estimation ;
    vc:slug "slam" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:deep-learning,
        ngm:kalman-filter,
        ngm:lidar,
        ngm:pose-estimation,
        ngm:visual-odometry .

ngm:convolutional-neural-network a owl:Class ;
    rdfs:label "Convolutional Neural Network"@en ;
    rdfs:comment "A Convolutional Neural Network (CNN) is a feed-forward deep learning architecture that applies learned convolutional filters across spatial dimensions of input data, enabling hierarchical feature extraction from images and other grid-structured inputs. Weight sharing and local receptive fields make CNNs highly parameter-efficient for visual recognition tasks including image classification, object detection, and semantic segmentation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:training-data ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:activation-function ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gpu-computing ],
        ngm:ai-model-architecture ;
    skos:broader ngm:ai-model-architecture ;
    vc:bridgesTo ngm:augmented-reality,
        ngm:autonomous-driving-perception ;
    vc:contrastsWith ngm:recurrent-neural-network,
        ngm:transformer-architecture ;
    vc:dependsOn ngm:gradient-descent,
        ngm:weight-sharing ;
    vc:enables ngm:feature-extraction,
        ngm:image-classification,
        ngm:object-detection,
        ngm:semantic-segmentation ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:activation-function,
        ngm:convolutional-layer,
        ngm:pooling-layer ;
    vc:implements ngm:feedforward-neural-network ;
    vc:isPartOf ngm:deep-learning ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:adversarial-robustness ;
    vc:requires ngm:gpu-computing,
        ngm:training-data ;
    vc:slug "convolutional-neural-network" ;
    vc:sourceDomain "machine-learning" ;
    vc:supports ngm:computer-vision,
        ngm:medical-image-analysis ;
    vc:uses ngm:backpropagation,
        ngm:batch-normalisation,
        ngm:stochastic-gradient-descent,
        ngm:transfer-learning .

ngm:decentralised-identity a owl:Class ;
    rdfs:label "Decentralised Identity"@en ;
    rdfs:comment "Decentralised Identity is a model for digital identity management in which individuals, organisations, and devices create, own, and control their own cryptographic identifiers and verifiable credentials without dependence on centralised identity providers or registries. Identifiers are anchored to a verifiable data registry — typically a blockchain or distributed ledger — as Decentralised Identifiers (DIDs) standardised by the W3C DID Core 1.0 specification, which defines a URI scheme resolving to a DID Document containing public keys and service endpoints. Credentials attesting to attributes of the DID subject are issued by trusted parties as W3C Verifiable Credentials, stored in a user-controlled digital wallet, and selectively disclosed to verifiers using zero-knowledge proofs or selective-disclosure mechanisms. The model operationalises Self-Sovereign Identity principles, giving subjects full autonomy over their identity data across systems and jurisdictions."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptographic-key-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:verifiable-data-registry ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:did-method ],
        ngm:digital-identity ;
    vc:bridgesTo ngm:access-control,
        ngm:ai-agent-identity ;
    vc:contrastsWith ngm:centralized-identity-provider,
        ngm:federated-identity ;
    vc:enables ngm:digital-identity,
        ngm:privacy-preserving-authentication,
        ngm:selective-disclosure,
        ngm:self-sovereign-identity ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:implements ngm:openid-for-verifiable-credentials,
        ngm:w3-c-did-specification ;
