ngm:real-time a owl:Class ;
    rdfs:label "Real Time"@en ;
    rdfs:comment "Real-Time Computing is the discipline of designing computing systems, operating environments, and algorithmic frameworks in which program correctness depends not only on the logical result of computation but also on the time at which those results are produced, enforcing temporal constraints — de..."@en ;
    rdfs:subClassOf ngm:operating-systems,
        ngm:safety-critical-systems ;
    vc:enables ngm:automotive-control,
        ngm:autonomous-systems,
        ngm:avionics,
        ngm:distributed-real-time,
        ngm:industrial-automation,
        ngm:real-time-ai-inference,
        ngm:safety-critical-computing ;
    vc:hasPart ngm:deadline,
        ngm:interrupt-handler,
        ngm:priority-ceiling-protocol,
        ngm:rtos,
        ngm:scheduler,
        ngm:task,
        ngm:timer,
        ngm:wcet-analysis ;
    vc:implements ngm:constant-bandwidth-server,
        ngm:earliest-deadline-first,
        ngm:hierarchical-scheduling,
        ngm:priority-ceiling-protocol,
        ngm:priority-inheritance-protocol,
        ngm:rate-monotonic-algorithm ;
    vc:maturity "established" ;
    vc:qualityScore "0.52"^^xsd:float ;
    vc:relatedTo ngm:cyber-physical-systems,
        ngm:digital-signal-processing,
        ngm:edge-computing,
        ngm:fpga,
        ngm:functional-safety,
        ngm:time-sensitive-networking ;
    vc:requires ngm:determinism,
        ngm:hardware-abstraction-layer,
        ngm:priority-inheritance,
        ngm:schedulability-analysis,
        ngm:temporal-correctness,
        ngm:wcet-bound ;
    vc:slug "real-time" ;
    vc:sourceDomain "infrastructure" ;
    vc:standardizedBy ngm:do-178-c,
        ngm:iec-61508,
        ngm:ieee-1588,
        ngm:ieee-802-1-tsn,
        ngm:iso-26262,
        ngm:omg-dds-specification,
        ngm:posix-1003-1b ;
    vc:supports ngm:autonomous-vehicles,
        ngm:avionics,
        ngm:industrial-io-t,
        ngm:medical-devices,
        ngm:robotics,
        ngm:telecommunications ;
    vc:uses ngm:dds,
        ngm:free-rtos,
        ngm:qnx,
        ngm:ros-2,
        ngm:tsn,
        ngm:vx-works,
        ngm:web-rtc,
        ngm:zephyr .

