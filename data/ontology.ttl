    vc:slug "acquisition-function" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:bayesian-inference,
        ngm:probabilistic-model .

ngm:activity-data a owl:Class ;
    rdfs:label "Activity Data"@en ;
    rdfs:comment "Activity data is the structured or semi-structured record of actions, interactions, and events performed by users, devices, or systems over time, capturing what was done, when, by whom, and in what context. It encompasses clickstreams, application usage logs, sensor readings, transaction histories, and learning interaction records, and serves as the raw material for analytics, personalisation, compliance auditing, and behavioural modelling."@en ;
    rdfs:subClassOf ngm:data-collection ;
