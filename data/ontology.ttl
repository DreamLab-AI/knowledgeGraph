ngm:field-programmable-gate-array a owl:Class ;
    rdfs:label "Field-Programmable Gate Array"@en ;
    rdfs:comment "A field-programmable gate array (FPGA) is an integrated circuit whose internal logic and interconnect can be reconfigured by the user after manufacture to implement arbitrary digital circuits. It comprises a fabric of programmable logic blocks, embedded memories, and routing that is configured from a hardware description language. FPGAs deliver hardware-level parallelism and low latency while remaining reprogrammable, sitting between fixed ASICs and general-purpose processors."@en ;
    rdfs:subClassOf ngm:hardware-accelerator ;
    vc:bridgesTo ngm:asic ;
    vc:contrastsWith ngm:asic,
        ngm:gpu ;
    vc:enables ngm:parallel-computing ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:integrated-circuit ;
    vc:implements ngm:hardware-accelerator ;
    vc:isPartOf ngm:reconfigurable-computing ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:integrated-circuit,
        ngm:system-on-chip ;
    vc:slug "field-programmable-gate-array" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:digital-signal-processing ;
    vc:uses ngm:hardware-description-language,
        ngm:reconfigurable-computing .

ngm:financial-privacy a owl:Class ;
    rdfs:label "Financial Privacy"@en ;
    rdfs:comment "Financial Privacy refers to the rights, mechanisms, and technical controls that protect individuals and organisations from unwanted disclosure of their financial transactions, holdings, and economic behaviour. It encompasses both legal frameworks—such as bank secrecy laws and GDPR financial data provisions—and cryptographic techniques such as zero-knowledge proofs, stealth addresses, and confidential transactions. The tension between financial privacy and regulatory transparency requirements (AML, KYC) is a defining challenge of the digital payments era, particularly as public blockchain ledgers make transaction histories permanently visible. Financial privacy is increasingly recognised as a precondition for personal autonomy, political freedom, and protection against targeted financial censorship."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:identity-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:key-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:encryption ],
        ngm:cryptography-security-and-privacy ;
    vc:bridgesTo ngm:central-bank-digital-currency,
        ngm:decentralised-finance,
        ngm:self-sovereign-identity ;
    vc:contrastsWith ngm:blockchain-analytics,
        ngm:compliance-framework,
        ngm:transaction-monitoring ;
    vc:enables ngm:censorship-resistance,
        ngm:fungibility ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:aml-kyc-compliance,
        ngm:data-sovereignty,
        ngm:differential-privacy,
        ngm:privacy-by-design,
        ngm:surveillance-capitalism,
        ngm:zero-knowledge-proof ;
    vc:requires ngm:encryption,
        ngm:identity-management,
        ngm:key-management ;
    vc:slug "financial-privacy" ;
    vc:sourceDomain "finance" ;
    vc:uses ngm:confidential-computing,
        ngm:cryptographic-commitment,
        ngm:homomorphic-encryption,
        ngm:ring-signature,
        ngm:stealth-address,
        ngm:zero-knowledge .

ngm:fog-computing a owl:Class ;
    rdfs:label "Fog Computing"@en ;
    rdfs:comment "Fog computing is a distributed architecture that places compute, storage, and networking resources in an intermediate tier between end devices and the cloud, typically in gateways, routers, and local servers near the data source. It extends cloud capabilities toward the network edge to reduce latency, conserve bandwidth, and improve resilience and privacy for geographically dispersed Internet-of-Things deployments. Distinct from edge computing's focus on the device itself, fog computing emphasises a coordinated, hierarchical layer of regional nodes orchestrating many edges."@en ;
    rdfs:subClassOf ngm:distributed-computing ;
    vc:enables ngm:low-latency-computing ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:cloud-computing ;
    vc:slug "fog-computing" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:edge-computing .

ngm:forward-pass a owl:Class ;
    rdfs:label "Forward Pass"@en ;
    rdfs:comment "The forward pass is the computation that propagates input data through the layers of a neural network to produce an output, applying weighted sums, biases and activation functions in sequence. It evaluates the network's current function and, during training, produces the predictions against which the loss is measured. The intermediate activations it computes are retained so that the subsequent backward pass can calculate gradients."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:activation-function ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:activation-function ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:matrix-multiplication ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:parameter ],
        ngm:neural-network ;
    vc:contrastsWith ngm:backpropagation ;
    vc:dependsOn ngm:deep-learning ;
    vc:enables ngm:inference,
        ngm:model-inference ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:activation-function,
        ngm:matrix-multiplication ;
    vc:isPartOf ngm:neural-network,
        ngm:training ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:batch-processing,
        ngm:gradient-descent ;
    vc:requires ngm:activation-function,
        ngm:parameter ;
    vc:slug "forward-pass" ;
    vc:sourceDomain "machine-learning" ;
    vc:supports ngm:loss-function ;
    vc:uses ngm:gpu-acceleration,
        ngm:matrix-multiplication .

ngm:full-fine-tuning a owl:Class ;
    rdfs:label "Full Fine Tuning"@en ;
    rdfs:comment "A fine-tuning approach that updates all parameters of a pre-trained model during adaptation to a downstream task, requiring approximately four times the model's memory footprint to store weights, gradients, and optimiser states. Full fine-tuning provides maximum task-specific flexibility and sets the performance ceiling against which parameter-efficient alternatives such as LoRA are benchmarked, but creates a separate full-sized model copy per task."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:large-language-models ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:transfer-learning ],
        ngm:ai-technique,
        ngm:fine-tuning ;
    skos:broader ngm:ai-technique ;
    vc:contrastsWith ngm:continued-pre-training ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:early-stopping,
        ngm:overfitting ;
    vc:requires ngm:large-language-models,
        ngm:transfer-learning ;
    vc:slug "full-fine-tuning" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:deep-learning,
        ngm:gradient-descent .

ngm:g20 a owl:Class ;
    rdfs:label "G20"@en ;
    rdfs:comment "The G20 (Group of Twenty) is an intergovernmental forum of nineteen major economies plus the European Union and African Union that coordinates international economic and financial policy. It convenes heads of state, finance ministers and central bank governors to address global financial stability, trade, development and systemic risk. Through its leaders' summits and working groups, the G20 sets the political agenda that bodies such as the Financial Stability Board, IMF and Basel Committee translate into standards and recommendations."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:regulation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:international-cooperation ],
        ngm:economic-governance ;
    vc:dependsOn ngm:international-cooperation ;
    vc:enables ngm:central-bank ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:economic-governance ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:financial-stability-board,
        ngm:international-monetary-fund,
        ngm:oecd ;
    vc:requires ngm:international-cooperation,
        ngm:regulation ;
    vc:slug "g20" ;
    vc:sourceDomain "governance" ;
    vc:standardizedBy ngm:basel-committee,
        ngm:fsb ;
    vc:supports ngm:financial-regulation,
        ngm:financial-stability,
        ngm:fiscal-policy,
        ngm:macroprudential-policy .

ngm:gas-limit a owl:Class ;
    rdfs:label "Gas Limit"@en ;
    rdfs:comment "A Gas Limit is the maximum amount of gas — the unit measuring computational effort — that a sender authorises for a blockchain transaction or that a block may contain in aggregate. It serves as a hard cap preventing unbounded resource consumption, protecting network nodes from denial-of-service attacks and ensuring predictable block processing times. On Ethereum, each transaction carries a user-set gas limit and each block carries a protocol-enforced block gas limit that validators adjust over time."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:blockchain-transaction ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:consensus-mechanism ],
        ngm:bc-protocol-and-consensus,
        ngm:blockchain-entity,
        ngm:economic-mechanism ;
    skos:broader ngm:bc-protocol-and-consensus ;
    vc:contrastsWith ngm:proof-of-stake,
        ngm:proof-of-work ;
    vc:dependsOn ngm:base-fee,
        ngm:fee-market ;
    vc:enables ngm:blockchain-scalability,
        ngm:smart-contract-execution ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:block-size,
        ngm:blockchain-economics,
        ngm:gas-price,
        ngm:mempool,
        ngm:mev,
        ngm:transaction-fee,
        ngm:validator-node ;
    vc:requires ngm:blockchain-transaction,
        ngm:consensus-mechanism ;
    vc:slug "gas-limit" ;
    vc:sourceDomain "blockchain" .

ngm:gaze-tracking a owl:Class ;
    rdfs:label "Gaze Tracking"@en ;
    rdfs:comment "Gaze tracking is the measurement of where a person is looking by estimating the direction and point of regard of the eyes, typically using cameras and infrared illumination to locate pupil and corneal reflections. In spatial computing it provides a hands-free input modality and a signal for attention, enabling interfaces that respond to where the user looks. Gaze tracking is foundational to foveated rendering, intent inference, and accessible interaction in head-mounted displays and immersive systems."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:perception-system ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:perception-system ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:computational-model ],
        ngm:eye-tracking ;
    vc:bridgesTo ngm:spatial-computing ;
    vc:enables ngm:foveated-rendering,
        ngm:immersive-interface ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:perception-system ;
    vc:implements ngm:user-interface ;
    vc:isPartOf ngm:eye-tracking,
        ngm:human-computer-interaction ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:gesture-recognition,
        ngm:hand-tracking,
        ngm:virtual-reality ;
    vc:requires ngm:computational-model,
        ngm:perception-system ;
    vc:slug "gaze-tracking" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:accessibility,
        ngm:spatial-interaction ;
    vc:uses ngm:machine-learning .

ngm:gazebo-simulator a owl:Class ;
    rdfs:label "Gazebo Simulator"@en ;
    rdfs:comment "Gazebo Simulator (now branded Gz Sim following the Open Robotics / Intrinsic rebranding) is an open-source, physics-accurate 3D robotics simulator providing rigid-body dynamics (via ODE, Bullet, DART, or Simbody), sensor simulation (cameras, LiDAR, IMU, GPS), and a plugin architecture for custom ..."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:sensors ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:3-d-rendering-engine ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:physics-engine ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:urdf-robot-model ],
        ngm:robo-actuation-and-control,
        ngm:robotics ;
    skos:broader ngm:robo-actuation-and-control,
        ngm:robotics ;
    vc:enables ngm:hardware-in-the-loop-testing,
        ngm:reinforcement-learning,
        ngm:sensor-simulation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:sensors ;
    vc:isPartOf ngm:robot-operating-system,
        ngm:sim-to-real-transfer ;
    vc:qualityScore "0.55"^^xsd:float ;
    vc:requires ngm:3-d-rendering-engine,
        ngm:physics-engine,
        ngm:urdf-robot-model ;
    vc:slug "gazebo-simulator" ;
    vc:sourceDomain "robotics" .

ngm:geometry-processing a owl:Class ;
    rdfs:label "Geometry Processing"@en ;
    rdfs:comment "Geometry processing is the field concerned with acquiring, representing, analysing and manipulating geometric models, typically triangle meshes and point clouds. It encompasses operations such as smoothing, simplification, parameterisation, remeshing and surface reconstruction, drawing on differential geometry and linear algebra. Geometry processing underpins 3D content pipelines, simulation and rendering by transforming raw or noisy geometric data into clean, structured representations suitable for downstream use."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:texture-mapping ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:polygon-mesh ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:triangulation ],
        ngm:computational-geometry ;
    vc:bridgesTo ngm:digital-twin ;
    vc:dependsOn ngm:computational-geometry ;
    vc:enables ngm:level-of-detail,
        ngm:real-time-rendering-pipeline ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:texture-mapping,
        ngm:triangulation ;
    vc:isPartOf ngm:3d-modelling ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:point-cloud,
        ngm:polygon-mesh ;
    vc:requires ngm:polygon-mesh ;
    vc:slug "geometry-processing" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:collision-detection,
        ngm:physics-simulation ;
    vc:uses ngm:computational-geometry,
        ngm:linear-algebra .

ngm:geometry-shader a owl:Class ;
    rdfs:label "Geometry Shader"@en ;
    rdfs:comment "A geometry shader is a programmable stage of the graphics pipeline that operates on whole primitives, such as points, lines or triangles, after vertex processing and before rasterisation. Unlike vertex shaders, it can create or discard primitives, emitting zero or more output primitives for each input. This capability supports effects such as silhouette extrusion, point-sprite expansion and dynamic level-of-detail generation directly on the GPU."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gpu-computing ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:graphics-pipeline ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:graphics-processing-unit ],
        ngm:shader-language ;
    vc:contrastsWith ngm:compute-shader,
        ngm:vertex-shader ;
    vc:enables ngm:level-of-detail,
        ngm:particle-system ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:graphics-pipeline ;
    vc:isPartOf ngm:rendering-pipeline ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:graphics-api,
        ngm:rasterization ;
    vc:requires ngm:gpu-computing,
        ngm:graphics-processing-unit ;
    vc:slug "geometry-shader" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:real-time-rendering,
        ngm:visual-effects ;
    vc:uses ngm:glsl,
        ngm:hlsl .

ngm:gpu-driver a owl:Class ;
    rdfs:label "GPU Driver"@en ;
    rdfs:comment "A GPU driver is the system software that mediates between an operating system or application graphics API and the physical graphics processing unit, translating high-level rendering and compute commands into hardware-specific instructions. It manages GPU memory, command submission queues, context switching, and synchronisation, and exposes standard interfaces so that applications need not target individual hardware models. Driver quality and versioning directly affect performance, feature availability, and stability of graphics and GPU-compute workloads."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gpu ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:firmware ],
        ngm:hardware-abstraction-layer ;
    vc:dependsOn ngm:gpu,
        ngm:operating-system ;
    vc:enables ngm:cuda,
        ngm:hardware-acceleration,
        ngm:vulkan ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:graphics-api ;
    vc:isPartOf ngm:operating-system ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:directx,
        ngm:graphics-api,
        ngm:open-gl ;
    vc:requires ngm:firmware,
        ngm:gpu ;
    vc:slug "gpu-driver" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:compute-shader,
        ngm:render-pipeline ;
    vc:uses ngm:memory-management .

ngm:gradient-clipping a owl:Class ;
    rdfs:label "Gradient Clipping"@en ;
    rdfs:comment "A technique that limits the magnitude of gradients during backpropagation to prevent exploding gradients and training instability. Gradient clipping rescales gradients when their norm exceeds a threshold, enabling stable training of deep networks, especially recurrent architectures."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:backpropagation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:neural-network ],
        ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:enables ngm:deep-learning,
        ngm:recurrent-neural-network ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:large-language-models,
        ngm:optimiser ;
    vc:requires ngm:backpropagation,
        ngm:neural-network ;
    vc:slug "gradient-clipping" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:gradient-descent,
        ngm:loss-function .

ngm:graph-analytics a owl:Class ;
    rdfs:label "Graph Analytics"@en ;
    rdfs:comment "Graph Analytics is a computational discipline that applies graph-theoretic algorithms to structured relational data in order to discover patterns, measure importance, detect communities, and predict missing links. It operates on data modelled as nodes (entities) and edges (relationships), enabling analyses that are intractable with tabular data models when relationship structure is central to insight."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:community-detection ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:graph-embedding ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:link-prediction ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:pathfinding-algorithm ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:distributed-computing ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:graph-data-model ],
        ngm:network-analysis ;
    vc:bridgesTo ngm:cybersecurity,
        ngm:drug-discovery,
        ngm:supply-chain ;
    vc:contrastsWith ngm:relational-database ;
    vc:dependsOn ngm:graph-theory ;
    vc:enables ngm:fraud-detection,
        ngm:recommendation-system,
        ngm:retrieval-augmented-generation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:community-detection,
        ngm:graph-embedding,
        ngm:link-prediction,
        ngm:pathfinding-algorithm ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:pagerank,
        ngm:social-network-analysis ;
    vc:requires ngm:distributed-computing,
        ngm:graph-data-model ;
    vc:slug "graph-analytics" ;
    vc:sourceDomain "ai" ;
    vc:supports ngm:machine-learning,
        ngm:natural-language-processing ;
    vc:uses ngm:graph-database,
        ngm:graph-neural-network,
        ngm:knowledge-graph,
        ngm:sparse-matrix .

ngm:graph-representation a owl:Class ;
    rdfs:label "Graph Representation"@en ;
    rdfs:comment "Graph representation is the encoding of a problem domain as a set of nodes (vertices) connected by edges, capturing entities and the relationships between them. It enables algorithmic reasoning over connectivity, distance, and structure, and underpins pathfinding, routing, and topological analysis. Common concrete forms include adjacency matrices, adjacency lists, and edge lists."@en ;
    rdfs:subClassOf ngm:distributed-data-structure ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:dijkstra-algorithm,
        ngm:topological-map ;
    vc:slug "graph-representation" ;
    vc:sourceDomain "data" .

ngm:greenhouse-gas-protocol a owl:Class ;
    rdfs:label "Greenhouse Gas Protocol"@en ;
    rdfs:comment "The Greenhouse Gas Protocol is the most widely used set of standards for measuring and reporting greenhouse gas emissions across organisations and value chains. It defines the categorisation of emissions into Scope 1 direct emissions, Scope 2 purchased energy and Scope 3 value-chain emissions, and provides accounting and reporting principles. Developed by the World Resources Institute and the World Business Council for Sustainable Development, it underpins corporate carbon accounting and disclosure."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:scope-3-emissions ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:materiality-assessment ],
        ngm:carbon-accounting ;
    vc:bridgesTo ngm:climate-risk ;
    vc:dependsOn ngm:carbon-accounting ;
    vc:enables ngm:esg-reporting,
        ngm:sustainability-reporting ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:tcfd ;
    vc:isPartOf ngm:carbon-accounting ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:climate-change,
        ngm:emissions-trading-scheme,
        ngm:esg,
        ngm:issb ;
    vc:requires ngm:materiality-assessment,
        ngm:scope-3-emissions ;
    vc:slug "greenhouse-gas-protocol" ;
    vc:sourceDomain "governance" ;
    vc:standardizedBy ngm:disclosure ;
    vc:supports ngm:carbon-credits,
        ngm:net-zero .

ngm:gyroscope a owl:Class ;
    rdfs:label "Gyroscope"@en ;
    rdfs:comment "Gyroscope - An angular velocity sensor that detects rotation rates about three orthogonal axes, enabling Attitude Estimation, Roll/Pitch/Yaw Measurement, and Orientation Tracking for balance control and Inertial Navigation in aerial and mobile robots."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:sensor-fusion ],
        ngm:robo-perception ;
    skos:broader ngm:robo-perception ;
    vc:bridgesTo ngm:sensor ;
    vc:enables ngm:balance-control ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:isPartOf ngm:inertial-measurement-unit ;
    vc:qualityScore "0.56"^^xsd:float ;
    vc:requires ngm:sensor-fusion ;
    vc:slug "gyroscope" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:robotics .

ngm:haptic-feedback-system a owl:Class ;
    rdfs:label "Haptic Feedback System"@en ;
    rdfs:comment "A Haptic Feedback System is a hardware-software assembly that generates controlled tactile and kinaesthetic sensations in response to digital events, using actuator arrays (vibrotactile motors, piezoelectric patches, pneumatic bladders, or shape-memory alloys), real-time rendering engines, and closed-loop sensorimotor control loops to simulate textures, resistances, impacts, and spatial forces for users of VR/AR headsets, surgical simulators, teleoperation systems, and mobile devices. The system comprises transducers that convert electrical signals into mechanical motion, driver electronics that modulate waveform parameters (frequency, amplitude, duration), rendering middleware that maps virtual-world physics to actuator commands, and perceptual models calibrated to human mechanoreceptor response characteristics."@en ;
    rdfs:subClassOf ngm:haptic-feedback ;
    vc:enables ngm:extended-reality,
        ngm:human-robot-interaction,
        ngm:immersive-experience ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:force-feedback,
        ngm:haptic-feedback-telepresence,
        ngm:haptics,
        ngm:sensor-fusion ;
    vc:slug "haptic-feedback-system" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:actuator,
        ngm:force-control,
        ngm:tactile-sensor .

ngm:hardware-layer a owl:Class ;
    rdfs:label "Hardware Layer"@en ;
    rdfs:comment "The Hardware Layer is the lowest stratum of the canonical stack, comprising the physical computing, storage, and signalling devices on which everything above runs. Nothing sits below it; immediately above it is the Network Layer, which connects discrete machines. It contains processors, memory, storage media, accelerators, and the physical transmission media that carry signals."@en ;
    rdfs:subClassOf ngm:infra-computing-and-cloud ;
    skos:broader ngm:infra-computing-and-cloud ;
    vc:enables ngm:compute-layer,
        ngm:network-layer ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:slug "hardware-layer" ;
    vc:sourceDomain "infrastructure" .

ngm:hardware-root-of-trust a owl:Class ;
    rdfs:label "Hardware Root of Trust"@en ;
    rdfs:comment "A Hardware Root of Trust (HRoT) is an immutable, hardware-anchored set of functions and keys that a system inherently trusts and from which all higher-level security properties are derived. Implemented in silicon or a dedicated security chip, it provides the foundation for secure boot, measured boot, attestation and key protection by establishing a starting point that cannot be modified by software. Because every subsequent trust decision chains back to it, the integrity of the HRoT determines the trustworthiness of the entire platform."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:cryptography ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:firmware ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:hardware-security-module ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:key-management ],
        ngm:security ;
    vc:enables ngm:authentication,
        ngm:digital-signature ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:cryptography,
        ngm:firmware ;
    vc:isPartOf ngm:trusted-execution-environment,
        ngm:trusted-platform-module ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:secure-element,
        ngm:secure-enclave,
        ngm:side-channel-attack ;
    vc:requires ngm:hardware-security-module,
        ngm:key-management ;
    vc:slug "hardware-root-of-trust" ;
    vc:sourceDomain "security" ;
    vc:supports ngm:zero-trust-architecture ;
    vc:uses ngm:certificate-authority,
        ngm:encryption .

ngm:hardware-security a owl:Class ;
    rdfs:label "Hardware Security"@en ;
    rdfs:comment "Hardware security protects systems by building trust and isolation into physical components, using features such as secure enclaves, key storage and tamper resistance to defend against attacks software alone cannot stop."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:computer-hardware ],
        ngm:computer-hardware ;
    vc:enables ngm:trusted-execution-environment ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:computer-hardware ;
    vc:slug "hardware-security" ;
    vc:sourceDomain "metaverse" .

ngm:hidden-markov-model a owl:Class ;
    rdfs:label "Hidden Markov Model"@en ;
    rdfs:comment "A hidden Markov model (HMM) is a probabilistic model for sequences in which an unobserved Markov chain of discrete states generates observable outputs, one per state, according to state-dependent emission distributions. The model is defined by transition probabilities between hidden states and emission probabilities for observations, plus an initial state distribution. HMMs support efficient inference for filtering, decoding, and learning over sequential data."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:markov-chain ],
        ngm:graphical-model ;
    vc:contrastsWith ngm:state-machine ;
    vc:dependsOn ngm:graphical-model,
        ngm:markov-chain ;
    vc:enables ngm:part-of-speech-tagging,
        ngm:speech-recognition ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:markov-chain ;
    vc:implements ngm:sequence-model ;
    vc:isPartOf ngm:graphical-model ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:latent-variable-model,
        ngm:state-machine,
        ngm:time-series ;
    vc:slug "hidden-markov-model" ;
    vc:sourceDomain "machine-learning" ;
    vc:supports ngm:time-series ;
    vc:uses ngm:bayesian-inference,
        ngm:dynamic-programming,
        ngm:expectation-maximisation .

ngm:hierarchical-deterministic-wallet a owl:Class ;
    rdfs:label "Hierarchical Deterministic Wallet"@en ;
    rdfs:comment "A hierarchical deterministic (HD) wallet is a cryptocurrency wallet that derives a tree of key pairs from a single master seed using a deterministic algorithm, as standardised in BIP-32 and related proposals. From one human-readable mnemonic phrase the wallet can regenerate an effectively unlimited hierarchy of addresses, allowing backup of an entire wallet from a single seed. The structure improves privacy by using fresh addresses while keeping recovery and organisation manageable."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:public-key-cryptography ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:entropy ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:seed-phrase ],
        ngm:blockchain-wallet ;
    vc:dependsOn ngm:key-generation ;
    vc:enables ngm:self-custody ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:mnemonic-phrase,
        ngm:seed-phrase ;
    vc:implements ngm:bip39 ;
    vc:isPartOf ngm:blockchain-wallet ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:digital-wallet,
        ngm:hardware-wallet ;
    vc:requires ngm:entropy,
        ngm:public-key-cryptography ;
    vc:slug "hierarchical-deterministic-wallet" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:key-management ;
    vc:uses ngm:elliptic-curve-cryptography,
        ngm:secp256k1 .

ngm:hnsw-index a owl:Class ;
    rdfs:label "HNSW Index"@en ;
    rdfs:comment "An HNSW (Hierarchical Navigable Small World) index is a graph-based data structure for approximate nearest-neighbour search over high-dimensional vectors. It builds a multi-layer proximity graph where greedy traversal from a sparse top layer down to a dense base layer locates close vectors in logarithmic time. HNSW is the standard index backing vector databases and semantic search at scale."@en ;
    rdfs:subClassOf ngm:infra-data-management ;
    skos:broader ngm:infra-data-management ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:semantic-search,
        ngm:storage-infrastructure ;
    vc:slug "hnsw-index" ;
    vc:sourceDomain "data" .

ngm:home-assistant a owl:Class ;
