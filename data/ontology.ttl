ngm:surface-marine-robot a owl:Class ;
    rdfs:label "Surface Marine Robot"@en ;
    rdfs:comment "A Surface Marine Robot, also known as an Unmanned Surface Vehicle (USV), is an autonomous or remotely operated robotic platform that operates on the surface of bodies of water—oceans, lakes, rivers, and coastal zones. It performs tasks including hydrographic survey, environmental monitoring, maritime patrol, search-and-rescue support, and data relay without requiring an onboard crew, thereby reducing operational cost and human risk in hazardous or remote marine environments."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:navigation-system ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:motion-planning ],
        ngm:marine-robot ;
    vc:contrastsWith ngm:aerial-robot,
        ngm:underwater-robot ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:robotics ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:autonomous-robot,
        ngm:inspection-robot,
        ngm:remotely-operated-vehicle-rov ;
    vc:requires ngm:motion-planning,
        ngm:navigation-system ;
    vc:slug "surface-marine-robot" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:autonomous-navigation,
        ngm:lidar,
        ngm:perception-system .

ngm:synchronous-execution a owl:Class ;
    rdfs:label "Synchronous Execution"@en ;
    rdfs:comment "Synchronous Execution is a computational execution model in which operations are performed sequentially, with each call blocking the invoking thread until a result is returned before the next operation begins. This model provides deterministic, predictable control flow and simplifies error handling, making it well-suited for transactional operations, authentication flows, and ACID-compliant database interactions, though it constrains throughput and scalability under high-concurrency workloads."@en ;
    rdfs:subClassOf ngm:bc-protocol-and-consensus ;
    skos:broader ngm:bc-protocol-and-consensus ;
    vc:bridgesTo ngm:execution-model ;
    vc:contrastsWith ngm:asynchronous-execution,
        ngm:event-driven-architecture ;
    vc:enables ngm:state-machine-replication,
        ngm:transaction-confirmation ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:distributed-systems,
        ngm:state-machine,
        ngm:transaction-finality,
        ngm:transaction-processing ;
    vc:slug "synchronous-execution" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:smart-contract-execution .

ngm:technical-history-extended-cv a owl:Class ;
    rdfs:label "Technical History (extended CV)"@en ;
    rdfs:comment "Technical History (extended CV) is the knowledge-graph representation of the author's professional research trajectory, spanning 15+ years leading immersive technology laboratories, securing multi-million-pound grant funding, and developing open-source metaverse and AI systems. It contextualises published research, institutional roles, and ongoing projects — including Knowhere, Flossverse, and FutureFleet — within the graph's broader topics of spatial computing, AI, and decentralised systems."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:knowhere-visitor-attention-system ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:dreamlab-creative-technology-collective ],
        ngm:infra-software-engineering ;
    skos:broader ngm:infra-software-engineering ;
    vc:bridgesTo ngm:trust-and-safety,
        ngm:venue-tethered-immersive-experience ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:dreamlab-creative-technology-collective,
        ngm:knowhere-visitor-attention-system ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:metaverse-and-telecollaboration,
        ngm:mixed-reality,
        ngm:nicve-virtual-reality-research-centre ;
    vc:slug "technical-history-extended-cv" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:hyper-personalisation,
        ngm:proprietary-large-language-models .

ngm:technical-robustness-and-safety a owl:Class ;
    rdfs:label "Technical Robustness and Safety"@en ;
    rdfs:comment "Technical Robustness and Safety is a core AI trustworthiness dimension that requires AI systems to perform reliably under varied and adversarial conditions, implement fallback mechanisms for graceful degradation, and maintain operational safety throughout their lifecycle. It encompasses resilience to adversarial attacks, accurate uncertainty quantification, comprehensive risk assessment, and incident response protocols mandated by frameworks such as the EU AI Act Article 15 and NIST AI RMF."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cybersecurity ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:risk-assessment ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:adversarial-attack ],
        ngm:ai-governance-and-ethics,
        ngm:ai-trustworthiness-dimensions ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:enables ngm:ai-safety,
        ngm:model-robustness,
        ngm:responsible-ai ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:ai-ethics,
        ngm:machine-learning-discipline ;
    vc:requires ngm:adversarial-attack,
        ngm:cybersecurity,
        ngm:risk-assessment ;
    vc:slug "technical-robustness-and-safety" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:ai-alignment,
        ngm:ai-regulation ;
    vc:uses ngm:data-poisoning,
        ngm:red-teaming .

ngm:technology-power-structure-visualisation a owl:Class ;
    rdfs:label "Technology Power Structure Visualisation"@en ;
    rdfs:comment "Calculating Empires is a large-scale research visualisation project by Kate Crawford and Vladan Joler that maps the co-evolution of technology and power structures from 1500 to the present. The work contextualises contemporary AI within five centuries of imperial infrastructure, surveillance, and control systems, foregrounding continuities between historical colonialism and digital power."@en ;
    rdfs:subClassOf ngm:infra-software-engineering ;
    skos:broader ngm:infra-software-engineering ;
    vc:bridgesTo ngm:digital-society-surveillance,
        ngm:education-and-ai ;
    vc:contrastsWith ngm:cyber-security-and-military ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:relatedTo ngm:ai-governance-law-and-privacy,
        ngm:artificial-intelligence ;
    vc:slug "technology-power-structure-visualisation" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:digital-rights .

ngm:tele-005-common-ground-theory a owl:Class ;
    rdfs:label "TELE-005-common-ground-theory"@en ;
    rdfs:comment "Common ground theory is an account of communication holding that participants build and rely on shared knowledge, beliefs and assumptions, which they update through interaction to coordinate meaning."@en ;
