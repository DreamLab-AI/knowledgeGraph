ngm:self-supervised-learning a owl:Class ;
    rdfs:label "Self-Supervised Learning"@en ;
    rdfs:comment "Self-Supervised Learning (SSL) is a machine learning paradigm in which a model learns rich representations of data by solving pretext tasks whose supervisory signal is derived automatically from the input data itself, requiring no human-provided labels. The model learns to predict masked or hidden portions of an input, to match different views of the same data, or to distinguish positive from negative data pairs, developing features that transfer effectively to downstream supervised tasks with limited labelled data. Self-supervised learning has become the dominant pre-training strategy for large language models, visual foundation models, and multimodal systems, enabling training at scales that would be infeasible with manually annotated datasets."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:contrastive-learning ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:masked-language-modelling ],
        ngm:machine-learning-discipline-technique ;
    vc:bridgesTo ngm:robotics-perception,
        ngm:spatial-ai ;
    vc:contrastsWith ngm:supervised-learning,
        ngm:unsupervised-learning ;
    vc:dependsOn ngm:data-augmentation,
        ngm:neural-network ;
    vc:enables ngm:large-scale-pretrained-foundation-model,
        ngm:parameter-efficient-fine-tuning,
        ngm:transfer-learning,
        ngm:zero-shot-learning ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:contrastive-learning,
        ngm:masked-image-modelling,
        ngm:masked-language-modelling ;
    vc:isPartOf ngm:representation-learning ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:generative-adversarial-network,
        ngm:multimodal-ai-architecture-learning,
        ngm:semi-supervised-learning ;
    vc:slug "self-supervised-learning" ;
    vc:sourceDomain "machine-learning" ;
    vc:supports ngm:computer-vision,
        ngm:deep-learning,
        ngm:natural-language-processing ;
    vc:uses ngm:encoder-decoder-architecture,
        ngm:pretrained-model,
        ngm:transformer-architecture .

ngm:sparql a owl:Class ;
    rdfs:label "SPARQL"@en ;
    rdfs:comment "SPARQL (SPARQL Protocol and RDF Query Language) is a W3C Recommendation defining a query language, update language, and HTTP-based protocol for retrieving and modifying data stored in RDF graph databases and Linked Data endpoints. SPARQL 1.1 (2013) introduced federated queries across multiple remote endpoints via the SERVICE keyword, property paths for graph traversal, aggregation functions, and the SPARQL Update (SPARUL) sublanguage for graph mutation. It serves as the standard access layer for the Semantic Web and knowledge graph ecosystems, occupying a role analogous to SQL for relational databases. The four primary query forms — SELECT, CONSTRUCT, ASK, and DESCRIBE — provide flexible mechanisms for retrieving variable bindings, materialising derived graphs, testing graph patterns, and describing resources."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:graph-database ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:rdf ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:sparql-endpoint ],
        ngm:infra-data-management ;
    skos:broader ngm:infra-data-management ;
    vc:bridgesTo ngm:knowledge-graph-embedding,
        ngm:large-language-model ;
    vc:contrastsWith ngm:cypher-query-language,
        ngm:graph-ql,
        ngm:sql ;
    vc:enables ngm:federated-query,
        ngm:knowledge-graph-construction,
        ngm:linked-data,
        ngm:ontology ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:implements ngm:open-world-assumption,
        ngm:semantic-web-linked-data-standard ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:apache-jena,
        ngm:json-data-interchange-format-ld,
        ngm:knowledge-graph,
        ngm:turtle ;
    vc:requires ngm:graph-database,
        ngm:rdf,
        ngm:sparql-endpoint ;
    vc:slug "sparql" ;
    vc:sourceDomain "data" ;
    vc:standardizedBy ngm:w3-c ;
    vc:supports ngm:owl-2-web-ontology-language,
        ngm:shacl,
        ngm:wikidata ;
    vc:uses ngm:graph-pattern-matching,
        ngm:http-protocol .

ngm:stable-diffusion-image-model a owl:Class ;
    rdfs:label "Stable Diffusion Image Model"@en ;
    rdfs:comment "Stable Diffusion is an open-source latent diffusion model developed by Stability AI in collaboration with CompVis and Runway, released in 2022, capable of generating high-quality images from text prompts. It operates in a compressed latent space rather than pixel space, dramatically reducing computational requirements compared to earlier diffusion models. The model supports text-to-image, image-to-image, and inpainting tasks, and has become the foundation for a large ecosystem of fine-tuned variants and extension tools."@en ;
    rdfs:subClassOf ngm:diffusion-model ;
    vc:contrastsWith ngm:diffusion-models ;
    vc:dependsOn ngm:model-training,
        ngm:open-source-software ;
