        ngm:upscaling ;
    vc:uses ngm:clip,
        ngm:latent-diffusion,
        ngm:lora-fine-tuning,
        ngm:node-graph,
        ngm:noise-schedule,
        ngm:stable-diffusion,
        ngm:vae .

ngm:common-pool-resources a owl:Class ;
    rdfs:label "Common Pool Resources"@en ;
    rdfs:comment "Natural or human-made resources that are non-excludable to a defined community but rival in consumption, meaning one actor's use diminishes availability for others. Classic examples include fisheries, groundwater, pastures, and shared spectrum; digital analogues include shared compute pools and open training datasets. Sustainable governance requires institutions that constrain extraction without full privatisation or state control."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:polycentric-governance ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:collective-governance ],
        ngm:resource-management ;
    vc:enables ngm:community-governance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:collective-action,
        ngm:property-rights,
        ngm:public-goods-funding ;
    vc:requires ngm:collective-governance,
        ngm:polycentric-governance ;
    vc:slug "common-pool-resources" ;
    vc:sourceDomain "governance" .

ngm:consensus-rule a owl:Class ;
    rdfs:label "Consensus Rule"@en ;
    rdfs:comment "A Consensus Rule is a protocol-level validation requirement that every fully-validating node in a blockchain network must enforce uniformly to reach and maintain agreement on the canonical chain state. Consensus rules define which blocks and transactions are valid, covering aspects such as block structure, cryptographic proofs, transaction format, gas limits, and state-transition logic. Deviation from consensus rules — whether accidental or deliberate — results in a fork, splitting the network into incompatible chains."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:distributed-ledger ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:consensus-mechanism ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:fork-choice-rule ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:blockchain-network ],
        ngm:bc-protocol-and-consensus,
        ngm:blockchain-entity,
        ngm:consensus-protocol ;
    skos:broader ngm:bc-protocol-and-consensus ;
    vc:contrastsWith ngm:governance-model ;
    vc:enables ngm:blockchain-governance,
        ngm:finality,
        ngm:smart-contract ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:fork-choice-rule ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:51-attack,
        ngm:blockchain,
