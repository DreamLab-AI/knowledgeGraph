        ngm:token-standard,
        ngm:tokenomics ;
    vc:requires ngm:blockchain-transaction,
        ngm:consensus-mechanism,
        ngm:smart-contract ;
    vc:slug "fungible-token" ;
    vc:sourceDomain "blockchain" ;
    vc:standardizedBy ngm:ethereum-improvement-proposal ;
    vc:supports ngm:decentralised-finance,
        ngm:initial-coin-offering,
        ngm:stablecoin ;
    vc:uses ngm:public-key-cryptography,
        ngm:wallet .

ngm:graph-neural-network a owl:Class ;
    rdfs:label "Graph Neural Network"@en ;
    rdfs:comment "A Graph Neural Network (GNN) is a deep learning architecture that operates directly on graph-structured data by iteratively propagating and aggregating feature information across node neighbourhoods. GNNs generalise convolutional and attention mechanisms to non-Euclidean domains, learning node, edge, and graph-level representations suitable for tasks including node classification, link prediction, and graph classification across domains such as knowledge graphs, social networks, molecular modelling, and recommendation systems."@en ;
    rdfs:subClassOf ngm:neural-network ;
    vc:bridgesTo ngm:fraud-detection,
        ngm:knowledge-graphing,
        ngm:semantic-web-linked-data-standard ;
    vc:contrastsWith ngm:convolutional-neural-network,
        ngm:recurrent-neural-network ;
    vc:dependsOn ngm:backpropagation,
        ngm:gradient-descent ;
    vc:enables ngm:anomaly-detection,
        ngm:graph-classification,
        ngm:link-prediction,
        ngm:node-classification,
        ngm:recommendation-system,
        ngm:retrieval-augmented-generation ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:graph-attention-network,
        ngm:graph-convolutional-network ;
    vc:implements ngm:message-passing-neural-network,
