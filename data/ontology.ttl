    vc:slug "granular-consent-control" ;
    vc:sourceDomain "spatial-computing" .

ngm:graph-rag a owl:Class ;
    rdfs:label "GraphRAG"@en ;
    rdfs:comment "GraphRAG (Graph Retrieval-Augmented Generation) is an architecture that extends standard retrieval-augmented generation by structuring the indexed knowledge corpus as a knowledge graph of entities and relationships rather than as a flat collection of text chunks, enabling the retrieval system to answer questions that require multi-hop reasoning over connected facts — such as 'what do entities A and B have in common' — which naive vector similarity search over disconnected chunks cannot reliably resolve. Microsoft Research's GraphRAG implementation, open-sourced in 2024, uses an LLM to extract entity-relationship triples from a document corpus, builds a community-detected hierarchical graph, generates community summaries at multiple granularities, and retrieves relevant subgraphs and summaries at query time to ground the LLM's response in structured relational context."@en ;
    rdfs:subClassOf ngm:retrieval-augmented-generation ;
    vc:enables ngm:ontology-in-llm-operations ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:graph-database,
        ngm:graph-neural-network,
        ngm:knowledge-graph,
        ngm:knowledge-graph-construction,
        ngm:ontology ;
    vc:slug "graph-rag" ;
    vc:sourceDomain "ai" ;
    vc:supports ngm:semantic-web ;
    vc:uses ngm:knowledge-base,
        ngm:large-language-models .

ngm:graph-representation a owl:Class ;
    rdfs:label "Graph Representation"@en ;
    rdfs:comment "Graph representation is the encoding of a problem domain as a set of nodes (vertices) connected by edges, capturing entities and the relationships between them. It enables algorithmic reasoning over connectivity, distance, and structure, and underpins pathfinding, routing, and topological analysis. Common concrete forms include adjacency matrices, adjacency lists, and edge lists."@en ;
    rdfs:subClassOf ngm:distributed-data-structure ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:dijkstra-algorithm,
        ngm:topological-map ;
    vc:slug "graph-representation" ;
    vc:sourceDomain "data" .

ngm:graphical-model a owl:Class ;
    rdfs:label "Graphical Model"@en ;
    rdfs:comment "A graphical model is a probabilistic model that expresses the conditional dependence structure among random variables as a graph, where nodes are variables and edges encode statistical relationships. Bayesian networks use directed acyclic graphs while Markov random fields use undirected graphs, both enabling compact representation of joint distributions. They support efficient inference and learning by exploiting conditional independence."@en ;
    rdfs:subClassOf ngm:machine-learning ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:probabilistic-model ;
    vc:slug "graphical-model" ;
    vc:sourceDomain "ai" .

ngm:green-mining-pool a owl:Class ;
    rdfs:label "Green Mining Pool"@en ;
    rdfs:comment "A green mining pool is a cooperative of cryptocurrency miners that aggregates hashing power while sourcing electricity predominantly from renewable or low-carbon generation, often coupling mining to surplus or curtailed grid energy. It rewards participants for verified sustainable energy use and reports the carbon intensity of the pooled hashrate. The model aims to reduce the environmental footprint of proof-of-work consensus."@en ;
    rdfs:subClassOf ngm:bc-network-component ;
    skos:broader ngm:bc-network-component ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:green-blockchain-initiatives,
        ngm:sustainable-bitcoin-protocol ;
    vc:slug "green-mining-pool" ;
    vc:sourceDomain "blockchain" .

ngm:grid-infrastructure a owl:Class ;
    rdfs:label "Grid Infrastructure"@en ;
    rdfs:comment "Grid infrastructure is the physical and control system of generation, transmission, distribution, and balancing assets that delivers electrical power from sources to consumers. It includes substations, transmission lines, transformers, and increasingly digital control layers for monitoring and demand response. Reliable grid infrastructure is a prerequisite for energy-intensive computing, mining, and data-centre operations."@en ;
    rdfs:subClassOf ngm:digital-infrastructure ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:energy-and-power ;
    vc:slug "grid-infrastructure" ;
    vc:sourceDomain "infrastructure" .

ngm:grouped-query-attention a owl:Class ;
    rdfs:label "Grouped Query Attention"@en ;
    rdfs:comment "Grouped Query Attention (GQA) is a transformer attention variant that partitions the set of query heads into G groups, each group sharing a single pair of key and value heads, thereby interpolating between Multi-Head Attention (MHA, where each query head has its own KV head) and Multi-Query Attention (MQA, where all query heads share one KV head). GQA reduces the key-value cache memory footprint during autoregressive inference—proportionally to the number of groups—while preserving model quality closer to MHA than MQA. It has been adopted in production LLMs including Llama 2, Mistral, and Gemma."@en ;
    rdfs:subClassOf ngm:ai-model-architecture ;
    skos:broader ngm:ai-model-architecture ;
    vc:contrastsWith ngm:flash-attention,
        ngm:multi-head-attention ;
    vc:enables ngm:inference,
        ngm:speculative-decoding ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:slug "grouped-query-attention" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:attention-mechanism,
        ngm:transformer-architecture .

ngm:gs-1-standards a owl:Class ;
    rdfs:label "GS1 Standards"@en ;
    rdfs:comment "GS1 standards are a global system of identification keys, barcodes and data formats that uniquely identify products, locations and assets across supply chains."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
