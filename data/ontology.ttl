    vc:requires ngm:action-space,
        ngm:markov-chain,
        ngm:probability-theory,
        ngm:reward-function,
        ngm:state-space ;
    vc:slug "markov-decision-process" ;
    vc:sourceDomain "machine-learning" ;
    vc:uses ngm:bellman-equation,
