ngm:json-data-interchange-format-rpc a owl:Class ;
    rdfs:label "JSON-RPC"@en ;
    rdfs:comment "JSON-RPC is a lightweight, stateless, transport-agnostic remote procedure call (RPC) protocol that encodes method invocations and their responses as JSON objects. The JSON-RPC 2.0 specification, finalised in 2013, defines a minimal request envelope comprising a jsonrpc version field, a method name, an optional params argument (array or object), and a correlation id; the response carries either a result or a structured error object. The protocol operates over any byte-stream transport — HTTP, WebSocket, TCP, Unix domain sockets, or stdin/stdout — making it uniquely portable across networked and embedded contexts. It underpins foundational cross-domain infrastructure including the Ethereum node API, the Language Server Protocol, and the Model Context Protocol used for AI tool-calling."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:json-data-interchange-format ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:push-notification ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:network-transport ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:batch-processing ],
        ngm:infra-software-engineering ;
    skos:broader ngm:infra-software-engineering ;
    vc:bridgesTo ngm:ai-infrastructure,
        ngm:blockchain-infrastructure ;
    vc:contrastsWith ngm:g-rpc,
        ngm:graph-ql,
        ngm:rest-api,
        ngm:soap ;
    vc:enables ngm:distributed-computing,
        ngm:function-calling,
        ngm:tool-use ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:batch-processing,
        ngm:push-notification ;
    vc:implements ngm:client-server-architecture,
        ngm:request-response-pattern ;
    vc:isPartOf ngm:api-standard,
        ngm:remote-procedure-call ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:inter-process-communication,
        ngm:message-passing,
        ngm:microservices,
        ngm:smart-contract ;
    vc:requires ngm:json-data-interchange-format,
        ngm:network-transport ;
    vc:slug "json-rpc" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:ethereum,
        ngm:language-server-protocol,
        ngm:model-context-protocol ;
    vc:uses ngm:http,
        ngm:json-data-interchange-format,
        ngm:websocket .

ngm:key-generation a owl:Class ;
    rdfs:label "Key Generation"@en ;
    rdfs:comment "Key generation is the cryptographic process of creating the keys used by symmetric and asymmetric algorithms, deriving them from high-quality randomness so that they are unpredictable to an adversary. For symmetric schemes it produces a single secret value, while for public-key schemes it produces a mathematically linked private and public key pair. The security of every downstream cryptographic operation rests on the entropy and correctness of this step."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:entropy ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:key-derivation-function ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:random-number-generation ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:random-number-generation ],
        ngm:cryptographic-key-management ;
    vc:dependsOn ngm:entropy,
        ngm:random-number-generation ;
    vc:enables ngm:digital-signature,
        ngm:encryption,
        ngm:key-exchange ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:entropy,
        ngm:key-derivation-function,
        ngm:random-number-generation ;
    vc:isPartOf ngm:cryptographic-key-management,
        ngm:public-key-infrastructure ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:cryptography,
        ngm:private-key,
        ngm:public-key ;
    vc:requires ngm:random-number-generation ;
    vc:slug "key-generation" ;
    vc:sourceDomain "security" ;
    vc:supports ngm:public-key-cryptography,
        ngm:symmetric-encryption ;
    vc:uses ngm:elliptic-curve-cryptography,
        ngm:hardware-security-module .

ngm:linux-foundation a owl:Class ;
    rdfs:label "Linux Foundation"@en ;
    rdfs:comment "The Linux Foundation is a non-profit technology consortium established in 2000 that provides governance, infrastructure, legal frameworks, and community support for open-source software projects of global significance. It hosts the Linux kernel project alongside hundreds of collaborative projects spanning cloud-native computing (CNCF, Kubernetes), networking, security, blockchain (Hyperledger), AI (LF AI & Data), automotive, and open standards development. The Linux Foundation operates a neutral shared governance model in which competing commercial organisations collaborate on foundational technology layers, pooling resources to reduce duplicated effort and accelerating adoption of interoperable open standards. Its project portfolio collectively represents some of the most widely deployed software infrastructure in the world."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:hyperledger-foundation ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:cncf ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:kubernetes ],
        ngm:standards-body ;
    vc:bridgesTo ngm:ai-governance,
        ngm:cloud-native,
        ngm:enterprise-blockchain ;
    vc:contrastsWith ngm:apache-software-foundation,
        ngm:eclipse-foundation ;
    vc:enables ngm:collaborative-software-development,
        ngm:open-source-development,
        ngm:open-standard,
        ngm:technical-standard,
        ngm:vendor-neutral-governance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:cncf,
        ngm:hyperledger-foundation,
        ngm:kubernetes,
        ngm:lf-ai-data-foundation,
        ngm:lf-edge,
        ngm:lf-energy,
        ngm:openssf ;
    vc:implements ngm:contributor-license-agreement,
        ngm:ip-stewardship ;
    vc:isPartOf ngm:open-source ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:free-standards-group,
        ngm:open-source-development-labs,
        ngm:open-source-software,
        ngm:standardization-bodies ;
    vc:slug "linux-foundation" ;
    vc:sourceDomain "governance" ;
    vc:standardizedBy ngm:open-source-ai-definition ;
    vc:supports ngm:linux-kernel,
        ngm:onnx,
        ngm:open-source-security,
        ngm:python-pytorch-deep-learning-stack .

ngm:liquid-democracy a owl:Class ;
    rdfs:label "Liquid Democracy"@en ;
    rdfs:comment "Liquid democracy is a hybrid participatory governance model that synthesises direct democracy and representative democracy by permitting each participant either to cast their vote on a proposal directly or to delegate their voting weight transitively to a trusted proxy, who may in turn re-delegate to another agent, forming an arbitrarily deep delegation chain. Delegations are revocable at any point before a proposal closes, preserving individual sovereignty over the vote. In distributed-systems and blockchain governance contexts the model is implemented via smart-contract delegation registries and off-chain signalling layers, enabling token holders or identity-verified citizens to assign on-chain voting power to domain experts while retaining the right to override on any individual proposal."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:identity-verification ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:sybil-resistance ],
        ngm:bc-governance-and-regulation ;
    skos:broader ngm:bc-governance-and-regulation ;
    vc:bridgesTo ngm:collective-intelligence,
        ngm:multi-agent-systems ;
    vc:contrastsWith ngm:conviction-voting,
        ngm:direct-democracy,
        ngm:quadratic-voting,
        ngm:representative-democracy ;
    vc:dependsOn ngm:erc-20-votes,
        ngm:token-weighted-voting ;
    vc:enables ngm:dao-governance,
        ngm:delegate-democracy,
        ngm:on-chain-governance ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:decentralised-autonomous-organisation,
        ngm:futarchy,
        ngm:holographic-consensus,
        ngm:snapshot-governance ;
    vc:requires ngm:identity-verification,
        ngm:sybil-resistance ;
    vc:slug "liquid-democracy" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:governance-token,
        ngm:smart-contract,
        ngm:voting-mechanism .

