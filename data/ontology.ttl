        ngm:w3-c-did-method ;
    vc:slug "did-nostr-identity" ;
    vc:sourceDomain "blockchain" .

ngm:digital-asset-market a owl:Class ;
    rdfs:label "Digital Asset Market"@en ;
    rdfs:comment "A marketplace — centralised or decentralised — where digital assets including cryptocurrencies, NFTs, and tokenised securities are bought, sold, and exchanged. Digital asset markets encompass order-book exchanges, automated market makers, NFT marketplaces, and OTC desks, each governed by distinct liquidity, pricing, and regulatory mechanisms."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:blockchain ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:digital-asset-trading ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:digital-asset-infrastructure ],
        [ a owl:Restriction ;
