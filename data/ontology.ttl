        ngm:graph-theory,
        ngm:information-theory,
        ngm:quantum-computation-paradigm ;
    vc:enables ngm:computer-vision,
        ngm:dimensionality-reduction,
        ngm:machine-learning-discipline,
        ngm:neural-network,
        ngm:principal-component-analysis,
        ngm:regression ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:singular-value-decomposition,
        ngm:tensor ;
