    rdfs:comment "Whisper is an automatic speech recognition model from OpenAI trained on a large multilingual dataset. It transcribes and translates speech across many languages and is released as open source."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:attention-mechanism ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:transformer ],
        ngm:automatic-speech-recognition ;
    vc:enables ngm:speech-recognition,
        ngm:translation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:attention-mechanism,
        ngm:transformer ;
    vc:slug "whisper" ;
    vc:sourceDomain "natural-language-processing" .

