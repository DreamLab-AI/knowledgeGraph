ngm:technical-architecture a owl:Class ;
    rdfs:label "Technical Architecture"@en ;
    rdfs:comment "Technical Architecture is the structured design of a system's components, their relationships, and the principles governing their evolution. It defines how hardware, software, data, and communication elements are organised to satisfy functional and non-functional requirements within a spatial computing or platform context."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:computing-infrastructure ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
