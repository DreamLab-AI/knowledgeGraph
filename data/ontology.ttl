ngm:change-management a owl:Class ;
    rdfs:label "Change Management"@en ;
    rdfs:comment "Change Management is the structured discipline of guiding organisations, teams, and individuals through transitions in technology, process, or culture to achieve desired outcomes whilst minimising disruption and resistance. It encompasses planning, communication, training, stakeholder alignment, and feedback loops that collectively ensure adoption of new working methods. In technology contexts it also covers the formal control of modifications to systems and infrastructure to reduce risk. Effective change management is widely recognised as a critical determinant of whether digital transformation initiatives deliver their intended value."@en ;
    rdfs:subClassOf ngm:ai-governance-framework ;
    vc:enables ngm:ai-adoption,
        ngm:workforce-development ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:digital-transformation,
        ngm:human-factors,
        ngm:stakeholder-engagement ;
    vc:slug "change-management" ;
    vc:sourceDomain "governance" ;
    vc:uses ngm:audit-trail,
        ngm:compliance-monitoring,
        ngm:risk-assessment .

ngm:character-model a owl:Class ;
    rdfs:label "Character Model"@en ;
    rdfs:comment "A 3D digital representation of a character consisting of a polygonal mesh, textures, and materials, designed with clean topology optimized for animation and real-time rendering, serving as the foundation for rigging, skinning, and character animation workflows."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:3-d-modeling-software ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:texture-mapping ],
        ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:enables ngm:character-animation,
        ngm:game-characters,
        ngm:virtual-avatars ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:3-d-modeling-software,
        ngm:texture-mapping,
        ngm:topology-design ;
    vc:slug "character-model" ;
    vc:sourceDomain "spatial-computing" .

ngm:collective-decision-making a owl:Class ;
    rdfs:label "Collective Decision Making"@en ;
    rdfs:comment "Collective decision making is the social and technical process by which a group of agents — human, algorithmic, or hybrid — aggregate individual preferences, information, or votes to arrive at a binding or advisory choice on behalf of the group. It encompasses the design and analysis of voting systems, preference aggregation mechanisms, deliberation protocols, and incentive structures that determine how group choices are reached and enforced. In digital and blockchain contexts, collective decision making is formalised through on-chain governance mechanisms, decentralised autonomous organisations, and algorithmic voting schemes that encode group agency in smart contract logic."@en ;
    rdfs:subClassOf ngm:decentralised-decision-making ;
    vc:enables ngm:community-governance,
        ngm:dao-governance,
        ngm:on-chain-governance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:collective-intelligence-system,
        ngm:governance-token ;
    vc:slug "collective-decision-making" ;
    vc:sourceDomain "governance" ;
    vc:uses ngm:conviction-voting,
        ngm:quadratic-voting,
        ngm:token-weighted-voting,
        ngm:voting-mechanism .

ngm:confusion-matrix a owl:Class ;
    rdfs:label "Confusion Matrix"@en ;
    rdfs:comment "A tabular visualisation and analytical tool summarising the performance of a classification model by displaying the counts or proportions of predictions cross-tabulated against actual class labels, typically organised with predicted classes as columns and actual classes as rows (or vice versa), e..."@en ;
    rdfs:subClassOf ngm:evaluation-metric,
        ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
