ngm:trust a owl:Class ;
    rdfs:label "Trust"@en ;
    rdfs:comment "Trust is a cognitive, relational, and institutional disposition in which an agent accepts vulnerability to the actions of another party based on a positive expectation that the trusted party will act competently, honestly, and benevolently toward the trusting party's interests. In sociotechnical and AI contexts, trust extends beyond interpersonal relationships to encompass institutional trust in organisations, systems trust in technological artefacts, and algorithmic trust in AI decision-making processes. Trust is simultaneously a psychological state, a social institution, and a design property of engineered systems; its calibration — whether systems are trusted appropriately, excessively, or insufficiently — carries profound implications for human welfare, democratic function, and the responsible deployment of AI. Across distributed and decentralised architectures, trust is increasingly operationalised via cryptographic attestation, verifiable credentials, and reputation mechanisms that replace reliance on a single central authority."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:transparency ],
        ngm:social-contract ;
    vc:bridgesTo ngm:decentralised-identity,
        ngm:explainability,
        ngm:verifiable-credentials ;
    vc:contrastsWith ngm:automation-bias,
        ngm:distrust,
        ngm:zero-trust-architecture ;
    vc:dependsOn ngm:authentication,
        ngm:identity ;
    vc:enables ngm:cooperation,
        ngm:delegation,
        ngm:trust-establishment,
        ngm:trust-infrastructure,
        ngm:trust-score-metric ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:accountability,
        ngm:ai-trustworthiness,
        ngm:legitimacy,
        ngm:reputation,
        ngm:trust-and-safety,
        ngm:trust-architecture ;
    vc:requires ngm:integrity,
        ngm:transparency,
        ngm:verifiability ;
    vc:slug "trust" ;
    vc:sourceDomain "governance" ;
    vc:standardizedBy ngm:eu-ai-act,
        ngm:iso-iec-42001,
        ngm:nist-ai-rmf ;
    vc:supports ngm:ai-trust-risk-and-security-management,
        ngm:governance,
        ngm:human-ai-collaboration,
        ngm:trust-in-automation,
        ngm:trust-over-ip-foundation .

ngm:video-generation a owl:Class ;
    rdfs:label "Video Generation"@en ;
    rdfs:comment "Video generation is the AI-driven synthesis of temporally coherent video sequences from text prompts, reference images, or other conditioning signals using generative models such as latent diffusion, autoregressive transformers, or flow-matching networks. Unlike image generation, video synthesis must maintain temporal consistency across frames, model object trajectories and camera motion, and produce physically plausible dynamics across variable-length sequences. Contemporary approaches encode video into a compressed spatiotemporal latent space via a 3D variational autoencoder, apply a diffusion or flow-matching process in that space conditioned on text or visual embeddings, then decode to pixel space. Scaling laws, large curated training datasets, and architectural advances such as full spatiotemporal attention have driven rapid capability growth, enabling cinematic-quality outputs at multiple seconds of duration."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:text-encoder ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:diffusion-model ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gpu-compute ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:classifier-free-guidance ],
        ngm:generative-ai ;
    vc:bridgesTo ngm:metaverse-content,
        ngm:virtual-production ;
    vc:contrastsWith ngm:deepfake-detection,
        ngm:image-generation ;
    vc:dependsOn ngm:clip,
        ngm:flow-matching,
        ngm:latent-diffusion,
        ngm:transformer-architecture ;
    vc:enables ngm:autonomous-driving-simulation,
        ngm:content-creation,
        ngm:film-previzualisation,
        ngm:synthetic-media ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:classifier-free-guidance,
        ngm:motion-estimation,
        ngm:temporal-attention,
        ngm:video-vae ;
    vc:isPartOf ngm:generative-ai,
        ngm:multimodal-ai ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:neural-rendering,
        ngm:video-understanding,
        ngm:world-model ;
    vc:requires ngm:diffusion-model,
        ngm:gpu-compute,
        ngm:large-scale-training-data,
        ngm:text-encoder ;
    vc:slug "video-generation" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:3d-convolution,
        ngm:cross-attention,
        ngm:optical-flow,
        ngm:variational-autoencoder .

ngm:xr-hardware a owl:Class ;
    rdfs:label "XR Hardware"@en ;
    rdfs:comment "XR Hardware comprises the physical computing and sensing devices — including head-mounted displays, spatial computing headsets, hand-tracking controllers, haptic peripherals, and body-worn sensors — that enable augmented, mixed, and virtual reality experiences across the extended reality spectrum. These devices integrate high-resolution micro-display optics, inertial measurement units, inside-out positional tracking cameras, and wireless connectivity stacks to deliver low-latency immersive spatial content. Modern XR hardware increasingly embeds dedicated neural processing units for on-device spatial AI inference, eye-tracking modules for foveated rendering, and environmental depth sensors for real-time world reconstruction. The category spans standalone untethered headsets, tethered PC-class systems, and lightweight optical see-through spectacles optimised for always-on wearability."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:inertial-measurement-unit ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:wireless-connectivity ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:eye-tracking ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:head-mounted-display ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:haptic-feedback ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:depth-sensing ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:real-time-rendering ],
        ngm:spatial-computing ;
    skos:broader ngm:spatial-computing ;
    vc:bridgesTo ngm:digital-twin,
        ngm:edge-ai-inference ;
    vc:contrastsWith ngm:desktop-computing,
        ngm:flat-panel-display ;
    vc:enables ngm:augmented-reality,
        ngm:foveated-rendering,
        ngm:mixed-reality,
        ngm:spatial-presence,
        ngm:virtual-reality ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:depth-sensing,
        ngm:eye-tracking,
        ngm:haptic-feedback,
        ngm:head-mounted-display,
        ngm:inertial-measurement-unit ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:display-and-rendering,
        ngm:human-computer-interaction,
        ngm:wearable-computing ;
    vc:requires ngm:real-time-rendering,
        ngm:wireless-connectivity,
        ngm:xr-software-platform ;
    vc:slug "xr-hardware" ;
    vc:sourceDomain "spatial-computing" ;
    vc:standardizedBy ngm:khronos-group,
        ngm:openxr ;
    vc:supports ngm:hand-tracking,
        ngm:passthrough-video,
        ngm:spatial-audio ;
    vc:uses ngm:inside-out-tracking,
        ngm:neural-processing-unit,
        ngm:simultaneous-localisation-and-mapping,
        ngm:spatial-computing .

