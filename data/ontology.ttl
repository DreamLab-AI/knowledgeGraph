        ngm:ontology ;
    vc:slug "some-legacy-linked-json" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:rdf,
        ngm:semantic-web .

ngm:sovereign-keyset a owl:Class ;
    rdfs:label "Sovereign Keyset"@en ;
    rdfs:comment "The cryptographic key material (BIP-340 Schnorr Keypair|BIP-340 Schnorr keypair) held securely by each VisionClaw Agentic Container|VisionClaw agent, used to prove identity via DID Nostr Identity|did:nostr DIDs, sign Verifiable Credential Surface|verifiable credentials, authentica..."@en ;
