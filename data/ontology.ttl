    vc:slug "informed-search" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:machine-learning-technique .

ngm:input a owl:Class ;
    rdfs:label "Input"@en ;
    rdfs:comment "In the UTXO blockchain model, an Input is a reference to a previous unspent transaction output that is being consumed to fund a new transaction. Each input includes a pointer to the referenced output, a cryptographic signature proving ownership, and an unlocking script that satisfies the output's locking conditions."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptographic-keys ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:digital-signature ],
        ngm:bc-protocol-and-consensus,
        ngm:blockchain-entity,
        ngm:distributed-data-structure ;
    skos:broader ngm:bc-protocol-and-consensus ;
    vc:contrastsWith ngm:account-model ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:transaction ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:blockchain-transaction,
        ngm:double-spending,
        ngm:output,
        ngm:transaction-fee,
        ngm:utxo-model ;
    vc:requires ngm:cryptographic-keys,
        ngm:digital-signature ;
    vc:slug "input" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:cryptographic-signature,
        ngm:merkle-proof .

ngm:installation-and-display-tech a owl:Class ;
    rdfs:label "Installation and display tech"@en ;
    rdfs:comment "The hardware and software infrastructure used to install, calibrate, and drive immersive visual displays in XR, digital signage, and spatial computing contexts. This encompasses projection mapping, light-field displays, LED walls, head-mounted display optics, and the rendering pipelines that feed them."@en ;
