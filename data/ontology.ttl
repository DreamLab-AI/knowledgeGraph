ngm:toxicity-detection a owl:Class ;
    rdfs:label "Toxicity Detection"@en ;
    rdfs:comment "Toxicity Detection is a machine learning discipline that automatically identifies harmful, abusive, or offensive language in user-generated content, typically using classifiers trained on annotated corpora of hate speech, threats, and harassment. It forms a core component of content moderation pipelines and operates at scale across social platforms, forums, and messaging systems. Toxicity detection systems must balance recall against false-positive rates to avoid over-censorship while protecting users from harm."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:natural-language-processing ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:machine-learning-model ],
        ngm:ai-application,
        ngm:content-moderation ;
    skos:broader ngm:ai-application ;
    vc:enables ngm:ai-safety,
        ngm:content-moderation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:adversarial-robustness,
        ngm:bias-detection-methods,
        ngm:red-teaming ;
    vc:requires ngm:machine-learning-model,
        ngm:natural-language-processing ;
    vc:slug "toxicity-detection" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:ai-governance-and-ethics ;
    vc:uses ngm:deep-learning,
        ngm:large-language-models,
        ngm:sentiment-analysis .

ngm:tracked-robot a owl:Class ;
    rdfs:label "Tracked Robot"@en ;
    rdfs:comment "A Tracked Robot is a ground mobile robot that uses continuous loop tracks—analogous to those on military tanks—rather than wheels to achieve locomotion. The large contact surface area of the track distributes the robot's weight, providing superior traction and stability on uneven, soft, or obstacle-dense terrain such as rubble, mud, stairs, and gravel. Tracked robots are widely deployed in search-and-rescue, military reconnaissance, inspection, and agricultural automation where wheeled platforms would lose grip or become immobilised."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:lidar ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:path-planning ],
        ngm:ground-robot ;
    vc:contrastsWith ngm:legged-robot,
        ngm:wheeled-robot ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:lidar ;
    vc:isPartOf ngm:robotics ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:inspection-robot,
        ngm:mobile-robot,
        ngm:rescue-robot ;
    vc:requires ngm:path-planning ;
    vc:slug "tracked-robot" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:motion-planning,
        ngm:perception-system,
        ngm:slam .

ngm:training-for-design-practitioners a owl:Class ;
    rdfs:label "Training for Design Practitioners"@en ;
    rdfs:comment "Training for Design Practitioners covers structured programmes and self-directed learning pathways that equip designers—particularly in landscape, product, and spatial disciplines—with practical AI literacy, covering generative image tools, RAG-based knowledge management, client communication automation, and AI-assisted rendering workflows for immediate professional application."@en ;
