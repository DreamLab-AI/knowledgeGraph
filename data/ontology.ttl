    vc:slug "authentication-service" ;
    vc:sourceDomain "infrastructure" .

ngm:camera a owl:Class ;
    rdfs:label "Camera"@en ;
    rdfs:comment "An imaging sensor device that captures visual information in robotics systems, enabling computer vision applications including object detection, SLAM, 3D reconstruction, visual servoing, and semantic scene understanding through various modalities (RGB, depth, thermal, event-based) and technologie..."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:camera-calibration ],
        ngm:robo-perception,
        ngm:sensor,
        ngm:visual-perception ;
    skos:broader ngm:robo-perception ;
    vc:enables ngm:3-d-reconstruction,
        ngm:object-detection,
        ngm:semantic-segmentation,
