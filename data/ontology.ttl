ngm:foundation-model a owl:Class ;
    rdfs:label "Foundation Model"@en ;
    rdfs:comment "A Foundation Model is a large-scale machine learning model trained on broad, diverse datasets using self-supervised or semi-supervised objectives, producing a general-purpose parametric representation that can be adapted to a wide range of downstream tasks through fine-tuning, prompting, or retrieval augmentation without retraining from scratch. Introduced as a conceptual category by the Stanford HAI Centre for Research on Foundation Models in 2021, the term emphasises the homogenising role such models play across AI research and application domains: a single pre-trained artefact serves as the foundation for specialised systems in natural language processing, computer vision, speech, multimodal reasoning, scientific discovery, and robotics. Foundation models are characterised by emergent capabilities that arise from scale — properties not present in smaller models that appear as parameter count and training-data volume increase — and by their fundamentally transferable representations, which dramatically lower the cost of building capable task-specific systems. The category encompasses large language models, vision-language models, diffusion models, and cross-modal architectures such as GPT-4, BERT, DALL-E, Stable Diffusion, and Segment Anything."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:training-data ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:pre-training ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:transformer-architecture ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gpu-compute ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:neural-network ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:self-supervised-learning ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:context-window ],
        ngm:machine-learning-discipline-model ;
    vc:bridgesTo ngm:ai-alignment,
        ngm:compute-governance,
        ngm:generative-ai ;
    vc:contrastsWith ngm:narrow-ai,
        ngm:task-specific-model ;
    vc:dependsOn ngm:deep-learning,
        ngm:large-language-model-training,
        ngm:transfer-learning ;
    vc:enables ngm:emergent-capabilities,
        ngm:few-shot-learning,
        ngm:in-context-learning,
        ngm:instruction-tuning,
        ngm:retrieval-augmented-generation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:context-window,
        ngm:neural-network,
        ngm:pre-training,
        ngm:transformer-architecture ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:ai-safety,
        ngm:benchmark-evaluation,
        ngm:diffusion-model,
        ngm:large-language-models,
        ngm:multimodal-ai-architecture-models ;
    vc:requires ngm:gpu-compute,
        ngm:self-supervised-learning,
        ngm:training-data ;
    vc:slug "foundation-model" ;
    vc:sourceDomain "ai" ;
    vc:supports ngm:agentic-workflow,
        ngm:multimodal-ai-architecture-ai,
        ngm:prompt-engineering ;
    vc:uses ngm:domain-adaptation,
        ngm:lo-ra-fine-tuning,
        ngm:rlhf .

ngm:generative-model a owl:Class ;
    rdfs:label "Generative Model"@en ;
    rdfs:comment "A class of machine learning models that learn the underlying probability distribution of training data and can sample novel instances from that distribution. Architectures include generative adversarial networks, variational autoencoders, diffusion models, normalising flows, and autoregressive transformers, covering domains such as text, image, audio, and code generation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
