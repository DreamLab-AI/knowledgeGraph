    vc:uses ngm:knowledge-representation,
        ngm:ontology .

ngm:conceptual-layer a owl:Class ;
    rdfs:label "Conceptual Layer"@en ;
    rdfs:comment "The Conceptual Layer represents the highest abstraction level in an ontological classification system, encompassing pure concepts, theoretical models, design principles, and logical frameworks that are independent of specific technical implementations. Concepts at this layer can be realised through multiple concrete approaches while retaining their essential semantic properties."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:ontology-structure ],
