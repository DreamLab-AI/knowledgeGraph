ngm:explainability-oecd a owl:Class ;
    rdfs:label "Explainability (OECD)"@en ;
    rdfs:comment "The OECD AI Principle (1.3) requiring that people affected by AI-based outcomes are able to understand how and why particular decisions or recommendations were reached. Explanations must be contextually appropriate, enable meaningful contestation, and illuminate causal factors—operationalised through LIME, SHAP, attention visualisation, and inherently interpretable model architectures."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ai-regulation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:human-in-the-loop ],
        ngm:ai-governance-and-ethics ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:contrastsWith ngm:ai-ethics ;
    vc:enables ngm:ai-safety ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:accountability-oecd,
        ngm:fairness-oecd,
        ngm:human-centred-values ;
    vc:requires ngm:ai-regulation,
        ngm:human-in-the-loop ;
    vc:slug "explainability-oecd" ;
    vc:sourceDomain "artificial-intelligence" .

