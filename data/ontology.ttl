        ngm:collision-avoidance,
        ngm:obstacle-avoidance,
        ngm:social-robotics ;
    vc:requires ngm:motion-planning,
        ngm:path-planning,
        ngm:proxemics ;
    vc:slug "social-navigation" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:reinforcement-learning,
        ngm:sensor-fusion,
        ngm:slam .

ngm:solar-pv-installation-engineering-plan a owl:Class ;
    rdfs:label "Solar PV Installation Engineering Plan"@en ;
    rdfs:comment "Solar plans are engineered configurations and optimisation analyses for solar photovoltaic (PV) installations, specifying panel tilt angles, array tiering, MPPT string layout, and economic projections for a given site's latitude and climate. This page documents a three-tier cascading solar panel system designed for Cumbria, England (54.5°N), where seasonal solar variation is extreme; the optimal configuration (43–45° tilt, 20% horizontal overlap, 18 panels at 6.3 kW peak) achieves approximately 3,179 kWh/year — three times the output of a conventional single-layer array in the same 10 m² footprint."@en ;
    rdfs:subClassOf ngm:infra-software-engineering ;
    skos:broader ngm:infra-software-engineering ;
    vc:enables ngm:internet-of-things,
        ngm:technology-adoption ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:carbon-footprint-assessment,
        ngm:environmental-impact-metric,
        ngm:renewable-energy-certificates,
        ngm:sustainability ;
    vc:slug "solar-pv-installation-engineering-plan" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:optimization-algorithm,
        ngm:simulation .

ngm:spatial-ai-assistant-agent a owl:Class ;
    rdfs:label "Spatial AI Assistant Agent"@en ;
    rdfs:comment "A Spatial AI Associate is an AI-powered assistant role or software agent embedded within spatial computing and extended reality environments, responsible for contextual scene understanding, user intent interpretation, and proactive spatial guidance. It combines computer vision, SLAM-derived spatial maps, and large language model reasoning to deliver situated, location-aware assistance within physical or mixed-reality spaces."@en ;
