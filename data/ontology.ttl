    rdfs:label "Constitutional AI"@en .

ngm:constraint-solver a owl:Class ;
    rdfs:label "Constraint Solver"@en ;
    rdfs:comment "A constraint solver is a computational engine that finds assignments of values to variables such that all specified constraints — mathematical relationships, logical predicates, or physical laws — are simultaneously satisfied, drawing on techniques from constraint programming, SAT/SMT solving, linear programming, and numerical methods. Solvers operate by propagating constraint implications to prune the search space, applying backtracking or branch-and-bound search, and invoking domain-specific inference procedures that make the infeasibility of partial assignments detectable early. They are applied across planning and scheduling, combinatorial optimisation, formal verification, physics simulation, computer-aided design, and robotic motion planning."@en ;
    rdfs:subClassOf ngm:optimization-algorithm ;
    vc:enables ngm:automated-planning,
        ngm:motion-planning,
        ngm:planning-and-scheduling ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:constraint-based-design,
        ngm:trajectory-planning ;
    vc:slug "constraint-solver" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:constraint,
        ngm:logic-programming .

ngm:content-creation-pipeline a owl:Class ;
    rdfs:label "Content Creation Pipeline"@en ;
    rdfs:comment "A Content Creation Pipeline is a structured, orchestrated workflow that sequences and parallelises the stages of producing digital content—spanning ideation, scripting, asset generation, editorial review, quality assurance, and multi-platform distribution—into a reproducible and scalable production system. Modern pipelines integrate AI generation models, digital asset management systems, localisation engines, and publishing endpoints to deliver high-throughput content production with traceable asset provenance. They are the operational backbone of film VFX studios, game development, streaming platforms, and enterprise marketing operations, governing how raw creative intent is transformed into finished, distributed artefacts. Pipeline architecture choices directly determine release velocity, brand consistency, and the cost structure of large-scale content organisations."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:digital-asset-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:version-control ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:workflow-orchestration ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:asset-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:quality-assurance ],
        ngm:content-creation ;
    vc:bridgesTo ngm:data-pipeline,
        ngm:machine-learning-pipeline ;
    vc:contrastsWith ngm:manual-production-workflow ;
    vc:dependsOn ngm:cloud-computing,
        ngm:content-delivery-network ;
    vc:enables ngm:automated-publishing,
        ngm:localisation,
        ngm:media-production,
        ngm:metaverse-content-creation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:asset-management,
        ngm:distribution-platform,
        ngm:quality-assurance,
        ngm:workflow-orchestration ;
    vc:implements ngm:directed-acyclic-graph,
        ngm:provenance-tracking ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:creative-automation,
        ngm:digital-content-creation,
        ngm:video-production-pipeline ;
    vc:requires ngm:content-management-system,
        ngm:digital-asset-management,
        ngm:version-control ;
    vc:slug "content-creation-pipeline" ;
    vc:sourceDomain "distributed-collaboration" ;
    vc:uses ngm:content-creation-tool,
        ngm:generative-ai,
        ngm:render-farm,
        ngm:workflow-engine .

ngm:content-identifier a owl:Class ;
    rdfs:label "Content Identifier"@en ;
    rdfs:comment "A Content Identifier (CID) is a self-describing, cryptographically derived label used in the InterPlanetary File System and IPLD ecosystem to uniquely identify and verify content through its hash, encoding the hash function used, the hash digest, and a multicodec descriptor for the serialised data format into a compact, version-aware multihash structure."@en ;
    rdfs:subClassOf ngm:content-addressing ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:distributed-storage,
        ngm:ipfs,
        ngm:ipfs-content-addressing ;
    vc:slug "content-identifier" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:ipld,
        ngm:merkle-dag,
        ngm:multihash .

ngm:content-production-workflow a owl:Class ;
    rdfs:label "Content Production Workflow"@en ;
    rdfs:comment "A structured sequence of stages and toolchain integrations through which raw creative inputs are transformed into publishable digital assets, covering pre-production, asset authoring, review, rendering, and distribution. In spatial computing contexts, such workflows incorporate 3D asset pipelines, real-time rendering checks, and version-controlled delivery to metaverse platforms."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:digital-content-creation ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:rendering-pipeline ],
        ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:enables ngm:digital-content ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:digital-content-creation,
        ngm:rendering-pipeline ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:relatedTo ngm:metaverse-content-pipeline ;
    vc:slug "content-production-workflow" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:generative-ai .

ngm:content-provenance a owl:Class ;
    rdfs:label "Content Provenance"@en ;
    rdfs:comment "Content provenance is the verifiable, machine-readable record of the origin, authorship, creation context, and transformation history of a piece of digital media, enabling downstream consumers and automated systems to establish authenticity and detect unauthorised alteration. It relies on cryptographic signing, structured metadata schemas, and tamper-evident manifests attached to or bound with the asset at point of creation. As generative AI proliferates synthetic media, content provenance serves as the principal technical mechanism for distinguishing camera-captured or human-authored material from algorithmically generated content. Governance frameworks and regulatory instruments increasingly mandate provenance disclosure as a baseline trust control for media distributed at scale."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptography ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:digital-signatures ],
        ngm:provenance ;
    vc:bridgesTo ngm:blockchain,
        ngm:decentralised-identity,
        ngm:generative-ai ;
    vc:contrastsWith ngm:deepfake,
        ngm:synthetic-media ;
    vc:enables ngm:disinformation-detection,
        ngm:media-authentication,
        ngm:trust-signals ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:data-lineage,
        ngm:information-integrity,
        ngm:watermarking ;
    vc:requires ngm:cryptography,
        ngm:digital-signatures,
        ngm:public-key-infrastructure ;
    vc:slug "content-provenance" ;
    vc:sourceDomain "governance" ;
    vc:standardizedBy ngm:c2pa,
        ngm:iptc-photo-metadata ;
    vc:supports ngm:ai-governance,
        ngm:content-moderation,
        ngm:digital-rights-management ;
    vc:uses ngm:hashing,
        ngm:metadata-standards,
        ngm:verifiable-credentials .

ngm:controller a owl:Class ;
    rdfs:label "Controller"@en ;
    rdfs:comment "A Controller is a computational or hardware module that receives a reference setpoint and measured feedback signals, applies a control law or learned policy, and generates command signals that drive a plant or process towards desired states. Controllers span a spectrum from classical linear regulators such as PID and LQR to nonlinear model-based controllers such as Model Predictive Control and computed-torque methods, as well as data-driven approaches including neural network policies trained via reinforcement learning. Operating within closed-loop feedback architectures, the controller continuously computes an error signal — the difference between desired and measured output — and produces corrective actuation to minimise that error subject to stability and performance constraints."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:error-signal ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:plant-model ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:actuator ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:sensor ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:feedback-loop ],
        ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:bridgesTo ngm:digital-twin,
        ngm:neural-network,
        ngm:reinforcement-learning ;
    vc:contrastsWith ngm:manual-control,
        ngm:open-loop-control ;
    vc:dependsOn ngm:real-time-computing,
        ngm:system-identification ;
    vc:enables ngm:motion-planning,
        ngm:robot-control,
        ngm:stability,
        ngm:trajectory-tracking ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:control-output,
        ngm:error-signal,
        ngm:reference-setpoint ;
    vc:implements ngm:linear-quadratic-regulator,
        ngm:model-predictive-control,
        ngm:reinforcement-learning-policy ;
    vc:isPartOf ngm:closed-loop-system,
        ngm:cyber-physical-system ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:dynamics,
        ngm:kalman-filter,
        ngm:kinematics,
        ngm:observer ;
    vc:requires ngm:actuator,
        ngm:feedback-loop,
        ngm:plant-model,
        ngm:sensor ;
    vc:slug "controller" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:control-law,
        ngm:feedback-control,
        ngm:pid-controller,
        ngm:state-space-model .

ngm:convolution a owl:Class ;
    rdfs:label "Convolution"@en ;
    rdfs:comment "Convolution is a mathematical operation that combines two functions by sliding one (the kernel or filter) over another (the input signal or image) and computing a weighted sum of overlapping values at each position, producing a third function that expresses how the shape of one modifies the other. In deep learning and signal processing it provides a translation-equivariant mechanism for local feature extraction with shared parameter weights. The discrete 2D form underpins convolutional neural networks; the continuous form via the Convolution Theorem connects to Fourier analysis and frequency-domain filtering."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gpu-acceleration ],
        ngm:signal-processing ;
    vc:bridgesTo ngm:graph-neural-network,
        ngm:radar-signal-processing ;
    vc:contrastsWith ngm:recurrent-neural-network,
        ngm:self-attention ;
    vc:dependsOn ngm:fourier-analysis,
        ngm:linear-algebra ;
    vc:enables ngm:convolutional-neural-network,
        ngm:feature-extraction,
        ngm:image-segmentation,
        ngm:object-detection ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:implements ngm:finite-impulse-response-filter,
        ngm:translation-equivariance ;
    vc:qualityScore "0.75"^^xsd:float ;
