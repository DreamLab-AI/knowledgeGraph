ngm:hardware a owl:Class ;
    rdfs:label "Hardware"@en ;
    rdfs:comment "Hardware denotes the physical, tangible components of a computing system — processors, memory modules, storage devices, input/output peripherals, power subsystems, and interconnects — that collectively provide the substrate on which software executes. In the spatial-computing and infrastructure context it encompasses both general-purpose devices (CPUs, GPUs, FPGAs, ASICs) and specialised sensors and actuators (depth cameras, inertial measurement units, haptic controllers, head-mounted displays) that enable immersive and intelligent workloads. Hardware capability sets the fundamental performance, latency, power, and thermal envelope that software stacks must respect, making hardware design decisions inseparable from system architecture, operating-system abstractions, and application-level trade-offs. The discipline spans semiconductor fabrication, PCB design, embedded firmware, hardware security primitives, and the standards that allow heterogeneous devices to interoperate."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:power-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:operating-system ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:sensor ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:central-processing-unit ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:gpu-compute ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:device-drivers ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:hardware-component ],
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:bridgesTo ngm:neural-processing-unit,
        ngm:trusted-execution-environment ;
    vc:contrastsWith ngm:virtual-machine ;
    vc:dependsOn ngm:semiconductor-fabrication,
