ngm:demand-response a owl:Class ;
    rdfs:label "Demand Response"@en ;
    rdfs:comment "Demand response is the deliberate modification of electricity consumption patterns by end users in response to signals from grid operators, energy markets, or automated control systems, with the aim of balancing supply and demand in real time. It enables consumers—from large industrial facilities to domestic smart appliances—to reduce or shift load during peak periods or grid stress events in exchange for financial incentives or reduced tariffs. Demand response programmes are a cornerstone of smart grid operation, deferring or avoiding costly investment in peak generation capacity. Increasingly, AI-driven automation and IoT sensor networks enable fine-grained, real-time demand response at residential scale without requiring manual intervention from end users."@en ;
    rdfs:subClassOf ngm:smart-grid ;
    vc:enables ngm:power-efficient-ai,
        ngm:renewable-energy-certificates ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:energy-and-power,
        ngm:industrial-io-t,
        ngm:power-management ;
    vc:slug "demand-response" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:machine-to-machine-payments ;
    vc:uses ngm:io-t-ai-integration,
        ngm:io-t-sensor-network .

ngm:denavit-hartenberg-parameters a owl:Class ;
    rdfs:label "Denavit-Hartenberg Parameters"@en ;
    rdfs:comment "Denavit-Hartenberg (DH) parameters are a standardised four-parameter convention for describing the relative geometry between consecutive links of a robotic manipulator. Each joint is characterised by link length, link twist, link offset, and joint angle, yielding a homogeneous transformation matrix per joint. Chaining these matrices gives a compact, systematic model of the arm's kinematics."@en ;
    rdfs:subClassOf ngm:control-theory ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:forward-kinematics,
        ngm:kinematics-model ;
    vc:slug "denavit-hartenberg-parameters" ;
    vc:sourceDomain "robotics" .

ngm:design-thinking a owl:Class ;
    rdfs:label "Design Thinking"@en ;
    rdfs:comment "Design Thinking is a human-centred, iterative problem-solving methodology that prioritises deep empathy with end users, rapid ideation, and prototype-driven experimentation to arrive at innovative solutions. Originating in industrial design and formalised at Stanford's d.school, it proceeds through five non-linear phases: empathise, define, ideate, prototype, and test. The approach deliberately suspends assumptions and defers judgement during divergent thinking stages, producing a rich solution space before converging on testable prototypes. Design Thinking is now applied widely in product development, service design, organisational strategy, and technology innovation contexts."@en ;
    rdfs:subClassOf ngm:knowledge-representation ;
    vc:enables ngm:generative-design-tool,
        ngm:product-design,
        ngm:user-experience ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:accessible-design,
        ngm:etsi-domain-human-interface-ux,
        ngm:human-computer-interaction,
        ngm:information-architecture ;
    vc:slug "design-thinking" ;
    vc:sourceDomain "governance" ;
    vc:uses ngm:collaborative-systems-modality-design,
        ngm:design-software,
        ngm:user-research .

ngm:differentiable-architecture a owl:Class ;
    rdfs:label "Differentiable Architecture"@en ;
    rdfs:comment "Differentiable Architecture refers to a neural network design paradigm, most prominently realised in Differentiable Architecture Search (DARTS), in which discrete structural choices — such as which operation to place at each edge of a candidate graph or how to connect layers — are relaxed to continuous mixture weights over a predefined set of operations. This relaxation renders the architecture selection problem differentiable, allowing the architecture parameters to be optimised jointly with network weights via gradient descent on a validation loss. Once optimised, the continuous mixture is discretised to yield a final architecture, dramatically reducing the computational cost of neural architecture search compared to evolutionary or reinforcement learning methods."@en ;
    rdfs:subClassOf ngm:ai-model-architecture ;
    skos:broader ngm:ai-model-architecture ;
    vc:enables ngm:machine-learning-discipline ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:deep-learning,
        ngm:hyperparameter,
        ngm:knowledge-distillation ;
    vc:slug "differentiable-architecture" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:gradient-descent,
        ngm:neural-network-architecture .

ngm:differential-equations a owl:Class ;
    rdfs:label "Differential Equations"@en ;
    rdfs:comment "Equations relating a function to its derivatives, used to model how quantities change with respect to one or more independent variables."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:linear-algebra ],
