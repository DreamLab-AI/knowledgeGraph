ngm:distributed-system-protocol a owl:Class ;
    rdfs:label "Distributed System Protocol"@en ;
    rdfs:comment "A Distributed System Protocol defines the communication and coordination mechanisms enabling distributed nodes to achieve collective functionality through standardised message formats, state synchronisation procedures, and failure recovery mechanisms. Such protocols underpin blockchain networks, peer-to-peer systems, and consensus-based infrastructure through gossip dissemination, leader election, distributed hash tables, and inter-node authentication channels."@en ;
