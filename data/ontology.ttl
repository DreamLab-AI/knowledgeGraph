    vc:slug "safety-and-alignment" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:standardizedBy ngm:bletchley-declaration,
        ngm:eu-ai-act,
        ngm:iso-42001,
        ngm:nist-ai-rmf,
        ngm:uk-aisi-evaluation-protocols ;
