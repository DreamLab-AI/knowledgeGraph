ngm:active-research-projects-registry a owl:Class ;
    rdfs:label "Active Research Projects Registry"@en ;
    rdfs:comment "An Active Research Projects Registry is a structured, queryable catalogue that maintains authoritative records of ongoing research initiatives, development workstreams, and collaborative projects within an organisation or knowledge graph, capturing metadata such as status, ownership, objectives, dependencies, and timelines. It serves as a single source of truth for portfolio governance, enabling stakeholders to discover, track, and coordinate active work without duplicating effort or losing context across distributed teams. Unlike a static document index, a living registry integrates with project management workflows, version control systems, and knowledge management platforms to reflect real-time project state. It supports prioritisation, resource allocation, and strategic alignment by surfacing the relationships between concurrent initiatives and shared infrastructure."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:project-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:knowledge-graph-kanban-board ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:metadata-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:version-control ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-governance ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:applied-ai-research-portfolio ],
        ngm:data-registry ;
    vc:bridgesTo ngm:fair-data-principles,
        ngm:open-data ;
    vc:contrastsWith ngm:data-catalog,
        ngm:experiment-tracking ;
    vc:enables ngm:automated-planning,
        ngm:collaboration,
        ngm:knowledge-management ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:applied-ai-research-portfolio,
        ngm:knowledge-graph-kanban-board,
        ngm:project-management ;
    vc:isPartOf ngm:knowledge-management-system ;
    vc:qualityScore "0.68"^^xsd:float ;
    vc:relatedTo ngm:agentic-workflow,
        ngm:collaboration-platform,
        ngm:knowledge-graph-publication-classifier ;
    vc:requires ngm:data-governance,
        ngm:metadata-management,
        ngm:version-control ;
    vc:slug "active-research-projects-registry" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:ai-augmented-research-tooling-suite,
        ngm:decentralised-agent-coordination-initiative ;
    vc:uses ngm:agile-software-development,
        ngm:data-catalog,
