        ngm:large-language-model,
        ngm:tool-use ;
    vc:slug "agent-evaluation-benchmarks" ;
    vc:sourceDomain "ai" .

ngm:agent-layer a owl:Class ;
    rdfs:label "Agent Layer"@en ;
    rdfs:comment "The Agent Layer is the stratum that hosts autonomous entities capable of perceiving, deciding, and acting toward goals. It sits above control and inference strata that supply its capabilities and below coordination and application strata that direct collectives of agents. It contains agent policies, goal representations, memory, and decision loops."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:control-layer ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:inference-layer ],
        ngm:ai-model-architecture ;
    skos:broader ngm:ai-model-architecture ;
    vc:enables ngm:application-layer,
        ngm:coordination-layer ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:control-layer,
        ngm:inference-layer ;
    vc:slug "agent-layer" ;
    vc:sourceDomain "ai" .

ngm:agent2-agent-protocol-google-2025 a owl:Class ;
    rdfs:label "Agent2Agent Protocol (Google 2025)"@en ;
    rdfs:comment "The Agent2Agent Protocol (A2A), released by Google as an open specification in April 2025 and transferred to the Linux Foundation in June 2025, is a JSON-RPC 2.0 over HTTP(S) protocol — extended with Server-Sent Events for streaming — that enables AI agents to discover one another via standardised, cryptographically signed agent cards hosted at well-known URIs, delegate tasks through a six-state task lifecycle, stream results back to requesting agents, and operate regardless of the underlying model or framework used to implement the agents. Reaching version 1.2 by March 2026 with over 150 supporting organisations, it is designed as a complementary peer-to-peer layer alongside Anthropic's Model Context Protocol, together forming the emerging two-protocol stack for the agentic internet."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:mutual-authentication ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:http-protocol ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:push-notification ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:agent-identity ],
        ngm:agent-to-agent-protocol ;
    vc:bridgesTo ngm:distributed-systems,
        ngm:enterprise-ai,
        ngm:microservices-architecture,
        ngm:supply-chain-automation ;
    vc:contrastsWith ngm:openai-swarm,
        ngm:remote-procedure-call ;
    vc:enables ngm:agentic-internet,
        ngm:agentic-workflow,
        ngm:autonomous-task-execution,
        ngm:inter-agent-communication,
        ngm:task-delegation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:agent-card,
        ngm:push-notification,
        ngm:task-lifecycle ;
    vc:qualityScore "0.93"^^xsd:float ;
    vc:relatedTo ngm:agent-communication-protocol,
        ngm:agent-network-protocol,
        ngm:model-context-protocol,
        ngm:multi-agent-orchestration,
        ngm:prompt-injection ;
    vc:requires ngm:agent-identity,
        ngm:http-protocol,
        ngm:mutual-authentication ;
    vc:slug "agent2-agent-protocol-google-2025" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:http-protocol,
        ngm:json-rpc-2-0,
        ngm:json-schema,
        ngm:json-web-signature,
        ngm:message-passing,
        ngm:oauth-2-0,
        ngm:server-sent-events,
        ngm:service-discovery .

ngm:ai-agent-identity a owl:Class ;
    rdfs:label "Ai Agent Identity"@en ;
    rdfs:comment "A persistent, verifiable digital identity assigned to an autonomous AI agent, enabling it to authenticate, sign transactions, and participate in decentralised systems on behalf of itself or a principal. AI agent identity encompasses credential issuance, key management, and delegation of authority scoped to the agent's operational context. Such identities may be anchored on a blockchain ledger to ensure auditability and prevent impersonation. They bridge self-sovereign identity (SSI) principles with agentic software systems."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:public-key-infrastructure ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptographic-key-management ],
        ngm:blockchain ;
    skos:broader ngm:blockchain ;
    vc:bridgesTo ngm:decentralized-identifier,
        ngm:self-sovereign-identity ;
    vc:contrastsWith ngm:human-identity ;
    vc:dependsOn ngm:blockchain,
        ngm:distributed-ledger ;
    vc:enables ngm:autonomous-agent,
        ngm:multi-agent-system ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:access-control,
        ngm:smart-contract,
        ngm:trust-framework ;
    vc:requires ngm:cryptographic-key-management,
        ngm:public-key-infrastructure ;
    vc:slug "ai-agent-identity" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:accountability ;
    vc:uses ngm:digital-signature,
        ngm:verifiable-credential .

ngm:ai-agent-payments a owl:Class ;
    rdfs:label "AI Agent Payments"@en ;
    rdfs:comment "AI Agent Payments refers to the infrastructure, protocols, and economic mechanisms that enable autonomous AI agents to initiate, authorise, and settle financial transactions on behalf of users or autonomously as principals, spanning micropayment rails for API service consumption, programmatic access to payment networks, and identity-bound wallet abstractions that constrain agent spending to authorised scopes and budgets."@en ;
    rdfs:subClassOf ngm:agentic-finance ;
    vc:enables ngm:agentic-internet,
        ngm:autonomous-task-execution ;
    vc:hasMaturity ngmi:maturity-emerging ;
