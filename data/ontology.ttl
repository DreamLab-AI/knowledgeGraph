ngm:robot-sensor a owl:Class ;
    rdfs:comment "A Robot Sensor is a transducer or measurement device integrated into a robotic system to acquire data about the robot's internal state (proprioception: joint angles, torques, currents) or external environment (exteroception: proximity, force, vision, lidar). Sensor data drives closed-loop control, obstacle avoidance, and higher-level perception pipelines."@en ;
    rdfs:label "Robot Sensor"@en ;
    rdfs:subClassOf ngm:robo-perception ;
