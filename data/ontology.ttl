ngm:block-propagation-time a owl:Class ;
    rdfs:label "Block Propagation Time"@en ;
    rdfs:comment "Block Propagation Time is the latency metric measuring how long it takes for a newly mined or validated block to be disseminated to all (or a target percentage of) nodes in a blockchain peer-to-peer network after its initial announcement. It is a critical determinant of blockchain security and throughput: long propagation times increase the probability of temporary forks (stale/orphan blocks), waste miner effort, and reduce effective network throughput. Bitcoin historically achieved median propagation times of approximately 1–2 seconds to reach 50% of nodes, while Ethereum's uncle mechanism tolerated higher latency by including competing blocks in the canonical chain."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gossip-protocol ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:peer-to-peer-network ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:block-propagation ],
        ngm:bc-protocol-and-consensus,
        ngm:blockchain-entity,
        ngm:network-component ;
    skos:broader ngm:bc-protocol-and-consensus ;
    vc:contrastsWith ngm:proof-of-stake ;
    vc:enables ngm:consensus-mechanism,
        ngm:fork-choice-rule ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:block-propagation ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:blockchain-infrastructure,
        ngm:blockchain-network,
        ngm:blockchain-scalability,
        ngm:consensus-algorithm,
        ngm:network-latency,
        ngm:proof-of-work ;
    vc:requires ngm:gossip-protocol,
        ngm:peer-to-peer-network ;
    vc:slug "block-propagation-time" ;
    vc:sourceDomain "blockchain" .

ngm:block-proposal a skos:Concept ;
