        ngm:hyperledger-besu,
        ngm:hyperledger-fabric ;
    vc:implements ngm:distributed-ledger-technology,
        ngm:smart-contracts ;
    vc:isPartOf ngm:linux-foundation ;
    vc:qualityScore "0.74"^^xsd:float ;
