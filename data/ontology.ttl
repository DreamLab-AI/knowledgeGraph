    vc:slug "cybersecurity-standard" ;
    vc:sourceDomain "robotics" .

vf:cylindrical-robot a owl:Class ;
    rdfs:label "Cylindrical Robot"@en ;
    rdfs:comment "Cylindrical robot employs one rotary joint (azimuth) and two prismatic joints (radial and vertical) that produce a cylindrical workspace, enabling efficient reach over rectangular work envelopes. This architecture, simpler and more affordable than six-axis articulated robots, has historically dominated [[Assembly Automation]] and [[Material Handling]] applications where reach and vertical lift are primary requirements."@en ;
    rdfs:subClassOf <urn:visionflow:linked:coordinate-robots>,
        <urn:visionflow:linked:fixed-base-manipulator>,
        vf:industrial-robot ;
    vc:authorityScore "0.95"^^xsd:float ;
    vc:enables <urn:visionflow:linked:component-assembly>,
        <urn:visionflow:linked:depalletising>,
        <urn:visionflow:linked:palletising>,
        <urn:visionflow:linked:pick-and-place> ;
    vc:hasPart <urn:visionflow:linked:azimuth-drive>,
        <urn:visionflow:linked:end-effector-mount>,
        <urn:visionflow:linked:radial-actuator>,
        <urn:visionflow:linked:vertical-actuator> ;
    vc:maturity "established" ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires <urn:visionflow:linked:base-support>,
        <urn:visionflow:linked:prismatic-actuators>,
        <urn:visionflow:linked:rotary-joint> ;
    vc:slug "cylindrical-robot" ;
    vc:sourceDomain "robotics" .

