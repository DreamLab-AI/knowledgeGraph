ngm:probability-theory a owl:Class ;
    rdfs:label "Probability Theory"@en ;
    rdfs:comment "Probability theory is the branch of mathematics that provides a rigorous framework for quantifying and reasoning about uncertainty and random phenomena. Built on measure-theoretic foundations formalised by Andrei Kolmogorov in 1933, it defines probability spaces, random variables, and expectation operators over sigma-algebras to give a unified axiomatic treatment of chance. The theory encompasses both frequentist and Bayesian interpretations, and its core results — the law of large numbers, the central limit theorem, and the law of total probability — underpin virtually every quantitative discipline from statistical inference to machine learning and financial mathematics."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:stochastic-process ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:set-theory ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:central-limit-theorem ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:bayesian-inference ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:measure-theory ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:probability-distribution ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:markov-chain ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:real-analysis ],
        ngm:measure-theory ;
    vc:bridgesTo ngm:conformal-prediction,
        ngm:diffusion-models ;
    vc:contrastsWith ngm:fuzzy-logic ;
    vc:dependsOn ngm:sigma-algebra ;
    vc:enables ngm:information-theory,
        ngm:monte-carlo-methods,
        ngm:reinforcement-learning,
        ngm:statistical-inference,
        ngm:stochastic-differential-equation,
        ngm:uncertainty-quantification ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:bayesian-inference,
        ngm:central-limit-theorem,
        ngm:markov-chain,
        ngm:probability-distribution,
        ngm:random-variable,
        ngm:stochastic-process ;
    vc:qualityScore "0.76"^^xsd:float ;
    vc:relatedTo ngm:bayesian-decision-theory,
        ngm:causal-inference,
        ngm:optimal-transport,
        ngm:statistics ;
    vc:requires ngm:measure-theory,
        ngm:real-analysis,
        ngm:set-theory ;
    vc:slug "probability-theory" ;
    vc:sourceDomain "machine-learning" ;
    vc:supports ngm:graphical-model,
        ngm:machine-learning .

ngm:accessibility a owl:Class ;
    rdfs:label "Accessibility"@en ;
    rdfs:comment "Accessibility is the systematic property of digital products, services, environments and information systems being perceivable, operable, understandable and robust (POUR) for the widest possible range of users including those with permanent disabilities temporary impairments (broken arm, post-sur..."@en ;
