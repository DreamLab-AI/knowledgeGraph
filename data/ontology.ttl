ngm:pretraining a owl:Class ;
    rdfs:label "Pretraining"@en ;
    rdfs:comment "Pretraining is the initial phase of training a model on a large, broad corpus using self-supervised objectives to learn general-purpose representations before any task-specific adaptation. It produces a foundation model whose learned features can be transferred to downstream tasks through fine-tuning or prompting. For language models this typically involves predicting masked or next tokens over vast text collections."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:unsupervised-learning ],
        ngm:self-supervised-learning ;
    vc:bridgesTo ngm:deep-learning ;
    vc:contrastsWith ngm:fine-tuning,
        ngm:instruction-tuning ;
    vc:dependsOn ngm:representation-learning ;
    vc:enables ngm:fine-tuning,
        ngm:transfer-learning ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:self-supervised-learning ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:transfer-learning ;
    vc:requires ngm:corpus,
        ngm:unsupervised-learning ;
    vc:slug "pretraining" ;
    vc:sourceDomain "machine-learning" ;
    vc:supports ngm:language-model,
        ngm:large-language-model ;
    vc:uses ngm:next-token-prediction,
        ngm:representation-learning .

ngm:privacy-engineering a owl:Class ;
    rdfs:label "Privacy Engineering"@en ;
    rdfs:comment "Privacy Engineering is the systematic application of engineering methods to translate privacy principles and regulatory requirements into concrete technical controls embedded within systems and processes. It operationalises concepts such as data minimisation, purpose limitation, and consent management through design patterns, threat models, and measurable privacy metrics. Techniques include differential privacy for statistical disclosures, homomorphic encryption for computation on sensitive data, and k-anonymity for dataset release. The discipline bridges legal obligations—particularly GDPR and similar frameworks—with software architecture and data pipeline design, treating privacy as a quality attribute alongside performance and security."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:threat-modelling ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:data-minimisation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:access-control ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:consent-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:privacy-impact-assessment ],
        ngm:privacy-by-design ;
    vc:bridgesTo ngm:federated-learning,
        ngm:secure-multi-party-computation ;
    vc:contrastsWith ngm:security-engineering ;
    vc:enables ngm:gdpr-compliance,
        ngm:privacy-and-data-governance,
        ngm:privacy-preserving-machine-learning ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:data-minimisation,
        ngm:privacy-impact-assessment,
        ngm:threat-modelling ;
    vc:implements ngm:nist-privacy-framework ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:personal-data-store,
        ngm:zero-knowledge-proof ;
    vc:requires ngm:access-control,
        ngm:consent-management ;
    vc:slug "privacy-engineering" ;
    vc:sourceDomain "security" ;
    vc:standardizedBy ngm:gdpr,
        ngm:iso-iec-27701 ;
    vc:supports ngm:data-protection,
        ngm:regulatory-compliance ;
    vc:uses ngm:differential-privacy,
        ngm:homomorphic-encryption,
        ngm:k-anonymity-in-datasets,
        ngm:pseudonymisation .

ngm:privacy-preserving-ai a owl:Class ;
    rdfs:label "Privacy-Preserving AI"@en ;
    rdfs:comment "Privacy-Preserving AI is a family of machine-learning techniques and system architectures that enable models to be trained, validated, and deployed without exposing raw personal or sensitive data to any single party. Core mechanisms include federated learning, differential privacy, homomorphic encryption, and secure multi-party computation, each offering distinct trade-offs between privacy guarantees, computational cost, and model utility. The discipline addresses regulatory requirements (GDPR, HIPAA) as well as ethical imperatives around data minimisation and individual autonomy. By decoupling learning from data centralisation, Privacy-Preserving AI enables collaborative intelligence across organisational and jurisdictional boundaries that would otherwise be closed to data sharing."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:differential-privacy ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:secure-multi-party-computation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptography ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-governance ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:federated-learning ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:machine-learning ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:homomorphic-encryption ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:trusted-execution-environment ],
        ngm:privacy-preserving ;
