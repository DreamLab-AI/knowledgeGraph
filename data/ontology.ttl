ngm:human-computer-interaction a owl:Class ;
    rdfs:label "Human Computer Interaction"@en ;
    rdfs:comment "Human-Computer Interaction (HCI) in the AI context examines the design, evaluation, and implementation of interactive systems that incorporate artificial intelligence capabilities. This interdisciplinary field addresses usability, accessibility, user experience, and cognitive aspects of AI-powered interfaces, emphasising transparency, trust calibration, and ethical implications of algorithmic decision-making on human users."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:interaction-design ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cognitive-science ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:user-research ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:user-interface-design ],
        ngm:ai-research-area ;
    skos:broader ngm:ai-research-area ;
    vc:bridgesTo ngm:augmented-reality,
        ngm:digital-twin,
        ngm:spatial-computing ;
    vc:contrastsWith ngm:autonomous-agent ;
    vc:enables ngm:accessibility,
