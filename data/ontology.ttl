ngm:change-data-capture a owl:Class ;
    rdfs:comment "Change data capture is a set of techniques for identifying and propagating row-level changes — inserts, updates, and deletes — from a source database to downstream systems in near real time. The most robust approach reads the database transaction log, turning committed mutations into an ordered stream of change events without burdening the source with polling. It underpins data replication, event streaming, and incremental data integration, keeping analytical stores, caches, and microservices consistent with operational systems."@en ;
    rdfs:label "Change Data Capture"@en ;
    rdfs:subClassOf ngm:data-integration ;
    rdfs:subClassOf _:r4220 ;
