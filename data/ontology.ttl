    dcterms:modified "2026-04-26T13:00:00Z"^^xsd:dateTime ;
    vcw:owlRole "Concept" .

# Virtual Production VP
spatial-computing:VirtualProductionVP rdf:type owl:Class ;
    rdfs:subClassOf spatial-computing:FilmProduction ;
    rdfs:label "Virtual Production VP"@en ;
    rdfs:comment "A modern filmmaking methodology that combines traditional production techniques with real-time computer graphics, LED volumes, game engines, and motion capture technology to create in-camera visual effects, replacing traditional green screen compositing with immersive digital environments displayed on large LED walls during live production."@en ;
    skos:prefLabel "Virtual Production VP"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:spatial-computing:virtual-production-vp" ;
    owl:sameAs <urn:visionclaw:concept:spatial-computing:virtual-production-vp> ;
    vcw:contentHash "sha256-12-c33e0d03064c" ;
    vcw:qualityScore "0.5"^^xsd:decimal ;
