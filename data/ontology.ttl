        ngm:speech-recognition ;
    vc:slug "tele-107-ai-meeting-assistants" ;
    vc:sourceDomain "metaverse" .

ngm:tele-153-5-g-telepresence a owl:Class ;
    rdfs:label "TELE-153-5g-telepresence"@en ;
    rdfs:comment "5G telepresence is the delivery of real-time immersive communication over fifth-generation mobile networks, using their higher bandwidth and lower latency to support volumetric and high-resolution remote presence on mobile devices."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
