ngm:digital-product-passport a owl:Class ;
    rdfs:label "Digital Product Passport"@en ;
    rdfs:comment "A Digital Product Passport (DPP) is a standardised digital record that captures and communicates information about a product's material composition, origin, manufacturing process, environmental footprint, repair history, and end-of-life options throughout its lifecycle. Mandated by EU ecodesign and product sustainability legislation, DPPs are designed to be machine-readable and accessible to consumers, regulators, recyclers, and supply chain actors via data carriers such as QR codes or RFID. They are a foundational instrument of circular economy policy and are frequently implemented using blockchain or distributed ledger technology to ensure provenance integrity and tamper-evident audit trails."@en ;
    rdfs:subClassOf ngm:infra-data-management ;
    skos:broader ngm:infra-data-management ;
    vc:enables ngm:circular-economy,
        ngm:supply-chain-traceability ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:blockchain,
        ngm:esg-reporting,
        ngm:supply-chain ;
    vc:slug "digital-product-passport" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:provenance-tracking .

