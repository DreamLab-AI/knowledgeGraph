    skos:broader ngm:robotics ;
    vc:bridgesTo ngm:augmented-reality,
        ngm:spatial-computing ;
    vc:contrastsWith ngm:human-perception ;
    vc:dependsOn ngm:point-cloud-processing,
        ngm:signal-processing ;
    vc:enables ngm:human-robot-interaction,
