    vc:uses ngm:edge-computing-architecture,
        ngm:edge-orchestration,
        ngm:federated-learning .

ngm:edge-deployment a owl:Class ;
    rdfs:label "Edge Deployment"@en ;
    rdfs:comment "Edge deployment is the practice of running machine learning models on or near the devices where data is generated, rather than in a centralised cloud. It reduces inference latency, preserves bandwidth, improves privacy by keeping data local and enables operation under intermittent connectivity. Edge deployment usually depends on model compression and hardware-aware optimisation to fit models within the compute, memory and power budgets of edge hardware."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:pruning ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:model-quantization ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:model-compression ],
        ngm:model-deployment ;
    vc:bridgesTo ngm:io-t ;
    vc:contrastsWith ngm:model-serving ;
    vc:dependsOn ngm:edge-computing,
        ngm:mobile-edge-computing ;
    vc:enables ngm:edge-ai,
        ngm:on-device-ai,
        ngm:ultra-low-latency ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:latency,
        ngm:machine-learning-model,
        ngm:mobile-computing ;
    vc:requires ngm:model-compression,
