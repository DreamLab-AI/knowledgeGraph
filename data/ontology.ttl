        ngm:right-to-erasure ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:accountability,
        ngm:data-minimisation,
        ngm:lawful-basis-for-processing ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:data-protection-law,
