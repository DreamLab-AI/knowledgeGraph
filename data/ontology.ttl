    vc:uses ngm:digital-certificate,
        ngm:hash-function .

ngm:cuda a owl:Class ;
    rdfs:label "CUDA"@en ;
    rdfs:comment "CUDA (Compute Unified Device Architecture) is NVIDIA's proprietary parallel computing platform and programming model that exposes GPU hardware through a C/C++ extension, enabling thousands of threads to execute concurrently across GPU cores. It provides a hierarchical thread model of grids, blocks, and warps, alongside a managed memory model that spans host (CPU) and device (GPU) address spaces. CUDA underpins the majority of production deep learning training and inference workloads, acting as the primary execution substrate for frameworks such as PyTorch and TensorFlow."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gpu-compute ],
        ngm:ai-infrastructure ;
    vc:enables ngm:deep-learning,
        ngm:inference,
        ngm:training ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:requires ngm:gpu-compute ;
    vc:slug "cuda" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:machine-learning-framework,
        ngm:neural-network .

ngm:cvpr a owl:Class ;
    rdfs:label "CVPR"@en ;
    rdfs:comment "CVPR (Conference on Computer Vision and Pattern Recognition) is the premier annual academic conference for computer vision research, co-sponsored by the IEEE and the Computer Vision Foundation (CVF). It is consistently ranked among the most impactful venues in artificial intelligence, publishing breakthroughs in image recognition, object detection, semantic segmentation, generative modelling, and 3D vision. Acceptance at CVPR is highly competitive and publication there is a widely recognised marker of significant research contribution."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:object-detection ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:3-d-reconstruction ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
