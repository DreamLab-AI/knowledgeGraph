ngm:adaptive-learning a owl:Class ;
    rdfs:label "Adaptive Learning"@en ;
    rdfs:comment "Adaptive learning is an educational methodology and technology paradigm in which instructional content, pacing, and assessment are dynamically tailored to each learner's demonstrated knowledge, learning style, and progress in real time. Computational systems analyse performance data to identify gaps and misconceptions, then serve personalised learning paths that optimise for mastery and engagement. The approach draws on psychometric theory, knowledge tracing algorithms, and machine learning to individualise instruction at scale."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:real-time-data-processing ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:knowledge-graph ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:feedback-loop ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:domain-model ],
        ngm:education-technology,
        ngm:personalised-learning ;
    vc:bridgesTo ngm:federated-learning,
        ngm:large-language-model,
        ngm:natural-language-processing ;
    vc:dependsOn ngm:content-repository,
        ngm:knowledge-component-model,
