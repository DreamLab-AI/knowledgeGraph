    vc:uses ngm:taxonomy,
        ngm:thesaurus .

ngm:decentralized-identifier a owl:Class ;
    rdfs:label "Decentralized Identifier"@en ;
    rdfs:comment "A Decentralised Identifier (DID) is a globally unique, persistent, cryptographically verifiable identifier that a subject creates and controls without reliance on any centralised registry, authority, or intermediary. Defined by the W3C DID Core specification, a DID is a URI of the form did:method:identifier that resolves to a DID Document containing public keys, authentication mechanisms, and service endpoints. DIDs enable self-sovereign identity by decoupling identifier ownership from third-party identity providers, allowing verifiable credential exchange and privacy-preserving authentication across heterogeneous systems."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:did-resolution ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:did-document ],
        ngm:digital-identity ;
    vc:bridgesTo ngm:blockchain,
        ngm:distributed-ledger-technology,
        ngm:smart-contract ;
    vc:contrastsWith ngm:centralized-identity-provider,
        ngm:oauth ;
    vc:enables ngm:decentralized-authentication,
        ngm:identity-management,
        ngm:self-sovereign-identity,
        ngm:verifiable-credential ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:uri,
        ngm:w3c-did-core ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:access-control,
        ngm:public-key-infrastructure,
        ngm:verifiable-data-registry ;
    vc:requires ngm:did-document,
        ngm:did-resolution,
        ngm:public-key-cryptography ;
    vc:slug "decentralized-identifier" ;
    vc:sourceDomain "security" ;
    vc:standardizedBy ngm:w3c ;
    vc:supports ngm:privacy-preserving-authentication,
        ngm:zero-knowledge-proof ;
    vc:uses ngm:cryptographic-key-pair,
        ngm:did-method,
        ngm:digital-signature .

ngm:edge-ai a owl:Class ;
    rdfs:label "Edge AI"@en ;
    rdfs:comment "Edge AI is the deployment and execution of artificial intelligence inference workloads directly on edge devices—such as smartphones, IoT sensors, surveillance cameras, and embedded systems—close to the data source, rather than in centralised cloud data centres. It reduces latency, preserves data privacy, enables offline operation, and cuts bandwidth costs by processing data locally using optimised neural network models and dedicated hardware accelerators such as neural processing units (NPUs). Edge AI encompasses model compression techniques (quantisation, pruning, knowledge distillation), specialised deployment runtimes, and on-device training paradigms such as federated learning. It bridges the domains of machine learning, embedded systems, and distributed computing to enable intelligent applications at the network periphery."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:neural-processing-unit ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:embedded-systems ],
        ngm:edge-computing ;
    vc:bridgesTo ngm:digital-twin,
        ngm:smart-city,
        ngm:spatial-computing ;
    vc:contrastsWith ngm:cloud-ai,
        ngm:fog-computing ;
    vc:dependsOn ngm:deep-learning,
        ngm:edge-computing,
        ngm:internet-of-things ;
    vc:enables ngm:autonomous-vehicles,
        ngm:federated-learning,
        ngm:io-t-ai-integration,
        ngm:real-time-inference-at-edge,
        ngm:smart-manufacturing ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:computer-vision,
        ngm:natural-language-processing,
        ngm:on-device-machine-learning,
        ngm:small-language-models,
        ngm:tinyml ;
    vc:requires ngm:embedded-systems,
        ngm:model-compression,
        ngm:neural-processing-unit ;
    vc:slug "edge-ai" ;
    vc:sourceDomain "ai" ;
    vc:standardizedBy ngm:etsi-mec,
        ngm:mlperf ;
    vc:uses ngm:hardware-acceleration,
        ngm:inference-engine,
        ngm:knowledge-distillation,
        ngm:model-quantisation,
        ngm:neural-architecture-search,
        ngm:onnx,
        ngm:tflite .

ngm:fiat-currency a owl:Class ;
    rdfs:label "Fiat Currency"@en ;
    rdfs:comment "Fiat currency is money issued and declared legal tender by a sovereign government or central bank, whose value derives from state authority, institutional trust, and collective public acceptance rather than from any intrinsic commodity backing. Unlike commodity money, fiat currency is not convertible into a fixed quantity of gold, silver, or other physical assets at a legally guaranteed rate. Its purchasing power is maintained through monetary policy instruments — interest rates, reserve requirements, open-market operations — and is subject to inflation, deflation, and exchange-rate dynamics driven by macroeconomic conditions. Fiat currency forms the foundational settlement layer for modern banking systems, international trade, and the reserve benchmarks against which digital assets are priced."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:monetary-policy ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:central-bank ],
        ngm:money ;
    vc:bridgesTo ngm:decentralised-finance,
        ngm:stablecoin,
        ngm:tokenisation ;
    vc:contrastsWith ngm:commodity-money,
        ngm:cryptocurrency,
        ngm:gold-standard ;
    vc:dependsOn ngm:government-authority,
        ngm:institutional-trust ;
    vc:enables ngm:central-bank-digital-currency,
        ngm:fractional-reserve-banking,
        ngm:international-trade,
        ngm:stablecoin ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:banknote,
        ngm:reserve-currency ;
    vc:isPartOf ngm:monetary-system ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:exchange-rate,
        ngm:foreign-exchange-market,
        ngm:inflation,
        ngm:usd ;
    vc:requires ngm:central-bank,
        ngm:legal-tender,
        ngm:monetary-policy ;
    vc:slug "fiat-currency" ;
    vc:sourceDomain "finance" ;
    vc:uses ngm:real-time-gross-settlement,
        ngm:swift .

ngm:http a owl:Class ;
    rdfs:label "HTTP"@en ;
    rdfs:comment "The Hypertext Transfer Protocol, a stateless application-layer protocol for transferring hypertext and other resources between clients and servers that underpins the World Wide Web."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
