        ngm:semiconductor-manufacturing ;
    vc:requires ngm:quality-assurance,
        ngm:standardisation ;
    vc:slug "jedec" ;
    vc:sourceDomain "infrastructure" ;
    vc:standardizedBy ngm:ieee-standards ;
    vc:supports ngm:data-centre,
        ngm:hardware-component,
