ngm:digital-asset a owl:Class ;
    rdfs:label "Digital Asset"@en ;
    rdfs:comment "A Digital Asset is any blockchain-recorded value representation with cryptographic ownership guarantees, including cryptocurrencies, tokenised securities, non-fungible tokens, stablecoins, and programmable financial instruments. Asset tokenisation transforms real-world assets into blockchain-native representations through smart contracts that encode legal ownership rights, fractional interests, and automated compliance rules, enabling new forms of value transfer, settlement, and programmable finance."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:smart-contract ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:blockchain ],
        ngm:bc-token-and-asset ;
    skos:broader ngm:bc-token-and-asset ;
    vc:enables ngm:decentralised-finance,
        ngm:nft ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:relatedTo ngm:digital-asset-management ;
    vc:requires ngm:blockchain,
        ngm:smart-contract ;
    vc:slug "digital-asset" ;
    vc:sourceDomain "blockchain" .

ngm:haptic-feedback a owl:Class ;
    rdfs:label "Haptic Feedback"@en ;
    rdfs:comment "Tactile sensory technology providing physical sensations to enhance virtual experiences through actuators integrated into controllers, gloves, and body suits."@en ;
    rdfs:subClassOf ngm:sc-interaction ;
    skos:broader ngm:sc-interaction ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.4"^^xsd:float ;
    vc:slug "haptic-feedback" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:tactile-actuator .

ngm:proof-of-stake a owl:Class ;
    rdfs:label "Proof of Stake"@en ;
    rdfs:comment "A consensus mechanism allowing blockchains to validate transactions and create new blocks based on the number of tokens held or staked by network participants. Validators are selected proportionally to their stake, replacing the energy-intensive mining of Proof of Work with a capital-cost security model that achieves deterministic or probabilistic finality."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:delegated-proof-of-stake ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:validator-node ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:epoch ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:validator-set ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:liquid-proof-of-stake ],
        ngm:bc-protocol-and-consensus,
        ngm:proof-based-consensus ;
    skos:broader ngm:bc-protocol-and-consensus ;
    vc:enables ngm:blockchain-sustainability ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:delegated-proof-of-stake,
        ngm:epoch,
        ngm:liquid-proof-of-stake,
        ngm:validator-node,
        ngm:validator-set ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:deterministic-finality,
        ngm:finality,
        ngm:proof-of-work,
        ngm:sustainable-consensus ;
    vc:slug "proof-of-stake" ;
    vc:sourceDomain "blockchain" .

