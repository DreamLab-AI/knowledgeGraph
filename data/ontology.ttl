ngm:diffusion-models a owl:Class ;
    rdfs:label "Diffusion Models"@en ;
    rdfs:comment "Diffusion Models are a class of deep generative models that learn the data distribution p_data(x) by reversing a fixed forward Markov noising process q(x_t | x_{t-1}) that progressively corrupts data x_0 with Gaussian noise across T timesteps until x_T ≈ N(0,I), then training a neural denoiser ε_..."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:differentiable-architecture ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gpu-compute ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:stochastic-gradient-descent ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:text-encoder ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:variational-inference ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:training-data-distribution ],
        ngm:ai-model-architecture,
        ngm:latent-variable-model,
        ngm:markov-chain-model ;
    skos:broader ngm:ai-model-architecture ;
    vc:enables ngm:3-d-generation,
        ngm:audio-synthesis,
        ngm:image-editing,
        ngm:image-synthesis,
        ngm:inpainting,
        ngm:super-resolution,
        ngm:video-synthesis ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:forward-noising-process,
        ngm:noise-schedule,
        ngm:reverse-denoising-process,
        ngm:sampler,
        ngm:score-network,
        ngm:text-encoder,
        ngm:variational-lower-bound ;
    vc:implements ngm:denoising-score-matching,
        ngm:flow-matching,
        ngm:rectified-flow,
        ngm:stochastic-differential-equation,
        ngm:variational-lower-bound-maximisation ;
    vc:qualityScore "0.52"^^xsd:float ;
    vc:relatedTo ngm:generative-ai,
        ngm:representation-learning,
        ngm:synthetic-media,
        ngm:text-to-image,
        ngm:text-to-video ;
    vc:requires ngm:differentiable-architecture,
        ngm:gpu-compute,
        ngm:stochastic-gradient-descent,
        ngm:training-data-distribution,
        ngm:variational-inference ;
    vc:slug "diffusion-models" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:standardizedBy ngm:cvpr,
        ngm:fid-benchmark-protocol,
        ngm:iclr,
        ngm:icml,
        ngm:neur-ips ;
    vc:supports ngm:creative-tools,
        ngm:drug-discovery,
        ngm:game-asset-generation,
        ngm:medical-image-synthesis,
        ngm:synthetic-data-generation,
        ngm:world-models ;
    vc:uses ngm:classifier-free-guidance,
        ngm:clip-encoder,
        ngm:control-net,
        ngm:cross-attention,
        ngm:diffusion-transformer,
        ngm:t5-encoder,
        ngm:u-net,
        ngm:variational-autoencoders .

ngm:open-standard a owl:Class ;
    rdfs:label "Open Standard"@en ;
    rdfs:comment "Open Standard is a technology infrastructure concept and a type of infrastructure."@en ;
    rdfs:subClassOf ngm:infra-legal-and-regulatory ;
    skos:broader ngm:infra-legal-and-regulatory ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:implements ngm:infrastructure ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:slug "open-standard" ;
    vc:sourceDomain "infrastructure" .

ngm:validator-set a owl:Class ;
    rdfs:label "Validator Set"@en ;
    rdfs:comment "A validator set is the collection of nodes in a proof-of-stake or delegated consensus blockchain that are authorised to propose, attest, and finalise new blocks in each epoch. Validators are typically selected through staking—locking collateral that is subject to slashing penalties for misbehaviour—ensuring economic alignment with protocol security. The composition of the validator set changes at epoch boundaries based on delegation, unbonding, and slashing events, and its size determines the trade-off between decentralisation and consensus latency."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:validator-node ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:proof-of-stake ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:consensus-mechanism ],
        ngm:bc-network-component ;
    skos:broader ngm:bc-network-component ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:validator-node ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:blockchain-network,
        ngm:delegated-proof-of-stake,
        ngm:epoch ;
    vc:requires ngm:consensus-mechanism,
        ngm:proof-of-stake ;
    vc:slug "validator-set" ;
    vc:sourceDomain "blockchain" .

ngm:3-d-asset a owl:Class ;
    rdfs:label "3D Asset"@en ;
    rdfs:comment "A 3D Asset is a discrete digital artefact representing geometry, materials, animations, or environments used in spatial computing and metaverse applications. These assets follow standardised interchange formats such as glTF, FBX, USD, and OBJ to ensure cross-platform interoperability, and typically include multiple levels of detail (LOD), physically-based rendering (PBR) material maps, skeletal rigs, and collision meshes. Effective 3D asset pipelines integrate version control, DRM provenance tracking, and automated quality assurance workflows to support diverse hardware configurations."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:3-d-asset-standard ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:physically-based-rendering ],
        ngm:digital-asset-management,
        ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:enables ngm:digital-twin,
        ngm:metaverse ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:3-d-asset-standard,
        ngm:physically-based-rendering ;
    vc:slug "3-d-asset" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:gltf-standard,
        ngm:level-of-detail .

ngm:code-generation a owl:Class ;
    rdfs:label "Code Generation"@en ;
    rdfs:comment "The automated production of source code by AI systems from natural language specifications, partial code, or structured prompts. Code generation systems leverage large language models trained on code corpora to synthesise functions, classes, and complete programs, accelerating software development workflows."@en ;
    rdfs:subClassOf ngm:ai-application,
        ngm:generative-ai ;
    skos:broader ngm:ai-application ;
    vc:enables ngm:documentation-generation,
        ngm:software-development-process ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:infra-software-engineering ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:natural-language-processing,
        ngm:software-architecture,
        ngm:software-testing ;
    vc:slug "code-generation" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:large-language-models,
        ngm:prompt-engineering,
        ngm:transformer .

ngm:collaboration-platform a owl:Class ;
    rdfs:label "Collaboration Platform"@en ;
    rdfs:comment "A Collaboration Platform is an integrated software infrastructure that unifies communication channels, content management, workflow automation, and coordination tools to support distributed teamwork. Contemporary platforms combine real-time messaging, video conferencing, shared workspaces, and third-party integration ecosystems within API-first architectures."@en ;
    rdfs:subClassOf ngm:infra-computing-and-cloud ;
    skos:broader ngm:infra-computing-and-cloud ;
    vc:bridgesTo ngm:metaverse-and-telecollaboration ;
    vc:enables ngm:augmented-reality-collaboration,
        ngm:digital-twin-collaboration ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:xr-meeting-space ;
    vc:slug "collaboration-platform" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:edge-computing .

ngm:digital-infrastructure a owl:Class ;
    rdfs:label "Digital Infrastructure"@en ;
    rdfs:comment "The foundational computing, networking, and storage systems that underpin large-scale digital services and telecollaboration platforms, including hyperscale data centres with GPU clusters, content delivery networks, software-defined networking, and edge computing nodes. Digital infrastructure is increasingly defined by cloud-native patterns—containerisation, orchestration, and infrastructure-as-code—enabling programmatic resource allocation and resilient, globally distributed deployments."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:edge-computing ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:network-infrastructure ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:content-delivery-network ],
        ngm:infra-computing-and-cloud ;
    skos:broader ngm:infra-computing-and-cloud ;
    vc:enables ngm:distributed-systems,
        ngm:orchestration ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:content-delivery-network,
        ngm:edge-computing,
        ngm:network-infrastructure ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:blockchain ;
    vc:slug "digital-infrastructure" ;
    vc:sourceDomain "infrastructure" .

ngm:eye-tracking a owl:Class ;
    rdfs:label "Eye Tracking"@en ;
    rdfs:comment "Physical sensor hardware that measures gaze direction, pupil dilation, and eye movements to enable foveated rendering, attention analytics, and natural interaction in XR devices."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:optical-calibration-target ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:infrared-led-illuminator ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:infrared-light-source ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:infrared-camera ],
        ngm:infrared-camera,
        ngm:sc-interaction ;
    skos:broader ngm:sc-interaction ;
    vc:enables ngm:attention-analytics,
        ngm:eye-gesture-control,
        ngm:foveated-rendering,
