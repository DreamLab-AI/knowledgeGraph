ngm:robot-safety a owl:Class ;
    rdfs:label "Robot Safety"@en ;
    rdfs:comment "Robot Safety encompasses the engineering principles, risk assessment methods, and regulatory standards that ensure robotic systems operate without causing harm to humans, other machines, or the environment. It includes functional safety standards (ISO 10218, ISO 13849), collaborative robot (cobot) application requirements, dynamic risk assessment, and the emerging challenges of AI-integrated and autonomous robot deployment in shared workspaces."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:sensor-fusion ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:functional-safety ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:risk-assessment ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:collision-avoidance ],
        ngm:robo-safety-and-standards ;
    skos:broader ngm:robo-safety-and-standards ;
    vc:bridgesTo ngm:ai-safety,
        ngm:cybersecurity ;
    vc:contrastsWith ngm:traditional-industrial-robotics ;
    vc:dependsOn ngm:motion-planning,
        ngm:robot-dynamics,
        ngm:state-estimation ;
    vc:enables ngm:autonomous-systems,
        ngm:collaborative-robotics,
        ngm:human-robot-interaction ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:functional-safety,
        ngm:risk-assessment,
        ngm:safety-monitoring ;
    vc:implements ngm:iec-62061,
        ngm:iso-10218,
        ngm:iso-13849 ;
    vc:isPartOf ngm:industrial-automation,
        ngm:robotics ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:human-factors-engineering,
        ngm:safety-integrity-level ;
    vc:requires ngm:collision-avoidance,
        ngm:force-torque-sensing,
        ngm:real-time-systems,
        ngm:sensor-fusion ;
    vc:slug "robot-safety" ;
    vc:sourceDomain "robotics" ;
    vc:standardizedBy ngm:iec,
        ngm:ieee,
        ngm:iso ;
    vc:supports ngm:human-robot-collaboration,
        ngm:workplace-safety ;
    vc:uses ngm:computer-vision,
        ngm:digital-twin,
        ngm:machine-learning .

ngm:self-supervised-learning a owl:Class ;
    rdfs:label "Self-Supervised Learning"@en ;
    rdfs:comment "Self-Supervised Learning (SSL) is a machine learning paradigm in which a model learns rich representations of data by solving pretext tasks whose supervisory signal is derived automatically from the input data itself, requiring no human-provided labels. The model learns to predict masked or hidden portions of an input, to match different views of the same data, or to distinguish positive from negative data pairs, developing features that transfer effectively to downstream supervised tasks with limited labelled data. Self-supervised learning has become the dominant pre-training strategy for large language models, visual foundation models, and multimodal systems, enabling training at scales that would be infeasible with manually annotated datasets."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:contrastive-learning ],
        ngm:machine-learning-discipline-technique ;
    vc:bridgesTo ngm:robotics-perception,
        ngm:spatial-ai ;
    vc:contrastsWith ngm:supervised-learning,
        ngm:unsupervised-learning ;
    vc:dependsOn ngm:data-augmentation,
        ngm:neural-network ;
    vc:enables ngm:large-scale-pretrained-foundation-model,
        ngm:parameter-efficient-fine-tuning,
        ngm:transfer-learning,
        ngm:zero-shot-learning ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:contrastive-learning,
        ngm:masked-image-modelling,
        ngm:masked-language-modelling ;
    vc:isPartOf ngm:representation-learning ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:generative-adversarial-network,
        ngm:multimodal-learning,
        ngm:semi-supervised-learning ;
    vc:requires ngm:pretext-task,
        ngm:unlabelled-data ;
    vc:slug "self-supervised-learning" ;
    vc:sourceDomain "machine-learning" ;
    vc:supports ngm:computer-vision,
        ngm:deep-learning,
        ngm:natural-language-processing ;
    vc:uses ngm:encoder-decoder-architecture,
        ngm:pretrained-model,
        ngm:transformer-architecture .

