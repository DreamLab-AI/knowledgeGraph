ngm:digital-twin-construction a owl:Class ;
    rdfs:label "Digital Twin Construction"@en ;
    rdfs:comment "The application of digital twin technology within the architecture, engineering, and construction (AEC) industry, extending BIM capabilities through real-time sensor integration and IoT connectivity to create dynamic virtual replicas of buildings and infrastructure throughout their lifecycle."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cloud-platform ],
        [ a owl:Restriction ;
