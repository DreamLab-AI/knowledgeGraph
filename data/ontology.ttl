ngm:immersive-media a owl:Class ;
    rdfs:label "Immersive Media"@en ;
    rdfs:comment "Immersive media is content designed to surround and respond to the viewer so they perceive themselves as present within the experience rather than observing it from outside. It spans virtual, augmented and mixed reality, 360-degree and volumetric video, and spatial audio, typically consumed through head-mounted displays or spatial devices. Effective immersive media combines stereoscopic visuals, spatialised sound and low-latency tracking to sustain the sense of presence."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:head-mounted-display ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:rendering ],
        ngm:interactive-media ;
    vc:enables ngm:immersive-experience,
        ngm:presence ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:metaverse,
        ngm:spatial-computing ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:photogrammetry,
        ngm:spatial-mapping,
        ngm:user-generated-content ;
    vc:requires ngm:head-mounted-display,
        ngm:rendering ;
    vc:slug "immersive-media" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:content-creation,
        ngm:mixed-reality ;
    vc:uses ngm:augmented-reality,
        ngm:spatial-audio,
        ngm:virtual-reality .

ngm:importer a owl:Class ;
    rdfs:label "Importer"@en ;
    rdfs:comment "A natural or legal person located or established in the Union that places on the market an AI system that bears the name or trademark of a natural or legal person established in a third country."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ai-regulation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:legal-compliance ],
        ngm:sc-standards-and-interop ;
    skos:broader ngm:sc-standards-and-interop ;
    vc:dependsOn ngm:legal-framework ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:ai-governance,
        ngm:supply-chain ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:accountability,
        ngm:risk-management ;
    vc:requires ngm:ai-regulation,
        ngm:legal-compliance ;
    vc:slug "importer" ;
    vc:sourceDomain "spatial-computing" .

ngm:in-camera-vfx a owl:Class ;
    rdfs:label "In-Camera VFX"@en ;
    rdfs:comment "In-camera visual effects (ICVFX) is a virtual-production technique in which final-pixel visual effects are captured live during photography, typically by displaying real-time rendered 3D environments on large LED volumes behind the actors. Camera tracking drives the rendered background's perspective so that parallax and lighting match the physical camera, producing realistic in-camera composites without later green-screen keying. ICVFX collapses much of post-production into the shoot itself."@en ;
    rdfs:subClassOf ngm:rendering-technique ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:virtual-production-vp ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:slug "in-camera-vfx" ;
    vc:sourceDomain "metaverse" ;
    vc:uses ngm:virtual-production-volume .

ngm:inception-v3 a skos:Concept ;
    rdfs:label "Inception V3"@en .

ngm:inclusive-growth a owl:Class ;
    rdfs:label "Inclusive Growth"@en ;
    rdfs:comment "AI should benefit people and planet by augmenting human capabilities, enhancing creativity, advancing inclusion of underrepresented populations, reducing economic, social and geographical inequalities, and protecting natural environments, thereby invigorating inclusive growth, sustainable develop..."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
