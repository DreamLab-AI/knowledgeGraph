ngm:ed25519 a owl:Class ;
    rdfs:label "Ed25519"@en ;
    rdfs:comment "Ed25519 is a high-performance elliptic-curve digital signature scheme instantiated on the Twisted Edwards curve over the prime field GF(2^255-19), offering approximately 128 bits of security with deterministic signing and compact 64-byte signatures. Designed by Bernstein, Duif, Lange, Schwabe, and Yang, it is engineered to resist side-channel attacks through constant-time implementation properties and eliminates the weak-nonce vulnerabilities that affect ECDSA. Ed25519 is standardised in RFC 8032 and FIPS 186-5, and is widely deployed across blockchain networks, SSH authentication, TLS handshakes, and decentralised identity systems."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:private-key ],
        ngm:digital-signature ;
    vc:bridgesTo ngm:blockchain,
        ngm:nostr-protocol,
        ngm:verifiable-credential ;
    vc:contrastsWith ngm:ecdsa,
        ngm:rsa ;
    vc:dependsOn ngm:hash-function,
        ngm:random-number-generation ;
    vc:enables ngm:authentication,
        ngm:non-repudiation,
        ngm:zero-knowledge-proof ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:implements ngm:elliptic-curve-cryptography,
        ngm:public-key-cryptography,
        ngm:schnorr-signature ;
    vc:isPartOf ngm:curve25519,
        ngm:twisted-edwards-curve ;
    vc:qualityScore "0.73"^^xsd:float ;
    vc:relatedTo ngm:ed448,
        ngm:post-quantum-cryptography,
        ngm:x25519 ;
    vc:requires ngm:private-key,
        ngm:public-key,
        ngm:sha-512 ;
    vc:slug "ed25519" ;
    vc:sourceDomain "security" ;
    vc:standardizedBy ngm:fips-186-5,
        ngm:rfc-8032 ;
    vc:supports ngm:decentralised-identity,
        ngm:secure-shell,
        ngm:verifiable-credential ;
    vc:uses ngm:constant-time-algorithm,
        ngm:deterministic-signing .

ngm:electric-motor a owl:Class ;
    rdfs:label "Electric Motor"@en ;
    rdfs:comment "Electric motor converts electrical energy into rotational mechanical power through electromagnetic forces, forming the most widespread actuation technology in modern robotics."@en ;
