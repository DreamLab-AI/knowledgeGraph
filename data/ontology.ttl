ngm:erasure-coding a owl:Class ;
    rdfs:label "Erasure Coding"@en ;
    rdfs:comment "Erasure coding is a forward error-correction (FEC) technique that encodes a data object into n encoded fragments (shards or chunks), distributed across nodes or storage devices, such that any k of those n fragments are sufficient to reconstruct the original data without any centralised copy. The redundancy overhead ratio (n − k) / k is typically far lower than full replication, making erasure coding the preferred durability mechanism in large-scale distributed storage, distributed ledger systems, and content-addressed networks where storage efficiency and fault tolerance are simultaneously required. Foundational schemes include Reed-Solomon codes (based on Galois Field arithmetic), as well as computationally efficient variants such as LDPC, Fountain codes (LT and Raptor), and Cauchy Reed-Solomon; newer constructions couple erasure codes with polynomial commitments (e.g. KZG) to provide data availability proofs in blockchain systems."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:ldpc-codes ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:reed-solomon-codes ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:distributed-storage ],
        ngm:forward-error-correction ;
    vc:bridgesTo ngm:danksharding,
        ngm:data-availability,
        ngm:distributed-ledger ;
    vc:contrastsWith ngm:data-replication,
        ngm:replication ;
    vc:dependsOn ngm:distributed-systems ;
    vc:enables ngm:data-availability-sampling,
        ngm:fault-tolerance,
        ngm:high-availability ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:galois-field-arithmetic,
        ngm:ldpc-codes,
        ngm:reed-solomon-codes ;
    vc:implements ngm:data-durability,
        ngm:forward-error-correction ;
    vc:isPartOf ngm:forward-error-correction,
        ngm:storage-infrastructure ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:network-coding,
        ngm:replication,
        ngm:secret-sharing ;
    vc:requires ngm:distributed-storage,
        ngm:galois-field-arithmetic ;
    vc:slug "erasure-coding" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:ceph,
        ngm:filecoin,
        ngm:ipfs,
        ngm:raid ;
    vc:uses ngm:kzg-commitment,
        ngm:linear-algebra,
        ngm:polynomial-commitment .

ngm:facial-recognition a owl:Class ;
    rdfs:label "Facial Recognition"@en ;
    rdfs:comment "Facial Recognition is a computer vision technology that automatically detects, aligns, and identifies or verifies individuals by analysing facial features extracted from images or video frames, producing compact numerical embeddings that encode discriminative facial geometry and appearance. These embeddings are compared against a gallery of known identities using similarity metrics (cosine similarity or L2 distance), operating in one-to-one verification mode (confirming claimed identity) or one-to-many identification mode (searching against a database of enrolled individuals). Modern systems rely on deep convolutional neural networks trained on large-scale labelled datasets and are subject to increasing regulatory oversight relating to accuracy disparities across demographic groups, privacy obligations, and prohibition in high-risk contexts under frameworks such as the EU AI Act."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:training-data ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:image-preprocessing ],
        ngm:computer-vision ;
    vc:bridgesTo ngm:digital-identity,
        ngm:smart-city ;
    vc:contrastsWith ngm:deepfake-detection,
        ngm:iris-recognition ;
    vc:enables ngm:access-control,
        ngm:biometric-verification,
        ngm:digital-identity-verification,
        ngm:surveillance ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:algorithmic-bias,
        ngm:data-protection,
        ngm:eu-ai-act-regulatory-instrument,
        ngm:privacy ;
    vc:requires ngm:image-preprocessing,
        ngm:training-data ;
    vc:slug "facial-recognition" ;
    vc:sourceDomain "ai" ;
    vc:standardizedBy ngm:iso-iec-19794 ;
    vc:uses ngm:biometric-authentication,
        ngm:camera,
        ngm:convolutional-neural-network,
        ngm:deep-learning,
        ngm:nearest-neighbor-search .

ngm:feature-matching a owl:Class ;
    rdfs:label "Feature Matching"@en ;
    rdfs:comment "Feature Matching is a computer vision technique that identifies and associates corresponding salient regions—keypoints and their descriptors—across two or more images or point clouds, enabling geometric relationships such as homographies, fundamental matrices, or rigid-body transformations to be estimated. Classical detectors such as SIFT, SURF, and ORB extract rotation- and scale-invariant descriptors; modern deep learning approaches learn matched embeddings end-to-end from training data. Feature matching is a foundational step in Structure-from-Motion, visual odometry, SLAM, and image-based localisation pipelines. The accuracy and efficiency of matching directly determine downstream reconstruction quality and real-time performance in robotics and augmented reality applications."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ransac ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:image-preprocessing ],
        ngm:computer-vision ;
    vc:bridgesTo ngm:augmented-reality,
        ngm:robotic-perception ;
    vc:contrastsWith ngm:optical-flow ;
    vc:enables ngm:localisation,
        ngm:photogrammetry,
        ngm:pose-estimation,
        ngm:slam,
        ngm:structure-from-motion,
        ngm:visual-odometry ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:epipolar-geometry ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:computer-vision-system,
        ngm:depth-sensing,
        ngm:image-retrieval,
        ngm:lidar,
        ngm:object-recognition,
        ngm:point-cloud ;
    vc:requires ngm:image-preprocessing,
        ngm:ransac ;
    vc:slug "feature-matching" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:deep-learning,
        ngm:depth-estimation,
        ngm:feature-extraction,
        ngm:keypoint-detection,
        ngm:nearest-neighbor-search,
        ngm:stereo-camera .

ngm:high-bandwidth-memory a owl:Class ;
    rdfs:label "High Bandwidth Memory"@en ;
    rdfs:comment "High Bandwidth Memory (HBM) is a 3D-stacked DRAM technology that places multiple memory dies on a silicon interposer adjacent to a processor, delivering very wide buses and high memory bandwidth at low power per bit. It is the standard memory for AI accelerators and GPUs where feeding compute units with data is the dominant bottleneck. HBM enables training and inference of large models that would otherwise be memory-bandwidth bound."@en ;
    rdfs:subClassOf ngm:hardware ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:compute-infrastructure,
        ngm:data-processing-hardware ;
    vc:slug "high-bandwidth-memory" ;
    vc:sourceDomain "infrastructure" .

ngm:iso-iec-42001 a owl:Class ;
    rdfs:label "ISO IEC 42001"@en ;
    rdfs:comment "ISO/IEC 42001:2023 is the first international management system standard specifically designed for artificial intelligence, published by ISO/IEC Joint Technical Committee 1, Subcommittee 42, establishing requirements for an AI Management System (AIMS) that organisations use to responsibly develop, provide, or use AI-based products and services. It follows the Annex SL high-level structure shared with ISO 9001 and ISO 27001, enabling seamless integration with existing management frameworks through a Plan-Do-Check-Act cycle covering context, leadership, planning, support, operation, performance evaluation, and improvement. The normative Annex A provides a reference control set addressing data governance, transparency, human oversight, algorithmic accountability, and AI supply-chain management, from which organisations select controls according to their risk profile. Certification by accredited third-party audit bodies offers independent assurance of AI governance maturity and serves as a documented compliance aid for regulations such as the EU AI Act."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ai-impact-assessment ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:human-oversight ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-governance ],
        ngm:ai-governance-and-ethics ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:bridgesTo ngm:eu-ai-act-regulatory-instrument,
        ngm:nist-ai-rmf ;
    vc:contrastsWith ngm:ieee-7000,
        ngm:iso-iec-23894 ;
    vc:enables ngm:continuous-improvement,
        ngm:third-party-verification ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:ai-regulation,
        ngm:compliance-framework,
        ngm:iso-9001,
        ngm:iso-iec-27001,
        ngm:iso-iec-27701 ;
    vc:requires ngm:ai-impact-assessment,
        ngm:data-governance,
        ngm:human-oversight ;
    vc:slug "iso-iec-42001" ;
    vc:sourceDomain "governance" ;
    vc:standardizedBy ngm:ai-governance-framework,
        ngm:iso-iec-jtc1-sc42 ;
    vc:supports ngm:ai-risk-management,
        ngm:algorithmic-accountability,
        ngm:responsible-ai,
        ngm:transparency .

ngm:licensing a owl:Class ;
    rdfs:label "Licensing"@en ;
    rdfs:comment "Licensing is the legal mechanism by which the holder of a right, such as a copyright, patent, trademark, or regulatory permission, grants another party permission to use it under specified terms. A licence defines the scope, duration, territory, and conditions of permitted use without transferring ownership of the underlying asset. In software and data, licensing governs how code, models, and datasets may be copied, modified, redistributed, and commercialised."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:copyright ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:creative-commons ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:intellectual-property-rights ],
        ngm:governance ;
    vc:contrastsWith ngm:patent ;
    vc:dependsOn ngm:intellectual-property-rights ;
    vc:enables ngm:open-science ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:creative-commons,
        ngm:terms-of-service ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:compliance,
        ngm:patent,
        ngm:regulatory-compliance ;
    vc:requires ngm:copyright,
        ngm:intellectual-property-rights ;
    vc:slug "licensing" ;
    vc:sourceDomain "governance" ;
    vc:supports ngm:open-data,
        ngm:open-source,
        ngm:open-source-software .

ngm:light-client a owl:Class ;
    rdfs:label "Light Client"@en ;
    rdfs:comment "Resource-efficient blockchain client that validates block headers and uses cryptographic proofs (Merkle proofs, state proofs) to verify transaction inclusion without downloading full blockchain state. Light clients enable trustless interaction from mobile devices, browsers, and IoT systems while requiring only megabytes of storage versus gigabytes for full nodes."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:merkle-proof ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:block-header ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:peer-to-peer-network ],
        ngm:node ;
    vc:bridgesTo ngm:edge-computing,
        ngm:iot-device ;
    vc:contrastsWith ngm:archive-node,
        ngm:full-node ;
    vc:dependsOn ngm:consensus-mechanism,
        ngm:cryptographic-hash-function ;
    vc:enables ngm:cross-chain-bridge,
        ngm:wallet ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:merkle-proof ;
    vc:implements ngm:state-proof ;
    vc:isPartOf ngm:blockchain-network,
        ngm:interoperability-protocol ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:fraud-proof ;
    vc:requires ngm:block-header,
        ngm:peer-to-peer-network ;
    vc:slug "light-client" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:decentralised-application,
        ngm:relayer ;
    vc:uses ngm:bls-signature,
        ngm:merkle-tree,
        ngm:zero-knowledge-proof .

