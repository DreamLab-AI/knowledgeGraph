ngm:batch-inference a owl:Class ;
    rdfs:comment "The process of applying a trained machine learning model to a collection of inputs simultaneously rather than processing each input individually in real time. Batch inference amortises per-request overhead by grouping inputs into tensors that saturate GPU or accelerator memory bandwidth, significantly reducing per-sample latency at scale. It is the dominant serving pattern for offline analytics, embedding generation, and large-scale data enrichment pipelines where latency deadlines are relaxed. Contrast with online inference, which prioritises low single-request latency over throughput."@en ;
    rdfs:label "Batch Inference"@en ;
    rdfs:subClassOf ngm:ai-infrastructure ;
    rdfs:subClassOf ngm:machine-learning-discipline ;
