ngm:safe-ai-deployment a owl:Class ;
    rdfs:comment "Safe AI deployment is the set of engineering and governance practices applied when releasing an AI system into production so that it operates within intended bounds, degrades gracefully, and remains subject to human oversight. It draws on techniques from AI safety and AI alignment, including staged rollouts, monitoring, kill switches, and red-teaming, to reduce the risk of harmful or unintended behaviour once a model is exposed to real users. It is the operational counterpart to alignment research, translating safety properties validated offline into guarantees that hold in live systems."@en ;
    rdfs:label "Safe AI Deployment"@en ;
    rdfs:subClassOf ngm:ai-safety ;
    rdfs:subClassOf _:r18665 ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.5"^^xsd:float ;
