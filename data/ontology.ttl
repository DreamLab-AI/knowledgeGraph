        ngm:regulatory-compliance ;
    vc:slug "risk" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:risk-mitigation a owl:Class ;
    rdfs:label "Risk Mitigation"@en ;
    rdfs:comment "Actions taken to reduce the likelihood or impact of identified AI risks through technical, organizational, or procedural controls, implemented throughout the AI lifecycle to achieve acceptable risk levels."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:risk-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ai-safety ],
        ngm:ai-governance-and-ethics ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:enables ngm:compliance-framework,
        ngm:robustness ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:ai-governance-principle,
        ngm:bias-mitigation-techniques ;
    vc:requires ngm:ai-safety,
        ngm:risk-management ;
    vc:slug "risk-mitigation" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:rotary-encoder a owl:Class ;
    rdfs:label "Rotary Encoder"@en ;
    rdfs:comment "A rotary encoder is an electromechanical transducer that converts shaft angular position or velocity into digital pulses or absolute position codes. Incremental encoders output A/B quadrature pulses enabling direction and relative position measurement; absolute encoders output a unique binary code at every shaft position. Used ubiquitously in robot joints, servo motors, and motion-control systems for precise closed-loop feedback."@en ;
    rdfs:subClassOf ngm:encoder,
        ngm:robo-perception ;
    skos:broader ngm:robo-perception ;
    vc:enables ngm:simultaneous-localisation-and-mapping ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:dc-servo-motor,
        ngm:force-torque-sensor,
        ngm:imu,
        ngm:odometry,
        ngm:servo-motor,
        ngm:stepper-motor ;
    vc:slug "rotary-encoder" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:feedback-control,
        ngm:pid-controller .

ngm:safety-assessment a owl:Class ;
    rdfs:label "Safety Assessment"@en ;
    rdfs:comment "Safety assessment is a systematic analytical process that identifies, evaluates, and mitigates hazards associated with a system, product, or operational process to demonstrate that residual risk is tolerable within accepted standards and regulatory frameworks. It encompasses methods such as Failure Modes and Effects Analysis (FMEA), Fault Tree Analysis (FTA), Hazard and Operability Studies (HAZOP), and probabilistic safety analysis, applied across domains including aerospace, automotive, nuclear, medical devices, and increasingly AI systems. Safety assessments form the evidentiary basis for certification against safety standards such as IEC 61508 and ISO 26262."@en ;
    rdfs:subClassOf ngm:risk-assessment ;
    vc:enables ngm:ai-risk-assessment,
        ngm:safety-critical-systems ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:iec-61508,
        ngm:iso-26262,
        ngm:safety-standard ;
    vc:slug "safety-assessment" ;
    vc:sourceDomain "governance" ;
    vc:uses ngm:functional-safety,
        ngm:hazard-analysis,
        ngm:risk-assessment-methodology .

ngm:safety-fine-tuning a owl:Class ;
    rdfs:label "Safety Fine Tuning"@en ;
    rdfs:comment "Safety Fine Tuning is a specialised training stage applied after general capability training to reduce harmful outputs and align model behaviour with safety principles. It employs safety-curated datasets, RLHF, and constitutional AI objectives to harden models against adversarial misuse and emergent misalignment."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:training-data ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:reinforcement-learning-from-human-feedback ],
        ngm:ai-alignment,
        ngm:ai-governance-and-ethics ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:contrastsWith ngm:adversarial-attack ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:robustness ;
    vc:requires ngm:reinforcement-learning-from-human-feedback,
        ngm:training-data ;
    vc:slug "safety-fine-tuning" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:ai-safety,
        ngm:value-alignment .

ngm:sanctions-enforcement a owl:Class ;
    rdfs:label "Sanctions Enforcement"@en ;
    rdfs:comment "Sanctions enforcement is the regulatory and operational process by which financial institutions, governments, and technology platforms identify, screen, and block transactions, assets, and relationships involving sanctioned individuals, entities, or jurisdictions as designated by authorities such as OFAC, the UN Security Council, the European Union, or HM Treasury. It encompasses real-time screening of payment flows against consolidated sanctions lists, asset-freezing procedures, reporting obligations, and the maintenance of audit trails demonstrating compliance. In digital asset and blockchain contexts, sanctions enforcement extends to on-chain transaction monitoring and the blocking of wallet addresses associated with designated parties."@en ;
    rdfs:subClassOf ngm:compliance-framework ;
    vc:enables ngm:aml-kyc-compliance,
        ngm:compliance-audit-trail ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:anti-money-laundering,
        ngm:fatf,
        ngm:sanctions-screening ;
    vc:slug "sanctions-enforcement" ;
    vc:sourceDomain "governance" ;
    vc:supports ngm:financial-regulation ;
    vc:uses ngm:blockchain-analytics,
        ngm:regulatory-reporting .

ngm:scene-management a owl:Class ;
    rdfs:label "Scene Management"@en ;
    rdfs:comment "Scene Management encompasses the runtime systems and data structures responsible for organising, loading, and unloading 3D scene content in real-time environments. It coordinates scene graph traversal, hierarchical object relationships, asset streaming, and spatial partitioning to ensure that only geometrically and logically relevant content is active at any moment, enabling scalable and performant virtual worlds."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:ar-scene-graph ],
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:enables ngm:occlusion-culling,
        ngm:scene-optimization ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:ar-scene-graph ;
    vc:isPartOf ngm:render-pipeline ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:slug "scene-management" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:asset-management,
        ngm:level-of-detail .

ngm:science-based-targets a owl:Class ;
    rdfs:label "Science Based Targets"@en ;
    rdfs:comment "Science Based Targets (SBTs) are greenhouse gas emission reduction targets set by companies in alignment with the level of decarbonisation required by climate science to limit global warming to 1.5°C above pre-industrial levels, as defined by the Science Based Targets initiative (SBTi). Targets are validated by the SBTi against approved methods including absolute contraction, sectoral decarbonisation approach, and economy-wide linear regression, and must cover Scope 1 and Scope 2 emissions with a growing requirement to include Scope 3."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:scope-3-emissions ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ghg-protocol-corporate-standard ],
        ngm:sustainability-framework ;
    vc:enables ngm:decarbonisation,
        ngm:net-zero-targets ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:paris-agreement ;
    vc:requires ngm:ghg-protocol-corporate-standard,
        ngm:scope-3-emissions ;
    vc:slug "science-based-targets" ;
    vc:sourceDomain "governance" ;
    vc:standardizedBy ngm:sbti .

ngm:scope-1-emissions a owl:Class ;
    rdfs:label "Scope 1 Emissions"@en ;
    rdfs:comment "Scope 1 emissions are direct greenhouse gas (GHG) emissions from sources that are owned or controlled by a reporting organisation, as defined by the GHG Protocol Corporate Standard. They include combustion of fuels in owned vehicles, boilers, and furnaces; process emissions from chemical or physical reactions in production; and fugitive emissions from refrigerant leaks, methane from waste operations, and similar inadvertent releases. Scope 1 emissions are denominated in CO2-equivalent (CO2e) tonnes and represent the most controllable category of an organisation's carbon footprint."@en ;
    rdfs:subClassOf ngm:carbon-accounting ;
    vc:enables ngm:carbon-neutrality-planning,
        ngm:esg-reporting,
        ngm:sustainability-reporting ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:emission-factors,
        ngm:ghg-protocol,
        ngm:scope-2-emissions,
        ngm:scope-3-emissions ;
    vc:slug "scope-1-emissions" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:carbon-footprint-measurement,
        ngm:environmental-accounting .

ngm:search-engine a owl:Class ;
    rdfs:label "Search Engine"@en ;
    rdfs:comment "Software systems that crawl, index, and retrieve digital content based on user queries, using algorithms for relevance ranking, natural language processing, and increasingly semantic understanding to connect users with metaverse assets and experiences."@en ;
    rdfs:subClassOf ngm:information-retrieval,
        ngm:sc-standards-and-interop ;
    skos:broader ngm:sc-standards-and-interop ;
    vc:enables ngm:content-discovery ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:slug "search-engine" ;
    vc:sourceDomain "spatial-computing" .

ngm:self-supervised-learning a owl:Class ;
    rdfs:label "Self-Supervised Learning"@en ;
    rdfs:comment "Self-Supervised Learning (SSL) is a machine learning paradigm in which a model learns rich representations of data by solving pretext tasks whose supervisory signal is derived automatically from the input data itself, requiring no human-provided labels. The model learns to predict masked or hidden portions of an input, to match different views of the same data, or to distinguish positive from negative data pairs, developing features that transfer effectively to downstream supervised tasks with limited labelled data. Self-supervised learning has become the dominant pre-training strategy for large language models, visual foundation models, and multimodal systems, enabling training at scales that would be infeasible with manually annotated datasets."@en ;
    rdfs:subClassOf ngm:machine-learning-technique ;
    vc:enables ngm:foundation-models,
        ngm:parameter-efficient-fine-tuning ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:contrastive-learning,
        ngm:semi-supervised-learning,
        ngm:unsupervised-learning ;
    vc:slug "self-supervised-learning" ;
    vc:sourceDomain "ai" ;
    vc:supports ngm:deep-learning ;
    vc:uses ngm:pretrained-model,
        ngm:transformer-architecture .

ngm:semi-supervised-learning a owl:Class ;
    rdfs:label "Semi-Supervised Learning"@en ;
    rdfs:comment "Semi-Supervised Learning is a artificial intelligence concept and a type of Machine Learning. that enables Data-Efficient Learning."@en ;
    rdfs:subClassOf ngm:ai-technique,
        ngm:machine-learning ;
    skos:broader ngm:ai-technique ;
    vc:enables ngm:data-efficient-learning ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:slug "semi-supervised-learning" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:sensor-networks a owl:Class ;
    rdfs:label "Sensor Networks"@en ;
    rdfs:comment "Sensor networks are distributed collections of sensor nodes that collect, process and communicate measurements about their environment."@en ;
    rdfs:subClassOf ngm:sensors ;
    vc:enables ngm:sensor-fusion ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:slug "sensor-networks" ;
    vc:sourceDomain "robotics" .

ngm:serverless-architecture a owl:Class ;
    rdfs:label "Serverless Architecture"@en ;
    rdfs:comment "Serverless Architecture is a cloud execution model in which application logic is deployed as discrete, stateless functions that are provisioned and scaled automatically by the cloud provider in response to events, with billing proportional to actual execution time. By abstracting away server provisioning and capacity management, serverless architectures reduce operational overhead and enable fine-grained, event-driven compute patterns suited to metaverse backends, AI inference endpoints, and IoT data pipelines."@en ;
    rdfs:subClassOf ngm:infra-computing-and-cloud ;
    skos:broader ngm:infra-computing-and-cloud ;
    vc:contrastsWith ngm:computing-infrastructure ;
    vc:enables ngm:cloud-native-applications,
        ngm:microservices-architecture ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:software-infrastructure ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:slug "serverless-architecture" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:cloud-infrastructure,
        ngm:event-driven-architecture .

ngm:service-layer a owl:Class ;
    rdfs:label "Service Layer"@en ;
    rdfs:comment "Collection of reusable services exposed via APIs for identity, assets, physics, and analytics that enable application functionality and interoperability in virtual environments."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:asset-service ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-models ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:identity-service ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:api-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:api-gateway ],
        ngm:sc-platform-and-environment,
        ngm:spatial-computing-layer ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:enables ngm:api-integration,
        ngm:microservices-architecture,
        ngm:service-composition,
        ngm:service-discovery ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:analytics-service,
        ngm:api-gateway,
        ngm:asset-service,
        ngm:identity-service,
        ngm:physics-service ;
    vc:isPartOf ngm:data-layer ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:api-management,
        ngm:data-models,
        ngm:service-orchestration ;
    vc:slug "service-layer" ;
    vc:sourceDomain "spatial-computing" .

ngm:smart-manufacturing a owl:Class ;
    rdfs:label "Smart Manufacturing"@en ;
    rdfs:comment "Smart manufacturing is an integrated approach to industrial production that embeds advanced sensing, connectivity, data analytics, and artificial intelligence throughout the production system to achieve real-time visibility, adaptive control, and continuous optimisation of manufacturing processes. It combines cyber-physical systems, the Industrial Internet of Things, digital twins, machine learning, and cloud and edge computing to create intelligent factories capable of self-monitoring, predictive maintenance, and autonomous quality control. Smart manufacturing extends beyond factory automation to encompass supply chain integration, mass customisation, and sustainability optimisation, representing the operational realisation of the Industry 4.0 paradigm."@en ;
    rdfs:subClassOf ngm:manufacturing-automation ;
    vc:enables ngm:industrial-automation,
        ngm:predictive-maintenance,
        ngm:supply-chain-management ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:industrial-metaverse,
        ngm:precision-manufacturing ;
    vc:slug "smart-manufacturing" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:cyber-physical-systems,
        ngm:digital-twin,
        ngm:industrial-io-t .

ngm:social-media a owl:Class ;
    rdfs:label "social media"@en ;
    rdfs:comment "Digital platforms and applications that enable users to create, share, and interact with user-generated content within networked communities. Social media platforms combine content distribution infrastructure, algorithmic recommendation, identity and profile management, and real-time communication at scale. They are significant vectors for AI application (content moderation, recommendation, advertising optimisation) and raise governance challenges around bias, privacy, and misinformation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:platform-governance ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:content-delivery-network ],
        ngm:infra-network-and-comms ;
    skos:broader ngm:infra-network-and-comms ;
    vc:enables ngm:distributed-collaboration ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:bias,
        ngm:privacy,
        ngm:social-platform ;
    vc:requires ngm:content-delivery-network,
        ngm:platform-governance ;
    vc:slug "social-media" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:content-moderation,
        ngm:machine-learning .

ngm:social-network-graph a owl:Class ;
    rdfs:label "Social Network Graph"@en ;
    rdfs:comment "A graph-theoretic representation of social relationships in which nodes denote individuals or entities and edges encode interactions, follows, or trust links. Social network graphs underpin recommendation systems, community detection, influence analysis, and decentralised identity federation protocols such as Nostr and ActivityPub."@en ;
    rdfs:subClassOf ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:enables ngm:identity-federation,
        ngm:virtual-community-platform ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:federation-surface,
        ngm:knowledge-graph ;
    vc:slug "social-network-graph" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:digital-identity,
        ngm:nostr-protocol .

ngm:sound-money a owl:Class ;
    rdfs:label "Sound Money"@en ;
    rdfs:comment "Sound Money refers to a monetary medium characterised by a stable, predictable supply that cannot be arbitrarily expanded by a government or central authority, thereby preserving purchasing power over time and functioning as a reliable store of value. The concept is historically associated with commodity-backed currencies—particularly the classical gold standard—and in the contemporary context with Bitcoin's algorithmically fixed supply schedule. Sound money theorists, drawing heavily on the Austrian School, argue that monetary expansion through credit creation distorts price signals, misallocates capital, and produces inflationary cycles that systematically transfer wealth from savers to debtors and from the public to the financial sector. The notion stands in direct opposition to the discretionary monetary policy frameworks of modern central banking."@en ;
    rdfs:subClassOf ngm:monetary-system ;
    vc:contrastsWith ngm:central-bank-digital-currency,
        ngm:monetary-policy-implementation ;
    vc:enables ngm:bitcoin-value-proposition,
        ngm:hyperbitcoinization ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:austrian-economics,
        ngm:bitcoin-standard,
        ngm:gold,
        ngm:inflation ;
    vc:slug "sound-money" ;
    vc:sourceDomain "finance" .

ngm:sparql-endpoint a owl:Class ;
    rdfs:label "SPARQL Endpoint"@en ;
    rdfs:comment "A SPARQL Endpoint is a network-accessible service that accepts SPARQL Protocol and RDF Query Language queries and returns structured results over HTTP, enabling federated access to RDF knowledge graphs and linked data stores. It acts as the primary interface between client applications and triple stores, supporting SELECT, CONSTRUCT, ASK, and UPDATE operations. SPARQL Endpoints are foundational to the Semantic Web stack and to provenance-aware knowledge graph systems."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:sparql-query-engine ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:query-processor ],
        ngm:data-access-interface,
        ngm:sc-standards-and-interop ;
    skos:broader ngm:sc-standards-and-interop ;
    vc:enables ngm:knowledge-graph,
        ngm:linked-data,
        ngm:provenance-ontology-prov-o ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:query-processor,
        ngm:sparql-query-engine ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:database-query,
        ngm:graph-database,
        ngm:knowledge-representation,
        ngm:semantic-web,
        ngm:sparql-examples ;
    vc:slug "sparql-endpoint" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:json-ld,
        ngm:rdf,
        ngm:sparql .

ngm:spatial-data-structure a owl:Class ;
    rdfs:label "Spatial Data Structure"@en ;
    rdfs:comment "A Spatial Data Structure is a data organisation scheme that indexes geometric or geographic information to enable efficient queries over position, proximity, and containment. Examples include octrees, k-d trees, BVH hierarchies, R-trees, and spatial hash grids, each offering different trade-offs between build cost, query performance, and dynamic update capability for real-time 3D applications."@en ;
    rdfs:subClassOf ngm:sc-display-and-rendering ;
    skos:broader ngm:sc-display-and-rendering ;
    vc:enables ngm:collision-detection,
        ngm:ray-tracing,
        ngm:real-time-rendering ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:relatedTo ngm:physics-simulation,
        ngm:spatial-mapping ;
    vc:slug "spatial-data-structure" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:scene-graph .

ngm:spatial-mesh a owl:Class ;
    rdfs:label "Spatial Mesh"@en ;
    rdfs:comment "A three-dimensional geometric representation of real-world environments created through spatial mapping, where surfaces are reconstructed as interconnected polygonal meshes to enable accurate placement and occlusion of virtual objects in augmented reality applications."@en ;
    rdfs:subClassOf ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:enables ngm:ar-occlusion ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:slug "spatial-mesh" ;
    vc:sourceDomain "spatial-computing" .

ngm:standards-compliance a owl:Class ;
    rdfs:label "Standards Compliance"@en ;
    rdfs:comment "The process of ensuring that systems, processes, products, or services meet the requirements of established technical standards, industry specifications, regulatory frameworks, and governance policies applicable to metaverse and virtual world technologies."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:compliance-framework ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:regulatory-framework ],
        ngm:ai-governance-and-ethics,
        ngm:standards ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:enables ngm:audit-trail,
        ngm:interoperability ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:compliance-framework,
        ngm:regulatory-framework ;
    vc:slug "standards-compliance" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:compliance-monitoring,
        ngm:compliance-verification .

ngm:stepper-motor a owl:Class ;
    rdfs:label "Stepper Motor"@en ;
    rdfs:comment "A stepper motor is an electromechanical actuator that divides a full rotation into a fixed number of discrete angular steps, enabling precise open-loop position control without requiring feedback sensors. By energising coils in sequence, the rotor advances one step per pulse, making stepper motors essential for applications demanding repeatable positioning such as CNC machining, 3D printing, and robotic joints."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:embedded-systems ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:encoder ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:open-loop-control ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:rotary-encoder ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:motion-control ],
        ngm:electric-motor,
        ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:contrastsWith ngm:dc-servo-motor,
        ngm:servo-motor ;
    vc:enables ngm:robotics-control,
        ngm:robotics-process ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:encoder,
        ngm:rotary-encoder ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:robot-actuator,
        ngm:robotics ;
    vc:requires ngm:embedded-systems,
        ngm:motion-control,
        ngm:open-loop-control ;
    vc:slug "stepper-motor" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:actuator,
        ngm:electric-actuator .

ngm:stereo-vision a owl:Class ;
    rdfs:label "Stereo Vision"@en ;
    rdfs:comment "Stereo vision is a computational technique that recovers metric depth information from a scene by analysing the horizontal displacement (disparity) between corresponding points in two or more rectified images captured from laterally separated viewpoints, mimicking the binocular parallax used by human and animal visual systems. The resulting dense disparity maps are converted into 3D point clouds or depth maps for downstream perception tasks."@en ;
    rdfs:subClassOf ngm:computer-vision ;
    vc:enables ngm:3-d-scene-reconstruction,
        ngm:depth-estimation,
        ngm:point-cloud-generation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:multi-view-stereo,
        ngm:optical-flow,
        ngm:slam ;
    vc:slug "stereo-vision" ;
    vc:sourceDomain "spatial" ;
    vc:uses ngm:camera-calibration,
        ngm:epipolar-geometry,
        ngm:feature-matching .

ngm:supply-chain-provenance a owl:Class ;
    rdfs:label "Supply Chain Provenance"@en ;
    rdfs:comment "Supply chain provenance is the verified documentary record of an item's origin, material composition, transformation steps, custody changes, and transportation history from raw material extraction through to the end consumer, enabling authenticity verification, ethical sourcing attestation, and regulatory compliance. It extends data provenance principles to physical goods, typically combining IoT sensor data, third-party audit records, and cryptographic anchors (hashes or blockchain transactions) to create an immutable chain of evidence that resists falsification and supports granular attribution."@en ;
    rdfs:subClassOf ngm:provenance-tracking ;
    vc:enables ngm:anti-counterfeiting,
        ngm:supply-chain-transparency ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:chain-of-custody,
        ngm:supply-chain,
        ngm:supply-chain-traceability ;
    vc:slug "supply-chain-provenance" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:provenance-verification ;
    vc:uses ngm:audit-trail,
        ngm:supply-chain-blockchain .

ngm:synchronization-protocol a owl:Class ;
    rdfs:label "Synchronization Protocol"@en ;
    rdfs:comment "A synchronization protocol is a set of rules by which distributed parties bring their state, clocks, or data into agreement despite operating independently and communicating over unreliable channels. It encompasses clock-synchronisation protocols (NTP, PTP) that align time across machines, and data-synchronisation protocols that reconcile divergent replicas using version vectors, operational transforms, or conflict-free replicated data types. Synchronization protocols are foundational to distributed databases, collaborative editing, mobile offline-first applications, and any system where multiple nodes must converge on a consistent view."@en ;
    rdfs:subClassOf ngm:network-protocol ;
    vc:enables ngm:fault-tolerance,
        ngm:replication ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:distributed-systems ;
    vc:slug "synchronization-protocol" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:clock-synchronization .

ngm:systemic-risk a owl:Class ;
    rdfs:label "Systemic Risk"@en ;
    rdfs:comment "Risk specific to high-impact capabilities of general-purpose AI models with significant impact on the Union market due to reach, or actual or foreseeable negative effects on public health, safety, fundamental rights, environment, democracy, or rule of law."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:adversarial-testing ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:risk-assessment ],
        ngm:ai-governance-and-ethics ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:enables ngm:conformity-assessment,
        ngm:red-teaming ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:relatedTo ngm:ai-regulation,
        ngm:cybersecurity,
        ngm:human-oversight ;
    vc:requires ngm:adversarial-testing,
        ngm:risk-assessment ;
    vc:slug "systemic-risk" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:third-party-auditor a owl:Class ;
    rdfs:label "Third Party Auditor"@en ;
    rdfs:comment "An independent security firm or organization that conducts comprehensive reviews of smart contracts, blockchain protocols, and digital systems to identify vulnerabilities, ensure code quality, and verify compliance before deployment."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:vulnerability ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:smart-contract ],
