vf:bitcoin-environmental-issues a owl:Class ;
    rdfs:label "Bitcoin Environmental Issues"@en ;
    rdfs:comment "**Bitcoin Environmental Issues** refers to the multi-dimensional ecological footprint generated by [[Bitcoin]]'s [[Proof of Work]] (PoW) consensus mechanism and the extensive [[ASIC]] mining hardware infrastructure that sustains it. The concept encompasses electricity consumption measured and tracked by the [[Cambridge Bitcoin Electricity Consumption Index]] ([[CBECI]]), greenhouse gas emissions expressed as CO₂ equivalent (CO₂e), electronic waste (e-waste) from specialised hardware with accelerated obsolescence cycles, water consumption in cooling systems, land use, and noise pollution. Counterbalancing arguments and empirical evidence document that Bitcoin mining can serve as a flexible demand sink for [[Stranded Energy]], a catalyst for [[Renewable Energy]] project development, a monetisation pathway for otherwise-vented [[Methane Emissions]] from fossil-fuel extraction sites, and a source of recoverable waste heat for district heating and agricultural applications."@en ;
    rdfs:subClassOf <urn:visionflow:linked:climate-finance>,
        <urn:visionflow:linked:digital-asset-ecology>,
        <urn:visionflow:linked:energy-economics>,
        <urn:visionflow:linked:environmental-impact-assessment>,
        vf:blockchain-sustainability ;
    vc:authorityScore "0.87"^^xsd:float ;
    vc:enables <urn:visionflow:linked:grid-demand-response>,
        <urn:visionflow:linked:heat-reuse-applications>,
        <urn:visionflow:linked:methane-emissions-reduction>,
        <urn:visionflow:linked:renewable-energy-integration>,
        <urn:visionflow:linked:stranded-energy-monetisation>,
        <urn:visionflow:linked:sustainable-bitcoin-certificates> ;
    vc:hasPart <urn:visionflow:linked:asic-e-waste>,
        <urn:visionflow:linked:carbon-credits>,
        <urn:visionflow:linked:cbeci>,
        <urn:visionflow:linked:demand-response-mining>,
        <urn:visionflow:linked:heat-reuse>,
        <urn:visionflow:linked:methane-mitigation-mining>,
        <urn:visionflow:linked:proof-of-work-energy-consumption>,
        <urn:visionflow:linked:stranded-energy-monetisation>,
        <urn:visionflow:linked:sustainable-bitcoin-protocol> ;
    vc:implements <urn:visionflow:linked:demand-response-protocol>,
        <urn:visionflow:linked:digital-flare-mitigation>,
        <urn:visionflow:linked:esg-disclosure-framework>,
