    vc:slug "token-embedding" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:fine-tuning,
        ngm:transfer-learning ;
    vc:uses ngm:deep-learning,
        ngm:vector-space-model .

ngm:trajectory-generation a owl:Class ;
    rdfs:label "Trajectory Generation"@en ;
    rdfs:comment "The process of computing a time-parameterized path that specifies the position, velocity, and acceleration of a robot's joints or end-effector as functions of time, enabling smooth motion from start to goal configurations while respecting kinematic and dynamic constraints."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:path-planning ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:goal-configuration ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:start-configuration ],
        ngm:motion-planning ;
    vc:bridgesTo ngm:model-predictive-control,
        ngm:reinforcement-learning ;
    vc:contrastsWith ngm:path-planning ;
    vc:dependsOn ngm:obstacle-avoidance,
        ngm:optimal-control ;
    vc:enables ngm:human-robot-collaboration,
        ngm:industrial-automation,
        ngm:task-execution ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:acceleration-profile,
        ngm:trajectory ;
    vc:isPartOf ngm:robot-control ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:requires ngm:goal-configuration,
        ngm:path-planning,
        ngm:start-configuration ;
    vc:slug "trajectory-generation" ;
    vc:sourceDomain "robotics" ;
    vc:supports ngm:autonomous-vehicle,
        ngm:surgical-robotics ;
    vc:uses ngm:forward-kinematics,
        ngm:inverse-kinematics,
        ngm:numerical-optimization,
        ngm:spline-interpolation .

ngm:transaction-pool a owl:Class ;
    rdfs:label "Transaction Pool"@en ;
    rdfs:comment "The Transaction Pool (mempool) is the in-memory distributed data structure held by each full node that stores validated but as-yet-unconfirmed transactions awaiting inclusion in a block. Nodes propagate transactions through the pool via gossip, miners and validators select transactions (typically by fee priority), and the pool is cleared as blocks confirm or transactions expire. Pool size, fee dynamics, and congestion directly determine user-experienced confirmation latency and cost."@en ;
    rdfs:subClassOf ngm:bc-network-component,
        ngm:blockchain-entity,
        ngm:distributed-data-structure ;
    skos:broader ngm:bc-network-component ;
    vc:enables ngm:fee-market,
        ngm:miner ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:blockchain-network ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:block-propagation,
        ngm:double-spending,
        ngm:mempool,
        ngm:network-synchronization ;
    vc:slug "transaction-pool" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:blockchain-transaction,
        ngm:gossip-protocol .

ngm:trusted-timestamping a owl:Class ;
    rdfs:label "Trusted Timestamping"@en ;
    rdfs:comment "Trusted timestamping is the process of securely recording the time at which a piece of data existed, using a trusted third party that cryptographically binds a hash of the data to an authoritative time and signs the result. Standardised by RFC 3161, it produces a timestamp token that proves data integrity and existence-by-time without revealing the data, and is used in digital signatures, legal record-keeping, intellectual-property protection, and regulatory compliance. It establishes a verifiable temporal ordering that survives even after signing keys expire."@en ;
    rdfs:subClassOf ngm:timestamping-service ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:public-key-cryptography ;
    vc:slug "trusted-timestamping" ;
    vc:sourceDomain "security" ;
    vc:uses ngm:digital-signature,
        ngm:hash-function,
        ngm:timestamp-authority .

ngm:u-net a owl:Class ;
    rdfs:label "U-Net"@en ;
    rdfs:comment "A convolutional neural network architecture with a symmetric encoder-decoder structure and skip connections, originally designed for biomedical image segmentation and widely adopted for dense prediction tasks including diffusion model denoising."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:batch-normalisation ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:encoder ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:residual-connection ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:decoder ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:convolution ],
        ngm:convolutional-neural-network ;
    vc:bridgesTo ngm:generative-adversarial-network,
        ngm:robotics-perception ;
    vc:contrastsWith ngm:feature-pyramid-network,
        ngm:vision-transformer ;
    vc:enables ngm:image-segmentation,
        ngm:instance-segmentation,
        ngm:semantic-segmentation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:decoder,
        ngm:encoder,
        ngm:residual-connection ;
    vc:implements ngm:encoder-decoder-architecture,
        ngm:feature-pyramid-network ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:transfer-learning ;
    vc:requires ngm:batch-normalisation,
        ngm:convolution ;
    vc:slug "u-net" ;
    vc:sourceDomain "machine-learning" ;
    vc:supports ngm:data-augmentation,
        ngm:diffusion-model,
        ngm:medical-image-analysis ;
    vc:uses ngm:cross-entropy-loss,
        ngm:dropout .

ngm:uniswap a owl:Class ;
    rdfs:label "Uniswap"@en ;
    rdfs:comment "Uniswap is a decentralised exchange (DEX) protocol deployed on Ethereum and EVM-compatible blockchains that enables permissionless, non-custodial token swaps through an Automated Market Maker (AMM) mechanism. Rather than maintaining an order book, it uses liquidity pools governed by the constant-product invariant (x × y = k), where liquidity providers deposit token pairs and earn fees proportional to their pool share. Successive protocol versions have introduced concentrated liquidity (v3), multiple fee tiers, multi-hop routing, and hook-based extensibility (v4), making Uniswap a foundational primitive of decentralised finance. Governance is managed by holders of the UNI governance token through on-chain voting."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:governance-token ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ethereum ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:liquidity-pool ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:liquidity-provider ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:web3-wallet ],
        ngm:bc-defi-and-economics ;
    skos:broader ngm:bc-defi-and-economics ;
    vc:bridgesTo ngm:decentralised-autonomous-organisation,
        ngm:layer-2-scaling ;
    vc:contrastsWith ngm:centralised-exchange,
        ngm:order-book-exchange ;
    vc:dependsOn ngm:on-chain-governance,
        ngm:price-oracle,
        ngm:token-economics ;
    vc:enables ngm:decentralised-finance,
        ngm:token-swapping,
        ngm:yield-farming ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:governance-token,
        ngm:liquidity-pool,
        ngm:router-contract ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:curve-finance,
        ngm:flash-loan,
        ngm:impermanent-loss,
        ngm:mev ;
    vc:requires ngm:ethereum,
        ngm:liquidity-provider,
        ngm:web3-wallet ;
    vc:slug "uniswap" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:automated-market-maker,
        ngm:erc-20,
        ngm:ethereum-smart-contract-platform-virtual-machine,
        ngm:smart-contract .

ngm:user-experience-design a owl:Class ;
    rdfs:label "User Experience Design"@en ;
    rdfs:comment "User Experience Design is the discipline of shaping the overall perception, ease and satisfaction a person derives from interacting with a product, system or service. It synthesises research into user needs, information architecture, interaction flows and visual presentation into coherent experiences. In spatial computing it extends to embodied, three-dimensional and multimodal interactions across mixed reality. The goal is to make systems useful, usable and desirable across their full lifecycle."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:user-research ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:information-architecture ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:user-interface-design ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:usability-testing ],
        ngm:human-computer-interaction ;
    vc:bridgesTo ngm:augmented-reality,
        ngm:spatial-computing ;
    vc:contrastsWith ngm:graphic-design ;
    vc:enables ngm:usability,
        ngm:user-engagement ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:information-architecture,
        ngm:user-interface-design ;
    vc:isPartOf ngm:product-design ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:interaction-design,
        ngm:visual-design ;
    vc:requires ngm:usability-testing,
        ngm:user-research ;
    vc:slug "user-experience-design" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:accessibility,
        ngm:user-centered-design ;
    vc:uses ngm:design-systems,
        ngm:prototyping .

ngm:uv-mapping a owl:Class ;
    rdfs:label "Uv Mapping"@en ;
    rdfs:comment "UV mapping is the process of projecting a 3D model's surface onto a two-dimensional coordinate space so that texture images can be applied accurately to its geometry. The letters U and V denote the axes of this 2D texture space, distinct from the X, Y, and Z axes of the model. By unwrapping the mesh into UV islands, artists control how textures, normal maps, and other surface data wrap around the object with minimal stretching or seams."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:polygon-mesh ],
        ngm:3-d-modeling ;
    vc:bridgesTo ngm:real-time-rendering ;
    vc:contrastsWith ngm:skeletal-rig ;
    vc:dependsOn ngm:3-d-modeling ;
    vc:enables ngm:normal-map,
        ngm:texture-mapping ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:vertex-attribute ;
    vc:implements ngm:texture-mapping ;
    vc:isPartOf ngm:3-d-modeling ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:digital-asset,
        ngm:shader ;
    vc:requires ngm:polygon-mesh ;
    vc:slug "uv-mapping" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:ambient-occlusion,
        ngm:rendering ;
    vc:uses ngm:texture-atlas,
        ngm:texture-mapping .

ngm:wireless-connectivity a owl:Class ;
    rdfs:label "Wireless Connectivity"@en ;
    rdfs:comment "Wireless connectivity is the transmission of data between devices over radio frequencies without physical cabling. It encompasses short-range links such as Wi-Fi and Bluetooth, medium-range technologies such as Zigbee and LoRa, and wide-area mobile networks such as 4G LTE and 5G NR, all governed by spectrum allocation and standardised protocol stacks."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:radio-frequency-spectrum ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:network-security ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:5-g ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:communication-protocol ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:lora ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:bluetooth ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:wi-fi ],
        ngm:communication-protocol ;
    vc:bridgesTo ngm:robotics,
        ngm:spatial-computing ;
    vc:enables ngm:edge-computing,
        ngm:internet-of-things,
        ngm:mobile-computing,
        ngm:real-time-communication ;
