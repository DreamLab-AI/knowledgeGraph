ngm:verifiable-computation a owl:Class ;
    rdfs:label "Verifiable Computation"@en ;
    rdfs:comment "Techniques that let a party outsource a computation and receive a proof that the result is correct, allowing efficient verification without redoing the work."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptographic-proof ],
