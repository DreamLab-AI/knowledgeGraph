        ngm:provenance-tracking ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:supply-chain-management,
        ngm:supply-chain-traceability ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:supply-chain-blockchain ;
    vc:slug "supply-chain" ;
    vc:sourceDomain "infrastructure" .

ngm:telepresence a owl:Class ;
    rdfs:label "Telepresence"@en ;
    rdfs:comment "Telepresence encompasses technologies and interaction paradigms that create a compelling perception of physical presence in a remote or virtual location, enabling natural communication and manipulation at a distance. Systems range from high-definition video conferencing with matched room geometries and spatial audio through robotic telepresence platforms to fully immersive XR environments that deliver volumetric representations and haptic feedback, reducing the cognitive and social costs of geographic separation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:virtual-reality ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
