    vc:uses ngm:context-window,
        ngm:retrieval-augmented-generation,
        ngm:vector-database .

ngm:3-d-gaussian-splatting a owl:Class ;
    rdfs:label "3D Gaussian Splatting"@en ;
    rdfs:comment "A neural rendering technique that represents 3D scenes as collections of millions of 3D Gaussian primitives with learnable positions, colours, opacities, and covariances, enabling photorealistic real-time rendering at 100+ frames per second through GPU-accelerated rasterisation, revolutionising telepresence and immersive collaboration with unprecedented visual fidelity."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:differentiable-rendering ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:structure-from-motion ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:spherical-harmonics ],
        ngm:neural-rendering ;
    vc:bridgesTo ngm:extended-reality,
        ngm:tele-050-neural-rendering-telepresence,
        ngm:web-xr ;
    vc:contrastsWith ngm:neural-radiance-fields,
        ngm:tele-060-instant-ngp ;
    vc:dependsOn ngm:adam-optimiser,
        ngm:multi-view-photography,
        ngm:point-cloud ;
    vc:enables ngm:avatar,
        ngm:novel-view-synthesis,
        ngm:photorealistic-telepresence,
        ngm:tele-053-volumetric-video-conferencing ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:gaussian-primitive,
        ngm:spherical-harmonics ;
    vc:implements ngm:alpha-blending ;
    vc:isPartOf ngm:novel-view-synthesis ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:3-d-scene-reconstruction,
        ngm:virtual-reality-telepresence ;
    vc:requires ngm:differentiable-rendering,
        ngm:structure-from-motion ;
    vc:slug "3-d-gaussian-splatting" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:ssim-loss,
        ngm:stochastic-gradient-descent .

ngm:adam-optimiser a owl:Class ;
    rdfs:label "Adam Optimiser"@en ;
    rdfs:comment "The Adam optimiser (Adaptive Moment Estimation) is a first-order gradient-based optimisation algorithm that computes per-parameter adaptive learning rates by maintaining exponentially decaying moving averages of past gradients (first moment) and past squared gradients (second moment), with bias correction applied in early iterations. It synthesises the momentum-tracking behaviour of gradient descent with momentum and the per-parameter scaling of RMSProp, making it robust to sparse gradients, non-stationary objectives, and high-dimensional parameter spaces. Introduced by Kingma and Ba (2014), Adam has become the de-facto default optimiser for training transformer-based large language models, diffusion models, and deep neural networks across most domains. Key variants including AdamW, Adan, and AdaFactor extend it with decoupled weight decay, Nesterov momentum, and memory-efficient factorisation respectively."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:learning-rate-schedule ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:backpropagation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:automatic-differentiation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:loss-function ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:stochastic-gradient-descent ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:exponential-moving-average ],
        ngm:gradient-descent ;
    vc:bridgesTo ngm:distributed-training,
        ngm:federated-learning,
        ngm:reinforcement-learning ;
    vc:contrastsWith ngm:lion-optimiser,
        ngm:muon-optimiser,
        ngm:rmsprop,
        ngm:sgd-with-momentum ;
    vc:enables ngm:convergence,
        ngm:deep-learning,
        ngm:fine-tuning,
        ngm:hyperparameter-optimisation,
        ngm:model-training,
        ngm:transfer-learning ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:bias-correction,
        ngm:exponential-moving-average,
        ngm:learning-rate-schedule ;
