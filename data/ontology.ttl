        ngm:elliptic-curve-cryptography .

ngm:blake2 a owl:Class ;
    rdfs:label "BLAKE2"@en ;
    rdfs:comment "BLAKE2 is a high-performance cryptographic hash function designed as a faster, simpler alternative to SHA-2 and SHA-3 while preserving equivalent security guarantees. Introduced in 2012 by Jean-Philippe Aumasson, Samuel Neves, Zooko Wilcox-O'Hearn, and Christian Winnerlein, it produces digests of up to 512 bits (BLAKE2b) or 256 bits (BLAKE2s) and is widely adopted in blockchain systems, password-hashing schemes, and data integrity verification due to its speed advantage over SHA-256 on modern 64-bit processors. Its resistance to length-extension attacks and configurability—including personalisation, salting, and variable digest length—make it a versatile drop-in for many cryptographic protocol requirements."@en ;
    rdfs:subClassOf ngm:bc-cryptographic-primitive,
        ngm:blockchain-entity,
        ngm:cryptographic-primitive ;
    skos:broader ngm:bc-cryptographic-primitive ;
    vc:contrastsWith ngm:sha-256 ;
    vc:enables ngm:blockchain-infrastructure,
        ngm:data-integrity ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:cryptographic-primitive ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:cryptographic-hash,
        ngm:cryptographic-hash-function,
        ngm:digital-signatures,
        ngm:merkle-tree,
        ngm:sha-256 ;
    vc:slug "blake2" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:hash-function .

ngm:blender-3d-creation-suite a owl:Class ;
    rdfs:label "Blender 3D Creation Suite"@en ;
    rdfs:comment "Blender is a free and open-source 3D creation suite supporting modelling, animation, rendering, and related workflows."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:open-source-software ],
        ngm:open-source-software ;
    vc:enables ngm:animation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:open-source-software ;
    vc:slug "blender-3d-creation-suite" ;
    vc:sourceDomain "metaverse" .

ngm:block-explorer a owl:Class ;
    rdfs:label "Block Explorer"@en ;
    rdfs:comment "A Block Explorer is a web-based or API-accessible tool that indexes and presents the contents of a blockchain in human-readable form, enabling users to search, inspect, and verify blocks, transactions, addresses, smart contracts, and network statistics without operating a full node locally. Block explorers ingest raw node data, parse it according to the chain's consensus rules, and expose it through search interfaces and REST or GraphQL APIs. They are the primary transparency and audit interface for blockchain networks."@en ;
    rdfs:subClassOf ngm:blockchain-analytics ;
    vc:enables ngm:audit-trail,
        ngm:transparency ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:blockchain-network,
        ngm:mempool ;
    vc:slug "block-explorer" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:blockchain-transaction,
        ngm:data-visualisation,
        ngm:full-node .

ngm:block-snapshot a owl:Class ;
    rdfs:label "Block Snapshot"@en ;
    rdfs:comment "A block snapshot is a record of on-chain state, typically token balances or governance weights, captured at a specific block height. In decentralised governance it freezes voting power at a chosen block so that token holdings used to weight votes cannot be manipulated by transfers during the voting window. Snapshots underpin gasless off-chain voting systems and fair airdrop distributions by providing a tamper-evident, reproducible baseline state."@en ;
    rdfs:subClassOf ngm:bc-governance-and-regulation ;
    skos:broader ngm:bc-governance-and-regulation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:on-chain-voting ;
    vc:slug "block-snapshot" ;
    vc:sourceDomain "blockchain" .

ngm:bluetooth-sig a owl:Class ;
    rdfs:label "Bluetooth SIG"@en ;
    rdfs:comment "The Bluetooth Special Interest Group (Bluetooth SIG) is the non-profit trade association responsible for developing, maintaining, and licensing the Bluetooth wireless communication standard. Founded in 1998 by Ericsson, IBM, Intel, Nokia, and Toshiba, it governs the Bluetooth Core Specification and the library of Bluetooth profiles, managing qualification and branding programmes that ensure interoperability among the over 50,000 member companies worldwide."@en ;
    rdfs:subClassOf ngm:standards-body ;
    vc:enables ngm:bluetooth-le,
        ngm:bluetooth-low-energy,
        ngm:interoperability ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:embedded-systems,
        ngm:internet-of-things ;
    vc:slug "bluetooth-sig" ;
    vc:sourceDomain "infrastructure" ;
    vc:standardizedBy ngm:ieee-standards-association .

ngm:boardroom a owl:Class ;
    rdfs:label "Boardroom"@en ;
    rdfs:comment "The Boardroom is the physical or virtual environment in which a company's board of directors convenes to exercise its governance responsibilities, encompassing both the formal meeting space and the institutional setting—including procedures, information flows, and power dynamics—that shape board decision-making. As a governance construct, it represents the apex deliberative forum where strategy, risk, and oversight responsibilities are discharged."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:fiduciary-duty ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:quorum ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:audit-committee ],
        ngm:governance ;
    vc:bridgesTo ngm:artificial-intelligence,
        ngm:distributed-collaboration ;
    vc:enables ngm:accountability,
        ngm:board-level-oversight ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:audit-committee ;
    vc:isPartOf ngm:corporate-governance ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:compliance,
        ngm:shareholder-rights,
        ngm:stakeholder,
        ngm:transparency ;
    vc:requires ngm:fiduciary-duty,
        ngm:quorum ;
    vc:slug "boardroom" ;
    vc:sourceDomain "governance" ;
    vc:supports ngm:executive-compensation ;
    vc:uses ngm:governance-framework,
        ngm:risk-management .

ngm:bode-plot a owl:Class ;
    rdfs:label "Bode Plot"@en ;
    rdfs:comment "A Bode Plot is a pair of frequency-domain graphs used in control engineering and signal analysis to characterise the frequency response of a linear time-invariant system: one graph plots the magnitude of the system's transfer function in decibels against log-frequency, and the second plots the phase angle in degrees against log-frequency. Together they reveal gain margins, phase margins, bandwidth, and resonant behaviour, making Bode plots the primary graphical tool for assessing open-loop stability and designing compensators."@en ;
    rdfs:subClassOf ngm:control-system ;
    vc:enables ngm:pid-controller,
        ngm:stability-analysis ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:feedback-control,
        ngm:feedback-loop ;
    vc:slug "bode-plot" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:signal-processing,
        ngm:transfer-function .

ngm:bolt12-offers a owl:Class ;
    rdfs:label "BOLT12 Offers"@en ;
    rdfs:comment "BOLT12 Offers is a Lightning Network specification defining reusable, static payment requests called offers, improving on single-use BOLT11 invoices. An offer is a long-lived, shareable code from which payers fetch a fresh invoice on demand via onion messages, enabling recurring payments, refunds, and donation links without a server issuing each invoice. It also improves privacy through blinded paths that hide the recipient's node identity."@en ;
    rdfs:subClassOf ngm:lightning-network ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:lightning-network ;
    vc:slug "bolt12-offers" ;
    vc:sourceDomain "blockchain" .

ngm:building-information-modelling a owl:Class ;
    rdfs:label "Building Information Modelling"@en ;
    rdfs:comment "Building Information Modelling (BIM) is a collaborative process for creating and managing a shared digital representation of the physical and functional characteristics of a built asset across its lifecycle. A BIM model is an object-oriented, parametric 3D database in which geometry is enriched with semantic data such as materials, costs, schedules and performance properties. It supports coordinated design, clash detection, quantity take-off and facility management by allowing architects, engineers and contractors to work against a single federated source of truth. BIM underpins the convergence of construction practice with digital twin and spatial computing technologies."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:point-cloud ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:interoperability ],
        ngm:spatial-computing ;
    skos:broader ngm:spatial-computing ;
    vc:bridgesTo ngm:geographic-information-system ;
    vc:dependsOn ngm:interoperability ;
    vc:enables ngm:digital-twin-technology ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:point-cloud ;
    vc:isPartOf ngm:digital-twin ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:photogrammetry,
        ngm:point-cloud,
        ngm:spatial-computing ;
    vc:requires ngm:interoperability ;
    vc:slug "building-information-modelling" ;
    vc:sourceDomain "spatial-computing" ;
    vc:standardizedBy ngm:standards ;
    vc:supports ngm:digital-twin ;
    vc:uses ngm:lidar,
        ngm:photogrammetry .

ngm:bvh-acceleration-structure a owl:Class ;
    rdfs:label "BVH Acceleration Structure"@en ;
    rdfs:comment "A bounding volume hierarchy (BVH) is a tree-based spatial data structure that recursively partitions scene geometry into nested bounding volumes to accelerate ray-geometry intersection queries. By testing rays against coarse parent volumes before descending into child nodes, a BVH reduces intersection complexity from linear in primitive count to roughly logarithmic. It is the dominant acceleration structure in modern ray tracing because it supports fast rebuilds for dynamic scenes and maps efficiently to GPU hardware."@en ;
    rdfs:subClassOf ngm:rendering-technique ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:ray-tracing ;
    vc:slug "bvh-acceleration-structure" ;
    vc:sourceDomain "metaverse" .

ngm:byzantine-fault-tolerant-system a owl:Class ;
    rdfs:label "Byzantine Fault Tolerant System"@en ;
    rdfs:comment "A Byzantine Fault Tolerant System is a distributed computing system designed to continue operating correctly even when a fraction of its nodes exhibit arbitrary, potentially malicious failures — including sending conflicting, incorrect, or no messages to different peers. Such systems implement consensus protocols that guarantee safety (agreement) and liveness (progress) provided strictly fewer than one-third of participating nodes are faulty, a bound established by the foundational Byzantine Generals Problem. BFT systems underpin the security of permissioned and permissionless blockchain networks, replicated state machines, and safety-critical distributed infrastructure where adversarial behaviour must be tolerated without compromising overall correctness."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:quorum-system ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:leader-election ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:two-phase-commit ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:consensus-algorithm ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:message-authentication ],
        ngm:infra-computing-and-cloud ;
    skos:broader ngm:infra-computing-and-cloud ;
    vc:bridgesTo ngm:decentralised-finance,
        ngm:smart-contract-platform ;
    vc:contrastsWith ngm:paxos,
        ngm:raft-consensus ;
    vc:dependsOn ngm:cryptographic-signature,
        ngm:network-communication,
        ngm:peer-to-peer-network ;
    vc:enables ngm:atomic-broadcast,
        ngm:consensus-mechanism,
        ngm:consensus-protocol,
        ngm:distributed-ledger ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:leader-election,
        ngm:two-phase-commit,
        ngm:view-change-protocol ;
    vc:implements ngm:byzantine-fault-tolerance,
        ngm:state-machine-replication ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:byzantine-generals-problem,
        ngm:hotstuff-protocol,
        ngm:pbft,
        ngm:tendermint ;
    vc:requires ngm:consensus-algorithm,
        ngm:message-authentication,
        ngm:quorum-system ;
    vc:slug "byzantine-fault-tolerant-system" ;
    vc:sourceDomain "distributed-systems" ;
    vc:supports ngm:blockchain-network,
        ngm:permissioned-blockchain,
        ngm:state-machine-replication .

ngm:byzantine-generals-problem a owl:Class ;
    rdfs:label "Byzantine Generals Problem"@en ;
    rdfs:comment "The Byzantine Generals Problem is a foundational thought experiment in distributed computing describing how loyal participants can reach agreement when some participants are traitorous and may send arbitrary or conflicting messages. It formalises the difficulty of achieving consensus in the presence of arbitrary (Byzantine) faults, where faulty nodes behave maliciously rather than merely crashing. The problem establishes that agreement is solvable only when fewer than one-third of participants are faulty."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:message-passing ],
        ngm:fault-tolerance ;
    vc:bridgesTo ngm:proof-of-stake,
        ngm:tendermint ;
    vc:contrastsWith ngm:atomic-broadcast,
        ngm:crash-fault-tolerance ;
    vc:dependsOn ngm:distributed-system,
        ngm:fault-tolerance ;
    vc:enables ngm:byzantine-fault-tolerance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:byzantine-fault-tolerance,
        ngm:consensus,
        ngm:distributed-systems ;
    vc:requires ngm:message-passing ;
    vc:slug "byzantine-generals-problem" ;
    vc:sourceDomain "distributed-systems" ;
    vc:supports ngm:blockchain-consensus,
        ngm:practical-byzantine-fault-tolerance .

ngm:calibration-system a owl:Class ;
    rdfs:label "Calibration System"@en ;
    rdfs:comment "A Calibration System is an integrated assembly of hardware targets, measurement instruments, algorithms, and software workflows used to determine and correct systematic errors in sensors, cameras, and measurement devices, establishing a known and traceable relationship between a sensor's raw outputs and the physical quantities they represent. Calibration systems are essential preconditions for accurate spatial measurement, computer vision, robotics, and extended reality applications."@en ;
    rdfs:subClassOf ngm:calibration-equipment ;
    vc:enables ngm:computer-vision,
        ngm:photogrammetry,
        ngm:sensor-fusion ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:slam ;
    vc:slug "calibration-system" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:imu,
        ngm:optical-calibration-target,
        ngm:sensor-calibration .

ngm:camera-tracking-system a owl:Class ;
    rdfs:label "Camera Tracking System"@en ;
    rdfs:comment "A camera tracking system is a hardware and software assembly that continuously records the position, orientation, and lens parameters of a physical camera in three-dimensional space, transmitting this data in real time to rendering or compositing engines so that computer-generated imagery can be seamlessly integrated with live-action footage. Such systems underpin virtual production stages, augmented reality overlays, broadcast graphics, and visual effects pipelines. Tracking technologies include optical encoder arrays, inertial measurement units, infrared LED constellations, machine vision fiducial markers, and LiDAR-based spatial mapping."@en ;
    rdfs:subClassOf ngm:camera-tracking ;
    vc:enables ngm:augmented-reality,
        ngm:spatial-anchoring ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:camera-parameters ;
    vc:slug "camera-tracking-system" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:camera-calibration,
        ngm:camera-intrinsics,
        ngm:motion-capture .

ngm:can-bus a owl:Class ;
    rdfs:label "CAN Bus"@en ;
    rdfs:comment "CAN Bus (Controller Area Network) is a reliable serial communication standard that lets microcontrollers and devices exchange messages over a shared two-wire bus without a host computer, widely used in vehicles and robotics."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:embedded-systems ],
        ngm:communication-protocol ;
    vc:enables ngm:motor-driver,
        ngm:real-time-control ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:embedded-systems ;
    vc:slug "can-bus" ;
    vc:sourceDomain "robotics" .

ngm:canonical-json a owl:Class ;
    rdfs:label "Canonical JSON"@en ;
    rdfs:comment "Canonical JSON is a normalised serialisation form of JSON that specifies a unique, deterministic byte-level representation for any given JSON value, enabling reliable hashing, digital signatures, and binary equality comparisons over JSON documents. Because RFC 8259 JSON permits equivalent representations that differ in whitespace, key ordering, and number formatting, canonical forms such as JCS (JSON Canonicalization Scheme, RFC 8785) and earlier proposals impose rules including lexicographic key sorting, no insignificant whitespace, and IEEE 754 double-precision serialisation for numbers. This determinism is essential in cryptographic contexts where the same logical object must produce the same digest regardless of which implementation serialised it."@en ;
    rdfs:subClassOf ngm:data-format ;
    vc:enables ngm:interoperability ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:data-format-standard,
        ngm:interoperability-standard ;
    vc:slug "canonical-json" ;
    vc:sourceDomain "infrastructure" ;
    vc:standardizedBy ngm:standards-body ;
    vc:uses ngm:cryptography,
        ngm:hash-function .

ngm:capability-forecasting a owl:Class ;
    rdfs:label "Capability Forecasting"@en ;
    rdfs:comment "Capability forecasting is the practice of predicting the future capabilities of AI systems before they are built or deployed, typically by extrapolating from scaling laws, benchmark trends, and historical progress. It aims to anticipate when models will reach particular performance thresholds so that safety, governance, and deployment decisions can be made proactively. Forecasts are inherently uncertain because of emergent behaviour and discontinuous jumps in capability."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:evaluation-benchmarks-and-leaderboards ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:scaling-laws ],
        ngm:ai-governance ;
    vc:contrastsWith ngm:emergent-capabilities ;
    vc:enables ngm:ai-safety,
        ngm:risk-assessment ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:ai-governance ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:alignment,
        ngm:capability-evaluation,
        ngm:emergent-capabilities,
        ngm:foundation-model ;
    vc:requires ngm:evaluation-benchmarks-and-leaderboards,
        ngm:scaling-laws ;
    vc:slug "capability-forecasting" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:ai-governance,
        ngm:ai-safety,
        ngm:risk-assessment ;
    vc:uses ngm:model-evaluation,
        ngm:scaling-laws .

ngm:carbon-price-discovery a owl:Class ;
    rdfs:label "Carbon Price Discovery"@en ;
    rdfs:comment "Carbon price discovery is the process by which market participants collectively determine the equilibrium price of carbon emission allowances or credits through the interaction of supply and demand in regulated compliance markets and voluntary carbon markets. It encompasses the mechanisms, venues, and information flows that translate abatement costs, regulatory constraints, and economic activity into observable carbon prices. Transparent price signals are essential for directing investment towards emissions reduction and for evaluating the economic cost of decarbonisation."@en ;
    rdfs:subClassOf ngm:carbon-markets ;
    vc:enables ngm:carbon-offset-trading,
        ngm:environmental-asset-market ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:asset-liquidity,
        ngm:carbon-credits,
        ngm:environmental-trading ;
    vc:slug "carbon-price-discovery" ;
    vc:sourceDomain "finance" ;
    vc:uses ngm:automated-market-maker,
        ngm:decentralized-exchange .

ngm:carbon-tax a skos:Concept ;
    rdfs:label "Carbon Tax"@en .

ngm:cardano a owl:Class ;
    rdfs:label "Cardano"@en ;
    rdfs:comment "Cardano is a public proof-of-stake blockchain platform launched in 2017 by IOHK, with Charles Hoskinson, a co-founder of Ethereum, among its founders. It is distinctive for its emphasis on peer-reviewed academic research and formal methods, and its consensus protocol Ouroboros was the first proof-of-stake protocol with published security proofs. The platform separates a settlement layer for its ADA cryptocurrency from a computation layer for smart contracts, which were enabled through the Alonzo upgrade in 2021. Cardano uses an extended UTXO accounting model and the functional language Plutus for on-chain logic."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:proof-of-stake ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptocurrency ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:utxo ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:settlement-layer ],
        ngm:blockchain ;
    skos:broader ngm:blockchain ;
    vc:bridgesTo ngm:decentralised-identity,
        ngm:supply-chain-traceability ;
    vc:contrastsWith ngm:bitcoin,
        ngm:ethereum,
        ngm:solana ;
    vc:enables ngm:decentralised-finance,
        ngm:native-token,
        ngm:on-chain-governance,
        ngm:smart-contract ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:settlement-layer ;
    vc:implements ngm:formal-verification,
        ngm:ouroboros-consensus,
        ngm:utxo-model ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:consensus-mechanism,
        ngm:layer-1-blockchain ;
    vc:requires ngm:cryptocurrency,
        ngm:proof-of-stake,
        ngm:utxo ;
    vc:slug "cardano" ;
    vc:sourceDomain "blockchain" .

ngm:casper-ffg a owl:Class ;
    rdfs:label "Casper Ffg"@en ;
    rdfs:comment "Casper FFG (the Friendly Finality Gadget) is a proof-of-stake finality mechanism that overlays a checkpoint-based voting protocol on an underlying block proposal chain. Validators stake deposits and vote in two rounds to justify and then finalise checkpoints, after which reverting them would require destroying at least one third of the total stake. It introduces economic finality with slashing penalties for equivocation, providing strong accountability without requiring a full consensus overhaul."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:validator ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:staking ],
        ngm:finality-gadget ;
    vc:contrastsWith ngm:byzantine-fault-tolerance ;
    vc:enables ngm:blockchain-security ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:finality,
        ngm:proof-of-stake ;
    vc:isPartOf ngm:consensus-mechanism ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:ethereum,
        ngm:finality,
        ngm:slashing ;
    vc:requires ngm:staking,
        ngm:validator ;
    vc:slug "casper-ffg" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:ethereum,
        ngm:pos-consensus ;
    vc:uses ngm:slashing,
        ngm:validator-set .

ngm:category-hierarchies a owl:Class ;
    rdfs:label "Category Hierarchies"@en ;
    rdfs:comment "A structured classification system that organizes concepts, objects, or information into parent-child relationships forming a tree-like taxonomy, enabling logical navigation from broad categories to specific subcategories for knowledge organization and content management."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:classification-rules ],
        ngm:sc-standards-and-interop ;
    skos:broader ngm:sc-standards-and-interop ;
    vc:bridgesTo ngm:knowledge-organization-system ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:classification-rules ;
    vc:slug "category-hierarchies" ;
    vc:sourceDomain "spatial-computing" .

ngm:cbdc-infrastructure a owl:Class ;
    rdfs:label "CBDC Infrastructure"@en ;
    rdfs:comment "CBDC infrastructure refers to the technical systems, protocols, and institutional arrangements that underpin the issuance, distribution, settlement, and management of central bank digital currencies. It encompasses the ledger technology (centralised, distributed, or hybrid), API layers enabling interoperability with commercial banks and payment service providers, offline payment capability, and the privacy-preserving and security mechanisms required for sovereign digital money at scale. CBDC infrastructure must satisfy central bank requirements for finality, programmability, resilience, and monetary policy control that differ fundamentally from commercial digital payment systems."@en ;
    rdfs:subClassOf ngm:payment-infrastructure ;
    vc:enables ngm:central-bank-digital-currency,
        ngm:cross-border-payments,
        ngm:digital-payments ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:cbdc-frameworks,
        ngm:monetary-policy-implementation ;
    vc:slug "cbdc-infrastructure" ;
    vc:sourceDomain "finance" ;
    vc:uses ngm:atomic-settlement,
        ngm:cryptographic-infrastructure .

ngm:cellular-automata a skos:Concept ;
    rdfs:label "Cellular Automata"@en .

ngm:cha-cha20-poly1305 a owl:Class ;
    rdfs:label "ChaCha20-Poly1305"@en ;
    rdfs:comment "ChaCha20-Poly1305 is an authenticated encryption with associated data (AEAD) cipher suite combining the ChaCha20 stream cipher for encryption with the Poly1305 message authentication code, providing both confidentiality and integrity in a single construction. Designed by Daniel J. Bernstein, it offers performance advantages over AES-GCM on systems lacking hardware AES acceleration (particularly mobile and embedded devices) whilst providing equivalent or superior security margins. It is standardised in RFC 7539 (IETF) and RFC 8439, and is widely deployed in TLS 1.3, QUIC, WireGuard, SSH, and numerous cryptographic libraries as an alternative to AES-based suites."@en ;
    rdfs:subClassOf ngm:cryptographic-algorithm ;
    vc:contrastsWith ngm:aes-gcm ;
    vc:enables ngm:tls-1-3,
        ngm:tls-encryption ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:cryptographic-library ;
    vc:slug "cha-cha20-poly1305" ;
    vc:sourceDomain "security" ;
    vc:uses ngm:cryptographic-keys,
        ngm:nonce,
        ngm:symmetric-encryption .

ngm:chain-reorganization a owl:Class ;
    rdfs:label "Chain Reorganization"@en ;
    rdfs:comment "A Chain Reorganization (reorg) is the replacement of one or more blocks in the canonical blockchain by an alternative chain of equal or greater cumulative proof-of-work, occurring when competing miners produce valid chains of differing lengths and the network converges on the longest-chain rule to select the canonical history. Reorgs invalidate transactions confirmed only in the abandoned chain segment, enabling double-spend attacks when deliberately induced and posing settlement finality risks for exchanges and payment processors."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:nakamoto-consensus ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:proof-of-work ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:longest-chain-rule ],
        ngm:bc-protocol-and-consensus,
        ngm:blockchain-entity,
        ngm:distributed-data-structure ;
    skos:broader ngm:bc-protocol-and-consensus ;
    vc:contrastsWith ngm:byzantine-fault-tolerance ;
    vc:enables ngm:51-attack,
        ngm:double-spending ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:consensus-mechanism ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:blockchain-scalability,
        ngm:finality,
        ngm:fork-choice-rule,
        ngm:selfish-mining,
        ngm:transaction-finality ;
    vc:requires ngm:longest-chain-rule,
        ngm:nakamoto-consensus,
        ngm:proof-of-work ;
    vc:slug "chain-reorganization" ;
    vc:sourceDomain "blockchain" .

ngm:chainalysis a owl:Class ;
    rdfs:label "Chainalysis"@en ;
    rdfs:comment "Chainalysis is a commercial blockchain data analytics and intelligence platform founded in 2014 that provides investigative, compliance, and risk-management tools to government agencies, financial institutions, and cryptocurrency businesses for tracing, monitoring, and understanding blockchain transaction flows. It maintains a large proprietary database of attributed blockchain addresses — linking pseudonymous on-chain addresses to real-world entities through heuristic clustering, open-source intelligence, data partnerships, and legal processes — and offers products including Reactor (graph-based investigation tool), KYT (Know Your Transaction real-time compliance API), and Kryptos (market intelligence). Chainalysis is a primary contractor to agencies including the US Department of Justice, IRS Criminal Investigation, and OFAC for cryptocurrency-related law enforcement investigations, and publishes the annual Crypto Crime Report, the most widely cited source for cryptocurrency illicit finance statistics."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:transaction-monitoring ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:blockchain-data ],
        ngm:blockchain-analytics ;
    vc:bridgesTo ngm:financial-intelligence,
        ngm:law-enforcement-technology,
        ngm:regulatory-technology ;
    vc:contrastsWith ngm:cryptocurrency-mixer,
        ngm:privacy-coin,
        ngm:zero-knowledge-proof ;
    vc:enables ngm:aml-kyc-compliance,
        ngm:cryptocurrency-investigation,
        ngm:digital-forensics,
        ngm:sanctions-compliance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:address-attribution,
        ngm:know-your-transaction,
        ngm:reactor ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:blockchain-compliance,
        ngm:darknet-market,
        ngm:fatf-travel-rule,
        ngm:know-your-customer,
        ngm:sanctions-screening ;
    vc:requires ngm:blockchain-data,
        ngm:transaction-monitoring ;
    vc:slug "chainalysis" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:financial-crime-compliance,
        ngm:vasp-regulation ;
    vc:uses ngm:heuristic-clustering,
        ngm:open-source-intelligence,
        ngm:transaction-graph-analysis,
        ngm:utxo-model .

ngm:channel-coding a owl:Class ;
    rdfs:label "Channel Coding"@en ;
    rdfs:comment "Channel coding is the branch of coding theory that adds controlled redundancy to transmitted data so that errors introduced by a noisy communication channel can be detected and corrected at the receiver. Techniques include block codes, convolutional codes, turbo codes, and LDPC codes, with forward error correction being its dominant application. It matters because it lets systems approach the Shannon channel capacity, trading bandwidth for reliability in wireless, storage, and deep-space links."@en ;
    rdfs:subClassOf ngm:infra-network-and-comms ;
    skos:broader ngm:infra-network-and-comms ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:forward-error-correction,
        ngm:physical-layer ;
    vc:slug "channel-coding" ;
    vc:sourceDomain "infrastructure" .

ngm:ci-cd a skos:Concept ;
