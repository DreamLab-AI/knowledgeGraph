ngm:reputation-scoring-model a owl:Class ;
    rdfs:label "Reputation Scoring Model"@en ;
    rdfs:comment "An algorithmic process that computes quantitative reputation scores by aggregating behavioral data, applying weighted scoring functions, implementing temporal decay, and evaluating threshold conditions to generate trust indicators for entities in virtual environments."@en ;
    rdfs:subClassOf ngm:metaverse-governance-and-safeguarding ;
    vc:enables ngm:access-control-decisions,
        ngm:governance-voting-weight,
        ngm:risk-assessment,
        ngm:trust-score-metric ;
    vc:hasPart ngm:behavioral-data-aggregator,
        ngm:temporal-decay-engine,
        ngm:threshold-evaluator,
        ngm:weighted-scoring-function ;
    vc:isPartOf ngm:trust-infrastructure ;
    vc:maturity "draft" ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:behavioral-models,
        ngm:reputation-data,
        ngm:scoring-algorithms,
        ngm:validation-rules ;
    vc:slug "reputation-scoring-model" ;
    vc:sourceDomain "spatial-computing" .

