    vc:slug "digital-twin-creation-pipeline" ;
    vc:sourceDomain "spatial-computing" .

ngm:digital-twin-of-the-customer a owl:Class ;
    rdfs:label "Digital Twin of the Customer"@en ;
    rdfs:comment "A Digital Twin of the Customer is a dynamic virtual replica that mirrors an individual customer's behaviours, preferences, interactions, and decision-making patterns within a spatially-aware digital environment, enabling real-time simulation and predictive analysis of customer journeys. It integrates IoT telemetry, AI-driven behavioural modelling, and immersive 3D visualisations to create a continuously updated model reflecting how customers engage with products, services, and physical or digital spaces. Organisations use these twins to personalise experiences, predict service needs, and test interventions before live deployment."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-governance ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:internet-of-things ],
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:digital-twin,
        ngm:digital-twin-ecosystem ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:digital-twin-technology,
        ngm:predictive-personalization,
        ngm:recommendation-engine ;
    vc:requires ngm:data-governance,
        ngm:internet-of-things ;
    vc:slug "digital-twin-of-the-customer" ;
