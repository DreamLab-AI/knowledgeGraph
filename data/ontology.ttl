ngm:smart-royalty-contract a owl:Class ;
    rdfs:label "Smart Royalty Contract"@en ;
    rdfs:comment "A programmable blockchain contract that automatically enforces royalty payment terms, calculates compensation amounts, and triggers distributions to creators and rights holders upon qualifying transactions in NFT and digital asset ecosystems."@en ;
    rdfs:subClassOf ngm:royalty-mechanism ;
    vc:enables ngm:automated-payment-enforcement,
        ngm:multi-recipient-distribution,
        ngm:perpetual-creator-royalties,
        ngm:royalty-verification ;
    vc:hasPart ngm:enforcement-module,
        ngm:event-emitter,
        ngm:payment-splitter,
        ngm:royalty-logic,
        ngm:royalty-registry ;
    vc:isPartOf ngm:nft-standard-implementation ;
    vc:maturity "established" ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:oracle-service,
        ngm:payment-token,
        ngm:smart-contract-platform,
        ngm:token-standard ;
    vc:slug "smart-royalty-contract" ;
    vc:sourceDomain "spatial-computing" .

