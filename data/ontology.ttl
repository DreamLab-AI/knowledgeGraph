    vc:slug "advertising" ;
    vc:sourceDomain "finance" ;
    vc:uses ngm:digital-marketing,
        ngm:predictive-analytics .

ngm:affordance a skos:Concept ;
    rdfs:label "Affordance"@en .

ngm:agent-based-models a owl:Class ;
    rdfs:label "Agent-Based Models"@en ;
    rdfs:comment "Agent-Based Models (ABMs) are computational simulation frameworks that represent systems as collections of autonomous, heterogeneous agents that interact with one another and their environment according to local rules, allowing complex global behaviours and emergent phenomena to arise from the bottom up without being explicitly programmed at the system level. They are a primary tool in complexity science for studying social, biological, economic, and technical systems."@en ;
    rdfs:subClassOf ngm:computational-intelligence ;
    vc:enables ngm:collective-intelligence,
        ngm:emergence ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:feedback-loop ;
    vc:slug "agent-based-models" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:autonomous-agent,
        ngm:behavioral-modeling,
        ngm:scientific-computing .

ngm:agi-timelines a owl:Class ;
    rdfs:label "AGI Timelines"@en ;
    rdfs:comment "AGI timelines are structured forecasts estimating when artificial general intelligence — AI matching or exceeding human cognitive ability across most economically valuable tasks — might be achieved. Such forecasts aggregate expert surveys, compute-scaling extrapolations, benchmark-progress curves, and Bayesian models of research milestones to produce probability distributions over future dates. Timelines are inherently uncertain and contested, and they materially influence research prioritisation, safety investment, and public policy. They are a distinct object of study within AI forecasting rather than a single predicted date."@en ;
    rdfs:subClassOf ngm:time-series-forecasting ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:artificial-general-intelligence,
        ngm:gartner-prediction ;
    vc:slug "agi-timelines" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:performance-benchmarks .

ngm:ai-auditing a skos:Concept ;
    rdfs:label "AI Auditing"@en .

ngm:ai-evaluation a owl:Class ;
    rdfs:label "AI Evaluation"@en ;
    rdfs:comment "AI Evaluation is the systematic measurement of model capabilities, reliability, safety, and alignment using benchmarks, held-out tasks, human preference judgments, and automated graders. It produces quantitative metrics and qualitative findings that guide model selection, release decisions, and risk assessment. Robust evaluation must guard against benchmark contamination, distribution shift, and over-optimization toward narrow scores."@en ;
    rdfs:subClassOf ngm:ai-research-area ;
    skos:broader ngm:ai-research-area ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:evaluation-benchmarks-and-leaderboards,
        ngm:evaluation-metric ;
    vc:slug "ai-evaluation" ;
    vc:sourceDomain "ai" .

ngm:ai-framework a owl:Class ;
    rdfs:label "AI Framework"@en ;
    rdfs:comment "A comprehensive software architecture that provides reusable code, design patterns, and infrastructure for developing artificial intelligence applications. AI frameworks abstract low-level computational details, offering high-level interfaces for model construction, training, and inference. Examples include TensorFlow, PyTorch, JAX, and scikit-learn, each optimised for distinct use cases from research prototyping to production deployment."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:inference ],
        ngm:ai-infrastructure ;
    vc:enables ngm:deep-learning,
        ngm:machine-learning-discipline-pipeline ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:inference ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:slug "ai-framework" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:auto-ml,
        ngm:neural-network ;
    vc:uses ngm:machine-learning-discipline-infrastructure .

ngm:ai-trust-risk-and-security-management a owl:Class ;
    rdfs:label "AI Trust Risk and Security Management"@en ;
    rdfs:comment "A comprehensive governance framework — popularised by Gartner and aligned with the NIST AI Risk Management Framework — for managing the trustworthiness, security, and ethical risks of AI systems throughout their lifecycle. It operationalises three pillars: Trust (transparent, auditable, reliable AI behaviour), Risk (proactive identification and mitigation of algorithmic bias, data quality issues, and regulatory non-compliance), and Security (protection against adversarial attacks, data poisoning, and model integrity threats)."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:model-robustness ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:ai-risk-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:ai-security ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:ai-trustworthiness ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:algorithmic-bias ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:explainable-ai ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:ai-audit ],
        ngm:ai-governance-and-ethics ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:enables ngm:ai-governance,
        ngm:responsible-ai ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:ai-audit,
        ngm:ai-risk-management,
        ngm:ai-security,
        ngm:ai-trustworthiness ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:ai-lifecycle,
        ngm:ai-safety,
        ngm:red-teaming ;
    vc:requires ngm:algorithmic-bias,
        ngm:explainable-ai,
        ngm:model-robustness ;
    vc:slug "ai-trust-risk-and-security-management" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:standardizedBy ngm:ai-regulation .

ngm:ai-upscaling-and-super-resolution a owl:Class ;
    rdfs:label "AI Upscaling and Super-Resolution"@en ;
    rdfs:comment "AI Upscaling and Super-Resolution is a family of deep learning techniques that synthesise plausible high-frequency detail when enlarging images or video frames beyond their native resolution. Methods range from convolutional neural network regressors (SRCNN, ESRGAN) and generative adversarial approaches to diffusion-based reconstruction, enabling applications from consumer photography enhancement to real-time game upscaling (DLSS, FSR) and medical imaging."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:super-resolution ],
        ngm:ai-application,
        ngm:generative-ai ;
    skos:broader ngm:ai-application ;
    vc:enables ngm:image-processing-software,
        ngm:real-time-rendering ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:super-resolution ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:computer-vision,
        ngm:latent-diffusion,
        ngm:neural-rendering,
        ngm:sc-display-and-rendering ;
    vc:slug "ai-upscaling-and-super-resolution" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:convolutional-neural-network,
        ngm:deep-learning,
        ngm:diffusion-model,
        ngm:generative-adversarial-network .

ngm:ai-user a owl:Class ;
    rdfs:label "AI User"@en ;
    rdfs:comment "An individual or entity who interacts with, relies upon, or is affected by the outputs, decisions, or recommendations of an AI system in order to accomplish tasks, obtain services, or achieve objectives—either through direct interaction or indirect exposure to AI-mediated decisions. AI users are the primary experiencers of AI benefits and harms, encompassing diverse populations with varying technical literacy, accessibility needs, and degrees of voluntary engagement, making their rights and interests central to responsible AI governance."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:fairness ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:human-oversight ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
