        ngm:iso-iec-27701,
        ngm:nist-privacy-framework,
        ngm:w3-c ;
    vc:supports ngm:ai-governance,
        ngm:data-sharing,
        ngm:financial-crime-detection,
        ngm:healthcare-analytics,
        ngm:statistics ;
    vc:uses ngm:gradient-compression,
        ngm:oblivious-ram,
        ngm:secure-aggregation,
        ngm:zero-knowledge-proof .

ngm:privacy-preserving-authentication a owl:Class ;
    rdfs:label "Privacy-Preserving Authentication"@en ;
    rdfs:comment "Privacy-preserving authentication encompasses cryptographic mechanisms that allow a party to prove identity, membership, or credential possession to a verifier without revealing the underlying identity attributes, credential content, or linkage information across sessions. Core techniques include zero-knowledge proofs, anonymous credentials (e.g., U-Prove, BBS+), blind signatures, and selective disclosure, enabling authentication that is both unforgeable and unlinkable. The goal is to satisfy verifier assurance requirements while minimising the personal data exposed in each authentication event."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:public-key-infrastructure ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:commitment-scheme ],
        ngm:authentication ;
    vc:bridgesTo ngm:data-minimisation,
        ngm:gdpr-compliance ;
    vc:contrastsWith ngm:federated-identity,
        ngm:oauth ;
    vc:enables ngm:anonymous-credential-system,
        ngm:decentralised-identity,
        ngm:unlinkable-authentication,
        ngm:verifiable-credentials ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:implements ngm:minimal-disclosure-principle,
        ngm:privacy-by-design,
        ngm:selective-disclosure ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:post-quantum-cryptography,
        ngm:privacy-preserving-identity,
        ngm:zero-knowledge-proof ;
    vc:requires ngm:commitment-scheme,
        ngm:credential-issuer,
        ngm:public-key-infrastructure ;
    vc:slug "privacy-preserving-authentication" ;
    vc:sourceDomain "security" ;
    vc:standardizedBy ngm:e-idas-2-0,
        ngm:sd-jwt,
        ngm:w-3-c-verifiable-credentials-data-model ;
    vc:supports ngm:age-verification,
        ngm:digital-identity-wallet,
        ngm:self-sovereign-identity ;
    vc:uses ngm:bbs-signature,
        ngm:blind-signatures,
        ngm:cryptographic-proof,
        ngm:ring-signature,
        ngm:zero-knowledge-proof-zkp .

ngm:procedural-animation a owl:Class ;
    rdfs:label "Procedural Animation"@en ;
    rdfs:comment "Procedural Animation is a computational technique in which character and object motion is synthesised algorithmically at runtime — through rules, mathematical functions, and physical simulation — rather than played back from pre-authored keyframe sequences. It encompasses inverse kinematics solvers, physics-based secondary motion, constraint-driven posing, and behaviour-tree-driven locomotion, allowing virtual agents to adapt dynamically to unpredictable environments. Widely used in games, virtual reality, robotics control, and digital twins, procedural animation replaces or augments traditional hand-keyed or motion-captured data with generative motion pipelines. The approach scales cheaply across large numbers of unique characters and environmental configurations that would be prohibitively expensive to author by hand."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:scene-graph ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:forward-kinematics ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:collision-detection ],
        ngm:animation-technique ;
    vc:bridgesTo ngm:reinforcement-learning,
        ngm:robot-locomotion ;
    vc:contrastsWith ngm:keyframe-animation,
        ngm:motion-capture ;
    vc:enables ngm:avatar-behavior,
        ngm:crowd-simulation,
        ngm:digital-twin,
        ngm:non-player-character,
        ngm:real-time-rendering ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:animation-retargeting,
        ngm:motion-matching,
        ngm:ragdoll-physics,
        ngm:secondary-motion ;
    vc:requires ngm:collision-detection,
        ngm:forward-kinematics,
        ngm:scene-graph ;
    vc:slug "procedural-animation" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:behaviour-tree,
        ngm:inverse-kinematics,
        ngm:noise-function,
        ngm:physics-engine,
        ngm:physics-simulation,
        ngm:skeletal-mesh .

ngm:programmatic-advertising a owl:Class ;
    rdfs:label "Programmatic Advertising"@en ;
    rdfs:comment "Programmatic advertising is the automated buying and selling of digital advertising inventory through software platforms and real-time auctions, replacing manual insertion orders with algorithmic matching of advertiser bids to publisher ad slots. It encompasses demand-side platforms, supply-side platforms, ad exchanges, and data management systems that collectively orchestrate the delivery of targeted advertisements at scale."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:data-management-platform ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:identity-resolution ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-privacy ],
        ngm:advertising ;
    vc:bridgesTo ngm:artificial-intelligence,
        ngm:data-clean-room ;
    vc:dependsOn ngm:first-party-data ;
    vc:enables ngm:targeted-advertising ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:data-management-platform ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:advertising-and-marketing,
        ngm:digital-marketing,
        ngm:safety ;
    vc:requires ngm:data-privacy,
        ngm:identity-resolution ;
    vc:slug "programmatic-advertising" ;
    vc:sourceDomain "data" ;
    vc:supports ngm:advertising ;
    vc:uses ngm:auction-mechanism,
        ngm:audience-segmentation,
        ngm:consent-management,
        ngm:machine-learning-discipline-model .

ngm:proof-of-authority a owl:Class ;
    rdfs:label "Proof of Authority"@en ;
    rdfs:comment "A permissioned blockchain consensus mechanism in which a fixed set of pre-approved validators with verified real-world identities are authorised to produce and validate blocks. PoA sacrifices decentralisation for high throughput and fast finality, making it suitable for enterprise and consortium blockchains where participant trust can be established off-chain."@en ;
    rdfs:subClassOf ngm:bc-protocol-and-consensus,
        ngm:proof-based-consensus ;
    skos:broader ngm:bc-protocol-and-consensus ;
    vc:contrastsWith ngm:proof-of-stake,
        ngm:proof-of-work ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:consensus-algorithm,
        ngm:consensus-mechanism,
        ngm:consortium-blockchain,
        ngm:finality ;
    vc:slug "proof-of-authority" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:blockchain-governance .

ngm:proximal-policy-optimisation a owl:Class ;
    rdfs:label "Proximal Policy Optimisation"@en ;
    rdfs:comment "A reinforcement learning algorithm that updates policies through incremental steps whilst constraining how much the policy can change via a clipped surrogate objective, preventing destabilising updates. PPO is the dominant RL algorithm used in reinforcement learning from human feedback (RLHF) for fine-tuning language models to align with human preferences."@en ;
    rdfs:subClassOf ngm:ai-technique,
        ngm:reinforcement-learning ;
    skos:broader ngm:ai-technique ;
    vc:dependsOn ngm:reinforcement-learning-algorithm ;
    vc:enables ngm:fine-tuning,
        ngm:large-language-models ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:reinforcement-learning-from-human-feedback ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:slug "proximal-policy-optimisation" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:human-feedback,
        ngm:reward-model .

ngm:public-blockchain a owl:Class ;
    rdfs:label "Public Blockchain"@en ;
    rdfs:comment "A permissionless, decentralised distributed ledger network in which any party may participate, validate transactions, and inspect the chain state without requiring authorisation. Public blockchains such as Bitcoin and Ethereum achieve censorship resistance and immutability through global state replication and open consensus mechanisms, at the cost of reduced transaction throughput and higher energy consumption relative to permissioned alternatives."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:proof-of-stake ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:merkle-tree ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:smart-contract ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:proof-of-work ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:peer-to-peer-network ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:public-key-cryptography ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:cryptographic-hash-function ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:consensus-mechanism ],
        ngm:distributed-ledger-technology ;
    vc:bridgesTo ngm:decentralised-identity,
        ngm:metaverse,
        ngm:supply-chain-transparency ;
    vc:contrastsWith ngm:permissioned-blockchain,
        ngm:private-blockchain ;
    vc:enables ngm:censorship-resistance,
        ngm:cryptocurrency,
        ngm:decentralised-autonomous-organisation,
        ngm:decentralised-finance,
        ngm:immutability,
        ngm:non-fungible-token ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:consensus-mechanism,
        ngm:cryptographic-hash-function,
        ngm:merkle-tree,
        ngm:peer-to-peer-network,
        ngm:smart-contract ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:cross-chain-interoperability,
        ngm:distributed-ledger-technology,
        ngm:layer-2-scaling ;
    vc:requires ngm:proof-of-stake,
        ngm:proof-of-work,
        ngm:public-key-cryptography ;
    vc:slug "public-blockchain" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:blockchain-governance,
        ngm:user-sovereignty ;
    vc:uses ngm:digital-signature,
        ngm:zero-knowledge-proof .

ngm:random-sampling a owl:Class ;
    rdfs:label "Random Sampling"@en ;
    rdfs:comment "Random sampling is a method of selecting a subset of items from a population such that every element has a known, non-zero probability of being chosen, with selections governed by chance rather than judgement. It is the foundation of statistical inference, allowing properties of a population to be estimated from a representative sample while quantifying uncertainty. In machine learning it underpins data partitioning, stochastic optimisation and Monte Carlo estimation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:stochastic-process ],
        ngm:statistics ;
    vc:bridgesTo ngm:cross-validation ;
    vc:contrastsWith ngm:bias ;
    vc:dependsOn ngm:stochastic-process ;
    vc:enables ngm:cross-validation,
        ngm:inference ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:sampling ;
    vc:isPartOf ngm:statistics ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:data-collection,
        ngm:sampling,
        ngm:variance ;
    vc:requires ngm:stochastic-process ;
    vc:slug "random-sampling" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:cross-validation,
        ngm:simulation ;
    vc:uses ngm:random-number-generation .

ngm:regulatory-authority a owl:Class ;
    rdfs:label "Regulatory Authority"@en ;
    rdfs:comment "A regulatory authority is a government body, statutory agency, or delegated entity empowered by legislation to create, enforce, and adjudicate rules governing a specific industry, market, or domain of public concern. Such bodies possess the legal power to issue binding standards, licenses, and penalties; conduct inspections and investigations; and compel disclosures, all with the aim of protecting consumers, ensuring market integrity, managing systemic risk, or advancing public policy objectives. Regulatory authorities operate at national, supranational, and sub-national levels and are increasingly engaged with digital markets, artificial intelligence, financial technology, and emerging technology sectors."@en ;
    rdfs:subClassOf ngm:governance ;
    vc:enables ngm:regulatory-reporting,
        ngm:regulatory-standards ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:compliance-framework,
        ngm:financial-regulation,
        ngm:regulatory-compliance,
        ngm:regulatory-framework ;
    vc:slug "regulatory-authority" ;
    vc:sourceDomain "governance" ;
    vc:uses ngm:compliance-monitoring,
        ngm:regulatory-technology .

ngm:regulatory-frameworks a owl:Class ;
    rdfs:label "Regulatory Frameworks"@en ;
    rdfs:comment "Regulatory frameworks are structured, hierarchical systems comprising primary legislation, secondary rules, supervisory authorities, and enforcement mechanisms that collectively govern conduct within a defined sector or jurisdiction. They establish who is subject to regulation, what obligations and prohibitions apply, how compliance is monitored, and what sanctions are available for breach. Frameworks may be rules-based, principles-based, or risk-based in design, and typically span multiple tiers from international treaties and standards through to national law and sector-specific codes of practice. Modern frameworks increasingly address cross-border, technology-mediated activities, creating interoperability requirements between national and supranational regimes."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:compliance ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:enforcement-mechanism ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:supervisory-authority ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:regulatory-requirements ],
