    vc:slug "shared-knowledge-base" ;
    vc:sourceDomain "spatial-computing" .

ngm:signature-aggregation a owl:Class ;
    rdfs:label "Signature Aggregation"@en ;
    rdfs:comment "Signature Aggregation is a cryptographic technique that combines multiple digital signatures over distinct or identical messages into a single compact signature that can be verified with one operation. It reduces on-chain storage and verification cost in blockchain systems where many parties sign, such as validator committees. Schemes such as BLS and Schnorr support aggregation, improving scalability and bandwidth efficiency for distributed consensus."@en ;
    rdfs:subClassOf ngm:digital-signature ;
    vc:enables ngm:multisignature,
        ngm:scalability ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:bls-signature,
        ngm:schnorr-signature ;
    vc:isPartOf ngm:digital-signature ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:bandwidth,
        ngm:ethereum ;
    vc:slug "signature-aggregation" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:consensus-mechanism,
        ngm:rollup,
        ngm:validator ;
    vc:uses ngm:cryptography,
        ngm:verification .

ngm:sigstore a owl:Class ;
    rdfs:label "Sigstore"@en ;
    rdfs:comment "Sigstore is an open-source project and set of services for signing, verifying, and proving the provenance of software artefacts using short-lived keys and a public transparency log. It removes the burden of long-term key management by issuing ephemeral signing certificates bound to OpenID Connect identities, recording signatures in an append-only log (Rekor) for auditability. Sigstore underpins software supply-chain security through tools such as Cosign for container and artefact signing."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptographic-hash-function ],
        ngm:supply-chain-security ;
    vc:bridgesTo ngm:security ;
    vc:enables ngm:content-provenance,
        ngm:software-supply-chain ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:implements ngm:code-signing ;
    vc:isPartOf ngm:supply-chain-security ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:cryptographic-signature,
        ngm:ecdsa ;
    vc:requires ngm:cryptographic-hash-function ;
    vc:slug "sigstore" ;
    vc:sourceDomain "security" ;
    vc:supports ngm:software-supply-chain,
        ngm:supply-chain-security ;
    vc:uses ngm:certificate-authority,
        ngm:digital-signature,
        ngm:public-key-cryptography .

ngm:single-agent-system a skos:Concept ;
    rdfs:label "Single Agent System"@en .

ngm:single-turn-inference a skos:Concept ;
    rdfs:label "Single Turn Inference"@en .

ngm:slashing-conditions a owl:Class ;
    rdfs:label "Slashing Conditions"@en ;
    rdfs:comment "Slashing conditions are the set of cryptographically provable validator violations that a proof-of-stake blockchain protocol enforces by destroying or redistributing staked tokens. Encoded directly in protocol logic, they cover equivocation, surround votes, and prolonged unavailability, and their parameters set the strength of the chain's economic security. They are an implemented enforcement mechanism in modern blockchain protocols."@en ;
    rdfs:subClassOf ngm:consensus-mechanism ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:blockchain-protocol,
        ngm:proof-of-stake-sustainability ;
    vc:slug "slashing-conditions" ;
    vc:sourceDomain "blockchain" .

ngm:sliding-mode-control a owl:Class ;
    rdfs:label "Sliding Mode Control"@en ;
    rdfs:comment "Sliding mode control is a nonlinear, robust control method that drives a system's state onto a designed sliding surface and constrains it there using high-frequency switching of the control input. Once on the surface, the closed-loop dynamics become insensitive to matched disturbances and parameter uncertainty, giving strong robustness. It is a control-theory technique widely applied to robotic actuators and power electronics, though it can induce chattering."@en ;
    rdfs:subClassOf ngm:control-theory ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:control-algorithm,
        ngm:control-theory ;
    vc:slug "sliding-mode-control" ;
    vc:sourceDomain "robotics" .

ngm:smart-contract-coordination a owl:Class ;
    rdfs:label "Smart Contract Coordination"@en ;
    rdfs:comment "Smart Contract Coordination is the use of blockchain smart contracts—self-executing programs stored on distributed ledgers—to automate coordination, task allocation, payment distribution, and milestone verification in distributed teams, enabling trustless collaboration through cryptographically enforced agreements that execute deterministically without centralised intermediaries. This approach removes the need for escrow agents and manual approvals by encoding collaboration rules as immutable on-chain logic triggered by verifiable real-world events. It is foundational to decentralised autonomous organisations and cryptocurrency-based remuneration workflows."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:cryptocurrency-remuneration ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:consensus-mechanism ],
        ngm:dc-protocol-and-infra ;
    skos:broader ngm:dc-protocol-and-infra ;
    vc:enables ngm:payment-system,
        ngm:verifiable-credentials ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:consensus-mechanism,
        ngm:cryptocurrency-remuneration ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:blockchain-collaboration,
        ngm:dao-governance,
        ngm:decentralised-autonomous-organisation,
        ngm:distributed-collaboration ;
    vc:slug "smart-contract-coordination" ;
    vc:sourceDomain "distributed-collaboration" ;
    vc:uses ngm:blockchain-infrastructure,
        ngm:cryptography,
        ngm:distributed-ledger-technology .

ngm:snapshot-governance a owl:Class ;
    rdfs:label "Snapshot Governance"@en ;
    rdfs:comment "Snapshot Governance is an off-chain voting mechanism used in decentralised autonomous organisations whereby token holders cast gasless ballots whose weight is determined by a verified snapshot of holdings at a specific block height. The system enables low-friction community governance without requiring on-chain transaction costs for each vote. Results are typically ratified by a multisig or on-chain executor that enforces the outcome. It represents a pragmatic compromise between full on-chain governance and centralised decision-making."@en ;
    rdfs:subClassOf ngm:blockchain ;
    skos:broader ngm:blockchain ;
    vc:contrastsWith ngm:delegated-governance,
        ngm:on-chain-governance ;
    vc:dependsOn ngm:blockchain,
        ngm:cryptographic-signature ;
    vc:enables ngm:community-governance,
        ngm:protocol-upgrade ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:decentralised-autonomous-organisation,
        ngm:governance-token,
        ngm:on-chain-governance,
        ngm:voting-power ;
    vc:slug "snapshot-governance" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:dao-treasury,
        ngm:decentralised-finance ;
    vc:uses ngm:ipfs,
        ngm:smart-contract,
        ngm:token-voting .

ngm:social-token-economy a owl:Class ;
    rdfs:label "Social Token Economy"@en ;
    rdfs:comment "Economic model where communities issue tokens representing reputation, participation value, or creator-fan relationships, enabling decentralized governance and value distribution."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
