    vc:standardizedBy ngm:compliance-framework,
        ngm:digital-regulation .

ngm:ontology-property-definitions a owl:Class ;
    rdfs:label "Ontology Property Definitions"@en ;
    rdfs:comment "Comprehensive definitions of object properties and datatype properties used throughout the Disruptive Technology Ontology, establishing formal semantic relationships between concepts across AI, blockchain, robotics, and metaverse domains. Properties define typed, directional links (enables, requires, hasPart, uses, etc.) with explicit domains, ranges, inverse relationships, and logical characteristics enabling automated reasoning and knowledge graph traversal."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:ontology-definition ],
        [ a owl:Restriction ;
