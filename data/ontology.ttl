    vc:dependsOn ngm:control-theory,
        ngm:embedded-systems ;
    vc:enables ngm:autonomous-agent,
        ngm:autonomous-robot,
        ngm:autonomous-vehicle,
        ngm:unmanned-aerial-vehicle ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:perception-module,
        ngm:planning-module,
        ngm:sensor,
        ngm:world-model ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:cyber-physical-systems,
