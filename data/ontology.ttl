ngm:chain-of-thought-prompting a owl:Class ;
    rdfs:label "Chain-of-Thought Prompting"@en ;
    rdfs:comment "Chain-of-thought (CoT) prompting is a prompt engineering technique that elicits intermediate reasoning steps from a large language model before it produces a final answer, substantially improving performance on multi-step arithmetic, commonsense reasoning, and symbolic manipulation tasks. By including exemplars that demonstrate step-by-step reasoning or by appending the instruction 'Let's think step by step' (zero-shot CoT), the technique leverages the model's autoregressive generation to decompose complex problems into tractable substeps. CoT prompting was formally characterised by Wei et al. (2022) and has become a foundational capability-elicitation method for frontier language models."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:foundation-model ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:zero-shot-prompting ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:emergent-capabilities ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:tree-of-thoughts ],
        ngm:prompt-engineering ;
    vc:bridgesTo ngm:explainable-ai,
        ngm:neuro-symbolic-ai ;
    vc:contrastsWith ngm:direct-answer-prompting,
        ngm:standard-prompting ;
    vc:enables ngm:ai-agent,
        ngm:common-sense-reasoning,
        ngm:mathematical-reasoning,
        ngm:multi-step-reasoning,
        ngm:symbolic-reasoning ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:self-consistency-decoding,
        ngm:tree-of-thoughts,
        ngm:zero-shot-prompting ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:chain-of-thought-reasoning,
        ngm:least-to-most-prompting,
        ngm:programme-of-thought,
        ngm:react-prompting,
        ngm:reasoning-engine ;
    vc:requires ngm:emergent-capabilities,
        ngm:foundation-model ;
    vc:slug "chain-of-thought-prompting" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:autoregressive-language-model,
        ngm:few-shot-prompting,
        ngm:in-context-learning,
        ngm:large-language-models,
        ngm:reinforcement-learning-from-human-feedback .

ngm:classifier-free-guidance a owl:Class ;
    rdfs:label "Classifier-Free Guidance"@en ;
    rdfs:comment "Classifier-Free Guidance (CFG) is a conditional generation technique for diffusion models that steers the denoising trajectory towards a specified condition by computing a weighted extrapolation between a conditional score estimate and an unconditional score estimate produced by the same single model. Unlike classifier guidance, which requires a separately trained differentiable classifier, CFG trains one network jointly on conditional and unconditional objectives by randomly replacing conditioning inputs with a null embedding during training. At inference, the guided score is: score_guided = score_unconditional + w * (score_conditional - score_unconditional), where w is the guidance scale hyperparameter controlling the trade-off between sample diversity and condition alignment. CFG has become the dominant conditioning mechanism across text-to-image, text-to-video, and audio generation systems."@en ;
    rdfs:subClassOf ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:bridgesTo ngm:reinforcement-learning-from-human-feedback,
        ngm:reward-model ;
    vc:contrastsWith ngm:classifier-guidance,
        ngm:unconditional-generation ;
    vc:dependsOn ngm:dropout-training,
        ngm:score-based-generative-model ;
    vc:enables ngm:audio-generation,
        ngm:image-generation,
        ngm:negative-prompting,
        ngm:prompt-adherence,
        ngm:text-to-image,
        ngm:text-to-video ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:generative-ai ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:clip,
        ngm:controlnet,
        ngm:generative-model,
        ngm:prompt-engineering,
        ngm:sampling-algorithm,
        ngm:stable-diffusion ;
    vc:requires ngm:conditioning-signal,
        ngm:denoising-diffusion-probabilistic-model,
        ngm:guidance-scale ;
    vc:slug "classifier-free-guidance" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:diffusion-model,
        ngm:latent-diffusion,
        ngm:null-conditioning,
        ngm:score-function,
        ngm:variational-autoencoder .

ngm:clip a owl:Class ;
    rdfs:label "CLIP"@en ;
    rdfs:comment "CLIP (Contrastive Language-Image Pre-training) is a dual-encoder neural network architecture developed by OpenAI in which a vision encoder (Vision Transformer or CNN) and a text encoder (Transformer) are jointly trained on large-scale internet-sourced image-text pairs using an InfoNCE contrastive objective. The training maximises cosine similarity between embeddings of matched image-text pairs and minimises it for unmatched pairs within a batch, yielding a shared multimodal embedding space where semantically related images and text are geometrically proximate. This shared space enables zero-shot image classification by comparing image embeddings to natural language class descriptions without task-specific fine-tuning, and has become a foundational component in text-to-image diffusion models, open-vocabulary object detection, and cross-modal retrieval systems."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:self-supervised-learning ],
        ngm:ai-model-architecture ;
    skos:broader ngm:ai-model-architecture ;
    vc:bridgesTo ngm:augmented-reality,
        ngm:spatial-anchor ;
    vc:contrastsWith ngm:align,
        ngm:coca,
        ngm:florence ;
    vc:dependsOn ngm:embedding-model,
        ngm:transfer-learning ;
    vc:enables ngm:cross-modal-retrieval,
        ngm:image-classification,
        ngm:image-text-retrieval,
        ngm:open-vocabulary-detection,
        ngm:zero-shot-learning ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:foundation-model ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:multimodal-ai-architecture-ai,
        ngm:prompt-engineering,
        ngm:vision-language-model ;
    vc:requires ngm:embedding-space,
        ngm:large-scale-dataset,
        ngm:self-supervised-learning ;
    vc:slug "clip" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:multimodal-search,
        ngm:stable-diffusion,
        ngm:text-to-image ;
    vc:uses ngm:contrastive-learning,
        ngm:cosine-similarity,
        ngm:infonce-loss,
        ngm:transformer-architecture,
        ngm:vision-transformer .

ngm:cobot-safety-levels a owl:Class ;
    rdfs:label "Cobot Safety Levels"@en ;
    rdfs:comment "Standardized safety classifications and requirements for collaborative robots (cobots) operating in shared workspaces with humans, defining protection measures, risk assessments, and operational modes to ensure safe human-robot interaction according to ISO/TS 15066."@en ;
