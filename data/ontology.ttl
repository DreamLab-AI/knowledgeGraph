ngm:sentence-piece a owl:Class ;
    rdfs:label "SentencePiece"@en ;
    rdfs:comment "SentencePiece is a language-independent subword tokenisation library that processes raw Unicode text without language-specific pre-tokenisation, learning vocabulary units via Byte-Pair Encoding or the Unigram Language Model directly from corpora. It produces fully reversible, fixed-vocabulary tokenisations widely used in multilingual large language models such as T5, mT5, and ALBERT, and is particularly valuable for languages lacking explicit word boundaries."@en ;
    rdfs:subClassOf ngm:ai-technique,
        ngm:neural-network-text-tokenisation ;
    skos:broader ngm:ai-technique ;
    vc:contrastsWith ngm:word-piece ;
    vc:enables ngm:large-language-models,
        ngm:natural-language-processing ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:neural-network-text-tokenisation ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:slug "sentence-piece" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:byte-pair-encoding,
        ngm:subword-tokenisation .

