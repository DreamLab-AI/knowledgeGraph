    vc:isPartOf ngm:ai-application,
        ngm:generative-ai ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:data-provenance,
        ngm:image-generation ;
    vc:requires ngm:diffusion-model,
        ngm:gpu-compute,
        ngm:inference-infrastructure ;
    vc:slug "midjourney-text-to-image-service" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:latent-diffusion,
        ngm:prompt-engineering,
        ngm:text-encoder .

ngm:minting a owl:Class ;
    rdfs:label "Minting"@en ;
    rdfs:comment "The protocol-governed creation of new tokens on a blockchain, which may be fungible (ERC-20) or non-fungible (ERC-721), increasing total token supply according to defined issuance rules. Minting may be permissioned (restricted to authorised smart contracts or validators), algorithmic (triggered by staking rewards or proof-of-work block production), or demand-driven (as in NFT drops), and directly determines a token's inflation schedule and economic model."@en ;
    rdfs:subClassOf ngm:bc-token-and-asset,
        ngm:blockchain-entity,
        ngm:economic-mechanism ;
    skos:broader ngm:bc-token-and-asset ;
    vc:contrastsWith ngm:deflationary-token ;
    vc:enables ngm:fungible-token,
        ngm:nft-minting,
        ngm:token-economics ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:inflation,
        ngm:token-standard,
        ngm:tokenomics ;
    vc:slug "minting" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:erc-20,
        ngm:erc-721,
        ngm:smart-contract .

ngm:mobile-computing a owl:Class ;
    rdfs:label "Mobile Computing"@en ;
    rdfs:comment "Mobile computing is the discipline of delivering computation, data, and connectivity to portable devices such as smartphones, tablets, and wearables that operate while in motion. It contends with constraints on battery, memory, bandwidth, and intermittent connectivity, and increasingly hosts machine-learning inference directly on-device. Mobile computing bridges cloud back-ends and edge devices, enabling responsive, context-aware applications wherever the user goes."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:latency ],
        ngm:edge-computing ;
    vc:bridgesTo ngm:edge-computing,
        ngm:internet-of-things ;
    vc:contrastsWith ngm:distributed-computing ;
    vc:dependsOn ngm:model-compression,
        ngm:quantisation ;
    vc:enables ngm:federated-learning,
        ngm:on-device-inference ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:isPartOf ngm:edge-computing ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:edge-computing,
        ngm:internet-of-things,
        ngm:latency ;
    vc:requires ngm:latency ;
    vc:slug "mobile-computing" ;
    vc:sourceDomain "machine-learning" ;
    vc:supports ngm:augmented-reality ;
    vc:uses ngm:on-device-inference .

ngm:model a owl:Class ;
    rdfs:label "Model"@en ;
    rdfs:comment "In artificial intelligence, a Model is a mathematical or computational structure learned from data that encodes a mapping from inputs to outputs (or latent representations). Models range from classical machine learning models (linear, tree-based) to deep neural networks, generative models, and large language models, and constitute the core artefact produced by training and consumed during inference."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:model-capacity ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:model-training ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:model-depth ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:model-architecture ],
        ngm:ai-technique ;
