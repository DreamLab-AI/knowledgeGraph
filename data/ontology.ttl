ngm:fairness-constraints a owl:Class ;
    rdfs:label "Fairness Constraints"@en ;
    rdfs:comment "Fairness Constraints are mathematical formalizations of equitable treatment requirements in AI systems, expressed as conditions that model predictions must satisfy with respect to protected attributes such as race, gender, or age. The three canonical constraint families are Independence (demographic parity: predictions are statistically independent of protected attributes), Separation (equalized odds: predictions are independent of protected attributes conditional on the true label), and Sufficiency (calibration: true labels are independent of protected attributes conditional on predictions). These constraints are incorporated into model training as regularisation penalties or constrained optimisation objectives, and are subject to fundamental incompatibility theorems when base rates differ across protected groups."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:fairness-metrics ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:model-training ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:bias ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:fairness-accuracy-tradeoffs ],
        ngm:ai-governance-and-ethics ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:contrastsWith ngm:model-performance ;
    vc:enables ngm:ai-ethics-checklist,
        ngm:responsible-ai ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:fairness-accuracy-tradeoffs,
        ngm:fairness-metrics ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:bias-detection-methods,
        ngm:bias-mitigation-techniques,
        ngm:explainability,
        ngm:fairness,
        ngm:fairness-auditing-tools ;
    vc:requires ngm:bias,
        ngm:model-training ;
    vc:slug "fairness-constraints" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:accountability,
        ngm:transparency ;
    vc:uses ngm:fairness-oecd,
        ngm:gradient-descent .

ngm:fedimint a owl:Class ;
    rdfs:label "Fedimint"@en ;
    rdfs:comment "Fedimint is an open-source federated protocol for community-custodied Bitcoin Chaumian e-cash mints, in which a threshold of guardians collectively hold Bitcoin reserves and issue blinded bearer tokens redeemable for satoshis, providing privacy-preserving custody without requiring any single trusted party. The federation model distributes trust across a small, known set of guardians using Byzantine-fault-tolerant consensus, while the blind-signature scheme cryptographically prevents guardians from linking redemptions to issuances. Fedimint acts as a Bitcoin Layer 2 through embedded Lightning Network gateway integration, enabling community mints to interoperate with the broader Bitcoin payment ecosystem. It targets the gap between self-custody complexity and centralised custodial risk by enabling accountable, trust-minimised community banking at scale."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:bitcoin ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:multisignature ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:consensus ],
        ngm:ecash ;
    vc:bridgesTo ngm:decentralised-identity,
        ngm:distributed-trust ;
    vc:contrastsWith ngm:ark-protocol,
        ngm:centralised-exchange,
        ngm:self-custody ;
    vc:enables ngm:custody,
        ngm:financial-inclusion,
        ngm:privacy-preserving ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:bitcoin-proof-of-work-protocol-layer-2,
        ngm:decentralised-finance,
        ngm:digital-cash,
        ngm:federated-system ;
    vc:requires ngm:bitcoin,
        ngm:consensus,
        ngm:multisignature ;
    vc:slug "fedimint" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:bitcoin-proof-of-work-protocol-custody,
        ngm:lightning-network ;
    vc:uses ngm:blind-signatures,
        ngm:byzantine-fault-tolerance,
        ngm:chaumian-ecash,
        ngm:threshold-cryptography .

ngm:fido-alliance a owl:Class ;
    rdfs:label "FIDO Alliance"@en ;
    rdfs:comment "An industry consortium that develops open authentication standards—UAF, U2F, FIDO2, and WebAuthn—designed to replace passwords with phishing-resistant public-key cryptography, enabling strong authentication across browsers, devices, and online services."@en ;
