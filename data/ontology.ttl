ngm:unified-hardware-access a owl:Class ;
    rdfs:label "Unified Hardware Access"@en ;
    rdfs:comment "A standardised abstraction layer that provides consistent programmatic interfaces for accessing diverse XR hardware devices — including VR headsets, AR glasses, haptic controllers, eye-tracking modules, and six-DoF tracking systems — enabling cross-platform application development without device-specific code paths. The WebXR Device API (W3C) and OpenXR (Khronos Group) are the primary open standards implementing this abstraction for web and native runtimes respectively."@en ;
    rdfs:subClassOf ngm:hardware-abstraction,
        ngm:sc-standards-and-interop ;
    skos:broader ngm:sc-standards-and-interop ;
    vc:enables ngm:cross-platform-interoperability,
        ngm:immersive-experience ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:xr-runtime-environment ;
    vc:slug "unified-hardware-access" ;
    vc:sourceDomain "spatial-computing" ;
    vc:standardizedBy ngm:interoperability-standard,
        ngm:open-standard ;
    vc:uses ngm:eye-tracking,
        ngm:haptic-feedback,
        ngm:xr-device .

