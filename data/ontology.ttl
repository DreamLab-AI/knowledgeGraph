    vc:slug "liverpool-smart-cities" ;
    vc:sourceDomain "infrastructure" .

ngm:local-area-network a owl:Class ;
    rdfs:label "Local Area Network"@en ;
    rdfs:comment "A local area network (LAN) is a communications network that interconnects devices within a limited geographic area such as a building, campus, or data centre floor, typically under a single administrative domain. LANs provide high-bandwidth, low-latency connectivity enabling resource sharing, collaborative computing, and access to shared infrastructure services. Modern LANs are predominantly implemented using Ethernet (IEEE 802.3) and Wi-Fi (IEEE 802.11) technologies, with switching and VLAN segmentation providing logical isolation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:network-switch ],
        ngm:infrastructure ;
    skos:broader ngm:infrastructure ;
    vc:bridgesTo ngm:internet,
        ngm:wide-area-network ;
    vc:contrastsWith ngm:metropolitan-area-network,
        ngm:wide-area-network ;
    vc:enables ngm:distributed-computing,
        ngm:network-attached-storage,
        ngm:resource-sharing ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:network-router,
        ngm:network-switch,
        ngm:wireless-access-point ;
    vc:isPartOf ngm:network-infrastructure,
        ngm:wide-area-network ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:network-security,
        ngm:software-defined-networking,
        ngm:virtual-local-area-network ;
