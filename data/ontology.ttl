ngm:rgb-d-camera a owl:Class ;
    rdfs:label "RGB-D Camera"@en ;
    rdfs:comment "An RGB-D camera is a sensor that captures both colour (RGB) imagery and per-pixel depth (D) information in a single aligned frame. Depth is typically derived from structured light, time-of-flight, or stereo techniques, yielding a dense 3D representation of the scene. RGB-D cameras are widely used in robotics for perception, mapping, and manipulation because they combine appearance and geometry cheaply."@en ;
    rdfs:subClassOf ngm:sensor ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:depth-estimation,
        ngm:robotics-platform ;
    vc:slug "rgb-d-camera" ;
    vc:sourceDomain "robotics" .

ngm:risk-assessment-matrix a owl:Class ;
    rdfs:label "Risk Assessment Matrix"@en ;
    rdfs:comment "A risk assessment matrix is a structured grid that ranks risks by cross-tabulating the likelihood of an event against the severity of its impact. Each cell maps to a qualitative or quantitative risk level, allowing teams to prioritise mitigation and allocate resources to the highest-rated risks. It is a standard visual tool in security and safety risk management."@en ;
    rdfs:subClassOf ngm:cybersecurity ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:risk-assessment-methodology,
        ngm:threat-surface-map ;
    vc:slug "risk-assessment-matrix" ;
    vc:sourceDomain "security" .

ngm:risk-scoring a skos:Concept ;
    rdfs:label "Risk Scoring"@en .

ngm:risk-scoring-engine a owl:Class ;
    rdfs:label "Risk Scoring Engine"@en ;
    rdfs:comment "A risk scoring engine is a software component that computes a numerical risk score for an entity, transaction, or session by combining multiple weighted signals through rules or models. In compliance and identity systems it quantifies how likely an action is fraudulent or non-compliant, feeding thresholds that trigger review, blocking, or escalation. The score provides a consistent, tunable basis for automated decisions."@en ;
    rdfs:subClassOf ngm:infra-security-and-identity ;
    skos:broader ngm:infra-security-and-identity ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:compliance-monitoring,
        ngm:identity-verification ;
    vc:slug "risk-scoring-engine" ;
    vc:sourceDomain "security" .

ngm:ro-berta a owl:Class ;
    rdfs:label "RoBERTa"@en ;
    rdfs:comment "RoBERTa (Robustly Optimised BERT Pretraining Approach) is a transformer-based language model that refines BERT by removing the next-sentence-prediction objective, adopting dynamic masking, training on substantially larger corpora (160 GB vs 16 GB), and using larger batch sizes. These training-procedure improvements yield consistent performance gains on NLP benchmarks without altering the underlying transformer encoder architecture."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:transformer-architecture ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:language-modeling ],
        ngm:ai-model-architecture ;
    skos:broader ngm:ai-model-architecture ;
    vc:contrastsWith ngm:albert ;
    vc:enables ngm:named-entity-recognition,
        ngm:sentiment-analysis ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:requires ngm:language-modeling,
        ngm:transformer-architecture ;
    vc:slug "ro-berta" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:fine-tuning,
        ngm:transfer-learning .

ngm:robotic-grasping a owl:Class ;
    rdfs:label "Robotic Grasping"@en ;
    rdfs:comment "Robotic Grasping is the subfield of robotics concerned with planning and executing stable, task-appropriate physical contact between a robotic end-effector and a target object. It integrates perception, grasp quality estimation, motion planning, and control to enable reliable object acquisition across varied geometries, materials, and environmental conditions."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:end-effector ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:grasp-planning ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:robot-perception ],
        ngm:manipulation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.85"^^xsd:float ;
    vc:relatedTo ngm:dexterous-manipulation ;
    vc:requires ngm:end-effector,
        ngm:grasp-planning,
        ngm:robot-perception ;
    vc:slug "robotic-grasping" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:point-cloud,
        ngm:tactile-sensing .

ngm:room-state-tracking a owl:Class ;
    rdfs:label "Room State Tracking"@en ;
    rdfs:comment "Room state tracking is the mechanism in real-time collaboration and conferencing systems that maintains an authoritative, synchronised record of a virtual room's membership, media status, and shared state. It tracks who is present, their roles, mute and stream states, and assignments such as breakout-room placement. Reliable state tracking ensures all participants and the server share a consistent view of the session."@en ;
    rdfs:subClassOf ngm:dc-telepresence ;
    skos:broader ngm:dc-telepresence ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:breakout-room ;
    vc:slug "room-state-tracking" ;
    vc:sourceDomain "metaverse" .

ngm:rotary-position-embedding a skos:Concept ;
    rdfs:label "Rotary Position Embedding"@en .

ngm:rtcp-feedback a owl:Class ;
    rdfs:label "RTCP Feedback"@en ;
    rdfs:comment "RTCP feedback is the control-channel mechanism of the RTP Control Protocol by which receivers report reception quality, such as packet loss, jitter, and round-trip time, back to senders during real-time media streaming. Senders use these reports, along with extensions like NACK, PLI, and REMB, to adapt encoding bitrate and recover from loss. It is the feedback loop that enables congestion-aware, resilient audiovisual transport."@en ;
    rdfs:subClassOf ngm:communication-protocol ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:bandwidth-adaptation ;
    vc:slug "rtcp-feedback" ;
    vc:sourceDomain "infrastructure" .

ngm:runes-protocol a owl:Class ;
    rdfs:label "Runes Protocol"@en ;
    rdfs:comment "Runes Protocol is a fungible token standard for the Bitcoin blockchain, introduced by Casey Rodarmor in 2024, that encodes token creation and transfer instructions directly into transaction outputs using the UTXO model. Unlike account-based token systems, Runes attaches a OP_RETURN-stored protocol message (a Runestone) to each transaction, assigning token balances to specific outputs so that ownership is tracked through spendable transaction outputs rather than a separate ledger. The protocol is designed to be more on-chain efficient than earlier Bitcoin-native token conventions such as BRC-20 and Ordinals-based token schemes, minimising UTXO proliferation while remaining fully compatible with the base-layer Bitcoin settlement mechanism. It reached significant ecosystem traction following its mainnet launch at the Bitcoin halving block in April 2024."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:utxo ],
        ngm:token-standard ;
    vc:bridgesTo ngm:decentralised-finance,
        ngm:smart-contract ;
    vc:contrastsWith ngm:brc-20,
        ngm:colored-coins,
        ngm:erc-20,
        ngm:ordinals-protocol ;
    vc:enables ngm:decentralised-exchange,
        ngm:fungible-token,
        ngm:token-minting ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:implements ngm:token-standard ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:bitcoin-script,
        ngm:digital-asset,
        ngm:non-fungible-token,
        ngm:proof-of-work,
        ngm:tokenisation ;
    vc:requires ngm:bitcoin-transaction,
        ngm:op-return,
        ngm:utxo ;
    vc:slug "runes-protocol" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:bitcoin-proof-of-work-protocol,
        ngm:blockchain-transaction .

ngm:runtime-layer a owl:Class ;
    rdfs:label "Runtime Layer"@en ;
    rdfs:comment "The Runtime Layer is the stratum that provides the execution environment in which higher-level code and models actually run. It sits above the Compute Layer that allocates resources and below the application and inference strata it hosts. It contains process and memory management, schedulers, sandboxes, and the libraries that support running programmes."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:compute-layer ],
        ngm:infra-computing-and-cloud ;
    skos:broader ngm:infra-computing-and-cloud ;
    vc:enables ngm:application-layer,
        ngm:inference-layer ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:compute-layer ;
    vc:slug "runtime-layer" ;
    vc:sourceDomain "infrastructure" .

ngm:rust a skos:Concept ;
    rdfs:label "Rust"@en .

ngm:safety-filter a owl:Class ;
    rdfs:label "Safety Filter"@en ;
    rdfs:comment "A safety filter is a content-moderation component placed around a generative AI model that screens inputs and outputs to block disallowed, harmful, or policy-violating content. It typically combines classifiers, keyword and pattern rules, and policy thresholds to detect unsafe prompts or generations and refuse, redact, or regenerate them. It is a core safeguard in deployed image and conversational AI products."@en ;
    rdfs:subClassOf ngm:ai-safety ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:ai-companions,
        ngm:proprietary-image-generation ;
    vc:slug "safety-filter" ;
    vc:sourceDomain "ai" .

ngm:safety-plc a owl:Class ;
    rdfs:label "Safety PLC"@en ;
    rdfs:comment "A Safety Programmable Logic Controller (Safety PLC) is a specialised industrial controller certified to IEC 61511 or IEC 62061 safety integrity levels, designed to execute safety instrumented functions that bring a process to a safe state upon detecting hazardous conditions. Unlike standard PLCs, Safety PLCs implement redundant processing, self-diagnostics, and rigorous failure-mode analysis to achieve the high diagnostic coverage required for safety-critical robotics and industrial automation."@en ;
    rdfs:subClassOf ngm:robo-safety-and-standards ;
    skos:broader ngm:robo-safety-and-standards ;
    vc:enables ngm:cobot-safety-levels,
        ngm:collaborative-systems-modality-robot ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:implements ngm:functional-safety ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:servo-control ;
    vc:slug "safety-plc" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:control-system,
        ngm:feedback-control .

ngm:saml-assertion a skos:Concept ;
    rdfs:label "Saml Assertion"@en .

ngm:sampling-procedure a owl:Class ;
    rdfs:label "Sampling Procedure"@en ;
    rdfs:comment "A sampling procedure is the method by which a generative model draws output samples from its learned probability distribution. It governs how latent or noise variables are mapped to concrete outputs, including techniques such as ancestral sampling, temperature scaling, top-k and nucleus sampling, and iterative denoising in diffusion models. The choice of procedure controls the diversity, fidelity, and computational cost of generation."@en ;
    rdfs:subClassOf ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:generative-adversarial-networks,
        ngm:inpainting ;
    vc:slug "sampling-procedure" ;
    vc:sourceDomain "ai" .

ngm:sampling-theory a skos:Concept ;
    rdfs:label "Sampling Theory"@en .

ngm:sandbox-environment a owl:Class ;
    rdfs:label "Sandbox Environment"@en ;
    rdfs:comment "A sandbox environment is an isolated execution context that constrains a program's access to the host system, filesystem, network, and resources. It allows untrusted or autonomous code, such as AI-generated programs or agent actions, to run with controlled side effects and contained failure. Sandboxes are implemented through containers, virtual machines, OS-level namespaces, or language-level interpreters."@en ;
    rdfs:subClassOf ngm:infra-computing-and-cloud ;
    skos:broader ngm:infra-computing-and-cloud ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:cli-multi-agent-systems,
        ngm:gpt-engineer ;
    vc:slug "sandbox-environment" ;
    vc:sourceDomain "infrastructure" .

ngm:scene-reconstruction a skos:Concept ;
    rdfs:label "Scene Reconstruction"@en .

ngm:schema-mapping a skos:Concept ;
    rdfs:label "Schema Mapping"@en .

ngm:scientific-discovery a owl:Class ;
    rdfs:label "Scientific Discovery"@en ;
    rdfs:comment "Scientific discovery in AI refers to the application of machine learning, knowledge-graph reasoning, and autonomous experimentation systems to accelerate the identification of novel scientific findings, generate and test hypotheses, and interpret complex experimental data at scales beyond human cognitive capacity. It encompasses AI-driven approaches across domains including drug discovery, materials science, genomics, and climate modelling, where the goal is to augment or automate stages of the scientific method from hypothesis generation through experimental design to result interpretation."@en ;
    rdfs:subClassOf ngm:ai-research-area ;
    skos:broader ngm:ai-research-area ;
    vc:enables ngm:drug-discovery,
        ngm:knowledge-graph ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:drug-discovery-ai ;
    vc:slug "scientific-discovery" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:generative-model,
        ngm:machine-learning-discipline .

ngm:scikit-learn a skos:Concept ;
    rdfs:label "Scikit Learn"@en .

ngm:scope-definition a owl:Class ;
    rdfs:label "Scope Definition"@en ;
    rdfs:comment "Scope definition is the act of establishing the precise boundaries, entities, and conditions to which an assessment, consent, or measurement applies. In governance and consent systems it specifies which permissions, data, or activities are covered, while in environmental assessment it delineates the system boundary for impact accounting. Clear scope is a prerequisite for auditable and comparable results."@en ;
    rdfs:subClassOf ngm:governance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:blockchain-environmental-impact-assessment,
        ngm:user-consent-token ;
    vc:slug "scope-definition" ;
    vc:sourceDomain "governance" .

ngm:score-based-generative-model a skos:Concept ;
    rdfs:label "Score Based Generative Model"@en .

ngm:score-matching a owl:Class ;
    rdfs:label "Score Matching"@en ;
    rdfs:comment "Score matching is a method for fitting probability models by matching the gradient of the log-density, the score, of the model to that of the data, avoiding the intractable normalising constant. It underpins score-based generative models and diffusion models."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:probability-theory ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:statistics ],
        ngm:machine-learning-discipline ;
    vc:enables ngm:diffusion-model ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:probability-theory,
        ngm:statistics ;
    vc:slug "score-matching" ;
    vc:sourceDomain "machine-learning" .

ngm:scripting-language a owl:Class ;
    rdfs:label "Scripting Language"@en ;
    rdfs:comment "A scripting language is an interpreted or dynamically compiled programming language used to automate tasks, define interactive behaviours, and extend the capabilities of host applications or game engines without modifying core engine code. In metaverse contexts, scripting languages such as JavaScript, Lua, Python, and C# enable content creators to author custom gameplay mechanics, NPC behaviour, and dynamic environment logic with rapid iteration cycles."@en ;
    rdfs:subClassOf ngm:infra-software-engineering ;
    skos:broader ngm:infra-software-engineering ;
    vc:enables ngm:game-development,
