vf:odometry a owl:Class ;
    rdfs:label "Odometry"@en ;
    rdfs:comment "The estimation of a mobile robot's position and orientation (pose) over time by integrating motion measurements from wheel encoders, IMUs, or visual sensors. It provides relative position estimates based on incremental motion."@en ;
    rdfs:subClassOf vf:state-estimation ;
    vc:authorityScore "0.94"^^xsd:float ;
    vc:enables vf:navigation,
        vf:rb-1013-localization ;
    vc:maturity "mature" ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires <urn:visionflow:linked:motion-sensors> ;
    vc:slug "odometry" ;
    vc:sourceDomain "robotics" .

