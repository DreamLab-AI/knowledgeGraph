    vc:qualityScore "0.35"^^xsd:float ;
    vc:slug "spatial-coordinates" ;
    vc:sourceDomain "spatial-computing" .

ngm:spatial-tracking a owl:Class ;
    rdfs:label "Spatial Tracking"@en ;
    rdfs:comment "Technology that determines the position and orientation of objects in three-dimensional space using six degrees of freedom (6DoF), enabling precise tracking of headsets, controllers, and body movements through inside-out or outside-in sensor configurations."@en ;
    rdfs:subClassOf ngm:motion-tracking,
        ngm:sc-interaction ;
    skos:broader ngm:sc-interaction ;
    vc:enables ngm:immersive-vr ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:slug "spatial-tracking" ;
    vc:sourceDomain "spatial-computing" .

ngm:spatial-tracking-technology a owl:Class ;
    rdfs:label "Spatial Tracking Technology"@en ;
    rdfs:comment "Hardware and software systems that determine the position and orientation of physical objects, users, or devices in three-dimensional space in real time. Spatial tracking underpins head-mounted display tracking, hand and eye tracking, and room-scale boundary definition in virtual and mixed reality systems, enabling accurate registration between physical movement and virtual scene response."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:hand-tracking ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:motion-tracking ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:sensor-fusion ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:eye-tracking ],
        ngm:sc-interaction ;
    skos:broader ngm:sc-interaction ;
    vc:enables ngm:mixed-reality,
        ngm:room-scale ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:eye-tracking,
        ngm:hand-tracking,
        ngm:motion-tracking ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:haptic-feedback,
        ngm:spatial-tracking-system ;
    vc:requires ngm:sensor-fusion ;
    vc:slug "spatial-tracking-technology" ;
    vc:sourceDomain "spatial-computing" .

ngm:spatial-web a owl:Class ;
    rdfs:label "Spatial Web"@en ;
    rdfs:comment "The Spatial Web is a computing paradigm that overlays machine-readable semantic information on physical locations and objects, enabling devices to understand and interact with the real world in context. It combines spatial computing, geospatial data, IoT sensors, and web standards to blur the boundary between physical and digital environments, and is regarded as a foundational layer for persistent augmented reality and metaverse experiences."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:spatial-anchor ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:internet-of-things ],
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:bridgesTo ngm:semantic-web,
        ngm:web3 ;
    vc:enables ngm:augmented-reality,
        ngm:immersive-experience ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:internet-of-things,
        ngm:spatial-anchor ;
    vc:slug "spatial-web" ;
    vc:sourceDomain "spatial-computing" .

ngm:stability a owl:Class ;
    rdfs:label "Stability"@en ;
    rdfs:comment "Stability is the property of a dynamical or control system whereby its state remains bounded and returns toward an equilibrium following a disturbance, rather than diverging. Formalised through notions such as Lyapunov stability and bounded-input bounded-output stability, it is a primary design objective for any feedback controller. Ensuring stability is prerequisite to performance, since an unstable system cannot be made to track references reliably."@en ;
    rdfs:subClassOf ngm:control-theory ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:control-systems-domain,
        ngm:feedback-loop ;
    vc:slug "stability" ;
    vc:sourceDomain "robotics" .

ngm:stablecoin-token a owl:Class ;
    rdfs:label "Stablecoin Token"@en ;
    rdfs:comment "A Stablecoin Token is a blockchain-native fungible token engineered to maintain a stable value, typically pegged to a fiat currency, commodity, or basket of assets, through one of three principal mechanisms: fiat-collateralised reserves held by a custodian (e.g. USDC, USDT), crypto-collateralised over-collateralisation enforced by smart contracts (e.g. DAI), or algorithmic supply adjustment that mints and burns tokens to defend the peg without direct collateral. Stablecoins serve as the primary medium of exchange, unit of account, and store of value within decentralised finance ecosystems, enabling lending, borrowing, and trading without exposure to cryptocurrency price volatility."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:smart-contract ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:blockchain ],
        ngm:bc-token-and-asset,
        ngm:fungible-token ;
    skos:broader ngm:bc-token-and-asset ;
    vc:contrastsWith ngm:deflationary-token,
        ngm:inflationary-token ;
    vc:enables ngm:interoperability,
        ngm:transaction ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:central-bank-digital-currency,
        ngm:cryptocurrency,
        ngm:digital-currency,
        ngm:erc20-token,
        ngm:token-economics ;
    vc:requires ngm:blockchain,
        ngm:smart-contract ;
    vc:slug "stablecoin-token" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:price-oracle,
        ngm:tokenomics .

ngm:stacker-news a owl:Class ;
    rdfs:label "Stacker News"@en ;
    rdfs:comment "Stacker News is an online community platform where users post and curate content and reward contributions with bitcoin payments over the Lightning Network."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:lightning-network ],
