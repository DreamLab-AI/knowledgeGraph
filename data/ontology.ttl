dc1:creator a owl:AnnotationProperty .

skos:broader a owl:AnnotationProperty .

ngm:1-inch a owl:Class ;
    rdfs:label "1inch"@en ;
    rdfs:comment "A decentralised exchange aggregator that routes trades across multiple liquidity sources to find favourable execution prices on Ethereum and other chains."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:smart-contract ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:automated-market-maker ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ethereum-smart-contract-platform ],
        ngm:decentralized-exchange ;
    vc:enables ngm:liquidity-pool ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:automated-market-maker,
        ngm:ethereum-smart-contract-platform,
        ngm:smart-contract ;
    vc:slug "1-inch" ;
    vc:sourceDomain "blockchain" .

ngm:3-d-and-4-d a owl:Class ;
    rdfs:label "3D and 4D"@en ;
    rdfs:comment "The domain of three-dimensional and four-dimensional content creation, covering tools, techniques, and AI-powered pipelines for generating, editing, and rendering 3D assets and temporally dynamic (4D) representations. Encompasses text-to-3D systems (NVIDIA Edify, Luma Genie, Point-E), neural radiance fields, Gaussian splatting, and diffusion-based mesh generation, as well as 6D pose estimation, scene-scale generation, and integration with AR/VR workflows."@en ;
    rdfs:subClassOf ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:enables ngm:3-d-asset,
        ngm:augmented-reality,
        ngm:pose-estimation ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:relatedTo ngm:computer-vision,
        ngm:machine-learning-discipline ;
    vc:slug "3-d-and-4-d" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:deep-learning,
        ngm:diffusion-model,
        ngm:generative-ai,
        ngm:neural-radiance-field .

ngm:aave-companies a owl:Class ;
    rdfs:label "Aave Companies"@en ;
    rdfs:comment "Aave Companies is the development company, founded by Stani Kulechov, behind the Aave decentralised lending protocol and related products. It was formerly known as ETHLend."@en ;
    rdfs:subClassOf ngm:aave ;
    vc:enables ngm:lending-protocol ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:slug "aave-companies" ;
    vc:sourceDomain "blockchain" .

ngm:access-controls a owl:Class ;
    rdfs:label "Access Controls"@en ;
    rdfs:comment "Access controls are mechanisms that govern which subjects may perform which operations on resources, enforcing authorisation policies."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:authentication ],
        ngm:authorisation ;
    vc:enables ngm:information-security ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:authentication ;
    vc:slug "access-controls" ;
    vc:sourceDomain "distributed-systems" .

ngm:accountable-party a owl:Class ;
    rdfs:label "Accountable Party"@en ;
    rdfs:comment "An Accountable Party is an individual, organisation, or role that bears defined responsibility for specific aspects of an AI system's development, deployment, operation, or outcomes, with corresponding obligations to ensure compliance with governance principles, regulatory requirements, and ethical standards. Accountability addresses the foundational question of who bears responsibility when AI systems cause harm or produce unfair outcomes, requiring that identifiable parties possess the authority, resources, and monitoring capacity commensurate with their obligations. Accountable parties span the AI value chain—from data providers and model developers to deploying organisations, system operators, and governance bodies—each with lifecycle-specific duties enforced through formal reporting structures and consequence mechanisms."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:human-oversight ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:compliance-framework ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:ai-ethics-board ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:accountability ],
        ngm:ai-governance-and-ethics,
        ngm:ai-governance-principle ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:enables ngm:ai-governance,
        ngm:compliance-monitoring,
        ngm:transparency ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:ai-ethics-board ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:ai-regulation,
        ngm:audit-trail,
        ngm:compliance-control,
        ngm:risk-assessment ;
    vc:requires ngm:accountability,
        ngm:compliance-framework,
        ngm:human-oversight ;
    vc:slug "accountable-party" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:standardizedBy ngm:ai-governance-framework ;
    vc:supports ngm:ai-governance-and-ethics,
        ngm:governance-framework .

ngm:active-r-d-funding-opportunities-register a owl:Class ;
    rdfs:label "Active R&D Funding Opportunities Register"@en ;
    rdfs:comment "A curated register of active and accessible funding opportunities for immersive technology, AI, and creative industries R&D, encompassing Innovate UK grants, UKRI programmes, ARIA challenges, Web3 venture capital, and academic grant schemes. The register tracks application status, eligibility constraints, match-funding requirements, and strategic alignment to accelerate project funding decisions."@en ;
    rdfs:subClassOf ngm:infra-software-engineering,
        ngm:resource-management ;
    skos:broader ngm:infra-software-engineering ;
    vc:enables ngm:ai-agent-system,
        ngm:immersive-technology ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:extended-reality,
        ngm:resource-management ;
    vc:slug "active-r-d-funding-opportunities-register" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:agentic-ai,
        ngm:knowledge-graph .

ngm:adr-008 a owl:Class ;
    rdfs:label "ADR-008"@en ;
    rdfs:comment "An architecture decision record numbered 008, documenting a specific architectural choice within a project together with its context, options considered, and consequences. ADRs form a chronological log of design decisions."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
