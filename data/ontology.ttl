spatial-computing:3DModeling rdf:type owl:Class ;
    rdfs:subClassOf spatial-computing:DigitalArt ;
    rdfs:subClassOf spatial-computing:3DDevelopment ;
    rdfs:label "3D Modeling"@en ;
    rdfs:comment "3D Modeling is the artistic and technical discipline of creating three-dimensional digital forms using specialised software tools. It encompasses organic modelling (characters, creatures), hard-surface modelling (architecture, vehicles), texture development, and material definition, producing 3D Models suitable for animation, rendering, and real-time applications in games and immersive environments."@en ;
    skos:prefLabel "3D Modeling"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:spatial-computing:3d-modeling" ;
    owl:sameAs <urn:visionclaw:concept:spatial-computing:3d-modeling> ;
