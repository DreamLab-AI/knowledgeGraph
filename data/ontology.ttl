    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:w3-c ;
    vc:slug "w-3-c-verifiable-credentials-data-model-2-0" ;
    vc:sourceDomain "standards" .

ngm:walmart a owl:Class ;
    rdfs:label "Walmart"@en ;
    rdfs:comment "Walmart is a multinational retail company operating a chain of stores and e-commerce services, and an early adopter of blockchain-based supply chain traceability."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:supply-chain ],
        ngm:supply-chain ;
    vc:enables ngm:food-safety ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:supply-chain ;
    vc:slug "walmart" ;
    vc:sourceDomain "general" .

ngm:warmup a owl:Class ;
    rdfs:label "Warmup"@en ;
    rdfs:comment "A training technique where the learning rate starts small and gradually increases over a fixed number of initial steps to stabilise optimisation. Warmup prevents large early gradients from destabilising weight updates and is standard practice for large transformer models, typically preceding a cosine or linear decay schedule."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:learning-rate-schedule ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:optimiser ],
        ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:enables ngm:deep-learning ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:training ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires ngm:learning-rate-schedule,
        ngm:optimiser ;
    vc:slug "warmup" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:gradient-descent .

ngm:wayve a owl:Class ;
    rdfs:label "Wayve"@en ;
    rdfs:comment "Wayve is a British company developing self-driving technology based on end-to-end machine learning rather than hand-coded rules. It is headquartered in London."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:machine-learning ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:computer-vision ],
        ngm:autonomous-driving ;
    vc:enables ngm:autonomous-vehicle ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:computer-vision,
        ngm:machine-learning ;
    vc:slug "wayve" ;
    vc:sourceDomain "robotics" .

ngm:web-bookmarks a owl:Class ;
    rdfs:label "Web Bookmarks"@en ;
    rdfs:comment "A curated collection of saved hyperlinks to external web resources, serving as a personal or shared reference library for articles, tools, and research material. In knowledge management contexts, web bookmarks act as annotated entry points linking internal knowledge graphs to external sources."@en ;
    rdfs:subClassOf ngm:infra-software-engineering ;
    skos:broader ngm:infra-software-engineering ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:knowledge-management ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:relatedTo ngm:knowledge-base,
        ngm:web-technology ;
    vc:slug "web-bookmarks" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:web-dev-and-consumer-tooling .

ngm:webid a owl:Class ;
    rdfs:label "webid"@en ;
    rdfs:comment "A WebID is a URI that uniquely identifies an agent (person, organisation, or software) on the web and dereferences to an RDF profile document containing structured data about that agent. It underpins decentralised identity and access control across the Solid ecosystem and linked-data applications, allowing any service to authenticate and authorise users without a central identity provider."@en ;
    rdfs:subClassOf ngm:bc-network-component ;
    skos:broader ngm:bc-network-component ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:decentralized-identity-did,
        ngm:linked-data,
        ngm:rdf,
        ngm:self-sovereign-identity,
        ngm:semantic-web,
        ngm:solid,
        ngm:solid-pod ;
    vc:slug "webid" ;
    vc:sourceDomain "identity" ;
    vc:supports ngm:data-sovereignty,
        ngm:privacy,
        ngm:verifiable-credentials ;
    vc:uses ngm:access-control,
        ngm:authentication .

ngm:weight-decay a owl:Class ;
    rdfs:label "Weight Decay"@en ;
    rdfs:comment "A regularisation technique that adds a penalty proportional to the L2 norm of model weights to the loss function, discouraging large weight magnitudes and thereby limiting model complexity. Weight decay prevents overfitting, promotes simpler generalisable solutions, and in optimisers such as AdamW is implemented directly in the weight update step rather than via loss augmentation."@en ;
    rdfs:subClassOf ngm:ai-technique,
        ngm:machine-learning-technique ;
    skos:broader ngm:ai-technique ;
    vc:contrastsWith ngm:dropout ;
    vc:enables ngm:regularisation ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:training ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:slug "weight-decay" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:gradient-descent,
        ngm:optimiser .

ngm:wireless-value-realization a owl:Class ;
    rdfs:label "Wireless Value Realization"@en ;
    rdfs:comment "Wireless Value Realization is the strategic process of identifying, measuring, and maximising the business and operational benefits derived from wireless technologies — including 5G, Wi-Fi 6/7, Bluetooth, and LPWAN — by aligning connectivity investments with productivity, efficiency, and innovation outcomes. It encompasses analytics-driven optimisation of wireless data flows, integration with edge computing and IoT sensor networks, and governance frameworks that translate connectivity capability into quantifiable organisational value. The concept moves beyond infrastructure provision to treat wireless as an active enabler of digital transformation."@en ;
    rdfs:subClassOf ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:enables ngm:digital-transformation,
        ngm:edge-ai-for-smart-cities,
        ngm:io-t-ai-integration ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:bandwidth-adaptation,
        ngm:edge-cloud-collaboration,
        ngm:edge-mesh-network,
        ngm:industrial-io-t,
        ngm:io-t-sensors,
        ngm:latency ;
    vc:slug "wireless-value-realization" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:6-g-network-slice,
        ngm:edge-computing,
        ngm:internet-of-things,
        ngm:io-t-sensor-network .

ngm:world-economic-forum a owl:Class ;
    rdfs:label "World Economic Forum"@en ;
    rdfs:comment "The World Economic Forum is an international organisation based in Switzerland that convenes leaders from business, government, and civil society to discuss global issues. It is best known for its annual meeting in Davos."@en ;
    rdfs:subClassOf ngm:owl-thing ;
    vc:enables ngm:governance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:slug "world-economic-forum" ;
    vc:sourceDomain "governance" .

ngm:world-instance a owl:Class ;
    rdfs:label "World Instance"@en ;
    rdfs:comment "A runtime instantiation of a virtual world template that maintains isolated state, physics simulation, and user interactions for a bounded set of concurrent participants. World instances enable scalable multi-user virtual environments through dynamic spawning, load balancing, and state checkpointing, as seen in MMO dungeons, battle royale matches, and social VR rooms."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:scene-graph ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:physics-simulation ],
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:enables ngm:spatial-computing,
        ngm:virtual-reality ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:metaverse,
        ngm:virtual-world ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires ngm:physics-simulation,
        ngm:scene-graph ;
    vc:slug "world-instance" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:digital-twin .

ngm:x-dai a owl:Class ;
    rdfs:label "xDai"@en ;
    rdfs:comment "xDai was the original name for the stable-token chain that became Gnosis Chain, an Ethereum-compatible sidechain using a stablecoin for transaction fees. It now operates under the Gnosis Chain name."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ethereum ],
        ngm:gnosis-chain ;
    vc:enables ngm:de-fi ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:ethereum ;
    vc:slug "x-dai" ;
    vc:sourceDomain "blockchain" .

ngm:xlnet a owl:Class ;
    rdfs:label "XLNet"@en ;
    rdfs:comment "A generalised autoregressive pre-training model that learns bidirectional contexts by maximising the expected likelihood over all permutations of the token factorisation order, using a two-stream self-attention mechanism to avoid information leakage. XLNet integrates the Transformer-XL segment recurrence mechanism for long-range dependency modelling and outperforms BERT on 20 NLU benchmarks."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:vocabulary ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:training ],
        ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:contrastsWith ngm:word-piece ;
    vc:enables ngm:inference ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires ngm:training,
        ngm:vocabulary ;
    vc:slug "xlnet" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:natural-language-processing,
        ngm:transformer .

ngm:xr-technical-standard a owl:Class ;
