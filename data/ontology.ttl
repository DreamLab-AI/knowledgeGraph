    vc:uses ngm:content-authenticity ;
    vc:uses ngm:digital-watermarking .
ngm:information-management a owl:Class ;
    rdfs:comment "The organisational discipline of acquiring, organising, storing, curating, securing, distributing, and disposing of information across its lifecycle so that the right information reaches the right people, in the right form, at the right time. It spans structured data and unstructured content alike, sitting between data management (which stewards raw data assets) and knowledge management (which cultivates human understanding), and is governed by policies for quality, retention, access, and compliance."@en ;
    rdfs:label "Information Management"@en ;
    rdfs:subClassOf ngm:data-management ;
    rdfs:subClassOf _:r12546 ;
    rdfs:subClassOf _:r12547 ;
