ngm:centralized-application a owl:Class ;
    rdfs:comment "A software application whose logic, state, and data are operated by a single controlling entity on infrastructure it administers, typically following a client-server architecture in which users depend on the operator for availability, data custody, access control, and rule changes, in contrast to decentralised applications whose execution and state are replicated across a permissionless network."@en ;
    rdfs:label "Centralised Application"@en ;
    rdfs:subClassOf ngm:software-system ;
