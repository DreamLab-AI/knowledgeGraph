ngm:backdoor-attack a owl:Class ;
    rdfs:label "Backdoor Attack"@en ;
    rdfs:comment "A training-time adversarial attack that embeds a hidden trigger pattern into an AI model via data poisoning, causing the model to behave normally on standard inputs but produce attacker-chosen outputs when the trigger is present, creating a covert vulnerability that survives fine-tuning and is exploitable post-deployment."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ai-safety ],
        ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:contrastsWith ngm:adversarial-attack,
        ngm:adversarial-robustness ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:relatedTo ngm:model-robustness,
        ngm:privacy ;
    vc:requires ngm:ai-safety ;
    vc:slug "backdoor-attack" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:data-poisoning,
        ngm:machine-learning-model .

