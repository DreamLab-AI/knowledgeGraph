    vc:slug "tally" ;
    vc:sourceDomain "governance" .

ngm:task-automation a owl:Class ;
    rdfs:label "Task Automation"@en ;
    rdfs:comment "The automation of individual, often repetitive tasks so that they run without manual effort. It addresses discrete actions rather than coordinating entire business processes."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:automation ],
        ngm:automation ;
    vc:enables ngm:business-process-automation ;
