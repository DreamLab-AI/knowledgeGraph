    vc:slug "computer-vision-video-analysis" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:computer-vision,
        ngm:convolutional-neural-network,
        ngm:transformer .

ngm:confidential-transactions a owl:Class ;
    rdfs:label "Confidential Transactions"@en ;
    rdfs:comment "Confidential Transactions (CT) is a cryptographic protocol for distributed ledgers, designed by Gregory Maxwell in 2015, that conceals the amounts transferred in financial transactions whilst preserving the ability for validators to verify that no value is created or destroyed. It employs Pedersen commitments—homomorphic elliptic-curve constructs—to encode transaction values in a form that is computationally hiding yet perfectly binding, combined with range proofs (typically Bulletproofs) to ensure committed values are non-negative and thus prevent inflation attacks. CT has been deployed in the Liquid Network sidechain, Monero's RingCT, and the MimbleWimble protocol family, and underpins much of the contemporary research into privacy-preserving decentralised finance."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptographic-hash-function ],
        ngm:blockchain-transaction ;
    vc:bridgesTo ngm:financial-privacy,
        ngm:regulatory-compliance,
        ngm:secure-multi-party-computation ;
    vc:contrastsWith ngm:public-transaction,
        ngm:transparent-blockchain,
        ngm:zk-snark ;
    vc:dependsOn ngm:cryptographic-algorithm,
        ngm:utxo-model ;
    vc:enables ngm:confidential-asset,
        ngm:privacy-preserving-blockchain,
        ngm:private-defi,
        ngm:selective-disclosure ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:amount-hiding,
        ngm:homomorphic-commitment ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:confidential-computing,
        ngm:liquid-network,
        ngm:mimblewimble,
        ngm:monero,
        ngm:ring-confidential-transactions ;
    vc:requires ngm:cryptographic-hash-function,
        ngm:discrete-logarithm-problem,
        ngm:range-proof ;
    vc:slug "confidential-transactions" ;
    vc:sourceDomain "blockchain" ;
    vc:standardizedBy ngm:bitcoin-improvement-proposal,
        ngm:elements-project ;
    vc:uses ngm:bulletproofs,
        ngm:elliptic-curve-cryptography,
        ngm:homomorphic-encryption,
        ngm:pedersen-commitment,
        ngm:zero-knowledge-proof .

