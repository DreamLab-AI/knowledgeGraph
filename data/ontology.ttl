ngm:cloud-gaming a owl:Class ;
    rdfs:comment "Cloud gaming is a model in which games are rendered on remote server GPUs and streamed as video to a client device, while player input is sent back to the server over the network. It shifts compute off the end device, allowing demanding titles to run on thin clients, but is highly sensitive to network latency, bandwidth, and jitter. It matters as a delivery paradigm that depends on adaptive bitrate streaming and low-latency encoding to maintain interactivity."@en ;
    rdfs:label "Cloud Gaming"@en ;
    rdfs:subClassOf ngm:infra-computing-and-cloud ;
