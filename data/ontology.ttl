    vc:relatedTo ngm:ai-ethics,
        ngm:ai-regulation,
        ngm:competition-policy,
        ngm:data-governance,
        ngm:intellectual-property,
        ngm:technology-policy ;
    vc:requires ngm:impact-assessment,
        ngm:risk-assessment,
        ngm:stakeholder-consultation ;
    vc:slug "ai-policy" ;
