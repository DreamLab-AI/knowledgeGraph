ngm:responsible-ai a owl:Class ;
    rdfs:label "Responsible AI"@en ;
    rdfs:comment "The practice of designing, developing, deploying, and operating artificial intelligence systems with explicit attention to their societal impacts, ethical implications, and potential harms, incorporating accountability mechanisms, stakeholder engagement, risk management, transparency, and governance throughout the AI lifecycle to ensure that AI systems are developed and used in ways that benefit individuals and society whilst minimising negative consequences, respecting human rights and democratic values, and maintaining clear lines of responsibility for AI-driven outcomes."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ai-impact-assessment ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:human-oversight ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:accountability ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:fairness ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:stakeholder-engagement ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:ai-audit ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ai-risk-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:transparency ],
        ngm:ai-governance ;
    vc:bridgesTo ngm:corporate-governance,
        ngm:data-governance,
        ngm:human-rights ;
    vc:contrastsWith ngm:ai-safety-washing,
        ngm:algorithmic-bias ;
    vc:enables ngm:public-trust-in-ai,
        ngm:social-licence-for-ai,
        ngm:trustworthy-ai ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:accountability,
        ngm:ai-audit,
        ngm:fairness,
        ngm:human-oversight,
        ngm:transparency ;
    vc:implements ngm:ethical-ai,
        ngm:iso-iec-42001,
        ngm:nist-ai-risk-management-framework ;
    vc:isPartOf ngm:ai-governance ;
    vc:qualityScore "0.65"^^xsd:float ;
    vc:relatedTo ngm:ai-safety,
        ngm:algorithmic-accountability,
        ngm:explainability ;
    vc:requires ngm:ai-impact-assessment,
        ngm:ai-risk-management,
        ngm:risk-management-processes,
        ngm:stakeholder-engagement ;
    vc:slug "responsible-ai" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:standardizedBy ngm:eu-ai-act,
        ngm:oecd-ai-principles .

ngm:compliance-framework a owl:Class ;
    rdfs:label "Compliance Framework"@en ;
    rdfs:comment "A Compliance Framework is a structured set of policies, controls, procedures, and audit mechanisms that organisations implement to satisfy regulatory obligations and industry standards governing the design, development, and deployment of systems — especially AI and data-intensive systems. It systematically maps external legal requirements (such as the EU AI Act, GDPR, ISO 42001, and NIST AI RMF) onto internal risk registers, technical documentation, accountability chains, and monitoring pipelines. A compliance framework defines the scope of applicability, assigns ownership of controls, establishes evidence-collection workflows, and mandates review cycles so that organisations can continuously demonstrate conformance to auditors, regulators, and stakeholders. It bridges governance intent with operational practice by providing a traceable path from regulatory obligation through implemented control to verified outcome."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:risk-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:audit-trail ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-governance ],
        ngm:ai-governance-and-ethics ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:bridgesTo ngm:blockchain,
        ngm:explainable-ai,
        ngm:smart-contract ;
    vc:contrastsWith ngm:voluntary-guidelines ;
    vc:enables ngm:accountability,
        ngm:organisational-trust,
        ngm:regulatory-compliance,
        ngm:transparency ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:eu-ai-act,
        ngm:gdpr,
        ngm:nist-ai-rmf ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:ai-governance,
        ngm:algorithmic-impact-assessment,
        ngm:corporate-governance,
        ngm:model-card ;
    vc:requires ngm:audit-trail,
        ngm:data-governance,
        ngm:policy-management,
        ngm:risk-management ;
    vc:slug "compliance-framework" ;
    vc:sourceDomain "governance" ;
    vc:standardizedBy ngm:iso-27001,
        ngm:iso-42001,
        ngm:nist-cybersecurity-framework ;
    vc:supports ngm:ai-ethics,
        ngm:information-security,
        ngm:privacy-engineering,
        ngm:responsible-ai .

ngm:backpropagation a owl:Class ;
    rdfs:label "Backpropagation"@en ;
    rdfs:comment "Backpropagation is the algorithm for computing gradients of the loss function with respect to each weight in a neural network by applying the chain rule of calculus in reverse through the computation graph. It enables efficient gradient calculation across all layers in a single backward pass, making large-scale neural network training computationally feasible."@en ;
    rdfs:subClassOf ngm:optimization-algorithm ;
    vc:bridgesTo ngm:federated-learning,
        ngm:neuromorphic-computing ;
    vc:contrastsWith ngm:forward-mode-differentiation,
        ngm:genetic-algorithm ;
    vc:dependsOn ngm:activation-function,
        ngm:loss-function ;
    vc:enables ngm:deep-learning,
        ngm:gradient-descent,
        ngm:model-training,
        ngm:weight-update ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:backward-pass,
        ngm:chain-rule,
        ngm:forward-pass ;
    vc:isPartOf ngm:neural-network-training ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:batch-normalisation,
        ngm:dropout-regularisation,
        ngm:recurrent-neural-network,
        ngm:vanishing-gradient-problem ;
    vc:requires ngm:computation-graph,
        ngm:differentiable-function ;
    vc:slug "backpropagation" ;
    vc:sourceDomain "machine-learning" ;
    vc:uses ngm:automatic-differentiation,
        ngm:neural-network,
        ngm:stochastic-gradient-descent .

ngm:transformer a owl:Class ;
    rdfs:label "Transformer"@en ;
    rdfs:comment "A neural network architecture that relies entirely on self-attention mechanisms rather than recurrence or convolution to process sequential data in parallel, serving as the foundation for modern large language models, vision models, and multimodal systems including GPT, BERT, and their successors."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:feed-forward-network ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:parallel-computing ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:self-attention ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:attention-mechanism ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gradient-descent ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:multi-head-attention ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:layer-normalisation ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:positional-encoding ],
        ngm:ai-model-architecture ;
    skos:broader ngm:ai-model-architecture ;
    vc:bridgesTo ngm:computer-vision,
        ngm:robotics-policy ;
    vc:contrastsWith ngm:convolutional-neural-network,
        ngm:recurrent-neural-network,
        ngm:state-space-model ;
    vc:enables ngm:bert,
        ngm:gpt,
        ngm:in-context-learning,
        ngm:large-language-models,
        ngm:large-scale-pretrained-foundation-model,
        ngm:transfer-learning ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:feed-forward-network,
        ngm:layer-normalisation,
        ngm:multi-head-attention,
        ngm:positional-encoding,
        ngm:self-attention ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:attention-mechanism,
        ngm:large-language-models,
        ngm:large-scale-pretrained-foundation-model,
        ngm:neural-scaling-law,
        ngm:self-attention ;
    vc:requires ngm:attention-mechanism,
        ngm:gradient-descent,
        ngm:parallel-computing ;
    vc:slug "transformer" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:standardizedBy ngm:iso-iec-22989,
        ngm:nist-ai-600-1 ;
    vc:uses ngm:embedding,
        ngm:self-supervised-learning,
        ngm:tokenisation .

ngm:governance a owl:Class ;
    rdfs:label "Governance"@en ;
    rdfs:comment "Governance is the set of processes, institutions, norms, rules, and practices by which authority is exercised and decisions are made within an organisation, system, or society. It encompasses the mechanisms through which stakeholders participate in, constrain, and are held accountable by decision-making structures, balancing competing interests through legitimate frameworks. In technical and sociotechnical contexts, governance determines who controls shared resources, how policies are formed and enforced, and how disputes are resolved. Effective governance integrates regulatory compliance, ethical accountability, risk management, and participatory design to achieve legitimate and adaptive coordination."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
