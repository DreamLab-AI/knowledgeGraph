        ngm:surveillance ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:implements ngm:path-planning ;
    vc:isPartOf ngm:robotics ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:autonomous-vehicle,
        ngm:quadcopter,
        ngm:swarm-robotics ;
    vc:requires ngm:autonomous-navigation,
