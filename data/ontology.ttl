    skos:broader ngm:ai-governance-and-ethics ;
    vc:enables ngm:ai-accountability,
        ngm:algorithmic-auditing,
        ngm:regulatory-compliance,
        ngm:stakeholder-trust ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:audit-trail,
        ngm:bias-detection-methods,
        ngm:disclosure-requirements,
        ngm:documentation-standards,
        ngm:performance-metrics ;
    vc:isPartOf ngm:ai-governance-framework,
        ngm:algorithmic-accountability ;
    vc:qualityScore "0.35"^^xsd:float ;
