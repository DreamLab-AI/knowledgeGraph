ngm:breadth-first-search a owl:Class ;
    rdfs:comment "Breadth-first search (BFS) is a graph and tree traversal algorithm that explores all neighbours of a node before moving to nodes at the next depth level, expanding the search frontier in order of increasing distance from the source. It is implemented with a first-in-first-out queue and, on unweighted graphs, finds the shortest path in terms of edge count from the start vertex to every reachable vertex. BFS runs in time linear in the number of vertices and edges and is foundational to pathfinding, connectivity analysis and level-order processing."@en ;
    rdfs:label "Breadth-First Search"@en ;
    rdfs:subClassOf ngm:graph-algorithms ;
    rdfs:subClassOf ngm:graph-search ;
    rdfs:subClassOf ngm:search-algorithm ;
