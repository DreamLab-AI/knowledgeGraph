ngm:facial-animation a owl:Class ;
    rdfs:label "Facial Animation"@en ;
    rdfs:comment "Facial animation is the discipline of generating expressive, lifelike movement of a digital character's face, including lip synchronisation, eye motion, and emotional expression. It commonly combines blend-shape (morph-target) deformation, facial rigs, and performance-capture data to drive realistic results. Facial animation is essential for believable avatars, virtual humans, and immersive experiences in spatial computing."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:motion-capture ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:real-time-rendering ],
        ngm:character-animation ;
    vc:bridgesTo ngm:spatial-computing ;
    vc:dependsOn ngm:character-animation,
        ngm:skeletal-animation ;
    vc:enables ngm:avatar,
        ngm:real-time-rendering ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:motion-capture ;
    vc:isPartOf ngm:character-animation ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:character-animation,
        ngm:motion-capture,
        ngm:skeletal-animation ;
    vc:requires ngm:real-time-rendering ;
    vc:slug "facial-animation" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:avatar ;
    vc:uses ngm:motion-capture,
        ngm:skeletal-animation .

ngm:fairness-accuracy-tradeoffs a owl:Class ;
    rdfs:label "Fairness Accuracy Tradeoffs"@en ;
    rdfs:comment "The fundamental tension in supervised machine learning between maximising predictive accuracy and satisfying fairness constraints, characterised by the Pareto frontier of achievable (accuracy, fairness) pairs. Imposing fairness constraints restricts the hypothesis space, excluding models that achieve accuracy through reliance on protected-attribute correlations. The magnitude of the accuracy cost depends on the chosen fairness criterion (demographic parity, equalised odds, calibration), the base rate differences between groups, and the flexibility of the model class."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:algorithmic-bias ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:multi-objective-optimisation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:machine-learning-discipline-model ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:supervised-learning ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:calibration ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:demographic-parity ],
        ngm:ai-governance-and-ethics ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:bridgesTo ngm:data,
        ngm:governance ;
    vc:contrastsWith ngm:algorithmic-bias-and-variance ;
    vc:dependsOn ngm:ai-fairness,
        ngm:bias-mitigation-techniques,
        ngm:protected-attribute,
        ngm:statistical-learning-theory ;
    vc:enables ngm:algorithmic-accountability ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:calibration,
        ngm:demographic-parity ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:accountability,
        ngm:ai-ethics,
        ngm:explainable-ai,
        ngm:regularisation,
        ngm:responsible-ai,
        ngm:risk-assessment ;
    vc:requires ngm:algorithmic-bias,
        ngm:machine-learning-discipline-model,
        ngm:multi-objective-optimisation,
        ngm:supervised-learning ;
    vc:slug "fairness-accuracy-tradeoffs" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:ai-governance-and-ethics,
        ngm:responsible-ai-principles .

ngm:fairness-auditing-tools a owl:Class ;
    rdfs:label "Fairness Auditing Tools"@en ;
    rdfs:comment "Fairness Auditing Tools are software libraries, platforms, and frameworks designed to detect, measure, and mitigate algorithmic bias in AI systems through automated analysis, visualisation, and intervention capabilities. They operationalise fairness metrics—such as demographic parity, equalised odds, and predictive parity—across protected attribute groups, supporting both pre-deployment model assessments and continuous production monitoring."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:bias-detection-methods ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:bias-mitigation-techniques ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:fairness-metrics ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:algorithmic-bias ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:training-data ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:machine-learning-discipline-model ],
        ngm:ai-governance-and-ethics ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:enables ngm:ai-governance,
