        ngm:object-storage ;
    vc:isPartOf ngm:infrastructure-layer ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:file-system,
        ngm:network-connectivity,
        ngm:storage-hardware ;
    vc:slug "storage-layer" ;
    vc:sourceDomain "infrastructure" .

ngm:surgical-robot a owl:Class ;
    rdfs:label "Surgical Robot"@en ;
    rdfs:comment "A Surgical Robot is a teleoperated or semi-autonomous robotic system designed to assist surgeons in performing minimally invasive procedures with enhanced precision, dexterity, and haptic feedback. Systems such as the da Vinci platform translate the surgeon's hand movements—filtered for tremor—into sub-millimetre instrument motions within the patient's body, enabling laparoscopic, urological, and cardiac procedures through small incisions."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:sensor-fusion ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:robot-kinematics ],
        ngm:robo-robot-type,
        ngm:service-robot ;
    skos:broader ngm:robo-robot-type ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:robotics ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires ngm:robot-kinematics,
        ngm:sensor-fusion ;
    vc:slug "surgical-robot" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:haptic-feedback,
        ngm:motion-planning .

ngm:symbolic-ai a owl:Class ;
    rdfs:label "Symbolic AI"@en ;
    rdfs:comment "Symbolic AI (Good Old-Fashioned AI, GOFAI) is an approach to artificial intelligence based on explicit symbolic representations of knowledge, logical inference rules, and search algorithms. It underpins expert systems, automated planning, knowledge graphs, and formal reasoning systems, and is currently experiencing a renaissance as a complement to neural approaches in neurosymbolic AI."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:symbolic-reasoning ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:knowledge-graph ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:automated-planning ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:reasoning ],
        ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:contrastsWith ngm:deep-learning,
        ngm:machine-learning,
        ngm:neural-network ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:automated-planning,
        ngm:knowledge-graph,
        ngm:reasoning,
        ngm:symbolic-reasoning ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:ai-technique,
        ngm:bayesian-inference,
        ngm:explainable-ai ;
    vc:slug "symbolic-ai" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:timestamp a owl:Class ;
    rdfs:label "Timestamp"@en ;
    rdfs:comment "A recorded value indicating the time of block creation in a blockchain system, embedded in each block header to establish chronological ordering of the chain and enable time-based protocol rules. Timestamps support difficulty adjustment, consensus validity checks, and provide an immutable audit trail for transaction ordering and data provenance."@en ;
    rdfs:subClassOf ngm:bc-protocol-and-consensus,
        ngm:blockchain-entity,
        ngm:distributed-data-structure ;
    skos:broader ngm:bc-protocol-and-consensus ;
    vc:enables ngm:block-height,
        ngm:finality ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:block,
        ngm:block-header ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:audit-trail,
        ngm:blockchain-transaction,
        ngm:transaction-confirmation ;
    vc:slug "timestamp" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:block-time,
        ngm:consensus-protocol .

ngm:torque a owl:Class ;
    rdfs:label "Torque"@en ;
    rdfs:comment "Torque is the rotational analogue of force, defined as the cross product of the moment arm and the applied force vector (τ = r × F), measured in newton-metres. In robotics it governs joint actuation, grip force, and dynamic loading across mechanical transmissions, and is the primary physical quantity managed by torque-controlled servos and force-torque sensors during manipulation tasks."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:actuator ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:force-torque-sensor ],
        ngm:robo-actuation-and-control,
        ngm:robot-dynamics ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:enables ngm:force-control,
        ngm:haptic-feedback,
        ngm:motion-control ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:robot-joint,
        ngm:robot-kinematics ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:requires ngm:actuator,
        ngm:force-torque-sensor ;
    vc:slug "torque" ;
    vc:sourceDomain "robotics" .

ngm:training-dataset a owl:Class ;
    rdfs:label "Training Dataset"@en ;
    rdfs:comment "A Training Dataset is a curated collection of labelled or unlabelled data used to fit the parameters of a machine learning model, establishing the empirical foundation from which the model generalises to unseen inputs. Its composition—size, diversity, label quality, representational balance, and provenance—fundamentally determines the capabilities and failure modes of the resulting model. Training datasets range from manually annotated corpora (ImageNet, SQuAD) to web-scraped large-scale collections (Common Crawl, LAION-5B) and synthetically generated data. Questions of copyright, consent, bias, and traceability in training datasets have become central to AI governance and legal disputes."@en ;
    rdfs:subClassOf ngm:training-data ;
    vc:enables ngm:evaluation-benchmarks-and-leaderboards,
        ngm:machine-learning-model,
        ngm:model-training ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:data-annotation,
        ngm:training-data-repository,
        ngm:training-dataset-metadata ;
    vc:slug "training-dataset" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:benchmark-standard,
        ngm:data-governance,
        ngm:synthetic-data .

ngm:trust-over-ip-foundation a owl:Class ;
    rdfs:label "Trust Over IP Foundation"@en ;
    rdfs:comment "The Trust over IP (ToIP) Foundation is a Linux Foundation project that defines a dual-stack architecture combining cryptographic trust at the technical layer with human and legal trust governance frameworks for decentralised identity. The lower technical stack encompasses decentralised identifiers, verifiable credentials, and cryptographic key management, whilst the upper governance stack provides legal frameworks, policy schemas, and trust registries enabling parties to establish authoritative trust relationships without a central intermediary. ToIP aims to provide the governance meta-model needed to make self-sovereign identity deployments interoperable at scale."@en ;
    rdfs:subClassOf ngm:bc-network-component ;
    skos:broader ngm:bc-network-component ;
    vc:enables ngm:decentralized-identity-foundation ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:decentralised-identity,
        ngm:did-document ;
    vc:slug "trust-over-ip-foundation" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:self-sovereign-identity,
        ngm:verifiable-credentials .

ngm:virtual-collaboration a owl:Class ;
    rdfs:label "Virtual Collaboration"@en ;
    rdfs:comment "A 3D immersive environment enabling geographically distributed teams to interact via avatar identities, perform work tasks in real time, and access shared artefacts through metaverse-enabled workspaces. Capabilities include interactive whiteboards, document co-editing, spatial audio, and persistent virtual rooms accessible via desktop, mobile, and VR/AR devices."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:spatial-audio ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:avatar ],
        ngm:sc-platform-and-environment,
        ngm:virtual-workspace ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:bridgesTo ngm:remote-collaboration,
        ngm:telecollaboration ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:relatedTo ngm:immersive-communication ;
    vc:requires ngm:avatar,
        ngm:spatial-audio ;
    vc:slug "virtual-collaboration" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:metaverse .

ngm:volumetric-capture a owl:Class ;
    rdfs:label "Volumetric Capture"@en ;
    rdfs:comment "Volumetric Capture is the process of recording a subject or environment in three dimensions using arrays of cameras, depth sensors, or LiDAR to produce a fully navigable 4D (space + time) representation. The resulting volumetric video or point-cloud sequences can be rendered from any viewpoint, enabling photorealistic holographic telepresence, immersive sports broadcasting, and digital twin creation for spatial computing platforms."@en ;
    rdfs:subClassOf ngm:sc-display-and-rendering ;
    skos:broader ngm:sc-display-and-rendering ;
    vc:enables ngm:3-d-reconstruction,
        ngm:digital-twin ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:relatedTo ngm:real-time-rendering ;
    vc:slug "volumetric-capture" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:depth-sensing,
        ngm:photogrammetry,
        ngm:point-cloud .

ngm:w3-c-did-core a owl:Class ;
    rdfs:label "W3C DID Core"@en ;
    rdfs:comment "W3C DID Core is the World Wide Web Consortium recommendation defining Decentralised Identifiers (DIDs) — a type of globally unique identifier that is controller-owned, cryptographically verifiable, and resolvable without requiring a centralised registration authority. A DID is a URI of the form did:<method>:<method-specific-id> that resolves to a DID Document containing public keys, service endpoints, and authentication verification methods. The specification is method-agnostic, allowing DIDs to be anchored on various infrastructure including distributed ledgers, peer-to-peer networks, and web servers, enabling interoperable self-sovereign identity across systems."@en ;
    rdfs:subClassOf ngm:bc-governance-and-regulation ;
    skos:broader ngm:bc-governance-and-regulation ;
    vc:enables ngm:decentralised-identity,
        ngm:self-sovereign-identity,
        ngm:verifiable-credentials ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:public-key-cryptography ;
    vc:slug "w3-c-did-core" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:cryptographic-signature .

ngm:web-socket-protocol a owl:Class ;
    rdfs:label "WebSocket Protocol"@en ;
    rdfs:comment "The WebSocket Protocol is a standardised full-duplex communication protocol defined in RFC 6455 (2011) that provides a persistent, low-latency bidirectional channel between a client and a server over a single TCP connection. It was designed to overcome the limitations of HTTP polling and long-polling by upgrading an initial HTTP handshake to a persistent framed message channel, enabling servers to push data to clients without client-initiated requests. WebSocket frames have minimal overhead — a 2-byte header for small messages — making it suitable for high-frequency data streams such as financial tickers, collaborative editing, gaming, and real-time AI agent communications. It is supported natively in all major browsers and server-side runtimes, and forms the transport layer for many real-time application protocols including STOMP, MQTT-over-WebSocket, and the OpenAI Realtime API."@en ;
    rdfs:subClassOf ngm:network-protocol ;
    vc:contrastsWith ngm:g-rpc ;
    vc:enables ngm:agent-event-stream,
        ngm:realtime-collaboration ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:event-driven-architecture,
        ngm:realtime-communication,
        ngm:server-sent-events,
        ngm:web-socket ;
    vc:slug "web-socket-protocol" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:asynchronous-communication ;
    vc:uses ngm:networking-infrastructure .

ngm:xr-runtime-environment a owl:Class ;
    rdfs:label "XR Runtime Environment"@en ;
    rdfs:comment "The software infrastructure layer that manages extended reality hardware and provides standardized APIs for XR applications, handling device abstraction, tracking systems, rendering pipelines, input processing, and compositor services to enable cross-platform XR development."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
