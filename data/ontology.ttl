ngm:teleoperated-robot a owl:Class ;
    rdfs:label "Teleoperated Robot"@en ;
    rdfs:comment "A Teleoperated Robot is a robotic system remotely controlled by a human operator via a communication link, combining human-level judgement with robotic precision and reach in environments inaccessible or hazardous to people. Key technical dimensions include haptic feedback, anthropomorphic dexterity, immersive operator interfaces (including VR headsets), latency management, and AI-assisted control to reduce operator cognitive load; applications span surgery, nuclear decommissioning, disaster response, and construction."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:robo-perception ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:human-robot-interaction ],
        ngm:robo-human-robot-interaction ;
    skos:broader ngm:robo-human-robot-interaction ;
    vc:bridgesTo ngm:dc-telepresence ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:robo-safety-and-standards,
        ngm:robotic-telepresence ;
    vc:requires ngm:human-robot-interaction,
        ngm:robo-perception ;
    vc:slug "teleoperated-robot" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:haptic-feedback,
        ngm:immersive-interface .

