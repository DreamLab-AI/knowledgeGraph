    a owl:Restriction ;
    owl:onProperty ngm:isPartOf ;
    owl:someValuesFrom mv:AccessibilityStandard
] .

mv:XRAccessibilityGuideline rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:requires ;
    owl:someValuesFrom mv:UserResearch
] .

mv:XRAccessibilityGuideline rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:requires ;
