        ngm:enforcement-mechanism,
        ngm:principal-agent-problem,
        ngm:stakeholder-theory,
        ngm:transparency-obligation ;
    vc:slug "governance-structure" ;
    vc:sourceDomain "infrastructure" ;
    vc:standardizedBy ngm:companies-act,
        ngm:eu-ai-act,
        ngm:iso-standards,
        ngm:oecd-guidelines ;
