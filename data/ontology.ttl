    vc:slug "carbon-footprint-measurement" ;
    vc:sourceDomain "infrastructure" .

vf:carbon-neutral-blockchain a owl:Class ;
    rdfs:label "Carbon Neutral Blockchain"@en ;
    rdfs:comment "**Carbon Neutral Blockchain** is any distributed ledger infrastructure that achieves net-zero or carbon-negative lifecycle greenhouse gas emissions through one or more of three principal mechanisms: **(1) Consensus mechanism transition**: Adoption of low-energy [[Consensus Mechanisms]] — pre-eminently [[Proof of Stake]] — which eliminate the energy-intensive computational competition of [[Proof of Work]] mining. Proof of Stake (PoS), Liquid Proof of Stake (LPoS), Pure Proof of Stake (PPoS), Nominated Proof of Stake (NPoS), Delegated Proof of Stake (DPoS), and directed acyclic graph (DAG) mechanisms achieve equivalent or superior cryptoeconomic security to [[Proof of Work]] at a fraction of the energy cost, because security derives from economic stake rather than hashrate expenditure. **(2) Renewable energy procurement**: Sourcing electrical power exclusively from [[Renewable Energy]] generation verified through [[Renewable Energy Certificates]] (RECs), Guarantees of Origin (GOs in the EU), or the emerging EnergyTag Granular Certificate (GC) standard enabling hourly-resolution clean energy matching rather than annual averaging."@en ;
    rdfs:subClassOf <urn:visionflow:linked:climate-aligned-finance>,
        <urn:visionflow:linked:distributed-ledger-technology>,
        <urn:visionflow:linked:green-infrastructure>,
        vf:blockchain,
        vf:sustainable-technology ;
    vc:authorityScore "0.87"^^xsd:float ;
    vc:enables <urn:visionflow:linked:climate-disclosure>,
        <urn:visionflow:linked:csrd-compliance>,
        <urn:visionflow:linked:esg-investing>,
        <urn:visionflow:linked:green-finance>,
        <urn:visionflow:linked:on-chain-carbon-markets>,
        <urn:visionflow:linked:science-based-targets>,
        <urn:visionflow:linked:sustainable-supply-chain>,
        <urn:visionflow:linked:tokenized-carbon-credits>,
        <urn:visionflow:linked:voluntary-carbon-market>,
        vf:carbon-credit-tracking ;
    vc:hasPart <urn:visionflow:linked:carbon-credit>,
        <urn:visionflow:linked:carbon-offset-programme>,
        <urn:visionflow:linked:energy-metering-system>,
        <urn:visionflow:linked:ghg-protocol-accounting>,
        <urn:visionflow:linked:renewable-energy-certificate>,
        <urn:visionflow:linked:renewable-energy-integration>,
        <urn:visionflow:linked:sustainability-reporting-framework>,
        vf:carbon-registry,
        vf:proof-of-stake,
        vf:validator-node ;
    vc:implements <urn:visionflow:linked:corporate-sustainability-reporting>,
        <urn:visionflow:linked:environmental-accounting-standard>,
        <urn:visionflow:linked:iso-14064>,
        <urn:visionflow:linked:net-zero-commitment>,
        <urn:visionflow:linked:paris-agreement-alignment>,
        <urn:visionflow:linked:pas-2060-carbon-neutrality>,
