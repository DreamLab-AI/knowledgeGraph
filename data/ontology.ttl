ngm:elliptic-curve-cryptography a owl:Class ;
    rdfs:label "Elliptic Curve Cryptography"@en ;
    rdfs:comment "A public-key cryptographic system based on the algebraic structure of elliptic curves over finite fields, providing strong security guarantees with shorter key lengths than RSA. ECC underpins digital signatures (ECDSA), key agreement (ECDH), and identity operations throughout blockchain infrastructure, TLS, and secure communications."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:ecdsa ],
        ngm:cryptographic-primitive ;
    vc:bridgesTo ngm:distributed-ledger-technology,
        ngm:secure-multi-party-computation ;
    vc:contrastsWith ngm:post-quantum-cryptography,
        ngm:rsa-cryptography ;
    vc:dependsOn ngm:cryptographic-hash-function,
        ngm:private-key,
        ngm:public-key ;
    vc:enables ngm:cryptographic-key-management,
        ngm:digital-signature,
        ngm:key-exchange,
        ngm:zero-knowledge-proof ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:ecdh,
        ngm:ecdsa ;
    vc:implements ngm:curve25519,
        ngm:secp256k1 ;
    vc:isPartOf ngm:public-key-cryptography ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:cryptographic-protocol,
        ngm:cryptographic-security,
        ngm:cryptographic-signature,
        ngm:decentralization ;
    vc:requires ngm:discrete-logarithm-problem,
        ngm:finite-field ;
    vc:slug "elliptic-curve-cryptography" ;
    vc:sourceDomain "security" ;
    vc:standardizedBy ngm:ieee-2418-1,
        ngm:nist ;
    vc:supports ngm:transport-layer-security ;
    vc:uses ngm:modular-arithmetic .

ngm:ontology a owl:Class ;
    rdfs:label "Ontology"@en ;
    rdfs:comment "In computer science and knowledge engineering, an ontology is a formal, machine-readable specification of a shared conceptualisation within a domain: it explicitly defines the classes of entities that exist, the properties and attributes of those entities, the relationships (object properties) that may hold between them, and the logical axioms that constrain valid world states. Ontologies are expressed using languages such as OWL 2 (Web Ontology Language) built atop RDF, enabling automated reasoning engines to infer implicit knowledge and detect logical inconsistencies. They underpin knowledge graphs, linked data systems, semantic interoperability frameworks, and AI knowledge representation across scientific, industrial, and Web domains. Rooted in philosophical ontology (the study of being and categories of existence), the computational form translates that tradition into machine-processable schemas governed by Description Logics with decidable inference."@en ;
    rdfs:subClassOf ngm:knowledge-representation ;
    vc:bridgesTo ngm:digital-twin,
        ngm:retrieval-augmented-generation ;
    vc:contrastsWith ngm:database-schema,
        ngm:taxonomy ;
    vc:enables ngm:automated-reasoning,
        ngm:knowledge-graph,
        ngm:linked-open-data,
        ngm:semantic-interoperability,
        ngm:semantic-search ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:class-hierarchy,
        ngm:data-property,
        ngm:object-property ;
    vc:isPartOf ngm:semantic-web ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:knowledge-representation,
        ngm:linked-data,
        ngm:upper-ontology ;
    vc:requires ngm:axiom,
        ngm:formal-language ;
    vc:slug "ontology" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:description-logics,
        ngm:owl-class-hierarchy,
        ngm:rdf,
        ngm:sparql .

ngm:data-pipeline a owl:Class ;
