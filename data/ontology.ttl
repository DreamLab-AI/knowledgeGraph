ngm:hardware-in-the-loop-testing a owl:Class ;
    rdfs:comment "Hardware-in-the-loop (HIL) testing is a validation technique in which real physical hardware, such as a controller or actuator, is connected to a real-time simulation of the rest of the system. It lets engineers exercise embedded control software against realistic, repeatable plant dynamics without risking expensive or dangerous full-system runs. HIL is standard practice in robotics, automotive, and aerospace development."@en ;
    rdfs:label "Hardware-in-the-Loop Testing"@en ;
    rdfs:subClassOf ngm:control-system ;
    vc:hasMaturity ngmi:maturity-established ;
