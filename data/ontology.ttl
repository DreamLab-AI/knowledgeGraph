ngm:replication a owl:Class ;
    rdfs:label "Replication"@en ;
    rdfs:comment "Replication is the practice of maintaining multiple copies of data or services across different machines or locations to improve availability, durability, fault tolerance, and read performance. Strategies range from synchronous replication, which guarantees copies are identical before acknowledging a write, to asynchronous replication, which favours latency at the risk of temporary divergence. Replication is foundational to distributed databases, content-delivery networks, and high-availability systems, and its design forces explicit choices among consistency, availability, and partition tolerance."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:consensus-protocol ],
        ngm:fault-tolerance ;
    vc:bridgesTo ngm:blockchain-consensus,
        ngm:federated-learning ;
    vc:contrastsWith ngm:eventual-consistency,
        ngm:sharding ;
    vc:dependsOn ngm:leader-election,
        ngm:write-ahead-log ;
    vc:enables ngm:data-availability,
        ngm:disaster-recovery,
        ngm:read-scalability ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:asynchronous-replication,
        ngm:replication-log,
        ngm:synchronous-replication ;
    vc:isPartOf ngm:distributed-systems,
        ngm:high-availability ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:cap-theorem,
        ngm:distributed-storage,
        ngm:paxos,
        ngm:raft-consensus ;
    vc:requires ngm:consensus-protocol,
        ngm:network-partition-tolerance ;
    vc:slug "replication" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:crdt,
        ngm:quorum,
        ngm:version-vector .

ngm:robot-sensor a owl:Class ;
    rdfs:label "Robot Sensor"@en ;
    rdfs:comment "A Robot Sensor is a transducer or measurement device integrated into a robotic system to acquire data about the robot's internal state (proprioception: joint angles, torques, currents) or external environment (exteroception: proximity, force, vision, lidar). Sensor data drives closed-loop control, obstacle avoidance, and higher-level perception pipelines."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:sensor-calibration ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:signal-conditioning ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:analog-to-digital-converter ],
        ngm:robo-perception ;
    skos:broader ngm:robo-perception ;
    vc:bridgesTo ngm:digital-twin,
        ngm:machine-learning ;
    vc:contrastsWith ngm:robot-actuator ;
    vc:dependsOn ngm:embedded-system,
        ngm:robot-operating-system ;
    vc:enables ngm:closed-loop-control,
        ngm:obstacle-avoidance,
        ngm:sensor-fusion,
        ngm:slam ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:analog-to-digital-converter,
        ngm:sensor-transducer ;
    vc:isPartOf ngm:robotic-system,
        ngm:robotics ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:control-system,
        ngm:force-torque-sensor,
        ngm:inertial-measurement-unit,
        ngm:lidar ;
    vc:requires ngm:sensor-calibration,
        ngm:signal-conditioning ;
    vc:slug "robot-sensor" ;
    vc:sourceDomain "robotics" ;
    vc:standardizedBy ngm:iec-61508,
        ngm:iso-8373 ;
    vc:supports ngm:autonomous-navigation,
        ngm:human-robot-interaction ;
    vc:uses ngm:kalman-filter,
        ngm:signal-processing .

ngm:saml a owl:Class ;
    rdfs:label "SAML"@en ;
    rdfs:comment "Security Assertion Markup Language (SAML) is an XML-based open standard developed by OASIS that defines formats and protocols for exchanging authentication and authorisation data between an identity provider (IdP) and a service provider (SP). SAML 2.0, published in 2005, is the dominant version in enterprise deployments and enables web-based single sign-on by allowing the IdP to issue digitally signed XML assertions that service providers trust without requiring the user to re-authenticate. It decouples the identity layer from application services, enabling cross-domain federated identity across organisational and cloud boundaries."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:identity-provider ],
        ngm:federated-identity ;
    vc:bridgesTo ngm:cloud-identity,
        ngm:decentralised-identity ;
    vc:contrastsWith ngm:kerberos,
        ngm:oauth2,
        ngm:openid-connect ;
    vc:enables ngm:cross-domain-authentication,
        ngm:federated-identity,
        ngm:single-sign-on ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:saml-assertion,
        ngm:saml-binding,
        ngm:saml-metadata,
        ngm:saml-protocol ;
    vc:implements ngm:authentication,
        ngm:authorisation,
        ngm:identity-federation ;
    vc:qualityScore "0.76"^^xsd:float ;
    vc:relatedTo ngm:access-management,
        ngm:identity-management,
        ngm:zero-trust ;
    vc:requires ngm:identity-provider,
        ngm:public-key-infrastructure,
        ngm:xml ;
    vc:slug "saml" ;
    vc:sourceDomain "security" ;
    vc:standardizedBy ngm:oasis ;
    vc:uses ngm:http-post-binding,
        ngm:http-redirect-binding,
        ngm:xml-encryption,
        ngm:xml-signature .

ngm:scope-2-emissions a owl:Class ;
    rdfs:label "Scope 2 Emissions"@en ;
    rdfs:comment "Scope 2 Emissions are the indirect greenhouse gas emissions attributable to an organisation arising from the generation of purchased or acquired electricity, steam, heat, or cooling consumed in its operations, as defined by the GHG Protocol Corporate Standard. Although the physical emissions occur at the power plant or thermal facility, they are accounted for by the purchasing organisation because its demand drives that generation, making Scope 2 the primary decarbonisation lever for energy-intensive organisations such as data centres and manufacturers."@en ;
    rdfs:subClassOf ngm:environmental-sustainability ;
    vc:bridgesTo ngm:24-7-carbon-free-energy,
        ngm:ai-sustainability,
        ngm:data-centre-energy-efficiency ;
    vc:contrastsWith ngm:location-based-accounting,
        ngm:market-based-accounting ;
    vc:enables ngm:carbon-aware-computing,
        ngm:carbon-neutrality-planning,
        ngm:carbon-neutrality-verification,
        ngm:decarbonisation-strategy ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:corporate-sustainability-reporting-directive,
        ngm:ghg-emissions-inventory ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:carbon-emission-factor,
        ngm:corporate-carbon-footprint,
        ngm:esg-reporting,
        ngm:ghg-protocol,
        ngm:grid-electricity,
        ngm:scope-1-emissions,
        ngm:scope-3-emissions ;
    vc:slug "scope-2-emissions" ;
    vc:sourceDomain "infrastructure" ;
    vc:standardizedBy ngm:ghg-protocol-corporate-standard,
        ngm:iso-14064 ;
    vc:supports ngm:power-purchase-agreement,
        ngm:renewable-energy,
        ngm:renewable-energy-certificates,
        ngm:sustainability-reporting .

ngm:screen-sharing a owl:Class ;
    rdfs:label "Screen Sharing"@en ;
    rdfs:comment "Screen sharing is the real-time capture and transmission of a computing device's visual display output — encompassing full-desktop, application-window, browser-tab, and mobile-device viewports — to one or more remote participants over a network, enabling synchronous visual communication of interf..."@en ;
