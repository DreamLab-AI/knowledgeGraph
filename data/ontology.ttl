ngm:tokenomics a owl:Class ;
    rdfs:label "Tokenomics"@en ;
    rdfs:comment "Tokenomics is the study and design of the economic systems underpinning blockchain-based tokens, encompassing token supply mechanics (fixed supply, inflationary, or deflationary schedules), distribution models (initial coin offerings, airdrops, liquidity mining), utility functions (governance rights, access control, fee payment), and incentive alignment mechanisms. A well-designed tokenomic model balances value creation and capture across stakeholders — developers, users, liquidity providers, and governance participants — through mechanisms such as staking, burning, bonding curves, and vesting schedules. Tokenomics draws from monetary theory, game theory, and mechanism design to engineer sustainable digital economies where token holders are incentivised to act in ways that grow the ecosystem's long-term value."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:vesting-schedule ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:smart-contract ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:blockchain ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:staking ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:consensus-mechanism ],
        ngm:bc-defi-and-economics ;
    skos:broader ngm:bc-defi-and-economics ;
    vc:bridgesTo ngm:digital-economy,
        ngm:governance-token,
        ngm:incentive-alignment ;
    vc:contrastsWith ngm:centralised-finance,
        ngm:fiat-currency ;
    vc:enables ngm:dao,
        ngm:decentralised-finance,
        ngm:liquidity-pool,
        ngm:payment-system,
        ngm:play-to-earn ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:bonding-curve,
        ngm:staking,
        ngm:token-burn,
        ngm:token-distribution,
        ngm:token-supply,
        ngm:vesting-schedule ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:decentralised-exchange,
        ngm:initial-coin-offering,
        ngm:monetary-policy,
        ngm:nft ;
    vc:requires ngm:blockchain,
        ngm:consensus-mechanism,
        ngm:digital-token,
        ngm:smart-contract ;
    vc:slug "tokenomics" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:game-theory,
        ngm:mechanism-design .

ngm:blockchain-interoperability a owl:Class ;
