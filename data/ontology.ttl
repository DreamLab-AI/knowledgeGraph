ngm:industry-consortium a owl:Class ;
    rdfs:label "Industry Consortium"@en ;
    rdfs:comment "An Industry Consortium is a collaborative alliance of multiple independent organisations within the same sector that pool resources, expertise, and influence to pursue shared objectives such as standards development, research, or market promotion. Consortia typically operate under a formal governance charter and may produce specifications, reference implementations, or advocacy positions. They differ from regulatory bodies in that membership is voluntary and outputs are generally non-binding unless adopted by standards organisations."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:working-group ],
        ngm:governance ;
    vc:bridgesTo ngm:policy ;
    vc:contrastsWith ngm:regulatory-body ;
    vc:dependsOn ngm:governance ;
    vc:enables ngm:collaborative-research,
        ngm:standardisation ;
