    vc:supports ngm:fairness,
        ngm:governance-framework .

ngm:stereo-vision a owl:Class ;
    rdfs:label "Stereo Vision"@en ;
    rdfs:comment "Stereo vision is a computational technique that recovers metric depth information from a scene by analysing the horizontal displacement (disparity) between corresponding points in two or more rectified images captured from laterally separated viewpoints, mimicking the binocular parallax used by human and animal visual systems. The resulting dense disparity maps are converted into 3D point clouds or depth maps for downstream perception tasks."@en ;
    rdfs:subClassOf ngm:computer-vision ;
    vc:bridgesTo ngm:advanced-driver-assistance-systems,
        ngm:spatial-computing ;
    vc:contrastsWith ngm:lidar,
        ngm:monocular-depth-estimation,
        ngm:structured-light ;
    vc:dependsOn ngm:camera-calibration,
        ngm:epipolar-geometry ;
    vc:enables ngm:3-d-scene-reconstruction,
        ngm:depth-estimation,
        ngm:obstacle-detection,
        ngm:point-cloud-generation,
        ngm:visual-odometry ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:cost-volume,
        ngm:semi-global-matching,
        ngm:stereo-matching ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:multi-view-stereo,
        ngm:optical-flow,
        ngm:slam ;
    vc:requires ngm:image-synchronisation,
        ngm:lens-distortion-correction,
        ngm:stereo-camera-rig ;
    vc:slug "stereo-vision" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:augmented-reality,
        ngm:autonomous-driving,
        ngm:robotic-grasping ;
    vc:uses ngm:camera-calibration,
        ngm:convolutional-neural-network,
        ngm:disparity-map,
        ngm:epipolar-geometry,
        ngm:feature-matching,
        ngm:image-rectification .

ngm:store-of-value a owl:Class ;
    rdfs:label "Store of Value"@en ;
    rdfs:comment "A store of value is any asset that retains purchasing power over time, enabling the owner to defer consumption and retrieve real wealth in the future with minimal loss to inflation, confiscation, or degradation. Classical monetary theory identifies store-of-value function alongside medium-of-exchange and unit-of-account as the three primary functions of money, though assets can serve one function without the others."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:asset-liquidity ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:portability ],
        ngm:bc-defi-and-economics ;
    skos:broader ngm:bc-defi-and-economics ;
    vc:bridgesTo ngm:bitcoin-protocol,
        ngm:decentralised-finance,
        ngm:tokenisation-of-assets ;
    vc:contrastsWith ngm:fiat-currency,
        ngm:medium-of-exchange,
        ngm:unit-of-account ;
    vc:dependsOn ngm:market-confidence,
        ngm:property-rights ;
    vc:enables ngm:capital-preservation,
        ngm:intertemporal-exchange,
        ngm:portfolio-hedging ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:durability,
        ngm:portability,
        ngm:scarcity ;
    vc:isPartOf ngm:functions-of-money ;
    vc:qualityScore "0.85"^^xsd:float ;
    vc:relatedTo ngm:currency-debasement,
        ngm:gold-standard,
        ngm:hard-money,
        ngm:inflation-hedge,
        ngm:monetary-function,
        ngm:monetary-policy,
        ngm:purchasing-power ;
    vc:requires ngm:asset-liquidity,
        ngm:scarcity ;
    vc:slug "store-of-value" ;
    vc:sourceDomain "finance" ;
    vc:supports ngm:austrian-hard-money-theory,
        ngm:fixed-supply-monetary-policy ;
    vc:uses ngm:commodity-money,
        ngm:inflation-linked-bonds .

ngm:supply-chain-visibility a owl:Class ;
    rdfs:label "Supply Chain Visibility"@en ;
    rdfs:comment "Supply chain visibility is the capability to track, monitor, and share accurate, real-time information about the location, status, and condition of goods, components, and materials as they move through a supply network from raw material sourcing through production, distribution, and delivery to end customers. It requires integration of data from disparate logistics systems, IoT sensors, carrier APIs, and ERP platforms, and provides the situational awareness needed for proactive disruption management, regulatory compliance, and demand-driven inventory optimisation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-integration ],
        ngm:supply-chain-management ;
    vc:bridgesTo ngm:blockchain,
        ngm:machine-learning ;
    vc:enables ngm:cold-chain-monitoring,
        ngm:compliance-monitoring,
        ngm:demand-forecasting,
        ngm:inventory-optimization,
        ngm:risk-management,
        ngm:supply-chain-provenance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:control-tower,
        ngm:supply-chain,
        ngm:supply-chain-blockchain,
