            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:data-governance ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-security ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-storage ],
        ngm:infra-data-management ;
    skos:broader ngm:infra-data-management ;
    vc:bridgesTo ngm:blockchain,
        ngm:metaverse-technology ;
    vc:contrastsWith ngm:data-hoarding ;
    vc:enables ngm:data-analytics,
        ngm:federated-learning,
        ngm:machine-learning-discipline,
        ngm:regulatory-compliance ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:data-catalogue,
        ngm:data-governance,
        ngm:data-lineage,
        ngm:data-quality,
        ngm:metadata-management ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:data-architecture,
        ngm:distributed-system,
        ngm:etl,
        ngm:information-management ;
    vc:requires ngm:access-control,
        ngm:data-security,
        ngm:data-storage ;
    vc:slug "data-management" ;
    vc:sourceDomain "data" ;
    vc:standardizedBy ngm:dama-dmbok,
        ngm:gdpr ;
    vc:supports ngm:ai-infrastructure,
