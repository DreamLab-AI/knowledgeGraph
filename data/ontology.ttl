        ngm:service-mesh .

ngm:iso-13482 a owl:Class ;
    rdfs:label "ISO 13482"@en ;
    rdfs:comment "ISO 13482 is the international standard specifying safety requirements for personal care robots—autonomous or semi-autonomous robots designed to perform tasks that directly assist humans in daily life, including mobility assistance, physical assistance, and person-carrier applications. Published in 2014, the standard defines risk assessment methodologies, protective measure requirements, and verification procedures tailored to the unique hazards of robots operating in close physical proximity to vulnerable populations such as the elderly and disabled. It complements the industrial robot safety standard ISO 10218 and is increasingly referenced in regulatory frameworks for assistive and service robotics."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:safety-engineering ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:rb-0094-power-and-force-limiting ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:verification ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:safety ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:safety-measure ],
        ngm:functional-safety ;
    vc:bridgesTo ngm:governance,
        ngm:machine-learning ;
    vc:enables ngm:autonomous-system,
        ngm:human-robot-interaction,
        ngm:robot ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:safety,
        ngm:safety-measure,
        ngm:verification ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:assistive-robotics,
        ngm:cobot-safety-levels,
