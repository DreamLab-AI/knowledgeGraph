    vc:slug "knowledge-representation-domain" ;
    vc:sourceDomain "knowledge-representation" .

ngm:legged-locomotion a owl:Class ;
    rdfs:label "Legged Locomotion"@en ;
    rdfs:comment "Legged locomotion is the study and engineering of robot motion through articulated limb contacts with the environment, enabling traversal of unstructured terrain that is inaccessible to wheeled or tracked platforms. It requires coordinated management of contact forces, centre-of-mass dynamics, gait sequencing, and reactive balance control across walking, running, climbing, and stair-negotiation tasks. Modern legged locomotion controllers combine whole-body control, model predictive control (MPC), and reinforcement learning — often trained in simulation and transferred to hardware — to achieve robust performance on irregular natural and urban terrain."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:motion-control ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:robot-dynamics ],
        ngm:robo-navigation-and-planning ;
    skos:broader ngm:robo-navigation-and-planning ;
    vc:enables ngm:motion-planning ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:quadruped-robot,
        ngm:reinforcement-learning,
        ngm:sim-to-real-transfer ;
    vc:requires ngm:motion-control,
        ngm:robot-dynamics ;
    vc:slug "legged-locomotion" ;
    vc:sourceDomain "robotics" .

ngm:liquid-proof-of-stake a owl:Class ;
    rdfs:label "Liquid Proof of Stake"@en ;
    rdfs:comment "A Proof of Stake consensus variant that decouples staking participation from token illiquidity by allowing holders to delegate validation rights to elected validators (bakers) while retaining full ownership and transferability of their tokens. Pioneered by Tezos, it combines on-chain governance with delegated staking, enabling small token holders to participate in consensus rewards without running validator infrastructure."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:validator-node ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:epoch ],
        ngm:bc-protocol-and-consensus,
        ngm:proof-of-stake ;
    skos:broader ngm:bc-protocol-and-consensus ;
    vc:contrastsWith ngm:proof-of-work ;
    vc:dependsOn ngm:blockchain-governance,
        ngm:consensus-mechanism ;
    vc:enables ngm:decentralized-autonomous-organization,
        ngm:tokenomics-governance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:governance-token,
        ngm:proof-of-stake-sustainability ;
    vc:requires ngm:epoch,
        ngm:validator-node ;
    vc:slug "liquid-proof-of-stake" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:token-economics,
        ngm:validator-set .

ngm:metaverse-and-telecollaboration a owl:Class ;
    rdfs:label "Metaverse and Telecollaboration"@en ;
    rdfs:comment "The convergence of persistent, shared virtual environments with real-time remote collaboration technologies, enabling geographically distributed participants to interact through embodied avatars, spatial audio, and shared 3D workspaces. Metaverse telecollaboration combines immersive XR hardware, low-latency networking, avatar systems, and spatial computing to replicate the social and spatial cues of co-presence across distances."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:latency ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:avatar-system ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:digital-infrastructure ],
        ngm:metaverse,
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:immersive-communication,
        ngm:spatial-audio ;
    vc:requires ngm:avatar-system,
        ngm:digital-infrastructure,
