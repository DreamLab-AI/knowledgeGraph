    vc:slug "aiops" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:microservices-architecture,
        ngm:monitoring-dashboard ;
    vc:uses ngm:deep-learning,
        ngm:event-driven-architecture,
        ngm:predictive-analytics .

ngm:albert a owl:Class ;
    rdfs:label "ALBERT"@en ;
    rdfs:comment "A Lite BERT: a parameter-efficient transformer variant that uses factorised embedding parameterisation and cross-layer parameter sharing to achieve 18x fewer parameters than BERT-large whilst matching or exceeding its performance on NLP benchmarks such as GLUE, SQuAD, and RACE."@en ;
    rdfs:subClassOf ngm:ai-model-architecture ;
    skos:broader ngm:ai-model-architecture ;
    vc:contrastsWith ngm:ro-berta ;
    vc:enables ngm:fine-tuning,
        ngm:transfer-learning ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:relatedTo ngm:large-language-models,
        ngm:lo-ra-do-ra-etc ;
    vc:slug "albert" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:natural-language-processing,
        ngm:transformer-architecture .

ngm:algorithmic-governance a owl:Class ;
    rdfs:label "Algorithmic Governance"@en ;
    rdfs:comment "Algorithmic Governance is the use of automated decision systems, models, and rule engines to make or enforce governance choices that were traditionally human and discretionary, such as moderation, resource allocation, or compliance enforcement. It can increase consistency, speed, and scale, but raises concerns about transparency, accountability, bias, and contestability of automated decisions. The concept spans platform moderation, public-sector automation, and on-chain rule enforcement."@en ;
    rdfs:subClassOf ngm:governance ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:decentralised-coordination,
        ngm:digital-society-surveillance ;
    vc:slug "algorithmic-governance" ;
    vc:sourceDomain "governance" .

ngm:animation-state-machine a owl:Class ;
    rdfs:label "Animation State Machine"@en ;
    rdfs:comment "An animation state machine is a graph of discrete animation states and the transitions between them, used in real-time engines to drive a character or object's motion based on game logic, input and parameters. Each state references a clip or blend tree, and transitions carry conditions, blend durations and interruption rules that govern how one motion flows into another. It separates high-level behaviour authoring from low-level pose evaluation, making locomotion and action systems tractable to build and tune."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:skeletal-animation ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:blend-tree ],
        ngm:state-machine ;
    vc:bridgesTo ngm:unreal-engine ;
    vc:contrastsWith ngm:blend-tree ;
    vc:dependsOn ngm:game-engine ;
    vc:enables ngm:character-animation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:blend-tree ;
    vc:implements ngm:finite-state-machine ;
    vc:isPartOf ngm:character-animation ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:finite-state-machine,
        ngm:skeletal-animation ;
    vc:requires ngm:skeletal-animation ;
    vc:slug "animation-state-machine" ;
    vc:sourceDomain "spatial-computing" ;
    vc:standardizedBy ngm:game-engine ;
    vc:supports ngm:game-engine ;
    vc:uses ngm:blend-tree .

ngm:anon-creds a owl:Class ;
    rdfs:label "AnonCreds"@en ;
    rdfs:comment "AnonCreds (Anonymous Credentials) is a verifiable credential format and specification originally developed by the Hyperledger Indy project that enables privacy-preserving identity verification. The scheme allows holders to prove possession of credentials without revealing the credential itself or the issuer's signature, using zero-knowledge proofs. AnonCreds supports selective disclosure, letting a holder share only specific attributes, and predicates that prove a claim (e.g. age over 18) without revealing the underlying value. The specification has been standardised via the AnonCreds Working Group under the Decentralized Identity Foundation."@en ;
    rdfs:subClassOf ngm:credential-format-standard ;
    vc:enables ngm:differential-privacy,
        ngm:privacy-preserving-technology ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:credential-schema,
        ngm:decentralised-identity,
        ngm:digital-identity-wallet ;
    vc:slug "anon-creds" ;
    vc:sourceDomain "security" ;
    vc:supports ngm:authentication ;
    vc:uses ngm:selective-disclosure,
        ngm:zero-knowledge-proof .

ngm:api-contract a owl:Class ;
    rdfs:label "Api Contract"@en ;
    rdfs:comment "An API contract is the agreed, machine-readable specification of how a service may be called and what it will return, covering endpoints, request and response schemas, data types, status codes and error semantics. It functions as a formal agreement between the provider and consumers of an interface, allowing each side to develop and test independently against a shared definition. Expressed in formats such as OpenAPI or GraphQL schemas, the contract enables tooling for validation, mocking, code generation and compatibility checking across versions."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-schema ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:schema ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:api-versioning ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:schema ],
        ngm:data-schema ;
    vc:enables ngm:backward-compatibility,
        ngm:data-validation,
        ngm:interoperability ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:api-versioning,
        ngm:schema ;
    vc:implements ngm:openapi,
        ngm:rest-api ;
    vc:isPartOf ngm:api-design ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:api,
        ngm:graphql ;
    vc:requires ngm:data-schema,
        ngm:schema ;
    vc:slug "api-contract" ;
    vc:sourceDomain "data" ;
    vc:standardizedBy ngm:openapi ;
    vc:supports ngm:api-gateway,
        ngm:microservices ;
    vc:uses ngm:semantic-versioning .

ngm:ar-registration a owl:Class ;
    rdfs:label "AR Registration"@en ;
    rdfs:comment "AR Registration is the spatial alignment process that anchors virtual content to real-world coordinates through Computer Vision, Sensor Input, and tracking algorithms."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:camera-calibration ],
