ngm:en-301-549 a owl:Class ;
    rdfs:label "EN 301 549"@en ;
    rdfs:comment "EN 301 549 is the European standard specifying accessibility requirements for information and communication technology products and services, including web, software, hardware, and documents. It harmonises with the Web Content Accessibility Guidelines and is referenced by EU legislation such as the Web Accessibility Directive and the European Accessibility Act. Conformance is a legal procurement requirement for public-sector ICT in the EU."@en ;
    rdfs:subClassOf ngm:technical-standard ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:accessibility ;
    vc:slug "en-301-549" ;
    vc:sourceDomain "infrastructure" .

ngm:engagement-optimisation a owl:Class ;
    rdfs:label "Engagement Optimisation"@en ;
    rdfs:comment "Engagement optimisation is the use of machine-learning models and feedback loops to maximise a user's interaction with a system, measured by signals such as session length, return frequency, and response rate. It typically learns from behavioural data to personalise content, timing, and prompts. While it can improve usefulness, it raises ethical concerns when optimisation targets attention or dependency rather than user benefit."@en ;
    rdfs:subClassOf ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:ai-companions,
        ngm:feedback-loop ;
    vc:slug "engagement-optimisation" ;
    vc:sourceDomain "ai" .

ngm:enterprise-ai-adoption a owl:Class ;
    rdfs:label "Enterprise AI Adoption"@en ;
    rdfs:comment "Enterprise AI adoption is the organisational process of integrating artificial-intelligence capabilities into business operations, products, and decision-making at scale. It spans strategy, data readiness, platform selection, governance, change management, and measurement of return on investment. Successful adoption depends as much on workflow redesign, skills, and executive sponsorship as on the underlying models."@en ;
    rdfs:subClassOf ngm:ai-application ;
    skos:broader ngm:ai-application ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:ai-companies,
        ngm:machine-learning-platform ;
    vc:slug "enterprise-ai-adoption" ;
    vc:sourceDomain "ai" .

ngm:enterprise-automation a owl:Class ;
    rdfs:label "Enterprise Automation"@en ;
    rdfs:comment "Enterprise automation is the application of software and AI to execute repeatable business processes with minimal human intervention across an organisation. It combines techniques such as robotic process automation, workflow orchestration, business rules engines, and increasingly AI agents that handle unstructured tasks. The goal is to reduce cost, error rates, and cycle time while freeing human workers for higher-value activity."@en ;
    rdfs:subClassOf ngm:ai-application ;
    skos:broader ngm:ai-application ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:ai-companies,
        ngm:robotic-process-automation ;
    vc:slug "enterprise-automation" ;
    vc:sourceDomain "ai" .

ngm:enterprise-ethereum-alliance-specification a owl:Class ;
    rdfs:label "Enterprise Ethereum Alliance Specification"@en ;
    rdfs:comment "The Enterprise Ethereum Alliance (EEA) Specification is a set of open standards defining how Ethereum technology can be implemented for enterprise use, covering permissioning, privacy, performance, and interoperability requirements. It provides a common reference so that permissioned and private Ethereum-based platforms remain compatible with the public Ethereum ecosystem. Conforming implementations gain a portable, vendor-neutral baseline for business deployments."@en ;
    rdfs:subClassOf ngm:technical-standard ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:blockchain,
        ngm:quorum-blockchain ;
    vc:slug "enterprise-ethereum-alliance-specification" ;
    vc:sourceDomain "blockchain" .

ngm:enterprise-risk-management a owl:Class ;
    rdfs:label "Enterprise Risk Management"@en ;
    rdfs:comment "Enterprise Risk Management (ERM) is a structured, organisation-wide approach to identifying, assessing, prioritising, and mitigating risks that could affect an entity's objectives. It integrates financial, operational, strategic, compliance, and reputational risk into a single governance framework with defined ownership and reporting. Established frameworks such as COSO ERM and ISO 31000 provide the reference models."@en ;
    rdfs:subClassOf ngm:governance-framework ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:compliance-control,
        ngm:risk-assessment-methodology ;
    vc:slug "enterprise-risk-management" ;
    vc:sourceDomain "governance" .

ngm:enterprise-software-platform a owl:Class ;
    rdfs:label "Enterprise Software Platform"@en ;
    rdfs:comment "An enterprise software platform is an integrated software environment that provides shared services, data, and tooling on which an organisation's business applications are built and run. Examples include ERP, CRM, and blockchain-as-a-service platforms that offer multi-tenant infrastructure, security, integration, and extensibility. The platform model lets enterprises consolidate capabilities and accelerate delivery of line-of-business applications."@en ;
    rdfs:subClassOf ngm:infra-software-engineering ;
    skos:broader ngm:infra-software-engineering ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:blockchain-as-a-service,
        ngm:crm ;
    vc:slug "enterprise-software-platform" ;
    vc:sourceDomain "infrastructure" .

ngm:environment a owl:Class ;
    rdfs:label "Environment"@en ;
    rdfs:comment "Environment is the external context in which an agent or system operates, providing inputs and responding to actions, a central concept in robotics and reinforcement learning."@en ;
    rdfs:subClassOf ngm:owl-thing ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:slug "environment" ;
    vc:sourceDomain "robotics" .

ngm:environment-mapping a owl:Class ;
    rdfs:label "Environment Mapping"@en ;
    rdfs:comment "Environment mapping is the robotics and computer-vision process of building a spatial representation of a robot's surroundings from sensor data such as lidar, cameras, or depth sensors. Representations include occupancy grids, point clouds, and topological or semantic maps that record obstacles, free space, and landmarks. Accurate mapping is a prerequisite for localisation, path planning, and safe autonomous navigation."@en ;
    rdfs:subClassOf ngm:robo-navigation-and-planning ;
    skos:broader ngm:robo-navigation-and-planning ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:mobile-robot-platform,
        ngm:occupancy-grid ;
    vc:slug "environment-mapping" ;
    vc:sourceDomain "robotics" .

ngm:environmental-k-p-i a owl:Class ;
    rdfs:label "Environmental K P I"@en ;
    rdfs:comment "Quantitative metrics used to measure, monitor, and report the environmental impact of digital platforms, metaverse infrastructure, and spatial computing systems. Environmental KPIs encompass energy consumption per user session, carbon emissions per compute hour, water usage effectiveness, and percentage of renewable energy sourced, providing governance bodies with evidence for sustainability compliance."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-governance ],
        ngm:sc-governance-and-safety ;
    skos:broader ngm:sc-governance-and-safety ;
    vc:enables ngm:environmental-certificate ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:blockchain-sustainability,
        ngm:carbon-credit-token ;
    vc:requires ngm:data-governance ;
    vc:slug "environmental-k-p-i" ;
    vc:sourceDomain "spatial-computing" ;
    vc:standardizedBy ngm:interoperability-framework .

ngm:environmental-trading a owl:Class ;
    rdfs:label "Environmental Trading"@en ;
    rdfs:comment "Environmental Trading encompasses market-based mechanisms for buying and selling environmental assets such as carbon credits, renewable energy certificates, and biodiversity offsets. These mechanisms use blockchain-backed registries and smart contracts to provide transparent, auditable records of environmental value transfers, enabling organisations to meet sustainability obligations through market participation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:carbon-credit-token ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:environmental-registry ],
        ngm:sc-governance-and-safety ;
    skos:broader ngm:sc-governance-and-safety ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:carbon-credit-token,
        ngm:environmental-registry ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:relatedTo ngm:digital-economy ;
    vc:slug "environmental-trading" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:environmental-sustainability,
        ngm:sustainability ;
    vc:uses ngm:blockchain,
        ngm:carbon-credits,
        ngm:smart-contract .

ngm:equitable-access a owl:Class ;
    rdfs:label "Equitable Access"@en ;
    rdfs:comment "Equitable access is the principle and practice of ensuring that all people, regardless of ability, income, geography, or background, can reach and use a resource, service, or technology on fair terms. It goes beyond equal access by actively removing barriers and providing accommodations so that disadvantaged groups achieve comparable outcomes. In technology it is closely tied to accessibility standards and inclusive design."@en ;
    rdfs:subClassOf ngm:governance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:accessibility,
        ngm:accessibility-standard ;
    vc:slug "equitable-access" ;
    vc:sourceDomain "governance" .

ngm:erc-1400 a owl:Class ;
    rdfs:label "ERC-1400"@en ;
    rdfs:comment "An Ethereum standard defining an interface for security tokens, adding partitions, transfer restrictions and document handling on top of the fungible token model. It is intended to represent regulated financial instruments on Ethereum."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ethereum ],
        ngm:technical-standard ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:ethereum ;
    vc:slug "erc-1400" ;
    vc:sourceDomain "standards" .

ngm:erc-2612-permit a owl:Class ;
    rdfs:label "ERC-2612 Permit"@en ;
    rdfs:comment "ERC-2612 adds a permit function to ERC-20 tokens, allowing approvals to be granted through signed messages rather than separate on-chain transactions."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ethereum ],
        ngm:technical-standard ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:ethereum ;
    vc:slug "erc-2612-permit" ;
    vc:sourceDomain "standards" .

ngm:erc-3643 a owl:Class ;
    rdfs:label "ERC-3643"@en ;
    rdfs:comment "ERC-3643 is an Ethereum token standard for permissioned tokens that embeds identity and compliance checks for the transfer of regulated assets."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ethereum ],
        ngm:technical-standard ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:ethereum ;
    vc:slug "erc-3643" ;
    vc:sourceDomain "standards" .

ngm:erc-7683 a owl:Class ;
    rdfs:label "ERC-7683"@en ;
    rdfs:comment "ERC-7683 is an Ethereum standard proposing a common interface for cross-chain intents and order execution between networks."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ethereum ],
        ngm:technical-standard ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:ethereum ;
    vc:slug "erc-7683" ;
    vc:sourceDomain "standards" .

ngm:erc721-standard a owl:Class ;
    rdfs:label "ERC721 Standard"@en ;
    rdfs:comment "Technical standard for non-fungible tokens on ereum, defining unique token identification and ownership tracking."@en ;
    rdfs:subClassOf ngm:bc-token-and-asset ;
    skos:broader ngm:bc-token-and-asset ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:blockchain ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:slug "erc721-standard" ;
    vc:sourceDomain "blockchain" .

ngm:esg-compliant-blockchain a owl:Class ;
    rdfs:label "ESG-Compliant Blockchain"@en ;
    rdfs:comment "An ESG-compliant blockchain is a distributed-ledger network designed and operated to meet environmental, social, and governance criteria, most notably by minimising energy use through low-power consensus and by offsetting or sourcing renewable energy. It typically pairs proof-of-stake or other efficient consensus with transparent emissions reporting and inclusive governance. Such networks aim to make blockchain adoption defensible under corporate sustainability and disclosure requirements."@en ;
    rdfs:subClassOf ngm:blockchain ;
    skos:broader ngm:blockchain ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:crypto-climate-accord,
        ngm:sustainable-consensus ;
    vc:slug "esg-compliant-blockchain" ;
    vc:sourceDomain "blockchain" .

ngm:esma a owl:Class ;
    rdfs:label "ESMA"@en ;
    rdfs:comment "The European Securities and Markets Authority (ESMA) is the European Union's independent financial regulator responsible for safeguarding the stability and integrity of EU securities markets. It develops technical standards, supervises certain market participants such as credit-rating agencies, and coordinates national regulators to ensure consistent application of EU financial law. ESMA plays a central role in regimes such as MiCA for crypto-assets and in securities and regulatory-reporting rules."@en ;
    rdfs:subClassOf ngm:standards-body ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:regulatory-reporting,
        ngm:securities-regulation ;
    vc:slug "esma" ;
    vc:sourceDomain "governance" .

ngm:ethereum-attestation-service a owl:Class ;
    rdfs:label "Ethereum Attestation Service"@en ;
    rdfs:comment "The Ethereum Attestation Service (EAS) is an open, public infrastructure for making on-chain and off-chain attestations about any subject using registered, reusable schemas. Each attestation is a signed, timestamped claim that can be verified, revoked, and composed by other applications. EAS provides a neutral primitive for building reputation systems, identity credentials, and trust layers without a centralised issuer."@en ;
    rdfs:subClassOf ngm:bc-network-component ;
    skos:broader ngm:bc-network-component ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:digital-identity,
        ngm:reputation-system ;
    vc:slug "ethereum-attestation-service" ;
    vc:sourceDomain "blockchain" .

ngm:ethereum-foundation a owl:Class ;
    rdfs:label "Ethereum Foundation"@en ;
    rdfs:comment "The Ethereum Foundation is a non-profit organisation, registered in Switzerland, that supports the development of the Ethereum protocol and its surrounding research and developer community. It funds core protocol research, client development, security audits and educational initiatives, but does not control the network, which is maintained by a decentralised set of clients, validators and contributors. The Foundation was established around the 2014 to 2015 launch of Ethereum."@en ;
    rdfs:subClassOf ngm:owl-thing ;
    vc:enables ngm:ethereum,
        ngm:proof-of-stake ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:slug "ethereum-foundation" ;
    vc:sourceDomain "ethereum-foundation" .

ngm:etsi-domain-ai-creative-media a owl:Class ;
    rdfs:label "ETSI Domain AI + Creative Media"@en ;
    rdfs:comment "Cross-domain marker for metaverse components that combine artificial intelligence capabilities with creative media applications such as generative content, procedural generation, and AI-assisted authoring."@en ;
    rdfs:subClassOf ngm:ai-research-area ;
    skos:broader ngm:ai-research-area ;
    vc:enables ngm:ai-art-categorization,
        ngm:generative-content-classification ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:etsi-domain-taxonomy ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:slug "etsi-domain-ai-creative-media" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:etsi-domain-ai-governance a owl:Class ;
    rdfs:label "ETSI Domain AI + Governance"@en ;
    rdfs:comment "Cross-domain marker for metaverse components combining artificial intelligence with governance frameworks including AI ics, explainability, bias detection, regulatory compliance, and responsible AI systems."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:artificial-intelligence ],
        ngm:ai-governance-and-ethics ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:enables ngm:ai-ethics-classification,
        ngm:explainability-categorization ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:artificial-intelligence ;
    vc:isPartOf ngm:etsi-domain-taxonomy ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:slug "etsi-domain-ai-governance" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:etsi-domain-ai-human-interface a owl:Class ;
    rdfs:label "ETSI Domain AI + Human Interface"@en ;
    rdfs:comment "Cross-domain marker for metaverse components combining artificial intelligence with human interaction systems including conversational AI, gesture recognition, emotion detection, and intelligent user experience adaptation."@en ;
    rdfs:subClassOf ngm:ai-research-area ;
    skos:broader ngm:ai-research-area ;
    vc:enables ngm:conversational-ai-classification,
        ngm:intelligent-ux-categorization ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:etsi-domain-taxonomy ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:slug "etsi-domain-ai-human-interface" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:etsi-domain-creative-media a owl:Class ;
    rdfs:label "ETSI Domain: Creative Media"@en ;
    rdfs:comment "Domain marker for ETSI metaverse categorisation covering creative content production, 3D modelling, rendering, and multimedia authoring for virtual environments."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:rendering-pipeline ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:3-d-content-creation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:content-pipeline ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:asset-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:creative-tools ],
        ngm:etsi-metaverse-domain-taxonomy,
        ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:enables ngm:avatar-customization,
        ngm:scene-design,
        ngm:virtual-world-building ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:3-d-content-creation,
        ngm:asset-management,
        ngm:multimedia-authoring,
        ngm:rendering-pipeline ;
    vc:isPartOf ngm:etsi-metaverse-domain-taxonomy ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:content-pipeline,
        ngm:creative-tools ;
    vc:slug "etsi-domain-creative-media" ;
    vc:sourceDomain "spatial-computing" .

ngm:etsi-domain-data-management a owl:Class ;
    rdfs:label "ETSI Domain: Data Management"@en ;
    rdfs:comment "Domain marker for ETSI metaverse categorisation covering data storage, processing, synchronisation, and lifecycle management for distributed virtual environments."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:data-processing ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:database-system ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:data-storage ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:data-synchronization ],
        ngm:infra-data-management ;
    skos:broader ngm:infra-data-management ;
    vc:enables ngm:cross-platform-synchronization,
        ngm:data-analytics,
        ngm:state-persistence ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:data-lifecycle,
        ngm:data-processing,
        ngm:data-storage,
        ngm:data-synchronization ;
    vc:isPartOf ngm:etsi-metaverse-domain-taxonomy ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:caching-infrastructure,
        ngm:database-system,
        ngm:replication-mechanisms ;
    vc:slug "etsi-domain-data-management" ;
    vc:sourceDomain "infrastructure" .

ngm:etsi-domain-data-management-ethics a owl:Class ;
    rdfs:label "ETSI Domain: Data Management + Ethics"@en ;
    rdfs:comment "Crossover domain for ETSI metaverse categorisation addressing ical data handling, privacy-preserving storage, consent management, and responsible data governance."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:audit-logging ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ethics-and-law ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:privacy-controls ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:consent-management ],
        ngm:ai-governance-and-ethics ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:enables ngm:compliance-verification,
        ngm:privacy-preserving-analytics,
        ngm:user-control ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:anonymization,
        ngm:audit-logging,
        ngm:consent-management,
        ngm:privacy-controls ;
    vc:isPartOf ngm:etsi-metaverse-domain-taxonomy ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:data-management,
        ngm:ethics-and-law ;
    vc:slug "etsi-domain-data-management-ethics" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:etsi-domain-data-management-security a owl:Class ;
    rdfs:label "ETSI Domain: Data Management + Security"@en ;
    rdfs:comment "Crossover domain for ETSI metaverse categorisation addressing secure data storage, encrypted databases, access control systems, and data protection mechanisms."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:key-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:encrypted-storage ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:security-audit ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:access-control ],
        ngm:etsi-metaverse-domain-taxonomy,
        ngm:infra-security-and-identity ;
    skos:broader ngm:infra-security-and-identity ;
    vc:enables ngm:access-control-enforcement,
        ngm:data-at-rest-protection,
        ngm:threat-detection ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:access-control,
        ngm:encrypted-storage,
        ngm:key-management,
        ngm:security-audit ;
    vc:isPartOf ngm:etsi-metaverse-domain-taxonomy ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:requires ngm:data-management,
        ngm:security-and-privacy ;
    vc:slug "etsi-domain-data-management-security" ;
    vc:sourceDomain "infrastructure" .

ngm:etsi-mec a owl:Class ;
    rdfs:label "ETSI MEC"@en ;
    rdfs:comment "ETSI MEC (Multi-access Edge Computing) is a set of standards from the European Telecommunications Standards Institute defining an open framework for running applications at the edge of mobile and fixed networks, close to end users. It specifies APIs and a reference architecture so applications can access low-latency compute, radio-network information, and location services hosted at base stations or aggregation points. MEC is foundational to latency-sensitive use cases such as AR, autonomous systems, and IoT."@en ;
    rdfs:subClassOf ngm:technical-standard ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:edge-computing,
        ngm:hardware-and-edge ;
    vc:slug "etsi-mec" ;
    vc:sourceDomain "infrastructure" .

ngm:etsidomain-classification a owl:Class ;
    rdfs:label "ETSIDomainClassification"@en ;
    rdfs:comment "ETSIDomainClassification is a formal taxonomy from the European Telecommunications Standards Institute categorising technology domains, standards, and governance areas to enable systematic organisation and cross-domain coordination. It partitions the metaverse and digital ecosystem into Infrastructure, Interaction, Trust and Governance, and Computation and Intelligence domains, enabling standards alignment, regulatory mapping, and interoperability discovery across heterogeneous technical contexts."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:etsi-domain-infrastructure ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:etsi-domain-security-and-privacy ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:etsi-domain-identity-and-trust ],
        ngm:ai-research-area ;
    skos:broader ngm:ai-research-area ;
    vc:enables ngm:etsi-metaverse-domain-taxonomy,
        ngm:metaverse-ontology ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:etsi-domain-identity-and-trust,
        ngm:etsi-domain-infrastructure,
        ngm:etsi-domain-security-and-privacy ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:etsi-metaverse-domain-model,
        ngm:metaverse-domain ;
    vc:slug "etsidomain-classification" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:eu-green-deal a owl:Class ;
    rdfs:label "EU Green Deal"@en ;
    rdfs:comment "The EU Green Deal is the European Union's overarching policy package aimed at making Europe climate-neutral by 2050. It sets binding emissions-reduction targets and coordinates legislation across energy, industry, transport, agriculture, and finance, including circular-economy and sustainable-finance measures. As a governance framework it shapes regulation, funding, and reporting obligations that ripple through technology and supply-chain sectors."@en ;
    rdfs:subClassOf ngm:governance-framework ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:circular-economy,
        ngm:sustainability ;
    vc:slug "eu-green-deal" ;
    vc:sourceDomain "governance" .

ngm:eu-taxonomy a owl:Class ;
    rdfs:label "EU Taxonomy"@en ;
    rdfs:comment "The EU Taxonomy is a classification system that defines which economic activities count as environmentally sustainable under European Union law. It sets technical screening criteria across climate and environmental objectives so that investors, companies, and regulators apply a common definition of green activity. The taxonomy underpins sustainable-finance disclosure and ESG reporting by preventing greenwashing through standardised criteria."@en ;
    rdfs:subClassOf ngm:technical-standard ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:esg-reporting,
        ngm:sustainable-finance ;
    vc:slug "eu-taxonomy" ;
    vc:sourceDomain "governance" .

ngm:eu-union-customs-code a owl:Class ;
    rdfs:label "EU Union Customs Code"@en ;
    rdfs:comment "The EU Union Customs Code (UCC) is the legal framework governing customs rules and procedures for goods entering, leaving, or moving within the European Union. It standardises declarations, tariff classification, valuation, origin rules, and the move toward fully electronic, paperless customs processing. The UCC is the reference regime for customs and trade-facilitation systems operating across the EU single market."@en ;
    rdfs:subClassOf ngm:technical-standard ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:customs-trade-facilitation,
        ngm:regulatory-compliance ;
    vc:slug "eu-union-customs-code" ;
    vc:sourceDomain "supply-chain" .

ngm:european-parliament a owl:Class ;
    rdfs:label "European Parliament"@en ;
    rdfs:comment "The European Parliament is the directly elected legislative body of the European Union, sharing law-making and budgetary authority with the Council of the EU. It debates, amends, and adopts EU legislation across domains including financial regulation, data protection, AI, and digital-currency policy. As a co-legislator it is a primary source of the binding rules that shape technology governance across member states."@en ;
    rdfs:subClassOf ngm:standards-body ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:compliance-control,
        ngm:digital-euro ;
    vc:slug "european-parliament" ;
    vc:sourceDomain "governance" .

ngm:exchange-traded-fund a owl:Class ;
    rdfs:label "Exchange-Traded Fund"@en ;
    rdfs:comment "An exchange-traded fund (ETF) is a pooled investment vehicle whose shares trade on a stock exchange throughout the day at market prices. It typically tracks an index, asset, or basket of assets and uses a create-redeem mechanism with authorised participants to keep its price close to net asset value. ETFs combine the diversification of funds with the intraday liquidity and accessibility of listed securities."@en ;
    rdfs:subClassOf ngm:digital-asset ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:bitcoin-etf,
        ngm:spot-bitcoin-etf ;
    vc:slug "exchange-traded-fund" ;
    vc:sourceDomain "blockchain" .

ngm:exoskeleton-control a owl:Class ;
    rdfs:label "Exoskeleton Control"@en ;
    rdfs:comment "Exoskeleton control is the set of control strategies that coordinate a wearable robotic exoskeleton's actuators with the intent and movement of its human wearer. It fuses proprioceptive and biomechanical sensing with kinematic and dynamic models to provide assistive torque while preserving stability and safety. Effective control must adapt to gait phase, user effort, and varying loads in real time to augment strength or restore mobility."@en ;
    rdfs:subClassOf ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:kinematics-model,
        ngm:proprioceptive-sensor ;
    vc:slug "exoskeleton-control" ;
    vc:sourceDomain "robotics" .

ngm:expectation-maximisation a owl:Class ;
    rdfs:label "Expectation Maximisation"@en ;
    rdfs:comment "Expectation Maximisation (EM) is an iterative algorithm for finding maximum-likelihood or maximum-a-posteriori estimates of parameters in statistical models with latent (unobserved) variables. It alternates between an E-step, which computes the expected value of the complete-data log-likelihood given current parameters, and an M-step, which maximises that expectation to update the parameters. EM is guaranteed to monotonically increase the likelihood at each iteration and is widely used for Gaussian mixture models, hidden Markov models, and missing-data problems."@en ;
    rdfs:subClassOf ngm:machine-learning-technique ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:bayes-filter,
        ngm:optimisation,
        ngm:probabilistic-model ;
    vc:slug "expectation-maximisation" ;
    vc:sourceDomain "ai" .

ngm:extreme-programming a owl:Class ;
    rdfs:label "Extreme Programming"@en ;
    rdfs:comment "Extreme Programming (XP) is an agile software-development methodology that emphasises short iterations, continuous feedback, and engineering discipline to deliver high-quality software responsive to changing requirements. Its core practices include test-driven development, pair programming, continuous integration, collective code ownership, and frequent small releases. XP treats good practices to an 'extreme' degree, for example applying continuous code review through constant pairing."@en ;
    rdfs:subClassOf ngm:software-development ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:remote-pair-programming,
        ngm:software-development ;
    vc:slug "extreme-programming" ;
    vc:sourceDomain "infrastructure" .

ngm:fair-adjudication a owl:Class ;
    rdfs:label "Fair Adjudication"@en ;
    rdfs:comment "Fair adjudication is the principle and process by which disputes are decided impartially, with due process, transparent rules, and the absence of bias toward any party. In legal and decentralised-arbitration contexts it requires neutral decision-makers, equal opportunity to present evidence, and reasoned, consistent rulings. It is a foundational requirement for legitimate dispute-resolution and arbitration mechanisms, including those implemented on-chain."@en ;
    rdfs:subClassOf ngm:governance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:dispute-resolution-mechanism,
        ngm:e-contract-arbitration ;
    vc:slug "fair-adjudication" ;
    vc:sourceDomain "governance" .

ngm:fair-data-principles a owl:Class ;
    rdfs:label "FAIR Data Principles"@en ;
    rdfs:comment "The FAIR Data Principles are a set of guidelines stating that scientific and research data should be Findable, Accessible, Interoperable, and Reusable by both humans and machines. They emphasise persistent identifiers, rich machine-readable metadata, standardised vocabularies, and clear usage licences to maximise the long-term value of data. FAIR is widely adopted in research-data management, open science, and knowledge-graph and ontology engineering."@en ;
    rdfs:subClassOf ngm:data-management ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:domain-ontology,
        ngm:metadata-schema ;
    vc:slug "fair-data-principles" ;
    vc:sourceDomain "data" .

ngm:fashion a owl:Class ;
    rdfs:label "Fashion"@en ;
    rdfs:comment "Fashion, as an AI-application domain, encompasses the convergence of machine learning, computer vision, generative models, and blockchain supply-chain infrastructure with the global apparel, luxury, and textile industries, valued at approximately 1.7 and forecast to reach 2.1 by 2030 ."@en ;
