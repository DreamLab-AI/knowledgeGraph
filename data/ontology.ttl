ngm:bifrost-protocol a owl:Class ;
    rdfs:label "Bifrost Protocol"@en ;
    rdfs:comment "Bifrost is a Bitcoin-focused protocol stack associated with RGB and client-side validation, providing transport and interoperability for off-chain smart-contract state. In the RGB ecosystem it handles the peer-to-peer exchange of consignments and validation data so that asset and contract state can move between parties without publishing it on-chain. By keeping contract data client-side, it preserves Bitcoin's scalability and privacy while enabling rich asset issuance."@en ;
    rdfs:subClassOf ngm:bc-protocol-and-consensus ;
    skos:broader ngm:bc-protocol-and-consensus ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:rgb-and-client-side-validation ;
    vc:slug "bifrost-protocol" ;
    vc:sourceDomain "blockchain" .

ngm:biodiversity-conservation a owl:Class ;
    rdfs:label "Biodiversity Conservation"@en ;
    rdfs:comment "Biodiversity conservation is the protection, restoration and sustainable management of the variety of life on Earth — genes, species, habitats and ecosystems — to maintain ecological function and resilience. It combines protected areas, species recovery, habitat restoration, sustainable use and policy instruments, increasingly informed by monitoring data and remote sensing. As a pillar of environmental sustainability, it is closely linked to climate change mitigation, ecosystem services and emerging biodiversity finance markets."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:environmental-monitoring ],
        ngm:environmental-sustainability ;
