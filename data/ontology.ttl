    vc:requires ngm:replication-protocol ;
    vc:slug "consistency-model" ;
    vc:sourceDomain "distributed-systems" ;
    vc:supports ngm:state-machine-replication ;
    vc:uses ngm:quorum,
        ngm:vector-clock .

ngm:constant-product-formula a owl:Class ;
    rdfs:label "Constant Product Formula"@en ;
    rdfs:comment "The constant product formula is the pricing rule used by many automated market makers in which the product of the two pooled token reserves is held constant during trades."@en ;
