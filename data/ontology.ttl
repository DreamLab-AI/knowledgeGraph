    vc:slug "sc-standards-and-interop" ;
    vc:sourceDomain "spatial-computing" ;
    vc:standardizedBy ngm:3-d-asset-standard .

ngm:proof-of-work a owl:Class ;
    rdfs:label "Proof Of Work"@en ;
    rdfs:comment "A consensus mechanism requiring network participants to expend significant computational effort solving a cryptographic puzzle before appending a new block to the blockchain. The difficulty of the puzzle self-adjusts to maintain a target block interval, making chain rewriting computationally prohibitive and providing Sybil resistance through physical resource expenditure."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:network-hash-rate ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:difficulty-adjustment ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:mining-hardware ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:mining-pool ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:block-reward ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:energy-consumption ],
        ngm:consensus-protocol ;
    vc:bridgesTo ngm:semiconductor-manufacturing ;
    vc:contrastsWith ngm:proof-of-spacetime,
        ngm:proof-of-stake ;
    vc:dependsOn ngm:blockchain,
        ngm:peer-to-peer-network ;
    vc:enables ngm:decentralization,
        ngm:distributed-ledger-technology,
        ngm:immutability,
        ngm:transaction-finality ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:block-reward,
        ngm:difficulty-adjustment,
        ngm:mining-pool,
        ngm:network-hash-rate ;
    vc:implements ngm:byzantine-fault-tolerance,
        ngm:sybil-resistance ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:51-attack,
        ngm:blockchain-network,
        ngm:consensus-algorithm,
        ngm:consensus-mechanism,
        ngm:halving,
        ngm:mempool,
        ngm:selfish-mining ;
    vc:requires ngm:energy-consumption,
        ngm:mining-hardware ;
    vc:slug "proof-of-work" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:double-spend-prevention,
        ngm:network-security ;
    vc:uses ngm:asic,
        ngm:cryptographic-hash-function,
        ngm:hash-function,
        ngm:nonce,
        ngm:sha-256 .

ngm:transparency a owl:Class ;
    rdfs:label "Transparency"@en ;
    rdfs:comment "The property of an AI system whereby relevant information about the system's design, operation, capabilities, limitations, and decision-making processes is accessible and understandable to appropriate stakeholders, enabling informed oversight, trust, and accountability."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:algorithmic-transparency ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:audit-trail ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ai-model-card ],
        ngm:ai-governance-and-ethics ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:bridgesTo ngm:data-governance,
        ngm:open-source-software ;
    vc:contrastsWith ngm:black-box-model ;
    vc:dependsOn ngm:explainability,
        ngm:interpretability ;
    vc:enables ngm:accountability-ai-0068,
        ngm:ai-audit,
        ngm:explainability,
        ngm:informed-consent,
        ngm:stakeholder-trust ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:algorithmic-transparency ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:fairness,
        ngm:human-oversight,
        ngm:privacy ;
    vc:requires ngm:ai-model-card,
        ngm:audit-trail ;
    vc:slug "transparency" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:standardizedBy ngm:eu-ai-act-regulatory-instrument,
        ngm:iso-iec-tr-24028,
