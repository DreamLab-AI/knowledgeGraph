            owl:someValuesFrom ngm:rollup ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:op-stack ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:optimism-collective ],
        ngm:blockchain ;
    skos:broader ngm:blockchain ;
    vc:bridgesTo ngm:decentralised-governance,
        ngm:retroactive-public-goods-funding ;
    vc:contrastsWith ngm:arbitrum,
        ngm:polygon,
