    vc:slug "search-algorithm" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:dynamic-programming,
        ngm:graph-search,
        ngm:heuristic-methods,
        ngm:priority-queue .

ngm:self-consistency a owl:Class ;
    rdfs:label "Self-Consistency"@en ;
    rdfs:comment "Self-consistency is a decoding and prompting strategy for large language models in which multiple independent reasoning chains are sampled stochastically for a given problem and the final answer is selected by majority vote across those chains. The technique exploits the observation that correct reasoning paths, although varied in surface form, converge on the same answer whilst incorrect paths remain scattered across the answer space. Originally introduced alongside chain-of-thought prompting, self-consistency substantially improves accuracy on arithmetic, commonsense, and multi-step logical reasoning tasks without requiring additional model training or fine-tuning."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:chain-of-thought ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:large-language-models ],
        ngm:prompt-engineering ;
    vc:bridgesTo ngm:bayesian-inference,
        ngm:collective-intelligence ;
    vc:contrastsWith ngm:beam-search,
        ngm:greedy-decoding ;
    vc:dependsOn ngm:inference-compute,
        ngm:token-generation ;
    vc:enables ngm:error-correction,
        ngm:reasoning,
        ngm:reliability,
        ngm:robustness ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:ensemble-decoding,
        ngm:test-time-compute ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:mixture-of-agents,
        ngm:process-reward-models,
        ngm:prompt-engineering,
        ngm:tree-of-thoughts ;
    vc:requires ngm:chain-of-thought,
        ngm:large-language-models,
        ngm:stochastic-sampling ;
    vc:slug "self-consistency" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:code-generation,
        ngm:commonsense-reasoning,
        ngm:mathematical-reasoning ;
    vc:uses ngm:ensemble-methods,
        ngm:majority-voting,
        ngm:temperature-sampling .

ngm:sharding a owl:Class ;
    rdfs:label "Sharding"@en ;
    rdfs:comment "Sharding is a horizontal partitioning technique for distributed databases and blockchain networks in which a dataset or workload is divided into disjoint subsets called shards, each maintained by a distinct subset of nodes, so that the total system throughput scales with the number of shards rather than being bounded by the capacity of a single node. In databases, sharding routes queries to the appropriate shard by a sharding key. In blockchain, each shard processes its own subset of transactions and stores its own portion of the state, with cross-shard communication handled by a coordination layer. Sharding dramatically increases transaction throughput and reduces storage requirements per node at the cost of increased architectural complexity and cross-shard coordination overhead."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:consensus-protocol ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:validator-set ],
        ngm:blockchain-scalability ;
    vc:bridgesTo ngm:database-partitioning ;
    vc:contrastsWith ngm:layer-2-scaling,
        ngm:replication ;
    vc:dependsOn ngm:distributed-hash-table,
        ngm:peer-to-peer-network ;
    vc:enables ngm:blockchain-network,
        ngm:distributed-computing,
        ngm:horizontal-scalability ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:beacon-chain,
        ngm:cross-shard-communication,
        ngm:shard,
        ngm:shard-committee ;
    vc:implements ngm:data-partitioning,
        ngm:horizontal-partitioning ;
    vc:isPartOf ngm:blockchain-scalability,
        ngm:distributed-system ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:consensus-mechanism,
        ngm:danksharding,
        ngm:distributed-data-structure,
        ngm:rollup ;
    vc:requires ngm:consensus-protocol,
        ngm:sharding-key,
        ngm:validator-set ;
    vc:slug "sharding" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:consensus-protocol,
        ngm:distributed-hash-table,
        ngm:merkle-tree .

ngm:supply-chain-security a owl:Class ;
    rdfs:label "Supply Chain Security"@en ;
    rdfs:comment "Supply chain security is the practice of protecting the integrity, provenance, and trustworthiness of the components, dependencies, and processes that compose a product, with particular emphasis on software supply chains. It addresses threats such as compromised dependencies, malicious build tooling, and tampered artefacts through measures like signed releases, software bills of materials, and reproducible builds. It has become a critical discipline as systems increasingly assemble third-party code and hardware."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:vulnerability-management ],
        [ a owl:Restriction ;
