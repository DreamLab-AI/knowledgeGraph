        ngm:facial-animation,
        ngm:real-time-character-animation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:physics-based-animation,
        ngm:procedural-animation ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:animation-retargeting,
        ngm:reinforcement-learning,
        ngm:secondary-motion ;
    vc:requires ngm:animation-state-machine ;
    vc:slug "character-animation" ;
    vc:sourceDomain "spatial-computing" ;
    vc:standardizedBy ngm:open-xr,
        ngm:universal-scene-description ;
    vc:uses ngm:character-rigging,
