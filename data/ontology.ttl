ngm:digital-infrastructure a owl:Class ;
    rdfs:label "Digital Infrastructure"@en ;
    rdfs:comment "The foundational computing, networking, and storage systems that underpin large-scale digital services and telecollaboration platforms, including hyperscale data centres with GPU clusters, content delivery networks, software-defined networking, and edge computing nodes. Digital infrastructure is increasingly defined by cloud-native patterns—containerisation, orchestration, and infrastructure-as-code—enabling programmatic resource allocation and resilient, globally distributed deployments."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:content-delivery-network ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:network-infrastructure ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:edge-computing ],
        ngm:infra-computing-and-cloud ;
    skos:broader ngm:infra-computing-and-cloud ;
    vc:enables ngm:distributed-systems,
        ngm:orchestration ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:content-delivery-network,
        ngm:edge-computing,
        ngm:network-infrastructure ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:blockchain ;
    vc:slug "digital-infrastructure" ;
    vc:sourceDomain "infrastructure" .

ngm:gdpr a owl:Class ;
    rdfs:label "GDPR"@en ;
    rdfs:comment "The General Data Protection Regulation (GDPR) is a comprehensive EU legal framework governing the collection, processing, and storage of personal data of individuals within the European Union and European Economic Area. It establishes rights for data subjects and obligations for organisations handling personal data, enforced by national supervisory authorities with significant financial penalties for non-compliance. GDPR represents the most influential data protection law globally, shaping privacy practice and inspiring similar legislation worldwide."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:transparency ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:audit-trail ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-minimisation ],
        ngm:data-protection-regulation ;
    vc:contrastsWith ngm:ai-regulation ;
    vc:enables ngm:accountability,
        ngm:privacy-by-design,
        ngm:privacy-impact-assessment ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:data-governance,
        ngm:data-protection,
        ngm:gdpr-compliance,
        ngm:privacy ;
    vc:requires ngm:audit-trail,
        ngm:data-minimisation,
        ngm:transparency ;
    vc:slug "gdpr" ;
    vc:sourceDomain "governance" .

ngm:knowledge-distillation a owl:Class ;
    rdfs:label "Knowledge Distillation"@en ;
    rdfs:comment "A model compression technique where a smaller \"student\" model is trained to mimic the behaviour of a larger \"teacher\" model, transferring knowledge through soft targets."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:training-data ],
        [ a owl:Restriction ;
