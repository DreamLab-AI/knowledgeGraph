    rdfs:label "Domain Ontology"@en ;
    rdfs:comment "A Domain Ontology is a formal, explicit, machine-readable specification of a shared conceptualisation restricted to a delimited subject domain (clinical medicine, financial instruments, cultural heritage, manufacturing robotics, gene products, scholarly publications, e-commerce products), followi..."@en ;
    rdfs:subClassOf ngm:conceptual-model,
        ngm:formal-specification ;
    vc:enables ngm:automated-reasoning,
        ngm:data-integration,
        ngm:fair-data-principles,
        ngm:knowledge-reuse,
        ngm:linked-data-publication,
        ngm:semantic-interoperability ;
    vc:hasPart ngm:annotation-property,
        ngm:axiom-set,
        ngm:class-hierarchy,
        ngm:data-property,
        ngm:named-individual,
        ngm:namespace-iri,
        ngm:object-property,
        ngm:ontology-design-pattern ;
    vc:implements ngm:closed-world-negation-as-failure,
        ngm:description-logic,
        ngm:open-world-assumption,
        ngm:owl-2-semantics,
        ngm:rdf-schema,
        ngm:skos-concept-scheme ;
    vc:maturity "established" ;
    vc:qualityScore "0.52"^^xsd:float ;
    vc:relatedTo ngm:application-ontology,
        ngm:knowledge-graph,
        ngm:ontology-alignment,
        ngm:schema-org,
        ngm:taxonomy,
        ngm:thesaurus,
        ngm:upper-ontology,
        ngm:wikidata ;
    vc:requires ngm:conceptualisation,
        ngm:domain-expert,
        ngm:identifier-scheme,
        ngm:knowledge-engineer,
        ngm:logical-formalism ;
    vc:slug "domain-ontology" ;
    vc:sourceDomain "infrastructure" ;
    vc:standardizedBy ngm:iso-21127-cidoc-crm,
        ngm:iso-iec-21838-2-bfo,
        ngm:iso-iec-24707-common-logic,
        ngm:obo-foundry,
        ngm:w3-c-owl-2,
        ngm:w3-c-rdf-1-1,
        ngm:w3-c-skos,
        ngm:w3-c-sparql-1-1 ;
