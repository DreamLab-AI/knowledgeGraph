    skos:broader ngm:robo-perception ;
    vc:enables ngm:gesture-recognition,
        ngm:obstacle-avoidance,
        ngm:presence-detection ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:analog-to-digital-converter,
        ngm:signal-amplifier ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires ngm:calibration,
        ngm:power-supply,
        ngm:signal-processing ;
    vc:slug "infrared-sensor" ;
    vc:sourceDomain "robotics" .

ngm:infrastructure-as-a-service a owl:Class ;
    rdfs:label "Infrastructure As A Service"@en ;
    rdfs:comment "Infrastructure as a Service (IaaS) is a cloud computing service model in which a provider delivers virtualised computing resources — including virtual machines, storage, networking, and bare-metal servers — over the internet on a pay-per-use basis, while the customer manages the operating system, middleware, and applications. IaaS abstracts away physical hardware procurement and data centre operations, enabling organisations to provision and de-provision compute capacity elastically. Major IaaS providers include Amazon Web Services (EC2/S3), Microsoft Azure (Virtual Machines), and Google Cloud Platform (Compute Engine)."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:object-storage ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:virtual-machine ],
        ngm:cloud-computing ;
    vc:contrastsWith ngm:on-premises,
        ngm:platform-as-a-service,
        ngm:software-as-a-service ;
    vc:dependsOn ngm:data-centre,
        ngm:hypervisor,
        ngm:virtualisation ;
    vc:enables ngm:devops,
        ngm:disaster-recovery,
        ngm:scalability ;
    vc:hasMaturity ngmi:maturity-draft ;
