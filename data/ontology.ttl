    rdfs:label "Double Blind Review"@en .

ngm:dscsa-compliance a owl:Class ;
    rdfs:label "DSCSA Compliance"@en ;
    rdfs:comment "DSCSA Compliance refers to meeting the requirements of the U.S. Drug Supply Chain Security Act, which mandates electronic, interoperable tracing of prescription drugs at the unit (package) level throughout the supply chain. It requires serialisation, product identifiers, transaction history exchange, and verification of suspect or illegitimate product. Full enforcement of unit-level traceability obligates manufacturers, distributors, and dispensers to maintain auditable end-to-end records."@en ;
    rdfs:subClassOf ngm:regulatory-compliance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:cold-chain-monitoring,
        ngm:pharmaceutical-supply-chain ;
    vc:slug "dscsa-compliance" ;
    vc:sourceDomain "supply-chain" .

ngm:dutch-auction a owl:Class ;
    rdfs:label "Dutch Auction"@en ;
    rdfs:comment "A Dutch auction is a descending-price auction mechanism in which the offered price starts high and falls over time until a bidder accepts, with the first acceptance determining the clearing price. In blockchain and token markets it is implemented in smart contracts to distribute tokens or NFTs, set initial offering prices, and liquidate collateral, with the falling-price schedule encoded on-chain. Variants include single-item and multi-unit uniform-price formats used for fairer price discovery."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:price-discovery ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:smart-contract ],
        ngm:auction-mechanism ;
    vc:bridgesTo ngm:decentralized-finance ;
    vc:enables ngm:price-discovery ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:price-discovery ;
    vc:implements ngm:auction-mechanism ;
    vc:isPartOf ngm:auction-mechanism ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:decentralized-exchange,
        ngm:nft-marketplace,
        ngm:price-discovery ;
    vc:requires ngm:smart-contract ;
    vc:slug "dutch-auction" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:initial-coin-offering,
        ngm:nft-marketplace ;
    vc:uses ngm:smart-contract .

ngm:dvc a owl:Class ;
    rdfs:label "DVC"@en ;
    rdfs:comment "DVC (Data Version Control) is an open-source, Git-integrated data and model versioning tool that applies version control semantics to machine learning datasets, trained model artefacts, and reproducible ML pipelines. It stores large binary artefacts in external object storage while committing hash-based pointer files to Git, enabling deterministic experiment replay, collaborative data science, and automated CI/CD-driven ML pipelines."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
