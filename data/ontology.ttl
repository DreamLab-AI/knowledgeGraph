    vc:slug "collaborative" ;
    vc:sourceDomain "infrastructure" .

ngm:complete-hri-terms-reference a owl:Class ;
    rdfs:label "COMPLETE_HRI_TERMS_REFERENCE"@en ;
    rdfs:comment "A structured terminology reference documenting standardised vocabulary for Human-Robot Interaction (HRI), encompassing communication protocols, behavioural patterns, and engagement modalities. It enables consistent annotation and semantic understanding of interaction contexts across robotic and autonomous systems, aligned with IEEE and ISO standards."@en ;
