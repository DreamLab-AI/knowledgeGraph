    vc:slug "ai-scrapers" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:standardizedBy ngm:eu-ai-act-regulatory-instrument-article-53,
        ngm:gpai-code-of-practice,
        ngm:iab-tech-lab,
