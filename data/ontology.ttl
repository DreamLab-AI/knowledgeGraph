        ngm:simplified-payment-verification ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:locking-script,
        ngm:transaction-output,
        ngm:utxo-set ;
    vc:implements ngm:transaction-validity-rule ;
    vc:isPartOf ngm:bc-protocol-and-consensus,
        ngm:bitcoin-protocol ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:block,
        ngm:blockchain-transaction,
        ngm:coinbase-transaction,
        ngm:wallet ;
    vc:requires ngm:cryptographic-hash-function,
        ngm:digital-signature,
        ngm:public-key-cryptography ;
    vc:slug "utxo-model" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:bitcoin-script,
        ngm:transaction-fee .

ngm:virtual-environment a owl:Class ;
