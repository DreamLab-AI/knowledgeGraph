ngm:drug-discovery a owl:Class ;
    rdfs:label "Drug Discovery"@en ;
    rdfs:comment "Drug discovery is the multidisciplinary scientific process of identifying and validating novel therapeutic compounds that modulate disease-relevant biological targets, spanning target identification, hit discovery, lead optimisation, and preclinical candidate nomination. The modern discipline applies machine learning, deep learning, graph neural networks, and generative modelling to predict molecular properties such as binding affinity, selectivity, and ADMET profiles — dramatically accelerating virtual screening and de novo molecular design. Structural biology tools including protein structure prediction (e.g. AlphaFold) underpin structure-based drug design by supplying accurate 3D target models at proteome scale. The field sits at the intersection of cheminformatics, structural biology, computational chemistry, and clinical informatics, with AI methods increasingly embedded throughout the entire development pipeline from target discovery through biomarker identification and patient stratification."@en ;
    rdfs:subClassOf ngm:ai-application ;
    skos:broader ngm:ai-application ;
    vc:bridgesTo ngm:federated-learning,
        ngm:regulatory-compliance ;
    vc:contrastsWith ngm:traditional-high-throughput-screening ;
    vc:dependsOn ngm:active-learning,
        ngm:high-throughput-screening,
        ngm:protein-structure-prediction ;
    vc:enables ngm:biomarker-discovery,
        ngm:clinical-trials,
        ngm:personalised-medicine ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:digital-twin,
        ngm:genomics,
        ngm:multi-omics,
        ngm:proteomics,
        ngm:simulation ;
    vc:requires ngm:biomedical-data,
        ngm:cheminformatics,
        ngm:structural-biology ;
    vc:slug "drug-discovery" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:generative-model,
        ngm:graph-neural-network,
        ngm:molecular-dynamics-simulation,
        ngm:reinforcement-learning,
        ngm:transformer,
        ngm:variational-autoencoder .

ngm:financial-infrastructure a owl:Class ;
    rdfs:label "Financial Infrastructure"@en ;
    rdfs:comment "Financial Infrastructure comprises the foundational systems, networks, institutions, and regulatory frameworks that enable the creation, transfer, settlement, and custody of financial value at scale. It encompasses payment clearing and settlement networks, central securities depositories, central counterparty clearinghouses, correspondent banking rails, central bank digital currency platforms, and blockchain-based settlement layers. These components collectively underpin both legacy financial systems and emerging decentralised finance ecosystems, ensuring liquidity, finality, and systemic resilience. The integrity of financial infrastructure is a prerequisite for efficient capital allocation, monetary policy transmission, and macroeconomic stability."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:correspondent-banking ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:central-bank-digital-currency ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptographic-protocol ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:payment-network ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:network-security ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:distributed-ledger-technology ],
        ngm:economic-layer ;
    vc:bridgesTo ngm:blockchain-interoperability,
        ngm:lightning-network,
        ngm:smart-contract ;
    vc:contrastsWith ngm:shadow-banking ;
    vc:dependsOn ngm:blockchain-infrastructure,
        ngm:identity-and-access-management,
        ngm:regulatory-framework ;
    vc:enables ngm:cross-border-payment,
        ngm:monetary-policy,
        ngm:tokenisation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:central-bank-digital-currency,
        ngm:central-securities-depository,
        ngm:clearing-and-settlement,
        ngm:correspondent-banking,
        ngm:payment-network ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:economic-layer,
        ngm:financial-regulation,
        ngm:systemic-risk ;
    vc:requires ngm:cryptographic-protocol,
        ngm:distributed-ledger-technology,
        ngm:network-security ;
    vc:slug "financial-infrastructure" ;
    vc:sourceDomain "finance" ;
    vc:standardizedBy ngm:iso-20022,
        ngm:swift-network ;
    vc:supports ngm:capital-markets,
        ngm:decentralised-finance,
        ngm:financial-instruments,
        ngm:financial-services .

ngm:fungible-token a owl:Class ;
    rdfs:label "Fungible Token"@en ;
    rdfs:comment "A blockchain token where each unit is identical and fully interchangeable with any other unit of the same type, analogous to traditional fiat currency. Fungibility is enforced at the protocol level via standards such as ERC-20, ensuring uniform value and seamless divisibility across all holders."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:consensus-mechanism ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:blockchain-transaction ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:smart-contract ],
        ngm:token ;
    vc:bridgesTo ngm:central-bank-digital-currency,
        ngm:digital-currency ;
    vc:contrastsWith ngm:nft,
        ngm:semi-fungible-token ;
    vc:enables ngm:automated-market-maker,
        ngm:decentralised-exchange,
        ngm:liquidity-pool,
        ngm:token-swap ;
