# Healthcare Records
bc:HealthcareRecords a owl:Class ;
    rdfs:label "Healthcare Records"@en ;
    rdfs:comment "Blockchain-based electronic health record systems employing immutable distributed ledgers, smart contracts for consent management, and cryptographic security measures to enable secure patient data sharing, interoperability across healthcare providers, and patient-controlled access whilst maintaining HIPAA and GDPR compliance through hybrid on-chain/off-chain architectures."@en ;
    skos:prefLabel "Healthcare Records"@en ;
    dcterms:identifier "BC-0491" ;
    dcterms:subject "bc" ;
    dcterms:type "draft" ;
    dcterms:conformsTo "0.9"^^xsd:decimal ;
    rdf:type owl:ConceptClass .

# Clinical Trials
bc:ClinicalTrials a owl:Class ;
    rdfs:label "Clinical Trials"@en ;
    rdfs:comment "Blockchain-based clinical trial management systems employing immutable audit trails, smart contracts for protocol compliance, and cryptographic verification to ensure data integrity, prevent fraud, enable patient recruitment improvements, and provide FDA 21 CFR Part 11 compliant tamper-proof record keeping whilst reducing monitoring costs from €722 to €10 per participant visit."@en ;
    skos:prefLabel "Clinical Trials"@en ;
    dcterms:identifier "BC-0492" ;
    dcterms:subject "bc" ;
    dcterms:type "draft" ;
    dcterms:conformsTo "0.91"^^xsd:decimal ;
    rdf:type owl:ConceptClass .

# Real Estate Tokenization
bc:RealEstateTokenization a owl:Class ;
    rdfs:label "Real Estate Tokenization"@en ;
    rdfs:comment "Blockchain-based systems employing security tokens (ERC-3643, ERC-1400, ERC-20 standards) to represent fractional ownership interests in real estate properties, enabling automated dividend distribution through smart contracts, reducing investment minimums from tens of thousands to £50, and creating 24/7 tradeable markets projected to grow from £2.6-3.5 billion (2024) to £4 trillion (2035) whilst providing regulatory compliance through Regulation D, Regulation A+, and international frameworks."@en ;
    skos:prefLabel "Real Estate Tokenization"@en ;
    dcterms:identifier "BC-0493" ;
    dcterms:subject "bc" ;
    dcterms:type "draft" ;
    dcterms:conformsTo "0.87"^^xsd:decimal ;
    rdf:type owl:ConceptClass .

# Property Registry
bc:PropertyRegistry a owl:Class ;
    rdfs:label "Property Registry"@en ;
    rdfs:comment "Blockchain-based land title recording systems employing immutable distributed ledgers, cryptographic signatures, and timestamp verification to create tamper-proof property ownership records, reduce fraud, accelerate transaction processing from 30-90 days to 72 hours, and enable transparent title verification whilst addressing the global challenge where 70% of the world's population lacks access to formal land registration."@en ;
    skos:prefLabel "Property Registry"@en ;
    dcterms:identifier "BC-0494" ;
    dcterms:subject "bc" ;
    dcterms:type "draft" ;
    dcterms:conformsTo "0.9"^^xsd:decimal ;
    rdf:type owl:ConceptClass .

# Voting Systems
bc:VotingSystems a owl:Class ;
    rdfs:label "Voting Systems"@en ;
    rdfs:comment "Blockchain-based electoral systems employing cryptographic verification, end-to-end verifiability, and distributed ledger technology to enable secure voting whilst facing critical security challenges identified by MIT research showing vulnerabilities allowing vote alteration, academic consensus of \"nearly universal\" agreement that no technology can adequately secure online public elections, and real-world implementations spanning Voatz (80,000+ votes across 50+ elections), Estonia (50%+ votes cast online), and Moscow (65,000 voters) demonstrating both potential cost reductions from $7-25 to under $0.50 per vote and significant security concerns."@en ;
    skos:prefLabel "Voting Systems"@en ;
    dcterms:identifier "BC-0495" ;
    dcterms:subject "bc" ;
    dcterms:type "draft" ;
    dcterms:conformsTo "0.82"^^xsd:decimal ;
    rdf:type owl:ConceptClass .

# BlockchainEnergyConsumption
bc:BlockchainEnergyConsumption a owl:Class ;
    rdfs:label "BlockchainEnergyConsumption"@en ;
    rdfs:comment "The electrical power and computational resources consumed by blockchain networks during transaction validation, block creation, and network security operations, varying significantly across consensus mechanisms from energy-intensive Proof-of-Work (Bitcoin: ~140 TWh/year, 0.65% global electricity) to energy-efficient Proof-of-Stake (Ethereum post-Merge: 99.95% reduction), with ongoing research into sustainable consensus algorithms, renewable energy mining, carbon credit tokenization, and environmental impact measurement frameworks."@en ;
    skos:prefLabel "BlockchainEnergyConsumption"@en ;
    dcterms:identifier "BC-0496" ;
    dcterms:subject "bc" ;
    dcterms:type "production-ready" ;
    dcterms:conformsTo "0.88"^^xsd:decimal ;
    rdf:type owl:PerformanceMetricClass .

# Proof Of Stake Sustainability
bc:ProofOfStakeSustainability a owl:Class ;
    rdfs:label "Proof Of Stake Sustainability"@en ;
    rdfs:comment "A component of the blockchain ecosystem."@en ;
    skos:prefLabel "Proof Of Stake Sustainability"@en ;
    dcterms:identifier "BC-0497" ;
    dcterms:subject "bc" ;
    dcterms:type "draft" ;
    rdf:type owl:ConceptClass .

# Carbon Footprint Measurement
bc:CarbonFootprintMeasurement a owl:Class ;
    rdfs:label "Carbon Footprint Measurement"@en ;
    rdfs:comment "A component of the blockchain ecosystem."@en ;
    skos:prefLabel "Carbon Footprint Measurement"@en ;
    dcterms:identifier "BC-0498" ;
    dcterms:subject "bc" ;
    dcterms:type "draft" ;
    rdf:type owl:ConceptClass .

# Green Blockchain Initiatives
bc:GreenBlockchainInitiatives a owl:Class ;
    rdfs:label "Green Blockchain Initiatives"@en ;
    rdfs:comment "A component of the blockchain ecosystem."@en ;
    skos:prefLabel "Green Blockchain Initiatives"@en ;
    dcterms:identifier "BC-0499" ;
    dcterms:subject "bc" ;
    dcterms:type "draft" ;
    rdf:type owl:ConceptClass .

# RenewableEnergyCertificates
bc:RenewableEnergyCertificates a owl:Class ;
    rdfs:label "RenewableEnergyCertificates"@en ;
    rdfs:comment "Digital or blockchain-tokenized instruments that certify the generation of one megawatt-hour (MWh) of electricity from renewable energy sources, providing transparent, immutable proof of renewable energy consumption for carbon accounting, sustainability reporting, and regulatory compliance, with blockchain implementations enabling automated tracking, fractional ownership, peer-to-peer trading, and integration with smart contracts for renewable energy procurement, grid management, and carbon offset markets."@en ;
    skos:prefLabel "RenewableEnergyCertificates"@en ;
    dcterms:identifier "BC-0500" ;
    dcterms:subject "bc" ;
    dcterms:type "production-ready" ;
    dcterms:conformsTo "0.87"^^xsd:decimal ;
    rdf:type owl:DigitalAssetClass .

# ESG Reporting
bc:ESGReporting a owl:Class ;
    rdfs:label "ESG Reporting"@en ;
    rdfs:comment "A component of the blockchain ecosystem."@en ;
    skos:prefLabel "ESG Reporting"@en ;
    dcterms:identifier "BC-0501" ;
    dcterms:subject "bc" ;
    dcterms:type "draft" ;
    rdf:type owl:ConceptClass .

# ClimateActionDAO
bc:ClimateActionDAO a owl:Class ;
    rdfs:label "ClimateActionDAO"@en ;
    rdfs:comment "A decentralized autonomous organization (DAO) governed by blockchain-based smart contracts and token-weighted voting that coordinates collective action toward climate change mitigation, adaptation, and environmental sustainability through transparent, democratic mechanisms for funding climate projects, purchasing and retiring carbon credits, managing regenerative finance (ReFi) portfolios, and distributing climate impact rewards, with notable examples including KlimaDAO (carbon market liquidity), Gitcoin Climate Solutions ($10M+ distributed), and Regen Network (ecological data marketplace)."@en ;
    skos:prefLabel "ClimateActionDAO"@en ;
    dcterms:identifier "BC-0502" ;
    dcterms:subject "bc" ;
    dcterms:type "production-ready" ;
    dcterms:conformsTo "0.85"^^xsd:decimal ;
    rdf:type owl:OrganizationalStructureClass .

# Sustainable Consensus
bc:SustainableConsensus a owl:Class ;
    rdfs:label "Sustainable Consensus"@en ;
    rdfs:comment "A component of the blockchain ecosystem."@en ;
    skos:prefLabel "Sustainable Consensus"@en ;
    dcterms:identifier "BC-0503" ;
    dcterms:subject "bc" ;
    dcterms:type "draft" ;
    rdf:type owl:ConceptClass .

# BlockchainEnvironmentalImpactAssessment
bc:BlockchainEnvironmentalImpactAssessment a owl:Class ;
    rdfs:label "BlockchainEnvironmentalImpactAssessment"@en ;
    rdfs:comment "A systematic evaluation methodology for measuring, analyzing, and reporting the environmental consequences of blockchain network operations, encompassing energy consumption measurement (electricity usage per transaction, annual network consumption), carbon emissions calculation (CO₂e from electricity generation mix), e-waste generation (hardware lifecycle and disposal), water consumption (data center cooling), and broader ecological impacts, with standardized frameworks including Life Cycle Assessment (ISO 14040/14044), Cambridge Centre for Alternative Finance methodologies, and blockchain-specific metrics for comparing consensus mechanisms (Proof-of-Work vs Proof-of-Stake environmental profiles)."@en ;
    skos:prefLabel "BlockchainEnvironmentalImpactAssessment"@en ;
    dcterms:identifier "BC-0504" ;
    dcterms:subject "bc" ;
    dcterms:type "production-ready" ;
    dcterms:conformsTo "0.89"^^xsd:decimal ;
    rdf:type owl:AssessmentFrameworkClass .

# Carbon Neutral Blockchain
bc:CarbonNeutralBlockchain a owl:Class ;
    rdfs:label "Carbon Neutral Blockchain"@en ;
    rdfs:comment "A component of the blockchain ecosystem."@en ;
    skos:prefLabel "Carbon Neutral Blockchain"@en ;
    dcterms:identifier "BC-0505" ;
    dcterms:subject "bc" ;
    dcterms:type "draft" ;
    rdf:type owl:ConceptClass .

# Smart Contract Platform
bc:SmartContractPlatform a owl:Class ;
    rdfs:subClassOf bc:BlockchainNetwork ;
    rdfs:label "Smart Contract Platform"@en ;
    rdfs:comment "A blockchain network providing infrastructure for deploying and executing smart contracts, with virtual machine execution environment, support for programming languages, and token standards."@en ;
    skos:prefLabel "Smart Contract Platform"@en ;
    dcterms:identifier "BC-0507" ;
    dcterms:subject "bc" ;
    dcterms:type "established" ;
    dcterms:conformsTo "0.95"^^xsd:decimal .

# Fungible Token
bc:FungibleToken a owl:Class ;
    rdfs:subClassOf bc:Token ;
    rdfs:label "Fungible Token"@en ;
    rdfs:comment "A token where each unit is identical and interchangeable with any other unit of the same token, like traditional currencies. Each token holds equal value to another token of the same type."@en ;
    skos:prefLabel "Fungible Token"@en ;
    dcterms:identifier "BC-0509" ;
    dcterms:subject "bc" ;
    dcterms:type "established" ;
    dcterms:conformsTo "0.95"^^xsd:decimal .

# Semi-Fungible Token
bc:SemiFungibleToken a owl:Class ;
    rdfs:subClassOf bc:Token ;
    rdfs:label "Semi-Fungible Token"@en ;
    rdfs:comment "A token that can represent both fungible and non-fungible properties, typically starting as fungible but becoming non-fungible under certain conditions, or representing classes of interchangeable assets."@en ;
    skos:prefLabel "Semi-Fungible Token"@en ;
    dcterms:identifier "BC-0511" ;
    dcterms:subject "bc" ;
    dcterms:type "established" ;
    dcterms:conformsTo "0.95"^^xsd:decimal .

# Security Token
bc:SecurityToken a owl:Class ;
    rdfs:subClassOf bc:FungibleToken ;
    rdfs:label "Security Token"@en ;
    rdfs:comment "A token designed to represent complete or fractional ownership interests in assets and/or entities. Subject to restrictions based on identity, jurisdiction, and asset category, and regulated by securities laws providing investors with entitlements like dividends, profit-sharing, or voting privileges."@en ;
    skos:prefLabel "Security Token"@en ;
    dcterms:identifier "BC-0513" ;
    dcterms:subject "bc" ;
    dcterms:type "established" ;
    dcterms:conformsTo "0.95"^^xsd:decimal .

# Stablecoin Token
bc:StablecoinToken a owl:Class ;
    rdfs:subClassOf bc:FungibleToken ;
    rdfs:label "Stablecoin Token"@en ;
    rdfs:comment "A token designed to maintain stable value by pegging to external assets like fiat currencies, commodities, or using algorithmic mechanisms."@en ;
    skos:prefLabel "Stablecoin Token"@en ;
    dcterms:identifier "BC-0514" ;
    dcterms:subject "bc" ;
    dcterms:type "established" ;
    dcterms:conformsTo "0.95"^^xsd:decimal .

# ERC-20 Token
bc:ERC20Token a owl:Class ;
    rdfs:subClassOf bc:FungibleToken ;
    rdfs:label "ERC-20 Token"@en ;
    rdfs:comment "A fungible token implementing the ERC-20 standard on Ethereum blockchain. The most widely used Ethereum token standard providing uniform API for token operations within smart contracts."@en ;
    skos:prefLabel "ERC-20 Token"@en ;
    dcterms:identifier "BC-0515" ;
    dcterms:subject "bc" ;
    dcterms:type "established" ;
    dcterms:conformsTo "0.95"^^xsd:decimal .

# ERC-721 Token
bc:ERC721Token a owl:Class ;
    rdfs:subClassOf bc:NonFungibleToken ;
    rdfs:label "ERC-721 Token"@en ;
    rdfs:comment "A non-fungible token implementing the ERC-721 standard, a free, open standard for building unique tokens on Ethereum blockchain with trackable ownership via token identification numbers and ownerOf function."@en ;
    skos:prefLabel "ERC-721 Token"@en ;
    dcterms:identifier "BC-0516" ;
    dcterms:subject "bc" ;
    dcterms:type "established" ;
    dcterms:conformsTo "0.95"^^xsd:decimal .

# ERC-1155 Token
bc:ERC1155Token a owl:Class ;
    rdfs:subClassOf bc:SemiFungibleToken ;
    rdfs:label "ERC-1155 Token"@en ;
    rdfs:comment "A multi-token standard offering semi-fungibility where tokens represent classes of interchangeable assets. Bundles multiple assets (fungible and non-fungible) in one smart contract for efficient gas usage and reduced network congestion."@en ;
    skos:prefLabel "ERC-1155 Token"@en ;
    dcterms:identifier "BC-0517" ;
    dcterms:subject "bc" ;
    dcterms:type "established" ;
    dcterms:conformsTo "0.95"^^xsd:decimal .

# ERC-1400 Token
bc:ERC1400Token a owl:Class ;
    rdfs:subClassOf bc:SecurityToken ;
    rdfs:label "ERC-1400 Token"@en ;
    rdfs:comment "A security token standard tailored for regulatory compliance, providing transfer restrictions, document management, and compliance hooks for securities law requirements."@en ;
    skos:prefLabel "ERC-1400 Token"@en ;
    dcterms:identifier "BC-0518" ;
    dcterms:subject "bc" ;
    dcterms:type "established" ;
    dcterms:conformsTo "0.95"^^xsd:decimal .

# ERC-3643 Token
bc:ERC3643Token a owl:Class ;
    rdfs:subClassOf bc:SecurityToken ;
    rdfs:label "ERC-3643 Token"@en ;
    rdfs:comment "A permissioned token standard for security tokens with on-chain identity verification and compliance rules, enabling compliant transfer restrictions based on investor identity and jurisdiction."@en ;
    skos:prefLabel "ERC-3643 Token"@en ;
    dcterms:identifier "BC-0519" ;
    dcterms:subject "bc" ;
    dcterms:type "established" ;
    dcterms:conformsTo "0.95"^^xsd:decimal .

# Fixed Supply Token
bc:FixedSupplyToken a owl:Class ;
    rdfs:subClassOf bc:FungibleToken ;
    rdfs:label "Fixed Supply Token"@en ;
    rdfs:comment "A token with a predetermined maximum supply that cannot be exceeded, often with emission schedule governing distribution over time."@en ;
    skos:prefLabel "Fixed Supply Token"@en ;
    dcterms:identifier "BC-0523" ;
    dcterms:subject "bc" ;
    dcterms:type "established" ;
    dcterms:conformsTo "0.95"^^xsd:decimal .

# ERC-20 Standard
bc:ERC20Standard a owl:Class ;
    rdfs:label "ERC-20 Standard"@en ;
    rdfs:comment "Technical standard for fungible tokens on Ethereum, defining required methods and events for token contracts."@en ;
    skos:prefLabel "ERC-20 Standard"@en ;
    dcterms:identifier "BC-0538" ;
    dcterms:subject "bc" ;
    dcterms:type "established" ;
    dcterms:conformsTo "0.95"^^xsd:decimal .

# ERC-721 Standard
bc:ERC721Standard a owl:Class ;
    rdfs:label "ERC-721 Standard"@en ;
    rdfs:comment "Technical standard for non-fungible tokens on Ethereum, defining unique token identification and ownership tracking."@en ;
    skos:prefLabel "ERC-721 Standard"@en ;
    dcterms:identifier "BC-0539" ;
    dcterms:subject "bc" ;
    dcterms:type "established" ;
    dcterms:conformsTo "0.95"^^xsd:decimal .

# ERC-1155 Standard
bc:ERC1155Standard a owl:Class ;
    rdfs:label "ERC-1155 Standard"@en ;
    rdfs:comment "Multi-token standard supporting both fungible and non-fungible tokens in a single contract."@en ;
    skos:prefLabel "ERC-1155 Standard"@en ;
    dcterms:identifier "BC-0540" ;
    dcterms:subject "bc" ;
    dcterms:type "established" ;
    dcterms:conformsTo "0.95"^^xsd:decimal .

# ERC-1400 Standard
bc:ERC1400Standard a owl:Class ;
    rdfs:label "ERC-1400 Standard"@en ;
    rdfs:comment "Security token standard with compliance controls and transfer restrictions."@en ;
    skos:prefLabel "ERC-1400 Standard"@en ;
    dcterms:identifier "BC-0541" ;
    dcterms:subject "bc" ;
    dcterms:type "established" ;
    dcterms:conformsTo "0.95"^^xsd:decimal .

# ERC-3643 Standard
bc:ERC3643Standard a owl:Class ;
    rdfs:label "ERC-3643 Standard"@en ;
    rdfs:comment "Permissioned token standard with on-chain identity verification for regulatory compliance."@en ;
    skos:prefLabel "ERC-3643 Standard"@en ;
    dcterms:identifier "BC-0542" ;
    dcterms:subject "bc" ;
    dcterms:type "established" ;
    dcterms:conformsTo "0.95"^^xsd:decimal .

# Proof-Based Consensus
bc:ProofBasedConsensus a owl:Class ;
    rdfs:subClassOf bc:ConsensusMechanism ;
    rdfs:label "Proof-Based Consensus"@en ;
    rdfs:comment "Consensus mechanisms requiring participants to provide cryptographic or computational proof to validate transactions and create blocks."@en ;
    skos:prefLabel "Proof-Based Consensus"@en ;
    dcterms:identifier "BC-0543" ;
    dcterms:subject "bc" ;
    dcterms:type "established" ;
    dcterms:conformsTo "0.95"^^xsd:decimal .

# Byzantine Fault Tolerance
bc:ByzantineFaultTolerance a owl:Class ;
    rdfs:subClassOf bc:ConsensusMechanism ;
    rdfs:label "Byzantine Fault Tolerance"@en ;
    rdfs:comment "The feature of a distributed network to reach consensus on the same value even when some nodes fail to respond or respond with incorrect information. Enables networks to function correctly despite malicious or faulty nodes comprising less than one-third of the network."@en ;
    skos:prefLabel "Byzantine Fault Tolerance"@en ;
    dcterms:identifier "BC-0544" ;
    dcterms:subject "bc" ;
    dcterms:type "established" ;
    dcterms:conformsTo "0.95"^^xsd:decimal .

# Hybrid Consensus
bc:HybridConsensus a owl:Class ;
    rdfs:subClassOf bc:ConsensusMechanism ;
    rdfs:label "Hybrid Consensus"@en ;
    rdfs:comment "Consensus mechanisms combining multiple approaches, typically merging proof-based methods with BFT finality or mixing PoW and PoS elements."@en ;
    skos:prefLabel "Hybrid Consensus"@en ;
    dcterms:identifier "BC-0545" ;
    dcterms:subject "bc" ;
    dcterms:type "established" ;
    dcterms:conformsTo "0.95"^^xsd:decimal .

# Proof of Stake
bc:ProofOfStake a owl:Class ;
    rdfs:subClassOf bc:ProofBasedConsensus ;
    rdfs:label "Proof of Stake"@en ;
    rdfs:comment "A consensus mechanism allowing blockchains to validate transactions and create new blocks based on the number of tokens held or staked by network participants. Formally, a consensus model where the blockchain network is secured by users locking cryptocurrency into the blockchain network through a process called staking."@en ;
    skos:prefLabel "Proof of Stake"@en ;
    dcterms:identifier "BC-0546" ;
    dcterms:subject "bc" ;
    dcterms:type "established" ;
    dcterms:conformsTo "0.95"^^xsd:decimal .

# Proof of Authority
bc:ProofOfAuthority a owl:Class ;
    rdfs:subClassOf bc:ProofBasedConsensus ;
    rdfs:label "Proof of Authority"@en ;
    rdfs:comment "A consensus mechanism where pre-approved validators (authorities) with verified identities are authorized to validate transactions and create blocks."@en ;
    skos:prefLabel "Proof of Authority"@en ;
    dcterms:identifier "BC-0547" ;
    dcterms:subject "bc" ;
    dcterms:type "established" ;
    dcterms:conformsTo "0.95"^^xsd:decimal .

# Proof of History
bc:ProofOfHistory a owl:Class ;
    rdfs:subClassOf bc:ProofBasedConsensus ;
    rdfs:label "Proof of History"@en ;
    rdfs:comment "A cryptographic mechanism that timestamps transactions to establish a historical record, enabling validators to process transactions in parallel for high throughput. Creates verifiable passage of time between events without requiring nodes to trust each other."@en ;
    skos:prefLabel "Proof of History"@en ;
    dcterms:identifier "BC-0548" ;
    dcterms:subject "bc" ;
    dcterms:type "established" ;
    dcterms:conformsTo "0.95"^^xsd:decimal .

# Pure Proof of Stake
bc:PureProofOfStake a owl:Class ;
    rdfs:subClassOf bc:ProofOfStake ;
    rdfs:label "Pure Proof of Stake"@en ;
    rdfs:comment "A PoS variant that randomly selects validators from all stakers proportional to their stake weight, without delegation mechanisms."@en ;
    skos:prefLabel "Pure Proof of Stake"@en ;
    dcterms:identifier "BC-0549" ;
    dcterms:subject "bc" ;
    dcterms:type "established" ;
    dcterms:conformsTo "0.95"^^xsd:decimal .

# Delegated Proof of Stake
bc:DelegatedProofOfStake a owl:Class ;
    rdfs:subClassOf bc:ProofOfStake ;
    rdfs:label "Delegated Proof of Stake"@en ;
    rdfs:comment "A PoS variant where network participants have the right to delegate the production of new blocks to a fixed number of delegates (witnesses), with users determining delegates via democratic voting mechanism weighted by locked tokens."@en ;
    skos:prefLabel "Delegated Proof of Stake"@en ;
    dcterms:identifier "BC-0550" ;
    dcterms:subject "bc" ;
    dcterms:type "established" ;
    dcterms:conformsTo "0.95"^^xsd:decimal .

# Nominated Proof of Stake
bc:NominatedProofOfStake a owl:Class ;
    rdfs:subClassOf bc:ProofOfStake ;
    rdfs:label "Nominated Proof of Stake"@en ;
    rdfs:comment "A PoS variant where token holders nominate validators for block creation, with elected validators producing blocks while nominators share rewards and slashing risks."@en ;
    skos:prefLabel "Nominated Proof of Stake"@en ;
    dcterms:identifier "BC-0551" ;
    dcterms:subject "bc" ;
    dcterms:type "established" ;
    dcterms:conformsTo "0.95"^^xsd:decimal .

# Liquid Proof of Stake
bc:LiquidProofOfStake a owl:Class ;
    rdfs:subClassOf bc:ProofOfStake ;
    rdfs:label "Liquid Proof of Stake"@en ;
    rdfs:comment "A PoS variant allowing token holders to delegate their staking rights to validators (bakers) while retaining token ownership and liquidity."@en ;
    skos:prefLabel "Liquid Proof of Stake"@en ;
    dcterms:identifier "BC-0552" ;
    dcterms:subject "bc" ;
    dcterms:type "established" ;
    dcterms:conformsTo "0.95"^^xsd:decimal .

# Ouroboros Consensus
bc:OuroborosConsensus a owl:Class ;
    rdfs:subClassOf bc:ProofOfStake ;
    rdfs:label "Ouroboros Consensus"@en ;
    rdfs:comment "A mathematically-verified PoS consensus protocol using slot leaders to validate transactions and add blocks. Divides time into epochs and slots, with stake pools randomly selected as slot leaders."@en ;
    skos:prefLabel "Ouroboros Consensus"@en ;
    dcterms:identifier "BC-0553" ;
    dcterms:subject "bc" ;
    dcterms:type "established" ;
    dcterms:conformsTo "0.95"^^xsd:decimal .

# Gasper Consensus
bc:GasperConsensus a owl:Class ;
    rdfs:subClassOf bc:ProofOfStake ;
    rdfs:subClassOf bc:HybridConsensus ;
    rdfs:label "Gasper Consensus"@en ;
    rdfs:comment "Ethereum's PoS consensus combining Casper FFG (finality gadget) with LMD GHOST (fork choice rule). Validators directly stake ether without delegation mechanism."@en ;
    skos:prefLabel "Gasper Consensus"@en ;
    dcterms:identifier "BC-0554" ;
    dcterms:subject "bc" ;
    dcterms:type "established" ;
    dcterms:conformsTo "0.95"^^xsd:decimal .

# Practical Byzantine Fault Tolerance
bc:PracticalByzantineFaultTolerance a owl:Class ;
    rdfs:subClassOf bc:ByzantineFaultTolerance ;
    rdfs:label "Practical Byzantine Fault Tolerance"@en ;
    rdfs:comment "A consensus algorithm providing high-performance Byzantine state machine replication, processing thousands of requests per second with sub-millisecond latency increases. Designed for asynchronous systems with low latency optimization."@en ;
    skos:prefLabel "Practical Byzantine Fault Tolerance"@en ;
    dcterms:identifier "BC-0555" ;
    dcterms:subject "bc" ;
    dcterms:type "established" ;
    dcterms:conformsTo "0.95"^^xsd:decimal .

# Federated Byzantine Fault Tolerance
bc:FederatedByzantineFaultTolerance a owl:Class ;
    rdfs:subClassOf bc:ByzantineFaultTolerance ;
    rdfs:label "Federated Byzantine Fault Tolerance"@en ;
    rdfs:comment "A consensus mechanism enhancing scalability, speed, and security of blockchain networks by using a trusted set of federated nodes for consensus rather than the entire network."@en ;
    skos:prefLabel "Federated Byzantine Fault Tolerance"@en ;
    dcterms:identifier "BC-0556" ;
    dcterms:subject "bc" ;
    dcterms:type "established" ;
    dcterms:conformsTo "0.95"^^xsd:decimal .

# Tendermint Consensus
bc:TendermintConsensus a owl:Class ;
    rdfs:subClassOf bc:ByzantineFaultTolerance ;
    rdfs:subClassOf bc:HybridConsensus ;
    rdfs:label "Tendermint Consensus"@en ;
    rdfs:comment "A BFT consensus engine combining PBFT with PoS, providing instant finality and supporting high transaction throughput."@en ;
    skos:prefLabel "Tendermint Consensus"@en ;
    dcterms:identifier "BC-0557" ;
    dcterms:subject "bc" ;
    dcterms:type "established" ;
    dcterms:conformsTo "0.95"^^xsd:decimal .

# HotStuff Consensus
bc:HotStuffConsensus a owl:Class ;
    rdfs:subClassOf bc:ByzantineFaultTolerance ;
    rdfs:label "HotStuff Consensus"@en ;
    rdfs:comment "The first state machine replication protocol with linear view transformation complexity and optimistic responsiveness, simplifying PBFT for better performance."@en ;
    skos:prefLabel "HotStuff Consensus"@en ;
    dcterms:identifier "BC-0558" ;
    dcterms:subject "bc" ;
    dcterms:type "established" ;
    dcterms:conformsTo "0.95"^^xsd:decimal .

# Dynamic Scalable BFT
bc:DynamicScalableBFT a owl:Class ;
    rdfs:subClassOf bc:PracticalByzantineFaultTolerance ;
    rdfs:label "Dynamic Scalable BFT"@en ;
    rdfs:comment "An optimized SBFT protocol using Distributed Key Generation (DKG) technology and BLS aggregate signature scheme for enhanced scalability with dynamic node management."@en ;
    skos:prefLabel "Dynamic Scalable BFT"@en ;
    dcterms:identifier "BC-0559" ;
    dcterms:subject "bc" ;
    dcterms:type "established" ;
    dcterms:conformsTo "0.95"^^xsd:decimal .

# Node-Independent Validation PBFT
bc:NodeIndependentValidationPBFT a owl:Class ;
    rdfs:subClassOf bc:PracticalByzantineFaultTolerance ;
    rdfs:label "Node-Independent Validation PBFT"@en ;
    rdfs:comment "An improved PBFT algorithm based on node-independent validation, enabling more flexible and resilient consensus."@en ;
    skos:prefLabel "Node-Independent Validation PBFT"@en ;
    dcterms:identifier "BC-0560" ;
    dcterms:subject "bc" ;
    dcterms:type "established" ;
    dcterms:conformsTo "0.95"^^xsd:decimal .

# Trusted Execution PBFT
bc:TrustedExecutionPBFT a owl:Class ;
    rdfs:subClassOf bc:PracticalByzantineFaultTolerance ;
    rdfs:label "Trusted Execution PBFT"@en ;
    rdfs:comment "A parallel Byzantine Fault Tolerance protocol leveraging Trusted Execution Environments (TEEs), utilizing a Unique Sequential Identifier Generator (USIG) based on Intel Software Guard Extensions (SGX)."@en ;
    skos:prefLabel "Trusted Execution PBFT"@en ;
    dcterms:identifier "BC-0561" ;
    dcterms:subject "bc" ;
    dcterms:type "established" ;
    dcterms:conformsTo "0.95"^^xsd:decimal .

# Reputation-Based BFT
bc:ReputationBasedBFT a owl:Class ;
    rdfs:subClassOf bc:ByzantineFaultTolerance ;
    rdfs:label "Reputation-Based BFT"@en ;
    rdfs:comment "A BFT algorithm incorporating a reputation model to evaluate the operations of each node in the consensus process, giving higher weight to nodes with better historical behavior."@en ;
    skos:prefLabel "Reputation-Based BFT"@en ;
    dcterms:identifier "BC-0562" ;
    dcterms:subject "bc" ;
    dcterms:type "established" ;
    dcterms:conformsTo "0.95"^^xsd:decimal .

# High Energy Consumption
bc:HighEnergyConsumption a owl:Class ;
    rdfs:label "High Energy Consumption"@en ;
    rdfs:comment "Energy consumption level characteristic of PoW consensus mechanisms requiring significant computational resources."@en ;
    skos:prefLabel "High Energy Consumption"@en ;
    dcterms:identifier "BC-0563" ;
    dcterms:subject "bc" ;
    dcterms:type "established" ;
    dcterms:conformsTo "0.95"^^xsd:decimal .

# Low Energy Consumption
bc:LowEnergyConsumption a owl:Class ;
    rdfs:label "Low Energy Consumption"@en ;
    rdfs:comment "Energy consumption level characteristic of PoS and BFT mechanisms requiring minimal computational resources (99% less than PoW)."@en ;
    skos:prefLabel "Low Energy Consumption"@en ;
    dcterms:identifier "BC-0564" ;
    dcterms:subject "bc" ;
    dcterms:type "established" ;
    dcterms:conformsTo "0.95"^^xsd:decimal .

# Sub-Millisecond Latency
bc:SubMillisecondLatency a owl:Class ;
    rdfs:label "Sub-Millisecond Latency"@en ;
    rdfs:comment "Latency characteristic where consensus adds less than one millisecond to transaction confirmation time."@en ;
    skos:prefLabel "Sub-Millisecond Latency"@en ;
    dcterms:identifier "BC-0565" ;
    dcterms:subject "bc" ;
    dcterms:type "established" ;
    dcterms:conformsTo "0.95"^^xsd:decimal .

# Solana
bc:Solana a owl:Class ;
    rdfs:subClassOf bc:SmartContractPlatform ;
    rdfs:label "Solana"@en ;
    rdfs:comment "A high-performance blockchain platform combining Proof-of-History (PoH) with Proof-of-Stake consensus, enabling parallel transaction processing for exceptional throughput exceeding 65,000 TPS. Uses single-layer architecture where all transactions process on the base layer, prioritizing speed, throughput, and low latency."@en ;
    skos:prefLabel "Solana"@en ;
    dcterms:identifier "BC-0566" ;
    dcterms:subject "bc" ;
    dcterms:type "established" ;
    dcterms:conformsTo "0.95"^^xsd:decimal .

# Cardano
bc:Cardano a owl:Class ;
    rdfs:subClassOf bc:SmartContractPlatform ;
    rdfs:label "Cardano"@en ;
    rdfs:comment "A research-driven blockchain platform using the mathematically-verified Ouroboros Proof-of-Stake consensus protocol. Features layered architecture separating settlement and computation layers, written in Haskell with Plutus for smart contracts. Emphasizes formal verification, sustainability, decentralization, and provable security guarantees."@en ;
    skos:prefLabel "Cardano"@en ;
    dcterms:identifier "BC-0567" ;
    dcterms:subject "bc" ;
    dcterms:type "established" ;
    dcterms:conformsTo "0.95"^^xsd:decimal .

