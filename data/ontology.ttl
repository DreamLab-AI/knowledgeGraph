ngm:multi-agent-systems a owl:Class ;
    rdfs:label "Multi-Agent Systems"@en ;
    rdfs:comment "Multi-agent systems (MAS) are computational architectures in which multiple autonomous agents—each with their own perception, memory, and action capabilities—interact within a shared environment to accomplish tasks that benefit from parallelisation, specialisation, or distributed coordination. In contemporary AI, MAS are realised through networks of LLM-backed agents orchestrated by frameworks that manage inter-agent communication, tool invocation, and task decomposition. Emergent collective behaviours, coordination protocols, and mechanism-design principles from classical MAS theory inform how modern agentic systems handle conflict, deception, and incentive alignment."@en ;
    rdfs:subClassOf ngm:ai-application ;
    skos:broader ngm:ai-application ;
    vc:enables ngm:agentic-ai,
        ngm:task-planning ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:reinforcement-learning ;
    vc:slug "multi-agent-systems" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:agent-frameworks,
        ngm:autonomous-agent,
        ngm:orchestration .

ngm:multimodal-ai a owl:Class ;
    rdfs:label "Multimodal AI"@en ;
    rdfs:comment "Multimodal AI refers to machine learning systems that process and integrate information from multiple data modalities — including text, images, audio, and video — simultaneously to produce contextually richer outputs than single-modality systems. These architectures employ specialised neural network fusion techniques to replicate the human brain's capacity to synthesise diverse sensory inputs, enabling applications in healthcare diagnostics, human-computer interaction, and cross-modal content generation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:speech-recognition ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:computer-vision ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:multimodal-understanding ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:natural-language-processing ],
        ngm:ai-research-area ;
    skos:broader ngm:ai-research-area ;
    vc:enables ngm:generative-ai,
        ngm:image-generation,
        ngm:text-to-image ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:computer-vision,
        ngm:multimodal-understanding,
        ngm:natural-language-processing,
        ngm:speech-recognition ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:large-language-models,
        ngm:sensor-fusion ;
    vc:slug "multimodal-ai" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:deep-learning,
        ngm:feature-extraction,
        ngm:neural-network,
        ngm:transformer-architecture .

