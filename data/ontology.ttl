ngm:computational-model a owl:Class ;
    rdfs:label "Computational Model"@en ;
    rdfs:comment "A computational model is a mathematical and algorithmic representation of a system that uses computing resources to simulate, predict, or analyse the system's behaviour under varying conditions. It encodes the entities, state variables, and governing rules of a phenomenon into executable form so that experiments can be run in silico rather than physically. Computational models underpin scientific simulation, engineering design, and the predictive components of spatial and physical computing."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:algorithm ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:computational-geometry ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:computational-geometry ],
        ngm:simulation ;
    vc:bridgesTo ngm:machine-learning ;
    vc:enables ngm:digital-twin,
        ngm:physics-engine ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:computational-geometry ;
    vc:implements ngm:algorithm ;
    vc:isPartOf ngm:simulation ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:perception-system,
        ngm:simulation,
        ngm:spatial-computing ;
    vc:requires ngm:algorithm,
        ngm:computational-geometry ;
    vc:slug "computational-model" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:autonomous-vehicle-testing ;
    vc:uses ngm:algorithm .

ngm:computational-modelling a owl:Class ;
    rdfs:label "Computational Modelling"@en ;
    rdfs:comment "Computational Modelling is the use of mathematical formalisms implemented as computer programs to simulate the behaviour of real-world systems across domains such as physics, biology, economics, and climate science. A computational model translates theoretical assumptions into executable code so that hypotheses can be tested, predictions generated, and sensitivity analyses performed at scale. It forms the methodological backbone of simulation-based science and underpins modern AI training pipelines."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:differential-equations ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:monte-carlo-simulation ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:sensitivity-analysis ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:agent-based-modelling ],
        [ a owl:Restriction ;
