ngm:distributed-system a owl:Class ;
    rdfs:label "Distributed System"@en ;
    rdfs:comment "A Distributed System is a collection of autonomous computing nodes that communicate over a network and coordinate their actions to appear as a single coherent system to end users. Key properties include decentralisation (no single point of failure), fault tolerance via consensus protocols, and eventual consistency governed by CAP theorem trade-offs. Blockchain networks, microservices architectures, and distributed databases are canonical instantiations."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:blockchain-network ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptographic-hash ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:consensus-mechanism ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-replication ],
        ngm:infra-computing-and-cloud ;
    skos:broader ngm:infra-computing-and-cloud ;
    vc:enables ngm:blockchain,
        ngm:distributed-ledger ;
