    vc:relatedTo ngm:block-reward,
        ngm:blockchain,
        ngm:miner,
        ngm:mining,
        ngm:transaction-fee ;
    vc:slug "difficulty-adjustment" ;
    vc:sourceDomain "blockchain" .

ngm:digital-certificate a owl:Class ;
