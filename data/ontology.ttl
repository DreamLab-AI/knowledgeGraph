    vc:relatedTo ngm:collaboration-platform,
        ngm:digital-workplace-platform,
        ngm:immersive-workspaces,
        ngm:telecollaboration ;
    vc:requires ngm:extended-reality,
        ngm:immersive-technology ;
    vc:slug "augmented-connected-workforce" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:augmented-reality,
        ngm:internet-of-things,
        ngm:virtual-reality,
        ngm:wearable-computing-platform .

ngm:augmented-reality-ar a owl:Class ;
    rdfs:label "Augmented Reality (AR)"@en ;
    rdfs:comment "Interactive system that overlays digital content (visual, audio, haptic) onto the physical environment in real time, enabling spatially-registered blended experiences where virtual information enhances physical perception."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:environmental-sensor ],
