        ngm:ai-governance-and-ethics,
        ngm:existential-risk-research ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:enables ngm:catastrophic-risk-reduction,
        ngm:human-oversight,
        ngm:responsible-scaling,
        ngm:safe-ai-deployment,
        ngm:trustworthy-ai-systems ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:constitutional-ai,
        ngm:dangerous-capability-evaluations,
        ngm:debate,
        ngm:mechanistic-interpretability,
        ngm:red-teaming,
        ngm:reward-modelling,
        ngm:rlhf,
        ngm:scalable-oversight,
        ngm:sparse-autoencoders,
        ngm:weak-to-strong-generalisation ;
    vc:implements ngm:adversarial-red-teaming,
