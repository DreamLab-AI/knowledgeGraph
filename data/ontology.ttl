ngm:probabilistic-modelling a owl:Class ;
    rdfs:comment "The practice of representing systems, processes, and observations as probability distributions over possible states rather than as single deterministic values, so that predictions carry calibrated uncertainty. Probabilistic modelling encompasses specifying random variables and their dependencies, choosing priors, performing inference to update beliefs from data, and validating the resulting probabilistic model—underpinning Bayesian statistics, generative machine learning, risk analysis, and scientific simulation."@en ;
    rdfs:label "Probabilistic Modelling"@en ;
    rdfs:subClassOf ngm:computational-modelling ;
    rdfs:subClassOf _:r16981 ;
    vc:enables ngm:uncertainty-quantification ;
