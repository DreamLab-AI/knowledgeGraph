ngm:bip-341-taproot a owl:Class ;
    rdfs:comment "A Bitcoin Improvement Proposal defining Taproot, an upgrade introducing a new output type using Schnorr signatures and Merkle-branch script commitments. It improves privacy and flexibility of Bitcoin transactions."@en ;
    rdfs:label "BIP-341 Taproot"@en ;
