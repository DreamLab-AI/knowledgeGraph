ngm:knowledge-representation a owl:Class ;
    rdfs:label "Knowledge Representation"@en ;
    rdfs:comment "Knowledge Representation in AI involves the formal encoding of information about the world in a computationally tractable format that enables reasoning, inference, and decision-making. Approaches include symbolic systems (first-order logic, description logics, semantic networks), graph-based representations (knowledge graphs, ontologies), probabilistic models (Bayesian networks, Markov logic networks), and distributed representations (embeddings, neural-symbolic integration)."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:ontology ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:controlled-vocabulary ],
        ngm:ai-research-area ;
    skos:broader ngm:ai-research-area ;
    vc:bridgesTo ngm:database-schema,
        ngm:linked-data ;
    vc:contrastsWith ngm:neural-network,
        ngm:sub-symbolic-ai ;
    vc:enables ngm:automated-reasoning,
        ngm:bayesian-inference,
        ngm:expert-system,
        ngm:explainable-ai,
        ngm:question-answering ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:frame-representation,
        ngm:ontology,
        ngm:production-rule-system ;
    vc:implements ngm:closed-world-assumption,
        ngm:open-world-assumption ;
    vc:qualityScore "0.65"^^xsd:float ;
    vc:relatedTo ngm:information-extraction,
        ngm:knowledge-management,
        ngm:neural-symbolic-integration ;
    vc:requires ngm:controlled-vocabulary,
        ngm:formal-logic ;
    vc:slug "knowledge-representation" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:knowledge-management,
        ngm:natural-language-processing ;
    vc:uses ngm:description-logic,
        ngm:first-order-logic,
        ngm:knowledge-graph,
        ngm:ontology,
        ngm:semantic-network,
        ngm:semantic-web-linked-data-standard .

