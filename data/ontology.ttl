ngm:climate-commitments a owl:Class ;
    rdfs:label "Climate Commitments"@en ;
    rdfs:comment "Climate commitments are formal pledges by governments, companies, or coalitions to achieve specified greenhouse-gas reduction or removal outcomes by defined dates, such as net-zero or science-based emissions targets. They typically combine a headline goal with interim milestones, accounting boundaries, and reporting obligations to make progress verifiable. They matter as the governance mechanism that translates climate ambition into measurable, accountable action and that shapes corporate sustainability and offsetting strategies."@en ;
    rdfs:subClassOf ngm:sustainability ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:carbon-neutral-blockchain,
        ngm:net-zero-targets ;
    vc:slug "climate-commitments" ;
    vc:sourceDomain "governance" .

ngm:closed-world-assumption a owl:Class ;
    rdfs:label "Closed World Assumption"@en ;
    rdfs:comment "The Closed World Assumption (CWA) is the presumption that any statement not known to be true is false, treating the knowledge base as a complete description of the world. It is foundational to database query semantics, logic programming, and negation as failure, where the absence of a fact licenses inferring its negation. CWA simplifies reasoning over finite, curated domains but breaks down where information is incomplete."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:formal-logic ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:knowledge-representation ],
        ngm:knowledge-representation ;
    vc:bridgesTo ngm:logic-programming,
        ngm:semantic-web ;
    vc:contrastsWith ngm:open-world-assumption,
        ngm:semantic-web ;
    vc:enables ngm:data-integrity-constraint,
        ngm:query-answering,
        ngm:reasoning ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:reasoning ;
    vc:isPartOf ngm:artificial-intelligence,
        ngm:database-theory ;
    vc:qualityScore "0.92"^^xsd:float ;
    vc:relatedTo ngm:description-logic,
        ngm:inference-engine,
        ngm:ontology,
        ngm:reasoning,
        ngm:shacl,
        ngm:sparql ;
    vc:requires ngm:formal-logic,
        ngm:knowledge-representation ;
    vc:slug "closed-world-assumption" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:knowledge-representation,
        ngm:relational-database ;
    vc:uses ngm:datalog,
        ngm:inference-engine,
        ngm:negation-as-failure .

