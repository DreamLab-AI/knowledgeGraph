        ngm:model-evaluation-results,
        ngm:model-performance,
        ngm:reproducibility ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:adversarial-testing,
        ngm:benchmark-standard,
        ngm:bias-and-fairness,
        ngm:large-language-models,
        ngm:model-cards,
        ngm:overfitting,
        ngm:software-testing ;
    vc:requires ngm:evaluation-metric,
