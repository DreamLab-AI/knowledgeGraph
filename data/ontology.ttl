        ngm:tool-schema,
        ngm:tool-use ;
    vc:slug "action-executor" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:error-handling,
        ngm:json-schema,
        ngm:orchestration,
        ngm:sandbox-environment .

ngm:additionality a owl:Class ;
    rdfs:label "Additionality"@en ;
    rdfs:comment "Additionality is the principle, central to carbon markets and climate finance, that an emissions-reduction or removal activity counts only if it would not have occurred under a business-as-usual baseline without the incentive of credit revenue. Demonstrating additionality requires showing that the project faces financial, regulatory, or technical barriers it overcomes specifically because of the credit mechanism. It is the key integrity test that separates credible carbon credits from those representing reductions that would have happened anyway."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:carbon-accounting ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:verification ],
        ngm:carbon-markets ;
    vc:bridgesTo ngm:climate-finance ;
    vc:contrastsWith ngm:greenwashing ;
    vc:dependsOn ngm:carbon-accounting ;
    vc:enables ngm:carbon-credits,
        ngm:carbon-offset ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:carbon-markets ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:carbon-footprint,
        ngm:carbon-offset,
        ngm:esg,
        ngm:sustainable-finance ;
    vc:requires ngm:carbon-accounting,
        ngm:verification ;
    vc:slug "additionality" ;
    vc:sourceDomain "finance" ;
    vc:standardizedBy ngm:paris-agreement ;
    vc:supports ngm:net-zero ;
    vc:uses ngm:audit .

ngm:adjacency-matrix a owl:Class ;
    rdfs:label "Adjacency Matrix"@en ;
    rdfs:comment "An adjacency matrix is a square matrix representation of a graph in which the entry at row i and column j records whether, or how strongly, vertex i is connected to vertex j. For a graph of n vertices it is an n-by-n matrix, symmetric for undirected graphs and potentially weighted to encode edge costs. It is a foundational data structure for graph algorithms, spectral analysis and graph neural networks."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:graph-theory ],
        ngm:graph-representation ;
    vc:bridgesTo ngm:graph-neural-network ;
    vc:contrastsWith ngm:sparse-matrix ;
    vc:dependsOn ngm:linear-algebra ;
    vc:enables ngm:graph-neural-network,
        ngm:network-analysis ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:implements ngm:graph-representation ;
    vc:isPartOf ngm:graph-theory ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:network-analysis,
        ngm:sparse-matrix ;
    vc:requires ngm:graph-theory ;
    vc:slug "adjacency-matrix" ;
    vc:sourceDomain "data" ;
    vc:supports ngm:pagerank,
        ngm:shortest-path ;
    vc:uses ngm:linear-algebra,
        ngm:matrix .

ngm:aerial-robot a owl:Class ;
    rdfs:label "Aerial Robot"@en ;
    rdfs:comment "Aerial Robot - An autonomous or remotely operated aircraft equipped with Sensors, Actuators, and Navigation Systems for performing surveillance, inspection, delivery, and environmental monitoring tasks in three-dimensional airspace with minimal human intervention."@en ;
