artificial-intelligence:LogicProgramming rdf:type owl:Class ;
    rdfs:subClassOf artificial-intelligence:ArtificialIntelligence ;
    rdfs:label "Logic Programming"@en ;
    rdfs:comment "Programming paradigm based on formal logic, where programs are expressed as sets of logical statements and inference rules."@en ;
