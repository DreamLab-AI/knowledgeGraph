    vc:contrastsWith ngm:sql ;
    vc:enables ngm:federated-query ;
    vc:enables ngm:knowledge-graph-construction ;
    vc:enables ngm:linked-data ;
    vc:enables ngm:ontology ;
    vc:hasMaturity ngmi:maturity-draft ;
