ngm:membership-inference a owl:Class ;
    rdfs:label "Membership Inference"@en ;
    rdfs:comment "A privacy attack that determines wher a specific data point was included in a model's training dataset by analyzing the model's behavior on that input, potentially revealing sensitive information about individuals' participation in datasets."@en ;
