ngm:metadata-catalog a owl:Class ;
    rdfs:comment "A metadata catalog is a centralised, searchable inventory of an organisation's data assets and their descriptive, technical, operational, and business metadata. It records schemas, locations, ownership, lineage, classifications, and usage, enabling users to discover, understand, trust, and govern data. By unifying metadata across heterogeneous stores, it underpins data discovery, governance, and self-service analytics."@en ;
    rdfs:label "Metadata Catalog"@en ;
    rdfs:subClassOf ngm:data-catalog ;
