ngm:custody-infrastructure a owl:Class ;
    rdfs:label "Custody Infrastructure"@en ;
    rdfs:comment "Custody infrastructure refers to the integrated technological, operational, and regulatory systems that enable the secure holding, management, and transfer of digital assets on behalf of third parties. It encompasses hardware security modules (HSMs), multi-signature and multi-party computation (MPC) key management schemes, cold and warm storage tiers, policy engines, and compliance workflows that satisfy fiduciary and regulatory obligations. As the institutional-grade equivalent of a traditional custodian bank applied to blockchain-native assets, custody infrastructure underpins every regulated digital asset vehicle—from spot ETFs to tokenised real-world assets. Its design must simultaneously satisfy cryptographic security requirements, operational resilience, regulatory auditability, and the settlement latency demands of professional financial markets."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:multi-party-computation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:threshold-signature-scheme ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:policy-engine ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:regulatory-compliance ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:multi-signature ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:key-management-system ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:hardware-security-module ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:cold-storage ],
        ngm:custody ;
