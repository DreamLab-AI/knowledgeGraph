            owl:someValuesFrom ngm:uri-canonicaliser ],
        ngm:data-layer,
        ngm:infra-data-management ;
    skos:broader ngm:infra-data-management ;
    vc:enables ngm:cross-system-querying,
        ngm:knowledge-graph-integration,
        ngm:linked-data-consumption,
        ngm:semantic-federation ;
    vc:hasMaturity ngmi:maturity-established ;
