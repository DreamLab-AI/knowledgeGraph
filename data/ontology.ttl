ngm:mobile-manipulator a owl:Class ;
    rdfs:label "Mobile Manipulator"@en ;
    rdfs:comment "A Mobile Manipulator is a robotic system that integrates a mobile base — wheeled, legged, or tracked — with one or more articulated manipulator arms, enabling it to navigate through unstructured environments and perform dexterous manipulation tasks at arbitrary locations. This combination resolves the fundamental trade-off between workspace reach and precision, making mobile manipulators suitable for logistics, inspection, surgery assistance, and domestic service applications. Effective operation requires tight coordination between navigation, motion planning, perception, and manipulation subsystems."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:mobile-robot ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:motion-planning ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:end-effector ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:manipulator-arm ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:path-planning ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:sensor-fusion ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:perception-system ],
        ngm:hybrid-robot,
        ngm:robo-robot-type ;
    skos:broader ngm:robo-robot-type ;
    vc:enables ngm:autonomous-navigation,
        ngm:manipulation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:end-effector,
        ngm:manipulator-arm,
        ngm:mobile-robot ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:autonomous-robot,
        ngm:humanoid-robot,
        ngm:wheeled-mobile-robot ;
    vc:requires ngm:motion-planning,
        ngm:path-planning,
        ngm:perception-system,
        ngm:sensor-fusion ;
    vc:slug "mobile-manipulator" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:robot-control,
        ngm:slam .

