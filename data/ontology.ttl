            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:agent-memory ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:tool-registry ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:kv-cache ],
        ngm:agent-harness,
