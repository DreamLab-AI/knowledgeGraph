ngm:ambient-awareness a owl:Class ;
    rdfs:label "Ambient Awareness"@en ;
    rdfs:comment "Ambient Awareness is the peripheral, low-effort sense of others' presence, activity, and availability that collaborative systems convey through subtle continuous signals rather than explicit notifications. It is realized through presence indicators, status cues, activity streams, and spatial audio in shared digital workspaces. By keeping collaborators loosely informed of each other's context, it supports coordination and a feeling of co-location in distributed teams."@en ;
    rdfs:subClassOf ngm:dc-telepresence ;
    skos:broader ngm:dc-telepresence ;
