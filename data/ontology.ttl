    vc:qualityScore "0.35"^^xsd:float ;
    vc:slug "hardware-component" ;
    vc:sourceDomain "spatial-computing" .

ngm:high-risk-ai-system a owl:Class ;
    rdfs:label "High Risk AI System"@en ;
    rdfs:comment "An AI system classified as presenting significant risk to health, safety, fundamental rights, or other critical interests based on its intended purpose, deployment context, and potential for substantial adverse impact, subject to stringent regulatory requirements under the EU AI Act and similar f..."@en ;
    rdfs:subClassOf ngm:ai-governance-and-ethics ;
    skos:broader ngm:ai-governance-and-ethics ;
