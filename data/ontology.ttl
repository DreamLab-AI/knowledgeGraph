ngm:xr-content-delivery a owl:Class ;
    rdfs:comment "XR Content Delivery is the distribution of extended-reality assets, including 3D models, textures, spatial audio, and streamed scenes, to headsets and mobile devices with the low latency and high bandwidth that immersive rendering requires. It builds on content-delivery-network infrastructure but adds XR-specific concerns such as adaptive level-of-detail streaming and foveated compression. Reliable delivery is a precondition for responsive, motion-sickness-free XR experiences."@en ;
    rdfs:label "XR Content Delivery"@en ;
    rdfs:subClassOf ngm:cdn ;
    vc:hasMaturity ngmi:maturity-emerging ;
