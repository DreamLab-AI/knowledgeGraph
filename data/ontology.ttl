artificial-intelligence:ETSI_Domain_Governance___Society rdf:type owl:Class ;
    rdfs:label "ETSI_Domain_Governance___Society"@en ;
    rdfs:comment "An ETSI governance domain addressing societal impacts, inclusion, community wellbeing, and cultural considerations for metaverse and digital infrastructure. This domain ensures Social Equity, Community Participation, Accessibility Standards, and Cultural Respect in technology governance."@en ;
