        ngm:ontology,
        ngm:structured-data,
        ngm:verifiable-credentials ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:implements ngm:linked-data,
        ngm:rdf,
        ngm:semantic-web-linked-data-standard ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:activity-pub,
        ngm:owl,
        ngm:shacl,
        ngm:sparql ;
    vc:requires ngm:iri,
        ngm:json-data-interchange-format ;
    vc:slug "json-ld" ;
    vc:sourceDomain "data" ;
    vc:standardizedBy ngm:w3c ;
    vc:uses ngm:n-quads,
        ngm:schema-org .

