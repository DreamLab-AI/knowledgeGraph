ngm:affective-computing a owl:Class ;
    rdfs:label "Affective Computing"@en ;
    rdfs:comment "Affective computing is a branch of artificial intelligence and human-computer interaction concerned with systems that can recognise, interpret, process, and simulate human emotions and affective states. It draws on psychology, cognitive science, and machine learning to endow machines with emotional intelligence, enabling them to adapt their behaviour in response to detected user affect. The field encompasses technologies for emotion detection from facial expressions, speech, physiological signals, and body language, as well as methods for generating emotionally congruent responses. Foundational work by Rosalind Picard at MIT established that recognising and appropriately responding to affect is essential for natural, effective human-machine communication."@en ;
    rdfs:subClassOf ngm:human-computer-interaction ;
    vc:bridgesTo ngm:autonomous-vehicle,
        ngm:digital-health,
        ngm:extended-reality ;
    vc:contrastsWith ngm:rational-agent,
        ngm:symbolic-ai ;
    vc:dependsOn ngm:data-labelling,
        ngm:machine-learning ;
    vc:enables ngm:adaptive-learning-system,
        ngm:cognitive-feedback-interface,
        ngm:emotion-aware-interaction,
        ngm:emotional-analytics-engine,
        ngm:mental-health-monitoring ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:biometric-sensing,
        ngm:cognitive-science,
        ngm:emotional-intelligence,
        ngm:user-experience-design,
        ngm:wearable-computing ;
    vc:requires ngm:annotated-dataset,
        ngm:emotion-recognition,
        ngm:multimodal-fusion ;
    vc:slug "affective-computing" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:computer-vision,
        ngm:convolutional-neural-network,
        ngm:deep-learning,
        ngm:natural-language-processing,
        ngm:physiological-signal-processing,
        ngm:sentiment-analysis,
        ngm:speech-recognition .

ngm:agent-based-modelling a owl:Class ;
    rdfs:label "Agent-Based Modelling"@en ;
    rdfs:comment "Agent-based modelling (ABM) is a computational simulation methodology in which a system is represented as a collection of autonomous, heterogeneous agents that each follow local behavioural rules and interact with one another and with their environment. The global dynamics of interest — such as market prices, epidemic spread, or traffic congestion — emerge from these micro-level interactions rather than being specified analytically. ABM bridges individual behaviour and system-level phenomena, making it particularly powerful for studying complex adaptive systems where aggregate equations cannot capture heterogeneity or non-linear feedback loops. The approach is distinct from equation-based modelling in that agents are discrete, can differ individually, and can adapt their strategies through reinforcement or learning mechanisms."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:simulation ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:emergence ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:autonomous-agent ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:environment-model ],
        ngm:simulation ;
    vc:bridgesTo ngm:digital-twin,
        ngm:multi-agent-systems,
        ngm:swarm-intelligence ;
    vc:contrastsWith ngm:equation-based-modelling,
        ngm:system-dynamics ;
    vc:dependsOn ngm:computational-modelling,
        ngm:stochastic-process ;
    vc:enables ngm:crowd-simulation,
        ngm:epidemiological-modelling,
        ngm:innovation-diffusion,
        ngm:supply-chain-optimisation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:autonomous-agent,
        ngm:emergence,
        ngm:environment-model ;
    vc:implements ngm:complex-adaptive-systems ;
    vc:isPartOf ngm:complex-systems-science ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:game-theory,
        ngm:network-science,
        ngm:social-simulation ;
    vc:requires ngm:discrete-event-simulation,
        ngm:simulation ;
    vc:slug "agent-based-modelling" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:economic-model,
        ngm:policy-simulation ;
    vc:uses ngm:cellular-automata,
        ngm:monte-carlo-simulation,
