    a owl:Restriction ;
    owl:onProperty ngm:requires ;
    owl:someValuesFrom mv:Blockchain
] .

bc:NonFungibleToken rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:requires ;
    owl:someValuesFrom mv:SmartContract
] .

bc:NonFungibleToken rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:requires ;
    owl:someValuesFrom mv:TokenMetadata
] .

bc:NonFungibleToken rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:requires ;
    owl:someValuesFrom mv:DigitalWallet
] .

bc:NonFungibleToken rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:dependsOn ;
    owl:someValuesFrom mv:TokenStandard
] .

bc:NonFungibleToken rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:dependsOn ;
