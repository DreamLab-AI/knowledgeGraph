ngm:robotic-manipulation a owl:Class ;
    rdfs:label "Robotic Manipulation"@en ;
    rdfs:comment "Robotic manipulation is the field concerned with how robots physically interact with and change the state of objects in their environment — grasping, moving, assembling, and reorienting items using arms, hands, and end-effectors. It integrates perception, motion planning, control, and contact reasoning so that a robot can compute and execute the forces and trajectories needed to handle objects reliably under uncertainty. Manipulation spans rigid pick-and-place in structured factories through to dexterous, contact-rich handling of deformable or unfamiliar objects in unstructured human environments."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:grasp-planning ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:inverse-kinematics ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:motion-planning ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:end-effector ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:perception ],
        ngm:manipulation ;
    vc:bridgesTo ngm:perception ;
    vc:dependsOn ngm:robot ;
    vc:enables ngm:pick-and-place,
        ngm:robotic-grasping ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:end-effector,
        ngm:grasp-planning ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:reinforcement-learning ;
    vc:requires ngm:inverse-kinematics,
        ngm:motion-planning,
        ngm:perception ;
    vc:slug "robotic-manipulation" ;
    vc:sourceDomain "robotics" ;
    vc:supports ngm:autonomous-robot,
        ngm:industrial-robot ;
    vc:uses ngm:force-control,
        ngm:tactile-sensing .

ngm:roc-curve a owl:Class ;
    rdfs:label "ROC Curve"@en ;
    rdfs:comment "A graphical performance evaluation tool for binary classification models that plots the True Positive Rate (Recall/Sensitivity) against the False Positive Rate across all possible classification thresholds, visualising the trade-off between correctly identifying positive instances and incorrectly classifying negative instances as positive, enabling threshold selection, model comparison, and assessment of a classifier's discriminative ability independent of class distribution or threshold choice."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:true-positive-rate ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:classification ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:confusion-matrix ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:auc ],
        ngm:model-performance ;
    vc:bridgesTo ngm:clinical-decision-support,
        ngm:fraud-detection,
        ngm:medical-diagnosis-ai ;
    vc:contrastsWith ngm:accuracy,
        ngm:precision-recall-curve ;
    vc:dependsOn ngm:classification-threshold,
        ngm:sensitivity,
        ngm:specificity ;
    vc:enables ngm:classifier-evaluation,
        ngm:model-comparison,
        ngm:threshold-selection ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:auc,
        ngm:false-positive-rate,
        ngm:true-positive-rate ;
    vc:isPartOf ngm:model-evaluation ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:cross-validation,
        ngm:f1-score,
        ngm:model-calibration ;
    vc:requires ngm:classification,
        ngm:confusion-matrix ;
    vc:slug "roc-curve" ;
    vc:sourceDomain "machine-learning" ;
    vc:supports ngm:imbalanced-classification,
        ngm:model-selection .

ngm:root-cause-analysis a owl:Class ;
    rdfs:label "Root Cause Analysis"@en ;
    rdfs:comment "Root cause analysis (RCA) is a structured problem-solving discipline that identifies the underlying origin of a fault, failure, or incident rather than merely treating its visible symptoms. In infrastructure and reliability engineering it traces a chain of contributing causes back to the conditions that, if corrected, would have prevented the event. RCA produces durable, systemic fixes and feeds learning back into operational practice."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:observability ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:telemetry ],
        ngm:incident-management ;
    vc:contrastsWith ngm:incident-reporting ;
    vc:enables ngm:incident-reporting,
        ngm:site-reliability-engineering ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:incident-management,
        ngm:post-incident-review ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:anomaly-detection,
        ngm:real-time-monitoring,
        ngm:service-level-objective ;
    vc:requires ngm:observability,
        ngm:telemetry ;
    vc:slug "root-cause-analysis" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:devops ;
    vc:uses ngm:audit-trail,
        ngm:distributed-tracing,
        ngm:fault-tree-analysis,
        ngm:five-whys .

ngm:ros-2 a owl:Class ;
    rdfs:label "ROS 2"@en ;
    rdfs:comment "ROS 2 (Robot Operating System 2) is an open-source robotics middleware framework developed by Open Robotics that provides a standardised publish-subscribe communication layer built on the DDS (Data Distribution Service) standard, along with a comprehensive ecosystem of drivers, libraries, and tools for sensor integration, motion planning, simulation, and hardware abstraction. ROS 2 supersedes ROS 1 with support for real-time execution, multi-robot systems, production-grade security via DDS-Security, and native Windows and macOS compatibility. It has become the de facto standard software framework for research and increasingly for commercial robotic platforms."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:nav2 ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:move-it-2 ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:quality-of-service ],
        ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:bridgesTo ngm:autonomous-vehicle,
        ngm:industrial-automation,
        ngm:middleware ;
    vc:contrastsWith ngm:ros ;
    vc:enables ngm:autonomous-navigation,
        ngm:motion-planning,
        ngm:multi-robot-systems,
        ngm:real-time-control,
        ngm:robot-control,
        ngm:sensor-fusion ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:move-it-2,
        ngm:nav2,
        ngm:ros2-control ;
    vc:implements ngm:hardware-abstraction-layer,
