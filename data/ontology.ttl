ngm:entity a owl:Class ;
    rdfs:label "Entity"@en ;
    rdfs:comment "An Entity is a discrete, identifiable object or agent within an AI system, simulation, or knowledge model—possessing attributes, state, and potentially the capacity for autonomous action. In multi-agent and knowledge-graph contexts, entities are the primary nodes that bear properties, participate in relations, and serve as the subjects and objects of reasoning; in simulation and digital-twin contexts, they represent physical or virtual objects whose behaviour is modelled and tracked over time."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:autonomous-system ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:unique-identifier ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:schema ],
        ngm:knowledge-representation ;
    vc:bridgesTo ngm:autonomous-robot,
        ngm:decentralised-identifier,
        ngm:digital-twin,
        ngm:smart-contract ;
    vc:contrastsWith ngm:property,
        ngm:relation ;
    vc:dependsOn ngm:knowledge-graph,
        ngm:rdf ;
    vc:enables ngm:agentic-ai,
        ngm:multi-agent-systems,
        ngm:semantic-reasoning-engine,
        ngm:situational-awareness ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:autonomous-system,
        ngm:state ;
    vc:isPartOf ngm:ontology,
        ngm:world-model ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:agent,
        ngm:autonomous-agent,
        ngm:knowledge-representation,
        ngm:simulation ;
    vc:requires ngm:schema,
        ngm:unique-identifier ;
    vc:slug "entity" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:embodied-ai,
        ngm:lifecycle-management,
        ngm:provenance .

ngm:environmental-accounting a owl:Class ;
    rdfs:label "Environmental Accounting"@en ;
    rdfs:comment "A systematic framework for measuring, tracking, and reporting the environmental costs and impacts associated with economic activities, extending traditional financial accounting to incorporate natural capital, carbon emissions, resource consumption, and waste generation. Environmental accounting supports sustainability reporting, regulatory compliance, and circular economy transitions."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:material-flow-analysis ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:carbon-accounting ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:life-cycle-assessment ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:environmental-impact-metric ],
        ngm:sustainability-reporting ;
    vc:bridgesTo ngm:blockchain-provenance,
        ngm:supply-chain-transparency ;
    vc:contrastsWith ngm:traditional-finance ;
    vc:dependsOn ngm:data-governance ;
    vc:enables ngm:environmental-sustainability,
        ngm:esg-reporting,
        ngm:regulatory-compliance,
        ngm:sustainability-reporting ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:carbon-accounting,
        ngm:ecosystem-services-accounting,
        ngm:natural-capital-valuation ;
    vc:implements ngm:gri-standards ;
    vc:isPartOf ngm:corporate-sustainability-reporting,
        ngm:national-accounts ;
    vc:qualityScore "0.68"^^xsd:float ;
