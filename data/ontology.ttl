            owl:someValuesFrom ngm:dijkstra-algorithm ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:localization ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:rrt-algorithm ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:slam ],
        ngm:robo-navigation-and-planning ;
    skos:broader ngm:robo-navigation-and-planning ;
    vc:enables ngm:autonomous-navigation,
        ngm:autonomous-robot ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:dijkstra-algorithm,
        ngm:graph-search,
