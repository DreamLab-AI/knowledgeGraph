ngm:logical-clock a skos:Concept ;
    rdfs:label "Logical Clock"@en .

ngm:logistics-management a owl:Class ;
    rdfs:label "Logistics Management"@en ;
    rdfs:comment "Logistics management is the planning, execution, and control of the movement and storage of goods, services, and related information across a supply chain. It coordinates transportation, warehousing, inventory, order fulfilment, and reverse flows to meet demand at minimal cost and time. Effective logistics management directly determines service levels, working-capital efficiency, and resilience."@en ;
    rdfs:subClassOf ngm:economic-mechanism ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:cold-chain-monitoring,
        ngm:reverse-logistics ;
    vc:slug "logistics-management" ;
    vc:sourceDomain "supply-chain" .

ngm:logistics-optimisation a owl:Class ;
    rdfs:label "Logistics Optimisation"@en ;
    rdfs:comment "Logistics optimisation is the application of mathematical optimisation and operations-research techniques to minimise cost or time across logistics operations such as routing, scheduling, and inventory placement. It formulates problems like vehicle routing, network flow, and bin packing, often solved with linear programming, heuristics, or machine learning. The goal is to extract maximal efficiency from constrained transport and storage resources."@en ;
    rdfs:subClassOf ngm:optimisation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:customs-trade-facilitation,
        ngm:demand-forecasting ;
    vc:slug "logistics-optimisation" ;
    vc:sourceDomain "supply-chain" .

ngm:long-range-navigation a owl:Class ;
    rdfs:label "Long-Range Navigation"@en ;
    rdfs:comment "Long-range navigation is the capability of an autonomous agent to plan and execute travel over large distances and extended time horizons, beyond the range of local sensors. It typically fuses global positioning, topological or metric maps, and waypoint planning to maintain a coherent route across kilometre-scale or larger environments. It contrasts with short-range reactive navigation by emphasising global consistency and goal-directed path planning."@en ;
    rdfs:subClassOf ngm:robo-navigation-and-planning ;
    skos:broader ngm:robo-navigation-and-planning ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:gps,
        ngm:topological-map ;
    vc:slug "long-range-navigation" ;
    vc:sourceDomain "robotics" .

ngm:long-short-term-memory a owl:Class ;
    rdfs:label "Long Short Term Memory"@en ;
    rdfs:comment "Long Short-Term Memory (LSTM) is a specialised recurrent neural network architecture introduced by Hochreiter and Schmidhuber (1997) that mitigates the vanishing gradient problem through gating mechanisms—input, forget, and output gates—enabling selective retention or forgetting of information across long sequences. LSTMs underpin sequence modelling tasks in natural language processing, time-series forecasting, and speech recognition, though they have largely been superseded by Transformer architectures for large-scale language tasks."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:deep-learning ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:backpropagation ],
        ngm:ai-model-architecture,
        ngm:recurrent-neural-network ;
    skos:broader ngm:ai-model-architecture ;
    vc:contrastsWith ngm:attention,
        ngm:transformer ;
    vc:enables ngm:natural-language-processing ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:ai-model-architecture,
        ngm:recurrent-neural-network ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires ngm:backpropagation,
        ngm:deep-learning ;
    vc:slug "long-short-term-memory" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:long-term-archival a owl:Class ;
    rdfs:label "Long Term Archival"@en ;
    rdfs:comment "Strategies and technologies for preserving digital assets, metaverse content, and cultural heritage data over extended periods (10+ years), using durable storage media, format migration protocols, and AI-enhanced preservation systems."@en ;
    rdfs:subClassOf ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:bridgesTo ngm:digital-preservation ;
    vc:enables ngm:future-asset-access ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:slug "long-term-archival" ;
    vc:sourceDomain "spatial-computing" .

ngm:long-term-preservation a owl:Class ;
    rdfs:label "Long-Term Preservation"@en ;
    rdfs:comment "Long-term preservation is the set of policies, strategies, and technical practices that ensure digital assets, records, and information objects remain accessible, authentic, and usable across decades or centuries. It encompasses format migration, bit-level integrity monitoring, metadata stewardship, and provenance documentation to guard against technological obsolescence, media decay, and institutional discontinuity. The field draws on archival science, information management, and computer science to maintain the evidential and informational value of materials well beyond the lifespan of their originating systems. Standards such as OAIS (ISO 14721) provide reference models that underpin most compliant preservation programmes."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-format-standard ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:content-addressed-storage ],
        ngm:digital-preservation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:archival-standards,
        ngm:data-integrity,
        ngm:metadata-standard ;
    vc:requires ngm:content-addressed-storage,
        ngm:data-format-standard ;
    vc:slug "long-term-preservation" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:cultural-heritage-preservation,
        ngm:long-term-archival ;
    vc:uses ngm:archival-node,
        ngm:digital-archive .

