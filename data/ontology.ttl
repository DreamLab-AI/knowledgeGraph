ngm:etsi-domain-ethics-and-law a owl:Class ;
    rdfs:label "ETSI Domain: Ethics & Law"@en ;
    rdfs:comment "Domain marker for ETSI metaverse categorisation covering ical frameworks, legal compliance, regulatory requirements, and responsible governance structures for virtual environments."@en ;
