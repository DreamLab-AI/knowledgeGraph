ngm:nash-equilibrium a owl:Class ;
    rdfs:label "Nash Equilibrium"@en ;
    rdfs:comment "A Nash equilibrium is a solution concept in game theory describing a profile of strategies, one for each player, such that no player can increase their own payoff by unilaterally changing strategy while the others hold theirs fixed. It captures a stable state of mutual best responses and may be in pure or mixed strategies. Nash proved that every finite game has at least one such equilibrium, making it the central predictive concept for strategic interaction among rational agents."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:mechanism-design ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:game-theory ],
        ngm:game-theory ;
    vc:bridgesTo ngm:artificial-intelligence ;
    vc:contrastsWith ngm:cooperative-game-theory ;
    vc:dependsOn ngm:game-theory ;
    vc:enables ngm:mechanism-design ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:mechanism-design ;
    vc:implements ngm:game-theory ;
    vc:isPartOf ngm:game-theory ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:cooperative-game-theory,
        ngm:mechanism-design ;
    vc:requires ngm:game-theory ;
    vc:slug "nash-equilibrium" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:standardizedBy ngm:game-theory ;
    vc:supports ngm:auction-theory ;
    vc:uses ngm:game-theory .

ngm:national-security a owl:Class ;
    rdfs:label "National Security"@en ;
    rdfs:comment "National Security denotes the capacity of a state to protect its citizens, institutions, territorial integrity, and critical interests from foreign and domestic threats spanning military conflict, espionage, terrorism, cyber attack, and economic coercion. It encompasses both hard-power capabilities (armed forces, intelligence agencies, border controls) and soft-power instruments (diplomacy, economic policy, information operations). Modern national security doctrine incorporates cyber resilience, supply-chain integrity, energy security, and AI competitiveness as dimensions of strategic concern. Governance frameworks such as security councils, export-control regimes, and classified classification schemes operationalise national security policy."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:national-competent-authority ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:policy ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:cybersecurity-standard ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:governance ],
        ngm:policy ;
    vc:bridgesTo ngm:economic-governance,
        ngm:national-competitiveness ;
    vc:contrastsWith ngm:social-contract ;
    vc:dependsOn ngm:policy-framework ;
    vc:enables ngm:cyber-security-and-military,
        ngm:economic-security ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:cybersecurity-standard,
        ngm:national-competent-authority ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:cybersecurity,
        ngm:cybersecurity-policy,
        ngm:national-ai-strategy ;
    vc:requires ngm:governance,
        ngm:policy ;
    vc:slug "national-security" ;
    vc:sourceDomain "governance" ;
    vc:supports ngm:cyber-resilience,
        ngm:cybersecurity-framework,
        ngm:information-security .

ngm:navigation-mesh a owl:Class ;
    rdfs:label "Navigation Mesh"@en ;
    rdfs:comment "A navigation mesh (navmesh) is a data structure that decomposes the traversable area of a virtual environment into a set of convex polygons over which an agent can move freely. By abstracting walkable space into connected regions, it enables efficient pathfinding without searching a dense uniform grid. Navmeshes are the standard representation for movement and obstacle avoidance in game AI and simulated 3D worlds."@en ;
    rdfs:subClassOf ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:ai-game-agent,
        ngm:ai-in-games ;
    vc:slug "navigation-mesh" ;
    vc:sourceDomain "ai" .

ngm:net-neutrality a owl:Class ;
    rdfs:label "Net Neutrality"@en ;
    rdfs:comment "Net neutrality is the principle that internet service providers should treat all data traversing their networks equally, without discriminating, blocking, throttling, or charging differentially based on the source, destination, application, or content of that traffic. It aims to preserve an open internet where users and content providers compete on merit rather than on access deals. Net neutrality is enforced or challenged through telecommunications regulation and is a recurring subject of internet-governance policy."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:regulation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:telecommunications ],
        ngm:internet-governance ;
    vc:bridgesTo ngm:governance ;
    vc:contrastsWith ngm:deregulation ;
    vc:dependsOn ngm:policy,
        ngm:regulatory-compliance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:digital-governance,
        ngm:internet-governance ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:bandwidth,
        ngm:content-delivery,
        ngm:digital-regulation,
        ngm:governance-framework ;
    vc:requires ngm:regulation,
        ngm:telecommunications ;
    vc:slug "net-neutrality" ;
    vc:sourceDomain "governance" ;
    vc:supports ngm:transparency .

ngm:network-fabric a skos:Concept ;
    rdfs:label "Network Fabric"@en .

ngm:network-quality-metric a owl:Class ;
    rdfs:label "Network Quality Metric"@en ;
    rdfs:comment "A quantitative measure used to characterise the performance and reliability of a network connection for real-time interactive applications, encompassing parameters such as latency (round-trip time), jitter, packet loss rate, available bandwidth, and connection stability. These metrics directly determine the feasibility of synchronised multi-user experiences in spatial computing environments."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:networking-technology ],
        ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:distributed-system ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:edge-computing,
        ngm:latency ;
    vc:requires ngm:networking-technology ;
    vc:slug "network-quality-metric" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:multi-user-systems,
        ngm:real-time .

ngm:network-science a owl:Class ;
    rdfs:label "Network Science"@en ;
    rdfs:comment "Network science is the interdisciplinary study of complex systems represented as graphs of nodes and edges, focusing on the structure, dynamics, and function of connections. It develops models and metrics, such as degree distributions, centrality, community structure, and small-world properties, to explain how topology shapes behaviour. It is applied across social, biological, technological, and economic networks."@en ;
    rdfs:subClassOf ngm:data-management ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:graph-database,
        ngm:social-network-analysis ;
    vc:slug "network-science" ;
    vc:sourceDomain "data" .

ngm:networking-layer a owl:Class ;
    rdfs:label "Networking Layer"@en ;
    rdfs:comment "Communication systems that connect components and users across distributed metaverse environments through network protocols and software."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:communication-protocol ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:network-protocol ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:physical-network-hardware ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:communication-software ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:network-standards ],
