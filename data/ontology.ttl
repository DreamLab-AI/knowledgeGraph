        ngm:lightning-network,
        ngm:smart-contract ;
    vc:contrastsWith ngm:shadow-banking ;
    vc:dependsOn ngm:blockchain-infrastructure,
        ngm:identity-and-access-management,
        ngm:regulatory-framework ;
    vc:enables ngm:cross-border-payments,
        ngm:monetary-policy,
        ngm:tokenization ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:central-bank-digital-currency,
        ngm:central-securities-depository,
        ngm:clearing-and-settlement,
