ngm:self-sovereign-identity-ssi a owl:Class ;
    rdfs:comment "Self-Sovereign Identity (SSI) is an identity model in which individuals control their own digital identifiers and credentials without dependence on a centralised issuing authority, using Decentralised Identifiers (DIDs) anchored to distributed ledgers and Verifiable Credentials signed by trusted issuers to enable selective disclosure. SSI shifts identity management from siloed service-provider accounts to portable, user-held credentials that can be verified without querying the original issuer."@en ;
    rdfs:label "Self-Sovereign Identity (SSI)"@en ;
    rdfs:subClassOf ngm:decentralized-identity ;
    vc:dependsOn ngm:privacy-preserving-identity ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:did-method ;
    vc:relatedTo ngm:hyperledger-indy ;
    vc:slug "self-sovereign-identity-ssi" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:decentralized-identifiers ;
    vc:uses ngm:verifiable-credentials .
ngm:self-sovereign-key-management a skos:Concept ;
    rdfs:label "Self Sovereign Key Management"@en .
ngm:self-supervised-learning a owl:Class ;
    rdfs:comment "Self-Supervised Learning (SSL) is a machine learning paradigm in which a model learns rich representations of data by solving pretext tasks whose supervisory signal is derived automatically from the input data itself, requiring no human-provided labels. The model learns to predict masked or hidden portions of an input, to match different views of the same data, or to distinguish positive from negative data pairs, developing features that transfer effectively to downstream supervised tasks with limited labelled data. Self-supervised learning has become the dominant pre-training strategy for large language models, visual foundation models, and multimodal systems, enabling training at scales that would be infeasible with manually annotated datasets."@en ;
    rdfs:label "Self-Supervised Learning"@en ;
    rdfs:subClassOf ngm:machine-learning-discipline-technique ;
    rdfs:subClassOf _:r19081 ;
    rdfs:subClassOf _:r19082 ;
