    vc:uses ngm:scratchpad-reasoning .
ngm:re-act-pattern a owl:Class ;
    rdfs:comment "ReAct (Reasoning and Acting) is a prompting and agent-control pattern in which a language model interleaves explicit reasoning traces with action steps such as tool calls, observing the results before reasoning again. This loop lets the model decompose tasks, gather information, and self-correct rather than answering in a single pass. It is a foundational design for tool-using LLM agents."@en ;
    rdfs:label "ReAct Pattern"@en ;
    rdfs:subClassOf ngm:ai-agent-system ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:agent-frameworks ;
    vc:relatedTo ngm:function-calling ;
    vc:slug "re-act-pattern" ;
    vc:sourceDomain "ai" .
ngm:re-identification-attack a skos:Concept ;
    rdfs:label "Re Identification Attack"@en .
ngm:re-lu-activation a owl:Class ;
    rdfs:comment "The Rectified Linear Unit (ReLU) is a nonlinear activation function defined as f(x) = max(0, x), outputting the input directly when positive and zero otherwise. Its simplicity, sparse activation, and non-saturating gradient for positive inputs make it the default activation in most deep neural networks, mitigating the vanishing-gradient problem. Variants such as Leaky ReLU and GELU address its dead-neuron limitation."@en ;
    rdfs:label "ReLU Activation"@en ;
    rdfs:subClassOf ngm:neural-network ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:fast-ai ;
    vc:relatedTo ngm:generative-adversarial-networks ;
    vc:slug "re-lu-activation" ;
    vc:sourceDomain "ai" .
ngm:reachability-analysis a skos:Concept ;
    rdfs:label "Reachability Analysis"@en .
ngm:react-prompting a owl:Class ;
    rdfs:comment "ReAct prompting is a prompting strategy that interleaves verbal reasoning traces with discrete actions, enabling a language model to think step by step while interacting with external tools or environments. The model alternates between generating a thought, taking an action such as a search or API call, and observing the result, then folding that observation back into subsequent reasoning. This synergy of reasoning and acting reduces hallucination and grounds the model's conclusions in retrieved evidence."@en ;
    rdfs:label "React Prompting"@en ;
    rdfs:subClassOf ngm:prompt-engineering ;
    rdfs:subClassOf _:r17680 ;
