    rdfs:label "DID Cheqd"@en .
ngm:did-controller a owl:Class ;
    rdfs:comment "The entity—person, organisation, or autonomous system—authorised to make changes to a DID document, as defined by the W3C DID Core specification. The DID controller proves its authority by controlling the cryptographic keys or verification methods designated in the DID document, and may be the DID subject itself (self-sovereign control), a guardian acting for a subject such as a child or an IoT device, or a set of parties sharing control. It is unrelated to the PID controller of control engineering, with which it shares only a surface string."@en ;
    rdfs:label "DID Controller"@en ;
    rdfs:subClassOf ngm:entity ;
    rdfs:subClassOf _:r6668 ;
    rdfs:subClassOf _:r6669 ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:decentralized-identifiers ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:decentralised-identity ;
    vc:relatedTo ngm:did-document ;
    vc:relatedTo ngm:digital-identity ;
    vc:requires ngm:cryptographic-key ;
    vc:requires ngm:key-management ;
    vc:slug "did-controller" ;
    vc:sourceDomain "security" .
ngm:did-document a owl:Class ;
    rdfs:comment "A DID Document is a JSON-LD resource resolved from a Decentralised Identifier (DID) that expresses the DID subject's cryptographic public keys, authentication methods, assertion methods, key agreement protocols, capability delegation mechanisms, and service endpoints. Defined by the W3C DID Core specification, a DID Document is the machine-readable artefact that enables any verifier to discover how to authenticate with or communicate securely to a DID subject without relying on a centralised identity authority. DID Documents are anchored to a Verifiable Data Registry — such as a distributed ledger, blockchain, or peer-to-peer network — via a DID method-specific read operation, making them a foundational component of self-sovereign identity and verifiable credential ecosystems."@en ;
    rdfs:label "DID Document"@en ;
    rdfs:subClassOf ngm:decentralised-identifier ;
    rdfs:subClassOf _:r6670 ;
    rdfs:subClassOf _:r6671 ;
    rdfs:subClassOf _:r6672 ;
    rdfs:subClassOf _:r6673 ;
    rdfs:subClassOf _:r6674 ;
