    vc:supports ngm:visualization-layer ;
    vc:uses ngm:data-analytics ;
    vc:uses ngm:data-visualisation .
ngm:risk-intensity-heatmap-regression a owl:Class ;
    rdfs:comment "Heatmap regression is a computer-vision technique for keypoint localisation in which a network predicts a 2D probability map per landmark rather than directly regressing coordinates. The peak of each predicted heatmap indicates the most likely location, and Gaussian-blurred ground-truth targets make training spatially smooth and robust. It is the dominant approach for human pose estimation and facial landmark detection."@en ;
    rdfs:label "Heatmap Regression"@en ;
    rdfs:subClassOf ngm:computer-vision ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:pose-estimation ;
    vc:slug "risk-intensity-heatmap-regression" ;
    vc:sourceDomain "ai" .
ngm:risk-internalisation a skos:Concept ;
    rdfs:label "Risk Internalisation"@en .
ngm:risk-management a owl:Class ;
    rdfs:comment "The coordinated activities to direct and control an AI system with regard to risk, encompassing risk identification, assessment, treatment, monitoring, and communication throughout the AI lifecycle to minimize potential adverse effects while maximizing benefits."@en ;
