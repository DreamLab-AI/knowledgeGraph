ngm:assistive-technology a owl:Class ;
    rdfs:comment "Assistive technology is equipment or software that helps people with disabilities perform tasks they would otherwise find difficult. Examples include screen readers, hearing aids and alternative input devices."@en ;
    rdfs:label "Assistive Technology"@en ;
    rdfs:subClassOf ngm:accessibility ;
