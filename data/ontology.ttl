        ngm:policy-engine ;
    vc:slug "authorisation" ;
    vc:sourceDomain "security" ;
    vc:standardizedBy ngm:iso-iec-27001,
        ngm:oauth2,
        ngm:openid-connect,
        ngm:xacml ;
    vc:uses ngm:access-token,
        ngm:compliance-framework,
        ngm:json-web-token,
        ngm:oauth2,
        ngm:open-policy-agent .

ngm:automatic-differentiation a owl:Class ;
    rdfs:label "Automatic Differentiation"@en ;
    rdfs:comment "Automatic differentiation (AD) is a family of computational techniques for evaluating the derivative of a function specified by a computer program, by systematically applying the chain rule to elementary arithmetic operations rather than through symbolic algebra or finite-difference approximation. It operates in two principal modes: forward mode, which propagates tangent values alongside primal values, and reverse mode (backpropagation), which accumulates gradients in a backward pass over a recorded computation graph. AD produces machine-precision derivatives at a cost linear in the number of program operations, making it the computational backbone of modern deep learning frameworks."@en ;
    rdfs:subClassOf ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:bridgesTo ngm:differentiable-rendering,
        ngm:robotics-control ;
    vc:contrastsWith ngm:numerical-differentiation,
        ngm:symbolic-differentiation ;
    vc:enables ngm:backpropagation,
        ngm:deep-learning,
        ngm:differentiable-programming,
        ngm:gradient-descent,
        ngm:neural-ordinary-differential-equation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:computation-graph,
        ngm:forward-mode-differentiation,
        ngm:reverse-mode-differentiation ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:just-in-time-compilation,
        ngm:loss-function,
        ngm:numerical-method,
        ngm:optimisation,
        ngm:stochastic-gradient-descent ;
    vc:requires ngm:chain-rule,
        ngm:elementary-arithmetic-operation ;
    vc:slug "automatic-differentiation" ;
    vc:sourceDomain "machine-learning" ;
    vc:supports ngm:physics-simulation,
        ngm:probabilistic-programming,
        ngm:scientific-machine-learning ;
    vc:uses ngm:machine-learning-framework,
        ngm:neural-network,
        ngm:vectorised-jacobian-product .

ngm:confusion-matrix a owl:Class ;
    rdfs:label "Confusion Matrix"@en ;
    rdfs:comment "A tabular visualisation and analytical tool summarising the performance of a classification model by displaying the counts or proportions of predictions cross-tabulated against actual class labels, typically organised with predicted classes as columns and actual classes as rows (or vice versa), enabling systematic analysis of where a model succeeds and fails, calculation of various performance metrics, and identification of specific confusion patterns between classes."@en ;
