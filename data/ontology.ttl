ngm:portability a owl:Class ;
    rdfs:label "Portability"@en ;
    rdfs:comment "The capability for seamless migration of digital assets, identities, and experiences across heterogeneous virtual platforms through standardised formats (glTF, USD), metadata schemas, and blockchain bridges—enabling users to transfer avatars, digital goods, and social connections without vendor lock-in."@en ;
