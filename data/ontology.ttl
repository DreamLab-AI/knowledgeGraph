ngm:knowledge-based-authentication a owl:Class ;
    rdfs:label "Knowledge Based Authentication"@en ;
    rdfs:comment "Knowledge-Based Authentication (KBA) verifies identity by challenging a user to supply information presumed known only to them, such as a password, PIN, or answers to security questions. Static KBA uses pre-registered secrets, while dynamic KBA generates questions from third-party records at challenge time. Because the underlying secrets can be guessed, phished, or harvested through social engineering, KBA is increasingly supplemented or replaced by possession- and biometric-based factors."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:password-authentication ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:password-authentication ],
        ngm:multi-factor-authentication ;
    vc:bridgesTo ngm:multi-factor-authentication ;
    vc:contrastsWith ngm:biometric-authentication,
        ngm:zero-trust ;
    vc:enables ngm:identity-verification ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:password-authentication ;
    vc:isPartOf ngm:security ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:access-control,
        ngm:biometric-authentication,
        ngm:social-engineering ;
    vc:requires ngm:password-authentication ;
    vc:slug "knowledge-based-authentication" ;
    vc:sourceDomain "security" ;
    vc:supports ngm:access-control ;
    vc:uses ngm:identity-verification .

ngm:knowledge-component-model a skos:Concept ;
    rdfs:label "Knowledge Component Model"@en .

ngm:knowledge-organization a owl:Class ;
    rdfs:label "Knowledge Organization"@en ;
    rdfs:comment "The systematic arrangement, classification, and representation of knowledge structures so that information can be discovered, related, and reasoned over. Knowledge organization encompasses taxonomies, thesauri, ontologies, and knowledge graphs, and underpins semantic search, question answering, and AI knowledge-base construction."@en ;
    rdfs:subClassOf ngm:ai-research-area ;
    skos:broader ngm:ai-research-area ;
    vc:enables ngm:information-retrieval,
        ngm:knowledge-representation ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:relatedTo ngm:knowledge-organization-system,
        ngm:linked-data ;
    vc:slug "knowledge-organization" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:knowledge-graph,
        ngm:ontology .

ngm:lang-graph a owl:Class ;
    rdfs:label "LangGraph"@en ;
    rdfs:comment "LangGraph is a library for building stateful, multi-step language model applications by representing control flow as a graph. It is part of the LangChain ecosystem and supports cyclic agent workflows."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:state-machine ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:language-model ],
        ngm:agentic-workflow ;
    vc:enables ngm:agentic-workflow,
        ngm:multi-agent-coordination ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:language-model,
        ngm:state-machine ;
    vc:slug "lang-graph" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:laplace-mechanism a skos:Concept ;
    rdfs:label "Laplace Mechanism"@en .

ngm:layer2 a owl:Class ;
    rdfs:label "Layer2"@en ;
    rdfs:comment "Secondary protocols built atop Layer 1 blockchains that process transactions off-chain or in parallel batches, then periodically commit aggregated state changes to the main chain. Layer 2 solutions achieve dramatically higher throughput, lower fees, and improved user experience while inheriting the security guarantees of the underlying base layer. Principal approaches include rollups (optimistic and ZK), state channels, and sidechains."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:lightning-network ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:layer2-scaling ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:sidechain ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:lightning-and-similar-l2 ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:state-channel ],
        ngm:bc-network-component,
        ngm:smart-contract-platform ;
    skos:broader ngm:bc-network-component ;
    vc:enables ngm:blockchain-interoperability,
        ngm:blockchain-scalability ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:layer2-scaling,
        ngm:lightning-and-similar-l2,
        ngm:lightning-network,
        ngm:sidechain,
        ngm:state-channel ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:cross-chain-messaging,
        ngm:transaction-confirmation ;
    vc:slug "layer2" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:cross-chain-bridge,
        ngm:smart-contract,
        ngm:zero-knowledge-proof .

ngm:layout-engine a owl:Class ;
    rdfs:label "Layout Engine"@en ;
    rdfs:comment "A layout engine is a software component that applies one or more layout algorithms to a model of visual elements and produces a concrete arrangement ready for rendering. It manages coordinate systems, constraint solving, sizing, and incremental relayout in response to data changes. Layout engines power diagram tools, document renderers, and graphical user interface frameworks."@en ;
    rdfs:subClassOf ngm:infra-software-engineering ;
    skos:broader ngm:infra-software-engineering ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:diagrams-as-code,
        ngm:layout-algorithm ;
    vc:slug "layout-engine" ;
    vc:sourceDomain "infrastructure" .

ngm:leaderboard a skos:Concept ;
    rdfs:label "Leaderboard"@en .

ngm:learning-from-demonstration a owl:Class ;
    rdfs:label "Learning from Demonstration"@en ;
    rdfs:comment "Learning from demonstration is an approach in which an agent acquires behaviour by observing examples performed by a teacher. It is used to bootstrap policies in robotics and control without hand-specified reward functions."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:imitation-learning ],
        ngm:imitation-learning ;
    vc:enables ngm:offline-reinforcement-learning ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:imitation-learning ;
    vc:slug "learning-from-demonstration" ;
    vc:sourceDomain "machine-learning" .

ngm:legal-expertise a owl:Class ;
    rdfs:label "Legal Expertise"@en ;
    rdfs:comment "Legal expertise is the specialised knowledge and professional judgement required to interpret statutes, regulations, contracts, and case law and to apply them to specific situations. In technology and blockchain settings it spans securities, data-protection, intellectual-property, and cross-border regulatory analysis. It is a prerequisite for designing compliant products and navigating multi-jurisdictional obligations."@en ;
    rdfs:subClassOf ngm:infra-legal-and-regulatory ;
    skos:broader ngm:infra-legal-and-regulatory ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:compliance-standards,
        ngm:cross-border-compliance ;
    vc:slug "legal-expertise" ;
    vc:sourceDomain "governance" .

ngm:legal-wrapper a owl:Class ;
    rdfs:label "Legal Wrapper"@en ;
    rdfs:comment "A legal wrapper is an off-chain legal entity, such as a foundation, LLC, or association, established to give a DAO or on-chain protocol recognised legal personality. It enables the organisation to enter contracts, hold assets, limit member liability, and interface with regulators while preserving on-chain governance. Jurisdictions like Wyoming (DAO LLC), the Marshall Islands, and the Cayman Islands offer purpose-built wrapper forms."@en ;
    rdfs:subClassOf ngm:bc-governance-and-regulation ;
    skos:broader ngm:bc-governance-and-regulation ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:dao-tooling,
        ngm:enterprise-token-standards ;
    vc:slug "legal-wrapper" ;
    vc:sourceDomain "governance" .

ngm:lei-system a owl:Class ;
    rdfs:label "LEI System"@en ;
    rdfs:comment "The LEI System is the Global Legal Entity Identifier System, a federated infrastructure overseen by the GLEIF that issues, maintains, and publishes Legal Entity Identifiers and their reference data. It comprises a Regulatory Oversight Committee, accredited Local Operating Units, and an open global directory queryable by anyone. The system provides a single authoritative source for identifying legal entities in financial markets."@en ;
    rdfs:subClassOf ngm:infra-legal-and-regulatory ;
    skos:broader ngm:infra-legal-and-regulatory ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:legal-entity-identifier,
        ngm:regulatory-reporting ;
    vc:slug "lei-system" ;
    vc:sourceDomain "governance" .

ngm:length-normalisation a skos:Concept ;
    rdfs:label "Length Normalisation"@en .

ngm:lens-protocol a owl:Class ;
    rdfs:label "Lens Protocol"@en ;
    rdfs:comment "Lens Protocol is a decentralised social networking protocol in which user profiles and social connections are represented as on-chain assets."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:decentralised-identity ],
        ngm:decentralised-identity ;
    vc:enables ngm:web3 ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:decentralised-identity ;
    vc:slug "lens-protocol" ;
    vc:sourceDomain "blockchain" .

ngm:lidar-sensor a owl:Class ;
    rdfs:label "LiDAR Sensor"@en ;
    rdfs:comment "A LiDAR sensor measures distance by emitting laser pulses and timing their reflections, producing dense 3D point clouds of the surrounding environment. Variants include mechanical spinning, solid-state, and flash designs that trade field of view, range, and cost. LiDAR is a cornerstone perception modality for autonomous robots, reality capture, and occupancy mapping."@en ;
    rdfs:subClassOf ngm:sensor ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:occupancy-grid,
        ngm:reality-capture-system ;
    vc:slug "lidar-sensor" ;
    vc:sourceDomain "robotics" .

ngm:lido-dao a owl:Class ;
    rdfs:label "Lido DAO"@en ;
    rdfs:comment "The decentralised organisation that governs the Lido liquid staking protocol, setting node operator policy, fees, and treasury decisions through token-holder voting."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:governance-token ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:treasury-management ],
        ngm:decentralised-autonomous-organisation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:governance-token,
        ngm:treasury-management ;
    vc:slug "lido-dao" ;
    vc:sourceDomain "blockchain" .

ngm:liquidation-mechanism a owl:Class ;
    rdfs:label "Liquidation Mechanism"@en ;
    rdfs:comment "A liquidation mechanism is the automated process by which a decentralised finance protocol seizes and sells a borrower's collateral once the value of that collateral falls below a defined threshold relative to the outstanding debt. It protects lenders and the protocol from undercollateralised positions by ensuring debt is repaid before collateral becomes insufficient. Liquidations are typically triggered by oracle price updates and executed by liquidators who are incentivised with a discount or bonus on the seized assets."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:smart-contract ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:price-oracle ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:over-collateralisation ],
        ngm:decentralised-finance ;
    vc:contrastsWith ngm:over-collateralisation ;
    vc:dependsOn ngm:price-oracle ;
    vc:enables ngm:lending-protocol,
        ngm:risk-management ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:risk-management ;
    vc:isPartOf ngm:lending-protocol ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:aave,
        ngm:decentralised-exchange,
        ngm:interest-rate ;
    vc:requires ngm:over-collateralisation,
        ngm:price-oracle,
        ngm:smart-contract ;
    vc:slug "liquidation-mechanism" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:liquidity,
        ngm:stablecoin ;
    vc:uses ngm:oracle,
        ngm:smart-contract .

ngm:live-captions a owl:Class ;
    rdfs:label "Live Captions"@en ;
    rdfs:comment "Live captions are automatically generated, real-time text transcriptions of spoken audio displayed synchronously during a video call or webinar. They enhance accessibility for participants with hearing impairments and support comprehension across language barriers and noisy environments. Powered by automatic speech recognition, they may be supplemented by human stenographers for high-accuracy requirements."@en ;
    rdfs:subClassOf ngm:dc-communication ;
    skos:broader ngm:dc-communication ;
    vc:enables ngm:accessibility ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:noise-suppression,
        ngm:webinar-broadcast ;
    vc:slug "live-captions" ;
    vc:sourceDomain "distributed-collaboration" .

ngm:lnp-bp-standards-association a owl:Class ;
    rdfs:label "LNP-BP Standards Association"@en ;
    rdfs:comment "The LNP-BP Standards Association is a non-profit body that develops and maintains specifications for Bitcoin and Lightning Network protocols, most notably the RGB smart-contract system and client-side validation. It curates the LNPBP specification series covering layer-2 and layer-3 constructs that extend Bitcoin without altering its base consensus. The association coordinates the engineers and researchers building these client-side-validated protocols."@en ;
    rdfs:subClassOf ngm:standards-body ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:btc-layer-3,
        ngm:rgb-and-client-side-validation ;
    vc:slug "lnp-bp-standards-association" ;
    vc:sourceDomain "blockchain" .

ngm:logistics-management a owl:Class ;
    rdfs:label "Logistics Management"@en ;
    rdfs:comment "Logistics management is the planning, execution, and control of the movement and storage of goods, services, and related information across a supply chain. It coordinates transportation, warehousing, inventory, order fulfilment, and reverse flows to meet demand at minimal cost and time. Effective logistics management directly determines service levels, working-capital efficiency, and resilience."@en ;
    rdfs:subClassOf ngm:economic-mechanism ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:cold-chain-monitoring,
        ngm:reverse-logistics ;
    vc:slug "logistics-management" ;
    vc:sourceDomain "supply-chain" .

ngm:long-horizon-planning a owl:Class ;
    rdfs:label "Long-Horizon Planning"@en ;
    rdfs:comment "Long-horizon planning is the problem of generating and executing sequences of actions over extended time horizons — spanning hundreds to thousands of steps — to achieve high-level goals that cannot be accomplished through simple reactive policies. It requires maintaining coherent goals, managing intermediate subgoal states, and adapting plans in response to environmental changes and unexpected outcomes."@en ;
    rdfs:subClassOf ngm:task-planning ;
    vc:enables ngm:agentic-workflow,
        ngm:llm-agents ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:multi-agent-system,
        ngm:path-planning,
        ngm:reinforcement-learning-for-robotics ;
    vc:slug "long-horizon-planning" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:large-language-models,
        ngm:reinforcement-learning .

ngm:long-range-dependency-modelling a owl:Class ;
    rdfs:label "Long Range Dependency Modelling"@en ;
    rdfs:comment "Long range dependency modelling is the capability of a sequence model to capture relationships between elements that are far apart in a sequence, such as tokens separated by thousands of positions. Recurrent architectures struggle with this because gradients vanish over long horizons, whereas attention mechanisms and structured state-space models provide direct or efficient paths between distant elements. Effective long range modelling is essential for tasks where context far from the current position determines the output."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:positional-encoding ],
        ngm:attention-mechanism ;
    vc:bridgesTo ngm:state-space-model ;
    vc:contrastsWith ngm:recurrent-neural-network ;
    vc:enables ngm:context-window ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:attention-mechanism ;
    vc:isPartOf ngm:attention-mechanism ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:attention-mechanism,
        ngm:state-space-model,
        ngm:transformer ;
    vc:requires ngm:positional-encoding ;
    vc:slug "long-range-dependency-modelling" ;
    vc:sourceDomain "machine-learning" ;
    vc:supports ngm:transformer ;
    vc:uses ngm:multi-head-attention,
        ngm:positional-encoding,
        ngm:self-attention .

ngm:long-term-archival a owl:Class ;
    rdfs:label "Long Term Archival"@en ;
    rdfs:comment "Strategies and technologies for preserving digital assets, metaverse content, and cultural heritage data over extended periods (10+ years), using durable storage media, format migration protocols, and AI-enhanced preservation systems."@en ;
    rdfs:subClassOf ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:bridgesTo ngm:digital-preservation ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:slug "long-term-archival" ;
    vc:sourceDomain "spatial-computing" .

ngm:loose-coupling a owl:Class ;
    rdfs:label "Loose Coupling"@en ;
    rdfs:comment "Loose coupling is a design principle in which components of a system depend on one another only through stable, minimal interfaces rather than internal implementation details, so that each can evolve, fail, or be replaced independently. It reduces the ripple effect of change, improves testability, and is foundational to scalable distributed and event-driven architectures. Loose coupling is typically achieved through abstraction, asynchronous messaging, and well-defined contracts."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:interface ],
        ngm:software-architecture ;
    vc:bridgesTo ngm:message-broker ;
    vc:contrastsWith ngm:coupling ;
    vc:enables ngm:fault-tolerance,
        ngm:microservices,
        ngm:scalability ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:software-architecture ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:distributed-systems,
        ngm:resilience ;
    vc:requires ngm:interface ;
    vc:slug "loose-coupling" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:api-gateway,
        ngm:event-driven-architecture,
        ngm:service-mesh ;
    vc:uses ngm:asynchronous-messaging,
        ngm:interface,
        ngm:message-passing .

ngm:lpwan a owl:Class ;
    rdfs:label "Lpwan"@en ;
    rdfs:comment "Low-Power Wide-Area Network (LPWAN) is a class of wireless communication technologies designed to transmit small amounts of data over long distances at very low power consumption, enabling battery-operated IoT devices to operate for years on a single charge. LPWAN technologies trade high data rates for extended range and deep indoor penetration, covering areas from a few kilometres to tens of kilometres per base station. Major LPWAN variants include LoRaWAN, Sigfox, NB-IoT, and LTE-M, each suited to different deployment and regulatory environments."@en ;
    rdfs:subClassOf ngm:infrastructure ;
    skos:broader ngm:infrastructure ;
    vc:contrastsWith ngm:bluetooth-low-energy,
        ngm:wifi ;
    vc:dependsOn ngm:network-infrastructure ;
    vc:enables ngm:asset-tracking,
        ngm:industrial-io-t,
        ngm:iot-device,
        ngm:smart-agriculture ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:lorawan ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:mesh-networking,
        ngm:wireless-protocol,
        ngm:z-wave,
        ngm:zigbee ;
    vc:slug "lpwan" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:edge-computing,
        ngm:sensor-network ;
    vc:uses ngm:encryption,
        ngm:radio-frequency .

ngm:machine-learning-accelerator a owl:Class ;
    rdfs:label "Machine Learning Accelerator"@en ;
    rdfs:comment "A Machine Learning Accelerator is specialised hardware designed to execute the dense linear-algebra workloads of neural networks far more efficiently than general-purpose CPUs. It optimises matrix multiplication, convolution and tensor operations through massive parallelism, dedicated multiply-accumulate arrays and high memory bandwidth. Examples span GPUs, tensor processing units, FPGAs and custom ASICs deployed from data centres to edge and embedded devices."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:parallel-computing ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:matrix-multiplication ],
        ngm:hardware-acceleration ;
    vc:bridgesTo ngm:gpu,
        ngm:tensor-processing-unit ;
    vc:contrastsWith ngm:cpu ;
    vc:dependsOn ngm:gpu-computing ;
    vc:enables ngm:inference,
        ngm:model-training,
        ngm:neural-network ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:matrix-multiplication ;
    vc:implements ngm:hardware-acceleration ;
    vc:isPartOf ngm:hardware-acceleration ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:asic,
        ngm:fpga,
        ngm:tensor-processing-unit ;
    vc:requires ngm:parallel-computing ;
    vc:slug "machine-learning-accelerator" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:deep-learning-framework,
        ngm:edge-computing ;
    vc:uses ngm:matrix-multiplication,
        ngm:parallel-computing .

ngm:machine-learning-discipline-models a owl:Class ;
    rdfs:label "Machine Learning Models"@en ;
    rdfs:comment "Categories and types of machine learning algorithms including classification models, regression models, clustering algorithms, and neural networks, each designed for specific prediction and pattern recognition tasks."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
