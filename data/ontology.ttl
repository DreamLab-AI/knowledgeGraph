ngm:context-awareness-system a owl:Class ;
    rdfs:label "Context Awareness System"@en ;
    rdfs:comment "A technology framework that captures, processes, and interprets contextual information about users and their environments using IoT sensors, location tracking, and AI analytics to enable adaptive services, personalized experiences, and intelligent decision-making in virtual and physical spaces."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
