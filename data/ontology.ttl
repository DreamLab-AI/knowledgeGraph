ngm:synchronous-execution a owl:Class ;
    rdfs:comment "Synchronous Execution is a computational execution model in which operations are performed sequentially, with each call blocking the invoking thread until a result is returned before the next operation begins. This model provides deterministic, predictable control flow and simplifies error handling, making it well-suited for transactional operations, authentication flows, and ACID-compliant database interactions, though it constrains throughput and scalability under high-concurrency workloads."@en ;
    rdfs:label "Synchronous Execution"@en ;
    rdfs:subClassOf ngm:bc-protocol-and-consensus ;
    rdfs:subClassOf ngm:execution-model ;
