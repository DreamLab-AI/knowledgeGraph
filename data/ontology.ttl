    vc:slug "learning-analytics" ;
    vc:sourceDomain "spatial-computing" .

ngm:libp2p a owl:Class ;
    rdfs:label "libp2p"@en ;
    rdfs:comment "libp2p is a modular network stack and peer-to-peer networking framework originally extracted from the IPFS project that enables developers to build decentralised applications with configurable transport, security, and protocol multiplexing layers. It abstracts over TCP, QUIC, WebSocket, and WebRTC transports, applies encryption via Noise Protocol or TLS 1.3, multiplexes streams with Yamux or mplex, and provides peer discovery, routing, and publish-subscribe messaging as composable modules. libp2p powers the peer layer of Ethereum 2.0, Filecoin, Polkadot, and hundreds of other decentralised systems, providing a battle-tested foundation for production-grade peer-to-peer networking."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:noise-protocol ],
        ngm:peer-to-peer-network ;
    vc:bridgesTo ngm:ai-agent-communication,
        ngm:decentralized-identity ;
    vc:contrastsWith ngm:bittorrent-protocol ;
    vc:dependsOn ngm:distributed-hash-table,
        ngm:kademlia-dht,
        ngm:quic-protocol ;
    vc:enables ngm:blockchain-network,
        ngm:decentralized-application,
        ngm:decentralized-storage ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:gossipsub,
        ngm:noise-protocol,
        ngm:yamux ;
    vc:implements ngm:peer-discovery,
        ngm:publish-subscribe-messaging,
        ngm:stream-multiplexing ;
    vc:isPartOf ngm:ipfs ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:content-addressed-storage,
        ngm:gossip-protocol ;
    vc:requires ngm:public-key-infrastructure,
        ngm:transport-layer-protocol ;
    vc:slug "libp2p" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:ethereum,
        ngm:filecoin,
        ngm:polkadot ;
    vc:uses ngm:congestion-control,
        ngm:cryptographic-protocol,
        ngm:webrtc .

ngm:liquidity-provider a owl:Class ;
    rdfs:label "Liquidity Provider"@en ;
    rdfs:comment "A liquidity provider is an entity — individual, institution, or automated protocol participant — that deposits assets into a trading venue or liquidity pool to enable others to execute trades, receiving fee income or other incentives in return. In decentralised finance, liquidity providers supply token pairs to automated market makers, receiving LP tokens representing their proportional pool share."@en ;
    rdfs:subClassOf ngm:decentralized-finance-de-fi ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:decentralized-exchange,
        ngm:impermanent-loss,
        ngm:yield-farming ;
    vc:slug "liquidity-provider" ;
    vc:sourceDomain "finance" ;
    vc:uses ngm:automated-market-maker,
        ngm:liquidity-pool,
        ngm:lp-token .

ngm:loop-closure-detection a owl:Class ;
    rdfs:label "Loop Closure Detection"@en ;
    rdfs:comment "Loop closure detection is the process by which a SLAM or mapping system recognises that it has returned to a previously visited location. By identifying these revisits, it adds constraints that correct accumulated odometry drift and produce globally consistent maps. It is a critical component of robust simultaneous localisation and mapping, typically implemented via appearance-based place recognition or geometric matching."@en ;
    rdfs:subClassOf ngm:robo-perception ;
    skos:broader ngm:robo-perception ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:long-range-navigation,
        ngm:topological-map ;
    vc:slug "loop-closure-detection" ;
    vc:sourceDomain "robotics" .

ngm:low-latency a owl:Class ;
    rdfs:label "Low Latency"@en ;
    rdfs:comment "Low latency is an engineering design property characterising systems in which the elapsed time between an input event and the corresponding system response is minimised to meet real-time interaction requirements. It is a cross-cutting concern spanning network topology, compute placement, operating-system scheduling, memory hierarchy, and hardware design. Achievable thresholds are domain-dependent — sub-100 µs in high-frequency trading, under 20 ms for vestibulo-ocular reflex alignment in extended-reality headsets, and under 150 ms for interactive video — and are reached through a combination of edge computing, kernel-bypass networking, hardware acceleration, and optimised serialisation. As a foundational property of distributed infrastructure, low latency is a prerequisite for real-time AI inference, immersive spatial computing, autonomous robotics, and ultra-reliable industrial control."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:real-time-operating-system ],
        ngm:latency ;
    vc:bridgesTo ngm:edge-ai,
        ngm:spatial-computing,
        ngm:tactile-internet ;
    vc:contrastsWith ngm:high-throughput-computing,
        ngm:throughput ;
    vc:dependsOn ngm:network-latency,
        ngm:propagation-delay,
        ngm:queuing-delay ;
    vc:enables ngm:autonomous-robotics,
        ngm:extended-reality-xr,
        ngm:high-frequency-trading,
        ngm:industrial-automation,
        ngm:real-time,
        ngm:real-time-ai-inference ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:5g,
        ngm:content-delivery-network,
        ngm:network-slicing,
        ngm:quality-of-service,
        ngm:webrtc ;
    vc:requires ngm:co-location,
        ngm:network-topology-optimisation,
        ngm:real-time-operating-system ;
    vc:slug "low-latency" ;
    vc:sourceDomain "infrastructure" ;
    vc:standardizedBy ngm:3gpp,
        ngm:ietf ;
    vc:uses ngm:edge-computing,
        ngm:fpga,
        ngm:hardware-acceleration,
        ngm:kernel-bypass-networking,
        ngm:rdma .

ngm:maker-dao a owl:Class ;
    rdfs:label "MakerDAO"@en ;
    rdfs:comment "MakerDAO is a decentralised autonomous organisation (DAO) on the Ethereum blockchain that governs the Maker Protocol — a system of smart contracts enabling users to generate the DAI stablecoin by locking over-collateralised assets in Vaults (formerly Collateralised Debt Positions). Governance decisions covering collateral onboarding, stability fees, liquidation ratios, and debt ceilings are enacted by MKR token holders through on-chain Executive Votes. As one of the earliest large-scale deployments of DAO governance and algorithmic stablecoin issuance, MakerDAO is a foundational pillar of decentralised finance (DeFi) and continues to evolve through its Endgame restructuring into a constellation of SubDAOs."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:on-chain-governance ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:oracle-network ],
        ngm:bc-defi-and-economics ;
    skos:broader ngm:bc-defi-and-economics ;
    vc:bridgesTo ngm:asset-tokenisation,
        ngm:traditional-finance ;
    vc:contrastsWith ngm:centralised-exchange,
        ngm:fiat-backed-stablecoin ;
    vc:enables ngm:algorithmic-stablecoin,
        ngm:decentralized-finance-de-fi,
        ngm:real-world-asset-tokenisation,
        ngm:stablecoin ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:dai-stablecoin,
        ngm:mkr-token,
        ngm:peg-stability-module,
        ngm:sub-dao ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:automated-market-maker,
        ngm:dao,
        ngm:liquidity-pool,
        ngm:tokenomics ;
    vc:requires ngm:on-chain-governance,
        ngm:oracle-network,
        ngm:over-collateralisation ;
    vc:slug "maker-dao" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:collateralised-debt-position,
        ngm:dutch-auction,
        ngm:ethereum,
        ngm:governance-token,
        ngm:smart-contract .

ngm:manipulator a owl:Class ;
    rdfs:label "Manipulator"@en ;
    rdfs:comment "A manipulator is a mechanically programmable device comprising a series of rigid links connected by actuated joints arranged in a serial or parallel kinematic chain, capable of displacing objects or tools through a defined workspace. The distal end carries an end-effector that interfaces directly with the task environment, enabling grasping, welding, assembly, or other physical interactions. Manipulators are parameterised by their degrees of freedom, workspace geometry, payload capacity, and control architecture, and are the foundational actuator subsystem in industrial, collaborative, and service robots. The ISO 8373:2021 standard defines a manipulator as the machine mechanism of a robot."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:kinematic-model ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:end-effector ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:trajectory-planning ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:actuator ],
        ngm:robot ;
    vc:bridgesTo ngm:digital-twin,
        ngm:reinforcement-learning ;
    vc:contrastsWith ngm:autonomous-mobile-manipulator,
        ngm:mobile-robot ;
    vc:dependsOn ngm:forward-kinematics,
        ngm:inverse-kinematics,
        ngm:motion-planning ;
    vc:enables ngm:assembly-automation,
        ngm:pick-and-place,
        ngm:robot-welding,
        ngm:teleoperation ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:actuator,
        ngm:end-effector,
        ngm:joint,
        ngm:link,
        ngm:wrist ;
    vc:implements ngm:denavit-hartenberg-convention,
        ngm:iso-8373-2021 ;
    vc:isPartOf ngm:robot,
        ngm:robotic-system ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:collaborative-robot,
        ngm:parallel-robot,
        ngm:redundant-manipulator ;
    vc:requires ngm:kinematic-model,
        ngm:robot-controller,
        ngm:trajectory-planning ;
    vc:slug "manipulator" ;
    vc:sourceDomain "robotics" ;
    vc:supports ngm:flexible-manufacturing,
        ngm:human-robot-collaboration ;
    vc:uses ngm:force-torque-sensor,
        ngm:sensor-fusion,
        ngm:servo-motor .

ngm:memory-management a skos:Concept ;
    rdfs:label "Memory Management"@en .

ngm:metaverse-architecture a owl:Class ;
    rdfs:label "Metaverse Architecture"@en ;
    rdfs:comment "The layered technical framework defining metaverse infrastructure, encompassing network connectivity, computing resources, spatial computing, creator tools, interaction protocols, and economic systems that enable persistent virtual worlds."@en ;
    rdfs:subClassOf ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:bridgesTo ngm:system-architecture ;
    vc:enables ngm:virtual-world-operation ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:slug "metaverse-architecture" ;
    vc:sourceDomain "spatial-computing" .

ngm:miner a owl:Class ;
    rdfs:label "Miner"@en ;
    rdfs:comment "A Miner is a network participant in a proof-of-work blockchain who dedicates computational resources to solving cryptographic hash puzzles, competing to produce valid blocks that extend the canonical chain in exchange for a block reward (newly issued coins plus transaction fees). Miners collectively provide the computational security of the network: the cost of mounting a 51% attack is proportional to the total hash rate, which represents real-world energy and hardware expenditure. Mining can be performed individually or cooperatively within mining pools that aggregate hash power and share rewards proportionally."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:mining-pool ],
        ngm:bc-protocol-and-consensus,
        ngm:blockchain-entity,
        ngm:consensus-protocol ;
    skos:broader ngm:bc-protocol-and-consensus ;
    vc:contrastsWith ngm:validator-node ;
    vc:dependsOn ngm:blockchain-network ;
    vc:enables ngm:block-propagation,
        ngm:consensus-mechanism ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:mining-pool ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:block-reward,
        ngm:fee-market,
        ngm:mempool,
        ngm:mining-reward ;
    vc:slug "miner" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:cryptographic-hash-function,
        ngm:proof-of-work .

ngm:mobile-robotics a owl:Class ;
    rdfs:label "Mobile Robotics"@en ;
    rdfs:comment "Mobile robotics is the engineering and scientific discipline concerned with the design, construction, and programming of robots capable of autonomous locomotion through unstructured or semi-structured physical environments. It integrates mechanical locomotion systems (wheeled, tracked, legged, aerial, aquatic), onboard sensor suites, simultaneous localisation and mapping (SLAM) for spatial state estimation, motion planning for collision-free trajectory generation, and control systems for execution — all without continuous human tele-operation. The field is fundamentally interdisciplinary, drawing on computer science, control theory, mechanical engineering, and artificial intelligence, and underpins major commercial domains including warehouse automation, autonomous vehicles, agricultural robotics, and planetary exploration."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:localisation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:real-time-computing ],
        ngm:robotics ;
    skos:broader ngm:robotics ;
    vc:bridgesTo ngm:digital-twin,
        ngm:spatial-computing ;
    vc:dependsOn ngm:embedded-systems,
        ngm:robot-operating-system ;
    vc:enables ngm:autonomous-vehicle,
        ngm:logistics-automation,
        ngm:planetary-exploration,
        ngm:precision-agriculture,
        ngm:search-and-rescue-robotics ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:drone,
        ngm:humanoid-robot,
        ngm:legged-locomotion,
        ngm:reinforcement-learning-for-robotics ;
    vc:requires ngm:localisation,
        ngm:occupancy-mapping,
        ngm:real-time-computing ;
    vc:slug "mobile-robotics" ;
    vc:sourceDomain "robotics" ;
    vc:standardizedBy ngm:iec-61508,
        ngm:iso-3691-4 ;
    vc:uses ngm:computer-vision,
        ngm:inertial-measurement-unit,
        ngm:lidar,
        ngm:motion-control,
        ngm:path-planning,
        ngm:sensor-fusion,
        ngm:simultaneous-localisation-and-mapping .

ngm:model-card a skos:Concept ;
    rdfs:label "Model Card"@en .

ngm:model-layer a owl:Class ;
    rdfs:label "Model Layer"@en ;
    rdfs:comment "The Model Layer is the stratum that holds trained machine learning models as deployable artefacts with fixed parameters. In the canonical stack it sits above the Algorithm Layer and below the Inference Layer, packaging learned functions for use. It contains weight sets, model metadata, and the serialised representations that inference engines load."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:algorithm-layer ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:training-layer ],
        ngm:ai-model-architecture ;
    skos:broader ngm:ai-model-architecture ;
    vc:enables ngm:inference-layer ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:algorithm-layer,
        ngm:training-layer ;
    vc:slug "model-layer" ;
    vc:sourceDomain "ai" .

ngm:model-optimisation-and-performance a owl:Class ;
    rdfs:label "Model Optimisation and Performance"@en ;
    rdfs:comment "Model Optimisation and Performance is the body of post-training techniques, inference-time systems, and hardware-aware transformations that reduce the computational cost, memory footprint, and latency of neural networks—particularly large language models (LLMs)—without unacceptable degradation of..."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:quantisation ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:mixture-of-experts-architecture ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gpu-compute ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:memory-hierarchy ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:gguf-format ],
        [ a owl:Restriction ;
