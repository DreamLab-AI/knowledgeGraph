        ngm:reinforcement-learning,
        ngm:supervised-learning ;
    vc:uses ngm:automatic-differentiation,
        ngm:calculus-chain-rule .

ngm:token-standard a owl:Class ;
    rdfs:label "Token Standard"@en ;
    rdfs:comment "Technical specification defining rules, interfaces, and functions that smart contract tokens must implement to ensure interoperability within a blockchain ecosystem, exemplified by ERC-20 (fungible tokens), ERC-721 (NFTs), and ERC-1155 (multi-token), establishing common APIs for transfers, balance queries, approvals, and metadata across wallets, exchanges, and decentralised applications."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:erc-20 ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:erc-1155 ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:smart-contract ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:erc-721 ],
        ngm:bc-token-and-asset ;
    skos:broader ngm:bc-token-and-asset ;
    vc:bridgesTo ngm:data-schema,
        ngm:digital-asset-standard ;
    vc:contrastsWith ngm:cbdc,
        ngm:native-currency ;
    vc:dependsOn ngm:blockchain,
        ngm:ethereum-virtual-machine ;
    vc:enables ngm:de-fi,
        ngm:decentralized-exchange,
        ngm:token-interoperability ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:erc-1155,
        ngm:erc-20,
        ngm:erc-721,
        ngm:token-interface ;
    vc:implements ngm:fungibility,
        ngm:token-approval-mechanism ;
    vc:isPartOf ngm:blockchain-protocol ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:token-metadata,
