ngm:residual-network a owl:Class ;
    rdfs:label "Residual Network"@en ;
    rdfs:comment "A deep neural network architecture introduced by He et al. (2016) that employs skip connections to allow gradients to propagate directly through layers, expressed as H(x) = F(x) + x. This residual formulation resolves the vanishing gradient problem in very deep networks, enabling training of architectures with hundreds of layers and achieving state-of-the-art performance on image recognition benchmarks."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:backpropagation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:neural-network-layer ],
        ngm:ai-technique,
        ngm:deep-learning ;
    skos:broader ngm:ai-technique ;
    vc:enables ngm:computer-vision,
        ngm:image-classification,
        ngm:transfer-learning ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:requires ngm:backpropagation,
        ngm:neural-network-layer ;
    vc:slug "residual-network" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:convolutional-neural-network,
        ngm:gpu-compute .

ngm:residual-risk-calculation a skos:Concept ;
    rdfs:label "Residual Risk Calculation"@en .

