ngm:frontier-ai a owl:Class ;
    rdfs:label "Frontier AI"@en ;
    rdfs:comment "Frontier AI denotes the most capable and computationally intensive artificial intelligence systems at the leading edge of current technical progress, typically characterised by unprecedentedly large training compute budgets, novel emergent capabilities, and performance that approaches or exceeds human expert level across diverse cognitive tasks. These systems, predominantly large language models and multimodal foundation models, exhibit qualitatively new behaviours not present in smaller predecessors, including in-context learning, chain-of-thought reasoning, and cross-domain generalisation. Their development is concentrated among a small number of resource-rich organisations, raising distinct safety, governance, and geopolitical considerations absent from earlier AI generations. Regulatory frameworks such as the EU AI Act and the UK AI Safety Institute use compute-threshold criteria to demarcate frontier systems from other AI, typically above 10^26 training FLOPs for general-purpose AI."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:infrastructure ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:large-language-models ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:multimodal-ai-architecture-ai ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:emergent-capabilities ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:reinforcement-learning-from-human-feedback ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:high-performance-computing ],
        ngm:large-scale-pretrained-foundation-model ;
    vc:contrastsWith ngm:edge-ai,
        ngm:narrow-ai ;
    vc:dependsOn ngm:gpt,
        ngm:scaling-laws,
        ngm:transformers ;
    vc:enables ngm:agentic-ai-systems,
        ngm:generative-ai,
        ngm:history-and-path-to-agi,
        ngm:scientific-discovery ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:emergent-capabilities,
        ngm:large-language-models,
        ngm:multimodal-ai-architecture-ai ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:ai-alignment,
        ngm:compute-governance,
        ngm:existential-risk ;
    vc:requires ngm:high-performance-computing,
        ngm:infrastructure,
        ngm:reinforcement-learning-from-human-feedback ;
    vc:slug "frontier-ai" ;
    vc:sourceDomain "ai" ;
    vc:standardizedBy ngm:eu-ai-act-regulatory-instrument,
        ngm:frontier-model-forum ;
    vc:supports ngm:ai-governance,
        ngm:ai-safety ;
    vc:uses ngm:mechanistic-interpretability,
        ngm:model-evaluation-results,
        ngm:red-teaming,
        ngm:scalable-oversight .

ngm:genesis-block a owl:Class ;
    rdfs:label "Genesis Block"@en ;
    rdfs:comment "The genesis block is the first block in a blockchain, hardcoded into the client software and serving as the immutable anchor from which the entire chain of subsequent blocks descends. It establishes the initial chain state, encodes the founding parameters of the network, and contains no reference to a previous block hash. Because it cannot be altered without invalidating all subsequent blocks, the genesis block is the ultimate root of trust for the distributed ledger."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:block-header ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:nonce ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:timestamp ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:merkle-root ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:immutability ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:coinbase-transaction ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptographic-hash ],
        ngm:bc-protocol-and-consensus,
        ngm:blockchain-entity,
        ngm:distributed-data-structure ;
    skos:broader ngm:bc-protocol-and-consensus ;
    vc:enables ngm:block-height,
        ngm:blockchain-network ;
