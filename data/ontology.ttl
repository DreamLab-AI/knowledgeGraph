        ngm:statistical-testing .

ngm:cap-theorem a owl:Class ;
    rdfs:label "CAP Theorem"@en ;
    rdfs:comment "The CAP Theorem states that a distributed data store cannot simultaneously guarantee all three of consistency, availability and partition tolerance. When a network partition occurs and messages between nodes are lost or delayed, a system must choose between remaining available, by serving possibly stale data, and remaining consistent, by refusing requests it cannot safely satisfy. Formulated by Eric Brewer and later proved formally by Gilbert and Lynch, it frames a fundamental trade-off in distributed systems design."@en ;
    rdfs:subClassOf ngm:infra-computing-and-cloud ;
    skos:broader ngm:infra-computing-and-cloud ;
    vc:bridgesTo ngm:blockchain-consensus,
        ngm:federated-learning ;
    vc:contrastsWith ngm:acid-properties,
        ngm:base-properties,
        ngm:pacelc-theorem ;
    vc:dependsOn ngm:consensus,
        ngm:replication ;
    vc:enables ngm:distributed-database-design,
        ngm:system-fault-tolerance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:availability,
        ngm:consistency,
        ngm:partition-tolerance ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:distributed-systems-theorem,
        ngm:eventual-consistency,
        ngm:linearizability,
        ngm:nosql-database,
        ngm:paxos-protocol,
        ngm:raft-consensus,
        ngm:strong-consistency,
        ngm:two-phase-commit ;
    vc:requires ngm:distributed-data-store,
        ngm:network-partition ;
    vc:slug "cap-theorem" ;
    vc:sourceDomain "distributed-systems" .

ngm:collaboration a owl:Class ;
    rdfs:label "Collaboration"@en ;
    rdfs:comment "Collaboration is the coordinated joint activity of two or more agents — human or artificial — working toward shared goals through negotiated division of labour, mutual adjustment, and shared artefact production. In digital and distributed settings it encompasses synchronous and asynchronous communication, collective sense-making, and structured workflows mediated by software systems that maintain shared state and contextual awareness across geographic and organisational boundaries. Effective collaboration depends on social and technical mechanisms for conflict resolution, attribution, version management, and trust; its theoretical foundations draw from Computer-Supported Cooperative Work (CSCW), distributed cognition, and organisational theory. Contemporary collaboration increasingly involves AI agents, immersive shared environments, and decentralised coordination protocols."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:asynchronous-coordination ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:trust ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:access-control ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:version-control ],
        ngm:distributed-collaboration ;
    skos:broader ngm:distributed-collaboration ;
    vc:bridgesTo ngm:decentralised-autonomous-organisation,
        ngm:multi-agent-system,
        ngm:social-vr ;
    vc:contrastsWith ngm:cooperation,
        ngm:coordination ;
    vc:enables ngm:co-creation,
        ngm:collective-intelligence,
        ngm:knowledge-sharing,
        ngm:telecollaboration ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:asynchronous-coordination,
        ngm:shared-workspace,
        ngm:synchronous-communication ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:computer-supported-cooperative-work,
        ngm:social-network,
        ngm:workflow-management ;
    vc:requires ngm:access-control,
        ngm:trust,
        ngm:version-control ;
    vc:slug "collaboration" ;
    vc:sourceDomain "distributed-collaboration" ;
    vc:standardizedBy ngm:ieee-institute-of-electrical-and-electronics-engineers,
        ngm:w3c-world-wide-web-consortium ;
    vc:supports ngm:organisational-learning,
        ngm:team-formation ;
    vc:uses ngm:collaboration-platform,
        ngm:conflict-free-replicated-data-type,
        ngm:groupware,
