    a owl:Restriction ;
    owl:onProperty ngm:hasComponent ;
    owl:someValuesFrom tc:TELE301virtualofficespaces
] .

# Virtual Office Spaces
tc:VirtualOfficeSpaces a owl:Class ;
    rdfs:subClassOf tc:VirtualEnvironment ;
    rdfs:label "Virtual Office Spaces"@en ;
    rdfs:comment "\"Persistent virtual reality or metaverse environments designed as professional workspaces where distributed teams gather as avatars to collaborate, attend meetings, use shared whiteboards, and navigate 3D office layouts, replicating physical office spatial dynamics whilst enabling global remote participation through immersive telepresence platforms.\""@en ;
    skos:prefLabel "Virtual Office Spaces"@en ;
    dcterms:identifier "TC-0301" ;
    dcterms:subject "tc" ;
    dcterms:type "developing" ;
    rdf:type owl:ObjectClass .

# Shared Whiteboards
tc:SharedWhiteboards a owl:Class ;
    rdfs:label "Shared Whiteboards"@en ;
    rdfs:comment "\"Digital canvases in telepresence platforms enabling distributed team members to simultaneously draw, write, annotate, and manipulate visual content (text, images, diagrams, sticky notes) in real-time, replicating physical whiteboard collaboration dynamics through multi-user synchronisation and persistent storage of collaborative artefacts.\""@en ;
    skos:prefLabel "Shared Whiteboards"@en ;
    dcterms:identifier "TC-0302" ;
    dcterms:subject "tc" ;
    dcterms:type "mature" ;
    rdf:type owl:ObjectClass .

# Telecollaboration and Telepresence Domain
tc:TC-0303 a owl:Class ;
    rdfs:label "Telecollaboration and Telepresence Domain"@en ;
    skos:prefLabel "Telecollaboration and Telepresence Domain"@en ;
    dcterms:identifier "TC-0303" ;
    dcterms:subject "tc" .

# Virtual Meeting
tc:VirtualMeeting a owl:Class ;
    rdfs:subClassOf tc:Telecollaboration ;
    rdfs:label "Virtual Meeting"@en ;
    rdfs:comment "Virtual Meeting refers to synchronous gatherings of participants using video conferencing, spatial computing, or immersive technologies to collaborate remotely. This encompasses traditional video conferencing platforms, virtual whiteboards, screen sharing capabilities, and emerging 3D virtual meeting spaces."@en ;
    skos:prefLabel "Virtual Meeting"@en ;
    dcterms:identifier "TC-0602" ;
    dcterms:subject "tc" .

tc:VirtualMeeting rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:isParentOf ;
    owl:someValuesFrom tc:VideoConference
] .

tc:VirtualMeeting rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:isParentOf ;
    owl:someValuesFrom tc:VirtualWhiteboard
] .

tc:VirtualMeeting rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:isParentOf ;
    owl:someValuesFrom tc:ScreenSharing
] .

tc:VirtualMeeting rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:relatedTo ;
    owl:someValuesFrom tc:RemoteCollaboration
] .

# Remote Collaboration
tc:RemoteCollaboration a owl:Class ;
    rdfs:subClassOf tc:Telecollaboration ;
    rdfs:label "Remote Collaboration"@en ;
    rdfs:comment "Remote Collaboration encompasses the tools, platforms, and methodologies that enable distributed teams to work together effectively across geographic distances. This includes collaborative editing systems, shared workspaces, real-time co-creation tools, and asynchronous collaboration platforms that facilitate productive teamwork without physical co-location."@en ;
    skos:prefLabel "Remote Collaboration"@en ;
    dcterms:identifier "TC-0603" ;
    dcterms:subject "tc" .

tc:RemoteCollaboration rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:isParentOf ;
    owl:someValuesFrom tc:CollaborativeEditing
] .

tc:RemoteCollaboration rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:isParentOf ;
    owl:someValuesFrom tc:SharedWorkspace
] .

tc:RemoteCollaboration rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:isParentOf ;
    owl:someValuesFrom tc:RealTimeCollaboration
] .

tc:RemoteCollaboration rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:relatedTo ;
    owl:someValuesFrom tc:VirtualMeeting
] .

# Communication Theory
tc:CommunicationTheory a owl:Class ;
    rdfs:subClassOf tc:Telecollaboration ;
    rdfs:label "Communication Theory"@en ;
    rdfs:comment "Communication Theory provides the theoretical foundations for understanding how information, meaning, and social presence are transmitted and perceived in mediated communication contexts. Key frameworks include media richness theory, social presence theory, and theories of computer-mediated communication that inform the design of telecollaboration systems."@en ;
    skos:prefLabel "Communication Theory"@en ;
    dcterms:identifier "TC-0604" ;
    dcterms:subject "tc" .

tc:CommunicationTheory rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:isParentOf ;
    owl:someValuesFrom tc:MediaRichness
] .

tc:CommunicationTheory rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:isParentOf ;
    owl:someValuesFrom tc:SocialPresence
] .

tc:CommunicationTheory rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:relatedTo ;
    owl:someValuesFrom tc:VirtualMeeting
] .

tc:CommunicationTheory rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:relatedTo ;
    owl:someValuesFrom tc:ImmersiveCommunication
] .

# Immersive Communication
tc:ImmersiveCommunication a owl:Class ;
    rdfs:subClassOf tc:Telecollaboration ;
    rdfs:label "Immersive Communication"@en ;
    rdfs:comment "Immersive Communication refers to communication systems and experiences that leverage extended reality (XR) technologies to create highly engaging, spatially-aware interaction environments. This includes VR meetings, AR collaboration tools, spatial audio conferencing, and mixed reality communication platforms that transcend traditional 2D video interfaces."@en ;
    skos:prefLabel "Immersive Communication"@en ;
    dcterms:identifier "TC-0605" ;
    dcterms:subject "tc" .

tc:ImmersiveCommunication rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:isParentOf ;
    owl:someValuesFrom tc:VRMeeting
] .

tc:ImmersiveCommunication rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:isParentOf ;
    owl:someValuesFrom tc:ARCollaboration
] .

tc:ImmersiveCommunication rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:isParentOf ;
    owl:someValuesFrom tc:SpatialAudio
] .

tc:ImmersiveCommunication rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:relatedTo ;
    owl:someValuesFrom tc:Telepresence
] .

tc:ImmersiveCommunication rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:relatedTo ;
    owl:someValuesFrom tc:SpatialComputing
] .

# Virtual Reality Telepresence
tc:VirtualRealityTelepresence a owl:Class ;
    rdfs:subClassOf tc:VirtualReality ;
    rdfs:subClassOf tc:TELE001telepresence ;
    rdfs:label "Virtual Reality Telepresence"@en ;
    rdfs:comment "\"The use of virtual reality head-mounted displays and immersive 3D environments to enable remote participants to experience shared virtual spaces with stereoscopic vision, spatial audio, head tracking, and avatar embodiment, creating a subjective sense of co-location despite geographical separation.\""@en ;
    skos:prefLabel "Virtual Reality Telepresence"@en ;
