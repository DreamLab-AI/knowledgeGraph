ngm:large-language-model a owl:Class ;
    rdfs:label "Large Language Model"@en ;
    rdfs:comment "A large language model (LLM) is a deep neural network — almost universally based on the [[Transformer Architecture]] — trained via self-supervised next-token prediction on web-scale corpora of text (and often code, mathematics, and structured data), resulting in a system that assigns a probability distribution over token sequences and can generate coherent, contextually appropriate continuations. Scale — both in parameter count (billions to hundreds of billions) and training tokens (trillions) — is the defining characteristic that distinguishes LLMs from earlier, smaller language models, and is the proximate cause of qualitative capability jumps such as in-context learning, instruction following, chain-of-thought reasoning, and emergent generalisation across domains. LLMs are typically released as base pretrained models that are subsequently aligned to human preferences through supervised fine-tuning and reinforcement learning from human feedback, producing the instruction-following assistants widely deployed in consumer and enterprise applications. The paradigm has become the de facto foundation for natural language processing, code synthesis, autonomous agent planning, and multimodal AI systems."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:transformer-architecture ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:pretraining ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:compute-infrastructure ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:attention-mechanism ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:training-data ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:context-window ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:embeddings ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gpu-computing ],
        ngm:foundation-model ;
    vc:bridgesTo ngm:eu-ai-act-regulatory-instrument,
        ngm:knowledge-graph,
        ngm:multi-agent-system ;
    vc:contrastsWith ngm:recurrent-neural-network ;
    vc:dependsOn ngm:scaling-laws,
        ngm:self-supervised-learning ;
    vc:enables ngm:ai-agent,
        ngm:code-generation,
        ngm:conversational-ai,
        ngm:natural-language-processing,
        ngm:retrieval-augmented-generation,
        ngm:text-generation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:attention-mechanism,
        ngm:context-window,
        ngm:embeddings,
        ngm:transformer-architecture ;
    vc:qualityScore "0.74"^^xsd:float ;
