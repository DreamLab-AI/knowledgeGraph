        ngm:co-ala,
        ngm:companion-cognitive-architecture,
        ngm:lida,
        ngm:nars,
        ngm:sigma-architecture,
        ngm:soar ;
    vc:qualityScore "0.52"^^xsd:float ;
    vc:relatedTo ngm:artificial-general-intelligence,
        ngm:common-sense-reasoning,
        ngm:embodied-ai,
        ngm:global-workspace-theory,
        ngm:neuromorphic-computing,
        ngm:predictive-processing ;
    vc:requires ngm:conflict-resolution,
        ngm:inference-engine,
        ngm:knowledge-representation,
        ngm:memory-indexing,
        ngm:symbol-grounding ;
    vc:slug "cognitive-ai" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:standardizedBy ngm:aaai-cognitive-systems,
        ngm:advances-in-cognitive-systems-journal,
        ngm:cognitive-science-society,
