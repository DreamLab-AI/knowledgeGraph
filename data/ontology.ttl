ngm:scene-graph-format a owl:Class ;
    rdfs:comment "A Scene Graph Format is a standardised serialisation schema for directed acyclic graphs that represent 3D scene hierarchies, encoding spatial transforms, geometry, materials, lights, cameras, and behaviours. Major formats include glTF (optimised for runtime delivery), USD (layered composition for production pipelines), X3D (ISO web standard), and Collada (interchange for DCC tools)."@en ;
    rdfs:label "Scene Graph Format"@en ;
