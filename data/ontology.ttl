ngm:tensor-computation a owl:Class ;
    rdfs:comment "Tensor computation is the set of mathematical operations performed on multi-dimensional arrays (tensors) that form the core numerical substrate of modern machine learning. These operations include contraction, element-wise arithmetic, broadcasting, decomposition, and automatic differentiation, typically executed on specialised hardware such as GPUs or TPUs. Tensor computation frameworks provide graph-based or eager execution models that map operations to hardware acceleration primitives."@en ;
    rdfs:label "Tensor Computation"@en ;
    rdfs:subClassOf ngm:tensor ;
