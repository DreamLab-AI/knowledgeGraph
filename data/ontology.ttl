ngm:information-theory a owl:Class ;
    rdfs:label "Information Theory"@en ;
    rdfs:comment "Information Theory is the mathematical study of the quantification, storage and communication of information, founded by Claude Shannon in 1948. It introduces entropy as a measure of uncertainty in a random source and defines channel capacity, the maximum rate at which information can be transmitted reliably over a noisy channel. The theory underpins data compression, error-correcting codes and modern digital communication. It also connects to statistics, cryptography and machine learning through measures such as mutual information and Kullback-Leibler divergence."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:entropy ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:channel-coding ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:kullback-leibler-divergence ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:statistics ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:probability-theory ],
        ngm:applied-mathematics ;
    vc:bridgesTo ngm:network-coding,
        ngm:quantum-information,
        ngm:thermodynamics ;
    vc:enables ngm:cryptography,
        ngm:data-compression,
        ngm:error-correction ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:channel-capacity,
        ngm:channel-coding,
        ngm:entropy,
        ngm:kullback-leibler-divergence ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:coding-theory,
        ngm:signal-processing ;
    vc:requires ngm:probability-theory,
        ngm:statistics ;
    vc:slug "information-theory" ;
    vc:sourceDomain "machine-learning" ;
    vc:supports ngm:feature-selection,
        ngm:machine-learning,
        ngm:natural-language-processing ;
    vc:uses ngm:random-variable .

ngm:level-of-detail a owl:Class ;
    rdfs:label "Level of Detail"@en ;
    rdfs:comment "Level of Detail (LOD) is a rendering optimisation technique that dynamically adjusts the geometric complexity, texture resolution, and shader fidelity of 3D objects based on viewing distance or screen-space coverage, trading visual precision for computational efficiency. LOD is essential for maintaining real-time frame rates in large-scale metaverse and spatial computing scenes."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:3-d-asset ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
