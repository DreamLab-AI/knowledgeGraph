    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:slug "infrared-light-source" ;
    vc:sourceDomain "spatial-computing" .

ngm:institutional-adoption a owl:Class ;
    rdfs:label "Institutional Adoption"@en ;
    rdfs:comment "Institutional adoption is the process by which regulated, large-scale organisations — including banks, asset managers, pension funds, sovereign wealth funds, and corporations — integrate a novel technology, protocol, or asset class into their core operations, risk frameworks, and balance sheets. It is characterised by formal governance procedures, compliance with applicable regulatory regimes, and deployment of significant capital under fiduciary obligations. Unlike retail or speculative uptake, institutional adoption requires custodial infrastructure, legal certainty, and integration with existing settlement, reporting, and audit systems. It typically follows a maturation arc: proof-of-concept pilots by innovation teams, limited production deployment, and finally full strategic integration with dedicated product lines."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:financial-regulation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:risk-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:compliance-framework ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:digital-asset-custody ],
        ngm:technology-adoption ;
    vc:bridgesTo ngm:blockchain,
        ngm:decentralised-finance,
        ngm:enterprise-ai ;
    vc:dependsOn ngm:know-your-customer,
        ngm:regulatory-clarity,
        ngm:settlement ;
    vc:enables ngm:asset-tokenisation,
        ngm:liquidity,
        ngm:price-discovery ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:central-bank-digital-currency,
