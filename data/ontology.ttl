ngm:differentiable-rendering a owl:Class ;
    rdfs:label "Differentiable Rendering"@en ;
    rdfs:comment "Differentiable rendering is a class of algorithms that reformulate the image-formation pipeline so that pixel values are differentiable with respect to scene parameters — including geometry, surface materials, lighting, and camera pose. By enabling backpropagation through the rendering process, these methods support gradient-based optimisation for inverse rendering, scene reconstruction from 2D observations, and end-to-end training of 3D-aware neural models. The field bridges classical computer graphics with deep learning, treating rendering as a learnable, differentiable module within a larger neural architecture."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:automatic-differentiation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:deep-learning-framework ],
        ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:bridgesTo ngm:augmented-reality,
        ngm:autonomous-driving,
        ngm:digital-twin ;
    vc:enables ngm:3-d-reconstruction,
        ngm:neural-radiance-field,
        ngm:pose-estimation ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:implements ngm:physically-based-rendering,
        ngm:volumetric-rendering ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:bidirectional-reflectance-distribution-function,
        ngm:computer-vision,
        ngm:gaussian-splatting,
        ngm:implicit-neural-representation,
        ngm:neural-scene-representation ;
    vc:requires ngm:automatic-differentiation,
        ngm:deep-learning-framework ;
    vc:slug "differentiable-rendering" ;
    vc:sourceDomain "machine-learning" ;
    vc:uses ngm:backpropagation,
        ngm:gradient-descent,
        ngm:monte-carlo-integration,
        ngm:rasterization,
        ngm:ray-tracing .

ngm:edge-ai a owl:Class ;
    rdfs:label "Edge AI"@en ;
    rdfs:comment "Edge AI is the deployment and execution of artificial intelligence inference workloads directly on edge devices—such as smartphones, IoT sensors, surveillance cameras, and embedded systems—close to the data source, rather than in centralised cloud data centres. It reduces latency, preserves data privacy, enables offline operation, and cuts bandwidth costs by processing data locally using optimised neural network models and dedicated hardware accelerators such as neural processing units (NPUs). Edge AI encompasses model compression techniques (quantisation, pruning, knowledge distillation), specialised deployment runtimes, and on-device training paradigms such as federated learning. It bridges the domains of machine learning, embedded systems, and distributed computing to enable intelligent applications at the network periphery."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:embedded-systems ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:neural-processing-unit ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:model-compression ],
        ngm:edge-computing ;
    vc:bridgesTo ngm:digital-twin,
        ngm:smart-city,
        ngm:spatial-computing ;
    vc:contrastsWith ngm:fog-computing ;
    vc:dependsOn ngm:deep-learning,
        ngm:edge-computing,
        ngm:internet-of-things ;
    vc:enables ngm:autonomous-vehicle,
        ngm:federated-learning,
        ngm:io-t-ai-integration,
        ngm:real-time-inference-at-edge,
        ngm:smart-manufacturing ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:computer-vision,
        ngm:natural-language-processing,
        ngm:on-device-learning,
        ngm:small-language-models,
        ngm:tiny-ml ;
    vc:requires ngm:embedded-systems,
        ngm:model-compression,
        ngm:neural-processing-unit ;
    vc:slug "edge-ai" ;
    vc:sourceDomain "ai" ;
    vc:standardizedBy ngm:etsi-mec,
        ngm:mlperf ;
    vc:uses ngm:hardware-acceleration,
        ngm:inference-engine,
        ngm:knowledge-distillation,
        ngm:neural-architecture-search,
        ngm:neural-network-quantisation,
        ngm:onnx .

ngm:enforcement-mechanism a owl:Class ;
    rdfs:label "Enforcement Mechanism"@en ;
    rdfs:comment "An enforcement mechanism is any technical, legal, or procedural instrument through which rules, policies, or contractual obligations are made to take effect and violations are detected and sanctioned. In digital systems, enforcement mechanisms range from smart contracts that execute conditions automatically to access control systems that block unauthorised actions. In regulatory contexts they include fines, licence revocations, and injunctions applied by supervisory authorities. Effective enforcement mechanisms are characterised by their ability to detect non-compliance, impose credible consequences, and do so at a cost proportionate to the harm prevented."@en ;
    rdfs:subClassOf ngm:compliance-control ;
    vc:bridgesTo ngm:algorithmic-auditing,
        ngm:smart-contract,
        ngm:zero-trust-architecture ;
    vc:contrastsWith ngm:self-regulation ;
    vc:enables ngm:accountability,
        ngm:legal-compliance,
        ngm:rule-of-law,
        ngm:sanctions-enforcement ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:governance-framework,
        ngm:regulatory-compliance ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:audit-mechanism,
        ngm:compliance-framework,
        ngm:legal-framework,
        ngm:policy-enforcement,
        ngm:regulatory-authority,
        ngm:smart-contract ;
    vc:requires ngm:violation-detection ;
    vc:slug "enforcement-mechanism" ;
    vc:sourceDomain "governance" ;
    vc:supports ngm:risk-management,
        ngm:trust-framework ;
    vc:uses ngm:access-control,
        ngm:monitoring-system,
        ngm:policy-enforcement-point,
        ngm:policy-engine .

ngm:global-illumination a owl:Class ;
    rdfs:label "Global Illumination"@en ;
    rdfs:comment "Global Illumination (GI) is a rendering approach that simulates all light interactions within a scene, including both direct illumination from light sources and indirect illumination from light bouncing between surfaces. Techniques range from offline radiosity and photon mapping to real-time approximations such as voxel cone tracing, screen-space ambient occlusion, and hardware-accelerated ray tracing, producing physically plausible colour bleeding, soft shadows, and caustics."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:compute-shader ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ray-tracing ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:ambient-occlusion ],
        ngm:sc-display-and-rendering ;
    skos:broader ngm:sc-display-and-rendering ;
    vc:bridgesTo ngm:machine-learning,
        ngm:neural-radiance-field ;
    vc:contrastsWith ngm:rasterization ;
    vc:enables ngm:photorealistic-rendering,
        ngm:soft-shadows ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:ambient-occlusion,
        ngm:caustics,
        ngm:direct-illumination ;
    vc:isPartOf ngm:rendering-pipeline ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:lightmap-baking,
        ngm:subsurface-scattering,
        ngm:voxel-cone-tracing ;
    vc:requires ngm:compute-shader,
        ngm:light-transport-simulation,
        ngm:ray-tracing ;
    vc:slug "global-illumination" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:architectural-visualisation,
        ngm:metaverse,
        ngm:virtual-reality ;
    vc:uses ngm:photon-mapping,
        ngm:physically-based-rendering,
        ngm:radiosity .

ngm:gps a owl:Class ;
    rdfs:label "Gps"@en ;
    rdfs:comment "GPS (Global Positioning System) - A satellite-based Navigation System that determines the absolute geographical location of a robot, providing latitude, longitude, and altitude data for large-scale autonomous navigation, outdoor delivery, and trajectory planning with typical accuracy of 5-15 ..."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:antenna-array ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:signal-processing ],
        ngm:navigation-system,
        ngm:robo-navigation-and-planning ;
    skos:broader ngm:robo-navigation-and-planning ;
    vc:enables ngm:long-range-navigation,
        ngm:multi-robot-coordination ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:isPartOf ngm:global-localisation,
        ngm:mission-planning ;
    vc:qualityScore "0.51"^^xsd:float ;
    vc:requires ngm:antenna-array,
        ngm:signal-processing ;
    vc:slug "gps" ;
    vc:sourceDomain "robotics" .

ngm:hazard-analysis a owl:Class ;
    rdfs:label "Hazard Analysis"@en ;
    rdfs:comment "Hazard analysis is the systematic identification, characterisation, and prioritisation of conditions or events with the potential to cause harm to people, systems, or environments, forming the foundational step in safety engineering processes that design controls to prevent or mitigate those harms. Methods range from qualitative techniques such as HAZOP and FMEA to quantitative probabilistic risk assessment, applied across aviation, automotive, nuclear, medical devices, and increasingly AI systems."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:hazard-identification ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:risk ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:fault-tree-analysis ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:risk-assessment-methodology ],
        ngm:risk-assessment ;
    vc:bridgesTo ngm:artificial-intelligence,
        ngm:infrastructure,
        ngm:robotics ;
    vc:dependsOn ngm:system-model ;
    vc:enables ngm:compliance,
        ngm:fault-tolerance,
        ngm:functional-safety,
        ngm:safety-case ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:fault-tree-analysis,
        ngm:hazard-identification,
        ngm:risk ;
    vc:isPartOf ngm:risk-management,
        ngm:safety-engineering ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:compliance-framework,
        ngm:safety-critical-systems,
        ngm:technical-standards ;
    vc:requires ngm:risk-assessment-methodology ;
    vc:slug "hazard-analysis" ;
    vc:sourceDomain "governance" ;
    vc:standardizedBy ngm:iec-61508,
        ngm:iso-26262,
        ngm:mil-std-882 ;
    vc:supports ngm:fault-tolerance-system,
        ngm:regulatory-compliance,
        ngm:safety-integrity-level ;
    vc:uses ngm:fault-tree-analysis,
        ngm:hazop,
        ngm:probabilistic-risk-assessment,
        ngm:risk-assessment-methodology .

ngm:image-classification a owl:Class ;
    rdfs:label "Image Classification"@en ;
    rdfs:comment "Image Classification is the computer vision task of assigning a categorical label to an entire image from a predefined set of classes, determining what is depicted in the image as a whole. Modern image classification employs deep convolutional neural networks (ResNet, EfficientNet, Vision Transformers) trained on large-scale datasets such as ImageNet to achieve human-level or super-human performance on diverse visual recognition tasks."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:image-preprocessing ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:deep-learning ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:convolutional-neural-network ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:feature-map ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:training-data ],
        ngm:ai-application ;
    skos:broader ngm:ai-application ;
    vc:bridgesTo ngm:robotics-perception,
        ngm:spatial-computing ;
    vc:contrastsWith ngm:image-segmentation,
        ngm:instance-segmentation ;
    vc:dependsOn ngm:backpropagation,
        ngm:gpu-computing,
        ngm:neural-network ;
    vc:enables ngm:autonomous-driving,
