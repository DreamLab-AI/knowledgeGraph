    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:digital-marketplace,
        ngm:non-fungible-token,
        ngm:play-to-earn-p2-e,
        ngm:virtual-currency ;
    vc:qualityScore "0.73"^^xsd:float ;
    vc:relatedTo ngm:creator-economy,
        ngm:game-theory,
