# Telecollaboration Domain
tc:TelecollaborationDomain a owl:Class ;
    rdfs:label "Telecollaboration Domain"@en ;
    rdfs:comment "\"The domain of knowledge encompassing technology-mediated collaboration, distributed teamwork, remote presence systems, and virtual cooperation platforms enabling humans to work together effectively across geographical and temporal boundaries.\""@en ;
    skos:prefLabel "Telecollaboration Domain"@en ;
    dcterms:identifier "TC-0001" ;
    dcterms:subject "tc" ;
    dcterms:type "mature" ;
    rdf:type owl:DomainClass .

# tc 0002 collaborative document editing
tc:CollaborativeDocumentEditing a owl:Class ;
    rdfs:label "tc 0002 collaborative document editing"@en ;
    rdfs:comment "**Collaborative Document Editing** - Real-time or asynchronous shared editing technology enabling multiple distributed users to simultaneously create, modify, and comment on digital documents with live synchronization and version control."@en ;
    skos:prefLabel "tc 0002 collaborative document editing"@en ;
    dcterms:identifier "TC-0002" ;
    dcterms:subject "tc" ;
    dcterms:type "mature" ;
    rdf:type owl:ProcessClass .

# tc 0003 telepresence robot
tc:TelepresenceRobot a owl:Class ;
    rdfs:label "tc 0003 telepresence robot"@en ;
    rdfs:comment "**Telepresence Robot** - Mobile robotic platform with audio-visual and manipulation capabilities enabling a remote operator to have a physical embodied presence, interact with environments, and perform tasks at a distance while maintaining situational awareness through real-time sensory feedback."@en ;
    skos:prefLabel "tc 0003 telepresence robot"@en ;
    dcterms:identifier "TC-0003" ;
    dcterms:subject "tc" ;
    dcterms:type "emerging" ;
    rdf:type owl:AgentClass .

# Media Richness Theory
tc:MediaRichnessTheory a owl:Class ;
    rdfs:subClassOf tc:OrganisationalTheory ;
    rdfs:subClassOf tc:CommunicationTheory ;
    rdfs:label "Media Richness Theory"@en ;
    rdfs:comment "\"A theoretical framework positing that communication media vary in their capacity to convey rich information through multiple cues, immediate feedback, language variety, and personal focus, predicting that richer media enable more effective communication of complex, ambiguous information whilst leaner media suffice for routine, unambiguous messages.\""@en ;
    skos:prefLabel "Media Richness Theory"@en ;
    dcterms:identifier "TC-0004" ;
    dcterms:subject "tc" ;
    dcterms:type "mature" ;
    rdf:type owl:ConceptClass .

tc:MediaRichnessTheory rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:enables ;
    owl:someValuesFrom tc:TaskMediaFit
] .

tc:MediaRichnessTheory rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:enables ;
    owl:someValuesFrom tc:CommunicationEffectiveness
] .

tc:MediaRichnessTheory rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:enables ;
    owl:someValuesFrom tc:MediaSelection
] .

tc:MediaRichnessTheory rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:informs ;
    owl:someValuesFrom tc:TELE003socialpresencetheory
] .

tc:MediaRichnessTheory rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:manifestsIn ;
    owl:someValuesFrom tc:TELE001telepresence
] .

# Presence
tc:Presence a owl:Class ;
    rdfs:subClassOf tc:PsychologicalPhenomenon ;
    rdfs:subClassOf tc:PerceptualExperience ;
    rdfs:label "Presence"@en ;
    rdfs:comment "\"The subjective psychological phenomenon of perceiving oneself as located within a mediated environment rather than one's actual physical location, characterised by a sense of 'being there' that emerges from immersive sensory stimulation and reduced awareness of the mediating technology, foundational to effective telepresence experiences.\""@en ;
    skos:prefLabel "Presence"@en ;
    dcterms:identifier "TC-0006" ;
    dcterms:subject "tc" ;
    dcterms:type "mature" ;
    rdf:type owl:ConceptClass .

tc:Presence rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:requires ;
    owl:someValuesFrom tc:AttentionAllocation
] .

tc:Presence rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:requires ;
    owl:someValuesFrom tc:SensoryStimulation
] .

tc:Presence rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:requires ;
    owl:someValuesFrom tc:SuspensionOfDisbelief
] .

tc:Presence rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:enables ;
    owl:someValuesFrom tc:Embodiment
] .

tc:Presence rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:enables ;
    owl:someValuesFrom tc:TELE001telepresence
] .

tc:Presence rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:enables ;
    owl:someValuesFrom tc:Immersion
] .

tc:Presence rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:informs ;
    owl:someValuesFrom tc:TELE003socialpresencetheory
] .

tc:Presence rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:manifestsIn ;
    owl:someValuesFrom tc:TELE020virtualrealitytelepresence
] .

tc:Presence rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:hasComponent ;
    owl:someValuesFrom tc:SocialPresence
] .

tc:Presence rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:hasComponent ;
    owl:someValuesFrom tc:SpatialPresence
] .

tc:Presence rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ngm:hasComponent ;
    owl:someValuesFrom tc:SelfPresence
] .

# Synchronous Collaboration
tc:SynchronousCollaboration a owl:Class ;
    rdfs:label "Synchronous Collaboration"@en ;
    rdfs:comment "\"Real-time interaction mode where distributed participants engage simultaneously through technology-mediated channels, enabling immediate feedback, spontaneous ideation, and social presence comparable to co-located teamwork.\""@en ;
    skos:prefLabel "Synchronous Collaboration"@en ;
    dcterms:identifier "TC-0010" ;
    dcterms:subject "tc" ;
    dcterms:type "mature" ;
    rdf:type owl:CollaborationModeClass .

# Video Conferencing
tc:VideoConferencing a owl:Class ;
    rdfs:label "Video Conferencing"@en ;
    rdfs:comment "\"Real-time audio-visual communication technology enabling multiple geographically distributed participants to see and hear each other simultaneously through internet-connected devices, supporting face-to-face interaction across distances.\""@en ;
    skos:prefLabel "Video Conferencing"@en ;
    dcterms:identifier "TC-0011" ;
    dcterms:subject "tc" ;
    dcterms:type "mature" ;
    rdf:type owl:CommunicationToolClass .

# Asynchronous Collaboration
tc:AsynchronousCollaboration a owl:Class ;
    rdfs:label "Asynchronous Collaboration"@en ;
    rdfs:comment "\"Time-independent collaboration mode where distributed participants contribute at different times through shared persistent artifacts, enabling flexible schedules, deep work periods, and global accessibility while maintaining coordination through explicit documentation and version control.\""@en ;
    skos:prefLabel "Asynchronous Collaboration"@en ;
    dcterms:identifier "TC-0020" ;
    dcterms:subject "tc" ;
    dcterms:type "mature" ;
    rdf:type owl:CollaborationModeClass .

# Augmented Reality Collaboration
tc:AugmentedRealityCollaboration a owl:Class ;
    rdfs:subClassOf tc:TELE002telecollaboration ;
    rdfs:subClassOf tc:AugmentedReality ;
    rdfs:subClassOf tc:TELE001telepresence ;
    rdfs:label "Augmented Reality Collaboration"@en ;
    rdfs:comment "\"Collaborative work where geographically distributed team members share a common augmented reality environment, viewing and manipulating virtual 3D objects overlaid on their respective physical spaces whilst communicating via spatial audio and holographic avatars, enabling hybrid physical-virtual cooperation through AR headsets or mobile devices.\""@en ;
    skos:prefLabel "Augmented Reality Collaboration"@en ;
    dcterms:identifier "TC-0021" ;
    dcterms:subject "tc" ;
    dcterms:type "developing" ;
    rdf:type owl:ProcessClass .

