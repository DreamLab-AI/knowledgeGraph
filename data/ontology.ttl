ngm:planning a owl:Class ;
    rdfs:label "Planning"@en ;
    rdfs:comment "Planning is the cognitive and computational process of deliberating over a set of possible actions and selecting a sequence that transforms an initial state into a desired goal state, given a model of how actions change the world. In artificial intelligence, automated planning formalises this problem using state representations, action schemas with preconditions and effects, and search or optimisation algorithms to synthesise executable plans. Planning encompasses both classical deterministic formulations (e.g. STRIPS, PDDL) and richer variants that handle uncertainty, partial observability, continuous time, resources, and preferences. It underpins autonomous agents, robotics, supply-chain management, and any system that must reason prospectively about future action consequences."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:search-algorithm ],
        ngm:automated-planning ;
    vc:bridgesTo ngm:multi-agent-system,
        ngm:supply-chain-management ;
    vc:contrastsWith ngm:reactive-control,
        ngm:reinforcement-learning ;
    vc:dependsOn ngm:knowledge-representation,
        ngm:reasoning ;
    vc:enables ngm:autonomous-agent,
        ngm:decision-making,
        ngm:robot-motion-planning ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:hierarchical-task-network,
        ngm:plan-execution,
        ngm:plan-recognition ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:optimisation,
        ngm:scheduling,
        ngm:temporal-reasoning ;
    vc:requires ngm:goal-representation,
        ngm:search-algorithm,
        ngm:state-space-representation ;
    vc:slug "planning" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:constraint-satisfaction,
        ngm:heuristic-function,
        ngm:markov-decision-process .

ngm:polkadot a owl:Class ;
    rdfs:label "Polkadot"@en ;
    rdfs:comment "Polkadot is a heterogeneous multi-chain blockchain protocol designed by Gavin Wood and developed by Parity Technologies that enables independent application-specific blockchains — called parachains — to connect to a central relay chain, share its pooled security, and exchange messages and assets through the Cross-Consensus Message (XCM) format. Its nominated proof-of-stake consensus mechanism uses DOT token validators to secure the relay chain whilst parachains benefit from shared security without needing to bootstrap their own validator sets. Polkadot is built on the Substrate framework, which allows developers to construct purpose-built WebAssembly-based runtimes supporting forkless on-chain upgrades. The protocol addresses the 'island of value' problem by providing a unified security and interoperability layer for a heterogeneous ecosystem of sovereign blockchains."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:web-assembly ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:nominated-proof-of-stake ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:validator-set ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:polkadot-parachains ],
        ngm:blockchain-protocol ;
    vc:bridgesTo ngm:decentralised-autonomous-organisation,
        ngm:decentralised-identity ;
    vc:contrastsWith ngm:avalanche,
        ngm:cosmos-ibc,
        ngm:ethereum ;
    vc:dependsOn ngm:cryptographic-primitives,
        ngm:distributed-ledger-technology ;
    vc:enables ngm:blockchain-interoperability,
        ngm:cross-chain-messaging,
        ngm:forkless-upgrades,
        ngm:on-chain-governance,
        ngm:shared-security ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:dot-token,
        ngm:polkadot-parachains,
        ngm:relay-chain,
        ngm:xcm ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:cross-chain-interoperability,
        ngm:decentralised-finance,
        ngm:kusama,
        ngm:smart-contracts,
        ngm:web3 ;
    vc:requires ngm:nominated-proof-of-stake,
        ngm:validator-set,
        ngm:web-assembly ;
    vc:slug "polkadot" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:babe-consensus,
        ngm:grandpa-finality,
        ngm:nominated-proof-of-stake,
        ngm:substrate-framework,
        ngm:web-assembly .

ngm:privacy-preserving-authentication a owl:Class ;
    rdfs:label "Privacy-Preserving Authentication"@en ;
    rdfs:comment "Privacy-preserving authentication encompasses cryptographic mechanisms that allow a party to prove identity, membership, or credential possession to a verifier without revealing the underlying identity attributes, credential content, or linkage information across sessions. Core techniques include zero-knowledge proofs, anonymous credentials (e.g., U-Prove, BBS+), blind signatures, and selective disclosure, enabling authentication that is both unforgeable and unlinkable. The goal is to satisfy verifier assurance requirements while minimising the personal data exposed in each authentication event."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:commitment-scheme ],
        ngm:authentication ;
    vc:bridgesTo ngm:data-minimisation,
        ngm:gdpr-compliance ;
    vc:contrastsWith ngm:federated-identity,
        ngm:oauth ;
    vc:enables ngm:anonymous-credential-system,
        ngm:decentralised-identity,
        ngm:unlinkable-authentication,
        ngm:verifiable-credentials ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:implements ngm:minimal-disclosure-principle,
        ngm:privacy-by-design,
        ngm:selective-disclosure ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:post-quantum-cryptography,
        ngm:privacy-preserving-identity,
        ngm:zero-knowledge-proof ;
    vc:requires ngm:commitment-scheme,
        ngm:credential-issuer,
        ngm:public-key-infrastructure ;
    vc:slug "privacy-preserving-authentication" ;
    vc:sourceDomain "security" ;
    vc:standardizedBy ngm:eidas-2,
        ngm:ietf-sd-jwt,
        ngm:w3c-verifiable-credentials-data-model ;
    vc:supports ngm:age-verification,
        ngm:digital-identity-wallet,
        ngm:self-sovereign-identity ;
    vc:uses ngm:bbs-plus-signature,
        ngm:blind-signature,
        ngm:cryptographic-proof,
        ngm:ring-signature,
        ngm:zero-knowledge-proof-zkp .

ngm:privacy-preserving-blockchain a owl:Class ;
    rdfs:label "Privacy Preserving Blockchain"@en ;
    rdfs:comment "Blockchain architectures and cryptographic protocol suites that conceal transaction metadata — sender identity, recipient identity, transferred amounts, and smart contract state — whilst preserving network verifiability, immutability, and auditability for authorised parties through an ensemble of..."@en ;
