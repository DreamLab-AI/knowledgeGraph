    vc:sourceDomain "spatial-computing" .

ngm:visual-perception a owl:Class ;
    rdfs:label "Visual Perception"@en ;
    rdfs:comment "Visual perception is a robot or agent's capability to interpret its environment from camera and visual sensor data, extracting the objects, surfaces, motion and spatial structure needed to act. It transforms raw imagery into actionable scene understanding that drives behaviours such as gaze control, manipulation and navigation. Visual perception is a core perceptual modality for embodied robotic systems."@en ;
    rdfs:subClassOf ngm:robo-perception ;
    skos:broader ngm:robo-perception ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:camera,
        ngm:gaze-control ;
    vc:slug "visual-perception" ;
    vc:sourceDomain "robotics" .

ngm:voxel a owl:Class ;
    rdfs:label "Voxel"@en ;
    rdfs:comment "A voxel is the volumetric analogue of a pixel: a discrete unit of value located on a regular three-dimensional grid that represents a sample of space, encoding attributes such as density, colour, opacity, or material. Voxels underpin volumetric data structures used in medical imaging, scientific simulation, terrain and procedural modelling, and game engines, and they can be stored efficiently in sparse structures such as octrees to skip empty space. Unlike polygon meshes that describe only surfaces, voxels represent the full interior of objects, enabling destructible geometry, fluid simulation, and direct volume rendering."@en ;
    rdfs:subClassOf ngm:volume-rendering ;
    vc:contrastsWith ngm:point-cloud,
        ngm:texture-mapping ;
    vc:enables ngm:volume-rendering ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:sparse-voxel-octree ;
    vc:isPartOf ngm:volume-rendering,
        ngm:volumetric-rendering ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:computer-graphics,
        ngm:ray-tracing,
        ngm:rendering ;
    vc:slug "voxel" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:game-engine ;
    vc:uses ngm:gpu-rendering .

ngm:w-3-c-web-xr-device-api a owl:Class ;
    rdfs:label "W3C WebXR Device API"@en ;
    rdfs:comment "The W3C WebXR Device API specifies an interface for accessing virtual reality and augmented reality devices, including sensors and head-mounted displays, in Web applications."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:w3-c ],
        ngm:technical-standard ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:w3-c ;
    vc:slug "w-3-c-web-xr-device-api" ;
    vc:sourceDomain "standards" .

ngm:w3-c-prov a owl:Class ;
    rdfs:label "W3C PROV"@en ;
    rdfs:comment "W3C PROV is a family of W3C Recommendations that define a domain-agnostic data model and serialisations for representing provenance, the records of entities, activities, and agents involved in producing or influencing a piece of data. Centred on the PROV-DM data model and PROV-O OWL ontology, it enables interoperable description of how artefacts came to be, supporting trust, reproducibility, and auditing. It is widely used in scientific workflows, data catalogues, and metadata management systems."@en ;
    rdfs:subClassOf ngm:technical-standard ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:data-management,
        ngm:metadata-management ;
    vc:slug "w3-c-prov" ;
    vc:sourceDomain "data" .

ngm:warehouse-management-system a owl:Class ;
    rdfs:label "Warehouse Management System"@en ;
    rdfs:comment "A warehouse management system (WMS) is the software platform that orchestrates and optimises the day-to-day operations of a warehouse or distribution centre, controlling receiving, putaway, storage location, inventory tracking, order picking, packing, and despatch. It maintains a real-time digital model of stock and locations, directs labour and equipment via task assignment, and integrates with enterprise resource planning, transport, and automation layers. As the control plane for intralogistics, the WMS underpins inventory accuracy, fulfilment throughput, and coordination with robotic warehouse automation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:enterprise-resource-planning ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:inventory-management ],
        ngm:inventory-management ;
    vc:bridgesTo ngm:fleet-management,
        ngm:warehouse-automation ;
    vc:dependsOn ngm:enterprise-resource-planning ;
    vc:enables ngm:logistics-management,
        ngm:warehouse-automation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:inventory-management ;
    vc:implements ngm:inventory-management ;
    vc:isPartOf ngm:supply-chain-management ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:demand-forecasting,
        ngm:logistics,
        ngm:supply-chain-management ;
    vc:requires ngm:enterprise-resource-planning ;
    vc:slug "warehouse-management-system" ;
    vc:sourceDomain "robotics" ;
    vc:supports ngm:demand-forecasting ;
    vc:uses ngm:barcode,
        ngm:rfid .

ngm:watermarking-service a owl:Class ;
    rdfs:label "Watermarking Service"@en ;
    rdfs:comment "Digital infrastructure that embeds imperceptible markers into media content to establish provenance, authenticate ownership, detect tampering, and identify AI-generated content, supporting content credentials standards like C2PA for verifiable digital asset tracking."@en ;
    rdfs:subClassOf ngm:sc-governance-and-safety ;
    skos:broader ngm:sc-governance-and-safety ;
    vc:enables ngm:digital-asset ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:implements ngm:content-authentication,
        ngm:open-standard ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:slug "watermarking-service" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:content-moderation,
        ngm:digital-rights-management,
        ngm:provenance-tracking ;
    vc:uses ngm:cryptography,
        ngm:signal-processing .

ngm:wearable-device-integration a owl:Class ;
    rdfs:label "Wearable Device Integration"@en ;
    rdfs:comment "The technical processes and protocols for connecting wearable computing devices with metaverse platforms, enterprise systems, and cloud services, enabling seamless data exchange, cross-device synchronisation, and coordinated multi-device experiences."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
