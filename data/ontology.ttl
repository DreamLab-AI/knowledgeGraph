# Bounding Volume Hierarchy
spatial-computing:BoundingVolumeHierarchy rdf:type owl:Class ;
    rdfs:subClassOf spatial-computing:SpatialDataStructure ;
    rdfs:label "Bounding Volume Hierarchy"@en ;
    rdfs:comment "A tree-structured acceleration data structure that recursively organizes geometric objects within nested bounding volumes, enabling efficient spatial queries, collision detection, and ray-scene intersection testing by rapidly culling large portions of geometry that cannot intersect with a query."@en ;
