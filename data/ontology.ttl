ngm:collaborative-systems-modality-learning a owl:Class ;
    rdfs:label "Collaborative Learning"@en ;
    rdfs:comment "An educational approach where learners work together in virtual environments, metaverse platforms, or VR spaces to achieve shared learning goals through social interaction, knowledge co-construction, and collective problem-solving enabled by immersive and embodied digital experiences."@en ;
