        ngm:rest-api,
        ngm:tool-use,
        ngm:websocket .

ngm:knowledge-graph-publication-classifier-goods-funding a owl:Class ;
    rdfs:label "Public Goods Funding"@en ;
    rdfs:comment "Public goods funding encompasses the mechanisms, institutions, and coordination protocols that allocate capital toward resources which are non-excludable and non-rival — goods whose consumption by one party does not diminish availability to others and from which no party can be practically excluded. In open digital ecosystems, this addresses a structural market failure: rational actors under-invest in shared infrastructure because they can free-ride on others' contributions. Blockchain-native primitives such as quadratic funding, retroactive grants, and DAO-managed treasuries have revived and extended classical public economics, enabling transparent, on-chain allocation of capital toward open-source software, protocol research, and collective knowledge commons. The field sits at the intersection of mechanism design, cryptoeconomics, and welfare economics, driving continuous innovation in sybil resistance, matching fund architecture, and governance legitimacy."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:on-chain-governance ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:retroactive-public-goods-funding ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:quadratic-funding ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:identity-verification ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:mechanism-design ],
        ngm:bc-defi-and-economics ;
    skos:broader ngm:bc-defi-and-economics ;
    vc:bridgesTo ngm:decentralised-autonomous-organisation,
        ngm:digital-commons ;
    vc:contrastsWith ngm:rent-seeking,
        ngm:venture-capital ;
    vc:dependsOn ngm:cryptoeconomics,
        ngm:token-governance ;
    vc:enables ngm:commons-based-peer-production,
        ngm:open-source-software,
        ngm:protocol-development ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:grants-programme,
        ngm:matching-pool,
        ngm:quadratic-funding,
        ngm:retroactive-public-goods-funding ;
    vc:qualityScore "0.0"^^xsd:float ;
