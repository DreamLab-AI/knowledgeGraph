    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:onnx ;
    vc:slug "onnx-standard" ;
    vc:sourceDomain "metaverse" .

ngm:ontology-definition a owl:Class ;
    rdfs:label "Ontology Definition"@en ;
    rdfs:comment "A formal, explicit specification of metaverse concepts, relationships, and axioms using knowledge representation frameworks (OWL, RDF, JSON-LD), defining entities through orthogonal dimensions (physicality, role) to enable semantic interoperability and automated classification across platforms. Ontologies provide foundational standards for governance, identity, and asset management, supporting machine-readable reasoning, validation, and discovery across federated and distributed systems."@en ;
    rdfs:subClassOf ngm:infra-software-engineering ;
    skos:broader ngm:infra-software-engineering ;
    vc:enables ngm:data-governance,
        ngm:interoperability,
        ngm:knowledge-graph ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:slug "ontology-definition" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:identity-management,
        ngm:metaverse-ontology ;
    vc:uses ngm:knowledge-representation,
        ngm:semantic-web-linked-data-standard .

ngm:opcodes a owl:Class ;
    rdfs:label "Opcodes"@en ;
    rdfs:comment "Opcodes (operation codes) are the atomic instruction primitives of a blockchain scripting language that define permissible computations within transaction scripts, smart contracts, or virtual machine execution environments. Each opcode specifies an operation — such as hash computation, signature verification, stack manipulation, or conditional branching — and the set of valid opcodes for a given blockchain determines its scripting expressiveness and security surface. In Bitcoin, a deliberately restricted opcode set enforces non-Turing-completeness and predictable resource consumption, whereas Ethereum's EVM opcode set supports general computation within gas-metered bounds."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:scripting-language ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:blockchain-transaction ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:script ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:consensus-mechanism ],
        ngm:bc-protocol-and-consensus,
        ngm:blockchain-entity,
        ngm:distributed-data-structure ;
    skos:broader ngm:bc-protocol-and-consensus ;
    vc:enables ngm:programmable-money,
        ngm:smart-contract,
        ngm:smart-contract-execution ;
