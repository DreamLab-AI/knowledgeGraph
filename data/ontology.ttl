    vc:slug "harm-taxonomy" ;
    vc:sourceDomain "governance" .

ngm:harmonic-drive a owl:Class ;
    rdfs:label "Harmonic Drive"@en ;
    rdfs:comment "A harmonic drive is a strain-wave gearing mechanism that achieves very high reduction ratios in a compact, lightweight package with near-zero backlash. It uses a flexible spline deformed by an elliptical wave generator to mesh with a rigid outer gear, transmitting motion with high precision. Harmonic drives are widely used in robot joints, where accuracy and torque density are critical."@en ;
    rdfs:subClassOf ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:mechanical-component ;
    vc:slug "harmonic-drive" ;
    vc:sourceDomain "robotics" .

ngm:hashcash a owl:Class ;
    rdfs:label "Hashcash"@en ;
    rdfs:comment "Hashcash is a proof-of-work system invented by Adam Back in 1997 that requires a sender to compute a partial SHA-1 (later SHA-256) hash collision by finding a nonce such that the resulting digest has a specified number of leading zero bits. The asymmetry between expensive computation and cheap verification makes it suitable as an anti-abuse token: the sender bears a measurable cost while the recipient verifies in microseconds. Originally designed to combat email spam and denial-of-service attacks, the mechanism was directly adopted by Bitcoin as the basis of its mining consensus algorithm, making Hashcash one of the foundational primitives of the blockchain era."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:nonce ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptographic-hash-function ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:sha-256 ],
        ngm:proof-of-work ;
    vc:bridgesTo ngm:blockchain,
        ngm:distributed-consensus ;
    vc:contrastsWith ngm:captcha,
        ngm:proof-of-space,
        ngm:proof-of-stake ;
    vc:enables ngm:bitcoin-proof-of-work-protocol-mining,
        ngm:rate-limiting,
        ngm:spam-prevention ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:proof-of-work ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:bitcoin-protocol,
        ngm:consensus-mechanism,
        ngm:difficulty-adjustment,
        ngm:merkle-tree,
        ngm:mining ;
    vc:requires ngm:cryptographic-hash-function,
        ngm:nonce,
        ngm:sha-256 ;
    vc:slug "hashcash" ;
    vc:sourceDomain "security" ;
    vc:supports ngm:sybil-resistance ;
    vc:uses ngm:hash-function,
        ngm:preimage-resistance .

ngm:healthcare a owl:Class ;
    rdfs:label "Healthcare"@en ;
    rdfs:comment "Healthcare is the organised provision of medical services, preventive care, diagnostics, treatment, and rehabilitation to individuals and populations. It encompasses clinical practice, health informatics, medical devices, pharmaceutical supply chains, and public health systems. As an application domain for AI and spatial computing, healthcare is distinguished by stringent regulatory requirements, sensitivity of patient data, and direct impact on human wellbeing."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
