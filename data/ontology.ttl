    vc:requires ngm:rdf ;
    vc:slug "rdf-schema" ;
    vc:sourceDomain "standards" .

ngm:real-time-inference a skos:Concept ;
    rdfs:label "Real Time Inference"@en .

ngm:real-time-inference-at-edge a owl:Class ;
    rdfs:label "Real-Time Inference at Edge"@en ;
    rdfs:comment "The execution of machine learning inference on edge devices under deterministic latency constraints, typically P99 latency below 10–100 ms, to support safety-critical and time-sensitive applications. Achieves real-time performance through hardware accelerators (NPUs, FPGAs, ASICs), model compression, and priority scheduling without reliance on cloud round-trips."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:embedded-systems ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:edge-computing ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:model-compression-for-edge ],
        ngm:ai-infrastructure ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:edge-ai-system,
        ngm:knowledge-distillation-for-edge,
        ngm:model-pruning-for-edge-deployment ;
    vc:requires ngm:edge-computing,
        ngm:embedded-systems,
        ngm:model-compression-for-edge ;
    vc:slug "real-time-inference-at-edge" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:edge-ai-accelerator,
        ngm:fpga,
        ngm:latency-aware-edge-ai,
        ngm:npu .

ngm:recursive-self-improvement a owl:Class ;
    rdfs:label "Recursive Self-Improvement"@en ;
    rdfs:comment "Recursive self-improvement (RSI) is a theoretical AI capability in which a system autonomously identifies and implements modifications to its own architecture, training procedure, or objective function that result in increased performance or capability, such that each improvement cycle enables further improvements in a self-amplifying feedback loop. This process is conjectured to be a pathway to artificial superintelligence if left unconstrained, as successive capability doublings could occur faster than human oversight can track. RSI is a central concern in AI safety research because systems capable of recursive self-improvement may rapidly violate designers' assumptions about capability bounds and alignment properties."@en ;
    rdfs:subClassOf ngm:ai-governance-and-ethics ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:contrastsWith ngm:ai-safety-research ;
    vc:enables ngm:self-improvement ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:ai-alignment,
        ngm:ai-safety,
        ngm:value-alignment ;
    vc:slug "recursive-self-improvement" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:reed-solomon-codes a owl:Class ;
    rdfs:label "Reed-Solomon Codes"@en ;
    rdfs:comment "Reed-Solomon codes are a class of non-binary, cyclic, block error-correcting codes defined over finite fields (Galois fields), capable of correcting both erasures and symbol errors with provably optimal efficiency at the Singleton bound. Introduced by Irving Reed and Gustave Solomon in 1960, they treat data blocks as polynomials over a finite field and encode them by evaluating the polynomial at multiple distinct points, allowing the original polynomial to be reconstructed from any sufficient subset of evaluation points. Reed-Solomon codes underpin data reliability in storage media (CDs, DVDs, RAID), satellite communications, QR codes, and are foundational to erasure-coded distributed storage and modern polynomial commitment schemes used in zero-knowledge proofs."@en ;
    rdfs:subClassOf ngm:error-correction ;
    vc:enables ngm:data-integrity,
        ngm:fault-tolerance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:data-availability,
        ngm:distributed-storage,
        ngm:erasure-coding ;
    vc:slug "reed-solomon-codes" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:blockchain,
        ngm:cryptographic-proof .

ngm:responsible-ai-principles a owl:Class ;
    rdfs:label "Responsible AI Principles"@en ;
    rdfs:comment "Foundational ethical commitments and normative guidelines governing AI system design, development, deployment, and monitoring to ensure beneficial, fair, and rights-respecting outcomes. Core principles—including fairness, transparency, accountability, privacy, safety, and human oversight—are operationalised through frameworks such as the OECD AI Principles, the EU Ethics Guidelines for Trustworthy AI, and UNESCO's Recommendation on the Ethics of AI."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:ai-alignment ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:accountability ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:ai-fairness ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:ai-safety ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:transparency-and-explainability ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:human-oversight ],
        ngm:ai-ethics,
        ngm:ai-governance-and-ethics ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:accountability,
        ngm:ai-alignment,
        ngm:ai-fairness,
        ngm:ai-safety,
        ngm:human-oversight,
        ngm:transparency-and-explainability ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:ai-governance,
        ngm:algorithmic-bias,
        ngm:bias-mitigation-techniques,
        ngm:differential-privacy,
        ngm:explainability ;
    vc:slug "responsible-ai-principles" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:responsible-scaling-policy a owl:Class ;
    rdfs:label "Responsible Scaling Policy"@en ;
    rdfs:comment "A Responsible Scaling Policy (RSP) is a voluntary self-regulatory commitment by a frontier AI developer that ties further capability scaling and deployment to measurable safety milestones. It specifies: the capability evaluation thresholds (often called AI Safety Levels) at which enhanced assessments must be completed before training or deploying a more capable model; the specific risk domains—particularly uplift to chemical, biological, radiological, nuclear, and cyberweapon development—that would trigger deployment restrictions or halts; and the technical and organisational safeguards required at each level. RSPs translate aspirational safety intentions into concrete, time-bound, falsifiable commitments, creating accountability mechanisms that operate ahead of formal government regulation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:red-teaming ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:risk-assessment ],
        ngm:ai-governance-framework ;
    vc:bridgesTo ngm:biosecurity,
        ngm:nuclear-non-proliferation ;
    vc:contrastsWith ngm:compute-governance,
        ngm:mandatory-ai-regulation ;
    vc:dependsOn ngm:frontier-model,
        ngm:interpretability ;
    vc:enables ngm:ai-safety,
        ngm:incremental-deployment,
        ngm:model-accountability ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:implements ngm:ai-governance-and-ethics,
        ngm:precautionary-principle ;
    vc:qualityScore "0.73"^^xsd:float ;
    vc:relatedTo ngm:ai-safety-institute,
        ngm:cbrn-risk,
        ngm:deployment-policy,
        ngm:frontier-model-forum,
        ngm:model-card ;
    vc:requires ngm:capability-evaluation,
        ngm:red-teaming,
        ngm:risk-assessment,
        ngm:third-party-audit ;
    vc:slug "responsible-scaling-policy" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:ai-alignment,
        ngm:ai-regulation,
        ngm:existential-risk-reduction ;
    vc:uses ngm:biosafety-level-framework,
        ngm:model-evals,
        ngm:uplift-evaluation .

ngm:risk a owl:Class ;
    rdfs:label "Risk"@en ;
    rdfs:comment "The potential for an AI system or associated process to cause harm, produce unintended outcomes, or fail to achieve intended goals. Risk in AI encompasses technical failure modes, bias, adversarial vulnerabilities, misuse, and broader societal harms; risk management frameworks characterise likelihood and severity to prioritise mitigations."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:adversarial-attack ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
