ngm:rollback a owl:Class ;
    rdfs:comment "Rollback is the operation of restoring a system, workspace, or agent to a previously captured good state, discarding the changes made since that point after an error, failed action, or unwanted outcome. It depends on the earlier capture of restorable state — a checkpoint, a snapshot, or a version-control commit — and on the changes since being either reversible or discardable. In autonomous-agent orchestration, rollback lets a supervisor undo a subagent's destructive or incorrect edits and retry from a known-safe baseline, turning risky irreversible automation into a recoverable, bounded-blast-radius process."@en ;
    rdfs:label "Rollback"@en ;
    rdfs:subClassOf ngm:error-recovery ;
    rdfs:subClassOf ngm:errorrecovery ;
    rdfs:subClassOf _:r18562 ;
