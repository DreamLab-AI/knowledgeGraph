        ngm:self-sovereign-identity ;
    vc:contrastsWith ngm:privacy-preserving-computation ;
    vc:dependsOn ngm:blockchain,
        ngm:verifiable-credentials ;
    vc:enables ngm:audit-trail,
        ngm:kyc-aml,
        ngm:regulatory-reporting,
        ngm:sanctions-screening ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:aml,
        ngm:sanctions-screening ;
    vc:implements ngm:fatf-recommendations,
