ngm:pruned-node a owl:Class ;
    rdfs:label "Pruned Node"@en ;
    rdfs:comment "A Pruned Node is a blockchain full node that validates the complete chain history during initial block download but subsequently discards spent transaction outputs and old block data beyond a configurable retention window, reducing on-disk storage requirements by orders of magnitude while retaining full validation capability for new blocks. Pruning enables operators with limited storage (e.g. 5–10 GB rather than 500+ GB for Bitcoin's full history) to participate in consensus verification without trusting third parties, unlike SPV light nodes that skip validation entirely. The pruned node can no longer serve historical block data to peers, constraining its contribution to network archival."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:blockchain ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptographic-hash-function ],
        ngm:bc-network-component,
        ngm:blockchain-entity,
        ngm:network-component ;
    skos:broader ngm:bc-network-component ;
    vc:contrastsWith ngm:archival-node ;
    vc:dependsOn ngm:data-storage ;
    vc:enables ngm:blockchain-scalability,
        ngm:consensus-mechanism ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:blockchain-network ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:archival-node,
        ngm:full-node,
        ngm:light-node,
        ngm:utxo-model ;
    vc:requires ngm:blockchain,
        ngm:cryptographic-hash-function ;
    vc:slug "pruned-node" ;
    vc:sourceDomain "blockchain" .

