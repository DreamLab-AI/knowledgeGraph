        <urn:visionflow:linked:consensus-service>,
        <urn:visionflow:linked:identity-management-integration>,
        <urn:visionflow:linked:ledger-storage>,
        <urn:visionflow:linked:managed-node-hosting>,
        <urn:visionflow:linked:network-provisioning-templates>,
        <urn:visionflow:linked:smart-contract-deployment-pipeline>,
        vf:monitoring-dashboard ;
    vc:implements <urn:visionflow:linked:crash-fault-tolerance>,
        <urn:visionflow:linked:fisco-bcos>,
        <urn:visionflow:linked:quorum>,
        <urn:visionflow:linked:raft-consensus>,
        <urn:visionflow:linked:smart-bft>,
        vf:byzantine-fault-tolerance,
        vf:ethereum,
        vf:hyperledger-besu,
        vf:hyperledger-fabric,
        vf:r3-corda ;
    vc:maturity "production-ready" ;
