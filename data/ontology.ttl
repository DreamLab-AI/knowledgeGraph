ngm:node-independent-validation-pbft a owl:Class ;
    rdfs:label "Node-Independent Validation PBFT"@en ;
    rdfs:comment "Node-Independent Validation PBFT is a variant of Practical Byzantine Fault Tolerance in which each validator independently verifies transaction validity without delegating validation authority to a designated primary node, eliminating the single point of failure inherent in classical PBFT's primary-replica model. By distributing validation responsibility uniformly across all consensus participants, the protocol improves resilience against primary node compromise and reduces the attack surface for Byzantine behaviour in consortium and enterprise blockchain deployments."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:byzantine-fault-tolerance ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:fault-tolerance ],
        ngm:bc-protocol-and-consensus,
        ngm:practical-byzantine-fault-tolerance ;
    skos:broader ngm:bc-protocol-and-consensus ;
    vc:contrastsWith ngm:nakamoto-consensus ;
    vc:enables ngm:consensus-algorithm,
        ngm:finality ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:byzantine-fault-tolerant-system,
        ngm:double-spending,
        ngm:gasper-consensus,
        ngm:tendermint-consensus,
        ngm:validator-node ;
    vc:requires ngm:byzantine-fault-tolerance,
        ngm:fault-tolerance ;
    vc:slug "node-independent-validation-pbft" ;
    vc:sourceDomain "blockchain" .

ngm:non-genesis-block a owl:Class ;
    rdfs:label "Non Genesis Block"@en ;
    rdfs:comment "A Non Genesis Block is any block in a blockchain with a block height greater than zero—that is, every block produced after the genesis (first) block. Non-genesis blocks are structurally identical to the genesis block in terms of their header and transaction payload format, but they include a previous block hash field that cryptographically links them to their parent, forming the immutable chain structure. The vast majority of blocks in any mature blockchain are non-genesis blocks; they carry the transaction history and consensus record that gives the chain its economic value."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptographic-hash ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:blockchain-transaction ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:merkle-root ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:block-header ],
        ngm:bc-protocol-and-consensus,
        ngm:block ;
    skos:broader ngm:bc-protocol-and-consensus ;
    vc:contrastsWith ngm:genesis-block ;
    vc:enables ngm:transaction-confirmation,
        ngm:transaction-finality ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:blockchain-transaction,
        ngm:merkle-root ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:block-height,
        ngm:block-reward,
        ngm:block-time,
        ngm:blockchain,
        ngm:genesis-block ;
    vc:requires ngm:block-header,
        ngm:cryptographic-hash ;
    vc:slug "non-genesis-block" ;
    vc:sourceDomain "blockchain" .

ngm:nostr-relay-endpoint-registry a owl:Class ;
    rdfs:label "Nostr Relay Endpoint Registry"@en ;
    rdfs:comment "A Nostr relay list is a curated or automatically discovered list of WebSocket relay server endpoints that a Nostr client uses to publish and subscribe to signed events. Because Nostr has no centralised routing, a client's relay list determines its social graph reach: events are broadcast to all listed relays, and the client pulls its feed from the same set. Relay lists are stored as NIP-65 kind:10002 events on the network itself, enabling portable relay preferences that travel with the user's public key across clients."@en ;
    rdfs:subClassOf ngm:bc-network-component ;
    skos:broader ngm:bc-network-component ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:nostr-protocol ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:decentralized-storage,
        ngm:did-nostr-identity,
        ngm:peer-to-peer-network,
        ngm:relayer ;
    vc:slug "nostr-relay-endpoint-registry" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:gossip-protocol,
        ngm:web-socket .

ngm:octave-immersive-research-facility a owl:Class ;
    rdfs:label "Octave Immersive Research Facility"@en ;
    rdfs:comment "A world-class multi-modal immersive research facility at the University of Salford housing advanced display topologies, high-performance compute, and distributed systems for mixed reality, generative AI, and human-scale VR experimentation. The lab supported over 25 years of research including world firsts in collaborative mixed reality, brain scanning in phobia treatment, real-time human reconstruction from cameras, and telepresence, and served hundreds of SMEs through ERDF-funded programmes."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:immersive-technology ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:mixed-reality ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:hardware-and-edge ],
        ngm:infra-computing-and-cloud ;
    skos:broader ngm:infra-computing-and-cloud ;
    vc:enables ngm:digital-twin,
        ngm:generative-ai,
        ngm:telepresence ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:hardware-and-edge,
        ngm:immersive-technology,
        ngm:mixed-reality ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:slug "octave-immersive-research-facility" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:distributed-computing,
        ngm:gpu-compute .

ngm:octocopter a owl:Class ;
    rdfs:label "Octocopter"@en ;
    rdfs:comment "An Octocopter is a multirotor unmanned aerial vehicle (UAV) equipped with eight independently controlled rotors arranged symmetrically around a central frame, providing significant redundancy that allows continued stable flight after individual motor failure. The eight-rotor configuration enables lift capacity substantially exceeding that of quadcopters or hexacopters, making it the preferred platform for heavy industrial payloads such as professional cinema cameras, LiDAR scanners, and precision agricultural dispensers."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:robotics-control ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:autonomous-navigation ],
        ngm:multirotor-uav,
        ngm:robo-robot-type ;
    skos:broader ngm:robo-robot-type ;
    vc:contrastsWith ngm:quadcopter ;
    vc:enables ngm:aerial-robot,
        ngm:inspection-robot ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:autonomous-navigation,
        ngm:robotics-control ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:autonomous-vehicle,
        ngm:robotics,
        ngm:robotics-application,
        ngm:robotics-platform ;
    vc:slug "octocopter" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:autonomous-navigation,
        ngm:swarm-robotics .

ngm:oma-3-media-wg a owl:Class ;
    rdfs:label "OMA3 Media WG"@en ;
    rdfs:comment "A working group within the Open Metaverse Alliance for Web3 (OMA3) focused on media-related interoperability standards for metaverse and Web3 applications. It coordinates specifications among member organisations."@en ;
