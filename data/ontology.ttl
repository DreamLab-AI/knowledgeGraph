            owl:someValuesFrom ngm:cryptographic-signature ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:finality-gadget ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:quorum ],
        ngm:consensus-mechanism ;
    vc:bridgesTo ngm:ai-energy-optimisation,
        ngm:multi-agent-systems ;
    vc:contrastsWith ngm:crash-fault-tolerance,
        ngm:proof-of-work ;
    vc:dependsOn ngm:network-synchrony,
        ngm:public-key-cryptography ;
    vc:enables ngm:consensus,
        ngm:deterministic-finality,
        ngm:fault-tolerance,
        ngm:state-machine-replication ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:finality-gadget,
        ngm:leader-election,
        ngm:voting-round ;
    vc:implements ngm:hotstuff-protocol,
        ngm:practical-byzantine-fault-tolerance ;
    vc:isPartOf ngm:blockchain,
        ngm:distributed-systems ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:casper-ffg,
        ngm:proof-of-stake,
        ngm:validator-set ;
    vc:requires ngm:cryptographic-signature,
        ngm:distributed-agreement,
        ngm:message-authentication,
        ngm:quorum ;
    vc:slug "byzantine-fault-tolerance" ;
    vc:sourceDomain "distributed-systems" .

ngm:knowledge-representation a owl:Class ;
    rdfs:label "Knowledge Representation"@en ;
    rdfs:comment "Knowledge Representation in AI involves the formal encoding of information about the world in a computationally tractable format that enables reasoning, inference, and decision-making. Approaches include symbolic systems (first-order logic, description logics, semantic networks), graph-based representations (knowledge graphs, ontologies), probabilistic models (Bayesian networks, Markov logic networks), and distributed representations (embeddings, neural-symbolic integration)."@en ;
