ngm:biometric-authentication a owl:Class ;
    rdfs:label "Biometric Authentication"@en ;
    rdfs:comment "Biometric authentication is an identity verification method that uses measurable, unique physiological or behavioural characteristics of an individual — such as fingerprints, facial geometry, iris patterns, voice, or behavioural signals like keystroke dynamics — to confirm the claimed identity of a subject. Unlike password-based or token-based mechanisms, biometric credentials are inherent to the individual and cannot be forgotten, shared, or easily replicated, though they introduce irreversibility concerns because compromised biometric data cannot be reset. A complete system comprises enrolment, secure template storage (typically on-device in a secure enclave), a matching engine evaluated by false acceptance rate and false rejection rate, and presentation attack detection to counter spoofing. Biometric authentication underpins modern identity assurance frameworks such as FIDO2/WebAuthn, eIDAS 2.0 digital identity wallets, and biometric border control systems worldwide."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:hardware-security-module ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-protection ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:privacy-by-design ],
        ngm:authentication ;
    vc:bridgesTo ngm:machine-learning,
        ngm:on-device-inference ;
    vc:contrastsWith ngm:password-authentication,
        ngm:token-based-authentication ;
    vc:enables ngm:continuous-authentication,
        ngm:digital-identity-verification,
        ngm:multi-factor-authentication,
        ngm:passwordless-authentication,
        ngm:zero-trust-security ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:fido2,
        ngm:webauthn ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:facial-recognition,
        ngm:gdpr,
        ngm:identity-management,
        ngm:self-sovereign-identity ;
    vc:requires ngm:data-protection,
        ngm:hardware-security-module,
        ngm:privacy-by-design ;
    vc:slug "biometric-authentication" ;
    vc:sourceDomain "security" ;
    vc:uses ngm:biometric-binding-mechanism,
        ngm:biometric-verification,
        ngm:feature-extraction,
        ngm:presentation-attack-detection,
        ngm:secure-enclave .

ngm:blockchain-economics a owl:Class ;
    rdfs:label "Blockchain Economics"@en ;
    rdfs:comment "The study and design of economic mechanisms governing blockchain networks, including incentive structures for validators, fee markets, token supply schedules, governance models, and the emergent macro-economic properties of decentralised systems. Blockchain economics integrates mechanism design, game theory, and monetary theory to sustain network security and participant alignment."@en ;
