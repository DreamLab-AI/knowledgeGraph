    vc:slug "tee" ;
    vc:sourceDomain "information-security" .

ngm:telecollaboration-and-telepresence a owl:Class ;
    rdfs:label "Telecollaboration and Telepresence"@en ;
    rdfs:comment "Telecollaboration and Telepresence are complementary technologies enabling geographically distributed participants to share a common virtual or augmented workspace with a sense of physical co-presence. They combine real-time audiovisual communication, spatial audio, avatar embodiment, and low-latency networking to support synchronous collaborative tasks across professional, educational, and social domains."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:latency ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:video-conferencing ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:network-protocol ],
        ngm:sc-platform-and-environment,
        ngm:telepresence ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:enables ngm:distributed-work,
        ngm:immersive-communication,
        ngm:robotic-telepresence ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:requires ngm:latency,
        ngm:network-protocol,
        ngm:video-conferencing ;
    vc:slug "telecollaboration-and-telepresence" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:avatar,
        ngm:extended-reality .

ngm:telemedicine a owl:Class ;
    rdfs:label "Telemedicine"@en ;
    rdfs:comment "Telemedicine is the delivery of clinical healthcare services — including diagnosis, consultation, monitoring, and treatment guidance — at a distance using telecommunications technology such as video conferencing, secure messaging, and remote sensing devices. It encompasses synchronous consultations (live video visits), asynchronous store-and-forward exchanges (images, test results), and remote patient monitoring (RPM) using wearable sensors and IoT devices. Telemedicine dramatically expands access to specialist care for patients in rural, underserved, or mobility-constrained situations."@en ;
    rdfs:subClassOf ngm:healthcare-technology ;
    vc:enables ngm:clinical-decision-support,
        ngm:precision-medicine,
        ngm:remote-work ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:healthcare-records,
        ngm:medical-ai,
        ngm:wearable-device-integration ;
    vc:slug "telemedicine" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:healthcare-ai,
        ngm:io-t-sensor-network,
        ngm:video-conferencing .

ngm:teleoperation-systems a owl:Class ;
    rdfs:label "Teleoperation Systems"@en ;
    rdfs:comment "Teleoperation Systems are robotic control architectures enabling human operators to command and manipulate remote robots through master-slave or supervisory interfaces, transmitting operator intentions to robot actuators whilst providing sensory feedback (visual, auditory, haptic) from the robot to the operator, creating bidirectional human-machine coupling for remote physical interaction."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:haptic-feedback ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:haptic-feedback-telepresence ],
        ngm:dc-telepresence,
        ngm:robotic-telepresence ;
    skos:broader ngm:dc-telepresence ;
    vc:enables ngm:presence,
        ngm:social-presence ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:haptic-feedback,
        ngm:haptic-feedback-telepresence ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:encoder,
        ngm:haptics,
        ngm:robotic-telepresence,
        ngm:robotics-telepresence-bridge ;
    vc:slug "teleoperation-systems" ;
    vc:sourceDomain "distributed-collaboration" ;
    vc:uses ngm:actuator,
        ngm:feedback-control,
        ngm:human-robot-interaction .

ngm:tensor-flow-lite a owl:Class ;
    rdfs:label "TensorFlow Lite"@en ;
    rdfs:comment "TensorFlow Lite is a framework from Google for running machine learning models on mobile, embedded, and edge devices with reduced memory and computational requirements."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:machine-learning ],
        ngm:machine-learning-framework ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:machine-learning ;
    vc:slug "tensor-flow-lite" ;
    vc:sourceDomain "machine-learning" .

ngm:tessera a owl:Class ;
    rdfs:label "Tessera"@en ;
    rdfs:comment "Tessera is a private-transaction manager used with the Quorum enterprise Ethereum client to store and exchange encrypted payloads between authorised parties off the main chain. It enables confidential smart-contract state by keeping private data outside public blocks while anchoring only encrypted hashes on-chain. Tessera is a key component for enterprises that need permissioned, privacy-preserving distributed-ledger deployments."@en ;
    rdfs:subClassOf ngm:bc-network-component ;
    skos:broader ngm:bc-network-component ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:enterprise-smart-contracts,
        ngm:quorum-blockchain ;
    vc:slug "tessera" ;
    vc:sourceDomain "blockchain" .

ngm:text-to-video-generation a owl:Class ;
    rdfs:label "Text-to-Video Generation"@en ;
    rdfs:comment "Text-to-video generation is a generative-AI task in which a model synthesises a coherent video clip directly from a natural-language description. It extends text-to-image diffusion and transformer methods with temporal modelling so that motion, object permanence, and scene consistency hold across frames. The field advanced rapidly with large latent-diffusion and spatiotemporal-transformer models capable of producing seconds of high-fidelity footage from a prompt."@en ;
    rdfs:subClassOf ngm:generative-ai ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:ai-video,
        ngm:proprietary-ai-video ;
    vc:slug "text-to-video-generation" ;
    vc:sourceDomain "ai" .

ngm:textual-inversion a owl:Class ;
    rdfs:label "Textual Inversion"@en ;
    rdfs:comment "Textual inversion is a fine-tuning technique for text-to-image diffusion models that learns a new embedding vector for a placeholder token from a handful of example images, capturing a specific subject or style without altering the model weights. The learned pseudo-word can then be composed into prompts like any ordinary token. It is lightweight and shareable because only a small embedding, not the full network, is trained."@en ;
    rdfs:subClassOf ngm:parameter-efficient-fine-tuning ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:generative-model,
        ngm:kohya-dreambooth-and-similar ;
    vc:slug "textual-inversion" ;
    vc:sourceDomain "ai" .

ngm:third-party-risk-management a owl:Class ;
    rdfs:label "Third-Party Risk Management"@en ;
    rdfs:comment "Third-party risk management (TPRM) is the discipline of identifying, assessing, and controlling the risks an organisation inherits from vendors, suppliers, and other external partners. It covers due diligence, contractual controls, ongoing monitoring, and offboarding across security, compliance, operational, and reputational dimensions. TPRM has become essential as organisations rely on extended ecosystems of cloud services and outsourced functions."@en ;
    rdfs:subClassOf ngm:regulatory-compliance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:compliance-control,
        ngm:supply-chain-security ;
    vc:slug "third-party-risk-management" ;
    vc:sourceDomain "governance" .

ngm:time-sensitive-networking a owl:Class ;
    rdfs:label "Time-Sensitive Networking"@en ;
    rdfs:comment "Time-Sensitive Networking (TSN) is a set of IEEE 802.1 standards that add deterministic, bounded-latency delivery to standard Ethernet, enabling time-critical and best-effort traffic to share the same network. TSN provides precise time synchronisation, traffic scheduling, frame preemption, and reservation mechanisms so that control-loop and audio-video data arrive within guaranteed time windows. It is foundational to industrial automation, automotive in-vehicle networks, and professional media, replacing proprietary fieldbuses with converged standard Ethernet."@en ;
    rdfs:subClassOf ngm:network-protocol ;
    vc:enables ngm:interoperability ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:communication-protocol,
        ngm:networking-standard ;
    vc:slug "time-sensitive-networking" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:clock-synchronization .

ngm:tlv-encoding a owl:Class ;
    rdfs:label "TLV Encoding"@en ;
    rdfs:comment "Type-Length-Value (TLV) encoding is a compact, extensible binary serialisation scheme in which each data field is represented by a type identifier, a length descriptor, and the value payload. Its self-describing structure allows parsers to skip unknown record types while preserving forward and backward compatibility, which is why protocols such as Lightning and Taproot Assets use it to embed optional metadata in transaction records."@en ;
    rdfs:subClassOf ngm:bc-protocol-and-consensus ;
    skos:broader ngm:bc-protocol-and-consensus ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:taproot-assets ;
    vc:slug "tlv-encoding" ;
    vc:sourceDomain "blockchain" .

ngm:tool-augmented-reasoning a owl:Class ;
    rdfs:label "Tool-Augmented Reasoning"@en ;
    rdfs:comment "Tool-augmented reasoning is an approach in which a language model invokes external tools such as calculators, search or code execution to solve tasks beyond its parametric knowledge. The model interleaves reasoning steps with tool calls."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:tool-use ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:reasoning ],
        ngm:reasoning ;
    vc:enables ngm:agentic-ai ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:reasoning,
        ngm:tool-use ;
    vc:slug "tool-augmented-reasoning" ;
    vc:sourceDomain "ai" .

ngm:tracking-hardware a owl:Class ;
    rdfs:label "Tracking Hardware"@en ;
    rdfs:comment "Tracking Hardware comprises the physical sensors and devices used to determine the position and orientation of users, controllers, and objects within spatial computing environments. This includes inertial measurement units, optical trackers, hand-tracking cameras, eye-tracking modules, and SLAM-based inside-out tracking systems that together provide the 6-DoF pose data essential for immersive VR/AR experiences."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:optical-tracking ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:inertial-measurement-unit ],
        ngm:sc-interaction,
        ngm:tracking-technology ;
    skos:broader ngm:sc-interaction ;
    vc:enables ngm:eye-tracking,
        ngm:hand-tracking ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:inertial-measurement-unit,
        ngm:optical-tracking ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:slug "tracking-hardware" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:sensor-fusion,
        ngm:slam .

ngm:training-data-repository a owl:Class ;
    rdfs:label "Training Data Repository"@en ;
    rdfs:comment "A centralized or distributed storage system for collecting, organizing, versioning, and managing datasets used to train AI and machine learning models, including data provenance tracking, quality assurance, and access control."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:training-data ],
        [ a owl:Restriction ;
