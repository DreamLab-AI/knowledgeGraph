ngm:distributed-validator-technology a owl:Class ;
    rdfs:comment "Distributed Validator Technology (DVT) splits the signing key and duties of a single blockchain validator across multiple independent nodes, so that consensus on each validator action requires threshold agreement among the participating operators. It uses threshold cryptography to reconstruct or aggregate signatures without any single node holding the complete private key, removing single points of failure. DVT is used in proof-of-stake networks such as Ethereum to improve validator fault tolerance, decentralisation, and resilience against slashing from individual node outages."@en ;
    rdfs:label "Distributed Validator Technology"@en ;
    rdfs:subClassOf ngm:validator ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:slug "distributed-validator-technology" ;
    vc:sourceDomain "blockchain" .
