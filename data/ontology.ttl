# Federation Surface
infrastructure:FederationSurface rdf:type owl:Class ;
    rdfs:label "Federation Surface"@en ;
    rdfs:comment "A standardised JSON-LD 1.1 encoding surface (S1–S11) that exposes agent state, credentials, events, and work metadata in a queryable, linkable format, enabling federated consumption by heterogeneous external systems (monitoring dashboards, compliance audits, blockchain oracles, knowledge graphs) without agent-specific API adapters."@en ;
    skos:prefLabel "Federation Surface"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:infrastructure:federation-surface" ;
