        ngm:supervised-learning,
        ngm:unsupervised-learning ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:distributed-training,
        ngm:gradient-clipping,
        ngm:learning-rate-schedule,
        ngm:machine-learning,
        ngm:mixed-precision-training,
        ngm:optimization-algorithm,
        ngm:transfer-learning ;
    vc:requires ngm:loss-function,
        ngm:neural-network ;
    vc:slug "training-method" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:translation a owl:Class ;
    rdfs:label "Translation"@en ;
    rdfs:comment "Machine Translation (MT) is the automated conversion of natural language text or speech from a source language into semantically and pragmatically equivalent target language output, evolving from rule-based symbolic approaches (RBMT, 1950s-1990s) through statistical phrase-based models (SMT, Mose..."@en ;
