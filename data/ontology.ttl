ngm:real-time-transcription a owl:Class ;
    rdfs:label "Real-time Transcription"@en ;
    rdfs:comment "Real-time transcription is the automated conversion of streaming audio to text with latency sufficiently low (typically below 500 ms word latency) to support synchronous human use cases such as live captioning, voice-controlled interfaces, meeting assistance, and broadcast subtitling. It requires streaming automatic speech recognition (ASR) architectures that produce partial and final hypotheses incrementally as audio frames arrive, rather than processing complete utterances offline. Modern systems combine acoustic models (typically based on conformer or whisper-encoder architectures), language models for hypothesis rescoring, and punctuation/formatting post-processors to produce readable output in real time."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:real-time-processing ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:automatic-speech-recognition ],
        ngm:ai-application ;
    skos:broader ngm:ai-application ;
    vc:enables ngm:accessibility,
        ngm:voice-interaction ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:natural-language-processing,
        ngm:speech-recognition ;
    vc:requires ngm:automatic-speech-recognition,
        ngm:real-time-processing ;
    vc:slug "real-time-transcription" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:reasoning-engine a owl:Class ;
    rdfs:label "Reasoning Engine"@en ;
    rdfs:comment "A reasoning engine is a software component that derives new conclusions from a body of knowledge by applying logical inference rules, probabilistic methods, or learned heuristics. Classical reasoning engines operate over symbolic knowledge bases using forward or backward chaining, description-logic subsumption, or constraint solving, while modern neuro-symbolic and LLM-based engines combine learned language representations with structured tool use and search. Reasoning engines power expert systems, semantic-web query answering, automated planning, and multi-step problem solving in agentic AI systems."@en ;
    rdfs:subClassOf ngm:reasoning ;
    vc:enables ngm:chain-of-thought,
        ngm:multi-step-reasoning ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:llm-agents,
        ngm:semantic-web-linked-data-standard ;
    vc:slug "reasoning-engine" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:knowledge-graph .

ngm:recommendation-engine a owl:Class ;
    rdfs:label "Recommendation Engine"@en ;
    rdfs:comment "A recommendation engine is a system that filters, ranks, and surfaces content or items most relevant to an individual user by analysing preferences, behaviour history, and contextual signals. It employs collaborative filtering, content-based filtering, or hybrid deep-learning approaches to personalise discovery at scale across e-commerce, media, and metaverse platforms."@en ;
    rdfs:subClassOf ngm:infra-computing-and-cloud ;
    skos:broader ngm:infra-computing-and-cloud ;
    vc:dependsOn ngm:data-pipeline,
        ngm:deep-learning ;
    vc:enables ngm:information-retrieval,
        ngm:predictive-personalization ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:search-technology ;
    vc:slug "recommendation-engine" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:embedding-model,
        ngm:machine-learning-discipline .

ngm:reliability a owl:Class ;
    rdfs:label "Reliability"@en ;
    rdfs:comment "The degree to which an AI system performs its intended function consistently and accurately over time and across repeated operations, producing predictable and dependable results under specified conditions."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:testing ],
        [ a owl:Restriction ;
