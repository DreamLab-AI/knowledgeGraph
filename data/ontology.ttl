ngm:leaderboard a owl:Class ;
    rdfs:comment "A leaderboard is a public, continuously updated ranking of systems or models against a shared benchmark dataset and fixed evaluation protocol, typically reporting standardised metrics on held-out test sets. Leaderboards make model comparison transparent and reproducible, drive competitive progress in machine learning and adjacent fields, and increasingly incorporate human preference voting — whilst also inviting over-fitting, benchmark gaming and metric myopia when rankings are treated as ends in themselves."@en ;
    rdfs:label "Leaderboard"@en ;
    rdfs:subClassOf ngm:benchmark-evaluation ;
    vc:dependsOn ngm:benchmark-dataset ;
