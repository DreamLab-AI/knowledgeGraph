        ngm:robot-assisted-surgery ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:healthcare-technology,
        ngm:robotics ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:artificial-intelligence,
        ngm:biomedical-engineering,
        ngm:human-robot-interaction ;
    vc:requires ngm:regulatory-compliance,
        ngm:sensor-fusion ;
    vc:slug "medical-robotics" ;
    vc:sourceDomain "robotics" ;
