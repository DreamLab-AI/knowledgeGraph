ngm:institutional-digital-asset-custody a owl:Class ;
    rdfs:label "Institutional Digital Asset Custody"@en ;
    rdfs:comment "Institutional digital asset custody is the regulated safekeeping of cryptocurrencies and tokenised assets on behalf of funds, banks, and corporations, with controls meeting fiduciary and compliance standards. It combines hardware security modules, multi-party computation or multi-signature key management, segregation of duties, insurance, and audited operational procedures. It is the trust layer that enables large pools of capital to hold crypto assets without bearing single-key loss or theft risk."@en ;
    rdfs:subClassOf ngm:digital-asset ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:custody-infrastructure,
        ngm:multi-sig-governance ;
    vc:slug "institutional-digital-asset-custody" ;
    vc:sourceDomain "blockchain" .

ngm:institutional-economics a owl:Class ;
    rdfs:label "Institutional Economics"@en ;
    rdfs:comment "A school of economic thought that analyses how formal institutions (laws, regulations, contracts) and informal institutions (norms, customs, culture) shape economic behaviour, incentive structures, and aggregate outcomes. It departs from neoclassical assumptions of frictionless exchange by foregrounding transaction costs, bounded rationality, and the evolutionary path-dependence of rules. The field spans the original institutionalism of Veblen and Commons and the New Institutional Economics (NIE) of Coase, North, and Williamson, which provided micro-foundations for why institutions exist and how they change. Institutional economics informs applied work in development economics, regulatory design, organisational theory, and governance of digital platforms."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:economics ],
        ngm:economics ;
    vc:bridgesTo ngm:decentralised-autonomous-organisation,
        ngm:digital-platform-governance,
        ngm:smart-contracts ;
    vc:contrastsWith ngm:behavioural-economics,
        ngm:neoclassical-economics ;
    vc:dependsOn ngm:path-dependence,
        ngm:transaction-costs ;
    vc:enables ngm:development-economics,
        ngm:governance,
        ngm:property-rights,
        ngm:regulatory-policy ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:new-institutional-economics,
        ngm:original-institutionalism,
        ngm:transaction-cost-economics ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:commons-governance,
        ngm:evolutionary-economics,
        ngm:public-choice-theory,
        ngm:social-norms ;
    vc:requires ngm:bounded-rationality,
        ngm:economics ;
    vc:slug "institutional-economics" ;
    vc:sourceDomain "governance" ;
    vc:supports ngm:organisational-theory,
        ngm:political-economy ;
    vc:uses ngm:contract-theory,
        ngm:game-theory,
        ngm:principal-agent-theory .

