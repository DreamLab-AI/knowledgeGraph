    vc:qualityScore "0.35"^^xsd:float ;
    vc:slug "identity-systems" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:authentication,
        ngm:digital-identity .

ngm:information-architecture a owl:Class ;
    rdfs:label "Information Architecture"@en ;
    rdfs:comment "Information Architecture (IA) is the discipline of structuring, organising, labelling, and navigating shared information environments so that users and automated systems can find, understand, and act on content efficiently. It encompasses the design of taxonomies, controlled vocabularies, navigation schemas, metadata frameworks, and search systems that govern how information is classified and retrieved across digital products, knowledge bases, and interconnected platforms. IA bridges human cognitive models and machine-interpretable representations, drawing on ontologies, thesauri, and faceted classification to ensure content remains discoverable, reusable, and interoperable. In distributed and spatial contexts it extends to the semantic namespacing of assets, entities, and services that underpin cross-platform data exchange."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:metadata-standard ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:controlled-vocabulary ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:user-research ],
        ngm:knowledge-organization-system ;
    vc:bridgesTo ngm:knowledge-graph,
        ngm:spatial-computing ;
    vc:contrastsWith ngm:data-architecture,
        ngm:software-architecture ;
    vc:dependsOn ngm:data-modelling,
        ngm:metadata-management ;
    vc:enables ngm:information-retrieval,
        ngm:knowledge-discovery,
        ngm:semantic-interoperability,
        ngm:user-experience-design ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:controlled-vocabulary,
        ngm:metadata-standard,
        ngm:navigation-schema,
        ngm:search-system,
        ngm:taxonomy ;
    vc:qualityScore "0.73"^^xsd:float ;
    vc:relatedTo ngm:content-management-system,
        ngm:human-computer-interaction,
        ngm:library-science ;
    vc:requires ngm:content-strategy,
        ngm:user-research ;
    vc:slug "information-architecture" ;
    vc:sourceDomain "data" ;
    vc:standardizedBy ngm:dublin-core,
        ngm:iso-25964 ;
    vc:uses ngm:faceted-classification,
        ngm:ontology,
        ngm:semantic-web,
        ngm:thesaurus .

ngm:informed-consent a owl:Class ;
    rdfs:label "Informed Consent"@en ;
    rdfs:comment "Informed consent is a legal and ethical doctrine requiring that an individual voluntarily agrees to a procedure, treatment, data use, or research participation after receiving and comprehending all material information about its nature, risks, benefits, and alternatives. It rests on four elements: disclosure of relevant information, comprehension by the consenting party, voluntariness free from coercion, and capacity to make the decision. Codified in post-Nuremberg biomedical ethics (Belmont Report, Declaration of Helsinki), GDPR data protection law, and clinical trials regulations, informed consent is the foundational mechanism protecting individual autonomy across medical, research, and digital data contexts."@en ;
    rdfs:subClassOf ngm:consent-management ;
    vc:bridgesTo ngm:ai-transparency,
        ngm:federated-learning,
        ngm:synthetic-data ;
    vc:contrastsWith ngm:blanket-consent,
        ngm:implied-consent ;
    vc:enables ngm:clinical-trials,
        ngm:data-governance,
        ngm:granular-consent-control,
        ngm:research-ethics ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:decision-making-capacity,
        ngm:disclosure,
        ngm:voluntariness ;
    vc:implements ngm:belmont-report,
        ngm:declaration-of-helsinki ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:ai-ethics,
        ngm:data-privacy,
        ngm:ethical-ai,
        ngm:privacy-and-data-governance,
        ngm:proxy-consent ;
    vc:requires ngm:comprehension,
        ngm:patient-autonomy,
        ngm:right-to-withdraw ;
    vc:slug "informed-consent" ;
    vc:sourceDomain "governance" ;
    vc:standardizedBy ngm:common-rule,
        ngm:data-protection-regulation,
        ngm:gdpr .

ngm:intent-classification a owl:Class ;
    rdfs:label "Intent Classification"@en ;
    rdfs:comment "Intent classification is a natural language processing task that assigns a user utterance to one or more predefined intent categories, enabling a system to determine the semantic goal behind an input. It forms the core routing component of conversational AI systems, mapping raw text to structured action labels such as 'book_flight', 'check_balance', or 'cancel_order'."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:natural-language-understanding ],
        ngm:nlptask ;
    vc:enables ngm:conversational-ai,
        ngm:dialogue-system ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:intent-recognition,
        ngm:named-entity-recognition ;
    vc:requires ngm:natural-language-understanding ;
    vc:slug "intent-classification" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:natural-language-processing .

ngm:interface a owl:Class ;
    rdfs:label "Interface"@en ;
    rdfs:comment "A boundary or contract between system components that defines how they communicate, exchange data, and interact. Interfaces abstract implementation details to enable modular system design, appearing across domains as REST APIs, smart contract ABIs, ROS topics, rendering APIs, and chat APIs. Interface design governs versioning, error handling, and protocol compliance."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:user-interface ],
        ngm:bc-network-component ;
    skos:broader ngm:bc-network-component ;
    vc:enables ngm:semantic-interoperability,
        ngm:smart-contract-execution ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:user-interface ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:blockchain-protocol,
        ngm:smart-contract ;
    vc:slug "interface" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:api-standard .

ngm:iosco a owl:Class ;
    rdfs:label "IOSCO"@en ;
    rdfs:comment "The International Organisation of Securities Commissions (IOSCO) is the principal global standard-setting body for securities and capital markets regulation, founded in 1983 and headquartered in Madrid, with membership spanning national securities regulators and self-regulatory organisations from over 130 jurisdictions. IOSCO develops and publishes Objectives and Principles of Securities Regulation, Recommendations, and targeted policy reports adopted by member regulators to promote fair, efficient, and transparent capital markets, protect investors, and reduce systemic risk. Its remit has expanded to cover digital asset markets, crypto-asset intermediaries, decentralised finance, and AI-driven algorithmic trading, making it a central node in the global financial regulatory architecture alongside the Financial Stability Board and Basel Committee."@en ;
    rdfs:subClassOf ngm:financial-regulation ;
    vc:bridgesTo ngm:ai-governance,
        ngm:algorithmic-trading,
        ngm:decentralised-finance ;
    vc:contrastsWith ngm:bis,
