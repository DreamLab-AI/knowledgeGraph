    vc:relatedTo ngm:zero-knowledge-proof ;
    vc:requires ngm:commitment-scheme ;
    vc:requires ngm:cryptography ;
    vc:requires ngm:pedersen-commitment ;
    vc:slug "range-proof" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:liquid-network ;
    vc:supports ngm:monero ;
    vc:uses ngm:cryptographic-primitive ;
    vc:uses ngm:pedersen-commitment .
