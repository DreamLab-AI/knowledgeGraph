# Compliance Verification
artificial-intelligence:ComplianceVerification rdf:type owl:Class ;
    rdfs:label "Compliance Verification"@en ;
    rdfs:comment "Compliance verification in blockchain contexts encompasses the automated and manual processes for ensuring that cryptoasset transactions, service providers, and participants adhere to regulatory requirements including Know Your Customer (KYC), Anti-Money Laundering (AML), sanctions screening, and transaction monitoring obligations. Blockchain-based compliance systems leverage immutable ledgers, smart contracts, and AI-driven analytics to maintain tamper-proof records and detect suspicious activities in real-time."@en ;
    skos:prefLabel "Compliance Verification"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:artificial-intelligence:compliance-verification" ;
    owl:sameAs <urn:visionclaw:concept:artificial-intelligence:compliance-verification> ;
    vcw:contentHash "sha256-12-06b6fbc53d62" ;
    vcw:qualityScore "0.5"^^xsd:decimal ;
    vcw:legacyTermId "NGM-7004" ;
    vcw:ontologyStatus "active" ;
    vcw:maturityLevel "reviewed" ;
    vcw:authorityScore "0.0"^^xsd:decimal ;
    dcterms:identifier "NGM-7004" ;
    dcterms:subject "artificial-intelligence" ;
    owl:versionInfo "2.0.0" ;
    dcterms:created "2026-04-26T00:00:00Z"^^xsd:dateTime ;
    dcterms:modified "2026-04-26T13:00:00Z"^^xsd:dateTime ;
    vcw:owlRole "Concept" .

artificial-intelligence:ComplianceVerification rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty infrastructure:enables ;
    owl:someValuesFrom artificial-intelligence:KYCAMLRequirements
] .

# Computer Vision Task
artificial-intelligence:Computervisiontask rdf:type owl:Class ;
    rdfs:subClassOf artificial-intelligence:ComputerVision ;
    rdfs:label "Computer Vision Task"@en ;
    rdfs:comment "Computer vision tasks are specific computational problems that machines solve using visual data, including image classification (assigning labels to images), object detection (locating and identifying objects with bounding boxes), semantic segmentation (pixel-wise classification), and instance segmentation (distinguishing individual objects of the same class). These tasks form the foundation for downstream applications such as image captioning, object tracking, and visual question answering."@en ;
    skos:prefLabel "Computer Vision Task"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:artificial-intelligence:computer-vision-task" ;
    owl:sameAs <urn:visionclaw:concept:artificial-intelligence:computer-vision-task> ;
    vcw:contentHash "sha256-12-25524e5baf13" ;
    vcw:qualityScore "0.35"^^xsd:decimal ;
    vcw:legacyTermId "NGM-7007" ;
    vcw:ontologyStatus "active" ;
    vcw:maturityLevel "reviewed" ;
    vcw:authorityScore "0.0"^^xsd:decimal ;
    dcterms:identifier "NGM-7007" ;
    dcterms:subject "artificial-intelligence" ;
    owl:versionInfo "2.0.0" ;
    dcterms:created "2026-04-26T00:00:00Z"^^xsd:dateTime ;
    dcterms:modified "2026-04-26T13:00:00Z"^^xsd:dateTime ;
    vcw:owlRole "Concept" .

# Disruptive Technology
infrastructure:Disruptivetechnology rdf:type owl:Class ;
    rdfs:label "Disruptive Technology"@en ;
    rdfs:comment "Disruptive Technology refers to innovations that create new markets and value networks by initially targeting simple applications at the bottom of the market with more accessible and affordable solutions, then relentlessly moving upmarket to eventually displace established market-leading firms, products, and alliances. Unlike sustaining technologies that make incremental improvements, disruptive technologies enable business models that fundamentally shift market paradigms."@en ;
    skos:prefLabel "Disruptive Technology"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:infrastructure:disruptive-technology" ;
    owl:sameAs <urn:visionclaw:concept:infrastructure:disruptive-technology> ;
    vcw:contentHash "sha256-12-bbde8dedae1b" ;
    vcw:qualityScore "0.5"^^xsd:decimal ;
    vcw:legacyTermId "NGM-7008" ;
    vcw:ontologyStatus "active" ;
    vcw:maturityLevel "reviewed" ;
    vcw:authorityScore "0.0"^^xsd:decimal ;
    dcterms:identifier "NGM-7008" ;
    dcterms:subject "infrastructure" ;
    owl:versionInfo "2.0.0" ;
    dcterms:created "2026-04-26T00:00:00Z"^^xsd:dateTime ;
    dcterms:modified "2026-04-26T13:00:00Z"^^xsd:dateTime ;
    vcw:owlRole "Concept" .

infrastructure:Disruptivetechnology vcw:bridgesTo infrastructure:Blockchain .

# 3D Rendering Engine
spatial-computing:3dRenderingEngine rdf:type owl:Class ;
    rdfs:subClassOf spatial-computing:ComputerGraphics ;
    rdfs:label "3D Rendering Engine"@en ;
    rdfs:comment "A 3D rendering engine is software that converts three-dimensional geometric data into two-dimensional images through processes including lighting calculation, texture mapping, and rasterisation. In the context of metaverse and XR technologies, rendering engines power real-time visualisation of immersive virtual environments, enabling stereoscopic displays, spatial audio integration, and motion-to-photon latency optimisation essential for presence and embodiment in virtual spaces."@en ;
    skos:prefLabel "3D Rendering Engine"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:spatial-computing:3d-rendering-engine" ;
