    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:digital-asset-ecosystem ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:relatedTo ngm:computing-platform,
        ngm:digital-content ;
    vc:slug "digital-platform" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:blockchain,
        ngm:smart-contract .

ngm:digital-preservation a owl:Class ;
    rdfs:label "Digital Preservation"@en ;
    rdfs:comment "Digital Preservation encompasses the strategies, standards, and technical processes that ensure long-term accessibility and integrity of digital content, including 3D assets, metadata, and cultural heritage materials. It involves format migration, checksumming, redundant storage, and provenance tracking, increasingly leveraging blockchain for immutable audit trails and decentralised storage for resilience."@en ;
    rdfs:subClassOf ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:enables ngm:digital-asset-management ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:relatedTo ngm:3-d-file-format,
        ngm:archival-standards,
        ngm:storage-infrastructure ;
    vc:slug "digital-preservation" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:blockchain,
        ngm:metadata-standard .

ngm:digital-safety a owl:Class ;
    rdfs:label "Digital Safety"@en ;
    rdfs:comment "Digital Safety encompasses the policies, technical controls, and design practices that protect individuals from harm in digital and spatial computing environments, including cybersecurity threats, privacy violations, online harassment, and misuse of immersive technologies. It applies governance frameworks, access controls, and content moderation mechanisms to ensure safe participation across metaverse, VR, and telecollaboration platforms."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cybersecurity ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:authentication ],
        ngm:sc-governance-and-safety ;
    skos:broader ngm:sc-governance-and-safety ;
    vc:enables ngm:content-moderation,
        ngm:privacy ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:relatedTo ngm:data-governance,
        ngm:digital-rights ;
    vc:requires ngm:authentication,
        ngm:cybersecurity ;
    vc:slug "digital-safety" ;
    vc:sourceDomain "spatial-computing" .

ngm:direct-preference-optimisation a owl:Class ;
    rdfs:label "Direct Preference Optimisation"@en ;
    rdfs:comment "An alignment mod that directly uses preference data to fine-tune language models without training a separate reward model or using reinforcement learning, offering a simpler alternative to RLHF."@en ;
