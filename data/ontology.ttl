        ngm:texture-mapping .

ngm:activity-pub a owl:Class ;
    rdfs:label "ActivityPub"@en ;
    rdfs:comment "ActivityPub is a W3C-standardised decentralised social networking protocol that defines two layers: a server-to-server federation protocol enabling independent server instances to share content with one another, and a client-to-server protocol allowing applications to interact with a user's social data. Based on the ActivityStreams 2.0 vocabulary and JSON-LD serialisation, it enables interoperable federated social networks where users on different server instances can follow, reply to, and interact with each other across instance boundaries."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:transport-protocol ],
        ngm:distributed-protocol ;
    vc:bridgesTo ngm:decentralised-identity,
        ngm:ipfs ;
    vc:contrastsWith ngm:at-protocol ;
    vc:enables ngm:content-moderation,
        ngm:decentralised-web,
        ngm:federated-social-networks,
        ngm:federation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:interoperability-protocol,
        ngm:web-standard ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:semantic-web-linked-data-standard ;
    vc:requires ngm:transport-protocol ;
    vc:slug "activity-pub" ;
    vc:sourceDomain "distributed-systems" ;
    vc:standardizedBy ngm:world-wide-web-consortium ;
    vc:uses ngm:digital-signatures,
        ngm:json-data-interchange-format-ld,
        ngm:linked-data .

ngm:additive-manufacturing a owl:Class ;
    rdfs:label "Additive Manufacturing"@en ;
    rdfs:comment "Additive manufacturing (AM) is a family of processes that construct three-dimensional objects by depositing, sintering, or photopolymerising material layer by layer from a digital design file, in contrast to subtractive methods that remove material from a solid block. Processes include fused deposition modelling, selective laser sintering, stereolithography, binder jetting, and directed energy deposition, each suited to particular materials and resolution requirements. AM enables on-demand production of complex geometries, personalised products, and distributed manufacturing without the tooling investment of conventional production."@en ;
    rdfs:subClassOf ngm:digital-fabrication ;
    vc:contrastsWith ngm:collaborative-systems-modality-robotics ;
    vc:enables ngm:digital-fabrication ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:computer-vision-system,
        ngm:digital-twin-creation ;
    vc:slug "additive-manufacturing" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:cad-software,
        ngm:digital-twin .

ngm:adversarial-machine-learning a owl:Class ;
    rdfs:label "Adversarial Machine Learning"@en ;
    rdfs:comment "Adversarial machine learning is the study of attacks that exploit vulnerabilities in machine learning models and the development of defences against them, encompassing threats across the model lifecycle including training-time data poisoning, evasion attacks at inference time, model inversion, and membership inference. Attackers craft carefully perturbed inputs or manipulate training data to cause misclassification, extract sensitive information, or degrade model performance, whilst defenders develop robust training procedures, certified defences, and detection mechanisms. The field spans both offensive security research and the development of trustworthy AI systems."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:adversarial-attack ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:machine-learning ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:threat-modelling ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:membership-inference ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:backdoor-attack ],
        ngm:ai-security ;
    vc:bridgesTo ngm:artificial-intelligence ;
    vc:contrastsWith ngm:machine-learning ;
    vc:dependsOn ngm:cybersecurity,
        ngm:formal-verification ;
    vc:enables ngm:adversarial-robustness,
        ngm:model-robustness,
        ngm:red-teaming,
        ngm:trustworthy-ai ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:adversarial-attack,
        ngm:backdoor-attack,
        ngm:membership-inference ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:adversarial-testing,
        ngm:ai-safety,
        ngm:differential-privacy,
        ngm:federated-learning,
        ngm:model-inversion,
        ngm:prompt-injection ;
    vc:requires ngm:machine-learning,
        ngm:threat-modelling ;
    vc:slug "adversarial-machine-learning" ;
    vc:sourceDomain "security" ;
    vc:uses ngm:adversarial-attacks,
        ngm:data-poisoning,
        ngm:gradient-descent,
        ngm:neural-network,
        ngm:transfer-learning .

ngm:advertising a owl:Class ;
    rdfs:label "Advertising"@en ;
    rdfs:comment "Advertising is the practice of communicating persuasive messages about products, services, ideas, or brands to targeted audiences through paid media channels with the intent to influence awareness, attitudes, or purchasing behaviour. It encompasses the creative development of messages and the strategic planning and buying of media placements across channels including broadcast, print, digital, out-of-home, and emerging immersive formats. Modern advertising increasingly relies on data-driven audience targeting, algorithmic media buying, and AI-generated creative to maximise return on investment at scale."@en ;
    rdfs:subClassOf ngm:advertising-and-marketing ;
    vc:enables ngm:programmatic-advertising ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:data-privacy,
        ngm:gdpr,
        ngm:social-media-platform-infrastructure ;
    vc:slug "advertising" ;
    vc:sourceDomain "finance" ;
    vc:uses ngm:digital-marketing,
        ngm:predictive-analytics .

ngm:agent-communication-protocol a owl:Class ;
    rdfs:label "Agent Communication Protocol"@en ;
    rdfs:comment "An Agent Communication Protocol is a formalised specification governing the syntax, semantics, and pragmatics of message exchange between autonomous software agents, enabling them to coordinate actions, share information, delegate tasks, and negotiate goals across heterogeneous runtime environments. Such protocols define the speech act primitives, message envelope formats, conversation policies, and error-handling procedures that agents must implement to participate in a multi-agent system."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ontology ],
        ngm:coordination-protocol ;
    vc:bridgesTo ngm:distributed-collaboration,
        ngm:robotics,
        ngm:semantic-web ;
    vc:contrastsWith ngm:microservices,
        ngm:remote-procedure-call ;
    vc:dependsOn ngm:concurrent-programming,
        ngm:distributed-systems ;
    vc:enables ngm:agentic-workflow,
        ngm:autonomous-task-execution,
        ngm:capability-advertisement,
        ngm:distributed-collaboration,
        ngm:inter-agent-communication,
        ngm:multi-agent-system,
        ngm:negotiation,
        ngm:task-delegation ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:implements ngm:contract-net-protocol,
        ngm:fipa-acl,
        ngm:kqml ;
    vc:qualityScore "0.91"^^xsd:float ;
    vc:relatedTo ngm:agent-to-agent-protocol,
        ngm:bdi-architecture,
        ngm:event-driven-architecture,
        ngm:game-theory,
        ngm:interoperability,
        ngm:kqml,
        ngm:model-context-protocol ;
    vc:requires ngm:ontology,
        ngm:trust-management ;
    vc:slug "agent-communication-protocol" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:algorithmic-trading,
        ngm:capability-advertisement,
        ngm:error-handling,
        ngm:negotiation,
        ngm:smart-grid,
        ngm:warehouse-automation ;
    vc:uses ngm:http-protocol,
        ngm:json-data-interchange-format-ld,
        ngm:json-rpc-2-0,
        ngm:message-passing,
        ngm:speech-act-theory,
        ngm:websocket .

ngm:agent-orchestrator a owl:Class ;
    rdfs:label "Agent Orchestrator"@en ;
    rdfs:comment "An Agent Orchestrator is the directive control component of a multi-agent architecture that decomposes high-level goals into directed acyclic graphs of sub-tasks, selects and dispatches those tasks to specialised sub-agents via a structured Agent Communication Protocol, monitors execution state, resolves inter-task data dependencies, handles timeouts and failures through retry or fallback logic, and assembles partial results into coherent outputs — operating atop an Agent Runtime that manages the lifecycle of individual agents and providing the coordination hub that transforms a pool of autonomous agents into a collaborative system capable of accomplishing complex, long-horizon objectives."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:task-decomposition ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:agent-memory ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:large-language-models ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:agent-runtime ],
        ngm:ai-agent-system,
        ngm:intelligent-system ;
    vc:contrastsWith ngm:single-agent-system,
        ngm:workflow-engine ;
    vc:enables ngm:agentic-workflow,
        ngm:autonomous-coding,
        ngm:autonomous-task-execution,
        ngm:multi-agent-system ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:error-recovery,
        ngm:goal-planner,
        ngm:result-validation,
        ngm:scheduling,
        ngm:task-decomposition ;
    vc:implements ngm:contract-net-protocol,
        ngm:plan-and-execute-pattern,
        ngm:react-pattern ;
    vc:qualityScore "0.91"^^xsd:float ;
    vc:relatedTo ngm:agent-frameworks,
        ngm:bdi-architecture,
        ngm:coordination-mechanisms,
        ngm:distributed-systems,
        ngm:workflow-engine ;
    vc:requires ngm:agent-memory,
        ngm:agent-runtime,
        ngm:capability-advertisement,
        ngm:large-language-models ;
    vc:slug "agent-orchestrator" ;
    vc:sourceDomain "ai" ;
    vc:supports ngm:ai-safety,
        ngm:human-in-the-loop ;
    vc:uses ngm:agent-communication-protocol,
        ngm:agent-runtime,
        ngm:chain-of-thought,
        ngm:function-calling,
        ngm:model-context-protocol,
        ngm:task-planning .

ngm:agent-runtime a owl:Class ;
    rdfs:label "Agent Runtime"@en ;
    rdfs:comment "An Agent Runtime is the infrastructure execution layer that manages the complete lifecycle, resource allocation, tool access, memory state, and communication channels of one or more autonomous AI agents — providing process isolation, context window management, stateful execution with durable checkpointing, sandboxed tool-call dispatch, inter-agent messaging, credential management, rate limiting, and structured observability, analogous to how an operating system runtime supports application processes, and forming the foundational services upon which Agent Orchestrator control logic and Agentic Workflow execution patterns are built."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:tool-registry ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:authentication-system ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:large-language-models ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:agent-memory ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:session-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:observability ],
        ngm:ai-agent-system,
        ngm:intelligent-system ;
    vc:contrastsWith ngm:serverless-function,
        ngm:workflow-engine ;
    vc:enables ngm:autonomous-task-execution,
        ngm:durable-execution,
        ngm:multi-tenancy,
        ngm:sandboxed-code-execution ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:credential-management,
        ngm:observability,
        ngm:process-isolation,
        ngm:session-management,
        ngm:state-persistence,
        ngm:tool-registry ;
    vc:implements ngm:checkpointing,
        ngm:execution-model,
        ngm:rate-limiting ;
    vc:qualityScore "0.91"^^xsd:float ;
    vc:relatedTo ngm:agent-communication-protocol,
        ngm:agent-frameworks,
        ngm:execution-model,
        ngm:multi-agent-system,
        ngm:ros-robotic-operating-system,
        ngm:workflow-engine ;
    vc:requires ngm:agent-memory,
        ngm:authentication-system,
        ngm:large-language-models ;
    vc:slug "agent-runtime" ;
    vc:sourceDomain "ai" ;
    vc:supports ngm:agent-orchestrator,
