    vc:slug "de-fi-services" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:cryptocurrency,
        ngm:digital-asset .

ngm:decentralized-swarm-control a owl:Class ;
    rdfs:label "Decentralized Swarm Control"@en ;
    rdfs:comment "Decentralised swarm control distributes decision-making across all robot agents, where each robot computes commands based solely on local sensor information and direct communication with neighbouring agents."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
