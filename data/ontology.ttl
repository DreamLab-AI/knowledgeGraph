    vc:enables ngm:domain-ontology,
        ngm:ontology ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:robo-actuation-and-control,
        ngm:robo-robot-type ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:structural-member,
        ngm:systems-engineering ;
    vc:slug "taxonomic-framework" ;
    vc:sourceDomain "robotics" ;
    vc:standardizedBy ngm:semantic-web-linked-data-standard-standards .

