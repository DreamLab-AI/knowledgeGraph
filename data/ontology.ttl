ngm:academic-conference a owl:Class ;
    rdfs:label "Academic Conference"@en ;
    rdfs:comment "An academic conference is a periodic, structured gathering at which researchers present, discuss, and publish peer-reviewed work, serving as the primary mechanism for disseminating new findings, validating scientific claims, and setting research agendas in a discipline. Submissions are evaluated by a programme committee drawn from the research community, with accepted papers published in conference proceedings and delivered through oral presentations, poster sessions, and co-located workshops. In computer science and artificial intelligence specifically, leading venues such as NeurIPS, ICML, CVPR, and ICLR function as the primary records of scientific priority, where peer review, archival publication, and community exchange are tightly coupled rather than mediated solely through journal cycles — a structural feature that distinguishes the field from most traditional sciences and accelerates the pace at which novel results enter the community."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:peer-review ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:peer-review ],
        ngm:scientific-research ;
    vc:enables ngm:collaboration,
        ngm:knowledge-sharing,
        ngm:open-science,
        ngm:reproducibility,
        ngm:research-dissemination ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:peer-review,
        ngm:poster-session,
        ngm:proceedings,
        ngm:programme-committee,
        ngm:workshop ;
    vc:isPartOf ngm:academia,
        ngm:scientific-research ;
    vc:qualityScore "0.87"^^xsd:float ;
    vc:relatedTo ngm:aaai,
        ngm:benchmark-standard,
        ngm:cvpr,
        ngm:iclr,
        ngm:icml,
        ngm:neur-ips,
        ngm:publication ;
    vc:requires ngm:double-blind-review,
        ngm:peer-review ;
    vc:slug "academic-conference" ;
    vc:sourceDomain "ai" ;
    vc:supports ngm:ai-ethics,
        ngm:ai-safety-research,
        ngm:artificial-intelligence-research,
        ngm:deep-learning ;
    vc:uses ngm:arxiv,
        ngm:open-review,
        ngm:peer-review .

ngm:accelerometer a owl:Class ;
    rdfs:label "Accelerometer"@en ;
    rdfs:comment "Accelerometer - A microelectromechanical sensor (MEMS) that detects changes in velocity and gravity along three orthogonal axes, enabling robots to measure Motion, Orientation, and Vibration for real-time feedback control and navigation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
