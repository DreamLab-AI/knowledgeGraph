ngm:financial-inclusion a owl:Class ;
    rdfs:label "Financial Inclusion"@en ;
    rdfs:comment "Financial inclusion is the policy objective and market condition in which individuals and businesses — particularly those in underserved, low-income, or geographically remote populations — have affordable, reliable access to a full range of financial services encompassing payments, credit, savings, insurance, and investment. It is pursued through regulatory reform, technology-led delivery (mobile money, digital wallets, open banking APIs), and identity infrastructure, aiming to integrate marginalised groups into the formal economy. Key enablers include tiered Know Your Customer frameworks, agent banking networks, interoperable payment rails, and programmable money mechanisms such as Central Bank Digital Currencies and regulated stablecoins. Progress is measured through account ownership rates, transaction volume among previously unbanked populations, and composite indices such as the World Bank Global Findex."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:digital-identity ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:interoperability ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:kyc-aml ],
        ngm:financial-services ;
    vc:bridgesTo ngm:blockchain,
        ngm:self-sovereign-identity ;
    vc:contrastsWith ngm:financial-exclusion,
        ngm:predatory-lending ;
    vc:dependsOn ngm:payment-infrastructure,
        ngm:regulatory-framework ;
    vc:enables ngm:digital-payments,
        ngm:economic-development,
        ngm:microfinance,
        ngm:money ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:central-bank-digital-currency,
        ngm:decentralised-finance,
        ngm:fintech,
        ngm:remittances ;
    vc:requires ngm:digital-identity,
        ngm:interoperability,
        ngm:kyc-aml,
        ngm:mobile-internet ;
    vc:slug "financial-inclusion" ;
    vc:sourceDomain "finance" ;
    vc:standardizedBy ngm:financial-action-task-force,
        ngm:g20-global-partnership-for-financial-inclusion ;
    vc:supports ngm:gender-equality,
        ngm:poverty-reduction,
        ngm:sustainable-development-goals ;
    vc:uses ngm:agent-banking,
        ngm:biometric-authentication,
        ngm:open-banking,
        ngm:stablecoin .

ngm:khronos-group a owl:Class ;
    rdfs:label "Khronos Group"@en ;
    rdfs:comment "The Khronos Group is an open, member-driven industry consortium founded in January 2000 that creates and maintains royalty-free open standards for graphics, parallel compute, media, and extended reality APIs across heterogeneous hardware platforms. Its portfolio spans OpenGL, Vulkan, OpenCL, OpenXR, glTF, NNEF, WebGL, and SPIR-V, forming the portable API foundation that underpins GPU-accelerated rendering, XR runtimes, and cross-vendor compute across the technology industry. Khronos operates through working groups composed of member companies — including NVIDIA, AMD, Intel, ARM, Apple, Google, and Meta — that collaboratively draft, ratify, and publish specifications under open licences with conformance test suites."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:spir-v ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:gltf-standard ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:web-gl ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:vulkan ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:opencl ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:open-xr ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:open-gl ],
        ngm:standardization-bodies ;
    vc:bridgesTo ngm:edge-inference,
        ngm:machine-learning-accelerator,
        ngm:metaverse-infrastructure ;
    vc:contrastsWith ngm:directx,
        ngm:metal-api ;
    vc:enables ngm:cross-platform-rendering,
        ngm:gpu-compute,
        ngm:graphics-api,
        ngm:hardware-abstraction-layer,
        ngm:spatial-computing ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:gltf-standard,
        ngm:open-gl,
        ngm:open-xr,
        ngm:opencl,
        ngm:spir-v,
        ngm:vulkan,
        ngm:web-gl ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:3-d-file-format,
        ngm:interoperability-standard,
        ngm:open-standard,
        ngm:rendering-pipeline,
        ngm:shader-language ;
    vc:slug "khronos-group" ;
    vc:sourceDomain "standards" ;
    vc:standardizedBy ngm:ieee,
