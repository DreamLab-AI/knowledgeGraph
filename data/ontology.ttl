ngm:graceful-degradation a owl:Class ;
    rdfs:label "Graceful Degradation"@en ;
    rdfs:comment "Graceful degradation is a design property whereby a system continues to provide reduced but acceptable functionality when some of its components fail or operate under stress, rather than failing completely. It prioritises essential services, sheds non-critical load, and offers fallback behaviours so that partial failure does not cascade into total outage. It is a cornerstone of resilient, fault-tolerant infrastructure."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:monitoring ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:observability ],
        ngm:reliability-engineering ;
    vc:bridgesTo ngm:bandwidth-adaptation ;
    vc:dependsOn ngm:reliability ;
    vc:enables ngm:fault-tolerance,
        ngm:resilience ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:reliability-engineering ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:chaos-engineering,
        ngm:distributed-systems ;
    vc:requires ngm:monitoring,
        ngm:observability ;
    vc:slug "graceful-degradation" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:quality-of-service,
        ngm:user-experience ;
    vc:uses ngm:circuit-breaker,
        ngm:failover,
        ngm:redundancy .

ngm:graph-data-model a owl:Class ;
    rdfs:label "Graph Data Model"@en ;
    rdfs:comment "A graph data model represents information as nodes connected by edges, where edges carry the semantics of relationships between entities. It makes connections first-class, so traversing and querying relationships is direct rather than reconstructed through joins as in tabular models. The two dominant variants are the labelled property graph, which attaches key-value properties to nodes and edges, and the RDF triple model, which expresses facts as subject-predicate-object statements."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:node ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:graph-database ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:schema ],
        ngm:data-model ;
    vc:contrastsWith ngm:data-model ;
    vc:enables ngm:knowledge-graph,
        ngm:semantic-web ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:node ;
    vc:implements ngm:property-graph,
        ngm:rdf ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:ontology ;
    vc:requires ngm:graph-database,
        ngm:schema ;
    vc:slug "graph-data-model" ;
    vc:sourceDomain "data" ;
    vc:supports ngm:knowledge-graph-embedding,
        ngm:structured-data ;
    vc:uses ngm:knowledge-representation,
        ngm:sparql .

