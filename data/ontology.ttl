# Virtual World Platform
spatial-computing:VirtualWorldPlatform rdf:type owl:Class ;
    rdfs:subClassOf spatial-computing:DigitalPlatform ;
    rdfs:label "Virtual World Platform"@en ;
    rdfs:comment "A software ecosystem that enables users to create, explore, and interact within persistent 3D virtual environments, encompassing both centralized platforms like Roblox and Fortnite, and blockchain-based decentralized platforms like Decentraland and The Sandbox that feature user-owned digital assets and governance."@en ;
    skos:prefLabel "Virtual World Platform"@en ;
