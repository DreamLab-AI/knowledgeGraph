ngm:property-graph a owl:Class ;
    rdfs:label "Property Graph"@en ;
    rdfs:comment "A property graph is a graph data structure in which both nodes and edges carry labels and an arbitrary set of key-value properties. Edges are directed and uniquely identifiable, allowing multiple parallel relationships of different types between the same pair of nodes. It is the data model behind many native graph databases and is queried with traversal languages such as Cypher and Gremlin."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:node ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:schema ],
        ngm:graph-data-model ;
    vc:contrastsWith ngm:rdf ;
    vc:enables ngm:knowledge-graph,
        ngm:structured-data ;
    vc:hasMaturity ngmi:maturity-established ;
