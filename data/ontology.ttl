# DC Servo Motor
robotics:DcServoMotor rdf:type owl:Class ;
    rdfs:subClassOf robotics:ServoMotor ;
    rdfs:subClassOf robotics:ElectricMotor ;
    rdfs:label "DC Servo Motor"@en ;
    rdfs:comment "DC servo motor combines a direct-current electric motor with integrated or external feedback control electronics to enable precise position, velocity, or torque regulation. The servo loop continuously adjusts motor current based on sensor feedback, enabling rapid response to disturbances and accurate tracking of command trajectories for Robotic Manipulation and Motion Control applications."@en ;
    skos:prefLabel "DC Servo Motor"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:robotics:dc-servo-motor" ;
    owl:sameAs <urn:visionclaw:concept:robotics:dc-servo-motor> ;
