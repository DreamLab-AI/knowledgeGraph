ngm:privacy-preserving-data-mining a owl:Class ;
    rdfs:label "Privacy Preserving Data Mining"@en ;
    rdfs:comment "Privacy-Preserving Data Mining (PPDM) is a research field and collection of techniques that enable extraction of useful knowledge patterns—including association rules, classifiers, clusters, and outliers—from datasets while preventing disclosure of sensitive individual records. PPDM methods span data perturbation (noise addition, randomisation, synthetic data generation before mining), cryptographic protocols (secure multi-party computation for distributed pattern discovery, homomorphic encryption for encrypted operations), anonymisation transformations (k-anonymity, l-diversity, t-closeness applied before dataset release), and differential-privacy query mechanisms that inject calibrated noise into published pattern outputs. The field navigates an inherent privacy–utility trade-off: stronger privacy guarantees typically reduce pattern accuracy, and compositions of multiple analyses risk cumulative information leakage through inference and re-identification attacks."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:secure-multi-party-computation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:differential-privacy ],
        ngm:ai-governance-and-ethics ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:enables ngm:data-sharing,
        ngm:privacy ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:data-pipeline,
        ngm:membership-inference,
        ngm:model-inversion,
        ngm:pattern-recognition ;
    vc:requires ngm:differential-privacy,
        ngm:secure-multi-party-computation ;
    vc:slug "privacy-preserving-data-mining" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:data-protection,
        ngm:homomorphic-encryption-for-machine-learning ;
    vc:uses ngm:anomaly-detection,
        ngm:federated-learning,
        ngm:synthetic-data .

