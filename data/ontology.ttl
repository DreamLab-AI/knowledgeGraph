ngm:internet-of-things a owl:Class ;
    rdfs:label "Internet of Things"@en ;
    rdfs:comment "The Internet of Things (IoT) is a distributed computing paradigm in which physical objects embedded with sensors, actuators, microcontrollers, and wireless communication modules collect, exchange, and act upon data autonomously over IP networks. IoT deployments span a layered architecture from resource-constrained end-devices through edge gateways to cloud analytics platforms, relying on lightweight protocols such as MQTT, CoAP, AMQP, and LwM2M designed for low-bandwidth, high-latency, or lossy network environments. The paradigm encompasses consumer IoT (smart home devices, wearables), Industrial IoT (IIoT) for manufacturing and critical infrastructure, and urban-scale deployments in smart cities and precision agriculture. Security, interoperability, and device lifecycle management are defining engineering challenges across all IoT segments."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:actuator ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:sensor-data ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:embedded-systems ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cloud-computing ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:network-infrastructure ],
        ngm:distributed-systems ;
    vc:bridgesTo ngm:blockchain,
        ngm:digital-twin,
        ngm:machine-learning ;
    vc:contrastsWith ngm:traditional-scada ;
    vc:enables ngm:edge-computing,
        ngm:industrial-automation,
        ngm:predictive-maintenance,
        ngm:smart-city,
        ngm:telemetry-and-analytics ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:actuator,
        ngm:iot-gateway,
        ngm:sensor-data ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:5-g,
        ngm:cyber-physical-systems,
        ngm:fog-computing ;
    vc:requires ngm:cloud-computing,
        ngm:embedded-systems,
        ngm:network-infrastructure ;
    vc:slug "internet-of-things" ;
    vc:sourceDomain "infrastructure" ;
    vc:standardizedBy ngm:etsi,
        ngm:ieee,
        ngm:itu ;
    vc:uses ngm:co-ap,
        ngm:microcontroller,
        ngm:mqtt,
        ngm:sensor,
        ngm:tls,
        ngm:wireless-communication .

ngm:sensor a owl:Class ;
    rdfs:label "Sensor"@en ;
    rdfs:comment "A sensor is a transducer or measurement device that detects, converts, and quantifies a physical, chemical, or environmental stimulus — such as light, pressure, temperature, motion, or electromagnetic fields — into an electrical signal suitable for processing, storage, or actuation. Sensors form the perceptual interface between computational systems and the physical world, enabling autonomous robots, IoT devices, spacecraft, and industrial machinery to react to real-world conditions. They are characterised by key metrology attributes including sensitivity, resolution, dynamic range, linearity, bandwidth, and noise floor. Modern sensor fusion architectures combine heterogeneous sensor streams — e.g. [[LiDAR]], [[Camera]], and [[IMU]] — using probabilistic filters to produce robust, high-fidelity world models."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:lidar ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:imu ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:analog-to-digital-converter ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:ultrasonic-sensor ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:camera ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:force-torque-sensor ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:encoder ],
        [ a owl:Restriction ;
