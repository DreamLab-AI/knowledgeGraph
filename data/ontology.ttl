    vc:slug "eu-mi-ca-regulation" ;
    vc:sourceDomain "governance" .

ngm:everledger a owl:Class ;
    rdfs:label "Everledger"@en ;
    rdfs:comment "A technology company that built a blockchain-based registry for tracking the provenance of high-value physical assets such as diamonds and gemstones. The registry links a unique digital record to each physical item to support authenticity and ownership claims."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:distributed-ledger-technology ],
        ngm:supply-chain ;
    vc:enables ngm:provenance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:distributed-ledger-technology ;
    vc:slug "everledger" ;
    vc:sourceDomain "blockchain" .

ngm:exhibition a owl:Class ;
    rdfs:label "exhibition"@en ;
    rdfs:comment "An exhibition is a curated public or professional presentation of artefacts, technologies, artworks, or innovations staged in a physical venue, virtual environment, or hybrid setting. In the context of immersive technology and AI, exhibitions serve as deployment contexts for spatial computing experiences, interactive demonstrations, and knowledge communication — including trade fairs, museum installations, and dedicated industry events such as AIX. They sit at the intersection of event management, immersive experience design, and audience engagement."@en ;
    rdfs:subClassOf ngm:event ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:event-management,
        ngm:immersive-experience,
        ngm:immersive-technology,
        ngm:metaverse-core-concepts,
        ngm:virtual-event ;
    vc:slug "exhibition" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:digital-twin,
        ngm:spatial-computing .

ngm:explanation a owl:Class ;
    rdfs:label "Explanation"@en ;
    rdfs:comment "An Explanation in the context of AI systems is a human-interpretable account of why a model produced a particular output, which features influenced the prediction, and how the system would behave differently under alternative inputs. Explanations may be global (describing overall model behaviour across the input space), local (accounting for a single prediction), or contrastive (answering why outcome A rather than outcome B). They are the primary instrument through which AI Transparency and Explainability is operationalised for stakeholders including regulators, domain experts, and affected individuals."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:feature-importance ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:model-interpretability ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:explainable-ai ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:post-hoc-explanation ],
        ngm:ai-governance-and-ethics ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:contrastsWith ngm:intrinsic-interpretability ;
    vc:enables ngm:algorithmic-accountability,
        ngm:decision-transparency,
        ngm:transparency-and-explainability ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:feature-importance,
        ngm:post-hoc-explanation ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:ai-trustworthiness,
        ngm:blockchain,
        ngm:digital-twin,
        ngm:explainability,
        ngm:interpretability ;
    vc:requires ngm:explainable-ai,
        ngm:model-interpretability ;
    vc:slug "explanation" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:f-2-pool a owl:Class ;
    rdfs:label "F2Pool"@en ;
    rdfs:comment "F2Pool is one of the oldest Bitcoin mining pools, allowing miners to combine hash power and share block rewards. It also supports mining for other cryptocurrencies."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:bitcoin-mining ],
        ngm:mining-pool ;
    vc:enables ngm:transaction-validation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:bitcoin-mining ;
    vc:slug "f-2-pool" ;
    vc:sourceDomain "blockchain" .

ngm:face-recognition a owl:Class ;
    rdfs:label "Face Recognition"@en ;
    rdfs:comment "A biometric technique that identifies or verifies a person from an image or video of their face by comparing facial features against stored templates. It is a subfield of computer vision and biometrics."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:computer-vision ],
        ngm:biometric-authentication ;
    vc:enables ngm:identity-verification ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:computer-vision ;
    vc:slug "face-recognition" ;
    vc:sourceDomain "computer-vision" .

ngm:fatfrecommendations a owl:Class ;
    rdfs:label "FATFRecommendations"@en ;
    rdfs:comment "The FATF Recommendations are the comprehensive international standards established by the Financial Action Task Force—an intergovernmental body founded in 1989 comprising 40 member jurisdictions—for combating money laundering, terrorist financing, and proliferation financing, covering customer due diligence, suspicious transaction reporting, record-keeping, and the regulation of virtual asset service providers through Recommendation 15 and the Travel Rule. They constitute the primary global anti-financial-crime framework that national regulators translate into domestic law, creating compliance obligations for financial institutions and cryptocurrency exchanges."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:compliance-monitoring ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:anti-money-laundering ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:compliance-framework ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:travel-rule ],
        ngm:aml-kyc-compliance,
        ngm:bc-governance-and-regulation ;
    skos:broader ngm:bc-governance-and-regulation ;
