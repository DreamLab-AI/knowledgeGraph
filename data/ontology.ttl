    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires ngm:cryptographic-system,
        ngm:node-network,
        ngm:storage-solutions ;
    vc:slug "digital-asset-infrastructure" ;
    vc:sourceDomain "infrastructure" .

