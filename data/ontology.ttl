ngm:render-target a owl:Class ;
    rdfs:label "Render Target"@en ;
    rdfs:comment "A memory buffer or texture surface to which a GPU writes the output of a rendering pass, including the default framebuffer displayed on screen and off-screen targets used for post-processing effects, shadow maps, reflections, and multi-pass rendering in real-time graphics pipelines."@en ;
    rdfs:subClassOf ngm:render-pipeline,
        ngm:sc-display-and-rendering ;
    skos:broader ngm:sc-display-and-rendering ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:real-time-rendering-pipeline ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:pixel-shader,
        ngm:shader,
        ngm:vertex-shader ;
    vc:slug "render-target" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:compute-shader,
        ngm:gpu-compute .

ngm:replication-protocol a owl:Class ;
    rdfs:label "Replication Protocol"@en ;
    rdfs:comment "A replication protocol is the set of rules and message exchanges by which a distributed system maintains multiple copies of data across nodes so that they remain consistent according to a chosen consistency model despite failures and concurrency. It governs how updates are propagated, ordered, and acknowledged, balancing availability, latency, and durability. Replication protocols range from synchronous primary-backup and quorum schemes to asynchronous gossip and conflict-free replicated approaches."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:log-replication ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:leader-election ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:consistency-model ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:consensus-mechanism ],
        ngm:distributed-data-structure ;
    vc:bridgesTo ngm:distributed-systems ;
    vc:contrastsWith ngm:partition-tolerance ;
    vc:dependsOn ngm:consistency-model ;
    vc:enables ngm:data-replication,
        ngm:fault-tolerance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:leader-election,
        ngm:log-replication ;
    vc:implements ngm:state-machine-replication ;
    vc:isPartOf ngm:distributed-data-structure ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:crdt,
