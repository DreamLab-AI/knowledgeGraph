        ngm:pressure-regulator,
        ngm:proportional-valve ;
    vc:implements ngm:fibre-reinforced-elastomer-actuation,
        ngm:fluidic-muscle-principle,
        ngm:iso-15552-standard,
        ngm:iso-6432-standard,
        ngm:mc-kibben-muscle-mechanics,
