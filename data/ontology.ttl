        ngm:creator-wallet,
        ngm:nft-standard ;
    vc:slug "royalty-mechanism" ;
    vc:sourceDomain "spatial-computing" .

ngm:rust a owl:Class ;
    rdfs:label "Rust"@en ;
    rdfs:comment "Rust is a compiled, statically typed systems programming language created at Mozilla Research and first released in 2015, designed to provide C-like performance and low-level memory control without the memory safety vulnerabilities that plague C and C++. Its defining innovation is the ownership-and-borrowing type system, which enforces at compile time that each value has exactly one owner, references obey strict lifetime rules, and data races are structurally impossible — all without a garbage collector. Rust has rapidly become the preferred language for writing safe, high-performance systems software, blockchain runtimes, WebAssembly modules, embedded firmware, and operating system kernels."@en ;
    rdfs:subClassOf ngm:programming-language ;
    vc:enables ngm:embedded-systems,
        ngm:high-performance-computing,
        ngm:web-assembly ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:performance-optimization,
        ngm:runtime-environment ;
    vc:slug "rust" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:distributed-systems .

ngm:safetensors-format a owl:Class ;
    rdfs:label "Safetensors Format"@en ;
    rdfs:comment "Safetensors is a file format for storing tensors — the weight matrices of machine-learning models — designed to be safe, fast, and simple. Unlike Python pickle-based formats, safetensors stores only raw tensor data and a JSON header describing shapes, dtypes, and offsets, so loading a file cannot execute arbitrary code. The layout supports zero-copy and memory-mapped loading, enabling rapid model initialisation and lazy access to individual tensors. Developed by Hugging Face, it has become a de facto standard for distributing open model weights."@en ;
    rdfs:subClassOf ngm:data-format ;
    vc:enables ngm:model-deployment ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.78"^^xsd:float ;
    vc:relatedTo ngm:data-serialization,
        ngm:safetensors ;
    vc:slug "safetensors-format" ;
    vc:sourceDomain "ai" .

ngm:safety-assurance a owl:Class ;
    rdfs:label "Safety Assurance"@en ;
    rdfs:comment "Safety assurance is the systematic process of building and demonstrating justified confidence that a system will operate safely throughout its lifecycle. It draws on hazard analysis, structured safety cases, verification evidence, and continuous monitoring to argue that residual risk is acceptable. For autonomous and industrial systems it provides the evidentiary basis for deployment and regulatory acceptance."@en ;
    rdfs:subClassOf ngm:robo-safety-and-standards ;
    skos:broader ngm:robo-safety-and-standards ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:autonomous-systems-domain,
        ngm:predictive-maintenance ;
    vc:slug "safety-assurance" ;
    vc:sourceDomain "robotics" .

ngm:safety-certification a owl:Class ;
    rdfs:label "Safety Certification"@en ;
    rdfs:comment "Safety certification is the formal attestation by an accredited body that a product, system, or process conforms to applicable safety standards and regulations. It involves assessment, testing, and audit against criteria such as functional-safety integrity levels, after which a mark or certificate authorises deployment. For robots it verifies that protective measures like collision detection meet required safety levels."@en ;
    rdfs:subClassOf ngm:robo-safety-and-standards ;
    skos:broader ngm:robo-safety-and-standards ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:cobot-safety-levels,
        ngm:collision-detection ;
    vc:slug "safety-certification" ;
    vc:sourceDomain "robotics" .

ngm:safety-integrity-level a owl:Class ;
    rdfs:label "Safety Integrity Level"@en ;
    rdfs:comment "Safety Integrity Level (SIL) is a discrete measure of the risk-reduction provided by a safety function, defined by the IEC 61508 family of standards on four levels (SIL 1 to SIL 4). Each level corresponds to a target probability of dangerous failure on demand or per hour. SIL is used to specify, design, and verify that safety-related control systems achieve a tolerable level of risk."@en ;
    rdfs:subClassOf ngm:robo-safety-and-standards ;
    skos:broader ngm:robo-safety-and-standards ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:robot-standard,
        ngm:safety-function ;
    vc:slug "safety-integrity-level" ;
    vc:sourceDomain "robotics" .

ngm:sanctions-compliance a owl:Class ;
    rdfs:label "Sanctions Compliance"@en ;
    rdfs:comment "Sanctions compliance is the set of controls organisations implement to avoid transacting with individuals, entities, jurisdictions, or assets prohibited by sanctions regimes such as those administered by the US OFAC, the EU, the UK OFSI, and the UN. It involves screening counterparties against sanctions lists, monitoring transactions for prohibited patterns, blocking or freezing prohibited dealings, and maintaining auditable records. In digital-asset markets it extends to wallet-address screening and analysis of fund provenance, posing distinctive challenges for permissionless and privacy-preserving systems."@en ;
    rdfs:subClassOf ngm:regulatory-compliance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:compliance,
        ngm:financial-regulation ;
    vc:slug "sanctions-compliance" ;
    vc:sourceDomain "governance" ;
    vc:supports ngm:risk-assessment ;
    vc:uses ngm:kyc .

ngm:satellite-monitoring a owl:Class ;
    rdfs:label "Satellite Monitoring"@en ;
    rdfs:comment "Satellite monitoring is the use of orbital remote-sensing platforms to observe and measure conditions on the Earth's surface over time. In sustainability and supply-chain contexts it supports verification of deforestation, land use, emissions plumes, and facility activity using multispectral, radar, and thermal imagery. The resulting geospatial data feeds carbon accounting, compliance, and ethical-sourcing assessments."@en ;
    rdfs:subClassOf ngm:sustainability ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:carbon-footprint-measurement,
        ngm:ethical-sourcing ;
    vc:slug "satellite-monitoring" ;
    vc:sourceDomain "supply-chain" .

ngm:scalability-pattern a owl:Class ;
    rdfs:label "Scalability Pattern"@en ;
    rdfs:comment "A Scalability Pattern is a reusable architectural strategy that enables a system to handle increasing load by adding resources or restructuring components without degrading performance or reliability. Patterns include horizontal scaling (adding parallel instances), vertical scaling (increasing instance capacity), sharding, caching, and event-driven decomposition, each suited to different bottleneck profiles."@en ;
    rdfs:subClassOf ngm:infra-software-engineering ;
    skos:broader ngm:infra-software-engineering ;
    vc:enables ngm:distributed-systems,
        ngm:performance-optimization ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:slug "scalability-pattern" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:infrastructure-architecture,
        ngm:performance-benchmarks ;
    vc:uses ngm:microservices-architecture,
        ngm:orchestration .

ngm:scaled-dot-product-attention a owl:Class ;
    rdfs:label "Scaled Dot Product Attention"@en ;
    rdfs:comment "An attention mechanism that computes attention weights using the dot product of queries and keys, scaled by the square root of the key dimension, followed by a softmax normalisation."@en ;
    rdfs:subClassOf ngm:ai-model-architecture,
        ngm:attention-mechanism ;
    skos:broader ngm:ai-model-architecture ;
    vc:enables ngm:multi-head-attention ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:transformer-architecture ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:backpropagation,
        ngm:feed-forward-network,
        ngm:self-attention ;
    vc:slug "scaled-dot-product-attention" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:positional-encoding,
        ngm:query-key-value .

ngm:screen-capture a owl:Class ;
    rdfs:label "Screen Capture"@en ;
    rdfs:comment "Screen capture is the acquisition of the visual contents of a display, window, or application as still images or a stream of frames. It underpins screenshots, screen recording, and remote presentation, and is increasingly used to provide perceptual input to AI agents that operate graphical interfaces. Capture is mediated by operating-system or browser APIs subject to user permission."@en ;
    rdfs:subClassOf ngm:human-computer-interaction ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:computer-use-and-browser-agents,
        ngm:screen-recording ;
    vc:slug "screen-capture" ;
    vc:sourceDomain "infrastructure" .

ngm:sdxl a owl:Class ;
    rdfs:label "SDXL"@en ;
    rdfs:comment "SDXL (Stable Diffusion XL) is a large-scale latent diffusion model released by Stability AI in 2023, comprising a 3.5-billion-parameter UNet and an ensemble of two CLIP text encoders that condition image generation at native 1024×1024 resolution. It introduces a two-stage architecture — a base model followed by a refinement model — and supports advanced conditioning mechanisms including aesthetic scoring and crop coordinates."@en ;
    rdfs:subClassOf ngm:latent-diffusion ;
    vc:contrastsWith ngm:stable-diffusion ;
    vc:enables ngm:image-generation,
        ngm:lo-ra-fine-tuning ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:diffusion-model,
        ngm:hugging-face-diffusers ;
    vc:slug "sdxl" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:classifier-free-guidance,
        ngm:clip-encoder,
        ngm:vae .

ngm:secure-data-sharing a owl:Class ;
    rdfs:label "Secure Data Sharing"@en ;
    rdfs:comment "Cryptographic and access control mechanisms that enable controlled exchange of sensitive information between parties in metaverse environments while maintaining confidentiality, integrity, and regulatory compliance through encryption and permissioned access."@en ;
    rdfs:subClassOf ngm:data-security,
        ngm:infra-security-and-identity ;
    skos:broader ngm:infra-security-and-identity ;
    vc:enables ngm:confidential-collaboration ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:slug "secure-data-sharing" ;
    vc:sourceDomain "infrastructure" .

ngm:security-audit a owl:Class ;
    rdfs:label "Security Audit"@en ;
    rdfs:comment "A security audit is a systematic evaluation of a system's controls, configurations, and code against security requirements and threats. It combines techniques such as code review, configuration assessment, penetration testing, and control verification to identify vulnerabilities and compliance gaps. Audits produce evidence and remediation guidance used to reduce risk and demonstrate assurance."@en ;
    rdfs:subClassOf ngm:cybersecurity ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:etsi-domain-data-management-security,
        ngm:threat-surface-map ;
    vc:slug "security-audit" ;
    vc:sourceDomain "security" .

ngm:security-layer a owl:Class ;
    rdfs:label "Security Layer"@en ;
    rdfs:comment "The Security Layer is the implementation-focused abstraction level that encapsulates cryptographic mechanisms, security protocols, threat models, and defensive architectures protecting blockchain and distributed systems from attacks whilst ensuring data integrity, authenticity, and confidentiality. It encompasses concrete implementations such as hash functions, digital signatures, zero-knowledge proofs, access control, and formal verification, distinct from higher-level conceptual security properties."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:hash-function ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:cryptography ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:digital-signature ],
        ngm:infra-security-and-identity ;
    skos:broader ngm:infra-security-and-identity ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:cryptography,
        ngm:digital-signature,
        ngm:hash-function ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:slug "security-layer" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:cryptographic-security,
        ngm:data-security ;
    vc:uses ngm:formal-verification,
        ngm:zero-knowledge-proof .

ngm:security-testing a owl:Class ;
    rdfs:label "Security Testing"@en ;
    rdfs:comment "Security testing is the evaluation of software to discover vulnerabilities and verify that security controls behave as intended. It includes static application security testing, dynamic testing, dependency and secret scanning, fuzzing, and penetration testing. Integrated into development pipelines, it shifts vulnerability discovery earlier and continuously throughout the software lifecycle."@en ;
    rdfs:subClassOf ngm:cybersecurity ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:dev-sec-ops,
        ngm:testing-process ;
    vc:slug "security-testing" ;
    vc:sourceDomain "security" .

ngm:self-sovereign-identity-ssi a owl:Class ;
    rdfs:label "Self-Sovereign Identity (SSI)"@en ;
    rdfs:comment "Self-Sovereign Identity (SSI) is an identity model in which individuals control their own digital identifiers and credentials without dependence on a centralised issuing authority, using Decentralised Identifiers (DIDs) anchored to distributed ledgers and Verifiable Credentials signed by trusted issuers to enable selective disclosure. SSI shifts identity management from siloed service-provider accounts to portable, user-held credentials that can be verified without querying the original issuer."@en ;
    rdfs:subClassOf ngm:decentralized-identity ;
    vc:dependsOn ngm:privacy-preserving-identity ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:did-method,
        ngm:hyperledger-indy ;
    vc:slug "self-sovereign-identity-ssi" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:decentralized-identifiers,
        ngm:verifiable-credentials .

ngm:semantic-network a owl:Class ;
    rdfs:label "Semantic Network"@en ;
    rdfs:comment "A semantic network is a knowledge-representation structure that models concepts as nodes and their relationships as labelled edges. It captures meaning through typed links such as is-a and part-of, supporting inference, inheritance, and associative retrieval. It is a long-standing formalism underlying ontologies, knowledge graphs, and cognitive models of memory."@en ;
    rdfs:subClassOf ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:cognitive-ai,
        ngm:knowledge-representation-domain ;
    vc:slug "semantic-network" ;
    vc:sourceDomain "ai" .

ngm:semantic-reasoning-engine a owl:Class ;
    rdfs:label "Semantic Reasoning Engine"@en ;
    rdfs:comment "Software that derives logically implied facts and checks consistency over a knowledge base expressed in a formal language such as OWL or RDF Schema. It applies inference rules of the underlying logic to make implicit information explicit."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:description-logic ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:owl-2-web-ontology-language ],
        ngm:inference-engine ;
    vc:enables ngm:knowledge-graph ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:description-logic,
        ngm:owl-2-web-ontology-language ;
    vc:slug "semantic-reasoning-engine" ;
    vc:sourceDomain "general" .

ngm:semi-fungible-token a owl:Class ;
    rdfs:label "Semi-Fungible Token"@en ;
    rdfs:comment "A blockchain token standard that combines fungible and non-fungible properties, typically implemented under ERC-1155. Semi-fungible tokens represent classes of interchangeable assets (e.g. event tickets of the same tier) that may transition to uniquely non-fungible assets upon redemption or use, enabling a single contract to manage both fungible currencies and unique collectibles with reduced gas costs."@en ;
    rdfs:subClassOf ngm:bc-token-and-asset,
        ngm:token ;
    skos:broader ngm:bc-token-and-asset ;
    vc:enables ngm:asset-tokenisation,
        ngm:digital-asset-trading ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:digital-asset,
        ngm:fungible-token,
        ngm:nft-marketplace,
        ngm:non-fungible-token-nft,
        ngm:security-token ;
    vc:slug "semi-fungible-token" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:erc-1155,
        ngm:erc1155-standard,
        ngm:smart-contract .

ngm:sensory-immersion a owl:Class ;
    rdfs:label "Sensory Immersion"@en ;
    rdfs:comment "Sensory immersion is the dimension of immersion produced by saturating a user's perceptual channels with synthetic stimuli, such that the virtual environment dominates their awareness over the physical surroundings. It is driven by display fidelity, spatial audio, haptics, and wide field of view, and is distinct from narrative or cognitive immersion. It is a constituent component of the broader experience of immersion."@en ;
    rdfs:subClassOf ngm:virtual-environment ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:feedback-mechanism,
        ngm:immersion ;
    vc:slug "sensory-immersion" ;
    vc:sourceDomain "metaverse" .

ngm:servo-valve a owl:Class ;
    rdfs:label "Servo Valve"@en ;
    rdfs:comment "A servo valve is an electrohydraulic device that proportionally controls the flow and pressure of hydraulic fluid in response to a low-power electrical command, typically via a torque-motor-driven pilot stage. It provides high-bandwidth, closed-loop modulation of hydraulic actuators, delivering large forces with precise position control. It is a key element of high-power robotic and aerospace actuation systems."@en ;
    rdfs:subClassOf ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:hydraulic-actuator,
        ngm:proportional-valve ;
    vc:slug "servo-valve" ;
    vc:sourceDomain "robotics" .

ngm:session-management a owl:Class ;
    rdfs:label "Session Management"@en ;
    rdfs:comment "The infrastructure mechanisms for creating, maintaining, and terminating authenticated user sessions within a networked application or virtual environment. Session management encompasses token issuance, state synchronisation, session timeout and recovery, and revocation, forming a critical layer between user authentication and persistent application state."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:identity-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:authentication ],
        ngm:infra-security-and-identity ;
    skos:broader ngm:infra-security-and-identity ;
    vc:enables ngm:persistent-state ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:access-control,
        ngm:cloud-infrastructure,
        ngm:cybersecurity ;
    vc:requires ngm:authentication,
        ngm:identity-management ;
    vc:slug "session-management" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:encryption .

ngm:set-of-mark-prompting a owl:Class ;
    rdfs:label "Set-of-Mark Prompting"@en ;
    rdfs:comment "Set-of-mark prompting is a visual-prompting technique that overlays an image with numbered or coloured marks on segmented regions so a multimodal language model can refer to and reason about specific elements by label. By grounding the model's references in explicit visual tokens, it sharply improves spatial grounding, visual question answering, and GUI element selection. It is a key enabler of vision-driven computer-use agents."@en ;
    rdfs:subClassOf ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:computer-use-and-browser-agents ;
    vc:slug "set-of-mark-prompting" ;
    vc:sourceDomain "ai" .

ngm:shared-knowledge-base a owl:Class ;
    rdfs:label "Shared Knowledge Base"@en ;
    rdfs:comment "A collaborative knowledge repository enabling multiple agents or users to exchange, integrate, and query structured information using semantic web technologies, providing a common understanding of domain concepts through ontologies and linked data standards."@en ;
    rdfs:subClassOf ngm:knowledge-management-system,
        ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:enables ngm:collaborative-knowledge-discovery ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:slug "shared-knowledge-base" ;
    vc:sourceDomain "spatial-computing" .

ngm:site-reliability-engineering a owl:Class ;
    rdfs:label "Site Reliability Engineering"@en ;
    rdfs:comment "Site reliability engineering is a discipline that applies software engineering methods to operations work, aiming to build and run scalable and reliable systems."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:observability ],
        ngm:reliability-engineering ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:observability ;
    vc:slug "site-reliability-engineering" ;
    vc:sourceDomain "software-engineering" .

ngm:skos-vocabulary a owl:Class ;
    rdfs:label "Skos Vocabulary"@en ;
    rdfs:comment "A W3C recommendation providing an RDF-based data model for representing thesauri, taxonomies, classification schemes, and other structured controlled vocabularies, enabling publication and linking of knowledge organization systems on the semantic web through standardized concepts and relationships."@en ;
    rdfs:subClassOf ngm:knowledge-organization-system,
        ngm:sc-standards-and-interop ;
    skos:broader ngm:sc-standards-and-interop ;
    vc:enables ngm:linked-vocabulary-publishing ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:slug "skos-vocabulary" ;
    vc:sourceDomain "spatial-computing" .

ngm:slack a owl:Class ;
    rdfs:label "Slack"@en ;
    rdfs:comment "Slack is a cloud-based team messaging and collaboration platform that organises workplace communication into persistent, searchable channels grouped by topic, project, or team, supplemented by direct messages and threaded conversations. Originally developed as an internal tool for the gaming company Tiny Speck in 2013 before pivoting to a standalone product, Slack is distinguished by its extensible integration ecosystem (over 2,500 app integrations), Workflow Builder for no-code automation, and its role as the de facto communication layer for software development teams. Acquired by Salesforce in 2021 for $27.7 billion, it competes primarily with Microsoft Teams."@en ;
    rdfs:subClassOf ngm:collaboration-platform ;
    vc:enables ngm:remote-collaboration,
        ngm:workflow-automation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:digital-workplace-platform,
        ngm:distributed-team-collaboration,
        ngm:remote-work ;
    vc:slug "slack" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:api-integration,
        ngm:asynchronous-communication,
        ngm:threaded-messaging .

ngm:slashing-conditions a owl:Class ;
    rdfs:label "Slashing Conditions"@en ;
    rdfs:comment "Slashing conditions are the set of cryptographically provable validator violations that a proof-of-stake blockchain protocol enforces by destroying or redistributing staked tokens. Encoded directly in protocol logic, they cover equivocation, surround votes, and prolonged unavailability, and their parameters set the strength of the chain's economic security. They are an implemented enforcement mechanism in modern blockchain protocols."@en ;
    rdfs:subClassOf ngm:consensus-mechanism ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:blockchain-protocol,
        ngm:proof-of-stake-sustainability ;
    vc:slug "slashing-conditions" ;
    vc:sourceDomain "blockchain" .

ngm:smart-cities a owl:Class ;
    rdfs:label "Smart Cities"@en ;
    rdfs:comment "Smart Cities are urban environments that integrate digital technologies, data analytics, Internet of Things infrastructure, and connectivity to optimise the delivery of public services, improve quality of life, increase operational efficiency, and advance sustainability goals. They instrumentalise physical infrastructure — transport networks, utilities, buildings, and public spaces — with sensors and actuators connected through communication networks, and apply data-driven decision-making to city operations, planning, and citizen engagement."@en ;
    rdfs:subClassOf ngm:digital-twin-of-society-dto-s ;
    vc:enables ngm:autonomous-vehicle,
        ngm:smart-grid,
        ngm:sustainable-development ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:liverpool-smart-cities,
        ngm:real-time-monitoring ;
    vc:slug "smart-cities" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:digital-twin,
        ngm:edge-ai-for-smart-cities,
        ngm:edge-computing,
        ngm:internet-of-things .

ngm:smart-city a owl:Class ;
    rdfs:label "Smart City"@en ;
    rdfs:comment "A smart city uses networked sensors, data platforms and analytics to manage urban systems such as transport, energy and public services, often paired with spatial digital twins."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
