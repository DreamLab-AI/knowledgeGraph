    vc:slug "prompt-tuning" ;
    vc:sourceDomain "machine-learning" ;
    vc:supports ngm:instruction-tuning,
        ngm:retrieval-augmented-generation ;
    vc:uses ngm:backpropagation,
        ngm:language-modeling,
        ngm:natural-language-processing .

ngm:proof-of-reserves a owl:Class ;
    rdfs:label "Proof of Reserves"@en ;
    rdfs:comment "Proof of reserves is a cryptographic auditing technique by which a custodial entity, such as a cryptocurrency exchange or stablecoin issuer, demonstrates that it holds sufficient assets to cover its customer liabilities. The asset side is typically attested by publishing on-chain wallet ownership, while the liability side is committed using a Merkle tree so that individual customers can verify their balance is included without exposing the full ledger. More advanced schemes combine these with zero-knowledge proofs to prove solvency while preserving the confidentiality of total liabilities and individual balances."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:merkle-tree ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:transparency ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:custody ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:cryptographic-proof ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:merkle-proof ],
        ngm:blockchain ;
    skos:broader ngm:blockchain ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:cryptographic-proof,
        ngm:merkle-proof,
        ngm:merkle-tree ;
    vc:isPartOf ngm:blockchain ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:centralized-exchange,
        ngm:cryptocurrency,
        ngm:digital-asset-custody,
        ngm:reserve-asset,
        ngm:tether,
        ngm:usdc ;
    vc:requires ngm:custody,
        ngm:transparency ;
    vc:slug "proof-of-reserves" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:stablecoin ;
    vc:uses ngm:cryptographic-hash,
        ngm:hash-function,
        ngm:zero-knowledge-proof .

ngm:property-rights a owl:Class ;
    rdfs:label "Property Rights"@en ;
    rdfs:comment "Property rights are the legally and institutionally recognised entitlements that determine who may use, transfer, exclude others from, or derive value from a resource — whether physical, digital, or intellectual. They form the foundational incentive structure of market economies, specifying the bundle of rights (usus, fructus, abusus) attached to an asset. In digital and blockchain contexts, property rights extend to on-chain ownership records, smart-contract-enforced exclusivity, NFT-based title deeds, and virtual land parcels, requiring mechanisms for interoperability, provenance tracking, and dispute resolution that operate across jurisdictions."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:digital-ownership ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:legal-framework ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:smart-contract ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:identity-management ],
        ngm:governance ;
    vc:bridgesTo ngm:ai-generated-content,
        ngm:decentralised-autonomous-organisation,
        ngm:virtual-land ;
    vc:contrastsWith ngm:open-access ;
    vc:dependsOn ngm:consensus-mechanism,
        ngm:dispute-resolution ;
    vc:enables ngm:creator-economy,
        ngm:decentralised-finance,
        ngm:digital-economy ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:data-sovereignty,
        ngm:intellectual-property-rights-framework,
        ngm:regulatory-compliance ;
    vc:requires ngm:digital-ownership,
        ngm:identity-management,
        ngm:legal-framework,
        ngm:smart-contract ;
    vc:slug "property-rights" ;
    vc:sourceDomain "governance" ;
    vc:uses ngm:blockchain,
        ngm:cryptographic-proof,
        ngm:nft,
        ngm:tokenization .

ngm:prosthetics a owl:Class ;
    rdfs:label "Prosthetics"@en ;
    rdfs:comment "Prosthetics is the field concerned with the design, fitting, and control of artificial devices that replace missing or impaired body parts to restore form and function. Modern prosthetic limbs increasingly incorporate actuators, sensors, and control systems, with advanced devices using myoelectric or neural signals to drive movement intuitively. The discipline draws on biomechanics, human-robot interaction, and assistive technology to match device behaviour to human intent and gait. It contrasts with exoskeletons and orthotics, which augment or support existing limbs rather than replacing them."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:sensor-fusion ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:biomechanics ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:actuators ],
        ngm:assistive-technology ;
    vc:bridgesTo ngm:neural-interface,
        ngm:wearable-robotics ;
    vc:contrastsWith ngm:exoskeleton ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:actuators,
        ngm:sensor-fusion ;
    vc:isPartOf ngm:assistive-technology ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:robotic-manipulation ;
    vc:requires ngm:biomechanics ;
    vc:slug "prosthetics" ;
    vc:sourceDomain "robotics" ;
    vc:supports ngm:human-robot-interaction,
        ngm:rehabilitation-robotics ;
    vc:uses ngm:actuators,
        ngm:neural-interface,
        ngm:series-elastic-actuation .

ngm:pseudonymity a owl:Class ;
    rdfs:label "Pseudonymity"@en ;
    rdfs:comment "Pseudonymity is the property of operating under a persistent, stable identifier that is not directly linked to a participant's real-world legal identity, enabling consistent reputation and accountability without exposing personal information. Unlike full anonymity — where individual actions cannot be attributed to any consistent actor — pseudonymity preserves linkability across interactions under the chosen identifier while severing the mapping to biological or legal selfhood. The pseudonymous identifier may be a username, cryptographic public key, or blockchain address; its strength depends on the isolation of contextual signals that could enable de-anonymisation. Pseudonymity is foundational to privacy-preserving communication, decentralised identity systems, and selective-disclosure credential architectures."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:key-pair ],
        ngm:privacy ;
    vc:bridgesTo ngm:blockchain,
        ngm:self-sovereign-identity,
        ngm:tor ;
    vc:contrastsWith ngm:anonymity ;
    vc:enables ngm:censorship-resistance,
        ngm:reputation-system,
        ngm:selective-disclosure,
        ngm:whistleblowing ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:decentralized-identifier,
        ngm:verifiable-credential-vc ;
    vc:qualityScore "0.73"^^xsd:float ;
    vc:relatedTo ngm:data-minimisation,
        ngm:deanonymisation,
        ngm:identity-management,
        ngm:unlinkability ;
    vc:requires ngm:key-pair ;
    vc:slug "pseudonymity" ;
    vc:sourceDomain "security" ;
    vc:standardizedBy ngm:gdpr,
        ngm:w3-c-did-core ;
    vc:uses ngm:hash-function,
        ngm:public-key-cryptography,
        ngm:ring-signature,
        ngm:zero-knowledge-proof .

ngm:python-programming-language a owl:Class ;
    rdfs:label "Python Programming Language"@en ;
    rdfs:comment "Python is a high-level, interpreted, general-purpose programming language emphasising code readability and a clean syntax. It has become the dominant language for machine learning and data science due to its extensive ecosystem of numerical and scientific libraries. Python supports multiple programming paradigms including procedural, object-oriented, and functional styles, and its dynamic typing and interactive REPL accelerate experimentation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:statistical-analysis ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:tensor-computation ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:numerical-methods ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:linear-algebra ],
