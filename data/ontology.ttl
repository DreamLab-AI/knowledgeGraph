ngm:learning-rate-schedule a owl:Class ;
    rdfs:label "Learning Rate Schedule"@en ;
    rdfs:comment "A systematic strategy for varying the learning rate hyperparameter during model training, either according to a fixed rule (step decay, cosine annealing, exponential decay) or adaptively in response to training signals. Learning rate schedules improve convergence and final model performance by applying higher rates early for rapid progress and lower rates during fine-tuning, thereby reducing the risk of overshooting loss minima."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:machine-learning-discipline ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:deep-learning ],
        ngm:sc-content-and-assets ;
    skos:broader ngm:sc-content-and-assets ;
    vc:enables ngm:training-and-fine-tuning ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:machine-learning-discipline-framework,
        ngm:neural-network ;
    vc:requires ngm:deep-learning,
        ngm:machine-learning-discipline ;
    vc:slug "learning-rate-schedule" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:gradient-descent,
        ngm:training .

