ngm:glsl a owl:Class ;
    rdfs:label "GLSL"@en ;
    rdfs:comment "GLSL (OpenGL Shading Language) is a high-level C-like programming language for writing shaders that execute on the GPU within the OpenGL and WebGL graphics pipelines. It lets developers program the programmable stages, principally vertex and fragment shaders, to control geometry transformation, lighting, and per-pixel colour. GLSL is a foundational tool for real-time rendering and visual effects."@en ;
    rdfs:subClassOf ngm:programming-language ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:graphics-api,
        ngm:rendering-pipeline ;
    vc:slug "glsl" ;
    vc:sourceDomain "metaverse" .

ngm:gold-standard a owl:Class ;
    rdfs:label "Gold Standard"@en ;
    rdfs:comment "A monetary system in which a currency's value is legally fixed to and redeemable in a defined quantity of gold, constraining the total money supply to the size of gold reserves held by the issuing authority. Under this regime, exchange rates between participating countries are effectively fixed because each currency is independently pegged to gold at a known rate, enabling automatic balance-of-payments adjustment through the price-specie-flow mechanism. The classical gold standard operated broadly from the 1870s until the outbreak of World War I in 1914, was briefly restored in modified forms during the interwar period, and gave way to the Bretton Woods system of dollar-gold convertibility in 1944, which itself ended in 1971 when the United States suspended gold convertibility."@en ;
    rdfs:subClassOf ngm:monetary-system ;
    vc:bridgesTo ngm:blockchain,
        ngm:cryptocurrency ;
    vc:contrastsWith ngm:fiat-currency,
        ngm:quantitative-easing ;
    vc:dependsOn ngm:central-bank,
        ngm:monetary-policy ;
    vc:enables ngm:balance-of-payments,
        ngm:international-trade,
        ngm:price-stability ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:isPartOf ngm:international-monetary-system,
        ngm:monetary-system ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:commodity-money,
        ngm:inflation,
        ngm:reserve-currency ;
    vc:requires ngm:currency-convertibility,
        ngm:gold-reserve ;
    vc:slug "gold-standard" ;
    vc:sourceDomain "finance" .

ngm:gradient-checkpointing a owl:Class ;
    rdfs:label "Gradient Checkpointing"@en ;
    rdfs:comment "Gradient checkpointing is a memory-efficient training technique for deep neural networks that reduces peak activation memory by storing only a strategically chosen subset of intermediate activations (checkpoints) during the forward pass, then recomputing the discarded activations on demand during backpropagation. The technique was formalised by Chen et al. (2016) under the name 'Training Deep Networks with Sublinear Memory Cost', achieving O(sqrt(N)) memory in the number of layers N at the cost of one additional forward pass per training step. It is now a foundational primitive in large-model training, implemented natively in PyTorch, JAX, TensorFlow, and most major deep-learning frameworks."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:automatic-differentiation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:computational-graph ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:backpropagation ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:model-checkpoint ],
        ngm:backpropagation ;
    vc:bridgesTo ngm:distributed-training,
        ngm:edge-ai ;
    vc:contrastsWith ngm:gradient-accumulation,
        ngm:mixed-precision-training ;
    vc:dependsOn ngm:gpu-memory,
        ngm:neural-network-architecture ;
    vc:enables ngm:large-language-model-training,
        ngm:model-scaling ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:model-checkpoint ;
    vc:isPartOf ngm:memory-efficient-training ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:deep-learning,
        ngm:gradient-descent,
        ngm:model-parallelism,
        ngm:pipeline-parallelism ;
    vc:requires ngm:automatic-differentiation,
        ngm:backpropagation,
        ngm:computational-graph ;
    vc:slug "gradient-checkpointing" ;
    vc:sourceDomain "machine-learning" ;
    vc:supports ngm:convolutional-neural-network,
        ngm:recurrent-neural-network,
        ngm:transformer ;
    vc:uses ngm:forward-pass,
        ngm:memory-management .

ngm:healthcare-records a owl:Class ;
    rdfs:label "Healthcare Records"@en ;
    rdfs:comment "Blockchain-based electronic health record systems that employ immutable distributed ledgers, smart contracts for consent management, and cryptographic security to enable secure patient data sharing across healthcare providers. These systems give patients controlled access to their own records whilst maintaining HIPAA and GDPR compliance through hybrid on-chain/off-chain architectures integrating HL7 FHIR standards."@en ;
