ngm:object-detection a owl:Class ;
    rdfs:label "Object Detection"@en ;
    rdfs:comment "Object Detection is the computer vision task of identifying and localising multiple objects within an image or video frame by predicting bounding boxes and class labels for each detected instance, combining spatial localisation with categorical classification in a single forward pass."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
