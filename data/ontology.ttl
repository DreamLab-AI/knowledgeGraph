    vc:uses ngm:tensor-processing-unit .
ngm:large-scale-corpus a owl:Class ;
    rdfs:comment "A large-scale corpus is a training dataset comprising an extremely large volume of text or other sequential data, typically gathered from web crawls, digitised books, or code repositories, and used to pretrain large neural language models. Its scale is a primary determinant of model capability under empirically observed scaling laws, alongside model parameter count and compute budget. Curation and deduplication of a large-scale corpus materially affect downstream model quality and the presence of memorised content."@en ;
    rdfs:label "Large-Scale Corpus"@en ;
    rdfs:subClassOf ngm:training-data ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:isPartOf ngm:training-data ;
    vc:qualityScore "0.55"^^xsd:float ;
    vc:slug "large-scale-corpus" ;
    vc:sourceDomain "machine-learning" .
ngm:large-scale-datasets a owl:Class ;
    rdfs:comment "Large-scale datasets are very large collections of data, often spanning billions of examples and many terabytes, assembled to train modern machine learning models. They are typically aggregated from web crawls, public corpora and curated sources, then filtered, deduplicated and tokenised. Their scale, diversity and quality are primary determinants of the capabilities of large language and generative models."@en ;
    rdfs:label "Large-Scale Datasets"@en ;
    rdfs:subClassOf ngm:ai-infrastructure ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:generative-ai ;
    vc:relatedTo ngm:large-language-models ;
    vc:slug "large-scale-datasets" ;
    vc:sourceDomain "ai" .
ngm:large-scale-model-training a skos:Concept ;
    rdfs:label "Large Scale Model Training"@en .
ngm:large-scale-parallel-corpora a skos:Concept ;
    rdfs:label "Large Scale Parallel Corpora"@en .
ngm:large-scale-pretrained-foundation-model a owl:Class ;
    rdfs:comment "Foundation models are large-scale neural networks trained on broad, diverse datasets via self-supervised learning that acquire general-purpose representations transferable to a wide range of downstream tasks. They are characterised by massive parameter counts, emergent capabilities not explicitly trained for, and the ability to be fine-tuned or prompted for specialised applications. Prominent examples include GPT-4, BERT, CLIP, and Stable Diffusion, spanning language, vision, and multimodal domains. Their scale and generality make them qualitatively distinct from narrow task-specific models."@en ;
    rdfs:label "Large-Scale Pretrained Foundation Model"@en ;
    rdfs:subClassOf ngm:ai-model-architecture ;
    rdfs:subClassOf ngm:machine-learning-model ;
    rdfs:subClassOf _:r13264 ;
    rdfs:subClassOf _:r13265 ;
