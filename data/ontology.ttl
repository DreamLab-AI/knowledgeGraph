ngm:unlinkability a owl:Class ;
    rdfs:comment "Unlinkability is a privacy property that prevents an adversary from determining whether two or more items of interest, such as messages, transactions or sessions, are related to the same entity. It is a core goal of privacy-enhancing technologies and is achieved through techniques such as pseudonym rotation, mixing, blinding and zero-knowledge constructions. Unlinkability protects against profiling and correlation while still permitting legitimate use of a system."@en ;
    rdfs:label "Unlinkability"@en ;
    rdfs:subClassOf ngm:privacy-enhancing-technologies ;
    rdfs:subClassOf _:r21588 ;
    rdfs:subClassOf _:r21589 ;
