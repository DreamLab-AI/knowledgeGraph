        ngm:real-time-rendering,
        ngm:visual-effects ;
    vc:requires ngm:graphics-processing-unit,
        ngm:vertex-buffer ;
    vc:slug "vertex-shader" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:glsl,
        ngm:gpu-programming,
        ngm:hlsl,
        ngm:matrix-transformation .

ngm:ai-fairness a owl:Class ;
    rdfs:label "AI Fairness"@en ;
    rdfs:comment "AI Fairness refers to the principle and practice of ensuring artificial intelligence systems produce equitable outcomes without bias or discrimination based on protected characteristics such as race, gender, age, or socioeconomic status."@en ;
