ngm:tensor-core a owl:Class ;
    rdfs:label "Tensor Core"@en ;
    rdfs:comment "A Tensor Core is a specialised hardware execution unit within a GPU that performs small matrix multiply-accumulate operations in a single instruction, optimised for the dense linear algebra at the heart of deep learning. It operates on mixed-precision inputs, accumulating in higher precision while multiplying in reduced precision to maximise throughput. By accelerating matrix multiplication, Tensor Cores deliver large gains in training and inference performance over general-purpose GPU cores."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:memory-bandwidth ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:gpu-architecture ],
        ngm:gpu-architecture ;
    vc:enables ngm:deep-learning,
        ngm:inference,
        ngm:model-training ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:gpu-architecture ;
    vc:implements ngm:parallel-computing ;
    vc:isPartOf ngm:gpu ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:gpu,
        ngm:neural-network ;
    vc:requires ngm:memory-bandwidth ;
    vc:slug "tensor-core" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:large-language-model,
        ngm:transformer-architecture ;
    vc:uses ngm:cuda .

ngm:tensor-parallelism a owl:Class ;
    rdfs:label "Tensor Parallelism"@en ;
    rdfs:comment "Tensor parallelism is a model-parallel training and inference technique that splits individual weight tensors, and the matrix multiplications that use them, across multiple accelerators so that each device holds and computes a shard of every layer. Partial results are combined with collective communication such as all-reduce. It lets models whose layers exceed a single device's memory run at scale, and is typically combined with data and pipeline parallelism."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:high-bandwidth-interconnect ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gpu-cluster ],
        ngm:ai-infrastructure ;
    vc:bridgesTo ngm:distributed-systems,
        ngm:infrastructure ;
    vc:contrastsWith ngm:data-parallelism,
        ngm:pipeline-parallelism ;
    vc:dependsOn ngm:collective-communication,
        ngm:matrix-multiplication ;
    vc:enables ngm:distributed-inference,
        ngm:large-language-model,
        ngm:model-training ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:deep-speed,
        ngm:megatron-lm ;
    vc:isPartOf ngm:3d-parallelism,
        ngm:model-parallelism ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:compute-infrastructure,
        ngm:expert-parallelism,
        ngm:model-training ;
    vc:requires ngm:gpu-cluster,
        ngm:high-bandwidth-interconnect ;
    vc:slug "tensor-parallelism" ;
    vc:sourceDomain "machine-learning" ;
    vc:supports ngm:compute-infrastructure,
        ngm:transformer-architecture ;
    vc:uses ngm:nvlink .

ngm:two-phase-commit a owl:Class ;
    rdfs:label "Two-Phase Commit"@en ;
    rdfs:comment "Two-Phase Commit (2PC) is a distributed transaction coordination protocol that ensures atomic commitment across multiple participant nodes: either all participants commit a transaction or all abort it, with no partial updates persisted. In the prepare phase, a coordinator polls all participants for their readiness to commit; in the commit phase, it broadcasts the final decision based on unanimous consensus from the prepare phase. 2PC is the foundational protocol for distributed ACID transactions but is blocking in the presence of coordinator failure, a limitation addressed by Three-Phase Commit and Paxos-based variants."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:transaction-manager ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:write-ahead-logging ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:persistent-storage ],
        ngm:distributed-system-protocol ;
    vc:bridgesTo ngm:atomic-swap,
        ngm:blockchain ;
    vc:contrastsWith ngm:paxos,
        ngm:raft-consensus,
        ngm:saga-pattern ;
    vc:dependsOn ngm:crash-recovery ;
    vc:enables ngm:acid-properties,
        ngm:transaction-confirmation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:commit-phase,
        ngm:transaction-manager ;
    vc:isPartOf ngm:distributed-transaction ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:consensus-protocol,
        ngm:distributed-consensus,
        ngm:transaction-finality,
        ngm:transaction-processing ;
    vc:requires ngm:persistent-storage,
        ngm:write-ahead-logging ;
    vc:slug "two-phase-commit" ;
    vc:sourceDomain "distributed-systems" ;
    vc:standardizedBy ngm:iso-iec ;
    vc:supports ngm:relational-database ;
    vc:uses ngm:database-system,
        ngm:distributed-systems .

ngm:w3-c-did-core a owl:Class ;
    rdfs:label "W3C DID Core"@en ;
    rdfs:comment "W3C DID Core is the World Wide Web Consortium Recommendation (published July 2022) defining Decentralised Identifiers (DIDs) — globally unique, controller-owned URIs of the form did:<method>:<method-specific-id> that are cryptographically verifiable and resolvable without a centralised registration authority. Each DID resolves to a JSON-LD DID Document containing verification methods (public keys), authentication suites, and service endpoints. The specification is method-agnostic, accommodating distributed ledgers, peer-to-peer networks, and web servers as verifiable data registries, and forms the identity layer of the broader Self-Sovereign Identity and Verifiable Credentials ecosystem."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:did-document ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:service-endpoint ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:verification-method ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:cryptographic-signature ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:did-resolver ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:did-method ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:public-key-cryptography ],
        ngm:decentralised-identity ;
    vc:bridgesTo ngm:ai-agent-identity,
        ngm:federated-learning,
        ngm:internet-of-things ;
    vc:contrastsWith ngm:oauth-2-0,
        ngm:open-id-connect,
        ngm:x-509-certificate ;
    vc:enables ngm:digital-identity-wallet,
        ngm:self-sovereign-identity,
        ngm:verifiable-credentials,
        ngm:zero-knowledge-proof ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:did-document,
        ngm:did-method,
        ngm:service-endpoint,
        ngm:verification-method ;
    vc:implements ngm:self-sovereign-identity,
        ngm:uri-scheme ;
    vc:qualityScore "0.76"^^xsd:float ;
    vc:relatedTo ngm:linked-data-proofs,
        ngm:sidetree-protocol ;
    vc:requires ngm:cryptographic-signature,
        ngm:did-resolver,
        ngm:public-key-cryptography ;
    vc:slug "w3-c-did-core" ;
    vc:sourceDomain "blockchain" ;
    vc:standardizedBy ngm:world-wide-web-consortium ;
    vc:supports ngm:access-control,
        ngm:credential-exchange,
        ngm:digital-identity ;
    vc:uses ngm:distributed-ledger-technology,
        ngm:elliptic-curve-cryptography,
        ngm:json-data-interchange-format-ld .

ngm:web-standard a owl:Class ;
    rdfs:label "Web Standard"@en ;
    rdfs:comment "A Web Standard is a formally published technical specification developed by recognised standards bodies—primarily the W3C, WHATWG, IETF, and ECMA International—that defines interoperable behaviours, data formats, APIs, or protocols for the open web. These specifications undergird every browser-rendered application by guaranteeing that HTML, CSS, JavaScript, and associated platform APIs behave consistently across vendor implementations. Web Standards are normative documents that pass through community drafting, multi-stakeholder review, and vendor implementation before reaching Recommendation or Living Standard status, ensuring that the web remains an open, royalty-free platform."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:html ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:css ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:web-api ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:http ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:java-script ],
        ngm:technical-standard ;
    vc:bridgesTo ngm:web-assembly,
        ngm:web-gl,
        ngm:webgpu ;
    vc:contrastsWith ngm:vendor-lock-in ;
    vc:enables ngm:interoperability,
        ngm:progressive-web-app,
        ngm:web-xr ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:css,
        ngm:html,
        ngm:http,
        ngm:java-script,
        ngm:web-api ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:interoperability,
        ngm:open-source,
        ngm:web-platform ;
    vc:requires ngm:browser-engine ;
    vc:slug "web-standard" ;
    vc:sourceDomain "standards" ;
    vc:standardizedBy ngm:ecma-international,
        ngm:ietf,
        ngm:w3-c ;
    vc:supports ngm:accessibility,
        ngm:privacy .

ngm:51-attack a owl:Class ;
    rdfs:label "51% Attack"@en ;
    rdfs:comment "A 51% Attack is a consensus-layer attack on a Proof-of-Work blockchain in which a single entity or coalition controls more than half of the network's hash rate, enabling double-spending, transaction censorship, and chain reorganisation. The attack exploits the longest-chain rule: the attacker mines a private fork containing fraudulent transactions and, once it exceeds the honest chain in cumulative work, broadcasts it to override confirmed history."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:proof-of-work ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:mining ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:mining-pool ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:hash-rate ],
        ngm:bc-protocol-and-consensus ;
    skos:broader ngm:bc-protocol-and-consensus ;
    vc:bridgesTo ngm:ai-energy-optimisation,
        ngm:game-theory,
        ngm:network-security ;
    vc:contrastsWith ngm:byzantine-fault-tolerance,
        ngm:proof-of-stake ;
    vc:dependsOn ngm:blockchain,
        ngm:cryptocurrency,
        ngm:mining-hardware ;
    vc:enables ngm:chain-reorganization,
        ngm:double-spending,
        ngm:transaction-censorship ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:blockchain-security ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:ethereum-smart-contract-platform-classic,
        ngm:finality,
        ngm:selfish-mining,
        ngm:transaction ;
    vc:requires ngm:hash-rate,
        ngm:mining,
        ngm:mining-pool,
        ngm:proof-of-work ;
    vc:slug "51-attack" ;
    vc:sourceDomain "blockchain" .

ngm:ai-model-card a owl:Class ;
    rdfs:label "AI Model Card"@en ;
    rdfs:comment "A structured documentation format that describes an AI Model's purpose, Performance Metrics, limitations, ical Considerations, and appropriate Use Case|use cases to promote Transparency and Responsible AI Deployment|responsible deployment."@en ;
