    vc:slug "voice-assistant" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:voice-interaction a owl:Class ;
    rdfs:label "Voice Interaction"@en ;
    rdfs:comment "Communication mod enabling control and conversation through speech recognition, natural language understanding, and text-to-speech synthesis."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
