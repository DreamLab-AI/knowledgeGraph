ngm:content-interoperability a owl:Class ;
    rdfs:label "Content Interoperability"@en ;
    rdfs:comment "Content interoperability is the ability of digital assets to be created, exchanged, and rendered consistently across different platforms, engines, and tools without loss of fidelity. It depends on shared open formats, agreed schemas, and conformant import/export behaviour. In the metaverse it is the precondition for portable 3D assets, avatars, and scenes that work across virtual worlds."@en ;
    rdfs:subClassOf ngm:sc-standards-and-interop ;
    skos:broader ngm:sc-standards-and-interop ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:gl-tf-3-d-file-format,
        ngm:metaverse-content-pipeline ;
    vc:slug "content-interoperability" ;
    vc:sourceDomain "metaverse" .

ngm:content-portability a owl:Class ;
    rdfs:label "Content Portability"@en ;
    rdfs:comment "Content portability is the property that allows users to move their digital content and the associated rights between services, platforms, or virtual environments. It depends on standardised data formats and export mechanisms so that assets retain structure and meaning after transfer. It supports user ownership, reduces vendor lock-in, and is a stated goal of open data and open metaverse initiatives."@en ;
    rdfs:subClassOf ngm:sc-standards-and-interop ;
    skos:broader ngm:sc-standards-and-interop ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:asset-format-standards,
        ngm:data-format-standard ;
    vc:slug "content-portability" ;
    vc:sourceDomain "metaverse" .

