ngm:sensor-fusion a owl:Class ;
    rdfs:label "Sensor Fusion"@en ;
    rdfs:comment "Sensor Fusion is the process of combining data from multiple sensors (camera, lidar, radar, GPS, IMU) to produce more accurate, reliable, and complete information than could be obtained from any individual sensor. It employs algorithms including Kalman filtering, particle filtering, and deep learning-based fusion to integrate complementary sensor modalities whilst managing noise, uncertainties, and hardware failures."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:radar ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:camera-sensor ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
