ngm:partition-attack a owl:Class ;
    rdfs:label "Partition Attack"@en ;
    rdfs:comment "A Partition Attack is a network-level attack against a blockchain in which an adversary manipulates routing infrastructure to segment the peer-to-peer network into two or more isolated subgraphs, causing each partition to mine or validate on a separate chain branch. When the partition is healed the shorter branch is discarded, enabling the attacker to waste honest mining power and potentially facilitate double-spend attacks."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:peer-to-peer-network ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:network-topology ],
        ngm:bc-protocol-and-consensus,
        ngm:blockchain-entity,
        ngm:network-component ;
    skos:broader ngm:bc-protocol-and-consensus ;
    vc:contrastsWith ngm:byzantine-fault-tolerance ;
    vc:enables ngm:double-spending,
        ngm:selfish-mining ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:cybersecurity ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:attack-vector,
        ngm:blockchain-network,
        ngm:cryptographic-security,
        ngm:eclipse-attack,
        ngm:sybil-attack ;
    vc:requires ngm:network-topology,
        ngm:peer-to-peer-network ;
    vc:slug "partition-attack" ;
    vc:sourceDomain "blockchain" .

ngm:patent a owl:Class ;
    rdfs:label "Patent"@en ;
    rdfs:comment "A time-limited exclusive right granted by a sovereign authority to an inventor for a novel, inventive, and industrially applicable invention, in exchange for public disclosure of the invention. In the AI and spatial computing landscape, patents protect novel model architectures, training methods, compression algorithms, and hardware accelerators, with global filings exceeding 3.7 million applications annually as of 2024."@en ;
    rdfs:subClassOf ngm:infra-legal-and-regulatory ;
    skos:broader ngm:infra-legal-and-regulatory ;
