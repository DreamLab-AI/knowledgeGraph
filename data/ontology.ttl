        ngm:design-systems,
        ngm:usability-testing,
        ngm:user-experience,
        ngm:user-interface ;
    vc:requires ngm:cognitive-science,
        ngm:prototyping,
        ngm:user-research ;
    vc:slug "interaction-design" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:information-architecture,
        ngm:mental-model,
        ngm:task-analysis .

ngm:medical-imaging a owl:Class ;
    rdfs:label "Medical Imaging"@en ;
    rdfs:comment "Medical imaging is the acquisition, reconstruction, processing, and computational analysis of visual representations of human anatomy and physiology — including X-ray, computed tomography (CT), magnetic resonance imaging (MRI), ultrasound, positron emission tomography (PET), single-photon emission computed tomography (SPECT), and digital pathology — for the purposes of clinical diagnosis, treatment planning, surgical guidance, and longitudinal disease monitoring. The field has undergone a fundamental shift with the integration of deep learning methods, particularly convolutional neural networks, vision transformers, and diffusion-based models, which now perform organ segmentation, lesion detection, and disease classification at or near radiologist-level accuracy on constrained benchmarks. Data interoperability is standardised by DICOM (Digital Imaging and Communications in Medicine) for image storage and transfer, and by HL7 FHIR for clinical report integration; AI-based clinical decision software requires regulatory clearance such as FDA 510(k) premarket notification, EU MDR/IVDR conformity assessment, or UKCA marking."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:object-detection ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gpu-computing ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:image-segmentation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:dicom ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-annotation ],
        ngm:healthcare-ai ;
    vc:bridgesTo ngm:augmented-reality,
        ngm:digital-twin ;
    vc:contrastsWith ngm:natural-language-processing ;
    vc:enables ngm:clinical-decision-support,
        ngm:precision-medicine,
        ngm:radiology-ai,
        ngm:surgical-robotics ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:image-segmentation,
        ngm:object-detection ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:electronic-health-record,
        ngm:healthcare-ai ;
