        ngm:national-energy-statistics ;
    vc:enables ngm:carbon-disclosure,
        ngm:carbon-footprint-measurement,
        ngm:environmental-impact-metric,
        ngm:greenhouse-gas-inventory ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:scope-1-emissions,
        ngm:scope-2-emissions,
        ngm:scope-3-emissions ;
    vc:isPartOf ngm:carbon-accounting,
        ngm:environmental-accounting ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:carbon-footprint-assessment ;
    vc:requires ngm:activity-data,
        ngm:ghg-protocol,
        ngm:life-cycle-assessment ;
    vc:slug "emission-factors" ;
    vc:sourceDomain "governance" ;
    vc:standardizedBy ngm:iea-statistics,
