            owl:someValuesFrom ngm:predicate-logic ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:formal-language ],
        ngm:knowledge-representation ;
    vc:bridgesTo ngm:information-theory,
        ngm:machine-learning,
        ngm:natural-language-processing ;
    vc:contrastsWith ngm:fuzzy-logic,
        ngm:probabilistic-reasoning ;
    vc:enables ngm:automated-reasoning,
        ngm:formal-verification,
        ngm:knowledge-representation,
        ngm:theorem-proving ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:description-logic,
        ngm:modal-logic,
        ngm:predicate-logic,
