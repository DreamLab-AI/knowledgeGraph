ngm:auc a owl:Class ;
    rdfs:label "AUC"@en ;
    rdfs:comment "Area Under the Curve (AUC), specifically the area under the Receiver Operating Characteristic (ROC) curve (ROC-AUC or AUROC), is a single scalar performance metric for binary classifiers representing the probability that the model ranks a randomly chosen positive instance higher than a randomly c..."@en ;
