ngm:user-privacy a owl:Class ;
    rdfs:label "User Privacy"@en ;
    rdfs:comment "User Privacy encompasses the rights, technical mechanisms, and regulatory obligations protecting individuals from unwanted disclosure of their identity, transactions, and behavioural patterns within digital and blockchain systems. Protections span cryptographic techniques (zero-knowledge proofs, ring signatures, confidential transactions), network-layer obfuscation (Dandelion++, Tor), and compliance frameworks (GDPR, data minimisation principles)."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-protection ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gdpr-compliance ],
        ngm:infra-legal-and-regulatory,
        ngm:privacy-framework ;
    skos:broader ngm:infra-legal-and-regulatory ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:cryptography-security-and-privacy,
        ngm:privacy-by-design ;
    vc:requires ngm:data-protection,
        ngm:gdpr-compliance ;
    vc:slug "user-privacy" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:differential-privacy,
        ngm:encryption,
        ngm:zero-knowledge-proof .

ngm:user-privacy-control a owl:Class ;
    rdfs:label "User Privacy Control"@en ;
    rdfs:comment "User privacy controls are interface and systemic mechanisms that allow individuals to view, modify, restrict, or delete their personal data held by an AI or data-driven system. They operationalise data subject rights such as the right to be forgotten, consent withdrawal, and data portability mandated by regulations like GDPR. Effective privacy controls combine technical enforcement — such as deletion pipelines and audit trails — with accessible user interfaces."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:consent-management ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gdpr-compliance ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:access-control ],
        ngm:ai-governance-and-ethics,
        ngm:privacy-mechanism ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:enables ngm:data-minimisation,
        ngm:right-to-be-forgotten,
        ngm:transparency ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:privacy-by-design,
        ngm:privacy-framework ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:algorithmic-accountability,
        ngm:data-protection,
        ngm:privacy-impact-assessment,
        ngm:user-interface ;
    vc:requires ngm:access-control,
        ngm:consent-management,
        ngm:gdpr-compliance ;
    vc:slug "user-privacy-control" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:personal-data-store .

