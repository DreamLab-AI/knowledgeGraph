# Spatial Anchoring
spatial-computing:SpatialAnchoring rdf:type owl:Class ;
    rdfs:subClassOf spatial-computing:SpatialComputing ;
    rdfs:label "Spatial Anchoring"@en ;
    rdfs:comment "A technique for locking virtual objects to specific physical locations using environmental mapping, enabling persistent placement of digital content that maintains consistent position and orientation relative to real-world surfaces across sessions and devices through SLAM-based tracking and cloud-synchronized anchor data."@en ;
    skos:prefLabel "Spatial Anchoring"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:spatial-computing:spatial-anchoring" ;
