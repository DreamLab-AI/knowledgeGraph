        ngm:neural-radiance-field,
        ngm:photogrammetry,
        ngm:slam .

ngm:threat-modelling a owl:Class ;
    rdfs:label "Threat Modelling"@en ;
    rdfs:comment "Threat modelling is a structured security engineering process that identifies, enumerates, and prioritises potential threats to a system by reasoning systematically about adversaries, attack vectors, and mitigations before or during design. It produces an explicit model of what can go wrong, enabling security controls to be allocated proportionally to risk, and is applied across software, hardware, and AI systems throughout the development lifecycle."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:system-architecture ],
        ngm:risk-assessment ;
    vc:bridgesTo ngm:ai-safety,
        ngm:supply-chain-risk-management ;
    vc:contrastsWith ngm:vulnerability-analysis ;
    vc:enables ngm:risk-mitigation,
        ngm:security-by-design,
        ngm:vulnerability-management ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:trust-boundary ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:penetration-testing,
        ngm:vulnerability-assessment ;
    vc:requires ngm:adversary-model,
        ngm:system-architecture ;
    vc:slug "threat-modelling" ;
    vc:sourceDomain "security" ;
    vc:standardizedBy ngm:iso-27001,
        ngm:nist-sp-800-30 ;
    vc:uses ngm:attack-vector,
        ngm:cvss,
        ngm:data-flow-diagram,
        ngm:threat-model .

ngm:xml a owl:Class ;
    rdfs:label "XML"@en ;
    rdfs:comment "XML (Extensible Markup Language) is a W3C-standardised, text-based markup language for encoding documents and structured data in a format that is both human-readable and machine-processable. It defines a strict syntax of nested, attributed elements and supports schema languages (DTD, XML Schema, RELAX NG) for validation, plus a family of related standards for querying, transforming and namespacing. Once dominant for data interchange and configuration, it remains foundational to many enterprise, financial and document standards even as JSON has overtaken it for lightweight web interchange."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:schema ],
        ngm:data-serialization ;
    vc:bridgesTo ngm:api ;
    vc:contrastsWith ngm:html,
        ngm:yaml ;
    vc:dependsOn ngm:data-serialization ;
    vc:enables ngm:data-serialization,
        ngm:interoperability ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:implements ngm:rdf-schema ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:interoperability,
        ngm:ontology,
        ngm:rest ;
    vc:requires ngm:schema ;
    vc:slug "xml" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:owl,
        ngm:rdf,
        ngm:soap ;
    vc:uses ngm:schema .

ngm:bitcoin-script a owl:Class ;
    rdfs:label "Bitcoin Script"@en ;
    rdfs:comment "Bitcoin Script is a non-Turing-complete, stack-based scripting language embedded in every Bitcoin transaction that defines the conditions under which unspent transaction outputs (UTXOs) may be spent. It consists of a constrained set of opcodes operating on a last-in-first-out (LIFO) stack, deliberately designed without loops or unbounded recursion to ensure guaranteed termination and predictable resource consumption. Script programs are expressed as paired locking scripts (scriptPubKey) and unlocking scripts (scriptSig or SegWit witness data) that encode spending conditions including digital signature verification, multisignature requirements, hash pre-image revelation, and time locks. Standard output templates — P2PKH, P2SH, P2WPKH, P2WSH, and P2TR — formalise the most common spending patterns used across the Bitcoin network."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:stack-machine ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:witness-data ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:bitcoin-transaction ],
        ngm:scripting-language ;
    vc:bridgesTo ngm:formal-verification,
        ngm:zero-knowledge-proof ;
    vc:contrastsWith ngm:ethereum-smart-contract-platform-virtual-machine,
        ngm:solidity,
        ngm:turing-complete-language ;
    vc:enables ngm:atomic-swap,
        ngm:bitcoin,
        ngm:bitcoin-proof-of-work-protocol-ordinals,
        ngm:hash-time-locked-contract,
        ngm:lightning-network,
        ngm:multisignature-wallets ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:witness-data ;
    vc:implements ngm:pay-to-public-key-hash,
        ngm:pay-to-script-hash,
        ngm:taproot ;
    vc:isPartOf ngm:bitcoin-proof-of-work-protocol-core,
        ngm:utxo-model ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:merklised-abstract-syntax-tree,
        ngm:programming-language,
        ngm:segregated-witness ;
    vc:requires ngm:bitcoin-transaction,
        ngm:stack-machine ;
    vc:slug "bitcoin-script" ;
    vc:sourceDomain "blockchain" ;
    vc:standardizedBy ngm:bitcoin-proof-of-work-protocol-improvement-proposals ;
    vc:uses ngm:cryptographic-hash-function,
        ngm:digital-signature,
        ngm:elliptic-curve-cryptography,
        ngm:opcodes,
        ngm:schnorr-signature .

ngm:collaborative-systems-modality-robot a owl:Class ;
    rdfs:label "Collaborative Robot"@en ;
    rdfs:comment "Collaborative Robot (cobot) - A lightweight robotic arm engineered to operate safely alongside human workers, combining force/torque sensing, reduced kinetic energy, and speed limitations to enable Human-Robot Collaboration in shared manufacturing and assembly environments. Cobots are distinguished from traditional industrial robots by their intrinsic safety mechanisms, ease of programming, and ability to share workspace with humans without physical guarding barriers."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:rb-0094-power-and-force-limiting ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:force-torque-sensor ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:end-effector ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:iso-ts-15066 ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
