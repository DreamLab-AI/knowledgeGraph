] .

# Spatial Interaction
spatial-computing:SpatialInteraction rdf:type owl:Class ;
    rdfs:subClassOf spatial-computing:HumanComputerInteraction ;
    rdfs:label "Spatial Interaction"@en ;
    rdfs:comment "The design and implementation of user input methods within extended reality environments that enable natural manipulation of virtual objects through gestures, eye tracking, voice commands, and physical movement in three-dimensional space."@en ;
