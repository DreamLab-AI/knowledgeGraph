        ngm:terraform .

ngm:kubernetes a owl:Class ;
    rdfs:label "Kubernetes"@en ;
    rdfs:comment "Kubernetes (K8s) is an open-source container orchestration platform originally developed by Google and donated to the Cloud Native Computing Foundation (CNCF) in 2014. It automates the deployment, scaling, scheduling, and lifecycle management of containerised workloads across clusters of physical or virtual machines. Kubernetes abstracts infrastructure resources into declarative objects—Pods, Deployments, Services, and Namespaces—that describe desired state, with a control plane continuously reconciling actual state to match the specification."@en ;
    rdfs:subClassOf ngm:orchestration ;
    vc:dependsOn ngm:distributed-systems,
        ngm:software-infrastructure ;
    vc:enables ngm:cloud-infrastructure,
        ngm:distributed-computing,
        ngm:machine-learning-discipline-infrastructure,
        ngm:platform-engineering,
        ngm:resource-management ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:cloud-native-applications,
        ngm:distributed-system,
        ngm:microservices-architecture,
        ngm:software-platform,
        ngm:technology-infrastructure ;
    vc:slug "kubernetes" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:cloud-computing,
        ngm:distributed-training ;
    vc:uses ngm:api-gateway,
        ngm:event-driven-architecture .

ngm:tool-use a owl:Class ;
    rdfs:label "Tool Use"@en ;
    rdfs:comment "Tool Use is the capability of large language models and AI agent systems to invoke external functions, APIs, databases, or services at inference time, extending the model's effective knowledge and action repertoire beyond pure text generation. The model receives a structured description of available tools — a tool schema encoding names, descriptions, and JSON Schema parameter specifications — reasons about which tool to call and with what arguments, executes that call via a surrounding orchestration layer, and incorporates the returned observation into its subsequent reasoning. This capability is foundational to agentic AI systems that must take real-world actions such as code execution, web search, database queries, file manipulation, or actuator control, bridging the boundary between language generation and executable computation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:json-data-interchange-format-schema ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:orchestration-layer ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:tool-schema ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:function-calling ],
        ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:bridgesTo ngm:api-gateway,
        ngm:robotic-process-automation ;
    vc:contrastsWith ngm:fine-tuning,
        ngm:retrieval-augmented-generation ;
    vc:dependsOn ngm:inference-time-computation,
        ngm:prompt-engineering ;
    vc:enables ngm:agentic-ai,
        ngm:autonomous-agent,
        ngm:code-execution,
        ngm:multi-step-reasoning,
        ngm:retrieval-augmented-generation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:function-calling,
        ngm:model-context-protocol ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:chain-of-thought,
        ngm:multi-agent-system,
        ngm:planning,
        ngm:react-prompting ;
    vc:requires ngm:function-calling,
        ngm:json-data-interchange-format-schema,
        ngm:orchestration-layer,
        ngm:tool-schema ;
    vc:slug "tool-use" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:access-control,
        ngm:audit-logging,
        ngm:human-in-the-loop ;
    vc:uses ngm:context-window,
        ngm:large-language-models,
        ngm:structured-output .

ngm:cryptographic-hash a owl:Class ;
    rdfs:label "Cryptographic Hash"@en ;
    rdfs:comment "Deterministic mathematical function transforming arbitrary input data into a fixed-length digest, guaranteeing data integrity verification and tamper detection through collision resistance, pre-image resistance, and avalanche-effect properties."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:collision-resistance ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:avalanche-effect ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:hash-function ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:one-way-function ],
        ngm:bc-cryptographic-primitive ;
    skos:broader ngm:bc-cryptographic-primitive ;
    vc:bridgesTo ngm:ai-agent-system,
        ngm:decentralised-identity,
        ngm:supply-chain-provenance ;
    vc:contrastsWith ngm:checksums,
