ngm:commons-stack a owl:Class ;
    rdfs:label "Commons Stack"@en ;
    rdfs:comment "Commons Stack is an initiative providing tools and economic models for funding and governing public goods through token-based communities. It draws on mechanisms such as bonding curves and continuous funding."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:tokenomics ],
        ngm:knowledge-graph-publication-classifier-goods-funding ;
    vc:enables ngm:quadratic-funding ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:tokenomics ;
    vc:slug "commons-stack" ;
    vc:sourceDomain "blockchain" .

