ngm:representation-learning a owl:Class ;
    rdfs:label "Representation Learning"@en ;
    rdfs:comment "Representation learning is a subfield of machine learning concerned with automatically discovering the data transformations and feature spaces — representations — that make subsequent learning tasks easier, more accurate, or more data-efficient. Rather than relying on hand-crafted features, representation learning systems learn to encode raw inputs such as images, text, or sensor readings into dense, structured latent vectors that capture semantically meaningful variation. Deep neural networks, particularly transformers and convolutional architectures, have made learned representations ubiquitous across computer vision, natural language processing, and multi-modal AI. The quality of learned representations directly determines the performance ceiling of downstream models trained on top of them."@en ;
    rdfs:subClassOf ngm:machine-learning-technique ;
    vc:enables ngm:contrastive-learning,
        ngm:self-supervised-learning,
        ngm:transfer-learning ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:embedding-model,
        ngm:feature-extraction ;
    vc:slug "representation-learning" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:deep-learning,
        ngm:embeddings,
        ngm:latent-space .

ngm:reranker a owl:Class ;
    rdfs:label "Reranker"@en ;
    rdfs:comment "A reranker is a second-stage scoring model in information retrieval and retrieval-augmented generation pipelines that reorders a set of candidate documents or passages — initially retrieved by a fast first-stage retriever such as a dense vector index — using a more computationally intensive cross-encoder or LLM-based relevance model that jointly encodes the query and each candidate together, producing a higher-precision relevance score than bi-encoder similarity alone. Rerankers trade retrieval speed for ranking quality, operating on a reduced candidate set (typically 50-200 passages) rather than the full corpus, thereby making deep transformer inference tractable at query time."@en ;
    rdfs:subClassOf ngm:information-retrieval ;
    vc:enables ngm:retrieval-augmented-generation,
        ngm:semantic-search ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:language-model,
        ngm:machine-learning-technique ;
    vc:slug "reranker" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:embedding-model,
        ngm:large-language-models,
        ngm:natural-language-processing .

ngm:rgb-protocol a owl:Class ;
    rdfs:label "RGB Protocol"@en ;
    rdfs:comment "RGB Protocol is a client-side validation protocol built on top of Bitcoin and the Lightning Network that enables the issuance and transfer of smart contracts and tokenised assets (fungible and non-fungible) without placing contract state on the blockchain. Instead, RGB stores contract state in off-chain client-side data structures and uses Bitcoin UTXOs as single-use seals, with only cryptographic commitments anchored to Bitcoin transactions. This design inherits Bitcoin's security and censorship resistance while providing scalability, privacy, and programmability not available on-chain."@en ;
    rdfs:subClassOf ngm:blockchain-protocol ;
    vc:enables ngm:asset-tokenization,
        ngm:layer-2-scaling,
        ngm:smart-contract ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:client-side-dco,
        ngm:rgb-and-client-side-validation,
        ngm:taproot-assets ;
    vc:slug "rgb-protocol" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:bitcoin-network,
        ngm:cryptographic-commitment,
        ngm:lightning-network,
        ngm:utxo-model .

ngm:risk-management-framework a owl:Class ;
    rdfs:label "Risk Management Framework"@en ;
    rdfs:comment "A Risk Management Framework is a structured methodology for identifying, assessing, treating, and monitoring risks to an organisation's objectives, assets, or systems. It provides a repeatable process and governance structure that links risk appetite, control selection, and assurance activities into a coherent programme aligned with recognised standards such as ISO 31000, NIST RMF, or the NIST AI RMF."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:risk-mitigation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:risk-assessment ],
        ngm:risk-management ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:compliance,
        ngm:governance-framework,
        ngm:threat-modelling ;
    vc:requires ngm:risk-assessment,
        ngm:risk-mitigation ;
    vc:slug "risk-management-framework" ;
    vc:sourceDomain "governance" ;
    vc:uses ngm:nist,
        ngm:security-framework .

ngm:robot-component a owl:Class ;
    rdfs:label "Robot Component"@en ;
    rdfs:comment "A Robot Component is any modular element forming part of a robotic system, encompassing hardware modules (motors, sensors, links, joints), electrical components (power supplies, motor drivers, embedded computers), software components (perception modules, planners, controllers), and interface components (communication protocols, connectors, mounting systems). Standardised component interfaces—ISO 9409 tool flanges, EtherCAT, ROS 2—enable plug-and-play integration, reducing development time and supporting modular system design, component reuse, and hierarchical decomposition."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:sensor-fusion ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:end-effector ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:actuator ],
        ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:enables ngm:manipulation ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:actuator,
        ngm:end-effector,
        ngm:sensor-fusion ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:slug "robot-component" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:control-system .

ngm:robotic-control a owl:Class ;
    rdfs:label "Robotic Control"@en ;
    rdfs:comment "Robotic control is the discipline of designing algorithms and hardware that regulate the motion, force, and behaviour of robotic systems to achieve desired trajectories or task objectives in the presence of dynamic uncertainty, environmental disturbances, and physical constraints. It spans classical feedback control strategies such as PID, computed-torque, and impedance control, through to model-predictive and learning-based controllers that adapt online. Robotic control integrates kinematics, dynamics, estimation, and optimisation to translate high-level task plans into actuator commands. It is a foundational competency enabling manipulation, locomotion, and human-robot interaction across industrial and service robot applications."@en ;
    rdfs:subClassOf ngm:control-system ;
    vc:enables ngm:autonomous-robot,
        ngm:collaborative-robot,
        ngm:multi-robot-systems ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:adaptive-control,
        ngm:control-theory,
        ngm:optimal-control,
        ngm:torque-control ;
    vc:slug "robotic-control" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:force-control,
        ngm:inverse-kinematics,
        ngm:motion-control,
        ngm:pid-control .

ngm:robotic-process-automation a owl:Class ;
    rdfs:label "Robotic Process Automation"@en ;
    rdfs:comment "Robotic Process Automation (RPA) is a software technology that uses configurable software robots to emulate human interactions with digital systems — clicking, typing, extracting data, navigating UIs — in order to execute repetitive, rule-based business processes without modifying the underlying applications. RPA robots operate at the presentation layer, interacting with applications through their graphical or web interfaces rather than through APIs, enabling automation of legacy systems that lack integration points."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:business-process-management ],
        ngm:process-automation ;
    vc:enables ngm:enterprise-automation,
        ngm:intelligent-automation ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:business-process-automation,
        ngm:task-automation ;
    vc:requires ngm:business-process-management ;
    vc:slug "robotic-process-automation" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:workflow-automation .

ngm:room-scale a owl:Class ;
    rdfs:label "Room Scale"@en ;
    rdfs:comment "A VR interaction paradigm in which the user can physically walk within a tracked play area — typically 2m × 2m or larger — with inside-out or lighthouse-based positional tracking translating real-world movement into the virtual environment. Room-scale VR requires boundary (chaperone) systems to prevent collisions with physical obstacles, and is contrasted with seated or standing-only VR experiences."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:sensor-fusion ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:virtual-reality-platform ],
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:enables ngm:haptics,
        ngm:virtual-reality ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:metaverse-infrastructure ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:augmented-reality,
        ngm:xr-meeting-space ;
    vc:requires ngm:sensor-fusion,
        ngm:virtual-reality-platform ;
    vc:slug "room-scale" ;
    vc:sourceDomain "spatial-computing" .

ngm:routing-protocol a owl:Class ;
    rdfs:label "Routing Protocol"@en ;
    rdfs:comment "A protocol that determines how packets are forwarded between nodes in a network by computing and distributing routing information among routers."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:network-architecture ],
