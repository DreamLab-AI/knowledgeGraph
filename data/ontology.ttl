ngm:bitcoin-centralisation-risks a owl:Class ;
    rdfs:label "Bitcoin Centralisation Risks"@en ;
    rdfs:comment "Bitcoin Centralisation Risks refers to the ensemble of systemic vulnerabilities arising from the progressive concentration of economic power, computational control, physical infrastructure, custody arrangements, development authority, and payment routing within Bitcoin's nominally decentralised e..."@en ;
    rdfs:subClassOf ngm:blockchain-governance-risk,
        ngm:concentration-risk ;
    vc:enables ngm:51-attack,
        ngm:eclipse-attack,
        ngm:protocol-capture,
        ngm:regulatory-capture,
        ngm:supply-chain-attack,
        ngm:sybil-attack,
        ngm:transaction-censorship ;
    vc:hasPart ngm:asic-manufacturer-duopoly,
        ngm:custodial-concentration,
        ngm:developer-centralisation,
        ngm:geographic-hashrate-concentration,
        ngm:institutional-holder-concentration,
        ngm:lightning-network-hub-centralisation,
        ngm:mining-pool-concentration ;
    vc:implements ngm:gini-coefficient-analysis,
        ngm:hashrate-distribution-analysis,
        ngm:herfindahl-hirschman-index,
        ngm:nakamoto-coefficient,
        ngm:network-topology-analysis ;
    vc:maturity "established" ;
    vc:qualityScore "0.52"^^xsd:float ;
    vc:relatedTo ngm:51-attack,
        ngm:ant-pool,
        ngm:asic,
        ngm:bitcoin,
        ngm:bitcoin-core,
        ngm:bitmain,
        ngm:black-rock,
