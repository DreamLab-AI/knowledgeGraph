    vc:slug "proof-based-consensus" ;
    vc:sourceDomain "blockchain" .

ngm:proof-of-personhood a owl:Class ;
    rdfs:label "Proof Of Personhood"@en ;
    rdfs:comment "Proof of personhood is a mechanism for establishing that a participant in a digital system is a unique, real human being without necessarily revealing their full identity. It addresses Sybil resistance by ensuring one person cannot cheaply masquerade as many, which is critical for fair voting, airdrops and universal-basic-income style distributions. Approaches range from biometric uniqueness checks to social-graph and in-person verification protocols."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:identity-verification ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:biometric-authentication ],
        ngm:digital-identity ;
    vc:bridgesTo ngm:verifiable-credentials ;
    vc:contrastsWith ngm:authentication ;
    vc:dependsOn ngm:identity ;
    vc:enables ngm:self-sovereign-identity,
        ngm:verifiable-credentials ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:implements ngm:digital-identity ;
    vc:isPartOf ngm:digital-identity ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:biometric-authentication,
        ngm:digital-identity,
        ngm:self-sovereign-identity,
        ngm:zero-knowledge-proof ;
    vc:requires ngm:biometric-authentication,
        ngm:identity-verification ;
    vc:slug "proof-of-personhood" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:cryptography,
        ngm:zero-knowledge-proof .

ngm:proportional-control a owl:Class ;
    rdfs:label "Proportional Control"@en ;
    rdfs:comment "Proportional Control is a feedback control strategy in which the corrective output applied to an actuator is directly proportional to the current error—the difference between the desired setpoint and the measured process variable. It is the foundational component of PID controllers, providing immediate, scaled response to deviations but typically leaving a steady-state offset that requires integral or derivative terms to eliminate."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:control-algorithm ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:feedback-control ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:actuator ],
        ngm:feedback-control,
        ngm:robo-actuation-and-control ;
    skos:broader ngm:robo-actuation-and-control ;
    vc:contrastsWith ngm:adaptive-control,
        ngm:derivative-control ;
    vc:enables ngm:motion-control,
        ngm:position-control,
        ngm:velocity-control ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:control-algorithm ;
    vc:isPartOf ngm:closed-loop-control,
        ngm:pid-controller ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:control-system,
        ngm:control-theory ;
    vc:requires ngm:actuator,
        ngm:feedback-control ;
    vc:slug "proportional-control" ;
    vc:sourceDomain "robotics" .

