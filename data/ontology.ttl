ngm:training-instability a owl:Class ;
    rdfs:label "Training Instability"@en ;
    rdfs:comment "A set of pathological behaviours during neural network optimisation — including exploding gradients, vanishing gradients, loss divergence, and oscillating loss curves — that prevent a model from converging to a useful solution. Training instability arises from interactions between architecture depth, learning rate, batch size, and numerical precision, and is mitigated through techniques such as gradient clipping, mixed-precision training, careful initialisation, and adaptive optimisers."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gradient-clipping ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gradient-descent ],
        ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:contrastsWith ngm:overfitting ;
    vc:dependsOn ngm:hyperparameter,
        ngm:loss-function,
        ngm:neural-network ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:deep-learning,
        ngm:mixed-precision-training,
        ngm:model-training ;
    vc:requires ngm:gradient-clipping,
        ngm:gradient-descent ;
    vc:slug "training-instability" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:distributed-training,
        ngm:learning-rate-schedule .

ngm:training-loop a skos:Concept ;
    rdfs:label "Training Loop"@en .

ngm:training-method a owl:Class ;
    rdfs:label "Training Method"@en ;
    rdfs:comment "A Training Method is a systematic algorithm or procedure used to optimise the parameters of a machine learning model by minimising a loss function through iterative updates over labelled or unlabelled data. Training methods span the full spectrum from supervised and unsupervised learning to reinforcement learning and self-supervised pre-training, each with distinct update rules, convergence properties, and data requirements. Specific optimisers such as gradient descent, Adam, and RMSprop, together with regularisation strategies like dropout and batch normalisation, are key components within training methods."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:gradient-descent ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:supervised-learning ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:backpropagation ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:pre-training ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:unsupervised-learning ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:loss-function ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:neural-network ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:reinforcement-learning ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:fine-tuning ],
        ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:backpropagation,
        ngm:fine-tuning,
        ngm:gradient-descent,
        ngm:pre-training,
        ngm:reinforcement-learning,
        ngm:supervised-learning,
        ngm:unsupervised-learning ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:distributed-training,
        ngm:gradient-clipping,
        ngm:learning-rate-schedule,
        ngm:machine-learning,
        ngm:mixed-precision-training,
        ngm:optimization-algorithm,
        ngm:transfer-learning ;
    vc:requires ngm:loss-function,
        ngm:neural-network ;
    vc:slug "training-method" ;
    vc:sourceDomain "artificial-intelligence" .

