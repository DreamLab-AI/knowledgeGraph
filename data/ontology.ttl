ngm:hugging-face a owl:Class ;
    rdfs:label "Hugging Face"@en ;
    rdfs:comment "Hugging Face is an AI company and open-source platform that operates the Transformers, Diffusers, Datasets, PEFT, and TRL libraries alongside the Hugging Face Hub — a centralised model and dataset repository hosting hundreds of thousands of community-contributed checkpoints spanning natural language processing, computer vision, audio, multimodal, and reinforcement learning domains. The Hub standardises model cards, dataset cards, and Spaces (interactive Gradio or Streamlit demos), and has become the de facto distribution platform for open-weight large language models and their fine-tuned derivatives. Through its inference API, AutoTrain service, and parameter-efficient fine-tuning tooling, Hugging Face significantly lowers the barrier to deploying and adapting state-of-the-art machine learning models for research and production use."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:deep-learning ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:parameter-efficient-fine-tuning ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gpu-computing ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:hugging-face-hub ],
        ngm:ai-infrastructure ;
    vc:bridgesTo ngm:cloud-infrastructure,
        ngm:edge-ai ;
    vc:contrastsWith ngm:google-vertex-ai,
        ngm:openai-api ;
    vc:enables ngm:fine-tuning,
        ngm:model-sharing,
        ngm:natural-language-processing,
        ngm:open-source-ai ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:diffusers-library,
        ngm:hugging-face-hub,
        ngm:parameter-efficient-fine-tuning,
        ngm:transformers-library ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:bert,
        ngm:low-rank-adaptation,
        ngm:model-hub,
        ngm:responsible-ai ;
    vc:requires ngm:deep-learning,
        ngm:gpu-computing ;
    vc:slug "hugging-face" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:large-language-models,
        ngm:multimodal-ai,
        ngm:reinforcement-learning-from-human-feedback,
        ngm:transfer-learning ;
    vc:uses ngm:model-card,
        ngm:pytorch,
        ngm:transformer-architecture .

ngm:hugging-face-diffusers a owl:Class ;
    rdfs:label "Hugging Face Diffusers"@en ;
    rdfs:comment "Hugging Face Diffusers is an open-source Python library that provides a modular, composable toolkit for training, fine-tuning, and running inference with state-of-the-art diffusion models for image, audio, and video generation. The library abstracts the scheduling, noise prediction, and decoder stages of diffusion pipelines behind a consistent API, exposing interchangeable components — noise schedulers (DDPM, DDIM, DPM-Solver), denoising U-Net or Diffusion Transformer (DiT) backbones, and variational autoencoders — that researchers can recombine freely. It integrates natively with the Hugging Face Hub for model discovery, versioning, and model-card governance, and supports PyTorch and JAX as compute backends with optional xFormers memory-efficient attention and Accelerate-based distributed training."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:u-net ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:variational-autoencoder ],
        ngm:cat-ai-infrastructure ;
    skos:broader ngm:cat-ai-infrastructure ;
    vc:bridgesTo ngm:augmented-reality-content-creation,
        ngm:spatial-computing ;
    vc:contrastsWith ngm:generative-adversarial-network,
        ngm:variational-autoencoder ;
    vc:dependsOn ngm:hugging-face-hub,
        ngm:transformers-library ;
    vc:enables ngm:audio-generation,
        ngm:fine-tuning,
        ngm:image-generation,
        ngm:inpainting,
        ngm:text-to-image,
        ngm:video-generation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:noise-scheduler,
        ngm:u-net,
        ngm:variational-autoencoder ;
    vc:implements ngm:latent-diffusion-model,
        ngm:score-based-generative-model ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:clip,
        ngm:generative-ai,
        ngm:model-hub,
        ngm:stable-diffusion ;
    vc:slug "hugging-face-diffusers" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:controlnet,
        ngm:dreambooth,
        ngm:lora,
        ngm:textual-inversion ;
    vc:uses ngm:accelerate,
        ngm:diffusion-model,
        ngm:jax,
        ngm:pytorch,
        ngm:xformers .

ngm:human-centred-values a owl:Class ;
    rdfs:label "Human Centred Values"@en ;
    rdfs:comment "AI systems should be designed and operated in ways that respect the rule of law, human rights, democratic values and diversity, with appropriate safeguards to ensure human determination and control over consequential decisions (human agency), whilst incorporating mechanisms to protect fairness an..."@en ;
