    vc:slug "economic-model" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:ed-dsa a owl:Class ;
    rdfs:label "EdDSA"@en ;
    rdfs:comment "EdDSA (Edwards-curve Digital Signature Algorithm) is a high-performance digital signature scheme based on twisted Edwards elliptic curves, standardised in RFC 8032. It provides deterministic signing—eliminating the random number generation vulnerabilities that afflicted earlier schemes like ECDSA—whilst offering strong security with compact key and signature sizes. The most widely deployed instantiation is Ed25519, which operates over Curve25519 and produces 64-byte signatures with 128-bit security. EdDSA is extensively used in secure communications protocols, blockchain systems, verifiable credentials, and decentralised identity frameworks."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:private-key ],
        ngm:digital-signature ;
    vc:bridgesTo ngm:blockchain-transaction,
        ngm:decentralised-identifier,
        ngm:verifiable-credential ;
    vc:contrastsWith ngm:ecdsa,
        ngm:post-quantum-signature,
        ngm:rsa-signature ;
    vc:enables ngm:authentication,
        ngm:cryptographic-verification,
        ngm:decentralised-identity,
        ngm:digital-signature-verification ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:deterministic-signature,
        ngm:public-key-cryptography ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:ed25519,
        ngm:openssh,
        ngm:schnorr-signature,
        ngm:signature-scheme,
        ngm:tls,
        ngm:wireguard ;
    vc:requires ngm:private-key,
        ngm:public-key ;
    vc:slug "ed-dsa" ;
    vc:sourceDomain "security" ;
    vc:standardizedBy ngm:internet-engineering-task-force,
        ngm:rfc-8032 ;
    vc:uses ngm:cryptographic-hash-function,
        ngm:curve25519,
        ngm:elliptic-curve-cryptography,
        ngm:twisted-edwards-curve .

ngm:eddsa a skos:Concept ;
    rdfs:label "Eddsa"@en .

ngm:edge-cloud-collaboration a owl:Class ;
    rdfs:label "Edge-Cloud Collaboration"@en ;
    rdfs:comment "Edge-Cloud Collaboration is a hybrid architecture that dynamically partitions AI workloads between resource-constrained edge devices and powerful cloud infrastructure, optimising end-to-end latency, bandwidth utilisation, energy consumption, and inference accuracy through adaptive offloading, model splitting, early exit, and cascaded inference strategies. The architecture enables edge devices to handle time-sensitive inference locally while delegating computationally intensive or contextually uncertain tasks to the cloud, achieving the complementary strengths of both deployment tiers."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:federated-edge-learning ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:edge-computing ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:edge-ai-system ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:machine-learning-discipline-infrastructure ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:cloud-infrastructure ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:bandwidth-adaptation ],
        ngm:ai-infrastructure ;
    vc:contrastsWith ngm:edge-computing-node ;
    vc:enables ngm:digital-twin,
        ngm:io-t-ai-integration,
