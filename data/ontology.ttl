        ngm:haptic-feedback .

ngm:adaptive-music a owl:Class ;
    rdfs:label "Adaptive Music"@en ;
    rdfs:comment "Adaptive music is a compositional and audio-engineering approach in which a musical soundtrack modifies its structure, instrumentation, tempo, or emotional register dynamically in response to real-time contextual signals such as player actions, narrative state, or environmental parameters within interactive media. It replaces the static looping of pre-composed tracks with a system that maintains musical coherence while reflecting the moment-to-moment state of an interactive experience. The technique is foundational to game audio design and is increasingly applied in extended reality, therapeutic, and generative AI contexts."@en ;
    rdfs:subClassOf ngm:audio-system ;
    vc:enables ngm:emergent-gameplay,
        ngm:immersive-audio ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:audio-processing,
        ngm:game-ai ;
    vc:slug "adaptive-music" ;
    vc:sourceDomain "metaverse" ;
    vc:uses ngm:audio-engine,
        ngm:game-engine .

