ngm:should a owl:Class ;
    rdfs:label "SHOULD"@en ;
    rdfs:comment "SHOULD is an RFC 2119 normative keyword indicating that a particular behaviour or implementation choice is strongly recommended but not absolutely required. In specification and standards documents, SHOULD implies that valid reasons may exist in particular circumstances to deviate from the stated guidance, but the implementer must understand the implications and weigh the trade-offs carefully before choosing a different course. It contrasts with MUST (mandatory) and MAY (optional)."@en ;
    rdfs:subClassOf ngm:infra-software-engineering ;
    skos:broader ngm:infra-software-engineering ;
    vc:contrastsWith ngm:standards-conformance-testing ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:relatedTo ngm:interoperability-standard,
        ngm:standards-conformance ;
    vc:slug "should" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:compliance-standards .

ngm:siggraph-pipeline-wg a owl:Class ;
    rdfs:label "SIGGRAPH Pipeline WG"@en ;
    rdfs:comment "The SIGGRAPH Pipeline Working Group is an industry effort associated with the SIGGRAPH community that addresses interoperability and best practice across the stages of 3D content production pipelines."@en ;
