ngm:inertia a owl:Class ;
    rdfs:label "Inertia"@en ;
    rdfs:comment "The physical property of a body that resists changes in its state of motion, whether translational or rotational. In robotics and actuation systems, inertia determines how much force or torque is required to accelerate or decelerate a component, and must be modelled accurately for stable, precise control."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
