ngm:container-registry a owl:Class ;
    rdfs:comment "A content-addressed storage and distribution service for container images that implements the OCI Distribution Specification's push, pull, and discovery API. Registries hold image layers and manifests under named, tagged repositories, enforce authentication and access control, and increasingly store signatures, SBOMs, and other supply-chain artefacts alongside images, making them the central hand-off point between build pipelines and every runtime that deploys containerised software."@en ;
    rdfs:label "Container Registry"@en ;
    rdfs:subClassOf ngm:containerisation ;
