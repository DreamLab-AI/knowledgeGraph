    vc:requires ngm:governance-process,
        ngm:metadata-standards,
        ngm:taxonomy-development ;
    vc:slug "controlled-vocabularies" ;
    vc:sourceDomain "spatial-computing" .

ngm:controlled-vocabulary a owl:Class ;
    rdfs:label "Controlled Vocabulary"@en ;
    rdfs:comment "A restricted list of standardized terms or phrases used within a specific domain for consistent cataloging, tagging, and indexing, where users may only apply terms from the approved list to ensure uniform description and enable reliable information retrieval across systems and platforms."@en ;
