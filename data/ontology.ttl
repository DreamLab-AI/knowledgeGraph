        ngm:machine-learning .

ngm:inference-runtime a owl:Class ;
    rdfs:label "Inference Runtime"@en ;
    rdfs:comment "An inference runtime is the software layer that loads a trained machine-learning model and executes its forward pass to produce predictions on new inputs. It schedules computation across CPUs, GPUs or accelerators, applies graph optimisations such as operator fusion and quantisation, and manages memory, batching and concurrency for low-latency serving. Inference runtimes are the execution engine beneath model-serving infrastructure."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gpu ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:model-deployment ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:model-serving ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:onnx ],
        ngm:artificial-intelligence ;
    skos:broader ngm:artificial-intelligence ;
    vc:contrastsWith ngm:model-training ;
    vc:dependsOn ngm:neural-network ;
    vc:enables ngm:edge-computing,
        ngm:inference ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:model-serving,
        ngm:onnx ;
    vc:implements ngm:inference ;
    vc:isPartOf ngm:ai-system ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:deep-learning,
        ngm:edge-computing ;
    vc:requires ngm:gpu,
