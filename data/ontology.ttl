ngm:localization a owl:Class ;
    rdfs:label "Localization"@en ;
    rdfs:comment "The process of determining a mobile robot's position and orientation (pose) within a known or unknown environment using sensor measurements and a map or environmental model. It answers the question \"Where am I?\" and is foundational to all autonomous navigation and planning tasks."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:sensor-system ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:position-control ],
        ngm:state-estimation ;
    vc:bridgesTo ngm:spatial-computing ;
    vc:contrastsWith ngm:mapping ;
    vc:dependsOn ngm:probabilistic-robotics,
        ngm:sensor-fusion ;
    vc:enables ngm:autonomous-navigation,
        ngm:navigation,
        ngm:path-planning ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:position-control ;
    vc:isPartOf ngm:slam ;
    vc:qualityScore "0.7"^^xsd:float ;
    vc:relatedTo ngm:robot-pose,
        ngm:uncertainty ;
    vc:requires ngm:sensor-system ;
    vc:slug "localization" ;
    vc:sourceDomain "robotics" ;
    vc:supports ngm:autonomous-vehicle,
        ngm:mobile-robotics ;
    vc:uses ngm:bayes-filter,
        ngm:kalman-filter,
