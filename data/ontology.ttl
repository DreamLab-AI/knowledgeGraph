ngm:variational-inference a owl:Class ;
    rdfs:label "Variational Inference"@en ;
    rdfs:comment "Variational inference is a Bayesian machine learning method that approximates complex, intractable posterior distributions using a simpler parameterised family by optimising the evidence lower bound (ELBO) via gradient-based methods. Rather than sampling from the posterior as in Markov chain Monte Carlo approaches, variational inference reframes posterior estimation as an optimisation problem, making it tractable for large-scale models. It is the foundational inference mechanism underlying Variational Autoencoders and is widely applied in probabilistic topic modelling, latent variable models, and Bayesian deep learning."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:bayesian-inference ],
        ngm:ai-technique ;
