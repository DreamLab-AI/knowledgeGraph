    vc:slug "environmental-accounting" ;
    vc:sourceDomain "spatial-computing" ;
    vc:supports ngm:circular-economy ;
    vc:uses ngm:environmental-impact-metric .

ngm:etl-pipeline a owl:Class ;
    rdfs:label "ETL Pipeline"@en ;
    rdfs:comment "An Extract-Transform-Load pipeline that automates the movement of data from heterogeneous source systems, applies normalisation and enrichment transformations, and loads the results into target data stores such as data warehouses or feature stores. ETL pipelines are foundational to data engineering and AI/ML workflows."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:data-pipeline ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:feature-engineering ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:data-integration ],
        ngm:ai-infrastructure ;
    vc:enables ngm:machine-learning,
        ngm:predictive-analytics ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:data-integration,
        ngm:data-pipeline,
        ngm:feature-engineering ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:data-lake,
        ngm:data-versioning,
        ngm:database-system,
        ngm:feature-store,
        ngm:machine-learning-pipeline ;
    vc:slug "etl-pipeline" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:fca a owl:Class ;
    rdfs:label "FCA"@en ;
    rdfs:comment "The Financial Conduct Authority (FCA) is the statutory regulator of financial services and markets in the United Kingdom, operating independently of government under the Financial Services and Markets Act 2000. It supervises conduct in retail and wholesale markets, authorises financial firms, and enforces anti-money-laundering obligations. In the blockchain and digital asset domain, the FCA registers crypto-asset businesses under the Money Laundering Regulations, oversees financial promotions for crypto assets, and implements policy derived from international standards bodies such as the Financial Action Task Force."@en ;
    rdfs:subClassOf ngm:bc-governance-and-regulation ;
    skos:broader ngm:bc-governance-and-regulation ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:compliance-framework,
        ngm:fatf,
        ngm:financial-regulation ;
    vc:slug "fca" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:anti-money-laundering,
        ngm:financial-stability .

ngm:feature-matching a owl:Class ;
    rdfs:label "Feature Matching"@en ;
    rdfs:comment "Feature Matching is a computer vision technique that identifies and associates corresponding salient regions—keypoints and their descriptors—across two or more images or point clouds, enabling geometric relationships such as homographies, fundamental matrices, or rigid-body transformations to be estimated. Classical detectors such as SIFT, SURF, and ORB extract rotation- and scale-invariant descriptors; modern deep learning approaches learn matched embeddings end-to-end from training data. Feature matching is a foundational step in Structure-from-Motion, visual odometry, SLAM, and image-based localisation pipelines. The accuracy and efficiency of matching directly determine downstream reconstruction quality and real-time performance in robotics and augmented reality applications."@en ;
    rdfs:subClassOf ngm:computer-vision ;
    vc:enables ngm:photogrammetry,
        ngm:slam,
        ngm:structure-from-motion,
        ngm:visual-odometry ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:computer-vision-system,
        ngm:depth-sensing,
        ngm:lidar,
        ngm:point-cloud ;
    vc:slug "feature-matching" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:deep-learning,
        ngm:depth-estimation,
        ngm:stereo-camera .

ngm:federated-identity a owl:Class ;
    rdfs:label "Federated Identity"@en ;
    rdfs:comment "Federated Identity is an architectural paradigm that allows users to authenticate once with a trusted identity provider and have that authentication assertion accepted by multiple independent relying parties—services and applications—without requiring separate accounts or repeated credential entry. The federation relationship is governed by bilateral or multilateral trust agreements and implemented through standard protocols such as SAML 2.0, OpenID Connect, and OAuth 2.0, which define how authentication tokens are issued, signed, and verified across organisational boundaries. Federated identity is foundational to enterprise single sign-on, cross-institutional academic collaboration, and consumer social login ecosystems."@en ;
    rdfs:subClassOf ngm:identity-management ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:decentralized-identity,
        ngm:identity-federation,
        ngm:identity-provider,
        ngm:single-sign-on ;
    vc:slug "federated-identity" ;
    vc:sourceDomain "security" ;
    vc:supports ngm:access-control,
        ngm:multi-factor-authentication,
        ngm:trust-framework ;
    vc:uses ngm:authentication-standards,
        ngm:oauth-2-0,
        ngm:open-id-connect .

ngm:file-system a owl:Class ;
    rdfs:label "File System"@en ;
    rdfs:comment "A file system is the data structure and associated management software that an operating system uses to organise, store, retrieve, and manage data on storage media. It defines how data is logically partitioned into named files and directories, governs access permissions, maintains metadata such as timestamps and ownership, and translates logical file operations into physical block I/O against underlying storage hardware. File systems range from local single-disk formats (NTFS, ext4, APFS) to distributed and network-attached systems (NFS, HDFS, GFS) that span many physical storage nodes."@en ;
    rdfs:subClassOf ngm:operating-system ;
    vc:enables ngm:content-addressed-storage,
        ngm:data-storage-layer ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:cloud-storage,
        ngm:data-storage,
        ngm:distributed-storage,
        ngm:ipfs,
        ngm:storage-systems ;
    vc:slug "file-system" ;
    vc:sourceDomain "infrastructure" ;
    vc:uses ngm:storage-hardware,
        ngm:virtual-machine .

ngm:flash-attention a owl:Class ;
    rdfs:label "Flash Attention"@en ;
    rdfs:comment "Flash Attention is an IO-aware, exact attention algorithm that exploits GPU memory hierarchy by tiling the query, key, and value matrices to keep intermediate activations in fast on-chip SRAM rather than the much slower high-bandwidth DRAM (HBM), eliminating the O(N²) memory materialisation of the standard scaled dot-product attention. Introduced by Dao et al. at Stanford in 2022 and extended in Flash Attention 2 and 3, it achieves the same numerical output as standard attention whilst reducing HBM reads and writes by a factor proportional to the SRAM tile size, yielding 2–4× wall-clock speedups for long sequences with sub-linear memory growth. It is now a standard component of transformer training and inference frameworks including PyTorch, JAX, and vLLM."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:attention-mechanism ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gpu-compute ],
        ngm:ai-infrastructure ;
    vc:enables ngm:inference,
        ngm:large-language-models ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:model-training,
        ngm:transformer-architecture ;
    vc:requires ngm:attention-mechanism,
        ngm:gpu-compute ;
    vc:slug "flash-attention" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:frontier-models a owl:Class ;
    rdfs:label "Frontier Models"@en ;
    rdfs:comment "Frontier models are large-scale AI systems trained at the leading edge of compute, data, and capability, exhibiting emergent behaviours not observed in smaller models and presenting both transformative societal potential and novel safety risks. The term typically refers to the most capable foundation models available at any given time, assessed across benchmarks spanning reasoning, coding, science, and multimodal tasks."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gpu-cluster ],
        ngm:foundation-models,
        ngm:large-language-models ;
    vc:enables ngm:multimodal-ai,
        ngm:reasoning-models ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:emergent-capabilities,
        ngm:scaling-laws ;
    vc:requires ngm:gpu-cluster ;
    vc:slug "frontier-models" ;
    vc:sourceDomain "ai" ;
    vc:supports ngm:frontier-model-evaluation .

ngm:gauge-voting a owl:Class ;
    rdfs:label "Gauge Voting"@en ;
    rdfs:comment "Gauge voting is a mechanism in protocols such as Curve where token holders allocate weights to liquidity pools, determining how reward emissions are distributed. Voting power is usually tied to time-locked governance tokens."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:curve-finance ],
        ngm:governance-token ;
    vc:enables ngm:hidden-hand,
        ngm:votium ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:curve-finance ;
    vc:slug "gauge-voting" ;
    vc:sourceDomain "defi" .

ngm:gemini a owl:Class ;
    rdfs:label "Gemini"@en ;
    rdfs:comment "Gemini is Google DeepMind's family of natively multimodal large language models, announced in December 2023 as the successor to PaLM 2, designed from the ground up to reason across text, images, audio, video, and code within a single unified architecture. The Gemini family spans Ultra, Pro, Flash, and Nano capability tiers, enabling deployment from data-centre scale to on-device inference. It directly competes with OpenAI's GPT-4 family and Anthropic Claude as one of the three dominant frontier model lineages."@en ;
    rdfs:subClassOf ngm:multimodal-ai ;
    vc:contrastsWith ngm:anthropic-claude,
        ngm:chat-gpt ;
    vc:dependsOn ngm:cloud-platform,
        ngm:high-performance-computing ;
    vc:enables ngm:agentic-workflow,
        ngm:generative-ai,
        ngm:multimodal-ai ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:anthropic-claude,
        ngm:chat-gpt,
        ngm:large-language-models ;
    vc:slug "gemini" ;
    vc:sourceDomain "ai" ;
    vc:standardizedBy ngm:evaluation-metric ;
    vc:uses ngm:fine-tuning,
        ngm:multimodal-understanding,
        ngm:transformer .

ngm:global-illumination a owl:Class ;
    rdfs:label "Global Illumination"@en ;
    rdfs:comment "Global Illumination (GI) is a rendering approach that simulates all light interactions within a scene, including both direct illumination from light sources and indirect illumination from light bouncing between surfaces. Techniques range from offline radiosity and photon mapping to real-time approximations such as voxel cone tracing, screen-space ambient occlusion, and hardware-accelerated ray tracing, producing physically plausible colour bleeding, soft shadows, and caustics."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ray-tracing ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:rendering-pipeline ],
        ngm:metaverse,
        ngm:sc-display-and-rendering ;
    skos:broader ngm:sc-display-and-rendering ;
    vc:contrastsWith ngm:rasterization ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.5"^^xsd:float ;
    vc:requires ngm:ray-tracing,
        ngm:rendering-pipeline ;
    vc:slug "global-illumination" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:compute-shader,
        ngm:physically-based-rendering .

ngm:gpu-cluster a owl:Class ;
    rdfs:label "GPU Cluster"@en ;
    rdfs:comment "A GPU cluster is a group of interconnected computers each equipped with graphics processing units, used together for parallel computation. Such clusters are central to training large AI models and high-performance computing."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:nvidia-h-100 ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gpu ],
        ngm:gpu-computing ;
    vc:enables ngm:deep-learning ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:gpu,
        ngm:nvidia-h-100 ;
    vc:slug "gpu-cluster" ;
    vc:sourceDomain "computing" .

ngm:graph-theory a owl:Class ;
    rdfs:label "Graph Theory"@en ;
    rdfs:comment "Graph Theory is the branch of mathematics that studies graphs, structures consisting of vertices connected by edges, used to model pairwise relationships between objects. It examines properties such as connectivity, paths, cycles, colourings, matchings and flows, and classifies graphs by structure (for example trees, bipartite and planar graphs). Originating with Euler's 1736 solution of the Seven Bridges of Konigsberg problem, it now underpins network analysis, optimisation and computer science. Graph algorithms are fundamental to routing, scheduling, social network analysis and the representation of knowledge."@en ;
    rdfs:subClassOf ngm:owl-thing ;
    vc:enables ngm:knowledge-graph,
        ngm:network-analysis ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:graph-colouring,
        ngm:shortest-path,
        ngm:tree ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:slug "graph-theory" ;
    vc:sourceDomain "graph-theory" .

ngm:graphics-pipeline a owl:Class ;
    rdfs:label "Graphics Pipeline"@en ;
    rdfs:comment "The graphics pipeline is the ordered sequence of stages that transforms 3D scene description into a 2D image, covering vertex processing, primitive assembly, rasterisation and fragment shading."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:gpu-architecture ],
        ngm:computer-graphics ;
    vc:enables ngm:real-time-rendering ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:gpu-architecture ;
    vc:slug "graphics-pipeline" ;
    vc:sourceDomain "metaverse" .

ngm:green-finance a owl:Class ;
    rdfs:label "Green Finance"@en ;
    rdfs:comment "Green finance is the set of financial instruments, investment strategies, market mechanisms, and regulatory frameworks that channel capital towards environmentally sustainable projects and activities, with the explicit goal of mitigating climate change, protecting biodiversity, and supporting the transition to a low-carbon economy. It encompasses green bonds, sustainability-linked loans, green funds, carbon markets, and blended finance structures, underpinned by taxonomies such as the EU Taxonomy for Sustainable Activities that define what qualifies as environmentally sustainable. Blockchain technology is being applied in green finance to provide transparent, immutable registries for carbon credits and ESG data, reducing double-counting and greenwashing risks."@en ;
    rdfs:subClassOf ngm:bc-governance-and-regulation ;
    skos:broader ngm:bc-governance-and-regulation ;
    vc:enables ngm:carbon-credit-tracking,
        ngm:environmental-sustainability ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:esg-investing,
        ngm:financial-instruments ;
    vc:slug "green-finance" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:carbon-credits,
        ngm:esg-reporting .

ngm:hardware-layer a owl:Class ;
    rdfs:label "Hardware Layer"@en ;
    rdfs:comment "The Hardware Layer is the lowest stratum of the canonical stack, comprising the physical computing, storage, and signalling devices on which everything above runs. Nothing sits below it; immediately above it is the Network Layer, which connects discrete machines. It contains processors, memory, storage media, accelerators, and the physical transmission media that carry signals."@en ;
    rdfs:subClassOf ngm:owl-thing ;
    vc:enables ngm:compute-layer,
        ngm:network-layer ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:slug "hardware-layer" ;
    vc:sourceDomain "hardware" .

ngm:hazard-analysis a owl:Class ;
    rdfs:label "Hazard Analysis"@en ;
    rdfs:comment "Hazard analysis is the systematic identification, characterisation, and prioritisation of conditions or events with the potential to cause harm to people, systems, or environments, forming the foundational step in safety engineering processes that design controls to prevent or mitigate those harms. Methods range from qualitative techniques such as HAZOP and FMEA to quantitative probabilistic risk assessment, applied across aviation, automotive, nuclear, medical devices, and increasingly AI systems."@en ;
    rdfs:subClassOf ngm:risk-assessment ;
    vc:enables ngm:compliance,
        ngm:fault-tolerance ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:compliance-framework,
        ngm:technical-standards ;
    vc:slug "hazard-analysis" ;
    vc:sourceDomain "governance" ;
    vc:supports ngm:fault-tolerance-system ;
    vc:uses ngm:fault-tree-analysis,
        ngm:risk-assessment-methodology .

ngm:head-mounted-display a owl:Class ;
    rdfs:label "Head-Mounted Display"@en ;
    rdfs:comment "A head-mounted display (HMD) is a wearable visual output device worn on the head that positions one or more display panels or optical projectors in front of the user's eyes, delivering immersive visual content for virtual reality, augmented reality, or mixed reality experiences. HMDs incorporate optics to focus near-focal-plane displays at a comfortable viewing distance, tracking systems to measure head orientation and position, and increasingly passthrough cameras for environment sensing. The design space spans sealed VR devices that occlude the real world, optical see-through AR waveguide systems, and video passthrough mixed reality headsets."@en ;
    rdfs:subClassOf ngm:display-hardware ;
    vc:enables ngm:augmented-reality,
        ngm:mixed-reality,
        ngm:virtual-reality ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:display-technology,
        ngm:extended-reality-xr,
        ngm:xr-headset ;
    vc:slug "head-mounted-display" ;
    vc:sourceDomain "hardware" ;
    vc:uses ngm:eye-tracking,
        ngm:foveated-rendering,
        ngm:haptic-feedback .

ngm:healthcare-technology a owl:Class ;
    rdfs:label "Healthcare Technology"@en ;
    rdfs:comment "Healthcare Technology encompasses the digital tools, software systems, and AI-driven applications deployed in clinical and health management contexts, including medical imaging, electronic health records, clinical decision support, and telemedicine platforms. It bridges spatial computing, data analytics, and AI to improve diagnostic accuracy, treatment outcomes, and health system efficiency."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:medical-imaging ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:clinical-decision-support ],
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:enables ngm:healthcare-analytics ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:clinical-decision-support,
        ngm:medical-imaging ;
    vc:qualityScore "0.35"^^xsd:float ;
