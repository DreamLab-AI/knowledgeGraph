    vc:sourceDomain "infrastructure" .

ngm:inverted-index a owl:Class ;
    rdfs:label "Inverted Index"@en ;
    rdfs:comment "An inverted index is a data structure that maps each term to the list of documents (and often positions) in which it appears, enabling fast full-text retrieval over large corpora. It inverts the natural document-to-terms relationship so that a query term immediately yields its posting list, which can then be intersected or scored. It is the foundational index behind search engines and lexical information retrieval."@en ;
    rdfs:subClassOf ngm:information-retrieval ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:information-retrieval,
        ngm:semantic-search ;
    vc:slug "inverted-index" ;
    vc:sourceDomain "data" .

ngm:iso-20022 a owl:Class ;
    rdfs:label "ISO 20022"@en ;
    rdfs:comment "ISO 20022 is the international standard for financial services messaging, providing a universal methodology that decouples business concepts from syntax through a central repository of business components, message definitions, and multi-syntax encoding rules covering XML, ASN.1, and JSON. Published by the International Organisation for Standardisation and maintained by ISO Technical Committee 68, the standard spans payments (credit transfers, direct debits), securities settlement and clearing, trade finance, and foreign exchange, replacing legacy formats such as SWIFT MT and CHIPS. Its rich, structured data model carries full remittance information, Legal Entity Identifiers, purpose codes, and beneficiary details that legacy formats cannot accommodate, enabling straight-through processing, automated reconciliation, and enhanced regulatory reporting. Major financial market infrastructures worldwide — including TARGET2, CHAPS, Fedwire, and the SWIFT network — have migrated or are actively migrating to ISO 20022, making it the convergence standard for the global payments landscape."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:data-mapping ],
        ngm:interoperability-standard ;
    vc:bridgesTo ngm:api-economy,
        ngm:distributed-ledger-technology,
        ngm:open-banking ;
    vc:contrastsWith ngm:swift-messaging ;
    vc:enables ngm:central-bank-digital-currency,
        ngm:cross-border-payments,
        ngm:regulatory-reporting ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:business-process-management,
        ngm:data-model ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:data-standards,
        ngm:financial-system,
        ngm:legal-entity-identifier,
        ngm:payment-system,
        ngm:xml ;
    vc:requires ngm:data-mapping ;
    vc:slug "iso-20022" ;
    vc:sourceDomain "finance" ;
    vc:standardizedBy ngm:iso,
        ngm:swift ;
    vc:supports ngm:digital-payment-system,
        ngm:financial-infrastructure,
        ngm:instant-settlement,
        ngm:securities-settlement .

ngm:jacobian-matrix a owl:Class ;
    rdfs:label "Jacobian Matrix"@en ;
    rdfs:comment "The Jacobian matrix is the matrix of all first-order partial derivatives of a vector-valued function, representing the best linear approximation to that function near a point and encoding how each output component changes with respect to each input variable. In robotics, the geometric and analytic Jacobian matrices map from joint velocity space to end-effector Cartesian velocity space, providing the fundamental tool for differential kinematics, inverse kinematics resolution, singularity analysis, and force-torque transmission between joint and task space. The Jacobian's rank and condition number determine the manipulability of a robot configuration and identify singular configurations where the end-effector loses degrees of freedom in certain directions."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:denavit-hartenberg-parameters ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:jacobian-determinant ],
        ngm:differential-kinematics ;
    vc:bridgesTo ngm:backpropagation,
        ngm:coordinate-transformation ;
    vc:enables ngm:force-torque-control,
        ngm:inverse-kinematics,
        ngm:motion-planning,
        ngm:robot-control,
        ngm:singularity-analysis,
        ngm:task-space-control ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:jacobian-determinant ;
    vc:isPartOf ngm:robot-dynamics ;
    vc:qualityScore "0.75"^^xsd:float ;
    vc:relatedTo ngm:rb-0032-manipulability,
        ngm:redundancy-resolution,
        ngm:robot-manipulation,
        ngm:trajectory-control ;
    vc:requires ngm:denavit-hartenberg-parameters ;
    vc:slug "jacobian-matrix" ;
    vc:sourceDomain "robotics" ;
    vc:uses ngm:forward-kinematics,
        ngm:kinematics,
        ngm:linear-algebra .

ngm:monitoring-dashboard a owl:Class ;
    rdfs:label "Monitoring Dashboard"@en ;
    rdfs:comment "Visual interfaces that aggregate and display real-time metrics, logs, and traces from systems and applications, enabling observability, performance tracking, incident detection, and data-driven decision making through unified visualisation platforms."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
