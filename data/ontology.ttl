ngm:message-signing a owl:Class ;
    rdfs:label "Message Signing"@en ;
    rdfs:comment "Message signing is a cryptographic operation whereby a private key is used to generate a digital signature over a message or data payload, enabling any holder of the corresponding public key to verify the authenticity and integrity of the message. It provides non-repudiation guarantees, ensuring that the signer cannot plausibly deny having produced the signature. Message signing is foundational to authentication protocols, blockchain transactions, and secure communication systems."@en ;
    rdfs:subClassOf ngm:cryptographic-protocol ;
    vc:enables ngm:authentication,
        ngm:cryptographic-verification ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:cryptographic-hash-function,
        ngm:public-key-infrastructure,
        ngm:secp256k1 ;
    vc:slug "message-signing" ;
    vc:sourceDomain "security" ;
    vc:uses ngm:digital-signature,
        ngm:ecdsa,
        ngm:private-key,
        ngm:public-key-cryptography .

ngm:meta-governance a owl:Class ;
    rdfs:label "Meta Governance"@en ;
    rdfs:comment "Meta governance is the practice of governing the governance process itself, encompassing the rules, parameters, and mechanisms that determine how decisions are made, how voting power is allocated, and how the decision-making system can be amended. In decentralised protocols it often refers to one entity wielding governance rights over another, such as a protocol holding voting tokens of the protocols it integrates. Meta governance addresses the meta-level design of decision rights, escalation paths, and the evolution of governance structures over time."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:voting-system ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:on-chain-governance ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:governance-token ],
        ngm:decentralized-governance ;
    vc:bridgesTo ngm:blockchain ;
    vc:contrastsWith ngm:polycentric-governance ;
    vc:enables ngm:dao-governance,
        ngm:polycentric-governance ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:governance-token,
        ngm:voting-system ;
    vc:implements ngm:decentralized-governance ;
    vc:isPartOf ngm:decentralized-governance,
        ngm:on-chain-governance ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:dao,
        ngm:polycentric-governance ;
    vc:requires ngm:on-chain-governance ;
