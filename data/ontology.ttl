        ngm:coinbase-transaction,
        ngm:merkle-root,
        ngm:nonce,
        ngm:timestamp ;
    vc:isPartOf ngm:blockchain,
        ngm:blockchain-ledger ;
    vc:qualityScore "0.72"^^xsd:float ;
