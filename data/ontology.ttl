        ngm:transformer-architecture ;
    vc:slug "segmentation-and-identification" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:standardizedBy ngm:coco-dataset,
        ngm:medical-segmentation-decathlon,
        ngm:model-evaluation ;
    vc:supports ngm:ade20-k,
        ngm:benchmark-evaluation,
        ngm:coco-dataset,
        ngm:medical-segmentation-decathlon ;
    vc:uses ngm:cross-entropy-loss,
        ngm:loss-function,
        ngm:mean-average-precision,
        ngm:panoptic-quality-metric .

ngm:segregation-of-duties a owl:Class ;
    rdfs:label "Segregation of Duties"@en ;
    rdfs:comment "Segregation of duties is an internal control principle that divides critical tasks among multiple people so that no single individual can both execute and conceal an error or fraud. It separates responsibilities such as authorisation, custody, recording, and reconciliation. It is a core requirement of financial, security, and compliance control frameworks."@en ;
    rdfs:subClassOf ngm:regulatory-compliance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:compliance-control ;
    vc:slug "segregation-of-duties" ;
    vc:sourceDomain "governance" .

ngm:self-driving-car a owl:Class ;
    rdfs:label "Self Driving Car"@en ;
    rdfs:comment "A self-driving car is an autonomous passenger vehicle capable of sensing its environment and operating with minimal or no human input, employing AI-driven perception, decision-making, and control systems to navigate roads, comply with traffic regulations, and transport occupants safely. Self-driving cars represent the consumer application of autonomous vehicle technology, typically targeting SAE Level 3–5 automation in urban and highway environments."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:perception-system ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:sensor-fusion ],
        ngm:sc-platform-and-environment ;
    skos:broader ngm:sc-platform-and-environment ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:autonomous-vehicle ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:adas ;
    vc:requires ngm:perception-system,
        ngm:sensor-fusion ;
    vc:slug "self-driving-car" ;
    vc:sourceDomain "spatial-computing" ;
    vc:uses ngm:computer-vision,
        ngm:lidar,
        ngm:motion-planning .

ngm:semantic-html a owl:Class ;
    rdfs:label "Semantic HTML"@en ;
    rdfs:comment "Semantic HTML is the practice of using HTML elements according to their intended meaning rather than for presentation alone. Elements such as header, nav, main, article, and button convey document structure and role to browsers and assistive technologies. It is a foundational requirement for accessible, machine-interpretable web content."@en ;
    rdfs:subClassOf ngm:technical-standard ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:accessibility ;
    vc:slug "semantic-html" ;
    vc:sourceDomain "infrastructure" .

ngm:semantic-versioning a skos:Concept ;
    rdfs:label "Semantic Versioning"@en .

ngm:semiconductor-manufacturing a owl:Class ;
    rdfs:label "Semiconductor Manufacturing"@en ;
    rdfs:comment "Semiconductor manufacturing is the multi-stage industrial process that fabricates integrated circuits on silicon wafers through cycles of deposition, photolithographic patterning, etching, doping, and metallisation in cleanroom fabs. It transforms electronic designs into physical chips at nanometre feature sizes and is the foundation of all modern computing hardware. The capital-intensive supply chain spans wafer production, fabrication, packaging, and test."@en ;
    rdfs:subClassOf ngm:infrastructure ;
    skos:broader ngm:infrastructure ;
    vc:bridgesTo ngm:computer-architecture ;
    vc:dependsOn ngm:supply-chain ;
    vc:enables ngm:cpu-computing,
        ngm:hardware-acceleration ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:integrated-circuit,
        ngm:wafer-fabrication ;
    vc:isPartOf ngm:supply-chain ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:hardware ;
    vc:requires ngm:nanotechnology,
        ngm:semiconductor ;
    vc:slug "semiconductor-manufacturing" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:gpu-computing ;
    vc:uses ngm:chip,
        ngm:foundry .

ngm:sequence-labelling a owl:Class ;
    rdfs:label "Sequence Labelling"@en ;
    rdfs:comment "Sequence labelling is a class of natural-language-processing tasks in which each element of an input sequence is assigned a categorical label from a fixed tag set. It encompasses tasks such as named-entity recognition, part-of-speech tagging and slot filling, where contextual dependencies between adjacent tokens matter. Classical approaches use hidden Markov models and conditional random fields, while modern systems use neural encoders."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:supervised-learning ],
        ngm:natural-language-processing ;
    vc:contrastsWith ngm:text-classification ;
    vc:enables ngm:information-extraction,
        ngm:named-entity-recognition,
        ngm:slot-filling ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:natural-language-processing ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:part-of-speech-tagging,
        ngm:semantic-role-labelling ;
    vc:requires ngm:labelled-data,
        ngm:supervised-learning ;
    vc:slug "sequence-labelling" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:natural-language-understanding ;
    vc:uses ngm:conditional-random-field,
        ngm:hidden-markov-model,
        ngm:recurrent-neural-network .

ngm:sequence-to-sequence-model a owl:Class ;
    rdfs:label "Sequence To Sequence Model"@en ;
    rdfs:comment "A sequence-to-sequence model is a neural architecture that maps an input sequence of arbitrary length to an output sequence of arbitrary length, classically using an encoder to compress the input into a context representation and a decoder to generate the output one element at a time. Originally built from recurrent networks such as LSTMs and GRUs and later augmented with attention to overcome the fixed-context bottleneck, the paradigm became the foundation for the transformer. Sequence-to-sequence models power machine translation, text summarisation, speech recognition, and other tasks where input and output structures differ."@en ;
    rdfs:subClassOf ngm:neural-network ;
    vc:contrastsWith ngm:transformer ;
    vc:enables ngm:machine-translation,
        ngm:speech-recognition,
        ngm:text-summarisation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:encoder-decoder,
        ngm:recurrent-neural-network ;
    vc:isPartOf ngm:deep-learning ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:language-model,
        ngm:sequence-model ;
    vc:slug "sequence-to-sequence-model" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:supports ngm:natural-language-processing ;
    vc:uses ngm:attention-mechanism,
        ngm:beam-search,
        ngm:gru,
        ngm:lstm .

ngm:service-registry a owl:Class ;
    rdfs:label "Service Registry"@en ;
    rdfs:comment "A Service Registry is a database of available service instances and their network locations that underpins dynamic service discovery in distributed and microservice architectures. Instances register on startup and deregister on shutdown, while clients or load balancers query the registry to resolve a logical service name to a healthy endpoint. Health checks expire stale entries, keeping the registry an accurate view of live topology in elastic, frequently changing deployments."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:service-discovery ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:api-gateway ],
        ngm:service-discovery ;
    vc:bridgesTo ngm:kubernetes ;
    vc:dependsOn ngm:high-availability ;
    vc:enables ngm:load-balancing,
        ngm:service-discovery ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:api-gateway ;
    vc:isPartOf ngm:distributed-systems ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:api-gateway,
        ngm:load-balancing,
        ngm:orchestration ;
    vc:requires ngm:service-discovery ;
    vc:slug "service-registry" ;
    vc:sourceDomain "distributed-systems" ;
    vc:supports ngm:microservices ;
    vc:uses ngm:network-protocol .

ngm:setpoint a owl:Class ;
    rdfs:label "Setpoint"@en ;
    rdfs:comment "A setpoint is the desired target value that a control system attempts to maintain for a measured process variable, serving as the reference against which the controller compares the actual measurement. The difference between setpoint and measured value is the error signal that drives corrective action in a feedback loop. Setpoints can be fixed, scheduled, or continuously varying, as when a controller tracks a moving reference trajectory."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:control-theory ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:feedback-loop ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:sensor ],
        ngm:closed-loop-control ;
    vc:bridgesTo ngm:industrial-automation ;
    vc:contrastsWith ngm:disturbance-rejection ;
    vc:dependsOn ngm:control-loop ;
    vc:enables ngm:disturbance-rejection,
        ngm:stability ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:control-theory ;
    vc:implements ngm:control-theory ;
    vc:isPartOf ngm:closed-loop-control,
        ngm:feedback-loop ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:actuator,
        ngm:pid-control,
        ngm:trajectory ;
    vc:requires ngm:feedback-loop,
        ngm:sensor ;
    vc:slug "setpoint" ;
    vc:sourceDomain "robotics" ;
    vc:supports ngm:pid-controller,
        ngm:process-control ;
    vc:uses ngm:sensor .

ngm:sha-256-hashing a owl:Class ;
    rdfs:label "SHA-256 Hashing"@en ;
    rdfs:comment "SHA-256 Hashing refers to the application of the SHA-256 (Secure Hash Algorithm 256-bit) cryptographic hash function — a member of the SHA-2 family standardised by NIST in 2001 — to produce a fixed-length 256-bit (32-byte) message digest from an arbitrary-length input, with the properties of determinism, pre-image resistance, second pre-image resistance, and collision resistance. The algorithm operates via 64 rounds of bit manipulation, modular addition, and nonlinear functions over a 512-bit block schedule. SHA-256 is the foundational hash function of Bitcoin's proof-of-work mining, block header commitments, and Merkle tree construction, as well as a critical primitive in TLS, code signing, and certificate transparency."@en ;
    rdfs:subClassOf ngm:cryptographic-hash-function ;
    vc:enables ngm:bitcoin-proof-of-work-protocol-mining,
        ngm:data-integrity,
        ngm:merkle-proof ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:merkle-tree,
        ngm:proof-of-work,
        ngm:sha-256 ;
    vc:slug "sha-256-hashing" ;
    vc:sourceDomain "security" ;
    vc:uses ngm:blockchain-security,
        ngm:cryptographic-hash .

ngm:sha-3 a owl:Class ;
    rdfs:label "SHA-3"@en ;
    rdfs:comment "SHA-3 is a family of cryptographic hash functions standardised by NIST in FIPS 202, based on the Keccak sponge construction rather than the Merkle-Damgaard design of SHA-2. Its sponge structure provides strong resistance to length-extension attacks and offers configurable output lengths and extendable-output functions. It is used as a collision-resistant primitive in digital signatures and integrity verification."@en ;
    rdfs:subClassOf ngm:cryptographic-primitive ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:cryptography-security-and-privacy,
        ngm:digital-signature ;
    vc:slug "sha-3" ;
    vc:sourceDomain "security" .

ngm:shamir-secret-sharing a owl:Class ;
    rdfs:label "Shamir Secret Sharing"@en ;
    rdfs:comment "Shamir secret sharing splits a secret into shares so that any threshold number of them reconstructs it while fewer reveal nothing, using polynomial interpolation over a finite field."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:modular-arithmetic ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:finite-field ],
        ngm:cryptography ;
    vc:bridgesTo ngm:blockchain,
        ngm:distributed-systems,
        ngm:stark ;
    vc:contrastsWith ngm:homomorphic-encryption,
        ngm:multi-party-computation ;
    vc:enables ngm:key-management,
        ngm:key-recovery,
        ngm:secure-multi-party-computation,
        ngm:threshold-cryptography ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:implements ngm:information-theoretic-security,
        ngm:secret-sharing ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:bip39,
        ngm:verifiable-secret-sharing,
        ngm:zero-knowledge-proof ;
    vc:requires ngm:finite-field,
        ngm:modular-arithmetic,
        ngm:polynomial-interpolation ;
    vc:slug "shamir-secret-sharing" ;
    vc:sourceDomain "security" ;
    vc:supports ngm:decentralized-key-storage,
        ngm:multi-signature .

ngm:shared-memory a skos:Concept ;
    rdfs:label "Shared Memory"@en .

ngm:sidetree-protocol a owl:Class ;
    rdfs:label "Sidetree Protocol"@en ;
    rdfs:comment "The Sidetree Protocol is a layer-two protocol for operating scalable decentralised identifier networks on top of any existing decentralised ledger without requiring trusted intermediaries or special-purpose consensus. It batches large numbers of DID create, update, recover, and deactivate operations, anchors a single compact commitment to the underlying chain, and stores the operation data in content-addressed storage so that any node can deterministically replay the operation log to compute current DID states. This separation of anchoring from data lets identifier throughput scale far beyond the base chain's transaction capacity."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:content-addressed-storage ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:merkle-tree ],
        ngm:did-method ;
    vc:dependsOn ngm:bitcoin,
        ngm:distributed-ledger ;
    vc:enables ngm:did-document ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:content-addressed-storage,
        ngm:merkle-tree ;
    vc:implements ngm:did-method ;
    vc:isPartOf ngm:w3-c-did ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:ipfs,
        ngm:merkle-tree,
        ngm:w3-c-did ;
    vc:slug "sidetree-protocol" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:public-key-infrastructure ;
    vc:uses ngm:content-addressed-storage,
        ngm:ipfs,
        ngm:merkle-tree .

ngm:siggraph a owl:Class ;
    rdfs:label "SIGGRAPH"@en ;
    rdfs:comment "SIGGRAPH (Special Interest Group on Computer Graphics and Interactive Techniques) is the ACM's premier annual conference on computer graphics and interactive technology, considered the world's most prestigious venue for publishing advances in rendering, animation, simulation, geometry processing, and human-computer interaction. First held in 1974, SIGGRAPH has been the introduction point for transformative techniques including ray tracing, physically based rendering, GPU shading languages, neural rendering, and real-time global illumination. Its technical papers programme is among the most selective in computer science, with acceptance rates typically below 25 per cent."@en ;
    rdfs:subClassOf ngm:computer-graphics ;
    vc:bridgesTo ngm:augmented-reality,
        ngm:digital-twin,
        ngm:machine-learning,
        ngm:robotics,
        ngm:spatial-computing ;
    vc:enables ngm:differentiable-rendering,
        ngm:gpu-programming,
        ngm:neural-radiance-field,
        ngm:physically-based-rendering,
        ngm:real-time-rendering ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:emerging-technologies ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:3-d-gaussian-splatting,
        ngm:3-d-modeling,
        ngm:animation,
        ngm:geometry-processing,
        ngm:global-illumination,
        ngm:neural-rendering,
        ngm:ray-tracing,
        ngm:shader-language,
        ngm:simulation,
        ngm:visual-effects ;
    vc:slug "siggraph" ;
    vc:sourceDomain "spatial-computing" ;
    vc:standardizedBy ngm:association-for-computing-machinery ;
    vc:supports ngm:computer-graphics,
        ngm:human-computer-interaction ;
    vc:uses ngm:open-access,
        ngm:peer-review .

ngm:singular-value-decomposition a owl:Class ;
    rdfs:label "Singular Value Decomposition"@en ;
    rdfs:comment "Singular value decomposition (SVD) is a matrix factorisation that expresses any real or complex matrix as the product of two orthogonal (or unitary) matrices and a diagonal matrix of non-negative singular values. It generalises eigenvalue decomposition to arbitrary, non-square matrices and reveals the rank, range, and dominant directions of variation in data. SVD is foundational across machine learning and numerical linear algebra, underpinning dimensionality reduction, low-rank approximation, recommender systems, and the principal component analysis used to compress and denoise high-dimensional data."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:feature-extraction ],
        ngm:dimensionality-reduction ;
    vc:dependsOn ngm:linear-algebra ;
    vc:enables ngm:feature-extraction,
        ngm:principal-component-analysis ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:feature-extraction ;
    vc:implements ngm:dimensionality-reduction ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:deep-learning,
        ngm:dimensionality-reduction ;
    vc:slug "singular-value-decomposition" ;
    vc:sourceDomain "machine-learning" ;
    vc:supports ngm:principal-component-analysis ;
    vc:uses ngm:linear-algebra .

ngm:singularity-analysis a owl:Class ;
    rdfs:label "Singularity Analysis"@en ;
    rdfs:comment "Singularity analysis is the study of robot configurations at which the manipulator Jacobian loses rank, causing a loss or gain of instantaneous degrees of freedom. At singularities the robot cannot move in certain Cartesian directions, joint velocities may diverge, and force or motion control degrades. Identifying and avoiding singularities is essential for safe, well-conditioned trajectory planning and control of robotic arms."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:jacobian-matrix ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:jacobian-matrix ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:kinematics-model ],
        ngm:kinematics ;
    vc:contrastsWith ngm:workspace-analysis ;
    vc:dependsOn ngm:forward-kinematics ;
    vc:enables ngm:motion-planning,
        ngm:trajectory-planning ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:jacobian-matrix ;
    vc:isPartOf ngm:kinematics ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:forward-kinematics,
        ngm:singularity,
        ngm:workspace-analysis ;
    vc:requires ngm:jacobian-matrix,
        ngm:kinematics-model ;
    vc:slug "singularity-analysis" ;
    vc:sourceDomain "robotics" ;
    vc:supports ngm:redundancy,
        ngm:robot-control ;
    vc:uses ngm:linear-algebra .

ngm:skos-vocabulary a owl:Class ;
    rdfs:label "Skos Vocabulary"@en ;
    rdfs:comment "A W3C recommendation providing an RDF-based data model for representing thesauri, taxonomies, classification schemes, and other structured controlled vocabularies, enabling publication and linking of knowledge organization systems on the semantic web through standardized concepts and relationships."@en ;
    rdfs:subClassOf ngm:sc-standards-and-interop ;
    skos:broader ngm:sc-standards-and-interop ;
    vc:bridgesTo ngm:knowledge-organization-system ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.35"^^xsd:float ;
    vc:slug "skos-vocabulary" ;
    vc:sourceDomain "spatial-computing" .

ngm:slippage a owl:Class ;
    rdfs:label "Slippage"@en ;
    rdfs:comment "Slippage is the difference between the expected price of a trade and the price at which it actually executes, arising from price movement and limited liquidity between order submission and settlement. On automated-market-maker decentralised exchanges slippage is a direct function of trade size relative to pool depth, and traders set a slippage tolerance to bound acceptable execution price. Excessive slippage can be exploited through front-running and other maximal-extractable-value strategies."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:trade-execution ],
        ngm:decentralized-exchange ;
    vc:bridgesTo ngm:market-microstructure ;
    vc:contrastsWith ngm:liquidity ;
    vc:dependsOn ngm:liquidity,
        ngm:liquidity-pool ;
    vc:enables ngm:mev ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:isPartOf ngm:trade-execution ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:decentralized-exchange,
        ngm:liquidity,
        ngm:mev,
        ngm:trade-execution ;
    vc:requires ngm:trade-execution ;
    vc:slug "slippage" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:market-maker ;
    vc:uses ngm:order-book .

ngm:smart-home a owl:Class ;
    rdfs:label "Smart Home"@en ;
    rdfs:comment "A smart home is a residence equipped with networked devices, sensors, and actuators that can be monitored and controlled remotely or automated to respond to conditions and occupant preferences. Smart homes integrate lighting, climate control, security, appliances, and entertainment through a common connectivity fabric and often a central hub or voice assistant. They build on Internet of Things technologies, wireless mesh networking, and interoperability standards to deliver convenience, energy efficiency, and accessibility."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:sensor-networks ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:iot-device ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:actuator ],
        ngm:internet-of-things ;
    vc:bridgesTo ngm:smart-city ;
    vc:dependsOn ngm:mesh-network,
        ngm:wireless-network ;
    vc:enables ngm:edge-computing ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:actuator,
        ngm:iot-device,
        ngm:sensor-networks ;
    vc:isPartOf ngm:internet-of-things ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:io-t,
        ngm:network-topology ;
    vc:slug "smart-home" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:smart-city ;
    vc:uses ngm:bluetooth-low-energy,
        ngm:thread-protocol,
        ngm:voice-assistant,
        ngm:z-wave,
        ngm:zigbee .

ngm:snapshot-block a owl:Class ;
    rdfs:label "Snapshot Block"@en ;
    rdfs:comment "A snapshot block is a specific block height at which token balances are recorded to determine voting weight in a governance proposal, freezing eligibility so that votes reflect holdings at one fixed moment rather than fluctuating balances. Using a past block prevents vote-buying or borrowing tokens after a proposal opens. It is a core primitive in off-chain and on-chain DAO voting systems."@en ;
    rdfs:subClassOf ngm:bc-governance-and-regulation ;
    skos:broader ngm:bc-governance-and-regulation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:governance-token,
        ngm:snapshot-voting ;
    vc:slug "snapshot-block" ;
    vc:sourceDomain "blockchain" .

ngm:social-engineering a owl:Class ;
    rdfs:label "Social Engineering"@en ;
    rdfs:comment "Social engineering is the manipulation of people into divulging confidential information or performing actions that compromise security, exploiting human psychology rather than technical vulnerabilities. It includes techniques such as phishing, pretexting, baiting and impersonation that bypass technical controls by targeting trust, urgency and authority. It is one of the most effective and prevalent attack vectors in cybersecurity."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:vulnerability ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:threat-actor ],
        ngm:attack-vector ;
    vc:bridgesTo ngm:cybersecurity ;
    vc:contrastsWith ngm:access-control,
        ngm:authentication ;
    vc:dependsOn ngm:vulnerability ;
    vc:enables ngm:data-breach,
        ngm:ransomware ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:vulnerability ;
    vc:implements ngm:attack-vector ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:malware,
        ngm:threat-actor ;
    vc:requires ngm:threat-actor ;
    vc:slug "social-engineering" ;
    vc:sourceDomain "security" ;
    vc:supports ngm:penetration-testing ;
    vc:uses ngm:prompt-injection .

ngm:social-recovery a owl:Class ;
    rdfs:label "Social Recovery"@en ;
    rdfs:comment "Social recovery is a wallet security mechanism that lets a user regain control of an account by relying on a set of trusted guardians rather than a single seed phrase. If a signing key is lost, a quorum of designated guardians can authorise a key rotation to a new owner address without ever holding the funds themselves. It mitigates catastrophic key loss while preserving self-custody, and is a flagship use case for smart-contract wallets."@en ;
    rdfs:subClassOf ngm:identity-management ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:account-abstraction,
        ngm:multi-sig-governance ;
    vc:slug "social-recovery" ;
    vc:sourceDomain "blockchain" .

ngm:sociotechnical-system a owl:Class ;
    rdfs:label "Sociotechnical System"@en ;
    rdfs:comment "A sociotechnical system is an analytical and design framework that treats technological artefacts and social structures as mutually constitutive elements of a unified system, recognising that technical components and human actors, organisations, and cultural practices co-evolve in ways that cannot be understood in isolation. Originating in organisational psychology and systems theory, it emphasises that optimising the technical subsystem alone is insufficient; effective system design requires joint optimisation of technical and social elements."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:human-computer-interaction ],
        ngm:complex-systems ;
    vc:contrastsWith ngm:sociotechnical-harm ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:human-computer-interaction ;
    vc:qualityScore "0.8"^^xsd:float ;
    vc:relatedTo ngm:human-factors,
        ngm:sociotechnical-analysis,
        ngm:sociotechnical-risk ;
    vc:slug "sociotechnical-system" ;
    vc:sourceDomain "governance" ;
    vc:uses ngm:organisational-theory .

ngm:software-as-a-service a owl:Class ;
    rdfs:label "Software As A Service"@en ;
    rdfs:comment "Software as a Service (SaaS) is a cloud computing delivery model in which fully functional applications are hosted and maintained by a provider and delivered to users over the internet via a web browser or thin client, with the provider managing all underlying infrastructure, platform, and application layers. SaaS eliminates the need for local installation and enables subscription-based access with automatic updates, multi-tenancy, and built-in scaling. Prominent examples include Salesforce CRM, Microsoft 365, Google Workspace, Slack, and Zoom."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:multi-tenancy ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:web-application ],
        ngm:cloud-computing ;
    vc:contrastsWith ngm:infrastructure-as-a-service,
        ngm:on-premises,
        ngm:platform-as-a-service ;
    vc:dependsOn ngm:cloud-computing,
        ngm:infrastructure-as-a-service,
        ngm:platform-as-a-service ;
    vc:enables ngm:collaboration,
        ngm:digital-transformation,
        ngm:productivity ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:multi-tenancy,
        ngm:subscription-model,
        ngm:web-application ;
    vc:isPartOf ngm:cloud-computing ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:distributed-collaboration,
        ngm:identity-and-access-management ;
    vc:slug "software-as-a-service" ;
    vc:sourceDomain "infrastructure" ;
    vc:supports ngm:api,
        ngm:remote-work ;
    vc:uses ngm:encryption,
        ngm:single-sign-on .

ngm:solid-pod a owl:Class ;
    rdfs:label "Solid Pod"@en ;
    rdfs:comment "A Solid Pod (Personal Online Data store) is a W3C Linked Data Platform-compliant personal data vault that gives individuals and organisations sovereign control over their own data by hosting it at a user-chosen location and exposing it through a standards-based access control layer (WAC or ACP), ..."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:access-control ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:rdf-data-model ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:turtle ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:access-control-policy ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:web-id-profile ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:rdf ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:web-id ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:http-protocol ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:ldp-container ],
        ngm:infra-data-management,
        ngm:infra-network-and-comms,
        ngm:personal-data-store ;
    skos:broader ngm:infra-data-management,
        ngm:infra-network-and-comms ;
    vc:enables ngm:data-sovereignty,
        ngm:decentralised-identity,
        ngm:personal-data-store ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:access-control,
        ngm:access-control-policy,
        ngm:ldp-container,
        ngm:rdf,
        ngm:web-id-profile ;
    vc:implements ngm:solid,
        ngm:w-3-c-linked-data-platform,
        ngm:web-access-control ;
    vc:isPartOf ngm:decentralised-web,
        ngm:solid ;
    vc:qualityScore "0.65"^^xsd:float ;
    vc:requires ngm:http-protocol,
        ngm:rdf-data-model,
        ngm:turtle,
        ngm:web-id ;
    vc:slug "solid-pod" ;
    vc:sourceDomain "infrastructure" .

ngm:sovereign-ai a owl:Class ;
    rdfs:label "Sovereign AI"@en ;
    rdfs:comment "National strategies for building indigenous AI capabilities—foundational models trained on sovereign data using domestically controlled compute infrastructure—to reduce dependence on foreign hyperscaler platforms. Encompasses government investment in national AI compute clusters, local language models, and data governance frameworks."@en ;
    rdfs:subClassOf ngm:ai-governance-and-ethics ;
    skos:broader ngm:ai-governance-and-ethics ;
    vc:contrastsWith ngm:open-source-ai ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:ai-regulation,
        ngm:competition-in-ai,
        ngm:open-source-ai ;
    vc:slug "sovereign-ai" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:sparse-autoencoders a owl:Class ;
    rdfs:label "Sparse Autoencoders"@en ;
    rdfs:comment "Sparse autoencoders are neural networks trained to reconstruct their input through a wide hidden layer subject to a sparsity penalty, so that only a small number of latent units activate for any given input. In mechanistic interpretability they are applied to the activations of large language models to decompose dense, polysemantic representations into more monosemantic, human-interpretable features. They have become a leading tool for understanding what concepts a model internally represents."@en ;
    rdfs:subClassOf ngm:neural-network ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:deep-learning,
        ngm:safety-and-alignment ;
    vc:slug "sparse-autoencoders" ;
    vc:sourceDomain "ai" .

ngm:speaker-embedding a owl:Class ;
    rdfs:label "Speaker Embedding"@en ;
    rdfs:comment "A Speaker Embedding is a fixed-dimensional vector representation of a speaker's vocal identity, extracted from variable-length speech segments by a neural network trained to encode speaker-discriminative acoustic features while remaining invariant to spoken content, channel conditions, and background noise. Models such as d-vectors (deep speaker embeddings), x-vectors (TDNN-based), and ECAPA-TDNN produce embeddings that cluster in a metric space where same-speaker utterances lie close together and different-speaker utterances are well-separated. Speaker embeddings enable downstream tasks including speaker verification, speaker identification, speaker diarisation, and personalised speech synthesis without storing raw audio. They are trained using discriminative objectives such as softmax classification over training speakers, generalised end-to-end loss, or angular prototypical loss."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:embedding-space ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:embedding ],
        ngm:embedding ;
    vc:bridgesTo ngm:cross-modal-retrieval ;
    vc:contrastsWith ngm:document-retrieval ;
    vc:dependsOn ngm:embedding-model,
        ngm:machine-learning ;
    vc:enables ngm:automatic-speech-recognition,
        ngm:real-time-ai ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:embedding,
        ngm:embedding-space ;
    vc:implements ngm:automatic-speech-recognition,
        ngm:speech-recognition ;
    vc:qualityScore "0.62"^^xsd:float ;
    vc:relatedTo ngm:embedding-search,
        ngm:embeddings,
