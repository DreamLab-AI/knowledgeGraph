ngm:onfido a owl:Class ;
    rdfs:label "Onfido"@en ;
    rdfs:comment "Onfido is an identity verification company that combines document checks with facial biometrics to confirm users during remote onboarding. It was acquired by Entrust in 2024."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:biometric-authentication ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:facial-recognition ],
        ngm:identity-verification-system ;
