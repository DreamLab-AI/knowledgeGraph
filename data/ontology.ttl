# Linked Data Encoder
infrastructure:LinkedDataEncoder rdf:type owl:Class ;
    rdfs:label "Linked Data Encoder"@en ;
    rdfs:comment "A semantic encoding pipeline that transforms agent state, credentials, events, and metadata into JSON-LD 1.1 format using pinned, versioned JSON-LD Context, enabling standardised Federation Surface (S1–S11) that are queryable, linkable, and machine-readable without agent-specific API adapters."@en ;
    skos:prefLabel "Linked Data Encoder"@en ;
    vcw:canonicalUri "urn:visionclaw:concept:infrastructure:linked-data-encoder" ;
    owl:sameAs <urn:visionclaw:concept:infrastructure:linked-data-encoder> ;
    vcw:contentHash "sha256-12-f6a7b8c9dae0" ;
    vcw:qualityScore "0.87"^^xsd:decimal ;
    vcw:legacyTermId "NGM-linked-data-encoder" ;
    vcw:ontologyStatus "complete" ;
    vcw:maturityLevel "established" ;
    vcw:authorityScore "0.91"^^xsd:decimal ;
    dcterms:identifier "NGM-linked-data-encoder" ;
    dcterms:subject "infrastructure" ;
    owl:versionInfo "1.0.0" ;
    dcterms:created "2026-04-26T00:00:00Z"^^xsd:dateTime ;
    dcterms:modified "2026-04-26T00:00:00Z"^^xsd:dateTime ;
    vcw:owlRole "Process" .

