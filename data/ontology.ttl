ngm:rabbitmq a owl:Class ;
    rdfs:comment "RabbitMQ is an open-source message broker that implements the Advanced Message Queuing Protocol (AMQP) and related messaging standards, routing messages between producers and consumers through exchanges, bindings, and queues. It supports flexible routing topologies, message acknowledgement, durability, and clustering for high availability. RabbitMQ is widely used to decouple services and enable reliable asynchronous communication in distributed systems."@en ;
    rdfs:label "Rabbitmq"@en ;
    rdfs:subClassOf ngm:message-broker ;
