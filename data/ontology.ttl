        ngm:governance-token ;
    vc:slug "utility-token" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:blockchain,
        ngm:blockchain-transaction .

ngm:vision-language-model a owl:Class ;
    rdfs:label "Vision Language Model"@en ;
    rdfs:comment "A Vision Language Model (VLM) is a multimodal neural architecture that jointly processes visual inputs (images or video) and natural language text, learning shared representations that enable cross-modal tasks such as image captioning, visual question answering, visual grounding, and instruction-following based on image context. VLMs typically pair a visual encoder with a large language model backbone connected by a learned projection mechanism."@en ;
    rdfs:subClassOf ngm:multimodal-ai-architecture-models ;
    vc:enables ngm:visual-grounding,
        ngm:visual-question-answering ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.85"^^xsd:float ;
    vc:relatedTo ngm:multimodal-ai-architecture-reasoning ;
    vc:slug "vision-language-model" ;
    vc:sourceDomain "ai" ;
    vc:uses ngm:instruction-tuning,
        ngm:large-language-models,
        ngm:visual-representation .

ngm:vision-transformer a owl:Class ;
    rdfs:label "Vision Transformer"@en ;
    rdfs:comment "The Vision Transformer (ViT) is a neural network architecture that applies the transformer self-attention mechanism directly to sequences of fixed-size image patches, treating each patch embedding as a token analogous to a word in natural-language processing. Introduced by Dosovitskiy et al. (2020), ViT demonstrated that pure attention-based models can match or exceed convolutional networks on image classification benchmarks when pre-trained on sufficiently large datasets."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:feed-forward-network ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:layer-normalisation ],
        ngm:computer-vision ;
    vc:bridgesTo ngm:large-language-model,
        ngm:natural-language-processing ;
    vc:contrastsWith ngm:convolutional-neural-network ;
    vc:enables ngm:multimodal-ai-architecture-learning,
        ngm:self-supervised-visual-representation,
        ngm:text-to-image-generation,
        ngm:video-understanding ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:cls-token,
        ngm:feed-forward-network,
        ngm:layer-normalisation ;
    vc:qualityScore "0.85"^^xsd:float ;
    vc:relatedTo ngm:contrastive-learning,
        ngm:diffusion-transformer,
        ngm:image-segmentation,
        ngm:masked-image-modelling,
        ngm:swin-transformer ;
    vc:requires ngm:image-classification-dataset,
        ngm:large-scale-pre-training ;
    vc:slug "vision-transformer" ;
    vc:sourceDomain "artificial-intelligence" ;
    vc:uses ngm:attention-mechanism,
        ngm:multi-head-self-attention,
        ngm:patch-embedding,
        ngm:positional-encoding,
        ngm:transformer-encoder .

ngm:visual-effects a owl:Class ;
    rdfs:label "Visual Effects"@en ;
    rdfs:comment "Visual Effects (VFX) are the computational and compositing techniques used to create, simulate, or augment imagery that cannot be practically captured in-camera, spanning both offline film/broadcast pipelines and real-time interactive applications. In offline production, VFX encompasses computer-generated imagery (CGI), digital compositing, matte painting, motion capture integration, and physically accurate simulation of fluids, cloth, destruction, and crowds. In real-time and spatial-computing contexts, VFX includes particle systems, post-processing stacks (bloom, depth-of-field, ambient occlusion, screen-space reflections), procedural shaders, and GPU-accelerated simulation executed within physically-based rendering pipelines at interactive frame rates."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:procedural-animation ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:physically-based-rendering ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:rendering-pipeline ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:compute-shader ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:fluid-simulation ],
        ngm:sc-display-and-rendering ;
    skos:broader ngm:sc-display-and-rendering ;
    vc:bridgesTo ngm:generative-ai,
        ngm:machine-learning-for-graphics,
        ngm:neural-rendering ;
    vc:contrastsWith ngm:in-camera-vfx,
        ngm:practical-effects ;
    vc:dependsOn ngm:graphics-processing-unit,
        ngm:scene-graph ;
    vc:enables ngm:augmented-reality,
        ngm:immersive-experience,
        ngm:mixed-reality,
        ngm:virtual-production ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:hasPart ngm:fluid-simulation,
        ngm:procedural-animation,
        ngm:volumetric-rendering ;
    vc:isPartOf ngm:computer-graphics,
        ngm:real-time-rendering ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:3d-modelling,
        ngm:ray-tracing,
        ngm:texture-mapping ;
    vc:requires ngm:compute-shader,
        ngm:physically-based-rendering,
        ngm:rendering-pipeline ;
    vc:slug "visual-effects" ;
    vc:sourceDomain "spatial-computing" ;
    vc:standardizedBy ngm:academy-software-foundation,
        ngm:openexr ;
    vc:uses ngm:digital-compositing,
        ngm:gpu-compute,
        ngm:motion-capture,
        ngm:particle-systems,
        ngm:post-processing,
        ngm:shader .

ngm:web-socket a owl:Class ;
    rdfs:label "WebSocket"@en ;
    rdfs:comment "WebSocket is an application-layer communication protocol defined in RFC 6455 that establishes a persistent, full-duplex channel over a single TCP connection, initiated via an HTTP/1.1 upgrade handshake. Unlike the request-response model of HTTP, WebSocket permits the server and client to send data frames independently at any time after connection establishment, enabling low-latency bidirectional communication. The protocol specifies a lightweight framing mechanism with opcodes for text, binary, ping/pong keepalives, and graceful connection close, and is extended by RFC 7692 for per-message DEFLATE compression. It is the de facto standard transport for real-time web applications including collaborative editing, live dashboards, chat systems, and streaming LLM token output."@en ;
    rdfs:subClassOf ngm:network-protocol ;
    vc:bridgesTo ngm:ai-inference-serving,
        ngm:large-language-model ;
    vc:contrastsWith ngm:long-polling,
        ngm:rest-api,
        ngm:server-sent-events,
        ngm:webrtc ;
    vc:dependsOn ngm:load-balancer,
        ngm:publish-subscribe-pattern ;
    vc:enables ngm:collaborative-editing,
        ngm:event-driven-architecture,
        ngm:real-time-processing,
        ngm:server-sent-push ;
    vc:hasMaturity ngmi:maturity-draft ;
    vc:implements ngm:full-duplex-communication,
        ngm:rfc-6455 ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:grpc,
        ngm:latency ;
    vc:requires ngm:hypertext-transfer-protocol,
        ngm:transmission-control-protocol ;
    vc:slug "web-socket" ;
    vc:sourceDomain "infrastructure" ;
    vc:standardizedBy ngm:internet-engineering-task-force,
        ngm:world-wide-web-consortium ;
    vc:supports ngm:api-gateway,
        ngm:message-queue ;
    vc:uses ngm:message-framing,
        ngm:protocol-buffers,
        ngm:transport-layer-security .

ngm:3-d-animation a owl:Class ;
    rdfs:label "3D Animation"@en ;
    rdfs:comment "3D Animation is the discipline of creating motion in three-dimensional digital environments using techniques such as keyframe animation, motion capture, and procedural simulation. It underpins character movement, environmental dynamics, and cinematic sequences in spatial computing platforms, game engines, and metaverse applications."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
