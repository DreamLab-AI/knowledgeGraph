    vc:enables ngm:regulatory-compliance ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:carbon-registry ;
    vc:slug "traditional-carbon-registry" ;
    vc:sourceDomain "metaverse" .

ngm:training-methods a owl:Class ;
    rdfs:label "Training Methods"@en ;
    rdfs:comment "Training Methods encompass the algorithms and procedures used to optimise machine learning model parameters against training data, including supervised, unsupervised, semi-supervised, reinforcement, transfer, curriculum, and contrastive learning paradigms. The choice of method fundamentally determines model capability, data efficiency, and generalisation behaviour."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:transfer-learning ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:contrastive-learning ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:reinforcement-learning ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:training-data ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:supervised-learning ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:machine-learning-discipline-model ],
        ngm:ai-technique ;
    skos:broader ngm:ai-technique ;
    vc:enables ngm:fine-tuning ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:hasPart ngm:contrastive-learning,
        ngm:reinforcement-learning,
        ngm:supervised-learning,
        ngm:transfer-learning ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:requires ngm:machine-learning-discipline-model,
        ngm:training-data ;
    vc:slug "training-methods" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:transaction-fees a owl:Class ;
    rdfs:label "transaction fees"@en ;
    rdfs:comment "Transaction fees are amounts paid by users to have their transactions included in a blockchain block. They compensate miners or validators and help prioritise transactions when capacity is limited."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:bitcoin-proof-of-work-protocol-network ],
        ngm:transaction ;
    vc:enables ngm:transaction-validation ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:requires ngm:bitcoin-proof-of-work-protocol-network ;
    vc:slug "transaction-fees" ;
    vc:sourceDomain "blockchain" .

ngm:transaction-parameter a owl:Class ;
    rdfs:label "Transaction Parameter"@en ;
    rdfs:comment "Transaction Parameters are the configuration values that define the execution characteristics of a blockchain transaction, including gas limit, gas price (or priority fee under EIP-1559), nonce, value, and calldata. These parameters determine transaction priority, cost, computational resources consumed, and ordering within blocks, directly influencing DeFi strategies such as MEV extraction and Layer 2 batching efficiency."@en ;
    rdfs:subClassOf ngm:bc-protocol-and-consensus,
        ngm:blockchain-transaction ;
    skos:broader ngm:bc-protocol-and-consensus ;
    vc:enables ngm:gas-optimization,
        ngm:mev ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:isPartOf ngm:blockchain-transaction ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:layer2,
        ngm:smart-contract ;
    vc:slug "transaction-parameter" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:eip-1559,
        ngm:gas-limit,
        ngm:gas-price .

ngm:trojan-attack a owl:Class ;
    rdfs:label "Trojan Attack"@en ;
    rdfs:comment "A Trojan Attack is a supply-chain-oriented backdoor attack on AI models in which a pre-trained model or training pipeline is maliciously modified to embed hidden triggers; the model performs normally on clean inputs but produces attacker-defined outputs when specific trigger patterns are present. Unlike general backdoor attacks, Trojan attacks emphasise persistence through fine-tuning and distribution via public model repositories."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:supply-chain ],
        ngm:sc-governance-and-safety ;
    skos:broader ngm:sc-governance-and-safety ;
    vc:contrastsWith ngm:adversarial-robustness ;
    vc:dependsOn ngm:ai-security ;
    vc:hasMaturity ngmi:maturity-emerging ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:adversarial-attack,
        ngm:backdoor-attack,
        ngm:data-poisoning ;
    vc:requires ngm:supply-chain ;
    vc:slug "trojan-attack" ;
    vc:sourceDomain "spatial-computing" .

ngm:trusted-execution-pbft a owl:Class ;
    rdfs:label "Trusted Execution PBFT"@en ;
    rdfs:comment "Trusted Execution PBFT is a variant of Practical Byzantine Fault Tolerance that leverages Trusted Execution Environments (TEEs), specifically Intel SGX, to implement a Unique Sequential Identifier Generator (USIG) that reduces the protocol to two message phases rather than the standard three. By anchoring sequence number generation inside a tamper-resistant enclave, it eliminates the view-change overhead of classical PBFT while preserving Byzantine fault safety up to f < n/3 faulty replicas."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:trusted-execution-environment ],
        [ a owl:Restriction ;
            owl:onProperty vc:hasPart ;
            owl:someValuesFrom ngm:consensus-mechanism ],
        [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:byzantine-fault-tolerance ],
        ngm:bc-protocol-and-consensus,
        ngm:practical-byzantine-fault-tolerance ;
    skos:broader ngm:bc-protocol-and-consensus ;
    vc:enables ngm:blockchain-scalability,
        ngm:finality ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:consensus-mechanism ;
    vc:qualityScore "0.0"^^xsd:float ;
    vc:relatedTo ngm:blockchain-protocol,
        ngm:fault-tolerance,
        ngm:node,
        ngm:validator-node ;
    vc:requires ngm:byzantine-fault-tolerance,
        ngm:trusted-execution-environment ;
    vc:slug "trusted-execution-pbft" ;
    vc:sourceDomain "blockchain" ;
    vc:uses ngm:digital-signature,
        ngm:secure-enclave .

ngm:ucl a owl:Class ;
    rdfs:label "UCL"@en ;
    rdfs:comment "The common abbreviation for University College London, a major research university in London active in computing and artificial intelligence research."@en ;
    rdfs:subClassOf ngm:university-college-london ;
    vc:enables ngm:machine-learning-discipline ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:qualityScore "0.6"^^xsd:float ;
    vc:slug "ucl" ;
    vc:sourceDomain "artificial-intelligence" .

ngm:uma a owl:Class ;
    rdfs:label "UMA"@en ;
    rdfs:comment "UMA is a decentralised finance protocol on Ethereum that provides an optimistic oracle for reporting data to smart contracts and tooling for creating synthetic assets."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:ethereum-smart-contract-platform ],
        [ a owl:Restriction ;
