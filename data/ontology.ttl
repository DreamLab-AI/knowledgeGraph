    vc:slug "sidechain" ;
    vc:sourceDomain "blockchain" ;
    vc:supports ngm:decentralized-application,
        ngm:token-standard ;
    vc:uses ngm:cross-chain-bridge,
        ngm:multi-signature .

ngm:solid a owl:Class ;
    rdfs:label "Solid"@en ;
    rdfs:comment "Solid (Social Linked Data) is an open-source, W3C-specification-grounded decentralised web architecture conceived by Sir Tim Berners-Lee at MIT CSAIL (Massachusetts Institute of Technology Computer Science and Artificial Intelligence Laboratory) commercialised through the startup Inrupt and steer..."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty vc:requires ;
            owl:someValuesFrom ngm:rdf ],
