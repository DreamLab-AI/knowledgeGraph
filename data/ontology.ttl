ngm:posterior-distribution a owl:Class ;
    rdfs:comment "A posterior distribution is the probability distribution over unknown quantities after observing data, obtained by combining a prior distribution with the likelihood via Bayes' theorem. It represents updated belief and is the central object of Bayesian inference. In recursive estimators such as Bayes and particle filters, the posterior at each step becomes the basis for the next prediction."@en ;
    rdfs:label "Posterior Distribution"@en ;
    rdfs:subClassOf ngm:machine-learning-discipline ;
    rdfs:subClassOf ngm:probability-distribution ;
