    vc:uses ngm:computer-vision,
        ngm:open-xr .

ngm:digital-archive a owl:Class ;
    rdfs:label "Digital Archive"@en ;
    rdfs:comment "A systematic collection and preservation system for digital assets, cultural artifacts, documents, and media using distributed storage, metadata standards, and immersive access technologies to ensure long-term accessibility and discovery within virtual environments and knowledge management systems."@en ;
