ngm:cold-storage a owl:Class ;
    rdfs:comment "Cold Storage in the context of digital assets and cryptocurrency refers to the practice of holding private keys in an offline environment — physically disconnected from any network — to eliminate the attack surface presented by internet-connected systems. Hardware wallets, air-gapped computers, and paper wallets are common cold storage implementations. By contrast with hot wallets (internet-connected), cold storage sacrifices transaction convenience for maximum security, and is the industry standard for custodying large quantities of cryptocurrency at exchanges, institutional custodians, and high-net-worth individual holders."@en ;
    rdfs:label "Cold Storage"@en ;
    rdfs:subClassOf ngm:custody-infrastructure ;
    rdfs:subClassOf _:r4622 ;
    rdfs:subClassOf _:r4623 ;
