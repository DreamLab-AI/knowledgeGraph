ngm:teleoperation a owl:Class ;
    rdfs:comment "Teleoperation is the remote control of robots and physical systems by human operators in real-time, enabling task execution in hazardous, distant, or inaccessible environments whilst maintaining human supervision and decision-making authority."@en ;
