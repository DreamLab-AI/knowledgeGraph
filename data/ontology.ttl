    rdfs:label "Federated Virtual Worlds"@en .
ngm:federation a owl:Class ;
    rdfs:comment "An architecture in which autonomous systems or organisations interoperate through agreed protocols and trust relationships while retaining independent control of their own resources, enabling cross-domain data and service exchange without centralised authority."@en ;
    rdfs:label "Federation"@en ;
    rdfs:subClassOf ngm:distributed-systems ;
